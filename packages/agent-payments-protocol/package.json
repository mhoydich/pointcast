{
  "name": "@pointcast/agent-payments-protocol",
  "version": "0.1.0",
  "description": "Reference implementation of the pointcast.agent-payments/v1 spec — Ed25519-signed receipts for agent-issued spends. Sign, verify, and discover.",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./signing": {
      "types": "./src/signing.d.ts",
      "import": "./src/signing.mjs"
    },
    "./discover": {
      "types": "./src/discover.d.ts",
      "import": "./src/discover.mjs"
    }
  },
  "bin": {
    "agent-payments-verify": "./bin/verify.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "payments",
    "ed25519",
    "receipts",
    "stripe-link",
    "agent-commerce",
    "verifiable",
    "pointcast",
    "well-known",
    "agent-identity"
  ],
  "author": "Mike Hoydich + Claude Code",
  "license": "Apache-2.0",
  "homepage": "https://pointcast.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhoydich/pointcast",
    "directory": "packages/agent-payments-protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
