{
  "$schema": "https://pointcast.xyz/town",
  "name": "PointCast · /town",
  "version": "0.1.0",
  "description": "Pixel-art isometric map of PointCast. Every building is a real PointCast surface; every visitor is a Noun-head sprite walking between them. Drum Hall pulses on live drum activity.",
  "canonical": "https://pointcast.xyz/town",
  "grid": {
    "cols": 4,
    "rows": 3,
    "tileWidth": 96,
    "tileHeight": 48
  },
  "buildings": [
    {
      "gx": 0,
      "gy": 0,
      "name": "Lighthouse",
      "href": "/beacon",
      "glyph": "☼",
      "category": "civic",
      "note": "beacon · the lighthouse signal",
      "url": "https://pointcast.xyz/beacon"
    },
    {
      "gx": 1,
      "gy": 0,
      "name": "Broadcast Tower",
      "href": "/tv",
      "glyph": "📡",
      "category": "civic",
      "note": "tv · 15 geo-stations within 100mi",
      "url": "https://pointcast.xyz/tv"
    },
    {
      "gx": 2,
      "gy": 0,
      "name": "Library",
      "href": "/archive",
      "glyph": "📚",
      "category": "civic",
      "note": "archive · every block ever",
      "url": "https://pointcast.xyz/archive"
    },
    {
      "gx": 3,
      "gy": 0,
      "name": "Mailbox",
      "href": "/wire",
      "glyph": "✉",
      "category": "civic",
      "note": "wire · global news desk",
      "url": "https://pointcast.xyz/wire"
    },
    {
      "gx": 0,
      "gy": 1,
      "name": "Town Hall",
      "href": "/residents",
      "glyph": "⌂",
      "category": "civic",
      "note": "residents · plus-one agents",
      "url": "https://pointcast.xyz/residents"
    },
    {
      "gx": 1,
      "gy": 1,
      "name": "Drum Hall",
      "href": "/drum",
      "glyph": "♪",
      "category": "play",
      "note": "drum · 11 surfaces + lounge sax",
      "url": "https://pointcast.xyz/drum"
    },
    {
      "gx": 2,
      "gy": 1,
      "name": "Café",
      "href": "/coffee",
      "glyph": "☕",
      "category": "commerce",
      "note": "coffee · mintable mugs FA2",
      "url": "https://pointcast.xyz/coffee"
    },
    {
      "gx": 3,
      "gy": 1,
      "name": "Gallery",
      "href": "/gallery",
      "glyph": "◇",
      "category": "play",
      "note": "gallery · curated visual blocks",
      "url": "https://pointcast.xyz/gallery"
    },
    {
      "gx": 0,
      "gy": 2,
      "name": "Agent Gate",
      "href": "/connectors",
      "glyph": "◉",
      "category": "agent",
      "note": "connectors · add PointCast to an AI client",
      "url": "https://pointcast.xyz/connectors"
    },
    {
      "gx": 1,
      "gy": 2,
      "name": "Workbench",
      "href": "/workbench",
      "glyph": "⚒",
      "category": "civic",
      "note": "workbench · what is being built",
      "url": "https://pointcast.xyz/workbench"
    },
    {
      "gx": 2,
      "gy": 2,
      "name": "Garden",
      "href": "/garden-yield",
      "glyph": "🌱",
      "category": "nature",
      "note": "garden · native planting kits",
      "url": "https://pointcast.xyz/garden-yield"
