{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pointcast:league-attempt:v1",
  "title": "Signed opt-in attempt: Ed25519 verification is also required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "site_id",
    "season_id",
    "task_id",
    "task_version",
    "dataset_hash",
    "nonce",
    "issued_at",
    "expires_at",
    "terms_hash",
    "participant_key_id",
    "data_mode",
    "attempt_id",
    "public_key",
    "result_hash",
    "opt_in",
    "signature"
  ],
  "properties": {
    "challenge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "site_id": {
      "enum": [
        "pointcast",
        "el-segundo",
        "industry-next",
        "ues"
      ]
    },
    "season_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "task_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "terms_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "participant_key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "opt_in": {
      "const": true
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
