{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pointcast:league-challenge:v1",
  "title": "League challenge: server-owned context; structural validation only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "site_id",
    "season_id",
    "task_id",
    "task_version",
    "dataset_hash",
    "nonce",
    "issued_at",
    "expires_at",
    "terms_hash",
    "participant_key_id",
    "data_mode"
  ],
  "properties": {
    "challenge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "site_id": {
      "enum": [
        "pointcast",
        "el-segundo",
        "industry-next",
        "ues"
      ]
    },
    "season_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "task_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "terms_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "participant_key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_mode": {
      "enum": [
        "fixture",
        "live"
      ]
    }
  }
}
