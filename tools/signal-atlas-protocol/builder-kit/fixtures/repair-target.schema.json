{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-atlas:builder-fixture-repair-target:v1",
  "title": "Fictional practice pack record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "item_count", "version", "public", "delivery_day", "source_id"],
  "properties": {
    "record_id": {"const":"fx-pack-17"},
    "item_count": {"type":"integer","minimum":1,"maximum":100},
    "version": {"type":"integer","minimum":1,"maximum":100},
    "public": {"type":"boolean"},
    "delivery_day": {"type":["string","null"],"format":"date"},
    "source_id": {"const":"src-pack"}
  }
}
