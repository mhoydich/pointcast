---
import BlockLayout from '../layouts/BlockLayout.astro';
import { Content } from '../content/guides/arcade-remembrance.md';
const title = 'The other half of the game';
const description = 'An interactive arcade remembrance by Michael Hoydich: Super Sprint, Gauntlet, Super Off Road, and the people beside the cabinet.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  datePublished: '2026-09-29T23:10:00-07:00', author: {'@type': 'Person', name: 'Michael Hoydich'},
  publisher: {'@type': 'Organization', name: 'PointCast'}, url: 'https://pointcast.xyz/arcade-remembrance',
  image: 'https://pointcast.xyz/images/arcade-remembrance/social.png',
};
const games = [
  { name: 'Super Sprint', year: '1986', seats: '3 players', control: 'Wheel + accelerator', detail: 'A whole race in one shared view. Three wheels, a fourth computer car, and a reason to lean into a turn.', source: 'https://manualzz.com/doc/8207521/atari-super-sprint-arcade-game-operators-manual', maker: 'Atari operator manual', mark: '01' },
  { name: 'Gauntlet', year: '1985', seats: '4 players', control: 'Joystick + Fire + Magic', detail: 'A party in a maze. Help each other through it; negotiate the food, treasure, and potions along the way.', source: 'https://manualzz.com/doc/13044003/atari-games-gauntlet-user-manual', maker: 'Atari operator manual', mark: '02' },
  { name: 'Super Off Road', year: '1989', seats: '3 players', control: 'Wheel + pedal + Nitro', detail: 'Dirt, little trucks, and the hopeful Nitro press. A race with your neighbors at the same cabinet.', source: 'https://manualzz.com/doc/13935093/leland-corporation-super-off-road-family-user-manual', maker: 'Leland owner’s manual', mark: '03' },
];
---
<BlockLayout title={`${title} · Michael Hoydich`} description={description} image="/images/arcade-remembrance/social.png" themeColor="#f2ecdd" jsonLd={jsonLd} immersive hideAds alternates={[{type: 'application/json', href: '/arcade-remembrance.json', title: 'Arcade remembrance — full text'}]}>
  <main class="remembrance">
    <nav class="topline" aria-label="Publication navigation"><a href="/" class="wordmark">PointCast<span>← the whole town</span></a><span>FIELD NOTE № 0648<br />29 SEPTEMBER 2026</span></nav>
    <header class="opening">
      <div class="eyebrow"><span class="coin" aria-hidden="true">✳</span> ARCADE REMEMBRANCE · READ & PLAY</div>
      <h1>The other half<br />of the <em>game.</em></h1>
      <div class="intro"><p>An ode to Super Sprint, Gauntlet, Super Off Road, and the people beside the cabinet.</p><p class="byline">By Michael Hoydich<br /><span>A few minutes. One more turn.</span></p></div>
    </header>
    <section class="cabinet" data-arcade aria-labelledby="cabinet-title">
      <div class="cabinet-top"><div><p class="tiny">THE HANDS REMEMBER</p><h2 id="cabinet-title">Come over here. Try this.</h2></div><button class="sound" data-sound aria-pressed="false">Sound off</button></div>
      <div class="cabinet-tabs" role="group" aria-label="Choose a cabinet memory">
        <button data-cabinet="sprint" aria-pressed="true">Super Sprint<span>the wheel</span></button>
        <button data-cabinet="gauntlet" aria-pressed="false">Gauntlet<span>the party</span></button>
        <button data-cabinet="offroad" aria-pressed="false">Super Off Road<span>the Nitro</span></button>
        <button data-cabinet="room" aria-pressed="false">The room<span>the trackball</span></button>
      </div>
      <div class="crt-frame"><div class="screen-top"><span data-screen-label>SUPER SPRINT</span><span class="screen-light">● SHARED SCREEN</span></div><canvas width="900" height="480" data-arcade-screen tabindex="0" role="img" aria-label="Original interactive arcade illustration, controlled by the wheel, trackball and action button below">An illustrated tribute to shared arcade cabinets.</canvas><div class="screen-bottom"><span>ONE SCREEN. A LITTLE CROWD.</span><span>POINTCAST / 1985—1989</span></div></div>
      <div class="control-deck">
        <div class="control wheel-control"><button data-wheel class="wheel" aria-label="Steering wheel: drag to turn, or use the left and right buttons"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="48"/><path d="M60 60 23 30M60 60 97 30M60 60V108"/><circle class="hub" cx="60" cy="60" r="16"/></svg></button><div class="steer"><button data-steer="left" aria-label="Turn left">←</button><span>TURN</span><button data-steer="right" aria-label="Turn right">→</button></div></div>
        <div class="control"><button data-trackball class="trackball" aria-label="Trackball: drag to roll, or press to roll"><span aria-hidden="true"></span></button><span class="control-label">ROLL THE BALL</span></div>
        <div class="control"><button class="arcade-button" data-action aria-label="Cabinet action"><span aria-hidden="true">✳</span></button><span class="control-label" data-action-label>Start a lap</span></div>
      </div>
      <div class="players"><span class="tiny">MOVE OVER A LITTLE</span><div class="seats" role="group" aria-label="Player positions on this screen"><button data-player="0" aria-pressed="true"><i></i>01<span>playing</span></button><button data-player="1" aria-pressed="false"><i></i>02<span>join in</span></button><button data-player="2" aria-pressed="false"><i></i>03<span>join in</span></button><button data-player="3" aria-pressed="false" disabled><i></i>04<span>Gauntlet seat</span></button></div></div>
      <div class="cabinet-feedback"><p data-cabinet-status role="status" aria-live="polite">Spin the wheel. Press the button. Leave a place for someone else.</p><button data-reset>Start again ↺</button></div>
      <p class="howto">Drag the controls or use their buttons. Keyboard: focus a control, then ← → and Space; ↑ ↓ also move through the maze. Player positions share this screen and its controls.</p>
      <p class="homage">An original little tribute to the feel of a cabinet. Select a memory, play with the controls, then read on.</p>
      <noscript><p class="nojs">Turn on JavaScript to play with the cabinet. The full remembrance is below.</p></noscript>
    </section>
    <div class="essay-layout"><aside><span class="margin-number">½</span><p>The cabinet<br />was only half<br />the game.</p><div class="margin-rule"></div><span class="tiny">THE OTHER HALF<br />WAS BESIDE YOU.</span></aside><article class="essay"><Content /><div class="signature"><span>Michael Hoydich</span><p>PointCast · September 29, 2026</p></div></article></div>
    <section class="cabinet-notes" aria-labelledby="notes-title"><div class="notes-heading"><h2 id="notes-title">Three cabinets.<br />A whole room.</h2><p>The controls and player counts come from the original operator manuals. The trackball belongs to the wider arcade floor.</p></div><div class="notes-grid">{games.map(game => <article><p class="tiny">{game.mark} / {game.year} / {game.seats}</p><h3>{game.name}</h3><p class="hardware">{game.control}</p><p>{game.detail}</p><a href={game.source}>{game.maker} ↗</a></article>)}</div><p class="source-note">Super Off Road release year: <a href="https://www.arcade-museum.com/Videogame/ironman-ivan-stewarts-super-off-road">International Arcade Museum</a>. Manufacturer manuals preserved by Manualzz.</p></section>
    <footer class="endnote"><p>One more race.<br /><em>There is another wheel.</em></p><div><a href="#cabinet-title">Back to the cabinet ↑</a><a href="/p">More things to play →</a><a href="/b/0648">Keep this field note →</a></div><span class="tiny">POINTCAST · THE TOWN IS STILL OPEN</span></footer>
  </main>
  <script is:inline src="/scripts/arcade-remembrance.js?v=1" defer></script>
</BlockLayout>
<style is:global>
  body:has(.remembrance){background:#f2ecdd;color:#26261e}.remembrance{--ink:#26261e;--paper:#f2ecdd;--acid:#d9ee65;--red:#f4775a;max-width:1120px;margin:auto;padding:28px 38px 75px;font-family:Inter Variable,Inter,Arial,sans-serif}.remembrance *{box-sizing:border-box}.remembrance button,.remembrance a{-webkit-tap-highlight-color:transparent}.remembrance button{font:inherit;cursor:pointer}.remembrance button:disabled{cursor:default}.remembrance button:focus-visible,.remembrance a:focus-visible{outline:3px solid #245dcc;outline-offset:5px}.remembrance a{color:inherit;text-underline-offset:4px}.topline{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid #bbb5a7;padding-bottom:22px}.wordmark{font-size:27px;font-weight:850;letter-spacing:-1.4px;text-decoration:none}.wordmark span{display:block;font:10px monospace;letter-spacing:.04em;margin-top:5px}.topline>span{text-align:right;font:10px/1.6 monospace;letter-spacing:.06em}.opening{padding:52px 0 35px}.eyebrow,.tiny{font:10px/1.6 monospace;letter-spacing:.08em}.eyebrow{display:flex;align-items:center;gap:10px}.coin{background:var(--ink);color:var(--acid);display:grid;place-items:center;width:28px;height:28px;border-radius:50%;font-size:22px}.opening h1{font-size:clamp(55px,8.3vw,104px);line-height:.96;letter-spacing:-.07em;margin:24px 0 28px;font-weight:850}.opening em,.endnote em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.05em}.intro{display:flex;gap:40px;justify-content:space-between;align-items:end}.intro>p:first-child{font-size:21px;line-height:1.5;max-width:510px;margin:0}.byline{flex-shrink:0;font-size:12px;line-height:1.7;margin:0;font-weight:650}.byline span{font:10px/1.7 monospace;font-weight:400}.cabinet{background:var(--ink);color:var(--paper);border:1px solid #22231e;border-radius:20px;padding:24px;box-shadow:0 14px 0 #d4cbb8;margin-bottom:82px}.cabinet-top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}.cabinet-top p{margin:0 0 6px;color:var(--acid)}.cabinet-top h2{font-size:24px;letter-spacing:-.045em;margin:0}.sound{border:1px solid #77796a;color:var(--paper);background:none;border-radius:20px;font:11px monospace!important;padding:11px 14px;white-space:nowrap}.sound[aria-pressed=true]{background:var(--acid);color:var(--ink);border-color:var(--acid)}.cabinet-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:0 0 18px}.cabinet-tabs button{color:var(--paper);text-align:left;background:#37382f;border:1px solid #505144;border-radius:5px;padding:12px 14px;font-size:13px;font-weight:650}.cabinet-tabs span{display:block;font:10px/1.8 monospace;opacity:.7;margin-top:3px}.cabinet-tabs button[aria-pressed=true]{color:var(--ink);background:var(--acid);border-color:var(--acid)}.crt-frame{background:#0e1d21;border-radius:12px;overflow:hidden;border:5px solid #141810;box-shadow:inset 0 0 15px #000}.screen-top,.screen-bottom{display:flex;justify-content:space-between;gap:12px;padding:12px 18px;color:var(--acid);font:9px/1.4 monospace;letter-spacing:.08em}.screen-bottom{color:#a1b6ab;font-size:8px}canvas[data-arcade-screen]{display:block;width:100%;height:auto;aspect-ratio:900/480;background:#12282e;touch-action:pan-y}.screen-light{color:#b2c5b8}.control-deck{display:flex;justify-content:center;gap:clamp(26px,8vw,100px);align-items:center;background:#393b31;border:1px solid #535548;border-radius:6px;margin-top:18px;padding:24px 18px 16px}.control{display:flex;flex-direction:column;align-items:center;gap:14px}.wheel{width:112px;height:112px;padding:0;border:0;background:none;touch-action:none;transform:rotate(var(--wheel-angle,0deg))}.wheel svg{width:100%;height:100%;fill:none;stroke:#dadcd0;stroke-width:10;filter:drop-shadow(0 5px 1px #171b16)}.wheel path{stroke-width:9}.wheel .hub{fill:#8f9683;stroke:#262a20;stroke-width:4}.steer{display:flex;gap:10px;align-items:center}.steer button{border:1px solid #737863;background:#262a20;color:var(--paper);border-radius:4px;width:32px;height:30px;font-size:17px}.steer span,.control-label{font:9px monospace;letter-spacing:.08em;text-transform:uppercase;min-height:30px;display:flex;align-items:center;text-align:center}.trackball{width:80px;height:80px;border:8px solid #1c2118;border-radius:50%;background:#93b5ed;box-shadow:0 4px 1px #171b16;overflow:hidden;padding:0;touch-action:none}.trackball span{display:block;width:100%;height:100%;border-radius:50%;background:radial-gradient(circle at 30% 25%,#d2e6ff 0,#8cafee 42%,#3f659f 90%);position:relative}.trackball span:after{content:'';position:absolute;inset:-60px;background:repeating-linear-gradient(45deg,transparent 0 20px,#ffffff2b 21px 23px,transparent 24px 45px);transform:translate(var(--ball-x,0px),var(--ball-y,0px))}.arcade-button{width:79px;height:79px;border:7px solid #22261d;background:var(--red);color:#752f21;border-radius:50%;box-shadow:0 5px 0 #151a11,inset 0 -6px 0 #bd4c37,inset 0 3px 0 #ffb39c;font-size:43px!important;transition:transform .12s}.arcade-button:active{transform:translateY(4px);box-shadow:0 1px 0 #151a11,inset 0 -2px 0 #bd4c37}.players{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:22px 0 17px}.players>.tiny{max-width:130px;color:#d8ddc9}.seats{display:flex;gap:8px}.seats button{display:flex;align-items:center;gap:6px;font:11px monospace;color:#d8ddc9;border:1px dashed #858b74;border-radius:5px;background:none;padding:10px}.seats i{width:8px;height:8px;background:#e98167;border-radius:50%}.seats button:nth-child(2) i{background:#d9ee65}.seats button:nth-child(3) i{background:#93b5ed}.seats button:nth-child(4) i{background:#d7a3e1}.seats span{font-size:9px}.seats button[aria-pressed=true]{border-style:solid;background:#444b34}.seats button:disabled{opacity:.35}.cabinet-feedback{border-top:1px solid #535548;display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:15px}.cabinet-feedback p{font-size:12px;line-height:1.6;margin:0;min-height:38px}.cabinet-feedback button{border:0;background:none;color:var(--acid);font:10px monospace;white-space:nowrap;padding:10px 0}.howto,.homage{font:10px/1.7 monospace;color:#bcc3ad;margin:12px 0 0}.homage{color:#949d86;margin-top:5px}.nojs{font-size:12px;background:#393b31;padding:16px}.essay-layout{display:grid;grid-template-columns:1fr 2.2fr;gap:76px;padding:0 40px 60px}.essay-layout aside{padding-top:8px;align-self:start;position:sticky;top:30px}.margin-number{font:86px/1 Georgia,serif;letter-spacing:-.09em}.essay-layout aside p{font-size:22px;line-height:1.2;letter-spacing:-.04em;margin:18px 0}.margin-rule{height:1px;background:#bbb5a7;width:60px;margin:25px 0}.essay{font-size:17px;line-height:1.85}.essay>p:first-child{font-size:24px;line-height:1.5;font-weight:600;letter-spacing:-.035em;margin-top:0}.essay p{margin:0 0 24px}.essay h2{font-size:26px;line-height:1.25;letter-spacing:-.045em;margin:44px 0 20px}.signature{padding-top:25px;border-top:1px solid #bbb5a7;margin-top:34px}.signature>span{font:italic 29px/1.2 Georgia,serif;letter-spacing:-.04em}.signature p{font:10px/1.6 monospace;margin:10px 0}.cabinet-notes{border-top:2px solid var(--ink);padding:32px 0 38px}.notes-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:28px}.notes-heading h2{font-size:36px;line-height:1.1;letter-spacing:-.05em;margin:0}.notes-heading>p{max-width:370px;font-size:12px;line-height:1.8;margin:0}.notes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#bcb7a8;border:1px solid #bcb7a8}.notes-grid article{padding:24px;background:#eae3d2}.notes-grid .tiny{margin:0 0 25px}.notes-grid h3{font-size:23px;letter-spacing:-.04em;margin:0 0 6px}.notes-grid .hardware{font:10px/1.7 monospace;color:#66634e;margin:0 0 18px}.notes-grid article>p:not(.tiny):not(.hardware){font-size:12px;line-height:1.8;margin:0 0 22px}.notes-grid a,.source-note{font:9px/1.7 monospace}.source-note{margin:15px 0 0;color:#66634e}.endnote{border-top:1px solid #bbb5a7;padding-top:32px;display:grid;grid-template-columns:1fr 1fr;gap:25px}.endnote>p{font-size:38px;line-height:1.15;letter-spacing:-.045em;margin:0}.endnote>div{display:flex;flex-direction:column;align-items:end;gap:12px}.endnote a{font-size:12px}.endnote>.tiny{grid-column:1/-1;margin-top:20px;color:#77735e}
  @media(max-width:700px){.remembrance{padding:20px 20px 45px}.opening{padding-top:34px}.opening h1{font-size:clamp(51px,10.5vw,75px)}.intro{display:block}.intro>p:first-child{font-size:18px}.byline{margin-top:20px}.cabinet{padding:14px;border-radius:14px;margin-bottom:52px}.cabinet-top{gap:10px;margin-bottom:18px}.cabinet-top h2{font-size:19px}.sound{padding:9px 10px;font-size:9px!important}.cabinet-tabs{grid-template-columns:repeat(2,1fr);gap:5px}.cabinet-tabs button{font-size:11px;padding:10px}.cabinet-tabs span{font-size:9px}.crt-frame{border-width:3px}.screen-top,.screen-bottom{padding:9px;font-size:7px;letter-spacing:.025em}.screen-bottom{font-size:6px}.control-deck{gap:26px;padding:20px 8px 10px}.wheel{width:82px;height:82px}.trackball,.arcade-button{width:61px;height:61px;border-width:6px}.arcade-button{font-size:33px!important}.control-label{font-size:8px;max-width:90px;letter-spacing:.025em}.control{gap:12px}.steer{gap:6px}.steer button{width:25px;height:26px}.steer span{font-size:8px}.players{display:block;padding:18px 0 12px}.players>.tiny{display:block;max-width:none;margin-bottom:10px}.seats{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.seats button{padding:9px 5px;justify-content:center;flex-wrap:wrap;font-size:10px}.seats i{width:6px;height:6px}.seats span{width:100%;font-size:8px;text-align:center}.cabinet-feedback{gap:10px}.cabinet-feedback p{font-size:10px;min-height:48px}.cabinet-feedback button{font-size:9px}.howto,.homage{font-size:9px}.essay-layout{display:block;padding:0 6px 36px}.essay-layout aside{display:none}.essay{font-size:16px;line-height:1.85}.essay>p:first-child{font-size:22px}.essay h2{font-size:24px;margin-top:34px}.notes-heading{display:block}.notes-heading h2{font-size:30px}.notes-heading>p{margin-top:20px}.notes-grid{grid-template-columns:1fr}.notes-grid article{padding:22px}.notes-grid .tiny{margin-bottom:14px}.endnote{grid-template-columns:1fr}.endnote>p{font-size:32px}.endnote>div{align-items:start}.endnote>.tiny{margin-top:0}}
  @media(prefers-reduced-motion:reduce){.remembrance *{scroll-behavior:auto!important;transition:none!important}}
</style>
