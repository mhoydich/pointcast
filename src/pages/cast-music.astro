  function dayHash(): number { const d = new Date(); const s = `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`; let h = 0; for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0; return Math.abs(h) || 1; }
  function seededShuffle<T>(arr: T[], seed: number): T[] { const a = [...arr]; let s = seed; for (let i = a.length - 1; i > 0; i--) { s = (s * 1664525 + 1013904223) >>> 0; const j = s % (i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; }
  const today = dayHash();
  const MIXES: Record<string, { name: string; emoji: string; tracks: Track[] }> = {
    'mix-chill':  { name: 'Chill Mix',   emoji: '🌿', tracks: seededShuffle(TRACKS.filter(t => t.mood === 'chill' || t.mood === 'meditative'), today + 1).slice(0, 8) },
