---
/**
 * /cast-music — PointCast Music. The Spotify-shaped front door for the drum hub.
 *
 * Mike 2026-05-08: "keep chasing, get more sophisticated, make as big as
 * spotify."
 *
 * Note: /cast was already taken by an earlier "PrizeCast" page; this lives
 * at /cast-music to avoid the collision.
 *
 * Three-pane Spotify-like layout:
 *
 *    ┌───────┬───────────────────────────────┬──────────┐
 *    │ NAV + │   MAIN VIEW                   │  QUEUE   │
 *    │ PLAY- │   (home/search/library/       │  PANEL   │
 *    │ LISTS │    artist/playlist)           │          │
 *    └───────┴───────────────────────────────┴──────────┘
 *    ┌──────────────────────────────────────────────────┐
 *    │  NOW PLAYING BAR (persistent across views)       │
 *    └──────────────────────────────────────────────────┘
 *
 * Catalog: 18 hand-authored tracks · 8 Noun "artists" · 4 daily mixes
 * (date-hash seeded so they refresh once a day) · live Web Audio.
 *
 * State persists in localStorage: saved tracks · playlists · recently
 * played · shuffle · repeat · volume.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Cast Music · PointCast · drum hub unified';
const description = 'Spotify-shaped app over the drum hub. 18 tracks · 8 Noun artists · daily mixes · search · library · queue · persistent now-playing.';
---

<BlockLayout title={title} description={description}>
  <main class="cm" id="cm-app">

    {/* SIDEBAR */}
    <aside class="cm__sidebar">
      <h1 class="cm__brand"><span class="cm__brand-logo">▶</span><span>CAST · MUSIC</span></h1>
      <nav class="cm__nav" aria-label="Main">
        <button class="cm__nav-btn cm__nav-btn--active" data-view="home" type="button"><span>🏠</span><span>Home</span></button>
        <button class="cm__nav-btn" data-view="search" type="button"><span>🔍</span><span>Search</span></button>
        <button class="cm__nav-btn" data-view="library" type="button"><span>📚</span><span>Your Library</span></button>
      </nav>
      <div class="cm__sidebar-section">
        <p class="cm__sidebar-label">DAILY MIXES</p>
        <button class="cm__sidebar-item" data-view="playlist" data-pl="mix-chill" type="button">🌿 Chill Mix</button>
        <button class="cm__sidebar-item" data-view="playlist" data-pl="mix-drive" type="button">🚗 Driving Mix</button>
        <button class="cm__sidebar-item" data-view="playlist" data-pl="mix-cinema" type="button">🎬 Cinema Mix</button>
        <button class="cm__sidebar-item" data-view="playlist" data-pl="mix-rush" type="button">⚡ Race Mix</button>
      </div>
      <div class="cm__sidebar-section">
        <p class="cm__sidebar-label">YOUR PLAYLISTS</p>
        <div class="cm__playlists" id="cm-playlists"><p class="cm__empty">— no playlists yet —</p></div>
        <button class="cm__sidebar-add" id="cm-new-playlist" type="button">+ NEW PLAYLIST</button>
      </div>
    </aside>

    {/* MAIN */}
    <section class="cm__main">
      <header class="cm__topbar">
        <div class="cm__nav-arrows">
          <button class="cm__nav-arrow" id="cm-back" type="button">‹</button>
          <button class="cm__nav-arrow" id="cm-forward" type="button">›</button>
        </div>
        <input class="cm__search" id="cm-search" type="text" placeholder="search tracks · artists · genres · moods" maxlength="80"/>
        <span class="cm__topbar-right">▶ playing on this tab</span>
      </header>
      <div class="cm__view" id="cm-view"><p class="cm__loading">loading…</p></div>
    </section>

    {/* QUEUE */}
    <aside class="cm__queue" id="cm-queue-panel">
      <header class="cm__queue-head"><h3>QUEUE</h3><button class="cm__queue-clear" id="cm-queue-clear" type="button">clear</button></header>
      <div class="cm__queue-section"><p class="cm__queue-label">NOW PLAYING</p><div class="cm__queue-list" id="cm-queue-now"></div></div>
      <div class="cm__queue-section"><p class="cm__queue-label">UP NEXT</p><div class="cm__queue-list" id="cm-queue-next"></div></div>
    </aside>

    {/* PLAYER */}
    <footer class="cm__player">
      <div class="cm__player-info">
        <img class="cm__player-art" id="cm-player-art" src="" alt="" width="56" height="56" hidden/>
        <div class="cm__player-meta">
          <span class="cm__player-track" id="cm-player-track">— pick a track —</span>
          <span class="cm__player-artist" id="cm-player-artist">tap any song to start</span>
        </div>
        <button class="cm__player-heart" id="cm-player-heart" type="button" aria-label="Save">♡</button>
      </div>
      <div class="cm__player-controls">
        <div class="cm__transport">
          <button class="cm__transport-btn" id="cm-shuffle" type="button" aria-label="Shuffle">⇋</button>
          <button class="cm__transport-btn" id="cm-prev" type="button" aria-label="Previous">⏮</button>
          <button class="cm__transport-btn cm__transport-btn--play" id="cm-play" type="button" aria-label="Play">▶</button>
          <button class="cm__transport-btn" id="cm-next" type="button" aria-label="Next">⏭</button>
          <button class="cm__transport-btn" id="cm-repeat" type="button" aria-label="Repeat">↻</button>
        </div>
        <div class="cm__progress">
          <span class="cm__progress-time" id="cm-time-cur">0:00</span>
          <div class="cm__progress-bar" id="cm-progress-bar"><div class="cm__progress-fill" id="cm-progress-fill"></div></div>
          <span class="cm__progress-time" id="cm-time-end">0:16</span>
        </div>
      </div>
      <div class="cm__player-right">
        <canvas class="cm__viz" id="cm-viz" width="120" height="32"></canvas>
        <label class="cm__volume"><span aria-hidden="true">🔊</span><input type="range" id="cm-volume" min="0" max="100" step="1" value="80"/></label>
      </div>
    </footer>
  </main>
</BlockLayout>

<style>
  .cm { display: grid; grid-template-columns: 240px 1fr 280px; grid-template-rows: 1fr 92px; grid-template-areas: 'sidebar main queue' 'player player player'; height: calc(100vh - 0px); margin: 0 auto; background: #050310; color: #f4e7c8; font-family: var(--pc-font-sans, system-ui, sans-serif); overflow: hidden; }
  @media (max-width: 1100px) { .cm { grid-template-columns: 220px 1fr; grid-template-areas: 'sidebar main' 'player player'; } .cm__queue { display: none; } }
  @media (max-width: 720px) { .cm { grid-template-columns: 1fr; grid-template-areas: 'main' 'player'; } .cm__sidebar { display: none; } }

  .cm__sidebar { grid-area: sidebar; background: #0a0418; border-right: 1px solid #1a0820; display: flex; flex-direction: column; padding: 16px 12px; gap: 18px; overflow-y: auto; }
  .cm__brand { font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; letter-spacing: 0.18em; margin: 0 0 6px; color: #f6c15e; display: flex; align-items: center; gap: 8px; }
  .cm__brand-logo { font-size: 18px; color: #d4a437; }
  .cm__nav { display: flex; flex-direction: column; gap: 2px; }
  .cm__nav-btn { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: none; background: transparent; color: #cfc6df; font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; font-weight: 700; letter-spacing: 0.10em; text-align: left; cursor: pointer; border-radius: 4px; transition: background 100ms, color 100ms; }
  .cm__nav-btn:hover { background: rgba(212, 164, 55, 0.10); color: #f6c15e; }
  .cm__nav-btn--active { background: rgba(212, 164, 55, 0.20); color: #f6c15e; }
  .cm__sidebar-section { display: flex; flex-direction: column; gap: 4px; }
  .cm__sidebar-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.22em; color: #d4a437; text-transform: uppercase; margin: 0 0 6px; opacity: 0.85; }
  .cm__sidebar-item { padding: 8px 12px; border: none; background: transparent; color: #cfc6df; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.06em; text-align: left; cursor: pointer; border-radius: 4px; transition: background 100ms, color 100ms; }
  .cm__sidebar-item:hover { background: rgba(212, 164, 55, 0.08); color: #f6c15e; }
  .cm__sidebar-item--active { background: rgba(212, 164, 55, 0.15); color: #f6c15e; }
  .cm__playlists { display: flex; flex-direction: column; gap: 2px; }
  .cm__sidebar-add { padding: 6px 12px; border: 1px dashed #5a3422; background: transparent; color: #d4a437; font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; border-radius: 4px; margin-top: 4px; }
  .cm__sidebar-add:hover { border-color: #d4a437; color: #f6c15e; }
  .cm__empty { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; color: #5a3422; text-align: center; padding: 8px; margin: 0; }

  .cm__main { grid-area: main; background: linear-gradient(180deg, #1a0a06 0%, #0a0418 30%); display: flex; flex-direction: column; overflow: hidden; }
  .cm__topbar { display: flex; align-items: center; gap: 14px; padding: 12px 18px; background: rgba(10, 4, 24, 0.70); backdrop-filter: blur(8px); border-bottom: 1px solid #1a0820; }
  .cm__nav-arrows { display: flex; gap: 6px; }
  .cm__nav-arrow { width: 28px; height: 28px; border: none; border-radius: 50%; background: rgba(0,0,0,0.40); color: #f6c15e; font-size: 16px; cursor: pointer; transition: background 100ms; }
  .cm__nav-arrow:hover { background: rgba(212, 164, 55, 0.20); }
  .cm__search { flex: 1; max-width: 360px; padding: 8px 14px; border: 1.5px solid #5a3422; border-radius: 999px; background: #1a0a06; color: #f4e7c8; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .cm__search:focus { outline: none; border-color: #d4a437; box-shadow: 0 0 0 2px rgba(246, 193, 94, 0.20); }
  .cm__topbar-right { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.18em; color: #d4a437; opacity: 0.65; margin-left: auto; text-transform: uppercase; }

  .cm__view { flex: 1; overflow-y: auto; padding: 24px 18px 32px; }
  .cm__loading { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; color: #5a3422; padding: 20px; text-align: center; }

  .cm__hero { padding: 40px 30px; border-radius: 8px; background: linear-gradient(135deg, var(--hero-c1, #5a3422) 0%, var(--hero-c2, #d4a437) 60%, var(--hero-c3, #f6c15e) 100%); color: #1a0820; margin-bottom: 22px; }
  .cm__hero-kicker { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.30em; margin: 0 0 6px; text-transform: uppercase; opacity: 0.85; }
  .cm__hero-title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(28px, 4.5vw, 48px); letter-spacing: 0.10em; margin: 0 0 6px; font-weight: 900; }
  .cm__hero-sub { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.10em; margin: 0 0 18px; opacity: 0.85; }
  .cm__hero-row { display: flex; gap: 12px; align-items: center; }
  .cm__hero-btn { padding: 10px 20px; border: none; border-radius: 999px; background: #1a0820; color: #f6c15e; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; box-shadow: 4px 4px 0 0 rgba(0,0,0,0.30); transition: transform 100ms; }
  .cm__hero-btn:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 0 rgba(0,0,0,0.30); }

  .cm__section { margin-bottom: 28px; }
  .cm__section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  .cm__section-title { font-family: 'JetBrains Mono Variable', monospace; font-size: 16px; letter-spacing: 0.10em; margin: 0; color: #f4e7c8; font-weight: 800; }
  .cm__section-link { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.16em; color: #d4a437; text-decoration: none; text-transform: uppercase; }
  .cm__section-link:hover { color: #f6c15e; }

  .cm__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
  .cm__card { padding: 12px; background: rgba(212, 164, 55, 0.05); border: 1px solid #1a0820; border-radius: 6px; cursor: pointer; transition: background 200ms, transform 100ms, border-color 200ms; }
  .cm__card:hover { background: rgba(212, 164, 55, 0.12); border-color: #5a3422; transform: translateY(-2px); }
  .cm__card-art { aspect-ratio: 1; width: 100%; background: linear-gradient(135deg, var(--card-c1, #5a3422), var(--card-c2, #d4a437)); border-radius: 4px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; padding: 12px; box-sizing: border-box; }
  .cm__card-art img { width: 100%; height: 100%; image-rendering: pixelated; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.45)); }
  .cm__card-art span { font-size: 48px; }
  .cm__card-title { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; margin: 0 0 4px; color: #f4e7c8; line-height: 1.2; }
  .cm__card-sub { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.06em; margin: 0; color: #cfc6df; opacity: 0.75; line-height: 1.3; }

  .cm__tracks { width: 100%; border-collapse: collapse; }
  .cm__tracks thead { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.22em; color: #5a3422; text-transform: uppercase; border-bottom: 1px solid #1a0820; }
  .cm__tracks thead th { padding: 8px 10px; text-align: left; font-weight: 800; }
  .cm__tracks tbody tr { transition: background 100ms; cursor: pointer; }
  .cm__tracks tbody tr:hover { background: rgba(212, 164, 55, 0.08); }
  .cm__tracks tbody tr.cm__tracks-row--playing { background: rgba(212, 164, 55, 0.18); }
  .cm__tracks tbody tr.cm__tracks-row--playing .cm__tracks-name { color: #f6c15e; }
  .cm__tracks td { padding: 8px 10px; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; color: #f4e7c8; vertical-align: middle; }
  .cm__tracks-num { width: 32px; color: #5a3422; text-align: center; }
  .cm__tracks-art { width: 36px; padding-right: 0 !important; }
  .cm__tracks-art img { width: 36px; height: 36px; image-rendering: pixelated; border-radius: 3px; }
  .cm__tracks-name { color: #f4e7c8; font-weight: 700; }
  .cm__tracks-artist { color: #cfc6df; opacity: 0.85; }
  .cm__tracks-artist a { color: inherit; text-decoration: none; }
  .cm__tracks-artist a:hover { color: #f6c15e; text-decoration: underline; }
  .cm__tracks-genre { color: #d4a437; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; }
  .cm__tracks-bpm { color: #cfc6df; opacity: 0.65; text-align: right; width: 60px; }
  .cm__tracks-actions { width: 32px; text-align: center; }
  .cm__tracks-heart { background: transparent; border: none; color: #5a3422; font-size: 16px; cursor: pointer; padding: 4px; transition: color 100ms; }
  .cm__tracks-heart:hover { color: #f6c15e; }
  .cm__tracks-heart--saved { color: #ff5f7a; }

  .cm__artist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
  .cm__artist-card { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px; background: rgba(212, 164, 55, 0.05); border: 1px solid #1a0820; border-radius: 8px; cursor: pointer; transition: background 200ms, transform 100ms; }
  .cm__artist-card:hover { background: rgba(212, 164, 55, 0.12); transform: translateY(-2px); }
  .cm__artist-card img { width: 90px; height: 90px; border-radius: 50%; image-rendering: pixelated; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.45)); background: #1a0a06; }
  .cm__artist-name { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; margin: 0; color: #f4e7c8; text-align: center; }
  .cm__artist-meta { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.16em; margin: 0; color: #cfc6df; opacity: 0.75; text-align: center; text-transform: uppercase; }

  .cm__artist-hero { display: flex; align-items: flex-end; gap: 20px; padding: 30px 20px; margin-bottom: 22px; background: linear-gradient(180deg, var(--artist-c, #5a3422) 0%, transparent 100%); border-radius: 8px; }
  .cm__artist-hero img { width: 140px; height: 140px; border-radius: 50%; image-rendering: pixelated; filter: drop-shadow(0 8px 20px rgba(0,0,0,0.6)); background: #1a0a06; }
  .cm__artist-hero-meta { flex: 1; }
  .cm__artist-hero-kicker { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.20em; margin: 0 0 4px; color: #d4a437; text-transform: uppercase; }
  .cm__artist-hero-name { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(28px, 4.5vw, 48px); letter-spacing: 0.10em; margin: 0 0 8px; font-weight: 900; color: #f6c15e; }
  .cm__artist-hero-bio { font-family: var(--pc-font-sans, system-ui, sans-serif); font-size: 14px; line-height: 1.5; color: #cfc6df; max-width: 560px; margin: 0; }

  .cm__queue { grid-area: queue; background: #0a0418; border-left: 1px solid #1a0820; display: flex; flex-direction: column; padding: 16px 12px; gap: 14px; overflow-y: auto; }
  .cm__queue-head { display: flex; align-items: baseline; justify-content: space-between; }
  .cm__queue-head h3 { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.20em; margin: 0; color: #f6c15e; text-transform: uppercase; }
  .cm__queue-clear { background: transparent; border: none; color: #d4a437; font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.16em; cursor: pointer; }
  .cm__queue-clear:hover { color: #f6c15e; }
  .cm__queue-section { display: flex; flex-direction: column; gap: 4px; }
  .cm__queue-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.20em; color: #d4a437; opacity: 0.85; margin: 0 0 4px; text-transform: uppercase; }
  .cm__queue-list { display: flex; flex-direction: column; gap: 4px; }
  .cm__queue-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 4px; cursor: pointer; transition: background 100ms; }
  .cm__queue-item:hover { background: rgba(212, 164, 55, 0.08); }
  .cm__queue-item img { width: 36px; height: 36px; image-rendering: pixelated; border-radius: 3px; }
  .cm__queue-item-meta { flex: 1; min-width: 0; }
  .cm__queue-item-name { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 700; color: #f4e7c8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm__queue-item-artist { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; color: #cfc6df; opacity: 0.75; }
  .cm__queue-item--current { background: rgba(212, 164, 55, 0.18); }
  .cm__queue-item--current .cm__queue-item-name { color: #f6c15e; }

  .cm__player { grid-area: player; display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: center; gap: 18px; padding: 8px 18px; background: linear-gradient(180deg, #1a0a06 0%, #0a0418 100%); border-top: 1px solid #d4a437; box-shadow: 0 -8px 24px rgba(0,0,0,0.5); }
  .cm__player-info { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .cm__player-art { border-radius: 4px; background: #1a0a06; image-rendering: pixelated; flex: none; }
  .cm__player-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cm__player-track { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; color: #f6c15e; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm__player-artist { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; color: #cfc6df; opacity: 0.75; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm__player-heart { background: transparent; border: none; color: #5a3422; font-size: 16px; cursor: pointer; padding: 4px; }
  .cm__player-heart:hover { color: #f6c15e; }
  .cm__player-heart--saved { color: #ff5f7a; }

  .cm__player-controls { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .cm__transport { display: flex; align-items: center; gap: 8px; }
  .cm__transport-btn { width: 30px; height: 30px; border: none; background: transparent; color: #cfc6df; font-size: 14px; cursor: pointer; border-radius: 50%; transition: color 100ms, background 100ms; }
  .cm__transport-btn:hover { color: #f6c15e; }
  .cm__transport-btn--play { width: 36px; height: 36px; background: #f6c15e; color: #1a0a06; font-size: 14px; }
  .cm__transport-btn--play:hover { background: #fff7c8; transform: scale(1.06); }
  .cm__transport-btn--active { color: #f6c15e; }
  .cm__progress { display: flex; align-items: center; gap: 8px; width: 100%; max-width: 480px; }
  .cm__progress-time { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; color: #cfc6df; opacity: 0.65; min-width: 30px; text-align: center; }
  .cm__progress-bar { flex: 1; height: 4px; background: rgba(212, 164, 55, 0.20); border-radius: 2px; position: relative; cursor: pointer; }
  .cm__progress-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; background: linear-gradient(90deg, #d4a437, #f6c15e); border-radius: 2px; transition: width 60ms linear; }

  .cm__player-right { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
  .cm__viz { background: rgba(0,0,0,0.40); border: 1px solid #5a3422; border-radius: 3px; }
  .cm__volume { display: flex; align-items: center; gap: 6px; color: #d4a437; font-size: 12px; }
  .cm__volume input[type='range'] { width: 90px; }
  @media (max-width: 720px) { .cm__player-right { display: none; } .cm__player { grid-template-columns: 1fr 1.2fr; } }

  .cm__lib-tabs { display: flex; gap: 4px; margin-bottom: 18px; border-bottom: 1px solid #1a0820; flex-wrap: wrap; }
  .cm__lib-tab { padding: 10px 16px; border: none; background: transparent; color: #cfc6df; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; cursor: pointer; border-bottom: 2px solid transparent; transition: color 100ms, border-color 100ms; }
  .cm__lib-tab:hover { color: #f6c15e; }
  .cm__lib-tab--active { color: #f6c15e; border-bottom-color: #f6c15e; }
</style>

<script>
  type Inst = 'kick' | 'snare' | 'bell' | 'lead' | 'pad';
  type Genre = 'drum' | 'ambient' | 'cinema' | 'race' | 'orchestral' | 'electronic' | 'jazz';
