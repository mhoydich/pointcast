    'mix-rush':   { name: 'Race Mix',    emoji: '⚡', tracks: seededShuffle(TRACKS.filter(t => t.mood === 'rush' || t.genre === 'race'), today + 4).slice(0, 6) },
  };

  let actx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let analyser: AnalyserNode | null = null;
  function ctx() { if (!actx) { const AC = (window as any).AudioContext || (window as any).webkitAudioContext; actx = new AC(); } if (actx && actx.state === 'suspended') actx.resume(); return actx!; }
  function ensureBus() { if (masterGain) return; const a = ctx(); masterGain = a.createGain(); analyser = a.createAnalyser(); analyser.fftSize = 512; analyser.smoothingTimeConstant = 0.78; masterGain.connect(analyser); analyser.connect(a.destination); masterGain.gain.value = 0.80; }
  function getMaster(): AudioNode { ensureBus(); return masterGain!; }
  function pK(t:number,d:AudioNode){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(120,t);o.frequency.exponentialRampToValueAtTime(40,t+0.18);g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.25);o.connect(g).connect(d);o.start(t);o.stop(t+0.3);}
  function pSn(t:number,d:AudioNode){const a=ctx(),buf=a.createBuffer(1,a.sampleRate*0.12,a.sampleRate),x=buf.getChannelData(0);for(let i=0;i<x.length;i++)x[i]=Math.random()*2-1;const n=a.createBufferSource();n.buffer=buf;const bp=a.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1800;bp.Q.value=1.2;const g=a.createGain();g.gain.setValueAtTime(0.32,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.18);n.connect(bp).connect(g).connect(d);n.start(t);n.stop(t+0.2);}
  function pB(t:number,d:AudioNode){const a=ctx();[1320,2640,3960].forEach((f,i)=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime([0.13,0.07,0.04][i],t);g.gain.exponentialRampToValueAtTime(0.0001,t+1.0);o.connect(g).connect(d);o.start(t);o.stop(t+1.1);});}
  function pL(t:number,d:AudioNode){const a=ctx();const D=[0,4,7,12,14],deg=D[Math.floor(Math.random()*D.length)],f=264*Math.pow(2,deg/12);const o=a.createOscillator(),g=a.createGain(),lp=a.createBiquadFilter();o.type='sawtooth';o.frequency.setValueAtTime(f,t);lp.type='lowpass';lp.frequency.setValueAtTime(2200,t);lp.frequency.exponentialRampToValueAtTime(800,t+0.4);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.13,t+0.005);g.gain.exponentialRampToValueAtTime(0.0001,t+0.4);o.connect(lp).connect(g).connect(d);o.start(t);o.stop(t+0.45);}
  function pP(t:number,d:AudioNode){const a=ctx();[132,198].forEach(f=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.09,t+0.18);g.gain.linearRampToValueAtTime(0.09,t+0.4);g.gain.exponentialRampToValueAtTime(0.0001,t+0.65);o.connect(g).connect(d);o.start(t);o.stop(t+0.7);});}
  const PLAY: Record<Inst, (t: number, d: AudioNode) => void> = { kick: pK, snare: pSn, bell: pB, lead: pL, pad: pP };

  let view: 'home' | 'search' | 'library' | 'artist' | 'playlist' = 'home';
  let viewArg = '';
  let history: { view: typeof view; arg: string }[] = [];
  let historyIdx = -1;
  let queue: Track[] = [];
  let queueIdx = -1;
  let playing = false;
  let step = 0;
  let stepTimer: number | null = null;
  let drawHandle: number | null = null;
  let trackStartT = 0;
  let trackLoopCount = 0;
  const LOOPS_PER_TRACK = 4;
  let shuffle = false;
  let repeat: 'off' | 'all' | 'one' = 'off';
  let volume = 80;
  let recentlyPlayed: string[] = [];

  function storeGet<T>(k: string, fallback: T): T { try { const r = localStorage.getItem(k); if (r) return JSON.parse(r); } catch {} return fallback; }
  function storeSet(k: string, v: unknown) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }
  let saved: string[] = storeGet('pc-cm-saved', []);
  let userPlaylists: { id: string; name: string; tracks: string[] }[] = storeGet('pc-cm-playlists', []);
  recentlyPlayed = storeGet('pc-cm-recent', []);
  shuffle = storeGet('pc-cm-shuffle', false);
  repeat = storeGet('pc-cm-repeat', 'off') as any;
  volume = storeGet('pc-cm-volume', 80);

  function getPlaylist(id: string): { name: string; tracks: Track[]; emoji?: string } | null {
    if (id.startsWith('mix-') && MIXES[id]) return { name: MIXES[id].name, tracks: MIXES[id].tracks, emoji: MIXES[id].emoji };
    if (id.startsWith('user-')) { const p = userPlaylists.find(x => x.id === id); if (!p) return null; return { name: p.name, tracks: p.tracks.map(tid => TRACKS.find(t => t.id === tid)).filter((t): t is Track => !!t) }; }
    return null;
  }

  function loadQueue(tracks: Track[], startIdx = 0) { queue = tracks.slice(); queueIdx = Math.max(0, Math.min(tracks.length - 1, startIdx)); if (queue.length === 0) return; playTrack(); }
  function playTrack() {
    if (queue.length === 0 || queueIdx < 0) return;
    const t = queue[queueIdx];
    ensureBus();
    if (masterGain) masterGain.gain.value = volume / 100;
    step = 0; trackLoopCount = 0; trackStartT = performance.now();
    playing = true;
    if (stepTimer) clearInterval(stepTimer);
    stepTimer = window.setInterval(tick, (60 / t.bpm / 4) * 1000);
    recentlyPlayed = [t.id, ...recentlyPlayed.filter(x => x !== t.id)].slice(0, 12);
    storeSet('pc-cm-recent', recentlyPlayed);
    paintPlayer();
    if (!drawHandle) drawLoop();
  }
  function tick() {
    if (!playing || queueIdx < 0) return;
    const t = queue[queueIdx];
    const at = ctx().currentTime + 0.02;
    (['kick','snare','bell','lead','pad'] as const).forEach(inst => { if ((t.pattern as any)[inst][step]) try { PLAY[inst](at, getMaster()); } catch {} });
    step++;
    if (step >= 16) { step = 0; trackLoopCount++; if (trackLoopCount >= LOOPS_PER_TRACK) { if (repeat === 'one') { trackLoopCount = 0; trackStartT = performance.now(); return; } nextTrack(); } }
  }
  function pause() { playing = false; if (stepTimer) { clearInterval(stepTimer); stepTimer = null; } paintPlayer(); }
  function resume() { if (queue.length === 0 || queueIdx < 0 || playing) return; ensureBus(); playing = true; const t = queue[queueIdx]; stepTimer = window.setInterval(tick, (60 / t.bpm / 4) * 1000); paintPlayer(); }
  function nextTrack() {
    if (queue.length === 0) return;
    if (shuffle) { let n = Math.floor(Math.random() * queue.length); if (n === queueIdx && queue.length > 1) n = (n + 1) % queue.length; queueIdx = n; }
    else queueIdx++;
    if (queueIdx >= queue.length) { if (repeat === 'all') queueIdx = 0; else { queueIdx = queue.length - 1; pause(); paintPlayer(); return; } }
    playTrack();
  }
  function prevTrack() { if (queue.length === 0) return; queueIdx = Math.max(0, queueIdx - 1); playTrack(); }
  function setVolume(v: number) { volume = Math.max(0, Math.min(100, v)); if (masterGain) masterGain.gain.value = volume / 100; storeSet('pc-cm-volume', volume); }

  const freqData = new Uint8Array(256);
  function drawLoop() {
    drawHandle = window.requestAnimationFrame(drawLoop);
    if (!analyser) return;
    analyser.getByteFrequencyData(freqData);
    const c = document.getElementById('cm-viz') as HTMLCanvasElement | null;
    if (c) { const x = c.getContext('2d'); if (x) { const w = c.width, h = c.height; x.clearRect(0, 0, w, h); const bins = 24; const binW = w / bins; for (let i = 0; i < bins; i++) { const v = freqData[i * 3] / 255; const bh = Math.max(2, v * h * 0.92); const grad = x.createLinearGradient(0, h, 0, h - bh); grad.addColorStop(0, '#5a3422'); grad.addColorStop(0.6, '#d4a437'); grad.addColorStop(1, '#f6c15e'); x.fillStyle = grad; x.fillRect(i * binW + 1, h - bh, binW - 2, bh); } } }
    paintProgress();
  }
  function paintProgress() {
    if (queue.length === 0 || queueIdx < 0) return;
    const t = queue[queueIdx];
    const elapsed = playing ? (performance.now() - trackStartT) : 0;
    const stepMs = (60 / t.bpm / 4) * 1000;
    const totalMs = stepMs * 16 * LOOPS_PER_TRACK;
    const pct = Math.min(100, (elapsed / totalMs) * 100);
    const fill = document.getElementById('cm-progress-fill');
    if (fill) (fill as HTMLElement).style.width = `${pct}%`;
    const cur = document.getElementById('cm-time-cur'); if (cur) cur.textContent = fmtTime(elapsed / 1000);
    const end = document.getElementById('cm-time-end'); if (end) end.textContent = fmtTime(totalMs / 1000);
  }
  function fmtTime(s: number): string { const m = Math.floor(s / 60); const r = Math.floor(s % 60); return `${m}:${String(r).padStart(2, '0')}`; }

  function paintPlayer() {
    const t = queue[queueIdx];
    const trackEl = document.getElementById('cm-player-track');
    const artistEl = document.getElementById('cm-player-artist');
    const artEl = document.getElementById('cm-player-art') as HTMLImageElement | null;
    const heartEl = document.getElementById('cm-player-heart');
    const playBtn = document.getElementById('cm-play');
    if (!t) {
      if (trackEl) trackEl.textContent = '— pick a track —';
      if (artistEl) artistEl.textContent = 'tap any song to start';
      if (artEl) artEl.hidden = true;
      if (heartEl) heartEl.classList.remove('cm__player-heart--saved');
    } else {
      if (trackEl) trackEl.textContent = t.name;
      if (artistEl) artistEl.textContent = t.artist;
      if (artEl) { artEl.src = `https://noun.pics/${t.artistId}.svg`; artEl.hidden = false; }
      if (heartEl) heartEl.classList.toggle('cm__player-heart--saved', saved.includes(t.id));
    }
    if (playBtn) (playBtn as HTMLElement).textContent = playing ? '⏸' : '▶';
    document.getElementById('cm-shuffle')?.classList.toggle('cm__transport-btn--active', shuffle);
    document.getElementById('cm-repeat')?.classList.toggle('cm__transport-btn--active', repeat !== 'off');
    paintQueue();
    paintTrackRows();
  }
  function paintQueue() {
    const now = document.getElementById('cm-queue-now');
    const next = document.getElementById('cm-queue-next');
    if (now) {
      now.innerHTML = (queueIdx >= 0 ? [queue[queueIdx]] : []).filter(Boolean).map(t => trackRowHtml(t!, true)).join('') || '<p class="cm__empty">— nothing playing —</p>';
      Array.from(now.querySelectorAll<HTMLElement>('.cm__queue-item')).forEach(el => el.addEventListener('click', () => resume()));
    }
    if (next) {
      const upNext = queue.slice(queueIdx + 1, queueIdx + 8);
      next.innerHTML = upNext.length ? upNext.map(t => trackRowHtml(t)).join('') : '<p class="cm__empty">— end of queue —</p>';
      Array.from(next.querySelectorAll<HTMLElement>('.cm__queue-item')).forEach((el, i) => el.addEventListener('click', () => { queueIdx = queueIdx + 1 + i; playTrack(); }));
    }
  }
  function trackRowHtml(t: Track, current = false) { return `<div class="cm__queue-item ${current ? 'cm__queue-item--current' : ''}" data-tid="${t.id}"><img src="https://noun.pics/${t.artistId}.svg" alt=""/><div class="cm__queue-item-meta"><div class="cm__queue-item-name">${escape(t.name)}</div><div class="cm__queue-item-artist">${escape(t.artist)}</div></div></div>`; }
  function paintTrackRows() { const cur = queueIdx >= 0 ? queue[queueIdx]?.id : null; document.querySelectorAll<HTMLElement>('.cm__tracks-row').forEach(r => r.classList.toggle('cm__tracks-row--playing', r.dataset.tid === cur)); }

  const viewEl = document.getElementById('cm-view');
  function escape(s: string): string { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

  function renderHome(): string {
    const todays = TRACKS[today % TRACKS.length];
    const recent = recentlyPlayed.map(id => TRACKS.find(t => t.id === id)).filter((t): t is Track => !!t).slice(0, 6);
    const greeting = ['Good morning', 'Good afternoon', 'Good evening', 'Good night'][Math.min(3, Math.floor(new Date().getHours() / 6))];
    return `
      <div class="cm__hero" style="--hero-c1: ${todays.color}; --hero-c2: #d4a437; --hero-c3: #f6c15e;">
        <p class="cm__hero-kicker">${greeting} · TODAY'S PICK</p>
        <h2 class="cm__hero-title">${escape(todays.name)}</h2>
        <p class="cm__hero-sub">by <strong>${escape(todays.artist)}</strong> · ${todays.bpm} bpm · ${todays.genre} · ${todays.mood}</p>
        <div class="cm__hero-row"><button class="cm__hero-btn" data-tid="${todays.id}">▶ PLAY</button></div>
      </div>

      <section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">YOUR DAILY MIXES</h2></header>
      <div class="cm__grid">${Object.entries(MIXES).map(([id, m]) => `<div class="cm__card" data-pl="${id}" style="--card-c1: ${m.tracks[0]?.color || '#5a3422'}; --card-c2: #d4a437;"><div class="cm__card-art"><span>${m.emoji}</span></div><p class="cm__card-title">${escape(m.name)}</p><p class="cm__card-sub">${m.tracks.length} tracks · refreshed today</p></div>`).join('')}</div></section>

      <section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">TOP NOUN ARTISTS</h2></header>
      <div class="cm__artist-grid">${ARTISTS.map(a => `<div class="cm__artist-card" data-artist="${a.id}"><img src="https://noun.pics/${a.id}.svg" alt=""/><p class="cm__artist-name">${escape(a.name)}</p><p class="cm__artist-meta">${TRACKS.filter(t => t.artistId === a.id).length} tracks</p></div>`).join('')}</div></section>

      ${recent.length ? `<section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">RECENTLY PLAYED</h2></header>
      <div class="cm__grid">${recent.map(t => `<div class="cm__card" data-tid="${t.id}" style="--card-c1: ${t.color}; --card-c2: #1a0a06;"><div class="cm__card-art"><img src="https://noun.pics/${t.artistId}.svg" alt=""/></div><p class="cm__card-title">${escape(t.name)}</p><p class="cm__card-sub">${escape(t.artist)} · ${t.bpm} bpm</p></div>`).join('')}</div></section>` : ''}

      <section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">NEW RELEASES</h2></header>${tracksTableHtml(TRACKS.slice(0, 8))}</section>
    `;
  }
  function renderSearch(query: string): string {
    const q = query.trim().toLowerCase();
    if (!q) return `<h2 class="cm__section-title" style="margin-bottom: 14px;">BROWSE BY GENRE</h2><div class="cm__grid">${(['drum','ambient','cinema','race','orchestral','electronic','jazz'] as Genre[]).map(g => { const n = TRACKS.filter(t => t.genre === g).length; return `<div class="cm__card" data-search="${g}" style="--card-c1: #5a3422; --card-c2: #d4a437;"><div class="cm__card-art"><span>🎵</span></div><p class="cm__card-title">${g.toUpperCase()}</p><p class="cm__card-sub">${n} tracks</p></div>`; }).join('')}</div>`;
    const matches = TRACKS.filter(t => t.name.toLowerCase().includes(q) || t.artist.toLowerCase().includes(q) || t.genre.includes(q) || t.mood.includes(q));
    return `<h2 class="cm__section-title" style="margin-bottom: 14px;">RESULTS FOR "${escape(query)}" · ${matches.length}</h2>${matches.length ? tracksTableHtml(matches) : '<p class="cm__empty">no tracks matched</p>'}`;
  }
  let libTab: 'tracks' | 'playlists' | 'loops' | 'achievements' = 'tracks';
  function renderLibrary(): string {
    const savedTracks = saved.map(id => TRACKS.find(t => t.id === id)).filter((t): t is Track => !!t);
    const loops = storeGet<{ name?: string; pattern?: any; ts?: number }[]>('pc-loops', []);
    const races = storeGet<any>('pc-drum-race-v3-stats', null);
    const cinema = storeGet<string[]>('pc-ncn3-collected', []);
    return `<h2 class="cm__section-title" style="margin-bottom: 14px;">YOUR LIBRARY</h2>
      <div class="cm__lib-tabs">
        <button class="cm__lib-tab ${libTab==='tracks' ? 'cm__lib-tab--active' : ''}" data-libtab="tracks">SAVED · ${savedTracks.length}</button>
        <button class="cm__lib-tab ${libTab==='playlists' ? 'cm__lib-tab--active' : ''}" data-libtab="playlists">PLAYLISTS · ${userPlaylists.length}</button>
        <button class="cm__lib-tab ${libTab==='loops' ? 'cm__lib-tab--active' : ''}" data-libtab="loops">LOOPS · ${loops.length}</button>
        <button class="cm__lib-tab ${libTab==='achievements' ? 'cm__lib-tab--active' : ''}" data-libtab="achievements">ACHIEVEMENTS</button>
      </div>
      <div>${libTab === 'tracks' ? (savedTracks.length ? tracksTableHtml(savedTracks) : '<p class="cm__empty">no saved tracks · tap the heart on any song</p>')
      : libTab === 'playlists' ? (userPlaylists.length ? `<div class="cm__grid">${userPlaylists.map(p => `<div class="cm__card" data-pl="${p.id}" style="--card-c1: #5a3422; --card-c2: #d4a437;"><div class="cm__card-art"><span>📃</span></div><p class="cm__card-title">${escape(p.name)}</p><p class="cm__card-sub">${p.tracks.length} tracks</p></div>`).join('')}</div>` : '<p class="cm__empty">no playlists yet · use + NEW PLAYLIST</p>')
      : libTab === 'loops' ? (loops.length ? `<ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px;font-family:'JetBrains Mono Variable',monospace;font-size:11px;">${loops.map(l => `<li style="padding:8px 12px;background:rgba(212,164,55,0.08);border:1px solid #1a0820;border-radius:4px;display:flex;justify-content:space-between;"><span>${escape(l.name || 'untitled')}</span><a href="/drum-looper" style="color:#d4a437;text-decoration:none;">→ open</a></li>`).join('')}</ul>` : '<p class="cm__empty">no loops saved · go to <a href="/drum-looper" style="color:#f6c15e;">/drum-looper</a></p>')
      : `<div class="cm__grid"><div class="cm__card" style="--card-c1:#a8ff3a;--card-c2:#5a3422;"><div class="cm__card-art"><span>🏆</span></div><p class="cm__card-title">RACE WINS</p><p class="cm__card-sub">${races?.totals?.victories || 0} victories · ${races?.totals?.races || 0} races</p></div><div class="cm__card" style="--card-c1:#f6c15e;--card-c2:#5a3422;"><div class="cm__card-art"><span>🎬</span></div><p class="cm__card-title">CINEMA ENDINGS</p><p class="cm__card-sub">${cinema.length} / 4 collected</p></div><div class="cm__card" style="--card-c1:#5fbafd;--card-c2:#1a0820;"><div class="cm__card-art"><span>🎵</span></div><p class="cm__card-title">SAVED TRACKS</p><p class="cm__card-sub">${saved.length} hearts</p></div></div>`}
      </div>`;
  }
  function renderArtist(idStr: string): string {
    const a = ARTISTS.find(x => String(x.id) === idStr);
    if (!a) return '<p class="cm__empty">artist not found</p>';
    const tracks = TRACKS.filter(t => t.artistId === a.id);
    const related = ARTISTS.filter(x => x.id !== a.id).slice(0, 4);
    return `<div class="cm__artist-hero" style="--artist-c: ${a.color}aa;"><img src="https://noun.pics/${a.id}.svg" alt=""/><div class="cm__artist-hero-meta"><p class="cm__artist-hero-kicker">ARTIST · NOUN #${a.id}</p><h2 class="cm__artist-hero-name">${escape(a.name)}</h2><p class="cm__artist-hero-bio">${escape(a.bio)}</p></div></div>
      <section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">TRACKS · ${tracks.length}</h2><a href="#" class="cm__section-link" data-play-artist="${a.id}">▶ play all</a></header>${tracksTableHtml(tracks)}</section>
      <section class="cm__section"><header class="cm__section-head"><h2 class="cm__section-title">RELATED</h2></header><div class="cm__artist-grid">${related.map(r => `<div class="cm__artist-card" data-artist="${r.id}"><img src="https://noun.pics/${r.id}.svg" alt=""/><p class="cm__artist-name">${escape(r.name)}</p><p class="cm__artist-meta">${TRACKS.filter(t => t.artistId === r.id).length} tracks</p></div>`).join('')}</div></section>`;
  }
  function renderPlaylist(id: string): string {
    const p = getPlaylist(id);
    if (!p) return '<p class="cm__empty">playlist not found</p>';
    return `<div class="cm__hero" style="--hero-c1: ${p.tracks[0]?.color || '#5a3422'}; --hero-c2: #d4a437; --hero-c3: #f6c15e;"><p class="cm__hero-kicker">PLAYLIST · ${id.startsWith('mix-') ? 'DAILY MIX' : 'YOUR LIST'}</p><h2 class="cm__hero-title">${p.emoji ? p.emoji + ' ' : ''}${escape(p.name)}</h2><p class="cm__hero-sub">${p.tracks.length} tracks · ${id.startsWith('mix-') ? 'refreshed daily' : 'made by you'}</p><div class="cm__hero-row"><button class="cm__hero-btn" data-play-pl="${id}">▶ PLAY</button></div></div>${tracksTableHtml(p.tracks)}`;
  }
  function tracksTableHtml(tracks: Track[]): string {
    return `<table class="cm__tracks"><thead><tr><th class="cm__tracks-num">#</th><th></th><th>TITLE</th><th>ARTIST</th><th>GENRE</th><th>BPM</th><th></th></tr></thead><tbody>${tracks.map((t, i) => `<tr class="cm__tracks-row" data-tid="${t.id}"><td class="cm__tracks-num">${i + 1}</td><td class="cm__tracks-art"><img src="https://noun.pics/${t.artistId}.svg" alt=""/></td><td class="cm__tracks-name">${escape(t.name)}</td><td class="cm__tracks-artist"><a href="#" data-artist="${t.artistId}">${escape(t.artist)}</a></td><td class="cm__tracks-genre">${t.genre}</td><td class="cm__tracks-bpm">${t.bpm}</td><td class="cm__tracks-actions"><button class="cm__tracks-heart ${saved.includes(t.id) ? 'cm__tracks-heart--saved' : ''}" data-heart="${t.id}" type="button">${saved.includes(t.id) ? '♥' : '♡'}</button></td></tr>`).join('')}</tbody></table>`;
  }

  function setView(v: typeof view, arg: string = '', pushHistory = true) {
    view = v; viewArg = arg;
    if (pushHistory) { history = history.slice(0, historyIdx + 1); history.push({ view: v, arg }); historyIdx = history.length - 1; }
    if (!viewEl) return;
    viewEl.innerHTML = (v === 'home' ? renderHome() : v === 'search' ? renderSearch((document.getElementById('cm-search') as HTMLInputElement)?.value || '') : v === 'library' ? renderLibrary() : v === 'artist' ? renderArtist(arg) : v === 'playlist' ? renderPlaylist(arg) : '');
    document.querySelectorAll<HTMLElement>('.cm__nav-btn').forEach(b => b.classList.toggle('cm__nav-btn--active', b.dataset.view === v && (v !== 'playlist')));
    document.querySelectorAll<HTMLElement>('.cm__sidebar-item').forEach(b => b.classList.toggle('cm__sidebar-item--active', b.dataset.view === v && b.dataset.pl === arg));
    paintTrackRows();
    wireDelegates();
  }

  function wireDelegates() {
    if (!viewEl) return;
    viewEl.querySelectorAll<HTMLElement>('.cm__tracks-row').forEach(row => {
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button, a')) return;
        const tid = row.dataset.tid!;
        const allRows = Array.from(viewEl!.querySelectorAll<HTMLElement>('.cm__tracks-row'));
        const tracks = allRows.map(r => TRACKS.find(t => t.id === r.dataset.tid)).filter((t): t is Track => !!t);
        const idx = tracks.findIndex(t => t.id === tid);
        loadQueue(tracks, idx);
      });
    });
    viewEl.querySelectorAll<HTMLButtonElement>('[data-heart]').forEach(b => b.addEventListener('click', (e) => {
      e.stopPropagation();
      const tid = b.dataset.heart!;
      if (saved.includes(tid)) saved = saved.filter(x => x !== tid); else saved.push(tid);
      storeSet('pc-cm-saved', saved);
      b.classList.toggle('cm__tracks-heart--saved', saved.includes(tid));
      b.textContent = saved.includes(tid) ? '♥' : '♡';
      paintPlayer();
    }));
    viewEl.querySelectorAll<HTMLElement>('[data-artist]').forEach(el => el.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); const id = el.dataset.artist!; setView('artist', id); }));
    viewEl.querySelectorAll<HTMLElement>('[data-pl]').forEach(el => el.addEventListener('click', (e) => { e.stopPropagation(); const id = el.dataset.pl!; setView('playlist', id); }));
    viewEl.querySelectorAll<HTMLElement>('.cm__card[data-tid]').forEach(el => el.addEventListener('click', (e) => { e.stopPropagation(); const tid = el.dataset.tid!; const t = TRACKS.find(x => x.id === tid); if (t) loadQueue([t]); }));
    viewEl.querySelectorAll<HTMLButtonElement>('button[data-tid]').forEach(b => b.addEventListener('click', (e) => { e.stopPropagation(); const tid = b.dataset.tid!; const t = TRACKS.find(x => x.id === tid); if (t) loadQueue([t]); }));
    viewEl.querySelectorAll<HTMLButtonElement>('[data-play-pl]').forEach(b => b.addEventListener('click', () => { const id = b.dataset.playPl!; const p = getPlaylist(id); if (p) loadQueue(p.tracks); }));
    viewEl.querySelectorAll<HTMLButtonElement>('[data-play-artist]').forEach(b => b.addEventListener('click', () => { const id = b.dataset.playArtist!; const ts = TRACKS.filter(t => t.artistId === Number(id)); loadQueue(ts); }));
    viewEl.querySelectorAll<HTMLElement>('[data-search]').forEach(el => el.addEventListener('click', (e) => { e.stopPropagation(); const q = el.dataset.search!; const inp = document.getElementById('cm-search') as HTMLInputElement; if (inp) inp.value = q; setView('search'); }));
    viewEl.querySelectorAll<HTMLButtonElement>('[data-libtab]').forEach(b => b.addEventListener('click', () => { libTab = b.dataset.libtab as any; setView('library', '', false); }));
  }

  function renderSidebarPlaylists() {
    const el = document.getElementById('cm-playlists');
    if (!el) return;
    el.innerHTML = userPlaylists.length ? userPlaylists.map(p => `<button class="cm__sidebar-item" data-view="playlist" data-pl="${p.id}" type="button">📃 ${escape(p.name)}</button>`).join('') : '<p class="cm__empty">— no playlists yet —</p>';
    el.querySelectorAll<HTMLButtonElement>('.cm__sidebar-item').forEach(b => b.addEventListener('click', () => setView('playlist', b.dataset.pl!)));
  }

  document.querySelectorAll<HTMLButtonElement>('.cm__sidebar .cm__nav-btn').forEach(b => b.addEventListener('click', () => setView(b.dataset.view as any)));
  document.querySelectorAll<HTMLButtonElement>('.cm__sidebar-item[data-view]').forEach(b => b.addEventListener('click', () => setView(b.dataset.view as any, b.dataset.pl || '')));

  const searchInput = document.getElementById('cm-search') as HTMLInputElement;
  let searchTimer: number | null = null;
  searchInput?.addEventListener('input', () => { if (searchTimer) clearTimeout(searchTimer); searchTimer = window.setTimeout(() => { setView('search', '', view !== 'search'); }, 120); });

  document.getElementById('cm-play')?.addEventListener('click', () => { if (queue.length === 0) { loadQueue(MIXES['mix-drive'].tracks); return; } if (playing) pause(); else resume(); });
  document.getElementById('cm-prev')?.addEventListener('click', prevTrack);
  document.getElementById('cm-next')?.addEventListener('click', nextTrack);
  document.getElementById('cm-shuffle')?.addEventListener('click', () => { shuffle = !shuffle; storeSet('pc-cm-shuffle', shuffle); paintPlayer(); });
  document.getElementById('cm-repeat')?.addEventListener('click', () => { const seq: ('off'|'all'|'one')[] = ['off','all','one']; const i = seq.indexOf(repeat); repeat = seq[(i+1) % seq.length]; storeSet('pc-cm-repeat', repeat); paintPlayer(); });
  (document.getElementById('cm-volume') as HTMLInputElement)?.addEventListener('input', (e) => { setVolume(Number((e.target as HTMLInputElement).value)); });
  (document.getElementById('cm-volume') as HTMLInputElement).value = String(volume);

  document.getElementById('cm-player-heart')?.addEventListener('click', () => { if (queueIdx < 0) return; const tid = queue[queueIdx].id; if (saved.includes(tid)) saved = saved.filter(x => x !== tid); else saved.push(tid); storeSet('pc-cm-saved', saved); paintPlayer(); if (view === 'library') setView('library', '', false); });

  document.getElementById('cm-progress-bar')?.addEventListener('click', (e) => { if (queueIdx < 0) return; const bar = e.currentTarget as HTMLElement; const rect = bar.getBoundingClientRect(); const pct = (e.clientX - rect.left) / rect.width; const t = queue[queueIdx]; const stepMs = (60 / t.bpm / 4) * 1000; const totalMs = stepMs * 16 * LOOPS_PER_TRACK; trackStartT = performance.now() - pct * totalMs; trackLoopCount = Math.floor((pct * LOOPS_PER_TRACK)); });

  document.getElementById('cm-queue-clear')?.addEventListener('click', () => { queue = queueIdx >= 0 ? [queue[queueIdx]] : []; queueIdx = queue.length - 1; paintQueue(); });
  document.getElementById('cm-back')?.addEventListener('click', () => { if (historyIdx > 0) { historyIdx--; const h = history[historyIdx]; setView(h.view, h.arg, false); } });
  document.getElementById('cm-forward')?.addEventListener('click', () => { if (historyIdx < history.length - 1) { historyIdx++; const h = history[historyIdx]; setView(h.view, h.arg, false); } });

  document.getElementById('cm-new-playlist')?.addEventListener('click', () => {
    const name = prompt('Playlist name?')?.trim().slice(0, 40);
    if (!name) return;
    const id = `user-${Date.now().toString(36)}`;
    userPlaylists.push({ id, name, tracks: [] });
    storeSet('pc-cm-playlists', userPlaylists);
    renderSidebarPlaylists();
    setView('playlist', id);
  });

  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
    if (e.code === 'Space') { e.preventDefault(); if (queue.length === 0) { loadQueue(MIXES['mix-drive'].tracks); return; } playing ? pause() : resume(); }
    if (e.key === 'ArrowRight' && e.shiftKey) nextTrack();
    if (e.key === 'ArrowLeft' && e.shiftKey) prevTrack();
    if (e.key === '/') { e.preventDefault(); searchInput?.focus(); }
  });

  setView('home');
  renderSidebarPlaylists();
  paintPlayer();
  drawLoop();
</script>
