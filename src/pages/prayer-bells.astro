---
/**
 * /prayer-bells — The Angelus.
 *
 * Per Mike 2026-07-19, after the two chambers shipped:
 *   "yes and an ability to play music, chimes, etc nice sounds in an
 *    interactive meditative way, next sprint thank you, select more
 *    images as well"
 *
 * The chambers ring the hours; this is the instrument that rings
 * them. Twelve brass chimes tuned to C-major pentatonic across two
 * octaves — every note agrees with every other, so nothing you play
 * can be wrong. Three voices (chime, bowl, music box), a WIND mode
 * that lets the garden play itself over a breeze bed, and an ECHO
 * that returns what you play as softening memory.
 *
 * Each chime hangs under a piece from the same Midjourney session
 * (24 more images — 84 of the session's 455 now placed). Ringing a
 * chime turns its card to the alternate piece.
 *
 * The ANGELUS tolls nine deep bells (3×3×3) and offers one prayer to
 * the shared ledger at /api/prayer, station 'angelus' — eleventh
 * station, same perpetual counts as the chambers.
 *
 * Third room of the prayer wing: indigo morning, ember evening, and
 * this — the verdigris bell garden.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import RoomPresenceChip from '../components/RoomPresenceChip.astro';

const title = 'Prayer Bells · The Angelus · PointCast';
const description =
  'A meditative chime garden — twelve pentatonic brass chimes under Midjourney skies. Chime, bowl, and music-box voices, wind mode, echo memory. Toll the Angelus, leave a prayer.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Prayer Bells — The Angelus',
  url: 'https://pointcast.xyz/prayer-bells',
  description,
  applicationCategory: 'MultimediaApplication',
};

// Twelve chimes, C-major pentatonic, low → high. Each carries a
// front piece (a) and an alternate (b) that swaps in when rung.
const CHIMES = [
  { note: 'C4', key: 'A', altA: 'Gold morning static breaking over dark rocks', altB: 'Cream house resting over patchwork surf' },
  { note: 'D4', key: 'S', altA: 'Sketchbook house collaged in graphite and coral', altB: 'Stone mid-century house with a cold blue pool' },
  { note: 'E4', key: 'D', altA: 'Cyan terrace with pink stairs down to the water', altB: 'Round-cornered terrace pouring into the sea' },
  { note: 'G4', key: 'F', altA: 'Morning California pixel poster, table set by the window', altB: 'Red garden collage with polka moons over the point' },
  { note: 'A4', key: 'G', altA: 'Pink and green pattern camouflage rolling like surf', altB: 'Rainbow glitch pouring over tide rocks' },
  { note: 'C5', key: 'H', altA: 'Stilt house shattering into rainbow static', altB: 'Magenta stripe storm through the pines' },
  { note: 'D5', key: 'J', altA: 'Flat garden of shapes above a paper sea', altB: 'Pink cove drawn in flat candy panels' },
  { note: 'E5', key: 'K', altA: 'Coral stripes crashing across a blue wave', altB: 'Blue grid windows opening onto rocks' },
  { note: 'G5', key: 'L', altA: 'Pastel grid warming in the afternoon', altB: 'Pale green panels over a quiet swell' },
  { note: 'A5', key: ';', altA: 'Teal spires standing in white surf', altB: 'Framed cove with a glass room in the cliff' },
  { note: 'C6', key: "'", altA: 'Lush green cove glowing under haze', altB: 'Blue rocks flecked with gold shimmer' },
  { note: 'D6', key: '\\', altA: 'Blue rocks against a bright white sky', altB: 'Tall blue rock holding up the sky' },
];
---

<BlockLayout title={title} description={description} image="/images/og-prayer-bells.png" jsonLd={jsonLd}>
  <main class="pb" id="pb-main">
    <RoomPresenceChip surface="bells" />

    <header class="pb__header">
      <div class="pb__chrome">
        <span class="pb__chrome-label">THE ANGELUS</span>
        <span class="pb__sep">·</span>
        <span class="pb__chrome-label">PRAYERS</span>
        <span class="pb__total" id="pb-total">—</span>
      </div>
      <h1 class="pb__title">PRAYER BELLS</h1>
      <p class="pb__tagline">
        a chime garden tuned so nothing you play can be wrong · tap the bars,
        drag across them, or let the wind through · the chambers keep the hours
        at <a href="/prayer-altars">/prayer-altars</a> and
        <a href="/prayer-altars-evening">/prayer-altars-evening</a>
      </p>
    </header>

    <section class="pb__console" aria-label="Instrument controls">
      <div class="pb__group" role="group" aria-label="Voice">
        <span class="pb__group-label">VOICE</span>
        <button class="pb__btn pb__btn--on" type="button" data-voice="chime">CHIME</button>
        <button class="pb__btn" type="button" data-voice="bowl">BOWL</button>
        <button class="pb__btn" type="button" data-voice="box">BOX</button>
      </div>
      <div class="pb__group" role="group" aria-label="Modes">
        <span class="pb__group-label">GARDEN</span>
        <button class="pb__btn" type="button" id="pb-wind" aria-pressed="false">WIND</button>
        <button class="pb__btn" type="button" id="pb-echo" aria-pressed="false">ECHO</button>
      </div>
      <div class="pb__group pb__group--angelus">
        <button class="pb__angelus" type="button" id="pb-angelus">
          TOLL THE ANGELUS
          <span class="pb__angelus-sub">nine bells · one prayer</span>
        </button>
        <span class="pb__angelus-count" id="pb-angelus-count">— tolled</span>
      </div>
    </section>

    <section class="pb__garden" id="pb-garden" aria-label="Chime garden">
      {CHIMES.map((c, i) => (
        <div class="pb__column" data-idx={i}>
          <div class="pb__card" data-card>
            <img class="pb__card-img pb__card-img--on" src={`/images/prayer-bells/chime-${i + 1}a.jpg`} alt={c.altA} loading={i < 4 ? 'eager' : 'lazy'} data-side="a" />
            <img class="pb__card-img" src={`/images/prayer-bells/chime-${i + 1}b.jpg`} alt={c.altB} loading="lazy" data-side="b" />
          </div>
          <button
            class="pb__bar"
            type="button"
            data-bar
            data-idx={i}
            style={`--pb-bar-h:${164 - i * 8}px`}
            aria-label={`Ring chime ${i + 1} — ${c.note}`}
          >
            <span class="pb__bar-note">{c.note}</span>
            <span class="pb__bar-key" aria-hidden="true">{c.key}</span>
          </button>
        </div>
      ))}
    </section>

    <p class="pb__hint">
      tap · drag across the bars like a hand through a wind chime · or play the
      keyboard row <span class="pb__kbd">A</span>–<span class="pb__kbd">\</span>
    </p>

    <section class="pb__how">
      <h2>HOW THIS WORKS</h2>
      <ol class="pb__how-list">
        <li>
          Twelve chimes, C-major pentatonic across two octaves — every note
          agrees with every other. Three voices: <em>chime</em>, <em>bowl</em>,
          <em>music box</em>.
        </li>
        <li>
          <span class="pb__kbd">WIND</span> lets the garden play itself — a
          breeze bed underneath, soft rings drifting through. <span class="pb__kbd">ECHO</span>
          returns each note twice as fading memory. Together they make the
          garden self-sustaining; close your eyes.
        </li>
        <li>
          Every chime hangs under a piece of Mike's Midjourney session of July
          18 — twenty-four more images. Ringing a chime turns its card to the
          alternate piece.
        </li>
        <li>
          <span class="pb__kbd">TOLL THE ANGELUS</span> rings nine deep bells,
          three by three, and offers one prayer to the shared ledger — the
          eleventh station beside the ten hours of
          <a href="/prayer-altars">the morning</a> and
          <a href="/prayer-altars-evening">the evening</a> chambers. A candle can be left
          burning at <a href="/prayer-candles">/prayer-candles</a>. The whole
          session hangs at <a href="/gallery">/gallery</a>.
        </li>
      </ol>
      <p class="pb__blessing">peace be with you</p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  /* Verdigris bell garden — third room of the prayer wing. */
  body:has(#pb-main) {
    background: #0b1917;
  }

  .pb {
    --pb-verd: #0b1917;
    --pb-verd-deep: #050c0b;
    --pb-verd-mid: #14312b;
    --pb-patina: #6fae9b;
    --pb-brass: #d4a437;
    --pb-brass-soft: #b8862c;
    --pb-brass-deep: #6b4d12;
    --pb-flame: #f6c15e;
    --pb-ink-light: #e7ead9;
    --pb-ink-mid: #a9b49b;
    --pb-ink-dim: #6d7a64;
    --pb-rule-soft: rgba(212, 164, 55, 0.18);
    --pb-glow: rgba(111, 174, 155, 0.08);

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 32px 80px;
    color: var(--pb-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(111, 174, 155, 0.10), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(212, 164, 55, 0.06), transparent 70%),
      linear-gradient(180deg, var(--pb-verd) 0%, var(--pb-verd-deep) 100%);
  }

  .pb::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18px 26px, var(--pb-glow) 1px, transparent 1.5px),
      radial-gradient(circle at 64px 58px, var(--pb-glow) 1px, transparent 1.5px);
    background-size: 84px 84px;
    opacity: 0.6;
    z-index: -1;
  }

  /* ── Header ───────────────────────────────────────────── */
  .pb__header {
    text-align: center;
    padding: 36px 16px 24px;
    border-bottom: 1px solid var(--pb-rule-soft);
    margin-bottom: 24px;
  }
  .pb__chrome {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border: 1.5px solid var(--pb-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pb-ink-mid);
    background: rgba(0, 0, 0, 0.3);
  }
  .pb__chrome-label { color: var(--pb-ink-dim); }
  .pb__total { color: var(--pb-brass); font-weight: 700; }
  .pb__sep { color: var(--pb-brass-deep); }

  .pb__title {
    margin: 14px 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--pb-brass);
    text-shadow:
      0 0 24px rgba(212, 164, 55, 0.35),
      0 2px 0 var(--pb-verd-deep);
  }
  .pb__tagline {
    margin: 0 auto;
    max-width: 720px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--pb-ink-mid);
  }
  .pb__tagline a { color: var(--pb-brass); }

  /* ── Console ──────────────────────────────────────────── */
  .pb__console {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-bottom: 26px;
  }
  .pb__group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pb__group-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--pb-ink-dim);
  }
  .pb__btn {
    appearance: none;
    cursor: pointer;
    padding: 8px 14px;
    border: 1.5px solid var(--pb-brass-deep);
    background: rgba(0, 0, 0, 0.3);
    color: var(--pb-ink-mid);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    border-radius: 0;
    transition: background 120ms, color 120ms, border-color 120ms;
  }
  .pb__btn:hover { border-color: var(--pb-brass); color: var(--pb-ink-light); }
  .pb__btn.pb__btn--on {
    background: linear-gradient(180deg, var(--pb-brass) 0%, var(--pb-brass-soft) 100%);
    color: var(--pb-verd-deep);
    border-color: var(--pb-brass);
  }

  .pb__group--angelus { flex-direction: column; gap: 4px; }
  .pb__angelus {
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 12px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.20em;
    color: var(--pb-verd-deep);
    background: linear-gradient(180deg, var(--pb-brass) 0%, var(--pb-brass-soft) 100%);
    box-shadow:
      0 0 0 2px var(--pb-verd-deep),
      0 4px 0 0 var(--pb-brass-deep),
      0 4px 12px rgba(212, 164, 55, 0.25);
    transition: transform 80ms, box-shadow 80ms;
  }
  .pb__angelus:active, .pb__angelus.pb__angelus--tolling {
    transform: translateY(3px);
    box-shadow:
      0 0 0 2px var(--pb-verd-deep),
      0 1px 0 0 var(--pb-brass-deep),
      0 0 16px rgba(246, 193, 94, 0.6);
  }
  .pb__angelus:disabled { cursor: wait; opacity: 0.6; transform: translateY(2px); }
  .pb__angelus-sub {
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.22em;
    opacity: 0.8;
  }
  .pb__angelus-count {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.20em;
    color: var(--pb-ink-dim);
    text-transform: uppercase;
  }

  /* ── Garden ───────────────────────────────────────────── */
  .pb__garden {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 10px;
    align-items: start;
    padding: 18px 10px 8px;
    border-top: 3px solid var(--pb-brass-deep);
    box-shadow: inset 0 2px 0 rgba(212, 164, 55, 0.35);
    touch-action: none;
  }
  @media (max-width: 980px) {
    .pb__garden { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 520px) {
    .pb__garden { grid-template-columns: repeat(4, 1fr); }
  }

  .pb__column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pb__card {
    width: 100%;
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    background: var(--pb-verd-deep);
    box-shadow:
      0 0 0 1.5px var(--pb-brass-deep),
      0 3px 10px rgba(0, 0, 0, 0.5);
    transition: box-shadow 200ms;
  }
  .pb__card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 900ms ease-in-out;
  }
  .pb__card-img--on { opacity: 1; }
  .pb__column.pb__column--rung .pb__card {
    box-shadow:
      0 0 0 1.5px var(--pb-brass),
      0 0 18px rgba(246, 193, 94, 0.55),
      0 3px 10px rgba(0, 0, 0, 0.5);
  }

  .pb__bar {
    appearance: none;
    border: 0;
    cursor: pointer;
    width: min(34px, 72%);
    height: var(--pb-bar-h, 140px);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    padding-bottom: 8px;
    background:
      linear-gradient(90deg, var(--pb-brass-deep) 0%, var(--pb-brass) 22%, #f0d27a 50%, var(--pb-brass) 78%, var(--pb-brass-deep) 100%);
    border-radius: 0 0 6px 6px;
    box-shadow:
      0 0 0 1px var(--pb-verd-deep),
      inset 0 -3px 0 rgba(0, 0, 0, 0.35),
      0 4px 10px rgba(0, 0, 0, 0.5);
    transform-origin: 50% 0%;
    transition: filter 120ms;
  }
  .pb__bar::before {
    /* hanger cord */
    content: '';
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 18px;
    background: var(--pb-brass-deep);
  }
  .pb__bar:hover { filter: brightness(1.12); }
  .pb__bar.pb__bar--ringing {
    animation: pb-swing 1.1s ease-out;
    filter: brightness(1.25);
  }
  @keyframes pb-swing {
    0%   { transform: rotate(0deg); }
    18%  { transform: rotate(2.4deg); }
    45%  { transform: rotate(-1.6deg); }
    72%  { transform: rotate(0.8deg); }
    100% { transform: rotate(0deg); }
  }
  .pb__bar-note {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--pb-verd-deep);
    writing-mode: vertical-rl;
  }
  .pb__bar-key {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 8px;
    color: rgba(5, 12, 11, 0.55);
  }

  .pb__hint {
    margin: 18px auto 0;
    text-align: center;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--pb-ink-dim);
  }

  /* ── How ──────────────────────────────────────────────── */
  .pb__how {
    margin-top: 48px;
    padding: 24px 16px;
    max-width: 820px;
    margin-inline: auto;
    border-top: 1px solid var(--pb-rule-soft);
  }
  .pb__how h2 {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 24px;
    color: var(--pb-brass);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }
  .pb__how-list { list-style: decimal; padding-left: 22px; margin: 0; }
  .pb__how-list li {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--pb-ink-mid);
    margin-bottom: 10px;
  }
  .pb__how-list em { color: var(--pb-flame); font-style: italic; font-weight: 500; }
  .pb__how-list a { color: var(--pb-brass); }
  .pb__kbd {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    color: var(--pb-verd-deep);
    background: var(--pb-brass);
    border-radius: 2px;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .pb__blessing {
    margin-top: 28px;
    text-align: center;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--pb-ink-dim);
    letter-spacing: 0.08em;
  }
</style>

<script>
  // ── Identity ─────────────────────────────────────────────
  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) {
        sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(SID_KEY, sid);
      }
      return sid;
    } catch {
      return 'sid-anon-' + Date.now();
    }
  }
  const SID = ensureSid();

  // ── Engine ───────────────────────────────────────────────
  // C-major pentatonic, C4 → D6.
  const FREQS = [261.63, 293.66, 329.63, 392.0, 440.0, 523.25, 587.33, 659.25, 783.99, 880.0, 1046.5, 1174.66];
  const KEYS = ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', "'", '\\'];

  let actx: AudioContext | null = null;
  let master: GainNode | null = null;

  function ctx(): AudioContext {
    if (!actx) {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
      // master → dry + feedback-delay air (cheap meditative space)
      master = actx.createGain();
      master.gain.value = 0.9;
      master.connect(actx.destination);
      const delay = actx.createDelay(1.0);
      delay.delayTime.value = 0.28;
      const fb = actx.createGain(); fb.gain.value = 0.25;
      const damp = actx.createBiquadFilter(); damp.type = 'lowpass'; damp.frequency.value = 2400;
      const wet = actx.createGain(); wet.gain.value = 0.18;
      master.connect(delay); delay.connect(damp); damp.connect(fb); fb.connect(delay);
      damp.connect(wet); wet.connect(actx.destination);
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function out(): GainNode { ctx(); return master as GainNode; }

  function noiseBuffer(a: AudioContext, seconds: number): AudioBuffer {
    const buf = a.createBuffer(1, a.sampleRate * seconds, a.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    return buf;
  }

  // ── Voices ───────────────────────────────────────────────
  function voiceChime(f: number, vel: number) {
    const a = ctx(); const t = a.currentTime;
    const dur = 2.8 * Math.sqrt(261.63 / f); // highs ring shorter
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.756;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.30 * vel, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.07 * vel, t + 0.008); g2.gain.exponentialRampToValueAtTime(0.0001, t + dur * 0.55);
    o.connect(g).connect(out()); o2.connect(g2).connect(out());
    o.start(t); o.stop(t + dur + 0.1); o2.start(t); o2.stop(t + dur * 0.55 + 0.1);
  }
  function voiceBowl(f: number, vel: number) {
    const a = ctx(); const t = a.currentTime;
    const base = f / 2; // bowls sing an octave down — warmth
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = base;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = base * 1.5946;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.26 * vel, t + 0.06);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 4.0);
    o1.connect(g); o2.connect(g); g.connect(out());
    o1.start(t); o2.start(t); o1.stop(t + 4.1); o2.stop(t + 4.1);
  }
  function voiceBox(f: number, vel: number) {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'triangle'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 4;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.24 * vel, t + 0.002); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.04 * vel, t + 0.002); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
    o.connect(g).connect(out()); o2.connect(g2).connect(out());
    o.start(t); o.stop(t + 1.0); o2.start(t); o2.stop(t + 0.4);
  }
  // The deep bell for the Angelus toll
  function voiceToll(vel: number, when: number) {
    const a = ctx(); const t = a.currentTime + when;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 98.0; // G2
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 98.0 * 2.4;
    const o3 = a.createOscillator(); o3.type = 'sine'; o3.frequency.value = 98.0 * 5.4;
    const g = a.createGain(); const g2 = a.createGain(); const g3 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.5 * vel, t + 0.015); g.gain.exponentialRampToValueAtTime(0.0001, t + 3.6);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.12 * vel, t + 0.02); g2.gain.exponentialRampToValueAtTime(0.0001, t + 2.0);
    g3.gain.setValueAtTime(0.0001, t); g3.gain.exponentialRampToValueAtTime(0.05 * vel, t + 0.01); g3.gain.exponentialRampToValueAtTime(0.0001, t + 0.8);
    o.connect(g).connect(out()); o2.connect(g2).connect(out()); o3.connect(g3).connect(out());
    o.start(t); o2.start(t); o3.start(t);
    o.stop(t + 3.7); o2.stop(t + 2.1); o3.stop(t + 0.9);
  }

  const VOICES: Record<string, (f: number, vel: number) => void> = {
    chime: voiceChime,
    bowl: voiceBowl,
    box: voiceBox,
  };
  let currentVoice = 'chime';

  // ── Ring ─────────────────────────────────────────────────
  const columns = Array.from(document.querySelectorAll('.pb__column'));
  let echoOn = false;

  function flashColumn(idx: number) {
    const col = columns[idx];
    if (!col) return;
    col.classList.add('pb__column--rung');
    const bar = col.querySelector('[data-bar]');
    bar?.classList.add('pb__bar--ringing');
    setTimeout(() => {
      col.classList.remove('pb__column--rung');
      bar?.classList.remove('pb__bar--ringing');
    }, 900);
    // swap card image
    const imgs = col.querySelectorAll('.pb__card-img');
    if (imgs.length === 2) {
      imgs[0].classList.toggle('pb__card-img--on');
      imgs[1].classList.toggle('pb__card-img--on');
    }
  }

  function ring(idx: number, vel = 0.85, isEcho = false) {
    const f = FREQS[idx];
    if (!f) return;
    try { VOICES[currentVoice]?.(f, vel); } catch {}
    flashColumn(idx);
    if (echoOn && !isEcho) {
      setTimeout(() => ring(idx, vel * 0.35, true), 4800);
      setTimeout(() => ring(idx, vel * 0.12, true), 9600);
    }
  }

  // ── Pointer: tap + drag like a hand through the chime ────
  const garden = document.getElementById('pb-garden');
  let dragging = false;
  let lastIdx = -1;

  function idxFromPoint(x: number, y: number): number {
    const el = document.elementFromPoint(x, y);
    const bar = el?.closest?.('[data-bar]');
    if (!bar) return -1;
    return parseInt((bar as HTMLElement).dataset.idx ?? '-1', 10);
  }

  garden?.addEventListener('pointerdown', (e) => {
    dragging = true;
    lastIdx = -1;
    const idx = idxFromPoint(e.clientX, e.clientY);
    if (idx >= 0) { ring(idx); lastIdx = idx; }
  });
  garden?.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const idx = idxFromPoint(e.clientX, e.clientY);
    if (idx >= 0 && idx !== lastIdx) { ring(idx, 0.7); lastIdx = idx; }
  });
  const endDrag = () => { dragging = false; lastIdx = -1; };
  window.addEventListener('pointerup', endDrag);
  window.addEventListener('pointercancel', endDrag);

  // ── Keyboard ─────────────────────────────────────────────
  window.addEventListener('keydown', (e) => {
    if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
    const idx = KEYS.indexOf(e.key.toLowerCase());
    if (idx >= 0) ring(idx);
  });

  // ── Voice buttons ────────────────────────────────────────
  document.querySelectorAll('[data-voice]').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentVoice = (btn as HTMLElement).dataset.voice ?? 'chime';
      document.querySelectorAll('[data-voice]').forEach((b) => b.classList.toggle('pb__btn--on', b === btn));
      // audition the middle chime so the change is heard
      ring(5, 0.6);
    });
  });

  // ── Wind ─────────────────────────────────────────────────
  let windOn = false;
  let windTimer: ReturnType<typeof setTimeout> | null = null;
  let breeze: { src: AudioBufferSourceNode; gain: GainNode; lfo: OscillatorNode; flfo: OscillatorNode } | null = null;

  function startBreeze() {
    const a = ctx();
    const src = a.createBufferSource();
    src.buffer = noiseBuffer(a, 4);
    src.loop = true;
    const filt = a.createBiquadFilter(); filt.type = 'bandpass'; filt.frequency.value = 500; filt.Q.value = 0.6;
    const gain = a.createGain(); gain.gain.value = 0.03;
    const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.07;
    const lfoGain = a.createGain(); lfoGain.gain.value = 0.018;
    lfo.connect(lfoGain).connect(gain.gain);
    const flfo = a.createOscillator(); flfo.type = 'sine'; flfo.frequency.value = 0.05;
    const flfoGain = a.createGain(); flfoGain.gain.value = 180;
    flfo.connect(flfoGain).connect(filt.frequency);
    src.connect(filt).connect(gain).connect(a.destination);
    src.start(); lfo.start(); flfo.start();
    breeze = { src, gain, lfo, flfo };
  }
  function stopBreeze() {
    if (!breeze) return;
    try { breeze.src.stop(); breeze.lfo.stop(); breeze.flfo.stop(); } catch {}
    breeze = null;
  }
  function windGust() {
    if (!windOn) return;
    // center-weighted random chime, soft velocity; sometimes a cluster
    const pick = () => Math.max(0, Math.min(11, Math.round(5.5 + (Math.random() + Math.random() + Math.random() - 1.5) * 3.6)));
    ring(pick(), 0.25 + Math.random() * 0.35);
    if (Math.random() < 0.12) {
      setTimeout(() => windOn && ring(pick(), 0.2 + Math.random() * 0.25), 240);
      setTimeout(() => windOn && ring(pick(), 0.15 + Math.random() * 0.2), 520);
    }
    windTimer = setTimeout(windGust, 1200 + Math.random() * 3000);
  }
  const windBtn = document.getElementById('pb-wind');
  windBtn?.addEventListener('click', () => {
    windOn = !windOn;
    windBtn.classList.toggle('pb__btn--on', windOn);
    windBtn.setAttribute('aria-pressed', String(windOn));
    if (windOn) { startBreeze(); windGust(); }
    else { stopBreeze(); if (windTimer) clearTimeout(windTimer); }
  });

  // ── Echo ─────────────────────────────────────────────────
  const echoBtn = document.getElementById('pb-echo');
  echoBtn?.addEventListener('click', () => {
    echoOn = !echoOn;
    echoBtn.classList.toggle('pb__btn--on', echoOn);
    echoBtn.setAttribute('aria-pressed', String(echoOn));
  });

  // Politeness — the wind rests when the tab is hidden.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && windOn) {
      windOn = false;
      windBtn?.classList.remove('pb__btn--on');
      windBtn?.setAttribute('aria-pressed', 'false');
      stopBreeze();
      if (windTimer) clearTimeout(windTimer);
    }
    if (!document.hidden) fetchState();
  });

  // ── The Angelus ──────────────────────────────────────────
  const angelusBtn = document.getElementById('pb-angelus') as HTMLButtonElement | null;
  const angelusCount = document.getElementById('pb-angelus-count');

  async function postPrayer(station: string) {
    try {
      const r = await fetch('/api/prayer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: SID, station }),
      });
      return await r.json();
    } catch {
      return { ok: false, reason: 'network' };
    }
  }

  angelusBtn?.addEventListener('click', async () => {
    if (!angelusBtn) return;
    angelusBtn.disabled = true;
    angelusBtn.classList.add('pb__angelus--tolling');
    // Nine bells, three by three
    [0, 0.9, 1.8, 3.4, 4.3, 5.2, 6.8, 7.7, 8.6].forEach((w, i) => voiceToll(i % 3 === 0 ? 1 : 0.85, w));
    const j = await postPrayer('angelus');
    if (j?.ok) {
      if (angelusCount) angelusCount.textContent = `${j.count} tolled`;
      const totEl = document.getElementById('pb-total');
      if (totEl) totEl.textContent = String(j.total);
    }
    // Let the toll finish before the next one can begin
    setTimeout(() => {
      angelusBtn.disabled = false;
      angelusBtn.classList.remove('pb__angelus--tolling');
    }, 10500);
  });

  // ── Ledger chip ──────────────────────────────────────────
  function fmtCount(n: number) { return n > 9999 ? (n / 1000).toFixed(1) + 'k' : String(n); }
  async function fetchState() {
    try {
      const r = await fetch('/api/prayer', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) {
        const totEl = document.getElementById('pb-total');
        if (totEl) totEl.textContent = fmtCount(j.total ?? 0);
        if (angelusCount) angelusCount.textContent = `${j.counts?.angelus ?? 0} tolled`;
      }
    } catch { /* offline */ }
  }
  fetchState();
  setInterval(fetchState, 15000);
</script>
