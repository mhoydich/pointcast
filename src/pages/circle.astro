---
/**
 * /circle — your check-in system for family and friends.
 *
 * The 5-25 people you keep close. When they visit PointCast, you know.
 * When you visit, they know. Presence becomes social.
 *
 * Layout (mobile-first, generous whitespace):
 *   1. HEADER       — visitor's noun, kicker, tagline
 *   2. CHECK IN     — big tap target, mood + optional 140-char note
 *   3. STREAK       — reuse StreakBadge full variant
 *   4. CIRCLE FEED  — list of people, recency-sorted, warm dot for new visits
 *   5. INVITE       — generated 8-char code + share link + copy button
 *
 * All data is localStorage only. Storage keys:
 *   pc:circle:v1            — { checkins: [...], invite: { code, createdAt }, lastSeenCircleAt }
 *   pc:visitor-noun-id      — read for the visitor avatar (synced from /me, /dispatch-drum)
 *   pc:currentNoun          — fallback noun key when pc:visitor-noun-id is unset
 *   pc_streak               — StreakBadge owns this
 *
 * Mock circle members are static for v1 — they simulate what an active
 * circle looks like before any real cross-device sync exists.
 *
 * ─── DURABLE OBJECT SYNC (future, not implemented) ───────────────────────
 * Real multi-device + multi-person presence belongs in a Cloudflare
 * Durable Object similar to workers/presence/. Sketch:
 *
 *   - DO class: CircleRoom keyed by circle id (the invite code becomes the
 *     room id once accepted; first creator owns it).
 *   - Members: { nounId, name, joinedAt, lastSeenAt, lastCheckin }.
 *   - Endpoints:
 *       POST /api/circle/{code}/join       { nounId, name }
 *       POST /api/circle/{code}/checkin    { mood, note }
 *       GET  /api/circle/{code}            → members + recent check-ins
 *       WS   /api/circle/{code}/live       → real-time presence pings
 *   - Auth: no accounts. The invite code IS the credential. Code rotation
 *     and revocation handled by the circle owner via /circle/settings.
 *   - Storage: DO state for hot data, KV (PC_CIRCLE_KV) for 30-day check-in
 *     archive. IPs hashed daily like /api/checkin.
 *
 * For now the page is fully local — the mock feed + the local-only check-in
 * give a complete UX preview of the social layer.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import StreakBadge from '../components/StreakBadge.astro';
import '../styles/global.css';

// ─── Moods (same six the homepage + /me use) ─────────────────────────────
const MOODS = [
  { id: 'chill',   label: 'CHILL',   blurb: 'taking it slow' },
  { id: 'hype',    label: 'HYPE',    blurb: 'amped, momentum-on' },
  { id: 'focus',   label: 'FOCUS',   blurb: 'heads-down work' },
  { id: 'flow',    label: 'FLOW',    blurb: 'in the zone' },
  { id: 'curious', label: 'CURIOUS', blurb: 'exploring, learning' },
  { id: 'quiet',   label: 'QUIET',   blurb: 'observing, recharging' },
];

// Mock circle for v1. Once Durable Object sync lands, the live feed
// replaces this static list. Names + nouns + moods kept warm and varied
// so the empty-circle case feels lived-in.
const MOCK_CIRCLE = [
  { id: 'morgan', name: 'Morgan', noun: 421, ageHours: 2,             mood: 'hype',    note: 'post-match vibes' },
  { id: 'daniel', name: 'Daniel', noun: 88,  ageHours: 24,            mood: 'chill',   note: '' },
  { id: 'mom',    name: 'Mom',    noun: 7,   ageHours: 24 * 3,        mood: 'quiet',   note: 'garden morning' },
  { id: 'jason',  name: 'Jason',  noun: 156, ageHours: 24 * 5,        mood: 'focus',   note: 'warehouse day' },
  { id: 'claire', name: 'Claire', noun: 752, ageHours: 24 * 7,        mood: 'flow',    note: '' },
];

const NOUN_MAX = 1199;
const CIRCLE_MAX = 25;

const title = 'Your Circle';
const description = 'PointCast Circle — the 5-25 people you keep close. Check in, see who else has been here, invite the next one. Local-first, no accounts.';
---

<BlockLayout title={title} description={description}>
  <main class="circle">

    {/* ──────────── HEADER ──────────── */}
    <header class="circle__hero">
      <p class="circle__crumb">
        <a href="/">home</a> <span aria-hidden="true">›</span>
        <a href="/me">me</a> <span aria-hidden="true">›</span>
        <span>circle</span>
      </p>
      <div class="circle__hero-row">
        <img id="circle-you-noun" class="circle__you-noun" src="" alt="" width="64" height="64" />
        <div class="circle__hero-text">
          <p class="circle__kicker">YOUR CIRCLE</p>
          <h1 class="circle__title">The people you keep close.</h1>
          <p class="circle__dek">
            Five to twenty-five. When they visit PointCast, you know. When you
            visit, they know. A quiet group chat made of presence, not posts.
          </p>
        </div>
      </div>
    </header>

    {/* ──────────── 1. CHECK IN ──────────── */}
    <section class="circle__band checkin" aria-label="Check in">
      <header class="band__head">
        <p class="circle__eyebrow mono">CHECK IN</p>
        <span class="checkin__last mono" id="checkin-last">never</span>
      </header>

      <p class="checkin__field-label mono">MOOD</p>
      <div class="checkin__moods" role="radiogroup" aria-label="Mood">
        {MOODS.map(m => (
          <button type="button" class="checkin__mood" data-mood={m.id} title={m.blurb}>
            <strong>{m.label}</strong>
            <span>{m.blurb}</span>
          </button>
        ))}
      </div>

      <p class="checkin__field-label mono" style="margin-top:18px;">NOTE (OPTIONAL)</p>
      <input
        type="text"
        id="checkin-note"
        class="checkin__note"
        placeholder="at the courts · morning coffee · in transit"
        maxlength="140"
        aria-label="Optional note"
      />
      <p class="checkin__counter mono"><span id="checkin-note-count">0</span>/140</p>

      <button type="button" id="checkin-btn" class="checkin__cta">
        <span class="checkin__cta-glyph" aria-hidden="true">✓</span>
        <span class="checkin__cta-label" id="checkin-cta-label">CHECK IN</span>
      </button>
      <p class="checkin__notice mono" id="checkin-notice" hidden role="status" aria-live="polite"></p>
    </section>

    {/* ──────────── 2. STREAK ──────────── */}
    <section class="circle__band streak-band" aria-label="Streak">
      <p class="circle__eyebrow mono">YOUR STREAK</p>
      <StreakBadge variant="full" />
      <p class="streak__hint">Checking in keeps your streak alive.</p>
    </section>

    {/* ──────────── 3. CIRCLE FEED ──────────── */}
    <section class="circle__band feed" aria-label="Your circle">
      <header class="band__head">
        <p class="circle__eyebrow mono">YOUR CIRCLE</p>
        <span class="feed__count mono" id="feed-count">{MOCK_CIRCLE.length} people</span>
      </header>
      <ol class="feed__list" id="feed-list">
        {/* Server-rendered fallback — replaced on hydrate so warm dots
            and "X ago" times reflect the visitor's actual last-seen. */}
        {MOCK_CIRCLE.map(p => (
          <li class="feed__row" data-member-id={p.id} data-age-hours={p.ageHours}>
            <img class="feed__noun" src={`https://noun.pics/${p.noun}.svg`} alt={`Noun #${p.noun}`} width="48" height="48" loading="lazy" />
            <div class="feed__main">
              <div class="feed__line1">
                <strong class="feed__name">{p.name}</strong>
                <span class="feed__noun-id mono">·  Noun #{p.noun}</span>
                <span class="feed__rel mono" data-rel-for={p.id}>—</span>
              </div>
              <div class="feed__line2">
                <span class={`feed__mood-dot feed__mood-dot--${p.mood}`} aria-hidden="true"></span>
                <span class="feed__mood mono">{p.mood}</span>
                {p.note && <span class="feed__note">"{p.note}"</span>}
              </div>
            </div>
            <span class="feed__warm" data-warm-for={p.id} hidden aria-label="New since your last check-in">●</span>
          </li>
        ))}
      </ol>
    </section>

    {/* ──────────── 4. INVITE ──────────── */}
    <section class="circle__band invite" aria-label="Invite someone">
      <header class="band__head">
        <p class="circle__eyebrow mono">INVITE SOMEONE</p>
        <span class="invite__capacity mono" id="invite-capacity">
          Your circle: {MOCK_CIRCLE.length} people · room for {CIRCLE_MAX - MOCK_CIRCLE.length} more
        </span>
      </header>
      <p class="invite__dek">Share this link with someone you want in your circle.</p>
      <div class="invite__link-row">
        <code class="invite__link" id="invite-link">pointcast.xyz/circle/join/—</code>
        <button type="button" class="invite__copy mono" id="invite-copy">COPY</button>
      </div>
      <p class="invite__hint mono">
        Codes are stored in this browser only. Anyone with the link can join
        your circle until you rotate the code below.
      </p>
      <button type="button" class="invite__rotate mono" id="invite-rotate">↻ rotate code</button>
    </section>

    {/* ──────────── FOOT ──────────── */}
    <footer class="circle__foot">
      <p class="mono">
        Stored in this browser only · localStorage key <code>pc:circle:v1</code> ·
        <button type="button" class="circle__reset" id="circle-reset">reset everything</button>
      </p>
      <p class="mono circle__foot-meta">
        Sibling of <a href="/me">/me</a> (your identity) and <a href="/profile">/profile</a> (wallets).
      </p>
    </footer>

  </main>
</BlockLayout>

<script is:inline define:vars={{ MOODS, MOCK_CIRCLE, NOUN_MAX, CIRCLE_MAX }}>
(() => {
  const KEY = 'pc:circle:v1';
  const SCHEMA_VERSION = 1;
  const FONT_NOUN = 'https://noun.pics';

  // ─── State ───────────────────────────────────────────────────────────────
  function makeCode() {
    // 8 chars, A-Z + 2-9 (skip 0/1/I/O for human readability).
    const ALPH = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let out = '';
    for (let i = 0; i < 8; i++) out += ALPH[Math.floor(Math.random() * ALPH.length)];
    return out;
  }

  function defaults() {
    return {
      $v: SCHEMA_VERSION,
      checkins: [], // [{ at: iso, mood, note }]
      invite: { code: makeCode(), createdAt: new Date().toISOString() },
      lastSeenCircleAt: null, // when you last opened /circle — drives warm dots
    };
  }

  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object' || parsed.$v !== SCHEMA_VERSION) return defaults();
      const merged = Object.assign(defaults(), parsed, { $v: SCHEMA_VERSION });
      // Preserve the existing invite if it's there — only generate when missing.
      if (!merged.invite || !merged.invite.code) {
        merged.invite = { code: makeCode(), createdAt: new Date().toISOString() };
      }
      return merged;
    } catch (e) {
      return defaults();
    }
  }

  function save(s) {
    try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {}
  }

  let state = load();
  let pendingMood = state.checkins[0]?.mood || null;

  // ─── Helpers ────────────────────────────────────────────────────────────
  function fmtRelative(iso) {
    if (!iso) return 'never';
    const now = Date.now();
    const t = new Date(iso).getTime();
    if (Number.isNaN(t)) return '—';
    const diff = now - t;
    const mins = Math.round(diff / 60000);
    if (mins < 1)   return 'just now';
    if (mins < 60)  return mins + 'm ago';
    const hrs = Math.round(mins / 60);
    if (hrs < 24)   return hrs + 'h ago';
    const days = Math.round(hrs / 24);
    if (days === 1) return 'yesterday';
    if (days < 7)   return days + ' days ago';
    if (days < 14)  return '1 week ago';
    if (days < 30)  return Math.floor(days / 7) + ' weeks ago';
    return new Date(iso).toISOString().slice(0, 10);
  }

  function fmtRelativeFromHours(hours) {
    const ms = hours * 60 * 60 * 1000;
    return fmtRelative(new Date(Date.now() - ms).toISOString());
  }

  function findMood(id) { return MOODS.find(m => m.id === id); }

  function loadVisitorNoun() {
    let n = null;
    try {
      const raw = localStorage.getItem('pc:visitor-noun-id');
      if (raw) {
        const parsed = parseInt(raw, 10);
        if (Number.isFinite(parsed) && parsed >= 0 && parsed <= NOUN_MAX) n = parsed;
      }
    } catch (e) {}
    if (n === null) {
      try {
        const raw = localStorage.getItem('pc:currentNoun');
        if (raw) {
          const parsed = parseInt(raw, 10);
          if (Number.isFinite(parsed) && parsed >= 0 && parsed <= NOUN_MAX) n = parsed;
        }
      } catch (e) {}
    }
    if (n === null) n = Math.floor(Math.random() * (NOUN_MAX + 1));
    return n;
  }

  // ─── Render ─────────────────────────────────────────────────────────────
  function renderYouNoun() {
    const img = document.getElementById('circle-you-noun');
    if (!img) return;
    const seed = loadVisitorNoun();
    img.src = FONT_NOUN + '/' + seed + '.svg';
    img.alt = 'Your noun (#' + seed + ')';
  }

  function renderCheckinState() {
    // Active mood pill
    document.querySelectorAll('[data-mood]').forEach(b => {
      b.classList.toggle('is-active', b.getAttribute('data-mood') === pendingMood);
    });

    const last = state.checkins[0] || null;
    const lastEl = document.getElementById('checkin-last');
    if (lastEl) {
      if (!last) {
        lastEl.textContent = 'never';
      } else {
        const m = findMood(last.mood);
        lastEl.textContent = 'last · ' + (m ? m.label.toLowerCase() : last.mood) + ' · ' + fmtRelative(last.at);
      }
    }

    const cta = document.getElementById('checkin-cta-label');
    if (cta) {
      const today = new Date().toISOString().slice(0, 10);
      const lastDay = last ? new Date(last.at).toISOString().slice(0, 10) : null;
      cta.textContent = lastDay === today ? 'CHECK IN AGAIN' : 'CHECK IN';
    }

    // Note input — restore last note as placeholder hint, but do not overwrite
    // a value the user is currently typing.
    const noteInput = document.getElementById('checkin-note');
    if (noteInput && document.activeElement !== noteInput && noteInput.value === '') {
      // leave empty; the placeholder is enough cue.
    }
    const counter = document.getElementById('checkin-note-count');
    if (counter && noteInput) counter.textContent = String((noteInput.value || '').length);
  }

  function renderFeed() {
    const list = document.getElementById('feed-list');
    if (!list) return;

    // Sort mock by recency (ageHours ascending). When real DO sync lands,
    // sort the merged real+mock list by lastCheckin desc. Mock copy is
    // intentionally re-derived each render so the relative times don't
    // drift between SSR and CSR.
    const sorted = [...MOCK_CIRCLE].sort((a, b) => a.ageHours - b.ageHours);

    // Warm-dot logic: any member whose check-in is newer than the
    // visitor's lastSeenCircleAt gets the warm pulse.
    const lastSeen = state.lastSeenCircleAt ? new Date(state.lastSeenCircleAt).getTime() : 0;

    list.innerHTML = '';
    for (const p of sorted) {
      const memberCheckinAt = Date.now() - p.ageHours * 60 * 60 * 1000;
      const isNew = memberCheckinAt > lastSeen;

      const li = document.createElement('li');
      li.className = 'feed__row';
      li.dataset.memberId = p.id;

      const noteHtml = p.note
        ? '<span class="feed__note">&ldquo;' + escapeHtml(p.note) + '&rdquo;</span>'
        : '';

      li.innerHTML =
        '<img class="feed__noun" src="' + FONT_NOUN + '/' + p.noun + '.svg" alt="Noun #' + p.noun + '" width="48" height="48" loading="lazy" />' +
        '<div class="feed__main">' +
          '<div class="feed__line1">' +
            '<strong class="feed__name">' + escapeHtml(p.name) + '</strong>' +
            '<span class="feed__noun-id mono">·  Noun #' + p.noun + '</span>' +
            '<span class="feed__rel mono">' + fmtRelativeFromHours(p.ageHours) + '</span>' +
          '</div>' +
          '<div class="feed__line2">' +
            '<span class="feed__mood-dot feed__mood-dot--' + p.mood + '" aria-hidden="true"></span>' +
            '<span class="feed__mood mono">' + p.mood + '</span>' +
            noteHtml +
          '</div>' +
        '</div>' +
        (isNew ? '<span class="feed__warm" aria-label="New since your last check-in">●</span>' : '');

      list.appendChild(li);
    }

    const countEl = document.getElementById('feed-count');
    if (countEl) countEl.textContent = sorted.length + ' people';
  }

  function renderInvite() {
    const code = state.invite?.code || '—';
    const linkEl = document.getElementById('invite-link');
    if (linkEl) linkEl.textContent = 'pointcast.xyz/circle/join/' + code;
    const cap = document.getElementById('invite-capacity');
    if (cap) {
      const n = MOCK_CIRCLE.length;
      cap.textContent = 'Your circle: ' + n + ' people · room for ' + (CIRCLE_MAX - n) + ' more';
    }
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  function renderAll() {
    renderYouNoun();
    renderCheckinState();
    renderFeed();
    renderInvite();
  }

  // ─── Events ─────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-mood]').forEach(btn => {
    btn.addEventListener('click', () => {
      pendingMood = btn.getAttribute('data-mood');
      renderCheckinState();
    });
  });

  const noteInput = document.getElementById('checkin-note');
  noteInput?.addEventListener('input', () => {
    const counter = document.getElementById('checkin-note-count');
    if (counter) counter.textContent = String(noteInput.value.length);
  });

  document.getElementById('checkin-btn')?.addEventListener('click', () => {
    if (!pendingMood) {
      const notice = document.getElementById('checkin-notice');
      if (notice) {
        notice.textContent = 'pick a mood first';
        notice.hidden = false;
        setTimeout(() => { notice.hidden = true; }, 2200);
      }
      return;
    }
    const note = (noteInput?.value || '').trim().slice(0, 140);
    state.checkins = [
      { at: new Date().toISOString(), mood: pendingMood, note },
      ...state.checkins,
    ].slice(0, 60);
    save(state);

    // Mirror to /me's mood signal so the rest of the site reflects the new mood.
    try {
      localStorage.setItem('pc:mood', pendingMood);
      window.dispatchEvent(new CustomEvent('pc:mood-changed', { detail: { moodId: pendingMood } }));
    } catch (e) {}

    if (noteInput) noteInput.value = '';
    renderCheckinState();

    const notice = document.getElementById('checkin-notice');
    if (notice) {
      const m = findMood(pendingMood);
      notice.textContent = 'Checked in · ' + (m ? m.label.toLowerCase() : pendingMood) + ' · just now' + (note ? ' · ' + note : '');
      notice.hidden = false;
      setTimeout(() => { notice.hidden = true; }, 3600);
    }
  });

  document.getElementById('invite-copy')?.addEventListener('click', async () => {
    const url = 'https://pointcast.xyz/circle/join/' + (state.invite?.code || '');
    let ok = false;
    try {
      await navigator.clipboard.writeText(url);
      ok = true;
    } catch (e) {
      // Fallback: select the link text for manual copy.
      const linkEl = document.getElementById('invite-link');
      if (linkEl) {
        const range = document.createRange();
        range.selectNodeContents(linkEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
    const btn = document.getElementById('invite-copy');
    if (btn) {
      const orig = btn.textContent;
      btn.textContent = ok ? 'COPIED ✓' : 'SELECT THEN ⌘C';
      setTimeout(() => { if (btn) btn.textContent = orig || 'COPY'; }, 1800);
    }
  });

  document.getElementById('invite-rotate')?.addEventListener('click', () => {
    if (!confirm('Rotate your invite code? The old link stops working immediately.')) return;
    state.invite = { code: makeCode(), createdAt: new Date().toISOString() };
    save(state);
    renderInvite();
  });

  document.getElementById('circle-reset')?.addEventListener('click', () => {
    if (!confirm('Reset your /circle state? Clears check-ins and rotates the invite code. Streak + noun are not touched.')) return;
    try { localStorage.removeItem(KEY); } catch (e) {}
    state = load();
    pendingMood = null;
    save(state);
    renderAll();
  });

  // Mark "now" as the visitor's last open-time AFTER initial render so the
  // warm dots show on this paint, then disappear next visit.
  function markSeen() {
    state.lastSeenCircleAt = new Date().toISOString();
    save(state);
  }

  // ─── First paint ────────────────────────────────────────────────────────
  renderAll();
  // Defer the lastSeen update so the warm dots render this session.
  setTimeout(markSeen, 50);

  // Keep noun avatar synced with the rest of the site.
  window.addEventListener('storage', (e) => {
    if (e.key === 'pc:visitor-noun-id' || e.key === 'pc:currentNoun') {
      renderYouNoun();
    }
  });
  window.addEventListener('pc:noun-change', renderYouNoun);
})();
</script>

<style>
  .circle {
    max-width: 760px; margin: 0 auto; padding: 24px 20px 80px;
    font-family: var(--font-body);
  }
  .mono { font-family: var(--font-mono); }

  /* ── HERO ── */
  .circle__hero {
    margin: 0 0 32px; padding: 24px 0;
    border-bottom: 1.5px solid var(--color-rule);
  }
  .circle__crumb {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    color: var(--color-ink-soft); text-transform: uppercase; margin: 0 0 18px;
  }
  .circle__crumb a { color: var(--color-ink-soft); text-decoration: none; }
  .circle__crumb a:hover { color: var(--color-ink); }
  .circle__crumb span { margin: 0 6px; }
  .circle__hero-row {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .circle__you-noun {
    width: 64px; height: 64px; flex: 0 0 auto;
    background: #1a1004; border-radius: 4px; image-rendering: pixelated;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
  }
  .circle__hero-text { min-width: 0; flex: 1 1 320px; }
  .circle__kicker {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase; margin: 0 0 8px;
  }
  .circle__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4.4vw, 44px); line-height: 1.05;
    font-weight: 600; letter-spacing: -0.02em; margin: 0 0 10px;
    color: var(--color-ink);
  }
  .circle__dek {
    font-family: var(--font-serif);
    font-size: clamp(14px, 1.2vw, 17px); line-height: 1.55;
    color: var(--color-ink-soft); margin: 0; max-width: 560px;
  }

  /* ── BANDS ── */
  .circle__band {
    margin: 0 0 28px; padding: 22px;
    background: var(--color-card); border: 1.5px solid var(--color-rule);
    border-radius: 4px;
  }
  .band__head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 8px; margin: 0 0 14px;
  }
  .circle__eyebrow {
    font-size: 11px; letter-spacing: 0.18em; color: var(--color-warm);
    text-transform: uppercase; margin: 0 0 8px;
  }

