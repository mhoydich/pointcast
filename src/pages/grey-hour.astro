---
/**
 * /grey-hour — the PointCast shelf for The Grey Hour satellite.
 *
 * constellation.json gives this satellite a shelf at /grey-hour (siblings:
 * /bell-and-signal, /moodygold, /offbalance). The original shelf was lost in
 * the main-lineage rewrite; this is a fresh one-screen page sourced from the
 * register entry, so name, description, channel and URL stay in one place.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import register from '../data/constellation.json';

const sat = register.satellites.find((s) => s.slug === 'grey-hour')!;
const title = sat.name;
const description = `${sat.description} A PointCast satellite on its own host; this is its shelf.`;
const pageUrl = 'https://pointcast.xyz/grey-hour';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  name: title,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  sameAs: sat.url,
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="shelf">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/constellation">constellation</a><span>/</span><span>grey hour</span>
    </nav>

    <p class="code">CH.{sat.channel} · SATELLITE · SHELF</p>
    <h1>{sat.name}</h1>
    <p class="dek">{sat.description}</p>
    <p class="note">
      It runs on its own Cloudflare Pages host, not inside PointCast. This shelf is the door from
      the town; the room itself is over there.
    </p>

    <p class="actions"><a class="primary" href={sat.url}>Open direct ↗</a></p>

    <p class="kin">
      Kin: <a href="/still-hour">still hour</a> · <a href="/sit">sit</a> · <a href="/constellation">the constellation</a>
    </p>
  </main>
</BlockLayout>

<style>
  .shelf { max-width: 720px; margin: 0 auto; padding: 24px 16px 80px; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 18px; border-bottom: 1px solid var(--pc-rule, #e6e6e6); font: 10px var(--pc-font-mono, ui-monospace, monospace); letter-spacing: .11em; text-transform: uppercase; }
  .code { margin: 40px 0 10px; font: 11px var(--pc-font-mono, ui-monospace, monospace); letter-spacing: .18em; text-transform: uppercase; color: var(--pc-ink-soft, #5F5E5A); }
  h1 { margin: 0 0 14px; font-family: var(--pc-font-sans, system-ui, sans-serif); font-size: clamp(30px, 6vw, 44px); font-weight: 500; line-height: 1.05; }
  .dek { font-size: 17px; line-height: 1.55; margin: 0 0 12px; }
  .note { font-size: 14px; line-height: 1.55; color: var(--pc-ink-soft, #5F5E5A); margin: 0 0 24px; }
  .actions .primary { display: inline-block; padding: 12px 15px; border: 1px solid currentColor; font: 700 11px var(--pc-font-mono, ui-monospace, monospace); letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
  .kin { margin-top: 32px; font-size: 13px; color: var(--pc-ink-soft, #5F5E5A); }
</style>
