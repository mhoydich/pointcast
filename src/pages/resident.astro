---
import BlockLayout from '../layouts/BlockLayout.astro';

const description = 'Local resident loop status: current join-system task, last 10 runs, success/fail counts, and compute hours.';
---

<BlockLayout title="Resident" description={description}>
  <main class="resident">
    <nav class="crumb"><a href="/">Home</a><span>/</span><span>resident</span></nav>
    <header class="top">
      <p class="kicker">OVERNIGHT RESIDENT</p>
      <h1>The machine has a night shift.</h1>
      <p>{description}</p>
    </header>

    <section class="stats" data-stats>
      <article><span>Current task</span><strong data-current>offline</strong></article>
      <article><span>Success</span><strong data-success>0</strong></article>
      <article><span>Fail</span><strong data-fail>0</strong></article>
      <article><span>Compute hours</span><strong data-hours>0</strong></article>
    </section>

    <section class="runs">
      <div class="section-head">
        <h2>Last 10 runs</h2>
        <div class="connection">
          <p data-status aria-live="polite">Looking for the local oracle…</p>
          <button type="button" data-retry hidden>Retry connection</button>
        </div>
      </div>
      <ol data-runs></ol>
    </section>
  </main>
</BlockLayout>

<script is:inline>
  const set = (sel, text) => {
    const el = document.querySelector(sel);
    if (el) el.textContent = text;
  };

  async function loadStatus() {
    const response = await fetch('http://127.0.0.1:8789/api/resident/status', { cache: 'no-store' });
    if (!response.ok) throw new Error('resident endpoint offline');
    return response.json();
  }

  function text(value, fallback = '') {
    return typeof value === 'string' && value.trim() ? value : fallback;
  }

  function safeBlockPath(value) {
    const path = text(value);
    return /^\/(?:b|plans)\/[A-Za-z0-9/_-]+$/.test(path) ? path : '';
  }

  function renderRuns(runData) {
    const runs = document.querySelector('[data-runs]');
    if (!runs) return;
    runs.replaceChildren();

    const entries = Array.isArray(runData) ? runData.slice(0, 10) : [];
    if (!entries.length) {
      const empty = document.createElement('li');
      empty.className = 'empty';
      empty.textContent = 'No resident runs yet.';
      runs.append(empty);
      return;
    }

    for (const run of entries) {
      const item = document.createElement('li');
      item.className = run?.success ? 'ok' : 'fail';

      const path = safeBlockPath(run?.blockPath);
      const title = text(run?.taskId, 'untitled run');
      const heading = path ? document.createElement('a') : document.createElement('strong');
      if (path) heading.href = path;
      heading.textContent = title;

      const meta = document.createElement('span');
      const minutes = Number.isFinite(Number(run?.minutes)) ? Number(run.minutes).toFixed(1) : '0.0';
      meta.textContent = `${run?.success ? 'success' : 'fail'} · ${minutes}m · ${text(run?.finishedAt, 'time unknown')}`;

      const artifacts = document.createElement('p');
      const names = Array.isArray(run?.artifacts)
        ? run.artifacts.slice(0, 5).map((value) => text(value)).filter(Boolean)
        : [];
      artifacts.textContent = names.join(', ') || 'no artifacts listed';
      item.append(heading, meta, artifacts);
      runs.append(item);
    }
  }

  function render(status) {
    const current = status.currentTask ? `${status.currentTask.id} · ${status.currentTask.project}` : status.running ? 'running' : 'idle';
    set('[data-current]', current);
    set('[data-success]', String(status.successCount || 0));
    set('[data-fail]', String(status.failCount || 0));
    set('[data-hours]', String(status.computeHours || 0));
    set('[data-status]', status.running ? 'running now' : `updated ${status.updatedAt || 'never'}`);
    document.querySelector('[data-retry]')?.toggleAttribute('hidden', true);
    renderRuns(status.runs);
  }

  async function refresh() {
    try {
      render(await loadStatus());
    } catch {
      set('[data-current]', 'local oracle offline');
      set('[data-status]', 'This console reads your machine only. Start npm run oracle, then retry.');
      document.querySelector('[data-retry]')?.removeAttribute('hidden');
      renderRuns([]);
    }
  }

  document.querySelector('[data-retry]')?.addEventListener('click', refresh);
  refresh();
  setInterval(refresh, 15000);
</script>

<style>
  .resident {
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 18px 80px;
  }

  .crumb,
  .kicker,
  .stats span,
  .runs span {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    gap: 8px;
    color: #6d665d;
    font-size: 11px;
    margin-bottom: 20px;
  }

  .crumb a,
  .runs a {
    color: #8b2b25;
    text-decoration: none;
  }

  .top {
    border-bottom: 2px solid #1f1b18;
    padding-bottom: 20px;
    margin-bottom: 18px;
  }

  .kicker {
    color: #8b2b25;
    font-size: 12px;
  }

  h1 {
    margin: 8px 0 10px;
    font-size: clamp(42px, 8vw, 84px);
    line-height: .94;
  }

  .top p:last-child {
    color: #4c453e;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.5;
  }

  .stats {
    display: grid;
    grid-template-columns: minmax(220px, 2fr) repeat(3, minmax(120px, 1fr));
    gap: 10px;
    margin-bottom: 24px;
  }

  .stats article {
    border: 2px solid #1f1b18;
    padding: 14px;
    background: #fffaf0;
    min-height: 94px;
  }

  .stats span {
    display: block;
    color: #6d665d;
    font-size: 10px;
    margin-bottom: 12px;
  }

  .stats strong {
    font-size: clamp(22px, 4vw, 38px);
    line-height: 1;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    border-bottom: 1px solid #d8ccba;
    margin-bottom: 12px;
  }

  .section-head h2 {
    margin: 0 0 10px;
    font-size: 28px;
  }

  .section-head p {
    margin: 0 0 12px;
    color: #6d665d;
  }

  .connection {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .connection button {
    border: 1px solid #1f1b18;
    background: #fffaf0;
    color: #8b2b25;
    padding: 7px 10px;
    font: 700 10px/1 var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .connection button:hover,
  .connection button:focus-visible {
    background: #1f1b18;
    color: #fffaf0;
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  li {
    border-left: 6px solid #5f5e5a;
    background: #fffdf7;
    padding: 12px 14px;
  }

  li.ok {
    border-left-color: #0f6e56;
  }

  li.fail {
    border-left-color: #8a2432;
  }

  .runs span {
    display: block;
    font-size: 10px;
    color: #6d665d;
    margin-top: 4px;
  }

  .runs p {
    margin: 8px 0 0;
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .section-head {
      display: block;
    }

    .connection {
      align-items: flex-start;
      justify-content: space-between;
    }
  }
</style>
