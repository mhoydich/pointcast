---
import BlockLayout from '../layouts/BlockLayout.astro';
import vessel from '../assets/shrines/open-road-v4/a1-vessel.webp';
import room from '../assets/shrines/open-road-v4/a2-room.webp';
import offering from '../assets/shrines/open-road-v4/a3-offering.webp';
import bloom from '../assets/shrines/open-road-v4/a4-bloom.webp';
import gift from '../assets/shrines/open-road-v4/a5-gift.webp';
import portal from '../assets/shrines/open-road-v4/b1-portal.webp';
import city from '../assets/shrines/open-road-v4/b2-city.webp';
import crossing from '../assets/shrines/open-road-v4/b3-crossing.webp';
import wing from '../assets/shrines/open-road-v4/b4-wing.webp';
import field from '../assets/shrines/open-road-v4/b5-field.webp';
import socialCard from '../assets/shrines/open-road-v4/open-road-v4-og.jpg';

const title = 'Open Road IV · The Bell Between Things';
const description =
  'A contemplative image shrine in five call-and-answer pairs, with an optional drift and small, user-invoked bells.';

const pairs = [
  {
    id: 'vessel-portal',
    numeral: 'I',
    interval: 'fifth',
    call: {
      name: 'Vessel',
      line: 'Hold what is given.',
      image: vessel,
      alt: 'Matte black vessel and low wooden tray against a charcoal wall, with a luminous turquoise line drawing of a flower rising from the vessel.',
    },
    answer: {
      name: 'Portal',
      line: 'Let it become passage.',
      image: portal,
      alt: 'Abstract blue city passage built from fine vertical stripes in gold, coral, mint, and pink.',
    },
  },
  {
    id: 'room-city',
    numeral: 'II',
    interval: 'fourth',
    call: {
      name: 'Room',
      line: 'Make one quiet place.',
      image: room,
      alt: 'Sunlit reading room with bookshelves, a soft chair, a black vase, and a large blue-and-gold labyrinth drawing on the wall.',
    },
    answer: {
      name: 'City',
      line: 'Then leave the walls behind.',
      image: city,
      alt: 'Los Angeles skyline rendered in fine vertical blue, cream, coral, and green stripes beneath a clear blue sky.',
    },
  },
  {
    id: 'offering-crossing',
    numeral: 'III',
    interval: 'sixth',
    call: {
      name: 'Offering',
      line: 'Set down what is enough.',
      image: offering,
      alt: 'Bowl of strawberries, citrus, grapes, and blueberries before a pastel city and striped field under a lavender sky.',
    },
    answer: {
      name: 'Crossing',
      line: 'The way carries it onward.',
      image: crossing,
      alt: 'Warm stone bridge spanning a green mountain gorge and river, with one small bird crossing the blue sky.',
    },
  },
  {
    id: 'bloom-wing',
    numeral: 'IV',
    interval: 'octave',
    call: {
      name: 'Bloom',
      line: 'Open without grasping.',
      image: bloom,
      alt: 'Single bird-of-paradise bloom in a clay pot, held in a broad shaft of sunlight against a pale plaster wall.',
    },
    answer: {
      name: 'Wing',
      line: 'Receive what passes.',
      image: wing,
      alt: 'Small bird perched among a dense embroidered garden of orange, coral, lavender, and deep green flowers.',
    },
  },
  {
    id: 'gift-field',
    numeral: 'V',
    interval: 'third',
    call: {
      name: 'Gift',
      line: 'Untie what was kept.',
      image: gift,
      alt: 'Patterned cloth gift box tied with a pale gold ribbon and resting on layered floral textiles.',
    },
    answer: {
      name: 'Field',
      line: 'Let it become the wider world.',
      image: field,
      alt: 'Green hills and blue water beneath bright clouds, overlaid with delicate grids, maps, diagrams, and fragments of notation.',
    },
  },
];

const ringPoints = [
  { x: 50, y: 10 },
  { x: 75, y: 18 },
  { x: 88, y: 39 },
  { x: 84, y: 66 },
  { x: 67, y: 86 },
  { x: 50, y: 90 },
  { x: 25, y: 82 },
  { x: 12, y: 61 },
  { x: 16, y: 34 },
  { x: 33, y: 14 },
];

const lights = [
  ...pairs.map((pair, pairIndex) => ({
    pairIndex,
    pointIndex: pairIndex,
    side: 'call',
    name: pair.call.name,
    ...ringPoints[pairIndex],
  })),
  ...pairs.map((pair, pairIndex) => ({
    pairIndex,
    pointIndex: pairIndex + 5,
    side: 'answer',
    name: pair.answer.name,
    ...ringPoints[pairIndex + 5],
  })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v4',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialCard.src}
  jsonLd={jsonLd}
>
  <section
    class="or4"
    id="open-road-v4-shrine"
    aria-labelledby="or4-title"
    data-view="ring"
    data-paused="false"
  >
    <span class="or4__glint" id="or4-glint" aria-hidden="true"></span>

    <div class="or4__bell-halo" aria-hidden="true" id="or4-halo">
      <span></span>
      <span></span>
    </div>

    <nav class="or4__wayfinding" aria-label="Open Road editions">
      <a href="/" aria-label="Return to PointCast home"><span aria-hidden="true">←</span> PointCast</a>
      <span aria-hidden="true">·</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <a href="/open-road-v3">III</a>
      <span aria-current="page">IV</span>
    </nav>

    <div class="or4__chapel">
      <header class="or4__header">
        <div class="or4__title-lockup">
          <span class="or4__edition" aria-hidden="true">IV</span>
          <div>
            <p class="or4__eyebrow">Open Road IV · The Bell Between Things</p>
            <h1 id="or4-title">Listen for the space between.</h1>
            <p class="or4__opening" id="or4-opening">
              Five images call. Five answer. Listen for the space between.
            </p>
          </div>
        </div>

        <div class="or4__toggles" role="group" aria-label="Shrine settings">
          <button class="or4__toggle" id="or4-bells" type="button" aria-pressed="false">
            <span class="or4__toggle-mark" aria-hidden="true">◌</span>
            <span id="or4-bells-label">Bells off</span>
          </button>
          <button class="or4__toggle" id="or4-drift" type="button" aria-pressed="false">
            <span class="or4__toggle-mark" aria-hidden="true">↝</span>
            <span id="or4-drift-label">Drift off</span>
          </button>
        </div>
      </header>

      <section class="or4__ring-view" id="or4-ring-view" aria-labelledby="or4-ring-title">
        <h2 class="sr-only" id="or4-ring-title">Choose one of ten lights</h2>
        <div class="or4__ring" role="group" aria-describedby="or4-opening">
          <span class="or4__ring-orbit or4__ring-orbit--outer" aria-hidden="true"></span>
          <span class="or4__ring-orbit or4__ring-orbit--inner" aria-hidden="true"></span>

          {pairs.map((pair, index) => (
            <span
              class="or4__chord"
              data-chord={index}
              style={`--chord-angle: ${index * 36 - 90}deg;`}
              aria-hidden="true"
            ></span>
          ))}

          {lights.map((light) => (
            <button
              class:list={['or4__light', `or4__light--${light.side}`]}
              type="button"
              data-light
              data-pair={light.pairIndex}
              data-side={light.side}
              data-point={light.pointIndex}
              aria-label={`Open ${pairs[light.pairIndex].call.name} and ${pairs[light.pairIndex].answer.name}, beginning at ${light.name}`}
              style={`--light-x: ${light.x}%; --light-y: ${light.y}%; --light-delay: ${light.pointIndex * -0.43}s;`}
            >
              <span class="or4__light-core" aria-hidden="true"></span>
              <span class="or4__light-name" aria-hidden="true">{light.name}</span>
            </button>
          ))}

          <div class="or4__ring-center" aria-hidden="true">
            <span data-side="call">call</span>
            <i></i>
            <span data-side="answer">answer</span>
          </div>
        </div>

        <div class="or4__legend" aria-hidden="true">
          <span><i class="or4__legend-call"></i> Call</span>
          <span><i class="or4__legend-answer"></i> Answer</span>
          <span>Choose any light</span>
        </div>
      </section>

      <section class="or4__pair-view" id="or4-pair-view" aria-labelledby="or4-pair-title" hidden>
        <header class="or4__pair-heading">
          <div>
            <p class="or4__eyebrow" id="or4-pair-number">Pair I · fifth</p>
            <h2 id="or4-pair-title" tabindex="-1">Vessel / Portal</h2>
          </div>
          <button class="or4__return" id="or4-return" type="button">
            <span aria-hidden="true">←</span> Return to ring
          </button>
        </header>

        <div class="or4__pairs">
          {pairs.map((pair, pairIndex) => (
            <article
              class:list={['or4__pair', { 'is-active': pairIndex === 0 }]}
              data-pair-panel={pairIndex}
              data-id={pair.id}
              aria-hidden={pairIndex === 0 ? 'false' : 'true'}
              hidden={pairIndex !== 0}
            >
              <figure class="or4__half or4__half--call">
                <figcaption>
                  <span>Call · {pair.numeral}</span>
                  <strong>{pair.call.name}</strong>
                </figcaption>
                <div class="or4__image-frame">
                  <img
                    src={pair.call.image.src}
                    alt={pair.call.alt}
                    width={pair.call.image.width}
                    height={pair.call.image.height}
                    loading={pairIndex === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={pairIndex === 0 ? 'high' : 'auto'}
                  />
                  <span class="or4__image-wash" aria-hidden="true"></span>
                </div>
                <blockquote>{pair.call.line}</blockquote>
              </figure>

              <div class="or4__filament" aria-hidden="true">
                <span></span>
                <i></i>
                <small>{pair.interval}</small>
              </div>

              <figure class="or4__half or4__half--answer">
                <figcaption>
                  <span>Answer · {pair.numeral}</span>
                  <strong>{pair.answer.name}</strong>
                </figcaption>
                <div class="or4__image-frame">
                  <img
                    src={pair.answer.image.src}
                    alt={pair.answer.alt}
                    width={pair.answer.image.width}
                    height={pair.answer.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="or4__image-wash" aria-hidden="true"></span>
                </div>
                <blockquote>{pair.answer.line}</blockquote>
              </figure>
            </article>
          ))}
        </div>

        <nav class="or4__pair-nav" aria-label="Browse image pairs">
          <button id="or4-previous" type="button"><span aria-hidden="true">←</span> Previous</button>
          <span id="or4-pair-counter" aria-hidden="true">1 / 5</span>
          <button id="or4-next" type="button">Next <span aria-hidden="true">→</span></button>
        </nav>
      </section>

      <aside class="or4__mandala-wrap" aria-labelledby="or4-mandala-label">
        <div class="or4__mandala" id="or4-mandala" role="img" aria-label="No pairs visited yet">
          {pairs.map((pair, index) => (
            <span
              class="or4__petal"
              data-petal={index}
              style={`--petal-index: ${index};`}
              aria-hidden="true"
            ></span>
          ))}
          <i aria-hidden="true"></i>
        </div>
        <p id="or4-mandala-label"><span id="or4-visited-count">0</span> of 5 pairs received</p>
      </aside>

      <p class="or4__closing" id="or4-closing" hidden>
        The bell is gone. The listening remains.
      </p>

      <footer class="or4__footer">
        <p>Ten works from the artist’s archive · five calls, five answers</p>
        <p aria-hidden="true">← → move · esc return · sound by choice</p>
      </footer>

      <p class="sr-only" id="or4-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>
</BlockLayout>

<style is:global>
  body:has(#open-road-v4-shrine) {
    --or4-night: #090919;
    --or4-indigo: #11132d;
    --or4-indigo-soft: #191d3d;
    --or4-paper: #eee7d8;
    --or4-paper-dim: #aaa493;
    --or4-brass: #c7a767;
    --or4-brass-bright: #ecd190;
    --or4-rose: #a96667;
    margin: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    background: var(--or4-night);
  }

  body:has(#open-road-v4-shrine) #pc-fb,
  body:has(#open-road-v4-shrine) #pc-spell-layer,
  body:has(#open-road-v4-shrine) #cursor-room,
  body:has(#open-road-v4-shrine) #pc-freshness,
  body:has(#open-road-v4-shrine) #pc-first-see {
    display: none !important;
  }

  body:has(#open-road-v4-shrine) #main-content {
    min-width: 0;
  }

  html.cr-cursor-active body:has(#open-road-v4-shrine),
  html.cr-cursor-active body:has(#open-road-v4-shrine) #main-content,
  html.cr-cursor-active body:has(#open-road-v4-shrine) #main-content * {
    cursor: auto !important;
  }

  html.cr-cursor-active body:has(#open-road-v4-shrine) a,
  html.cr-cursor-active body:has(#open-road-v4-shrine) button {
    cursor: pointer !important;
  }

  .or4,
  .or4 *,
  .or4 *::before,
  .or4 *::after {
    box-sizing: border-box;
  }

  .or4 [hidden] {
    display: none !important;
  }

  .or4 {
    min-height: 100svh;
    min-height: 100dvh;
    width: 100%;
    max-width: 100vw;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(86px, 10vh, 122px) clamp(18px, 4vw, 66px) clamp(32px, 5vh, 68px);
    color: var(--or4-paper);
    background:
      radial-gradient(circle at 50% 36%, rgba(199, 167, 103, 0.085), transparent 23%),
      radial-gradient(circle at 9% 82%, rgba(103, 87, 145, 0.12), transparent 28%),
      radial-gradient(circle at 92% 11%, rgba(169, 102, 103, 0.07), transparent 24%),
      linear-gradient(145deg, var(--or4-night) 0%, var(--or4-indigo) 56%, #0a0b1d 100%);
    font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .or4::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 43px, rgba(238, 231, 216, 0.025) 44px),
      repeating-linear-gradient(90deg, transparent 0 43px, rgba(238, 231, 216, 0.018) 44px);
    mask-image: radial-gradient(ellipse at center, black, transparent 78%);
  }

  .or4::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 18px;
    pointer-events: none;
    border: 1px solid rgba(199, 167, 103, 0.12);
    clip-path: polygon(0 0, 32% 0, 32% 1px, 68% 1px, 68% 0, 100% 0, 100% 100%, 68% 100%, 68% calc(100% - 1px), 32% calc(100% - 1px), 32% 100%, 0 100%);
  }

  .or4__glint {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .or4__glint {
      position: fixed;
      z-index: 50;
      left: 0;
      top: 0;
      display: block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      opacity: 0;
      pointer-events: none;
      background: var(--or4-brass-bright);
      box-shadow: 0 0 8px rgba(236, 209, 144, 0.82), 0 0 18px rgba(199, 167, 103, 0.34);
      transform: translate3d(-20px, -20px, 0);
      transition: opacity 180ms ease;
      will-change: transform;
    }

    .or4__glint.is-visible {
      opacity: 0.82;
    }
  }

  .or4__wayfinding {
    position: absolute;
    z-index: 8;
    top: clamp(18px, 2.6vw, 32px);
    left: clamp(14px, 2.8vw, 40px);
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(238, 231, 216, 0.4);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .or4__wayfinding a,
  .or4__wayfinding span {
    min-width: 20px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .or4__wayfinding a:first-child {
    justify-content: flex-start;
  }

  .or4__wayfinding a:hover,
  .or4__wayfinding a:focus-visible,
  .or4__wayfinding [aria-current='page'] {
    color: var(--or4-paper);
  }

  .or4__chapel {
    width: min(100%, 1260px);
    margin: 0 auto;
  }

  .or4__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: clamp(30px, 5vh, 56px);
  }

  .or4__title-lockup {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .or4__edition {
    width: 50px;
    height: 62px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: 1px solid rgba(199, 167, 103, 0.48);
    color: var(--or4-brass-bright);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 14px;
    font-style: italic;
    clip-path: polygon(50% 0, 91% 22%, 100% 68%, 50% 100%, 0 68%, 9% 22%);
  }

  .or4__eyebrow {
    margin: 0 0 7px;
    color: rgba(238, 231, 216, 0.46);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .or4__header h1,
  .or4__pair-heading h2 {
    margin: 0;
    color: var(--or4-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .or4__header h1 {
    max-width: 720px;
    font-size: clamp(31px, 4.2vw, 58px);
    line-height: 0.98;
  }

  .or4__opening {
    max-width: 620px;
    margin: 15px 0 0;
    color: rgba(238, 231, 216, 0.67);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(15px, 1.5vw, 19px);
    font-style: italic;
    line-height: 1.5;
  }

  .or4__toggles {
    flex: 0 0 auto;
    display: flex;
    gap: 8px;
  }

  .or4__toggle,
  .or4__return,
  .or4__pair-nav button {
    min-height: 44px;
    border: 1px solid rgba(199, 167, 103, 0.32);
    border-radius: 0;
    color: rgba(238, 231, 216, 0.68);
    background: rgba(9, 9, 25, 0.46);
    font: inherit;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .or4__toggle {
    min-width: 118px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .or4__toggle-mark {
    color: var(--or4-brass);
    font-family: Georgia, serif;
    font-size: 17px;
    line-height: 1;
  }

  .or4__toggle[aria-pressed='true'] {
    border-color: rgba(236, 209, 144, 0.72);
    color: var(--or4-paper);
    background: rgba(199, 167, 103, 0.12);
    box-shadow: inset 0 0 20px rgba(199, 167, 103, 0.06);
  }

  .or4__toggle:hover,
  .or4__return:hover,
  .or4__pair-nav button:hover {
    color: var(--or4-paper);
    border-color: rgba(236, 209, 144, 0.62);
  }

  .or4 button:focus-visible,
  .or4 a:focus-visible,
  .or4 [tabindex='-1']:focus-visible {
    outline: 2px solid var(--or4-brass-bright);
    outline-offset: 4px;
  }

  .or4__ring-view {
    min-width: 0;
  }

  .or4__ring {
    position: relative;
    isolation: isolate;
    width: min(72vh, 610px, 100%);
    aspect-ratio: 1;
    margin: 0 auto;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(199, 167, 103, 0.095) 0 1px, transparent 2px) center / 31px 31px,
      radial-gradient(circle, rgba(26, 30, 63, 0.26), rgba(9, 9, 25, 0.08) 62%, transparent 72%);
  }

  .or4__ring::before,
  .or4__ring::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 10.5%;
    border-radius: 50%;
    border: 1px solid rgba(199, 167, 103, 0.1);
    pointer-events: none;
  }

  .or4__ring::after {
    inset: 24%;
    border-style: dashed;
    opacity: 0.62;
    animation: or4-orbit 80s linear infinite;
  }

  .or4__ring-orbit {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(238, 231, 216, 0.08);
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .or4__ring-orbit--outer {
    width: 92%;
    height: 92%;
    box-shadow: 0 0 70px rgba(199, 167, 103, 0.045), inset 0 0 70px rgba(199, 167, 103, 0.025);
  }

  .or4__ring-orbit--inner {
    width: 48%;
    height: 48%;
    border-color: rgba(199, 167, 103, 0.13);
  }

  .or4__chord {
    position: absolute;
    z-index: 0;
    left: 20%;
    top: calc(50% - 0.5px);
    width: 60%;
    height: 1px;
    opacity: 0.2;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--or4-brass), transparent);
    transform: rotate(var(--chord-angle));
    transform-origin: center;
    transition: opacity 500ms ease, filter 500ms ease;
  }

  .or4__chord.is-visited {
    opacity: 0.52;
    filter: drop-shadow(0 0 4px rgba(236, 209, 144, 0.3));
  }

  .or4__light {
    position: absolute;
    z-index: 3;
    left: var(--light-x);
    top: var(--light-y);
    width: 58px;
    min-width: 58px;
    height: 58px;
    min-height: 58px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: rgba(238, 231, 216, 0.54);
