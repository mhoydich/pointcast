<script>
  const shrine = document.getElementById('open-road-v4-shrine');
  const ringView = document.getElementById('or4-ring-view');
  const pairView = document.getElementById('or4-pair-view');
  const pairTitle = document.getElementById('or4-pair-title');
  const pairNumber = document.getElementById('or4-pair-number');
  const pairCounter = document.getElementById('or4-pair-counter');
  const returnButton = document.getElementById('or4-return');
  const previousButton = document.getElementById('or4-previous');
  const nextButton = document.getElementById('or4-next');
  const bellsButton = document.getElementById('or4-bells');
  const bellLabel = document.getElementById('or4-bells-label');
  const driftButton = document.getElementById('or4-drift');
  const driftLabel = document.getElementById('or4-drift-label');
  const halo = document.getElementById('or4-halo');
  const status = document.getElementById('or4-status');
  const mandala = document.getElementById('or4-mandala');
  const visitedCount = document.getElementById('or4-visited-count');
  const closing = document.getElementById('or4-closing');
  const glint = document.getElementById('or4-glint');
  const lightButtons = Array.from(document.querySelectorAll('#open-road-v4-shrine [data-light]'));
  const pairPanels = Array.from(document.querySelectorAll('#open-road-v4-shrine [data-pair-panel]'));
  const petals = Array.from(document.querySelectorAll('#open-road-v4-shrine [data-petal]'));
  const chords = Array.from(document.querySelectorAll('#open-road-v4-shrine [data-chord]'));

  if (
    shrine instanceof HTMLElement &&
    ringView instanceof HTMLElement &&
    pairView instanceof HTMLElement &&
    pairTitle instanceof HTMLElement &&
    pairNumber instanceof HTMLElement &&
    pairCounter instanceof HTMLElement &&
    returnButton instanceof HTMLButtonElement &&
    previousButton instanceof HTMLButtonElement &&
    nextButton instanceof HTMLButtonElement &&
    bellsButton instanceof HTMLButtonElement &&
    bellLabel instanceof HTMLElement &&
    driftButton instanceof HTMLButtonElement &&
    driftLabel instanceof HTMLElement &&
    halo instanceof HTMLElement &&
    status instanceof HTMLElement &&
    mandala instanceof HTMLElement &&
    visitedCount instanceof HTMLElement &&
    closing instanceof HTMLElement
  ) {
    const PAIR_NAMES = [
      ['Vessel', 'Portal'],
      ['Room', 'City'],
      ['Offering', 'Crossing'],
      ['Bloom', 'Wing'],
      ['Gift', 'Field'],
    ];
    const NUMERALS = ['I', 'II', 'III', 'IV', 'V'];
    const INTERVAL_NAMES = ['fifth', 'fourth', 'sixth', 'octave', 'third'];
    const INTERVAL_RATIOS = [3 / 2, 4 / 3, 5 / 3, 2, 5 / 4];
    const FUNDAMENTALS = [196, 220, 246.94, 174.61, 207.65];
    const PARTIAL_RATIOS = [1, 2.76, 5.17];
    const PARTIAL_GAINS = [1, 0.26, 0.11];
    const DRIFT_INTERVAL = 14_000;

    let currentPair = 0;
    let lastLightIndex = 0;
    let bellsOn = false;
    let driftOn = false;
    let driftTimer = 0;
    let haloTimer = 0;
    const visited = new Set();

    let audioContext = null;
    let masterGain = null;
    let compressor = null;
    const activeOscillators = new Set();

    const isRingView = () => shrine.dataset.view === 'ring';

    const clearDriftTimer = () => {
      window.clearTimeout(driftTimer);
      driftTimer = 0;
    };

    const scheduleDrift = () => {
      clearDriftTimer();
      if (!driftOn || isRingView() || document.hidden) return;
      driftTimer = window.setTimeout(() => {
        showPair((currentPair + 1) % PAIR_NAMES.length, {
          announce: false,
          playBell: true,
          moveFocus: false,
        });
      }, DRIFT_INTERVAL);
    };

    const updateVisited = () => {
      const total = visited.size;
      visitedCount.textContent = String(total);
      mandala.setAttribute(
        'aria-label',
        total === 0 ? 'No pairs visited yet' : total + ' of 5 pairs visited'
      );

      lightButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.classList.toggle('is-visited', visited.has(Number(button.dataset.pair)));
      });

      petals.forEach((petal) => {
        if (!(petal instanceof HTMLElement)) return;
        petal.classList.toggle('is-visited', visited.has(Number(petal.dataset.petal)));
      });

      chords.forEach((chord) => {
        if (!(chord instanceof HTMLElement)) return;
        chord.classList.toggle('is-visited', visited.has(Number(chord.dataset.chord)));
      });

      if (total === PAIR_NAMES.length) {
        closing.hidden = false;
      }
    };

    const triggerHalo = () => {
      window.clearTimeout(haloTimer);
      halo.classList.remove('is-ringing');
      void halo.offsetWidth;
      halo.classList.add('is-ringing');
      haloTimer = window.setTimeout(() => halo.classList.remove('is-ringing'), 2900);
    };

    const stopActiveOscillators = () => {
      activeOscillators.forEach((oscillator) => {
        try {
          oscillator.stop();
        } catch {
          // A tone that already ended needs no further action.
        }
      });
      activeOscillators.clear();
    };

    const ensureAudio = async () => {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return false;

      if (!audioContext) {
        audioContext = new AudioContextClass();
        masterGain = audioContext.createGain();
        compressor = audioContext.createDynamicsCompressor();
        masterGain.gain.value = 0.16;
        compressor.threshold.value = -24;
        compressor.knee.value = 18;
        compressor.ratio.value = 4;
        compressor.attack.value = 0.01;
        compressor.release.value = 0.22;
        masterGain.connect(compressor);
        compressor.connect(audioContext.destination);
      }

      if (audioContext.state === 'suspended') {
        try {
          await audioContext.resume();
        } catch {
          return false;
        }
      }

      return audioContext.state === 'running';
    };

    const scheduleBell = (frequency, startAt, peak, duration) => {
      if (!audioContext || !masterGain) return;

      PARTIAL_RATIOS.forEach((ratio, index) => {
        if (!audioContext || !masterGain) return;
        const oscillator = audioContext.createOscillator();
        const envelope = audioContext.createGain();
        const partialPeak = Math.max(0.0002, peak * PARTIAL_GAINS[index]);
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(frequency * ratio, startAt);
        envelope.gain.setValueAtTime(0.0001, startAt);
        envelope.gain.exponentialRampToValueAtTime(partialPeak, startAt + 0.018);
        envelope.gain.exponentialRampToValueAtTime(0.0001, startAt + duration);
        oscillator.connect(envelope);
        envelope.connect(masterGain);
        oscillator.addEventListener('ended', () => activeOscillators.delete(oscillator), { once: true });
        activeOscillators.add(oscillator);
        oscillator.start(startAt);
        oscillator.stop(startAt + duration + 0.04);
      });
    };

    const playPairBell = async (pairIndex) => {
      if (!bellsOn || document.hidden) return;
      const ready = await ensureAudio();
      if (!ready || !audioContext || !bellsOn || document.hidden) return;

      const callFrequency = FUNDAMENTALS[pairIndex];
      const answerFrequency = callFrequency * INTERVAL_RATIOS[pairIndex];
      const now = audioContext.currentTime + 0.025;
      scheduleBell(callFrequency, now, 0.052, 1.18);
      scheduleBell(answerFrequency, now + 1.08, 0.044, 1.08);
    };

    const showPair = (
      nextPair,
      options = { announce: true, playBell: true, moveFocus: false }
    ) => {
      const boundedPair = ((nextPair % PAIR_NAMES.length) + PAIR_NAMES.length) % PAIR_NAMES.length;
      currentPair = boundedPair;
      shrine.dataset.view = 'pair';
      ringView.hidden = true;
      pairView.hidden = false;

      pairPanels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const active = Number(panel.dataset.pairPanel) === currentPair;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
        panel.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      const names = PAIR_NAMES[currentPair];
      pairTitle.textContent = names[0] + ' / ' + names[1];
      pairNumber.textContent =
        'Pair ' + NUMERALS[currentPair] + ' · ' + INTERVAL_NAMES[currentPair];
      pairCounter.textContent = currentPair + 1 + ' / ' + PAIR_NAMES.length;
      visited.add(currentPair);
      updateVisited();
      triggerHalo();
      if (options.playBell) void playPairBell(currentPair);
      if (options.announce) {
        status.textContent =
          'Pair ' + (currentPair + 1) + ': ' + names[0] + ' calls. ' + names[1] + ' answers.';
      }
      if (options.moveFocus) pairTitle.focus({ preventScroll: true });
      scheduleDrift();
    };

    const returnToRing = (announce = true) => {
      clearDriftTimer();
      shrine.dataset.view = 'ring';
      pairView.hidden = true;
      ringView.hidden = false;
      pairPanels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        panel.hidden = true;
        panel.classList.remove('is-active');
        panel.setAttribute('aria-hidden', 'true');
      });
      if (announce) status.textContent = 'Returned to the ring of ten lights.';
      const target = lightButtons[lastLightIndex];
      if (target instanceof HTMLButtonElement) target.focus({ preventScroll: true });
    };

    lightButtons.forEach((button, lightIndex) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        lastLightIndex = lightIndex;
        showPair(Number(button.dataset.pair), {
          announce: true,
          playBell: true,
          moveFocus: true,
        });
      });
    });

    returnButton.addEventListener('click', () => returnToRing());
    previousButton.addEventListener('click', () => {
      showPair(currentPair - 1, { announce: true, playBell: true, moveFocus: false });
    });
    nextButton.addEventListener('click', () => {
      showPair(currentPair + 1, { announce: true, playBell: true, moveFocus: false });
    });

    bellsButton.addEventListener('click', () => {
      bellsOn = !bellsOn;
      bellsButton.setAttribute('aria-pressed', bellsOn ? 'true' : 'false');
      bellLabel.textContent = bellsOn ? 'Bells on' : 'Bells off';
      if (bellsOn) {
        void ensureAudio();
        status.textContent = 'Bells on. They sound only when you choose a pair.';
      } else {
        stopActiveOscillators();
        status.textContent = 'Bells off.';
      }
    });

    driftButton.addEventListener('click', () => {
      driftOn = !driftOn;
      driftButton.setAttribute('aria-pressed', driftOn ? 'true' : 'false');
      driftLabel.textContent = driftOn ? 'Drift on' : 'Drift off';
      clearDriftTimer();

      if (driftOn) {
        status.textContent = 'Drift on. The image pairs will advance every fourteen seconds.';
        if (isRingView()) {
          showPair(currentPair, { announce: false, playBell: true, moveFocus: true });
        } else {
          scheduleDrift();
        }
      } else {
        status.textContent = 'Drift off.';
      }
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const isTyping =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        (target instanceof HTMLElement && target.isContentEditable);
      if (isTyping) return;

      if (event.key === 'Escape' && !isRingView()) {
        event.preventDefault();
        returnToRing();
        return;
      }

      const isPrevious = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
      const isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
      if (!isPrevious && !isNext) return;

      const direction = isNext ? 1 : -1;
      if (isRingView()) {
        const focusedIndex = lightButtons.indexOf(document.activeElement);
        if (focusedIndex < 0) return;
        event.preventDefault();
        const startIndex = focusedIndex;
        lastLightIndex =
          (startIndex + direction + lightButtons.length) % lightButtons.length;
        const light = lightButtons[lastLightIndex];
        if (light instanceof HTMLButtonElement) light.focus();
      } else {
        if (!(event.target instanceof Node) || !pairView.contains(event.target)) return;
        event.preventDefault();
        showPair(currentPair + direction, {
          announce: !event.repeat,
          playBell: !event.repeat,
          moveFocus: false,
        });
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        shrine.dataset.paused = 'true';
        clearDriftTimer();
        window.clearTimeout(haloTimer);
        halo.classList.remove('is-ringing');
        stopActiveOscillators();
        if (audioContext && audioContext.state === 'running') void audioContext.suspend();
        return;
      }

      shrine.dataset.paused = 'false';
      if (bellsOn && audioContext && audioContext.state === 'suspended') {
        void audioContext.resume();
      }
      scheduleDrift();
    });

    if (
      glint instanceof HTMLElement &&
      window.matchMedia('(hover: hover) and (pointer: fine)').matches
    ) {
      window.addEventListener(
        'pointermove',
        (event) => {
          glint.style.transform =
            'translate3d(' + (event.clientX + 12) + 'px, ' + (event.clientY - 10) + 'px, 0)';
          glint.classList.add('is-visible');
        },
        { passive: true }
      );

      window.addEventListener('mouseout', (event) => {
        if (!event.relatedTarget) glint.classList.remove('is-visible');
      });
    }
  }
</script>
