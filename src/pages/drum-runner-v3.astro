---
/**
 * /drum-runner-v3 — frozen Beat Runner v3 archive.
 *
 * A one-button musical runner where the player's input performs the track.
 * Hit the cue on beat n, clear the obstacle at the apex on beat n + 1,
 * then land on beat n + 2 while the city echoes the phrase back.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Beat Runner v3 · play the city';
const description = 'Perform the beat to run it. Every on-grid tap sounds a note, clears an obstacle one beat later, and builds a four-scene El Segundo track.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Beat Runner v3',
  url: 'https://pointcast.xyz/drum-runner-v3',
  description,
  gamePlatform: 'Web browser',
  playMode: 'SinglePlayer',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="drn" id="drn" data-phase="intro" data-scene="mainstreet">
    <header class="drn__hud" aria-label="Beat Runner status">
      <div class="drn__score-block">
        <span class="drn__score" id="drn-score">0</span>
        <span class="drn__score-label">pocket pts</span>
      </div>

      <div class="drn__level-block">
        <span class="drn__level-no" id="drn-level-no">LEVEL 01 / 04</span>
        <strong class="drn__level-name" id="drn-level-name">Marine Layer</strong>
        <span class="drn__tempo" id="drn-tempo">92 BPM</span>
      </div>

      <div class="drn__run-block">
        <div class="drn__flow-line">
          <span>pocket</span>
          <strong id="drn-flow">—</strong>
        </div>
        <div class="drn__lives" id="drn-lives" aria-hidden="true">
          <span class="drn__life"></span>
          <span class="drn__life"></span>
          <span class="drn__life"></span>
        </div>
        <span class="drn__best" id="drn-best-line">best — pts</span>
      </div>
    </header>

    <section class="drn__stage" id="drn-stage" aria-label="Beat Runner game">
      <div class="drn__beat-rail" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="drn__progress" aria-hidden="true"><span id="drn-progress"></span></div>
      <div class="drn__phrase" id="drn-phrase" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <canvas
        class="drn__canvas"
        id="drn-canvas"
        role="img"
        aria-label="Beat Runner v3 playfield: perform each cue to sound a note, jump, and build the city's rhythm."
      >Beat Runner v3 game canvas.</canvas>

      <div class="drn__overlay" id="drn-overlay">
        <article class="drn__card" id="drn-card">
          <div class="drn__postcard" id="drn-postcard" aria-hidden="true"></div>
          <div class="drn__card-body">
            <div class="drn__eyebrow">
              <span id="drn-kicker">BEAT RUNNER V3</span>
              <span id="drn-card-tempo">4 LEVELS · 92→128 BPM</span>
            </div>
            <h1 class="drn__title" id="drn-title">PLAY THE CITY.<br />CLEAR THE STREET.</h1>
            <p class="drn__sub" id="drn-sub">Your tap is the note. The obstacle arrives one beat later. The landing closes the phrase.</p>

            <div class="drn__card-stats" id="drn-card-stats" aria-label="Run details">
              <span><small id="drn-stat-a-label">route</small><strong id="drn-stat-a">4 levels</strong></span>
              <span><small id="drn-stat-b-label">tempo</small><strong id="drn-stat-b">92→128</strong></span>
              <span><small id="drn-stat-c-label">hearts</small><strong id="drn-stat-c">3 total</strong></span>
            </div>

            <ol class="drn__route" id="drn-route" aria-label="Four-level route">
              <li data-route-index="0"><span>01</span><b>Marine</b></li>
              <li data-route-index="1"><span>02</span><b>Pier</b></li>
              <li data-route-index="2"><span>03</span><b>Ralphs</b></li>
              <li data-route-index="3"><span>04</span><b>Refinery</b></li>
            </ol>

            <p class="drn__overlay-best" id="drn-best">best — pts</p>
            <button class="drn__go" id="drn-go" type="button">▶ START LEVEL 01</button>
            <p class="drn__input-note">space · ↑ · w · tap</p>
          </div>
        </article>
      </div>

      <span class="drn__judge" id="drn-judge" aria-hidden="true"></span>
      <span class="drn__tap-hint" id="drn-tap-hint">gold cue → perform · apex · land</span>
    </section>

    <div class="drn__controls">
      <button class="drn__jump" id="drn-jump" type="button" aria-label="Perform beat and jump (Space, Arrow Up, or W)" disabled>
        <span class="drn__jump-arrow">♪</span>
        <span class="drn__jump-copy"><strong>PLAY + JUMP</strong><small>space · ↑ · w</small></span>
      </button>
      <button class="drn__audio" id="drn-audio" type="button" aria-pressed="false" aria-label="Beat Runner audio muted">sound on</button>
    </div>

    <p class="sr-only" id="drn-state-live" role="status" aria-live="polite" aria-atomic="true">Beat Runner v3 ready. Perform the cues through four levels with three hearts.</p>
    <p class="sr-only" id="drn-lives-live" role="status" aria-live="polite">3 hearts remaining.</p>

    <nav class="drn__versions" aria-label="Beat Runner versions">
      <span>edition</span>
      <a href="/drum-runner-v1">v1 endless</a>
      <a href="/drum-runner-v2">v2 postcards</a>
      <a href="/drum-runner-v3" aria-current="page">v3 pocket</a>
      <a href="/drum-runner-v4">v4 road band</a>
      <a href="/drum-runner-v5">v5 bright miles</a>
      <a href="/drum-runner-v6">v6 pulse arena</a>
      <a href="/drum-runner">v7 loop siege</a>
    </nav>

    <nav class="drn__siblings" aria-label="More Drum Arcade games">
      <a href="/drum-games">all five</a>
      <a href="/drum-says">drum says</a>
      <a href="/drum-quickdraw">quick draw</a>
      <a href="/drum-fill">fill</a>
      <a href="/drum-steady">steady</a>
      <a href="/drum">/drum</a>
    </nav>
  </div>

  <style is:global>
    html, body { margin: 0; background: #040713; }
    body:has(.drn) {
      min-height: 100vh;
      overflow-x: hidden;
      color: #f8f3e8;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    }
    .drn {
      --accent: #ffd166;
      --accent-soft: #ff8f70;
      width: min(100%, 860px);
      min-height: 95vh;
      margin: 0 auto;
      padding: 12px 14px 42px;
      display: flex;
      flex-direction: column;
      gap: 11px;
      box-sizing: border-box;
    }
    .sr-only {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    /* HUD */
    .drn__hud {
      min-height: 58px;
      display: grid;
      grid-template-columns: minmax(100px, 1fr) minmax(180px, 1.35fr) minmax(110px, 1fr);
      align-items: center;
      gap: 12px;
      padding: 3px 7px;
      font-family: 'JetBrains Mono', monospace;
    }
    .drn__score-block { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 8px; }
    .drn__score {
      color: var(--accent);
      font: 900 clamp(30px, 5vw, 42px)/0.9 'Inter Tight', 'Inter', sans-serif;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 22px color-mix(in srgb, var(--accent) 55%, transparent);
    }
    .drn__score-label,
    .drn__level-no,
    .drn__tempo,
    .drn__flow-line span {
      color: #8f94aa;
      font-size: 9px;
      letter-spacing: .17em;
      text-transform: uppercase;
    }
    .drn__level-block { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 4px 10px; text-align: center; }
    .drn__level-name { width: 100%; color: #f8f3e8; font-size: 15px; letter-spacing: .11em; text-transform: uppercase; }
    .drn__tempo { color: var(--accent-soft); }
    .drn__run-block { display: grid; grid-template-columns: 1fr auto; align-items: center; justify-items: end; gap: 3px 10px; }
    .drn__flow-line { display: flex; align-items: baseline; gap: 6px; }
    .drn__flow-line strong { min-width: 24px; color: var(--accent-soft); font-size: 16px; font-variant-numeric: tabular-nums; }
    .drn__lives { display: flex; gap: 5px; }
    .drn__life {
      width: 14px;
      height: 12px;
      background: #ff5f7e;
      border-radius: 4px 4px 7px 7px;
      box-shadow: 0 0 10px rgba(255,95,126,.55), inset 0 1px rgba(255,255,255,.35);
      clip-path: polygon(50% 100%, 3% 45%, 6% 17%, 25% 0, 50% 18%, 75% 0, 94% 17%, 97% 45%);
      transition: opacity 160ms ease, transform 160ms ease, filter 160ms ease;
    }
    .drn__life--lost { opacity: .2; filter: grayscale(1); transform: scale(.78); box-shadow: none; }
    .drn__best { grid-column: 1 / -1; color: #85899b; font-size: 9px; font-variant-numeric: tabular-nums; }

    /* PLAYFIELD */
    .drn__stage {
      position: relative;
      width: 100%;
      height: clamp(430px, 66vh, 620px);
      min-height: 430px;
      overflow: hidden;
      border: 2px solid color-mix(in srgb, var(--accent) 28%, #191d30);
      border-radius: 22px;
      background: #091020;
      box-shadow: 0 25px 70px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.05);
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      isolation: isolate;
    }
    .drn__stage::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background:
        linear-gradient(90deg, rgba(0,0,0,.22), transparent 12%, transparent 88%, rgba(0,0,0,.24)),
        repeating-linear-gradient(0deg, rgba(255,255,255,.018) 0 1px, transparent 1px 4px);
      mix-blend-mode: screen;
    }
    .drn__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .drn__beat-rail {
      position: absolute;
      z-index: 4;
      top: 12px;
      left: 50%;
      width: min(220px, 44%);
      height: 5px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
      transform: translateX(-50%);
      pointer-events: none;
    }
    .drn__beat-rail span { border-radius: 999px; background: rgba(255,255,255,.14); transition: background 80ms ease, box-shadow 80ms ease, transform 80ms ease; }
    .drn__beat-rail span.is-active { background: var(--accent); box-shadow: 0 0 14px var(--accent); transform: scaleY(1.45); }
    .drn__progress { position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(255,255,255,.08); pointer-events: none; }
    .drn__progress span { display: block; width: 0%; height: 100%; background: linear-gradient(90deg, var(--accent-soft), var(--accent)); box-shadow: 0 0 14px var(--accent); transition: width 90ms linear; }
    .drn__phrase {
      position: absolute;
      z-index: 4;
      top: 25px;
      left: 50%;
      width: min(330px, 58%);
      display: grid;
      grid-template-columns: repeat(32, 1fr);
      gap: 2px;
      transform: translateX(-50%);
      pointer-events: none;
    }
    .drn__phrase span { height: 3px; border-radius: 999px; background: rgba(255,255,255,.1); transition: background 110ms ease, box-shadow 110ms ease, transform 110ms ease; }
    .drn__phrase span:nth-child(8n + 1) { height: 5px; margin-top: -1px; }
    .drn__phrase span.is-played { background: var(--accent-soft); box-shadow: 0 0 8px color-mix(in srgb, var(--accent-soft) 72%, transparent); }
    .drn__phrase span.is-perfect { background: var(--accent); box-shadow: 0 0 11px var(--accent); }
    .drn__phrase span.is-active { transform: scaleY(1.75); background: #fff; }

    .drn__judge {
      position: absolute;
      z-index: 5;
      left: 50%;
      top: 41px;
      min-height: 22px;
      transform: translateX(-50%);
      color: #fff;
      font: 900 14px/1 'JetBrains Mono', monospace;
      letter-spacing: .24em;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      text-shadow: 0 2px 16px rgba(0,0,0,.75);
    }
    .drn__judge--onbeat,
    .drn__judge--perfect { color: #8fffd1; text-shadow: 0 0 18px rgba(143,255,209,.75); }
    .drn__judge--good { color: #ffd166; text-shadow: 0 0 16px rgba(255,209,102,.55); }
    .drn__judge--offgrid { color: #b7acc9; }
    .drn__judge--clear { color: #7ad7ff; }
    .drn__judge--hit { color: #ff6b86; text-shadow: 0 0 18px rgba(255,107,134,.7); }
    .drn__judge--level { color: var(--accent); }
    .drn__tap-hint {
      position: absolute;
      z-index: 4;
      left: 50%;
      bottom: 16px;
      transform: translateX(-50%);
      color: rgba(255,255,255,.52);
      font: 700 9px/1 'JetBrains Mono', monospace;
      letter-spacing: .17em;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      transition: opacity 180ms ease;
    }
    .drn__tap-hint--gone { opacity: 0; }

    /* LEVEL / RESULT INTERSTITIAL */
    .drn__overlay {
      position: absolute;
      z-index: 8;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 12px clamp(12px, 3vw, 28px);
      background: rgba(3,5,14,.76);
      backdrop-filter: blur(9px) saturate(.8);
      -webkit-backdrop-filter: blur(9px) saturate(.8);
      opacity: 1;
      visibility: visible;
      transition: opacity 230ms ease, visibility 230ms ease;
    }
    .drn__overlay--hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .drn__card {
      position: relative;
      width: min(100%, 650px);
      max-height: 100%;
      overflow: auto;
      display: grid;
      grid-template-columns: minmax(155px, .36fr) minmax(0, .64fr);
      border: 2px solid rgba(255,255,255,.82);
      border-radius: 18px;
      background: #090b16;
      box-shadow: 9px 9px 0 color-mix(in srgb, var(--accent) 78%, #000), 0 28px 80px rgba(0,0,0,.6);
      transform: translateY(0) rotate(-.35deg);
    }
    .drn__postcard {
      min-height: 100%;
      background-position: center 42%;
      background-size: cover;
      border-right: 2px solid rgba(255,255,255,.82);
      filter: saturate(.94) contrast(1.06);
    }
    .drn__postcard::after { content: ''; display: block; width: 100%; height: 100%; background: linear-gradient(180deg, transparent 35%, rgba(7,8,17,.76)); }
    .drn__card-body { min-width: 0; padding: clamp(14px, 2.3vw, 21px); text-align: center; }
    .drn__eyebrow { display: flex; justify-content: space-between; gap: 12px; color: var(--accent); font: 800 9px/1.35 'JetBrains Mono', monospace; letter-spacing: .18em; text-transform: uppercase; }
    .drn__eyebrow span:last-child { color: #9da2b7; text-align: right; }
    .drn__title {
      margin: 13px 0 8px;
      color: #fffaf0;
      font: 950 clamp(26px, 4vw, 44px)/.91 'Inter Tight', 'Inter', sans-serif;
      letter-spacing: -.045em;
      text-transform: uppercase;
      text-shadow: 0 0 34px color-mix(in srgb, var(--accent) 28%, transparent);
    }
    .drn__sub { max-width: 540px; margin: 0 auto; color: #b8b9c7; font-size: clamp(11px, 1.6vw, 14px); line-height: 1.4; }
    .drn__card-stats { margin: 13px 0 12px; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid rgba(255,255,255,.13); border-radius: 12px; overflow: hidden; }
    .drn__card-stats > span { min-width: 0; padding: 8px 5px; display: flex; flex-direction: column; gap: 4px; }
    .drn__card-stats > span + span { border-left: 1px solid rgba(255,255,255,.13); }
    .drn__card-stats small { color: #777d92; font: 700 8px/1 'JetBrains Mono', monospace; letter-spacing: .16em; text-transform: uppercase; }
    .drn__card-stats strong { overflow: hidden; color: #f8f3e8; font: 800 clamp(11px, 2.3vw, 14px)/1.2 'JetBrains Mono', monospace; text-overflow: ellipsis; white-space: nowrap; }
    .drn__route { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; }
    .drn__route li { position: relative; display: grid; justify-items: center; gap: 4px; color: #656a7e; font: 700 8px/1 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
    .drn__route li::before { content: ''; position: absolute; top: 10px; right: 50%; width: 100%; height: 2px; background: #262a3a; z-index: -1; }
    .drn__route li:first-child::before { display: none; }
    .drn__route li span { display: grid; place-items: center; width: 22px; height: 22px; border: 2px solid #373b4e; border-radius: 50%; background: #090b16; color: #777d92; }
    .drn__route li.is-complete::before,
    .drn__route li.is-active::before { background: var(--accent); }
    .drn__route li.is-complete span { border-color: var(--accent); background: var(--accent); color: #050711; }
    .drn__route li.is-active span { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 65%, transparent); }
    .drn__route li.is-active b { color: #f8f3e8; }
    .drn__overlay-best { margin: 11px 0 0; color: #8f94aa; font: 700 9px/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
    .drn__go {
      margin-top: 10px;
      min-height: 44px;
      border: 0;
      border-radius: 12px;
      padding: 12px 20px;
      background: var(--accent);
      color: #060812;
      box-shadow: 0 6px 0 color-mix(in srgb, var(--accent) 48%, #000), 0 0 28px color-mix(in srgb, var(--accent) 26%, transparent);
      cursor: pointer;
      font: 900 12px/1 'JetBrains Mono', monospace;
      letter-spacing: .14em;
      text-transform: uppercase;
      transition: transform 100ms ease, box-shadow 100ms ease, filter 100ms ease;
    }
    .drn__go:hover { filter: brightness(1.12); transform: translateY(-1px); }
    .drn__go:active { transform: translateY(4px); box-shadow: 0 2px 0 color-mix(in srgb, var(--accent) 48%, #000); }
    .drn__go:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
    .drn__input-note { margin: 9px 0 0; color: #676c7f; font: 700 8px/1 'JetBrains Mono', monospace; letter-spacing: .17em; text-transform: uppercase; }

    /* PRIMARY CONTROL */
    .drn__controls { display: flex; justify-content: center; align-items: center; gap: 9px; }
    .drn__jump {
      min-width: 210px;
      min-height: 55px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      border: 1px solid color-mix(in srgb, var(--accent) 62%, transparent);
      border-radius: 999px;
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 18%, #0a0c18), rgba(9,11,22,.95));
      color: var(--accent);
      box-shadow: inset 0 1px rgba(255,255,255,.08), 0 8px 25px rgba(0,0,0,.25);
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .drn__jump-arrow { font: 900 25px/1 'Inter', sans-serif; }
    .drn__jump-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
    .drn__jump-copy strong { font: 900 13px/1 'JetBrains Mono', monospace; letter-spacing: .18em; }
    .drn__jump-copy small { color: #81869b; font: 600 8px/1 'JetBrains Mono', monospace; letter-spacing: .08em; }
    .drn__jump:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 22%, #090b16); }
    .drn__jump:active:not(:disabled) { transform: translateY(2px); }
    .drn__jump:focus-visible { outline: 3px solid #7ad7ff; outline-offset: 3px; }
    .drn__jump:disabled { opacity: .32; cursor: default; }
    .drn__audio {
      min-height: 42px;
      padding: 0 12px;
      border: 1px solid #30364a;
      border-radius: 999px;
      background: #090c17;
      color: #888fa6;
      cursor: pointer;
      font: 700 9px/1 'JetBrains Mono', monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .drn__audio[aria-pressed="true"] { border-color: #6f667d; color: #d3cadf; }
    .drn__audio:focus-visible { outline: 3px solid #7ad7ff; outline-offset: 3px; }
    .drn__versions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; font: 700 9px/1.4 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .09em; }
    .drn__versions span { color: #616679; }
    .drn__versions a { padding: 5px 8px; border: 1px solid #34394d; border-radius: 999px; color: #8b90a4; text-decoration: none; }
    .drn__versions a[aria-current="page"] { border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
    .drn__versions a:hover { border-color: var(--accent); color: var(--accent); }
    .drn__siblings { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 17px; font: 600 11px/1.4 'JetBrains Mono', monospace; }
    .drn__siblings a { color: #9a8b65; text-decoration: none; }
    .drn__siblings a:hover { color: var(--accent); text-decoration: underline; }

    @media (max-width: 600px) {
      .drn { padding: 8px 8px 34px; gap: 8px; }
      .drn__hud { grid-template-columns: 1fr 1.25fr 1fr; gap: 5px; padding-inline: 4px; }
      .drn__score-block { grid-template-columns: 1fr; gap: 2px; }
      .drn__score-label { font-size: 7px; }
      .drn__level-name { font-size: 11px; }
      .drn__level-no, .drn__tempo { font-size: 7px; }
      .drn__flow-line span { display: none; }
      .drn__stage { height: min(69vh, 570px); min-height: 430px; border-radius: 16px; }
      .drn__phrase { width: 72%; }
      .drn__card { display: block; box-shadow: 6px 6px 0 color-mix(in srgb, var(--accent) 78%, #000); }
      .drn__postcard { height: 72px; min-height: 0; border-right: 0; border-bottom: 2px solid rgba(255,255,255,.82); }
      .drn__card-body { padding: 14px; }
      .drn__card-stats { margin-block: 13px; }
      .drn__route li b { font-size: 7px; }
      .drn__go { width: 100%; }
    }
    @media (max-height: 650px) and (orientation: landscape) {
      .drn { max-width: 980px; min-height: auto; }
      .drn__hud { min-height: 40px; }
      .drn__stage { height: 72vh; min-height: 320px; }
      .drn__postcard { display: none; }
      .drn__card-body { padding: 13px 18px; }
      .drn__title { font-size: 28px; margin-block: 8px 5px; }
      .drn__card-stats { margin-block: 9px; }
      .drn__overlay-best, .drn__input-note { display: none; }
      .drn__audio { padding-inline: 10px; }
      .drn__go { margin-top: 9px; min-height: 42px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .drn *, .drn *::before, .drn *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
      .drn__card { transform: none; }
      .drn__stage::after { background: linear-gradient(90deg, rgba(0,0,0,.18), transparent 15%, transparent 85%, rgba(0,0,0,.18)); }
    }
  </style>

  <script>
    import levelData from '../lib/drum-runner-v3-levels.json';
    import { GOOD_WINDOW_MS, JUMP_APEX_PX, JUMP_BEATS, accuracyPercent, gradeBeatDelta, jumpHeightAtBeat, phraseStep, type TimingGrade } from '../lib/drum-runner-music';
    import marineBackdrop from '../assets/drum-runner-v3/marine-layer.webp?url';
    import pierBackdrop from '../assets/drum-runner-v3/el-porto-pier.webp?url';
    import groceryBackdrop from '../assets/drum-runner-v3/grocery-3pm.webp?url';
    import refineryBackdrop from '../assets/drum-runner-v3/refinery-night.webp?url';

    type ObstacleKind = 'cone' | 'crate' | 'tall-crate' | 'barrier' | 'speaker' | 'luggage' | 'hydrant';
    type SceneKind = 'mainstreet' | 'pier' | 'ralphs' | 'refinery';
    type Phase = 'intro' | 'playing' | 'interstitial' | 'gameover' | 'victory';
    type PlayerVoice = 'rim' | 'clap' | 'tom' | 'metal';
    type Grade = TimingGrade | 'miss';
    type Cue = { cueBeat: number; beat: number; kind: ObstacleKind; note: number };
    type MusicConfig = {
      phraseBeats: number;
      subdivision: number;
      swing: number;
      playerVoice: PlayerVoice;
      scale: number[];
      backing: { kick: number[]; snare: number[]; hat: number[] };
      stemUnlocks: { bass: number; harmony: number; counterline: number };
    };
    type Level = {
      id: string;
      number: string;
      name: string;
      kicker: string;
      brief: string;
      clearLine: string;
      scene: SceneKind;
      bpm: number;
      beats: number;
      accent: string;
      accentSoft: string;
      skyTop: string;
      skyBottom: string;
      bass: number[];
      music: MusicConfig;
      obstacles: Cue[];
    };
    type Obstacle = Cue & { cueX: number; ox: number; w: number; h: number; hit: boolean; cleared: boolean; judged: boolean; grade: Grade | null };
    type Runner = { y: number; grounded: boolean; squash: number; cleanTarget: number; jumpStartBeat: number; landingPlayed: boolean };
    type EchoNote = { beat: number; note: number; grade: TimingGrade; played: boolean };
    type MotifNote = { step: number; note: number; grade: TimingGrade };
    type Particle = { x: number; y: number; vx: number; vy: number; life: number; maxLife: number; size: number; color: string; gravity: number };

    const LEVELS = levelData as Level[];
    const BACKDROP_URLS = [marineBackdrop, pierBackdrop, groceryBackdrop, refineryBackdrop];
    const NOUN_POOL = [214, 385, 92, 523, 742, 1042, 287, 612, 928, 1189];
    const KIND_ORDER: ObstacleKind[] = ['cone', 'crate', 'tall-crate', 'barrier', 'speaker', 'luggage', 'hydrant'];
    const DIMS: Record<ObstacleKind, [number, number]> = {
      cone: [26, 32],
      crate: [38, 44],
      'tall-crate': [40, 62],
      barrier: [54, 41],
      speaker: [40, 55],
      luggage: [48, 35],
      hydrant: [30, 45],
    };

    const BEAT_PX = 150;
    const RUNNER_W = 50;
    const RUNNER_H = 56;
    const INVULN_S = 0.58;
    const BEST_KEY = 'pc-drum-runner-v3-best';
    const PROGRESS_KEY = 'pc-drum-runner-v3-progress';
    const MUTED_KEY = 'pc-drum-runner-v3-muted';

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reducedMotion = motionQuery.matches;
    motionQuery.addEventListener?.('change', (event) => { reducedMotion = event.matches; });

    let phase: Phase = 'intro';
    let currentLevelIndex = 0;
    let pendingLevelIndex = 0;
    let worldX = 0;
    let levelStartX = 0;
    let levelEndX = LEVELS[0].beats * BEAT_PX;
    let lives = 3;
    let bonus = 0;
    let flow = 0;
    let bestFlow = 0;
    let totalClears = 0;
    let totalPerfect = 0;
    let totalGood = 0;
    let totalMisses = 0;
    let totalOffgrid = 0;
    let levelClears = 0;
    let levelPerfect = 0;
    let levelGood = 0;
    let levelOffgrid = 0;
    let levelHits = 0;
    let levelStartScore = 0;
    let obstacles: Obstacle[] = [];
    let particles: Particle[] = [];
    let invuln = 0;
    let downFlash = 0;
    let shakeMag = 0;
    let scenerySeed = 1;
    let lastTs = 0;
    let rafId = 0;
    let suspended = false;
    let sessionId = '';
    let savedBest = 0;
    let muted = false;
    let arrangement = 0;
    let duckUntilBeat = 0;
    let transportStartPerf = 0;
    let pausedBeat = 0;
    let nextMusicStep = 0;
    let schedulerTimer = 0;
    let lastInputAt = 0;
    let lastVisualBeat = -1;
    let echoNotes: EchoNote[] = [];
    let campaignMotif: MotifNote[] = [];
    const phraseGrades = new Map<number, TimingGrade>();
    const runner: Runner = { y: 0, grounded: true, squash: 0, cleanTarget: -1, jumpStartBeat: -99, landingPlayed: true };

    function level(): Level { return LEVELS[currentLevelIndex]; }
    function displayScore(): number { return bonus; }
    function currentLevelBeat(): number { return Math.max(0, (worldX - levelStartX) / BEAT_PX); }

    /* ---------------- audio ---------------- */
    let actx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let compressor: DynamicsCompressorNode | null = null;
    const noiseCache = new Map<number, AudioBuffer>();
    function audioContext(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        if (!AC) throw new Error('Web Audio unavailable');
        actx = new AC();
        masterGain = actx.createGain();
        compressor = actx.createDynamicsCompressor();
        compressor.threshold.value = -18;
        compressor.knee.value = 14;
        compressor.ratio.value = 5;
        compressor.attack.value = .004;
        compressor.release.value = .18;
        masterGain.gain.value = muted ? 0 : .72;
        masterGain.connect(compressor).connect(actx.destination);
      }
      if (actx.state === 'suspended') void actx.resume().catch(() => {});
      return actx;
    }
    function audioOutput(): AudioNode {
      audioContext();
      return masterGain!;
    }
    function setMasterLevel(value: number, fast = false) {
      if (!actx || !masterGain) return;
      const now = actx.currentTime;
      masterGain.gain.cancelScheduledValues(now);
      masterGain.gain.setTargetAtTime(muted ? 0 : value, now, fast ? .008 : .035);
    }
    function trySound(action: () => void) {
      try { action(); } catch { /* visual gameplay remains available without Web Audio */ }
    }
    function noiseBuffer(duration: number): AudioBuffer {
      const a = audioContext();
      const key = Math.round(duration * 1000);
      const cached = noiseCache.get(key);
      if (cached) return cached;
      const buffer = a.createBuffer(1, Math.floor(a.sampleRate * duration), a.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
      noiseCache.set(key, buffer);
      return buffer;
    }
    function playKick(time: number, amount = .26) {
      const a = audioContext();
      const oscillator = a.createOscillator();
      const gain = a.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(126, time);
      oscillator.frequency.exponentialRampToValueAtTime(43, time + .16);
      gain.gain.setValueAtTime(amount, time);
      gain.gain.exponentialRampToValueAtTime(.0001, time + .23);
      oscillator.connect(gain).connect(audioOutput());
      oscillator.start(time);
      oscillator.stop(time + .25);
    }
    function playHat(time: number, open = false, amount = 1) {
      const a = audioContext();
      const source = a.createBufferSource();
      const filter = a.createBiquadFilter();
      const gain = a.createGain();
      source.buffer = noiseBuffer(open ? .14 : .05);
      filter.type = 'highpass';
      filter.frequency.value = 7100;
      gain.gain.value = (open ? .065 : .042) * amount;
      source.connect(filter).connect(gain).connect(audioOutput());
      source.start(time);
    }
    function playSnare(time: number, amount = .13) {
      const a = audioContext();
      const source = a.createBufferSource();
      const filter = a.createBiquadFilter();
      const gain = a.createGain();
      source.buffer = noiseBuffer(.2);
      filter.type = 'bandpass';
      filter.frequency.value = 1850;
      filter.Q.value = .8;
      gain.gain.setValueAtTime(.0001, time);
      gain.gain.exponentialRampToValueAtTime(amount, time + .004);
      gain.gain.exponentialRampToValueAtTime(.0001, time + .18);
      source.connect(filter).connect(gain).connect(audioOutput());
      source.start(time);
    }
    function playBass(frequency: number, time: number, amount = .16) {
      const a = audioContext();
      const oscillator = a.createOscillator();
      const filter = a.createBiquadFilter();
      const gain = a.createGain();
      oscillator.type = 'sawtooth';
      oscillator.frequency.setValueAtTime(frequency, time);
      filter.type = 'lowpass';
      filter.frequency.value = 420;
      gain.gain.setValueAtTime(.0001, time);
      gain.gain.exponentialRampToValueAtTime(amount, time + .02);
      gain.gain.exponentialRampToValueAtTime(.0001, time + .44);
      oscillator.connect(filter).connect(gain).connect(audioOutput());
      oscillator.start(time);
      oscillator.stop(time + .48);
    }
    function playSweep(from: number, to: number, duration: number, amount = .13) {
      const a = audioContext();
      const time = a.currentTime + .004;
      const oscillator = a.createOscillator();
      const gain = a.createGain();
      oscillator.type = 'triangle';
      oscillator.frequency.setValueAtTime(from, time);
      oscillator.frequency.exponentialRampToValueAtTime(to, time + duration);
      gain.gain.setValueAtTime(.0001, time);
      gain.gain.exponentialRampToValueAtTime(amount, time + .008);
      gain.gain.exponentialRampToValueAtTime(.0001, time + duration);
      oscillator.connect(gain).connect(audioOutput());
      oscillator.start(time);
      oscillator.stop(time + duration + .02);
    }
    function playLand() { playSweep(170, 72, .13, .07); }
    function playClear() { playSweep(680, 920, .13, .08); }
    function playHurt() { playSweep(185, 56, .4, .2); }
    function playPerfect() {
      const a = audioContext();
      const time = a.currentTime + .004;
      [0, .045].forEach((delay, index) => {
        const oscillator = a.createOscillator();
        const gain = a.createGain();
        oscillator.type = 'triangle';
        oscillator.frequency.value = index === 0 ? 880 : 1320;
        gain.gain.setValueAtTime(.0001, time + delay);
        gain.gain.exponentialRampToValueAtTime(.11, time + delay + .005);
        gain.gain.exponentialRampToValueAtTime(.0001, time + delay + .23);
        oscillator.connect(gain).connect(audioOutput());
        oscillator.start(time + delay);
        oscillator.stop(time + delay + .26);
      });
    }
    function playLevelClear() {
      const a = audioContext();
      const time = a.currentTime + .02;
      [440, 554.37, 659.25, 880].forEach((frequency, index) => {
        const oscillator = a.createOscillator();
        const gain = a.createGain();
        oscillator.type = 'triangle';
        oscillator.frequency.value = frequency;
        const at = time + index * .09;
        gain.gain.setValueAtTime(.0001, at);
        gain.gain.exponentialRampToValueAtTime(.1, at + .01);
        gain.gain.exponentialRampToValueAtTime(.0001, at + .3);
        oscillator.connect(gain).connect(audioOutput());
        oscillator.start(at);
        oscillator.stop(at + .32);
      });
    }
    function playChord(root: number, time: number, amount = .045) {
      const a = audioContext();
      [1, 1.25, 1.5].forEach((ratio) => {
        const oscillator = a.createOscillator();
        const filter = a.createBiquadFilter();
        const gain = a.createGain();
        oscillator.type = 'triangle';
        oscillator.frequency.value = root * 4 * ratio;
        filter.type = 'lowpass';
        filter.frequency.value = 1150;
        gain.gain.setValueAtTime(.0001, time);
        gain.gain.exponentialRampToValueAtTime(amount, time + .025);
        gain.gain.exponentialRampToValueAtTime(.0001, time + .72);
        oscillator.connect(filter).connect(gain).connect(audioOutput());
        oscillator.start(time);
        oscillator.stop(time + .75);
      });
    }
    function playPlayerVoice(voice: PlayerVoice, note: number, grade: TimingGrade, time?: number, echo = false) {
      const a = audioContext();
      const at = time ?? a.currentTime + .004;
      const levelScale = level().music.scale;
      const semitone = levelScale[note % levelScale.length] ?? 0;
      const intensity = (grade === 'perfect' ? 1 : grade === 'good' ? .72 : .34) * (echo ? .32 : 1);
      if (voice === 'clap') {
        playSnare(at, .12 * intensity);
        playHat(at + .018, false, .55 * intensity);
        return;
      }
      const oscillator = a.createOscillator();
      const filter = a.createBiquadFilter();
      const gain = a.createGain();
      const base = voice === 'rim' ? 410 : voice === 'tom' ? 145 : 620;
      oscillator.type = voice === 'metal' ? 'square' : voice === 'tom' ? 'sine' : 'triangle';
      oscillator.frequency.setValueAtTime(base * 2 ** (semitone / 12), at);
      if (voice === 'tom') oscillator.frequency.exponentialRampToValueAtTime(base * .58, at + .2);
      filter.type = voice === 'metal' ? 'bandpass' : 'lowpass';
      filter.frequency.value = voice === 'metal' ? 1850 : voice === 'rim' ? 1700 : 720;
      filter.Q.value = voice === 'metal' ? 5 : .9;
      gain.gain.setValueAtTime(.0001, at);
      gain.gain.exponentialRampToValueAtTime((voice === 'tom' ? .19 : .12) * intensity, at + .004);
      gain.gain.exponentialRampToValueAtTime(.0001, at + (voice === 'metal' ? .32 : .22));
      oscillator.connect(filter).connect(gain).connect(audioOutput());
      oscillator.start(at);
      oscillator.stop(at + .36);
      if (voice === 'metal') playHat(at, true, .55 * intensity);
    }
    function transportBeat(): number {
      const seconds = 60 / level().bpm;
      return Math.max(0, pausedBeat + (performance.now() - transportStartPerf) / 1000 / seconds);
    }
    function stopScheduler() {
      if (schedulerTimer) window.clearInterval(schedulerTimer);
      schedulerTimer = 0;
    }
    function scheduleAhead() {
      if (!actx || actx.state !== 'running' || phase !== 'playing' || suspended) return;
      const cfg = level();
      const seconds = 60 / cfg.bpm;
      const subdivision = cfg.music.subdivision;
      const nowBeat = transportBeat();
      const horizonBeat = nowBeat + .14 / seconds;
      while (nextMusicStep / subdivision <= horizonBeat) {
        const step = nextMusicStep;
        const eventBeat = step / subdivision;
        const patternStep = ((step % 16) + 16) % 16;
        const swingOffset = cfg.music.swing > .5 && step % 2 === 1 ? (cfg.music.swing - .5) * seconds : 0;
        const countInSeconds = Math.max(0, (transportStartPerf - performance.now()) / 1000);
        const secondsUntilEvent = countInSeconds + (eventBeat - nowBeat) * seconds + swingOffset;
        const eventTime = actx.currentTime + Math.max(.005, secondsUntilEvent);
        const mix = eventBeat < duckUntilBeat ? .34 : 1;
        if (secondsUntilEvent >= -.03) {
          if (cfg.music.backing.kick.includes(patternStep)) playKick(eventTime, .24 * mix);
          if (cfg.music.backing.snare.includes(patternStep)) playSnare(eventTime, .12 * mix);
          if (cfg.music.backing.hat.includes(patternStep)) playHat(eventTime, patternStep === 14, mix);
          if (arrangement >= 1 && patternStep % 8 === 0) playBass(cfg.bass[Math.floor(eventBeat / 4) % cfg.bass.length], eventTime, .15 * mix);
          if (arrangement >= 2 && patternStep === 0) playChord(cfg.bass[Math.floor(eventBeat / 4) % cfg.bass.length], eventTime, .04 * mix);
          if (arrangement >= 3 && (patternStep === 3 || patternStep === 11)) {
            const note = patternStep === 3 ? 2 : 4;
            playPlayerVoice(cfg.music.playerVoice, note, 'good', eventTime, true);
          }
          for (const echo of echoNotes) {
            if (!echo.played && Math.abs(echo.beat - eventBeat) < .001) {
              playPlayerVoice(cfg.music.playerVoice, echo.note, echo.grade, eventTime, true);
              echo.played = true;
            }
          }
        }
        nextMusicStep++;
      }
    }
    function startTransport(startBeat = 0) {
      stopScheduler();
      pausedBeat = startBeat;
      transportStartPerf = performance.now() + 80;
      try {
        audioContext();
        setMasterLevel(.72, true);
      } catch { /* the performance clock keeps visual play moving */ }
      nextMusicStep = Math.max(0, Math.ceil(startBeat * level().music.subdivision));
      if (actx) {
        schedulerTimer = window.setInterval(scheduleAhead, 25);
        scheduleAhead();
      }
    }
    function pauseTransport() {
      pausedBeat = Math.min(level().beats, transportBeat());
      stopScheduler();
      setMasterLevel(0, true);
    }
    function resumeTransport() {
      transportStartPerf = performance.now();
      nextMusicStep = Math.ceil(pausedBeat * level().music.subdivision);
      setMasterLevel(.72, true);
      if (actx) {
        schedulerTimer = window.setInterval(scheduleAhead, 25);
        scheduleAhead();
      }
    }

    /* ---------------- shared sound bus ---------------- */
    let lastBroadcast = 0;
    function getOrCreateSession(): string {
      try {
        let id = localStorage.getItem('pc-drum-live-session');
        if (!id) {
          id = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', id);
        }
        return id;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(kind: ObstacleKind) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return;
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: KIND_ORDER.indexOf(kind), sessionId }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    /* ---------------- Noun sprite ---------------- */
    const nounImage = new Image();
    let nounReady = false;
    nounImage.onload = () => { nounReady = true; };
    nounImage.onerror = () => { nounReady = false; };
    function pickNoun() {
      nounReady = false;
      nounImage.src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;
    }

    const backdropImages: Array<HTMLImageElement | null> = BACKDROP_URLS.map(() => null);
    function ensureBackdrop(index: number) {
      if (index < 0 || index >= BACKDROP_URLS.length || backdropImages[index]) return;
      const image = new Image();
      image.onload = () => draw();
      image.src = BACKDROP_URLS[index];
      backdropImages[index] = image;
      void image.decode?.().catch(() => {});
    }

    /* ---------------- canvas & world ---------------- */
    const canvas = document.getElementById('drn-canvas') as HTMLCanvasElement;
    const context = canvas.getContext('2d')!;
    let width = 0;
    let height = 0;
    let dpr = 1;
    function resize() {
      const bounds = canvas.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      context.imageSmoothingEnabled = false;
      draw();
    }
    window.addEventListener('resize', resize);

    function groundY(): number { return height * .79; }
    function runnerScreenX(): number { return Math.min(width * .23, 170); }
    function sceneScroll(factor: number): number { return reducedMotion ? 0 : worldX * factor; }
    function hashAt(value: number): number {
      const raw = Math.sin(value * 127.1 + scenerySeed * 3.3) * 43758.5453;
      return raw - Math.floor(raw);
    }
    function prepareLevel(index: number) {
      currentLevelIndex = index;
      const cfg = level();
      levelStartX = worldX;
      levelEndX = levelStartX + cfg.beats * BEAT_PX;
      obstacles = cfg.obstacles.map((cue) => {
        const [w, h] = DIMS[cue.kind];
        return {
          ...cue,
          cueX: levelStartX + cue.cueBeat * BEAT_PX,
          ox: levelStartX + cue.beat * BEAT_PX,
          w,
          h,
          hit: false,
          cleared: false,
          judged: false,
          grade: null,
        };
      });
      runner.y = 0;
      runner.grounded = true;
      runner.squash = 0;
      runner.cleanTarget = -1;
      runner.jumpStartBeat = -99;
      runner.landingPlayed = true;
      invuln = 0;
      downFlash = 0;
      shakeMag = 0;
      arrangement = 0;
      duckUntilBeat = 0;
      levelClears = 0;
      levelPerfect = 0;
      levelGood = 0;
      levelOffgrid = 0;
      levelHits = 0;
      levelStartScore = displayScore();
      phraseGrades.clear();
      if (index === LEVELS.length - 1) {
        const motifByStep = new Map<number, MotifNote>();
        campaignMotif.forEach((note) => motifByStep.set(note.step, note));
        echoNotes = Array.from(motifByStep.values())
          .sort((a, b) => a.step - b.step)
          .map((note) => ({
            beat: 8 + note.step / cfg.music.subdivision,
            note: note.note,
            grade: note.grade,
            played: false,
          }));
      } else {
        echoNotes = [];
      }
      particles = [];
      ensureBackdrop(index);
      ensureBackdrop(index + 1);
      applyTheme(cfg);
      updateHud();
      draw();
    }

    /* ---------------- particles ---------------- */
    function emitParticles(x: number, y: number, color: string, count: number, force = 1) {
      if (reducedMotion) return;
      for (let index = 0; index < count; index++) {
        const life = .28 + Math.random() * .34;
        particles.push({
          x,
          y,
          vx: (Math.random() - .5) * 150 * force,
          vy: (-35 - Math.random() * 130) * force,
          life,
          maxLife: life,
          size: 2 + Math.random() * 4,
          color,
          gravity: 220 + Math.random() * 180,
        });
      }
      if (particles.length > 90) particles.splice(0, particles.length - 90);
    }
    function updateParticles(dt: number) {
      for (const particle of particles) {
        particle.life -= dt;
        particle.x += particle.vx * dt;
        particle.y += particle.vy * dt;
        particle.vy += particle.gravity * dt;
      }
      particles = particles.filter((particle) => particle.life > 0);
    }
    function drawParticles() {
      for (const particle of particles) {
        context.globalAlpha = Math.max(0, particle.life / particle.maxLife);
        context.fillStyle = particle.color;
        context.fillRect(particle.x, particle.y, particle.size, particle.size);
      }
      context.globalAlpha = 1;
    }

    /* ---------------- gameplay ---------------- */
    function nearestCue(beat: number): Obstacle | undefined {
      return obstacles
        .filter((obstacle) => !obstacle.judged)
        .sort((a, b) => Math.abs(a.cueBeat - beat) - Math.abs(b.cueBeat - beat))[0];
    }
    function refreshArrangement() {
      const accepted = levelPerfect + levelGood;
      const unlocks = level().music.stemUnlocks;
      arrangement = accepted >= unlocks.counterline ? 3 : accepted >= unlocks.harmony ? 2 : accepted >= unlocks.bass ? 1 : 0;
      root.dataset.mix = String(arrangement);
    }
    function jump() {
      if (phase !== 'playing') return;
      const inputNow = performance.now();
      if (inputNow - lastInputAt < 38) return;
      lastInputAt = inputNow;
      const beat = Math.min(level().beats, transportBeat());
      const target = nearestCue(beat);
      const delta = target ? beat - target.cueBeat : Infinity;
      const grade = target ? gradeBeatDelta(delta, level().bpm) : 'offgrid';
      const accepted = target && grade !== 'offgrid';
      const playedNote = target?.note ?? 0;

      if (accepted && target) {
        target.judged = true;
        target.grade = grade;
        runner.cleanTarget = target.ox;
        flow++;
        bestFlow = Math.max(bestFlow, flow);
        if (grade === 'perfect') {
          levelPerfect++;
          totalPerfect++;
          bonus += 100 + Math.min(flow, 8) * 10;
        } else {
          levelGood++;
          totalGood++;
          bonus += 60;
        }
        const step = phraseStep(target.cueBeat, level().music.phraseBeats, level().music.subdivision);
        phraseGrades.set(step, grade);
        if (currentLevelIndex < LEVELS.length - 1) {
          campaignMotif.push({ step, note: target.note, grade });
          if (campaignMotif.length > 32) campaignMotif.splice(0, campaignMotif.length - 32);
        }
        if (target.cueBeat + level().music.phraseBeats < level().beats) {
          echoNotes.push({ beat: target.cueBeat + level().music.phraseBeats, note: target.note, grade, played: false });
        }
        refreshArrangement();
        if (flow % 4 === 0) {
          bonus += 250;
          flashJudge('perfect', `PHRASE ×${flow / 4}`);
        } else {
          flashJudge(grade, grade === 'perfect' ? 'PERFECT' : 'GOOD');
        }
        emitParticles(runnerScreenX(), groundY() - 26, grade === 'perfect' ? level().accent : level().accentSoft, grade === 'perfect' ? 18 : 10, .9);
      } else {
        flow = 0;
        levelOffgrid++;
        totalOffgrid++;
        runner.cleanTarget = -1;
        flashJudge('offgrid', 'OFF GRID');
        emitParticles(runnerScreenX(), groundY() - 12, '#b7acc9', 5, .45);
      }

      trySound(() => playPlayerVoice(level().music.playerVoice, playedNote, accepted ? grade : 'offgrid'));
      if (accepted || runner.grounded) {
        runner.grounded = false;
        runner.jumpStartBeat = beat;
        runner.landingPlayed = false;
      }
      tapHint.classList.add('drn__tap-hint--gone');
      updateHud();
    }
    function update(dt: number) {
      const beat = Math.min(level().beats, transportBeat());
      worldX = Math.min(levelEndX, levelStartX + beat * BEAT_PX);
      const visualBeat = Math.floor(beat);
      if (visualBeat !== lastVisualBeat) {
        lastVisualBeat = visualBeat;
        downFlash = 1;
      }
      if (!runner.grounded) {
        runner.y = jumpHeightAtBeat(beat, runner.jumpStartBeat, JUMP_APEX_PX);
        if (beat >= runner.jumpStartBeat + JUMP_BEATS) {
          runner.y = 0;
          runner.grounded = true;
          runner.squash = 1;
          runner.cleanTarget = -1;
          if (!runner.landingPlayed) trySound(playLand);
          runner.landingPlayed = true;
          emitParticles(runnerScreenX(), groundY(), '#e9d7ad', 6, .48);
        }
      }
      runner.squash = Math.max(0, runner.squash - dt * 6);
      invuln = Math.max(0, invuln - dt);
      downFlash = Math.max(0, downFlash - dt * 4.8);
      shakeMag = Math.max(0, shakeMag - dt * 42);
      updateParticles(dt);

      for (const obstacle of obstacles) {
        const goodWindowBeats = GOOD_WINDOW_MS * level().bpm / 60_000;
        if (!obstacle.judged && beat > obstacle.cueBeat + goodWindowBeats) {
          obstacle.judged = true;
          obstacle.grade = 'miss';
          totalMisses++;
          flow = 0;
          flashJudge('hit', 'MISS');
        }
        if (obstacle.hit || obstacle.cleared) continue;
        const overlap = Math.abs(worldX - obstacle.ox) < (RUNNER_W / 2 + obstacle.w / 2);
        if (overlap && invuln <= 0 && runner.y < obstacle.h - 5) {
          obstacle.hit = true;
          lives--;
          levelHits++;
          invuln = INVULN_S;
          flow = 0;
          duckUntilBeat = beat + 4;
          runner.cleanTarget = -1;
          shakeMag = reducedMotion ? 0 : 10;
          trySound(playHurt);
          emitParticles(runnerScreenX() + 9, groundY() - obstacle.h * .6, '#ff5f7e', 16, 1.15);
          flashJudge('hit', 'CLIPPED');
          updateLives();
          continue;
        }

        if (obstacle.ox + obstacle.w / 2 < worldX - RUNNER_W / 2) {
          obstacle.cleared = true;
          levelClears++;
          totalClears++;
          bonus += 20;
          if (runner.cleanTarget === obstacle.ox) runner.cleanTarget = -1;
          trySound(playClear);
          emitParticles(runnerScreenX() + 23, groundY() - obstacle.h, level().accent, 9, .7);
          flashJudge('clear', obstacle.grade === 'perfect' ? 'CLEAR · POCKET' : 'CLEAR');
          broadcast(obstacle.kind);
        }
      }

      updateHud();
    }

    /* ---------------- scene drawing ---------------- */
    function drawSky(cfg: Level, gy: number) {
      const gradient = context.createLinearGradient(0, 0, 0, gy);
      gradient.addColorStop(0, cfg.skyTop);
      gradient.addColorStop(1, cfg.skyBottom);
      context.fillStyle = gradient;
      context.fillRect(-14, 0, width + 28, height + 14);

      const backdrop = backdropImages[currentLevelIndex];
      if (backdrop?.complete && backdrop.naturalWidth > 0) {
        const scale = Math.max(width / backdrop.naturalWidth, height / backdrop.naturalHeight);
        const drawWidth = backdrop.naturalWidth * scale;
        const drawHeight = backdrop.naturalHeight * scale;
        const focalX = [0.52, 0.54, 0.5, 0.53][currentLevelIndex] ?? .5;
        const drawX = (width - drawWidth) * focalX;
        const drawY = (height - drawHeight) * .5;
        context.imageSmoothingEnabled = true;
        context.drawImage(backdrop, drawX, drawY, drawWidth, drawHeight);
        context.imageSmoothingEnabled = false;
      }

      const orchestration = Math.min(1, arrangement / 3);
      const isDucked = currentLevelBeat() < duckUntilBeat;
      context.fillStyle = `rgba(3,7,18,${Math.max(.1, .48 - orchestration * .27 + (isDucked ? .16 : 0))})`;
      context.fillRect(0, 0, width, height);

      const laneScrim = context.createLinearGradient(0, gy * .67, 0, height);
      laneScrim.addColorStop(0, 'rgba(3,7,18,0)');
      laneScrim.addColorStop(.55, 'rgba(3,7,18,.22)');
      laneScrim.addColorStop(1, 'rgba(3,7,18,.72)');
      context.fillStyle = laneScrim;
      context.fillRect(0, gy * .65, width, height - gy * .65);

      const pulse = context.createRadialGradient(width * .5, gy * .48, 4, width * .5, gy * .48, width * .48);
      pulse.addColorStop(0, cfg.accent);
      pulse.addColorStop(1, 'rgba(0,0,0,0)');
      context.globalAlpha = .09 + downFlash * .16;
      context.fillStyle = pulse;
      context.fillRect(0, 0, width, gy);
      context.globalAlpha = 1;

      if (!reducedMotion && arrangement > 0) {
        context.fillStyle = cfg.accent;
        context.globalAlpha = .12 + arrangement * .05;
        for (let index = 0; index < arrangement * 5; index++) {
          const x = hashAt(index + Math.floor(currentLevelBeat() * 2)) * width;
          const y = hashAt(index + 81) * gy * .68;
          context.fillRect(x, y, index % 3 === 0 ? 3 : 2, 2);
        }
        context.globalAlpha = 1;
      }
    }
    function drawBuildingLayer(scroll: number, color: string, step: number, minHeight: number, maxHeight: number, seedShift: number, windows: string) {
      const gy = groundY();
      const offset = ((scroll % step) + step) % step;
      for (let screenX = -offset - step; screenX < width + step; screenX += step) {
        const index = Math.floor((screenX + scroll) / step) + seedShift;
        const buildingHeight = minHeight + hashAt(index) * (maxHeight - minHeight);
        const buildingWidth = step * (.62 + hashAt(index * 1.7) * .28);
        const left = Math.round(screenX);
        const top = Math.round(gy - buildingHeight);
        context.fillStyle = color;
        context.fillRect(left, top, Math.round(buildingWidth), Math.round(buildingHeight));
        if (hashAt(index * 2.3) > .37) {
          context.fillStyle = windows;
          for (let row = 0; row < 3; row++) {
            const wy = top + 9 + row * 13;
            if (wy > gy - 7) break;
            context.fillRect(left + 6, wy, 4, 3);
            if (buildingWidth > 31) context.fillRect(left + buildingWidth - 11, wy, 4, 3);
          }
        }
      }
    }
    function drawPalm(x: number, baseY: number, scale: number, color: string) {
      context.save();
      context.translate(x, baseY);
      context.scale(scale, scale);
      context.strokeStyle = color;
      context.fillStyle = color;
      context.lineWidth = 5;
      context.beginPath();
      context.moveTo(0, 0);
      context.quadraticCurveTo(-4, -36, 2, -70);
      context.stroke();
      for (let index = 0; index < 7; index++) {
        const angle = (Math.PI * 2 * index) / 7 - Math.PI / 2;
        context.save();
        context.translate(2, -70);
        context.rotate(angle);
        context.beginPath();
        context.moveTo(0, 0);
        context.quadraticCurveTo(13, -5, 26, 1);
        context.quadraticCurveTo(13, 2, 0, 0);
        context.fill();
        context.restore();
      }
      context.restore();
    }
    function drawMainStreet(gy: number) {
      context.fillStyle = 'rgba(37,48,83,.46)';
      context.beginPath();
      context.moveTo(0, gy);
      for (let x = 0; x <= width; x += 52) context.lineTo(x, gy - 58 - hashAt(x * .03) * 60);
      context.lineTo(width, gy);
      context.fill();
      drawBuildingLayer(sceneScroll(.12), '#26304f', 82, 44, 125, 12, 'rgba(255,209,142,.55)');
      drawBuildingLayer(sceneScroll(.28), '#18233e', 64, 28, 86, 49, 'rgba(255,223,174,.64)');
      const scroll = sceneScroll(.42);
      const step = 210;
      const offset = ((scroll % step) + step) % step;
      for (let x = -offset; x < width + step; x += step) drawPalm(x + 55, gy, .82, '#11192d');
    }
    function drawPier(gy: number) {
      const horizon = gy * .58;
      const water = context.createLinearGradient(0, horizon, 0, gy);
      water.addColorStop(0, 'rgba(68,143,180,.48)');
      water.addColorStop(1, 'rgba(7,34,67,.82)');
      context.fillStyle = water;
      context.fillRect(0, horizon, width, gy - horizon);
      context.strokeStyle = 'rgba(173,232,255,.22)';
      context.lineWidth = 1;
      const waveOffset = sceneScroll(.24) % 46;
      for (let y = horizon + 12; y < gy - 9; y += 14) {
        context.beginPath();
        for (let x = -50; x < width + 50; x += 46) {
          context.moveTo(x - waveOffset, y);
          context.quadraticCurveTo(x + 10 - waveOffset, y - 3, x + 22 - waveOffset, y);
        }
        context.stroke();
      }
      context.fillStyle = '#17273d';
      context.fillRect(width * .41, horizon - 7, width * .59, 10);
      for (let x = width * .43; x < width; x += 46) {
        context.fillRect(x, horizon, 5, gy - horizon);
        context.fillStyle = `rgba(122,215,255,${.35 + downFlash * .4})`;
        context.fillRect(x - 1, horizon - 11, 7, 5);
        context.fillStyle = '#17273d';
      }
      const gullScroll = sceneScroll(.07);
      context.strokeStyle = 'rgba(234,244,255,.7)';
      context.lineWidth = 1.5;
      for (let index = 0; index < 4; index++) {
        const x = ((index * 173 - gullScroll) % (width + 80) + width + 80) % (width + 80) - 30;
        const y = 55 + index * 27;
        context.beginPath();
        context.arc(x - 5, y, 6, Math.PI * 1.1, Math.PI * 1.9);
        context.arc(x + 5, y, 6, Math.PI * 1.1, Math.PI * 1.9);
        context.stroke();
      }
    }
    function drawRalphs(gy: number) {
      drawBuildingLayer(sceneScroll(.1), '#251a4a', 94, 48, 118, 92, 'rgba(255,182,96,.55)');
      const storeX = width * .38 - (sceneScroll(.2) % (width + 440));
      for (const shift of [0, width + 440]) {
        const x = storeX + shift;
        context.fillStyle = '#332344';
        context.fillRect(x, gy - 128, 360, 128);
        context.fillStyle = '#f4b24f';
        context.fillRect(x + 24, gy - 105, 142, 33);
        context.fillStyle = '#30152d';
        context.font = '900 18px JetBrains Mono, monospace';
        context.fillText('RALPHS', x + 42, gy - 82);
        context.fillStyle = 'rgba(255,238,191,.75)';
        for (let windowIndex = 0; windowIndex < 7; windowIndex++) context.fillRect(x + 24 + windowIndex * 44, gy - 59, 31, 43);
      }
      const carScroll = sceneScroll(.46);
      const carStep = 190;
      const offset = ((carScroll % carStep) + carStep) % carStep;
      for (let x = -offset - 40; x < width + carStep; x += carStep) {
        context.fillStyle = '#13172d';
        context.fillRect(x, gy - 28, 76, 25);
        context.fillRect(x + 17, gy - 42, 40, 18);
        context.fillStyle = '#7ad7ff';
        context.fillRect(x + 21, gy - 38, 14, 11);
        context.fillStyle = '#080b17';
        context.beginPath(); context.arc(x + 17, gy - 2, 8, 0, Math.PI * 2); context.fill();
        context.beginPath(); context.arc(x + 61, gy - 2, 8, 0, Math.PI * 2); context.fill();
      }
    }
    function drawRefinery(gy: number) {
      const scroll = sceneScroll(.16);
      const step = 230;
      const offset = ((scroll % step) + step) % step;
      for (let x = -offset - step; x < width + step; x += step) {
        const tankHeight = 62 + hashAt(x * .04 + 30) * 34;
        context.fillStyle = '#111b31';
        context.fillRect(x, gy - tankHeight, 118, tankHeight);
        context.beginPath();
        context.ellipse(x + 59, gy - tankHeight, 59, 13, 0, Math.PI, Math.PI * 2);
        context.fill();
        context.strokeStyle = '#273654';
        context.strokeRect(x + 9, gy - tankHeight + 20, 100, tankHeight - 25);
        const stackX = x + 145;
        context.fillStyle = '#0b1327';
        context.fillRect(stackX, gy - 172, 22, 172);
        context.fillStyle = '#303b54';
        for (let band = 0; band < 4; band++) context.fillRect(stackX, gy - 160 + band * 32, 22, 7);
        const flare = context.createRadialGradient(stackX + 11, gy - 182, 1, stackX + 11, gy - 182, 35 + downFlash * 12);
        flare.addColorStop(0, 'rgba(255,242,164,.95)');
        flare.addColorStop(.28, 'rgba(255,125,80,.65)');
        flare.addColorStop(1, 'rgba(255,86,100,0)');
        context.fillStyle = flare;
        context.fillRect(stackX - 30, gy - 225, 82, 82);
      }
      context.strokeStyle = '#263650';
      context.lineWidth = 6;
      context.beginPath();
      context.moveTo(0, gy - 34);
      context.lineTo(width, gy - 34);
      context.stroke();
      context.lineWidth = 2;
      for (let x = 12; x < width; x += 42) {
        context.beginPath();
        context.moveTo(x, gy - 34);
        context.lineTo(x + 20, gy - 4);
        context.stroke();
      }
    }
    function drawGround(gy: number) {
      const cfg = level();
      const ground = context.createLinearGradient(0, gy, 0, height);
      ground.addColorStop(0, '#111522');
      ground.addColorStop(1, '#05070e');
      context.fillStyle = ground;
      context.fillRect(-14, gy, width + 28, height - gy + 14);

      context.strokeStyle = cfg.accent;
      context.globalAlpha = .55 + downFlash * .28;
      context.lineWidth = 2;
      context.beginPath();
      context.moveTo(-12, gy);
      context.lineTo(width + 12, gy);
      context.stroke();
      context.globalAlpha = 1;

      const runnerX = runnerScreenX();
      const firstBeat = Math.floor((worldX - runnerX - levelStartX) / BEAT_PX) - 1;
      for (let beat = firstBeat; ; beat++) {
        const x = runnerX + (levelStartX + beat * BEAT_PX - worldX);
        if (x > width + 30) break;
        if (x < -30) continue;
        const down = ((beat % 4) + 4) % 4 === 0;
        context.strokeStyle = down ? cfg.accent : 'rgba(255,255,255,.13)';
        context.globalAlpha = down ? .3 + downFlash * .42 : .42;
        context.lineWidth = down ? 2 : 1;
        context.beginPath();
        context.moveTo(x, gy);
        context.lineTo(x, height + 10);
        context.stroke();
        if (down) {
          context.fillStyle = cfg.accent;
          context.fillRect(x - 3, gy + 8, 6, 3);
        }
      }
      context.globalAlpha = 1;

      const stripeStep = 92;
      const stripeOffset = ((worldX * 1.2 % stripeStep) + stripeStep) % stripeStep;
      context.fillStyle = 'rgba(255,255,255,.1)';
      for (let x = -stripeOffset; x < width; x += stripeStep) context.fillRect(x, gy + (height - gy) * .58, 38, 3);

      if (!reducedMotion && currentLevelIndex >= 2 && phase === 'playing') {
        context.strokeStyle = `rgba(255,255,255,${.06 + currentLevelIndex * .025})`;
        context.lineWidth = 1;
        for (let index = 0; index < 9; index++) {
          const y = gy + 18 + hashAt(index + Math.floor(worldX / 30)) * (height - gy - 24);
          const length = 22 + hashAt(index + 44) * 58;
          context.beginPath();
          context.moveTo((hashAt(index + 77) * width + worldX * 1.5) % width, y);
          context.lineTo(((hashAt(index + 77) * width + worldX * 1.5) % width) - length, y);
          context.stroke();
        }
      }
    }
    function drawFinishGate(gy: number) {
      const x = runnerScreenX() + (levelEndX - worldX);
      if (x < -60 || x > width + 80) return;
      const cfg = level();
      context.save();
      context.shadowColor = cfg.accent;
      context.shadowBlur = 18;
      context.fillStyle = cfg.accent;
      context.fillRect(x - 24, gy - 92, 7, 92);
      context.fillRect(x + 17, gy - 92, 7, 92);
      context.fillRect(x - 24, gy - 92, 48, 7);
      context.shadowBlur = 0;
      for (let row = 0; row < 5; row++) {
        for (let column = 0; column < 4; column++) {
          context.fillStyle = (row + column) % 2 ? '#080b15' : '#fff7df';
          context.fillRect(x - 20 + column * 10, gy - 85 + row * 8, 10, 8);
        }
      }
      context.restore();
    }
    function drawObstacle(obstacle: Obstacle, x: number, gy: number) {
      const cfg = level();
      context.save();
      context.globalAlpha = obstacle.hit ? .34 : 1;
      context.fillStyle = 'rgba(0,0,0,.34)';
      context.beginPath();
      context.ellipse(x, gy + 3, obstacle.w * .58, 6, 0, 0, Math.PI * 2);
      context.fill();

      if (obstacle.kind === 'cone') {
        context.fillStyle = '#ff7d45';
        context.beginPath();
        context.moveTo(x, gy - obstacle.h);
        context.lineTo(x - obstacle.w / 2, gy);
        context.lineTo(x + obstacle.w / 2, gy);
        context.closePath();
        context.fill();
        context.fillStyle = '#fff1d8';
        context.fillRect(x - obstacle.w / 2 + 4, gy - obstacle.h * .52, obstacle.w - 8, 6);
        context.fillStyle = '#1b1820';
        context.fillRect(x - obstacle.w / 2 - 3, gy - 4, obstacle.w + 6, 5);
      } else if (obstacle.kind === 'crate' || obstacle.kind === 'tall-crate') {
        context.fillStyle = obstacle.kind === 'tall-crate' ? '#9a6ae8' : '#d49a47';
        context.fillRect(x - obstacle.w / 2, gy - obstacle.h, obstacle.w, obstacle.h);
        context.strokeStyle = '#17121d';
        context.lineWidth = 3;
        context.strokeRect(x - obstacle.w / 2 + 1, gy - obstacle.h + 1, obstacle.w - 2, obstacle.h - 2);
        context.beginPath();
        context.moveTo(x - obstacle.w / 2, gy - obstacle.h);
        context.lineTo(x + obstacle.w / 2, gy);
        context.moveTo(x + obstacle.w / 2, gy - obstacle.h);
        context.lineTo(x - obstacle.w / 2, gy);
        context.stroke();
      } else if (obstacle.kind === 'barrier') {
        context.fillStyle = '#f5eee0';
        context.fillRect(x - obstacle.w / 2, gy - obstacle.h, obstacle.w, 23);
        context.save();
        context.beginPath();
        context.rect(x - obstacle.w / 2, gy - obstacle.h, obstacle.w, 23);
        context.clip();
        context.strokeStyle = '#ff5f7e';
        context.lineWidth = 8;
        for (let stripe = -obstacle.w; stripe < obstacle.w * 2; stripe += 18) {
          context.beginPath();
          context.moveTo(x - obstacle.w / 2 + stripe, gy - obstacle.h + 25);
          context.lineTo(x - obstacle.w / 2 + stripe + 18, gy - obstacle.h - 2);
          context.stroke();
        }
        context.restore();
        context.fillStyle = '#ced4dd';
        context.fillRect(x - obstacle.w / 2 + 8, gy - obstacle.h + 22, 5, obstacle.h - 22);
        context.fillRect(x + obstacle.w / 2 - 13, gy - obstacle.h + 22, 5, obstacle.h - 22);
      } else if (obstacle.kind === 'speaker') {
        context.fillStyle = '#141624';
        context.fillRect(x - obstacle.w / 2, gy - obstacle.h, obstacle.w, obstacle.h);
        context.strokeStyle = cfg.accentSoft;
        context.lineWidth = 2;
        context.strokeRect(x - obstacle.w / 2 + 1, gy - obstacle.h + 1, obstacle.w - 2, obstacle.h - 2);
        for (const [cy, radius] of [[gy - obstacle.h + 16, 8], [gy - 17, 12]] as [number, number][]) {
          context.fillStyle = '#070910';
          context.beginPath(); context.arc(x, cy, radius, 0, Math.PI * 2); context.fill();
          context.strokeStyle = cfg.accent;
          context.globalAlpha = .45 + downFlash * .45;
          context.stroke();
          context.globalAlpha = 1;
        }
      } else if (obstacle.kind === 'luggage') {
        context.fillStyle = '#7ad7ff';
        context.fillRect(x - obstacle.w / 2, gy - obstacle.h + 8, obstacle.w, obstacle.h - 8);
        context.strokeStyle = '#101525';
        context.lineWidth = 3;
        context.strokeRect(x - obstacle.w / 2 + 1, gy - obstacle.h + 9, obstacle.w - 2, obstacle.h - 10);
        context.beginPath();
        context.moveTo(x - 7, gy - obstacle.h + 8);
        context.lineTo(x - 7, gy - obstacle.h);
        context.lineTo(x + 7, gy - obstacle.h);
        context.lineTo(x + 7, gy - obstacle.h + 8);
        context.stroke();
        context.fillStyle = '#05070f';
        context.beginPath(); context.arc(x - 13, gy + 1, 5, 0, Math.PI * 2); context.fill();
        context.beginPath(); context.arc(x + 13, gy + 1, 5, 0, Math.PI * 2); context.fill();
      } else {
        context.fillStyle = '#ff5f7e';
        context.fillRect(x - 8, gy - obstacle.h + 9, 16, obstacle.h - 9);
        context.fillRect(x - 14, gy - obstacle.h + 16, 28, 11);
        context.beginPath();
        context.arc(x, gy - obstacle.h + 10, 11, 0, Math.PI * 2);
        context.fill();
        context.fillStyle = '#e9edf5';
        context.fillRect(x - 3, gy - obstacle.h, 6, 8);
        context.fillRect(x - 17, gy - obstacle.h + 19, 6, 5);
        context.fillRect(x + 11, gy - obstacle.h + 19, 6, 5);
      }
      context.restore();
    }
    function drawRunner(gy: number) {
      const x = runnerScreenX();
      const shadowScale = Math.max(.34, 1 - runner.y / 260);
      context.fillStyle = `rgba(0,0,0,${.38 * shadowScale})`;
      context.beginPath();
      context.ellipse(x, gy + 4, RUNNER_W * .47 * shadowScale, 7 * shadowScale, 0, 0, Math.PI * 2);
      context.fill();

      const bob = runner.grounded && !reducedMotion ? Math.sin(worldX * .1) * 2 : 0;
      const squash = runner.squash;
      const runnerWidth = RUNNER_W * (1 + squash * .14);
      const runnerHeight = RUNNER_H * (1 - squash * .2);
      const top = gy - runnerHeight - runner.y + bob;
      const flicker = invuln > 0 && Math.floor(invuln * 22) % 2 === 0;
      if (flicker) return;

      if (runner.cleanTarget >= 0) {
        const glow = context.createRadialGradient(x, top + runnerHeight * .55, 3, x, top + runnerHeight * .55, 50);
        glow.addColorStop(0, `${level().accent}88`);
        glow.addColorStop(1, `${level().accent}00`);
        context.fillStyle = glow;
        context.fillRect(x - 55, top - 20, 110, 110);
      }

      context.save();
      context.translate(x, top + runnerHeight / 2);
      if (!runner.grounded && !reducedMotion) {
        const jumpProgress = Math.max(0, Math.min(1, (currentLevelBeat() - runner.jumpStartBeat) / JUMP_BEATS));
        context.rotate((.5 - jumpProgress) * .42);
      }

      const legPhase = reducedMotion ? 0 : Math.sin(worldX * .16) * 5;
      context.fillStyle = level().accent;
      context.fillRect(-15 + legPhase * .25, runnerHeight / 2 - 9, 9, 13);
      context.fillRect(6 - legPhase * .25, runnerHeight / 2 - 9, 9, 13);

      if (nounReady) {
        context.drawImage(nounImage, -runnerWidth / 2, -runnerHeight / 2, runnerWidth, runnerHeight);
      } else {
        context.fillStyle = '#f4efe3';
        context.fillRect(-runnerWidth / 2, -runnerHeight / 2, runnerWidth, runnerHeight);
        context.fillStyle = '#11131f';
        context.fillRect(-runnerWidth / 2 + 7, -runnerHeight / 2 + 12, 14, 8);
        context.fillRect(runnerWidth / 2 - 21, -runnerHeight / 2 + 12, 14, 8);
        context.fillStyle = level().accent;
        context.fillRect(-runnerWidth / 2 + 10, -runnerHeight / 2 + 14, 5, 4);
        context.fillRect(runnerWidth / 2 - 15, -runnerHeight / 2 + 14, 5, 4);
      }
      context.restore();
    }
    function draw() {
      if (!width || !height) return;
      const cfg = level();
      const gy = groundY();
      context.clearRect(0, 0, width, height);
      context.save();
      if (shakeMag > 0 && !reducedMotion) context.translate((Math.random() - .5) * shakeMag, (Math.random() - .5) * shakeMag * .6);

      drawSky(cfg, gy);
      drawGround(gy);
      drawFinishGate(gy);

      for (const obstacle of obstacles) {
        const x = runnerScreenX() + (obstacle.ox - worldX);
        const cueX = runnerScreenX() + (obstacle.cueX - worldX);
        if (x >= -70 && x <= width + 70) drawObstacle(obstacle, x, gy);
        if (!obstacle.judged && cueX >= -40 && cueX <= width + 40) {
          const beatsAway = Math.abs((obstacle.cueX - worldX) / BEAT_PX);
          const pulse = reducedMotion ? 0 : Math.sin(currentLevelBeat() * Math.PI * 2) * 1.8;
          const cueY = gy - 94;
          context.strokeStyle = `rgba(255,255,255,${Math.max(.16, .5 - beatsAway * .12)})`;
          context.lineWidth = 1;
          context.beginPath();
          context.moveTo(cueX, cueY + 14);
          context.lineTo(x, gy - obstacle.h - 8);
          context.stroke();
          context.shadowColor = cfg.accent;
          context.shadowBlur = 18;
          context.fillStyle = cfg.accent;
          context.beginPath();
          context.arc(cueX, cueY, 9 + pulse, 0, Math.PI * 2);
          context.fill();
          context.shadowBlur = 0;
          context.fillStyle = '#07101d';
          context.beginPath();
          context.arc(cueX, cueY, 3.5, 0, Math.PI * 2);
          context.fill();
          context.fillStyle = 'rgba(255,255,255,.78)';
          context.fillRect(cueX - 1, cueY + 12, 2, 11);
        }
      }

      drawParticles();
      drawRunner(gy);
      context.restore();

      const vignette = context.createRadialGradient(width / 2, height * .46, height * .18, width / 2, height * .5, Math.max(width, height) * .75);
      vignette.addColorStop(0, 'rgba(0,0,0,0)');
      vignette.addColorStop(1, 'rgba(0,0,0,.34)');
      context.fillStyle = vignette;
      context.fillRect(0, 0, width, height);
    }

    /* ---------------- DOM, overlays, persistence ---------------- */
    const root = document.getElementById('drn')!;
    const stage = document.getElementById('drn-stage')!;
    const scoreEl = document.getElementById('drn-score')!;
    const levelNoEl = document.getElementById('drn-level-no')!;
    const levelNameEl = document.getElementById('drn-level-name')!;
    const tempoEl = document.getElementById('drn-tempo')!;
    const flowEl = document.getElementById('drn-flow')!;
    const bestLine = document.getElementById('drn-best-line')!;
    const overlayBest = document.getElementById('drn-best')!;
    const progressEl = document.getElementById('drn-progress') as HTMLElement;
    const overlay = document.getElementById('drn-overlay')!;
    const postcard = document.getElementById('drn-postcard') as HTMLElement;
    const kickerEl = document.getElementById('drn-kicker')!;
    const cardTempoEl = document.getElementById('drn-card-tempo')!;
    const titleEl = document.getElementById('drn-title')!;
    const subEl = document.getElementById('drn-sub')!;
    const goButton = document.getElementById('drn-go') as HTMLButtonElement;
    const jumpButton = document.getElementById('drn-jump') as HTMLButtonElement;
    const audioButton = document.getElementById('drn-audio') as HTMLButtonElement;
    const judgeEl = document.getElementById('drn-judge')!;
    const tapHint = document.getElementById('drn-tap-hint')!;
    const stateLive = document.getElementById('drn-state-live')!;
    const livesLive = document.getElementById('drn-lives-live')!;
    const routeItems = Array.from(document.querySelectorAll<HTMLElement>('[data-route-index]'));
    const lifeEls = Array.from(document.querySelectorAll<HTMLElement>('.drn__life'));
    const beatRail = Array.from(document.querySelectorAll<HTMLElement>('.drn__beat-rail span'));
    const phraseCells = Array.from(document.querySelectorAll<HTMLElement>('.drn__phrase span'));
    const statALabel = document.getElementById('drn-stat-a-label')!;
    const statA = document.getElementById('drn-stat-a')!;
    const statBLabel = document.getElementById('drn-stat-b-label')!;
    const statB = document.getElementById('drn-stat-b')!;
    const statCLabel = document.getElementById('drn-stat-c-label')!;
    const statC = document.getElementById('drn-stat-c')!;

    let judgeTimer = 0;
    function flashJudge(kind: 'onbeat' | 'perfect' | 'good' | 'offgrid' | 'clear' | 'hit' | 'level', text: string) {
      judgeEl.textContent = text;
      judgeEl.className = `drn__judge drn__judge--${kind}`;
      clearTimeout(judgeTimer);
      judgeTimer = window.setTimeout(() => { judgeEl.textContent = ''; }, kind === 'level' ? 820 : 520);
    }
    function applyTheme(cfg: Level) {
      root.style.setProperty('--accent', cfg.accent);
      root.style.setProperty('--accent-soft', cfg.accentSoft);
      root.dataset.scene = cfg.scene;
      root.dataset.mix = String(arrangement);
      postcard.style.backgroundImage = `linear-gradient(180deg, transparent 30%, rgba(7,8,17,.44)), url("${BACKDROP_URLS[LEVELS.indexOf(cfg)]}")`;
      levelNoEl.textContent = `LEVEL ${cfg.number} / 0${LEVELS.length}`;
      levelNameEl.textContent = cfg.name;
      tempoEl.textContent = `${cfg.bpm} BPM`;
    }
    function readBest(): number {
      try {
        const value = Number(localStorage.getItem(BEST_KEY) || 0);
        return Number.isFinite(value) && value > 0 ? Math.floor(value) : 0;
      } catch { return 0; }
    }
    function readCompletedLevel(): number {
      try {
        const saved = JSON.parse(localStorage.getItem(PROGRESS_KEY) || '{}');
        const completed = Number(saved?.completedLevel);
        return Number.isInteger(completed) ? Math.max(-1, Math.min(LEVELS.length - 1, completed)) : -1;
      } catch { return -1; }
    }
    function saveProgress(completedLevel = currentLevelIndex) {
      const score = displayScore();
      savedBest = Math.max(savedBest, score);
      const savedCompletedLevel = Math.max(readCompletedLevel(), completedLevel);
      const judgedTargets = totalPerfect + totalGood + totalMisses;
      try {
        localStorage.setItem(BEST_KEY, String(savedBest));
        localStorage.setItem(PROGRESS_KEY, JSON.stringify({
          best: savedBest,
          completedLevel: savedCompletedLevel,
          perfect: totalPerfect,
          good: totalGood,
          misses: totalMisses,
          offgrid: totalOffgrid,
          accuracy: accuracyPercent(totalPerfect, totalGood, judgedTargets),
          updatedAt: Date.now(),
        }));
      } catch { /* storage is optional */ }
      updateBest();
    }
    function updateBest() {
      const text = savedBest > 0 ? `best ${savedBest} pts` : 'best — pts';
      bestLine.textContent = text;
      overlayBest.textContent = text;
    }
    function updateLives() {
      lifeEls.forEach((element, index) => element.classList.toggle('drn__life--lost', index >= lives));
      livesLive.textContent = `${lives} ${lives === 1 ? 'heart' : 'hearts'} remaining.`;
    }
    function updateRoute(activeIndex: number, allComplete = false) {
      routeItems.forEach((item, index) => {
        item.classList.toggle('is-complete', allComplete || index < activeIndex);
        item.classList.toggle('is-active', !allComplete && index === activeIndex);
      });
    }
    function setStats(aLabel: string, aValue: string, bLabel: string, bValue: string, cLabel: string, cValue: string) {
      statALabel.textContent = aLabel;
      statA.textContent = aValue;
      statBLabel.textContent = bLabel;
      statB.textContent = bValue;
      statCLabel.textContent = cLabel;
      statC.textContent = cValue;
    }
    function updateHud() {
      scoreEl.textContent = String(displayScore());
      flowEl.textContent = flow > 0 ? `×${flow}` : '—';
      const progress = Math.max(0, Math.min(1, (worldX - levelStartX) / Math.max(1, levelEndX - levelStartX)));
      progressEl.style.width = `${progress * 100}%`;
      const beat = Math.floor((worldX - levelStartX) / BEAT_PX);
      const position = ((beat % 4) + 4) % 4;
      beatRail.forEach((cell, index) => cell.classList.toggle('is-active', phase === 'playing' && index === position));
      const phrasePosition = phraseStep(currentLevelBeat(), level().music.phraseBeats, level().music.subdivision);
      phraseCells.forEach((cell, index) => {
        const grade = phraseGrades.get(index);
        cell.classList.toggle('is-played', grade === 'good');
        cell.classList.toggle('is-perfect', grade === 'perfect');
        cell.classList.toggle('is-active', phase === 'playing' && index === phrasePosition);
      });
    }
    function showOverlay(focusButton = true) {
      overlay.classList.remove('drn__overlay--hidden');
      overlay.setAttribute('aria-hidden', 'false');
      jumpButton.disabled = true;
      root.dataset.phase = phase;
      if (focusButton) goButton.focus({ preventScroll: true });
    }
    function hideOverlay() {
      overlay.classList.add('drn__overlay--hidden');
      overlay.setAttribute('aria-hidden', 'true');
      jumpButton.disabled = false;
      root.dataset.phase = phase;
      jumpButton.focus({ preventScroll: true });
    }
    function showIntro() {
      phase = 'intro';
      currentLevelIndex = 0;
      pendingLevelIndex = 0;
      worldX = 0;
      bonus = 0;
      flow = 0;
      prepareLevel(0);
      const cfg = level();
      kickerEl.textContent = 'BEAT RUNNER V3 · PLAY THE CITY';
      cardTempoEl.textContent = '4 LEVELS · 92→128 BPM';
      titleEl.innerHTML = 'YOUR TAP.<br>THE CITY\'S BEAT.';
      subEl.textContent = 'Perform the cue now, clear the street at the apex one beat later, and hear your phrase return through the mix.';
      setStats('route', '4 scenes', 'input', '1 button', 'hearts', '3 total');
      goButton.textContent = '▶ START LEVEL 01';
      updateRoute(0);
      stateLive.textContent = 'Beat Runner v3 ready. Perform each visual cue to sound a note and jump. Four levels, three hearts. Start Level 1.';
      showOverlay(false);
    }

    /* ---------------- phase transitions ---------------- */
    function startCampaign() {
      cancelAnimationFrame(rafId);
      trySound(() => { audioContext(); });
      resize();
      pickNoun();
      worldX = 0;
      lives = 3;
      bonus = 0;
      flow = 0;
      bestFlow = 0;
      totalClears = 0;
      totalPerfect = 0;
      totalGood = 0;
      totalMisses = 0;
      totalOffgrid = 0;
      campaignMotif = [];
      scenerySeed = Math.random() * 1000;
      updateLives();
      startLevel(0);
    }
    function startLevel(index: number) {
      cancelAnimationFrame(rafId);
      currentLevelIndex = index;
      pendingLevelIndex = index;
      prepareLevel(index);
      phase = 'playing';
      lastVisualBeat = -1;
      startTransport(0);
      tapHint.classList.toggle('drn__tap-hint--gone', index > 0);
      judgeEl.textContent = '';
      hideOverlay();
      flashJudge('level', `LEVEL ${level().number}`);
      stateLive.textContent = `Level ${index + 1} of ${LEVELS.length}, ${level().name}, ${level().bpm} BPM. Perform beat and jump control focused.`;
      lastTs = performance.now();
      suspended = false;
      rafId = requestAnimationFrame(frame);
    }
    function completeLevel() {
      if (phase !== 'playing') return;
      cancelAnimationFrame(rafId);
      stopScheduler();
      const completedIndex = currentLevelIndex;
      const completed = level();
      const healed = levelHits === 0 && lives < 3;
      if (healed) lives++;
      updateLives();
      saveProgress(completedIndex);
      trySound(playLevelClear);
      trySound(() => {
        const a = audioContext();
        const accepted = obstacles.filter((item) => item.grade === 'perfect' || item.grade === 'good').slice(0, 4);
        accepted.forEach((item, index) => playPlayerVoice(completed.music.playerVoice, item.note, item.grade as TimingGrade, a.currentTime + .18 + index * (60 / completed.bpm)));
      });

      if (completedIndex === LEVELS.length - 1) {
        phase = 'victory';
        kickerEl.textContent = 'CITY PERFORMED · FOUR SCENES';
        cardTempoEl.textContent = `${totalPerfect} PERFECT · ${totalGood} GOOD`;
        titleEl.textContent = 'THE CITY PLAYS BACK.';
        subEl.textContent = `${completed.clearLine} You carried a phrase from Main Street to the night shift${healed ? ' — flawless finish restored a heart.' : '.'}`;
        const allTargets = LEVELS.reduce((sum, item) => sum + item.obstacles.length, 0);
        setStats('score', `${displayScore()} pts`, 'accuracy', `${accuracyPercent(totalPerfect, totalGood, allTargets)}%`, 'best pocket', bestFlow > 0 ? `×${bestFlow}` : '—');
        goButton.textContent = '▶ RUN THE CITY AGAIN';
        updateRoute(LEVELS.length, true);
        stateLive.textContent = `City cleared. Final score ${displayScore()} points. ${totalPerfect} perfect and ${totalGood} good performances. Best pocket ${bestFlow}.`;
        showOverlay();
        return;
      }

      phase = 'interstitial';
      pendingLevelIndex = completedIndex + 1;
      const next = LEVELS[pendingLevelIndex];
      applyTheme(next);
      kickerEl.textContent = `LEVEL ${completed.number} CLEAR · ${completed.clearLine}`;
      cardTempoEl.textContent = `NEXT · ${next.bpm} BPM`;
      titleEl.textContent = next.name;
      subEl.textContent = `${next.brief}${healed ? ' Flawless level: one heart restored.' : ''}`;
      setStats('level score', `+${displayScore() - levelStartScore} pts`, 'accuracy', `${accuracyPercent(levelPerfect, levelGood, completed.obstacles.length)}%`, 'mix', `${arrangement}/3 stems`);
      goButton.textContent = `▶ LEVEL ${next.number} · ${next.bpm} BPM`;
      updateRoute(pendingLevelIndex);
      stateLive.textContent = `Level ${completed.number} clear. ${levelPerfect} perfect and ${levelGood} good performances. Next: ${next.name}, ${next.bpm} BPM.`;
      showOverlay();
    }
    function endRun() {
      if (phase !== 'playing') return;
      cancelAnimationFrame(rafId);
      stopScheduler();
      phase = 'gameover';
      saveProgress(currentLevelIndex - 1);
      const cfg = level();
      kickerEl.textContent = `WIPEOUT · LEVEL ${cfg.number} / 0${LEVELS.length}`;
      cardTempoEl.textContent = `${cfg.name.toUpperCase()} · ${cfg.bpm} BPM`;
      titleEl.textContent = 'BEAT DROPPED.';
      subEl.textContent = `The city keeps moving. Your route reached ${cfg.name}; run it back and leave the empty beats alone.`;
      setStats('score', `${displayScore()} pts`, 'accuracy', `${accuracyPercent(totalPerfect, totalGood, totalPerfect + totalGood + totalMisses)}%`, 'best pocket', bestFlow > 0 ? `×${bestFlow}` : '—');
      goButton.textContent = '▶ RUN IT BACK';
      updateRoute(currentLevelIndex);
      stateLive.textContent = `Wipeout on Level ${currentLevelIndex + 1}. Score ${displayScore()} points. Start to run again.`;
      showOverlay();
    }

    function frame(timestamp: number) {
      if (phase !== 'playing' || suspended) return;
      const dt = Math.min((timestamp - lastTs) / 1000, .05);
      lastTs = timestamp;
      update(dt);
      draw();
      if (lives <= 0) { endRun(); return; }
      if (worldX >= levelEndX) { completeLevel(); return; }
      rafId = requestAnimationFrame(frame);
    }

    /* ---------------- input ---------------- */
    function activatePrimary() {
      if (phase === 'playing') jump();
      else if (phase === 'interstitial') startLevel(pendingLevelIndex);
      else startCampaign();
    }
    goButton.addEventListener('click', (event) => {
      event.stopPropagation();
      activatePrimary();
    });
    stage.addEventListener('pointerdown', (event) => {
      if (phase !== 'playing') return;
      if (!event.isPrimary) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      event.preventDefault();
      jump();
    });
    jumpButton.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      event.preventDefault();
      jump();
    });
    jumpButton.addEventListener('click', (event) => {
      if (event.detail === 0) jump();
    });
    jumpButton.addEventListener('keydown', (event) => {
      if (event.repeat) {
        event.preventDefault();
        return;
      }
      if (event.key === 'ArrowUp' || event.key === 'w' || event.key === 'W') {
        event.preventDefault();
        jump();
      }
    });
    window.addEventListener('keydown', (event) => {
      const tag = (event.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || tag === 'button' || tag === 'a') return;
      if (event.code === 'Space' || event.key === 'ArrowUp' || event.key === 'w' || event.key === 'W') {
        event.preventDefault();
        if (event.repeat) return;
        activatePrimary();
      }
    });
    function updateAudioButton() {
      audioButton.setAttribute('aria-pressed', String(muted));
      audioButton.textContent = muted ? 'sound off' : 'sound on';
      audioButton.setAttribute('aria-label', 'Beat Runner audio muted');
    }
    audioButton.addEventListener('click', (event) => {
      event.stopPropagation();
      muted = !muted;
      try { localStorage.setItem(MUTED_KEY, muted ? '1' : '0'); } catch { /* optional */ }
      updateAudioButton();
      setMasterLevel(.72, true);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && phase === 'playing') {
        suspended = true;
        cancelAnimationFrame(rafId);
        pauseTransport();
      } else if (!document.hidden && suspended && phase === 'playing') {
        suspended = false;
        resumeTransport();
        lastTs = performance.now();
        rafId = requestAnimationFrame(frame);
      }
    });

    /* ---------------- init ---------------- */
    sessionId = getOrCreateSession();
    try { muted = localStorage.getItem(MUTED_KEY) === '1'; } catch { muted = false; }
    savedBest = readBest();
    updateAudioButton();
    updateBest();
    updateLives();
    pickNoun();
    resize();
    showIntro();
  </script>
</BlockLayout>
