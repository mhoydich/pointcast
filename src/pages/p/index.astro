---
import BaseLayout from '../../layouts/BaseLayout.astro';
import contracts from '../../data/contracts.json';
import { isProfileContractConfigured, listProfilePages } from '../../lib/profile-object.mjs';

const contract = contracts.profile_objects.mainnet;
const configured = isProfileContractConfigured(contract);
const profiles = configured ? await listProfilePages(contract) : [];
---

<BaseLayout title="Profile objects" description="Owned PointCast profile objects, read from Tezos mainnet." hideAds>
  <main class="profile-index">
    <p class="profile-index__kicker">PROFILE OBJECTS · OWNED LANE</p>
    <h1>Handles you can hold.</h1>
    <p>An owned profile can be edited by its current owner and transferred. Attested seals stay with the neighbor they were issued to.</p>
    {!configured ? (
      <aside><strong>Compiled, not originated.</strong> The public shelf opens after the paused contract has a mainnet address.</aside>
    ) : profiles.length === 0 ? (
      <aside><strong>No claimed handles yet.</strong> The contract exists, but its shelf is empty.</aside>
    ) : (
      <ol>{profiles.map((profile) => <li><a href={`/p/${profile.handle}`}>@{profile.handle}</a><span>token {profile.tokenId}</span></li>)}</ol>
    )}
    <a class="profile-index__door" href="/me">Claim your handle →</a>
  </main>
</BaseLayout>

<style>
  .profile-index { width: min(880px, calc(100vw - 24px)); margin: 0 auto; padding: 46px 0 100px; }
  .profile-index__kicker, aside, li span, .profile-index__door { font: 500 10px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .profile-index__kicker { color: #185fa5; } h1 { margin: 8px 0 16px; font-size: clamp(50px, 9vw, 110px); line-height: .88; letter-spacing: -.06em; font-weight: 500; }
  .profile-index > p:not(.profile-index__kicker) { max-width: 54ch; font-size: 20px; line-height: 1.45; }
  aside { margin: 32px 0; padding: 18px; border: 1.5px solid #185fa5; background: #f3f8fc; } aside strong { display: block; margin-bottom: 6px; color: #185fa5; }
  ol { margin: 32px 0; padding: 0; border-top: 1.5px solid #185fa5; list-style: none; } li { display: flex; justify-content: space-between; gap: 20px; padding: 12px; border: 1.5px solid #185fa5; border-top: 0; } li a { color: #185fa5; font-size: 18px; } li span { align-self: center; }
  .profile-index__door { display: inline-block; padding: 13px 15px; background: #185fa5; color: white; }
</style>
