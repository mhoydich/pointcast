---
import BaseLayout from '../../layouts/BaseLayout.astro';
import contracts from '../../data/contracts.json';
import { listOwnerKennelDogs, listOwnerSeals, listProfilePages } from '../../lib/profile-object.mjs';

export async function getStaticPaths() {
  const profiles = await listProfilePages(contracts.profile_objects.mainnet);
  const enriched = await Promise.all(profiles.map(async (profile) => ({
    ...profile,
    dogs: await listOwnerKennelDogs(profile.owner, contracts.kennel_club.mainnet).catch(() => []),
    seals: await listOwnerSeals(profile.owner, contracts.seal_soulbound.mainnet).catch(() => []),
  })));
  return enriched.flatMap((profile) => [profile.handle, `@${profile.handle}`].map((handle) => ({
    params: { handle },
    props: { profile },
  })));
}

const { profile } = Astro.props;
const title = `@${profile.handle}`;
const description = profile.page.bio || `Owned PointCast profile object @${profile.handle}.`;
const ownerShort = `${profile.owner.slice(0, 7)}…${profile.owner.slice(-5)}`;
const ipfs = (value: string) => value.startsWith('ipfs://') ? `https://ipfs.io/ipfs/${value.slice(7).replace(/^ipfs\//, '')}` : value;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': profile.url,
  url: profile.url,
  mainEntity: {
    '@type': 'Person',
    name: profile.page.name || `@${profile.handle}`,
    identifier: profile.owner,
    description,
    image: profile.noun,
    sameAs: profile.links.filter((link: { url: string }) => link.url).map((link: { url: string }) => link.url),
  },
};
---

<BaseLayout title={title} description={description} image={`/p/og/${profile.handle}.svg`} hideAds>
  <main class="profile-object" data-profile-object>
    <nav aria-label="Profile object breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/p">Profiles</a><span>/</span><strong>@{profile.handle}</strong>
      <a class="profile-object__json" href={`/p/${profile.handle}.json`}>JSON</a>
    </nav>

    <article>
      <header>
        <p>PROFILE OBJECT · TOKEN {profile.tokenId} · OWNED</p>
        <h1>{profile.page.name || `@${profile.handle}`}</h1>
        <span>@{profile.handle}</span>
      </header>
      <figure>
        <img src={profile.noun} alt={`Noun ${profile.page.nounSeed} for @${profile.handle}`} width="512" height="512" />
        <figcaption>NOUN SEED {profile.page.nounSeed}</figcaption>
      </figure>
      <section class="profile-object__page">
        <p>{profile.page.bio || 'This owner has not written a bio yet.'}</p>
        {profile.links.length > 0 && (
          <ul class="profile-object__links">
            {profile.links.map((link: { label: string; url: string }) => (
              <li>{link.url ? <a href={link.url} rel="me noopener">{link.label || link.url}</a> : <span>{link.label}</span>}</li>
            ))}
          </ul>
        )}
      </section>
    </article>

    <section class="profile-object__holdings">
      <header><p>PUBLIC CHAIN SHELF</p><h2>Dogs + seals</h2></header>
      <div class="profile-object__shelf">
        <div>
          <h3>Kennel Club dogs</h3>
          {profile.dogs.length ? <ul class="profile-object__dogs">{profile.dogs.map((dog: any) => <li><a href={dog.objktUrl} rel="noopener"><img src={ipfs(dog.image)} alt={dog.name} width="96" height="120" /><span>{dog.name}</span></a></li>)}</ul> : <p>None held by this owner.</p>}
        </div>
        <div>
          <h3>Soulbound seals</h3>
          {profile.seals.length ? <ul class="profile-object__seals">{profile.seals.map((seal: any) => <li class:list={{ revoked: seal.revoked }}><a href={seal.tzktUrl} rel="noopener"><strong>{seal.kind}</strong><span>{seal.evidence || 'On-chain attestation'}</span><small>{seal.revoked ? 'revoked' : `issued ${seal.issuedAt.slice(0, 10)}`}</small></a></li>)}</ul> : <p>None held by this owner.</p>}
        </div>
      </div>
    </section>

    <footer>
      <dl>
        <div><dt>Owner</dt><dd><a href={`https://tzkt.io/${profile.owner}`} rel="noopener">{ownerShort}</a></dd></div>
        <div><dt>Object</dt><dd><a href={`https://tzkt.io/${profile.contract}/tokens/${profile.tokenId}`} rel="noopener">{profile.contract.slice(0, 8)}…</a></dd></div>
        <div><dt>Rights</dt><dd>Tradeable · owner edits</dd></div>
        <div><dt>Source</dt><dd>{profile.source}</dd></div>
      </dl>
      <p>The profile object can move. Attested seals do not move with it.</p>
    </footer>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </main>
</BaseLayout>

<style>
  .profile-object { --profile-blue: #185fa5; width: min(980px, calc(100vw - 24px)); margin: 0 auto; padding: 18px 0 90px; }
  nav, header p, figcaption, dt, dd, footer p, h3, small { font-family: var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }
  nav { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 0; border-bottom: 2px solid var(--profile-blue); font-size: 10px; }
  nav strong { font-weight: 500; } .profile-object__json { margin-left: auto; }
  article { display: grid; grid-template-columns: minmax(250px, .8fr) minmax(0, 1.2fr); border: 1.5px solid var(--profile-blue); border-top: 0; background: color-mix(in srgb, var(--profile-blue), white 96%); }
  article > header { grid-column: 1 / -1; padding: 18px; border-bottom: 1.5px solid var(--profile-blue); }
  header p, header span { margin: 0; color: var(--profile-blue); font: 500 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 8px 0 4px; font-size: clamp(44px, 8vw, 94px); font-weight: 500; line-height: .9; letter-spacing: -.06em; overflow-wrap: anywhere; }
  figure { margin: 0; padding: 16px; border-right: 1.5px solid var(--profile-blue); background: var(--profile-blue); }
  figure img { display: block; width: 100%; height: auto; background: #fff; }
  figcaption { margin-top: 10px; color: white; font-size: 9px; }
  .profile-object__page { padding: clamp(22px, 5vw, 54px); align-self: stretch; }
  .profile-object__page > p { margin: 0 0 28px; max-width: 56ch; font-size: clamp(18px, 2.4vw, 27px); line-height: 1.35; }
  ul { margin: 0; padding: 0; list-style: none; }
  .profile-object__links { display: grid; gap: 8px; }
  .profile-object__links li { border: 1.5px solid var(--profile-blue); background: white; }
  .profile-object__links li a, .profile-object__links li span { display: block; padding: 12px 14px; overflow-wrap: anywhere; }
  .profile-object__links li a { color: var(--profile-blue); }
  .profile-object__holdings { border: 1.5px solid var(--profile-blue); border-top: 0; }
  .profile-object__holdings > header { padding: 16px; border-bottom: 1px solid var(--profile-blue); }
  .profile-object__holdings h2 { margin: 4px 0 0; font-size: 34px; }
  .profile-object__shelf { display: grid; grid-template-columns: 1fr 1fr; }
  .profile-object__shelf > div { min-width: 0; padding: 16px; }
  .profile-object__shelf > div:first-child { border-right: 1px solid var(--profile-blue); }
  h3 { margin: 0 0 12px; color: var(--profile-blue); font-size: 10px; }
  .profile-object__dogs { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
  .profile-object__dogs a { display: grid; gap: 6px; color: inherit; font-size: 11px; }
  .profile-object__dogs img { width: 100%; aspect-ratio: 4/5; object-fit: cover; background: #e8e4dc; }
  .profile-object__seals { display: grid; gap: 7px; }
  .profile-object__seals li { border: 1px solid #856ab0; background: #fbf8ff; }
  .profile-object__seals li.revoked { opacity: .55; }
  .profile-object__seals a { display: grid; gap: 4px; padding: 10px; color: inherit; }
  .profile-object__seals strong { color: #5b398c; text-transform: capitalize; }
  .profile-object__seals span { font-size: 11px; }
  .profile-object__seals small { color: #7152a4; font-size: 8px; }
  footer { border: 1.5px solid var(--profile-blue); border-top: 0; }
  dl { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
  dl div { min-width: 0; padding: 12px; border-right: 1px solid var(--profile-blue); } dl div:last-child { border-right: 0; }
  dt { color: var(--profile-blue); font-size: 8px; } dd { margin: 4px 0 0; font-size: 9px; overflow-wrap: anywhere; }
  footer p { margin: 0; padding: 12px; border-top: 1px solid var(--profile-blue); font-size: 9px; }
  @media (max-width: 700px) { article, .profile-object__shelf { grid-template-columns: 1fr; } figure, .profile-object__shelf > div:first-child { border-right: 0; border-bottom: 1.5px solid var(--profile-blue); } dl { grid-template-columns: 1fr 1fr; } dl div:nth-child(2) { border-right: 0; } dl div:nth-child(-n+2) { border-bottom: 1px solid var(--profile-blue); } }
</style>
