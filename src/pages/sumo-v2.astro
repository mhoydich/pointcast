---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Nouns Sumo · Two-Player | PointCast';
const description = 'A soft-room couch sumo game for two people, one keyboard or one phone, and a pair of Nouns on the rope.';
---

<BaseLayout title={title} description={description}>
  <main class="sumo-room" data-sumo-v2-room>
    <section class="sumo-shell" aria-labelledby="sumo-title">
      <header class="sumo-header">
        <div class="header-topline">
          <p class="eyebrow">pointcast room</p>
          <button class="sound-toggle" type="button" aria-pressed="false" aria-label="Sound on" data-sound-toggle>🔊</button>
        </div>
        <h1 id="sumo-title">Nouns Sumo · V2 · Two-Player</h1>
        <p class="lede">
          Player 1: hold A · Player 2: hold L · release in the green to push. On a phone, hold your half of the dohyō.
        </p>
      </header>

      <section class="score-strip" aria-label="match score">
        <article class="score-card player-card">
          <div class="score-topline">
            <span class="label">player 1 · east</span>
            <span class="hotkey">A</span>
          </div>
          <strong data-p1-seed>seed --</strong>
          <div class="win-dots" aria-label="Player 1 round wins" data-p1-wins>
            <span></span><span></span><span></span>
          </div>
        </article>

        <div class="round-card">
          <span data-round-label>Round 1 · best of 5</span>
          <strong data-match-state>Hakkeyoi</strong>
        </div>

        <article class="score-card opponent-card">
          <div class="score-topline">
            <span class="label">player 2 · west</span>
            <span class="hotkey">L</span>
          </div>
          <strong data-p2-seed>seed --</strong>
          <div class="win-dots" aria-label="Player 2 round wins" data-p2-wins>
            <span></span><span></span><span></span>
          </div>
        </article>
      </section>

      <p class="announcer" aria-live="polite" data-announcer>
        Hakkeyoi! Hold A and L, then release in the green.
      </p>

      <section class="dohyo-wrap" aria-label="Nouns sumo ring">
        <div class="dohyo" data-dohyo>
          <div class="ring-shadow"></div>
          <div class="ring-rope"></div>
          <div class="ring-sand"></div>
          <div class="ring-center"></div>

          <div class="touch-zone touch-zone-left" role="button" aria-label="Player 1 touch zone" data-touch-zone="p1">
            <span>P1 · hold</span>
          </div>
          <div class="touch-zone touch-zone-right" role="button" aria-label="Player 2 touch zone" data-touch-zone="p2">
            <span>P2 · hold</span>
          </div>

          <div class="sand-puff sand-puff-left" aria-hidden="true" data-puff-p1></div>
          <div class="sand-puff sand-puff-right" aria-hidden="true" data-puff-p2></div>

          <img
            class="fighter fighter-east"
            data-p1-fighter
            data-state="idle"
            src="https://noun.pics/0.svg"
            alt="Player 1 Noun fighter"
            width="160"
            height="160"
          />
          <img
            class="fighter fighter-west"
            data-p2-fighter
            data-state="idle"
            src="https://noun.pics/1.svg"
            alt="Player 2 Noun fighter"
            width="160"
            height="160"
          />
        </div>
      </section>

      <section class="meters" aria-label="charge meters">
        <article class="meter-block meter-east">
          <div class="meter-label">
            <span>Player 1 charge · hold A</span>
            <strong data-p1-charge-label>0%</strong>
          </div>
          <div class="meter" aria-hidden="true">
            <div class="meter-bands">
              <span class="meter-band band-yellow"></span>
              <span class="meter-band band-green"></span>
              <span class="meter-band band-red"></span>
            </div>
            <span class="meter-fill" data-p1-meter></span>
          </div>
          <div class="band-legend" aria-hidden="true">
            <span>weak</span><span>sweet</span><span>stumble</span>
          </div>
        </article>

        <article class="meter-block meter-west">
          <div class="meter-label">
            <span>Player 2 charge · hold L</span>
            <strong data-p2-charge-label>0%</strong>
          </div>
          <div class="meter" aria-hidden="true">
            <div class="meter-bands">
              <span class="meter-band band-yellow"></span>
              <span class="meter-band band-green"></span>
              <span class="meter-band band-red"></span>
            </div>
            <span class="meter-fill" data-p2-meter></span>
          </div>
          <div class="band-legend" aria-hidden="true">
            <span>weak</span><span>sweet</span><span>stumble</span>
          </div>
        </article>
      </section>

      <section class="stat-sheet" data-stat-sheet hidden aria-label="match stat sheet">
        <div class="stat-heading">
          <p class="eyebrow">match sheet</p>
          <h2 data-result-title>East wins the match</h2>
        </div>

        <div class="stats-grid">
          <article class="stat-card">
            <h3>Player 1</h3>
            <dl>
              <div><dt>clashes</dt><dd data-p1-stat-clashes>0</dd></div>
              <div><dt>sweet spot</dt><dd data-p1-stat-sweet>0%</dd></div>
              <div><dt>stumbles</dt><dd data-p1-stat-stumbles>0</dd></div>
              <div><dt>peak charge</dt><dd data-p1-stat-peak>0%</dd></div>
            </dl>
          </article>

          <article class="stat-card">
            <h3>Player 2</h3>
            <dl>
              <div><dt>clashes</dt><dd data-p2-stat-clashes>0</dd></div>
              <div><dt>sweet spot</dt><dd data-p2-stat-sweet>0%</dd></div>
              <div><dt>stumbles</dt><dd data-p2-stat-stumbles>0</dd></div>
              <div><dt>peak charge</dt><dd data-p2-stat-peak>0%</dd></div>
            </dl>
          </article>
        </div>

        <div class="match-actions">
          <button type="button" data-rematch>REMATCH</button>
          <button type="button" data-swap-nouns>SWAP NOUNS</button>
          <button type="button" data-copy-result>COPY RESULT</button>
        </div>
      </section>

      <footer class="sumo-footer">
        <a class="quiet-link" href="/reads/sumo">read the companion note</a>
        <a class="quiet-link" href="/sumo/">play v1 (vs cpu)</a>
      </footer>
    </section>
  </main>

  <script is:inline>
    (() => {
      const room = document.querySelector('[data-sumo-v2-room]');
      if (!room) return;

      const els = {
        p1Seed: room.querySelector('[data-p1-seed]'),
        p2Seed: room.querySelector('[data-p2-seed]'),
        p1Wins: room.querySelector('[data-p1-wins]'),
        p2Wins: room.querySelector('[data-p2-wins]'),
        roundLabel: room.querySelector('[data-round-label]'),
        matchState: room.querySelector('[data-match-state]'),
        announcer: room.querySelector('[data-announcer]'),
        dohyo: room.querySelector('[data-dohyo]'),
        soundToggle: room.querySelector('[data-sound-toggle]'),
        p1Fighter: room.querySelector('[data-p1-fighter]'),
        p2Fighter: room.querySelector('[data-p2-fighter]'),
        p1Meter: room.querySelector('[data-p1-meter]'),
        p2Meter: room.querySelector('[data-p2-meter]'),
        p1ChargeLabel: room.querySelector('[data-p1-charge-label]'),
        p2ChargeLabel: room.querySelector('[data-p2-charge-label]'),
        p1Touch: room.querySelector('[data-touch-zone="p1"]'),
        p2Touch: room.querySelector('[data-touch-zone="p2"]'),
        p1Puff: room.querySelector('[data-puff-p1]'),
        p2Puff: room.querySelector('[data-puff-p2]'),
        statSheet: room.querySelector('[data-stat-sheet]'),
        resultTitle: room.querySelector('[data-result-title]'),
        rematch: room.querySelector('[data-rematch]'),
        swapNouns: room.querySelector('[data-swap-nouns]'),
        copyResult: room.querySelector('[data-copy-result]'),
        p1StatClashes: room.querySelector('[data-p1-stat-clashes]'),
        p1StatSweet: room.querySelector('[data-p1-stat-sweet]'),
        p1StatStumbles: room.querySelector('[data-p1-stat-stumbles]'),
        p1StatPeak: room.querySelector('[data-p1-stat-peak]'),
        p2StatClashes: room.querySelector('[data-p2-stat-clashes]'),
        p2StatSweet: room.querySelector('[data-p2-stat-sweet]'),
        p2StatStumbles: room.querySelector('[data-p2-stat-stumbles]'),
        p2StatPeak: room.querySelector('[data-p2-stat-peak]'),
      };

      const CHARGE_MAX = 115;
      const CHARGE_MS_TO_100 = 1600;
      const SWEET_MIN = 60;
      const OVERSHOOT_MIN = 95;
      const EDGE = 38;
      const DANGER_X = EDGE - 6;
      const START_OFFSET = 14;
      const COMMIT_WINDOW = 190;
      const SHIKIRI_MS = 900;
      const FALSE_START_RESET = 760;
      const ROUND_PAUSE = 1200;
      const SOUND_KEY = 'sumo-v2-muted';

      const calls = {
        start: [
          'Hakkeyoi! Hands down, sand quiet, release in the green.',
          'Hakkeyoi! The dohyō opens for both Nouns.',
          'Hakkeyoi! Hold, breathe, and let the green arrive.',
        ],
        p1: [
          'Yorikiri! East takes the round.',
          'Oshidashi! East forces the line.',
          'A clean east-side shove. The rope gives way.',
        ],
        p2: [
          'Yorikiri! West takes the round.',
          'Oshidashi! West forces the line.',
          'A patient west-side push. Sand leaves the circle.',
        ],
        clash: [
          'Both Nouns meet in the middle and shake the floor.',
          'A soft collision. The rope waits.',
          'Equal hands, equal sand.',
        ],
        stumble: [
          'Too much charge. The feet forget the plan.',
          'Red zone. A small stumble in the sand.',
          'The dohyō punishes the overshoot.',
        ],
        matta: [
          'Matta! {side} moved before Hakkeyoi.',
          'Matta! {side} broke the breath.',
          'Matta! {side} twitched in the shikiri.',
        ],
        danger: [
          '{side} is on the tawara!',
          '{side} feels the rope at their heels.',
          '{side} is one shove from the sand.',
        ],
      };

      const blankStats = () => ({
        clashes: 0,
        sweet: 0,
        stumbles: 0,
        peak: 0,
      });

      const player = (id, side, x) => ({
        id,
        side,
        seed: 0,
        x,
        inputDown: false,
        charging: false,
        committed: false,
        chargeStart: 0,
        charge: 0,
        commitCharge: 0,
        commitPower: 0,
        commitBand: 'weak',
        stats: blankStats(),
      });

      const state = {
        round: 1,
        wins: { p1: 0, p2: 0 },
        phase: 'ready',
        pendingId: null,
        pendingTimer: 0,
        raf: 0,
        edgeDanger: '',
        totalClashes: 0,
        lastWinner: '',
        p1: player('p1', 'East', -START_OFFSET),
        p2: player('p2', 'West', START_OFFSET),
      };

      const audio = {
        ctx: null,
        muted: false,
        noise: null,
        primed: false,
      };

      const activePointers = {
        p1: new Set(),
        p2: new Set(),
      };

      const heldKeys = {
        p1: false,
        p2: false,
      };

      function randomSeed(except) {
        let seed = Math.floor(Math.random() * 1200);
        while (seed === except) seed = Math.floor(Math.random() * 1200);
        return seed;
      }

      function nounUrl(seed) {
        return `https://noun.pics/${seed}.svg`;
      }

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function seedFromParam(raw, except) {
        if (raw === null || raw.trim() === '') return randomSeed(except);

        const value = Number(raw);
        if (!Number.isFinite(value)) return randomSeed(except);

        return clamp(Math.round(value), 0, 1199);
      }

      function seedsFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const east = seedFromParam(params.get('east'), undefined);
        const west = seedFromParam(params.get('west'), east);

        return { east, west };
      }

      function syncUrl() {
        const url = new URL(window.location.href);
        url.searchParams.set('east', String(state.p1.seed));
        url.searchParams.set('west', String(state.p2.seed));
        window.history.replaceState(window.history.state, '', `${url.pathname}?${url.searchParams.toString()}${url.hash}`);
      }

      function canonicalMatchUrl() {
        return `pointcast.xyz/sumo-v2/?east=${state.p1.seed}&west=${state.p2.seed}`;
      }

      function pickLine(group) {
        const set = calls[group];
        return set[Math.floor(Math.random() * set.length)];
      }

      function otherId(id) {
        return id === 'p1' ? 'p2' : 'p1';
      }

      function readMuted() {
        try {
          return window.localStorage.getItem(SOUND_KEY) === 'true';
        } catch (error) {
          return false;
        }
      }

      function writeMuted() {
        try {
          window.localStorage.setItem(SOUND_KEY, audio.muted ? 'true' : 'false');
        } catch (error) {
          // localStorage can be blocked; the in-memory toggle still works.
        }
      }

      function updateSoundToggle() {
        if (!els.soundToggle) return;
        els.soundToggle.textContent = audio.muted ? '🔇' : '🔊';
        els.soundToggle.setAttribute('aria-pressed', audio.muted ? 'true' : 'false');
        els.soundToggle.setAttribute('aria-label', audio.muted ? 'Sound muted' : 'Sound on');
      }

      function getAudioContext() {
        if (audio.muted) return null;
        if (audio.ctx) return audio.ctx;

        const AudioCtor = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtor) return null;

        audio.ctx = new AudioCtor();
        return audio.ctx;
      }

      function primeAudio() {
        audio.primed = true;
        const ctx = getAudioContext();
        if (!ctx) return null;
        if (ctx.state === 'suspended') ctx.resume();
        return ctx;
      }

      function getNoiseBuffer(ctx) {
        if (audio.noise && audio.noise.sampleRate === ctx.sampleRate) return audio.noise;

        const length = Math.floor(ctx.sampleRate * 0.2);
        const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
        const data = buffer.getChannelData(0);

        for (let i = 0; i < length; i += 1) {
          const decay = 1 - i / length;
          data[i] = (Math.random() * 2 - 1) * decay;
        }

        audio.noise = buffer;
        return buffer;
      }

      function connectNode(node, gain, start, peak, duration) {
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(peak, start + 0.008);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
        node.connect(gain);
        gain.connect(audio.ctx.destination);
      }

      function playClack() {
        const ctx = primeAudio();
        if (!ctx) return;

        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'square';
        osc.frequency.setValueAtTime(780, now);
        osc.frequency.exponentialRampToValueAtTime(520, now + 0.055);
        connectNode(osc, gain, now, 0.038, 0.1);
        osc.start(now);
        osc.stop(now + 0.11);
      }

      function playThump() {
        const ctx = primeAudio();
        if (!ctx) return;

        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const body = ctx.createGain();
        const noise = ctx.createBufferSource();
        const tap = ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(82, now);
        osc.frequency.exponentialRampToValueAtTime(46, now + 0.13);
        connectNode(osc, body, now, 0.052, 0.18);
        osc.start(now);
        osc.stop(now + 0.19);

        noise.buffer = getNoiseBuffer(ctx);
        tap.gain.setValueAtTime(0.024, now);
        tap.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);
        noise.connect(tap);
        tap.connect(ctx.destination);
        noise.start(now);
        noise.stop(now + 0.06);
      }

      function playChime() {
        const ctx = primeAudio();
        if (!ctx) return;

        [740, 1110].forEach((freq, index) => {
          const now = ctx.currentTime + index * 0.035;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);
          connectNode(osc, gain, now, 0.03 - index * 0.008, 0.17);
          osc.start(now);
          osc.stop(now + 0.18);
        });
      }

      function playGong() {
        const ctx = primeAudio();
        if (!ctx) return;

        [126, 188].forEach((freq, index) => {
          const now = ctx.currentTime + index * 0.025;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);
          osc.frequency.exponentialRampToValueAtTime(freq * 0.78, now + 0.52);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(0.055 - index * 0.018, now + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.62);
        });
      }

      function playSound(name) {
        if (audio.muted || !audio.primed) return;
        if (name === 'clack') playClack();
        if (name === 'thump') playThump();
        if (name === 'chime') playChime();
        if (name === 'gong') playGong();
      }

      function setAnnouncer(text) {
        els.announcer.textContent = text;
      }

      function setPhase(phase) {
        const phaseLabels = {
          shikiri: 'shikiri',
          ready: 'Hakkeyoi',
          charging: 'Hakkeyoi',
          resolving: 'clash',
          'false-start': 'Matta',
          'round-over': 'round',
          'match-over': 'match',
        };

        state.phase = phase;
        room.dataset.phase = phase;
        els.matchState.textContent = phaseLabels[phase] || 'Hakkeyoi';
      }

      function setFighterState(id, fighterState) {
        const el = id === 'p1' ? els.p1Fighter : els.p2Fighter;
        el.dataset.state = fighterState;
      }

      function updateFighters() {
        els.p1Fighter.style.setProperty('--x', `${state.p1.x}%`);
        els.p2Fighter.style.setProperty('--x', `${state.p2.x}%`);
      }

      function setTouchHeld(id, held) {
        const zone = id === 'p1' ? els.p1Touch : els.p2Touch;
        if (!zone) return;

        if (held) zone.dataset.held = 'true';
        else delete zone.dataset.held;
      }

      function updateEdgeDanger(options = {}) {
        const announce = options.announce !== false;
        const danger = state.p1.x <= -DANGER_X
          ? 'p1'
          : state.p2.x >= DANGER_X
            ? 'p2'
            : '';

        if (danger) els.dohyo.dataset.danger = danger;
        else delete els.dohyo.dataset.danger;

        if (danger && announce && state.edgeDanger !== danger && state.phase !== 'round-over' && state.phase !== 'match-over') {
          setAnnouncer(pickLine('danger').replace('{side}', state[danger].side));
        }

        state.edgeDanger = danger;
      }

      function updateMeters() {
        ['p1', 'p2'].forEach((id) => {
          const p = state[id];
          const meter = id === 'p1' ? els.p1Meter : els.p2Meter;
          const label = id === 'p1' ? els.p1ChargeLabel : els.p2ChargeLabel;
          const display = Math.round(p.charge);

          meter.style.width = `${clamp(p.charge / CHARGE_MAX, 0, 1) * 100}%`;
          meter.dataset.band = p.charge >= OVERSHOOT_MIN ? 'red' : p.charge >= SWEET_MIN ? 'green' : 'yellow';
          label.textContent = `${display}%`;
        });
      }

      function updateWinDots() {
        [
          [els.p1Wins, state.wins.p1],
          [els.p2Wins, state.wins.p2],
        ].forEach(([wrap, wins]) => {
          Array.from(wrap.children).forEach((dot, index) => {
            const wasLit = dot.dataset.lit === 'true';
            const isLit = index < wins;

            dot.dataset.lit = isLit ? 'true' : 'false';

            if (isLit && !wasLit) {
              dot.dataset.pop = 'true';
              window.setTimeout(() => {
                delete dot.dataset.pop;
              }, 380);
            }

            if (!isLit) delete dot.dataset.pop;
          });
        });
      }

      function updateScore() {
        els.roundLabel.textContent = state.phase === 'match-over'
          ? 'Match complete · best of 5'
          : `Round ${state.round} · best of 5`;
        updateWinDots();
      }

      function chargePower(charge) {
        if (charge >= OVERSHOOT_MIN) return -18;
        if (charge >= SWEET_MIN) return 70 + (charge - SWEET_MIN) * 0.75;
        return 12 + charge * 0.45;
      }

      function recordCommit(p) {
        p.commitCharge = clamp(p.charge, 0, CHARGE_MAX);
        p.commitBand = p.commitCharge >= OVERSHOOT_MIN ? 'red' : p.commitCharge >= SWEET_MIN ? 'green' : 'yellow';
        p.commitPower = chargePower(p.commitCharge);
        p.committed = true;
        p.charging = false;
        p.inputDown = false;
        p.stats.clashes += 1;
        p.stats.peak = Math.max(p.stats.peak, p.commitCharge);

        if (p.commitBand === 'green') p.stats.sweet += 1;
        if (p.commitBand === 'red') p.stats.stumbles += 1;
      }

      function clearPendingTimer() {
        if (!state.pendingTimer) return;
        window.clearTimeout(state.pendingTimer);
        state.pendingTimer = 0;
      }

      function clearCycle() {
        ['p1', 'p2'].forEach((id) => {
          const p = state[id];
          p.inputDown = false;
          p.charging = false;
          p.committed = false;
          p.chargeStart = 0;
          p.charge = 0;
          p.commitCharge = 0;
          p.commitPower = 0;
          p.commitBand = 'weak';
          setFighterState(id, 'idle');
        });
        state.pendingId = null;
        clearPendingTimer();
        updateMeters();
      }

      function clearRoundEffects() {
        els.dohyo.classList.remove('is-shaking');
        els.p1Puff.classList.remove('is-active', 'is-big');
        els.p2Puff.classList.remove('is-active', 'is-big');
        delete els.dohyo.dataset.danger;
        state.edgeDanger = '';
      }

      function startShikiri() {
        clearPendingTimer();
        setPhase('shikiri');
        setAnnouncer('shikiri… HAKKEYOI!');
        state.pendingTimer = window.setTimeout(() => {
          state.pendingTimer = 0;
          setPhase('ready');
          playSound('clack');
          setAnnouncer(pickLine('start'));
          updateEdgeDanger({ announce: true });
        }, SHIKIRI_MS);
      }

      function falseStart(id) {
        if (state.phase !== 'shikiri') return;

        clearPendingTimer();
        setPhase('false-start');
        setFighterState(id, 'false-start');
        setAnnouncer(pickLine('matta').replace('{side}', state[id].side));

        state.pendingTimer = window.setTimeout(() => {
          state.pendingTimer = 0;
          clearCycle();
          state.p1.x = -START_OFFSET;
          state.p2.x = START_OFFSET;
          updateFighters();
          startShikiri();
        }, FALSE_START_RESET);
      }

      function resetRound() {
        clearCycle();
        clearRoundEffects();
        state.p1.x = -START_OFFSET;
        state.p2.x = START_OFFSET;
        updateFighters();
        updateScore();
        startShikiri();
      }

      function setSeeds(randomize) {
        if (randomize) {
          state.p1.seed = randomSeed();
          state.p2.seed = randomSeed(state.p1.seed);
        }

        els.p1Seed.textContent = `seed ${state.p1.seed}`;
        els.p2Seed.textContent = `seed ${state.p2.seed}`;
        els.p1Fighter.src = nounUrl(state.p1.seed);
        els.p2Fighter.src = nounUrl(state.p2.seed);
        syncUrl();
      }

      function resetMatch(randomizeSeeds) {
        clearPendingTimer();
        state.round = 1;
        state.wins = { p1: 0, p2: 0 };
        state.totalClashes = 0;
        state.lastWinner = '';
        state.p1.stats = blankStats();
        state.p2.stats = blankStats();
        els.statSheet.hidden = true;
        els.copyResult.textContent = 'COPY RESULT';
        setSeeds(randomizeSeeds);
        resetRound();
      }

      function beginCharge(id) {
        const p = state[id];
        primeAudio();

        if (state.phase === 'shikiri') {
          falseStart(id);
          return;
        }

        if (state.phase !== 'ready' && state.phase !== 'charging') return;
        if (p.inputDown || p.committed) return;

        p.inputDown = true;
        p.charging = true;
        p.chargeStart = performance.now();
        p.charge = 0;
        setPhase('charging');
        setFighterState(id, 'charging');
      }

      function releaseCharge(id, auto = false) {
        const p = state[id];
        if (state.phase !== 'ready' && state.phase !== 'charging') return;
        if (!p.charging || p.committed) return;

        recordCommit(p);
        setFighterState(id, p.commitBand === 'red' ? 'stumble' : 'lunge');
        updateMeters();

        const other = state[otherId(id)];
        if (other.committed) {
          resolveClash();
          return;
        }

        state.pendingId = id;
        clearPendingTimer();
        const delay = auto || other.inputDown ? COMMIT_WINDOW : 70;
        state.pendingTimer = window.setTimeout(resolveClash, delay);
      }

      function pushAmount(power, uncontested) {
        if (power <= 0) return 0;
        const base = uncontested ? 6 : 4;
        return clamp(base + power / 11, uncontested ? 7 : 5, uncontested ? 15 : 13);
      }

      function pushTowardLoser(winnerId, amount) {
        if (winnerId === 'p1') {
          state.p1.x = clamp(state.p1.x + amount * 0.2, -START_OFFSET, EDGE - 12);
          state.p2.x = clamp(state.p2.x + amount, -EDGE, EDGE + 8);
        } else {
          state.p2.x = clamp(state.p2.x - amount * 0.2, -EDGE + 12, START_OFFSET);
          state.p1.x = clamp(state.p1.x - amount, -EDGE - 8, EDGE);
        }
      }

      function stumble(id, extra = 0) {
        const amount = 5 + extra;
        if (id === 'p1') {
          state.p1.x = clamp(state.p1.x - amount, -EDGE - 8, EDGE);
        } else {
          state.p2.x = clamp(state.p2.x + amount, -EDGE, EDGE + 8);
        }
        setFighterState(id, 'stumble');
      }

      function resolveClash() {
        clearPendingTimer();
        if (state.phase === 'round-over' || state.phase === 'match-over') return;

        const p1 = state.p1;
        const p2 = state.p2;
        const p1Active = p1.committed;
        const p2Active = p2.committed;
        if (!p1Active && !p2Active) return;

        state.totalClashes += 1;
        setPhase('resolving');
        playSound('thump');

        const p1Red = p1Active && p1.commitBand === 'red';
        const p2Red = p2Active && p2.commitBand === 'red';

        if (p1Red) stumble('p1', p2Active && !p2Red ? 3 : 0);
        if (p2Red) stumble('p2', p1Active && !p1Red ? 3 : 0);

        if (!p1Red && !p2Red) {
          if (p1Active && !p2Active) {
            pushTowardLoser('p1', pushAmount(p1.commitPower, true));
            setFighterState('p1', 'lunge');
            setFighterState('p2', 'clash');
          } else if (p2Active && !p1Active) {
            pushTowardLoser('p2', pushAmount(p2.commitPower, true));
            setFighterState('p2', 'lunge');
            setFighterState('p1', 'clash');
          } else {
            const delta = p1.commitPower - p2.commitPower;
            if (Math.abs(delta) < 8) {
              setFighterState('p1', 'clash');
              setFighterState('p2', 'clash');
              setAnnouncer(pickLine('clash'));
            } else {
              const winner = delta > 0 ? 'p1' : 'p2';
              const amount = clamp(6 + Math.abs(delta) / 5 + state[winner].commitPower / 24, 7, 15);
              pushTowardLoser(winner, amount);
              setFighterState(winner, 'lunge');
              setFighterState(otherId(winner), 'clash');
            }
          }
        } else if (p1Red && p2Active && !p2Red) {
          pushTowardLoser('p2', pushAmount(p2.commitPower, true) * 0.7);
        } else if (p2Red && p1Active && !p1Red) {
          pushTowardLoser('p1', pushAmount(p1.commitPower, true) * 0.7);
        }

        if (p1Red || p2Red) setAnnouncer(pickLine('stumble'));
        updateFighters();
        const priorDanger = state.edgeDanger;
        updateEdgeDanger({ announce: false });
        state.edgeDanger = priorDanger;

        window.setTimeout(() => {
          if (state.p1.x <= -EDGE) {
            finishRound('p2');
            return;
          }

          if (state.p2.x >= EDGE) {
            finishRound('p1');
            return;
          }

          clearCycle();
          startShikiri();
        }, 520);
      }

      function finishRound(winnerId) {
        const loserId = otherId(winnerId);
        state.wins[winnerId] += 1;
        state.lastWinner = winnerId;
        state.edgeDanger = '';
        delete els.dohyo.dataset.danger;
        setPhase('round-over');
        setFighterState(winnerId, 'winner');
        setFighterState(loserId, 'pushout');
        els.dohyo.classList.add('is-shaking');
        window.setTimeout(() => els.dohyo.classList.remove('is-shaking'), 260);
        (loserId === 'p1' ? els.p1Puff : els.p2Puff).classList.add('is-active', 'is-big');
        setAnnouncer(pickLine(winnerId));
        playSound('chime');
        updateScore();

        if (state.wins[winnerId] >= 3) {
          window.setTimeout(() => finishMatch(winnerId), 620);
          return;
        }

        window.setTimeout(() => {
          state.round += 1;
          resetRound();
        }, ROUND_PAUSE);
      }

      function statPercent(p) {
        if (!p.stats.clashes) return '0%';
        return `${Math.round((p.stats.sweet / p.stats.clashes) * 100)}%`;
      }

      function resultCopy() {
        const winnerId = state.lastWinner || (state.wins.p1 > state.wins.p2 ? 'p1' : 'p2');
        const loserId = otherId(winnerId);
        const winnerScore = state.wins[winnerId];
        const loserScore = state.wins[loserId];

        return `⚪ Noun ${state[winnerId].seed} def. Noun ${state[loserId].seed} — ${winnerScore}-${loserScore} · ${state.totalClashes} clashes · sumo at ${canonicalMatchUrl()}`;
      }

      function fallbackCopy(text) {
        const field = document.createElement('textarea');
        field.value = text;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.top = '-1000px';
        document.body.appendChild(field);
        field.select();

        let copied = false;
        try {
          copied = document.execCommand('copy');
        } catch (error) {
          copied = false;
        }

        field.remove();
        return copied;
      }

      async function copyResult() {
        const text = resultCopy();
        let copied = false;

        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          }
        } catch (error) {
          copied = false;
        }

        if (!copied) copied = fallbackCopy(text);

        els.copyResult.textContent = copied ? 'COPIED' : 'COPY BLOCKED';
        els.copyResult.dataset.copied = copied ? 'true' : 'false';
        window.setTimeout(() => {
          els.copyResult.textContent = 'COPY RESULT';
          delete els.copyResult.dataset.copied;
        }, 1300);
      }

      function finishMatch(winnerId) {
        setPhase('match-over');
        playSound('gong');
        setAnnouncer(`${state[winnerId].side} takes the match. Salt, breath, bow.`);
        els.resultTitle.textContent = `${state[winnerId].side} wins the match`;

        els.p1StatClashes.textContent = state.p1.stats.clashes;
        els.p1StatSweet.textContent = statPercent(state.p1);
        els.p1StatStumbles.textContent = state.p1.stats.stumbles;
        els.p1StatPeak.textContent = `${Math.round(state.p1.stats.peak)}%`;

        els.p2StatClashes.textContent = state.p2.stats.clashes;
        els.p2StatSweet.textContent = statPercent(state.p2);
        els.p2StatStumbles.textContent = state.p2.stats.stumbles;
        els.p2StatPeak.textContent = `${Math.round(state.p2.stats.peak)}%`;

        els.statSheet.hidden = false;
        updateScore();
      }

      function frame(now) {
        ['p1', 'p2'].forEach((id) => {
          const p = state[id];
          if (!p.charging || p.committed) return;

          p.charge = clamp(((now - p.chargeStart) / CHARGE_MS_TO_100) * 100, 0, CHARGE_MAX);
          p.stats.peak = Math.max(p.stats.peak, p.charge);

          if (p.charge >= CHARGE_MAX) releaseCharge(id, true);
        });

        updateMeters();
        state.raf = window.requestAnimationFrame(frame);
      }

      function isTextInput(target) {
        if (!target) return false;
        return ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName);
      }

      function playerForKey(code) {
        if (code === 'KeyA' || code === 'ArrowLeft') return 'p1';
        if (code === 'KeyL' || code === 'ArrowRight') return 'p2';
        return null;
      }

      window.addEventListener('keydown', (event) => {
        const id = playerForKey(event.code);
        if (!id || isTextInput(event.target)) return;
        event.preventDefault();
        if (event.repeat) return;
        heldKeys[id] = true;
        setTouchHeld(id, true);
        beginCharge(id);
      });

      window.addEventListener('keyup', (event) => {
        const id = playerForKey(event.code);
        if (!id || isTextInput(event.target)) return;
        event.preventDefault();
        heldKeys[id] = false;
        if (!activePointers[id].size) setTouchHeld(id, false);
        releaseCharge(id);
      });

      function bindPress(zone, id) {
        function endPointer(event) {
          event.preventDefault();
          if (!activePointers[id].has(event.pointerId)) return;

          activePointers[id].delete(event.pointerId);
          if (activePointers[id].size || heldKeys[id]) return;

          setTouchHeld(id, false);
          releaseCharge(id);
        }

        zone.addEventListener('pointerdown', (event) => {
          event.preventDefault();
          activePointers[id].add(event.pointerId);
          setTouchHeld(id, true);
          if (zone.setPointerCapture) zone.setPointerCapture(event.pointerId);
          beginCharge(id);
        }, { passive: false });

        zone.addEventListener('pointerup', endPointer, { passive: false });
        zone.addEventListener('pointercancel', endPointer, { passive: false });
        zone.addEventListener('contextmenu', (event) => event.preventDefault());
      }

      bindPress(els.p1Touch, 'p1');
      bindPress(els.p2Touch, 'p2');

      els.soundToggle.addEventListener('click', () => {
        audio.muted = !audio.muted;
        writeMuted();
        updateSoundToggle();
        if (!audio.muted) primeAudio();
      });

      els.rematch.addEventListener('click', () => {
        primeAudio();
        resetMatch(false);
      });

      els.swapNouns.addEventListener('click', () => {
        primeAudio();
        resetMatch(true);
      });

      els.copyResult.addEventListener('click', copyResult);

      audio.muted = readMuted();
      updateSoundToggle();
      const initialSeeds = seedsFromUrl();
      state.p1.seed = initialSeeds.east;
      state.p2.seed = initialSeeds.west;
      resetMatch(false);
      state.raf = window.requestAnimationFrame(frame);

      window.addEventListener('pagehide', () => {
        clearPendingTimer();
        window.cancelAnimationFrame(state.raf);
      });
    })();
  </script>
</BaseLayout>

