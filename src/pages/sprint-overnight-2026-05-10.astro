---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();

// The six tasks Mike launched in parallel. PR numbers will be filled in
// as each task ships — for now we link to the branch.
const TASKS = [
  {
    n: 1,
    title: 'Capstone diploma',
    page: '/cast-graduate',
    spec: 'Reads /drum-school stars + /cast-make slots, awards a rank (Apprentice → Maestro), shows your graduating Noun, shareable diploma hash.',
    worker: 'Codex',
    branch: 'feat/cast-graduate-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 287,
    color: '#f6c15e',
  },
  {
    n: 2,
    title: 'Drum academy +5 lessons',
    page: '/drum-academy',
    spec: 'Extends with reverb (ConvolverNode IR), compression (DynamicsCompressorNode), Karplus-Strong pluck, ADSR envelopes, filter sweep with LFO. Five new Noun teachers.',
    worker: 'Codex',
    branch: 'feat/drum-academy-lessons-6-10-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 1042,
    color: '#ffd400',
  },
  {
    n: 3,
    title: 'Music engine audit',
    page: 'docs/audit-2026-05-10-audio.md',
    spec: 'Deep audit of the audio engine post-PR #547 fix. Edge cases in scheduler, iOS specifics, WAV encoder math, repeated-use leaks. Severity-tagged punch list.',
    worker: 'Codex',
    branch: 'audit/music-engine-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 1189,
    color: '#6f59c0',
  },
  {
    n: 4,
    title: 'Cast Make Pro',
    page: '/cast-make-pro',
    spec: '8-bar arrangements · per-bar drums · velocity per cell (4 levels) · swing slider · per-bar lead phrases · pad voicings · multi-track WAV export · undo/redo · 8 save slots.',
    worker: 'Codex',
    branch: 'feat/cast-make-pro-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 523,
    color: '#a8ff3a',
  },
  {
    n: 5,
    title: 'Drum school +3 games',
    page: '/drum-school',
    spec: 'Key recognition (4 keys, 5 rounds), tempo tap (estimate BPM from your taps), melody memory (sing back a sequence on a piano keyboard). +9 possible stars (now /21).',
    worker: 'Codex',
    branch: 'feat/drum-school-games-5-7-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 313,
    color: '#9ed6f0',
  },
  {
    n: 6,
    title: 'Town Music dashboard',
    page: '/town-music',
    spec: 'A single page surfacing all 8 music pages + your local state. Recently heard, your compositions, star rankings, journey map. Empty states for newcomers.',
    worker: 'Codex',
    branch: 'feat/town-music-dashboard-2026-05-10',
    pr: null,
    status: 'launched',
    noun: 612,
    color: '#ff5f7a',
  },
];

const baseUrl = 'https://github.com/mhoydich/pointcast';
---
<BlockLayout title="Overnight Sprint · 2026-05-10" description="Six parallel Codex tasks. Capstone diploma · drum academy extension · audio engine audit · cast-make-pro · drum-school games 5-7 · town-music dashboard. Burning Codex compute before tomorrow's reset.">
  <main class="ovs" id="ovs" data-built={built}>
    <header class="ovs__top">
      <p class="ovs__kicker">OVERNIGHT SPRINT · 2026-05-10</p>
      <h1 class="ovs__title">Six parallel ships.</h1>
      <p class="ovs__sub">Mike's Codex compute resets tomorrow. So this evening we fanned out: six Codex agents working in six git worktrees, each on their own focused task. While they work, this page exists.</p>
      <p class="ovs__refresh-note">Refresh to see the latest merge status. Tasks update as PRs land in <code>main</code>.</p>
    </header>

    <section class="ovs__band">
      <div class="ovs__band-stat">
        <p class="ovs__band-label">PARALLEL WORKERS</p>
        <p class="ovs__band-val">6</p>
      </div>
      <div class="ovs__band-stat">
        <p class="ovs__band-label">CODEX TASKS</p>
        <p class="ovs__band-val">5</p>
      </div>
      <div class="ovs__band-stat">
        <p class="ovs__band-label">AUDIT REPORTS</p>
        <p class="ovs__band-val">1</p>
      </div>
      <div class="ovs__band-stat">
        <p class="ovs__band-label">BASE SHA</p>
        <p class="ovs__band-val ovs__band-val--mono">4aeb960</p>
      </div>
    </section>

    <section class="ovs__grid">
      {TASKS.map(t => (
        <article class="ovs__task" style={`--task-c: ${t.color};`}>
          <header class="ovs__task-head">
            <div class="ovs__task-noun">
              <img src={`https://noun.pics/${t.noun}.svg`} alt={`Noun ${t.noun}`} loading="lazy"/>
            </div>
            <div class="ovs__task-meta">
              <p class="ovs__task-num">TASK {t.n} · {t.worker.toUpperCase()}</p>
              <h2 class="ovs__task-title">{t.title}</h2>
              <p class="ovs__task-page"><code>{t.page}</code></p>
            </div>
            <div class={`ovs__task-status ovs__task-status--${t.status}`}>{t.status}</div>
          </header>
          <p class="ovs__task-spec">{t.spec}</p>
          <footer class="ovs__task-foot">
            <a class="ovs__task-link" href={`${baseUrl}/compare/main...${t.branch}`} target="_blank" rel="noopener">↗ branch · {t.branch}</a>
          </footer>
        </article>
      ))}
    </section>

    <section class="ovs__how">
      <h2 class="ovs__how-title">How this works</h2>
      <ol class="ovs__how-list">
        <li><strong>Six worktrees.</strong> One per task, each at <code>/tmp/pc-sprint-{`{slug}`}</code>, all branched off <code>origin/main@4aeb960</code>. Worktrees let multiple Codex sessions edit the same repo in parallel without git collisions.</li>
        <li><strong>Six background agents.</strong> Each agent invokes <code>mcp__codex__codex</code> in its assigned worktree with <code>workspace-write</code> sandbox and <code>never</code> approval policy. Self-contained prompts so Codex doesn't need conversation context.</li>
        <li><strong>Codex writes the code.</strong> Each task is a focused spec — Codex reads the existing conventions (BlockLayout, BEM-style classes, the shared <code>audio-scheduler.ts</code>) and writes a complete page or extension.</li>
        <li><strong>Codex runs the build.</strong> <code>npm run build:bare</code> verifies nothing broke. If errors, Codex fixes them before the agent moves on.</li>
        <li><strong>The agent ships the PR.</strong> Commits, pushes to <code>origin</code>, opens a PR with <code>gh pr create</code>. Does NOT merge — that's the human review step.</li>
        <li><strong>I review + merge.</strong> Each PR gets a sanity check, a local build verification, then a squash-merge.</li>
      </ol>
    </section>

    <section class="ovs__why">
      <h2 class="ovs__why-title">Why fan out at all?</h2>
      <p>The serial path through these six tasks would be 4-6 hours of human-driven shipping. Six parallel Codex agents complete in roughly the time of the slowest one — ~30-45 minutes for the bigger pages (Cast Make Pro), ~10 minutes for the smaller ones (audit, dashboard). The bottleneck is not Codex's speed; it's the human reviewer.</p>
      <p>This shape works because the tasks are <em>independent</em>: no two of them touch the same file, no two of them block on each other's output, no one of them needs the conversation state I have. So they can run truly in parallel.</p>
      <p>The cost is review burden. Six PRs at once means six surface areas to QA. Worth it for an overnight sprint, would be excessive for a regular sprint.</p>
    </section>

    <footer class="ovs__foot">
      <p>Built {built.slice(0,10)} at {built.slice(11,16)}Z · branched from <code>4aeb960</code></p>
      <p>← <a href="/cast-make">/cast-make</a> · <a href="/drum-school">/drum-school</a> · <a href="/drum-academy">/drum-academy</a> · <a href="/cast-real">/cast-real</a> · <a href="/">PointCast home</a></p>
      <p class="ovs__foot-credit">A small experiment in parallel AI development. The bottleneck moves from code-writing to code-reviewing.</p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --ovs-bg: #0a0610; --ovs-walnut: #5a3422; --ovs-flame: #f6c15e; --ovs-cream: #f4e7c8;
    --ovs-velvet: #1a0820; --ovs-glass: rgba(244,231,200,0.04);
    --ovs-line: rgba(244,231,200,0.10);
    --ovs-text: #f4e7c8; --ovs-text-mute: rgba(244,231,200,0.62); --ovs-text-quiet: rgba(244,231,200,0.38);
    --ovs-display: 'Inter Tight', system-ui, sans-serif;
    --ovs-body: 'Inter', system-ui, sans-serif;
    --ovs-mono: 'JetBrains Mono', ui-monospace, monospace;
    --ovs-good: #a8ff3a;
  }
  body { background: var(--ovs-bg); color: var(--ovs-text); font-family: var(--ovs-body); }

  .ovs { max-width: 1040px; margin: 0 auto; padding: 32px 22px 80px 22px; }

  /* Top */
  .ovs__top { padding: 24px 0 36px 0; border-bottom: 1px solid var(--ovs-line); margin-bottom: 32px; }
  .ovs__kicker { font-family: var(--ovs-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--ovs-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .ovs__title { font-family: var(--ovs-display); font-weight: 800; font-size: clamp(40px, 6vw, 64px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 14px 0; color: var(--ovs-text); }
  .ovs__sub { font-family: var(--ovs-body); font-size: 15px; color: var(--ovs-text-mute); max-width: 720px; line-height: 1.6; margin: 0 0 8px 0; }
  .ovs__refresh-note { font-family: var(--ovs-mono); font-size: 11px; color: var(--ovs-text-quiet); margin: 12px 0 0 0; }
  .ovs__refresh-note code { color: var(--ovs-flame); background: var(--ovs-velvet); padding: 1px 5px; border-radius: 3px; font-size: 10.5px; }

  /* Stat band */
  .ovs__band {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
    padding: 18px; background: linear-gradient(135deg, rgba(246,193,94,0.08), rgba(168,255,58,0.02));
    border: 1px solid rgba(246,193,94,0.20); border-radius: 12px; margin-bottom: 28px;
  }
  @media (max-width: 640px) { .ovs__band { grid-template-columns: repeat(2, 1fr); } }
  .ovs__band-stat { text-align: center; padding: 6px; }
  .ovs__band-label { font-family: var(--ovs-mono); font-size: 9.5px; color: var(--ovs-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; margin: 0 0 6px 0; }
  .ovs__band-val { font-family: var(--ovs-display); font-weight: 800; font-size: 30px; color: var(--ovs-text); margin: 0; line-height: 1; letter-spacing: -0.02em; }
  .ovs__band-val--mono { font-family: var(--ovs-mono); font-weight: 500; font-size: 14px; color: var(--ovs-flame); letter-spacing: 0; padding-top: 10px; }

  /* Task grid */
  .ovs__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 36px; }
  @media (max-width: 720px) { .ovs__grid { grid-template-columns: 1fr; } }

  .ovs__task {
    background: var(--ovs-glass); border: 1px solid var(--ovs-line); border-radius: 12px;
    padding: 18px; display: flex; flex-direction: column; gap: 12px;
    position: relative; overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .ovs__task::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--task-c, var(--ovs-flame));
    opacity: 0.6;
  }
  .ovs__task:hover { border-color: var(--task-c, var(--ovs-flame)); transform: translateY(-2px); }

  .ovs__task-head { display: flex; gap: 14px; align-items: flex-start; }
  .ovs__task-noun {
    width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--task-c, var(--ovs-walnut)), var(--ovs-velvet));
    display: grid; place-items: center;
  }
  .ovs__task-noun img { width: 80%; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); }
  .ovs__task-meta { flex: 1; min-width: 0; }
  .ovs__task-num { font-family: var(--ovs-mono); font-size: 9.5px; color: var(--ovs-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; margin: 0 0 3px 0; }
  .ovs__task-title { font-family: var(--ovs-display); font-weight: 800; font-size: 17px; letter-spacing: -0.01em; color: var(--ovs-text); margin: 0 0 4px 0; line-height: 1.2; }
  .ovs__task-page { font-family: var(--ovs-mono); font-size: 11px; margin: 0; }
  .ovs__task-page code { color: var(--ovs-flame); background: transparent; padding: 0; }

  .ovs__task-status {
    font-family: var(--ovs-mono); font-size: 9.5px; padding: 3px 8px;
    background: rgba(246,193,94,0.10); color: var(--ovs-flame);
    border-radius: 999px; letter-spacing: 0.5px; text-transform: uppercase;
    align-self: flex-start; flex-shrink: 0;
  }
  .ovs__task-status--launched { background: rgba(246,193,94,0.12); color: var(--ovs-flame); }
  .ovs__task-status--merged { background: rgba(168,255,58,0.18); color: var(--ovs-good); }
  .ovs__task-status--failed { background: rgba(255,95,122,0.18); color: #ff5f7a; }

  .ovs__task-spec { font-family: var(--ovs-body); font-size: 13px; color: var(--ovs-text-mute); line-height: 1.5; margin: 0; }

  .ovs__task-foot { padding-top: 8px; border-top: 1px dashed var(--ovs-line); margin-top: 4px; }
  .ovs__task-link { font-family: var(--ovs-mono); font-size: 10.5px; color: var(--ovs-text-quiet); text-decoration: none; }
  .ovs__task-link:hover { color: var(--ovs-flame); }

  /* How section */
  .ovs__how, .ovs__why { padding: 24px; background: var(--ovs-glass); border: 1px solid var(--ovs-line); border-radius: 12px; margin-bottom: 22px; }
  .ovs__how-title, .ovs__why-title { font-family: var(--ovs-display); font-weight: 700; font-size: 20px; margin: 0 0 14px 0; letter-spacing: -0.01em; }
  .ovs__how-list { padding-left: 22px; margin: 0; }
  .ovs__how-list li { font-family: var(--ovs-body); font-size: 14px; color: var(--ovs-text-mute); line-height: 1.6; margin-bottom: 8px; }
  .ovs__how-list strong { color: var(--ovs-text); font-weight: 600; }
  .ovs__how-list code { font-family: var(--ovs-mono); font-size: 12px; background: var(--ovs-velvet); padding: 1px 5px; border-radius: 3px; color: var(--ovs-flame); }

  .ovs__why p { font-family: var(--ovs-body); font-size: 14px; color: var(--ovs-text-mute); line-height: 1.6; margin: 0 0 10px 0; }
  .ovs__why p:last-child { margin-bottom: 0; }
  .ovs__why em { color: var(--ovs-flame); font-style: normal; font-weight: 600; }

  /* Foot */
  .ovs__foot {
    padding-top: 24px; border-top: 1px solid var(--ovs-line); margin-top: 24px;
    font-family: var(--ovs-mono); font-size: 11px; color: var(--ovs-text-quiet);
    line-height: 1.7; text-align: center;
  }
  .ovs__foot a { color: var(--ovs-flame); text-decoration: none; }
  .ovs__foot a:hover { text-decoration: underline; }
  .ovs__foot code { background: var(--ovs-velvet); padding: 1px 5px; border-radius: 3px; color: var(--ovs-flame); font-size: 10.5px; }
  .ovs__foot-credit { margin-top: 12px; font-size: 10.5px; }
</style>
</BlockLayout>
