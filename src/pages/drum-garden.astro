---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Garden — a meditative drum screensaver" description="Set it and listen. A small drum kit sits in a zen garden inside a green glass pavilion. Once started, it plays itself for ten minutes — sparse, breathing, slowly evolving. No buttons after play. Like a screensaver for a real attention.">
  <main class="dg" id="dg" data-built={built}>
    <header class="dg__hero">
      <p class="dg__kicker">DRUM · GARDEN · listen-only · ten minutes · screensaver</p>
      <h1 class="dg__title">A small kit in a quiet room.</h1>
      <p class="dg__sub">Press play. A drum kit sits in a zen garden inside a green glass pavilion. For ten minutes it plays itself — sparse at first, fuller in the middle, sparse again at the end. There is nothing to do once it starts. The page is a screensaver for a real attention.</p>
    </header>

    <section class="dg__stage" id="dg-stage" data-state="idle">
      <div class="dg__pavilion" aria-hidden="true">
        <!-- Pavilion frame: top + bottom rails + corner posts (CSS) -->
        <div class="dg__rail dg__rail--top"></div>
        <div class="dg__rail dg__rail--bottom"></div>
        <div class="dg__post dg__post--left"></div>
        <div class="dg__post dg__post--right"></div>
        <!-- Inside: layered SVG of garden + drums -->
        <svg class="dg__scene" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid meet">
          <!-- Background plane (sky / wall) -->
          <defs>
            <linearGradient id="dgSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f4f3ed"/>
              <stop offset="100%" stop-color="#e3e0d3"/>
            </linearGradient>
            <linearGradient id="dgSand" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ebe2c9"/>
              <stop offset="100%" stop-color="#d6c9a7"/>
            </linearGradient>
            <radialGradient id="dgRockBig" cx="40%" cy="35%" r="65%">
              <stop offset="0%" stop-color="#a8a297"/>
              <stop offset="60%" stop-color="#7d7570"/>
              <stop offset="100%" stop-color="#4d4744"/>
            </radialGradient>
            <radialGradient id="dgRockMid" cx="50%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#999388"/>
              <stop offset="100%" stop-color="#6a6360"/>
            </radialGradient>
            <radialGradient id="dgRockSmall" cx="50%" cy="45%" r="60%">
              <stop offset="0%" stop-color="#b0a89d"/>
              <stop offset="100%" stop-color="#7c7670"/>
            </radialGradient>
            <linearGradient id="dgDrumShell" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#9b5b3a"/>
              <stop offset="55%" stop-color="#7c3f24"/>
              <stop offset="100%" stop-color="#4a2614"/>
            </linearGradient>
            <linearGradient id="dgDrumHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f0e8d8"/>
              <stop offset="100%" stop-color="#d4c8af"/>
            </linearGradient>
            <radialGradient id="dgCymbal" cx="50%" cy="35%" r="70%">
              <stop offset="0%" stop-color="#e8c878"/>
              <stop offset="65%" stop-color="#b08838"/>
              <stop offset="100%" stop-color="#6b5020"/>
            </radialGradient>
            <pattern id="dgSandRake" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
              <path d="M 0 11 Q 11 8 22 11" stroke="rgba(120,100,60,0.18)" stroke-width="0.8" fill="none"/>
            </pattern>
          </defs>

          <!-- Far wall / sky band -->
          <rect x="0" y="0" width="1200" height="320" fill="url(#dgSky)"/>
          <!-- Sand floor -->
          <rect x="0" y="300" width="1200" height="300" fill="url(#dgSand)"/>
          <!-- Raked sand pattern as concentric arcs around large rock -->
          <rect x="0" y="300" width="1200" height="300" fill="url(#dgSandRake)" opacity="0.5"/>
          <!-- Concentric rake arcs around big rock -->
          <g fill="none" stroke="rgba(120,100,60,0.22)" stroke-width="1.2">
            <ellipse cx="380" cy="420" rx="180" ry="50"/>
            <ellipse cx="380" cy="420" rx="230" ry="65"/>
            <ellipse cx="380" cy="420" rx="290" ry="82"/>
            <ellipse cx="380" cy="420" rx="360" ry="100"/>
          </g>
          <!-- Concentric rake arcs around drum cluster -->
          <g fill="none" stroke="rgba(120,100,60,0.18)" stroke-width="1.0">
            <ellipse cx="820" cy="430" rx="140" ry="42"/>
            <ellipse cx="820" cy="430" rx="190" ry="56"/>
            <ellipse cx="820" cy="430" rx="250" ry="72"/>
          </g>

          <!-- Big granite rock, left -->
          <g transform="translate(380, 380)">
            <path d="M -150 30 Q -160 -50 -110 -85 Q -50 -110 30 -100 Q 110 -90 145 -50 Q 165 0 140 38 Q 110 60 60 60 Q 0 65 -60 55 Q -130 50 -150 30 Z"
                  fill="url(#dgRockBig)" stroke="rgba(40,38,36,0.4)" stroke-width="1"/>
            <!-- Subtle highlight -->
            <path d="M -80 -50 Q -50 -80 0 -78 Q 40 -75 60 -55" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="2"/>
          </g>
          <!-- Small rock, far right behind drums -->
          <g transform="translate(1010, 410)">
            <path d="M -55 18 Q -60 -22 -32 -38 Q 0 -50 35 -42 Q 60 -32 60 -8 Q 55 18 28 26 Q -10 32 -55 18 Z"
                  fill="url(#dgRockSmall)" stroke="rgba(40,38,36,0.4)" stroke-width="0.8"/>
          </g>
          <!-- Mid rock, between drums and big rock -->
          <g transform="translate(620, 430)">
            <path d="M -38 12 Q -42 -18 -22 -28 Q 0 -36 24 -28 Q 42 -16 40 4 Q 32 22 8 24 Q -22 22 -38 12 Z"
                  fill="url(#dgRockMid)" stroke="rgba(40,38,36,0.4)" stroke-width="0.6"/>
          </g>

          <!-- Bonsai pine, top right -->
          <g class="dg__bonsai">
            <!-- Trunk -->
            <path d="M 1085 295 Q 1080 250 1095 215 Q 1110 195 1115 170 Q 1112 150 1118 140"
                  fill="none" stroke="#3a2a1c" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M 1100 240 Q 1115 230 1132 220"
                  fill="none" stroke="#3a2a1c" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M 1108 195 Q 1095 188 1080 192"
                  fill="none" stroke="#3a2a1c" stroke-width="2" stroke-linecap="round"/>
            <!-- Needle clusters -->
            <g class="dg__bonsai-needles">
              <ellipse cx="1090" cy="195" rx="42" ry="22" fill="#2f5236" opacity="0.85"/>
              <ellipse cx="1090" cy="190" rx="36" ry="16" fill="#446e4f" opacity="0.7"/>
              <ellipse cx="1132" cy="218" rx="26" ry="14" fill="#2f5236" opacity="0.85"/>
              <ellipse cx="1132" cy="213" rx="22" ry="9" fill="#446e4f" opacity="0.7"/>
              <ellipse cx="1118" cy="138" rx="34" ry="20" fill="#2f5236" opacity="0.85"/>
              <ellipse cx="1118" cy="133" rx="28" ry="14" fill="#446e4f" opacity="0.7"/>
              <ellipse cx="1080" cy="245" rx="20" ry="11" fill="#2f5236" opacity="0.85"/>
            </g>
            <!-- Small red ikebana accent at base -->
            <circle cx="1095" cy="293" r="3" fill="#c4423a"/>
            <circle cx="1099" cy="297" r="2.5" fill="#c4423a"/>
            <circle cx="1090" cy="297" r="2" fill="#c4423a"/>
          </g>

          <!-- Drum kit, centered-right -->
          <!-- Floor tom -->
          <g class="dg__drum dg__drum--floor" data-voice="floor">
            <ellipse cx="710" cy="450" rx="48" ry="14" fill="rgba(0,0,0,0.18)"/>
            <rect x="662" y="380" width="96" height="80" rx="6" fill="url(#dgDrumShell)" stroke="#3a1c0e" stroke-width="0.6"/>
            <ellipse cx="710" cy="380" rx="48" ry="14" fill="url(#dgDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <ellipse cx="710" cy="380" rx="42" ry="11" fill="none" stroke="rgba(0,0,0,0.08)" stroke-width="0.5"/>
            <!-- Pulse ring (animated) -->
            <ellipse class="dg__drum-ring" cx="710" cy="380" rx="56" ry="18" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>
          <!-- Kick (slightly lower, centered) -->
          <g class="dg__drum dg__drum--kick" data-voice="kick">
            <ellipse cx="830" cy="490" rx="78" ry="20" fill="rgba(0,0,0,0.22)"/>
            <ellipse cx="830" cy="455" rx="80" ry="68" fill="url(#dgDrumShell)" stroke="#3a1c0e" stroke-width="0.8"/>
            <ellipse cx="830" cy="455" rx="62" ry="55" fill="url(#dgDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <circle cx="830" cy="455" r="9" fill="#3a1c0e" opacity="0.85"/>
            <ellipse class="dg__drum-ring" cx="830" cy="455" rx="88" ry="74" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>
          <!-- Snare -->
          <g class="dg__drum dg__drum--snare" data-voice="snare">
            <ellipse cx="940" cy="465" rx="40" ry="11" fill="rgba(0,0,0,0.18)"/>
            <rect x="903" y="416" width="74" height="56" rx="5" fill="url(#dgDrumShell)" stroke="#3a1c0e" stroke-width="0.6"/>
            <ellipse cx="940" cy="416" rx="37" ry="11" fill="url(#dgDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <ellipse cx="940" cy="416" rx="32" ry="8.5" fill="none" stroke="rgba(0,0,0,0.08)"/>
            <ellipse class="dg__drum-ring" cx="940" cy="416" rx="44" ry="14" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>
          <!-- Rack tom (small, behind, between snare and kick) -->
          <g class="dg__drum dg__drum--tom" data-voice="tom">
            <ellipse cx="855" cy="378" rx="36" ry="10" fill="rgba(0,0,0,0.16)"/>
            <rect x="819" y="338" width="72" height="48" rx="5" fill="url(#dgDrumShell)" stroke="#3a1c0e" stroke-width="0.5"/>
            <ellipse cx="855" cy="338" rx="36" ry="10" fill="url(#dgDrumHead)" stroke="#7c5532" stroke-width="0.7"/>
            <ellipse class="dg__drum-ring" cx="855" cy="338" rx="42" ry="13" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>
          <!-- Ride cymbal (right side, on stand) -->
          <g class="dg__drum dg__drum--ride" data-voice="ride">
            <line x1="990" y1="340" x2="990" y2="430" stroke="#3a3a3a" stroke-width="2"/>
            <ellipse cx="990" cy="338" rx="60" ry="11" fill="url(#dgCymbal)" stroke="#5a4220" stroke-width="0.5"/>
            <ellipse cx="990" cy="338" rx="6" ry="2" fill="#5a4220"/>
            <ellipse class="dg__drum-ring" cx="990" cy="338" rx="68" ry="14" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>
          <!-- Hi-hat (left side, on stand) -->
          <g class="dg__drum dg__drum--hat" data-voice="hat">
            <line x1="780" y1="360" x2="780" y2="450" stroke="#3a3a3a" stroke-width="2"/>
            <ellipse cx="780" cy="358" rx="40" ry="7" fill="url(#dgCymbal)" stroke="#5a4220" stroke-width="0.4"/>
            <ellipse cx="780" cy="365" rx="40" ry="7" fill="url(#dgCymbal)" stroke="#5a4220" stroke-width="0.4" opacity="0.85"/>
            <ellipse class="dg__drum-ring" cx="780" cy="362" rx="46" ry="11" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>

          <!-- Subtle moss patch in front of big rock -->
          <g opacity="0.7">
            <ellipse cx="320" cy="460" rx="50" ry="8" fill="#7ba17b" opacity="0.4"/>
            <ellipse cx="340" cy="464" rx="20" ry="4" fill="#5a8a5a"/>
            <ellipse cx="305" cy="462" rx="15" ry="3" fill="#6a9a6a"/>
            <ellipse cx="450" cy="478" rx="14" ry="3" fill="#5a8a5a"/>
          </g>

          <!-- Subtle floor reflection / shadow under everything -->
          <ellipse cx="820" cy="510" rx="220" ry="10" fill="rgba(0,0,0,0.08)"/>
        </svg>
      </div>

      <div class="dg__overlay" id="dg-overlay">
        <button class="dg__play" id="dg-play" type="button" aria-label="Begin">
          <span class="dg__play-icon" id="dg-play-icon">▶</span>
          <span class="dg__play-label" id="dg-play-label">Begin</span>
        </button>
        <p class="dg__overlay-hint">ten minutes · headphones recommended · no buttons after this</p>
      </div>

      <div class="dg__status" id="dg-status" hidden>
        <span class="dg__status-time" id="dg-status-time">00:00</span>
        <span class="dg__status-sep">of</span>
        <span class="dg__status-total">10:00</span>
        <span class="dg__status-section" id="dg-status-section">opening</span>
        <button class="dg__end" id="dg-end" type="button">end early</button>
      </div>
    </section>

    <section class="dg__about">
      <h2 class="dg__about-h">Notes from the gardener</h2>
      <p>The kit plays itself on a ten-minute arc — a small ten-section breath. It starts with one drum at a time, breaths held longer than the spaces between them. By minute four or five the kit is fuller, but never crowded. By minute eight it begins to thin again. By minute ten there is one last kick, then silence.</p>
      <p>The tempo never changes: 50 beats per minute, half-time feel. Every beat is a possible drum hit but most pass without one. The probabilities are weighted by section — what's likely on the kick downbeat in section five would feel agitated in section one.</p>
      <p>All voices are synthesized. Kick is a sine drop from 60 Hz to 30 Hz. Snare is a soft band-passed noise sweep with a small triangle blip. Toms are sine drops at higher fundamentals. Hi-hats and ride are short bursts of high-passed noise. The bell that marks the section transitions is a 1.2 kHz triangle with a sub-octave partial and a long decay.</p>
      <p>There are no decisions to make once it starts. The page is meant to play like a screensaver — set it on a second monitor, leave the room, come back. The point isn't to compose anything; it's to let a small room exist for ten minutes.</p>
      <p>Sister surfaces: <a href="/cast-wander">/cast-wander</a> · <a href="/cast-room">/cast-room</a> · <a href="/cast-tide">/cast-tide</a> · <a href="/cast-cradle">/cast-cradle</a>.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --dg-frame: #1f5e3a;
      --dg-frame-shadow: #154428;
      --dg-cream: #f4f1e5;
      --dg-sand: #e3d8b6;
      --dg-ink: #1a1a1a;
      --dg-walnut: #5a3422;
      --dg-text: #2a3326;
      --dg-text-dim: #5a6356;
      --dg-text-dimmer: #8a9285;
      --dg-flame: #d68f2c;
      --dg-rose: #c4423a;
    }

    body:has(.dg) {
      background:
        radial-gradient(circle at 50% 20%, #f8f6ec 0%, #ece8d8 70%);
      color: var(--dg-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dg {
      max-width: 1200px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    .dg__hero {
      text-align: left;
      max-width: 760px;
      margin: 0 auto 36px;
    }
    .dg__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dg-frame);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .dg__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--dg-text);
    }
    .dg__sub {
      font-size: 17px;
      line-height: 1.55;
      color: var(--dg-text-dim);
      margin: 0;
    }

    /* STAGE */
    .dg__stage {
      position: relative;
      margin-bottom: 36px;
    }

    .dg__pavilion {
      position: relative;
      aspect-ratio: 2 / 1;
      max-height: 70vh;
      background: var(--dg-cream);
      border: 14px solid var(--dg-frame);
      border-radius: 4px;
      box-shadow:
        0 24px 60px rgba(31,94,58,0.18),
        inset 0 0 0 3px rgba(255,255,255,0.4);
      overflow: hidden;
    }
    /* Pavilion structural frame */
    .dg__rail {
      position: absolute;
      left: 0;
      right: 0;
      height: 16px;
      background: var(--dg-frame);
      z-index: 2;
    }
    .dg__rail--top    { top: 0; }
    .dg__rail--bottom { bottom: 0; }
    .dg__post {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 14px;
      background: var(--dg-frame);
      z-index: 2;
    }
    .dg__post--left  { left: 33%; }
    .dg__post--right { right: 33%; }

    .dg__scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Drum pulse animation */
    @keyframes dgPulse {
      0%   { opacity: 0.8; transform: scale(1); }
      100% { opacity: 0;   transform: scale(1.18); }
    }
    .dg__drum-ring.dg__drum-ring--pulse {
      animation: dgPulse 1.4s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .dg__drum--struck { animation: dgStrike 0.3s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes dgStrike {
      0%   { transform: translateY(0); }
      30%  { transform: translateY(2px) scale(0.985); }
      100% { transform: translateY(0); }
    }

    /* Bonsai gentle sway */
    .dg__bonsai-needles {
      transform-origin: 1100px 240px;
      animation: dgSway 11s ease-in-out infinite alternate;
    }
    @keyframes dgSway {
      from { transform: rotate(-1.2deg); }
      to   { transform: rotate(1.2deg); }
    }

    /* OVERLAY (play screen before audio starts) */
    .dg__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(244,241,229,0.35) 0%, rgba(244,241,229,0.08) 60%, transparent 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .dg__stage[data-state="playing"] .dg__overlay,
    .dg__stage[data-state="ended"] .dg__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .dg__stage[data-state="ended"] .dg__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .dg__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .dg__play-icon {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: var(--dg-frame);
      color: #fff;
      font-size: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 14px 36px rgba(31,94,58,0.32),
        inset 0 -4px 8px rgba(0,0,0,0.12),
        inset 0 4px 6px rgba(255,255,255,0.18);
      transition: transform 100ms ease;
    }
    .dg__play:hover .dg__play-icon { transform: scale(1.04); }
    .dg__play:active .dg__play-icon { transform: scale(0.96); }
    .dg__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: var(--dg-text);
      letter-spacing: 0.04em;
    }
    .dg__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--dg-text-dimmer);
      text-transform: lowercase;
      margin: 0;
    }

    /* STATUS (minimal, only visible while playing) */
    .dg__status {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(244,241,229,0.85);
      border: 1px solid rgba(31,94,58,0.18);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--dg-text-dim);
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .dg__stage[data-state="playing"] .dg__status,
    .dg__stage[data-state="ended"] .dg__status {
      opacity: 1;
    }
    .dg__stage[data-state="ended"] .dg__status {
      opacity: 0.7;
    }
    .dg__status-time {
      font-weight: 600;
      color: var(--dg-text);
      font-variant-numeric: tabular-nums;
    }
    .dg__status-sep { color: var(--dg-text-dimmer); }
    .dg__status-total { color: var(--dg-text); }
    .dg__status-section {
      margin-left: 12px;
      color: var(--dg-frame);
      text-transform: uppercase;
    }
    .dg__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(31,94,58,0.32);
      border-radius: 8px;
      color: var(--dg-frame);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .dg__end:hover { background: rgba(31,94,58,0.08); }

    /* ABOUT */
    .dg__about {
      max-width: 720px;
      margin: 0 auto;
      padding: 12px 0 0;
    }
    .dg__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dg-text);
      margin: 0 0 14px;
    }
    .dg__about p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--dg-text-dim);
      margin: 0 0 14px;
    }
    .dg__about a {
      color: var(--dg-frame);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .dg__about a:hover { text-decoration-thickness: 2px; }

    @media (max-width: 640px) {
      .dg__pavilion { border-width: 10px; }
      .dg__post--left  { left: 30%; width: 10px; }
      .dg__post--right { right: 30%; width: 10px; }
      .dg__rail { height: 12px; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- voices ----
    type Voice = 'kick' | 'snare' | 'tom' | 'floor' | 'hat' | 'ride' | 'bell';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.55;
      masterGain.connect(ctx.destination);
    }
    function getNoiseBuffer(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 2;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }

    function playKick(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(70, t);
      osc.frequency.exponentialRampToValueAtTime(32, t + 0.16);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.6 * vel, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.45);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.5);
      flashDrum('kick');
    }

    function playSnare(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const src = ctx.createBufferSource();
      src.buffer = getNoiseBuffer(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 2200;
      bp.Q.value = 0.7;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.34 * vel, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      src.connect(bp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.22);
      // soft tone
      const tone = ctx.createOscillator();
      const tg = ctx.createGain();
      tone.type = 'triangle';
      tone.frequency.value = 200;
      tg.gain.setValueAtTime(0.0001, t);
      tg.gain.exponentialRampToValueAtTime(0.16 * vel, t + 0.003);
      tg.gain.exponentialRampToValueAtTime(0.0001, t + 0.11);
      tone.connect(tg).connect(masterGain);
      scheduler.trackSource(tone);
      tone.start(t);
      tone.stop(t + 0.13);
      flashDrum('snare');
    }

    function playTom(t: number, fund = 180, vel = 1, voiceVisual: Voice = 'tom') {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(fund, t);
      osc.frequency.exponentialRampToValueAtTime(fund * 0.55, t + 0.32);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.32 * vel, t + 0.007);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.5);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.55);
      flashDrum(voiceVisual);
    }
    function playFloor(t: number, vel = 1) { playTom(t, 100, vel, 'floor'); }

    function playHat(t: number, vel = 1, open = false) {
      if (!ctx || !scheduler || !masterGain) return;
      const src = ctx.createBufferSource();
      src.buffer = getNoiseBuffer(ctx);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 7800;
      const g = ctx.createGain();
      const dec = open ? 0.32 : 0.05;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.22 * vel, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dec);
      src.connect(hp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + dec + 0.04);
      flashDrum('hat');
    }

    function playRide(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // shimmering: noise band + sustained mid tone
      const src = ctx.createBufferSource();
      src.buffer = getNoiseBuffer(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 5200;
      bp.Q.value = 0.5;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.18 * vel, t + 0.04);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
      src.connect(bp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 2.0);
      // pinging mid partial
      const osc = ctx.createOscillator();
      const og = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = 1400;
      og.gain.setValueAtTime(0.0001, t);
      og.gain.exponentialRampToValueAtTime(0.04 * vel, t + 0.005);
      og.gain.exponentialRampToValueAtTime(0.0001, t + 0.8);
      osc.connect(og).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.85);
      flashDrum('ride');
    }

    function playBell(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // bell with hum + nominal
      const partials = [
        { freq: 600, gain: 0.18, decay: 4.0 },
        { freq: 1200, gain: 0.12, decay: 3.0 },
        { freq: 1800, gain: 0.06, decay: 1.6 },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.008);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      flashDrum('ride');
    }

    function flashDrum(voice: Voice) {
      const group = document.querySelector(`.dg__drum--${voice}`);
      if (!group) return;
      group.classList.remove('dg__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('dg__drum--struck');
      setTimeout(() => group.classList.remove('dg__drum--struck'), 320);
      const ring = group.querySelector('.dg__drum-ring');
      if (ring) {
        ring.classList.remove('dg__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('dg__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('dg__drum-ring--pulse'), 1500);
      }
    }

    // ---- arc (10 sections, each ~60s) ----
    // Section spec: sparsity [0..1], voice weights, optional events
    type Section = {
      name: string;
      sparsity: number;        // probability that any beat triggers ANY voice
      weights: Partial<Record<Voice, number>>;  // relative weights of voices
      transitionBell?: boolean;
    };
    const SECTIONS: Section[] = [
      { name: 'opening',     sparsity: 0.10, weights: { kick: 4, hat: 1, ride: 0.3 },                             transitionBell: true },
      { name: 'first breath',sparsity: 0.20, weights: { kick: 5, snare: 1, hat: 2, ride: 0.5 } },
      { name: 'waking',      sparsity: 0.35, weights: { kick: 5, snare: 3, hat: 3, tom: 0.6, ride: 0.4 } },
      { name: 'midmorning',  sparsity: 0.55, weights: { kick: 5, snare: 4, hat: 4, tom: 1, floor: 0.8, ride: 0.6 } },
      { name: 'high sun',    sparsity: 0.72, weights: { kick: 5, snare: 5, hat: 5, tom: 1.5, floor: 1.5, ride: 1 }, transitionBell: true },
      { name: 'noon',        sparsity: 0.82, weights: { kick: 5, snare: 5, hat: 6, tom: 2, floor: 2, ride: 1.3 } },
      { name: 'after',       sparsity: 0.70, weights: { kick: 5, snare: 4, hat: 5, tom: 1.5, floor: 1.5, ride: 1 } },
      { name: 'descending',  sparsity: 0.50, weights: { kick: 4, snare: 3, hat: 3, tom: 1, floor: 0.8, ride: 0.6 } },
      { name: 'cooling',     sparsity: 0.28, weights: { kick: 4, snare: 1.5, hat: 2, tom: 0.5, ride: 0.4 },        transitionBell: true },
      { name: 'last light',  sparsity: 0.12, weights: { kick: 3, hat: 1, ride: 0.4 } },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 50;
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 2;  // half-beats / eighth notes (slow tempo → 8th feels right)
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    // ---- transport ----
    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;  // global slot index
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let lastBellSection = -1;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) {
        r -= w;
        if (r <= 0) return v;
      }
      return entries[0][0];
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.6;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        const totalElapsed = Math.max(0, elapsed);
        if (totalElapsed >= TOTAL_SEC) {
          // arc complete
          schedulingComplete = true;
          break;
        }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(totalElapsed / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        // Section-transition bell: fire once at the start of any section that has transitionBell
        if (section.transitionBell && sectionIdx !== lastBellSection) {
          // fire bell at the start of this section (the very first slot in this section)
          const sectionStartSec = sectionIdx * SECTION_LEN_SEC;
          // Check if nextSlotTime corresponds to the first slot of this section
          if (Math.abs(elapsed - sectionStartSec) < SLOT_SEC * 0.6) {
            playBell(nextSlotTime, 0.7);
            lastBellSection = sectionIdx;
          }
        }

        // Whether to fire any voice this slot
        // Downbeats (slot index a multiple of 4 = on a quarter note in 4/4 half-time) get a bonus
        const slotInBar = slotIdx % 8;  // 4 beats × 2 = 8 slots per bar
        const isDownbeat = slotInBar === 0;
        const isBackbeat = slotInBar === 4;
        const isOffbeat = slotInBar % 2 === 1;

        let p = section.sparsity;
        // Boost on downbeats so the pulse feels grounded even at low sparsity
        if (isDownbeat) p = Math.min(1, p * 2.4);
        else if (isBackbeat) p = Math.min(1, p * 1.6);
        else if (isOffbeat) p = p * 0.55;  // offbeat 8ths less likely

        if (Math.random() < p) {
          // Pick a voice
          let voice = pickWeighted(section.weights);
          // On downbeats, bias hard toward kick
          if (isDownbeat && Math.random() < 0.62 && section.weights.kick) voice = 'kick';
          else if (isBackbeat && Math.random() < 0.55 && section.weights.snare) voice = 'snare';
          if (voice) {
            const vel = isDownbeat ? 1.0 : (isBackbeat ? 0.9 : 0.6 + Math.random() * 0.3);
            const t = nextSlotTime;
            switch (voice) {
              case 'kick':  playKick(t, vel); break;
              case 'snare': playSnare(t, vel); break;
              case 'tom':   playTom(t, 200, vel); break;
              case 'floor': playFloor(t, vel); break;
              case 'hat':   playHat(t, vel, isOffbeat && Math.random() < 0.18); break;
              case 'ride':  playRide(t, vel * 0.7); break;
              case 'bell':  playBell(t, vel); break;
            }
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 80);
    }

    let schedulingComplete = false;
    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('dg-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('dg-status-section')!.textContent = SECTIONS[si].name;

      // End-of-arc detection: 0.5s after total elapsed, transition to ended state
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      lastBellSection = -1;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('dg-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('dg-status')!.removeAttribute('hidden');
      scheduleAhead();
      tickUi();
    }

    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      // Let in-flight notes ring out; only stopAll on early-end
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('dg-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('dg-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('dg-play')!.addEventListener('click', () => {
        document.getElementById('dg-stage')!.setAttribute('data-state', 'playing');
        startPlaying();
      });
      document.getElementById('dg-end')!.addEventListener('click', () => {
        stopPlaying(false);
      });
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
