---
import BaseLayout from '../layouts/BaseLayout.astro';
import DrumCompendiumAdArt from '../components/DrumCompendiumAdArt.astro';
import InteractiveAdStage from '../components/InteractiveAdStage.astro';
import { ART_KITTY_CAMPAIGN, BEACH_BLANKET_PROMOTION_CAMPAIGN, BEACH_COMMONS_V5_CAMPAIGN, BELLS_BLOOM_CAMPAIGN, DIGITAL_PETS_COUNSEL_CAMPAIGN, DRUM_COMPENDIUM_CAMPAIGN, DRUM_NOUN_UNIVERSE_CAMPAIGN, HOLDERS_CUT_CAMPAIGN, INDUSTRY_NEXT_CAMPAIGN, LOCAL_STAR_COMMONS_CAMPAIGN, NETWORK_EL_SEGUNDO_CAMPAIGN, NOUN_BATTLER_ANNUAL_CAMPAIGN, NOUNS_ABOUT_CAMPAIGN, OPEN_AD_NETWORK, OPEN_AD_PLACEMENT, OPEN_AD_PUBLISHERS, PERMISSION_LAB_CAMPAIGN, POINTCAST_ADS } from '../lib/open-ad-network';

const digitalPetsCounselAds = POINTCAST_ADS.filter((ad) => ad.campaign === DIGITAL_PETS_COUNSEL_CAMPAIGN.id);
const beachBlanketAds = POINTCAST_ADS.filter((ad) => ad.campaign === BEACH_BLANKET_PROMOTION_CAMPAIGN.id);
const nounBattlerAnnualAds = POINTCAST_ADS.filter((ad) => ad.campaign === NOUN_BATTLER_ANNUAL_CAMPAIGN.id);
const beachCommonsV5Ads = POINTCAST_ADS.filter((ad) => ad.campaign === BEACH_COMMONS_V5_CAMPAIGN.id);
const drumCompendiumAds = POINTCAST_ADS.filter((ad) => ad.campaign === DRUM_COMPENDIUM_CAMPAIGN.id);
const drumUniverseAd = POINTCAST_ADS.find((ad) => ad.campaign === DRUM_NOUN_UNIVERSE_CAMPAIGN.id);
const industryNextAd = POINTCAST_ADS.find((ad) => ad.campaign === INDUSTRY_NEXT_CAMPAIGN.id);
const nounsAboutAds = POINTCAST_ADS.filter((ad) => ad.campaign === NOUNS_ABOUT_CAMPAIGN.id);
const permissionLabAds = POINTCAST_ADS.filter((ad) => ad.campaign === PERMISSION_LAB_CAMPAIGN.id);
const artKittyAds = POINTCAST_ADS.filter((ad) => ad.campaign === ART_KITTY_CAMPAIGN.id);
const networkElSegundoAds = POINTCAST_ADS.filter((ad) => ad.campaign === NETWORK_EL_SEGUNDO_CAMPAIGN.id);
const localStarCommonsAd = POINTCAST_ADS.find((ad) => ad.campaign === LOCAL_STAR_COMMONS_CAMPAIGN.id);
const bellsBloomAd = POINTCAST_ADS.find((ad) => ad.campaign === BELLS_BLOOM_CAMPAIGN.id);
const networkElSegundoAuthUrl = '/auth/project?target=network-el-segundo&return_to=https%3A%2F%2Fnetwork-el-segundo.mhoydich.chatgpt.site%2F&source=pointcast_ad';
const holdersCutAd = POINTCAST_ADS.find((ad) => ad.campaign === HOLDERS_CUT_CAMPAIGN.id);
const interactiveAds = [digitalPetsCounselAds[0], beachBlanketAds[0], nounBattlerAnnualAds[2], beachCommonsV5Ads[2], bellsBloomAd, localStarCommonsAd, networkElSegundoAds[0], holdersCutAd].filter((ad) => ad !== undefined);
---

<BaseLayout
  title="Open Ad Network"
  description="PointCast's public contextual ad rail: visible records, no behavioral profiles, and an explicit prototype boundary for tez settlement."
>
  <main class="ad-desk">
    <header class="ad-desk__hero">
      <p class="mono">POINTCAST AD DESK · PUBLIC BETA 01</p>
      <h1>Ads anyone<br /><em>can inspect.</em></h1>
      <div class="ad-desk__lede">
        <p>Useful doors placed by context, not by surveillance. Aggregate viewability and click counts are public; visitor profiles do not exist.</p>
        <p>Reservation and tez settlement are designed, but not live. Nothing here connects a wallet or moves funds.</p>
      </div>
      <nav class="mono" aria-label="Ad desk resources">
        <a href="/ads/report">LIVE PUBLISHING REPORT</a>
        <a href="/ads.json">PUBLIC RECEIPT · JSON</a>
        <a href="mailto:hello@pointcast.xyz?subject=PointCast%20Open%20Ad%20Network">ASK ABOUT A PLACEMENT</a>
      </nav>
    </header>

    <section class="ad-desk__placement" aria-labelledby="placement-title">
      <div>
        <p class="mono">OPEN PLACEMENT · {OPEN_AD_PLACEMENT.id}</p>
        <h2 id="placement-title">{OPEN_AD_PLACEMENT.placement}</h2>
        <p>{OPEN_AD_PLACEMENT.note}</p>
      </div>
      <dl class="mono">
        <div><dt>FORMAT</dt><dd>{OPEN_AD_PLACEMENT.format}</dd></div>
        <div><dt>PUBLIC PRICE</dt><dd>{OPEN_AD_PLACEMENT.priceTezPerWeek} ꜩ / WEEK</dd></div>
        <div><dt>REPORTING</dt><dd>AGGREGATE IMPRESSIONS + CLICKS</dd></div>
        <div><dt>SETTLEMENT</dt><dd>PROTOTYPE · NOT LIVE</dd></div>
      </dl>
    </section>

    <section class="ad-desk__lab" aria-labelledby="interactive-ad-lab-title">
      <header>
        <p class="mono">LIVE 3D CREATIVE LAB · NO AUTOPLAY</p>
        <h2 id="interactive-ad-lab-title">Move through<br /><em>the campaign.</em></h2>
        <p>Three dimensional house ads made for the modern web—not a video pretending to be interactive. Tilt with a pointer or the arrow keys, then press enter to open the door.</p>
      </header>
      <div class="ad-desk__lab-stages">
        {interactiveAds.map((ad, index) => <InteractiveAdStage ad={ad} index={index} />)}
      </div>
      <p class="ad-desk__lab-boundary mono">CSS 3D · KEYBOARD OPERABLE · REDUCED-MOTION SAFE · POINTER MOVEMENT NEVER LEAVES THE DEVICE</p>
    </section>

    <section class="ad-desk__network" aria-labelledby="digital-pets-counsel-campaign-title">
      <header>
        <p class="mono">LAUNCH-WEEK COMEDY CAMPAIGN · {DIGITAL_PETS_COUNSEL_CAMPAIGN.id}</p>
        <h2 id="digital-pets-counsel-campaign-title">The pet read<br /><em>the fine print.</em></h2>
        <p>Three editorial doors turn the complaint, the vibes allegation, and the appliance strike into a sitewide comedy campaign. One creative is pinned on public PointCast surfaces outside the story itself; reciprocal publishers can prefer the same campaign through the portable unit.</p>
        <p>The story and five-page legal brief are free editorial fiction. No pet, appliance, lawyer, live mediation service, paid placement, or legal advice is offered.</p>
        <nav class="mono" aria-label="My Pet Has Retained Counsel campaign links">
          <a href="/digital-pets/counsel">READ THE STORY</a>
          <a href="/downloads/my-pet-has-retained-counsel-brief.pdf">OPEN THE FIVE-PAGE BRIEF</a>
          <a href="/digital-pets/counsel.json">OPEN THE STORY RECORD</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {digitalPetsCounselAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} My Pet Has Retained Counsel house-ad creative`} width="960" height="1200" loading={index === 0 ? 'eager' : 'lazy'} />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__network" aria-labelledby="beach-blanket-campaign-title">
      <header>
        <p class="mono">FULL PROMOTION CAMPAIGN · {BEACH_BLANKET_PROMOTION_CAMPAIGN.id}</p>
        <h2 id="beach-blanket-campaign-title">A blanket is<br /><em>a tiny public room.</em></h2>
        <p>Four channel-specific doors promote The Beach Blanket Review through social architecture, an exact-price challenge, the full service-journalism post, and the unusual transparency of an affiliate review carrying no affiliate tracking.</p>
        <p>The campaign uses credited maker or merchant photographs as editorial references on PointCast. It does not imply hands-on testing, supplied products, merchant permission for third-party republication, a live event, affiliate enrollment, paid media, or promised coverage.</p>
        <nav class="mono" aria-label="Beach Blanket Review campaign links">
          <a href="/beach-commons/v8">READ THE REVIEW</a>
          <a href="/beach-commons/v8/share">OPEN THE PROMOTION DESK</a>
          <a href="/beach-commons/v8/share.json">OPEN THE PROMOTION PACKET</a>
          <a href="/press/beach-commons-v8-publishes-beach-blanket-review">PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {beachBlanketAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Beach Blanket Review house-ad creative`} width="960" height="960" loading={index === 0 ? 'eager' : 'lazy'} />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__network" aria-labelledby="noun-battler-annual-campaign-title">
      <header>
        <p class="mono">OPENING-WEEK SPORTS DESK CAMPAIGN · {NOUN_BATTLER_ANNUAL_CAMPAIGN.id}</p>
        <h2 id="noun-battler-annual-campaign-title">The box score became<br /><em>a civilization.</em></h2>
        <p>Three newspaper-sports doors move from the founding deterministic duel to the 30-v-30 league and its playable press-box projection. The latest annual is pinned across PointCast by page context for opening week.</p>
        <p>The annual is free and editorial. The matchup lab creates an unsaved deterministic projection; it is not an official league result, betting line, odds product, or wager.</p>
        <nav class="mono" aria-label="Noun Battler Annual campaign links">
          <a href="/noun-battler-annual">READ THE BATTLE RECORD</a>
          <a href="/noun-battler-annual/share">OPEN THE SHARE KIT</a>
          <a href="/press/noun-battler-annual-publishes-browser-league-history">PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {nounBattlerAnnualAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Noun Battler Annual house-ad creative`} width="1536" height="1024" loading={index === 0 ? 'eager' : 'lazy'} />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__network" aria-labelledby="beach-commons-v5-campaign-title">
      <header>
        <p class="mono">NEW RECIPROCAL HOUSE CAMPAIGN · {BEACH_COMMONS_V5_CAMPAIGN.id}</p>
        <h2 id="beach-commons-v5-campaign-title">Weather is<br /><em>the curriculum.</em></h2>
        <p>Three visual doors move from the complete Weather School to Water Accounting Court and the sunset Tide Parliament. The campaign is preferred across every reciprocal publisher, rotates by page context and day, and records aggregate impressions and clicks without visitor profiles.</p>
        <p>This is distribution for an unofficial, unpermitted field study—not advertising for a live event, school, parliament, installation, authority, or invitation to build.</p>
        <nav class="mono" aria-label="Beach Commons V5 campaign links">
          <a href="/beach-commons/v5">ENTER THE WEATHER SCHOOL</a>
          <a href="/press/beach-commons-v5-opens-weather-school-and-tide-parliament">PRESS FILING</a>
          <a href="/b/0513">BLOCK 0513</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {beachCommonsV5Ads.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Beach Commons V5 house-ad creative`} width="1536" height="1024" loading="lazy" />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    {holdersCutAd && (
      <section class="ad-desk__holders" aria-labelledby="holders-cut-campaign-title">
        {holdersCutAd.image && (
          <a href={holdersCutAd.href} class="ad-desk__holders-art">
            <img src={holdersCutAd.image} alt="The Holders' Cut public-preview campaign poster" width="1200" height="630" />
          </a>
        )}
        <div>
          <p class="mono">POINTCAST + RALLY FOOTER CAMPAIGN · {HOLDERS_CUT_CAMPAIGN.id}</p>
          <h2 id="holders-cut-campaign-title">44 plates.<br /><em>No finish line.</em></h2>
          <p>{holdersCutAd.copy}</p>
          <p>The portable unit runs here and in the Rally footer. It links to a public preview; Mainnet minting and holder distributions remain inactive.</p>
          <nav class="mono" aria-label="The Holders' Cut campaign links">
            <a href={holdersCutAd.href}>OPEN THE PUBLIC PREVIEW</a>
            <a href="/press/the-holders-cut-opens-44-plate-unlimited-edition-preview">PRESS FILING</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </div>
      </section>
    )}

    <section class="ad-desk__federation" aria-labelledby="federation-title">
      <header>
        <p class="mono">RECIPROCAL NETWORK · {OPEN_AD_NETWORK.id}</p>
        <h2 id="federation-title">One public inventory.<br /><em>Many independent doors.</em></h2>
        <p>The same inspectable house rotation now travels across PointCast, Industry Next, Allworthy, Passportz, and Common Hours / Stampz. Each property keeps its own design and editorial voice; the unit only exchanges a clearly labeled contextual door.</p>
        <nav class="mono" aria-label="Portable network resources">
          <a href={OPEN_AD_NETWORK.inventoryUrl}>PUBLIC INVENTORY</a>
          <a href={OPEN_AD_NETWORK.embedUrl}>PORTABLE SCRIPT</a>
          <a href="/ads/report">PUBLISHER COUNTS</a>
        </nav>
      </header>
      <ol>
        {OPEN_AD_PUBLISHERS.map((publisher) => (
          <li><a href={publisher.url}><span class="mono">{publisher.id}</span><strong>{publisher.name}</strong><p>{publisher.surface}</p><i class="mono">OPEN →</i></a></li>
        ))}
      </ol>
      <p class="ad-desk__federation-boundary mono">CONTEXTUAL DAILY ROTATION · NO COOKIES · NO CROSS-SITE VISITOR ID · NO WALLET DATA · HOUSE INVENTORY ONLY</p>
    </section>

    {bellsBloomAd && (
      <section class="ad-desk__commons" aria-labelledby="bells-bloom-campaign-title">
        <a href={bellsBloomAd.href} class="ad-desk__commons-art">
          {bellsBloomAd.image && (
            <img src={bellsBloomAd.image} alt="Bells / Bloom PointCast Showcast campaign artwork" width="1200" height="630" />
          )}
        </a>
        <div>
          <p class="mono">ARCHIVE SHOWCAST · PORTABLE HOUSE CAMPAIGN · {BELLS_BLOOM_CAMPAIGN.id}</p>
          <h2 id="bells-bloom-campaign-title">A bell is a flower<br /><em>you can hear.</em></h2>
          <p>{bellsBloomAd.copy}</p>
          <p>Four movements drift through signal, soft structure, blue hour, and afterimage. Every work keeps a direct link to its source Midjourney job.</p>
          <nav class="mono" aria-label="Bells / Bloom campaign links">
            <a href={bellsBloomAd.href}>ENTER THE SHOWCAST</a>
            <a href="/showcast/bells-bloom.json">READ THE 28-WORK MANIFEST</a>
            <a href="/b/0492">BLOCK 0492</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </div>
      </section>
    )}

    {localStarCommonsAd && (
      <section class="ad-desk__commons" aria-labelledby="local-star-commons-campaign-title">
        <a href={localStarCommonsAd.href} class="ad-desk__commons-art">
          {localStarCommonsAd.image && (
            <img src={localStarCommonsAd.image} alt="LOCAL STAR COMMONS product-family campaign artwork" width="1731" height="909" />
          )}
        </a>
        <div>
          <p class="mono">FOUNDING MOVEMENT · SITEWIDE HOUSE CAMPAIGN · {LOCAL_STAR_COMMONS_CAMPAIGN.id}</p>
          <h2 id="local-star-commons-campaign-title">Useful things.<br /><em>Governed in common.</em></h2>
          <p>{localStarCommonsAd.copy}</p>
          <p>LOCAL STAR, AIR, WATER, LIGHT, CARE, and POWER enter a contribution-based founding commons centered on a 25-mile El Segundo study. Governance is off-chain; no token, treasury, fundraising, binding vote, or Mainnet action is active.</p>
          <nav class="mono" aria-label="LOCAL STAR COMMONS campaign links">
            <a href={localStarCommonsAd.href}>ENTER THE COMMONS</a>
            <a href="/press/local-star-commons-opens-contribution-governed-quality-of-life-movement">PRESS FILING</a>
            <a href="/b/0490">BLOCK 0490</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </div>
      </section>
    )}

    <section class="ad-desk__network" aria-labelledby="network-el-segundo-campaign-title">
      <header>
        <p class="mono">SITEWIDE HOUSE CAMPAIGN · {NETWORK_EL_SEGUNDO_CAMPAIGN.id}</p>
        <h2 id="network-el-segundo-campaign-title">The first 100<br /><em>make the signal.</em></h2>
        <p>Six creative doors connect the First 100 Signal, 100 Windows, the signed Local Signal Field Kit, and the Mesh Commons two-year physical-network plan. Joining the wallet artwork is a free message signature; the field kit and mesh plan require no wallet. The 50% post-sale participant distribution remains a published prototype rule—not a live sale, payout contract, or promise of yield.</p>
        <nav class="mono" aria-label="Network El Segundo campaign links">
          <a href={networkElSegundoAuthUrl}>ENTER THE FIRST 100 SIGNAL</a>
          <a href="/network-el-segundo/field-kit">OPEN THE LOCAL FIELD KIT</a>
          <a href="/network-el-segundo/mesh-commons">OPEN THE MESH COMMONS PLAN</a>
          <a href="/network-el-segundo/share">OPEN THE RELAY KIT</a>
          <a href="/press/network-el-segundo-publishes-mesh-commons-two-year-plan">LATEST PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {networkElSegundoAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Network El Segundo house-ad creative`} width="1312" height="736" loading="lazy" />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__kitty" aria-labelledby="art-kitty-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {ART_KITTY_CAMPAIGN.id}</p>
        <h2 id="art-kitty-campaign-title">Make one.<br /><em>Fund the next one.</em></h2>
        <p>Three contextual doors into HOME / Art Kitty: 31 public works, two permanent series, and a one-tez collector edition whose proceeds split evenly between the artist and future art.</p>
        <nav class="mono" aria-label="Art Kitty campaign links">
          <a href="https://art-kitty-editions.mhoydich.chatgpt.site/series/02">ENTER SERIES 02</a>
          <a href="/press/home-art-kitty-opens-31-one-tez-collector-editions">PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {artKittyAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Art Kitty house-ad creative`} width="1024" height="1024" loading="lazy" />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__nouns" aria-labelledby="nouns-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {NOUNS_ABOUT_CAMPAIGN.id}</p>
        <h2 id="nouns-campaign-title">Permission is<br /><em>the starting point.</em></h2>
        <p>Three contextual ways into a short Industry Next field note on why Nouns and CC0 can remain unusually interesting—without making the reader sit through a full history.</p>
        <nav class="mono" aria-label="Nouns About campaign links">
          <a href="https://www.industrynext.xyz/about/">READ ABOUT NOUNS</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {nounsAboutAds.map((ad, index) => (
          <li>
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    {industryNextAd && (
      <section class="ad-desk__nouns" aria-labelledby="industry-next-campaign-title">
        <header>
          <p class="mono">DIRECT HOUSE AD · {INDUSTRY_NEXT_CAMPAIGN.id}</p>
          <h2 id="industry-next-campaign-title">Culture is<br /><em>a building material.</em></h2>
          <p>{industryNextAd.copy}</p>
          <nav class="mono" aria-label="Industry Next campaign links">
            <a href={industryNextAd.href}>{industryNextAd.cta.toUpperCase()}</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </header>
        <ol>
          <li>
            <span class="mono">CREATIVE 01 · {industryNextAd.id}</span>
            <strong>{industryNextAd.headline}</strong>
            <p>{industryNextAd.copy}</p>
            <a class="mono" href={industryNextAd.href}>{industryNextAd.cta} →</a>
          </li>
        </ol>
      </section>
    )}

    <section class="ad-desk__nouns" aria-labelledby="permission-lab-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {PERMISSION_LAB_CAMPAIGN.id}</p>
        <h2 id="permission-lab-campaign-title">Make first.<br /><em>Ask never.</em></h2>
        <p>Three contextual doors into Industry Next Permission Lab: remix an authentic CC0 Noun, export a square poster, or deliberately publish it to a public stream. No account or wallet required.</p>
        <nav class="mono" aria-label="Permission Lab campaign links">
          <a href="https://www.industrynext.xyz/make/">ENTER PERMISSION LAB</a>
          <a href="https://www.industrynext.xyz/made/">SEE THE MADE STREAM</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {permissionLabAds.map((ad, index) => (
          <li>
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    {drumUniverseAd && (
      <section class="ad-desk__universe" aria-labelledby="drum-universe-title">
        {drumUniverseAd.image && (
          <a href={drumUniverseAd.href} class="ad-desk__universe-art">
            <img src={drumUniverseAd.image} alt="PointCast Drum Noun Universe campaign poster" width="1024" height="1536" />
          </a>
        )}
        <div>
          <p class="mono">FEATURED HOUSE CAMPAIGN · {DRUM_NOUN_UNIVERSE_CAMPAIGN.id}</p>
          <h2 id="drum-universe-title">115 rooms.<br /><em>One shared pulse.</em></h2>
          <p>{drumUniverseAd.copy}</p>
          <p>The feature unit runs near the top of the homepage and the compact creative enters the contextual rail on other public non-Drum pages. Drum routes retain their own six-part compendium series.</p>
          <nav class="mono" aria-label="Drum Noun Universe campaign links">
            <a href={drumUniverseAd.href}>ENTER THE UNIVERSE</a>
            <a href="/press/pointcast-opens-115-room-drum-noun-universe">PRESS RELEASE</a>
            <a href="/posts/pointcast-drum-noun-universe">FIELD NOTE</a>
          </nav>
        </div>
