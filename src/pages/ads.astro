---
import BaseLayout from '../layouts/BaseLayout.astro';
import DrumCompendiumAdArt from '../components/DrumCompendiumAdArt.astro';
import InteractiveAdStage from '../components/InteractiveAdStage.astro';
import { ART_KITTY_CAMPAIGN, DRUM_COMPENDIUM_CAMPAIGN, DRUM_NOUN_UNIVERSE_CAMPAIGN, HOLDERS_CUT_CAMPAIGN, INDUSTRY_NEXT_CAMPAIGN, NETWORK_EL_SEGUNDO_CAMPAIGN, NOUNS_ABOUT_CAMPAIGN, OPEN_AD_NETWORK, OPEN_AD_PLACEMENT, OPEN_AD_PUBLISHERS, PERMISSION_LAB_CAMPAIGN, POINTCAST_ADS } from '../lib/open-ad-network';

const drumCompendiumAds = POINTCAST_ADS.filter((ad) => ad.campaign === DRUM_COMPENDIUM_CAMPAIGN.id);
const drumUniverseAd = POINTCAST_ADS.find((ad) => ad.campaign === DRUM_NOUN_UNIVERSE_CAMPAIGN.id);
const industryNextAd = POINTCAST_ADS.find((ad) => ad.campaign === INDUSTRY_NEXT_CAMPAIGN.id);
const nounsAboutAds = POINTCAST_ADS.filter((ad) => ad.campaign === NOUNS_ABOUT_CAMPAIGN.id);
const permissionLabAds = POINTCAST_ADS.filter((ad) => ad.campaign === PERMISSION_LAB_CAMPAIGN.id);
const artKittyAds = POINTCAST_ADS.filter((ad) => ad.campaign === ART_KITTY_CAMPAIGN.id);
const networkElSegundoAds = POINTCAST_ADS.filter((ad) => ad.campaign === NETWORK_EL_SEGUNDO_CAMPAIGN.id);
const holdersCutAd = POINTCAST_ADS.find((ad) => ad.campaign === HOLDERS_CUT_CAMPAIGN.id);
const interactiveAds = [networkElSegundoAds[0], holdersCutAd, artKittyAds[0]].filter((ad) => ad !== undefined);
---

<BaseLayout
  title="Open Ad Network"
  description="PointCast's public contextual ad rail: visible records, no behavioral profiles, and an explicit prototype boundary for tez settlement."
>
  <main class="ad-desk">
    <header class="ad-desk__hero">
      <p class="mono">POINTCAST AD DESK · PUBLIC BETA 01</p>
      <h1>Ads anyone<br /><em>can inspect.</em></h1>
      <div class="ad-desk__lede">
        <p>Useful doors placed by context, not by surveillance. Aggregate viewability and click counts are public; visitor profiles do not exist.</p>
        <p>Reservation and tez settlement are designed, but not live. Nothing here connects a wallet or moves funds.</p>
      </div>
      <nav class="mono" aria-label="Ad desk resources">
        <a href="/ads/report">LIVE PUBLISHING REPORT</a>
        <a href="/ads.json">PUBLIC RECEIPT · JSON</a>
        <a href="mailto:hello@pointcast.xyz?subject=PointCast%20Open%20Ad%20Network">ASK ABOUT A PLACEMENT</a>
      </nav>
    </header>

    <section class="ad-desk__placement" aria-labelledby="placement-title">
      <div>
        <p class="mono">OPEN PLACEMENT · {OPEN_AD_PLACEMENT.id}</p>
        <h2 id="placement-title">{OPEN_AD_PLACEMENT.placement}</h2>
        <p>{OPEN_AD_PLACEMENT.note}</p>
      </div>
      <dl class="mono">
        <div><dt>FORMAT</dt><dd>{OPEN_AD_PLACEMENT.format}</dd></div>
        <div><dt>PUBLIC PRICE</dt><dd>{OPEN_AD_PLACEMENT.priceTezPerWeek} ꜩ / WEEK</dd></div>
        <div><dt>REPORTING</dt><dd>AGGREGATE IMPRESSIONS + CLICKS</dd></div>
        <div><dt>SETTLEMENT</dt><dd>PROTOTYPE · NOT LIVE</dd></div>
      </dl>
    </section>

    <section class="ad-desk__lab" aria-labelledby="interactive-ad-lab-title">
      <header>
        <p class="mono">LIVE 3D CREATIVE LAB · NO AUTOPLAY</p>
        <h2 id="interactive-ad-lab-title">Move through<br /><em>the campaign.</em></h2>
        <p>Three dimensional house ads made for the modern web—not a video pretending to be interactive. Tilt with a pointer or the arrow keys, then press enter to open the door.</p>
      </header>
      <div class="ad-desk__lab-stages">
        {interactiveAds.map((ad, index) => <InteractiveAdStage ad={ad} index={index} />)}
      </div>
      <p class="ad-desk__lab-boundary mono">CSS 3D · KEYBOARD OPERABLE · REDUCED-MOTION SAFE · POINTER MOVEMENT NEVER LEAVES THE DEVICE</p>
    </section>

    {holdersCutAd && (
      <section class="ad-desk__holders" aria-labelledby="holders-cut-campaign-title">
        {holdersCutAd.image && (
          <a href={holdersCutAd.href} class="ad-desk__holders-art">
            <img src={holdersCutAd.image} alt="The Holders' Cut public-preview campaign poster" width="1200" height="630" />
          </a>
        )}
        <div>
          <p class="mono">POINTCAST + RALLY FOOTER CAMPAIGN · {HOLDERS_CUT_CAMPAIGN.id}</p>
          <h2 id="holders-cut-campaign-title">44 plates.<br /><em>No finish line.</em></h2>
          <p>{holdersCutAd.copy}</p>
          <p>The portable unit runs here and in the Rally footer. It links to a public preview; Mainnet minting and holder distributions remain inactive.</p>
          <nav class="mono" aria-label="The Holders' Cut campaign links">
            <a href={holdersCutAd.href}>OPEN THE PUBLIC PREVIEW</a>
            <a href="/press/the-holders-cut-opens-44-plate-unlimited-edition-preview">PRESS FILING</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </div>
      </section>
    )}

    <section class="ad-desk__federation" aria-labelledby="federation-title">
      <header>
        <p class="mono">RECIPROCAL NETWORK · {OPEN_AD_NETWORK.id}</p>
        <h2 id="federation-title">One public inventory.<br /><em>Many independent doors.</em></h2>
        <p>The same inspectable house rotation now travels across PointCast, Industry Next, Allworthy, Passportz, and Common Hours / Stampz. Each property keeps its own design and editorial voice; the unit only exchanges a clearly labeled contextual door.</p>
        <nav class="mono" aria-label="Portable network resources">
          <a href={OPEN_AD_NETWORK.inventoryUrl}>PUBLIC INVENTORY</a>
          <a href={OPEN_AD_NETWORK.embedUrl}>PORTABLE SCRIPT</a>
          <a href="/ads/report">PUBLISHER COUNTS</a>
        </nav>
      </header>
      <ol>
        {OPEN_AD_PUBLISHERS.map((publisher) => (
          <li><a href={publisher.url}><span class="mono">{publisher.id}</span><strong>{publisher.name}</strong><p>{publisher.surface}</p><i class="mono">OPEN →</i></a></li>
        ))}
      </ol>
      <p class="ad-desk__federation-boundary mono">CONTEXTUAL DAILY ROTATION · NO COOKIES · NO CROSS-SITE VISITOR ID · NO WALLET DATA · HOUSE INVENTORY ONLY</p>
    </section>

    <section class="ad-desk__network" aria-labelledby="network-el-segundo-campaign-title">
      <header>
        <p class="mono">SITEWIDE HOUSE CAMPAIGN · {NETWORK_EL_SEGUNDO_CAMPAIGN.id}</p>
        <h2 id="network-el-segundo-campaign-title">The first 100<br /><em>make the signal.</em></h2>
        <p>Three poster doors invite verified Tezos wallets into Network El Segundo. Joining is a free message signature. The 50% post-sale participant distribution remains a published prototype rule—not a live sale, payout contract, or promise of yield.</p>
        <nav class="mono" aria-label="Network El Segundo campaign links">
          <a href="/network-el-segundo">ENTER THE FIRST 100 SIGNAL</a>
          <a href="/network-el-segundo/share">OPEN THE RELAY KIT</a>
          <a href="/press/network-el-segundo-opens-first-100-tezos-wallet-roster">PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {networkElSegundoAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Network El Segundo house-ad creative`} width="1312" height="736" loading="lazy" />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__kitty" aria-labelledby="art-kitty-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {ART_KITTY_CAMPAIGN.id}</p>
        <h2 id="art-kitty-campaign-title">Make one.<br /><em>Fund the next one.</em></h2>
        <p>Three contextual doors into HOME / Art Kitty: 31 public works, two permanent series, and a one-tez collector edition whose proceeds split evenly between the artist and future art.</p>
        <nav class="mono" aria-label="Art Kitty campaign links">
          <a href="https://art-kitty-editions.mhoydich.chatgpt.site/series/02">ENTER SERIES 02</a>
          <a href="/press/home-art-kitty-opens-31-one-tez-collector-editions">PRESS FILING</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {artKittyAds.map((ad, index) => (
          <li>
            {ad.image && <img src={ad.image} alt={`${ad.headline} Art Kitty house-ad creative`} width="1024" height="1024" loading="lazy" />}
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__nouns" aria-labelledby="nouns-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {NOUNS_ABOUT_CAMPAIGN.id}</p>
        <h2 id="nouns-campaign-title">Permission is<br /><em>the starting point.</em></h2>
        <p>Three contextual ways into a short Industry Next field note on why Nouns and CC0 can remain unusually interesting—without making the reader sit through a full history.</p>
        <nav class="mono" aria-label="Nouns About campaign links">
          <a href="https://www.industrynext.xyz/about/">READ ABOUT NOUNS</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {nounsAboutAds.map((ad, index) => (
          <li>
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    {industryNextAd && (
      <section class="ad-desk__nouns" aria-labelledby="industry-next-campaign-title">
        <header>
          <p class="mono">DIRECT HOUSE AD · {INDUSTRY_NEXT_CAMPAIGN.id}</p>
          <h2 id="industry-next-campaign-title">Culture is<br /><em>a building material.</em></h2>
          <p>{industryNextAd.copy}</p>
          <nav class="mono" aria-label="Industry Next campaign links">
            <a href={industryNextAd.href}>{industryNextAd.cta.toUpperCase()}</a>
            <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
          </nav>
        </header>
        <ol>
          <li>
            <span class="mono">CREATIVE 01 · {industryNextAd.id}</span>
            <strong>{industryNextAd.headline}</strong>
            <p>{industryNextAd.copy}</p>
            <a class="mono" href={industryNextAd.href}>{industryNextAd.cta} →</a>
          </li>
        </ol>
      </section>
    )}

    <section class="ad-desk__nouns" aria-labelledby="permission-lab-campaign-title">
      <header>
        <p class="mono">NEW HOUSE CAMPAIGN · {PERMISSION_LAB_CAMPAIGN.id}</p>
        <h2 id="permission-lab-campaign-title">Make first.<br /><em>Ask never.</em></h2>
        <p>Three contextual doors into Industry Next Permission Lab: remix an authentic CC0 Noun, export a square poster, or deliberately publish it to a public stream. No account or wallet required.</p>
        <nav class="mono" aria-label="Permission Lab campaign links">
          <a href="https://www.industrynext.xyz/make/">ENTER PERMISSION LAB</a>
          <a href="https://www.industrynext.xyz/made/">SEE THE MADE STREAM</a>
          <a href="/ads/report">SEE CAMPAIGN COUNTS</a>
        </nav>
      </header>
      <ol>
        {permissionLabAds.map((ad, index) => (
          <li>
            <span class="mono">CREATIVE {String(index + 1).padStart(2, '0')} · {ad.id}</span>
            <strong>{ad.headline}</strong>
            <p>{ad.copy}</p>
            <a class="mono" href={ad.href}>{ad.cta} →</a>
          </li>
        ))}
      </ol>
    </section>

    {drumUniverseAd && (
      <section class="ad-desk__universe" aria-labelledby="drum-universe-title">
        {drumUniverseAd.image && (
          <a href={drumUniverseAd.href} class="ad-desk__universe-art">
            <img src={drumUniverseAd.image} alt="PointCast Drum Noun Universe campaign poster" width="1024" height="1536" />
          </a>
        )}
        <div>
          <p class="mono">FEATURED HOUSE CAMPAIGN · {DRUM_NOUN_UNIVERSE_CAMPAIGN.id}</p>
          <h2 id="drum-universe-title">115 rooms.<br /><em>One shared pulse.</em></h2>
          <p>{drumUniverseAd.copy}</p>
          <p>The feature unit runs near the top of the homepage and the compact creative enters the contextual rail on other public non-Drum pages. Drum routes retain their own six-part compendium series.</p>
          <nav class="mono" aria-label="Drum Noun Universe campaign links">
            <a href={drumUniverseAd.href}>ENTER THE UNIVERSE</a>
            <a href="/press/pointcast-opens-115-room-drum-noun-universe">PRESS RELEASE</a>
            <a href="/posts/pointcast-drum-noun-universe">FIELD NOTE</a>
          </nav>
        </div>
      </section>
    )}

    <section class="ad-desk__series" aria-labelledby="drum-series-title">
      <header>
        <p class="mono">HOUSE SERIES · {DRUM_COMPENDIUM_CAMPAIGN.id}</p>
        <h2 id="drum-series-title">One compendium.<br /><em>Six ways out.</em></h2>
        <p>
          Every public Drum page receives one of six PointCast house creatives. The page URL chooses the fit—games find the arcade, broadcast rooms find the wire, rituals find the catalog. No visitor profile is made.
        </p>
      </header>
      <ol aria-label="Drum Compendium campaign creatives">
        {drumCompendiumAds.map((ad) => (
          <li style={`--series-tone: var(--series-${ad.tone});`}>
            <a href={ad.href}>
              <DrumCompendiumAdArt sequence={ad.seriesIndex || 1} label={ad.headline} />
              <span class="mono">{ad.id} · {String(ad.seriesIndex).padStart(2, '0')}/06</span>
              <strong>{ad.headline}</strong>
              <i class="mono">{ad.cta} →</i>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__campaigns" aria-labelledby="campaigns-title">
      <div class="ad-desk__section-head">
        <p class="mono">CURRENT ROTATION · HOUSE ADS</p>
        <h2 id="campaigns-title">{POINTCAST_ADS.length} useful doors.</h2>
      </div>
      <ol>
        {POINTCAST_ADS.map((ad, index) => (
          <li>
            <a href={ad.href}>
              {ad.image && <img src={ad.image} alt={`${ad.headline} house-ad creative`} width="1200" height="1457" loading="lazy" />}
              {ad.seriesIndex && <DrumCompendiumAdArt sequence={ad.seriesIndex} label={ad.headline} />}
              <span class="mono">{String(index + 1).padStart(2, '0')} · {ad.id} · {ad.status.toUpperCase()}</span>
              <strong>{ad.headline}</strong>
              <p>{ad.copy}</p>
              <i class="mono">{ad.advertiser} · {ad.cta} →</i>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  .ad-desk {
    --series-signal: #174e7a;
    --series-garden: #26734f;
    --series-play: #bd3d20;
    --series-ritual: #79568d;
    --series-network: #1647cf;
    --series-field: #b17616;
    color: #15130f;
    background: #f3eee3;
    font-family: 'Lora', Georgia, serif;
  }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .ad-desk a { color: inherit; }
  .ad-desk__hero { min-height: 72vh; display: grid; align-content: space-between; gap: 36px; padding: clamp(26px, 5vw, 72px); color: #f8f1df; background: linear-gradient(145deg, #0d1823, #174e7a 55%, #cc5a2e); }
  .ad-desk__hero > p { margin: 0; color: #ffc08f; font-size: 10px; letter-spacing: 0.15em; }
  .ad-desk h1 { margin: 0; font-size: clamp(60px, 11vw, 158px); font-weight: 400; line-height: 0.78; letter-spacing: -0.075em; }
  .ad-desk h1 em { color: #ffc08f; font-weight: 400; }
  .ad-desk__lede { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; max-width: 980px; font-size: clamp(17px, 2vw, 26px); line-height: 1.35; }
  .ad-desk__lede p { margin: 0; }
  .ad-desk__hero nav { display: flex; flex-wrap: wrap; gap: 10px; font-size: 9px; letter-spacing: 0.12em; }
  .ad-desk__hero nav a { padding: 9px 11px; border: 1px solid currentColor; text-decoration: none; }
  .ad-desk__placement { display: grid; grid-template-columns: 1fr minmax(280px, 0.55fr); gap: clamp(30px, 6vw, 100px); padding: clamp(40px, 7vw, 96px); border-bottom: 1px solid #15130f; }
  .ad-desk__placement p:first-child, .ad-desk__section-head p { margin: 0 0 8px; color: #a33f26; font-size: 9px; letter-spacing: 0.14em; }
  .ad-desk h2 { margin: 0; font-size: clamp(38px, 6vw, 82px); font-weight: 400; line-height: 0.95; letter-spacing: -0.045em; }
  .ad-desk__placement > div > p:last-child { max-width: 60ch; font-size: 18px; line-height: 1.5; }
  .ad-desk__placement dl { margin: 0; font-size: 9px; letter-spacing: 0.1em; }
  .ad-desk__placement dl div { display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px; padding: 12px 0; border-top: 1px solid #15130f; }
  .ad-desk__placement dd { margin: 0; }
  .ad-desk__lab { padding: clamp(44px, 7vw, 100px); color: #f7f4ec; background: radial-gradient(circle at 50% 0%, #22223a 0, #0c0c12 52%, #050508 100%); border-bottom: 1px solid #15130f; }
  .ad-desk__lab > header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .62fr); gap: 14px clamp(30px, 7vw, 100px); align-items: end; margin-bottom: clamp(38px, 7vw, 86px); }
  .ad-desk__lab > header > p:first-child { grid-column: 1 / -1; margin: 0; color: #c8ff2f; font-size: 9px; letter-spacing: .15em; }
  .ad-desk__lab h2 em { color: #c8ff2f; font-weight: 400; }
  .ad-desk__lab > header > p:last-child { max-width: 54ch; margin: 0; color: #b8b5c3; font: 500 16px/1.55 system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .ad-desk__lab-stages { display: grid; gap: clamp(58px, 9vw, 130px); }
  .ad-desk__lab-boundary { margin: 52px 0 0; color: #787584; font-size: 7px; letter-spacing: .12em; text-align: center; }
  .ad-desk__holders { display: grid; grid-template-columns: minmax(320px, 1.05fr) minmax(0, .95fr); color: #f8ead0; background: #9d281e; border-bottom: 1px solid #15130f; }
  .ad-desk__holders-art { min-height: 520px; overflow: hidden; border-right: 1px solid #15130f; background: #081b21; }
  .ad-desk__holders-art img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ad-desk__holders > div { display: flex; flex-direction: column; justify-content: center; gap: 22px; padding: clamp(40px, 7vw, 96px); }
  .ad-desk__holders > div > p { max-width: 58ch; margin: 0; font-size: 17px; line-height: 1.5; }
  .ad-desk__holders > div > p:first-child { color: #ffd056; font-size: 9px; letter-spacing: .13em; }
  .ad-desk__holders h2 em { color: #ffd056; font-weight: 400; }
  .ad-desk__holders nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .ad-desk__holders nav a { padding: 9px 11px; border: 1px solid currentColor; font-size: 8px; letter-spacing: .1em; text-decoration: none; }
  .ad-desk__federation { padding: clamp(40px, 7vw, 96px); color: #f9f4e8; background: #17140f; border-bottom: 1px solid #15130f; }
  .ad-desk__federation header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .6fr); gap: 18px clamp(30px, 7vw, 100px); align-items: end; }
  .ad-desk__federation header > p:first-child { grid-column: 1 / -1; margin: 0; color: #ffd144; font-size: 9px; letter-spacing: .13em; }
  .ad-desk__federation h2 em { color: #ffd144; font-weight: 400; }
  .ad-desk__federation header > p:not(:first-child) { margin: 0; font-size: 17px; line-height: 1.5; }
  .ad-desk__federation nav { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 9px; font-size: 8px; letter-spacing: .1em; }
  .ad-desk__federation nav a { padding: 8px 10px; border: 1px solid currentColor; text-decoration: none; }
  .ad-desk__federation ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin: 34px 0 0; padding: 0; list-style: none; }
  .ad-desk__federation li { min-width: 0; border: 1px solid #6a645c; }
  .ad-desk__federation li a { height: 100%; display: flex; flex-direction: column; gap: 10px; padding: 14px; color: inherit; text-decoration: none; }
  .ad-desk__federation li span, .ad-desk__federation li i { color: #ffd144; font-size: 7px; font-style: normal; letter-spacing: .1em; }
  .ad-desk__federation li strong { font-family: 'Lora', Georgia, serif; font-size: 21px; font-weight: 400; line-height: 1; }
  .ad-desk__federation li p { margin: 0; color: #c8c0b3; font-size: 11px; line-height: 1.45; }
  .ad-desk__federation li i { margin-top: auto; padding-top: 10px; border-top: 1px solid #6a645c; }
  .ad-desk__federation-boundary { margin: 16px 0 0; color: #a49b8d; font-size: 7px; letter-spacing: .1em; }
  .ad-desk__network { padding: clamp(40px, 7vw, 96px); color: #070707; background: #f2ff47; border-bottom: 1px solid #15130f; }
  .ad-desk__network header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .65fr); gap: 18px clamp(30px, 7vw, 100px); align-items: end; margin-bottom: 30px; }
  .ad-desk__network header > p:first-child { grid-column: 1 / -1; margin: 0; color: #7a1ff0; font-size: 9px; letter-spacing: .13em; }
  .ad-desk__network h2 em { color: #ff4f9f; font-weight: 400; }
  .ad-desk__network header > p:not(:first-child) { margin: 0; font-size: 17px; line-height: 1.5; }
  .ad-desk__network nav { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 9px; font-size: 8px; letter-spacing: .1em; }
  .ad-desk__network nav a { padding: 8px 10px; border: 1px solid currentColor; text-decoration: none; }
  .ad-desk__network ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
