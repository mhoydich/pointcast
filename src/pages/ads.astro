---
import BaseLayout from '../layouts/BaseLayout.astro';
import DrumCompendiumAdArt from '../components/DrumCompendiumAdArt.astro';
import { DRUM_COMPENDIUM_CAMPAIGN, DRUM_NOUN_UNIVERSE_CAMPAIGN, OPEN_AD_PLACEMENT, POINTCAST_ADS } from '../lib/open-ad-network';

const drumCompendiumAds = POINTCAST_ADS.filter((ad) => ad.campaign === DRUM_COMPENDIUM_CAMPAIGN.id);
const drumUniverseAd = POINTCAST_ADS.find((ad) => ad.campaign === DRUM_NOUN_UNIVERSE_CAMPAIGN.id);
---

<BaseLayout
  title="Open Ad Network"
  description="PointCast's public contextual ad rail: visible records, no behavioral profiles, and an explicit prototype boundary for tez settlement."
>
  <main class="ad-desk">
    <header class="ad-desk__hero">
      <p class="mono">POINTCAST AD DESK · PUBLIC BETA 01</p>
      <h1>Ads anyone<br /><em>can inspect.</em></h1>
      <div class="ad-desk__lede">
        <p>Useful doors placed by context, not by surveillance. Every current campaign is a PointCast house ad.</p>
        <p>Reservation and tez settlement are designed, but not live. Nothing here connects a wallet or moves funds.</p>
      </div>
      <nav class="mono" aria-label="Ad desk resources">
        <a href="/ads.json">PUBLIC RECEIPT · JSON</a>
        <a href="mailto:hello@pointcast.xyz?subject=PointCast%20Open%20Ad%20Network">ASK ABOUT A PLACEMENT</a>
      </nav>
    </header>

    <section class="ad-desk__placement" aria-labelledby="placement-title">
      <div>
        <p class="mono">OPEN PLACEMENT · {OPEN_AD_PLACEMENT.id}</p>
        <h2 id="placement-title">{OPEN_AD_PLACEMENT.placement}</h2>
        <p>{OPEN_AD_PLACEMENT.note}</p>
      </div>
      <dl class="mono">
        <div><dt>FORMAT</dt><dd>{OPEN_AD_PLACEMENT.format}</dd></div>
        <div><dt>PUBLIC PRICE</dt><dd>{OPEN_AD_PLACEMENT.priceTezPerWeek} ꜩ / WEEK</dd></div>
        <div><dt>TRACKING</dt><dd>NONE</dd></div>
        <div><dt>SETTLEMENT</dt><dd>PROTOTYPE · NOT LIVE</dd></div>
      </dl>
    </section>

    {drumUniverseAd && (
      <section class="ad-desk__universe" aria-labelledby="drum-universe-title">
        {drumUniverseAd.image && (
          <a href={drumUniverseAd.href} class="ad-desk__universe-art">
            <img src={drumUniverseAd.image} alt="PointCast Drum Noun Universe campaign poster" width="1024" height="1536" />
          </a>
        )}
        <div>
          <p class="mono">FEATURED HOUSE CAMPAIGN · {DRUM_NOUN_UNIVERSE_CAMPAIGN.id}</p>
          <h2 id="drum-universe-title">115 rooms.<br /><em>One shared pulse.</em></h2>
          <p>{drumUniverseAd.copy}</p>
          <p>The feature unit runs near the top of the homepage and the compact creative enters the contextual rail on other public non-Drum pages. Drum routes retain their own six-part compendium series.</p>
          <nav class="mono" aria-label="Drum Noun Universe campaign links">
            <a href={drumUniverseAd.href}>ENTER THE UNIVERSE</a>
            <a href="/press/pointcast-opens-115-room-drum-noun-universe">PRESS RELEASE</a>
            <a href="/posts/pointcast-drum-noun-universe">FIELD NOTE</a>
          </nav>
        </div>
      </section>
    )}

    <section class="ad-desk__series" aria-labelledby="drum-series-title">
      <header>
        <p class="mono">HOUSE SERIES · {DRUM_COMPENDIUM_CAMPAIGN.id}</p>
        <h2 id="drum-series-title">One compendium.<br /><em>Six ways out.</em></h2>
        <p>
          Every public Drum page receives one of six PointCast house creatives. The page URL chooses the fit—games find the arcade, broadcast rooms find the wire, rituals find the catalog. No visitor profile is made.
        </p>
      </header>
      <ol aria-label="Drum Compendium campaign creatives">
        {drumCompendiumAds.map((ad) => (
          <li style={`--series-tone: var(--series-${ad.tone});`}>
            <a href={ad.href}>
              <DrumCompendiumAdArt sequence={ad.seriesIndex || 1} label={ad.headline} />
              <span class="mono">{ad.id} · {String(ad.seriesIndex).padStart(2, '0')}/06</span>
              <strong>{ad.headline}</strong>
              <i class="mono">{ad.cta} →</i>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="ad-desk__campaigns" aria-labelledby="campaigns-title">
      <div class="ad-desk__section-head">
        <p class="mono">CURRENT ROTATION · HOUSE ADS</p>
        <h2 id="campaigns-title">{POINTCAST_ADS.length} useful doors.</h2>
      </div>
      <ol>
        {POINTCAST_ADS.map((ad, index) => (
          <li>
            <a href={ad.href}>
              {ad.image && <img src={ad.image} alt={`${ad.headline} house-ad creative`} width="1200" height="1457" loading="lazy" />}
              {ad.seriesIndex && <DrumCompendiumAdArt sequence={ad.seriesIndex} label={ad.headline} />}
              <span class="mono">{String(index + 1).padStart(2, '0')} · {ad.id} · {ad.status.toUpperCase()}</span>
              <strong>{ad.headline}</strong>
              <p>{ad.copy}</p>
              <i class="mono">{ad.advertiser} · {ad.cta} →</i>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  .ad-desk {
    --series-signal: #174e7a;
    --series-garden: #26734f;
    --series-play: #bd3d20;
    --series-ritual: #79568d;
    --series-network: #1647cf;
    --series-field: #b17616;
    color: #15130f;
    background: #f3eee3;
    font-family: 'Lora', Georgia, serif;
  }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .ad-desk a { color: inherit; }
  .ad-desk__hero { min-height: 72vh; display: grid; align-content: space-between; gap: 36px; padding: clamp(26px, 5vw, 72px); color: #f8f1df; background: linear-gradient(145deg, #0d1823, #174e7a 55%, #cc5a2e); }
  .ad-desk__hero > p { margin: 0; color: #ffc08f; font-size: 10px; letter-spacing: 0.15em; }
  .ad-desk h1 { margin: 0; font-size: clamp(60px, 11vw, 158px); font-weight: 400; line-height: 0.78; letter-spacing: -0.075em; }
  .ad-desk h1 em { color: #ffc08f; font-weight: 400; }
  .ad-desk__lede { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; max-width: 980px; font-size: clamp(17px, 2vw, 26px); line-height: 1.35; }
  .ad-desk__lede p { margin: 0; }
  .ad-desk__hero nav { display: flex; flex-wrap: wrap; gap: 10px; font-size: 9px; letter-spacing: 0.12em; }
  .ad-desk__hero nav a { padding: 9px 11px; border: 1px solid currentColor; text-decoration: none; }
  .ad-desk__placement { display: grid; grid-template-columns: 1fr minmax(280px, 0.55fr); gap: clamp(30px, 6vw, 100px); padding: clamp(40px, 7vw, 96px); border-bottom: 1px solid #15130f; }
  .ad-desk__placement p:first-child, .ad-desk__section-head p { margin: 0 0 8px; color: #a33f26; font-size: 9px; letter-spacing: 0.14em; }
  .ad-desk h2 { margin: 0; font-size: clamp(38px, 6vw, 82px); font-weight: 400; line-height: 0.95; letter-spacing: -0.045em; }
  .ad-desk__placement > div > p:last-child { max-width: 60ch; font-size: 18px; line-height: 1.5; }
  .ad-desk__placement dl { margin: 0; font-size: 9px; letter-spacing: 0.1em; }
  .ad-desk__placement dl div { display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px; padding: 12px 0; border-top: 1px solid #15130f; }
  .ad-desk__placement dd { margin: 0; }
  .ad-desk__universe { display: grid; grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr); color: #071d34; background: #f5e8ca; border-bottom: 1px solid #15130f; }
  .ad-desk__universe-art { min-height: 640px; overflow: hidden; border-right: 1px solid #15130f; }
  .ad-desk__universe-art img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 42%; }
  .ad-desk__universe > div { display: flex; flex-direction: column; justify-content: center; gap: 22px; padding: clamp(40px, 7vw, 96px); }
  .ad-desk__universe > div > p { max-width: 58ch; margin: 0; font-size: 17px; line-height: 1.5; }
  .ad-desk__universe > div > p:first-child { color: #c42620; font-size: 9px; letter-spacing: 0.13em; }
  .ad-desk__universe h2 em { color: #c42620; font-weight: 400; }
  .ad-desk__universe nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .ad-desk__universe nav a { padding: 9px 11px; border: 1px solid currentColor; font-size: 8px; letter-spacing: 0.1em; text-decoration: none; }
  .ad-desk__series { padding: clamp(40px, 7vw, 96px); color: #f8f1df; background: #11100e; }
  .ad-desk__series > header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr); gap: 12px clamp(30px, 7vw, 110px); margin-bottom: 36px; }
  .ad-desk__series > header > p:first-child { grid-column: 1 / -1; margin: 0; color: #ffc08f; font-size: 9px; letter-spacing: 0.14em; }
  .ad-desk__series > header > p:last-child { max-width: 54ch; margin: 0; font-size: clamp(16px, 1.7vw, 22px); line-height: 1.45; }
  .ad-desk__series h2 em { color: #ffc08f; font-weight: 400; }
  .ad-desk__series ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .ad-desk__series li { --tone: var(--series-tone); min-width: 0; border: 1px solid #514e48; background: #f8f1df; color: var(--series-tone); }
  .ad-desk__series li a { height: 100%; display: flex; flex-direction: column; gap: 10px; padding: 10px; color: inherit; text-decoration: none; }
  .ad-desk__series li span, .ad-desk__series li i { font-size: 7px; letter-spacing: 0.1em; font-style: normal; }
  .ad-desk__series li strong { color: #15130f; font-size: clamp(20px, 2.2vw, 32px); font-weight: 400; line-height: 0.98; }
  .ad-desk__series li i { margin-top: auto; padding-top: 8px; border-top: 1px solid currentColor; }
  .ad-desk__campaigns { padding: clamp(40px, 7vw, 96px); }
  .ad-desk__section-head { margin-bottom: 30px; }
  .ad-desk__campaigns ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .ad-desk__campaigns li { border: 1px solid #15130f; background: #fffaf0; }
  .ad-desk__campaigns a { height: 100%; display: flex; flex-direction: column; gap: 12px; padding: clamp(18px, 3vw, 34px); text-decoration: none; }
  .ad-desk__campaigns img, .ad-desk__campaigns :global(.drum-ad-art) { width: 100%; max-height: 420px; object-fit: cover; object-position: center 25%; border: 1px solid #15130f; }
  .ad-desk__campaigns span, .ad-desk__campaigns i { font-size: 8px; letter-spacing: 0.12em; font-style: normal; }
  .ad-desk__campaigns span { color: #a33f26; }
  .ad-desk__campaigns strong { font-size: clamp(25px, 3vw, 44px); font-weight: 400; line-height: 1; }
  .ad-desk__campaigns p { max-width: 55ch; margin: 0; line-height: 1.5; }
  .ad-desk__campaigns i { margin-top: auto; border-top: 1px solid #15130f; padding-top: 12px; }
  @media (max-width: 720px) {
    .ad-desk__lede, .ad-desk__placement, .ad-desk__universe, .ad-desk__series > header, .ad-desk__series ol, .ad-desk__campaigns ol { grid-template-columns: 1fr; }
    .ad-desk__universe-art { min-height: 420px; max-height: 80vh; border-right: 0; border-bottom: 1px solid #15130f; }
  }
</style>
