---
/**
 * /tidepool — a pixel tide pool somewhere south of El Porto.
 *
 * v1: local-first single-pool. Real NOAA tides drive water level.
 * Multi-user shared pool is a follow-up PR.
 *
 * Mike 2026-05-05: "ok go start build"
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import TidePool from '../components/TidePool.astro';

const title = 'TIDE POOL · pointcast.xyz';
const description = "A pixel tide pool somewhere south of El Porto. Real NOAA tides drive the water level. Add a creature, spritz one, sit by it.";
---

<BlockLayout legacy title={title} description={description}>
  <main class="tidepool-page">
    <header class="tidepool-page__head">
      <nav class="tidepool-page__crumb mono">
        <a href="/">← home</a>
        <span aria-hidden="true">/</span>
        <span>tidepool</span>
      </nav>
      <h1 class="tidepool-page__title">A tide pool somewhere south of El Porto.</h1>
      <p class="tidepool-page__dek">
        The water level moves with the actual tide off Los Angeles
        (NOAA station 9410660). Add one creature per day. Spritz one
        creature per day. There is no losing and no winning — it is a
        pool, and the ocean does most of the work.
      </p>
    </header>

    <TidePool />

    <section class="tidepool-page__notes">
      <h2 class="tidepool-page__notes-title">Notes</h2>
      <ul class="tidepool-page__notes-list">
        <li>
          <strong>Tides are real.</strong> The chart at the top of the
          canvas is the next high or low for Los Angeles. The little
          orange dot is where we are right now in that bracket.
        </li>
        <li>
          <strong>Eight kinds of creatures.</strong> Anemone, hermit
          crab, snail, sea star, urchin, sculpin, kelp blade, barnacle.
          Each is a 12×12 pixel sprite drawn in a 1989-Mac-game palette.
        </li>
        <li>
          <strong>One per day.</strong> You can add one creature per
          LA-day. You can spritz one creature per LA-day per creature.
          Soft cap, no streak, no points.
        </li>
        <li>
          <strong>v1 is local-first.</strong> Your pool lives in this
          browser. A shared pool that other visitors can see and tend
          is the next ship.
        </li>
        <li>
          <strong>Cozy is the goal.</strong> You can leave the page
          open and the water level will keep changing. Some days the
          pool is full and the kelp drifts. Other days it sits low and
          the rocks bake.
        </li>
      </ul>
    </section>
  </main>
</BlockLayout>

<style>
  .tidepool-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 30px 18px 80px;
  }
  .tidepool-page__head {
    margin-bottom: 18px;
  }
  .tidepool-page__crumb {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted, #5b5b55);
  }
  .tidepool-page__crumb a {
    color: var(--pc-accent, #c95c2e);
    text-decoration: none;
  }
  .tidepool-page__title {
    margin: 0 0 8px;
    font-size: clamp(22px, 4vw, 32px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--pc-ink, #1a1a1a);
  }
  .tidepool-page__dek {
    margin: 0;
    max-width: 60ch;
    color: var(--pc-ink-soft, #5b5b55);
    line-height: 1.5;
    font-size: 14px;
  }

  .tidepool-page__notes {
    margin-top: 30px;
    padding: 16px 18px;
    border: 1px dashed var(--pc-rule, #d6d4cd);
    background: #fff;
  }
  .tidepool-page__notes-title {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-ink-muted, #5b5b55);
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-weight: 700;
  }
  .tidepool-page__notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tidepool-page__notes-list li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--pc-ink, #1a1a1a);
  }
  .tidepool-page__notes-list strong {
    color: var(--pc-ink, #1a1a1a);
    font-weight: 600;
  }
</style>
