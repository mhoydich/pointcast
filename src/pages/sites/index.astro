---
import Layout from '../../layouts/SiteCollectionLayout.astro';
import Flowers from '../../components/SiteFlowers.astro';
import collection from '../../data/site-collection.json';
const original=collection.projects.find(project=>project.slug==='generalelectric')?.original;
if(!original)throw new Error('General Electric original is required');
---
<Layout title="Independent sites, reimagined" description="Michael Hoydich’s independent sites, creatively reimagined on PointCast, with verified links to their public originals.">
<main id="main"><section class="intro"><div><p class="eyebrow">Collection 01 / Michael Hoydich</p><h1>Old addresses.<br/>New energy.</h1><p class="lede">A collection of independent sites, finding another life on PointCast. Familiar ideas, fresh compositions, and a door back to the original.</p></div><aside><p class="label">The collection, so far</p><p>Begin with General Electric: a Los Angeles poster studio remixed into an interactive print. The original stays one click away.</p><p class="label">Original links checked October 6, 2026</p></aside></section>
<article class="feature"><div class="feature-art"><Flowers/></div><div class="feature-copy"><span class="label">01 / Art & experiments</span><h2>General Electric</h2><p>A field of breathing flowers. A blank canvas for your own images. The Los Angeles Poster Art Series, in a new PointCast edition.</p><div class="actions"><a class="button" href="/sites/general-electric/">Enter the poster studio ↗</a><a class="button secondary" href={original} target="_blank" rel="noopener noreferrer">Visit original ↗</a></div><span class="label">Local image import · Downloadable print</span></div></article>
<section aria-labelledby="catalog-title"><div class="section-head"><h2 id="catalog-title">The site index</h2><span class="label">{collection.projects.length} public originals / 1 PointCast edition</span></div><ul class="catalog">{collection.projects.map((project,index)=><li class="entry"><span class="label">{String(index+1).padStart(2,'0')} / {project.slug==='generalelectric'?'PointCast edition':'Independent site'}</span><h3>{project.name}</h3><p>{project.slug==='generalelectric'?'A creative poster studio, ready to explore.':project.note}</p>{project.slug==='generalelectric'&&<p><a href="/sites/general-electric/">Open PointCast edition ↗</a></p>}<a href={project.original} target="_blank" rel="noopener noreferrer">Visit original ↗</a></li>)}</ul></section>
<p class="note">“Visit original” opens the verified public site in a new tab. These exact addresses returned public pages on October 6, 2026. That link check does not test every original site feature; older deployment addresses may later expire.</p>
</main></Layout>
