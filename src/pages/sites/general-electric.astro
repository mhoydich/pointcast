---
import Layout from '../../layouts/SiteCollectionLayout.astro';
import Flowers from '../../components/SiteFlowers.astro';
import collection from '../../data/site-collection.json';
const original=collection.projects.find(project=>project.slug==='generalelectric')?.original;
if(!original)throw new Error('General Electric original is required');
---
<Layout title="General Electric — poster studio" description="A creative PointCast adaptation of Michael Hoydich’s Los Angeles Poster Art Series. Make a geometric poster or import a local image and download your print.">
<main id="main"><header class="studio-head"><div><p class="eyebrow"><a href="/sites/">Collection 01</a> / Art & experiments</p><h1>General<br/>Electric.</h1><p>A little Los Angeles. A little electricity. Make it your own.</p></div><a href={original} target="_blank" rel="noopener noreferrer">Visit original ↗</a></header>
<div class="studio-grid"><div><div class="print-frame"><Flowers poster/></div><p class="label">01 / Los Angeles Poster Art Series · PointCast edition</p></div><section class="controls" aria-labelledby="make-title"><h2 id="make-title">Your edition</h2><noscript><p>The poster and original links are available. Enable JavaScript to use the studio controls and download.</p></noscript><div id="studio-controls" hidden><label class="field"><span>Poster title</span><input id="title" value="GENERAL ELECTRIC" maxlength="28" autocomplete="off"/></label><label class="field"><span>Palette</span><select id="palette"><option value="sunset">Sunset / apricot & sage</option><option value="pacific">Pacific / blue & coral</option><option value="afterhours">After hours / violet & citron</option></select></label><div class="actions"><button id="shuffle" class="secondary">Remix flowers</button><button id="motion" class="secondary" aria-pressed="false">Start breathing</button></div><label class="file" id="drop">Bring your own image<input id="file" type="file" accept="image/png,image/jpeg,image/gif,image/webp"/></label><small>PNG, JPEG, GIF or WebP · up to 8 MB. Your image stays in this browser tab. GIFs export as a still frame.</small><button id="clear" class="secondary" hidden>Remove image</button><p id="status" role="status" aria-live="polite">Ready. Remix the flowers or choose a local image.</p><button id="download">Download poster PNG ↓</button><small>A 1000 × 1400 px print. Nothing is uploaded or saved to an account. Refreshing clears your image.</small></div></section></div>
<section class="credits"><div><p class="label">About this edition</p><p>Adapted from Michael Hoydich’s General Electric website: the repeating flower canvas, image-making invitation, and Los Angeles Poster Art Series credits. This PointCast edition adds editable type, three palettes, and local poster downloads.</p><p>Independent artwork titled “General Electric”; no affiliation with the General Electric company.</p></div><div><p class="label">Original & credits</p><p>Original site and series: Michael Hoydich · El Segundo, California.</p><p><a href={original} target="_blank" rel="noopener noreferrer">General Electric original ↗</a><br/>Public original verified October 6, 2026.</p><p>Image processing and poster export happen in your browser. Your local image stays in this tab; refreshing clears it.</p></div></section>
</main><script src="/site-collection/studio.js" is:inline></script></Layout>
