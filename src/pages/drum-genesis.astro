---
/**
 * /drum-genesis — remix two bottles into a third.
 *
 * The async-drum register has composers (bottle, call-and-response, octet)
 * and history (shelf). What it didn't have was *combinators* — ways to
 * take two phrases and make a derived third. Genesis closes that.
 *
 * Mechanic: paste two /drum-bottle codes (or full URLs), pick an operator,
 * see the result. The operators are bitwise across the 4-voice × 16-cell
 * grid:
 *   • XOR        — cells where A and B differ (rhythmic complement)
 *   • AND        — cells both have (the shared groove)
 *   • OR         — cells either has (a denser remix)
 *   • INTERLEAVE — A on even cells, B on odd (a call-and-response feel)
 *
 * BPM: average of A and B (rounded to nearest even).
 *
 * URL: /drum-genesis?a=<code-A>&b=<code-B>&op=xor|and|or|inter
 * The whole recipe is shareable, so recipients see what was remixed
 * with what. The "copy as new bottle" button produces a plain
 * /drum-bottle URL of the *result* — that's the polished output you'd
 * send to friends; the genesis URL is for fellow remixers who want to
 * see the lineage.
 *
 * Distinction: drum-bottle = original phrase. drum-genesis = derived
 * phrase. The two link back and forth: any bottle URL can be pasted
 * into genesis as a source; any genesis output can be exported as a
 * fresh bottle URL.
 *
 * Shipped 2026-05-14 (Thursday overnight). First combinator surface
 * in the async-drum register. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Drum Genesis — remix two drum bottles into a third"
  description="Paste two drum-bottle share links. Pick an operator (XOR, AND, OR, INTERLEAVE). Hear the remix. Copy the result as a new bottle URL. The recipe lives in the genesis URL so others can see what was remixed with what — or substitute one of the inputs and remix differently."
  image="/images/og-drum.png"
>
  <main class="dge" id="dge" data-built={built}>
    <header class="dge__hero">
      <p class="dge__kicker">DRUM · GENESIS · remix combinator · A ⊕ B</p>
      <h1 class="dge__title">Remix two bottles into a third.</h1>
      <p class="dge__sub">Paste two <a href="/drum-bottle">drum-bottle</a> URLs (or just their <code>?p=</code> codes). Pick an operator. Hear the remix. The result is itself a sharable bottle URL — paste it anywhere, or remix it again with someone else's phrase.</p>
    </header>

    <section class="dge__stage">

      <!-- Source A -->
      <div class="dge__source">
        <div class="dge__source-label">
          <span class="dge__tag dge__tag--a">SOURCE A</span>
          <span class="dge__source-meta" id="dge-a-meta">paste a bottle URL or code</span>
        </div>
        <input class="dge__input" id="dge-a-input" type="text" placeholder="https://pointcast.xyz/drum-bottle?p=ABC123XYZ-_2  or just  ABC123XYZ-_2" autocomplete="off" />
        <div class="dge__mini" id="dge-a-mini" data-empty="true"></div>
      </div>

      <!-- Operator row -->
      <div class="dge__op-row">
        <span class="dge__op-label">operator</span>
        <div class="dge__op-buttons" role="radiogroup" aria-label="Remix operator">
          <button class="dge__op dge__op--active" data-op="xor"   type="button" role="radio" aria-checked="true">⊕ XOR</button>
          <button class="dge__op"                  data-op="and"   type="button" role="radio" aria-checked="false">∧ AND</button>
          <button class="dge__op"                  data-op="or"    type="button" role="radio" aria-checked="false">∨ OR</button>
          <button class="dge__op"                  data-op="inter" type="button" role="radio" aria-checked="false">↔ INTER</button>
        </div>
        <span class="dge__op-hint" id="dge-op-hint">XOR — cells where A and B differ</span>
      </div>

      <!-- Source B -->
      <div class="dge__source">
        <div class="dge__source-label">
          <span class="dge__tag dge__tag--b">SOURCE B</span>
          <span class="dge__source-meta" id="dge-b-meta">paste a bottle URL or code</span>
        </div>
        <input class="dge__input" id="dge-b-input" type="text" placeholder="https://pointcast.xyz/drum-bottle?p=DEF456RST-_9" autocomplete="off" />
        <div class="dge__mini" id="dge-b-mini" data-empty="true"></div>
      </div>

      <!-- Bridge / equals -->
      <div class="dge__bridge" aria-hidden="true">
        <span class="dge__bridge-line"></span>
        <span class="dge__bridge-eq">=</span>
        <span class="dge__bridge-line"></span>
      </div>

      <!-- Result -->
      <div class="dge__result">
        <div class="dge__source-label">
          <span class="dge__tag dge__tag--out">RESULT</span>
          <span class="dge__source-meta" id="dge-result-meta">— · — BPM</span>
        </div>
        <div class="dge__mini dge__mini--out" id="dge-result-mini" data-empty="true"></div>
      </div>

      <!-- Transport -->
      <div class="dge__transport">
        <button class="dge__btn dge__btn--play" id="dge-play" type="button">▶ play result</button>
        <button class="dge__btn dge__btn--stop" id="dge-stop" type="button" hidden>⏹ stop</button>
      </div>

      <!-- Actions -->
      <div class="dge__actions" id="dge-actions" hidden>
        <button class="dge__action dge__action--primary" id="dge-copy-bottle" type="button">↗ copy as new bottle</button>
        <button class="dge__action" id="dge-copy-genesis" type="button">↗ copy genesis link</button>
        <a class="dge__action" id="dge-sms" href="#">↗ via iMessage</a>
        <button class="dge__action dge__action--ghost" id="dge-swap" type="button">⇅ swap A ↔ B</button>
      </div>

    </section>

    <section class="dge__notes">
      <h2 class="dge__notes-h">How a genesis works</h2>
      <p>Every drum-bottle URL contains a 4-voice × 16-cell grid as 64 bits of pattern. Genesis decodes both sources and applies a bitwise operator to produce a new 64-bit pattern. The result is a real, playable bottle — copy its URL and send it like any other phrase.</p>
      <p>The operators:</p>
      <ul>
        <li><strong>⊕ XOR</strong> — cells where A and B <em>differ</em>. Rhythmic complement; the parts the two phrases <em>disagree</em> on.</li>
        <li><strong>∧ AND</strong> — cells <em>both</em> have. The shared groove; what A and B agree on.</li>
        <li><strong>∨ OR</strong> — cells <em>either</em> has. A denser remix; every hit from either phrase.</li>
        <li><strong>↔ INTERLEAVE</strong> — A on even cells, B on odd. A call-and-response feel within a single 16-step bar.</li>
      </ul>
      <p>BPM is averaged from A and B (rounded to nearest even). If you want a different tempo, copy as a new bottle and re-record there with the BPM slider.</p>
      <p>The <code>/drum-genesis?a=&hellip;&amp;b=&hellip;&amp;op=&hellip;</code> URL preserves the whole recipe, so a friend opening your genesis can see the inputs and remix differently. The "copy as new bottle" button strips the recipe and gives you a plain <code>/drum-bottle</code> URL — the polished output to send around.</p>
      <p>Sister surfaces: <a href="/drum-bottle">/drum-bottle</a> (original phrases), <a href="/drum-call-and-response">/drum-call-and-response</a> (Q+A), <a href="/drum-octet">/drum-octet</a> (8-person chains), <a href="/drum-shelf">/drum-shelf</a> (your history), <a href="/drum-mailbox">/drum-mailbox</a> (directory).</p>
    </section>

    <div class="dge__toast" id="dge-toast" aria-live="polite"></div>
  </main>

  <style is:global>
    :root {
      --dge-ink: #0a1230;
      --dge-mid: #14193a;
      --dge-flame: #f6c15e;
      --dge-coral: #ff6b8a;
      --dge-mint: #8aeac0;
      --dge-sky: #7ac8ed;
      --dge-mauve: #c9a8ef;
      --dge-cream: #f4e7c8;
      --dge-cream-dim: #b8aa84;
    }

    body:has(.dge) {
      background:
        radial-gradient(circle at 18% 6%, #1a1e58 0%, transparent 50%),
        radial-gradient(circle at 82% 96%, #2a1640 0%, transparent 55%),
        var(--dge-ink);
      color: var(--dge-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dge { max-width: 780px; margin: 0 auto; padding: 36px 24px 64px; }

    /* HERO */
    .dge__hero { margin-bottom: 32px; }
    .dge__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dge-coral);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .dge__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: clamp(32px, 5.5vw, 52px);
      letter-spacing: -0.025em;
      line-height: 1.04;
      margin: 0 0 16px;
    }
    .dge__sub {
      font-size: 15px;
      line-height: 1.55;
      color: var(--dge-cream-dim);
      margin: 0;
    }
    .dge__sub a {
      color: var(--dge-sky);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .dge__sub code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      padding: 1px 5px;
      border-radius: 3px;
      background: rgba(244,231,200,0.08);
      color: var(--dge-mint);
    }

    /* STAGE */
    .dge__stage {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 18px;
      padding: 22px;
      margin-bottom: 36px;
    }

    /* SOURCE / RESULT */
    .dge__source, .dge__result { margin-bottom: 14px; }
    .dge__source-label {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 8px;
    }
    .dge__tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 4px;
    }
    .dge__tag--a   { color: var(--dge-flame); background: rgba(246,193,94,0.15); }
    .dge__tag--b   { color: var(--dge-sky);   background: rgba(122,200,237,0.15); }
    .dge__tag--out { color: var(--dge-mint);  background: rgba(138,234,192,0.15); }
    .dge__source-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dge-cream-dim);
    }

    .dge__input {
      width: 100%;
      padding: 9px 12px;
      background: rgba(0,0,0,0.30);
      border: 1px solid rgba(244,231,200,0.15);
      border-radius: 6px;
      color: var(--dge-cream);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.02em;
      margin-bottom: 8px;
      box-sizing: border-box;
    }
    .dge__input:focus {
      outline: 0;
      border-color: var(--dge-flame);
      background: rgba(0,0,0,0.45);
    }

    .dge__mini {
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      grid-template-rows: repeat(4, 1fr);
      gap: 3px;
      aspect-ratio: 16 / 4;
      background: rgba(0,0,0,0.30);
      border-radius: 6px;
      padding: 5px;
    }
    .dge__mini--out {
      aspect-ratio: 16 / 5;
      gap: 4px;
      padding: 6px;
      background: rgba(138, 234, 192, 0.06);
      border: 1px solid rgba(138, 234, 192, 0.25);
    }
    .dge__mini[data-empty="true"] {
      background-image:
        repeating-linear-gradient(45deg,
          rgba(244,231,200,0.03), rgba(244,231,200,0.03) 6px,
          transparent 6px, transparent 12px);
    }
    .dge__mini-cell {
      background: rgba(244,231,200,0.06);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 2px;
      min-width: 0;
      min-height: 0;
    }
    .dge__mini-cell--on  { background: var(--cell-color); border-color: var(--cell-color); }
    .dge__mini-cell--low.dge__mini-cell--on  { --cell-color: #f6c15e; }
    .dge__mini-cell--mid.dge__mini-cell--on  { --cell-color: #ff8a70; }
    .dge__mini-cell--high.dge__mini-cell--on { --cell-color: #c9a8ef; }
    .dge__mini-cell--bell.dge__mini-cell--on { --cell-color: #8aeac0; }
    .dge__mini-cell--play {
      box-shadow: 0 0 0 2px var(--dge-cream);
      transform: scale(0.92);
    }

    /* Operator row */
    .dge__op-row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin: 14px 0;
      padding: 12px;
      background: rgba(0,0,0,0.20);
      border-radius: 8px;
    }
    .dge__op-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--dge-cream-dim);
      text-transform: uppercase;
    }
    .dge__op-buttons {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .dge__op {
      border: 1px solid rgba(244,231,200,0.18);
      background: transparent;
      color: var(--dge-cream-dim);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.04em;
      padding: 6px 12px;
      border-radius: 5px;
      cursor: pointer;
      transition: background 120ms ease, color 120ms ease;
    }
    .dge__op:hover {
      background: rgba(244,231,200,0.08);
      color: var(--dge-cream);
    }
    .dge__op--active {
      background: rgba(246, 193, 94, 0.15);
      border-color: rgba(246, 193, 94, 0.50);
      color: var(--dge-flame);
    }
    .dge__op-hint {
      font-size: 12px;
      color: var(--dge-cream-dim);
      font-style: italic;
      flex: 1;
      min-width: 200px;
      text-align: right;
    }

    /* Bridge / equals */
    .dge__bridge {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 14px 0;
    }
    .dge__bridge-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(138,234,192,0.4), transparent);
    }
    .dge__bridge-eq {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 22px;
      color: var(--dge-mint);
    }

    /* Transport */
    .dge__transport {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px 0;
    }
    .dge__btn {
      border: 1px solid rgba(244,231,200,0.25);
      background: rgba(244,231,200,0.08);
      color: var(--dge-cream);
      padding: 10px 18px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .dge__btn:hover { background: rgba(244,231,200,0.16); }
    .dge__btn--play {
      background: rgba(138, 234, 192, 0.15);
      border-color: rgba(138, 234, 192, 0.45);
      color: var(--dge-mint);
    }
    .dge__btn--play:hover { background: rgba(138, 234, 192, 0.25); }

    /* Actions */
    .dge__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .dge__action {
      flex: 0 0 auto;
      border: 1px solid rgba(244,231,200,0.18);
      background: rgba(244,231,200,0.06);
      color: var(--dge-cream);
      padding: 10px 16px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
    }
    .dge__action:hover {
      background: rgba(244,231,200,0.14);
      border-color: rgba(244,231,200,0.35);
    }
    .dge__action--primary {
      background: rgba(255,107,138,0.15);
      border-color: rgba(255,107,138,0.45);
      color: var(--dge-coral);
    }
    .dge__action--primary:hover { background: rgba(255,107,138,0.25); }
    .dge__action--ghost {
      color: var(--dge-cream-dim);
      background: transparent;
      border-color: rgba(244,231,200,0.10);
    }

    /* Notes */
    .dge__notes { max-width: 720px; }
    .dge__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dge-cream);
      margin: 0 0 12px;
    }
    .dge__notes p, .dge__notes li {
      font-size: 14px;
      line-height: 1.6;
      color: var(--dge-cream-dim);
      margin: 0 0 12px;
    }
    .dge__notes ul { list-style: none; padding-left: 0; margin: 0 0 12px; }
    .dge__notes li { padding-left: 18px; position: relative; margin-bottom: 6px; }
    .dge__notes li::before { content: '·'; position: absolute; left: 6px; color: var(--dge-flame); }
    .dge__notes em { color: var(--dge-flame); font-style: italic; }
    .dge__notes strong { color: var(--dge-cream); font-weight: 600; }
    .dge__notes code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--dge-mint);
    }
    .dge__notes a {
      color: var(--dge-coral);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Toast */
    .dge__toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: rgba(0,0,0,0.85);
      color: var(--dge-flame);
      padding: 10px 18px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.04em;
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease, transform 240ms ease;
      z-index: 50;
      border: 1px solid rgba(246,193,94,0.4);
    }
    .dge__toast--show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const VOICE_NAMES = ['low', 'mid', 'high', 'bell'] as const;
    type Voice = typeof VOICE_NAMES[number];
    type Op = 'xor' | 'and' | 'or' | 'inter';

    let patternA: boolean[][] | null = null;
    let patternB: boolean[][] | null = null;
    let bpmA = 100;
    let bpmB = 100;
    let result: boolean[][] | null = null;
    let bpmResult = 100;
    let op: Op = 'xor';
    let isPlaying = false;
    let playStep = 0;
    let playTimer: number | null = null;

    function blank(): boolean[][] {
      return Array.from({ length: 4 }, () => Array(16).fill(false));
    }
    function patternEmpty(p: boolean[][]): boolean {
      for (const row of p) for (const v of row) if (v) return false;
      return true;
    }

    // ---- bottle codec (9 bytes → 12 base64url chars) ----
    function b64UrlToBytes(code: string): Uint8Array | null {
      if (!code) return null;
      const b64 = code.replace(/-/g, '+').replace(/_/g, '/');
      const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
      let bin: string;
      try { bin = atob(padded); } catch { return null; }
      const out = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }
    function decodeBottle(code: string): { pattern: boolean[][]; bpm: number } | null {
      const bytes = b64UrlToBytes(code);
      if (!bytes || bytes.length < 9) return null;
      const p: boolean[][] = blank();
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          const idx = r * 16 + c;
          p[r][c] = !!(bytes[idx >> 3] & (1 << (idx & 7)));
        }
      }
      const bp = 40 + bytes[8];
      if (bp < 40 || bp > 220) return null;
      return { pattern: p, bpm: bp };
    }
    function encodeBottle(p: boolean[][], bp: number): string {
      const bytes = new Uint8Array(9);
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          if (p[r][c]) {
            const i = r * 16 + c;
            bytes[i >> 3] |= (1 << (i & 7));
          }
        }
      }
      bytes[8] = Math.max(0, Math.min(180, bp - 40));
      let bin = '';
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // ---- input extraction: accepts a bare code OR a full /drum-bottle URL ----
    function extractCode(raw: string): string {
      if (!raw) return '';
      const trimmed = raw.trim();
      // Try URL parse first
      try {
        const u = new URL(trimmed);
        const p = u.searchParams.get('p');
        if (p) return p;
      } catch { /* not a URL */ }
      // Plain code
      return trimmed.replace(/[^A-Za-z0-9_-]/g, '');
    }

    // ---- combinators ----
    function combine(a: boolean[][], b: boolean[][], operator: Op): boolean[][] {
      const out: boolean[][] = blank();
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          if (operator === 'xor')        out[r][c] = a[r][c] !== b[r][c];
          else if (operator === 'and')   out[r][c] = a[r][c] && b[r][c];
          else if (operator === 'or')    out[r][c] = a[r][c] || b[r][c];
          else /* inter */               out[r][c] = (c % 2 === 0) ? a[r][c] : b[r][c];
        }
      }
      return out;
    }
    function avgBpm(a: number, b: number): number {
      // Average and round to nearest even (since the BPM range is even-stepped)
      const v = Math.round((a + b) / 2);
      return v % 2 === 0 ? v : v + 1;
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    const VOICE_CFG: Record<Voice, { freq: number; bell: boolean }> = {
      low:  { freq:  70, bell: false },
      mid:  { freq: 120, bell: false },
      high: { freq: 200, bell: false },
      bell: { freq: 600, bell: true  },
    };
    function playVoice(voice: Voice) {
      ensureCtx();
      if (!ctx || !scheduler || !masterGain) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const cfg = VOICE_CFG[voice];
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = cfg.bell ? 'sine' : 'triangle';
      osc.frequency.value = cfg.freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.45, t + 0.004);
      const tail = cfg.bell ? 1.0 : 0.35;
      g.gain.exponentialRampToValueAtTime(0.0001, t + tail);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + tail + 0.05);
      if (cfg.bell) {
        for (const mult of [2, 3]) {
          const o = ctx.createOscillator();
          const gg = ctx.createGain();
          o.type = 'sine';
          o.frequency.value = cfg.freq * mult;
          gg.gain.setValueAtTime(0.0001, t);
          gg.gain.exponentialRampToValueAtTime(0.12 / mult, t + 0.008);
          gg.gain.exponentialRampToValueAtTime(0.0001, t + 0.7 / mult);
          o.connect(gg).connect(masterGain);
          scheduler.trackSource(o);
          o.start(t);
          o.stop(t + 0.75);
        }
      }
    }

    // ---- transport ----
    function stepDurationMs() {
      return (60_000 / bpmResult) / 4;
    }
    function tick() {
      document.querySelectorAll('.dge__mini--out .dge__mini-cell--play').forEach((el) => el.classList.remove('dge__mini-cell--play'));
      if (!result) return;
      const grid = document.getElementById('dge-result-mini')!;
      for (let r = 0; r < 4; r++) {
        const cell = grid.children[r * 16 + playStep] as HTMLElement;
        if (cell) cell.classList.add('dge__mini-cell--play');
        if (result[r][playStep]) playVoice(VOICE_NAMES[r]);
      }
      playStep = (playStep + 1) % 16;
    }
    function startPlay() {
      if (isPlaying || !result) {
        if (!result) showToast('paste two valid bottles first');
        return;
      }
      ensureCtx();
      isPlaying = true;
      playStep = 0;
      document.getElementById('dge-play')!.hidden = true;
      document.getElementById('dge-stop')!.hidden = false;
      tick();
      const loop = () => {
        if (!isPlaying) return;
        tick();
        playTimer = window.setTimeout(loop, stepDurationMs());
      };
      playTimer = window.setTimeout(loop, stepDurationMs());
    }
    function stopPlay() {
      isPlaying = false;
      if (playTimer != null) { clearTimeout(playTimer); playTimer = null; }
      document.querySelectorAll('.dge__mini--out .dge__mini-cell--play').forEach((el) => el.classList.remove('dge__mini-cell--play'));
      document.getElementById('dge-play')!.hidden = false;
      document.getElementById('dge-stop')!.hidden = true;
    }

    // ---- renderers ----
    function renderMini(target: HTMLElement, pattern: boolean[][] | null) {
      target.innerHTML = '';
      if (!pattern) {
        target.setAttribute('data-empty', 'true');
        return;
      }
      target.setAttribute('data-empty', 'false');
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          const cell = document.createElement('span');
          cell.className = `dge__mini-cell dge__mini-cell--${VOICE_NAMES[r]}` + (pattern[r][c] ? ' dge__mini-cell--on' : '');
          target.appendChild(cell);
        }
      }
    }

    // ---- recompute ----
    function recompute() {
      stopPlay();
      // Update metadata labels
      document.getElementById('dge-a-meta')!.textContent = patternA ? `4×16 phrase · ${bpmA} BPM` : 'paste a bottle URL or code';
      document.getElementById('dge-b-meta')!.textContent = patternB ? `4×16 phrase · ${bpmB} BPM` : 'paste a bottle URL or code';

      if (patternA && patternB) {
        result = combine(patternA, patternB, op);
        bpmResult = avgBpm(bpmA, bpmB);
        document.getElementById('dge-result-meta')!.textContent =
          `${countCells(result)} cells · ${bpmResult} BPM (avg)`;
        document.getElementById('dge-actions')!.hidden = false;
        updateSmsLink();
      } else {
        result = null;
        document.getElementById('dge-result-meta')!.textContent = '— · — BPM';
        document.getElementById('dge-actions')!.hidden = true;
      }

      renderMini(document.getElementById('dge-a-mini')!, patternA);
      renderMini(document.getElementById('dge-b-mini')!, patternB);
      renderMini(document.getElementById('dge-result-mini')!, result);
      updateGenesisUrlInTitle();
    }
    function countCells(p: boolean[][]): number {
      let n = 0;
      for (const row of p) for (const v of row) if (v) n++;
      return n;
    }

    // ---- urls ----
    function genesisUrl(): string {
      const a = patternA ? encodeBottle(patternA, bpmA) : '';
      const b = patternB ? encodeBottle(patternB, bpmB) : '';
      if (!a || !b) return location.origin + '/drum-genesis';
      return `${location.origin}/drum-genesis?a=${a}&b=${b}&op=${op}`;
    }
    function bottleUrl(): string {
      if (!result) return '';
      return `${location.origin}/drum-bottle?p=${encodeBottle(result, bpmResult)}`;
    }
    function smsHref(): string {
      const url = bottleUrl();
      if (!url) return '#';
      return `sms:&body=${encodeURIComponent('🥁 ' + url)}`;
    }
    function updateSmsLink() {
      const a = document.getElementById('dge-sms')! as HTMLAnchorElement;
      a.href = smsHref();
    }
    function updateGenesisUrlInTitle() {
      // Reflect current state in the URL bar so it's shareable directly
      if (!patternA || !patternB) {
        try {
          const u = new URL(location.href);
          u.searchParams.delete('a');
          u.searchParams.delete('b');
          u.searchParams.delete('op');
          history.replaceState({}, '', u.toString());
        } catch { /* ignore */ }
        return;
      }
      try {
        const u = new URL(location.href);
        u.searchParams.set('a', encodeBottle(patternA, bpmA));
        u.searchParams.set('b', encodeBottle(patternB, bpmB));
        u.searchParams.set('op', op);
        history.replaceState({}, '', u.toString());
      } catch { /* ignore */ }
    }

    // ---- clipboard ----
    async function copyText(text: string, successMsg: string) {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
          showToast(successMsg);
        } else throw new Error('no clipboard');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); showToast(successMsg); }
        catch { showToast(text); }
        finally { ta.remove(); }
      }
    }
    function showToast(msg: string) {
      const el = document.getElementById('dge-toast')!;
      el.textContent = msg;
      el.classList.add('dge__toast--show');
      setTimeout(() => el.classList.remove('dge__toast--show'), 2600);
    }

    // ---- shelf save (uses shared format) ----
    function saveResultToShelf() {
      if (!result) return;
      const KEY = 'pc-drum-shelf';
      try {
        const raw = localStorage.getItem(KEY);
        const parsed = raw ? JSON.parse(raw) : { v: 1, items: [] };
        if (!parsed.v || !Array.isArray(parsed.items)) return;
        const code = encodeBottle(result, bpmResult);
        const entry = { code, bpm: bpmResult, from: '', dir: 'made' as const, t: Date.now(), kind: 'bottle' as const };
        const key = `${code}::made::::bottle`;
        const existing = parsed.items.findIndex((it: any) =>
          `${it.code}::${it.dir}::${it.from || ''}::${it.kind || 'bottle'}` === key);
        if (existing >= 0) parsed.items[existing] = entry;
        else parsed.items.unshift(entry);
        parsed.items.sort((a: any, b: any) => b.t - a.t);
        if (parsed.items.length > 100) parsed.items.length = 100;
        localStorage.setItem(KEY, JSON.stringify(parsed));
      } catch { /* ignore */ }
    }

    // ---- ops ----
    const OP_HINTS: Record<Op, string> = {
      xor:   'XOR — cells where A and B differ',
      and:   'AND — cells both A and B have',
      or:    'OR — cells either A or B has',
      inter: 'INTERLEAVE — A on even cells, B on odd',
    };
    function setOp(newOp: Op) {
      op = newOp;
      document.querySelectorAll('.dge__op').forEach((btn) => {
        const b = btn as HTMLElement;
        const isActive = b.dataset.op === newOp;
        b.classList.toggle('dge__op--active', isActive);
        b.setAttribute('aria-checked', String(isActive));
      });
      document.getElementById('dge-op-hint')!.textContent = OP_HINTS[newOp];
      recompute();
    }

    // ---- input handlers ----
    function loadInputA(raw: string) {
      const code = extractCode(raw);
      if (!code) { patternA = null; bpmA = 100; recompute(); return; }
      const d = decodeBottle(code);
      if (d) {
        patternA = d.pattern;
        bpmA = d.bpm;
      } else {
        patternA = null;
        bpmA = 100;
      }
      recompute();
    }
    function loadInputB(raw: string) {
      const code = extractCode(raw);
      if (!code) { patternB = null; bpmB = 100; recompute(); return; }
      const d = decodeBottle(code);
      if (d) {
        patternB = d.pattern;
        bpmB = d.bpm;
      } else {
        patternB = null;
        bpmB = 100;
      }
      recompute();
    }

    // ---- init ----
    function init() {
      // Read URL params
      const params = new URLSearchParams(location.search);
      const aParam = params.get('a') || '';
      const bParam = params.get('b') || '';
      const opParam = (params.get('op') || 'xor').toLowerCase();
      if (['xor','and','or','inter'].includes(opParam)) op = opParam as Op;

      const aInput = document.getElementById('dge-a-input') as HTMLInputElement;
      const bInput = document.getElementById('dge-b-input') as HTMLInputElement;
      if (aParam) { aInput.value = aParam; loadInputA(aParam); }
      if (bParam) { bInput.value = bParam; loadInputB(bParam); }
      setOp(op);  // syncs UI

      aInput.addEventListener('input', () => loadInputA(aInput.value));
      bInput.addEventListener('input', () => loadInputB(bInput.value));

      document.querySelectorAll('.dge__op').forEach((btn) => {
        btn.addEventListener('click', () => {
          const o = ((btn as HTMLElement).dataset.op || 'xor') as Op;
          setOp(o);
        });
      });

      document.getElementById('dge-play')!.addEventListener('click', startPlay);
      document.getElementById('dge-stop')!.addEventListener('click', stopPlay);

      document.getElementById('dge-copy-bottle')!.addEventListener('click', () => {
        if (!result) { showToast('paste two valid bottles first'); return; }
        saveResultToShelf();
        copyText(bottleUrl(), 'copied · result saved to shelf');
      });
      document.getElementById('dge-copy-genesis')!.addEventListener('click', () => {
        copyText(genesisUrl(), 'copied genesis recipe');
      });
      document.getElementById('dge-swap')!.addEventListener('click', () => {
        // Swap A and B (both inputs and patterns)
        const aVal = aInput.value;
        aInput.value = bInput.value;
        bInput.value = aVal;
        loadInputA(aInput.value);
        loadInputB(bInput.value);
        showToast('swapped A ↔ B');
      });

      // Space toggles play
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (isPlaying) stopPlay(); else startPlay();
        }
      });

      recompute();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
