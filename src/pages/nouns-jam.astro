---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Nouns Jam';
const description = 'A Windows 95 worthy Nouns tap-blast: pop groups of matching noggles, collapse the columns, and hit the score target in 30 taps.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Game',
  '@id': 'https://pointcast.xyz/nouns-jam',
  name: title,
  description,
  url: 'https://pointcast.xyz/nouns-jam',
};
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.desktop} jsonLd={jsonLd}>
  <main class="desk" data-jam style={`--arcade-desktop:url('${ARCADE_ASSETS.desktop}');`}>
    <section class="window" aria-labelledby="jam-title">
      <header class="titlebar"><span id="jam-title">Nouns Jam</span><span class="buttons" aria-hidden="true"><i>_</i><i>□</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Jam menu">
        <button type="button" data-new>Game</button>
        <button type="button" data-hint>Hint</button>
        <a href="/win95-games">All games</a>
        <a href="/noggle-crush">Crush</a>
        <a href="/nouns-jelly">Jelly</a>
      </nav>
      <div class="toolbar">
        <span>Score <strong data-score>0</strong></span>
        <span>Taps <strong data-taps>30</strong></span>
        <span>Target <strong data-target>5000</strong></span>
        <span>Best <strong data-best>--</strong></span>
        <p data-status>Tap a group of two or more matching noggles to pop it.</p>
      </div>
      <div class="felt">
        <div class="board" data-board aria-label="Nouns Jam board"></div>
      </div>
      <footer class="status">Bigger groups score much more: points = tiles × (tiles − 1) × 10. Groups of six or more ring the jam bonus.</footer>
      <div class="overlay" data-overlay hidden>
        <div class="dialog">
          <header class="titlebar"><span data-overlay-title>Jam clear</span></header>
          <p data-overlay-copy>Sweet.</p>
          <button type="button" data-again>Play again</button>
        </div>
      </div>
    </section>
  </main>
</BlockLayout>

<script>
  const size = 9;
  const tapLimit = 30;
  const target = 5000;
  const statsKey = 'pc:arcade:nouns-jam';
  const profileKey = 'pc:arcade:profile';
  const TYPES = [
    { noun: 3, color: '#ff8ba8' },
    { noun: 17, color: '#ffc96b' },
    { noun: 41, color: '#7de08f' },
    { noun: 66, color: '#7ec2ff' },
    { noun: 89, color: '#c9a0f0' },
  ];
  const boardEl = document.querySelector<HTMLElement>('[data-board]');
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  const scoreEl = document.querySelector<HTMLElement>('[data-score]');
  const tapsEl = document.querySelector<HTMLElement>('[data-taps]');
  const bestEl = document.querySelector<HTMLElement>('[data-best]');
  const overlayEl = document.querySelector<HTMLElement>('[data-overlay]');
  const overlayTitleEl = document.querySelector<HTMLElement>('[data-overlay-title]');
  const overlayCopyEl = document.querySelector<HTMLElement>('[data-overlay-copy]');
  let grid = []; // number type index or null
  let score = 0;
  let taps = tapLimit;
  let over = false;
  let busy = false;
  let biggestPop = 0;

  function readJson(key, fallback) {
    try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
  }
  function writeJson(key, value) { localStorage.setItem(key, JSON.stringify(value)); }
  function say(text) { if (statusEl) statusEl.textContent = text; }
  function idx(x, y) { return y * size + x; }

  function updateArcadeProfile(won = false) {
    const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: null });
    stats.plays = Number(stats.plays || 0) + (won ? 0 : 1);
    if (won) {
      stats.clears = Number(stats.clears || 0) + 1;
      stats.bestScore = stats.bestScore ? Math.max(stats.bestScore, score) : score;
    }
    writeJson(statsKey, stats);
    const profile = readJson(profileKey, { achievements: [] });
    profile.totalPlays = Number(profile.totalPlays || 0) + (won ? 0 : 1);
    profile.lastPlayed = 'Jam';
    if (won) {
      profile.clears = Number(profile.clears || 0) + 1;
      profile.clearStreak = Number(profile.clearStreak || 0) + 1;
      profile.lastCleared = 'Jam';
      const earned = ['first-win', 'jam-clear'];
      if (profile.clearStreak >= 3) earned.push('three-game-streak');
      if (biggestPop >= 10) earned.push('cascade-chain');
      profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
    }
    writeJson(profileKey, profile);
  }

  function groupAt(start) {
    const type = grid[start];
    if (type === null || type === undefined) return [];
    const seen = new Set([start]);
    const queue = [start];
    while (queue.length) {
      const i = queue.pop();
      const x = i % size;
      const y = Math.floor(i / size);
      [[x - 1, y], [x + 1, y], [x, y - 1], [x, y + 1]].forEach(([nx, ny]) => {
        if (nx < 0 || ny < 0 || nx >= size || ny >= size) return;
        const j = idx(nx, ny);
        if (!seen.has(j) && grid[j] === type) { seen.add(j); queue.push(j); }
      });
    }
    return Array.from(seen);
  }

  function collapse() {
    // fall down within each column
    for (let x = 0; x < size; x++) {
      const column = [];
      for (let y = size - 1; y >= 0; y--) {
        const cell = grid[idx(x, y)];
        if (cell !== null) column.push(cell);
      }
      for (let y = size - 1; y >= 0; y--) {
        grid[idx(x, y)] = column[size - 1 - y] ?? null;
      }
    }
    // shift non-empty columns left
    const columns = [];
    for (let x = 0; x < size; x++) {
      const col = Array.from({ length: size }, (_, y) => grid[idx(x, y)]);
      if (col.some((cell) => cell !== null)) columns.push(col);
    }
    for (let x = 0; x < size; x++) {
      const col = columns[x] || Array.from({ length: size }, () => null);
      for (let y = 0; y < size; y++) grid[idx(x, y)] = col[y];
    }
  }

  function anyGroupLeft() {
    for (let i = 0; i < grid.length; i++) {
      if (grid[i] !== null && groupAt(i).length >= 2) return true;
    }
    return false;
  }

  function endCheck() {
    busy = false;
    renderStats();
    if (over) return;
    if (score >= target) {
      over = true;
      updateArcadeProfile(true);
      showOverlay('Jam clear', `Score ${score} with ${taps} taps left. Biggest pop: ${biggestPop} noggles.`);
      return;
    }
    if (taps <= 0 || !anyGroupLeft()) {
      over = true;
      const why = taps <= 0 ? 'Out of taps.' : 'No groups left to pop.';
      showOverlay('Game over', `${why} Final score ${score}. Target was ${target}.`);
    }
  }

  function showOverlay(title, copy) {
    if (overlayTitleEl) overlayTitleEl.textContent = title;
    if (overlayCopyEl) overlayCopyEl.textContent = copy;
    overlayEl?.removeAttribute('hidden');
  }

  function pop(start) {
    if (busy || over) return;
    const group = groupAt(start);
    if (group.length < 2) { say('Needs a group of at least two.'); return; }
    busy = true;
    taps -= 1;
    const points = group.length * (group.length - 1) * 10;
    score += points;
    biggestPop = Math.max(biggestPop, group.length);
    say(group.length >= 6 ? `JAM BONUS! ${group.length} noggles for ${points}.` : `Popped ${group.length} for ${points}.`);
    render(new Set(group));
    window.setTimeout(() => {
      group.forEach((i) => { grid[i] = null; });
      collapse();
      render();
      endCheck();
    }, 200);
  }

  function renderStats() {
    if (scoreEl) scoreEl.textContent = String(score);
    if (tapsEl) tapsEl.textContent = String(taps);
    const stats = readJson(statsKey, {});
    if (bestEl) bestEl.textContent = stats.bestScore ? String(stats.bestScore) : '--';
  }

  function render(clearing = new Set()) {
    if (!boardEl) return;
    boardEl.innerHTML = grid.map((type, i) => {
      if (type === null) return `<button class="tile is-empty" data-index="${i}" aria-label="empty"></button>`;
      const t = TYPES[type];
      return `<button class="tile ${clearing.has(i) ? 'is-clearing' : ''}" data-index="${i}" style="--tile:${t.color}" aria-label="noggle ${type + 1}">
        <img src="https://noun.pics/${t.noun}.svg" alt="" loading="lazy">
      </button>`;
    }).join('');
    renderStats();
  }

  function hint() {
    if (busy || over) return;
    let best = [];
    const seen = new Set();
    for (let i = 0; i < grid.length; i++) {
      if (grid[i] === null || seen.has(i)) continue;
      const group = groupAt(i);
      group.forEach((j) => seen.add(j));
      if (group.length > best.length) best = group;
    }
    if (best.length < 2) { say('No groups left.'); return; }
    best.forEach((i) => {
      const el = boardEl?.querySelector(`[data-index="${i}"]`);
      el?.classList.add('is-hint');
      window.setTimeout(() => el?.classList.remove('is-hint'), 1200);
    });
    say(`Biggest group on the board: ${best.length} noggles.`);
  }

  function newGame() {
    do {
      grid = Array.from({ length: size * size }, () => Math.floor(Math.random() * TYPES.length));
    } while (!anyGroupLeft());
    score = 0;
    taps = tapLimit;
    over = false;
    busy = false;
    biggestPop = 0;
    overlayEl?.setAttribute('hidden', '');
    updateArcadeProfile(false);
    say(`Fresh jar. Hit ${target} points in ${tapLimit} taps.`);
    render();
  }

  boardEl?.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest('[data-index]');
    if (!el) return;
    pop(Number(el.getAttribute('data-index')));
  });
  document.querySelector('[data-new]')?.addEventListener('click', newGame);
  document.querySelector('[data-again]')?.addEventListener('click', newGame);
  document.querySelector('[data-hint]')?.addEventListener('click', hint);
  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() === 'n') newGame();
    if (event.key.toLowerCase() === 'h') hint();
  });
  newGame();
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:18px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; }
  .window { position:relative; max-width:920px; margin:0 auto; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; box-shadow:2px 2px 0 #000; }
  .titlebar { display:flex; justify-content:space-between; min-height:28px; padding:3px 5px 3px 7px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:4px; }
  .buttons i { display:grid; place-items:center; width:19px; height:18px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { border:0; background:transparent; color:#000; padding:4px 8px; font:inherit; text-decoration:none; }
  .menubar button:hover,.menubar a:hover { background:#000080; color:#fff; }
  .toolbar { display:grid; grid-template-columns:repeat(4,96px) minmax(0,1fr); gap:6px; padding:7px; border-top:1px solid #fff; border-bottom:1px solid #808080; }
  .toolbar span,.toolbar p,.status { margin:0; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 7px; font-size:12px; }
  .toolbar strong { float:right; font-family:"Courier New",monospace; }
  .felt { display:grid; place-items:center; min-height:560px; padding:18px; background:linear-gradient(rgba(0,62,48,.34),rgba(0,52,42,.58)),var(--arcade-desktop) center/cover; overflow:auto; }
  .board { display:grid; grid-template-columns:repeat(9,46px); gap:3px; padding:10px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#c0c0c0; }
  /* Tiles are injected via innerHTML, so they miss Astro's scope attribute — anchor them to the scoped board instead. */
  .board :global(.tile) { width:46px; height:46px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:var(--tile,#c0c0c0); padding:0; cursor:pointer; transition:transform .12s; }
  .board :global(.tile img) { width:34px; height:34px; image-rendering:pixelated; }
  .board :global(.tile:hover) { transform:scale(1.06); }
  .board :global(.tile.is-hint) { outline:3px solid #00ff80; outline-offset:-4px; }
  .board :global(.tile.is-clearing) { transform:scale(.2); opacity:.2; transition:transform .18s,opacity .18s; }
  .board :global(.tile.is-empty) { background:#9a9a9a; border-color:#808080 #fff #fff #808080; cursor:default; }
  .status { margin:4px; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,64,.45); }
  .overlay[hidden] { display:none; }
  .dialog { min-width:280px; max-width:360px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; box-shadow:3px 3px 0 #000; }
  .dialog p { margin:0; padding:14px; font-size:13px; line-height:1.4; }
  .dialog button { margin:0 14px 14px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; padding:6px 18px; font:inherit; cursor:pointer; }
  .dialog button:active { border-color:#404040 #fff #fff #404040; }
  @media (max-width:560px) { .desk{padding:8px}.toolbar{grid-template-columns:1fr 1fr}.toolbar p{grid-column:1/-1}.felt{padding:10px;justify-items:start}.board{grid-template-columns:repeat(9,34px)}.board :global(.tile){width:34px;height:34px}.board :global(.tile img){width:25px;height:25px} }
</style>
