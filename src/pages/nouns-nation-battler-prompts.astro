---
/**
 * /nouns-nation-battler-prompts - outcome-first prompt kit for visiting agents.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { NOUNS_BATTLER_AGENT_PROMPT_KIT } from '../lib/nouns-battler-agent-bench';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Nouns Nation Battler Agent Prompt Kit',
  description:
    'Outcome-first prompts for visiting agents that want to scout, recap, QA, package sponsors, direct TV, or make shareable Nouns Battler assets.',
  url: 'https://pointcast.xyz/nouns-nation-battler-prompts/',
  isPartOf: {
    '@type': 'VideoGame',
    name: 'Nouns Nation Battler',
    url: 'https://pointcast.xyz/nouns-nation-battler/',
  },
};
---

<BlockLayout
  title="Nouns Battler Agent Prompt Kit"
  description="Outcome-first prompts for visiting agents: one role, one artifact, one evidence budget, one stop rule, and one validation line for Nouns Nation Battler."
  image="/images/og/nouns-battler-agents.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-battler-agents.json', title: 'Nouns Nation Battler Agent Bench JSON' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-agents.png',
    buttons: [
      { label: 'Prompt Kit', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-prompts/' },
      { label: 'Agent JSON', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-agents.json' },
      { label: 'Mobile Cast', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-mobile/' },
      { label: 'TV Cast', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-tv/' },
    ],
  }}
>
  <main class="prompt-kit">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-battler-agents/">Agent Bench</a>
      <span aria-hidden="true">/</span>
      <span>Prompt Kit</span>
    </nav>

    <section class="hero" aria-labelledby="prompt-kit-title">
      <p class="kicker">CH.BTL / AGENT PROMPT KIT / v{NOUNS_BATTLER_AGENT_PROMPT_KIT.version}</p>
      <h1 id="prompt-kit-title">Give the visiting agent one clean job.</h1>
      <p>{NOUNS_BATTLER_AGENT_PROMPT_KIT.posture}</p>
      <div class="actions">
        <a href="/nouns-nation-battler-agents.json">Agent JSON</a>
        <a href="/nouns-nation-battler-mobile/">Mobile Cast</a>
        <a href="/nouns-nation-battler-tv/">TV Cast</a>
        <a href="/nouns-nation-battler-sponsors/">Sponsor Desk</a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div>
        <p class="kicker">Prompt posture</p>
        <h2 id="principles-title">Small budget, clear artifact, clean stop.</h2>
      </div>
      <ul>
        {NOUNS_BATTLER_AGENT_PROMPT_KIT.principles.map((principle) => (
          <li>{principle}</li>
        ))}
      </ul>
    </section>

    <section class="cards" aria-label="Copyable agent prompts">
      {NOUNS_BATTLER_AGENT_PROMPT_KIT.prompts.map((prompt) => (
        <article>
          <div class="card-top">
            <span>{prompt.role}</span>
            <a href={prompt.startHere}>{new URL(prompt.startHere).pathname}</a>
          </div>
          <h2>{prompt.goal}</h2>
          <p>{prompt.prompt}</p>
          <dl>
            <dt>Evidence Budget</dt>
            <dd>{prompt.evidenceBudget}</dd>
            <dt>Stop Rule</dt>
            <dd>{prompt.stopRule}</dd>
            <dt>Validation</dt>
            <dd>{prompt.validation}</dd>
          </dl>
          <div class="criteria">
            {prompt.successCriteria.map((criterion) => (
              <span>{criterion}</span>
            ))}
          </div>
          <code>{prompt.outputFormat}</code>
        </article>
      ))}
    </section>

    <section class="source" aria-label="Source guidance">
      <p>
        Tuned from the official OpenAI prompt guidance for agentic GPT-5.5 work:
        <a href={NOUNS_BATTLER_AGENT_PROMPT_KIT.sourceGuidance}>developers.openai.com prompt guidance</a>.
      </p>
    </section>
  </main>
</BlockLayout>

<style>
  .prompt-kit {
    display: grid;
    gap: 24px;
  }

  .crumb,
  .actions,
  .card-top,
  .criteria {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .crumb {
    color: #5f5e5a;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .hero,
  .cards article {
    display: grid;
    gap: 14px;
  }

  .hero {
    max-width: 1040px;
    padding: 28px 0 12px;
  }

  .hero h1,
  .principles h2 {
    margin: 0;
    color: #12110e;
    font-size: clamp(40px, 7vw, 82px);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .hero p,
  .source p {
    max-width: 760px;
    color: #38373a;
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .kicker,
  .card-top span,
  dt {
    margin: 0;
    color: #8a2432;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .actions a,
  .card-top a {
    border: 1px solid #12110e;
    border-radius: 999px;
    padding: 8px 12px;
    color: #12110e;
    font-weight: 850;
    text-decoration: none;
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid #c4c2bc;
    border-bottom: 1px solid #c4c2bc;
  }

  .principles h2 {
    font-size: clamp(30px, 5vw, 56px);
  }

  .principles ul,
  dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .principles ul {
    padding: 0;
    list-style: none;
  }

  .principles li,
  .cards article {
    border: 1px solid #c4c2bc;
    border-radius: 8px;
    background: #fff;
  }

  .principles li {
    padding: 12px 14px;
    color: #38373a;
    font-weight: 750;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .cards article {
    padding: 18px;
  }

  .cards h2 {
    margin: 0;
    color: #12110e;
    font-size: 1.45rem;
    line-height: 1.05;
  }

  .cards p,
  dd {
    margin: 0;
    color: #5f5e5a;
    line-height: 1.45;
  }

  dt {
    color: #5f5e5a;
    font-size: 0.7rem;
  }

  .criteria span {
    border: 1px solid #dedbd2;
    border-radius: 999px;
    padding: 6px 9px;
    color: #38373a;
    font-size: 0.82rem;
    font-weight: 800;
  }

  code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 8px;
    padding: 12px;
    background: #12110e;
    color: #fffdf5;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .source {
    border-top: 1px solid #c4c2bc;
    padding-top: 16px;
  }

  @media (max-width: 860px) {
    .principles,
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
