<script>
  // ===========================================================
  //  DRUM ACADEMY  —  five interactive Web Audio lessons.
  //  Each lesson is self-contained and uses a small subset of
  //  Web Audio nodes appropriate to the topic.
  // ===========================================================

  let ctx: AudioContext | null = null;
  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    // Audit fix #2: iOS Safari auto-suspends AudioContext on tab-switch.
    // Drum-academy doesn't use the shared scheduler — each lesson manages its
    // own oscillators. Just resume the context on visibility-return; oscillators
    // already running will pick back up. Harmless when no lesson is active.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running') {
        ctx.resume().catch(() => {});
      }
    });
    return ctx;
  }

  function $(id: string) { return document.getElementById(id); }

  // ---------- LESSON 1: STEREO ----------
  (() => {
    let playing = false; let interval: number | null = null;
    let pan = 0; // -1 .. 1
    let bpm = 100; let auto = false;
    let panNode: StereoPannerNode | null = null;
    let masterGain: GainNode | null = null;
    let analyserL: AnalyserNode | null = null; let analyserR: AnalyserNode | null = null;
    let splitter: ChannelSplitterNode | null = null;
    // Audit fix #6: track RAF so we can cancel on stop.
    let rafId = 0;

    function setup() {
      const c = ac();
      panNode = c.createStereoPanner();
      masterGain = c.createGain(); masterGain.gain.value = 0.6;
      splitter = c.createChannelSplitter(2);
      analyserL = c.createAnalyser(); analyserL.fftSize = 256;
      analyserR = c.createAnalyser(); analyserR.fftSize = 256;
      panNode.connect(masterGain);
      masterGain.connect(splitter);
      splitter.connect(analyserL, 0);
      splitter.connect(analyserR, 1);
      masterGain.connect(c.destination);
    }

    function kick(when: number) {
      const c = ac(); const o = c.createOscillator(); const g = c.createGain();
      o.frequency.setValueAtTime(120, when); o.frequency.exponentialRampToValueAtTime(40, when + 0.18);
      g.gain.setValueAtTime(0.001, when); g.gain.exponentialRampToValueAtTime(1.0, when + 0.005); g.gain.exponentialRampToValueAtTime(0.001, when + 0.36);
      o.connect(g); g.connect(panNode!);
      o.start(when); o.stop(when + 0.4);
    }

    function loop() {
      if (!playing) return;
      const c = ac();
      kick(c.currentTime + 0.02);
      if (auto) {
        const t = (Date.now() / 2000) % 1;
        pan = Math.sin(t * Math.PI * 2);
        (document.getElementById('da-stereo-pan') as HTMLInputElement).value = String(Math.round(pan * 100));
        updatePanLabel();
      }
      panNode!.pan.setTargetAtTime(pan, c.currentTime, 0.02);
    }

    function startMeters() {
      const dataL = new Uint8Array(analyserL!.frequencyBinCount);
      const dataR = new Uint8Array(analyserR!.frequencyBinCount);
      const fillL = $('da-stereo-l') as HTMLDivElement;
      const fillR = $('da-stereo-r') as HTMLDivElement;
      const tick = () => {
        // Audit fix #6: stop animating after the user clicks stop. Previously
        // ran at 60fps until navigation, re-reading from the analyser.
        if (!playing) return;
        if (!analyserL || !fillL) return;
        analyserL.getByteTimeDomainData(dataL);
        analyserR.getByteTimeDomainData(dataR);
        let pkL = 0, pkR = 0;
        for (let i = 0; i < dataL.length; i++) { const a = Math.abs(dataL[i] - 128); if (a > pkL) pkL = a; }
        for (let i = 0; i < dataR.length; i++) { const a = Math.abs(dataR[i] - 128); if (a > pkR) pkR = a; }
        fillL.style.width = Math.min(100, (pkL / 60) * 100) + '%';
        fillR.style.width = Math.min(100, (pkR / 60) * 100) + '%';
        rafId = requestAnimationFrame(tick);
      };
      tick();
    }

    function updatePanLabel() {
      const v = pan;
      const lbl = v < -0.7 ? 'hard left' : v < -0.2 ? 'left' : v < 0.2 ? 'center' : v < 0.7 ? 'right' : 'hard right';
      ($('da-stereo-pan-val') as HTMLSpanElement).textContent = lbl;
    }
    function updateBpmLabel() { ($('da-stereo-rate-val') as HTMLSpanElement).textContent = bpm + ' bpm'; }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-stereo-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        if (!ctx) { setup(); }
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) {
          playing = false; if (interval) { clearInterval(interval); interval = null; }
          // Audit fix #6: kill the meters RAF on stop.
          cancelAnimationFrame(rafId);
          btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing');
        } else {
          if (!panNode) { setup(); }
          playing = true;
          btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing');
          loop();
          interval = window.setInterval(loop, 60000 / bpm);
          startMeters();
        }
      });
      $('da-stereo-pan')?.addEventListener('input', (e) => { pan = Number((e.target as HTMLInputElement).value) / 100; updatePanLabel(); });
      $('da-stereo-rate')?.addEventListener('input', (e) => { bpm = Number((e.target as HTMLInputElement).value); updateBpmLabel(); if (interval) { clearInterval(interval); interval = window.setInterval(loop, 60000 / bpm); } });
      $('da-stereo-auto')?.addEventListener('change', (e) => { auto = (e.target as HTMLInputElement).checked; });
      updatePanLabel(); updateBpmLabel();
    });
  })();

  // ---------- LESSON 2: BINAURAL ----------
  (() => {
    let playing = false;
    let oscL: OscillatorNode | null = null; let oscR: OscillatorNode | null = null;
    let gainL: GainNode | null = null; let gainR: GainNode | null = null;
    let merger: ChannelMergerNode | null = null;
    let analyser: AnalyserNode | null = null;
    let carrier = 200; let beat = 4;
    // Audit fix #6: track RAF so we can cancel on stop.
    let rafId = 0;

    function start() {
      const c = ac();
      oscL = c.createOscillator(); oscR = c.createOscillator();
      gainL = c.createGain(); gainR = c.createGain();
      gainL.gain.value = 0.18; gainR.gain.value = 0.18;
      merger = c.createChannelMerger(2);
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      oscL.frequency.value = carrier;
      oscR.frequency.value = carrier + beat;
      oscL.connect(gainL); gainL.connect(merger, 0, 0);
      oscR.connect(gainR); gainR.connect(merger, 0, 1);
      merger.connect(analyser); analyser.connect(c.destination);
      oscL.start(); oscR.start();
      drawScope();
    }
    function stop() {
      try { oscL?.stop(); oscR?.stop(); } catch {}
      // Audit fix #6: previously left gain/merger/analyser connected to
      // c.destination after stop. After N play/stop cycles the graph held
      // N stale chains.
      try { gainL?.disconnect(); gainR?.disconnect(); merger?.disconnect(); analyser?.disconnect(); } catch {}
      oscL = oscR = null; gainL = gainR = null; merger = null; analyser = null;
      cancelAnimationFrame(rafId);
    }

    function updateFreqs() {
      if (oscL && oscR) {
        const c = ac();
        oscL.frequency.setTargetAtTime(carrier, c.currentTime, 0.05);
        oscR.frequency.setTargetAtTime(carrier + beat, c.currentTime, 0.05);
      }
    }

    function band(b: number): string {
      if (b < 4) return 'delta · deep sleep';
      if (b < 8) return 'theta · meditative';
      if (b < 13) return 'alpha · relaxed';
      return 'beta · alert';
    }

    function drawScope() {
      const cv = $('da-bin-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        // Top half = L (sine at carrier)
        x.strokeStyle = '#9ed6f0'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(i / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = (h * 0.25) + v * (h * 0.20);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        // Bottom half = simulated R (offset slightly to imply beat — same buffer, just visually offset)
        x.strokeStyle = '#f6c15e'; x.beginPath();
        const offset = 8;
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(((i + offset) % w) / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = (h * 0.75) + v * (h * 0.20);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        // Center divider
        x.strokeStyle = 'rgba(244,231,200,0.10)'; x.lineWidth = 1; x.beginPath(); x.moveTo(0, h/2); x.lineTo(w, h/2); x.stroke();
        if (playing) rafId = requestAnimationFrame(tick);
      };
      tick();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-bin-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play binaural'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-bin-carrier')?.addEventListener('input', (e) => { carrier = Number((e.target as HTMLInputElement).value); ($('da-bin-carrier-val') as HTMLSpanElement).textContent = carrier + ' Hz'; updateFreqs(); });
      $('da-bin-beat')?.addEventListener('input', (e) => { beat = Number((e.target as HTMLInputElement).value); ($('da-bin-beat-val') as HTMLSpanElement).textContent = beat + ' Hz · ' + band(beat); updateFreqs(); });
    });
  })();

  // ---------- LESSON 3: WAVEFORMS ----------
  (() => {
    let playing = false;
    let osc: OscillatorNode | null = null;
    let gain: GainNode | null = null;
    let analyserT: AnalyserNode | null = null;
    let analyserF: AnalyserNode | null = null;
    let type: OscillatorType = 'sawtooth';
    let freq = 220;
    // Audit fix #6: track RAF so we can cancel on stop.
    let rafId = 0;

    function start() {
      const c = ac();
      osc = c.createOscillator(); osc.type = type; osc.frequency.value = freq;
      gain = c.createGain(); gain.gain.value = 0.18;
      analyserT = c.createAnalyser(); analyserT.fftSize = 2048;
      analyserF = c.createAnalyser(); analyserF.fftSize = 2048;
      osc.connect(gain); gain.connect(analyserT); gain.connect(analyserF); gain.connect(c.destination);
      osc.start();
      drawScope();
    }
    function stop() {
      try { osc?.stop(); } catch {}
      // Audit fix #6: disconnect gain/analysers so the graph doesn't accumulate.
      try { gain?.disconnect(); analyserT?.disconnect(); analyserF?.disconnect(); } catch {}
      osc = null; gain = null; analyserT = null; analyserF = null;
      cancelAnimationFrame(rafId);
    }

    function drawScope() {
      const ct = $('da-wave-time') as HTMLCanvasElement;
      const cf = $('da-wave-freq-canvas') as HTMLCanvasElement;
      if (!ct || !cf) return;
      const xt = ct.getContext('2d')!; const xf = cf.getContext('2d')!;
      const wt = ct.width; const ht = ct.height;
      const wf = cf.width; const hf = cf.height;
      const dataT = new Uint8Array(analyserT!.fftSize);
      const dataF = new Uint8Array(analyserF!.frequencyBinCount);
      const tick = () => {
        if (!analyserT || !analyserF) return;
        analyserT.getByteTimeDomainData(dataT);
        analyserF.getByteFrequencyData(dataF);
        // Time domain
        xt.fillStyle = '#050208'; xt.fillRect(0, 0, wt, ht);
        xt.strokeStyle = '#f6c15e'; xt.lineWidth = 1.5; xt.beginPath();
        for (let i = 0; i < wt; i++) {
          const idx = Math.floor(i / wt * dataT.length);
          const v = (dataT[idx] - 128) / 128;
          const y = ht/2 + v * (ht * 0.42);
          if (i === 0) xt.moveTo(i, y); else xt.lineTo(i, y);
        }
        xt.stroke();
        // Frequency domain (only show first 1/8 — interesting harmonic range)
        xf.fillStyle = '#050208'; xf.fillRect(0, 0, wf, hf);
        const range = Math.floor(dataF.length / 16);
        const barW = wf / range;
        for (let i = 0; i < range; i++) {
          const v = dataF[i] / 255;
          const h = v * hf;
          const grad = xf.createLinearGradient(0, hf, 0, hf - h);
          grad.addColorStop(0, '#5a3422'); grad.addColorStop(0.5, '#f6c15e'); grad.addColorStop(1, '#ff5f7a');
          xf.fillStyle = grad;
          xf.fillRect(i * barW, hf - h, Math.max(1, barW - 1), h);
        }
        if (playing) rafId = requestAnimationFrame(tick);
      };
      tick();
    }

    function freqLabel(f: number): string {
      const A4 = 440;
      const semis = Math.round(12 * Math.log2(f / A4));
      const NAMES = ['A','A#','B','C','C#','D','D#','E','F','F#','G','G#'];
      const idx = ((semis % 12) + 12) % 12;
      const oct = 4 + Math.floor((semis + 9) / 12);
      return f + ' Hz · ' + NAMES[idx] + oct;
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-wave-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-wave-type')?.addEventListener('change', (e) => { type = (e.target as HTMLSelectElement).value as OscillatorType; if (osc) osc.type = type; });
      $('da-wave-freq')?.addEventListener('input', (e) => { freq = Number((e.target as HTMLInputElement).value); ($('da-wave-freq-val') as HTMLSpanElement).textContent = freqLabel(freq); if (osc) osc.frequency.setTargetAtTime(freq, ac().currentTime, 0.02); });
    });
  })();

  // ---------- LESSON 4: AM ----------
  (() => {
    let playing = false;
    let carrier: OscillatorNode | null = null;
    let modulator: OscillatorNode | null = null;
    let modGain: GainNode | null = null; let constSrc: ConstantSourceNode | null = null;
    let outGain: GainNode | null = null;
    let analyser: AnalyserNode | null = null;
    let cFreq = 800; let mFreq = 4; let depth = 0.8;
    // Audit fix #6: track RAF so we can cancel on stop.
    let rafId = 0;

    function start() {
      const c = ac();
      carrier = c.createOscillator(); carrier.type = 'sine'; carrier.frequency.value = cFreq;
      modulator = c.createOscillator(); modulator.type = 'sine'; modulator.frequency.value = mFreq;
      // For AM: gain = 1 + depth*sin(modulator). We use ConstantSourceNode at 1.0 + modulator scaled by depth
      constSrc = c.createConstantSource(); constSrc.offset.value = 1 - depth;
      modGain = c.createGain(); modGain.gain.value = depth;
      outGain = c.createGain(); outGain.gain.value = 0; // will be driven by const+mod
      modulator.connect(modGain); modGain.connect(outGain.gain);
      constSrc.connect(outGain.gain);
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      carrier.connect(outGain); outGain.connect(analyser); analyser.connect(c.destination);
      carrier.start(); modulator.start(); constSrc.start();
      drawScope();
    }
    function stop() {
      try { carrier?.stop(); modulator?.stop(); constSrc?.stop(); } catch {}
      // Audit fix #6: disconnect gain/analyser nodes so the graph doesn't grow
      // each play/stop cycle.
      try { modGain?.disconnect(); outGain?.disconnect(); analyser?.disconnect(); } catch {}
      carrier = modulator = constSrc = null;
      modGain = null; outGain = null; analyser = null;
      cancelAnimationFrame(rafId);
    }
    function drawScope() {
      const cv = $('da-am-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d')!;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        x.strokeStyle = '#ff5f7a'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(i / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = h/2 + v * (h * 0.42);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        if (playing) rafId = requestAnimationFrame(tick);
      };
      tick();
    }

    function modLabel(m: number): string {
      if (m < 6) return m + ' Hz · slow tremolo';
      if (m < 14) return m + ' Hz · fast tremolo';
      return m + ' Hz · ring mod territory';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-am-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-am-carrier')?.addEventListener('input', (e) => { cFreq = Number((e.target as HTMLInputElement).value); ($('da-am-carrier-val') as HTMLSpanElement).textContent = cFreq + ' Hz'; if (carrier) carrier.frequency.setTargetAtTime(cFreq, ac().currentTime, 0.02); });
      $('da-am-mod')?.addEventListener('input', (e) => { mFreq = Number((e.target as HTMLInputElement).value); ($('da-am-mod-val') as HTMLSpanElement).textContent = modLabel(mFreq); if (modulator) modulator.frequency.setTargetAtTime(mFreq, ac().currentTime, 0.02); });
      $('da-am-depth')?.addEventListener('input', (e) => { depth = Number((e.target as HTMLInputElement).value) / 100; ($('da-am-depth-val') as HTMLSpanElement).textContent = Math.round(depth * 100) + '%'; if (modGain && constSrc) { modGain.gain.setTargetAtTime(depth, ac().currentTime, 0.05); constSrc.offset.setTargetAtTime(1 - depth, ac().currentTime, 0.05); } });
    });
  })();

  // ---------- LESSON 5: FM ----------
  (() => {
    let playing = false;
    let carrier: OscillatorNode | null = null;
    let modulator: OscillatorNode | null = null;
    let modGain: GainNode | null = null;
    let outGain: GainNode | null = null;
    let analyser: AnalyserNode | null = null;
    let cFreq = 220; let ratio = 3.0; let index = 1.0;
    // Audit fix #6: track RAF so we can cancel on stop.
    let rafId = 0;

    function setMod() {
      if (modulator && modGain) {
        const c = ac();
        modulator.frequency.setTargetAtTime(cFreq * ratio, c.currentTime, 0.02);
        modGain.gain.setTargetAtTime(cFreq * index, c.currentTime, 0.02);
      }
    }

    function start() {
      const c = ac();
      carrier = c.createOscillator(); carrier.type = 'sine'; carrier.frequency.value = cFreq;
      modulator = c.createOscillator(); modulator.type = 'sine'; modulator.frequency.value = cFreq * ratio;
      modGain = c.createGain(); modGain.gain.value = cFreq * index;
      outGain = c.createGain(); outGain.gain.value = 0.18;
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      // FM: modulator → modGain → carrier.frequency (offset, not replace)
      modulator.connect(modGain); modGain.connect(carrier.frequency);
      carrier.connect(outGain); outGain.connect(analyser); analyser.connect(c.destination);
      carrier.start(); modulator.start();
      drawScope();
    }
    function stop() {
      try { carrier?.stop(); modulator?.stop(); } catch {}
      // Audit fix #6: disconnect gain/analyser nodes so the graph doesn't grow.
      try { modGain?.disconnect(); outGain?.disconnect(); analyser?.disconnect(); } catch {}
      carrier = modulator = null;
      modGain = null; outGain = null; analyser = null;
      cancelAnimationFrame(rafId);
    }
    function drawScope() {
      const cv = $('da-fm-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d')!;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        x.strokeStyle = '#a8ff3a'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx2 = Math.floor(i / w * data.length);
          const v = (data[idx2] - 128) / 128;
          const y = h/2 + v * (h * 0.42);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        if (playing) rafId = requestAnimationFrame(tick);
      };
      tick();
    }

    function ratioLabel(r: number): string {
      if (Math.abs(r - 1) < 0.1) return r.toFixed(1) + '× = soft';
      if (Math.abs(r - 2) < 0.15) return r.toFixed(1) + '× = clarinet-ish';
      if (Math.abs(r - 3) < 0.15) return r.toFixed(1) + '× = bell-ish';
      if (r < 1) return r.toFixed(2) + '× = electric piano';
      return r.toFixed(1) + '× = inharmonic';
    }
    function indexLabel(i: number): string {
      if (i < 0.5) return i.toFixed(1) + ' — pure';
      if (i < 1.5) return i.toFixed(1) + ' — moderate brightness';
      if (i < 3) return i.toFixed(1) + ' — bright';
      return i.toFixed(1) + ' — chaotic / metallic';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-fm-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-fm-carrier')?.addEventListener('input', (e) => { cFreq = Number((e.target as HTMLInputElement).value); ($('da-fm-carrier-val') as HTMLSpanElement).textContent = cFreq + ' Hz'; if (carrier) carrier.frequency.setTargetAtTime(cFreq, ac().currentTime, 0.02); setMod(); });
      $('da-fm-ratio')?.addEventListener('input', (e) => { ratio = Number((e.target as HTMLInputElement).value) / 100; ($('da-fm-ratio-val') as HTMLSpanElement).textContent = ratioLabel(ratio); setMod(); });
      $('da-fm-index')?.addEventListener('input', (e) => { index = Number((e.target as HTMLInputElement).value) / 100; ($('da-fm-index-val') as HTMLSpanElement).textContent = indexLabel(index); setMod(); });
    });
  })();

  // ---------- LESSON 6: REVERB ----------
  (() => {
    let size = 1.8; let damp = 0.4;
    let convolver: ConvolverNode | null = null;

    function makeIR(seconds: number, damping: number): AudioBuffer {
      const c = ac();
      const sr = c.sampleRate;
      const len = Math.max(1, Math.floor(sr * seconds));
      const buf = c.createBuffer(2, len, sr);
      // Decay exponent — bigger damping = faster high-frequency decay.
      // Use a tilted exponential: high damping accelerates falloff.
      const decayExp = 2.0 + damping * 6.0;
      for (let ch = 0; ch < 2; ch++) {
        const d = buf.getChannelData(ch);
        let prev = 0;
        // 1-pole lowpass coefficient driven by damping — more damping = more smoothing = darker tail
        const lpCoeff = 0.05 + damping * 0.55;
        for (let i = 0; i < len; i++) {
          const t = i / len;
          const env = Math.pow(1 - t, decayExp);
          const noise = (Math.random() * 2 - 1) * env;
          // simple 1-pole lowpass for damping the highs
          prev = prev + lpCoeff * (noise - prev);
          d[i] = prev;
        }
      }
      return buf;
    }

    function rebuildIR() {
      const c = ac();
      if (!convolver) convolver = c.createConvolver();
      convolver.buffer = makeIR(size, damp);
      drawIR();
    }

    function kick(when: number, target: AudioNode) {
      const c = ac(); const o = c.createOscillator(); const g = c.createGain();
      o.frequency.setValueAtTime(120, when);
      o.frequency.exponentialRampToValueAtTime(40, when + 0.18);
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(1.0, when + 0.005);
      g.gain.exponentialRampToValueAtTime(0.001, when + 0.36);
      o.connect(g); g.connect(target);
      o.start(when); o.stop(when + 0.45);
    }

    function playDry() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      const g = c.createGain(); g.gain.value = 0.6; g.connect(c.destination);
      kick(c.currentTime + 0.02, g);
    }
    function playWet() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      if (!convolver) rebuildIR();
      const wet = c.createGain(); wet.gain.value = 0.85;
      convolver!.connect(wet); wet.connect(c.destination);
      const dry = c.createGain(); dry.gain.value = 0.3; dry.connect(c.destination);
      kick(c.currentTime + 0.02, dry);
      kick(c.currentTime + 0.02, convolver!);
    }
    function playSweep() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      if (!convolver) rebuildIR();
      const t0 = c.currentTime + 0.02;
      const dry = c.createGain(); dry.gain.setValueAtTime(0.8, t0); dry.gain.linearRampToValueAtTime(0.0, t0 + 2.0);
      const wet = c.createGain(); wet.gain.setValueAtTime(0.0, t0); wet.gain.linearRampToValueAtTime(0.9, t0 + 2.0);
      dry.connect(c.destination);
      convolver!.connect(wet); wet.connect(c.destination);
      // fire several kicks across the 2s sweep
      for (let i = 0; i < 5; i++) {
        kick(t0 + i * 0.45, dry);
        kick(t0 + i * 0.45, convolver!);
      }
    }

    function drawIR() {
      const cv = $('da-rev-scope') as HTMLCanvasElement; if (!cv || !convolver || !convolver.buffer) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const d = convolver.buffer.getChannelData(0);
      x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
      // baseline
      x.strokeStyle = 'rgba(244,231,200,0.10)'; x.lineWidth = 1;
      x.beginPath(); x.moveTo(0, h/2); x.lineTo(w, h/2); x.stroke();
      // envelope — peak per pixel
      x.strokeStyle = '#c98a5b'; x.lineWidth = 1.4; x.beginPath();
      const step = Math.max(1, Math.floor(d.length / w));
      for (let i = 0; i < w; i++) {
        let peak = 0;
        const start = i * step;
        const end = Math.min(d.length, start + step);
        for (let j = start; j < end; j++) { const a = Math.abs(d[j]); if (a > peak) peak = a; }
        const y = h/2 - peak * (h * 0.45);
        if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
      }
      x.stroke();
      // mirror
      x.beginPath();
      for (let i = 0; i < w; i++) {
        let peak = 0;
        const start = i * step;
        const end = Math.min(d.length, start + step);
        for (let j = start; j < end; j++) { const a = Math.abs(d[j]); if (a > peak) peak = a; }
        const y = h/2 + peak * (h * 0.45);
        if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
      }
      x.stroke();
    }

    function sizeLabel(s: number): string {
      if (s < 0.5) return s.toFixed(1) + ' s · bedroom';
      if (s < 1.2) return s.toFixed(1) + ' s · large room';
      if (s < 2.5) return s.toFixed(1) + ' s · medium hall';
      if (s < 4.0) return s.toFixed(1) + ' s · concert hall';
      return s.toFixed(1) + ' s · cathedral';
    }
    function dampLabel(d: number): string {
      if (d < 0.25) return Math.round(d*100) + '% · stone';
      if (d < 0.55) return Math.round(d*100) + '% · soft surfaces';
      return Math.round(d*100) + '% · heavily damped';
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('da-rev-dry')?.addEventListener('click', playDry);
      $('da-rev-wet')?.addEventListener('click', () => { if (!convolver) rebuildIR(); playWet(); });
      $('da-rev-sweep')?.addEventListener('click', () => { if (!convolver) rebuildIR(); playSweep(); });
      $('da-rev-size')?.addEventListener('input', (e) => { size = Number((e.target as HTMLInputElement).value) / 100; ($('da-rev-size-val') as HTMLSpanElement).textContent = sizeLabel(size); rebuildIR(); });
      $('da-rev-damp')?.addEventListener('input', (e) => { damp = Number((e.target as HTMLInputElement).value) / 100; ($('da-rev-damp-val') as HTMLSpanElement).textContent = dampLabel(damp); rebuildIR(); });
      // Lazy first build so canvas renders something
      // (We don't create the AudioContext until first interaction — defer canvas paint to first click)
    });
  })();

  // ---------- LESSON 7: COMPRESSION ----------
  (() => {
    let playing = false;
    let comp: DynamicsCompressorNode | null = null;
    let masterGain: GainNode | null = null;
    let interval: number | null = null;
    let toggle = false;
    let thresh = -24, ratio = 4, attack = 0.010, release = 0.120;

    function setup() {
      const c = ac();
      comp = c.createDynamicsCompressor();
      comp.threshold.value = thresh;
      comp.ratio.value = ratio;
      comp.attack.value = attack;
      comp.release.value = release;
      comp.knee.value = 6;
      masterGain = c.createGain(); masterGain.gain.value = 0.8;
      comp.connect(masterGain); masterGain.connect(c.destination);
    }

    function note(when: number, loud: boolean) {
      const c = ac();
      const o = c.createOscillator(); o.type = 'sawtooth'; o.frequency.value = 220;
      const g = c.createGain();
      const amp = loud ? 0.8 : 0.2;
      g.gain.setValueAtTime(0.0001, when);
      g.gain.exponentialRampToValueAtTime(amp, when + 0.005);
      g.gain.setValueAtTime(amp, when + 0.25);
      g.gain.exponentialRampToValueAtTime(0.0001, when + 0.35);
      o.connect(g); g.connect(comp!);
      o.start(when); o.stop(when + 0.4);
    }

    function loop() {
      const c = ac();
      note(c.currentTime + 0.02, toggle);
      toggle = !toggle;
    }

    function drawMeter() {
      const cv = $('da-comp-scope') as HTMLCanvasElement; if (!cv) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const history: number[] = new Array(w).fill(0);
      const tick = () => {
        if (!comp) { requestAnimationFrame(tick); return; }
        // reduction is in dB, always <= 0
        const r = comp.reduction; // -dB, e.g. -8 means 8 dB of gain reduction
        history.shift(); history.push(r);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        // grid
        x.strokeStyle = 'rgba(244,231,200,0.08)'; x.lineWidth = 1;
        for (let db = -5; db >= -30; db -= 5) {
          const y = -(db / 30) * h;
          x.beginPath(); x.moveTo(0, y); x.lineTo(w, y); x.stroke();
        }
        x.fillStyle = 'rgba(237,107,74,0.18)';
        x.beginPath(); x.moveTo(0, 0);
        for (let i = 0; i < w; i++) {
          const dB = history[i]; // <= 0
          const y = Math.max(0, Math.min(h, -(dB / 30) * h));
          x.lineTo(i, y);
        }
        x.lineTo(w, 0); x.closePath(); x.fill();
        x.strokeStyle = '#ed6b4a'; x.lineWidth = 1.6; x.beginPath();
        for (let i = 0; i < w; i++) {
          const dB = history[i];
          const y = Math.max(0, Math.min(h, -(dB / 30) * h));
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        x.fillStyle = '#f6c15e'; x.font = '10px "JetBrains Mono", monospace';
        x.fillText('GR: ' + comp.reduction.toFixed(1) + ' dB', 10, 16);
        requestAnimationFrame(tick);
      };
      tick();
    }

    function ratioLabel(r: number): string { return r.toFixed(1) + ' : 1'; }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-comp-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        if (!comp) { setup(); drawMeter(); }
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) {
          playing = false; if (interval) { clearInterval(interval); interval = null; }
          btn.textContent = '▶ play loud + soft'; btn.classList.remove('da__btn--playing');
        } else {
          playing = true; toggle = false;
          btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing');
          loop(); interval = window.setInterval(loop, 450);
        }
      });
      $('da-comp-thresh')?.addEventListener('input', (e) => { thresh = Number((e.target as HTMLInputElement).value); ($('da-comp-thresh-val') as HTMLSpanElement).textContent = thresh + ' dB'; if (comp) comp.threshold.setTargetAtTime(thresh, ac().currentTime, 0.01); });
      $('da-comp-ratio')?.addEventListener('input', (e) => { ratio = Number((e.target as HTMLInputElement).value) / 10; ($('da-comp-ratio-val') as HTMLSpanElement).textContent = ratioLabel(ratio); if (comp) comp.ratio.setTargetAtTime(ratio, ac().currentTime, 0.01); });
      $('da-comp-att')?.addEventListener('input', (e) => { const ms = Number((e.target as HTMLInputElement).value); attack = ms / 1000; ($('da-comp-att-val') as HTMLSpanElement).textContent = ms + ' ms'; if (comp) comp.attack.setTargetAtTime(attack, ac().currentTime, 0.01); });
      $('da-comp-rel')?.addEventListener('input', (e) => { const ms = Number((e.target as HTMLInputElement).value); release = ms / 1000; ($('da-comp-rel-val') as HTMLSpanElement).textContent = ms + ' ms'; if (comp) comp.release.setTargetAtTime(release, ac().currentTime, 0.01); });
    });
  })();

  // ---------- LESSON 8: KARPLUS-STRONG ----------
  (() => {
    let pitch = 220; let damping = 3500; let burstMs = 10;
    let analyser: AnalyserNode | null = null;
    let masterOut: GainNode | null = null;

    function ensureGraph() {
      if (analyser && masterOut) return;
      const c = ac();
      analyser = c.createAnalyser(); analyser.fftSize = 2048;
      masterOut = c.createGain(); masterOut.gain.value = 0.7;
      masterOut.connect(analyser); analyser.connect(c.destination);
      drawScope();
    }

    function makeNoiseBuffer(durMs: number): AudioBuffer {
      const c = ac();
      const sr = c.sampleRate;
      const len = Math.max(64, Math.floor(sr * durMs / 1000));
      const buf = c.createBuffer(1, len, sr);
      const d = buf.getChannelData(0);
      // smooth ramp at start + end so the burst doesn't click
      for (let i = 0; i < len; i++) {
        const env = Math.min(1, i / 64) * Math.min(1, (len - i) / 64);
        d[i] = (Math.random() * 2 - 1) * env;
      }
      return buf;
    }

    function pluck() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      ensureGraph();
      const delaySec = 1 / pitch;
      const src = c.createBufferSource(); src.buffer = makeNoiseBuffer(burstMs);
      const delay = c.createDelay(0.05); // 50 ms max — covers down to 20 Hz, fine for our 50-500 Hz range
      delay.delayTime.value = delaySec;
      const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = damping;
      const fb = c.createGain(); fb.gain.value = 0.96; // feedback amount — closer to 1.0 = longer ring
      const outAmp = c.createGain(); outAmp.gain.value = 0.55;
      // Wire: src → delay → lp → fb → (back into delay) and also → output
      src.connect(delay);
      delay.connect(lp);
      lp.connect(fb);
      fb.connect(delay);
      lp.connect(outAmp);
      outAmp.connect(masterOut!);
      // gradually decrease feedback after 2 seconds for a definite end
      const now = c.currentTime;
      fb.gain.setValueAtTime(0.96, now);
      fb.gain.setTargetAtTime(0.0, now + 2.0, 0.5);
      src.start(now);
      src.stop(now + (burstMs / 1000) + 0.05);
      // cleanup
      setTimeout(() => { try { src.disconnect(); delay.disconnect(); lp.disconnect(); fb.disconnect(); outAmp.disconnect(); } catch {} }, 5000);
    }

    function drawScope() {
      const cv = $('da-pluck-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        x.strokeStyle = '#6d8fb8'; x.lineWidth = 1.4; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(i / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = h/2 + v * (h * 0.45);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        requestAnimationFrame(tick);
      };
      tick();
    }

    function pitchLabel(p: number): string {
      const A4 = 440;
      const semis = Math.round(12 * Math.log2(p / A4));
      const NAMES = ['A','A#','B','C','C#','D','D#','E','F','F#','G','G#'];
      const idx = ((semis % 12) + 12) % 12;
      const oct = 4 + Math.floor((semis + 9) / 12);
      return p + ' Hz · ' + NAMES[idx] + oct;
    }
    function dampLabel(d: number): string {
      if (d < 1500) return (d/1000).toFixed(1) + ' kHz · dull';
      if (d < 4500) return (d/1000).toFixed(1) + ' kHz · nylon';
      return (d/1000).toFixed(1) + ' kHz · bright steel';
    }
    function burstLabel(b: number): string {
      if (b < 6) return b + ' ms · soft pluck';
      if (b < 20) return b + ' ms · medium pick';
      return b + ' ms · hard strike';
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('da-pluck-go')?.addEventListener('click', pluck);
      $('da-pluck-pitch')?.addEventListener('input', (e) => { pitch = Number((e.target as HTMLInputElement).value); ($('da-pluck-pitch-val') as HTMLSpanElement).textContent = pitchLabel(pitch); });
      $('da-pluck-damp')?.addEventListener('input', (e) => { damping = Number((e.target as HTMLInputElement).value); ($('da-pluck-damp-val') as HTMLSpanElement).textContent = dampLabel(damping); });
      $('da-pluck-bright')?.addEventListener('input', (e) => { burstMs = Number((e.target as HTMLInputElement).value); ($('da-pluck-bright-val') as HTMLSpanElement).textContent = burstLabel(burstMs); });
    });
  })();

  // ---------- LESSON 9: ADSR ----------
  (() => {
    let attack = 20, decay = 200, sustain = 0.6, release = 400;

    function drawEnv() {
      const cv = $('da-adsr-scope') as HTMLCanvasElement; if (!cv) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
      // baseline
      x.strokeStyle = 'rgba(244,231,200,0.10)'; x.lineWidth = 1;
      x.beginPath(); x.moveTo(0, h - 8); x.lineTo(w, h - 8); x.stroke();
      // ADSR phases — give release a fixed "held" duration
      const sustainHoldMs = 600;
      const totalMs = attack + decay + sustainHoldMs + release;
      const pad = 16;
      const drawW = w - pad * 2;
      const drawH = h - 24;
      const x0 = pad;
      const yBase = h - 12;
      const xA = x0 + (attack / totalMs) * drawW;
      const xD = xA + (decay / totalMs) * drawW;
      const xS = xD + (sustainHoldMs / totalMs) * drawW;
      const xR = xS + (release / totalMs) * drawW;
      const yPeak = yBase - drawH * 0.95;
      const ySus = yBase - drawH * 0.95 * sustain;
      // fill under curve
      x.fillStyle = 'rgba(78,192,164,0.16)';
      x.beginPath();
      x.moveTo(x0, yBase);
      x.lineTo(xA, yPeak);
      x.lineTo(xD, ySus);
      x.lineTo(xS, ySus);
      x.lineTo(xR, yBase);
      x.lineTo(x0, yBase);
      x.closePath(); x.fill();
      // stroke
      x.strokeStyle = '#4ec0a4'; x.lineWidth = 2; x.beginPath();
      x.moveTo(x0, yBase);
      x.lineTo(xA, yPeak);
      x.lineTo(xD, ySus);
      x.lineTo(xS, ySus);
      x.lineTo(xR, yBase);
      x.stroke();
      // markers
      x.strokeStyle = 'rgba(244,231,200,0.18)'; x.lineWidth = 1; x.setLineDash([2,3]);
      for (const xx of [xA, xD, xS, xR]) { x.beginPath(); x.moveTo(xx, 4); x.lineTo(xx, yBase); x.stroke(); }
      x.setLineDash([]);
      // labels
      x.fillStyle = '#f4e7c8'; x.font = '10px "JetBrains Mono", monospace';
      x.fillText('A', x0 + (xA - x0)/2 - 3, 14);
      x.fillText('D', xA + (xD - xA)/2 - 3, 14);
      x.fillText('S', xD + (xS - xD)/2 - 3, 14);
      x.fillText('R', xS + (xR - xS)/2 - 3, 14);
    }

    function playNote() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      const o = c.createOscillator(); o.type = 'sawtooth'; o.frequency.value = 220;
      const g = c.createGain();
      const t0 = c.currentTime;
      const peakTime = t0 + attack / 1000;
      const decayEndTime = peakTime + decay / 1000;
      const sustainHold = 0.6; // seconds
      const releaseStart = decayEndTime + sustainHold;
      const releaseEnd = releaseStart + release / 1000;
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.linearRampToValueAtTime(0.4, peakTime);
      g.gain.linearRampToValueAtTime(Math.max(0.0001, 0.4 * sustain), decayEndTime);
      g.gain.setValueAtTime(Math.max(0.0001, 0.4 * sustain), releaseStart);
      g.gain.linearRampToValueAtTime(0.0001, releaseEnd);
      o.connect(g); g.connect(c.destination);
      o.start(t0); o.stop(releaseEnd + 0.1);
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('da-adsr-play')?.addEventListener('click', playNote);
      $('da-adsr-a')?.addEventListener('input', (e) => { attack = Number((e.target as HTMLInputElement).value); ($('da-adsr-a-val') as HTMLSpanElement).textContent = attack + ' ms'; drawEnv(); });
      $('da-adsr-d')?.addEventListener('input', (e) => { decay = Number((e.target as HTMLInputElement).value); ($('da-adsr-d-val') as HTMLSpanElement).textContent = decay + ' ms'; drawEnv(); });
      $('da-adsr-s')?.addEventListener('input', (e) => { sustain = Number((e.target as HTMLInputElement).value) / 100; ($('da-adsr-s-val') as HTMLSpanElement).textContent = sustain.toFixed(2); drawEnv(); });
      $('da-adsr-r')?.addEventListener('input', (e) => { release = Number((e.target as HTMLInputElement).value); ($('da-adsr-r-val') as HTMLSpanElement).textContent = release + ' ms'; drawEnv(); });
      drawEnv();
    });
  })();

  // ---------- LESSON 10: FILTER SWEEP / LFO ----------
  (() => {
    let playing = false;
    let osc: OscillatorNode | null = null;
    let filt: BiquadFilterNode | null = null;
    let lfo: OscillatorNode | null = null;
    let lfoGain: GainNode | null = null;
    let outGain: GainNode | null = null;
    let baseCutoff: ConstantSourceNode | null = null;
    let ftype: BiquadFilterType = 'lowpass';
    let rate = 2.0; let depth = 0.7;

    const CENTER = 800;  // Hz center for lowpass/highpass
    const SPAN = 700;    // +/- swing at depth=1

    function paramsForType() {
      if (ftype === 'lowpass') return { center: 800, span: 700 };
      if (ftype === 'highpass') return { center: 600, span: 500 };
      return { center: 700, span: 500 }; // bandpass
    }

    function start() {
      const c = ac();
      osc = c.createOscillator(); osc.type = 'sawtooth'; osc.frequency.value = 110;
      filt = c.createBiquadFilter(); filt.type = ftype;
      const p = paramsForType();
      filt.frequency.value = p.center;
      if (ftype === 'bandpass') filt.Q.value = 4; else filt.Q.value = 6;
      // LFO additively modulates filt.frequency around its base.
      lfo = c.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = rate;
      lfoGain = c.createGain(); lfoGain.gain.value = p.span * depth;
      lfo.connect(lfoGain); lfoGain.connect(filt.frequency);
      outGain = c.createGain(); outGain.gain.value = 0.20;
      osc.connect(filt); filt.connect(outGain); outGain.connect(c.destination);
      osc.start(); lfo.start();
      drawScope();
    }

    function stop() {
      try { osc?.stop(); lfo?.stop(); } catch {}
      osc = lfo = null; filt = null; lfoGain = null; outGain = null;
    }

    function drawScope() {
      const cv = $('da-sweep-scope') as HTMLCanvasElement; if (!cv) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const history: number[] = new Array(w).fill(0);
      let last = performance.now();
      const tick = (now: number) => {
        if (!filt) return;
        const elapsed = (now - last) / 1000;
        last = now;
        // Sample the actual filter cutoff at the audio rate via filt.frequency.value (read-only of base; the AudioParam is automated by LFO)
        // To visualize the LFO contribution accurately, recompute conceptually:
        const c = ac();
        const t = c.currentTime;
        const p = paramsForType();
        const lfoVal = Math.sin(t * 2 * Math.PI * rate) * (p.span * depth);
        const cutoff = p.center + lfoVal;
        history.shift(); history.push(cutoff);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        // grid
        x.strokeStyle = 'rgba(244,231,200,0.08)'; x.lineWidth = 1;
        x.beginPath(); x.moveTo(0, h/2); x.lineTo(w, h/2); x.stroke();
        const maxF = p.center + p.span * 1.05;
        const minF = Math.max(0, p.center - p.span * 1.05);
        // fill
        x.fillStyle = 'rgba(193,74,142,0.18)';
        x.beginPath(); x.moveTo(0, h);
        for (let i = 0; i < w; i++) {
          const f = history[i];
          const y = h - ((f - minF) / (maxF - minF)) * h;
          x.lineTo(i, y);
        }
        x.lineTo(w, h); x.closePath(); x.fill();
        // line
        x.strokeStyle = '#c14a8e'; x.lineWidth = 1.6; x.beginPath();
        for (let i = 0; i < w; i++) {
          const f = history[i];
          const y = h - ((f - minF) / (maxF - minF)) * h;
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        // current cutoff readout
        x.fillStyle = '#f6c15e'; x.font = '10px "JetBrains Mono", monospace';
        x.fillText('cutoff: ' + Math.round(cutoff) + ' Hz', 10, 16);
        if (playing) requestAnimationFrame(tick);
        // tiny unused shim to keep TS happy about elapsed param
        void elapsed;
      };
      requestAnimationFrame(tick);
    }

    function rateLabel(r: number): string {
      if (r < 1) return r.toFixed(1) + ' Hz · very slow wobble';
      if (r < 4) return r.toFixed(1) + ' Hz · slow wobble';
      if (r < 8) return r.toFixed(1) + ' Hz · classic dub wobble';
      return r.toFixed(1) + ' Hz · fast / vibrato';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-sweep-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-sweep-type')?.addEventListener('change', (e) => {
        ftype = (e.target as HTMLSelectElement).value as BiquadFilterType;
        if (filt) {
          filt.type = ftype;
          const p = paramsForType();
          filt.frequency.setTargetAtTime(p.center, ac().currentTime, 0.02);
          if (lfoGain) lfoGain.gain.setTargetAtTime(p.span * depth, ac().currentTime, 0.02);
          if (ftype === 'bandpass') filt.Q.setTargetAtTime(4, ac().currentTime, 0.02); else filt.Q.setTargetAtTime(6, ac().currentTime, 0.02);
        }
      });
      $('da-sweep-rate')?.addEventListener('input', (e) => { rate = Number((e.target as HTMLInputElement).value) / 10; ($('da-sweep-rate-val') as HTMLSpanElement).textContent = rateLabel(rate); if (lfo) lfo.frequency.setTargetAtTime(rate, ac().currentTime, 0.02); });
      $('da-sweep-depth')?.addEventListener('input', (e) => { depth = Number((e.target as HTMLInputElement).value) / 100; ($('da-sweep-depth-val') as HTMLSpanElement).textContent = Math.round(depth * 100) + '%'; if (lfoGain && filt) { const p = paramsForType(); lfoGain.gain.setTargetAtTime(p.span * depth, ac().currentTime, 0.02); } });
    });
  })();
</script>
</BlockLayout>