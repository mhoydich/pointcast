---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Academy — five Nouns teach you sound" description="Interactive lessons in stereo, binaural beats, waveforms + harmonics, AM modulation, and FM modulation. Each topic taught by a different Noun. Headphones recommended.">
  <main class="da" id="da" data-built={built}>
    <header class="da__top">
      <div class="da__top-l">
        <p class="da__kicker">DRUM ACADEMY · listen with headphones</p>
        <h1 class="da__title">Five Nouns teach you sound.</h1>
        <p class="da__sub">Five interactive lessons. Each one is a few interactive sliders and a little oscilloscope. Real audio off the Web Audio primitives. No marketing — just the actual signal.</p>
      </div>
      <nav class="da__nav" aria-label="Lessons">
        <a href="#stereo"     class="da__nav-link">1 · Stereo</a>
        <a href="#binaural"   class="da__nav-link">2 · Binaural</a>
        <a href="#waveforms"  class="da__nav-link">3 · Waveforms</a>
        <a href="#am"         class="da__nav-link">4 · AM Radio</a>
        <a href="#fm"         class="da__nav-link">5 · FM Synth</a>
        <a href="/cast-real"  class="da__nav-link da__nav-link--alt">↪ /cast-real</a>
      </nav>
    </header>

    <!-- ============== LESSON 1: STEREO ============== -->
    <section class="da__lesson" id="stereo">
      <div class="da__teacher">
        <div class="da__teacher-portrait" style="--tc: #9ed6f0;">
          <img src="https://noun.pics/313.svg" alt="Marine Layer · Noun #313"/>
        </div>
        <div class="da__teacher-meta">
          <p class="da__lesson-num">LESSON 1 · MARINE LAYER · NOUN #313</p>
          <h2 class="da__lesson-title">Stereo · two ears, two channels.</h2>
        </div>
      </div>
      <div class="da__lesson-body">
        <p class="da__lesson-text">A stereo signal is just two mono channels played simultaneously into your left and right ears. <strong>Panning</strong> is the volume balance between them. Pan all the way left and only your left ear hears the sound; pan center and both ears hear it equally.</p>
        <p class="da__lesson-text">Tap <em>play</em>. A kick repeats. Drag the slider — the kick walks from your left ear to your right. Watch the L/R meters move with it.</p>
        <div class="da__panel">
          <div class="da__controls">
            <button class="da__btn" id="da-stereo-play" type="button">▶ play</button>
            <div class="da__row">
              <span class="da__row-l">PAN</span>
              <input type="range" class="da__slider" id="da-stereo-pan" min="-100" max="100" value="0"/>
              <span class="da__row-r" id="da-stereo-pan-val">center</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">RATE</span>
              <input type="range" class="da__slider" id="da-stereo-rate" min="60" max="180" value="100"/>
              <span class="da__row-r" id="da-stereo-rate-val">100 bpm</span>
            </div>
            <label class="da__check"><input type="checkbox" id="da-stereo-auto"/> auto-walk · pan moves on its own</label>
          </div>
          <div class="da__viz">
            <p class="da__viz-label">L/R METERS</p>
            <div class="da__lr-meters">
              <div class="da__lr-meter"><span>L</span><div class="da__lr-track"><div class="da__lr-fill" id="da-stereo-l"></div></div></div>
              <div class="da__lr-meter"><span>R</span><div class="da__lr-track"><div class="da__lr-fill" id="da-stereo-r"></div></div></div>
            </div>
          </div>
        </div>
        <p class="da__try">Try this: enable <em>auto-walk</em> and close your eyes. Most listeners can localize a kick within ~10° accuracy.</p>
      </div>
    </section>

    <!-- ============== LESSON 2: BINAURAL ============== -->
    <section class="da__lesson" id="binaural">
      <div class="da__teacher">
        <div class="da__teacher-portrait" style="--tc: #6f59c0;">
          <img src="https://noun.pics/1189.svg" alt="Night Broadcast · Noun #1189"/>
        </div>
        <div class="da__teacher-meta">
          <p class="da__lesson-num">LESSON 2 · NIGHT BROADCAST · NOUN #1189</p>
          <h2 class="da__lesson-title">Binaural beats · the brain's third tone.</h2>
        </div>
      </div>
      <div class="da__lesson-body">
        <p class="da__lesson-text">Play a 200 Hz tone in your <strong>left</strong> ear and a 204 Hz tone in your <strong>right</strong> ear. There is no 4 Hz signal anywhere in the air — but your brain, trying to merge the two ears into one perception, generates a <em>perceived</em> 4 Hz pulse called a binaural beat.</p>
        <p class="da__lesson-text">The illusion only works on <strong>headphones</strong>. On speakers, the two tones mix in the room and you hear them as a regular acoustic beat (which is real, not perceptual).</p>
        <div class="da__panel">
          <div class="da__controls">
            <button class="da__btn" id="da-bin-play" type="button">▶ play binaural</button>
            <div class="da__row">
              <span class="da__row-l">CARRIER</span>
              <input type="range" class="da__slider" id="da-bin-carrier" min="100" max="500" value="200"/>
              <span class="da__row-r" id="da-bin-carrier-val">200 Hz</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">BEAT</span>
              <input type="range" class="da__slider" id="da-bin-beat" min="1" max="20" value="4"/>
              <span class="da__row-r" id="da-bin-beat-val">4 Hz · theta · meditative</span>
            </div>
            <p class="da__hint">brainwave bands: 1–4 Hz delta · 4–8 Hz theta · 8–13 Hz alpha · 13–30 Hz beta</p>
          </div>
          <div class="da__viz">
            <p class="da__viz-label">SIGNAL · L (top) · R (bottom)</p>
            <canvas class="da__scope" id="da-bin-scope" width="600" height="180"></canvas>
          </div>
        </div>
        <p class="da__try">Try this: set the beat to <em>1 Hz</em> and you'll hear a slow throb. Set it to <em>15 Hz</em> and the perception changes from "slow pulse" to "buzz." Above ~30 Hz the brain stops merging and you hear two separate tones.</p>
      </div>
    </section>

    <!-- ============== LESSON 3: WAVEFORMS ============== -->
    <section class="da__lesson" id="waveforms">
      <div class="da__teacher">
        <div class="da__teacher-portrait" style="--tc: #f6c15e;">
          <img src="https://noun.pics/287.svg" alt="Brass on Main · Noun #287"/>
        </div>
        <div class="da__teacher-meta">
          <p class="da__lesson-num">LESSON 3 · BRASS ON MAIN · NOUN #287</p>
          <h2 class="da__lesson-title">Waveforms · why a violin isn't a flute.</h2>
        </div>
      </div>
      <div class="da__lesson-body">
        <p class="da__lesson-text">The <strong>frequency</strong> of a wave decides the pitch. The <strong>shape</strong> decides the timbre — what makes a violin sound different from a flute even at the same note.</p>
        <p class="da__lesson-text">A pure <strong>sine</strong> wave has only its fundamental frequency — no overtones. A <strong>square</strong> wave is the fundamental + odd harmonics (3rd, 5th, 7th…) at decreasing volume — that's the buzzy, hollow sound. A <strong>sawtooth</strong> includes all harmonics — that's the bright, brassy sound. A <strong>triangle</strong> has odd harmonics like a square but they fall off faster — gentler.</p>
        <div class="da__panel">
          <div class="da__controls">
            <button class="da__btn" id="da-wave-play" type="button">▶ play</button>
            <div class="da__row">
              <span class="da__row-l">SHAPE</span>
              <select class="da__select" id="da-wave-type">
                <option value="sine">sine — pure tone, no overtones</option>
                <option value="triangle">triangle — soft odd harmonics</option>
                <option value="square">square — buzzy odd harmonics</option>
                <option value="sawtooth" selected>sawtooth — bright, all harmonics</option>
              </select>
            </div>
            <div class="da__row">
              <span class="da__row-l">PITCH</span>
              <input type="range" class="da__slider" id="da-wave-freq" min="80" max="800" value="220"/>
              <span class="da__row-r" id="da-wave-freq-val">220 Hz · A3</span>
            </div>
          </div>
          <div class="da__viz">
            <p class="da__viz-label">TIME · waveform</p>
            <canvas class="da__scope" id="da-wave-time" width="600" height="120"></canvas>
            <p class="da__viz-label" style="margin-top:8px;">FREQUENCY · spectrum</p>
            <canvas class="da__scope" id="da-wave-freq-canvas" width="600" height="120"></canvas>
          </div>
        </div>
        <p class="da__try">Try this: switch between sine and sawtooth at the same pitch. The pitch is identical — your brain tracks the fundamental. The <em>color</em> changes wildly because of the harmonics.</p>
      </div>
    </section>

    <!-- ============== LESSON 4: AM RADIO ============== -->
    <section class="da__lesson" id="am">
      <div class="da__teacher">
        <div class="da__teacher-portrait" style="--tc: #ff5f7a;">
          <img src="https://noun.pics/612.svg" alt="Friday Five · Noun #612"/>
        </div>
        <div class="da__teacher-meta">
          <p class="da__lesson-num">LESSON 4 · FRIDAY FIVE · NOUN #612</p>
          <h2 class="da__lesson-title">AM Radio · amplitude in motion.</h2>
        </div>
      </div>
      <div class="da__lesson-body">
        <p class="da__lesson-text">AM = <strong>amplitude modulation</strong>. A high-frequency <em>carrier</em> (radio station: 1090 kHz, here we use 800 Hz so you can hear it) has its volume modulated — slowly raised and lowered — by a <em>modulator</em> signal. That modulator is the audio you want to broadcast: voice, music, anything.</p>
        <p class="da__lesson-text">When your radio receives the wave, it strips away the carrier and leaves only the modulator's volume curve — which is the original audio. You're hearing the <em>shape</em> of the carrier wave.</p>
        <div class="da__panel">
          <div class="da__controls">
            <button class="da__btn" id="da-am-play" type="button">▶ play</button>
            <div class="da__row">
              <span class="da__row-l">CARRIER</span>
              <input type="range" class="da__slider" id="da-am-carrier" min="100" max="2000" value="800"/>
              <span class="da__row-r" id="da-am-carrier-val">800 Hz</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">MOD HZ</span>
              <input type="range" class="da__slider" id="da-am-mod" min="1" max="20" value="4"/>
              <span class="da__row-r" id="da-am-mod-val">4 Hz · slow tremolo</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">DEPTH</span>
              <input type="range" class="da__slider" id="da-am-depth" min="0" max="100" value="80"/>
              <span class="da__row-r" id="da-am-depth-val">80%</span>
            </div>
          </div>
          <div class="da__viz">
            <p class="da__viz-label">CARRIER × MODULATOR · the broadcast wave</p>
            <canvas class="da__scope" id="da-am-scope" width="600" height="180"></canvas>
          </div>
        </div>
        <p class="da__try">Try this: set MOD HZ to <em>5</em> — that's a guitar tremolo effect. Set MOD HZ to <em>8</em> and the tremolo gets fast enough to hear as a separate buzz. Around <em>15+ Hz</em> it crosses into ring modulation territory.</p>
      </div>
    </section>

    <!-- ============== LESSON 5: FM ============== -->
    <section class="da__lesson" id="fm">
      <div class="da__teacher">
        <div class="da__teacher-portrait" style="--tc: #a8ff3a;">
          <img src="https://noun.pics/523.svg" alt="Block Runner · Noun #523"/>
        </div>
        <div class="da__teacher-meta">
          <p class="da__lesson-num">LESSON 5 · BLOCK RUNNER · NOUN #523</p>
          <h2 class="da__lesson-title">FM · the bell sound that runs the world.</h2>
        </div>
      </div>
      <div class="da__lesson-body">
        <p class="da__lesson-text">FM = <strong>frequency modulation</strong>. Instead of modulating the carrier's <em>volume</em> (AM), you modulate its <em>pitch</em>. A 440 Hz carrier whose frequency is wobbled by another oscillator generates a complex wave with multiple sidebands — and that's how you get bell sounds, electric pianos, plucky basses, glassy pads.</p>
        <p class="da__lesson-text">This is what powered the Yamaha DX7 in 1983 — the synth that defined 80s music. The Rhodes piano, the marimba, the bass on every Phil Collins record: all FM.</p>
        <div class="da__panel">
          <div class="da__controls">
            <button class="da__btn" id="da-fm-play" type="button">▶ play</button>
            <div class="da__row">
              <span class="da__row-l">CARRIER</span>
              <input type="range" class="da__slider" id="da-fm-carrier" min="80" max="800" value="220"/>
              <span class="da__row-r" id="da-fm-carrier-val">220 Hz</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">RATIO</span>
              <input type="range" class="da__slider" id="da-fm-ratio" min="50" max="700" value="300"/>
              <span class="da__row-r" id="da-fm-ratio-val">3.0× = bell-ish</span>
            </div>
            <div class="da__row">
              <span class="da__row-l">INDEX</span>
              <input type="range" class="da__slider" id="da-fm-index" min="0" max="500" value="100"/>
              <span class="da__row-r" id="da-fm-index-val">1.0 — moderate brightness</span>
            </div>
          </div>
          <div class="da__viz">
            <p class="da__viz-label">RESULTING WAVE</p>
            <canvas class="da__scope" id="da-fm-scope" width="600" height="180"></canvas>
          </div>
        </div>
        <p class="da__try">Try this: set RATIO to <em>1.0×</em> and INDEX low → soft tone. Set RATIO to <em>3.5×</em>, INDEX <em>3.0</em> → bell. Set RATIO to <em>0.5×</em>, INDEX <em>4.0</em> → electric piano. The DX7 had 32 of these "operators" you could route into each other in any topology.</p>
      </div>
    </section>

    <footer class="da__foot">
      <p>Drum Academy · pointcast.xyz · {built.slice(0,10)}</p>
      <p>← <a href="/cast-real">Back to /cast-real</a> · <a href="/cast-studio">/cast-studio</a> · <a href="/cast-music-pro">/cast-music-pro</a> · <a href="/">PointCast home</a></p>
      <p class="da__foot-credit">All sound is generated live in your browser via the Web Audio API. Source code: view-source on this page.</p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --da-bg: #0a0610; --da-bg-2: #170a18;
    --da-walnut: #5a3422; --da-flame: #f6c15e; --da-cream: #f4e7c8;
    --da-velvet: #1a0820; --da-glass: rgba(244,231,200,0.04);
    --da-line: rgba(244,231,200,0.10);
    --da-text: #f4e7c8; --da-text-mute: rgba(244,231,200,0.62); --da-text-quiet: rgba(244,231,200,0.38);
    --da-display: 'Inter Tight', system-ui, sans-serif;
    --da-body: 'Inter', system-ui, sans-serif;
    --da-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  body { background: var(--da-bg); color: var(--da-text); font-family: var(--da-body); }

  .da { max-width: 920px; margin: 0 auto; padding: 32px 22px 80px 22px; }

  .da__top { padding: 24px 0 36px 0; border-bottom: 1px solid var(--da-line); margin-bottom: 32px; }
  .da__top-l { margin-bottom: 22px; }
  .da__kicker { font-family: var(--da-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--da-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .da__title { font-family: var(--da-display); font-weight: 800; font-size: clamp(36px, 5.5vw, 60px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 14px 0; color: var(--da-text); }
  .da__sub { font-family: var(--da-body); font-size: 15px; color: var(--da-text-mute); max-width: 680px; line-height: 1.6; margin: 0; }
  .da__nav { display: flex; gap: 8px; flex-wrap: wrap; }
  .da__nav-link {
    background: var(--da-glass); border: 1px solid var(--da-line);
    color: var(--da-text); padding: 7px 14px; border-radius: 999px;
    font-family: var(--da-mono); font-size: 11.5px; letter-spacing: 0.3px;
    text-decoration: none; transition: background 0.18s ease, border-color 0.18s ease;
  }
  .da__nav-link:hover { background: rgba(244,231,200,0.10); border-color: var(--da-flame); }
  .da__nav-link--alt { color: var(--da-flame); }

  .da__lesson { padding: 36px 0 44px 0; border-bottom: 1px solid var(--da-line); scroll-margin-top: 16px; }
  .da__lesson:last-of-type { border-bottom: 0; }
  .da__teacher { display: flex; gap: 18px; align-items: center; margin-bottom: 22px; }
  .da__teacher-portrait { width: 76px; height: 76px; border-radius: 50%; background: linear-gradient(135deg, var(--tc, var(--da-walnut)) 0%, var(--da-velvet) 100%); display: grid; place-items: center; flex-shrink: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.42); }
  .da__teacher-portrait img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4)); }
  .da__lesson-num { font-family: var(--da-mono); font-size: 10px; letter-spacing: 0.6px; color: var(--da-text-quiet); text-transform: uppercase; margin: 0 0 4px 0; }
  .da__lesson-title { font-family: var(--da-display); font-weight: 800; font-size: clamp(24px, 3.4vw, 34px); line-height: 1.1; letter-spacing: -0.015em; margin: 0; color: var(--da-text); }

  .da__lesson-body { padding: 0; }
  .da__lesson-text { font-family: var(--da-body); font-size: 15px; color: var(--da-text-mute); line-height: 1.65; margin: 0 0 14px 0; }
  .da__lesson-text strong { color: var(--da-text); font-weight: 600; }
  .da__lesson-text em { color: var(--da-flame); font-style: normal; }

  .da__panel {
    background: linear-gradient(180deg, var(--da-glass), transparent);
    border: 1px solid var(--da-line); border-radius: 12px;
    padding: 22px; margin: 22px 0;
    display: grid; grid-template-columns: 1fr 1.2fr; gap: 22px;
  }
  @media (max-width: 720px) { .da__panel { grid-template-columns: 1fr; } }

  .da__controls { display: flex; flex-direction: column; gap: 12px; }
  .da__btn {
    background: var(--da-flame); color: var(--da-velvet);
    border: 0; padding: 11px 18px; border-radius: 8px;
    font-family: var(--da-display); font-weight: 700; font-size: 13.5px;
    cursor: pointer; align-self: flex-start;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .da__btn:hover { transform: scale(1.04); background: #ffd58a; }
  .da__btn--playing { background: var(--da-cream); }

  .da__row { display: grid; grid-template-columns: 80px 1fr 130px; gap: 10px; align-items: center; }
  .da__row-l { font-family: var(--da-mono); font-size: 10px; color: var(--da-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; }
  .da__row-r { font-family: var(--da-mono); font-size: 11px; color: var(--da-text); text-align: right; }
  .da__slider { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer; }
  .da__slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--da-flame); cursor: pointer; }
  .da__slider::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--da-flame); cursor: pointer; border: 0; }

  .da__select {
    background: rgba(0,0,0,0.40); color: var(--da-text);
    border: 1px solid var(--da-line); border-radius: 6px;
    padding: 8px 12px; font-family: var(--da-body); font-size: 13px; outline: 0; cursor: pointer;
    grid-column: 2 / span 2;
  }

  .da__check { font-family: var(--da-mono); font-size: 11px; color: var(--da-text-mute); display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .da__check input { accent-color: var(--da-flame); }

  .da__hint { font-family: var(--da-mono); font-size: 10.5px; color: var(--da-text-quiet); margin: 0; padding: 6px 0; border-top: 1px dashed var(--da-line); }

  .da__viz { background: rgba(0,0,0,0.30); border: 1px solid var(--da-line); border-radius: 8px; padding: 14px; }
  .da__viz-label { font-family: var(--da-mono); font-size: 10px; color: var(--da-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; margin: 0 0 10px 0; }
  .da__scope { width: 100%; height: auto; display: block; background: #050208; border-radius: 4px; }

  .da__lr-meters { display: grid; grid-template-rows: 1fr 1fr; gap: 10px; padding: 8px 0; }
  .da__lr-meter { display: grid; grid-template-columns: 24px 1fr; gap: 10px; align-items: center; }
  .da__lr-meter > span { font-family: var(--da-mono); font-size: 12px; color: var(--da-flame); text-align: center; }
  .da__lr-track { height: 18px; background: rgba(244,231,200,0.10); border-radius: 3px; overflow: hidden; }
  .da__lr-fill { height: 100%; background: linear-gradient(90deg, var(--da-flame), var(--da-cream)); width: 0%; transition: width 0.06s linear; }

  .da__try {
    background: rgba(246,193,94,0.08); border-left: 3px solid var(--da-flame);
    padding: 14px 18px; border-radius: 0 6px 6px 0;
    font-family: var(--da-body); font-size: 14px; color: var(--da-text-mute); line-height: 1.55; margin: 18px 0 0 0;
  }
  .da__try em { color: var(--da-flame); font-style: normal; font-weight: 600; }

  .da__foot { padding: 36px 0 0 0; border-top: 1px solid var(--da-line); margin-top: 36px; font-family: var(--da-mono); font-size: 11px; color: var(--da-text-quiet); line-height: 1.7; text-align: center; }
  .da__foot a { color: var(--da-flame); text-decoration: none; }
  .da__foot a:hover { text-decoration: underline; }
  .da__foot-credit { margin-top: 14px; font-size: 10.5px; color: var(--da-text-quiet); }
</style>

<script>
  // ===========================================================
  //  DRUM ACADEMY  —  five interactive Web Audio lessons.
  //  Each lesson is self-contained and uses a small subset of
  //  Web Audio nodes appropriate to the topic.
  // ===========================================================

  let ctx: AudioContext | null = null;
  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    return ctx;
  }

  function $(id: string) { return document.getElementById(id); }

  // ---------- LESSON 1: STEREO ----------
  (() => {
    let playing = false; let interval: number | null = null;
    let pan = 0; // -1 .. 1
    let bpm = 100; let auto = false;
    let panNode: StereoPannerNode | null = null;
    let masterGain: GainNode | null = null;
    let analyserL: AnalyserNode | null = null; let analyserR: AnalyserNode | null = null;
    let splitter: ChannelSplitterNode | null = null;

    function setup() {
      const c = ac();
      panNode = c.createStereoPanner();
      masterGain = c.createGain(); masterGain.gain.value = 0.6;
      splitter = c.createChannelSplitter(2);
      analyserL = c.createAnalyser(); analyserL.fftSize = 256;
      analyserR = c.createAnalyser(); analyserR.fftSize = 256;
      panNode.connect(masterGain);
      masterGain.connect(splitter);
      splitter.connect(analyserL, 0);
      splitter.connect(analyserR, 1);
      masterGain.connect(c.destination);
    }

    function kick(when: number) {
      const c = ac(); const o = c.createOscillator(); const g = c.createGain();
      o.frequency.setValueAtTime(120, when); o.frequency.exponentialRampToValueAtTime(40, when + 0.18);
      g.gain.setValueAtTime(0.001, when); g.gain.exponentialRampToValueAtTime(1.0, when + 0.005); g.gain.exponentialRampToValueAtTime(0.001, when + 0.36);
      o.connect(g); g.connect(panNode!);
      o.start(when); o.stop(when + 0.4);
    }

    function loop() {
      if (!playing) return;
      const c = ac();
      kick(c.currentTime + 0.02);
      if (auto) {
        const t = (Date.now() / 2000) % 1;
        pan = Math.sin(t * Math.PI * 2);
        (document.getElementById('da-stereo-pan') as HTMLInputElement).value = String(Math.round(pan * 100));
        updatePanLabel();
      }
      panNode!.pan.setTargetAtTime(pan, c.currentTime, 0.02);
    }

    function startMeters() {
      const dataL = new Uint8Array(analyserL!.frequencyBinCount);
      const dataR = new Uint8Array(analyserR!.frequencyBinCount);
      const fillL = $('da-stereo-l') as HTMLDivElement;
      const fillR = $('da-stereo-r') as HTMLDivElement;
      const tick = () => {
        if (!analyserL || !fillL) return;
        analyserL.getByteTimeDomainData(dataL);
        analyserR.getByteTimeDomainData(dataR);
        let pkL = 0, pkR = 0;
        for (let i = 0; i < dataL.length; i++) { const a = Math.abs(dataL[i] - 128); if (a > pkL) pkL = a; }
        for (let i = 0; i < dataR.length; i++) { const a = Math.abs(dataR[i] - 128); if (a > pkR) pkR = a; }
        fillL.style.width = Math.min(100, (pkL / 60) * 100) + '%';
        fillR.style.width = Math.min(100, (pkR / 60) * 100) + '%';
        requestAnimationFrame(tick);
      };
      tick();
    }

    function updatePanLabel() {
      const v = pan;
      const lbl = v < -0.7 ? 'hard left' : v < -0.2 ? 'left' : v < 0.2 ? 'center' : v < 0.7 ? 'right' : 'hard right';
      ($('da-stereo-pan-val') as HTMLSpanElement).textContent = lbl;
    }
    function updateBpmLabel() { ($('da-stereo-rate-val') as HTMLSpanElement).textContent = bpm + ' bpm'; }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-stereo-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        if (!ctx) { setup(); startMeters(); }
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) {
          playing = false; if (interval) { clearInterval(interval); interval = null; }
          btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing');
        } else {
          if (!panNode) { setup(); startMeters(); }
          playing = true;
          btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing');
          loop();
          interval = window.setInterval(loop, 60000 / bpm);
        }
      });
      $('da-stereo-pan')?.addEventListener('input', (e) => { pan = Number((e.target as HTMLInputElement).value) / 100; updatePanLabel(); });
      $('da-stereo-rate')?.addEventListener('input', (e) => { bpm = Number((e.target as HTMLInputElement).value); updateBpmLabel(); if (interval) { clearInterval(interval); interval = window.setInterval(loop, 60000 / bpm); } });
      $('da-stereo-auto')?.addEventListener('change', (e) => { auto = (e.target as HTMLInputElement).checked; });
      updatePanLabel(); updateBpmLabel();
    });
  })();

  // ---------- LESSON 2: BINAURAL ----------
  (() => {
    let playing = false;
    let oscL: OscillatorNode | null = null; let oscR: OscillatorNode | null = null;
    let gainL: GainNode | null = null; let gainR: GainNode | null = null;
    let merger: ChannelMergerNode | null = null;
    let analyser: AnalyserNode | null = null;
    let carrier = 200; let beat = 4;

    function start() {
      const c = ac();
      oscL = c.createOscillator(); oscR = c.createOscillator();
      gainL = c.createGain(); gainR = c.createGain();
      gainL.gain.value = 0.18; gainR.gain.value = 0.18;
      merger = c.createChannelMerger(2);
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      oscL.frequency.value = carrier;
      oscR.frequency.value = carrier + beat;
      oscL.connect(gainL); gainL.connect(merger, 0, 0);
      oscR.connect(gainR); gainR.connect(merger, 0, 1);
      merger.connect(analyser); analyser.connect(c.destination);
      oscL.start(); oscR.start();
      drawScope();
    }
    function stop() {
      try { oscL?.stop(); oscR?.stop(); } catch {}
      oscL = oscR = null; gainL = gainR = null;
    }

    function updateFreqs() {
      if (oscL && oscR) {
        const c = ac();
        oscL.frequency.setTargetAtTime(carrier, c.currentTime, 0.05);
        oscR.frequency.setTargetAtTime(carrier + beat, c.currentTime, 0.05);
      }
    }

    function band(b: number): string {
      if (b < 4) return 'delta · deep sleep';
      if (b < 8) return 'theta · meditative';
      if (b < 13) return 'alpha · relaxed';
      return 'beta · alert';
    }

    function drawScope() {
      const cv = $('da-bin-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d'); if (!x) return;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        // Top half = L (sine at carrier)
        x.strokeStyle = '#9ed6f0'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(i / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = (h * 0.25) + v * (h * 0.20);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        // Bottom half = simulated R (offset slightly to imply beat — same buffer, just visually offset)
        x.strokeStyle = '#f6c15e'; x.beginPath();
        const offset = 8;
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(((i + offset) % w) / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = (h * 0.75) + v * (h * 0.20);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        // Center divider
        x.strokeStyle = 'rgba(244,231,200,0.10)'; x.lineWidth = 1; x.beginPath(); x.moveTo(0, h/2); x.lineTo(w, h/2); x.stroke();
        if (playing) requestAnimationFrame(tick);
      };
      tick();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-bin-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play binaural'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-bin-carrier')?.addEventListener('input', (e) => { carrier = Number((e.target as HTMLInputElement).value); ($('da-bin-carrier-val') as HTMLSpanElement).textContent = carrier + ' Hz'; updateFreqs(); });
      $('da-bin-beat')?.addEventListener('input', (e) => { beat = Number((e.target as HTMLInputElement).value); ($('da-bin-beat-val') as HTMLSpanElement).textContent = beat + ' Hz · ' + band(beat); updateFreqs(); });
    });
  })();

  // ---------- LESSON 3: WAVEFORMS ----------
  (() => {
    let playing = false;
    let osc: OscillatorNode | null = null;
    let gain: GainNode | null = null;
    let analyserT: AnalyserNode | null = null;
    let analyserF: AnalyserNode | null = null;
    let type: OscillatorType = 'sawtooth';
    let freq = 220;

    function start() {
      const c = ac();
      osc = c.createOscillator(); osc.type = type; osc.frequency.value = freq;
      gain = c.createGain(); gain.gain.value = 0.18;
      analyserT = c.createAnalyser(); analyserT.fftSize = 2048;
      analyserF = c.createAnalyser(); analyserF.fftSize = 2048;
      osc.connect(gain); gain.connect(analyserT); gain.connect(analyserF); gain.connect(c.destination);
      osc.start();
      drawScope();
    }
    function stop() { try { osc?.stop(); } catch {}; osc = null; }

    function drawScope() {
      const ct = $('da-wave-time') as HTMLCanvasElement;
      const cf = $('da-wave-freq-canvas') as HTMLCanvasElement;
      if (!ct || !cf) return;
      const xt = ct.getContext('2d')!; const xf = cf.getContext('2d')!;
      const wt = ct.width; const ht = ct.height;
      const wf = cf.width; const hf = cf.height;
      const dataT = new Uint8Array(analyserT!.fftSize);
      const dataF = new Uint8Array(analyserF!.frequencyBinCount);
      const tick = () => {
        if (!analyserT || !analyserF) return;
        analyserT.getByteTimeDomainData(dataT);
        analyserF.getByteFrequencyData(dataF);
        // Time domain
        xt.fillStyle = '#050208'; xt.fillRect(0, 0, wt, ht);
        xt.strokeStyle = '#f6c15e'; xt.lineWidth = 1.5; xt.beginPath();
        for (let i = 0; i < wt; i++) {
          const idx = Math.floor(i / wt * dataT.length);
          const v = (dataT[idx] - 128) / 128;
          const y = ht/2 + v * (ht * 0.42);
          if (i === 0) xt.moveTo(i, y); else xt.lineTo(i, y);
        }
        xt.stroke();
        // Frequency domain (only show first 1/8 — interesting harmonic range)
        xf.fillStyle = '#050208'; xf.fillRect(0, 0, wf, hf);
        const range = Math.floor(dataF.length / 16);
        const barW = wf / range;
        for (let i = 0; i < range; i++) {
          const v = dataF[i] / 255;
          const h = v * hf;
          const grad = xf.createLinearGradient(0, hf, 0, hf - h);
          grad.addColorStop(0, '#5a3422'); grad.addColorStop(0.5, '#f6c15e'); grad.addColorStop(1, '#ff5f7a');
          xf.fillStyle = grad;
          xf.fillRect(i * barW, hf - h, Math.max(1, barW - 1), h);
        }
        if (playing) requestAnimationFrame(tick);
      };
      tick();
    }

    function freqLabel(f: number): string {
      const A4 = 440;
      const semis = Math.round(12 * Math.log2(f / A4));
      const NAMES = ['A','A#','B','C','C#','D','D#','E','F','F#','G','G#'];
      const idx = ((semis % 12) + 12) % 12;
      const oct = 4 + Math.floor((semis + 9) / 12);
      return f + ' Hz · ' + NAMES[idx] + oct;
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-wave-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-wave-type')?.addEventListener('change', (e) => { type = (e.target as HTMLSelectElement).value as OscillatorType; if (osc) osc.type = type; });
      $('da-wave-freq')?.addEventListener('input', (e) => { freq = Number((e.target as HTMLInputElement).value); ($('da-wave-freq-val') as HTMLSpanElement).textContent = freqLabel(freq); if (osc) osc.frequency.setTargetAtTime(freq, ac().currentTime, 0.02); });
    });
  })();

  // ---------- LESSON 4: AM ----------
  (() => {
    let playing = false;
    let carrier: OscillatorNode | null = null;
    let modulator: OscillatorNode | null = null;
    let modGain: GainNode | null = null; let constSrc: ConstantSourceNode | null = null;
    let outGain: GainNode | null = null;
    let analyser: AnalyserNode | null = null;
    let cFreq = 800; let mFreq = 4; let depth = 0.8;

    function start() {
      const c = ac();
      carrier = c.createOscillator(); carrier.type = 'sine'; carrier.frequency.value = cFreq;
      modulator = c.createOscillator(); modulator.type = 'sine'; modulator.frequency.value = mFreq;
      // For AM: gain = 1 + depth*sin(modulator). We use ConstantSourceNode at 1.0 + modulator scaled by depth
      constSrc = c.createConstantSource(); constSrc.offset.value = 1 - depth;
      modGain = c.createGain(); modGain.gain.value = depth;
      outGain = c.createGain(); outGain.gain.value = 0; // will be driven by const+mod
      modulator.connect(modGain); modGain.connect(outGain.gain);
      constSrc.connect(outGain.gain);
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      carrier.connect(outGain); outGain.connect(analyser); analyser.connect(c.destination);
      carrier.start(); modulator.start(); constSrc.start();
      drawScope();
    }
    function stop() {
      try { carrier?.stop(); modulator?.stop(); constSrc?.stop(); } catch {}
      carrier = modulator = constSrc = null;
    }
    function drawScope() {
      const cv = $('da-am-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d')!;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        x.strokeStyle = '#ff5f7a'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx = Math.floor(i / w * data.length);
          const v = (data[idx] - 128) / 128;
          const y = h/2 + v * (h * 0.42);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        if (playing) requestAnimationFrame(tick);
      };
      tick();
    }

    function modLabel(m: number): string {
      if (m < 6) return m + ' Hz · slow tremolo';
      if (m < 14) return m + ' Hz · fast tremolo';
      return m + ' Hz · ring mod territory';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-am-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-am-carrier')?.addEventListener('input', (e) => { cFreq = Number((e.target as HTMLInputElement).value); ($('da-am-carrier-val') as HTMLSpanElement).textContent = cFreq + ' Hz'; if (carrier) carrier.frequency.setTargetAtTime(cFreq, ac().currentTime, 0.02); });
      $('da-am-mod')?.addEventListener('input', (e) => { mFreq = Number((e.target as HTMLInputElement).value); ($('da-am-mod-val') as HTMLSpanElement).textContent = modLabel(mFreq); if (modulator) modulator.frequency.setTargetAtTime(mFreq, ac().currentTime, 0.02); });
      $('da-am-depth')?.addEventListener('input', (e) => { depth = Number((e.target as HTMLInputElement).value) / 100; ($('da-am-depth-val') as HTMLSpanElement).textContent = Math.round(depth * 100) + '%'; if (modGain && constSrc) { modGain.gain.setTargetAtTime(depth, ac().currentTime, 0.05); constSrc.offset.setTargetAtTime(1 - depth, ac().currentTime, 0.05); } });
    });
  })();

  // ---------- LESSON 5: FM ----------
  (() => {
    let playing = false;
    let carrier: OscillatorNode | null = null;
    let modulator: OscillatorNode | null = null;
    let modGain: GainNode | null = null;
    let outGain: GainNode | null = null;
    let analyser: AnalyserNode | null = null;
    let cFreq = 220; let ratio = 3.0; let index = 1.0;

    function setMod() {
      if (modulator && modGain) {
        const c = ac();
        modulator.frequency.setTargetAtTime(cFreq * ratio, c.currentTime, 0.02);
        modGain.gain.setTargetAtTime(cFreq * index, c.currentTime, 0.02);
      }
    }

    function start() {
      const c = ac();
      carrier = c.createOscillator(); carrier.type = 'sine'; carrier.frequency.value = cFreq;
      modulator = c.createOscillator(); modulator.type = 'sine'; modulator.frequency.value = cFreq * ratio;
      modGain = c.createGain(); modGain.gain.value = cFreq * index;
      outGain = c.createGain(); outGain.gain.value = 0.18;
      analyser = c.createAnalyser(); analyser.fftSize = 1024;
      // FM: modulator → modGain → carrier.frequency (offset, not replace)
      modulator.connect(modGain); modGain.connect(carrier.frequency);
      carrier.connect(outGain); outGain.connect(analyser); analyser.connect(c.destination);
      carrier.start(); modulator.start();
      drawScope();
    }
    function stop() {
      try { carrier?.stop(); modulator?.stop(); } catch {}
      carrier = modulator = null;
    }
    function drawScope() {
      const cv = $('da-fm-scope') as HTMLCanvasElement; if (!cv || !analyser) return;
      const x = cv.getContext('2d')!;
      const w = cv.width; const h = cv.height;
      const data = new Uint8Array(analyser.fftSize);
      const tick = () => {
        if (!analyser) return;
        analyser.getByteTimeDomainData(data);
        x.fillStyle = '#050208'; x.fillRect(0, 0, w, h);
        x.strokeStyle = '#a8ff3a'; x.lineWidth = 1.5; x.beginPath();
        for (let i = 0; i < w; i++) {
          const idx2 = Math.floor(i / w * data.length);
          const v = (data[idx2] - 128) / 128;
          const y = h/2 + v * (h * 0.42);
          if (i === 0) x.moveTo(i, y); else x.lineTo(i, y);
        }
        x.stroke();
        if (playing) requestAnimationFrame(tick);
      };
      tick();
    }

    function ratioLabel(r: number): string {
      if (Math.abs(r - 1) < 0.1) return r.toFixed(1) + '× = soft';
      if (Math.abs(r - 2) < 0.15) return r.toFixed(1) + '× = clarinet-ish';
      if (Math.abs(r - 3) < 0.15) return r.toFixed(1) + '× = bell-ish';
      if (r < 1) return r.toFixed(2) + '× = electric piano';
      return r.toFixed(1) + '× = inharmonic';
    }
    function indexLabel(i: number): string {
      if (i < 0.5) return i.toFixed(1) + ' — pure';
      if (i < 1.5) return i.toFixed(1) + ' — moderate brightness';
      if (i < 3) return i.toFixed(1) + ' — bright';
      return i.toFixed(1) + ' — chaotic / metallic';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const btn = $('da-fm-play') as HTMLButtonElement;
      btn?.addEventListener('click', () => {
        const c = ac(); if (c.state === 'suspended') c.resume();
        if (playing) { stop(); playing = false; btn.textContent = '▶ play'; btn.classList.remove('da__btn--playing'); }
        else { start(); playing = true; btn.textContent = '◼ stop'; btn.classList.add('da__btn--playing'); }
      });
      $('da-fm-carrier')?.addEventListener('input', (e) => { cFreq = Number((e.target as HTMLInputElement).value); ($('da-fm-carrier-val') as HTMLSpanElement).textContent = cFreq + ' Hz'; if (carrier) carrier.frequency.setTargetAtTime(cFreq, ac().currentTime, 0.02); setMod(); });
      $('da-fm-ratio')?.addEventListener('input', (e) => { ratio = Number((e.target as HTMLInputElement).value) / 100; ($('da-fm-ratio-val') as HTMLSpanElement).textContent = ratioLabel(ratio); setMod(); });
      $('da-fm-index')?.addEventListener('input', (e) => { index = Number((e.target as HTMLInputElement).value) / 100; ($('da-fm-index-val') as HTMLSpanElement).textContent = indexLabel(index); setMod(); });
    });
  })();
</script>
</BlockLayout>