---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CHANNELS } from '../lib/channels';
import {
  BUILDS,
  MONTHS,
  MONTH_NAMES,
  PADDLE_CALENDAR,
  PADDLE_CALENDAR_BLOCK,
  PADDLE_CALENDAR_JSON_URL,
  PADDLE_CALENDAR_RALLY_URL,
  PADDLE_CALENDAR_STATS,
  PADDLE_CALENDAR_URL,
  PADDLE_FUND_CAP_USD,
  RELEASES,
  hostOf,
  priceLabel,
  tierOf,
  type Build,
} from '../lib/paddle-calendar';

const title = 'The 2026 Paddle Calendar';
const description =
  `Every pickleball paddle release of 2026 on one calendar: ${PADDLE_CALENDAR_STATS.releases} launches from ${PADDLE_CALENDAR_STATS.brands} brands, dated, priced and sourced, with the rules, lawsuits and signings that shaped them, company files, and a labeled forecast through spring 2027.`;
const court = CHANNELS.CRT;
const { meta, anchors, ahead, signals, forecasts, trends, grit, moves, companies, undated, method } = PADDLE_CALENDAR;
const S = PADDLE_CALENDAR_STATS;

const monthKey = (iso: string) => iso.slice(0, 7);
const shortDate = (iso: string) => `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${Number(iso.slice(8, 10))}`;
const chip = (r: (typeof RELEASES)[number]) => r.short;

// The ledger: releases and the news that shaped them, one list per month.
type Row = { kind: 'release'; date: string; r: (typeof RELEASES)[number] } | { kind: 'wire'; date: string; a: (typeof anchors)[number] };
const rows: Row[] = [
  ...RELEASES.map((r) => ({ kind: 'release' as const, date: r.date, r })),
  ...anchors.map((a) => ({ kind: 'wire' as const, date: a.date, a })),
].sort((x, y) => x.date.localeCompare(y.date));
const ledgerKeys = [...new Set(rows.map((row) => (row.date < '2026-01-01' ? 'before' : monthKey(row.date))))];
const ledger = ledgerKeys.map((key) => ({
  key,
  label: key === 'before' ? 'Before the year' : `${MONTH_NAMES[Number(key.slice(5)) - 1]} ${key.slice(0, 4)}`,
  rows: rows.filter((row) => (row.date < '2026-01-01' ? 'before' : monthKey(row.date)) === key),
}));

// Year at a glance: twelve months, releases as chips, the road ahead dashed.
const year = MONTHS.map((m, i) => {
  const key = `2026-${String(i + 1).padStart(2, '0')}`;
  return {
    m,
    key,
    releases: RELEASES.filter((r) => monthKey(r.date) === key),
    wires: anchors.filter((a) => monthKey(a.date) === key),
    ahead: ahead.filter((a) => monthKey(a.date) === key && a.kind !== 'release'),
  };
});
const busiest = Math.max(...year.map((y) => y.releases.length));

// Price ladder: launch date against list price. One axis, colour = build.
const W = 1000, H = 380, L = 56, R = 18, T = 20, B = 40;
const t0 = Date.UTC(2026, 0, 1), t1 = Date.UTC(2026, 11, 31);
const x = (iso: string) => L + ((Date.parse(`${iso}T00:00:00Z`) - t0) / (t1 - t0)) * (W - L - R);
const yMin = 60, yMax = 350;
const y = (usd: number) => T + (1 - (usd - yMin) / (yMax - yMin)) * (H - T - B);
const dots = RELEASES.filter((r) => r.msrp != null);
const labelled = new Set(['joola-rally-rocket', 'spartus-spitfire', 'joola-power-fx', 'selkirk-omni']);
const builds = (Object.keys(BUILDS) as Build[]).filter((b) => RELEASES.some((r) => r.build === b));
const brands = [...new Set(RELEASES.map((r) => r.brand))].sort((a, b) => a.localeCompare(b));
const kindMark: Record<string, string> = { rule: 'RULE', legal: 'LEGAL', deal: 'MONEY', event: 'TOUR', market: 'MARKET', release: 'DROP' };
const basisLabel: Record<string, string> = { rule: 'RESTS ON A RULE', pattern: 'RESTS ON A PATTERN', inference: 'INFERENCE', legal: 'RESTS ON A CASE', open: 'OPEN QUESTION' };

const certBadges = (r: (typeof RELEASES)[number]) => [
  r.usap === 'yes' && 'USAP ✓',
  r.usap === 'no' && 'NOT USAP · TOUR ONLY',
  r.usap === 'split' && 'USAP: 16MM ONLY',
  r.usap === 'pending' && 'USAP PENDING',
  r.upaa === 'yes' && 'UPA-A ✓',
  r.upaa === 'split' && 'UPA-A: PRO VERSION',
  r.upaa === 'pending' && 'UPA-A PENDING',
].filter(Boolean) as string[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': PADDLE_CALENDAR_URL,
  name: title,
  description,
  url: PADDLE_CALENDAR_URL,
  dateModified: meta.asOf,
  temporalCoverage: '2026-01-01/2027-05-16',
  keywords: ['pickleball paddles', 'paddle release dates', 'foam core paddles', 'USA Pickleball', 'UPA-A', 'durable grit'],
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: PADDLE_CALENDAR_JSON_URL }],
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  sameAs: PADDLE_CALENDAR_RALLY_URL,
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="cal" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/c/court">court</a><span>/</span><span>paddle calendar</span>
      <a href={`/b/${PADDLE_CALENDAR_BLOCK}`}>BLOCK {PADDLE_CALENDAR_BLOCK}</a>
    </nav>

    <header class="hero">
      <p class="kicker">CH.CRT · COURT · REFERENCE · AS OF SEP 21, 2026</p>
      <h1>Every paddle of 2026, on one calendar.</h1>
      <p class="dek">
        {S.releases} launches from {S.brands} brands, dated, priced and sourced. The rules, lawsuits and
        signings that shaped them run alongside. Then the company files, ten trends, and a forecast
        through next spring that says what each call rests on.
      </p>
      <p class="jump">
        <a href="#year">the year</a><a href="#prices">prices</a><a href="#ledger">the ledger</a><a href="#ahead">what's next</a><a href="#trends">trends</a><a href="#moves">signings</a><a href="#companies">company files</a><a href="#method">method</a>
      </p>
    </header>

    <section class="stats" aria-label="The year in four numbers">
      <div><strong>{S.releases}</strong><span>releases tracked · {S.brands} brands</span></div>
      <div><strong>{S.foam} of {S.releases}</strong><span>are full-foam builds</span></div>
      <div><strong>${S.medianUsd}</strong><span>median list price at launch</span></div>
      <div class="next"><strong id="next-drop">Sep 30</strong><span id="next-drop-note">next drop · JOOLA POWER FX</span></div>
    </section>

    <section id="year" class="sec" aria-label="The year at a glance">
      <div class="sec__head">
        <p class="kicker">THE YEAR AT A GLANCE</p>
        <ul class="legend" aria-label="Build type">
          {builds.map((b) => (<li><i style={`background:${BUILDS[b].color}`}></i>{BUILDS[b].label}</li>))}
        </ul>
      </div>
      <div class="year">
        {year.map((mo) => (
          <div class:list={['mo', { 'mo--now': mo.key === '2026-09', 'mo--future': mo.key > '2026-09' }]}>
            <div class="mo__name">
              <b>{mo.m}</b>
              <span class="mo__bar" aria-hidden="true"><i style={`width:${(mo.releases.length / busiest) * 100}%`}></i></span>
              <small>{mo.releases.length || '·'}</small>
            </div>
            <div class="mo__chips">
              {mo.releases.map((r) => (
                <a class:list={['chip', { 'chip--soon': r.status === 'upcoming' }]} href={`#${r.id}`} style={`--b:${BUILDS[r.build as Build].color}`} title={`${r.dateLabel} · ${priceLabel(r)}`}>{chip(r)}</a>
              ))}
              {mo.wires.map((a) => (<span class="chip chip--wire">{kindMark[a.kind]} · {a.title}</span>))}
              {mo.ahead.map((a) => (<span class="chip chip--ahead">{a.dateLabel} · {a.title}</span>))}
            </div>
          </div>
        ))}
      </div>
      <p class="note">
        March was the peak: seven launches in four weeks. July was the quietest month. August and
        September filled back up ahead of the October 1 spin-test deadline, and two more dated drops
        land in the next ten days.
      </p>
    </section>

    <section id="prices" class="sec" aria-label="Launch price by date">
      <div class="sec__head">
        <p class="kicker">THE PRICE LADDER · LIST PRICE AT LAUNCH, BY DATE</p>
        <ul class="legend" aria-label="Build type">
          {builds.map((b) => (<li><i style={`background:${BUILDS[b].color}`}></i>{BUILDS[b].short}</li>))}
        </ul>
      </div>
      <figure class="ladder">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Scatter of ${dots.length} paddle releases by launch date and list price. Prices run from $99 to $329.95, with clusters at $100 to $120, around $200, and $250 to $300.`}>
          <rect x={L} y={y(PADDLE_FUND_CAP_USD)} width={W - L - R} height={y(yMin) - y(PADDLE_FUND_CAP_USD)} class="ladder__fund" />
          {[100, 200, 300].map((usd) => (
            <g>
              <line x1={L} x2={W - R} y1={y(usd)} y2={y(usd)} class="ladder__grid" />
              <text x={L - 10} y={y(usd) + 4} text-anchor="end" class="ladder__tick">${usd}</text>
            </g>
          ))}
          {MONTHS.map((m, i) => (
            <text x={x(`2026-${String(i + 1).padStart(2, '0')}-15`)} y={H - 14} text-anchor="middle" class="ladder__tick">{m}</text>
          ))}
          <line x1={x(meta.asOf)} x2={x(meta.asOf)} y1={T} y2={H - B} class="ladder__now" />
          <text x={x(meta.asOf) + 6} y={T + 10} class="ladder__tick">today</text>
          <text x={L + 8} y={y(yMin) - 8} class="ladder__tick">shaded: under the Paddle Fund's $200</text>
          {dots.map((r) => (
            <a href={`#${r.id}`} class="dot" data-tip={`${r.brand} ${r.model}|${priceLabel(r)} · ${r.dateLabel}|${BUILDS[r.build as Build].label}`}>
              <circle cx={x(r.date)} cy={y(r.msrp as number)} r="16" fill="transparent" />
              <circle cx={x(r.date)} cy={y(r.msrp as number)} r="6.5" fill={r.status === 'upcoming' ? '#fff' : BUILDS[r.build as Build].color} stroke={r.status === 'upcoming' ? BUILDS[r.build as Build].color : '#fff'} stroke-width="2" />
            </a>
          ))}
          {dots.filter((r) => labelled.has(r.id)).map((r) => (
            <text x={x(r.date) + 11} y={y(r.msrp as number) + 4} class="ladder__label">{chip(r)} {priceLabel(r).split(' ')[0]}</text>
          ))}
        </svg>
        <div class="tip" id="ladder-tip" hidden></div>
        <figcaption>
          Each dot is a release; hollow dots have not shipped yet. Multi-model launches plot at their
          headline price. The shaded band is what one turn in <a href="/paddle-fund">the Paddle Fund</a> buys:
          {S.underFundCap} of this year's {S.releases} releases fit under $200. Every dot is a row in the ledger below.
        </figcaption>
      </figure>
    </section>

    <section id="ledger" class="sec" aria-label="The ledger, month by month">
      <p class="kicker">THE LEDGER · MONTH BY MONTH</p>
      <form class="filters" id="filters" aria-label="Filter the ledger">
        <label>Brand
          <select name="brand">
            <option value="">All {S.brands}</option>
            {brands.map((b) => (<option value={b}>{b}</option>))}
          </select>
        </label>
        <label>Build
          <select name="build">
            <option value="">Any</option>
            {builds.map((b) => (<option value={b}>{BUILDS[b].label}</option>))}
          </select>
        </label>
        <label>Price
          <select name="tier">
            <option value="">Any</option>
            <option value="floor">Floor · $120 and under</option>
            <option value="middle">Middle · $121 – $229</option>
            <option value="top">Top · $230 and up</option>
          </select>
        </label>
        <label class="check"><input type="checkbox" name="fund" /> Under $200</label>
        <label class="check"><input type="checkbox" name="wire" checked /> Show the news</label>
        <output id="filter-count" aria-live="polite">{S.releases} releases</output>
      </form>

      {ledger.map((mo) => (
        <div class="month" data-month>
          <h2 class="month__name">{mo.label}<small data-month-count>{mo.rows.filter((row) => row.kind === 'release').length || ''}</small></h2>
          {mo.rows.map((row) => row.kind === 'wire' ? (
            <article class="wire" data-wire>
              <p class="wire__date">{mo.key === 'before' ? `${shortDate(row.a.date)}, ${row.a.date.slice(0, 4)}` : shortDate(row.a.date)}<b>{kindMark[row.a.kind]}</b></p>
              <div>
                <h3>{row.a.title}</h3>
                <p>{row.a.body} <a href={row.a.source} rel="noopener">{hostOf(row.a.source)} ↗</a></p>
              </div>
            </article>
          ) : (
            <article
              class:list={['rel', { 'rel--soon': row.r.status === 'upcoming' }]}
              id={row.r.id}
              data-release
              data-brand={row.r.brand}
              data-build={row.r.build}
              data-tier={tierOf(row.r.msrp)}
              data-fund={row.r.msrp != null && row.r.msrp <= PADDLE_FUND_CAP_USD ? '1' : '0'}
              style={`--b:${BUILDS[row.r.build as Build].color}`}
            >
              <p class="rel__date">{row.r.dateLabel}<b>{priceLabel(row.r)}</b></p>
              <div class="rel__body">
                <h3><span>{row.r.brand}</span> {row.r.model}</h3>
                <p class="rel__meta">
                  {[row.r.thickness, row.r.shapes, row.r.pro && `Pro: ${row.r.pro}`].filter(Boolean).join('  ·  ')}
                </p>
                <p class="rel__take">{row.r.take}</p>
                <p class="rel__tech"><b>Build.</b> {row.r.tech}{row.r.specs && (<> <b>Measured.</b> {row.r.specs}.</>)}{row.r.certNote && (<> <b>Cert.</b> {row.r.certNote}</>)}</p>
                <p class="rel__tags">
                  <span class="tag tag--build">{BUILDS[row.r.build as Build].short}</span>
                  {row.r.status === 'upcoming' && <span class="tag tag--soon">NOT OUT YET</span>}
                  {row.r.status === 'limited' && <span class="tag">LIMITED RUN</span>}
                  {certBadges(row.r).map((c) => (<span class="tag">{c}</span>))}
                  <span class={`tag tag--conf tag--${row.r.confidence}`}>{row.r.confidence.toUpperCase()} CONFIDENCE · DATE TO THE {row.r.precision.toUpperCase()}</span>
                  {row.r.sources.map((s) => (<a href={s} rel="noopener">{hostOf(s)} ↗</a>))}
                </p>
              </div>
            </article>
          ))}
        </div>
      ))}
      <p class="empty" id="filter-empty" hidden>Nothing on the calendar matches that. Loosen a filter.</p>

      <div class="shelf">
        <p class="kicker">ON SHELVES THIS YEAR, DATE NOT PINNED</p>
        <div class="rows">
          {undated.map((u) => (
            <a class="row row--link" href={u.source} rel="noopener"><strong>{u.brand} {u.model}</strong><span>{u.note}</span><b aria-hidden="true">↗</b></a>
          ))}
        </div>
      </div>
    </section>

    <section id="ahead" class="sec" aria-label="What is next">
      <p class="kicker">WHAT'S NEXT · THE ROAD TO SPRING 2027</p>
      <h2 class="h2">Two dated drops, one rule change, and a lot of names on approval lists.</h2>
      <div class="road">
        {ahead.map((a) => (
          <div class:list={['road__row', `road__row--${a.kind}`]} data-ahead={a.date} data-ahead-kind={a.kind} data-ahead-title={a.title}>
            <span class="road__date">{a.dateLabel}</span>
            <b>{kindMark[a.kind]}</b>
            <span><strong>{a.title}</strong>{a.body && <> — {a.body}</>}</span>
          </div>
        ))}
      </div>

      <p class="kicker kicker--gap">CERTIFIED, NOT YET LAUNCHED · NAMES ON THE APPROVAL LISTS</p>
      <div class="rows">
        {signals.map((s) => (
          <div class="row"><strong>{s.brand} {s.model}</strong><span>{s.signal}</span></div>
        ))}
      </div>
      <p class="note">An approval gives you the name, not the launch date or the reason to buy. Treat these as a watchlist.</p>

      <p class="kicker kicker--gap">THE FORECAST · EACH CALL SAYS WHAT IT RESTS ON</p>
      <div class="calls">
        {forecasts.map((f) => (
          <article class="call">
            <p class="call__when">{f.window}<b>{basisLabel[f.basis]}</b></p>
            <h3>{f.call}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="trends" class="sec" aria-label="Ten trends">
      <p class="kicker">TEN TRENDS · WHAT THE CALENDAR SAYS WHEN YOU READ IT WHOLE</p>
      <div class="trends">
        {trends.map((t) => (
          <article class="trend">
            <p class="trend__n">{t.n}</p>
            <div>
              <h3>{t.title}</h3>
              <p>{t.body} <a href={t.source} rel="noopener">{hostOf(t.source)} ↗</a></p>
              {t.n === '02' && (
                <figure class="grit">
                  {grit.rows.map((g) => (
                    <div class="grit__row">
                      <span>{g.surface}</span>
                      <span class="grit__track"><i class:list={[{ base: g.retained < 85 }]} style={`width:${g.retained}%`}></i></span>
                      <b>{g.retained}%</b>
                    </div>
                  ))}
                  <figcaption>{grit.note} <a href={grit.source} rel="noopener">{hostOf(grit.source)} ↗</a></figcaption>
                </figure>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="moves" class="sec" aria-label="Pro paddle signings">
      <p class="kicker">SIGNING SEASON · WHO CHANGED PADDLES IN 2026</p>
      <div class="rows rows--moves">
        {moves.map((m) => (
          <div class="row"><strong>{m.player}</strong><span>{m.from ? `${m.from} → ` : '→ '}<em>{m.to}</em>{m.note && ` · ${m.note}`}</span></div>
        ))}
      </div>
      <p class="note">Most paddle contracts end December 31. The next round of these lands in the first two weeks of January.</p>
    </section>

    <section id="companies" class="sec" aria-label="Company files">
      <p class="kicker">COMPANY FILES · {companies.length} BRANDS</p>
      <div class="cos">
        {companies.map((c) => {
          const theirs = RELEASES.filter((r) => r.brand === c.brand);
          return (
            <article class="co">
              <h3>{c.brand}</h3>
              <p class="co__facts">{[c.hq, c.founded && `est. ${c.founded}`, c.owner].filter(Boolean).join(' · ')}</p>
              <p class="co__story">{c.story}</p>
              <dl>
                {c.lines && (<><dt>Lines</dt><dd>{c.lines}</dd></>)}
                {c.pros && (<><dt>Pros</dt><dd>{c.pros}</dd></>)}
                {c.cadence && (<><dt>Cadence</dt><dd>{c.cadence}</dd></>)}
                {theirs.length > 0 && (<><dt>2026</dt><dd>{theirs.map((r, i) => (<>{i > 0 && ' · '}<a href={`#${r.id}`}>{r.model.split(/[:(]/)[0].trim()}</a></>))}</dd></>)}
              </dl>
            </article>
          );
        })}
      </div>
    </section>

    <section id="method" class="sec" aria-label="Method">
      <p class="kicker">METHOD · HOW TO READ THIS</p>
      <ol class="method">
        {method.map((line) => (<li>{line}</li>))}
      </ol>
      <p class="foot">
        <a href="/paddle-calendar.json">the whole calendar as JSON</a> · <a href={PADDLE_CALENDAR_RALLY_URL}>the same calendar on Rally ↗</a> · <a href="/paddle-fund">the Paddle Fund</a> · compiled {meta.asOf} · CC0
      </p>
    </section>
  </main>
</BlockLayout>

<script>
  // Filters: the ledger is server-rendered; this only hides rows.
  const form = document.getElementById('filters') as HTMLFormElement | null;
  if (form) {
    const releases = [...document.querySelectorAll<HTMLElement>('[data-release]')];
    const wires = [...document.querySelectorAll<HTMLElement>('[data-wire]')];
    const months = [...document.querySelectorAll<HTMLElement>('[data-month]')];
    const count = document.getElementById('filter-count')!;
    const empty = document.getElementById('filter-empty')!;
    const apply = () => {
      const f = new FormData(form);
      const brand = String(f.get('brand') || ''), build = String(f.get('build') || ''), tier = String(f.get('tier') || '');
      const fund = f.get('fund') === 'on', wire = f.get('wire') === 'on';
      const narrowed = Boolean(brand || build || tier || fund);
      let shown = 0;
      for (const el of releases) {
        const ok = (!brand || el.dataset.brand === brand) && (!build || el.dataset.build === build) && (!tier || el.dataset.tier === tier) && (!fund || el.dataset.fund === '1');
        el.hidden = !ok;
        if (ok) shown += 1;
      }
      for (const el of wires) el.hidden = !wire || narrowed;
      for (const mo of months) {
        const n = mo.querySelectorAll('[data-release]:not([hidden])').length;
        mo.hidden = n === 0 && mo.querySelectorAll('[data-wire]:not([hidden])').length === 0;
        const badge = mo.querySelector('[data-month-count]');
        if (badge) badge.textContent = n ? String(n) : '';
      }
      count.textContent = `${shown} release${shown === 1 ? '' : 's'}`;
      empty.hidden = shown !== 0;
    };
    form.addEventListener('input', apply);
    form.addEventListener('submit', (event) => event.preventDefault());
  }

  // Next drop: the first dated release still ahead of the reader's clock.
  const today = new Date().toISOString().slice(0, 10);
  const next = [...document.querySelectorAll<HTMLElement>('[data-ahead]')]
    .find((el) => el.dataset.aheadKind === 'release' && (el.dataset.ahead || '') >= today);
  const big = document.getElementById('next-drop'), small = document.getElementById('next-drop-note');
  if (big && small) {
    if (next) {
      const days = Math.round((Date.parse(next.dataset.ahead!) - Date.parse(today)) / 864e5);
      big.textContent = days === 0 ? 'Today' : `${days} day${days === 1 ? '' : 's'}`;
      small.textContent = `to the next dated drop · ${next.dataset.aheadTitle}`;
    } else {
      big.textContent = '—';
      small.textContent = 'no dated drop on the calendar right now';
    }
  }
  for (const el of document.querySelectorAll<HTMLElement>('[data-ahead]')) if ((el.dataset.ahead || '') < today) el.classList.add('is-past');

  // Price ladder tooltip.
  const tip = document.getElementById('ladder-tip');
  const ladder = tip?.parentElement;
  if (tip && ladder) {
    const show = (dot: Element) => {
      const [name, line, build] = (dot.getAttribute('data-tip') || '').split('|');
      tip.replaceChildren();
      for (const [tag, text] of [['strong', name], ['span', line], ['small', build]] as const) {
        const node = document.createElement(tag);
        node.textContent = text;
        tip.append(node);
      }
      const box = ladder.getBoundingClientRect(), at = dot.getBoundingClientRect();
      tip.hidden = false;
      const left = Math.min(Math.max(at.left - box.left + at.width / 2, 90), box.width - 90);
      tip.style.left = `${left}px`;
      tip.style.top = `${at.top - box.top}px`;
    };
    for (const dot of ladder.querySelectorAll('.dot')) {
      dot.addEventListener('pointerenter', () => show(dot));
      dot.addEventListener('focus', () => show(dot));
      dot.addEventListener('pointerleave', () => { tip.hidden = true; });
      dot.addEventListener('blur', () => { tip.hidden = true; });
    }
  }
</script>

