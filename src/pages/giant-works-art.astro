---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ART_FUNDING_NOTES, ART_TIER_D_PRINCIPLES, ART_WORKS, GWA_META, GWA_NOTES, REFERENCES } from '../lib/giantWorksArt';
const title = `${GWA_META.title} — ${GWA_META.subtitle}`;
const description = GWA_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/giant-works-art', name: GWA_META.title, description, url: 'https://pointcast.xyz/giant-works-art', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const catColor: Record<string, string> = { audio: '#b85a3a', light: '#d4a534', art: '#5b3d7a' };
const catSymbol: Record<string, string> = { audio: '◉', light: '☼', art: '✦' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/giant-works-art.json', title: 'Giant Works · Art (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/giant-works">giant-works</a><span aria-hidden="true">/</span><span>art</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{GWA_META.paperNumber} · TIER D · ART · 8 PROSPECTIVE WORKS</p>
      <h1>SOUND. / LIGHT. / ART.</h1>
      <p class="subtitle">{GWA_META.subtitle}</p>
      <p class="thesis">{GWA_META.thesis}</p>
      <p class="audience"><strong>Audience:</strong> {GWA_META.audience}</p>
    </header>

    <section class="prin"><p class="kicker">ART TIER D PRINCIPLES · 5</p><h2>Where art Tier D differs from element Tier D.</h2>
      <ol class="pr-list">{ART_TIER_D_PRINCIPLES.map((p, i) => (
        <li><span class="pr__n">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="overview"><p class="kicker">THE EIGHT ART WORKS · BY CATEGORY</p><h2>The catalog at a glance.</h2>
      <ol class="ov-list">{ART_WORKS.map((w, i) => (
        <li class={`ov ov--${w.category}`} style={`--cat-color: ${catColor[w.category]};`}>
          <a href={`#aw-${w.id}`}>
            <span class="ov__num">{String(i+1).padStart(2,'0')}</span>
            <span class="ov__el" aria-hidden="true">{catSymbol[w.category]}</span>
            <div class="ov__body">
              <h3>{w.title}</h3>
              <p class="ov__tag">{w.tagline}</p>
              <p class="ov__meta">{w.category.toUpperCase()} · {w.costBand}</p>
            </div>
          </a>
        </li>
      ))}</ol>
    </section>

    {ART_WORKS.map((w, i) => (
      <article id={`aw-${w.id}`} class={`work work--${w.category}`} style={`--cat-color: ${catColor[w.category]};`}>
        <p class="kicker">PROJECT {String(i+1).padStart(2,'0')} · {w.category.toUpperCase()} · {w.costBand}</p>
        <h2>{w.title}</h2>
        <p class="work__tag">{w.tagline}</p>

        <h3 class="wh">Program</h3>
        <p class="wp">{w.programDescription}</p>

        <h3 class="wh">Curatorial council</h3>
        <p class="wp">{w.curatorialCouncil}</p>

        <h3 class="wh">Site candidates · {w.siteCandidates.length}</h3>
        <ol class="sc-list">{w.siteCandidates.map((s) => (
          <li>
            <h4>{s.city} <span class="sc__site">— {s.site}</span></h4>
            <p>{s.rationale}</p>
          </li>
        ))}</ol>

        <h3 class="wh">Inspirations</h3>
        <ul class="ins-list">{w.inspirations.map((ins) => (<li>{ins}</li>))}</ul>

        <h3 class="wh">Trigger conditions · {w.triggerConditions.length}</h3>
        <ol class="tg-list">{w.triggerConditions.map((t) => (<li>{t}</li>))}</ol>

        <h3 class="wh">Funding path</h3>
        <p class="wp">{w.fundingPath}</p>

        <h3 class="wh">Governance</h3>
        <p class="wp">{w.governance}</p>

        <h3 class="wh">Horizons</h3>
        <ol class="hz-list">{w.horizons.map((h) => (
          <li><span class="hz__y">{h.year}</span><span>{h.milestone}</span></li>
        ))}</ol>

        <h3 class="wh">Parallel to the cases</h3>
        <p class="parallel">{w.precedentToCases}</p>
      </article>
    ))}

    <section class="fund"><p class="kicker">ART FUNDING NOTES</p><h2>The 16-work federation queue.</h2>
      <p class="fn"><strong>Total scope:</strong> {ART_FUNDING_NOTES.totalScope}</p>
      <p class="fn"><strong>Matching philanthropy:</strong> {ART_FUNDING_NOTES.matchingPhilanthropy}</p>
      <p class="fn"><strong>Distribution:</strong> {ART_FUNDING_NOTES.laBalanced}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · CURATORS · ARTISTS · STEWARDS</p>
      <p>{GWA_NOTES.uesNote}</p>
      <p class="invite-cta">{GWA_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/giant-works">Giant Works · element Tier D</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/corridor-strengths">Corridor Strengths</a>
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/torrance">Torrance</a>
      <a href="/giant-works-art.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --gwa-ink:#1a1a1a; --gwa-paper:#fdf9ee; --gwa-mustard:#d4a534; --gwa-rust:#b85a3a; --gwa-sage:#2d6a3d; --gwa-violet:#5b3d7a; --gwa-fog:#d8d2c4; --gwa-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--gwa-paper); color: var(--gwa-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--gwa-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--gwa-violet); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--gwa-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--gwa-violet); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 86px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0 0 12px; }
  .audience { font-size: 13.5px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--gwa-violet); max-width: 72ch; }
  .audience strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--gwa-violet); margin-right: 4px; }

  section, article { padding: 28px; border-top: 4px solid var(--gwa-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .prin { background: linear-gradient(135deg, #fff, var(--gwa-paper)); }
  .pr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .pr-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--gwa-ink); border-left: 6px solid var(--gwa-mustard); align-items: baseline; }
  .pr__n { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--gwa-violet); }
  .pr-list p { margin: 0; font-size: 13.5px; line-height: 1.55; }

  .ov-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .ov a { display: grid; grid-template-columns: 50px 50px 1fr; gap: 12px; padding: 14px; background: #fff; border: 2px solid var(--gwa-ink); border-left: 8px solid var(--cat-color, var(--gwa-violet)); text-decoration: none; color: var(--gwa-ink); align-items: start; }
  .ov a:hover { background: var(--gwa-paper); }
  .ov__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--cat-color); }
  .ov__el { font-size: 30px; line-height: 1; color: var(--cat-color); }
  .ov__body h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 4px; font-weight: 700; }
  .ov__tag { font-size: 12.5px; line-height: 1.45; margin: 0 0 6px; }
  .ov__meta { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; color: var(--gwa-slate); margin: 0; }

  .work { background: linear-gradient(180deg, var(--gwa-paper), #fff); border-top-color: var(--cat-color, var(--gwa-violet)); }
  .work .kicker { background: var(--cat-color); }
  .work__tag { font-size: 16px; line-height: 1.5; font-weight: 500; max-width: 70ch; margin: 0 0 18px; padding: 12px 14px; background: #fff; border-left: 5px solid var(--cat-color); }
  .wh { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--cat-color); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--cat-color); }
  .wp { font-size: 13.5px; line-height: 1.6; margin: 0 0 12px; max-width: 72ch; }
  .parallel { font-size: 13.5px; line-height: 1.6; padding: 12px 14px; background: var(--gwa-paper); border-left: 4px solid var(--cat-color); margin: 0; max-width: 72ch; }

  .sc-list, .tg-list, .hz-list, .ins-list { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; }
  .ins-list { padding-left: 22px; list-style: square; gap: 4px; }
  .ins-list li { font-size: 13px; line-height: 1.5; }
  .sc-list li { padding: 10px 12px; background: #fff; border: 2px solid var(--gwa-ink); border-left: 5px solid var(--cat-color); }
  .sc-list h4 { font-family: var(--pc-font-mono); font-size: 12.5px; margin: 0 0 4px; font-weight: 700; }
  .sc__site { color: var(--cat-color); font-weight: 500; }
  .sc-list p { margin: 0; font-size: 12.5px; line-height: 1.5; }
  .tg-list { list-style: decimal; padding-left: 22px; }
  .tg-list li { font-size: 13px; line-height: 1.5; padding: 4px 0; }
  .hz-list li { display: grid; grid-template-columns: 100px 1fr; gap: 12px; padding: 8px 10px; background: #fff; border-left: 4px solid var(--cat-color); align-items: baseline; font-size: 13px; }
  .hz__y { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--cat-color); letter-spacing: .1em; }

  .fund { background: var(--gwa-paper); }
  .fn { padding: 12px 14px; background: #fff; border-left: 4px solid var(--gwa-violet); font-size: 13.5px; line-height: 1.55; margin: 0 0 8px; max-width: 72ch; }
  .fn strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--gwa-violet); margin-right: 4px; }

  .invitation { background: var(--gwa-violet); color: var(--gwa-paper); border-top-color: var(--gwa-violet); }
  .invitation .kicker { background: var(--gwa-mustard); color: var(--gwa-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--gwa-mustard); color: var(--gwa-ink); border-left: 4px solid var(--gwa-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--gwa-violet); color: var(--gwa-paper); text-decoration: none; }
  .links a:hover { background: var(--gwa-rust); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .ov-list { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .hz-list li { grid-template-columns: 1fr; } .pr-list li { grid-template-columns: 1fr; } }
</style>
