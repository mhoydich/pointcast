---
/**
 * /shrine-bird — a bird visits the shrine today.
 *
 * Bird-appreciation surface in the shrine register. The day's Noun
 * (deterministic from the date, seed in [0, 1199]) is the bird in
 * residence. A painterly forest background (Manus-delivered, gradient
 * placeholder until then). Sophisticated, Apple-quality card with the
 * Noun perched at center. Bird-call audio: short procedural chirps in
 * clusters of 2-4, every 6-12 seconds, in pentatonic intervals taken
 * from NounBells' scale so they sit musically with the rest of the
 * /drum-* + /melody-* family.
 *
 * Visitors can "leave a feather" — a single chirp + soft visual halo,
 * count persists in localStorage. Bird name is procedurally derived
 * from the Noun seed (adjective + bird family) — same noun, same name
 * everywhere, every time.
 *
 * Uses noun.pics/{seed}.svg for art per the established convention
 * (NounsPortraitStrip.astro, MintButton flow, Visit Nouns FA2).
 *
 * Distinct from /shrine-water: water is elemental, bird is companion.
 * The bird is a visitor too — the shrine notices.
 *
 * Shipped 2026-05-16. Second shrine. Bird appreciation register opens.
 * — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Shrine of Birds — a bird visits today"
  description="The day's Noun is the bird in residence. A short bird-call ambient soundscape. Leave a feather offering — your visits accumulate locally. The shrine register's bird-appreciation surface, using real Visit Nouns artwork."
  image="/images/og-drum.png"
>
  <main class="shb" id="shb" data-built={built}>
    <!-- Backdrop: painterly forest canopy (placeholder until Manus delivers) -->
    <div class="shb__backdrop" id="shb-backdrop" aria-hidden="true"></div>

    <!-- The card -->
    <article class="shb__card" id="shb-card">
      <header class="shb__head">
        <p class="shb__kicker" id="shb-kicker">SHRINE · BIRDS · TODAY'S VISITOR</p>
        <h1 class="shb__title" id="shb-title">A bird visits the shrine today.</h1>
        <p class="shb__sub">A Noun perches at the shrine for one day. Each calendar date selects the same bird for every visitor — you and a friend who arrives the same Tuesday see the same one. Leave a feather if it moves you.</p>
      </header>

      <!-- The bird (the day's Noun) -->
      <div class="shb__perch">
        <div class="shb__perch-frame">
          <img class="shb__noun" id="shb-noun" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="shb__bird-meta">
          <p class="shb__bird-name" id="shb-bird-name">Quiet Warbler</p>
          <p class="shb__bird-id" id="shb-bird-id">Noun #0 · C3</p>
        </div>
      </div>

      <!-- Interaction -->
      <div class="shb__action">
        <button class="shb__feather" id="shb-feather" type="button" aria-label="Leave a feather">
          <span class="shb__feather-glyph">🪶</span>
          <span class="shb__feather-label">leave a feather</span>
        </button>
        <div class="shb__feather-halo" id="shb-halo" aria-hidden="true"></div>
      </div>

      <!-- Date nav + count -->
      <footer class="shb__foot">
        <div class="shb__nav">
          <button class="shb__nav-btn" id="shb-prev" type="button" aria-label="Previous day">←</button>
          <span class="shb__date" id="shb-date">May 16</span>
          <button class="shb__nav-btn" id="shb-next" type="button" aria-label="Next day">→</button>
        </div>
        <p class="shb__count" id="shb-count">your first visit</p>
        <p class="shb__links">
          <a href="/shrine-water">↗ /shrine-water</a>
          <span class="shb__dot">·</span>
          <a href="/aviary">↗ /aviary</a>
          <span class="shb__dot">·</span>
          <a href="/music-hub">↗ /music-hub</a>
        </p>
      </footer>
    </article>
  </main>

  <style is:global>
    :root {
      --shb-ink: #050810;
      --shb-deep: #0c1820;
      --shb-canopy-1: #1a3024;
      --shb-canopy-2: #284838;
      --shb-mist: #b8d0c8;
      --shb-cream: #f4ede0;
      --shb-cream-dim: rgba(244, 237, 224, 0.65);
      --shb-cream-dimmer: rgba(244, 237, 224, 0.36);
      --shb-accent: #d8b878;
      --shb-card-bg: rgba(10, 18, 14, 0.42);
      --shb-card-border: rgba(244, 237, 224, 0.13);
    }

    html, body {
      background: var(--shb-ink);
      margin: 0; padding: 0; height: 100%;
    }
    body:has(.shb) {
      color: var(--shb-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .shb {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* BACKDROP — forest canopy placeholder */
    .shb__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 35% 20%, rgba(216, 184, 120, 0.18) 0%, transparent 50%),
        radial-gradient(ellipse at 75% 70%, rgba(40, 72, 56, 0.55) 0%, transparent 60%),
        linear-gradient(180deg, #0c1820 0%, #1c3428 50%, #284838 100%);
      animation: shbBackdrop 32s ease-in-out infinite alternate;
    }
    @keyframes shbBackdrop {
      0%   { filter: brightness(1.0); }
      100% { filter: brightness(0.93); }
    }
    .shb__backdrop--image {
      background-image: url('/images/shrines/shrine-bird.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    .shb__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(5, 8, 16, 0.50) 95%);
      pointer-events: none;
    }

    /* CARD */
    .shb__card {
      position: relative;
      z-index: 1;
      max-width: 480px;
      width: 100%;
      padding: 32px 32px 24px;
      background: var(--shb-card-bg);
      border: 1px solid var(--shb-card-border);
      border-radius: 28px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.45),
        0 8px 24px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: shbCardEnter 1.6s cubic-bezier(0.16, 0.84, 0.30, 1.00) both;
    }
    @keyframes shbCardEnter {
      0%   { opacity: 0; transform: translateY(28px) scale(0.96); filter: blur(8px); }
      50%  { opacity: 0.9; filter: blur(2px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* HEAD */
    .shb__head { margin-bottom: 22px; }
    .shb__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--shb-cream-dim);
      text-transform: uppercase;
      margin: 0 0 14px;
      font-weight: 500;
    }
    .shb__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: clamp(28px, 4vw, 36px);
      letter-spacing: -0.020em;
      line-height: 1.12;
      margin: 0 0 12px;
      color: var(--shb-cream);
    }
    .shb__sub {
      font-size: 14px;
      line-height: 1.55;
      color: var(--shb-cream-dim);
      margin: 0;
      font-weight: 400;
    }

    /* PERCH — the Noun lives here */
    .shb__perch {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      margin: 0 0 22px;
    }
    .shb__perch-frame {
      position: relative;
      width: 180px;
      height: 180px;
      border-radius: 18px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.25);
      box-shadow:
        inset 0 1px 0 rgba(244, 237, 224, 0.10),
        0 18px 38px rgba(0, 0, 0, 0.45);
    }
    .shb__perch-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      box-shadow: inset 0 -30px 50px rgba(0, 0, 0, 0.25);
      pointer-events: none;
    }
    .shb__noun {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      image-rendering: pixelated;
      animation: shbNounEnter 1.8s cubic-bezier(0.16, 0.84, 0.30, 1.00) both 0.4s;
    }
    @keyframes shbNounEnter {
      0%   { opacity: 0; transform: scale(0.94); }
      100% { opacity: 1; transform: scale(1); }
    }
    .shb__bird-meta {
      text-align: center;
    }
    .shb__bird-name {
      font-family: 'New York', Georgia, serif;
      font-weight: 500;
      font-size: 20px;
      letter-spacing: -0.015em;
      color: var(--shb-cream);
      margin: 0 0 4px;
    }
    .shb__bird-id {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--shb-cream-dimmer);
      text-transform: uppercase;
      margin: 0;
    }

    /* ACTION — feather */
    .shb__action {
      position: relative;
      display: flex;
      justify-content: center;
      margin-bottom: 22px;
    }
    .shb__feather {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 22px;
      background: rgba(216, 184, 120, 0.10);
      border: 1px solid rgba(216, 184, 120, 0.32);
      border-radius: 999px;
      color: var(--shb-accent);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1),
                  background 200ms ease,
                  border-color 200ms ease;
    }
    .shb__feather:hover {
      background: rgba(216, 184, 120, 0.18);
      border-color: rgba(216, 184, 120, 0.55);
      transform: translateY(-1px);
    }
    .shb__feather:active { transform: translateY(0) scale(0.97); transition-duration: 80ms; }
    .shb__feather-glyph {
      font-size: 16px;
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .shb__feather:hover .shb__feather-glyph { transform: rotate(-12deg); }
    .shb__feather--given .shb__feather-glyph {
      animation: shbFeatherDrop 1.1s cubic-bezier(0.25, 0.6, 0.30, 1);
    }
    @keyframes shbFeatherDrop {
      0%   { transform: rotate(0deg) translateY(0); }
      30%  { transform: rotate(-22deg) translateY(2px); }
      60%  { transform: rotate(18deg) translateY(6px); }
      100% { transform: rotate(0deg) translateY(0); }
    }
    .shb__feather-halo {
      position: absolute;
      left: 50%; top: 50%;
      width: 60px; height: 60px;
      transform: translate(-50%, -50%) scale(0);
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
    }
    .shb__feather-halo--active {
      animation: shbHalo 1.4s cubic-bezier(0.25, 0.6, 0.30, 1) forwards;
    }
    @keyframes shbHalo {
      0%   { transform: translate(-50%, -50%) scale(0); background: rgba(216, 184, 120, 0.35); }
      60%  { background: rgba(216, 184, 120, 0.15); }
      100% { transform: translate(-50%, -50%) scale(8); background: rgba(216, 184, 120, 0); }
    }

    /* FOOTER */
    .shb__foot { text-align: center; }
    .shb__nav {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .shb__nav-btn {
      width: 28px; height: 28px;
      border: 1px solid rgba(244, 237, 224, 0.12);
      background: rgba(244, 237, 224, 0.04);
      color: var(--shb-cream-dim);
      border-radius: 6px;
      cursor: pointer;
      font-family: inherit;
      font-size: 14px;
      transition: background 150ms ease, color 150ms ease;
    }
    .shb__nav-btn:hover {
      background: rgba(244, 237, 224, 0.10);
      color: var(--shb-cream);
    }
    .shb__date {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.10em;
      color: var(--shb-cream-dim);
      min-width: 70px;
      text-align: center;
    }
    .shb__count {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 13px;
      color: var(--shb-cream-dim);
      margin: 0 0 10px;
      letter-spacing: 0.01em;
      min-height: 1.4em;
    }
    .shb__count strong { color: var(--shb-accent); font-weight: 600; font-style: normal; }
    .shb__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--shb-cream-dimmer);
      margin: 0;
    }
    .shb__links a {
      color: var(--shb-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .shb__links a:hover { color: var(--shb-cream); }
    .shb__dot { display: inline-block; margin: 0 6px; opacity: 0.4; }

    @media (max-width: 480px) {
      .shb__card { padding: 24px 22px 20px; border-radius: 22px; }
      .shb__perch-frame { width: 150px; height: 150px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .shb__card, .shb__backdrop, .shb__noun { animation: none; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // Pentatonic scale from NounBells — keeps bird chirps consonant
    // with the rest of the music suite.
    const SCALE = [
      130.81, 146.83, 164.81, 196.00, 220.00,  // C3..A3
      261.63, 293.66, 329.63, 392.00, 440.00,  // C4..A4
      523.25, 587.33, 659.25, 783.99, 880.00,  // C5..A5
      1046.5,                                   // C6
    ];
    const NOTE_NAMES = [
      'C3', 'D3', 'E3', 'G3', 'A3',
      'C4', 'D4', 'E4', 'G4', 'A4',
      'C5', 'D5', 'E5', 'G5', 'A5',
      'C6',
    ];

    // Bird-name dictionary: adjective + family. 16 × 16 = 256 names,
    // covers a year+ of unique daily birds before repeats.
    const ADJ = [
      'Quiet', 'Bright', 'Golden', 'Mossy', 'Cobalt', 'Cinder', 'Hollow', 'Velvet',
      'Marsh', 'Linen', 'Pewter', 'Saffron', 'Twilight', 'Driftwood', 'Slate', 'Glass',
    ];
    const FAMILY = [
      'Warbler', 'Wren', 'Thrush', 'Finch', 'Jay', 'Sparrow', 'Tanager', 'Bunting',
      'Vireo', 'Pipit', 'Lark', 'Robin', 'Nuthatch', 'Bluebird', 'Catbird', 'Oriole',
    ];

    const NOUN_COUNT = 1200;

    // ---- date helpers ----
    function fmtDate(d: Date): string {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${dd}`;
    }
    function parseDate(s: string): Date | null {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
      if (!m) return null;
      const d = new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10));
      if (isNaN(d.getTime())) return null;
      return d;
    }
    function shortDate(d: Date): string {
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function hash32(str: string): number {
      let h = 2166136261;
      for (let i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }

    function nounForDate(dateStr: string): { seed: number; freq: number; note: string; name: string } {
      const h = hash32('shrine-bird:' + dateStr);
      const seed = h % NOUN_COUNT;
      // Note picked from a separate hash so it varies independently from the seed
      const noteIdx = (h >> 16) % SCALE.length;
      const freq = SCALE[noteIdx];
      const note = NOTE_NAMES[noteIdx];
      // Name from a third slice
      const adjIdx = (h >> 4) % ADJ.length;
      const famIdx = (h >> 8) % FAMILY.length;
      const name = `${ADJ[adjIdx]} ${FAMILY[famIdx]}`;
      return { seed, freq, note, name };
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let ambientTimer: number | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.30;
      masterGain.connect(ctx.destination);
      // Small reverb (1.4s) for forest depth
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 1.4);
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.8);
        }
      }
      convolver.buffer = ir;
      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.65;
      wetGain.gain.value = 0.40;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }
    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    // Single chirp — rising-falling sine sweep
    function playChirp(baseFreq: number, gain: number = 0.30) {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const dur = 0.08 + Math.random() * 0.06;
      const detune = 0.92 + Math.random() * 0.16;  // ±8% pitch variation per chirp
      const f = baseFreq * detune;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(f * 0.82, t);
      osc.frequency.exponentialRampToValueAtTime(f * 1.18, t + dur * 0.45);
      osc.frequency.exponentialRampToValueAtTime(f * 0.94, t + dur);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(gain, t + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(g);
      connectVoice(g);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + dur + 0.04);
    }

    // Cluster of 2-4 chirps, naturalistic timing
    function playCluster(baseFreq: number, gain: number = 0.28) {
      const count = 2 + Math.floor(Math.random() * 3);  // 2..4
      for (let i = 0; i < count; i++) {
        const delay = i * (80 + Math.random() * 90);
        setTimeout(() => playChirp(baseFreq, gain), delay);
      }
    }

    function startAmbient(freq: number) {
      if (ambientTimer != null) return;
      const tick = () => {
        playCluster(freq);
        ambientTimer = window.setTimeout(tick, 6000 + Math.random() * 6000);
      };
      ambientTimer = window.setTimeout(tick, 1800 + Math.random() * 2200);
    }
    function stopAmbient() {
      if (ambientTimer != null) { clearTimeout(ambientTimer); ambientTimer = null; }
    }
    function restartAmbient(freq: number) {
      stopAmbient();
      if (ctx) startAmbient(freq);
    }

    // ---- state ----
    const STORAGE_KEY = 'pc:shrine-bird:v1';
    interface State {
      feathers: number;
      firstVisit: number;
      lastVisit: number;
      // Optional: bird seeds you've seen — useful for an "aviary" reflection later
      seenSeeds: number[];
    }
    function loadState(): State {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          if (p && typeof p.feathers === 'number') {
            return {
              feathers: p.feathers,
              firstVisit: p.firstVisit || Date.now(),
              lastVisit: p.lastVisit || Date.now(),
              seenSeeds: Array.isArray(p.seenSeeds) ? p.seenSeeds : [],
            };
          }
        }
      } catch { /* ignore */ }
      return { feathers: 0, firstVisit: Date.now(), lastVisit: Date.now(), seenSeeds: [] };
    }
    function saveState(s: State) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch { /* ignore */ }
    }

    function timeAgo(t: number): string {
      const diff = Math.max(0, Date.now() - t);
      const s = Math.floor(diff / 1000);
      if (s < 60) return 'just now';
      const m = Math.floor(s / 60);
      if (m < 60) return `${m} minute${m === 1 ? '' : 's'} ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h} hour${h === 1 ? '' : 's'} ago`;
      const d = Math.floor(h / 24);
      if (d < 30) return `${d} day${d === 1 ? '' : 's'} ago`;
      const mo = Math.floor(d / 30);
      return `${mo} month${mo === 1 ? '' : 's'} ago`;
    }

    function refreshCount(s: State, uniqueBirds: number) {
      const el = document.getElementById('shb-count')!;
      if (s.feathers === 0 && uniqueBirds <= 1) {
        el.innerHTML = 'your first visit';
      } else if (s.feathers === 0) {
        el.innerHTML = `you've seen <strong>${uniqueBirds}</strong> bird${uniqueBirds === 1 ? '' : 's'} · last visit ${timeAgo(s.lastVisit)}`;
      } else if (s.feathers === 1) {
        el.innerHTML = `you've left <strong>1</strong> feather across <strong>${uniqueBirds}</strong> bird${uniqueBirds === 1 ? '' : 's'}`;
      } else {
        el.innerHTML = `you've left <strong>${s.feathers}</strong> feathers across <strong>${uniqueBirds}</strong> birds`;
      }
    }

    // ---- render ----
    let currentDate: Date = new Date();
    let currentBird = nounForDate(fmtDate(currentDate));

    function renderBird() {
      const bird = nounForDate(fmtDate(currentDate));
      currentBird = bird;
      const img = document.getElementById('shb-noun') as HTMLImageElement;
      img.src = `https://noun.pics/${bird.seed}.svg`;
      img.alt = `${bird.name} — Noun #${bird.seed}, voiced ${bird.note}`;
      document.getElementById('shb-bird-name')!.textContent = bird.name;
      document.getElementById('shb-bird-id')!.textContent = `Noun #${bird.seed} · ${bird.note}`;
      document.getElementById('shb-date')!.textContent = shortDate(currentDate);
      // Title varies subtly based on today vs other dates
      const todayStr = fmtDate(new Date());
      const isToday = fmtDate(currentDate) === todayStr;
      document.getElementById('shb-title')!.textContent = isToday
        ? 'A bird visits the shrine today.'
        : `${bird.name} visited on ${currentDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}.`;
      // Kicker also reflects day-vs-history
      document.getElementById('shb-kicker')!.textContent = isToday
        ? "SHRINE · BIRDS · TODAY'S VISITOR"
        : `SHRINE · BIRDS · ARCHIVE`;
    }

    function loadDate(d: Date, updateUrl: boolean = true) {
      currentDate = d;
      renderBird();
      if (updateUrl) {
        try {
          const u = new URL(location.href);
          const todayStr = fmtDate(new Date());
          if (fmtDate(d) === todayStr) u.searchParams.delete('d');
          else u.searchParams.set('d', fmtDate(d));
          history.replaceState({}, '', u.toString());
        } catch { /* ignore */ }
      }
      // Restart ambient with the new bird's frequency
      restartAmbient(currentBird.freq);
    }

    // ---- interaction ----
    function leaveFeather(s: State) {
      ensureCtx();
      // Single high-quality chirp for the offering
      playChirp(currentBird.freq, 0.42);
      // Visual halo
      const halo = document.getElementById('shb-halo')!;
      halo.classList.remove('shb__feather-halo--active');
      // Force reflow so animation restarts
      void halo.offsetWidth;
      halo.classList.add('shb__feather-halo--active');
      // Feather glyph wiggle
      const btn = document.getElementById('shb-feather')!;
      btn.classList.remove('shb__feather--given');
      void btn.offsetWidth;
      btn.classList.add('shb__feather--given');
      // State
      s.feathers += 1;
      s.lastVisit = Date.now();
      // Track the seed we just offered to
      if (!s.seenSeeds.includes(currentBird.seed)) s.seenSeeds.push(currentBird.seed);
      saveState(s);
      refreshCount(s, s.seenSeeds.length);
    }

    function init() {
      // Initial date from ?d= if present
      const params = new URLSearchParams(location.search);
      const dParam = params.get('d') || '';
      const initial = dParam ? parseDate(dParam) : null;
      currentDate = initial || new Date();
      renderBird();

      const state = loadState();
      state.lastVisit = Date.now();
      // Record today's bird in seen if not present (visit counts as a sighting)
      if (!state.seenSeeds.includes(currentBird.seed)) state.seenSeeds.push(currentBird.seed);
      saveState(state);
      refreshCount(state, state.seenSeeds.length);

      // Feather offering
      document.getElementById('shb-feather')!.addEventListener('click', () => leaveFeather(state));

      // Date nav
      document.getElementById('shb-prev')!.addEventListener('click', () => {
        const d = new Date(currentDate);
        d.setDate(d.getDate() - 1);
        loadDate(d);
        // Sighting from this nav
        if (!state.seenSeeds.includes(currentBird.seed)) state.seenSeeds.push(currentBird.seed);
        saveState(state);
        refreshCount(state, state.seenSeeds.length);
      });
      document.getElementById('shb-next')!.addEventListener('click', () => {
        const d = new Date(currentDate);
        d.setDate(d.getDate() + 1);
        loadDate(d);
        if (!state.seenSeeds.includes(currentBird.seed)) state.seenSeeds.push(currentBird.seed);
        saveState(state);
        refreshCount(state, state.seenSeeds.length);
      });

      // Audio wakes on first interaction; then ambient bird-calls begin
      const wake = () => {
        ensureCtx();
        startAmbient(currentBird.freq);
        document.removeEventListener('pointerdown', wake);
        document.removeEventListener('keydown', wake);
      };
      document.addEventListener('pointerdown', wake);
      document.addEventListener('keydown', wake);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAmbient();
        else if (ctx) startAmbient(currentBird.freq);
      });

      // Keyboard nav: ← → for prev/next day, space for feather
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'ArrowLeft') {
          e.preventDefault();
          (document.getElementById('shb-prev') as HTMLButtonElement).click();
        } else if (e.code === 'ArrowRight') {
          e.preventDefault();
          (document.getElementById('shb-next') as HTMLButtonElement).click();
        } else if (e.code === 'Space' || e.code === 'Enter') {
          // Only when nothing else is focused that handles it
          const active = document.activeElement as HTMLElement;
          if (active && active.id === 'shb-feather') return;  // button handles it
          e.preventDefault();
          leaveFeather(state);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
