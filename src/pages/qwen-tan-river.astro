---
const canonical = 'https://pointcast.xyz/qwen-tan-river';
const title = '潭江记忆潮汐 — Qwen Model Study 004';
const description =
  'Rain, travel, kitchens, migration, and river crossings become a device-local spatial sound map of cultural memory along the Tan River.';
const ogImage = 'https://pointcast.xyz/images/qwen-tan-river/og.png';

const tides = [
  {
    id: 'rain',
    number: '01',
    mark: '雨',
    en: 'Rain',
    material: 'filtered rain grains',
    x: '12%',
    y: '66%',
    zh: '雨水浸透了银信，墨迹沿潭江散开',
    seed: 'Rain soaks through the silver letter, ink scattering along the Tan River.',
  },
  {
    id: 'travel',
    number: '02',
    mark: '行',
    en: 'Travel',
    material: 'low engine pulse',
    x: '31%',
    y: '45%',
    zh: '旧码头的石板松了，船往江口去',
    seed: 'The old dock stones have loosened; the boat drifts toward the river mouth.',
  },
  {
    id: 'kitchen',
    number: '03',
    mark: '灶',
    en: 'Kitchen',
    material: 'clay pot resonance',
    x: '50%',
    y: '62%',
    zh: '灶火映着瓦锅，姜烟飘过天井',
    seed: 'Hearth fire glows on the clay pot; ginger smoke drifts through the courtyard.',
  },
  {
    id: 'migration',
    number: '04',
    mark: '迁',
    en: 'Migration',
    material: 'two receding tones',
    x: '70%',
    y: '32%',
    zh: '村口回望时潭江的光在鞋底渐远',
    seed: 'Looking back at the village gate, the Tan River light fades beneath my feet.',
  },
  {
    id: 'crossing',
    number: '05',
    mark: '渡',
    en: 'Crossing',
    material: 'bridge bell partials',
    x: '88%',
    y: '56%',
    zh: '石桥弯成一道拱，江水在底下载着云影',
    seed: 'The stone bridge bends into an arch, the river below carrying cloud shadows.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  alternateName: 'Tan River Memory Tides',
  description,
  url: canonical,
  image: ogImage,
  datePublished: '2026-07-26T15:46:56.000Z',
  creator: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  about: [
    'Tan River, Jiangmen, Guangdong',
    'cultural memory',
    'Qwen bilingual language generation',
    'spatial browser audio',
  ],
  mainEntityOfPage: 'https://pointcast.xyz/qwen-tan-river.json',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Qwen Model Studies',
    url: 'https://pointcast.xyz/qwen-weather',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/json"
      href="/qwen-tan-river.json"
      title="Tan River Memory Tides machine record"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#071311" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: dark;
        --night: #061310;
        --night-soft: #0c211c;
        --cream: #f2ead5;
        --cream-soft: rgba(242, 234, 213, 0.68);
        --jade: #81d4bc;
        --jade-deep: #1c816b;
        --amber: #e5b964;
        --red: #d1543e;
        --line: rgba(242, 234, 213, 0.2);
        --serif: "Songti SC", STSong, "Noto Serif CJK SC", Iowan Old Style,
          Baskerville, "Times New Roman", serif;
        --sans: "Helvetica Neue", "PingFang SC", "Noto Sans CJK SC", Arial,
          sans-serif;
        --mono: "SFMono-Regular", "IBM Plex Mono", Menlo, Consolas, monospace;
        --gutter: clamp(18px, 5vw, 72px);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--night); }
      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 72% 14%, rgba(28, 129, 107, 0.2), transparent 32rem),
          var(--night);
        color: var(--cream);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      button { color: inherit; font: inherit; }
      :focus-visible { outline: 3px solid var(--amber); outline-offset: 4px; }
      ::selection { background: var(--red); color: white; }

      .skip {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 20;
        padding: 10px 13px;
        background: var(--cream);
        color: var(--night);
        transform: translateY(-160%);
      }
      .skip:focus { transform: none; }

      .masthead {
        position: absolute;
        inset: 0 0 auto;
        z-index: 5;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
        padding: 18px var(--gutter);
        border-bottom: 1px solid rgba(242, 234, 213, 0.24);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .masthead a { font-weight: 800; text-decoration: none; }
      .masthead span:last-child { justify-self: end; color: var(--jade); }

      .hero {
        position: relative;
        display: grid;
        min-height: min(920px, 100svh);
        align-items: end;
        overflow: hidden;
        padding: 150px var(--gutter) 60px;
        isolation: isolate;
      }
      .hero__image,
      .hero__wash,
      .hero::after {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .hero__image {
        z-index: -3;
        object-fit: cover;
        object-position: 50% 50%;
        filter: brightness(0.68) saturate(0.94);
      }
      .hero__wash {
        z-index: -2;
        background:
          linear-gradient(180deg, rgba(6, 19, 16, 0.52), transparent 28%, rgba(6, 19, 16, 0.2) 62%, var(--night)),
          linear-gradient(90deg, rgba(6, 19, 16, 0.66), transparent 60%);
      }
      .hero::after {
        z-index: -1;
        content: "";
        opacity: 0.08;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence baseFrequency='.7' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
        pointer-events: none;
      }
      .hero__copy { max-width: 1050px; }
      .eyebrow,
      .section-label {
        margin: 0 0 18px;
        color: var(--jade);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      h1 {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(70px, 13vw, 180px);
        font-weight: 400;
        letter-spacing: -0.08em;
        line-height: 0.73;
      }
      h1 span { display: block; }
      h1 small {
        display: block;
        margin-top: 34px;
        font-family: var(--mono);
        font-size: clamp(10px, 1.1vw, 15px);
        font-weight: 600;
        letter-spacing: 0.18em;
        line-height: 1.4;
      }
      .hero__foot {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
        gap: 40px;
        align-items: end;
        margin-top: 42px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
      }
      .hero__foot > p {
        max-width: 650px;
        margin: 0;
        color: var(--cream-soft);
        font-family: var(--serif);
        font-size: clamp(20px, 2.2vw, 31px);
        line-height: 1.25;
      }
      .hero__foot aside {
        color: var(--cream-soft);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.08em;
        line-height: 1.6;
        text-transform: uppercase;
      }

      .map-section { padding: 100px var(--gutter); }
      .map-heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 34px;
        align-items: end;
        margin-bottom: 42px;
      }
      h2 {
        max-width: 850px;
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(44px, 6vw, 82px);
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 0.96;
      }
      .sound {
        display: grid;
        min-width: 220px;
        gap: 3px;
        padding: 15px 18px;
        border: 1px solid var(--jade);
        background: transparent;
        cursor: pointer;
        text-align: left;
      }
      .sound b { color: var(--jade); font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; }
      .sound small { color: var(--cream-soft); font-family: var(--mono); font-size: 8px; letter-spacing: 0.08em; }
      .sound[aria-pressed="true"] { background: var(--jade); color: var(--night); }
      .sound[aria-pressed="true"] b,
      .sound[aria-pressed="true"] small { color: inherit; }

      .map {
        position: relative;
        min-height: 610px;
        overflow: hidden;
        border: 1px solid var(--line);
        background:
          radial-gradient(circle at 48% 52%, rgba(129, 212, 188, 0.12), transparent 24%),
          linear-gradient(rgba(242, 234, 213, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(242, 234, 213, 0.04) 1px, transparent 1px),
          var(--night-soft);
        background-size: auto, 44px 44px, 44px 44px, auto;
      }
      .river {
        position: absolute;
        top: 46%;
        left: -7%;
        width: 114%;
        height: 24%;
        border: 1px solid rgba(129, 212, 188, 0.32);
        border-radius: 48% 52% 42% 58%;
        background: linear-gradient(90deg, transparent, rgba(28, 129, 107, 0.18), rgba(229, 185, 100, 0.08), transparent);
        transform: rotate(-5deg);
        filter: blur(1px);
      }
      .river::before,
      .river::after {
        position: absolute;
        right: 9%;
        left: 9%;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--jade), transparent);
        content: "";
        opacity: 0.45;
      }
      .river::before { top: 36%; }
      .river::after { bottom: 27%; }
      .node {
        position: absolute;
        top: var(--y);
        left: var(--x);
        display: grid;
        width: 76px;
        height: 76px;
        place-items: center;
        border: 1px solid rgba(242, 234, 213, 0.48);
        border-radius: 50%;
        background: rgba(6, 19, 16, 0.86);
        cursor: pointer;
        transform: translate(-50%, -50%);
      }
      .node::before {
        position: absolute;
        inset: -12px;
        border: 1px solid rgba(129, 212, 188, 0.22);
        border-radius: inherit;
        content: "";
        transform: scale(calc(0.92 + var(--strength, 0) * 0.28));
      }
      .node b { font-family: var(--serif); font-size: 28px; font-weight: 400; }
      .node i {
        position: absolute;
        top: -17px;
        right: -14px;
        color: var(--jade);
        font-family: var(--mono);
        font-size: 8px;
        font-style: normal;
      }
      .node span {
        position: absolute;
        top: calc(100% + 15px);
        left: 50%;
        width: 130px;
        color: var(--cream-soft);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        line-height: 1.45;
        text-align: center;
        text-transform: uppercase;
        transform: translateX(-50%);
      }
      .node[aria-pressed="true"] {
        border-color: var(--amber);
        background: var(--amber);
        color: var(--night);
        box-shadow: 0 0 42px rgba(229, 185, 100, 0.36);
      }
      .node[aria-pressed="true"] span { color: var(--cream); }

      .active-memory {
        display: grid;
        grid-template-columns: 0.4fr 1.5fr auto;
        gap: 36px;
        align-items: center;
        padding: 30px;
        border: 1px solid var(--line);
        border-top: 0;
      }
      .active-memory__mark {
        color: var(--amber);
        font-family: var(--serif);
        font-size: 62px;
      }
      .active-memory blockquote { margin: 0; }
      .active-memory blockquote p { margin: 0; font-family: var(--serif); font-size: clamp(19px, 2.1vw, 28px); }
      .active-memory blockquote p + p { margin-top: 8px; color: var(--cream-soft); font-family: var(--sans); font-size: 13px; }
      .mark-button {
        max-width: 230px;
        padding: 15px;
        border: 1px solid var(--amber);
        background: transparent;
        color: var(--amber);
        cursor: pointer;
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.09em;
        line-height: 1.4;
        text-transform: uppercase;
      }
      .local-note {
        margin: 14px 0 0;
        color: var(--cream-soft);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        text-align: right;
        text-transform: uppercase;
      }

      .qwen {
        display: grid;
        grid-template-columns: minmax(270px, 0.62fr) minmax(0, 1.38fr);
        border-block: 1px solid var(--line);
        background: var(--cream);
        color: var(--night);
      }
      .qwen__lead { padding: 80px var(--gutter); border-right: 1px solid rgba(6, 19, 16, 0.22); }
      .qwen__lead .section-label { color: var(--jade-deep); }
      .qwen__name {
        margin: 28px 0;
        color: var(--red);
        font-family: var(--mono);
        font-size: clamp(45px, 7vw, 98px);
        font-weight: 800;
        letter-spacing: -0.08em;
        line-height: 0.82;
      }
      .qwen__lead p:last-child { max-width: 430px; margin: 0; line-height: 1.55; }
      .seed-list { margin: 0; padding: 0; list-style: none; }
      .seed-list li {
        display: grid;
        grid-template-columns: 54px 1fr auto;
        gap: 20px;
        align-items: center;
        min-height: 118px;
        padding: 22px var(--gutter);
        border-bottom: 1px solid rgba(6, 19, 16, 0.2);
      }
      .seed-list li:last-child { border-bottom: 0; }
      .seed-list > li > span { color: var(--red); font-family: var(--mono); font-size: 10px; }
      .seed-list p { margin: 0; font-family: var(--serif); font-size: clamp(17px, 2vw, 25px); }
      .seed-list p + p { margin-top: 5px; color: rgba(6, 19, 16, 0.62); font-family: var(--sans); font-size: 12px; }
      .seed-list b { font-family: var(--mono); font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; }

      .context,
      .boundary { padding: 100px var(--gutter); }
      .context {
        display: grid;
        grid-template-columns: minmax(250px, 0.62fr) minmax(0, 1.38fr);
        gap: clamp(50px, 9vw, 150px);
      }
      .context__copy { max-width: 860px; }
      .context__copy > p { color: var(--cream-soft); font-size: 16px; line-height: 1.75; }
      .sources { display: grid; margin-top: 35px; border-top: 1px solid var(--line); }
      .sources a {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
        color: var(--jade);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.07em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .sources a::after { content: "↗"; }

      .boundary { background: #2c3b34; }
      .boundary__head {
        display: grid;
        grid-template-columns: 0.62fr 1.38fr;
        gap: 50px;
        margin-bottom: 55px;
      }
      .boundary-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); }
      .boundary-grid article { min-height: 230px; padding: 24px; border-right: 1px solid var(--line); }
      .boundary-grid article:last-child { border: 0; }
      .boundary-grid span { color: var(--amber); font-family: var(--mono); font-size: 9px; }
      .boundary-grid h3 { margin: 55px 0 12px; font-family: var(--serif); font-size: 23px; font-weight: 400; }
      .boundary-grid p { margin: 0; color: var(--cream-soft); font-size: 12px; line-height: 1.55; }
      .warning {
        display: grid;
        grid-template-columns: 0.62fr 1.38fr;
        gap: 50px;
        margin-top: 32px;
        padding-top: 28px;
        border-top: 1px solid var(--amber);
      }
      .warning b { color: var(--amber); font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; }
      .warning p { max-width: 750px; margin: 0; line-height: 1.55; }

      footer {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        padding: 34px var(--gutter);
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        line-height: 1.6;
        text-transform: uppercase;
      }
      footer nav { display: flex; flex-wrap: wrap; gap: 15px; }
      footer p { grid-column: 1 / -1; max-width: 760px; margin: 0; color: var(--cream-soft); }

      @media (max-width: 900px) {
        .hero__foot,
        .qwen,
        .context,
        .boundary__head,
        .warning { grid-template-columns: 1fr; }
        .qwen__lead { border-right: 0; border-bottom: 1px solid rgba(6, 19, 16, 0.22); }
        .boundary-grid { grid-template-columns: repeat(2, 1fr); }
        .boundary-grid article:nth-child(2) { border-right: 0; }
        .boundary-grid article:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
      }
      @media (max-width: 660px) {
        .masthead { grid-template-columns: 1fr auto; padding-inline: 16px; }
        .masthead span:last-child { display: none; }
        .hero { min-height: 790px; padding-inline: 18px; }
        h1 { font-size: clamp(68px, 24vw, 104px); }
        .map-section,
        .context,
        .boundary { padding: 72px 18px; }
        .map-heading { grid-template-columns: 1fr; }
        .sound { width: 100%; }
        .map { min-height: 720px; }
        .node { width: 62px; height: 62px; }
        .node span { width: 90px; }
        .active-memory { grid-template-columns: auto 1fr; padding: 22px 16px; }
        .active-memory__mark { font-size: 42px; }
        .mark-button { grid-column: 1 / -1; max-width: none; }
        .local-note { text-align: left; }
        .qwen__lead { padding: 70px 18px; }
        .seed-list li { grid-template-columns: 34px 1fr; padding: 20px 18px; }
        .seed-list b { display: none; }
        .boundary-grid { grid-template-columns: 1fr; }
        .boundary-grid article { min-height: 190px; border-right: 0; border-bottom: 1px solid var(--line); }
        .boundary-grid article:nth-child(n) { border-bottom: 1px solid var(--line); }
        .boundary-grid article:last-child { border-bottom: 0; }
        footer { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#listening-map">Skip to the listening map</a>

    <header class="masthead">
      <a href="/">PointCast</a>
      <span>Qwen Model Study 004</span>
      <span>开平 · 江门 · 广东</span>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero__image"
          src="/images/qwen-tan-river/og.png"
          alt=""
          width="1730"
          height="909"
        />
        <span class="hero__wash" aria-hidden="true"></span>
        <div class="hero__copy">
          <p class="eyebrow">Qwen Model Study 004 · cultural memory in spatial sound</p>
          <h1 id="hero-title" lang="zh-CN">
            <span>潭江</span>
            <span>记忆潮汐</span>
            <small>TAN RIVER MEMORY TIDES</small>
          </h1>
          <div class="hero__foot">
            <p>
              Rain, travel, kitchens, migration, and river crossings become an
              evolving spatial sound map.
            </p>
            <aside>
              Cultural-memory artwork<br />
              Not live hydrology<br />
              Not a flood-warning system
            </aside>
          </div>
        </div>
      </section>

      <section class="map-section" id="listening-map" aria-labelledby="map-title">
        <div class="map-heading">
          <div>
            <p class="section-label">01 / Spatial listening map · 空间聆听图</p>
            <h2 id="map-title">Five kinds of memory move along one river.</h2>
          </div>
          <button class="sound" type="button" data-sound aria-pressed="false">
            <b data-sound-label>◎ HEAR THE TIDE</b>
            <small>HEADPHONES SUGGESTED · SOUND BEGINS BY CHOICE</small>
          </button>
        </div>

        <div class="map">
          <span class="river" aria-hidden="true"></span>
          {
            tides.map((tide, index) => (
              <button
                class="node"
                type="button"
                data-tide={tide.id}
                data-mark={tide.mark}
                data-zh={tide.zh}
                data-seed={tide.seed}
                aria-pressed={index === 2 ? 'true' : 'false'}
                aria-label={`${tide.en}: ${tide.material}`}
                style={`--x:${tide.x};--y:${tide.y};--strength:0`}
              >
                <b lang="zh-CN">{tide.mark}</b>
                <i data-count={tide.id}>00</i>
                <span>{tide.number} · {tide.en}<br />{tide.material}</span>
              </button>
            ))
          }
        </div>

        <article class="active-memory" aria-live="polite">
          <span class="active-memory__mark" data-active-mark lang="zh-CN">灶</span>
          <blockquote>
            <p data-active-zh lang="zh-CN">灶火映着瓦锅，姜烟飘过天井</p>
            <p data-active-seed>
              Hearth fire glows on the clay pot; ginger smoke drifts through the courtyard.
            </p>
          </blockquote>
          <button class="mark-button" type="button" data-leave-mark>
            Leave one device-local tide mark
          </button>
        </article>
        <p class="local-note" data-local-status>
          This PointCast edition stays on this device · no name · no voice · no location · no free text
        </p>
      </section>

      <section class="qwen" aria-labelledby="qwen-title">
        <div class="qwen__lead">
          <p class="section-label">02 / Qwen language relay · 通义语言中继</p>
          <div class="qwen__name">QWEN<br />通义</div>
          <h2 id="qwen-title">The model opens a door. It does not become the archive.</h2>
          <p>
            Qwen Token Plan generated these five bilingual poetic seeds on July
            26, 2026. They are authored prompts—not testimony, oral history,
            quotations, or evidence from residents.
          </p>
        </div>
        <ol class="seed-list">
          {
            tides.map((tide) => (
              <li>
                <span>{tide.number}</span>
                <div>
                  <p lang="zh-CN">{tide.zh}</p>
                  <p>{tide.seed}</p>
                </div>
                <b>{tide.en}</b>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="context" aria-labelledby="context-title">
        <div>
          <p class="section-label">03 / Regional frame · 地域背景</p>
          <h2 id="context-title">A river can carry movement without claiming every memory.</h2>
        </div>
        <div class="context__copy">
          <p lang="zh-CN">
            潭江流经恩平、开平、台山与新会。江门官方文化规划把它描述为五邑海外迁徙史中的重要通道；开平三埠的历史也与沿江商埠、渡船、浮桥和后来的桥梁相连。
          </p>
          <p>
            The Tan River passes through Enping, Kaiping, Taishan, and Xinhui.
            Jiangmen&apos;s cultural planning describes it as an important
            channel in Wuyi overseas-migration histories; the history of
            Kaiping&apos;s Sanbu is also tied to river ports, ferries, floating
            bridges, and later bridges.
          </p>
          <div class="sources">
            <a href="https://www.jiangmen.gov.cn/bmpd/jmsslj/qmtxhczzt/hhgk/content/post_902816.html" rel="noreferrer">Jiangmen Water Resources Bureau · Tan River</a>
            <a href="https://www.jiangmen.gov.cn/gkmlpt/content/1/1040/post_1040012.html" rel="noreferrer">Jiangmen Overseas-Chinese Culture Plan</a>
            <a href="https://www.kaiping.gov.cn/kpszfw/kpfc/lswh/kpgs/content/post_3487461.html" rel="noreferrer">Kaiping · Sanbu river-port history</a>
            <a href="https://www.unesco.org/en/memory-world/qiaopi-and-yinxin-correspondence-and-remittance-documents-overseas-chinese" rel="noreferrer">UNESCO · Qiaopi and Yinxin</a>
          </div>
        </div>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <div class="boundary__head">
          <p class="section-label">04 / Public boundary · 公共边界</p>
          <h2 id="boundary-title">This map remembers. It does not predict.</h2>
        </div>
        <div class="boundary-grid">
          <article>
            <span>01</span>
            <h3>Not a flood-warning system.</h3>
            <p>No live hydrology, forecast, water level, hazard, or emergency guidance appears here.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Not collected testimony.</h3>
            <p>The five opening fragments are visibly labeled Qwen-authored poetic seeds.</p>
          </article>
          <article>
            <span>03</span>
            <h3>No voice surveillance.</h3>
            <p>No microphone, speaker identity, emotion detection, face, account, or location is used.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Sound begins with consent.</h3>
            <p>The browser-audio tide stays silent until the listener explicitly opens it.</p>
          </article>
        </div>
        <aside class="warning">
          <b>FOR CURRENT RIVER OR EMERGENCY INFORMATION</b>
          <p>
            Leave this artwork and consult the relevant local public authority.
            This page must never be used for safety decisions.
          </p>
        </aside>
      </section>
    </main>

    <footer>
      <nav aria-label="Qwen model studies">
        <a href="/qwen-weather">Study 001</a>
        <a href="/qwen-silver-letter">Study 002</a>
        <a href="/qwen-good-intelligence">Study 003</a>
        <a href="/qwen-tan-river.json">Study 004 JSON</a>
        <a href="https://qwen-weather-memory.mhoydich.chatgpt.site/tan-river" rel="noreferrer">Owner-only shared map</a>
      </nav>
      <a href="#" aria-label="Return to top">↑</a>
      <p>
        Qwen-authored bilingual seeds + procedural browser audio. Public
        PointCast participation remains device-local; the owner-only studio
        edition has an anonymous shared count.
      </p>
    </footer>

    <script is:inline>
      (() => {
        const ids = ['rain', 'travel', 'kitchen', 'migration', 'crossing'];
        const profiles = {
          rain: { frequencies: [391.9, 523.3, 784], pan: -0.82, filter: 1800, duration: 1.7 },
          travel: { frequencies: [65.4, 98, 130.8], pan: -0.43, filter: 620, duration: 2.3 },
          kitchen: { frequencies: [174.6, 261.6, 349.2], pan: 0, filter: 940, duration: 2 },
          migration: { frequencies: [220, 293.7, 440], pan: 0.46, filter: 1200, duration: 2.8 },
          crossing: { frequencies: [277.2, 415.3, 659.3], pan: 0.84, filter: 1500, duration: 2.5 },
        };
        const storageKey = 'pointcast:qwen-tan-river:tides:v1';
        const empty = Object.fromEntries(ids.map((id) => [id, 0]));
        let counts = { ...empty };
        let active = 'kitchen';
        let soundOpen = false;
        let context = null;
        let master = null;
        let interval = null;

        try {
          const saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
          ids.forEach((id) => {
            const amount = Number(saved[id]);
            if (Number.isSafeInteger(amount) && amount >= 0) counts[id] = amount;
          });
        } catch {}

        const nodes = [...document.querySelectorAll('[data-tide]')];
        const status = document.querySelector('[data-local-status]');
        const soundButton = document.querySelector('[data-sound]');
        const soundLabel = document.querySelector('[data-sound-label]');
        const markButton = document.querySelector('[data-leave-mark]');

        const renderCounts = () => {
          const max = Math.max(1, ...ids.map((id) => counts[id]));
          ids.forEach((id) => {
            const count = document.querySelector(`[data-count="${id}"]`);
            const node = document.querySelector(`[data-tide="${id}"]`);
            if (count) count.textContent = String(counts[id]).padStart(2, '0');
            if (node) node.style.setProperty('--strength', String(counts[id] / max));
          });
        };

        const ensureAudio = async () => {
          if (context && master) {
            await context.resume();
            return true;
          }
          const AudioEngine = window.AudioContext || window.webkitAudioContext;
          if (!AudioEngine) return false;
          context = new AudioEngine();
          master = context.createGain();
          const compressor = context.createDynamicsCompressor();
          master.gain.value = 0.0001;
          compressor.threshold.value = -24;
          compressor.knee.value = 18;
          compressor.ratio.value = 5;
          master.connect(compressor).connect(context.destination);
          const low = context.createOscillator();
          const upper = context.createOscillator();
          const lowGain = context.createGain();
          const upperGain = context.createGain();
          const filter = context.createBiquadFilter();
          low.type = 'sine';
          low.frequency.value = 46.2;
          upper.type = 'triangle';
          upper.frequency.value = 69.3;
          lowGain.gain.value = 0.12;
          upperGain.gain.value = 0.018;
          filter.type = 'lowpass';
          filter.frequency.value = 290;
          filter.Q.value = 2.4;
          low.connect(lowGain).connect(filter);
          upper.connect(upperGain).connect(filter);
          filter.connect(master);
          low.start();
          upper.start();
          master.gain.exponentialRampToValueAtTime(0.22, context.currentTime + 2.6);
          return true;
        };

        const noiseBuffer = (duration) => {
          const size = Math.max(1, Math.floor(context.sampleRate * duration));
          const buffer = context.createBuffer(1, size, context.sampleRate);
          const data = buffer.getChannelData(0);
          for (let index = 0; index < size; index += 1) {
            const envelope = Math.sin((index / size) * Math.PI);
            data[index] = ((Math.sin(index * 12.9898) * 43758.5453) % 2 - 1) * envelope * 0.5;
          }
          return buffer;
        };

        const play = async (id) => {
          if (!(await ensureAudio())) return;
          const profile = profiles[id];
          const now = context.currentTime;
          const panner = context.createStereoPanner();
          const filter = context.createBiquadFilter();
          const gain = context.createGain();
          panner.pan.value = profile.pan;
          filter.type = id === 'rain' ? 'highpass' : 'lowpass';
          filter.frequency.value = profile.filter;
          filter.Q.value = id === 'crossing' ? 7 : 2;
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(id === 'travel' ? 0.055 : 0.038, now + 0.06);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + profile.duration);
          filter.connect(panner).connect(gain).connect(master);
          profile.frequencies.forEach((frequency, index) => {
            const oscillator = context.createOscillator();
            const partial = context.createGain();
            oscillator.type = id === 'kitchen' ? 'triangle' : index === 0 ? 'sine' : 'triangle';
            oscillator.frequency.setValueAtTime(frequency, now);
            if (id === 'migration') {
              oscillator.frequency.exponentialRampToValueAtTime(
                frequency * (index === 0 ? 0.78 : 1.12),
                now + profile.duration,
              );
            }
            partial.gain.value = 0.9 / (index + 1.5);
            oscillator.connect(partial).connect(filter);
            oscillator.start(now + index * 0.035);
            oscillator.stop(now + profile.duration + 0.08);
          });
          if (id === 'rain' || id === 'kitchen') {
            const noise = context.createBufferSource();
            const noiseGain = context.createGain();
            noise.buffer = noiseBuffer(id === 'rain' ? 0.58 : 0.16);
            noiseGain.gain.value = id === 'rain' ? 0.25 : 0.12;
            noise.connect(noiseGain).connect(filter);
            noise.start(now + 0.04);
          }
        };

        const select = (node) => {
          active = node.dataset.tide;
          nodes.forEach((item) => item.setAttribute('aria-pressed', item === node ? 'true' : 'false'));
          document.querySelector('[data-active-mark]').textContent = node.dataset.mark;
          document.querySelector('[data-active-zh]').textContent = node.dataset.zh;
          document.querySelector('[data-active-seed]').textContent = node.dataset.seed;
          if (soundOpen) play(active);
        };

        nodes.forEach((node) => node.addEventListener('click', () => select(node)));

        soundButton?.addEventListener('click', async () => {
          if (!soundOpen) {
            if (!(await ensureAudio())) return;
            soundOpen = true;
            soundButton.setAttribute('aria-pressed', 'true');
            if (soundLabel) soundLabel.textContent = '◉ QUIET THE TIDE';
            play(active);
            interval = window.setInterval(() => play(active), 3600);
          } else {
            soundOpen = false;
            soundButton.setAttribute('aria-pressed', 'false');
            if (soundLabel) soundLabel.textContent = '◎ HEAR THE TIDE';
            if (interval) window.clearInterval(interval);
            interval = null;
            context?.suspend();
          }
        });

        markButton?.addEventListener('click', () => {
          counts[active] += 1;
          try { localStorage.setItem(storageKey, JSON.stringify(counts)); } catch {}
          renderCounts();
          if (status) status.textContent =
            `Tide mark kept on this device · ${Object.values(counts).reduce((sum, value) => sum + value, 0)} local marks · no submission sent`;
        });

        renderCounts();
      })();
    </script>
  </body>
</html>
