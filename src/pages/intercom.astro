---
/**
 * /intercom — Mike's inbox for messages from the IntercomWidget.
 *
 * Mike 2026-05-08: "set up a chat that sends messages to me like an
 * intercom." This is the read-side: a simple list of all messages,
 * most recent first, grouped by kind.
 *
 * Public route by default (PointCast is publicly readable). If Mike
 * wants this gated later, add a passphrase prompt or wallet check.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Intercom · messages to Mike · PointCast';
const description = 'Bug reports + chat-to-Mike messages, most recent first. Refreshes every 12s.';
---

<BlockLayout title={title} description={description}>
  <main class="icx" id="icx-main">
    <header class="icx__header">
      <h1 class="icx__title">INTERCOM</h1>
      <p class="icx__tag">messages to mike · bug reports + hi notes · most recent first</p>
    </header>

    <section class="icx__toolbar">
      <button class="icx__btn icx__btn--active" data-filter="all" type="button">ALL</button>
      <button class="icx__btn" data-filter="chat" type="button">💬 CHAT</button>
      <button class="icx__btn" data-filter="bug" type="button">🐛 BUGS</button>
      <span class="icx__count">SHOWING <strong id="icx-count">0</strong></span>
      <button class="icx__btn" id="icx-refresh" type="button">↻ REFRESH</button>
    </section>

    <section class="icx__list" id="icx-list" aria-live="polite">
      <p class="icx__loading" id="icx-loading">loading…</p>
    </section>
  </main>
</BlockLayout>

<style>
  .icx { max-width: 880px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #1a0820; background: #fffaf0; min-height: 100vh; }
  .icx__header { text-align: center; margin: 18px 0 18px; }
  .icx__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 64px); letter-spacing: 0.16em; margin: 0; text-shadow: 2px 2px 0 rgba(212, 164, 55, 0.40); }
  .icx__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #5a3422; opacity: 0.85; margin: 6px 0 0; }

  .icx__toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 10px 14px; border: 2px solid #1a0820; background: #f4e7c8; box-shadow: 4px 4px 0 0 #1a0820; margin-bottom: 14px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.12em; }
  .icx__btn { padding: 8px 14px; border: 2px solid #1a0820; background: #fffaf0; color: #1a0820; font-family: inherit; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; cursor: pointer; box-shadow: 2px 2px 0 0 #1a0820; transition: transform 100ms, box-shadow 100ms; }
  .icx__btn:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 0 #1a0820; }
  .icx__btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }
  .icx__btn--active { background: #d4a437; }
  .icx__count { margin-left: auto; }
  .icx__count strong { color: #b8431a; padding-left: 4px; }

  .icx__list { display: flex; flex-direction: column; gap: 10px; }
  .icx__loading { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; color: #5a3422; padding: 20px; text-align: center; }

  .icx__msg { padding: 12px 14px; border: 2px solid #1a0820; background: #fffaf0; box-shadow: 4px 4px 0 0 #1a0820; }
  .icx__msg-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #5a3422; margin-bottom: 6px; }
  .icx__msg-kind { padding: 2px 8px; border: 1px solid currentColor; border-radius: 999px; font-weight: 800; }
  .icx__msg-kind--bug { color: #b8431a; }
  .icx__msg-kind--chat { color: #2a5a30; }
  .icx__msg-time { color: #5a3422; }
  .icx__msg-page { color: #185fa5; word-break: break-all; }
  .icx__msg-pid { color: #5a3422; opacity: 0.75; }
  .icx__msg-body { font-family: var(--pc-font-sans, system-ui, sans-serif); font-size: 14px; line-height: 1.5; color: #1a0820; white-space: pre-wrap; word-break: break-word; }
  .icx__msg-contact { margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(0,0,0,0.20); font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; color: #5a3422; }
  .icx__msg-contact strong { color: #1a0820; }

  .icx__empty { padding: 40px 20px; text-align: center; font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: #5a3422; }
</style>

<script>
  const listEl = document.getElementById('icx-list');
  const countEl = document.getElementById('icx-count');
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.icx__toolbar [data-filter]'));
  const refreshBtn = document.getElementById('icx-refresh');

  let filter = 'all';
  let messages: any[] = [];

  function fmtTime(t: number): string {
    const d = new Date(t);
    const ymd = d.toLocaleDateString('en-CA');
    const hm = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    return `${ymd} · ${hm}`;
  }

  function escape(s: string): string {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function render() {
    if (!listEl) return;
    const filtered = filter === 'all' ? messages : messages.filter(m => m.kind === filter);
    if (countEl) countEl.textContent = String(filtered.length);
    if (filtered.length === 0) {
      listEl.innerHTML = '<p class="icx__empty">— no messages —</p>';
      return;
    }
    listEl.innerHTML = filtered.map(m => `
      <article class="icx__msg">
        <header class="icx__msg-head">
          <span class="icx__msg-kind icx__msg-kind--${m.kind}">${m.kind === 'bug' ? '🐛 BUG' : '💬 CHAT'}</span>
          <span class="icx__msg-time">${fmtTime(m.t)}</span>
          <span class="icx__msg-page">${escape(m.page || '')}</span>
          <span class="icx__msg-pid">pid ${escape(m.pid || '')}</span>
        </header>
        <div class="icx__msg-body">${escape(m.body || '')}</div>
        ${m.contact ? `<div class="icx__msg-contact"><strong>contact:</strong> ${escape(m.contact)}</div>` : ''}
      </article>
    `).join('');
  }

  async function refresh() {
    try {
      const r = await fetch('/api/intercom', { cache: 'no-store' });
      const j = await r.json();
      if (j?.ok && Array.isArray(j.messages)) {
        messages = j.messages;
        render();
      }
    } catch {}
  }

  filterBtns.forEach(btn => btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.toggle('icx__btn--active', b === btn));
    filter = btn.dataset.filter || 'all';
    render();
  }));
  refreshBtn?.addEventListener('click', refresh);

  refresh();
  setInterval(refresh, 12000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
</script>
