const TIER_ORDER: Tier[] = ['pays-now', 'selective', 'early', 'long-odds'];

function tierLabel(t: Tier): string {
  const labels: Record<Tier, string> = {
    'pays-now': 'PAYS NOW',
    selective: 'SELECTIVE',
    early: 'EARLY',
    'long-odds': 'LONG ODDS',
  };
  return labels[t];
}

const byLane: Record<string, Entry[]> = {};
for (const e of ENTRIES) {
  byLane[e.lane] = byLane[e.lane] ?? [];
  byLane[e.lane].push(e);
}
for (const key of Object.keys(byLane)) {
  byLane[key].sort((a, b) => TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier));
}

