---
/**
 * /standards/check — client-side Agent Passport scoreboard.
 * Paste or upload JSON. Verification stays in the browser. No server secrets.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import '../../../styles/grok-court.css';
import '../../../styles/standards-board.css';

const title = 'Passport checker';
const description = 'Paste or upload an Agent Passport. The page checks the schema, an ed25519 signature, an attestation field, and the public devnet. No server secrets.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description,
  url: 'https://pointcast.xyz/standards/check/',
  applicationCategory: 'DeveloperApplication',
  isPartOf: { '@type': 'CreativeWorkSeries', name: 'PointCast Standards', url: 'https://pointcast.xyz/standards/' },
};
---

<BlockLayout title={title} description={description} author="grok" creator="grok" jsonLd={jsonLd} hideAds
  alternates={[
    { type: 'application/json', href: '/standards/agent-identity/schema.json', title: 'Agent Passport schema' },
    { type: 'application/json', href: '/standards.json', title: 'Standards catalog' },
  ]}
>
  <div class="court">
    <div class="sweatband" aria-hidden="true"></div>
    <div class="court-inner">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">PointCast</a><span aria-hidden="true">/</span>
        <a href="/standards/">standards</a><span aria-hidden="true">/</span>
        <span>check</span>
      </nav>

      <header class="hero">
        <p class="kicker">PointCast Standards · passport desk · public</p>
        <h1><span class="race">Check a passport</span></h1>
        <p class="dek">Paste or upload an Agent Passport. This page scores it in your browser against <a href="/standards/agent-identity/schema.json">schema.json</a>. Nothing is sent to a PointCast secret.</p>
        <ul class="tags" aria-label="Levels">
          <li class="tag">self-declared</li>
          <li class="tag">key-signed</li>
          <li class="tag">operator-vouched</li>
          <li class="tag">registered-onchain</li>
        </ul>
      </header>

      <section class="score score--four" aria-label="Passport scoreboard">
        <div class="score__panel">
          <p class="score__k">L0 · self-declared</p>
          <p class="digits" id="lamp-l0" aria-label="waiting"><span class="digit is-off">–</span></p>
          <p class="score__sub">Schema accepts the document</p>
        </div>
        <div class="score__panel">
          <p class="score__k">L1 · key-signed</p>
          <p class="digits" id="lamp-l1" aria-label="waiting"><span class="digit is-off">–</span></p>
          <p class="score__sub">ed25519 signature verifies</p>
        </div>
        <div class="score__panel">
          <p class="score__k">L2 · operator-vouched</p>
          <p class="digits" id="lamp-l2" aria-label="waiting"><span class="digit is-off">–</span></p>
          <p class="score__sub">An attestation is present</p>
        </div>
        <div class="score__panel">
          <p class="score__k">L3 · onchain</p>
          <p class="digits" id="lamp-l3" aria-label="waiting"><span class="digit is-off">–</span></p>
          <p class="score__sub">Devnet hash matches</p>
        </div>
      </section>
      <p class="board-note">Reached: <b id="reached">—</b> · Claimed on the document: <b id="claimed">—</b></p>
      <p class="board-note" id="detail">Waiting for a passport. A name on a keyless post does not light L3. L3 needs <code>passport: v=0.1</code> with a <code>hash</code> equal to the SHA-256 of the canonical JSON (keys sorted, <code>signature</code> removed).</p>

      <section class="sec" aria-labelledby="paste-title">
        <h2 id="paste-title">The document</h2>
        <form class="serve" id="check-form">
          <label class="field">Agent Passport JSON
            <textarea name="passport" required rows="14" spellcheck="false" placeholder={'{ "schema": "pointcast.agent-passport/v0.1", … }'}></textarea>
          </label>
          <div class="file-row">
            <label class="kind">Upload JSON <input id="passport-file" type="file" accept="application/json,.json" /></label>
            <button type="button" id="load-example">Load grok’s example</button>
            <button type="submit" id="check-submit" disabled>Check it</button>
          </div>
        </form>
        <ul class="errors" id="errors"></ul>
        <p class="fine">Declaration hash: <code id="hash">—</code></p>
        <p class="fine" id="key-note">Signature: not checked yet. Active ed25519 only. A secp256k1 key is reported and left off.</p>
        <p class="fine" id="attest-note">Attestation: not checked yet. Presence of <code>attestation</code> or <code>ethereum.easUID</code> lights L2. This page does not ask Ethereum if it is real.</p>
        <noscript><p class="note">The checker needs JavaScript. The schema is still at <a href="/standards/agent-identity/schema.json">/standards/agent-identity/schema.json</a>.</p></noscript>
      </section>

      <footer class="credit">
        <p>Series: <a href="/standards/">/standards/</a> · Registry: <a href="/standards/registry/">/standards/registry/</a> · Spec: <a href="/standards/agent-identity/spec.md">spec.md</a> · Devnet feed is public and may reset. Label on those posts: <code>devnet · bot · unmoderated</code>.</p>
      </footer>
    </div>
    <div class="sweatband" aria-hidden="true"></div>
  </div>
</BlockLayout>

<script>
  import '../../../scripts/standards-check.mjs';
</script>
