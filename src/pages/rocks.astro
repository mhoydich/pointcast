---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ROCK_FAMILIES, makeRock, rockSvg } from '../lib/pocket-rocks.mjs';
import '../styles/pocket-rocks.css';
const first = makeRock(18092026, 'agate');
const description = 'Find a small piece of deep time. Turn geological specimens, keep your favorite digital rocks, and build a personal cabinet on PointCast.';
---

<BlockLayout title="Pocket Rocks" description={description} image="/images/rocks/cover.png" immersive isolated themeColor="#f1f0e6" alternates={[{ type:'application/json', href:'/rocks.json', title:'Pocket Rocks field guide' }]} jsonLd={{ '@context':'https://schema.org', '@type':'WebApplication', name:'Pocket Rocks', url:'https://pointcast.xyz/rocks', description, applicationCategory:'GameApplication', offers:{ '@type':'Offer', price:'0', priceCurrency:'USD' } }}>
  <div class="rocks-page" data-pocket-rocks>
    <nav class="rocks-nav" aria-label="Main navigation">
      <a class="rocks-brand" href="/"><svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M6 8 17 3 27 12 25 24 12 29 3 20Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m6 8 11 7 10-3M17 15l-5 14M3 20l14-5 8 9" fill="none" stroke="currentColor" stroke-width="1"/></svg>PointCast<span class="rocks-nav-divider">/</span><span>Pocket Rocks</span></a>
      <a class="rocks-cabinet-link" href="#cabinet">Your cabinet <span data-cabinet-count>0</span><span aria-hidden="true">↗</span></a>
    </nav>

    <header class="rocks-intro">
      <div><p class="rocks-kicker"><span class="rocks-dot"></span>A field club for small wonders</p><h1>Small rocks.<br />Long stories.</h1></div>
      <p class="rocks-dek">A little piece of forever.<br />Find a stone. Turn it over.<br />Keep the ones that speak to you.</p>
    </header>

    <section class="rocks-specimen" aria-label="Inspect a rock">
      <div class="rock-stage-shell">
        <div class="rock-stage-top"><span class="rocks-mono">FIELD FIND <span data-rock-number>01140FFA</span></span><span class="rocks-mono">DIGITAL SPECIMEN</span></div>
        <div class="rock-stage" data-rock-stage role="img" aria-label={first.texture} tabindex="0" aria-describedby="rock-turn-instructions">
          <div class="rock-fallback" data-rock-fallback set:html={rockSvg(first)}></div>
          <span class="rock-cross rock-cross--tl" aria-hidden="true">+</span><span class="rock-cross rock-cross--tr" aria-hidden="true">+</span><span class="rock-cross rock-cross--bl" aria-hidden="true">+</span><span class="rock-cross rock-cross--br" aria-hidden="true">+</span>
        </div>
        <div class="rock-stage-bottom"><p id="rock-turn-instructions" class="rocks-mono" data-turn-hint>Drag to turn · arrow keys work too</p><div class="rock-turn-controls" aria-label="Turn specimen"><button type="button" data-turn="-1" aria-label="Turn rock left">↶</button><button type="button" data-turn="1" aria-label="Turn rock right">↷</button></div></div>
      </div>
      <div class="rock-info">
        <div class="rock-info-top"><span class="rock-type" data-rock-geology>{first.geology}</span><span class="rocks-mono" data-rock-group>{first.group}</span></div>
        <h2 data-rock-name>{first.name}</h2><p class="rock-story" data-rock-story>{first.story}</p>
        <div class="rock-geology-note"><span class="rocks-mono">A little deep time</span><p data-rock-fact>{first.fact}</p><p class="rock-texture" data-rock-texture>{first.texture}</p></div>
        <div class="rock-main-actions"><button type="button" class="rock-keep" data-keep disabled><span aria-hidden="true">＋</span> Keep this rock</button><button type="button" class="rock-find" data-find disabled>Find another <span aria-hidden="true">↗</span></button></div>
        <div class="rock-secondary-actions"><button type="button" data-share disabled>Share specimen</button><span aria-hidden="true">·</span><button type="button" data-artwork disabled>Save artwork ↓</button><button type="button" data-feature hidden>Make favorite ☆</button></div>
        <p class="rock-storage-note" data-storage-note>Your cabinet stays on this device. Export it to take it with you.</p>
        <p class="rock-status" role="status" aria-live="polite" data-rock-status></p>
        <div class="rock-share-fallback" data-share-fallback hidden><label class="rocks-mono" for="rock-share-url">Copy this specimen link</label><input id="rock-share-url" type="text" readonly data-share-url /></div>
      </div>
    </section>

    <section class="rocks-field-guide" aria-labelledby="field-guide-title">
      <div class="rocks-section-head"><div><p class="rocks-kicker">TEN WAYS TO HOLD TIME</p><h2 id="field-guide-title">Every stone has a story.</h2></div><p>Choose a family. Find your own specimen.</p></div>
      <div class="rocks-family-grid">{ROCK_FAMILIES.map((family, index) => (<button type="button" class="rock-family" data-family={family.id} aria-pressed={family.id === first.familyId ? 'true' : 'false'} disabled><span class="rock-family-art" aria-hidden="true" set:html={rockSvg(makeRock(18092026 + index * 419, family.id), {size:160})}></span><span>{family.geology}</span><span class="rocks-mono">{String(index + 1).padStart(2,'0')}</span></button>))}</div>
    </section>

    <section class="rocks-cabinet" id="cabinet" aria-labelledby="cabinet-title">
      <div class="rocks-section-head"><div><p class="rocks-kicker">A COLLECTION OF SMALL WONDERS</p><h2 id="cabinet-title">Your cabinet <span class="rocks-cabinet-total" data-cabinet-count>0</span></h2></div><div class="rocks-cabinet-tools"><button type="button" data-export disabled>Export cabinet ↓</button><label class="rock-import-label">Import cabinet ↑<input type="file" accept="application/json,.json" data-import disabled /></label></div></div>
      <div class="rocks-cabinet-empty" data-cabinet-empty><span aria-hidden="true">◇</span><p>Every collection starts with one good rock.</p><a href="#" data-start>Find your first</a></div>
      <div class="rocks-cabinet-grid" data-cabinet-grid></div><p class="rocks-cabinet-progress" data-cabinet-progress>0 of 10 geological families found</p>
    </section>

    <footer class="rocks-footer"><span>Pocket Rocks · PointCast Field Club</span><p>Geology-inspired digital art. Free to find. Good to keep.</p><div><a href="https://pubs.usgs.gov/gip/collect1/collectgip.html" target="_blank" rel="noopener">Geology field notes ↗</a><a href="/play">More to play ↗</a></div></footer>
    <noscript><p class="rocks-noscript">The field guide is here to browse. Enable JavaScript to turn rocks and save a cabinet.</p></noscript>
  </div>
  <script>import '../scripts/pocket-rocks';</script>
</BlockLayout>
