---
import BlockLayout from '../layouts/BlockLayout.astro';
import { TOOLS } from '../scripts/chapter-city-sim.mjs';
import '../styles/chapter-city.css';

const description = 'CHAPTER CITY is a PointCast city-builder that writes its own novel. Zone homes, shops and industry on a seaside map, keep the lights on and the books balanced, and each simulated year becomes a chapter with recurring characters, a newspaper headline and a dilemma for next year. Plays in the browser; saves only on your device.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Chapter City', url: 'https://pointcast.xyz/chapter-city/', genre: ['City-building', 'Interactive fiction'], gamePlatform: 'Web browser', applicationCategory: 'Game', isAccessibleForFree: true, description };
const tools = Object.entries(TOOLS);
---
<BlockLayout title="Chapter City · A city-builder that writes its own novel" description={description} themeColor="#1d3b4f" immersive isolated showNetworkStrip={false} hideAds jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/chapter-city.json', title: 'Chapter City — rules and story engine' }]}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Oswald:wght@500;600&family=IBM+Plex+Mono:wght@400;600&display=swap" />

  <div class="cc" data-cc>
    <header class="cc-top">
      <a class="cc-home" href="/">POINTCAST ↗</a>
      <h1 class="cc-title"><span data-town>Halcyon</span><small>a city in chapters</small></h1>
      <div class="cc-top-actions">
        <button type="button" data-act="sound" aria-pressed="true" title="Sound on/off">♪<span class="cc-sr"> Sound</span></button>
        <button type="button" data-act="help" aria-expanded="false" aria-controls="cc-help">How to play</button>
        <button type="button" data-act="new">New novel</button>
      </div>
    </header>

    <main class="cc-main">
      <section class="cc-city" aria-label="The city">
        <dl class="cc-stats" aria-live="polite">
          <div><dt>Year</dt><dd data-stat="year">1</dd></div>
          <div><dt>Treasury</dt><dd data-stat="funds">6,000</dd></div>
          <div><dt>People</dt><dd data-stat="pop">0</dd></div>
          <div><dt>Approval</dt><dd data-stat="approval">58%</dd></div>
          <div class="cc-rci" title="Demand: homes, shops, industry">
            <dt>Demand</dt>
            <dd><span class="cc-bar" data-bar="r" aria-label="Homes demand"><i></i><b>R</b></span><span class="cc-bar" data-bar="c" aria-label="Shops demand"><i></i><b>C</b></span><span class="cc-bar" data-bar="i" aria-label="Industry demand"><i></i><b>I</b></span></dd>
          </div>
          <div class="cc-utils"><dt>Power · Water</dt><dd><span data-stat="power">0/0</span> · <span data-stat="water">0/0</span></dd></div>
        </dl>

        <div class="cc-tools" role="toolbar" aria-label="Build tools">
          {tools.map(([id, t]) => (
            <button type="button" class={`cc-tool cc-tool-${id}`} data-tool={id} aria-pressed={id === 'road' ? 'true' : 'false'} title={`${t.label} · ${t.cost}${t.upkeep ? ` (+${t.upkeep}/mo)` : ''} · key ${t.key}`}>
              <i aria-hidden="true"></i><span>{t.short}</span><small>{t.cost}</small>
            </button>
          ))}
        </div>

        <div class="cc-map-wrap">
          <canvas class="cc-map" data-map width="768" height="512" tabindex="0" aria-label="City map. Click or drag to build with the selected tool. Arrow keys move the cursor and Enter builds."></canvas>
          <p class="cc-tip" data-tip hidden></p>
        </div>

        <div class="cc-controls">
          <label class="cc-tax">Tax rate <output data-tax-out>7%</output><input type="range" min="0" max="15" step="1" value="7" data-tax aria-label="Tax rate" /></label>
          <label class="cc-overlay">View
            <select data-overlay aria-label="Map overlay">
              <option value="none">The city</option>
              <option value="pollution">Pollution</option>
              <option value="land">Land value</option>
              <option value="services">Services coverage</option>
              <option value="crime">Crime</option>
            </select>
          </label>
          <button type="button" class="cc-turn" data-act="turn">Write Chapter 1 →</button>
        </div>
        <p class="cc-hint" data-hint>Lay a road, zone homes and industry beside it, and build a power plant. Then write the first chapter.</p>
      </section>

      <section class="cc-book" aria-label="The novel">
        <nav class="cc-book-nav" aria-label="Chapters">
          <button type="button" data-act="prev" aria-label="Previous chapter">‹</button>
          <select data-chapters aria-label="Go to chapter"></select>
          <button type="button" data-act="next" aria-label="Next chapter">›</button>
          <button type="button" data-act="download" title="Download the whole novel as Markdown">⤓ Novel</button>
        </nav>
        <article class="cc-page" data-page aria-live="polite"></article>
        <div class="cc-dilemma" data-dilemma hidden></div>
      </section>
    </main>

    <section class="cc-help" id="cc-help" data-help hidden aria-label="How to play">
      <h2>How to play</h2>
      <ol>
        <li><b>Zones need roads.</b> Homes, shops and industry only grow within two tiles of a road, and only with power. Above the first level they need water too.</li>
        <li><b>Balance the letters.</b> The R, C and I bars show demand for homes, shops and industry. Build what the town is asking for.</li>
        <li><b>Services keep people.</b> Schools, clinics, fire stations and watch houses cover about six tiles. Homes without a fire station nearby can burn. Big homes need a school.</li>
        <li><b>Mind the smoke.</b> Industry and power plants pollute. Parks and trees clean the air. Homes near the sea are worth more.</li>
        <li><b>Write a chapter.</b> Each turn simulates a year. The town writes it up as a chapter of its novel, with a headline and a choice for the year ahead.</li>
        <li><b>Elections every four years.</b> Fall below 40% approval in an election year and the book ends. So does a treasury below −1,500.</li>
      </ol>
      <p class="cc-small">Keys: 1–9, 0, − and X pick tools. Arrow keys move the map cursor; Enter builds. Everything runs in your browser, and the game saves only on this device. The town, its people and its serpent are fiction.</p>
      <button type="button" data-act="help">Close</button>
    </section>

    <form class="cc-newgame" data-newgame hidden>
      <h2>Start a new novel</h2>
      <label>Name your town <input name="name" maxlength="24" value="Halcyon" autocomplete="off" /></label>
      <p class="cc-small">Each new novel gets its own coastline and its own story. Your current book stays downloadable until you start.</p>
      <div><button type="submit">Begin the prologue</button><button type="button" data-act="cancel-new">Cancel</button></div>
    </form>

    <p class="cc-toast" data-toast role="status"></p>
    <noscript><p class="cc-noscript">Chapter City needs JavaScript. The rules are described at <a href="/chapter-city.json">/chapter-city.json</a>.</p></noscript>
  </div>

  <script>
    import { initChapterCity } from '../scripts/chapter-city.mjs';
    const setup = () => initChapterCity(document.querySelector('[data-cc]'));
    setup();
    document.addEventListener('astro:page-load', setup);
  </script>
</BlockLayout>
