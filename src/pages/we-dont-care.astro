---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = "We Don't Care · tap-on-beat";
const description =
  "A small Spinning room around 'We Don't Care' from Kanye's College Dropout (2004) — Spotify embed plus a self-paced 89 BPM metronome. Tap with the kids' chant, hold a streak.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/we-dont-care',
  name: title,
  description,
  url: 'https://pointcast.xyz/we-dont-care',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  about: {
    '@type': 'MusicRecording',
    name: "We Don't Care",
    byArtist: { '@type': 'MusicGroup', name: 'Kanye West' },
    inAlbum: { '@type': 'MusicAlbum', name: 'The College Dropout' },
    datePublished: '2004',
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image="https://noun.pics/453.svg"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/b/0453.json', title: 'Block 0453 (JSON)' },
  ]}
  frame={{
    image: 'https://noun.pics/453.svg',
    buttons: [
      { label: 'Tap-on-beat room', action: 'link', target: 'https://pointcast.xyz/we-dont-care' },
      { label: 'Open in Spotify', action: 'link', target: 'https://open.spotify.com/track/0IW0qaeyxL5Et4UG2MrJKB' },
      { label: 'Block 0453', action: 'link', target: 'https://pointcast.xyz/b/0453' },
      { label: '/c/spinning', action: 'link', target: 'https://pointcast.xyz/c/spinning' },
    ],
  }}
>
  <div class="wdc">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/c/spinning">spinning</a>
      <span aria-hidden="true">/</span>
      <span>we don't care</span>
    </nav>

    <header class="hero">
      <div class="hero__chip">
        <img src="https://noun.pics/453.svg" alt="" width="96" height="96" loading="eager" />
      </div>
      <p class="kicker">CH.SPN · BLOCK 0453 · 2004 → 2026</p>
      <h1>We Don't<br />Care.</h1>
      <p class="dek">
        Kanye West · The College Dropout · track 02. Press play below, then tap on
        the downbeat with the kids' chant. Self-paced metronome. No leaderboard.
      </p>
    </header>

    <section class="player">
      <h2 class="bar">PLAY THE TRACK</h2>
      <div class="player__embed">
        <iframe
          src="https://open.spotify.com/embed/track/0IW0qaeyxL5Et4UG2MrJKB?utm_source=pointcast"
          width="100%"
          height="152"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="We Don't Care — Kanye West"
        ></iframe>
      </div>
      <p class="player__note">
        Spotify won't tell us when the bar lands, so the pad below runs its own
        metronome at <strong>89 BPM</strong>. Hit play on Spotify and the pad at
        the same time and they should hold step.
      </p>
    </section>

    <section class="game" data-game>
      <h2 class="bar">TAP-ON-BEAT</h2>

      <div class="game__hud">
        <div class="hud-cell">
          <span class="mono">streak</span>
          <strong data-streak>0</strong>
        </div>
        <div class="hud-cell">
          <span class="mono">hits</span>
          <strong data-hits>0</strong>
        </div>
        <div class="hud-cell">
          <span class="mono">best</span>
          <strong data-best>0</strong>
        </div>
        <div class="hud-cell hud-cell--bpm">
          <span class="mono">tempo</span>
          <strong>89 BPM</strong>
        </div>
      </div>

      <button type="button" class="pad" data-pad aria-label="Tap on the beat">
        <span class="pad__chant" data-chant>WE DON'T CARE</span>
        <span class="pad__hint" data-hint>press START → tap pad or SPACE on the beat</span>
        <span class="pad__ring" data-ring aria-hidden="true"></span>
      </button>

      <div class="game__controls">
        <button type="button" class="ctl ctl--primary" data-start>START METRONOME</button>
        <button type="button" class="ctl" data-mute aria-pressed="false">MUTE TICK</button>
        <button type="button" class="ctl" data-reset>RESET BEST</button>
      </div>

      <p class="game__rules">
        Hit window: ±180 ms around each beat. Land it → streak +1, screen flashes
        gold. Miss the window or tap between beats → streak resets to 0. Best run
        saves to this browser only.
      </p>
    </section>

    <section class="choir" data-choir>
      <h2 class="bar">THE CHOIR · 12 NOUNS</h2>
      <p class="choir__lede">
        Twelve fresh Visit Nouns line the bench. They bob with the metronome —
        the chant rolls left to right. Land an on-beat tap and they all flash
        gold. Miss and they shake their heads.
      </p>
      <ul class="choir__bench" data-bench>
        {[33, 51, 63, 86, 99, 121, 144, 156, 175, 199, 244, 297].map((seed, i) => (
          <li class="choir__seat" style={`--i: ${i}`}>
            <img
              src={`https://noun.pics/${seed}.svg`}
              alt={`Visit Noun #${seed}`}
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
            />
            <span class="choir__tag">#{seed}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="facts">
      <h2 class="bar">TRACK FACTS</h2>
      <dl>
        <div><dt>Track</dt><dd>We Don't Care</dd></div>
        <div><dt>Artist</dt><dd>Kanye West</dd></div>
        <div><dt>Album</dt><dd>The College Dropout (2004)</dd></div>
        <div><dt>Position</dt><dd>02 of 21</dd></div>
        <div><dt>Tempo</dt><dd>~89 BPM</dd></div>
        <div><dt>Hook</dt><dd>kids' choir, "we don't care what people say"</dd></div>
        <div><dt>Channel</dt><dd><a href="/c/spinning">SPN · Spinning</a></dd></div>
        <div><dt>Block</dt><dd><a href="/b/0453">/b/0453</a></dd></div>
      </dl>
    </section>

    <footer class="foot">
      <p>
        a small room on a small internet town · <a href="/">pointcast</a> ·
        <a href="/c/spinning">/c/spinning</a> ·
        <a href="https://open.spotify.com/track/0IW0qaeyxL5Et4UG2MrJKB">spotify</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-game]');
      if (!root) return;

      const STORAGE_KEY = 'pc:we-dont-care:v1';
      const BPM = 89;
      const BEAT_MS = 60000 / BPM; // ~674 ms
      const HIT_WINDOW = 180;
      const CHANT = ['WE DON’T CARE', 'YOU READY?', 'LET’S GO', 'WE DON’T CARE'];

      const padEl = root.querySelector('[data-pad]');
      const ringEl = root.querySelector('[data-ring]');
      const chantEl = root.querySelector('[data-chant]');
      const hintEl = root.querySelector('[data-hint]');
      const streakEl = root.querySelector('[data-streak]');
      const hitsEl = root.querySelector('[data-hits]');
      const bestEl = root.querySelector('[data-best]');
      const startBtn = root.querySelector('[data-start]');
      const muteBtn = root.querySelector('[data-mute]');
      const resetBtn = root.querySelector('[data-reset]');
      const choirSeats = Array.from(document.querySelectorAll('[data-bench] .choir__seat'));

      let running = false;
      let muted = false;
      let nextBeat = 0;
      let beatIndex = 0;
      let streak = 0;
      let hits = 0;
      let best = 0;
      let rafId = 0;
      let audioCtx = null;

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        if (typeof saved.best === 'number') best = saved.best;
      } catch (err) {}
      bestEl.textContent = String(best);

      function tickSound(when) {
        if (muted || !audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(beatIndex % 4 === 0 ? 880 : 660, when);
        gain.gain.setValueAtTime(0.0001, when);
        gain.gain.exponentialRampToValueAtTime(0.18, when + 0.005);
        gain.gain.exponentialRampToValueAtTime(0.0001, when + 0.06);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start(when);
        osc.stop(when + 0.08);
      }

      function pulse() {
        padEl.classList.remove('is-pulse');
        // force reflow so the animation restarts
        void padEl.offsetWidth;
        padEl.classList.add('is-pulse');
        chantEl.textContent = CHANT[beatIndex % CHANT.length];
        // roll the chant left → right across the choir bench
        if (choirSeats.length) {
          const seat = choirSeats[beatIndex % choirSeats.length];
          seat.classList.remove('is-bob');
          void seat.offsetWidth;
          seat.classList.add('is-bob');
        }
      }

      function choirReact(cls) {
        choirSeats.forEach((seat) => {
          seat.classList.remove('is-flash', 'is-shake');
          void seat.offsetWidth;
          seat.classList.add(cls);
          setTimeout(() => seat.classList.remove(cls), 360);
        });
      }

      function loop(now) {
        if (!running) return;
        while (now >= nextBeat) {
          pulse();
          if (audioCtx) tickSound(audioCtx.currentTime);
          beatIndex += 1;
          nextBeat += BEAT_MS;
        }
        rafId = requestAnimationFrame(loop);
      }

      function start() {
        if (running) return;
        if (!audioCtx) {
          try {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          } catch (err) {
            audioCtx = null;
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        running = true;
        nextBeat = performance.now() + 800;
        beatIndex = 0;
        startBtn.textContent = 'STOP METRONOME';
        startBtn.classList.add('is-on');
        hintEl.textContent = 'tap pad or SPACE on the beat';
        rafId = requestAnimationFrame(loop);
      }

      function stop() {
        running = false;
        cancelAnimationFrame(rafId);
        startBtn.textContent = 'START METRONOME';
        startBtn.classList.remove('is-on');
        hintEl.textContent = 'press START → tap pad or SPACE on the beat';
        padEl.classList.remove('is-pulse');
      }

      function registerTap() {
        if (!running) {
          padEl.classList.add('is-warn');
          setTimeout(() => padEl.classList.remove('is-warn'), 220);
          return;
        }
        const now = performance.now();
        // distance to nearest beat (past or future)
        const last = nextBeat - BEAT_MS;
        const distLast = Math.abs(now - last);
        const distNext = Math.abs(nextBeat - now);
        const dist = Math.min(distLast, distNext);
        if (dist <= HIT_WINDOW) {
          streak += 1;
          hits += 1;
          if (streak > best) {
            best = streak;
            try {
              localStorage.setItem(STORAGE_KEY, JSON.stringify({ best: best }));
            } catch (err) {}
            bestEl.textContent = String(best);
          }
          padEl.classList.add('is-hit');
          setTimeout(() => padEl.classList.remove('is-hit'), 180);
          choirReact('is-flash');
        } else {
          streak = 0;
          padEl.classList.add('is-miss');
          setTimeout(() => padEl.classList.remove('is-miss'), 220);
          choirReact('is-shake');
        }
        streakEl.textContent = String(streak);
        hitsEl.textContent = String(hits);
      }

      startBtn.addEventListener('click', () => {
        if (running) stop(); else start();
      });

      muteBtn.addEventListener('click', () => {
        muted = !muted;
        muteBtn.setAttribute('aria-pressed', String(muted));
        muteBtn.textContent = muted ? 'UNMUTE TICK' : 'MUTE TICK';
      });

      resetBtn.addEventListener('click', () => {
        best = 0;
        try { localStorage.removeItem(STORAGE_KEY); } catch (err) {}
        bestEl.textContent = '0';
      });

      padEl.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        registerTap();
      });

      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space') {
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
          e.preventDefault();
          if (!running) start(); else registerTap();
        }
      });

      window.addEventListener('beforeunload', () => stop());
    })();
  </script>

  <style>
    .wdc {
      --paper: #fff5e8;
      --ink: #1a1410;
      --coral: #993c1d;
      --gold: #e6a92b;
      --hit: #ffd23f;
      --miss: #b54d3a;

      max-width: 980px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
      background: var(--paper);
      color: var(--ink);
      font-family: 'Georgia', 'Times New Roman', serif;
    }

    .crumb {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.7);
      margin-bottom: 1.5rem;
    }
    .crumb a { color: var(--coral); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb span[aria-hidden] { margin: 0 0.4rem; opacity: 0.5; }

    .hero {
      position: relative;
      border: 3px double var(--ink);
      background: repeating-linear-gradient(
        135deg,
        #fff5e8 0 14px,
        #fae6c9 14px 28px
      );
      padding: 2.5rem 2rem 2rem;
      margin-bottom: 1.75rem;
    }
    .hero__chip {
      position: absolute;
      top: -28px;
      left: 24px;
      width: 72px;
      height: 72px;
      background: var(--paper);
      border: 3px double var(--ink);
      display: grid;
      place-items: center;
    }
    .hero__chip img {
      width: 56px;
      height: 56px;
      image-rendering: pixelated;
    }
    .kicker {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      color: var(--coral);
      margin: 0 0 0.75rem;
    }
    .hero h1 {
      font-family: 'Georgia', serif;
      font-weight: 900;
      font-style: italic;
      font-size: clamp(3rem, 9vw, 6rem);
      line-height: 0.92;
      letter-spacing: -0.02em;
      margin: 0 0 1rem;
    }
    .hero .dek {
      max-width: 56ch;
      font-size: 1.05rem;
      line-height: 1.5;
      margin: 0;
    }

    .bar {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--paper);
      background: var(--ink);
      padding: 0.4rem 0.75rem;
      margin: 0 0 0.85rem;
      display: inline-block;
    }

    .player {
      margin-bottom: 1.75rem;
    }
    .player__embed {
      border: 3px solid var(--ink);
      background: #000;
    }
    .player__embed iframe { display: block; border: 0; }
    .player__note {
      font-size: 0.92rem;
      line-height: 1.5;
      color: rgba(26, 20, 16, 0.78);
      margin: 0.75rem 0 0;
    }

    .game {
      margin-bottom: 1.75rem;
    }
    .game__hud {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }
    .hud-cell {
      border: 2px solid var(--ink);
      background: var(--paper);
      padding: 0.5rem 0.7rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .hud-cell .mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.55);
    }
    .hud-cell strong {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 1.5rem;
      line-height: 1;
      font-weight: 700;
    }
    .hud-cell--bpm strong { color: var(--coral); font-size: 1.05rem; padding-top: 0.3rem; }

    .pad {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 7;
      min-height: 220px;
      border: 4px solid var(--ink);
      background: var(--coral);
      color: var(--paper);
      display: grid;
      place-items: center;
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.06s ease;
      user-select: none;
      touch-action: manipulation;
      font-family: inherit;
    }
    .pad:active { transform: translateY(1px); }
    .pad:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }

    .pad__chant {
      position: relative;
      z-index: 2;
      font-family: 'Georgia', serif;
      font-style: italic;
      font-weight: 900;
      font-size: clamp(1.8rem, 5.5vw, 3rem);
      letter-spacing: -0.01em;
      text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
    }
    .pad__hint {
      position: absolute;
      bottom: 0.7rem;
      left: 0;
      right: 0;
      z-index: 2;
      text-align: center;
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(255, 245, 232, 0.78);
    }
    .pad__ring {
      position: absolute;
      inset: 50% 50%;
      width: 0;
      height: 0;
      border-radius: 999px;
      border: 3px solid rgba(255, 255, 255, 0.55);
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
    .pad.is-pulse {
      animation: padPulse 220ms ease-out;
    }
    .pad.is-pulse .pad__ring {
      animation: ringExpand 360ms ease-out;
    }
    .pad.is-hit {
      background: var(--hit);
      color: var(--ink);
    }
    .pad.is-miss {
      background: var(--miss);
    }
    .pad.is-warn {
      box-shadow: inset 0 0 0 6px var(--gold);
    }

    @keyframes padPulse {
      0%   { box-shadow: inset 0 0 0 0 rgba(255,255,255,0); }
      30%  { box-shadow: inset 0 0 0 8px rgba(255,255,255,0.55); }
      100% { box-shadow: inset 0 0 0 0 rgba(255,255,255,0); }
    }
    @keyframes ringExpand {
      0%   { width: 20px; height: 20px; opacity: 0.9; }
      100% { width: 280px; height: 280px; opacity: 0; }
    }

    .game__controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.85rem 0 0.65rem;
    }
    .ctl {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.65rem 1rem;
      border: 2px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      cursor: pointer;
    }
    .ctl:hover { background: var(--ink); color: var(--paper); }
    .ctl--primary {
      background: var(--ink);
      color: var(--paper);
    }
    .ctl--primary.is-on {
      background: var(--gold);
      color: var(--ink);
    }

    .game__rules {
      font-size: 0.88rem;
      line-height: 1.5;
      color: rgba(26, 20, 16, 0.72);
      margin: 0;
    }

    .facts {
      border-top: 2px solid var(--ink);
      padding-top: 1rem;
      margin-bottom: 1.75rem;
    }
    .facts dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1.25rem;
      margin: 0;
    }
    .facts div {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 0.6rem;
      align-items: baseline;
      padding: 0.25rem 0;
      border-bottom: 1px dashed rgba(26, 20, 16, 0.2);
    }
    .facts dt {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.6);
    }
    .facts dd {
      margin: 0;
      font-size: 0.95rem;
    }
    .facts a { color: var(--coral); }

    .foot {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.55);
      text-align: center;
      padding-top: 1rem;
      border-top: 1px solid rgba(26, 20, 16, 0.2);
    }
    .foot a { color: var(--coral); margin: 0 0.25rem; }

    .choir {
      margin-bottom: 1.75rem;
    }
    .choir__lede {
      font-size: 0.95rem;
      line-height: 1.5;
      color: rgba(26, 20, 16, 0.78);
      margin: 0 0 0.85rem;
    }
    .choir__bench {
      list-style: none;
      margin: 0;
      padding: 0.85rem;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 0.4rem;
      border: 3px solid var(--ink);
      background:
        linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 70%, rgba(26,20,16,0.08) 100%),
        repeating-linear-gradient(90deg, var(--paper) 0 8px, #f5e3c4 8px 16px);
    }
    .choir__seat {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
    }
    .choir__seat img {
      width: 100%;
      max-width: 64px;
      aspect-ratio: 1 / 1;
      image-rendering: pixelated;
      background: var(--paper);
      border: 2px solid var(--ink);
      transition: transform 0.18s ease, filter 0.18s ease;
      transform-origin: 50% 100%;
    }
    .choir__tag {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: rgba(26, 20, 16, 0.55);
    }
    .choir__seat.is-bob img { animation: seatBob 360ms ease-out; }
    .choir__seat.is-flash img {
      animation: seatFlash 360ms ease-out;
      filter: drop-shadow(0 0 6px var(--gold));
    }
    .choir__seat.is-shake img { animation: seatShake 280ms ease-in-out; }

    @keyframes seatBob {
      0%   { transform: translateY(0) scale(1); }
      45%  { transform: translateY(-6px) scale(1.06); }
      100% { transform: translateY(0) scale(1); }
    }
    @keyframes seatFlash {
      0%   { transform: scale(1); background: var(--paper); }
      50%  { transform: scale(1.12); background: var(--gold); }
      100% { transform: scale(1); background: var(--paper); }
    }
    @keyframes seatShake {
      0%, 100% { transform: translateX(0); }
      25%      { transform: translateX(-3px) rotate(-2deg); }
      50%      { transform: translateX(3px) rotate(2deg); }
      75%      { transform: translateX(-2px) rotate(-1deg); }
    }

    @media (max-width: 720px) {
      .choir__bench { grid-template-columns: repeat(6, 1fr); }
      .choir__seat:nth-child(n+13) { display: none; }
    }
    @media (max-width: 600px) {
      .game__hud { grid-template-columns: repeat(2, 1fr); }
      .facts dl { grid-template-columns: 1fr; }
      .facts div { grid-template-columns: 80px 1fr; }
    }
  </style>
</BlockLayout>
