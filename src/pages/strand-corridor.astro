---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CORRIDOR_FACTS, CORRIDOR_META, CORRIDOR_NOTES, FEDERATION_COMMITMENTS, FOUR_CITY_SEGMENTS, NEXT_STEPS, REFERENCES, STRAND_PRINCIPLES, STRAND_RISKS } from '../lib/strandCorridor';
const title = `${CORRIDOR_META.title} — ${CORRIDOR_META.subtitle}`;
const description = CORRIDOR_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/strand-corridor', name: CORRIDOR_META.title, description, url: 'https://pointcast.xyz/strand-corridor', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/strand-corridor.json', title: 'Strand Corridor (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/forkable-radius">forkable-radius</a><span aria-hidden="true">/</span><span>strand-corridor</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{CORRIDOR_META.paperNumber} · FEDERATION SURFACE · 22 MILES · 4 CANDIDATE CITIES</p>
      <h1>THE / STRAND.</h1>
      <p class="subtitle">{CORRIDOR_META.subtitle}</p>
      <p class="thesis">{CORRIDOR_META.thesis}</p>
    </header>

    <section class="facts"><p class="kicker">CORRIDOR FACTS</p><h2>The Marvin Braude Bike Trail.</h2>
      <dl class="snap-dl">
        <div><dt>Formal name</dt><dd>{CORRIDOR_FACTS.formalName}</dd></div>
        <div><dt>Also called</dt><dd>{CORRIDOR_FACTS.alsoCalled}</dd></div>
        <div><dt>Total length</dt><dd>{CORRIDOR_FACTS.totalLength}</dd></div>
        <div><dt>North terminus</dt><dd>{CORRIDOR_FACTS.northTerminus}</dd></div>
        <div><dt>South terminus</dt><dd>{CORRIDOR_FACTS.southTerminus}</dd></div>
        <div><dt>Managing agencies</dt><dd>{CORRIDOR_FACTS.managingAgencies}</dd></div>
        <div><dt>Named for</dt><dd>{CORRIDOR_FACTS.namedFor}</dd></div>
        <div><dt>Built piecemeal</dt><dd>{CORRIDOR_FACTS.builtPiecemeal}</dd></div>
      </dl>
    </section>

    <section class="segments"><p class="kicker">FOUR-CITY SEGMENT MAP · ~7 MI OF 22</p><h2>Where the corridor threads instances.</h2>
      <ol class="seg-list">{FOUR_CITY_SEGMENTS.map((s) => (
        <li>
          <h3>{s.city} <span class="seg__mi">{s.segmentMiles} mi</span></h3>
          <p><strong>Primary access:</strong> {s.primaryAccess}</p>
          <p><strong>Civic hooks:</strong> {s.civicHooks}</p>
          <p><strong>Strand integration:</strong> {s.strandIntegration}</p>
          <p class="seg__instance"><strong>Instance:</strong> {s.uesInstance}</p>
        </li>
      ))}</ol>
    </section>

    <section class="commits"><p class="kicker">FEDERATION COMMITMENTS · 6 CATEGORIES</p><h2>What the four instances share.</h2>
      <ol class="cm-list">{FEDERATION_COMMITMENTS.map((c) => (
        <li><h3>{c.category}</h3><p>{c.detail}</p></li>
      ))}</ol>
    </section>

    <section class="principles"><p class="kicker">STRAND PRINCIPLES · 5</p><h2>Federation operating norms.</h2>
      <ol class="pr-list">{STRAND_PRINCIPLES.map((p, i) => (
        <li><span class="pr__num">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="risks"><p class="kicker">CORRIDOR RISKS · 5</p><h2>What the federation must steward against.</h2>
      <ol class="rk-list">{STRAND_RISKS.map((r) => (
        <li><h3>{r.risk}</h3><p>{r.detail}</p></li>
      ))}</ol>
    </section>

    <section class="next"><p class="kicker">NEXT STEPS · YEAR 1 → YEAR 10</p><h2>The federation calendar.</h2>
      <ol class="nx-list">{NEXT_STEPS.map((n) => (
        <li><h3>{n.step}</h3><p>{n.detail}</p></li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · CORRIDOR CONVENERS</p>
      <p>{CORRIDOR_NOTES.uesNote}</p>
      <p class="invite-cta">{CORRIDOR_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/forkable-radius">The Forkable Radius · framework</a>
      <a href="/manhattan-beach">Manhattan Beach (UES-Fork-MB-01)</a>
      <a href="/hermosa-beach">Hermosa Beach (UES-Fork-HB-02)</a>
      <a href="/mutual-aid-mesh">Mutual Aid Mesh · Shape #3</a>
      <a href="/common-forms">Common Forms · architecture template</a>
      <a href="/strand-corridor.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --sc-ink:#1a1a1a; --sc-paper:#fdf9ee; --sc-mustard:#d4a534; --sc-rust:#b85a3a; --sc-sage:#2d6a3d; --sc-strand:#5b8aa8; --sc-fog:#d8d2c4; --sc-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--sc-paper); color: var(--sc-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--sc-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--sc-strand); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--sc-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--sc-strand); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--sc-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .snap-dl { margin: 0; display: grid; gap: 6px; }
  .snap-dl > div { display: grid; grid-template-columns: 160px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--sc-ink); }
  .snap-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--sc-strand); padding-top: 2px; }
  .snap-dl dd { margin: 0; font-size: 14px; line-height: 1.55; }

  .seg-list, .cm-list, .rk-list, .nx-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .seg-list li, .cm-list li, .rk-list li, .nx-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sc-ink); border-left: 8px solid var(--sc-strand); }
  .seg-list h3, .cm-list h3, .rk-list h3, .nx-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }
  .seg-list p, .cm-list p, .rk-list p, .nx-list p { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .seg__mi { font-family: var(--pc-font-mono); font-size: 11px; color: var(--sc-rust); margin-left: 8px; }
  .seg__instance { padding: 6px 10px; background: var(--sc-paper); border-left: 3px solid var(--sc-mustard); font-size: 12.5px !important; margin-top: 6px !important; }
  strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--sc-strand); margin-right: 4px; }

  .pr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .pr-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--sc-ink); border-left: 6px solid var(--sc-sage); align-items: baseline; }
  .pr__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--sc-strand); }
  .pr-list p { margin: 0; font-size: 13.5px; line-height: 1.55; }

  .rk-list li { border-left-color: var(--sc-rust); }
  .nx-list li { border-left-color: var(--sc-mustard); }

  .invitation { background: var(--sc-strand); color: var(--sc-paper); border-top-color: var(--sc-strand); }
  .invitation .kicker { background: var(--sc-mustard); color: var(--sc-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--sc-mustard); color: var(--sc-ink); border-left: 4px solid var(--sc-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--sc-strand); color: var(--sc-paper); text-decoration: none; }
  .links a:hover { background: var(--sc-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .snap-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .pr-list li { grid-template-columns: 1fr; } }
</style>
