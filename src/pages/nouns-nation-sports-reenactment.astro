---
/**
 * /nouns-nation-sports-reenactment - standalone product site for the
 * local-first sports result reenactment layer inside Nouns Nation Battler.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const productLinks = [
  { label: 'Open Battle Desk', href: '/nouns-nation-battler/' },
  { label: 'TV Cast', href: '/nouns-nation-battler-tv/' },
  { label: 'Mobile Cast', href: '/nouns-nation-battler-mobile/' },
  { label: 'Raw Field', href: '/games/nouns-nation-battler/#mode=tv&type=kingdom' },
  { label: 'Manifest', href: '/nouns-nation-battler.json' },
];

const resultShapes = [
  {
    shape: 'Close finish',
    field: 'Windy kingdom rush',
    line: 'Near-even 30v30 with a small survivor gap and late-lane gust.',
    noun: 12,
  },
  {
    shape: 'Comeback',
    field: 'Garden comeback field',
    line: 'One side starts under pressure, then gets a scheduled morale surge.',
    noun: 33,
  },
  {
    shape: 'Blowout',
    field: 'Lava lane rout',
    line: 'Winner starts with formation and morale advantage; loser fights through heat.',
    noun: 41,
  },
  {
    shape: 'Upset',
    field: 'Auction floor upset',
    line: 'Underdog gets belief spike, faster specials, and a noisy floor.',
    noun: 48,
  },
  {
    shape: 'Overtime',
    field: 'Rift overtime field',
    line: 'Sudden-death 20v20 pressure with higher damage and fast highlights.',
    noun: 56,
  },
];

const products = [
  {
    title: 'Result Reenactor',
    price: 'Prototype',
    desc: 'Type league, winner, loser, score, and result shape. The desk generates a Nouns battle setup, copyable receipt, field modifier, and launch command.',
    deliverables: ['Launch Battle Setup', 'Copy Alt Receipt', 'Local five-result slate'],
  },
  {
    title: 'TV Reenactment Banner',
    price: 'Included',
    desc: 'The live field displays the source result, shape, field, alive count, and guardrail so viewers understand what the battle is translating.',
    deliverables: ['TV-safe lower banner', 'Mobile-safe overlay', 'Snapshot-compatible metadata'],
  },
  {
    title: 'Alt Sports Slate Pack',
    price: 'Packable',
    desc: 'Five prewritten sample results for quick demos: NBA close, WNBA comeback, NFL overtime, MLB blowout, and EPL upset.',
    deliverables: ['One-click launch presets', 'Broadcast-ready examples', 'No API dependency'],
  },
  {
    title: 'Sponsor/Media Kit',
    price: 'Reservation only',
    desc: 'Package a reenactment as a sponsor read, poster concept, social clip brief, or watch-party card without payment processing.',
    deliverables: ['Sponsor card copy', 'Poster prompt', 'Agent task brief'],
  },
  {
    title: 'Agent Scorebook Brief',
    price: 'Agent-ready',
    desc: 'A structured assignment for Claude, ChatGPT, Codex, or cowork agents to turn a result into a recap, headline set, or proof artifact.',
    deliverables: ['Inputs and guardrails', 'Accepted-work path', 'Participant-credit language'],
  },
  {
    title: 'Custom League Skin',
    price: 'Next build',
    desc: 'Bring a league, school, shop, DAO, club, or friend group and map results into Nouns gangs, fields, and recurring broadcast bits.',
    deliverables: ['Custom slate', 'Field naming', 'Recurring show language'],
  },
];

const sampleSlates = [
  { league: 'NBA', result: 'Celtics 112, Knicks 109', shape: 'Close finish', slug: 'close' },
  { league: 'WNBA', result: 'Aces 88, Liberty 84', shape: 'Comeback', slug: 'comeback' },
  { league: 'NFL', result: 'Chiefs 27, Ravens 24', shape: 'Overtime', slug: 'overtime' },
  { league: 'MLB', result: 'Dodgers 11, Padres 3', shape: 'Blowout', slug: 'blowout' },
  { league: 'EPL', result: 'Brighton 2, Arsenal 1', shape: 'Upset', slug: 'upset' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Nouns Nation Sports Reenactment',
  description:
    'A local-first alt-broadcast product that turns typed sports results into Nouns Nation Battler field setups, TV banners, receipts, and sponsor/media products.',
  url: 'https://pointcast.xyz/nouns-nation-sports-reenactment/',
  applicationCategory: 'GameApplication',
  isPartOf: {
    '@type': 'VideoGame',
    name: 'Nouns Nation Battler',
    url: 'https://pointcast.xyz/nouns-nation-battler/',
  },
};
---

<BlockLayout
  title="Nouns Sports Reenactment"
  description="Turn typed sports results into Nouns battle setups, TV banners, receipts, and productized sponsor/media packs. Local-first, informational, no official feed required."
  image="/images/og/nouns-battler-live.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-battler.json', title: 'Nouns Nation Battler manifest' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Reenactment', action: 'link', target: 'https://pointcast.xyz/nouns-nation-sports-reenactment/' },
      { label: 'Battle Desk', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler/' },
      { label: 'TV Cast', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-tv/' },
      { label: 'Sponsor Desk', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-sponsors/' },
    ],
  }}
>
  <main class="reenactment-site">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-battler/">Nouns Nation Battler</a>
      <span aria-hidden="true">/</span>
      <span>Sports Reenactment</span>
    </nav>

    <section class="hero" aria-labelledby="reenact-title">
      <div class="hero__copy">
        <p class="kicker">CH.BTL / SPORTS REENACTMENT MODE</p>
        <h1 id="reenact-title">Turn a box score into a Nouns battle.</h1>
        <p>
          Type a real or imagined sports result, choose the shape of the game, and launch an
          informational Nouns reenactment. It is not an official replay and it does not predict
          anything. It is an alt-broadcast generator: result in, field setup out.
        </p>
        <div class="hero-actions">
          {productLinks.map((link, index) => (
            <a class={index === 0 ? 'primary' : ''} href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
      <div class="hero-card" aria-label="Sample reenactment card">
        <span>Sample launch</span>
        <strong>Celtics survive the Nouns reenactment</strong>
        <p>NBA: Celtics 112, Knicks 109 becomes Tomato Noggles vs Cobalt Frames on Windy kingdom rush.</p>
        <em>Informational alt-broadcast setup. No official data feed, no odds, no betting.</em>
      </div>
    </section>

    <section class="kit" aria-labelledby="kit-title">
      <div class="section-head">
        <p class="kicker">Broadcast Kit Builder</p>
        <h2 id="kit-title">Pick a result shape. Leave with a show package.</h2>
        <p>
          These buttons generate launch links, sponsor copy, and agent briefs for the reenactment desk.
          It stays local-first: no official feed, no checkout, no betting claim.
        </p>
      </div>
      <div class="kit-shell">
        <div class="kit-picker" aria-label="Sample reenactment packages">
          {sampleSlates.map((item, index) => (
            <button
              type="button"
              class={index === 0 ? 'is-active' : ''}
              data-kit-preset={item.slug}
              data-league={item.league}
              data-result={item.result}
              data-shape={item.shape}
            >
              <span>{item.league}</span>
              <strong>{item.shape}</strong>
              <em>{item.result}</em>
            </button>
          ))}
        </div>
        <article class="kit-output" aria-live="polite">
          <span data-kit-field="league">NBA</span>
          <strong data-kit-field="headline">Celtics 112, Knicks 109 becomes a Windy kingdom rush reenactment.</strong>
          <p data-kit-field="brief">
            Launch a close-finish Nouns battle, capture the TV banner, then package the result as a recap,
            sponsor read, poster prompt, and agent scorebook brief.
          </p>
          <div class="kit-actions">
            <a data-kit-field="launch" href="/nouns-nation-battler/#mode=desk&reenact=close">Launch desk</a>
            <button type="button" data-copy-kit>Copy kit</button>
          </div>
          <textarea data-kit-field="copy" readonly>NBA ALT-CAST KIT
Source result: Celtics 112, Knicks 109
Shape: Close finish
Field: Windy kingdom rush
Use: recap, sponsor read, poster prompt, and agent scorebook brief
Guardrail: informational Nouns reenactment, not official replay, odds, or betting.</textarea>
        </article>
      </div>
    </section>

    <section class="loop" aria-labelledby="loop-title">
      <div class="section-head">
        <p class="kicker">Main loop</p>
        <h2 id="loop-title">Host result → generate card → launch field → package output.</h2>
      </div>
      <div class="loop-grid">
        <article><span>01</span><strong>Type the result</strong><p>League, winner, loser, score, and shape.</p></article>
        <article><span>02</span><strong>Map the pressure</strong><p>Close, comeback, blowout, upset, or overtime becomes a field and modifier.</p></article>
        <article><span>03</span><strong>Launch the battle</strong><p>The game picks deterministic Nouns gangs and starts a themed match.</p></article>
        <article><span>04</span><strong>Make the product</strong><p>Copy a receipt, sponsor read, poster prompt, or agent scorebook brief.</p></article>
      </div>
    </section>

    <section class="shapes" aria-labelledby="shape-title">
      <div class="section-head">
        <p class="kicker">Field grammar</p>
        <h2 id="shape-title">Five result shapes, five Nouns broadcast moods.</h2>
      </div>
      <div class="shape-grid">
        {resultShapes.map((item) => (
          <article>
            <img src={`/games/nouns-nation-battler/assets/noun-${item.noun}.svg`} alt="" loading="lazy" />
            <span>{item.shape}</span>
            <strong>{item.field}</strong>
            <p>{item.line}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="products" aria-labelledby="products-title">
      <div class="section-head">
        <p class="kicker">Products</p>
        <h2 id="products-title">What this can become besides a match.</h2>
      </div>
      <div class="product-grid">
        {products.map((product) => (
          <article>
            <div>
              <span>{product.price}</span>
              <strong>{product.title}</strong>
              <p>{product.desc}</p>
            </div>
            <ul>
              {product.deliverables.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="slate" aria-labelledby="slate-title">
      <div>
        <p class="kicker">Demo slate</p>
        <h2 id="slate-title">Five starts for a lunch-screen demo.</h2>
      </div>
      <div class="slate-list">
        {sampleSlates.map((item) => (
          <article>
            <span>{item.league}</span>
            <strong>{item.result}</strong>
            <em>{item.shape}</em>
          </article>
        ))}
      </div>
    </section>

    <section class="guardrails" aria-labelledby="guardrails-title">
      <div>
        <p class="kicker">Guardrails</p>
        <h2 id="guardrails-title">Clear enough to be weird without getting sloppy.</h2>
      </div>
      <ul>
        <li>User-entered results only; no live sports API claim.</li>
        <li>Informational reenactment, not official replay, not odds, not betting.</li>
        <li>The battle is inspired by the result; the sim outcome is not forced.</li>
        <li>Products are reservation, media, and creative packages until a human accepts work.</li>
      </ul>
    </section>
  </main>

  <script>
    const shapeFields = {
      close: 'Windy kingdom rush',
      comeback: 'Garden comeback field',
      overtime: 'Rift overtime field',
      blowout: 'Lava lane rout',
      upset: 'Auction floor upset',
    };

    const kitButtons = Array.from(document.querySelectorAll('[data-kit-preset]'));
    const kitFields = {
      league: document.querySelector('[data-kit-field="league"]'),
      headline: document.querySelector('[data-kit-field="headline"]'),
      brief: document.querySelector('[data-kit-field="brief"]'),
      launch: document.querySelector('[data-kit-field="launch"]'),
      copy: document.querySelector('[data-kit-field="copy"]'),
    };

    function renderKit(button) {
      const slug = button.dataset.kitPreset || 'close';
      const league = button.dataset.league || 'NBA';
      const result = button.dataset.result || 'Celtics 112, Knicks 109';
      const shape = button.dataset.shape || 'Close finish';
      const field = shapeFields[slug] || shapeFields.close;
      const launch = `/nouns-nation-battler/#mode=desk&reenact=${slug}`;
      const copy = `${league} ALT-CAST KIT
Source result: ${result}
Shape: ${shape}
Field: ${field}
Launch: ${new URL(launch, window.location.origin).href}
Use: recap, sponsor read, poster prompt, social clip, and agent scorebook brief
Agent task: turn this source result into a Nouns battle recap with one headline, one poster concept, three proof notes, and the guardrail below.
Guardrail: informational Nouns reenactment, not official replay, odds, prediction, or betting.`;

      kitButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      kitFields.league.textContent = league;
      kitFields.headline.textContent = `${result} becomes a ${field} reenactment.`;
      kitFields.brief.textContent = `Launch a ${shape.toLowerCase()} Nouns battle, capture the TV banner, then package the result as a recap, sponsor read, poster prompt, and agent scorebook brief.`;
      kitFields.launch.href = launch;
      kitFields.copy.value = copy;
    }

    kitButtons.forEach((button) => button.addEventListener('click', () => renderKit(button)));
    document.querySelector('[data-copy-kit]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(kitFields.copy.value);
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = 'Copy kit';
        }, 1400);
      } catch {
        kitFields.copy.focus();
        kitFields.copy.select();
      }
    });
  </script>
</BlockLayout>

<style>
  .reenactment-site {
    --ink: #141414;
    --paper: #fffdf5;
    --muted: #5f5e5a;
    --line: rgba(20, 20, 20, 0.16);
    display: grid;
    gap: 18px;
    color: var(--ink);
  }

  .crumb,
  .kicker,
  .hero-card span,
  .hero-card em,
  .loop-grid span,
  .shape-grid span,
  .product-grid span,
  .slate-list span,
  .slate-list em {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.75rem;
  }

  .crumb a {
    color: inherit;
  }

  .hero,
  .kit,
  .loop,
  .shapes,
  .products,
  .slate,
  .guardrails {
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    gap: 18px;
    align-items: stretch;
    padding: clamp(18px, 4vw, 42px);
    background:
      linear-gradient(135deg, rgba(215, 255, 63, 0.24), transparent 34%),
      linear-gradient(315deg, rgba(54, 119, 224, 0.14), transparent 44%),
      var(--paper);
  }

  .kicker {
    margin: 0 0 8px;
    color: #8a2432;
    font-size: 0.72rem;
    font-weight: 900;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: 0;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 3.8rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .hero__copy,
  .section-head,
  .guardrails > div,
  .slate > div:first-child {
    display: grid;
    gap: 10px;
  }

  .hero__copy > p,
  .section-head + p,
  .guardrails li,
  .product-grid p,
  .shape-grid p,
  .loop-grid p,
  .hero-card p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .hero-actions a {
    border: 2px solid var(--ink);
    background: #fff;
    color: var(--ink);
    padding: 9px 12px;
    font-weight: 900;
    text-decoration: none;
  }

  .hero-actions a.primary {
    background: #d7ff3f;
  }

  .hero-card {
    display: grid;
    align-content: end;
    gap: 10px;
    min-height: 320px;
    border: 3px solid var(--ink);
    background:
      linear-gradient(180deg, rgba(20, 20, 20, 0.1), rgba(20, 20, 20, 0.78)),
      url('/games/nouns-nation-battler/assets/noun-12.svg') center 28px / 190px 190px no-repeat,
      #3677e0;
    color: #fffdf5;
    padding: 16px;
  }

  .hero-card strong {
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    line-height: 0.95;
  }

  .hero-card span {
    color: #d7ff3f;
    font-size: 0.72rem;
  }

  .hero-card em {
    color: #e9eef7;
    font-size: 0.68rem;
    font-style: normal;
  }

  .loop,
  .kit,
  .shapes,
  .products,
  .guardrails {
    padding: clamp(16px, 3vw, 28px);
  }

  .loop-grid,
  .kit-shell,
  .shape-grid,
  .product-grid,
  .slate-list {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .loop-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .loop-grid article,
  .kit-picker button,
  .kit-output,
  .shape-grid article,
  .product-grid article,
  .slate-list article {
    min-width: 0;
    border: 1px solid var(--line);
    background: #fff;
    padding: 14px;
  }

  .loop-grid article,
  .kit-picker button,
  .kit-output,
  .shape-grid article,
  .product-grid article {
    display: grid;
    gap: 8px;
  }

  .loop-grid span,
  .kit-output > span,
  .kit-picker span,
  .kit-picker em,
  .shape-grid span,
  .product-grid span,
  .slate-list span,
  .slate-list em {
    color: #8a2432;
    font-size: 0.66rem;
    font-style: normal;
  }

  .loop-grid strong,
  .kit-output > strong,
  .kit-picker strong,
  .shape-grid strong,
  .product-grid strong,
  .slate-list strong {
    font-size: 1.15rem;
    line-height: 1.05;
  }

  .kit-shell {
    grid-template-columns: minmax(220px, 0.38fr) minmax(0, 1fr);
  }

  .kit-picker {
    display: grid;
    gap: 8px;
  }

  .kit-picker button {
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .kit-picker button.is-active {
    background: #d7ff3f;
    box-shadow: inset 5px 0 0 #8a2432;
  }

  .kit-picker em {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.66rem;
    font-style: normal;
  }

  .kit-output textarea {
    min-height: 180px;
    width: 100%;
    resize: vertical;
    border: 1px solid var(--line);
    background: #15171d;
    color: #fffdf5;
    padding: 12px;
    font: 0.8rem/1.45 var(--pc-font-mono, ui-monospace, monospace);
  }

  .kit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kit-actions a,
  .kit-actions button {
    border: 2px solid var(--ink);
    background: #fff;
    color: var(--ink);
    padding: 9px 12px;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
  }

  .kit-actions a {
    background: #3677e0;
    color: #fff;
  }

  .shape-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .shape-grid img {
    width: 76px;
    height: 76px;
    image-rendering: pixelated;
  }

  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .product-grid article {
    align-content: space-between;
  }

  .product-grid ul,
  .guardrails ul {
    margin: 0;
    padding-left: 18px;
  }

  .product-grid li {
    margin: 4px 0;
    color: var(--muted);
  }

  .slate {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
    gap: 16px;
    padding: clamp(16px, 3vw, 28px);
    background: #15171d;
    color: #fffdf5;
  }

  .slate .kicker,
  .slate-list span,
  .slate-list em {
    color: #d7ff3f;
  }

  .slate-list {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 0;
  }

  .slate-list article {
    border-color: rgba(255, 253, 245, 0.22);
    background: rgba(255, 253, 245, 0.08);
  }

  .guardrails {
    display: grid;
    grid-template-columns: minmax(240px, 0.42fr) minmax(0, 1fr);
    gap: 20px;
  }

  @media (max-width: 980px) {
    .hero,
    .kit,
    .slate,
    .guardrails {
      grid-template-columns: 1fr;
    }

    .loop-grid,
    .kit-shell,
    .shape-grid,
    .product-grid,
    .slate-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .hero,
    .kit,
    .loop,
    .shapes,
    .products,
    .slate,
    .guardrails {
      box-shadow: 4px 4px 0 var(--ink);
    }

    h1 {
      font-size: clamp(2.5rem, 17vw, 4.2rem);
    }

    .loop-grid,
    .kit-shell,
    .shape-grid,
    .product-grid,
    .slate-list {
      grid-template-columns: 1fr;
    }

    .hero-card {
      min-height: 260px;
    }
  }
</style>
