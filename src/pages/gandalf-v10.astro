---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Gandalf V10';
const description = 'A daily breath oracle in the quiet corner of PointCast.';
---

<BaseLayout title={title} description={description}>
  <main class="gandalf-v10" data-room="gandalf-v10">
    <section class="room" aria-labelledby="gandalf-title">
      <p class="sigil" aria-label="sam's sigil">sam</p>

      <div class="oracle-card" aria-live="polite">
        <div class="breath-field" aria-hidden="true">
          <div class="breath-ring"></div>
          <img
            id="daily-noun"
            class="daily-noun"
            src="https://noun.pics/0.svg"
            alt=""
            width="168"
            height="168"
            loading="eager"
          />
        </div>

        <div class="copy">
          <p id="date-line" class="date-line">today</p>
          <h1 id="gandalf-title">Gandalf V10</h1>
          <p id="oracle-line" class="oracle-line">
            The room is still arranging itself.
          </p>
          <p id="seed-line" class="seed-line">noun seed 0</p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const koans = [
        'The door opens slower when it knows you are not in a hurry.',
        'A small light is enough for a room that has decided to listen.',
        'Nothing asks to be solved before the next breath arrives.',
        'The path is not hidden. It is just speaking quietly.',
        'Keep the ember near the window and let the day find it.',
        'The answer may be the chair, the cup, and the unforced pause.',
        'A corner can be a compass if you sit there long enough.',
        'The signal is not louder than the breath that carries it.',
        'The old spell is attention, repeated without ceremony.',
        'Leave one stone unturned so the garden remembers you trusted it.',
        'A room becomes kind when no one is trying to conquer it.',
        'The next thing is already nearby, wearing ordinary clothes.'
      ];

      const dateParts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Los_Angeles',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric'
      }).formatToParts(new Date());

      const year = dateParts.find((part) => part.type === 'year').value;
      const month = dateParts.find((part) => part.type === 'month').value;
      const day = dateParts.find((part) => part.type === 'day').value;
      const key = `${year}-${month}-${day}`;

      const hash = Array.from(key).reduce((acc, char) => {
        return ((acc << 5) + acc + char.charCodeAt(0)) >>> 0;
      }, 5381);

      const seed = hash % 1200;
      const koan = koans[hash % koans.length];

      const noun = document.getElementById('daily-noun');
      const dateLine = document.getElementById('date-line');
      const oracleLine = document.getElementById('oracle-line');
      const seedLine = document.getElementById('seed-line');

      noun.src = `https://noun.pics/${seed}.svg`;
      noun.alt = `Noun seed ${seed}, the daily companion for ${key}`;
      dateLine.textContent = key;
      oracleLine.textContent = koan;
      seedLine.textContent = `noun seed ${seed}`;
    })();
  </script>

  <style>
    :global(body) {
      background: #f3eee4;
    }

    .gandalf-v10 {
      min-height: 100svh;
      color: #24211c;
      background:
        radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.62), transparent 28rem),
        linear-gradient(180deg, #f7f1e7 0%, #ebe0d2 100%);
      font-family: "Departure Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .room {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 2rem 1rem;
      position: relative;
    }

    .sigil {
      position: fixed;
      top: 1rem;
      left: 1rem;
      margin: 0;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(36, 33, 28, 0.48);
    }

    .oracle-card {
      width: min(100%, 34rem);
      display: grid;
      gap: 2rem;
      justify-items: center;
      text-align: center;
    }

    .breath-field {
      width: min(74vw, 18rem);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      position: relative;
    }

    .breath-ring {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(36, 33, 28, 0.22);
      border-radius: 999px;
      animation: breathe 9s ease-in-out infinite;
    }

    .daily-noun {
      width: min(44vw, 10.5rem);
      height: auto;
      image-rendering: pixelated;
      filter: drop-shadow(0 1rem 1.6rem rgba(36, 33, 28, 0.16));
    }

    .copy {
      display: grid;
      gap: 0.85rem;
      justify-items: center;
    }

    .date-line,
    .seed-line {
      margin: 0;
      font-size: 0.76rem;
      color: rgba(36, 33, 28, 0.55);
    }

    h1 {
      margin: 0;
      font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(2.75rem, 14vw, 6rem);
      line-height: 0.92;
      letter-spacing: 0;
    }

    .oracle-line {
      max-width: 25rem;
      margin: 0;
      font-size: clamp(1rem, 3.4vw, 1.18rem);
      line-height: 1.7;
      color: rgba(36, 33, 28, 0.82);
    }

    @keyframes breathe {
      0%,
      100% {
        transform: scale(0.86);
        opacity: 0.28;
      }

      48% {
        transform: scale(1);
        opacity: 0.72;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .breath-ring {
        animation: none;
        transform: scale(0.94);
        opacity: 0.52;
      }
    }
  </style>
</BaseLayout>
