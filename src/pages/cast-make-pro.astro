  }

  .cpro__bar-tab:hover { background: rgba(244,231,200,0.09); color: var(--cpro-text); }
  .cpro__bar-tab--active { border-color: var(--cpro-flame); color: var(--cpro-flame); background: rgba(246,193,94,0.10); }
  .cpro__bar-tab--playing { outline: 2px solid var(--cpro-cream); outline-offset: 1px; }

  .cpro__drum-tools {
    display: flex;
