    color: var(--cpro-text-mute);
    font-family: var(--cpro-display);
    font-weight: 800;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .cpro__slot:hover { border-color: rgba(246,193,94,0.60); color: var(--cpro-text); background: rgba(244,231,200,0.09); }
  .cpro__slot span { width: 6px; height: 6px; border-radius: 50%; background: rgba(244,231,200,0.18); }
  .cpro__slot--filled { color: var(--cpro-flame); border-color: rgba(246,193,94,0.42); }
  .cpro__slot--filled span { background: var(--cpro-flame); }
  .cpro__slot[data-preview]:hover::after {
    content: attr(data-preview);
