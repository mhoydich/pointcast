  .cpro__transport-left { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .cpro__transport-right { display: flex; align-items: center; justify-content: flex-end; gap: 7px; flex-wrap: wrap; }
  .cpro__meter { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
  .cpro__meter-label { font-family: var(--cpro-mono); font-size: 11px; color: var(--cpro-text-mute); letter-spacing: 0.55px; min-width: 64px; }
  .cpro__meter-label span { color: var(--cpro-flame); font-weight: 700; }
  .cpro__progress { width: min(320px, 100%); height: 5px; border-radius: 3px; overflow: hidden; background: rgba(244,231,200,0.12); }
  .cpro__progress-fill { width: 0%; height: 100%; background: var(--cpro-flame); transition: width 0.05s linear; }

  .cpro__slot {
    min-width: 42px;
    min-height: 34px;
