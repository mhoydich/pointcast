  function copyExampleBar(c: Composition, from: number, to: number) {
    for (const lane of LANES) c.drums[lane][to] = [...c.drums[lane][from]];
  }

  function makeExampleFill(c: Composition, bar: number) {
    c.drums.snare[bar] = [0,0,0,1, 3,0,1,0, 0,1,0,2, 3,2,2,1];
    c.drums.kick[bar] = [3,0,0,0, 0,0,0,1, 3,0,0,0, 0,0,3,0];
    c.drums.hat[bar] = [2,1,2,1, 2,1,2,1, 2,1,2,1, 3,2,1,0];
  }

  document.addEventListener('DOMContentLoaded', () => {
    const bpm = document.getElementById('cpro-bpm') as HTMLInputElement | null;
    const swing = document.getElementById('cpro-swing') as HTMLInputElement | null;
    const voicing = document.getElementById('cpro-voicing') as HTMLSelectElement | null;

    bpm?.addEventListener('pointerdown', () => beginSlider('bpm'));
    bpm?.addEventListener('focus', () => beginSlider('bpm'));
    bpm?.addEventListener('input', () => {
      beginSlider('bpm');
      comp.bpm = clamp(bpm.value, 60, 160, 96);
      renderControls();
    });
    bpm?.addEventListener('change', () => commitSlider('bpm'));
    bpm?.addEventListener('blur', () => commitSlider('bpm'));

    swing?.addEventListener('pointerdown', () => beginSlider('swing'));
    swing?.addEventListener('focus', () => beginSlider('swing'));
    swing?.addEventListener('input', () => {
      beginSlider('swing');
      comp.swing = clamp(swing.value, 0, 66, 50);
      renderControls();
    });
    swing?.addEventListener('change', () => commitSlider('swing'));
    swing?.addEventListener('blur', () => commitSlider('swing'));

    voicing?.addEventListener('change', () => commitChange(() => { comp.voicing = voicing.value as Voicing; }, 'Pad voicing changed'));

    document.getElementById('cpro-copy-first-four')?.addEventListener('click', () => commitChange(() => {
      copyDrumBar(0, 1); copyDrumBar(0, 2); copyDrumBar(0, 3);
    }, 'Copied bar 1 to bars 2-4'));

    document.getElementById('cpro-copy-active-all')?.addEventListener('click', () => commitChange(() => {
      for (let bar = 0; bar < BAR_COUNT; bar++) if (bar !== activeBar) copyDrumBar(activeBar, bar);
    }, `Copied bar ${activeBar + 1} to all bars`));

    document.getElementById('cpro-clear-active')?.addEventListener('click', () => commitChange(() => {
      for (const lane of LANES) comp.drums[lane][activeBar] = Array(STEP_COUNT).fill(0);
    }, `Cleared bar ${activeBar + 1}`));

    document.getElementById('cpro-fill-active')?.addEventListener('click', () => commitChange(() => {
      makeFill(activeBar);
    }, `Made bar ${activeBar + 1} a fill`));

    document.getElementById('cpro-play')?.addEventListener('click', () => { if (playing) stop(); else playOnce(); });
    document.getElementById('cpro-clear')?.addEventListener('click', () => {
      if (confirm('Reset the pro composition?')) commitChange(() => { comp = cloneComp(DEFAULT_COMP); activeBar = 0; }, 'Reset to default');
    });
    document.getElementById('cpro-share')?.addEventListener('click', share);
    document.getElementById('cpro-export')?.addEventListener('click', exportStems);
    document.getElementById('cpro-undo')?.addEventListener('click', undo);
    document.getElementById('cpro-redo')?.addEventListener('click', redo);
    document.querySelectorAll<HTMLButtonElement>('[data-save-slot]').forEach(btn => bindSlot(btn, Number(btn.dataset.saveSlot)));
    document.addEventListener('pointerup', finishDrumPaint);
    document.addEventListener('pointercancel', finishDrumPaint);

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const tag = target?.tagName;
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) redo(); else undo();
        return;
      }
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA' || tag === 'BUTTON') return;
      if (e.code === 'Space') {
        e.preventDefault();
        if (playing) stop(); else playOnce();
      }
    });

    if (!loadFromHash()) renderAll();
  });
</script>
</BlockLayout>
