  .cpro__chord-bar-name { font-family: var(--cpro-display); font-size: clamp(22px, 3.2vw, 36px); font-weight: 800; line-height: 1; }
  .cpro__chord-bar-role { font-family: var(--cpro-mono); font-size: 9px; color: rgba(255,255,255,0.58); letter-spacing: 0.3px; min-height: 12px; }

  .cpro__bar-tabs {
    display: grid;
