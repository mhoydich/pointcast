    padding: 12px 16px;
    font-family: var(--cpro-body);
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0,0,0,0.55);
    animation: cpro-toast-in 0.26s ease;
  }

  .cpro__toast--out { animation: cpro-toast-out 0.22s ease forwards; }
  @keyframes cpro-toast-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes cpro-toast-out { to { opacity: 0; transform: translateX(24px); } }

  @media (max-width: 1040px) {
    .cpro__top { grid-template-columns: 1fr; }
    .cpro__top-actions { justify-content: flex-start; }
    .cpro__map,
    .cpro__chord-strip,
    .cpro__lead-grid { grid-template-columns: repeat(4, 1fr); }
    .cpro__kit-row { grid-template-columns: repeat(3, 1fr); }
    .cpro__lead-preview { grid-template-columns: repeat(3, 1fr); }
    .cpro__control-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .cpro { padding: 22px 14px 178px 14px; }
    .cpro__examples-row,
    .cpro__kit-row,
    .cpro__map,
    .cpro__chord-strip,
    .cpro__lead-grid,
    .cpro__lead-preview { grid-template-columns: repeat(2, 1fr); }
    .cpro__map-bar { min-height: 116px; }
    .cpro__bar-tabs { grid-template-columns: repeat(4, 1fr); }
    .cpro__range { grid-template-columns: 52px 1fr 56px; }
    .cpro__drum-row { grid-template-columns: 52px 1fr; }
    .cpro__beats-mark { grid-template-columns: 52px repeat(16, minmax(0, 1fr)); }
    .cpro__transport { grid-template-columns: 1fr; padding: 10px 12px; }
    .cpro__transport-left { align-items: stretch; }
    .cpro__transport-right { justify-content: center; }
    .cpro__slot { min-width: 36px; }
  }

  @media (max-width: 460px) {
    .cpro__examples-row,
    .cpro__kit-row { grid-template-columns: 1fr; }
    .cpro__map,
    .cpro__chord-strip,
    .cpro__lead-grid { grid-template-columns: repeat(2, 1fr); }
    .cpro__lead-preview { grid-template-columns: 1fr; }
    .cpro__drum-cells { gap: 2px; }
    .cpro__beats-mark { gap: 2px; }
  }
</style>

<script>
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';

  const BAR_COUNT = 8;
  const STEP_COUNT = 16;
  const MAX_HISTORY = 30;
  const VELOCITY_GAIN = [0, 0.3, 0.6, 1.0] as const;

  type KitId = 'fog' | 'block' | 'brass' | 'friday' | 'arcade' | 'harbor';
  type Lane = 'kick' | 'snare' | 'hat';
  type Voicing = 'triad' | 'wide' | 'drone';
  type StemName = 'master' | 'kick' | 'snare' | 'hat' | 'lead' | 'pad';
  type ChordSlot = 'I' | 'ii' | 'IV' | 'V' | 'vi' | 'bVII' | 'I6' | 'Vsus';
  type LeadId = 'silent' | 'arp' | 'phrase' | 'horn' | 'steps' | 'spark';
  type LeadChoice = LeadId | 'inherit';

  interface Kit {
    id: KitId;
    name: string;
    nounId: number;
    color: string;
    tag: string;
    keyRootHz: number;
    drumStyle: 'soft' | 'punch' | 'gloss';
  }

  interface LeadEvent { d: number; on: number; hold?: number }
  interface LeadShape { id: LeadId; name: string; tag: string; pattern: LeadEvent[] }
  interface Composition {
    kit: KitId;
    bpm: number;
    swing: number;
    voicing: Voicing;
    chords: ChordSlot[];
    drums: Record<Lane, number[][]>;
    leads: LeadChoice[];
  }

  interface Voice {
    ctx: BaseAudioContext;
    dest: AudioNode;
    track: (node: AudioScheduledSourceNode) => void;
  }

  const LANES: Lane[] = ['kick', 'snare', 'hat'];
  const STEMS: StemName[] = ['master', 'kick', 'snare', 'hat', 'lead', 'pad'];

  const KITS: Kit[] = [
    { id: 'fog',    name: 'Marine Layer',  nounId: 313, color: '#9ed6f0', tag: 'soft · choir · C',    keyRootHz: 130.81, drumStyle: 'soft' },
    { id: 'block',  name: 'Block Runner',  nounId: 523, color: '#a8ff3a', tag: 'punch · square · D',  keyRootHz: 146.83, drumStyle: 'punch' },
    { id: 'brass',  name: 'Brass on Main', nounId: 287, color: '#f6c15e', tag: 'horn · parade · C',   keyRootHz: 130.81, drumStyle: 'punch' },
    { id: 'friday', name: 'Friday Five',   nounId: 612, color: '#ff5f7a', tag: 'loud · square · E',   keyRootHz: 164.81, drumStyle: 'punch' },
    { id: 'arcade', name: 'Arcade Desk',   nounId: 777, color: '#ffd400', tag: 'bit · glass · G',     keyRootHz: 196.00, drumStyle: 'gloss' },
    { id: 'harbor', name: 'Harbor Lights', nounId: 415, color: '#53e0c2', tag: 'wide · bell · A',     keyRootHz: 220.00, drumStyle: 'soft' },
  ];

  const CHORD_CYCLE: ChordSlot[] = ['I', 'ii', 'IV', 'V', 'vi', 'bVII', 'I6', 'Vsus'];
  const CHORD_DEFS: Record<ChordSlot, { offset: number; intervals: number[]; role: string }> = {
    I:    { offset: 0,  intervals: [0, 4, 7], role: 'home' },
    ii:   { offset: 2,  intervals: [0, 3, 7], role: 'lift' },
    IV:   { offset: 5,  intervals: [0, 4, 7], role: 'open' },
    V:    { offset: 7,  intervals: [0, 4, 7], role: 'turn' },
    vi:   { offset: 9,  intervals: [0, 3, 7], role: 'minor' },
    bVII: { offset: 10, intervals: [0, 4, 7], role: 'wide' },
    I6:   { offset: 0,  intervals: [0, 4, 7, 9], role: 'sweet' },
    Vsus: { offset: 7,  intervals: [0, 5, 7], role: 'held' },
  };

  const LEAD_SHAPES: LeadShape[] = [
    { id: 'silent', name: 'No lead', tag: 'drums + pads only',
      pattern: Array.from({ length: STEP_COUNT }, () => ({ d: 0, on: 0 })) },
    { id: 'arp', name: 'Arpeggio', tag: 'eighth-note climb',
      pattern: [
        { d:0,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },
        { d:2,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },
        { d:0,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },
        { d:2,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },
      ] },
    { id: 'phrase', name: 'Phrase', tag: 'four-note melody',
      pattern: [
        { d:0,on:1,hold:2 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:1,on:1,hold:2 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:2,on:1,hold:2 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:1,on:1,hold:2 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
      ] },
    { id: 'horn', name: 'Horn hit', tag: 'two long answers',
      pattern: [
        { d:0,on:1,hold:5 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:2,on:1,hold:5 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
        { d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },{ d:0,on:0 },
      ] },
    { id: 'steps', name: 'Steps', tag: 'syncopated run',
      pattern: [
        { d:0,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:2,on:1 },
        { d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },{ d:2,on:1 },
        { d:1,on:1 },{ d:0,on:0 },{ d:2,on:1 },{ d:1,on:0 },
        { d:0,on:1 },{ d:0,on:0 },{ d:1,on:1 },{ d:2,on:1 },
      ] },
    { id: 'spark', name: 'Spark', tag: 'off-beat chips',
      pattern: [
        { d:0,on:0 },{ d:2,on:1 },{ d:0,on:0 },{ d:1,on:1 },
        { d:0,on:0 },{ d:2,on:1 },{ d:0,on:0 },{ d:0,on:0 },
        { d:0,on:0 },{ d:1,on:1 },{ d:0,on:0 },{ d:2,on:1 },
        { d:0,on:0 },{ d:1,on:1 },{ d:2,on:1 },{ d:0,on:0 },
      ] },
  ];

  const bar0Kick  = [3,0,0,0, 0,0,1,0, 3,0,0,0, 0,1,0,0];
  const bar0Snare = [0,0,0,0, 3,0,0,0, 0,0,0,0, 3,0,0,0];
  const bar0Hat   = [2,0,1,0, 2,0,1,0, 2,0,1,0, 2,0,1,0];

  const DEFAULT_COMP: Composition = {
    kit: 'fog',
    bpm: 96,
    swing: 50,
    voicing: 'triad',
    chords: ['I', 'V', 'vi', 'IV', 'I', 'IV', 'V', 'I'],
    drums: makeDefaultDrums(),
    leads: ['arp', 'inherit', 'inherit', 'phrase', 'inherit', 'spark', 'horn', 'inherit'],
  };

  let comp: Composition = cloneComp(DEFAULT_COMP);
  let activeBar = 0;
  let currentPlaybackBar = -1;
  let ctx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let sched: AudioScheduler | null = null;
  let playing = false;
  let playStartCtxTime = 0;
  let rafId = 0;
  let toastHide: number | null = null;
  let undoStack: Composition[] = [];
  let redoStack: Composition[] = [];
  let sliderSnapshots = new Map<string, Composition>();
  let paintSnapshot: Composition | null = null;
  let paintVelocity: number | null = null;
  let paintChanged = false;

  function makeDefaultDrums(): Record<Lane, number[][]> {
    const drums = blankDrums();
    for (let bar = 0; bar < BAR_COUNT; bar++) {
      drums.kick[bar] = [...bar0Kick];
      drums.snare[bar] = [...bar0Snare];
      drums.hat[bar] = [...bar0Hat];
    }
    drums.kick[4] = [3,0,0,0, 2,0,0,0, 3,0,0,0, 2,0,0,0];
    drums.hat[5] = [2,1,2,1, 2,1,2,1, 2,1,2,1, 2,1,2,1];
    drums.snare[6] = [0,0,0,1, 3,0,1,0, 0,1,0,2, 3,2,2,1];
    drums.kick[7] = [3,0,0,0, 0,0,0,0, 2,0,0,0, 0,0,3,0];
    drums.snare[7] = [0,0,0,0, 3,0,0,0, 0,0,0,2, 3,0,0,0];
    return drums;
  }

  function blankDrums(): Record<Lane, number[][]> {
    return {
      kick: Array.from({ length: BAR_COUNT }, () => Array(STEP_COUNT).fill(0)),
      snare: Array.from({ length: BAR_COUNT }, () => Array(STEP_COUNT).fill(0)),
      hat: Array.from({ length: BAR_COUNT }, () => Array(STEP_COUNT).fill(0)),
    };
  }

  function cloneComp(c: Composition): Composition {
    return JSON.parse(JSON.stringify(c));
  }

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterGain = ctx.createGain();
    masterGain.gain.value = 0.72;
    masterGain.connect(ctx.destination);
    sched = createAudioScheduler(ctx);
    return ctx;
  }

  function liveVoice(): Voice {
    ac();
    return { ctx: ctx!, dest: masterGain!, track: (node) => sched!.trackSource(node) };
  }

  function semitone(hz: number, semi: number): number {
    return hz * Math.pow(2, semi / 12);
  }

  function chordTriadHzs(slot: ChordSlot, kit: Kit): number[] {
    const def = CHORD_DEFS[slot];
    const root = semitone(kit.keyRootHz, def.offset);
    const triad = slot === 'I6' ? [0, 4, 7] : def.intervals.slice(0, 3);
    return triad.map((semi) => semitone(root, semi));
  }

  function chordToHzs(slot: ChordSlot, kit: Kit, voicing: Voicing): number[] {
    const def = CHORD_DEFS[slot];
    const root = semitone(kit.keyRootHz, def.offset);
    if (voicing === 'drone') return [root * 0.5, semitone(root, 7)];
    if (voicing === 'wide') {
      const third = def.intervals.includes(3) ? 3 : def.intervals.includes(5) ? 5 : 4;
      return [root * 0.5, semitone(root, 7), root, semitone(root, 12 + third)];
    }
    return def.intervals.map((semi) => semitone(root, semi));
  }

  function gainForVelocity(level: number, max: number): number {
    return max * VELOCITY_GAIN[Math.max(0, Math.min(3, level))];
  }

  function seeded(seed: number): () => number {
    let t = seed >>> 0;
    return () => {
      t += 0x6D2B79F5;
      let r = Math.imul(t ^ (t >>> 15), 1 | t);
      r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
      return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
    };
  }

  function playKick(v: Voice, when: number, style: Kit['drumStyle'], velocity: number) {
    const c = v.ctx;
    const o = c.createOscillator();
    const g = c.createGain();
    const peak = style === 'soft' ? 98 : style === 'gloss' ? 118 : 132;
    const tail = style === 'soft' ? 46 : 36;
    const len = style === 'soft' ? 0.34 : 0.42;
    o.type = style === 'gloss' ? 'triangle' : 'sine';
    o.frequency.setValueAtTime(peak, when);
    o.frequency.exponentialRampToValueAtTime(tail, when + len * 0.55);
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(gainForVelocity(velocity, style === 'soft' ? 0.74 : 1.0), when + 0.006);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    o.connect(g);
    g.connect(v.dest);
    v.track(o);
    o.start(when);
    o.stop(when + len + 0.05);
  }

  function playSnare(v: Voice, when: number, style: Kit['drumStyle'], velocity: number, seed: number) {
    const c = v.ctx;
    const len = style === 'soft' ? 0.26 : 0.19;
    const noiseLen = Math.floor(c.sampleRate * len);
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    const rand = seeded(seed);
    for (let i = 0; i < noiseLen; i++) d[i] = (rand() * 2 - 1) * Math.pow(1 - i / noiseLen, style === 'soft' ? 1.0 : 1.65);
    const s = c.createBufferSource();
    const f = c.createBiquadFilter();
    const g = c.createGain();
    s.buffer = buf;
    f.type = style === 'soft' ? 'highpass' : 'bandpass';
    f.frequency.value = style === 'gloss' ? 2600 : style === 'soft' ? 800 : 2200;
    f.Q.value = style === 'soft' ? 0.8 : 1.6;
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(gainForVelocity(velocity, style === 'soft' ? 0.34 : 0.54), when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    s.connect(f);
    f.connect(g);
    g.connect(v.dest);
    v.track(s);
    s.start(when);
    s.stop(when + len + 0.05);
  }

  function playHat(v: Voice, when: number, style: Kit['drumStyle'], velocity: number, seed: number) {
    const c = v.ctx;
    const len = style === 'gloss' ? 0.07 : 0.052;
    const noiseLen = Math.floor(c.sampleRate * len);
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    const rand = seeded(seed);
    for (let i = 0; i < noiseLen; i++) d[i] = (rand() * 2 - 1) * Math.pow(1 - i / noiseLen, 0.62);
    const s = c.createBufferSource();
    const f = c.createBiquadFilter();
    const g = c.createGain();
    s.buffer = buf;
    f.type = 'highpass';
    f.frequency.value = style === 'soft' ? 6500 : 7600;
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(gainForVelocity(velocity, style === 'soft' ? 0.13 : 0.16), when + 0.002);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    s.connect(f);
    f.connect(g);
    g.connect(v.dest);
    v.track(s);
    s.start(when);
    s.stop(when + len + 0.05);
  }

  function playPad(v: Voice, when: number, freqs: number[], dur: number, kit: Kit, voicing: Voicing) {
    const c = v.ctx;
    const warm = kit.drumStyle === 'soft';
    freqs.forEach((freq, i) => {
      const o = c.createOscillator();
      const g = c.createGain();
      const p = typeof c.createStereoPanner === 'function' ? c.createStereoPanner() : null;
      o.type = warm ? 'sine' : voicing === 'drone' ? 'triangle' : 'triangle';
      o.frequency.value = freq;
      if (p) p.pan.value = freqs.length === 1 ? 0 : -0.34 + (0.68 * i) / Math.max(1, freqs.length - 1);
      g.gain.setValueAtTime(0.001, when);
      g.gain.linearRampToValueAtTime((voicing === 'drone' ? 0.13 : 0.11) / Math.max(1, freqs.length), when + 0.30);
      g.gain.linearRampToValueAtTime(0.001, when + dur - 0.05);
      o.connect(g);
      if (p) { g.connect(p); p.connect(v.dest); }
      else g.connect(v.dest);
      v.track(o);
      o.start(when);
      o.stop(when + dur + 0.05);
    });
  }

  function playLead(v: Voice, when: number, freq: number, dur: number, kit: Kit, velocity = 1) {
    const c = v.ctx;
    const o = c.createOscillator();
    const g = c.createGain();
    const f = c.createBiquadFilter();
    if (kit.id === 'brass') {
      const f2 = c.createBiquadFilter();
      o.type = 'sawtooth';
      o.frequency.value = freq;
      f.type = 'lowpass';
      f.frequency.value = 2200;
      f.Q.value = 1.2;
      f2.type = 'peaking';
      f2.frequency.value = 1100;
      f2.Q.value = 4;
      f2.gain.value = 6;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.20 * velocity, when + 0.035);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      o.connect(f);
      f.connect(f2);
      f2.connect(g);
      g.connect(v.dest);
    } else if (kit.id === 'block' || kit.id === 'friday' || kit.id === 'arcade') {
      o.type = kit.id === 'arcade' ? 'sawtooth' : 'square';
      o.frequency.value = freq;
      f.type = 'lowpass';
      f.frequency.setValueAtTime(420, when);
      f.frequency.exponentialRampToValueAtTime(2600, when + 0.04);
      f.frequency.exponentialRampToValueAtTime(760, when + dur);
      f.Q.value = kit.id === 'arcade' ? 7 : 4;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.18 * velocity, when + 0.006);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      o.connect(f);
      f.connect(g);
      g.connect(v.dest);
    } else {
      o.type = kit.id === 'harbor' ? 'sine' : 'triangle';
      o.frequency.value = freq;
      f.type = 'lowpass';
      f.frequency.value = kit.id === 'harbor' ? 3400 : 2400;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.16 * velocity, when + 0.018);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      o.connect(f);
      f.connect(g);
      g.connect(v.dest);
    }
    v.track(o);
    o.start(when);
    o.stop(when + dur + 0.05);
  }

  function stemAllows(stem: StemName, lane: StemName): boolean {
    return stem === 'master' || stem === lane;
  }

  function swingOffset(stepIndex: number, step: number, swing: number): number {
    if (stepIndex % 2 === 0) return 0;
    return step * ((swing - 50) / 50) * step * 0.3;
  }

  function scheduleComposition(v: Voice, c: Composition, start: number, stem: StemName = 'master') {
    const kit = KITS.find(k => k.id === c.kit) || KITS[0];
    const beat = 60 / c.bpm;
    const step = beat / 4;
    for (let bar = 0; bar < BAR_COUNT; bar++) {
      const barStart = start + bar * 4 * beat;
      const chordSlot = c.chords[bar] || 'I';
      const padHzs = chordToHzs(chordSlot, kit, c.voicing);
      const leadHzs = chordTriadHzs(chordSlot, kit);
      if (stemAllows(stem, 'pad')) playPad(v, barStart, padHzs, 4 * beat * 0.96, kit, c.voicing);
      const lead = resolveLeadShape(c, bar);
      for (let i = 0; i < STEP_COUNT; i++) {
        const t = barStart + i * step + swingOffset(i, step, c.swing);
        const seedBase = 2000 + bar * 257 + i * 17;
        if (stemAllows(stem, 'kick') && c.drums.kick[bar]?.[i] > 0) playKick(v, t, kit.drumStyle, c.drums.kick[bar][i]);
        if (stemAllows(stem, 'snare') && c.drums.snare[bar]?.[i] > 0) playSnare(v, t, kit.drumStyle, c.drums.snare[bar][i], seedBase + 11);
        if (stemAllows(stem, 'hat') && c.drums.hat[bar]?.[i] > 0) playHat(v, t, kit.drumStyle, c.drums.hat[bar][i], seedBase + 23);
        const ev = lead.pattern[i];
        if (stemAllows(stem, 'lead') && ev?.on) {
          const hz = leadHzs[Math.min(ev.d, leadHzs.length - 1)] * 2;
          const hold = Math.max(1, ev.hold || 1.55);
          playLead(v, t, hz, step * hold, kit, lead.id === 'spark' ? 0.78 : 1);
        }
      }
    }
  }

  function songSec(c: Composition): number {
    return (60 / c.bpm) * 4 * BAR_COUNT;
  }

  function playOnce() {
    const c = ac();
    if (c.state === 'suspended') c.resume();
    if (sched) sched.stopAll();
    cancelAnimationFrame(rafId);
    const start = c.currentTime + 0.05;
    playStartCtxTime = start;
    scheduleComposition(liveVoice(), comp, start, 'master');
    sched!.schedule(() => playOnce(), start + songSec(comp));
    playing = true;
    setPlayBtn(true);
    runProgress();
  }

  function stop() {
    if (sched) sched.stopAll();
    cancelAnimationFrame(rafId);
    playing = false;
    currentPlaybackBar = -1;
    setPlayBtn(false);
    setCurrentBar('—');
    const fill = document.getElementById('cpro-progress') as HTMLDivElement | null;
    if (fill) fill.style.width = '0%';
    document.querySelectorAll('.cpro__chord-bar--playing, .cpro__bar-tab--playing, .cpro__map-bar--playing').forEach(el => el.classList.remove('cpro__chord-bar--playing', 'cpro__bar-tab--playing', 'cpro__map-bar--playing'));
    document.querySelectorAll('.cpro__drum-cell--cur').forEach(el => el.classList.remove('cpro__drum-cell--cur'));
  }

  function setPlayBtn(on: boolean) {
    const ic = document.getElementById('cpro-play-icon');
    const lb = document.getElementById('cpro-play-label');
    if (ic) ic.textContent = on ? '◼' : '▶';
    if (lb) lb.textContent = on ? 'STOP' : 'PLAY';
  }

  function setCurrentBar(s: string) {
    const el = document.getElementById('cpro-current-bar');
    if (el) el.textContent = s;
  }

  function runProgress() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!ctx || !playing) return;
      const elapsed = Math.max(0, ctx.currentTime - playStartCtxTime);
      const dur = songSec(comp);
      const pct = Math.max(0, Math.min(1, elapsed / dur));
      const fill = document.getElementById('cpro-progress') as HTMLDivElement | null;
      if (fill) fill.style.width = `${pct * 100}%`;
      const step = (60 / comp.bpm) / 4;
      const totalSteps = Math.max(0, Math.floor(elapsed / step));
      const bar = Math.min(BAR_COUNT - 1, Math.floor(totalSteps / STEP_COUNT));
      const inBarStep = totalSteps % STEP_COUNT;
      if (bar !== currentPlaybackBar) {
        currentPlaybackBar = bar;
        setCurrentBar(String(bar + 1));
        renderPlaybackHighlights(inBarStep);
      } else {
        renderStepHighlight(inBarStep);
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  function renderPlaybackHighlights(step = -1) {
    document.querySelectorAll<HTMLButtonElement>('.cpro__chord-bar').forEach((el, i) => el.classList.toggle('cpro__chord-bar--playing', i === currentPlaybackBar));
    document.querySelectorAll<HTMLButtonElement>('.cpro__bar-tab').forEach((el, i) => el.classList.toggle('cpro__bar-tab--playing', i === currentPlaybackBar));
    document.querySelectorAll<HTMLButtonElement>('.cpro__map-bar').forEach((el, i) => el.classList.toggle('cpro__map-bar--playing', i === currentPlaybackBar));
    renderStepHighlight(step);
  }

  function renderStepHighlight(step: number) {
    document.querySelectorAll<HTMLButtonElement>('.cpro__drum-cell').forEach((el) => {
      const cellStep = Number(el.dataset.step);
      el.classList.toggle('cpro__drum-cell--cur', activeBar === currentPlaybackBar && cellStep === step);
    });
  }

  function renderKits() {
    const wrap = document.getElementById('cpro-kit-row');
    if (!wrap) return;
    wrap.innerHTML = KITS.map(k => `
      <button class="cpro__kit ${comp.kit === k.id ? 'cpro__kit--active' : ''}" data-kit="${k.id}" type="button" style="--kit-c: ${k.color};">
        <span class="cpro__kit-portrait"><img src="https://noun.pics/${k.nounId}.svg" alt="${k.name}"/></span>
        <span class="cpro__kit-name">${k.name}</span>
        <span class="cpro__kit-tag">${k.tag}</span>
      </button>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-kit]').forEach(btn => {
      btn.addEventListener('click', () => commitChange(() => { comp.kit = btn.dataset.kit as KitId; }, 'Kit changed'));
    });
    const kit = KITS.find(k => k.id === comp.kit) || KITS[0];
    const nounBadge = document.getElementById('cpro-noun-badge') as HTMLDivElement | null;
    const nounImg = document.getElementById('cpro-noun-img') as HTMLImageElement | null;
    const nounName = document.getElementById('cpro-noun-name');
    if (nounBadge) nounBadge.style.setProperty('--kit-c', kit.color);
    if (nounImg) nounImg.src = `https://noun.pics/${kit.nounId}.svg`;
    if (nounName) nounName.textContent = kit.name;
  }

  function renderControls() {
    const bpm = document.getElementById('cpro-bpm') as HTMLInputElement | null;
    const bpmVal = document.getElementById('cpro-bpm-val');
    const swing = document.getElementById('cpro-swing') as HTMLInputElement | null;
    const swingVal = document.getElementById('cpro-swing-val');
    const voicing = document.getElementById('cpro-voicing') as HTMLSelectElement | null;
    const hint = document.getElementById('cpro-tempo-hint');
    if (bpm) bpm.value = String(comp.bpm);
    if (bpmVal) bpmVal.textContent = String(comp.bpm);
    if (swing) swing.value = String(comp.swing);
    if (swingVal) swingVal.textContent = `${comp.swing}%`;
    if (voicing) voicing.value = comp.voicing;
    const pocket = comp.swing < 45 ? 'pushed 16ths' : comp.swing === 50 ? 'straight 16ths' : comp.swing < 58 ? 'light shuffle' : 'deep shuffle';
    if (hint) hint.textContent = `${comp.bpm} BPM · ${pocket} · ${comp.voicing} pads.`;
  }

  function renderChords() {
    const wrap = document.getElementById('cpro-chord-strip');
    if (!wrap) return;
    const kit = KITS.find(k => k.id === comp.kit) || KITS[0];
    wrap.innerHTML = comp.chords.map((slot, i) => `
      <button class="cpro__chord-bar ${i === activeBar ? 'cpro__chord-bar--selected' : ''} ${i === currentPlaybackBar ? 'cpro__chord-bar--playing' : ''}" data-chord-bar="${i}" type="button" style="--cb: ${kit.color};">
        <span class="cpro__chord-bar-num">BAR ${i + 1}</span>
        <span class="cpro__chord-bar-name">${slot}</span>
        <span class="cpro__chord-bar-role">${CHORD_DEFS[slot].role}</span>
      </button>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-chord-bar]').forEach(btn => {
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.chordBar);
        commitChange(() => {
          activeBar = i;
          const cur = comp.chords[i];
          comp.chords[i] = CHORD_CYCLE[(CHORD_CYCLE.indexOf(cur) + 1) % CHORD_CYCLE.length];
        }, 'Chord changed');
      });
    });
  }

  function renderBarTabs() {
    const wrap = document.getElementById('cpro-bar-tabs');
    if (!wrap) return;
    wrap.innerHTML = Array.from({ length: BAR_COUNT }, (_, i) => `
      <button class="cpro__bar-tab ${i === activeBar ? 'cpro__bar-tab--active' : ''} ${i === currentPlaybackBar ? 'cpro__bar-tab--playing' : ''}" data-active-bar="${i}" type="button">bar ${i + 1}</button>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-active-bar]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeBar = Number(btn.dataset.activeBar);
        renderChords();
        renderBarTabs();
        renderDrums();
        renderMap();
        renderLeadGrid();
      });
    });
  }

  function renderDrums() {
    document.querySelectorAll<HTMLDivElement>('.cpro__drum-row').forEach(row => {
      const lane = row.dataset.lane as Lane;
      const cells = row.querySelector('.cpro__drum-cells') as HTMLDivElement | null;
      if (!cells) return;
      cells.innerHTML = '';
      for (let i = 0; i < STEP_COUNT; i++) {
        const level = comp.drums[lane][activeBar][i] || 0;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cpro__drum-cell';
        btn.dataset.lane = lane;
        btn.dataset.step = String(i);
        btn.dataset.vel = String(level);
        btn.setAttribute('aria-label', `${lane} bar ${activeBar + 1} step ${i + 1} velocity ${level}`);
        btn.innerHTML = '<span class="cpro__drum-fill"></span>';
        btn.addEventListener('pointerdown', (e) => startDrumPaint(e, btn));
        btn.addEventListener('pointerenter', () => continueDrumPaint(btn));
        cells.appendChild(btn);
      }
    });
    renderStepHighlight(currentPlaybackBar === activeBar ? -1 : -2);
  }

  function startDrumPaint(e: PointerEvent, btn: HTMLButtonElement) {
    e.preventDefault();
    const lane = btn.dataset.lane as Lane;
    const step = Number(btn.dataset.step);
    paintSnapshot = cloneComp(comp);
    paintChanged = false;
    const cur = comp.drums[lane][activeBar][step] || 0;
    paintVelocity = e.shiftKey ? (cur + 3) % 4 : (cur + 1) % 4;
    applyDrumVelocity(btn, paintVelocity);
  }

  function continueDrumPaint(btn: HTMLButtonElement) {
    if (!paintSnapshot || paintVelocity == null) return;
    applyDrumVelocity(btn, paintVelocity);
  }

  function finishDrumPaint() {
    if (!paintSnapshot) return;
    if (paintChanged && !sameComp(paintSnapshot, comp)) {
      pushUndoSnapshot(paintSnapshot);
      renderMap();
      restartIfPlaying();
    }
    paintSnapshot = null;
    paintVelocity = null;
    paintChanged = false;
  }

  function applyDrumVelocity(btn: HTMLButtonElement, velocity: number) {
    const lane = btn.dataset.lane as Lane;
    const step = Number(btn.dataset.step);
    const current = comp.drums[lane][activeBar][step] || 0;
    if (current === velocity) return;
    comp.drums[lane][activeBar][step] = velocity;
    paintChanged = true;
    btn.dataset.vel = String(velocity);
    btn.setAttribute('aria-label', `${lane} bar ${activeBar + 1} step ${step + 1} velocity ${velocity}`);
    renderMap();
  }

  function renderLeadGrid() {
    const wrap = document.getElementById('cpro-lead-grid');
    if (!wrap) return;
    wrap.innerHTML = Array.from({ length: BAR_COUNT }, (_, i) => {
      const current = comp.leads[i] || 'inherit';
      const resolved = resolveLeadShape(comp, i);
      const options = [
        `<option value="inherit" ${current === 'inherit' ? 'selected' : ''}>inherit</option>`,
        ...LEAD_SHAPES.map(shape => `<option value="${shape.id}" ${current === shape.id ? 'selected' : ''}>${shape.name}</option>`),
      ].join('');
      return `
        <label class="cpro__lead-card ${i === activeBar ? 'cpro__lead-card--active' : ''}">
          <span class="cpro__lead-label">bar ${i + 1}</span>
          <select class="cpro__lead-select" data-lead-bar="${i}">${options}</select>
          <span class="cpro__lead-resolved">plays: ${resolved.name}</span>
        </label>
      `;
    }).join('');
    wrap.querySelectorAll<HTMLSelectElement>('[data-lead-bar]').forEach(sel => {
      sel.addEventListener('change', () => {
        const i = Number(sel.dataset.leadBar);
        commitChange(() => {
          activeBar = i;
          comp.leads[i] = sel.value as LeadChoice;
        }, 'Lead phrase changed');
      });
    });
    const preview = document.getElementById('cpro-lead-preview');
    if (preview) {
      preview.innerHTML = LEAD_SHAPES.map(shape => {
        const bars = shape.pattern.map(ev => `<span style="height:${ev.on ? 6 + ev.d * 6 + (ev.hold || 1) * 2 : 2}px;"></span>`).join('');
        return `<div class="cpro__phrase"><p class="cpro__phrase-name">${shape.name}</p><p class="cpro__phrase-tag">${shape.tag}</p><div class="cpro__phrase-shape">${bars}</div></div>`;
      }).join('');
    }
  }

  function resolveLeadId(c: Composition, bar: number): LeadId {
    for (let i = bar; i >= 0; i--) {
      const choice = c.leads[i];
      if (choice && choice !== 'inherit' && LEAD_SHAPES.some(s => s.id === choice)) return choice;
    }
    return 'arp';
  }

  function resolveLeadShape(c: Composition, bar: number): LeadShape {
    const id = resolveLeadId(c, bar);
    return LEAD_SHAPES.find(s => s.id === id) || LEAD_SHAPES[1];
  }

  function renderMap() {
    const wrap = document.getElementById('cpro-map');
    if (!wrap) return;
    const kit = KITS.find(k => k.id === comp.kit) || KITS[0];
    wrap.innerHTML = Array.from({ length: BAR_COUNT }, (_, bar) => {
      const drumBars = Array.from({ length: STEP_COUNT }, (_, step) => {
        const intensity = Math.max(comp.drums.kick[bar][step], comp.drums.snare[bar][step], comp.drums.hat[bar][step]);
        const height = 2 + intensity * 6;
        return `<span data-hit="${intensity}" style="height:${height}px"></span>`;
      }).join('');
      return `
        <button class="cpro__map-bar ${bar === activeBar ? 'cpro__map-bar--active' : ''} ${bar === currentPlaybackBar ? 'cpro__map-bar--playing' : ''}" data-map-bar="${bar}" type="button" style="--bar-c:${kit.color}">
          <span class="cpro__map-num">BAR ${bar + 1}</span>
          <span class="cpro__map-chord">${comp.chords[bar]}</span>
          <span class="cpro__map-lead">${resolveLeadShape(comp, bar).name}</span>
          <span class="cpro__map-drums">${drumBars}</span>
        </button>
      `;
    }).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-map-bar]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeBar = Number(btn.dataset.mapBar);
        renderChords();
        renderBarTabs();
        renderDrums();
        renderMap();
        renderLeadGrid();
      });
    });
  }

  function renderExamples() {
    const wrap = document.getElementById('cpro-examples');
    if (!wrap) return;
    wrap.innerHTML = EXAMPLES.map((e, i) => `
      <button class="cpro__example" data-example="${i}" type="button">
        <span class="cpro__example-art" style="--ec:${e.color};"><img src="https://noun.pics/${e.nounId}.svg" alt=""/></span>
        <span>
          <span class="cpro__example-name">${e.name}</span>
          <span class="cpro__example-tag">${e.tag}</span>
        </span>
      </button>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-example]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.example);
        commitChange(() => {
          comp = cloneComp(EXAMPLES[idx].comp);
          activeBar = 0;
        }, `Loaded ${EXAMPLES[idx].name}`);
      });
    });
  }

  function renderSlots() {
    document.querySelectorAll<HTMLButtonElement>('[data-save-slot]').forEach(btn => {
      const n = Number(btn.dataset.saveSlot);
      const raw = localStorage.getItem(SAVE_KEY(n));
      const parsed = raw ? safeParseSlot(raw) : null;
      btn.classList.toggle('cpro__slot--filled', !!parsed);
      if (parsed) {
        const preview = summarizeComp(parsed);
        btn.dataset.preview = preview;
        btn.title = `Slot ${n} · click to load · long-press to save · ${preview}`;
      } else {
        delete btn.dataset.preview;
        btn.title = `Slot ${n} · empty · long-press to save`;
      }
    });
  }

  function renderUndoState() {
    const undo = document.getElementById('cpro-undo') as HTMLButtonElement | null;
    const redo = document.getElementById('cpro-redo') as HTMLButtonElement | null;
    if (undo) undo.disabled = undoStack.length === 0;
    if (redo) redo.disabled = redoStack.length === 0;
  }

  function renderAll() {
    renderKits();
    renderControls();
    renderChords();
    renderBarTabs();
    renderDrums();
    renderLeadGrid();
    renderMap();
    renderExamples();
    renderSlots();
    renderUndoState();
  }

  function sameComp(a: Composition, b: Composition): boolean {
    return JSON.stringify(a) === JSON.stringify(b);
  }

  function pushUndoSnapshot(snapshot: Composition) {
    undoStack.push(cloneComp(snapshot));
    if (undoStack.length > MAX_HISTORY) undoStack.shift();
    redoStack = [];
    renderUndoState();
  }

  function commitChange(mutator: () => void, toastMsg?: string) {
    const before = cloneComp(comp);
    mutator();
    comp = normalizeComp(comp) || cloneComp(DEFAULT_COMP);
    if (!sameComp(before, comp)) pushUndoSnapshot(before);
    renderAll();
    restartIfPlaying();
    if (toastMsg) toast(toastMsg);
  }

  function undo() {
    const prev = undoStack.pop();
    if (!prev) { toast('Nothing to undo'); return; }
    redoStack.push(cloneComp(comp));
    comp = cloneComp(prev);
    activeBar = Math.min(activeBar, BAR_COUNT - 1);
    renderAll();
    restartIfPlaying();
    toast('Undone');
  }

  function redo() {
    const next = redoStack.pop();
    if (!next) { toast('Nothing to redo'); return; }
    undoStack.push(cloneComp(comp));
    comp = cloneComp(next);
    renderAll();
    restartIfPlaying();
    toast('Redone');
  }

  function restartIfPlaying() {
    if (playing) playOnce();
  }

  function beginSlider(id: string) {
    if (!sliderSnapshots.has(id)) sliderSnapshots.set(id, cloneComp(comp));
  }

  function commitSlider(id: string) {
    const snap = sliderSnapshots.get(id);
    if (!snap) return;
    sliderSnapshots.delete(id);
    comp = normalizeComp(comp) || cloneComp(DEFAULT_COMP);
    if (!sameComp(snap, comp)) {
      pushUndoSnapshot(snap);
      renderAll();
      restartIfPlaying();
    }
  }

  async function renderStemToWav(c: Composition, stem: StemName): Promise<Blob> {
    const sampleRate = 44100;
    const dur = songSec(c) + 1.0;
    const offline = new OfflineAudioContext(2, Math.ceil(sampleRate * dur), sampleRate);
    const masterOff = offline.createGain();
    masterOff.gain.value = stem === 'master' ? 0.72 : 0.86;
    masterOff.connect(offline.destination);
    const v: Voice = { ctx: offline, dest: masterOff, track: () => {} };
    scheduleComposition(v, c, 0.05, stem);
    const buffer = await offline.startRendering();
    return audioBufferToWavBlob(buffer);
  }

  function audioBufferToWavBlob(buf: AudioBuffer): Blob {
    const numChannels = buf.numberOfChannels;
    const sampleRate = buf.sampleRate;
    const numSamples = buf.length;
    const bytesPerSample = 2;
    const blockAlign = numChannels * bytesPerSample;
    const byteRate = sampleRate * blockAlign;
    const dataSize = numSamples * blockAlign;
    const headerSize = 44;
    const totalSize = headerSize + dataSize;
    const ab = new ArrayBuffer(totalSize);
    const view = new DataView(ab);
    let p = 0;
    function w16(n: number) { view.setUint16(p, n, true); p += 2; }
    function w32(n: number) { view.setUint32(p, n, true); p += 4; }
    function wstr(s: string) { for (let i = 0; i < s.length; i++) view.setUint8(p++, s.charCodeAt(i)); }
    wstr('RIFF'); w32(totalSize - 8); wstr('WAVE');
    wstr('fmt '); w32(16); w16(1); w16(numChannels); w32(sampleRate); w32(byteRate); w16(blockAlign); w16(8 * bytesPerSample);
    wstr('data'); w32(dataSize);
    const chans: Float32Array[] = [];
    for (let ch = 0; ch < numChannels; ch++) chans.push(buf.getChannelData(ch));
    for (let i = 0; i < numSamples; i++) {
      for (let ch = 0; ch < numChannels; ch++) {
        let s = Math.max(-1, Math.min(1, chans[ch][i]));
        s = s < 0 ? Math.max(-32768, Math.round(s * 32768)) : Math.min(32767, Math.round(s * 32767));
        view.setInt16(p, s, true); p += 2;
      }
    }
    return new Blob([ab], { type: 'audio/wav' });
  }

  async function exportStems() {
    const btn = document.getElementById('cpro-export') as HTMLButtonElement | null;
    if (!btn) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.classList.add('cpro__btn--rendering');
    btn.innerHTML = '<span class="cpro__btn-icon">⌛</span> rendering 6 stems';
    toast('Rendering master, kick, snare, hat, lead, and pad');
    try {
      const date = new Date().toISOString().slice(0, 10);
      const base = `cast-make-pro-${comp.kit}-${comp.bpm}bpm-${date}`;
      const files: { name: string; blob: Blob }[] = [];
      for (const stem of STEMS) {
        const blob = await renderStemToWav(comp, stem);
        files.push({ name: `${base}-${stem}.wav`, blob });
      }
      try {
        const zip = await createZip(files);
        downloadBlob(zip, `${base}-stems.zip`);
        toast(`Saved ${base}-stems.zip`);
      } catch (zipErr) {
        console.warn('zip failed, downloading stems separately', zipErr);
        files.forEach(file => downloadBlob(file.blob, file.name));
        toast('ZIP failed, downloaded separate WAV files');
      }
    } catch (e: any) {
      console.error('stem export failed', e);
      toast(`Export failed (${e?.message || 'unknown'})`);
    } finally {
      btn.disabled = false;
      btn.classList.remove('cpro__btn--rendering');
      btn.innerHTML = original;
    }
  }

  function downloadBlob(blob: Blob, name: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  const crcTable = (() => {
    const table = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      table[n] = c >>> 0;
    }
    return table;
  })();

  function crc32(data: Uint8Array): number {
    let c = 0xffffffff;
    for (let i = 0; i < data.length; i++) c = crcTable[(c ^ data[i]) & 0xff] ^ (c >>> 8);
    return (c ^ 0xffffffff) >>> 0;
  }

  function dosTimeDate(date = new Date()): { time: number; date: number } {
    const time = (date.getHours() << 11) | (date.getMinutes() << 5) | Math.floor(date.getSeconds() / 2);
    const day = date.getDate();
    const month = date.getMonth() + 1;
    const year = Math.max(1980, date.getFullYear()) - 1980;
    return { time, date: (year << 9) | (month << 5) | day };
  }

  async function createZip(files: { name: string; blob: Blob }[]): Promise<Blob> {
    const enc = new TextEncoder();
    const localParts: Uint8Array[] = [];
    const centralParts: Uint8Array[] = [];
    const dt = dosTimeDate();
    let offset = 0;
    for (const file of files) {
      const name = enc.encode(file.name);
      const data = new Uint8Array(await file.blob.arrayBuffer());
      const crc = crc32(data);
      const local = new Uint8Array(30 + name.length);
      const lv = new DataView(local.buffer);
      lv.setUint32(0, 0x04034b50, true);
      lv.setUint16(4, 20, true);
      lv.setUint16(6, 0, true);
      lv.setUint16(8, 0, true);
      lv.setUint16(10, dt.time, true);
      lv.setUint16(12, dt.date, true);
      lv.setUint32(14, crc, true);
      lv.setUint32(18, data.length, true);
      lv.setUint32(22, data.length, true);
      lv.setUint16(26, name.length, true);
      local.set(name, 30);
      localParts.push(local, data);
      const central = new Uint8Array(46 + name.length);
      const cv = new DataView(central.buffer);
      cv.setUint32(0, 0x02014b50, true);
      cv.setUint16(4, 20, true);
      cv.setUint16(6, 20, true);
      cv.setUint16(8, 0, true);
      cv.setUint16(10, 0, true);
      cv.setUint16(12, dt.time, true);
      cv.setUint16(14, dt.date, true);
      cv.setUint32(16, crc, true);
      cv.setUint32(20, data.length, true);
      cv.setUint32(24, data.length, true);
      cv.setUint16(28, name.length, true);
      cv.setUint16(30, 0, true);
      cv.setUint16(32, 0, true);
      cv.setUint16(34, 0, true);
      cv.setUint16(36, 0, true);
      cv.setUint32(38, 0, true);
      cv.setUint32(42, offset, true);
      central.set(name, 46);
      centralParts.push(central);
      offset += local.length + data.length;
    }
    const centralStart = offset;
    const centralSize = centralParts.reduce((sum, part) => sum + part.length, 0);
    const end = new Uint8Array(22);
    const ev = new DataView(end.buffer);
    ev.setUint32(0, 0x06054b50, true);
    ev.setUint16(8, files.length, true);
    ev.setUint16(10, files.length, true);
    ev.setUint32(12, centralSize, true);
    ev.setUint32(16, centralStart, true);
    return new Blob([...localParts, ...centralParts, end], { type: 'application/zip' });
  }

  function packVelBar(bar: number[]): number {
    return bar.reduce((acc, value, i) => acc + (Math.max(0, Math.min(3, value)) * Math.pow(4, i)), 0);
  }

  function unpackVelBar(n: number): number[] {
    const out: number[] = [];
    let x = Number.isFinite(Number(n)) ? Number(n) : 0;
    for (let i = 0; i < STEP_COUNT; i++) {
      out.push(Math.floor(x % 4));
      x = Math.floor(x / 4);
    }
    return out;
  }

  function encodeComp(c: Composition): string {
    const obj = {
      v: 2,
      k: KITS.findIndex(k => k.id === c.kit),
      b: c.bpm,
      sw: c.swing,
      vo: ['triad', 'wide', 'drone'].indexOf(c.voicing),
      ch: c.chords.map(ch => CHORD_CYCLE.indexOf(ch)),
      le: c.leads.map(choice => choice === 'inherit' ? -1 : LEAD_SHAPES.findIndex(s => s.id === choice)),
      kk: c.drums.kick.map(packVelBar),
      sn: c.drums.snare.map(packVelBar),
      hh: c.drums.hat.map(packVelBar),
    };
    return btoa(JSON.stringify(obj)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  function decodeComp(hash: string): Composition | null {
    try {
      const norm = hash.replace(/-/g, '+').replace(/_/g, '/');
      const padded = norm + '='.repeat((4 - norm.length % 4) % 4);
      const obj = JSON.parse(atob(padded));
      if (obj.v === 1) return decodeV1(obj);
      if (obj.v === 2) return decodeV2(obj);
      return null;
    } catch {
      return null;
    }
  }

  function decodeV1(obj: any): Composition | null {
    const kit = KITS[obj.k]?.id;
    if (!kit) return null;
    const lead = LEAD_SHAPES[obj.l]?.id;
    if (!lead) return null;
    const unpackOn = (n: number) => Array.from({ length: STEP_COUNT }, (_, i) => ((n >> i) & 1) ? 3 : 0);
    const drums = blankDrums();
    const one = { kick: unpackOn(obj.kk), snare: unpackOn(obj.sn), hat: unpackOn(obj.hh) };
    for (let bar = 0; bar < BAR_COUNT; bar++) {
      drums.kick[bar] = [...one.kick];
      drums.snare[bar] = [...one.snare];
      drums.hat[bar] = [...one.hat];
    }
    const chord4 = (Array.isArray(obj.c) ? obj.c : []).slice(0, 4).map((i: number) => CHORD_CYCLE[i] || 'I');
    while (chord4.length < 4) chord4.push('I');
    return normalizeComp({
      kit,
      bpm: clamp(obj.b, 60, 160, 96),
      swing: 50,
      voicing: 'triad',
      chords: [...chord4, ...chord4] as ChordSlot[],
      drums,
      leads: [lead, 'inherit', 'inherit', 'inherit', lead, 'inherit', 'inherit', 'inherit'],
    });
  }

  function decodeV2(obj: any): Composition | null {
    const kit = KITS[obj.k]?.id;
    if (!kit) return null;
    const voicings: Voicing[] = ['triad', 'wide', 'drone'];
    const drums = blankDrums();
    const packed = { kick: obj.kk, snare: obj.sn, hat: obj.hh };
    for (const lane of LANES) {
      if (!Array.isArray(packed[lane])) return null;
      for (let bar = 0; bar < BAR_COUNT; bar++) drums[lane][bar] = unpackVelBar(packed[lane][bar]);
    }
    return normalizeComp({
      kit,
      bpm: clamp(obj.b, 60, 160, 96),
      swing: clamp(obj.sw, 0, 66, 50),
      voicing: voicings[obj.vo] || 'triad',
      chords: Array.from({ length: BAR_COUNT }, (_, i) => CHORD_CYCLE[obj.ch?.[i]] || 'I'),
      drums,
      leads: Array.from({ length: BAR_COUNT }, (_, i) => {
        const idx = obj.le?.[i];
        return idx === -1 ? 'inherit' : LEAD_SHAPES[idx]?.id || 'inherit';
      }),
    });
  }

  function normalizeComp(c: any): Composition | null {
    if (!c || typeof c !== 'object') return null;
    if (!KITS.some(k => k.id === c.kit)) return null;
    const drums = blankDrums();
    if (!c.drums) return null;
    for (const lane of LANES) {
      if (!Array.isArray(c.drums[lane]) || c.drums[lane].length !== BAR_COUNT) return null;
      for (let bar = 0; bar < BAR_COUNT; bar++) {
        if (!Array.isArray(c.drums[lane][bar])) return null;
        drums[lane][bar] = Array.from({ length: STEP_COUNT }, (_, step) => clamp(c.drums[lane][bar][step], 0, 3, 0));
      }
    }
    return {
      kit: c.kit,
      bpm: clamp(c.bpm, 60, 160, 96),
      swing: clamp(c.swing, 0, 66, 50),
      voicing: (['triad', 'wide', 'drone'] as Voicing[]).includes(c.voicing) ? c.voicing : 'triad',
      chords: Array.from({ length: BAR_COUNT }, (_, i) => CHORD_CYCLE.includes(c.chords?.[i]) ? c.chords[i] : 'I'),
      drums,
      leads: Array.from({ length: BAR_COUNT }, (_, i) => {
        const choice = c.leads?.[i];
        if (choice === 'inherit') return 'inherit';
        return LEAD_SHAPES.some(s => s.id === choice) ? choice : 'inherit';
      }),
    };
  }

  function clamp(value: any, min: number, max: number, fallback: number): number {
    const n = Number(value);
    return Number.isFinite(n) ? Math.max(min, Math.min(max, Math.round(n))) : fallback;
  }

  function share() {
    const code = encodeComp(comp);
    const url = `${location.origin}${location.pathname}#${code}`;
    history.replaceState(null, '', `#${code}`);
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(() => toast('Link copied'), () => toast(url));
    } else {
      toast(url);
    }
  }

  function loadFromHash(): boolean {
    if (!location.hash || location.hash.length < 4) return false;
    const decoded = decodeComp(location.hash.slice(1));
    if (!decoded) { toast('Could not load shared composition'); return false; }
    comp = decoded;
    activeBar = 0;
    renderAll();
    toast('Loaded shared composition');
    return true;
  }

  const SAVE_KEY = (n: number) => `pc-mp-slot-${n}`;

  function saveSlot(n: number) {
    try {
      localStorage.setItem(SAVE_KEY(n), JSON.stringify(comp));
      renderSlots();
      toast(`Saved to slot ${n}`);
    } catch {
      toast(`Could not save slot ${n}`);
    }
  }

  function loadSlot(n: number) {
    const raw = localStorage.getItem(SAVE_KEY(n));
    if (!raw) { toast(`Slot ${n} is empty. Long-press to save.`); return; }
    const parsed = safeParseSlot(raw);
    if (!parsed) { toast(`Slot ${n} could not be read`); return; }
    commitChange(() => {
      comp = parsed;
      activeBar = 0;
    }, `Loaded slot ${n}`);
  }

  function safeParseSlot(raw: string): Composition | null {
    try { return normalizeComp(JSON.parse(raw)); }
    catch { return null; }
  }

  function bindSlot(btn: HTMLButtonElement, n: number) {
    let timer: number | null = null;
    let savedViaLongPress = false;
    const clearTimer = () => {
      if (timer != null) {
        clearTimeout(timer);
        timer = null;
      }
    };
    btn.addEventListener('pointerdown', () => {
      savedViaLongPress = false;
      clearTimer();
      timer = window.setTimeout(() => {
        savedViaLongPress = true;
        timer = null;
        saveSlot(n);
      }, 650);
    });
    btn.addEventListener('pointerup', clearTimer);
    btn.addEventListener('pointercancel', clearTimer);
    btn.addEventListener('pointerleave', clearTimer);
    btn.addEventListener('click', () => {
      if (savedViaLongPress) { savedViaLongPress = false; return; }
      loadSlot(n);
    });
  }

  function summarizeComp(c: Composition): string {
    const kit = KITS.find(k => k.id === c.kit)?.name || c.kit;
    return `${kit} · ${c.bpm} BPM · ${BAR_COUNT} bars · ${c.voicing}`;
  }

  function copyDrumBar(from: number, to: number) {
    for (const lane of LANES) comp.drums[lane][to] = [...comp.drums[lane][from]];
  }

  function makeFill(bar: number) {
    comp.drums.snare[bar] = [0,0,0,1, 3,0,1,0, 0,1,0,2, 3,2,2,1];
    comp.drums.kick[bar] = [3,0,0,0, 0,0,0,1, 3,0,0,0, 0,0,3,0];
    comp.drums.hat[bar] = [2,1,2,1, 2,1,2,1, 2,1,2,1, 3,2,1,0];
  }

  function toast(msg: string) {
    const el = document.getElementById('cpro-toast') as HTMLDivElement | null;
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    el.classList.remove('cpro__toast--out');
    if (toastHide) clearTimeout(toastHide);
    toastHide = window.setTimeout(() => {
      el.classList.add('cpro__toast--out');
      setTimeout(() => { el.hidden = true; }, 240);
    }, 2400);
  }

