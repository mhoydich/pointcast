  }

  .cpro__phrase-name { font-family: var(--cpro-display); font-size: 13px; font-weight: 800; color: var(--cpro-text); margin: 0 0 5px 0; }
  .cpro__phrase-tag { font-family: var(--cpro-mono); font-size: 9px; color: var(--cpro-text-quiet); margin: 0 0 8px 0; }
  .cpro__phrase-shape { height: 22px; display: flex; align-items: end; gap: 2px; }
  .cpro__phrase-shape span { flex: 1; min-width: 2px; border-radius: 2px; background: var(--cpro-walnut); opacity: 0.74; }

  .cpro__transport {
    position: fixed;
