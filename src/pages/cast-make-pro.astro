  }

  .cpro__lead-card--active { border-color: rgba(246,193,94,0.50); background: rgba(246,193,94,0.075); }
  .cpro__lead-label { font-family: var(--cpro-mono); font-size: 9.5px; color: var(--cpro-text-quiet); letter-spacing: 0.45px; text-transform: uppercase; }
  .cpro__lead-select {
    width: 100%;
