---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---

<BlockLayout title="Cast Make Pro — 8-bar Noun composer" description="A pro-tier 8-bar Noun composer with velocity drums, per-bar lead phrases, swing, pad voicing, share links, undo, slots, and multi-track WAV export.">
  <main class="cpro" id="cpro" data-built={built}>
    <header class="cpro__top">
      <div class="cpro__top-copy">
        <p class="cpro__kicker">CAST · MAKE · PRO</p>
        <h1 class="cpro__title">Eight bars. Real arrangement depth.</h1>
        <p class="cpro__sub">Pick a Noun kit, sketch an 8-bar chord map, paint velocity drums bar by bar, assign lead phrases, then export the full stem pack.</p>
      </div>
      <div class="cpro__top-panel">
        <div class="cpro__noun-badge" id="cpro-noun-badge">
          <div class="cpro__noun-art"><img src="https://noun.pics/313.svg" alt="Selected Noun kit" id="cpro-noun-img"/></div>
          <div>
            <p class="cpro__noun-label">CURRENT KIT</p>
            <p class="cpro__noun-name" id="cpro-noun-name">Marine Layer</p>
          </div>
        </div>
        <div class="cpro__top-actions">
          <div class="cpro__undo-combo" aria-label="Undo and redo">
            <button class="cpro__btn cpro__btn--ghost cpro__btn--mini" id="cpro-undo" type="button">↶ undo</button>
            <span>·</span>
            <button class="cpro__btn cpro__btn--ghost cpro__btn--mini" id="cpro-redo" type="button">↷ redo</button>
          </div>
          <button class="cpro__btn cpro__btn--ghost" id="cpro-share" type="button" title="Share this composition as a URL">
            <span class="cpro__btn-icon">⤴</span> share
          </button>
          <button class="cpro__btn" id="cpro-export" type="button" title="Render master plus stems to a ZIP">
            <span class="cpro__btn-icon">↓</span> export stems
          </button>
        </div>
      </div>
    </header>

    <section class="cpro__examples">
      <div class="cpro__section-head cpro__section-head--tight">
        <p class="cpro__section-label">STARTING POINTS</p>
        <p class="cpro__section-hint">Load one, then overwrite it. These are full 8-bar pro arrangements.</p>
      </div>
      <div class="cpro__examples-row" id="cpro-examples"></div>
    </section>

    <section class="cpro__section cpro__section--map">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">ARRANGEMENT MAP</p>
          <h2 class="cpro__section-title">All 8 bars at a glance.</h2>
        </div>
        <p class="cpro__section-hint">Click a bar to edit its drums. Playback highlights the current bar.</p>
      </header>
      <div class="cpro__map" id="cpro-map"></div>
    </section>

    <section class="cpro__section">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">1 · PICK A KIT</p>
          <h2 class="cpro__section-title">Noun voices and drum circuits.</h2>
        </div>
        <p class="cpro__section-hint">The first four kits match /cast-make for URL compatibility.</p>
      </header>
      <div class="cpro__kit-row" id="cpro-kit-row"></div>
    </section>

    <section class="cpro__section">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">2 · TEMPO, SWING, VOICING</p>
          <h2 class="cpro__section-title">Set the pocket before painting.</h2>
        </div>
        <p class="cpro__section-hint" id="cpro-tempo-hint">96 BPM · straight 16ths · triad pads.</p>
      </header>
      <div class="cpro__control-grid">
        <label class="cpro__range">
          <span class="cpro__range-label">BPM</span>
          <input type="range" class="cpro__slider" id="cpro-bpm" min="60" max="160" value="96" step="1"/>
          <span class="cpro__range-value" id="cpro-bpm-val">96</span>
        </label>
        <label class="cpro__range">
          <span class="cpro__range-label">SWING</span>
          <input type="range" class="cpro__slider" id="cpro-swing" min="0" max="66" value="50" step="1"/>
          <span class="cpro__range-value" id="cpro-swing-val">50%</span>
        </label>
        <label class="cpro__select-wrap">
          <span class="cpro__select-label">PAD VOICING</span>
          <select class="cpro__select" id="cpro-voicing">
            <option value="triad">triad</option>
            <option value="wide">wide</option>
            <option value="drone">drone</option>
          </select>
        </label>
      </div>
    </section>

    <section class="cpro__section">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">3 · SKETCH 8 CHORDS</p>
          <h2 class="cpro__section-title">A full phrase, not a tiny loop.</h2>
        </div>
        <p class="cpro__section-hint">Tap any bar to cycle through the pro chord palette.</p>
      </header>
      <div class="cpro__chord-strip" id="cpro-chord-strip"></div>
    </section>

    <section class="cpro__section">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">4 · PAINT PER-BAR DRUMS</p>
          <h2 class="cpro__section-title">Three lanes, 128 steps, four velocity levels.</h2>
        </div>
        <p class="cpro__section-hint">Click or drag to cycle silent · soft · mid · loud. Shift-paint moves backward.</p>
      </header>
      <div class="cpro__bar-tabs" id="cpro-bar-tabs"></div>
      <div class="cpro__drum-tools">
        <button class="cpro__tool" id="cpro-copy-first-four" type="button">copy bar 1 → bars 2-4</button>
        <button class="cpro__tool" id="cpro-copy-active-all" type="button">copy active → all</button>
        <button class="cpro__tool" id="cpro-clear-active" type="button">clear active</button>
        <button class="cpro__tool" id="cpro-fill-active" type="button">make fill</button>
      </div>
      <div class="cpro__drum-grid" id="cpro-drum-grid">
        <div class="cpro__drum-row" data-lane="kick">
          <span class="cpro__drum-label">KICK</span>
          <div class="cpro__drum-cells"></div>
        </div>
        <div class="cpro__drum-row" data-lane="snare">
          <span class="cpro__drum-label">SNARE</span>
          <div class="cpro__drum-cells"></div>
        </div>
        <div class="cpro__drum-row" data-lane="hat">
          <span class="cpro__drum-label">HAT</span>
          <div class="cpro__drum-cells"></div>
        </div>
      </div>
      <div class="cpro__beats-mark"><span></span><span>1</span><span>e</span><span>&amp;</span><span>a</span><span>2</span><span>e</span><span>&amp;</span><span>a</span><span>3</span><span>e</span><span>&amp;</span><span>a</span><span>4</span><span>e</span><span>&amp;</span><span>a</span></div>
    </section>

    <section class="cpro__section">
      <header class="cpro__section-head">
        <div>
          <p class="cpro__section-label">5 · PER-BAR LEAD PHRASE</p>
          <h2 class="cpro__section-title">Let bars inherit, answer, or stay quiet.</h2>
        </div>
        <p class="cpro__section-hint">Each dropdown controls one bar. Inherit walks back to the last explicit phrase.</p>
      </header>
      <div class="cpro__lead-grid" id="cpro-lead-grid"></div>
      <div class="cpro__lead-preview" id="cpro-lead-preview"></div>
    </section>

    <p class="cpro__footnote">Saved to this device. <a href="/cast-make">/cast-make</a> keeps the tiny version · <a href="/cast-real">/cast-real</a> hosts finished songs · <a href="/">PointCast home</a>.</p>

    <footer class="cpro__transport">
      <div class="cpro__transport-left">
        <button class="cpro__btn cpro__btn--big" id="cpro-play" type="button">
          <span class="cpro__btn-icon" id="cpro-play-icon">▶</span>
          <span id="cpro-play-label">PLAY</span>
        </button>
        <div class="cpro__meter">
          <span class="cpro__meter-label">BAR <span id="cpro-current-bar">—</span></span>
          <div class="cpro__progress"><div class="cpro__progress-fill" id="cpro-progress"></div></div>
        </div>
      </div>
      <div class="cpro__transport-right">
        <span class="cpro__slot-label">SLOTS</span>
        <button class="cpro__slot" data-save-slot="1" type="button">1<span></span></button>
        <button class="cpro__slot" data-save-slot="2" type="button">2<span></span></button>
        <button class="cpro__slot" data-save-slot="3" type="button">3<span></span></button>
        <button class="cpro__slot" data-save-slot="4" type="button">4<span></span></button>
        <button class="cpro__slot" data-save-slot="5" type="button">5<span></span></button>
        <button class="cpro__slot" data-save-slot="6" type="button">6<span></span></button>
        <button class="cpro__slot" data-save-slot="7" type="button">7<span></span></button>
        <button class="cpro__slot" data-save-slot="8" type="button">8<span></span></button>
        <button class="cpro__btn cpro__btn--ghost cpro__btn--mini" id="cpro-clear" type="button">clear</button>
      </div>
    </footer>

    <div class="cpro__toast" id="cpro-toast" hidden></div>
  </main>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cpro-bg: #0a0610;
    --cpro-bg-2: #170a18;
    --cpro-walnut: #5a3422;
    --cpro-flame: #f6c15e;
    --cpro-cream: #f4e7c8;
    --cpro-velvet: #1a0820;
    --cpro-glass: rgba(244,231,200,0.045);
    --cpro-glass-hi: rgba(244,231,200,0.09);
    --cpro-line: rgba(244,231,200,0.12);
    --cpro-text: #f4e7c8;
    --cpro-text-mute: rgba(244,231,200,0.64);
    --cpro-text-quiet: rgba(244,231,200,0.40);
    --cpro-display: 'Inter Tight', system-ui, sans-serif;
    --cpro-body: 'Inter', system-ui, sans-serif;
    --cpro-mono: 'JetBrains Mono', ui-monospace, monospace;
    --cpro-good: #a8ff3a;
    --cpro-blue: #9ed6f0;
    --cpro-red: #ff5f7a;
  }

  body { background: var(--cpro-bg); color: var(--cpro-text); font-family: var(--cpro-body); }

  .cpro {
    max-width: 1180px;
    margin: 0 auto;
    padding: 30px 22px 126px 22px;
    color: var(--cpro-text);
  }

  .cpro__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 26px;
    align-items: start;
    padding: 18px 0 26px 0;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--cpro-line);
  }

  .cpro__top-copy { min-width: 0; }
  .cpro__kicker,
  .cpro__section-label,
  .cpro__noun-label,
  .cpro__range-label,
  .cpro__select-label,
  .cpro__slot-label {
    font-family: var(--cpro-mono);
    font-size: 10.5px;
    letter-spacing: 0.65px;
    color: var(--cpro-flame);
    text-transform: uppercase;
    margin: 0;
  }

  .cpro__title {
    font-family: var(--cpro-display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 10px 0 14px 0;
    max-width: 760px;
  }

  .cpro__sub {
    font-size: 15px;
    color: var(--cpro-text-mute);
    line-height: 1.62;
    max-width: 660px;
    margin: 0;
  }

  .cpro__top-panel {
    display: grid;
    gap: 12px;
    justify-items: stretch;
  }

  .cpro__noun-badge {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px;
    border: 1px solid var(--cpro-line);
    background: linear-gradient(135deg, rgba(246,193,94,0.08), rgba(244,231,200,0.03));
    border-radius: 8px;
  }

  .cpro__noun-art {
    width: 62px;
    height: 62px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--kit-c, var(--cpro-walnut)), var(--cpro-velvet));
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .cpro__noun-art img { width: 86%; image-rendering: pixelated; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.45)); }
  .cpro__noun-name { font-family: var(--cpro-display); font-size: 24px; font-weight: 800; line-height: 1; margin: 6px 0 0 0; }
  .cpro__top-actions { display: flex; gap: 8px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }

  .cpro__btn {
    border: 0;
    border-radius: 8px;
    padding: 10px 15px;
    background: var(--cpro-flame);
    color: var(--cpro-velvet);
    font-family: var(--cpro-display);
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .cpro__btn:hover:not(:disabled) { transform: translateY(-1px); background: #ffd58a; }
  .cpro__btn:disabled { opacity: 0.48; cursor: not-allowed; }
  .cpro__btn--ghost { background: transparent; color: var(--cpro-text-mute); border: 1px solid var(--cpro-line); }
  .cpro__btn--ghost:hover:not(:disabled) { background: var(--cpro-glass-hi); color: var(--cpro-text); border-color: rgba(246,193,94,0.52); }
  .cpro__btn--mini { min-height: 34px; padding: 7px 11px; font-size: 12px; }
  .cpro__btn--big { min-width: 132px; min-height: 48px; font-size: 15px; padding: 13px 22px; }
  .cpro__btn--rendering { cursor: progress; border-color: var(--cpro-flame); color: var(--cpro-flame); }
  .cpro__btn--rendering:hover { transform: none; }
  .cpro__btn-icon { font-size: 14px; line-height: 1; }

  .cpro__undo-combo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    border: 1px solid var(--cpro-line);
    border-radius: 8px;
    color: var(--cpro-text-quiet);
    background: rgba(244,231,200,0.035);
  }

  .cpro__undo-combo .cpro__btn { border: 0; background: transparent; }

  .cpro__examples,
  .cpro__section {
    margin-bottom: 24px;
    padding: 20px;
    border: 1px solid var(--cpro-line);
    border-radius: 8px;
    background: var(--cpro-glass);
  }

  .cpro__examples {
    background: linear-gradient(135deg, rgba(246,193,94,0.07), rgba(168,255,58,0.025));
    border-color: rgba(246,193,94,0.22);
  }

  .cpro__section--map { background: rgba(244,231,200,0.035); }
  .cpro__section-head { display: flex; justify-content: space-between; gap: 18px; align-items: end; margin-bottom: 16px; flex-wrap: wrap; }
  .cpro__section-head--tight { align-items: baseline; margin-bottom: 12px; }
  .cpro__section-title { font-family: var(--cpro-display); font-size: 22px; line-height: 1.05; font-weight: 800; letter-spacing: -0.01em; margin: 6px 0 0 0; }
  .cpro__section-hint { font-size: 13px; line-height: 1.5; color: var(--cpro-text-mute); max-width: 440px; margin: 0; }

  .cpro__examples-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .cpro__example {
    border: 1px solid var(--cpro-line);
    border-radius: 8px;
    background: rgba(244,231,200,0.04);
    color: var(--cpro-text);
    cursor: pointer;
    padding: 10px;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    text-align: left;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .cpro__example:hover { transform: translateY(-2px); background: rgba(244,231,200,0.09); border-color: rgba(246,193,94,0.55); }
  .cpro__example-art { width: 44px; height: 44px; border-radius: 8px; display: grid; place-items: center; background: linear-gradient(135deg, var(--ec), var(--cpro-velvet)); }
  .cpro__example-art img { width: 82%; image-rendering: pixelated; }
  .cpro__example-name { font-family: var(--cpro-display); font-weight: 800; font-size: 14px; margin: 0 0 3px 0; color: var(--cpro-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cpro__example-tag { font-family: var(--cpro-mono); font-size: 10px; color: var(--cpro-text-quiet); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .cpro__map {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
  }

  .cpro__map-bar {
    border: 1px solid var(--cpro-line);
    border-radius: 8px;
    padding: 10px;
    min-height: 128px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bar-c, var(--cpro-walnut)) 35%, var(--cpro-velvet)), rgba(244,231,200,0.03));
    color: var(--cpro-text);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .cpro__map-bar:hover { transform: translateY(-2px); border-color: rgba(246,193,94,0.55); }
  .cpro__map-bar--active { border-color: var(--cpro-flame); box-shadow: 0 0 0 3px rgba(246,193,94,0.16); }
  .cpro__map-bar--playing { outline: 2px solid var(--cpro-cream); outline-offset: 2px; }
  .cpro__map-num { font-family: var(--cpro-mono); font-size: 9px; color: rgba(255,255,255,0.62); letter-spacing: 0.4px; }
  .cpro__map-chord { font-family: var(--cpro-display); font-size: 25px; font-weight: 800; line-height: 1; color: #fff; }
  .cpro__map-lead { font-family: var(--cpro-mono); font-size: 9px; color: rgba(255,255,255,0.66); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cpro__map-drums { display: grid; grid-template-columns: repeat(16, 1fr); gap: 1px; margin-top: auto; align-items: end; height: 24px; }
  .cpro__map-drums span { display: block; border-radius: 1px; min-height: 2px; background: rgba(255,255,255,0.20); }
  .cpro__map-drums span[data-hit="1"] { background: rgba(246,193,94,0.85); }
  .cpro__map-drums span[data-hit="2"] { background: rgba(168,255,58,0.85); }
  .cpro__map-drums span[data-hit="3"] { background: rgba(158,214,240,0.90); }

  .cpro__kit-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }

  .cpro__kit {
    border: 2px solid transparent;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--kit-c), var(--cpro-velvet));
    padding: 13px 10px;
    cursor: pointer;
    text-align: center;
    color: #fff;
    min-height: 154px;
    transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .cpro__kit:hover { transform: translateY(-3px); }
  .cpro__kit--active { border-color: var(--cpro-flame); box-shadow: 0 0 0 4px rgba(246,193,94,0.16); }
  .cpro__kit-portrait { width: 66px; height: 66px; border-radius: 8px; margin: 0 auto 10px auto; display: grid; place-items: center; background: rgba(0,0,0,0.30); }
  .cpro__kit-portrait img { width: 84%; image-rendering: pixelated; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.45)); }
  .cpro__kit-name { font-family: var(--cpro-display); font-weight: 800; font-size: 14px; color: #fff; margin: 0 0 4px 0; line-height: 1.15; }
  .cpro__kit-tag { font-family: var(--cpro-mono); font-size: 9.5px; line-height: 1.45; color: rgba(255,255,255,0.66); text-transform: uppercase; letter-spacing: 0.35px; margin: 0; }

  .cpro__control-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 230px;
    gap: 14px;
    align-items: end;
  }

  .cpro__range,
  .cpro__select-wrap {
    display: grid;
    gap: 8px;
    padding: 12px;
    border: 1px solid var(--cpro-line);
    border-radius: 8px;
    background: rgba(244,231,200,0.035);
  }

  .cpro__range {
    grid-template-columns: 56px 1fr 64px;
    align-items: center;
  }

  .cpro__range-label { color: var(--cpro-text-quiet); }
  .cpro__range-value { font-family: var(--cpro-display); font-size: 22px; font-weight: 800; color: var(--cpro-text); text-align: right; }
  .cpro__slider { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 2px; background: rgba(244,231,200,0.16); outline: none; cursor: pointer; }
  .cpro__slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 17px; height: 17px; border-radius: 50%; background: var(--cpro-flame); box-shadow: 0 1px 5px rgba(0,0,0,0.45); }
  .cpro__slider::-moz-range-thumb { width: 17px; height: 17px; border: 0; border-radius: 50%; background: var(--cpro-flame); box-shadow: 0 1px 5px rgba(0,0,0,0.45); }

  .cpro__select-label { color: var(--cpro-text-quiet); }
  .cpro__select {
    width: 100%;
    min-height: 40px;
    border-radius: 8px;
    border: 1px solid var(--cpro-line);
    background: rgba(10,6,16,0.80);
    color: var(--cpro-text);
    font-family: var(--cpro-display);
    font-weight: 800;
    font-size: 14px;
    padding: 0 12px;
  }

  .cpro__chord-strip {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
  }

  .cpro__chord-bar {
    aspect-ratio: 0.92;
    border-radius: 8px;
    border: 2px solid transparent;
    padding: 10px;
    background: linear-gradient(180deg, var(--cb, var(--cpro-walnut)), color-mix(in srgb, var(--cb, var(--cpro-walnut)) 32%, var(--cpro-velvet)));
    color: #fff;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .cpro__chord-bar:hover { transform: translateY(-2px); }
