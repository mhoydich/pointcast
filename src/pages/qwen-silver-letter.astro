---
const canonical = 'https://pointcast.xyz/qwen-silver-letter';
const title = '银信气象台 — Qwen Model Study 002';
const description =
  'A public PointCast weather-letter instrument rooted in Kaiping, Jiangmen, western Guangdong: river, kitchen, distance, and neighborly care.';
const ogImage = 'https://pointcast.xyz/images/qwen-silver-letter/og.png';
const signals = [
  { key: 'river', zh: '潭江水位', en: 'Tan River level', value: 52 },
  { key: 'kitchen', zh: '厨房温度', en: 'Kitchen warmth', value: 74 },
  { key: 'distance', zh: '离家距离', en: 'Distance from home', value: 61 },
  { key: 'neighbors', zh: '邻里照应', en: 'Neighbors helping', value: 79 },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  alternateName: 'The Silver Letter Weather Office',
  description,
  url: canonical,
  image: ogImage,
  datePublished: '2026-07-25T20:16:31.000Z',
  creator: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  about: [
    'Kaiping, Jiangmen, Guangdong',
    'Qiaopi and silver-letter community networks',
    'Qwen language and audio model relay design',
  ],
  mainEntityOfPage: 'https://pointcast.xyz/qwen-silver-letter.json',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Qwen Model Studies',
    url: 'https://pointcast.xyz/qwen-weather',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/json"
      href="/qwen-silver-letter.json"
      title="Silver Letter Weather machine record"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#06131d" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: dark;
        --night: #06131d;
        --night-soft: #0a2029;
        --paper: #e9e1cd;
        --paper-dim: rgba(233, 225, 205, 0.64);
        --river: #87cfba;
        --river-dark: #356e69;
        --seal: #b23d2f;
        --amber: #e2bd77;
        --line: rgba(233, 225, 205, 0.18);
        --serif: "Songti SC", STSong, "Noto Serif CJK SC", Iowan Old Style,
          Baskerville, "Times New Roman", serif;
        --sans: "Helvetica Neue", "PingFang SC", "Noto Sans CJK SC", Arial,
          sans-serif;
        --mono: "SFMono-Regular", "IBM Plex Mono", Menlo, Consolas, monospace;
        --gutter: clamp(18px, 5vw, 82px);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--night);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 80% 12%, rgba(65, 128, 120, 0.14), transparent 25%),
          var(--night);
        color: var(--paper);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      button,
      input,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        color: inherit;
        font: inherit;
      }

      ::selection {
        background: var(--seal);
        color: var(--paper);
      }

      :focus-visible {
        outline: 3px solid var(--river);
        outline-offset: 4px;
      }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 100;
        padding: 10px 14px;
        background: var(--paper);
        color: var(--night);
        font-family: var(--mono);
        font-size: 10px;
        transform: translateY(-150%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .masthead {
        position: absolute;
        inset: 0 0 auto;
        z-index: 20;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 18px var(--gutter);
        border-bottom: 1px solid rgba(233, 225, 205, 0.13);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .masthead a {
        text-decoration: none;
      }

      .masthead__brand {
        font-family: var(--serif);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: none;
      }

      .masthead__study {
        color: var(--river);
      }

      .masthead__machine {
        justify-self: end;
        color: var(--paper-dim);
      }

      .hero {
        position: relative;
        display: grid;
        min-height: 100svh;
        grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
        overflow: hidden;
        padding: clamp(120px, 16vh, 180px) var(--gutter) 48px;
        border-bottom: 1px solid var(--line);
      }

      .hero__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        opacity: 0.56;
        filter: saturate(0.86) brightness(0.7);
      }

      .hero::after {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          linear-gradient(90deg, rgba(6, 19, 29, 0.98), rgba(6, 19, 29, 0.66) 50%, rgba(6, 19, 29, 0.18)),
          linear-gradient(180deg, rgba(6, 19, 29, 0.45), transparent 42%, rgba(6, 19, 29, 0.92));
        content: "";
      }

      .hero__copy,
      .hero__note {
        position: relative;
        z-index: 2;
      }

      .hero__copy {
        align-self: center;
      }

      .eyebrow {
        margin: 0 0 34px;
        color: var(--river);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(78px, 12vw, 176px);
        font-weight: 400;
        letter-spacing: -0.08em;
        line-height: 0.76;
      }

      h1 span {
        display: block;
      }

      h1 span:last-child {
        color: transparent;
        margin-left: 0.28em;
        -webkit-text-stroke: 1px rgba(233, 225, 205, 0.82);
      }

      .hero__english {
        margin: 36px 0 0 0.5em;
        font-family: var(--mono);
        font-size: clamp(9px, 1vw, 13px);
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .hero__note {
        align-self: end;
        max-width: 410px;
        padding-left: 24px;
        border-left: 1px solid var(--seal);
      }

      .hero__note p {
        margin: 0 0 14px;
        color: var(--paper-dim);
        font-size: 13px;
        line-height: 1.7;
      }

      .hero__note p:first-child {
        color: var(--paper);
        font-family: var(--serif);
        font-size: 17px;
      }

      .hero__note a {
        display: inline-flex;
        margin-top: 18px;
        color: var(--river);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .instrument {
        display: grid;
        gap: clamp(46px, 7vw, 110px);
        grid-template-columns: minmax(260px, 0.72fr) minmax(340px, 1.28fr);
        padding: clamp(96px, 14vw, 190px) var(--gutter);
      }

      .instrument__heading {
        align-self: start;
        position: sticky;
        top: 50px;
      }

      .section-label {
        margin: 0;
        color: var(--river);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h2 {
        margin: 48px 0 18px;
        font-family: var(--serif);
        font-size: clamp(44px, 6vw, 82px);
        font-weight: 400;
        letter-spacing: -0.06em;
        line-height: 0.98;
      }

      .translation {
        color: var(--paper-dim);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .signal-list {
        border-top: 1px solid var(--line);
      }

      .signal {
        display: grid;
        grid-template-columns: 54px minmax(130px, 0.65fr) minmax(150px, 1fr);
        align-items: center;
        gap: 18px;
        min-height: 122px;
        padding: 25px 0;
        border-bottom: 1px solid var(--line);
      }

      .signal__value {
        color: var(--river);
        font-family: var(--mono);
        font-size: 20px;
      }

      .signal__label b {
        display: block;
        font-family: var(--serif);
        font-size: 19px;
        font-weight: 500;
      }

      .signal__label small {
        display: block;
        margin-top: 5px;
        color: var(--paper-dim);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .signal input {
        appearance: none;
        width: 100%;
        height: 1px;
        background:
          linear-gradient(
            90deg,
            var(--river) 0 var(--signal-value),
            rgba(233, 225, 205, 0.2) var(--signal-value) 100%
          );
        cursor: ew-resize;
      }

      .signal input::-webkit-slider-thumb {
        appearance: none;
        width: 20px;
        height: 20px;
        border: 5px solid var(--night);
        border-radius: 50%;
        background: var(--paper);
        box-shadow: 0 0 0 1px var(--river);
      }

      .signal input::-moz-range-thumb {
        width: 10px;
        height: 10px;
        border: 5px solid var(--night);
        border-radius: 50%;
        background: var(--paper);
        box-shadow: 0 0 0 1px var(--river);
      }

      .letter {
        position: relative;
        grid-column: 2;
        min-height: 440px;
        margin-top: -18px;
        padding: clamp(32px, 5vw, 72px);
        background: var(--paper);
        color: var(--night);
      }

      .letter::after {
        position: absolute;
        top: 42px;
        right: 42px;
        display: grid;
        width: 70px;
        height: 70px;
        place-items: center;
        border: 1px solid var(--seal);
        border-radius: 50%;
        color: var(--seal);
        content: "银信";
        font-family: var(--serif);
        font-size: 21px;
        opacity: 0.68;
        transform: rotate(-7deg);
      }

      .letter__label {
        color: var(--seal);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .letter blockquote {
        margin: clamp(96px, 12vw, 150px) 0 70px;
      }

      .letter blockquote p {
        margin: 0 0 20px;
        font-family: var(--serif);
        font-size: clamp(26px, 3.6vw, 48px);
        letter-spacing: -0.04em;
        line-height: 1.18;
      }

      .letter blockquote p:last-child {
        max-width: 560px;
        font-family: var(--sans);
        font-size: clamp(13px, 1.35vw, 18px);
        letter-spacing: 0;
        line-height: 1.5;
      }

      .letter__foot {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding-top: 18px;
        border-top: 1px solid rgba(6, 19, 29, 0.2);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .relay {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: clamp(32px, 6vw, 86px);
        padding: clamp(96px, 13vw, 174px) var(--gutter);
        background: var(--paper);
        color: var(--night);
      }

      .relay__mark {
        display: grid;
        width: clamp(100px, 13vw, 176px);
        height: clamp(100px, 13vw, 176px);
        place-items: center;
        border-radius: 50%;
        background: var(--night);
        color: var(--river);
        font-family: var(--serif);
        font-size: clamp(58px, 8vw, 108px);
      }

      .relay .section-label {
        color: var(--seal);
      }

      .relay h2 {
        max-width: 1050px;
        font-family: var(--sans);
        font-size: clamp(36px, 5.3vw, 76px);
      }

      .relay h2 em {
        color: var(--river-dark);
        font-family: var(--serif);
        font-weight: 400;
      }

      .relay__body {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 36px;
        max-width: 880px;
      }

      .relay__body p {
        margin: 0;
        font-size: 13px;
        line-height: 1.75;
      }

      .relay__body p:first-child {
        font-family: var(--serif);
        font-size: 16px;
      }

      .relay__status {
        grid-column: 2;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 24px;
        border-top: 1px solid rgba(6, 19, 29, 0.2);
      }

      .relay__status div {
        padding: 24px 24px 10px 0;
        border-right: 1px solid rgba(6, 19, 29, 0.16);
      }

      .relay__status div + div {
        padding-left: 24px;
      }

      .relay__status span,
      .relay__status small {
        display: block;
        color: rgba(6, 19, 29, 0.52);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
      }

      .relay__status b {
        display: block;
        margin: 9px 0 5px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.08em;
      }

      .regional {
        display: grid;
        grid-template-columns: 0.82fr 1.18fr;
        gap: clamp(42px, 8vw, 130px);
        padding: clamp(96px, 13vw, 180px) var(--gutter);
      }

      .regional__copy {
        max-width: 760px;
      }

      .regional__copy > p {
        margin: 0 0 24px;
        color: var(--paper-dim);
        font-size: 14px;
        line-height: 1.8;
      }

      .regional__copy > p:first-child {
        color: var(--paper);
        font-family: var(--serif);
        font-size: clamp(21px, 2.4vw, 33px);
        letter-spacing: -0.02em;
        line-height: 1.55;
      }

      .context {
        padding-left: 22px;
        border-left: 1px solid var(--seal);
        color: var(--paper) !important;
        font-family: var(--serif);
      }

      .context span {
        display: block;
        margin-top: 8px;
        color: var(--paper-dim);
        font-family: var(--sans);
        font-size: 12px;
      }

      .regional__links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 44px;
      }

      .regional__links a {
        padding: 10px 12px;
        border: 1px solid var(--line);
        color: var(--river);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.07em;
        text-decoration: none;
        text-transform: uppercase;
      }

      footer {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        align-items: end;
        gap: 48px;
        min-height: 250px;
        padding: 64px var(--gutter) 42px;
        border-top: 1px solid var(--line);
      }

      footer div,
      footer p,
      footer a {
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
        line-height: 1.6;
        text-transform: uppercase;
      }

      footer div {
        display: flex;
        flex-direction: column;
      }

      footer p {
        max-width: 390px;
        margin: 0;
        color: var(--paper-dim);
      }

      footer > a {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        text-decoration: none;
      }

      @media (max-width: 820px) {
        .masthead {
          grid-template-columns: 1fr auto;
        }

        .masthead__study {
          display: none;
        }

        .hero,
        .instrument,
        .regional {
          grid-template-columns: 1fr;
        }

        .hero {
          min-height: 930px;
        }

        .hero__note {
          align-self: end;
          margin-top: 62px;
        }

        .instrument__heading {
          position: static;
        }

        .letter {
          grid-column: 1;
          margin-top: 0;
        }

        .relay {
          grid-template-columns: 1fr;
        }

        .relay__status {
          grid-column: 1;
        }

        footer {
          grid-template-columns: 1fr 1fr;
        }

        footer > a {
          grid-column: 2;
          grid-row: 1 / 3;
          justify-self: end;
        }
      }

      @media (max-width: 540px) {
        .masthead {
          padding-inline: 15px;
        }

        .masthead__machine {
          font-size: 7px;
        }

        .hero {
          min-height: 900px;
          padding: 112px 18px 34px;
        }

        h1 {
          font-size: clamp(80px, 27vw, 126px);
        }

        h1 span:last-child {
          margin-left: 0.08em;
        }

        .instrument,
        .relay,
        .regional {
          padding: 92px 18px;
        }

        .signal {
          grid-template-columns: 44px 1fr;
          gap: 12px;
          min-height: 142px;
        }

        .signal input {
          grid-column: 1 / -1;
        }

        .letter {
          min-height: 520px;
          padding: 28px 22px;
        }

        .letter::after {
          top: 22px;
          right: 22px;
          width: 58px;
          height: 58px;
        }

        .letter blockquote {
          margin-top: 124px;
        }

        .letter__foot {
          flex-direction: column;
        }

        .relay__body,
        .relay__status {
          grid-template-columns: 1fr;
        }

        .relay__status div {
          padding: 20px 0;
          border-right: 0;
          border-bottom: 1px solid rgba(6, 19, 29, 0.14);
        }

        .relay__status div + div {
          padding-left: 0;
        }

        footer {
          grid-template-columns: 1fr;
          gap: 24px;
          padding-inline: 18px;
        }

        footer > a {
          grid-column: 1;
          grid-row: auto;
          justify-self: start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#instrument">Skip to the instrument</a>

    <header class="masthead">
      <a class="masthead__brand" href="/">PointCast / 点播</a>
      <span class="masthead__study">Qwen Model Study 002</span>
      <a class="masthead__machine" href="/qwen-silver-letter.json">JSON ↗</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="study-title">
        <img
          class="hero__image"
          src="/images/qwen-silver-letter/og.png"
          alt=""
          width="1200"
          height="630"
          aria-hidden="true"
        />
        <div class="hero__copy">
          <p class="eyebrow">珠江口以西 · West of the Pearl River estuary</p>
          <h1 id="study-title"><span>银信</span><span>气象台</span></h1>
          <p class="hero__english">The Silver Letter Weather Office</p>
        </div>
        <div class="hero__note">
          <p lang="zh-CN">
            一座为开平与远方而设的公共气象台。你不必写下身份，只需留下今日的水位、灶火、距离与邻里照应。
          </p>
          <p>
            A public weather office for Kaiping and the places connected to it.
            Leave no identity—only today&apos;s river, kitchen, distance, and
            neighborly care.
          </p>
          <a href="#instrument">Compose a weather letter ↓</a>
        </div>
      </section>

      <section class="instrument" id="instrument" aria-labelledby="instrument-title">
        <div class="instrument__heading">
          <p class="section-label">01 / Public instrument</p>
          <h2 id="instrument-title">今天，家乡的<br />天气是什么？</h2>
          <p class="translation">What is the weather of home today?</p>
        </div>

        <div class="signal-list">
          {
            signals.map((signal) => (
              <label class="signal">
                <output class="signal__value" data-value-for={signal.key}>
                  {String(signal.value).padStart(2, '0')}
                </output>
                <span class="signal__label">
                  <b lang="zh-CN">{signal.zh}</b>
                  <small>{signal.en}</small>
                </span>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value={signal.value}
                  aria-label={`${signal.en} / ${signal.zh}`}
                  data-signal={signal.key}
                  style={`--signal-value:${signal.value}%`}
                />
              </label>
            ))
          }
        </div>

        <article class="letter" aria-live="polite">
          <div class="letter__label">今日银信 · Weather letter / local preview</div>
          <blockquote>
            <p data-letter-zh lang="zh-CN">灶火很暖，远方的人也被算作一桌。</p>
            <p data-letter-en>
              The kitchen is warm; those far away still count at the table.
            </p>
          </blockquote>
          <div class="letter__foot">
            <span>No name · no account · no location stored</span>
            <span>PointCast edition stays on this device</span>
          </div>
        </article>
      </section>

      <section class="relay" aria-labelledby="relay-title">
        <div class="relay__mark" aria-hidden="true">Q</div>
        <div>
          <p class="section-label">02 / Qwen dusk relay · 通义黄昏中继</p>
          <h2 id="relay-title">
            Qwen does not speak for the community.<br />
