---
/**
 * /sites — the public sites Mike runs, as one list, so every property can link
 * to the others from one source of truth (src/data/sites.json → /sites.json).
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import data from '../data/sites.json';
const title = 'Sites';
const description = 'The public sites Mike Hoydich runs: PointCast, Industry Next, Office Noun, Tone Bloom and the tez-experiments ladder, each with its machine door.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sites by Mike Hoydich',
  url: 'https://pointcast.xyz/sites/',
  numberOfItems: data.sites.length,
  itemListElement: data.sites.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: s.url })),
};
---
<BlockLayout title={title} description={description} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/sites.json', title: 'Sites (JSON)' }]}>
  <main class="sites">
    <nav class="crumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>sites</span></nav>
    <header>
      <p class="kicker">ONE LIST · UPDATED {data.updated}</p>
      <h1>The sites.</h1>
      <p class="dek">{data.note}</p>
    </header>
    <ol class="list">
      {data.sites.map((s) => (
        <li>
          <h2><a href={s.url}>{s.name}</a></h2>
          <p>{s.line}</p>
          <p class="meta">
            <a href={s.url}>{s.url.replace(/^https:\/\//, '').replace(/\/$/, '')}</a>
            {s.repo && s.repo !== s.url && <> · <a href={s.repo}>source</a></>}
            {s.machine && <> · <a href={s.machine}>machine door</a></>}
          </p>
        </li>
      ))}
    </ol>
    <p class="foot">Machine-readable: <a href="/sites.json">/sites.json</a>. Written by cc for PointCast; descriptions are each site’s own words.</p>
  </main>
</BlockLayout>
<style>
  .sites{max-width:760px;margin:0 auto;padding:48px 20px 80px;line-height:1.6}
  .crumb{display:flex;gap:10px;font-size:13px;margin-bottom:28px}.crumb span{opacity:.5}
  .kicker{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.08em;opacity:.7;margin:0 0 10px}
  h1{font-size:clamp(40px,7vw,64px);line-height:1;letter-spacing:-.04em;margin:0 0 16px}
  .dek{max-width:620px;margin:0 0 36px}
  .list{list-style:none;padding:0;margin:0;display:grid;gap:22px}
  .list li{border-top:1px solid currentColor;padding-top:18px}
  .list h2{font-size:24px;margin:0 0 6px;letter-spacing:-.02em}.list h2 a{text-decoration:none}
  .list p{margin:0 0 6px}.meta{font-size:13px;opacity:.8}
  .foot{margin-top:40px;font-size:13px;opacity:.8;border-top:1px solid currentColor;padding-top:16px}
</style>
