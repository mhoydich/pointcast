---
/**
 * /prayer-candles — The Votive.
 *
 * Per Mike 2026-07-19: "this was very cool, can you try a next"
 *
 * Fourth room of the prayer wing. The chambers pray, the bells play —
 * this room *keeps*. Light a votive under one of the eleven stations
 * and it burns for 24 real hours where everyone can see it. The wall
 * is shared: every visitor sees the same flames, newest first, each
 * tinted by its station.
 *
 * Seven stained-glass windows above the wall cycle 14 more pieces
 * from the Midjourney session of 2026-07-18 (98 of 455 now placed).
 *
 * Lighting a candle is also a prayer — it posts to both /api/votive
 * (the 24h wall) and /api/prayer (the perpetual ledger).
 *
 * Rooms so far: indigo morning, ember evening, verdigris bells, and
 * this — the oxblood votive hall.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import RoomPresenceChip from '../components/RoomPresenceChip.astro';

const title = 'Prayer Candles · The Votive · PointCast';
const description =
  'A shared candle wall — light a votive for one of eleven intentions and it burns 24 real hours where everyone can see it. Stained-glass Midjourney windows above.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Prayer Candles — The Votive',
  url: 'https://pointcast.xyz/prayer-candles',
  description,
  applicationCategory: 'MultimediaApplication',
};

// The eleven stations of the wing, with their devotions and accents.
const INTENTIONS = [
  { key: 'matins', name: 'the doorway', line: 'for what waits beyond the door', accent: '#9b7bff' },
  { key: 'lauds', name: 'the praise', line: 'for the sun that returns', accent: '#f6c15e' },
  { key: 'prime', name: 'the steadiness', line: 'for the day begun quietly', accent: '#9db8a1' },
  { key: 'terce', name: 'the courage', line: 'for strength when the set rolls in', accent: '#e0603a' },
  { key: 'sext', name: 'the clarity', line: 'for order in the bright noon', accent: '#3a7bd5' },
  { key: 'none', name: 'the patience', line: 'for the slow hours that still count', accent: '#e0a83c' },
  { key: 'vespers', name: 'the thanksgiving', line: 'for the day as it sets', accent: '#ff7a59' },
  { key: 'lucernarium', name: 'the kindling', line: 'for the small lights we keep', accent: '#ffd98e' },
  { key: 'compline', name: 'the release', line: 'for laying the day down', accent: '#8a63c9' },
  { key: 'vigil', name: 'the watch', line: 'for those awake while others sleep', accent: '#4a6bb5' },
  { key: 'angelus', name: 'the bell', line: 'for the whole day at once', accent: '#d4a437' },
];

const WINDOW_ALTS: Array<[string, string]> = [
  ['Pink and teal patchwork falling to a soft sea', 'Green patch morning with rocks going gold'],
  ['Orange-paneled house with stairs down the bluff', 'White modern house floating over pink rocks'],
  ['Gold octagon sun over a dark tide rock', 'Monolith standing in the channel under warm panels'],
  ['Pale quilt of rock and sand at the waterline', 'Sea stack wrapped in evening color squares'],
  ['Striped signal field over mint tide rocks', 'Gold-leaf weather over a low tide line'],
  ['Color columns climbing the sea cliff', 'Lone pine keeping the collaged cove'],
  ['Round house in a patchwork of village walls', 'Blueprint grid holding three grey rocks'],
];
---

<BlockLayout title={title} description={description} image="/images/og-prayer-candles.png" jsonLd={jsonLd}>
  <main class="pv" id="pv-main">
    <RoomPresenceChip surface="votive" />

    <header class="pv__header">
      <div class="pv__chrome">
        <span class="pv__chrome-label">THE VOTIVE</span>
        <span class="pv__sep">·</span>
        <span class="pv__chrome-label">BURNING</span>
        <span class="pv__stat" id="pv-burning">—</span>
        <span class="pv__sep">·</span>
        <span class="pv__chrome-label">EVER LIT</span>
        <span class="pv__stat" id="pv-total">—</span>
      </div>
      <h1 class="pv__title">PRAYER CANDLES</h1>
      <p class="pv__tagline">
        light a votive and it burns twenty-four real hours where everyone can
        see it · the chambers keep the hours at
        <a href="/prayer-altars">/prayer-altars</a> and
        <a href="/prayer-altars-evening">/prayer-altars-evening</a> · the bells
        hang at <a href="/prayer-bells">/prayer-bells</a>
      </p>
    </header>

    <section class="pv__windows" aria-label="Stained-glass windows">
      {WINDOW_ALTS.map(([altA, altB], i) => (
        <div class="pv__window" data-window>
          <img class="pv__window-img pv__window-img--on" src={`/images/prayer-candles/window-${i + 1}a.jpg`} alt={altA} loading={i < 3 ? 'eager' : 'lazy'} />
          <img class="pv__window-img" src={`/images/prayer-candles/window-${i + 1}b.jpg`} alt={altB} loading="lazy" />
        </div>
      ))}
    </section>

    <section class="pv__light" aria-label="Light a candle">
      <h2 class="pv__light-title">LIGHT A CANDLE</h2>
      <p class="pv__light-sub">choose an intention · one candle a minute</p>
      <div class="pv__intentions">
        {INTENTIONS.map((n) => (
          <button class="pv__intent" type="button" data-station={n.key} style={`--pv-accent:${n.accent}`}>
            <span class="pv__intent-name">{n.name}</span>
            <span class="pv__intent-line">{n.line}</span>
          </button>
        ))}
      </div>
      <p class="pv__light-status" id="pv-status" aria-live="polite"></p>
    </section>

    <section class="pv__wall-wrap">
      <header class="pv__wall-header">
        <span class="pv__wall-title">THE WALL</span>
        <span class="pv__wall-sub">every flame is someone · newest first</span>
      </header>
      <div class="pv__wall" id="pv-wall" aria-live="polite">
        <p class="pv__empty" id="pv-empty">— the wall waits for its first flame —</p>
      </div>
      <p class="pv__more" id="pv-more" hidden></p>
    </section>

    <section class="pv__how">
      <h2>HOW THIS WORKS</h2>
      <ol class="pv__how-list">
        <li>
          Pick one of the eleven intentions — the ten hours of the
          <a href="/prayer-altars">morning</a> and
          <a href="/prayer-altars-evening">evening</a> chambers, plus
          <em>the bell</em> of <a href="/prayer-bells">the Angelus</a> — and
          light a candle. It appears on the wall for everyone, tinted by its
          station, and burns out after twenty-four real hours.
        </li>
        <li>
          Lighting a candle is also a prayer — it counts on the wing's
          perpetual ledger. One candle a minute; flames are honest work.
        </li>
        <li>
          The seven windows above hold fourteen more pieces of Mike's
          Midjourney session of July 18 — ninety-eight of its four hundred
          fifty-five now hang across the wing. The walk winds at
          <a href="/prayer-labyrinth">/prayer-labyrinth</a>. The whole session lives at
          <a href="/gallery">/gallery</a>.
        </li>
        <li>
          Hover any flame to see its intention and age. Candles are anonymous
          beyond a six-character ember of a session id. Nothing else is kept.
        </li>
      </ol>
      <p class="pv__blessing">peace be with you</p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  /* Oxblood votive hall — fourth room of the prayer wing. */
  body:has(#pv-main) {
    background: #190a0e;
  }

  .pv {
    --pv-ox: #190a0e;
    --pv-ox-deep: #0a0406;
    --pv-ox-mid: #33141c;
    --pv-brass: #d4a437;
    --pv-brass-soft: #b8862c;
    --pv-brass-deep: #6b4d12;
    --pv-flame: #f6c15e;
    --pv-flame-tip: #ff6b3a;
    --pv-ink-light: #eee3d7;
    --pv-ink-mid: #bca795;
    --pv-ink-dim: #7d685c;
    --pv-rule-soft: rgba(212, 164, 55, 0.18);
    --pv-glow: rgba(255, 120, 140, 0.07);

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 32px 80px;
    color: var(--pv-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 120, 140, 0.09), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(246, 193, 94, 0.08), transparent 70%),
      linear-gradient(180deg, var(--pv-ox) 0%, var(--pv-ox-deep) 100%);
  }

  .pv::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18px 26px, var(--pv-glow) 1px, transparent 1.5px),
      radial-gradient(circle at 64px 58px, var(--pv-glow) 1px, transparent 1.5px);
    background-size: 84px 84px;
    opacity: 0.6;
    z-index: -1;
  }

  /* ── Header ───────────────────────────────────────────── */
  .pv__header {
    text-align: center;
    padding: 36px 16px 24px;
    border-bottom: 1px solid var(--pv-rule-soft);
    margin-bottom: 24px;
  }
  .pv__chrome {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border: 1.5px solid var(--pv-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pv-ink-mid);
    background: rgba(0, 0, 0, 0.3);
  }
  .pv__chrome-label { color: var(--pv-ink-dim); }
  .pv__stat { color: var(--pv-brass); font-weight: 700; }
  .pv__sep { color: var(--pv-brass-deep); }

  .pv__title {
    margin: 14px 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--pv-brass);
    text-shadow:
      0 0 24px rgba(212, 164, 55, 0.35),
      0 2px 0 var(--pv-ox-deep);
  }
  .pv__tagline {
    margin: 0 auto;
    max-width: 720px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--pv-ink-mid);
  }
  .pv__tagline a { color: var(--pv-brass); }

  /* ── Windows ──────────────────────────────────────────── */
  .pv__windows {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
    padding: 4px 8px 26px;
    border-bottom: 1px solid var(--pv-rule-soft);
    margin-bottom: 26px;
  }
  @media (max-width: 980px) {
    .pv__windows { grid-template-columns: repeat(4, 1fr); }
    .pv__windows .pv__window:nth-child(n+5) { display: none; }
  }
  @media (max-width: 520px) {
    .pv__windows { grid-template-columns: repeat(3, 1fr); }
    .pv__windows .pv__window:nth-child(n+4) { display: none; }
  }
  .pv__window {
    aspect-ratio: 1 / 1.55;
    position: relative;
    overflow: hidden;
    border-radius: 999px 999px 6px 6px;
    background: var(--pv-ox-deep);
    box-shadow:
      0 0 0 2px var(--pv-ox-deep),
      0 0 0 4px var(--pv-brass-deep),
      inset 0 0 30px rgba(0, 0, 0, 0.45),
      0 6px 18px rgba(0, 0, 0, 0.5);
  }
  .pv__window-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1800ms ease-in-out;
    filter: saturate(1.12) contrast(1.04);
  }
  .pv__window-img--on { opacity: 1; }
  .pv__window::after {
    /* leading — the glass came in panes */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(rgba(10, 4, 6, 0.55), transparent 3px) 0 33% / 100% 100% no-repeat,
      linear-gradient(rgba(10, 4, 6, 0.55), transparent 3px) 0 66% / 100% 100% no-repeat,
      linear-gradient(90deg, rgba(10, 4, 6, 0.55), transparent 3px) 50% 0 / 100% 100% no-repeat;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  /* ── Light panel ──────────────────────────────────────── */
  .pv__light { text-align: center; margin-bottom: 34px; }
  .pv__light-title {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 24px;
    color: var(--pv-brass);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .pv__light-sub {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--pv-ink-dim);
    margin-bottom: 16px;
  }
  .pv__intentions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 900px;
    margin-inline: auto;
  }
  .pv__intent {
    appearance: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 14px;
    border: 1.5px solid var(--pv-brass-deep);
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0;
    transition: border-color 120ms, box-shadow 120ms, transform 80ms;
  }
  .pv__intent:hover {
    border-color: var(--pv-accent, var(--pv-brass));
    box-shadow: 0 0 14px color-mix(in srgb, var(--pv-accent, #d4a437) 35%, transparent);
  }
  .pv__intent:active { transform: translateY(2px); }
  .pv__intent:disabled { cursor: wait; opacity: 0.45; }
  .pv__intent-name {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: var(--pv-accent, var(--pv-flame));
  }
  .pv__intent-line {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 10.5px;
    color: var(--pv-ink-dim);
  }
  .pv__light-status {
    margin-top: 14px;
    min-height: 20px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: var(--pv-flame);
  }

  /* ── The wall ─────────────────────────────────────────── */
  .pv__wall-wrap {
    border-top: 1px solid var(--pv-rule-soft);
    padding-top: 22px;
  }
  .pv__wall-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .pv__wall-title {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.30em;
    color: var(--pv-brass);
  }
  .pv__wall-sub {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 12px;
    color: var(--pv-ink-dim);
  }
  .pv__wall {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 14px;
    align-items: flex-end;
    justify-content: center;
    min-height: 120px;
    padding: 18px 10px 26px;
    background:
      linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 100%);
    border-radius: 4px;
  }
  .pv__empty {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    color: var(--pv-ink-dim);
    align-self: center;
  }
  .pv__candle {
    position: relative;
    width: 26px;
    height: 58px;
    flex-shrink: 0;
  }
  .pv__candle .cup {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 34px;
    border-radius: 4px 4px 8px 8px;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--pv-c, #d4a437) 55%, rgba(255,255,255,0.12)) 0%,
        color-mix(in srgb, var(--pv-c, #d4a437) 30%, rgba(0,0,0,0.55)) 100%);
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 0.25),
      inset 0 -3px 6px rgba(0, 0, 0, 0.5),
      0 0 10px color-mix(in srgb, var(--pv-c, #d4a437) 30%, transparent);
  }
  .pv__candle .flame {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 14px;
    background: radial-gradient(ellipse 4px 8px at 50% 70%, var(--pv-flame-tip) 0%, var(--pv-flame) 50%, transparent 75%);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.4px);
    animation: pv-flicker 1.7s ease-in-out infinite;
    animation-delay: var(--pv-d, 0s);
    transform-origin: 50% 100%;
  }
  .pv__candle.pv__candle--dim .flame {
    opacity: 0.65;
    height: 11px;
  }
  .pv__candle.pv__candle--new::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(246, 193, 94, 0.30), transparent 65%);
    animation: pv-halo 2.4s ease-out;
    pointer-events: none;
  }
  @keyframes pv-flicker {
    0%,100% { transform: translateX(-50%) scale(1, 1) rotate(0deg); opacity: 0.85; }
    25%     { transform: translateX(-50%) scale(0.95, 1.07) rotate(-2deg); opacity: 1; }
    50%     { transform: translateX(-50%) scale(1.05, 0.93) rotate(1.5deg); opacity: 0.9; }
    75%     { transform: translateX(-50%) scale(0.97, 1.03) rotate(-1deg); opacity: 1; }
  }
  @keyframes pv-halo {
    0% { opacity: 0; }
    20% { opacity: 1; }
    100% { opacity: 0; }
  }
  .pv__more {
    text-align: center;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.20em;
    color: var(--pv-ink-dim);
    margin-top: 10px;
  }

  /* ── How ──────────────────────────────────────────────── */
  .pv__how {
    margin-top: 48px;
    padding: 24px 16px;
    max-width: 820px;
    margin-inline: auto;
    border-top: 1px solid var(--pv-rule-soft);
  }
  .pv__how h2 {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 24px;
    color: var(--pv-brass);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }
  .pv__how-list { list-style: decimal; padding-left: 22px; margin: 0; }
  .pv__how-list li {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--pv-ink-mid);
    margin-bottom: 10px;
  }
  .pv__how-list em { color: var(--pv-flame); font-style: italic; font-weight: 500; }
  .pv__how-list a { color: var(--pv-brass); }
  .pv__blessing {
    margin-top: 28px;
    text-align: center;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--pv-ink-dim);
    letter-spacing: 0.08em;
  }
</style>

<script>
  // ── Identity ─────────────────────────────────────────────
  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) {
        sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(SID_KEY, sid);
      }
      return sid;
    } catch {
      return 'sid-anon-' + Date.now();
    }
  }
  const SID = ensureSid();

  const ACCENTS: Record<string, string> = {
    matins: '#9b7bff', lauds: '#f6c15e', prime: '#9db8a1', terce: '#e0603a', sext: '#3a7bd5',
    none: '#e0a83c', vespers: '#ff7a59', lucernarium: '#ffd98e', compline: '#8a63c9',
    vigil: '#4a6bb5', angelus: '#d4a437',
  };
  const NAMES: Record<string, string> = {
    matins: 'the doorway', lauds: 'the praise', prime: 'the steadiness', terce: 'the courage',
    sext: 'the clarity', none: 'the patience', vespers: 'the thanksgiving',
    lucernarium: 'the kindling', compline: 'the release', vigil: 'the watch', angelus: 'the bell',
  };

  // ── Window slideshows ────────────────────────────────────
  document.querySelectorAll('[data-window]').forEach((w, i) => {
    setTimeout(() => {
      setInterval(() => {
        const imgs = w.querySelectorAll('.pv__window-img');
        imgs[0]?.classList.toggle('pv__window-img--on');
        imgs[1]?.classList.toggle('pv__window-img--on');
      }, 9000);
    }, i * 1300);
  });

  // ── A small strike-match tone for lighting ───────────────
  let actx: AudioContext | null = null;
  function lightTone() {
    try {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx.state === 'suspended') actx.resume();
      const a = actx; const t = a.currentTime;
      // strike: short noise scratch
      const buf = a.createBuffer(1, a.sampleRate * 0.12, a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const src = a.createBufferSource(); src.buffer = buf;
      const bp = a.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2600; bp.Q.value = 1.2;
      const ng = a.createGain(); ng.gain.value = 0.10;
      src.connect(bp).connect(ng).connect(a.destination); src.start(t);
      // bloom: soft warm tone as the flame takes
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 523.25;
      const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 784.0;
      const g = a.createGain();
      g.gain.setValueAtTime(0.0001, t + 0.1);
      g.gain.linearRampToValueAtTime(0.14, t + 0.35);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 2.2);
      o.connect(g); o2.connect(g); g.connect(a.destination);
      o.start(t + 0.1); o2.start(t + 0.1); o.stop(t + 2.3); o2.stop(t + 2.3);
    } catch {}
  }

  // ── Wall painting ────────────────────────────────────────
  const wall = document.getElementById('pv-wall');
  const emptyEl = document.getElementById('pv-empty');
  const moreEl = document.getElementById('pv-more');
  let lastNewestId: string | null = null;

  function ageStr(ms: number): string {
    const m = Math.floor(ms / 60000);
    if (m < 1) return 'just lit';
    if (m < 60) return `${m}m ago`;
    return `${Math.floor(m / 60)}h ago`;
  }

  function paintWall(state: any) {
    if (!wall) return;
    const candles = state.candles ?? [];
    if (emptyEl) emptyEl.hidden = candles.length > 0;
    // rebuild (≤160 nodes, cheap enough at poll cadence)
    wall.querySelectorAll('.pv__candle').forEach((n) => n.remove());
    const now = state.now ?? Date.now();
    candles.forEach((c: any, i: number) => {
      const el = document.createElement('div');
      el.className = 'pv__candle';
      const age = now - c.t;
      if (age > 18 * 3600 * 1000) el.classList.add('pv__candle--dim');
      if (i === 0 && c.id !== lastNewestId && age < 30000) el.classList.add('pv__candle--new');
      el.style.setProperty('--pv-c', ACCENTS[c.station] ?? '#d4a437');
      el.style.setProperty('--pv-d', `${(i * 0.37) % 1.7}s`);
      const label = `${NAMES[c.station] ?? c.station} · ${ageStr(age)} · ${String(c.pid).slice(0, 6)}…`;
      el.title = label;
      el.setAttribute('role', 'img');
      el.setAttribute('aria-label', `Candle for ${NAMES[c.station] ?? c.station}, lit ${ageStr(age)}`);
      el.innerHTML = '<div class="flame"></div><div class="cup"></div>';
      wall.appendChild(el);
    });
    if (candles.length > 0) lastNewestId = candles[0].id;
    const unseen = (state.burning ?? 0) - candles.length;
    if (moreEl) {
      moreEl.hidden = unseen <= 0;
      moreEl.textContent = unseen > 0 ? `+ ${unseen} MORE BURNING UNSEEN` : '';
    }
    const burnEl = document.getElementById('pv-burning');
    if (burnEl) burnEl.textContent = String(state.burning ?? 0);
    const totEl = document.getElementById('pv-total');
    if (totEl) totEl.textContent = String(state.total ?? 0);
  }

  async function fetchWall() {
    try {
      const r = await fetch('/api/votive', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) paintWall(j);
    } catch { /* offline */ }
  }

  // ── Lighting ─────────────────────────────────────────────
  const statusEl = document.getElementById('pv-status');
  const intentBtns = Array.from(document.querySelectorAll('[data-station]')) as HTMLButtonElement[];

  function setStatus(msg: string) {
    if (statusEl) statusEl.textContent = msg;
  }

  intentBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const station = btn.dataset.station ?? 'angelus';
      intentBtns.forEach((b) => { b.disabled = true; });
      lightTone();
      try {
        const r = await fetch('/api/votive', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: SID, station }),
        });
        const j = await r.json();
        if (j?.ok) {
          setStatus(`your candle is lit — ${NAMES[station]} · it burns until this hour tomorrow`);
          // a candle is also a prayer
          fetch('/api/prayer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId: SID, station }),
          }).catch(() => {});
          await fetchWall();
          setTimeout(() => { intentBtns.forEach((b) => { b.disabled = false; }); }, 60000);
          return;
        }
        if (j?.reason === 'rate-limited') {
          setStatus(`the wick is still warm — try again in ${j.retryAfterSec ?? 60}s`);
          setTimeout(() => { intentBtns.forEach((b) => { b.disabled = false; }); }, (j.retryAfterSec ?? 60) * 1000);
          return;
        }
        setStatus('the match did not take — try again');
        intentBtns.forEach((b) => { b.disabled = false; });
      } catch {
        setStatus('the match did not take — try again');
        intentBtns.forEach((b) => { b.disabled = false; });
      }
    });
  });

  // ── Polling ──────────────────────────────────────────────
  fetchWall();
  setInterval(fetchWall, 6000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) fetchWall();
  });
</script>
