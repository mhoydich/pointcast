---
import { BLOOM_META, BLOOM_FAMILIES, BLOOM_WORKS, BLOOM_PRICING, artSvg } from '../../lib/bloom-shop.mjs';

const canonical = `https://pointcast.xyz${BLOOM_META.route}`;
const description = `${BLOOM_META.subtitle}. A 20-work flower exhibition in five families for the El Segundo gallery. ${BLOOM_META.label}.`;
const viewer = BLOOM_WORKS.map((w) => ({ slug: w.slug, title: w.title, n: w.n, svg: artSvg(w.slug, w.title) }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{BLOOM_META.title} — {BLOOM_META.subtitle} | PointCast</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={`${BLOOM_META.title} — ${BLOOM_META.subtitle}`} />
  <meta property="og:description" content={description} />
  <link rel="alternate" type="application/json" href="/bloom-shop.json" />
  <style is:global>
    :root { --haze:#EDE8DD; --ink:#141414; --orange:#E8552B; --navy:#1F2A3A; --soft:#5b5850; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--haze); color:var(--ink); font-family: ui-sans-serif, "Helvetica Neue", Helvetica, Arial, sans-serif; }
    a { color:inherit; }
    .wrap { max-width:1180px; margin:0 auto; padding:0 16px; }
    .label { display:inline-block; font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; border:1.5px solid var(--ink); padding:.3em .6em; }
    .label b { color:var(--orange); }
    svg { display:block; width:100%; height:auto; }
  </style>
  <style>
    header.top { padding:48px 0 28px; border-bottom:1.5px solid var(--ink); }
    .kicker { font-size:.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--soft); }
    h1 { font-size:clamp(2.6rem,9vw,6.4rem); line-height:.9; margin:.15em 0 .1em; letter-spacing:-.03em; }
    h1 span { color:var(--orange); }
    .sub { font-size:1.15rem; margin:0 0 1rem; }
    .story { max-width:46rem; line-height:1.55; color:#2b2a27; }
    .family { padding:40px 0 8px; }
    .fhead { display:flex; gap:14px; align-items:baseline; flex-wrap:wrap; margin-bottom:14px; }
    .chip { width:14px; height:14px; display:inline-block; }
    .fhead h2 { margin:0; font-size:1.5rem; }
    .fhead p { margin:0; color:var(--soft); }
    .grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
    @media (max-width:820px) { .grid { grid-template-columns:repeat(2,1fr); } }
    .card { text-decoration:none; }
    .card button { all:unset; cursor:zoom-in; display:block; width:100%; box-shadow:0 1px 0 rgba(0,0,0,.08); }
    .card button:focus-visible { outline:3px solid var(--orange); outline-offset:3px; }
    .meta { display:flex; justify-content:space-between; gap:8px; font-size:.85rem; padding:8px 0; }
    .meta a { text-decoration:none; font-weight:600; }
    .meta a:hover { color:var(--orange); }
    .pricing { margin:56px 0; padding:28px 0; border-top:1.5px solid var(--ink); }
    table { border-collapse:collapse; width:100%; font-size:.9rem; }
    th, td { text-align:left; padding:8px 10px; border-bottom:1px solid rgba(0,0,0,.15); }
    .tablewrap { overflow-x:auto; }
    .note { color:var(--soft); font-size:.88rem; }
    footer { padding:24px 0 60px; font-size:.85rem; color:var(--soft); }
    /* full-screen viewer */
    dialog { border:0; padding:0; width:100vw; height:100vh; max-width:none; max-height:none; background:#0d0d0d; color:#f1ece2; }
    dialog::backdrop { background:#0d0d0d; }
    .stage { position:absolute; inset:0 0 56px; display:flex; align-items:center; justify-content:center; padding:16px; }
    .stage svg { width:auto; height:100%; max-width:100%; }
    .bar { position:absolute; left:0; right:0; bottom:0; height:56px; display:flex; align-items:center; gap:10px; padding:0 16px; font-size:.9rem; }
    .bar .t { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bar button, .bar a { background:none; border:1px solid #f1ece2; color:#f1ece2; padding:6px 12px; cursor:pointer; text-decoration:none; font:inherit; }
  </style>
</head>
<body>
  <header class="top">
    <div class="wrap">
      <div class="kicker">PointCast Gallery · El Segundo</div>
      <h1>BLOOM<span>·</span>SHOP</h1>
      <p class="sub">{BLOOM_META.subtitle}. Twenty works, five workbenches.</p>
      <p class="story">{BLOOM_META.story}</p>
      <span class="label"><b>●</b> {BLOOM_META.label}</span>
    </div>
  </header>

  <main class="wrap">
    {BLOOM_FAMILIES.map((f, fi) => (
      <section class="family" id={f.id}>
        <div class="fhead">
          <span class="chip" style={`background:${f.chip}`}></span>
          <h2>{['I', 'II', 'III', 'IV', 'V'][fi]} · {f.name}</h2>
          <p>{f.tradition}. {f.intro}</p>
        </div>
        <div class="grid">
          {BLOOM_WORKS.filter((w) => w.family === f.id).map((w) => (
            <div class="card">
              <button type="button" data-open={w.n - 1} aria-label={`View ${w.title} full screen`} set:html={artSvg(w.slug, w.title)} />
              <div class="meta"><a href={`/bloom-shop/${w.slug}`}>{w.n}. {w.title}</a><span>View →</span></div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="pricing" id="prints">
      <h2>Prints</h2>
      <p class="note">Draft pricing scenarios, not offers. Production costs are estimates waiting on vendor quotes. Nothing is for sale until prices, editions, fulfillment and terms are approved.</p>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Size</th><th>Est. cost</th><th>Est. ship</th><th>Open edition</th><th>Edition of 50</th><th>Edition of 10, framed</th></tr></thead>
          <tbody>
            {BLOOM_PRICING.sizes.map((s) => (
              <tr><td>{s.size}</td><td>${s.cost}</td><td>${s.ship}</td><td>{s.open ? `$${s.open}` : '—'}</td><td>${s.ed50}</td><td>{s.ed10 ? `$${s.ed10}` : '—'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="wrap">
    {BLOOM_META.credit} Works shown are vector studies; full-resolution print masters will be generated from each work's prompt. · <a href="/bloom-shop.json">bloom-shop.json</a>
  </footer>

  <dialog id="viewer" aria-label="Full-screen viewer">
    <div class="stage" id="stage"></div>
    <div class="bar">
      <button type="button" id="prev" aria-label="Previous">←</button>
      <button type="button" id="next" aria-label="Next">→</button>
      <span class="t" id="vt"></span>
      <a id="vlink" href="#">Details</a>
      <button type="button" id="fs">Fullscreen</button>
      <button type="button" id="close" aria-label="Close">✕</button>
    </div>
  </dialog>

  <script is:inline define:vars={{ viewer }}>
    const dlg = document.getElementById('viewer');
    const stage = document.getElementById('stage');
    let i = 0;
    const show = (k) => {
      i = (k + viewer.length) % viewer.length;
      const w = viewer[i];
      stage.innerHTML = w.svg;
      document.getElementById('vt').textContent = `${w.n} / 20 · ${w.title} · AI-generated digital art`;
      document.getElementById('vlink').href = `/bloom-shop/${w.slug}`;
    };
    document.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => { show(+b.dataset.open); dlg.showModal(); }));
    document.getElementById('prev').onclick = () => show(i - 1);
    document.getElementById('next').onclick = () => show(i + 1);
    document.getElementById('close').onclick = () => dlg.close();
    document.getElementById('fs').onclick = () => (document.fullscreenElement ? document.exitFullscreen() : dlg.requestFullscreen?.());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'f') document.getElementById('fs').click();
    });
    let x0 = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); x0 = null; });
  </script>
</body>
</html>
