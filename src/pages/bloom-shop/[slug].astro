---
import { BLOOM_META, BLOOM_WORKS, BLOOM_PRICING, artSvg, familyOf } from '../../lib/bloom-shop.mjs';

export function getStaticPaths() {
  return BLOOM_WORKS.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
const f = familyOf(w);
const prev = BLOOM_WORKS[(w.n - 2 + 20) % 20];
const next = BLOOM_WORKS[w.n % 20];
const canonical = `https://pointcast.xyz/bloom-shop/${w.slug}`;
const description = `${w.title} — ${w.description} A vector study from BLOOM SHOP, ${f.name}. Full-resolution print masters are not available. ${BLOOM_META.label}.`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{w.title} · {BLOOM_META.title} | PointCast</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <style>
    :root { --haze:#EDE8DD; --ink:#141414; --orange:#E8552B; --soft:#5b5850; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--haze); color:var(--ink); font-family: ui-sans-serif, "Helvetica Neue", Helvetica, Arial, sans-serif; }
    a { color:inherit; }
    .wrap { max-width:1180px; margin:0 auto; padding:24px 16px 60px; }
    nav { display:flex; justify-content:space-between; gap:12px; font-size:.85rem; margin-bottom:24px; flex-wrap:wrap; }
    nav a { text-decoration:none; }
    nav a:hover { color:var(--orange); }
    .layout { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:40px; align-items:start; }
    @media (max-width:820px) { .layout { grid-template-columns:1fr; } }
    .art :global(svg) { display:block; width:100%; height:auto; box-shadow:0 1px 0 rgba(0,0,0,.08); }
    .kicker { font-size:.75rem; letter-spacing:.18em; text-transform:uppercase; color:var(--soft); }
    h1 { font-size:clamp(2rem,5vw,3.2rem); line-height:1; margin:.2em 0 .4em; letter-spacing:-.02em; }
    .label { display:inline-block; font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; border:1.5px solid var(--ink); padding:.3em .6em; margin-bottom:18px; }
    .label b { color:var(--orange); }
    dl { display:grid; grid-template-columns:max-content 1fr; gap:6px 16px; font-size:.92rem; }
    dt { color:var(--soft); }
    dd { margin:0; }
    .sw { display:flex; gap:6px; }
    .sw span { width:26px; height:26px; border:1px solid rgba(0,0,0,.15); }
    fieldset { border:1.5px solid var(--ink); padding:16px; margin:24px 0 12px; }
    legend { padding:0 6px; font-weight:600; }
    label.opt { display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 8px; padding:6px 0; font-size:.92rem; border-bottom:1px solid rgba(0,0,0,.1); }
    .buy { display:block; width:100%; padding:14px; margin-top:14px; background:var(--ink); color:var(--haze); border:0; font:inherit; font-weight:600; letter-spacing:.06em; text-transform:uppercase; cursor:not-allowed; opacity:.85; }
    .note { color:var(--soft); font-size:.85rem; line-height:1.5; }
    details { margin-top:22px; font-size:.88rem; }
    code { background:rgba(0,0,0,.06); padding:2px 4px; display:block; white-space:pre-wrap; margin-top:8px; line-height:1.45; }
  </style>
</head>
<body>
  <div class="wrap">
    <nav>
      <a href="/bloom-shop">← BLOOM SHOP</a>
      <span><a href={`/bloom-shop/${prev.slug}`}>← {prev.title}</a> · <a href={`/bloom-shop/${next.slug}`}>{next.title} →</a></span>
    </nav>
    <div class="layout">
      <div class="art" set:html={artSvg(w.slug, w.title)} />
      <div>
        <div class="kicker">Work {w.n} of 20 · <a href={`/bloom-shop#${f.id}`}>{f.name}</a> · {f.tradition}</div>
        <h1>{w.title}</h1>
        <span class="label"><b>●</b> {BLOOM_META.label}</span>
        <p>{w.description}</p>
        <dl>
          <dt>Composition</dt><dd>{w.composition}</dd>
          <dt>Palette</dt><dd class="sw">{w.palette.map((c) => <span style={`background:${c}`} title={c}></span>)}</dd>
          <dt>Medium</dt><dd>Digital work; archival pigment print on cotton rag (proposed)</dd>
        </dl>

        <fieldset>
          <legend>Print sizes · draft pricing</legend>
          {BLOOM_PRICING.sizes.map((s) => (
            <label class="opt"><span><input type="radio" name="size" disabled /> {s.size}</span><span>{s.open ? `open $${s.open}` : ''}{s.open ? ' · ' : ''}ed. 50 ${s.ed50}{s.ed10 ? ` · framed ed. 10 $${s.ed10}` : ''}</span></label>
          ))}
          <button class="buy" type="button" disabled aria-disabled="true">Checkout not open yet</button>
        </fieldset>
        <p class="note">Prices, editions, fulfillment and terms are still being approved, so nothing can be bought yet. Prices shown are draft scenarios, not offers.</p>

        <details>
          <summary>Print-master prompt</summary>
          <code>{w.prompt}</code>
        </details>
        <p class="note">The image above is a vector study. Full-resolution print masters are not available. {BLOOM_META.credit}</p>
      </div>
    </div>
  </div>
</body>
</html>
