---
import BlockLayout from '../../layouts/BlockLayout.astro';
import atlas from '../../../public/atlas.json';

const title = 'The Atlas map';
const description = 'One open map of everything PointCast knows: courts, places, shrines, pages, bots and tools, drawn from atlas.json.';
const layers: any[] = Array.isArray((atlas as any)?.layers) ? (atlas as any).layers : [];
const alternates = [
  { type: 'application/json', href: '/atlas.json', title: 'PointCast atlas' },
  { type: 'application/json', href: '/atlas/index.json', title: 'Merged atlas index' },
];
---

<BlockLayout title={title} description={description} author="PointCast / Cartography" isolated immersive showNetworkStrip={false} alternates={alternates}>
  <link rel="stylesheet" href="/cartography/atlas-map.css" />
  <link rel="alternate" type="application/json" href="/atlas.json" />
  <main class="atlas-page">
    <nav class="masthead" aria-label="Cartography">
      <a href="/cartography">Cartography</a> · <a href="/cartography/atlas">Spec</a> · <a href="/atlas.json">atlas.json</a> · <a href="/atlas/index.json">atlas/index.json</a> · <a href="/api/mcp">/api/mcp</a>
    </nav>
    <h1>The Atlas</h1>
    <p>
      The Atlas is one open map of everything this site knows: places, courts, gear, events, shrines, pages, bots and tools, and how they link.
      It is a projection of datasets that already exist, and every record points back to a public source. The map is centered on El Segundo City Hall with a
      25-mile ring; distances are straight-line (as the crow flies), not drive time. Data is CC0 unless a record says otherwise.
    </p>
    <p class="toggle" aria-label="Scope">
      <a href="?" id="scope-this">This site</a> · <a href="?site=all" id="scope-all">All sites</a>
    </p>
    <div id="atlas" data-atlas="/atlas.json" data-index="/atlas/index.json" data-site="pointcast.xyz"></div>

    <section>
      <h2>Layers</h2>
      {layers.length === 0 ? (
        <p>No layers have been built yet.</p>
      ) : (
        <div class="tbl"><table>
          <thead><tr><th>Id</th><th>Name</th><th>Count</th><th>Inline</th><th>Updated</th><th>License</th><th>Data</th></tr></thead>
          <tbody>
            {layers.map((l) => (
              <tr>
                <td><code>{l.id}</code></td><td>{l.name}</td><td>{l.count ?? ''}</td><td>{l.inline ? 'yes' : 'no'}</td>
                <td>{l.updated ?? ''}</td><td>{l.license ?? ''}</td>
                <td>{l.data ? <a href={l.data}>data</a> : ''}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )}
    </section>

    <section>
      <h2>For bots</h2>
      <p>Read the JSON: <a href="/atlas.json">/atlas.json</a>, <a href="/atlas/index.json">/atlas/index.json</a>, <a href="/atlas/schema.json">/atlas/schema.json</a>. Read-only MCP tools at <a href="/api/mcp">/api/mcp</a>:</p>
      <ul>
        <li><code>atlas_search</code>: find records by words, type or layer.</li>
        <li><code>atlas_get</code>: fetch one record by id.</li>
        <li><code>atlas_near</code>: records within a distance of a point, straight-line miles.</li>
        <li><code>atlas_links</code>: records linked to a given id.</li>
      </ul>
    </section>

    <section>
      <h2>Suggest a layer</h2>
      <p>Suggestions come in as pull requests: <a href="https://github.com/mhoydich/pointcast/pulls">github.com/mhoydich/pointcast/pulls</a>. Candidates are ranked in <a href="https://github.com/mhoydich/pointcast/blob/main/docs/cartography/NEXT-20-LAYERS.md">docs/cartography/NEXT-20-LAYERS.md</a>.</p>
    </section>

    <p class="not-official">PointCast is an independent project. Not an official City of El Segundo page.</p>
  </main>
  <script is:inline src="/cartography/atlas-map.js" defer></script>
  <script is:inline>
    (function () {
      var all = new URLSearchParams(location.search).get('site') === 'all';
      var a = document.getElementById(all ? 'scope-all' : 'scope-this');
      if (a) { a.style.fontWeight = '700'; a.setAttribute('aria-current', 'page'); }
    })();
  </script>
  <style>
    .atlas-page { max-width: 1100px; margin: 0 auto; padding: 24px 16px 80px; color: #12110e; line-height: 1.5; }
    .masthead { font: 12px var(--pc-font-mono, monospace); text-transform: uppercase; color: #65625a; margin-bottom: 16px; }
    h1 { font-size: clamp(34px, 7vw, 56px); margin: 0 0 12px; line-height: 1; }
    h2 { font-size: 22px; margin: 32px 0 10px; }
    a { color: #185fa5; }
    .toggle { margin: 12px 0; }
    .tbl { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; font-size: 14px; }
    th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #d8d4ca; white-space: nowrap; }
    .not-official { margin-top: 32px; color: #65625a; font-size: 13px; }
  </style>
</BlockLayout>
