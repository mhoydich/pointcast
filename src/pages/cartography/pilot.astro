---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { cartographyPilotOffer } from '../../lib/cartography-sprint';

const title = '$50k Cartography Pilot';
const description =
  'A paid PointCast Cartography pilot offer for brands and agencies that need permissioned profile maps, opportunity routes, campaign shortlists, and contribution receipts.';

function money(value: number): string {
  return `$${value.toLocaleString('en-US')}`;
}

const alternates = [
  { type: 'application/json', href: '/cartography/pilot.json', title: 'Cartography pilot offer JSON' },
  { type: 'application/json', href: '/cartography/sprint.json', title: 'Cartography sprint JSON' },
];
---

<BlockLayout
  title={title}
  description={description}
  alternates={alternates}
  image="/images/og/b/0443.png"
>
  <main class="pilot">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <span>Pilot</span>
    </nav>

    <header class="offer">
      <section class="offer__copy">
        <p class="kicker">PAID PILOT · 14 DAYS · BRAND ATLAS WEDGE</p>
        <h1>{cartographyPilotOffer.title}</h1>
        <p class="dek">{cartographyPilotOffer.promise}</p>
        <div class="actions" aria-label="Pilot actions">
          <a class="button button--primary" href={cartographyPilotOffer.cta}>Request pilot</a>
          <a class="button" href="/cartography/pilot.json">Offer JSON</a>
          <a class="button" href="/cartography/sprint">Sprint board</a>
        </div>
      </section>
      <aside class="price-panel" aria-label="Pilot price">
        <img src="https://noun.pics/443.svg" alt="" loading="lazy" />
        <div>
          <span>PRICE</span>
          <strong>{money(cartographyPilotOffer.priceUsd)}</strong>
          <p>{cartographyPilotOffer.billing}</p>
        </div>
      </aside>
    </header>

    <section class="brief-grid" aria-label="Pilot brief">
      <article>
        <span>Buyer</span>
        <p>{cartographyPilotOffer.buyer}</p>
      </article>
      <article>
        <span>Timeline</span>
        <p>{cartographyPilotOffer.timeline}</p>
      </article>
      <article>
        <span>Payment rail</span>
        <p>{cartographyPilotOffer.paymentRail}</p>
      </article>
    </section>

    <section class="section" id="deliverables">
      <div class="section__head">
        <p class="kicker">DELIVERABLES</p>
        <h2>The pilot has to leave buyer-ready artifacts.</h2>
      </div>
      <ol class="deliverables">
        {cartographyPilotOffer.deliverables.map((item) => (
          <li>
            <time>{item.due}</time>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section split" id="qualification">
      <div class="section__head">
        <p class="kicker">QUALIFICATION</p>
        <h2>Right buyer, right data boundary, real next action.</h2>
      </div>
      <ul class="checks">
        {cartographyPilotOffer.qualification.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section split" id="acceptance">
      <div class="section__head">
        <p class="kicker">ACCEPTANCE GATES</p>
        <h2>No vague proof, no private spillover.</h2>
      </div>
      <ul class="checks checks--warm">
        {cartographyPilotOffer.acceptanceGates.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/pilot.json">/cartography/pilot.json</a></li>
        <li><a href="/cartography/sprint.json">/cartography/sprint.json</a></li>
        <li><a href="/cartography.json">/cartography.json</a></li>
        <li><a href="/join.json">/join.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .pilot {
      max-width: 1080px;
      margin: 0 auto;
      padding: 24px 18px 88px;
      color: #12110e;
    }

    .crumb,
    .kicker,
    .price-panel span,
    .brief-grid span,
    .deliverables time,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .offer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 20px;
      align-items: stretch;
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .offer__copy {
      padding: 24px;
      border: 1px solid #12110e;
      background: #fffdf5;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 700;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      max-width: 780px;
      font-size: 58px;
      line-height: 0.98;
    }

    .dek {
      max-width: 690px;
      margin: 14px 0 0;
      color: #38373a;
      font-size: 18px;
      line-height: 1.5;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 22px;
    }

    .button {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 0 14px;
      border: 1px solid #12110e;
      color: #12110e;
      background: #f7f8f2;
      text-decoration: none;
      font-weight: 700;
    }

    .button--primary {
      color: #fffdf5;
      background: #12110e;
    }

    .price-panel {
      display: grid;
      align-content: space-between;
      padding: 18px;
      border: 1px solid #12110e;
      background: #eef4fa;
    }

    .price-panel img {
      width: 96px;
      image-rendering: pixelated;
    }

    .price-panel strong {
      display: block;
      margin-top: 8px;
      font-size: 42px;
      line-height: 1;
    }

    .price-panel p {
      margin: 8px 0 0;
      color: #38373a;
    }

    .brief-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .brief-grid article {
      min-height: 150px;
      padding: 16px;
      border: 1px solid #d8d4ca;
      background: #f7f8f2;
    }

    .brief-grid span {
      color: #7d2f14;
      font-size: 10px;
      font-weight: 700;
    }

    .brief-grid p {
      margin: 10px 0 0;
      color: #38373a;
      line-height: 1.45;
    }

    .section {
      margin-top: 36px;
      padding-top: 26px;
      border-top: 1px solid #d8d4ca;
    }

    .section__head {
      max-width: 700px;
    }

    .section h2 {
      font-size: 32px;
      line-height: 1.06;
    }

    .deliverables {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }

    .deliverables li {
      min-height: 210px;
      padding: 14px;
      border: 1px solid #12110e;
      background: #fffdf5;
    }

    .deliverables time {
      color: #185fa5;
      font-size: 10px;
      font-weight: 700;
    }

    .deliverables h3 {
      margin-top: 12px;
      font-size: 18px;
      line-height: 1.12;
    }

    .deliverables p,
    .checks li {
      color: #38373a;
      line-height: 1.45;
    }

    .split {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }

    .checks {
      display: grid;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .checks li {
      padding: 14px;
      border-left: 4px solid #185fa5;
      background: #eef4fa;
    }

    .checks--warm li {
      border-left-color: #7d2f14;
      background: #fbefe9;
    }

    .agent-strip {
      margin-top: 32px;
      padding: 14px 0 0;
      border-top: 1px solid #d8d4ca;
      font-size: 11px;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
    }

    .agent-strip a {
      color: #185fa5;
    }

    @media (max-width: 860px) {
      .offer,
      .brief-grid,
      .split {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 42px;
      }

      .deliverables {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BlockLayout>
