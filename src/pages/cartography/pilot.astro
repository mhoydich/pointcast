---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { cartographyPilotOffer } from '../../lib/cartography-sprint';
const title = 'Cartography Pilot Archive';
const description = 'An archived PointCast Cartography planning page; no pilot is currently offered.';
const alternates = [{ type: 'application/json', href: '/cartography/pilot.json', title: 'Cartography pilot archive JSON' }];
---
<BlockLayout title={title} description={description} alternates={alternates} image="/images/og/b/0443.png" noindex={true}>
  <main><nav><a href="/">Home</a> / <a href="/cartography">Cartography</a> / Pilot</nav><p>ARCHIVE</p><h1>{cartographyPilotOffer.title}</h1><p>A May 2026 planning artifact. The commercial plan has been retired.</p><p><a href="/cartography">Return to the Cartography archive</a> · <a href="/cartography/pilot.json">Archive JSON</a></p></main>
  <style>main{max-width:760px;margin:0 auto;padding:32px 18px 88px;color:#12110e}nav,p:first-of-type{font:11px var(--pc-font-mono);text-transform:uppercase;color:#65625a}h1{font-size:clamp(42px,9vw,76px);line-height:.95}p{max-width:680px;font-size:20px;line-height:1.5}a{color:#185fa5}</style>
</BlockLayout>
