---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { cartographyDemo, cartographyJsonLd } from '../../lib/cartography-business';

const title = 'Cartography demo map';
const description =
  'A fictional, permissioned demo of a PointCast Cartography profile map, opportunity routes, and contribution receipts.';

const profile = cartographyDemo.profileMap;
const alternates = [
  { type: 'application/json', href: '/cartography/demo.json', title: 'Cartography demo JSON' },
  { type: 'application/json', href: '/cartography.json', title: 'Cartography business JSON' },
];
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={cartographyJsonLd}
  alternates={alternates}
  image="/images/og/b/0442.png"
>
  <main class="demo">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <span>Demo</span>
    </nav>

    <header class="hero">
      <section>
        <p class="kicker">PROFILE MAP · FICTIONAL DEMO</p>
        <h1>{profile.subject.displayName}</h1>
        <p class="dek">{profile.subject.label}. This page demonstrates the product shape without exposing a real person's private notes.</p>
      </section>
      <aside class="identity-card" aria-label="Profile summary">
        <img src="https://noun.pics/439.svg" alt="" loading="lazy" />
        <dl>
          <div>
            <dt>Home base</dt>
            <dd>{profile.subject.homeBase}</dd>
          </div>
          <div>
            <dt>Permission</dt>
            <dd>{profile.permission.status}</dd>
          </div>
          <div>
            <dt>Public page</dt>
            <dd><a href={profile.publicPage}>{profile.publicPage.replace('https://pointcast.xyz', '')}</a></dd>
          </div>
        </dl>
      </aside>
    </header>

    <section class="map" aria-label="Identity map">
      <div class="map__center">
        <span>{profile.subject.displayName}</span>
      </div>
      {profile.sourceLinks.map((source, index) => (
        <a class={`map__node map__node--${index + 1}`} href={source.url} target={source.url.includes('example.com') ? '_blank' : '_self'} rel="noopener">
          <strong>{source.kind}</strong>
          <span>{source.label}</span>
        </a>
      ))}
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">IDENTITY SIGNALS</p>
        <h2>Evidence first, no public trust score.</h2>
      </div>
      <div class="signals">
        {profile.identitySignals.map((signal) => (
          <article>
            <p>{signal.confidence} confidence</p>
            <h3>{signal.label}</h3>
            <ul>
              {signal.evidence.map((evidence) => <li>{evidence}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section routes">
      <div class="section__head">
        <p class="kicker">OPPORTUNITY ROUTES</p>
        <h2>The output is a commercial next action.</h2>
      </div>
      <div class="route-list">
        {cartographyDemo.opportunityRoutes.map((route) => (
          <article>
            <div class="route-list__top">
              <span>{route.id}</span>
              <strong>{route.yieldArtifact}</strong>
            </div>
            <h3>{route.buyer}</h3>
            <p>{route.need}</p>
            <p><strong>Next:</strong> {route.nextAction.owner} by {route.nextAction.due}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section receipts">
      <div class="section__head">
        <p class="kicker">CONTRIBUTION RECEIPT</p>
        <h2>Accepted work leaves a trail.</h2>
      </div>
      {cartographyDemo.contributionReceipts.map((receipt) => (
        <article class="receipt">
          <p class="receipt__id">{receipt.id}</p>
          <h3>{receipt.workType} -> {receipt.yieldType}</h3>
          <ul>
            {receipt.contributors.map((contributor) => (
              <li><strong>{contributor.name}</strong> ({contributor.kind}) - {contributor.contribution}</li>
            ))}
          </ul>
          <p>{receipt.financialDisclaimer}</p>
        </article>
      ))}
    </section>

    <section class="permissions" aria-label="Permission policy">
      <p class="kicker">PUBLIC DATA POLICY</p>
      <div>
        <h2>Private notes stay private.</h2>
        <p>{profile.privateNotesPolicy}</p>
      </div>
      <ul>
        <li><strong>Public fields:</strong> {profile.permission.publicFields.join(', ')}</li>
        <li><strong>Hidden fields:</strong> {profile.permission.hiddenFields.join(', ')}</li>
        <li><strong>Takedown:</strong> <a href={profile.permission.takedown}>{profile.permission.takedown.replace('https://pointcast.xyz', '')}</a></li>
      </ul>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/demo.json">/cartography/demo.json</a></li>
        <li><a href="/cartography.json">/cartography.json</a></li>
        <li><a href="/join.json">/join.json</a></li>
        <li><a href="/agents.json">/agents.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .demo {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 18px 88px;
    }

    .crumb,
    .kicker,
    .identity-card dt,
    .signals p,
    .route-list__top,
    .receipt__id,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 20px;
      align-items: end;
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 500;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      font-size: 54px;
      line-height: 1;
    }

    .dek {
      max-width: 620px;
      margin: 12px 0 0;
      color: #38373a;
      font-size: 17px;
      line-height: 1.5;
    }

    .identity-card {
      display: grid;
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 14px;
      padding: 14px;
      border: 1px solid #12110e;
      background: #fffdf5;
    }

    .identity-card img {
      width: 84px;
    }

    .identity-card dl {
      display: grid;
      gap: 8px;
      margin: 0;
    }

    .identity-card dt {
      color: #65625a;
      font-size: 10px;
    }

    .identity-card dd {
      margin: 2px 0 0;
      color: #38373a;
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .map {
      position: relative;
      min-height: 440px;
      margin-top: 24px;
      border: 1px solid #12110e;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(18,17,14,0.08) 1px, transparent 1px),
        linear-gradient(180deg, rgba(18,17,14,0.06) 1px, transparent 1px),
        #f7f8f2;
      background-size: 34px 34px;
    }

    .map::before,
    .map::after {
      content: "";
      position: absolute;
      inset: 84px 100px;
      border: 2px solid #d8d4ca;
      transform: rotate(-8deg);
    }

    .map::after {
      border-color: #b9cfe3;
      transform: rotate(12deg);
    }

    .map__center,
    .map__node {
      position: absolute;
      z-index: 2;
      border: 1px solid #12110e;
      background: #fff;
      box-shadow: 0 8px 20px rgba(18,17,14,0.08);
    }

    .map__center {
      left: 50%;
      top: 50%;
      width: 180px;
      min-height: 90px;
      display: grid;
      place-items: center;
      transform: translate(-50%, -50%);
      border-left: 6px solid #185fa5;
      font-size: 22px;
      font-weight: 500;
      text-align: center;
    }

    .map__node {
      display: grid;
      gap: 4px;
      width: 190px;
      min-height: 78px;
      padding: 10px;
      color: #12110e;
      text-decoration: none;
    }

    .map__node strong {
      color: #65625a;
      font-family: var(--pc-font-mono);
      font-size: 10px;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .map__node span {
      color: #38373a;
      font-size: 13px;
      line-height: 1.3;
    }

    .map__node--1 { left: 6%; top: 10%; border-left: 5px solid #185fa5; }
    .map__node--2 { right: 7%; top: 12%; border-left: 5px solid #8a2432; }
    .map__node--3 { left: 10%; bottom: 12%; border-left: 5px solid #0f6e56; }
    .map__node--4 { right: 12%; bottom: 14%; border-left: 5px solid #ba7517; }
    .map__node--5 { left: 40%; top: 8%; border-left: 5px solid #5f3dc4; }

    .section {
      margin-top: 32px;
    }

    .section__head {
      margin-bottom: 14px;
    }

    .section__head h2 {
      font-size: 30px;
      line-height: 1.08;
    }

    .signals,
    .route-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .signals article,
    .route-list article,
    .receipt,
    .permissions,
    .agent-strip {
      border: 1px solid #d8d4ca;
      background: #fff;
      padding: 15px;
    }

    .signals article {
      border-left: 5px solid #185fa5;
    }

    .signals p,
    .route-list__top,
    .receipt__id {
      margin: 0 0 10px;
      color: #65625a;
      font-size: 10px;
    }

    .signals h3,
    .route-list h3,
    .receipt h3 {
      font-size: 20px;
      line-height: 1.15;
    }

    .signals ul,
    .receipt ul,
    .permissions ul {
      margin: 12px 0 0;
      padding-left: 18px;
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    .route-list article {
      border-left: 5px solid #0f6e56;
    }

    .route-list__top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .route-list p,
    .receipt p,
    .permissions p {
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    .receipt {
      border-left: 5px solid #8a2432;
    }

    .permissions {
      display: grid;
      grid-template-columns: 220px minmax(0, 0.75fr) minmax(260px, 1fr);
      gap: 18px;
      margin-top: 32px;
      border-left: 5px solid #12110e;
      background: #fffdf5;
    }

    .permissions h2 {
      font-size: 24px;
    }

    .agent-strip {
      margin-top: 28px;
      font-size: 11px;
    }

    .agent-strip__label {
      margin: 0 0 8px;
      color: #65625a;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (max-width: 820px) {
      .hero,
      .signals,
      .route-list,
      .permissions {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 38px;
      }

      .map {
        min-height: 620px;
      }

      .map__center {
        top: 48%;
      }

      .map__node {
        width: min(210px, calc(100% - 32px));
      }

      .map__node--1 { left: 16px; top: 18px; }
      .map__node--2 { right: 16px; top: 120px; }
      .map__node--3 { left: 16px; bottom: 120px; }
      .map__node--4 { right: 16px; bottom: 18px; }
      .map__node--5 { left: 16px; top: 230px; }
    }
  </style>
</BlockLayout>
