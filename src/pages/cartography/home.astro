---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { HOME_CARTOGRAPHY, homeCartographyJsonLd } from '../../lib/home-cartography';

const title = 'Home Cartography - scan your home, own the index';
const description =
  'Concept: a device that scans and indexes everything in your home into a private, user-owned inventory exposed as a personal data API and MCP server.';

const alternates = [
  { type: 'application/json', href: '/cartography/home.json', title: 'Home Cartography concept JSON' },
  { type: 'application/json', href: '/cartography/home/demo.json', title: 'Home Cartography demo JSON' },
  { type: 'application/json', href: '/cartography/home/field-kit.json', title: 'Home Cartography field kit JSON' },
  { type: 'application/json', href: '/cartography.json', title: 'Cartography business JSON' },
];

const enableGroups = [
  { kicker: 'UTILITY', heading: 'The boring superpowers.', items: HOME_CARTOGRAPHY.enables.utility },
  { kicker: 'NEW INTERACTION MODELS', heading: 'Agents that know what you own.', items: HOME_CARTOGRAPHY.enables.interactionModels },
  { kicker: 'SCORING + RECOMMENDATIONS', heading: 'An honest mirror for your stuff.', items: HOME_CARTOGRAPHY.enables.scoring },
  { kicker: 'GAMES + ENTERTAINMENT', heading: 'Your inventory is a playground.', items: HOME_CARTOGRAPHY.enables.games },
];
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={homeCartographyJsonLd}
  alternates={alternates}
  image="/images/og/b/0442.png"
>
  <main class="home-carto">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <span>Home</span>
    </nav>

    <header class="hero">
      <section class="hero__copy">
        <p class="kicker">HOME CARTOGRAPHY · CONCEPT V0 · {HOME_CARTOGRAPHY.credit.toUpperCase()}</p>
        <h1>Your house gets a map. Your stuff gets a ledger.</h1>
        <p class="dek">{HOME_CARTOGRAPHY.summary}</p>
        <p class="sibling">{HOME_CARTOGRAPHY.siblingNote} See the <a href="/cartography/home/demo">fictional demo household</a> for the index in action, or use the <a href="/cartography/home/field-kit">field kit</a> to index one real room today.</p>
      </section>
      <aside class="survey-card" aria-label="Sample index entry">
        <p class="survey-card__label">SAMPLE INDEX ENTRY</p>
        <dl>
          <div><dt>Item</dt><dd>Cordless drill, 20V</dd></div>
          <div><dt>Location</dt><dd>Garage · shelf 2 · bin 3</dd></div>
          <div><dt>Provenance</dt><dd>2024-03-11 · $129 · receipt linked</dd></div>
          <div><dt>Warranty</dt><dd>3yr · expires 2027-03-11</dd></div>
          <div><dt>Est. value</dt><dd>$74 · comps refreshed weekly</dd></div>
        </dl>
      </aside>
    </header>

    <section class="section">
      <div class="section__head">
        <p class="kicker">THE DEVICE</p>
        <h2>The device is the wedge. The index is the product.</h2>
        <p>{HOME_CARTOGRAPHY.device.posture}</p>
      </div>
      <div class="cards cards--4">
        {HOME_CARTOGRAPHY.device.capabilities.map((cap) => (
          <article>
            <h3>{cap.label}</h3>
            <p>{cap.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">THE HOME INDEX</p>
        <h2>Every object, structured and user-owned.</h2>
      </div>
      <div class="cards cards--3">
        {HOME_CARTOGRAPHY.indexFields.map((field) => (
          <article>
            <h3>{field.label}</h3>
            <p>{field.detail}</p>
          </article>
        ))}
      </div>
      <aside class="unlock">
        <p class="kicker">THE UNLOCK</p>
        <p>{HOME_CARTOGRAPHY.unlock}</p>
      </aside>
    </section>

    {enableGroups.map((group) => (
      <section class="section">
        <div class="section__head">
          <p class="kicker">{group.kicker}</p>
          <h2>{group.heading}</h2>
        </div>
        <div class="cards cards--4">
          {group.items.map((item) => (
            <article>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="section split">
      <div>
        <div class="section__head">
          <p class="kicker">WHY NOW</p>
          <h2>The pieces just arrived.</h2>
        </div>
        <ul class="plain-list">
          {HOME_CARTOGRAPHY.whyNow.map((reason) => <li>{reason}</li>)}
        </ul>
      </div>
      <div>
        <div class="section__head">
          <p class="kicker">BUSINESS SKETCH</p>
          <h2>Wedge, subscription, take, partners.</h2>
        </div>
        <ul class="plain-list">
          {HOME_CARTOGRAPHY.businessSketch.map((line) => (
            <li><strong>{line.label}:</strong> {line.detail}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section split">
      <div class="guardrails">
        <div class="section__head">
          <p class="kicker">GUARDRAILS · DAY ONE, NON-NEGOTIABLE</p>
          <h2>Private by default. Owned by you.</h2>
        </div>
        <ul class="plain-list">
          {HOME_CARTOGRAPHY.guardrails.map((rule) => <li>{rule}</li>)}
        </ul>
      </div>
      <div>
        <div class="section__head">
          <p class="kicker">OPEN QUESTIONS</p>
          <h2>Still being surveyed.</h2>
        </div>
        <ul class="plain-list">
          {HOME_CARTOGRAPHY.openQuestions.map((q) => <li>{q}</li>)}
        </ul>
      </div>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/home.json">/cartography/home.json</a></li>
        <li><a href="/cartography/home/demo">/cartography/home/demo</a></li>
        <li><a href="/cartography/home/demo.json">/cartography/home/demo.json</a></li>
        <li><a href="/cartography/home/field-kit">/cartography/home/field-kit</a></li>
        <li><a href="/cartography/home/field-kit.json">/cartography/home/field-kit.json</a></li>
        <li><a href="/cartography.json">/cartography.json</a></li>
        <li><a href="/agents.json">/agents.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .home-carto {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 18px 88px;
    }

    .crumb,
    .kicker,
    .survey-card,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 20px;
      align-items: end;
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 500;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      font-size: 54px;
      line-height: 1;
    }

    .dek {
      max-width: 620px;
      margin: 12px 0 0;
      color: #38373a;
      font-size: 17px;
      line-height: 1.5;
    }

    .sibling {
      max-width: 620px;
      margin: 10px 0 0;
      color: #65625a;
      font-size: 13px;
      line-height: 1.5;
    }

    .survey-card {
      padding: 14px;
      border: 1px solid #12110e;
      border-left: 6px solid #0f6e56;
      background: #fffdf5;
      text-transform: none;
    }

    .survey-card__label {
      margin: 0 0 10px;
      color: #65625a;
      font-size: 10px;
      text-transform: uppercase;
    }

    .survey-card dl {
      display: grid;
      gap: 8px;
      margin: 0;
    }

    .survey-card dt {
      color: #65625a;
      font-size: 10px;
      text-transform: uppercase;
    }

    .survey-card dd {
      margin: 2px 0 0;
      color: #38373a;
      font-size: 13px;
    }

    .section {
      margin-top: 32px;
    }

    .section__head {
      margin-bottom: 14px;
    }

    .section__head h2 {
      font-size: 30px;
      line-height: 1.08;
    }

    .section__head p:not(.kicker) {
      max-width: 620px;
      color: #38373a;
      font-size: 14px;
      line-height: 1.5;
    }

    .cards {
      display: grid;
      gap: 12px;
    }

    .cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .cards article {
      border: 1px solid #d8d4ca;
      border-left: 5px solid #185fa5;
      background: #fff;
      padding: 15px;
    }

    .cards h3 {
      font-size: 17px;
      line-height: 1.2;
    }

    .cards p {
      margin: 8px 0 0;
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    .unlock {
      margin-top: 12px;
      padding: 15px;
      border: 1px solid #12110e;
      border-left: 6px solid #8a2432;
      background: #fffdf5;
    }

    .unlock p:last-child {
      margin: 0;
      color: #38373a;
      font-size: 15px;
      line-height: 1.5;
    }

    .split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .plain-list {
      margin: 0;
      padding-left: 18px;
      color: #38373a;
      font-size: 14px;
      line-height: 1.55;
    }

    .plain-list li {
      margin-bottom: 8px;
    }

    .guardrails {
      border: 1px solid #d8d4ca;
      border-left: 5px solid #0f6e56;
      background: #fff;
      padding: 15px;
    }

    .agent-strip {
      margin-top: 28px;
      border: 1px solid #d8d4ca;
      background: #fff;
      padding: 15px;
      font-size: 11px;
    }

    .agent-strip__label {
      margin: 0 0 8px;
      color: #65625a;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (max-width: 820px) {
      .hero,
      .cards--3,
      .cards--4,
      .split {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 38px;
      }
    }
  </style>
</BlockLayout>
