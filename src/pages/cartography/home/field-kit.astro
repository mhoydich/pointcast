---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { HOME_FIELD_KIT, homeFieldKitJsonLd } from '../../../lib/home-cartography-field-kit';

const title = 'Home Cartography field kit - index one room today';
const description =
  'A phone-usable protocol for indexing one real room in about 20 minutes: sweep, photograph, record location, note condition, search email for the receipt. Nothing is uploaded to PointCast.';

const alternates = [
  { type: 'application/json', href: '/cartography/home/field-kit.json', title: 'Home Cartography field kit JSON' },
  { type: 'application/json', href: '/cartography/home.json', title: 'Home Cartography concept JSON' },
  { type: 'application/json', href: '/cartography/home/demo.json', title: 'Home Cartography demo JSON' },
];
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={homeFieldKitJsonLd()}
  alternates={alternates}
  image="/images/og/b/0442.png"
>
  <main class="field-kit">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <a href="/cartography/home">Home</a>
      <span>/</span>
      <span>Field kit</span>
    </nav>

    <header class="hero">
      <p class="kicker">HOME CARTOGRAPHY · FIELD KIT</p>
      <h1>{HOME_FIELD_KIT.title}</h1>
      <p class="dek">{HOME_FIELD_KIT.purpose}</p>
      <p class="privacy-note">Your data stays with you — PointCast collects nothing. There is no submit button on this page and no server-side storage of anything you record.</p>
    </header>

    <section class="section">
      <div class="section__head">
        <p class="kicker">PROTOCOL · ~20 MINUTES, ONE ROOM</p>
        <h2>Sweep, photograph, record, search.</h2>
      </div>
      <ol class="protocol">
        {HOME_FIELD_KIT.protocol.map((step) => (
          <li>
            <span class="protocol__num">{step.step}</span>
            <div>
              <h3>{step.label}</h3>
              <p>{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section split">
      <div>
        <div class="section__head">
          <p class="kicker">ITEM TEMPLATE</p>
          <h2>One row per item.</h2>
        </div>
        <pre>{JSON.stringify(HOME_FIELD_KIT.itemTemplate, null, 2)}</pre>
      </div>
      <div>
        <div class="section__head">
          <p class="kicker">ROOM TEMPLATE</p>
          <h2>One row per room.</h2>
        </div>
        <pre>{JSON.stringify(HOME_FIELD_KIT.roomTemplate, null, 2)}</pre>
      </div>
    </section>

    <section class="section split">
      <div>
        <div class="section__head">
          <p class="kicker">CATEGORIES</p>
          <h2>Pick the closest one.</h2>
        </div>
        <ul class="plain-list">
          {HOME_FIELD_KIT.categories.map((c) => <li><code>{c}</code></li>)}
        </ul>
      </div>
      <div>
        <div class="section__head">
          <p class="kicker">CONDITION SCALE</p>
          <h2>One honest word.</h2>
        </div>
        <dl class="condition-list">
          {HOME_FIELD_KIT.conditionScale.map((c) => (
            <div>
              <dt>{c.level}</dt>
              <dd>{c.definition}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">WHAT TO DO WITH THE FILE</p>
        <h2>It's your data. Treat it that way.</h2>
      </div>
      <ul class="plain-list">
        {HOME_FIELD_KIT.whatToDoWithTheFile.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="guardrails">
        <div class="section__head">
          <p class="kicker">GUARDRAILS</p>
          <h2>Skip is always a valid answer.</h2>
        </div>
        <ul class="plain-list">
          {HOME_FIELD_KIT.guardrails.map((rule) => <li>{rule}</li>)}
        </ul>
      </div>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/home/field-kit.json">/cartography/home/field-kit.json</a></li>
        <li><a href="/cartography/home">/cartography/home</a></li>
        <li><a href="/cartography/home.json">/cartography/home.json</a></li>
        <li><a href="/cartography/home/demo">/cartography/home/demo</a></li>
        <li><a href="/cartography/home/demo.json">/cartography/home/demo.json</a></li>
        <li><a href="/agents.json">/agents.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .field-kit {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 18px 88px;
    }

    .crumb,
    .kicker,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 500;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      font-size: 46px;
      line-height: 1.05;
    }

    .dek {
      max-width: 680px;
      margin: 12px 0 0;
      color: #38373a;
      font-size: 17px;
      line-height: 1.5;
    }

    .privacy-note {
      max-width: 680px;
      margin: 14px 0 0;
      padding: 12px 14px;
      border: 1px solid #12110e;
      border-left: 6px solid #0f6e56;
      background: #fffdf5;
      color: #38373a;
      font-size: 13px;
      line-height: 1.5;
    }

    .section {
      margin-top: 32px;
    }

    .section__head {
      margin-bottom: 14px;
    }

    .section__head h2 {
      font-size: 28px;
      line-height: 1.1;
    }

    .protocol {
      display: grid;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .protocol li {
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 12px;
      align-items: start;
      border: 1px solid #d8d4ca;
      border-left: 5px solid #185fa5;
      background: #fff;
      padding: 14px 15px;
    }

    .protocol__num {
      font-family: var(--pc-font-mono);
      font-size: 16px;
      color: #185fa5;
    }

    .protocol h3 {
      font-size: 16px;
      line-height: 1.2;
    }

    .protocol p {
      margin: 6px 0 0;
      color: #38373a;
      font-size: 13px;
      line-height: 1.5;
    }

    .split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    pre {
      margin: 0;
      padding: 14px;
      border: 1px solid #d8d4ca;
      background: #12110e;
      color: #eeeae0;
      font-family: var(--pc-font-mono);
      font-size: 12px;
      line-height: 1.5;
      overflow-x: auto;
    }

    .plain-list {
      margin: 0;
      padding-left: 18px;
      color: #38373a;
      font-size: 14px;
      line-height: 1.55;
    }

    .plain-list li {
      margin-bottom: 8px;
    }

    .condition-list {
      display: grid;
      gap: 10px;
      margin: 0;
    }

    .condition-list dt {
      font-family: var(--pc-font-mono);
      font-size: 12px;
      text-transform: uppercase;
      color: #185fa5;
    }

    .condition-list dd {
      margin: 2px 0 0;
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    .guardrails {
      border: 1px solid #d8d4ca;
      border-left: 5px solid #8a2432;
      background: #fff;
      padding: 15px;
    }

    .agent-strip {
      margin-top: 28px;
      border: 1px solid #d8d4ca;
      background: #fff;
      padding: 15px;
      font-size: 11px;
    }

    .agent-strip__label {
      margin: 0 0 8px;
      color: #65625a;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (max-width: 820px) {
      .split {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 34px;
      }
    }
  </style>
</BlockLayout>
