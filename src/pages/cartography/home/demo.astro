---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import {
  DEMO_HOUSE,
  DEMO_ITEMS,
  DEMO_RECEIPTS,
  demoInsuranceSchedule,
  demoLendFlow,
  demoReceiptReconciliation,
  demoRollups,
  demoSellFlow,
  homeCartographyDemoJsonLd,
} from '../../../lib/home-cartography-demo';

const title = 'Home Cartography demo - a fictional indexed household';
const description =
  'A fictional fully-indexed household: item ledger, valuation rollups, stuff-per-square-foot score, duplication detection, and a sell-one-item flow.';

const alternates = [
  { type: 'application/json', href: '/cartography/home/demo.json', title: 'Home Cartography demo JSON' },
  { type: 'application/json', href: '/cartography/home.json', title: 'Home Cartography concept JSON' },
];

function money(value: number): string {
  return `$${value.toLocaleString('en-US')}`;
}

const roomLabel = new Map(DEMO_HOUSE.rooms.map((r) => [r.id, r.label]));
const untouched = new Set(demoRollups.densityScore.untouchedTwoYears);
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={homeCartographyDemoJsonLd}
  alternates={alternates}
  image="/images/og/b/0442.png"
>
  <main class="home-demo">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <a href="/cartography/home">Home</a>
      <span>/</span>
      <span>Demo</span>
    </nav>

    <header class="hero">
      <section>
        <p class="kicker">HOME CARTOGRAPHY · FICTIONAL DEMO HOUSEHOLD</p>
        <h1>{DEMO_HOUSE.label}</h1>
        <p class="dek">{DEMO_HOUSE.note}</p>
      </section>
      <aside class="stat-card" aria-label="Index summary">
        <dl>
          <div><dt>Items indexed</dt><dd>{demoRollups.itemCount}</dd></div>
          <div><dt>Est. value</dt><dd>{money(demoRollups.totalEstValueUsd)}</dd></div>
          <div><dt>Paid over time</dt><dd>{money(demoRollups.totalPaidUsd)}</dd></div>
          <div><dt>Footage</dt><dd>{DEMO_HOUSE.squareFeet.toLocaleString('en-US')} sqft</dd></div>
          <div><dt>Density</dt><dd>{demoRollups.densityScore.itemsPerHundredSqft} items / 100 sqft</dd></div>
        </dl>
      </aside>
    </header>

    <section class="section">
      <div class="section__head">
        <p class="kicker">ROOM ROLLUPS</p>
        <h2>Every room gets a ledger line.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Room</th><th>Sqft</th><th>Items</th><th>Est. value</th><th>Items / 100 sqft</th></tr>
          </thead>
          <tbody>
            {demoRollups.byRoom.map((row) => (
              <tr>
                <td>{row.label}</td>
                <td>{row.sqft}</td>
                <td>{row.itemCount}</td>
                <td>{money(row.estValueUsd)}</td>
                <td>{row.itemsPerHundredSqft}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">{demoRollups.densityScore.note}</p>
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">THE ITEM LEDGER</p>
        <h2>Identity, location, provenance, value.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Item</th><th>Room · location</th><th>Purchased</th><th>Paid</th><th>Est. value</th><th>Warranty</th></tr>
          </thead>
          <tbody>
            {DEMO_ITEMS.map((item) => (
              <tr class={untouched.has(item.id) ? 'is-dusty' : ''}>
                <td>{item.name}</td>
                <td>{roomLabel.get(item.room)} · {item.location}</td>
                <td>{item.purchased}</td>
                <td>{money(item.pricePaidUsd)}</td>
                <td>{money(item.estValueUsd)}</td>
                <td>{item.warrantyUntil ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">Shaded rows: untouched for two-plus years — the honest-mirror list.</p>
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">RECEIPTS FIRST, CAMERA SECOND</p>
        <h2>Email and inbox receipts do the matching before any lens does.</h2>
      </div>
      <aside class="stat-card stat-card--inline" aria-label="Reconciliation summary">
        <dl>
          <div><dt>Receipts ingested</dt><dd>{demoReceiptReconciliation.receiptsIngested}</dd></div>
          <div><dt>Items matched</dt><dd>{demoReceiptReconciliation.matchedItems}</dd></div>
          <div><dt>% of items</dt><dd>{demoReceiptReconciliation.coveragePercentOfItems}%</dd></div>
          <div><dt>% of value</dt><dd>{demoReceiptReconciliation.coveragePercentOfValue}%</dd></div>
        </dl>
      </aside>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Receipt</th><th>Source</th><th>Merchant</th><th>Date</th><th>Total</th><th>Status</th><th>Items</th></tr>
          </thead>
          <tbody>
            {DEMO_RECEIPTS.map((receipt) => (
              <tr>
                <td>{receipt.id}</td>
                <td>{receipt.source}</td>
                <td>{receipt.merchant}</td>
                <td>{receipt.date}</td>
                <td>{money(receipt.totalUsd)}</td>
                <td><span class={`status status--${receipt.status}`}>{receipt.status}</span></td>
                <td>{receipt.itemIds.join(', ') || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">{demoReceiptReconciliation.note}</p>
    </section>

    <section class="section">
      <div class="section__head">
        <p class="kicker">INSURANCE SCHEDULE</p>
        <h2>Items at or above {money(demoInsuranceSchedule.thresholdUsd)}, ready for a rider.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Item</th><th>Serial</th><th>Room</th><th>Purchased</th><th>Paid</th><th>Est. value</th><th>Receipt</th></tr>
          </thead>
          <tbody>
            {demoInsuranceSchedule.lines.map((line) => (
              <tr>
                <td>{line.name}</td>
                <td>{line.serial ?? '—'}</td>
                <td>{line.room}</td>
                <td>{line.purchased}</td>
                <td>{money(line.pricePaidUsd)}</td>
                <td>{money(line.estValueUsd)}</td>
                <td>{line.receiptId ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        {demoInsuranceSchedule.lineCount} lines · {money(demoInsuranceSchedule.totalEstValueUsd)} total est. value.
        {' '}{demoInsuranceSchedule.coverageNote}
      </p>
    </section>

    <section class="section split">
      <div class="flag-card flag-card--sell">
        <p class="kicker">SELL-ONE-ITEM FLOW</p>
        <h2>{demoSellFlow.instruction}</h2>
        <p>{demoSellFlow.why}</p>
        <dl>
          <div><dt>Listing</dt><dd>{demoSellFlow.generatedListing.title}</dd></div>
          <div><dt>Ask</dt><dd>{money(demoSellFlow.generatedListing.askUsd)} · {demoSellFlow.generatedListing.comps}</dd></div>
          <div><dt>Evidence</dt><dd>{demoSellFlow.generatedListing.evidence}</dd></div>
          <div><dt>Channels</dt><dd>{demoSellFlow.generatedListing.channels.join(', ')}</dd></div>
        </dl>
        <p class="footnote">{demoSellFlow.note}</p>
      </div>
      <div class="flag-card flag-card--lend">
        <p class="kicker">PERMISSIONED LEND FLOW</p>
        <h2>{demoLendFlow.request}</h2>
        <p>{demoLendFlow.response}</p>
        <div class="section__head" style="margin-top: 18px;">
          <p class="kicker">MAINTENANCE SIGNALS</p>
        </div>
        <ul class="plain-list">
          {demoRollups.lifecycleFlags.map((flag) => <li><strong>{flag.name}:</strong> {flag.flag}</li>)}
          {demoRollups.duplicates.map((dup) => <li><strong>{dup.name} × {dup.count}:</strong> {dup.suggestion}</li>)}
        </ul>
      </div>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/home/demo.json">/cartography/home/demo.json</a></li>
        <li><a href="/cartography/home.json">/cartography/home.json</a></li>
        <li><a href="/agents.json">/agents.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .home-demo {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 18px 88px;
    }

    .crumb,
    .kicker,
    .stat-card dt,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 20px;
      align-items: end;
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 500;
    }

    h1,
    h2 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      font-size: 54px;
      line-height: 1;
    }

    .dek {
      max-width: 620px;
      margin: 12px 0 0;
      color: #38373a;
      font-size: 17px;
      line-height: 1.5;
    }

    .stat-card {
      padding: 14px;
      border: 1px solid #12110e;
      border-left: 6px solid #185fa5;
      background: #fffdf5;
    }

    .stat-card dl {
      display: grid;
      gap: 8px;
      margin: 0;
    }

    .stat-card dt {
      color: #65625a;
      font-size: 10px;
    }

    .stat-card dd {
      margin: 2px 0 0;
      color: #38373a;
      font-size: 14px;
      font-variant-numeric: tabular-nums;
    }

    .section {
      margin-top: 32px;
    }

    .section__head {
      margin-bottom: 14px;
    }

    .section__head h2 {
      font-size: 30px;
      line-height: 1.08;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid #d8d4ca;
      background: #fff;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }

    th {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid #12110e;
      color: #65625a;
      font-family: var(--pc-font-mono);
      font-size: 10px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    td {
      padding: 8px 12px;
      border-bottom: 1px solid #eeeae0;
      color: #38373a;
    }

    tr.is-dusty td {
      background: #f4f1e7;
      color: #65625a;
    }

    .stat-card--inline {
      display: block;
      margin-bottom: 14px;
    }

    .stat-card--inline dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .status {
      font-family: var(--pc-font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0;
      color: #38373a;
    }

    .status--matched { color: #0f6e56; }
    .status--unmatched { color: #8a2432; }
    .status--needs-camera { color: #185fa5; }

    .footnote {
      margin: 10px 0 0;
      color: #65625a;
      font-size: 12px;
      line-height: 1.5;
    }

    .split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .flag-card {
      border: 1px solid #d8d4ca;
      background: #fff;
      padding: 15px;
    }

    .flag-card--sell { border-left: 5px solid #8a2432; }
    .flag-card--lend { border-left: 5px solid #0f6e56; }

    .flag-card h2 {
      font-size: 22px;
      line-height: 1.15;
    }

    .flag-card p {
      margin: 10px 0 0;
      color: #38373a;
      font-size: 13px;
      line-height: 1.5;
    }

    .flag-card dl {
      display: grid;
      gap: 8px;
      margin: 12px 0 0;
    }

    .flag-card dt {
      color: #65625a;
      font-family: var(--pc-font-mono);
      font-size: 10px;
      text-transform: uppercase;
    }

    .flag-card dd {
      margin: 2px 0 0;
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    .plain-list {
      margin: 0;
      padding-left: 18px;
      color: #38373a;
      font-size: 13px;
      line-height: 1.55;
    }

    .plain-list li {
      margin-bottom: 8px;
    }

    .agent-strip {
      margin-top: 28px;
      border: 1px solid #d8d4ca;
      background: #fff;
      padding: 15px;
      font-size: 11px;
    }

    .agent-strip__label {
      margin: 0 0 8px;
      color: #65625a;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (max-width: 820px) {
      .hero,
      .split {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 38px;
      }

      .stat-card--inline dl {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>
</BlockLayout>
