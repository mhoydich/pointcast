---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { Content } from '../../../docs/cartography/ATLAS.md';

const title = 'The Atlas: spec';
const description = 'The open schema, policies and tool contract behind the PointCast atlas.';
---

<BlockLayout title={title} description={description} author="PointCast / Cartography" isolated immersive showNetworkStrip={false}>
  <main class="spec">
    <nav class="masthead"><a href="/cartography">Cartography</a> · <a href="/cartography/map">Map</a> · <a href="/atlas/schema.json">JSON Schema</a> · <a href="/atlas.json">atlas.json</a></nav>
    <article class="prose"><Content /></article>
  </main>
  <style is:global>
    .spec { max-width: 820px; margin: 0 auto; padding: 24px 16px 80px; color: #12110e; line-height: 1.55; }
    .spec .masthead { font: 12px var(--pc-font-mono, monospace); text-transform: uppercase; color: #65625a; margin-bottom: 16px; }
    .spec a { color: #185fa5; }
    .spec h1 { font-size: clamp(32px, 6vw, 48px); line-height: 1.05; }
    .spec h2 { margin-top: 32px; }
    .spec pre { overflow-x: auto; background: #f4f1ea; padding: 12px; font-size: 13px; }
    .spec table { border-collapse: collapse; display: block; overflow-x: auto; }
    .spec th, .spec td { border-bottom: 1px solid #d8d4ca; padding: 4px 10px; text-align: left; }
  </style>
</BlockLayout>
