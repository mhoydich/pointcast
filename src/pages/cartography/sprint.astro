---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CARTOGRAPHY_NEXT_SPRINT, cartographySprintJsonLd } from '../../lib/cartography-sprint';

const title = 'Cartography Pilot Close Sprint';
const description =
  'The next PointCast Cartography sprint: close three paid pilots or force a niche decision by May 15, with demand, offer, evidence, payment, and receipt lanes.';

function money(value: number): string {
  if (value >= 1000) return `$${Math.round(value / 1000)}k`;
  return `$${value}`;
}

const alternates = [
  { type: 'application/json', href: '/cartography/sprint.json', title: 'Cartography sprint JSON' },
  { type: 'application/json', href: '/cartography/pilot.json', title: 'Cartography pilot JSON' },
];
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={cartographySprintJsonLd}
  alternates={alternates}
  image="/images/og/b/0443.png"
>
  <main class="sprint">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cartography">Cartography</a>
      <span>/</span>
      <span>Sprint</span>
    </nav>

    <header class="hero">
      <section>
        <p class="kicker">SPRINT 001 · {CARTOGRAPHY_NEXT_SPRINT.startDate} TO {CARTOGRAPHY_NEXT_SPRINT.endDate}</p>
        <h1>{CARTOGRAPHY_NEXT_SPRINT.title}</h1>
        <p class="dek">{CARTOGRAPHY_NEXT_SPRINT.goal.target}</p>
      </section>
      <aside class="sprint-card" aria-label="Sprint target">
        <span>CONTRACTED TARGET</span>
        <strong>{money(CARTOGRAPHY_NEXT_SPRINT.goal.targetContractedUsd)}</strong>
        <p>{CARTOGRAPHY_NEXT_SPRINT.goal.pivotRule}</p>
      </aside>
    </header>

    <section class="scorecard" aria-label="Sprint scorecard">
      {CARTOGRAPHY_NEXT_SPRINT.scorecard.map((metric) => (
        <article>
          <span>{metric.label}</span>
          <strong>{typeof metric.target === 'number' && metric.id.includes('usd') ? money(metric.target) : metric.target}</strong>
          <p>{metric.cadence}</p>
        </article>
      ))}
    </section>

    <section class="section" id="lanes">
      <div class="section__head">
        <p class="kicker">LANES</p>
        <h2>Every lane points toward a paid pilot.</h2>
      </div>
      <div class="lane-grid">
        {CARTOGRAPHY_NEXT_SPRINT.lanes.map((lane) => (
          <article>
            <p>{lane.id}</p>
            <h3>{lane.label}</h3>
            <span>{lane.owner}</span>
            <strong>{lane.outcome}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="tasks">
      <div class="section__head">
        <p class="kicker">TASKS</p>
        <h2>The first week is a close plan, not a backlog.</h2>
      </div>
      <div class="task-list">
        {CARTOGRAPHY_NEXT_SPRINT.tasks.map((task) => (
          <article class={`task task--${task.lane}`}>
            <div class="task__top">
              <code>{task.id}</code>
              <span>{task.status}</span>
            </div>
            <h3>{task.ask}</h3>
            <p><strong>Artifact:</strong> {task.artifact}</p>
            <p><strong>Due:</strong> {task.due}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split" id="offer">
      <div class="section__head">
        <p class="kicker">OFFER</p>
        <h2>The pilot page is the selling surface.</h2>
        <p>{CARTOGRAPHY_NEXT_SPRINT.pilotOffer.promise}</p>
      </div>
      <div class="offer-panel">
        <strong>{money(CARTOGRAPHY_NEXT_SPRINT.pilotOffer.priceUsd)}</strong>
        <p>{CARTOGRAPHY_NEXT_SPRINT.pilotOffer.timeline}</p>
        <a href="/cartography/pilot">Open pilot offer</a>
      </div>
    </section>

    <section class="section split" id="cadence">
      <div class="section__head">
        <p class="kicker">CADENCE</p>
        <h2>The sprint has one operating rhythm.</h2>
      </div>
      <ol class="cadence">
        {CARTOGRAPHY_NEXT_SPRINT.operatingCadence.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="agent-strip">
      <p class="agent-strip__label">MACHINE-READABLE</p>
      <ul>
        <li><a href="/cartography/sprint.json">/cartography/sprint.json</a></li>
        <li><a href="/cartography/pilot.json">/cartography/pilot.json</a></li>
        <li><a href="/cartography.json">/cartography.json</a></li>
        <li><a href="/join.json">/join.json</a></li>
      </ul>
    </section>
  </main>

  <style>
    .sprint {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 18px 88px;
      color: #12110e;
    }

    .crumb,
    .kicker,
    .sprint-card span,
    .scorecard span,
    .lane-grid p,
    .lane-grid span,
    .task__top,
    .agent-strip {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 18px;
      align-items: stretch;
      padding-bottom: 22px;
      border-bottom: 1px solid #d8d4ca;
    }

    .hero section,
    .sprint-card,
    .offer-panel {
      border: 1px solid #12110e;
      background: #fffdf5;
    }

    .hero section {
      padding: 24px;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 700;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      max-width: 780px;
      font-size: 54px;
      line-height: 1;
    }

    .dek {
      max-width: 720px;
      margin: 14px 0 0;
      color: #38373a;
      font-size: 18px;
      line-height: 1.5;
    }

    .sprint-card {
      display: grid;
      align-content: space-between;
      padding: 18px;
      background: #eef4fa;
    }

    .sprint-card strong {
      font-size: 46px;
      line-height: 1;
    }

    .sprint-card p {
      margin: 12px 0 0;
      color: #38373a;
      line-height: 1.4;
    }

    .scorecard {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin-top: 16px;
    }

    .scorecard article {
      min-height: 118px;
      padding: 14px;
      border: 1px solid #d8d4ca;
      background: #f7f8f2;
    }

    .scorecard span {
      color: #7d2f14;
      font-size: 10px;
      font-weight: 700;
    }

    .scorecard strong {
      display: block;
      margin-top: 12px;
      font-size: 30px;
      line-height: 1;
    }

    .scorecard p {
      margin: 8px 0 0;
      color: #65625a;
      font-size: 13px;
    }

    .section {
      margin-top: 34px;
      padding-top: 26px;
      border-top: 1px solid #d8d4ca;
    }

    .section__head {
      max-width: 720px;
    }

    .section h2 {
      font-size: 32px;
      line-height: 1.08;
    }

    .section__head p:not(.kicker) {
      color: #38373a;
      line-height: 1.5;
    }

    .lane-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin-top: 18px;
    }

    .lane-grid article {
      min-height: 230px;
      padding: 14px;
      border: 1px solid #12110e;
      background: #fffdf5;
    }

    .lane-grid p,
    .lane-grid span {
      margin: 0;
      color: #65625a;
      font-size: 10px;
    }

    .lane-grid h3 {
      margin-top: 14px;
      font-size: 22px;
    }

    .lane-grid strong {
      display: block;
      margin-top: 18px;
      color: #38373a;
      line-height: 1.42;
    }

    .task-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .task {
      min-height: 190px;
      padding: 16px;
      border: 1px solid #d8d4ca;
      background: #f7f8f2;
    }

    .task__top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      color: #65625a;
      font-size: 10px;
    }

    .task h3 {
      margin-top: 14px;
      font-size: 19px;
      line-height: 1.18;
    }

    .task p {
      margin: 10px 0 0;
      color: #38373a;
      line-height: 1.4;
    }

    .task--demand {
      border-left: 4px solid #185fa5;
    }

    .task--offer {
      border-left: 4px solid #1f7a4d;
    }

    .task--payment {
      border-left: 4px solid #7d2f14;
    }

    .task--evidence,
    .task--receipt {
      border-left: 4px solid #8a6f1d;
    }

    .split {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .offer-panel {
      padding: 18px;
      background: #eef4fa;
    }

    .offer-panel strong {
      display: block;
      font-size: 46px;
      line-height: 1;
    }

    .offer-panel a {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      margin-top: 16px;
      padding: 0 14px;
      border: 1px solid #12110e;
      color: #fffdf5;
      background: #12110e;
      text-decoration: none;
      font-weight: 700;
    }

    .cadence {
      display: grid;
      gap: 10px;
      margin: 0;
      padding-left: 20px;
    }

    .cadence li {
      color: #38373a;
      line-height: 1.45;
    }

    .agent-strip {
      margin-top: 32px;
      padding: 14px 0 0;
      border-top: 1px solid #d8d4ca;
      font-size: 11px;
    }

    .agent-strip ul {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
    }

    .agent-strip a {
      color: #185fa5;
    }

    @media (max-width: 900px) {
      .hero,
      .scorecard,
      .lane-grid,
      .task-list,
      .split {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 42px;
      }
    }
  </style>
</BlockLayout>
