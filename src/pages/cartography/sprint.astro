---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CARTOGRAPHY_NEXT_SPRINT, cartographySprintJsonLd } from '../../lib/cartography-sprint';
const title = 'Cartography Sprint Archive';
const description = 'An archived PointCast Cartography planning sprint; no action is currently requested.';
const alternates = [{ type: 'application/json', href: '/cartography/sprint.json', title: 'Cartography sprint archive JSON' }];
---
<BlockLayout title={title} description={description} jsonLd={cartographySprintJsonLd} alternates={alternates} image="/images/og/b/0443.png" noindex={true}>
  <main><nav><a href="/">Home</a> / <a href="/cartography">Cartography</a> / Sprint</nav><p>ARCHIVE · MAY 2026</p><h1>{CARTOGRAPHY_NEXT_SPRINT.title}</h1><p>An earlier planning artifact. The commercial plan has been retired.</p><p><a href="/cartography">Return to the Cartography archive</a> · <a href="/cartography/sprint.json">Archive JSON</a></p></main>
  <style>main{max-width:760px;margin:0 auto;padding:32px 18px 88px;color:#12110e}nav,p:first-of-type{font:11px var(--pc-font-mono);text-transform:uppercase;color:#65625a}h1{font-size:clamp(42px,9vw,76px);line-height:.95}p{max-width:680px;font-size:20px;line-height:1.5}a{color:#185fa5}</style>
</BlockLayout>
