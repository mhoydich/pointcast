---
import AdSlot from '../components/AdSlot.astro';
import BlockLayout from '../layouts/BlockLayout.astro';
import { AD_CAMPAIGNS, AD_SLOTS } from '../lib/ad-network';

const title = 'PointCast Ad Network';
const description = 'A small, first-party ad server for rotating lightweight PointCast and Tezos project ads in standard web display slots.';
const pageUrl = 'https://pointcast.xyz/ad-network';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': pageUrl,
  name: title,
  description,
  url: pageUrl,
  applicationCategory: 'AdvertisingApplication',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/ad-network.json', title: 'PointCast Ad Network manifest' }]}
>
  <main class="adnet">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><span>ad network</span><a href="/ad-network.json">JSON</a>
    </nav>

    <header class="hero">
      <div>
        <p class="eyebrow">POINTCAST ADS · HOUSE ALPHA · 2026</p>
        <h1>Small ads for the strange web.</h1>
      </div>
      <div class="hero__note">
        <p>{AD_CAMPAIGNS.length} campaigns. Four standard display units. One first-party server.</p>
        <p>No cookies, behavioral profiles, third-party scripts, wallet data, or programmatic auction yet.</p>
      </div>
    </header>

    <section class="status" aria-label="Network status">
      <div><small>STATUS</small><strong>HOUSE ALPHA</strong></div>
      <div><small>CAMPAIGNS</small><strong>{AD_CAMPAIGNS.length}</strong></div>
      <div><small>FORMATS</small><strong>{Object.keys(AD_SLOTS).length}</strong></div>
      <div><small>COST TO SERVE</small><strong>EDGE + KV</strong></div>
    </section>

    <section class="live" aria-labelledby="live-title">
      <div class="section-head">
        <div><p class="eyebrow">LIVE ROTATION</p><h2 id="live-title">The first flight.</h2></div>
        <p>These slots call the PointCast ad server. Refreshing rotates eligible campaigns; a recent-view hint stays only in this browser.</p>
      </div>
      <div class="live__grid">
        <div class="unit unit--rectangle">
          <span>300 × 250 · MEDIUM RECTANGLE</span>
          <AdSlot format="medium-rectangle" placement="ad-network-demo-rectangle" fallbackCampaignId="el-segundo-2026-001" />
        </div>
        <div class="unit unit--half">
          <span>300 × 600 · HALF PAGE</span>
          <AdSlot format="half-page" placement="ad-network-demo-half" fallbackCampaignId="adventure-networks-001" />
        </div>
        <div class="unit unit--wide">
          <span>728 × 90 · LEADERBOARD</span>
          <AdSlot format="leaderboard" placement="ad-network-demo-leaderboard" fallbackCampaignId="common-hours-001" />
        </div>
        <div class="unit unit--mobile">
          <span>320 × 50 · MOBILE BANNER</span>
          <AdSlot format="mobile-banner" placement="ad-network-demo-mobile" fallbackCampaignId="last-tag-001" />
        </div>
      </div>
    </section>

    <section class="specs" aria-labelledby="specs-title">
      <div class="section-head">
        <div><p class="eyebrow">THE UNITS</p><h2 id="specs-title">Fixed sizes, flexible shells.</h2></div>
        <p>We preserve familiar display dimensions while allowing each slot to shrink inside its container. Budgets follow the IAB New Ad Portfolio guidance.</p>
      </div>
      <div class="spec-table" role="table" aria-label="Supported ad formats">
        <div class="spec-row spec-row--head" role="row"><span role="columnheader">Unit</span><span role="columnheader">Pixels</span><span role="columnheader">Ratio</span><span role="columnheader">Initial load</span></div>
        {Object.values(AD_SLOTS).map((slot) => (
          <div class="spec-row" role="row">
            <strong role="cell">{slot.label}</strong>
            <span role="cell">{slot.width} × {slot.height}</span>
            <span role="cell">{slot.flexibleRatio}</span>
            <span role="cell">≤ {slot.maxInitialKilobytes} KB</span>
          </div>
        ))}
      </div>
      <p class="fineprint">“IAB-compatible” describes the unit dimensions and LEAN posture; it is not a certification or endorsement by IAB Tech Lab.</p>
    </section>

    <section class="campaigns" aria-labelledby="campaigns-title">
      <div class="section-head">
        <div><p class="eyebrow">CREATIVE REGISTER</p><h2 id="campaigns-title">{AD_CAMPAIGNS.length} doors in rotation.</h2></div>
        <p>Every destination is hard-coded in the registry. The click endpoint cannot be turned into an open redirect.</p>
      </div>
      <ol class="campaign-list">
        {AD_CAMPAIGNS.map((campaign, index) => (
          <li style={`--swatch:${campaign.theme.background};--ink:${campaign.theme.foreground};--accent:${campaign.theme.accent}`}>
            <span class="campaign-list__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="campaign-list__mark" aria-hidden="true">{campaign.mark}</span>
            <span><small>{campaign.sponsor} · {campaign.kind}</small><strong>{campaign.headline}</strong></span>
            <code>{campaign.id}</code>
          </li>
        ))}
      </ol>
    </section>

    <section class="how" aria-labelledby="how-title">
      <p class="eyebrow">DELIVERY CONTRACT</p>
      <h2 id="how-title">Serve → view → click.</h2>
      <div class="how__steps">
        <article><b>1</b><h3>Serve</h3><p>The edge function picks an eligible weighted campaign and returns safe text, colors, and first-party tracking URLs as JSON.</p></article>
        <article><b>2</b><h3>View</h3><p>A viewed impression is recorded only after at least half of the slot stays visible for one continuous second.</p></article>
        <article><b>3</b><h3>Click</h3><p>The server looks up the registered destination, appends campaign attribution, records the click, and redirects.</p></article>
      </div>
      <div class="boundary">
        <strong>Not billable yet.</strong>
        <p>Counts are directional house-ad telemetry, not a basis for invoices. Before outside advertisers, PointCast needs a reporting store, fraud rules, consent terms, publisher controls, and an explicit paid-media policy.</p>
        <a href="/ad-network.json">Read the machine manifest →</a>
      </div>
    </section>
  </main>
</BlockLayout>

<style>
  .adnet{--paper:#eee8d8;--ink:#151913;--line:rgba(21,25,19,.28);--green:#173c33;--orange:#e85c2c;background:var(--paper);color:var(--ink);min-height:100vh;padding:20px max(18px,calc((100vw - 1120px)/2)) 110px}.crumb{display:flex;gap:9px;align-items:center;padding:6px 0 18px;border-bottom:1px solid var(--line);font:10px var(--pc-font-mono);letter-spacing:.12em;text-transform:uppercase}.crumb a:last-child{margin-left:auto}.hero{display:grid;grid-template-columns:1.5fr .5fr;gap:7vw;align-items:end;padding:90px 0 54px;border-bottom:2px solid var(--ink)}.eyebrow{margin:0 0 14px;font:700 9px/1.3 var(--pc-font-mono);letter-spacing:.17em;text-transform:uppercase}.hero h1,.section-head h2,.how>h2{font-family:Georgia,serif;font-weight:400;letter-spacing:-.055em}.hero h1{max-width:840px;margin:0;font-size:clamp(62px,9.8vw,128px);line-height:.82}.hero__note{font:17px/1.5 Georgia,serif}.hero__note p:first-child{font-size:23px}.status{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--ink)}.status div{display:flex;min-height:90px;padding:15px;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line)}.status div:last-child{border:0}.status small,.unit>span{font:700 8px var(--pc-font-mono);letter-spacing:.13em}.status strong{font:700 18px var(--pc-font-mono)}.live,.specs,.campaigns,.how{padding:100px 0;border-bottom:1px solid var(--ink)}.section-head{display:grid;grid-template-columns:1.4fr .6fr;gap:7vw;align-items:end;margin-bottom:45px}.section-head h2,.how>h2{margin:0;font-size:clamp(48px,6vw,78px);line-height:.9}.section-head>p{margin:0;font:16px/1.5 Georgia,serif}.live__grid{display:grid;grid-template-columns:1fr 1fr;gap:42px 28px;align-items:start}.unit{display:flex;width:100%;flex-direction:column;gap:10px;align-items:flex-start}.unit--half{grid-row:span 3}.unit--wide{grid-column:1 / -1}.unit>span{color:#676d61}.spec-table{border-top:2px solid var(--ink)}.spec-row{display:grid;grid-template-columns:1.5fr repeat(3,1fr);padding:16px 8px;border-bottom:1px solid var(--line);font:13px var(--pc-font-mono)}.spec-row--head{font-size:8px;letter-spacing:.12em;text-transform:uppercase}.fineprint{max-width:720px;margin-top:18px;font:11px/1.5 var(--pc-font-mono);color:#62685d}.campaign-list{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}.campaign-list li{display:grid;grid-template-columns:48px 64px minmax(0,1fr) auto;gap:12px;align-items:center;min-height:102px;border-bottom:1px solid var(--line)}.campaign-list__number,.campaign-list code,.campaign-list small{font:9px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase}.campaign-list__mark{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--swatch);color:var(--accent);border:1px solid var(--ink);font:700 15px var(--pc-font-mono)}.campaign-list li>span:nth-child(3){display:flex;flex-direction:column;gap:5px}.campaign-list strong{font:25px Georgia,serif}.campaign-list code{white-space:nowrap}.how__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:46px 0}.how__steps article{min-height:240px;padding:22px;border:1px solid var(--ink)}.how__steps b{display:grid;width:34px;height:34px;place-items:center;border-radius:50%;background:var(--green);color:var(--paper);font:12px var(--pc-font-mono)}.how__steps h3{margin:42px 0 10px;font:36px Georgia,serif}.how__steps p{font:14px/1.55 Georgia,serif}.boundary{padding:30px;background:var(--green);color:var(--paper)}.boundary strong{font:38px Georgia,serif}.boundary p{max-width:780px;font:16px/1.5 Georgia,serif}.boundary a{color:#f6c14c;font:700 10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}@media(max-width:800px){.hero,.section-head{grid-template-columns:1fr}.status{grid-template-columns:1fr 1fr}.status div:nth-child(2){border-right:0}.live__grid{grid-template-columns:1fr}.unit--half,.unit--wide{grid-row:auto;grid-column:auto}.campaign-list li{grid-template-columns:36px 54px 1fr}.campaign-list code{display:none}.how__steps{grid-template-columns:1fr}.spec-row{grid-template-columns:1.3fr repeat(3,.8fr);font-size:10px}}@media(max-width:460px){.hero{padding-top:70px}.hero h1{font-size:58px}.status strong{font-size:14px}.spec-row{grid-template-columns:1fr 1fr}.spec-row span:nth-child(3),.spec-row--head span:nth-child(3){display:none}.campaign-list strong{font-size:20px}}
</style>
