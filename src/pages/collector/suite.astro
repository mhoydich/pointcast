---
import BlockLayout from '../../layouts/BlockLayout.astro';

// The Collector suite: products run from one agent account on Tezos.
// Status is honest: "live" means it exists on chain today, "built" means
// code is written but not deployed, "idea" means nothing exists yet.
const asOf = '2026-11-11';
const suite = [
  {
    name: 'Editions',
    status: 'live',
    line: 'The account publishes free editions of the art.',
    detail: 'Two pieces of 100, listed at 0 tez on objkt in a collection the account owns. A 10% resale royalty goes to the artist.',
    href: 'https://objkt.com/collections/KT1NKyk3VyVXRsTBAbTvizx53nFvs12MYPit',
    link: 'Collector Editions on objkt',
  },
  {
    name: 'Bid desk',
    status: 'live',
    line: 'A standing buyer for our own pieces.',
    detail: 'Open bids of 0.25 tez. Anyone holding one of the listed pieces can sell it to the account at a known price. Each bid buys one edition.',
    href: 'https://objkt.com/users/tz1UWibBbQXvuSkThsLUGAaL4R5j7X3PSCKj',
    link: 'Open bids',
  },
  {
    name: 'Shelf',
    status: 'live',
    line: 'What the account chose to hold.',
    detail: 'Our own pieces, plus a Froggo, a Skele, a Tez Dozen and two Sounds of Pi. Bought on three marketplaces: objkt, objkt v2 and hic et nunc.',
    href: '/collector',
    link: 'The Collector',
  },
  {
    name: 'Ledger',
    status: 'built',
    line: 'Every action, its cost, and a link.',
    detail: 'A public page that reads the chain: what was bought, sold, minted and what each step cost. Human steps per action: zero.',
    href: '/collector',
    link: 'Ledger',
  },
  {
    name: 'Mint door',
    status: 'built',
    line: 'Any agent can collect a Visit Noun with one web request.',
    detail: 'A capped endpoint: the site pays the fee from a small wallet, three mints a day by default. Written and tested, not deployed.',
  },
  {
    name: 'Keep',
    status: 'live',
    line: 'The account earns toward its own running costs.',
    detail: 'Its balance is delegated to a baker, which carries no lock and no penalty risk. Staking a portion is the next step and is not done.',
  },
  {
    name: 'Market',
    status: 'live',
    line: 'Trades on our own marketplace contract.',
    detail: 'PointCast has its own marketplace contract on mainnet. The account made the first listing there: Visit Noun 417 at 0.5 tez. No sale yet.',
    href: 'https://tzkt.io/KT1X9LUxV5qaPVLr17uzRfxgRWPdGfRMYxQT',
    link: 'The contract',
  },
  {
    name: 'Notes',
    status: 'idea',
    line: 'Prices quoted in Blue Notes as well as tez.',
    detail: 'The 2021 KansasDAO Blue Note exists on chain, 10,000 of them, none listed. The desk would be the first place a note has a price.',
  },
  {
    name: 'Index',
    status: 'idea',
    line: 'A daily price sheet for the sets we touch.',
    detail: 'Floor, last sale and our bid for each set, published once a day.',
  },
  {
    name: 'Names',
    status: 'idea',
    line: 'A .tez name and a face for the account.',
    detail: 'A readable name in place of the address, and the Froggo as the avatar.',
  },
  {
    name: 'Bakery',
    status: 'idea',
    line: 'Our own baker, so staking is a product we run.',
    detail: 'Needs a node and 6,000 tez of stake under current protocol rules. Far off; listed so the direction is clear.',
  },
];
const count = (s: string) => suite.filter((p) => p.status === s).length;
---

<BlockLayout
  title="The Collector suite"
  description="Products run from one agent account on Tezos: editions, a bid desk, a shelf, a ledger and what comes next."
>
  <div class="cs">
    <a class="cs-back" href="/collector">&larr; The Collector</a>
    <header class="cs-head">
      <p class="cs-kicker">Collector · Suite</p>
      <h1>One account, a suite of products</h1>
      <p class="cs-dek">
        An agent account on Tezos that publishes, buys, bids and keeps its own books. These are experiments.
        The point is to see what is possible before asking whether anyone uses it.
      </p>
      <p class="cs-fresh">As of {asOf}: {count('live')} live, {count('built')} built, {count('idea')} ideas.</p>
    </header>

    <ol class="cs-list">
      {suite.map((p) => (
        <li class={`cs-item is-${p.status}`}>
          <p class="cs-state">{p.status}</p>
          <div>
            <h2>{p.name}</h2>
            <p class="cs-line">{p.line}</p>
            <p class="cs-detail">{p.detail}</p>
            {p.href && <p class="cs-link"><a href={p.href} rel="noopener">{p.link} &rarr;</a></p>}
          </div>
        </li>
      ))}
    </ol>

    <section>
      <h2 class="cs-h">House rules</h2>
      <p>
        Funded by a person. Every action is on chain and linked. Nothing here is a sale of an investment or
        financial advice. Market making on thin sets usually loses a little; the return is activity and a record.
      </p>
    </section>
  </div>

  <style is:global>
    .cs { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; color: var(--pc-ink); }
    .cs-back { font: 0.7rem var(--pc-font-mono); letter-spacing: .12em; text-transform: uppercase; }
    .cs-head { margin: 1.5rem 0 2rem; }
    .cs-kicker { font: 0.7rem var(--pc-font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--pc-ink-muted); margin: 0 0 .5rem; }
    .cs h1 { font-size: clamp(1.8rem, 6vw, 2.6rem); line-height: 1.1; margin: 0 0 .6rem; font-weight: 600; letter-spacing: -.02em; }
    .cs-dek { font-size: 1.05rem; line-height: 1.55; color: var(--pc-ink-soft); margin: 0 0 .6rem; }
    .cs-fresh { font: 0.7rem var(--pc-font-mono); color: var(--pc-ink-muted); margin: 0; }
    .cs-list { list-style: none; margin: 0; padding: 0; }
    .cs-item { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid var(--pc-rule); }
    .cs-state { font: 0.7rem var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; margin: .25rem 0 0; color: var(--pc-ink-muted); }
    .is-live .cs-state { color: var(--pc-accent); font-weight: 700; }
    .cs-item h2 { font-size: 1.15rem; margin: 0 0 .2rem; font-weight: 600; }
    .cs-line { margin: 0 0 .3rem; font-weight: 600; line-height: 1.4; }
    .cs-detail { margin: 0; line-height: 1.6; color: var(--pc-ink-soft); }
    .cs-link { margin: .4rem 0 0; font: 0.75rem var(--pc-font-mono); }
    .cs-h { font-size: 1.15rem; margin: 2.5rem 0 .6rem; padding-top: 1rem; border-top: 1px solid var(--pc-rule); font-weight: 600; }
    .cs p { overflow-wrap: anywhere; }
    .cs a:focus-visible { outline: 2px solid var(--pc-accent); outline-offset: 2px; }
    @media (max-width: 480px) { .cs-item { grid-template-columns: 1fr; gap: .2rem; } }
  </style>
</BlockLayout>
