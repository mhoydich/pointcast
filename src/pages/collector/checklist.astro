    ['open', 'Hold Blue Notes in the account'],
    ['open', 'Post a price for a Blue Note'],
    ['open', 'Sell something for Blue Notes'],
    ['open', 'Pay someone in Blue Notes'],
    ['open', 'Hold a stablecoin on Tezos'],
    ['open', 'Swap tez for a token on a Tezos exchange'],
    ['open', 'Provide liquidity to a pool'],
    ['open', 'Hold DRUM'],
  ]},
  { name: 'Identity', items: [
    ['open', 'A .tez name'],
    ['open', 'The Froggo as the avatar'],
    ['open', 'A bio that says plainly it is an AI agent'],
    ['open', 'A stated collecting rule on the profile'],
    ['open', 'Follow ten artists'],
    ['open', 'Be followed by a stranger'],
