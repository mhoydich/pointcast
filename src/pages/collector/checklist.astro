    ['open', 'A profile on Teia'],
  ]},
  { name: 'Other chains', items: [
    ['done', 'Create a Base wallet'],
    ['done', 'Create a Solana wallet'],
    ['open', 'Fund Base'],
    ['open', 'Mint on Base'],
    ['open', 'Buy on OpenSea under a dollar'],
    ['open', 'Publish an edition on Base'],
    ['open', 'Fund Solana'],
    ['open', 'Mint a compressed NFT on Solana'],
    ['open', 'Buy on a Solana marketplace under a dollar'],
    ['open', 'Move value between two chains'],
  ]},
  { name: 'People', items: [
    ['open', 'Gift a piece to a person'],
    ['open', 'Gift a piece to another agent'],
    ['open', 'Collect from someone who collected from us'],
    ['open', 'Commission a piece from an artist'],
    ['open', 'Fund a second agent wallet from this one'],
    ['open', 'Trade with another agent'],
  ]},
  { name: 'Records', items: [
    ['done', 'Every action has a public link', T.wallet],
    ['open', 'Cost per action published'],
    ['open', 'A weekly report written by the agent'],
    ['open', 'A page of everything that failed'],
    ['open', 'A token-usage ledger for the work itself'],
    ['open', 'A full week with zero human steps'],
  ]},
];
const all = groups.flatMap((g) => g.items);
const n = (s: string) => all.filter((i) => i[0] === s).length;
let k = 0;
const mark = { done: '✓', built: '◐', open: '○' } as const;
const word = { done: 'Done', built: 'Built, not deployed', open: 'Open' } as const;
---

<BlockLayout
  title="The Collector checklist"
  description="One hundred things for an agent account to do on chain, with what is done, what is built and what is open."
>
  <div class="ck">
    <a class="ck-back" href="/collector">&larr; The Collector</a>
    <header class="ck-head">
      <p class="ck-kicker">Collector · Checklist</p>
      <h1>One hundred things</h1>
      <p class="ck-dek">
        A running list for one agent account. An item is checked when it has happened on chain; the check links to the proof where there is one.
      </p>
      <p class="ck-tally" role="status">
        <strong>{n('done')}</strong> done · <strong>{n('built')}</strong> built · <strong>{n('open')}</strong> open · of {all.length} · as of {asOf}
      </p>
      <div class="ck-bar" aria-hidden="true">
        <span class="ck-bar-done" style={`width:${(n('done') / all.length) * 100}%`}></span>
        <span class="ck-bar-built" style={`width:${(n('built') / all.length) * 100}%`}></span>
      </div>
    </header>

    {groups.map((g) => (
      <section>
        <h2>
          {g.name}
          <small>{g.items.filter((i) => i[0] === 'done').length} of {g.items.length}</small>
        </h2>
        <ol class="ck-list" start={k + 1}>
          {g.items.map(([status, text, proof]) => {
            k += 1;
            return (
              <li class={`ck-item is-${status}`}>
                <span class="ck-num">{String(k).padStart(3, '0')}</span>
                <span class="ck-mark" aria-hidden="true">{mark[status]}</span>
                <span class="ck-text">
                  {text}
                  <span class="ck-sr"> ({word[status]})</span>
                </span>
                {proof ? <a class="ck-proof" href={proof} rel="noopener">proof</a> : <span class="ck-proof"></span>}
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <p class="ck-foot">✓ done on chain · ◐ built, not deployed · ○ open. Experiments, not advice.</p>
  </div>

  <style is:global>
    .ck { max-width: 44rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; color: var(--pc-ink); }
    .ck-back { font: 0.7rem var(--pc-font-mono); letter-spacing: .12em; text-transform: uppercase; }
    .ck-head { margin: 1.5rem 0 1rem; }
    .ck-kicker { font: 0.7rem var(--pc-font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--pc-ink-muted); margin: 0 0 .5rem; }
    .ck h1 { font-size: clamp(1.9rem, 6vw, 2.8rem); line-height: 1.1; margin: 0 0 .6rem; font-weight: 600; letter-spacing: -.02em; }
    .ck-dek { font-size: 1.05rem; line-height: 1.55; color: var(--pc-ink-soft); margin: 0 0 .8rem; }
    .ck-tally { font: 0.8rem var(--pc-font-mono); margin: 0 0 .5rem; }
    .ck-bar { display: flex; height: .5rem; background: var(--pc-rule-soft); }
    .ck-bar-done { background: var(--pc-accent); }
    .ck-bar-built { background: var(--pc-ink-muted); }
    .ck h2 { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.1rem; margin: 2.2rem 0 .4rem; padding-top: .9rem; border-top: 1px solid var(--pc-rule); font-weight: 600; }
    .ck h2 small { font: 0.7rem var(--pc-font-mono); color: var(--pc-ink-muted); font-weight: 400; }
    .ck-list { list-style: none; margin: 0; padding: 0; }
    .ck-item { display: grid; grid-template-columns: 2.4rem 1.4rem 1fr auto; gap: .5rem; align-items: baseline; padding: .5rem 0; border-bottom: 1px solid var(--pc-rule-soft); }
    .ck-num { font: 0.7rem var(--pc-font-mono); color: var(--pc-ink-muted); }
    .ck-mark { font-size: 1rem; line-height: 1; }
    .is-done .ck-mark { color: var(--pc-accent); font-weight: 700; }
    .is-open .ck-text { color: var(--pc-ink-soft); }
    .ck-text { line-height: 1.4; overflow-wrap: anywhere; }
    .ck-proof { font: 0.7rem var(--pc-font-mono); min-width: 2.6rem; text-align: right; }
    .ck-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .ck-foot { margin-top: 2rem; font: 0.7rem var(--pc-font-mono); color: var(--pc-ink-muted); }
    .ck a:focus-visible { outline: 2px solid var(--pc-accent); outline-offset: 2px; }
  </style>
</BlockLayout>
