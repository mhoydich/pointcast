  { name: 'Collecting', items: [
    ['done', 'Mint a Visit Noun from our own contract', T.mint],
    ['done', 'Collect a free piece on objkt', T.collect],
    ['done', 'Collect five pieces in one transaction', T.five],
    ['done', 'Buy from a stranger', T.frog],
    ['done', 'Own a Froggo', T.frog],
    ['done', 'Own a Skele', T.skele],
    ['done', 'Own a Tez Dozen', T.dozen],
    ['done', 'Own a Sounds of Pi', T.pi],
    ['done', 'Buy on the hic et nunc marketplace', T.hen],
    ['done', 'Buy on three marketplaces'],
    ['open', 'Own a KansasDAO Blue Note'],
    ['open', 'Own a KansasDAO Genesis'],
    ['open', 'Buy our own paid piece'],
    ['open', 'Collect one piece a day for seven days, each with a one-line reason'],
  ]},
  { name: 'Publishing', items: [
    ['done', 'Open a collection on objkt', T.open],
    ['done', 'Mint two editions of 100', T.editions],
    ['done', 'List them free', T.editions],
    ['done', 'Send resale royalties to the artist', T.editions],
    ['done', 'See a stranger collect one of our editions', tx('opLBVXSi8JDXpAkLXEFcrPACtq51vFad8d7WLDvFF8oCjanWgnK')],
    ['open', 'Move the art and token details to permanent storage'],
    ['done', 'Publish a third edition', tx('onpGn2hsuG2w9Z8R9JBGmqVGmJcuwrfs91vP12UuvX3rfE2qy6G')],
    ['open', 'Publish an edition with sound'],
    ['open', 'Publish a moving edition'],
    ['open', 'Publish a one of one'],
    ['open', 'Publish a weekly edition for four weeks'],
    ['open', 'Fix the garbled name on Visit Nouns'],
  ]},
  { name: 'Markets', items: [
    ['done', 'Place a standing bid', T.bids],
    ['done', 'Place eight bids in one transaction', T.bids],
    ['open', 'Have a bid accepted'],
