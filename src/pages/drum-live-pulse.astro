---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Drum Live Pulse — one tap, hear the room"
  description="A single big circle in the middle of the page. Tap it. Every other person tapping their circle right now lights it up. The color tells you how fast the room is going. The minimum live drum surface."
  image="/images/og-drum.png"
>
  <main class="dlp" id="dlp" data-built={built}>
    <div class="dlp__stage" id="dlp-stage">
      <button class="dlp__circle" id="dlp-circle" type="button" aria-label="Tap to drum">
        <span class="dlp__core" id="dlp-core"></span>
        <span class="dlp__readout">
          <span class="dlp__rate" id="dlp-rate">—</span>
          <span class="dlp__rate-unit">taps / min</span>
        </span>
      </button>
      <div class="dlp__ripples" id="dlp-ripples"></div>
    </div>
    <div class="dlp__hud">
      <span class="dlp__here" id="dlp-here">first to arrive · tap the circle</span>
      <a class="dlp__open" href="/drum-live">↗ four-pad version</a>
    </div>
  </main>

  <style is:global>
    :root {
      --dlp-ink: #050813;
      --dlp-deep: #0a1230;
      --dlp-flame: #f6c15e;
      --dlp-coral: #ff6b8a;
      --dlp-sky: #7ac8ed;
      --dlp-mint: #8aeac0;
      --dlp-mauve: #c9a8ef;
      --dlp-cream: #f4e7c8;
      --dlp-cream-dim: #8a8a9a;
    }

    html, body { background: var(--dlp-ink); margin: 0; padding: 0; height: 100%; }
    body:has(.dlp) {
      background:
        radial-gradient(circle at 50% 50%, #1a1238 0%, transparent 65%),
        var(--dlp-ink);
      color: var(--dlp-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .dlp {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* STAGE — center the circle and host ripples */
    .dlp__stage {
      position: relative;
      width: min(72vmin, 540px);
      height: min(72vmin, 540px);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dlp__ripples {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    /* THE CIRCLE */
    .dlp__circle {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 0;
      padding: 0;
      cursor: pointer;
      background: transparent;
      transition: transform 80ms ease;
      touch-action: manipulation;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    .dlp__circle:active { transform: scale(0.96); }
    .dlp__core {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, var(--core-mid, #4a557a) 0%, var(--core-edge, #1a2540) 70%, transparent 100%);
      box-shadow:
        inset 0 -22px 60px rgba(0,0,0,0.55),
        inset 0 18px 40px rgba(255,255,255,0.10),
        0 0 var(--core-glow, 28px) var(--core-glow-color, rgba(122,200,237,0.22));
      transition: box-shadow 600ms ease, background 600ms ease;
    }
    .dlp__circle--struck-self .dlp__core {
      animation: dlpStrikeSelf 0.55s ease-out;
    }
    .dlp__circle--struck-other .dlp__core {
      animation: dlpStrikeOther 0.85s ease-out;
    }
    @keyframes dlpStrikeSelf {
      0%   { transform: scale(1.0); filter: brightness(1.0); }
      18%  { transform: scale(1.04); filter: brightness(1.5); }
      100% { transform: scale(1.0); filter: brightness(1.0); }
    }
    @keyframes dlpStrikeOther {
      0%   { transform: scale(1.0); filter: brightness(1.0); }
      24%  { transform: scale(1.018); filter: brightness(1.22); }
      100% { transform: scale(1.0); filter: brightness(1.0); }
    }
    .dlp__readout {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      pointer-events: none;
      text-align: center;
    }
    .dlp__rate {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: clamp(48px, 14vmin, 96px);
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--dlp-cream);
      font-variant-numeric: tabular-nums;
      text-shadow: 0 4px 18px rgba(0,0,0,0.6);
    }
    .dlp__rate-unit {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dlp-cream-dim);
      text-transform: uppercase;
    }

    /* OUTER RIPPLES (per-tap) */
    .dlp__ripple {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 2px solid var(--ripple-color, var(--dlp-flame));
      opacity: 0;
      pointer-events: none;
      animation: dlpRipple 1.4s ease-out forwards;
    }
    .dlp__ripple--self {
      border-width: 3px;
    }
    @keyframes dlpRipple {
      0%   { opacity: 0.85; transform: translate(-50%, -50%) scale(0.95); }
      100% { opacity: 0;    transform: translate(-50%, -50%) scale(1.5); }
    }

    /* HUD */
    .dlp__hud {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 90vw;
    }
    .dlp__here {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.10em;
      color: var(--dlp-cream-dim);
      padding: 6px 12px;
      background: rgba(0,0,0,0.42);
      border-radius: 14px;
      border: 1px solid rgba(244,231,200,0.10);
    }
    .dlp__here strong {
      color: var(--dlp-flame);
      font-weight: 600;
    }
    .dlp__open {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.10em;
      color: var(--dlp-cream);
      background: rgba(0,0,0,0.42);
      border: 1px solid rgba(244,231,200,0.16);
      border-radius: 12px;
      padding: 6px 12px;
      text-decoration: none;
    }
    .dlp__open:hover { background: rgba(244,231,200,0.08); }

    /* LIVE chip top-left */
    .dlp::before {
      content: '· LIVE';
      position: absolute;
      top: 24px;
      left: 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.18em;
      color: var(--dlp-coral);
      background: rgba(255,107,138,0.18);
      border: 1px solid rgba(255,107,138,0.42);
      padding: 5px 10px;
      border-radius: 12px;
      animation: dlpBlink 1.4s ease-in-out infinite;
    }
    @keyframes dlpBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.55; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    let SESSION_ID = '';
    let MY_PID = '';
    let lastT = 0;
    let pollTimer: number | null = null;

    // Rolling 60-second window of tap timestamps
    const tapWindow: number[] = [];
    // Map pid → { lastSeen, color }
    const pidState = new Map();

    const PALETTE = [
      '#ff6b8a', '#8aeac0', '#7ac8ed', '#c9a8ef',
      '#f4a050', '#ffd56b', '#ff9bd4', '#6be5d4',
      '#a8d870', '#e89070', '#b894e8', '#70c0d8',
    ];

    function hashStr(s: string) {
      let h = 0;
      for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
      return Math.abs(h);
    }
    function pidColor(pid: string) {
      if (pid === MY_PID) return '#f6c15e';
      return PALETTE[hashStr(pid) % PALETTE.length];
    }

    async function sha256Hex(input: string) {
      const buf = new TextEncoder().encode(input);
      const hash = await crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(hash))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }

    // Each pid hashes to a pentatonic note (C major pentatonic across 2 octaves)
    const PENT_FREQS = [
      130.81, 146.83, 164.81, 196.00, 220.00,   // C3 D3 E3 G3 A3
      261.63, 293.66, 329.63, 392.00, 440.00,   // C4 D4 E4 G4 A4
    ];
    function pidNote(pid: string) {
      if (pid === MY_PID) return 220.00;  // your note = A3
      return PENT_FREQS[hashStr(pid) % PENT_FREQS.length];
    }

    function playTone(pid: string, isSelf: boolean) {
      ensureCtx();
      if (!ctx || !scheduler || !masterGain) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const freq = pidNote(pid);
      const vel = isSelf ? 1.0 : 0.55;
      // Single sine pluck — short tail
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.4 * vel, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.65);
      // Soft harmonic shimmer at 2x
      const osc2 = ctx.createOscillator();
      const g2 = ctx.createGain();
      osc2.type = 'sine';
      osc2.frequency.value = freq * 2;
      g2.gain.setValueAtTime(0.0001, t);
      g2.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.005);
      g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
      osc2.connect(g2).connect(masterGain);
      scheduler.trackSource(osc2);
      osc2.start(t);
      osc2.stop(t + 0.4);
    }

    // ---- ripples ----
    function spawnRipple(pid: string, isSelf: boolean) {
      const wrap = document.getElementById('dlp-ripples')!;
      const el = document.createElement('span');
      el.className = 'dlp__ripple' + (isSelf ? ' dlp__ripple--self' : '');
      el.style.setProperty('--ripple-color', pidColor(pid));
      wrap.appendChild(el);
      el.addEventListener('animationend', () => el.remove(), { once: true });
      // Strike animation on the core
      const circle = document.getElementById('dlp-circle')!;
      circle.classList.remove('dlp__circle--struck-self', 'dlp__circle--struck-other');
      (circle as any).offsetHeight;
      circle.classList.add(isSelf ? 'dlp__circle--struck-self' : 'dlp__circle--struck-other');
      setTimeout(() => circle.classList.remove('dlp__circle--struck-self', 'dlp__circle--struck-other'), 900);
    }

    // ---- color the core by activity level ----
    function recomputeRate() {
      const now = Date.now();
      // Trim window to last 60s
      while (tapWindow.length && now - tapWindow[0] > 60_000) tapWindow.shift();
      const taps = tapWindow.length;
      // Rate per minute (extrapolate from the actual window span)
      const span = Math.max(8000, Math.min(60_000, now - (tapWindow[0] || now - 60_000)));
      const rate = Math.round((taps / span) * 60_000);
      return rate;
    }

    function rateColor(rate: number) {
      // 0..40+ rate maps to a color gradient. Returns { mid, edge, glow, glowColor }.
      if (rate <= 1) {
        return { mid: '#2a3760', edge: '#0e1530', glow: '24px', glowColor: 'rgba(122,200,237,0.10)' };
      } else if (rate <= 8) {
        return { mid: '#4a6090', edge: '#1a2a50', glow: '32px', glowColor: 'rgba(122,200,237,0.30)' };
      } else if (rate <= 18) {
        return { mid: '#7ec8d0', edge: '#284260', glow: '46px', glowColor: 'rgba(122,200,237,0.45)' };
      } else if (rate <= 32) {
        return { mid: '#f6c15e', edge: '#704220', glow: '56px', glowColor: 'rgba(246,193,94,0.55)' };
      } else {
        return { mid: '#ff8aa0', edge: '#7a2030', glow: '72px', glowColor: 'rgba(255,107,138,0.65)' };
      }
    }

    function refreshUi() {
      const rate = recomputeRate();
      const core = document.getElementById('dlp-core')!;
      const colors = rateColor(rate);
      core.style.setProperty('--core-mid', colors.mid);
      core.style.setProperty('--core-edge', colors.edge);
      core.style.setProperty('--core-glow', colors.glow);
      core.style.setProperty('--core-glow-color', colors.glowColor);
      document.getElementById('dlp-rate')!.textContent = String(rate);

      // here-count: unique pids in last 25s
      const now = Date.now();
      let here = 0;
      pidState.forEach((info) => { if (now - info.lastSeen < 25000) here++; });
      // Subtract self if I'm in there
      const myInfo = pidState.get(MY_PID);
      const others = myInfo && (now - myInfo.lastSeen < 25000) ? here - 1 : here;
      const el = document.getElementById('dlp-here')!;
      if (others <= 0 && tapWindow.length === 0) {
        el.innerHTML = 'first to arrive · tap the circle';
      } else if (others === 0) {
        el.innerHTML = 'just you so far · share the link';
      } else if (others === 1) {
        el.innerHTML = '<strong>1</strong> other person tapping right now';
      } else {
        el.innerHTML = `<strong>${others}</strong> others tapping right now`;
      }
    }

    // ---- broadcast + poll ----
    async function broadcastTap() {
      try {
        await fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: 42, sessionId: SESSION_ID }),
        });
      } catch { /* best effort */ }
    }
    async function pollOnce() {
      try {
        const r = await fetch(`/api/sounds?since=${lastT}`);
        if (!r.ok) return;
        const data = await r.json();
        if (!data.events) return;
        for (const ev of data.events) {
          if (ev.type !== 'drum') continue;
          if (ev.t <= lastT) continue;
          lastT = Math.max(lastT, ev.t);
          pidState.set(ev.pid, { color: pidColor(ev.pid), lastSeen: Date.now() });
          tapWindow.push(Date.now());
          const isSelf = ev.pid === MY_PID;
          if (!isSelf) {
            playTone(ev.pid, false);
            spawnRipple(ev.pid, false);
          }
        }
      } catch { /* best effort */ }
    }
    function startPolling() {
      if (pollTimer != null) return;
      const tick = async () => {
        await pollOnce();
        refreshUi();
        pollTimer = window.setTimeout(tick, 1500);
      };
      pollTimer = window.setTimeout(tick, 400);
    }
    function stopPolling() {
      if (pollTimer != null) { clearTimeout(pollTimer); pollTimer = null; }
    }

    function handleTap() {
      ensureCtx();
      playTone(MY_PID, true);
      spawnRipple(MY_PID, true);
      tapWindow.push(Date.now());
      pidState.set(MY_PID, { color: '#f6c15e', lastSeen: Date.now() });
      refreshUi();
      broadcastTap();
    }

    async function init() {
      SESSION_ID = getOrCreateSession();
      MY_PID = (await sha256Hex(SESSION_ID)).slice(0, 10);

      document.getElementById('dlp-circle')!.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        handleTap();
      });

      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space' || e.code === 'Enter') {
          e.preventDefault();
          handleTap();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopPolling();
        else startPolling();
      });

      // UI tick every 1s even without polling to keep rate decaying
      setInterval(refreshUi, 1000);

      refreshUi();
      startPolling();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
