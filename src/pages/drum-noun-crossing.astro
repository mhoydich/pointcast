---
/**
 * /drum-noun-crossing — The Noun Crossing. You are the crossing guard of a
 * small seaside town. A walk-signal groove pulses at 92 BPM, one Noun at a
 * time comes down the hill from the right, and your whole job is one wave:
 * tap (or SPACE) while the Noun is on the zebra stripes and it double-time
 * hops across to the far curb. Centered on the stripes is a PERFECT. Wave
 * too early or too late and a car horn barks, the Noun scoots back to the
 * curb, and the combo snaps. Every crossing the next walker moves a little
 * quicker; every fifth is a golden RUSH noun worth triple. Sixty seconds,
 * then the crowd on the far curb is your score. Best run lives in
 * localStorage; every safe crossing pings the shared /api/sounds bus.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'The Noun Crossing · sixty seconds on the zebra';
const description = 'You are the crossing guard of a small seaside town. Nouns come down the hill one at a time — wave each one through while it is on the stripes. Sixty seconds, one whistle, and the walk signal keeps the beat.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'The Noun Crossing', url: 'https://pointcast.xyz/drum-noun-crossing', description, gamePlatform: 'Web browser', playMode: 'SinglePlayer' };
// Keep in sync with NOUN_POOL in the script below. The crowd imgs load eager
// on purpose: the 8 unique SVGs double as the preload cache for walker swaps.
const NOUN_POOL = [17, 131, 258, 404, 555, 699, 831, 990];
const crowdSeeds = Array.from({ length: 20 }, (_, i) => NOUN_POOL[i % NOUN_POOL.length]);
---
<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="dncx" id="dncx">
    <header class="dncx__hud">
      <div class="dncx__stat">
        <strong class="dncx__cross" id="dncx-cross">0</strong>
        <em>across</em>
      </div>
      <div class="dncx__stat dncx__stat--mid">
        <strong class="dncx__combo" id="dncx-combo">0</strong>
        <em>combo</em>
      </div>
      <div class="dncx__stat dncx__stat--right">
        <strong class="dncx__time" id="dncx-time">60</strong>
        <em>time</em>
      </div>
    </header>

    <section class="dncx__stage" id="dncx-stage">
      <div class="dncx__sea"></div>
      <div class="dncx__curb dncx__curb--left"></div>
      <div class="dncx__curb dncx__curb--right"></div>
      <div class="dncx__road"></div>
      <div class="dncx__zebra">
        <div class="dncx__zoneflash" id="dncx-zoneflash"></div>
      </div>

      <div class="dncx__lamp" id="dncx-lamp"><span>WALK</span></div>

      <div class="dncx__crowd" id="dncx-crowd" aria-hidden="true">
        {crowdSeeds.map((s) => (
          <img class="dncx__head" src={`https://noun.pics/${s}.svg`} width="24" height="24" alt="" loading="eager" decoding="async" />
        ))}
      </div>

      <div class="dncx__walker" id="dncx-walker">
        <img class="dncx__walker-img" id="dncx-walker-img" src={`https://noun.pics/${NOUN_POOL[0]}.svg`} width="76" height="76" alt="A Noun waiting to cross the street" />
        <span class="dncx__rushtag">×3</span>
      </div>

      <div class="dncx__word" id="dncx-word" role="status" aria-live="polite"></div>

      <button class="dncx__hit" id="dncx-hit" type="button" aria-label="Wave the Noun through — tap while it is on the stripes (SPACE works too)"></button>

      <div class="dncx__overlay" id="dncx-overlay">
        <h1 class="dncx__title" id="dncx-title">THE NOUN CROSSING</h1>
        <p class="dncx__sub" id="dncx-sub">sixty seconds on the zebra · tap or SPACE while the noun is on the stripes</p>
        <p class="dncx__bestline" id="dncx-bestline">the far curb is empty. fix that.</p>
        <button class="dncx__go" id="dncx-go" type="button">▶ TAKE THE POST</button>
      </div>
    </section>

    <nav class="dncx__siblings">
      <a href="/drum-noun-whack">noun whack</a>
      <a href="/drum-says">drum says</a>
      <a href="/drum-quickdraw">quickdraw</a>
      <a href="/drum">/drum</a>
    </nav>
  </div>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dncx) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dncx {
      max-width: 640px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 94vh;
    }

    /* HUD — across (gold) · combo · time */
    .dncx__hud {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 2px 6px;
      min-height: 48px;
    }
    .dncx__stat { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; }
    .dncx__stat--mid { align-items: center; }
    .dncx__stat--right { align-items: flex-end; }
    .dncx__stat strong {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 34px;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .dncx__cross { color: #f6c15e; }
    .dncx__combo { color: #8aeac0; }
    .dncx__time { color: #f4e7c8; }
    .dncx__stat em {
      font-style: normal;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8a8a9a;
    }

    /* STAGE — one seaside street, side view */
    .dncx__stage {
      position: relative;
      flex: 1;
      min-height: 420px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background:
        radial-gradient(1.5px 1.5px at 18% 16%, rgba(244,231,200,0.55), transparent 60%),
        radial-gradient(1.5px 1.5px at 64% 9%, rgba(244,231,200,0.4), transparent 60%),
        radial-gradient(2px 2px at 84% 22%, rgba(122,200,237,0.45), transparent 60%),
        radial-gradient(1.5px 1.5px at 38% 27%, rgba(244,231,200,0.3), transparent 60%),
        linear-gradient(180deg, #07050f 0%, #0b0818 55%, #140a24 100%);
    }
    .dncx__sea {
      position: absolute;
      left: 0; right: 0;
      bottom: 40%;
      height: 9%;
      background: linear-gradient(180deg, rgba(122,200,237,0.16), rgba(122,200,237,0.05));
      border-top: 1px solid rgba(122,200,237,0.25);
    }
    .dncx__road {
      position: absolute;
      left: 12%; right: 12%;
      bottom: 0;
      height: 34%;
      background: linear-gradient(180deg, #171129 0%, #120d20 100%);
      border-top: 1px solid rgba(244,231,200,0.12);
    }
    .dncx__curb {
      position: absolute;
      bottom: 0;
      width: 12%;
      height: 40%;
      background: linear-gradient(180deg, #241b3c 0%, #191230 100%);
      border-top: 2px solid rgba(244,231,200,0.22);
      z-index: 1;
    }
    .dncx__curb--left { left: 0; border-right: 1px solid rgba(244,231,200,0.14); }
    .dncx__curb--right { right: 0; border-left: 1px solid rgba(244,231,200,0.14); }

    /* zebra zone — the whole game lives in this 22% */
    .dncx__zebra {
      position: absolute;
      left: 39%;
      width: 22%;
      bottom: 0;
      height: 34%;
      background: repeating-linear-gradient(
        90deg,
        rgba(244,231,200,0.68) 0 12px,
        rgba(244,231,200,0.05) 12px 26px
      );
      border-left: 1px dashed rgba(246,193,94,0.35);
      border-right: 1px dashed rgba(246,193,94,0.35);
    }
    .dncx__zoneflash {
      position: absolute;
      inset: 0;
      opacity: 0;
      background: #8aeac0;
    }
    .dncx__zoneflash--go { animation: dncxZone 0.5s ease-out; }
    @keyframes dncxZone {
      0% { opacity: 0.5; }
      100% { opacity: 0; }
    }

    /* walk signal — blinks on the kick */
    .dncx__lamp {
      position: absolute;
      top: 9%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.24em;
      color: #8a8a9a;
      background: rgba(7,5,15,0.7);
      border: 1px solid rgba(244,231,200,0.2);
      border-radius: 8px;
      padding: 8px 14px;
      transition: color 90ms ease, box-shadow 90ms ease, border-color 90ms ease;
    }
    .dncx__lamp--on {
      color: #8aeac0;
      border-color: rgba(138,234,192,0.6);
      box-shadow: 0 0 18px rgba(138,234,192,0.35), inset 0 0 10px rgba(138,234,192,0.18);
    }

    /* the far-curb crowd — server-rendered slots, revealed as they land */
    .dncx__crowd {
      position: absolute;
      left: 1%;
      bottom: 33%;
      width: 11%;
      min-width: 56px;
      display: flex;
      flex-wrap: wrap-reverse;
      align-items: flex-end;
      gap: 1px;
      z-index: 2;
      pointer-events: none;
    }
    .dncx__head {
      width: 24px; height: 24px;
      image-rendering: pixelated;
      display: none;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }
    .dncx__head--in { display: block; animation: dncxHeadIn 0.45s cubic-bezier(0.2, 1.6, 0.4, 1); }
    @keyframes dncxHeadIn {
      0% { transform: translateY(-14px) scale(0.4); }
      100% { transform: translateY(0) scale(1); }
    }
    .dncx__crowd--cheer { animation: dncxCheer 0.4s ease; }
    @keyframes dncxCheer {
      0%, 100% { transform: translateY(0); }
      40% { transform: translateY(-5px); }
    }

    /* the walker */
    .dncx__walker {
      position: absolute;
      left: 0;
      bottom: 6%;
      width: 76px;
      height: 76px;
      z-index: 3;
      pointer-events: none;
      will-change: transform;
    }
    .dncx__walker-img {
      width: 76px; height: 76px;
      image-rendering: pixelated;
      filter: drop-shadow(0 6px 12px rgba(0,0,0,0.55));
      will-change: transform;
    }
    .dncx__walker--rush .dncx__walker-img {
      filter: drop-shadow(0 0 14px rgba(246,193,94,0.75)) brightness(1.16) saturate(1.2);
    }
    .dncx__rushtag {
      display: none;
      position: absolute;
      top: -18px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 800;
      color: #f6c15e;
      text-shadow: 0 0 10px rgba(246,193,94,0.7);
    }
    .dncx__walker--rush .dncx__rushtag { display: block; }

    /* judgment word */
    .dncx__word {
      position: absolute;
      top: 30%;
      left: 0; right: 0;
      text-align: center;
      z-index: 4;
      pointer-events: none;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      font-size: clamp(22px, 6.5vw, 40px);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0;
      text-shadow: 0 0 16px currentColor;
    }
    .dncx__word--pop { animation: dncxFlare 0.8s ease forwards; }
    @keyframes dncxFlare {
      0% { opacity: 0; transform: translateY(8px) scale(0.85); }
      18% { opacity: 1; transform: translateY(0) scale(1.04); }
      70% { opacity: 1; transform: translateY(-4px) scale(1); }
      100% { opacity: 0; transform: translateY(-12px) scale(0.98); }
    }

    /* full-stage tap target — the whole street is the whistle */
    .dncx__hit {
      position: absolute;
      inset: 0;
      z-index: 5;
      background: transparent;
      border: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    /* OVERLAY — start / time. Toggled by CLASS, never [hidden]. */
    .dncx__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(7,5,15,0.84);
      backdrop-filter: blur(3px);
      z-index: 6;
      text-align: center;
      padding: 20px;
    }
    .dncx__overlay--hidden { display: none; }
    .dncx__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(26px, 7vw, 46px);
      letter-spacing: 0.16em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dncx__sub, .dncx__bestline {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
      max-width: 380px;
      line-height: 1.7;
    }
    .dncx__bestline { color: #d4a437; }
    .dncx__go {
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dncx__go:hover { transform: translateY(-1px); background: #ffd98a; }

    .dncx__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dncx__siblings a { color: #d4a437; text-decoration: none; }
    .dncx__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .dncx__stage { min-height: 380px; }
      .dncx__stat strong { font-size: 28px; }
      .dncx__walker, .dncx__walker-img { width: 60px; height: 60px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .dncx *, .dncx *::before, .dncx *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>

  <script>
    // Keep in sync with NOUN_POOL in the frontmatter (crowd slot srcs).
    const NOUN_POOL = [17, 131, 258, 404, 555, 699, 831, 990];

    const GAME_SECONDS = 60;
    const BPM = 92;
    const BEAT = 60 / BPM;              // ~0.652s — the walk-signal groove
    const ZONE_L = 0.39;                // zebra zone, as fractions of stage width
    const ZONE_R = 0.61;
    const ZONE_C = (ZONE_L + ZONE_R) / 2;
    const PERFECT_BAND = (ZONE_R - ZONE_L) * 0.2;  // centered ±20% of the zone
    const START_XF = 1.02;              // walker spawns just off the right edge
    const LAND_XF = 0.045;              // and lands on the left curb
    const HOP_DUR = 0.66;               // double-time hop across, seconds
    const HOPS = 3;
    const SCOOT_DUR = 0.6;              // the walk of shame back to the curb
    const BASE_SPEED = 0.16;            // stage-widths per second
    const SPEED_STEP = 0.013;           // each crossing, a little quicker
    const SPEED_CAP = 0.5;
    const RUSH_MULT = 1.55;             // golden nouns are in a hurry

    type Mode = 'walking' | 'hopping' | 'scooting';
    type Phase = 'idle' | 'playing' | 'over';

    let SESSION_ID = '';
    let phase: Phase = 'idle';
    let mode: Mode = 'walking';
    let xf = START_XF;                  // walker left edge, fraction of stage width
    let hopT = 0, hopFromXf = START_XF;
    let scootT = 0, scootFromXf = START_XF;
    let speedFrac = BASE_SPEED;
    let facing = -1;                    // -1 walking left, +1 scooting right

    let crossings = 0;
    let points = 0;
    let combo = 0;
    let bestCombo = 0;
    let best = 0;
    let crowdIdx = 0;
    let curSeed = NOUN_POOL[0];
    let nextSeed = NOUN_POOL[1];
    let isRush = false;

    let startedAt = 0;
    let lastFrame = 0;
    let rafId = 0;
    let beatTimer = 0;
    let nextBeatAt = 0;
    let lampTimer = 0;

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    // the groove: kick on the beat…
    function pKick(t: number) {
      const a = ctx();
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(120, t);
      o.frequency.exponentialRampToValueAtTime(44, t + 0.12);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.22, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.24);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 0.26);
    }
    // …hat on the off-beat
    function pHat(t: number) {
      const a = ctx();
      const dur = 0.045;
      const buf = a.createBuffer(1, Math.max(1, Math.floor(a.sampleRate * dur)), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 6200;
      const g = a.createGain();
      g.gain.setValueAtTime(0.05, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      n.connect(hp).connect(g).connect(a.destination);
      n.start(t);
    }
    // safe crossing — happy pentatonic chirp; PERFECT adds a top note, RUSH goes brighter
    function pChirp(perfect: boolean, rush: boolean) {
      const a = ctx(); const base = a.currentTime + 0.01;
      let notes = perfect ? [440, 554.37, 659.25, 880] : [440, 554.37, 659.25];
      if (rush) notes = perfect ? [523.25, 659.25, 783.99, 1046.5, 1318.5] : [523.25, 659.25, 783.99, 1046.5];
      const gap = rush ? 0.07 : 0.085;
      notes.forEach((f, i) => {
        const t = base + i * gap;
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.24, t + 0.008);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.28);
        o.connect(g).connect(a.destination);
        o.start(t); o.stop(t + 0.32);
        const o2 = a.createOscillator(); const g2 = a.createGain();
        o2.type = 'sine'; o2.frequency.setValueAtTime(f * 2, t);
        g2.gain.setValueAtTime(0.0001, t);
        g2.gain.exponentialRampToValueAtTime(0.05, t + 0.008);
        g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
        o2.connect(g2).connect(a.destination);
        o2.start(t); o2.stop(t + 0.2);
      });
    }
    // bad wave — a car horn: two saws a minor 2nd apart, lowpassed, sagging at the end
    function pHonk() {
      const a = ctx(); const t = a.currentTime + 0.005;
      const dur = 0.55;
      const lp = a.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 780; lp.Q.value = 1.1;
      const master = a.createGain();
      master.gain.setValueAtTime(0.0001, t);
      master.gain.exponentialRampToValueAtTime(0.3, t + 0.02);
      master.gain.setValueAtTime(0.3, t + dur - 0.18);
      master.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      lp.connect(master).connect(a.destination);
      [196.0, 207.65].forEach((f) => {  // G3 + Ab3 — the sour minor 2nd
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'sawtooth';
        o.frequency.setValueAtTime(f, t);
        o.frequency.setValueAtTime(f, t + dur - 0.14);
        o.frequency.exponentialRampToValueAtTime(f * 0.93, t + dur);  // doppler sag
        g.gain.value = 0.5;
        o.connect(g).connect(lp);
        o.start(t); o.stop(t + dur + 0.02);
      });
    }
    // shift's over — a little whistle-down flourish
    function pShiftOver(good: boolean) {
      const a = ctx(); const base = a.currentTime + 0.02;
      const notes = good ? [523.25, 659.25, 783.99, 1046.5] : [392.0, 329.63, 261.63];
      notes.forEach((f, i) => {
        const t = base + i * 0.11;
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.24, t + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
        o.connect(g).connect(a.destination);
        o.start(t); o.stop(t + 0.34);
      });
    }

    // ---- shared drum bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(seed: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // never flood the bus
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- dom ----
    const stage = document.getElementById('dncx-stage')!;
    const walkerEl = document.getElementById('dncx-walker')!;
    const walkerImg = document.getElementById('dncx-walker-img') as HTMLImageElement;
    const lampEl = document.getElementById('dncx-lamp')!;
    const wordEl = document.getElementById('dncx-word')!;
    const zoneFlash = document.getElementById('dncx-zoneflash')!;
    const crowdEl = document.getElementById('dncx-crowd')!;
    const heads = Array.from(crowdEl.querySelectorAll('.dncx__head')) as HTMLImageElement[];
    const hitBtn = document.getElementById('dncx-hit') as HTMLButtonElement;
    const goBtn = document.getElementById('dncx-go') as HTMLButtonElement;
    const overlay = document.getElementById('dncx-overlay')!;
    const titleEl = document.getElementById('dncx-title')!;
    const subEl = document.getElementById('dncx-sub')!;
    const bestLine = document.getElementById('dncx-bestline')!;
    const crossEl = document.getElementById('dncx-cross')!;
    const comboEl = document.getElementById('dncx-combo')!;
    const timeEl = document.getElementById('dncx-time')!;

    let W = 0;
    let walkerW = 76;
    function resize() {
      W = stage.getBoundingClientRect().width || 1;
      walkerW = walkerEl.getBoundingClientRect().width || 76;
    }
    window.addEventListener('resize', resize);

    // ---- ui helpers ----
    function flare(text: string, color: string) {
      wordEl.textContent = text;
      (wordEl as HTMLElement).style.color = color;
      wordEl.classList.remove('dncx__word--pop');
      void (wordEl as HTMLElement).offsetWidth;   // restart the animation
      wordEl.classList.add('dncx__word--pop');
    }
    function flashZone(color: string) {
      (zoneFlash as HTMLElement).style.background = color;
      zoneFlash.classList.remove('dncx__zoneflash--go');
      void (zoneFlash as HTMLElement).offsetWidth;
      zoneFlash.classList.add('dncx__zoneflash--go');
    }
    function blinkLamp() {
      if (phase !== 'playing') return;
      lampEl.classList.add('dncx__lamp--on');
      clearTimeout(lampTimer);
      lampTimer = window.setTimeout(() => lampEl.classList.remove('dncx__lamp--on'), 150);
    }
    function updateHud() {
      crossEl.textContent = String(crossings);
      comboEl.textContent = String(combo);
    }

    // ---- the groove: lookahead scheduler at 92 BPM ----
    function beatTick() {
      const a = ctx();
      while (nextBeatAt < a.currentTime + 0.14) {
        pKick(nextBeatAt);
        pHat(nextBeatAt + BEAT / 2);
        const ms = Math.max(0, (nextBeatAt - a.currentTime) * 1000);
        window.setTimeout(blinkLamp, ms);
        nextBeatAt += BEAT;
      }
    }
    function startGroove() {
      const a = ctx();
      nextBeatAt = a.currentTime + 0.08;
      beatTick();
      beatTimer = window.setInterval(beatTick, 50);
    }
    function stopGroove() {
      clearInterval(beatTimer);
      clearTimeout(lampTimer);
      lampEl.classList.remove('dncx__lamp--on');
    }

    // ---- walkers ----
    function pickSeed() { return NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]; }
    // (no Image() preloader — the eager server-rendered crowd already fetched every pool SVG)
    function spawnWalker() {
      curSeed = nextSeed;
      nextSeed = pickSeed();
      isRush = (crossings + 1) % 5 === 0;   // every fifth walker is in a golden hurry
      speedFrac = Math.min(SPEED_CAP, BASE_SPEED + crossings * SPEED_STEP) * (isRush ? RUSH_MULT : 1);
      walkerEl.classList.toggle('dncx__walker--rush', isRush);
      walkerImg.src = `https://noun.pics/${curSeed}.svg`;
      walkerImg.alt = isRush ? 'A golden Noun in a hurry to cross' : 'A Noun crossing the street';
      xf = START_XF;
      facing = -1;
      mode = 'walking';
    }
    function walkerCenterFrac() { return xf + (walkerW / 2) / W; }

    // ---- the wave ----
    function wave() {
      if (phase !== 'playing' || mode !== 'walking') return;
      const c = walkerCenterFrac();
      if (c >= ZONE_L && c <= ZONE_R) {
        const perfect = Math.abs(c - ZONE_C) <= PERFECT_BAND;
        let pts = perfect ? 2 : 1;
        if (isRush) pts *= 3;
        points += pts;
        crossings += 1;
        combo += 1;
        if (combo > bestCombo) bestCombo = combo;
        updateHud();
        pChirp(perfect, isRush);
        if (perfect) flashZone('#8aeac0');
        const label = perfect ? 'PERFECT' : 'GOOD';
        flare(isRush ? `${label} ×3` : label, perfect ? '#8aeac0' : '#f6c15e');
        broadcast(crossings % 4);
        hopFromXf = xf;
        hopT = 0;
        mode = 'hopping';
      } else {
        honk(c > ZONE_R ? 'TOO EARLY' : 'TOO LATE');
      }
    }
    function honk(label: string) {
      combo = 0;
      updateHud();
      pHonk();
      flare(label, '#ff6b8a');
      flashZone('#ff6b8a');
      scootFromXf = xf;
      scootT = 0;
      facing = 1;
      mode = 'scooting';
    }

    function land() {
      // one more safe on the far curb
      if (crowdIdx < heads.length) {
        const head = heads[crowdIdx];
        head.src = `https://noun.pics/${curSeed}.svg`;
        head.classList.add('dncx__head--in');
        crowdIdx += 1;
      }
      crowdEl.classList.remove('dncx__crowd--cheer');
      void (crowdEl as HTMLElement).offsetWidth;
      crowdEl.classList.add('dncx__crowd--cheer');
      spawnWalker();
    }

    // ---- main loop ----
    const easeOut = (p: number) => 1 - (1 - p) * (1 - p);
    function tick(now: number) {
      const dt = Math.min(0.05, (now - lastFrame) / 1000 || 0);
      lastFrame = now;

      if (phase === 'playing') {
        const remaining = GAME_SECONDS - (now - startedAt) / 1000;
        timeEl.textContent = String(Math.max(0, Math.ceil(remaining)));
        if (remaining <= 0) {
          endRun();
        } else if (mode === 'walking') {
          xf -= speedFrac * dt;
          if (walkerCenterFrac() < ZONE_L - 0.012) honk('TOO LATE'); // walked past unwaved
        } else if (mode === 'hopping') {
          hopT += dt;
          if (hopT >= HOP_DUR) { land(); }
        } else if (mode === 'scooting') {
          scootT += dt;
          if (scootT >= SCOOT_DUR) { facing = -1; mode = 'walking'; }
        }
      }

      // render the walker
      let x = xf * W;
      let y = 0;
      let sx = 1, sy = 1, rot = 0;
      if (mode === 'walking') {
        // little step-bob as it walks
        y = -Math.abs(Math.sin((x / 34) * Math.PI)) * 4;
      } else if (mode === 'hopping') {
        const p = Math.min(1, hopT / HOP_DUR);
        x = (hopFromXf + (LAND_XF - hopFromXf) * easeOut(p)) * W;
        const h = Math.abs(Math.sin(p * Math.PI * HOPS));
        y = -h * 26 - easeOut(p) * 10;  // hops, with a small climb up to the curb
        sy = 0.82 + 0.36 * h;           // squash on the ground, stretch mid-air
        sx = 1.18 - 0.3 * h;
      } else if (mode === 'scooting') {
        const p = Math.min(1, scootT / SCOOT_DUR);
        x = (scootFromXf + (START_XF - 0.06 - scootFromXf) * easeOut(p)) * W;
        rot = Math.sin(p * Math.PI * 5) * 5 * (1 - p);  // indignant little shake
        y = -Math.abs(Math.sin(p * Math.PI * 4)) * 5;
      }
      (walkerEl as HTMLElement).style.transform = `translate(${x}px, ${y}px) rotate(${rot}deg)`;
      walkerImg.style.transform = `scale(${facing * sx}, ${sy})`;

      // only keep the loop alive mid-shift — endRun's cancel must stick
      if (phase === 'playing') rafId = requestAnimationFrame(tick);
    }

    // ---- run control ----
    function startRun() {
      ctx();
      crossings = 0;
      points = 0;
      combo = 0;
      bestCombo = 0;
      crowdIdx = 0;
      heads.forEach((h) => h.classList.remove('dncx__head--in'));
      nextSeed = pickSeed();
      updateHud();
      timeEl.textContent = String(GAME_SECONDS);
      resize();
      spawnWalker();
      overlay.classList.add('dncx__overlay--hidden');
      phase = 'playing';
      startedAt = performance.now();
      startGroove();
      cancelAnimationFrame(rafId);
      lastFrame = performance.now();
      rafId = requestAnimationFrame(tick);
    }

    function gradeOf(n: number) {
      if (n >= 22) return 'S';
      if (n >= 16) return 'A';
      if (n >= 11) return 'B';
      if (n >= 6) return 'C';
      return 'D';
    }

    function endRun() {
      phase = 'over';
      stopGroove();
      cancelAnimationFrame(rafId); // the street goes quiet — no frames while the overlay is up
      const g = gradeOf(crossings);
      pShiftOver(g === 'S' || g === 'A' || g === 'B');
      titleEl.textContent = `GRADE ${g}`;
      subEl.textContent = `${crossings} noun${crossings === 1 ? '' : 's'} made it across · best combo ${bestCombo} · ${points} pts`;
      try {
        if (crossings > best) {
          best = crossings;
          localStorage.setItem('pc-drum-noun-crossing-best', String(best));
        }
        bestLine.textContent = `best shift: ${best} across`;
      } catch {
        bestLine.textContent = `best shift: ${crossings} across`;
      }
      goBtn.textContent = '▶ RUN IT BACK';
      overlay.classList.remove('dncx__overlay--hidden');
      goBtn.focus({ preventScroll: true });
    }

    // ---- input ----
    hitBtn.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      wave();
    });
    hitBtn.addEventListener('click', (e) => {
      // Pointer input lands on contact for tight timing; keyboard and
      // assistive-tech activation arrives as detail 0.
      if (e.detail === 0) wave();
    });
    goBtn.addEventListener('click', () => { ctx(); startRun(); });
    window.addEventListener('keydown', (e) => {
      if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || tag === 'button' || tag === 'a') return;
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        if (phase === 'idle' || phase === 'over') { ctx(); startRun(); }
        else wave();
      }
    });

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    resize();
    try {
      best = Number(localStorage.getItem('pc-drum-noun-crossing-best') || 0) || 0;
      if (best > 0) bestLine.textContent = `best shift: ${best} across`;
    } catch {}
    // park the walker just off the right edge; the loop only runs during a shift
    (walkerEl as HTMLElement).style.transform = `translate(${START_XF * W}px, 0px)`;
  </script>
</BlockLayout>
