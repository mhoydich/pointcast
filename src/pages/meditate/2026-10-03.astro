---
import BlockLayout from '../../layouts/BlockLayout.astro';
import edition from '../../data/saturday-meditation-2026-10-03.json';
import { movements } from '../../lib/saturday-session.mjs';
const title = 'Some other time · Saturday meditation';
const description = 'An original, interactive listening meditation for Saturday, October 3, 2026 in El Segundo, with Bill Evans Trio, a gentle optional breath cue, and sourced local and world context.';
---
<BlockLayout title={title} description={description} immersive isolated themeColor="#091c2b" image={edition.art.src} imageWidth={1672} imageHeight={940} alternates={[{ type: 'application/json', href: '/meditate/2026-10-03.json', title: 'Saturday meditation sources and provenance' }]} jsonLd={{ '@context': 'https://schema.org', '@type': 'CreativeWork', name: title, description, dateCreated: edition.date, spatialCoverage: edition.location, url: 'https://pointcast.xyz/meditate/2026-10-03', author: { '@type': 'Organization', name: 'PointCast' } }}>
  <div class="saturday" data-saturday>
    <header class="topline">
      <a class="brand" href="/">PointCast<span class="mono"> / Quiet signal</span></a>
      <a class="backlink" href="/meditate">Ocean room</a>
    </header>

    <section class="room" aria-labelledby="edition-title">
      <img class="horizon" src={edition.art.src} width="1672" height="940" alt="An imagined Pacific horizon in midnight blue and apricot, crossed by a fine silver arc." fetchpriority="high" />
      <div class="veil"></div>
      <div class="room-top mono"><time datetime="2026-10-03">Saturday / October 3, 2026</time><span>El Segundo, California · PDT</span></div>
      <div class="room-body">
        <div class="invitation">
          <p class="eyebrow mono">A listening meditation</p>
          <h1 id="edition-title">Some other<br /> time.</h1>
          <p class="intro">Let Saturday have a little space.</p>
          <p class="song"><span>With “Some Other Time”</span><br />Bill Evans Trio</p>
          <a class="music-link" href={edition.audio.playbackUrl} target="_blank" rel="noopener noreferrer">Listen to a Bill Evans Trio version <span aria-hidden="true">↗</span></a>
          <p class="music-note">Start your music first. This separate timer follows its own pace; the linked recording may differ.</p>
        </div>
        <div class="practice" aria-label="Meditation session">
          <div class="orbit" data-orbit>
            <div class="orbit-inner">
              <span class="mono" data-breath aria-hidden="true">Your own pace</span>
              <span class="clock" data-clock role="timer" aria-live="off" aria-label="5 minutes remaining">5:00</span>
              <span class="orbit-note">Nothing to catch up to.</span>
            </div>
          </div>
          <div class="setup">
            <label class="mono" for="session-length">Stay for</label>
            <select id="session-length" data-length disabled>
              <option value="180">3 minutes</option><option value="300" selected>5 minutes</option><option value="480">8 minutes</option>
            </select>
          </div>
          <div class="actions">
            <button class="begin" data-start disabled>Begin a quiet moment</button>
            <button class="reset" data-reset hidden>Reset</button>
          </div>
          <p class="sr-only" data-breath-status role="status"></p>
          <p class="session-status" data-status role="status">Choose a comfortable place to sit.</p>
          <div class="preferences" hidden data-preferences>
            <button data-breath-toggle aria-pressed="false">Breath cue off</button>
            <button data-motion aria-pressed="false">Reduce motion</button>
          </div>
          <p class="breath-note">Optional cue: 4 seconds in, 6 out, no hold. Keep your own comfortable breath, or turn the cue off.</p>
          <noscript><p class="fallback-note">The timer needs JavaScript. You can still play the music and read all four invitations below, at your own pace.</p></noscript>
        </div>
      </div>
      <div class="weather-line"><span class="weather-value">87°F <small>30.6°C</small></span><span>Mostly clear at nearby LAX<br /><small>Observed 8:53 AM PDT · October 3</small></span><a href="#outside">Today’s context & sources</a></div>
    </section>

    <section class="score" aria-labelledby="movement-title">
      <div class="score-head"><p class="mono" data-movement-count>01 / 04</p><p class="mono" data-session-label>Before you begin</p></div>
      <div class="movement" aria-live="polite" aria-atomic="true">
        <h2 id="movement-title" data-movement-title>Arrive.</h2>
        <p data-cue>{movements[0].cue}</p>
        <p class="small-invitation" data-invitation>{movements[0].invitation}</p>
      </div>
      <div class="progress" aria-hidden="true"><span data-progress></span></div>
      <ol class="movements" aria-label="The four movements">
        {movements.map((movement, index) => <li data-step={index} class:list={{ current: index === 0 }}><span class="mono">0{index + 1}</span>{movement.title}</li>)}
      </ol>
    </section>

    <section class="reflection" aria-labelledby="reflection-title">
      <div><p class="eyebrow mono">An optional small gesture</p><h2 id="reflection-title">What can wait?</h2><p>Give one thing a little room. It will still be there when you return.</p></div>
      <div class="reflection-options" role="group" aria-label="Choose something to set down for a moment">
        <button data-release="The rush" aria-pressed="false" disabled>The rush</button><button data-release="An unfinished thing" aria-pressed="false" disabled>An unfinished thing</button><button data-release="A comparison" aria-pressed="false" disabled>A comparison</button>
        <p data-release-note role="status">Your choice stays in this page and disappears when you leave.</p>
      </div>
    </section>

    <details class="full-score"><summary>Read the full meditation</summary><div class="written-score">{movements.map((movement, index) => <article><p class="mono">0{index + 1} / {movement.title}</p><p>{movement.cue}</p><p class="small-invitation">{movement.invitation}</p></article>)}</div></details>

    <section class="outside" id="outside" aria-labelledby="outside-title">
      <div class="outside-heading"><div><p class="eyebrow mono">A dated snapshot / Checked 9:41 AM PDT</p><h2 id="outside-title">Saturday, outside this room.</h2></div><p>The world belongs in the frame. You can choose how much to take in.</p></div>
      <div class="context-grid">
        <article class="context weather"><p class="mono">Here / Observed + forecast</p><h3>A very warm morning.</h3><p><strong>87.1°F / 30.6°C</strong> at KLAX, mostly clear, observed October 3 at 8:53 AM PDT. The airport is about 2.1 miles northeast of the El Segundo forecast point; your neighborhood may differ.</p><p>NWS forecasts sunshine. Issued October 3 at 4:11 AM PDT. Its updated high of 81°F is below the nearby observation; fetched values changed, so a reliable numeric high is not presented here.</p><p class="heat"><strong>Extreme Heat Warning</strong> for LA County Beaches through October 8, 8 PM PDT. Settle somewhere cool; keep water nearby.</p><div class="source-links"><a href={edition.weather.observationSource} target="_blank" rel="noopener noreferrer">NOAA observation</a><a href={edition.weather.forecastSource} target="_blank" rel="noopener noreferrer">NWS forecast</a><a href={edition.weather.warningSource} target="_blank" rel="noopener noreferrer">NWS heat guidance</a></div></article>
        <article class="context world"><p class="mono">Wider world / October 3</p><h3>A thought for people far away.</h3><details class="news-detail"><summary>Read one brief news item</summary><p>{edition.context.world.text}</p><p class="source-time">Reported October 3, 3:48 AM PDT. This account is attributed to Ukraine’s ports administration.</p><a href={edition.context.world.source} target="_blank" rel="noopener noreferrer">Reuters report</a><span class="source-separator"> · </span><a href={edition.context.world.retrievedSyndication} target="_blank" rel="noopener noreferrer">Retrieved syndication</a></details><p>Yesterday, October 2, marked the International Day of Non-Violence. The UN Secretary-General’s 2026 message called for dialogue, diplomacy and empathy.</p><p class="creative-note">A meditation invitation: offer a quiet wish for someone’s safety, then return to the room.</p><div class="source-links"><a href={edition.context.reflectionContext.source} target="_blank" rel="noopener noreferrer">UN message</a><a href={edition.context.reflectionContext.eventRecord} target="_blank" rel="noopener noreferrer">Dated UN event record</a></div></article>
        <article class="context local"><p class="mono">El Segundo / Scheduled today</p><h3>A town making things.</h3><p>{edition.context.local.text}</p><p>The calendar gives today’s date; dates and locations may change. Attendance and on-site conditions have not been checked.</p><p class="creative-note">A meditation invitation: notice the care people put into small things, and one small thing near you.</p><div class="source-links"><a href={edition.context.local.source} target="_blank" rel="noopener noreferrer">Mattel’s official tour calendar</a></div></article>
      </div>
      <p class="snapshot-note">These are October 3 research snapshots, not live updates. The official UN message was verified through indexed 2026 text and its dated event record; direct retrieval was unavailable. The Pacific artwork is an imagined scene, separate from the weather reading.</p>
    </section>

    <footer class="colophon"><div><a href="/">PointCast</a><span>Saturday edition / 2026.10.03</span></div><p>Original meditation text by Codex, at Mike’s direction. Original AI-generated artwork. Music by Bill Evans Trio; composition credited to Leonard Bernstein, Betty Comden and Adolph Green. No lyrics reproduced. The exact recording in the supplied screenshot was not identified.</p><a href="/meditate/2026-10-03.json">Sources & provenance · JSON</a></footer>
  </div>
</BlockLayout>

<script>
  import { createSession, breathAt, movements } from '../../lib/saturday-session.mjs';
  const root = document.querySelector<HTMLElement>('[data-saturday]');
  if (root) {
    const find = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const length = find<HTMLSelectElement>('[data-length]');
    const start = find<HTMLButtonElement>('[data-start]');
    const reset = find<HTMLButtonElement>('[data-reset]');
    const status = find('[data-status]');
    const clock = find('[data-clock]');
    const orbit = find('[data-orbit]');
    const breath = find('[data-breath]');
    const breathToggle = find<HTMLButtonElement>('[data-breath-toggle]');
    const motion = find<HTMLButtonElement>('[data-motion]');
    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
    let motionOff = media.matches;
    let motionChosen = false;
    let breathOn = false;
    let breathTouched = false;
    let lastBreathAnnouncement = '';
    let session = createSession(Number(length.value));
    let frame = 0;
    let lastMovement = -1;
    let lastState = '';
    function render() {
      const view = session.snapshot(performance.now());
      const minutes = Math.floor(view.remaining / 60);
      const seconds = view.remaining % 60;
      clock.textContent = `${minutes}:${String(seconds).padStart(2, '0')}`;
      clock.setAttribute('aria-label', `${minutes} minutes ${seconds} seconds remaining`);
      find('[data-progress]').style.width = `${view.progress * 100}%`;
      start.textContent = view.state === 'running' ? 'Pause' : view.state === 'paused' ? 'Resume' : view.state === 'complete' ? 'Begin again' : 'Begin a quiet moment';
      reset.hidden = view.state === 'idle';
      length.disabled = view.state === 'running' || view.state === 'paused';
      find('[data-session-label]').textContent = view.state === 'running' ? 'A little space' : view.state === 'paused' ? 'Take your time' : view.state === 'complete' ? 'Carry it with you' : 'Before you begin';
      if (view.state !== lastState) {
        status.textContent = view.state === 'running' ? 'Your quiet moment has begun.' : view.state === 'paused' ? 'Paused. Your music has its own controls.' : view.state === 'complete' ? 'The timer is complete. Stay as long as you like.' : 'Choose a comfortable place to sit.';
        lastState = view.state;
      }
      if (view.movement !== lastMovement) {
        const movement = movements[view.movement];
        find('[data-movement-count]').textContent = `0${view.movement + 1} / 04`;
        find('[data-movement-title]').textContent = `${movement.title}.`;
        find('[data-cue]').textContent = movement.cue;
        find('[data-invitation]').textContent = movement.invitation;
        root!.querySelectorAll('[data-step]').forEach((step, index) => { step.classList.toggle('current', index === view.movement); });
        lastMovement = view.movement;
      }
      const cue = breathAt(view.elapsed);
      breath.textContent = view.state === 'paused' ? 'Paused' : view.state === 'complete' ? 'Your own pace' : breathOn && view.state === 'running' ? cue.label : 'Your own pace';
      orbit.style.transform = breathOn && !motionOff && view.state === 'running' ? `scale(${cue.scale})` : 'scale(1)';
      motion.textContent = 'Reduce motion';
      const breathAnnouncement = breathOn ? view.state === 'running' ? `${cue.label}. Keep it comfortable.` : view.state === 'paused' ? 'Breath cue paused.' : view.state === 'complete' ? 'Cue complete. Return to your own pace.' : 'Breath cue enabled. It begins when you start.' : breathTouched ? 'Breath cue off. Use your own pace.' : '';
      if (breathAnnouncement !== lastBreathAnnouncement) { find('[data-breath-status]').textContent = breathAnnouncement; lastBreathAnnouncement = breathAnnouncement; }
      motion.setAttribute('aria-pressed', String(motionOff));
      breathToggle.textContent = breathOn ? 'Breath cue on' : 'Breath cue off';
      breathToggle.setAttribute('aria-pressed', String(breathOn));
      cancelAnimationFrame(frame);
      if (view.state === 'running') frame = requestAnimationFrame(render);
    }
    start.disabled = false;
    length.disabled = false;
    find('[data-preferences]').hidden = false;
    start.addEventListener('click', () => {
      const now = performance.now();
      const state = session.snapshot(now).state;
      if (state === 'running') session.pause(now);
      else { if (state === 'complete') session.reset(now); session.start(now); }
      render();
    });
    reset.addEventListener('click', () => { session.reset(performance.now()); render(); });
    length.addEventListener('change', () => { session = createSession(Number(length.value)); lastMovement = -1; render(); });
    breathToggle.addEventListener('click', () => { breathTouched = true; breathOn = !breathOn; render(); });
    motion.addEventListener('click', () => { motionChosen = true; motionOff = !motionOff; render(); });
    media.addEventListener('change', () => { if (!motionChosen) { motionOff = media.matches; render(); } });
    root.querySelectorAll<HTMLButtonElement>('[data-release]').forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        const selected = button.getAttribute('aria-pressed') !== 'true';
        root.querySelectorAll('[data-release]').forEach((choice) => choice.setAttribute('aria-pressed', String(selected && choice === button)));
        find('[data-release-note]').textContent = selected ? `${button.dataset.release} can have a little room. No need to resolve it here.` : 'Your choice stays in this page and disappears when you leave.';
      });
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && session.snapshot(performance.now()).state === 'running') {
        session.pause(performance.now()); render();
        status.textContent = 'Paused while this page is away. Resume whenever you are ready.';
      }
    });
    window.addEventListener('pagehide', () => { session.pause(performance.now()); cancelAnimationFrame(frame); });
    window.addEventListener('pageshow', render);
    render();
  }
</script>

<style is:global>
  html:has(.saturday), html:has(.saturday) body { background: #091c2b; color: #eef4f6; }
  html:has(.saturday) { scroll-behavior: smooth; }
  body:has(.saturday) { padding: 0 !important; }
  .saturday { --ink: #eef4f6; --dim: #b4c7d3; --rule: #365062; --accent: #f4c698; color: var(--ink); max-width: 1600px; margin: auto; }
  .saturday a { color: inherit !important; }
  .saturday button, .saturday select { font: inherit; }
  .saturday button, .saturday select, .saturday summary { cursor: pointer; }
  .saturday button:disabled, .saturday select:disabled { cursor: default; }
  .saturday :focus-visible { outline: 3px solid #f4c698; outline-offset: 5px; }
  .saturday [hidden] { display: none !important; }
  .saturday .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .saturday .mono { font: 400 .75rem/1.6 var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .topline { min-height: 74px; padding: 22px 4%; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--rule); gap: 20px; }
  .brand { font-size: 1.2rem; letter-spacing: -.05em; }
  .brand span { color: var(--dim); letter-spacing: .06em; margin-left: 16px; }
  .backlink { font-size: .875rem; }
  .room { position: relative; overflow: hidden; isolation: isolate; padding: 28px 5% 0; }
  .horizon { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; }
  .veil { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(5,20,32,.58), rgba(5,20,32,.17)), linear-gradient(0deg, #091c2b 0%, transparent 50%); }
  .room-top { display: flex; justify-content: space-between; gap: 16px; color: #f1e4d8; }
  .room-body { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; padding: 54px 0 58px; }
  .eyebrow { color: var(--accent); margin: 0 0 16px; }
  .invitation h1 { font-weight: 400; font-size: clamp(3.8rem, 7.4vw, 7.2rem); line-height: .98; letter-spacing: -.065em; margin: 0; }
  .intro { font-size: 1.3rem; margin: 24px 0 32px; }
  .song { font-size: 1.05rem; line-height: 1.6; margin: 0 0 17px; }
  .song span { color: #d6e2e8; }
  .music-link { font-size: .875rem; display: inline-block; padding-bottom: 6px; border-bottom: 1px solid #92a6b3; }
  .music-link span { margin-left: 8px; }
  .music-note { font-size: .875rem; color: #d0dce4; max-width: 34ch; line-height: 1.6; margin-bottom: 0; }
  .practice { text-align: center; padding-top: 8px; }
  .orbit { width: 250px; height: 250px; border: 1px solid #afc1ce; border-radius: 50%; margin: 0 auto 35px; background: radial-gradient(circle, #102434a8 5%, #1024343d 75%); box-shadow: 0 0 0 16px #d4e4ed08, 0 0 0 34px #d4e4ed05; will-change: transform; }
  .orbit-inner { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  .clock { font-size: 3.4rem; font-weight: 400; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
  .orbit-note { font-size: .875rem; color: #c1d3df; }
  .setup { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 17px; }
  .setup select { color: var(--ink); border: 1px solid #7791a3; background: #0b2435; padding: 8px 12px; font-size: .875rem; border-radius: 0; min-height: 42px; }
  .actions { display: flex; justify-content: center; align-items: center; gap: 18px; }
  .begin { color: #142a3b; background: #f4c698; border: 1px solid #f4c698; padding: 14px 22px; min-width: 220px; min-height: 50px; font-size: 1rem; }
  .begin:hover { background: #ffdbb6; }
  .reset { color: var(--ink); background: transparent; border: 0; text-decoration: underline; padding: 14px 4px; font-size: .875rem; }
  .session-status { color: #d3e1e9; font-size: .875rem; min-height: 1.6em; line-height: 1.6; margin: 14px 0 6px; }
  .preferences { display: flex; justify-content: center; gap: 6px; }
  .preferences button { background: #0c2333aa; color: #d9e6ed; border: 1px solid #547083; padding: 10px 12px; min-height: 44px; font-size: .875rem; }
  .preferences button[aria-pressed="true"] { border-color: #f4c698; color: #f4c698; background: #102b3e; }
  .breath-note { max-width: 39ch; margin: 14px auto 0; font-size: .875rem; color: #b9ccd8; line-height: 1.65; }
  .fallback-note { line-height: 1.6; }
  .weather-line { display: flex; gap: 22px; align-items: center; border-top: 1px solid #7690a066; padding: 20px 0 25px; font-size: .875rem; }
  .weather-value { font-size: 1.9rem; letter-spacing: -.04em; white-space: nowrap; }
  .weather-value small { font-size: 1rem; letter-spacing: 0; margin-left: 6px; }
  .weather-line small { color: #bbceda; line-height: 1.7; }
  .weather-line a { margin-left: auto; text-decoration: underline !important; text-underline-offset: 4px; }
  .score { padding: 27px 5% 30px; border-top: 1px solid var(--rule); background: #0c2435; }
  .score-head { display: flex; justify-content: space-between; color: #abc2d0; }
  .score-head p { margin: 0 0 20px; }
  .movement { display: grid; grid-template-columns: .6fr 1.4fr; column-gap: 50px; }
  .movement h2 { grid-row: span 2; font-weight: 400; font-size: 2.4rem; letter-spacing: -.045em; margin: 0; }
  .movement p { margin: 0; font-size: 1.15rem; line-height: 1.75; max-width: 68ch; }
  .movement .small-invitation { font-size: .875rem; color: #bad0dc; margin-top: 12px; }
  .progress { margin: 30px 0 20px; background: #365367; height: 2px; }
  .progress span { display: block; height: 2px; background: #f4c698; width: 0; }
  .movements { display: flex; gap: 30px; list-style: none; padding: 0; margin: 0; justify-content: space-between; color: #95afbf; font-size: .875rem; }
  .movements li { display: flex; align-items: center; gap: 10px; }
  .movements li.current { color: #f4c698; }
  .reflection { margin: 0 5%; padding: 40px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--rule); }
  .reflection h2, .outside h2 { font-size: 1.85rem; font-weight: 400; letter-spacing: -.04em; margin: 0 0 14px; }
  .reflection p { color: #c4d6e1; line-height: 1.7; font-size: 1rem; margin-bottom: 0; }
  .reflection-options { align-self: center; }
  .reflection-options button { color: #e4eef4; background: transparent; border: 1px solid #527186; padding: 12px 15px; margin: 0 8px 10px 0; min-height: 48px; font-size: .875rem; }
  .reflection-options button[aria-pressed="true"] { color: #f4c698; border-color: #f4c698; background: #f4c69812; }
  .reflection-options p { font-size: .875rem; margin-top: 4px; }
  .full-score { margin: 0 5%; padding: 24px 0; border-bottom: 1px solid var(--rule); }
  .full-score summary { font-size: 1rem; padding: 8px 0; color: #d7e7f0; }
  .written-score { display: grid; grid-template-columns: 1fr 1fr; gap: 30px 50px; padding: 22px 0; }
  .written-score article p { line-height: 1.7; }
  .written-score .mono { color: var(--accent); }
  .small-invitation { color: #adc6d6; font-size: .875rem; }
  .outside { padding: 40px 5% 42px; }
  .outside-heading { display: flex; justify-content: space-between; gap: 36px; align-items: flex-start; margin-bottom: 20px; }
  .outside-heading > p { max-width: 30ch; margin: 0; color: #b8cedc; font-size: .875rem; line-height: 1.7; }
  .context-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
  .context { border-top: 1px solid #617f92; padding-top: 15px; }
  .context > .mono { font-size: .75rem; color: #f4c698; }
  .context h3 { font-size: 1.35rem; line-height: 1.35; font-weight: 400; letter-spacing: -.03em; margin: 20px 0 14px; }
  .context p { line-height: 1.7; font-size: .9375rem; color: #cbdae3; }
  .context .heat { border-left: 2px solid #f4c698; padding-left: 14px; color: #f2d6bb; }
  .context .creative-note { color: #aac2d1; }
  .source-links { display: flex; flex-wrap: wrap; gap: 8px 16px; padding-top: 8px; }
  .context a { font-size: .875rem; text-decoration: underline !important; text-underline-offset: 4px; line-height: 1.7; }
  .news-detail summary { font-size: .9375rem; line-height: 1.7; color: #e2ebf1; padding: 8px 0; }
  .news-detail .source-time { font-size: .875rem; color: #afc7d6; }
  .snapshot-note { color: #acc3d3; font-size: .875rem; line-height: 1.7; margin: 30px 0 0; max-width: 110ch; }
  .colophon { margin: 0 5%; padding: 24px 0 40px; border-top: 1px solid var(--rule); color: #a4bdce; font-size: .75rem; line-height: 1.7; }
