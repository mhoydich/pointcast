---
import AuthMenu from '../components/AuthMenu.astro';
import BlockLayout from '../layouts/BlockLayout.astro';
import nounPulse from '../assets/campaigns/pointcast-drum-noun-universe/115-rooms-one-shared-pulse.webp';
import { SUPER_AUTH_NEXT, SUPER_AUTH_PROVIDERS } from '../data/super-auth';
---

<BlockLayout
  title="Super Auth"
  description="PointCast Super Auth turns narrow, explicit connections into identity, sound, shop, and signed-object signals."
>
  <main class="super-auth" data-super-auth>
    <header class="super-auth__topbar">
      <a href="/" aria-label="PointCast home"><strong>PointCast</strong><span>/ Super Auth</span></a>
      <AuthMenu />
    </header>

    <section class="super-auth__hero" aria-label="PointCast account desk" aria-busy="true">
      <div class="super-auth__hero-copy">
        <div data-super-signed-out>
          <p class="super-auth__kicker">SIGNAL PASSPORT · AUTH 001</p>
          <h1>Connect the things that make the signal <em>yours.</em></h1>
          <p>
            Accounts should do something visible. Google names the broadcaster.
            Spotify carries the song. Shopify opens a read-only shop window.
            Tezos signs the object.
          </p>
          <div class="super-auth__hero-actions">
            <button type="button" data-super-open-account data-super-action="google">Start with Google</button>
            <button type="button" data-super-open-account data-super-action="open-account">Open wallet auth</button>
          </div>
        </div>

        <div data-super-signed-in hidden>
          <p class="super-auth__kicker">POINTCAST ACCOUNT · LIVE</p>
          <h1><span data-super-account-name>PointCast member</span>, this signal is <em>yours.</em></h1>
          <p class="super-auth__account-line">
            Signed in with <strong data-super-signed-in-with>PointCast</strong>.
            Your account and linked signals update here without another page load.
          </p>
          <div class="super-auth__identity-chips" data-super-identity-chips aria-label="Linked identities"></div>
          <div class="super-auth__hero-actions">
            <button type="button" data-super-action="kukai">Link a wallet (Kukai)</button>
            <button type="button" data-super-action="metamask">Link MetaMask</button>
            <a href="/api/spotify/auth?returnTo=/auth" data-super-hero-spotify>Authorize Spotify</a>
            <button type="button" class="super-auth__signout" data-super-action="logout">Sign out</button>
          </div>
        </div>
        <p class="super-auth__result" data-super-result aria-live="polite">
          Checking your PointCast account…
        </p>
      </div>

      <div class="super-auth__passport" aria-label="PointCast signal passport">
        <img
          src={nounPulse.src}
          width="896"
          height="1344"
          alt="Noun drummer routing one shared pulse through PointCast rooms"
          loading="eager"
        />
        <div class="super-auth__passport-card">
          <span>POINTCAST SIGNAL PASSPORT</span>
          <strong>NOUN-115</strong>
          <small>IDENTITY · SOUND · SHOP · OBJECT</small>
        </div>
      </div>
    </section>

    <section class="super-auth__circuit" aria-label="Four connected authorization signals">
      {SUPER_AUTH_PROVIDERS.map((provider, index) => (
        <>
          <button
            type="button"
            class="super-auth__circuit-node"
            data-super-node={provider.id}
            data-super-scroll-provider={provider.id}
            data-state={provider.state}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{provider.noun}</strong>
            <small>{provider.provider}</small>
          </button>
          {index < SUPER_AUTH_PROVIDERS.length - 1 && <i aria-hidden="true"></i>}
        </>
      ))}
    </section>

    <section class="super-auth__providers" aria-label="Four authorization providers">
      <header>
        <p class="super-auth__kicker">FOUR AUTH NOUNS</p>
        <h2>Every connection earns its square.</h2>
        <p>Each lane says what it reads, what it keeps private, and what becomes public.</p>
      </header>

      <div class="super-auth__provider-grid">
        <article data-super-provider="google">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">01</span>
            <span class="super-auth__provider-badge" data-super-provider-badge>LIVE</span>
          </div>
          <p class="super-auth__provider-code">GOOGLE / IDENTITY</p>
          <h3>Name the broadcaster.</h3>
          <p>One verified PointCast account. No Gmail, Drive, contacts, or calendar access.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>PointCast name</dd></div>
            <div><dt>PRIVATE</dt><dd>provider id · email · session</dd></div>
          </dl>
          <button type="button" data-super-open-account data-super-action="google" data-super-google-action>Sign in with Google →</button>
          <small class="super-auth__provider-status" data-super-google-state>Checking PointCast session…</small>
        </article>

        <article data-super-provider="spotify">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">02</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--spotify" data-super-provider-badge>ON AIR</span>
          </div>
          <p class="super-auth__provider-code">SPOTIFY / SOUND</p>
          <h3>Make listening visible.</h3>
          <p>The current track becomes the SPN broadcast—never playback history, devices, or position.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>track · artist · cover · state</dd></div>
            <div><dt>PRIVATE</dt><dd>encrypted OAuth credentials</dd></div>
          </dl>
          <a href="/api/spotify/auth?returnTo=/auth" data-super-spotify-action>Authorize Spotify →</a>
          <small class="super-auth__provider-status" data-super-spotify-state>Checking the live signal…</small>
        </article>

        <article data-super-provider="shopify">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">03</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--shopify" data-super-provider-badge>STAGED</span>
          </div>
          <p class="super-auth__provider-code">SHOPIFY / SHOP</p>
          <h3>Open a shop window.</h3>
          <p>Connect one storefront with <code>read_products</code> only. No orders, customers, checkout, or payments.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>catalog connected · selected products later</dd></div>
            <div><dt>PRIVATE</dt><dd>encrypted rotating OAuth credentials</dd></div>
          </dl>
          <form data-super-shopify-form>
            <label>
              <span>SHOP DOMAIN</span>
              <input name="shop" inputmode="url" autocomplete="url" placeholder="your-store.myshopify.com" />
            </label>
            <button type="submit" data-super-shopify-action disabled>Connect Shopify →</button>
          </form>
          <small class="super-auth__provider-status" data-super-shopify-state>Checking the catalog lane…</small>
        </article>

        <article data-super-provider="tezos">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">04</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--tezos" data-super-provider-badge>LIVE</span>
          </div>
          <p class="super-auth__provider-code">TEZOS / OBJECT</p>
          <h3>Sign the object.</h3>
          <p>Wallet identity, collection proofs, and explicit operations stay separate from social sign-in.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>address · collection · receipts</dd></div>
            <div><dt>PRIVATE</dt><dd>wallet session proof</dd></div>
          </dl>
          <button type="button" data-super-open-account data-super-action="open-account" data-super-tezos-action>Open wallet auth →</button>
          <small class="super-auth__provider-status" data-super-tezos-state>Wallet approval remains explicit.</small>
        </article>
      </div>
    </section>

    <section class="super-auth__next" aria-label="Next authorization providers">
      <header>
        <p class="super-auth__kicker">WHAT ELSE IS INTERESTING?</p>
        <h2>The next auth nouns.</h2>
      </header>
      <div>
        {SUPER_AUTH_NEXT.map((item, index) => (
          <article>
            <span>{String(index + 5).padStart(2, '0')}</span>
            <p>{item.provider} / {item.noun}</p>
            <strong>{item.signal}</strong>
            <small>CONCEPT · NOT CONNECTED</small>
          </article>
        ))}
      </div>
    </section>

    <footer class="super-auth__footer">
      <p>
        A good authorization is narrow, reversible, visible, and useful.
        <a href="/privacy">Read the privacy boundary</a>.
      </p>
      <nav aria-label="Super Auth machine-readable routes">
        <a href="/auth.json">/auth.json</a>
        <a href="/api/auth/session">/api/auth/session</a>
        <a href="/api/spotify/broadcast">/api/spotify/broadcast</a>
        <a href="/api/shopify/connection">/api/shopify/connection</a>
      </nav>
    </footer>
  </main>

  <script>
    import type { PointCastUser } from '../lib/auth/types';
    import { getSession, loginWithKukai, loginWithMetaMask, logout } from '../lib/auth/client';
    import { buildAccountDeskView } from '../lib/auth/account-desk.mjs';

    interface SpotifyPayload {
      configured?: boolean;
      connected?: boolean;
      nowPlaying?: {
        title?: string;
        artist?: string;
        live?: boolean;
      };
    }

    type AccountDeskWindow = Window & {
      __pointCastAccountDeskAbort?: AbortController;
      __pointCastAccountDeskPageLoadInstalled?: boolean;
    };

    let currentSpotify: SpotifyPayload | null = null;
    let currentShopify: ShopifyPayload | null = null;

    interface ShopifyPayload {
      configured?: boolean;
      connected?: boolean;
      connection?: {
        label?: string;
      };
    }

    async function fetchJson<T>(path: string): Promise<T | null> {
      try {
        const response = await fetch(path, { credentials: 'include', cache: 'no-store' });
        if (!response.ok) return null;
        return await response.json() as T;
      } catch {
        return null;
      }
    }

    function setText(root: HTMLElement, selector: string, value: string): void {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }

    function renderProvider(
      root: HTMLElement,
      provider: 'google' | 'spotify' | 'shopify' | 'tezos',
      state: { state: string; badge: string; status: string },
    ): void {
      const card = root.querySelector<HTMLElement>(`[data-super-provider="${provider}"]`);
      const node = root.querySelector<HTMLElement>(`[data-super-node="${provider}"]`);
      if (card) card.dataset.state = state.state;
      if (node) node.dataset.state = state.state;
      setText(root, `[data-super-provider="${provider}"] [data-super-provider-badge]`, state.badge);
      setText(root, `[data-super-${provider}-state]`, state.status);
    }

    function renderAccountDesk(root: HTMLElement, user: PointCastUser | null): void {
      const view = buildAccountDeskView(user, {
        spotify: currentSpotify,
        shopify: currentShopify,
      });
      const hero = root.querySelector<HTMLElement>('.super-auth__hero');
      const signedOut = root.querySelector<HTMLElement>('[data-super-signed-out]');
      const signedIn = root.querySelector<HTMLElement>('[data-super-signed-in]');
      if (hero) hero.setAttribute('aria-busy', 'false');
      if (signedOut) signedOut.hidden = view.signedIn;
      if (signedIn) signedIn.hidden = !view.signedIn;
      setText(root, '[data-super-account-name]', view.preferredName);
      setText(root, '[data-super-signed-in-with]', view.signedInWith);
      setText(root, '[data-super-result]', view.result);

      const chips = root.querySelector<HTMLElement>('[data-super-identity-chips]');
      if (chips) {
        chips.replaceChildren();
        view.identityChips.forEach((provider) => {
          const chip = document.createElement('span');
          chip.textContent = provider;
          chips.append(chip);
        });
      }

      renderProvider(root, 'google', view.providers.google);
      renderProvider(root, 'spotify', view.providers.spotify);
      renderProvider(root, 'shopify', view.providers.shopify);
      renderProvider(root, 'tezos', view.providers.tezos);

      const googleAction = root.querySelector<HTMLButtonElement>('[data-super-google-action]');
      if (googleAction) {
        googleAction.textContent = view.providers.google.action;
        googleAction.dataset.superAction = view.providers.google.connected ? 'open-account' : 'google';
      }
      root.querySelectorAll<HTMLAnchorElement>('[data-super-spotify-action]').forEach((action) => {
        action.href = view.providers.spotify.href;
        action.textContent = view.providers.spotify.action;
      });
      const heroSpotify = root.querySelector<HTMLAnchorElement>('[data-super-hero-spotify]');
      if (heroSpotify) heroSpotify.hidden = !view.broadcaster;
      const tezosAction = root.querySelector<HTMLButtonElement>('[data-super-tezos-action]');
      if (tezosAction) {
        tezosAction.textContent = view.providers.tezos.action;
        tezosAction.dataset.superAction = view.signedIn ? 'kukai' : 'open-account';
      }
      const shopifyAction = root.querySelector<HTMLButtonElement>('[data-super-shopify-action]');
      if (shopifyAction) shopifyAction.disabled = !view.providers.shopify.enabled;
    }

    function renderAllAccountDesks(user: PointCastUser | null): void {
      document.querySelectorAll<HTMLElement>('[data-super-auth]').forEach((root) => {
        renderAccountDesk(root, user);
      });
    }

    async function refreshAccountDesk(): Promise<void> {
      try {
        const [user, spotify, shopify] = await Promise.all([
          getSession(),
          fetchJson<SpotifyPayload>('/api/spotify/broadcast'),
          fetchJson<ShopifyPayload>('/api/shopify/connection'),
        ]);
        currentSpotify = spotify;
        currentShopify = shopify;
        renderAllAccountDesks(user);
      } catch {
        renderAllAccountDesks(null);
        document.querySelectorAll<HTMLElement>('[data-super-result]').forEach((result) => {
          result.textContent = 'The live account service is unavailable. You can still look around.';
        });
      }
    }

    function showActionStatus(root: HTMLElement, message: string): void {
      setText(root, '[data-super-result]', message);
    }

    async function performAccountAction(root: HTMLElement, action: string): Promise<void> {
      if (action === 'kukai') {
        showActionStatus(root, 'Opening Kukai for one wallet-control signature…');
        const user = await loginWithKukai({ force: true });
        if (user) {
          window.dispatchEvent(new CustomEvent('pc:auth-change', {
            detail: { user, source: 'account-desk' },
          }));
        }
        return;
      }
      if (action === 'metamask') {
        showActionStatus(root, 'Opening MetaMask for one wallet-control signature…');
        const user = await loginWithMetaMask();
        if (user) {
          window.dispatchEvent(new CustomEvent('pc:auth-change', {
            detail: { user, source: 'account-desk' },
          }));
        }
        return;
      }
      if (action === 'logout') {
        showActionStatus(root, 'Signing out…');
        await logout();
      }
    }

    function scrollToProvider(provider: string): void {
      const card = document.querySelector<HTMLElement>(`[data-super-provider="${provider}"]`);
      card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function initializeAccountDesk(): void {
      const authWindow = window as AccountDeskWindow;
      authWindow.__pointCastAccountDeskAbort?.abort();
      const listeners = new AbortController();
      authWindow.__pointCastAccountDeskAbort = listeners;
      const roots = document.querySelectorAll<HTMLElement>('[data-super-auth]');
      if (!roots.length) return;

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const actionButton = target?.closest<HTMLElement>('[data-super-action]');
        const scrollButton = target?.closest<HTMLElement>('[data-super-scroll-provider]');
        const root = (actionButton || scrollButton)?.closest<HTMLElement>('[data-super-auth]');
        if (!root) return;

        event.preventDefault();
        // This delegated capture listener preserves PR #1006: account buttons
        // outside AuthMenu must not bubble into its outside-click closer.
        event.stopPropagation();
        if (scrollButton) {
          scrollToProvider(scrollButton.dataset.superScrollProvider || '');
          return;
        }

        const action = actionButton?.dataset.superAction || '';
        if (action === 'google') {
          window.location.assign('/api/auth/google?returnTo=/auth');
          return;
        }
        if (action === 'open-account') {
          window.dispatchEvent(new CustomEvent('pc:open-auth-menu'));
          return;
        }
        void performAccountAction(root, action).catch((error) => {
          showActionStatus(root, error instanceof Error ? error.message : 'Account action stopped.');
        });
      }, { capture: true, signal: listeners.signal });

      document.addEventListener('submit', (event) => {
        const form = event.target instanceof HTMLFormElement
          ? event.target.closest<HTMLFormElement>('[data-super-shopify-form]')
          : null;
        const root = form?.closest<HTMLElement>('[data-super-auth]');
        if (!form || !root) return;
        event.preventDefault();
        const action = form.querySelector<HTMLButtonElement>('[data-super-shopify-action]');
        if (!action || action.disabled) return;
        const input = form.elements.namedItem('shop');
        const shop = input instanceof HTMLInputElement ? input.value.trim() : '';
        if (!shop) {
          setText(root, '[data-super-shopify-state]', 'Enter a store name or myshopify.com domain.');
          return;
        }
        const destination = new URL('/api/shopify/auth', window.location.origin);
        destination.searchParams.set('shop', shop);
        destination.searchParams.set('returnTo', '/auth#shopify');
        window.location.assign(destination.toString());
      }, { signal: listeners.signal });

      window.addEventListener('pc:auth-change', () => {
        void refreshAccountDesk();
      }, { signal: listeners.signal });

      void refreshAccountDesk().then(() => {
        const provider = window.location.hash.replace(/^#/, '');
        if (['google', 'spotify', 'shopify', 'tezos'].includes(provider)) scrollToProvider(provider);
      });
    }

    const authWindow = window as AccountDeskWindow;
    if (!authWindow.__pointCastAccountDeskPageLoadInstalled) {
      authWindow.__pointCastAccountDeskPageLoadInstalled = true;
      document.addEventListener('astro:page-load', initializeAccountDesk);
    }
    initializeAccountDesk();
  </script>
</BlockLayout>

<style is:global>
  body { background: #f7f5ea; }
  .super-auth {
    --auth-ink: #151515;
    --auth-blue: #3453df;
    --auth-acid: #eaff57;
    --auth-pink: #f05ea8;
    width: min(1440px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 80px;
    color: var(--auth-ink);
    font-family: var(--pc-font-sans, Inter, system-ui, sans-serif);
  }
  .super-auth__topbar {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-block: 1px solid var(--auth-ink);
  }
  .super-auth__topbar > a { display: flex; align-items: baseline; gap: 10px; color: inherit; text-decoration: none; }
  .super-auth__topbar strong { font-size: 20px; letter-spacing: 0.14em; }
  .super-auth__topbar > a span { font: 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .super-auth__kicker,
  .super-auth__result,
  .super-auth__provider-code,
  .super-auth__provider-number,
  .super-auth__provider-badge,
  .super-auth__provider-status,
  .super-auth__providers dt,
  .super-auth__providers dd,
  .super-auth__next p,
  .super-auth__next small,
  .super-auth__footer {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
  }
  .super-auth__kicker { margin: 0; color: var(--auth-blue); font-size: 9px; font-weight: 800; letter-spacing: 0.13em; }
  .super-auth__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    border-bottom: 1px solid var(--auth-ink);
  }
  .super-auth__hero-copy { min-height: 590px; display: flex; flex-direction: column; justify-content: center; padding: clamp(30px, 5vw, 80px); border-right: 1px solid var(--auth-ink); }
  .super-auth__hero-copy > [data-super-signed-out],
  .super-auth__hero-copy > [data-super-signed-in] { width: 100%; }
  .super-auth__hero h1 { max-width: 760px; margin: 20px 0 24px; font-size: clamp(48px, 6.5vw, 104px); line-height: 0.83; letter-spacing: -0.065em; text-transform: uppercase; }
  .super-auth__hero h1 em { color: var(--auth-blue); font-style: normal; }
  .super-auth__hero-copy > [data-super-signed-out] > p:not(.super-auth__kicker),
  .super-auth__account-line { max-width: 650px; margin: 0; font-size: 18px; line-height: 1.45; }
  .super-auth__identity-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .super-auth__identity-chips span {
    padding: 7px 9px;
    border: 1px solid var(--auth-ink);
    background: #fffdf4;
    box-shadow: 3px 3px 0 var(--auth-acid);
    font: 800 8px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
  }
  .super-auth__hero-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .super-auth__hero-actions button,
  .super-auth__hero-actions a {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    padding: 0 20px;
    border: 1px solid var(--auth-ink);
    background: var(--auth-ink);
    color: #fff;
    font: 800 9px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .super-auth__hero-actions a { background: var(--auth-acid); color: var(--auth-ink); }
  .super-auth__hero-actions .super-auth__signout { background: transparent; color: var(--auth-ink); }
  .super-auth__result { min-height: 16px; margin: 16px 0 0; color: #5e625a; font-size: 8px; line-height: 1.5; }
  .super-auth__passport { position: relative; min-height: 590px; overflow: hidden; background: #f5d655; }
  .super-auth__passport img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: center 43%; filter: saturate(0.9) contrast(1.02); }
  .super-auth__passport-card { position: absolute; right: 22px; bottom: 22px; left: 22px; display: grid; gap: 8px; padding: 18px; border: 1px solid var(--auth-ink); background: var(--auth-acid); box-shadow: 8px 8px 0 var(--auth-blue); }
  .super-auth__passport-card span,
  .super-auth__passport-card small { font: 8px/1.2 var(--pc-font-mono, ui-monospace, monospace); letter-spacing: 0.12em; }
  .super-auth__passport-card strong { font: 800 34px/1 var(--pc-font-mono, ui-monospace, monospace); }

  .super-auth__circuit { min-height: 150px; display: flex; align-items: center; padding: 24px; border-bottom: 1px solid var(--auth-ink); background: #fffdf4; }
  .super-auth__circuit-node { width: 126px; height: 92px; display: grid; align-content: center; gap: 5px; padding: 14px; border: 1px solid var(--auth-ink); background: #fff; color: inherit; font: inherit; text-align: left; text-decoration: none; box-shadow: 6px 6px 0 #c9c7bd; cursor: pointer; }
  .super-auth__circuit-node[data-state='live'],
  .super-auth__circuit-node[data-state='connected'] { box-shadow: 6px 6px 0 var(--auth-acid); }
  .super-auth__circuit-node[data-state='credential-gated'] { box-shadow: 6px 6px 0 var(--auth-pink); }
  .super-auth__circuit-node span,
  .super-auth__circuit-node small { font: 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .super-auth__circuit-node strong { font-size: 21px; text-transform: uppercase; }
  .super-auth__circuit > i { height: 1px; flex: 1; min-width: 22px; margin-inline: 12px; background: var(--auth-ink); }

