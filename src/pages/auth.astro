---
import AuthMenu from '../components/AuthMenu.astro';
import BlockLayout from '../layouts/BlockLayout.astro';
import nounPulse from '../assets/campaigns/pointcast-drum-noun-universe/115-rooms-one-shared-pulse.webp';
import { SUPER_AUTH_NEXT, SUPER_AUTH_PROVIDERS } from '../data/super-auth';
---

<BlockLayout
  title="Super Auth"
  description="PointCast Super Auth turns narrow, explicit connections into identity, sound, shop, and signed-object signals."
>
  <main class="super-auth" data-super-auth>
    <header class="super-auth__topbar">
      <a href="/" aria-label="PointCast home"><strong>PointCast</strong><span>/ Super Auth</span></a>
      <AuthMenu />
    </header>

    <section class="super-auth__hero" aria-labelledby="super-auth-title">
      <div class="super-auth__hero-copy">
        <p class="super-auth__kicker">SIGNAL PASSPORT · AUTH 001</p>
        <h1 id="super-auth-title">Connect the things that make the signal <em>yours.</em></h1>
        <p>
          Accounts should do something visible. Google names the broadcaster.
          Spotify carries the song. Shopify opens a read-only shop window.
          Tezos signs the object.
        </p>
        <div class="super-auth__hero-actions">
          <button type="button" data-super-open-account>Start with Google</button>
          <a href="/api/spotify/auth?returnTo=/auth" data-super-spotify-action>Authorize Spotify</a>
        </div>
        <p class="super-auth__result" data-super-result aria-live="polite">
          No account is required to look around.
        </p>
      </div>

      <div class="super-auth__passport" aria-label="PointCast signal passport">
        <img
          src={nounPulse.src}
          width="896"
          height="1344"
          alt="Noun drummer routing one shared pulse through PointCast rooms"
          loading="eager"
        />
        <div class="super-auth__passport-card">
          <span>POINTCAST SIGNAL PASSPORT</span>
          <strong>NOUN-115</strong>
          <small>IDENTITY · SOUND · SHOP · OBJECT</small>
        </div>
      </div>
    </section>

    <section class="super-auth__circuit" aria-label="Four connected authorization signals">
      {SUPER_AUTH_PROVIDERS.map((provider, index) => (
        <>
          <a
            href={`#${provider.id}`}
            class="super-auth__circuit-node"
            data-super-node={provider.id}
            data-state={provider.state}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{provider.noun}</strong>
            <small>{provider.provider}</small>
          </a>
          {index < SUPER_AUTH_PROVIDERS.length - 1 && <i aria-hidden="true"></i>}
        </>
      ))}
    </section>

    <section class="super-auth__providers" aria-labelledby="providers-title">
      <header>
        <p class="super-auth__kicker">FOUR AUTH NOUNS</p>
        <h2 id="providers-title">Every connection earns its square.</h2>
        <p>Each lane says what it reads, what it keeps private, and what becomes public.</p>
      </header>

      <div class="super-auth__provider-grid">
        <article id="google" data-super-provider="google">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">01</span>
            <span class="super-auth__provider-badge">LIVE</span>
          </div>
          <p class="super-auth__provider-code">GOOGLE / IDENTITY</p>
          <h3>Name the broadcaster.</h3>
          <p>One verified PointCast account. No Gmail, Drive, contacts, or calendar access.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>PointCast name</dd></div>
            <div><dt>PRIVATE</dt><dd>provider id · email · session</dd></div>
          </dl>
          <button type="button" data-super-open-account data-super-google-action>Sign in with Google →</button>
          <small class="super-auth__provider-status" data-super-google-state>Checking PointCast session…</small>
        </article>

        <article id="spotify" data-super-provider="spotify">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">02</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--spotify">ON AIR</span>
          </div>
          <p class="super-auth__provider-code">SPOTIFY / SOUND</p>
          <h3>Make listening visible.</h3>
          <p>The current track becomes the SPN broadcast—never playback history, devices, or position.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>track · artist · cover · state</dd></div>
            <div><dt>PRIVATE</dt><dd>encrypted OAuth credentials</dd></div>
          </dl>
          <a href="/api/spotify/auth?returnTo=/auth" data-super-spotify-action>Authorize Spotify →</a>
          <small class="super-auth__provider-status" data-super-spotify-state>Checking the live signal…</small>
        </article>

        <article id="shopify" data-super-provider="shopify">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">03</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--shopify">STAGED</span>
          </div>
          <p class="super-auth__provider-code">SHOPIFY / SHOP</p>
          <h3>Open a shop window.</h3>
          <p>Connect one storefront with <code>read_products</code> only. No orders, customers, checkout, or payments.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>catalog connected · selected products later</dd></div>
            <div><dt>PRIVATE</dt><dd>encrypted rotating OAuth credentials</dd></div>
          </dl>
          <form data-super-shopify-form>
            <label>
              <span>SHOP DOMAIN</span>
              <input name="shop" inputmode="url" autocomplete="url" placeholder="your-store.myshopify.com" />
            </label>
            <button type="submit" data-super-shopify-action disabled>Connect Shopify →</button>
          </form>
          <small class="super-auth__provider-status" data-super-shopify-state>Checking the catalog lane…</small>
        </article>

        <article id="tezos" data-super-provider="tezos">
          <div class="super-auth__provider-top">
            <span class="super-auth__provider-number">04</span>
            <span class="super-auth__provider-badge super-auth__provider-badge--tezos">LIVE</span>
          </div>
          <p class="super-auth__provider-code">TEZOS / OBJECT</p>
          <h3>Sign the object.</h3>
          <p>Wallet identity, collection proofs, and explicit operations stay separate from social sign-in.</p>
          <dl>
            <div><dt>PUBLIC</dt><dd>address · collection · receipts</dd></div>
            <div><dt>PRIVATE</dt><dd>wallet session proof</dd></div>
          </dl>
          <button type="button" data-super-open-account>Open wallet auth →</button>
          <small class="super-auth__provider-status">Wallet approval remains explicit.</small>
        </article>
      </div>
    </section>

    <section class="super-auth__next" aria-labelledby="next-title">
      <header>
        <p class="super-auth__kicker">WHAT ELSE IS INTERESTING?</p>
        <h2 id="next-title">The next auth nouns.</h2>
      </header>
      <div>
        {SUPER_AUTH_NEXT.map((item, index) => (
          <article>
            <span>{String(index + 5).padStart(2, '0')}</span>
            <p>{item.provider} / {item.noun}</p>
            <strong>{item.signal}</strong>
            <small>CONCEPT · NOT CONNECTED</small>
          </article>
        ))}
      </div>
    </section>

    <footer class="super-auth__footer">
      <p>
        A good authorization is narrow, reversible, visible, and useful.
        <a href="/privacy">Read the privacy boundary</a>.
      </p>
      <nav aria-label="Super Auth machine-readable routes">
        <a href="/auth.json">/auth.json</a>
        <a href="/api/auth/session">/api/auth/session</a>
        <a href="/api/spotify/broadcast">/api/spotify/broadcast</a>
        <a href="/api/shopify/connection">/api/shopify/connection</a>
      </nav>
    </footer>
  </main>

  <script>
    interface SessionPayload {
      user?: {
        preferredName?: string;
        roles?: string[];
      };
    }

    interface SpotifyPayload {
      configured?: boolean;
      connected?: boolean;
      nowPlaying?: {
        title?: string;
        artist?: string;
        live?: boolean;
      };
    }

    interface ShopifyPayload {
      configured?: boolean;
      connected?: boolean;
      connection?: {
        label?: string;
      };
    }

    async function fetchJson<T>(path: string): Promise<T | null> {
      try {
        const response = await fetch(path, { credentials: 'include', cache: 'no-store' });
        if (!response.ok) return null;
        return await response.json() as T;
      } catch {
        return null;
      }
    }

    function initSuperAuth() {
      const root = document.querySelector<HTMLElement>('[data-super-auth]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      root.querySelectorAll<HTMLButtonElement>('[data-super-open-account]').forEach((button) => {
        button.addEventListener('click', (event) => {
          // AuthMenu closes on any document click outside its root; this
          // button lives outside that root, so without stopping propagation
          // the menu opened and closed on the same click (2026-09-02).
          event.stopPropagation();
          if (/google/i.test(button.textContent ?? '')) {
            window.location.assign('/api/auth/google?returnTo=/auth');
            return;
          }
          window.dispatchEvent(new CustomEvent('pc:open-auth-menu'));
        });
      });

      const result = root.querySelector<HTMLElement>('[data-super-result]');
      const query = new URLSearchParams(window.location.search);
      if (query.get('spotify') === 'connected') result && (result.textContent = 'Spotify authorized. The SPN signal is listening.');
      if (query.get('shopify') === 'connected') result && (result.textContent = 'Shopify connected. The catalog lane is ready.');
      if (query.get('auth') === 'google') result && (result.textContent = 'Google verified. The broadcaster lane is open.');
      if (query.get('auth_error')) result && (result.textContent = `Authorization stopped: ${query.get('auth_error')?.replaceAll('-', ' ')}.`);

      void Promise.all([
        fetchJson<SessionPayload>('/api/auth/session'),
        fetchJson<SpotifyPayload>('/api/spotify/broadcast'),
        fetchJson<ShopifyPayload>('/api/shopify/connection'),
      ]).then(([session, spotify, shopify]) => {
        const user = session?.user;
        const broadcaster = Array.isArray(user?.roles) && user.roles.includes('broadcaster');

        const googleState = root.querySelector<HTMLElement>('[data-super-google-state]');
        const googleAction = root.querySelector<HTMLButtonElement>('[data-super-google-action]');
        const googleNode = root.querySelector<HTMLElement>('[data-super-node="google"]');
        if (user) {
          googleState && (googleState.textContent = `Connected · ${user.preferredName || 'PointCast member'}`);
          googleAction && (googleAction.textContent = 'Manage PointCast account →');
          googleNode && (googleNode.dataset.state = 'connected');
        } else {
          googleState && (googleState.textContent = 'Ready for Google verification.');
        }

        const spotifyState = root.querySelector<HTMLElement>('[data-super-spotify-state]');
        const spotifyNode = root.querySelector<HTMLElement>('[data-super-node="spotify"]');
        const spotifyActions = root.querySelectorAll<HTMLAnchorElement>('[data-super-spotify-action]');
        if (spotify?.connected) {
          const title = spotify.nowPlaying?.title || 'Spotify signal';
          const artist = spotify.nowPlaying?.artist ? ` · ${spotify.nowPlaying.artist}` : '';
          spotifyState && (spotifyState.textContent = `${spotify.nowPlaying?.live ? 'Live' : 'Ready'} · ${title}${artist}`);
          spotifyNode && (spotifyNode.dataset.state = 'connected');
          spotifyActions.forEach((action) => {
            action.href = broadcaster ? '/api/spotify/auth?returnTo=/auth' : '/now-playing.json';
            action.textContent = broadcaster ? 'Reauthorize Spotify →' : 'Read the Spotify signal →';
          });
        } else if (!user) {
          spotifyState && (spotifyState.textContent = 'Sign in with Google, then authorize Spotify.');
          spotifyActions.forEach((action) => {
            action.href = '/api/auth/google?returnTo=/auth';
            action.textContent = 'Sign in, then Spotify →';
          });
        } else if (broadcaster) {
          spotifyState && (spotifyState.textContent = spotify?.configured
            ? 'Broadcaster verified · Spotify is ready.'
            : 'Spotify provider setup required.');
        } else {
          spotifyState && (spotifyState.textContent = 'The public signal has one authorized broadcaster.');
          spotifyActions.forEach((action) => {
            action.href = '/now-playing.json';
            action.textContent = 'Read the Spotify signal →';
          });
        }

        const shopifyCard = root.querySelector<HTMLElement>('[data-super-provider="shopify"]');
        const shopifyNode = root.querySelector<HTMLElement>('[data-super-node="shopify"]');
        const shopifyState = root.querySelector<HTMLElement>('[data-super-shopify-state]');
        const shopifyAction = root.querySelector<HTMLButtonElement>('[data-super-shopify-action]');
        const shopifyForm = root.querySelector<HTMLFormElement>('[data-super-shopify-form]');
        if (shopify?.connected) {
          const label = shopify.connection?.label || 'Connected storefront';
          shopifyState && (shopifyState.textContent = `${label} · read-only catalog authorized`);
          shopifyCard && (shopifyCard.dataset.state = 'connected');
          shopifyNode && (shopifyNode.dataset.state = 'connected');
        } else if (!shopify?.configured) {
          shopifyState && (shopifyState.textContent = 'OAuth lane built · Shopify app credentials still required.');
        } else if (!broadcaster) {
          shopifyState && (shopifyState.textContent = user
            ? 'Broadcaster authorization required.'
            : 'Sign in with Google to open the broadcaster lane.');
        } else {
          shopifyState && (shopifyState.textContent = 'Ready for a myshopify.com storefront.');
          if (shopifyAction) shopifyAction.disabled = false;
        }

        shopifyForm?.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!shopify?.configured || !broadcaster) return;
          const input = shopifyForm.elements.namedItem('shop');
          const shop = input instanceof HTMLInputElement ? input.value.trim() : '';
          if (!shop) {
            shopifyState && (shopifyState.textContent = 'Enter a store name or myshopify.com domain.');
            return;
          }
          const destination = new URL('/api/shopify/auth', window.location.origin);
          destination.searchParams.set('shop', shop);
          destination.searchParams.set('returnTo', '/auth#shopify');
          window.location.assign(destination.toString());
        });
      });
    }

    initSuperAuth();
    document.addEventListener('astro:page-load', initSuperAuth);
  </script>
</BlockLayout>

<style is:global>
  body { background: #f7f5ea; }
  .super-auth {
    --auth-ink: #151515;
    --auth-blue: #3453df;
    --auth-acid: #eaff57;
    --auth-pink: #f05ea8;
    width: min(1440px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 80px;
    color: var(--auth-ink);
    font-family: var(--pc-font-sans, Inter, system-ui, sans-serif);
  }
  .super-auth__topbar {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-block: 1px solid var(--auth-ink);
  }
  .super-auth__topbar > a { display: flex; align-items: baseline; gap: 10px; color: inherit; text-decoration: none; }
  .super-auth__topbar strong { font-size: 20px; letter-spacing: 0.14em; }
  .super-auth__topbar > a span { font: 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .super-auth__kicker,
  .super-auth__result,
  .super-auth__provider-code,
  .super-auth__provider-number,
  .super-auth__provider-badge,
  .super-auth__provider-status,
  .super-auth__providers dt,
  .super-auth__providers dd,
  .super-auth__next p,
  .super-auth__next small,
  .super-auth__footer {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
  }
  .super-auth__kicker { margin: 0; color: var(--auth-blue); font-size: 9px; font-weight: 800; letter-spacing: 0.13em; }
  .super-auth__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    border-bottom: 1px solid var(--auth-ink);
  }
  .super-auth__hero-copy { min-height: 590px; display: flex; flex-direction: column; justify-content: center; padding: clamp(30px, 5vw, 80px); border-right: 1px solid var(--auth-ink); }
  .super-auth__hero h1 { max-width: 760px; margin: 20px 0 24px; font-size: clamp(48px, 6.5vw, 104px); line-height: 0.83; letter-spacing: -0.065em; text-transform: uppercase; }
  .super-auth__hero h1 em { color: var(--auth-blue); font-style: normal; }
  .super-auth__hero-copy > p:not(.super-auth__kicker):not(.super-auth__result) { max-width: 650px; margin: 0; font-size: 18px; line-height: 1.45; }
  .super-auth__hero-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .super-auth__hero-actions button,
  .super-auth__hero-actions a {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    padding: 0 20px;
    border: 1px solid var(--auth-ink);
    background: var(--auth-ink);
    color: #fff;
    font: 800 9px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .super-auth__hero-actions a { background: var(--auth-acid); color: var(--auth-ink); }
  .super-auth__result { min-height: 16px; margin: 16px 0 0; color: #5e625a; font-size: 8px; line-height: 1.5; }
  .super-auth__passport { position: relative; min-height: 590px; overflow: hidden; background: #f5d655; }
  .super-auth__passport img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: center 43%; filter: saturate(0.9) contrast(1.02); }
  .super-auth__passport-card { position: absolute; right: 22px; bottom: 22px; left: 22px; display: grid; gap: 8px; padding: 18px; border: 1px solid var(--auth-ink); background: var(--auth-acid); box-shadow: 8px 8px 0 var(--auth-blue); }
  .super-auth__passport-card span,
  .super-auth__passport-card small { font: 8px/1.2 var(--pc-font-mono, ui-monospace, monospace); letter-spacing: 0.12em; }
  .super-auth__passport-card strong { font: 800 34px/1 var(--pc-font-mono, ui-monospace, monospace); }

  .super-auth__circuit { min-height: 150px; display: flex; align-items: center; padding: 24px; border-bottom: 1px solid var(--auth-ink); background: #fffdf4; }
  .super-auth__circuit-node { width: 126px; height: 92px; display: grid; align-content: center; gap: 5px; padding: 14px; border: 1px solid var(--auth-ink); background: #fff; color: inherit; text-decoration: none; box-shadow: 6px 6px 0 #c9c7bd; }
  .super-auth__circuit-node[data-state='live'],
  .super-auth__circuit-node[data-state='connected'] { box-shadow: 6px 6px 0 var(--auth-acid); }
  .super-auth__circuit-node[data-state='credential-gated'] { box-shadow: 6px 6px 0 var(--auth-pink); }
  .super-auth__circuit-node span,
  .super-auth__circuit-node small { font: 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .super-auth__circuit-node strong { font-size: 21px; text-transform: uppercase; }
  .super-auth__circuit > i { height: 1px; flex: 1; min-width: 22px; margin-inline: 12px; background: var(--auth-ink); }

  .super-auth__providers { padding: 66px 0; border-bottom: 1px solid var(--auth-ink); }
  .super-auth__providers > header { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px 60px; margin-bottom: 28px; }
  .super-auth__providers > header .super-auth__kicker { grid-column: 1 / -1; }
  .super-auth__providers > header h2,
  .super-auth__next h2 { margin: 0; font-size: clamp(36px, 5vw, 72px); line-height: 0.9; letter-spacing: -0.05em; text-transform: uppercase; }
  .super-auth__providers > header > p:last-child { max-width: 580px; margin: 0; align-self: end; color: #5f625b; font-size: 14px; line-height: 1.5; }
  .super-auth__provider-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--auth-ink); }
  .super-auth__provider-grid > article { min-width: 0; min-height: 480px; display: flex; flex-direction: column; padding: clamp(24px, 4vw, 54px); background: #fffdf4; }
  .super-auth__provider-grid > article:nth-child(odd) { border-right: 1px solid var(--auth-ink); }
  .super-auth__provider-grid > article:nth-child(-n + 2) { border-bottom: 1px solid var(--auth-ink); }
  .super-auth__provider-grid > article[data-state='connected'] { background: linear-gradient(150deg, #fffdf4 65%, rgba(234,255,87,0.55)); }
  .super-auth__provider-top { display: flex; justify-content: space-between; align-items: center; }
  .super-auth__provider-number { font-size: 11px; }
  .super-auth__provider-badge { padding: 6px 8px; border: 1px solid var(--auth-ink); background: #4285f4; color: #fff; font-size: 7px; letter-spacing: 0.1em; }
  .super-auth__provider-badge--spotify { background: #1ed760; color: #07180c; }
  .super-auth__provider-badge--shopify { background: #95bf47; color: #102006; }
  .super-auth__provider-badge--tezos { background: #ffd43b; color: #151515; }
  .super-auth__provider-code { margin: 48px 0 10px; color: var(--auth-blue); font-size: 9px; font-weight: 800; letter-spacing: 0.12em; }
  .super-auth__provider-grid h3 { max-width: 520px; margin: 0; font-size: clamp(34px, 4vw, 62px); line-height: 0.9; letter-spacing: -0.045em; text-transform: uppercase; }
  .super-auth__provider-grid h3 + p { max-width: 560px; margin: 22px 0; color: #4f524c; font-size: 14px; line-height: 1.5; }
  .super-auth__provider-grid dl { display: grid; grid-template-columns: 1fr 1fr; margin: auto 0 24px; border-block: 1px solid #b9b9b1; }
  .super-auth__provider-grid dl > div { display: grid; align-content: center; gap: 6px; min-height: 68px; padding: 10px 0; }
  .super-auth__provider-grid dl > div + div { padding-left: 16px; border-left: 1px solid #b9b9b1; }
  .super-auth__provider-grid dt { color: #7a7d75; font-size: 7px; }
  .super-auth__provider-grid dd { margin: 0; font-size: 7px; line-height: 1.45; }
  .super-auth__provider-grid article > a,
  .super-auth__provider-grid article > button,
  .super-auth__provider-grid form button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 0 16px;
    border: 1px solid var(--auth-ink);
    background: var(--auth-ink);
    color: #fff;
    font: 800 8px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .super-auth__provider-grid button:disabled { cursor: not-allowed; opacity: 0.42; }
  .super-auth__provider-status { min-height: 13px; margin-top: 12px; color: #676b63; font-size: 7px; line-height: 1.45; }
  .super-auth__provider-grid form { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 8px; }
  .super-auth__provider-grid form label { display: grid; gap: 5px; }
  .super-auth__provider-grid form label span { font: 7px/1 var(--pc-font-mono, ui-monospace, monospace); }
  .super-auth__provider-grid input { min-height: 46px; width: 100%; padding: 10px 12px; border: 1px solid var(--auth-ink); border-radius: 0; background: #fff; color: inherit; font: 11px/1 var(--pc-font-mono, ui-monospace, monospace); }
  .super-auth__provider-grid input:focus { outline: 3px solid var(--auth-acid); outline-offset: 1px; }

  .super-auth__next { padding: 66px 0; }
