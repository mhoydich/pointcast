---
import AuthMenu from '../components/AuthMenu.astro';
import BlockLayout from '../layouts/BlockLayout.astro';
import { ACCOUNT_PROVIDERS } from '../data/super-auth';
---

<BlockLayout
  title="Account"
  description="Sign in to PointCast, review linked identities, link a wallet, or sign out."
>
  <main class="account-desk" data-account-desk>
    <header class="account-desk__topbar">
      <a href="/" aria-label="PointCast home"><strong>PointCast</strong><span>/ Account</span></a>
      <AuthMenu />
    </header>

    <section class="account-desk__hero" aria-label="PointCast account" aria-busy="true">
      <div data-account-signed-out>
        <p class="account-desk__kicker">POINTCAST ACCOUNT</p>
        <h1>Sign in to <em>PointCast.</em></h1>
        <p>
          Use Google or a wallet. You can look around without an account and choose
          exactly what to link.
        </p>
        <div class="account-desk__actions">
          <button type="button" data-account-action="google">Sign in with Google</button>
          <button type="button" data-account-action="kukai">Sign in with Kukai</button>
        </div>
      </div>

      <div data-account-signed-in hidden>
        <p class="account-desk__kicker">SIGNED IN</p>
        <h1><span data-account-name>PointCast member</span>&rsquo;s <em>account.</em></h1>
        <p>
          Signed in with <strong data-account-signed-in-with>PointCast</strong>.
          Your linked identities are listed by provider name only.
        </p>
        <div class="account-desk__chips" data-account-identity-chips aria-label="Linked identities"></div>
        <div class="account-desk__actions">
          <button type="button" data-account-action="kukai">Link a wallet (Kukai)</button>
          <button type="button" data-account-action="metamask">Link MetaMask</button>
          <button type="button" data-account-action="phantom">Link Phantom</button>
          <button type="button" class="account-desk__signout" data-account-action="logout">Sign out</button>
        </div>
      </div>
      <p class="account-desk__result" data-account-result aria-live="polite">
        Checking your PointCast account…
      </p>
    </section>

    <section class="account-desk__providers" aria-label="Sign-in and wallet choices">
      <header>
        <p class="account-desk__kicker">YOUR CHOICES</p>
        <h2>Sign in or link a wallet.</h2>
        <p>Each choice is separate. PointCast shows only the provider names on this page.</p>
      </header>

      <div class="account-desk__provider-grid">
        {ACCOUNT_PROVIDERS.map((provider, index) => (
          <article data-account-provider={provider.id} data-state={provider.availability}>
            <div class="account-desk__provider-top">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span data-account-provider-badge>{provider.availability === 'available' ? 'AVAILABLE' : 'PREVIEW'}</span>
            </div>
            <p>{provider.provider} / {provider.kind}</p>
            <h3>{provider.provider}</h3>
            <small data-account-provider-state>
              {provider.availability === 'available' ? 'Ready when you choose it.' : 'Setup is still in progress.'}
            </small>
            <button type="button" data-account-action={provider.id} data-account-provider-action>
              {provider.availability === 'available' ? `Continue with ${provider.provider} →` : `Try ${provider.provider} →`}
            </button>
          </article>
        ))}
      </div>
    </section>

    <footer class="account-desk__footer">
      <p>
        Your account choices stay narrow and reversible.
        <a href="/privacy">Read the privacy boundary</a>.
      </p>
      <nav aria-label="Account routes">
        <a href="/auth.json">/auth.json</a>
        <a href="/api/auth/session">/api/auth/session</a>
        <a href="/dashboard">/dashboard</a>
      </nav>
    </footer>
  </main>

  <script>
    import type { PointCastUser } from '../lib/auth/types';
    import {
      getSession,
      loginWithApple,
      loginWithKukai,
      loginWithMetaMask,
      loginWithPhantom,
      logout,
    } from '../lib/auth/client';
    import { buildAccountDeskView } from '../lib/auth/account-desk.mjs';

    type AccountDeskWindow = Window & {
      __pointCastAccountDeskCleanup?: () => void;
      __pointCastAccountDeskPageLoadInstalled?: boolean;
    };

    function setText(root: HTMLElement, selector: string, value: string): void {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }

    function renderAccountDesk(root: HTMLElement, user: PointCastUser | null): void {
      const view = buildAccountDeskView(user);
      const hero = root.querySelector<HTMLElement>('.account-desk__hero');
      const signedOut = root.querySelector<HTMLElement>('[data-account-signed-out]');
      const signedIn = root.querySelector<HTMLElement>('[data-account-signed-in]');
      if (hero) hero.setAttribute('aria-busy', 'false');
      if (signedOut) signedOut.hidden = view.signedIn;
      if (signedIn) signedIn.hidden = !view.signedIn;
      setText(root, '[data-account-name]', view.preferredName);
      setText(root, '[data-account-signed-in-with]', view.signedInWith);
      setText(root, '[data-account-result]', view.result);

      const chips = root.querySelector<HTMLElement>('[data-account-identity-chips]');
      if (chips) {
        chips.replaceChildren();
        view.identityChips.forEach((provider) => {
          const chip = document.createElement('span');
          chip.textContent = provider;
          chips.append(chip);
        });
      }

      Object.entries(view.providers).forEach(([provider, state]) => {
        const card = root.querySelector<HTMLElement>(`[data-account-provider="${provider}"]`);
        if (!card) return;
        card.dataset.state = state.state;
        setText(card, '[data-account-provider-badge]', state.badge);
        setText(card, '[data-account-provider-state]', state.status);
        const action = card.querySelector<HTMLButtonElement>('[data-account-provider-action]');
        if (action) {
          action.textContent = state.action;
          action.disabled = state.connected && provider !== 'kukai';
        }
      });
    }

    function renderAllAccountDesks(user: PointCastUser | null): void {
      document.querySelectorAll<HTMLElement>('[data-account-desk]').forEach((root) => {
        renderAccountDesk(root, user);
      });
    }

    async function refreshAccountDesk(): Promise<void> {
      try {
        renderAllAccountDesks(await getSession());
      } catch {
        renderAllAccountDesks(null);
        document.querySelectorAll<HTMLElement>('[data-account-result]').forEach((result) => {
          result.textContent = 'The account service is unavailable. You can still look around.';
        });
      }
    }

    function showActionStatus(root: HTMLElement, message: string): void {
      setText(root, '[data-account-result]', message);
    }

    async function performAccountAction(root: HTMLElement, action: string): Promise<void> {
      let user: PointCastUser | null = null;
      if (action === 'kukai') {
        showActionStatus(root, 'Opening Kukai for one wallet-control signature…');
        user = await loginWithKukai({ force: true });
      } else if (action === 'metamask') {
        showActionStatus(root, 'Opening MetaMask for one wallet-control signature…');
        user = await loginWithMetaMask();
      } else if (action === 'phantom') {
        showActionStatus(root, 'Opening Phantom for one wallet-control signature…');
        user = await loginWithPhantom();
      } else if (action === 'apple') {
        showActionStatus(root, 'Opening Apple sign-in…');
        user = await loginWithApple();
      } else if (action === 'logout') {
        showActionStatus(root, 'Signing out…');
        await logout();
        return;
      }

      if (user) {
        window.dispatchEvent(new CustomEvent('pc:auth-change', {
          detail: { user, source: 'account-desk' },
        }));
      }
    }

    function initializeAccountDesk(): void {
      const accountWindow = window as AccountDeskWindow;
      accountWindow.__pointCastAccountDeskCleanup?.();
      const roots = document.querySelectorAll<HTMLElement>('[data-account-desk]');
      if (!roots.length) return;

      const handleAccountClick = (event: MouseEvent): void => {
        const target = event.target instanceof Element ? event.target : null;
        const actionButton = target?.closest<HTMLButtonElement>('[data-account-action]');
        const root = actionButton?.closest<HTMLElement>('[data-account-desk]');
        if (!actionButton || !root || actionButton.disabled) return;

        event.preventDefault();
        // Preserve the account-desk interaction contract: these delegated
        // buttons must not bubble into AuthMenu's outside-click closer.
        event.stopPropagation();
        const action = actionButton.dataset.accountAction || '';
        if (action === 'google') {
          window.location.assign('/api/auth/google?returnTo=/auth');
          return;
        }
        void performAccountAction(root, action).catch((error) => {
          showActionStatus(root, error instanceof Error ? error.message : 'Account action stopped.');
        });
      };

      const handleAccountChange = (): void => {
        void refreshAccountDesk();
      };

      document.addEventListener('click', handleAccountClick, { capture: true });
      window.addEventListener('pc:auth-change', handleAccountChange);
      accountWindow.__pointCastAccountDeskCleanup = () => {
        document.removeEventListener('click', handleAccountClick, { capture: true });
        window.removeEventListener('pc:auth-change', handleAccountChange);
      };

      void refreshAccountDesk();
    }

    const accountWindow = window as AccountDeskWindow;
    if (!accountWindow.__pointCastAccountDeskPageLoadInstalled) {
      accountWindow.__pointCastAccountDeskPageLoadInstalled = true;
      document.addEventListener('astro:page-load', initializeAccountDesk);
    }
    initializeAccountDesk();
  </script>
</BlockLayout>

<style is:global>
  body { background: #f7f5ea; }
  .account-desk {
    --account-ink: #151515;
    --account-blue: #3453df;
    --account-acid: #eaff57;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 80px;
    color: var(--account-ink);
    font-family: var(--pc-font-sans, Inter, system-ui, sans-serif);
  }
  .account-desk__topbar {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-block: 1px solid var(--account-ink);
  }
  .account-desk__topbar > a { display: flex; align-items: baseline; gap: 10px; color: inherit; text-decoration: none; }
  .account-desk__topbar strong { font-size: 20px; letter-spacing: 0.14em; }
  .account-desk__topbar > a span,
  .account-desk__kicker,
  .account-desk__result,
  .account-desk__provider-top,
  .account-desk__provider-grid article > p,
  .account-desk__provider-grid small,
  .account-desk__footer {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
  }
  .account-desk__topbar > a span { font-size: 8px; }
  .account-desk__kicker { margin: 0; color: var(--account-blue); font-size: 9px; font-weight: 800; letter-spacing: 0.13em; }
  .account-desk__hero {
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: clamp(36px, 8vw, 96px);
    border-bottom: 1px solid var(--account-ink);
    background: linear-gradient(135deg, #fffdf4 62%, rgba(234, 255, 87, 0.55));
  }
  .account-desk__hero > div { width: 100%; }
  .account-desk__hero h1 { max-width: 900px; margin: 20px 0 24px; font-size: clamp(54px, 8vw, 108px); line-height: 0.83; letter-spacing: -0.065em; text-transform: uppercase; }
  .account-desk__hero h1 em { color: var(--account-blue); font-style: normal; }
  .account-desk__hero div > p:not(.account-desk__kicker) { max-width: 680px; margin: 0; font-size: 18px; line-height: 1.45; }
  .account-desk__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .account-desk__actions button,
  .account-desk__provider-grid button {
    min-height: 48px;
    padding: 0 18px;
    border: 1px solid var(--account-ink);
    background: var(--account-ink);
    color: #fff;
    font: 800 8px/1 var(--pc-font-mono, ui-monospace, monospace);
    text-transform: uppercase;
    cursor: pointer;
  }
  .account-desk__actions .account-desk__signout { background: transparent; color: var(--account-ink); }
  .account-desk__chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .account-desk__chips span { padding: 7px 9px; border: 1px solid var(--account-ink); background: #fff; box-shadow: 3px 3px 0 var(--account-acid); font: 800 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .account-desk__result { min-height: 16px; margin: 16px 0 0; color: #5e625a; font-size: 8px; line-height: 1.5; }
  .account-desk__providers { padding: 66px 0; border-bottom: 1px solid var(--account-ink); }
  .account-desk__providers > header { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px 60px; margin-bottom: 28px; }
  .account-desk__providers > header .account-desk__kicker { grid-column: 1 / -1; }
  .account-desk__providers h2 { margin: 0; font-size: clamp(36px, 5vw, 72px); line-height: 0.9; letter-spacing: -0.05em; text-transform: uppercase; }
  .account-desk__providers > header > p:last-child { max-width: 580px; margin: 0; align-self: end; color: #5f625b; font-size: 14px; line-height: 1.5; }
  .account-desk__provider-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--account-ink); }
  .account-desk__provider-grid article { min-height: 300px; display: flex; flex-direction: column; padding: clamp(24px, 4vw, 48px); border-right: 1px solid var(--account-ink); border-bottom: 1px solid var(--account-ink); background: #fffdf4; }
  .account-desk__provider-grid article:nth-child(2n) { border-right: 0; }
  .account-desk__provider-grid article:last-child { grid-column: 1 / -1; border-right: 0; border-bottom: 0; }
  .account-desk__provider-grid article[data-state='connected'] { background: linear-gradient(150deg, #fffdf4 62%, rgba(234,255,87,0.6)); }
  .account-desk__provider-top { display: flex; justify-content: space-between; font-size: 8px; }
  .account-desk__provider-top span:last-child { padding: 5px 7px; border: 1px solid var(--account-ink); background: #fff; }
  .account-desk__provider-grid article > p { margin: 36px 0 8px; color: var(--account-blue); font-size: 8px; font-weight: 800; }
  .account-desk__provider-grid h3 { margin: 0; font-size: clamp(34px, 4vw, 56px); line-height: 0.9; letter-spacing: -0.045em; text-transform: uppercase; }
  .account-desk__provider-grid small { margin: 18px 0 24px; color: #676b63; font-size: 7px; line-height: 1.45; }
  .account-desk__provider-grid button { align-self: flex-start; margin-top: auto; }
  .account-desk__provider-grid button:disabled { background: #5e625a; cursor: default; opacity: 0.65; }
  .account-desk__footer { display: flex; justify-content: space-between; gap: 24px; padding: 24px 0; font-size: 8px; line-height: 1.5; }
  .account-desk__footer p { margin: 0; }
  .account-desk__footer a { color: var(--account-blue); }
  .account-desk__footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12px; }

  @media (max-width: 760px) {
    .account-desk { width: min(100% - 20px, 700px); padding-top: 10px; }
    .account-desk__hero { min-height: 500px; padding: 42px 16px; }
    .account-desk__hero h1 { font-size: clamp(48px, 16vw, 76px); }
    .account-desk__hero div > p:not(.account-desk__kicker) { font-size: 15px; }
    .account-desk__actions { display: grid; grid-template-columns: 1fr; }
    .account-desk__providers > header { grid-template-columns: 1fr; }
    .account-desk__providers > header .account-desk__kicker { grid-column: auto; }
    .account-desk__provider-grid { grid-template-columns: 1fr; }
    .account-desk__provider-grid article,
    .account-desk__provider-grid article:nth-child(2n),
    .account-desk__provider-grid article:last-child { grid-column: auto; border-right: 0; border-bottom: 1px solid var(--account-ink); }
    .account-desk__provider-grid article:last-child { border-bottom: 0; }
    .account-desk__footer { flex-direction: column; }
    .account-desk__footer nav { justify-content: flex-start; }
  }
</style>
