---
/**
 * /drum-medley — curate up to 4 bottles into a single share-link.
 *
 * The async-drum register has bottles (one phrase you send) and the
 * shelf jukebox (everything you've made). Medley fills the gap
 * between them: a CURATED set of 1..4 bottles, encoded together in
 * one URL, playable in sequence as a mini-mixtape you send to someone.
 *
 * Mechanic:
 *   • Each slot is a full bottle: 8 bytes pattern + 1 byte BPM = 9 bytes
 *   • Up to 4 slots → 9..36 bytes total → 12..48 base64url chars
 *   • Total state lives in /drum-medley?p=<concatenated>
 *   • Slot count derived from byte length / 9
 *
 * Open the link → see all 4 mini-grids stacked vertically with their
 * BPMs. ▶ play all loops through them in order at each one's tempo.
 * You can edit, remove, or add slots and re-export — there's no
 * "received" mode lock; a medley is always a remix-able starting point.
 *
 * Different from /drum-shelf jukebox:
 *   • Shelf = YOUR phrases, local-only, automatically populated
 *   • Medley = a CURATED set you choose to send, anyone can listen
 *
 * Distinguishes itself from /drum-octet, which is a sequential CHAIN
 * (one beat per contributor, ordered): medley is a PLAYLIST of full
 * phrases, no ordering rule, just a set you handpicked.
 *
 * Shipped 2026-05-14 (Thursday overnight). Fills the "curated mixtape"
 * gap in the async register. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Drum Medley — curate up to 4 bottles into one share-link"
  description="A mini-mixtape of drum phrases. Pick 1..4 bottles, hear them play in sequence at each one's native BPM. The whole playlist lives in the URL. Curate, copy, send — recipients hear your selection on any device. No accounts, no server."
  image="/images/og-drum.png"
>
  <main class="dme" id="dme" data-built={built}>
    <header class="dme__hero">
      <p class="dme__kicker">DRUM · MEDLEY · 1..4 bottles · curated mixtape</p>
      <h1 class="dme__title" id="dme-title">Curate a 4-bottle mixtape.</h1>
      <p class="dme__sub" id="dme-sub">Pick up to four <a href="/drum-bottle">drum-bottles</a>. Each one stays at its native BPM; the medley plays them back in order, looping. The whole playlist fits in 48 characters of URL. Send a mini-mixtape to a friend; no accounts, no server.</p>
    </header>

    <section class="dme__stage">

      <!-- Banner shows when arrived via ?p= -->
      <div class="dme__banner" id="dme-banner" hidden>
        <span class="dme__banner-icon">📻</span>
        <span class="dme__banner-body">
          <span class="dme__banner-title" id="dme-banner-title">a medley arrived</span>
          <span class="dme__banner-meta" id="dme-banner-meta">4 bottles · avg 100 BPM</span>
        </span>
        <button class="dme__banner-action" id="dme-banner-action" type="button">▶ play all</button>
      </div>

      <!-- 4 slots -->
      <div class="dme__slots" id="dme-slots"></div>

      <!-- Transport -->
      <div class="dme__transport">
        <button class="dme__btn dme__btn--play" id="dme-play" type="button">▶ play all</button>
        <button class="dme__btn dme__btn--stop" id="dme-stop" type="button" hidden>⏹ stop</button>
        <span class="dme__transport-meta" id="dme-transport-meta">0 of 4 slots filled</span>
      </div>

      <!-- Actions -->
      <div class="dme__actions">
        <button class="dme__action dme__action--primary" id="dme-copy" type="button">↗ copy medley link</button>
        <a class="dme__action" id="dme-sms" href="#">↗ via iMessage</a>
        <button class="dme__action dme__action--ghost" id="dme-clear" type="button">clear all</button>
      </div>

    </section>

    <section class="dme__notes">
      <h2 class="dme__notes-h">How a medley works</h2>
      <p>Each slot is a complete <a href="/drum-bottle">drum-bottle</a>: 8 bytes of pattern + 1 byte of BPM = 9 bytes. Stack 4 of them and you've got 36 bytes — 48 base64url characters of URL. Each slot keeps its own BPM, so a medley can shift tempo from track to track the way a real mixtape does.</p>
      <p>To compose: paste a bottle URL (or just its <code>?p=</code> code) into any slot. The mini-grid lights up and the slot remembers the BPM. Once you have at least one slot filled, press ▶ to hear it. Press "copy medley link" to put the whole playlist on your clipboard.</p>
      <p>To listen: open someone's medley URL and the slots fill in automatically. Press ▶ and the medley plays through, looping when it reaches the end. You can edit the slots — remove some, paste in your own bottles, re-export. <em>A medley is always remix-able.</em></p>
      <p>Different from <a href="/drum-shelf">/drum-shelf</a>'s jukebox: the shelf is <em>your</em> local list, growing automatically as you copy and receive bottles. A medley is <em>chosen</em> — curated, finite, made to be sent. Different from <a href="/drum-octet">/drum-octet</a>, which is a sequential chain of one beat per contributor: medley is a playlist of full phrases.</p>
      <p>Sister surfaces in the async register: <a href="/drum-bottle">/drum-bottle</a>, <a href="/drum-call-and-response">/drum-call-and-response</a>, <a href="/drum-octet">/drum-octet</a>, <a href="/drum-genesis">/drum-genesis</a>, <a href="/drum-shelf">/drum-shelf</a>. Directory: <a href="/drum-mailbox">/drum-mailbox</a>.</p>
    </section>

    <div class="dme__toast" id="dme-toast" aria-live="polite"></div>
  </main>

  <style is:global>
    :root {
      --dme-ink: #0a1230;
      --dme-mid: #14193a;
      --dme-flame: #f6c15e;
      --dme-coral: #ff6b8a;
      --dme-mint: #8aeac0;
      --dme-sky: #7ac8ed;
      --dme-mauve: #c9a8ef;
      --dme-cream: #f4e7c8;
      --dme-cream-dim: #b8aa84;
      --dme-cream-dimmer: #7a7058;
    }

    body:has(.dme) {
      background:
        radial-gradient(circle at 20% 8%, #1a1e58 0%, transparent 50%),
        radial-gradient(circle at 80% 92%, #2a1640 0%, transparent 55%),
        var(--dme-ink);
      color: var(--dme-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dme { max-width: 780px; margin: 0 auto; padding: 36px 24px 64px; }

    /* HERO */
    .dme__hero { margin-bottom: 32px; }
    .dme__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dme-coral);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .dme__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: clamp(32px, 5.5vw, 52px);
      letter-spacing: -0.025em;
      line-height: 1.04;
      margin: 0 0 16px;
    }
    .dme__sub {
      font-size: 15px;
      line-height: 1.55;
      color: var(--dme-cream-dim);
      margin: 0;
    }
    .dme__sub a { color: var(--dme-sky); text-decoration: underline; text-underline-offset: 3px; }

    /* STAGE */
    .dme__stage {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 18px;
      padding: 22px;
      margin-bottom: 36px;
    }

    /* BANNER */
    .dme__banner {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      margin: 0 0 18px;
      background: rgba(255,107,138,0.10);
      border: 1px solid rgba(255,107,138,0.30);
      border-radius: 10px;
    }
    .dme__banner-icon { font-size: 22px; }
    .dme__banner-body { flex: 1; display: flex; flex-direction: column; }
    .dme__banner-title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: var(--dme-coral);
    }
    .dme__banner-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--dme-cream-dim);
      margin-top: 2px;
    }
    .dme__banner-action {
      border: 1px solid rgba(255,107,138,0.6);
      background: rgba(255,107,138,0.15);
      color: var(--dme-coral);
      padding: 8px 14px;
      border-radius: 6px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .dme__banner-action:hover { background: rgba(255,107,138,0.25); }

    /* SLOTS */
    .dme__slots {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 18px;
    }
    .dme__slot {
      display: grid;
      grid-template-columns: 36px 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 8px 10px;
      background: rgba(0,0,0,0.20);
      border: 1px solid rgba(244,231,200,0.08);
      border-radius: 8px;
      transition: border-color 200ms ease;
    }
    .dme__slot--filled { border-color: rgba(244,231,200,0.20); }
    .dme__slot--playing {
      border-color: var(--dme-flame);
      background: rgba(246,193,94,0.06);
      box-shadow: 0 0 0 2px rgba(246,193,94,0.20);
    }
    .dme__slot-n {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(244,231,200,0.08);
      color: var(--dme-cream-dim);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 600;
    }
    .dme__slot--filled .dme__slot-n {
      background: rgba(246,193,94,0.15);
      color: var(--dme-flame);
    }
    .dme__slot--playing .dme__slot-n {
      animation: dmePulse 1s ease-in-out infinite;
    }
    @keyframes dmePulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.15); }
    }
    .dme__slot-body {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }
    .dme__slot-input {
      width: 100%;
      padding: 6px 10px;
      background: rgba(0,0,0,0.30);
      border: 1px solid rgba(244,231,200,0.12);
      border-radius: 4px;
      color: var(--dme-cream);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.02em;
      box-sizing: border-box;
    }
    .dme__slot-input:focus {
      outline: 0;
      border-color: var(--dme-flame);
      background: rgba(0,0,0,0.45);
    }
    .dme__slot-mini {
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      grid-template-rows: repeat(4, 1fr);
      gap: 2px;
      aspect-ratio: 16 / 4;
      max-height: 56px;
      background: rgba(0,0,0,0.30);
      border-radius: 4px;
      padding: 3px;
    }
    .dme__slot-mini[data-empty="true"] {
      background-image: repeating-linear-gradient(45deg,
        rgba(244,231,200,0.03), rgba(244,231,200,0.03) 4px,
        transparent 4px, transparent 8px);
    }
    .dme__mini-cell {
      background: rgba(244,231,200,0.06);
      border-radius: 1px;
      min-width: 0;
      min-height: 0;
    }
    .dme__mini-cell--on  { background: var(--cell-color); }
    .dme__mini-cell--low.dme__mini-cell--on  { --cell-color: #f6c15e; }
    .dme__mini-cell--mid.dme__mini-cell--on  { --cell-color: #ff8a70; }
    .dme__mini-cell--high.dme__mini-cell--on { --cell-color: #c9a8ef; }
    .dme__mini-cell--bell.dme__mini-cell--on { --cell-color: #8aeac0; }
    .dme__mini-cell--play {
      box-shadow: 0 0 0 2px var(--dme-cream);
      transform: scale(0.92);
    }
    .dme__slot-aside {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }
    .dme__slot-bpm {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dme-flame);
      white-space: nowrap;
    }
    .dme__slot-remove {
      border: 1px solid rgba(255,107,138,0.30);
      background: transparent;
      color: var(--dme-coral);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      padding: 3px 8px;
      border-radius: 4px;
      cursor: pointer;
    }
    .dme__slot-remove:hover { background: rgba(255,107,138,0.10); }

    /* TRANSPORT */
    .dme__transport {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .dme__btn {
      border: 1px solid rgba(244,231,200,0.25);
      background: rgba(244,231,200,0.08);
      color: var(--dme-cream);
      padding: 10px 18px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .dme__btn:hover { background: rgba(244,231,200,0.16); }
    .dme__btn--play {
      background: rgba(246,193,94,0.15);
      border-color: rgba(246,193,94,0.45);
      color: var(--dme-flame);
    }
    .dme__btn--play:hover { background: rgba(246,193,94,0.25); }
    .dme__transport-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dme-cream-dim);
    }

    /* ACTIONS */
    .dme__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .dme__action {
      flex: 0 0 auto;
      border: 1px solid rgba(244,231,200,0.18);
      background: rgba(244,231,200,0.06);
      color: var(--dme-cream);
      padding: 10px 16px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
    }
    .dme__action:hover {
      background: rgba(244,231,200,0.14);
      border-color: rgba(244,231,200,0.35);
    }
    .dme__action--primary {
      background: rgba(255,107,138,0.15);
      border-color: rgba(255,107,138,0.45);
      color: var(--dme-coral);
    }
    .dme__action--primary:hover { background: rgba(255,107,138,0.25); }
    .dme__action--ghost {
      color: var(--dme-cream-dim);
      background: transparent;
      border-color: rgba(244,231,200,0.10);
    }

    /* NOTES */
    .dme__notes { max-width: 700px; }
    .dme__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dme-cream);
      margin: 0 0 12px;
    }
    .dme__notes p { font-size: 14px; line-height: 1.6; color: var(--dme-cream-dim); margin: 0 0 12px; }
    .dme__notes em { color: var(--dme-flame); font-style: italic; }
    .dme__notes strong { color: var(--dme-cream); font-weight: 600; }
    .dme__notes code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--dme-mint);
    }
    .dme__notes a { color: var(--dme-coral); text-decoration: underline; text-underline-offset: 3px; }

    /* TOAST */
    .dme__toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: rgba(0,0,0,0.85);
      color: var(--dme-flame);
      padding: 10px 18px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.04em;
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease, transform 240ms ease;
      z-index: 50;
      border: 1px solid rgba(246,193,94,0.4);
    }
    .dme__toast--show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const VOICE_NAMES = ['low', 'mid', 'high', 'bell'] as const;
    type Voice = typeof VOICE_NAMES[number];
    const MAX_SLOTS = 4;

    interface Slot {
      pattern: boolean[][] | null;
      bpm: number;
      rawInput: string;
    }
    const slots: Slot[] = Array.from({ length: MAX_SLOTS }, () => ({ pattern: null, bpm: 100, rawInput: '' }));

    let isPlaying = false;
    let playSlotIdx = 0;
    let playStep = 0;
    let playTimer: number | null = null;

    function blank(): boolean[][] {
      return Array.from({ length: 4 }, () => Array(16).fill(false));
    }
    function patternEmpty(p: boolean[][]): boolean {
      for (const row of p) for (const v of row) if (v) return false;
      return true;
    }
    function filledCount(): number {
      return slots.filter((s) => s.pattern !== null).length;
    }
    function filledSlotIndices(): number[] {
      const idx: number[] = [];
      slots.forEach((s, i) => { if (s.pattern) idx.push(i); });
      return idx;
    }

    // ---- bottle codec (9 bytes → 12 base64url chars) ----
    function b64UrlToBytes(code: string): Uint8Array | null {
      if (!code) return null;
      const b64 = code.replace(/-/g, '+').replace(/_/g, '/');
      const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
      let bin: string;
      try { bin = atob(padded); } catch { return null; }
      const out = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }
    function bytesToB64Url(bytes: Uint8Array): string {
      let bin = '';
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function decodeBottle(code: string): { pattern: boolean[][]; bpm: number } | null {
      const bytes = b64UrlToBytes(code);
      if (!bytes || bytes.length < 9) return null;
      const p: boolean[][] = blank();
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          const idx = r * 16 + c;
          p[r][c] = !!(bytes[idx >> 3] & (1 << (idx & 7)));
        }
      }
      const bp = 40 + bytes[8];
      if (bp < 40 || bp > 220) return null;
      return { pattern: p, bpm: bp };
    }
    function bottleBytes(p: boolean[][], bpm: number): Uint8Array {
      const bytes = new Uint8Array(9);
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 16; c++) {
          if (p[r][c]) {
            const i = r * 16 + c;
            bytes[i >> 3] |= (1 << (i & 7));
          }
        }
      }
      bytes[8] = Math.max(0, Math.min(180, bpm - 40));
      return bytes;
    }

    // ---- medley codec ----
    // Concatenate N bottles (9 bytes each). N = bytes.length / 9.
    function encodeMedley(): string {
      const filled = slots.filter((s) => s.pattern !== null);
      if (filled.length === 0) return '';
      const totalLen = filled.length * 9;
      const all = new Uint8Array(totalLen);
      filled.forEach((s, i) => {
        const b = bottleBytes(s.pattern!, s.bpm);
        all.set(b, i * 9);
      });
      return bytesToB64Url(all);
    }
    function decodeMedley(code: string): { pattern: boolean[][]; bpm: number }[] | null {
      const bytes = b64UrlToBytes(code);
      if (!bytes || bytes.length < 9) return null;
      const N = Math.floor(bytes.length / 9);
      if (N < 1 || N > MAX_SLOTS) return null;
      const out: { pattern: boolean[][]; bpm: number }[] = [];
      for (let n = 0; n < N; n++) {
        const slice = bytes.slice(n * 9, n * 9 + 9);
        const sub = bytesToB64Url(slice);
        const dec = decodeBottle(sub);
        if (!dec) return null;
        out.push(dec);
      }
      return out;
    }

    // ---- input extraction ----
    function extractCode(raw: string): string {
      if (!raw) return '';
      const trimmed = raw.trim();
      try {
        const u = new URL(trimmed);
        const p = u.searchParams.get('p');
        if (p) return p;
      } catch { /* not a URL */ }
      return trimmed.replace(/[^A-Za-z0-9_-]/g, '');
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    const VOICE_CFG: Record<Voice, { freq: number; bell: boolean }> = {
      low:  { freq:  70, bell: false },
      mid:  { freq: 120, bell: false },
      high: { freq: 200, bell: false },
      bell: { freq: 600, bell: true  },
    };
    function playVoice(voice: Voice) {
      ensureCtx();
      if (!ctx || !scheduler || !masterGain) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const cfg = VOICE_CFG[voice];
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = cfg.bell ? 'sine' : 'triangle';
      osc.frequency.value = cfg.freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.45, t + 0.004);
      const tail = cfg.bell ? 1.0 : 0.35;
      g.gain.exponentialRampToValueAtTime(0.0001, t + tail);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + tail + 0.05);
      if (cfg.bell) {
        for (const mult of [2, 3]) {
          const o = ctx.createOscillator();
          const gg = ctx.createGain();
          o.type = 'sine';
          o.frequency.value = cfg.freq * mult;
          gg.gain.setValueAtTime(0.0001, t);
          gg.gain.exponentialRampToValueAtTime(0.12 / mult, t + 0.008);
          gg.gain.exponentialRampToValueAtTime(0.0001, t + 0.7 / mult);
          o.connect(gg).connect(masterGain);
          scheduler.trackSource(o);
          o.start(t);
          o.stop(t + 0.75);
        }
      }
    }

    // ---- transport ----
    function currentSlot(): Slot | null {
      const filled = filledSlotIndices();
      if (filled.length === 0) return null;
      const slotIdx = filled[playSlotIdx];
      return slots[slotIdx] || null;
    }
    function currentSlotPosition(): number | null {
      const filled = filledSlotIndices();
      if (filled.length === 0) return null;
      return filled[playSlotIdx] ?? null;
    }
    function stepMs() {
      const s = currentSlot();
      return (60_000 / (s?.bpm || 100)) / 4;
    }

    function tick() {
      document.querySelectorAll('.dme__mini-cell--play').forEach((el) => el.classList.remove('dme__mini-cell--play'));
      const pos = currentSlotPosition();
      const slot = currentSlot();
      if (pos == null || !slot || !slot.pattern) {
        stopPlay();
        return;
      }
      // Highlight current slot row
      document.querySelectorAll('.dme__slot--playing').forEach((el) => el.classList.remove('dme__slot--playing'));
      const slotEl = document.querySelectorAll('.dme__slot')[pos] as HTMLElement;
      if (slotEl) slotEl.classList.add('dme__slot--playing');

      // Light cells + play voices at this step
      const miniEl = slotEl ? slotEl.querySelector('.dme__slot-mini') as HTMLElement | null : null;
      for (let r = 0; r < 4; r++) {
        if (miniEl) {
          const cell = miniEl.children[r * 16 + playStep] as HTMLElement;
          if (cell) cell.classList.add('dme__mini-cell--play');
        }
        if (slot.pattern[r][playStep]) playVoice(VOICE_NAMES[r]);
      }
      playStep++;
      if (playStep >= 16) {
        playStep = 0;
        const filled = filledSlotIndices();
        playSlotIdx = (playSlotIdx + 1) % filled.length;
      }
    }
    function startPlay() {
      if (isPlaying) return;
      if (filledCount() === 0) {
        showToast('paste a bottle into a slot first');
        return;
      }
      ensureCtx();
      isPlaying = true;
      playSlotIdx = 0;
      playStep = 0;
      document.getElementById('dme-play')!.hidden = true;
      document.getElementById('dme-stop')!.hidden = false;
      tick();
      const loop = () => {
        if (!isPlaying) return;
        tick();
        playTimer = window.setTimeout(loop, stepMs());
      };
      playTimer = window.setTimeout(loop, stepMs());
    }
    function stopPlay() {
      isPlaying = false;
      if (playTimer != null) { clearTimeout(playTimer); playTimer = null; }
      document.querySelectorAll('.dme__mini-cell--play').forEach((el) => el.classList.remove('dme__mini-cell--play'));
      document.querySelectorAll('.dme__slot--playing').forEach((el) => el.classList.remove('dme__slot--playing'));
      document.getElementById('dme-play')!.hidden = false;
      document.getElementById('dme-stop')!.hidden = true;
    }

    // ---- url ----
    function medleyUrl(): string {
      const code = encodeMedley();
      if (!code) return location.origin + '/drum-medley';
      return `${location.origin}/drum-medley?p=${code}`;
    }
    function smsHref(): string {
      const url = medleyUrl();
      return `sms:&body=${encodeURIComponent('🥁📻 ' + url)}`;
    }
    function syncUrlBar() {
      try {
        const u = new URL(location.href);
        const code = encodeMedley();
        if (code) u.searchParams.set('p', code);
        else u.searchParams.delete('p');
        history.replaceState({}, '', u.toString());
      } catch { /* ignore */ }
    }

    // ---- clipboard ----
    async function copyText(text: string, msg: string) {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
          showToast(msg);
        } else throw new Error('no clipboard');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); showToast(msg); }
        catch { showToast(text); }
        finally { ta.remove(); }
      }
    }
    function showToast(msg: string) {
      const el = document.getElementById('dme-toast')!;
      el.textContent = msg;
      el.classList.add('dme__toast--show');
      setTimeout(() => el.classList.remove('dme__toast--show'), 2600);
    }

    // ---- render ----
    function renderSlots() {
      const wrap = document.getElementById('dme-slots')!;
      wrap.innerHTML = '';
      for (let i = 0; i < MAX_SLOTS; i++) {
        const slot = slots[i];
        const isFilled = slot.pattern !== null;
        const row = document.createElement('div');
        row.className = 'dme__slot' + (isFilled ? ' dme__slot--filled' : '');
        row.dataset.idx = String(i);

        // # badge
        const n = document.createElement('div');
        n.className = 'dme__slot-n';
        n.textContent = `#${i + 1}`;
        row.appendChild(n);

        // Body: input + mini-grid
        const body = document.createElement('div');
        body.className = 'dme__slot-body';
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'dme__slot-input';
        input.value = slot.rawInput;
        input.placeholder = i === 0
          ? 'paste a bottle URL or ?p= code'
          : 'optional · paste another bottle';
        input.autocomplete = 'off';
        input.addEventListener('input', () => {
          slot.rawInput = input.value;
          loadSlot(i, input.value);
        });
        body.appendChild(input);

        const mini = document.createElement('div');
        mini.className = 'dme__slot-mini';
        if (slot.pattern) {
          mini.setAttribute('data-empty', 'false');
          for (let r = 0; r < 4; r++) {
            for (let c = 0; c < 16; c++) {
              const cell = document.createElement('span');
              cell.className = `dme__mini-cell dme__mini-cell--${VOICE_NAMES[r]}` + (slot.pattern[r][c] ? ' dme__mini-cell--on' : '');
              mini.appendChild(cell);
            }
          }
        } else {
          mini.setAttribute('data-empty', 'true');
        }
        body.appendChild(mini);

        row.appendChild(body);

        // Aside: bpm + remove
        const aside = document.createElement('div');
        aside.className = 'dme__slot-aside';
        const bpmLabel = document.createElement('span');
        bpmLabel.className = 'dme__slot-bpm';
        bpmLabel.textContent = isFilled ? `${slot.bpm} BPM` : '—';
        aside.appendChild(bpmLabel);
        if (isFilled) {
          const remove = document.createElement('button');
          remove.className = 'dme__slot-remove';
          remove.type = 'button';
          remove.textContent = '× remove';
          remove.addEventListener('click', () => removeSlot(i));
          aside.appendChild(remove);
        }
        row.appendChild(aside);

        wrap.appendChild(row);
      }

      // Update meta + sms link
      const n = filledCount();
      const meta = document.getElementById('dme-transport-meta')!;
      const avgBpm = n > 0
        ? Math.round(slots.filter((s) => s.pattern).reduce((sum, s) => sum + s.bpm, 0) / n)
        : 0;
      meta.textContent = n === 0
        ? '0 of 4 slots filled'
        : `${n} of 4 slots filled · avg ${avgBpm} BPM`;

      // Banner visibility
      const banner = document.getElementById('dme-banner')!;
      if (n >= 1 && bannerWasFromUrl) {
        banner.hidden = false;
        document.getElementById('dme-banner-title')!.textContent =
          `a medley arrived · ${n} bottle${n === 1 ? '' : 's'}`;
        document.getElementById('dme-banner-meta')!.textContent =
          `avg ${avgBpm} BPM · tap play all`;
      } else {
        banner.hidden = true;
      }

      updateSms();
      syncUrlBar();
    }

    function updateSms() {
      const a = document.getElementById('dme-sms')! as HTMLAnchorElement;
      a.href = smsHref();
    }

    function loadSlot(i: number, raw: string) {
      const code = extractCode(raw);
      if (!code) {
        slots[i].pattern = null;
        slots[i].bpm = 100;
      } else {
        const dec = decodeBottle(code);
        if (dec) {
          slots[i].pattern = dec.pattern;
          slots[i].bpm = dec.bpm;
        } else {
          slots[i].pattern = null;
          slots[i].bpm = 100;
        }
      }
      stopPlay();
      renderSlots();
    }

    function removeSlot(i: number) {
      slots[i].pattern = null;
      slots[i].bpm = 100;
      slots[i].rawInput = '';
      stopPlay();
      renderSlots();
    }

    // ---- init ----
    let bannerWasFromUrl = false;
    function init() {
      const params = new URLSearchParams(location.search);
      const code = params.get('p') || '';
      if (code) {
        const decoded = decodeMedley(code);
        if (decoded) {
          decoded.forEach((d, i) => {
            if (i < MAX_SLOTS) {
              slots[i].pattern = d.pattern;
              slots[i].bpm = d.bpm;
              slots[i].rawInput = '';  // pre-loaded, no raw input text
            }
          });
          bannerWasFromUrl = true;
        } else {
          showToast('couldn\'t decode that medley');
        }
      }

      renderSlots();

      document.getElementById('dme-play')!.addEventListener('click', startPlay);
      document.getElementById('dme-stop')!.addEventListener('click', stopPlay);
      document.getElementById('dme-banner-action')!.addEventListener('click', () => {
        if (isPlaying) stopPlay(); else startPlay();
      });

      document.getElementById('dme-copy')!.addEventListener('click', () => {
        if (filledCount() === 0) { showToast('add at least one bottle first'); return; }
        copyText(medleyUrl(), `copied · ${filledCount()}-bottle medley`);
      });
      document.getElementById('dme-clear')!.addEventListener('click', () => {
        stopPlay();
        for (let i = 0; i < MAX_SLOTS; i++) {
          slots[i].pattern = null;
          slots[i].bpm = 100;
          slots[i].rawInput = '';
        }
        bannerWasFromUrl = false;
        renderSlots();
        showToast('cleared all slots');
      });

      // Space toggles play
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (isPlaying) stopPlay(); else startPlay();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
