---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  NOTICING,
  NOTICING_ALTITUDES,
  NOTICING_DESKS,
  NOTICING_STORIES,
} from '../lib/noticing';
import meshArtwork from '../assets/campaigns/network-el-segundo-2026/mesh-commons.png';

const title = 'What I Keep Noticing';
const description =
  'A sunlit PointCast weekly about rituals, towns, networks, useful knowledge, and the agreements that let people live together.';
const socialImage = 'https://pointcast.xyz/images/noticing/noticing-og.png';
const nextStory = NOTICING_STORIES[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${NOTICING.url}#issue`,
  url: NOTICING.url,
  name: title,
  alternateName: `PointCast Issue ${NOTICING.issue}: ${NOTICING.season}`,
  description,
  datePublished: NOTICING.publishedAt,
  inLanguage: 'en-US',
  image: socialImage,
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  author: {
    '@type': 'Person',
    name: 'Michael Hoydich',
  },
  contributor: NOTICING.credits.editorialRoom.map((name) => ({
    '@type': name === 'Codex' ? 'SoftwareApplication' : 'Thing',
    name,
  })),
  mainEntity: {
    '@type': 'ItemList',
    name: 'Planned August 2026 editorial run',
    numberOfItems: NOTICING_STORIES.length,
    itemListElement: NOTICING_STORIES.map((story, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: story.title,
      description: story.dek,
      item: {
        '@type': 'CreativeWork',
        name: story.title,
        creativeWorkStatus: story.status,
        temporalCoverage: story.targetDate,
      },
    })),
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialImage}
  themeColor="#ffd928"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/noticing.json', title: 'What I Keep Noticing editorial calendar' }]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Open the issue', action: 'link', target: NOTICING.url },
      { label: 'Read the JSON', action: 'link', target: NOTICING.jsonUrl },
    ],
  }}
>
  <div class="magazine" data-magazine>
    <div class="progress" aria-hidden="true"><span data-reading-progress></span></div>

    <header class="cover" id="top">
      <nav class="cover__nav" aria-label="Issue navigation">
        <a class="cover__brand" href="/">PointCast</a>
        <span>Weekly no. {NOTICING.issue}</span>
        <span>El Segundo · July 2026</span>
        <a href="/noticing.json">JSON ↗</a>
      </nav>

      <div class="cover__field" aria-hidden="true">
        <div class="cover__sun">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="cover__ray cover__ray--one"></div>
        <div class="cover__ray cover__ray--two"></div>
        <div class="cover__ray cover__ray--three"></div>
      </div>

      <div class="cover__issue">
        <span>Issue 00</span>
        <span>How we live together</span>
      </div>

      <div class="cover__title">
        <p>An editorial calendar, or:</p>
        <h1>
          <span>What I keep</span>
          <em>noticing</em>
        </h1>
      </div>

      <div class="cover__lines">
        <p><span>01</span>The future of the library</p>
        <p><span>02</span>Why LaCroix</p>
        <p><span>03</span>Animal Crossing is a gift economy</p>
        <p><span>04</span>How to calendar a life</p>
      </div>

      <div class="cover__bottom">
        <p>Infinite resources.<br /><em>Finite coordination.</em></p>
        <a href="#letter">Open the issue <span aria-hidden="true">↓</span></a>
      </div>

      <div class="cover__altitudes" aria-label="The five public altitudes">
        {NOTICING_ALTITUDES.map((altitude, index) => (
          <span>
            <b>{String(index + 1).padStart(2, '0')}</b>
            {altitude.label}
          </span>
        ))}
      </div>
    </header>

    <div class="magazine__body">
      <section class="letter section-shell" id="letter" aria-labelledby="letter-title">
        <div class="section-index" aria-hidden="true">
          <span>01</span>
          <span>Editor’s letter</span>
        </div>

        <div class="letter__heading" data-reveal>
          <p class="eyebrow">What the publication is about</p>
          <h2 id="letter-title">Everything turns out to be the same subject.</h2>
        </div>

        <div class="letter__body" data-reveal>
          <p class="letter__lead">
            Coffee is a ritual for coordinating a body with a morning. A library is a protocol
            for coordinating a town with its own memory. Animal Crossing is a gift economy with
            better graphics than most gift economies.
          </p>
          <p>
            A mesh network is a neighborhood deciding it can be its own utility. Even LaCroix—
            especially LaCroix—is a story about how desire gets manufactured, distributed, and
            shelved.
          </p>
          <p>
            We live in a moment of functionally infinite resources and painfully finite
            coordination. The tools are everywhere; the agreements are scarce. So that is the
            beat this publication covers.
          </p>
          <p>
            Some weeks that looks like a deep case study: how a town builds its own wireless
            network, what a local currency actually changes. Some weeks it is anthropology: a
            close reading of Roblox or Tumblr as coordination machines wearing entertainment
            costumes.
          </p>
          <p>
            Some weeks it is utility: how to prompt, how to automate, how to calendar, which
            kettle. And some weeks it is the body, because you are the first system you
            coordinate: walks, food, movement, the substances we use to change the channel.
          </p>
        </div>

        <aside class="letter__note" data-reveal>
          <span class="letter__sun" aria-hidden="true"></span>
          <p>None of these are separate sections so much as different altitudes over the same terrain.</p>
          <small>Mike at the desk. Fable, Claude, and Codex in the room.</small>
        </aside>

        <div class="letter__signoff">
          <span>New Friday.</span>
          <span>Field notes arrive between.</span>
          <span>Start anywhere.</span>
        </div>
      </section>

      <section class="thesis" aria-labelledby="thesis-title">
        <div class="thesis__path" aria-hidden="true">
          {NOTICING_ALTITUDES.map((altitude, index) => (
            <span style={`--i: ${index}`}>{altitude.label}</span>
          ))}
        </div>
        <div class="thesis__copy section-shell" data-reveal>
          <p class="eyebrow">The recurring question</p>
          <h2 id="thesis-title">How do ordinary people remain capable, curious, and connected inside systems they did not design?</h2>
        </div>
      </section>

      <section class="issue section-shell" id="issue" aria-labelledby="issue-title">
        <div class="section-index" aria-hidden="true">
          <span>02</span>
          <span>August run</span>
        </div>

        <header class="issue__head" data-reveal>
          <div>
            <p class="eyebrow">Issue 00 · On the desk</p>
            <h2 id="issue-title">Six reasons to come back.</h2>
          </div>
          <p>
            One substantial coordination piece. Two close readings. One useful guide. One
            revisit. One field-tested case study. Planned stories are labeled; nothing below
            pretends to be published yet.
          </p>
        </header>

        <div class="altitude-control" data-altitude-control>
          <div class="altitude-control__intro">
            <span>Follow a path</span>
            <p>Choose an altitude to see which stories touch it.</p>
          </div>
          <div class="altitude-control__buttons" role="group" aria-label="Highlight stories by altitude">
            <button type="button" data-altitude="all" aria-pressed="true">
              <span>00</span>All
            </button>
            {NOTICING_ALTITUDES.map((altitude, index) => (
              <button type="button" data-altitude={altitude.id} aria-pressed="false">
                <span>{String(index + 1).padStart(2, '0')}</span>{altitude.label}
              </button>
            ))}
          </div>
          <p class="altitude-control__status" aria-live="polite" data-altitude-status>
            All six stories are connected.
          </p>
        </div>

        <div class="story-grid" data-story-grid>
          {NOTICING_STORIES.map((story) => (
            <article
              class={`story story--${story.visual}`}
              data-story
              data-altitudes={story.altitudes.join(' ')}
              data-reveal
            >
              <div class="story__visual" aria-hidden="true">
                {story.visual === 'library' && (
                  <div class="library-art">
                    <span class="library-art__sun"></span>
                    <span class="library-art__shelf library-art__shelf--one"></span>
                    <span class="library-art__shelf library-art__shelf--two"></span>
                    <span class="library-art__shelf library-art__shelf--three"></span>
                    <span class="library-art__door">OPEN</span>
                  </div>
                )}
                {story.visual === 'lacroix' && (
                  <div class="can-art">
                    <span class="can-art__bubble can-art__bubble--one"></span>
                    <span class="can-art__bubble can-art__bubble--two"></span>
                    <span class="can-art__bubble can-art__bubble--three"></span>
                    <span class="can-art__can"><b>why</b><em>?</em></span>
                  </div>
                )}
                {story.visual === 'crossing' && (
                  <div class="crossing-art">
                    <span class="crossing-art__cloud"></span>
                    <span class="crossing-art__house"><b></b></span>
                    <span class="crossing-art__tree crossing-art__tree--one"></span>
                    <span class="crossing-art__tree crossing-art__tree--two"></span>
                    <span class="crossing-art__gift">+</span>
                  </div>
                )}
                {story.visual === 'calendar' && (
                  <div class="calendar-art">
                    <span class="calendar-art__month">AUG</span>
                    {Array.from({ length: 21 }).map((_, index) => (
                      <i class={index === 13 ? 'is-sun' : ''}>{index + 1}</i>
                    ))}
                  </div>
                )}
                {story.visual === 'places' && (
                  <div class="places-art">
                    <img
                      src="/images/morning-ocean/tokens/01-sun-tanker.png"
                      width="1024"
                      height="1024"
                      alt=""
                      loading="lazy"
                    />
                    <span>GO BACK / LOOK AGAIN</span>
                  </div>
                )}
                {story.visual === 'mesh' && (
                  <div class="mesh-art">
                    <img
                      src={meshArtwork.src}
                      width={meshArtwork.width}
                      height={meshArtwork.height}
                      alt=""
                      loading="lazy"
                    />
                  </div>
                )}
              </div>

              <div class="story__meta">
                <span>{String(story.sequence).padStart(2, '0')} / 06</span>
                <span>{story.desk}</span>
                <time datetime={story.targetDate}>{story.dateLabel}</time>
              </div>

              <div class="story__copy">
                <p class="story__format">{story.format} · {story.status.replace('-', ' ')}</p>
                <h3>{story.title}</h3>
                <p>{story.dek}</p>
              </div>

              <footer class="story__foot">
                <div aria-label="Story altitudes">
                  {story.altitudes.map((altitude) => <span>{altitude}</span>)}
                </div>
                {story.relatedUrl ? (
                  <a href={story.relatedUrl}>{story.relatedLabel} ↗</a>
                ) : (
                  <span>Planned—not yet published</span>
                )}
              </footer>
            </article>
          ))}
        </div>
      </section>

      <section class="desks" aria-labelledby="desks-title">
        <header class="desks__head section-shell" data-reveal>
          <div class="section-index" aria-hidden="true">
            <span>03</span>
            <span>Recurring departments</span>
          </div>
          <p class="eyebrow">The private planning system</p>
          <h2 id="desks-title">Five desks.<br />One beat.</h2>
          <p>
            Desks help the editors keep balance. Altitudes help readers feel the connections.
            The structure stays backstage; the curiosity stays out front.
          </p>
        </header>

        <div class="desks__grid">
          {NOTICING_DESKS.map((desk, index) => (
            <article data-reveal>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{desk.name}</h3>
              <p>{desk.note}</p>
              <small>{desk.examples}</small>
            </article>
          ))}
        </div>

        <div class="major-study section-shell" data-reveal>
          <span class="major-study__number">04</span>
          <div>
            <p class="eyebrow">The slow form</p>
            <h2>A Major Study is a season.</h2>
          </div>
          <p>
            Field notes, interviews, diagrams, tools, small dispatches, and changes of mind.
            The definitive edition arrives only after the subject has had time to push back.
          </p>
        </div>
      </section>

      <section class="next" aria-labelledby="next-title" data-next-section>
        <div class="next__image">
          <img
            src="/images/morning-ocean/tokens/01-sun-tanker.png"
            width="1024"
            height="1024"
            alt="A warm sun rising behind a tanker on calm water"
            loading="lazy"
          />
        </div>
        <div class="next__copy">
          <p class="eyebrow">Next Friday · {nextStory.dateLabel.replace('Fri · ', '')} · 08:08 PT</p>
          <h2 id="next-title">{nextStory.title}</h2>
          <p>{nextStory.dek}</p>
          <div class="next__countdown" data-countdown data-target={nextStory.targetDate} aria-live="polite">
            <span><b data-days>—</b>days</span>
            <span><b data-hours>—</b>hours</span>
            <span><b data-minutes>—</b>minutes</span>
          </div>
          <div class="next__actions">
            <a href="/feed.xml">Follow by RSS</a>
            <a href="/feed.json">JSON feed</a>
            <button type="button" data-copy-link>Copy this issue</button>
          </div>
          <p class="next__status" aria-live="polite" data-copy-status></p>
        </div>
      </section>
    </div>

    <footer class="colophon">
      <div>
        <a class="colophon__brand" href="/">PointCast</a>
        <p>Warm intelligence for bodies, homes, towns, networks, and worlds.</p>
      </div>
      <div class="colophon__routes">
        <a href="/noticing.json">Editorial JSON ↗</a>
        <a href="/archive">Archive</a>
        <a href="/reviews">Reviews</a>
        <a href="/for-agents">For agents</a>
      </div>
      <p class="colophon__credit">
        Directed by Michael Hoydich.<br />
        Fable, Claude, and Codex at the desk.<br />
        El Segundo, California · 2026.
      </p>
      <a class="colophon__top" href="#top">Sunward ↑</a>
    </footer>
  </div>

  <script is:inline>
    function initNoticingMagazine() {
      const root = document.querySelector('[data-magazine]');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const progress = root.querySelector('[data-reading-progress]');
      const updateProgress = () => {
        if (!progress) return;
        const available = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = available > 0 ? Math.min(1, Math.max(0, window.scrollY / available)) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });

      const buttons = Array.from(root.querySelectorAll('[data-altitude]'));
      const stories = Array.from(root.querySelectorAll('[data-story]'));
      const filterStatus = root.querySelector('[data-altitude-status]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const altitude = button.dataset.altitude || 'all';
          buttons.forEach((candidate) => {
            candidate.setAttribute('aria-pressed', candidate === button ? 'true' : 'false');
          });

          let connected = 0;
          stories.forEach((story) => {
            const isConnected =
              altitude === 'all' || (story.dataset.altitudes || '').split(' ').includes(altitude);
            story.classList.toggle('is-dimmed', !isConnected);
            story.classList.toggle('is-connected', altitude !== 'all' && isConnected);
            if (isConnected) connected += 1;
          });

          if (filterStatus) {
            filterStatus.textContent =
              altitude === 'all'
                ? 'All six stories are connected.'
                : `${connected} ${connected === 1 ? 'story crosses' : 'stories cross'} the ${altitude} altitude.`;
          }
        });
      });

      const countdown = root.querySelector('[data-countdown]');
      const updateCountdown = () => {
        if (!countdown) return;
        const target = new Date(countdown.dataset.target || '').getTime();
        const remaining = Math.max(0, target - Date.now());
        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const dayNode = countdown.querySelector('[data-days]');
        const hourNode = countdown.querySelector('[data-hours]');
        const minuteNode = countdown.querySelector('[data-minutes]');
        if (dayNode) dayNode.textContent = String(days).padStart(2, '0');
        if (hourNode) hourNode.textContent = String(hours).padStart(2, '0');
        if (minuteNode) minuteNode.textContent = String(minutes).padStart(2, '0');
      };
      updateCountdown();
      const countdownTimer = window.setInterval(updateCountdown, 60000);
      window.addEventListener('pagehide', () => window.clearInterval(countdownTimer), { once: true });

      const copyButton = root.querySelector('[data-copy-link]');
      const copyStatus = root.querySelector('[data-copy-status]');
      copyButton?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (copyStatus) copyStatus.textContent = 'Issue link copied. Pass the sunshine.';
        } catch {
          if (copyStatus) copyStatus.textContent = window.location.href;
        }
      });

      const revealNodes = root.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        revealNodes.forEach((node) => observer.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add('is-visible'));
      }
    }

    initNoticingMagazine();
    document.addEventListener('astro:page-load', initNoticingMagazine);
  </script>

  <style>
    :global(html) {
      scroll-behavior: smooth;
      background: #f4edda;
    }

    :global(body) {
      --sun: #ffd928;
      --sun-bright: #f7ff70;
      --paper: #f4edda;
      --paper-light: #fffaf0;
      --ink: #17140e;
      --blue: #1848c8;
      --coral: #f1603d;
      --green: #236244;
      --pink: #f3a5c6;
      --mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
      --sans: 'Inter Variable', 'Inter', system-ui, sans-serif;
      overflow-x: hidden;
      padding-bottom: 0 !important;
      background: var(--paper);
      color: var(--ink);
    }

    :global(body:has(.magazine)) {
      background: var(--paper);
    }

    .magazine {
      min-width: 0;
      overflow: clip;
      background:
        linear-gradient(rgb(23 20 14 / .035) 1px, transparent 1px),
        var(--paper);
      background-size: 100% 28px;
      color: var(--ink);
      font-family: var(--sans);
    }

    .progress {
      position: fixed;
      z-index: 100;
      inset: 0 0 auto;
      height: 5px;
      background: rgb(255 255 255 / .18);
      pointer-events: none;
    }

    .progress span {
      display: block;
      width: 100%;
      height: 100%;
      transform: scaleX(0);
      transform-origin: left;
      background: var(--coral);
    }

    .section-shell {
      width: min(1500px, calc(100% - 48px));
      margin-inline: auto;
    }

    .eyebrow,
    .section-index,
    .cover__nav,
    .cover__issue,
    .cover__lines,
    .cover__altitudes,
    .story__meta,
    .story__format,
    .story__foot,
    .letter__signoff,
    .altitude-control,
    .colophon {
      font-family: var(--mono);
      text-transform: uppercase;
      letter-spacing: .1em;
    }

    .eyebrow {
      margin: 0;
      font-size: 11px;
      line-height: 1.4;
    }

    .cover {
      position: relative;
      isolation: isolate;
      min-height: 100svh;
      display: grid;
      grid-template-rows: auto auto 1fr auto auto;
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, .5fr);
      overflow: hidden;
      border-bottom: 2px solid var(--ink);
      background: var(--sun);
    }

    .cover::after {
      position: absolute;
      z-index: -1;
      inset: 0;
      content: '';
      opacity: .22;
      pointer-events: none;
      background-image: radial-gradient(var(--ink) .8px, transparent .8px);
      background-size: 5px 5px;
      mix-blend-mode: multiply;
    }

    .cover__nav {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      gap: 28px;
      align-items: center;
      min-height: 58px;
      padding: 10px 24px;
      border-bottom: 2px solid var(--ink);
      color: var(--ink);
      font-size: 10px;
      background: rgb(255 217 40 / .92);
    }

    .cover__nav a {
      color: inherit;
    }

    .cover__brand {
      font-family: var(--sans);
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -.06em;
      text-transform: none;
    }

    .cover__issue {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 24px 0;
      font-size: 11px;
    }

    .cover__title {
      z-index: 2;
      grid-column: 1;
      align-self: center;
      min-width: 0;
      padding: 34px 20px 38px 24px;
    }

    .cover__title p {
      width: fit-content;
      margin: 0 0 18px;
      padding: 6px 9px;
      background: var(--ink);
      color: var(--sun);
      font-family: var(--mono);
      font-size: clamp(10px, 1vw, 13px);
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .cover h1 {
      max-width: 1180px;
      margin: 0;
      font-size: clamp(78px, 12.2vw, 210px);
      font-weight: 500;
      letter-spacing: -.09em;
      line-height: .72;
    }

    .cover h1 span,
    .cover h1 em {
      display: block;
    }

    .cover h1 em {
      color: var(--blue);
      font-style: italic;
      font-weight: 400;
      transform: translateX(8vw);
    }

    .cover__lines {
      z-index: 2;
      grid-column: 2;
      grid-row: 3;
      align-self: end;
      margin: 0 24px 42px 0;
      border-top: 2px solid var(--ink);
      background: var(--paper-light);
      box-shadow: 12px 12px 0 var(--coral);
      font-size: 10px;
    }

    .cover__lines p {
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 10px;
      margin: 0;
      padding: 14px;
      border: 2px solid var(--ink);
      border-top: 0;
      line-height: 1.35;
    }

    .cover__lines span {
      color: var(--coral);
    }

    .cover__bottom {
      z-index: 2;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 24px;
      padding: 0 24px 26px;
    }

    .cover__bottom p {
      margin: 0;
      font-size: clamp(24px, 3.1vw, 54px);
      font-weight: 500;
      letter-spacing: -.055em;
      line-height: .98;
    }

    .cover__bottom p em {
      color: var(--blue);
      font-style: normal;
    }

    .cover__bottom a {
      display: flex;
      gap: 56px;
      align-items: center;
      min-width: 250px;
      padding: 14px 16px;
      border: 2px solid var(--ink);
      background: var(--paper-light);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .cover__bottom a:hover {
      text-decoration: none;
      transform: translate(-4px, -4px);
      box-shadow: 4px 4px 0 var(--ink);
    }

    .cover__altitudes {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 2px solid var(--ink);
      font-size: 10px;
      background: var(--ink);
      color: var(--paper-light);
    }

    .cover__altitudes span {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 16px;
      border-right: 1px solid rgb(255 255 255 / .28);
    }

    .cover__altitudes span:last-child {
      border-right: 0;
    }

    .cover__altitudes b {
      color: var(--sun);
      font-weight: 500;
    }

    .cover__field {
      position: absolute;
      z-index: -1;
      inset: 56px 0 40px;
      pointer-events: none;
    }

    .cover__sun {
      position: absolute;
      top: 9%;
      right: 8%;
      width: min(31vw, 520px);
      aspect-ratio: 1;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--sun-bright);
      box-shadow: inset 0 0 0 26px var(--sun), inset 0 0 0 28px var(--ink);
    }

    .cover__sun span {
      position: absolute;
      inset: 18%;
      border: 1px solid var(--ink);
      border-radius: 50%;
    }

    .cover__sun span:nth-child(2) { inset: 32%; }
    .cover__sun span:nth-child(3) { inset: 46%; background: var(--coral); }

    .cover__ray {
      position: absolute;
      height: 2px;
      background: var(--ink);
      transform-origin: right;
    }

    .cover__ray::before {
      position: absolute;
      top: -5px;
      left: 0;
      width: 12px;
      height: 12px;
      content: '';
      border: 2px solid var(--ink);
      background: var(--paper-light);
    }

    .cover__ray--one {
      top: 35%;
      right: 30%;
      width: 64%;
      transform: rotate(-13deg);
    }

    .cover__ray--two {
      top: 50%;
      right: 26%;
      width: 82%;
      transform: rotate(4deg);
    }

    .cover__ray--three {
      top: 67%;
      right: 28%;
      width: 54%;
      transform: rotate(17deg);
    }

    .section-index {
      display: grid;
      grid-template-columns: 80px 1fr;
      align-items: center;
      margin-bottom: 62px;
      border-top: 2px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      font-size: 10px;
    }

    .section-index span {
      padding: 10px 0;
    }

    .section-index span:first-child {
      border-right: 1px solid var(--ink);
      color: var(--coral);
    }

    .section-index span:last-child {
      padding-left: 14px;
    }

    .letter {
      display: grid;
      grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
      gap: 0 6vw;
      padding-block: 90px 120px;
    }

    .letter .section-index {
      grid-column: 1 / -1;
    }

    .letter__heading {
      grid-column: 1;
    }

    .letter__heading h2 {
      margin: 18px 0 0;
      font-size: clamp(58px, 7.4vw, 118px);
      font-weight: 500;
      letter-spacing: -.075em;
      line-height: .84;
    }

    .letter__body {
      grid-column: 2;
      columns: 2;
      column-gap: 38px;
      font-size: clamp(16px, 1.3vw, 20px);
      line-height: 1.55;
    }

    .letter__body p {
      margin: 0 0 1.35em;
      break-inside: avoid;
    }

    .letter__lead {
      font-size: 1.3em;
      font-weight: 500;
      letter-spacing: -.025em;
      line-height: 1.35;
    }

    .letter__lead::first-letter {
      float: left;
      margin: .03em .09em 0 0;
      color: var(--blue);
      font-size: 4.35em;
      line-height: .72;
    }

    .letter__note {
      position: relative;
      grid-column: 1;
      align-self: end;
      margin-top: 80px;
      padding: 124px 24px 24px;
      border: 2px solid var(--ink);
      background: var(--sun);
      box-shadow: 12px 12px 0 var(--blue);
    }

    .letter__note p {
      margin: 0 0 28px;
      font-size: clamp(24px, 2.7vw, 42px);
      font-weight: 500;
      letter-spacing: -.05em;
      line-height: 1;
    }

    .letter__note small {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: .08em;
      line-height: 1.5;
      text-transform: uppercase;
    }

    .letter__sun {
      position: absolute;
      top: 22px;
      left: 24px;
      width: 74px;
      aspect-ratio: 1;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--coral);
      box-shadow: 0 0 0 12px var(--sun), 0 0 0 14px var(--ink);
    }

    .letter__signoff {
      grid-column: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-self: end;
      margin-top: 80px;
      border: 2px solid var(--ink);
      font-size: 10px;
    }

    .letter__signoff span {
      min-height: 72px;
      display: grid;
      place-items: center;
      padding: 12px;
      border-right: 1px solid var(--ink);
      text-align: center;
    }

    .letter__signoff span:last-child {
      border-right: 0;
      background: var(--ink);
      color: var(--paper-light);
    }

    .thesis {
      position: relative;
      min-height: 72svh;
      display: grid;
      place-items: center;
      overflow: hidden;
      border-block: 2px solid var(--ink);
      background: var(--blue);
      color: var(--paper-light);
    }

    .thesis::before {
      position: absolute;
      inset: 0;
      content: '';
      opacity: .2;
      background-image: radial-gradient(var(--paper-light) 1px, transparent 1px);
      background-size: 8px 8px;
    }

    .thesis__copy {
      position: relative;
      z-index: 2;
      padding-block: 120px;
      text-align: center;
    }

    .thesis__copy h2 {
      max-width: 1360px;
      margin: 18px auto 0;
      font-size: clamp(48px, 7.6vw, 122px);
      font-weight: 500;
      letter-spacing: -.07em;
      line-height: .9;
    }

    .thesis__path {
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
    }

    .thesis__path::before {
      position: absolute;
      top: 50%;
      left: -5%;
      width: 110%;
      height: 2px;
      content: '';
      background: var(--sun);
      transform: rotate(-8deg);
    }

    .thesis__path span {
      position: absolute;
      top: calc(22% + var(--i) * 14%);
      left: calc(4% + var(--i) * 22%);
      padding: 6px 9px;
      border: 1px solid var(--sun);
      background: var(--blue);
      color: var(--sun);
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: .1em;
      text-transform: uppercase;
      transform: rotate(-8deg);
    }

    .issue {
      padding-block: 100px 130px;
    }

    .issue__head {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
      gap: 6vw;
      align-items: end;
      margin-bottom: 70px;
    }

    .issue__head h2 {
      margin: 16px 0 0;
      font-size: clamp(66px, 9vw, 146px);
      font-weight: 500;
      letter-spacing: -.08em;
      line-height: .78;
    }

    .issue__head > p {
      max-width: 620px;
      margin: 0;
      font-size: clamp(17px, 1.4vw, 21px);
      line-height: 1.5;
    }

    .altitude-control {
      margin-bottom: 28px;
      border: 2px solid var(--ink);
      background: var(--paper-light);
      font-size: 9px;
    }

    .altitude-control__intro {
      display: grid;
      grid-template-columns: 180px 1fr;
      border-bottom: 1px solid var(--ink);
    }

    .altitude-control__intro > * {
      margin: 0;
      padding: 12px 14px;
    }

    .altitude-control__intro span {
      border-right: 1px solid var(--ink);
      background: var(--ink);
      color: var(--sun);
    }

    .altitude-control__buttons {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
    }

    .altitude-control button {
      min-height: 58px;
      display: flex;
      gap: 14px;
      align-items: center;
      justify-content: center;
      border: 0;
      border-right: 1px solid var(--ink);
      background: transparent;
      color: var(--ink);
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      cursor: pointer;
    }

    .altitude-control button:last-child {
      border-right: 0;
    }

    .altitude-control button span {
      color: var(--coral);
    }

    .altitude-control button:hover,
    .altitude-control button[aria-pressed='true'] {
      background: var(--sun);
    }

    .altitude-control__status {
      margin: 0;
      padding: 11px 14px;
      border-top: 1px solid var(--ink);
      background: var(--blue);
      color: white;
      text-align: center;
    }

    .story-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      border-top: 2px solid var(--ink);
      border-left: 2px solid var(--ink);
      background: var(--ink);
      gap: 2px;
    }

    .story {
      min-width: 0;
      display: flex;
      flex-direction: column;
      grid-column: span 4;
      min-height: 700px;
      background: var(--paper-light);
      transition: opacity 180ms ease, filter 180ms ease, transform 180ms ease;
    }

    .story:nth-child(1),
    .story:nth-child(6) {
      grid-column: span 8;
    }

    .story.is-dimmed {
      opacity: .18;
      filter: grayscale(1);
    }

    .story.is-connected {
      position: relative;
      z-index: 2;
      box-shadow: inset 0 0 0 5px var(--sun);
    }

    .story__visual {
      min-height: 330px;
      overflow: hidden;
      border-right: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
    }

    .story:nth-child(1) .story__visual,
    .story:nth-child(6) .story__visual {
      min-height: 430px;
    }

    .story__meta {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 14px;
      padding: 11px 13px;
      border-right: 2px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      font-size: 8px;
    }

    .story__meta span:nth-child(2) {
      color: var(--coral);
    }

    .story__copy {
      flex: 1;
      padding: 25px 22px 30px;
      border-right: 2px solid var(--ink);
    }

    .story__format {
      margin: 0 0 18px;
      color: var(--blue);
      font-size: 9px;
    }

    .story h3 {
      margin: 0 0 20px;
      font-size: clamp(38px, 4.1vw, 70px);
      font-weight: 500;
      letter-spacing: -.065em;
      line-height: .92;
    }

    .story:nth-child(1) h3,
    .story:nth-child(6) h3 {
      font-size: clamp(54px, 6.8vw, 104px);
    }

    .story__copy > p:last-child {
      max-width: 680px;
      margin: 0;
      font-size: 16px;
      line-height: 1.48;
    }

    .story__foot {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      min-height: 58px;
      padding: 12px 14px;
      border-top: 1px solid var(--ink);
      border-right: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      font-size: 8px;
    }

    .story__foot > div {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .story__foot > div span {
      padding: 4px 5px;
      border: 1px solid var(--ink);
    }

    .story__foot > span {
      color: #686157;
      text-align: right;
    }

    .story__foot a {
      color: var(--blue);
      text-align: right;
    }

    .library-art {
      position: relative;
      height: 100%;
      min-height: 430px;
      overflow: hidden;
      background: var(--blue);
    }

    .library-art::before {
      position: absolute;
      inset: 0;
      content: '';
      opacity: .24;
      background-image: radial-gradient(var(--paper-light) 1px, transparent 1px);
      background-size: 8px 8px;
    }

    .library-art__sun {
      position: absolute;
      top: 13%;
      right: 8%;
      width: min(24vw, 310px);
      aspect-ratio: 1;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--sun);
      box-shadow: 0 0 0 18px var(--blue), 0 0 0 20px var(--sun);
    }

    .library-art__shelf {
      position: absolute;
      bottom: 12%;
      width: 22%;
      height: 52%;
      border: 3px solid var(--ink);
      background:
        repeating-linear-gradient(90deg, transparent 0 14%, var(--ink) 14% 15%),
        repeating-linear-gradient(0deg, var(--paper-light) 0 31%, var(--ink) 31% 33%);
      box-shadow: 12px 12px 0 rgb(23 20 14 / .32);
    }

    .library-art__shelf--one { left: 5%; }
    .library-art__shelf--two { left: 30%; height: 64%; }
    .library-art__shelf--three { left: 55%; height: 42%; }

    .library-art__door {
      position: absolute;
      right: 6%;
      bottom: 12%;
      width: 14%;
      height: 31%;
      display: grid;
      place-items: center;
      border: 3px solid var(--ink);
      background: var(--coral);
      color: var(--paper-light);
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .12em;
      writing-mode: vertical-rl;
    }

    .can-art {
      position: relative;
      min-height: 330px;
      height: 100%;
      overflow: hidden;
      background: var(--coral);
    }

    .can-art::before {
      position: absolute;
      inset: 0;
      content: '';
      opacity: .35;
      background: repeating-radial-gradient(circle at 15% 20%, var(--pink) 0 3px, transparent 4px 18px);
    }

    .can-art__can {
      position: absolute;
      top: 10%;
      left: 50%;
      width: 38%;
      height: 78%;
      display: grid;
      place-items: center;
      border: 3px solid var(--ink);
      border-radius: 48% 48% 18% 18% / 8% 8% 4% 4%;
      background:
        linear-gradient(120deg, transparent 0 34%, var(--blue) 35% 42%, transparent 43%),
        var(--paper-light);
      box-shadow: 13px 13px 0 var(--ink);
      transform: translateX(-50%) rotate(6deg);
    }

    .can-art__can b {
      font-size: clamp(40px, 5vw, 76px);
      font-weight: 500;
      letter-spacing: -.08em;
      transform: rotate(-12deg);
    }

    .can-art__can em {
      position: absolute;
      right: 12%;
      bottom: 6%;
      color: var(--coral);
      font-size: 54px;
      font-style: normal;
    }

    .can-art__bubble {
      position: absolute;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--sun);
    }

    .can-art__bubble--one { top: 9%; left: 10%; width: 54px; height: 54px; }
    .can-art__bubble--two { right: 9%; bottom: 14%; width: 82px; height: 82px; }
    .can-art__bubble--three { left: 14%; bottom: 8%; width: 25px; height: 25px; }

    .crossing-art {
      position: relative;
      min-height: 330px;
      height: 100%;
      overflow: hidden;
      background:
        linear-gradient(transparent 75%, #5d9a51 75%),
        #9ee9ef;
    }

    .crossing-art::before {
      position: absolute;
      inset: 0;
      content: '';
      background-image:
        linear-gradient(rgb(23 20 14 / .1) 1px, transparent 1px),
        linear-gradient(90deg, rgb(23 20 14 / .1) 1px, transparent 1px);
      background-size: 18px 18px;
      image-rendering: pixelated;
    }

    .crossing-art__house {
      position: absolute;
      bottom: 18%;
      left: 40%;
      width: 32%;
      height: 43%;
      border: 3px solid var(--ink);
      background: var(--paper-light);
      box-shadow: 10px 10px 0 var(--ink);
    }

    .crossing-art__house::before {
      position: absolute;
      right: -13%;
      bottom: 100%;
      left: -13%;
      height: 44%;
      content: '';
      border: 3px solid var(--ink);
      background: var(--coral);
      clip-path: polygon(50% 0, 100% 100%, 0 100%);
    }

    .crossing-art__house b {
      position: absolute;
      bottom: 0;
      left: 36%;
      width: 28%;
      height: 54%;
      border: 3px solid var(--ink);
      border-bottom: 0;
      background: var(--blue);
    }

    .crossing-art__tree {
      position: absolute;
      bottom: 16%;
      width: 12%;
      height: 27%;
      border: 3px solid var(--ink);
      border-radius: 50% 50% 12% 12%;
      background: var(--green);
    }

    .crossing-art__tree--one { left: 12%; }
    .crossing-art__tree--two { right: 8%; height: 35%; }

    .crossing-art__gift {
      position: absolute;
      top: 9%;
      left: 12%;
      width: 58px;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 3px solid var(--ink);
      background: var(--sun);
      font-family: var(--mono);
      font-size: 32px;
      box-shadow: 7px 7px 0 var(--ink);
    }

    .crossing-art__cloud {
      position: absolute;
      top: 12%;
      right: 11%;
      width: 28%;
      height: 12%;
      border: 3px solid var(--ink);
      background: white;
      box-shadow: 12px 12px 0 rgb(23 20 14 / .15);
    }

    .calendar-art {
      min-height: 330px;
      height: 100%;
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      grid-template-rows: auto repeat(3, 1fr);
      gap: 2px;
      padding: 20px;
      background: var(--ink);
    }

    .calendar-art__month {
      grid-column: 1 / -1;
      padding: 8px 10px;
      background: var(--sun);
      font-size: 40px;
      font-weight: 500;
      letter-spacing: -.06em;
    }

    .calendar-art i {
      display: grid;
      place-items: center;
      min-width: 0;
      background: var(--paper-light);
      font-family: var(--mono);
      font-size: 8px;
      font-style: normal;
    }

    .calendar-art i.is-sun {
      background: var(--coral);
      color: white;
      transform: rotate(-5deg) scale(1.08);
    }

    .places-art,
    .mesh-art {
      position: relative;
      min-height: 330px;
      height: 100%;
      background: var(--ink);
    }

    .places-art img,
    .mesh-art img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .places-art img {
      filter: saturate(.78) contrast(1.08);
    }

    .places-art span {
      position: absolute;
      right: 12px;
      bottom: 12px;
      padding: 8px 10px;
      border: 2px solid var(--ink);
      background: var(--sun);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: .1em;
    }

    .mesh-art {
      min-height: 430px;
    }

    .mesh-art img {
      object-position: center;
    }

    .desks {
      border-top: 2px solid var(--ink);
      background: var(--sun);
    }

    .desks__head {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
      gap: 28px 8vw;
      padding-block: 100px 70px;
    }

    .desks__head .section-index {
      grid-column: 1 / -1;
      width: 100%;
    }

    .desks__head .eyebrow {
      grid-column: 1 / -1;
    }

    .desks__head h2 {
      margin: 0;
      font-size: clamp(72px, 10vw, 160px);
      font-weight: 500;
      letter-spacing: -.08em;
      line-height: .76;
    }

    .desks__head > p:last-child {
      align-self: end;
      max-width: 590px;
      margin: 0;
      font-size: 20px;
      line-height: 1.5;
    }

    .desks__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-block: 2px solid var(--ink);
      background: var(--paper-light);
    }

    .desks__grid article {
      min-width: 0;
      min-height: 390px;
      display: flex;
      flex-direction: column;
      padding: 22px;
      border-right: 2px solid var(--ink);
    }

    .desks__grid article:last-child {
      border-right: 0;
    }

    .desks__grid article > span {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .1em;
    }

    .desks__grid h3 {
      margin: auto 0 18px;
      font-size: clamp(34px, 3.2vw, 54px);
      font-weight: 500;
      letter-spacing: -.065em;
      line-height: .9;
    }

    .desks__grid p {
      margin: 0 0 28px;
      font-size: 15px;
      line-height: 1.45;
    }

    .desks__grid small {
      margin-top: auto;
      padding-top: 15px;
      border-top: 1px solid var(--ink);
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: .06em;
      line-height: 1.7;
      text-transform: uppercase;
    }

    .desks__grid article:nth-child(1) { background: var(--pink); }
    .desks__grid article:nth-child(2) { background: var(--paper-light); }
    .desks__grid article:nth-child(3) { background: var(--blue); color: white; }
    .desks__grid article:nth-child(4) { background: var(--paper-light); }
    .desks__grid article:nth-child(5) { background: var(--green); color: white; }

    .major-study {
      display: grid;
      grid-template-columns: 100px minmax(0, 1fr) minmax(280px, .8fr);
      gap: 36px;
      align-items: center;
      padding-block: 100px;
