---
import BlockLayout from '../../../../layouts/BlockLayout.astro';
import campaign from '../../../../../public/ads/nouns-drum-club/campaign.json';
const sizes = ['300x250','336x280','728x90','970x250','300x600','160x600','320x50','320x100','1080x1080','1080x1920'];
const example = `<div data-pointcast-network data-publisher="industrynext" data-placement="footer" data-campaign="PC-NOUNS-EVERYBODY-2026" data-size="300x250"></div>\n<script src="https://pointcast.xyz/open-ad-network.js" defer><\/script>`;
---
<BlockLayout title="Everybody’s in the band — Campaign kit" description="Thirty ready-to-run Nouns Drum Club ads in ten sizes. Three little invitations to make music together." image="/images/nouns-drum-club/campaign/everybody-band.png" immersive isolated hideAds themeColor="#f5f0e7">
  <main class="campaign" id="main-content">
    <nav aria-label="Campaign navigation"><a href="/">POINTCAST</a><a href="/nouns/drum-club/">PLAY THE DRUM CLUB ↗</a><a href="/nouns/drum-club/bandmates/">MEET THE BANDMATES ↗</a></nav>
    <header>
      <p class="eyebrow">NOUNS DRUM CLUB / THE CAMPAIGN</p>
      <h1>Everybody’s<br/><em>in the band.</em></h1>
      <div class="intro"><p>You don’t need a stage, a record deal, or somebody’s permission to make music. You need a key. Maybe a friend. Start there.</p><a class="button" href="/ads/nouns-drum-club/campaign-kit.zip" download>Download the campaign ↗<small>30 ads · 10 sizes · PNG + editable SVG + HTML</small></a></div>
    </header>
    <figure class="hero"><img src="/images/nouns-drum-club/campaign/everybody-band.webp" alt="A tiny Nouns band turns a giant computer key into a stage." width="1536" height="1024"/><figcaption>36 SOUNDS. ZERO AUDITIONS. GOOD COMPANY.</figcaption></figure>
    <section class="ideas" aria-labelledby="ideas-title"><div class="section-title"><p class="eyebrow">01 / THREE WAYS IN</p><h2 id="ideas-title">An invitation.<br/>Never a velvet rope.</h2></div><div class="ideas-grid">{campaign.concepts.map((concept,index)=><article><span class="count">0{index+1}</span><img src={concept.image} alt={concept.alt} loading="lazy" width="1536" height="1024"/><h3>{concept.headline}</h3><p>{concept.copy}</p></article>)}</div></section>
    <section class="formats" aria-labelledby="formats-title"><div class="section-title"><p class="eyebrow">02 / SMALL SPACE. BIG WELCOME.</p><h2 id="formats-title">Made to fit.</h2><p>Every format has its own layout. Static, silent, lightweight, and ready for a real person to click.</p></div>
      <div class="format-controls"><label for="campaign-size">Preview a size</label><select id="campaign-size">{sizes.map(size=><option value={size}>{size.replace('x',' × ')}</option>)}</select><p id="format-note" role="status">300 × 250 · shown at actual size where space allows</p></div>
      <div class="creative-grid" id="creative-grid">{campaign.concepts.map(concept=>{
        const asset=campaign.assets.find(a=>a.concept===concept.id && a.width===300 && a.height===250)!;
        return <article class="creative" data-concept={concept.id}><p>{concept.headline}</p><div class="ad-preview"><img src={asset.png} alt={asset.alt} width="300" height="250" loading="lazy"/></div><div class="asset-links"><a data-kind="png" href={asset.png} download>PNG ↗</a><a data-kind="svg" href={asset.svg} download>Editable SVG ↗</a><a data-kind="html" href={asset.html} target="_blank" rel="noopener">HTML ad ↗</a></div></article>;
      })}</div>
      <details><summary>See all 30 files</summary><div class="file-list">{campaign.assets.map(asset=><a href={asset.png} download>{asset.concept} · {asset.width} × {asset.height}<span>{Math.ceil(asset.bytes/1024)} KB / PNG ↗</span></a>)}</div></details>
    </section>
    <section class="publish" aria-labelledby="publish-title"><div><p class="eyebrow">03 / PASS THE INVITATION AROUND</p><h2 id="publish-title">A little room<br/>on your site.</h2><p>Use the downloadable HTML ads anywhere you host the kit. PointCast Open Ad Network publishers can choose an exact size or keep the existing responsive card.</p><p>All ads lead straight to the free instrument. Sound starts after a player chooses. Owning a collectible is optional.</p></div><details open><summary>Publisher embed example</summary><pre><code>{example}</code></pre><p>Replace the publisher and placement with your network values. Omit <code>data-size</code> for the responsive card. The network counts aggregate views and clicks and respects Do Not Track.</p><a href="/ads/nouns-drum-club/network-demo.html">Preview live ad sizes ↗</a><a href="/ads.json">Network inventory ↗</a><a href="/ads/nouns-drum-club/campaign.json">Creative manifest ↗</a></details></section>
    <footer><a href="/nouns/drum-club/">MAKE SOME NOISE ↗</a><p>Independent PointCast creative. Nouns-inspired campaign art made with OpenAI’s image generator. The 12 companion artworks and beats are prepared as an unminted collection preview.</p></footer>
  </main>
</BlockLayout>
<script>
  const select=document.querySelector<HTMLSelectElement>('#campaign-size');
  select?.addEventListener('change',()=>{
    const size=select.value;
    if(!/^(300x250|336x280|728x90|970x250|300x600|160x600|320x50|320x100|1080x1080|1080x1920)$/.test(size)) return;
    const [width,height]=size.split('x').map(Number);
    document.querySelectorAll<HTMLElement>('.creative[data-concept]').forEach(card=>{
      const base=`/ads/nouns-drum-club/${card.dataset.concept}-${size}`;
      const img=card.querySelector('img')!;
      img.src=`${base}.png`;img.width=width;img.height=height;
      card.querySelectorAll<HTMLAnchorElement>('[data-kind]').forEach(link=>link.href=`${base}.${link.dataset.kind}`);
    });
    document.querySelector('#format-note')!.textContent=`${width} × ${height} · shown at actual size where space allows`;
    document.querySelector('#creative-grid')!.classList.toggle('creative-grid--wide',width/height>3);
  });
</script>
<style>
  :global(body){background:#f5f0e7;color:#171717}
  .campaign{max-width:1440px;margin:auto;padding:0 4vw;font-family:Inter,Arial,sans-serif}
  nav{display:flex;gap:24px;align-items:center;border-bottom:2px solid;padding:24px 0;font-weight:800;font-size:12px;flex-wrap:wrap}
  nav a:first-child{margin-right:auto;font-size:22px;letter-spacing:-1px}
  a{color:inherit;text-underline-offset:4px}
  a:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #734cc2;outline-offset:5px}
  header{padding:75px 0 45px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.1em}
  h1{font-size:clamp(64px,11.4vw,162px);letter-spacing:-.085em;line-height:.85;margin:28px 0 36px;font-weight:900}
  h1 em{font-style:normal;color:#dc492a}
  .intro{display:flex;align-items:end;justify-content:space-between;gap:30px}.intro p{max-width:530px;font-size:21px;line-height:1.4;margin:0}
  .button{background:#171717;color:#f5f0e7;display:block;padding:20px 25px;text-decoration:none;font-weight:800;white-space:nowrap}.button small{display:block;font-size:11px;margin-top:9px;font-weight:500}
  figure{margin:0}.hero{position:relative;background:#eee3d3}.hero img{display:block;width:100%;height:auto}.hero figcaption{position:absolute;bottom:24px;left:26px;background:#171717;color:#fff;padding:13px;font-weight:800;font-size:12px}
  section{padding:70px 0;border-bottom:2px solid}.section-title{margin-bottom:30px}.section-title>p:last-child{max-width:600px;line-height:1.5}
  h2{font-size:clamp(34px,4.5vw,66px);line-height:.95;letter-spacing:-.06em;margin:14px 0}h3{font-size:25px;line-height:1.1;letter-spacing:-.04em;margin:18px 0 10px}
  .ideas-grid,.creative-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.ideas article{position:relative}.ideas img{display:block;width:100%;height:auto}.ideas p{font-size:16px}.count{display:block;font-weight:900;font-size:18px;margin-bottom:12px}
  .format-controls{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:32px}.format-controls label{font-weight:700}.format-controls select{font:inherit;padding:12px;background:#fff;border:2px solid}.format-controls p{font-size:13px;flex-basis:100%;margin:0}
  .creative>p{font-size:13px;font-weight:800}.ad-preview{display:flex;align-items:center;justify-content:center;min-height:290px;background:#e6e0d7;border:1px solid #cec7be;padding:16px;overflow:hidden}.ad-preview img{display:block;max-width:100%;height:auto;box-shadow:0 5px 14px #17171720}.asset-links{display:flex;flex-wrap:wrap;gap:18px}.asset-links a{display:inline-flex;align-items:center;min-height:44px;font-size:13px}.creative-grid--wide{grid-template-columns:1fr}.creative-grid--wide .ad-preview{min-height:120px;justify-content:flex-start}
  details{margin-top:30px}summary{font-weight:800;cursor:pointer;min-height:44px;align-content:center}.file-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 25px}.file-list a{padding:14px 0;border-bottom:1px solid #ccc;font-size:13px;display:flex;justify-content:space-between;gap:10px}.file-list span{font-size:11px;white-space:nowrap}
  .publish{display:grid;grid-template-columns:1fr 1fr;gap:60px}.publish p{font-size:16px;line-height:1.6}.publish details{margin:0;background:#ede7dd;padding:24px;min-width:0}.publish details>a{display:inline-flex;margin-right:20px;min-height:44px;align-items:center;font-size:13px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;line-height:1.6;background:#171717;color:#f5f0e7;padding:18px}code{font-family:monospace}
  footer{padding:40px 0 60px;display:flex;align-items:start;gap:40px}footer>a{font-size:27px;font-weight:900;letter-spacing:-.04em}footer p{margin:0 0 0 auto;max-width:500px;font-size:13px;line-height:1.5}
  @media(max-width:750px){.campaign{padding:0 18px}nav{gap:14px;font-size:10px}header{padding-top:48px}h1{font-size:clamp(48px,12.3vw,84px)}.intro{display:block}.intro p{font-size:18px}.button{margin-top:25px;white-space:normal}.hero figcaption{position:static;font-size:10px}.ideas-grid,.creative-grid{grid-template-columns:1fr}.ideas-grid{gap:34px}.ideas img{max-height:380px;object-fit:contain}.publish{grid-template-columns:1fr;gap:24px}.file-list{grid-template-columns:1fr}footer{display:block}footer p{margin-top:24px}.ad-preview{min-height:120px}section{padding:45px 0}}
</style>
