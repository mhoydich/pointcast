---
import BlockLayout from '../../../../layouts/BlockLayout.astro';
import NounsBandBuilder from '../../../../components/NounsBandBuilder.astro';
import NounsBandmateCollect from '../../../../components/NounsBandmateCollect.astro';
import { nounsDrumClubBandmateArrangement } from '../../../../lib/nouns-drum-club-arrangements';
import { NOUNS_DRUM_CLUB_BANDMATES, nounsDrumClubBandmateMetadataUrl, nounsDrumClubBandmatePlayUrl } from '../../../../lib/nouns-drum-club-bandmates';
import { NOUNS_BANDMATES_RELEASE_DECLARED_LIVE } from '../../../../lib/nouns-bandmates-mint';

const bandmates = NOUNS_DRUM_CLUB_BANDMATES;
const playHref = (item: (typeof bandmates)[number]) => nounsDrumClubBandmatePlayUrl(item);
const metadataHref = (item: (typeof bandmates)[number]) => nounsDrumClubBandmateMetadataUrl(item);
const arrangement = nounsDrumClubBandmateArrangement('2026-09-22');
const releaseLive = NOUNS_BANDMATES_RELEASE_DECLARED_LIVE;
const description = 'Twelve playable Nouns Drum Club Bandmates: each one brings beautiful artwork, a musical role, and a beat to play.';
---

<BlockLayout title="Bandmates — Everybody’s in the band" description={description} image="/images/og-nouns-drum-club.png" themeColor="#f0e94a" immersive isolated hideAds showNetworkStrip={false}>
  <main class="bandmates">
    <header class="bandmates__nav"><a href="/" class="bandmates__wordmark">POINTCAST</a><a href="/nouns/drum-club/">DRUM CLUB</a><a href="/nouns/">NOUNS / ROOMS</a></header>
    <section class="bandmates__hero" aria-labelledby="bandmates-title">
      <div><p class="bandmates__eyebrow">NOUNS DRUM CLUB · COMPANION SET · 01—12</p><h1 id="bandmates-title">Everybody’s<br /><em>in the band.</em></h1><p class="bandmates__dek">Twelve beautiful, playable Bandmates for the Drum Club. Pick your four, make a groove, and bring a friend.</p><p class="bandmates__status"><strong>{releaseLive ? 'Tezos editions · live' : 'Tezos editions · preparing to launch'}</strong><span>Every beat is free to play.</span></p><a class="bandmates__campaign" href="#make-a-band">Make your band ↓</a><a class="bandmates__campaign" href="/nouns/drum-club/campaign/">Campaign: Everybody’s in the band ↗</a></div>
      <div class="bandmates__hero-mark" aria-hidden="true"><span>✳</span><b>12</b><i>PLAYABLE<br />BANDMATES</i></div>
    </section>
    <p><a href="/images/nouns-drum-club/bandmates/bandmates-kit.zip" download>Download all 12 artworks + beats ↗</a></p>
    <NounsBandBuilder arrangement={arrangement} bandmates={bandmates} />
    <section class="bandmates__grid" aria-label="Twelve playable Drum Club Bandmates">
      {bandmates.map((item, index) => {
        const artwork = item.artwork.webp;
        const alt = `${item.name}, a playable Nouns Drum Club ${item.role} Bandmate`;
        return <article class="bandmate-card">
          <a class="bandmate-card__art" href={playHref(item)} aria-label={`Play ${item.name}`}><img src={artwork} alt={alt} loading={index < 3 ? 'eager' : 'lazy'} /><span>PLAY THIS BEAT ↗</span></a>
          <div class="bandmate-card__meta"><span class="bandmate-card__number">{item.number}</span><div><h2>{item.name}</h2><p>{item.role} · {item.tempo} BPM</p></div></div>
          <p class="bandmate-card__description">{item.description}</p>
          <div class="bandmate-card__links"><a href={playHref(item)}>Play this beat</a><a href={item.artwork.png} download>Artwork PNG</a><a href={metadataHref(item)}>Metadata</a></div>
          <NounsBandmateCollect tokenId={item.id} name={item.name} />
        </article>;
      })}
    </section>
    <footer class="bandmates__footer"><p>THE BAND IS A PLAYGROUND, NOT A GATE.</p><a href="/nouns/drum-club/">Play the Drum Club ↗</a><a href="/nouns/drum-club/campaign/">Campaign ↗</a><a href="/nouns-drum-club.json">Field guide ↗</a></footer>
  </main>
</BlockLayout>

<style>
  :global(body){background:#f5f0e7;color:#171717}.bandmates{max-width:1440px;margin:auto;padding:0 4vw 90px;font-family:Inter,Arial,sans-serif}.bandmates__nav{display:flex;align-items:center;gap:24px;min-height:70px;border-bottom:2px solid #171717;font:700 10px/1 'JetBrains Mono',monospace;letter-spacing:.09em}.bandmates__nav a{color:inherit;text-decoration:none}.bandmates__wordmark{margin-right:auto;font:900 20px/.9 Inter,Arial,sans-serif;letter-spacing:-.08em}.bandmates__hero{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:40px;align-items:end;padding:clamp(58px,9vw,125px) 0 54px}.bandmates__eyebrow{font:700 11px/1.2 'JetBrains Mono',monospace;letter-spacing:.1em}.bandmates h1{margin:18px 0 20px;font:900 clamp(74px,12vw,170px)/.78 Inter,Arial,sans-serif;letter-spacing:-.095em}.bandmates h1 em{color:#e95b31;font-style:normal}.bandmates__dek{max-width:42ch;margin:0;font-size:20px;line-height:1.35}.bandmates__status{display:flex;flex-wrap:wrap;gap:10px 22px;margin:25px 0 0;font:700 10px/1.4 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.05em}.bandmates__status strong{background:#f0e94a;padding:8px 10px}.bandmates__status span{padding:8px 0}.bandmates__hero-mark{aspect-ratio:1;background:#b9a4dc;border:2px solid #171717;display:grid;place-content:center;text-align:center;transform:rotate(4deg);box-shadow:9px 9px 0 #171717}.bandmates__hero-mark span{font-size:72px;line-height:.5}.bandmates__hero-mark b{font-size:110px;line-height:.9;letter-spacing:-.1em}.bandmates__hero-mark i{font:700 11px/1.2 'JetBrains Mono',monospace;font-style:normal;letter-spacing:.08em}.bandmates__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 16px}.bandmate-card{min-width:0}.bandmate-card__art{display:block;position:relative;background:#e9e1d8;border:2px solid #171717;aspect-ratio:1;overflow:hidden;color:#fff;text-decoration:none}.bandmate-card__art img{display:block;width:100%;height:100%;object-fit:cover}.bandmate-card__art span{position:absolute;left:10px;bottom:10px;background:#171717;padding:8px 9px;font:700 9px/1 'JetBrains Mono',monospace;letter-spacing:.05em}.bandmate-card__meta{display:flex;gap:12px;margin-top:12px}.bandmate-card__number{font:700 12px/1 'JetBrains Mono',monospace;color:#7256bd}.bandmate-card h2{margin:0;font-size:22px;line-height:.95;letter-spacing:-.05em}.bandmate-card p{margin:6px 0 0;font:700 9px/1.3 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.bandmate-card__description{font:500 12px/1.45 Inter,Arial,sans-serif;text-transform:none;letter-spacing:0;max-width:30ch}.bandmate-card__links{display:flex;gap:14px;margin-top:11px}.bandmate-card__links a{color:inherit;font:700 9px/1 'JetBrains Mono',monospace;text-underline-offset:3px}.bandmates__footer{display:flex;align-items:center;gap:22px;margin-top:70px;padding-top:20px;border-top:2px solid #171717;font:700 10px/1.2 'JetBrains Mono',monospace;letter-spacing:.06em}.bandmates__footer p{margin-right:auto}.bandmates__footer a{color:inherit}@media(max-width:900px){.bandmates__grid{grid-template-columns:repeat(3,minmax(0,1fr))}.bandmates__hero{grid-template-columns:minmax(0,1fr) 190px}.bandmates__hero-mark b{font-size:80px}}@media(max-width:650px){.bandmates{padding-inline:18px}.bandmates__nav{gap:12px;font-size:8px}.bandmates__wordmark{font-size:18px}.bandmates__hero{grid-template-columns:1fr;gap:28px;padding-top:58px}.bandmates__hero-mark{width:150px}.bandmates__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 10px}.bandmate-card h2{font-size:18px}.bandmates__footer{align-items:flex-start;flex-wrap:wrap;gap:14px}.bandmates__footer p{width:100%;margin:0}}@media(prefers-reduced-motion:reduce){.bandmates *{scroll-behavior:auto!important;transition:none!important}}
</style>

<style>
  .bandmates__campaign {
    display: inline-block;
    margin-top: 18px;
    color: #7256bd;
    font: 700 13px/1.4 'JetBrains Mono', monospace;
    text-underline-offset: 4px;
  }

  .bandmate-card__description {
    margin: 12px 0 0;
    max-width: 34ch;
    color: #36332f;
    font: 500 14px/1.45 Inter, Arial, sans-serif;
    letter-spacing: 0;
    text-transform: none;
  }

  .bandmate-card__links {
    gap: 8px;
    flex-wrap: wrap;
  }

  .bandmate-card__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 4px;
    font-size: 13px;
    line-height: 1.2;
  }

  @media (max-width: 650px) {
    .bandmates h1 {
      font-size: clamp(54px, 17vw, 82px);
      letter-spacing: -0.085em;
    }

    .bandmates__nav {
      flex-wrap: wrap;
      padding: 12px 0;
    }

    .bandmates__nav .bandmates__wordmark {
      width: 100%;
    }
  }
</style>
