---
import BlockLayout from '../../../../../layouts/BlockLayout.astro';
import launch from '../../../../../data/nouns-bandmates-launch.json';
const estimate = launch.estimate;
---
<BlockLayout title="Launch the Bandmates — Nouns Drum Club" description="Creator review for the twelve Nouns Drum Club Tezos editions." noindex immersive isolated hideAds showNetworkStrip={false}>
  <main data-bandmates-launch>
    <nav><a href="/nouns/drum-club/bandmates/">← THE BANDMATES</a><span>CREATOR LAUNCH / TEZOS</span></nav>
    <p class="eyebrow">TWELVE CHARACTERS. ONE BAND.</p>
    <h1>Put the band<br /><em>on the chain.</em></h1>
    <p class="intro">The music is already everyone’s. This creates the twelve optional, collectible Tezos editions.</p>
    <section aria-labelledby="terms"><h2 id="terms">Your launch, in plain language.</h2><ul>
      <li><strong>Free open editions.</strong> Each collect costs 0 tez plus the collector’s Tezos network charge. No edition cap.</li>
      <li><strong>Twelve Bandmates.</strong> Your creator wallet receives one edition of each at launch. Collecting opens immediately.</li>
      <li><strong>Transferable tokens.</strong> No royalty is configured. Collecting is never required to play.</li>
      <li><strong>Fixed metadata.</strong> Descriptions live on Tezos; artwork and exact-score pages are hosted on PointCast at content-addressed URLs.</li>
      <li><strong>One creator control.</strong> You can pause future collecting. Existing tokens remain transferable.</li>
    </ul><p>Creator wallet <code>{launch.administrator}</code></p>
    <p class="fee">{estimate ? `Estimated one-time network cost: ${(estimate.totalCostMutez / 1000000).toFixed(4)} tez.` : 'Your wallet will show the one-time network charge before you approve.'} <span>The wallet shows the final amount.</span></p>
    <a href={launch.payload} download>Download the exact launch package ↗</a></section>
    <section class="controls" aria-label="Launch controls">
      <button data-connect type="button">Connect creator wallet</button>
      <label><input data-agree type="checkbox" /> I reviewed these terms and want to launch this free, open-edition collection.</label>
      <button data-launch type="button" disabled>Review launch in my wallet ↗</button>
      <p data-status role="status" aria-live="polite">Prepared for your signature. No collection has been created by this page.</p>
      <a data-receipt hidden></a>
      <noscript>JavaScript is needed to connect your wallet. You can still review and download the package above.</noscript>
    </section>
  </main>
</BlockLayout>
<script>import { mountNounsBandmatesLaunch } from '../../../../../lib/nouns-bandmates-launch'; mountNounsBandmatesLaunch();</script>
<style>
  :global(body){background:#f5f0e7;color:#171717}main{max-width:980px;margin:auto;padding:28px 24px 90px;font-family:Inter,Arial,sans-serif}nav{display:flex;justify-content:space-between;gap:20px;border-bottom:2px solid;padding-bottom:22px;font:700 11px/1.5 monospace}a{color:inherit;text-underline-offset:4px}.eyebrow{margin-top:64px;font:700 12px/1.4 monospace}h1{font-size:clamp(52px,10vw,108px);line-height:.86;letter-spacing:-.075em;margin:24px 0}h1 em{font-style:normal;color:#c44021}.intro{font-size:22px;max-width:38ch;line-height:1.45}section{border-top:2px solid;margin-top:38px;padding-top:20px}h2{font-size:24px;letter-spacing:-.04em}li{margin:16px 0;line-height:1.6}code{display:block;overflow-wrap:anywhere;margin:8px 0;font-size:14px}.fee{padding:18px;background:#f0e94a;font-weight:700;line-height:1.5}.fee span{display:block;font-weight:400}.controls{display:flex;flex-direction:column;gap:22px;align-items:flex-start}button{min-height:52px;padding:14px 22px;background:#171717;color:#fff;border:2px solid #171717;font:700 16px/1.4 Inter,Arial,sans-serif;cursor:pointer}button[data-launch]{background:#b9a4dc;color:#171717}button:disabled{opacity:.5;cursor:not-allowed}label{display:flex;align-items:center;gap:14px;line-height:1.5}input{width:24px;height:24px;flex-shrink:0}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #7256bd;outline-offset:5px}[data-status]{max-width:65ch;overflow-wrap:anywhere;line-height:1.6}ul{padding-left:22px}@media(max-width:560px){nav{flex-wrap:wrap}.intro{font-size:19px}}
</style>
