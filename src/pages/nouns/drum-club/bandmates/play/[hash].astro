---
import scores from '../../../../../data/nouns-bandmates-scores.json';
import { encodeScore } from '../../../../../lib/nouns-drum-club-score';

export function getStaticPaths() {
  return scores.map((entry) => ({ params: { hash: entry.hash }, props: { score: entry.score } }));
}

const { score } = Astro.props;
const beat = encodeScore(score);
return Astro.redirect(`/nouns/drum-club/?beat=${beat}`, 302);
---
