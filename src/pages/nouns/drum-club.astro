---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { PAD_DEFINITIONS, } from '../../lib/nouns-drum-club-audio';
import '../../styles/nouns-drum-club.css';
const rows = [PAD_DEFINITIONS.slice(0,10), PAD_DEFINITIONS.slice(10,20), PAD_DEFINITIONS.slice(20,29), PAD_DEFINITIONS.slice(29)];
const band = [{noun:1, name:'THE POCKET', role:'Drums', mark:'01', cls:'drums'}, {noun:12,name:'LOW & SLOW',role:'Bass',mark:'02',cls:'bass'}, {noun:5,name:'GOOD VIBRATIONS',role:'Mallets',mark:'03',cls:'mallets'}, {noun:9,name:'CLOUD NINE',role:'Chords',mark:'04',cls:'chords'}];
---
<BlockLayout title="Nouns Drum Club" description="Your whole keyboard is a band. Play 36 sounds, build a beat, and make music together in a live Nouns room." image="/images/og-nouns-drum-club.png" themeColor="#f5f0e7" immersive hideAds isolated alternates={[{type:'application/json',href:'/nouns-drum-club.json',title:'Nouns Drum Club guide'}]} jsonLd={{'@context':'https://schema.org','@type':'WebApplication',name:'Nouns Drum Club',url:'https://pointcast.xyz/nouns/drum-club/',applicationCategory:'MultimediaApplication',operatingSystem:'Web browser',isAccessibleForFree:true}}>
  <main class="ndc" id="ndc" data-scene="clubhouse">
    <div id="main-content" tabindex="-1"></div>
    <header class="ndc-nav">
      <a href="/" class="ndc-wordmark">POINTCAST<span>↗</span></a>
      <a href="/nouns/" class="ndc-back">NOUNS / DRUM CLUB</a>
      <button id="ndc-help" class="ndc-text-button" aria-controls="ndc-guide">How to play <span>↘</span></button>
    </header>

    <section class="ndc-hero" aria-labelledby="ndc-title">
      <div><p class="ndc-eyebrow"><span class="ndc-dot"></span> A LITTLE LOUDER. A LOT MORE TOGETHER.</p><h1 id="ndc-title">NOUNS<br/><span>DRUM CLUB</span><i aria-hidden="true">✳</i></h1></div>
      <div class="ndc-hero-note"><div class="ndc-noggles" aria-hidden="true"><b></b><b></b></div><p>Your whole keyboard<br/>is a band.</p><span>36 SOUNDS. ZERO WRONG NOTES.</span></div>
    </section>

    <section class="ndc-stage" aria-label="Your reactive Nouns band">
      <canvas id="ndc-canvas" aria-hidden="true"></canvas>
      <div class="ndc-stage-top"><span id="ndc-stage-caption">THE CLUBHOUSE IS YOURS</span><button id="ndc-scene" class="ndc-stage-button">Scene: Clubhouse ↻</button></div>
      <div class="ndc-band" aria-hidden="true">{band.map((member,i)=><div class={`ndc-member ndc-member--${member.cls}`} data-member={i}><div class="ndc-member-star">✦</div><div class="ndc-noun-frame"><img src={`/games/nouns-nation-battler/assets/noun-${member.noun}.svg`} alt="" width="320" height="320" loading="eager" /></div><div class="ndc-instrument"><span>{member.mark}</span><b>{member.name}</b><i>{member.role}</i></div></div>)}</div>
      <div class="ndc-stage-bottom"><span id="ndc-last-hit">GOOD COMPANY. GREAT NOISE.</span><button id="ndc-motion" aria-pressed="false">Less motion</button></div>
    </section>

    <section class="ndc-desk" aria-label="Keyboard instrument">
      <div class="ndc-control-bar"><div class="ndc-sound-controls"><button id="ndc-sound" class="ndc-button ndc-button--orange" aria-pressed="false"><span>◉</span> Turn sound on</button><label class="ndc-volume">VOL <input id="ndc-volume" type="range" min="0" max="100" value="65" aria-label="Master volume" /></label><meter id="ndc-level" min="0" max="1" value="0" aria-label="Audio output level" title="Audio output level"></meter></div><p class="ndc-key-hint">TYPE ANY KEY BELOW <span>·</span> <kbd>SHIFT</kbd> SOFTER <span>·</span> <kbd>SPACE</kbd> LOOP</p></div>
      <div class="ndc-keyboard" id="ndc-keyboard">{rows.map((row,i)=><div class={`ndc-key-row ndc-key-row--${i}`}><div class="ndc-row-label"><b>0{i+1}</b><span>{['DRUMS','BASS','MALLETS','CHORDS'][i]}</span></div><div class="ndc-key-row-pads">{row.map(pad=><button class="ndc-pad" data-pad={pad.id} data-family={i} style={`--pad-color:${pad.color}`} aria-label={`${pad.label}, key ${pad.key}`}><kbd>{pad.key}</kbd><span>{pad.label}</span><i aria-hidden="true"></i></button>)}</div></div>)}</div>
      <div class="ndc-keyboard-foot"><span><b>⌁</b> All tuned to C major / A minor. Follow your fingers.</span><button id="ndc-fill" class="ndc-text-button">Give me a little fill <b>↗</b></button></div>
      <p class="ndc-status" id="ndc-status" role="status" aria-live="polite">Tap a key or turn sound on to begin. Headphones welcome.</p>
    </section>

    <div class="ndc-lower">
      <section class="ndc-loop-panel" aria-labelledby="ndc-loop-title">
        <div class="ndc-section-heading"><div><p class="ndc-eyebrow">01 / MAKE IT GO AROUND</p><h2 id="ndc-loop-title">A beat to build on.</h2></div><span class="ndc-sticker" aria-hidden="true">LOOP<br/>DE LOOP</span></div>
        <div class="ndc-loop-tools"><button id="ndc-play" class="ndc-button ndc-button--ink" aria-pressed="false">▶ Play loop</button><button id="ndc-record" class="ndc-button" aria-pressed="false">● Overdub</button><label class="ndc-tempo"><input id="ndc-tempo" type="number" min="60" max="180" value="108" aria-label="Tempo in beats per minute"/><span>BPM</span></label><label class="ndc-swing">Swing <input id="ndc-swing" type="range" min="0" max="50" value="12" aria-label="Swing amount"/></label></div>
        <div class="ndc-presets" aria-label="Starter beats"><button data-preset="clubhouse" aria-pressed="true">Clubhouse bounce</button><button data-preset="parade" aria-pressed="false">Noun parade</button><button data-preset="moonwalk" aria-pressed="false">Moonwalk</button><button id="ndc-clear">Blank canvas</button></div>
        <div class="ndc-sequencer-scroll" tabindex="0" role="region" aria-label="16-step beat grid, scroll sideways on small screens"><div id="ndc-sequencer" class="ndc-sequencer"></div></div>
        <div class="ndc-loop-footer"><label>Add a sound <select id="ndc-add-lane" aria-label="Add sound to loop"><option value="">Choose a sound…</option>{PAD_DEFINITIONS.map(pad=><option value={pad.id}>{pad.key} · {pad.label}</option>)}</select></label><button id="ndc-copy-beat" class="ndc-text-button">Copy beat link ↗</button></div>
        <p class="ndc-small">Your loop plays on this device. Share its link so a friend can remix it. Overdub catches your playing on the nearest step.</p>
      </section>
      <aside class="ndc-room-panel" aria-labelledby="ndc-room-title">
        <p class="ndc-eyebrow">02 / BETTER WITH FRIENDS</p><h2 id="ndc-room-title">Bring the band.</h2><p>Meet in the same room. Hear each other’s keys. Find something good together.</p>
        <form id="ndc-room-form"><label for="ndc-room-code">ROOM NAME</label><div class="ndc-room-input"><input id="ndc-room-code" name="room" value="sunshine" maxlength="24" pattern="[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,22}[a-zA-Z0-9])?" autocomplete="off" spellcheck="false" required aria-describedby="ndc-room-hint"/><button id="ndc-join" type="submit">Join ↗</button></div></form>
        <p class="ndc-small" id="ndc-room-hint">Anyone with the room name can join.</p><div class="ndc-room-presence"><span class="ndc-dot" id="ndc-room-dot"></span><strong id="ndc-room-status" role="status">Solo session</strong><button id="ndc-leave" hidden>Leave</button></div>
        <div id="ndc-people" class="ndc-people" aria-label="People connected to this room"></div>
        <div class="ndc-room-actions"><button id="ndc-invite" class="ndc-button">Copy room invite ↗</button><button id="ndc-new-room" class="ndc-text-button">New room</button></div>
        <div class="ndc-reactions" aria-label="Send a room reaction"><span>A LITTLE APPLAUSE</span>{['✦','♥','🔥','🪩'].map(emoji=><button data-reaction={emoji} aria-label={`Send ${emoji} reaction`}>{emoji}</button>)}</div>
        <p class="ndc-small">No account. No microphone. Just notes over the internet. A little network delay is part of the jam.</p>
      </aside>
    </div>
    <section class="ndc-guide" id="ndc-guide" aria-label="How to play"><div><span>01</span><h3>Find your sound.</h3><p>Numbers are drums. Q–P is bass. A–L adds mallets. Z–M brings chords. Tap the pads on a phone.</p></div><div><span>02</span><h3>Leave a little space.</h3><p>Start a loop, add a few notes, then listen. Turn on Overdub to collect what you play. Escape stops the loop.</p></div><div><span>03</span><h3>Pass it around.</h3><p>Copy a room invite to play live with friends, or a beat link to share your composition. Sound starts only when you choose.</p></div></section>
    <footer class="ndc-footer"><a href="/nouns/">⌐◨-◨ &nbsp; MORE NOUNS, PLEASE ↗</a><span>AN OPEN LITTLE MUSIC CLUB BY POINTCAST</span><a href="/nouns-drum-club.json">THE FIELD GUIDE ↗</a></footer>
    <noscript><p class="ndc-status">This instrument needs JavaScript to make sound and connect a room. The keyboard guide above is available to read.</p></noscript>
  </main>
  <script>import '../../lib/nouns-drum-club-ui';</script>
</BlockLayout>
