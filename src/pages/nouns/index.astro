---
import BlockLayout from '../../layouts/BlockLayout.astro';
const experiences = [
  { title: 'Nouns Drum Club', href: '/nouns/drum-club/', note: 'Full keyboard · shared live rooms · loops', noun: 23, featured: true },
  { title: 'Nouns Memory v2', href: '/nouns-memory-v2', note: 'Windows 95 pairs', noun: 37 },
  { title: 'Nouns Mines v2', href: '/nouns-mines-v2', note: 'Field logic', noun: 36 },
  { title: 'Nouns Pyramid v2', href: '/nouns-pyramid-v2', note: 'Thirteen-card solitaire', noun: 22 },
  { title: 'Nouns Cola Crush', href: '/nouns-cola-crush', note: 'Match three', noun: 34 },
  { title: 'Wood Chop Commons', href: '/nouns-wood-chop', note: 'Collect loop', noun: 20 },
];
---
<BlockLayout title="Nouns — playful rooms" description="A small directory of PointCast rooms where real Nouns artwork becomes an instrument, game, helper, or witness." image="/images/og-nouns-drum-club.png" themeColor="#e65a45" showNetworkStrip={false}>
  <main class="nouns-index">
    <header><a href="/">POINTCAST</a><span>NOUNS / ROOMS</span><a href="/nouns-drum-club.json">JSON ↗</a></header>
    <section class="hero"><div><p class="eyebrow">CC0 CHARACTER SET · POINTCAST PLAY LAYER</p><h1>Nouns<br /><em>in the room.</em></h1><p>Small browser experiences with a real Noun at the center: games, loops, and shared places to show up.</p><a class="enter" href="/nouns/drum-club/">Enter the Drum Club ↗</a><a class="bandmates-link" href="/nouns/drum-club/bandmates/">Meet the Drum Club bandmates ↗</a></div><img src="/games/nouns-nation-battler/assets/noun-23.svg" alt="Noun 23" width="260" height="260" /></section>
    <section class="grid" aria-label="Nouns experiences">{experiences.map((item) => <a class:list={['card', { featured: item.featured }]} href={item.href}><img src={`/games/nouns-nation-battler/assets/noun-${item.noun}.svg`} alt={`Noun ${item.noun}`} width="82" height="82" loading="lazy" /><div><strong>{item.title}</strong><span>{item.note}</span></div>{item.featured && <b>NEW</b>}</a>)}</section>
  </main>
</BlockLayout>
<style>
  :global(body){background:#fbf2df;color:#17151b}.nouns-index{max-width:1120px;margin:auto;padding:18px 4vw 90px}.nouns-index header{display:flex;gap:24px;align-items:center;border-bottom:2px solid #17151b;padding:12px 0;font:700 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em}.nouns-index header a:first-child{margin-right:auto;color:#e65a45}.nouns-index header a{color:inherit;text-decoration:none}.hero{display:grid;grid-template-columns:1fr 300px;gap:32px;align-items:center;padding:clamp(54px,10vw,120px) 0 70px}.eyebrow{font:700 11px/1.2 'JetBrains Mono',monospace;letter-spacing:.12em}.hero h1{margin:14px 0 22px;font:700 clamp(70px,12vw,150px)/.78 'Syne',sans-serif;letter-spacing:-.07em}.hero h1 em{color:#7256bd;font-style:normal}.hero p:not(.eyebrow){max-width:42ch;font:500 20px/1.35 'Lora',serif}.hero img{width:100%;height:auto;background:#f2c63e;border:2px solid #17151b}.enter,.card{color:#17151b}.enter{display:inline-block;margin-top:12px;padding:14px 17px;background:#e65a45;border:2px solid #17151b;text-decoration:none;font:700 12px/1 'JetBrains Mono',monospace}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.card{position:relative;display:flex;gap:16px;align-items:center;padding:18px;background:#fffaf0;border:2px solid #17151b;text-decoration:none;min-height:112px}.card img{width:82px;height:82px;object-fit:contain}.card strong,.card span{display:block}.card strong{font:700 23px/.95 'Syne',sans-serif}.card span{margin-top:8px;font:700 10px/1.3 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.06em}.card b{position:absolute;right:12px;top:12px;color:#7256bd;font:700 10px/1 'JetBrains Mono',monospace}@media(max-width:700px){.hero{grid-template-columns:1fr;padding-top:54px}.hero img{max-width:230px}.grid{grid-template-columns:1fr}}
</style>
<style>.bandmates-link{display:block;margin-top:16px;color:#7256bd;font:700 11px/1.3 'JetBrains Mono',monospace;text-decoration:underline;text-underline-offset:4px}</style>
