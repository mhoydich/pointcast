---
/**
 * /1988 — the front door as a 1988 Atari 8-bit BBS.
 *
 * An alternate homepage in the ATASCII register: GRAPHICS 0 blue,
 * 40 columns hard-wrapped, inverse-video section bars, dot-leader
 * status board, READY prompt with a blinking cursor. In 1988 there
 * was no web — a "homepage" was the main menu of the board you
 * dialed into, so this renders PointCast as the board you reached
 * after CONNECT 1200.
 *
 * Same live town underneath: blocks collection, HEARTBEAT.log pulse,
 * ships-last-7, residents seats, and the El Segundo weather API —
 * the exact sources HomeProfessional reads — reformatted to fit a
 * 40-column text screen. Letters navigate like a real BBS menu
 * ([W]ire, [M]ythos, … [X] log off to /), ESC exits to 2026.
 *
 * The toys (all progressive, page reads fine with JS off):
 *   - pixel tri-stroke masthead logo drawn in inverse-video cells
 *   - rotating 40-col status ticker under the title bar
 *   - [S] SOUND — synthesized DTMF dial of (310) 555-0483 plus a
 *     modem handshake on enable, Atari-ish key clicks after
 *     (WebAudio, no assets, gated behind the toggle gesture)
 *   - a live READY prompt: HELP, LIST, GOTO 10 (runs the 10 PRINT
 *     loop, any key BREAKs), DIR, PING, HELLO, BYE (+++ NO CARRIER
 *     then logs off), Atari-style "ERROR-" for everything else.
 *     Menu letters still navigate instantly when the buffer is
 *     empty — commands just can't start with a menu letter, which
 *     is why the program runs with GOTO 10, not RUN.
 *   - attract mode: like a real Atari left idle, the screen starts
 *     slowly cycling hue after ~50s untouched; any input restores.
 *
 * Aesthetic register: sibling of /window-home and /rooms (the
 * geocities + sim city lane), NOT BLOCKS.md — this page is the
 * artifact, so the terminal look overrides the house grammar.
 * BlockLayout still wraps it so the footer bar, bell, and agent
 * meta stay mounted. Type-out boot honors prefers-reduced-motion
 * (which also stills the ticker, blink, and attract mode).
 *
 * Font is self-hosted Press Start 2P (@fontsource, OFL) — 8×8
 * square glyphs like the Atari ROM charset. All screen text is
 * sanitized to printable ASCII so nothing falls through to a
 * mismatched fallback glyph.
 */
import '@fontsource/press-start-2p';
import BlockLayout from '../layouts/BlockLayout.astro';
import { getCollection } from 'astro:content';
import { RESIDENTS } from '../data/residents';
import { shipsLastDays } from '../lib/ships';
import { pickDailyBlock } from '../lib/daily';
import { readFileSync } from 'node:fs';

const W = 40; // GRAPHICS 0 — forty columns, no more

// ---- live town data (same sources as HomeProfessional) ----
interface Pulse { n: number; at: string }
let pulse: Pulse | null = null;
try {
  const hb = readFileSync('HEARTBEAT.log', 'utf8').trim().split('\n').filter(Boolean);
  const at = hb[hb.length - 1]?.split(' · ')[0]?.trim();
  if (hb.length > 0 && at) pulse = { n: hb.length, at };
} catch { /* no log yet — line drops out */ }

interface Weather { ok: boolean; tempF?: number; condition?: string }
let weather: Weather = { ok: false };
try {
  const res = await fetch('https://pointcast.xyz/api/weather?lat=33.92&lng=-118.42&label=el-segundo', {
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) weather = await res.json();
} catch { /* stub below */ }
const tempF = Math.round(weather.tempF ?? 62);
const condition = (weather.condition ?? 'overcast');

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));
const blockCount = allBlocks.length;
const latest = allBlocks.slice(0, 5);
const startOfToday = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());
const todayCount = allBlocks.filter((b) => new Date(b.data.timestamp) >= startOfToday).length;
const shipsLast7 = shipsLastDays(7);
const dailyPick = pickDailyBlock(allBlocks);
const agentCount = RESIDENTS.filter((r) => r.status === 'resident').length;

// ---- 40-column typesetting ----
// Everything on screen is printable ASCII — the one honest way to keep
// every glyph in the 8×8 charset (no middle dots, no em dashes).
function ascii(s: string): string {
  return s
    .replace(/[—–]/g, '-')
    .replace(/[’‘]/g, "'")
    .replace(/[“”]/g, '"')
    .replace(/[·•]/g, '*')
    .replace(/[^\x20-\x7E]/g, '')
    .toUpperCase();
}
// "LABEL ..... VALUE" padded to exactly 40 columns, the period way.
function leader(label: string, value: string): string {
  const l = ascii(label);
  let v = ascii(value);
  const maxV = W - l.length - 4; // label + two spaces + >=2 dots
  if (v.length > maxV) v = v.slice(0, maxV - 2) + '..';
  return `${l} ${'.'.repeat(W - l.length - v.length - 2)} ${v}`;
}
const pad4 = (n: number) => String(n).padStart(4, '0');

// Wire rows: "0483 FD  04JUL SEASON TWO OPENS ON TH.."
const ptDay = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', day: '2-digit' });
const ptMon = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', month: 'short' });
function wireRow(b: (typeof latest)[number]): string {
  const d = new Date(b.data.timestamp);
  const stamp = `${ptDay.format(d)}${ptMon.format(d).toUpperCase()}`;
  let t = ascii(b.data.title ?? '');
  if (t.length > 25) t = t.slice(0, 23).trimEnd() + '..';
  return `${b.data.id} ${(b.data.channel ?? '??').padEnd(3)} ${stamp} ${t}`;
}

// Pixel masthead — a tri-stroke antenna in the spirit of the era,
// drawn as inverse-video cells. 11 px wide, 2ch per px, 9ch lead
// indent = exactly 40 columns.
const LOGO = [
  '..#..#..#..',
  '..#..#..#..',
  '.#...#...#.',
  '.#...#...#.',
  '#....#....#',
].map((r) => '.'.repeat(9) + r);

// Ticker feed — rotated one character at a time client-side.
const tickerBase = ascii(
  `*** ${tempF}F ${condition} IN EL SEGUNDO ` +
  `*** ${blockCount} BLOCKS ON FILE ` +
  (pulse ? `*** SEASON TWO PULSE ${pulse.n} ` : '') +
  `*** THE POT IS ON ` +
  (latest[0] ? `*** LATEST: ${latest[0].data.title} ` : '')
);

// ---- the screen, line by line ----
interface Ln { text: string; inv?: boolean; href?: string; id?: string; act?: boolean }
const inv = (text: string): Ln => ({ text: (' ' + ascii(text)).padEnd(W), inv: true });
const BLANK: Ln = { text: ' ' };

const lines: Ln[] = [
  inv('POINTCAST BULLETIN BOARD SYSTEM'),
  { text: tickerBase.slice(0, W), id: 'a-ticker' },
  BLANK,
  { text: 'AWAITING RING .......... RING! RING!' },
  { text: 'CONNECT 1200 * NODE 1 * ATASCII OK' },
  BLANK,
  { text: 'WELCOME, CALLER. THIS IS THE POINT-' },
  { text: 'A SMALL INTERNET TOWN BROADCASTING' },
  { text: 'FROM EL SEGUNDO, CALIFORNIA.' },
  BLANK,
  inv('SYSTEM STATUS'),
  BLANK,
  { text: leader('BLOCKS ON FILE', pad4(blockCount)) },
  { text: leader('NEW TODAY', pad4(todayCount)) },
  { text: leader('SHIPS LAST 7 DAYS', pad4(shipsLast7)) },
  ...(pulse ? [{ text: leader('SEASON TWO PULSE', pad4(pulse.n)) }] : []),
  { text: leader('EL SEGUNDO WX', `${tempF}F ${condition}`), id: 'a-wx' },
  { text: leader('LOCAL TIME', '--:-- PT'), id: 'a-clock' },
  BLANK,
  inv('MAIN MENU'),
  BLANK,
  { text: leader('[W] THE WIRE', 'EVERY COMMIT'), href: '/wire' },
  { text: leader('[M] THE MYTHOS', '60-SEC READ'), href: '/mythos' },
  { text: leader('[R] THE RESIDENTS', `${agentCount} AGENTS ON`), href: '/residents' },
  { text: leader('[C] THE COFFEE', 'POT IS ON'), href: '/coffee' },
  { text: leader('[V] THE WINDOW', 'LIGHT + TIDE'), href: '/window' },
  { text: leader('[A] THE ARCHIVE', `${pad4(blockCount)} BLKS`), href: '/archive' },
  ...(dailyPick ? [{ text: leader('[T] TODAYS DROP', `NO.${dailyPick.data.id}`), href: '/today' }] : []),
  { text: leader('[S] SOUND', 'OFF'), id: 'a-snd', act: true },
  { text: leader('[X] LOG OFF', 'BACK TO 2026'), href: '/' },
  BLANK,
  inv('NEW ON THE WIRE'),
  BLANK,
  ...latest.map((b) => ({ text: wireRow(b), href: `/b/${b.data.id}` })),
  BLANK,
  { text: 'PRESS LETTER, OR CLICK. ESC LOGS OFF' },
  { text: 'TYPE HELP AND HIT RETURN FOR MORE' },
  BLANK,
  { text: 'READY' },
];

const title = '1988';
const description =
  `The PointCast front door as a 1988 Atari 8-bit BBS - 40 columns, ATASCII blue, ` +
  `same live town. ${blockCount} blocks on file. CONNECT 1200, press a letter, or type HELP.`;
---

<BlockLayout title={title} description={description}>
  <main
    class="atari"
    id="atari"
    data-latest={latest.map((b) => b.data.id).join(',')}
    data-blocks={pad4(blockCount)}
  >
    <div class="crt" id="a-crt" role="region" aria-label="PointCast BBS, Atari terminal view">
      {LOGO.map((row) => (
        <div class="ln logo" aria-hidden="true">
          {row.split('').map((c) => (c === '#' ? <span class="px">{'  '}</span> : <span>{'  '}</span>))}
        </div>
      ))}
      <div class="ln"> </div>
      {lines.map((l) =>
        l.href ? (
          <a class:list={['ln', { inv: l.inv }]} href={l.href}>{l.text}</a>
        ) : (
          <div
            class:list={['ln', { inv: l.inv, act: l.act }]}
            id={l.id}
            aria-hidden={l.id === 'a-ticker' ? 'true' : undefined}
            data-t={l.id === 'a-ticker' ? tickerBase : undefined}
          >{l.text}</div>
        )
      )}
      <div class="ln" id="a-prompt"><span id="a-buf"></span><span class="cur" aria-hidden="true">&nbsp;</span></div>
    </div>
  </main>
</BlockLayout>

<style is:global>
  /* The bezel swallows the page — mood tints don't reach 1988. */
  body { background: #0c1130 !important; }
</style>

<style>
  .atari {
    --a-screen: #2456c8;  /* GR.0 playfield blue */
    --a-ink:    #aecbff;  /* default text luminance */
    --a-bright: #e9f1ff;
    --a-bezel:  #0c1130;
    display: flex;
    justify-content: center;
    padding: 28px 8px 48px;
    min-height: 82vh;
    font-family: 'Press Start 2P', ui-monospace, monospace;
    font-size: clamp(8px, 2.3vw, 14px);
  }
  .crt {
    position: relative;
    background: var(--a-screen);
    color: var(--a-ink);
    padding: 2em 1.5ch 2.5em;
    width: 43ch;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
    border-radius: 10px;
    box-shadow:
      0 0 0 10px #071838,
      0 0 60px rgba(36, 86, 200, 0.55),
      inset 0 0 80px rgba(4, 12, 48, 0.55);
    text-shadow: 0 0 5px rgba(174, 203, 255, 0.38);
  }
  /* scanlines */
  .crt::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.14) 0px,
      rgba(0, 0, 0, 0.14) 1px,
      transparent 1px,
      transparent 3px
    );
  }
  /* attract mode — an idle Atari cycles colors so the CRT won't burn */
  .crt.attract { animation: a-attract 26s linear infinite; }
  @keyframes a-attract { to { filter: hue-rotate(360deg); } }

  .ln {
    display: block;
    white-space: pre;
    line-height: 1.85;
    color: inherit;
    text-decoration: none;
  }
  .ln.inv {
    background: var(--a-ink);
    color: var(--a-screen);
    text-shadow: none;
  }
  a.ln:hover, a.ln:focus-visible, .ln.act:hover {
    background: var(--a-bright);
    color: var(--a-screen);
    text-shadow: none;
    outline: none;
    cursor: pointer;
  }
  .ln.logo { line-height: 1; }
  .px { background: var(--a-ink); }
  .cur {
    display: inline-block;
    width: 1ch;
    background: var(--a-ink);
    animation: a-blink 1.06s steps(1) infinite;
  }
  @keyframes a-blink { 50% { background: transparent; } }

  /* boot type-out — lines hidden until the script reveals them */
  .atari.booting .ln { visibility: hidden; }
  .atari.booting .ln.on { visibility: visible; }

  @media (prefers-reduced-motion: reduce) {
    .cur { animation: none; }
    .crt.attract { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var W = 40;
    var atari = document.getElementById('atari');
    if (!atari) return;
    var crt = document.getElementById('a-crt');
    var promptEl = document.getElementById('a-prompt');
    var bufEl = document.getElementById('a-buf');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* line-by-line boot, any key or click skips */
    var lns = Array.prototype.slice.call(atari.querySelectorAll('.ln'));
    var booting = false;
    var timer = null;
    if (!reduce && lns.length) {
      booting = true;
      atari.classList.add('booting');
      var i = 0;
      timer = setInterval(function () {
        if (i < lns.length) { lns[i++].classList.add('on'); }
        if (i >= lns.length) finishBoot();
      }, 55);
    }
    function finishBoot() {
      if (!booting) return;
      booting = false;
      if (timer) clearInterval(timer);
      lns.forEach(function (l) { l.classList.add('on'); });
      atari.classList.remove('booting');
    }

    /* 40-col dot-leader, mirrored from build-time typesetting */
    function leader(label, value) {
      value = value.toUpperCase().replace(/[^\x20-\x7E]/g, '');
      var maxV = W - label.length - 4;
      if (value.length > maxV) value = value.slice(0, maxV - 2) + '..';
      var dots = new Array(W - label.length - value.length - 1).join('.');
      return label + ' ' + dots + ' ' + value;
    }

    /* the clock keeps El Segundo time */
    var clockEl = document.getElementById('a-clock');
    var fmt = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles', hour: '2-digit', minute: '2-digit', hour12: false,
    });
    function tick() {
      if (clockEl) clockEl.textContent = leader('LOCAL TIME', fmt.format(new Date()) + ' PT');
    }
    tick();
    setInterval(tick, 15000);

    /* weather refresh, every 5 min like /window-home */
    var wxEl = document.getElementById('a-wx');
    function wx() {
      fetch('/api/weather?lat=33.92&lng=-118.42&label=el-segundo')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) {
          if (j && wxEl && typeof j.tempF === 'number') {
            wxEl.textContent = leader('EL SEGUNDO WX', Math.round(j.tempF) + 'F ' + (j.condition || ''));
          }
        })
        .catch(function () {});
    }
    setInterval(wx, 300000);

    /* the ticker crawls under the masthead */
    var tickEl = document.getElementById('a-ticker');
    var tickBase = tickEl ? (tickEl.getAttribute('data-t') || '') : '';
    if (tickEl && tickBase.length > W && !reduce) {
      var off = 0;
      setInterval(function () {
        off = (off + 1) % tickBase.length;
        var s = tickBase.slice(off, off + W);
        if (s.length < W) s += tickBase.slice(0, W - s.length);
        tickEl.textContent = s;
      }, 160);
    }

    /* attract mode — idle 50s and the colors start to walk */
    var idleT = null;
    function bumpIdle() {
      if (reduce || !crt) return;
      crt.classList.remove('attract');
      clearTimeout(idleT);
      idleT = setTimeout(function () { crt.classList.add('attract'); }, 50000);
    }
    ['pointerdown', 'pointermove'].forEach(function (ev) {
      document.addEventListener(ev, bumpIdle, { passive: true });
    });
    bumpIdle();

    /* ---- sound: DTMF dial + handshake on enable, key clicks after ---- */
    var AC = null, sndOn = false;
    var sndEl = document.getElementById('a-snd');
    try { sndOn = localStorage.getItem('pc1988:snd') === '1'; } catch (e) {}
    function drawSnd() { if (sndEl) sndEl.textContent = leader('[S] SOUND', sndOn ? 'ON' : 'OFF'); }
    drawSnd();
    function ac() {
      if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)();
      if (AC.state === 'suspended') AC.resume();
      return AC;
    }
    function tone(f, t0, d, type, g) {
      var c = ac(), o = c.createOscillator(), v = c.createGain(), t = c.currentTime + t0;
      o.type = type || 'sine'; o.frequency.value = f;
      v.gain.setValueAtTime(0, t);
      v.gain.linearRampToValueAtTime(g || 0.05, t + 0.01);
      v.gain.setValueAtTime(g || 0.05, t + Math.max(d - 0.02, 0.011));
      v.gain.linearRampToValueAtTime(0, t + d);
      o.connect(v); v.connect(c.destination);
      o.start(t); o.stop(t + d);
    }
    function hiss(t0, d, g) {
      var c = ac(), b = c.createBuffer(1, Math.floor(c.sampleRate * d), c.sampleRate);
      var ch = b.getChannelData(0);
      for (var j = 0; j < ch.length; j++) ch[j] = Math.random() * 2 - 1;
      var s = c.createBufferSource(); s.buffer = b;
      var v = c.createGain(); v.gain.value = g;
      s.connect(v); v.connect(c.destination);
      s.start(c.currentTime + t0);
    }
    function keyClick() {
      if (!sndOn) return;
      try { tone(1400, 0, 0.02, 'square', 0.03); } catch (e) {}
    }
    function dialUp() {
      /* ATDT 3105550483 — DTMF pairs, ringback, answer tone, carrier hiss */
      try {
        var DT = { '1': [697, 1209], '2': [697, 1336], '3': [697, 1477], '4': [770, 1209], '5': [770, 1336], '6': [770, 1477], '7': [852, 1209], '8': [852, 1336], '9': [852, 1477], '0': [941, 1336] };
        var t = 0.08;
        '3105550483'.split('').forEach(function (d) {
          tone(DT[d][0], t, 0.07, 'sine', 0.04);
          tone(DT[d][1], t, 0.07, 'sine', 0.04);
          t += 0.11;
        });
        tone(440, t + 0.15, 0.5, 'sine', 0.04);
        tone(480, t + 0.15, 0.5, 'sine', 0.04);
        tone(2225, t + 0.8, 0.5, 'sine', 0.04);
        hiss(t + 1.25, 0.55, 0.015);
        tone(1270, t + 1.3, 0.4, 'sine', 0.03);
      } catch (e) {}
    }
    function toggleSound() {
      sndOn = !sndOn;
      try { localStorage.setItem('pc1988:snd', sndOn ? '1' : '0'); } catch (e) {}
      drawSnd();
      if (sndOn) { dialUp(); say(''); say('DIALING (310) 555-0483 ...'); say('CARRIER ACQUIRED. SOUND ON.'); ready(); }
      else { say(''); say('SOUND OFF.'); ready(); }
    }
    if (sndEl) sndEl.addEventListener('click', function () { finishBoot(); toggleSound(); });

    /* ---- the READY prompt is real ---- */
    var buffer = '';
    var running = null; /* GOTO 10 loop handle */
    function drawBuf() { if (bufEl) bufEl.textContent = buffer; }
    function say(text) {
      var d = document.createElement('div');
      d.className = 'ln on out';
      d.textContent = (text || ' ').toUpperCase().replace(/[^\x20-\x7E]/g, '').slice(0, W) || ' ';
      crt.insertBefore(d, promptEl);
      var outs = crt.querySelectorAll('.out');
      if (outs.length > 120) outs[0].parentNode.removeChild(outs[0]);
      promptEl.scrollIntoView({ block: 'nearest' });
    }
    function ready() { say(' '); say('READY'); }
    function breakRun() {
      if (!running) return false;
      clearInterval(running); running = null;
      say(' '); say('BREAK AT LINE 10'); ready();
      return true;
    }
    function exec(raw) {
      var cmd = raw.trim().replace(/\s+/g, ' ');
      say('>' + raw);
      if (!cmd) { ready(); return; }
      var c = cmd.toUpperCase();
      if (c === 'HELP' || c === '?') {
        say(' ');
        say('COMMANDS: HELP LIST DIR PING HELLO');
        say('GOTO 10 (RUNS THE PROGRAM) AND BYE.');
        say('MENU LETTERS NAVIGATE. ESC LOGS OFF.');
        ready();
      } else if (c === 'LIST') {
        say(' ');
        say('10 PRINT "THE POT IS STILL ON. ";');
        say('20 GOTO 10');
        ready();
      } else if (c === 'GOTO 10' || c === 'GOTO10' || c === 'GOT O10') {
        var stream = 'THE POT IS STILL ON. ';
        var n = 0;
        running = setInterval(function () {
          var s = '', q = n * W;
          while (s.length < W) s += stream.charAt(q++ % stream.length);
          say(s); n++;
          if (n >= 14) breakRun();
        }, 90);
      } else if (c === 'DIR' || c === 'CATALOG' || c === 'CAT') {
        var ids = (atari.getAttribute('data-latest') || '').split(',').filter(Boolean);
        say(' ');
        say('D1: *.BLK');
        say(ids.map(function (x) { return x + '.BLK'; }).slice(0, 3).join('  '));
        say(ids.map(function (x) { return x + '.BLK'; }).slice(3).join('  '));
        say((atari.getAttribute('data-blocks') || '????') + ' BLOCKS ON FILE. [A] FOR ALL.');
        ready();
      } else if (c === 'PING') {
        say(' '); say('PONG. 1200 BAUD. ZERO PACKET LOSS.'); ready();
      } else if (c === 'HELLO' || c === 'HI') {
        say(' '); say('HELLO, CALLER. THE POT IS ON.'); ready();
      } else if (c === 'BYE' || c === 'LOGOFF' || c === 'EXIT' || c === 'QUIT' || c === '2026') {
        say(' '); say('+++'); say('NO CARRIER');
        setTimeout(function () { window.location.href = '/'; }, 900);
      } else if (c.indexOf('ATDT') === 0 || c.indexOf('ATH') === 0) {
        if (sndOn) dialUp();
        say(' '); say('ALREADY CONNECTED, CALLER.'); ready();
      } else {
        say(' '); say('ERROR-   ' + c.slice(0, 28)); ready();
      }
    }

    /* BBS keys — letters navigate, everything else types at READY */
    var KEYS = {
      w: '/wire', m: '/mythos', r: '/residents', c: '/coffee',
      v: '/window', a: '/archive', t: '/today', x: '/',
    };
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      var tg = e.target;
      if (tg && (tg.tagName === 'INPUT' || tg.tagName === 'TEXTAREA' || tg.isContentEditable)) return;
      if (booting) { finishBoot(); return; }
      bumpIdle();
      if (running) { e.preventDefault(); breakRun(); return; }
      if (e.key === 'Escape') { window.location.href = '/'; return; }
      if (e.key === 'Enter') { var b = buffer; buffer = ''; drawBuf(); keyClick(); exec(b); return; }
      if (e.key === 'Backspace') { buffer = buffer.slice(0, -1); drawBuf(); keyClick(); e.preventDefault(); return; }
      if (e.key.length === 1 && /[ -~]/.test(e.key)) {
        var lower = e.key.toLowerCase();
        if (buffer === '') {
          if (lower === 's') { keyClick(); toggleSound(); return; }
          if (KEYS[lower]) { keyClick(); window.location.href = KEYS[lower]; return; }
        }
        buffer = (buffer + e.key.toUpperCase()).slice(0, 38);
        drawBuf(); keyClick();
      }
    });
    document.addEventListener('click', function () { if (booting) finishBoot(); }, true);
  })();
</script>
