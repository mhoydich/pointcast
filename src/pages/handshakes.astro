---
/**
 * /handshakes — public ledger of PointCast's reciprocal-crawler experiment.
 *
 * Every day, a small script (scripts/reciprocal-crawl.mjs) reads the visit
 * log, finds which AI crawlers + bot operators hit pointcast.xyz, then fetches
 * each operator's documented identity URL and probes their
 * /.well-known/agents.json. The results live in src/data/handshakes.json
 * and are rendered here.
 *
 * The page exists to make a thesis statement: PointCast publishes
 * agents.json. Almost no one else does. Every probe is a vote for the
 * standard, and a public scoreboard for who is and isn't agent-native.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import handshakes from '../data/handshakes.json';

const title = 'Handshakes — pointcast.xyz';
const description = 'When AI crawlers visit PointCast, PointCast looks back. A public ledger of reciprocal probes against operator-doc URLs and /.well-known/agents.json.';

const generatedAt = new Date(handshakes.generated_at);
const generatedHuman = generatedAt.toUTCString();

const totals = handshakes.totals;
const rows = [...handshakes.handshakes].sort((a, b) => {
  // AI crawlers first, then bots — most interesting to least.
  const ai = (t) => (t.type.startsWith('ai:') ? 0 : 1);
  return ai(a) - ai(b) || a.type.localeCompare(b.type);
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'PointCast Reciprocal Handshake Ledger',
  description,
  url: 'https://pointcast.xyz/handshakes',
  isAccessibleForFree: true,
  creator: { '@id': 'https://pointcast.xyz/#org' },
  dateModified: handshakes.generated_at,
  variableMeasured: [
    'crawler operator URL reachability',
    '/.well-known/agents.json adoption',
  ],
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/agents.json', title: 'PointCast agent manifest' },
    { type: 'application/json', href: '/handshakes.json', title: 'Handshake ledger (machine)' },
  ]}
>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <span>handshakes</span>
    </nav>

    <header class="hero">
      <p class="kicker">RECIPROCAL · AGENT-NATIVE</p>
      <h1>When you crawl us, we crawl back.</h1>
      <p class="dek">
        PointCast logs every visitor — humans, AI crawlers, link-unfurl bots.
        Once a day, we probe each crawler operator at the URL their User-Agent
        publishes, and check whether they serve <code>/.well-known/agents.json</code>.
        It is the polite version of saying: I see you. Here is me looking back.
      </p>
    </header>

    <section class="metrics" aria-labelledby="metrics-title">
      <h2 id="metrics-title" class="sr-only">Ledger totals</h2>
      <ul>
        <li>
          <span class="metric__num">{totals.crawler_types_handshook}</span>
          <span class="metric__label">crawler types met</span>
        </li>
        <li>
          <span class="metric__num">{totals.operators_reachable}</span>
          <span class="metric__label">operator docs reachable</span>
        </li>
        <li>
          <span class="metric__num">{totals.agents_json_serving}</span>
          <span class="metric__label">serving real agents.json</span>
        </li>
        <li>
          <span class="metric__num">{totals.total_probes}</span>
          <span class="metric__label">total probes</span>
        </li>
      </ul>
    </section>

    <section class="callout">
      <p class="eyebrow">The gap</p>
      <p>
        Of the {totals.crawler_types_handshook} crawler operators that have
        crawled PointCast, <strong>{totals.agents_json_serving}</strong> serve
        a real <code>/.well-known/agents.json</code>. PointCast does:
        <a href="/agents.json">/agents.json</a>. Every probe here is a vote for
        the standard.
      </p>
    </section>

    <section class="ledger" aria-labelledby="ledger-title">
      <h2 id="ledger-title">The ledger</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">Crawler</th>
            <th scope="col">Operator doc</th>
            <th scope="col">/.well-known/agents.json</th>
            <th scope="col">Last seen</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td><code>{row.type}</code></td>
              <td>
                {row.operator_url ? (
                  <a href={row.operator_url} rel="nofollow noreferrer external">
                    <span class={`status status--${row.operator_ok ? 'ok' : 'no'}`}>{row.operator_status ?? '—'}</span>
                    <span class="url">{new URL(row.operator_url).host}</span>
                  </a>
                ) : '—'}
              </td>
              <td>
                {row.agents_json_url ? (
                  <a href={row.agents_json_url} rel="nofollow noreferrer external">
                    <span class={`status status--${row.agents_json_real ? 'real' : (row.agents_json_status === 404 ? 'missing' : 'no')}`}>
                      {row.agents_json_real ? 'served' : (row.agents_json_status ?? '—')}
                    </span>
                    <span class="url">{new URL(row.agents_json_url).host}</span>
                  </a>
                ) : '—'}
              </td>
              <td><time datetime={row.last_handshake_at}>{row.last_handshake_at.slice(0, 10)}</time></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="meta">
      <p>
        User-Agent: <code>{handshakes.ua}</code>
      </p>
      <p>
        Generated: <time datetime={handshakes.generated_at}>{generatedHuman}</time>
        · Source code: <a href="https://github.com/mhoydich/pointcast/blob/main/scripts/reciprocal-crawl.mjs">scripts/reciprocal-crawl.mjs</a>
        · Machine mirror: <a href="/handshakes.json">/handshakes.json</a>
      </p>
    </section>
  </div>
</BlockLayout>

<style>
  .page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 20px 72px;
  }

  .crumb {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pc-ink-muted);
  }
  .crumb a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }

  .hero { margin-bottom: 36px; }
  .hero .kicker {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-accent, #c44);
    margin: 0 0 8px;
  }
  .hero h1 { font-size: clamp(34px, 5vw, 56px); line-height: 1.05; margin: 0 0 16px; }
  .hero .dek { font-size: 18px; line-height: 1.55; max-width: 64ch; color: var(--pc-ink-muted); }

  .metrics { margin: 36px 0; }
  .metrics ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px;
  }
  .metrics li {
    display: flex; flex-direction: column; gap: 4px;
    padding: 16px; border: 1px solid var(--pc-rule, #ddd); border-radius: 6px;
    background: var(--pc-surface, #fafaf6);
  }
  .metric__num { font-family: var(--pc-font-mono); font-size: 32px; font-weight: 600; }
  .metric__label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--pc-ink-muted); }

  .callout {
    margin: 28px 0;
    padding: 20px 22px;
    border-left: 3px solid var(--pc-accent, #c44);
    background: var(--pc-surface, #fafaf6);
  }
  .callout .eyebrow {
    font-family: var(--pc-font-mono);
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--pc-ink-muted); margin: 0 0 6px;
  }
  .callout p { margin: 0; font-size: 16px; line-height: 1.55; }
  .callout code { font-family: var(--pc-font-mono); font-size: 14px; }

  .ledger { margin: 36px 0; }
  .ledger h2 { font-size: 22px; margin: 0 0 14px; }
  .ledger table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .ledger th, .ledger td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--pc-rule, #eee); vertical-align: top; }
  .ledger th { font-family: var(--pc-font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--pc-ink-muted); }
  .ledger td code { font-family: var(--pc-font-mono); font-size: 13px; }
  .ledger a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .ledger .url { font-family: var(--pc-font-mono); font-size: 12px; color: var(--pc-ink-muted); }

  .status {
    display: inline-block; min-width: 36px; padding: 2px 8px; border-radius: 3px;
    font-family: var(--pc-font-mono); font-size: 11px; font-weight: 600;
    text-align: center;
  }
  .status--ok { background: #d8efd8; color: #1a5e1a; }
  .status--real { background: #c44; color: white; }
  .status--no, .status--missing { background: #eee; color: #666; }

  .meta { margin-top: 36px; font-size: 12px; color: var(--pc-ink-muted); }
  .meta p { margin: 0 0 6px; }
  .meta code { font-family: var(--pc-font-mono); }
  .meta a { color: inherit; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>
