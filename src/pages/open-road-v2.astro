---
import BlockLayout from '../layouts/BlockLayout.astro';
import firstLight from '../assets/shrines/open-road-v2/a1-first-light.webp';
import greenShade from '../assets/shrines/open-road-v2/a2-green-shade.webp';
import pastelHorizon from '../assets/shrines/open-road-v2/a3-pastel-horizon.webp';
import modernHouse from '../assets/shrines/open-road-v2/a4-modern-house.webp';
import gardenRoad from '../assets/shrines/open-road-v2/a5-garden-road.webp';
import forestPrint from '../assets/shrines/open-road-v2/b1-forest-print.webp';
import emberHouse from '../assets/shrines/open-road-v2/b2-ember-house.webp';
import colorField from '../assets/shrines/open-road-v2/b3-color-field.webp';
import nightCollage from '../assets/shrines/open-road-v2/b4-night-collage.webp';
import redIcon from '../assets/shrines/open-road-v2/b5-red-icon.webp';

const title = 'Open Road II · Two Passages';
const description =
  'A two-part, one-minute image shrine made from ten 1955 Chevrolet paintings: five stations of first light and five stations of printed vespers.';

const passages = [
  {
    id: 'first-light',
    numeral: 'I',
    name: 'First Light',
    detail: 'five daylight stations',
    stations: [
      {
        id: 'threshold',
        title: 'Threshold',
        image: firstLight,
        alt: 'Yellow and cream 1955 Chevrolet before a pink, green, and white modernist house beneath a soft blue sky.',
        caption: 'Begin where color becomes a doorway.',
        prayerOne: 'Bless the first turn.',
        prayerTwo: 'Bless the courage to begin.',
      },
      {
        id: 'shade',
        title: 'Shade',
        image: greenShade,
        alt: 'Red and black two-tone 1955 Chevrolet beneath a broad green tree, with gold sky and dark mountains beyond.',
        caption: 'Rest beneath what asks nothing of you.',
        prayerOne: 'May shelter find you.',
        prayerTwo: 'May you offer it in return.',
      },
      {
        id: 'horizon',
        title: 'Horizon',
        image: pastelHorizon,
        alt: 'Yellow and pale blue 1955 Chevrolet against a gray house and hot-pink, ochre, and cream geometric fields.',
        caption: 'Let distance make the heart more spacious.',
        prayerOne: 'Let distance widen the heart.',
        prayerTwo: 'Let beauty slow the hand.',
      },
      {
        id: 'shelter',
        title: 'Shelter',
        image: modernHouse,
        alt: 'Peach and cream 1955 Chevrolet beneath a modernist house of red, yellow, blue, white, and stone planes.',
        caption: 'Form can be refuge. Motion can be grace.',
        prayerOne: 'May form become refuge.',
        prayerTwo: 'May movement become grace.',
      },
      {
        id: 'garden',
        title: 'Garden',
        image: gardenRoad,
        alt: 'Turquoise and yellow 1955 Chevrolet before weathered cyan, gold, and pink color fields.',
        caption: 'Carry one generous color into the day.',
        prayerOne: 'Carry the color forward.',
        prayerTwo: 'Leave the road more tender.',
      },
    ],
  },
  {
    id: 'vespers',
    numeral: 'II',
    name: 'Printed Vespers',
    detail: 'five evening stations',
    stations: [
      {
        id: 'wood',
        title: 'Wood',
        image: forestPrint,
        alt: 'High-contrast black-and-white print of a white 1955 Chevrolet among tall dark forest trunks.',
        caption: 'Enter what cannot yet be seen.',
        prayerOne: 'Enter what cannot be seen.',
        prayerTwo: 'Trust the quiet between trees.',
      },
      {
        id: 'ember',
        title: 'Ember',
        image: emberHouse,
        alt: 'Orange and pink 1955 Chevrolet before a shadowed house and trees rendered in fuchsia, green, gold, and black.',
        caption: 'Keep one bright thing. Release the rest.',
        prayerOne: 'Keep one bright thing.',
        prayerTwo: 'Let the rest become ash.',
      },
      {
        id: 'commons',
        title: 'Commons',
        image: colorField,
        alt: 'Turquoise and cream 1955 Chevrolet before a small civic building, repeated yellow cars, and a pink color-block border.',
        caption: 'Every crossing holds another life.',
        prayerOne: 'Travel among many lives.',
        prayerTwo: 'Make room at every crossing.',
      },
      {
        id: 'night-house',
        title: 'Night House',
        image: nightCollage,
        alt: 'Black and pink 1955 Chevrolet in a stippled courtyard of black, cream, and pale pink beneath a high arched roof.',
        caption: 'Silence keeps watch at the dark house.',
        prayerOne: 'Be still within the dark.',
        prayerTwo: 'Let silence keep watch.',
      },
      {
        id: 'emblem',
        title: 'Emblem',
        image: redIcon,
        alt: 'Red and white 1955 Chevrolet as a bold icon against turquoise, coral, yellow, and cream geometric fields.',
        caption: 'What endures may shine without noise.',
        prayerOne: 'May what endures shine plainly.',
        prayerTwo: 'May the journey become blessing.',
      },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v2',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={firstLight.src}
  jsonLd={jsonLd}
>
  <section
    class="or2"
    id="open-road-v2-shrine"
    aria-labelledby="or2-title"
    data-state="idle"
    data-phase="rest"
    data-passage="first-light"
    data-station="0"
  >
    <span class="or2__dove-cursor" id="or2-dove-cursor" aria-hidden="true">🕊︎</span>

    <a class="or2__exit" href="/" aria-label="Return to PointCast home">
      <span aria-hidden="true">←</span> PointCast
    </a>
    <a class="or2__edition-link" href="/open-road">Original shrine <span aria-hidden="true">↗</span></a>

    <div class="or2__sanctuary">
      <header class="or2__header">
        <p class="or2__seal" aria-hidden="true">II</p>
        <div>
          <p class="or2__eyebrow">A shrine for the open road</p>
          <h1 id="or2-title">Two passages. Five breaths each.</h1>
        </div>
      </header>

      <div class="or2__passages" role="group" aria-label="Choose an image passage">
        {passages.map((passage, passageIndex) => (
          <button
            type="button"
            class:list={['or2__passage', { 'is-active': passageIndex === 0 }]}
            data-passage-select={passage.id}
            aria-pressed={passageIndex === 0 ? 'true' : 'false'}
          >
            <span class="or2__passage-number">{passage.numeral}</span>
            <span>
              <strong>{passage.name}</strong>
              <small>{passage.detail}</small>
            </span>
          </button>
        ))}
      </div>

      <div class="or2__ritual">
        <figure class="or2__icon" aria-labelledby="or2-station-title or2-caption">
          <div class="or2__aura" aria-hidden="true"></div>
          <div class="or2__frame">
            {passages.map((passage, passageIndex) =>
              passage.stations.map((station, stationIndex) => (
                <div
                  class:list={[
                    'or2__plate',
                    { 'is-active': passageIndex === 0 && stationIndex === 0 },
                  ]}
                  data-plate
                  data-passage={passage.id}
                  data-station={stationIndex}
                  data-title={station.title}
                  data-caption={station.caption}
                  data-prayer-one={station.prayerOne}
                  data-prayer-two={station.prayerTwo}
                  aria-hidden={passageIndex === 0 && stationIndex === 0 ? 'false' : 'true'}
                >
                  <img
                    src={station.image.src}
                    alt={station.alt}
                    width={station.image.width}
                    height={station.image.height}
                    loading={passageIndex === 0 && stationIndex === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={passageIndex === 0 && stationIndex === 0 ? 'high' : 'auto'}
                  />
                </div>
              ))
            )}
            <span class="or2__glint" aria-hidden="true"></span>
            <span class="or2__counter" id="or2-counter" aria-hidden="true">I · 1 / 5</span>
          </div>
          <figcaption class="or2__caption" id="or2-caption">
            Begin where color becomes a doorway.
          </figcaption>
        </figure>

        <aside class="or2__practice" aria-label="Meditation practice">
          <div class="or2__station-head">
            <p>Station</p>
            <h2 id="or2-station-title">Threshold</h2>
          </div>

          <div class="or2__stations" role="group" aria-label="Choose a station">
            {passages.map((passage) =>
              passage.stations.map((station, stationIndex) => (
                <button
                  type="button"
                  class:list={[
                    'or2__station',
                    {
                      'is-active': passage.id === 'first-light' && stationIndex === 0,
                    },
                  ]}
                  data-station-select={stationIndex}
                  data-station-passage={passage.id}
                  aria-label={(stationIndex + 1) + '. ' + station.title}
                  aria-pressed={passage.id === 'first-light' && stationIndex === 0 ? 'true' : 'false'}
                  hidden={passage.id !== 'first-light'}
                >
                  <span>{stationIndex + 1}</span>
                </button>
              ))
            )}
          </div>

          <blockquote class="or2__prayer">
            <p>
              <span id="or2-prayer-line-one">Bless the first turn.</span>
              <span id="or2-prayer-line-two">Bless the courage to begin.</span>
            </p>
          </blockquote>

          <div class="or2__breath">
            <p class="or2__cue" id="or2-cue">Choose a passage, then sit for one minute.</p>
            <div class="or2__progress" aria-hidden="true">
              <span id="or2-progress"></span>
            </div>
            <div class="or2__miles" aria-hidden="true">
              <span class="or2__mile"></span>
              <span class="or2__mile"></span>
              <span class="or2__mile"></span>
              <span class="or2__mile"></span>
              <span class="or2__mile"></span>
            </div>
          </div>

          <p class="sr-only" id="or2-cadence">
            During stillness, receive for five seconds and release for seven seconds. Each complete breath reveals the next image.
          </p>

          <div class="or2__controls" role="group" aria-label="Shrine controls">
            <button
              class="or2__button or2__button--enter"
              id="or2-enter"
              type="button"
              aria-describedby="or2-cadence"
            >Begin the passage</button>
            <button
              class="or2__button or2__button--offer"
              id="or2-offer"
              type="button"
              aria-pressed="false"
            >Offer a light</button>
          </div>

          <div class="or2__altar" aria-hidden="true">
            <span></span>
            <i class="or2__votive is-lit"></i>
            <i class="or2__votive or2__votive--offering" id="or2-offering"></i>
            <i class="or2__votive is-lit"></i>
            <span></span>
          </div>
        </aside>
      </div>

      <footer class="or2__footer">
        <p>Ten paintings from the artist’s Midjourney archive. No destination is required here.</p>
        <p aria-hidden="true">← → browse · esc leave stillness</p>
      </footer>

      <p class="or2__status sr-only" id="or2-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>
</BlockLayout>

<style is:global>
  body:has(#open-road-v2-shrine) {
    --or2-ink: #061510;
    --or2-paper: #eee6d2;
    --or2-gold: #c6a64a;
    --or2-orchid: #da8bce;
    margin: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    background: var(--or2-ink);
  }

  body:has(#open-road-v2-shrine) #pc-fb,
  body:has(#open-road-v2-shrine) #pc-spell-layer,
  body:has(#open-road-v2-shrine) #cursor-room,
  body:has(#open-road-v2-shrine) #pc-freshness,
  body:has(#open-road-v2-shrine) #pc-first-see {
    display: none !important;
  }

  body:has(#open-road-v2-shrine) #main-content {
    min-width: 0;
  }

  html.cr-cursor-active body:has(#open-road-v2-shrine),
  html.cr-cursor-active body:has(#open-road-v2-shrine) #main-content,
  html.cr-cursor-active body:has(#open-road-v2-shrine) #main-content * {
    cursor: auto !important;
  }

  html.cr-cursor-active body:has(#open-road-v2-shrine) a,
  html.cr-cursor-active body:has(#open-road-v2-shrine) button {
    cursor: pointer !important;
  }

  html.cr-cursor-active body:has(#open-road-v2-shrine) button:disabled {
    cursor: default !important;
  }

  .or2 {
    min-height: 100svh;
    min-height: 100dvh;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(68px, 8vh, 96px) clamp(18px, 4.4vw, 72px) clamp(34px, 5vh, 64px);
    color: var(--or2-paper);
    background:
      radial-gradient(circle at 26% 31%, rgba(198, 166, 74, 0.105), transparent 34%),
      radial-gradient(circle at 88% 76%, rgba(218, 139, 206, 0.075), transparent 31%),
      linear-gradient(145deg, #030c09 0%, var(--or2-ink) 44%, #0a2219 100%);
    font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
    transition: background 900ms ease;
  }

  .or2[data-passage='vespers'] {
    --or2-gold: #d39155;
    --or2-orchid: #dc77a2;
    background:
      radial-gradient(circle at 24% 31%, rgba(211, 145, 85, 0.11), transparent 35%),
      radial-gradient(circle at 84% 72%, rgba(220, 119, 162, 0.09), transparent 32%),
      linear-gradient(145deg, #080907 0%, #17130f 48%, #211410 100%);
  }

  .or2::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.16;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(238, 230, 210, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(238, 230, 210, 0.04) 1px, transparent 1px);
    background-size: 108px 108px;
    mask-image: radial-gradient(circle at center, black, transparent 80%);
  }

  .or2::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: 46vw;
    height: 46vw;
    right: -30vw;
    top: -24vw;
    border: 1px solid color-mix(in srgb, var(--or2-orchid) 18%, transparent);
    box-shadow: 0 0 0 9vw color-mix(in srgb, var(--or2-orchid) 2%, transparent);
    pointer-events: none;
    transform: rotate(45deg);
  }

  .or2__dove-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .or2__dove-cursor {
      position: fixed;
      z-index: 40;
      left: 0;
      top: 0;
      display: block;
      color: #fff9de;
      font-family: 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif;
      font-size: 21px;
      line-height: 1;
      opacity: 0;
      pointer-events: none;
      text-shadow:
        0 0 1px rgba(6, 21, 16, 0.96),
        0 2px 8px rgba(6, 21, 16, 0.72),
        0 0 13px rgba(198, 166, 74, 0.24);
      transform: translate3d(-40px, -40px, 0);
      transition: opacity 180ms ease;
      will-change: transform;
    }

    .or2__dove-cursor.is-visible {
      opacity: 0.92;
    }
  }

  .or2__exit,
  .or2__edition-link {
    position: absolute;
    z-index: 6;
    top: clamp(16px, 2.4vw, 30px);
    padding: 10px;
    color: rgba(238, 230, 210, 0.68);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 220ms ease;
  }

  .or2__exit {
    left: clamp(10px, 2.4vw, 30px);
  }

  .or2__edition-link {
    right: clamp(10px, 2.4vw, 30px);
  }

  .or2__exit:hover,
  .or2__exit:focus-visible,
  .or2__edition-link:hover,
  .or2__edition-link:focus-visible {
    color: var(--or2-paper);
    text-decoration: none;
  }

  .or2__sanctuary {
    width: min(100%, 1120px);
    margin: 0 auto;
  }

  .or2__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 18px;
    text-align: left;
  }

  .or2__seal {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    margin: 0;
    border: 1px solid rgba(198, 166, 74, 0.48);
    border-radius: 50%;
    color: var(--or2-gold);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 15px;
    font-style: italic;
  }

  .or2__eyebrow,
  .or2__station-head p {
    margin: 0 0 5px;
    color: rgba(238, 230, 210, 0.55);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .or2__header h1 {
    margin: 0;
    color: var(--or2-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(24px, 3vw, 39px);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.05;
  }

  .or2__passages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 660px);
    margin: 0 auto clamp(18px, 3vh, 30px);
    border-top: 1px solid rgba(238, 230, 210, 0.14);
    border-bottom: 1px solid rgba(238, 230, 210, 0.14);
  }

  .or2__passage {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    border: 0;
    border-right: 1px solid rgba(238, 230, 210, 0.14);
    padding: 9px 14px;
    color: rgba(238, 230, 210, 0.54);
    background: transparent;
    text-align: left;
    transition: color 240ms ease, background-color 240ms ease;
  }

  .or2__passage:last-child {
    border-right: 0;
  }

  .or2__passage:hover,
  .or2__passage:focus-visible,
  .or2__passage.is-active {
    color: var(--or2-paper);
    background: rgba(238, 230, 210, 0.035);
  }

  .or2__passage:disabled {
    color: rgba(238, 230, 210, 0.3);
  }

  .or2__passage-number {
    color: var(--or2-gold);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 17px;
    font-style: italic;
  }

  .or2__passage strong,
  .or2__passage small {
    display: block;
  }

  .or2__passage strong {
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .or2__passage small {
    margin-top: 2px;
    color: rgba(238, 230, 210, 0.42);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .or2__ritual {
    display: grid;
    grid-template-columns: minmax(0, 1.34fr) minmax(300px, 0.66fr);
    gap: clamp(30px, 5vw, 72px);
    align-items: center;
  }

  .or2__icon {
    width: 100%;
    margin: 0;
  }

  .or2__frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(238, 230, 210, 0.42);
    background: #d9d1bc;
    box-shadow:
      0 0 0 10px rgba(7, 19, 15, 0.72),
      0 0 0 11px rgba(198, 166, 74, 0.32),
      0 28px 80px rgba(0, 0, 0, 0.38);
  }

  .or2__aura {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    opacity: 0.35;
    pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--or2-gold) 24%, transparent), transparent 68%);
    filter: blur(22px);
    transform: scale(0.98);
  }

  .or2__plate {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: scale(1.018);
    transition:
      opacity 980ms ease,
      transform 12s ease,
      visibility 0s linear 980ms;
  }

  .or2__plate.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  .or2__plate img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .or2__glint {
    position: absolute;
    z-index: 4;
    top: 18%;
    right: 14%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    opacity: 0.5;
    pointer-events: none;
    background: #fffbdc;
    box-shadow:
      0 0 12px 4px rgba(255, 246, 194, 0.4),
      0 0 36px 12px rgba(198, 166, 74, 0.17);
  }

  .or2__counter {
    position: absolute;
    z-index: 5;
    right: 12px;
    bottom: 10px;
    padding: 5px 7px;
    color: rgba(255, 251, 231, 0.9);
    background: rgba(5, 15, 11, 0.66);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .or2__caption {
    min-height: 20px;
    margin-top: 16px;
    color: rgba(238, 230, 210, 0.6);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 12px;
    font-style: italic;
    letter-spacing: 0.015em;
    text-align: center;
  }

  .or2__practice {
    min-width: 0;
    display: grid;
    gap: clamp(18px, 2.4vh, 27px);
  }

  .or2__station-head h2 {
    margin: 0;
    color: var(--or2-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(31px, 4vw, 48px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .or2__stations {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .or2__station {
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(238, 230, 210, 0.18);
    border-radius: 50%;
    color: rgba(238, 230, 210, 0.54);
    background: transparent;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    transition:
      color 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease,
      transform 220ms ease;
  }

  .or2__station[hidden] {
    display: none;
  }

  .or2__station:hover,
  .or2__station:focus-visible {
    color: var(--or2-paper);
    border-color: rgba(238, 230, 210, 0.52);
  }

  .or2__station.is-active {
    color: #08140f;
    border-color: var(--or2-gold);
    background: var(--or2-gold);
    transform: scale(1.04);
  }

  .or2__station:disabled {
    opacity: 0.46;
    transform: none;
  }

  .or2__prayer {
    min-height: 76px;
    margin: 0;
    padding: 17px 0;
    border-top: 1px solid rgba(238, 230, 210, 0.13);
    border-bottom: 1px solid rgba(238, 230, 210, 0.13);
  }

  .or2__prayer p {
    margin: 0;
    color: var(--or2-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(18px, 2.2vw, 25px);
    font-weight: 400;
    line-height: 1.34;
  }

  .or2__prayer span {
    display: block;
  }

  .or2__breath {
    display: grid;
    gap: 10px;
  }

  .or2__cue {
    min-height: 16px;
    margin: 0;
    color: rgba(238, 230, 210, 0.62);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .or2__progress {
    height: 1px;
    overflow: hidden;
    background: rgba(238, 230, 210, 0.13);
  }

  .or2__progress span {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--or2-gold);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .or2__miles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .or2__mile {
    height: 2px;
    background: rgba(238, 230, 210, 0.13);
    transition: background-color 300ms ease;
  }

  .or2__mile.is-passed {
    background: color-mix(in srgb, var(--or2-gold) 72%, var(--or2-paper));
  }

  .or2__controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .or2__button {
    min-height: 44px;
    border: 0;
    border-bottom: 1px solid rgba(198, 166, 74, 0.56);
    padding: 8px 0;
    color: rgba(238, 230, 210, 0.76);
    background: transparent;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    transition: color 220ms ease, border-color 220ms ease;
  }

  .or2__button:hover,
  .or2__button:focus-visible {
    color: var(--or2-paper);
    border-bottom-color: var(--or2-gold);
  }

  .or2__button:disabled {
    color: rgba(238, 230, 210, 0.34);
    border-bottom-color: transparent;
  }

  .or2__altar {
    display: grid;
    grid-template-columns: 1fr auto auto auto 1fr;
    align-items: end;
    gap: 10px;
    height: 23px;
  }

  .or2__altar > span {
    height: 1px;
    margin-bottom: 1px;
    background: linear-gradient(90deg, transparent, rgba(198, 166, 74, 0.42));
  }

  .or2__altar > span:last-child {
    background: linear-gradient(90deg, rgba(198, 166, 74, 0.42), transparent);
  }

  .or2__votive {
    position: relative;
    width: 9px;
    height: 10px;
    display: block;
    border: 1px solid rgba(238, 230, 210, 0.28);
    border-radius: 2px 2px 4px 4px;
    background: rgba(238, 230, 210, 0.08);
  }

  .or2__votive::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 6px;
    height: 10px;
    border-radius: 55% 45% 48% 52%;
    opacity: 0;
    background: #f4cf65;
    box-shadow: 0 0 10px 3px rgba(244, 207, 101, 0.26);
    transform: translateX(-50%) scale(0.4);
    transform-origin: 50% 100%;
  }

  .or2__votive.is-lit::before {
    opacity: 0.9;
    animation: or2-votive 2.4s ease-in-out infinite alternate;
  }

  .or2__votive--offering {
    width: 12px;
    height: 13px;
  }

  .or2__votive--offering::before {
    bottom: 11px;
  }

  .or2__footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: clamp(22px, 4vh, 38px);
    color: rgba(238, 230, 210, 0.42);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .or2__footer p {
    margin: 0;
  }

  .or2[data-state='sitting'] .or2__aura {
    animation: or2-breathe 12s ease-in-out infinite;
  }

  .or2[data-state='sitting'] .or2__glint {
    animation: or2-glint 6s ease-in-out infinite;
  }

  .or2[data-state='sitting'] .or2__header,
  .or2[data-state='sitting'] .or2__passages,
  .or2[data-state='sitting'] .or2__caption,
  .or2[data-state='sitting'] .or2__footer,
  .or2[data-state='sitting'] .or2__button--offer {
    opacity: 0.42;
  }

  .or2[data-state='sitting'][data-phase='receive'] .or2__cue {
    color: rgba(238, 230, 210, 0.82);
  }

  .or2[data-state='sitting'][data-phase='release'] .or2__cue {
    color: color-mix(in srgb, var(--or2-gold) 78%, var(--or2-paper));
  }

  .or2[data-paused='true'] *,
  .or2[data-paused='true'] *::before,
  .or2[data-paused='true'] *::after {
    animation-play-state: paused !important;
  }

  .or2__passage:focus-visible,
  .or2__station:focus-visible,
  .or2__button:focus-visible,
  .or2__exit:focus-visible,
  .or2__edition-link:focus-visible {
    outline: 1px solid var(--or2-gold);
    outline-offset: 4px;
  }

  @keyframes or2-breathe {
    0% { opacity: 0.28; transform: scale(0.97); }
    41.667% { opacity: 0.55; transform: scale(1.035); }
    100% { opacity: 0.28; transform: scale(0.97); }
  }

  @keyframes or2-glint {
    0%, 100% { opacity: 0.34; transform: scale(0.72); }
    42% { opacity: 0.88; transform: scale(1.22); }
  }

  @keyframes or2-votive {
    0% { transform: translateX(-50%) rotate(-4deg) scale(0.88); opacity: 0.72; }
    55% { transform: translateX(-50%) rotate(5deg) scale(1.04); opacity: 1; }
    100% { transform: translateX(-50%) rotate(-1deg) scale(0.93); opacity: 0.84; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 840px) {
    .or2 {
      padding-top: 74px;
    }

    .or2__ritual {
      grid-template-columns: 1fr;
      width: min(100%, 620px);
      margin: 0 auto;
      gap: 28px;
    }

    .or2__practice,
    .or2__station-head {
      text-align: center;
    }

    .or2__controls,
    .or2__footer {
      justify-content: center;
      text-align: center;
    }

    .or2__footer p:last-child {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .or2 {
      padding-inline: 15px;
    }

    .or2__header {
      align-items: flex-start;
      justify-content: flex-start;
      padding-inline: 4px;
    }

    .or2__seal {
      width: 39px;
      height: 39px;
      flex: 0 0 auto;
    }

    .or2__passage {
      min-height: 62px;
      justify-content: flex-start;
      padding-inline: 10px;
    }

    .or2__passage small {
      display: none;
    }

    .or2__frame {
      box-shadow:
        0 0 0 6px rgba(7, 19, 15, 0.72),
        0 0 0 7px rgba(198, 166, 74, 0.32),
        0 20px 60px rgba(0, 0, 0, 0.35);
    }

    .or2__edition-link {
      max-width: 42vw;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .or2 *,
    .or2 *::before,
    .or2 *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    .or2__aura,
    .or2__plate {
      transform: none;
    }

    .or2__votive.is-lit::before {
      opacity: 0.9;
      transform: translateX(-50%);
    }
  }
</style>

<script>
  const shrine = document.getElementById('open-road-v2-shrine');
  const enterButton = document.getElementById('or2-enter');
  const offerButton = document.getElementById('or2-offer');
  const offering = document.getElementById('or2-offering');
  const cue = document.getElementById('or2-cue');
  const progress = document.getElementById('or2-progress');
  const stationTitle = document.getElementById('or2-station-title');
  const caption = document.getElementById('or2-caption');
  const counter = document.getElementById('or2-counter');
  const prayerLineOne = document.getElementById('or2-prayer-line-one');
  const prayerLineTwo = document.getElementById('or2-prayer-line-two');
  const status = document.getElementById('or2-status');
  const doveCursor = document.getElementById('or2-dove-cursor');
  const plates = Array.from(document.querySelectorAll('[data-plate]'));
  const passageButtons = Array.from(document.querySelectorAll('[data-passage-select]'));
  const stationButtons = Array.from(document.querySelectorAll('[data-station-select]'));
  const mileMarkers = Array.from(document.querySelectorAll('.or2__mile'));

  if (
    shrine instanceof HTMLElement &&
    enterButton instanceof HTMLButtonElement &&
    offerButton instanceof HTMLButtonElement &&
    offering instanceof HTMLElement &&
    cue instanceof HTMLElement &&
    progress instanceof HTMLElement &&
    stationTitle instanceof HTMLElement &&
    caption instanceof HTMLElement &&
    counter instanceof HTMLElement &&
    prayerLineOne instanceof HTMLElement &&
    prayerLineTwo instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const SIT_DURATION = 60_000;
    const RECEIVE_DURATION = 5_000;
    const RELEASE_DURATION = 7_000;
    const BREATH_DURATION = RECEIVE_DURATION + RELEASE_DURATION;
    const LIGHT_STORAGE_KEY = 'pc:open-road-v2:light';

    let state = 'idle';
    let currentPassage = 'first-light';
    let currentStation = 0;
    let accumulated = 0;
    let lastResumedAt = 0;
    let animationFrame = 0;
    let visiblePhase = 'rest';

    const activeStationButtons = () =>
      stationButtons.filter((button) =>
        button instanceof HTMLButtonElement && button.dataset.stationPassage === currentPassage
      );

    const setPrayer = (lineOne, lineTwo) => {
      prayerLineOne.textContent = lineOne;
      prayerLineTwo.textContent = lineTwo;
    };

    const setProgress = (value) => {
      const bounded = Math.min(1, Math.max(0, value));
      progress.style.transform = 'scaleX(' + bounded + ')';
    };

    const setMiles = (elapsed) => {
      const passed = Math.min(mileMarkers.length, Math.floor(elapsed / BREATH_DURATION));
      mileMarkers.forEach((marker, index) => {
        marker.classList.toggle('is-passed', index < passed);
      });
    };

    const setStation = (nextStation, announce = false) => {
      currentStation = Math.min(4, Math.max(0, nextStation));
      shrine.dataset.station = String(currentStation);

      plates.forEach((plate) => {
        if (!(plate instanceof HTMLElement)) return;
        const active =
          plate.dataset.passage === currentPassage &&
          Number(plate.dataset.station) === currentStation;
        plate.classList.toggle('is-active', active);
        plate.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      stationButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const inPassage = button.dataset.stationPassage === currentPassage;
        const active = inPassage && Number(button.dataset.stationSelect) === currentStation;
        button.hidden = !inPassage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      const selectedPlate = plates.find((plate) =>
        plate instanceof HTMLElement &&
        plate.dataset.passage === currentPassage &&
        Number(plate.dataset.station) === currentStation
      );

      if (selectedPlate instanceof HTMLElement) {
        const title = selectedPlate.dataset.title || 'Station';
        stationTitle.textContent = title;
        caption.textContent = selectedPlate.dataset.caption || '';
        setPrayer(
          selectedPlate.dataset.prayerOne || '',
          selectedPlate.dataset.prayerTwo || ''
        );
        counter.textContent =
          (currentPassage === 'first-light' ? 'I' : 'II') +
          ' · ' +
          (currentStation + 1) +
          ' / 5';
        if (announce) {
          status.textContent = 'Station ' + (currentStation + 1) + ': ' + title + '.';
        }
      }
    };

    const setPassage = (nextPassage, announce = true) => {
      currentPassage = nextPassage === 'vespers' ? 'vespers' : 'first-light';
      shrine.dataset.passage = currentPassage;
      passageButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const active = button.dataset.passageSelect === currentPassage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      setStation(0);
      if (announce) {
        status.textContent =
          currentPassage === 'first-light'
            ? 'First Light selected. Five daylight stations.'
            : 'Printed Vespers selected. Five evening stations.';
      }
    };

    const setSelectorsDisabled = (disabled) => {
      passageButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
      stationButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
    };

    const getClosingPrayer = () => {
      const hour = new Date().getHours();

      if (hour >= 5 && hour < 12) {
        return ['Travel with wonder.', 'Return with gratitude.'];
      }

      if (hour >= 12 && hour < 17) {
        return ['Go with clear eyes.', 'Come home unhurried.'];
      }

      if (hour >= 17 && hour < 21) {
        return ['Let evening receive you.', 'Return in peace.'];
      }

      return ['May the dark hold gently.', 'May every road lead home.'];
    };

    const setPhase = (nextPhase) => {
      if (visiblePhase === nextPhase) return;
      visiblePhase = nextPhase;
      shrine.dataset.phase = nextPhase;
      cue.textContent = nextPhase === 'receive' ? 'Receive' : 'Release';
    };

    const reset = (announce = true) => {
      cancelAnimationFrame(animationFrame);
      state = 'idle';
      accumulated = 0;
      visiblePhase = 'rest';
      shrine.dataset.state = 'idle';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      setSelectorsDisabled(false);
      setStation(currentStation);
      cue.textContent = 'Choose a passage, then sit for one minute.';
      enterButton.textContent = 'Begin the passage';
      setProgress(0);
      setMiles(0);
      if (announce) status.textContent = 'Stillness ended.';
    };

    const complete = () => {
      cancelAnimationFrame(animationFrame);
      state = 'complete';
      accumulated = SIT_DURATION;
      visiblePhase = 'rest';
      shrine.dataset.state = 'complete';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      setSelectorsDisabled(false);
      const closingPrayer = getClosingPrayer();
      setPrayer(closingPrayer[0], closingPrayer[1]);
      cue.textContent = 'The road is open.';
      enterButton.textContent = 'Sit again';
      setProgress(1);
      setMiles(SIT_DURATION);
      status.textContent =
        'One minute complete. ' + closingPrayer[0] + ' ' + closingPrayer[1];
    };

    const tick = (now) => {
      if (state !== 'sitting' || document.hidden) return;
      const elapsed = accumulated + (now - lastResumedAt);
      setProgress(elapsed / SIT_DURATION);
      setMiles(elapsed);
      const nextStation = Math.min(4, Math.floor(elapsed / BREATH_DURATION));
      if (nextStation !== currentStation) setStation(nextStation);

      const breathPosition = elapsed % BREATH_DURATION;
      setPhase(breathPosition < RECEIVE_DURATION ? 'receive' : 'release');

      if (elapsed >= SIT_DURATION) {
        complete();
        return;
      }

      animationFrame = requestAnimationFrame(tick);
    };

    const start = () => {
      cancelAnimationFrame(animationFrame);
      state = 'sitting';
      accumulated = 0;
      lastResumedAt = performance.now();
      visiblePhase = 'receive';
      shrine.dataset.state = 'sitting';
      shrine.dataset.phase = 'receive';
      delete shrine.dataset.paused;
      setSelectorsDisabled(true);
      setStation(0);
      cue.textContent = 'Receive';
      enterButton.textContent = 'Leave stillness';
      setProgress(0);
      setMiles(0);
      status.textContent = 'One minute of stillness has begun.';
      animationFrame = requestAnimationFrame(tick);
    };

    passageButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (state === 'complete') reset(false);
        setPassage(button.dataset.passageSelect || 'first-light');
      });
    });

    stationButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (state === 'complete') reset(false);
        setStation(Number(button.dataset.stationSelect), true);
      });
    });

    enterButton.addEventListener('click', () => {
      if (state === 'sitting') reset();
      else start();
    });

    const lightOffering = (announce = true) => {
      offering.classList.add('is-lit');
      offerButton.textContent = 'Light offered';
      offerButton.setAttribute('aria-pressed', 'true');
      offerButton.disabled = true;
      if (announce) status.textContent = 'Your light is offered.';
    };

    try {
      if (sessionStorage.getItem(LIGHT_STORAGE_KEY) === '1') lightOffering(false);
    } catch {
      // The votive still works when storage is unavailable.
    }

    offerButton.addEventListener('click', () => {
      lightOffering();
      try {
        sessionStorage.setItem(LIGHT_STORAGE_KEY, '1');
      } catch {
        // Keep the light for this page even when storage is unavailable.
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && state === 'sitting') {
        reset();
        enterButton.focus();
        return;
      }

      if (
        state !== 'sitting' &&
        (event.key === 'ArrowLeft' || event.key === 'ArrowRight') &&
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)
      ) {
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        setStation((currentStation + direction + 5) % 5, true);
        const buttons = activeStationButtons();
        const selected = buttons[currentStation];
        if (selected instanceof HTMLButtonElement) selected.focus();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (state !== 'sitting') return;

      if (document.hidden) {
        accumulated += performance.now() - lastResumedAt;
        shrine.dataset.paused = 'true';
        cancelAnimationFrame(animationFrame);
        return;
      }

      lastResumedAt = performance.now();
      delete shrine.dataset.paused;
      animationFrame = requestAnimationFrame(tick);
    });

    if (
      doveCursor instanceof HTMLElement &&
      window.matchMedia('(hover: hover) and (pointer: fine)').matches
    ) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let targetX = -40;
      let targetY = -40;
      let currentX = -40;
      let currentY = -40;
      let doveFrame = 0;

      const placeDove = () => {
        const ease = reduceMotion ? 1 : 0.24;
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        doveCursor.style.transform =
          'translate3d(' + currentX + 'px, ' + currentY + 'px, 0)';

        if (Math.abs(targetX - currentX) > 0.2 || Math.abs(targetY - currentY) > 0.2) {
          doveFrame = requestAnimationFrame(placeDove);
        } else {
          doveFrame = 0;
        }
      };

      window.addEventListener(
        'pointermove',
        (event) => {
          targetX = event.clientX + 13;
          targetY = event.clientY - 20;
          doveCursor.classList.add('is-visible');
          if (!doveFrame) doveFrame = requestAnimationFrame(placeDove);
        },
        { passive: true }
      );

      window.addEventListener('mouseout', (event) => {
        if (!event.relatedTarget) doveCursor.classList.remove('is-visible');
      });
    }
  }
</script>
