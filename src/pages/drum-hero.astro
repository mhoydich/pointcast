---
/**
 * /drum-hero — falling notes, four lanes, sixty seconds.
 *
 * Notes rain down a highway toward a strike line. Hit D F J K (or tap
 * the lanes) as each note crosses the line. PERFECT under 60ms, GOOD
 * under 130ms, anything else breaks the combo. A procedural beatmap
 * rides over a synthesized kick/hat groove — a new map every run.
 * Final grade S/A/B/C/D, best score in localStorage.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Drum Hero · four lanes, sixty seconds · PointCast';
const description = 'Notes fall. You strike. PERFECT under 60ms. A new procedural beatmap every run — sixty seconds, one grade, no mercy.';
---
<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dh" id="dh">
    <header class="dh__hud">
      <div class="dh__hud-left">
        <span class="dh__combo" id="dh-combo">—</span>
        <span class="dh__combo-label">combo</span>
      </div>
      <div class="dh__hud-mid">
        <span class="dh__judge" id="dh-judge"></span>
      </div>
      <div class="dh__hud-right">
        <span class="dh__points" id="dh-points">0</span>
        <span class="dh__time" id="dh-time">60.0</span>
      </div>
    </header>

    <section class="dh__stage">
      <canvas class="dh__canvas" id="dh-canvas"></canvas>
      <div class="dh__overlay" id="dh-overlay">
        <h1 class="dh__title">DRUM HERO</h1>
        <p class="dh__sub">four lanes · sixty seconds · D F J K or tap</p>
        <p class="dh__best" id="dh-best-line">best — · grade —</p>
        <button class="dh__go" id="dh-go" type="button">▶ DROP THE BEAT</button>
      </div>
      <div class="dh__lanes" id="dh-lanes">
        <button class="dh__lane-btn" data-lane="0" type="button" aria-label="Lane 1 (D)"><span>D</span></button>
        <button class="dh__lane-btn" data-lane="1" type="button" aria-label="Lane 2 (F)"><span>F</span></button>
        <button class="dh__lane-btn" data-lane="2" type="button" aria-label="Lane 3 (J)"><span>J</span></button>
        <button class="dh__lane-btn" data-lane="3" type="button" aria-label="Lane 4 (K)"><span>K</span></button>
      </div>
    </section>

    <nav class="dh__siblings">
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-lockstep">/drum-lockstep</a>
      <a href="/drum-apr26">/drum-apr26</a>
      <a href="/drum">/drum</a>
    </nav>
  </main>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dh) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dh {
      max-width: 560px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 94vh;
    }

    /* HUD */
    .dh__hud {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'JetBrains Mono', monospace;
      padding: 2px 6px;
      min-height: 44px;
    }
    .dh__hud-left { display: flex; align-items: baseline; gap: 8px; }
    .dh__combo {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 34px;
      color: #f6c15e;
      font-variant-numeric: tabular-nums;
      min-width: 52px;
    }
    .dh__combo--hot { color: #ff6b8a; text-shadow: 0 0 14px rgba(255,107,138,0.6); }
    .dh__combo-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; }
    .dh__judge {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .dh__judge--perfect { color: #8aeac0; text-shadow: 0 0 12px rgba(138,234,192,0.7); }
    .dh__judge--good { color: #7ac8ed; }
    .dh__judge--miss { color: #ff6b8a; }
    .dh__hud-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0; }
    .dh__points {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 22px;
      font-variant-numeric: tabular-nums;
    }
    .dh__time { font-size: 11px; color: #8a8a9a; font-variant-numeric: tabular-nums; }

    /* STAGE */
    .dh__stage {
      position: relative;
      flex: 1;
      min-height: 420px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 80%, #1c0e2e 100%);
    }
    .dh__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    .dh__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(7,5,15,0.82);
      backdrop-filter: blur(3px);
      z-index: 3;
      text-align: center;
      padding: 20px;
    }
    .dh__overlay--hidden { display: none; }
    .dh__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(30px, 8vw, 52px);
      letter-spacing: 0.2em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dh__sub, .dh__best {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
    }
    .dh__best { color: #d4a437; }
    .dh__go {
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dh__go:hover { transform: translateY(-1px); background: #ffd98a; }

    /* LANE TAP ZONES (mobile) */
    .dh__lanes {
      position: absolute;
      inset: auto 0 0 0;
      height: 30%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      z-index: 2;
    }
    .dh__lane-btn {
      background: transparent;
      border: 0;
      cursor: pointer;
      position: relative;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .dh__lane-btn span {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 700;
      color: rgba(244,231,200,0.35);
      pointer-events: none;
    }
    .dh__lane-btn--flash { background: linear-gradient(180deg, transparent, rgba(246,193,94,0.14)); }

    .dh__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dh__siblings a { color: #d4a437; text-decoration: none; }
    .dh__siblings a:hover { text-decoration: underline; }
  </style>

  <script>
    const LANE_COLORS = ['#ff6b8a', '#f6c15e', '#8aeac0', '#7ac8ed'];
    const LANE_FREQS = [196.0, 261.63, 329.63, 440.0]; // G3 C4 E4 A4
    const RUN_MS = 60_000;
    const APPROACH_MS = 1400;       // note travel time top → strike line
    const PERFECT_MS = 60;
    const GOOD_MS = 130;
    const BPM = 112;
    const BEAT_MS = 60_000 / BPM;

    type Note = { lane: number; at: number; hit: boolean; judged: boolean };

    let notes: Note[] = [];
    let running = false;
    let startAt = 0;
    let score = 0;
    let combo = 0;
    let maxCombo = 0;
    let counts = { perfect: 0, good: 0, miss: 0 };
    let rafId = 0;
    let grooveTimer = 0;
    let SESSION_ID = '';

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(115, t);
      o.frequency.exponentialRampToValueAtTime(42, t + 0.16);
      g.gain.setValueAtTime(0.4, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.25);
    }
    function pHat(t: number, open = false) {
      const a = ctx();
      const dur = open ? 0.16 : 0.05;
      const buf = a.createBuffer(1, a.sampleRate * dur, a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7000;
      const g = a.createGain(); g.gain.value = open ? 0.10 : 0.07;
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    function pStrike(lane: number, quality: 'perfect' | 'good') {
      const a = ctx(); const t = a.currentTime + 0.003;
      const f = LANE_FREQS[lane];
      const o = a.createOscillator(); const g = a.createGain();
      o.type = quality === 'perfect' ? 'triangle' : 'sine';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(quality === 'perfect' ? 0.34 : 0.24, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.45);
      if (quality === 'perfect') {
        const o2 = a.createOscillator(); const g2 = a.createGain();
        o2.type = 'sine'; o2.frequency.setValueAtTime(f * 2, t);
        g2.gain.setValueAtTime(0.0001, t);
        g2.gain.exponentialRampToValueAtTime(0.1, t + 0.005);
        g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
        o2.connect(g2).connect(a.destination); o2.start(t); o2.stop(t + 0.3);
      }
    }
    function pThud() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(70, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.12, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.2);
    }

    // Backing groove: schedule kick on beats, hats on eighths, one bar ahead
    function scheduleGroove() {
      if (!running) return;
      const a = ctx();
      const now = a.currentTime;
      const elapsed = performance.now() - startAt;
      const beatIdx = Math.ceil(elapsed / BEAT_MS);
      for (let b = beatIdx; b < beatIdx + 4; b++) {
        const at = now + (b * BEAT_MS - elapsed) / 1000;
        if (at < now) continue;
        if (b % 1 === 0) pKick(at);
        pHat(at + (BEAT_MS / 2) / 1000, b % 4 === 3);
      }
      grooveTimer = window.setTimeout(scheduleGroove, BEAT_MS * 2);
    }

    // ---- beatmap ----
    function generateMap(): Note[] {
      const out: Note[] = [];
      let t = 2000; // lead-in
      let lastLane = -1;
      while (t < RUN_MS - 1200) {
        const progress = t / RUN_MS;
        // density ramps: eighths appear after 25%, occasional 16ths after 60%
        const sub = progress > 0.6 && Math.random() < 0.3 ? BEAT_MS / 4
                  : progress > 0.25 && Math.random() < 0.45 ? BEAT_MS / 2
                  : BEAT_MS;
        // rests keep it human
        if (Math.random() < 0.16) { t += BEAT_MS; continue; }
        let lane = Math.floor(Math.random() * 4);
        if (lane === lastLane && Math.random() < 0.6) lane = (lane + 1 + Math.floor(Math.random() * 3)) % 4;
        out.push({ lane, at: Math.round(t), hit: false, judged: false });
        lastLane = lane;
        t += sub;
      }
      return out;
    }

    // ---- canvas ----
    const canvas = document.getElementById('dh-canvas') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = W * DPR; canvas.height = H * DPR;
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    window.addEventListener('resize', resize);

    const STRIKE_Y_FRAC = 0.82;
    type Burst = { lane: number; born: number; color: string };
    let bursts: Burst[] = [];

    function draw(nowMs: number) {
      cx.clearRect(0, 0, W, H);
      const laneW = W / 4;
      const strikeY = H * STRIKE_Y_FRAC;

      // lane dividers
      cx.strokeStyle = 'rgba(244,231,200,0.07)';
      cx.lineWidth = 1;
      for (let i = 1; i < 4; i++) {
        cx.beginPath(); cx.moveTo(i * laneW, 0); cx.lineTo(i * laneW, H); cx.stroke();
      }
      // strike line
      cx.strokeStyle = 'rgba(246,193,94,0.85)';
      cx.lineWidth = 3;
      cx.beginPath(); cx.moveTo(8, strikeY); cx.lineTo(W - 8, strikeY); cx.stroke();
      // strike pads
      for (let i = 0; i < 4; i++) {
        cx.fillStyle = LANE_COLORS[i] + '22';
        cx.beginPath();
        cx.arc(i * laneW + laneW / 2, strikeY, Math.min(laneW * 0.3, 26), 0, Math.PI * 2);
        cx.fill();
      }

      // notes
      const elapsed = nowMs - startAt;
      for (const n of notes) {
        if (n.judged && n.hit) continue;
        const dt = n.at - elapsed;               // ms until strike
        if (dt > APPROACH_MS || dt < -220) continue;
        const y = strikeY * (1 - dt / APPROACH_MS);
        const x = n.lane * laneW + laneW / 2;
        const r = Math.min(laneW * 0.26, 22);
        cx.fillStyle = n.judged ? 'rgba(120,120,140,0.35)' : LANE_COLORS[n.lane];
        cx.beginPath(); cx.arc(x, y, r, 0, Math.PI * 2); cx.fill();
        cx.fillStyle = 'rgba(255,255,255,0.25)';
        cx.beginPath(); cx.arc(x - r * 0.25, y - r * 0.3, r * 0.35, 0, Math.PI * 2); cx.fill();
      }

      // hit bursts
      const now = performance.now();
      bursts = bursts.filter((b) => now - b.born < 300);
      for (const b of bursts) {
        const age = (now - b.born) / 300;
        const x = b.lane * laneW + laneW / 2;
        cx.strokeStyle = b.color;
        cx.globalAlpha = 1 - age;
        cx.lineWidth = 3;
        cx.beginPath();
        cx.arc(x, strikeY, 14 + age * 34, 0, Math.PI * 2);
        cx.stroke();
        cx.globalAlpha = 1;
      }
    }

    // ---- judging ----
    const judgeEl = document.getElementById('dh-judge')!;
    const comboEl = document.getElementById('dh-combo')!;
    const pointsEl = document.getElementById('dh-points')!;
    const timeEl = document.getElementById('dh-time')!;
    let judgeTimer = 0;

    function showJudge(kind: 'perfect' | 'good' | 'miss') {
      judgeEl.textContent = kind === 'perfect' ? 'PERFECT' : kind === 'good' ? 'GOOD' : 'MISS';
      judgeEl.className = `dh__judge dh__judge--${kind}`;
      clearTimeout(judgeTimer);
      judgeTimer = window.setTimeout(() => { judgeEl.textContent = ''; }, 420);
    }
    function updateHud() {
      comboEl.textContent = combo > 0 ? `${combo}×` : '—';
      comboEl.classList.toggle('dh__combo--hot', combo >= 20);
      pointsEl.textContent = String(score);
    }

    function strike(lane: number) {
      if (!running) return;
      flashLane(lane);
      const elapsed = performance.now() - startAt;
      // nearest unjudged note in this lane within the good window
      let best: Note | null = null;
      let bestAbs = Infinity;
      for (const n of notes) {
        if (n.lane !== lane || n.judged) continue;
        const off = Math.abs(n.at - elapsed);
        if (off < bestAbs) { bestAbs = off; best = n; }
      }
      if (!best || bestAbs > GOOD_MS) {
        // whiff — no note there: soft thud, break combo only if a note was missable
        pThud();
        return;
      }
      best.judged = true;
      best.hit = true;
      if (bestAbs <= PERFECT_MS) {
        counts.perfect++;
        combo++;
        score += 100 + Math.min(combo, 50) * 2;
        pStrike(lane, 'perfect');
        showJudge('perfect');
        bursts.push({ lane, born: performance.now(), color: '#8aeac0' });
      } else {
        counts.good++;
        combo++;
        score += 50 + Math.min(combo, 50);
        pStrike(lane, 'good');
        showJudge('good');
        bursts.push({ lane, born: performance.now(), color: '#7ac8ed' });
      }
      maxCombo = Math.max(maxCombo, combo);
      updateHud();
      broadcast(lane);
    }

    function sweepMisses(elapsed: number) {
      for (const n of notes) {
        if (n.judged) continue;
        if (elapsed - n.at > GOOD_MS) {
          n.judged = true;
          counts.miss++;
          if (combo > 0) { combo = 0; showJudge('miss'); updateHud(); }
        }
      }
    }

    // ---- run loop ----
    function frame() {
      if (!running) return;
      const now = performance.now();
      const elapsed = now - startAt;
      sweepMisses(elapsed);
      draw(now);
      const left = Math.max(0, RUN_MS - elapsed);
      timeEl.textContent = (left / 1000).toFixed(1);
      if (elapsed >= RUN_MS) { endRun(); return; }
      rafId = requestAnimationFrame(frame);
    }

    function grade(): string {
      const total = counts.perfect + counts.good + counts.miss;
      if (total === 0) return 'D';
      const acc = (counts.perfect + counts.good * 0.55) / total;
      if (acc >= 0.95 && counts.miss === 0) return 'S';
      if (acc >= 0.88) return 'A';
      if (acc >= 0.72) return 'B';
      if (acc >= 0.5) return 'C';
      return 'D';
    }

    const overlay = document.getElementById('dh-overlay')!;
    const goBtn = document.getElementById('dh-go') as HTMLButtonElement;
    const bestLine = document.getElementById('dh-best-line')!;
    const titleEl = overlay.querySelector('.dh__title') as HTMLElement;
    const subEl = overlay.querySelector('.dh__sub') as HTMLElement;

    function endRun() {
      running = false;
      cancelAnimationFrame(rafId);
      clearTimeout(grooveTimer);
      const g = grade();
      titleEl.textContent = `GRADE ${g}`;
      subEl.textContent = `${score} pts · ${counts.perfect} perfect · ${counts.good} good · ${counts.miss} miss · ${maxCombo}× best combo`;
      goBtn.textContent = '▶ RUN IT BACK';
      // persist best
      try {
        const prev = Number(localStorage.getItem('pc-drum-hero-best') || 0);
        if (score > prev) {
          localStorage.setItem('pc-drum-hero-best', String(score));
          localStorage.setItem('pc-drum-hero-grade', g);
        }
        const b = Math.max(score, prev);
        const bg = score > prev ? g : (localStorage.getItem('pc-drum-hero-grade') || g);
        bestLine.textContent = `best ${b} · grade ${bg}`;
      } catch {
        bestLine.textContent = `best ${score} · grade ${g}`;
      }
      overlay.classList.remove('dh__overlay--hidden');
    }

    function startRun() {
      ctx();
      resize();
      notes = generateMap();
      score = 0; combo = 0; maxCombo = 0;
      counts = { perfect: 0, good: 0, miss: 0 };
      updateHud();
      overlay.classList.add('dh__overlay--hidden');
      running = true;
      startAt = performance.now();
      scheduleGroove();
      rafId = requestAnimationFrame(frame);
    }

    // ---- input ----
    const KEY_LANES: Record<string, number> = { d: 0, f: 1, j: 2, k: 3 };
    const laneBtns = Array.from(document.querySelectorAll('.dh__lane-btn')) as HTMLButtonElement[];
    function flashLane(lane: number) {
      const el = laneBtns[lane];
      el.classList.add('dh__lane-btn--flash');
      setTimeout(() => el.classList.remove('dh__lane-btn--flash'), 100);
    }
    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      const lane = KEY_LANES[e.key.toLowerCase()];
      if (lane !== undefined) { e.preventDefault(); strike(lane); }
    });
    laneBtns.forEach((el) => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        strike(Number(el.dataset.lane));
      });
    });
    goBtn.addEventListener('click', startRun);

    // ---- shared bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(lane: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // don't flood the bus at 16th-note rates
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: lane, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // init
    SESSION_ID = getOrCreateSession();
    resize();
    try {
      const b = Number(localStorage.getItem('pc-drum-hero-best') || 0);
      const bg = localStorage.getItem('pc-drum-hero-grade');
      if (b > 0) bestLine.textContent = `best ${b} · grade ${bg || '—'}`;
    } catch {}
  </script>
</BlockLayout>
