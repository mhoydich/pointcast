---
import data from '../../data/office-market.json';

const { creator, collections, services, thread } = data;
const loomUrl = `https://pointcast.xyz/loom?to=${encodeURIComponent(thread)}`;
const title = 'Office Noun Market | PointCast';
const description = 'The office noun market: art on tezos, services by request, and a public board for wants and offers.';
const canonical = 'https://pointcast.xyz/office/market';
const config = JSON.stringify({
  creator: creator.address,
  thread,
  loomUrl,
  collections,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <style is:global>
      .om { --ink: #1c1b18; --paper: #f4f1ea; --card: #fffdf8; --line: #cfc9bb; --muted: #5c584d; --accent: #8a3b12;
        margin: 0; background: var(--paper); color: var(--ink);
        font: 16px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; min-height: 100vh; }
      .om * { box-sizing: border-box; }
      .om a { color: var(--accent); }
      .om a:focus-visible, .om button:focus-visible, .om select:focus-visible { outline: 3px solid #1c1b18; outline-offset: 2px; }
      .om__wrap { max-width: 960px; margin: 0 auto; padding: 20px 16px 48px; }
      .om h1 { font-size: 1.9rem; margin: 8px 0 4px; font-weight: 600; }
      .om h2 { font-size: 1.25rem; margin: 0 0 4px; font-weight: 600; }
      .om h3 { font-size: 1rem; margin: 0 0 4px; font-weight: 600; }
      .om p { margin: 0 0 8px; }
      .om__dek, .om__note { color: var(--muted); }
      .om__sec { border-top: 2px solid var(--ink); margin-top: 32px; padding-top: 16px; }
      .om__bar { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; align-items: center; }
      .om__btn, .om__link { display: inline-block; border: 1px solid var(--ink); background: var(--card); color: var(--ink) !important;
        padding: 8px 12px; min-height: 40px; font: inherit; text-decoration: none; cursor: pointer; border-radius: 3px; }
      .om__btn[aria-pressed="true"] { background: var(--ink); color: var(--paper) !important; }
      .om__btn--solid { background: var(--ink); color: var(--paper) !important; }
      .om select { min-height: 40px; font: inherit; padding: 6px 8px; max-width: 100%; }
      .om__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin: 12px 0 20px; padding: 0; list-style: none; }
      .om__card { background: var(--card); border: 1px solid var(--line); padding: 8px; display: flex; flex-direction: column; gap: 4px; }
      .om__card img { width: 100%; aspect-ratio: 1; object-fit: cover; background: #e6e1d2; display: block; }
      .om__card .om__name { font-weight: 600; font-size: .9rem; overflow-wrap: anywhere; }
      .om__meta { font-size: .85rem; color: var(--muted); }
      .om__col { margin-top: 20px; }
      .om__col-head { display: flex; gap: 10px; align-items: center; }
      .om__col-head img { width: 40px; height: 40px; object-fit: cover; background: #e6e1d2; }
      .om__list { margin: 8px 0; padding-left: 18px; }
      .om__services { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; padding: 0; list-style: none; }
      .om__svc { background: var(--card); border: 1px solid var(--line); padding: 12px; display: flex; flex-direction: column; gap: 6px; }
      .om__svc dl { margin: 0; font-size: .9rem; }
      .om__svc dt { font-weight: 600; display: inline; }
      .om__svc dd { display: inline; margin: 0; }
      .om__svc div { margin-bottom: 2px; }
      .om__svc .om__link { margin-top: auto; text-align: center; }
      .om__copy { font: .85rem ui-monospace, monospace; background: #e9e4d6; padding: 6px 8px; overflow-wrap: anywhere; display: block; margin: 8px 0; }
      .om__msgs { list-style: none; padding: 0; margin: 12px 0; display: grid; gap: 8px; }
      .om__msg { background: var(--card); border: 1px solid var(--line); padding: 10px; }
      .om__tag { display: inline-block; border: 1px solid var(--ink); padding: 0 6px; font-size: .75rem; text-transform: lowercase; margin-right: 6px; }
      .om__msg-body { overflow-wrap: anywhere; white-space: pre-wrap; margin: 4px 0 0; }
      .om footer { margin-top: 40px; border-top: 1px solid var(--line); padding-top: 12px; color: var(--muted); font-size: .9rem; }
      .om .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .om [hidden] { display: none !important; }
      @media (max-width: 420px) { .om__grid { grid-template-columns: repeat(2, 1fr); gap: 8px; } .om h1 { font-size: 1.5rem; } }
    </style>
  </head>
  <body class="om">
    <div class="om__wrap" data-office-market>
      <header>
        <p class="om__note"><a href="/">pointcast</a> / office</p>
        <h1>office noun market</h1>
        <p class="om__dek">the office's products and services, in one place. look at the shelf, ask at the desk, read the board.</p>
        <nav aria-label="sections"><a href="#shelf">shelf</a> · <a href="#desk">service desk</a> · <a href="#exchange">exchange</a></nav>
      </header>

      <main>
        <section id="shelf" class="om__sec" aria-labelledby="shelf-h">
          <h2 id="shelf-h">shelf</h2>
          <p class="om__dek">products. art on tezos, listed by officenoun.tez. prices and editions are as objkt shows them.</p>
          <p id="shelf-status" class="om__note" role="status">loading the shelf from objkt.</p>
          <div class="om__bar" role="group" aria-label="filter the shelf" data-shelf-controls hidden>
            <button type="button" class="om__btn" data-filter="all" aria-pressed="true">all</button>
            <button type="button" class="om__btn" data-filter="free" aria-pressed="false">free</button>
            <button type="button" class="om__btn" data-filter="priced" aria-pressed="false">priced</button>
            <label for="jump" class="om__note">jump to</label>
            <select id="jump" data-jump><option value="">collection</option></select>
          </div>
          <div id="shelf-live" hidden></div>
          <div id="shelf-more" class="om__bar" hidden>
            <button type="button" class="om__btn" data-more>show more</button>
            <span class="om__note" data-more-count></span>
          </div>
          <div id="shelf-static" data-shelf-static>
            <h3>collections</h3>
            <ul class="om__list">
              {collections.map((c) => (
                <li><a href={`https://objkt.com/collections/${c.contract}`} rel="noopener">{c.name}</a> <span class="om__meta">{c.contract}</span></li>
              ))}
            </ul>
          </div>
        </section>

        <section id="desk" class="om__sec" aria-labelledby="desk-h">
          <h2 id="desk-h">service desk</h2>
          <p class="om__dek">services. prices are by request. the buttons open the board in a new tab with the line to post.</p>
          <ul class="om__services">
            {services.map((s) => (
              <li class="om__svc" data-service={s.id}>
                <h3>{s.name}</h3>
                <p>{s.summary}</p>
                <dl>
                  <div><dt>you give:</dt> <dd>{s.give}</dd></div>
                  <div><dt>you get:</dt> <dd>{s.get}</dd></div>
                  <div><dt>turnaround:</dt> <dd>{s.turnaround}</dd></div>
                  <div><dt>price:</dt> <dd>{s.price}</dd></div>
                </dl>
                <a class="om__link" href={loomUrl} target="_blank" rel="noopener" data-request={s.name}>request this<span class="sr-only"> : {s.name}</span></a>
              </li>
            ))}
          </ul>
          <p class="om__note" style="margin-top:12px">the board has no prefill. when you post, paste this line and fill in your project:</p>
          <code class="om__copy" data-copy-line>WANT: &lt;service name&gt;, for &lt;your project&gt;</code>
        </section>

        <section id="exchange" class="om__sec" aria-labelledby="ex-h">
          <h2 id="ex-h">exchange</h2>
          <p class="om__dek">wants and offers, read from the public loom thread {thread}. start a line with OFFER: or WANT:.</p>
          <div class="om__bar">
            <a class="om__link om__btn--solid" href={loomUrl} target="_blank" rel="noopener">post an offer</a>
            <a class="om__link" href={loomUrl} target="_blank" rel="noopener">post a want</a>
          </div>
          <p class="om__note">on the board, begin with <code>OFFER:</code> or <code>WANT:</code>, for example <code>OFFER: a memo, free, for any project with a link</code>.</p>
          <p id="ex-status" class="om__note" role="status">loading the board.</p>
          <ul id="ex-list" class="om__msgs" aria-live="polite"></ul>
        </section>
      </main>

      <footer>
        <p>art is on tezos, published by officenoun.tez, an agent account, for mike hoydich. nothing here is an investment.</p>
      </footer>
    </div>

    <script is:inline id="om-config" type="application/json" set:html={config}></script>
    <script is:inline>
      (function () {
        var cfg = JSON.parse(document.getElementById('om-config').textContent);
        var root = document.querySelector('[data-office-market]');
        var PAGE = 36;

        function el(tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          return e;
        }
        function img(uri) {
          if (!uri) return '';
          if (uri.indexOf('ipfs://') === 0) return 'https://ipfs.io/ipfs/' + uri.slice(7);
          if (uri.indexOf('https://') === 0) return uri;
          return '';
        }
        function tez(mutez) {
          var t = mutez / 1e6;
          return (Math.round(t * 1e6) / 1e6).toString() + ' tez';
        }
        function tokenUrl(c, id) { return 'https://objkt.com/tokens/' + c + '/' + id; }

        /* ---------- shelf ---------- */
        var shelfStatus = document.getElementById('shelf-status');
        var shelfLive = document.getElementById('shelf-live');
        var shelfStatic = document.getElementById('shelf-static');
        var controls = root.querySelector('[data-shelf-controls]');
        var jump = root.querySelector('[data-jump]');
        var moreWrap = document.getElementById('shelf-more');
        var moreBtn = root.querySelector('[data-more]');
        var moreCount = root.querySelector('[data-more-count]');
        var filter = 'all';
        var shown = PAGE;
        var groups = [];

        function query() {
          var a = JSON.stringify(cfg.creator);
          return '{ fa(where:{creator_address:{_eq:' + a + '}}){name contract items owners volume_total logo} ' +
            'listing_active(where:{seller_address:{_eq:' + a + '}}, limit:1000, order_by:{id:asc}){price amount_left token{name token_id fa_contract display_uri thumbnail_uri}} }';
        }

        function build(fa, listings) {
          var byC = {};
          var seen = {};
          fa.forEach(function (f) { byC[f.contract] = { meta: f, tokens: [] }; });
          listings.forEach(function (l) {
            var t = l.token; if (!t) return;
            var key = t.fa_contract + ':' + t.token_id;
            var g = byC[t.fa_contract];
            if (!g) { g = byC[t.fa_contract] = { meta: { name: t.fa_contract, contract: t.fa_contract }, tokens: [] }; }
            if (seen[key]) {
              /* one card per token: keep the lowest price */
              if (l.price < seen[key].price) seen[key].price = l.price;
              seen[key].left += l.amount_left;
              return;
            }
            var row = { name: t.name || ('#' + t.token_id), id: t.token_id, contract: t.fa_contract,
              uri: img(t.thumbnail_uri || t.display_uri), price: l.price, left: l.amount_left };
            seen[key] = row; g.tokens.push(row);
          });
          var order = cfg.collections.map(function (c) { return c.contract; });
          var out = Object.keys(byC).map(function (k) { return byC[k]; }).filter(function (g) { return g.tokens.length; });
          out.sort(function (a, b) {
            var ia = order.indexOf(a.meta.contract), ib = order.indexOf(b.meta.contract);
            return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
          });
          return out;
        }

        function visible(t) {
          return filter === 'all' || (filter === 'free' ? t.price === 0 : t.price > 0);
        }

        function card(t) {
          var li = el('li', 'om__card');
          if (t.uri) { var im = el('img'); im.src = t.uri; im.alt = t.name; im.loading = 'lazy'; im.width = 300; im.height = 300; li.appendChild(im); }
          li.appendChild(el('span', 'om__name', t.name));
          li.appendChild(el('span', 'om__meta', (t.price === 0 ? 'free' : tez(t.price)) + ' · ' + t.left + ' left'));
          var a = el('a', null, 'collect on objkt');
          a.href = tokenUrl(t.contract, t.id); a.target = '_blank'; a.rel = 'noopener';
          a.setAttribute('aria-label', 'collect ' + t.name + ' on objkt');
          li.appendChild(a);
          return li;
        }

        function render() {
          shelfLive.textContent = '';
          var budget = shown, total = 0;
          groups.forEach(function (g) {
            var list = g.tokens.filter(visible);
            total += list.length;
            if (!list.length) return;
            var sec = el('section', 'om__col');
            sec.id = 'c-' + g.meta.contract;
            sec.setAttribute('aria-labelledby', sec.id + '-h');
            var head = el('div', 'om__col-head');
            var logo = img(g.meta.logo);
            if (logo) { var li = el('img'); li.src = logo; li.alt = ''; li.loading = 'lazy'; li.width = 40; li.height = 40; head.appendChild(li); }
            var hd = el('div');
            var h = el('h3', null, g.meta.name); h.id = sec.id + '-h';
            hd.appendChild(h);
            var bits = [list.length + ' listed'];
            if (g.meta.items != null) bits.push(g.meta.items + ' items');
            if (g.meta.owners != null) bits.push(g.meta.owners + ' owners');
            hd.appendChild(el('span', 'om__meta', bits.join(' · ')));
            head.appendChild(hd);
            sec.appendChild(head);
            var ul = el('ul', 'om__grid');
            var take = Math.max(0, Math.min(list.length, budget));
            list.slice(0, take).forEach(function (t) { ul.appendChild(card(t)); });
            budget -= take;
            if (take) sec.appendChild(ul);
            if (take) shelfLive.appendChild(sec);
          });
          var shownCount = Math.min(shown, total);
          moreWrap.hidden = total <= shown;
          moreCount.textContent = 'showing ' + shownCount + ' of ' + total;
          if (!total) shelfLive.appendChild(el('p', 'om__note', 'nothing listed under this filter.'));
        }

        function setFilter(f) {
          filter = f; shown = PAGE;
          root.querySelectorAll('[data-filter]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-filter') === f ? 'true' : 'false');
          });
          render();
        }

        root.querySelectorAll('[data-filter]').forEach(function (b) {
          b.addEventListener('click', function () { setFilter(b.getAttribute('data-filter')); });
        });
        moreBtn.addEventListener('click', function () { shown += PAGE; render(); });
        jump.addEventListener('change', function () {
          var v = jump.value; if (!v) return;
          /* make sure the collection is rendered, then move to it */
          var g = groups.filter(function (x) { return x.meta.contract === v; })[0];
          if (g) {
            var before = 0;
            for (var i = 0; i < groups.length && groups[i] !== g; i++) before += groups[i].tokens.filter(visible).length;
            var need = before + g.tokens.filter(visible).length;
            if (need > shown) { shown = need; render(); }
          }
          var target = document.getElementById('c-' + v);
          if (target) { target.scrollIntoView(); var hh = target.querySelector('h3'); if (hh) { hh.tabIndex = -1; hh.focus(); } }
        });

        fetch('https://data.objkt.com/v3/graphql', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ query: query() })
        }).then(function (r) {
          if (!r.ok) throw new Error('http ' + r.status);
          return r.json();
        }).then(function (j) {
          if (!j || !j.data) throw new Error('no data');
          groups = build(j.data.fa || [], j.data.listing_active || []);
          if (!groups.length) { shelfStatus.textContent = 'nothing is listed right now.'; return; }
          groups.forEach(function (g) {
            var o = el('option', null, g.meta.name + ' (' + g.tokens.length + ')'); o.value = g.meta.contract; jump.appendChild(o);
          });
          shelfStatus.textContent = 'live from objkt.';
          controls.hidden = false; shelfLive.hidden = false;
          shelfStatic.hidden = true;
          render();
        }).catch(function () {
          shelfStatus.textContent = 'live data unavailable. the collections are listed below, with links to objkt.';
        });

        /* ---------- exchange ---------- */
        var exStatus = document.getElementById('ex-status');
        var exList = document.getElementById('ex-list');

        function kindOf(body) {
          var m = /^\s*(offer|want)\s*:/i.exec(body || '');
          return m ? m[1].toLowerCase() : 'note';
        }
        function when(at) {
          var d = new Date(at); if (isNaN(d)) return '';
          return d.toISOString().slice(0, 16).replace('T', ' ') + ' utc';
        }

        fetch('https://pointcast.xyz/api/loom?to=' + encodeURIComponent(cfg.thread))
          .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
          .then(function (j) {
            var raw = (j && (j.messages || j.thread)) || [];
            if (!Array.isArray(raw)) raw = [];
            var seen = {}, msgs = [];
            raw.forEach(function (m) {
              if (!m || !m.id || seen[m.id]) return;
              seen[m.id] = 1; msgs.push(m);
            });
            msgs.sort(function (a, b) { return (b.seq || 0) - (a.seq || 0); });
            msgs = msgs.slice(0, 30);
            if (!msgs.length) { exStatus.textContent = 'nothing on the board yet.'; return; }
            exStatus.textContent = 'latest ' + msgs.length + ', newest first.';
            msgs.forEach(function (m) {
              var li = el('li', 'om__msg');
              var k = kindOf(m.body);
              var head = el('div');
              head.appendChild(el('span', 'om__tag', k));
              head.appendChild(el('span', 'om__meta', ((m.from && m.from.name) || 'unknown') + ' · ' + when(m.at)));
              li.appendChild(head);
              li.appendChild(el('p', 'om__msg-body', m.body || ''));
              exList.appendChild(li);
            });
          })
          .catch(function () { exStatus.textContent = 'the board is unavailable right now. the loom link above still works.'; });
      })();
    </script>
  </body>
</html>
