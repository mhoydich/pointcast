---
/**
 * /breakwater — a breakout for the 8-bit heart.
 *
 * Brief by Michael Hoydich, 2026-10-22: 80s innocence, the joy of the compute
 * and flow, start very breakout, mood-state symbiosis, mobile and full screen,
 * audio-visual multimedia, Atari and Commodore inspired, rendered modern.
 *
 * Everything in the playfield is drawn from a 3x5 pixel font and plain rects on
 * a canvas; every sound is synthesized in the browser. Pure logic lives in
 * src/lib/breakwater (font, waves, mood) and is covered by tests/breakwater.test.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';

const description = 'A breakout game with 1980s innocence: Atari 800XL or Commodore 64 blue, a wall of fourteen by eight, synthesized chip sound, and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/breakwater';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Breakwater',
      alternateName: 'Breakwater: a breakout for the 8-bit heart',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/breakwater/og.png',
      gamePlatform: 'Web browser',
      genre: 'Breakout',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Breakwater', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Breakwater"
  description={description}
  image="/images/breakwater/og.png"
  imageAlt="A blue playfield with a rainbow wall of bricks, a gold paddle and a white ball beside the words Breakwater, a breakout for the 8-bit heart."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/breakwater.json', title: 'Breakwater rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/breakwater/og.png',
    buttons: [
      { label: 'Play Breakwater', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="bw" data-bw data-machine="xl" data-crt="on">
    <div class="bw-stage" data-stage>
      <header class="bw-bar">
        <a class="bw-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="bw-name" aria-hidden="true">BREAKWATER</span>
        <div class="bw-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="bw-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Breakwater playfield. Steer the paddle, tap or press space to launch."></canvas>
        <div class="bw-scan" aria-hidden="true"></div>
        <noscript><p class="bw-noscript">Breakwater needs JavaScript to draw the wall and make its sounds. The rules and moods are readable at <a href="/breakwater.json">/breakwater.json</a>.</p></noscript>
      </div>
      <footer class="bw-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-wave>WAVE 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-vec>V 0,0</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="bw-notes">
      <p class="bw-eyebrow">PointCast / Games / Breakwater</p>
      <h1>A breakout for the 8-bit heart.</h1>
      <p class="bw-lede">Fourteen columns, eight rows, a paddle that follows your finger, and a wall that answers how you play. Pick the blue you grew up with.</p>

      <div class="bw-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Rallies raise its <strong>energy</strong>. A lost ball lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="bw-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major arpeggio, a slightly wide paddle.</li>
            <li><b>FLOW</b> a long rally. Bright colors, the music opens up.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, faster tempo, and in a long rally a second ball.</li>
            <li><b>DRIFT</b> after losses. The paddle widens, the ball slows, the notes thin out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.blurb.toLowerCase().replace(/\.$/, '')}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue text. Raw square waves with a noise bite, in the POKEY spirit. A blue READY and a RUN before the wall.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The pixel font, the six wall patterns, the music and the palettes were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-breakwater-c64-atari-800xl.md">research note on both machines</a>, or visit the <a href="/atari-bbs">Death Star BBS</a>, Mike's own Atari 8-bit history.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Two rows each of red (7), orange (5), green (3) and yellow (1), the 1976 arcade's own scoring. The ball speeds up after the fourth and twelfth hit of a wave and when it first touches orange and red. Three balls; an extra ball every 400 points; no game over on CALM. Six wall patterns cycle, and one spells your machine.</p>
          <h2>Controls</h2>
          <ul>
            <li>Move the mouse or drag anywhere on the field. Tap or click to launch.</li>
            <li>Keys: ← → or A D steer, Space launches, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="bw-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026. Original code, art and synthesized sound; no ROMs, no recordings. Machine names are tributes.</p>
        <p><a href="/cabinet-row">Cabinet Row</a> · <a href="/breakwater.json">breakwater.json</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .bw { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .bw[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .bw-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .bw-stage:fullscreen { height: 100%; min-height: 0; }
  .bw-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .bw-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .bw-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .bw-home:hover { color: #fff; }
  .bw-name { color: #fff; font-weight: 700; margin-right: auto; }
  .bw-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .bw-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .bw-controls button:hover { background: #1f2456; }
  .bw-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .bw-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .bw-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .bw-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .bw-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .bw[data-crt='off'] .bw-scan { display: none; }
  .bw-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .bw-noscript a { color: var(--paddle); }
  .bw-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .bw-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .bw-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .bw-readout a:hover { color: #fff; }
  .bw-stage:fullscreen .bw-readout a { display: none; }
  .bw-stage:-webkit-full-screen .bw-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bw-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .bw-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .bw-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .bw-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .bw-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .bw-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .bw-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .bw-grid h2 + h2, .bw-grid p + h2, .bw-grid ul + h2 { margin-top: 22px; }
  .bw-grid p { margin: 0 0 12px; }
  .bw-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .bw-grid li { margin-bottom: 6px; }
  .bw-moods { list-style: none; padding: 0; }
  .bw-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .bw-notes a { color: #a9b9f5; }
  .bw-notes a:hover { color: #fff; }
  .bw-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .bw-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .bw-stage { min-height: 0; }
    .bw-bar { gap: 8px; padding: 6px 10px; }
    .bw-name { display: none; }
    .bw-controls { gap: 4px; }
    .bw-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .bw-readout { gap: 10px; font-size: 9px; height: 26px; }
    .bw-readout [data-r-vec], .bw-readout [data-r-fps] { display: none; }
    .bw-grid { grid-template-columns: 1fr; gap: 20px; }
    .bw-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .bw-scan { opacity: 0.35; } }
</style>

<script>
  import { COLS, ROWS, MACHINES, MACHINE_IDS, buildWave, speedStepsFor } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, LABELS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';

  const root = document.querySelector('[data-bw]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = 288, H_MIN = 384, H_MAX = 480, WALL = 8, HUD = 32;
    let H = H_MIN;
    const BW = 18, BH = 8, PX = 19, PY = 10, GRID_X = 11, GRID_Y = 48;
    let PADDLE_Y = H - 32;
    const PADDLE_H = 6, PADDLE_W = 40, BALL = 4;
    const BASE_SPEED = 150, MAX_SPEED = 340, EXTRA_EVERY = 400;
    const STORE = 'breakwater:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      wave: root.querySelector('[data-r-wave]'),
      fps: root.querySelector('[data-r-fps]'),
      vec: root.querySelector('[data-r-vec]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) ? settings.best : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      const PROG = {
        major: [[60, 64, 67, 72], [57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67]],
        bright: [[60, 64, 67, 71], [62, 66, 69, 74], [65, 69, 72, 76], [67, 71, 74, 78]],
        minor: [[57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67], [57, 60, 64, 69]],
        soft: [[60, 67, 72, 76], [53, 60, 65, 69], [57, 64, 69, 72], [55, 62, 67, 71]],
      };
      const ARP = [0, 1, 2, 3, 2, 1, 0, 2];
      const PENTA = [0, 2, 4, 7, 9, 12, 14, 16, 19, 21, 24, 26, 28, 31];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.32; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 2400; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const lead = () => (machineId === 'c64' ? 'square' : 'square');
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        if (idx % 8 === 0) voice({ freq: midi(chord[0] - 24), type: bass(), t, dur: 0.22, vol: 0.18, dest: music, r: 0.08 });
        const gate = scale === 'soft' ? 0.35 : 0.55 + density * 0.45;
        if (Math.random() < gate) {
          const n = chord[ARP[idx % ARP.length]] + (scale === 'minor' && idx % 4 === 2 ? 12 : 0);
          voice({ freq: midi(n), type: lead(), t, dur: scale === 'soft' ? 0.2 : 0.09, vol: scale === 'soft' ? 0.09 : 0.11, dest: music, r: 0.04, detune: machineId === 'xl' ? 4 : 0 });
        }
        if (scale === 'minor' && (idx === 4 || idx === 12)) noise(t, 0.03, 0.05);
      }
      function schedule() {
        if (!ac || !musicOn) return;
        // A throttled interval (hidden tab) must not replay every missed step as one burst.
        if (nextNote < ac.currentTime - 0.1) { nextNote = ac.currentTime + 0.05; step += 1; }
        while (nextNote < ac.currentTime + 0.14) {
          playStep(step, nextNote);
          nextNote += 60 / tempo / 4;
          step += 1;
        }
      }
      function setMusic(on) {
        wantMusic = on;
        if (!ac) return;
        if (on && !musicOn) { musicOn = true; nextNote = ac.currentTime + 0.05; step = 0; clearInterval(timer); timer = setInterval(schedule, 30); }
        else if (!on && musicOn) { musicOn = false; clearInterval(timer); }
      }
      return {
        unlock() {
          ensure();
          if (ac && ac.state === 'suspended') ac.resume().catch(() => {});
          // Music asked for before the first gesture (the title screen) starts now.
          if (ac && wantMusic && !musicOn) setMusic(true);
        },
        setMusic,
        wantsMusic: () => wantMusic,
        set(t, sc, d) { tempo = t; scale = sc; density = d; },
        mute(off) { if (master) master.gain.setTargetAtTime(off ? 0 : 0.55, ac.currentTime, 0.02); },
        brick(c, r) {
