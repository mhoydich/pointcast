---
/**
 * /drum-offering — visitor intentions archive.
 *
 * Sprint 3, surface 3 of Guest Receivers. Visitor types one short
 * intention (≤80 chars), the chamber records it with their pid +
 * Noun + hue + timestamp. The page renders the most recent 60
 * offerings as a flowing list of tiles.
 *
 * Backed by /api/chamber kind=offering.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Offering · Intentions Archive · PointCast';
const description =
  'Leave one short intention. The chamber records it with your Noun and hue. 60-tile rolling archive.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Offering',
  url: 'https://pointcast.xyz/drum-offering',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dof" id="dof-main">
    <DrumNav current="offering" />

    <header class="dof__header">
      <div class="dof__chrome">
        <span>OFFERING</span>
        <span class="dof__chrome-sep">·</span>
        <span><span id="dof-count">0</span> IN ARCHIVE</span>
      </div>
      <h1 class="dof__title">OFFERING</h1>
      <p class="dof__tagline">leave one short intention · the chamber will hold it</p>
    </header>

    <section class="dof__form">
      <input class="dof__input" id="dof-input" type="text" maxlength="80" placeholder="one short intention" />
      <button class="dof__btn" id="dof-leave" type="button">LEAVE</button>
    </section>

    <section class="dof__grid" id="dof-grid">
      <div class="dof__empty">— first offering, then it will fill —</div>
    </section>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dof-main) { background: #0c0410; }
  .dof {
    --dof-velvet: #1a0820; --dof-velvet-deep: #0c0410;
    --dof-brass: #d4a437; --dof-brass-deep: #6b4d12;
    --dof-flame: #f6c15e;
    --dof-ink-light: #f4e7c8; --dof-ink-mid: #c9b78c; --dof-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dof-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--dof-velvet) 0%, var(--dof-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .dof .drum-nav { opacity: 0.40; transform: scale(0.85); transform-origin: top left; margin-bottom: clamp(6px, 0.6vh, 12px); }

  .dof__header { text-align: center; padding: clamp(8px, 1vh, 18px) 0 clamp(20px, 3vh, 32px); }
  .dof__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--dof-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--dof-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .dof__chrome-sep { color: var(--dof-brass-deep); }
  #dof-count { color: var(--dof-flame); font-weight: 700; }

  .dof__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--dof-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--dof-velvet-deep);
  }
  .dof__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--dof-ink-mid);
  }

  .dof__form {
    max-width: 560px; margin: 0 auto clamp(28px, 4vh, 44px);
    display: flex; gap: 12px;
  }
  .dof__input {
    appearance: none; flex: 1;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.4);
    border: 1.5px solid var(--dof-brass-deep);
    color: var(--dof-flame);
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: 16px; outline: none;
  }
  .dof__input:focus { border-color: var(--dof-brass); }
  .dof__input::placeholder { color: var(--dof-ink-dim); opacity: 0.55; }

  .dof__btn {
    appearance: none; border: 0; cursor: pointer;
    padding: 12px 24px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px; font-weight: 800; letter-spacing: 0.22em;
    color: var(--dof-velvet-deep);
    background: linear-gradient(180deg, var(--dof-brass) 0%, oklch(0.62 0.18 60) 100%);
    box-shadow: 0 0 0 2px var(--dof-velvet-deep), 0 4px 0 0 var(--dof-brass-deep), 0 4px 16px rgba(212, 164, 55, 0.30);
  }
  .dof__btn:hover { background: linear-gradient(180deg, #efbb46 0%, var(--dof-brass) 100%); }
  .dof__btn:active, .dof__btn:disabled {
    transform: translateY(3px);
    box-shadow: 0 0 0 2px var(--dof-velvet-deep), 0 1px 0 0 var(--dof-brass-deep), 0 0 18px rgba(246, 193, 94, 0.55);
  }

  .dof__grid {
    max-width: 1080px; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(10px, 1.5vw, 18px);
  }
  .dof__empty {
    grid-column: 1/-1;
    text-align: center; padding: 40px;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    color: var(--dof-ink-dim);
  }
  .dof__tile {
    display: flex; align-items: stretch; gap: 10px;
    padding: 12px 14px;
    border: 1.5px solid var(--dof-brass-deep);
    border-left-width: 4px;
    border-left-color: oklch(0.65 0.20 var(--tile-hue, 60));
    background: linear-gradient(180deg, rgba(44, 13, 54, 0.55), rgba(12, 4, 16, 0.78));
  }
  .dof__tile-noun {
    width: 40px; height: 40px;
    image-rendering: pixelated;
    background: rgba(0, 0, 0, 0.30);
    border: 1px solid var(--dof-brass-deep);
    flex-shrink: 0;
  }
  .dof__tile-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dof__tile-text {
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: 14px; color: var(--dof-ink-light);
    line-height: 1.4; word-wrap: break-word;
  }
  .dof__tile-meta-bottom {
    display: flex; gap: 8px; margin-top: 2px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px; letter-spacing: 0.16em; color: var(--dof-ink-dim); text-transform: uppercase;
  }
</style>

<script>
  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) { sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem(SID_KEY, sid); }
      return sid;
    } catch { return 'sid-anon-' + Date.now(); }
  }
  const SID = ensureSid();

  const inputEl = document.getElementById('dof-input');
  const btnEl = document.getElementById('dof-leave');
  const countEl = document.getElementById('dof-count');
  const gridEl = document.getElementById('dof-grid');

  function fmtAgo(t) {
    const sec = Math.max(0, Math.floor((Date.now() - t) / 1000));
    if (sec < 60) return 'just now';
    const m = Math.floor(sec / 60);
    if (m < 60) return `${m}m ago`;
    if (m < 60 * 24) return `${Math.floor(m / 60)}h ago`;
    return `${Math.floor(m / 60 / 24)}d ago`;
  }

  function paint(state) {
    if (!state) return;
    const offerings = state.offerings || [];
    if (countEl) countEl.textContent = String(offerings.length);
    if (!gridEl) return;
    if (offerings.length === 0) {
      gridEl.innerHTML = '<div class="dof__empty">— first offering, then it will fill —</div>';
      return;
    }
    gridEl.innerHTML = '';
    offerings.forEach((o) => {
      const tile = document.createElement('div');
      tile.className = 'dof__tile';
      tile.style.setProperty('--tile-hue', String(o.hue));
      tile.innerHTML = `
        <img class="dof__tile-noun" src="https://noun.pics/${o.nounId}.svg" alt="" />
        <div class="dof__tile-meta">
          <span class="dof__tile-text">${escapeHtml(o.intention)}</span>
          <span class="dof__tile-meta-bottom">
            <span>${o.pid.slice(0, 6)}…</span>
            <span>${fmtAgo(o.t)}</span>
          </span>
        </div>
      `;
      gridEl.appendChild(tile);
    });
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
  }

  async function fetchState() {
    try {
      const r = await fetch('/api/chamber?kind=offering', { cache: 'no-store' });
      const j = await r.json();
      if (j?.ok) paint(j.state);
    } catch {}
  }

  async function leave() {
    const intention = (inputEl?.value || '').trim().slice(0, 80);
    if (!intention) { if (inputEl) inputEl.focus(); return; }
    if (btnEl) btnEl.disabled = true;
    try {
      const r = await fetch('/api/chamber', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'offering', action: 'leave', sessionId: SID, intention }),
      });
      const j = await r.json();
      if (j?.ok) {
        if (inputEl) inputEl.value = '';
        paint(j.state);
      }
    } catch {}
    if (btnEl) btnEl.disabled = false;
  }

  btnEl?.addEventListener('click', leave);
  inputEl?.addEventListener('keydown', (e) => { if (e.key === 'Enter') leave(); });
  fetchState();
  setInterval(fetchState, 8000);
</script>
