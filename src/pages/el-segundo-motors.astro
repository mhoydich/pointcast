---
import '@fontsource-variable/inter';
import SegundoLine from '../components/SegundoLine.astro';
import '../styles/el-segundo-motors.css';
import artwork from '../data/el-segundo-motors-artwork.json';

const title = 'The Segundo Line · El Segundo Motors';
const originalDek = 'A European-luxury, beach-friendly electric car brand for the town that builds satellites: co-produced with residents, coordinated by AI, paid in Blue Notes.';
const dek = 'One pod is a ride. Eight pods are a train. The Segundo Line: El Segundo Motors’ modular people-mover concept. Targets, not promises.';
const byline = 'Claude Opus 5.5 + Codex (GPT-6.1 Sol), for Michael Hoydich';
const lineCredits = 'Michael Hoydich with Claude Opus 5.5, Claude Sonnet 5.5, Claude Haiku 5.5, Claude Fable 5.1, ChatGPT image generation and Codex';
const canonical = 'https://pointcast.xyz/el-segundo-motors/';
const art = (role: string) => {
  const image = artwork.images.find((item) => item.role === role);
  if (!image) throw new Error(`Missing El Segundo Motors artwork: ${role}`);
  return image;
};
const vista = art('vista');
const lineup = [
  { name: 'Strand', role: 'strand', kind: 'The beach runabout', spec: '25 mph design target · open air', copy: 'A small, open-air second car for the local loop: beach gear, market bags, a slow arrival. Dune sand, brushed aluminum and a canopy that belongs to the coast.' },
  { name: 'Allyni', role: 'allyni', kind: 'The city pod', spec: 'Two seats · a smaller daily footprint', copy: 'Named for the El Segundo blue butterfly, Allyni imagines two seats and just enough car for the short trip. A friendly face for Main Street, in Butterfly Blue.' },
  { name: 'Dockweiler', role: 'dockweiler', kind: 'The camp wagon', spec: 'Long roof · shared evenings', copy: 'Coachwork for the things that make a place worth staying: a tailgate, a camp meal, a dry place for the gear. The destination becomes a gathering.' },
  { name: 'Lumen', role: 'lumen', kind: 'The working microtruck', spec: 'Cargo rail · proposed mobile power', copy: 'A little truck with a second job: carrying the tools, then becoming a mobile power plant for the workshop, the pop-up or the evening outside.' },
];
const pods = ['Beach', 'Surf', 'Market', 'Cargo', 'Camp', 'Galley', 'Workshop', 'Garden', 'Stage', 'Light', 'Access', 'Field Lab'];
const phases = [
  { phase: '0', title: 'Rail first', text: 'Define interfaces. Make the Rail, Cell and Motor Module questions testable before dressing them as a car.', gate: 'Earn: independently reviewed architecture and a safe prototype plan.' },
  { phase: '1', title: 'Strand + Allyni fleets', text: 'Propose small, supervised local fleets. Learn from actual short-trip needs before adding breadth.', gate: 'Earn: applicable approvals, safety validation and demonstrated use.' },
  { phase: '2', title: 'Dockweiler + Lumen', text: 'Add camp and work coachwork only after the common platform has proved useful.', gate: 'Earn: maintainability, dependable supply and a credible operating model.' },
  { phase: '3', title: 'Vista + chapters', text: 'Commission the grand tourer and let other places adapt the chapter model.', gate: 'Earn: a durable first chapter before inviting the next.' },
];
const campaigns = [
  ['The Luxury of Twenty-Five', 'An invitation to design a better short trip, rather than a faster long one.'],
  ['Built where satellites are born', 'An invitation to bring the town’s precision, patience and making culture down to street level.'],
  ['Plug in the party', 'An invitation to imagine energy as something that supports a gathering.'],
  ['Link Six', 'An invitation to turn six parked cars into one table and one shared sound system.'],
  ['Your time is the currency', 'An invitation to recognize a contribution before talking about a transaction.'],
];
const notes = [
  { segundos: 60, label: 'Minute', time: 'One minute' },
  { segundos: 600, label: 'Ten Minutes', time: 'Ten minutes' },
  { segundos: 3600, label: 'Hour', time: 'One hour' },
  { segundos: 86400, label: 'Day', time: 'Twenty-four hours' },
];
const agents = ['Listen & research', 'Frame the brief', 'Develop the design', 'Explore the engineering', 'Coordinate the making', 'Review access & impact', 'Document the evidence', 'Convene the next decision'];
const studios = ['Coachwork & form', 'Rail, Cells & energy', 'Pods & everyday use', 'Making & repair', 'Advertising & coordination', 'Time notes & contribution'];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: dek,
  datePublished: '2026-10-17', dateModified: '2026-10-18', url: canonical,
  author: { '@type': 'Person', name: 'Michael Hoydich' },
  creditText: lineCredits + '. Supplied creative credits; model use not independently verified.',
  about: 'Speculative community vehicle design concept',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={dek} />
    <meta name="author" content={lineCredits} />
    <meta name="theme-color" content="#182b3c" />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dek} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={dek} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="esm-skip" href="#main-content">Skip to the case study</a>
    <header class="esm-masthead esm-wrap">
      <a href="/" aria-label="PointCast homepage">PointCast <span aria-hidden="true">↗</span></a>
      <p>Pacific Coachwork</p>
      <a href="/b/0702">CH.ESC · 0702</a>
    </header>
    <main id="main-content">
      <article>
        <SegundoLine />
        <header class="esm-hero esm-wrap" id="motors-original">
          <p class="esm-kicker">University of El Segundo · Case No. 001</p>
          <h2 class="esm-original-title">El Segundo<br />Motors<span class="esm-heading-note">The second car. A first principle.</span></h2>
          <p class="esm-dek">{originalDek}</p>
          <p class="esm-byline">Guest byline: {byline}<br /><time datetime="2026-10-17">17 October 2026</time></p>
          <p class="esm-concept-label">A speculative concept. Vehicles unbuilt; Blue Notes proposed as collectible contribution receipts.</p>
          <a class="esm-forward" href="#the-second">Read the case <span aria-hidden="true">↓</span></a>
        </header>
        <figure class="esm-hero-art">
          <img src={vista.src} srcset={vista.srcSet} sizes="100vw" alt={vista.alt} width={vista.width} height={vista.height} fetchpriority="high" decoding="async" />
          <figcaption class="esm-wrap"><span>Vista · commission-only grand tourer concept</span><span>{artwork.credit}</span></figcaption>
        </figure>
        <nav class="esm-contents esm-wrap" aria-label="Case study sections">
          <a href="#the-second">01 The Second</a><a href="#lineup">02 Lineup</a><a href="#rail">03 Segundo Rail</a><a href="#moonshot">04 Moonshot</a><a href="#advertising">05 Advertising</a><a href="#blue-notes">06 Blue Notes</a><a href="#university">07 University</a><a href="#made-by">08 Made by</a>
        </nav>

        <section class="esm-section esm-wrap esm-editorial" id="the-second" aria-labelledby="second-title">
          <div class="esm-section-label"><span>01 / The Second</span><h2 id="second-title">A town named<br />for a second.</h2></div>
          <div class="esm-prose"><p class="esm-lead">El Segundo’s name recalls Standard Oil’s second refinery, established here in 1911. A second was enough to name a town. What else might a second make possible?</p><p>Start with the second car in a Beach Cities driveway: the one imagined here for the short local trips, the market stop, the beach gear, the small errand that never needed a large machine.</p><p>El Segundo Motors proposes building that car the way a watchmaker builds a second hand. A modest task, treated precisely. Something European in proportion, coastal in temperament and useful enough to become part of an ordinary day.</p><p>This is a brand and a company imagined together: residents as co-producers, AI as a coordinator, and the town that builds satellites as a place to learn how to make something smaller.</p></div>
        </section>

        <section class="esm-section esm-wrap" id="lineup" aria-labelledby="lineup-title">
          <div class="esm-section-label"><span>02 / The lineup</span><h2 id="lineup-title">Five ways to<br />be a second car.</h2></div>
          <div class="esm-lineup-grid">{lineup.map((vehicle) => { const image = art(vehicle.role); return <section class="esm-vehicle" aria-labelledby={`vehicle-${vehicle.role}`}><figure><img src={image.src} srcset={image.srcSet} sizes="(max-width: 720px) 100vw, 50vw" alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><figcaption>{image.credit}</figcaption></figure><div class="esm-vehicle-copy"><p class="esm-kicker">{vehicle.kind}</p><h3 id={`vehicle-${vehicle.role}`}>{vehicle.name}</h3><p class="esm-spec">{vehicle.spec}</p><p>{vehicle.copy}</p></div></section>; })}</div>
          <div class="esm-vista-note"><h3>And then, Vista.</h3><p>The commission-only grand tourer in the opening image is the long view: quiet coachwork, a low roof and the coast at the end of the day. It belongs to Phase 3, after the everyday vehicles have earned their place.</p></div>
          <p class="esm-small">All five are design concepts. The 25 mph target does not establish road legality, safety approval or beach access. No vehicle is offered for sale.</p>
        </section>

        <section class="esm-section esm-rail" id="rail" aria-labelledby="rail-title"><div class="esm-wrap">
          <div class="esm-section-label"><span>03 / Segundo Rail</span><h2 id="rail-title">One channel.<br />Many possibilities.</h2></div>
          <div class="esm-rail-intro"><p class="esm-lead">Begin with one aluminum channel: a common interface for a small family of machines.</p><p>The proposed Segundo Rail is the organizing idea, rather than a finished engineering solution. Swappable <strong>Cells</strong> target charging from an ordinary <strong>120 V outlet</strong>. A removable <strong>Motor Module</strong> is imagined powering other machines as well as a car.</p><p><strong>Link</strong> is the social architecture: six cars, one table, one sound system. A parking arrangement becomes a place to stay.</p></div>
          <div class="esm-pods"><h3>Twelve snap-on Pods</h3><ol>{pods.map((pod) => <li>{pod}</li>)}</ol></div>
          <div class="esm-rfcs"><h3>Open RFCs · questions before answers</h3><details><summary>RFC 001 — What should the Rail standardize?</summary><p>Explore interface geometry, loads, repair access and an understandable way to identify compatible Pods. Proposed discussion only; no dimensions or build-ready specification are published.</p></details><details><summary>RFC 002 — What makes a Cell practical?</summary><p>Have qualified engineers examine weight, handling, charging protection, thermal behavior and the full safety case. The 120 V idea is a target to investigate, not a validated charging instruction.</p></details><details><summary>RFC 003 — What does Link need to share?</summary><p>Separate a shared table and sound experience from the much harder questions of electrical connection, access, consent and public-space use. Establish those boundaries before a demonstration.</p></details></div>
          <p class="esm-small">Rail, Cells, Pods, Link and the Motor Module remain proposals. Engineering, testing and applicable approvals must precede use.</p>
        </div></section>

        <section class="esm-section esm-wrap" id="moonshot" aria-labelledby="moonshot-title"><div class="esm-section-label"><span>04 / The moonshot</span><h2 id="moonshot-title">Retire the Beach Cities’<br />second car by 2032.</h2></div><p class="esm-lead esm-measure">An ambition, not a delivery date. Make the smaller machine useful enough that a household can choose it. Each phase must earn the next.</p><ol class="esm-phases">{phases.map((phase) => <li><span class="esm-phase-number">{phase.phase}</span><div><h3>{phase.title}</h3><p>{phase.text}</p><p class="esm-phase-gate">{phase.gate}</p></div></li>)}</ol></section>

        <section class="esm-section esm-advertising" id="advertising" aria-labelledby="advertising-title"><div class="esm-wrap"><div class="esm-section-label"><span>05 / Hoydich Advertising</span><h2 id="advertising-title">Every ad is<br />an invitation.</h2></div><p class="esm-lead esm-measure">Advertising as coordination: help the right neighbors find the right question, the right tool, the right next piece of work.</p><div class="esm-campaigns">{campaigns.map(([name, copy]) => <section><h3>{name}</h3><p>{copy}</p></section>)}</div><p class="esm-small">Proposed campaign concepts. No submissions, sign-ups or tracking on this page.</p></div></section>

        <section class="esm-section esm-wrap" id="blue-notes" aria-labelledby="notes-title"><div class="esm-section-label"><span>06 / Blue Notes</span><h2 id="notes-title">A second of time.<br />A note of thanks.</h2></div><div class="esm-notes-intro"><p class="esm-lead">In the concept, a Segundo represents one second of contributed time.</p><p>The imagined time currency makes a contribution legible: a sketch, a repair, a lesson, a careful hour. Edition one is proposed as collectible contribution receipts, labeled <strong>Community Time Note — Not Legal Tender</strong>.</p></div>{(() => {const image=art('blue-notes');return <figure class="esm-note-art"><img src={image.src} srcset={image.srcSet} sizes="(max-width: 720px) 100vw, 90vw" alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><figcaption>{image.credit} · Illustrated QR marks are decorative and unverified.</figcaption></figure>})()}<dl class="esm-denominations">{notes.map((note) => <div><dt>{note.segundos.toLocaleString('en-US')} <span>Segundos</span></dt><dd>{note.label}<small>{note.time}</small></dd></div>)}</dl><p class="esm-note-boundary">Community Time Note. Not legal tender. Collectible concept artwork, with no cash value, backing or redemption promise. No note issuance, payroll or payment service is activated here.</p></section>

        <section class="esm-section esm-university" id="university" aria-labelledby="university-title"><div class="esm-wrap"><div class="esm-section-label"><span>07 / University of El Segundo</span><h2 id="university-title">The town is the campus.<br />The company is the lab.<br />The work is the curriculum.</h2></div><p class="esm-lead esm-measure">A proposed independent learning model: learn in public by making something useful, documenting the decisions and letting the evidence change the plan.</p><div class="esm-ues-grid"><div><h3>Surge protocol</h3><p>Frame a question. Form a small team. Make a bounded experiment. Review what happened. Publish the learning. Decide whether to continue.</p><p>Eight proposed AI roles support the loop. Humans approve the brief, review engineering and impact, authorize any real-world action and decide whether a phase advances.</p><ol class="esm-agent-roles">{agents.map((agent) => <li>{agent}</li>)}</ol></div><div><h3>Six studios</h3><ol class="esm-studios">{studios.map((studio) => <li>{studio}</li>)}</ol><p class="esm-small">A concept curriculum, not an operating accredited university, an enrolled program or a claim that these teams already exist.</p></div></div></div></section>

        <section class="esm-section esm-wrap esm-made-by" id="made-by" aria-labelledby="made-title"><div class="esm-section-label"><span>08 / Made by</span><h2 id="made-title">A guest collaboration.<br />For Michael Hoydich.</h2></div><p class="esm-lead">Claude Opus 5.5 + Codex (GPT-6.1 Sol)</p><div class="esm-credits"><p>The creative roster credited in the supplied concept brief:</p><ul><li>Claude Opus 5.5 — orchestrator, with Claude Fable 5.1, Sonnet 5.5 and Haiku 5.5</li><li>ChatGPT image generation — the six concept illustrations shown here, 17 October 2026</li><li>Midjourney V8 · Ideogram · ElevenLabs Music v2.5</li><li>Codex GPT-6.1 Sol — PointCast page and publication collaboration</li></ul><p class="esm-small">Roster and model labels are guest-supplied creative credits, not an independent verification of every named model or tool’s use. No audio is embedded on this page.</p></div><blockquote><p>“God bless us all.”</p><cite>Michael Hoydich and Opus 5.5</cite></blockquote>
          <details class="esm-sources"><summary>Factual references &amp; image credits</summary><ul><li><a href="https://elsegundo.chevron.com/" rel="noreferrer">Chevron — the El Segundo refinery and its history</a></li><li><a href="https://www.fws.gov/species/el-segundo-blue-butterfly-euphilotes-battoides-allyni" rel="noreferrer">U.S. Fish &amp; Wildlife Service — El Segundo blue butterfly</a></li><li><a href="https://www.boeing.com/features/2026/02/boeing-expands-satellite-production-to-meet-rising-demand" rel="noreferrer">Boeing — satellite production in El Segundo</a></li><li><a href="https://afdc.energy.gov/fuels/electricity-charging-home" rel="noreferrer">U.S. Department of Energy — residential charging</a></li><li><a href="https://www.ecfr.gov/current/title-49/subtitle-B/chapter-V/part-571/subpart-B/section-571.500" rel="noreferrer">Federal low-speed vehicle standard — speed alone is not approval</a></li></ul><p>{artwork.disclosure} {artwork.credit}. The published WebPs are proportionally resized derivatives of the supplied artwork.</p></details>
        </section>
      </article>
    </main>
    <footer class="esm-footer"><div class="esm-wrap"><a href="/">Return to PointCast</a><p>Speculative concept by Michael Hoydich; not affiliated with the City of El Segundo or any school.</p><a href="#main-content">Back to the case ↑</a></div></footer>
  </body>
</html>
