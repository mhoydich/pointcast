---
/**
 * /music-hub — top-level directory across every music register on
 * pointcast.xyz.
 *
 * Until now music was scattered across multiple directories with no
 * single entry point. This hub gives a one-page answer to "what's on
 * pointcast for music?" — 6 cards across 3 categories:
 *
 *   DRUM (3 registers, 19 surfaces):
 *     • /drum-live-bus   — synchronous · KV bus · 5 surfaces
 *     • /drum-mailbox    — async · URL-as-message · 6 surfaces
 *     • /drum-pavilion   — meditative · screensavers · 5 surfaces
 *
 *   MELODY (2 surfaces):
 *     • /melody-bottle   — pentatonic composer · async URL
 *     • /song-of-the-day — procedural daily tune · ambient
 *
 *   SHRINE (6 surfaces · gallery aesthetic, shipped 2026-05-16):
 *     • /shrine-water    — single-event · pool · drop a stone
 *     • /shrine-flame    — toggle-grid · twelve candles
 *     • /shrine-stone    — accumulate · cairn
 *     • /shrine-grass    — timed · breath cycle
 *     • /shrine-bird     — daily Visit Noun
 *     • /aviary          — multi-Noun listening grove
 *
 *   SOLO TOOLS:
 *     • /cast-table      — 32 single-user music tools
 *
 * Not a register itself — just a discovery layer. Each card is a
 * CSS-only mini-preview that visually echoes the surface it links to.
 *
 * Shipped 2026-05-14 (Thursday overnight). Closes the discovery gap
 * after a heavy sprint. Shrine section added 2026-05-16 after the
 * six-shrine gallery sprint. Suite is now 27+ surfaces. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Music Hub — every music surface on pointcast.xyz"
  description="The top-level directory for music on pointcast.xyz. Drum across three registers (live, async, meditative), melody (pentatonic composer and daily procedural tune), plus 32 single-user music tools at /cast-table. One page, every entry point."
  image="/images/og-drum.png"
>
  <main class="muh" id="muh" data-built={built}>
    <header class="muh__hero">
      <p class="muh__kicker">MUSIC · HUB · every music surface · one page</p>
      <h1 class="muh__title">Everything music.</h1>
      <p class="muh__sub">PointCast's music suite spans three drum registers (synchronous, asynchronous, meditative), a small melody register, and a deep catalog of single-user tools. This page collects every entry point in one place.</p>
    </header>

    <!-- DRUM section -->
    <section class="muh__section">
      <h2 class="muh__section-h">Drum</h2>
      <p class="muh__section-sub">Three registers, sixteen composing surfaces. Same percussion vocabulary (low/mid/high/bell), three different ways of being together.</p>
      <div class="muh__grid">

        <a class="muh__card muh__card--live" href="/drum-live-bus">
          <div class="muh__preview muh__preview--live">
            <span class="muh__live-chip">● LIVE</span>
            <div class="muh__live-dots" aria-hidden="true">
              <span style="left:18%;top:30%;background:#ff6b8a"></span>
              <span style="left:42%;top:48%;background:#8aeac0"></span>
              <span style="left:68%;top:32%;background:#7ac8ed"></span>
              <span style="left:80%;top:62%;background:#c9a8ef"></span>
              <span style="left:32%;top:72%;background:#f6c15e"></span>
            </div>
          </div>
          <div class="muh__body">
            <p class="muh__name">Drum Live Bus</p>
            <p class="muh__tag">synchronous · 5 surfaces · KV bus</p>
            <p class="muh__line">Drum together in real time. The KV-backed bus relays every tap to every visitor with about 2 seconds of latency. Five renderings of the same room: arcade pads, projection TV, single-tap pulse, emergent loop, constellation of stars.</p>
            <span class="muh__cta">5 surfaces →</span>
          </div>
        </a>

        <a class="muh__card muh__card--async" href="/drum-mailbox">
          <div class="muh__preview muh__preview--async">
            <span class="muh__bottle-glass"></span>
            <span class="muh__bottle-cork"></span>
            <div class="muh__bottle-grid" aria-hidden="true">
              <span style="grid-column:1;grid-row:1;background:#f6c15e"></span>
              <span style="grid-column:5;grid-row:1;background:#f6c15e"></span>
              <span style="grid-column:9;grid-row:1;background:#f6c15e"></span>
              <span style="grid-column:3;grid-row:2;background:#ff8a70"></span>
              <span style="grid-column:11;grid-row:3;background:#c9a8ef"></span>
              <span style="grid-column:7;grid-row:4;background:#8aeac0"></span>
            </div>
          </div>
          <div class="muh__body">
            <p class="muh__name">Drum Mailbox</p>
            <p class="muh__tag">async · 6 surfaces · URL-as-message</p>
            <p class="muh__line">Leave each other something to find later. The whole drum pattern fits in a URL — paste it anywhere a link works. Compose, derive, curate, store. Letters, not phone calls.</p>
            <span class="muh__cta">6 surfaces →</span>
          </div>
        </a>

        <a class="muh__card muh__card--meditative" href="/drum-pavilion">
          <div class="muh__preview muh__preview--meditative">
            <span class="muh__moon"></span>
            <span class="muh__sparkle" style="left:18%;top:20%"></span>
            <span class="muh__sparkle" style="left:78%;top:14%"></span>
            <span class="muh__sparkle" style="left:38%;top:78%"></span>
            <span class="muh__sparkle" style="left:62%;top:56%"></span>
            <span class="muh__sparkle" style="left:8%;top:60%"></span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Drum Pavilion</p>
            <p class="muh__tag">meditative · 5 screensavers · ambient</p>
            <p class="muh__line">Five 10-minute drum screensavers — set them and listen. Snowed-in gardens, plant-filled diner booths, atriums with tall windows, zen vitrines. No interaction, just audio.</p>
            <span class="muh__cta">5 surfaces →</span>
          </div>
        </a>

      </div>
    </section>

    <!-- MELODY section -->
    <section class="muh__section">
      <h2 class="muh__section-h">Melody</h2>
      <p class="muh__section-sub">Pentatonic across 3 octaves — every cell sounds intentional. Tools and gifts.</p>
      <div class="muh__grid">

        <a class="muh__card muh__card--melody" href="/melody-bottle">
          <div class="muh__preview muh__preview--melody">
            <div class="muh__melody-roll" aria-hidden="true">
              <!-- Sparse pentatonic line, mid-high octave -->
              <span style="grid-column:1;grid-row:7;background:#c9a8ef"></span>
              <span style="grid-column:3;grid-row:6;background:#c9a8ef"></span>
              <span style="grid-column:5;grid-row:5;background:#8aeac0"></span>
              <span style="grid-column:7;grid-row:4;background:#8aeac0"></span>
              <span style="grid-column:9;grid-row:5;background:#8aeac0"></span>
              <span style="grid-column:11;grid-row:6;background:#c9a8ef"></span>
              <span style="grid-column:13;grid-row:7;background:#c9a8ef"></span>
              <span style="grid-column:15;grid-row:8;background:#ff8a70"></span>
            </div>
          </div>
          <div class="muh__body">
            <p class="muh__name">Melody Bottle</p>
            <p class="muh__tag">async · pentatonic · 12 chars URL</p>
            <p class="muh__line">The melodic sibling of /drum-bottle. Click cells on a piano roll to set pitches. C-major pentatonic across 3 octaves means no wrong notes. Paste the link anywhere, recipients hear your tune.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--song" href="/song-of-the-day">
          <div class="muh__preview muh__preview--song">
            <div class="muh__sotd-date">
              <span class="muh__sotd-month">MAY</span>
              <span class="muh__sotd-day">14</span>
            </div>
            <div class="muh__sotd-mini" aria-hidden="true">
              <!-- A procedural-looking phrase -->
              <span style="grid-column:1;grid-row:5;background:#c9a8ef"></span>
              <span style="grid-column:2;grid-row:6;background:#c9a8ef"></span>
              <span style="grid-column:4;grid-row:4;background:#8aeac0"></span>
              <span style="grid-column:5;grid-row:6;background:#c9a8ef"></span>
              <span style="grid-column:7;grid-row:3;background:#8aeac0"></span>
              <span style="grid-column:9;grid-row:5;background:#c9a8ef"></span>
              <span style="grid-column:11;grid-row:7;background:#ff8a70"></span>
              <span style="grid-column:13;grid-row:5;background:#c9a8ef"></span>
              <span style="grid-column:15;grid-row:4;background:#8aeac0"></span>
            </div>
          </div>
          <div class="muh__body">
            <p class="muh__name">Song of the Day</p>
            <p class="muh__tag">procedural · deterministic · ambient</p>
            <p class="muh__line">A 16-step pentatonic melody generated locally from today's date. Every visitor on the same day hears the same tune. Step through previous days, save the ones you like as melody-bottles.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

      </div>
    </section>

    <!-- SHRINE section -->
    <section class="muh__section">
      <h2 class="muh__section-h">Shrine</h2>
      <p class="muh__section-sub">Six contemplative surfaces in an Apple-quality gallery register. Frosted glass cards, painterly backdrops, slow audio in a shared sonic room. Image-first, single-purpose, undemanding.</p>
      <div class="muh__grid">

        <a class="muh__card muh__card--water" href="/shrine-water">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-water">
            <span class="muh__shrine-glyph">⌬</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Shrine of Water</p>
            <p class="muh__tag">single event · pool · ripple + plink</p>
            <p class="muh__line">A still pool. Tap to drop a stone. Ambient drips every 8-12s. Soft plink through 2.2s convolution reverb. localStorage remembers your visits.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--flame" href="/shrine-flame">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-flame">
            <span class="muh__shrine-glyph">✦</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Shrine of Flame</p>
            <p class="muh__tag">toggle grid · twelve candles</p>
            <p class="muh__line">Twelve candles on a stone slab at dusk. Tap to light each one. Lit candles flicker. All twelve burning summons a soft G3 drone.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--stone" href="/shrine-stone">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-stone">
            <span class="muh__shrine-glyph">◣</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Shrine of Stone</p>
            <p class="muh__tag">accumulate · cairn</p>
            <p class="muh__line">Balance stones onto a cairn at the edge of the path. They stay where you put them across reloads. Wood-on-wood tock + distant wind.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--grass" href="/shrine-grass">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-grass">
            <span class="muh__shrine-glyph">⌇</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Shrine of Grass</p>
            <p class="muh__tag">timed · breath cycle</p>
            <p class="muh__line">A 12-second cycle (4 in · 2 hold · 6 out). The orb expands; the grass leans. Inhale/exhale filtered-noise washes match the breath.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--bird" href="/shrine-bird">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-bird">
            <span class="muh__shrine-glyph">▲</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Shrine of Birds</p>
            <p class="muh__tag">daily Noun · pentatonic chirps</p>
            <p class="muh__line">Today's Visit Noun is the bird in residence. Procedural name from seed (256 combinations). Chirps every 6-12s. Leave a feather offering.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

        <a class="muh__card muh__card--aviary" href="/aviary">
          <div class="muh__preview muh__preview--shrine muh__preview--shrine-aviary">
            <span class="muh__shrine-glyph">⁂</span>
          </div>
          <div class="muh__body">
            <p class="muh__name">Aviary</p>
            <p class="muh__tag">listening only · 16 Nouns · hourly rotation</p>
            <p class="muh__line">A grove of 16 Visit Nouns, each chirping on its own slow timer. The flock turns over every hour. Hover any bird to hear it. No state.</p>
            <span class="muh__cta">Open →</span>
          </div>
        </a>

      </div>
      <p class="muh__section-also">
        See also <a href="/drum-shrine">/drum-shrine</a> (the original pixel-art temple), <a href="/drum-altars">/drum-altars</a> (Noun tribute altars), <a href="/shrines">/shrines</a> (URL-unfurl gallery art).
      </p>
    </section>

    <!-- SOLO section -->
    <section class="muh__section">
      <h2 class="muh__section-h">Solo</h2>
      <p class="muh__section-sub">A catalog of single-user music tools — instruments, synths, loops, drones, and one-offs.</p>
      <div class="muh__grid muh__grid--single">

        <a class="muh__card muh__card--cast" href="/cast-table">
          <div class="muh__preview muh__preview--cast">
            <div class="muh__cast-grid" aria-hidden="true">
              <!-- Mock 8×4 grid of tools -->
              <span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span><span style="background:#7ac8ed"></span><span style="background:#8aeac0"></span>
              <span style="background:#c9a8ef"></span><span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span><span style="background:#7ac8ed"></span>
              <span style="background:#8aeac0"></span><span style="background:#c9a8ef"></span><span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span>
              <span style="background:#7ac8ed"></span><span style="background:#8aeac0"></span><span style="background:#c9a8ef"></span><span style="background:#f6c15e"></span>
              <span style="background:#ff6b8a"></span><span style="background:#7ac8ed"></span><span style="background:#8aeac0"></span><span style="background:#c9a8ef"></span>
              <span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span><span style="background:#7ac8ed"></span><span style="background:#8aeac0"></span>
              <span style="background:#c9a8ef"></span><span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span><span style="background:#7ac8ed"></span>
              <span style="background:#8aeac0"></span><span style="background:#c9a8ef"></span><span style="background:#f6c15e"></span><span style="background:#ff6b8a"></span>
            </div>
          </div>
          <div class="muh__body">
            <p class="muh__name">Cast Table</p>
            <p class="muh__tag">solo · 32 tools · catalog</p>
            <p class="muh__line">Thirty-two single-user music tools at a glance. Instruments, drones, loop sequencers, theremin, organ, marimba, bells, harp, and more. Each one its own little surface; no presence, no chat, just play.</p>
            <span class="muh__cta">32 surfaces →</span>
          </div>
        </a>

      </div>
    </section>

    <section class="muh__notes">
      <h2 class="muh__notes-h">The shape of the suite</h2>
      <p>Music on pointcast.xyz exists in <strong>three drum registers</strong> + a <strong>melody register</strong> + a <strong>catalog of solo tools</strong>. The drum registers are organised around presence:</p>
      <ul>
        <li><strong>Synchronous</strong> (<a href="/drum-live-bus">/drum-live-bus</a>) — everyone in the same room, same time, hearing each other.</li>
        <li><strong>Asynchronous</strong> (<a href="/drum-mailbox">/drum-mailbox</a>) — leaving each other phrases as URLs to be heard later.</li>
        <li><strong>Meditative</strong> (<a href="/drum-pavilion">/drum-pavilion</a>) — alone, listening, no audience.</li>
      </ul>
      <p>The melody register is younger — just two surfaces — and uses the same async URL-as-message format with pentatonic pitches instead of drum hits. The solo catalog at <a href="/cast-table">/cast-table</a> predates all of this and contains 32 single-user music tools.</p>
      <p>If you're new, start with <a href="/song-of-the-day">/song-of-the-day</a> (no commitment, just listen) or <a href="/drum-bottle">/drum-bottle</a> (make a phrase, send it). Both take less than a minute to grok.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --muh-ink: #0a1230;
      --muh-mid: #14193a;
      --muh-flame: #f6c15e;
      --muh-coral: #ff6b8a;
      --muh-mint: #8aeac0;
      --muh-sky: #7ac8ed;
      --muh-mauve: #c9a8ef;
      --muh-cream: #f4e7c8;
      --muh-cream-dim: #b8aa84;
      --muh-cream-dimmer: #6a6e8a;
    }

    body:has(.muh) {
      background:
        radial-gradient(circle at 12% 5%, #1a1e58 0%, transparent 45%),
        radial-gradient(circle at 88% 95%, #0e1a48 0%, transparent 50%),
        var(--muh-ink);
      color: var(--muh-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .muh { max-width: 1100px; margin: 0 auto; padding: 36px 24px 64px; }

    /* HERO */
    .muh__hero {
      max-width: 760px;
      margin: 0 auto 44px;
      text-align: center;
    }
    .muh__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--muh-coral);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .muh__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: clamp(40px, 7vw, 68px);
      letter-spacing: -0.025em;
      line-height: 1.02;
      margin: 0 0 16px;
      color: var(--muh-cream);
      text-shadow: 0 4px 24px rgba(0,0,0,0.5);
    }
    .muh__sub {
      font-size: 16px;
      line-height: 1.55;
      color: var(--muh-cream-dim);
      margin: 0;
    }

    /* SECTIONS */
    .muh__section {
      margin-bottom: 44px;
    }
    .muh__section-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 26px;
      letter-spacing: -0.015em;
      color: var(--muh-flame);
      margin: 0 0 8px;
    }
    .muh__section-sub {
      font-size: 14px;
      line-height: 1.5;
      color: var(--muh-cream-dim);
      margin: 0 0 18px;
      max-width: 640px;
    }

    /* GRID */
    .muh__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .muh__grid--single {
      grid-template-columns: 1fr;
      max-width: 720px;
    }
    @media (max-width: 900px) {
      .muh__grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .muh__grid { grid-template-columns: 1fr; }
    }

    /* CARDS */
    .muh__card {
      display: grid;
      grid-template-rows: 160px auto;
      gap: 12px;
      padding: 14px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 14px;
      text-decoration: none;
      color: inherit;
      transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
      overflow: hidden;
    }
    .muh__card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.5);
      border-color: var(--muh-flame);
    }

    .muh__preview {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      background: #0a0e22;
    }

    /* LIVE preview */
    .muh__preview--live {
      background: radial-gradient(circle at 50% 50%, #1a1238 0%, #060a18 70%);
    }
    .muh__live-chip {
      position: absolute;
      top: 8px;
      left: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.14em;
      color: var(--muh-coral);
      background: rgba(255, 107, 138, 0.15);
      padding: 2px 6px;
      border-radius: 3px;
      animation: muhBlink 2s ease-in-out infinite;
    }
    @keyframes muhBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    .muh__live-dots {
      position: absolute;
      inset: 0;
    }
    .muh__live-dots span {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      box-shadow: 0 0 10px currentColor;
      transform: translate(-50%, -50%);
    }

    /* ASYNC preview (bottle) */
    .muh__preview--async {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }
    .muh__bottle-glass {
      position: absolute;
      inset: 10px 36% 10px 36%;
      border-radius: 50% 50% 14% 14% / 30% 30% 8% 8%;
      border: 2px solid rgba(244, 231, 200, 0.35);
      background: linear-gradient(180deg, rgba(122, 200, 237, 0.15), rgba(122, 200, 237, 0.05) 60%);
    }
    .muh__bottle-cork {
      position: absolute;
      top: 4px;
      left: 50%;
      transform: translateX(-50%);
      width: 16px;
      height: 10px;
      background: linear-gradient(180deg, #c9a880, #8a7050);
      border-radius: 3px;
    }
    .muh__bottle-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      grid-template-rows: repeat(4, 1fr);
      gap: 2px;
      width: 65%;
      height: 45%;
      background: rgba(0,0,0,0.35);
      padding: 3px;
      border-radius: 3px;
    }
    .muh__bottle-grid span { border-radius: 1px; }

    /* MEDITATIVE preview */
    .muh__preview--meditative {
      background:
        radial-gradient(ellipse at 50% 40%, #2a1640 0%, transparent 60%),
        linear-gradient(180deg, #0e1640 0%, #060a20 100%);
    }
    .muh__moon {
      position: absolute;
      top: 28%;
      right: 22%;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #f4e7c8 0%, #c9a880 80%);
      box-shadow: 0 0 18px rgba(244, 231, 200, 0.4);
    }
    .muh__sparkle {
      position: absolute;
      width: 3px;
      height: 3px;
      background: rgba(244, 231, 200, 0.6);
      border-radius: 50%;
      box-shadow: 0 0 4px rgba(244, 231, 200, 0.5);
