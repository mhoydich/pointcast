---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();

type Sigil = 'wave' | 'spokes' | 'target' | 'bars' | 'medal';
type Surface = { url: string; name: string; verb: string; line: string; sigil: Sigil };
type Group = { id: string; title: string; intent: string; items: Surface[] };

const groups: Group[] = [
  {
    id: 'listen',
    title: 'Listen',
    intent: 'background music that knows what to do',
    items: [
      { url: '/cast-on',      name: 'Cast On',      verb: 'one-button radio',  line: "Tap once, music plays. The page picks tracks by hour of day.",                 sigil: 'wave'   },
      { url: '/cast-wander',  name: 'Cast Wander',  verb: 'generative ambient', line: "Markov-chain chord progression. Pentatonic lead. Runs forever, never repeats.", sigil: 'wave'   },
      { url: '/cast-cradle',  name: 'Cast Cradle',  verb: 'sleep fade',        line: "Pick a duration. A 40-voice pad fades to silence on a schedule.",              sigil: 'wave'   },
      { url: '/cast-room',    name: 'Cast Room',    verb: 'synth room tone',   line: "El Segundo porch, café, train, library, kitchen. Plays under another tab.",   sigil: 'wave'   },
      { url: '/cast-rivers',  name: 'Cast Rivers',  verb: 'four loops phasing', line: "Coprime loop lengths (4/5/6/7) at different tempos. Steve Reich in a tab.", sigil: 'wave'   },
      { url: '/cast-quartet', name: 'Cast Quartet', verb: 'four-voice round',  line: "Same melody, four voices, each entering 4 beats apart. Eight subjects.",      sigil: 'wave'   },
    ],
  },
  {
    id: 'understand',
    title: 'Understand',
    intent: 'small tools for hearing what is happening',
    items: [
      { url: '/cast-wheel',     name: 'Cast Wheel',     verb: 'circle of fifths',  line: "Click any key to hear its relative minor, dominant, subdominant.",            sigil: 'spokes' },
      { url: '/cast-tone',      name: 'Cast Tone',      verb: 'reference drone',    line: "Pick a note. Sustained sine + triangle holds the pitch forever.",            sigil: 'spokes' },
      { url: '/cast-metronome', name: 'Cast Metronome', verb: 'proper metronome',   line: "40-220 BPM, time signatures, subdivisions, tap-to-set, polyrhythm.",         sigil: 'spokes' },
      { url: '/cast-mirror',    name: 'Cast Mirror',    verb: 'pitch from your mic', line: "Sing or hum, see the note name, cents off, scrolling pitch trace.",        sigil: 'spokes' },
      { url: '/cast-ear',       name: 'Cast Ear',       verb: 'interval ear training', line: "Hear two notes, name the interval. 3 levels, 3 directions, streak tracker.", sigil: 'spokes' },
    ],
  },
  {
    id: 'play',
    title: 'Play',
    intent: 'one verb you can do with whatever is happening',
    items: [
      { url: '/cast-jam',     name: 'Cast Jam',     verb: 'key-locked keyboard',  line: "Pick a track. Tap keys. Anything you play is in the song's key.",         sigil: 'target' },
      { url: '/cast-breathe', name: 'Cast Breathe', verb: 'a Noun breathes',      line: "Pick a breath pattern. A Noun rises on inhale, falls on exhale.",         sigil: 'target' },
      { url: '/cast-along',   name: 'Cast Along',   verb: 'tap with anything',   line: "Tap with whatever you're hearing. See BPM, drift, steadiest run.",         sigil: 'target' },
      { url: '/cast-pulse',   name: 'Cast Pulse',   verb: 'step sequencer',      line: "4 synth voices, 16 steps, swing, 6 preset patterns + 4 user slots.",       sigil: 'target' },
      { url: '/cast-clap',    name: 'Cast Clap',    verb: 'call and response',   line: "Computer plays a rhythm. You clap it back. Beat-by-beat scoring.",        sigil: 'target' },
      { url: '/cast-bell',    name: 'Cast Bell',    verb: 'strike a bell',       line: "Handbell, temple, church, gong. Five sine partials with inharmonic ratios.", sigil: 'target' },
      { url: '/cast-throw',   name: 'Cast Throw',   verb: 'jazz fours',          line: "Computer plays 4 bars. You play 4 bars. Trade until you stop.",            sigil: 'target' },
      { url: '/cast-stones',  name: 'Cast Stones',  verb: 'click to ripple',     line: "Tap anywhere on a pond. A stone drops, ripples spread, a note plays.",       sigil: 'target' },
    ],
  },
  {
    id: 'create',
    title: 'Create',
    intent: 'make something that wasn’t there before',
    items: [
      { url: '/cast-loop',     name: 'Cast Loop',     verb: '4-voice loop pedal',  line: "Arm a voice, play four bars, the page loops it. Stack four voices.",    sigil: 'bars'   },
      { url: '/cast-make',     name: 'Cast Make',     verb: '4-bar composer',     line: "Pick a Noun kit, sketch chords, toggle drums, pick a lead, share via URL.", sigil: 'bars'   },
      { url: '/cast-make-pro', name: 'Cast Make Pro', verb: '8-bar pro composer',  line: "Velocity drums, per-bar lead phrases, swing, pad voicing, WAV export.",   sigil: 'bars'   },
      { url: '/cast-letter',   name: 'Cast Letter',   verb: 'type → melody',      line: "Each letter is a scale degree. Vowels long, punctuation rests. Share via URL.", sigil: 'bars'   },
      { url: '/cast-shape',    name: 'Cast Shape',    verb: 'draw → melody',      line: "Draw a curve on the canvas. Y is pitch, X is time, all snapped to scale.", sigil: 'bars'   },
      { url: '/cast-die',      name: 'Cast Die',      verb: 'roll → melody',      line: "Four dice. Key, tempo, rhythm, contour. Lock and re-roll until you like it.", sigil: 'bars'   },
      { url: '/cast-fives',    name: 'Cast Fives',    verb: '5-second mic loop',  line: "Press REC. Five seconds of mic captured. Loops forever. Two slots, pitch, reverse.", sigil: 'bars'   },
    ],
  },
  {
    id: 'capstones',
    title: 'Capstones',
    intent: 'songs, kits, and the shape of an actual record',
    items: [
      { url: '/cast-music',     name: 'Cast Music',     verb: 'drum hub',                line: "The current drum hub — a playable home for the Noun music artists.",            sigil: 'medal'  },
      { url: '/cast-music-pro', name: 'Cast Music Pro', verb: 'consumer-ready cut',      line: "Same hub, polish layer on. Animated art, lyric tickers, crossfades.",            sigil: 'medal'  },
      { url: '/cast-studio',    name: 'Cast Studio',    verb: 'songs not loops',         line: "Multi-bar arrangements, per-artist sound design, chord progressions.",          sigil: 'medal'  },
      { url: '/cast-real',      name: 'Cast Real',      verb: 'real recorded instruments', line: "Same songs, GM soundfont samples. Real piano, trumpet, choir, vibraphone.",  sigil: 'medal'  },
      { url: '/cast-deck',      name: 'Cast Deck',      verb: 'trading-card deck',       line: "Eight Noun music artists as printable trading cards.",                         sigil: 'medal'  },
      { url: '/cast-graduate',  name: 'Cast Graduate',  verb: 'diploma',                 line: "Reads your /drum-school stars + /cast-make slots and awards a rank.",          sigil: 'medal'  },
    ],
  },
];

const total = groups.reduce((acc, g) => acc + g.items.length, 0);
---
<BlockLayout title="Cast Table — index of all the small music surfaces" description="The directory for all the cast-* surfaces on pointcast.xyz. 32 small browser-only music tools, grouped by what you're trying to do: listen, understand, play, create, or capstone.">
  <main class="ct" id="ct" data-built={built}>
    <header class="ct__hero">
      <p class="ct__kicker">CAST · TABLE · {total} surfaces · all browser, no app store</p>
      <h1 class="ct__title">Cast.</h1>
      <p class="ct__sub">All the small music surfaces on pointcast.xyz, in one place. {total} pages, grouped by what you're trying to do. Each one is a self-contained Web Audio sketch — no signup, no upload, nothing leaves your tab.</p>
    </header>

    <nav class="ct__nav">
      {groups.map(g => (
        <a class="ct__nav-link" href={`#${g.id}`}>
          <span class="ct__nav-link-name">{g.title}</span>
          <span class="ct__nav-link-count">{g.items.length}</span>
        </a>
      ))}
    </nav>

    {groups.map(g => (
      <section class="ct__group" id={g.id}>
        <header class="ct__group-head">
          <h2 class="ct__group-title">{g.title}</h2>
          <p class="ct__group-intent">{g.intent}</p>
        </header>
        <div class="ct__cards">
          {g.items.map(s => (
            <a class={`ct__card ct__card--${s.sigil}`} href={s.url}>
              <span class="ct__card-sigil" set:html={
                s.sigil === 'wave'   ? `<svg viewBox="0 0 64 64" aria-hidden><path d="M2 32 Q12 18 22 32 T42 32 T62 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>` :
                s.sigil === 'spokes' ? `<svg viewBox="0 0 64 64" aria-hidden><circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="2"/><g stroke="currentColor" stroke-width="1.5">${Array.from({length:12}).map((_,i)=>`<line x1="${32+18*Math.cos(Math.PI*2*i/12)}" y1="${32+18*Math.sin(Math.PI*2*i/12)}" x2="${32+26*Math.cos(Math.PI*2*i/12)}" y2="${32+26*Math.sin(Math.PI*2*i/12)}"/>`).join('')}</g></svg>` :
                s.sigil === 'target' ? `<svg viewBox="0 0 64 64" aria-hidden><circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="32" cy="32" r="16" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="32" cy="32" r="6" fill="currentColor"/></svg>` :
                s.sigil === 'bars'   ? `<svg viewBox="0 0 64 64" aria-hidden><g fill="currentColor"><rect x="10" y="40" width="10" height="18" rx="2"/><rect x="24" y="28" width="10" height="30" rx="2"/><rect x="38" y="34" width="10" height="24" rx="2"/><rect x="52" y="22" width="6" height="36" rx="2"/></g></svg>` :
                                       `<svg viewBox="0 0 64 64" aria-hidden><circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="2"/><polygon points="32,16 35.8,25.2 45,25.2 37.5,31.3 40.3,40 32,34.8 23.7,40 26.5,31.3 19,25.2 28.2,25.2" fill="currentColor"/></svg>`
              }></span>
              <div class="ct__card-body">
                <p class="ct__card-name">{s.name}</p>
                <p class="ct__card-verb">{s.verb}</p>
                <p class="ct__card-line">{s.line}</p>
              </div>
              <span class="ct__card-arrow" aria-hidden>↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <footer class="ct__footer">
      <h2 class="ct__footer-h">What links these</h2>
      <p>Shared visual language (Inter Tight Display + JetBrains Mono for labels, walnut/flame/cream palette). Shared audio scheduler at <code>src/lib/audio-scheduler.ts</code> for pause-aware timing across every page. No upload. No tracking. Each one builds to ~30-60 KB and runs offline once loaded.</p>
      <p>This is a directory, not a product. If you want to send one link to a friend, send them <strong>the page that does the verb they're after</strong> — <a href="/cast-on">on</a> if they want to listen, <a href="/cast-along">along</a> if they want to do something with whatever is already playing, <a href="/cast-make">make</a> if they want to compose something tiny.</p>
      <p>For the bigger story behind these — why so many small surfaces instead of one app — see <a href="/about">/about</a>.</p>
    </footer>
  </main>

  <style is:global>
    :root {
      --ct-ink: #0a0810;
      --ct-walnut: #4a2a1a;
      --ct-flame: #f6c15e;
      --ct-flame-deep: #d68f2c;
      --ct-cream: #f4e7c8;
      --ct-cream-dim: #c8b48a;
      --ct-cream-dimmer: #8b7a5a;
      --ct-mauve: #b39ddb;
      --ct-mint: #9bd7b8;
      --ct-rose: #e6788c;
      --ct-sky: #9ed6f0;
    }

    body:has(.ct) {
      background:
        radial-gradient(circle at 10% 0%, #2a1530 0%, transparent 35%),
        radial-gradient(circle at 90% 60%, #1a2230 0%, transparent 50%),
        var(--ct-ink);
      color: var(--ct-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .ct {
      max-width: 1100px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    .ct__hero { text-align: center; margin-bottom: 36px; }
    .ct__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--ct-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .ct__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 140px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--ct-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.45);
    }
    .ct__sub {
      max-width: 720px;
      margin: 0 auto;
      font-size: 17px;
      line-height: 1.5;
      color: var(--ct-cream-dim);
    }

    /* NAV */
    .ct__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: center;
      margin: 28px 0 40px;
      padding: 12px 16px;
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 16px;
    }
    .ct__nav-link {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      text-decoration: none;
      color: var(--ct-cream);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      transition: background 100ms ease, color 100ms ease;
    }
    .ct__nav-link:hover {
      background: rgba(246,193,94,0.14);
      color: var(--ct-flame);
    }
    .ct__nav-link-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--ct-cream-dimmer);
      font-weight: 400;
    }

    /* GROUPS */
    .ct__group {
      margin-bottom: 52px;
      scroll-margin-top: 24px;
    }
    .ct__group-head {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(246,193,94,0.18);
    }
    .ct__group-title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: 42px;
      letter-spacing: -0.02em;
      color: var(--ct-flame);
      margin: 0;
    }
    .ct__group-intent {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      color: var(--ct-cream-dim);
      margin: 0;
      text-transform: lowercase;
    }

    .ct__cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 14px;
    }

    .ct__card {
      position: relative;
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 14px;
      align-items: start;
      padding: 18px 18px 18px 16px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 16px;
      text-decoration: none;
      color: var(--ct-cream);
      transition: transform 100ms ease, background 100ms ease, border-color 100ms ease;
      overflow: hidden;
    }
    .ct__card:hover {
      transform: translateY(-2px);
      background: rgba(0,0,0,0.45);
      border-color: var(--ct-flame);
    }
    .ct__card-sigil {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      color: var(--ct-flame);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ct__card-sigil svg { width: 100%; height: 100%; }
    .ct__card--wave   .ct__card-sigil { color: var(--ct-sky); }
    .ct__card--spokes .ct__card-sigil { color: var(--ct-mauve); }
    .ct__card--target .ct__card-sigil { color: var(--ct-flame); }
    .ct__card--bars   .ct__card-sigil { color: var(--ct-mint); }
    .ct__card--medal  .ct__card-sigil { color: var(--ct-rose); }

    .ct__card-body { min-width: 0; }
    .ct__card-name {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 18px;
      color: var(--ct-cream);
      margin: 0 0 2px;
      letter-spacing: -0.01em;
    }
    .ct__card-verb {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--ct-flame);
      text-transform: uppercase;
      margin: 0 0 8px;
    }
    .ct__card-line {
      font-size: 13px;
      line-height: 1.5;
      color: var(--ct-cream-dim);
      margin: 0;
    }
    .ct__card-arrow {
      position: absolute;
      top: 14px;
      right: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      color: var(--ct-cream-dimmer);
      transition: color 100ms ease, transform 100ms ease;
    }
    .ct__card:hover .ct__card-arrow {
      color: var(--ct-flame);
      transform: translate(2px, -2px);
    }

    .ct__footer {
      margin-top: 24px;
      padding-top: 28px;
      border-top: 1px solid rgba(246,193,94,0.14);
      max-width: 760px;
      margin-left: auto;
      margin-right: auto;
    }
    .ct__footer-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--ct-cream);
      margin: 0 0 14px;
    }
    .ct__footer p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--ct-cream-dim);
      margin: 0 0 12px;
    }
    .ct__footer strong { color: var(--ct-cream); }
    .ct__footer a { color: var(--ct-flame); text-decoration: none; }
    .ct__footer a:hover { text-decoration: underline; }
    .ct__footer code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--ct-flame);
    }
  </style>
</BlockLayout>
