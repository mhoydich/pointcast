---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Graduate — your pointcast music school diploma" description="The capstone diploma for the pointcast music app. Reads /drum-school stars and /cast-make compositions and awards you a rank.">
  <main class="cg" id="cg" data-built={built}>
    <header class="cg__hero">
      <p class="cg__kicker">DIPLOMA · pointcast music school</p>
      <h1 class="cg__title">Your pointcast music school diploma.</h1>
      <p class="cg__sub">Read by your browser: the stars you earned at /drum-school and the songs you saved at /cast-make. The rank is the sum of the practice. The Noun is yours forever — same seed, same face.</p>
    </header>

    <div class="cg__main" id="cg-main"></div>

    <footer class="cg__footer">
      <p class="cg__footnote">
        Lives entirely in this browser. <a href="/drum-school">/drum-school</a> trains the ear · <a href="/cast-make">/cast-make</a> makes the songs · <a href="/cast-real">/cast-real</a> hosts the prebuilt set · <a href="/">PointCast home</a>.
      </p>
      <p class="cg__footnote cg__footnote--danger">
        <a href="#" id="cg-clear-all">Clear all progress</a> · burns down the stars and the slots.
      </p>
    </footer>

    <div class="cg__toast" id="cg-toast" hidden></div>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cg-bg: #0a0610; --cg-bg-2: #170a18;
    --cg-walnut: #5a3422; --cg-flame: #f6c15e; --cg-cream: #f4e7c8;
    --cg-velvet: #1a0820; --cg-glass: rgba(244,231,200,0.04);
    --cg-line: rgba(244,231,200,0.10);
    --cg-text: #f4e7c8; --cg-text-mute: rgba(244,231,200,0.62); --cg-text-quiet: rgba(244,231,200,0.38);
    --cg-display: 'Inter Tight', system-ui, sans-serif;
    --cg-body: 'Inter', system-ui, sans-serif;
    --cg-mono: 'JetBrains Mono', ui-monospace, monospace;
    --cg-good: #a8ff3a; --cg-bad: #ff5f7a;
  }
  body { background: var(--cg-bg); color: var(--cg-text); font-family: var(--cg-body); }

  .cg { max-width: 880px; margin: 0 auto; padding: 28px 22px 80px 22px; }

  /* Hero */
  .cg__hero { padding: 20px 0 28px 0; border-bottom: 1px solid var(--cg-line); margin-bottom: 28px; }
  .cg__kicker { font-family: var(--cg-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--cg-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .cg__title { font-family: var(--cg-display); font-weight: 800; font-size: clamp(36px, 6vw, 60px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 14px 0; color: var(--cg-text); }
  .cg__sub { font-family: var(--cg-body); font-size: 14.5px; color: var(--cg-text-mute); max-width: 620px; line-height: 1.6; margin: 0; }

  /* Diploma frame — main top-card holding the portrait + rank */
  .cg__diploma {
    display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: center;
    padding: 28px 26px;
    background: linear-gradient(135deg, rgba(246,193,94,0.08), rgba(244,231,200,0.02));
    border: 1px solid rgba(246,193,94,0.25); border-radius: 16px;
    margin-bottom: 22px;
  }
  @media (max-width: 640px) { .cg__diploma { grid-template-columns: 1fr; text-align: center; gap: 18px; } }

  .cg__portrait {
    width: 180px; height: 180px; border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, rgba(246,193,94,0.20), rgba(26,8,32,0.6) 70%);
    display: grid; place-items: center; margin: 0 auto;
    box-shadow: 0 8px 32px rgba(0,0,0,0.45), inset 0 0 0 2px rgba(246,193,94,0.18);
    animation: cg-float 4s ease-in-out infinite;
  }
  .cg__portrait img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5)); }
  .cg__portrait--maestro {
    box-shadow: 0 0 0 3px rgba(246,193,94,0.35), 0 8px 40px rgba(246,193,94,0.45), inset 0 0 0 2px rgba(246,193,94,0.5);
    animation: cg-float 4s ease-in-out infinite, cg-maestro-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cg-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes cg-maestro-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(246,193,94,0.30), 0 8px 40px rgba(246,193,94,0.35), inset 0 0 0 2px rgba(246,193,94,0.5); }
    50% { box-shadow: 0 0 0 6px rgba(246,193,94,0.45), 0 12px 50px rgba(246,193,94,0.65), inset 0 0 0 2px rgba(246,193,94,0.7); }
  }

  .cg__rank-block { min-width: 0; }
  .cg__rank-label { font-family: var(--cg-mono); font-size: 10.5px; letter-spacing: 0.7px; color: var(--cg-text-quiet); text-transform: uppercase; margin: 0 0 8px 0; }
  .cg__rank {
    font-family: var(--cg-display); font-weight: 800;
    font-size: clamp(32px, 5vw, 48px); line-height: 1; letter-spacing: -0.02em;
    color: var(--cg-flame); margin: 0 0 10px 0;
  }
  .cg__rank--maestro {
    background: linear-gradient(90deg, #ffd58a, #ff8a3a, #ffd58a);
    background-size: 200% auto; background-clip: text; -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: cg-maestro-shimmer 4s linear infinite;
  }
  @keyframes cg-maestro-shimmer { 0% { background-position: 0% center; } 100% { background-position: 200% center; } }
  .cg__rank-desc { font-family: var(--cg-body); font-size: 13.5px; color: var(--cg-text-mute); line-height: 1.55; margin: 0 0 14px 0; }
  .cg__rank-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Buttons */
  .cg__btn {
    background: var(--cg-flame); color: var(--cg-velvet);
    border: 0; padding: 10px 16px; border-radius: 8px;
    font-family: var(--cg-display); font-weight: 700; font-size: 13px;
    cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    transition: transform 0.15s ease, background 0.15s ease;
    text-decoration: none;
  }
  .cg__btn:hover:not(:disabled) { transform: scale(1.04); background: #ffd58a; }
  .cg__btn--ghost { background: transparent; color: var(--cg-text-mute); border: 1px solid var(--cg-line); }
  .cg__btn--ghost:hover:not(:disabled) { background: var(--cg-glass); color: var(--cg-text); border-color: var(--cg-flame); }
  .cg__btn-icon { font-size: 14px; }

  /* Stat cards row */
  .cg__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 22px; }
  @media (max-width: 720px) { .cg__stats { grid-template-columns: 1fr; } }
  .cg__stat-card {
    background: var(--cg-glass); border: 1px solid var(--cg-line); border-radius: 12px;
    padding: 18px 18px;
  }
  .cg__stat-label { font-family: var(--cg-mono); font-size: 10.5px; letter-spacing: 0.7px; color: var(--cg-flame); text-transform: uppercase; margin: 0 0 10px 0; }
  .cg__stat-value { font-family: var(--cg-display); font-weight: 800; font-size: 28px; line-height: 1; letter-spacing: -0.02em; color: var(--cg-text); margin: 0 0 4px 0; }
  .cg__stat-value-suffix { font-family: var(--cg-mono); font-size: 14px; color: var(--cg-text-quiet); font-weight: 500; margin-left: 4px; }
  .cg__stat-hint { font-family: var(--cg-body); font-size: 12.5px; color: var(--cg-text-mute); margin: 6px 0 0 0; line-height: 1.45; }

  /* Star fill row */
  .cg__star-row { display: flex; gap: 3px; margin-top: 10px; }
  .cg__star {
    flex: 1; aspect-ratio: 1; max-width: 18px;
    background: rgba(244,231,200,0.10);
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .cg__star--on { background: var(--cg-flame); }

  /* Slot dots */
  .cg__slot-dots { display: flex; gap: 6px; margin-top: 10px; }
  .cg__slot-dot { width: 12px; height: 12px; border-radius: 50%; background: rgba(244,231,200,0.12); }
  .cg__slot-dot--on { background: var(--cg-flame); }

  /* Per-game breakdown */
  .cg__section {
    background: var(--cg-glass); border: 1px solid var(--cg-line); border-radius: 12px;
    padding: 20px; margin-bottom: 22px;
  }
  .cg__section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }
  .cg__section-label { font-family: var(--cg-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--cg-flame); text-transform: uppercase; margin: 0; }
  .cg__section-hint { font-family: var(--cg-body); font-size: 13px; color: var(--cg-text-mute); margin: 0; line-height: 1.5; }

  .cg__breakdown { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (max-width: 640px) { .cg__breakdown { grid-template-columns: 1fr; } }
  .cg__game {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 12px;
    padding: 12px 14px; background: rgba(244,231,200,0.03);
    border: 1px solid var(--cg-line); border-radius: 10px;
  }
  .cg__game-meta { min-width: 0; }
  .cg__game-name { font-family: var(--cg-display); font-weight: 700; font-size: 14px; color: var(--cg-text); margin: 0; line-height: 1.2; }
  .cg__game-tag { font-family: var(--cg-mono); font-size: 10px; color: var(--cg-text-quiet); margin: 3px 0 0 0; letter-spacing: 0.3px; text-transform: uppercase; }
  .cg__game-stars { display: flex; gap: 3px; }
  .cg__game-stars .cg__star { max-width: 16px; }

  /* Comp list */
  .cg__comps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (max-width: 720px) { .cg__comps { grid-template-columns: 1fr; } }
  .cg__comp {
    display: block; text-decoration: none;
    background: linear-gradient(135deg, var(--cg-comp-c, var(--cg-walnut)), var(--cg-velvet));
    border: 1px solid var(--cg-line); border-radius: 10px; padding: 14px;
    transition: transform 0.18s ease, border-color 0.18s ease;
    cursor: pointer;
  }
  .cg__comp:hover { transform: translateY(-3px); border-color: var(--cg-flame); }
  .cg__comp-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .cg__comp-portrait { width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.35); display: grid; place-items: center; flex-shrink: 0; }
  .cg__comp-portrait img { width: 80%; image-rendering: pixelated; }
  .cg__comp-meta { min-width: 0; }
  .cg__comp-name { font-family: var(--cg-display); font-weight: 700; font-size: 13.5px; color: #fff; margin: 0; line-height: 1.2; }
  .cg__comp-tag { font-family: var(--cg-mono); font-size: 10px; color: rgba(255,255,255,0.65); margin: 2px 0 0 0; letter-spacing: 0.3px; text-transform: uppercase; }
  .cg__comp-hint { font-family: var(--cg-mono); font-size: 9.5px; color: rgba(255,255,255,0.55); letter-spacing: 0.4px; text-transform: uppercase; margin: 6px 0 0 0; }
  .cg__comp--empty { opacity: 0.45; cursor: default; background: rgba(244,231,200,0.03); border-style: dashed; }
  .cg__comp--empty:hover { transform: none; border-color: var(--cg-line); }

  /* Empty state */
  .cg__empty {
    text-align: center; padding: 40px 28px;
    background: linear-gradient(135deg, rgba(246,193,94,0.06), rgba(168,255,58,0.02));
    border: 1px solid rgba(246,193,94,0.20); border-radius: 16px; margin-bottom: 22px;
  }
  .cg__empty-title { font-family: var(--cg-display); font-weight: 800; font-size: clamp(22px, 3.5vw, 32px); color: var(--cg-text); margin: 0 0 10px 0; letter-spacing: -0.01em; }
  .cg__empty-sub { font-family: var(--cg-body); font-size: 14.5px; color: var(--cg-text-mute); max-width: 480px; margin: 0 auto 22px auto; line-height: 1.55; }
  .cg__empty-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .cg__empty-cta {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 22px; border-radius: 10px;
    font-family: var(--cg-display); font-weight: 700; font-size: 14px;
    text-decoration: none; transition: transform 0.15s ease, background 0.15s ease;
  }
  .cg__empty-cta--primary { background: var(--cg-flame); color: var(--cg-velvet); }
  .cg__empty-cta--primary:hover { transform: scale(1.04); background: #ffd58a; }
  .cg__empty-cta--ghost { background: transparent; color: var(--cg-text); border: 1px solid var(--cg-flame); }
  .cg__empty-cta--ghost:hover { background: rgba(246,193,94,0.10); }

  /* Toast */
  .cg__toast {
    position: fixed; top: 22px; right: 22px; z-index: 9999;
    background: rgba(10,6,16,0.96); border: 1px solid var(--cg-line);
    color: var(--cg-text); padding: 12px 18px; border-radius: 10px;
    font-family: var(--cg-body); font-size: 13.5px; font-weight: 500;
    box-shadow: 0 8px 24px rgba(0,0,0,0.55); backdrop-filter: blur(12px);
    animation: cg-toast-in 0.32s cubic-bezier(0.2,0.8,0.2,1);
  }
  .cg__toast--out { animation: cg-toast-out 0.28s ease forwards; }
  @keyframes cg-toast-in { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes cg-toast-out { to { opacity: 0; transform: translateX(40px); } }

  /* Footer */
  .cg__footer { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--cg-line); }
  .cg__footnote { font-family: var(--cg-mono); font-size: 10.5px; color: var(--cg-text-quiet); text-align: center; margin: 0 0 6px 0; line-height: 1.7; }
  .cg__footnote a { color: var(--cg-flame); text-decoration: none; }
  .cg__footnote a:hover { text-decoration: underline; }
  .cg__footnote--danger a { color: var(--cg-bad); }
</style>

<script>
  // =========================================================================
  //  CAST · GRADUATE — capstone diploma page.
  //  Reads progress from localStorage (/drum-school stars + /cast-make slots)
  //  and renders a rank-awarding diploma. Defensive parsing, deterministic
  //  Noun pick, shareable hash, optional reset.
  // =========================================================================

  // The 8 "music app" Nouns (deterministic pool — same seed picks same face).
  const MUSIC_NOUN_IDS: number[] = [313, 523, 1042, 1189, 287, 742, 612, 928];

  // Kit metadata — small subset needed to render comp cards without
  // re-importing cast-make.astro's full module. Keep keys + colors in sync.
  type KitId = 'fog' | 'block' | 'brass' | 'friday';
  const KIT_META: Record<KitId, { name: string; nounId: number; color: string }> = {
    fog:    { name: 'Marine Layer',  nounId: 313, color: '#9ed6f0' },
    block:  { name: 'Block Runner',  nounId: 523, color: '#a8ff3a' },
    brass:  { name: 'Brass on Main', nounId: 287, color: '#f6c15e' },
    friday: { name: 'Friday Five',   nounId: 612, color: '#ff5f7a' },
  };

  type Rank = 'Apprentice' | 'Novice' | 'Player' | 'Composer' | 'Maestro';
  interface Stars { beat: number; chord: number; interval: number; rhythm: number; }
  const ZERO_STARS: Stars = { beat: 0, chord: 0, interval: 0, rhythm: 0 };

  interface CompShape {
    kit: KitId;
    bpm: number;
    chords: string[];
    drums: { kick: number[]; snare: number[]; hat: number[] };
    lead: string;
  }
  interface SlotEntry { n: number; comp: CompShape; }

  // ---------- defensive localStorage parsing ----------

  function clampStar(v: any): number {
    const n = Number(v);
    if (!Number.isFinite(n)) return 0;
    return Math.max(0, Math.min(3, Math.round(n)));
  }

  function readStars(): Stars {
    try {
      const raw = localStorage.getItem('pc-ds-stars');
      if (!raw) return { ...ZERO_STARS };
      const obj = JSON.parse(raw);
      if (!obj || typeof obj !== 'object') return { ...ZERO_STARS };
      return {
        beat:     clampStar(obj.beat),
        chord:    clampStar(obj.chord),
        interval: clampStar(obj.interval),
        rhythm:   clampStar(obj.rhythm),
      };
    } catch { return { ...ZERO_STARS }; }
  }

  function readSlots(): SlotEntry[] {
    const out: SlotEntry[] = [];
    for (let n = 1; n <= 3; n++) {
      try {
        const raw = localStorage.getItem(`pc-make-slot-${n}`);
        if (!raw) continue;
        const c = JSON.parse(raw);
        if (validateComp(c)) out.push({ n, comp: c });
      } catch { /* skip malformed slot */ }
    }
    return out;
  }

  function validateComp(c: any): c is CompShape {
    if (!c || typeof c !== 'object') return false;
    if (!(c.kit in KIT_META)) return false;
    if (typeof c.bpm !== 'number') return false;
    if (!Array.isArray(c.chords) || c.chords.length !== 4) return false;
    if (!c.drums || !Array.isArray(c.drums.kick) || !Array.isArray(c.drums.snare) || !Array.isArray(c.drums.hat)) return false;
    if (c.drums.kick.length !== 16 || c.drums.snare.length !== 16 || c.drums.hat.length !== 16) return false;
    if (typeof c.lead !== 'string') return false;
    return true;
  }

  // ---------- derived stats ----------

  function totalStars(s: Stars): number { return s.beat + s.chord + s.interval + s.rhythm; }
  function rankFor(total: number): Rank {
    if (total >= 12) return 'Maestro';
    if (total >= 8)  return 'Composer';
    if (total >= 4)  return 'Player';
    if (total >= 1)  return 'Novice';
    return 'Apprentice';
  }

  const RANK_DESC: Record<Rank, string> = {
    Apprentice: 'You showed up. That counts. Train your ear or sketch a tune to take the first step.',
    Novice:     'First stars on the board. The ear is starting to listen. Keep going.',
    Player:     'Halfway. Beat, chord, interval, rhythm — you can read at least two of them on sight.',
    Composer:   'You finish what you start. Slots fill. The fundamentals are second-nature now.',
    Maestro:    'Twelve of twelve. Every drill mastered. The flame is yours.',
  };

  function practiceMinutes(stars: number, slots: number): number {
    return stars * 8 + slots * 12;
  }

  function fmtTime(min: number): string {
    if (min <= 0) return '0m';
    const h = Math.floor(min / 60);
    const m = min % 60;
    if (h === 0) return `${m}m`;
    if (m === 0) return `${h}h`;
    return `${h}h ${m}m`;
  }

  // ---------- deterministic Noun pick ----------
  // Hash totalStars*10 + filledSlots through a tiny xorshift-ish scramble so
  // adjacent inputs don't pick adjacent Nouns. Same input always returns the
  // same Noun — that's the "your face" promise to the user.
  function seededNoun(totalS: number, slots: number): number {
    let seed = (totalS * 10 + slots + 1) >>> 0;
    seed ^= seed << 13; seed >>>= 0;
    seed ^= seed >>> 17;
    seed ^= seed << 5;  seed >>>= 0;
    const idx = seed % MUSIC_NOUN_IDS.length;
    return MUSIC_NOUN_IDS[idx];
  }

  // ---------- share encoding ----------

  function encodeAchievement(s: Stars, slots: number, rank: Rank): string {
    const obj = { v: 1, stars: s, slots, rank };
    return btoa(JSON.stringify(obj)).replace(/=+$/, '');
  }

  function share(s: Stars, slots: number, rank: Rank) {
    const code = encodeAchievement(s, slots, rank);
    const url = `${location.origin}${location.pathname}#${code}`;
    history.replaceState(null, '', '#' + code);
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(
        () => toast('Link copied — share your diploma'),
        () => toast(url),
      );
    } else { toast(url); }
  }

  // ---------- comp -> share hash (matches cast-make encoder) ----------
  // cast-make.astro encodes comps with this exact shape. Replicating here so
  // we can produce /cast-make#... deep-links from saved slots without
  // importing the module. If cast-make's encoder changes, update here too.
  const CHORD_CYCLE = ['I', 'IV', 'V', 'vi'];
  const KIT_ORDER: KitId[] = ['fog', 'block', 'brass', 'friday'];
  const LEAD_ORDER = ['silent', 'arp', 'phrase', 'horn'];
  function encodeCompForLink(c: CompShape): string {
    const kitIdx = KIT_ORDER.indexOf(c.kit);
    const leadIdx = LEAD_ORDER.indexOf(c.lead);
    const chordIdx = c.chords.map((s) => CHORD_CYCLE.indexOf(s as string));
    const pack = (lane: number[]) => lane.reduce((acc, v, i) => acc | (v ? (1 << i) : 0), 0);
    const obj = {
      v: 1,
      k: kitIdx, b: c.bpm, c: chordIdx, l: leadIdx,
      kk: pack(c.drums.kick), sn: pack(c.drums.snare), hh: pack(c.drums.hat),
    };
    return btoa(JSON.stringify(obj)).replace(/=+$/, '');
  }

  // ---------- render ----------

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function starRow(filled: number, total: number, sizeClass = ''): string {
    let html = `<div class="cg__star-row${sizeClass ? ' ' + sizeClass : ''}">`;
    for (let i = 0; i < total; i++) {
      html += `<span class="cg__star${i < filled ? ' cg__star--on' : ''}"></span>`;
    }
    html += '</div>';
    return html;
  }

  function gameCard(name: string, tag: string, count: number): string {
    return `
      <div class="cg__game">
        <div class="cg__game-meta">
          <p class="cg__game-name">${escapeHtml(name)}</p>
          <p class="cg__game-tag">${escapeHtml(tag)} · ${count}/3</p>
        </div>
        <div class="cg__game-stars">${starRow(count, 3).replace('cg__star-row', 'cg__star-row cg__game-stars-row')}</div>
      </div>
    `;
  }

  function compCard(entry: SlotEntry): string {
    const meta = KIT_META[entry.comp.kit];
    if (!meta) return '';
    const hash = encodeCompForLink(entry.comp);
    const href = `/cast-make#${hash}`;
    return `
      <a class="cg__comp" href="${href}" style="--cg-comp-c: ${meta.color};" title="Open in /cast-make">
        <div class="cg__comp-head">
          <div class="cg__comp-portrait"><img src="https://noun.pics/${meta.nounId}.svg" alt=""/></div>
          <div class="cg__comp-meta">
            <p class="cg__comp-name">${escapeHtml(meta.name)}</p>
            <p class="cg__comp-tag">SLOT ${entry.n} · ${entry.comp.bpm} BPM</p>
          </div>
        </div>
        <p class="cg__comp-hint">→ open in /cast-make</p>
      </a>
    `;
  }

  function emptyCompCard(n: number): string {
    return `
      <div class="cg__comp cg__comp--empty">
        <div class="cg__comp-head">
          <div class="cg__comp-portrait" style="opacity:0.5"></div>
          <div class="cg__comp-meta">
            <p class="cg__comp-name">Slot ${n}</p>
            <p class="cg__comp-tag">empty</p>
          </div>
        </div>
        <p class="cg__comp-hint">save one at /cast-make</p>
      </div>
    `;
  }

  function renderEmpty(host: HTMLElement) {
    host.innerHTML = `
      <section class="cg__empty">
        <h2 class="cg__empty-title">Start your journey.</h2>
        <p class="cg__empty-sub">You haven't earned any stars or saved any compositions yet. Pick a door — both are designed to take five minutes.</p>
        <div class="cg__empty-ctas">
          <a class="cg__empty-cta cg__empty-cta--primary" href="/drum-school">→ Train your ear at /drum-school</a>
          <a class="cg__empty-cta cg__empty-cta--ghost" href="/cast-make">→ Make a song at /cast-make</a>
        </div>
      </section>
    `;
  }

  function render() {
    const host = document.getElementById('cg-main');
    if (!host) return;

    const stars = readStars();
    const slots = readSlots();
    const total = totalStars(stars);
    const filledSlots = slots.length;

    if (total === 0 && filledSlots === 0) {
      renderEmpty(host);
      return;
    }

    const rank = rankFor(total);
    const nounId = seededNoun(total, filledSlots);
    const minutes = practiceMinutes(total, filledSlots);
    const isMaestro = rank === 'Maestro';

    // Build comp cards — saved slots first, then empty placeholders to 3.
    const compSlotMap = new Map<number, SlotEntry>();
    slots.forEach((s) => compSlotMap.set(s.n, s));
    const compCards: string[] = [];
    for (let n = 1; n <= 3; n++) {
      const entry = compSlotMap.get(n);
      compCards.push(entry ? compCard(entry) : emptyCompCard(n));
    }

    host.innerHTML = `
      <section class="cg__diploma">
        <div class="cg__portrait${isMaestro ? ' cg__portrait--maestro' : ''}">
          <img src="https://noun.pics/${nounId}.svg" alt="Your graduating Noun"/>
        </div>
        <div class="cg__rank-block">
          <p class="cg__rank-label">RANK AWARDED</p>
          <h2 class="cg__rank${isMaestro ? ' cg__rank--maestro' : ''}">${rank}</h2>
          <p class="cg__rank-desc">${escapeHtml(RANK_DESC[rank])}</p>
          <div class="cg__rank-actions">
            <button class="cg__btn" id="cg-share" type="button">
              <span class="cg__btn-icon">⤴</span> share diploma
            </button>
            <button class="cg__btn cg__btn--ghost" id="cg-replay" type="button" title="Re-read progress from this browser">
              <span class="cg__btn-icon">↻</span> replay
            </button>
          </div>
        </div>
      </section>

      <section class="cg__stats">
        <div class="cg__stat-card">
          <p class="cg__stat-label">TOTAL STARS</p>
          <p class="cg__stat-value">${total}<span class="cg__stat-value-suffix">/ 12</span></p>
          ${starRow(total, 12)}
          <p class="cg__stat-hint">Across all four /drum-school games.</p>
        </div>
        <div class="cg__stat-card">
          <p class="cg__stat-label">COMPOSITIONS</p>
          <p class="cg__stat-value">${filledSlots}<span class="cg__stat-value-suffix">/ 3</span></p>
          <div class="cg__slot-dots">
            <span class="cg__slot-dot${compSlotMap.has(1) ? ' cg__slot-dot--on' : ''}"></span>
            <span class="cg__slot-dot${compSlotMap.has(2) ? ' cg__slot-dot--on' : ''}"></span>
            <span class="cg__slot-dot${compSlotMap.has(3) ? ' cg__slot-dot--on' : ''}"></span>
          </div>
          <p class="cg__stat-hint">Saved on this device at /cast-make.</p>
        </div>
        <div class="cg__stat-card">
          <p class="cg__stat-label">PRACTICE TIME</p>
          <p class="cg__stat-value">${fmtTime(minutes)}</p>
          <p class="cg__stat-hint">Estimate · 8 min per star + 12 min per saved song.</p>
        </div>
      </section>

      <section class="cg__section">
        <header class="cg__section-head">
          <p class="cg__section-label">PER-GAME BREAKDOWN</p>
          <p class="cg__section-hint">Each /drum-school game tops out at 3 stars.</p>
        </header>
        <div class="cg__breakdown">
          ${gameCard('Beat Keeper',  'tempo', stars.beat)}
          ${gameCard('Chord Ear',    'harmony', stars.chord)}
          ${gameCard('Interval Ear', 'pitch', stars.interval)}
          ${gameCard('Rhythm Echo',  'memory', stars.rhythm)}
        </div>
      </section>

      <section class="cg__section">
        <header class="cg__section-head">
          <p class="cg__section-label">COMPOSITIONS · click to load</p>
          <p class="cg__section-hint">Each card opens /cast-make pre-loaded with that song.</p>
        </header>
        <div class="cg__comps">
          ${compCards.join('')}
        </div>
      </section>
    `;

    // Wire up actions inside the freshly rendered section.
    document.getElementById('cg-share')?.addEventListener('click', () => share(stars, filledSlots, rank));
    document.getElementById('cg-replay')?.addEventListener('click', () => { render(); toast('Re-read progress'); });
  }

  // ---------- toast ----------

  let toastHide: number | null = null;
  function toast(msg: string) {
    const el = document.getElementById('cg-toast') as HTMLDivElement | null;
    if (!el) return;
    el.textContent = msg; el.hidden = false; el.classList.remove('cg__toast--out');
    if (toastHide) clearTimeout(toastHide);
    toastHide = window.setTimeout(() => {
      el.classList.add('cg__toast--out');
      setTimeout(() => { el.hidden = true; }, 320);
    }, 2400);
  }

  // ---------- clear-all (destructive, confirmed) ----------

  function clearAll() {
    if (!confirm('Clear all /drum-school stars and /cast-make slots from this device? This cannot be undone.')) return;
    try {
      localStorage.removeItem('pc-ds-stars');
      localStorage.removeItem('pc-make-slot-1');
      localStorage.removeItem('pc-make-slot-2');
      localStorage.removeItem('pc-make-slot-3');
    } catch { /* ignore */ }
    render();
    toast('Progress cleared');
  }

  // ---------- boot ----------

  document.addEventListener('DOMContentLoaded', () => {
    render();
    document.getElementById('cg-clear-all')?.addEventListener('click', (e) => {
      e.preventDefault();
      clearAll();
    });
  });
</script>
</BlockLayout>
