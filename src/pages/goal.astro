<script is:inline define:vars={{ GOAL_RELEASE, GOAL_WITNESSES }}>
(() => {
  const KEY = GOAL_RELEASE.storageKey;
  const JOURNAL_KEY = GOAL_RELEASE.journalKey;
  const SCHEMA = GOAL_RELEASE.storageSchema;
  const WITNESSES = GOAL_WITNESSES;
  const witnessMap = WITNESSES.reduce((map, witness) => {
    map[witness.id] = witness;
    return map;
  }, {});
  const terminalStatuses = new Set(['kept', 'retired-honestly', 'abandoned']);

  function nowISO() { return new Date().toISOString(); }
  function todayISO() { return new Date().toISOString().slice(0, 10); }
  function dayDiff(aISO, bISO) { return Math.floor((Date.parse(bISO) - Date.parse(aISO)) / 86400000); }
  function escapeHtml(s) { return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
  function validWitness(id) { return witnessMap[id] ? id : 'gandalf'; }
  function witnessFor(goalOrId) {
    const id = typeof goalOrId === 'string' ? goalOrId : goalOrId?.goalWitness;
    return witnessMap[validWitness(id)] || witnessMap.gandalf;
  }
  function compactTitle(title) {
    const text = String(title || '(untitled)').trim();
    return text.length > 62 ? text.slice(0, 59) + '...' : text;
  }
  function uniqueMarks(items) {
    const marks = Array.isArray(items) ? items : [];
    return [...new Set(marks.map((item) => String(item).slice(0, 10)).filter(Boolean))].sort();
  }
  function normalizeMarksLog(goal, marks) {
    if (Array.isArray(goal?.marksLog)) {
      return goal.marksLog
        .filter((entry) => entry && entry.date)
        .map((entry) => ({
          date: String(entry.date).slice(0, 10),
          at: String(entry.at || entry.date),
          action: String(entry.action || 'mark'),
        }));
    }
    return marks.map((date) => ({ date, at: date + 'T00:00:00.000Z', action: 'mark' }));
  }
  function emptyStore() {
    return {
      $v: SCHEMA,
      release: GOAL_RELEASE.version,
      activeGoal: null,
      pastGoals: [],
      lastKeepsake: null,
      lastSpeech: null,
      updatedAt: null,
    };
  }
  function normalizeGoal(raw) {
    const today = todayISO();
    const marks = uniqueMarks(raw?.marks);
    const horizon = Number(raw?.horizon) === 30 || Number(raw?.horizon) === 365 ? Number(raw.horizon) : 90;
    const status = String(raw?.status || 'running');
    const goal = {
      id: String(raw?.id || 'local-' + Date.now().toString(36)),
      title: String(raw?.title || '').slice(0, 180),
      why: String(raw?.why || '').slice(0, 240),
      type: String(raw?.type || 'ritual'),
      dailyAction: String(raw?.dailyAction || '').slice(0, 240),
      horizon,
      cohortPartner: String(raw?.cohortPartner || '').slice(0, 120),
      triggerCondition: String(raw?.triggerCondition || '').slice(0, 240),
      startedAt: String(raw?.startedAt || today).slice(0, 10),
      status,
      goalWitness: validWitness(raw?.goalWitness || raw?.witness),
      marks,
      marksLog: normalizeMarksLog(raw, marks),
      lastAffirmation: raw?.lastAffirmation || null,
      createdAt: raw?.createdAt || raw?.startedAt || nowISO(),
      updatedAt: raw?.updatedAt || null,
    };
    return goal;
  }
  function archiveFromGoal(goal, status, line) {
    const endedAt = nowISO();
    const normalizedStatus = status === 'kept' ? 'kept' : status === 'abandoned' ? 'abandoned' : 'retired-honestly';
    return {
      ...goal,
      status: normalizedStatus,
      endedAt,
      completedAt: normalizedStatus === 'kept' ? endedAt : goal.completedAt || null,
      retiredAt: normalizedStatus === 'retired-honestly' ? endedAt : goal.retiredAt || null,
      abandonedAt: normalizedStatus === 'abandoned' ? endedAt : goal.abandonedAt || null,
      marksCount: (goal.marks || []).length,
      witnessLine: line || null,
    };
  }
  function normalizePast(items) {
    const list = Array.isArray(items) ? items : [];
    return list
      .filter((item) => item && typeof item === 'object')
      .map((item) => {
        const goal = normalizeGoal(item);
        const status = item.status === 'kept' || item.status === 'abandoned' || item.status === 'retired-honestly'
          ? item.status
          : item.status === 'retired'
            ? 'retired-honestly'
            : 'abandoned';
        return {
          ...goal,
          status,
          endedAt: item.endedAt || item.completedAt || item.retiredAt || item.abandonedAt || goal.updatedAt || goal.createdAt,
          completedAt: item.completedAt || null,
          retiredAt: item.retiredAt || null,
          abandonedAt: item.abandonedAt || null,
          marksCount: Number(item.marksCount || goal.marks.length) || 0,
          journalLetterId: item.journalLetterId || null,
          witnessLine: item.witnessLine || null,
        };
      })
      .slice(0, 10);
  }
  function normalizeStore(raw) {
    const base = emptyStore();
    if (!raw || typeof raw !== 'object') return base;
    if ('activeGoal' in raw || 'pastGoals' in raw || raw.$v === SCHEMA) {
      const active = raw.activeGoal ? normalizeGoal(raw.activeGoal) : null;
      const past = normalizePast(raw.pastGoals);
      return {
        ...base,
        ...raw,
        $v: SCHEMA,
        release: GOAL_RELEASE.version,
        activeGoal: active && terminalStatuses.has(active.status) ? null : active,
        pastGoals: active && terminalStatuses.has(active.status)
          ? [archiveFromGoal(active, active.status), ...past].slice(0, 10)
          : past,
        lastKeepsake: raw.lastKeepsake || null,
        lastSpeech: raw.lastSpeech || null,
      };
    }
    return {
      ...base,
      activeGoal: normalizeGoal(raw),
      pastGoals: normalizePast(raw.pastGoals),
      lastSpeech: raw.lastSpeech || null,
    };
  }
  function loadStore() {
    try {
      const raw = localStorage.getItem(KEY);
      return normalizeStore(raw ? JSON.parse(raw) : null);
    } catch {
      return emptyStore();
    }
  }
  function saveStore(store) {
    try {
      localStorage.setItem(KEY, JSON.stringify({
        ...store,
        $v: SCHEMA,
        release: GOAL_RELEASE.version,
        pastGoals: (store.pastGoals || []).slice(0, 10),
        updatedAt: nowISO(),
      }));
    } catch {}
  }
  function loadJournal() {
    try {
      const raw = localStorage.getItem(JOURNAL_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed.filter((letter) => letter && letter.body).slice(0, 40) : [];
    } catch {
      return [];
    }
  }
  function saveJournal(journal) {
    try { localStorage.setItem(JOURNAL_KEY, JSON.stringify(journal.slice(0, 40))); } catch {}
  }
  function formatDate(iso) {
    const date = iso ? new Date(iso) : new Date();
    if (Number.isNaN(date.getTime())) return todayISO();
    return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
  }
  function formatTime(iso) {
    const date = iso ? new Date(iso) : new Date();
    if (Number.isNaN(date.getTime())) return '';
    return new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' }).format(date);
  }
  function streakOf(marks) {
    if (!marks || !marks.length) return 0;
    const sorted = [...marks].sort();
    let s = 1;
    for (let i = sorted.length - 1; i > 0; i--) {
      if (dayDiff(sorted[i - 1], sorted[i]) === 1) s += 1;
      else break;
    }
    const today = todayISO();
    const last = sorted[sorted.length - 1];
    if (last !== today && dayDiff(last, today) > 1) return 0;
    return s;
  }
  function nextBand(ticks) {
    const bands = [1, 7, 30, 60, 90, 180, 270, 365];
    for (const b of bands) if (ticks < b) return b;
    return null;
  }
  function chooseLine(lines, previous) {
    const bank = Array.isArray(lines) && lines.length ? lines : ['Keep the machine honest today.'];
    if (bank.length === 1) return bank[0];
    let line = bank[Math.floor(Math.random() * bank.length)];
    for (let i = 0; line === previous && i < 6; i += 1) line = bank[Math.floor(Math.random() * bank.length)];
    return line;
  }
  function progressFor(goal) {
    const horizon = Number(goal?.horizon) || 90;
    const marks = Array.isArray(goal?.marks) ? goal.marks.length : 0;
    return Math.min(100, Math.max(0, Math.round((marks / horizon) * 100)));
  }
  function ballLeftFor(goal) {
    const pct = progressFor(goal);
    return 8 + (pct / 100) * 82;
  }
  function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }
  function setSky() {
    const scene = document.getElementById('field-scene');
    if (!scene) return;
    const hour = new Date().getHours();
    scene.dataset.sky = hour >= 19 || hour < 6 ? 'night' : hour >= 16 ? 'evening' : 'day';
  }
  function composeFieldLetter(goal, witness, line) {
    const endedAt = goal.endedAt || nowISO();
    const date = formatDate(endedAt);
    const time = formatTime(endedAt);
    const marks = Number(goal.marksCount || goal.marks?.length || 0);
    const body = [
      `${witness.name} witnessed the field goal "${goal.title || '(untitled)'}" cross the post on ${date}.`,
      `The machine recorded ${marks} daily tick${marks === 1 ? '' : 's'} against a ${goal.horizon}-day horizon.`,
      `Daily action: ${goal.dailyAction || 'not specified'}`,
      line || witness.completionLines[0],
    ].join('\n');
    return {
      id: `goal-field-${goal.id}-${Date.now().toString(36)}`,
      companion: witness.name,
      companionId: witness.id,
      posture: 'field witness',
      answer: 'goal kept',
      title: `${witness.name} witnessed a goal kept on the field`,
      body,
      signed: `${witness.name} / Field Witness / ${date} / ${time}`,
      date,
      tags: [GOAL_RELEASE.fieldWitnessTag, 'goal-machine', GOAL_RELEASE.version],
      source: '/goal',
      goalId: goal.id,
    };
  }
  function addFieldLetter(goal, witness, line) {
    const letter = composeFieldLetter(goal, witness, line);
    const journal = loadJournal().filter((entry) => entry.id !== letter.id);
    journal.unshift(letter);
    saveJournal(journal);
    return letter;
  }
  function renderGhostNet(pastGoals) {
    const net = document.getElementById('ghost-net');
    if (!net) return;
    net.innerHTML = '';
    pastGoals.slice(0, 10).forEach((goal, index) => {
      const button = document.createElement('button');
      const status = goal.status || 'abandoned';
      button.type = 'button';
      button.className = `ghost-ball ghost-ball--${status}`;
      button.style.left = (18 + (index % 4) * 19) + '%';
      button.style.top = (14 + Math.floor(index / 4) * 28) + '%';
      button.title = `${goal.title || '(untitled)'} - ${status}`;
      button.setAttribute('aria-label', `${goal.title || 'Untitled goal'} - ${status}`);
      net.append(button);
    });
  }
  function renderPastGoals(pastGoals) {
    const list = document.getElementById('past-goal-list');
    if (!list) return;
    const goals = pastGoals.slice(0, 10);
    if (!goals.length) {
      list.innerHTML = '<li>No past goals on this device yet.</li>';
      renderGhostNet([]);
      return;
    }
    list.innerHTML = goals.map((goal) => {
      const status = goal.status || 'abandoned';
      const date = goal.completedAt || goal.retiredAt || goal.abandonedAt || goal.endedAt || '';
      return `
        <li class="past-goals__status--${escapeHtml(status)}">
          <strong>${escapeHtml(compactTitle(goal.title))}</strong>
          <small>${escapeHtml(status.replace('-', ' '))} · ${escapeHtml(witnessFor(goal).name)} · ${escapeHtml(date ? formatDate(date) : 'undated')}</small>
        </li>
      `;
    }).join('');
    renderGhostNet(goals);
  }
  function renderKeepsake(store) {
    const region = document.getElementById('keepsake-region');
    if (!region) return;
    const keepsake = store.lastKeepsake;
    if (!keepsake || keepsake.status !== 'kept') {
      region.innerHTML = '';
      return;
    }
    const witness = witnessFor(keepsake);
    const date = keepsake.completedAt || keepsake.endedAt || nowISO();
    region.innerHTML = `
      <div class="keepsake">
        <article class="postcard" aria-label="Field keepsake postcard">
          <div class="postcard__stamp" style="background:${escapeHtml(witness.accent)}">${escapeHtml(witness.mark)}</div>
          <div class="postcard__body">
            <p class="postcard__kicker">FIELD LETTER · LOCAL KEEPSAKE · ${escapeHtml(GOAL_RELEASE.version)}</p>
            <h3>${escapeHtml(keepsake.title || '(untitled)')}</h3>
            <p>${escapeHtml(keepsake.witnessLine || witness.completionLines[0])}</p>
            <small>${escapeHtml(witness.name)} / ${escapeHtml(formatDate(date))} / ${escapeHtml(Number(keepsake.marksCount || 0))} ticks</small>
          </div>
        </article>
      </div>
    `;
  }
  function renderField(store, mode) {
    const goal = store.activeGoal;
    const scene = document.getElementById('field-scene');
    const pitch = document.getElementById('field-pitch');
    const ball = document.getElementById('field-ball');
    const scoreboard = document.getElementById('scoreboard');
    const witness = witnessFor(goal || store.lastSpeech?.companionId || 'gandalf');
    if (scene) {
      scene.dataset.witness = witness.id;
      scene.style.setProperty('--witness-accent', witness.accent);
      scene.style.setProperty('--witness-deep', witness.deep);
    }
    setText('witness-mark', witness.mark);
    setText('witness-name', witness.name);
    setText('witness-role', witness.role);
    setText('score-witness', witness.name.toUpperCase());
    if (goal) {
      const marks = goal.marks || [];
      const horizon = Number(goal.horizon) || 90;
      const pct = progressFor(goal);
      const streak = streakOf(marks);
      setText('score-title', compactTitle(goal.title).toUpperCase());
      setText('score-yardage', `${marks.length} / ${horizon}`);
      setText('score-streak', String(streak));
      if (pitch) pitch.style.setProperty('--ball-left', ballLeftFor(goal).toFixed(2) + '%');
      if (ball) {
        ball.hidden = false;
        ball.setAttribute('aria-label', `${goal.title || 'Goal'}: ${pct}% to the post`);
      }
      setText('ball-label', `${marks.length}`);
      const speech = store.lastSpeech?.line || witness.opening;
      setText('witness-speech', speech);
    } else {
      setText('score-title', store.lastKeepsake?.status === 'kept' ? 'GOAL KEPT' : 'NO GOAL SET');
      setText('score-yardage', '0 / 90');
      setText('score-streak', '0');
      if (pitch) pitch.style.setProperty('--ball-left', '8%');
      if (ball) ball.hidden = true;
      setText('ball-label', '0');
      setText('witness-speech', store.lastSpeech?.line || 'Set a goal and pick a witness. The first ball waits at midfield.');
    }
    renderPastGoals(store.pastGoals || []);
    renderKeepsake(store);
    if (mode && scene) {
      scene.classList.remove('is-kick', 'is-goal');
      void scene.offsetWidth;
      scene.classList.add(mode === 'goal' ? 'is-goal' : 'is-kick');
      window.setTimeout(() => scene.classList.remove('is-kick', 'is-goal'), 1000);
    }
    if (mode === 'goal' && scoreboard) {
      scoreboard.classList.remove('is-flashing');
      void scoreboard.offsetWidth;
      scoreboard.classList.add('is-flashing');
      window.setTimeout(() => scoreboard.classList.remove('is-flashing'), 1000);
    }
  }
  function renderDashboard(store) {
    const dashEl = document.getElementById('dashboard');
    const actionsEl = document.getElementById('actions');
    if (!dashEl) return;
    const goal = store.activeGoal;
    if (!goal) {
      dashEl.innerHTML = store.lastKeepsake?.status === 'kept'
        ? '<p class="dashboard__placeholder">Last goal kept. The postcard above is stored locally; set the next goal below.</p>'
        : '<p class="dashboard__placeholder">No goal set on this device yet. Use the form below.</p>';
      if (actionsEl) actionsEl.hidden = true;
      return;
    }
    const today = todayISO();
    const startedAt = goal.startedAt || today;
    const daysIn = Math.max(1, dayDiff(startedAt, today) + 1);
    const horizon = Number(goal.horizon) || 90;
    const marks = goal.marks || [];
    const streak = streakOf(marks);
    const pct = progressFor(goal);
    const next = nextBand(marks.length);
    const markedToday = marks.includes(today);
    const witness = witnessFor(goal);
    dashEl.innerHTML = `
      <div class="dashboard__live">
        <p class="dashboard__title">${escapeHtml(goal.title || '(untitled)')}</p>
        <p class="dashboard__meta">
          <span>${escapeHtml((goal.type || '').toUpperCase())}</span>
          <span>${escapeHtml(String(horizon))}-DAY HORIZON</span>
          <span>STARTED ${escapeHtml(startedAt)}</span>
          <span>DAY ${daysIn}</span>
          <span>${marks.length} TICKS</span>
          <span>WITNESS ${escapeHtml(witness.name.toUpperCase())}</span>
          ${next ? `<span>NEXT BAND ${next}</span>` : ''}
        </p>
        <div class="dashboard__streak">
          <span class="dashboard__streak__num">${streak}</span>
          <span class="dashboard__streak__lbl">DAY STREAK · ${marks.length} TOTAL TICKS · ${markedToday ? 'TODAY MARKED' : 'TODAY UNMARKED'}</span>
        </div>
        <div class="dashboard__progress" data-label="${pct}% TO POST">
          <div class="dashboard__progress__fill" style="width: ${pct}%"></div>
        </div>
        <p class="dashboard__action"><strong>Daily action:</strong> ${escapeHtml(goal.dailyAction || '')}</p>
        <p class="dashboard__action" style="background:#fff; border-left-color: var(--gm-rust);"><strong>Trigger:</strong> ${escapeHtml(goal.triggerCondition || '')}</p>
      </div>
    `;
    if (actionsEl) actionsEl.hidden = false;
    const markBtn = document.getElementById('btn-mark');
    if (markBtn) markBtn.textContent = markedToday ? 'TODAY MARKED ✓' : 'MARK TODAY ✓';
  }
  function render(mode) {
    setSky();
    const store = loadStore();
    renderField(store, mode);
    renderDashboard(store);
  }
  function completeGoal(store, goal) {
    const witness = witnessFor(goal);
    const line = chooseLine(witness.completionLines, goal.lastAffirmation);
    const archived = archiveFromGoal(goal, 'kept', line);
    const letter = addFieldLetter(archived, witness, line);
    archived.journalLetterId = letter.id;
    store.activeGoal = null;
    store.pastGoals = [archived, ...(store.pastGoals || [])].slice(0, 10);
    store.lastKeepsake = archived;
    store.lastSpeech = { companionId: witness.id, line, kind: 'completion', at: nowISO() };
    saveStore(store);
  }
  function init() {
    if (document.body.dataset.goalFieldBound === '1') { render(); return; }
    document.body.dataset.goalFieldBound = '1';

    const form = document.getElementById('goal-form');
    if (form) form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      const store = loadStore();
      if (store.activeGoal) {
        const replace = confirm('Archive the current goal as abandoned and set this new one? The old record stays in the back of the net.');
        if (!replace) return;
        const oldWitness = witnessFor(store.activeGoal);
        const oldLine = 'A replacement was declared. The old ball goes faded into the net.';
        store.pastGoals = [archiveFromGoal(store.activeGoal, 'abandoned', oldLine), ...(store.pastGoals || [])].slice(0, 10);
        store.lastSpeech = { companionId: oldWitness.id, line: oldLine, kind: 'abandoned', at: nowISO() };
      }
      const witnessId = validWitness(String(fd.get('goalWitness') || 'gandalf'));
      const witness = witnessFor(witnessId);
      const goal = normalizeGoal({
        id: 'local-' + Date.now().toString(36),
        title: String(fd.get('title') || '').slice(0, 180),
        why: String(fd.get('why') || '').slice(0, 240),
        type: String(fd.get('type') || 'ritual'),
        dailyAction: String(fd.get('dailyAction') || '').slice(0, 240),
        horizon: Number(fd.get('horizon') || 90),
        cohortPartner: String(fd.get('cohortPartner') || '').slice(0, 120),
        triggerCondition: String(fd.get('triggerCondition') || '').slice(0, 240),
        startedAt: todayISO(),
        status: 'running',
        goalWitness: witnessId,
        marks: [],
        marksLog: [],
        createdAt: nowISO(),
      });
      store.activeGoal = goal;
      store.lastKeepsake = null;
      store.lastSpeech = { companionId: witness.id, line: witness.opening, kind: 'set', at: nowISO() };
      saveStore(store);
      form.reset();
      const gandalf = form.querySelector('input[name="goalWitness"][value="gandalf"]');
      if (gandalf) gandalf.checked = true;
      render('kick');
      document.getElementById('field-hero')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('btn-mark')?.addEventListener('click', () => {
      const store = loadStore();
      const goal = store.activeGoal;
      if (!goal) return;
      const today = todayISO();
      const witness = witnessFor(goal);
      if (!goal.marks.includes(today)) {
        goal.marks.push(today);
        goal.marks = uniqueMarks(goal.marks);
        goal.marksLog = [{ date: today, at: nowISO(), action: 'mark' }, ...(goal.marksLog || [])].slice(0, 400);
        const line = chooseLine(witness.affirmations, goal.lastAffirmation);
        goal.lastAffirmation = line;
        goal.updatedAt = nowISO();
        store.lastSpeech = { companionId: witness.id, line, kind: 'mark', at: nowISO() };
        if (goal.marks.length >= Number(goal.horizon || 90)) {
          completeGoal(store, goal);
          render('goal');
          return;
        }
        store.activeGoal = goal;
        saveStore(store);
        render('kick');
        return;
      }
      const line = chooseLine(witness.affirmations, goal.lastAffirmation);
      goal.lastAffirmation = line;
      store.lastSpeech = { companionId: witness.id, line: 'Today is already marked. The ball holds its yard.', kind: 'already-marked', at: nowISO() };
      store.activeGoal = goal;
      saveStore(store);
      render();
    });

    document.getElementById('btn-undo')?.addEventListener('click', () => {
      const store = loadStore();
      const goal = store.activeGoal;
      if (!goal) return;
      const removed = (goal.marks || []).slice(-1)[0];
      goal.marks = (goal.marks || []).slice(0, -1);
      goal.marksLog = [{ date: removed || todayISO(), at: nowISO(), action: 'undo' }, ...(goal.marksLog || [])].slice(0, 400);
      goal.updatedAt = nowISO();
      const witness = witnessFor(goal);
      store.lastSpeech = { companionId: witness.id, line: 'The last yard is undone. Run the machine honestly tomorrow.', kind: 'undo', at: nowISO() };
      store.activeGoal = goal;
      saveStore(store);
      render('kick');
    });

    document.getElementById('btn-retire')?.addEventListener('click', () => {
      const store = loadStore();
      const goal = store.activeGoal;
      if (!goal) return;
      if (!confirm('Retire goal honestly? The record will stay in the back of the net.')) return;
      const witness = witnessFor(goal);
      const line = chooseLine(witness.partings, goal.lastAffirmation);
      const archived = archiveFromGoal(goal, 'retired-honestly', line);
      store.activeGoal = null;
      store.pastGoals = [archived, ...(store.pastGoals || [])].slice(0, 10);
      store.lastKeepsake = null;
      store.lastSpeech = { companionId: witness.id, line, kind: 'retired-honestly', at: nowISO() };
      saveStore(store);
      render();
    });

    render();
  }
  init();
  document.addEventListener('astro:page-load', init);
})();
</script>
