---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  GOAL_RELEASE,
  GOAL_TYPE_LABELS,
  GOAL_WITNESSES,
  HORIZON_BANDS,
  MACHINE_LOOPS,
  MACHINE_META,
  MACHINE_PRINCIPLES,
  SEED_GOALS,
  type GoalType,
} from '../lib/goalMachine';

const title = `${MACHINE_META.title} — The Field`;
const description = `${MACHINE_META.thesis} V1 adds a browser-local pixel field, a witness in the stands, and a keepsake when the ball crosses the post.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/goal',
  name: MACHINE_META.title,
  alternateName: GOAL_RELEASE.label,
  applicationCategory: 'ProductivityApplication',
  softwareVersion: GOAL_RELEASE.version,
  description,
  url: 'https://pointcast.xyz/goal',
  featureList: [
    'one browser-local goal',
    'daily action marks',
    'pixel soccer field progress',
    'V9 Fellowship witness',
    'local V9 Journal field letters',
  ],
  isPartOf: {
    '@type': 'EducationalOrganization',
    name: 'University of El Segundo',
    url: 'https://pointcast.xyz/university-of-el-segundo',
  },
};

const goalTypeKeys = Object.keys(GOAL_TYPE_LABELS) as GoalType[];
const yardTicks = Array.from({ length: 11 }, (_, i) => i * 10);
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/goal.json', title: 'Goal machine (JSON)' }]}
>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span>
      <span>goal</span>
    </nav>

    <header class="hero" id="field-hero">
      <div class="hero__chrome" aria-hidden="true">
        <span>POINTCAST GOAL MACHINE</span>
        <span>EL SEGUNDO FIELD</span>
        <span>{GOAL_RELEASE.version}</span>
      </div>

      <div class="hero__copy">
        <p class="kicker">UES · ONE GOAL · BROWSER-LOCAL · V1</p>
        <h1>THE FIELD.</h1>
        <p class="subtitle">One goal. One ball. One witness in the stands.</p>
        <p class="thesis">{MACHINE_META.thesis}</p>
      </div>

      <section class="field-console" aria-label="The Field">
        <div class="scoreboard" id="scoreboard">
          <div class="scoreboard__cell scoreboard__cell--main">
            <span class="scoreboard__label">CURRENT GOAL</span>
            <strong id="score-title">NO GOAL SET</strong>
          </div>
          <div class="scoreboard__cell">
            <span class="scoreboard__label">WITNESS</span>
            <strong id="score-witness">GANDALF</strong>
          </div>
          <div class="scoreboard__cell">
            <span class="scoreboard__label">YARDAGE</span>
            <strong id="score-yardage">0 / 90</strong>
          </div>
          <div class="scoreboard__cell">
            <span class="scoreboard__label">STREAK</span>
            <strong id="score-streak">0</strong>
          </div>
        </div>

        <div class="field-scene" id="field-scene" data-witness="gandalf" data-sky="day">
          <div class="marine-layer" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>

          <div class="stands" aria-label="Witness in the stands">
            <div class="stands__rail" aria-hidden="true"></div>
            <div class="witness-card">
              <div class="witness-sprite" id="witness-sprite" aria-hidden="true">
                <span id="witness-mark">G</span>
              </div>
              <div>
                <span class="scoreboard__label">FROM THE STANDS</span>
                <strong id="witness-name">Gandalf</strong>
                <small id="witness-role">steady counsel</small>
              </div>
            </div>
            <p class="witness-speech" id="witness-speech" aria-live="polite">
              Set a goal and pick a witness. The first ball waits at midfield.
            </p>
          </div>

          <div class="pitch-wrap">
            <div class="pitch" id="field-pitch" style="--ball-left: 8%;">
              <div class="yard-lines" aria-hidden="true">
                {yardTicks.map((tick) => (
                  <span style={`left: ${tick}%`} data-yard={tick}></span>
                ))}
              </div>
              <div class="center-circle" aria-hidden="true"></div>
              <div class="goal-mouth" aria-hidden="true">
                <div class="goal-post"></div>
                <div class="net" id="goal-net">
                  <div class="ghost-net" id="ghost-net"></div>
                </div>
              </div>
              <button class="field-ball" id="field-ball" type="button" hidden aria-label="Current goal ball">
                <span id="ball-label">0</span>
              </button>
              <div class="windsock" aria-hidden="true"><span></span></div>
            </div>
          </div>
        </div>

        <div class="field-ledger" aria-label="Past goals in the net">
          <div>
            <span class="scoreboard__label">BACK OF NET</span>
            <p>Last 10 kept, retired, or abandoned goals glow behind the post.</p>
          </div>
          <ol class="past-goals" id="past-goal-list">
            <li>No past goals on this device yet.</li>
          </ol>
        </div>

        <div class="keepsake-region" id="keepsake-region" aria-live="polite"></div>
      </section>

      <aside class="v1-callout" aria-label="What's new in V1">
        <p class="kicker">WHAT'S NEW IN V1</p>
        <p>
          The V0 machine now has a field: your declared goal becomes a glowing
          pixel ball, each daily mark moves it toward the post, and a V9
          Fellowship companion witnesses the run from the stands. Completion
          writes a local Field Letter into the V9 Journal. <a href="/gandalf">Meet the witnesses at /gandalf.</a>
        </p>
      </aside>
    </header>

    <section class="machine" id="machine">
      <p class="kicker">YOUR GOAL · IF SET, IT APPEARS HERE</p>
      <h2>The machine.</h2>
      <div class="dashboard" id="dashboard">
        <p class="dashboard__placeholder">No goal set on this device yet. Use the form below.</p>
      </div>
      <div class="actions" id="actions" hidden>
        <button class="btn btn--mark" type="button" id="btn-mark">MARK TODAY ✓</button>
        <button class="btn btn--undo" type="button" id="btn-undo">undo last mark</button>
        <button class="btn btn--retire" type="button" id="btn-retire">retire goal honestly</button>
      </div>
    </section>

    <section class="setup" id="setup">
      <p class="kicker">SET IT</p>
      <h2>One goal. Declare it.</h2>
      <p class="lede">All fields are stored in this browser only. Nothing leaves your device until you log a corresponding ledger entry at <a href="/commons">/commons</a>.</p>
      <form class="form" id="goal-form">
        <label>The goal (one sentence)<input name="title" required maxlength="180" placeholder="e.g., First Bench at Hilltop, built and open by 2026-08-01." /></label>
        <label>Why<input name="why" required maxlength="240" placeholder="Why this. Why now." /></label>
        <label>Type<select name="type" required>
          {goalTypeKeys.map((k) => (<option value={k}>{GOAL_TYPE_LABELS[k]}</option>))}
        </select></label>
        <label>Daily action (the smallest version that counts as a tick)<input name="dailyAction" required maxlength="240" placeholder="e.g., Send one parks-department email, or move one sub-task forward." /></label>
        <label>Horizon<select name="horizon" required>
          <option value="30">30-day</option>
          <option value="90" selected>90-day</option>
          <option value="365">365-day</option>
        </select></label>

        <fieldset class="witness-picker">
          <legend>Witness</legend>
          <div class="witness-picker__grid">
            {GOAL_WITNESSES.map((witness) => (
              <label class="witness-option" style={`--w-color: ${witness.accent}; --w-deep: ${witness.deep};`}>
                <input type="radio" name="goalWitness" value={witness.id} checked={witness.id === 'gandalf'} />
                <span class="witness-option__mark">{witness.mark}</span>
                <span class="witness-option__body">
                  <strong>{witness.name}</strong>
                  <small>{witness.role}</small>
                </span>
              </label>
            ))}
          </div>
          <p class="witness-picker__note">The witness appears in the stands, rotates daily counsel, and signs the Field Letter when the goal is kept.</p>
        </fieldset>

        <label>Cohort partner (optional)<input name="cohortPartner" maxlength="120" placeholder="Marine Layer cohort, parks-department point person, etc." /></label>
        <label>Trigger condition (when the goal is complete)<input name="triggerCondition" required maxlength="240" placeholder="The unambiguous test for done-ness." /></label>
        <button type="submit" class="btn btn--primary">SET THE GOAL · RUN THE MACHINE</button>
      </form>
    </section>

    <section class="loops">
      <p class="kicker">FIVE LOOPS · DAILY → ANNUAL</p>
      <h2>What runs when.</h2>
      <ol class="loop-list">{MACHINE_LOOPS.map((l) => (
        <li class={`loop loop--${l.cadence}`}>
          <span class="loop__cad">{l.cadence.toUpperCase()}</span>
          <p class="loop__act">{l.action}</p>
          <p class="loop__out"><strong>Output:</strong> {l.output}</p>
        </li>
      ))}</ol>
    </section>

    <section class="bands">
      <p class="kicker">EIGHT HORIZON BANDS · WHAT EACH DAY-COUNT MEANS</p>
      <h2>The bands.</h2>
      <ol class="band-list">{HORIZON_BANDS.map((b) => (
        <li class="band">
          <span class="band__day">{b.label}</span>
          <p class="band__meaning">{b.meaning}</p>
        </li>
      ))}</ol>
    </section>

    <section class="principles">
      <p class="kicker">PRINCIPLES</p>
      <h2>Seven rules before any goal is set.</h2>
      <ol class="rules">{MACHINE_PRINCIPLES.map((p, i) => (
        <li><span>{String(i + 1).padStart(2, '0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="seed">
      <p class="kicker">FIVE SEED GOALS · COHORT INSPIRATION</p>
      <h2>What the cohort is running.</h2>
      <p class="lede">These are five real goals the Marine Layer cohort is running today. Each is paired to a UES program, has a declared trigger condition, and points toward a Commons ledger phase. Use them as inspiration; do not copy. Set your own.</p>
      <ol class="seed-list">{SEED_GOALS.map((g) => (
        <li class={`seed-goal seed-goal--${g.status}`}>
          <div class="seed-goal__head">
            <span class="seed-goal__type">{g.type.toUpperCase()}</span>
            <span class={`seed-goal__status seed-goal__status--${g.status}`}>{g.status.toUpperCase()}</span>
          </div>
          <h3>{g.title}</h3>
          <p class="seed-goal__why"><strong>Why:</strong> {g.why}</p>
          <p class="seed-goal__act"><strong>Daily:</strong> {g.dailyAction}</p>
          <p class="seed-goal__trig"><strong>Trigger:</strong> {g.triggerCondition}</p>
          <p class="seed-goal__meta">{g.horizon}-day horizon · {g.uesProgram} · cohort: {g.cohortPartner} · started {g.startedAt}</p>
        </li>
      ))}</ol>
    </section>

    <section class="links">
      <a href="/commons">Log a give-back at /commons</a>
      <a href="/marine-layer">Marine Layer</a>
      <a href="/civic-layer">Civic Layer</a>
      <a href="/common-forms">Common Forms</a>
      <a href="/university-of-el-segundo">UES tracks</a>
      <a href="/gandalf">Witnesses</a>
      <a href="/goal.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root {
    --gm-ink: #1a1a1a;
    --gm-paper: #f4ecd9;
    --gm-mustard: #d4a534;
    --gm-rust: #b85a3a;
    --gm-sage: #7a8c4f;
    --gm-navy: #2a3550;
    --gm-mauve: #a06478;
    --gm-field: #3a8a3a;
    --gm-field-dark: #246f35;
    --gm-chalk: #fff8e8;
    --gm-score: #ffd84a;
    --gm-sky: #7dc5dd;
  }
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 0 88px;
    background: var(--gm-paper);
    color: var(--gm-ink);
    font-family: Inter, system-ui, sans-serif;
  }
  .page > * { padding-inline: 28px; }
  .crumb {
    padding: 18px 28px 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #5a5450;
  }
  .crumb a { color: var(--gm-ink); text-decoration: underline; text-underline-offset: 3px; }

  .hero { padding: 0 28px 40px; }
  .hero__chrome {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 2px;
    margin: 0 -28px 22px;
    background: var(--gm-ink);
    border-top: 6px solid var(--gm-rust);
    border-bottom: 4px solid var(--gm-ink);
    color: var(--gm-score);
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .hero__chrome span { padding: 9px 12px; border-right: 2px solid #4a3b1f; }
  .hero__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 440px);
    gap: 20px 30px;
    align-items: end;
    margin-bottom: 20px;
  }
  .hero__copy .kicker { grid-column: 1 / -1; }
  .kicker {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--gm-ink);
    margin: 0 0 10px;
    padding: 4px 8px;
    background: var(--gm-mustard);
    display: inline-block;
    width: fit-content;
  }
  h1 {
    font-family: var(--pc-font-mono);
    font-size: 104px;
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0;
    text-transform: uppercase;
  }
  .subtitle {
    font-family: Inter, sans-serif;
    font-size: 25px;
    line-height: 1.12;
    font-weight: 700;
    margin: 0 0 10px;
    max-width: 28ch;
  }
  .tagline {
    font-family: var(--pc-font-mono);
    font-size: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #5a5450;
    margin: 0 0 18px;
  }
  .thesis {
    font-size: 15px;
    line-height: 1.55;
    max-width: 64ch;
    margin: 0;
  }

  .field-console {
    padding: 0;
    border: 4px solid var(--gm-ink);
    background: #111;
    box-shadow: 8px 8px 0 var(--gm-rust);
  }
  .scoreboard {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) 1fr 1fr 0.7fr;
    gap: 2px;
    background: var(--gm-ink);
    color: var(--gm-score);
    border-bottom: 4px solid var(--gm-ink);
  }
  .scoreboard__cell {
    min-width: 0;
    background: #241b0e;
    padding: 12px 14px;
    display: grid;
    gap: 5px;
  }
  .scoreboard__cell--main strong { font-size: 18px; }
  .scoreboard__label {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #f4d977;
  }
  .scoreboard strong {
    font-family: var(--pc-font-mono);
    font-size: 15px;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .scoreboard.is-flashing .scoreboard__cell { animation: scoreboard-flash 900ms steps(2, end); }

  .field-scene {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    background:
      linear-gradient(180deg, var(--gm-sky) 0 30%, #a8d4cb 30% 41%, #6a8e51 41% 100%);
    image-rendering: pixelated;
  }
  .field-scene[data-sky='evening'] {
    --gm-sky: #e6a25f;
    background: linear-gradient(180deg, #e6a25f 0 28%, #a86f69 28% 40%, #466f4a 40% 100%);
  }
  .field-scene[data-sky='night'] {
    --gm-sky: #23385f;
    background: linear-gradient(180deg, #23385f 0 28%, #314562 28% 40%, #315640 40% 100%);
  }
  .marine-layer {
    position: absolute;
    inset: 18px auto auto -20%;
    width: 140%;
    height: 70px;
    pointer-events: none;
    opacity: 0.7;
    animation: marine-roll 26s linear infinite;
  }
  .marine-layer span {
    position: absolute;
    display: block;
    width: 160px;
    height: 22px;
    background: rgba(255, 248, 232, 0.76);
    box-shadow: 32px 0 rgba(255, 248, 232, 0.54), 74px 10px rgba(255, 248, 232, 0.46);
  }
  .marine-layer span:nth-child(1) { left: 2%; top: 6px; }
  .marine-layer span:nth-child(2) { left: 36%; top: 26px; width: 210px; }
  .marine-layer span:nth-child(3) { left: 72%; top: 10px; width: 190px; }

  .stands {
    position: relative;
    z-index: 2;
    min-height: 150px;
    padding: 22px 22px 10px;
    display: grid;
    grid-template-columns: 310px minmax(220px, 1fr);
    gap: 16px;
    align-items: end;
  }
  .stands__rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34px;
    background:
      repeating-linear-gradient(90deg, #32261a 0 20px, #4d3a27 20px 38px),
      #32261a;
    border-top: 4px solid var(--gm-ink);
    border-bottom: 4px solid var(--gm-ink);
  }
  .witness-card {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 10px;
    background: #f9efcf;
    border: 3px solid var(--gm-ink);
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.24);
  }
  .witness-card strong {
    display: block;
    font-family: var(--pc-font-mono);
    font-size: 18px;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .witness-card small {
    display: block;
    margin-top: 4px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #5a5450;
  }
  .witness-sprite {
    position: relative;
    width: 58px;
    height: 70px;
    background:
      linear-gradient(var(--witness-accent, #ffb14a) 0 0) 18px 8px / 22px 18px no-repeat,
      linear-gradient(#f0c597 0 0) 16px 0 / 26px 16px no-repeat,
      linear-gradient(var(--witness-deep, #6d2d1f) 0 0) 12px 28px / 34px 26px no-repeat,
      linear-gradient(var(--gm-ink) 0 0) 9px 54px / 14px 14px no-repeat,
      linear-gradient(var(--gm-ink) 0 0) 35px 54px / 14px 14px no-repeat;
  }
  .witness-sprite::before,
  .witness-sprite::after {
    content: '';
    position: absolute;
    top: 32px;
    width: 10px;
    height: 24px;
    background: var(--witness-deep, #6d2d1f);
  }
  .witness-sprite::before { left: 0; }
  .witness-sprite::after { right: 0; }
  .witness-sprite span {
    position: absolute;
    left: 18px;
    top: 30px;
    width: 22px;
    text-align: center;
    color: var(--gm-chalk);
    font-family: var(--pc-font-mono);
    font-size: 13px;
    font-weight: 700;
  }
  .witness-speech {
    position: relative;
    z-index: 3;
    align-self: center;
    margin: 0 0 12px;
    padding: 14px 16px;
    background: #fffdf5;
    border: 3px solid var(--gm-ink);
    font-family: var(--pc-font-mono);
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: 0;
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.2);
  }
  .witness-speech::before {
    content: '';
    position: absolute;
    left: -15px;
    bottom: 18px;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-right: 15px solid var(--gm-ink);
  }

  .pitch-wrap {
    position: relative;
    z-index: 1;
    padding: 14px 18px 24px;
  }
  .pitch {
    position: relative;
    min-height: 300px;
    aspect-ratio: 16 / 6;
    overflow: hidden;
    background-color: var(--gm-field);
    background-image:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.08) 0 2px, transparent 2px 10%),
      repeating-linear-gradient(0deg, rgba(0,0,0,0.05) 0 22px, transparent 22px 44px),
      linear-gradient(90deg, var(--gm-field-dark), var(--gm-field), #4a9b42);
    border: 5px solid var(--gm-chalk);
    box-shadow: inset 0 0 0 4px rgba(26, 26, 26, 0.28), 0 10px 0 rgba(0, 0, 0, 0.24);
  }
  .yard-lines span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 248, 232, 0.42);
  }
  .yard-lines span::after {
    content: attr(data-yard);
    position: absolute;
    top: 8px;
    left: 4px;
    color: rgba(255, 248, 232, 0.7);
    font-family: var(--pc-font-mono);
    font-size: 9px;
  }
  .center-circle {
    position: absolute;
    left: 48%;
    top: 50%;
    width: 86px;
    height: 86px;
    border: 3px solid rgba(255, 248, 232, 0.7);
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }
  .goal-mouth {
    position: absolute;
    top: 15%;
    right: 0;
    width: 17%;
    height: 70%;
  }
  .goal-post {
    position: absolute;
    top: 3%;
    bottom: 3%;
    left: 0;
    width: 18px;
    border-top: 12px solid var(--gm-chalk);
    border-bottom: 12px solid var(--gm-chalk);
    border-left: 12px solid var(--gm-chalk);
    filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.34));
    z-index: 3;
  }
  .net {
    position: absolute;
    inset: 3% 0 3% 12px;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.32) 0 2px, transparent 2px 16px),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.32) 0 2px, transparent 2px 16px),
      rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 248, 232, 0.72);
    transform-origin: left center;
  }
  .field-scene.is-goal .net { animation: net-ripple 950ms steps(4, end); }
  .ghost-net {
    position: absolute;
    inset: 0;
  }
  .ghost-ball {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(26, 26, 26, 0.55);
    border-radius: 50%;
    cursor: help;
    box-shadow: 0 0 10px currentColor;
  }
