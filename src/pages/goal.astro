---
import BlockLayout from '../layouts/BlockLayout.astro';
import { GOAL_PRESETS, GOAL_TYPE_LABELS, HORIZON_BANDS, MACHINE_LOOPS, MACHINE_META, MACHINE_NOTES, MACHINE_PRINCIPLES, SEED_GOALS, type GoalType } from '../lib/goalMachine';

const title = `${MACHINE_META.title} — ${MACHINE_META.subtitle}`;
const description = MACHINE_META.thesis;

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/goal',
  name: MACHINE_META.title,
  applicationCategory: 'ProductivityApplication',
  description,
  url: 'https://pointcast.xyz/goal',
  isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo', url: 'https://pointcast.xyz/university-of-el-segundo' },
};

const goalTypeKeys = Object.keys(GOAL_TYPE_LABELS) as GoalType[];
const goalPresetEntries = Object.entries(GOAL_PRESETS);
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/goal.json', title: 'Goal machine (JSON)' }]}>
  <div class="page" data-goal-presets={JSON.stringify(GOAL_PRESETS)}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span>
      <span>goal</span>
    </nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">UES · ONE GOAL · BROWSER-LOCAL · V0</p>
      <h1>ONE / GOAL.</h1>
      <p class="subtitle">{MACHINE_META.subtitle}</p>
      <p class="tagline">{MACHINE_META.tagline}</p>
      <p class="thesis">{MACHINE_META.thesis}</p>
    </header>

    <section class="machine" id="machine">
      <p class="kicker">YOUR GOAL · IF SET, IT APPEARS HERE</p>
      <h2>The machine.</h2>
      <div class="dashboard" id="dashboard">
        <p class="dashboard__placeholder">No goal set on this device yet. Use the form below.</p>
      </div>
      <div class="actions" id="actions" hidden>
        <button class="btn btn--mark" type="button" id="btn-mark">MARK TODAY ✓</button>
        <button class="btn btn--undo" type="button" id="btn-undo">undo last mark</button>
        <button class="btn btn--retire" type="button" id="btn-retire">retire goal honestly</button>
      </div>
    </section>

    <section class="setup" id="setup">
      <p class="kicker">SET IT</p>
      <h2>One goal. Declare it.</h2>
      <p class="lede">All fields are stored in this browser only. Nothing leaves your device until you log a corresponding ledger entry at <a href="/commons">/commons</a>.</p>
      <div class="presets" aria-label="Goal presets">
        <span>Preset jumps</span>
        {goalPresetEntries.map(([id, preset]) => (
          <a href={`/goal?preset=${id}#setup`}>{preset.label}</a>
        ))}
      </div>
      <p class="preset-status" id="preset-status" aria-live="polite"></p>
      <form class="form" id="goal-form">
        <label>The goal (one sentence)<input name="title" required maxlength="180" placeholder="e.g., First Bench at Hilltop, built and open by 2026-08-01." /></label>
        <label>Why<input name="why" required maxlength="240" placeholder="Why this. Why now." /></label>
        <label>Type<select name="type" required>
          {goalTypeKeys.map((k) => (<option value={k}>{GOAL_TYPE_LABELS[k]}</option>))}
        </select></label>
        <label>Daily action (the smallest version that counts as a tick)<input name="dailyAction" required maxlength="240" placeholder="e.g., Send one parks-department email, or move one sub-task forward." /></label>
        <label>Horizon<select name="horizon" required>
          <option value="30">30-day</option>
          <option value="90" selected>90-day</option>
          <option value="365">365-day</option>
        </select></label>
        <label>Cohort partner (optional)<input name="cohortPartner" maxlength="120" placeholder="Marine Layer cohort, parks-department point person, etc." /></label>
        <label>Trigger condition (when the goal is complete)<input name="triggerCondition" required maxlength="240" placeholder="The unambiguous test for done-ness." /></label>
        <button type="submit" class="btn btn--primary">SET THE GOAL · RUN THE MACHINE</button>
      </form>
    </section>

    <section class="loops">
      <p class="kicker">FIVE LOOPS · DAILY → ANNUAL</p>
      <h2>What runs when.</h2>
      <ol class="loop-list">{MACHINE_LOOPS.map((l) => (
        <li class={`loop loop--${l.cadence}`}>
          <span class="loop__cad">{l.cadence.toUpperCase()}</span>
          <p class="loop__act">{l.action}</p>
          <p class="loop__out"><strong>Output:</strong> {l.output}</p>
        </li>
      ))}</ol>
    </section>

    <section class="bands">
      <p class="kicker">EIGHT HORIZON BANDS · WHAT EACH DAY-COUNT MEANS</p>
      <h2>The bands.</h2>
      <ol class="band-list">{HORIZON_BANDS.map((b) => (
        <li class="band">
          <span class="band__day">{b.label}</span>
          <p class="band__meaning">{b.meaning}</p>
        </li>
      ))}</ol>
    </section>

    <section class="principles">
      <p class="kicker">PRINCIPLES</p>
      <h2>Seven rules before any goal is set.</h2>
      <ol class="rules">{MACHINE_PRINCIPLES.map((p, i) => (
        <li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="seed">
      <p class="kicker">FIVE SEED GOALS · COHORT INSPIRATION</p>
      <h2>What the cohort is running.</h2>
      <p class="lede">These are five real goals the Marine Layer cohort is running today. Each is paired to a UES program, has a declared trigger condition, and points toward a Commons ledger phase. Use them as inspiration; do not copy. Set your own.</p>
      <ol class="seed-list">{SEED_GOALS.map((g) => (
        <li class={`seed-goal seed-goal--${g.status}`}>
          <div class="seed-goal__head">
            <span class="seed-goal__type">{g.type.toUpperCase()}</span>
            <span class={`seed-goal__status seed-goal__status--${g.status}`}>{g.status.toUpperCase()}</span>
          </div>
          <h3>{g.title}</h3>
          <p class="seed-goal__why"><strong>Why:</strong> {g.why}</p>
          <p class="seed-goal__act"><strong>Daily:</strong> {g.dailyAction}</p>
          <p class="seed-goal__trig"><strong>Trigger:</strong> {g.triggerCondition}</p>
          <p class="seed-goal__meta">{g.horizon}-day horizon · {g.uesProgram} · cohort: {g.cohortPartner} · started {g.startedAt}</p>
        </li>
      ))}</ol>
    </section>

    <section class="links">
      <a href="/commons">Log a give-back at /commons</a>
      <a href="/marine-layer">Marine Layer</a>
      <a href="/civic-layer">Civic Layer</a>
      <a href="/common-forms">Common Forms</a>
      <a href="/university-of-el-segundo">UES tracks</a>
      <a href="/goal.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root {
    --gm-ink: #1a1a1a;
    --gm-paper: #f4ecd9;
    --gm-mustard: #d4a534;
    --gm-rust: #b85a3a;
    --gm-sage: #7a8c4f;
    --gm-navy: #2a3550;
    --gm-mauve: #a06478;
  }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--gm-paper); color: var(--gm-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--gm-ink); text-decoration: underline; text-underline-offset: 3px; }

  .hero { padding: 18px 28px 44px; }
  .hero__bar { height: 14px; background: var(--gm-ink); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--gm-ink); margin: 0 0 10px; padding: 4px 8px; background: var(--gm-mustard); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 120px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-family: Inter, sans-serif; font-size: 24px; font-weight: 500; margin: 0 0 6px; max-width: 30ch; }
  .tagline { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; margin: 0 0 18px; }
  .thesis { font-size: 16px; line-height: 1.6; max-width: 64ch; margin: 0; }

  section { padding: 36px 28px; border-top: 4px solid var(--gm-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 32px; line-height: 1; font-weight: 700; letter-spacing: -.01em; margin: 0 0 14px; text-transform: uppercase; }
  .lede { font-size: 15px; line-height: 1.55; max-width: 70ch; margin: 0 0 16px; color: var(--gm-ink); }
  .lede a { color: var(--gm-ink); text-decoration: underline; text-underline-offset: 3px; }

  .machine { background: #fff; border-bottom: 4px solid var(--gm-ink); }
  .dashboard { padding: 18px; background: var(--gm-paper); border: 3px solid var(--gm-ink); margin-bottom: 14px; min-height: 180px; }
  .dashboard__placeholder { margin: 0; font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .12em; color: #5a5450; }
  .dashboard__live { display: grid; gap: 14px; }
  .dashboard__title { margin: 0; font-family: var(--pc-font-mono); font-size: 20px; font-weight: 700; }
  .dashboard__meta { display: flex; flex-wrap: wrap; gap: 14px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .dashboard__streak { display: flex; align-items: baseline; gap: 14px; padding: 14px 16px; background: var(--gm-ink); color: var(--gm-paper); }
  .dashboard__streak__num { font-family: var(--pc-font-mono); font-size: 64px; font-weight: 700; line-height: 1; color: var(--gm-mustard); }
  .dashboard__streak__lbl { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; }
  .dashboard__progress { height: 24px; background: #fff; border: 2px solid var(--gm-ink); position: relative; overflow: hidden; }
  .dashboard__progress::before { content: attr(data-label); position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; color: var(--gm-ink); z-index: 2; mix-blend-mode: difference; color: white; }
  .dashboard__progress__fill { height: 100%; background: repeating-linear-gradient(45deg, var(--gm-mustard) 0 12px, var(--gm-rust) 12px 24px); transition: width 600ms ease; }
  .dashboard__action { font-size: 14px; line-height: 1.5; padding: 10px 12px; background: var(--gm-mustard); border-left: 4px solid var(--gm-ink); }
  .dashboard__action strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; margin-right: 6px; }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .btn { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; padding: 12px 16px; border: 0; cursor: pointer; }
  .btn--primary { background: var(--gm-ink); color: var(--gm-paper); padding: 16px 22px; font-size: 14px; }
  .btn--primary:hover { background: var(--gm-rust); }
  .btn--mark { background: var(--gm-mustard); color: var(--gm-ink); }
  .btn--mark:hover { background: var(--gm-rust); color: var(--gm-paper); }
  .btn--undo { background: #fff; color: var(--gm-ink); border: 2px solid var(--gm-ink); }
  .btn--retire { background: var(--gm-mauve); color: var(--gm-paper); margin-left: auto; }

  .form { display: grid; gap: 12px; max-width: 720px; }
  .form label { display: flex; flex-direction: column; gap: 5px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--gm-ink); }
  .form input, .form select { font-family: inherit; font-size: 15px; padding: 10px 12px; border: 2px solid var(--gm-ink); background: #fff; color: var(--gm-ink); border-radius: 0; }
  .presets { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 14px; }
  .presets span,
  .presets a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .presets span { color: #5a5450; margin-right: 4px; }
  .presets a { padding: 9px 11px; background: #fff; color: var(--gm-ink); border: 2px solid var(--gm-ink); text-decoration: none; }
  .presets a:hover { background: var(--gm-mustard); }
  .preset-status { min-height: 18px; margin: -4px 0 12px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--gm-rust); }

  .loop-list, .band-list, .seed-list, .rules { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .loop { padding: 14px 16px; background: #fff; border: 2px solid var(--gm-ink); display: grid; gap: 6px; }
  .loop__cad { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; padding: 4px 8px; background: var(--gm-ink); color: var(--gm-paper); justify-self: start; }
  .loop__act { margin: 0; font-size: 14px; line-height: 1.55; }
  .loop__out { margin: 0; font-size: 13px; color: #2a2a2a; }
  .loop__out strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; margin-right: 4px; }

  .band { display: grid; grid-template-columns: 220px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 1.5px solid var(--gm-ink); align-items: baseline; }
  .band__day { font-family: var(--pc-font-mono); font-size: 13px; font-weight: 700; color: var(--gm-rust); }
  .band__meaning { margin: 0; font-size: 14px; line-height: 1.5; }

  .rules li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--gm-ink); align-items: baseline; }
  .rules span { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--gm-rust); }
  .rules p { margin: 0; font-size: 15px; line-height: 1.5; }

  .seed-goal { padding: 14px 16px; background: #fff; border: 2px solid var(--gm-ink); border-left: 12px solid var(--gm-sage); }
  .seed-goal--running { border-left-color: var(--gm-sage); }
  .seed-goal--set { border-left-color: var(--gm-mustard); }
  .seed-goal--paused { border-left-color: var(--gm-mauve); }
  .seed-goal__head { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
  .seed-goal__type { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; padding: 3px 7px; background: var(--gm-ink); color: var(--gm-paper); }
  .seed-goal__status { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; padding: 3px 7px; background: var(--gm-paper); border: 1px solid var(--gm-ink); }
  .seed-goal__status--running { color: var(--gm-sage); }
  .seed-goal__status--set { color: var(--gm-mustard); }
  .seed-goal h3 { font-family: var(--pc-font-mono); font-size: 16px; line-height: 1.25; font-weight: 700; margin: 0 0 8px; }
  .seed-goal p { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .seed-goal strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; margin-right: 4px; }
  .seed-goal__meta { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .04em; color: #5a5450; margin-top: 6px !important; padding-top: 6px; border-top: 1px solid #c8c4b3; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 14px; background: var(--gm-ink); color: var(--gm-paper); text-decoration: none; }
  .links a:hover { background: var(--gm-rust); }

  @media (max-width: 800px) {
    h1 { font-size: 80px; }
    .band { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    h1 { font-size: 56px; }
  }
</style>

<script is:inline>
  const KEY = 'pointcast.goal.machine.v0';
  function load() { try { const r = localStorage.getItem(KEY); const p = r ? JSON.parse(r) : null; return p && typeof p === 'object' ? p : null; } catch { return null; } }
  function save(g) { try { localStorage.setItem(KEY, JSON.stringify(g)); } catch {} }
  function clear() { try { localStorage.removeItem(KEY); } catch {} }
  function escapeHtml(s) { return String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function todayISO() { return new Date().toISOString().slice(0, 10); }
  function dayDiff(aISO, bISO) { return Math.floor((Date.parse(bISO) - Date.parse(aISO)) / 86400000); }
  function streakOf(marks) {
    if (!marks || !marks.length) return 0;
    const sorted = [...marks].sort();
    let s = 1;
    for (let i = sorted.length - 1; i > 0; i--) {
      if (dayDiff(sorted[i - 1], sorted[i]) === 1) s++; else break;
    }
    const today = todayISO();
    const last = sorted[sorted.length - 1];
    if (last !== today && dayDiff(last, today) > 1) return 0;
    return s;
  }
  function nextBand(daysIn) {
    const bands = [1, 7, 30, 60, 90, 180, 270, 365];
    for (const b of bands) if (daysIn < b) return b;
    return null;
  }
  function readPresets() {
    const raw = document.querySelector('.page')?.getAttribute('data-goal-presets') || '{}';
    try { return JSON.parse(raw); } catch { return {}; }
  }
  function applyPresetFromUrl() {
    const form = document.getElementById('goal-form');
    if (!form || form.dataset.presetApplied === '1') return;
    const id = new URLSearchParams(window.location.search).get('preset');
    const preset = id ? readPresets()[id] : null;
    if (!preset) return;
    for (const key of ['title', 'why', 'type', 'dailyAction', 'horizon', 'cohortPartner', 'triggerCondition']) {
      const field = form.elements[key];
      if (field && preset[key] !== undefined) field.value = String(preset[key]);
    }
    form.dataset.presetApplied = '1';
    const status = document.getElementById('preset-status');
    if (status) status.textContent = `${preset.label || 'Goal preset'} loaded. Review it, then set the goal.`;
  }
  function render() {
    const dashEl = document.getElementById('dashboard');
    const actionsEl = document.getElementById('actions');
    const setupEl = document.getElementById('setup');
    if (!dashEl) return;
    const g = load();
    if (!g) {
      dashEl.innerHTML = '<p class="dashboard__placeholder">No goal set on this device yet. Use the form below.</p>';
      if (actionsEl) actionsEl.hidden = true;
      if (setupEl) setupEl.style.display = '';
      return;
    }
    const today = todayISO();
    const startedAt = g.startedAt || today;
    const daysIn = Math.max(1, dayDiff(startedAt, today) + 1);
    const horizon = Number(g.horizon) || 90;
    const marked = g.marks || [];
    const streak = streakOf(marked);
    const pct = Math.min(100, Math.round((daysIn / horizon) * 100));
    const next = nextBand(daysIn);
    const markedToday = marked.includes(today);
    dashEl.innerHTML = `
      <div class="dashboard__live">
        <p class="dashboard__title">${escapeHtml(g.title || '(untitled)')}</p>
        <p class="dashboard__meta">
          <span>${escapeHtml((g.type || '').toUpperCase())}</span>
          <span>${escapeHtml(String(horizon))}-DAY HORIZON</span>
          <span>STARTED ${escapeHtml(startedAt)}</span>
          <span>DAY ${daysIn} / ${horizon}</span>
          ${next ? `<span>NEXT BAND ${next}</span>` : ''}
        </p>
        <div class="dashboard__streak">
          <span class="dashboard__streak__num">${streak}</span>
          <span class="dashboard__streak__lbl">DAY STREAK · ${marked.length} TOTAL TICKS · ${markedToday ? 'TODAY MARKED' : 'TODAY UNMARKED'}</span>
        </div>
        <div class="dashboard__progress" data-label="${pct}% TO HORIZON">
          <div class="dashboard__progress__fill" style="width: ${pct}%"></div>
        </div>
        <p class="dashboard__action"><strong>Daily action:</strong> ${escapeHtml(g.dailyAction || '')}</p>
        <p class="dashboard__action" style="background:#fff; border-left-color: var(--gm-rust);"><strong>Trigger:</strong> ${escapeHtml(g.triggerCondition || '')}</p>
      </div>
    `;
    if (actionsEl) actionsEl.hidden = false;
    const markBtn = document.getElementById('btn-mark');
    if (markBtn) markBtn.textContent = markedToday ? 'TODAY MARKED ✓' : 'MARK TODAY ✓';
    if (setupEl) setupEl.style.display = '';
  }
  function init() {
    if (document.body.dataset.goalBound === '1') { render(); return; }
    document.body.dataset.goalBound = '1';
    const form = document.getElementById('goal-form');
    applyPresetFromUrl();
    if (form) form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      const goal = {
        id: 'local-' + Date.now().toString(36),
        title: String(fd.get('title') || '').slice(0, 180),
        why: String(fd.get('why') || '').slice(0, 240),
        type: String(fd.get('type') || 'ritual'),
        dailyAction: String(fd.get('dailyAction') || '').slice(0, 240),
        horizon: Number(fd.get('horizon') || 90),
        cohortPartner: String(fd.get('cohortPartner') || '').slice(0, 120),
        triggerCondition: String(fd.get('triggerCondition') || '').slice(0, 240),
        startedAt: todayISO(),
        status: 'running',
        marks: [],
      };
      save(goal);
      form.reset();
      render();
      document.getElementById('machine')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.getElementById('btn-mark')?.addEventListener('click', () => {
      const g = load(); if (!g) return;
      g.marks = g.marks || [];
      const today = todayISO();
      if (!g.marks.includes(today)) g.marks.push(today);
      save(g); render();
    });
    document.getElementById('btn-undo')?.addEventListener('click', () => {
      const g = load(); if (!g) return;
      g.marks = (g.marks || []).slice(0, -1);
      save(g); render();
    });
    document.getElementById('btn-retire')?.addEventListener('click', () => {
      if (!confirm('Retire goal honestly? This is not failure; it is honesty. Local data will be cleared.')) return;
      clear(); render();
    });
    render();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
