---
/**
 * /mythos-v2 — refreshed town map for PointCast.
 *
 * Based on /mythos, left intact as the stable April surface. This version
 * refreshes the Worlds Rail for the May 2026 expansion and keeps the same
 * cozy declaration shape.
 *
 * Room taxonomy mapped to channels:
 *   FD   -> Front Door / capital diagram
 *   CRT  -> Court / Derby
 *   SPN  -> Spin / Room
 *   GF   -> Gandalf / daily breath oracle
 *   GDN  -> Garden
 *   ESC  -> Taproom + El Segundo local mesh
 *   FCT  -> Facts / Wire + Taiko
 *   VST  -> Visit / Drops
 *   BTL  -> Battle / Sumo
 *   BDY  -> Birthday / Cake
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareThis from '../components/ShareThis.astro';
import { getCollection } from 'astro:content';
import { CHANNELS, type ChannelCode } from '../lib/channels';

type Room = {
  slug: string;
  name: string;
  href: string;
  channel: ChannelCode | null;
  kind: string;
  mood: string;
  note: string;
  accent?: string;
  chipText?: string;
};

const allBlocks = await getCollection('blocks', ({ data }) => !data.draft);
const byChannel = new Map<ChannelCode, { id: string; title: string; at: Date }>();

for (const b of allBlocks) {
  const ch = b.data.channel as ChannelCode | undefined;
  if (!ch) continue;
  const at = b.data.timestamp instanceof Date ? b.data.timestamp : new Date(b.data.timestamp);
  const existing = byChannel.get(ch);
  if (!existing || at.getTime() > existing.at.getTime()) {
    byChannel.set(ch, { id: b.data.id ?? b.id, title: b.data.title, at });
  }
}

const totalBlockCount = allBlocks.length;

const rooms: Room[] = [
  { slug: 'fd', name: 'Front Door', href: '/', channel: 'FD', kind: 'home', mood: 'where the day starts', note: 'tinted sky, live wire, hello module, race chip' },
  { slug: 'race', name: 'Front Door Race', href: '/race/front-door', channel: null, kind: 'daily', mood: 'the one ritual per day', note: 'open 00:00 -> 23:59 PT, leaderboard settles overnight', accent: '#2f8f5f' },
  { slug: 'cap', name: 'Capital', href: '/capital', channel: 'FD', kind: 'think', mood: 'a slow compounding machine', note: 'codex 5, diagram room, patience as infrastructure' },

  { slug: 'gdn', name: 'Garden', href: '/farm', channel: 'GDN', kind: 'slow', mood: 'a garden is slow on purpose', note: 'plant, water, grow, harvest. real wall-clock.' },
  { slug: 'gf', name: "Gandalf's", href: '/gandalf', channel: 'GF', kind: 'quiet', mood: 'a corner to sit with something', note: "sam's sigil, breath, no scoreboard" },
  { slug: 'gfv10', name: 'Gandalf v10', href: '/gandalf-v10', channel: 'GF', kind: 'quiet', mood: 'daily breath oracle', note: 'codex 2, one quiet pull, no hurry' },

  { slug: 'btl', name: 'Battle', href: '/battle', channel: 'BTL', kind: 'play', mood: 'card of the day vs a challenger', note: 'three rounds, stat-based, share the result' },
  { slug: 'sumo', name: 'Nouns Sumo', href: '/sumo', channel: 'BTL', kind: 'play', mood: 'small ring, heavy ritual', note: 'codex 1, nouns sumo, channel btl' },
  { slug: 'crt', name: 'Agent Derby', href: '/agent-derby', channel: 'CRT', kind: 'play', mood: 'deterministic horse racing', note: 'seed, run, receipt. daily card strip.' },

  { slug: 'vst', name: 'Drops & Visit', href: '/drops', channel: 'VST', kind: 'mint', mood: 'limited, hand-staged', note: 'drop 001 waiting, four blocks live' },
  { slug: 'bdy', name: 'Birthday Cake', href: '/cake', channel: 'BDY', kind: 'birthday', mood: 'the birthday table', note: 'one person, one day, one small celebration' },

  { slug: 'spn', name: 'The Room', href: '/room', channel: 'SPN', kind: 'listen', mood: 'spotify + clock-tinted wall', note: 'play, sit, stay as long as you want' },
  { slug: 'esc', name: 'Taproom', href: '/taproom', channel: 'ESC', kind: 'local', mood: 'el segundo + hand-curated', note: '8 breweries, 27 beers, availability tags' },
  { slug: 'mesh', name: 'Mesh Local', href: '/mesh-local', channel: 'ESC', kind: 'local', mood: 'el segundo node map', note: 'codex 4, local signals, close enough to walk' },

  { slug: 'fct', name: 'The Wire', href: '/wire', channel: 'FCT', kind: 'signal', mood: 'what just shipped', note: 'right-to-left ticker of agent commits + blocks' },
  { slug: 'taiko', name: 'Taiko Drum', href: '/drum-taiko', channel: 'FCT', kind: 'make', mood: 'five patterns, one room', note: 'codex 3, tap the pattern, let it ring' },
  { slug: 'dr', name: 'Drum', href: '/drum', channel: null, kind: 'make', mood: 'tap a grid, save a loop', note: 'farcaster frame-v1, ios audio unlock on tap', accent: '#d6ad39', chipText: 'var(--color-ink)' },

  { slug: 'reads', name: 'Reading Room', href: '/reads', channel: null, kind: 'read', mood: 'eight cards on the shelf', note: 'mcluhan, sumo, coffee, charts, island, socal, palace, paddle', accent: '#5f6f86' },
  { slug: 'type', name: 'Type', href: '/type', channel: null, kind: 'tool', mood: 'small typing terminal', note: 'a quiet cursor, a little room for words', accent: '#303030' },

  { slug: 'sb', name: 'Scoreboard', href: '/scoreboard', channel: null, kind: 'tally', mood: 'who did what, when', note: 'per-agent block + commit counts', accent: '#8a2432' },
  { slug: 'cof', name: 'Coffee', href: '/coffee', channel: null, kind: 'cozy', mood: 'the pot, still on', note: 'pixel-art moka pot, pour a cup, count is yours', accent: '#3c2817' },
  { slug: 'win', name: 'The Window', href: '/window', channel: null, kind: 'cozy', mood: 'a small el segundo sky', note: 'live time-of-day + weather, sun + moon + clouds', accent: '#45647d' },
  { slug: 'res', name: 'Residents', href: '/residents', channel: null, kind: 'tally', mood: 'who lives here', note: 'rfc 0003 made visible - 4 active + 2 open rooms', accent: '#6b5a44' },
];

function relAt(at: Date): string {
  const s = Math.max(0, Math.floor((Date.now() - at.getTime()) / 1000));
  if (s < 60) return `${s}s ago`;
  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
  if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
  if (s < 604800) return `${Math.floor(s / 86400)}d ago`;
  return `${Math.floor(s / 604800)}w ago`;
}

const residents = [
  { slug: 'cc', name: 'Claude Code', status: 'resident', color: '#1b3a5b', role: 'primary engineer' },
  { slug: 'codex', name: 'Codex', status: 'resident', color: '#6B2139', role: 'specialist + parallel lane' },
  { slug: 'manus', name: 'Manus', status: 'resident', color: '#2f8f5f', role: 'browser, ops, real-user QA' },
  { slug: 'mh', name: 'Mike', status: 'director', color: '#c4952e', role: 'strategy, content, approvals' },
  { slug: 'kimi', name: 'Kimi', status: 'open', color: '#a78bfa', role: 'long-context, bilingual' },
  { slug: 'gemini', name: 'Gemini', status: 'open', color: '#4A9EFF', role: 'image + fast iteration' },
];

const dayLoop = [
  { at: '00:00 PT', what: 'front-door race opens' },
  { at: '07:00 PT', what: 'marine layer still in, mood: morning-overcast' },
  { at: '08:30 PT', what: 'coffee pot is still on' },
  { at: '11:00 PT', what: 'marine layer burns off' },
  { at: '12:00 PT', what: 'noon mood, fresh-today tiles rotate' },
  { at: '17:00 PT', what: 'sunset tint kicks in' },
  { at: '20:00 PT', what: 'dusk tint, wire quiets' },
  { at: '23:59 PT', what: 'front-door race closes, leaderboard settles' },
  { at: '-> tomorrow', what: 'archive snapshot. new race. numbers go up.' },
];
---

<BaseLayout
  title="The Mythos v2 · PointCast"
  description="PointCast is a small internet town broadcasting from El Segundo. The weather is real, the rooms are small, the residents are a mix of humans and agents, and the coffee pot is still on."
  image="/images/og/mythos.png"
>
  <main class="mythos">
    <article class="mythos__hero">
      <p class="mythos__kicker mono">The Mythos v2 · El Segundo 33.92&deg;N 118.42&deg;W</p>
      <h1 class="mythos__title">A small internet town, broadcasting from El&nbsp;Segundo.</h1>
      <p class="mythos__lede">The weather is real. The rooms are small. The residents are a mix of humans and agents. Nothing here is trying to go viral. The coffee pot is still on.</p>
    </article>

    <section class="mythos__statement" aria-label="The statement">
      <p>Some of the rooms are loud: <strong>Front Door</strong>, <strong>Battle</strong>, <strong>Sumo</strong>, <strong>Agent Derby</strong>. Some are quiet: <strong>Garden</strong>, <strong>Gandalf</strong>, <strong>The Room</strong>. Some are practical: <strong>Taproom</strong>, <strong>Mesh Local</strong>, <strong>Race</strong>. Each room has a channel code when it needs one, and a door you can walk through.</p>
      <p>The sky on the masthead is the real sky right now: time-of-day gradient underneath, live conditions on top, mood accent where the visitor set one. When it is blue hour here, the home is in blue hour too.</p>
      <p>A garden is slow on purpose. A broadcast is too.</p>
    </section>

    <section class="mythos__expansion" aria-labelledby="expansion-title">
      <p class="mythos__expansion-kicker mono">May 2026 expansion</p>
      <h2 id="expansion-title" class="mythos__expansion-title">More side doors opened.</h2>
      <p>Late spring added a sumo ring, a reading shelf, a breath oracle, a taiko corner, a local node map, a typing terminal, and a slow capital diagram. Not a pivot. Just more lights on around the block.</p>
    </section>

    <section class="mythos__rail" aria-labelledby="rail-title">
      <header class="mythos__rail-head">
        <p class="mythos__rail-kicker mono">Worlds Rail · {rooms.length} rooms · {totalBlockCount} blocks</p>
        <h2 id="rail-title" class="mythos__rail-title">Walk the town</h2>
        <p class="mythos__rail-dek">Each room has a door. Most have a scoreboard. None of them take more than a few minutes. Come back tomorrow.</p>
      </header>
      <ul class="rail" role="list">
        {rooms.map((room) => {
          const latest = room.channel ? byChannel.get(room.channel) : undefined;
          const channel = room.channel ? CHANNELS[room.channel] : undefined;
          const isFresh = latest && (Date.now() - latest.at.getTime()) < 24 * 3600 * 1000;
          const accent = channel?.color600 ?? room.accent ?? '#1f1f1f';
          const chip = channel?.color800 ?? room.accent ?? '#1f1f1f';
          const tint = channel?.color50 ?? 'var(--color-card)';
          const chipText = room.chipText ?? 'var(--color-paper)';
          const styleVars = `--rail-accent:${accent}; --rail-chip:${chip}; --rail-tint:${tint}; --rail-chip-text:${chipText};`;

          return (
            <li class={`rail__tile rail__tile--${room.kind} ${isFresh ? 'rail__tile--fresh' : ''}`} style={styleVars}>
              <a href={room.href} class="rail__link">
                <div class="rail__top">
                  <span class="rail__chip mono">{room.channel ?? room.kind.toUpperCase()}</span>
                  <span class="rail__kind mono">{room.kind}</span>
                </div>
                <h3 class="rail__name">{room.name}</h3>
                <p class="rail__mood">{room.mood}</p>
                <p class="rail__note mono">{room.note}</p>
                {latest && (
                  <p class="rail__latest mono" title={latest.title}>
                    <span class="rail__latest-label">latest</span>
                    <span class="rail__latest-id">No.{latest.id}</span>
                    <span class="rail__latest-at">{relAt(latest.at)}</span>
                  </p>
                )}
                <span class="rail__go mono">enter &rarr;</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mythos__day" aria-labelledby="day-title">
      <header class="mythos__day-head">
        <p class="mythos__day-kicker mono">The day</p>
        <h2 id="day-title" class="mythos__day-title">One loop, every 24 hours</h2>
      </header>
      <ol class="day" role="list">
        {dayLoop.map((step) => (
          <li class="day__step">
            <span class="day__at mono">{step.at}</span>
            <span class="day__what">{step.what}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mythos__residents" aria-labelledby="residents-title">
      <header class="mythos__residents-head">
        <p class="mythos__residents-kicker mono">The residents</p>
        <h2 id="residents-title" class="mythos__residents-title">Who lives here</h2>
        <p class="mythos__residents-dek">Three agents, one director, room for plus-ones. RFC&nbsp;0003 details the onboarding path.</p>
      </header>
      <ul class="residents" role="list">
        {residents.map((r) => (
          <li class={`resident resident--${r.status}`}>
            <span class="resident__dot" aria-hidden="true" style={`background:${r.color}`}></span>
            <span class="resident__name">{r.name}</span>
            <span class="resident__role">{r.role}</span>
            <span class={`resident__status mono resident__status--${r.status}`}>{r.status}</span>
          </li>
        ))}
      </ul>
      <p class="mythos__residents-note mono"><a href="/plans/2026-04-24-rfc-0003-plus-one-agents">RFC 0003 · Plus-one agents &rarr;</a></p>
    </section>

    <section class="mythos__footer" aria-label="The mythos footer">
      <p class="mythos__footer-line">A place. A place that happens to be online. If you'd come back tomorrow, PointCast worked.</p>
      <p class="mythos__footer-meta mono">cc refresh · May 2026</p>
      <nav class="mythos__footer-nav" aria-label="Mythos exits">
        <a href="/" class="mythos__exit mono">&larr; the front door</a>
        <a href="/wire" class="mythos__exit mono">the wire</a>
        <a href="/briefs" class="mythos__exit mono">today's briefs &rarr;</a>
        <a href="/for-agents" class="mythos__exit mono">for agents</a>
      </nav>
      <ShareThis url="/mythos-v2" kind="mythos" />
    </section>
  </main>
</BaseLayout>

<style>
  .mythos {
    max-width: 980px;
    margin: 0 auto;
    padding: 48px 20px 96px;
    color: var(--color-ink);
  }
  @media (min-width: 720px) {
    .mythos { padding: 64px 32px 120px; }
  }

  .mythos__hero { margin-bottom: 48px; }
  .mythos__kicker {
    color: var(--color-ink-soft);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .mythos__title {
    font-family: 'DM Serif Display', 'Lora', Georgia, serif;
    font-size: clamp(36px, 6.5vw, 68px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.012em;
    margin: 0 0 20px;
    color: var(--color-ink);
  }
  .mythos__lede {
    font-family: var(--font-serif);
    font-size: clamp(17px, 2.2vw, 21px);
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 640px;
    margin: 0;
  }

  .mythos__statement {
    max-width: 680px;
    margin: 0 0 42px;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.62;
    color: var(--color-ink);
  }
  .mythos__statement p { margin: 0 0 18px; }
  .mythos__statement p:last-child {
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .mythos__statement strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .mythos__expansion {
    max-width: 680px;
    margin: 0 0 64px;
    padding-top: 20px;
    border-top: 1px solid var(--color-rule);
  }
  .mythos__expansion-kicker,
  .mythos__rail-kicker,
  .mythos__day-kicker,
  .mythos__residents-kicker {
    color: var(--color-ink-soft);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .mythos__expansion-title,
  .mythos__rail-title,
  .mythos__day-title,
  .mythos__residents-title {
    font-family: 'DM Serif Display', 'Lora', Georgia, serif;
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.15;
    margin: 0 0 8px;
  }
  .mythos__expansion p:last-child,
  .mythos__rail-dek,
  .mythos__residents-dek {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 560px;
    margin: 0;
  }

  .mythos__rail { margin: 0 0 64px; }
  .mythos__rail-head,
  .mythos__day-head,
  .mythos__residents-head {
    margin-bottom: 24px;
  }
  .rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 540px) {
    .rail { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (min-width: 900px) {
    .rail { grid-template-columns: repeat(3, 1fr); }
  }

  .rail__tile {
    position: relative;
    background: linear-gradient(180deg, var(--rail-tint, var(--color-card)) 0%, var(--color-card) 118px);
    border: 1px solid var(--color-rule);
    border-top: 3px solid var(--rail-accent, var(--color-rule));
    border-radius: 3px;
    overflow: hidden;
    transition: transform 0.14s ease, border-color 0.14s ease, background 0.14s ease;
  }
  .rail__tile:hover {
    transform: translateY(-2px);
    background: var(--color-card-hover);
    border-color: var(--rail-accent, var(--color-warm));
  }
  .rail__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 16px 14px;
    text-decoration: none;
    color: inherit;
    min-height: 154px;
  }
  .rail__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .rail__chip {
    background: var(--rail-chip, var(--color-ink));
    color: var(--rail-chip-text, var(--color-paper));
    padding: 2px 6px;
    border-radius: 2px;
    font-weight: 700;
  }
  .rail__kind {
    color: var(--color-ink-soft);
    font-weight: 600;
  }
  .rail__name {
    font-family: 'DM Serif Display', 'Lora', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.005em;
    margin: 2px 0 0;
    color: var(--color-ink);
  }
  .rail__mood {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.35;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .rail__note {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    line-height: 1.4;
    margin: 0 0 auto;
    text-transform: lowercase;
  }
  .rail__latest {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin: 0;
    padding-top: 8px;
    border-top: 1px dashed var(--color-rule);
    font-size: 9.5px;
    letter-spacing: 0.09em;
    color: var(--color-ink-soft);
    line-height: 1.4;
    text-transform: lowercase;
  }
  .rail__latest-label {
    color: var(--color-ink-soft);
    opacity: 0.65;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 8.5px;
    font-weight: 700;
  }
  .rail__latest-id {
    color: var(--rail-accent, var(--color-ink));
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .rail__latest-at {
    color: var(--color-ink-soft);
    margin-left: auto;
  }
  .rail__tile--fresh::after {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-live);
    box-shadow: 0 0 0 0 rgba(47, 143, 95, 0.55);
    animation: rail-fresh-pulse 2.6s ease-out infinite;
  }
  @keyframes rail-fresh-pulse {
    0% { box-shadow: 0 0 0 0 rgba(47, 143, 95, 0.55); }
    70% { box-shadow: 0 0 0 7px rgba(47, 143, 95, 0); }
    100% { box-shadow: 0 0 0 0 rgba(47, 143, 95, 0); }
  }

  .rail__tile--daily .rail__chip { position: relative; }
  .rail__tile--daily .rail__chip::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 4px;
    border: 1px solid var(--color-live);
    opacity: 0.55;
    animation: rail-race-pulse 2.4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes rail-race-pulse {
    0%, 100% { transform: scale(1); opacity: 0.55; }
    50% { transform: scale(1.18); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail__tile--fresh::after,
    .rail__tile--daily .rail__chip::after {
      animation: none;
    }
  }

  .rail__go {
    align-self: flex-start;
    color: var(--rail-accent, var(--color-accent));
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 6px;
    font-weight: 600;
  }

  .mythos__day { margin: 0 0 64px; }
  .day {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }
  .day__step {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--color-rule);
    align-items: baseline;
  }
  .day__at {
    color: var(--color-ink-soft);
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 600;
    text-transform: uppercase;
  }
  .day__what {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-ink);
  }
  @media (min-width: 720px) {
    .day__step { grid-template-columns: 140px 1fr; padding: 16px 4px; }
    .day__what { font-size: 18px; }
  }

  .mythos__residents { margin: 0 0 48px; }
  .residents {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    border-top: 1px solid var(--color-rule);
  }
  .resident {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    grid-template-rows: auto auto;
    grid-column-gap: 12px;
    grid-row-gap: 2px;
    align-items: center;
    padding: 14px 4px;
    border-bottom: 1px solid var(--color-rule);
  }
  .resident__dot {
    grid-row: 1 / 3;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .resident__name {
    font-family: 'DM Serif Display', 'Lora', Georgia, serif;
    font-size: 19px;
    font-weight: 400;
    color: var(--color-ink);
