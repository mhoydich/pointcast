---
import BlockLayout from '../layouts/BlockLayout.astro';
import set from '../data/spellframe-first-light.json';
const schools = [
  { id: 'archive', name: 'Archive', note: 'Memory, timing, and the next good decision.', color: '#497f95' },
  { id: 'ember', name: 'Ember', note: 'Pressure, momentum, and a little nerve.', color: '#b25c36' },
  { id: 'verdant', name: 'Verdant', note: 'Patience, recovery, and growing together.', color: '#587957' },
  { id: 'neutral', name: 'The commons', note: 'Shared tools that bring a deck together.', color: '#8a7351' },
];
const description = 'Meet Spellframe: an original PointCast arena-fighter prototype and First Light, its set of 50 illustrated cards. In development.';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'Spellframe — First Light',
  description, url: 'https://pointcast.xyz/spellframe', creativeWorkStatus: 'In development',
  creator: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---
<BlockLayout title="Spellframe — First Light" description={description} image="https://pointcast.xyz/images/spellframe/arena.webp" jsonLd={jsonLd} alternates={[{type:'application/json',href:'/spellframe.json',title:'Spellframe project and First Light card catalog'}]}>
  <article class="spellframe">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">← PointCast</a><span>From the workshop</span><a href="/spellframe.json">Card catalog / JSON</a></nav>
    <header class="hero">
      <img src="/images/spellframe/arena.webp" alt="Spellframe’s moonlit arena beside a lake, waterfalls and the ruins of an old library" width="1600" height="900" fetchpriority="high" />
      <div class="hero__copy"><p class="kicker">An original PointCast game · in development</p><h1>Spellframe</h1><p>A little strategy.<br />A beautiful world.<br /><em>A very good move.</em></p><a href="#first-light">Explore the 50-card First Light set <span aria-hidden="true">↓</span></a></div>
    </header>
    <section class="intro" aria-label="About the prototype">
      <div><p class="kicker">The first duel</p><h2>Read the moment.<br /><em>Make it yours.</em></h2></div>
      <div><p>Spellframe began with a question: could watching agents play be as interesting as playing yourself? We’re building an original world around that idea, starting with a real, playable duel.</p><p>The current Unity prototype has movement, guarding, high and low attacks, throws, anti-air moves, combos and a focus-powered special. Cinderfox and Rootkeeper are the first two fighters.</p><p class="status"><strong>On the workbench.</strong> The playable builds are in private testing. This page is an art and project preview. Real model-powered fighters, online tournaments and purchases are future work.</p></div>
    </section>
    <section class="fighters" aria-label="The first fighters">
      <article><img src="/images/spellframe/fox.webp" alt="Cinderfox, a spirited orange fox carrying a blade through the moonlit library" width="640" height="427" loading="lazy" /><div><p class="kicker">Ember / Cinderfox</p><h2>A little spark.</h2><p>Quick feet. A sharp read. Pressure that rewards choosing the right moment.</p></div></article>
      <article><img src="/images/spellframe/root.webp" alt="Rootkeeper, a living woodland guardian in the First Light world" width="640" height="427" loading="lazy" /><div><p class="kicker">Verdant / Rootkeeper</p><h2>A steady answer.</h2><p>A patient guardian. More health, deliberate movement, and room to turn a fight around.</p></div></article>
    </section>
    <section class="first-light" id="first-light" aria-labelledby="first-light-title">
      <header class="set-head"><div><p class="kicker">First Light / all {set.cards.length} original card illustrations</p><h2 id="first-light-title">Meet the first set.</h2></div><p>Three schools and a handful of shared tools. These are the practice card rules; they’re still evolving as the card battler and arena take shape.</p></header>
      <nav class="school-nav" aria-label="First Light schools">{schools.map(school=><a href={`#${school.id}`} style={`--school:${school.color}`}>{school.name} <span>{set.cards.filter(card=>card.school===school.id).length}</span></a>)}</nav>
      {schools.map(school=>(
        <section class="school" id={school.id} style={`--school:${school.color}`} aria-labelledby={`${school.id}-title`}>
          <header><h3 id={`${school.id}-title`}>{school.name}</h3><p>{school.note}</p></header>
          <div class="cards">{set.cards.filter(card=>card.school===school.id).map(card=>(
            <article class="card"><img src={card.image} alt={card.name + ' — original First Light card illustration'} width="640" height="427" loading="lazy" decoding="async" /><div class="card__body"><p class="card__number">{String(card.number).padStart(2,'0')} / FIRST LIGHT <span>{card.energy} energy</span></p><h4>{card.name}</h4><details><summary>Practice card rules</summary><p>{card.rules}</p>{card.type==='creature'&&<p class="card__stats">{card.power} power · {card.health} health</p>}</details></div></article>
          ))}</div>
        </section>
      ))}
    </section>
    <footer class="project-foot"><div><h2>Made to be played.<br /><em>Worth watching, too.</em></h2><p>Follow the work here as the prototype grows. For something to play right now, the Rosebud drum garden is open.</p></div><a href="/rosebud">Play Rosebud <span aria-hidden="true">↗</span></a><a href="/">Back to PointCast <span aria-hidden="true">↗</span></a></footer>
  </article>
</BlockLayout>
<style>
  :global(html body:has(.spellframe)) { background:#f5f0e5; }
  .spellframe { max-width:1240px;margin:auto;padding:0 24px 50px;color:#2d302a;font-family:var(--pc-font-sans); }
  .spellframe a { color:inherit; }
  .spellframe :is(a,summary):focus-visible { outline:3px solid #b2603b;outline-offset:5px; }
  .crumb { display:flex;gap:22px;align-items:center;padding:22px 0;font:550 10px var(--pc-font-mono);color:#6f6e60; }
  .crumb a:last-child { margin-left:auto; }
  .hero { position:relative;background:#0c2634;overflow:hidden;min-height:530px; }
  .hero > img { position:absolute;width:100%;height:100%;object-fit:cover;opacity:.65; }
  .hero::after { content:'';position:absolute;inset:0;background:linear-gradient(90deg,#071a29d9,transparent 90%); }
  .hero__copy { position:relative;z-index:1;padding:60px;color:#fff0d0; }
  .kicker { font:600 10px/1.6 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;margin:0 0 18px; }
  .hero h1 { margin:0 0 28px;font-size:clamp(54px,9vw,115px);line-height:1;font-weight:550;letter-spacing:-.065em; }
  .hero__copy > p:not(.kicker) { font-size:clamp(22px,3vw,35px);font-weight:350;line-height:1.3;letter-spacing:-.02em; }
  em { font-style:normal;color:#b76641; }
  .hero em { color:#ecc082; }
  .hero a { display:inline-block;margin-top:15px;padding-bottom:7px;border-bottom:1px solid #afab8e;font-size:12px;font-weight:550;text-decoration:none; }
  .hero a span { margin-left:25px; }
  .intro { display:grid;grid-template-columns:1fr 1.3fr;gap:70px;padding:65px 0; }
  .intro h2,.set-head h2,.project-foot h2 { font-size:clamp(32px,4.5vw,52px);line-height:1.06;letter-spacing:-.055em;font-weight:570;margin:0; }
  .intro p:not(.kicker) { font-size:15px;line-height:1.75;margin:0 0 19px;color:#605e50; }
  .intro .status { padding:17px 20px;background:#eae4d5;font-size:12px!important;border-left:3px solid #b18354; }
  .fighters { display:grid;grid-template-columns:1fr 1fr;gap:24px; }
  .fighters article { background:#fffbf0;border:1px solid #d8d0bf; }
  .fighters img { width:100%;height:auto;aspect-ratio:1.5;object-fit:cover;display:block; }
  .fighters article > div { padding:27px; }
  .fighters h2 { margin:0 0 14px;font-size:35px;letter-spacing:-.05em;font-weight:580; }
  .fighters p:last-child { color:#6b6253;font-size:14px;line-height:1.65;margin:0; }
  .first-light { padding-top:75px;scroll-margin-top:30px; }
  .set-head { display:grid;grid-template-columns:1.2fr 1fr;gap:55px;align-items:end; }
  .set-head > p { color:#6b6253;font-size:14px;line-height:1.7; }
  .school-nav { display:flex;flex-wrap:wrap;gap:12px;margin:27px 0 10px; }
  .school-nav a { border:1px solid #bcb7a7;padding:12px 16px;font-size:12px;text-decoration:none;color:var(--school);font-weight:600; }
  .school-nav span { margin-left:20px;font-family:var(--pc-font-mono);font-size:10px; }
  .school { padding-top:40px;scroll-margin-top:20px; }
  .school > header { display:flex;gap:25px;align-items:baseline;border-top:2px solid var(--school);padding:17px 0; }
  .school h3 { color:var(--school);font-size:27px;font-weight:580;letter-spacing:-.04em;margin:0; }
  .school > header p { color:#716b5c;font-size:12px;margin:0; }
  .cards { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px; }
  .card { background:#fffdf6;border:1px solid #d7cfbd;min-width:0; }
  .card img { display:block;width:100%;height:auto;aspect-ratio:1.5;object-fit:cover; }
  .card__body { padding:15px; }
  .card__number { margin:0 0 12px;font:500 8px var(--pc-font-mono);color:#766e5e;display:flex;justify-content:space-between;gap:5px; }
  .card h4 { margin:0 0 14px;font-size:18px;font-weight:570;letter-spacing:-.035em; }
  .card details { border-top:1px solid #e3dbcc;padding-top:10px;font-size:10px;color:#706557; }
  .card summary { cursor:pointer;font-weight:550; }
  .card details p { font-size:12px;line-height:1.65; }
  .card__stats { color:var(--school); }
  .project-foot { display:flex;gap:30px;align-items:center;padding:55px 0 0;margin-top:55px;border-top:1px solid #c5baa4; }
  .project-foot > div { margin-right:auto; }
  .project-foot h2 { font-size:35px; }
  .project-foot p { color:#706557;font-size:13px;line-height:1.7;max-width:43ch; }
  .project-foot a { font-size:12px;white-space:nowrap; }
  .project-foot span { padding-left:10px; }
  @media(max-width:850px) { .intro { gap:30px; } .cards { grid-template-columns:repeat(3,minmax(0,1fr)); } .hero__copy { padding:40px; } .project-foot { flex-wrap:wrap; } }
  @media(max-width:600px) { .spellframe { padding-inline:16px; } .crumb { font-size:8px;gap:10px; } .hero { min-height:480px; } .hero__copy { padding:35px 23px; } .intro,.set-head,.fighters { grid-template-columns:1fr;gap:25px; } .intro { padding:40px 0; } .cards { grid-template-columns:repeat(2,minmax(0,1fr));gap:12px; } .card__body { padding:11px; } .card__number { font-size:7px;flex-wrap:wrap; } .card h4 { font-size:16px; } .school > header { display:block; } .school > header p { margin-top:8px;line-height:1.5; } .first-light { padding-top:45px; } }
</style>
