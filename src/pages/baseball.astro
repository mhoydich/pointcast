---
import BlockLayout from '../layouts/BlockLayout.astro';
import { Content } from '../content/guides/baseball.md';
import { BASEBALL_TITLE, BASEBALL_DESCRIPTION, sources, plays } from '../data/baseball.mjs';
const imageAlt = 'Original painted illustration of an anonymous baseball park in amber evening light, with small groups watching from the grandstand.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: BASEBALL_TITLE, description: BASEBALL_DESCRIPTION, datePublished: '2026-10-03', author: { '@type': 'Organization', name: 'PointCast · Codex' }, publisher: { '@type': 'Organization', name: 'PointCast' }, url: 'https://pointcast.xyz/baseball', image: 'https://pointcast.xyz/images/baseball/social.webp' };
---
<BlockLayout title={BASEBALL_TITLE} description={BASEBALL_DESCRIPTION} author="PointCast · Codex" image="/images/baseball/social.webp" imageAlt={imageAlt} themeColor="#f3efdf" jsonLd={jsonLd} immersive isolated hideAds alternates={[{ type: 'application/json', href: '/baseball.json', title: 'Baseball — full text and sources' }]}>
  <div class="baseball-feature" data-baseball>
    <nav class="masthead" aria-label="Publication"><a class="brand" href="/">PointCast<span>LOOK AT THE WORLD</span></a><span class="issue">FIELD STUDY / 001<br />03 OCTOBER 2026</span><a class="nav-link" href="#inning">Take a seat ↘</a></nav>
    <header class="opening">
      <div class="title-block"><p class="eyebrow"><span aria-hidden="true">◉</span> A LOOK AT BASEBALL</p><h1>A game you<br />can sit <em>inside.</em></h1><p class="dek">The field. The pauses. The pencil.<br />And the people beside you.</p><div class="opening-meta"><span>AN ESSAY & HALF AN INNING</span><span>5 MINUTES + YOUR AFTERNOON</span></div></div>
      <figure class="ballpark"><img src="/images/baseball/ballpark.webp" alt={imageAlt} width="1672" height="941" fetchpriority="high" /><figcaption><span>A PLACE TO LOOK AT SOMETHING TOGETHER.</span><span>ORIGINAL ILLUSTRATION / POINTCAST</span></figcaption><div class="ticket" aria-hidden="true"><span>ADMIT</span><b>TWO</b><span>YOU + SOMEONE</span></div></figure>
    </header>
    <div class="lede"><p>Sometimes the most interesting thing about a game<br class="desktop-break" /> is the kind of company it makes possible.</p><a href="#essay">Read the field note ↓</a></div>

    <section class="inning" id="inning" aria-labelledby="inning-title">
      <div class="section-heading"><p class="eyebrow">01 / TAKE A SEAT</p><h2 id="inning-title">You have a pencil.<br />We have half an inning.</h2><p>No experience needed. Follow six batters and watch a little afternoon find its shape.</p></div>
      <div class="interactive" data-interactive hidden>
        <div class="scoreboard"><div><span>POINTCAST PARK</span><b>TOP OF THE FIRST</b></div><div class="score-stat"><span>RUNS</span><b data-runs>0</b></div><div class="score-stat"><span>HITS</span><b data-hits>0</b></div><div class="out-stat"><span>OUTS</span><div data-outs aria-label="0 outs"><i></i><i></i><i></i></div></div></div>
        <div class="inning-layout"><div class="field-panel">
          <svg class="diamond-field" viewBox="0 0 620 410" role="img" aria-labelledby="field-title field-desc"><title id="field-title">Our little ballpark</title><desc id="field-desc">Home plate at the bottom, first on the right, second at the top, third on the left. No runners on base.</desc>
            <defs><pattern id="grass-stripes" width="50" height="50" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="25" height="50" fill="#2c5a3f" /></pattern></defs>
            <path d="M310 350 68 147Q310 -35 552 147Z" fill="#35674a"/><path d="M310 350 68 147Q310 -35 552 147Z" fill="url(#grass-stripes)" opacity=".45"/>
            <path d="M310 350 132 200Q310 49 488 200Z" fill="#b9764b"/><path d="M310 322 216 228 310 134 404 228Z" fill="#3a6b4d"/><path d="M310 325 70 128M310 325 550 128" fill="none" stroke="#eee5c7" stroke-width="2"/>
            <path d="M310 325 410 225 310 125 210 225Z" fill="none" stroke="#f3efdf" stroke-width="2" opacity=".7"/>
            <circle cx="310" cy="251" r="22" fill="#b9764b"/><path d="M303 251h14" stroke="#f3efdf" stroke-width="3"/>
            <path d="M303 325h14v8l-7 5-7-5Z" fill="#f3efdf"/>
            <g fill="#f3efdf"><rect x="404" y="219" width="12" height="12" transform="rotate(45 410 225)"/><rect x="304" y="119" width="12" height="12" transform="rotate(45 310 125)"/><rect x="204" y="219" width="12" height="12" transform="rotate(45 210 225)"/></g>
            <g class="runner" data-base="0" visibility="hidden"><circle cx="410" cy="225" r="15"/><text x="410" y="229">01</text></g><g class="runner" data-base="1" visibility="hidden"><circle cx="310" cy="125" r="15"/><text x="310" y="129">01</text></g><g class="runner" data-base="2" visibility="hidden"><circle cx="210" cy="225" r="15"/><text x="210" y="229">01</text></g>
            <path data-ball-path d="M310 325 310 325" fill="none" stroke="#ffdb85" stroke-width="2" stroke-dasharray="4 5"/><circle data-ball cx="310" cy="325" r="5" fill="#ffefc5" stroke="#172e24" stroke-width="1" visibility="hidden"/>
            <g class="field-labels"><text x="450" y="244">FIRST</text><text x="310" y="98" text-anchor="middle">SECOND</text><text x="131" y="244">THIRD</text><text x="310" y="365" text-anchor="middle">HOME</text><text x="310" y="394" text-anchor="middle" data-base-caption>EVERY RUN IS A JOURNEY HOME.</text></g>
            <text x="72" y="365" class="field-sign">PC</text><text x="544" y="365" class="field-sign" text-anchor="end">01</text>
          </svg>
          <div class="lens-buttons" role="group" aria-label="Choose what to notice"><button data-lens="ball" aria-pressed="true">The ball</button><button data-lens="pencil" aria-pressed="false">The pencil</button><button data-lens="company" aria-pressed="false">The company</button></div>
        </div><div class="scorecard-panel">
          <div class="card-heading"><span>YOUR SCORECARD</span><span data-step>0 / 6 BATTERS</span></div>
          <div class="scorecard-grid" aria-label="Six-batter scorecard">{plays.map((play, i) => <div class="score-cell" data-cell={i}><span class="batter-number">{String(i + 1).padStart(2, '0')}</span><svg viewBox="0 0 60 60" aria-hidden="true"><path d="M30 51 51 30 30 9 9 30Z" fill="none" stroke="currentColor" stroke-width="1" opacity=".3"/></svg><b data-mark>·</b><span data-play-name>waiting</span></div>)}</div>
          <div class="play-note" aria-live="polite" role="status"><p class="eyebrow" data-play-eyebrow>THE AFTERNOON IS OPEN</p><h3 data-play-title>Let’s see what happens.</h3><p data-play-copy>Press “Next batter” to follow the ball. Change your view to notice the pencil or the company.</p></div>
          <div class="inning-controls"><button class="next-batter" data-next>Next batter <span aria-hidden="true">→</span></button><button class="previous-batter" data-previous disabled aria-label="Go back one batter">← Back</button></div>
        </div></div>
        <p class="interaction-note">A composed half inning. The plays and runner advances are illustrative. <a href="#inning-transcript">Read every play ↓</a></p>
      </div>
      <noscript><p class="no-script">The interactive scorecard needs JavaScript. You can read the complete inning below.</p></noscript>
      <details id="inning-transcript" class="transcript"><summary>The half inning, on paper <span>1B · K · BB · 2B · SF · K</span></summary><ol>{plays.map(play => <li><b>{play.code} — {play.name}.</b> {play.line}</li>)}</ol><p>Two runs, two hits, three outs. One runner left on base.</p></details>
    </section>

    <section class="essay-section" id="essay" aria-labelledby="essay-title"><aside><p class="eyebrow">02 / THE FIELD NOTE</p><h2 id="essay-title">A way<br />to spend<br />an afternoon.</h2><div class="distance"><b>90′</b><span>BETWEEN THE BASES</span><svg viewBox="0 0 110 110" aria-hidden="true"><path d="M55 5 105 55 55 105 5 55Z" fill="none" stroke="currentColor" stroke-width="1"/><path d="M55 105 55 55" fill="none" stroke="currentColor" stroke-dasharray="3 4"/><circle cx="55" cy="55" r="4" fill="currentColor"/></svg><p>A shared grammar.<br />A local accent.</p></div><span class="editorial-credit">POINTCAST EDITORIAL<br />DRAFTED BY CODEX</span></aside><article class="essay"><Content /><p class="essay-signoff">PointCast / a look at baseball</p></article></section>

    <section class="memory-section" aria-labelledby="memory-title"><div><p class="eyebrow">03 / LEAVE ROOM FOR SOMEONE</p><h2 id="memory-title">Who taught<br />you to watch?</h2><p>A person, a place, a radio voice.<br />Keep one small piece of the afternoon.</p><div class="stitch" aria-hidden="true">⌁ ⌁ ⌁ ⌁ ⌁</div></div><div class="memory-desk" data-memory-desk hidden><label for="baseball-memory">My little baseball memory</label><textarea id="baseball-memory" maxlength="280" rows="4" placeholder="A folding chair beside a neighborhood field. Someone explaining why the runner waited…"></textarea><div class="memory-count"><span data-character-count>0 / 280</span><span>SAVED ONLY IN THIS BROWSER</span></div><label for="baseball-ritual">Bring something to the next inning</label><select id="baseball-ritual"><option value="company">A little company</option><option value="pencil">A pencil</option><option value="listen">A radio</option></select><p class="invitation" data-invitation>Come watch an inning with me. You do not need to know everything.</p><div class="memory-buttons"><button data-save-memory>Keep this memory</button><button data-download-memory>Download the card ↗</button><button data-clear-memory>Clear</button></div><p class="memory-status" role="status" aria-live="polite" data-memory-status>Write a memory, then keep it or take the card with you.</p></div><noscript><p>Try this with someone: “Who taught you to watch?” Bring a pencil, a radio, or a little company to the next inning.</p></noscript></section>

    <section class="source-desk" aria-labelledby="sources-title"><div class="sources-heading"><p class="eyebrow">04 / THE RECORD</p><h2 id="sources-title">Facts have a home, too.</h2><p>The historical and rule details below are sourced. The reading of baseball as a place for shared attention is PointCast’s interpretation.</p></div><div class="sources-grid">{sources.map((source, i) => <article><span class="eyebrow">{String(i + 1).padStart(2, '0')} / SOURCE NOTE</span><h3>{source.title}</h3><p>{source.note}</p><a href={source.url}>{source.publisher} ↗</a></article>)}</div></section>
    <footer class="baseball-footer"><p>There’s a game somewhere.<br /><em>Leave a seat beside you.</em></p><div><a href="#inning">One more half inning ↑</a><a href="/p">More things to play →</a><a href="/b/0688">Keep the field note →</a><a href="/baseball.json">Full text & sources JSON ↗</a></div><span class="eyebrow">POINTCAST / THE WORLD IS MORE INTERESTING TOGETHER.</span></footer>
  </div>
  <script>import '../scripts/baseball';</script>
</BlockLayout>
<style is:global>
  html:has(.baseball-feature){--pc-bg:#f3efdf;--pc-ink:#1e3428;--pc-accent:#a6402d}body:has(.baseball-feature){background:#f3efdf!important}.baseball-feature{--green:#1e3428;--rust:#a6402d;--paper:#f3efdf;--mono:'JetBrains Mono Variable',monospace;max-width:1240px;margin:auto;padding:28px 40px 50px}.baseball-feature [hidden]{display:none!important}.baseball-feature button,.baseball-feature select,.baseball-feature textarea{font:inherit}.baseball-feature button{cursor:pointer}.baseball-feature button:disabled{cursor:default;opacity:.4}.baseball-feature :is(a,button,select,textarea):focus-visible{outline:3px solid #2673b4;outline-offset:5px}.baseball-feature a{color:inherit!important}.eyebrow,.issue,.opening-meta,.ballpark figcaption{font:10px/1.7 var(--mono);letter-spacing:.075em}.masthead{display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--green);padding-bottom:20px;gap:20px}.brand{font-size:29px;letter-spacing:-1.5px;font-weight:700;text-decoration:none!important}.brand span{display:block;font:8px/1.4 var(--mono);letter-spacing:.17em;margin-top:4px}.issue{text-align:center;font-size:9px}.nav-link{font-size:12px}.opening{padding:52px 0 0}.title-block{position:relative}.title-block .eyebrow{color:var(--rust);margin:0 0 20px}.title-block .eyebrow span{font-size:15px;margin-right:6px}.title-block h1{font-size:clamp(63px,8vw,100px);line-height:.97;letter-spacing:-.075em;font-weight:650;margin:0 0 25px}.title-block em,.baseball-footer em{font:italic 1.03em Georgia,serif;letter-spacing:-.07em;color:var(--rust)}.dek{position:absolute;right:0;bottom:53px;font-size:20px;line-height:1.5;letter-spacing:-.04em;margin:0;max-width:310px}.opening-meta{display:flex;justify-content:space-between;border-top:1px solid #b7bca8;padding:15px 0 18px;font-size:9px}.ballpark{position:relative;margin:0}.ballpark img{width:100%;aspect-ratio:1672/941;object-fit:cover;max-height:510px}.ballpark figcaption{display:flex;justify-content:space-between;border-bottom:1px solid #b7bca8;padding:12px 0;font-size:8px;color:#55614f;gap:15px}.ticket{position:absolute;right:35px;bottom:66px;background:var(--paper);border:1px solid var(--green);padding:18px 22px;transform:rotate(8deg);text-align:center;box-shadow:5px 5px 0 #18291e55}.ticket span{display:block;font:8px/1.5 var(--mono);letter-spacing:.09em}.ticket b{display:block;font-size:37px;letter-spacing:-.06em;line-height:1.2}.lede{display:flex;align-items:center;justify-content:space-between;padding:30px 0 50px;gap:30px}.lede p{font-size:21px;letter-spacing:-.045em;line-height:1.4;margin:0}.lede a{font:10px var(--mono);white-space:nowrap}.section-heading{display:grid;grid-template-columns:1fr 1fr;gap:12px 40px;padding-bottom:28px;border-top:2px solid var(--green);padding-top:26px}.section-heading .eyebrow{grid-column:1/-1;margin:0;color:var(--rust)}.section-heading h2,.memory-section h2,.sources-heading h2{font-size:42px;line-height:1.08;letter-spacing:-.065em;font-weight:600;margin:0}.section-heading>p:last-child{align-self:end;font-size:15px;line-height:1.7;max-width:360px;margin:0}.interactive{border:1px solid var(--green)}.scoreboard{background:var(--green);color:var(--paper);display:grid;grid-template-columns:1fr 90px 90px 130px;padding:22px 28px;gap:18px;align-items:center}.scoreboard>div:first-child span,.scoreboard>div:first-child b{display:block}.scoreboard span{font:9px/1.5 var(--mono);letter-spacing:.08em}.scoreboard>div:first-child b{font-size:16px;letter-spacing:.035em;margin-top:5px;font-weight:500}.score-stat{text-align:center;border-left:1px solid #788576}.score-stat b{font:30px/1.3 var(--mono);display:block}.out-stat{text-align:center;border-left:1px solid #788576}.out-stat>div{display:flex;justify-content:center;gap:8px;margin-top:10px}.out-stat i{width:12px;height:12px;border:1px solid #c5c8a8;border-radius:50%}.out-stat i.on{background:#ffce76;border-color:#ffce76}.inning-layout{display:grid;grid-template-columns:1.13fr 1fr}.field-panel{background:#1e3d2d;display:flex;flex-direction:column;justify-content:center;padding-bottom:24px}.diamond-field{width:100%;height:auto;display:block}.runner circle{fill:#ffce76;stroke:#1e3428;stroke-width:2}.runner text{font:9px var(--mono);fill:#172e24;text-anchor:middle}.field-labels{font:9px var(--mono);fill:#eee5c7;letter-spacing:.04em}.field-sign{font:20px var(--mono);fill:#92ae88;letter-spacing:-.05em}.lens-buttons{display:flex;justify-content:center;gap:6px;padding:0 18px}.lens-buttons button{border:1px solid #9eaf92;background:transparent;color:#f3efdf;padding:12px 14px;font:10px var(--mono)}.lens-buttons button[aria-pressed=true]{background:#f3efdf;color:#1e3428}.scorecard-panel{padding:24px;background:#e9e5d3;border-left:1px solid #a8ae99}.card-heading{display:flex;justify-content:space-between;font:8px var(--mono);letter-spacing:.045em;padding-bottom:16px}.scorecard-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #acb49e;border-left:1px solid #acb49e}.score-cell{position:relative;display:flex;flex-direction:column;align-items:center;min-height:100px;border-right:1px solid #acb49e;border-bottom:1px solid #acb49e;padding:7px 5px;color:#68725d}.batter-number{align-self:start;font:8px var(--mono)}.score-cell svg{width:49px;height:49px}.score-cell b{font:15px var(--mono);position:absolute;top:33px;color:var(--rust)}.score-cell>span:last-child{font:8px var(--mono);margin-top:3px}.score-cell.played{background:#f3efdf;color:#1e3428}.score-cell.current{box-shadow:inset 0 0 0 2px var(--rust)}.play-note{min-height:155px;padding:22px 0 16px}.play-note .eyebrow{font-size:8px;margin:0 0 9px;color:var(--rust)}.play-note h3{font-size:23px;line-height:1.15;letter-spacing:-.055em;margin:0 0 10px;font-weight:600}.play-note>p:last-child{font-size:12px;line-height:1.7;margin:0;max-width:350px}.inning-controls{display:flex;gap:15px;align-items:center}.next-batter{background:var(--rust);color:var(--paper);border:0;padding:14px 20px;min-width:170px;text-align:left;font-size:12px!important}.next-batter span{float:right;margin-left:20px}.previous-batter{background:none;border:0;color:var(--green);font:10px var(--mono)!important;padding:14px 0}.interaction-note{font:8px/1.8 var(--mono);padding:12px 18px;border-top:1px solid #acb49e;margin:0;color:#59624f}.interaction-note a{text-decoration:underline!important}.transcript{border-bottom:1px solid #b7bca8;font-size:12px;margin-top:18px;padding:0 0 18px}.transcript summary{cursor:pointer;font:11px/1.8 var(--mono)}.transcript summary span{float:right;font-size:9px}.transcript ol{padding-left:22px;line-height:1.8}.transcript li{padding:8px 0}.essay-section{display:grid;grid-template-columns:1fr 1.85fr;gap:85px;padding:75px 55px 70px}.essay-section aside{align-self:start;position:sticky;top:28px}.essay-section aside>.eyebrow{color:var(--rust);margin:0 0 17px;font-size:9px}.essay-section aside h2{font-size:37px;font-weight:500;line-height:1.08;letter-spacing:-.06em;margin:0}.distance{border-top:1px solid #b7bca8;padding-top:30px;margin-top:32px}.distance b{font:58px/1 var(--mono);letter-spacing:-.09em}.distance>span{display:block;font:8px var(--mono);margin-top:12px}.distance svg{width:90px;height:90px;margin:30px 0 5px;color:var(--rust)}.distance p{font-size:15px;line-height:1.5;letter-spacing:-.02em}.editorial-credit{font:8px/1.8 var(--mono);display:block;margin-top:32px;color:#5d6854}.essay{font-size:16px;line-height:1.85}.essay>p:first-child{font-size:24px;line-height:1.45;letter-spacing:-.045em;font-weight:500;margin-top:0}.essay p{margin:0 0 22px}.essay h2{font-size:27px;line-height:1.15;font-weight:550;letter-spacing:-.045em;margin:38px 0 20px}.essay a{text-decoration:underline!important;text-underline-offset:3px;text-decoration-color:#b59a76!important}.essay .essay-signoff{font:9px var(--mono);padding-top:25px;border-top:1px solid #b7bca8;margin-top:35px}.memory-section{background:#d9dfc5;border:1px solid #a7b099;padding:40px;display:grid;grid-template-columns:1fr 1.15fr;gap:65px}.memory-section .eyebrow{margin:0 0 20px;color:#703727}.memory-section h2{font-size:46px}.memory-section>div:first-child>p:not(.eyebrow){font-size:14px;line-height:1.7}.stitch{font-size:34px;letter-spacing:.08em;color:var(--rust);margin-top:30px}.memory-desk label{font:10px/1.6 var(--mono);display:block;margin-bottom:9px}.memory-desk textarea{width:100%;background:var(--paper);color:var(--green);border:1px solid #89957b;padding:14px;font-size:13px;line-height:1.6;resize:vertical;border-radius:0}.memory-desk textarea::placeholder{color:#66745e}.memory-count{display:flex;justify-content:space-between;gap:8px;font:7px/1.7 var(--mono);margin:6px 0 20px}.memory-desk select{background:var(--paper);color:var(--green);border:1px solid #89957b;border-radius:0;padding:12px;width:100%;font-size:12px}.invitation{font-size:15px;line-height:1.5;letter-spacing:-.03em;border-left:2px solid var(--rust);padding-left:15px;min-height:45px;margin:18px 0}.memory-buttons{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.memory-buttons button{font:9px var(--mono);min-height:42px;border:0;background:var(--green);color:var(--paper);padding:12px}.memory-buttons button:nth-child(2){color:var(--green);background:transparent;border:1px solid #89957b}.memory-buttons button:last-child{color:var(--green);background:transparent;padding:10px 0}.memory-status{font:8px/1.7 var(--mono);min-height:28px;margin:10px 0 0}.source-desk{margin-top:70px;border-top:2px solid var(--green);padding-top:25px}.sources-heading{display:grid;grid-template-columns:1.1fr 1fr;gap:15px 60px;margin-bottom:26px}.sources-heading>.eyebrow{grid-column:1/-1;margin:0;color:var(--rust)}.sources-heading h2{font-size:34px}.sources-heading>p:last-child{font-size:12px;line-height:1.8;margin:0;align-self:end}.sources-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid #b7bca8;border-left:1px solid #b7bca8}.sources-grid article{border-right:1px solid #b7bca8;border-bottom:1px solid #b7bca8;padding:24px;di