---
import BlockLayout from '../layouts/BlockLayout.astro';
import { LANE_META, NEXT_MODELS, NEXT_MODELS_SUMMARY, RESEARCH_AS_OF, type ModelLane } from '../lib/next-models';

const laneOrder: ModelLane[] = ['frontier', 'open-weights', 'moving-image'];
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const localPath = (path: string) => `${basePath}${path}`;
const publicDeskBase = basePath === '/pointcast'
  ? 'https://mhoydich.github.io/pointcast'
  : 'https://pointcast.xyz';
const laneArtwork: Partial<Record<ModelLane, { src: string; alt: string }>> = {
  'open-weights': {
    src: localPath('/images/next-models/open-weight-workshop.webp'),
    alt: 'A tactile editorial workshop of modular transparent model structures with open doors.',
  },
  'moving-image': {
    src: localPath('/images/next-models/moving-image-room.webp'),
    alt: 'An editorial film room where a paper scene becomes a flowing strip of moving images and sound.',
  },
};

const stateLabel = {
  upcoming: 'Upcoming',
  controlled: 'Controlled',
  available: 'Available',
  'open-weights': 'Open weights',
};

const packetExample = `$ curl ${publicDeskBase}/next-models.json

{
  "researchAsOf": "${RESEARCH_AS_OF}",
  "modelCount": ${NEXT_MODELS.length},
  "models": [
    {
      "id": "openai-astra",
      "releaseState": "upcoming",
      "sources": [...]
    }
  ]
}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${publicDeskBase}/next-models#desk`,
  name: NEXT_MODELS_SUMMARY.title,
  description: NEXT_MODELS_SUMMARY.description,
  url: `${publicDeskBase}/next-models`,
  dateModified: RESEARCH_AS_OF,
  isPartOf: { '@id': 'https://pointcast.xyz/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: NEXT_MODELS.length,
    itemListElement: NEXT_MODELS.map((model, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: model.name,
        applicationCategory: model.lane,
        operatingSystem: model.access,
        description: model.signal,
        author: { '@type': 'Organization', name: model.maker },
        url: `${publicDeskBase}/next-models#${model.id}`,
        sameAs: model.sources.map((source) => source.url),
      },
    })),
  },
};
---

<BlockLayout
  title="Next Models"
  description={NEXT_MODELS_SUMMARY.description}
  image={localPath('/images/next-models/next-models-og.png')}
  imageWidth={1200}
  imageHeight={630}
  themeColor="#0a1823"
  immersive={true}
  showNetworkStrip={false}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: localPath('/next-models.json'), title: 'Next Models research packet' }]}
  frame={{
    image: `${publicDeskBase}/images/next-models/next-models-og.png`,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Open the model desk', action: 'link', target: `${publicDeskBase}/next-models` },
      { label: 'Read JSON', action: 'link', target: `${publicDeskBase}/next-models.json` },
    ],
  }}
>
  <div class="nm" data-lens="human">
    <header class="nm-topbar">
      <a class="nm-brand" href="https://pointcast.xyz/">POINTCAST</a>
      <nav aria-label="Next Models navigation">
        <a href="#desk">Desk</a>
        <a href="#open-weights">Open weights</a>
        <a href="#moving-image">Video</a>
        <a href={localPath('/next-models.json')}>JSON ↗</a>
      </nav>
      <span class="nm-datestamp">AS OF {RESEARCH_AS_OF}</span>
    </header>

    <section class="nm-hero" aria-labelledby="next-models-title">
      <img
        src={localPath('/images/next-models/model-horizon.webp')}
        alt="A person and a small machine observe stacked luminous model layers beneath a moonlike model constellation."
        width="1680"
        height="945"
        fetchpriority="high"
      />
      <div class="nm-hero-wash" aria-hidden="true"></div>
      <div class="nm-hero-copy">
        <p class="nm-kicker"><span></span> PointCast research desk · 001</p>
        <h1 id="next-models-title">The next<br /><em>models.</em></h1>
        <p class="nm-dek">A field guide to the systems arriving now: from Astra and Mythos to China’s open-weight wave and video models that are becoming full editing rooms.</p>
        <div class="nm-hero-actions">
          <a class="nm-button nm-button--light" href="#desk">Read the field guide ↓</a>
          <a class="nm-button nm-button--glass" href={localPath('/next-models.json')}>Agent packet ↗</a>
        </div>
      </div>
      <div class="nm-hero-ledger" aria-label="Desk summary">
        <div><strong>{NEXT_MODELS.length}</strong><span>models tracked</span></div>
        <div><strong>3</strong><span>signal lanes</span></div>
        <div><strong>0</strong><span>rumors passed as fact</span></div>
      </div>
    </section>

    <main id="desk" class="nm-main">
      <section class="nm-opening" aria-labelledby="reading-the-weather">
        <div class="nm-section-tag">01 / Reading the weather</div>
        <div class="nm-opening-copy">
          <h2 id="reading-the-weather">Capability is only half the story now.</h2>
          <p>The useful map has three axes: <em>what the model can do, who can actually use it, and what can be owned or inspected.</em> This desk keeps vendor facts, PointCast interpretation and unknowns visibly separate.</p>
        </div>
        <div class="nm-theses">
          {NEXT_MODELS_SUMMARY.thesis.map((thesis, index) => (
            <article>
              <span>0{index + 1}</span>
              <p>{thesis}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="nm-controls" aria-label="Filter and reading controls">
        <div class="nm-filter-row" role="group" aria-label="Filter model lanes">
          <button type="button" class="is-active" data-filter="all" aria-pressed="true">All <span>{NEXT_MODELS.length}</span></button>
          {laneOrder.map((lane) => (
            <button type="button" data-filter={lane} aria-pressed="false">
              {LANE_META[lane].short} <span>{NEXT_MODELS.filter((model) => model.lane === lane).length}</span>
            </button>
          ))}
        </div>
        <label class="nm-search">
          <span class="sr-only">Search the model desk</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input type="search" placeholder="Search models, labs, access…" data-model-search />
        </label>
        <div class="nm-lens" role="group" aria-label="Choose reading lens">
          <span>Reading lens</span>
          <button type="button" class="is-active" data-lens-choice="human" aria-pressed="true">Human</button>
          <button type="button" data-lens-choice="agent" aria-pressed="false">Agent</button>
        </div>
      </section>

      <p class="nm-no-results" data-no-results hidden>No signals match that filter. Clear the search and try again.</p>

      {laneOrder.map((lane, laneIndex) => {
        const models = NEXT_MODELS.filter((model) => model.lane === lane);
        const artwork = laneArtwork[lane];
        return (
          <section class:list={['nm-lane', `nm-lane--${lane}`]} id={lane} data-lane={lane}>
            {artwork && (
              <figure class="nm-lane-art">
                <img src={artwork.src} alt={artwork.alt} width="1440" height="960" loading="lazy" />
                <figcaption>Original PointCast study · generated for this desk · 2026</figcaption>
              </figure>
            )}
            <header class="nm-lane-head">
              <div class="nm-section-tag">0{laneIndex + 2} / {LANE_META[lane].label}</div>
              <h2>{LANE_META[lane].label}</h2>
              <p>{LANE_META[lane].thesis}</p>
            </header>

            <div class="nm-model-grid">
              {models.map((model, modelIndex) => (
                <article
                  class="nm-model"
                  id={model.id}
                  data-model-card
                  data-lane={model.lane}
                  data-search={`${model.name} ${model.maker} ${model.license} ${model.access} ${model.modalities.join(' ')}`.toLowerCase()}
                >
                  <div class="nm-model-topline">
                    <span class="nm-model-number">{String(modelIndex + 1).padStart(2, '0')}</span>
                    <span class:list={['nm-state', `nm-state--${model.releaseState}`]}>{stateLabel[model.releaseState]}</span>
                  </div>
                  <div class="nm-model-title">
                    <p>{model.maker}</p>
                    <h3>{model.name}</h3>
                  </div>
                  <p class="nm-signal">{model.signal}</p>

                  <dl class="nm-specs">
                    <div><dt>Release</dt><dd>{model.released}</dd></div>
                    <div><dt>Access</dt><dd>{model.access}</dd></div>
                    <div><dt>License</dt><dd>{model.license}</dd></div>
                    {model.context && <div><dt>Context</dt><dd>{model.context}</dd></div>}
                  </dl>

                  <div class="nm-reading human-copy">
                    <span>Why it matters</span>
                    <p>{model.humanRead}</p>
                  </div>
                  <div class="nm-reading agent-copy">
                    <span>Implementation read</span>
                    <p>{model.agentRead}</p>
                  </div>

                  <details class="nm-details">
                    <summary>Facts + sources <span>+</span></summary>
                    <ul class="nm-facts">
                      {model.facts.map((fact) => <li>{fact}</li>)}
                    </ul>
                    <div class="nm-modalities" aria-label="Modalities">
                      {model.modalities.map((modality) => <span>{modality}</span>)}
                    </div>
                    <p class="nm-watch"><strong>Watch next:</strong> {model.watchFor}</p>
                    <ol class="nm-sources">
                      {model.sources.map((source) => (
                        <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>{source.published && <time datetime={source.published}>{source.published}</time>}</li>
                      ))}
                    </ol>
                  </details>
                </article>
              ))}
            </div>
          </section>
        );
      })}

      <section class="nm-agent-packet" aria-labelledby="agent-packet-title">
        <div>
          <p class="nm-section-tag">05 / Machine entrance</p>
          <h2 id="agent-packet-title">Same desk.<br />Clean packet.</h2>
          <p>The companion endpoint mirrors every card with stable IDs, access state, license language, source URLs and a short agent read. CORS is open. Cache is one hour.</p>
          <div class="nm-packet-links">
            <a class="nm-button nm-button--dark" href={localPath('/next-models.json')}>Open /next-models.json ↗</a>
            <button type="button" class="nm-button nm-button--outline" data-copy-endpoint>Copy endpoint</button>
          </div>
        </div>
        <div class="nm-code" aria-label="Example request and response shape">
          <div class="nm-code-top"><span></span><span></span><span></span><b>GET · JSON</b></div>
          <pre><code>{packetExample}</code></pre>
        </div>
      </section>

      <section class="nm-method" aria-labelledby="method-title">
        <div class="nm-section-tag">06 / Desk method</div>
        <h2 id="method-title">Fast field, slow claims.</h2>
        <div class="nm-method-grid">
          <p><strong>Primary sources first.</strong> Vendor announcements, technical reports, model cards and weight repositories anchor the factual layer. Vendor benchmark claims stay vendor claims.</p>
          <p><strong>Open ≠ one thing.</strong> The desk says “open weights” unless code, weights, training recipe and data justify a stronger claim. License names remain visible on every card.</p>
          <p><strong>No rumor laundering.</strong> Astra is not labeled GPT-6 here. Unpublished specs, leaked parameter counts and speculative dates do not enter the record.</p>
        </div>
        <p class="nm-method-note">Researched {RESEARCH_AS_OF}. Model access, pricing and product availability can change faster than this page. Follow the linked primary source before making a production decision.</p>
      </section>
    </main>

    <footer class="nm-footer">
      <a class="nm-brand" href="https://pointcast.xyz/">POINTCAST</a>
      <p>Model weather from El Segundo.<br />For people and agents.</p>
      <nav aria-label="Related PointCast pages">
        <a href="https://pointcast.xyz/ai-stack">Current AI stack</a>
        <a href="https://pointcast.xyz/for-agents">For agents</a>
        <a href={localPath('/next-models.json')}>JSON packet</a>
      </nav>
      <a class="nm-back" href="#next-models-title">Back to signal ↑</a>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('.nm');
      if (!(root instanceof HTMLElement)) return;

      const cards = [...root.querySelectorAll('[data-model-card]')];
      const lanes = [...root.querySelectorAll('[data-lane].nm-lane')];
      const filterButtons = [...root.querySelectorAll('[data-filter]')];
      const lensButtons = [...root.querySelectorAll('[data-lens-choice]')];
      const search = root.querySelector('[data-model-search]');
      const noResults = root.querySelector('[data-no-results]');
      let activeFilter = 'all';

      const applyFilters = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        let visibleCount = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const laneMatch = activeFilter === 'all' || card.dataset.lane === activeFilter;
          const searchMatch = !query || (card.dataset.search || '').includes(query);
          const visible = laneMatch && searchMatch;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        lanes.forEach((lane) => {
          if (!(lane instanceof HTMLElement)) return;
          lane.hidden = !lane.querySelector('[data-model-card]:not([hidden])');
        });

        if (noResults instanceof HTMLElement) noResults.hidden = visibleCount !== 0;
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          activeFilter = button.dataset.filter || 'all';
          filterButtons.forEach((candidate) => {
            const selected = candidate === button;
            candidate.classList.toggle('is-active', selected);
            candidate.setAttribute('aria-pressed', String(selected));
          });
          applyFilters();
        });
      });

      if (search instanceof HTMLInputElement) search.addEventListener('input', applyFilters);

      const setLens = (lens) => {
        root.dataset.lens = lens;
        lensButtons.forEach((button) => {
          const selected = button instanceof HTMLElement && button.dataset.lensChoice === lens;
          button.classList.toggle('is-active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        try { localStorage.setItem('pc:next-models-lens', lens); } catch (error) {}
      };

      lensButtons.forEach((button) => button.addEventListener('click', () => {
        if (button instanceof HTMLElement) setLens(button.dataset.lensChoice || 'human');
      }));

      try {
        const savedLens = localStorage.getItem('pc:next-models-lens');
        if (savedLens === 'agent') setLens('agent');
      } catch (error) {}

      const copyButton = root.querySelector('[data-copy-endpoint]');
      copyButton?.addEventListener('click', async () => {
        if (!(copyButton instanceof HTMLButtonElement)) return;
        try {
          await navigator.clipboard.writeText('https://pointcast.xyz/next-models.json');
          copyButton.textContent = 'Endpoint copied ✓';
          window.setTimeout(() => { copyButton.textContent = 'Copy endpoint'; }, 1800);
        } catch (error) {
          copyButton.textContent = 'Copy failed';
        }
      });
    })();
  </script>
</BlockLayout>

<style>
  :global(body) {
    background: #f2eadb;
  }

  .nm {
    --nm-paper: #f2eadb;
    --nm-paper-deep: #ded0b8;
    --nm-ink: #111b22;
    --nm-muted: #5f625f;
    --nm-navy: #0a1823;
    --nm-blue: #135f89;
    --nm-cyan: #42bed0;
    --nm-red: #e34e31;
    --nm-yellow: #f1bd35;
    --nm-green: #16745d;
    background: var(--nm-paper);
    color: var(--nm-ink);
    min-height: 100vh;
    font-family: var(--pc-font-sans);
  }

  .nm-topbar {
    align-items: center;
    background: rgba(10, 24, 35, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    color: white;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    height: 58px;
    padding: 0 3vw;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 4;
  }

  .nm-brand {
    color: inherit;
    font-family: var(--pc-font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  .nm-brand:hover { text-decoration: none; }

  .nm-topbar nav,
  .nm-footer nav {
    display: flex;
    gap: 24px;
  }

  .nm-topbar nav a {
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nm-datestamp {
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    justify-self: end;
    letter-spacing: 0.08em;
  }

  .nm-hero {
    background: var(--nm-navy);
    color: white;
    height: min(900px, 92vh);
    min-height: 680px;
    overflow: hidden;
    position: relative;
  }

  .nm-hero > img {
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }

  .nm-hero-wash {
    background: linear-gradient(90deg, rgba(7, 15, 21, 0.88) 0%, rgba(7, 15, 21, 0.57) 31%, rgba(7, 15, 21, 0.05) 57%), linear-gradient(0deg, rgba(7, 15, 21, 0.52), transparent 36%);
    inset: 0;
    position: absolute;
  }

  .nm-hero-copy {
    left: clamp(24px, 6vw, 96px);
    max-width: 650px;
    position: absolute;
    top: 50%;
    transform: translateY(-48%);
  }

  .nm-kicker,
  .nm-section-tag {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .nm-kicker {
    align-items: center;
    color: rgba(255, 255, 255, 0.76);
    display: flex;
    gap: 10px;
    margin: 0 0 28px;
  }

  .nm-kicker span {
    background: var(--nm-red);
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(227, 78, 49, 0.18);
    height: 7px;
    width: 7px;
  }

  .nm-hero h1 {
    font-size: clamp(72px, 10vw, 156px);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.78;
    margin: 0;
  }

  .nm-hero h1 em {
    color: var(--nm-yellow);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
  }

  .nm-dek {
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(16px, 1.35vw, 21px);
    line-height: 1.48;
    margin: 34px 0 30px;
    max-width: 610px;
  }

  .nm-hero-actions,
  .nm-packet-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .nm-button {
    align-items: center;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    justify-content: center;
    letter-spacing: 0.08em;
    min-height: 44px;
    padding: 0 18px;
    text-transform: uppercase;
  }

  .nm-button:hover { text-decoration: none; transform: translateY(-1px); }
  .nm-button--light { background: white; color: var(--nm-ink); }
  .nm-button--glass { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.45); color: white; }
  .nm-button--dark { background: var(--nm-navy); color: white; }
  .nm-button--outline { background: transparent; border-color: #9e8f78; color: var(--nm-ink); }

  .nm-hero-ledger {
    bottom: 26px;
    display: flex;
    gap: 36px;
    position: absolute;
    right: clamp(24px, 4vw, 72px);
  }

  .nm-hero-ledger div { border-left: 1px solid rgba(255, 255, 255, 0.34); padding-left: 12px; }
  .nm-hero-ledger strong { display: block; font-family: var(--pc-font-mono); font-size: 18px; }
  .nm-hero-ledger span { color: rgba(255, 255, 255, 0.58); font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }

  .nm-main { overflow: clip; }

  .nm-opening,
  .nm-lane,
  .nm-agent-packet,
  .nm-method {
    margin: 0 auto;
    max-width: 1500px;
    padding-left: clamp(20px, 5vw, 80px);
    padding-right: clamp(20px, 5vw, 80px);
  }

  .nm-opening {
    display: grid;
    gap: 30px;
    grid-template-columns: 0.45fr 1.4fr 1fr;
    padding-bottom: 92px;
    padding-top: 92px;
  }

  .nm-section-tag { color: #776f63; padding-top: 8px; }

  .nm-opening-copy h2,
  .nm-lane-head h2,
  .nm-agent-packet h2,
  .nm-method h2 {
    font-size: clamp(42px, 5vw, 76px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
  }

  .nm-opening-copy > p {
    color: #3e423f;
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.55;
    margin: 28px 0 0;
    max-width: 770px;
  }

  .nm-opening-copy em { font-family: Georgia, 'Times New Roman', serif; }

  .nm-theses { border-top: 1px solid #9e927d; }
  .nm-theses article { display: grid; gap: 16px; grid-template-columns: 28px 1fr; padding: 18px 0; border-bottom: 1px solid #b5a890; }
  .nm-theses span { color: var(--nm-red); font-family: var(--pc-font-mono); font-size: 10px; }
  .nm-theses p { font-size: 14px; line-height: 1.4; margin: 0; }

  .nm-controls {
    align-items: center;
    backdrop-filter: blur(16px);
    background: rgba(242, 234, 219, 0.92);
    border-bottom: 1px solid #b8aa93;
    border-top: 1px solid #b8aa93;
    display: grid;
    gap: 20px;
    grid-template-columns: 1.2fr 0.8fr auto;
    margin: 0 auto;
    max-width: 1500px;
    padding: 12px clamp(20px, 5vw, 80px);
    position: sticky;
    top: 0;
    z-index: 3;
  }

  .nm-filter-row { display: flex; gap: 5px; }
  .nm-filter-row button,
  .nm-lens button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #5d5e58;
    cursor: pointer;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    padding: 8px 11px;
    text-transform: uppercase;
  }

  .nm-filter-row button span { opacity: 0.55; }
  .nm-filter-row button.is-active,
  .nm-lens button.is-active { background: var(--nm-navy); color: white; }

  .nm-search {
    align-items: center;
    border-bottom: 1px solid #8f8573;
    display: flex;
    gap: 8px;
  }

  .nm-search svg { fill: none; height: 16px; stroke: currentColor; stroke-width: 1.5; width: 16px; }
  .nm-search input { background: transparent; border: 0; color: inherit; font: 12px var(--pc-font-mono); min-width: 0; outline: 0; padding: 9px 0; width: 100%; }
  .nm-search input::placeholder { color: #77766e; }
  .nm-lens { align-items: center; display: flex; gap: 4px; }
