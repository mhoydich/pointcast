---
/**
 * /drum-beat-battle — two Nouns trade 4-bar beats. Audience votes.
 * Recovered ship.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Noun Beat Battle · two Nouns trade 4 bars · PointCast';
const description = 'Two Nouns face off. Each plays a 4-bar phrase. You vote. Best of 5.';
---
<BlockLayout title={title} description={description}>
  <main class="bb">
    <header class="bb__header">
      <h1 class="bb__title">NOUN BEAT BATTLE</h1>
      <p class="bb__tag">two nouns trade four bars · audience picks the winner · best of 5</p>
    </header>
    <section class="bb__scoreboard">
      <span class="bb__round">ROUND <strong id="bb-round">1</strong> / 5</span>
      <span class="bb__phase" id="bb-phase">— NEW MATCH —</span>
      <span class="bb__crowd"><strong id="bb-score-a">0</strong> · <strong id="bb-score-b">0</strong></span>
    </section>
    <section class="bb__stage">
      <article class="bb__corner bb__corner--a" id="bb-corner-a">
        <div class="bb__corner-name">CORNER A</div>
        <img class="bb__noun" id="bb-noun-a" src="https://noun.pics/523.svg" alt="Noun A" width="160" height="160" />
        <span class="bb__role">noun #523</span>
        <div class="bb__beat-vis" id="bb-vis-a"></div>
      </article>
      <div class="bb__vs" aria-hidden="true">VS</div>
      <article class="bb__corner bb__corner--b" id="bb-corner-b">
        <div class="bb__corner-name">CORNER B</div>
        <img class="bb__noun" id="bb-noun-b" src="https://noun.pics/1042.svg" alt="Noun B" width="160" height="160" />
        <span class="bb__role">noun #1042</span>
        <div class="bb__beat-vis" id="bb-vis-b"></div>
      </article>
    </section>
    <section class="bb__controls">
      <button class="bb__btn bb__btn--big" id="bb-play" type="button">▶ PLAY ROUND 1</button>
      <div class="bb__vote" id="bb-vote" hidden>
        <span class="bb__vote-label">YOUR CALL</span>
        <button class="bb__vote-btn bb__vote-btn--a" id="bb-vote-a" type="button">CORNER A</button>
        <button class="bb__vote-btn bb__vote-btn--b" id="bb-vote-b" type="button">CORNER B</button>
      </div>
      <button class="bb__btn" id="bb-reset" type="button">↺ NEW MATCH</button>
    </section>
    <section class="bb__siblings">
      <a href="/drum-noun-radio">/drum-noun-radio</a>
      <a href="/drum-jukebox">/drum-jukebox</a>
      <a href="/drum-looper">/drum-looper</a>
      <a href="/drum-audiophile">/drum-audiophile</a>
    </section>
  </main>
</BlockLayout>
<style>
  .bb { max-width: 1100px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #fffaf0; background: linear-gradient(180deg, #050310 0%, #1a0820 60%, #050310 100%); min-height: 100vh; }
  .bb__header { text-align: center; margin: 18px 0 18px; }
  .bb__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(30px, 6.5vw, 64px); letter-spacing: 0.16em; margin: 0; color: #f6c15e; text-shadow: 0 0 16px rgba(246, 193, 94, 0.5); }
  .bb__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: #d4a437; opacity: 0.85; margin: 6px 0 0; }
  .bb__scoreboard { display: flex; justify-content: space-between; align-items: center; padding: 10px 18px; border: 2px solid #d4a437; background: rgba(0, 0, 0, 0.4); margin: 14px 0; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .bb__round strong { color: #f6c15e; font-size: 20px; }
  .bb__crowd strong:first-of-type { color: #ff5f7a; font-size: 22px; padding-right: 6px; }
  .bb__crowd strong:last-of-type { color: #5fbafd; font-size: 22px; padding-left: 6px; }
  .bb__phase { color: #d4a437; }
  .bb__stage { display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: center; padding: 24px 16px; border: 2.5px solid #d4a437; background: linear-gradient(180deg, rgba(26, 8, 32, 0.92), rgba(8, 2, 12, 0.96)); box-shadow: 6px 6px 0 0 #1a0820; }
  .bb__corner { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 16px; border: 2px solid transparent; transition: border-color 200ms, box-shadow 200ms; position: relative; }
  .bb__corner--a { border-color: rgba(255, 95, 122, 0.40); }
  .bb__corner--b { border-color: rgba(95, 186, 253, 0.40); }
  .bb__corner--a.bb__corner--active { border-color: #ff5f7a; box-shadow: 0 0 0 3px #ff5f7a, inset 0 0 22px rgba(255, 95, 122, 0.20); }
  .bb__corner--b.bb__corner--active { border-color: #5fbafd; box-shadow: 0 0 0 3px #5fbafd, inset 0 0 22px rgba(95, 186, 253, 0.20); }
  .bb__corner-name { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.30em; color: #d4a437; }
  .bb__noun { width: 160px; height: 160px; image-rendering: pixelated; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.5)); transition: transform 80ms; }
  .bb__corner.bb__corner--hit .bb__noun { transform: translateY(-6px) scale(1.04); }
  .bb__role { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.18em; color: #cfc6df; opacity: 0.75; }
  .bb__beat-vis { display: flex; gap: 3px; height: 18px; align-items: end; min-height: 18px; }
  .bb__beat-vis span { width: 5px; background: #d4a437; transition: height 60ms; height: 4px; }
  .bb__corner--a .bb__beat-vis span.bb__beat-vis--lit { background: #ff5f7a; }
  .bb__corner--b .bb__beat-vis span.bb__beat-vis--lit { background: #5fbafd; }
  .bb__vs { font-family: 'JetBrains Mono Variable', monospace; font-size: 28px; letter-spacing: 0.24em; color: #f6c15e; padding: 0 12px; text-shadow: 0 0 12px rgba(246, 193, 94, 0.5); }
  .bb__controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; margin: 22px 0; }
  .bb__btn { padding: 10px 18px; border: 2px solid #d4a437; background: linear-gradient(180deg, #1a0820, #050310); color: #f6c15e; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; transition: transform 100ms, border-color 200ms; }
  .bb__btn:hover { transform: translateY(-1px); border-color: #f6c15e; }
  .bb__btn--big { padding: 12px 26px; font-size: 14px; }
  .bb__vote { display: flex; gap: 10px; align-items: center; }
  .bb__vote-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.24em; color: #d4a437; }
  .bb__vote-btn { padding: 12px 18px; border: 2px solid currentColor; background: transparent; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; transition: transform 100ms, background 200ms; }
  .bb__vote-btn--a { color: #ff5f7a; }
  .bb__vote-btn--a:hover { background: rgba(255, 95, 122, 0.16); }
  .bb__vote-btn--b { color: #5fbafd; }
  .bb__vote-btn--b:hover { background: rgba(95, 186, 253, 0.16); }
  .bb__siblings { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .bb__siblings a { color: #d4a437; text-decoration: none; }
  @media (max-width: 720px) { .bb__stage { grid-template-columns: 1fr; gap: 8px; } .bb__noun { width: 110px; height: 110px; } }
</style>
<script>
  const NOUN_POOL = [313, 523, 742, 1042, 1189, 287, 612, 1084, 928];
  const LANES = ['kick','snare','bell','lead','pad'] as const;
  let actx: AudioContext | null = null;
  function ctx() { if (!actx) { const AC = (window as any).AudioContext || (window as any).webkitAudioContext; actx = new AC(); } if (actx && actx.state === 'suspended') actx.resume(); return actx!; }
  function pK(t:number){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(120,t);o.frequency.exponentialRampToValueAtTime(40,t+0.18);g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.25);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.3);}
  function pSn(t:number){const a=ctx(),buf=a.createBuffer(1,a.sampleRate*0.12,a.sampleRate),d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;const n=a.createBufferSource();n.buffer=buf;const bp=a.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1800;bp.Q.value=1.2;const g=a.createGain();g.gain.setValueAtTime(0.32,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.18);n.connect(bp).connect(g).connect(a.destination);n.start(t);n.stop(t+0.2);}
  function pB(t:number){const a=ctx();[1320,2640,3960].forEach((f,i)=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime([0.13,0.07,0.04][i],t);g.gain.exponentialRampToValueAtTime(0.0001,t+1.0);o.connect(g).connect(a.destination);o.start(t);o.stop(t+1.1);});}
  function pL(t:number){const a=ctx();const D=[0,4,7,12,14],deg=D[Math.floor(Math.random()*D.length)],f=264*Math.pow(2,deg/12);const o=a.createOscillator(),g=a.createGain(),lp=a.createBiquadFilter();o.type='sawtooth';o.frequency.setValueAtTime(f,t);lp.type='lowpass';lp.frequency.setValueAtTime(2200,t);lp.frequency.exponentialRampToValueAtTime(800,t+0.4);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.13,t+0.005);g.gain.exponentialRampToValueAtTime(0.0001,t+0.4);o.connect(lp).connect(g).connect(a.destination);o.start(t);o.stop(t+0.45);}
  function pP(t:number){const a=ctx();[132,198].forEach(f=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.09,t+0.18);g.gain.linearRampToValueAtTime(0.09,t+0.4);g.gain.exponentialRampToValueAtTime(0.0001,t+0.65);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.7);});}
  const PLAY: any = { kick: pK, snare: pSn, bell: pB, lead: pL, pad: pP };
  function generatePhrase() {
    const p: Record<string, number[]> = {} as any;
    p.kick  = Array.from({length: 16}, (_, i) => (i % 4 === 0 ? 1 : (Math.random() < 0.20 ? 1 : 0)));
    p.snare = Array.from({length: 16}, (_, i) => (i % 8 === 4 ? (Math.random() < 0.85 ? 1 : 0) : (Math.random() < 0.10 ? 1 : 0)));
    p.bell  = Array.from({length: 16}, () => Math.random() < 0.16 ? 1 : 0);
    p.lead  = Array.from({length: 16}, () => Math.random() < 0.22 ? 1 : 0);
    p.pad   = Array.from({length: 16}, (_, i) => (i % 8 === 0 ? 1 : 0));
    return p;
  }
  const cornerA = document.getElementById('bb-corner-a'); const cornerB = document.getElementById('bb-corner-b');
  const nounA = document.getElementById('bb-noun-a') as HTMLImageElement; const nounB = document.getElementById('bb-noun-b') as HTMLImageElement;
  const visA = document.getElementById('bb-vis-a'); const visB = document.getElementById('bb-vis-b');
  const playBtn = document.getElementById('bb-play') as HTMLButtonElement;
  const voteRow = document.getElementById('bb-vote');
  const voteA = document.getElementById('bb-vote-a') as HTMLButtonElement; const voteB = document.getElementById('bb-vote-b') as HTMLButtonElement;
  const resetBtn = document.getElementById('bb-reset');
  const roundEl = document.getElementById('bb-round'); const phaseEl = document.getElementById('bb-phase');
  const scoreAEl = document.getElementById('bb-score-a'); const scoreBEl = document.getElementById('bb-score-b');
  function ensureBars() { if (!visA || !visB) return; if (visA.children.length === 0) { for (let i = 0; i < 16; i++) { visA.appendChild(document.createElement('span')); visB.appendChild(document.createElement('span')); } } }
  ensureBars();
  function fillBars(vis: HTMLElement, pat: any, step: number) { const bars = Array.from(vis.children) as HTMLElement[]; bars.forEach((b, i) => { const fired = ['kick','snare','bell','lead','pad'].some(inst => pat[inst][i]); const isCurrent = i === step; b.style.height = `${4 + (fired ? 14 : 0) + (isCurrent ? 4 : 0)}px`; b.classList.toggle('bb__beat-vis--lit', isCurrent && fired); }); }
  let round = 1, scoreA = 0, scoreB = 0;
  let phase: 'idle' | 'a-playing' | 'b-playing' | 'voting' | 'done' = 'idle';
  let phraseA: any = generatePhrase(); let phraseB: any = generatePhrase();
  const BPM = 96; const STEP_MS = (60 / BPM / 4) * 1000;
  function setPhase(p: typeof phase) {
    phase = p;
    if (phaseEl) phaseEl.textContent = (p === 'idle' ? '— READY —' : p === 'a-playing' ? 'CORNER A SPITS' : p === 'b-playing' ? 'CORNER B SPITS' : p === 'voting' ? '— YOUR CALL —' : '— MATCH OVER —');
    if (cornerA) cornerA.classList.toggle('bb__corner--active', p === 'a-playing');
    if (cornerB) cornerB.classList.toggle('bb__corner--active', p === 'b-playing');
    if (voteRow) voteRow.hidden = p !== 'voting';
  }
  function playPhrase(corner: 'A' | 'B'): Promise<void> {
    return new Promise<void>((resolve) => {
      const pat = corner === 'A' ? phraseA : phraseB;
      const cornerEl = corner === 'A' ? cornerA : cornerB;
      const visEl = corner === 'A' ? visA : visB;
      let step = 0;
      const tick = () => {
        const at = ctx().currentTime + 0.02;
        let fired = false;
        LANES.forEach(inst => { if (pat[inst][step]) { try { PLAY[inst](at); } catch {} fired = true; } });
        if (fired && cornerEl) { cornerEl.classList.add('bb__corner--hit'); setTimeout(() => cornerEl.classList.remove('bb__corner--hit'), 80); }
        if (visEl) fillBars(visEl, pat, step);
        step++;
        if (step >= 16) { clearInterval(t); if (visEl) fillBars(visEl, pat, -1); resolve(); }
      };
      const t = window.setInterval(tick, STEP_MS); tick();
    });
  }
  async function playRound() {
    if (phase === 'a-playing' || phase === 'b-playing') return;
    if (round > 5) return;
    setPhase('a-playing'); playBtn.disabled = true;
    await playPhrase('A');
    setPhase('b-playing'); await playPhrase('B');
    setPhase('voting'); playBtn.disabled = false;
  }
  function vote(c: 'A' | 'B') {
    if (phase !== 'voting') return;
    if (c === 'A') scoreA++; else scoreB++;
    if (scoreAEl) scoreAEl.textContent = String(scoreA); if (scoreBEl) scoreBEl.textContent = String(scoreB);
    round++;
    if (round > 5) {
      setPhase('done');
      const winner = scoreA > scoreB ? 'CORNER A' : (scoreB > scoreA ? 'CORNER B' : 'TIE');
      if (phaseEl) phaseEl.textContent = `🏆 ${winner} TAKES THE MATCH`;
      playBtn.textContent = '— NEW MATCH —'; playBtn.disabled = true; return;
    }
    if (roundEl) roundEl.textContent = String(round);
    phraseA = generatePhrase(); phraseB = generatePhrase();
    setPhase('idle'); playBtn.textContent = `▶ PLAY ROUND ${round}`;
  }
  function newMatch() {
    round = 1; scoreA = 0; scoreB = 0;
    phraseA = generatePhrase(); phraseB = generatePhrase();
    if (roundEl) roundEl.textContent = '1';
    if (scoreAEl) scoreAEl.textContent = '0'; if (scoreBEl) scoreBEl.textContent = '0';
    let a = NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)];
    let b = NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)];
    while (b === a) b = NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)];
    if (nounA) nounA.src = `https://noun.pics/${a}.svg`; if (nounB) nounB.src = `https://noun.pics/${b}.svg`;
    if (cornerA) (cornerA.querySelector('.bb__role') as HTMLElement).textContent = `noun #${a}`;
    if (cornerB) (cornerB.querySelector('.bb__role') as HTMLElement).textContent = `noun #${b}`;
    setPhase('idle'); playBtn.textContent = '▶ PLAY ROUND 1'; playBtn.disabled = false;
  }
  if (playBtn) playBtn.addEventListener('click', () => { if (phase === 'done') newMatch(); else playRound(); });
  if (voteA) voteA.addEventListener('click', () => vote('A'));
  if (voteB) voteB.addEventListener('click', () => vote('B'));
  if (resetBtn) resetBtn.addEventListener('click', newMatch);
</script>
