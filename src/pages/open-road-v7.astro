---
import BlockLayout from '../layouts/BlockLayout.astro';
import dawnThreshold from '../assets/shrines/open-road-v7/01-dawn-threshold.webp';
import dawnFace from '../assets/shrines/open-road-v7/02-dawn-face.webp';
import dawnLeaves from '../assets/shrines/open-road-v7/03-dawn-leaves.webp';
import dawnBlueEyes from '../assets/shrines/open-road-v7/04-dawn-blue-eyes.webp';
import dayStanding from '../assets/shrines/open-road-v7/05-day-standing.webp';
import dayGarden from '../assets/shrines/open-road-v7/06-day-garden.webp';
import dayBerries from '../assets/shrines/open-road-v7/07-day-berries.webp';
import dayFlowers from '../assets/shrines/open-road-v7/08-day-flowers.webp';
import duskLandscape from '../assets/shrines/open-road-v7/09-dusk-landscape.webp';
import duskVessels from '../assets/shrines/open-road-v7/10-dusk-vessels.webp';
import duskRest from '../assets/shrines/open-road-v7/11-dusk-rest.webp';
import duskThicket from '../assets/shrines/open-road-v7/12-dusk-thicket.webp';
import nightHalfShadow from '../assets/shrines/open-road-v7/13-night-half-shadow.webp';
import nightTurningIn from '../assets/shrines/open-road-v7/14-night-turning-in.webp';
import nightWatch from '../assets/shrines/open-road-v7/15-night-watch.webp';
import nightPresence from '../assets/shrines/open-road-v7/16-night-presence.webp';
import socialCard from '../assets/shrines/open-road-v7/open-road-v7-og.jpg';

const title = 'Open Road VII · The Hour That Finds You';
const description =
  'A private book of hours: sixteen quiet witnesses, four local-time watches, a one-minute passage, and one light to carry onward.';
const WATCH_DURATION = 60_000;
const IMAGE_DURATION = 15_000;

const watches = [
  {
    key: 'dawn',
    numeral: 'I',
    name: 'First Light',
    hours: '05—10',
    invitation: 'Let the day arrive before you name it.',
    blessing: 'May the beginning be gentle.',
    images: [
      {
        image: dawnThreshold,
        name: 'Threshold',
        line: 'The day asks only that you notice.',
        alt: 'A small white cat sits on a coral floor beneath a large blue stippled field.',
      },
      {
        image: dawnFace,
        name: 'First face',
        line: 'Meet what is here without hurry.',
        alt: 'A pale cat faces forward against a muted blue field.',
      },
      {
        image: dawnLeaves,
        name: 'Opening',
        line: 'Make room for one clear breath.',
        alt: 'A pale cat fills the frame between dark blue leaves.',
      },
      {
        image: dawnBlueEyes,
        name: 'Attention',
        line: 'Begin with the light you have.',
        alt: 'A fluffy white cat with blue eyes sits beside a dark blue floral pattern.',
      },
    ],
  },
  {
    key: 'day',
    numeral: 'II',
    name: 'Wide Day',
    hours: '10—17',
    invitation: 'Stand quietly inside the living hour.',
    blessing: 'May your attention be generous.',
    images: [
      {
        image: dayStanding,
        name: 'Standing',
        line: 'Be where your feet have brought you.',
        alt: 'A pale cat stands against a dense blue floral field.',
      },
      {
        image: dayGarden,
        name: 'Garden',
        line: 'Let abundance remain uncounted.',
        alt: 'A pale cat faces forward among layered blue and cream leaves.',
      },
      {
        image: dayBerries,
        name: 'Turning',
        line: 'A small change of view is still a prayer.',
        alt: 'A pale cat turns to the right beside thin blue stems and red berries.',
      },
      {
        image: dayFlowers,
        name: 'Fullness',
        line: 'Receive the bright and ordinary world.',
        alt: 'A white cat with blue eyes faces forward among large blue and coral flowers.',
      },
    ],
  },
  {
    key: 'dusk',
    numeral: 'III',
    name: 'Long Light',
    hours: '17—21',
    invitation: 'Let the unfinished day loosen its hold.',
    blessing: 'May enough be enough.',
    images: [
      {
        image: duskLandscape,
        name: 'Homeward',
        line: 'What mattered may travel with you.',
        alt: 'A white cat stands in a dark blue landscape with coral grasses.',
      },
      {
        image: duskVessels,
        name: 'Vessels',
        line: 'Set down what does not need carrying.',
        alt: 'A black-and-white cat sits between patterned vases and stylized plants.',
      },
      {
        image: duskRest,
        name: 'Rest',
        line: 'The world continues while you soften.',
        alt: 'A cream cat with brown spots reclines on a coral ledge beneath dark blue trees.',
      },
      {
        image: duskThicket,
        name: 'Afterglow',
        line: 'Give thanks for one thing that stayed.',
        alt: 'A peach-toned cat faces forward beside a blue botanical thicket.',
      },
    ],
  },
  {
    key: 'night',
    numeral: 'IV',
    name: 'Night Watch',
    hours: '21—05',
    invitation: 'Enter the dark as a shelter, not an answer.',
    blessing: 'May you be held by what is quiet.',
    images: [
      {
        image: nightHalfShadow,
        name: 'Half shadow',
        line: 'Not everything asks to be understood.',
        alt: 'A pale cat with a dark facial patch appears against four botanical panels.',
      },
      {
        image: nightTurningIn,
        name: 'Turning in',
        line: 'Release the noise at the edge of sleep.',
        alt: 'A black-and-white cat lowers its head before blue branches and coral leaves.',
      },
      {
        image: nightWatch,
        name: 'Keeping watch',
        line: 'Stillness can be a form of care.',
        alt: 'A black cat looks to the left from dense blue and coral foliage.',
      },
      {
        image: nightPresence,
        name: 'Presence',
        line: 'You are accompanied through the unknown.',
        alt: 'A black cat faces forward against pale blue leaves and coral flowers.',
      },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v7',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialCard.src}
  imageWidth={1600}
  imageHeight={900}
  themeColor="#071c2f"
  immersive
  jsonLd={jsonLd}
>
  <section
    class="or7"
    id="open-road-v7"
    aria-labelledby="or7-title"
    data-state="idle"
    data-watch="dawn"
    data-held="false"
  >
    <span class="or7__cursor-light" id="or7-cursor-light" aria-hidden="true"></span>

    <nav class="or7__editions" aria-label="Open Road editions">
      <a class="or7__home" href="/" aria-label="Return to PointCast home">← PointCast</a>
      <span aria-hidden="true">/</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <a href="/open-road-v3">III</a>
      <a href="/open-road-v4">IV</a>
      <a href="/open-road-v5">V</a>
      <a href="/open-road-v6">VI</a>
      <span aria-current="page">VII</span>
      <a href="/open-road-v8">VIII</a>
    </nav>

    <header class="or7__header">
      <div>
        <p class="or7__eyebrow">Open Road VII</p>
        <p class="or7__title-line">The Hour That Finds You</p>
      </div>
      <div class="or7__header-actions">
        <p id="or7-local-time" aria-label="Your local time">—:—</p>
        <button id="or7-sound" type="button" aria-pressed="false">
          <span aria-hidden="true">◌</span>
          <span id="or7-sound-label">Bells off</span>
        </button>
      </div>
    </header>

    <div class="or7__book">
      <aside class="or7__hours" aria-label="The four watches">
        <div class="or7__hour-intro">
          <p>This hour arrives as</p>
          <h2 id="or7-watch-name">First Light</h2>
          <p id="or7-watch-hours">05—10 · local time</p>
        </div>

        <div class="or7__dial" id="or7-dial" style="--watch-progress: 0;">
          <div class="or7__dial-center" aria-hidden="true">
            <span>VII</span>
            <i></i>
          </div>
          {watches.map((watch, index) => (
            <button
              class:list={[
                'or7__watch-button',
                'or7__watch-button--' + watch.key,
                { 'is-active': index === 0 },
              ]}
              type="button"
              data-watch={watch.key}
              data-watch-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{watch.numeral}</span>
              <strong>{watch.name}</strong>
              <small>{watch.hours}</small>
            </button>
          ))}
        </div>

        <p class="or7__invitation" id="or7-invitation">
          Let the day arrive before you name it.
        </p>

        <ol class="or7__steps" id="or7-steps" aria-label="Four images in this watch">
          {[0, 1, 2, 3].map((index) => (
            <li class:list={{ 'is-active': index === 0 }} data-step={index}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i aria-hidden="true"></i>
            </li>
          ))}
        </ol>
      </aside>

      <div class="or7__sanctuary">
        <div class="or7__stage" id="or7-stage">
          <div class="or7__aura" aria-hidden="true"></div>

          <div class="or7__images" id="or7-images">
            {watches.flatMap((watch, watchIndex) =>
              watch.images.map((moment, imageIndex) => (
                <figure
                  class:list={[
                    'or7__image',
                    { 'is-active': watchIndex === 0 && imageIndex === 0 },
                  ]}
                  data-image={imageIndex}
                  data-watch={watch.key}
                  data-name={moment.name}
                  data-line={moment.line}
                  data-global-index={watchIndex * 4 + imageIndex}
                  aria-hidden={watchIndex === 0 && imageIndex === 0 ? 'false' : 'true'}
                >
                  <img
                    src={moment.image.src}
                    alt={moment.alt}
                    loading={watchIndex === 0 && imageIndex < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              )),
            )}
          </div>

          <div class="or7__welcome" id="or7-welcome">
            <p class="or7__roman" id="or7-watch-numeral">I</p>
            <p class="or7__watch-label" id="or7-welcome-watch">First Light · 05—10</p>
            <h1 id="or7-title">Enter the hour that found you.</h1>
            <p id="or7-welcome-line">Four quiet witnesses. One unhurried minute.</p>
            <button id="or7-enter" type="button">Enter this hour</button>
            <small>Nothing is recorded. Bells are optional.</small>
          </div>

          <div class="or7__caption" id="or7-caption" aria-hidden="true">
            <div>
              <p id="or7-caption-watch">First Light</p>
              <h2 id="or7-image-name">Threshold</h2>
              <p id="or7-image-line">The day asks only that you notice.</p>
            </div>
            <p class="or7__counter" id="or7-counter">01 / 04</p>
          </div>

          <div class="or7__closing" id="or7-closing" aria-hidden="true">
            <p class="or7__closing-mark" aria-hidden="true">◉</p>
            <p id="or7-closing-watch">First Light</p>
            <h2 id="or7-blessing">May the beginning be gentle.</h2>
            <p>Carry one light into the next hour.</p>
            <div class="or7__closing-actions">
              <button id="or7-keep" type="button">Keep this light</button>
              <button id="or7-again" type="button">Begin again</button>
              <button id="or7-another" type="button">Choose another hour</button>
            </div>
          </div>

          <div class="or7__pocket" id="or7-pocket" aria-hidden="true">
            <p class="or7__pocket-kicker">Your pocket light</p>
            <h2 id="or7-pocket-name">Threshold</h2>
            <p id="or7-pocket-line">The day asks only that you notice.</p>
            <blockquote id="or7-pocket-blessing">May the beginning be gentle.</blockquote>
            <p class="or7__carry">Carry one light into the next hour.</p>
            <div class="or7__pocket-actions">
              <button id="or7-share" type="button">Share this light</button>
              <button id="or7-pocket-return" type="button">Return to the watches</button>
            </div>
          </div>

          <div class="or7__progress" id="or7-progress" aria-hidden="true">
            <i id="or7-progress-bar"></i>
          </div>
        </div>

        <div class="or7__controls" id="or7-controls" aria-label="Watch controls">
          <button id="or7-prev" type="button" aria-label="Previous image">← <span>Previous</span></button>
          <button id="or7-hold" class="or7__hold" type="button" aria-pressed="false">Hold this image</button>
          <button id="or7-next" type="button" aria-label="Next image"><span>Next</span> →</button>
          <button id="or7-keep-running" type="button">Keep this light</button>
          <button id="or7-leave" type="button">Leave the watch</button>
        </div>

        <p class="or7__keyboard-note">Space to hold · arrows to move · 1—4 to choose an hour · Esc to leave</p>
      </div>
    </div>

    <p class="or7__privacy">A private book of hours. Your time and your chosen light stay in this browser tab.</p>
    <p class="or7__status" id="or7-status" aria-live="polite"></p>
  </section>

  <script is:inline>
    (() => {
      const WATCH_DURATION = 60_000;
      const IMAGE_DURATION = 15_000;
      const WATCHES = [
        {
          key: 'dawn',
          numeral: 'I',
          name: 'First Light',
          hours: '05—10',
          invitation: 'Let the day arrive before you name it.',
          blessing: 'May the beginning be gentle.',
          moments: [
            ['Threshold', 'The day asks only that you notice.'],
            ['First face', 'Meet what is here without hurry.'],
            ['Opening', 'Make room for one clear breath.'],
            ['Attention', 'Begin with the light you have.'],
          ],
        },
        {
          key: 'day',
          numeral: 'II',
          name: 'Wide Day',
          hours: '10—17',
          invitation: 'Stand quietly inside the living hour.',
          blessing: 'May your attention be generous.',
          moments: [
            ['Standing', 'Be where your feet have brought you.'],
            ['Garden', 'Let abundance remain uncounted.'],
            ['Turning', 'A small change of view is still a prayer.'],
            ['Fullness', 'Receive the bright and ordinary world.'],
          ],
        },
        {
          key: 'dusk',
          numeral: 'III',
          name: 'Long Light',
          hours: '17—21',
          invitation: 'Let the unfinished day loosen its hold.',
          blessing: 'May enough be enough.',
          moments: [
            ['Homeward', 'What mattered may travel with you.'],
            ['Vessels', 'Set down what does not need carrying.'],
            ['Rest', 'The world continues while you soften.'],
            ['Afterglow', 'Give thanks for one thing that stayed.'],
          ],
        },
        {
          key: 'night',
          numeral: 'IV',
          name: 'Night Watch',
          hours: '21—05',
          invitation: 'Enter the dark as a shelter, not an answer.',
          blessing: 'May you be held by what is quiet.',
          moments: [
            ['Half shadow', 'Not everything asks to be understood.'],
            ['Turning in', 'Release the noise at the edge of sleep.'],
            ['Keeping watch', 'Stillness can be a form of care.'],
            ['Presence', 'You are accompanied through the unknown.'],
          ],
        },
      ];

      const shrine = document.querySelector('#open-road-v7');
      const dial = document.querySelector('#or7-dial');
      const watchButtons = Array.from(document.querySelectorAll('.or7__watch-button'));
      const images = Array.from(document.querySelectorAll('.or7__image'));
      const steps = Array.from(document.querySelectorAll('.or7__steps li'));
      const enterButton = document.querySelector('#or7-enter');
      const soundButton = document.querySelector('#or7-sound');
      const soundLabel = document.querySelector('#or7-sound-label');
      const holdButton = document.querySelector('#or7-hold');
      const prevButton = document.querySelector('#or7-prev');
      const nextButton = document.querySelector('#or7-next');
      const leaveButton = document.querySelector('#or7-leave');
      const keepRunningButton = document.querySelector('#or7-keep-running');
      const keepButton = document.querySelector('#or7-keep');
      const againButton = document.querySelector('#or7-again');
      const anotherButton = document.querySelector('#or7-another');
      const shareButton = document.querySelector('#or7-share');
      const pocketReturnButton = document.querySelector('#or7-pocket-return');
      const progressBar = document.querySelector('#or7-progress-bar');
      const status = document.querySelector('#or7-status');
      const localTime = document.querySelector('#or7-local-time');
      const cursorLight = document.querySelector('#or7-cursor-light');

      let watchIndex = 0;
      let imageIndex = 0;
      let elapsed = 0;
      let lastFrame = 0;
      let frame = 0;
      let bellsOn = false;
      let held = false;
      let wasRunningBeforeHidden = false;
      let audioContext;
      const openingBellPlayed = new Set();
      const closingBellPlayed = new Set();

      function watchForLocalHour(hour) {
        if (hour >= 5 && hour < 10) return 0;
        if (hour >= 10 && hour < 17) return 1;
        if (hour >= 17 && hour < 21) return 2;
        return 3;
      }

      function setText(selector, value) {
        const node = document.querySelector(selector);
        if (node) node.textContent = value;
      }

      function say(message) {
        if (!status) return;
        status.textContent = '';
        window.setTimeout(() => {
          status.textContent = message;
        }, 20);
      }

      function currentWatch() {
        return WATCHES[watchIndex];
      }

      function currentMoment() {
        return currentWatch().moments[imageIndex];
      }

      function setState(nextState) {
        shrine.dataset.state = nextState;
        const running = nextState === 'running';
        document.querySelector('#or7-caption')?.setAttribute('aria-hidden', running ? 'false' : 'true');
        document.querySelector('#or7-closing')?.setAttribute('aria-hidden', nextState === 'complete' ? 'false' : 'true');
        document.querySelector('#or7-pocket')?.setAttribute('aria-hidden', nextState === 'pocket' ? 'false' : 'true');
      }

      function updateWatch() {
        const watch = currentWatch();
        shrine.dataset.watch = watch.key;
        setText('#or7-watch-name', watch.name);
        setText('#or7-watch-hours', watch.hours + ' · local time');
        setText('#or7-invitation', watch.invitation);
        setText('#or7-watch-numeral', watch.numeral);
        setText('#or7-welcome-watch', watch.name + ' · ' + watch.hours);
        setText('#or7-welcome-line', 'Four quiet witnesses. One unhurried minute.');
        setText('#or7-caption-watch', watch.name);
        setText('#or7-closing-watch', watch.name);
        setText('#or7-blessing', watch.blessing);
        setText('#or7-pocket-blessing', watch.blessing);
        watchButtons.forEach((button, index) => {
          const active = index === watchIndex;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        updateImage();
      }

      function updateImage() {
        const watch = currentWatch();
        const moment = currentMoment();
        images.forEach((figure) => {
          const active = figure.dataset.watch === watch.key && Number(figure.dataset.image) === imageIndex;
          figure.classList.toggle('is-active', active);
          figure.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        steps.forEach((step, index) => step.classList.toggle('is-active', index === imageIndex));
        setText('#or7-image-name', moment[0]);
        setText('#or7-image-line', moment[1]);
        setText('#or7-counter', String(imageIndex + 1).padStart(2, '0') + ' / 04');
        setText('#or7-pocket-name', moment[0]);
        setText('#or7-pocket-line', moment[1]);
      }

      function selectImage(target, announce = true) {
        target = Math.max(0, Math.min(3, target));
        imageIndex = target;
        elapsed = target * IMAGE_DURATION;
        updateImage();
        updateProgress();
        if (announce) say(currentMoment()[0] + '. ' + currentMoment()[1]);
      }

      function selectWatch(target, announce = true) {
        cancelAnimationFrame(frame);
        watchIndex = (target + WATCHES.length) % WATCHES.length;
        imageIndex = 0;
        elapsed = 0;
        held = false;
        lastFrame = 0;
        shrine.dataset.held = 'false';
        holdButton.setAttribute('aria-pressed', 'false');
        holdButton.textContent = 'Hold this image';
        setState('idle');
        updateWatch();
        updateProgress();
        history.replaceState(null, '', location.pathname + location.search);
        if (announce) say(currentWatch().name + ' selected.');
      }

      function updateProgress() {
        const progress = Math.max(0, Math.min(1, elapsed / WATCH_DURATION));
        progressBar.style.transform = 'scaleX(' + progress + ')';
        dial.style.setProperty('--watch-progress', String(progress));
      }

      function getAudioContext() {
        if (audioContext) return audioContext;
        const AudioEngine = window.AudioContext || window.webkitAudioContext;
        if (!AudioEngine) return null;
        audioContext = new AudioEngine();
        return audioContext;
      }

      function bell(kind) {
        if (!bellsOn) return false;
        const context = getAudioContext();
        if (!context) return false;
        if (context.state === 'suspended') context.resume();
        const now = context.currentTime;
        const gain = context.createGain();
        const primary = context.createOscillator();
        const overtone = context.createOscillator();
        primary.type = 'sine';
        overtone.type = 'sine';
        primary.frequency.value = kind === 'opening' ? 523.25 : 392;
        overtone.frequency.value = kind === 'opening' ? 784.88 : 587.33;
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.075, now + 0.04);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);
        primary.connect(gain);
        overtone.connect(gain);
        gain.connect(context.destination);
        primary.start(now);
        overtone.start(now + 0.025);
        primary.stop(now + 1.85);
        overtone.stop(now + 1.85);
        return true;
      }

      function focusSoon(node) {
        if (!node) return;
        requestAnimationFrame(() => node.focus({ preventScroll: true }));
      }

      function begin() {
        if (shrine.dataset.state === 'running') return;
        setState('running');
        held = false;
        shrine.dataset.held = 'false';
        holdButton.setAttribute('aria-pressed', 'false');
        holdButton.textContent = 'Hold this image';
        lastFrame = performance.now();
        const key = currentWatch().key;
        if (!openingBellPlayed.has(key) && bell('opening')) {
          openingBellPlayed.add(key);
        }
        say(currentWatch().name + ' has begun.');
        focusSoon(holdButton);
        frame = requestAnimationFrame(tick);
      }

      function finish() {
        cancelAnimationFrame(frame);
        elapsed = WATCH_DURATION;
        imageIndex = 3;
        updateImage();
        updateProgress();
        setState('complete');
        const key = currentWatch().key;
        if (!closingBellPlayed.has(key) && bell('closing')) {
          closingBellPlayed.add(key);
        }
        say(currentWatch().blessing + ' Carry one light into the next hour.');
        focusSoon(keepButton);
      }

      function tick(now) {
        if (shrine.dataset.state !== 'running') return;
        if (!held && !document.hidden) elapsed += Math.max(0, now - lastFrame);
        lastFrame = now;
        if (elapsed >= WATCH_DURATION) {
          finish();
          return;
        }
        const target = Math.floor(elapsed / IMAGE_DURATION);
        if (target !== imageIndex) {
          imageIndex = target;
          updateImage();
        }
        updateProgress();
        frame = requestAnimationFrame(tick);
      }

      function toggleHold() {
        if (shrine.dataset.state !== 'running') return;
        held = !held;
        shrine.dataset.held = held ? 'true' : 'false';
        holdButton.setAttribute('aria-pressed', held ? 'true' : 'false');
        holdButton.textContent = held ? 'Continue this image' : 'Hold this image';
        lastFrame = performance.now();
        say(held ? 'This image is held.' : 'The watch continues.');
      }

      function move(direction) {
        if (shrine.dataset.state !== 'running') return;
        const target = Math.max(0, Math.min(3, imageIndex + direction));
        selectImage(target);
        lastFrame = performance.now();
      }

      function leaveWatch() {
        cancelAnimationFrame(frame);
        held = false;
        elapsed = 0;
        imageIndex = 0;
        lastFrame = 0;
        shrine.dataset.held = 'false';
        holdButton.setAttribute('aria-pressed', 'false');
        holdButton.textContent = 'Hold this image';
        setState('idle');
        updateImage();
        updateProgress();
        history.replaceState(null, '', location.pathname + location.search);
        say('The watch is at rest.');
        focusSoon(enterButton);
      }

      function pocketHash() {
        const params = new URLSearchParams();
        params.set('watch', currentWatch().key);
        params.set('image', String(imageIndex + 1));
        params.set('keep', '1');
        return '#' + params.toString();
      }

      function keepLight() {
        cancelAnimationFrame(frame);
        setText('#or7-pocket-name', currentMoment()[0]);
        setText('#or7-pocket-line', currentMoment()[1]);
        setText('#or7-pocket-blessing', currentWatch().blessing);
        setState('pocket');
        history.replaceState(null, '', pocketHash());
        say('Pocket light kept.');
        focusSoon(shareButton);
      }

      function restoreHash() {
        if (!location.hash) return false;
        const params = new URLSearchParams(location.hash.slice(1));
        const restoredWatch = WATCHES.findIndex((watch) => watch.key === params.get('watch'));
        if (restoredWatch < 0) return false;
        cancelAnimationFrame(frame);
        watchIndex = restoredWatch;
        const restoredImage = Number.parseInt(params.get('image') || '1', 10);
        imageIndex = Number.isInteger(restoredImage) && restoredImage >= 1 && restoredImage <= 4
          ? restoredImage - 1
          : 0;
        elapsed = imageIndex * IMAGE_DURATION;
        held = false;
        updateWatch();
        updateProgress();
        if (params.get('keep') === '1') {
          setState('pocket');
          say('Your shared pocket light is here.');
        } else {
          setState('idle');
        }
        return true;
      }

      function shareLight() {
        const url = new URL(location.href);
        url.hash = pocketHash();
        const shareData = {
          title: 'Open Road VII · ' + currentMoment()[0],
          text: currentMoment()[1] + ' ' + currentWatch().blessing,
          url: url.href,
        };
        if (navigator.share) {
          navigator.share(shareData).then(() => say('Light shared.')).catch((error) => {
            if (error && error.name !== 'AbortError') say('Sharing was not available.');
          });
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url.href).then(() => say('A private link was copied.')).catch(() => say('Copy the address to share this light.'));
          return;
        }
        say('Copy the address to share this light.');
      }

      function updateClock() {
        const now = new Date();
        localTime.textContent = new Intl.DateTimeFormat([], {
          hour: 'numeric',
          minute: '2-digit',
        }).format(now);
      }

      watchButtons.forEach((button) => {
        button.addEventListener('click', () => selectWatch(Number(button.dataset.watchIndex)));
      });
      enterButton.addEventListener('click', begin);
      soundButton.addEventListener('click', () => {
        bellsOn = !bellsOn;
        soundButton.setAttribute('aria-pressed', bellsOn ? 'true' : 'false');
        soundLabel.textContent = bellsOn ? 'Bells on' : 'Bells off';
        if (bellsOn) {
          const context = getAudioContext();
          if (context && context.state === 'suspended') context.resume();
        }
        say(bellsOn ? 'Bells will sound at the opening and closing.' : 'Bells are off.');
      });
      holdButton.addEventListener('click', toggleHold);
      prevButton.addEventListener('click', () => move(-1));
      nextButton.addEventListener('click', () => move(1));
      leaveButton.addEventListener('click', leaveWatch);
      keepRunningButton.addEventListener('click', keepLight);
      keepButton.addEventListener('click', keepLight);
      againButton.addEventListener('click', () => {
        imageIndex = 0;
        elapsed = 0;
        updateImage();
        updateProgress();
        begin();
      });
      anotherButton.addEventListener('click', () => {
        selectWatch(watchIndex, false);
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelector('#or7-dial')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
        focusSoon(watchButtons[watchIndex]);
        say('Choose one of the four watches.');
      });
      shareButton.addEventListener('click', shareLight);
      pocketReturnButton.addEventListener('click', leaveWatch);

      document.addEventListener('keydown', (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest('input, textarea, select, [contenteditable="true"]')) return;
        if (event.code === 'Space') {
          if (target instanceof Element && target.closest('button, a, [role="button"]')) return;
          event.preventDefault();
          toggleHold();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          move(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          move(1);
        } else if (event.key === 'Escape') {
          leaveWatch();
        } else if (event.key >= '1' && event.key <= '4') {
          selectWatch(Number(event.key) - 1);
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          wasRunningBeforeHidden = shrine.dataset.state === 'running' && !held;
          return;
        }
        if (wasRunningBeforeHidden && shrine.dataset.state === 'running') {
          lastFrame = performance.now();
          say('The watch continues.');
        }
        wasRunningBeforeHidden = false;
      });

      window.addEventListener('hashchange', restoreHash);

      if (window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener('pointermove', (event) => {
          cursorLight.style.transform = 'translate3d(' + event.clientX + 'px,' + event.clientY + 'px,0)';
          cursorLight.classList.add('is-visible');
        });
        document.addEventListener('pointerleave', () => cursorLight.classList.remove('is-visible'));
      }

      updateClock();
      window.setInterval(updateClock, 30_000);
      watchIndex = watchForLocalHour(new Date().getHours());
      updateWatch();
      updateProgress();
      if (!restoreHash()) say(currentWatch().name + ' found you.');
    })();
  </script>
</BlockLayout>

