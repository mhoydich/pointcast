---
/**
 * /type — learn-to-type room.
 *
 * Sprint 3 (Mike 2026-05-09 PT brain-dump: "learn to type"). A small
 * pixel-terminal typing tutor. Three difficulty tiers built from
 * cc-voice excerpts, soft typewriter clicks, WPM tracking. No timer
 * pressure, no shame, no leaderboard.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Type"
  description="A small typing room on PointCast. Type along with cc-voice excerpts. Quiet feedback, soft clicks, real WPM. Cozy, not aggressive."
>
  <main class="type-room" data-type-room>
    <header class="type-header">
      <p class="kicker">PointCast typing room</p>
      <h1>Type.</h1>
      <p class="lede">
        A small terminal for keys. Pick a tier, breathe, type along. The
        clicks are synthesized; the corpus is cc-voice. No timer, no
        shame, no leaderboard. Just a place to put your hands down.
      </p>
    </header>

    <section class="tier-row" aria-label="Difficulty tiers">
      <button type="button" class="tier-chip is-active" data-tier="1">1 · sentences</button>
      <button type="button" class="tier-chip" data-tier="2">2 · paragraphs</button>
      <button type="button" class="tier-chip" data-tier="3">3 · long form</button>
    </section>

    <section class="terminal" aria-label="Typing surface">
      <div class="screen">
        <div class="prompt-row">
          <span class="prompt">pointcast@el-segundo:~$</span>
          <span class="caret-pulse" aria-hidden="true">▌</span>
        </div>
        <div class="text-area" data-text-area>
          <div class="reference" data-reference></div>
          <div class="caret" data-caret aria-hidden="true">|</div>
        </div>
        <textarea
          class="capture"
          data-capture
          aria-label="Typing input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        ></textarea>
      </div>
      <div class="status-row" aria-live="polite">
        <span><strong data-wpm>0</strong> WPM</span>
        <span><strong data-accuracy>100</strong>% accurate</span>
        <span><strong data-streak>0</strong> in a row</span>
        <span class="status-message" data-status>ready</span>
      </div>
    </section>

    <section class="hint-row">
      <p>
        Click anywhere on the terminal, or press any key to focus it. Press
        <kbd>Esc</kbd> to reset the current passage. Press <kbd>Tab</kbd> to
        skip to the next.
      </p>
      <p>
        Six excerpts per tier. The clicks are real Web Audio (synthesized
        on first key, ~0.04s envelope, three voices for variety). If your
        speakers are off, the room is just as quiet.
      </p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const passages = {
        1: [
          'a garden is slow on purpose. a broadcast is too.',
          'the coffee pot, still on.',
          'small house. coffee pot always on.',
          'a small internet town.',
          'the door opens slower when it knows you are not in a hurry.',
          'the kettle does not need a name to do its job.',
        ],
        2: [
          'the room becomes kind when no one is trying to conquer it. that is most of the secret.',
          'a chart is an argument. choose what you are saying before you reach for the tools.',
          'the form does the rhetorical work. notice it. then choose it on purpose.',
          'the broadcast is small on purpose. a small porch can hold a real conversation.',
          'attention is the old spell. repeated, without ceremony, in plain rooms.',
          'a fire is fed slowly or not at all. nothing here is asking to be solved by tomorrow.',
        ],
        3: [
          'the sport is mostly preparation. the bow at the entry, the salt thrown high, the long crouch and the long visual sizing-up. the collision when it comes is brief and decisive and almost a footnote. that ratio is the sport.',
          'most coffee is interesting because it organizes time. you sit, you wait for the cup to be ready, you drink it, you do something else. the brewing method is almost secondary to the fact that brewing is a kind of pause.',
          'palace started in the basement of a south london flat in 2009. lev tanju founded it for the skate crew he was already filming. the first run of t-shirts existed because the crew needed something to wear in the videos.',
          'sixteen months after the firestorm, the rebuild is slower and stranger than anyone wanted. some lots are framed and roofed. many more still have a foundation poured and a chain link fence around it. the freeway signs going east still say fire closure a year after the canyon reopened.',
          'the medium is the message gets misread. mcluhan meant something gentler than people hear. he meant: the shape of the channel reshapes the people on either end of it. a printing press produced a kind of mind. the telephone produced a different one. the habit, over time, becomes the message.',
          'a small library that you never finish is better than a long shelf you never start. eight reads is plenty for a porch. each card is one idea. you put it down. you come back later.',
        ],
      };

      const root = document.querySelector('[data-type-room]');
      const reference = document.querySelector('[data-reference]');
      const capture = document.querySelector('[data-capture]');
      const wpmEl = document.querySelector('[data-wpm]');
      const accEl = document.querySelector('[data-accuracy]');
      const streakEl = document.querySelector('[data-streak]');
      const statusEl = document.querySelector('[data-status]');
      const tierChips = document.querySelectorAll('[data-tier]');

      const state = {
        tier: 1,
        passageIndex: 0,
        target: '',
        startedAt: 0,
        keystrokes: 0,
        correct: 0,
        streak: 0,
        audio: null,
      };

      function ensureAudio() {
        if (state.audio) return;
        const Ctx = window.AudioContext || window.webkitAudioContext;
        state.audio = new Ctx();
      }

      function clickSound() {
        if (!state.audio) return;
        if (state.audio.state === 'suspended') state.audio.resume();
        const ctx = state.audio;
        const now = ctx.currentTime;
        const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.045), ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) {
          const fade = Math.pow(1 - i / data.length, 3.2);
          data[i] = (Math.random() * 2 - 1) * fade * 0.42;
        }
        const src = ctx.createBufferSource();
        src.buffer = buf;
        const filter = ctx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.value = 1800 + Math.random() * 600;
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.045);
        src.connect(filter).connect(gain).connect(ctx.destination);
        src.start(now);
        src.stop(now + 0.05);
      }

      function pickPassage() {
        const list = passages[state.tier];
        state.passageIndex = (state.passageIndex + 1) % list.length;
        state.target = list[state.passageIndex];
        renderReference('');
        capture.value = '';
        state.startedAt = 0;
        state.keystrokes = 0;
        state.correct = 0;
        statusEl.textContent = 'ready';
        capture.focus();
      }

      function renderReference(typed) {
        const target = state.target;
        let html = '';
        for (let i = 0; i < target.length; i++) {
          const ch = target[i];
          const t = typed[i];
          const safe = ch === ' ' ? ' ' : escapeChar(ch);
          if (t == null) {
            html += `<span class="char pending">${safe}</span>`;
          } else if (t === ch) {
            html += `<span class="char correct">${safe}</span>`;
          } else {
            html += `<span class="char wrong">${safe}</span>`;
          }
        }
        reference.innerHTML = html;
      }

      function escapeChar(ch) {
        if (ch === '<') return '&lt;';
        if (ch === '>') return '&gt;';
        if (ch === '&') return '&amp;';
        return ch;
      }

      function updateStats(typed) {
        const elapsed = state.startedAt ? (performance.now() - state.startedAt) / 60000 : 0;
        const words = typed.length / 5;
        const wpm = elapsed > 0 ? Math.round(words / elapsed) : 0;
        const acc = state.keystrokes ? Math.round((state.correct / state.keystrokes) * 100) : 100;
        wpmEl.textContent = String(wpm);
        accEl.textContent = String(acc);
        streakEl.textContent = String(state.streak);
      }

      function onInput() {
        ensureAudio();
        clickSound();
        const typed = capture.value;
        if (state.startedAt === 0 && typed.length > 0) {
          state.startedAt = performance.now();
          statusEl.textContent = 'typing';
        }

        if (typed.length === 0) {
          state.streak = 0;
        } else {
          const lastIdx = typed.length - 1;
          const targetCh = state.target[lastIdx];
          const typedCh = typed[lastIdx];
          state.keystrokes += 1;
          if (targetCh === typedCh) {
            state.correct += 1;
            state.streak += 1;
          } else {
            state.streak = 0;
          }
        }

        renderReference(typed);
        updateStats(typed);

        if (typed === state.target) {
          statusEl.textContent = 'passage complete · tab for next';
        } else if (typed.length > state.target.length) {
          capture.value = typed.slice(0, state.target.length);
        }
      }

      function onKey(event) {
        if (event.key === 'Escape') {
          event.preventDefault();
          capture.value = '';
          renderReference('');
          state.startedAt = 0;
          state.keystrokes = 0;
          state.correct = 0;
          state.streak = 0;
          statusEl.textContent = 'reset';
          updateStats('');
          return;
        }
        if (event.key === 'Tab') {
          event.preventDefault();
          pickPassage();
        }
      }

      function setTier(tier) {
        state.tier = tier;
        state.passageIndex = -1;
        tierChips.forEach((chip) => {
          chip.classList.toggle('is-active', Number(chip.dataset.tier) === tier);
        });
        pickPassage();
      }

      tierChips.forEach((chip) => {
        chip.addEventListener('click', () => setTier(Number(chip.dataset.tier)));
      });

      capture.addEventListener('input', onInput);
      capture.addEventListener('keydown', onKey);
      root.addEventListener('click', () => capture.focus());

      window.addEventListener('keydown', (event) => {
        if (document.activeElement === capture) return;
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        if (event.key.length !== 1) return;
        capture.focus();
      });

      pickPassage();
    })();
  </script>

  <style>
    :global(body) {
      background: #f3eee4;
    }

    .type-room {
      min-height: 100vh;
      padding: clamp(1.25rem, 3vw, 2.5rem);
      color: #241f1a;
      font-family: "Departure Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      background:
        radial-gradient(circle at 80% 0%, rgba(255, 248, 222, 0.8), transparent 38rem),
        linear-gradient(180deg, #f7f1e7 0%, #ebe0d2 100%);
    }

    .type-header {
      max-width: 760px;
      margin: 0 auto 1.5rem;
    }

    .kicker {
      margin: 0 0 0.5rem;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #7d4f37;
    }

    h1 {
      margin: 0;
      font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(2.75rem, 12vw, 5.5rem);
      line-height: 0.92;
    }

    .lede {
      max-width: 580px;
      margin: 1rem 0 0;
      font-size: 0.96rem;
      line-height: 1.6;
      color: rgba(36, 31, 26, 0.78);
    }

    .tier-row {
      max-width: 760px;
      margin: 0 auto 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tier-chip {
      min-height: 38px;
      padding: 0 0.85rem;
      border: 2px solid rgba(36, 31, 26, 0.4);
      background: rgba(255, 252, 242, 0.76);
      color: #241f1a;
      font: inherit;
      font-size: 0.78rem;
      cursor: pointer;
    }

    .tier-chip.is-active {
      background: #2c2a25;
      color: #fff7df;
      border-color: #2c2a25;
    }

    .terminal {
      max-width: 760px;
      margin: 0 auto;
      border: 2px solid #2c2a25;
      border-radius: 4px;
      background: #1c1814;
      color: #f5e6c0;
      box-shadow: 0 18px 38px rgba(36, 31, 26, 0.22);
      overflow: hidden;
    }

    .screen {
      position: relative;
      padding: 1rem 1rem 0.6rem;
    }

    .prompt-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      color: rgba(245, 230, 192, 0.7);
    }

    .caret-pulse {
      animation: caret-pulse 1.05s steps(1, end) infinite;
    }

    @keyframes caret-pulse {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    .text-area {
      position: relative;
      margin-top: 0.65rem;
      min-height: 6.5rem;
      font-size: 1.06rem;
      line-height: 1.55;
    }

    .reference {
      white-space: pre-wrap;
      word-break: break-word;
    }

    .char.pending {
      color: rgba(245, 230, 192, 0.42);
    }

    .char.correct {
      color: #f5e6c0;
    }

    .char.wrong {
      color: #ff806b;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .caret {
      display: none;
    }

    .capture {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 1rem 1rem 0.6rem;
      background: transparent;
      border: 0;
      color: transparent;
      caret-color: #f5e6c0;
      resize: none;
      font: inherit;
      font-family: "Departure Mono", monospace;
      font-size: 1.06rem;
      line-height: 1.55;
      outline: none;
    }

    .capture::selection {
      background: rgba(245, 230, 192, 0.18);
    }

    .status-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem 1.4rem;
      padding: 0.7rem 1rem 0.85rem;
      border-top: 1px solid rgba(245, 230, 192, 0.18);
      font-size: 0.78rem;
      color: rgba(245, 230, 192, 0.62);
    }

    .status-row strong {
      color: #f5e6c0;
      margin-right: 0.25rem;
    }

    .status-message {
      margin-left: auto;
      color: rgba(143, 211, 255, 0.85);
    }

    .hint-row {
      max-width: 760px;
      margin: 1.25rem auto 0;
      display: grid;
      gap: 0.6rem;
      color: rgba(36, 31, 26, 0.7);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    kbd {
      display: inline-block;
      padding: 0 0.32rem;
      border: 1px solid rgba(36, 31, 26, 0.4);
      border-radius: 3px;
      background: rgba(255, 252, 242, 0.76);
      color: #241f1a;
      font: inherit;
      font-size: 0.76rem;
    }

    @media (max-width: 620px) {
      .text-area {
        min-height: 8rem;
      }

      .status-row {
        font-size: 0.74rem;
      }

      .status-message {
        margin-left: 0;
        flex-basis: 100%;
      }
    }
  </style>
</BaseLayout>
