---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Nouns Sumo | PointCast';
const description = 'A small playable Nouns Sumo room on PointCast.';
---

<BaseLayout title={title} description={description}>
  <main class="sumo-room" data-sumo-room>
    <section class="sumo-shell" aria-labelledby="sumo-title">
      <header class="sumo-header">
        <p class="eyebrow">pointcast room</p>
        <h1 id="sumo-title">Nouns Sumo</h1>
        <p class="lede">
          A soft dohyō for two visiting Nouns. Tap space, find the peak, and try to nudge the other fighter past the rope.
        </p>
      </header>

      <section class="score-strip" aria-label="match score">
        <article class="score-card player-card">
          <span class="label">left noun</span>
          <strong data-player-seed>seed --</strong>
          <span class="wins" data-player-wins>0 wins</span>
        </article>

        <div class="round-card">
          <span data-round-label>round 1</span>
          <strong data-match-state>ready</strong>
        </div>

        <article class="score-card opponent-card">
          <span class="label">right noun</span>
          <strong data-opponent-seed>seed --</strong>
          <span class="wins" data-opponent-wins>0 wins</span>
        </article>
      </section>

      <p class="announcer" aria-live="polite" data-announcer>
        The yobidashi sweeps the sand. Press space or tap the charge pad.
      </p>

      <section class="dohyo-wrap" aria-label="Nouns sumo ring">
        <div class="dohyo" data-ring>
          <div class="ring-shadow"></div>
          <div class="ring-rope"></div>
          <div class="ring-sand"></div>
          <div class="ring-center"></div>

          <img class="fighter fighter-left" data-player-fighter alt="left Noun fighter" width="160" height="160" />
          <img class="fighter fighter-right" data-opponent-fighter alt="right Noun fighter" width="160" height="160" />
        </div>
      </section>

      <section class="meters" aria-label="charge meters">
        <div class="meter-block">
          <div class="meter-label">
            <span>your charge</span>
            <span data-player-charge-label>0%</span>
          </div>
          <div class="meter">
            <span data-player-meter></span>
          </div>
        </div>

        <button class="charge-pad" type="button" data-charge-button>
          <span class="button-main">charge</span>
          <span class="button-sub">space / tap</span>
        </button>

        <div class="meter-block">
          <div class="meter-label">
            <span>their charge</span>
            <span data-opponent-charge-label>0%</span>
          </div>
          <div class="meter">
            <span data-opponent-meter></span>
          </div>
        </div>
      </section>

      <footer class="sumo-footer">
        <button class="quiet-button" type="button" data-new-match>new match</button>
        <a class="quiet-link" href="/sumo-v2/">try the two-player version</a>
        <a class="quiet-link" href="/reads/sumo">read the companion note</a>
      </footer>
    </section>
  </main>

  <script is:inline>
    (() => {
      const room = document.querySelector('[data-sumo-room]');
      if (!room) return;

      const els = {
        playerSeed: room.querySelector('[data-player-seed]'),
        opponentSeed: room.querySelector('[data-opponent-seed]'),
        playerWins: room.querySelector('[data-player-wins]'),
        opponentWins: room.querySelector('[data-opponent-wins]'),
        roundLabel: room.querySelector('[data-round-label]'),
        matchState: room.querySelector('[data-match-state]'),
        announcer: room.querySelector('[data-announcer]'),
        playerFighter: room.querySelector('[data-player-fighter]'),
        opponentFighter: room.querySelector('[data-opponent-fighter]'),
        playerMeter: room.querySelector('[data-player-meter]'),
        opponentMeter: room.querySelector('[data-opponent-meter]'),
        playerChargeLabel: room.querySelector('[data-player-charge-label]'),
        opponentChargeLabel: room.querySelector('[data-opponent-charge-label]'),
        chargeButton: room.querySelector('[data-charge-button]'),
        newMatch: room.querySelector('[data-new-match]'),
      };

      const ringLimit = 43;
      const startOffset = 22;
      const maxCharge = 100;
      const peakWindow = 88;
      const minLungeCharge = 52;

      const lines = {
        ready: [
          'The yobidashi sweeps the sand. Press space or tap the charge pad.',
          'Two Nouns step into the circle. The rope is quiet.',
          'Hands down. Sand still. Charge when ready.',
        ],
        charge: [
          'The room leans in.',
          'Small feet, big intent.',
          'The sand starts to remember the match.',
          'A careful tachi-ai is forming.',
        ],
        player: [
          'Left Noun catches the timing and slides forward.',
          'A clean little shove from the west side.',
          'Left Noun finds the crest of the charge.',
        ],
        opponent: [
          'Right Noun answers on rhythm.',
          'A patient push from the east side.',
          'Right Noun catches the opening.',
        ],
        draw: [
          'Both Nouns bump and settle back into the sand.',
          'Equal push. The dohyō keeps them both.',
          'A soft collision, no winner yet.',
        ],
      };

      const state = {
        seeds: [0, 1],
        playerWins: 0,
        opponentWins: 0,
        round: 1,
        playerX: -startOffset,
        opponentX: startOffset,
        playerCharge: 0,
        opponentCharge: 0,
        playerDirection: 1,
        opponentDirection: 1,
        charging: false,
        resolving: false,
        matchOver: false,
        lastPlayerTap: 0,
        lastAiTap: 0,
        aiBeat: 520,
        aiJitter: 0,
        raf: 0,
      };

      function randomSeed(except) {
        let seed = Math.floor(Math.random() * 1200);
        while (seed === except) seed = Math.floor(Math.random() * 1200);
        return seed;
      }

      function pickLine(group) {
        const set = lines[group];
        return set[Math.floor(Math.random() * set.length)];
      }

      function setAnnouncer(text) {
        els.announcer.textContent = text;
      }

      function nounUrl(seed) {
        return `https://noun.pics/${seed}.svg`;
      }

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function updateFighters() {
        els.playerFighter.style.setProperty('--x', `${state.playerX}%`);
        els.opponentFighter.style.setProperty('--x', `${state.opponentX}%`);
      }

      function updateMeters() {
        const player = Math.round(state.playerCharge);
        const opponent = Math.round(state.opponentCharge);

        els.playerMeter.style.width = `${player}%`;
        els.opponentMeter.style.width = `${opponent}%`;
        els.playerChargeLabel.textContent = `${player}%`;
        els.opponentChargeLabel.textContent = `${opponent}%`;

        els.playerMeter.dataset.hot = player >= peakWindow ? 'true' : 'false';
        els.opponentMeter.dataset.hot = opponent >= peakWindow ? 'true' : 'false';
      }

      function updateScore() {
        els.playerWins.textContent = `${state.playerWins} ${state.playerWins === 1 ? 'win' : 'wins'}`;
        els.opponentWins.textContent = `${state.opponentWins} ${state.opponentWins === 1 ? 'win' : 'wins'}`;
        els.roundLabel.textContent = state.matchOver ? 'match' : `round ${state.round}`;
        els.matchState.textContent = state.matchOver ? 'finished' : state.resolving ? 'push' : 'ready';
      }

      function resetRound() {
        state.playerX = -startOffset;
        state.opponentX = startOffset;
        state.playerCharge = 0;
        state.opponentCharge = 0;
        state.playerDirection = 1;
        state.opponentDirection = 1;
        state.charging = false;
        state.resolving = false;
        state.lastPlayerTap = 0;
        state.lastAiTap = performance.now();
        state.aiBeat = 460 + Math.random() * 260;
        state.aiJitter = Math.random() * 160;
        room.dataset.phase = 'ready';
        updateFighters();
        updateMeters();
        updateScore();
      }

      function newMatch() {
        state.seeds = [randomSeed(), 0];
        state.seeds[1] = randomSeed(state.seeds[0]);
        state.playerWins = 0;
        state.opponentWins = 0;
        state.round = 1;
        state.matchOver = false;

        els.playerSeed.textContent = `seed ${state.seeds[0]}`;
        els.opponentSeed.textContent = `seed ${state.seeds[1]}`;
        els.playerFighter.src = nounUrl(state.seeds[0]);
        els.opponentFighter.src = nounUrl(state.seeds[1]);

        resetRound();
        setAnnouncer(pickLine('ready'));
      }

      function beginCharging() {
        if (state.matchOver || state.resolving) return;
        state.charging = true;
        room.dataset.phase = 'charging';
        els.matchState.textContent = 'charging';
      }

      function playerTap() {
        if (state.matchOver || state.resolving) return;

        const now = performance.now();
        beginCharging();

        if (now - state.lastPlayerTap > 760) {
          state.playerCharge = Math.max(12, state.playerCharge * 0.55);
        }

        state.playerCharge = clamp(state.playerCharge + 13 + Math.random() * 5, 0, maxCharge);
        state.lastPlayerTap = now;

        if (state.playerCharge >= peakWindow || state.opponentCharge >= maxCharge) {
          resolvePush('player');
        } else if (Math.random() > 0.7) {
          setAnnouncer(pickLine('charge'));
        }

        updateMeters();
      }

      function aiTap(now) {
        if (state.matchOver || state.resolving || !state.charging) return;

        const pressure = state.playerCharge > 48 ? -80 : 0;
        const nextBeat = state.aiBeat + state.aiJitter + pressure;

        if (now - state.lastAiTap >= nextBeat) {
          state.opponentCharge = clamp(state.opponentCharge + 10 + Math.random() * 10, 0, maxCharge);
          state.lastAiTap = now;
          state.aiBeat = 430 + Math.random() * 300;
          state.aiJitter = Math.random() * 170;

          if (state.opponentCharge >= peakWindow || state.playerCharge >= maxCharge) {
            resolvePush('opponent');
          }

          updateMeters();
        }
      }

      function decayCharge() {
        if (!state.charging || state.resolving || state.matchOver) return;

        state.playerCharge = clamp(state.playerCharge - 0.18, 0, maxCharge);
        state.opponentCharge = clamp(state.opponentCharge - 0.14, 0, maxCharge);
        updateMeters();
      }

      function resolvePush(first) {
        if (state.resolving || state.matchOver) return;

        state.resolving = true;
        state.charging = false;
        room.dataset.phase = 'resolving';

        const playerCharge = state.playerCharge;
        const opponentCharge = state.opponentCharge;
        const delta = playerCharge - opponentCharge;
        const firstBonus = first === 'player' ? 8 : -8;
        const net = delta + firstBonus;

        if (Math.abs(net) < 10 || Math.max(playerCharge, opponentCharge) < minLungeCharge) {
          const settle = net * 0.035;
          state.playerX = clamp(state.playerX + settle, -ringLimit, ringLimit);
          state.opponentX = clamp(state.opponentX + settle, -ringLimit, ringLimit);
          setAnnouncer(pickLine('draw'));
        } else if (net > 0) {
          const impulse = clamp(7 + net * 0.18, 7, 18);
          state.playerX = clamp(state.playerX + impulse * 0.22, -ringLimit, ringLimit);
          state.opponentX = clamp(state.opponentX + impulse, -60, 60);
          setAnnouncer(pickLine('player'));
        } else {
          const impulse = clamp(7 + Math.abs(net) * 0.18, 7, 18);
          state.playerX = clamp(state.playerX - impulse, -60, 60);
          state.opponentX = clamp(state.opponentX - impulse * 0.22, -ringLimit, ringLimit);
          setAnnouncer(pickLine('opponent'));
        }

        updateFighters();

        window.setTimeout(() => {
          const playerOut = state.playerX <= -ringLimit;
          const opponentOut = state.opponentX >= ringLimit;

          if (playerOut || opponentOut) {
            finishRound(opponentOut ? 'player' : 'opponent');
            return;
          }

          state.playerCharge = 0;
          state.opponentCharge = 0;
          state.resolving = false;
          room.dataset.phase = 'ready';
          els.matchState.textContent = 'ready';
          updateMeters();
        }, 520);
      }

      function finishRound(winner) {
        if (winner === 'player') {
          state.playerWins += 1;
          setAnnouncer(`Left Noun keeps the ring. ${state.playerWins === 2 ? 'Match complete.' : 'The sand resets.'}`);
        } else {
          state.opponentWins += 1;
          setAnnouncer(`Right Noun keeps the ring. ${state.opponentWins === 2 ? 'Match complete.' : 'The sand resets.'}`);
        }

        if (state.playerWins === 2 || state.opponentWins === 2) {
          state.matchOver = true;
          room.dataset.phase = 'done';
          els.matchState.textContent = winner === 'player' ? 'left wins' : 'right wins';
          updateScore();
          return;
        }

        state.round += 1;
        updateScore();

        window.setTimeout(() => {
          resetRound();
          setAnnouncer(`Round ${state.round}. Both Nouns return to the salt line.`);
        }, 1100);
      }

      function frame(now) {
        aiTap(now);
        decayCharge();
        state.raf = window.requestAnimationFrame(frame);
      }

      els.chargeButton.addEventListener('click', playerTap);
      els.newMatch.addEventListener('click', newMatch);

      window.addEventListener('keydown', (event) => {
        if (event.code !== 'Space') return;
        const target = event.target;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName)) return;
        event.preventDefault();
        playerTap();
      });

      newMatch();
      state.raf = window.requestAnimationFrame(frame);

      window.addEventListener('pagehide', () => {
        window.cancelAnimationFrame(state.raf);
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(body) {
    background:
      linear-gradient(180deg, rgba(247, 239, 218, 0.74), rgba(232, 219, 191, 0.55)),
      var(--color-warm, #f7efd9);
  }

  .sumo-room {
    min-height: 100vh;
    padding: 48px 16px 72px;
    color: var(--color-ink, #241f1a);
    font-family: "Departure Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .sumo-shell {
    width: min(980px, 100%);
    margin: 0 auto;
  }

  .sumo-header {
    max-width: 720px;
    margin-bottom: 24px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.78rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.15rem, 7vw, 5.4rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .lede {
    max-width: 620px;
    margin: 16px 0 0;
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .score-strip {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 10px;
    align-items: stretch;
    margin: 28px 0 18px;
  }

  .score-card,
  .round-card {
    border: 1px solid rgba(36, 31, 26, 0.16);
    background: rgba(255, 252, 242, 0.62);
    box-shadow: 0 1px 0 rgba(36, 31, 26, 0.08);
  }

  .score-card {
    display: grid;
    gap: 6px;
    padding: 13px 14px;
  }

  .opponent-card {
    text-align: right;
  }

  .score-card .label,
  .round-card span,
  .wins {
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.72rem;
  }

  .score-card strong {
    font-size: clamp(0.95rem, 3vw, 1.2rem);
    font-weight: 500;
  }

  .round-card {
    display: grid;
    place-items: center;
    min-width: 126px;
    padding: 12px;
    text-align: center;
  }

  .round-card strong {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .announcer {
    min-height: 2.5rem;
    margin: 0 0 14px;
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.86rem;
    line-height: 1.45;
    text-align: center;
  }

  .dohyo-wrap {
    display: grid;
    place-items: center;
    padding: 16px 0 20px;
  }

  .dohyo {
    position: relative;
    width: min(82vw, 620px);
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }

  .ring-shadow,
  .ring-rope,
  .ring-sand,
  .ring-center {
    position: absolute;
    inset: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .ring-shadow {
    width: 86%;
    height: 86%;
    background: rgba(36, 31, 26, 0.12);
    transform: translate(-50%, -45%);
    filter: blur(2px);
    z-index: 0;
  }

  .ring-rope {
    width: 82%;
    height: 82%;
    background:
      repeating-conic-gradient(
        from 8deg,
        #b78049 0deg 8deg,
        #e6bd78 8deg 15deg,
        #8f6338 15deg 20deg
      );
    box-shadow:
      inset 0 0 0 10px rgba(62, 43, 26, 0.13),
      0 10px 0 rgba(95, 61, 35, 0.22);
    z-index: 1;
  }

  .ring-sand {
    width: 72%;
    height: 72%;
    background:
      radial-gradient(circle at 52% 48%, rgba(255, 252, 236, 0.68), rgba(232, 190, 124, 0.55) 54%, rgba(202, 151, 82, 0.5)),
      repeating-linear-gradient(0deg, rgba(103, 73, 42, 0.08) 0 2px, transparent 2px 10px);
    box-shadow:
      inset 0 0 0 2px rgba(105, 72, 40, 0.2),
      inset 0 0 0 12px rgba(255, 246, 214, 0.2);
    z-index: 2;
  }

  .ring-center {
    width: 3px;
    height: 52%;
    border-radius: 0;
    background: rgba(89, 65, 44, 0.18);
    z-index: 3;
  }

  .fighter {
    position: absolute;
    left: 50%;
    top: 48%;
    z-index: 5;
    width: clamp(90px, 22vw, 158px);
    height: clamp(90px, 22vw, 158px);
    image-rendering: pixelated;
    transform: translate(calc(-50% + var(--x, 0%)), -50%);
    transition: transform 360ms cubic-bezier(0.18, 0.88, 0.24, 1.05);
    filter: drop-shadow(0 12px 0 rgba(71, 49, 31, 0.18));
    user-select: none;
    -webkit-user-drag: none;
  }

  .fighter-left {
    --x: -22%;
  }

  .fighter-right {
    --x: 22%;
    scale: -1 1;
  }

  [data-phase="charging"] .fighter-left {
    animation: sumo-hop-left 360ms steps(2, end) infinite;
  }

  [data-phase="charging"] .fighter-right {
    animation: sumo-hop-right 410ms steps(2, end) infinite;
  }

  .meters {
    display: grid;
    grid-template-columns: 1fr 142px 1fr;
    gap: 12px;
    align-items: end;
  }

  .meter-block {
    min-width: 0;
  }

  .meter-label {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.75rem;
  }

  .meter {
    height: 18px;
    padding: 3px;
    border: 1px solid rgba(36, 31, 26, 0.16);
    background: rgba(255, 252, 242, 0.68);
  }

  .meter span {
    display: block;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #6da37b, #d0b15f 74%, #d36b4c);
    transition: width 90ms linear;
  }

  .meter span[data-hot="true"] {
    background: linear-gradient(90deg, #d0b15f, #d36b4c);
  }

  .charge-pad,
  .quiet-button,
  .quiet-link {
    border: 1px solid rgba(36, 31, 26, 0.18);
    background: rgba(255, 252, 242, 0.76);
    color: var(--color-ink, #241f1a);
    font: inherit;
    text-decoration: none;
  }

  .charge-pad {
    display: grid;
    place-items: center;
    min-height: 74px;
    cursor: pointer;
    box-shadow: 0 5px 0 rgba(36, 31, 26, 0.16);
    touch-action: manipulation;
  }

  .charge-pad:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 rgba(36, 31, 26, 0.16);
  }

  .button-main {
    font-size: 1rem;
  }

  .button-sub {
    color: var(--color-ink-soft, #6d6257);
    font-size: 0.68rem;
  }

  .sumo-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }

  .quiet-button,
  .quiet-link {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 12px;
    cursor: pointer;
    font-size: 0.78rem;
  }

  .quiet-button:hover,
  .quiet-link:hover,
  .charge-pad:hover {
    background: rgba(255, 255, 249, 0.92);
  }

  @keyframes sumo-hop-left {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 2px -2px;
    }
  }

  @keyframes sumo-hop-right {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: -2px -2px;
    }
  }

  @media (max-width: 680px) {
    .sumo-room {
      padding-top: 28px;
    }

    .score-strip {
      grid-template-columns: 1fr 1fr;
    }

    .round-card {
      grid-column: 1 / -1;
      order: -1;
      min-width: 0;
    }

    .meters {
      grid-template-columns: 1fr;
    }

    .charge-pad {
      order: -1;
    }

    .opponent-card {
      text-align: left;
    }

    .dohyo {
      width: min(94vw, 520px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fighter,
    .meter span {
      transition: none;
    }

    [data-phase="charging"] .fighter-left,
    [data-phase="charging"] .fighter-right {
      animation: none;
    }
  }
</style>
