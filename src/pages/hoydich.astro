---
import BlockLayout from '../layouts/BlockLayout.astro';
import { SNAPSHOT, FAMILIES, PROJECTS, STUDIO, NATIVE, ROADMAP, MILESTONES, LATEST_LINKS } from '../data/hoydich-portfolio.mjs';
import '../styles/hoydich-portfolio.css';

const description = 'Michael Hoydich’s visual project map: independent design studies, reading rooms, playful tools and El Segundo fieldwork. See the open pages and what is taking shape next.';
const redesigns = STUDIO.filter(project => project.status === 'redesign');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: SNAPSHOT.title, description, url: 'https://pointcast.xyz/hoydich/',
  dateModified: SNAPSHOT.capturedAt,
  creator: { '@type': 'Person', name: 'Michael Hoydich', url: 'https://pointcast.xyz/about' },
  mainEntity: { '@type': 'ItemList', numberOfItems: PROJECTS.length, itemListElement: PROJECTS.map((project, index) => ({ '@type': 'ListItem', position: index + 1, name: project.title, url: new URL(project.href, 'https://pointcast.xyz').href })) },
};
---

<BlockLayout title="Hoydich / A map of the making" description={description} image="/images/fila/court-material-study.webp" imageWidth={1536} imageHeight={1024} themeColor="#f1eee5" immersive isolated showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/hoydich.json', title: 'Hoydich portfolio — dated project snapshot' }]}>
  <div class="hp" data-hoydich-portfolio>
    <a class="hp-skip" href="#projects">Skip to the projects</a>
    <header class="hp-mast">
      <a class="hp-signature" href="/about"><span aria-hidden="true">mh.</span><div>MICHAEL HOYDICH<small>EL SEGUNDO, CALIFORNIA</small></div></a>
      <nav aria-label="Portfolio"><a href="#latest-links">Latest links</a><a href="#projects">The work</a><a href="#worktable" data-show-studio>In the studio</a><a href="#roadmap">The map</a><a href="/">PointCast ↗</a></nav>
    </header>

    <section class="hp-hero" aria-labelledby="hp-title">
      <div class="hp-hero-copy">
        <p class="hp-kicker"><span class="hp-dot" aria-hidden="true"></span> A PUBLIC STUDIO / AN EDITED VIEW</p>
        <h1 id="hp-title">A map of<br/>the <em>making.</em></h1>
        <p class="hp-intro">Ideas become places.<br/>Places become things to try.</p>
        <p class="hp-dek">Design studies, reading rooms, small instruments and a little fieldwork. A way into what’s open now — and what’s taking shape next.</p>
        <a class="hp-enter" href="#projects">Find a place to begin <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hp-hero-art">
        <figure class="hp-art-main"><img src="/images/fila/court-material-study.webp" width="1536" height="1024" alt="Original AI-generated FILA study artwork: ivory knit forms on a red court-like surface." fetchpriority="high"/><figcaption>01 / MATERIAL, COLOR, A PLACE TO PLAY</figcaption></figure>
        <figure class="hp-art-river"><img src="/images/siddhartha/river-horizon.webp" width="1536" height="1024" alt="Original cyanotype-inspired river artwork for the Siddhartha reading companion."/><figcaption>02 / ANOTHER WORLD</figcaption></figure>
        <figure class="hp-art-objects"><img src="/images/object-library/family.svg" width="1200" height="1000" alt="Six original illustrated object concepts wearing square glasses."/><figcaption>03 / SMALL POSSIBILITIES</figcaption></figure>
        <span class="hp-art-mark" aria-hidden="true">WORK<br/>IN<br/>PROGRESS.</span>
      </div>
    </section>

    <aside class="hp-snapshot" aria-label="Portfolio snapshot">
      <p class="hp-kicker">SNAPSHOT / <time datetime={SNAPSHOT.capturedAt}>{SNAPSHOT.dateLabel}</time></p>
      <dl><div><dt>open projects</dt><dd>{String(PROJECTS.length).padStart(2, '0')}</dd></div><div><dt>studio threads</dt><dd>{String(STUDIO.length).padStart(2, '0')}</dd></div><div><dt>redesigns</dt><dd>{String(redesigns.length).padStart(2, '0')}</dd></div></dl>
      <p>Open means a page you can visit.<br/>A concept stays a concept, even when its page is published.</p>
    </aside>

    <section class="hp-latest hp-section" id="latest-links" aria-labelledby="hp-latest-title">
      <header class="hp-section-head"><div><p class="hp-kicker">LATEST / LINKS & SUMMARIES</p><h2 id="hp-latest-title">A shorter way<br/><em>into the work.</em></h2></div><p>Verified public pages, with a little context for each door. This list shares the dated snapshot above; the studio list below records what is still building.</p></header>
      <nav aria-label="Latest public projects and reading resources"><ul class="hp-link-tree">{LATEST_LINKS.map(project => <li data-latest-project><span class="hp-kicker">OPEN NOW</span><h3><a href={project.href}>{project.title} <span aria-hidden="true">↗</span></a></h3><p>{project.summary}</p>{project.links.length > 0 && <details class="hp-link-branches"><summary>Related pages / {project.links.length} <span aria-hidden="true">+</span></summary><ul>{project.links.map(link => <li><a href={link.href} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{link.label} <span aria-hidden="true">↗</span></a><p>{link.summary}</p></li>)}</ul></details>}{project.source && <a class="hp-latest-source" href={project.source.href}>{project.source.label} <span aria-hidden="true">↗</span></a>}</li>)}</ul></nav>
      <details class="hp-latest-building"><summary>Still building / {STUDIO.length} studio threads <span aria-hidden="true">+</span></summary><ul>{STUDIO.map(project => <li data-latest-building><span class="hp-kicker">{project.status === 'redesign' ? 'REDESIGN' : 'BUILDING'}</span><h3>{project.title}</h3><p>{project.direction}</p></li>)}</ul><p class="hp-note">These are work in progress. Their future destinations are not linked as public pages. The delivered Good Fortune Horizon native edition is recorded in the gallery below.</p></details>
    </section>

    <section class="hp-projects hp-section" id="projects" aria-labelledby="hp-projects-title">
      <header class="hp-section-head"><div><p class="hp-kicker">01 / SELECTED WORK</p><h2 id="hp-projects-title">Different worlds.<br/><em>A common thread.</em></h2></div><p>Follow the artwork into the actual project. Every room has its own pace, purpose and boundaries.</p></header>
      <div class="hp-filters" data-portfolio-filters hidden>
        <div class="hp-status-filters" role="group" aria-label="Filter work by status"><button type="button" data-status-filter="all" aria-pressed="true">All stages</button><button type="button" data-status-filter="open" aria-pressed="false">Open now</button><button type="button" data-status-filter="building" aria-pressed="false">Building</button><button type="button" data-status-filter="redesign" aria-pressed="false">Redesigns</button><button type="button" data-status-filter="delivered-native" aria-pressed="false">Native edition</button></div>
        <div class="hp-family-label"><label for="hp-family">Project family</label><select id="hp-family" data-family-filter>{FAMILIES.map(family => <option value={family.id}>{family.label}</option>)}</select></div>
        <button class="hp-reset" type="button" data-reset-filters>Reset view ↺</button>
      </div>
      <p class="hp-filter-result" data-filter-result role="status" aria-live="polite" aria-atomic="true">{PROJECTS.length} open projects and {STUDIO.length} studio threads; {NATIVE.length} native edition shown.</p>
      <noscript><p class="hp-note">The whole map is visible below. Filtering is available with JavaScript.</p></noscript>
      <div class="hp-gallery">
        {PROJECTS.map(project => <article class={`hp-project hp-project--${project.id}`} id={`project-${project.id}`} data-project-card data-family={project.family} data-next-status={project.next?.status ?? ''} style={`--project-accent:${project.color}`}>
          <figure class="hp-project-art"><a href={project.href} tabindex="-1" aria-hidden="true"><img src={project.image} width="1536" height="1024" alt="" loading="lazy" decoding="async"/></a><span class="hp-project-number" aria-hidden="true">{project.number}</span><figcaption>{project.imageNote}</figcaption></figure>
          <div class="hp-project-copy"><div class="hp-project-meta"><p class="hp-kicker">{project.kind}</p><span class="hp-open"><span aria-hidden="true">●</span> Open page</span></div><h3><a href={project.href}>{project.title}</a></h3><p class="hp-project-subtitle">{project.subtitle}</p><p class="hp-project-description">{project.description}</p>
            <div class="hp-project-actions"><a href={project.href}>{project.action} <span aria-hidden="true">↗</span></a>{project.links.map(link => <a href={link.href} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
            <details class="hp-project-notes"><summary>What’s here / what’s next <span aria-hidden="true">+</span></summary><ul>{project.milestones.map(milestone => <li>{milestone}</li>)}</ul><p>{project.boundary}</p>{project.next && <a class="hp-next-link" data-show-studio href={`#studio-${project.id}-next`}>In the studio: {project.next.title} ↓</a>}</details>
          </div>
        </article>)}
      </div>
      <div class="hp-native-grid">{NATIVE.map(project => <article class="hp-native" data-native-card data-family={project.family}><div class="hp-native-mark" aria-hidden="true">GOOD<br/>FORTUNE<br/>HORIZON<span>NATIVE / DELIVERED</span></div><div><p class="hp-kicker">DELIVERED NATIVE EDITION / {project.subtitle}</p><h3>{project.title}</h3><p>{project.description}</p><p class="hp-native-boundary">{project.boundary}</p></div></article>)}</div>
      <div class="hp-empty" data-project-empty hidden><p>No open pages in this view.</p><a href="#worktable" data-show-studio>See the studio threads below ↓</a></div>
    </section>

    <section class="hp-studio hp-section" id="worktable" aria-labelledby="hp-studio-title">
      <header class="hp-section-head"><div><p class="hp-kicker">02 / ON THE WORKTABLE</p><h2 id="hp-studio-title">The next shape<br/><em>is taking shape.</em></h2></div><p>These threads are in progress as of the snapshot. The next step says what needs to be checked, without assigning a completion percentage.</p></header>
      <div class="hp-studio-grid">{STUDIO.map((project, index) => <article class={`hp-thread hp-thread--${project.status}`} id={`studio-${project.id}`} data-studio-card data-family={project.family} data-status={project.status}>
        <div class="hp-thread-top"><span class="hp-kicker">{String(index + 1).padStart(2, '0')} / {project.kind}</span><span class="hp-stage">{project.status === 'redesign' ? 'REDESIGN' : 'BUILDING'}</span></div>
        <h3>{project.title}</h3><p>{project.direction}</p><div class="hp-thread-flow"><span>{project.currentHref ? 'Current page open' : 'New project'}</span><span aria-hidden="true">→</span><strong>{project.stage}</strong></div><p class="hp-thread-next"><b>Next check</b>{project.nextStep}</p>
        {project.currentHref ? <a class="hp-current-link" href={project.currentHref}>Visit the current edition ↗</a> : <span class="hp-unpublished">Destination not published in this map</span>}
      </article>)}</div>
      <p class="hp-empty" data-studio-empty hidden>No studio threads in this view. Choose another family or reset the filters.</p>
    </section>

    <section class="hp-redesign" aria-labelledby="hp-redesign-title"><p class="hp-kicker">THE REDESIGN DESK / CURRENT → NEXT</p><div><h2 id="hp-redesign-title">Keep the lineage.<br/><em>Show the change.</em></h2><p>Pickleball Home’s second edition is now public. FILA’s next edition is still in the studio. The gallery uses project artwork, not matched screenshots of those editions.</p><p>A before/after comparison will appear when both matching editions can be verified. This snapshot has no verified pair yet.</p></div><nav aria-label="Published editions"><a href="/fila/">FILA / current exhibition ↗</a><a href="/pickleball/home/">RALLY / current home ↗</a></nav></section>

    <section class="hp-roadmap hp-section" id="roadmap" aria-labelledby="hp-roadmap-title"><header class="hp-section-head"><div><p class="hp-kicker">03 / THE WIDER MAP</p><h2 id="hp-roadmap-title">A studio with<br/><em>many doors.</em></h2></div><p>Eleven roadmap lanes, grouped by the kind of work they make possible. This is a map of direction; a lane does not imply a released product.</p></header><div class="hp-map-grid">{ROADMAP.map((group, index) => <article><span class="hp-map-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{group.title}</h3><p>{group.note}</p><ul>{group.lanes.map(lane => <li>{lane}</li>)}</ul></article>)}</div><p class="hp-note">The internship lane is a closed historical archive. Agent products and object factories are concepts or demos where stated. No active application, financial operation or manufacturing service is implied.</p></section>

    <section class="hp-milestones hp-section" id="field-notes" aria-labelledby="hp-milestones-title"><header class="hp-section-head"><div><p class="hp-kicker">04 / RECENT FIELD NOTES</p><h2 id="hp-milestones-title">A few things<br/><em>made it out.</em></h2></div><p>Recorded source editions from the public repository. Dates mark source milestones, not measured production deployment times.</p></header><ol>{MILESTONES.map(milestone => <li><time datetime={milestone.isoDate ?? '2026-10-02'}>{milestone.date}</time><div><h3><a href={milestone.href}>{milestone.title} <span aria-hidden="true">↗</span></a></h3><p>{milestone.description}</p></div></li>)}</ol></section>

    <footer class="hp-footer"><div><p class="hp-kicker">MICHAEL HOYDICH / POINTCAST</p><p>A place to keep making.</p><a href="/about">About Michael ↗</a><a href="/explore">Explore PointCast ↗</a></div><div><p class="hp-kicker">ABOUT THIS MAP</p><p>{SNAPSHOT.note}</p><p>Artwork labels distinguish original illustrations, generated concepts and fictional scenes. Open pages can contain proposed objects, imagined garments or design fiction.</p><a href="/hoydich.json">Read the structured snapshot ↗</a><p class="hp-captured">Checked <time datetime={SNAPSHOT.capturedAt}>{`${SNAPSHOT.capturedAt.slice(0, 10)} / ${SNAPSHOT.capturedAt.slice(11, 16)} UTC`}</time></p></div></footer>
  </div>
  <script>import { initPortfolio } from '../scripts/hoydich-portfolio.mjs';const setup = () => initPortfolio(document.querySelector('[data-hoydich-portfolio]'));setup();document.addEventListener('astro:page-load', setup);</script>
</BlockLayout>
