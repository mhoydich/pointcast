---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Noun Runner';
const description = 'Tap to jump, swipe down to slide, and carry a Noun 1200 meters through the Win95 Retro Arcade.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/noun-runner', name: title, description, url: 'https://pointcast.xyz/noun-runner' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-runner>
    <section class="window" aria-labelledby="runner-title">
      <header class="titlebar"><span>Noun Runner</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Noun Runner menu">
        <button type="button" data-new>Game</button>
        <a href="/noun-flappy">Flappy</a>
        <a href="/swipe-golf">Golf</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">JUMP · SLIDE · RUN</p><h1 id="runner-title">Run 1200m.</h1><p>Tap to jump over low blocks. Swipe down to slide under high gates.</p></div>
        <div class="meters"><span>Meters <strong data-distance>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage">
        <canvas data-canvas width="360" height="500" aria-label="Noun Runner play field"></canvas>
        <div class="overlay" data-overlay hidden>
          <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="runner-dialog-title">
            <header class="dlgbar"><span id="runner-dialog-title" data-dialog-title>Ready</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
            <div class="dlgbody"><p data-dialog-message>Tap to jump.</p><button type="button" data-restart>New Game</button></div>
          </div>
        </div>
      </div>
      <footer class="status" data-status aria-live="polite">Tap the board to jump. Swipe down to slide.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-runner]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width;
      const H = canvas.height;
      const GROUND = 394;
      const slug = 'noun-runner';
      const statsKey = 'pc:arcade:' + slug;
      const profileKey = 'pc:arcade:profile';
      const gameName = 'Runner';
      const badge = 'runner-1200';
      const distanceEl = root.querySelector<HTMLElement>('[data-distance]');
      const bestEl = root.querySelector<HTMLElement>('[data-best]');
      const statusEl = root.querySelector<HTMLElement>('[data-status]');
      const overlay = root.querySelector<HTMLElement>('[data-overlay]');
      const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
      const noun = new Image();
      noun.src = 'https://noun.pics/728.svg';
      type Obstacle = { x: number; type: 'low' | 'high'; passed: boolean };
      const player = { x: 78, y: GROUND - 54, vy: 0, w: 46, h: 54, slide: 0 };
      let obstacles: Obstacle[] = [];
      let distance = 0;
      let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 }).bestScore || 0);
      let speed = 220;
      let spawn = 0;
      let running = false;
      let over = false;
      let won = false;
      let last = 0;
      let raf = 0;
      let pointerStart: { x: number; y: number } | null = null;

      function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
      function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
      function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestScore = Math.max(Number(stats.bestScore || 0), Math.floor(distance));
        }
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
        profile.lastPlayed = gameName;
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = gameName;
          const earned = ['first-win', badge];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
      }
      function persistBest() {
        best = Math.max(best, Math.floor(distance));
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        stats.bestScore = Math.max(Number(stats.bestScore || 0), Math.floor(distance));
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        renderMeters();
      }
      function renderMeters() {
        if (distanceEl) distanceEl.textContent = String(Math.min(1200, Math.floor(distance)));
        if (bestEl) bestEl.textContent = best ? String(best) : '--';
      }
      function showDialog(title: string, message: string) {
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogMessage) dialogMessage.textContent = message;
        if (overlay) overlay.hidden = false;
      }
      function hideDialog() { if (overlay) overlay.hidden = true; }
      function newGame() {
        cancelAnimationFrame(raf);
        obstacles = [];
        distance = 0;
        speed = 220;
        spawn = 0.9;
        player.y = GROUND - player.h;
        player.vy = 0;
        player.slide = 0;
        running = true;
        over = false;
        won = false;
        last = 0;
        hideDialog();
        recordPlay(false);
        renderMeters();
        setStatus('Run to 1200 meters.');
        raf = requestAnimationFrame(frame);
      }
      function grounded() { return player.y >= GROUND - player.h - 0.5; }
      function jump() {
        if (over || won) { newGame(); return; }
        if (!running || player.slide > 0) return;
        if (grounded()) {
          player.vy = -630;
          setStatus('Jump.');
        }
      }
      function slide() {
        if (over || won) { newGame(); return; }
        if (!running || !grounded()) return;
        player.slide = 0.55;
        setStatus('Slide.');
      }
      function fail(kind: string) {
        if (over || won) return;
        over = true;
        running = false;
        persistBest();
        setStatus('Hit a ' + kind + ' obstacle at ' + Math.floor(distance) + 'm.');
        showDialog('Game Over', 'Run ended at ' + Math.floor(distance) + ' meters.');
      }
      function clear() {
        if (won) return;
        won = true;
        running = false;
        distance = 1200;
        recordPlay(true);
        persistBest();
        setStatus('1200 meters cleared.');
        showDialog('Cleared!', '1200 meters cleared. Badge logged locally.');
      }
      function playerRect() {
        const sliding = player.slide > 0 && grounded();
        const h = sliding ? 28 : player.h;
        const y = sliding ? GROUND - h : player.y;
        return { x: player.x - 18, y, w: player.w, h };
      }
      function obstacleRect(o: Obstacle) {
        if (o.type === 'low') return { x: o.x, y: GROUND - 34, w: 34, h: 34 };
        return { x: o.x, y: GROUND - 104, w: 48, h: 32 };
      }
      function intersects(a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }) {
        return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
      }
      function addObstacle() {
        const lastType = obstacles[obstacles.length - 1]?.type;
        const type = lastType === 'high' ? 'low' : (Math.random() < 0.48 ? 'high' : 'low');
        obstacles.push({ x: W + 42, type, passed: false });
      }
      function update(dt: number) {
        if (!running || over || won) return;
        speed = Math.min(340, speed + dt * 5);
        distance += dt * (speed * 0.48);
        if (distance >= 1200) { clear(); return; }
        spawn -= dt;
        if (spawn <= 0) {
          addObstacle();
          spawn = 1.02 + Math.random() * 0.32;
        }
        if (player.slide > 0) player.slide = Math.max(0, player.slide - dt);
        player.vy += 1650 * dt;
        player.y += player.vy * dt;
        if (player.y > GROUND - player.h) {
          player.y = GROUND - player.h;
          player.vy = 0;
        }
        for (const obstacle of obstacles) {
          obstacle.x -= speed * dt;
          if (!obstacle.passed && obstacle.x + 48 < player.x) {
            obstacle.passed = true;
            setStatus(Math.floor(distance) + 'm. Keep going.');
          }
          if (intersects(playerRect(), obstacleRect(obstacle))) fail(obstacle.type);
        }
        obstacles = obstacles.filter((obstacle) => obstacle.x > -70);
        renderMeters();
      }
      function drawObstacle(o: Obstacle) {
        const r = obstacleRect(o);
        ctx.fillStyle = o.type === 'low' ? '#d22209' : '#000080';
        ctx.fillRect(r.x, r.y, r.w, r.h);
        ctx.fillStyle = 'rgba(255,255,255,.62)';
        ctx.fillRect(r.x, r.y, r.w, 3);
        ctx.fillRect(r.x, r.y, 3, r.h);
        ctx.fillStyle = 'rgba(0,0,0,.36)';
        ctx.fillRect(r.x, r.y + r.h - 3, r.w, 3);
        ctx.fillRect(r.x + r.w - 3, r.y, 3, r.h);
        ctx.fillStyle = '#fff';
        ctx.font = '700 14px Courier New';
        ctx.textAlign = 'center';
        ctx.fillText(o.type === 'low' ? '[]' : 'GATE', r.x + r.w / 2, r.y + r.h / 2 + 5);
      }
      function draw() {
        ctx.fillStyle = '#78c9d4';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#008080';
        ctx.fillRect(0, GROUND, W, H - GROUND);
        ctx.fillStyle = '#c0c0c0';
        for (let x = -((distance * 2) % 42); x < W; x += 42) ctx.fillRect(x, GROUND + 18, 24, 12);
        ctx.strokeStyle = '#404040';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(0, GROUND);
        ctx.lineTo(W, GROUND);
        ctx.stroke();
        obstacles.forEach(drawObstacle);
        const pr = playerRect();
        if (noun.complete && noun.naturalWidth) {
          ctx.drawImage(noun, pr.x - 4, pr.y - 6, pr.w + 8, pr.h + 10);
        } else {
          ctx.fillStyle = '#f7c325';
          ctx.fillRect(pr.x, pr.y, pr.w, pr.h);
        }
        ctx.fillStyle = '#fff';
        ctx.font = '700 28px Courier New';
        ctx.textAlign = 'left';
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 4;
        const label = Math.min(1200, Math.floor(distance)) + 'm';
        ctx.strokeText(label, 16, 40);
        ctx.fillText(label, 16, 40);
      }
      function frame(t: number) {
        const dt = last ? Math.min(0.033, (t - last) / 1000) : 0;
        last = t;
        update(dt);
        draw();
        if (running && !over && !won) raf = requestAnimationFrame(frame);
      }
      canvas.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        canvas.setPointerCapture(event.pointerId);
        const rect = canvas.getBoundingClientRect();
        pointerStart = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      });
      canvas.addEventListener('pointermove', (event) => {
        if (pointerStart) event.preventDefault();
      });
      canvas.addEventListener('pointerup', (event) => {
        event.preventDefault();
        if (!pointerStart) return;
        const rect = canvas.getBoundingClientRect();
        const y = event.clientY - rect.top;
        const dy = y - pointerStart.y;
        pointerStart = null;
        if (dy > 32) slide();
        else jump();
      });
      canvas.addEventListener('pointercancel', () => { pointerStart = null; });
      root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else if (running && !over && !won) { last = 0; raf = requestAnimationFrame(frame); }
      });
      renderMeters();
      newGame();
    }
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,760px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:44ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; gap:6px; }
  .meters span { min-width:82px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 18px/1 "Courier New",monospace; color:#000080; }
  .stage { position:relative; width:min(calc(100vw - 36px),360px); margin:4px auto 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#78c9d4; }
  canvas { display:block; width:100%; height:auto; image-rendering:pixelated; touch-action:none; user-select:none; -webkit-user-select:none; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 8px 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
</style>
