---
import AuthMenu from '../components/AuthMenu.astro';
import BlockLayout from '../layouts/BlockLayout.astro';
import { DESK_LEGEND } from '../lib/desk-rows';

const description = 'PointCast director-only executive desk for one-click Beacon signatures, treasury balances, and today’s operating counts.';
---

<BlockLayout title="Director’s desk" description={description} noindex={true} themeColor="#e9f1f8">
  <main class="desk" data-director-root>
    <nav class="desk__crumb" aria-label="Breadcrumb">
      <a href="/">← PointCast</a><span>/</span><span>desk</span>
      <span class="desk__private">director only</span>
    </nav>

    <section class="desk-door" data-director-door aria-labelledby="desk-door-title">
      <div class="desk-door__signal" aria-hidden="true"><span>PC</span><i></i><i></i><i></i></div>
      <div>
        <p class="desk__kicker">PRIVATE CHANNEL · SIGN-IN REQUIRED</p>
        <h1 id="desk-door-title">The director’s desk opens to one verified identity.</h1>
        <p class="desk-door__dek" data-director-door-copy>
          Sign in with the linked contract-admin Tezos identity or an authorized PointCast director session.
        </p>
        <AuthMenu />
        <p class="desk-door__privacy">No private keys enter PointCast. Every transaction still requires a separate Kukai approval.</p>
      </div>
    </section>

    <div class="desk-board" data-director-board hidden>
      <header class="desk-head">
        <div>
          <p class="desk__kicker">CH.FD · EXECUTIVE CONTROL · MAINNET</p>
          <h1>One desk.<br /><em>One click to Kukai.</em></h1>
          <p>PointCast prepares the exact call and shows you the value it replaces. Kukai keeps the final signature. Chain rows clear themselves after the queue’s next verified read.</p>
        </div>
        <div class="desk-head__live">
          <span data-desk-open>— open</span>
          <span data-desk-read>reading chain…</span>
        </div>
      </header>

      <section class="desk-grid" aria-label="PointCast executive dashboard">
        <section class="desk-column desk-column--signatures" aria-labelledby="desk-signatures-title">
          <header>
            <p class="desk__kicker">01 · APPROVAL RAIL</p>
            <h2 id="desk-signatures-title">Signatures</h2>
            <dl class="desk-legend">
              {DESK_LEGEND.map(({ column, meaning }) => (
                <div><dt>{column}</dt><dd>{meaning}</dd></div>
              ))}
            </dl>
          </header>
          <ol class="desk-sig-list" data-desk-signatures></ol>
        </section>

        <section class="desk-column desk-column--till" aria-labelledby="desk-till-title">
          <header>
            <p class="desk__kicker">02 · PROJECT MONEY</p>
            <h2 id="desk-till-title">The till</h2>
            <p>Public balances and treasury routing, read from Tezos.</p>
          </header>
          <dl class="desk-till-list" data-desk-till></dl>
        </section>

        <section class="desk-column desk-column--today" aria-labelledby="desk-today-title">
          <header>
            <p class="desk__kicker">03 · LIVE COUNTS</p>
            <h2 id="desk-today-title">Today</h2>
            <p>Claim, mint, subscriber, alias, and receipt signals.</p>
          </header>
          <dl class="desk-today-list" data-desk-today></dl>
        </section>
      </section>

      <footer class="desk-foot">
        <span>60-second private refresh</span>
        <span>Taquito 25 · methodsObject</span>
        <span>Beacon → Kukai → TzKT</span>
      </footer>
    </div>
  </main>
</BlockLayout>

<script>
  import { hasDirectorDeskAccess } from '../lib/director-access';
  import { createDeskList, shortAddress, type DeskList, type DeskRow } from '../lib/desk-rows';
  import type { DirectorOperation } from '../lib/director-operations';

  interface TillItem {
    id: string;
    label: string;
    address: string;
    balanceMutez: number | null;
    available: boolean;
    detail: string;
    matchesSafe?: boolean | null;
  }

  interface TodayMetric { id: string; label: string; value: number | null; detail: string; }
  interface QueuePayload {
    rows: DeskRow[];
    till: TillItem[];
    today: TodayMetric[];
    generatedAt: string;
    chain: { readAt: string; cached: boolean };
  }

  const POLL_MS = 60_000;

  function tez(balanceMutez: number | null): string {
    if (balanceMutez === null) return '—';
    return `${(balanceMutez / 1_000_000).toLocaleString('en-US', { maximumFractionDigits: 6 })} ꜩ`;
  }

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function renderTill(root: HTMLElement, items: TillItem[]): void {
    const list = root.querySelector<HTMLElement>('[data-desk-till]');
    if (!list) return;
    list.replaceChildren(...items.map((item) => {
      const row = element('div', `desk-till-row${item.matchesSafe === true ? ' is-match' : item.matchesSafe === false ? ' is-mismatch' : ''}`);
      const amount = element('strong', 'desk-till-row__amount', item.balanceMutez === null && item.id === 'kennel-treasury'
        ? (item.matchesSafe ? 'SAFE ✓' : 'CHECK')
        : tez(item.balanceMutez));
      const address = element('a', 'desk-till-row__address', shortAddress(item.address));
      address.href = item.address ? `https://tzkt.io/${item.address}` : '#';
      address.target = '_blank';
      address.rel = 'noopener';
      row.append(element('dt', '', item.label), amount, address, element('small', '', item.detail));
      return row;
    }));
  }

  function renderToday(root: HTMLElement, metrics: TodayMetric[]): void {
    const list = root.querySelector<HTMLElement>('[data-desk-today]');
    if (!list) return;
    list.replaceChildren(...metrics.map((metric, index) => {
      const row = element('div', 'desk-today-row');
      row.append(
        element('dt', '', `${String(index + 1).padStart(2, '0')} · ${metric.label}`),
        element('dd', '', metric.value === null ? '—' : String(metric.value)),
        element('small', '', metric.detail),
      );
      return row;
    }));
  }

  function mountDirectorDesk(): void {
    const root = document.querySelector<HTMLElement>('[data-director-root]');
    if (!root) return;
    const prior = (window as typeof window & { __pcDirectorDesk?: AbortController }).__pcDirectorDesk;
    prior?.abort();
    const lifetime = new AbortController();
    (window as typeof window & { __pcDirectorDesk?: AbortController }).__pcDirectorDesk = lifetime;

    const signatures = root.querySelector<HTMLElement>('[data-desk-signatures]');
    let desk: DeskList | null = null;

    const showDoor = (copy?: string) => {
      root.querySelector<HTMLElement>('[data-director-door]')?.removeAttribute('hidden');
      root.querySelector<HTMLElement>('[data-director-board]')?.setAttribute('hidden', '');
      if (copy) root.querySelector<HTMLElement>('[data-director-door-copy]')?.replaceChildren(copy);
    };

    const showBoard = (next: QueuePayload) => {
      root.querySelector<HTMLElement>('[data-director-door]')?.setAttribute('hidden', '');
      root.querySelector<HTMLElement>('[data-director-board]')?.removeAttribute('hidden');
      desk?.setRows(next.rows ?? []);
      renderTill(root, next.till ?? []);
      renderToday(root, next.today ?? []);
      const open = (next.rows ?? []).filter((row) => !row.done).length;
      root.querySelector<HTMLElement>('[data-desk-open]')?.replaceChildren(`${open} open`);
      const read = new Date(next.chain?.readAt || next.generatedAt);
      root.querySelector<HTMLElement>('[data-desk-read]')?.replaceChildren(
        `chain ${read.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}${next.chain?.cached ? ' · cached' : ''}`,
      );
    };

    const refresh = async () => {
      try {
        const sessionResponse = await fetch('/api/auth/session', { credentials: 'same-origin', signal: lifetime.signal });
        if (!sessionResponse.ok) return showDoor();
        const session = await sessionResponse.json();
        if (!hasDirectorDeskAccess(session)) return showDoor('This session is signed in, but it is not linked to the contract admin and has no director role.');
        const response = await fetch('/api/director/queue', { credentials: 'same-origin', cache: 'no-store', signal: lifetime.signal });
        if (!response.ok) return showDoor('The director queue refused this session. Sign in again with the linked admin identity.');
        showBoard(await response.json() as QueuePayload);
      } catch (error) {
        if (!(error instanceof DOMException && error.name === 'AbortError')) showDoor('The private queue is temporarily unavailable. No transaction was prepared.');
      }
    };

    if (signatures) {
      desk = createDeskList(signatures, {
        doc: document,
        // The wallet call connects on its own (ensurePointCastPermissions),
        // so one click signs — there is no separate connect step.
        submit: async (operation: DirectorOperation) => {
          const { submitDirectorOperation } = await import('../lib/tezos');
          const result = await submitDirectorOperation(operation);
          return { opHash: result.opHash, confirmation: result.confirmation };
        },
        toggle: async (id: string, done: boolean) => {
          const response = await fetch('/api/director/queue', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, done }),
          });
          if (!response.ok) throw new Error(`The town could not save that (HTTP ${response.status}).`);
        },
        refresh,
      });
      // One delegated listener on the persistent list root — rows are
      // rebuilt on every render, so per-node listeners would die.
      signatures.addEventListener('click', (event) => { void desk?.handleClick(event); }, { signal: lifetime.signal });
    }

    window.addEventListener('pc:auth-change', refresh, { signal: lifetime.signal });
    const timer = window.setInterval(refresh, POLL_MS);
    lifetime.signal.addEventListener('abort', () => window.clearInterval(timer), { once: true });
    void refresh();
  }

  mountDirectorDesk();
  document.addEventListener('astro:page-load', mountDirectorDesk);
</script>

<!-- `is:global` on purpose. Every signature, till, and today row is built
     by the client script with document.createElement, so those nodes never
     carry Astro's scoped data-astro-cid-* attribute and scoped rules match
     nothing (the PR #1053 bug: the row controls rendered as bare text).
     Same fix as AgentLedger and drum-v2. All selectors are desk-* prefixed. -->
<style is:global>
  .desk { --blue: #185fa5; --blue-dark: #0b3e73; --red: #8a2432; --green: #1f6b3c; --paper: #fffdf6; width: min(1440px, calc(100vw - 28px)); margin: 0 auto; padding: 18px 0 100px; color: #111; }
  .desk [hidden] { display: none !important; }
  .desk__crumb { display: flex; gap: 10px; align-items: center; min-height: 38px; border-bottom: 2px solid #111; font: 500 9px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .desk__crumb a { color: var(--blue); }
  .desk__private { margin-left: auto; padding: 5px 7px; border: 1px solid var(--red); color: var(--red); }
  .desk__kicker { margin: 0 0 10px; color: var(--blue); font: 500 9px var(--pc-font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .desk-door { display: grid; grid-template-columns: minmax(180px, .65fr) minmax(0, 1.35fr); min-height: 560px; margin-top: 18px; border: 2px solid #111; background: var(--paper); box-shadow: 9px 9px 0 var(--blue); }
  .desk-door__signal { display: grid; place-content: center; border-right: 2px solid #111; background: var(--blue); color: #fff; }
  .desk-door__signal span { font: 500 clamp(72px, 12vw, 180px)/1 var(--pc-font-sans); letter-spacing: -.08em; }
  .desk-door__signal i { display: block; width: 70%; height: 7px; margin: 10px auto 0; background: currentColor; }
  .desk-door > div:last-child { align-self: center; padding: clamp(28px, 6vw, 90px); }
  .desk-door h1 { max-width: 14ch; margin: 0; font-size: clamp(42px, 6vw, 84px); line-height: .92; letter-spacing: -.06em; }
  .desk-door__dek { max-width: 58ch; margin: 24px 0; font-size: 15px; line-height: 1.55; }
  .desk-door__privacy { margin: 22px 0 0; color: #5f5e5a; font: 400 9px/1.5 var(--pc-font-mono); }
  .desk-board { margin-top: 18px; border: 2px solid #111; background: var(--paper); box-shadow: 9px 9px 0 var(--blue); }
  .desk-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 30px; padding: clamp(24px, 4vw, 56px); border-bottom: 2px solid #111; background: #eef4fa; }
  .desk-head h1 { margin: 0; font-size: clamp(50px, 7vw, 100px); line-height: .84; letter-spacing: -.07em; }
  .desk-head h1 em { color: var(--blue); font-style: normal; }
  .desk-head p:last-child { max-width: 70ch; margin: 22px 0 0; font-size: 14px; line-height: 1.5; }
  .desk-head__live { display: flex; flex-direction: column; gap: 7px; align-items: end; }
  .desk-head__live span { padding: 7px 9px; border: 1px solid #111; background: #fff; font: 500 8px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .desk-grid { display: grid; grid-template-columns: 1.7fr .72fr .68fr; }
  .desk-column { min-width: 0; }
  .desk-column + .desk-column { border-left: 2px solid #111; }
  .desk-column > header { min-height: 148px; padding: 19px; border-bottom: 1px solid #111; }
  .desk-column h2 { margin: 0; font-size: clamp(31px, 3vw, 48px); line-height: 1; letter-spacing: -.05em; }
  .desk-column > header > p:last-child { margin: 10px 0 0; color: #5f5e5a; font-size: 11px; line-height: 1.4; }

  /* Legend — names the four columns every row below prints. */
  .desk-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 12px 0 0; }
  .desk-legend > div { display: flex; gap: 5px; align-items: baseline; }
  .desk-legend dt { color: var(--blue-dark); font: 500 8px var(--pc-font-mono); letter-spacing: .11em; }
  .desk-legend dd { margin: 0; color: #5f5e5a; font: 400 10px var(--pc-font-sans); }

  .desk-sig-list { margin: 0; padding: 0; list-style: none; }
  .desk-sig { padding: 15px 16px 16px; border-bottom: 1px solid rgba(0,0,0,.24); transition: opacity .8s ease; }
  .desk-sig:last-child { border-bottom: 0; }
  .desk-sig--signature { background: #fff8e9; }
  .desk-sig--check { background: #fbf7f7; }
  .desk-sig.is-done { background: #eef5ef; opacity: .62; }
  .desk-sig.is-cleared { opacity: .35; }
  .desk-sig--clear { color: #4f4e4a; }
  .desk-sig__head { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 11px; }
  .desk-sig__code { color: var(--red); font: 500 8px var(--pc-font-mono); letter-spacing: .1em; }
  .desk-sig__go { flex: none; padding: 9px 13px; border: 1px solid #111; border-radius: 0; background: #111; color: #fff; cursor: pointer; font: 500 9px var(--pc-font-mono); letter-spacing: .08em; text-align: center; text-decoration: none; text-transform: uppercase; }
  .desk-sig__go:hover { border-color: var(--blue); background: var(--blue); color: #fff; }
  .desk-sig__go:disabled { cursor: wait; opacity: .45; }
  .desk-sig__go--quiet { background: #fff; color: #111; }

  /* WHAT / NOW / AFTER / STATUS */
  .desk-sig__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, .78fr); margin: 0; border: 1px solid rgba(0,0,0,.22); background: #fff; }
  .desk-sig__cell { min-width: 0; padding: 9px 10px; }
  .desk-sig__cell + .desk-sig__cell { border-left: 1px solid rgba(0,0,0,.16); }
  .desk-sig__cell--now { background: #fdf3f1; }
  .desk-sig__cell--after { background: #eef4fa; }
  .desk-sig__col { color: var(--blue-dark); font: 500 8px var(--pc-font-mono); letter-spacing: .12em; }
  .desk-sig__cell--now .desk-sig__col { color: var(--red); }
  .desk-sig__cell--after .desk-sig__col::before { content: '→ '; }
  .desk-sig__value { margin: 5px 0 0; overflow-wrap: anywhere; font: 400 11px/1.4 var(--pc-font-mono); }
  .desk-sig__cell--what .desk-sig__value { font: 400 13px/1.3 var(--pc-font-sans); }
  .desk-sig__note { display: block; margin-top: 2px; color: #5f5e5a; font: 400 9px var(--pc-font-mono); font-style: normal; }
  .desk-sig__why { margin: 9px 0 0; color: #4f4e4a; font-size: 11px; line-height: 1.45; }
  .desk-sig__error { margin: 8px 0 0; padding: 7px 9px; border-left: 3px solid var(--red); background: #fff0ef; color: #6d1b26; font: 400 10px/1.45 var(--pc-font-mono); overflow-wrap: anywhere; }

  .desk-pill { display: inline-block; padding: 5px 7px; border: 1px solid #111; background: #fff; font: 500 8px var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .desk-pill[data-desk-stage='confirm'] { border-color: var(--red); background: #fff0ef; color: var(--red); }
  .desk-pill[data-desk-stage='broadcast'] { border-color: var(--blue); background: #eef4fa; color: var(--blue-dark); }
  .desk-pill[data-desk-stage='confirmed'] { border-color: var(--green); background: #eef5ef; color: var(--green); }
  .desk-pill[data-desk-stage='cleared'] { border-color: #7d7c78; background: #f2f1ec; color: #56554f; }
  .desk-pill__op { color: inherit; text-decoration: underline; }

  .desk-till-list, .desk-today-list { margin: 0; }
  .desk-till-row, .desk-today-row { display: grid; gap: 7px; padding: 16px; border-bottom: 1px solid rgba(0,0,0,.24); }
  .desk-till-row:last-child, .desk-today-row:last-child { border-bottom: 0; }
  .desk-till-row dt, .desk-today-row dt { color: var(--blue-dark); font: 500 8px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .desk-till-row__amount { font-size: 27px; letter-spacing: -.04em; }
  .desk-till-row__address { overflow: hidden; color: #222; font: 400 9px var(--pc-font-mono); text-decoration: underline; text-overflow: ellipsis; }
  .desk-till-row small, .desk-today-row small { color: #5f5e5a; font: 400 8px/1.4 var(--pc-font-mono); }
  .desk-till-row.is-match { background: #eef5ef; }
  .desk-till-row.is-mismatch { background: #fff0ef; }
  .desk-today-row { grid-template-columns: minmax(0, 1fr) auto; min-height: 108px; align-content: center; }
  .desk-today-row dd { grid-row: 1 / span 2; grid-column: 2; margin: 0; color: var(--red); font-size: clamp(38px, 4vw, 60px); font-weight: 500; line-height: .8; letter-spacing: -.06em; }
  .desk-today-row small { grid-column: 1; }
  .desk-foot { display: flex; justify-content: space-between; gap: 10px; padding: 11px 15px; border-top: 2px solid #111; background: #111; color: #fff; font: 400 8px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; }

  @media (max-width: 1180px) {
    .desk-sig__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .desk-sig__cell { border-top: 1px solid rgba(0,0,0,.16); }
    .desk-sig__cell:nth-child(-n+2) { border-top: 0; }
    .desk-sig__cell:nth-child(odd) { border-left: 0; }
  }
  @media (max-width: 980px) {
    .desk-grid { grid-template-columns: 1fr 1fr; }
    .desk-column--signatures { grid-column: 1 / -1; border-bottom: 2px solid #111; }
    .desk-column--till { border-left: 0; }
  }
  @media (max-width: 680px) {
    .desk { width: min(100% - 18px, 1440px); }
    .desk-door { grid-template-columns: 1fr; min-height: 0; box-shadow: 5px 5px 0 var(--blue); }
    .desk-door__signal { min-height: 180px; border-right: 0; border-bottom: 2px solid #111; }
    .desk-board { box-shadow: 5px 5px 0 var(--blue); }
    .desk-head { grid-template-columns: 1fr; }
    .desk-head__live { flex-direction: row; align-items: start; }
    .desk-grid { grid-template-columns: 1fr; }
    .desk-column--signatures { grid-column: auto; }
    .desk-column + .desk-column { border-left: 0; border-top: 2px solid #111; }
    .desk-sig__grid { grid-template-columns: 1fr; }
    .desk-sig__cell + .desk-sig__cell { border-left: 0; }
    .desk-sig__cell:nth-child(-n+2) { border-top: 1px solid rgba(0,0,0,.16); }
    .desk-sig__cell:first-child { border-top: 0; }
    .desk-foot { flex-direction: column; }
  }
</style>
