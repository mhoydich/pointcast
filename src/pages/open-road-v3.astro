---
import BlockLayout from '../layouts/BlockLayout.astro';
import mountainScore from '../assets/shrines/open-road-v3/a1-mountain-score.webp';
import cloudWalker from '../assets/shrines/open-road-v3/a2-cloud-walker.webp';
import cityKeyboard from '../assets/shrines/open-road-v3/a3-city-keyboard.webp';
import greenWeather from '../assets/shrines/open-road-v3/a4-green-weather.webp';
import ochreField from '../assets/shrines/open-road-v3/a5-ochre-field.webp';
import listeningFace from '../assets/shrines/open-road-v3/b1-listening-face.webp';
import quietVoice from '../assets/shrines/open-road-v3/b2-quiet-voice.webp';
import moonPortrait from '../assets/shrines/open-road-v3/b3-moon-portrait.webp';
import signalHead from '../assets/shrines/open-road-v3/b4-signal-head.webp';
import inkStorm from '../assets/shrines/open-road-v3/b5-ink-storm.webp';

const title = 'Open Road III · Beyond the Windshield';
const description =
  'A one-minute image shrine beyond the automobile: ten works gathered into wayside psalms and an inner chorus, one breath at a time.';

const passages = [
  {
    id: 'wayside',
    numeral: 'I',
    name: 'Wayside Psalms',
    detail: 'five outward stations',
    stations: [
      {
        id: 'mountain',
        title: 'Mountain',
        image: mountainScore,
        alt: 'Snow-covered mountain rising through gray foothills beneath dense handwritten sheet music, all enclosed by a woven floral border.',
        caption: 'The high place keeps its own measure.',
        notice: 'Notice what remains still beneath all that moves.',
        release: 'Release the need to reach the summit.',
      },
      {
        id: 'pilgrim',
        title: 'Pilgrim',
        image: cloudWalker,
        alt: 'Small guitarist walking along a blue roadside beneath a towering peach cloud and a line of printed musical notes.',
        caption: 'A song can be a form of walking.',
        notice: 'Notice the small traveler beneath the enormous sky.',
        release: 'Release the distance still to go.',
      },
      {
        id: 'city',
        title: 'City',
        image: cityKeyboard,
        alt: 'Weathered ivory, black, sage, and rust collage arranged above an oversized row of piano keys.',
        caption: 'Even the city has a hidden keyboard.',
        notice: 'Notice the rhythm inside the worn walls.',
        release: 'Release the noise that is not yours.',
      },
      {
        id: 'weather',
        title: 'Weather',
        image: greenWeather,
        alt: 'Abstract field of navy ink, luminous green, blue-gray, white, and ochre brushwork on cream paper.',
        caption: 'Weather passes. The field receives it.',
        notice: 'Notice where the dark opens into green.',
        release: 'Release the wish to hold the sky in place.',
      },
      {
        id: 'field',
        title: 'Field',
        image: ochreField,
        alt: 'Ochre and muted-green halftone landscape with dark hills, a round textured moon, and musical notes crossing the sky.',
        caption: 'The field hums after the road is gone.',
        notice: 'Notice the round moon resting over the low hills.',
        release: 'Release the name of every passing thing.',
      },
    ],
  },
  {
    id: 'chorus',
    numeral: 'II',
    name: 'Inner Chorus',
    detail: 'five inward stations',
    stations: [
      {
        id: 'listening',
        title: 'Listening',
        image: listeningFace,
        alt: 'Grainy monochrome portrait of a woman beside a large looping headphone form, layered over fragments of musical staves.',
        caption: 'Listening begins before the first note.',
        notice: 'Notice how the face meets what cannot be seen.',
        release: 'Release the answer you were preparing.',
      },
      {
        id: 'voice',
        title: 'Voice',
        image: quietVoice,
        alt: 'Stylized portrait of a woman wearing large headphones amid black musical notes and fine teal, cream, and pink lines.',
        caption: 'The quiet voice is still a voice.',
        notice: 'Notice the breath just before sound.',
        release: 'Release the need to be understood at once.',
      },
      {
        id: 'memory',
        title: 'Memory',
        image: moonPortrait,
        alt: 'Black-and-white painterly portrait of a woman, half in shadow, surrounded by collaged fragments of sheet music.',
        caption: 'Memory edits in charcoal and light.',
        notice: 'Notice which half of the face comes forward.',
        release: 'Release the version that no longer needs you.',
      },
      {
        id: 'signal',
        title: 'Signal',
        image: signalHead,
        alt: 'Pale portrait with closed eyes, one side veiled by black and gray brushwork, printed music, and a single orange mark.',
        caption: 'A signal arrives when the eyes grow quiet.',
        notice: 'Notice the bright mark inside the unfinished score.',
        release: 'Release the demand for certainty.',
      },
      {
        id: 'storm',
        title: 'Storm',
        image: inkStorm,
        alt: 'Black-and-cream collage of a curling abstract storm around a pale circular center, with sheet music and small crowds at the edges.',
        caption: 'At the center of the storm, a round silence.',
        notice: 'Notice the still circle inside the breaking ink.',
        release: 'Release what the storm has already carried away.',
      },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v3',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={mountainScore.src}
  jsonLd={jsonLd}
>
  <section
    class="or3"
    id="open-road-v3-shrine"
    aria-labelledby="or3-title"
    data-state="idle"
    data-phase="rest"
    data-passage="wayside"
    data-station="0"
  >
    <span class="or3__dove" id="or3-dove" aria-hidden="true">🕊︎</span>

    <nav class="or3__wayfinding" aria-label="Open Road editions">
      <a href="/" aria-label="Return to PointCast home"><span aria-hidden="true">←</span> PointCast</a>
      <span aria-hidden="true">·</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <span aria-current="page">III</span>
    </nav>

    <div class="or3__chapel">
      <header class="or3__header">
        <div class="or3__edition" aria-hidden="true"><span>III</span></div>
        <div>
          <p class="or3__eyebrow">Open Road III · Beyond the Windshield</p>
          <h1 id="or3-title">The road was never only the car.</h1>
        </div>
      </header>

      <div class="or3__cinema">
        <figure class="or3__window" aria-labelledby="or3-station-title or3-caption">
          <div class="or3__screen">
            {passages.map((passage, passageIndex) =>
              passage.stations.map((station, stationIndex) => (
                <div
                  class:list={[
                    'or3__plate',
                    { 'is-active': passageIndex === 0 && stationIndex === 0 },
                  ]}
                  data-plate
                  data-passage={passage.id}
                  data-station={stationIndex}
                  data-title={station.title}
                  data-caption={station.caption}
                  data-notice={station.notice}
                  data-release={station.release}
                  aria-hidden={passageIndex === 0 && stationIndex === 0 ? 'false' : 'true'}
                >
                  <img
                    src={station.image.src}
                    alt={station.alt}
                    width={station.image.width}
                    height={station.image.height}
                    loading={passageIndex === 0 && stationIndex === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={passageIndex === 0 && stationIndex === 0 ? 'high' : 'auto'}
                  />
                </div>
              ))
            )}
            <span class="or3__veil" aria-hidden="true"></span>
            <span class="or3__window-mark" aria-hidden="true"></span>
            <span class="or3__counter" id="or3-counter" aria-hidden="true">I · 1 / 5</span>
          </div>
          <figcaption id="or3-caption">The high place keeps its own measure.</figcaption>
        </figure>

        <aside class="or3__rail" aria-label="Meditation liturgy">
          <div class="or3__passages" role="group" aria-label="Choose a passage">
            {passages.map((passage, passageIndex) => (
              <button
                type="button"
                class:list={['or3__passage', { 'is-active': passageIndex === 0 }]}
                data-passage-select={passage.id}
                aria-pressed={passageIndex === 0 ? 'true' : 'false'}
              >
                <span>{passage.numeral}</span>
                <strong>{passage.name}</strong>
                <small>{passage.detail}</small>
              </button>
            ))}
          </div>

          <div class="or3__station-head">
            <p>Station</p>
            <h2 id="or3-station-title">Mountain</h2>
          </div>

          <div class="or3__stations" role="group" aria-label="Choose a station">
            {passages.map((passage) =>
              passage.stations.map((station, stationIndex) => (
                <button
                  type="button"
                  class:list={[
                    'or3__station',
                    { 'is-active': passage.id === 'wayside' && stationIndex === 0 },
                  ]}
                  data-station-select={stationIndex}
                  data-station-passage={passage.id}
                  aria-label={(stationIndex + 1) + '. ' + station.title}
                  aria-pressed={passage.id === 'wayside' && stationIndex === 0 ? 'true' : 'false'}
                  hidden={passage.id !== 'wayside'}
                >
                  <span>{stationIndex + 1}</span>
                </button>
              ))
            )}
          </div>

          <div class="or3__liturgy">
            <div class="or3__line or3__line--notice">
              <p>Notice</p>
              <blockquote id="or3-notice">Notice what remains still beneath all that moves.</blockquote>
            </div>
            <div class="or3__line or3__line--release">
              <p>Release</p>
              <blockquote id="or3-release">Release the need to reach the summit.</blockquote>
            </div>
          </div>

          <div class="or3__breath">
            <p class="or3__cue" id="or3-cue">Choose a passage, then sit for one minute.</p>
            <div class="or3__progress" aria-hidden="true"><span id="or3-progress"></span></div>
            <div class="or3__measures" aria-hidden="true">
              <span class="or3__measure"></span>
              <span class="or3__measure"></span>
              <span class="or3__measure"></span>
              <span class="or3__measure"></span>
              <span class="or3__measure"></span>
            </div>
          </div>

          <p class="sr-only" id="or3-cadence">
            During stillness, receive for five seconds and release for seven seconds. Each complete breath reveals the next image.
          </p>

          <div class="or3__controls" role="group" aria-label="Shrine controls">
            <button
              class="or3__button or3__button--enter"
              id="or3-enter"
              type="button"
              aria-describedby="or3-cadence"
            >Begin stillness</button>
            <button
              class="or3__button or3__button--offer"
              id="or3-offer"
              type="button"
              aria-pressed="false"
            ><span class="or3__star" id="or3-star" aria-hidden="true">✦</span> Offer silence</button>
          </div>
        </aside>
      </div>

      <footer class="or3__footer">
        <p>Ten images from the artist’s archive, looking beyond the car.</p>
        <p aria-hidden="true">← → browse · esc leave stillness</p>
      </footer>

      <p class="or3__status sr-only" id="or3-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>
</BlockLayout>

<style is:global>
  body:has(#open-road-v3-shrine) {
    --or3-ink: #071423;
    --or3-ink-deep: #030a12;
    --or3-paper: #eee9da;
    --or3-paper-dim: #a9afad;
    --or3-light: #d5bd79;
    --or3-coral: #b96250;
    margin: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    background: var(--or3-ink-deep);
  }

  body:has(#open-road-v3-shrine) #pc-fb,
  body:has(#open-road-v3-shrine) #pc-spell-layer,
  body:has(#open-road-v3-shrine) #cursor-room,
  body:has(#open-road-v3-shrine) #pc-freshness,
  body:has(#open-road-v3-shrine) #pc-first-see {
    display: none !important;
  }

  body:has(#open-road-v3-shrine) #main-content {
    min-width: 0;
  }

  html.cr-cursor-active body:has(#open-road-v3-shrine),
  html.cr-cursor-active body:has(#open-road-v3-shrine) #main-content,
  html.cr-cursor-active body:has(#open-road-v3-shrine) #main-content * {
    cursor: auto !important;
  }

  html.cr-cursor-active body:has(#open-road-v3-shrine) a,
  html.cr-cursor-active body:has(#open-road-v3-shrine) button {
    cursor: pointer !important;
  }

  html.cr-cursor-active body:has(#open-road-v3-shrine) button:disabled {
    cursor: default !important;
  }

  .or3,
  .or3 * {
    box-sizing: border-box;
  }

  .or3 {
    min-height: 100svh;
    min-height: 100dvh;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(72px, 9vh, 112px) clamp(18px, 4vw, 64px) clamp(34px, 5vh, 64px);
    color: var(--or3-paper);
    background:
      radial-gradient(circle at 72% 38%, rgba(213, 189, 121, 0.08), transparent 27%),
      radial-gradient(circle at 9% 84%, rgba(185, 98, 80, 0.09), transparent 31%),
      linear-gradient(112deg, #030a12 0%, var(--or3-ink) 52%, #0b1b2e 100%);
    font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
    transition: background 900ms ease;
  }

  .or3[data-passage='chorus'] {
    --or3-light: #c6b5aa;
    --or3-coral: #cf725f;
    background:
      radial-gradient(circle at 73% 36%, rgba(207, 114, 95, 0.09), transparent 28%),
      radial-gradient(circle at 12% 82%, rgba(198, 181, 170, 0.07), transparent 30%),
      linear-gradient(112deg, #05090f 0%, #101726 54%, #171b28 100%);
  }

  .or3::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.22;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, transparent 0 49.8%, rgba(238, 233, 218, 0.06) 50%, transparent 50.2%),
      repeating-linear-gradient(0deg, transparent 0 47px, rgba(238, 233, 218, 0.025) 48px);
    background-size: 100% 100%, 100% 48px;
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
  }

  .or3::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 6vw;
    top: 18vh;
    width: 1px;
    height: 58vh;
    opacity: 0.48;
    pointer-events: none;
    background: linear-gradient(transparent, var(--or3-light), transparent);
    box-shadow: calc(88vw - 1px) 0 0 rgba(213, 189, 121, 0.18);
  }

  .or3__dove {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .or3__dove {
      position: fixed;
      z-index: 40;
      left: 0;
      top: 0;
      display: block;
      color: #fff9df;
      font-family: 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif;
      font-size: 19px;
      line-height: 1;
      opacity: 0;
      pointer-events: none;
      text-shadow: 0 2px 10px rgba(3, 10, 18, 0.92), 0 0 14px rgba(213, 189, 121, 0.2);
      transform: translate3d(-40px, -40px, 0);
      transition: opacity 200ms ease;
      will-change: transform;
    }

    .or3__dove.is-visible {
      opacity: 0.76;
    }
  }

  .or3__wayfinding {
    position: absolute;
    z-index: 6;
    top: clamp(16px, 2.4vw, 30px);
    left: clamp(12px, 2.6vw, 36px);
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(238, 233, 218, 0.42);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .or3__wayfinding a,
  .or3__wayfinding span {
    min-width: 20px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .or3__wayfinding a:first-child {
    justify-content: flex-start;
  }

  .or3__wayfinding a:hover,
  .or3__wayfinding a:focus-visible,
  .or3__wayfinding [aria-current='page'] {
    color: var(--or3-paper);
  }

  .or3__chapel {
    width: min(100%, 1240px);
    margin: 0 auto;
  }

  .or3__header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 clamp(24px, 4vh, 42px);
  }

  .or3__edition {
    width: 48px;
    height: 59px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: 1px solid rgba(213, 189, 121, 0.5);
    color: var(--or3-light);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 15px;
    font-style: italic;
    clip-path: polygon(50% 0, 100% 16%, 100% 84%, 50% 100%, 0 84%, 0 16%);
  }

  .or3__eyebrow,
  .or3__station-head p,
  .or3__line > p {
    margin: 0 0 6px;
    color: rgba(238, 233, 218, 0.47);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .or3__header h1 {
    margin: 0;
    max-width: 780px;
    color: var(--or3-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(27px, 4vw, 54px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }

  .or3__cinema {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(294px, 0.43fr);
    gap: clamp(30px, 5.4vw, 84px);
    align-items: center;
  }

  .or3__window {
    min-width: 0;
    margin: 0;
  }

  .or3__screen {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(238, 233, 218, 0.34);
    background: #c5c1b4;
    box-shadow:
      0 0 0 12px rgba(3, 10, 18, 0.72),
      0 0 0 13px rgba(213, 189, 121, 0.26),
      0 36px 90px rgba(0, 0, 0, 0.46);
  }

  .or3__screen::before,
  .or3__screen::after {
    content: '';
    position: absolute;
    z-index: 6;
    pointer-events: none;
  }

  .or3__screen::before {
    inset: 0;
    box-shadow: inset 0 0 100px rgba(3, 10, 18, 0.36);
  }

  .or3__screen::after {
    left: 50%;
    top: 7%;
    bottom: 7%;
    width: 1px;
    opacity: 0.12;
    background: var(--or3-paper);
  }

  .or3__plate {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: scale(1.018);
    transition:
      opacity 1050ms ease,
      transform 12s ease,
      visibility 0s linear 1050ms;
  }

  .or3__plate.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  .or3__plate img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .or3[data-state='sitting'] .or3__plate.is-active {
    animation: or3-drift 12s ease-in-out infinite alternate;
  }

  .or3__veil {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.26;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgba(3, 10, 18, 0.1), rgba(7, 20, 35, 0.55)),
      radial-gradient(circle at 42% 38%, transparent 0 25%, rgba(5, 15, 27, 0.27) 72%);
    mix-blend-mode: multiply;
    transition: opacity 2s ease;
  }

  .or3[data-state='sitting'][data-phase='receive'] .or3__veil {
    opacity: 0.05;
  }

  .or3[data-state='sitting'][data-phase='release'] .or3__veil {
    opacity: 0.34;
  }

  .or3__window-mark {
    position: absolute;
    z-index: 7;
    left: 16px;
    top: 16px;
    width: 9px;
    height: 9px;
    border: 1px solid rgba(255, 250, 226, 0.78);
    border-radius: 50%;
    opacity: 0.62;
    box-shadow: 0 0 18px rgba(213, 189, 121, 0.42);
  }

  .or3__counter {
    position: absolute;
    z-index: 7;
    right: 12px;
    bottom: 11px;
    padding: 5px 7px;
    color: rgba(255, 252, 235, 0.9);
    background: rgba(3, 10, 18, 0.68);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .or3__window figcaption {
    min-height: 20px;
    margin-top: 17px;
    color: rgba(238, 233, 218, 0.56);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 12px;
    font-style: italic;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .or3__rail {
    min-width: 0;
    display: grid;
    gap: clamp(17px, 2.2vh, 25px);
    position: relative;
    padding: clamp(20px, 3vw, 36px) 0 clamp(20px, 3vw, 36px) clamp(22px, 3.8vw, 54px);
    border-left: 1px solid rgba(213, 189, 121, 0.22);
  }

  .or3__rail::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 18%;
    width: 1px;
    height: 42%;
    background: linear-gradient(transparent, var(--or3-light), transparent);
    box-shadow: 0 0 18px rgba(213, 189, 121, 0.24);
  }

  .or3__passages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(238, 233, 218, 0.14);
    border-bottom: 1px solid rgba(238, 233, 218, 0.14);
  }

  .or3__passage {
    min-width: 0;
    min-height: 72px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: center;
    column-gap: 8px;
    border: 0;
    border-right: 1px solid rgba(238, 233, 218, 0.14);
    padding: 10px 8px;
    color: rgba(238, 233, 218, 0.46);
    background: transparent;
    text-align: left;
    transition: color 240ms ease, background-color 240ms ease;
  }

  .or3__passage:last-child {
    border-right: 0;
  }

  .or3__passage > span {
    grid-row: 1 / 3;
    align-self: center;
    color: var(--or3-light);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 15px;
    font-style: italic;
  }

  .or3__passage strong {
    overflow: hidden;
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.1;
    text-overflow: ellipsis;
  }

  .or3__passage small {
    overflow: hidden;
    color: rgba(238, 233, 218, 0.34);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 7px;
    letter-spacing: 0.07em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .or3__passage:hover,
  .or3__passage:focus-visible,
  .or3__passage.is-active {
    color: var(--or3-paper);
    background: rgba(238, 233, 218, 0.035);
  }

  .or3__passage:disabled {
    color: rgba(238, 233, 218, 0.25);
  }

  .or3__station-head h2 {
    margin: 0;
    color: var(--or3-paper);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.95;
  }

  .or3__stations {
    display: grid;
    grid-template-columns: repeat(5, minmax(44px, 1fr));
    gap: 7px;
  }

  .or3__station {
    min-width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(238, 233, 218, 0.18);
    border-radius: 2px;
    color: rgba(238, 233, 218, 0.5);
    background: transparent;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    transition: color 220ms ease, border-color 220ms ease, background-color 220ms ease;
  }

  .or3__station[hidden] {
    display: none;
  }

  .or3__station:hover,
  .or3__station:focus-visible {
    color: var(--or3-paper);
    border-color: rgba(238, 233, 218, 0.52);
  }

  .or3__station.is-active {
    color: var(--or3-ink-deep);
    border-color: var(--or3-light);
    background: var(--or3-light);
  }

  .or3__station:disabled {
    opacity: 0.42;
  }

  .or3__liturgy {
    display: grid;
    gap: 14px;
    padding: 17px 0;
    border-top: 1px solid rgba(238, 233, 218, 0.12);
    border-bottom: 1px solid rgba(238, 233, 218, 0.12);
  }

  .or3__line {
    padding-left: 12px;
    border-left: 2px solid rgba(238, 233, 218, 0.08);
    transition: border-color 900ms ease, opacity 900ms ease;
  }

  .or3__line blockquote {
    margin: 0;
    color: rgba(238, 233, 218, 0.74);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(15px, 1.7vw, 20px);
    line-height: 1.28;
  }

  .or3[data-state='sitting'] .or3__line {
    opacity: 0.38;
  }

  .or3[data-state='sitting'][data-phase='receive'] .or3__line--notice,
  .or3[data-state='sitting'][data-phase='release'] .or3__line--release {
    opacity: 1;
    border-left-color: var(--or3-light);
  }

  .or3__breath {
    display: grid;
    gap: 9px;
  }

  .or3__cue {
    min-height: 14px;
    margin: 0;
    color: rgba(238, 233, 218, 0.53);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .or3[data-state='sitting'][data-phase='receive'] .or3__cue {
    color: var(--or3-paper);
  }

  .or3[data-state='sitting'][data-phase='release'] .or3__cue {
    color: var(--or3-light);
  }

  .or3__progress {
    height: 1px;
    overflow: hidden;
    background: rgba(238, 233, 218, 0.13);
  }

  .or3__progress span {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--or3-light);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .or3__measures {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 7px;
  }

  .or3__measure {
    height: 2px;
    background: rgba(238, 233, 218, 0.12);
    transition: background-color 300ms ease;
  }

  .or3__measure.is-passed {
    background: color-mix(in srgb, var(--or3-light) 78%, var(--or3-paper));
  }

  .or3__controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .or3__button {
    min-height: 44px;
    border: 0;
    border-bottom: 1px solid rgba(213, 189, 121, 0.5);
    padding: 8px 0;
    color: rgba(238, 233, 218, 0.72);
    background: transparent;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 220ms ease, border-color 220ms ease;
  }

  .or3__button:hover,
  .or3__button:focus-visible {
    color: var(--or3-paper);
    border-bottom-color: var(--or3-light);
  }

  .or3__button:disabled {
    color: rgba(238, 233, 218, 0.42);
    border-bottom-color: rgba(213, 189, 121, 0.18);
  }

  .or3__star {
    display: inline-block;
    margin-right: 5px;
    color: rgba(238, 233, 218, 0.28);
    transform: scale(0.82);
    transition: color 500ms ease, transform 500ms ease, text-shadow 500ms ease;
  }

  .or3__star.is-lit {
    color: #f2d985;
    text-shadow: 0 0 10px rgba(242, 217, 133, 0.54);
    transform: scale(1);
  }

  .or3__footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: clamp(24px, 4vh, 42px);
    color: rgba(238, 233, 218, 0.35);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .or3__footer p {
    margin: 0;
  }

  .or3[data-state='sitting'] .or3__header,
  .or3[data-state='sitting'] .or3__passages,
  .or3[data-state='sitting'] .or3__window figcaption,
  .or3[data-state='sitting'] .or3__footer,
  .or3[data-state='sitting'] .or3__button--offer {
    opacity: 0.42;
  }

  .or3[data-paused='true'] *,
  .or3[data-paused='true'] *::before,
  .or3[data-paused='true'] *::after {
    animation-play-state: paused !important;
  }

  .or3__passage:focus-visible,
  .or3__station:focus-visible,
  .or3__button:focus-visible,
  .or3__wayfinding a:focus-visible {
    outline: 1px solid var(--or3-light);
    outline-offset: 4px;
  }

  @keyframes or3-drift {
    from { transform: scale(1); }
    to { transform: scale(1.018); }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 920px) {
    .or3__cinema {
      grid-template-columns: 1fr;
      width: min(100%, 680px);
      margin: 0 auto;
      gap: 30px;
    }

    .or3__rail {
      padding: 28px 0 0;
      border-top: 1px solid rgba(213, 189, 121, 0.22);
      border-left: 0;
    }

    .or3__rail::before {
      left: 24%;
      top: -1px;
      width: 52%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--or3-light), transparent);
    }

    .or3__footer {
      justify-content: center;
      text-align: center;
    }

    .or3__footer p:last-child {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .or3 {
      padding: 70px 14px 32px;
    }

    .or3::after {
      display: none;
    }

    .or3__wayfinding {
      left: 8px;
      gap: 7px;
      font-size: 9px;
    }

    .or3__header {
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 24px;
    }

    .or3__edition {
      width: 39px;
      height: 47px;
    }

    .or3__eyebrow {
      letter-spacing: 0.12em;
      line-height: 1.45;
    }

    .or3__screen {
      box-shadow:
        0 0 0 6px rgba(3, 10, 18, 0.72),
        0 0 0 7px rgba(213, 189, 121, 0.24),
        0 24px 64px rgba(0, 0, 0, 0.42);
    }

    .or3__passage small {
      display: none;
    }

    .or3__passage {
      min-height: 64px;
      padding-inline: 7px;
    }

    .or3__stations {
      gap: 5px;
    }

    .or3__rail {
      gap: 19px;
    }

    .or3__controls {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .or3 *,
    .or3 *::before,
    .or3 *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    .or3__plate,
    .or3__plate.is-active {
      transform: none;
    }
  }
</style>

<script>
  const shrine = document.getElementById('open-road-v3-shrine');
  const enterButton = document.getElementById('or3-enter');
  const offerButton = document.getElementById('or3-offer');
  const star = document.getElementById('or3-star');
  const cue = document.getElementById('or3-cue');
  const progress = document.getElementById('or3-progress');
  const stationTitle = document.getElementById('or3-station-title');
  const caption = document.getElementById('or3-caption');
  const counter = document.getElementById('or3-counter');
  const notice = document.getElementById('or3-notice');
  const release = document.getElementById('or3-release');
  const status = document.getElementById('or3-status');
  const dove = document.getElementById('or3-dove');
  const plates = Array.from(document.querySelectorAll('#open-road-v3-shrine [data-plate]'));
  const passageButtons = Array.from(document.querySelectorAll('#open-road-v3-shrine [data-passage-select]'));
  const stationButtons = Array.from(document.querySelectorAll('#open-road-v3-shrine [data-station-select]'));
  const measureMarkers = Array.from(document.querySelectorAll('#open-road-v3-shrine .or3__measure'));

  if (
    shrine instanceof HTMLElement &&
    enterButton instanceof HTMLButtonElement &&
    offerButton instanceof HTMLButtonElement &&
    star instanceof HTMLElement &&
    cue instanceof HTMLElement &&
    progress instanceof HTMLElement &&
    stationTitle instanceof HTMLElement &&
    caption instanceof HTMLElement &&
    counter instanceof HTMLElement &&
    notice instanceof HTMLElement &&
    release instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const SIT_DURATION = 60_000;
    const RECEIVE_DURATION = 5_000;
    const RELEASE_DURATION = 7_000;
    const BREATH_DURATION = RECEIVE_DURATION + RELEASE_DURATION;
    const SILENCE_STORAGE_KEY = 'pc:open-road-v3:silence';

    let state = 'idle';
    let currentPassage = 'wayside';
    let currentStation = 0;
    let accumulated = 0;
    let lastResumedAt = 0;
    let animationFrame = 0;
    let visiblePhase = 'rest';

    const activeStationButtons = () =>
      stationButtons.filter((button) =>
        button instanceof HTMLButtonElement && button.dataset.stationPassage === currentPassage
      );

    const setProgress = (value) => {
      const bounded = Math.min(1, Math.max(0, value));
      progress.style.transform = 'scaleX(' + bounded + ')';
    };

    const setMeasures = (elapsed) => {
      const passed = Math.min(measureMarkers.length, Math.floor(elapsed / BREATH_DURATION));
      measureMarkers.forEach((marker, index) => {
        marker.classList.toggle('is-passed', index < passed);
      });
    };

    const selectedPlate = () =>
      plates.find((plate) =>
        plate instanceof HTMLElement &&
        plate.dataset.passage === currentPassage &&
        Number(plate.dataset.station) === currentStation
      );

    const setStation = (nextStation, announce = false) => {
      currentStation = Math.min(4, Math.max(0, nextStation));
      shrine.dataset.station = String(currentStation);

      plates.forEach((plate) => {
        if (!(plate instanceof HTMLElement)) return;
        const active =
          plate.dataset.passage === currentPassage &&
          Number(plate.dataset.station) === currentStation;
        plate.classList.toggle('is-active', active);
        plate.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      stationButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const inPassage = button.dataset.stationPassage === currentPassage;
        const active = inPassage && Number(button.dataset.stationSelect) === currentStation;
        button.hidden = !inPassage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      const plate = selectedPlate();
      if (plate instanceof HTMLElement) {
        const title = plate.dataset.title || 'Station';
        stationTitle.textContent = title;
        caption.textContent = plate.dataset.caption || '';
        notice.textContent = plate.dataset.notice || '';
        release.textContent = plate.dataset.release || '';
        counter.textContent =
          (currentPassage === 'wayside' ? 'I' : 'II') +
          ' · ' +
          (currentStation + 1) +
          ' / 5';
        if (announce) status.textContent = 'Station ' + (currentStation + 1) + ': ' + title + '.';
      }
    };

    const setPassage = (nextPassage, announce = true) => {
      currentPassage = nextPassage === 'chorus' ? 'chorus' : 'wayside';
      shrine.dataset.passage = currentPassage;
      passageButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const active = button.dataset.passageSelect === currentPassage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      setStation(0);
      if (announce) {
        status.textContent =
          currentPassage === 'wayside'
            ? 'Wayside Psalms selected. Five outward stations.'
            : 'Inner Chorus selected. Five inward stations.';
      }
    };

    const setSelectorsDisabled = (disabled) => {
      passageButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
      stationButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = disabled;
      });
    };

    const setPhase = (nextPhase) => {
      if (visiblePhase === nextPhase) return;
      visiblePhase = nextPhase;
      shrine.dataset.phase = nextPhase;
      cue.textContent = nextPhase === 'receive' ? 'Receive · notice what arrives' : 'Release · let it pass';
    };

    const reset = (announce = true) => {
      cancelAnimationFrame(animationFrame);
      state = 'idle';
      accumulated = 0;
      visiblePhase = 'rest';
      shrine.dataset.state = 'idle';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      setSelectorsDisabled(false);
      setStation(currentStation);
      cue.textContent = 'Choose a passage, then sit for one minute.';
      enterButton.textContent = 'Begin stillness';
      setProgress(0);
      setMeasures(0);
      if (announce) status.textContent = 'Stillness ended.';
    };

    const complete = () => {
      cancelAnimationFrame(animationFrame);
      state = 'complete';
      accumulated = SIT_DURATION;
      visiblePhase = 'rest';
      shrine.dataset.state = 'complete';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      setSelectorsDisabled(false);
      notice.textContent = 'Notice the room that one quiet minute has made.';
      release.textContent = 'Release the road. Keep the listening.';
      cue.textContent = 'The road continues beyond the frame.';
      enterButton.textContent = 'Sit again';
      setProgress(1);
      setMeasures(SIT_DURATION);
      status.textContent = 'One minute complete. The road continues beyond the frame.';
    };

    const tick = (now) => {
      if (state !== 'sitting' || document.hidden) return;
      const elapsed = accumulated + (now - lastResumedAt);
      setProgress(elapsed / SIT_DURATION);
      setMeasures(elapsed);

      const nextStation = Math.min(4, Math.floor(elapsed / BREATH_DURATION));
      if (nextStation !== currentStation) setStation(nextStation);

      const breathPosition = elapsed % BREATH_DURATION;
      setPhase(breathPosition < RECEIVE_DURATION ? 'receive' : 'release');

      if (elapsed >= SIT_DURATION) {
        complete();
        return;
      }

      animationFrame = requestAnimationFrame(tick);
    };

    const start = () => {
      cancelAnimationFrame(animationFrame);
      state = 'sitting';
      accumulated = 0;
      lastResumedAt = performance.now();
      visiblePhase = 'receive';
      shrine.dataset.state = 'sitting';
      shrine.dataset.phase = 'receive';
      delete shrine.dataset.paused;
      setSelectorsDisabled(true);
      setStation(0);
      cue.textContent = 'Receive · notice what arrives';
      enterButton.textContent = 'Leave stillness';
      setProgress(0);
      setMeasures(0);
      status.textContent = 'One minute of stillness has begun.';
      animationFrame = requestAnimationFrame(tick);
    };

    passageButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (state === 'complete') reset(false);
        setPassage(button.dataset.passageSelect || 'wayside');
      });
    });

    stationButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (state === 'complete') reset(false);
        setStation(Number(button.dataset.stationSelect), true);
      });
    });

    enterButton.addEventListener('click', () => {
      if (state === 'sitting') reset();
      else start();
    });

    const offerSilence = (announce = true) => {
      star.classList.add('is-lit');
      offerButton.innerHTML = '<span class="or3__star is-lit" aria-hidden="true">✦</span> Silence offered';
      offerButton.setAttribute('aria-pressed', 'true');
      offerButton.disabled = true;
      if (announce) status.textContent = 'Your silence is offered.';
    };

    try {
      if (sessionStorage.getItem(SILENCE_STORAGE_KEY) === '1') offerSilence(false);
    } catch {
      // The offering remains available when storage is unavailable.
    }

    offerButton.addEventListener('click', () => {
      offerSilence();
      try {
        sessionStorage.setItem(SILENCE_STORAGE_KEY, '1');
      } catch {
        // Keep the offering on this page when storage is unavailable.
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && state === 'sitting') {
        reset();
        enterButton.focus();
        return;
      }

      if (
        state !== 'sitting' &&
        (event.key === 'ArrowLeft' || event.key === 'ArrowRight') &&
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)
      ) {
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        setStation((currentStation + direction + 5) % 5, true);
        const buttons = activeStationButtons();
        const selected = buttons[currentStation];
        if (selected instanceof HTMLButtonElement) selected.focus();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (state !== 'sitting') return;

      if (document.hidden) {
        accumulated += performance.now() - lastResumedAt;
        shrine.dataset.paused = 'true';
        cancelAnimationFrame(animationFrame);
        return;
      }

      lastResumedAt = performance.now();
      delete shrine.dataset.paused;
      animationFrame = requestAnimationFrame(tick);
    });

    if (
      dove instanceof HTMLElement &&
      window.matchMedia('(hover: hover) and (pointer: fine)').matches
    ) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let targetX = -40;
      let targetY = -40;
      let currentX = -40;
      let currentY = -40;
      let doveFrame = 0;

      const placeDove = () => {
        const ease = reduceMotion ? 1 : 0.2;
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        dove.style.transform = 'translate3d(' + currentX + 'px, ' + currentY + 'px, 0)';

        if (Math.abs(targetX - currentX) > 0.2 || Math.abs(targetY - currentY) > 0.2) {
          doveFrame = requestAnimationFrame(placeDove);
        } else {
          doveFrame = 0;
        }
      };

      window.addEventListener(
        'pointermove',
        (event) => {
          targetX = event.clientX + 13;
          targetY = event.clientY - 19;
          dove.classList.add('is-visible');
          if (!doveFrame) doveFrame = requestAnimationFrame(placeDove);
        },
        { passive: true }
      );

      window.addEventListener('mouseout', (event) => {
        if (!event.relatedTarget) dove.classList.remove('is-visible');
      });
    }
  }
</script>
