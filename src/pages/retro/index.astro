---
import RetroShell from '../../components/retro/RetroShell.astro';
import RetroArt from '../../components/retro/RetroArt.astro';
import {experiences} from '../../lib/retro-catalog.mjs';
---
<RetroShell><div class="grid">{experiences.map((x,i)=><article class="tile" style={`--accent:${x.color}`}><span class="number">{x.number} / {x.tag}</span><RetroArt variant={i}/><h2>{x.short}</h2><p>{x.description}</p><a class="action" href={`/retro/${x.id}/`}>Enter room →</a></article>)}</div><p class="notice">All six doors use the same published catalog. Keep a reading tape or private note for this visit; saving on your device is optional. The existing BBS, games and art keep their own addresses.</p></RetroShell>
