---
import RetroShell from '../../components/retro/RetroShell.astro';
import RetroArt from '../../components/retro/RetroArt.astro';
import {experiences,channels,teletextPages,normalizeProjects,roomProjects} from '../../lib/retro-catalog.mjs';
import registry from '../../data/home-latest-projects.json';
export function getStaticPaths(){return experiences.map(experience=>({params:{room:experience.id},props:{experience}}));}
const {experience}=Astro.props;
const room=experience.id;
const projects=roomProjects(normalizeProjects(registry),room);
const animation=channels.filter(c=>projects.some(p=>p.href.replace(/\/$/,'')===c.href.replace(/\/$/,'')));
const content=JSON.stringify({projects,channels:animation,teletextPages}).replace(/</g,'\\u003c');
---
<RetroShell room={room} {...experience}>
{room==='teletext'&&<><form class="toolbar" id="page-form"><label>Page number<input id="page-number" inputmode="numeric" pattern="10[0-5]" value="100" maxlength="3" aria-describedby="page-help"/></label><button>Go to page</button><p id="page-help">100–105. Choose a number or a desk below.</p></form><nav class="toolbar" aria-label="Teletext desks">{teletextPages.map(p=><a class="action" href={`#p${p.number}`} data-page={p.number}>{p.number} {p.title}</a>)}</nav><section class="screen" aria-live="polite"><p class="eyebrow" id="page-status">POINTCAST / P100</p><h2 id="page-title">Index</h2><p id="page-note">A directory of published PointCast destinations. Page numbers are addresses, not a live data feed.</p><div id="teletext-results">{projects.map(p=><div class="line"><a href={p.href}>{p.title} →</a></div>)}</div></section></>}
{room==='saturday-morning'&&<><div class="station"><div class="bumper"><RetroArt variant={1}/><strong id="bumper-title">SUNRISE SIGNAL</strong><p>POINTCAST / ORIGINAL STATION BUMPER</p></div><section class="screen"><p class="eyebrow" id="channel-number">CHANNEL 201</p><h2 id="channel-title">Saturday reading</h2><p id="channel-note">Choose a published animation reading.</p>{animation.length>0?<a id="channel-start" class="action" href={animation[0].href}>Read this channel →</a>:<a id="channel-start" class="action" href="/retro/">Return to directory →</a>}<div class="toolbar"><button id="channel-prev" aria-label="Previous channel">←</button><button id="channel-next" aria-label="Next channel">→</button></div><label>Channel dial <select id="channel-dial">{animation.map(c=><option value={c.number}>{c.number} / {c.title}</option>)}</select></label></section></div><p class="notice">Silent, static station bumpers are original PointCast art. These channels open histories and criticism, with no clips or automatic sound. Turn the dial at your own pace.</p><div class="grid">{animation.map(c=><article class="tile"><span class="number">{c.number}</span><h2>{c.title}</h2><p>{c.note}</p><a href={c.href}>Read history →</a></article>)}</div></>}
{room==='mixtape'&&<><p class="mixtape-explainer">A playlist of pages, not an audio player. Choose up to twelve readings or art projects; the first six fill Side A and the rest fill Side B.</p><div class="toolbar"><button id="print-tape">Print cassette insert</button><button id="export-tape">Export reading tape</button><button id="clear-tape">Clear tape</button></div><label class="no-print" id="export-label" for="tape-export" hidden>Reading tape export (copyable text)</label><textarea class="no-print" id="tape-export" readonly rows="8" hidden></textarea><div class="tape"><h2>POINTCAST / READING TAPE</h2><div class="tape-windows" aria-hidden="true"><div class="reel"></div><div class="reel"></div></div><div id="tape-tracks"></div></div><section class="insert" aria-label="Printable cassette insert"><h2>PointCast / My reading tape</h2><div class="sides"><div><h3>Side A</h3><ol id="side-a"></ol></div><div><h3>Side B</h3><ol id="side-b"></ol></div></div><p>Read • look • return / pointcast.xyz</p></section></>}
{room==='bbs'&&<><p class="notice">LOCAL TERMINAL. Notes and challenge completions belong to this browser only. They are never posted to a shared guestbook or sent to a server. The original BBS remains its own room.</p><section class="screen"><p class="eyebrow">DAILY CHALLENGE / UTC</p><h2 id="challenge-day">Today’s small task</h2><p id="challenge-text">Open a reading, then write one question it left you with.</p><button id="complete-challenge">Record completion locally</button><p id="challenge-status" role="status"></p></section><section class="tile" style="margin-top:24px"><h2>Your local guestbook</h2><form id="note-form"><label for="note-text">Leave yourself a note (280 characters)</label><textarea id="note-text" rows="3" maxlength="280" required></textarea><button>Add local note</button></form><ul class="local-notes" id="notes"></ul><p id="notes-empty">No local notes yet.</p><button id="clear-notes">Clear local notes</button></section></>}
{room==='cartridges'&&<p class="notice">Pick a published project, open its manual, then press Start. These jackets are original PointCast pixel art. Each project supplies its own play, art or learning experience.</p>}
{room==='video-store'&&<p class="notice">Choose a mood or topic. Every tape opens a reading or project page; the shelf does not stream films.</p>}
{room==='bbs'&&<h2>Room & project directory</h2>}
{['mixtape','bbs','cartridges','video-store'].includes(room)&&<><form class="toolbar" id="filter-form" role="search"><label>Search the shelf<input id="search" type="search" placeholder="Title or description"/></label><label>{room==='video-store'?'Mood / topic':'Shelf'}<select id="filter"><option value="all">All published destinations</option>{(room==='video-store'?['calm','curious','making','animation']:room==='cartridges'?['play','art','making']:['curious','art','play','animation']).map(t=><option value={t}>{t.charAt(0).toUpperCase()+t.slice(1)}</option>)}</select></label><button type="reset">Reset filters</button><p id="result-count" role="status">{projects.length} destinations</p></form><div class="grid project-grid" id="projects">{projects.map((p,i)=><article class={`tile ${room==='video-store'?'vhs':''}`} data-href={p.href} data-topics={p.topics.join(' ')} data-search={`${p.title} ${p.dek}`.toLowerCase()}>{room==='cartridges'&&<div class="box"><RetroArt variant={i}/><strong>{p.title}</strong></div>}<span class="number">PC / {String(i+1).padStart(3,'0')}</span><h2>{p.title}</h2><p>{p.dek}</p>{room==='mixtape'?<button data-add={p.href}>Add to tape +</button>:<a class="action" href={p.href}>{room==='cartridges'?'Start →':room==='video-store'?'Read this tape →':'Enter room →'}</a>}{room==='cartridges'&&<details><summary>Instruction manual</summary><p>Open {p.title} to begin. Use that project’s on-screen controls. Return here with your browser’s Back button to choose another cartridge.</p><p>Local progress, sound and keyboard controls vary by project. No cartridge runs inside this shelf.</p></details>}</article>)}</div><p class="empty" id="no-results" hidden={projects.length>0}>No matching published destinations. Try another mood or clear your search.</p></>}
{['mixtape','bbs'].includes(room)&&<section class="notice no-print"><label><input id="remember" type="checkbox"/> Remember my tape and notes on this device</label><p id="storage-status" role="status">Saving is off. This page visit stays in memory.</p><button id="reset-local">Reset all Retro Room local data</button><p>Reset removes only this room’s saved tape and notes. It does not clear progress in other PointCast projects.</p></section>}
<noscript><p class="notice">The directory links and manuals work without JavaScript. The dial, filters, local notebook and tape sequencing need JavaScript.</p></noscript>
<script id="retro-data" type="application/json" set:html={content}/>
<script>import '../../lib/retro-controller.mjs';</script>
</RetroShell>
