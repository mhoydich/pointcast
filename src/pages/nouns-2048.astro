---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';
const title = 'Nouns 2048';
const description = 'A Windows 95 styled Nouns 2048: slide and merge tinted tiles until a Noun-faced 2048 tile glows on the desktop.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/nouns-2048', name: title, description, url: 'https://pointcast.xyz/nouns-2048' };
---
<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-n2048>
    <section class="window" aria-labelledby="n2048-title">
      <header class="titlebar"><span>Nouns 2048</span><span class="buttons" aria-hidden="true"><i>_</i><i>□</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Nouns 2048 menu">
        <button type="button" data-new>Game</button>
        <button type="button" data-undo>Undo</button>
        <button type="button" data-pause>Pause</button>
        <a href="/noggle-drop">Drop</a> <a href="/nouns-2048">2048</a> <a href="/nouns-snake">Snake</a> <a href="/nouns-slide">Slide</a> <a href="/nouns-reversi">Reversi</a> <a href="/nouns-breakout">Breakout</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">MERGE · 2048 · NOUNS</p><h1 id="n2048-title">Merge to 2048</h1><p>Slide tiles with arrows or WASD, swipe on touch. Equal tiles fuse. Reach 2048.</p></div>
        <div class="meters"><span>Score <strong data-score>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage">
        <div class="boardframe">
          <div class="board" data-board aria-label="Nouns 2048 board" role="grid"></div>
          <div class="overlay" data-overlay hidden>
            <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="n2048-dlg-title">
              <header class="dlgbar"><span data-dlg-title id="n2048-dlg-title">Game Over</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
              <div class="dlgbody"><p data-dlg-msg>No moves remain.</p>
                <div class="dlgbtns"><button type="button" data-dlg-keep hidden>Keep going</button><button type="button" data-dlg-new>New game</button></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="pad" aria-label="Touch controls">
        <button type="button" data-dir="up" aria-label="Slide up">▲</button>
        <div class="padrow">
          <button type="button" data-dir="left" aria-label="Slide left">◄</button>
          <button type="button" data-dir="down" aria-label="Slide down">▼</button>
          <button type="button" data-dir="right" aria-label="Slide right">►</button>
        </div>
      </div>
      <footer class="status" data-status role="status" aria-live="polite">Ready. Merge equal Nouns tiles to climb toward 2048.</footer>
    </section>
  </main>
</BlockLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-n2048]');
  if (root) {
    const SIZE = 4;
    const slug = 'nouns-2048';
    const statsKey = 'pc:arcade:' + slug;
    const profileKey = 'pc:arcade:profile';
    const NOUN_SEEDS: Record<number, number> = { 1024: 42, 2048: 777 };
    const TIER: Record<number, { bg: string; fg: string }> = {
      2: { bg: '#d5d7e3', fg: '#000' }, 4: { bg: '#c9d8f0', fg: '#000' },
      8: { bg: '#4A9EFF', fg: '#fff' }, 16: { bg: '#2CC5A0', fg: '#003' },
      32: { bg: '#F7C325', fg: '#3a2a00' }, 64: { bg: '#f0a020', fg: '#3a2000' },
      128: { bg: '#E84D6A', fg: '#fff' }, 256: { bg: '#D22209', fg: '#fff' },
      512: { bg: '#a5122a', fg: '#fff' }, 1024: { bg: '#000080', fg: '#ffff00' },
      2048: { bg: '#000', fg: '#ffff00' },
    };

    function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
    function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage unavailable */ } }

    const board = root.querySelector<HTMLElement>('[data-board]');
    const scoreEl = root.querySelector<HTMLElement>('[data-score]');
    const bestEl = root.querySelector<HTMLElement>('[data-best]');
    const statusEl = root.querySelector<HTMLElement>('[data-status]');
    const overlay = root.querySelector<HTMLElement>('[data-overlay]');
    const dlgTitle = root.querySelector<HTMLElement>('[data-dlg-title]');
    const dlgMsg = root.querySelector<HTMLElement>('[data-dlg-msg]');
    const dlgKeep = root.querySelector<HTMLButtonElement>('[data-dlg-keep]');
    const dlgNew = root.querySelector<HTMLButtonElement>('[data-dlg-new]');
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]');

    if (board && scoreEl && bestEl && statusEl && overlay && dlgTitle && dlgMsg && dlgKeep && dlgNew && pauseBtn) {
      let grid: number[][] = [];
      let score = 0;
      let hasWon = false;
      let paused = false;
      let over = false;
      let prev: { grid: number[][]; score: number } | null = null;
      const cells: HTMLElement[] = [];

      function setStatus(text: string) { statusEl!.textContent = text; }

      function bestScore() { const s = readJson(statsKey, {}); return Number(s.bestScore || 0); }
      function renderBest() { const b = bestScore(); bestEl!.textContent = b > 0 ? String(b) : '--'; }

      function buildBoard() {
        board!.innerHTML = '';
        cells.length = 0;
        for (let r = 0; r < SIZE; r++) {
          const rowEl = document.createElement('div');
          rowEl.className = 'brow';
          rowEl.setAttribute('role', 'row');
          for (let c = 0; c < SIZE; c++) {
            const cell = document.createElement('div');
            cell.className = 'cell';
            cell.setAttribute('role', 'gridcell');
            rowEl.appendChild(cell);
            cells.push(cell);
          }
          board!.appendChild(rowEl);
        }
      }

      function emptyCells() {
        const out: [number, number][] = [];
        for (let r = 0; r < SIZE; r++) for (let cc = 0; cc < SIZE; cc++) if (grid[r][cc] === 0) out.push([r, cc]);
        return out;
      }

      function spawn(): [number, number] | null {
        const empty = emptyCells();
        if (!empty.length) return null;
        const [r, c] = empty[Math.floor(Math.random() * empty.length)];
        grid[r][c] = Math.random() < 0.9 ? 2 : 4;
        return [r, c];
      }

      function render(spawnRC?: [number, number] | null) {
        for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) {
          const v = grid[r][c];
          const el = cells[r * SIZE + c];
          el.className = 'cell';
          if (v === 0) { el.textContent = ''; el.removeAttribute('style'); continue; }
          const t = TIER[v] || TIER[2048];
          el.style.background = t.bg;
          el.style.color = t.fg;
          const fs = v >= 1000 ? '20px' : v >= 100 ? '26px' : '32px';
          if (NOUN_SEEDS[v]) {
            el.innerHTML = '<img class="nface" alt="" src="https://noun.pics/' + NOUN_SEEDS[v] + '.svg" /><span class="nval" style="font-size:' + fs + '">' + v + '</span>';
            el.classList.add('has-noun');
            if (v === 2048) el.classList.add('glow');
          } else {
            el.textContent = String(v);
            el.style.fontSize = fs;
          }
          if (spawnRC && spawnRC[0] === r && spawnRC[1] === c) el.classList.add('spawn');
        }
        scoreEl!.textContent = String(score);
      }

      function slideRow(row: number[]) {
        const nums = row.filter((n) => n !== 0);
        let gained = 0;
        const out: number[] = [];
        for (let i = 0; i < nums.length; i++) {
          if (i + 1 < nums.length && nums[i] === nums[i + 1]) {
            const merged = nums[i] * 2;
            out.push(merged);
            gained += merged;
            i++;
          } else out.push(nums[i]);
        }
        while (out.length < SIZE) out.push(0);
        return { row: out, gained };
      }

      function rotate(g: number[][]) {
        const n: number[][] = Array.from({ length: SIZE }, () => Array(SIZE).fill(0));
        for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) n[c][SIZE - 1 - r] = g[r][c];
        return n;
      }

      function clone(g: number[][]) { return g.map((r) => r.slice()); }
      function eq(a: number[][], b: number[][]) { for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) if (a[r][c] !== b[r][c]) return false; return true; }

      function move(dir: 'left' | 'right' | 'up' | 'down') {
        if (paused || over) return;
        const before = clone(grid);
        const beforeScore = score;
        let rot = 0;
        if (dir === 'up') rot = 3; else if (dir === 'right') rot = 2; else if (dir === 'down') rot = 1;
        let g = clone(grid);
        for (let i = 0; i < rot; i++) g = rotate(g);
        let gained = 0;
        for (let r = 0; r < SIZE; r++) { const res = slideRow(g[r]); g[r] = res.row; gained += res.gained; }
        for (let i = 0; i < (4 - rot) % 4; i++) g = rotate(g);
        if (eq(g, before)) return;
        grid = g;
        score += gained;
        prev = { grid: before, score: beforeScore };
        let reached2048 = false;
        for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) if (grid[r][c] === 2048) reached2048 = true;
        const sp = spawn();
        render(sp);
        if (gained > 0) { setStatus('Merged for +' + gained + '. Score ' + score + '.'); persistBest(); }
        else setStatus('Slid ' + dir + '.');
        if (reached2048 && !hasWon) { hasWon = true; win(); }
        else if (!movesLeft()) gameOver();
      }

      function movesLeft() {
        if (emptyCells().length) return true;
        for (let r = 0; r < SIZE; r++) for (let c = 0; c < SIZE; c++) {
          const v = grid[r][c];
          if (c + 1 < SIZE && grid[r][c + 1] === v) return true;
          if (r + 1 < SIZE && grid[r + 1][c] === v) return true;
        }
        return false;
      }

      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: null, bestScore: null });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestScore = Math.max(Number(stats.bestScore || 0), score);
        }
        writeJson(statsKey, stats);
        const profile = readJson(profileKey, { achievements: [] });
        profile.lastPlayed = '2048';
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = '2048';
          const earned = ['first-win', 'reach-2048'];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
      }

      function persistBest() {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: null, bestScore: null });
        stats.bestScore = Math.max(Number(stats.bestScore || 0), score);
        writeJson(statsKey, stats);
        renderBest();
      }

      function showDialog(titleText: string, msg: string, keep: boolean) {
        dlgTitle!.textContent = titleText;
        dlgMsg!.textContent = msg;
        dlgKeep!.hidden = !keep;
        overlay!.hidden = false;
        (keep ? dlgKeep! : dlgNew!).focus();
      }

      function win() {
        recordPlay(true);
        renderBest();
        setStatus('You reached 2048. A Noun awakens.');
        showDialog('You win!', 'A Noun-faced 2048 tile glows. Keep going for a higher score, or start fresh.', true);
      }

      function gameOver() {
        over = true;
        persistBest();
        setStatus('No moves remain. Final score ' + score + '.');
        showDialog('Game Over', 'No moves remain. Final score ' + score + '. Best ' + Math.max(bestScore(), score) + '.', false);
      }

      function newGame() {
        overlay!.hidden = true;
        grid = Array.from({ length: SIZE }, () => Array(SIZE).fill(0));
        score = 0;
        hasWon = false;
        over = false;
        paused = false;
        prev = null;
        pauseBtn!.textContent = 'Pause';
        spawn(); spawn();
        render();
        renderBest();
        recordPlay(false);
        setStatus('New game. Merge equal Nouns tiles.');
      }

      function undo() {
        if (!prev || over) { setStatus('Nothing to undo.'); return; }
        grid = clone(prev.grid);
        score = prev.score;
        prev = null;
        render();
        setStatus('Undid last move.');
      }

      function togglePause() {
        if (over) return;
        paused = !paused;
        pauseBtn!.textContent = paused ? 'Resume' : 'Pause';
        setStatus(paused ? 'Paused.' : 'Resumed.');
      }

      root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('click', newGame);
      root.querySelector<HTMLButtonElement>('[data-undo]')?.addEventListener('click', undo);
      pauseBtn.addEventListener('click', togglePause);
      dlgNew.addEventListener('click', newGame);
      dlgKeep.addEventListener('click', () => { overlay!.hidden = true; setStatus('Keep merging for a higher score.'); });

      root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => {
        b.addEventListener('click', () => {
          const d = b.dataset.dir;
          if (d === 'left' || d === 'right' || d === 'up' || d === 'down') move(d);
        });
      });

      const KEYS: Record<string, 'left' | 'right' | 'up' | 'down'> = {
        ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down',
        a: 'left', d: 'right', w: 'up', s: 'down', A: 'left', D: 'right', W: 'up', S: 'down',
      };
      window.addEventListener('keydown', (e) => {
        const d = KEYS[e.key];
        if (!d) return;
        const t = e.target as HTMLElement | null;
        // Only ignore direction keys while the user is typing in a text field.
        if (t && (t.isContentEditable || t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT')) return;
        e.preventDefault();
        move(d);
      });

      let tx = 0, ty = 0, tracking = false;
      board.addEventListener('touchstart', (e) => { const t = e.changedTouches[0]; tx = t.clientX; ty = t.clientY; tracking = true; }, { passive: true });
      board.addEventListener('touchend', (e) => {
        if (!tracking) return;
        tracking = false;
        const t = e.changedTouches[0];
        const dx = t.clientX - tx, dy = t.clientY - ty;
        if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
        if (Math.abs(dx) > Math.abs(dy)) move(dx > 0 ? 'right' : 'left');
        else move(dy > 0 ? 'down' : 'up');
      }, { passive: true });
      // Stop the page from scrolling while swiping the board.
      board.addEventListener('touchmove', (e) => { if (tracking) e.preventDefault(); }, { passive: false });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && !paused && !over) { paused = true; pauseBtn!.textContent = 'Resume'; setStatus('Paused (tab hidden).'); }
      });

      buildBoard();
      newGame();
    }
  }
</script>
<style>
  :global(body) { background: #008080; }
  .desk { background: #008080; font-family: "MS Sans Serif", Tahoma, system-ui, sans-serif; min-height: calc(100vh - 88px); padding: 18px; }
  [data-n2048] .window { max-width: 1040px; margin: 0 auto; background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; box-shadow: 2px 2px 0 #000; }
  [data-n2048] .titlebar { background: linear-gradient(90deg, #000080, #1084d0); color: #fff; font-weight: 700; font-size: 13px; padding: 3px 5px; display: flex; justify-content: space-between; align-items: center; }
  [data-n2048] .buttons { display: flex; gap: 2px; }
  [data-n2048] .buttons i { width: 19px; height: 18px; display: grid; place-items: center; border: 2px solid; border-color: #fff #404040 #404040 #fff; background: #c0c0c0; color: #000; font-style: normal; font-size: 11px; }
  [data-n2048] .menubar { display: flex; flex-wrap: wrap; gap: 2px; padding: 4px 5px; border-bottom: 1px solid #808080; align-items: center; }
  [data-n2048] .menubar button, [data-n2048] .menubar a { border: 0; background: transparent; color: #000; padding: 4px 8px; text-decoration: none; font-size: 13px; cursor: pointer; font-family: inherit; }
  [data-n2048] .menubar button:hover, [data-n2048] .menubar a:hover { background: #000080; color: #fff; }
  [data-n2048] .hero { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: flex-end; padding: 14px 16px 8px; }
  [data-n2048] .kicker { font: 700 10px/1 "Courier New", monospace; letter-spacing: .12em; color: #000080; text-transform: uppercase; margin: 0 0 6px; }
  [data-n2048] h1 { font-size: clamp(30px, 6vw, 64px); line-height: .94; font-weight: 700; margin: 0; }
  [data-n2048] .hero p:last-child { margin: 6px 0 0; font-size: 13px; max-width: 46ch; }
  [data-n2048] .meters { display: flex; gap: 8px; }
  [data-n2048] .meters span { border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff; padding: 6px 12px; font-size: 12px; display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 78px; }
  [data-n2048] .meters strong { font: 700 22px/1 "Courier New", monospace; }
  [data-n2048] .stage { padding: 8px 16px 4px; display: flex; justify-content: center; }
  [data-n2048] .boardframe { position: relative; }
  [data-n2048] .board { display: grid; grid-template-rows: repeat(4, 92px); gap: 8px; padding: 8px; border: 2px solid; border-color: #808080 #fff #fff #808080; background: #9a9c8f; touch-action: none; }
  [data-n2048] .brow { display: grid; grid-template-columns: repeat(4, 92px); gap: 8px; }
  [data-n2048] .cell { border: 2px solid; border-color: #808080 #fff #fff #808080; background: #cfd1c2; display: grid; place-items: center; font: 700 32px/1 "Courier New", monospace; color: #000; position: relative; overflow: hidden; transition: background .12s ease; }
  [data-n2048] .cell.spawn { animation: pop .18s ease; }
  [data-n2048] .cell.has-noun .nface { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .5; }
  [data-n2048] .cell.has-noun .nval { position: relative; font: 700 20px/1 "Courier New", monospace; text-shadow: 0 0 4px #000, 0 0 4px #000; }
  [data-n2048] .cell.glow { box-shadow: 0 0 0 2px #ffff00, 0 0 14px 3px #ffff00 inset; animation: glow 1s ease-in-out infinite alternate; }
  @keyframes pop { 0% { transform: scale(.3); } 100% { transform: scale(1); } }
  @keyframes glow { from { filter: brightness(1); } to { filter: brightness(1.35); } }
  @media (prefers-reduced-motion: reduce) { [data-n2048] .cell.spawn, [data-n2048] .cell.glow { animation: none; } }
  [data-n2048] .overlay { position: absolute; inset: 0; background: rgba(0, 0, 128, .35); display: grid; place-items: center; }
  [data-n2048] .overlay[hidden] { display: none; }
  [data-n2048] .dialog { background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; box-shadow: 3px 3px 0 #000; min-width: 260px; max-width: 90%; }
  [data-n2048] .dlgbar { background: linear-gradient(90deg, #000080, #1084d0); color: #fff; font-weight: 700; font-size: 13px; padding: 3px 5px; display: flex; justify-content: space-between; align-items: center; }
  [data-n2048] .dlgbar .buttons i { width: 19px; height: 18px; display: grid; place-items: center; border: 2px solid; border-color: #fff #404040 #404040 #fff; background: #c0c0c0; color: #000; font-style: normal; font-size: 11px; }
  [data-n2048] .dlgbody { padding: 14px; font-size: 13px; }
  [data-n2048] .dlgbody p { margin: 0 0 12px; }
  [data-n2048] .dlgbtns { display: flex; gap: 8px; justify-content: flex-end; }
  [data-n2048] .dlgbtns button { font-family: inherit; font-size: 13px; padding: 5px 14px; background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; cursor: pointer; }
  [data-n2048] .dlgbtns button:active { border-color: #404040 #fff #fff #404040; }
  [data-n2048] .pad { display: none; padding: 8px 16px 0; flex-direction: column; align-items: center; gap: 6px; }
  [data-n2048] .padrow { display: flex; gap: 6px; }
  [data-n2048] .pad button { width: 58px; height: 46px; font-size: 20px; font-family: inherit; background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; cursor: pointer; }
  [data-n2048] .pad button:active { border-color: #404040 #fff #fff #404040; }
  [data-n2048] .status { border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff; margin: 10px 16px 14px; padding: 6px 10px; font-size: 12px; font-family: "Courier New", monospace; }
  @media (max-width: 760px) {
    [data-n2048] .board { grid-template-rows: repeat(4, 68px); gap: 6px; }
    [data-n2048] .brow { grid-template-columns: repeat(4, 68px); gap: 6px; }
    [data-n2048] .cell { font-size: 24px; }
    [data-n2048] .pad { display: flex; }
    [data-n2048] h1 { font-size: clamp(26px, 8vw, 40px); }
  }
</style>
