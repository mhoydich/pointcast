---
/**
 * /radio-network — the plan for PointCast Radio Network: a community station
 * for El Segundo and sister stations in the South Bay towns around it.
 * Data lives in src/data/radio-network.ts so /radio-network.json shares one source.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import '../styles/radio-network.css';
import {
  BUDGET,
  BUDGET_NOTE,
  CLOCK,
  CONNECTIONS,
  DECISIONS,
  LADDER,
  MONEY,
  PATHS,
  PHASES,
  RULES,
  STATIONS,
  WEEK,
} from '../data/radio-network';
import { RADIO_ASSIGNMENTS, RADIO_ASSIGNMENTS_STATUS } from '../data/radio-roles';

const title = 'PointCast Radio Network — a station for El Segundo, and the towns next door';
const description =
  'The plan for a community radio station in El Segundo and a network of sister stations across the South Bay: stations, the hour clock, the weekly schedule, how the signal gets out, phases, budget and how to take part.';
---

<BlockLayout
  title={title}
  description={description}
  author="PointCast"
  alternates={[{ type: 'application/json', href: '/radio-network.json', title: 'PointCast Radio Network plan' }]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'PointCast Radio Network',
    url: 'https://pointcast.xyz/radio-network',
    description,
    about: STATIONS.map((s) => ({ '@type': 'Place', name: s.town, address: { '@type': 'PostalAddress', postalCode: s.zip, addressRegion: 'CA' } })),
  }}
>
  <div class="rn">
    <div class="rn-wrap">
      <header class="rn-mast">
        <a class="logo" href="/radio-network">PointCast <b>Radio Network</b></a>
        <nav>
          <a href="#stations">Stations</a>
          <a href="#clock">Hour clock</a>
          <a href="#week">Schedule</a>
          <a href="#signal">Signal</a>
          <a href="#phases">Phases</a>
          <a href="#join">Take part</a>
          <a href="#assignments">Assignments</a>
          <a href="/radio-network/kit">Launch kit</a>
          <a href="/radio-network/status">Status</a>
          <a href="/radio-network/print">Print kit</a>
          <a href="/radio-network.json">JSON</a>
        </nav>
      </header>

      <p class="rn-kicker">A plan · published October 20, 2026 · nothing on air yet</p>
      <h1>A radio station for El Segundo. Then one for every town next door.</h1>
      <p class="lede">
        Radio El Segundo starts as a weekly show and a stream, grows into a 24/7 station with live local hours, and
        becomes the flagship of a network of {STATIONS.length - 1} sister stations from Playa del Rey to Torrance. Each
        town keeps its own voice. They share a newsroom, an automation system, a schedule and a set of rules.
      </p>

      <div class="rn-dial" aria-hidden="true">
        {STATIONS.map((s, i) => (
          <span style={`left:${6 + i * (88 / (STATIONS.length - 1))}%`} class={s.role === 'flagship' ? 'on' : ''}>
            {s.town.split(' and ')[0]}
          </span>
        ))}
        <i></i>
      </div>

      <section id="stations">
        <h2>The stations</h2>
        <p class="rn-meta">Working names. Phase is when the station gets its own local hours.</p>
        <div class="rn-grid">
          {STATIONS.map((s) => (
            <article class={`rn-card ${s.role}`}>
              <p class="rn-tag">{s.role === 'flagship' ? 'Flagship' : `Phase ${s.phase}`} · {s.zip}</p>
              <h3><a href={`/radio-network/${s.slug}`}>{s.name}</a></h3>
              <p class="rn-meta">{s.town} · {s.localHours}</p>
              <ul class="tight">{s.beat.map((b) => <li>{b}</li>)}</ul>
              <p><b>First show:</b> {s.firstShow}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="clock">
        <h2>The hour clock</h2>
        <p class="lede">Every station runs the same hour so the network can stitch together. Local slots are where each town sounds like itself.</p>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>At</th><th>Length</th><th>Segment</th><th>Who</th></tr></thead>
            <tbody>{CLOCK.map((c) => <tr><td class="mono">{c.at}</td><td>{c.len}</td><td>{c.what}</td><td>{c.who}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="week">
        <h2>The weekly schedule</h2>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>When</th><th>Show</th><th>What it is</th></tr></thead>
            <tbody>{WEEK.map((w) => <tr><td class="mono">{w.block}</td><td><b>{w.show}</b></td><td>{w.note}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="signal">
        <h2>How the signal gets out</h2>
        <p class="lede">Four paths, cheapest and fastest first. The network starts online and works toward the dial.</p>
        <div class="rn-grid two">
          {PATHS.map((p, i) => (
            <article class="rn-card">
              <p class="rn-tag">Path {i + 1} · {p.when}</p>
              <h3>{p.name}</h3>
              <p>{p.what}</p>
              <p class="rn-meta"><b>Reach:</b> {p.reach}</p>
              <ul class="tight">{p.needs.map((n) => <li>{n}</li>)}</ul>
              <p class="rn-watch">Watch: {p.watch}</p>
            </article>
          ))}
        </div>
        <p class="rn-meta">General notes on how each path works, not legal advice. Check with a broadcast engineer or counsel before buying gear or filing anything.</p>
      </section>

      <section id="phases">
        <h2>Phases</h2>
        <p class="rn-meta">Phase 0 has a working kit: <a href="/radio-network/kit">the six-week launch kit for Radio El Segundo</a>.</p>
        <ol class="rn-phases">
          {PHASES.map((p) => (
            <li>
              <p class="rn-tag">Phase {p.n} · {p.span}</p>
              <h3>{p.name}</h3>
              <p>{p.goal}</p>
              <ul class="tight">{p.steps.map((s) => <li>{s}</li>)}</ul>
              <p class="rn-meta"><b>Done when:</b> {p.done}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="join">
        <h2>Take part</h2>
        <p class="lede">A ladder, like PointCast Guides. Start by listening; end up running a station. Every seat is open.</p>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>Role</th><th>Does</th><th>How you get there</th></tr></thead>
            <tbody>{LADDER.map((l) => <tr><td><b>{l.role}</b></td><td>{l.does}</td><td>{l.gate}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="assignments">
        <h2>Project assignments</h2>
        <p class="lede">Ten practice projects for interns and volunteers, RN-01 to RN-10. Each is a real piece of the Phase 0–3 work with deliverables and a clear finish line.</p>
        <p class="rn-meta">{RADIO_ASSIGNMENTS_STATUS} Also listed on the <a href="/jobs/?project=radio">jobs board</a>.</p>
        <div class="rn-grid two">
          {RADIO_ASSIGNMENTS.map((a) => (
            <article class="rn-card" id={a.id}>
              <p class="rn-tag">{a.id} · {a.track} · Phase {a.phase} · {a.weeks} {a.weeks === 1 ? 'week' : 'weeks'}</p>
              <h3>{a.title}</h3>
              <p class="rn-meta">
                {a.stations.map((slug, i) => (
                  <>{i > 0 && ', '}<a href={`/radio-network/${slug}`}>{STATIONS.find((s) => s.slug === slug)?.name ?? slug}</a></>
                ))}
              </p>
              <p>{a.brief}</p>
              <p class="rn-meta"><b>Deliver</b></p>
              <ul class="tight">{a.deliverables.map((d) => <li>{d}</li>)}</ul>
              <p class="rn-meta"><b>Done when</b></p>
              <ul class="tight">{a.acceptance.map((c) => <li>{c}</li>)}</ul>
              <p class="rn-meta"><b>Practices:</b> {a.learns.join(', ')}</p>
              {a.needsApproval && <p class="rn-watch">Approval: {a.needsApproval}</p>}
            </article>
          ))}
        </div>
      </section>

      <section id="rules">
        <h2>Station rules</h2>
        <ol class="rules">{RULES.map((r) => <li>{r}</li>)}</ol>
      </section>

      <section id="money">
        <h2>Budget and money</h2>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>Phase</th><th>Range</th><th>Covers</th></tr></thead>
            <tbody>{BUDGET.map((b) => <tr><td>{b.phase}</td><td><b>{b.range}</b></td><td>{b.items}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="rn-meta">{BUDGET_NOTE}</p>
        <h3>Where the money comes from</h3>
        <ul class="tight">{MONEY.map((m) => <li>{m}</li>)}</ul>
      </section>

      <section id="decisions">
        <h2>Open decisions</h2>
        <p class="rn-meta">For Mike before Phase 0 starts.</p>
        <ul class="rn-check">{DECISIONS.map((d) => <li>{d}</li>)}</ul>
      </section>

      <section id="connections">
        <h2>Already on PointCast</h2>
        <div class="rn-grid">
          {CONNECTIONS.map((c) => (
            <article class="rn-card">
              <h3><a href={c.url}>{c.label}</a></h3>
              <p>{c.note}</p>
            </article>
          ))}
        </div>
      </section>

      <footer class="rn-foot">
        A plan drafted by Claude Code at Mike Hoydich's request; not written in Mike's voice. Nothing is on air, no
        frequency is held and no host is appointed. Machine-readable twin: <a href="/radio-network.json">/radio-network.json</a>.
      </footer>
    </div>
  </div>
</BlockLayout>
