  if(state==='attract'){ startGame(); return; }
  if(state==='over'||state==='scores'||state==='inter'){ window.dispatchEvent(new KeyboardEvent('keydown',{code:'Space',key:' '})); return; }
  if(state==='initials'){ submitScore((entry+'---').slice(0,3)); return; }
  if(state!=='play') return;
  let best=null,bd=1e9; const rows = y>=DECK_TOP ? [Math.max(0,Math.min(3,Math.floor((y-DECK_TOP-8)/DECK_ROW)))] : [1];
  rows.forEach(ri=>ROWS[ri].codes.forEach(code=>{ const d=Math.abs(cell[code].cx-x)+(y>=DECK_TOP?Math.abs(cell[code].dy+14-y):0); if(d<bd){ bd=d; best=code; } }));
  if(best){ heldKeys.add(best); fire(best); setTimeout(()=>heldKeys.delete(best),200); }
});
document.getElementById('snd').onclick=e=>{ boot(); muted=!muted; if(out) out.gain.value=muted?0:0.8; e.currentTarget.textContent=muted?'sound off':'sound on'; e.currentTarget.setAttribute('aria-pressed',String(!muted)); e.currentTarget.blur(); };
document.getElementById('fs').onclick=e=>{ e.currentTarget.blur(); if(document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen?.(); };

if(/[?&]bot\b/.test(location.search)) window.__bc={get state(){return state;},get score(){return score;},get balls(){return balls;},cell,ROWS,DECK_TOP,get targets(){return targets;},get tIdx(){return tIdx;},get bricks(){return bricks.size;},start:()=>{boot();startGame();}};
if(!LEVELS.length){ return; }
loadScores(); toAttract(); requestAnimationFrame(frame);
})();
</script>
</body>
