  hiLocal=[...hiLocal,rec].sort((a,b)=>b.score-a.score).slice(0,10); store.set('scores',hiLocal);
  try{ const r=await fetch('/api/brick-scores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({initials,score,round:lvlI+1})}); if(r.ok){ const j=await r.json(); hiGlobal=j.scores; } }catch(e){}
