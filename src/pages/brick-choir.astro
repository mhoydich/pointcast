let interAct=0;
const INTER_TUNES=[[0,4,7,4,0,4,7,12,null,11,7,4,2,4,0,null],[0,7,12,7,4,7,12,16,19,16,12,7,12,null,null,null],[0,3,7,10,12,10,7,3,0,null,12,15,19,24,null,null]];
const ACTS=['Act I · The Ball and the Brick','Act II · Three Voices','Act III · Before the Spell'];
function gameOver(won){
  setState('over'); overWon=!!won; balls=[];
  jingle(won?[0,4,7,12,16,19,24,28].map(x=>60+(lvl?lvl.root:0)+x):[12,11,7,4,3,0].map(x=>60+(lvl?lvl.root:0)+x),won?0.1:0.2,'lead');
}
let overWon=false;
function qualifies(){ const list=(hiGlobal||[]).length?hiGlobal:hiLocal; if(score<=0) return false; if(list.length<10) return true; return score>Math.min(...list.map(r=>r.score)); }
async function submitScore(initials){
