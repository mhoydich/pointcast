function orb(x,y,r,h,T){ g.globalCompositeOperation='lighter'; const gr=g.createRadialGradient(x,y,0,x,y,r*3); gr.addColorStop(0,'#fff'); gr.addColorStop(0.3,`hsla(${h},90%,75%,.9)`); gr.addColorStop(1,`hsla(${h},90%,60%,0)`); g.fillStyle=gr; g.beginPath(); g.arc(x,y,r*3,0,Math.PI*2); g.fill(); g.globalCompositeOperation='source-over'; }
