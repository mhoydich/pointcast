const WALL_BOTTOM=WALL_TOP+3*WGAP+KH;
const DRUMS=['kick','snare','hat','open','clap','rim','tom','high','shaker','crash'];
const SCALES={majpent:{steps:[0,2,4,7,9],ro:2},minpent:{steps:[0,3,5,7,10],ro:2},hirajoshi:{steps:[0,2,3,7,8],ro:2},dorian:{steps:[0,2,3,5,7,9,10],ro:3},lydian:{steps:[0,2,4,5,7,9,11],ro:3},whole:{steps:[0,2,4,6,8,10],ro:3}};
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const hue=m=>((m%12)*30+300)%360;             // pastel wheel, pitch → colour
