}
function drawWorld(T,{hud=true}={}){
  g.setTransform(DPR*S,0,0,DPR*S,DPR*(OX+(Math.random()-0.5)*shake),DPR*(OY+(Math.random()-0.5)*shake));
  // stage frame
  g.strokeStyle='rgba(255,255,255,.06)'; g.lineWidth=1; rr(SIDE-6,CEIL-8,W-2*SIDE+12,DECK_TOP-CEIL+10,18); g.stroke();
