  if(next%2===0&&next<LEVELS.length){ interAct=Math.min(2,next/2-1); setState('inter'); jingle(INTER_TUNES[interAct].map(x=>x===null?null:x+60+(LEVELS[next].root||0)),0.16,'lead'); return; }
