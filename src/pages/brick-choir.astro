}
let verse=0;
function verseClear(){
  if(state!=='play'||breakable()>0) return;
  verse++; const bonus=1000*verse*mult(); score+=bonus; flare=1; shake=5;
  words.push({x:W/2,y:WALL_BOTTOM+60,text:`verse ${verse+1}!`,t:now(),big:true,hold:true});
  jingle([0,4,7,12,16,19,24].map(x=>60+lvl.root+x),0.07,'lead');
  // the wall comes back, a little tougher, singing itself into place
  const T=now(); let k=0; const t0=ctx?ctx.currentTime+0.5:0;
  Object.entries(lvl.bricks).forEach(([code,h])=>{ if(!cell[code]) return; const hp=h===9?Infinity:Math.min(2,(h|0)+(verse>=2&&k%3===0?1:0)); bricks.set(code,{code,hp,max:hp===Infinity?9:hp,born:T+500+k*45,flash:0}); if(ctx&&k<36) tone(midiFor(code)+12,{t:t0+k*0.045,kind:'bell',len:0.04,vel:0.3,pan:cell[code].cx/W-0.5}); k++; });
  const cand=[...bricks.values()].filter(b=>b.hp!==Infinity&&!cell[b.code].drum).map(b=>b.code).sort((a,b)=>cell[a].cx-cell[b].cx); const st=Math.max(1,Math.floor(cand.length/8)); targets=[]; for(let i=(verse%2);i<cand.length&&targets.length<8;i+=st) targets.push(cand[i]); tIdx=0;
}
let clearBonus=0;
function songOver(){
