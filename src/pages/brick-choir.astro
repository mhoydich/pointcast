}
function poof(x,y,m){ for(let i=0;i<8&&!reduce;i++) parts.push({x,y,vx:(Math.random()-0.5)*160,vy:(Math.random()-0.5)*160,t:now(),life:400,c:m,s:2}); }
const mult=()=>(1+Math.min(2,Math.floor(combo/12)))*(fever>now()?2:1);
function hit(code,ball){
  const b=bricks.get(code); if(!b) return; const c=cell[code];
  if(b.hp===Infinity){ drum('rim',{vel:0.5}); b.flash=1; return; }
  b.hp--; b.flash=1; combo++; lastHit=now();
  const t=snapT(); let m=midiFor(code)+12;
  if(ball&&ball.tunnel){ const sc=SCALES[lvl.scale]||SCALES.minpent; if(lvl.phrase&&lvl.phrase.length){ const pc=lvl.phrase[tunnelRun%lvl.phrase.length]; m=(cell[pc]&&!cell[pc].drum?midiFor(pc):m-12)+12; } else { const d=7+tunnelRun; m=48+lvl.root+Math.floor(d/sc.steps.length)*12+sc.steps[d%sc.steps.length]; } tunnelRun++; tone(m,{kind:'lead',len:0.12,vel:0.9,pan:c.cx/W-0.5}); }
