/* ================= play ================= */
const BALL={3:{r:11,sp:300,spread:0.42,kind:'bass'},2:{r:8,sp:350,spread:0.24,kind:'pluck'},1:{r:6,sp:410,spread:0.07,kind:'pluck'}};
const MAXB=6;
function fire(code,demo){
  const c=cell[code]; if(!c) return;
  if(!c.drum&&(c.cool||0)>now()&&!balls.some(b=>b.landing&&Math.abs(b.x-c.cx)<KW*0.9)) return; if(!c.drum) c.cool=now()+220;
