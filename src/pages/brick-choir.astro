---
// /brick-choir — the Brick Choir arcade: a lobby of five cabinets (2600 · Choir · Quartet · Rally · Lanes), each screen running
// that game's real attract mode in an iframe (?attract → silent, input-free, throttled when unfocused), plus the
// come-back loop: TODAY'S SONG (a date-picked round everyone plays once, with streaks), THIS WEEK'S CHOIR
// (the weekly board from /api/brick-scores?period=week) and one big PLAY NOW for first-timers.
// Arrow keys / hover / touch move the focus along the row; Enter or a tap plays. Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Brick Choir Arcade · PointCast</title>
<meta name="description" content="Three arcade games that are really instruments. Every key fires a ball of light, every hit is a note. Today's song, this week's choir, free play.">
<meta property="og:title" content="Brick Choir Arcade">
<meta property="og:description" content="Four cabinets, one keyboard or your phone. Today's song, this week's choir, free play.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og3.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a1a">
<link rel="canonical" href="https://pointcast.xyz/brick-choir">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --lilac:#b9a8ff; --peach:#ffb38a;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  *{box-sizing:border-box;}
  html{background:var(--bg);}
  body{margin:0;min-height:100vh;font-family:var(--display);color:var(--ink);background:var(--bg);overflow-x:hidden;-webkit-tap-highlight-color:transparent;}
  a{color:inherit;}
  /* ambient light */
  .blobs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
  .blobs i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;filter:blur(60px);opacity:.28;mix-blend-mode:screen;animation:drift 26s ease-in-out infinite alternate;}
  .blobs i:nth-child(1){left:-20vmax;top:-20vmax;background:radial-gradient(circle,oklch(70% .18 300),transparent 60%);}
  .blobs i:nth-child(2){right:-25vmax;top:-10vmax;background:radial-gradient(circle,oklch(72% .16 200),transparent 60%);animation-delay:-9s;}
  .blobs i:nth-child(3){left:20vw;bottom:-35vmax;background:radial-gradient(circle,oklch(75% .16 40),transparent 60%);animation-delay:-17s;}
  @keyframes drift{to{transform:translate(8vw,6vh) scale(1.15);}}
  .wrap{position:relative;z-index:1;max-width:1360px;margin:0 auto;padding:16px 16px 48px;}

  /* ---- marquee ---- */
  .marquee{position:relative;border-radius:22px;padding:16px 26px 14px;margin-top:6px;display:grid;grid-template-columns:1fr auto;gap:12px 24px;align-items:center;
    background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.14);box-shadow:0 20px 60px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.12);overflow:hidden;}
  .marquee::before,.marquee::after{content:"";position:absolute;left:14px;right:14px;height:6px;background-image:radial-gradient(circle,var(--b,#ffd27a) 2.2px,transparent 3px);background-size:22px 6px;opacity:.9;animation:chase 1.1s steps(2,end) infinite;}
  .marquee::before{top:5px;} .marquee::after{bottom:5px;animation-delay:-.55s;}
  @keyframes chase{50%{background-position:11px 0;filter:brightness(.55);}}
  .logo{display:flex;gap:.01em;font:800 clamp(34px,5.6vw,64px)/1 var(--display);letter-spacing:-.02em;margin:0;}
  .logo span{display:inline-block;background:linear-gradient(180deg,oklch(92% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bob 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.18s);filter:drop-shadow(0 0 14px oklch(80% .15 var(--h) / .35));}
  .logo span.sp{width:.28em;}
  @keyframes bob{50%{transform:translateY(-5px);}}
  .tag{font:700 12px var(--mono);letter-spacing:.34em;text-transform:uppercase;color:var(--gold);margin-top:8px;text-indent:.34em;}
  .tag em{font-style:normal;color:rgba(244,240,255,.55);letter-spacing:.12em;text-transform:none;margin-left:10px;}
  .coin{display:flex;flex-direction:column;align-items:center;gap:6px;font:700 11px var(--mono);letter-spacing:.2em;color:var(--mint);}
  .coin .slot{width:64px;height:28px;border-radius:8px;background:#06050f;border:1px solid rgba(255,255,255,.2);box-shadow:inset 0 3px 8px rgba(0,0,0,.9),0 0 18px rgba(159,227,201,.25);position:relative;}
  .coin .slot::after{content:"";position:absolute;left:50%;top:50%;width:30px;height:4px;transform:translate(-50%,-50%);background:#000;border-radius:2px;box-shadow:0 0 6px var(--mint);}
  .coin b{animation:blink 1s steps(2,end) infinite;} @keyframes blink{50%{opacity:.25;}}
  .coin small{font-weight:500;letter-spacing:.08em;color:rgba(244,240,255,.5);}

  /* ---- the row of cabinets ---- */
  .row{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin:22px auto 0;max-width:1480px;align-items:end;perspective:1600px;}
  .cab{--c:#ffd27a;position:relative;border-radius:26px 26px 18px 18px;text-decoration:none;color:inherit;display:block;transform:scale(.94) translateY(6px);transition:transform .35s cubic-bezier(.2,.8,.2,1),filter .35s;filter:saturate(.75) brightness(.8);outline:0;cursor:pointer;}
  .cab.focus{transform:scale(1) translateY(0);filter:none;z-index:2;}
  .cab .glow{position:absolute;inset:-6% -8% -10%;border-radius:40px;background:radial-gradient(60% 55% at 50% 40%,color-mix(in oklab,var(--c) 45%,transparent),transparent 70%);opacity:0;transition:opacity .4s;z-index:0;filter:blur(18px);}
  .cab.focus .glow{opacity:.9;}
  .cab .body{position:relative;z-index:1;border-radius:26px 26px 18px 18px;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035) 60%,rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.16);box-shadow:0 30px 70px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.14),inset 0 -20px 40px rgba(0,0,0,.25);padding:12px 12px 14px;backdrop-filter:blur(10px);}
  .cab.focus .body{border-color:color-mix(in oklab,var(--c) 60%,rgba(255,255,255,.2));box-shadow:0 30px 70px rgba(0,0,0,.5),0 0 0 1px color-mix(in oklab,var(--c) 30%,transparent),0 0 40px color-mix(in oklab,var(--c) 28%,transparent),inset 0 1px 0 rgba(255,255,255,.2);}
  .cab .head{display:flex;justify-content:space-between;align-items:baseline;padding:4px 8px 10px;gap:8px;}
  .cab .head b{font:800 20px var(--display);letter-spacing:-.01em;color:var(--c);text-shadow:0 0 18px color-mix(in oklab,var(--c) 60%,transparent);}
  .cab .head small{font:600 10px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:rgba(244,240,255,.5);white-space:nowrap;}
  .screen{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:#06050f;border:1px solid rgba(255,255,255,.12);box-shadow:inset 0 0 40px rgba(0,0,0,.8);}
  .screen img,.screen iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;}
  .screen img{object-fit:cover;opacity:.85;transition:opacity .6s;}
  .screen iframe{pointer-events:none;opacity:0;transition:opacity .6s;background:#0b0a1a;}
  .screen.live iframe{opacity:1;} .screen.live img{opacity:0;}
  .screen .glass{position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.14),transparent 30%,transparent 70%,rgba(255,255,255,.05)),repeating-linear-gradient(0deg,rgba(0,0,0,.14) 0 1px,transparent 1px 3px);mix-blend-mode:screen;border-radius:14px;}
  .screen .attract{position:absolute;left:10px;bottom:8px;font:700 10px var(--mono);letter-spacing:.18em;color:rgba(244,240,255,.65);background:rgba(6,5,15,.7);padding:4px 8px;border-radius:999px;border:1px solid rgba(255,255,255,.12);}
  .screen .attract i{display:inline-block;width:6px;height:6px;border-radius:50%;background:#ff5c8a;margin-right:6px;vertical-align:1px;box-shadow:0 0 8px #ff5c8a;animation:blink 1.2s steps(2,end) infinite;}
  .cab .line{font:500 12.5px/1.35 var(--display);color:rgba(244,240,255,.72);padding:9px 8px 0;min-height:40px;}
  .cp{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;padding:10px 10px 6px;border-radius:12px;background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,.15));border:1px solid rgba(255,255,255,.08);}
  .cp .btns{display:flex;gap:6px;align-items:center;}
  .cp .btns i{width:18px;height:18px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,var(--k) 50%,color-mix(in oklab,var(--k) 60%,#000) 100%);box-shadow:0 3px 0 rgba(0,0,0,.6),0 0 10px color-mix(in oklab,var(--k) 50%,transparent);}
  .cp .stick{width:10px;height:10px;border-radius:50%;background:#e33;box-shadow:0 0 0 3px #222,0 0 0 4px #555,0 0 12px #e33;margin-right:8px;position:relative;}
  .cp .stick::before{content:"";position:absolute;left:50%;top:6px;width:3px;height:10px;background:#333;transform:translateX(-50%);z-index:-1;}
  .cp .play{font:800 12px var(--mono);letter-spacing:.16em;color:#140f28;background:var(--c);padding:8px 14px;border-radius:999px;box-shadow:0 0 18px color-mix(in oklab,var(--c) 50%,transparent);white-space:nowrap;}
  .cab.focus .cp .play{animation:pulse 1.4s ease-in-out infinite;} @keyframes pulse{50%{transform:scale(1.05);box-shadow:0 0 28px color-mix(in oklab,var(--c) 75%,transparent);}}
  .cab .free{position:absolute;right:16px;bottom:-11px;z-index:3;font:700 9px var(--mono);letter-spacing:.2em;color:var(--mint);background:#06050f;border:1px solid rgba(159,227,201,.4);padding:4px 8px;border-radius:999px;box-shadow:0 0 12px rgba(159,227,201,.3);}
  .cab.focus .free{animation:blink 1s steps(2,end) infinite;}
  .hint{text-align:center;margin-top:18px;font:600 11px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:rgba(244,240,255,.45);}
  .hint kbd{display:inline-block;font:700 10px var(--mono);padding:2px 7px;border-radius:6px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:var(--ink);margin:0 2px;}
  .touch-only{display:none;} @media (pointer:coarse){ .touch-only{display:inline;} .hint .kb{display:none;} }

  /* ---- TV / party ---- */
  .tv{display:grid;grid-template-columns:minmax(220px,.9fr) 2fr;gap:22px;align-items:center;margin-top:26px;padding:20px 22px;border-radius:22px;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.13);box-shadow:0 20px 50px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.1);}
  .tvscreen{position:relative;aspect-ratio:16/9;border-radius:12px;background:radial-gradient(70% 60% at 50% 60%,#241f4a,#0b0a1a 75%);border:6px solid #17152c;box-shadow:0 0 0 1px rgba(255,255,255,.15),0 20px 40px rgba(0,0,0,.5);display:grid;place-items:center;overflow:hidden;}
  .tvscreen b{font:800 clamp(28px,4vw,44px) var(--mono);letter-spacing:.2em;color:var(--gold);text-shadow:0 0 24px rgba(255,210,122,.5);text-indent:.2em;}
  .tvscreen small{position:absolute;bottom:10px;font:700 9px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.55);}
  .tvscreen .q{position:absolute;top:10px;left:10px;width:22%;aspect-ratio:1;border-radius:4px;background:repeating-conic-gradient(#fff 0 25%,#0b0a1a 0 50%) 0 0/28% 28%;border:3px solid #fff;opacity:.9;} .tvscreen .q.r{left:auto;right:10px;top:auto;bottom:10px;}
  .tv .eyebrow{font:700 11px var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--mint);display:flex;justify-content:space-between;gap:8px;} .tv .eyebrow span:last-child{color:rgba(244,240,255,.45);letter-spacing:.08em;}
  .tv h2{margin:8px 0 0;font:800 clamp(22px,2.6vw,32px)/1.1 var(--display);letter-spacing:-.02em;}
  .tv p{margin:10px 0 0;font:500 14px/1.5 var(--display);color:rgba(244,240,255,.75);max-width:640px;}
  .tvbtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;}
  @media (max-width:760px){ .tv{grid-template-columns:1fr;} }

  /* ---- the come-back loop ---- */
  .cards{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:18px;margin-top:24px;}
  .card{border-radius:22px;padding:22px 22px 20px;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.13);box-shadow:0 20px 50px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.1);position:relative;overflow:hidden;display:flex;flex-direction:column;gap:10px;}
  .card .eyebrow{font:700 11px var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--mint);display:flex;justify-content:space-between;gap:8px;}
  .card .eyebrow span:last-child{color:rgba(244,240,255,.45);letter-spacing:.08em;}
  .card h2{margin:0;font:800 clamp(26px,3vw,38px)/1.05 var(--display);letter-spacing:-.02em;}
  .card .meta{font:500 12px var(--mono);letter-spacing:.04em;color:rgba(244,240,255,.6);}
  .card .meta b{color:var(--gold);font-weight:700;}
  .board{margin:4px 0 0;padding:0;list-style:none;display:grid;gap:5px;font:600 14px var(--mono);}
  .board li{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:6px 10px;border-radius:10px;background:rgba(255,255,255,.045);}
  .board li:first-child{background:color-mix(in oklab,var(--gold) 16%,transparent);}
  .board li em{font-style:normal;font-size:11px;letter-spacing:.14em;color:rgba(244,240,255,.5);}
  .board li b{font-weight:700;} .board li span{color:rgba(244,240,255,.85);}
  .board li.empty{grid-template-columns:1fr;text-align:center;color:rgba(244,240,255,.5);font:500 13px var(--display);padding:12px;}
  .streak{display:flex;align-items:center;gap:12px;margin-top:2px;padding:10px 12px;border-radius:14px;background:rgba(255,210,122,.08);border:1px solid rgba(255,210,122,.25);}
  .streak b{font:800 30px/1 var(--display);color:var(--gold);min-width:44px;text-align:center;}
  .streak div{font:500 13px/1.35 var(--display);color:rgba(244,240,255,.85);} .streak small{display:block;font:500 11px var(--mono);color:rgba(244,240,255,.5);letter-spacing:.06em;margin-top:2px;}
  .streak .flames{display:flex;gap:3px;} .streak .flames i{width:8px;height:8px;border-radius:2px;background:rgba(255,255,255,.12);} .streak .flames i.on{background:var(--gold);box-shadow:0 0 8px var(--gold);}
  .cta{margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap:10px;font:800 13px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:#140f28;background:var(--gold);text-decoration:none;padding:13px 18px;border-radius:999px;box-shadow:0 8px 30px rgba(255,210,122,.3);transition:transform .15s;}
  .cta:hover{transform:translateY(-1px);} .cta.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.18);box-shadow:none;}
  .card.play{align-items:center;text-align:center;justify-content:center;background:radial-gradient(120% 90% at 50% 0%,rgba(255,143,177,.16),transparent 60%),linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));}
  .card.play .big{display:grid;place-items:center;width:min(100%,260px);aspect-ratio:1;border-radius:50%;text-decoration:none;color:#140f28;background:conic-gradient(from 0deg,#ff8fb1,#ffd27a,#9fe3c9,#8fd0ff,#b9a8ff,#ff8fb1);box-shadow:0 20px 60px rgba(255,143,177,.35),inset 0 0 0 10px rgba(11,10,26,.9),inset 0 0 0 11px rgba(255,255,255,.25);position:relative;transition:transform .2s;}
  .card.play .big:hover{transform:scale(1.03);} .card.play .big:active{transform:scale(.98);}
  .card.play .big::before{content:"";position:absolute;inset:14px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#fff6d8,#ffd27a 60%,#ffb38a);box-shadow:0 12px 0 rgba(0,0,0,.35),inset 0 -8px 16px rgba(0,0,0,.15);}
  .card.play .big span{position:relative;font:800 clamp(24px,2.6vw,34px)/1 var(--display);letter-spacing:-.01em;} .card.play .big small{position:relative;display:block;font:700 10px var(--mono);letter-spacing:.24em;margin-top:6px;opacity:.8;}
  .card.play p{margin:0;font:500 14px/1.45 var(--display);color:rgba(244,240,255,.75);max-width:280px;}
  .card.play .also{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.5);} .card.play .also a{color:var(--sky);text-decoration:none;}
  footer{margin-top:34px;text-align:center;font:500 12px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.45);} footer a{color:rgba(244,240,255,.7);text-decoration:none;} footer a:hover{color:#fff;}

  @media (max-width:1000px){ .cards{grid-template-columns:1fr 1fr;} .card.play{grid-column:1/-1;} }
  @media (max-width:760px){
    .wrap{padding:12px 16px 40px;} .marquee{grid-template-columns:1fr;padding:16px 18px 14px;} .coin{flex-direction:row;justify-content:space-between;}
    .row{grid-template-columns:1fr;gap:18px;margin-top:20px;} .cab{transform:none;filter:none;} .cab.focus{transform:none;}
    .cab .glow{display:none;} .cab .line{min-height:0;} .hint .kb{display:none;}
    .cards{grid-template-columns:1fr;} .card.play .big{width:200px;}
  }
  @media (prefers-reduced-motion:reduce){ .marquee::before,.marquee::after,.logo span,.coin b,.blobs i,.cab.focus .cp .play,.cab.focus .free,.screen .attract i{animation:none;} }
</style>
</head>
<body>
<div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
<div class="wrap">
  <header class="marquee">
    <div>
      <h1 class="logo" aria-label="Brick Choir"><span style="--h:0;--i:0">B</span><span style="--h:28;--i:1">R</span><span style="--h:56;--i:2">I</span><span style="--h:84;--i:3">C</span><span style="--h:112;--i:4">K</span><span class="sp"></span><span style="--h:168;--i:6">C</span><span style="--h:196;--i:7">H</span><span style="--h:224;--i:8">O</span><span style="--h:252;--i:9">I</span><span style="--h:280;--i:10">R</span></h1>
      <div class="tag">Arcade <em>five cabinets · one keyboard, or your phone · every hit is a note</em></div>
    </div>
    <div class="coin"><div class="slot" aria-hidden="true"></div><b>FREE PLAY</b><small>no coins · <a href="/keyboard" style="color:inherit">the instrument</a></small></div>
  </header>

  <section class="row" id="row" aria-label="Choose a cabinet">
    <a class="cab" href="/brick-choir/2600" data-game="2600" data-poster="/brick-choir/poster.webp" style="--c:#ffb38a" tabindex="0">
      <div class="glow"></div>
      <div class="body">
        <div class="head"><b>2600</b><small>the console edition</small></div>
        <div class="screen"><img alt="" loading="lazy"><div class="glass"></div><span class="attract"><i></i>ATTRACT</span></div>
        <div class="line">Your whole keyboard is the paddle. Low-res, big pixels, four bands of colour, a difficulty switch and a TV-type switch.</div>
        <div class="cp"><div class="btns"><i class="stick"></i><i style="--k:#c4432f"></i><i style="--k:#e0ae3f"></i></div><span class="play">PLAY ▸</span></div>
      </div>
      <span class="free">FREE PLAY</span>
    </a>
    <a class="cab" href="/brick-choir/choir" data-game="choir" data-poster="/brick-choir/key3.webp" style="--c:#ffd27a" tabindex="0">
      <div class="glow"></div>
      <div class="body">
        <div class="head"><b>Brick Choir</b><small>the arcade original</small></div>
        <div class="screen"><img alt="" loading="lazy"><div class="glass"></div><span class="attract"><i></i>ATTRACT</span></div>
        <div class="line">Every key fires a ball of light from its own spot. The glowing brick plays the song; behind the wall, the ball plays a run by itself.</div>
        <div class="cp"><div class="btns"><i class="stick"></i><i style="--k:#ff8fb1"></i><i style="--k:#ffd27a"></i><i style="--k:#9fe3c9"></i></div><span class="play">PLAY ▸</span></div>
      </div>
      <span class="free">FREE PLAY</span>
    </a>
    <a class="cab" href="/brick-choir/quartet" data-game="quartet" data-poster="/brick-choir/key4.webp" style="--c:#9fe3c9" tabindex="0">
      <div class="glow"></div>
      <div class="body">
        <div class="head"><b>Quartet</b><small>four players · 3D</small></div>
        <div class="screen"><img alt="" loading="lazy"><div class="glass"></div><span class="attract"><i></i>ATTRACT</span></div>
        <div class="line">Four corners of one keyboard around a glass monument. Bass, keys, lead, bells — empty seats are friendly bots.</div>
        <div class="cp"><div class="btns"><i class="stick"></i><i style="--k:#ff8fb1"></i><i style="--k:#ffd27a"></i><i style="--k:#9fe3c9"></i><i style="--k:#8fd0ff"></i></div><span class="play">PLAY ▸</span></div>
