/* ================= audio ================= */
let ctx=null, out, duck, music, sfx, wet, dly, fbk, muted=false;
function ir(sec,dec){ const n=ctx.sampleRate*sec,b=ctx.createBuffer(2,n,ctx.sampleRate); for(let c=0;c<2;c++){const d=b.getChannelData(c); for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,dec);} return b; }
function boot(){
  if(ctx){ if(ctx.state==='suspended') ctx.resume(); return true; }
  try{ ctx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return false; }
  const comp=ctx.createDynamicsCompressor(); comp.threshold.value=-10; comp.ratio.value=4; comp.attack.value=0.003; comp.release.value=0.2;
  out=ctx.createGain(); out.gain.value=muted?0:0.8; out.connect(comp); comp.connect(ctx.destination);
  duck=ctx.createGain(); duck.connect(out); music=ctx.createGain(); music.gain.value=0.9; music.connect(duck); sfx=ctx.createGain(); sfx.connect(out);
  const cv=ctx.createConvolver(); cv.buffer=ir(2.6,3); wet=ctx.createGain(); wet.gain.value=0.22; wet.connect(cv); cv.connect(out);
  dly=ctx.createDelay(2); fbk=ctx.createGain(); fbk.gain.value=0.28; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=3000;
  const snd=ctx.createGain(); snd.gain.value=0.16; snd.connect(dly); dly.connect(lp); lp.connect(fbk); fbk.connect(dly); lp.connect(out); out._send=snd; dly.delayTime.value=0.34;
  return true;
}
const mtof=m=>440*Math.pow(2,(m-69)/12);
function tone(m,{t,kind='bell',vel=0.8,len=0.15,pan=0,bus}={}){
  if(!ctx||muted) return; t=Math.max(t||0,ctx.currentTime); const f=mtof(m); const g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=Math.max(-0.9,Math.min(0.9,pan));
  const nodes=[]; let pk=0.2, rel=0.5, atk=0.004;
  if(kind==='bell'){ const o=ctx.createOscillator(), md=ctx.createOscillator(), mg=ctx.createGain(); o.type='sine'; o.frequency.value=f; md.frequency.value=f*3.5; mg.gain.setValueAtTime(f*2.2*vel,t); mg.gain.exponentialRampToValueAtTime(f*0.01,t+0.4); md.connect(mg); mg.connect(o.frequency); nodes.push(o,md); o.connect(g); pk=0.2; rel=1.1; }
  else if(kind==='pluck'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), lp=ctx.createBiquadFilter(); o.type='sawtooth'; o2.type='square'; o.frequency.value=f; o2.frequency.value=f*1.004; lp.type='lowpass'; lp.Q.value=4; lp.frequency.setValueAtTime(400+5200*vel,t); lp.frequency.exponentialRampToValueAtTime(260,t+0.22); const g2=ctx.createGain(); g2.gain.value=0.4; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2); pk=0.2; rel=0.25; }
  else if(kind==='lead'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), vib=ctx.createOscillator(), vg=ctx.createGain(), lp=ctx.createBiquadFilter(); o.type='triangle'; o2.type='square'; o.frequency.value=f; o2.frequency.value=f*2; vib.frequency.value=5.5; vg.gain.value=f*0.006; vib.connect(vg); vg.connect(o.frequency); lp.type='lowpass'; lp.frequency.value=3200; const g2=ctx.createGain(); g2.gain.value=0.12; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2,vib); pk=0.28; rel=0.5; atk=0.01; }
  else if(kind==='bass'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), lp=ctx.createBiquadFilter(); o.type='sine'; o2.type='sawtooth'; o.frequency.value=f; o2.frequency.value=f; lp.type='lowpass'; lp.frequency.setValueAtTime(900,t); lp.frequency.exponentialRampToValueAtTime(180,t+len); const g2=ctx.createGain(); g2.gain.value=0.25; o.connect(g); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2); pk=0.34; rel=0.12; }
  else if(kind==='pad'){ [0,-7,7].forEach(d=>{ const o=ctx.createOscillator(); o.type='sawtooth'; o.frequency.value=f; o.detune.value=d; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=1100; o.connect(lp); lp.connect(g); nodes.push(o); }); pk=0.05; rel=1.4; atk=0.25; }
  pk*=0.4+0.6*vel;
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(pk,t+atk); g.gain.setValueAtTime(pk*(kind==='pad'?1:0.6),t+Math.max(atk,len)); g.gain.exponentialRampToValueAtTime(0.0001,t+Math.max(atk,len)+rel);
  g.connect(p); p.connect(bus||sfx); if(kind!=='bass'){ p.connect(wet); if(kind!=='pad') p.connect(out._send); }
  nodes.forEach(n=>{ n.start(t); n.stop(t+Math.max(atk,len)+rel+0.05); });
}
function nz(d){ const b=ctx.createBuffer(1,Math.max(1,ctx.sampleRate*d),ctx.sampleRate),x=b.getChannelData(0); for(let i=0;i<x.length;i++) x[i]=Math.random()*2-1; const s=ctx.createBufferSource(); s.buffer=b; return s; }
function env(g,t,pk,dec){ g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(pk,t+0.002); g.gain.exponentialRampToValueAtTime(0.0001,t+dec); }
function drum(k,{t,vel=0.8,bus}={}){
  if(!ctx||muted) return; t=Math.max(t||0,ctx.currentTime); const g=ctx.createGain(); g.connect(bus||sfx); const v=0.35+0.65*vel;
  const osc=(type,f0,f1,dec,pk)=>{ const o=ctx.createOscillator(); o.type=type; o.frequency.setValueAtTime(f0,t); o.frequency.exponentialRampToValueAtTime(f1,t+dec*0.5); const og=ctx.createGain(); env(og,t,pk,dec); o.connect(og); og.connect(g); o.start(t); o.stop(t+dec+0.05); };
  const hiss=(dec,pk,type,f,q,off=0)=>{ const n=nz(dec+0.05), bf=ctx.createBiquadFilter(); bf.type=type; bf.frequency.value=f; bf.Q.value=q||1; const ng=ctx.createGain(); env(ng,t+off,pk,dec); n.connect(bf); bf.connect(ng); ng.connect(g); n.start(t+off); n.stop(t+off+dec+0.05); };
  switch(k){
    case 'kick': osc('sine',160,44,0.42,0.9*v); osc('triangle',2400,200,0.02,0.2*v); if(duck){ duck.gain.cancelScheduledValues(t); duck.gain.setValueAtTime(0.45,t); duck.gain.linearRampToValueAtTime(1,t+0.22); } break;
    case 'snare': osc('triangle',240,170,0.1,0.3*v); hiss(0.16,0.35*v,'highpass',1700); break;
    case 'clap': [0,0.01,0.02].forEach(o=>hiss(o?0.02:0.14,0.32*v,'bandpass',1500,1.3,o)); break;
    case 'hat': hiss(0.03,0.12*v,'highpass',9000); break;
    case 'open': hiss(0.28,0.14*v,'highpass',7000); break;
    case 'shaker': hiss(0.06,0.09*v,'bandpass',8500,2); break;
    case 'rim': osc('square',1300,1000,0.03,0.12*v); break;
    case 'tom': osc('sine',180,90,0.3,0.5*v); break;
    case 'high': osc('sine',280,160,0.24,0.45*v); break;
    case 'crash': hiss(1.2,0.2*v,'highpass',5200); break;
    case 'pop': osc('sine',520,180,0.08,0.18*v); break;
  }
}
/* groove: always on during play, deeper with energy */
let seqT=0, seqS=0, energy=1;
const PROG=[0,3,2,4];
function scheduler(){
  if(!ctx||!lvl||!(state==='play'||state==='attract'&&ctx)) { seqT=0; return; }
  if(state==='attract') return;
  const spb=60/(lvl.bpm||104), s16=spb/4; if(!seqT) { seqT=ctx.currentTime+0.06; }
  const sc=SCALES[lvl.scale]||SCALES.minpent, n=sc.steps.length, root=36+lvl.root;
  const deg=d=>root+Math.floor(d/n)*12+sc.steps[((d%n)+n)%n];
  while(seqT<ctx.currentTime+0.12){
    const st=seqS%16, bar=Math.floor(seqS/16)%4, ch=PROG[bar]%n, t=seqT, e=energy+(fever>now()?1:0);
    if(st%4===0) drum('kick',{t,vel:0.75,bus:music});
    if(st%2===1) drum('shaker',{t,vel:0.5,bus:music});
    if(e>=2&&(st===4||st===12)) drum('clap',{t,vel:0.6,bus:music});
    if(e>=2&&st%4!==0&&st%2===0) tone(deg(ch),{t,kind:'bass',len:s16*1.6,vel:0.7,bus:music});
    if(e>=2&&st%4===0) tone(deg(ch),{t,kind:'bass',len:s16*2.4,vel:0.9,bus:music});
    if(e>=3){ drum('hat',{t,vel:st%4===2?0.8:0.35,bus:music}); const arp=[0,2,4,2+n,4,2,0+n,4][st%8]; if(st%2===0) tone(deg(ch+arp)+24,{t,kind:'bell',len:0.05,vel:0.25,pan:st%4?0.4:-0.4,bus:music}); }
    if(e>=4&&st===0){ [0,2,4].forEach(d=>tone(deg(ch+d)+12,{t,kind:'pad',len:spb*3.8,vel:0.8,bus:music})); drum('crash',{t,vel:bar===0?0.4:0.15,bus:music}); }
    seqT+=s16; seqS++;
  }
}
function snapT(){ if(!ctx) return 0; const t=ctx.currentTime; if(!seqT||!lvl) return t; const s16=60/(lvl.bpm||104)/4; const k=Math.floor((seqT-t)/s16); const c=seqT-k*s16; return (c>=t&&c-t<=0.07)?c:t; }
function jingle(notes,step=0.12,kind='lead'){ if(!ctx) return; const t=ctx.currentTime+0.03; notes.forEach((m,i)=>{ if(m!==null) tone(m,{t:t+i*step,kind,len:step*0.9,vel:0.8}); }); }

/* ================= state ================= */
const cv=document.getElementById('game'), g=cv.getContext('2d');
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const now=()=>performance.now();
const store={get(k,d){try{const v=localStorage.getItem('bc3:'+k);return v?JSON.parse(v):d;}catch(e){return d;}},set(k,v){try{localStorage.setItem('bc3:'+k,JSON.stringify(v));}catch(e){}}};
let state='attract', stateT=now(), lvl=null, lvlI=0, bricks=new Map(), balls=[], beams=[], parts=[], words=[], rings=[];
let score=0, hearts=3, combo=0, lastHit=0, fever=0, targets=[], tIdx=0, tunnelRun=0, songEnd=0, songLen=70000, rally=[], rallyT0=0, notesPlayed=0, tunnels=0;
let hiLocal=store.get('scores',[]), hiGlobal=null, entry=null, pressedAt={}, heldKeys=new Set(), shake=0, flare=0, pulse=0, attractPanel=0, attractT=now();
const HI_DEFAULT=[['TER',42000],['SON',36000],['AST',30000],['KEY',24000],['BLM',18000],['CHO',12000],['RUN',9000],['ARC',6000],['BIT',3000],['YOU',1000]];
const best=()=>Math.max(score,...(hiGlobal||hiLocal).map(r=>r[1]||r.score||0),HI_DEFAULT[0][1]);

function midiFor(code){ const c=cell[code]; if(c.drum) return 60+lvl.root; const sc=SCALES[lvl.scale]||SCALES.minpent; const i=ROWS[c.row].codes.indexOf(code); const d=i+c.rowIdx*sc.ro; return 48+lvl.root+Math.floor(d/sc.steps.length)*12+sc.steps[d%sc.steps.length]; }
function breakable(){ let n=0; bricks.forEach(b=>{ if(b.hp!==Infinity) n++; }); return n; }
function setState(s){ state=s; stateT=now(); }

function loadLevel(i,{build=true}={}){
  lvlI=i; lvl=LEVELS[i%LEVELS.length]; bricks=new Map(); balls=[]; beams=[]; words=[]; rings=[];
  const order=Object.entries(lvl.bricks||{}).filter(([c])=>cell[c]).sort((a,b)=>cell[a[0]].row-cell[b[0]].row||cell[a[0]].i-cell[b[0]].i);
  order.forEach(([code,h],k)=>bricks.set(code,{code,hp:h===9?Infinity:Math.max(1,Math.min(2,h|0)),max:h===9?9:Math.max(1,Math.min(2,h|0)),born:build?now()+k*55:0,flash:0}));
