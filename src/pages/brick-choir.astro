let myRec=null;
async function loadScores(){ try{ const r=await fetch('/api/brick-scores'); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) hiGlobal=j.scores; } }catch(e){} }
async function publish(){
  if(rally.length<4||published) return; published='…';
  const t0=rally[0][0]; const ev=[]; rally.slice(0,5000).forEach(([t,code])=>{ const k=t-t0; ev.push([k,code,1],[k+120,code,0]); }); ev.sort((a,b)=>a[0]-b[0]);
