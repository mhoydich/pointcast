  // bricks: glass keycaps
  if(lvl) for(const [code,c] of Object.entries(cell)){ const b=bricks.get(code); if(!b) continue; if(b.born>T) continue; const age=Math.min(1,(T-b.born)/260), m=midiFor(code);
