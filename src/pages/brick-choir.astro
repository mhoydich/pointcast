/* ================= drawing ================= */
let S=1, OX=0, OY=0, DPR=1;
function fit(){ DPR=Math.min(2,devicePixelRatio||1); cv.width=innerWidth*DPR; cv.height=innerHeight*DPR; const top=innerWidth>700?40:48; S=Math.min(innerWidth/W,(innerHeight-top)/H); OX=(innerWidth-W*S)/2; OY=top+(innerHeight-top-H*S)/2; }
addEventListener('resize',fit); fit();
const KEYART=new Image(); KEYART.src='/brick-choir/key3.webp';
const blobs=[0,1,2,3].map(i=>({a:Math.random()*6,s:0.00007+i*0.00003,r:260+i*60,h:[300,200,40,150][i]}));
function rr(x,y,w,h,r){ g.beginPath(); g.moveTo(x+r,y); g.arcTo(x+w,y,x+w,y+h,r); g.arcTo(x+w,y+h,x,y+h,r); g.arcTo(x,y+h,x,y,r); g.arcTo(x,y,x+w,y,r); g.closePath(); }
function txt(s,x,y,{size=20,weight=700,color='#f4f0ff',align='center',font='display',alpha=1,track=0}={}){ g.globalAlpha=alpha; g.fillStyle=color; g.textAlign=align; g.textBaseline='middle'; g.font=`${weight} ${size}px ${font==='mono'?'"Geist Mono",ui-monospace,monospace':'"Bricolage Grotesque","Avenir Next",system-ui,sans-serif'}`; if(track&&'letterSpacing' in g) g.letterSpacing=track+'px'; g.fillText(s,x,y); if('letterSpacing' in g) g.letterSpacing='0px'; g.globalAlpha=1; }
function background(T){
  g.setTransform(DPR,0,0,DPR,0,0); g.fillStyle='#0b0a1a'; g.fillRect(0,0,innerWidth,innerHeight);
  const beat=ctx&&lvl&&seqT?Math.max(0,1-((ctx.currentTime%(60/(lvl.bpm||104)))/(60/(lvl.bpm||104)))*2.2):0;
  g.globalCompositeOperation='lighter';
  blobs.forEach((b,i)=>{ const a=b.a+T*b.s, x=innerWidth*(0.5+0.35*Math.cos(a*1.3+i)), y=innerHeight*(0.45+0.3*Math.sin(a+i*2)); const R=b.r*S*(1+0.08*beat+(fever>T?0.25:0)); const gr=g.createRadialGradient(x,y,0,x,y,R); const hh=fever>T?(b.h+T*0.05)%360:b.h; gr.addColorStop(0,`hsla(${hh},70%,55%,${0.10+0.05*beat+flare*0.12})`); gr.addColorStop(1,'hsla(0,0%,0%,0)'); g.fillStyle=gr; g.fillRect(x-R,y-R,R*2,R*2); });
