    <a class="cab" href="/brick-choir/rally" data-game="rally" data-poster="/brick-choir/rally.webp" style="--c:#e9ff7a" tabindex="0">
      <div class="glow"></div>
      <div class="body">
        <div class="head"><b>Rally</b><small>sports · phone paddles</small></div>
        <div class="screen"><img alt="" loading="lazy"><div class="glass"></div><span class="attract"><i></i>ATTRACT</span></div>
        <div class="line">Pickleball on the TV. Your phone is the paddle — swing it, tilt to aim, flick to dink — and every hit is the next note of the song.</div>
        <div class="cp"><div class="btns"><i class="stick"></i><i style="--k:#ff8fb1"></i><i style="--k:#9fe3c9"></i><i style="--k:#e9ff7a"></i></div><span class="play">PLAY ▸</span></div>
      </div>
    <a class="cab" href="/brick-choir/lanes" data-game="lanes" data-poster="/brick-choir/lanes.webp" style="--c:#b9a8ff" tabindex="0">
      <div class="glow"></div>
      <div class="body">
        <div class="head"><b>Lanes</b><small>bowling · phone balls</small></div>
        <div class="screen"><img alt="" loading="lazy"><div class="glass"></div><span class="attract"><i></i>ATTRACT</span></div>
        <div class="line">Bowling on the TV. Your phone is the ball — swing it, twist for the hook — and every pin is a note: a strike is the whole chord. Turns for one to eight; bumpers for the kids.</div>
        <div class="cp"><div class="btns"><i class="stick"></i><i style="--k:#ff8fb1"></i><i style="--k:#ffd27a"></i><i style="--k:#b9a8ff"></i></div><span class="play">PLAY ▸</span></div>
