  <p class="hint"><span class="kb"><kbd>◀</kbd><kbd>▶</kbd> pick a cabinet · <kbd>enter</kbd> or click to play</span><span class="touch-only">tap a cabinet to play</span></p>

  <section class="tv" aria-label="TV and party mode">
    <div class="tvscreen" aria-hidden="true"><b>KXTQ</b><small>SCAN ONCE · HOME</small><i class="q"></i></div>
    <div class="tvtext">
      <div class="eyebrow"><span>TV · Party</span><span>living room edition</span></div>
      <h2>Turn on the TV. Scan one code, and your phones follow it into Quartet, Rally and Lanes — no rescanning.</h2>
      <p>Open <b>Home</b> on the big screen: one room code, one QR. Everyone scans it once and picks a cabinet from the couch; the TV moves between games and the phones follow. <b>Sports Day</b> runs Rally, Lanes and Quartet back to back with a medal table and a ceremony. In Quartet, friends' phones become the corner seats — ten pads, a drum strip, a buzz when it's their note. Two phones per seat, eight in all; the TV is the only speaker. Leave it running and the monument plays itself between rounds. <b>Rally</b> is the sports cabinet: hold your phone like a paddle, swing it, and every hit is a note. <b>Lanes</b> is league night: the phone is the ball, every pin is a note, and the grandparents take turns with the kids.</p>
      <div class="tvbtns"><a class="cta" href="/brick-choir/home">Turn on the TV ▸</a><a class="cta ghost" href="/brick-choir/home-join">Join with a phone ▸</a><a class="cta ghost" href="/brick-choir/tv">Quartet only</a><a class="cta ghost" href="/brick-choir/rally">Rally only</a><a class="cta ghost" href="/brick-choir/lanes">Lanes only</a></div>
    </div>
  </section>

  <section class="cards">
    <article class="card" id="today">
      <div class="eyebrow"><span>Today's song</span><span id="todayDate"></span></div>
      <h2 id="todayTitle">…</h2>
      <div class="meta" id="todayMeta"></div>
      <ul class="board" id="todayBoard"><li class="empty">loading today's board…</li></ul>
      <div class="streak"><b id="streakN">0</b><div><span id="streakTxt">No streak yet</span><small id="streakSub">play today's song to the end to start one</small><div class="flames" id="flames"></div></div></div>
      <a class="cta" href="/brick-choir/choir?daily=1" id="todayCta">Sing today's song ▸</a>
    </article>
    <article class="card" id="week">
      <div class="eyebrow"><span>This week's choir</span><span id="weekId"></span></div>
      <h2>Top five</h2>
      <div class="meta">every cabinet · resets monday · <b>all-time</b> lives inside each game</div>
      <ul class="board" id="weekBoard"><li class="empty">tuning up…</li></ul>
      <a class="cta ghost" href="/brick-choir/choir">Make the choir ▸</a>
    </article>
    <article class="card play">
      <a class="big" href="/brick-choir/choir" id="playNow"><span>PLAY NOW</span><small>FREE PLAY</small></a>
      <p>New here? Start with <b>Brick Choir</b>: press any key, every hit is a note, you can’t play a wrong one.</p>
      <div class="also">or <a href="/brick-choir/quartet">bring three friends</a> · <a href="/brick-choir/home">put it on the TV</a> · <a href="/brick-choir/rally">play pickleball</a> · <a href="/brick-choir/lanes">go bowling</a> · <a href="/brick-choir/2600">go retro</a></div>
    </article>
  </section>

  <footer>rounds by Terra, Sonnet &amp; Astra · <a href="/keyboard">the keyboard</a> · <a href="/">PointCast</a> · © 2026</footer>
</div>

<script is:inline>
(() => {
'use strict';
/* the songbook, in the same order as Brick Choir 3's LEVELS (only what the card needs) */
const LEVELS=[{id:'terra-01',architect:'Terra',title:'First Ramp',scale:'majpent',root:0},{id:'terra-02',architect:'Terra',title:'Span of Rain',scale:'minpent',root:9},{id:'terra-03',architect:'Terra',title:'Tiled Thunder',scale:'hirajoshi',root:2},{id:'sonnet-verse',architect:'Sonnet',title:'Shine',scale:'lydian',root:0},{id:'terra-04',architect:'Terra',title:'V of Light',scale:'dorian',root:5},{id:'terra-05',architect:'Terra',title:'Stone Organ',scale:'lydian',root:7},{id:'terra-06',architect:'Terra',title:'Glass Cathedral',scale:'whole',root:11},{id:'astra-spell',architect:'Astra',title:'The Spell',scale:'hirajoshi',root:2}];
const MODELS={Terra:'GPT-5.6 Terra',Sonnet:'Claude Sonnet',Astra:'GPT-6 Astra'};
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const scaleName=l=>`${NAMES[l.root]} ${l.scale.replace('pent',' pentatonic').replace('maj','major').replace('min','minor')}`;
// the same daily pick as /brick-choir/choir?daily=1 (keep in sync): a seeded shuffle per 8-day epoch, so no repeats inside an epoch
function seeded(seed){ let s=seed>>>0||1; return ()=>{ s=(s*1664525+1013904223)>>>0; return s/4294967296; }; }
const DAY_IDX=Math.floor(Date.now()/86400000);
function dailyPick(dayIdx=DAY_IDX){ const n=LEVELS.length; const epoch=Math.floor(dayIdx/n); const r=seeded(epoch*2654435761+7); const perm=LEVELS.map((_,i)=>i); for(let i=n-1;i>0;i--){ const j=Math.floor(r()*(i+1)); [perm[i],perm[j]]=[perm[j],perm[i]]; } return perm[dayIdx%n]; }
const utcDay=()=>new Date().toISOString().slice(0,10);
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const touch=matchMedia('(pointer:coarse)').matches, narrow=()=>innerWidth<760, reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const saveData=navigator.connection&&navigator.connection.saveData;

/* ---- today's song ---- */
const today=LEVELS[dailyPick()]; $('todayDate').textContent=utcDay(); $('todayTitle').textContent=today.title;
$('todayMeta').innerHTML=`by <b>${esc(today.architect)}</b> · ${esc(MODELS[today.architect]||'')} · <b>${esc(scaleName(today))}</b> · 60 s · one run`;
(function streak(){ let d={}; try{ d=JSON.parse(localStorage.getItem('bc:daily')||'{}')||{}; }catch(e){}
  const t=utcDay(), y=new Date(Date.now()-86400000).toISOString().slice(0,10); const n=(d.last===t||d.last===y)?(d.streak|0):0; const playedToday=d.last===t;
  $('streakN').textContent=n; $('streakTxt').textContent=n?`${n}-day streak`:'No streak yet';
  $('streakSub').textContent=playedToday?`sung today · ${(d.best&&d.best[t])?d.best[t].toLocaleString()+' pts':''} · back tomorrow to keep it`:(n?'sing today to keep it alive':'play today’s song to the end to start one');
  $('flames').innerHTML=Array.from({length:7},(_,i)=>`<i class="${i<Math.min(7,n)?'on':''}"></i>`).join('');
  if(playedToday) $('todayCta').textContent='Sing it again ▸'; })();
const ORD=['1ST','2ND','3RD','4TH','5TH'], COLS=['#ff8fb1','#ffb38a','#ffd27a','#c8f08f','#9fe3c9'];
function board(el,rows,n,empty){ el.innerHTML=rows&&rows.length?rows.slice(0,n).map((r,i)=>`<li style="color:${COLS[i]}"><em>${ORD[i]}</em><b>${esc(r.initials||'???')}</b><span>${Number(r.score||0).toLocaleString()}${r.game&&r.game!=='daily'?` <em>${esc(r.game)}</em>`:''}</span></li>`).join(''):`<li class="empty">${empty}</li>`; }
async function get(q){ try{ const r=await fetch('/api/brick-scores'+q); if(r.ok) return await r.json(); }catch(e){} return null; }
get('?period=day&game=daily').then(j=>board($('todayBoard'),j&&j.scores,3,'no one has sung it yet — be first'));
get('?period=week').then(j=>{ board($('weekBoard'),j&&j.scores,5,'the week is young — be the first voice'); if(j&&j.week) $('weekId').textContent=j.week; });

/* ---- the cabinets: focus, live attract screens ---- */
const cabs=[...document.querySelectorAll('.cab')]; let focus=1; // Choir in the middle is home
const live=new Map(); // game → iframe
function screenOf(c){ return c.querySelector('.screen'); }
cabs.forEach(c=>{ const img=c.querySelector('img'); img.src=c.dataset.poster; img.onerror=()=>{ img.style.display='none'; }; if(narrow()||saveData) c.querySelector('.attract').innerHTML='TAP TO PLAY'; });
function load(c){ const g=c.dataset.game; if(live.has(g)||saveData) return; const f=document.createElement('iframe'); f.title=`${g} attract mode`; f.loading='eager'; f.setAttribute('aria-hidden','true'); f.tabIndex=-1;
  f.src=c.getAttribute('href')+'?attract=1'; const s=screenOf(c); s.insertBefore(f,s.querySelector('.glass')); live.set(g,f);
  const on=()=>{ s.classList.add('live'); throttle(); }; f.addEventListener('load',()=>setTimeout(on,g==='quartet'||g==='rally'||g==='lanes'?1800:500)); }
function throttle(){ live.forEach((f,g)=>{ try{ f.contentWindow.postMessage({bc:'throttle',on:cabs[focus].dataset.game!==g},'*'); }catch(e){} }); }
function setFocus(i,{scroll=false}={}){ focus=(i+cabs.length)%cabs.length; cabs.forEach((c,k)=>c.classList.toggle('focus',k===focus)); if(!narrow()) load(cabs[focus]); throttle(); if(scroll) cabs[focus].scrollIntoView({block:'nearest',behavior:reduce?'auto':'smooth'}); }
setFocus(1);
// the neighbours warm up after the home cabinet is running (desktop only; phones show stills and tap to play)
if(!narrow()&&!saveData){ const warm=()=>{ cabs.forEach((c,k)=>{ if(k!==focus) setTimeout(()=>load(c),Math.abs(k-focus)*900); }); }; if('requestIdleCallback' in window) requestIdleCallback(warm,{timeout:4000}); else setTimeout(warm,2500); }
cabs.forEach((c,i)=>{ c.addEventListener('pointerenter',()=>{ if(!touch) setFocus(i); }); c.addEventListener('focus',()=>setFocus(i)); c.addEventListener('click',e=>{ if(i!==focus&&!touch&&!narrow()){ e.preventDefault(); setFocus(i); } }); });
addEventListener('keydown',e=>{ if(e.metaKey||e.ctrlKey||e.altKey) return; const tag=(e.target&&e.target.tagName)||''; if(tag==='INPUT'||tag==='TEXTAREA') return;
  if(e.code==='ArrowLeft'||e.code==='ArrowUp'){ e.preventDefault(); setFocus(focus-1,{scroll:true}); }
  else if(e.code==='ArrowRight'||e.code==='ArrowDown'){ e.preventDefault(); setFocus(focus+1,{scroll:true}); }
  else if(e.code==='Enter'||e.code==='Space'){ if(tag==='A'&&e.target.classList.contains('cab')) return; e.preventDefault(); location.href=cabs[focus].getAttribute('href'); }
  else if(/^Digit[1-5]$/.test(e.code)){ setFocus(Number(e.key)-1,{scroll:true}); } });
// swipe on touch: move the focus along the row without playing
let sx=null; addEventListener('touchstart',e=>{ sx=e.touches[0].clientX; },{passive:true}); addEventListener('touchend',e=>{ if(sx===null) return; const dx=e.changedTouches[0].clientX-sx; sx=null; if(Math.abs(dx)>70&&!narrow()) setFocus(focus+(dx<0?1:-1)); },{passive:true});
document.addEventListener('visibilitychange',()=>{ live.forEach(f=>{ try{ f.contentWindow.postMessage({bc:'throttle',on:document.hidden||cabs[focus].dataset.game!==f.title.split(' ')[0]},'*'); }catch(e){} }); });
addEventListener('resize',()=>{ if(!narrow()) load(cabs[focus]); });
window.__lobby={get focus(){return focus;},setFocus,get live(){return [...live.keys()];},today,dailyPick};
})();
</script>
</body>
</html>
