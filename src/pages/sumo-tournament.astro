---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Nouns Sumo Tournament';
const description = 'A seven-round Nouns sumo basho on PointCast: best-of-3 bouts, rising ranks, and a yusho banner.';
---

<BaseLayout title={title} description={description}>
  <main class="sumo-tournament" data-sumo-tournament>
    <section class="st-shell" aria-labelledby="st-title">
      <header class="st-header">
        <p class="eyebrow">pointcast room</p>
        <h1 id="st-title">Nouns Sumo Tournament</h1>
        <p class="lede">
          Seven Nouns wait on the bracket. Win each best-of-3 match, take a short breath between rounds, and try to leave with the yusho.
        </p>
      </header>

      <section class="tournament-hud" aria-label="tournament status">
        <article class="hud-card hud-card--rank">
          <span>rank</span>
          <strong data-rank>maegashira</strong>
          <small data-rank-note>opening rank</small>
        </article>

        <article class="hud-card">
          <span>round</span>
          <strong data-current-round>1 / 7</strong>
          <small data-tournament-progress>0 / 7 defeated</small>
        </article>

        <article class="hud-card">
          <span>rhythm</span>
          <strong data-opponent-tempo>tempo 1</strong>
          <small>opponent charge</small>
        </article>
      </section>

      <section class="st-layout" aria-label="Nouns sumo tournament">
        <section class="arena-panel" aria-label="active sumo match">
          <section class="score-strip" aria-label="match score">
            <article class="score-card player-card">
              <span class="label">west noun</span>
              <strong data-player-seed>seed --</strong>
              <span class="wins" data-player-wins>0 bouts</span>
            </article>

            <div class="round-card">
              <span data-round-label>round 1 / 7</span>
              <strong data-match-state>ready</strong>
              <small data-bout-label>bout 1</small>
            </div>

            <article class="score-card opponent-card">
              <span class="label">east noun</span>
              <strong data-opponent-seed>seed --</strong>
              <span class="wins" data-opponent-wins>0 bouts</span>
            </article>
          </section>

          <p class="announcer" aria-live="polite" data-announcer>
            The yobidashi sweeps the sand. Press space or tap the charge pad.
          </p>

          <section class="dohyo-wrap" aria-label="Nouns sumo ring">
            <div class="dohyo" data-ring>
              <div class="ring-shadow"></div>
              <div class="ring-rope"></div>
              <div class="ring-sand"></div>
              <div class="ring-center"></div>

              <img class="fighter fighter-left" data-player-fighter src="https://noun.pics/0.svg" alt="west Noun fighter" width="160" height="160" />
              <img class="fighter fighter-right" data-opponent-fighter src="https://noun.pics/1.svg" alt="east Noun fighter" width="160" height="160" />
            </div>

            <div class="rest-panel" data-rest-panel aria-live="polite" hidden>
              <span class="rest-panel__kicker">breather</span>
              <strong data-rest-title>Round cleared.</strong>
              <span data-rest-next>Next: Noun seed --.</span>
              <em><span data-rest-count>5</span>s</em>
            </div>
          </section>

          <section class="meters" aria-label="charge meters">
            <div class="meter-block">
              <div class="meter-label">
                <span>your charge</span>
                <span data-player-charge-label>0%</span>
              </div>
              <div class="meter">
                <span data-player-meter></span>
              </div>
            </div>

            <button class="charge-pad" type="button" data-charge-button>
              <span class="button-main" data-charge-main>charge</span>
              <span class="button-sub" data-charge-sub>space / tap</span>
            </button>

            <div class="meter-block">
              <div class="meter-label">
                <span>their charge</span>
                <span data-opponent-charge-label>0%</span>
              </div>
              <div class="meter">
                <span data-opponent-meter></span>
              </div>
            </div>
          </section>

          <section class="yusho-banner" data-yusho-banner aria-live="polite" hidden>
            <p>yusho</p>
            <h2>Seven rounds cleared.</h2>
            <span data-defeated-seeds>defeated seeds: --</span>
            <blockquote data-haiku-line>Warm sand keeps the crown.</blockquote>
          </section>

          <footer class="sumo-footer">
            <button class="quiet-button" type="button" data-new-basho>new basho</button>
            <a class="quiet-link" href="/sumo">single match</a>
          </footer>
        </section>

        <aside class="bracket-panel" aria-label="eight-noun bracket">
          <header class="bracket-head">
            <p class="eyebrow">8-noun bracket</p>
            <h2>Basho ladder</h2>
            <span data-bracket-caption>player fixed at the west end</span>
          </header>

          <ol class="bracket-list" data-bracket-list></ol>

          <div class="champion-slot" data-champion-slot>
            <span>champion</span>
            <strong data-champion-seed>pending</strong>
          </div>
        </aside>
      </section>
    </section>
  </main>

  <script is:inline>
    (() => {
      const room = document.querySelector('[data-sumo-tournament]');
      if (!room) return;

      const els = {
        rank: room.querySelector('[data-rank]'),
        rankNote: room.querySelector('[data-rank-note]'),
        currentRound: room.querySelector('[data-current-round]'),
        tournamentProgress: room.querySelector('[data-tournament-progress]'),
        opponentTempo: room.querySelector('[data-opponent-tempo]'),
        playerSeed: room.querySelector('[data-player-seed]'),
        opponentSeed: room.querySelector('[data-opponent-seed]'),
        playerWins: room.querySelector('[data-player-wins]'),
        opponentWins: room.querySelector('[data-opponent-wins]'),
        roundLabel: room.querySelector('[data-round-label]'),
        boutLabel: room.querySelector('[data-bout-label]'),
        matchState: room.querySelector('[data-match-state]'),
        announcer: room.querySelector('[data-announcer]'),
        playerFighter: room.querySelector('[data-player-fighter]'),
        opponentFighter: room.querySelector('[data-opponent-fighter]'),
        playerMeter: room.querySelector('[data-player-meter]'),
        opponentMeter: room.querySelector('[data-opponent-meter]'),
        playerChargeLabel: room.querySelector('[data-player-charge-label]'),
        opponentChargeLabel: room.querySelector('[data-opponent-charge-label]'),
        chargeButton: room.querySelector('[data-charge-button]'),
        chargeMain: room.querySelector('[data-charge-main]'),
        chargeSub: room.querySelector('[data-charge-sub]'),
        newBasho: room.querySelector('[data-new-basho]'),
        restPanel: room.querySelector('[data-rest-panel]'),
        restTitle: room.querySelector('[data-rest-title]'),
        restNext: room.querySelector('[data-rest-next]'),
        restCount: room.querySelector('[data-rest-count]'),
        yushoBanner: room.querySelector('[data-yusho-banner]'),
        defeatedSeeds: room.querySelector('[data-defeated-seeds]'),
        haikuLine: room.querySelector('[data-haiku-line]'),
        bracketList: room.querySelector('[data-bracket-list]'),
        bracketCaption: room.querySelector('[data-bracket-caption]'),
        championSlot: room.querySelector('[data-champion-slot]'),
        championSeed: room.querySelector('[data-champion-seed]'),
      };

      const ringLimit = 43;
      const startOffset = 22;
      const maxCharge = 100;
      const peakWindow = 88;
      const minLungeCharge = 52;
      const restMs = 5000;

      const ranks = [
        { min: 0, label: 'maegashira', note: 'opening rank' },
        { min: 1, label: 'komusubi', note: 'first sanyaku step' },
        { min: 2, label: 'sekiwake', note: 'steady pressure' },
        { min: 3, label: 'ozeki', note: 'championship pace' },
        { min: 5, label: 'yokozuna', note: 'rope bearer' },
      ];

      const lines = {
        ready: ['The yobidashi sweeps the sand. Press space or tap the charge pad.', 'Two Nouns settle at the salt line. The room gets quiet.', 'Hands down. Sand still. Charge when ready.'],
        charge: ['The bracket leans in.', 'Small feet, careful force.', 'The sand starts to remember the match.', 'A patient tachi-ai is forming.'],
        player: ['West Noun catches the timing and slides forward.', 'A clean little shove from the fixed end of the bracket.', 'West Noun finds the crest of the charge.'],
        opponent: ['East Noun answers on rhythm.', 'A patient push comes back from the bracket.', 'East Noun catches the opening.'],
        draw: ['Both Nouns bump and settle back into the sand.', 'Equal push. The dohyo keeps them both.', 'A soft collision, no winner yet.'],
      };

      const haikuA = ['Salt line listens', 'Seven seeds bow', 'Warm rope rises', 'Still sand answers', 'Small feet thunder'];
      const haikuB = ['under soft El Segundo light', 'where the bracket breathes slowly', 'as pixel glasses shine', 'between tap and tachi-ai', 'inside the quiet ring'];
      const haikuC = ['the crown stays warm', 'a yusho rests', 'morning keeps score', 'the dohyo remembers', 'the room exhales'];

      const state = {
        playerSeed: 0, opponents: [], defeated: [], matchIndex: 0,
        playerWins: 0, opponentWins: 0, bout: 1,
        playerX: -startOffset, opponentX: startOffset,
        playerCharge: 0, opponentCharge: 0,
        charging: false, resolving: false, resting: false,
        matchOver: false, tournamentOver: false,
        lastPlayerTap: 0, lastAiTap: 0, aiBeat: 520,
        raf: 0, restInterval: 0, restTimeout: 0,
      };

      function nounUrl(seed) { return `https://noun.pics/${seed}.svg`; }
      function clamp(value, min, max) { return Math.max(min, Math.min(max, value)); }
      function pickLine(group) { const set = lines[group]; return set[Math.floor(Math.random() * set.length)]; }
      function setAnnouncer(text) { els.announcer.textContent = text; }
      function currentOpponentSeed() { return state.opponents[state.matchIndex]; }
      function boutWord(count) { return `${count} ${count === 1 ? 'bout' : 'bouts'}`; }
      function uniqueSeeds(count) { const seeds = []; while (seeds.length < count) { const seed = Math.floor(Math.random() * 1200); if (!seeds.includes(seed)) seeds.push(seed); } return seeds; }
      function rankForWins(wins) { let current = ranks[0]; for (const rank of ranks) { if (wins >= rank.min) current = rank; } return current; }
      function setPhase(phase) { room.dataset.phase = phase; updateControls(); }
      function updateControls() {
        const phase = room.dataset.phase;
        const locked = phase === 'rest' || phase === 'resolving';
        els.chargeButton.disabled = locked;
        if (state.tournamentOver) { els.chargeMain.textContent = 'new basho'; els.chargeSub.textContent = 'space / tap'; }
        else if (phase === 'rest') { els.chargeMain.textContent = 'rest'; els.chargeSub.textContent = 'next match soon'; }
        else { els.chargeMain.textContent = 'charge'; els.chargeSub.textContent = 'space / tap'; }
      }
      function updateFighters() { els.playerFighter.style.setProperty('--x', `${state.playerX}%`); els.opponentFighter.style.setProperty('--x', `${state.opponentX}%`); }
      function updateMeters() {
        const player = Math.round(state.playerCharge), opponent = Math.round(state.opponentCharge);
        els.playerMeter.style.width = `${player}%`; els.opponentMeter.style.width = `${opponent}%`;
        els.playerChargeLabel.textContent = `${player}%`; els.opponentChargeLabel.textContent = `${opponent}%`;
        els.playerMeter.dataset.hot = player >= peakWindow ? 'true' : 'false';
        els.opponentMeter.dataset.hot = opponent >= peakWindow ? 'true' : 'false';
      }
      function updateTournamentHud() {
        const wins = state.defeated.length, rank = rankForWins(wins), round = Math.min(state.matchIndex + 1, 7);
        els.rank.textContent = rank.label; els.rankNote.textContent = rank.note;
        els.currentRound.textContent = state.tournamentOver && wins === 7 ? '7 / 7' : `${round} / 7`;
        els.tournamentProgress.textContent = `${wins} / 7 defeated`;
        els.opponentTempo.textContent = `tempo ${Math.min(state.matchIndex + 1, 7)}`;
      }
      function updateScore() {
        els.playerWins.textContent = boutWord(state.playerWins);
        els.opponentWins.textContent = boutWord(state.opponentWins);
        els.roundLabel.textContent = state.tournamentOver ? 'basho' : `round ${state.matchIndex + 1} / 7`;
        els.boutLabel.textContent = state.tournamentOver ? 'finished' : `bout ${state.bout}`;
        if (state.tournamentOver && state.defeated.length === 7) els.matchState.textContent = 'yusho';
        else if (state.tournamentOver) els.matchState.textContent = 'finished';
        else if (state.resting) els.matchState.textContent = 'rest';
        else if (state.resolving) els.matchState.textContent = 'push';
        else if (state.charging) els.matchState.textContent = 'charging';
        else els.matchState.textContent = 'ready';
      }
      function renderBracket() {
        const slots = [{ type: 'player', seed: state.playerSeed, label: 'YOU', status: state.tournamentOver && state.defeated.length === 7 ? 'champion' : state.tournamentOver ? 'stopped' : 'fixed', mark: state.tournamentOver && state.defeated.length === 7 ? 'YUSHO' : 'ANCHOR' }];
        state.opponents.forEach((seed, index) => {
          let status = 'waiting', mark = '--';
          if (index < state.defeated.length) { status = 'cleared'; mark = 'WIN'; }
          else if (state.tournamentOver && index === state.matchIndex) { status = 'lost'; mark = 'OUT'; }
          else if (!state.tournamentOver && index === state.matchIndex) { status = 'current'; mark = 'LIVE'; }
          slots.push({ type: 'opponent', seed, label: `R${index + 1}`, status, mark });
        });
        els.bracketList.innerHTML = slots.map((slot) => `<li class="bracket-slot bracket-slot--${slot.status}"><span class="bracket-arm" aria-hidden="true"></span><span class="bracket-noun"><img src="${nounUrl(slot.seed)}" alt="" width="44" height="44" loading="lazy" /></span><span class="bracket-copy"><span>${slot.label}</span><strong>Noun ${slot.seed}</strong><small>${slot.type === 'player' ? 'fixed bracket end' : slot.status === 'cleared' ? 'defeated' : slot.status === 'current' ? 'on the dohyo' : slot.status === 'lost' ? 'kept the ring' : 'waiting'}</small></span><span class="bracket-mark">${slot.mark}</span></li>`).join('');
        if (state.defeated.length === 7) { els.championSlot.dataset.complete = 'true'; els.championSeed.textContent = `Noun ${state.playerSeed}`; els.bracketCaption.textContent = 'yusho bracket complete'; }
        else if (state.tournamentOver) { els.championSlot.dataset.complete = 'false'; els.championSeed.textContent = 'no yusho'; els.bracketCaption.textContent = 'single elimination finished'; }
        else { els.championSlot.dataset.complete = 'false'; els.championSeed.textContent = 'pending'; els.bracketCaption.textContent = 'player fixed at the west end'; }
      }
      function resetBout() {
        state.playerX = -startOffset; state.opponentX = startOffset;
        state.playerCharge = 0; state.opponentCharge = 0;
        state.charging = false; state.resolving = false; state.matchOver = false;
        state.lastPlayerTap = 0; state.lastAiTap = performance.now();
        state.aiBeat = nextAiBeat();
        setPhase('ready'); updateFighters(); updateMeters(); updateScore();
      }
      function beginMatch(index) {
        state.matchIndex = index; state.playerWins = 0; state.opponentWins = 0;
        state.bout = 1; state.resting = false; state.matchOver = false;
        const opponent = currentOpponentSeed();
        els.playerSeed.textContent = `seed ${state.playerSeed}`;
        els.opponentSeed.textContent = `seed ${opponent}`;
        els.playerFighter.src = nounUrl(state.playerSeed);
        els.opponentFighter.src = nounUrl(opponent);
        els.restPanel.hidden = true;
        updateTournamentHud(); renderBracket(); resetBout();
      }
      function clearRest() {
        if (state.restInterval) window.clearInterval(state.restInterval);
        if (state.restTimeout) window.clearTimeout(state.restTimeout);
        state.restInterval = 0; state.restTimeout = 0; state.resting = false;
        els.restPanel.hidden = true;
      }
      function newTournament() {
        clearRest();
        const seeds = uniqueSeeds(8);
        state.playerSeed = seeds[0]; state.opponents = seeds.slice(1);
        state.defeated = []; state.matchIndex = 0;
        state.tournamentOver = false; state.matchOver = false;
        els.yushoBanner.hidden = true;
        delete els.championSlot.dataset.complete;
        beginMatch(0); setAnnouncer(pickLine('ready'));
      }
      function beginCharging() {
        if (state.tournamentOver || state.resting || state.matchOver || state.resolving) return;
        state.charging = true; setPhase('charging'); updateScore();
      }
      function playerTap() {
        if (state.tournamentOver) { newTournament(); return; }
        if (state.resting || state.matchOver || state.resolving) return;
        const now = performance.now();
        beginCharging();
        if (now - state.lastPlayerTap > 760) state.playerCharge = Math.max(12, state.playerCharge * 0.55);
        state.playerCharge = clamp(state.playerCharge + 13 + Math.random() * 5, 0, maxCharge);
        state.lastPlayerTap = now;
        if (state.playerCharge >= peakWindow || state.opponentCharge >= maxCharge) resolvePush('player');
        else if (Math.random() > 0.7) setAnnouncer(pickLine('charge'));
        updateMeters();
      }
      function nextAiBeat() {
        const difficulty = state.matchIndex;
        const base = clamp(545 - difficulty * 38, 270, 545);
        const jitter = clamp(180 - difficulty * 16, 58, 180);
        return base + Math.random() * jitter;
      }
      function aiTap(now) {
        if (state.tournamentOver || state.resting || state.matchOver || state.resolving || !state.charging) return;
        const pressure = state.playerCharge > 48 ? -76 : 0;
        const nextBeat = Math.max(230, state.aiBeat + pressure);
        if (now - state.lastAiTap >= nextBeat) {
          const difficulty = state.matchIndex;
          state.opponentCharge = clamp(state.opponentCharge + 9 + difficulty * 0.85 + Math.random() * 10, 0, maxCharge);
          state.lastAiTap = now; state.aiBeat = nextAiBeat();
          if (state.opponentCharge >= peakWindow || state.playerCharge >= maxCharge) resolvePush('opponent');
          updateMeters();
        }
      }
      function decayCharge() {
        if (!state.charging || state.resolving || state.resting || state.tournamentOver || state.matchOver) return;
        const difficulty = state.matchIndex;
        state.playerCharge = clamp(state.playerCharge - 0.18, 0, maxCharge);
        state.opponentCharge = clamp(state.opponentCharge - Math.max(0.08, 0.14 - difficulty * 0.006), 0, maxCharge);
        updateMeters();
      }
      function resolvePush(first) {
        if (state.resolving || state.resting || state.matchOver || state.tournamentOver) return;
        state.resolving = true; state.charging = false; setPhase('resolving');
        const playerCharge = state.playerCharge, opponentCharge = state.opponentCharge;
        const delta = playerCharge - opponentCharge;
        const firstBonus = first === 'player' ? 8 : -8;
        const net = delta + firstBonus;
        if (Math.abs(net) < 10 || Math.max(playerCharge, opponentCharge) < minLungeCharge) {
          const settle = net * 0.035;
          state.playerX = clamp(state.playerX + settle, -ringLimit, ringLimit);
          state.opponentX = clamp(state.opponentX + settle, -ringLimit, ringLimit);
          setAnnouncer(pickLine('draw'));
        } else if (net > 0) {
          const impulse = clamp(7 + net * 0.18, 7, 18);
          state.playerX = clamp(state.playerX + impulse * 0.22, -ringLimit, ringLimit);
          state.opponentX = clamp(state.opponentX + impulse, -60, 60);
          setAnnouncer(pickLine('player'));
        } else {
          const impulse = clamp(7 + Math.abs(net) * 0.18, 7, 18);
          state.playerX = clamp(state.playerX - impulse, -60, 60);
          state.opponentX = clamp(state.opponentX - impulse * 0.22, -ringLimit, ringLimit);
          setAnnouncer(pickLine('opponent'));
        }
        updateFighters(); updateScore();
        window.setTimeout(() => {
          const playerOut = state.playerX <= -ringLimit;
          const opponentOut = state.opponentX >= ringLimit;
          if (playerOut || opponentOut) { finishBout(opponentOut ? 'player' : 'opponent'); return; }
          state.playerCharge = 0; state.opponentCharge = 0; state.resolving = false;
          setPhase('ready'); updateMeters(); updateScore();
        }, 520);
      }
      function finishBout(winner) {
        if (winner === 'player') { state.playerWins += 1; setAnnouncer(`West Noun keeps the ring. ${state.playerWins === 2 ? 'Match complete.' : 'The sand resets.'}`); }
        else { state.opponentWins += 1; setAnnouncer(`East Noun keeps the ring. ${state.opponentWins === 2 ? 'Match complete.' : 'The sand resets.'}`); }
        if (state.playerWins === 2 || state.opponentWins === 2) { finishMatch(winner); return; }
        state.bout += 1; updateScore();
        window.setTimeout(() => { resetBout(); setAnnouncer(`Bout ${state.bout}. Both Nouns return to the salt line.`); }, 1100);
      }
      function finishMatch(winner) {
        state.matchOver = true; state.resolving = false; state.charging = false;
        if (winner === 'opponent') { finishTournamentLoss(); return; }
        const clearedRound = state.matchIndex + 1;
        const defeatedSeed = currentOpponentSeed();
        state.defeated.push(defeatedSeed);
        updateTournamentHud(); renderBracket();
        if (state.defeated.length === 7) { finishYusho(); return; }
        startRest(clearedRound, state.opponents[state.matchIndex + 1]);
      }
      function startRest(clearedRound, nextSeed) {
        state.resting = true; setPhase('rest'); updateScore();
        els.restTitle.textContent = `Round ${clearedRound} cleared.`;
        els.restNext.textContent = `Next: Noun seed ${nextSeed}.`;
        els.restCount.textContent = '5'; els.restPanel.hidden = false;
        setAnnouncer(`Round ${clearedRound} cleared. Next: Noun seed ${nextSeed}.`);
        const restEnds = performance.now() + restMs;
        state.restInterval = window.setInterval(() => {
          const left = Math.max(0, Math.ceil((restEnds - performance.now()) / 1000));
          els.restCount.textContent = String(left);
        }, 160);
        state.restTimeout = window.setTimeout(() => {
          clearRest(); beginMatch(state.matchIndex + 1);
          setAnnouncer(`Round ${state.matchIndex + 1}. Noun seed ${currentOpponentSeed()} steps onto the dohyo.`);
        }, restMs);
      }
      function finishTournamentLoss() {
        state.tournamentOver = true;
        const rank = rankForWins(state.defeated.length);
        setPhase('lost'); updateTournamentHud(); updateScore(); renderBracket();
        setAnnouncer(`Tournament finished. You reached ${rank.label}. Press to start a new basho.`);
      }
      function hashSeeds(seeds) { return seeds.reduce((acc, seed, index) => (acc * 31 + seed * (index + 3)) % 104729, 17); }
      function championHaiku() {
        const allSeeds = [state.playerSeed].concat(state.defeated);
        const hash = hashSeeds(allSeeds);
        const a = haikuA[hash % haikuA.length];
        const b = haikuB[Math.floor(hash / haikuA.length) % haikuB.length];
        const c = haikuC[Math.floor(hash / (haikuA.length * haikuB.length)) % haikuC.length];
        return `${a} / ${b} / ${c}`;
      }
      function finishYusho() {
        state.tournamentOver = true;
        setPhase('yusho'); updateTournamentHud(); updateScore(); renderBracket();
        els.defeatedSeeds.textContent = `defeated seeds: ${state.defeated.join(', ')}`;
        els.haikuLine.textContent = championHaiku();
        els.yushoBanner.hidden = false;
        setAnnouncer('Yusho. Seven Nouns bow out, and the bracket closes around the champion.');
      }
      function frame(now) { aiTap(now); decayCharge(); state.raf = window.requestAnimationFrame(frame); }

      els.chargeButton.addEventListener('click', playerTap);
      els.newBasho.addEventListener('click', newTournament);
      window.addEventListener('keydown', (event) => {
        if (event.code !== 'Space') return;
        const target = event.target;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON', 'A'].includes(target.tagName)) return;
        event.preventDefault(); playerTap();
      });
      newTournament();
      state.raf = window.requestAnimationFrame(frame);
      window.addEventListener('pagehide', () => { window.cancelAnimationFrame(state.raf); clearRest(); });
    })();
  </script>
</BaseLayout>

<style>
  :global(body) {
    background:
      linear-gradient(180deg, rgba(247, 239, 218, 0.78), rgba(232, 219, 191, 0.58)),
