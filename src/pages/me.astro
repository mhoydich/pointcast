---
import BlockLayout from '../layouts/BlockLayout.astro';
import AuthMenu from '../components/AuthMenu.astro';
import contracts from '../data/contracts.json';
import { isProfileContractConfigured } from '../lib/profile-object.mjs';

const description = 'Your private PointCast identity and Tezos holdings, keyed only to wallets linked to this signed session.';
const profileContract = contracts.profile_objects.mainnet;
const profileClaimOpen = isProfileContractConfigured(profileContract);
---

<BlockLayout title="Me" description={description}>
  <main class="me" data-me-root data-me-noun-default="404" data-me-state="loading">
    <nav class="me__crumb" aria-label="Breadcrumb">
      <a href="/">← PointCast</a>
      <span aria-hidden="true">/</span>
      <span>me</span>
      <a class="me__json-link" href="/me.json">JSON twin ↗</a>
    </nav>

    <section class="me__loading" data-me-loading aria-live="polite">
      <p class="me__kicker">PRIVATE CHANNEL · SESSION CHECK</p>
      <p>Reading your PointCast session…</p>
    </section>

    <section class="me-door" data-me-signed-out hidden aria-label="PointCast sign-in">
      <div class="me-door__signal" aria-hidden="true">
        <span>PC</span>
        <i></i><i></i><i></i>
      </div>
      <div class="me-door__copy">
        <p class="me__kicker">PRIVATE CHANNEL · SIGN-IN REQUIRED</p>
        <h1>Your shelf starts with your session.</h1>
        <p>
          Sign in to see the identities and Tezos wallets you linked to PointCast.
          Nothing on this page falls back to another person’s wallet.
        </p>
        <AuthMenu autoOpen={true} />
        <p class="me-door__privacy">The session cookie is HttpOnly. Holdings are public-chain data fetched only after this session is accepted.</p>
      </div>
    </section>

    <div data-me-private hidden>
      <header class="me-head">
        <div class="me-head__identity">
          <img
            class="me-head__noun"
            src="https://noun.pics/404.svg"
            alt="Your PointCast companion Noun"
            width="120"
            height="120"
            data-me-noun
          />
          <div>
            <p class="me__kicker">CH.ME · PRIVATE · D1 SESSION</p>
            <h1 data-me-name>PointCast member</h1>
            <p class="me-head__dek">One account. Every identity you deliberately linked. Every PointCast object those Tezos wallets hold.</p>
          </div>
        </div>

        <div class="me-head__actions">
          <button type="button" data-me-action="link">Link another</button>
          <button type="button" class="me-head__signout" data-me-action="signout">Sign out</button>
          <div class="me-auth-bridge" aria-label="Link another identity">
            <AuthMenu />
          </div>
        </div>

        <ul class="me-identities" data-me-identities aria-label="Linked identities"></ul>
      </header>

      <section class="me-passkeys" data-me-passkeys aria-label="Your passkeys">
        <header class="me-section-head">
          <div>
            <p class="me__kicker">RETURN KEY · FACE ID / TOUCH ID</p>
            <h2>Passkeys</h2>
          </div>
          <span data-me-passkey-count>Checking…</span>
        </header>
        <form class="me-passkeys__form" data-me-passkey-form>
          <label>
            <span>Device label</span>
            <input name="label" type="text" maxlength="64" placeholder="This device" autocomplete="off" />
          </label>
          <button type="submit">Add a passkey to this device</button>
        </form>
        <output class="me-passkeys__status" data-me-passkey-status aria-live="polite"></output>
        <ul class="me-passkeys__list" data-me-passkey-list></ul>
      </section>

      <section class="me-summary" aria-label="Your PointCast utilities">
        <a class="me-summary__card me-summary__card--passport" href="/passport">
          <span class="me-summary__code">01 · PASSPORT</span>
          <strong>Carry the journey</strong>
          <span data-me-stamp-count>Browser-local stamps · count unavailable</span>
          <b aria-hidden="true">→</b>
        </a>
        <a class="me-summary__card me-summary__card--seals" href="/townsfolk">
          <span class="me-summary__code">02 · SEALS</span>
          <strong>See the townsfolk</strong>
          <span>Published wallet-signed passports</span>
          <b aria-hidden="true">→</b>
        </a>
        <article class="me-summary__card me-summary__card--companion" data-me-companion>
          <span class="me-summary__code">03 · COMPANION</span>
          <span class="me-companion__body">
            <img src="https://noun.pics/404.svg" alt="" width="48" height="48" data-me-pet-image />
            <span>
              <strong data-me-pet-name>Signal Pup</strong>
              <span data-me-pet-state>sleepy signal · no care yet</span>
            </span>
          </span>
          <a href="/pet">Visit companion →</a>
        </article>
      </section>

      <section class="me-dogs" aria-label="Your Kennel Club dogs">
        <header class="me-section-head">
          <div>
            <p class="me__kicker">KENNEL CLUB · CLAIM LEDGER</p>
            <h2>Your dogs</h2>
          </div>
          <a class="me-dogs__club" href="/kennel-club">Visit the club →</a>
        </header>
        <div class="me-dogs__rows" data-me-dogs></div>
      </section>

      <section
        class="me-claim"
        data-me-claim
        data-me-claim-contract={profileContract}
        data-me-claim-open={String(profileClaimOpen)}
        aria-label="Profile object claim"
      >
        <header class="me-section-head">
          <div>
            <p class="me__kicker">PROFILE OBJECT · OWNED HANDLE</p>
            <h2>Claim your handle</h2>
          </div>
          <a class="me-claim__browse" href="/p">Browse profile objects →</a>
        </header>
        {profileClaimOpen ? (
          <form class="me-claim__form" data-me-claim-form novalidate>
            <label class="me-claim__label">
              <span>Handle</span>
              <span class="me-claim__field">
                <b aria-hidden="true">@</b>
                <input
                  name="handle"
                  type="text"
                  inputmode="text"
                  autocomplete="nickname"
                  minlength="3"
                  maxlength="24"
                  pattern={'[a-z0-9-]{3,24}'}
                  placeholder="your-handle"
                  required
                />
              </span>
            </label>
            <button type="submit">Check claim readiness →</button>
            <output class="me-claim__result" data-me-claim-result aria-live="polite">
              One handle, one owned object. This door checks the handle; the paused contract submits nothing yet.
            </output>
          </form>
        ) : (
          <p class="me-claim__closed" data-me-claim-closed>
            Claims open when the contract lands. <code>profile_objects.mainnet</code> is still empty, so no handle can be
            reserved here and no wallet is substituted while that address is unset.
          </p>
        )}
      </section>

      <section class="me-wallets" aria-label="Linked Tezos wallets">
        <header class="me-section-head">
          <div>
            <p class="me__kicker">LINKED TEZOS IDENTITIES</p>
            <h2>Wallets in this session</h2>
          </div>
          <span data-me-wallet-count>0 wallets</span>
        </header>
        <div class="me-wallets__grid" data-me-wallets></div>
      </section>

      <a name="holdings" class="me-holdings-anchor" data-me-holdings-anchor aria-hidden="true"></a>
      <section class="me-holdings" data-me-holdings aria-label="PointCast holdings">
        <header class="me-section-head">
          <div>
            <p class="me__kicker">HOLDINGS · LIVE FROM TZKT</p>
            <h2>PointCast collections</h2>
          </div>
          <span data-me-updated>Waiting for session…</span>
        </header>
        <div class="me-holdings__status" data-me-status aria-live="polite">Loading the linked shelves…</div>
        <div class="me-collections" data-me-collections></div>
      </section>
    </div>
  </main>
</BlockLayout>

<script>
  import type { AuthIdentity, PointCastUser } from '../lib/auth/types';
  import {
    getPasskeys,
    getSession,
    logout,
    registerPasskey,
    removePasskey,
    type PasskeySummary,
  } from '../lib/auth/client';
  import { readPetSnapshot } from '../lib/pet-state';

  type HoldingToken = {
    tokenId: string;
    balance: string;
    name: string;
    thumbnailUrl: string;
    objktUrl: string;
  };
  type Collection = {
    slug: string;
    name: string;
    href: string;
    contract: string;
    symbol: string;
    tokenBalanceCount: number;
    unitBalance: string;
    tokens: HoldingToken[];
  };
  type Wallet = {
    address: string;
    tzktUrl: string;
    totalTokenBalanceCount: number;
    everythingElseCount: number;
    collections: Collection[];
    cache: 'hit' | 'miss' | 'unavailable';
    error?: string;
  };
  type HoldingsPayload = {
    ok: true;
    user: PointCastUser;
    wallets: Wallet[];
    collections: Array<Pick<Collection, 'slug' | 'name' | 'href' | 'contract' | 'symbol'>>;
    dogs: Array<{
      id: string;
      tokenId: number;
      sitting: string;
      status: 'held' | 'delivered' | 'failed';
      opHash: string | null;
      deliveredTo: string | null;
      createdAt: string;
    }>;
    generatedAt: string;
    cacheTtlSeconds: number;
  };
  type MeWindow = Window & {
    __pointCastMeAbort?: AbortController;
    __pointCastMePageLoadInstalled?: boolean;
  };

  const shortAddress = (address: string): string => (
    address.length > 14 ? `${address.slice(0, 7)}…${address.slice(-5)}` : address
  );

  function create<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function readNounId(root: HTMLElement): number {
    let value = Number(root.dataset.meNounDefault || '404');
    try {
      const stored = Number(window.localStorage.getItem('pc:visitor:noun'));
      if (Number.isInteger(stored) && stored >= 0 && stored < 10000) value = stored;
    } catch {
      // The default remains available in storage-restricted browsers.
    }
    return value;
  }

  function stampCount(): number {
    try {
      const parsed = JSON.parse(window.localStorage.getItem('pc:passport:stamps') || '{}');
      if (Array.isArray(parsed)) return parsed.length;
      return parsed && typeof parsed === 'object' ? Object.keys(parsed).length : 0;
    } catch {
      return 0;
    }
  }

  function renderLocalState(root: HTMLElement): void {
    const nounId = readNounId(root);
    root.querySelectorAll<HTMLImageElement>('[data-me-noun]').forEach((image) => {
      image.src = `https://noun.pics/${nounId}.svg`;
      image.alt = `Your PointCast companion, Noun ${nounId}`;
    });
    const stampLabel = root.querySelector<HTMLElement>('[data-me-stamp-count]');
    if (stampLabel) {
      const count = stampCount();
      stampLabel.textContent = `${count} browser-local stamp${count === 1 ? '' : 's'} · open passport`;
    }

    const pet = readPetSnapshot();
    const petImage = root.querySelector<HTMLImageElement>('[data-me-pet-image]');
    const petName = root.querySelector<HTMLElement>('[data-me-pet-name]');
    const petState = root.querySelector<HTMLElement>('[data-me-pet-state]');
    if (petImage) petImage.src = `https://noun.pics/${pet.nounId}.svg`;
    if (petName) petName.textContent = pet.name;
    if (petState) {
      petState.textContent = `${pet.state} · ${pet.careCount} care receipt${pet.careCount === 1 ? '' : 's'}`;
    }
  }

  function renderIdentities(root: HTMLElement, identities: AuthIdentity[]): void {
    const list = root.querySelector<HTMLElement>('[data-me-identities]');
    if (!list) return;
    const nodes = identities.map((identity) => {
      const item = create('li', 'me-identity');
      if (identity.avatar) {
        const avatar = create('img', 'me-identity__avatar');
        avatar.src = identity.avatar;
        avatar.alt = '';
        avatar.width = 28;
        avatar.height = 28;
        item.append(avatar);
      } else {
        item.append(create('span', 'me-identity__provider', identity.provider.slice(0, 3)));
      }
      const copy = create('span', 'me-identity__copy');
      copy.append(
        create('strong', '', identity.name || shortAddress(identity.id)),
        create('small', '', `${identity.provider} · ${shortAddress(identity.id)}`),
      );
      item.append(copy);
      return item;
    });
    list.replaceChildren(...nodes);
  }

  function renderPasskeys(root: HTMLElement, passkeys: PasskeySummary[]): void {
    const count = root.querySelector<HTMLElement>('[data-me-passkey-count]');
    const list = root.querySelector<HTMLElement>('[data-me-passkey-list]');
    if (count) count.textContent = `${passkeys.length} registered`;
    if (!list) return;
    if (!passkeys.length) {
      list.replaceChildren(create('li', 'me-passkeys__empty', 'No passkey registered yet. Your current sign-in still works.'));
      return;
    }
    list.replaceChildren(...passkeys.map((passkey) => {
      const item = create('li', 'me-passkey');
      const copy = create('span', 'me-passkey__copy');
      copy.append(
        create('strong', '', passkey.label),
        create('small', '', passkey.lastUsedAt
          ? `last used ${new Date(passkey.lastUsedAt).toLocaleDateString()}`
          : `added ${new Date(passkey.createdAt).toLocaleDateString()}`),
      );
      const remove = create('button', '', 'Remove');
      remove.type = 'button';
      remove.dataset.meAction = 'passkey-remove';
      remove.dataset.credentialId = passkey.credentialId;
      item.append(copy, remove);
      return item;
    }));
  }

  async function refreshPasskeys(root: HTMLElement): Promise<void> {
    const status = root.querySelector<HTMLOutputElement>('[data-me-passkey-status]');
    try {
      renderPasskeys(root, await getPasskeys());
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Could not read passkeys.';
    }
  }

  function renderWallets(root: HTMLElement, wallets: Wallet[]): void {
    const grid = root.querySelector<HTMLElement>('[data-me-wallets]');
    const count = root.querySelector<HTMLElement>('[data-me-wallet-count]');
    if (count) count.textContent = `${wallets.length} linked wallet${wallets.length === 1 ? '' : 's'}`;
    if (!grid) return;
    if (!wallets.length) {
      const empty = create('div', 'me-empty');
      empty.append(
        create('strong', '', 'No Tezos identity linked yet.'),
        create('p', '', 'Use “Link another” and choose Kukai. This shelf never reads a browser-only or sample wallet.'),
      );
      grid.replaceChildren(empty);
      return;
    }

    grid.replaceChildren(...wallets.map((wallet, index) => {
      const card = create('article', 'me-wallet');
      const head = create('div', 'me-wallet__head');
      head.append(
        create('span', 'me-wallet__number', String(index + 1).padStart(2, '0')),
        create('strong', '', shortAddress(wallet.address)),
      );
      const address = create('code', 'me-wallet__address', wallet.address);
      const facts = create('div', 'me-wallet__facts');
      facts.append(
        create('span', '', `${wallet.totalTokenBalanceCount} token balance${wallet.totalTokenBalanceCount === 1 ? '' : 's'}`),
        create('span', '', `${wallet.everythingElseCount} outside PointCast`),
      );
      const link = create('a', 'me-wallet__link', 'Everything else on TzKT ↗');
      link.href = wallet.tzktUrl;
      link.target = '_blank';
      link.rel = 'noopener';
      card.append(head, address, facts, link);
      if (wallet.error) card.append(create('p', 'me-wallet__error', 'TzKT is temporarily unavailable for this wallet.'));
      return card;
    }));
  }

  function renderDogs(root: HTMLElement, payload: HoldingsPayload): void {
    const rows = root.querySelector<HTMLElement>('[data-me-dogs]');
    if (!rows) return;
    if (!payload.dogs.length) {
      const empty = create('div', 'me-empty');
      empty.append(
        create('strong', '', 'No September Sitting claims yet.'),
        create('p', '', 'Claim today’s dog free at the Kennel Club. You do not need a wallet first.'),
      );
      rows.replaceChildren(empty);
      return;
    }

    rows.replaceChildren(...payload.dogs.map((dog) => {
      const row = create('article', `me-dog me-dog--${dog.status}`);
      const art = create('img', 'me-dog__art');
      const sitting = String(dog.tokenId + 1).padStart(2, '0');
      art.src = `/images/kennel-club/september-sitting/${sitting}-${dog.sitting.toLowerCase()}.webp`;
      art.alt = dog.sitting;
      art.width = 64;
      art.height = 80;
      const copy = create('span', 'me-dog__copy');
      copy.append(
        create('strong', '', `${sitting} · ${dog.sitting}`),
        create('small', '', dog.status === 'held'
          ? 'held for you — link a wallet to take it home'
          : dog.status === 'delivered'
            ? `delivered${dog.deliveredTo ? ` · ${shortAddress(dog.deliveredTo)}` : ''}`
            : 'delivery stopped — retry from the Kennel Club'),
      );
      row.append(art, copy);
      if (dog.status === 'held') {
        const link = create('a', 'me-dog__action', 'Link wallet →');
        link.href = '/me?link=wallet';
        link.dataset.meAction = 'link';
        row.append(link);
      } else if (dog.opHash) {
        const receipt = create('a', 'me-dog__action', 'Receipt ↗');
        receipt.href = `https://tzkt.io/${dog.opHash}`;
        receipt.target = '_blank';
        receipt.rel = 'noopener';
        row.append(receipt);
      }
      return row;
    }));
  }

  function renderCollections(root: HTMLElement, payload: HoldingsPayload): void {
    const container = root.querySelector<HTMLElement>('[data-me-collections]');
    if (!container) return;
    if (!payload.wallets.length) {
      container.replaceChildren();
      return;
    }

    container.replaceChildren(...payload.collections.map((descriptor) => {
      const section = create('section', 'me-collection');
      section.dataset.collection = descriptor.slug;
      const header = create('header', 'me-collection__head');
      const titleLink = create('a', 'me-collection__title', descriptor.name);
      titleLink.href = descriptor.href;
      const contractLink = create('a', 'me-collection__contract', `${descriptor.symbol || 'FA2'} · ${shortAddress(descriptor.contract)} ↗`);
      contractLink.href = `https://tzkt.io/${descriptor.contract}/tokens`;
      contractLink.target = '_blank';
      contractLink.rel = 'noopener';
      const totalTokens = payload.wallets.reduce((sum, wallet) => {
        const collection = wallet.collections.find((item) => item.slug === descriptor.slug);
        return sum + (collection?.tokenBalanceCount ?? 0);
      }, 0);
      header.append(titleLink, create('span', 'me-collection__count', `${totalTokens} object${totalTokens === 1 ? '' : 's'}`), contractLink);
      section.append(header);

      const walletLanes = create('div', 'me-collection__wallets');
      payload.wallets.forEach((wallet) => {
        const holdings = wallet.collections.find((item) => item.slug === descriptor.slug);
        const lane = create('div', 'me-lane');
        const laneHead = create('div', 'me-lane__head');
        laneHead.append(
          create('span', '', shortAddress(wallet.address)),
          create('span', '', holdings ? `${holdings.unitBalance} held` : '0 held'),
        );
        lane.append(laneHead);

        if (!holdings?.tokens.length) {
          lane.append(create('p', 'me-lane__empty', wallet.error ? 'TzKT read unavailable.' : 'Nothing from this collection yet.'));
        } else {
          const tokenGrid = create('div', 'me-token-grid');
          tokenGrid.append(...holdings.tokens.map((token) => {
            const link = create('a', 'me-token');
            link.href = token.objktUrl;
            link.target = '_blank';
            link.rel = 'noopener';
            const art = create('span', 'me-token__art');
            const image = create('img');
            image.src = token.thumbnailUrl;
            image.alt = token.name;
            image.loading = 'lazy';
            image.dataset.meImageFallback = `https://assets.objkt.media/file/assets-003/${descriptor.contract}/${encodeURIComponent(token.tokenId)}/thumb400`;
            art.append(image, create('b', 'me-token__balance', `×${token.balance}`));
            link.append(
              art,
              create('strong', 'me-token__name', token.name),
              create('small', '', `№${token.tokenId} · objkt ↗`),
            );
            return link;
          }));
          lane.append(tokenGrid);
        }
        walletLanes.append(lane);
      });
      section.append(walletLanes);
      return section;
    }));
  }

  function renderClaimDoor(root: HTMLElement, wallets: Wallet[]): void {
    const door = root.querySelector<HTMLElement>('[data-me-claim]');
    if (!door) return;
    door.dataset.meClaimAddress = wallets[0]?.address || '';
  }

  function showSignedOut(root: HTMLElement): void {
    root.dataset.meState = 'signed-out';
    const loading = root.querySelector<HTMLElement>('[data-me-loading]');
    const door = root.querySelector<HTMLElement>('[data-me-signed-out]');
    const privateView = root.querySelector<HTMLElement>('[data-me-private]');
    if (loading) loading.hidden = true;
    if (door) door.hidden = false;
    if (privateView) privateView.hidden = true;
  }

  function showSignedIn(root: HTMLElement, payload: HoldingsPayload): void {
    root.dataset.meState = 'signed-in';
    const loading = root.querySelector<HTMLElement>('[data-me-loading]');
    const door = root.querySelector<HTMLElement>('[data-me-signed-out]');
    const privateView = root.querySelector<HTMLElement>('[data-me-private]');
    const name = root.querySelector<HTMLElement>('[data-me-name]');
    const status = root.querySelector<HTMLElement>('[data-me-status]');
    const updated = root.querySelector<HTMLElement>('[data-me-updated]');
    if (loading) loading.hidden = true;
    if (door) door.hidden = true;
    if (privateView) privateView.hidden = false;
    if (name) name.textContent = payload.user.preferredName || 'PointCast member';
    if (status) {
      const failed = payload.wallets.filter((wallet) => wallet.error).length;
      status.textContent = failed
        ? `${failed} wallet read${failed === 1 ? '' : 's'} unavailable · use the direct TzKT links to inspect them.`
        : `${payload.wallets.length} linked Tezos wallet${payload.wallets.length === 1 ? '' : 's'} · 60-second edge snapshots.`;
    }
    if (updated) updated.textContent = `updated ${new Date(payload.generatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    renderIdentities(root, payload.user.identities);
    renderDogs(root, payload);
    renderWallets(root, payload.wallets);
    renderCollections(root, payload);
    renderClaimDoor(root, payload.wallets);
    renderLocalState(root);
    void refreshPasskeys(root);
    if (window.location.hash === '#holdings') {
      window.requestAnimationFrame(() => {
        root.querySelector<HTMLElement>('[data-me-holdings]')?.scrollIntoView({ block: 'start' });
      });
    }
    if (new URLSearchParams(window.location.search).get('link') === 'wallet') {
      window.requestAnimationFrame(() => window.dispatchEvent(new Event('pc:open-auth-menu')));
    }
  }

  async function loadRoot(root: HTMLElement, signal: AbortSignal): Promise<void> {
    const user = await getSession().catch(() => null);
    if (signal.aborted) return;
    if (!user) {
      showSignedOut(root);
      return;
    }
    const response = await fetch('/api/me/holdings', {
      credentials: 'include',
      cache: 'no-store',
      signal,
    });
    if (signal.aborted) return;
    if (response.status === 401) {
      showSignedOut(root);
      return;
    }
    if (!response.ok) throw new Error(`holdings-${response.status}`);
    showSignedIn(root, await response.json() as HoldingsPayload);
  }

  function initializeMePages(): void {
    const meWindow = window as MeWindow;
    meWindow.__pointCastMeAbort?.abort();
    const controller = new AbortController();
    meWindow.__pointCastMeAbort = controller;
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-me-root]'));
    if (!roots.length) return;

    roots.forEach((root) => {
      renderLocalState(root);
      void loadRoot(root, controller.signal).catch((error) => {
        if (controller.signal.aborted) return;
        const loading = root.querySelector<HTMLElement>('[data-me-loading]');
        if (loading) {
          loading.replaceChildren(
            create('p', 'me__kicker', 'PRIVATE CHANNEL · CONNECTION STOPPED'),
            create('p', '', error instanceof Error ? error.message : 'Could not load this profile.'),
          );
          const retry = create('button', 'me-retry', 'Try again');
          retry.type = 'button';
          retry.dataset.meAction = 'retry';
          loading.append(retry);
        }
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const actionElement = target?.closest<HTMLElement>('[data-me-action]');
      const action = actionElement?.dataset.meAction;
      if (!action) return;
      if (action === 'link') {
        event.preventDefault();
        window.dispatchEvent(new Event('pc:open-auth-menu'));
      } else if (action === 'signout') {
        event.preventDefault();
        void logout().then(() => roots.forEach(showSignedOut));
      } else if (action === 'retry') {
        event.preventDefault();
        roots.forEach((root) => void loadRoot(root, controller.signal));
      } else if (action === 'passkey-remove') {
        event.preventDefault();
        const root = actionElement.closest<HTMLElement>('[data-me-root]');
        const credentialId = actionElement.dataset.credentialId || '';
        const status = root?.querySelector<HTMLOutputElement>('[data-me-passkey-status]');
        if (!root || !credentialId) return;
        actionElement.setAttribute('aria-disabled', 'true');
        if (status) status.textContent = 'Removing passkey…';
        void removePasskey(credentialId)
          .then(async () => {
            if (status) status.textContent = 'Passkey removed.';
            await refreshPasskeys(root);
          })
          .catch((error) => {
            actionElement.removeAttribute('aria-disabled');
            if (status) status.textContent = error instanceof Error ? error.message : 'Could not remove passkey.';
          });
      }
    }, { signal: controller.signal });

    document.addEventListener('submit', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const passkeyForm = target?.closest<HTMLFormElement>('[data-me-passkey-form]');
      if (passkeyForm) {
        event.preventDefault();
        const root = passkeyForm.closest<HTMLElement>('[data-me-root]');
        const labelField = passkeyForm.elements.namedItem('label');
        const label = labelField instanceof HTMLInputElement ? labelField.value.trim() : '';
        const button = passkeyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = root?.querySelector<HTMLOutputElement>('[data-me-passkey-status]');
        if (!root) return;
        if (button) button.disabled = true;
        if (status) status.textContent = 'Waiting for Face ID / Touch ID…';
        void registerPasskey(label || 'This device')
          .then(async () => {
            if (status) status.textContent = 'Passkey added. You can return after clearing this browser.';
            passkeyForm.reset();
            await refreshPasskeys(root);
          })
          .catch((error) => {
            if (status) status.textContent = error instanceof Error ? error.message : 'Could not add passkey.';
          })
          .finally(() => {
            if (button) button.disabled = false;
          });
        return;
      }

      const form = target?.closest<HTMLFormElement>('[data-me-claim-form]');
      if (!form) return;
      event.preventDefault();
      const door = form.closest<HTMLElement>('[data-me-claim]');
      const result = form.querySelector<HTMLOutputElement>('[data-me-claim-result]');
      const field = form.elements.namedItem('handle');
      const handle = (field instanceof HTMLInputElement ? field.value : '').trim().toLowerCase();
      if (!/^[a-z0-9-]{3,24}$/.test(handle)) {
        result?.replaceChildren('Use 3–24 lowercase letters, numbers, or hyphens.');
        return;
      }
      if (!door?.dataset.meClaimAddress) {
        result?.replaceChildren('Link a Tezos wallet below before claiming. This door never assumes a wallet for you.');
        return;
      }
      const preview = create('a', 'me-claim__preview', `Preview /p/${handle} →`);
      preview.href = `/p/${handle}`;
      result?.replaceChildren(
        `@${handle} is a valid handle for ${shortAddress(door.dataset.meClaimAddress)}. Origination is paused, so nothing was submitted. `,
        preview,
      );
    }, { signal: controller.signal });

    document.addEventListener('error', (event) => {
      const image = event.target instanceof HTMLImageElement ? event.target : null;
      const fallback = image?.dataset.meImageFallback;
      if (!image || !fallback || image.src === fallback) return;
      image.src = fallback;
    }, { capture: true, signal: controller.signal });

    window.addEventListener('pc:auth-change', (event) => {
      const user = (event as CustomEvent<{ user?: PointCastUser | null }>).detail?.user;
      if (!user) {
        roots.forEach(showSignedOut);
        return;
      }
      roots.forEach((root) => void loadRoot(root, controller.signal));
    }, { signal: controller.signal });

    window.addEventListener('storage', (event) => {
      if (event.key === 'pc:visitor:noun' || event.key === 'pc:passport:stamps' || event.key?.startsWith('pc:pet:')) {
        roots.forEach(renderLocalState);
      }
    }, { signal: controller.signal });
  }

  const meWindow = window as MeWindow;
  if (!meWindow.__pointCastMePageLoadInstalled) {
    meWindow.__pointCastMePageLoadInstalled = true;
    document.addEventListener('astro:page-load', initializeMePages);
  }
  initializeMePages();
</script>

