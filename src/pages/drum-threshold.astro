---
/**
 * /drum-threshold — first-room arrival screen.
 *
 * Sprint 3, surface 1 of Guest Receivers. Visitor types their name
 * (or group) and clicks LIGHT MY CANDLE. Their candle joins a row
 * of lit candles in the chamber, with their Noun + name + "lit
 * 14m ago" stamp. The chamber holds up to 40 candles, 24-hour TTL.
 *
 * Backed by /api/chamber kind=threshold.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Threshold · First Room · PointCast';
const description =
  'Light a candle for your arrival. Type your name; the chamber adds it to the row of guests.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Threshold',
  url: 'https://pointcast.xyz/drum-threshold',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dt" id="dt-main">
    <DrumNav current="threshold" />

    <header class="dt__header">
      <div class="dt__chrome">
        <span>THRESHOLD</span>
        <span class="dt__chrome-sep">·</span>
        <span><span id="dt-count">0</span> CANDLES LIT TODAY</span>
        <span class="dt__chrome-sep">·</span>
        <span id="dt-mine">—</span>
      </div>
      <h1 class="dt__title">WELCOME</h1>
      <p class="dt__tagline">light a candle for your arrival · the chamber will remember</p>
    </header>

    <section class="dt__form" id="dt-form">
      <input class="dt__input" id="dt-name" type="text" maxlength="40" placeholder="your name (or your group)" />
      <button class="dt__btn dt__btn--primary" id="dt-light" type="button">LIGHT MY CANDLE</button>
    </section>

    <section class="dt__row" id="dt-row">
      <div class="dt__empty">— no candles lit yet —</div>
    </section>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dt-main) { background: #0c0410; }
  .dt {
    --dt-velvet: #1a0820; --dt-velvet-deep: #0c0410;
    --dt-brass: #d4a437; --dt-brass-deep: #6b4d12;
    --dt-flame: #f6c15e; --dt-flame-tip: #ff6b3a;
    --dt-ink-light: #f4e7c8; --dt-ink-mid: #c9b78c; --dt-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dt-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--dt-velvet) 0%, var(--dt-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .dt .drum-nav { opacity: 0.40; transform: scale(0.85); transform-origin: top left; margin-bottom: clamp(6px, 0.6vh, 12px); }

  .dt__header { text-align: center; padding: clamp(8px, 1vh, 18px) 0 clamp(20px, 3vh, 32px); }
  .dt__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--dt-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--dt-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .dt__chrome-sep { color: var(--dt-brass-deep); }
  #dt-count, #dt-mine { color: var(--dt-flame); font-weight: 700; }

  .dt__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--dt-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--dt-velvet-deep);
  }
  .dt__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--dt-ink-mid);
  }

  .dt__form {
    max-width: 560px; margin: 0 auto clamp(28px, 4vh, 44px);
    display: flex; gap: 12px; align-items: stretch;
  }
  .dt__input {
    appearance: none; flex: 1;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.4);
    border: 1.5px solid var(--dt-brass-deep);
    color: var(--dt-flame);
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: 16px; outline: none;
  }
  .dt__input:focus { border-color: var(--dt-brass); }
  .dt__input::placeholder { color: var(--dt-ink-dim); opacity: 0.55; }

  .dt__btn {
    appearance: none; border: 0; cursor: pointer;
    padding: 12px 24px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px; font-weight: 800; letter-spacing: 0.22em;
    color: var(--dt-velvet-deep);
    background: linear-gradient(180deg, var(--dt-brass) 0%, oklch(0.62 0.18 60) 100%);
    box-shadow: 0 0 0 2px var(--dt-velvet-deep), 0 4px 0 0 var(--dt-brass-deep), 0 4px 16px rgba(212, 164, 55, 0.30);
    transition: transform 80ms, box-shadow 80ms;
  }
  .dt__btn:hover { background: linear-gradient(180deg, #efbb46 0%, var(--dt-brass) 100%); }
  .dt__btn:active, .dt__btn:disabled {
    transform: translateY(3px);
    box-shadow: 0 0 0 2px var(--dt-velvet-deep), 0 1px 0 0 var(--dt-brass-deep), 0 0 18px rgba(246, 193, 94, 0.55);
  }

  .dt__row {
    max-width: 1080px; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: clamp(10px, 1.5vw, 20px);
    padding: clamp(20px, 3vh, 32px) 0;
    border-top: 1px solid rgba(212, 164, 55, 0.18);
    border-bottom: 1px solid rgba(212, 164, 55, 0.18);
  }
  .dt__empty {
    grid-column: 1/-1;
    text-align: center; padding: 40px;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    color: var(--dt-ink-dim);
  }

  .dt__candle {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 12px 8px;
    text-align: center;
  }
  .dt__candle.dt__candle--mine { background: rgba(246, 193, 94, 0.06); border-radius: 4px; }
  .dt__flame {
    width: 14px; height: 18px;
    background: radial-gradient(ellipse 5px 9px at 50% 70%, var(--dt-flame-tip) 0%, var(--dt-flame) 50%, transparent 75%);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.4px);
    animation: dt-flicker 1.6s ease-in-out infinite;
    transform-origin: 50% 100%;
    margin-bottom: 2px;
  }
  @keyframes dt-flicker {
    0%,100% { transform: scale(1, 1) rotate(0deg); opacity: 0.85; }
    25%     { transform: scale(0.96, 1.06) rotate(-2deg); opacity: 1; }
    50%     { transform: scale(1.04, 0.94) rotate(1deg); opacity: 0.9; }
    75%     { transform: scale(0.98, 1.02) rotate(-1deg); opacity: 1; }
  }
  .dt__wax {
    width: 12px; height: 32px;
    background: linear-gradient(180deg, #f4e7c8 0%, #c9b78c 100%);
    box-shadow: inset -1px 0 0 rgba(0, 0, 0, 0.25), inset 1px 0 0 rgba(255, 255, 255, 0.4);
  }
  .dt__candle-noun {
    width: 36px; height: 36px;
    image-rendering: pixelated; margin-top: 8px;
    background: rgba(0, 0, 0, 0.30);
    border: 1px solid var(--dt-brass-deep);
  }
  .dt__candle-name {
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: 13px; color: var(--dt-ink-light);
    line-height: 1.2; max-width: 100%; word-wrap: break-word;
  }
  .dt__candle-when {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px; letter-spacing: 0.15em; color: var(--dt-ink-dim); text-transform: uppercase;
  }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function playLight() {
    const a = ctx(); const t = a.currentTime;
    const f = 587.33;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.18, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.06, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.5); o2.start(t); o2.stop(t + 1.0);
  }

  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) { sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem(SID_KEY, sid); }
      return sid;
    } catch { return 'sid-anon-' + Date.now(); }
  }
  const SID = ensureSid();
  let MY_PID = '';
  async function sha256short(s) {
    const buf = new TextEncoder().encode(s);
    const hash = await crypto.subtle.digest('SHA-256', buf);
    return Array.from(new Uint8Array(hash)).map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 10);
  }

  const NAME_KEY = 'pc:threshold:name';
  const nameEl = document.getElementById('dt-name');
  const lightBtn = document.getElementById('dt-light');
  const countEl = document.getElementById('dt-count');
  const mineEl = document.getElementById('dt-mine');
  const rowEl = document.getElementById('dt-row');

  function fmtAgo(t) {
    const sec = Math.max(0, Math.floor((Date.now() - t) / 1000));
    if (sec < 60) return 'just now';
    const m = Math.floor(sec / 60);
    if (m < 60) return `${m}m ago`;
    return `${Math.floor(m / 60)}h ago`;
  }

  function paint(state) {
    if (!state) return;
    const candles = state.candles || [];
    if (countEl) countEl.textContent = String(candles.length);
    const myCandle = candles.find((c) => c.pid === MY_PID);
    if (mineEl) mineEl.textContent = myCandle ? `lit · ${myCandle.name}` : 'NOT LIT';
    if (rowEl) {
      if (candles.length === 0) {
        rowEl.innerHTML = '<div class="dt__empty">— no candles lit yet —</div>';
        return;
      }
      rowEl.innerHTML = '';
      candles.slice().sort((a, b) => b.lit - a.lit).forEach((c) => {
        const wrap = document.createElement('div');
        wrap.className = 'dt__candle';
        if (c.pid === MY_PID) wrap.classList.add('dt__candle--mine');
        wrap.innerHTML = `
          <div class="dt__flame"></div>
          <div class="dt__wax"></div>
          <img class="dt__candle-noun" src="https://noun.pics/${c.nounId}.svg" alt="" />
          <div class="dt__candle-name">${c.name || '—'}</div>
          <div class="dt__candle-when">${fmtAgo(c.lit)}</div>
        `;
        rowEl.appendChild(wrap);
      });
    }
  }

  async function fetchState() {
    try {
      const r = await fetch('/api/chamber?kind=threshold', { cache: 'no-store' });
      const j = await r.json();
      if (j?.ok) paint(j.state);
    } catch {}
  }

  async function lightCandle() {
    const name = (nameEl?.value || '').trim().slice(0, 40);
    if (!name) {
      if (nameEl) nameEl.focus();
      return;
    }
    if (lightBtn) lightBtn.disabled = true;
    try {
      const r = await fetch('/api/chamber', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'threshold', action: 'light', sessionId: SID, name }),
      });
      const j = await r.json();
      if (j?.ok) {
        try { localStorage.setItem(NAME_KEY, name); } catch {}
        try { playLight(); } catch {}
        paint(j.state);
      }
    } catch {}
    if (lightBtn) lightBtn.disabled = false;
  }

  lightBtn?.addEventListener('click', lightCandle);
  nameEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') lightCandle();
  });
  // Restore last name
  try {
    const last = localStorage.getItem(NAME_KEY);
    if (last && nameEl) nameEl.value = last;
  } catch {}

  (async () => { MY_PID = await sha256short(SID); fetchState(); })();
  setInterval(fetchState, 4000);
</script>
