---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  HONEY_LEAGUE_POINTS,
  HONEY_LEAGUE_SEASON,
  LOCAL_AREA_RADIUS,
} from '../lib/localAreas';

const title = 'Local Honey League';
const description =
  'A local Honey League for the PointCast 25-mile radius: soft standings for helpful acts, court play, local tables, honey notes, and published receipts.';

const sampleStandings = [
  { name: 'Main Street Table', points: 12, note: 'hosted, played, published' },
  { name: 'Court Craft Crew', points: 9, note: 'paddle loans and doubles' },
  { name: 'First Tide Hosts', points: 7, note: 'course demos and notes' },
  { name: 'Sea Glass Shelf', points: 5, note: 'library setup' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  '@id': 'https://pointcast.xyz/honey-league',
  name: title,
  description,
  url: 'https://pointcast.xyz/honey-league',
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: LOCAL_AREA_RADIUS.anchor.coords.latitude,
      longitude: LOCAL_AREA_RADIUS.anchor.coords.longitude,
    },
    geoRadius: LOCAL_AREA_RADIUS.radiusMeters,
  },
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/areas">areas</a>
      <span>/</span>
      <span>honey-league</span>
    </nav>

    <header class="hero">
      <div>
        <p class="kicker">LOCAL HONEY LEAGUE · SEASON ZERO</p>
        <h1>Keep score for the helpful stuff.</h1>
        <p>
          A soft local league for reciprocal acts: play, lend, host, bring,
          publish. It can sit beside pickleball without becoming only a sports
          ladder, and it can carry local honey without becoming a vendor table.
        </p>
      </div>
      <div class="comb" aria-label="Honey League scorecomb">
        {sampleStandings.map((row, index) => (
          <div class="cell" style={`--i:${index};`}>
            <span>{row.points}</span>
            <small>{row.name}</small>
          </div>
        ))}
      </div>
    </header>

    <section class="section season" aria-labelledby="season-heading">
      <div>
        <p class="kicker">SEASON FORMAT</p>
        <h2 id="season-heading">{HONEY_LEAGUE_SEASON.name}</h2>
      </div>
      <dl>
        <div><dt>Length</dt><dd>{HONEY_LEAGUE_SEASON.length}</dd></div>
        <div><dt>Cadence</dt><dd>{HONEY_LEAGUE_SEASON.cadence}</dd></div>
        <div><dt>Cap</dt><dd>{HONEY_LEAGUE_SEASON.cap}</dd></div>
      </dl>
    </section>

    <section class="section" aria-labelledby="points-heading">
      <div class="section__head">
        <p class="kicker">POINTS</p>
        <h2 id="points-heading">Simple scoring, no status theater.</h2>
      </div>
      <div class="points">
        {HONEY_LEAGUE_POINTS.map((item) => (
          <article class="point">
            <span>{item.points} pt{item.points === 1 ? '' : 's'}</span>
            <h3>{item.action}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section board" aria-labelledby="board-heading">
      <div>
        <p class="kicker">SAMPLE BOARD</p>
        <h2 id="board-heading">What the first standings could look like.</h2>
      </div>
      <ol>
        {sampleStandings.map((row) => (
          <li>
            <strong>{row.name}</strong>
            <span>{row.points} points</span>
            <small>{row.note}</small>
          </li>
        ))}
      </ol>
    </section>

    <section class="section claim" aria-labelledby="claim-heading">
      <div>
        <p class="kicker">LOCAL CLAIM</p>
        <h2 id="claim-heading">Log one Season Zero act.</h2>
        <p>
          Browser-local for the prototype. The important rule is evidence:
          name the act, the place, and the receipt it could become.
        </p>
        <div class="saved" data-honey-saved hidden></div>
      </div>
      <form class="form" data-honey-form>
        <label>
          <span>Name or team</span>
          <input name="name" type="text" required />
        </label>
        <label>
          <span>Action</span>
          <select name="action" required>
            {HONEY_LEAGUE_POINTS.map((item) => <option value={item.action}>{item.action} · {item.points} pt{item.points === 1 ? '' : 's'}</option>)}
          </select>
        </label>
        <label>
          <span>Where</span>
          <input name="where" type="text" required />
        </label>
        <label>
          <span>Receipt note</span>
          <textarea name="receipt" rows="4"></textarea>
        </label>
        <div class="actions">
          <button type="submit">Save local claim</button>
          <button type="button" data-clear-honey>Clear</button>
        </div>
      </form>
    </section>

    <section class="section prizes" aria-labelledby="prizes-heading">
      <div class="section__head">
        <p class="kicker">CLOSEOUT</p>
        <h2 id="prizes-heading">Prizes should stay small and useful.</h2>
      </div>
      <ul>
        {HONEY_LEAGUE_SEASON.prizes.map((prize) => <li>{prize}</li>)}
      </ul>
    </section>

    <aside class="related">
      <a href="/meetups">Honey Saturday on Meetups</a>
      <a href="/paddle-exchange">Paddle library points</a>
      <a href="/university-of-el-segundo">Honey & Garden track</a>
      <a href="/areas.json">/areas.json</a>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var key = 'pc:honey-league-claim';
      var form = document.querySelector('[data-honey-form]');
      var saved = document.querySelector('[data-honey-saved]');
      var clear = document.querySelector('[data-clear-honey]');
      if (!form || !saved) return;

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
        });
      }

      function render(claim) {
        if (!claim || !claim.name) {
          saved.hidden = true;
          saved.innerHTML = '';
          return;
        }
        saved.hidden = false;
        saved.innerHTML =
          '<p>saved locally</p>' +
          '<h3>' + escapeHtml(claim.name) + '</h3>' +
          '<span>' + escapeHtml(claim.action) + ' · ' + escapeHtml(claim.where) + '</span>' +
          '<small>' + escapeHtml(claim.receipt || 'receipt note open') + '</small>';
      }

      function readSaved() {
        try {
          return JSON.parse(localStorage.getItem(key) || 'null');
        } catch (error) {
          return null;
        }
      }

      var claim = readSaved();
      if (claim) {
        Array.from(form.elements).forEach(function (element) {
          if (element.name && claim[element.name]) element.value = claim[element.name];
        });
      }
      render(claim);

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var data = new FormData(form);
        var next = {
          name: data.get('name') || '',
          action: data.get('action') || '',
          where: data.get('where') || '',
          receipt: data.get('receipt') || '',
          savedAt: new Date().toISOString(),
        };
        localStorage.setItem(key, JSON.stringify(next));
        render(next);
      });

      if (clear) {
        clear.addEventListener('click', function () {
          localStorage.removeItem(key);
          form.reset();
          render(null);
        });
      }
    })();
  </script>
</BlockLayout>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 20px 88px;
  }

  .crumb,
  .kicker,
  .point span,
  .saved p {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--pc-ink-muted);
    margin-bottom: 24px;
  }

  .kicker {
    color: #9a5f0b;
    margin: 0 0 8px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 34px;
    align-items: center;
    padding-bottom: 30px;
    border-bottom: 2px solid var(--pc-ink);
  }

  h1 {
    font-size: 48px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0 0 16px;
    max-width: 12ch;
  }

  .hero p,
  .claim p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--pc-ink-soft);
    margin: 0;
    max-width: 68ch;
  }

  .comb {
    min-height: 292px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: 16px;
    border: 1px solid #e2a93e;
    background: #fffdf4;
  }

  .cell {
    border: 2px solid #12110e;
    background: var(--cell-bg, #fff0bf);
    display: grid;
    place-items: center;
    text-align: center;
    padding: 12px;
  }

  .cell:nth-child(2) { background: #e7f4ef; }
  .cell:nth-child(3) { background: #eef4fa; }
  .cell:nth-child(4) { background: #fff4dc; }

  .cell span {
    display: block;
    font-size: 42px;
    line-height: 1;
    font-weight: 500;
  }

  .cell small {
    display: block;
    margin-top: 8px;
    color: var(--pc-ink-soft);
    font-size: 12px;
  }

  .section {
    padding: 34px 0;
    border-bottom: 1px solid var(--pc-rule-soft);
  }

  .section__head {
    margin-bottom: 18px;
  }

  h2 {
    font-size: 28px;
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0;
  }

  .season,
  .board,
  .claim {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 30px;
    align-items: start;
  }

  .season dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .season div,
  .board li {
    border-left: 3px solid #9a5f0b;
    background: #fff0bf;
    padding: 12px 14px;
  }

  .season dt {
    font-size: 12px;
    color: #9a5f0b;
  }

  .season dd {
    margin: 3px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .point {
    border-top: 3px solid #9a5f0b;
    padding-top: 12px;
  }

  .point h3 {
    font-size: 20px;
    font-weight: 500;
    margin: 8px 0;
  }

  .point p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
    margin: 0;
  }

  .board ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .board li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
  }

  .board strong {
    font-weight: 500;
  }

  .board span {
    color: #9a5f0b;
  }

  .board small {
    grid-column: 1 / -1;
    color: var(--pc-ink-soft);
  }

  .form {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--pc-rule);
    background: #fffdf4;
  }

  label {
    display: grid;
    gap: 6px;
  }

  label span {
    font-size: 12px;
    color: var(--pc-ink-muted);
  }

  input,
  textarea,
  select {
    width: 100%;
    border: 1px solid var(--pc-rule);
    background: #fff;
    color: var(--pc-ink);
    font: inherit;
    font-size: 15px;
    padding: 10px 11px;
    border-radius: 0;
  }

  textarea {
    resize: vertical;
  }

  .actions,
  .related,
  .prizes ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  button,
  .related a {
    border: 1px solid #9a5f0b;
    background: #9a5f0b;
    color: #fff;
    font: inherit;
    font-size: 14px;
    padding: 10px 12px;
    cursor: pointer;
  }

  button[type='button'],
  .related a {
    background: #fff;
    color: #9a5f0b;
  }

  .saved {
    margin-top: 18px;
    padding: 14px;
    border: 1px solid #e2a93e;
    background: #fff0bf;
  }

  .saved p {
    margin: 0 0 5px;
    color: #9a5f0b;
  }

  .saved h3 {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 500;
  }

  .saved span,
  .saved small {
    display: block;
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.4;
  }

  .prizes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .prizes li {
    border: 1px solid #e2a93e;
    background: #fffdf4;
    padding: 10px 12px;
    font-size: 14px;
  }

  .related {
    margin-top: 28px;
  }

  @media (max-width: 920px) {
    .hero,
    .season,
    .board,
    .claim {
      grid-template-columns: 1fr;
    }

    .comb {
      max-width: 380px;
    }

    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    h1 {
      font-size: 34px;
      max-width: 100%;
    }

    .points,
    .comb {
      grid-template-columns: 1fr;
    }

    .page {
      padding-inline: 16px;
    }
  }
</style>
