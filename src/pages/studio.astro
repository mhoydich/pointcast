---
/**
 * Studio v2 — the PointCast Block Maker.
 *
 * Mike 2026-05-06 (overnight build): v0 was a 1144-line scaffold around an
 * inert Generate button. v2 pivots Studio into a fully-client-side
 * composition tool — pick a template, drop in real Nouns from the Visit
 * Nouns FA2 (via noun.pics/{seed}.svg, per the use-real-assets rule),
 * stack text layers in our design-system fonts, apply CRT/halftone/pixel
 * filters, optionally animate as a 4-frame loop, then export PNG/GIF or
 * copy a shareable URL that round-trips the whole composition.
 *
 * Zero backend. No API keys. Ships today. AI generation can slot in later
 * as just another "background" source — the canvas/filter/text/export
 * scaffolding doesn't need to change to get there.
 *
 * Aesthetic: geocities + sim city, late-90s chrome, saturated nouns
 * palette. Hard borders, mono kickers, drop-shadows on stickers.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Studio · Block Maker';
const description = 'Drag, type, ship. PointCast Studio is a sharable-block maker — Nouns stickers, text layers, CRT filters, 4-frame GIFs, export to PNG/GIF or publish straight to PointCast.';

// 12+ hand-picked Visit Nouns seeds — all confirmed in the FA2 (1..1199).
const FEATURED_NOUNS = [
  1, 42, 88, 99, 137, 174, 247, 417, 420, 557, 777, 808,
  945, 1020, 1086, 1111,
];

// Templates — frame size, chrome style, default text.
const TEMPLATES = [
  { id: 'postcard',   label: 'Postcard',      w: 1200, h: 800,  blurb: 'wide & friendly' },
  { id: 'card',       label: 'Trading Card',  w: 600,  h: 900,  blurb: 'portrait + corners' },
  { id: 'poster',     label: 'Marquee Poster', w: 800, h: 1200, blurb: 'big headline' },
  { id: 'pixel',      label: 'Pixel Bomb',    w: 720,  h: 720,  blurb: 'square 1:1' },
  { id: 'polaroid',   label: 'Polaroid',      w: 700,  h: 820,  blurb: 'photo + caption' },
];

// Background palette — the nouns warm-cool quad + neutrals.
const BG_SWATCHES = [
  { id: 'cream',  hex: '#f4e7c8', label: 'Cream' },
  { id: 'paper',  hex: '#f5efe4', label: 'Paper' },
  { id: 'sky',    hex: '#a8d8f0', label: 'Sky' },
  { id: 'sea',    hex: '#0b3e73', label: 'Sea' },
  { id: 'sun',    hex: '#f7c325', label: 'Sun' },
  { id: 'tide',   hex: '#2cc5a0', label: 'Tide' },
  { id: 'flame',  hex: '#e84d6a', label: 'Flame' },
  { id: 'velvet', hex: '#1a0820', label: 'Velvet' },
  { id: 'ink',    hex: '#1f1b15', label: 'Ink' },
  { id: 'pearl',  hex: '#fbf7ee', label: 'Pearl' },
];

// Filter strip — name + CSS filter chain.
const FILTERS = [
  { id: 'none',     label: 'None',     css: 'none' },
  { id: 'crt',      label: 'CRT',      css: 'contrast(1.08) saturate(1.18)' },
  { id: 'halftone', label: 'Halftone', css: 'grayscale(0.6) contrast(1.5)' },
  { id: 'pixel',    label: 'Pixelate', css: 'contrast(1.05)' },
  { id: 'neon',     label: 'Neon',     css: 'saturate(2) contrast(1.15) brightness(1.05)' },
  { id: 'sepia',    label: 'Sepia',    css: 'sepia(0.85) contrast(1.1)' },
  { id: 'warhol',   label: 'Warhol',   css: 'saturate(1.8) hue-rotate(20deg)' },
];

// Animation presets — applied as a CSS class on every layer.
const ANIMATIONS = [
  { id: 'static', label: 'Static',  blurb: 'no motion' },
  { id: 'bounce', label: 'Bounce',  blurb: 'soft up-down' },
  { id: 'ring',   label: 'Ring',    blurb: 'pulse scale' },
  { id: 'glitch', label: 'Glitch',  blurb: 'shake & shift' },
  { id: 'spin',   label: 'Spin',    blurb: 'gentle rotate' },
  { id: 'drop',   label: 'Drop',    blurb: 'confetti drop-in' },
];

const FONTS = [
  { id: 'heading', label: 'Syne (display)',    css: "'Syne', sans-serif" },
  { id: 'body',    label: 'Outfit (sans)',     css: "'Outfit', sans-serif" },
  { id: 'serif',   label: 'Lora (serif)',      css: "'Lora', 'Georgia', serif" },
  { id: 'mono',    label: 'JetBrains (mono)',  css: "'JetBrains Mono', ui-monospace, monospace" },
];

const TEXT_COLORS = [
  '#1f1b15', '#fbf7ee', '#c4952e', '#1b3a5b',
  '#F7C325', '#E84D6A', '#4A9EFF', '#2CC5A0',
];

// Starter compositions — one click loads a ready-made block to remix.
const PRESETS = [
  {
    id: 'aloha',
    label: 'ALOHA POSTCARD',
    blurb: 'wave from El Segundo',
    state: {
      tpl: 'postcard', bg: '#a8d8f0', filter: 'none', anim: 'bounce',
      layers: [
        { id: 1, kind: 'text', value: 'ALOHA FROM EL SEGUNDO', x: 0.5, y: 0.18,
          scale: 1, rotate: 0, font: 'heading', size: 60, color: '#1f1b15' },
        { id: 2, kind: 'noun', seed: 137, x: 0.5, y: 0.6, scale: 1.6, rotate: 0 },
      ],
    },
  },
  {
    id: 'visitor-card',
    label: 'VISITOR CARD',
    blurb: 'noun + name + role',
    state: {
      tpl: 'card', bg: '#f4e7c8', filter: 'crt', anim: 'static',
      layers: [
        { id: 1, kind: 'text', value: 'VISITOR', x: 0.5, y: 0.12,
          scale: 1, rotate: 0, font: 'mono', size: 22, color: '#c4952e' },
        { id: 2, kind: 'noun', seed: 247, x: 0.5, y: 0.45, scale: 1.5, rotate: 0 },
        { id: 3, kind: 'text', value: 'YOUR NAME', x: 0.5, y: 0.78,
          scale: 1, rotate: 0, font: 'heading', size: 32, color: '#1f1b15' },
        { id: 4, kind: 'text', value: 'pointcast.xyz', x: 0.5, y: 0.88,
          scale: 1, rotate: 0, font: 'mono', size: 14, color: '#6a6154' },
      ],
    },
  },
  {
    id: 'open-mic',
    label: 'OPEN MIC POSTER',
    blurb: 'event marquee',
    state: {
      tpl: 'poster', bg: '#1a0820', filter: 'neon', anim: 'glitch',
      layers: [
        { id: 1, kind: 'text', value: 'OPEN MIC', x: 0.5, y: 0.18,
          scale: 1, rotate: 0, font: 'heading', size: 96, color: '#F7C325' },
        { id: 2, kind: 'text', value: 'TONIGHT · 8PM', x: 0.5, y: 0.32,
          scale: 1, rotate: 0, font: 'mono', size: 24, color: '#E84D6A' },
        { id: 3, kind: 'noun', seed: 808, x: 0.5, y: 0.55, scale: 1.8, rotate: 0 },
        { id: 4, kind: 'text', value: 'EL SEGUNDO', x: 0.5, y: 0.84,
          scale: 1, rotate: 0, font: 'heading', size: 48, color: '#fbf7ee' },
      ],
    },
  },
  {
    id: 'pixel-quad',
    label: 'PIXEL QUAD',
    blurb: 'four-noun grid',
    state: {
      tpl: 'pixel', bg: '#fbf7ee', filter: 'pixel', anim: 'static',
      layers: [
        { id: 1, kind: 'noun', seed: 137,  x: 0.27, y: 0.27, scale: 1.0, rotate: 0 },
        { id: 2, kind: 'noun', seed: 247,  x: 0.73, y: 0.27, scale: 1.0, rotate: 0 },
        { id: 3, kind: 'noun', seed: 808,  x: 0.27, y: 0.73, scale: 1.0, rotate: 0 },
        { id: 4, kind: 'noun', seed: 1086, x: 0.73, y: 0.73, scale: 1.0, rotate: 0 },
      ],
    },
  },
  {
    id: 'polaroid-window',
    label: 'POLAROID',
    blurb: 'snapshot + caption',
    state: {
      tpl: 'polaroid', bg: '#a8d8f0', filter: 'sepia', anim: 'static',
      layers: [
        { id: 1, kind: 'noun', seed: 99, x: 0.5, y: 0.42, scale: 1.6, rotate: -4 },
        { id: 2, kind: 'text', value: 'el segundo, may 2026', x: 0.5, y: 0.92,
          scale: 1, rotate: 0, font: 'serif', size: 22, color: '#1f1b15' },
      ],
    },
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/studio',
  name: 'PointCast Studio',
  description,
  url: 'https://pointcast.xyz/studio',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="studio2">
    <header class="studio2__head">
      <p class="kicker">CH.STUDIO · BLOCK MAKER · v2.2</p>
      <h1>Drag, type, ship.</h1>
      <p class="dek">
        Pick a template. Drop in Nouns. Stack a headline. Apply a filter,
        loop a four-frame animation, export a PNG or GIF, or publish
        straight to PointCast. All of it client-side — nothing leaves your
        browser until you say so.
      </p>
    </header>

    <section class="presets" aria-label="Starter compositions">
      <div class="presets__head">
        <p class="kicker">START FROM</p>
        <button type="button" class="reset-btn" id="reset-canvas" title="Clear the canvas">↺ RESET</button>
      </div>
      <div class="presets__row">
        {PRESETS.map(p => (
          <button
            type="button"
            class="preset"
            data-preset={p.id}
            data-state={JSON.stringify(p.state)}
          >
            <span class="preset__label">{p.label}</span>
            <span class="preset__blurb">{p.blurb}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="templates" aria-label="Template chooser">
      <p class="kicker">TEMPLATE</p>
      <div class="templates__row">
        {TEMPLATES.map((t, i) => (
          <button
            type="button"
            class={`tpl ${i === 0 ? 'is-active' : ''}`}
            data-tpl={t.id}
            data-w={t.w}
            data-h={t.h}
          >
            <span class="tpl__label">{t.label}</span>
            <span class="tpl__dim">{t.w}×{t.h}</span>
            <span class="tpl__blurb">{t.blurb}</span>
          </button>
        ))}
      </div>
    </section>

    <div class="studio2__body">
      <aside class="tools" aria-label="Tools">
        <!-- BACKGROUND -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">BACKGROUND</span>
          </header>
          <div class="swatches" role="radiogroup" aria-label="Background color">
            {BG_SWATCHES.map((s, i) => (
              <button
                type="button"
                class={`swatch ${i === 0 ? 'is-active' : ''}`}
                data-bg={s.hex}
                aria-label={s.label}
                style={`background: ${s.hex}`}
                title={s.label}
              ></button>
            ))}
          </div>
          <label class="hex-row">
            <span class="kicker-tiny">CUSTOM</span>
            <input type="color" id="bg-custom" value="#f4e7c8" />
          </label>
        </section>

        <!-- NOUNS -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">NOUNS</span>
            <button type="button" class="tool__btn" id="surprise-noun">SURPRISE ME</button>
          </header>
          <p class="tool__hint">tap a noun to add it to the canvas — drag to move, scroll to scale.</p>
          <div class="noun-tray" id="noun-tray">
            {FEATURED_NOUNS.map(seed => (
              <button
                type="button"
                class="noun-thumb"
                data-seed={seed}
                aria-label={`Add Noun #${seed}`}
              >
                <img src={`https://noun.pics/${seed}.svg`} alt="" loading="lazy" />
                <span class="noun-thumb__seed">#{seed}</span>
              </button>
            ))}
          </div>
        </section>

        <!-- UPLOAD -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">UPLOAD</span>
          </header>
          <p class="tool__hint">drop a photo onto the canvas — png, jpg, gif, svg up to 4 MB.</p>
          <label class="upload-btn">
            <input type="file" id="upload-input" accept="image/*" hidden />
            <span>+ ADD A PHOTO</span>
          </label>
        </section>

        <!-- TEXT -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">TEXT</span>
          </header>
          <input
            type="text"
            id="text-input"
            class="text-input"
            placeholder="say something"
            maxlength="80"
          />
          <div class="text-row">
            <label class="text-row__label">
              <span class="kicker-tiny">FONT</span>
              <select id="text-font">
                {FONTS.map((f, i) => (
                  <option value={f.id} selected={i === 0}>{f.label}</option>
                ))}
              </select>
            </label>
            <label class="text-row__label">
              <span class="kicker-tiny">SIZE</span>
              <input type="range" id="text-size" min="14" max="120" value="48" />
            </label>
          </div>
          <div class="color-row" role="radiogroup" aria-label="Text color">
            {TEXT_COLORS.map((c, i) => (
              <button
                type="button"
                class={`color-dot ${i === 0 ? 'is-active' : ''}`}
                data-color={c}
                aria-label={`Color ${c}`}
                style={`background: ${c}`}
              ></button>
            ))}
          </div>
          <button type="button" class="tool__cta" id="add-text">+ ADD TEXT LAYER</button>
        </section>

        <!-- FILTER -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">FILTER</span>
          </header>
          <div class="chip-row" role="radiogroup" aria-label="Filter">
            {FILTERS.map((f, i) => (
              <button
                type="button"
                class={`chip ${i === 0 ? 'is-active' : ''}`}
                data-filter={f.id}
              >
                {f.label}
              </button>
            ))}
          </div>
        </section>

        <!-- ANIMATION -->
        <section class="tool">
          <header class="tool__head">
            <span class="kicker">ANIMATION</span>
          </header>
          <div class="chip-row" role="radiogroup" aria-label="Animation">
            {ANIMATIONS.map((a, i) => (
              <button
                type="button"
                class={`chip ${i === 0 ? 'is-active' : ''}`}
                data-anim={a.id}
                title={a.blurb}
              >
                {a.label}
              </button>
            ))}
          </div>
          <p class="tool__hint" id="anim-hint">no motion</p>
        </section>
      </aside>

      <section class="stage" aria-label="Canvas">
        <div class="stage__frame" id="stage-frame">
          <div class="stage__inner" id="canvas" data-tpl="postcard">
            <!-- Layers injected here -->
          </div>
          <div class="stage__chrome" id="stage-chrome" aria-hidden="true"></div>
        </div>
        <div class="stage__layers" aria-label="Layer stack">
          <p class="kicker-tiny">LAYERS</p>
          <ul class="layers" id="layers"></ul>
        </div>
        <p class="stage__tip">
          click a layer · drag to reposition · scroll to scale ·
          <kbd>↑↓←→</kbd> nudge · <kbd>[</kbd> <kbd>]</kbd> reorder ·
          <kbd>⌘D</kbd> duplicate · <kbd>delete</kbd> remove
        </p>
      </section>
    </div>

    <section class="export" aria-label="Export">
      <p class="kicker">EXPORT</p>
      <div class="export__row">
        <button type="button" class="export__btn" id="export-png">⬇  DOWNLOAD PNG</button>
        <button type="button" class="export__btn" id="export-gif">🎞  DOWNLOAD GIF</button>
        <button type="button" class="export__btn" id="export-share">🔗  COPY SHARE URL</button>
        <button type="button" class="export__btn export__btn--primary" id="export-publish">📡  PUBLISH AS BLOCK</button>
      </div>
      <p class="export__notice" id="export-notice" hidden role="status" aria-live="polite"></p>
    </section>
  </main>
</BlockLayout>

<!-- gif.js loaded for animated export -->
<script is:inline src="https://cdn.jsdelivr.net/npm/gif.js@0.2.0/dist/gif.js"></script>
<!-- html2canvas for DOM-to-canvas snapshot -->
<script is:inline src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<script is:inline>
(() => {
  // ---------- STATE ----------
  const state = {
    tpl: 'postcard',
    bg: '#f4e7c8',
    filter: 'none',
    anim: 'static',
    layers: [],   // { id, kind: 'noun'|'text', seed?, value?, x, y, scale, rotate, font?, size?, color? }
    selectedId: null,
    nextId: 1,
  };

  const TPLS = {
    postcard: { w: 1200, h: 800,  chrome: 'frame-postcard' },
    card:     { w: 600,  h: 900,  chrome: 'frame-card' },
    poster:   { w: 800,  h: 1200, chrome: 'frame-poster' },
    pixel:    { w: 720,  h: 720,  chrome: 'frame-pixel' },
    polaroid: { w: 700,  h: 820,  chrome: 'frame-polaroid' },
  };

  const FILTERS = {
    none:     'none',
    crt:      'contrast(1.08) saturate(1.18)',
    halftone: 'grayscale(0.6) contrast(1.5)',
    pixel:    'contrast(1.05)',
    neon:     'saturate(2) contrast(1.15) brightness(1.05)',
    sepia:    'sepia(0.85) contrast(1.1)',
    warhol:   'saturate(1.8) hue-rotate(20deg)',
  };

  const ANIM_HINTS = {
    static: 'no motion',
    bounce: 'soft up-down — exports as 4-frame GIF',
    ring:   'pulse scale — exports as 4-frame GIF',
    glitch: 'shake & shift — exports as 4-frame GIF',
    spin:   'gentle rotate — exports as 4-frame GIF',
    drop:   'confetti drop-in — exports as 4-frame GIF',
  };

  const canvasEl   = document.getElementById('canvas');
  const chromeEl   = document.getElementById('stage-chrome');
  const layersEl   = document.getElementById('layers');
  const animHint   = document.getElementById('anim-hint');
  const exportNote = document.getElementById('export-notice');

  // ---------- PERSISTENCE ----------
  const LS_KEY = 'pc-studio-v2';

  function persist() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({
        tpl: state.tpl, bg: state.bg, filter: state.filter, anim: state.anim,
        layers: state.layers,
      }));
    } catch (e) { /* private mode etc — ignore */ }
  }

  function loadFromHash() {
    if (location.hash.length < 4) return false;
    try {
      const data = JSON.parse(atob(decodeURIComponent(location.hash.slice(1))));
      applyState(data);
      return true;
    } catch (e) { return false; }
  }

  function loadFromLS() {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return false;
      const data = JSON.parse(raw);
      if (!data || !Array.isArray(data.layers)) return false;
      applyState(data);
      return true;
    } catch (e) { return false; }
  }

  function applyState(data) {
    state.tpl    = data.tpl    || state.tpl;
    state.bg     = data.bg     || state.bg;
    state.filter = data.filter || state.filter;
    state.anim   = data.anim   || state.anim;
    state.layers = (data.layers || []).map(l => ({ ...l }));
    state.selectedId = null;
    state.nextId = state.layers.reduce((m, l) => Math.max(m, l.id + 1), 1);
    syncControlsToState();
  }

  function syncControlsToState() {
    document.querySelectorAll('[data-tpl]').forEach(b => b.classList.toggle('is-active', b.dataset.tpl === state.tpl));
    document.querySelectorAll('[data-bg]').forEach(b => b.classList.toggle('is-active', b.dataset.bg === state.bg));
    document.querySelectorAll('[data-filter]').forEach(b => b.classList.toggle('is-active', b.dataset.filter === state.filter));
    document.querySelectorAll('[data-anim]').forEach(b => b.classList.toggle('is-active', b.dataset.anim === state.anim));
    const bgInp = document.getElementById('bg-custom');
    if (bgInp) bgInp.value = state.bg;
    if (animHint) animHint.textContent = ANIM_HINTS[state.anim] || '';
  }

  function seedDemo() {
    state.layers = [
      { id: 1, kind: 'noun', seed: 137, x: 0.50, y: 0.58, scale: 1.4, rotate: 0 },
      { id: 2, kind: 'text', value: 'ALOHA FROM EL SEGUNDO', x: 0.50, y: 0.18,
        scale: 1, rotate: 0, font: 'heading', size: 56, color: '#1f1b15' },
    ];
    state.nextId = 3;
  }

  // ---------- RENDER ----------
  function applyTemplate() {
    const t = TPLS[state.tpl];
    canvasEl.style.aspectRatio = `${t.w} / ${t.h}`;
    canvasEl.style.background = state.bg;
    canvasEl.style.filter = FILTERS[state.filter];
    canvasEl.dataset.tpl = state.tpl;
    chromeEl.className = 'stage__chrome ' + t.chrome;
  }

  function fontCss(id) {
    const map = {
      heading: "'Syne', sans-serif",
      body:    "'Outfit', sans-serif",
      serif:   "'Lora', 'Georgia', serif",
      mono:    "'JetBrains Mono', ui-monospace, monospace",
    };
    return map[id] || map.heading;
  }

  function renderLayers() {
    canvasEl.querySelectorAll('.layer').forEach(n => n.remove());
    for (const layer of state.layers) {
      const node = document.createElement('div');
      node.className = `layer layer--${layer.kind} anim-${state.anim}`;
      node.dataset.id = layer.id;
      node.style.left = (layer.x * 100) + '%';
      node.style.top = (layer.y * 100) + '%';
      node.style.setProperty('--s', layer.scale);
      node.style.setProperty('--r', layer.rotate + 'deg');
      node.style.transform = `translate(-50%, -50%) scale(${layer.scale}) rotate(${layer.rotate}deg)`;
      if (layer.kind === 'noun') {
        const img = document.createElement('img');
        img.src = `https://noun.pics/${layer.seed}.svg`;
        img.alt = `Noun ${layer.seed}`;
        img.draggable = false;
        node.appendChild(img);
      } else if (layer.kind === 'photo') {
        const img = document.createElement('img');
        img.src = layer.dataUrl;
        img.alt = layer.name || 'Uploaded photo';
        img.draggable = false;
        node.appendChild(img);
      } else if (layer.kind === 'text') {
        node.textContent = layer.value;
        node.style.fontFamily = fontCss(layer.font);
        node.style.fontSize = layer.size + 'px';
        node.style.color = layer.color;
      }
      if (state.selectedId === layer.id) node.classList.add('is-selected');
      canvasEl.appendChild(node);
      wireDrag(node, layer);
    }
    renderLayerList();
  }

  function renderLayerList() {
    layersEl.innerHTML = '';
    state.layers.slice().reverse().forEach(l => {
      const li = document.createElement('li');
      li.className = 'layer-item' + (state.selectedId === l.id ? ' is-selected' : '');
      const label = l.kind === 'noun'
        ? `Noun #${l.seed}`
        : l.kind === 'photo'
          ? (l.name || 'Photo')
          : `“${l.value.slice(0, 24)}”`;
      const sel = document.createElement('button');
      sel.type = 'button';
      sel.className = 'layer-item__select';
      sel.dataset.id = l.id;
      sel.textContent = `${l.kind.toUpperCase()} · ${label}`;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'layer-item__del';
      del.dataset.del = l.id;
      del.setAttribute('aria-label', 'Delete');
      del.textContent = '×';
      li.appendChild(sel);
      li.appendChild(del);
      layersEl.appendChild(li);
    });
  }

  // ---------- DRAG ----------
  function wireDrag(node, layer) {
    let startX, startY, startLX, startLY;
    function onDown(e) {
      e.preventDefault(); e.stopPropagation();
      state.selectedId = layer.id;
      const t = e.touches ? e.touches[0] : e;
      startX = t.clientX; startY = t.clientY;
      startLX = layer.x; startLY = layer.y;
      document.body.style.cursor = 'grabbing';
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onUp);
      renderLayers();
    }
    function onMove(e) {
      e.preventDefault();
      const t = e.touches ? e.touches[0] : e;
      const rect = canvasEl.getBoundingClientRect();
      const dx = (t.clientX - startX) / rect.width;
      const dy = (t.clientY - startY) / rect.height;
      layer.x = clamp(startLX + dx, 0.02, 0.98);
      layer.y = clamp(startLY + dy, 0.02, 0.98);
      node.style.left = (layer.x * 100) + '%';
      node.style.top = (layer.y * 100) + '%';
    }
    function onUp() {
      document.body.style.cursor = '';
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onUp);
    }
    node.addEventListener('mousedown', onDown);
    node.addEventListener('touchstart', onDown, { passive: false });
    node.addEventListener('wheel', e => {
      e.preventDefault();
      layer.scale = clamp(layer.scale + (e.deltaY < 0 ? 0.05 : -0.05), 0.25, 4);
      renderLayers();
    });
  }

  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  // ---------- EVENTS ----------
  document.querySelectorAll('[data-tpl]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-tpl]').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      state.tpl = btn.dataset.tpl;
      applyTemplate();
    });
  });

  document.querySelectorAll('[data-bg]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-bg]').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      state.bg = btn.dataset.bg;
      canvasEl.style.background = state.bg;
      document.getElementById('bg-custom').value = state.bg;
    });
  });
  document.getElementById('bg-custom').addEventListener('input', e => {
    state.bg = e.target.value;
    canvasEl.style.background = state.bg;
    document.querySelectorAll('[data-bg]').forEach(b => b.classList.remove('is-active'));
  });

  document.querySelectorAll('.noun-thumb').forEach(btn => {
    btn.addEventListener('click', () => addNoun(parseInt(btn.dataset.seed, 10)));
  });
  document.getElementById('surprise-noun').addEventListener('click', () => {
    addNoun(Math.floor(Math.random() * 1200));
  });

  function addNoun(seed) {
    const layer = {
      id: state.nextId++, kind: 'noun', seed,
      x: 0.5 + (Math.random() - 0.5) * 0.2,
      y: 0.5 + (Math.random() - 0.5) * 0.2,
      scale: 1, rotate: 0,
    };
    state.layers.push(layer);
    state.selectedId = layer.id;
    renderLayers();
  }

  document.getElementById('upload-input').addEventListener('change', e => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const MAX = 4 * 1024 * 1024;
    if (file.size > MAX) {
      notify(`too big — ${(file.size / 1024 / 1024).toFixed(1)} MB · 4 MB max`);
      e.target.value = '';
      return;
    }
    if (!file.type.startsWith('image/')) {
      notify('that does not look like an image');
      e.target.value = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = ev => {
      const layer = {
        id: state.nextId++, kind: 'photo',
        dataUrl: ev.target.result,
        name: file.name,
        x: 0.5, y: 0.5, scale: 1, rotate: 0,
      };
      state.layers.push(layer);
      state.selectedId = layer.id;
      renderLayers();
      persist();
      notify(`added · ${file.name}`);
    };
    reader.onerror = () => notify('could not read that file');
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  document.getElementById('add-text').addEventListener('click', () => {
    const value = document.getElementById('text-input').value.trim();
    if (!value) {
      document.getElementById('text-input').focus();
      return;
    }
    const font = document.getElementById('text-font').value;
    const size = parseInt(document.getElementById('text-size').value, 10);
    const color = document.querySelector('.color-dot.is-active')?.dataset.color || '#1f1b15';
    const layer = {
      id: state.nextId++, kind: 'text', value, font, size, color,
      x: 0.5, y: 0.2 + Math.random() * 0.6, scale: 1, rotate: 0,
    };
    state.layers.push(layer);
    state.selectedId = layer.id;
    renderLayers();
    document.getElementById('text-input').value = '';
  });
  document.querySelectorAll('.color-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('is-active'));
      dot.classList.add('is-active');
    });
  });

  document.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      state.filter = btn.dataset.filter;
      canvasEl.style.filter = FILTERS[state.filter];
      canvasEl.classList.toggle('is-pixel', state.filter === 'pixel');
    });
  });

  document.querySelectorAll('[data-anim]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-anim]').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      state.anim = btn.dataset.anim;
      animHint.textContent = ANIM_HINTS[state.anim];
      renderLayers();
    });
  });

  layersEl.addEventListener('click', e => {
    const sel = e.target.closest('[data-id]');
    const del = e.target.closest('[data-del]');
    if (del) {
      const id = parseInt(del.dataset.del, 10);
      state.layers = state.layers.filter(l => l.id !== id);
      if (state.selectedId === id) state.selectedId = null;
      renderLayers();
    } else if (sel) {
      state.selectedId = parseInt(sel.dataset.id, 10);
      renderLayers();
    }
  });
  document.addEventListener('keydown', e => {
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

    if ((e.key === 'Backspace' || e.key === 'Delete') && state.selectedId) {
      e.preventDefault();
      state.layers = state.layers.filter(l => l.id !== state.selectedId);
      state.selectedId = null;
      renderLayers();
      persist();
      return;
    }

    // Arrow nudges (selected layer): 1% / 5% with shift.
    if (state.selectedId && e.key.startsWith('Arrow')) {
      e.preventDefault();
      const layer = state.layers.find(l => l.id === state.selectedId);
      if (!layer) return;
      const step = e.shiftKey ? 0.05 : 0.01;
      if (e.key === 'ArrowLeft')  layer.x = clamp(layer.x - step, 0.02, 0.98);
      if (e.key === 'ArrowRight') layer.x = clamp(layer.x + step, 0.02, 0.98);
      if (e.key === 'ArrowUp')    layer.y = clamp(layer.y - step, 0.02, 0.98);
      if (e.key === 'ArrowDown')  layer.y = clamp(layer.y + step, 0.02, 0.98);
      renderLayers();
      persist();
      return;
    }

    // Layer ordering: [ send back, ] bring forward.
    if (state.selectedId && (e.key === '[' || e.key === ']')) {
      e.preventDefault();
      const idx = state.layers.findIndex(l => l.id === state.selectedId);
      if (idx < 0) return;
      const newIdx = e.key === '[' ? Math.max(0, idx - 1) : Math.min(state.layers.length - 1, idx + 1);
      if (newIdx !== idx) {
        const [moved] = state.layers.splice(idx, 1);
        state.layers.splice(newIdx, 0, moved);
        renderLayers();
        persist();
      }
      return;
    }

    // Duplicate layer: cmd/ctrl + D.
    if (state.selectedId && (e.metaKey || e.ctrlKey) && (e.key === 'd' || e.key === 'D')) {
      e.preventDefault();
      const layer = state.layers.find(l => l.id === state.selectedId);
      if (!layer) return;
      const dup = { ...layer, id: state.nextId++, x: clamp(layer.x + 0.04, 0.02, 0.98), y: clamp(layer.y + 0.04, 0.02, 0.98) };
      state.layers.push(dup);
      state.selectedId = dup.id;
      renderLayers();
      persist();
    }
  });
  canvasEl.addEventListener('click', e => {
    if (e.target === canvasEl) {
      state.selectedId = null;
      renderLayers();
    }
  });

  // ---------- EXPORT ----------
  async function snapshotCanvas(scale) {
    if (!window.html2canvas) {
      notify('html2canvas failed to load — check your network.');
      return null;
    }
    const c = await window.html2canvas(canvasEl, {
      scale: scale || 2, useCORS: true, allowTaint: false,
      backgroundColor: state.bg, logging: false,
    });
    return c;
  }

  document.getElementById('export-png').addEventListener('click', async () => {
    notify('rendering png…');
    const c = await snapshotCanvas(2);
    if (!c) return;
    c.toBlob(blob => {
      downloadBlob(blob, `pointcast-${state.tpl}-${Date.now()}.png`);
      notify('png downloaded ✓');
    }, 'image/png');
  });

  document.getElementById('export-gif').addEventListener('click', async () => {
    if (!window.GIF) { notify('gif.js failed to load.'); return; }
    if (state.anim === 'static') {
      notify('pick an animation first — or just download as PNG.');
      return;
    }
    notify('rendering 4-frame gif… (~5s)');
    const t = TPLS[state.tpl];
    const gif = new window.GIF({
      workers: 2, quality: 8,
      width: Math.round(t.w / 2), height: Math.round(t.h / 2),
      workerScript: 'https://cdn.jsdelivr.net/npm/gif.js@0.2.0/dist/gif.worker.js',
    });
    // Capture 4 frames spaced through one animation cycle.
    const frames = 4;
    const cycleMs = state.anim === 'glitch' ? 400 : 1400;
    for (let i = 0; i < frames; i++) {
      // Pause animation at this frame's offset for sampling.
      canvasEl.querySelectorAll('.layer').forEach(n => {
        n.style.animationPlayState = 'paused';
        n.style.animationDelay = `-${(i / frames) * cycleMs}ms`;
      });
      await new Promise(r => setTimeout(r, 50));
      const c = await snapshotCanvas(1);
      if (!c) return;
      gif.addFrame(c, { delay: Math.round(cycleMs / frames), copy: true });
    }
    canvasEl.querySelectorAll('.layer').forEach(n => {
      n.style.animationPlayState = '';
      n.style.animationDelay = '';
    });
    gif.on('finished', blob => {
      downloadBlob(blob, `pointcast-${state.tpl}-${Date.now()}.gif`);
      notify('gif downloaded ✓');
    });
    gif.render();
  });

  document.getElementById('export-share').addEventListener('click', async () => {
    const data = {
      tpl: state.tpl, bg: state.bg, filter: state.filter,
      anim: state.anim, layers: state.layers,
    };
    const hash = encodeURIComponent(btoa(JSON.stringify(data)));
    const url = `${location.origin}${location.pathname}#${hash}`;
    history.replaceState({}, '', url);
    try {
      await navigator.clipboard.writeText(url);
      notify('share url copied — paste anywhere ✓');
    } catch (e) {
      prompt('copy this share url:', url);
    }
  });

  document.getElementById('export-publish').addEventListener('click', async () => {
    notify('rendering png + filing publish request…');
    const c = await snapshotCanvas(2);
    if (!c) return;
    c.toBlob(async blob => {
      downloadBlob(blob, `pointcast-publish-${Date.now()}.png`);
      try {
        const fd = new FormData();
        fd.append('image', blob, 'studio.png');
        fd.append('meta', JSON.stringify({
          tpl: state.tpl, layers: state.layers,
          filter: state.filter, anim: state.anim,
        }));
        const r = await fetch('/api/publish', { method: 'POST', body: fd });
        if (r.ok) notify('published ✓ — check the wire');
        else notify('saved png locally — /api/publish not wired yet');
      } catch (e) {
        notify('saved png locally — /api/publish unreachable');
      }
    }, 'image/png');
  });

  function notify(msg) {
    exportNote.textContent = msg;
    exportNote.hidden = false;
    clearTimeout(notify._t);
    notify._t = setTimeout(() => { exportNote.hidden = true; }, 3500);
  }
  function downloadBlob(blob, name) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  }

  // ---------- PRESETS + RESET ----------
  document.querySelectorAll('[data-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      try {
        const data = JSON.parse(btn.dataset.state);
        applyState(data);
        applyTemplate();
        renderLayers();
        persist();
        notify(`loaded · ${btn.querySelector('.preset__label')?.textContent || 'preset'}`);
      } catch (e) { notify('preset failed to load'); }
    });
  });

  document.getElementById('reset-canvas')?.addEventListener('click', () => {
    if (!confirm('Clear the canvas? This removes every layer.')) return;
    state.layers = [];
    state.selectedId = null;
    state.nextId = 1;
    renderLayers();
    persist();
    notify('canvas cleared');
  });

  // Persist on every mutating interaction (chip/swatch/template clicks above
  // already mutate state; we wrap them by hooking the document-level click
  // bubbler so persistence is automatic without sprinkling persist() everywhere).
  document.addEventListener('click', e => {
    if (e.target.closest('[data-tpl], [data-bg], [data-filter], [data-anim], .noun-thumb, #surprise-noun, #add-text, [data-del]')) {
      // Run after the click handler has updated state.
      setTimeout(persist, 0);
    }
  }, true);
  document.getElementById('bg-custom')?.addEventListener('input', () => setTimeout(persist, 0));

  // ---------- BOOT ----------
  if (!loadFromHash() && !loadFromLS()) seedDemo();
  applyTemplate();
  renderLayers();
  syncControlsToState();
})();
</script>

