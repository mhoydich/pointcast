---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Studio';
const description = 'CH.ART image generation — prompt to image to block. Generate, collect, publish from PointCast.';

const models = [
  {
    id: 'nano-banana-2',
    name: 'Nano Banana 2',
    tagline: 'Fast, high quality',
    speed: 'fast',
    resolutions: ['1K', '2K'],
    goodFor: 'Daily blocks, quick iteration, hero cards.',
    examples: 'Channel illustrations, social cards, exploration sketches.',
  },
  {
    id: 'nano-banana-pro',
    name: 'Nano Banana Pro',
    tagline: 'Ultimate quality, 4K',
    speed: 'quality',
    resolutions: ['1K', '2K', '4K'],
    goodFor: 'Print-ready posters, archival drops, premium editions.',
    examples: 'Faucet noun reinterpretations, /shop posters, gallery walls.',
  },
  {
    id: 'flux-2',
    name: 'Flux 2.0',
    tagline: 'Precise prompt adherence',
    speed: 'standard',
    resolutions: ['1K', '2K', '4K'],
    goodFor: 'Compositions where the prompt has to land exactly.',
    examples: 'Diagrammatic blocks, labeled scenes, brand mocks.',
  },
  {
    id: 'gpt-image-2',
    name: 'GPT Image 2',
    tagline: 'Text rendering, editing',
    speed: 'standard',
    resolutions: ['1K', '2K'],
    goodFor: 'Posters with legible type, editing existing images, signage.',
    examples: 'Marquees, ticker cards, anything with words on the canvas.',
  },
  {
    id: 'soul-cast',
    name: 'Soul Cast',
    tagline: 'Cinematic characters',
    speed: 'quality',
    resolutions: ['1K', '2K', '4K'],
    goodFor: 'Recurring residents, character sheets, cast portraits.',
    examples: 'Resident agent cards, mythos figures, named characters.',
  },
  {
    id: 'soul-location',
    name: 'Soul Location',
    tagline: 'Environments, scenes',
    speed: 'quality',
    resolutions: ['1K', '2K', '4K'],
    goodFor: 'Establishing shots, rooms, weather, El Segundo backdrops.',
    examples: '/window scenes, /room interiors, beach + bakery exteriors.',
  },
];

const aspectRatios = ['1:1', '16:9', '9:16', '4:3', '3:4'];
const resolutions = ['1K', '2K', '4K'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/studio',
  name: 'PointCast Studio',
  description,
  url: 'https://pointcast.xyz/studio',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="studio-page" id="studio-canvas">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/chart">chart</a>
      <span aria-hidden="true">/</span>
      <span>studio</span>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">STUDIO</p>
        <h1>CH.ART · IMAGE GENERATION</h1>
        <p class="hero__tagline">Prompt &rarr; image &rarr; block. Generate, collect, publish.</p>
      </div>
      <aside class="hero__faucet" aria-label="Daily faucet status">
        <p class="kicker">FAUCET</p>
        <strong data-faucet-count>1</strong>
        <span data-faucet-status>FREE GENERATION TODAY</span>
        <em data-faucet-reset>Resets at midnight PT</em>
      </aside>
    </header>

    <section class="canvas" aria-labelledby="prompt-title">
      <div class="canvas__head">
        <p class="kicker">PROMPT CANVAS</p>
        <h2 id="prompt-title">Compose the next frame.</h2>
      </div>

      <div class="canvas__grid">
        <div class="prompt-cell">
          <label class="field-label" for="studio-prompt">PROMPT</label>
          <textarea
            id="studio-prompt"
            data-prompt
            maxlength="500"
            placeholder="A weathered fisherman holding a brass compass, El Segundo coastline at golden hour, mid-century editorial style, soft cream tones..."
            rows="8"
          ></textarea>
          <div class="prompt-meta">
            <span data-char-count>0</span>
            <span class="char-cap"> / 500</span>
          </div>
        </div>

        <div class="controls-cell">
          <div class="control">
            <label class="field-label" for="studio-model">MODEL</label>
            <select id="studio-model" data-model>
              {models.map((m) => (
                <option value={m.id}>{m.name} &mdash; {m.tagline}</option>
              ))}
            </select>
          </div>

          <div class="control">
            <span class="field-label">ASPECT RATIO</span>
            <div class="chip-row" role="radiogroup" aria-label="Aspect ratio">
              {aspectRatios.map((r, i) => (
                <button
                  type="button"
                  class={`chip ${i === 0 ? 'chip--on' : ''}`}
                  data-aspect={r}
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                >{r}</button>
              ))}
            </div>
          </div>

          <div class="control">
            <span class="field-label">RESOLUTION</span>
            <div class="chip-row" role="radiogroup" aria-label="Resolution">
              {resolutions.map((r, i) => (
                <button
                  type="button"
                  class={`chip ${i === 0 ? 'chip--on' : ''}`}
                  data-res={r}
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                >{r}</button>
              ))}
            </div>
          </div>

          <button type="button" class="generate-btn" data-generate>
            <span class="generate-btn__label">GENERATE</span>
            <span class="generate-btn__sub" data-generate-sub>Uses 1 free generation</span>
          </button>
        </div>
      </div>

      <p class="canvas__notice" data-notice hidden role="status" aria-live="polite"></p>
    </section>

    <section class="gallery" aria-labelledby="gallery-title">
      <div class="gallery__head">
        <p class="kicker">RESULTS GALLERY</p>
        <h2 id="gallery-title">Today's frames.</h2>
      </div>

      <div class="gallery__grid" data-gallery>
        <div class="empty-state" data-empty>
          <p class="empty-state__hint">YOUR GENERATIONS WILL APPEAR HERE</p>
          <p class="empty-state__sub">Saved frames live in your browser. Nothing leaves the device until you publish.</p>
        </div>
      </div>
    </section>

    <section class="streak" aria-labelledby="streak-title">
      <div class="streak__head">
        <p class="kicker">DAILY FAUCET</p>
        <h2 id="streak-title">Show up, get more.</h2>
      </div>
      <ol class="streak__rules">
        <li><strong>DAY 1+</strong> &middot; 1 free generation</li>
        <li><strong>DAY 3+ STREAK</strong> &middot; 2 free generations</li>
        <li><strong>DAY 7+ STREAK</strong> &middot; 3 free generations</li>
      </ol>
      <p class="streak__note" data-streak-note>Resets at midnight Pacific. Visit any PointCast room to keep a streak alive.</p>
    </section>

    <section class="models" aria-labelledby="models-title">
      <div class="models__head">
        <p class="kicker">MODEL INFO</p>
        <h2 id="models-title">Six engines, one canvas.</h2>
      </div>
      <div class="models__grid">
        {models.map((m) => (
          <details class="model-card">
            <summary>
              <span class="model-card__name">{m.name}</span>
              <span class={`model-card__speed model-card__speed--${m.speed}`}>{m.speed.toUpperCase()}</span>
            </summary>
            <div class="model-card__body">
              <p class="model-card__tag">{m.tagline}</p>
              <dl>
                <dt>GOOD FOR</dt>
                <dd>{m.goodFor}</dd>
                <dt>EXAMPLES</dt>
                <dd>{m.examples}</dd>
                <dt>RESOLUTIONS</dt>
                <dd>{m.resolutions.join(' · ')}</dd>
              </dl>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="billing" aria-labelledby="billing-title">
      <div class="billing__head">
        <p class="kicker">CREDITS &middot; KEYS &middot; SUBSCRIPTION</p>
        <h2 id="billing-title">Pay your way.</h2>
      </div>

      <div class="billing__grid">
        <article class="bill-card">
          <p class="bill-card__label">CREDITS</p>
          <strong class="bill-card__price">&mdash;</strong>
          <p class="bill-card__sub">Pricing tiers landing soon. The faucet covers daily play.</p>
          <button type="button" class="bill-btn" disabled>BUY CREDITS &middot; SOON</button>
        </article>

        <article class="bill-card">
          <p class="bill-card__label">SUBSCRIBE</p>
          <strong class="bill-card__price">&mdash;</strong>
          <p class="bill-card__sub">Monthly access to every model, no per-image meter.</p>
          <button type="button" class="bill-btn" disabled>SUBSCRIBE &middot; SOON</button>
        </article>

        <article class="bill-card bill-card--byok">
          <p class="bill-card__label">BRING YOUR OWN KEY</p>
          <p class="bill-card__sub">Stored in your browser only. Sent as auth header to the proxy, never persisted on PointCast servers.</p>

          <div class="key-grid">
            <label class="key-row">
              <span>OPENAI</span>
              <input type="password" data-key="openai" autocomplete="off" placeholder="sk-..." />
            </label>
            <label class="key-row">
              <span>ANTHROPIC</span>
              <input type="password" data-key="anthropic" autocomplete="off" placeholder="sk-ant-..." />
            </label>
            <label class="key-row">
              <span>BLACK FOREST</span>
              <input type="password" data-key="bfl" autocomplete="off" placeholder="key..." />
            </label>
            <label class="key-row">
              <span>FAL.AI</span>
              <input type="password" data-key="fal" autocomplete="off" placeholder="fal-..." />
            </label>
          </div>

          <div class="key-actions">
            <button type="button" class="bill-btn bill-btn--ghost" data-keys-save>SAVE KEYS LOCALLY</button>
            <button type="button" class="bill-btn bill-btn--ghost" data-keys-clear>CLEAR ALL</button>
          </div>
          <p class="key-note" data-keys-status></p>
        </article>
      </div>
    </section>

    <section class="links">
      <a href="/cabinet">/cabinet</a>
      <a href="/chart">/chart</a>
      <a href="/chartmaker">/chartmaker</a>
      <a href="/apps">/apps</a>
      <a href="/for-agents">/for-agents</a>
    </section>
  </main>
</BlockLayout>

<script id="studio-models" type="application/json" is:inline set:html={JSON.stringify(models)}></script>

<script is:inline>
  (() => {
    const root = document.querySelector('#studio-canvas');
    const modelsEl = document.querySelector('#studio-models');
    if (!root || !modelsEl) return;
    const models = JSON.parse(modelsEl.textContent || '[]');
    const modelById = Object.fromEntries(models.map((m) => [m.id, m]));

    const STORAGE_GALLERY = 'pc_studio_gallery';
    const STORAGE_STREAK = 'pc:streak';
    const STORAGE_FAUCET = 'pc_studio_faucet';
    const STORAGE_KEYS = 'pc_studio_keys';

    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[char]));

    const promptEl = root.querySelector('[data-prompt]');
    const charCountEl = root.querySelector('[data-char-count]');
    const modelEl = root.querySelector('[data-model]');
    const generateBtn = root.querySelector('[data-generate]');
    const generateSub = root.querySelector('[data-generate-sub]');
    const noticeEl = root.querySelector('[data-notice]');
    const galleryEl = root.querySelector('[data-gallery]');
    const emptyEl = root.querySelector('[data-empty]');

    const faucetCountEl = root.querySelector('[data-faucet-count]');
    const faucetStatusEl = root.querySelector('[data-faucet-status]');
    const faucetResetEl = root.querySelector('[data-faucet-reset]');
    const streakNoteEl = root.querySelector('[data-streak-note]');

    let aspect = '1:1';
    let resolution = '1K';

    promptEl.addEventListener('input', () => {
      charCountEl.textContent = String(promptEl.value.length);
    });

    root.querySelectorAll('[data-aspect]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-aspect]').forEach((b) => {
          b.classList.remove('chip--on');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('chip--on');
        btn.setAttribute('aria-checked', 'true');
        aspect = btn.dataset.aspect;
      });
    });

    root.querySelectorAll('[data-res]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('[data-res]').forEach((b) => {
          b.classList.remove('chip--on');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('chip--on');
        btn.setAttribute('aria-checked', 'true');
        resolution = btn.dataset.res;
      });
    });

    const todayKey = () => {
      const now = new Date();
      const ptOffsetMs = 8 * 60 * 60 * 1000;
      const pt = new Date(now.getTime() - ptOffsetMs);
      return pt.toISOString().slice(0, 10);
    };

    const readStreakDays = () => {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_STREAK) || 'null');
        if (raw && typeof raw === 'object' && typeof raw.days === 'number') return raw.days;
      } catch {}
      return 1;
    };

    const faucetAllowance = (days) => (days >= 7 ? 3 : days >= 3 ? 2 : 1);

    const readFaucet = () => {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_FAUCET) || 'null');
        if (raw && raw.day === todayKey() && typeof raw.used === 'number') return raw;
      } catch {}
      return { day: todayKey(), used: 0 };
    };

    const writeFaucet = (state) => {
      try { localStorage.setItem(STORAGE_FAUCET, JSON.stringify(state)); } catch {}
    };

    const renderFaucet = () => {
      const days = readStreakDays();
      const max = faucetAllowance(days);
      const state = readFaucet();
      const remaining = Math.max(0, max - state.used);
      faucetCountEl.textContent = String(remaining);
      faucetStatusEl.textContent = remaining === 1
        ? 'FREE GENERATION TODAY'
        : 'FREE GENERATIONS TODAY';
      faucetResetEl.textContent = `Day ${days} streak · resets at midnight PT`;
      streakNoteEl.textContent = `You're on day ${days}. Allowance today: ${max}. Remaining: ${remaining}.`;
      generateSub.textContent = remaining > 0
        ? `Uses 1 of ${remaining} free generations`
        : 'Out of free generations · use a saved key or wait for reset';
    };

    const readGallery = () => {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_GALLERY) || '[]');
        if (Array.isArray(raw)) return raw;
      } catch {}
      return [];
    };

    const writeGallery = (items) => {
      try { localStorage.setItem(STORAGE_GALLERY, JSON.stringify(items)); } catch {}
    };

    const renderGallery = () => {
      const items = readGallery();
      const cards = root.querySelectorAll('.result-card');
      cards.forEach((c) => c.remove());
      if (items.length === 0) {
        emptyEl.hidden = false;
        return;
      }
      emptyEl.hidden = true;
      const html = items.slice().reverse().map((item) => {
        const m = modelById[item.model] || { name: item.model };
        return `
          <article class="result-card" data-result-id="${escapeHtml(item.id)}">
            <div class="result-card__art" data-aspect="${escapeHtml(item.aspect || '1:1')}">
              <span class="result-card__placeholder">PREVIEW</span>
              <span class="result-card__dim">${escapeHtml(item.aspect || '1:1')} · ${escapeHtml(item.resolution || '1K')}</span>
            </div>
            <div class="result-card__body">
              <p class="result-card__prompt">${escapeHtml(item.prompt)}</p>
              <p class="result-card__meta">
                <span>${escapeHtml(m.name)}</span>
                <span>${escapeHtml(item.timestamp)}</span>
              </p>
              <div class="result-card__actions">
                <button type="button" class="result-btn" data-save="${escapeHtml(item.id)}" ${item.savedToCabinet ? 'disabled' : ''}>
                  ${item.savedToCabinet ? 'SAVED · IN CABINET' : 'SAVE TO CABINET'}
                </button>
                <button type="button" class="result-btn result-btn--ghost" disabled title="Coming soon — publish to CH.ART">
                  PUBLISH AS BLOCK
                </button>
                <button type="button" class="result-btn result-btn--text" data-remove="${escapeHtml(item.id)}">REMOVE</button>
              </div>
            </div>
          </article>
        `;
      }).join('');
      emptyEl.insertAdjacentHTML('afterend', html);

      root.querySelectorAll('[data-save]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.save;
          const items = readGallery();
          const target = items.find((i) => i.id === id);
          if (!target) return;
          target.savedToCabinet = true;
          target.savedAt = new Date().toISOString();
          writeGallery(items);
          renderGallery();
          flash('Saved to /cabinet locally.');
        });
      });

      root.querySelectorAll('[data-remove]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.remove;
          const items = readGallery().filter((i) => i.id !== id);
          writeGallery(items);
          renderGallery();
        });
      });
    };

    const flash = (msg) => {
      noticeEl.hidden = false;
      noticeEl.textContent = msg;
      noticeEl.dataset.tone = 'ok';
      window.clearTimeout(flash._t);
      flash._t = window.setTimeout(() => { noticeEl.hidden = true; }, 3500);
    };

    generateBtn.addEventListener('click', () => {
      const prompt = (promptEl.value || '').trim();
      if (!prompt) {
        noticeEl.hidden = false;
        noticeEl.dataset.tone = 'warn';
        noticeEl.textContent = 'Write a prompt first.';
        return;
      }
      generateBtn.disabled = true;
      generateBtn.querySelector('.generate-btn__label').textContent = 'GENERATING...';
      noticeEl.hidden = true;
      window.setTimeout(() => {
        const item = {
          id: `gen-${Date.now().toString(36)}`,
          prompt,
          model: modelEl.value,
          aspect,
          resolution,
          timestamp: new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC',
          savedToCabinet: false,
        };
        const items = readGallery();
        items.push(item);
        writeGallery(items);
        renderGallery();

        generateBtn.disabled = false;
        generateBtn.querySelector('.generate-btn__label').textContent = 'GENERATE';
        noticeEl.hidden = false;
        noticeEl.dataset.tone = 'info';
        noticeEl.textContent = 'Generation requires an API connection. Coming in the next sprint. A placeholder card was added to your gallery.';
      }, 850);
    });

    const renderKeys = () => {
      let stored = {};
      try { stored = JSON.parse(localStorage.getItem(STORAGE_KEYS) || '{}'); } catch {}
      root.querySelectorAll('[data-key]').forEach((input) => {
        const k = input.dataset.key;
        if (stored[k]) input.value = stored[k];
      });
      const status = root.querySelector('[data-keys-status]');
      const count = Object.values(stored).filter(Boolean).length;
      status.textContent = count
        ? `${count} key${count === 1 ? '' : 's'} stored locally.`
        : 'No keys stored.';
    };

    root.querySelector('[data-keys-save]').addEventListener('click', () => {
      const next = {};
      root.querySelectorAll('[data-key]').forEach((input) => {
        if (input.value) next[input.dataset.key] = input.value;
      });
      try { localStorage.setItem(STORAGE_KEYS, JSON.stringify(next)); } catch {}
      renderKeys();
      flash('Keys saved to your browser.');
    });

    root.querySelector('[data-keys-clear]').addEventListener('click', () => {
      try { localStorage.removeItem(STORAGE_KEYS); } catch {}
      root.querySelectorAll('[data-key]').forEach((input) => { input.value = ''; });
      renderKeys();
      flash('Keys cleared.');
    });

    renderFaucet();
    renderGallery();
    renderKeys();
    window.addEventListener('storage', () => { renderFaucet(); renderGallery(); renderKeys(); });
  })();
</script>

<style>
  :global(body:has(#studio-canvas)) {
    background: #f5f0e6;
  }

  .studio-page {
    --ink: #15130f;
    --muted: #665f55;
    --paper: #fffdf7;
    --paper-soft: #faf5e9;
    --rule: #d8cdb8;
    --blue: #185fa5;
    --green: #0f6e56;
    --red: #8a2432;
    --gold: #ba7517;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 16px 96px;
    color: var(--ink);
  }

  .crumb,
  .kicker,
  .field-label,
  .chip,
  .generate-btn__label,
  .result-card__meta,
  .result-card__dim,
  .result-card__placeholder,
  .result-btn,
  .bill-card__label,
  .bill-btn,
  .key-row span,
  .empty-state__hint,
  .links a,
  .streak__rules strong,
  .model-card__speed,
  .model-card__body dt,
  .hero__faucet em,
  .hero__faucet span {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 10px;
    color: var(--muted);
  }
  .crumb a { color: var(--ink); }

  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 14px;
    align-items: stretch;
  }
  .hero__copy,
  .hero__faucet,
  .canvas,
  .gallery,
  .streak,
  .models,
  .billing {
    border: 1.5px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .hero__copy { padding: clamp(20px, 4vw, 36px); }
  .kicker {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.22em;
  }
  .studio-page h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 64px);
    line-height: 0.95;
    font-weight: 650;
    letter-spacing: -0.005em;
  }
  .hero__tagline {
    max-width: 60ch;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.5;
  }
  .hero__faucet {
    display: grid;
    align-content: center;
    gap: 6px;
    padding: 22px;
    background:
      linear-gradient(135deg, rgba(186, 117, 23, 0.08), transparent 60%),
      var(--paper);
  }
  .hero__faucet strong {
    font-size: clamp(72px, 14vw, 120px);
    line-height: 0.85;
    color: var(--blue);
    font-weight: 650;
  }
  .hero__faucet span {
    font-size: 10px;
    color: var(--ink);
  }
  .hero__faucet em {
    font-size: 9px;
    color: var(--muted);
    font-style: normal;
    letter-spacing: 0.1em;
  }

  /* ── Section heads ── */
  .canvas, .gallery, .streak, .models, .billing {
    margin-top: 16px;
    padding: clamp(16px, 3vw, 28px);
  }
  .canvas__head, .gallery__head, .streak__head, .models__head, .billing__head {
    margin-bottom: 18px;
  }
  .studio-page h2 {
    margin: 0;
