---
import manifest from '../data/hoydich-play.json';
const canonical = 'https://pointcast.xyz/hoydich-play/';
const file = (path: string) => `/hoydich-play/files/${path}`;
const docs = {
  brand: file('Hoydich-Play-Brand-Book.pdf'),
  strategy: file('Hoydich-Play-Research-and-Go-to-Market.pdf'),
  model: file('Hoydich-Play-Cost-and-Launch-Model.xlsx'),
  sources: file('Research-Source-Register.csv'),
};
const preview = (name: string) => `/hoydich-play/previews/${name.replace(/\.png$/, '.webp')}`;
const formatBytes = (bytes: number) => bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
const moods = [
  { path: '01-signalsaurs-moodboard.png', title: 'Daylight laboratory', tag: '01 / Family world', alt: 'Cream ROOK robot-dinosaur concept with cobalt and orange accents, material samples, packaging and field-guide studies.', text: 'Warm bone. Signal colors. Tactile controls. An optimistic future you can hold.' },
  { path: '04-after-hours-moodboard.png', title: 'After Hours', tag: '02 / Collector world', alt: 'Graphite ROOK robot-dinosaur color study with amber visor, material swatches and matching packaging.', text: 'Graphite and amber. The same proposed platform, explored as a collector finish.' },
];
const ads = [
  { path: '05-family-social-ad.png', title: 'Small robot. Big afternoon.', alt: 'Family advertisement concept showing cream ROOK beneath the headline Small Robot. Big Afternoon.', text: 'A world for inventive afternoons. Family campaign concept.' },
  { path: '06-collector-social-ad.png', title: 'Grow up. Keep playing.', alt: 'Collector advertisement concept showing graphite ROOK beneath the headline Grow Up. Keep Playing.', text: 'A character object for play and display. Collector campaign concept.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{manifest.title}</title>
    <meta name="description" content={manifest.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={manifest.title} />
    <meta property="og:description" content={manifest.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}files/visuals/01-signalsaurs-moodboard.png`} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Hoydich Play Signalsaurs cream robot-dinosaur concept mood board" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#082F5B" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topline"><span>A Hoydich Enterprises concept</span><span>El Segundo, California / 2026</span></div>
    <header class="site-header wrap">
      <a class="maker" href="#main" aria-label="Hoydich Play home">HOYDICH<span>PLAY<span class="logo-dot" aria-hidden="true"></span></span></a>
      <nav aria-label="Main navigation"><a href="#world">The world</a><a href="#product">The product</a><a href="#research">The research</a><a href="#downloads">Downloads <span aria-hidden="true">↘</span></a></nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Concept / product in development</p>
          <h1 id="hero-title">Make room<br />for <em>play.</em></h1>
          <p class="hero-intro">Original characters. Tactile adventures. The bright optimism of an imagined 1980s future.</p>
          <p>Meet <strong>ROOK / REX-01</strong>, the first Signalsaur concept from Hoydich Play.</p>
          <div class="actions"><a class="button" href="#world">Explore the world <span aria-hidden="true">↓</span></a><a class="text-link" href={manifest.archiveUrl} download>Get the complete package ↗</a></div>
        </div>
        <figure class="hero-figure">
          <a href={file('visuals/02-packaging-concept.png')} aria-label="View full-size ROOK packaging concept"><img src={preview('02-packaging-concept.png')} alt="Cream ROOK robot-dinosaur and proposed Signalsaurs retail packaging, field guide and mission cards." width="1536" height="1024" fetchpriority="high" /></a>
          <figcaption><span>ROOK / REX-01</span><span>Packaging visualization / not a production sample</span></figcaption>
        </figure>
      </section>
      <div class="signal-band" aria-hidden="true"><i></i><i></i><i></i></div>
      <section class="intro section wrap" aria-labelledby="house-title">
        <p class="eyebrow">01 / A house. A world. A character.</p>
        <div class="section-heading"><h2 id="house-title">Start with one<br />excellent creature.</h2><p>A proposed toy division under Hoydich Enterprises, built around original worlds, dependable physical play and characters worth keeping. One hero platform comes first.</p></div>
        <ol class="architecture"><li><small>The parent</small><strong>Hoydich Enterprises</strong></li><li><small>The maker</small><strong>Hoydich Play</strong></li><li><small>The first world</small><strong>Signalsaurs</strong></li><li><small>The first character</small><strong>ROOK / REX-01</strong></li></ol>
      </section>
      <section class="world section" id="world" aria-labelledby="world-title">
        <div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / The visual world</p><h2 id="world-title">A familiar future.<br />An original form.</h2></div><p>Warm plastics, bold industrial graphics, small field notes and a readable silhouette. These are generated concept studies; materials, mechanisms and markings remain to be developed.</p></div>
          <div class="mood-grid">{moods.map((mood) => <figure class="visual-card"><a href={file(`visuals/${mood.path}`)} aria-label={`View full-size ${mood.title} mood board`}><img src={preview(mood.path)} alt={mood.alt} width="1536" height="1024" loading="lazy" decoding="async" /></a><figcaption><p class="eyebrow">{mood.tag}</p><h3>{mood.title}</h3><p>{mood.text}</p><a class="text-link" href={file(`visuals/${mood.path}`)} download>Download original PNG ↗</a></figcaption></figure>)}</div>
        </div>
      </section>
      <section class="section wrap" aria-labelledby="audience-title">
        <div class="section-heading"><div><p class="eyebrow">03 / Two reasons to care</p><h2 id="audience-title">One creature.<br />Two invitations.</h2></div><p>Families and adult collectors lead together. Distinct creative directions share one proposed hardware platform, with separate research for each audience.</p></div>
        <div class="audience-grid"><article class="audience family"><span class="serial">A / FAMILY</span><h3>Invent an<br />afternoon.</h3><p>Short physical missions. Scenes built together. A clear start, a clear stop and a useful offline life.</p><p class="fine">Ages 8–12 are the design brief. Professional age grading follows the actual product.</p></article><article class="audience collector"><span class="serial">B / COLLECTOR</span><h3>Keep a little<br />future around.</h3><p>A sculptural character with satisfying expression, bold graphics and a finish that rewards a closer look.</p><p class="fine">After Hours is a color study. A collector label does not establish a separate safety classification.</p></article></div>
      </section>
      <section class="product section" id="product" aria-labelledby="product-title"><div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">04 / The product brief</p><h2 id="product-title">Personality through<br />gesture and play.</h2></div><p>ROOK is planned as a roughly 22 cm tabletop creature with broad, planted feet. The player positions it. Expression comes from bounded movement, authored sounds and repeatable missions.</p></div>
        <div class="product-grid"><article><p class="serial">THE OFFLINE CORE</p><h3>Delight before connection.</h3><ul><li>Two expressive motor axes, subject to engineering review.</li><li>Physical controls, mission cards and authored motion-and-sound sequences.</li><li>Four AA cells in a screw-secured compartment as the cost-model assumption.</li><li>No autonomous walking, microphone or camera in the proposed first toy.</li></ul></article><article><p class="serial">THE OPTIONAL AI CONCEPT</p><h3>An adult mission planner.</h3><p>An adult would choose a setting and challenge, preview a bounded mission, then transfer approved actions. Generated content would never issue unrestricted motor commands.</p><p>The planner is proposed, unbuilt and dependent on legal classification, privacy review and tested implementation. Core play is designed to remain useful without an account or cloud.</p></article></div>
        <aside class="gate"><strong>A real decision gate.</strong><p>The research flags California’s child companion-chatbot toy moratorium. Counsel must classify the entire hardware, app and content experience before development or an AI sales claim. An adult-only app does not establish an exemption. <a href="https://www.gov.ca.gov/2026/09/10/governor-newsom-signs-the-strongest-child-safety-chatbot-and-social-media-laws-in-the-nation/">Read the state announcement ↗</a></p></aside>
      </div></section>
      <section class="section wrap" aria-labelledby="campaign-title">
        <div class="section-heading"><div><p class="eyebrow">05 / The campaign studies</p><h2 id="campaign-title">Play has<br />no expiry date.</h2></div><p>Two finished visual directions for the same original character. These advertisements describe a concept in development and are archived here as creative work.</p></div>
        <div class="ad-grid">{ads.map((ad) => <figure class="ad-card"><a href={file(`visuals/${ad.path}`)} aria-label={`View full-size ${ad.title} concept advertisement`}><img src={preview(ad.path)} alt={ad.alt} width="1122" height="1402" loading="lazy" decoding="async" /></a><figcaption><h3>{ad.title}</h3><p>{ad.text}</p><a class="text-link" href={file(`visuals/${ad.path}`)} download>Download original PNG ↗</a></figcaption></figure>)}</div>
      </section>
      <section class="research section" id="research" aria-labelledby="research-title"><div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">06 / Research meets reality</p><h2 id="research-title">A clear plan.<br />Honest unknowns.</h2></div><p>Research dated <time datetime={manifest.researchDate}>October 17, 2026</time>. The package covers competitors, product architecture, manufacturing, compliance, service continuity, channel economics and a staged route to market.</p></div>
        <div class="stats"><div><strong>$199</strong><span>MSRP planning baseline</span></div><div><strong>~$49</strong><span>Modeled landed unit cost</span></div><div><strong>5,000</strong><span>Units in the base production case</span></div><div><strong>~$1.40m</strong><span>Modeled funding target</span></div></div>
        <p class="estimate-note">Planning estimates only. No supplier quotes, approved BOM, tariff determination or production commitment. Landed cost excludes development and tooling. Funding includes modeled reserves and a liquidity buffer; the first run does not recover the whole development program.</p>
        <div class="research-grid"><article><h3>First, earn the next step.</h3><p>Begin with a staged <strong>$30,000–$60,000 discovery program</strong> within the larger budget: test the play loop, resolve legal classification, develop the engineering brief and compare supplier proposals. Release tooling capital only after those gates.</p><a class="text-link" href={docs.strategy} download>Read the full research &amp; go-to-market PDF ↗</a></article><article><h3>A workbook you can challenge.</h3><p>Seven editable sheets connect volume assumptions, the BOM, channel economics, development costs and 24-month cash timing. Use it to test decisions as real proposals replace assumptions.</p><a class="text-link" href={docs.model} download>Download the cost &amp; launch model ↗</a></article></div>
      </div></section>
      <section class="section wrap" aria-labelledby="local-title">
        <div class="section-heading"><div><p class="eyebrow">07 / Why El Segundo</p><h2 id="local-title">The advantage<br />is the intersection.</h2></div><p>Toy expertise, space-systems culture, family and robotics communities, and the South Bay freight ecosystem make a credible design-and-test base. Proximity does not prove inexpensive local production.</p></div>
        <div class="local-grid"><article><span class="serial">01 / EXPERTISE</span><h3>Toys meet systems.</h3><p><a href="https://corporate.mattel.com/contact-us">Mattel’s headquarters</a> and <a href="https://www.losangeles.spaceforce.mil/About-Us/About-Us/">Space Systems Command’s local presence</a> support a search for experienced specialists. <a href="https://www.elsegundoedc.org/">ESEDC</a> is a possible introduction route.</p></article><article><span class="serial">02 / PRACTICAL HELP</span><h3>Start with the right desk.</h3><p><a href="https://southbaysbdc.org/">South Bay SBDC</a> offers no-cost advising. <a href="https://laedc.org/business-assistance/">LAEDC</a> supports business and site planning. <a href="https://www.roadmap4innovation.com/supply-chain">R4I</a> offers supplier scouting; confirm fees and eligibility.</p></article><article><span class="serial">03 / PHYSICAL LEARNING</span><h3>Build a local feedback loop.</h3><p><a href="https://www.davincischools.org/march-recap-a-month-of-energy-innovation-and-community/">Da Vinci’s robotics community</a> and <a href="https://flightpathlax.com/aviation-museum-los-angeles-field-trips/">Flight Path Museum</a> suggest educational conversations. <a href="https://www.geniusfactoryco.com/">Genius Factory in Torrance</a> is an unvetted supplier lead with overseas production options.</p></article></div>
        <p class="local-note"><strong>Research leads, not partners.</strong> No organization listed here has endorsed, quoted, booked or agreed to this project. Venue access and participant research require explicit permission. Confirm workspace activities with the city; quote production and logistics using the actual specification.</p>
      </section>
      <section class="benchmark section"><div class="wrap benchmark-grid"><div><p class="eyebrow">08 / A useful adjacent benchmark</p><h2>Learn from<br />Microduck.</h2></div><div><p><a href="https://pollen-robotics.com/microduck/">Pollen Robotics’ Microduck</a> is a reference for expressive movement and open development. Its $399 introductory preorder and 15-motor biped specification were manufacturer claims observed October 17, not our tested performance or verified fulfillment.</p><p>Its runtime and reinforcement-learning code use <a href="https://github.com/pollen-robotics/microduck/blob/main/LICENSE">Apache-2.0</a>; specified model meshes separately use <a href="https://github.com/pollen-robotics/microduck_rl/blob/develop/LICENSE-MODELS.md">CC BY-NC-SA 4.0</a>. That noncommercial asset condition, trademarks and other rights require separate review. Commercial reskin rights and a partnership have not been established.</p></div></div></section>
      <section class="downloads section wrap" id="downloads" aria-labelledby="downloads-title">
        <div class="section-heading"><div><p class="eyebrow">09 / The complete working library</p><h2 id="downloads-title">Take the<br />whole world.</h2></div><div><p>Brand book, research report, editable cost model, source register, original concept images, SVG studies and production notes. Every file is available individually or together.</p><a class="button" href={manifest.archiveUrl} download>Download complete ZIP <span aria-hidden="true">↗</span></a></div></div>
        <ul class="file-list">{manifest.files.map((entry) => <li><a href={entry.url} download><span class="file-label">{entry.label}</span><span class="file-meta">{entry.kind} · {formatBytes(entry.bytes)} <span aria-hidden="true">↗</span></span></a></li>)}</ul>
        <p class="archive-note">The research and creative notes are dated October 17, 2026; their pre-publication statements are historical. Public copies include a dated publication note. This public archive was published <time datetime={manifest.publishedDate}>October 18, 2026</time>. <a href="/hoydich-play/manifest.json">View the public file manifest</a>.</p>
      </section>
      <section class="closing"><div class="wrap"><p class="eyebrow">HOYDICH PLAY / SIGNALSAURS / ROOK</p><h2>Small creature.<br />Big possibility.</h2><p>Concepts and names remain provisional. No working prototype, supplier quotation, certification, legal clearance, customer order or partnership is represented. This is a creative and research archive, not an offer for sale.</p><a href={docs.brand} download>Explore the brand book ↗</a></div></section>
    </main>
    <footer class="wrap"><p>Based on a brief by Michael Hoydich. Developed with Codex.</p><p><a href="/">PointCast</a><span aria-hidden="true"> / </span><a href="#main">Back to top ↑</a></p></footer>
  </body>
</html>
<style>
  :root{--bone:#f3eadb;--navy:#082f5b;--cobalt:#244b9a;--orange:#ea5014;--yellow:#f7c52b;--line:rgba(8,47,91,.22);color:var(--navy);background:var(--bone);font-family:Arial,Helvetica,sans-serif;font-synthesis:none;font-size:17px;scroll-behavior:smooth}
  *{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:.2em;text-decoration-thickness:1px}a:hover{text-decoration-thickness:2px}a:focus-visible{outline:3px solid var(--orange);outline-offset:5px}img{display:block;width:100%;height:auto}p{line-height:1.6;margin:0 0 1em}h1,h2,h3{line-height:1;letter-spacing:-.045em;margin:0;font-weight:800}h2{font-size:clamp(2.4rem,5vw,4.5rem)}h3{font-size:1.55rem;line-height:1.13}figure{margin:0}.wrap{max-width:1480px;margin-inline:auto;padding-inline:clamp(22px,4.5vw,72px)}.section{padding-block:clamp(60px,7vw,112px);scroll-margin-top:24px}.eyebrow,.serial{font-family:'Courier New',monospace;font-size:.7rem;line-height:1.5;letter-spacing:.09em;text-transform:uppercase;font-weight:700}.eyebrow{margin-bottom:22px}.serial{display:block;margin-bottom:22px}.skip{position:absolute;left:16px;top:-100px;padding:12px;background:var(--yellow);z-index:5}.skip:focus{top:10px}.topline{display:flex;justify-content:space-between;gap:20px;background:var(--navy);color:var(--bone);padding:11px clamp(22px,4.5vw,72px);font-family:'Courier New',monospace;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase}.site-header{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-block:28px}.maker{text-decoration:none;font-size:.8rem;letter-spacing:.03em;font-weight:900;line-height:.95;display:block}.maker>span{display:block;font-size:2.15rem;letter-spacing:-.08em}.logo-dot{display:inline-block;width:13px;height:13px;background:var(--orange);margin-left:7px}.site-header nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:26px;font-size:.74rem;font-weight:700}.site-header nav a{text-decoration:none}.site-header nav a:hover{text-decoration:underline}
  .hero{display:grid;grid-template-columns:.9fr 1.2fr;gap:clamp(26px,4vw,68px);align-items:center;padding-block:35px 70px}.hero h1{font-size:clamp(4.2rem,7.4vw,7.25rem);letter-spacing:-.065em;line-height:.9;margin-block:24px 30px}.hero h1 em{font-style:normal;color:var(--cobalt)}.hero-intro{font-size:clamp(1.05rem,1.65vw,1.45rem);max-width:28ch;line-height:1.35}.hero-copy>p:not(.eyebrow):not(.hero-intro){font-size:.87rem;max-width:41ch}.status-dot{display:inline-block;width:7px;height:7px;margin-right:7px;background:var(--orange)}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:30px}.button{display:inline-flex;justify-content:space-between;gap:35px;align-items:center;background:var(--navy);color:var(--bone);padding:17px 21px;text-decoration:none;font-size:.78rem;font-weight:700}.button:hover{background:var(--cobalt)}.text-link{font-weight:700;font-size:.78rem}.hero-figure{border:1px solid var(--line);padding:10px;background:#eee3d1}.hero-figure figcaption{display:flex;justify-content:space-between;gap:15px;font-family:'Courier New',monospace;font-size:.54rem;text-transform:uppercase;padding:13px 6px 3px;line-height:1.45}.signal-band{height:15px;display:grid;grid-template-columns:1.6fr 1fr .65fr}.signal-band i:nth-child(1){background:var(--cobalt)}.signal-band i:nth-child(2){background:var(--orange)}.signal-band i:nth-child(3){background:var(--yellow)}.section-heading{display:grid;grid-template-columns:1fr .8fr;gap:clamp(30px,7vw,120px);align-items:end;margin-bottom:42px}.section-heading>p,.section-heading>div>p:not(.eyebrow){font-size:.92rem;max-width:58ch}.architecture{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;margin:48px 0 0;border-block:1px solid var(--line)}.architecture li{padding:24px 18px 25px 0}.architecture li+li{padding-left:20px;border-left:1px solid var(--line)}.architecture small{display:block;text-transform:uppercase;font-family:'Courier New',monospace;font-size:.6rem;letter-spacing:.08em;margin-bottom:12px}.architecture strong{display:block;font-size:clamp(.88rem,1.5vw,1.2rem);letter-spacing:-.035em}
  .world{background:#e8dfd0}.mood-grid,.audience-grid,.ad-grid,.product-grid,.research-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.visual-card{background:var(--bone);border:1px solid var(--line)}.visual-card figcaption{padding:28px}.visual-card .eyebrow{margin-bottom:12px}.visual-card p:not(.eyebrow),.ad-card p{font-size:.82rem;margin-top:14px}.visual-card img,.ad-card img{transition:filter .2s}.visual-card a:hover img,.ad-card a:hover img{filter:brightness(1.025)}.audience{padding:clamp(28px,4vw,60px);color:var(--bone);position:relative;overflow:hidden}.audience h3{font-size:clamp(2.6rem,4.3vw,4.2rem);margin-bottom:26px}.audience>p{max-width:39ch;font-size:.95rem}.audience .fine{font-size:.72rem;opacity:.84;margin:36px 0 0;max-width:47ch}.family{background:var(--cobalt);border-top:9px solid var(--yellow)}.collector{background:var(--navy);border-top:9px solid var(--orange)}.product{background:var(--navy);color:var(--bone)}.product-grid{gap:70px}.product-grid article{border-top:1px solid #6a8199;padding-top:27px}.product-grid .serial{color:var(--yellow)}.product-grid h3{font-size:1.9rem;margin-bottom:24px}.product-grid p,.product-grid li{font-size:.88rem;line-height:1.6}.product-grid ul{padding-left:20px;margin:0}.product-grid li{padding-bottom:10px}.gate{margin-top:40px;background:var(--bone);color:var(--navy);border-left:7px solid var(--orange);padding:25px 30px;display:grid;grid-template-columns:190px 1fr;gap:25px}.gate>strong{font-size:1.15rem;line-height:1.15}.gate p{font-size:.78rem;margin:0}.ad-grid{gap:clamp(30px,6vw,90px);padding-inline:clamp(0px,3vw,44px)}.ad-card img{border:1px solid var(--line)}.ad-card figcaption{padding-top:24px}.ad-card h3{font-size:1.7rem}.research{background:var(--yellow)}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--navy);margin-top:45px}.stats>div{padding:28px 20px 28px 0}.stats>div+div{border-left:1px solid var(--navy);padding-left:25px}.stats strong{display:bloc