---
import BlockLayout from '../layouts/BlockLayout.astro';
import { COMMON_HOURS_RITUALS, COMMON_HOURS_URL } from '../lib/common-hours';

const title = 'Common Hours';
const description = 'A PointCast door into Common Hours: bells, altars, shrines, stamps, and small rituals for the hours we share.';
const pageUrl = 'https://pointcast.xyz/common-hours';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: title,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  sameAs: COMMON_HOURS_URL,
  hasPart: COMMON_HOURS_RITUALS.map((ritual) => ({ '@type': 'CreativeWork', name: ritual.name, description: ritual.note, url: ritual.path.startsWith('http') ? ritual.path : `https://pointcast.xyz${ritual.path}` })),
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/common-hours.json', title: 'Common Hours ritual index' }]}
  frame={{
    image: `${COMMON_HOURS_URL}/common-hours-field-guide.png`,
    buttons: [
      { label: 'Open Common Hours', action: 'link', target: COMMON_HOURS_URL },
      { label: 'Ritual index JSON', action: 'link', target: 'https://pointcast.xyz/common-hours.json' },
    ],
  }}
>
  <main class="hours">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><span>common hours</span><a href="/common-hours.json">JSON</a></nav>
    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">POINTCAST · COMMON HOURS · OPEN DAILY</p>
        <h1>Small rituals for the hours we share.</h1>
        <p class="dek">Bells, altars, shrines, stamps, drums, and tiny gatherings—collected here so the day has somewhere to begin again.</p>
        <div class="actions"><a class="primary" href={COMMON_HOURS_URL}>Open Common Hours ↗</a><a href="https://daily-chimes-ritual.mhoydich.chatgpt.site">Ring today’s chime ↗</a></div>
      </div>
      <div class="dial" aria-hidden="true"><span class="dial__hand"></span><span class="dial__sun"></span><b>⌁</b></div>
    </header>

    <section class="register" aria-label="Common Hours rituals">
      <div class="register__head"><p class="kicker">POINTCAST REGISTER</p><h2>Begin anywhere.</h2><p>{COMMON_HOURS_RITUALS.length} doors already open.</p></div>
      <div class="rituals">
        {COMMON_HOURS_RITUALS.map((ritual, index) => (
          <a class="ritual" href={ritual.path}>
            <small>{String(index + 1).padStart(2, '0')}</small><span class="ritual__mark">{ritual.mark}</span>
            <span class="ritual__copy"><em>{ritual.kind}</em><strong>{ritual.name}</strong><span>{ritual.note}</span></span><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="network">
      <p class="kicker">THE WIDER CONSTELLATION</p>
      <h2>PointCast is one door.</h2>
      <p>Common Hours also gathers the traveling rituals of Passportz, the marks of Stampz, and the togetherness of Rally—without flattening any of them into one product.</p>
      <div class="network__links"><a href={`${COMMON_HOURS_URL}/pointcast`}>PointCast ↗</a><a href={`${COMMON_HOURS_URL}/passportz`}>Passportz ↗</a><a href={`${COMMON_HOURS_URL}/stampz`}>Stampz ↗</a><a href={`${COMMON_HOURS_URL}/rally`}>Rally ↗</a></div>
    </section>
  </main>
</BlockLayout>

<style>
  .hours{--paper:#f2ead9;--ink:#182b32;--orange:#d85d26;--line:rgba(24,43,50,.24);background:var(--paper);color:var(--ink);min-height:100vh;padding:20px max(18px,calc((100vw - 1180px)/2)) 100px}.crumb{display:flex;gap:9px;align-items:center;padding:6px 0 20px;border-bottom:1px solid var(--line);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.11em}.crumb a:last-child{margin-left:auto}.hero{display:grid;grid-template-columns:1.35fr .65fr;gap:7vw;align-items:center;min-height:650px;border-bottom:1px solid var(--ink)}.kicker{margin:0 0 16px;font:700 10px var(--pc-font-mono);letter-spacing:.15em;text-transform:uppercase}.hero h1,.register h2,.network h2{font-family:Georgia,serif;font-weight:400;letter-spacing:-.055em}.hero h1{max-width:790px;margin:0;font-size:clamp(60px,8.5vw,116px);line-height:.86}.dek{max-width:700px;margin:28px 0;font:20px/1.5 Georgia,serif}.actions,.network__links{display:flex;gap:10px;flex-wrap:wrap}.actions a,.network__links a{padding:12px 15px;border:1px solid var(--ink);font:700 10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}.actions .primary{background:var(--ink);color:var(--paper)}.actions a:hover,.network__links a:hover{background:var(--orange);border-color:var(--orange);color:white;text-decoration:none}.dial{position:relative;aspect-ratio:1;border:1px solid var(--ink);border-radius:50%}.dial__hand{position:absolute;width:60%;height:1px;background:var(--ink);left:20%;top:50%;transform:rotate(-32deg)}.dial__sun{position:absolute;width:24px;height:24px;border-radius:50%;background:var(--orange);left:20%;top:65%}.dial b{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font:110px/1 Georgia,serif}.register{padding:100px 0}.register__head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:end;margin-bottom:40px}.register__head .kicker{align-self:start}.register h2,.network h2{margin:0;font-size:clamp(48px,6vw,78px);line-height:.92}.register__head>p:last-child{text-align:right}.rituals{border-top:1px solid var(--ink)}.ritual{display:grid;grid-template-columns:52px 72px 1fr 24px;align-items:center;min-height:120px;border-bottom:1px solid var(--line)}.ritual:hover{background:rgba(255,255,255,.28);text-decoration:none}.ritual small,.ritual__copy em{font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}.ritual__mark{font:34px Georgia,serif}.ritual__copy{display:grid;grid-template-columns:150px 240px 1fr;align-items:center;gap:20px}.ritual__copy em{font-style:normal}.ritual__copy strong{font:30px Georgia,serif}.ritual__copy>span{font-size:14px;line-height:1.4;color:rgba(24,43,50,.72)}.network{margin-top:20px;padding:100px max(20px,6vw);background:var(--ink);color:var(--paper);text-align:center}.network>p:not(.kicker){max-width:660px;margin:25px auto;font:19px/1.55 Georgia,serif}.network__links{justify-content:center}.network__links a{border-color:var(--paper)}
  @media(max-width:820px){.hero{grid-template-columns:1fr;padding:80px 0}.dial{display:none}.register__head{grid-template-columns:1fr}.register__head>p:last-child{text-align:left}.ritual__copy{grid-template-columns:1fr;gap:4px;padding:18px 8px}.ritual__copy>span{display:none}.ritual{grid-template-columns:38px 54px 1fr 20px}.network{padding:80px 20px}}
</style>
