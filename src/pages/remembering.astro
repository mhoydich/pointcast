---
import BlockLayout from '../layouts/BlockLayout.astro';
import PrayerLedger from '../components/PrayerLedger.astro';
import { remembranceCards, remembranceOccasions, remembranceIntents, buildRemembranceText } from '../lib/remembering.mjs';
import artwork from '../data/still-light-art.json';
import '../styles/remembering.css';
const first = remembranceCards[0];
---

<BlockLayout title="Remembering" description="A small place for love and remembrance. Make a gentle card, light a candle, and share words of care when you choose." image="/images/still-light/remembrance.webp" imageAlt="A candle, coral flower and green leaves reflected in water against a midnight blue background" imageWidth={1024} imageHeight={1536} author="Codex" creator="Codex" themeColor="#f7f0e1" immersive isolated hideAds includeManifest={false}>
  <div class="rem-page" data-remembering>
    <header class="rem-nav"><a href="/still-light/" aria-label="Return to Still Light">← Still Light</a><a href="/">PointCast <span aria-hidden="true">↗</span></a></header>
    <section class="rem-intro" aria-labelledby="rem-heading">
      <p class="rem-eyebrow">A place for remembrance</p>
      <h1 id="rem-heading">Love has a<br /><em>place here.</em></h1>
      <p>Choose a card. Hold a memory. Take your time.</p>
      <p class="rem-soft">There is no right way to feel today.</p>
    </section>
    <div class="rem-builder">
      <section class="rem-compose" aria-labelledby="rem-compose-title">
        <h2 id="rem-compose-title"><span class="rem-step" aria-hidden="true">01</span> Find a few words</h2>
        <fieldset class="rem-choices"><legend class="rem-sr">Choose your card message</legend>
          {remembranceCards.map((card, index) => <label class="rem-choice"><input type="radio" name="rem-card" disabled data-rem-enable value={card.id} checked={index === 0} /><span><strong>{card.title}</strong><small>{card.label}</small></span></label>)}
        </fieldset>
        <div class="rem-fields">
          <label for="rem-occasion">The occasion</label>
          <select id="rem-occasion" disabled data-rem-enable>{remembranceOccasions.map((item) => <option value={item.id}>{item.label}</option>)}</select>
          <label for="rem-intent">What you would like to offer</label>
          <select id="rem-intent" disabled data-rem-enable>{remembranceIntents.map((item) => <option value={item.id}>{item.label}</option>)}</select>
          <p class="rem-soft rem-note">Each card makes room for care without asking for a reply.</p>
          <fieldset class="rem-art-picker"><legend>Choose artwork</legend><div class="rem-art-grid">
            {artwork.map((art) => <label class="rem-art-choice"><input type="radio" name="rem-art" value={art.id} data-alt={art.alt} checked={art.id === 'remembrance'} disabled data-rem-enable /><span><img src={`/images/still-light/${art.id}-480.webp`} alt="" width="160" height="240" loading="lazy" /><span>{art.title} <small>{art.style}</small></span></span></label>)}
          </div></fieldset>
          <label for="rem-name">A name <span>(optional)</span></label>
          <input id="rem-name" type="text" disabled data-rem-enable maxlength="80" autocomplete="off" placeholder="Someone you are remembering" />
          <label for="rem-memory">A memory or personal message <span>(optional)</span></label>
          <textarea id="rem-memory" disabled data-rem-enable rows="4" maxlength="1200" placeholder="A moment, a kindness, something they loved…" aria-describedby="rem-privacy"></textarea>
          <p class="rem-soft rem-note" id="rem-privacy">Your words stay in this page while it is open. They are not saved or sent unless you choose Save card image, Share, or Copy.</p>
          <button type="button" disabled data-rem-enable class="rem-button rem-preview-link" id="rem-preview-link">See your card <span aria-hidden="true">↓</span></button>
        </div>
      </section>
      <section class="rem-preview" aria-labelledby="rem-preview-title">
        <h2 id="rem-preview-title" tabindex="-1"><span class="rem-step" aria-hidden="true">02</span> A moment of care</h2>
        <article class="rem-card">
          <div class="rem-card-art"><img id="rem-card-art" src="/images/still-light/remembrance.webp" alt="A candle and coral flower, reflected in still water." width="1024" height="1536" fetchpriority="high" /><span class="rem-card-stamp">With love</span></div>
          <div class="rem-card-copy">
            <p class="rem-dedication" id="rem-card-occasion">{remembranceOccasions[0].label}</p><p class="rem-dedication" id="rem-dedication" hidden></p>
            <h3 id="rem-card-title">{first.title}</h3>
            <p class="rem-card-message" id="rem-card-message">{first.message}</p><p class="rem-card-intent" id="rem-card-intent">{remembranceIntents[0].message}</p>
            <p class="rem-card-memory" id="rem-card-memory" hidden></p>
            <div class="rem-candle-scene" data-lit="false" aria-hidden="true"><span class="rem-halo"></span><span class="rem-flame"></span><span class="rem-wick"></span><span class="rem-wax"></span><span class="rem-dish"></span></div>
            <p class="rem-candle-caption" id="rem-candle-caption">A little light, when you wish.</p>
          </div>
        </article>
        <div class="rem-actions">
          <button type="button" disabled data-rem-enable class="rem-button rem-primary" id="rem-candle" aria-label="Remembrance candle" aria-pressed="false">Light a candle</button>
          <button type="button" disabled data-rem-enable class="rem-button" id="rem-bell" aria-label="Gentle bell" aria-pressed="false">Sound a gentle bell</button>
        </div>
        <p class="rem-soft rem-note">Silence is welcome. Sound plays only when you tap the bell.</p>
        <div class="rem-share-section">
          <h2><span class="rem-step" aria-hidden="true">03</span> Keep close or share</h2>
          <p>Sharing sends these words. Your candle stays here with you.</p>
          <details class="rem-share-preview"><summary>Read exactly what will be shared</summary><pre id="rem-share-text">{buildRemembranceText(first.id, '', '', remembranceOccasions[0].id, remembranceIntents[0].id)}</pre></details>
          <div class="rem-actions"><button type="button" disabled data-rem-enable class="rem-button rem-primary" id="rem-save-image">Save card image</button><button type="button" disabled data-rem-enable class="rem-button" id="rem-prepare-image">Prepare card image</button><button type="button" disabled class="rem-button" id="rem-share-image">Share prepared image</button></div><p class="rem-soft rem-note">The image is made on your device. It includes the selected words and artwork; its layout reflows line breaks. Prepare a new image after making changes.</p><div class="rem-actions"><button type="button" disabled data-rem-enable class="rem-button rem-primary" id="rem-share">Share these words</button><button type="button" disabled data-rem-enable class="rem-button" id="rem-copy">Copy these words</button></div>
          <div id="rem-manual-copy" hidden><label for="rem-copy-text">Copy this text manually</label><textarea id="rem-copy-text" readonly rows="8"></textarea></div>
          <p class="rem-status" id="rem-status" role="status" aria-live="polite"></p>
        </div>
      </section>
    </div>
    <noscript><p class="rem-noscript">This card is here to read. Enable JavaScript to personalize it, light the candle, or use the sharing controls.</p></noscript>
    <PrayerLedger station="remembering" label="Offer a moment of care" />
    <footer class="rem-footer"><span>Remembering · Words of care, at your pace.<br /><span class="rem-soft">Michael × Terra 6.1</span></span><a href="/still-light/">Visit the prayer garden →</a></footer>
  </div>
  <script>import '../lib/remembering-client';</script>
</BlockLayout>
