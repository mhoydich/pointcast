---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Noggle Stacker';
const description = 'Tap to drop a moving noggle slab and build a clean tower in the PointCast Win95 Retro Arcade.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/noggle-stacker', name: title, description, url: 'https://pointcast.xyz/noggle-stacker' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-stacker>
    <section class="window" aria-labelledby="stacker-title">
      <header class="titlebar"><span>Noggle Stacker</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Noggle Stacker menu">
        <button type="button" data-new>Game</button>
        <a href="/noun-flappy">Flappy</a>
        <a href="/pixel-pipes">Pipes</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">TAP · DROP · TOWER</p><h1 id="stacker-title">Stack twelve.</h1><p>Tap when the slab lines up. Missed overlap ends the run.</p></div>
        <div class="meters"><span>Rows <strong data-score>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage">
        <canvas data-canvas width="360" height="520" aria-label="Noggle Stacker play field"></canvas>
        <div class="overlay" data-overlay hidden>
          <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="stacker-dialog-title">
            <header class="dlgbar"><span id="stacker-dialog-title" data-dialog-title>Ready</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
            <div class="dlgbody"><p data-dialog-message>Tap to drop.</p><button type="button" data-restart>New Game</button></div>
          </div>
        </div>
      </div>
      <footer class="status" data-status aria-live="polite">Tap to drop the moving slab.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-stacker]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width;
      const H = canvas.height;
      const slug = 'noggle-stacker';
      const statsKey = 'pc:arcade:' + slug;
      const profileKey = 'pc:arcade:profile';
      const gameName = 'Stacker';
      const badge = 'stacker-tower';
      const scoreEl = root.querySelector<HTMLElement>('[data-score]');
      const bestEl = root.querySelector<HTMLElement>('[data-best]');
      const statusEl = root.querySelector<HTMLElement>('[data-status]');
      const overlay = root.querySelector<HTMLElement>('[data-overlay]');
      const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
      const noun = new Image();
      noun.src = 'https://noun.pics/884.svg';
      const colors = ['#4a9eff', '#2cc5a0', '#f7c325', '#e84d6a', '#d22209', '#d5d7e3'];
      type Block = { x: number; y: number; w: number; h: number; color: string };
      let blocks: Block[] = [];
      let current: Block & { vx: number } = { x: 0, y: 0, w: 0, h: 0, color: colors[0], vx: 0 };
      let rows = 0;
      let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 }).bestScore || 0);
      let running = false;
      let over = false;
      let won = false;
      let last = 0;
      let raf = 0;

      function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
      function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
      function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
      function renderMeters() {
        if (scoreEl) scoreEl.textContent = String(rows);
        if (bestEl) bestEl.textContent = best ? String(best) : '--';
      }
      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestScore = Math.max(Number(stats.bestScore || 0), rows);
        }
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
        profile.lastPlayed = gameName;
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = gameName;
          const earned = ['first-win', badge];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
      }
      function persistBest() {
        best = Math.max(best, rows);
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        stats.bestScore = Math.max(Number(stats.bestScore || 0), rows);
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        renderMeters();
      }
      function showDialog(title: string, message: string) {
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogMessage) dialogMessage.textContent = message;
        if (overlay) overlay.hidden = false;
      }
      function hideDialog() { if (overlay) overlay.hidden = true; }
      function makeMoving(width: number, row: number) {
        const h = 26;
        const y = H - 54 - (row + 1) * h;
        current = {
          x: row % 2 ? W - width - 16 : 16,
          y,
          w: width,
          h,
          color: colors[row % colors.length],
          vx: (row % 2 ? -1 : 1) * (120 + row * 16),
        };
      }
      function newGame() {
        cancelAnimationFrame(raf);
        rows = 0;
        blocks = [{ x: 48, y: H - 54, w: W - 96, h: 26, color: '#000080' }];
        makeMoving(blocks[0].w, 0);
        running = true;
        over = false;
        won = false;
        last = 0;
        hideDialog();
        recordPlay(false);
        renderMeters();
        setStatus('Line up the moving slab and tap to drop.');
        raf = requestAnimationFrame(frame);
      }
      function drop() {
        if (over || won) { newGame(); return; }
        if (!running) return;
        const base = blocks[blocks.length - 1];
        const left = Math.max(current.x, base.x);
        const right = Math.min(current.x + current.w, base.x + base.w);
        const overlap = right - left;
        if (overlap <= 4) {
          rows = blocks.length - 1;
          end(false);
          return;
        }
        rows++;
        blocks.push({ x: left, y: current.y, w: overlap, h: current.h, color: current.color });
        persistBest();
        setStatus('Row ' + rows + ' locked.');
        if (rows >= 12) { end(true); return; }
        makeMoving(Math.max(34, overlap), rows);
        renderMeters();
      }
      function end(clear: boolean) {
        running = false;
        if (clear) {
          won = true;
          rows = Math.max(rows, 12);
          recordPlay(true);
          persistBest();
          setStatus('Twelve rows stacked.');
          showDialog('Cleared!', 'Twelve rows stacked. Badge logged locally.');
        } else {
          over = true;
          persistBest();
          setStatus('No overlap. Tower stopped at ' + rows + '.');
          showDialog('Game Over', 'No overlap. Tower height: ' + rows + '.');
        }
      }
      function update(dt: number) {
        current.x += current.vx * dt;
        if (current.x < 12) { current.x = 12; current.vx = Math.abs(current.vx); }
        if (current.x + current.w > W - 12) { current.x = W - 12 - current.w; current.vx = -Math.abs(current.vx); }
      }
      function bevelRect(b: Block) {
        ctx.fillStyle = b.color;
        ctx.fillRect(b.x, b.y, b.w, b.h);
        ctx.fillStyle = 'rgba(255,255,255,.65)';
        ctx.fillRect(b.x, b.y, b.w, 3);
        ctx.fillRect(b.x, b.y, 3, b.h);
        ctx.fillStyle = 'rgba(0,0,0,.38)';
        ctx.fillRect(b.x, b.y + b.h - 3, b.w, 3);
        ctx.fillRect(b.x + b.w - 3, b.y, 3, b.h);
      }
      function draw() {
        ctx.fillStyle = '#101018';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#202046';
        for (let y = 32; y < H - 40; y += 26) ctx.fillRect(0, y, W, 1);
        if (noun.complete && noun.naturalWidth) {
          ctx.globalAlpha = 0.22;
          ctx.drawImage(noun, W - 126, 12, 104, 104);
          ctx.globalAlpha = 1;
        }
        blocks.forEach(bevelRect);
        if (!over && !won) bevelRect(current);
        ctx.fillStyle = '#fff';
        ctx.font = '700 24px Courier New';
        ctx.textAlign = 'left';
        ctx.fillText('ROWS ' + rows + '/12', 14, 30);
      }
      function frame(t: number) {
        const dt = last ? Math.min(0.033, (t - last) / 1000) : 0;
        last = t;
        if (running && !over && !won) update(dt);
        draw();
        if (running && !over && !won) raf = requestAnimationFrame(frame);
      }
      canvas.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        canvas.setPointerCapture(event.pointerId);
        drop();
      });
      root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else if (running && !over && !won) { last = 0; raf = requestAnimationFrame(frame); }
      });
      renderMeters();
      newGame();
    }
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,760px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:42ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; gap:6px; }
  .meters span { min-width:72px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 20px/1 "Courier New",monospace; color:#000080; }
  .stage { position:relative; width:min(calc(100vw - 36px),360px); margin:4px auto 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#000; }
  canvas { display:block; width:100%; height:auto; image-rendering:pixelated; touch-action:none; user-select:none; -webkit-user-select:none; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 8px 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
</style>
