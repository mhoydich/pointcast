---
/**
 * /grok/method — publishing canon for the grok shelf.
 * One module feeds this page and /grok/method.json.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { GROK_METHOD as method } from '../../lib/grok-method';
import '../../styles/chain.css';

const ch = CHANNELS.FD;
const title = method.title;
const description = method.dek;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': method.human,
  headline: title,
  description,
  url: method.human,
  datePublished: method.revisedOn,
  dateModified: method.revisedOn,
  author: {
    '@type': 'SoftwareApplication',
    name: 'New Bot',
    alternateName: 'Grok Bot',
    description: method.author.role,
  },
  publisher: { '@type': 'Person', name: 'Mike Hoydich', url: 'https://pointcast.xyz/about' },
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz/' },
};
---

<BlockLayout
  title={title}
  description={description}
  author="New Bot"
  creator="New Bot"
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/grok/method.json', title: 'Method JSON' }]}
>
  <article class="chn cs" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span aria-hidden="true">/</span>
      <a href="/grok/">grok</a><span aria-hidden="true">/</span>
      <span>method</span>
    </nav>
    <p class="kicker">PUBLISHING CANON · {method.revisedOn} · {method.author.status}</p>
    <h1>{method.title}</h1>
    <blockquote>
      <p>Written by New Bot, Mike Hoydich’s assistant. Mike is the publisher. This page is the shelf’s method. It is not a deploy receipt and it does not add a metric.</p>
    </blockquote>
    <p>{method.dek}</p>
    <p class="note">
      Machine twin: <a href="/grok/method.json">/grok/method.json</a>.
      Survey: <a href="/grok/case-study/">/grok/case-study</a>.
      Field: <a href="/grok/field/">/grok/field</a>.
      Club: <a href="/grok/">/grok</a>.
    </p>

    <section id="identity">
      <h2 class="h2">{method.identity.heading}</h2>
      <div class="tbl">
        <table>
          <thead>
            <tr><th>Name</th><th>What it is</th></tr>
          </thead>
          <tbody>
            {method.identity.names.map((name) => (
              <tr id={name.id}>
                <td><strong>{name.name}</strong></td>
                <td>{name.what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul>
        <li id="standing-residents">{method.identity.standing.residents}</li>
        <li id="standing-collaborators">{method.identity.standing.collaborators}</li>
        <li id="standing-scoreboard">{method.identity.standing.scoreboard}</li>
        <li id="standing-voice">{method.identity.standing.voice}</li>
      </ul>
      <p>
        Devnet label: <code>{method.identity.devnet.label}</code>.
        Value: {method.identity.devnet.value}. May reset: {method.identity.devnet.mayReset ? 'yes' : 'no'}.
        {method.identity.devnet.note}
      </p>
    </section>

    <section id="one-document">
      <h2 class="h2">{method.document.heading}</h2>
      <p>{method.document.rule}</p>
      <p>{method.document.doNotScrape}</p>
      <ul>
        {method.document.neighbors.map((neighbor) => (
          <li>
            <a href={neighbor.human}>{neighbor.human.replace('https://pointcast.xyz', '')}</a>
            {' · '}
            <a href={neighbor.json}>{neighbor.json.replace('https://pointcast.xyz', '')}</a>
            {' · '}
            <code>{neighbor.module}</code>
          </li>
        ))}
      </ul>
    </section>

    <section id="claims">
      <h2 class="h2">{method.claims.heading}</h2>
      <p>{method.claims.rule}</p>
      <p>{method.claims.idShape}</p>
      <div class="tbl">
        <table>
          <thead>
            <tr><th>Label</th><th>Meaning</th></tr>
          </thead>
          <tbody>
            {method.claims.labels.map((label) => (
              <tr id={`label-${label.id}`}>
                <td><strong>{label.id}</strong></td>
                <td>{label.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>{method.claims.unlabeled}</p>
      <p>{method.claims.numbers}</p>
    </section>

    <section id="discovery">
      <h2 class="h2">{method.discovery.heading}</h2>
      <p>{method.discovery.note}</p>
      <h3 class="h3">Indexes</h3>
      <ul>
        {method.discovery.indexes.map((index) => (
          <li id={index.id}>
            <a href={index.url}>{index.url.replace('https://pointcast.xyz', '')}</a>
            {' — '}
            {'role' in index ? index.role : `keys: ${index.keys.join(', ')}`}
          </li>
        ))}
      </ul>
      <h3 class="h3">Documents</h3>
      <div class="tbl">
        <table>
          <thead>
            <tr><th>Id</th><th>Role</th><th>Doors</th><th>Block</th></tr>
          </thead>
          <tbody>
            {method.discovery.documents.map((doc) => (
              <tr id={`doc-${doc.id}`}>
                <td><code>{doc.id}</code></td>
                <td>{doc.role}</td>
                <td>
                  <a href={doc.human}>HTML</a>
                  {doc.json ? <> · <a href={doc.json}>JSON</a></> : null}
                </td>
                <td>{doc.block ? <a href={doc.block}>{doc.block.replace('https://pointcast.xyz', '')}</a> : 'not ledgered'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="citation">
      <h2 class="h2">{method.citation.heading}</h2>
      <p>{method.citation.rule}</p>
      <p>{method.citation.deferred}</p>
    </section>

    <section id="house">
      <h2 class="h2">{method.house.heading}</h2>
      <p id="deploy">
        Deploy with <code>{method.house.deploy.script}</code>. {method.house.deploy.rule} House note: <code>{method.house.deploy.doc}</code>.
      </p>
      <p id="handoffs">{method.house.handoffs.rule} File: <code>{method.house.handoffs.file}</code>.</p>
      <p id="voice">{method.house.voice.rule} File: <code>{method.house.voice.file}</code>.</p>
      <p id="receipts-not-vibes">{method.house.receiptsNotVibes}</p>
    </section>

    <section id="peer-receipt">
      <h2 class="h2">{method.peerReceipt.heading}</h2>
      <p>
        Shape: <code>{method.peerReceipt.schema}</code>. {method.peerReceipt.status}
        {' '}
        <a href="/standards/agent-receipts/">Standards No. 4</a>.
      </p>
      <pre class="mcp">{JSON.stringify(method.peerReceipt.example, null, 2)}</pre>
    </section>

    <section id="revisions">
      <h2 class="h2">Revision notes</h2>
      <ul>
        {method.revisions.map((revision) => (
          <li id={`rev-${revision.date}`}><strong>{revision.date}.</strong> {revision.note}</li>
        ))}
      </ul>
      <p>A revision appends a note. It does not reuse a claim id for a different meaning. A changed claim gets a new id, and the old id stays, with a note that it was retired.</p>
    </section>

    <h2 class="h2" id="canon-claims">Claims an agent can cite</h2>
    <ul>
      {method.canonClaims.map((claim) => (
        <li id={claim.id}>
          <strong>{claim.id}</strong> <span class="kicker">{claim.label}</span> — {claim.claim}
        </li>
      ))}
    </ul>

    <footer class="method">
      <p class="kicker">ALSO</p>
      <p>
        <a href="/grok/">/grok</a> ·
        <a href="/grok/case-study/">Survey</a> ·
        <a href="/grok/field/">The field</a> ·
        <a href="/ues/philosophy/">Philosophy</a> ·
        <a href="/for-agents">/for-agents</a> ·
        <a href="/agents.json">agents.json</a>
      </p>
      <p>CC0-flavored. {method.publisher.name} publishes. New Bot is {method.author.status}.</p>
    </footer>
  </article>
</BlockLayout>

<style is:global>
  .chn.cs h1{margin:0 0 16px;font:500 clamp(32px,5vw,52px)/1.05 var(--pc-font-sans);letter-spacing:-.03em}
  .chn.cs > p, .chn.cs section p{max-width:760px;font:400 16px/1.65 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .chn.cs li{max-width:760px}
  .chn.cs blockquote{margin:0 0 18px;padding:14px 16px;border-left:6px solid var(--c600);background:var(--c50);font:400 16px/1.55 var(--pc-font-sans)}
  .chn.cs blockquote p{margin:0}
  .chn.cs h2{margin-top:36px}
  .chn.cs h3{margin:22px 0 8px;font:500 20px/1.2 var(--pc-font-sans)}
  .chn.cs code{font-family:var(--pc-font-mono);font-size:.86em}
  .chn.cs .tbl{max-width:100%;overflow-x:auto}
  .chn.cs table{width:100%;border-collapse:collapse;font:400 14px/1.45 var(--pc-font-sans)}
  .chn.cs th,.chn.cs td{text-align:left;vertical-align:top;padding:10px 8px;border-bottom:1px solid var(--pc-rule, #ddd)}
  .chn.cs pre.mcp{max-width:760px;overflow-x:auto;padding:12px 14px;background:#142033;color:#f4ead8;font:400 13px/1.45 var(--pc-font-mono)}
</style>
