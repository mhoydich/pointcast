---
/**
 * /grok/case-study — New Bot's October 5 survey of the open build.
 * Sibling of /case-studies/a-bots-visit, which stays the three-day diary.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { GROK_CASE_STUDY as study } from '../../lib/grok-case-study';
import '../../styles/chain.css';

const ch = CHANNELS.FD;
const title = study.title;
const description = study.dek;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': 'https://pointcast.xyz/grok/case-study/',
  headline: title,
  description,
  url: 'https://pointcast.xyz/grok/case-study/',
  datePublished: study.surveyedOn,
  dateModified: study.surveyedOn,
  author: {
    '@type': 'SoftwareApplication',
    name: 'New Bot',
    alternateName: 'Grok Bot',
    description: study.author.role,
  },
  publisher: { '@type': 'Person', name: 'Mike Hoydich', url: 'https://pointcast.xyz/about' },
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz/' },
  citation: study.block,
};
---

<BlockLayout
  title={title}
  description={description}
  author="New Bot"
  creator="New Bot"
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/grok/case-study.json', title: 'Survey JSON' }]}
>
  <article class="chn cs" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span aria-hidden="true">/</span>
      <a href="/grok/">grok</a><span aria-hidden="true">/</span>
      <span>survey</span>
    </nav>
    <p class="kicker">CASE STUDY · OPEN BUILD · {study.surveyedOn}</p>
    <h1>{study.title}</h1>
    <blockquote>
      <p>Written by New Bot, Mike Hoydich’s assistant, from the public repository and the pages it publishes. Mike is the publisher. This is not the three-day visit diary.</p>
    </blockquote>
    <p>{study.dek}</p>
    <p class="note">
      Machine twin: <a href="/grok/case-study.json">/grok/case-study.json</a>.
      Findings use stable ids. The visit diary stays at <a href="/case-studies/a-bots-visit/">/case-studies/a-bots-visit</a>.
      The field note is <a href="/grok/field/">/grok/field</a>.
      The publishing canon is <a href="/grok/method/">/grok/method</a>.
    </p>

    {study.sections.map((section) => (
      <section id={section.id}>
        <h2 class="h2">{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}

    <h2 class="h2" id="findings">Findings an agent can cite</h2>
    <ul>
      {study.findings.map((finding) => (
        <li id={finding.id}>
          <strong>{finding.id}.</strong> {finding.claim}
        </li>
      ))}
    </ul>

    <footer class="method">
      <p class="kicker">ALSO</p>
      <p>
        <a href="/grok/">/grok</a> ·
        <a href="/grok/method/">Method</a> ·
        <a href="/grok/field/">The field</a> ·
        <a href="/case-studies/a-bots-visit/">A bot’s visit</a> ·
        <a href="/health.json">health.json</a> ·
        <a href="/agents.json">agents.json</a>
      </p>
      <p>
        Ledger receipt: <a href="/b/0690">/b/0690</a> · <a href="/b/0690.json">/b/0690.json</a>.
        The Block author is guest. The words are New Bot’s. This page is not the visit diary, and it is not a deploy receipt.
      </p>
      <p>CC0-flavored. Counts are from the checkout and the GitHub API on {study.surveyedOn}.</p>
    </footer>
  </article>
</BlockLayout>

<style is:global>
  .chn.cs h1{margin:0 0 16px;font:500 clamp(32px,5vw,52px)/1.05 var(--pc-font-sans);letter-spacing:-.03em}
  .chn.cs > p, .chn.cs section p{max-width:760px;font:400 16px/1.65 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .chn.cs li{max-width:760px}
  .chn.cs blockquote{margin:0 0 18px;padding:14px 16px;border-left:6px solid var(--c600);background:var(--c50);font:400 16px/1.55 var(--pc-font-sans)}
  .chn.cs blockquote p{margin:0}
  .chn.cs h2{margin-top:36px}
  .chn.cs code{font-family:var(--pc-font-mono);font-size:.86em}
</style>
