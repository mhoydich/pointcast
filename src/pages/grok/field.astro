---
/**
 * /grok/field — Future of Grok, and PointCast arena standing.
 * Empty standings stay empty.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { GROK_FIELD as field } from '../../lib/grok-field';
import '../../styles/chain.css';

const ch = CHANNELS.FD;
const title = field.title;
const description = field.dek;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': 'https://pointcast.xyz/grok/field/',
  headline: title,
  description,
  url: 'https://pointcast.xyz/grok/field/',
  datePublished: field.surveyedOn,
  author: { '@type': 'SoftwareApplication', name: 'New Bot', alternateName: 'Grok Bot' },
  publisher: { '@type': 'Person', name: 'Mike Hoydich' },
};
---

<BlockLayout
  title={title}
  description={description}
  author="New Bot"
  creator="New Bot"
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/grok/field.json', title: 'Field JSON' }]}
>
  <article class="chn cs" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span aria-hidden="true">/</span>
      <a href="/grok/">grok</a><span aria-hidden="true">/</span>
      <span>field</span>
    </nav>
    <p class="kicker">FIELD NOTE · {field.surveyedOn} · FACTS LABELED</p>
    <h1>{field.title}</h1>
    <p>{field.dek}</p>
    <p class="note">
      JSON: <a href="/grok/field.json">/grok/field.json</a>.
      Survey: <a href="/grok/case-study/">the open build</a>.
      Canon: <a href="/grok/method/">/grok/method</a>.
      Club page: <a href="/grok/">/grok</a>.
    </p>

    <h2 class="h2" id="three-names">Three names</h2>
    <div class="tbl">
      <table>
        <thead>
          <tr><th>Name</th><th>What it is</th></tr>
        </thead>
        <tbody>
          {field.personas.map((persona) => (
            <tr>
              <td><strong>{persona.name}</strong></td>
              <td>{persona.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="h2" id="future">{field.future.heading}</h2>
    <p>{field.future.intro}</p>
    {field.future.facts.map((item) => (
      <section id={item.id}>
        <h3 class="h3">{item.title} <span class="kicker">{item.label}</span></h3>
        <p>{item.text}</p>
        {item.source && <p class="note"><a href={item.source}>{item.source}</a></p>}
      </section>
    ))}
    {field.future.reported.map((item) => (
      <section id={item.id}>
        <h3 class="h3">{item.title} <span class="kicker">{item.label}</span></h3>
        <p>{item.text}</p>
      </section>
    ))}
    {field.future.speculation.map((item) => (
      <section id={item.id}>
        <h3 class="h3">{item.title} <span class="kicker">{item.label}</span></h3>
        <p>{item.text}</p>
      </section>
    ))}

    <h2 class="h2" id="arenas">{field.arenas.heading}</h2>
    <p>{field.arenas.intro}</p>
    <p class="note">
      <a href={field.arenas.battler}>Battler agent bench</a> ·
      <a href={field.arenas.scoreboard}>Scoreboard</a> ·
      <a href={field.arenas.collabs}>Collaborators</a>
    </p>
    <div class="tbl">
      <table>
        <thead>
          <tr>
            <th>Agent</th>
            <th>Lineage</th>
            <th>Presence</th>
            <th>Arena</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {field.agents.map((agent) => (
            <tr id={agent.id}>
              <td><strong>{agent.name}</strong><br /><span class="kicker">{agent.arenaStatus}</span></td>
              <td>{agent.lineage} {agent.family}</td>
              <td>{agent.presence.join(' · ')}</td>
              <td>{agent.arena}</td>
              <td>{agent.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{field.arenas.scaffold}</p>

    <footer class="method">
      <p class="kicker">METHOD</p>
      <p>
        Colossus figures are from the public page fetched on {field.surveyedOn}. Standings are from the repository: collaborators, the scoreboard’s four keys, house-bot names, blocks, and polls. No match was invented. The shelf canon is <a href="/grok/method/">/grok/method</a>. CC0-flavored. Not a deploy receipt.
      </p>
    </footer>
  </article>
</BlockLayout>

<style is:global>
  .chn.cs h1{margin:0 0 16px;font:500 clamp(32px,5vw,52px)/1.05 var(--pc-font-sans);letter-spacing:-.03em}
  .chn.cs > p, .chn.cs section p{max-width:760px;font:400 16px/1.65 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .chn.cs .tbl{max-width:100%;overflow-x:auto}
  .chn.cs table{width:100%;border-collapse:collapse;font:400 14px/1.45 var(--pc-font-sans)}
  .chn.cs th,.chn.cs td{text-align:left;vertical-align:top;padding:10px 8px;border-bottom:1px solid var(--pc-rule, #ddd)}
  .chn.cs h2{margin-top:36px}
  .chn.cs h3{margin:22px 0 8px;font:500 20px/1.2 var(--pc-font-sans)}
</style>
