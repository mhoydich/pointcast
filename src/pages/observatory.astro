---
import BlockLayout from '../layouts/BlockLayout.astro';
import MicroAppShell from '../components/MicroAppShell.astro';
import { MORNING_OCEAN_TOKENS } from '../data/morning-ocean';
import { ZEN_CAT_GENESIS_COLLECTIBLES } from '../data/zen-cat-collectibles';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('observatory')!;
const title = app.name;
const description = app.description;

const lenses = [
  {
    id: 'mint',
    label: 'Mint Receipts',
    key: 'pc:mint-studio:receipts',
    href: '/mint-studio',
    action: 'Draft provenance',
    empty: 'No mint stars yet.',
    color: '#bf6f54',
    x: 188,
    y: 190,
  },
  {
    id: 'harbor',
    label: 'Harbor Watch',
    key: 'pc:harbor-log:watchlist',
    href: '/harbor-log',
    action: 'Watch a vessel',
    empty: 'No harbor stars yet.',
    color: '#3f7681',
    x: 512,
    y: 170,
  },
  {
    id: 'ocean',
    label: 'Morning Ocean',
    key: 'pc:morning-ocean:collection',
    href: '/morning-ocean',
    action: 'Collect a card',
    empty: 'No ocean stars yet.',
    color: '#6b8e99',
    x: 694,
    y: 306,
  },
  {
    id: 'passport',
    label: 'Cat Passport',
    key: 'pc:cat-passport:stamps',
    href: '/cat-passport',
    action: 'Stamp a route',
    empty: 'No passport stars yet.',
    color: '#b84f55',
    x: 828,
    y: 188,
  },
  {
    id: 'gallery',
    label: 'Gallery Shows',
    key: 'pc:gallery-wall:shows',
    href: '/gallery-wall',
    action: 'Curate a wall',
    empty: 'No gallery stars yet.',
    color: '#875c9e',
    x: 914,
    y: 346,
  },
  {
    id: 'signal',
    label: 'Signal Garden',
    key: 'pc:signal-garden:plants',
    href: '/signal-garden',
    action: 'Plant today',
    empty: 'No garden stars yet.',
    color: '#2f8f5f',
    x: 528,
    y: 308,
  },
  {
    id: 'ritual',
    label: 'Ritual Clock',
    key: 'pc:ritual-clock:marks',
    href: '/ritual-clock',
    action: 'Mark today',
    empty: 'No ritual stars yet.',
    color: '#c38b35',
    x: 620,
    y: 556,
  },
  {
    id: 'exchange',
    label: 'Exchange Table',
    key: 'pc:exchange-table:wishes',
    href: '/exchange-table',
    action: 'Add intent',
    empty: 'No exchange stars yet.',
    color: '#7b8b53',
    x: 352,
    y: 562,
  },
  {
    id: 'provenance',
    label: 'Provenance Proofs',
    key: 'pc:provenance-ledger:exports',
    href: '/provenance-ledger',
    action: 'Scan proofs',
    empty: 'No proof stars yet.',
    color: '#586c8c',
    x: 86,
    y: 242,
  },
  {
    id: 'atlas',
    label: 'World Atlas',
    key: 'pc:world-atlas:stamps',
    href: '/world-atlas',
    action: 'Stamp route',
    empty: 'No atlas stars yet.',
    color: '#267f78',
    x: 902,
    y: 520,
  },
  {
    id: 'cats',
    label: 'Zen Cats',
    key: 'pc:zen-cats:collection',
    href: '/zen-cats',
    action: 'Collect a cat',
    empty: 'No daily cat stars yet.',
    color: '#d28c7a',
    x: 772,
    y: 480,
  },
  {
    id: 'journey',
    label: 'Journey Prints',
    key: 'pc:zen-cats:journey',
    href: '/zen-cats#journey',
    action: 'Unlock a print',
    empty: 'No journey stars yet.',
    color: '#6d8a55',
    x: 478,
    y: 488,
  },
  {
    id: 'sats',
    label: 'Sats Path',
    key: 'pc:sats-path:checks',
    href: '/sats-path',
    action: 'Mark readiness',
    empty: 'No capital habit stars yet.',
    color: '#c39b39',
    x: 238,
    y: 502,
  },
  {
    id: 'invites',
    label: 'Invite Ledger',
    key: 'pc:referral-garden:invites',
    href: '/referral-garden',
    action: 'Record an invite',
    empty: 'No invite stars yet.',
    color: '#7d6aa8',
    x: 112,
    y: 360,
  },
];

const images = [
  { src: MORNING_OCEAN_TOKENS[0].imageUrl, alt: `${MORNING_OCEAN_TOKENS[0].title} Morning Ocean card` },
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[2].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[2].title} Zen Cat card` },
  { src: MORNING_OCEAN_TOKENS[10].imageUrl, alt: `${MORNING_OCEAN_TOKENS[10].title} Morning Ocean card` },
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[8].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[8].title} Zen Cat card` },
  { src: MORNING_OCEAN_TOKENS[20].imageUrl, alt: `${MORNING_OCEAN_TOKENS[20].title} Morning Ocean card` },
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[5].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[5].title} Zen Cat card` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/observatory',
  name: app.name,
  description,
  url: app.url,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  frame={{
    image: 'https://pointcast.xyz/images/morning-ocean/series-contact-sheet.png',
    buttons: [
      { label: 'Open Observatory', action: 'link', target: 'https://pointcast.xyz/observatory' },
      { label: 'Open Cabinet', action: 'link', target: 'https://pointcast.xyz/cabinet' },
      { label: 'Morning Ocean', action: 'link', target: 'https://pointcast.xyz/morning-ocean' },
    ],
  }}
>
  <MicroAppShell
    app={app}
    headline="Turn the whole collection into a sky."
    dek="The Observatory reads the same local collector state as the Cabinet, then arranges it as a private star chart. No sync, no account, no transmission - just the shape of what you have been gathering."
    images={images}
    stats={[
      { label: 'Lenses', value: lenses.length },
      { label: 'Source', value: 'local' },
      { label: 'Map', value: 'live' },
      { label: 'Mode', value: 'night' },
    ]}
    links={[
      { href: '/cabinet', label: 'Cabinet' },
      { href: '/zen-cats', label: 'Cats' },
      { href: '/morning-ocean', label: 'Ocean' },
    ]}
  >
    <section class="app-section observatory" data-observatory>
      <div class="sky-layout">
        <section class="sky-panel" aria-label="Local collection constellation">
          <div class="sky-panel__top">
            <div>
              <p class="mono-note">Local Constellation</p>
              <h2 data-sky-name-display>Unnamed night</h2>
            </div>
            <div class="sky-score">
              <span>Total Stars</span>
              <strong data-star-total>0</strong>
            </div>
          </div>
          <svg class="star-map" viewBox="0 0 1000 620" role="img" aria-labelledby="observatory-title observatory-desc">
            <title id="observatory-title">PointCast Observatory constellation map</title>
            <desc id="observatory-desc">A generated night-sky map based on local PointCast collection state.</desc>
            <defs>
              <radialGradient id="night-glow" cx="50%" cy="42%" r="64%">
                <stop offset="0%" stop-color="#f5eee0" stop-opacity="0.28" />
                <stop offset="46%" stop-color="#6f8d84" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#171d21" stop-opacity="0.95" />
              </radialGradient>
              <filter id="soft-star">
                <feGaussianBlur stdDeviation="1.4" />
              </filter>
            </defs>
            <rect width="1000" height="620" rx="0" fill="#171d21" />
            <rect width="1000" height="620" rx="0" fill="url(#night-glow)" />
            <g opacity="0.2">
              <path d="M76 522 C248 398 312 154 512 126 C690 102 792 244 928 118" fill="none" stroke="#f6dfb6" stroke-width="1" />
              <path d="M112 152 C272 226 396 462 568 420 C722 382 766 236 894 306" fill="none" stroke="#d59b86" stroke-width="1" />
            </g>
            <g data-star-links></g>
            <g data-star-layer></g>
            <g data-lens-labels>
              {lenses.map((lens) => (
                <text x={lens.x} y={lens.y + 34} text-anchor="middle">{lens.label}</text>
              ))}
            </g>
          </svg>
        </section>

        <aside class="reading-panel">
          <p class="mono-note">Night Reading</p>
          <h2 data-reading-title>The sky is waiting.</h2>
          <p data-reading-copy>Open a source app and collect something locally. The first object becomes the first fixed star.</p>

          <div class="tone-grid" aria-label="Observatory reading metrics">
            <article>
              <span>Strongest Lens</span>
              <strong data-primary-lens>None yet</strong>
            </article>
            <article>
              <span>Active Routes</span>
              <strong data-active-routes>0</strong>
            </article>
            <article>
              <span>Next Signal</span>
              <strong data-next-signal>Mint receipt</strong>
            </article>
          </div>

          <form class="name-plate" data-sky-form>
            <label for="sky-name">Name the night</label>
            <div>
              <input id="sky-name" data-sky-name inputmode="text" maxlength="40" placeholder="Pacific cabinet, first light..." />
              <button type="submit">Save</button>
            </div>
            <p data-save-note>Stored only in this browser.</p>
          </form>

          <div class="button-row">
            <button type="button" data-refresh-sky>Refresh sky</button>
            <a class="app-button" href="/cabinet">Open Cabinet</a>
          </div>
        </aside>
      </div>

      <section class="lens-grid" aria-label="Collection lenses">
        {lenses.map((lens) => (
          <article class="lens-card" data-lens={lens.id} style={`--lens-color:${lens.color}`}>
            <span class="lens-card__dot" aria-hidden="true"></span>
            <div>
              <p class="mono-note">{lens.label}</p>
              <strong data-lens-count={lens.id}>0</strong>
              <span data-lens-preview={lens.id}>{lens.empty}</span>
            </div>
            <a href={lens.href}>{lens.action}</a>
          </article>
        ))}
      </section>
    </section>
  </MicroAppShell>
  <script id="observatory-lenses" type="application/json" is:inline set:html={JSON.stringify(lenses)}></script>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-observatory]');
    const dataEl = document.querySelector('#observatory-lenses');
    if (!root || !dataEl) return;

    const lenses = JSON.parse(dataEl.textContent || '[]');
    const NS = 'http://www.w3.org/2000/svg';
    const nameKey = 'pc:observatory:name';
    const layer = root.querySelector('[data-star-layer]');
    const links = root.querySelector('[data-star-links]');
    const totalEl = root.querySelector('[data-star-total]');
    const titleEl = root.querySelector('[data-reading-title]');
    const copyEl = root.querySelector('[data-reading-copy]');
    const primaryEl = root.querySelector('[data-primary-lens]');
    const routesEl = root.querySelector('[data-active-routes]');
    const nextEl = root.querySelector('[data-next-signal]');
    const nameInput = root.querySelector('[data-sky-name]');
    const nameDisplay = root.querySelector('[data-sky-name-display]');
    const saveNote = root.querySelector('[data-save-note]');

    const readItems = (key) => {
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || '[]');
        if (Array.isArray(parsed)) return parsed;
        if (parsed && typeof parsed === 'object') return Object.values(parsed);
      } catch {}
      return [];
    };

    const labelFor = (item) => {
      if (!item || typeof item !== 'object') return '';
      return item.title || item.name || item.alias || item.country || item.vessel || item.id || '';
    };

    const seedFor = (text) => {
      let seed = 0;
      for (let i = 0; i < text.length; i++) seed = (seed * 31 + text.charCodeAt(i)) >>> 0;
      return seed || 1;
    };

    const rand = (seed) => {
      let next = seed >>> 0;
      return () => {
        next = (next * 1664525 + 1013904223) >>> 0;
        return next / 4294967296;
      };
    };

    const svgEl = (tag, attrs = {}) => {
      const el = document.createElementNS(NS, tag);
      Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
      return el;
    };

    const paintName = () => {
      const saved = localStorage.getItem(nameKey) || '';
      if (nameInput) nameInput.value = saved;
      if (nameDisplay) nameDisplay.textContent = saved || 'Unnamed night';
    };

    const state = () => lenses.map((lens) => {
      const items = readItems(lens.key);
      return { ...lens, items, count: items.length, latest: items[items.length - 1] };
    });

    const readingFor = (total, active, strongest, next) => {
      if (total === 0) {
        return {
          title: 'The sky is waiting.',
          copy: 'Open a source app and collect something locally. The first object becomes the first fixed star.',
        };
      }
      if (total < 4) {
        return {
          title: 'First navigation.',
          copy: `${strongest.label} is carrying the night. Add ${next.label.toLowerCase()} to give the map a second point of view.`,
        };
      }
      if (active < 5) {
        return {
          title: 'A working constellation.',
          copy: `${active} routes are alive. The collection now has shape, not just objects.`,
        };
      }
      return {
        title: 'Named-sky territory.',
        copy: `${total} local stars across ${active} routes. This is enough signal to curate a drop, a post, or a mint-ready story.`,
      };
    };

    const render = () => {
      const rows = state();
      const total = rows.reduce((sum, row) => sum + row.count, 0);
      const activeRows = rows.filter((row) => row.count > 0);
      const strongest = activeRows.slice().sort((a, b) => b.count - a.count)[0] || rows[0];
      const next = rows.find((row) => row.count === 0) || strongest;
      const reading = readingFor(total, activeRows.length, strongest, next);

      if (totalEl) totalEl.textContent = String(total);
      if (titleEl) titleEl.textContent = reading.title;
      if (copyEl) copyEl.textContent = reading.copy;
      if (primaryEl) primaryEl.textContent = activeRows.length ? strongest.label : 'None yet';
      if (routesEl) routesEl.textContent = String(activeRows.length);
      if (nextEl) nextEl.textContent = next.label;

      rows.forEach((row) => {
        const countEl = root.querySelector(`[data-lens-count="${row.id}"]`);
        const previewEl = root.querySelector(`[data-lens-preview="${row.id}"]`);
        const cardEl = root.querySelector(`[data-lens="${row.id}"]`);
        if (countEl) countEl.textContent = String(row.count);
        if (previewEl) previewEl.textContent = row.count > 0 ? (labelFor(row.latest) || `${row.count} saved`) : row.empty;
        if (cardEl) cardEl.classList.toggle('lens-card--active', row.count > 0);
      });

      if (!layer || !links) return;
      layer.replaceChildren();
      links.replaceChildren();

      const activePoints = rows.filter((row) => row.count > 0);
      const linkRows = activePoints.length > 1 ? activePoints : rows.slice(0, 4);
      linkRows.forEach((row, index) => {
        const nextRow = linkRows[index + 1];
        if (!nextRow) return;
        links.appendChild(svgEl('line', {
          x1: row.x,
          y1: row.y,
          x2: nextRow.x,
          y2: nextRow.y,
          stroke: activePoints.length > 1 ? '#f5dfb6' : '#9ba69d',
          'stroke-width': activePoints.length > 1 ? 1.4 : 0.8,
          'stroke-opacity': activePoints.length > 1 ? 0.48 : 0.18,
        }));
      });

      rows.forEach((row) => {
        const group = svgEl('g', { 'data-row': row.id });
        const orbitCount = Math.max(1, Math.min(row.count || 1, 12));
        const random = rand(seedFor(`${row.id}:${row.count}:${labelFor(row.latest)}`));
        for (let i = 0; i < orbitCount; i++) {
          const angle = (Math.PI * 2 * i) / orbitCount + random() * 0.7;
          const radius = 22 + random() * (row.count > 0 ? 58 : 24);
          const x = row.x + Math.cos(angle) * radius;
          const y = row.y + Math.sin(angle) * radius;
          const size = row.count > 0 ? 1.8 + random() * 3.6 : 1.2;
          group.appendChild(svgEl('circle', {
            cx: x.toFixed(2),
            cy: y.toFixed(2),
            r: size.toFixed(2),
            fill: row.count > 0 ? row.color : '#f5eee0',
            opacity: row.count > 0 ? 0.68 + random() * 0.25 : 0.22,
          }));
        }
        group.appendChild(svgEl('circle', {
          cx: row.x,
          cy: row.y,
          r: row.count > 0 ? 7 + Math.min(row.count, 9) : 4,
          fill: row.color,
          opacity: row.count > 0 ? 0.95 : 0.34,
        }));
        group.appendChild(svgEl('circle', {
          cx: row.x,
          cy: row.y,
          r: row.count > 0 ? 18 + Math.min(row.count * 2, 28) : 12,
          fill: row.color,
          opacity: row.count > 0 ? 0.16 : 0.06,
          filter: 'url(#soft-star)',
        }));
        layer.appendChild(group);
      });
    };

    root.querySelector('[data-refresh-sky]')?.addEventListener('click', render);
    root.querySelector('[data-sky-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = nameInput ? nameInput.value.trim().slice(0, 40) : '';
      if (value) localStorage.setItem(nameKey, value);
      else localStorage.removeItem(nameKey);
      paintName();
      if (saveNote) saveNote.textContent = value ? 'Night name saved locally.' : 'Night name cleared.';
    });

    paintName();
    render();
  })();
</script>

<style>
  .observatory {
    --sky-ink: #171d21;
    --sky-paper: #f7f0e3;
  }
  .sky-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.75fr);
    gap: 14px;
    align-items: stretch;
  }
  .sky-panel,
  .reading-panel,
  .lens-card {
    border: 1px solid var(--pc-rule-soft);
    background: #fffdf8;
  }
  .sky-panel {
    min-width: 0;
    overflow: hidden;
  }
  .sky-panel__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(18, 17, 14, 0.12);
  }
  .sky-panel__top h2,
  .reading-panel h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.05;
    font-weight: 500;
  }
  .sky-score {
    min-width: 104px;
    text-align: right;
  }
  .sky-score span,
  .tone-grid span,
  .name-plate label {
    display: block;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .sky-score strong {
    display: block;
    font-size: 38px;
    line-height: 1;
    font-weight: 500;
  }
  .star-map {
    width: 100%;
    min-height: 480px;
    display: block;
  }
  .star-map text {
    font: 10px var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: #f8ecd1;
    opacity: 0.72;
  }
  .reading-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    background:
      linear-gradient(180deg, rgba(195, 155, 57, 0.1), rgba(125, 106, 168, 0.08)),
      #fffdf8;
  }
  .reading-panel > p:not(.mono-note),
  .name-plate p,
  .lens-card span {
    margin: 0;
    color: var(--pc-ink-soft);
    line-height: 1.45;
  }
  .tone-grid {
    display: grid;
    gap: 8px;
  }
  .tone-grid article {
    border-top: 1px solid rgba(18, 17, 14, 0.12);
    padding-top: 10px;
  }
  .tone-grid strong {
    display: block;
    margin-top: 5px;
    font-size: 18px;
    line-height: 1.1;
    font-weight: 500;
  }
  .name-plate {
    display: grid;
    gap: 8px;
    margin-top: auto;
  }
  .name-plate div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .name-plate input,
  .name-plate button,
  .button-row button,
  .button-row a {
    border: 1px solid var(--pc-ink);
    background: #fff;
    color: var(--pc-ink);
    min-height: 42px;
    padding: 9px 11px;
    font: 10px var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .name-plate input {
    width: 100%;
    min-width: 0;
    font: 14px var(--pc-font-sans);
    letter-spacing: 0;
    text-transform: none;
  }
  .name-plate button,
  .button-row button,
  .button-row a {
    cursor: pointer;
  }
  .name-plate button:hover,
  .button-row button:hover,
  .button-row a:hover {
    background: var(--pc-ink);
    color: #fff;
    text-decoration: none;
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lens-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .lens-card {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    padding: 12px;
    position: relative;
  }
  .lens-card__dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--lens-color);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--lens-color) 16%, transparent);
    margin-top: 3px;
  }
  .lens-card strong {
    display: block;
    margin: 6px 0 4px;
    font-size: 26px;
    line-height: 1;
    font-weight: 500;
  }
  .lens-card a {
    grid-column: 2;
    width: fit-content;
    margin-top: 8px;
    color: var(--pc-ink);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lens-card--active {
    border-color: color-mix(in srgb, var(--lens-color) 42%, var(--pc-rule-soft));
    background: color-mix(in srgb, var(--lens-color) 8%, #fffdf8);
  }
  @media (max-width: 900px) {
    .sky-layout,
    .lens-grid {
      grid-template-columns: 1fr;
    }
    .star-map {
      min-height: 390px;
    }
  }
  @media (max-width: 560px) {
    .sky-panel__top {
      align-items: flex-start;
      flex-direction: column;
    }
    .sky-score {
      text-align: left;
    }
    .name-plate div {
      grid-template-columns: 1fr;
    }
  }
</style>
