---
import BlockLayout from '../layouts/BlockLayout.astro';
import AuthMenu from '../components/AuthMenu.astro';
import AiRuntime from '../components/AiRuntime.astro';
const description = 'A local-first PointCast music player with ten skins, a real equalizer, procedural scenes and a review-only AI companion handoff.';
---
<BlockLayout title="Player v1" description={description}>
  <main class="player-host" data-player-host>
    <header class="player-host__header">
      <div>
        <a href="/">← PointCast</a>
        <h1>Your music. Your world.</h1>
        <p>Player v1 · local audio beta · no autoplay or audio uploads</p>
      </div>
      <div class="player-host__actions">
        <button type="button" data-player-open-ai>My AI / review draft</button>
        <a href="/player-v1/app.html" target="_blank" rel="noopener noreferrer">Open player alone ↗</a>
        <a href="/player-v1.json">Machine edition ↗</a>
      </div>
    </header>
    <p class="player-host__notice" data-player-host-notice role="status">The player works without an account. AI requires your existing PointCast sign-in and an online paired companion. A handoff opens a draft; it never auto-runs.</p>
    <iframe data-player-frame src="/player-v1/app.html" title="PointCast Player v1 — local music and skin editions" allow="autoplay" loading="eager"></iframe>
    <dialog data-player-ai-dialog aria-labelledby="player-ai-title">
      <header class="player-host__dialog-header">
        <h2 id="player-ai-title">Review with your AI</h2>
        <button type="button" data-player-close>Back to player</button>
      </header>
      <p data-player-draft-status>No player brief has been shared. Prepare a brief in the player’s AI layer, review its exact contents, then choose Open in my PointCast AI.</p>
      <p>Audio never leaves the player. The companion uses your existing connection; model output is a draft, not a publication or purchase.</p>
      <AuthMenu />
      <AiRuntime compact />
    </dialog>
  </main>
  <script is:inline src="/player-v1/host-bridge.js"></script>
</BlockLayout>
<style>
  .player-host { width: min(1680px, calc(100% - 24px)); margin: 20px auto 90px; }
  .player-host__header, .player-host__actions, .player-host__dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .player-host__header h1 { font-size: clamp(24px, 4vw, 38px); line-height: 1.15; margin: 12px 0; }
  .player-host__header p, .player-host__notice { font-size: 12px; line-height: 1.7; }
  .player-host__notice { padding: 12px 0; max-width: 1000px; }
  .player-host__actions { justify-content: flex-start; font-size: 12px; }
  .player-host button { font: inherit; cursor: pointer; border: 1px solid #7d929a; border-radius: 6px; padding: 10px 14px; color: #eaf1ed; background: #183448; }
  .player-host iframe { display: block; width: 100%; height: 90dvh; min-height: 640px; border: 1px solid #6d8493; border-radius: 8px; background: #08131e; }
  .player-host dialog { width: min(900px, calc(100vw - 28px)); max-height: 90dvh; overflow: auto; border: 1px solid #526a70; border-radius: 12px; padding: 22px; color: #253830; background: #f7f8f1; }
  .player-host dialog::backdrop { background: #07111cd9; }
  .player-host dialog p { font-size: 13px; line-height: 1.7; }
  .player-host__dialog-header { position: sticky; top: -22px; padding: 10px 0; background: #f7f8f1; z-index: 2; }
  .player-host__dialog-header h2 { font-size: 24px; margin: 6px 0; }
  @media(max-width: 680px) { .player-host { width: calc(100% - 16px); margin-top: 12px; } .player-host iframe { min-height: 720px; } .player-host dialog { padding: 16px; } }
</style>
