---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Bell — strike a bell, hear it ring out" description="A bell synthesizer with proper inharmonic partials. Pick a bell — handbell, temple, church, gong — and strike. Five sine partials per strike, each decaying at its own rate, like a real bell shimmers. Five pitches, pentatonic so any combination rings.">
  <main class="cb" id="cb" data-built={built}>
    <header class="cb__hero">
      <p class="cb__kicker">CAST · BELL · synth · inharmonic partials · pentatonic</p>
      <h1 class="cb__title">Bell.</h1>
      <p class="cb__sub">A bell synthesizer. Five sine partials per strike, each decaying at its own rate — the way a real bell shimmers. Pick a type, tap a pitch. Five pitches in pentatonic so any combination rings clean.</p>
    </header>

    <section class="cb__type-row">
      <p class="cb__type-label">BELL</p>
      <div class="cb__type-pills" id="cb-type-pills">
        <button class="cb__pill cb__pill--active" data-type="handbell">handbell</button>
        <button class="cb__pill" data-type="temple">temple</button>
        <button class="cb__pill" data-type="church">church</button>
        <button class="cb__pill" data-type="gong">gong</button>
      </div>
    </section>

    <section class="cb__stage" id="cb-stage">
      <div class="cb__bells" id="cb-bells"></div>
      <p class="cb__stage-hint">Tap a bell. Strike with <kbd>1</kbd>–<kbd>5</kbd>. Bells can ring simultaneously — they don't cut each other off.</p>
    </section>

    <section class="cb__controls">
      <div class="cb__ctl">
        <label class="cb__ctl-label" for="cb-vol">VOLUME</label>
        <input type="range" class="cb__ctl-slider" id="cb-vol" min="0" max="100" value="60"/>
      </div>
      <button class="cb__chord" id="cb-chord" type="button" title="Ring all five at once">
        <span class="cb__chord-icon">◎</span>
        <span class="cb__chord-label">Ring all</span>
      </button>
    </section>

    <section class="cb__about">
      <h2 class="cb__about-h">How a bell makes its sound</h2>
      <p>Hit a bell with a clapper and you don't get one note — you get a stack of partials, and they don't line up the way they would on a piano string. Bells are <em>inharmonic</em>. The classic recipe is roughly:</p>
      <ul>
        <li><strong>Hum tone</strong> — the deepest partial, slowest to die, ratio 1.0</li>
        <li><strong>Prime</strong> — an octave above the hum, ratio 2.0</li>
        <li><strong>Tierce</strong> — a minor third above the prime, ratio 2.4 (this is why bells sound a touch melancholy)</li>
        <li><strong>Quint</strong> — a fifth above the prime, ratio 3.0</li>
        <li><strong>Nominal</strong> — two octaves above the hum, ratio 4.0, where you hear the "name" of the bell</li>
      </ul>
      <p>Each partial gets its own exponential decay — slow for the hum, fast for the nominal. Decay times vary by bell type: a handbell rings out in 2 seconds, a gong takes 18. Five sine oscillators per strike, scheduled at one moment in <code>AudioContext.currentTime</code>, summed into a master gain.</p>
      <p>Other surfaces: <a href="/cast-tone">/cast-tone</a> · <a href="/cast-wheel">/cast-wheel</a> · <a href="/cast-room">/cast-room</a> · <a href="/cast-cradle">/cast-cradle</a>.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cb-ink: #0a0810;
      --cb-walnut: #4a2a1a;
      --cb-flame: #f6c15e;
      --cb-flame-deep: #d68f2c;
      --cb-cream: #f4e7c8;
      --cb-cream-dim: #c8b48a;
      --cb-cream-dimmer: #8b7a5a;
      --cb-bronze: #c08b3a;
      --cb-rose: #e6788c;
      --cb-mint: #9bd7b8;
    }

    body:has(.cb) {
      background:
        radial-gradient(circle at 50% 8%, #2a1410 0%, transparent 50%),
        var(--cb-ink);
      color: var(--cb-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cb { max-width: 880px; margin: 0 auto; padding: 48px 24px 80px; }

    .cb__hero { text-align: center; margin-bottom: 32px; }
    .cb__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--cb-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cb__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 130px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cb-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .cb__sub {
      max-width: 640px;
      margin: 0 auto;
      font-size: 17px;
      line-height: 1.5;
      color: var(--cb-cream-dim);
    }

    /* TYPE */
    .cb__type-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .cb__type-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      color: var(--cb-cream-dimmer);
      margin: 0;
    }
    .cb__type-pills { display: flex; gap: 8px; flex-wrap: wrap; }
    .cb__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 10px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cb-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cb__pill:hover { background: rgba(246,193,94,0.10); }
    .cb__pill--active {
      background: var(--cb-flame);
      color: var(--cb-walnut);
      border-color: var(--cb-flame);
    }

    /* STAGE */
    .cb__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      margin-bottom: 32px;
    }
    .cb__bells {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      width: 100%;
      max-width: 720px;
    }
    @media (max-width: 600px) { .cb__bells { grid-template-columns: repeat(5, 1fr); gap: 6px; } }
    .cb__bell {
      position: relative;
      aspect-ratio: 3 / 4;
      border-radius: 50% 50% 16px 16px / 60% 60% 16px 16px;
      border: 0;
      background: linear-gradient(160deg, var(--cb-bronze) 0%, #8b5e22 70%, #5a3a14 100%);
      box-shadow:
        inset 0 -10px 16px rgba(0,0,0,0.45),
        inset 0 8px 10px rgba(246,193,94,0.18),
        0 8px 30px rgba(0,0,0,0.42);
      cursor: pointer;
      padding: 0;
      transition: transform 100ms ease, box-shadow 150ms ease;
      overflow: visible;
    }
    .cb__bell:hover { transform: translateY(-2px); }
    .cb__bell--struck {
      animation: cbStrike 0.6s ease-out;
    }
    @keyframes cbStrike {
      0% { transform: translateY(0) scale(1); }
      8% { transform: translateY(-2px) scale(1.04); }
      20% { transform: translateY(0) scale(1.02); }
      100% { transform: translateY(0) scale(1); }
    }
    .cb__bell-ring {
      position: absolute;
      inset: -8px;
      border: 2px solid var(--cb-flame);
      border-radius: 50% 50% 18px 18px / 60% 60% 18px 18px;
      opacity: 0;
      pointer-events: none;
    }
    .cb__bell--struck .cb__bell-ring {
      animation: cbRingPulse 1.2s ease-out;
    }
    @keyframes cbRingPulse {
      0% { opacity: 0.8; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.22); }
    }
    .cb__bell-tag {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(22px, 4vw, 32px);
      color: var(--cb-cream);
      text-shadow: 0 2px 6px rgba(0,0,0,0.6);
      letter-spacing: -0.01em;
      pointer-events: none;
    }
    .cb__bell-key {
      position: absolute;
      bottom: 6px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.45);
      pointer-events: none;
    }
    .cb__bell-clapper {
      position: absolute;
      left: 50%;
      bottom: 14%;
      width: 8px;
      height: 12px;
      border-radius: 50%;
      background: rgba(0,0,0,0.6);
      transform: translateX(-50%);
      pointer-events: none;
    }
    .cb__stage-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cb-cream-dim);
      text-align: center;
      margin: 0;
    }
    .cb__stage-hint kbd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 4px;
      border: 1px solid rgba(244,231,200,0.3);
      background: rgba(244,231,200,0.06);
    }

    /* CONTROLS */
    .cb__controls {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 36px;
    }
    .cb__ctl {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 200px;
    }
    .cb__ctl-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--cb-cream-dimmer);
    }
    .cb__ctl-slider { width: 100%; accent-color: var(--cb-flame); }
    .cb__chord {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: rgba(246,193,94,0.08);
      color: var(--cb-cream);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 14px;
      transition: background 100ms ease;
    }
    .cb__chord:hover { background: rgba(246,193,94,0.18); }
    .cb__chord-icon { font-size: 18px; color: var(--cb-flame); }

    /* ABOUT */
    .cb__about {
      max-width: 720px;
      margin: 0 auto;
      padding: 28px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cb__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cb-cream);
      margin: 0 0 12px;
    }
    .cb__about p, .cb__about li {
      font-size: 15px;
      line-height: 1.6;
      color: var(--cb-cream-dim);
    }
    .cb__about p { margin: 0 0 12px; }
    .cb__about ul { margin: 0 0 16px; padding-left: 22px; }
    .cb__about li { margin-bottom: 4px; }
    .cb__about strong { color: var(--cb-cream); }
    .cb__about em { color: var(--cb-flame); font-style: normal; }
    .cb__about code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--cb-flame);
    }
    .cb__about a { color: var(--cb-flame); text-decoration: none; }
    .cb__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type BellType = 'handbell' | 'temple' | 'church' | 'gong';

    // Inharmonic partial ratios for a bell. Decay seconds per partial.
    // Bigger bells = longer decays. We give each type its own curve.
    type BellSpec = {
      name: string;
      label: string;
      partials: { ratio: number; gainMul: number; decaySec: number }[];
      // Master strike volume multiplier (gongs are quieter overall to give headroom)
      masterMul: number;
    };

    const BELL_TYPES: Record<BellType, BellSpec> = {
      handbell: {
        name: 'handbell',
        label: 'Short bright handbell, ~2 sec decay',
        masterMul: 0.32,
        partials: [
          { ratio: 1.00, gainMul: 0.55, decaySec: 2.2 },
          { ratio: 2.00, gainMul: 0.42, decaySec: 1.6 },
          { ratio: 2.40, gainMul: 0.28, decaySec: 1.2 },
          { ratio: 3.00, gainMul: 0.22, decaySec: 0.9 },
          { ratio: 4.00, gainMul: 0.18, decaySec: 0.6 },
        ],
      },
      temple: {
        name: 'temple',
        label: 'Round temple bell, ~6 sec decay',
        masterMul: 0.28,
        partials: [
          { ratio: 1.00, gainMul: 0.62, decaySec: 6.5 },
          { ratio: 2.00, gainMul: 0.40, decaySec: 5.0 },
          { ratio: 2.40, gainMul: 0.32, decaySec: 4.2 },
          { ratio: 3.00, gainMul: 0.24, decaySec: 3.2 },
          { ratio: 4.00, gainMul: 0.18, decaySec: 2.0 },
        ],
      },
      church: {
        name: 'church',
        label: 'Cast iron church bell, ~10 sec decay',
        masterMul: 0.30,
        partials: [
          { ratio: 1.00, gainMul: 0.70, decaySec: 11.0 },
          { ratio: 2.00, gainMul: 0.50, decaySec: 8.5 },
          { ratio: 2.40, gainMul: 0.35, decaySec: 6.8 },
          { ratio: 3.00, gainMul: 0.28, decaySec: 5.0 },
          { ratio: 4.00, gainMul: 0.22, decaySec: 3.0 },
        ],
      },
      gong: {
        name: 'gong',
        label: 'Deep gong, ~18 sec decay, heavy hum',
        masterMul: 0.26,
        partials: [
          { ratio: 1.00, gainMul: 0.80, decaySec: 18.0 },
          { ratio: 1.62, gainMul: 0.45, decaySec: 13.0 },  // gongs have a non-integer "warble" partial
          { ratio: 2.00, gainMul: 0.55, decaySec: 11.0 },
          { ratio: 2.74, gainMul: 0.30, decaySec: 7.0 },
          { ratio: 4.00, gainMul: 0.22, decaySec: 4.0 },
        ],
      },
    };

    // Pentatonic C: C E G A C
    const PITCHES: { name: string; key: string; hz: number }[] = [
      { name: 'C',  key: '1', hz: 261.63 },
      { name: 'E',  key: '2', hz: 329.63 },
      { name: 'G',  key: '3', hz: 392.00 },
      { name: 'A',  key: '4', hz: 440.00 },
      { name: 'C↑', key: '5', hz: 523.25 },
    ];

    let currentType: BellType = 'handbell';
    let masterVol = 0.6;
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;

    const STORAGE_TYPE = 'pc-cb-type-v1';
    const STORAGE_VOL = 'pc-cb-vol-v1';

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = masterVol;
      masterGain.connect(ctx.destination);
    }

    function strike(pitchHz: number, type: BellType) {
      ensureCtx();
      if (!ctx || !scheduler || !masterGain) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime;
      const spec = BELL_TYPES[type];
      // tiny initial "ping" — bandpassed click at the fundamental for the attack transient
      const attackOsc = ctx.createOscillator();
      const attackG = ctx.createGain();
      attackOsc.type = 'triangle';
      attackOsc.frequency.value = pitchHz * 4;
      attackG.gain.setValueAtTime(0.0001, t);
      attackG.gain.exponentialRampToValueAtTime(0.18 * spec.masterMul, t + 0.002);
      attackG.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      attackOsc.connect(attackG).connect(masterGain);
      scheduler.trackSource(attackOsc);
      attackOsc.start(t);
      attackOsc.stop(t + 0.08);

      // Each inharmonic partial
      for (const p of spec.partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = pitchHz * p.ratio;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gainMul * spec.masterMul, t + 0.008);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decaySec);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decaySec + 0.1);
      }
    }

    function renderBells() {
      const wrap = document.getElementById('cb-bells')!;
      wrap.innerHTML = PITCHES.map((p, i) => `
        <button class="cb__bell" data-i="${i}" aria-label="Strike bell ${p.name}">
          <span class="cb__bell-ring"></span>
          <span class="cb__bell-clapper"></span>
          <span class="cb__bell-tag">${p.name}</span>
          <span class="cb__bell-key">${p.key}</span>
        </button>
      `).join('');
    }

    function strikeAt(i: number) {
      const p = PITCHES[i];
      if (!p) return;
      strike(p.hz, currentType);
      // visual
      const btn = document.querySelector(`.cb__bell[data-i="${i}"]`);
      if (btn) {
        btn.classList.remove('cb__bell--struck');
        // force reflow to restart animation
        (btn as HTMLElement).offsetHeight;
        btn.classList.add('cb__bell--struck');
        window.setTimeout(() => btn.classList.remove('cb__bell--struck'), 1200);
      }
    }

    function init() {
      // restore state
      try {
        const t = localStorage.getItem(STORAGE_TYPE);
        if (t && (t === 'handbell' || t === 'temple' || t === 'church' || t === 'gong')) {
          currentType = t as BellType;
        }
        const v = parseInt(localStorage.getItem(STORAGE_VOL) || '');
        if (!Number.isNaN(v) && v >= 0 && v <= 100) masterVol = v / 100;
      } catch {}

      renderBells();
      document.querySelectorAll('.cb__type-pills .cb__pill').forEach(el => {
        el.classList.toggle('cb__pill--active', el.getAttribute('data-type') === currentType);
      });
      (document.getElementById('cb-vol') as HTMLInputElement).value = String(Math.round(masterVol * 100));

      // bell tap (event delegation)
      document.getElementById('cb-bells')!.addEventListener('pointerdown', e => {
        const btn = (e.target as HTMLElement).closest('.cb__bell');
        if (!btn) return;
        e.preventDefault();
        const i = parseInt(btn.getAttribute('data-i')!);
        strikeAt(i);
      });

      // keyboard
      window.addEventListener('keydown', e => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        const idx = ['1','2','3','4','5'].indexOf(e.key);
        if (idx >= 0) { e.preventDefault(); strikeAt(idx); }
      });

      // type pills
      document.getElementById('cb-type-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-type]');
        if (!btn) return;
        currentType = btn.getAttribute('data-type') as BellType;
        document.querySelectorAll('.cb__type-pills .cb__pill').forEach(el => {
          el.classList.toggle('cb__pill--active', el === btn);
        });
        try { localStorage.setItem(STORAGE_TYPE, currentType); } catch {}
      });

      // volume
      const vol = document.getElementById('cb-vol') as HTMLInputElement;
      vol.addEventListener('input', () => {
        masterVol = parseInt(vol.value) / 100;
        if (masterGain && ctx) masterGain.gain.setTargetAtTime(masterVol, ctx.currentTime, 0.02);
        try { localStorage.setItem(STORAGE_VOL, vol.value); } catch {}
      });

      // ring all (arpeggiated)
      document.getElementById('cb-chord')!.addEventListener('click', () => {
        ensureCtx();
        PITCHES.forEach((_, i) => {
          window.setTimeout(() => strikeAt(i), i * 70);
        });
      });

      // pause on tab hide (preserve battery)
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden) ctx.suspend().catch(() => {});
        else ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
