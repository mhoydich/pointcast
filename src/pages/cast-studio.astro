  let delaySend: GainNode | null = null; let delayNode: DelayNode | null = null; let delayFb: GainNode | null = null; let delayReturn: GainNode | null = null;
  // Sidechain bus for bass (kick triggers ducking)
  let bassDuckGain: GainNode | null = null;

  let volume = 68;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterBus = ctx.createGain(); masterBus.gain.value = 0.85;

    // Glue compressor (bus comp): slow, gentle, aiming for ~2dB GR
    glueComp = ctx.createDynamicsCompressor();
    glueComp.threshold.value = -16; glueComp.knee.value = 28; glueComp.ratio.value = 2.2;
    glueComp.attack.value = 0.030; glueComp.release.value = 0.250;

    // Soft clip via waveshaper
    softClip = ctx.createWaveShaper();
    const curve = new Float32Array(2048);
    for (let i = 0; i < 2048; i++) {
      const x = (i / 2047) * 2 - 1;
      curve[i] = Math.tanh(x * 1.5) * 0.96; // gentle saturation
    }
    softClip.curve = curve; softClip.oversample = '4x';

    // Limiter (lookahead-ish via fast attack)
    limiter = ctx.createDynamicsCompressor();
    limiter.threshold.value = -1.0; limiter.knee.value = 0.5; limiter.ratio.value = 20;
    limiter.attack.value = 0.001; limiter.release.value = 0.080;

    // Output gain (volume)
    const out = ctx.createGain(); out.gain.value = volume / 100;

    // Analyser for meters
    analyser = ctx.createAnalyser(); analyser.fftSize = 1024; analyser.smoothingTimeConstant = 0.6;

    // Wire master chain: masterBus → glueComp → softClip → limiter → analyser → out → destination
    masterBus.connect(glueComp); glueComp.connect(softClip); softClip.connect(limiter); limiter.connect(analyser); analyser.connect(out); out.connect(ctx.destination);

    // Sends
    reverbSend = ctx.createGain(); reverbSend.gain.value = 0.40;
    reverbConv = ctx.createConvolver(); reverbConv.buffer = makeIR(ctx, 2.4, 2.6);
    reverbReturn = ctx.createGain(); reverbReturn.gain.value = 0.55;
    reverbSend.connect(reverbConv); reverbConv.connect(reverbReturn); reverbReturn.connect(masterBus);

    delaySend = ctx.createGain(); delaySend.gain.value = 0.22;
    delayNode = ctx.createDelay(2.0); delayNode.delayTime.value = 60/120 * 0.75; // dotted-eighth-ish, will retune per song
    delayFb = ctx.createGain(); delayFb.gain.value = 0.36;
    delayReturn = ctx.createGain(); delayReturn.gain.value = 0.48;
    delaySend.connect(delayNode); delayNode.connect(delayFb); delayFb.connect(delayNode); delayNode.connect(delayReturn); delayReturn.connect(masterBus);

    // Bass duck bus (gain dipped on kick)
    bassDuckGain = ctx.createGain(); bassDuckGain.gain.value = 1.0;
    bassDuckGain.connect(masterBus);

    return ctx;
  }

  function makeIR(c: AudioContext, durSec: number, decay: number): AudioBuffer {
    const len = Math.floor(c.sampleRate * durSec);
    const ir = c.createBuffer(2, len, c.sampleRate);
    for (let ch = 0; ch < 2; ch++) {
      const d = ir.getChannelData(ch);
      // Stereo decorrelation: slight delay between channels
      const offset = ch === 0 ? 0 : Math.floor(c.sampleRate * 0.013);
      for (let i = 0; i < len; i++) {
        const t = i / len;
        const env = Math.pow(1 - t, decay);
        d[i] = (i < offset ? 0 : (Math.random()*2-1) * env);
      }
    }
    return ir;
  }

  // ---------- Voice synthesis ----------
  // Each voice routes to: per-voice gain → optional EQ/comp → pan → master + sends
  function makeVoiceChain(c: AudioContext, opts: { pan?: number; reverbAmt?: number; delayAmt?: number; toBassDuck?: boolean; toneCut?: number } = {}) {
    const g = c.createGain(); g.gain.value = 1;
    const pan = c.createStereoPanner(); pan.pan.value = opts.pan ?? 0;
    g.connect(pan);
    if (opts.toneCut) { const f = c.createBiquadFilter(); f.type = 'highshelf'; f.frequency.value = 6000; f.gain.value = -(opts.toneCut); pan.disconnect(); g.connect(f); f.connect(pan); }
    pan.connect(opts.toBassDuck ? bassDuckGain! : masterBus!);
    if (opts.reverbAmt) { const s = c.createGain(); s.gain.value = opts.reverbAmt; pan.connect(s); s.connect(reverbSend!); }
    if (opts.delayAmt) { const s = c.createGain(); s.gain.value = opts.delayAmt; pan.connect(s); s.connect(delaySend!); }
    return g;
  }

  // ---------- Drum voices ----------
  function playKick(when: number, kit: ArtistKitId) {
    const c = ac();
    const o = c.createOscillator(); const g = c.createGain();
    const sub = c.createOscillator(); const subG = c.createGain();
    const isBig = kit === 'block' || kit === 'friday';
    const isSoft = kit === 'fog' || kit === 'aurora' || kit === 'street' || kit === 'night';
    const peakHz = isBig ? 130 : isSoft ? 100 : 115;
    const tailHz = isBig ? 36 : isSoft ? 48 : 42;
    const len = isBig ? 0.42 : isSoft ? 0.30 : 0.36;
    o.frequency.setValueAtTime(peakHz, when);
    o.frequency.exponentialRampToValueAtTime(tailHz, when + len * 0.5);
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(isBig ? 1.20 : 0.85, when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    // Sub layer
    sub.type = 'sine'; sub.frequency.value = 50;
    subG.gain.setValueAtTime(0.001, when);
    subG.gain.exponentialRampToValueAtTime(isBig ? 0.55 : 0.30, when + 0.012);
    subG.gain.exponentialRampToValueAtTime(0.001, when + len * 1.2);
    const chain = makeVoiceChain(c, { pan: 0, reverbAmt: isSoft ? 0.20 : 0.05 });
    o.connect(g); g.connect(chain);
    sub.connect(subG); subG.connect(chain);
    o.start(when); o.stop(when + len + 0.05);
    sub.start(when); sub.stop(when + len * 1.2 + 0.05);

    // Sidechain duck on bass
    if (bassDuckGain) {
      bassDuckGain.gain.cancelScheduledValues(when);
      bassDuckGain.gain.setValueAtTime(1.0, when);
      bassDuckGain.gain.linearRampToValueAtTime(0.40, when + 0.012);
      bassDuckGain.gain.linearRampToValueAtTime(1.0, when + 0.180);
    }
  }

  function playSnare(when: number, kit: ArtistKitId) {
    const c = ac();
    // Brushed for soft kits, snappy for loud
    const isBrush = kit === 'fog' || kit === 'aurora' || kit === 'street' || kit === 'night';
    const len = isBrush ? 0.28 : 0.18;
    const noiseLen = c.sampleRate * len;
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < noiseLen; i++) d[i] = (Math.random()*2-1) * Math.pow(1 - i/noiseLen, isBrush ? 1.0 : 1.6);
    const s = c.createBufferSource(); s.buffer = buf;
    const f = c.createBiquadFilter(); f.type = isBrush ? 'highpass' : 'bandpass'; f.frequency.value = isBrush ? 800 : 2200; f.Q.value = isBrush ? 0.7 : 1.4;
    const g = c.createGain();
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(isBrush ? 0.32 : 0.55, when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    // Tonal layer for snappy
    if (!isBrush) {
      const o = c.createOscillator(); const og = c.createGain();
      o.type = 'triangle'; o.frequency.value = 220;
      og.gain.setValueAtTime(0.001, when); og.gain.exponentialRampToValueAtTime(0.18, when + 0.005); og.gain.exponentialRampToValueAtTime(0.001, when + 0.10);
      const ch2 = makeVoiceChain(c, { pan: -0.05, reverbAmt: 0.20 });
      o.connect(og); og.connect(ch2); o.start(when); o.stop(when + 0.12);
    }
    const chain = makeVoiceChain(c, { pan: -0.10, reverbAmt: isBrush ? 0.40 : 0.30, delayAmt: 0.05 });
    s.connect(f); f.connect(g); g.connect(chain);
    s.start(when); s.stop(when + len + 0.05);
  }

  function playHat(when: number, type: 'closed' | 'open', kit: ArtistKitId) {
    const c = ac();
    const len = type === 'open' ? 0.22 : 0.045;
    const noiseLen = c.sampleRate * len;
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < noiseLen; i++) d[i] = (Math.random()*2-1) * Math.pow(1 - i/noiseLen, 0.6);
    const s = c.createBufferSource(); s.buffer = buf;
    const f = c.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = 7000; f.Q.value = 0.7;
    const g = c.createGain();
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(type === 'open' ? 0.18 : 0.14, when + 0.002);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    const chain = makeVoiceChain(c, { pan: 0.18, reverbAmt: 0.18 });
    s.connect(f); f.connect(g); g.connect(chain);
    s.start(when); s.stop(when + len + 0.05);
  }

  function playClap(when: number) {
    const c = ac();
    // 3 micro-noise bursts to simulate a clap
    [0, 0.012, 0.024].forEach((off, i) => {
      const len = c.sampleRate * 0.06;
      const buf = c.createBuffer(1, len, c.sampleRate);
      const d = buf.getChannelData(0);
      for (let k = 0; k < len; k++) d[k] = (Math.random()*2-1) * Math.pow(1 - k/len, 1.2);
      const s = c.createBufferSource(); s.buffer = buf;
      const f = c.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 1400; f.Q.value = 0.8;
      const g = c.createGain();
      g.gain.setValueAtTime(0.001, when + off);
      g.gain.exponentialRampToValueAtTime(0.30 - i * 0.05, when + off + 0.003);
      g.gain.exponentialRampToValueAtTime(0.001, when + off + 0.06);
      const chain = makeVoiceChain(c, { pan: 0.20, reverbAmt: 0.36, delayAmt: 0.10 });
      s.connect(f); f.connect(g); g.connect(chain);
      s.start(when + off); s.stop(when + off + 0.07);
    });
  }

  function playBell(when: number) {
    const c = ac();
    [880, 1320, 2200].forEach((freq, i) => {
      const o = c.createOscillator(); const g = c.createGain();
      o.frequency.value = freq; o.type = 'sine';
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.18 / (i + 1), when + 0.01);
      g.gain.exponentialRampToValueAtTime(0.001, when + 0.9 - i * 0.15);
      const chain = makeVoiceChain(c, { pan: 0.18, reverbAmt: 0.45, delayAmt: 0.18 });
      o.connect(g); g.connect(chain); o.start(when); o.stop(when + 1.0);
    });
  }

  // ---------- Tonal voices ----------
  function playPad(when: number, freqs: number[], dur: number, kit: ArtistKitId) {
    const c = ac();
    const isWarm = kit === 'fog' || kit === 'aurora' || kit === 'night' || kit === 'street';
    freqs.forEach((freq, i) => {
      // Detuned oscillators per chord tone
      [-7, 0, 7].forEach(cents => {
        const o = c.createOscillator(); const g = c.createGain();
        o.type = isWarm ? 'sine' : 'triangle';
        o.frequency.value = freq * Math.pow(2, cents/1200);
        g.gain.setValueAtTime(0.001, when);
        g.gain.linearRampToValueAtTime(0.045 / freqs.length, when + 0.4);
        g.gain.linearRampToValueAtTime(0.001, when + dur - 0.05);
        // Filter to round it off
        const f = c.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = isWarm ? 1800 : 3200; f.Q.value = 0.7;
        const chain = makeVoiceChain(c, { pan: i % 2 === 0 ? -0.20 : 0.20, reverbAmt: 0.55, delayAmt: 0.12 });
        o.connect(f); f.connect(g); g.connect(chain);
        o.start(when); o.stop(when + dur + 0.05);
      });
    });
  }

  function playLeadNote(when: number, freq: number, dur: number, kit: ArtistKitId, vel = 1) {
    const c = ac();
    const o = c.createOscillator(); const g = c.createGain(); const f = c.createBiquadFilter();
    if (kit === 'brass') {
      // Sawtooth with formant lowpass = horn-ish
      o.type = 'sawtooth';
      f.type = 'lowpass'; f.frequency.value = 2200; f.Q.value = 1.2;
      // Formant boost via secondary peak
      const f2 = c.createBiquadFilter(); f2.type = 'peaking'; f2.frequency.value = 1100; f2.Q.value = 4; f2.gain.value = 6;
      o.connect(f); f.connect(f2); o.frequency.value = freq;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.22 * vel, when + 0.04);
      g.gain.exponentialRampToValueAtTime(0.18 * vel, when + dur * 0.7);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      const chain = makeVoiceChain(c, { pan: 0.05, reverbAmt: 0.25, delayAmt: 0.08 });
      f2.connect(g); g.connect(chain);
    } else if (kit === 'block' || kit === 'friday') {
      // Square + filter envelope = synth lead
      o.type = 'square'; o.frequency.value = freq;
      f.type = 'lowpass'; f.frequency.setValueAtTime(400, when);
      f.frequency.exponentialRampToValueAtTime(2400, when + 0.04);
      f.frequency.exponentialRampToValueAtTime(800, when + dur);
      f.Q.value = 4;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.20 * vel, when + 0.005);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      const chain = makeVoiceChain(c, { pan: 0.10, reverbAmt: 0.18, delayAmt: 0.20 });
      o.connect(f); f.connect(g); g.connect(chain);
    } else {
      // Sine with sweet attack = soft lead (default)
      o.type = 'triangle'; o.frequency.value = freq;
      f.type = 'lowpass'; f.frequency.value = 2400; f.Q.value = 0.6;
      g.gain.setValueAtTime(0.001, when);
      g.gain.exponentialRampToValueAtTime(0.16 * vel, when + 0.02);
      g.gain.exponentialRampToValueAtTime(0.001, when + dur);
      const chain = makeVoiceChain(c, { pan: -0.05, reverbAmt: 0.45, delayAmt: 0.18 });
      o.connect(f); f.connect(g); g.connect(chain);
    }
    o.start(when); o.stop(when + dur + 0.05);
  }

  function playBassNote(when: number, freq: number, dur: number, kit: ArtistKitId) {
    const c = ac();
    const isPunch = kit === 'block' || kit === 'friday';
    const o = c.createOscillator(); const o2 = c.createOscillator();
    const g = c.createGain(); const f = c.createBiquadFilter();
    o.type = isPunch ? 'sawtooth' : 'sine'; o.frequency.value = freq;
    o2.type = 'sine'; o2.frequency.value = freq * 0.5; // sub octave
    f.type = 'lowpass'; f.frequency.value = isPunch ? 800 : 400; f.Q.value = isPunch ? 2.5 : 0.7;
    if (isPunch) { f.frequency.setValueAtTime(220, when); f.frequency.exponentialRampToValueAtTime(900, when + 0.04); f.frequency.exponentialRampToValueAtTime(280, when + dur); }
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(0.32, when + (isPunch ? 0.005 : 0.02));
    g.gain.exponentialRampToValueAtTime(0.001, when + dur);
    const chain = makeVoiceChain(c, { pan: 0, reverbAmt: 0.05, toBassDuck: true });
    o.connect(f); o2.connect(f); f.connect(g); g.connect(chain);
    o.start(when); o.stop(when + dur + 0.05);
    o2.start(when); o2.stop(when + dur + 0.05);
  }

  // ---------- Drum patterns (16 steps per bar) ----------
  // Each pattern returns { kick, snare, hatClosed, hatOpen, clap } as 16-step arrays per bar
  type DrumPattern = { kick: number[]; snare: number[]; hatClosed: number[]; hatOpen: number[]; clap: number[] };

  function drumPatternFor(name: Song['drumPattern'], bar: number, totalBars: number): DrumPattern {
    const last = bar === totalBars - 1; // fill on last bar
    const z = (...steps: number[]) => { const a = Array(16).fill(0); steps.forEach(s => { if (s>=0&&s<16) a[s]=1; }); return a; };
    if (name === 'patient') return {
      kick:      z(0, 8),
      snare:     z(4, 12),
      hatClosed: z(2, 6, 10, 14),
      hatOpen:   last ? z(7, 15) : z(),
      clap:      z(),
    };
    if (name === 'driving') return {
      kick:      z(0, 4, 7, 10, 12, ...(last ? [14, 15] : [])),
      snare:     z(4, 12),
      hatClosed: z(0, 2, 4, 6, 8, 10, 12, 14),
      hatOpen:   z(7, 15),
      clap:      last ? z(14) : z(),
    };
    if (name === 'half') return {
      kick:      z(0),
      snare:     z(8),
      hatClosed: z(0, 4, 8, 12),
      hatOpen:   z(),
      clap:      z(),
    };
    if (name === 'broken') return {
      kick:      z(0, 6, 10),
      snare:     z(4, 12),
      hatClosed: z(2, 4, 6, 10, 12, 14),
      hatOpen:   z(7),
      clap:      z(),
    };
    if (name === 'parade') return {
      kick:      z(0, 4, 8, 12),
      snare:     z(4, 12),
      hatClosed: z(0, 2, 4, 6, 8, 10, 12, 14),
      hatOpen:   z(),
      clap:      z(),
    };
    /* rush */ return {
      kick:      z(0, 3, 4, 8, 10, 12, ...(last ? [13, 14, 15] : [])),
      snare:     z(4, 12),
      hatClosed: z(0, 2, 4, 6, 8, 10, 12, 14),
      hatOpen:   z(2, 6, 10, 14),
      clap:      z(4, 12),
    };
  }

  // ---------- Lead patterns ----------
  // Returns 16-step events: {step, freqIdx, dur} where freqIdx points into chord array (0..3) or -1 = silent
  function leadPatternFor(style: Song['leadStyle'], bar: number, _chord: number[]): { step: number; offset: number; dur: number; vel?: number }[] {
    if (style === 'silent') return [];
    if (style === 'arp') {
      // 8th-note arpeggio cycling chord tones
      const out: { step: number; offset: number; dur: number; vel?: number }[] = [];
      for (let s = 0; s < 16; s += 2) out.push({ step: s, offset: (s/2) % 4, dur: 0.18, vel: 0.9 });
      return out;
    }
    if (style === 'hold') {
      // One held note per bar at chord root
      return [{ step: 0, offset: 0, dur: 1.7, vel: 0.5 }];
    }
    if (style === 'phrase') {
      // 4-note phrase that varies by bar: e.g. 1, 3, 5, 6
      const phrases = [
        [{ step: 0, offset: 2, dur: 0.42 }, { step: 4, offset: 1, dur: 0.42 }, { step: 8, offset: 0, dur: 0.42 }, { step: 12, offset: 2, dur: 0.42 }],
        [{ step: 2, offset: 3, dur: 0.32 }, { step: 6, offset: 2, dur: 0.32 }, { step: 10, offset: 1, dur: 0.32 }, { step: 14, offset: 0, dur: 0.32 }],
        [{ step: 0, offset: 0, dur: 0.62 }, { step: 6, offset: 2, dur: 0.42 }, { step: 12, offset: 3, dur: 0.42 }],
        [{ step: 0, offset: 2, dur: 0.32 }, { step: 2, offset: 1, dur: 0.32 }, { step: 4, offset: 0, dur: 0.32 }, { step: 8, offset: 2, dur: 0.62 }],
      ];
      return phrases[bar % phrases.length];
    }
    /* horn */ {
      // Long notes with vibrato — simulated as sustained notes
      return [{ step: 0, offset: 2, dur: 0.85 }, { step: 8, offset: 0, dur: 0.85 }];
    }
  }

  // ---------- Bass patterns ----------
  function bassPatternFor(style: Song['bassStyle'], _bar: number): { step: number; degree: number; dur: number }[] {
    if (style === 'silent') return [];
    if (style === 'root') {
      return [{ step: 0, degree: 0, dur: 0.6 }, { step: 8, degree: 0, dur: 0.6 }];
    }
    if (style === 'walking') {
      return [{ step: 0, degree: 0, dur: 0.40 }, { step: 4, degree: 2, dur: 0.40 }, { step: 8, degree: 1, dur: 0.40 }, { step: 12, degree: 2, dur: 0.40 }];
    }
    /* octave */ {
      const out: { step: number; degree: number; dur: number }[] = [];
      for (let s = 0; s < 16; s += 4) out.push({ step: s, degree: s % 8 === 0 ? 0 : 7, dur: 0.30 });
      return out;
    }
  }

  function rootBassFreq(rootNote: string): number {
    // Drop root one octave for bass register
    const f = NOTE[rootNote] || 110; return f * 0.5;
  }

  // ---------- Sequencer ----------
  let scheduledTimers: number[] = [];
  let currentSongIdx = 0; let currentSong: Song | null = null;
  let playStartCtxTime = 0; let playing = false; let rafId = 0;
  let onBarChange: ((bar: number, step: number) => void) | null = null;

  function clearScheduled() { scheduledTimers.forEach(t => clearTimeout(t)); scheduledTimers = []; cancelAnimationFrame(rafId); }

  function songDurationSec(s: Song): number {
    const beat = 60 / s.bpm;
    return s.bars * beat * 4;
  }

  function playSong(idx: number) {
    if (idx < 0 || idx >= SONGS.length) return;
    const c = ac(); if (c.state === 'suspended') c.resume();
    clearScheduled();
    currentSongIdx = idx; currentSong = SONGS[idx];
    const s = currentSong;
    const artist = ARTISTS.find(a => a.id === s.artistId)!;
    const beat = 60 / s.bpm; const step = beat / 4;
    const startAt = c.currentTime + 0.04;
    playStartCtxTime = startAt;

    // Retune delay to song tempo (dotted-eighth)
    if (delayNode) delayNode.delayTime.setValueAtTime(beat * 0.75, startAt);

    let curBar = 0;
    s.chords.forEach((ch, ci) => {
      for (let b = 0; b < ch.bars; b++, curBar++) {
        const barStart = startAt + curBar * 4 * beat;
        const chord = chordHz(ch.root, ch.type);
        // Pad: hold for full bar
        playPad(barStart, chord, 4 * beat, artist.kit);
        // Drums: fill on last bar
        const dp = drumPatternFor(s.drumPattern, curBar, s.bars);
        for (let i = 0; i < 16; i++) {
          const t = barStart + i * step;
          if (dp.kick[i])      playKick(t, artist.kit);
          if (dp.snare[i])     playSnare(t, artist.kit);
          if (dp.hatClosed[i]) playHat(t, 'closed', artist.kit);
          if (dp.hatOpen[i])   playHat(t, 'open', artist.kit);
          if (dp.clap[i])      playClap(t);
        }
        // Bell on bar 0 and bar 4 for night/aurora
        if ((artist.kit === 'night' || artist.kit === 'aurora') && (curBar === 0 || curBar === 4)) playBell(barStart);
        // Lead
        const leadEvts = leadPatternFor(s.leadStyle, curBar, chord);
        leadEvts.forEach(ev => {
          const idx = ev.offset % chord.length;
          // Octave-up for lead
          const f = chord[idx] * 2;
          playLeadNote(barStart + ev.step * step, f, ev.dur * beat, artist.kit, ev.vel);
        });
        // Bass
        const bassEvts = bassPatternFor(s.bassStyle, curBar);
        bassEvts.forEach(ev => {
          const f = rootBassFreq(ch.root);
          playBassNote(barStart + ev.step * step, f, ev.dur * beat, artist.kit);
        });
      }
    });

    // Auto-advance at end (with crossfade — start next 1.2s before end)
    const dur = songDurationSec(s);
    const advTimer = window.setTimeout(() => playSong((idx + 1) % SONGS.length), Math.max((dur - 1.2) * 1000, 200));
    scheduledTimers.push(advTimer);

    playing = true;
    setPlayIcon(true);
    setBarMeta(s, artist);
    setAmbient(s.color);
    runProgress();
    render();
  }

  function pause() { if (!ctx) return; ctx.suspend().catch(() => {}); playing = false; setPlayIcon(false); cancelAnimationFrame(rafId); }
  function resume() { if (!ctx) { playSong(currentSongIdx); return; } ctx.resume().catch(() => {}); playing = true; setPlayIcon(true); runProgress(); }
  function stop() { clearScheduled(); playing = false; setPlayIcon(false); }

  function setPlayIcon(on: boolean) {
    const svg = document.getElementById('cs-play-svg');
    if (svg) svg.innerHTML = on ? '<path d="M10 8h4v16h-4z M18 8h4v16h-4z" fill="currentColor"/>' : '<path d="M11 8l13 8-13 8z" fill="currentColor"/>';
  }

  function runProgress() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!ctx || !playing || !currentSong) return;
      const elapsed = ctx.currentTime - playStartCtxTime;
      const dur = songDurationSec(currentSong);
      const pct = Math.max(0, Math.min(1, elapsed / dur));
      const fill = document.getElementById('cs-prog-fill') as HTMLDivElement;
      if (fill) fill.style.width = (pct * 100) + '%';
      const cur = document.getElementById('cs-time-cur') as HTMLSpanElement;
      const tot = document.getElementById('cs-time-tot') as HTMLSpanElement;
      if (cur) cur.textContent = fmtTime(elapsed);
      if (tot) tot.textContent = fmtTime(dur);
      // Bar/step callbacks
      if (onBarChange) {
        const beat = 60 / currentSong.bpm; const step = beat / 4;
        const totalSteps = Math.floor(elapsed / step);
        const bar = Math.min(currentSong.bars - 1, Math.floor(totalSteps / 16));
        const inBarStep = totalSteps % 16;
        onBarChange(bar, inBarStep);
      }
      // Meters
      tickMeter();
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  let meterDataL = new Uint8Array(0); let meterDataR = new Uint8Array(0);
  function tickMeter() {
    if (!analyser) return;
    if (meterDataL.length !== analyser.frequencyBinCount) meterDataL = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteTimeDomainData(meterDataL);
    let peak = 0;
    for (let i = 0; i < meterDataL.length; i++) { const v = Math.abs(meterDataL[i] - 128); if (v > peak) peak = v; }
    const dbLike = Math.min(100, (peak / 128) * 100);
    const ml = document.getElementById('cs-meter-l') as HTMLDivElement;
    const mr = document.getElementById('cs-meter-r') as HTMLDivElement;
    if (ml) ml.style.height = dbLike + '%';
    if (mr) mr.style.height = (dbLike * 0.9) + '%';
  }

  function fmtTime(sec: number) { sec = Math.max(0, sec); const m = Math.floor(sec/60); const s = Math.floor(sec%60); return `${m}:${String(s).padStart(2,'0')}`; }

  function setBarMeta(s: Song, a: Artist) {
    const name = document.getElementById('cs-bar-name') as HTMLParagraphElement;
    const artist = document.getElementById('cs-bar-artist') as HTMLParagraphElement;
    const art = document.getElementById('cs-bar-art') as HTMLImageElement;
    if (name) name.textContent = s.name;
    if (artist) artist.textContent = `${a.name} · ${s.tag} · ${s.bpm} bpm · ${s.bars} bars`;
    if (art) { art.src = `https://noun.pics/${a.nounId}.svg`; art.hidden = false; }
    const frame = document.querySelector<HTMLDivElement>('.cs__bar-art-frame'); if (frame) frame.style.setProperty('--art-c1', s.color);
    // Bar markers in progress bar
    const bars = document.getElementById('cs-prog-bars') as HTMLDivElement;
    if (bars) bars.innerHTML = Array(s.bars).fill('<span></span>').join('');
  }

  function setAmbient(color: string) {
    const c = parseHex(color);
    const el = document.getElementById('cs-ambient'); if (!el) return;
    el.style.setProperty('--ambient-c1', `rgba(${c.r},${c.g},${c.b},0.55)`);
    el.style.setProperty('--ambient-c2', `rgba(${Math.max(c.r-60,0)},${Math.max(c.g-60,0)},${Math.max(c.b-60,0)},0.85)`);
  }
  function parseHex(h: string) { const m = h.replace('#',''); return { r: parseInt(m.slice(0,2),16), g: parseInt(m.slice(2,4),16), b: parseInt(m.slice(4,6),16) }; }

  // ---------- UI render ----------
  let view: 'home' | 'artists' | 'meters' = 'home';
  function escape(s: string) { return s.replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' } as Record<string,string>)[c]!); }

  function render() {
    document.querySelectorAll<HTMLElement>('.cs__nav-btn').forEach(b => b.classList.toggle('cs__nav-btn--active', b.dataset.view === view));
    const v = document.getElementById('cs-view') as HTMLDivElement;
    if (!v) return;
    let html = '';
    if (view === 'home') html = renderHome();
    else if (view === 'artists') html = renderArtists();
    else html = renderMeters();
    v.innerHTML = html;
    bindView(v);

    // Detail bind: chord cells + lyrics + step row update via onBarChange
    if (currentSong) {
      onBarChange = (bar, step) => {
        const cells = v.querySelectorAll<HTMLDivElement>('.cs__chord-cell');
        cells.forEach((c, i) => c.classList.toggle('cs__chord-cell--active', i === bar));
        const steps = v.querySelectorAll<HTMLDivElement>('.cs__step');
        const cols = 16;
        steps.forEach((s, i) => s.classList.toggle('cs__step--cur', (i % cols) === step));
        const lines = v.querySelectorAll<HTMLDivElement>('.cs__lyrics-line');
        const lineIdx = bar % (currentSong!.lyric.length);
        lines.forEach((l, i) => l.classList.toggle('cs__lyrics-line--active', i === lineIdx));
      };
    } else {
      onBarChange = null;
    }
  }

  function renderHome(): string {
    const todayIdx = new Date().getDate() % SONGS.length;
    const today = SONGS[todayIdx];
    const todayArtist = ARTISTS.find(a => a.id === today.artistId)!;
    const intro = `<div class="cs__intro"><h3 class="cs__intro-title">What's different here</h3><p class="cs__intro-body">Each track is <code>8 bars</code>, not a 1-bar loop. Each artist has their own <code>kit</code> — <code>Marine Layer</code> uses brushed snare and held pads; <code>Friday Five</code> hits a punchy kick + sub layer. The <code>master bus</code> goes glue-comp → soft-clip → limiter. Bass is <code>sidechained</code> under the kick. Open the chord strip below to watch the progression move bar by bar.</p></div>`;
    const detail = currentSong ? renderDetail(currentSong) : '';
    return `
      <section class="cs__hero" style="--hero-c: ${today.color}aa;">
        <p class="cs__hero-kicker">Cast · studio · today's session</p>
        <h1 class="cs__hero-title">${escape(today.name)}</h1>
        <p class="cs__hero-sub">By ${escape(todayArtist.name)} · 8 bars · ${today.bpm} bpm. Tap any track below to hear it. Watch the chord strip move.</p>
      </section>
      ${intro}
      ${detail}
      <section class="cs__section">
        <header class="cs__section-head"><h2 class="cs__section-title">Sessions · ${SONGS.length} songs</h2></header>
        <div class="cs__grid">
          ${SONGS.map((s, i) => {
            const a = ARTISTS.find(x => x.id === s.artistId)!;
            const cur = currentSongIdx === i && playing;
            return `<div class="cs__card ${cur ? 'cs__card--playing' : ''}" data-song-idx="${i}" style="--card-c1: ${s.color};">
              <div class="cs__card-art"><img src="https://noun.pics/${a.nounId}.svg" alt="" loading="lazy"/></div>
              <div class="cs__card-meta">
                <p class="cs__card-name">${escape(s.name)}</p>
                <p class="cs__card-artist">${escape(a.name)}</p>
                <div class="cs__card-tags"><span class="cs__card-tag">${s.tag}</span><span class="cs__card-tag">${s.bpm} bpm</span><span class="cs__card-tag">${s.bars} bars</span></div>
              </div>
              <button class="cs__card-play" data-song-idx="${i}" type="button">${cur ? '⏸' : '▶'}</button>
            </div>`;
          }).join('')}
        </div>
      </section>
    `;
  }

  function renderDetail(s: Song): string {
    const a = ARTISTS.find(x => x.id === s.artistId)!;
    const dur = songDurationSec(s);
    const dp = drumPatternFor(s.drumPattern, 0, s.bars);
    const stepRows = [
      { label: 'KICK',  cls: 'kick',  data: dp.kick },
      { label: 'SNARE', cls: 'snare', data: dp.snare },
      { label: 'HAT',   cls: 'hat',   data: dp.hatClosed.map((v, i) => v || dp.hatOpen[i]) },
      { label: 'BASS',  cls: 'bass',  data: bassPatternFor(s.bassStyle, 0).reduce((acc: number[], ev) => { acc[ev.step] = 1; return acc; }, Array(16).fill(0)) },
      { label: 'LEAD',  cls: 'lead',  data: leadPatternFor(s.leadStyle, 0, [220]).reduce((acc: number[], ev) => { acc[ev.step] = 1; return acc; }, Array(16).fill(0)) },
    ];
    return `
      <div class="cs__detail" id="cs-detail">
        <div class="cs__detail-head">
          <div class="cs__detail-art" style="--detail-c: ${s.color};"><img src="https://noun.pics/${a.nounId}.svg" alt=""/></div>
          <div class="cs__detail-meta">
            <p class="cs__detail-kicker">Now playing</p>
            <h2 class="cs__detail-name">${escape(s.name)}</h2>
            <p class="cs__detail-artist">${escape(a.name)} · ${s.tag}</p>
          </div>
        </div>
        <div class="cs__detail-grid">
          <div class="cs__detail-card"><p class="cs__detail-card-label">Tempo</p><p class="cs__detail-card-val">${s.bpm}<span style="opacity:0.55;font-size:14px;font-weight:500;"> bpm</span></p><p class="cs__detail-card-sub">beat = ${(60/s.bpm).toFixed(3)}s · 16th = ${(60/s.bpm/4).toFixed(3)}s</p></div>
          <div class="cs__detail-card"><p class="cs__detail-card-label">Length</p><p class="cs__detail-card-val">${s.bars}<span style="opacity:0.55;font-size:14px;font-weight:500;"> bars</span></p><p class="cs__detail-card-sub">${fmtTime(dur)} total · auto-advance ${(dur-1.2).toFixed(1)}s</p></div>
          <div class="cs__detail-card"><p class="cs__detail-card-label">Kit</p><p class="cs__detail-card-val">${escape(a.kit)}</p><p class="cs__detail-card-sub">${escape(a.bio)}</p></div>
          <div class="cs__detail-card"><p class="cs__detail-card-label">Roles</p><p class="cs__detail-card-val">${s.drumPattern}<span style="opacity:0.55;font-size:14px;font-weight:500;"> · ${s.leadStyle} · ${s.bassStyle}</span></p><p class="cs__detail-card-sub">drum pattern · lead style · bass style</p></div>
        </div>

        <p class="cs__side-label">CHORD PROGRESSION</p>
        <div class="cs__chord-strip">
          ${s.chords.map((c, i) => `<div class="cs__chord-cell"><span class="cs__chord-num">bar ${i+1}</span>${c.root.replace(/[2-5]/,'')}${c.type === 'maj' ? '' : c.type === 'min' ? 'm' : c.type}</div>`).join('')}
        </div>

        <p class="cs__side-label" style="margin-top: 18px;">BAR 1 — STEP MAP</p>
        <div class="cs__step-grid">
          ${stepRows.map(row => `<div class="cs__step-row"><span class="cs__step-label">${row.label}</span>${Array.from({length: 16}, (_, i) => `<div class="cs__step ${row.data[i] ? `cs__step--on cs__step--row-${row.cls}` : ''}"></div>`).join('')}</div>`).join('')}
        </div>

        <div class="cs__lyrics-block">
          <p class="cs__side-label">LYRIC · 1 line per bar</p>
          ${s.lyric.map(l => `<p class="cs__lyrics-line">${escape(l)}</p>`).join('')}
        </div>
      </div>
    `;
  }

  function renderArtists(): string {
    return `<div class="cs__artists">
      <h1 class="cs__hero-title" style="font-size:42px;margin:8px 0 4px 0;">Artists</h1>
      <p class="cs__hero-sub" style="margin-bottom:24px;color:var(--cs-text-mute);">Eight Nouns · eight kits. Each one synthesizes differently from the same patterns.</p>
      <div class="cs__artists-grid">
        ${ARTISTS.map(a => {
          const tracks = SONGS.filter(s => s.artistId === a.id);
          return `<div class="cs__artist" style="--art-c: ${a.color};">
            <div class="cs__artist-portrait"><img src="https://noun.pics/${a.nounId}.svg" alt=""/></div>
            <p class="cs__artist-name">${escape(a.name)}</p>
            <p class="cs__artist-id">NOUN #${a.nounId} · KIT ${a.kit.toUpperCase()}</p>
            <p class="cs__artist-kit">${escape(a.bio)}</p>
            <p class="cs__artist-tracks">${tracks.length} sessions · ${tracks.map(t => `${t.bpm} bpm`).join(' · ')}</p>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  }

  function renderMeters(): string {
    return `<div class="cs__meters-page">
      <h1 class="cs__hero-title" style="font-size:42px;margin:8px 0 4px 0;">Meters</h1>
      <p class="cs__hero-sub" style="margin-bottom:24px;color:var(--cs-text-mute);">Live signal off the master bus. The bar-meter on the bottom right shows post-limiter peak. Below: a 32-band spectrum from the analyser.</p>
      <div class="cs__meters-grid">
        <div class="cs__meters-card">
          <h3>Master spectrum</h3>
          <p>32 bands taken off the analyser node positioned post-glue, post-clip, post-limiter. Updates ~60Hz.</p>
          <div class="cs__big-meter" id="cs-spectrum">${Array.from({length: 32}, () => '<div class="cs__big-meter-bar" style="height: 2px;"></div>').join('')}</div>
        </div>
        <div class="cs__meters-card">
          <h3>Master chain</h3>
          <p>masterBus (gain 0.85) → glueComp (-16dB · 2.2:1 · 30ms attack · 250ms release) → softClip (tanh × 1.5 · 4× oversample) → limiter (-1dB · 20:1 · 1ms attack) → analyser → output</p>
        </div>
        <div class="cs__meters-card">
          <h3>Sends</h3>
          <p>reverb · 2.4s plate IR (decorrelated stereo) · return 0.55<br/>delay · dotted-eighth at song bpm · feedback 0.36 · return 0.48<br/>bass duck · dipped to 0.40 on each kick (12ms attack · 180ms release)</p>
        </div>
      </div>
    </div>`;
  }

  function bindView(v: HTMLDivElement) {
    v.querySelectorAll<HTMLElement>('[data-song-idx]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(el.dataset.songIdx);
        if (currentSongIdx === idx && playing) { pause(); return; }
        if (currentSongIdx === idx && !playing && ctx) { resume(); return; }
        playSong(idx);
      });
    });
  }

  function bindGlobal() {
    document.querySelectorAll<HTMLButtonElement>('.cs__nav-btn').forEach(b => b.addEventListener('click', () => { view = b.dataset.view as any; render(); if (view === 'meters') startSpectrum(); }));
    document.getElementById('cs-play')!.addEventListener('click', () => { if (!ctx) { playSong(0); return; } if (playing) pause(); else resume(); });
    document.getElementById('cs-prev')!.addEventListener('click', () => { stop(); playSong((currentSongIdx - 1 + SONGS.length) % SONGS.length); });
    document.getElementById('cs-next')!.addEventListener('click', () => { stop(); playSong((currentSongIdx + 1) % SONGS.length); });
    document.getElementById('cs-vol')!.addEventListener('input', (e) => { volume = Number((e.target as HTMLInputElement).value); if (ctx) { /* find output gain via masterBus chain? Simplest: store ref */ }
      // Re-route via a known volume node: easiest to set masterBus.gain
      if (masterBus) masterBus.gain.setTargetAtTime(0.85 * (volume/100), ac().currentTime, 0.05);
    });
    (document.getElementById('cs-vol') as HTMLInputElement).value = String(volume);
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); if (playing) pause(); else if (!ctx) playSong(0); else resume(); }
      if (e.key === 'ArrowRight' && !e.metaKey && !e.ctrlKey) { stop(); playSong((currentSongIdx + 1) % SONGS.length); }
      if (e.key === 'ArrowLeft' && !e.metaKey && !e.ctrlKey) { stop(); playSong((currentSongIdx - 1 + SONGS.length) % SONGS.length); }
    });
  }

  // Spectrum on Meters page
  let spectrumRaf = 0;
  function startSpectrum() {
    cancelAnimationFrame(spectrumRaf);
    const bars = document.querySelectorAll<HTMLDivElement>('#cs-spectrum .cs__big-meter-bar'); if (!bars.length || !analyser) return;
    const data = new Uint8Array(analyser.frequencyBinCount);
    const tick = () => {
      if (!analyser) return;
      analyser.getByteFrequencyData(data);
      const slice = Math.floor(data.length / bars.length);
      bars.forEach((bar, i) => {
        let sum = 0; for (let k = 0; k < slice; k++) sum += data[i * slice + k];
        const avg = sum / slice;
        bar.style.height = ((avg / 255) * 100) + '%';
      });
      spectrumRaf = requestAnimationFrame(tick);
    };
    tick();
  }

  document.addEventListener('DOMContentLoaded', () => { bindGlobal(); render(); });
</script>
</BlockLayout>