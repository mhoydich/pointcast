---
/**
 * /drum-scorebook — human view of the wing's machine-readable ledger.
 *
 * Reads /scorebook.json on hydrate; renders a long table grouping
 * surfaces by their wing-section. Designed for both human reading
 * and "show this URL to your agent" usage.
 *
 * Sprint 2 of overnight plan (Agent Choir).
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Scorebook · Machine-Readable Ledger · PointCast';
const description =
  'The wing\'s ledger — every surface, group, audio palette, backing endpoint. Read at /scorebook.json.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Scorebook',
  url: 'https://pointcast.xyz/drum-scorebook',
  description,
  applicationCategory: 'CatalogPage',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="ds" id="ds-main">
    <DrumNav current="scorebook" />

    <header class="ds__header">
      <div class="ds__chrome">
        <span>SCOREBOOK</span>
        <span class="ds__chrome-sep">·</span>
        <span><span id="ds-count">—</span> SURFACES</span>
        <span class="ds__chrome-sep">·</span>
        <a class="ds__chrome-link" href="/scorebook.json">/scorebook.json</a>
      </div>
      <h1 class="ds__title">SCOREBOOK</h1>
      <p class="ds__tagline">a ledger of the wing · readable by humans and agents</p>
    </header>

    <section class="ds__legend">
      <p>
        Every surface is grouped by its wing-section. Each row carries a one-line shape, audio palette,
        and persistence backing. The full machine-readable form lives at
        <a href="/scorebook.json"><code>/scorebook.json</code></a> — agents and humans share the same source.
      </p>
    </section>

    <section class="ds__groups" id="ds-groups">
      <div class="ds__loading">— loading the ledger —</div>
    </section>
  </main>
</BlockLayout>

<style is:global>
  body:has(#ds-main) { background: #f4e7c8; }
  .ds {
    --ds-paper: #f4e7c8;
    --ds-paper-deep: #d8c89e;
    --ds-ink: #1a1a1a;
    --ds-rose: #c4351c;
    --ds-rule-muted: rgba(0, 0, 0, 0.18);

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 32px clamp(16px, 2vw, 56px) 48px;
    color: var(--ds-ink);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background: var(--ds-paper);
    min-height: calc(100vh - 80px);
  }
  .ds .drum-nav { opacity: 0.55; }

  .ds__header { text-align: center; margin-bottom: clamp(20px, 3vh, 32px); }
  .ds__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 5px 18px; border: 2px solid var(--ds-ink); border-radius: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ds-ink); background: #ffffff;
  }
  .ds__chrome-sep { color: var(--ds-rose); }
  .ds__chrome-link { color: var(--ds-rose); text-decoration: underline; text-underline-offset: 2px; }
  #ds-count { color: var(--ds-rose); font-weight: 700; }

  .ds__title {
    margin: clamp(12px, 1.6vh, 20px) 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(48px, 8vw, 108px); font-weight: 400; letter-spacing: 0.04em;
    color: var(--ds-ink); line-height: 0.95;
  }
  .ds__tagline {
    margin: 0 auto; max-width: 540px;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(14px, 1.3vw, 18px); color: #5a5a5a;
  }

  .ds__legend {
    max-width: 740px; margin: 0 auto clamp(28px, 4vh, 44px);
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(14px, 1.2vw, 17px); line-height: 1.6;
    color: #3a3a3a;
  }
  .ds__legend code {
    background: rgba(0, 0, 0, 0.06);
    padding: 1px 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 0.92em;
  }

  .ds__groups {
    max-width: 1080px; margin: 0 auto;
    display: flex; flex-direction: column; gap: clamp(24px, 4vh, 40px);
  }
  .ds__loading {
    text-align: center; padding: 40px;
    font-family: 'Lora', Georgia, serif; font-style: italic; color: #5a5a5a;
  }

  .ds__group {
    border-top: 2px solid var(--ds-ink);
    padding-top: 14px;
  }
  .ds__group-header {
    display: flex; align-items: baseline; gap: 10px;
    margin-bottom: 10px;
  }
  .ds__group-title {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(20px, 2.4vw, 30px); font-weight: 400;
    color: var(--ds-ink); letter-spacing: 0.04em;
    text-transform: lowercase;
  }
  .ds__group-count {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px; letter-spacing: 0.20em; color: var(--ds-rose);
    text-transform: uppercase; font-weight: 700;
  }

  .ds__row {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 2fr minmax(80px, auto) minmax(120px, auto);
    gap: 14px;
    align-items: baseline;
    padding: 10px 0;
    border-top: 1px solid var(--ds-rule-muted);
  }
  @media (max-width: 720px) {
    .ds__row { grid-template-columns: 1fr; gap: 4px; }
  }

  .ds__row-slug {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px; letter-spacing: 0.04em;
  }
  .ds__row-slug a {
    color: var(--ds-ink); text-decoration: none;
    border-bottom: 1px dashed var(--ds-rose);
  }
  .ds__row-slug a:hover { color: var(--ds-rose); border-bottom-style: solid; }

  .ds__row-shape {
    font-family: 'Lora', Georgia, serif;
    font-size: 14px; line-height: 1.5; color: #3a3a3a;
  }
  .ds__row-audio, .ds__row-backing {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #6a6a6a;
  }
  .ds__row-backing { color: var(--ds-rose); font-weight: 700; }
</style>

<script>
  const groupsEl = document.getElementById('ds-groups');
  const countEl = document.getElementById('ds-count');

  const GROUP_LABELS = {
    'chamber-bus':  'chamber-bus',
    'bell-wing':    'bell wing',
    'index':        'index',
    'meditative':   'meditative',
    'very-2026':    'very-2026',
    'station':      'station',
    'spotify':      'spotify',
    'pop-art':      'pop-art',
    'gallery':      'gallery',
    'celebration':  'celebration',
    'v2':           'v2 (with ← v1 toggle)',
    'presence-bus': 'presence bus',
  };
  const GROUP_ORDER = [
    'chamber-bus', 'presence-bus', 'bell-wing', 'meditative', 'very-2026',
    'station', 'spotify', 'pop-art', 'gallery', 'celebration', 'v2', 'index',
  ];

  async function load() {
    try {
      const r = await fetch('/scorebook.json', { cache: 'no-store' });
      const j = await r.json();
      if (!j?.ok) throw new Error('bad');
      if (countEl) countEl.textContent = String(j.counts.surfaces);
      const byGroup = {};
      j.surfaces.forEach((s) => { (byGroup[s.group] ??= []).push(s); });
      if (groupsEl) groupsEl.innerHTML = '';
      GROUP_ORDER.forEach((g) => {
        const surfs = byGroup[g];
        if (!surfs?.length) return;
        const sec = document.createElement('section');
        sec.className = 'ds__group';
        sec.innerHTML = `
          <header class="ds__group-header">
            <span class="ds__group-title">${GROUP_LABELS[g] || g}</span>
            <span class="ds__group-count">${surfs.length}</span>
          </header>
        `;
        surfs.forEach((s) => {
          const row = document.createElement('div');
          row.className = 'ds__row';
          row.innerHTML = `
            <div class="ds__row-slug"><a href="/${s.slug}">${s.slug}</a></div>
            <div class="ds__row-shape">${s.shape}</div>
            <div class="ds__row-audio">${s.audio || '—'}</div>
            <div class="ds__row-backing">${s.backing || 'static'}</div>
          `;
          sec.appendChild(row);
        });
        groupsEl?.appendChild(sec);
      });
    } catch (e) {
      if (groupsEl) groupsEl.innerHTML = '<div class="ds__loading">— failed to load — try /scorebook.json</div>';
    }
  }
  load();
</script>
