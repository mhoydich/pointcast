---
/**
 * /keyboard/shelf — every keyboard app on one shelf.
 *
 * The hub for the keyboard family: the ten apps from the 2026-09-26 build
 * (docs/briefs/2026-09-26-keyboard-ten-apps.md), the writing apps, the games
 * and the signal. Live counter + today's key from /api/keyboard/signal.
 */
const title = 'The Keyboard Shelf · PointCast';
const description =
  'Every PointCast keyboard app on one shelf: a nature wing of fireflies, whales, frogs and rain, plus clocks, radios, diaries, letters, loopers, ear training, games for four, and a smash pad for toddlers.';

const sections = [
  {
    name: 'New on the shelf',
    note: 'Ten small instruments, built 2026-09-26.',
    apps: [
      { href: '/keyboard/clock', name: 'Key Clock', line: 'Chimes the time as a melody, tuned to the town’s key of the day.', mark: '◷' },
      { href: '/keyboard/radio', name: 'Town Radio', line: 'KPCK: the notes everyone plays, live, over a soft bed.', mark: '◉' },
      { href: '/keyboard/typist', name: 'Melody Typist', line: 'Typing practice that sounds good when you type well.', mark: '⌨' },
      { href: '/keyboard/name', name: 'Name Song', line: 'Type a name, hear its song, keep the card.', mark: '✎' },
      { href: '/keyboard/loops', name: 'Loop Porch', line: 'Four-track looper on the home row. Share a song as a link.', mark: '∞' },
      { href: '/keyboard/ear', name: 'Ear Trail', line: 'Hear it, play it back. Ten stations along a trail.', mark: '♪' },
      { href: '/keyboard/weather', name: 'Weather Keys', line: 'El Segundo’s weather right now, as music.', mark: '☁' },
      { href: '/keyboard/morse', name: 'Morse Melody', line: 'Send, learn and key Morse that sounds like a tune.', mark: '·–' },
      { href: '/keyboard/kids', name: 'Baby Keys', line: 'A smash pad for toddlers. Nothing can go wrong.', mark: '☺' },
      { href: '/keyboard/poems', name: 'Poem Organ', line: 'Public-domain poems played line by line, plus a haiku bell.', mark: '❦' },
    ],
  },
  {
    name: 'The Nature Wing',
    note: 'Ten instruments from outside, built by Codex (Sol, Terra, Luna), 2026-09-26.',
    apps: [
      { href: '/keyboard/fireflies', name: 'Firefly Choir', line: 'Light fireflies out of step and watch them fall into sync.', mark: '✦' },
      { href: '/keyboard/mycelium', name: 'Mycelium', line: 'One tap travels the fungal network as an echo canon.', mark: '⌇' },
      { href: '/keyboard/whales', name: 'Whale Song', line: 'Sing a gliding call and a far whale sings it back.', mark: '≈' },
      { href: '/keyboard/tidepool', name: 'Tide Pool', line: 'Drop pebbles; where ripples meet, the creatures sing.', mark: '◌' },
      { href: '/keyboard/birds', name: 'Backyard Birds', line: 'Six SoCal birds, and a mockingbird that learns your calls.', mark: '❦' },
      { href: '/keyboard/frogs', name: 'Frog Pond', line: 'Answer the lead frog in rhythm until the pond erupts.', mark: '◍' },
      { href: '/keyboard/meadow', name: 'Meadow', line: 'Every key grows a humming flower; bees replay the meadow.', mark: '✿' },
      { href: '/keyboard/rain', name: 'Rain Garden', line: 'Rain on leaf, fern, tin and pond, then a rainbow chord.', mark: '☂' },
      { href: '/keyboard/rings', name: 'Tree Rings', line: 'Each day’s tune becomes a ring; play the tree outward.', mark: '◎' },
      { href: '/keyboard/chimes', name: 'Wind Chime Porch', line: 'Chimes that swing in El Segundo’s real wind right now.', mark: '⚲' },
    ],
  },
  {
    name: 'Writing',
    note: 'Your words stay in your browser or in the link.',
    apps: [
      { href: '/keyboard/notes', name: 'Notes', line: 'A notebook where typing makes music.', mark: '✳' },
      { href: '/keyboard/diary', name: 'Key Diary', line: 'A diary that plays as you write. Hum the week.', mark: '☾' },
      { href: '/keyboard/letter', name: 'Key Letter', line: 'A note that plays itself when it’s opened.', mark: '✉' },
      { href: '/keyboard/studio', name: 'Sol Studio', line: 'A writing room with shared passages.', mark: '☼' },
      { href: '/keyboard/garden', name: 'Garden', line: 'The Garden V2 notebook.', mark: '❀' },
    ],
  },
  {
    name: 'Play',
    note: 'Games for one to four. Quartet and Rush have online seats.',
    apps: [
      { href: '/keyboard/rooms', name: 'Bloom Rooms', line: 'Play together from anywhere. Talk in music, sing the Chorus.', mark: '✺' },
      { href: '/keyboard/play', name: 'The Instrument', line: 'Keyboard Bloom: record takes, pin them to the wall.', mark: '♫' },
      { href: '/keyboard-quartet', name: 'Keyboard Quartet', line: 'Call and echo for four, on one keyboard or online.', mark: '◇' },
      { href: '/keyboard-rush', name: 'Bloom Rush', line: 'Mash the glowing key. One to four players.', mark: '✺' },
      { href: '/keyboard-garden', name: 'Keyboard Garden', line: 'Whack-a-flower on 40 keys. Daily seed.', mark: '✿' },
    ],
  },
  {
    name: 'The signal',
    note: 'Every note from every app lands on one counter.',
    apps: [
      { href: '/keyboard-signal', name: 'Keyboard Signal', line: 'The town chord, live phrases, sources and the league.', mark: '✳' },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/shelf">
<meta property="og:title" content="The Keyboard Shelf">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 86% 0%,#34413255,transparent 43%),var(--bg);color:var(--ink);min-height:100vh}
a{color:inherit}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:1120px;margin:0 auto;padding:30px 24px 60px}
.intro{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:10px}
.intro p{font-family:Georgia,serif;font-size:20px;line-height:1.5;margin:0;max-width:620px;color:#d5dbc5}
.live{font-size:11px;color:var(--dim);text-align:right;line-height:1.8}
.live b{font-family:Georgia,serif;font-weight:normal;font-size:26px;color:var(--ink);display:block;font-variant-numeric:tabular-nums}
.live em{font-style:normal;color:var(--gold)}
h2{font-family:Georgia,serif;font-weight:normal;font-size:24px;margin:38px 0 2px}
.note{font-size:11px;color:var(--dim);margin:0 0 14px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.app{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:start;text-decoration:none;padding:16px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(155deg,#1d2c20,#111d16);transition:border-color .15s,transform .15s}
.app:hover,.app:focus-visible{border-color:#688777;transform:translateY(-2px)}
.app:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.mark{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:#0d1711;border:1px solid var(--line);color:var(--gold);font-size:19px;font-family:Georgia,serif}
.app strong{display:block;font-family:Georgia,serif;font-weight:normal;font-size:18px;margin-bottom:4px}
.app span.l{font-size:11px;line-height:1.6;color:var(--dim)}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) minmax(0,1.4fr);gap:12px;margin:26px 0 8px}
.stat{border:1px solid var(--line);border-radius:14px;padding:14px 16px;background:#0d1711;min-width:0}
.stat .k{display:block;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.stat b{display:block;font-family:Georgia,serif;font-weight:normal;font-size:28px;margin:6px 0 2px;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stat small{display:block;font-size:10px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stat.spark svg{display:block;width:100%;height:60px;margin-top:8px}
.boards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:10px}
.board{border:1px solid var(--line);border-radius:14px;padding:4px 16px 16px;background:linear-gradient(155deg,#1d2c20,#111d16);min-width:0}
.board h2{margin-top:14px}
.lb{list-style:none;margin:0;padding:0;counter-reset:r}
.lb li{counter-increment:r;display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:8px;align-items:center;padding:7px 0;border-top:1px solid #22322588;font-size:12px}
.lb li:before{content:counter(r);color:var(--dim);font-size:11px;text-align:center}
.lb li:nth-child(1):before{content:'🥇'}.lb li:nth-child(2):before{content:'🥈'}.lb li:nth-child(3):before{content:'🥉'}
.lb li.empty{display:block;color:var(--dim);font-size:11px}.lb li.empty:before{content:none}
.lb a{text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lb a:hover{color:var(--gold)}
.lb .n{color:var(--dim);font-variant-numeric:tabular-nums;font-size:11px}
.lb .bar{grid-column:2/4;height:3px;border-radius:2px;background:#ffffff10;overflow:hidden;margin-top:-2px}.lb .bar i{display:block;height:100%;background:var(--gold)}
.lb.mine li:before{content:counter(r)}
.wk{display:flex;justify-content:space-between;margin-top:10px}
.wk button{font:inherit;font-size:10px;color:var(--dim);background:transparent;border:1px solid var(--line);border-radius:20px;padding:6px 10px;cursor:pointer}
.mine-big{font-size:12px;color:var(--dim);margin:6px 0 8px}.mine-big b{font-family:Georgia,serif;font-weight:normal;font-size:22px;color:var(--ink)}
.meter{height:6px;border-radius:4px;background:#ffffff12;overflow:hidden;margin-bottom:10px}.meter i{display:block;height:100%;width:0;background:var(--gold);transition:width .6s}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:7px;font-size:10px}
.badges .count{color:var(--gold)}.badges .hot{color:#8fdc7a}.badges .tried{color:#9fb5aa}
@media(max-width:980px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.stat.spark{grid-column:1/-1}.boards{grid-template-columns:minmax(0,1fr)}}
footer{max-width:1120px;margin:0 auto;padding:0 24px 40px;font-size:10px;color:var(--dim);line-height:1.8}
footer a{color:var(--gold)}
@media(max-width:560px){header{padding:16px}main{padding:22px 16px 48px}.brand small{margin-left:0}.intro p{font-size:18px}.live{text-align:left}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Keyboard Shelf<small>Every keyboard app on PointCast</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard/notes">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
</header>
<main>
  <div class="intro">
    <p>Small instruments for the keys you already have. Every note you play here joins one town-wide count; words never do.</p>
  </div>
  <section class="stats" aria-label="Keyboard stats">
    <div class="stat"><span class="k">Notes, all time</span><b data-st-total>—</b><small data-st-split>pitched · keystrokes</small></div>
    <div class="stat"><span class="k">Today (UTC)</span><b data-st-today>—</b><small data-st-trend>—</small></div>
    <div class="stat"><span class="k">Key of the day</span><b data-st-key>—</b><small data-st-keynote>from every pitched note today</small></div>
    <div class="stat"><span class="k">Playing now</span><b data-st-now>—</b><small data-st-nowlist>last two minutes</small></div>
    <div class="stat spark"><span class="k">Last 30 days</span><svg viewBox="0 0 300 60" preserveAspectRatio="none" data-st-spark role="img" aria-label="Notes per day, last 30 days"></svg></div>
  </section>

  <section class="boards">
    <div class="board">
      <h2>This week's league</h2>
      <p class="note" data-lg-week>Every app is a team. Mon–Sun UTC, 5,000 notes a day max per app.</p>
      <ol class="lb" data-lg-list><li class="empty">Loading…</li></ol>
      <div class="wk"><button type="button" data-lg-prev aria-label="Previous week">‹ last week</button><button type="button" data-lg-next aria-label="Next week" hidden>next week ›</button></div>
    </div>
    <div class="board">
      <h2>All-time top apps</h2>
      <p class="note">Most-played keyboard apps since the signal opened.</p>
      <ol class="lb" data-top-list><li class="empty">Loading…</li></ol>
    </div>
    <div class="board">
      <h2>Your shelf</h2>
      <p class="note">Only in this browser. Nobody else sees it.</p>
      <p class="mine-big"><b data-mine-tried>0</b> of <span data-mine-of>0</span> apps tried · <b data-mine-notes>0</b> notes played</p>
      <div class="meter"><i data-mine-bar></i></div>
      <ol class="lb mine" data-mine-list></ol>
      <p class="note" data-mine-next></p>
      <p class="note">Places the town is playing from: <span data-places>—</span></p>
    </div>
  </section>

  {sections.map((s) => (
    <section>
      <h2>{s.name}</h2>
      <p class="note">{s.note}</p>
      <div class="grid">
        {s.apps.map((a) => (
          <a class="app" href={a.href} data-app-href={a.href} data-app-name={a.name}>
            <span class="mark" aria-hidden="true">{a.mark}</span>
            <span><strong>{a.name}</strong><span class="l">{a.line}</span><span class="badges"><span class="count" data-count hidden></span><span class="hot" data-hot hidden>● playing now</span><span class="tried" data-tried hidden>✓ tried</span></span></span>
          </a>
        ))}
      </div>
    </section>
  ))}
</main>
<footer>
  Add the keyboard to your own site with <a href="/keyboard-signal">/keyboard.js</a>. Sibling of the <a href="/drum-signal">Drum Signal</a>. <a href="/">PointCast</a> · El Segundo.
</footer>
<script is:inline>
(function () {
  'use strict';
  var API = '/api/keyboard/signal';
  var $ = function (s) { return document.querySelector(s); };
  var fmt = function (n) { return (Number(n) || 0).toLocaleString('en-US'); };
  var cards = Array.prototype.slice.call(document.querySelectorAll('[data-app-href]'));
  // The signal names an app either by its declared data-app ("keyboard-clock")
  // or, for pages that don't declare one, by path ("/keyboard", "/keyboard-rush").
  function keysFor(href) {
    var last = href.split('/').filter(Boolean).pop() || 'keyboard';
    var k = [href, href + '/'];
    k.push(last.indexOf('keyboard') === 0 ? last : 'keyboard-' + last);
    if (href === '/keyboard/diary') k.push('keyboard-key-diary');
    return k;
  }
  var byKey = {};
  var apps = cards.map(function (c) {
    var a = { href: c.dataset.appHref, name: c.dataset.appName, card: c, total: 0, week: 0, live: false };
    keysFor(a.href).forEach(function (k) { byKey[k] = a; });
    return a;
  });
  var unique = [];
  apps.forEach(function (a) { if (!unique.some(function (u) { return u.href === a.href; })) unique.push(a); });
  function appFor(row) { return byKey[row.app] || null; }
  function li(html) { var l = document.createElement('li'); l.innerHTML = html; return l; }
  function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function renderSummary(s) {
    $('[data-st-total]').textContent = fmt(s.globalTotal);
    $('[data-st-split]').textContent = fmt(s.pitched) + ' pitched · ' + fmt(s.unpitched) + ' keystrokes';
    $('[data-st-today]').textContent = fmt(s.today && s.today.total);
    $('[data-st-key]').textContent = s.key && s.key.today ? s.key.today.name : '—';
    $('[data-st-keynote]').textContent = s.key && s.key.today ? 'fit ' + s.key.today.confidence.toFixed(2) + ' from ' + fmt(s.key.today.notes) + ' notes' : 'needs a dozen pitched notes today';

    // Per-day totals → sparkline + trend vs yesterday.
    var byDay = {};
    (s.days || []).forEach(function (d) { byDay[d.day] = (byDay[d.day] || 0) + d.total; });
    var days = [];
    for (var i = 29; i >= 0; i--) days.push(byDay[new Date(Date.now() - i * 86400000).toISOString().slice(0, 10)] || 0);
    var max = Math.max.apply(null, days.concat([1]));
    var pts = days.map(function (v, i) { return (i / 29 * 300).toFixed(1) + ',' + (56 - v / max * 52).toFixed(1); });
    $('[data-st-spark]').innerHTML = '<polyline points="0,56 ' + pts.join(' ') + ' 300,56" fill="#dfc48d22" stroke="none"/><polyline points="' + pts.join(' ') + '" fill="none" stroke="#dfc48d" stroke-width="2" vector-effect="non-scaling-stroke"/>';
    var y = days[28], t = days[29];
    $('[data-st-trend]').textContent = y ? (t >= y ? '▲ ' : '▼ ') + Math.abs(Math.round((t - y) / y * 100)) + '% vs yesterday' : 'first notes of the day';

    // Live + all-time per app.
    unique.forEach(function (a) { a.total = 0; a.live = false; });
    (s.sources || []).forEach(function (row) { var a = appFor(row); if (a) a.total += row.total; });
    var live = (s.live || []).map(function (row) { var a = appFor(row); if (a) a.live = true; return a ? a.name : row.app; });
    $('[data-st-now]').textContent = live.length ? live.length + ' app' + (live.length === 1 ? '' : 's') : 'quiet';
    $('[data-st-nowlist]').textContent = live.length ? live.slice(0, 3).join(' · ') : 'last two minutes';
    cards.forEach(function (c) {
      var a = byKey[c.dataset.appHref];
      var count = c.querySelector('[data-count]');
      count.hidden = !a.total;
      count.textContent = fmt(a.total) + ' notes';
      c.querySelector('[data-hot]').hidden = !a.live;
    });
    var top = unique.filter(function (a) { return a.total > 0; }).sort(function (x, z) { return z.total - x.total; }).slice(0, 10);
    var tmax = top.length ? top[0].total : 1;
    var list = $('[data-top-list]');
    list.innerHTML = '';
    if (!top.length) list.appendChild(li('No notes yet. Pick an app below and be first.')).className = 'empty';
    top.forEach(function (a) {
      list.appendChild(li('<a href="' + esc(a.href) + '">' + esc(a.name) + '</a><span class="n">' + fmt(a.total) + '</span><span class="bar"><i style="width:' + (a.total / tmax * 100).toFixed(1) + '%"></i></span>'));
    });
    var places = (s.places || []).slice(0, 6).map(function (p) { return esc(p.place.replace(/^cc:/, '').toUpperCase()) + ' ' + fmt(p.total); });
    $('[data-places]').innerHTML = places.length ? places.join(' · ') : 'nowhere yet';
  }

  var weekOffset = 0;
  function weekParam() {
    var d = new Date(Date.now() + weekOffset * 7 * 86400000);
    return d.toISOString().slice(0, 10);
  }
  function renderLeague(l) {
    var list = $('[data-lg-list]');
    list.innerHTML = '';
    if (l && l.week) $('[data-lg-week]').textContent = 'Week of ' + l.week.start + ' → ' + l.week.end + '. Every app is a team; 5,000 notes a day max per app.';
    // Fold rows onto shelf apps so one app with two source names is one team.
    var teams = {};
    ((l && l.standings) || []).forEach(function (row) {
      var a = appFor(row);
      var key = a ? a.href : row.kind + '/' + row.app;
      var t = teams[key] || (teams[key] = { name: a ? a.name : row.app, href: a ? a.href : null, kind: row.kind, points: 0 });
      t.points += row.points;
    });
    var rows = Object.keys(teams).map(function (k) { return teams[k]; }).sort(function (x, z) { return z.points - x.points; }).slice(0, 10);
    if (!rows.length) { list.appendChild(li('No teams on the board this week yet.')).className = 'empty'; return; }
    var max = rows[0].points || 1;
    rows.forEach(function (t) {
      var name = t.href ? '<a href="' + esc(t.href) + '">' + esc(t.name) + '</a>' : '<span>' + esc(t.name) + ' <span class="n">(' + esc(t.kind) + ')</span></span>';
      list.appendChild(li(name + '<span class="n">' + fmt(t.points) + '</span><span class="bar"><i style="width:' + (t.points / max * 100).toFixed(1) + '%"></i></span>'));
    });
  }
  function loadLeague() {
    $('[data-lg-next]').hidden = weekOffset >= 0;
    fetch(API + '?league=1&week=' + weekParam(), { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).then(renderLeague).catch(function () { renderLeague(null); });
  }
  $('[data-lg-prev]').onclick = function () { weekOffset--; loadLeague(); };
  $('[data-lg-next]').onclick = function () { weekOffset = Math.min(0, weekOffset + 1); loadLeague(); };

  // Your shelf: read the local tally /keyboard.js keeps on PointCast pages.
  function renderMine() {
    var mine = {};
    try { mine = JSON.parse(localStorage.getItem('pc-keyboard-mine-v1') || '{}') || {}; } catch (e) {}
    var tried = 0, notes = 0, rows = [];
    unique.forEach(function (a) {
      var m = mine[a.href];
      a.card.querySelector('[data-tried]').hidden = !m;
      if (!m) return;
      tried++; notes += m.notes || 0;
      rows.push({ a: a, notes: m.notes || 0 });
    });
    $('[data-mine-tried]').textContent = tried;
    $('[data-mine-of]').textContent = unique.length;
    $('[data-mine-notes]').textContent = fmt(notes);
    $('[data-mine-bar]').style.width = (tried / Math.max(1, unique.length) * 100).toFixed(1) + '%';
    var list = $('[data-mine-list]');
    list.innerHTML = '';
    rows.sort(function (x, z) { return z.notes - x.notes; }).slice(0, 5).forEach(function (r) {
      list.appendChild(li('<a href="' + esc(r.a.href) + '">' + esc(r.a.name) + '</a><span class="n">' + fmt(r.notes) + '</span>'));
    });
    var untried = unique.filter(function (a) { return !mine[a.href]; });
    var next = untried[Math.floor(Math.random() * untried.length)];
    $('[data-mine-next]').innerHTML = !tried ? 'Open any app to start your shelf.' : next ? 'Try next: <a href="' + esc(next.href) + '">' + esc(next.name) + '</a>' : 'You have tried every app on the shelf. ✳';
  }

  function load() {
    fetch(API, { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (s) { if (s) renderSummary(s); }).catch(function () {});
  }
  load(); loadLeague(); renderMine();
  setInterval(function () { if (!document.hidden) load(); }, 20000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) { load(); renderMine(); } });
})();
</script>
</body>
</html>
