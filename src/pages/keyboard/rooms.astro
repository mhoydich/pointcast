    if(/\b(hello|hi|hey|yo)\b/.test(low)) pool=BAND_LINES.hello; else if(ms.length) pool=BAND_LINES.mood.map(l=>l.replace('WORD',ms[0])); else if(/\?\s*$/.test(low)) pool=BAND_LINES.q;
