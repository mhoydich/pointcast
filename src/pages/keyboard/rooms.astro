const VIBES={
  off:{name:'no groove'},
  dusk:{name:'dusk',bpm:84,scale:'minpent',root:2,prog:[0,2,3,1],kick:'x.......x.x.....',snare:'....x.......x...',hat:'x.x.x.x.x.x.x.x.',bass:'x.........x.....',chord:'x.....x.........',chordKind:'keys',swing:0.1},
  glass:{name:'glass',bpm:104,scale:'lydian',root:0,prog:[0,4,5,3],kick:'x.......x.......',rim:'....x.......x..x',shaker:'..x...x...x...x.',bass:'x.......x.......',arp:'x.x.x.x.x.x.x.x.',arpKind:'bell',pad:true,swing:0},
  garden:{name:'garden',bpm:96,scale:'majpent',root:7,prog:[0,3,4,2],kick:'x.....x...x.....',clap:'....x.......x...',shaker:'.xx.x.xx.xx.x.xx',bass:'x.....x.x.......',arp:'x.x.x.x.x.x.x.x.',arpKind:'marimba',swing:0.06},
  arcade:{name:'arcade',bpm:124,scale:'dorian',root:9,prog:[0,3,6,4],kick:'x...x...x...x...',snare:'....x.......x...',hat:'..x...x...x...x.',open:'......x.......x.',bass:'x.x.x.x.x.x.x.x.',arp:'xxxxxxxxxxxxxxxx',arpKind:'pluck',swing:0},
