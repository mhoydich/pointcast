  function retry(){ clearTimeout(timer); const wait=Math.min(6000,400*Math.pow(2,P.tries++)); timer=setTimeout(()=>open('drum'),wait); }
  P.max=()=>P.transport==='drum'?470:118;
  P.fits=d=>{ d.o=pid; return JSON.stringify(d).length<=P.max(); };
  P.send=d=>{ const ws=P.ws; if(!ws||ws.readyState!==1||P.status!=='on') return false; d.o=pid; const s=JSON.stringify(d); if(s.length>P.max()){ P.dropped++; return false; }
    try{ if(P.transport==='drum') ws.send(JSON.stringify({v:1,type:'party',d})); else ws.send(JSON.stringify({type:'chat',msg:s})); }catch(e){ return false; } P.sent++; return true; };
