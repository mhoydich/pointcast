function onKeyDown(e){
  if(!joined) return; if(e.metaKey||e.ctrlKey||e.altKey) return;
  const ae=document.activeElement, tag=ae&&ae.tagName; if(!$('recDlg').hidden) return;
  if(e.code==='Escape'){ if(!$('end').hidden){ $('end').hidden=true; return; } if(ae&&ae.blur) ae.blur(); return; }
  if(R.mode===1){ if(ae===$('say')) return; if(tag==='INPUT') return; if(e.key.length===1){ $('say').focus(); } return; }
  if(tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT') return;
  if(e.repeat) return;
  if(R.mode===2&&runLive()){ if(e.key.length===1&&/[a-z']/i.test(e.key)){ e.preventDefault(); chorusKey(e.key.toLowerCase()); } else if(e.code==='Space'||e.code==='Backspace'){ e.preventDefault(); } return; }
  if(e.code==='Backspace'){ e.preventDefault(); return; }
  if(!KEYINFO.has(e.code)) return; e.preventDefault(); if(tag==='BUTTON') ae.blur(); localKey(e.code,false); noteUser(e.code);
}
