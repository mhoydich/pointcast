/* ---- sizing ---- */
let pr=PR;
function resize(){ const w=innerWidth,h=innerHeight; renderer.setPixelRatio(pr); renderer.setSize(w,h,false); camera.aspect=w/h; camera.fov=w/h<0.9?50:32; camera.updateProjectionMatrix();
  const dw=Math.max(4,Math.floor(w*pr)), dh=Math.max(4,Math.floor(h*pr)); rt.setSize(dw,dh); PPU.uRes.value.set(dw,dh); bgU.uAsp.value=w/h; U.uDot.value=6*pr; PPU.uDotP.value=5*pr; }
addEventListener('resize',resize); resize();
/* ---- letter regions: 48 Fibonacci points; key k owns point k ---- */
const REG=[]; for(let i=0;i<48;i++){ const y=1-(i+0.5)/48*2, r=Math.sqrt(1-y*y), a=i*2.399963; REG.push(new THREE.Vector3(Math.cos(a)*r,y,Math.sin(a)*r)); }
/* ---- state smoothing ---- */
const S={t:0,formFrom:0,formTo:0,formT:1,shFrom:0,shTo:0,shT:1,imp:0,fps:60,frames:0,hits:0};
const cur={}; const lerp=(k,target,rate,dt)=>{ const v=cur[k]==null?target:cur[k]; cur[k]=v+(target-v)*(1-Math.exp(-rate*dt)); return cur[k]; };
let last=performance.now(), fpsAcc=0, fpsN=0, lowT=0;
function frame(now){
  requestAnimationFrame(frame);
  const dt=Math.min(0.1,(now-last)/1000); last=now; S.t+=dt; U.uTime.value=S.t;
  fpsAcc+=dt; fpsN++; if(fpsAcc>=1){ S.fps=Math.round(fpsN/fpsAcc); fpsAcc=0; fpsN=0;
    if(!Q.get('pr')&&S.fps<40&&pr>0.6){ lowT++; if(lowT>=3){ pr=Math.max(0.6,pr*0.8); resize(); lowT=0; } } else lowT=0; }
  const M=BUS.mood;
  /* morphs: a direct A→B blend, restarted from wherever we are */
  const ft=M.form|0; if(ft!==S.formTo){ S.formFrom=S.formT>0.5?S.formTo:S.formFrom; S.formTo=ft; S.formT=0; }
  S.formT=Math.min(1,S.formT+dt/1.7); U.uFA.value=S.formFrom; U.uFB.value=S.formTo; U.uFT.value=S.formT; { const k=S.formT*S.formT*(3-2*S.formT); U.uCrisp.value=(S.formFrom===2?1-k:0)+(S.formTo===2?k:0); }
  const st=M.shade|0; if(st!==S.shTo){ S.shFrom=S.shT>0.5?S.shTo:S.shFrom; S.shTo=st; S.shT=0; }
  S.shT=Math.min(1,S.shT+dt/1.1); U.uSA.value=S.shFrom; U.uSB.value=S.shTo; U.uST.value=S.shT>=1?0:S.shT; if(S.shT>=1){ U.uSA.value=S.shTo; S.shFrom=S.shTo; }
  U.uWild.value=lerp('wild',Math.max(0,0.25+0.75*(M.wild||0)+0.5*(BUS.activity||0)),2,dt);
  U.uFlow.value=lerp('flow',Math.max(0.15,1-0.65*(M.slow||0)+0.4*(M.hot||0)),1.5,dt);
  U.uPetal.value=lerp('petal',Math.min(1.2,(M.petal||0)),3,dt);
  U.uHot.value=lerp('hot',M.hot||0,2,dt);
  U.uWarm.value=lerp('warm',Math.min(1,M.warm||0),2,dt); U.uDark.value=lerp('dark',M.dark||0,2,dt); U.uPink.value=lerp('pink',M.pink||0,2,dt);
  U.uBright.value=lerp('bright',M.bright||0,2,dt); U.uSilver.value=lerp('silver',M.silver||0,2,dt);
  U.uStreak.value=lerp('streak',Math.min(1,(BUS.streak||0)/10),3,dt);
  BUS.beat=(BUS.beat||0)*Math.exp(-dt*7); U.uBeat.value=BUS.beat;
  PU.uRain.value=lerp('rain',Math.min(1,M.rain||0),2,dt); PU.uSnow.value=lerp('snow',Math.min(1,M.snow||0),2,dt); PU.uStars.value=lerp('stars',Math.min(1,M.stars||0),2,dt);
  PPU.uCRT.value=lerp('crt',M.filter===1?1:0,3,dt); PPU.uHalf.value=lerp('half',M.filter===2?1:0,3,dt);
  PPU.uKal.value=lerp('kal',Math.min(1,M.kaleido||0),2.5,dt); PPU.uGlitch.value=lerp('glitch',Math.min(1,M.glitch||0),4,dt);
  PPU.uCA.value=lerp('ca',0.12+Math.min(2,(M.ca||0))+0.6*(M.glitch||0),8,dt); PPU.uDream.value=lerp('dream',M.dream||0,2,dt);
  PPU.uBloom.value=0.85+0.5*(M.bright||0)+0.4*(BUS.activity||0);
  /* colours: the most active players first, padded with the room's resting palette */
  const cols=BUS.cols||[]; const rest=['#3ad6c0','#5a7bff','#ff7aa8','#ffc15e'];
  for(let i=0;i<4;i++){ const c=cols[i]; const tgt=c?V3(c.col):V3(rest[i]); U['uC'+i].value.lerp(tgt,1-Math.exp(-dt*2.5)); const wt=c?0.35+0.65*Math.min(1,c.w):0.3; U.uCW.value.setComponent(i,U.uCW.value.getComponent(i)+(wt-U.uCW.value.getComponent(i))*(1-Math.exp(-dt*2))); }
  /* letter impulses */
  const H=BUS.hits; while(H.length){ const h=H.shift(); const i=S.imp++%NIMP; const d=REG[((h.k%48)+48)%48]; const c=V3(h.col||'#ffffff');
    U.uImp.value[i].set(d.x,d.y,d.z,Math.min(1.6,h.s||0.8)); U.uImpC.value[i].set(c.x,c.y,c.z,S.t); S.hits++; }
  /* motion */
  mesh.rotation.y+=dt*0.14*U.uFlow.value; mesh.rotation.x=Math.sin(S.t*0.21)*0.22+(S.formTo===4?0.1:0); mesh.rotation.z=Math.sin(S.t*0.13)*0.08;
  const sc=1+0.04*U.uBeat.value+0.02*Math.sin(S.t*1.25); mesh.scale.setScalar(sc*(innerWidth/innerHeight<0.9?0.82:1));
  camera.position.x=Math.sin(S.t*0.1)*0.25; camera.position.y=Math.sin(S.t*0.07)*0.15; camera.lookAt(0,0.05,0);
  renderer.setRenderTarget(rt); renderer.render(scene,camera); renderer.setRenderTarget(null); renderer.render(postScene,postCam);
  S.frames++;
  const o=BUS.sculpt; o.ready=true; o.fps=S.fps; o.frames=S.frames; o.form=S.formTo; o.formT=S.formT; o.shade=S.shTo; o.filter=M.filter|0; o.hits=S.hits; o.pr=pr;
  o.rain=PU.uRain.value; o.snow=PU.uSnow.value; o.petal=U.uPetal.value; o.warm=U.uWarm.value; o.glitch=PPU.uGlitch.value; o.kal=PPU.uKal.value; o.crt=PPU.uCRT.value; o.half=PPU.uHalf.value;
  o.c0=[U.uC0.value.x,U.uC0.value.y,U.uC0.value.z].map(x=>+x.toFixed(3));
}
BUS.sculpt.lite=LITE; requestAnimationFrame(frame);
</script>
