/* ================= party transport (v9 party-client.js, extended for Bloom Rooms) =================
   Same two relays, same reconnect/backoff and the v9 30 s welcome guard. Additions, all backwards-compatible:
   - `path` picks the presence-room shard for the fallback (default /brick-choir/party/<code>, rooms use /keyboard/rooms/<code>)
   - onFrame(d, meta) gets meta = {at: server ms, from: drum clientId}; onClock(at) sees every server timestamp
     (welcome, presence, party frames, our own echoes on the presence room) so pages can share one beat clock
   - onPeers(ids) gets the drum room's live clientIds (a closed tab disappears at once, before any timeout);
     onCount(n) gets the presence room's head count (it drops when any socket closes, so pages can take a roll call)
   - P.max() is the frame budget for the live transport (drum 512 B minus the envelope; presence chat 120 chars);
     send() refuses a frame that would not fit instead of truncating it into broken JSON. */
function makeParty({code,pid,path,onFrame,onStatus,onClock,onPeers,onCount}){
  const P={transport:null,ws:null,status:'off',tries:0,closed:false,seen:new Set(),sent:0,recv:0,dropped:0,me:null};
  const room='bc-'+code.toLowerCase(); const proto=location.protocol==='https:'?'wss':'ws';
  const shard=path||('/brick-choir/party/'+code.toLowerCase());
  const drumUrl=`${proto}://${location.host}/api/drum/room?room=${room}&sid=${pid}`;
  const roomUrl=`${proto}://${location.host}/api/room?url=${encodeURIComponent(shard)}&sid=bc-${pid}`;
  const FORCE=(new URLSearchParams(location.search).get('transport')||'').toLowerCase(); // ?transport=room forces the fallback (tests)
  const setStatus=s=>{ if(P.status!==s){ P.status=s; if(onStatus) onStatus(s,P.transport); } };
  const clock=at=>{ if(onClock&&typeof at==='number'&&at>0) onClock(at); };
  let timer=null;
  function open(which){
    if(P.closed) return; if(which==='drum'&&FORCE==='room') which='room'; setStatus('connecting'); let ws; try{ ws=new WebSocket(which==='drum'?drumUrl:roomUrl); }catch(e){ return fail(which); }
    P.ws=ws; let ok=false, guard=setTimeout(()=>{ if(ok) return; if(ws.readyState<=1&&which==='drum'){ guard=setTimeout(()=>{ if(!ok){ ws.onclose=null; try{ ws.close(); }catch(e){} open('room'); } },30000); return; } try{ ws.close(); }catch(e){} },4000);
    ws.onmessage=e=>{ let m; try{ m=JSON.parse(e.data); }catch(err){ return; } if(!m||typeof m!=='object') return;
      if(which==='drum'){
        clock(m.serverAt);
        if(m.type==='welcome'){ if((m.features||[]).includes('bc-party')){ ok=true; clearTimeout(guard); P.me=m.you&&m.you.clientId; ready('drum'); } else { clearTimeout(guard); ws.onclose=null; try{ ws.close(); }catch(err){} open('room'); } return; }
        if(m.type==='presence'&&onPeers&&Array.isArray(m.people)){ onPeers(m.people.map(x=>x.id)); return; }
        if(m.type==='party'&&m.d&&typeof m.d==='object'){ P.recv++; onFrame(m.d,{at:m.serverAt,from:m.from}); } return; }
      // presence room: every broadcast carries the chat ring; what was there when we arrived is history
      if(onCount&&typeof m.humans==='number') onCount(m.humans);
      if(!ok){ ok=true; clearTimeout(guard); (m.chat||[]).forEach(c=>P.seen.add(c.id)); ready('room'); return; }
