  const O=(type,freq)=>{ const o=ctx.createOscillator(); o.type=type; o.frequency.value=freq; nodes.push(o); return o; };
  if(kind==='bell'){ const o=O('sine',f), md=O('sine',f*3.5), mg=ctx.createGain(); mg.gain.setValueAtTime(f*2.2*vel,t); mg.gain.exponentialRampToValueAtTime(f*0.01,t+0.4); md.connect(mg); mg.connect(o.frequency); o.connect(g); pk=0.2; rel=1.1; }
