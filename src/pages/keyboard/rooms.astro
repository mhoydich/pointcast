  const id=(chatSeq++%1296).toString(36)+rnd(1); const parts=[]; let rest=text, size=party&&party.transport==='drum'?200:44;
  while(rest.length){ let n=Math.min(size,rest.length); while(n>4&&party&&!party.fits({t:'c',i:id,p:parts.length,n:99,x:rest.slice(0,n)})) n-=4; parts.push(rest.slice(0,n)); rest=rest.slice(n); }
