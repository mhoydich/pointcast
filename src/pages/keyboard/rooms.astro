function recStart(){ if(!joined) return; auBoot(); rec={start:performance.now(),events:[],settings:{scale:R.scale,root:R.root,voice:'bloom',bpm:clamp(R.bpm,70,150),sync:true},who:new Set()};
  $('recBtn').classList.add('live'); $('recLbl').textContent='Stop'; recTimer=setInterval(()=>{ const s=Math.round((performance.now()-rec.start)/1000); $('recTime').textContent=`${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`; if(performance.now()-rec.start>REC_MAX) recStop(); },250); }
function recStop(){ if(!rec) return; clearInterval(recTimer); $('recTime').textContent=''; $('recBtn').classList.remove('live'); $('recLbl').textContent='Record';
