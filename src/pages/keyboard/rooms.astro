async function saveTake(vis){ if(!recDraft) return; $('rvStatus').textContent='Saving…';
  const names=humans().map(p=>shown(p.name)); const body={title:($('rvTitle').value.trim()||`Bloom Room ${roomCode}`).slice(0,80),song:'',note:`Recorded live in Bloom Rooms with ${names.join(', ')}`.slice(0,140),link:null,name:names.join(' · ').slice(0,40),dur:recDraft.dur,settings:recDraft.settings,events:recDraft.events,visibility:vis};
  try{ const r=await fetch('/api/keyboard',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const j=await r.json(); if(!r.ok) throw new Error(j.error||'failed');
    try{ const mine=JSON.parse(LS.get('kb:mine','[]')); LS.set('kb:mine',JSON.stringify([{...j.summary,secret:j.secret},...mine].slice(0,100))); }catch(e){}
