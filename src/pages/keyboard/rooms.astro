function halo(p,text){ const layer=$('fly'); const old=layer.querySelector(`.halo[data-pid="${CSS.escape(p.pid)}"]`); if(old) old.remove();
  const h=document.createElement('div'); h.className='halo'; h.dataset.pid=p.pid; h.style.setProperty('--c',p.col); const chars=[...text.slice(0,48)]; const n=chars.length; const R0=Math.min(innerWidth*0.38,innerHeight*0.3);
  const rude=BLUR.on?new Set(text.split(/\s+/).filter(isRude)):new Set(); let pos=0; const mask=text.split(/(\s+)/).flatMap(t=>[...t].map(()=>rude.has(t)));
