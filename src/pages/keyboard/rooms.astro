  const per=Math.min(105,beat*1.3/w.w.length); const plan=[]; for(let i=0;i<w.w.length;i++){ const at=Math.max(now,done-(w.w.length-1-i)*per); if(Math.random()<0.06&&i>0) plan.push({at:at-per*0.5,ch:'qxz'[Math.random()*3|0]}); plan.push({at,ch:w.w[i]}); } return plan; }
