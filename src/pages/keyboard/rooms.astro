let lastLyricSig='';
function renderChorus(now){ const r=CH.run; if(!r||r.done) return; const bm=r.beat;
  let L=0; r.W.forEach(w=>{ if(w.j===0&&now>=w.T-2*bm) L=w.L; }); L=Math.min(L,r.song.lines.length-1);
  const cur=r.W[r.me.ci]; const sig=L+'|'+r.me.ci+'|'+r.me.buf+'|'+r.sungBy.size+'|'+(r.dirty?1:0);
  if(sig!==lastLyricSig){ lastLyricSig=sig; r.dirty=false;
    const line=(li,cls)=>`<div class="ln ${cls}">`+r.W.filter(w=>w.L===li).map(w=>{ const by=r.sungBy.get(w.idx)||[]; const mine=by.some(x=>x.pid===me.pid); const c=by.length?by[0].col:'';
      const isCur=cur&&w.idx===cur.idx; const missed=!by.length&&now>w.T+1.5*bm; const txt=isCur&&r.me.buf?`<u>${esc(r.me.buf)}</u>${esc(w.w.slice(r.me.buf.length))}`:esc(w.w);
      return `<span class="w${mine?' mine':''}${by.length?' sung':''}${missed?' miss':''}${isCur?' cur':''}" data-i="${w.idx}" style="${c?'--c:'+c:''}">${txt}<em>${by.map(x=>`<i style="--c:${x.col}"></i>`).join('')}</em></span>`; }).join(' ')+'</div>';
    $('lines').innerHTML=line(L,'now')+(L+1<r.song.lines.length?line(L+1,'next'):'<div class="ln next end">·</div>'); }
  document.querySelectorAll('#lines .ln.now .w').forEach(el=>{ const w=r.W[+el.dataset.i]; el.style.setProperty('--p',clamp((now-(w.T-2*bm))/(2*bm),0,1).toFixed(3)); });
