---
// /keyboard/rooms — Bloom Rooms. Keyboard Bloom for a room of people in different homes: join by link or a 4-letter
// code, every keystroke plays a note in your voice and colour, everything snaps to one shared key and tempo, and the
// words you type are sung. Three modes: Jam (free play over a groove: dusk, glass, garden, arcade), Talk (send a line,
// it flies into the sculpture and is sung back letter by letter; ~20 mood words steer it) and Chorus (a typing game:
// an original lyric scrolls in time, correctly typed words land on the beat as sung syllables, the room scores
// together). One shared three.js sculpture in the middle morphs, re-shades, re-colours and re-filters with the room.
// Transport: the pointcast-drum Durable Object party relay (room bc-kb<CODE>), presence-room chat relay as fallback;
// no server state, ephemeral chat, the host sends late joiners a snapshot. Solo players get the house band.
// Record a jam to the Keyboard Bloom wall (/api/keyboard, same take format as /keyboard/play).
// three.js 0.170 via jsDelivr. Built 2026-09-26 by Claude on a brief from Mike.
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bloom Rooms · Keyboard Bloom · PointCast</title>
<meta name="description" content="Keyboard Bloom for a room of people. Type to each other in music: every key is a note in your colour, lines are sung back, and one shared sculpture blooms with everyone's typing. Jam, Talk, or sing a song together in Chorus.">
<meta property="og:title" content="Bloom Rooms">
<meta property="og:description" content="Type to each other in music. One room, one key, one tempo, one sculpture.">
<meta property="og:url" content="https://pointcast.xyz/keyboard/rooms">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/keyboard/rooms-og.webp">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#06090b">
<link rel="canonical" href="https://pointcast.xyz/keyboard/rooms">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:inline>
  [hidden]{display:none!important;}
  :root{
    --ground:#06090b; --panel:rgba(10,18,17,.72); --panel-2:rgba(16,28,25,.86); --edge:rgba(120,160,148,.18); --edge-2:rgba(160,200,188,.3);
    --ink:#e4eee8; --ink-dim:#8aa59b; --ink-faint:#4d6158; --accent:#e6c98a; --bad:#ff8f8a;
    --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace; --serif:"Instrument Serif",Georgia,"Times New Roman",serif;
    color-scheme:dark;
  }
  html,body{height:100%;}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--mono);font-size:13px;overflow:hidden;-webkit-user-select:none;user-select:none;}
  #gl{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0;}
  button{font-family:var(--mono);font-size:12px;color:var(--ink);background:var(--panel-2);border:1px solid var(--edge-2);border-radius:999px;padding:5px 12px;cursor:pointer;}
  button:hover{border-color:var(--accent);}
  button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
  button[aria-pressed="true"]{background:var(--accent);color:#14110a;border-color:var(--accent);}
  input[type=text]{font-family:var(--mono);font-size:14px;color:var(--ink);background:rgba(4,8,8,.75);border:1px solid var(--edge-2);border-radius:8px;padding:9px 12px;box-sizing:border-box;-webkit-user-select:text;user-select:text;}
  input.need{border-color:var(--bad);}

  /* header */
  header{position:fixed;top:0;left:0;right:0;z-index:4;display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:14px 16px 26px;background:linear-gradient(to bottom,rgba(4,7,8,.86),rgba(4,7,8,0));pointer-events:none;}
  header > *{pointer-events:auto;}
  .brand{font-family:var(--serif);font-size:30px;line-height:1;white-space:nowrap;}
  .brand em{color:var(--accent);}
  .brand a{color:inherit;text-decoration:none;}
  .code{display:flex;align-items:center;gap:10px;}
  .code small{color:var(--ink-dim);font-size:10px;letter-spacing:.14em;text-transform:uppercase;writing-mode:vertical-rl;transform:rotate(180deg);}
  #codeBig{font-family:var(--serif);font-size:46px;line-height:.9;letter-spacing:.1em;color:#fff;text-shadow:0 0 24px rgba(230,201,138,.35);}
  .code .inv{display:flex;flex-direction:column;gap:4px;align-items:flex-start;}
  #invite{color:var(--ink-faint);font-size:10.5px;}
  #players{display:flex;gap:6px;flex-wrap:wrap;align-items:center;flex:1;min-width:200px;}
  .chip{--c:#888;display:flex;align-items:center;gap:7px;padding:4px 6px 4px 9px;border-radius:999px;background:var(--panel);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);transition:box-shadow .2s,transform .12s;}
  .chip .dot{width:10px;height:10px;border-radius:50%;background:var(--c);box-shadow:0 0 10px var(--c);}
  .chip b{font-weight:500;letter-spacing:.04em;}
  .chip small{color:var(--ink-dim);font-size:10px;}
  .chip .mute{padding:1px 8px;font-size:10px;}
  .chip.me{background:color-mix(in oklab,var(--c) 18%,var(--panel));}
  .chip.bot{border-style:dashed;}
  .chip.muted{opacity:.5;}
  .chip.hit{animation:hit .35s ease-out;}
  .chip.typing .dot{animation:blink .5s ease-in-out infinite;}
  @keyframes hit{0%{box-shadow:0 0 0 0 var(--c);transform:scale(1.05);}100%{box-shadow:0 0 0 10px transparent;transform:none;}}
  @keyframes blink{50%{opacity:.3;}}
  .right{display:flex;flex-direction:column;align-items:flex-end;gap:8px;margin-left:auto;}
  #modes{display:flex;gap:4px;padding:3px;border-radius:999px;background:var(--panel);border:1px solid var(--edge);}
  #modes button{border:none;background:none;padding:6px 14px;font-size:12.5px;}
  #modes button[aria-pressed="true"]{background:var(--accent);color:#14110a;}
  .tools{display:flex;gap:6px;align-items:center;}
  #recBtn .dot{width:8px;height:8px;border-radius:50%;background:#e25a55;display:inline-block;margin-right:6px;vertical-align:middle;}
  #recBtn.live{border-color:#e25a55;color:#ffd7d5;}
  #recBtn.live .dot{animation:blink 1s infinite;}
  #recTime{font-variant-numeric:tabular-nums;color:var(--ink-dim);min-width:3ch;}

  /* chat column */
  #chat{position:fixed;right:16px;top:118px;bottom:170px;width:290px;z-index:3;display:flex;flex-direction:column;justify-content:flex-end;pointer-events:none;}
  #msgs{overflow-y:auto;display:flex;flex-direction:column;gap:6px;padding:48px 4px 0 0;pointer-events:auto;-webkit-mask-image:linear-gradient(to bottom,transparent,#000 48px);mask-image:linear-gradient(to bottom,transparent,#000 48px);}
  .msg{--c:#888;background:var(--panel);border-left:3px solid var(--c);border-radius:4px 10px 10px 4px;padding:6px 10px;line-height:1.4;-webkit-user-select:text;user-select:text;animation:msgIn .25s ease-out;}
  .msg b{color:var(--c);font-weight:500;margin-right:8px;font-size:11px;letter-spacing:.06em;}
  .msg.hid{display:none;}
  @keyframes msgIn{from{opacity:0;transform:translateY(6px);}}
  .rude{filter:blur(5px);border-radius:3px;background:rgba(255,255,255,.08);}
  body.noblur .rude{filter:none;background:none;}

  /* readouts */
  #readout{position:fixed;left:16px;bottom:170px;z-index:3;display:flex;flex-direction:column;gap:6px;max-width:300px;pointer-events:none;}
  #formNow{color:var(--ink-dim);font-size:11px;letter-spacing:.04em;}
  #moodNow{font-size:12px;color:var(--ink-dim);min-height:1.2em;}
  #moodNow b{color:var(--ink);font-weight:500;margin-right:4px;}
  #moodNow i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--c);margin-right:6px;box-shadow:0 0 8px var(--c);}
  #moodNow.pop{animation:msgIn .3s ease-out;}
  #net{font-size:10.5px;color:var(--ink-faint);}
  #net[data-s="on"]::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:#5ee6a0;margin-right:6px;vertical-align:middle;}
  #count{font-size:10.5px;color:var(--ink-faint);}

  /* bottom dock: one panel per mode */
  #dock{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);width:min(780px,calc(100% - 32px));z-index:4;display:flex;flex-direction:column;gap:10px;align-items:center;}
  .pane{width:100%;display:none;flex-direction:column;align-items:center;gap:10px;}
  body[data-mode="jam"] #jam, body[data-mode="talk"] #talk, body[data-mode="chorus"] #chorus{display:flex;}
  .hint{font-family:var(--serif);font-size:21px;color:var(--ink);text-align:center;text-shadow:0 2px 12px #000;}
  .sub{color:var(--ink-dim);font-size:11.5px;text-align:center;}
  #vibes{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;}
  #keyNow{color:var(--ink-dim);font-size:11px;}
  .sayRow{display:flex;gap:8px;width:100%;}
  #say{flex:1;font-size:17px;padding:12px 16px;border-radius:999px;background:rgba(4,8,8,.82);}
  #sayGo{padding:0 18px;}
  #hints{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;}
  #hints button{font-size:11px;padding:3px 9px;background:rgba(10,18,17,.6);color:var(--ink-dim);}
  #hints button:hover{color:var(--ink);}

  /* chorus */
  #lobby{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;}
  #songs{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:6px;width:100%;}
  .song{border-radius:10px;text-align:left;padding:8px 11px;display:flex;flex-direction:column;gap:3px;background:var(--panel);}
  .song b{font-family:var(--serif);font-weight:400;font-size:17px;}
  .song small{color:var(--ink-dim);font-size:10px;}
  .song.on{border-color:var(--accent);background:color-mix(in oklab,var(--accent) 16%,var(--panel));}
  #startSong{font-size:14px;padding:8px 22px;background:var(--accent);color:#14110a;border-color:var(--accent);}
  #lobbyWho{color:var(--ink-dim);font-size:11px;}
  #lyric{width:100%;display:flex;flex-direction:column;align-items:center;gap:6px;background:linear-gradient(to top,rgba(4,7,8,.8),rgba(4,7,8,.35));border-radius:16px;padding:12px 14px 10px;box-sizing:border-box;}
  #lyric.shake{animation:shake .18s;}
  @keyframes shake{25%{transform:translateX(-4px);}75%{transform:translateX(4px);}}
  .chTop{display:flex;gap:14px;justify-content:space-between;width:100%;color:var(--ink-dim);font-size:11px;}
  #chSong{font-family:var(--serif);font-size:15px;color:var(--ink);}
  #count4{font-family:var(--serif);font-size:30px;color:var(--accent);min-height:0;line-height:1;}
  #count4:empty{display:none;}
  #lines{display:flex;flex-direction:column;align-items:center;gap:4px;width:100%;}
  .ln{font-family:var(--serif);text-align:center;line-height:1.25;}
  .ln.now{font-size:clamp(26px,4.2vw,42px);}
  .ln.next{font-size:18px;color:var(--ink-faint);}
  .w{--c:var(--ink);--p:0;position:relative;display:inline-block;padding:0 2px 6px;color:var(--ink-dim);transition:color .15s;}
  .ln.now .w::after{content:"";position:absolute;left:2px;right:2px;bottom:2px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--accent) calc(var(--p)*100%),rgba(255,255,255,.12) 0);}
  .w.cur{color:#fff;}
  .w.cur u{text-decoration:none;color:var(--accent);text-shadow:0 0 14px var(--accent);}
  .w.sung{color:var(--c);text-shadow:0 0 16px color-mix(in oklab,var(--c) 70%,transparent);}
  .w.mine{font-style:italic;}
  .w.miss{color:var(--ink-faint);text-decoration:line-through rgba(255,255,255,.2);}
  .w em{position:absolute;left:0;right:0;top:-4px;display:flex;justify-content:center;gap:2px;font-style:normal;}
  .w em i{width:5px;height:5px;border-radius:50%;background:var(--c);box-shadow:0 0 6px var(--c);}
  .chBar{width:100%;height:3px;border-radius:3px;background:rgba(255,255,255,.08);overflow:hidden;}
  #chBar{height:100%;width:0;background:var(--accent);}

  /* the flying line + its halo */
  #fly{position:fixed;inset:0;z-index:2;pointer-events:none;overflow:hidden;}
  .flyer{--c:#fff;position:absolute;font-family:var(--serif);font-size:34px;white-space:nowrap;color:#fff;transform:translate(-50%,-50%);text-shadow:0 0 12px var(--c),0 0 30px var(--c),0 2px 4px #000;}
  .halo{--c:#fff;position:absolute;left:50%;top:45%;width:0;height:0;animation:spin 40s linear infinite;transition:opacity .8s;}
  .halo.out{opacity:0;}
  .halo i{position:absolute;left:0;top:0;margin:-14px 0 0 -8px;font-family:var(--serif);font-style:normal;font-size:30px;color:color-mix(in oklab,var(--c) 75%,#000);text-shadow:0 1px 3px rgba(0,0,0,.8);transition:color .2s,text-shadow .2s,scale .2s;}
  .halo i.lit{color:#fff;scale:1.25;text-shadow:0 0 10px var(--c),0 0 24px var(--c),0 1px 3px #000;}
  @keyframes spin{to{rotate:360deg;}}

  /* overlays */
  .card{background:rgba(8,14,13,.92);border:1px solid var(--edge-2);border-radius:18px;padding:22px 24px;box-shadow:0 30px 80px rgba(0,0,0,.6);box-sizing:border-box;}
  #join{position:fixed;inset:0;z-index:10;display:grid;place-items:center;padding:16px;background:radial-gradient(circle at 50% 40%,rgba(6,9,11,.25),rgba(6,9,11,.85));}
  #join .card{width:min(520px,100%);display:flex;flex-direction:column;gap:12px;}
  #join h1{font-family:var(--serif);font-weight:400;font-size:48px;margin:0;line-height:1;}
  #join h1 em{color:var(--accent);}
  #join p{margin:0;color:var(--ink-dim);line-height:1.5;font-size:12.5px;}
  #join label{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-dim);}
  #jCols{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;}
  #jCols button{border-radius:10px;padding:7px 6px;display:flex;align-items:center;gap:6px;font-size:11px;}
  #jCols button i{width:12px;height:12px;border-radius:50%;background:var(--c);box-shadow:0 0 8px var(--c);flex:none;}
  #jCols button[aria-pressed="true"]{background:color-mix(in oklab,var(--c) 30%,#0b1311);color:var(--ink);border-color:var(--c);}
  .jRow{display:flex;gap:8px;flex-wrap:wrap;}
  #jCode{width:110px;text-transform:uppercase;letter-spacing:.2em;text-align:center;}
  #jGo{flex:1;font-size:14px;background:var(--accent);color:#14110a;border-color:var(--accent);border-radius:8px;}
  #jNew{border-radius:8px;}
  #jHint{font-size:11.5px!important;}
  #end{position:fixed;inset:0;z-index:8;display:grid;place-items:center;padding:16px;background:rgba(4,6,8,.6);}
  #end .card{width:min(520px,100%);text-align:center;}
  #end h2{font-family:var(--serif);font-weight:400;font-size:26px;margin:0;color:var(--ink-dim);}
  #endPct{display:block;font-size:84px;color:#fff;line-height:1;text-shadow:0 0 30px rgba(230,201,138,.5);}
  #endSong{color:var(--ink-dim);font-size:11.5px;margin:6px 0 14px;}
  #end table{width:100%;border-collapse:collapse;font-size:12.5px;margin-bottom:16px;}
  #end th{font-weight:400;color:var(--ink-faint);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:4px;}
  #end td{padding:6px 4px;border-top:1px solid var(--edge);font-variant-numeric:tabular-nums;}
  #end td:first-child{text-align:left;}
  #end td i{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--c);margin-right:8px;box-shadow:0 0 8px var(--c);}
  #end td small{color:var(--ink-faint);font-size:10px;}
  .endBtns{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
  #recDlg{position:fixed;right:16px;bottom:18px;z-index:9;width:min(360px,calc(100% - 32px));display:flex;flex-direction:column;gap:8px;}
  #recDlg .lbl{font-size:10.5px;color:var(--ink-dim);letter-spacing:.1em;text-transform:uppercase;}
  #recDlg .row{display:flex;gap:6px;flex-wrap:wrap;}
  #rvStatus{font-size:11px;color:var(--ink-dim);min-height:1.2em;-webkit-user-select:text;user-select:text;}
  #rvStatus a{color:var(--accent);}
  #toast{position:fixed;left:50%;top:92px;transform:translate(-50%,-8px);z-index:9;background:var(--panel-2);border:1px solid var(--edge-2);border-radius:999px;padding:6px 14px;font-size:12px;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none;}
  #toast.on{opacity:1;transform:translate(-50%,0);}
  #tapPill{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:6;font-size:14px;padding:10px 20px;background:var(--accent);color:#14110a;border-color:var(--accent);}
  #nogl{display:none;position:fixed;left:50%;top:40%;transform:translate(-50%,-50%);color:var(--ink-dim);z-index:1;text-align:center;}
  body.nogl #nogl{display:block;}
  #dbg{position:fixed;left:16px;bottom:4px;font-size:10px;color:var(--ink-faint);z-index:5;}
  body:not(.joined) header .code, body:not(.joined) header .right, body:not(.joined) #players, body:not(.joined) #dock, body:not(.joined) #chat, body:not(.joined) #readout{visibility:hidden;}

  @media (max-width:900px){
    header{gap:10px;padding-bottom:14px;}
    .brand{font-size:24px;} #codeBig{font-size:34px;}
    #chat{top:auto;bottom:196px;left:16px;right:16px;width:auto;height:120px;}
    #readout{display:none;}
    .ln.now{font-size:24px;}
  }
  @media (max-width:560px){ #players small{display:none;} .tools button{padding:4px 9px;} #songs{grid-template-columns:1fr 1fr;} }
  @media (prefers-reduced-motion:reduce){ .halo{animation:none;} .flyer{transition-duration:.01s;} }
</style>
</head>
<body data-mode="jam">
<canvas id="gl" aria-hidden="true"></canvas>
<div id="nogl">The sculpture needs WebGL. The room, the music and the chat still work.</div>
<div id="fly" aria-hidden="true"></div>

<header>
  <div class="brand"><a href="/keyboard/play" title="Keyboard Bloom">Bloom <em>Rooms</em></a></div>
  <div class="code"><small>room</small><b id="codeBig">····</b><div class="inv"><button id="copyBtn" title="Copy the invite link">Copy invite</button><span id="invite"></span></div></div>
  <div id="players" aria-label="Players in the room"></div>
  <div class="right">
  <nav id="modes" aria-label="Room mode"><button data-m="0" aria-pressed="true">Jam</button><button data-m="1">Talk</button><button data-m="2">Chorus</button></nav>
  <div class="tools">
    <button id="recBtn" title="Record the room to the Keyboard Bloom wall"><span class="dot"></span><span id="recLbl">Record</span></button><span id="recTime"></span>
    <button id="blurBtn" aria-pressed="true" title="Blur rude words in chat">Blur on</button>
    <button id="muteBtn" aria-pressed="false" title="Mute all sound">Sound on</button>
  </div>
  </div>
</header>

<aside id="chat" aria-label="Room chat"><div id="msgs" aria-live="polite"></div></aside>

<div id="readout">
  <div id="moodNow"></div>
  <div id="formNow"></div>
  <div id="count"></div>
  <div id="net">connecting</div>
</div>

<div id="dock">
  <section class="pane" id="jam">
    <div class="hint">Type anything. Every key is a note in your colour.</div>
    <div id="vibes" aria-label="Backing groove"></div>
    <div class="sub"><span id="keyNow"></span> · rows climb in pitch · 1–0 drums · space strums the chord</div>
  </section>
  <section class="pane" id="talk">
    <div class="sayRow"><input id="say" type="text" maxlength="80" autocomplete="off" spellcheck="false" placeholder="Say something. Enter sends it, and the room sings it back"><button id="sayGo">Send</button></div>
    <div id="hints" aria-label="Mood words"></div>
  </section>
  <section class="pane" id="chorus">
    <div id="lobby">
      <div class="hint">Chorus: sing a song together by typing it on the beat.</div>
      <div id="songs"></div>
      <button id="startSong">Start the song</button>
      <div id="lobbyWho"></div>
    </div>
    <div id="lyric" hidden>
      <div class="chTop"><span id="chSong"></span><span id="chRoom"></span><span id="chStreak"></span><span id="chMe"></span></div>
      <div id="count4"></div>
      <div id="lines"></div>
      <div class="chBar"><div id="chBar"></div></div>
    </div>
  </section>
</div>

<div id="end" hidden><div class="card">
  <h2>the room sang</h2><b id="endPct">0%</b>
  <div id="endSong"></div>
  <table><thead><tr><th></th><th>wpm</th><th>on the beat</th><th>words sung</th></tr></thead><tbody id="endRows"></tbody></table>
  <div class="endBtns"><button id="endAgain">Sing it again</button><button id="endPick">Pick another song</button><button id="endJam">Back to Jam</button></div>
</div></div>

<div id="recDlg" class="card" hidden>
  <div class="lbl">New take · <span id="rvWho"></span></div>
  <input id="rvTitle" type="text" maxlength="80" autocomplete="off" placeholder="Title">
  <div class="row"><button id="rvPublish" aria-pressed="true">Publish to the wall</button><button id="rvPrivate">Unlisted link</button><button id="rvClose">Close</button></div>
  <div id="rvStatus"></div>
</div>

<div id="join"><div class="card">
  <h1>Bloom <em>Rooms</em></h1>
  <p>Each of you on your own keyboard, in your own home, in one room. Every key plays a note in your colour, all in one key and one tempo. Type to each other and hear it sung. The sculpture in the middle is played by everyone.</p>
  <p id="jHint"></p>
