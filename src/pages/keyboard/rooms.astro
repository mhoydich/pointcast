/* ================= audio graph: voices → bus → glue → limiter; mute; per-bus reverb + tempo delay ================= */
let ctx=null, master, glue, limiter, bus, music, duck, wet, dsend, dly, fbk, AU_muted=false;
const mtof=m=>440*Math.pow(2,(m-69)/12);
function mkIR(sec,dec){ const n=ctx.sampleRate*sec|0,b=ctx.createBuffer(2,n,ctx.sampleRate); for(let c=0;c<2;c++){ const d=b.getChannelData(c); for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,dec); } return b; }
function auBoot(){
  if(ctx){ if(ctx.state==='suspended') ctx.resume().catch(()=>{}); return true; }
  try{ ctx=new (window.AudioContext||window.webkitAudioContext)({latencyHint:'interactive'}); }catch(e){ return false; }
  try{
    glue=ctx.createDynamicsCompressor(); glue.threshold.value=-16; glue.knee.value=14; glue.ratio.value=4; glue.attack.value=0.004; glue.release.value=0.22;
    limiter=ctx.createDynamicsCompressor(); limiter.threshold.value=-3; limiter.knee.value=0; limiter.ratio.value=20; limiter.attack.value=0.001; limiter.release.value=0.12;
    master=ctx.createGain(); master.gain.value=AU_muted?0:0.78; master.connect(glue); glue.connect(limiter); limiter.connect(ctx.destination);
    bus=ctx.createGain(); bus.gain.value=0.9; bus.connect(master);
    duck=ctx.createGain(); duck.connect(master); music=ctx.createGain(); music.gain.value=0.5; music.connect(duck);
    const cv=ctx.createConvolver(); cv.buffer=mkIR(3,3.4); wet=ctx.createGain(); wet.gain.value=0.3; wet.connect(cv); cv.connect(master);
    dly=ctx.createDelay(2); dly.delayTime.value=0.43; fbk=ctx.createGain(); fbk.gain.value=0.32; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=2600;
    dsend=ctx.createGain(); dsend.gain.value=0.16; dsend.connect(dly); dly.connect(lp); lp.connect(fbk); fbk.connect(dly); lp.connect(master);
  }catch(e){ ctx=null; return false; }
  return true;
}
function auMute(m){ AU_muted=!!m; if(master&&ctx) master.gain.setTargetAtTime(AU_muted?0:0.78,ctx.currentTime,0.03); }
function auTempo(bpm){ if(ctx&&dly) dly.delayTime.setTargetAtTime(Math.min(1.9,60/bpm*0.75),ctx.currentTime,0.05); }
function auEcho(x){ if(ctx&&fbk){ fbk.gain.setTargetAtTime(0.32+0.28*x,ctx.currentTime,0.3); dsend.gain.setTargetAtTime(0.16+0.22*x,ctx.currentTime,0.3); } }
