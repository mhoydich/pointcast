---
const title = 'Mycelium · PointCast';
const description =
  'Plant a musical mushroom forest, then tap one and hear an echo canon travel through the glowing mycelium below.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/mycelium">
<meta property="og:title" content="Mycelium">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
html,body{max-width:100%;overflow-x:hidden}
body{margin:0;min-height:100vh;color:var(--ink);background:radial-gradient(ellipse at 12% 0%,#31462d66,transparent 38%),radial-gradient(ellipse at 90% 18%,#1d4a5540,transparent 35%),var(--bg)}
body.paused *{animation-play-state:paused!important}
a{color:var(--gold)}
button,input{font:inherit}
button{min-height:44px;padding:9px 15px;border:1px solid var(--line);border-radius:30px;color:var(--ink);background:#101813cc;cursor:pointer;touch-action:manipulation}
button:hover{background:#1e2b20;border-color:#688777}
button[aria-pressed=true],button.primary{color:var(--bg);background:var(--gold);border-color:var(--gold)}
button.danger:hover{background:#3a2320;border-color:#8a5148}
button:disabled{opacity:.45;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-size:30px;font-weight:normal;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;margin:6px 0 0 44px;color:var(--dim);font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{padding:8px 11px;border-radius:20px;color:var(--dim);text-decoration:none}
nav a[aria-current=page]{color:var(--ink);background:#2c3e2b}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}
main{width:min(1040px,100%);margin:0 auto;padding:22px 20px 60px;display:flex;flex-direction:column;gap:16px}
.hint{margin:0;padding:11px 14px;border:1px solid var(--line);border-radius:12px;color:var(--dim);background:#122018;font-size:11px;line-height:1.75}
.hint b{color:var(--gold);font-weight:normal}
.controls{display:flex;align-items:flex-end;gap:18px;flex-wrap:wrap;padding:14px 16px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#1b2920,#111b15)}
.control{display:flex;flex-direction:column;gap:7px;min-width:0}
.label{color:var(--dim);font-size:9px;letter-spacing:.18em;text-transform:uppercase}
.seg{display:flex;gap:4px;flex-wrap:wrap}
.seg button{min-height:36px;padding:7px 11px;font-size:10px}
.range-row{display:flex;align-items:center;gap:9px}
input[type=range]{width:150px;min-height:36px;accent-color:var(--gold)}
#decayValue{min-width:38px;color:var(--gold);font-family:Georgia,serif;font-size:16px}
.controls .spacer{flex:1}
.forest-shell{position:relative;width:100%;min-height:440px;aspect-ratio:16/9;border:1px solid #39503c;border-radius:20px;overflow:hidden;background:#111a13;box-shadow:0 24px 70px #0007,inset 0 1px #ffffff0b}
#forest{display:block;width:100%;height:100%;min-height:440px;touch-action:manipulation;user-select:none;-webkit-user-select:none}
.forest-top{fill:url(#air)}
.soil{fill:url(#soil)}
.soil-speck{fill:#564832;opacity:.38}
.leaf{stroke:#251d13;stroke-width:1.5}
.root-ghost{fill:none;stroke:#6a7551;stroke-width:2;opacity:.14}
.surface-line{fill:none;stroke:#ad9565;stroke-width:3;opacity:.7}
.thread{fill:none;stroke:#d8e6b5;stroke-linecap:round;stroke-linejoin:round;opacity:.34}
.thread.main{stroke-width:2.6;filter:url(#softGlow)}
.thread.branch{stroke-width:1.15;opacity:.2}
.thread.growing{animation:thread-grow 1.25s ease-out both}
.mushroom{cursor:pointer;transform-box:fill-box;transform-origin:center bottom;filter:drop-shadow(0 4px 5px #0006)}
.mushroom.growing{animation:mushroom-grow .52s cubic-bezier(.2,.9,.35,1.25) both}
.mushroom .cap{stroke:#2b2118;stroke-width:2}
.mushroom .stem{fill:#d7cfad;stroke:#75684b;stroke-width:1.5}
.mushroom .gill{fill:none;stroke:#fff2;stroke-width:1.2}
.mushroom .ring{fill:#e8dfbf;opacity:.72}
.mushroom .key-tag{fill:#101813cc;stroke:#ffffff2b;stroke-width:1}
.mushroom .key-text{fill:#ede9d7;font:700 12px ui-monospace,Menlo,monospace;text-anchor:middle;pointer-events:none}
.mushroom .hit-area{fill:transparent;stroke:none}
.mushroom.singing{filter:drop-shadow(0 0 7px #f2c14e) drop-shadow(0 0 18px #dfc48dcc)}
.mushroom.singing .cap{stroke:#fff3b0;stroke-width:3}
.pulse{fill:#fff8c7;stroke:#f2c14e;stroke-width:2;filter:url(#pulseGlow);pointer-events:none}
.spore{fill:#f2c14e;filter:url(#pulseGlow);pointer-events:none}
.empty-state{position:absolute;inset:0;display:grid;place-content:center;gap:8px;padding:24px;text-align:center;pointer-events:none;background:radial-gradient(circle at center,#22331fd9 0,transparent 52%)}
.empty-state strong{font-family:Georgia,serif;font-size:25px;font-weight:normal;color:var(--fern)}
.empty-state span{max-width:360px;color:#b6c3ad;font-size:11px;line-height:1.7}
.empty-state[hidden]{display:none}
.rainveil{position:absolute;inset:0;pointer-events:none;opacity:0;background:repeating-linear-gradient(102deg,transparent 0 31px,#bde8e533 32px 33px,transparent 34px 57px);transform:translateY(-20%)}
.rainveil.on{opacity:1;animation:rainfall .72s linear infinite}
.readout{position:absolute;left:14px;right:14px;bottom:12px;display:flex;justify-content:space-between;gap:10px;align-items:flex-end;pointer-events:none}
.stat{padding:7px 10px;border:1px solid #52644b77;border-radius:20px;color:#d5dcc9;background:#101813c9;backdrop-filter:blur(5px);font-size:9px;letter-spacing:.08em;text-transform:uppercase}
#notice{max-width:66%;color:#ffe79e;text-align:right;text-transform:none;letter-spacing:0;line-height:1.45}
.understory{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.card{padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(150deg,#19261d,#111a14)}
.card h2{margin:0 0 8px;font-family:Georgia,serif;font-size:18px;font-weight:normal;color:var(--fern)}
.card p{margin:0;color:var(--dim);font-size:11px;line-height:1.75}
.keymap{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}
kbd{display:inline-grid;min-width:30px;min-height:28px;place-items:center;padding:3px 7px;border:1px solid #425a46;border-radius:6px;color:var(--ink);background:#0d1610;box-shadow:0 2px #080d09;font:10px ui-monospace,Menlo,monospace}
.privacy{color:#71866f!important;font-size:10px!important}
@keyframes thread-grow{from{stroke-dashoffset:var(--len)}to{stroke-dashoffset:0}}
@keyframes mushroom-grow{0%{transform:scale(.08,.02)}70%{transform:scale(1.08,.96)}100%{transform:scale(1)}}
@keyframes rainfall{from{transform:translateY(-20%)}to{transform:translateY(14%)}}
@media(max-width:720px){header{padding:15px 18px}.brand small{margin-left:0}.controls{gap:13px}.control{flex:1 1 140px}.controls .spacer{display:none}.understory{grid-template-columns:1fr}}
@media(max-width:480px){main{padding:15px 13px 44px}.forest-shell{min-height:310px;aspect-ratio:1.15}#forest{min-height:310px}.readout{align-items:stretch;flex-direction:column}.stat{align-self:flex-start}#notice{max-width:100%;text-align:left}.seg{display:grid;grid-template-columns:repeat(3,1fr)}.seg button{padding-inline:8px}.controls>button{flex:1 1 46%}input[type=range]{width:min(150px,44vw)}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.thread.growing,.mushroom.growing,.rainveil.on{animation:none!important}.pulse{display:none}.mushroom{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Mycelium<small>A forest-floor echo canon</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar">
    <button type="button" id="sound" aria-pressed="true" aria-label="Turn sound off">♪ Sound on</button>
  </div>
</header>

<main>
  <p class="hint"><b>Tap the forest floor or press any letter</b> to plant a mushroom. Once two are connected, tap a mushroom and its note will travel underground — each neighbor joins the echo canon in turn.</p>

  <section class="controls" aria-label="Forest controls">
    <div class="control">
      <span class="label">Travel tempo</span>
      <div class="seg" id="tempo" role="group" aria-label="Mycelium travel tempo">
        <button type="button" data-tempo="slow">Slow</button>
        <button type="button" data-tempo="medium" aria-pressed="true">Medium</button>
        <button type="button" data-tempo="fast">Fast</button>
      </div>
    </div>
    <label class="control" for="decay">
      <span class="label">Echo decay</span>
      <span class="range-row"><input id="decay" type="range" min="45" max="88" value="70" step="1"><span id="decayValue">70%</span></span>
    </label>
    <span class="spacer"></span>
    <button type="button" class="primary" id="rain">Rain for 10 seconds</button>
    <button type="button" class="danger" id="clear">Clear the forest</button>
  </section>

  <section class="forest-shell" aria-label="Interactive forest cross-section">
    <svg id="forest" viewBox="0 0 960 540" preserveAspectRatio="none" role="application" aria-label="Mycelium forest. Tap open ground to plant; tap a mushroom to start its echo canon.">
      <defs>
        <linearGradient id="air" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#17281d"/><stop offset="1" stop-color="#263923"/></linearGradient>
        <linearGradient id="soil" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#33291e"/><stop offset=".48" stop-color="#211b16"/><stop offset="1" stop-color="#121410"/></linearGradient>
        <filter id="softGlow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="1.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="pulseGlow" x="-250%" y="-250%" width="500%" height="500%"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <rect class="forest-top" data-ground="true" width="960" height="183"/>
      <g aria-hidden="true">
        <path class="root-ghost" d="M74 183 Q126 245 91 324 T145 452 M277 183 Q240 262 314 315 T260 512 M648 183 Q688 242 621 310 T697 502 M858 183 Q811 244 876 338 T824 514"/>
        <path class="leaf" fill="#8a6a4a" d="M0 164 Q42 136 94 164 Q54 180 0 175Z"/><path class="leaf" fill="#7fa36b" d="M72 170 Q126 137 183 169 Q132 186 72 180Z"/>
        <path class="leaf" fill="#ad744d" d="M164 162 Q221 132 277 166 Q225 182 164 177Z"/><path class="leaf" fill="#6d7d4c" d="M258 172 Q315 140 374 167 Q329 188 258 182Z"/>
        <path class="leaf" fill="#9a774e" d="M358 165 Q418 133 478 164 Q432 184 358 179Z"/><path class="leaf" fill="#738a52" d="M460 171 Q521 139 583 167 Q536 188 460 181Z"/>
        <path class="leaf" fill="#a06a47" d="M566 164 Q620 134 683 165 Q629 184 566 178Z"/><path class="leaf" fill="#71874e" d="M666 171 Q728 138 790 168 Q740 188 666 181Z"/>
        <path class="leaf" fill="#8f6b45" d="M770 164 Q833 132 892 167 Q842 183 770 178Z"/><path class="leaf" fill="#778b55" d="M870 170 Q919 143 960 162 L960 181 Q916 187 870 180Z"/>
      </g>
      <rect class="soil" data-ground="true" y="180" width="960" height="360"/>
      <g aria-hidden="true" id="speckles"></g>
      <path class="surface-line" d="M0 180 Q120 174 240 181 T480 179 T720 181 T960 178" aria-hidden="true"/>
      <g id="threads" aria-hidden="true"></g>
      <g id="pulses" aria-hidden="true"></g>
      <g id="mushrooms"></g>
      <g id="spores" aria-hidden="true"></g>
    </svg>
    <div class="rainveil" id="rainveil" aria-hidden="true"></div>
    <div class="empty-state" id="empty">
      <strong>The forest is waiting.</strong>
      <span>Press a letter or tap anywhere in the cross-section. Your first mushroom will remember its note here.</span>
    </div>
    <div class="readout">
      <span class="stat" id="count">0 mushrooms · 0 threads</span>
      <span class="stat" id="notice" role="status" aria-live="polite">Plant two mushrooms, then tap one to wake the network.</span>
    </div>
  </section>

  <div class="understory">
    <section class="card">
      <h2>How to play</h2>
      <p>Position sets pitch from low D on the left to high D on the right. Each new mushroom reaches for its nearest neighbors. Focus a mushroom and press <kbd>Enter</kbd> or <kbd>Space</kbd> to send the canon.</p>
      <div class="keymap" aria-label="Playable keyboard rows"><kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd><kbd>T</kbd><kbd>Y</kbd><kbd>U</kbd><kbd>I</kbd><kbd>O</kbd><kbd>P</kbd><kbd>A–L</kbd><kbd>Z–M</kbd></div>
    </section>
    <aside class="card">
      <h2>Field note</h2>
      <p>Many plants partner with mycorrhizal fungi: the fungi can help gather water and mineral nutrients, while receiving sugars made by the plant.</p>
      <p class="privacy">Your forest stays in this browser. Only the ordered notes of a canon join the PointCast Keyboard Signal, in batches of no more than 64.</p>
    </aside>
  </div>
</main>

<script is:inline src="/keyboard.js" data-app="keyboard-mycelium" async></script>
<script is:inline>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var NS = 'http://www.w3.org/2000/svg';
  var STORE_KEY = 'pc-mycelium-v1';
  var SCALE = [0, 2, 3, 5, 7, 9, 10, 12];
  var KEY_ORDER = '1234567890qwertyuiopasdfghjkl;zxcvbnm,./';
  var COLORS = ['#e7a3b3', '#f2c14e', '#b5a8ee', '#6fb3b8', '#a9c98a'];
  var reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  var state = { mushrooms: [], edges: [], tempo: 'medium', decay: 0.7, sound: true, spored: false };
  var nextId = 1;
  var ac = null, master = null, muted = false;
  var pulses = [], canonVisited = null, canonQueued = null, canonNotes = [];
  var signalQueue = [], signalTimer = null, lastSignalAt = 0;
  var rainState = null, sporeState = null, raf = 0, pausedAt = 0, lastFrame = 0;

  function svg(tag, attrs) {
    var el = document.createElementNS(NS, tag);
    Object.keys(attrs || {}).forEach(function (key) { el.setAttribute(key, String(attrs[key])); });
    return el;
  }
  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
  function hash(n) {
    var x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
    return x - Math.floor(x);
  }
  function pitchForX(x) {
    var index = clamp(Math.round((x - 42) / 876 * (SCALE.length - 1)), 0, SCALE.length - 1);
    return 50 + SCALE[index];
  }
  function noteName(midi) {
    var names = ['C', 'C♯', 'D', 'E♭', 'E', 'F', 'F♯', 'G', 'A♭', 'A', 'B♭', 'B'];
    return names[midi % 12] + String(Math.floor(midi / 12) - 1);
  }

  function save() {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify({
        v: 1,
        mushrooms: state.mushrooms.map(function (m) { return { id: m.id, x: m.x, y: m.y, variant: m.variant, seed: m.seed, key: m.key || '' }; }),
        edges: state.edges.map(function (e) { return { a: e.a, b: e.b, seed: e.seed }; }),
        tempo: state.tempo,
        decay: state.decay,
        sound: state.sound,
        spored: state.spored,
      }));
    } catch (e) { /* a private browser may decline storage */ }
  }
  function load() {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (!saved || !Array.isArray(saved.mushrooms)) return;
      var seen = {};
      state.mushrooms = saved.mushrooms.slice(0, 36).map(function (m, i) {
        var id = Math.max(1, Math.round(Number(m.id)) || i + 1);
        while (seen[id]) id++;
        seen[id] = true;
        return {
          id: id,
          x: clamp(Number(m.x) || 480, 42, 918),
          y: clamp(Number(m.y) || 180, 172, 187),
          variant: clamp(Math.round(Number(m.variant)) || 0, 0, 4),
          seed: Number(m.seed) || id * 17,
          key: typeof m.key === 'string' ? m.key.slice(0, 1).toUpperCase() : '',
        };
      });
      nextId = state.mushrooms.reduce(function (max, m) { return Math.max(max, m.id + 1); }, 1);
      state.edges = Array.isArray(saved.edges) ? saved.edges.map(function (e, i) {
        return { a: Math.round(Number(e.a)), b: Math.round(Number(e.b)), seed: Number(e.seed) || i * 31 + 7, fresh: false };
      }).filter(function (e) { return e.a !== e.b && seen[e.a] && seen[e.b]; }).slice(0, 70) : [];
      state.tempo = ['slow', 'medium', 'fast'].indexOf(saved.tempo) >= 0 ? saved.tempo : 'medium';
      state.decay = clamp(Number(saved.decay) || 0.7, 0.45, 0.88);
      state.sound = saved.sound !== false;
      state.spored = !!saved.spored || state.mushrooms.length >= 12;
    } catch (e) { /* malformed or unavailable storage starts a fresh forest */ }
  }

  function audio() {
    if (!ac) {
      ac = new (window.AudioContext || window.webkitAudioContext)();
      master = ac.createGain();
      master.gain.value = state.sound && !muted ? 0.28 : 0;
      var comp = ac.createDynamicsCompressor();
      comp.threshold.value = -20;
      comp.knee.value = 16;
      comp.ratio.value = 5;
      comp.attack.value = 0.012;
      comp.release.value = 0.3;
      master.connect(comp).connect(ac.destination);
    }
    if (ac.state === 'suspended') ac.resume();
    return ac;
  }
  function playNote(midi, gain, variant, when) {
    if (!state.sound || muted) return;
    try {
      var c = audio();
      var t = when || c.currentTime;
      var f = 440 * Math.pow(2, (midi - 69) / 12);
      var out = c.createGain();
      var filter = c.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 1350 + variant * 310;
      out.gain.value = clamp(gain == null ? 1 : gain, 0.08, 1);
      out.connect(filter).connect(master);
      var parts = variant === 3 ? [[1, 'sine', .16], [2.01, 'triangle', .035]] : variant === 1 ? [[1, 'triangle', .13], [1.5, 'sine', .03], [3, 'sine', .018]] : [[1, 'sine', .15], [2.02, 'sine', .055], [4.1, 'sine', .018]];
      parts.forEach(function (p) {
        var o = c.createOscillator(), g = c.createGain();
        o.type = p[1]; o.frequency.value = f * p[0];
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p[2], t + 0.012);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 1.35 / Math.sqrt(p[0]));
        o.connect(g).connect(out); o.start(t); o.stop(t + 1.5);
      });
    } catch (e) { /* visuals still play without Web Audio */ }
  }
  function playSporeChord() {
    if (!state.sound || muted) return;
    var c = audio(), now = c.currentTime + 0.02;
    [50, 57, 60, 64].forEach(function (midi, i) { playNote(midi, 0.48, i % 5, now + i * 0.12); });
  }

  function mushroomById(id) { return state.mushrooms.find(function (m) { return m.id === id; }); }
  function edgeId(e) { return 'edge-' + Math.min(e.a, e.b) + '-' + Math.max(e.a, e.b); }
  function hasEdge(a, b) { return state.edges.some(function (e) { return (e.a === a && e.b === b) || (e.a === b && e.b === a); }); }
  function neighbors(id) {
    var out = [];
    state.edges.forEach(function (e) { if (e.a === id) out.push(e.b); else if (e.b === id) out.push(e.a); });
    return out;
  }
  function edgeBetween(a, b) { return state.edges.find(function (e) { return (e.a === a && e.b === b) || (e.a === b && e.b === a); }); }

  function threadPoints(a, b, seed) {
    var count = 17;
    var points = [];
    var span = Math.abs(b.x - a.x);
    var depth = 92 + Math.min(115, span * .24) + hash(seed) * 42;
    for (var i = 0; i <= count; i++) {
      var t = i / count;
      var baseX = a.x + (b.x - a.x) * t;
      var baseY = a.y + 18 + (b.y - a.y) * t + Math.sin(Math.PI * t) * depth;
      var noise = (hash(seed + i * 13) - .5) * (10 + Math.sin(Math.PI * t) * 24);
      var sideways = (hash(seed + i * 19 + 2) - .5) * 16;
      points.push([baseX + sideways, baseY + noise]);
    }
    points[0] = [a.x, a.y + 16];
    points[count] = [b.x, b.y + 16];
    return points;
  }
  function smoothPath(points) {
    var d = 'M' + points[0][0].toFixed(1) + ' ' + points[0][1].toFixed(1);
    for (var i = 1; i < points.length - 1; i++) {
      var mx = (points[i][0] + points[i + 1][0]) / 2;
      var my = (points[i][1] + points[i + 1][1]) / 2;
      d += ' Q' + points[i][0].toFixed(1) + ' ' + points[i][1].toFixed(1) + ' ' + mx.toFixed(1) + ' ' + my.toFixed(1);
    }
    var last = points[points.length - 1];
    d += ' T' + last[0].toFixed(1) + ' ' + last[1].toFixed(1);
    return d;
  }
  function branchPath(points, index, seed, side) {
    var p = points[index];
    var dx = (hash(seed + side * 71) * 36 + 20) * side;
    var dy = 26 + hash(seed + side * 91) * 36;
    return 'M' + p[0].toFixed(1) + ' ' + p[1].toFixed(1) + ' q' + (dx * .5).toFixed(1) + ' ' + (dy * .3).toFixed(1) + ' ' + dx.toFixed(1) + ' ' + dy.toFixed(1);
  }

  function drawThreads() {
    var group = $('threads'); group.textContent = '';
    state.edges.forEach(function (edge) {
      var a = mushroomById(edge.a), b = mushroomById(edge.b);
      if (!a || !b) return;
      var points = threadPoints(a, b, edge.seed);
      var d = smoothPath(points);
      [-1, 1].forEach(function (side, i) {
        var branch = svg('path', { d: branchPath(points, i ? 11 : 6, edge.seed, side), class: 'thread branch' + (edge.fresh && !reduced ? ' growing' : '') });
        group.appendChild(branch);
        if (edge.fresh && !reduced) {
          var bl = branch.getTotalLength(); branch.style.strokeDasharray = String(bl); branch.style.setProperty('--len', String(bl)); branch.style.strokeDashoffset = String(bl);
        }
      });
      var path = svg('path', { id: edgeId(edge), d: d, class: 'thread main' + (edge.fresh && !reduced ? ' growing' : '') });
      group.appendChild(path);
      if (edge.fresh && !reduced) {
        var len = path.getTotalLength(); path.style.strokeDasharray = String(len); path.style.setProperty('--len', String(len)); path.style.strokeDashoffset = String(len);
      }
      edge.fresh = false;
    });
  }
  function capPath(m, top, width, height) {
    if (m.variant === 0) return 'M' + (m.x - width) + ' ' + top + ' Q' + m.x + ' ' + (top - height * .9) + ' ' + (m.x + width) + ' ' + top + ' Q' + m.x + ' ' + (top + height * .32) + ' ' + (m.x - width) + ' ' + top + 'Z';
    if (m.variant === 1) return 'M' + (m.x - width) + ' ' + top + ' Q' + (m.x - width * .28) + ' ' + (top - height * .95) + ' ' + m.x + ' ' + (top - height) + ' Q' + (m.x + width * .28) + ' ' + (top - height * .95) + ' ' + (m.x + width) + ' ' + top + 'Z';
    if (m.variant === 2) return 'M' + (m.x - width) + ' ' + top + ' Q' + (m.x - width * .65) + ' ' + (top - height) + ' ' + (m.x - width * .18) + ' ' + (top - height * .7) + ' Q' + m.x + ' ' + (top - height * 1.12) + ' ' + (m.x + width * .22) + ' ' + (top - height * .72) + ' Q' + (m.x + width * .7) + ' ' + (top - height) + ' ' + (m.x + width) + ' ' + top + ' Q' + m.x + ' ' + (top + 7) + ' ' + (m.x - width) + ' ' + top + 'Z';
    if (m.variant === 3) return 'M' + (m.x - width * .68) + ' ' + (top + 5) + ' Q' + (m.x - width * .7) + ' ' + (top - height * .65) + ' ' + m.x + ' ' + (top - height * 1.28) + ' Q' + (m.x + width * .7) + ' ' + (top - height * .65) + ' ' + (m.x + width * .68) + ' ' + (top + 5) + 'Z';
    return 'M' + (m.x - width) + ' ' + top + ' C' + (m.x - width * .8) + ' ' + (top - height) + ' ' + (m.x + width * .55) + ' ' + (top - height * .9) + ' ' + (m.x + width) + ' ' + (top - 2) + ' C' + (m.x + width * .5) + ' ' + (top + height * .25) + ' ' + (m.x - width * .65) + ' ' + (top + height * .22) + ' ' + (m.x - width) + ' ' + top + 'Z';
  }
  function drawMushrooms(freshId) {
    var group = $('mushrooms'); group.textContent = '';
    var hitRadius = clamp(22 * 960 / Math.max(320, $('forest').clientWidth || 960), 24, 62);
    state.mushrooms.forEach(function (m) {
      var scale = .84 + hash(m.seed + 2) * .42;
      var stemH = (34 + hash(m.seed + 5) * 28) * scale;
      var width = (20 + hash(m.seed + 8) * 16) * scale;
      var capH = (17 + hash(m.seed + 11) * 12) * scale;
      var top = m.y - stemH;
      var g = svg('g', { class: 'mushroom' + (m.id === freshId && !reduced ? ' growing' : ''), tabindex: '0', role: 'button', 'data-mushroom': m.id, 'aria-label': 'Mushroom ' + m.id + ', note ' + noteName(pitchForX(m.x)) + '. Start echo canon.' });
      g.appendChild(svg('circle', { class: 'hit-area', cx: m.x, cy: top + stemH * .48, r: hitRadius }));
      var stem = svg('path', { class: 'stem', d: 'M' + (m.x - 5 * scale) + ' ' + m.y + ' Q' + (m.x - 2 * scale) + ' ' + (top + 12) + ' ' + (m.x - 1.5) + ' ' + (top + 3) + ' L' + (m.x + 2.5) + ' ' + (top + 3) + ' Q' + (m.x + 4 * scale) + ' ' + (top + 14) + ' ' + (m.x + 6 * scale) + ' ' + m.y + 'Z' });
      var cap = svg('path', { class: 'cap', d: capPath(m, top + 6, width, capH), fill: COLORS[m.variant] });
      var gill = svg('path', { class: 'gill', d: 'M' + (m.x - width * .68) + ' ' + (top + 6) + ' Q' + m.x + ' ' + (top + 13) + ' ' + (m.x + width * .68) + ' ' + (top + 6) });
      g.appendChild(stem); g.appendChild(cap); g.appendChild(gill);
      if (m.variant === 3) g.appendChild(svg('ellipse', { class: 'ring', cx: m.x, cy: top + 17, rx: 8 * scale, ry: 2.6 * scale }));
      if (m.key) {
        g.appendChild(svg('circle', { class: 'key-tag', cx: m.x, cy: top - capH * .45, r: 10 }));
        var text = svg('text', { class: 'key-text', x: m.x, y: top - capH * .45 + 4 }); text.textContent = m.key; g.appendChild(text);
      }
      group.appendChild(g);
    });
  }
  function render(freshId) {
    drawThreads();
    drawMushrooms(freshId);
    $('empty').hidden = state.mushrooms.length > 0;
    $('count').textContent = state.mushrooms.length + (state.mushrooms.length === 1 ? ' mushroom' : ' mushrooms') + ' · ' + state.edges.length + (state.edges.length === 1 ? ' thread' : ' threads');
  }

  function connectNew(m) {
    var others = state.mushrooms.filter(function (x) { return x.id !== m.id; }).map(function (x) { return { m: x, d: Math.abs(x.x - m.x) }; }).sort(function (a, b) { return a.d - b.d; });
    var picks = others.slice(0, 1);
    if (others[1] && others[1].d < 330 && Math.abs(others[1].m.x - others[0].m.x) > 48) picks.push(others[1]);
    picks.forEach(function (pick, i) {
      if (!hasEdge(m.id, pick.m.id)) state.edges.push({ a: m.id, b: pick.m.id, seed: m.seed + pick.m.seed + i * 43, fresh: true });
    });
  }
  function nearestOpenX(x) {
    var attempt = clamp(x, 42, 918);
    for (var i = 0; i < 12; i++) {
      var crowded = state.mushrooms.some(function (m) { return Math.abs(m.x - attempt) < 24; });
      if (!crowded) return attempt;
      attempt = clamp(x + (i % 2 ? -1 : 1) * (28 + Math.ceil(i / 2) * 17), 42, 918);
    }
    return attempt;
  }
  function plant(x, key, quiet) {
    if (state.mushrooms.length >= 36) { notice('This patch is full. Tap a mushroom and let it sing.'); return null; }
    var id = nextId++;
    var px = nearestOpenX(x);
    var m = { id: id, x: px, y: 178 + hash(id * 5) * 8, variant: Math.floor(hash(id * 23 + px) * 5), seed: id * 97 + px * .31, key: key || '' };
    state.mushrooms.push(m);
    connectNew(m);
    render(id);
    save();
    if (!quiet) playNote(pitchForX(m.x), .55, m.variant);
    if (state.mushrooms.length === 1) notice('One fruiting body. Plant another to grow a thread.');
    else notice('A new ' + noteName(pitchForX(m.x)) + ' joined the underground network.');
    if (state.mushrooms.length === 12 && !state.spored) sporeBloom();
    ensureAnimation();
    return m;
  }

  function setSinging(id, duration) {
    var el = $('mushrooms').querySelector('[data-mushroom="' + id + '"]');
    if (!el) return;
    el.classList.add('singing');
    setTimeout(function () { if (el.isConnected) el.classList.remove('singing'); }, reduced ? 160 : duration || 560);
  }
  function singMushroom(id, gain, addToSignal) {
    var m = mushroomById(id); if (!m) return;
    var note = pitchForX(m.x);
    playNote(note, gain, m.variant);
    setSinging(id, 620);
    if (addToSignal) { canonNotes.push(note); queueSignal(note); }
  }
  function tempoFactor() { return state.tempo === 'slow' ? 5.0 : state.tempo === 'fast' ? 2.0 : 3.25; }
  function queuePulse(from, to, depth, gain, now) {
    var edge = edgeBetween(from, to); if (!edge) return;
    var path = document.getElementById(edgeId(edge)); if (!path) return;
    var length = path.getTotalLength();
    var startsAt = now == null ? performance.now() : now;
    pulses.push({ from: from, to: to, depth: depth, gain: gain, start: startsAt, duration: clamp(length * tempoFactor(), 480, 3600), pathId: edgeId(edge), length: length });
    canonQueued.add(to);
  }
  function startCanon(id) {
    var m = mushroomById(id); if (!m) return;
    audio();
    pulses = [];
    $('pulses').textContent = '';
    canonVisited = new Set([id]);
    canonQueued = new Set([id]);
    canonNotes = [];
    singMushroom(id, .95, true);
    var now = performance.now();
    neighbors(id).forEach(function (next) { queuePulse(id, next, 1, state.decay, now + 110); });
    notice(neighbors(id).length ? 'Listen — ' + noteName(pitchForX(m.x)) + ' is branching through the mycelium.' : 'This mushroom sings alone. Plant a neighbor for an echo.');
    ensureAnimation();
  }
  function arrive(pulse, now) {
    if (!canonVisited || canonVisited.has(pulse.to)) return;
    canonVisited.add(pulse.to);
    singMushroom(pulse.to, pulse.gain, true);
    if (pulse.gain < .15) return;
    neighbors(pulse.to).forEach(function (next) {
      if (!canonVisited.has(next) && !canonQueued.has(next)) queuePulse(pulse.to, next, pulse.depth + 1, pulse.gain * state.decay, now + 75);
    });
  }
  function drawPulses(now) {
    var group = $('pulses'); group.textContent = '';
    var active = [], arrived = [];
    pulses.forEach(function (pulse) {
      var progress = (now - pulse.start) / pulse.duration;
      if (progress < 0) { active.push(pulse); return; }
      if (progress >= 1) { arrived.push(pulse); return; }
      active.push(pulse);
      if (reduced) return;
      var path = document.getElementById(pulse.pathId); if (!path) return;
      var forward = edgeBetween(pulse.from, pulse.to);
      var direction = forward && forward.a === pulse.from ? progress : 1 - progress;
      var p = path.getPointAtLength(clamp(direction, 0, 1) * pulse.length);
      var dot = svg('circle', { class: 'pulse', cx: p.x, cy: p.y, r: 4.5 + pulse.gain * 3, opacity: .42 + pulse.gain * .58 });
      group.appendChild(dot);
    });
    pulses = active;
    arrived.forEach(function (pulse) { arrive(pulse, now); });
    if (!pulses.length && canonVisited && canonVisited.size) {
      notice('The canon reached ' + canonVisited.size + (canonVisited.size === 1 ? ' mushroom.' : ' mushrooms. Tap another to send a new path.'));
      canonVisited = null; canonQueued = null;
    }
  }

  function queueSignal(note) {
    signalQueue.push(note);
    if (signalQueue.length > 256) signalQueue = signalQueue.slice(-256);
    scheduleSignal();
  }
  function scheduleSignal() {
    if (signalTimer || !signalQueue.length) return;
    var wait = lastSignalAt ? Math.max(0, 4000 - (Date.now() - lastSignalAt)) : 4000;
    signalTimer = setTimeout(flushSignal, wait);
  }
  function flushSignal() {
    signalTimer = null;
    if (!signalQueue.length) return;
    if (!window.PointCastKeyboard) { signalTimer = setTimeout(flushSignal, 500); return; }
    var notes = signalQueue.splice(0, 64);
    window.PointCastKeyboard.note(notes, null, { sound: false });
    lastSignalAt = Date.now();
    if (signalQueue.length) signalTimer = setTimeout(flushSignal, 4000);
  }

  function sporeBloom() {
    state.spored = true; save();
    var particles = [];
    for (var i = 0; i < 74; i++) particles.push({ x: 90 + hash(i * 17) * 780, y: 175 + hash(i * 29) * 28, drift: (hash(i * 41) - .5) * 70, rise: 90 + hash(i * 53) * 220, size: 1.5 + hash(i * 67) * 3.5, delay: hash(i * 79) * 900 });
    sporeState = { start: performance.now(), particles: particles, duration: reduced ? 1200 : 5200 };
    playSporeChord();
    notice('Twelve! A golden spore cloud rises and the whole forest blooms a chord.');
    ensureAnimation();
  }
  function drawSpores(now) {
    var group = $('spores'); group.textContent = '';
    if (!sporeState) return;
    var elapsed = now - sporeState.start;
    if (elapsed > sporeState.duration) { sporeState = null; return; }
    sporeState.particles.forEach(function (s) {
      var p = clamp((elapsed - s.delay) / Math.max(300, sporeState.duration - s.delay), 0, 1);
      if (p <= 0) return;
      if (reduced) p = .45;
      var eased = 1 - Math.pow(1 - p, 2);
      var x = s.x + Math.sin(p * 8 + s.x) * 12 + s.drift * p;
      var y = s.y - s.rise * eased;
      group.appendChild(svg('circle', { class: 'spore', cx: x, cy: y, r: s.size, opacity: Math.sin(Math.PI * p) * .86 }));
    });
  }

  function startRain() {
    audio();
    if (rainState) { notice('The rain is already moving through the forest.'); return; }
    var now = performance.now();
    rainState = { start: now, end: now + 10000, next: now + 280, planted: 0 };
    $('rain').disabled = true;
    $('rain').textContent = 'Rain is falling…';
    $('rainveil').classList.add('on');
    notice('Rain darkens the leaf litter. Watch for new caps.');
    ensureAnimation();
  }
  function updateRain(now) {
    if (!rainState) return;
    if (now >= rainState.next && now < rainState.end && state.mushrooms.length < 36) {
      var x = 55 + hash(rainState.start + rainState.planted * 47) * 850;
      var m = plant(x, '', true);
      if (m) {
        playNote(pitchForX(m.x), .3, m.variant);
        rainState.planted++;
      }
      rainState.next = now + 760 + hash(rainState.planted * 101) * 650;
    }
    if (now >= rainState.end || state.mushrooms.length >= 36) {
      var made = rainState.planted;
      rainState = null;
      $('rain').disabled = false;
      $('rain').textContent = 'Rain for 10 seconds';
      $('rainveil').classList.remove('on');
      notice(made ? 'The rain passed. ' + made + (made === 1 ? ' mushroom appeared.' : ' mushrooms appeared.') : 'The rain passed over a full forest.');
    }
  }
  function frame(now) {
    raf = 0;
    if (document.hidden) return;
    if (now - lastFrame < 16) { raf = requestAnimationFrame(frame); return; }
    lastFrame = now;
    drawPulses(now);
    drawSpores(now);
    updateRain(now);
    if (pulses.length || sporeState || rainState) raf = requestAnimationFrame(frame);
  }
  function ensureAnimation() { if (!raf && !document.hidden) raf = requestAnimationFrame(frame); }

  function notice(message) { $('notice').textContent = message; }
  function updateControls() {
    Array.prototype.forEach.call($('tempo').children, function (button) { button.setAttribute('aria-pressed', String(button.dataset.tempo === state.tempo)); });
    $('decay').value = String(Math.round(state.decay * 100));
    $('decayValue').textContent = Math.round(state.decay * 100) + '%';
    $('sound').setAttribute('aria-pressed', String(state.sound));
    $('sound').setAttribute('aria-label', state.sound ? 'Turn sound off' : 'Turn sound on');
    $('sound').textContent = state.sound ? '♪ Sound on' : '♪ Sound off';
  }

  $('forest').addEventListener('pointerdown', function (event) {
    if (event.button && event.button !== 0) return;
    var target = event.target.closest && event.target.closest('[data-mushroom]');
    event.preventDefault();
    if (target) { startCanon(Number(target.getAttribute('data-mushroom'))); return; }
    audio();
    var rect = $('forest').getBoundingClientRect();
    plant((event.clientX - rect.left) / rect.width * 960, '', false);
  });
  $('forest').addEventListener('keydown', function (event) {
    var target = event.target.closest && event.target.closest('[data-mushroom]');
    if (!target || (event.key !== 'Enter' && event.key !== ' ')) return;
    event.preventDefault(); startCanon(Number(target.getAttribute('data-mushroom')));
  });
  document.addEventListener('keydown', function (event) {
    if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
    var tag = event.target && event.target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'BUTTON') return;
    var key = event.key.toLowerCase();
    var index = KEY_ORDER.indexOf(key);
    if (index < 0) return;
    event.preventDefault(); audio();
    var x = 50 + index / (KEY_ORDER.length - 1) * 860 + (hash(state.mushrooms.length * 37 + index) - .5) * 24;
    plant(x, event.key.length === 1 ? event.key.toUpperCase() : '', false);
  });
  $('tempo').addEventListener('click', function (event) {
    var button = event.target.closest('[data-tempo]'); if (!button) return;
    state.tempo = button.dataset.tempo; updateControls(); save();
  });
  $('decay').addEventListener('input', function () { state.decay = Number($('decay').value) / 100; updateControls(); save(); });
  $('sound').addEventListener('click', function () {
    state.sound = !state.sound;
    muted = !state.sound;
    if (state.sound) audio();
    if (master) master.gain.value = state.sound ? .28 : 0;
    updateControls(); save();
    notice(state.sound ? 'Sound is on. Tap a mushroom to hear the network.' : 'Sound is off. The light will still travel.');
  });
  $('rain').addEventListener('click', startRain);
  $('clear').addEventListener('click', function () {
    if (!state.mushrooms.length) { notice('The forest is already open ground.'); return; }
    if (!confirm('Clear every mushroom and thread from this forest?')) return;
    pulses = []; canonVisited = null; canonQueued = null; canonNotes = [];
    rainState = null; sporeState = null; state.mushrooms = []; state.edges = []; state.spored = false; nextId = 1;
    $('pulses').textContent = ''; $('spores').textContent = ''; $('rainveil').classList.remove('on');
    $('rain').disabled = false; $('rain').textContent = 'Rain for 10 seconds';
    save(); render(); notice('Open ground again. Press a letter or tap to begin.');
  });
  addEventListener('resize', function () { render(); });
  document.addEventListener('visibilitychange', function () {
    var now = performance.now();
    if (document.hidden) {
      document.body.classList.add('paused');
      pausedAt = now;
      if (raf) cancelAnimationFrame(raf); raf = 0;
      if (ac && ac.state === 'running') ac.suspend();
      save();
    } else {
      document.body.classList.remove('paused');
      var pause = pausedAt ? now - pausedAt : 0;
      pulses.forEach(function (p) { p.start += pause; });
      if (sporeState) sporeState.start += pause;
      if (rainState) { rainState.start += pause; rainState.end += pause; rainState.next += pause; }
      pausedAt = 0; ensureAnimation();
    }
  });
  addEventListener('pagehide', function () { save(); if (window.PointCastKeyboard) window.PointCastKeyboard.flush(); });

  (function makeSpeckles() {
    var group = $('speckles');
    for (var i = 0; i < 84; i++) group.appendChild(svg('circle', { class: 'soil-speck', cx: 12 + hash(i * 17) * 936, cy: 198 + hash(i * 31) * 325, r: 1 + hash(i * 43) * 2.3 }));
  })();
  load();
  muted = !state.sound;
  updateControls();
  render();
  if (state.mushrooms.length) notice('Your saved forest is here. Tap any mushroom to send a canon.');
})();
</script>
</body>
</html>
