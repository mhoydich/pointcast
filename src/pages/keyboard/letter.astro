---
/**
 * /keyboard/letter — Key Letter: a note that plays itself.
 *
 * Write a short letter; it becomes a melody in the rhythm you typed it (same
 * voice as Key Diary, /js/keyboard-voice.js). Seal it into a link and send
 * it. The words and rhythm ride in the URL fragment (#l=…), which browsers
 * never send to a server, so PointCast never sees the letter. Opening it
 * types the letter out while it plays.
 *
 * The town chord (/keyboard-signal) gets only a sorted bag of the notes when
 * a letter is sealed or opened.
 */
const title = 'Key Letter · PointCast';
const description =
  'Write a short letter and it becomes a melody in the rhythm you typed it. Send the link; it plays itself when it is opened. The words ride in the link, never on our server.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/letter">
<meta property="og:title" content="Key Letter · a note that plays itself">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--mood:#dfc48d;--paper:#efe8d2;--paper-ink:#2c3326;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 20% 0%,#34413255,transparent 45%),var(--bg);color:var(--ink);min-height:100vh}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:10px 15px;cursor:pointer;font-size:11px}
button:hover{background:#1e2b20;border-color:#688777}
button.primary{background:var(--mood);border-color:var(--mood);color:var(--bg)}
button:disabled{opacity:.4;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:760px;margin:0 auto;padding:34px 20px 60px}
.label{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin:0 0 8px}
.sheet{background:var(--paper);color:var(--paper-ink);border-radius:6px 6px 14px 14px;padding:34px 38px 28px;box-shadow:0 22px 50px #0006,inset 0 0 0 1px #0000000d;position:relative;background-image:repeating-linear-gradient(transparent 0 35px,#2c332612 35px 36px)}
.sheet:before{content:'';position:absolute;top:0;left:0;right:0;height:6px;background:var(--mood);border-radius:6px 6px 0 0}
.row{display:flex;align-items:baseline;gap:10px;font-family:Georgia,serif;font-size:19px}
.row input{flex:1;border:0;border-bottom:1px dashed #2c332644;background:transparent;font:inherit;color:inherit;outline:none;padding:4px 0}
textarea{width:100%;min-height:240px;border:0;background:transparent;resize:vertical;outline:none;color:inherit;font-family:Georgia,serif;font-size:21px;line-height:36px;margin:12px 0 6px;padding:0;caret-color:#8a6d2b}
textarea::placeholder,.row input::placeholder{color:#2c332666}
.sign{justify-content:flex-end}
.sign input{flex:0 1 220px;text-align:right}
.moods{display:flex;gap:6px;flex-wrap:wrap;margin:18px 0}
.moods button{padding:7px 12px;font-size:10px}
.moods button[aria-pressed=true]{background:var(--mood);border-color:var(--mood);color:var(--bg)}
.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.meta{font-size:10px;color:var(--dim);margin-left:auto}
.sealed{margin-top:22px;border:1px solid var(--line);border-radius:14px;padding:16px;background:#0d1711}
.sealed input{width:100%;background:#0b120d;border:1px solid var(--line);border-radius:10px;color:var(--ink);font:inherit;font-size:11px;padding:11px;margin:8px 0 12px}
.note{font-size:10px;color:var(--dim);line-height:1.8;margin:14px 0 0}
.envelope{display:grid;place-items:center;text-align:center;min-height:60vh}
.env{width:min(460px,100%);aspect-ratio:1.55;background:var(--paper);border-radius:10px;position:relative;box-shadow:0 26px 60px #0007;overflow:hidden;cursor:pointer;border:0;padding:0;color:var(--paper-ink)}
.env:before{content:'';position:absolute;inset:0;background:linear-gradient(to bottom right,transparent 49.6%,#d7cfb5 50%) left/50% 100% no-repeat,linear-gradient(to bottom left,transparent 49.6%,#d7cfb5 50%) right/50% 100% no-repeat}
.env:after{content:'';position:absolute;left:0;right:0;top:0;height:58%;background:#e4dcc2;clip-path:polygon(0 0,100% 0,50% 100%);transition:transform .5s;transform-origin:top}
.env:hover:after{transform:rotateX(18deg)}
.seal{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);width:62px;height:62px;border-radius:50%;background:var(--mood);display:grid;place-items:center;font-size:24px;color:var(--bg);z-index:2;box-shadow:0 3px 0 #0003}
.env .to{position:absolute;left:0;right:0;bottom:16px;font-family:Georgia,serif;font-size:17px;z-index:2}
.from{font-family:Georgia,serif;font-size:26px;margin:22px 0 4px}
.reading{font-family:Georgia,serif;font-size:22px;line-height:36px;white-space:pre-wrap;word-break:break-word;min-height:200px;margin:14px 0 10px}
.reading .ahead{color:#2c332630}
.reading .now{background:var(--mood);color:var(--bg);border-radius:3px}
[hidden]{display:none!important}
@media(max-width:560px){header{padding:16px}.sheet{padding:28px 20px 22px}.brand small{margin-left:0}textarea,.reading{font-size:19px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Key Letter<small>A note that plays itself</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard/notes">Notes</a>
    <a href="/keyboard/shelf">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/letter" aria-current="page">Key Letter</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
</header>

<main>
  <!-- Receiving -->
  <section id="receive" hidden>
    <div class="envelope" id="envWrap">
      <div>
        <p class="label" id="envLabel">A letter for you</p>
        <button type="button" class="env" id="env" aria-label="Open the letter">
          <span class="seal">♪</span>
          <span class="to" id="envTo"></span>
        </button>
        <p class="note">Tap to open. It plays as it reads — turn your sound on.</p>
      </div>
    </div>
    <div id="opened" hidden>
      <div class="sheet">
        <p class="row" id="rTo"></p>
        <div class="reading" id="reading" aria-live="polite"></div>
        <p class="row sign" id="rFrom"></p>
      </div>
      <div class="actions" style="margin-top:18px">
        <button type="button" class="primary" id="again">▶ Play again</button>
        <button type="button" id="reply">✎ Write back</button>
        <a href="/keyboard/letter" style="font-size:11px;margin-left:6px">Write your own</a>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section id="compose">
    <p class="label">Write a letter · it plays in the rhythm you type it</p>
    <div class="sheet">
      <p class="row"><span>Dear</span><input id="to" maxlength="40" placeholder="someone" autocomplete="off"></p>
      <textarea id="text" maxlength="400" placeholder="Say something small. Every letter is a note: vowels sing the chord, a full stop comes home."></textarea>
      <p class="row sign"><span>—</span><input id="from" maxlength="40" placeholder="your name" autocomplete="off"></p>
    </div>
    <div class="moods" id="moods" role="group" aria-label="Mood"></div>
    <div class="actions">
      <button type="button" id="preview">▶ Hear it</button>
      <button type="button" class="primary" id="seal">✉ Seal &amp; copy link</button>
      <button type="button" id="sound" aria-pressed="true">♪ Sound on</button>
      <span class="meta" id="meta">0 / 400</span>
    </div>
    <div class="sealed" id="sealed" hidden>
      <p class="label">Sealed · link copied</p>
      <input id="link" readonly aria-label="Letter link">
      <div class="actions">
        <button type="button" class="primary" id="copy">Copy again</button>
        <button type="button" id="shareBtn" hidden>Share…</button>
        <a id="openLink" href="#" style="font-size:11px">Open it like they will ↗</a>
      </div>
    </div>
    <p class="note">The letter and its rhythm live in the part of the link after <code>#</code>, which browsers never send to a server — PointCast never sees your words. Anyone with the link can read it. When it's sealed or opened, only a sorted handful of its notes joins the town chord on <a href="/keyboard-signal">/keyboard-signal</a>.</p>
  </section>
</main>

<script is:inline src="/js/keyboard-voice.js"></script>
<script is:inline src="/keyboard.js" data-app="keyboard-letter" async></script>
<script is:inline>
(function () {
  'use strict';
  var V = window.KeyVoice;
  var $ = function (id) { return document.getElementById(id); };
  var MAX = 400;
  var mood = 'bright';
  var sound = true;
  var dts = [];          // one gap per character, while typing at the end
  var loose = false;     // true once the text was edited mid-way: rhythm is re-imagined
  var lastAt = 0;
  var prevNote = null;
  var timers = [];

  // ---- encoding: #l=<base64url(JSON)> ---------------------------------------
  function b64url(str) {
    var bytes = new TextEncoder().encode(str), bin = '';
    for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function unb64url(s) {
    var bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function rhythmFor(text) {
    if (!loose && dts.length === text.length) {
      return dts.map(function (d) { return String.fromCharCode(48 + Math.max(0, Math.min(74, Math.round(d / 12)))); }).join('');
    }
    return '';
  }
  function gaps(text, r) {
    var out = [];
    for (var i = 0; i < text.length; i++) {
      if (r && r.length === text.length) out.push(Math.max(60, Math.min(700, (r.charCodeAt(i) - 48) * 12)));
      else out.push(i === 0 ? 0 : /\s/.test(text[i - 1]) ? 230 : /[.,!?;:]/.test(text[i - 1]) ? 380 : 135);
    }
    out[0] = 0;
    return out;
  }
  function encode() {
    var text = $('text').value.slice(0, MAX);
    return b64url(JSON.stringify({ v: 1, t: text, r: rhythmFor(text), m: mood, to: $('to').value.trim().slice(0, 40), f: $('from').value.trim().slice(0, 40) }));
  }
  function decode(hash) {
    var m = /^#l=([A-Za-z0-9_-]{4,4000})$/.exec(hash || '');
    if (!m) return null;
    try {
      var d = JSON.parse(unb64url(m[1]));
      if (!d || typeof d.t !== 'string' || !d.t.trim()) return null;
      return {
        t: d.t.slice(0, MAX),
        r: typeof d.r === 'string' ? d.r.slice(0, MAX) : '',
        m: V.mood(d.m).id,
        to: typeof d.to === 'string' ? d.to.slice(0, 40) : '',
        f: typeof d.f === 'string' ? d.f.slice(0, 40) : '',
      };
    } catch (e) { return null; }
  }

  function setMood(id) {
    mood = V.mood(id).id;
    document.documentElement.style.setProperty('--mood', V.mood(mood).color);
    Array.prototype.forEach.call($('moods').children, function (b) { b.setAttribute('aria-pressed', String(b.dataset.mood === mood)); });
  }
  V.moods.forEach(function (m) {
    var b = document.createElement('button');
    b.type = 'button'; b.dataset.mood = m.id; b.textContent = m.emoji + ' ' + m.label;
    b.addEventListener('click', function () {
      setMood(m.id);
      if (sound) V.mood(m.id).chord.forEach(function (s, i) { V.play(V.mood(m.id).root + s, m.id, V.ctx().currentTime + i * 0.08); });
    });
    $('moods').appendChild(b);
  });

  // ---- performing a letter ---------------------------------------------------
  function stop() { timers.forEach(clearTimeout); timers = []; }
  function bagOf(text, m) {
    var prev = null, out = [];
    for (var i = 0; i < text.length && out.length < 64; i++) {
      var n = V.noteFor(text[i], m, prev);
      if (n != null) { out.push(n); prev = n; }
    }
    return out.sort(function (a, b) { return a - b; });
  }
  function toTown(text, m) {
    var bag = bagOf(text, m);
    if (bag.length && window.PointCastKeyboard) { window.PointCastKeyboard.note(bag, null, { sound: false }); window.PointCastKeyboard.flush(); }
  }
  function perform(letter, onChar, onDone) {
    stop();
    var g = gaps(letter.t, letter.r);
    var t = 0, prev = null;
    var c = V.ctx();
    for (var i = 0; i < letter.t.length; i++) {
      t += g[i];
      (function (i, at) {
        timers.push(setTimeout(function () {
          var n = V.noteFor(letter.t[i], letter.m, prev);
          if (n != null) { prev = n; if (sound) V.play(n, letter.m, c.currentTime); }
          onChar(i);
        }, at));
      })(i, t);
    }
    timers.push(setTimeout(onDone || function () {}, t + 600));
  }

  // ---- writing -------------------------------------------------------------------
  function paintMeta() {
    var n = $('text').value.length;
    $('meta').textContent = n + ' / ' + MAX + (loose && n ? ' · rhythm re-imagined after edits' : '');
  }
  $('text').addEventListener('input', function (ev) {
    var el = ev.target;
    var atEnd = el.selectionStart === el.value.length;
    var now = performance.now();
    if ((ev.inputType === 'insertText' || ev.inputType === 'insertLineBreak') && atEnd) {
      var chars = ev.inputType === 'insertLineBreak' ? '\n' : (ev.data || '');
      for (var i = 0; i < chars.length; i++) {
        dts.push(lastAt ? Math.min(900, now - lastAt) : 0);
        var n = V.noteFor(chars[i], mood, prevNote);
        if (n != null) { prevNote = n; if (sound && i < 4) V.play(n, mood); }
      }
      lastAt = now;
    } else if (ev.inputType === 'deleteContentBackward' && atEnd && dts.length === el.value.length + 1) {
      dts.pop();
    } else {
      loose = true;
    }
    if (!el.value) { dts = []; loose = false; lastAt = 0; }
    $('sealed').hidden = true;
    paintMeta();
  });
  $('preview').addEventListener('click', function () {
    var text = $('text').value.slice(0, MAX);
    if (!text.trim()) { $('text').focus(); return; }
    perform({ t: text, r: rhythmFor(text), m: mood }, function () {});
  });
  function copy(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text).catch(function () {});
    $('link').select();
    try { document.execCommand('copy'); } catch (e) { /* the link is still shown */ }
    return Promise.resolve();
  }
  $('seal').addEventListener('click', function () {
    var text = $('text').value.slice(0, MAX);
    if (!text.trim()) { $('text').focus(); return; }
    var url = location.origin + '/keyboard/letter#l=' + encode();
    $('link').value = url;
    $('openLink').href = url;
    $('sealed').hidden = false;
    $('shareBtn').hidden = !navigator.share;
    copy(url);
    if (sound) [0, 7, 12].forEach(function (s, i) { V.play(V.mood(mood).root + s, mood, V.ctx().currentTime + i * 0.12); });
    toTown(text, mood);
  });
  $('copy').addEventListener('click', function () { copy($('link').value); });
  $('shareBtn').addEventListener('click', function () {
    var to = $('to').value.trim();
    navigator.share({ title: to ? 'A letter for ' + to : 'A letter for you', text: 'A note that plays itself', url: $('link').value }).catch(function () {});
  });
  $('sound').addEventListener('click', function () {
    sound = !sound;
    $('sound').setAttribute('aria-pressed', String(sound));
    $('sound').textContent = sound ? '♪ Sound on' : '♪ Sound off';
  });

  // ---- receiving -------------------------------------------------------------------
  var received = null;
  function paintReading(i) {
    var box = $('reading');
    var t = received.t;
    box.innerHTML = '';
    box.appendChild(document.createTextNode(t.slice(0, i)));
    var now = document.createElement('span'); now.className = 'now'; now.textContent = t.slice(i, i + 1);
    var ahead = document.createElement('span'); ahead.className = 'ahead'; ahead.textContent = t.slice(i + 1);
    box.appendChild(now); box.appendChild(ahead);
  }
  function openLetter() {
    $('envWrap').hidden = true;
    $('opened').hidden = false;
    perform(received, paintReading, function () { $('reading').textContent = received.t; });
    toTown(received.t, received.m);
  }
  function route() {
    stop();
    received = decode(location.hash);
    $('receive').hidden = !received;
    $('compose').hidden = !!received;
    if (received) {
      document.documentElement.style.setProperty('--mood', V.mood(received.m).color);
      $('envTo').textContent = received.to ? 'for ' + received.to : '';
      $('envLabel').textContent = received.f ? 'A letter from ' + received.f : 'A letter for you';
      $('rTo').textContent = received.to ? 'Dear ' + received.to + ',' : '';
      $('rFrom').textContent = received.f ? '— ' + received.f : '';
      $('envWrap').hidden = false;
      $('opened').hidden = true;
      document.title = (received.f ? 'A letter from ' + received.f : 'A letter for you') + ' · Key Letter';
    } else {
      setMood(mood);
      document.title = 'Key Letter · PointCast';
    }
  }
  $('env').addEventListener('click', openLetter);
  $('again').addEventListener('click', function () { perform(received, paintReading, function () { $('reading').textContent = received.t; }); });
  $('reply').addEventListener('click', function () {
    var back = received;
    history.pushState(null, '', '/keyboard/letter');
    route();
    $('to').value = back.f || '';
    $('text').value = '';
    dts = []; loose = false; lastAt = 0;
    setMood(back.m);
    paintMeta();
    $('text').focus();
  });
  addEventListener('hashchange', route);
  route();
  paintMeta();
})();
</script>
</body>
</html>
