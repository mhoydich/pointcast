<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer"><title>Cascade · Keyboard Bloom</title><meta name="description" content="A colorful musical notebook. Match blooms, catch ideas, and make a story with friends."><link rel="canonical" href="https://pointcast.xyz/keyboard/cascade"><style is:inline>
:root{font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;color:#30264b;background:#f8ecff;--paper:#fff9ff;--ink:#30264b;--soft:#775f8e;--edge:#e5c5ee;--purple:#783cb4;--pink:#e854a8;--hot:#ff6f78;--gold:#ffd36d;--glow:#ffeffc}*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(circle at 4% 12%,#ffc9e6 0,transparent 32%),radial-gradient(circle at 94% 4%,#b6eafa 0,transparent 28%),radial-gradient(circle at 78% 95%,#d7bafa 0,transparent 32%),#f8ecff;color:var(--ink)}body[data-skin=night]{--paper:#211a37;--ink:#fff5ed;--soft:#c8b2e3;--edge:#51426b;--purple:#a77bff;--glow:#4c3c68;background:radial-gradient(circle at top,#41316a,#161225 75%)}body[data-skin=citrus]{--paper:#fffdf1;--ink:#36443d;--soft:#67775b;--edge:#d8e0aa;--purple:#36896f;--pink:#f0816b;--glow:#eff8c5;background:radial-gradient(circle at top,#d8ffd0,#fff5cd 70%)}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:wait}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #ffaf42;outline-offset:2px}[hidden]{display:none!important}.shell{max-width:1600px;margin:auto;padding:16px clamp(12px,2.4vw,34px) 35px}.top,.brand,.top nav,.top-controls,.row,.toolbar,.stats,.section-head,.roombar,.note-actions,.chat-form,.share-form{display:flex;align-items:center;gap:10px}.top{justify-content:space-between;flex-wrap:wrap;background:#fff9ffcf;border:2px solid #ffffff;border-radius:22px;padding:12px 18px;box-shadow:0 10px 32px #a45ac020}.brand{text-decoration:none;color:#513178;font-weight:1000;font-size:22px;letter-spacing:-.06em}.brand-icon{display:grid;place-items:center;width:37px;height:37px;background:#fa63b7;border:3px solid #fff;border-radius:13px;box-shadow:0 4px 0 #b13e9e;color:#fff;transform:rotate(-8deg)}.top nav{flex-wrap:wrap}.top nav a{text-decoration:none;color:#685881;font-size:12px;font-weight:800;padding:7px 10px;border-radius:10px}.top nav a[aria-current=page]{background:#eed8ff;color:#612b9b}.top nav a:hover{background:#f0dffc}.top-controls{flex-wrap:wrap}.top-controls select,.top-controls button,.toolbar button,.toolbar select,.mini,.pill{border:1.5px solid var(--edge);border-radius:12px;background:var(--paper);color:var(--ink);padding:8px 11px;font-size:12px;font-weight:800}.top-controls button[aria-pressed=true]{background:#c9f4df;color:#315647}.hero{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding:23px 7px 17px;flex-wrap:wrap}.eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#a3338b;font-weight:900}.hero h1{margin:3px 0 5px;font-weight:1000;font-size:clamp(36px,4.3vw,68px);line-height:.98;letter-spacing:-.075em;color:#6b35a6;text-shadow:3px 4px 0 #ffc6e9}.hero h1 span{color:#f062aa}.hero p{margin:0;color:#63547c;font-size:14px;line-height:1.45}.badge{border:2px solid #fff;border-radius:20px;padding:11px 16px;background:#ffe680;box-shadow:0 5px 0 #e4a45a;font-size:12px;font-weight:900;white-space:nowrap}.layout{display:grid;grid-template-columns:minmax(300px,.88fr) minmax(340px,1.13fr) minmax(290px,.82fr);gap:17px;align-items:start}.card{background:var(--paper);border:2px solid #fff;border-radius:28px;box-shadow:0 7px 0 #d1a9dc,0 18px 42px #8d58aa25;overflow:hidden}.game{padding:18px;background:linear-gradient(160deg,#fffafd,#f7ddfc)}.section-head{justify-content:space-between;margin-bottom:10px}.section-head h2{margin:0;font-size:19px;letter-spacing:-.04em}.section-head small{color:#8d5caa;font-weight:800;font-size:11px}.stats{margin:11px 0;justify-content:space-between}.stat{background:#ffffffcc;border:1px solid #efd8f6;padding:8px 10px;border-radius:13px;min-width:30%;text-align:center}.stat b{display:block;font-size:20px;color:#733eb0;line-height:1}.stat span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#9a6bb1;font-weight:900}.board-wrap{padding:9px;border-radius:23px;background:linear-gradient(150deg,#a651cd,#6d42b5);box-shadow:inset 0 4px 8px #461c7466,0 6px 0 #5a318c}.board{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}.tile{width:100%;aspect-ratio:1;border:2px solid #ffffffb5;border-radius:clamp(10px,1.4vw,18px);box-shadow:inset 0 -5px #0002,0 3px 0 #512a7a70;display:grid;place-items:center;color:#fff;font-size:clamp(20px,2.7vw,38px);font-weight:1000;text-shadow:0 2px 1px #0003;transition:transform .12s,filter .12s}.tile:hover,.tile.selected{transform:scale(1.08);filter:brightness(1.12);z-index:1}.tile.selected{outline:3px solid #fff7a4;outline-offset:0}.tile[data-color="0"]{background:linear-gradient(145deg,#ffafca,#f14f94)}.tile[data-color="1"]{background:linear-gradient(145deg,#a9e9ff,#4c9eed)}.tile[data-color="2"]{background:linear-gradient(145deg,#ffeaa2,#f7ad3e)}.tile[data-color="3"]{background:linear-gradient(145deg,#c5f5ad,#68ca7b)}.tile[data-color="4"]{background:linear-gradient(145deg,#d9b7ff,#9860e8)}.tile[data-color="5"]{background:linear-gradient(145deg,#ffbda0,#ff7770)}.game-tip,.privacy{font-size:11px;color:#85689c;line-height:1.5;margin:12px 1px 0}.spark{min-height:65px;margin-top:14px;padding:11px 13px;background:#fff8d3;border:1px dashed #e9b863;border-radius:17px;display:flex;gap:10px;align-items:center}.spark .symbol{font-size:26px}.spark strong{display:block;font-size:11px;color:#ad6f13;text-transform:uppercase;letter-spacing:.1em}.spark span{font:italic 17px Georgia,serif;color:#644d44}.spark button{margin-left:auto;border:0;border-radius:10px;background:#ffd366;color:#68431a;padding:8px;font-size:11px;font-weight:900;white-space:nowrap}.notebook{min-height:694px;display:flex;flex-direction:column}.notebook-head{background:#fff2f9;border-bottom:2px solid #f2d9ec;padding:17px 22px}.notebook-head .eyebrow{font-size:10px}.notebook-head h2{margin:4px 0;font-size:24px;letter-spacing:-.05em}.notebook-head p{margin:0;font-size:11px;color:#806c88}.toolbar{flex-wrap:wrap;margin-top:11px}.toolbar select,.toolbar button{padding:6px 9px;font-size:11px}.page{padding:22px clamp(20px,3vw,41px);display:flex;flex-direction:column;flex:1;background:repeating-linear-gradient(transparent,transparent 36px,#dccef242 37px)}.title{border:0;background:none;width:100%;font:bold 30px/1.2 Georgia,serif;color:var(--ink);padding:5px 0 12px;outline-offset:4px}.title::placeholder,.draft::placeholder{color:#ae96b9}.draft{border:0;background:none;width:100%;resize:vertical;min-height:345px;flex:1;outline-offset:4px;font:18px/2 Georgia,serif;color:var(--ink)}.note-foot{border-top:2px solid var(--edge);padding:12px 18px;display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;font-size:11px;color:var(--soft)}.note-actions{flex-wrap:wrap}.note-actions button,.solid,.outline{border:1.5px solid var(--edge);border-radius:12px;padding:8px 11px;background:var(--paper);color:var(--ink);font-size:11px;font-weight:900}.note-actions .solid,.solid{background:#a44bd0;color:#fff;border-color:#8539aa}.rail{display:flex;flex-direction:column;gap:17px}.room,.friends{padding:17px}.room{background:linear-gradient(155deg,#fff9ff,#f9edff)}.room h2,.friends h2{margin:0;font-size:20px;letter-spacing:-.05em}.room p,.friends p{color:var(--soft);font-size:11px;line-height:1.5}.roombar{flex-wrap:wrap}.roombar button{border:1px solid #d9b6e8;border-radius:12px;background:#fff;color:#6b3d86;font-size:11px;font-weight:900;padding:8px 10px}.roombar .solid{background:#a44bd0;color:white}.room-code{font:11px ui-monospace,monospace;color:var(--soft);margin:11px 0}.friends{background:#fff9ff}.name-input,.share-form input,.chat-form input{width:100%;border:1.5px solid var(--edge);border-radius:11px;padding:9px 10px;background:var(--paper);color:var(--ink);font-size:12px;min-width:0}.name-row{display:flex;gap:8px;align-items:center;margin:9px 0}.name-row label{font-size:10px;font-weight:900;color:var(--soft)}.name-input{max-width:175px}.tabs{display:flex;gap:6px;margin:15px 0 10px}.tabs button{flex:1;border:1px solid var(--edge);background:var(--paper);border-radius:10px;padding:8px 4px;color:var(--soft);font-size:11px;font-weight:900}.tabs button[aria-selected=true]{background:#ebd3fd;color:#63318e}.feed{min-height:210px;max-height:300px;overflow:auto;display:flex;flex-direction:column;gap:8px}.entry{background:var(--glow);border-radius:12px;padding:10px 11px;overflow-wrap:anywhere;white-space:pre-wrap;font-size:12px;line-height:1.45}.entry strong{display:block;color:var(--purple);font-size:10px;margin-bottom:4px}.empty{color:var(--soft);font-size:12px;line-height:1.5;margin:25px 10px}.share-form,.chat-form{align-items:stretch;margin-top:11px}.share-form input,.chat-form input{flex:1}.share-form button,.chat-form button{border:0;border-radius:11px;background:#ff6eaa;color:#fff;font-size:11px;font-weight:900;padding:0 13px}.status{min-height:16px;font-size:11px;color:#7d489b;margin:10px 2px 0}.burst{position:fixed;pointer-events:none;z-index:20;font-weight:1000;font-size:28px;color:#ff54b0;text-shadow:0 2px 1px #fff;animation:burst .8s ease-out forwards}@keyframes burst{to{transform:translateY(-80px) scale(1.4) rotate(18deg);opacity:0}}@media(max-width:1130px){.layout{grid-template-columns:minmax(310px,1fr) minmax(330px,1.2fr)}.rail{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr}}@media(max-width:730px){.layout{display:flex;flex-direction:column}.layout>*{width:100%}.rail{display:flex}.hero{padding-top:21px}.tile{font-size:clamp(22px,7vw,40px)}.board{gap:4px}.notebook{min-height:570px}.draft{min-height:260px}}@media(prefers-reduced-motion:reduce){.tile,.burst{animation:none!important;transition:none!important}}
</style></head><body data-skin="sugar"><div class="shell"><header class="top"><a class="brand" href="/keyboard/"><span class="brand-icon">✿</span> Keyboard Bloom</a><nav aria-label="Keyboard versions"><a href="/keyboard/play/">Original</a><a href="/keyboard/garden/">Garden V2</a><a href="/keyboard/studio/">Sol Studio V3</a><a href="/keyboard/cascade/" aria-current="page">Cascade V4</a></nav><div class="top-controls"><select id="skin" aria-label="Color theme"><option value="sugar">Sugar Pop</option><option value="night">Moon Candy</option><option value="citrus">Citrus Grove</option></select><select id="voice" aria-label="Sound style"><option value="bells">Crystal bells</option><option value="pop">Bubble pop</option><option value="keys">Soft keys</option><option value="slow">Slow + reverb</option></select><button id="sound" type="button" aria-pressed="false">♫ Sound off</button></div></header><section class="hero"><div><div class="eyebrow">The playful notebook · V4</div><h1>Make ideas <span>sparkle.</span></h1><p>Write a little. Match a little. Let each move give your next thought a nudge.</p></div><div class="badge" id="mode-badge">✦ Solo playground</div></section><main class="layout"><section class="card game" aria-label="Match three idea garden"><div class="section-head"><h2>✿ Idea garden</h2><small>Swap neighbors · match 3</small></div><div class="stats"><div class="stat"><b id="score">0</b><span>sparkles</span></div><div class="stat"><b id="moves">0</b><span>moves</span></div><div class="stat"><b id="combo">—</b><span>combo</span></div></div><div class="board-wrap"><div class="board" id="board" role="grid" aria-label="Six by six match-three game"></div></div><p class="game-tip" id="game-tip">Tap a candy, then an adjacent candy. Match three to uncover a writing spark. Arrow keys move between tiles; Enter selects.</p><div class="spark"><span class="symbol">✧</span><div><strong>Writing spark</strong><span id="prompt">Make a small beginning.</span></div><button id="add-prompt" type="button">Add to note +</button></div></section><section class="card notebook" aria-label="Private notebook"><div class="notebook-head"><div class="eyebrow">Your private notebook</div><h2>Keep the good stuff.</h2><p>Autosaves in this browser. Nothing joins a room until you choose to share it.</p><div class="toolbar"><select id="note-list" aria-label="Saved notes"></select><button id="new-note" type="button">+ New note</button><button id="download" type="button">↓ Download</button></div></div><div class="page"><input id="title" class="title" maxlength="100" placeholder="Give this idea a name…" aria-label="Note title"><textarea id="draft" class="draft" maxlength="30000" placeholder="A line, a list, a dream, a very good question…" aria-label="Private note"></textarea></div><div class="note-foot"><span id="save-status" role="status">Ready for a thought.</span><div class="note-actions"><button id="copy-line" type="button">Copy note to share box</button><button id="share-note" class="solid" type="button">Share a passage →</button></div></div></section><aside class="rail"><section class="card room"><div class="section-head"><h2>✦ Play together</h2><small id="room-state">Room off</small></div><p>Invite friends into one garden. Every match changes the board for everyone; passages and chat appear together.</p><div class="roombar"><button id="create-room" class="solid" type="button">+ Make a room</button><button id="copy-invite" type="button" hidden>Copy invite</button><button id="leave-room" type="button" hidden>Leave room</button></div><div class="room-code" id="room-code">Your solo game is ready.</div><p class="privacy">Anyone with the invite can play, post passages, and chat. Shared entries remain in the room; keep personal details in your private notebook.</p></section><section class="card friends"><div class="section-head"><h2>Friends &amp; fragments</h2><small id="sync-state">Solo mode</small></div><div class="name-row"><label for="name">Your name</label><input class="name-input" id="name" maxlength="32" placeholder="Your nickname" autocomplete="nickname"></div><div class="tabs" role="tablist" aria-label="Room activity"><button id="piece-tab" role="tab" aria-selected="true" type="button">Shared piece</button><button id="chat-tab" role="tab" aria-selected="false" type="button">Chat</button></div><div class="feed" id="feed" aria-live="polite"></div><form id="entry-form" class="share-form"><input id="entry-text" maxlength="1200" aria-label="Passage to share" placeholder="Add a line to the piece…"><button type="submit">Add</button></form><div class="status" id="status" role="status"></div></section></aside></main></div><script type="module" is:inline>
import { seededBoard, applyMove, hasMove, PROMPTS, SIZE } from '/keyboard-cascade-game.js';
const $=id=>document.getElementById(id),STORE='pointcast.keyboard.cascade.v4',PREF='pointcast.keyboard.cascade.prefs';
const icons=['♥','◆','✦','✿','☾','●']; let game=seededBoard(),selected=-1,room='',token='',tab='fragment',fragments=[],messages=[],noteId='',notes=[],lastVersion=-1,polling=false,loading=false,audio,master,delay,sound=false,voice='bells',lastType=0;
function read(key,fallback){try{return JSON.parse(localStorage.getItem(key))??fallback}catch{return fallback}}function persist(){try{localStorage.setItem(STORE,JSON.stringify({notes,noteId,soloGame:room?undefined:game}))}catch{$('save-status').textContent='Browser storage is full. Download your note.'}}function prefs(){try{localStorage.setItem(PREF,JSON.stringify({skin:document.body.dataset.skin,voice,sound,name:$('name').value}))}catch{}}
const saved=read(STORE,{});notes=Array.isArray(saved.notes)?saved.notes.filter(n=>n&&typeof n.id==='string'&&typeof n.text==='string').slice(0,60):[];if(saved.soloGame&&Array.isArray(saved.soloGame.board)&&saved.soloGame.board.length===36)game=saved.soloGame;if(!notes.length)notes=[{id:crypto.randomUUID(),title:'',text:'',at:Date.now()}];noteId=notes.some(n=>n.id===saved.noteId)?saved.noteId:notes[0].id;const savedPrefs=read(PREF,{});document.body.dataset.skin=['sugar','night','citrus'].includes(savedPrefs.skin)?savedPrefs.skin:'sugar';$('skin').value=document.body.dataset.skin;voice=['bells','pop','keys','slow'].includes(savedPrefs.voice)?savedPrefs.voice:'bells';$('voice').value=voice;sound=!!savedPrefs.sound;$('name').value=typeof savedPrefs.name==='string'?savedPrefs.name.slice(0,32):'';
function toast(s){$('status').textContent=s}function renderNotes(){const list=$('note-list');list.replaceChildren();for(const n of notes){const o=document.createElement('option');o.value=n.id;o.textContent=n.title||'Untitled note';list.append(o)}list.value=noteId;const n=notes.find(n=>n.id===noteId);$('title').value=n?.title||'';$('draft').value=n?.text||'';saveLabel()}
function saveLabel(){const n=notes.find(n=>n.id===noteId);$('save-status').textContent=(n?.text?.trim().split(/\s+/).filter(Boolean).length||0)+' words · saved here';}
function saveNote(){const n=notes.find(n=>n.id===noteId);if(!n)return;n.title=$('title').value;n.text=$('draft').value;n.at=Date.now();persist();saveLabel();const option=$('note-list').selectedOptions[0];if(option)option.textContent=n.title||'Untitled note'}
$('note-list').onchange=()=>{saveNote();noteId=$('note-list').value;renderNotes();persist()};$('new-note').onclick=()=>{saveNote();const n={id:crypto.randomUUID(),title:'',text:'',at:Date.now()};notes.unshift(n);noteId=n.id;renderNotes();persist();$('title').focus()};
function download(){const n=notes.find(n=>n.id===noteId);const data='# '+(n.title||'Untitled')+'\n\n'+n.text+'\n';const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([data],{type:'text/markdown'}));link.download=(n.title||'cascade-note').replace(/[^a-z0-9_-]+/gi,'-').slice(0,50)+'.md';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),30000)}$('download').onclick=download;
function setupAudio(){if(audio)return true;try{audio=new (window.AudioContext||window.webkitAudioContext)();master=audio.createGain();master.gain.value=.21;const limiter=audio.createDynamicsCompressor();limiter.threshold.value=-18;limiter.ratio.value=3;master.connect(limiter);limiter.connect(audio.destination);delay=audio.createDelay(1.5);delay.delayTime.value=voice==='slow'?.53:.24;const feedback=audio.createGain();feedback.gain.value=voice==='slow'?.46:.24;delay.connect(feedback);feedback.connect(delay);const wet=audio.createGain();wet.gain.value=.24;delay.connect(wet);wet.connect(master);return true}catch{toast('Sound is unavailable in this browser.');return false}}
function tone(degree=0,accent=false){if(!sound||!setupAudio())return;audio.resume();const t=audio.currentTime,scale=[0,2,4,7,9,12,14,16],freq=220*Math.pow(2,scale[Math.abs(degree)%8]/12),g=audio.createGain(),duration=voice==='slow'?1.35:voice==='pop'?.23:.65;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(accent?.29:.12,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+duration);g.connect(master);if(voice==='slow'||voice==='bells')g.connect(delay);const osc=audio.createOscillator();osc.type=voice==='pop'?'triangle':voice==='keys'?'sine':'sine';osc.frequency.value=freq;osc.connect(g);osc.start(t);osc.stop(t+duration+.02);if(voice==='bells'){const o=audio.createOscillator(),h=audio.createGain();o.type='sine';o.frequency.value=freq*2.02;h.gain.value=.2;o.connect(h);h.connect(g);o.start(t);o.stop(t+duration+.02)}}
$('sound').onclick=()=>{sound=!sound;prefs();$('sound').setAttribute('aria-pressed',String(sound));$('sound').textContent=sound?'♫ Sound on':'♫ Sound off';if(sound)tone(4,true)};$('sound').setAttribute('aria-pressed',String(sound));$('sound').textContent=sound?'♫ Sound on':'♫ Sound off';$('skin').onchange=()=>{document.body.dataset.skin=$('skin').value;prefs()};$('voice').onchange=()=>{voice=$('voice').value;if(delay)delay.delayTime.setTargetAtTime(voice==='slow'?.53:.24,audio.currentTime,.05);prefs();tone(3)};$('name').oninput=prefs;
function renderGame(){const host=$('board');host.replaceChildren();for(let i=0;i<36;i++){const tile=document.createElement('button');tile.type='button';tile.className='tile'+(i===selected?' selected':'');tile.dataset.color=String(game.board[i]);tile.textContent=icons[game.board[i]];tile.setAttribute('role','gridcell');tile.setAttribute('aria-label',`Row ${Math.floor(i/SIZE)+1}, column ${i%SIZE+1}, ${['heart','gem','star','flower','moon','dot'][game.board[i]]}${i===selected?', selected':''}`);tile.setAttribute('aria-selected',String(i===selected));tile.onclick=()=>choose(i);tile.onkeydown=e=>{let j=i;if(e.key==='ArrowRight'&&i%SIZE<5)j++;if(e.key==='ArrowLeft'&&i%SIZE>0)j--;if(e.key==='ArrowDown'&&i<30)j+=SIZE;if(e.key==='ArrowUp'&&i>=SIZE)j-=SIZE;if(j!==i){e.preventDefault();host.children[j].focus()}};host.append(tile)}$('score').textContent=game.score.toLocaleString();$('moves').textContent=game.moves;$('combo').textContent=game.combo>1?'×'+game.combo:'—';$('prompt').textContent=game.moves?PROMPTS[game.promptIndex]:'Make a small beginning.'}
function burst(index,word){if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const tile=$('board').children[index],r=tile.getBoundingClientRect(),b=document.createElement('span');b.className='burst';b.textContent=word;b.style.left=r.left+'px';b.style.top=r.top+'px';document.body.append(b);setTimeout(()=>b.remove(),850)}
async function choose(i){if(selected<0){selected=i;renderGame();$('board').children[i].focus();tone(i%8);return}const a=selected;selected=-1;if(a===i){renderGame();return}if(room){try{const result=await post({kind:'move',a,b:i});if(result.game){game=result.game;lastVersion=game.version;renderGame();burst(i,'+'+result.game.cleared*10);tone(game.combo+2,true);toast('A match! Your friends see it too.')}else{renderGame();toast('Try a neighboring match.')}}catch(e){renderGame();toast(e.message||'Move did not sync.')}}else{const moved=applyMove(game,a,i);if(!moved){renderGame();toast('No match there. Try another swap.');tone(1);return}game=moved;if(!hasMove(game.board))game=seededBoard(game.seed);persist();renderGame();burst(i,'+'+moved.cleared*10);tone(game.combo+2,true);toast(game.combo>1?'Sweet chain! A new writing spark appeared.':'Nice match! A new writing spark appeared.')}}
$('add-prompt').onclick=()=>{const text=$('prompt').textContent;const draft=$('draft');draft.value+=(draft.value.trim()?'\n\n':'')+text+' — ';saveNote();draft.focus();draft.setSelectionRange(draft.value.length,draft.value.length);tone(6,true)};
function typing(e){saveNote();if(e.inputType==='insertText'&&e.data&&e.data.length===1&&Date.now()-lastType>45){lastType=Date.now();tone(e.data.toLowerCase().charCodeAt(0)%8)}}$('title').addEventListener('input',typing);$('draft').addEventListener('input',typing);
function invite(){const u=new URL(location.href);u.searchParams.set('room',room);u.searchParams.set('token',token);return u.href}function query(){return new URLSearchParams({room,token})}async function post(input){if(!room)throw Error('Make or join a room first.');const response=await fetch('/api/keyboard-cascade?'+query(),{method:'POST',headers:{'content-type':'application/json','accept':'application/json'},body:JSON.stringify(input)});const data=await response.json();if(!response.ok)throw Error(data.error==='rate-limited'?'A little pause, then try again.':data.error==='room-full'?'This room is full. Start a new one.':data.error==='no-match'?'That swap did not match.':data.error||'Room unavailable');return data}
function setRoom(id,t){room=id;token=t;const u=new URL(location.href);u.searchParams.set('room',id);u.searchParams.set('token',t);history.replaceState(null,'',u);$('create-room').hidden=true;$('copy-invite').hidden=false;$('leave-room').hidden=false;$('room-state').textContent='Room live';$('sync-state').textContent='Syncing…';$('room-code').textContent='Room '+id.slice(0,8)+' · invite link required';$('mode-badge').textContent='✦ Playing together';refresh()}
$('create-room').onclick=async()=>{const b=$('create-room');b.disabled=true;try{const r=await fetch('/api/keyboard-cascade?action=create',{method:'POST',headers:{accept:'application/json'}}),data=await r.json();if(!r.ok||!data.room||!data.token)throw Error(data.error||'Could not create room');setRoom(data.room,data.token);toast('Room ready. Copy the invite and bring friends in.')}catch(e){toast(e.message||'Could not create room.')}finally{b.disabled=false}};
$('copy-invite').onclick=async()=>{try{await navigator.clipboard.writeText(invite());toast('Invite copied. Send it to a friend.')}catch{window.prompt('Copy this invite',invite())}};
$('leave-room').onclick=()=>{room='';token='';fragments=[];messages=[];lastVersion=-1;const u=new URL(location.href);u.searchParams.delete('room');u.searchParams.delete('token');history.replaceState(null,'',u);game=seededBoard();persist();$('create-room').hidden=false;$('copy-invite').hidden=true;$('leave-room').hidden=true;$('room-state').textContent='Room off';$('sync-state').textContent='Solo mode';$('room-code').textContent='Your solo game is ready.';$('mode-badge').textContent='✦ Solo playground';renderGame();renderFeed();toast('You left the room. The invite still works.')};
async function refresh(){if(!room||polling||document.hidden)return;polling=true;const id=room;try{const r=await fetch('/api/keyboard-cascade?'+query(),{cache:'no-store'}),data=await r.json();if(!r.ok)throw Error(data.error||'Room unavailable');if(id!==room)return;const changed=data.game.version!==lastVersion;if(changed){game=data.game;lastVersion=game.version;renderGame();if(game.moves)tone(game.combo+1,true)}fragments=data.fragments||[];messages=data.messages||[];renderFeed();$('sync-state').textContent='Together · '+(fragments.length+messages.length)+' posts'}catch(e){$('sync-state').textContent='Reconnect needed';toast('Room connection paused. Your private note is safe.')}finally{polling=false}}
function renderFeed(){const host=$('feed');host.replaceChildren();const entries=tab==='fragment'?fragments:messages;if(!room){const p=document.createElement('p');p.className='empty';p.textContent='Make or join a room to write and chat with friends.';host.append(p);return}if(!entries.length){const p=document.createElement('p');p.className='empty';p.textContent=tab==='fragment'?'The shared piece is waiting for its first line.':'Say hello to your friends.';host.append(p);return}for(const entry of entries){const e=document.createElement('div');e.className='entry';const who=document.createElement('strong');who.textContent=entry.name+' · '+new Date(entry.at).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'});const words=document.createElement('span');words.textContent=entry.text;e.append(who,words);host.append(e)}}
function setTab(kind){tab=kind;$('piece-tab').setAttribute('aria-selected',String(kind==='fragment'));$('chat-tab').setAttribute('aria-selected',String(kind==='message'));$('entry-text').placeholder=kind==='fragment'?'Add a line to the piece…':'Say something to your friends…';$('entry-text').maxLength=kind==='fragment'?1200:500;$('entry-form').lastElementChild.textContent=kind==='fragment'?'Add':'Send';renderFeed()};$('piece-tab').onclick=()=>setTab('fragment');$('chat-tab').onclick=()=>setTab('message');
$('entry-form').onsubmit=async e=>{e.preventDefault();const name=$('name').value.trim(),text=$('entry-text').value.trim();if(!name){toast('Add your nickname first.');$('name').focus();return}if(!text)return;const button=$('entry-form').lastElementChild;button.disabled=true;try{await post({kind:tab,name,text,clientId:crypto.randomUUID()});$('entry-text').value='';await refresh();toast(tab==='fragment'?'Your line joined the piece.':'Message sent.');tone(7,true)}catch(error){toast(error.message||'Could not send.')}finally{button.disabled=false}};
$('copy-line').onclick=()=>{const text=$('draft').value.trim();if(!text){toast('Write a private note first.');return}setTab('fragment');$('entry-text').value=text.slice(0,1200);$('entry-text').focus();toast('Copied to the share box. Press Add when you want friends to see it.')};$('share-note').onclick=()=>{if(!room){toast('Make or join a room first.');return}$('copy-line').click();$('entry-text').scrollIntoView({block:'nearest',behavior:'smooth'})};
renderNotes();renderGame();renderFeed();const params=new URL(location.href).searchParams,id=params.get('room'),t=params.get('token');if(id&&t&&/^[0-9a-f]{32}$/.test(id)&&/^[0-9a-f]{64}$/.test(t))setRoom(id,t);else if(id||t)toast('This invite link is not valid.');setInterval(refresh,1500);document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh()});
</script></body></html>
