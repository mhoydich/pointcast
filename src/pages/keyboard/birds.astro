---
const title = 'Backyard Birds · PointCast';
const description = 'Six Southern California bird calls made with your keyboard. Play a little dawn chorus, then let the mockingbird learn your phrase.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/birds">
<meta property="og:title" content="Backyard Birds">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}body{margin:0;min-width:0;min-height:100vh;background:radial-gradient(ellipse at 80% 0%,#244b3655,transparent 42%),radial-gradient(ellipse at 16% 100%,#1d4a5544,transparent 44%),var(--bg);color:var(--ink);overflow-x:hidden}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:9px 15px;cursor:pointer;font-size:11px;min-height:44px;touch-action:manipulation}button:hover{background:#1e2b20;border-color:#688777}button[aria-pressed=true],button.primary{background:var(--fern);border-color:var(--fern);color:var(--bg)}button.primary{background:var(--sun);border-color:var(--sun)}button:focus-visible{outline:2px solid var(--sun);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}.brand{margin:0;font:normal 30px/1 Georgia,serif;letter-spacing:-1px}.brand:before{content:'✳';color:var(--sun);margin-right:12px}.brand small{display:block;margin:6px 0 0 44px;font:9px/1.2 ui-monospace,monospace;letter-spacing:.2em;color:var(--dim);text-transform:uppercase}nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:1040px;margin:0 auto;padding:23px 20px 64px}.intro{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start;margin-bottom:16px}.kicker,.label{font-size:9px;letter-spacing:.18em;color:var(--fern);text-transform:uppercase}.intro h2{font:normal clamp(30px,5vw,52px)/.96 Georgia,serif;letter-spacing:-1.6px;margin:7px 0 10px}.intro p{max-width:600px;margin:0;color:var(--dim);font:16px/1.55 Georgia,serif}.tools{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.hint,.field,.list{border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,#16251a,#101b14);padding:12px 14px}.hint{font-size:11px;line-height:1.65;color:var(--dim);margin:0 0 16px}.hint b{color:var(--sun);font-weight:normal}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.bird{position:relative;isolation:isolate;min-width:0;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#19281c,#101914);overflow:hidden;transition:transform .2s,border-color .2s,box-shadow .2s}.bird.calling{border-color:var(--bird);box-shadow:0 0 0 1px color-mix(in srgb,var(--bird) 35%,transparent),0 14px 32px #0005;animation:bob .44s ease-in-out 2}.bird .art{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;mix-blend-mode:screen;opacity:.9;border-bottom:1px solid #304132}.bird button.cardplay{display:block;width:100%;min-height:58px;border:0;border-radius:0;padding:10px 12px;text-align:left;background:transparent}.bird button.cardplay:hover{background:color-mix(in srgb,var(--bird) 12%,transparent)}.name{display:flex;align-items:baseline;gap:7px;font:20px/1 Georgia,serif}.key{margin-left:auto;flex:none;color:var(--bird);font:10px ui-monospace,monospace;border:1px solid color-mix(in srgb,var(--bird) 60%,transparent);padding:3px 6px;border-radius:12px}.call{display:block;margin-top:4px;color:var(--dim);font:10px/1.3 ui-monospace,monospace}.learn{display:flex;align-items:center;gap:6px;margin:0 11px 11px;padding:7px 10px;min-height:38px;border-color:color-mix(in srgb,var(--petal) 50%,var(--line));font-size:9px}.learn b{font-weight:normal;color:var(--petal)}
.lower{display:grid;grid-template-columns:1.05fr .95fr;gap:12px;margin-top:16px}.field p,.list p{font:15px/1.5 Georgia,serif;margin:6px 0 0;color:#d4d8c9}.life{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px;min-height:34px}.life span{border:1px solid var(--line);border-radius:18px;padding:6px 9px;font-size:10px;color:var(--fern)}.life .empty{border:0;padding:5px 0;color:var(--dim)}#notice{display:block;min-height:18px;margin-top:12px;color:var(--sun);font-size:10px;line-height:1.45}.dawn{position:relative;overflow:hidden}.dawn:after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 32%,#fff3 50%,transparent 68%);transform:translateX(-130%);pointer-events:none}.dawn.playing:after{animation:sunrise 1.5s ease-in-out infinite}
.learn{min-height:44px}@keyframes bob{0%,100%{transform:translateY(0) rotate(0)}35%{transform:translateY(-5px) rotate(-1deg)}70%{transform:translateY(2px) rotate(1.2deg)}}@keyframes sunrise{to{transform:translateX(130%)}}body.paused .bird.calling,body.paused .dawn:after{animation-play-state:paused}@media(max-width:720px){header{padding:15px}.intro{grid-template-columns:1fr}.tools{justify-content:flex-start}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.lower{grid-template-columns:1fr}}@media(max-width:420px){main{padding:18px 13px 48px}.brand small{margin-left:0}.cards{gap:8px}.bird .name{font-size:17px}.bird button.cardplay{padding:9px}.learn{margin:0 8px 8px}.intro h2{font-size:35px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Backyard Birds<small>Six calls from an El Segundo fence</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="tools"><button type="button" id="sound" aria-pressed="true">♪ Sound on</button></div>
</header>
<main>
  <section class="intro" aria-labelledby="title">
    <div><span class="kicker">Nature Wing · call book 01</span><h2 id="title">A small chorus<br>at the fence.</h2><p>Press the home row or tap a bird. Make a phrase, then ask the mockingbird to remember it.</p></div>
    <div class="tools"><button type="button" class="primary dawn" id="dawn">☼ Dawn chorus</button><button type="button" id="mock" aria-label="Ask the mockingbird to replay the learned medley">M · Learned song</button></div>
  </section>
  <p class="hint" id="hint"><b>First walk:</b> play two or more birds, then press <b>M</b>. The mockingbird keeps the last eight calls and answers in its own looping little language. Other letter keys make variations.</p>
  <section class="cards" id="cards" aria-label="Bird call cards">
    <article class="bird" style="--bird:#c6c9be"><img class="art" src="/images/keyboard/birds/mockingbird.jpg" width="426" height="640" alt="A Northern Mockingbird perched on a twig against deep green"><button type="button" class="cardplay" data-bird="0"><span class="name">Northern Mockingbird <span class="key">A</span></span><span class="call">repeated bright phrases</span></button><button type="button" class="learn" data-learn><b>M</b> sing back what I heard</button></article>
    <article class="bird" style="--bird:#6fb3b8"><img class="art" src="/images/keyboard/birds/scrub-jay.jpg" width="426" height="640" alt="A California Scrub-Jay perched on a twig against deep green"><button type="button" class="cardplay" data-bird="1"><span class="name">California Scrub-Jay <span class="key">S</span></span><span class="call">a rough rising shreep</span></button></article>
    <article class="bird" style="--bird:#e7a3b3"><img class="art" src="/images/keyboard/birds/hummingbird.jpg" width="426" height="640" alt="An Anna's Hummingbird perched on a twig against deep green"><button type="button" class="cardplay" data-bird="2"><span class="name">Anna's Hummingbird <span class="key">D</span></span><span class="call">high buzzy squeaks</span></button></article>
    <article class="bird" style="--bird:#8a6a4a"><img class="art" src="/images/keyboard/birds/towhee.jpg" width="426" height="640" loading="lazy" alt="A California Towhee perched on a twig against deep green"><button type="button" class="cardplay" data-bird="3"><span class="name">California Towhee <span class="key">F</span></span><span class="call">one metallic chink</span></button></article>
    <article class="bird" style="--bird:#f2c14e"><img class="art" src="/images/keyboard/birds/house-finch.jpg" width="426" height="640" loading="lazy" alt="A House Finch perched on a twig against deep green"><button type="button" class="cardplay" data-bird="4"><span class="name">House Finch <span class="key">G</span></span><span class="call">a warbling tumble</span></button></article>
    <article class="bird" style="--bird:#b5a8ee"><img class="art" src="/images/keyboard/birds/mourning-dove.jpg" width="426" height="640" loading="lazy" alt="A Mourning Dove perched on a twig against deep green"><button type="button" class="cardplay" data-bird="5"><span class="name">Mourning Dove <span class="key">H</span></span><span class="call">soft hoo-OO-oo-oo-oo</span></button></article>
  </section>
  <section class="lower">
    <aside class="field"><span class="label">Field note</span><p>Northern Mockingbirds are known for mimicking the songs of other birds, and males may learn many different song types; the exact number varies by individual and place.</p></aside>
    <aside class="list"><span class="label">Today's birding list</span><p id="listLead">Calls you have heard today.</p><div class="life" id="life" aria-live="polite"></div></aside>
  </section>
  <span id="notice" role="status" aria-live="polite"></span>
</main>
<script is:inline src="/keyboard.js" data-app="keyboard-birds" async></script>
<script is:inline>
(function () {
  'use strict';
  var STORE = 'pc-birds-v1';
  var KEYS = ['a', 's', 'd', 'f', 'g', 'h'];
  var BIRDS = [
    { name: 'Northern Mockingbird', mids: [74, 77, 74, 81], color: '#c6c9be' },
    { name: 'California Scrub-Jay', mids: [62, 66, 71], color: '#6fb3b8' },
    { name: "Anna's Hummingbird", mids: [88, 91, 86], color: '#e7a3b3' },
    { name: 'California Towhee', mids: [67, 73], color: '#8a6a4a' },
    { name: 'House Finch', mids: [70, 74, 77, 75, 80], color: '#f2c14e' },
    { name: 'Mourning Dove', mids: [57, 62, 59, 57], color: '#b5a8ee' }
  ];
  var $ = function (s) { return document.querySelector(s); };
  var $$ = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };
  var state = { day: '', list: [], recent: [], seen: false, sound: true };
  var audioContext = null, master = null, soundOn = true, hidden = document.hidden;
  var signalNotes = [], signalTimer = null, visualTimers = [], dawnTimers = [], dawnActive = false;
  var lastAt = 0;
  function today() { return new Date().toISOString().slice(0, 10); }
  function save() { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch (e) {} }
  function load() {
    try { var raw = JSON.parse(localStorage.getItem(STORE) || 'null'); if (raw && typeof raw === 'object') state = Object.assign(state, raw); } catch (e) {}
    if (!Array.isArray(state.list)) state.list = []; if (!Array.isArray(state.recent)) state.recent = [];
    if (state.day !== today()) { state.day = today(); state.list = []; state.recent = []; save(); }
    soundOn = state.sound !== false;
  }
  function notice(message) { $('#notice').textContent = message; }
  function paint() {
    $('#sound').setAttribute('aria-pressed', String(soundOn));
    $('#sound').textContent = soundOn ? '♪ Sound on' : '♪ Sound off';
    $('#hint').hidden = !!state.seen;
    var life = $('#life'); life.innerHTML = '';
    if (!state.list.length) { var empty = document.createElement('span'); empty.className = 'empty'; empty.textContent = 'No calls yet — the yard is waiting.'; life.appendChild(empty); return; }
    state.list.forEach(function (entry) { var chip = document.createElement('span'); chip.textContent = entry.name + ' ×' + entry.count; life.appendChild(chip); });
  }
  function context() {
    if (!audioContext) {
      audioContext = new (window.AudioContext || window.webkitAudioContext)();
      master = audioContext.createGain(); master.gain.value = soundOn ? 0.28 : 0.0001;
      var compressor = audioContext.createDynamicsCompressor(); compressor.threshold.value = -20; compressor.knee.value = 18; compressor.ratio.value = 8; compressor.attack.value = 0.008; compressor.release.value = 0.18;
      master.connect(compressor).connect(audioContext.destination);
    }
    if (audioContext.state === 'suspended') audioContext.resume();
    return audioContext;
  }
  function hz(midi) { return 440 * Math.pow(2, (midi - 69) / 12); }
  function chirp(startMidi, endMidi, when, duration, amp, buzz) {
    if (!soundOn) return;
    var c = context(), carrier = c.createOscillator(), gain = c.createGain(), mod = c.createOscillator(), depth = c.createGain();
    carrier.type = buzz ? 'sawtooth' : 'sine'; carrier.frequency.setValueAtTime(hz(startMidi), when); carrier.frequency.exponentialRampToValueAtTime(Math.max(20, hz(endMidi)), when + duration);
    mod.type = 'sine'; mod.frequency.value = buzz ? 74 : 15; depth.gain.value = buzz ? 44 : 14; mod.connect(depth).connect(carrier.frequency);
    gain.gain.setValueAtTime(0.0001, when); gain.gain.exponentialRampToValueAtTime(amp, when + Math.min(.015, duration * .16)); gain.gain.exponentialRampToValueAtTime(.0001, when + duration);
    carrier.connect(gain).connect(master); mod.start(when); carrier.start(when); mod.stop(when + duration + .03); carrier.stop(when + duration + .03);
  }
  function phrase(index, variation, start, level) {
    var v = (variation || 0) % 3, t = start, a = level == null ? 1 : level;
    if (index === 0) { [[74,78,.11],[74,78,.11],[70,74,.12],[70,74,.12],[79,83,.14],[79,83,.14]].forEach(function (p, i) { chirp(p[0] + v, p[1] + v, t + i * .17, p[2], .09 * a, false); }); return .98; }
    if (index === 1) { chirp(62 + v, 69 + v, t, .24, .11 * a, true); chirp(68 + v, 72 + v, t + .27, .13, .06 * a, true); return .56; }
    if (index === 2) { [0,.09,.18,.32].forEach(function (x, i) { chirp(87 + ((i + v) % 2) * 3, 91 + ((i + v) % 2) * 2, t + x, .07, .055 * a, true); }); return .48; }
    if (index === 3) { chirp(67 + v, 74 + v, t, .11, .12 * a, true); return .32; }
    if (index === 4) { [[70,74],[74,77],[77,73],[73,80],[80,76]].forEach(function (p, i) { chirp(p[0] + v, p[1] + v, t + i * .105, .09, .075 * a, false); }); return .64; }
    [[57,57,.22],[57,62,.30],[62,59,.23],[59,57,.2],[57,55,.18]].forEach(function (p, i) { chirp(p[0] + v, p[1] + v, t + i * .28, p[2], .08 * a, false); }); return 1.48;
  }
  function flash(index, delay) {
    var card = $$('.bird')[index], timer = setTimeout(function () { if (!hidden) { card.classList.remove('calling'); void card.offsetWidth; card.classList.add('calling'); setTimeout(function () { card.classList.remove('calling'); }, 900); } }, delay || 0);
    visualTimers.push(timer);
  }
  function queueSignal(index) {
    Array.prototype.push.apply(signalNotes, BIRDS[index].mids);
    if (!signalTimer) signalTimer = setTimeout(flushSignal, 5100);
  }
  function flushSignal() {
    signalTimer = null;
    if (!signalNotes.length) return;
    var batch = signalNotes.splice(0, 60);
    if (window.PointCastKeyboard && window.PointCastKeyboard.note) window.PointCastKeyboard.note(batch, null, { sound: false });
    if (signalNotes.length) signalTimer = setTimeout(flushSignal, 5100);
  }
  function hear(index, at) {
    state.seen = true;
    var found = state.list.filter(function (entry) { return entry.name === BIRDS[index].name; })[0];
    if (found) found.count += 1; else state.list.push({ name: BIRDS[index].name, count: 1 });
    var gap = lastAt ? Math.max(.16, Math.min(1.25, (at - lastAt) / 1000)) : .34; lastAt = at;
    state.recent.push({ bird: index, gap: gap }); if (state.recent.length > 8) state.recent.shift(); save(); paint();
  }
  function playBird(index, variation, source) {
    var now = Date.now(), c = soundOn ? context() : null, when = c ? c.currentTime + .025 : 0;
    phrase(index, variation, when, source === 'dawn' ? .48 : 1); flash(index, 0); queueSignal(index);
    if (source !== 'learned') hear(index, now);
    if (source !== 'dawn') notice(BIRDS[index].name + ' called.');
  }
  function learnedSong() {
    if (!state.recent.length) { notice('The mockingbird is listening. Play a few birds first.'); return; }
    var c = soundOn ? context() : null, start = c ? c.currentTime + .05 : 0, offset = 0;
    state.recent.forEach(function (entry, i) {
      var repeats = 2 + (i % 2), j;
      for (j = 0; j < repeats; j++) { var d = phrase(entry.bird, i + j, start + offset, .7); flash(entry.bird, Math.round(offset * 1000)); queueSignal(entry.bird); offset += d + .08; }
      offset += Math.min(.55, entry.gap);
    });
    chirp(81, 88, start + offset, .38, .07, false); flash(0, Math.round(offset * 1000));
    state.seen = true; save(); paint(); notice('The mockingbird repeats your little route through the yard.');
  }
  function dawnChorus() {
    if (dawnActive) return;
    dawnActive = true; $('#dawn').classList.add('playing'); notice('The hedge is waking up.');
    var sequence = [5, 2, 4, 0, 3, 1, 2, 0, 4, 5], step = 0;
    function next() {
      if (hidden || step >= sequence.length) { dawnActive = false; $('#dawn').classList.remove('playing'); if (!hidden) notice('Dawn settles back into the street.'); return; }
      playBird(sequence[step], step, 'dawn'); step += 1; dawnTimers.push(setTimeout(next, 380 + (step % 3) * 120));
    }
    next();
  }
  function keydown(event) {
    if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
    var tag = document.activeElement && document.activeElement.tagName; if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
    var key = event.key.toLowerCase();
    if (key === 'm') { event.preventDefault(); learnedSong(); return; }
    var base = KEYS.indexOf(key); if (base >= 0) { event.preventDefault(); playBird(base, 0, 'manual'); return; }
    if (/^[a-z]$/.test(key)) { event.preventDefault(); var code = key.charCodeAt(0) - 97; playBird(code % 6, 1 + Math.floor(code / 6) % 2, 'manual'); }
  }
  function setSound() { soundOn = !soundOn; state.sound = soundOn; if (audioContext) master.gain.setTargetAtTime(soundOn ? .28 : .0001, audioContext.currentTime, .025); save(); paint(); notice(soundOn ? 'Sound on. The fence is close enough to hear.' : 'Sound off. The cards still remember.'); }
  load(); paint();
  $$('.cardplay').forEach(function (button) { button.addEventListener('click', function () { playBird(Number(button.dataset.bird), 0, 'manual'); }); });
  $$('[data-learn]').forEach(function (button) { button.addEventListener('click', learnedSong); });
  $('#mock').addEventListener('click', learnedSong); $('#dawn').addEventListener('click', dawnChorus); $('#sound').addEventListener('click', setSound); window.addEventListener('keydown', keydown);
  document.addEventListener('visibilitychange', function () { hidden = document.hidden; document.body.classList.toggle('paused', hidden); if (hidden) { dawnTimers.forEach(clearTimeout); dawnTimers = []; dawnActive = false; $('#dawn').classList.remove('playing'); } });
  window.addEventListener('pagehide', function () { if (signalTimer) { clearTimeout(signalTimer); flushSignal(); } save(); });
}());
</script>
</body>
</html>
