---
const title = 'Tree Rings · PointCast';
const description =
  'Play a short tune each day and grow it into a living tree. Hear the year play outward from the heartwood.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/rings">
<meta property="og:title" content="Tree Rings">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 78% 0%,#35472e55,transparent 42%),var(--bg);color:var(--ink);min-height:100vh}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:9px 15px;cursor:pointer;font-size:11px;min-height:44px;touch-action:manipulation}
button:hover{background:#1e2b20;border-color:#688777}
button[aria-pressed=true]{background:var(--gold);color:var(--bg);border-color:var(--gold)}
button.primary{background:var(--gold);border-color:var(--gold);color:var(--bg)}
button:disabled{opacity:.45;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px;min-height:44px;display:flex;align-items:center}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}
main{max-width:1000px;margin:0 auto;padding:22px 20px 64px;display:flex;flex-direction:column;gap:16px}
.intro{display:flex;align-items:end;justify-content:space-between;gap:20px;flex-wrap:wrap}
.eyebrow,.label{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim)}
.eyebrow{margin:0 0 7px}
h2{font:normal 27px/1.1 Georgia,serif;letter-spacing:-.5px;margin:0;color:var(--ink)}
.intro p:last-child{max-width:600px;color:var(--dim);font-size:12px;line-height:1.65;margin:9px 0 0}
.hint{font-size:11px;color:var(--dim);line-height:1.7;margin:0;background:#122018;border:1px solid var(--line);border-radius:12px;padding:10px 14px}
.hint b{color:var(--gold);font-weight:normal}
.hint code{color:var(--ink)}
.layout{display:grid;grid-template-columns:minmax(0,1.16fr) minmax(300px,.84fr);gap:16px;align-items:start}
.card{background:linear-gradient(155deg,#1d2c20,#111d16);border:1px solid var(--line);border-radius:16px;padding:16px 18px}
.tree-card{padding:14px 14px 16px;overflow:hidden}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:0 4px 8px}
.card-head h2{font-size:19px}
.count{font-size:10px;color:var(--dim);white-space:nowrap}
.tree-wrap{position:relative;width:min(100%,610px);margin:0 auto}
#tree{display:block;width:100%;height:auto;overflow:visible}
#tree .ring{cursor:pointer;outline:none}
#tree .ring path.main{transition:stroke .2s ease,stroke-width .2s ease,filter .2s ease}
#tree .ring:hover path.main,#tree .ring:focus path.main{stroke:#fff2bd;filter:url(#ringGlow)}
#tree .ring.glow path.main{stroke:#fff1b1;filter:url(#ringGlow)}
#tree .scar{fill:none;stroke:#522d29;stroke-linecap:round;opacity:.92}
#tree .playhead{fill:none;stroke:var(--petal);stroke-width:2;stroke-dasharray:2 8;opacity:.9;pointer-events:none}
.tree-empty{position:absolute;inset:20% 15%;display:flex;align-items:center;justify-content:center;text-align:center;pointer-events:none;color:var(--dim);font:16px/1.45 Georgia,serif;transition:opacity .2s ease}
.tree-empty[hidden]{opacity:0}
.tree-caption{min-height:27px;text-align:center;color:var(--dim);font-size:10px;line-height:1.55;margin:0 16px}
.tree-caption strong{color:var(--gold);font-weight:normal}
.right{display:flex;flex-direction:column;gap:16px}
.today-head{display:flex;justify-content:space-between;align-items:start;gap:10px}
.today-head h2{font-size:21px}
.date{font:18px Georgia,serif;color:var(--gold);margin-top:4px}
.season{font-size:10px;color:var(--dim);text-align:right;padding-top:4px}
.season i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--season);margin-right:5px}
.draft{margin:15px 0 13px;min-height:32px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.draft .empty{font-size:11px;color:#5f7563}
.note-dot{width:25px;height:25px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);font-size:10px;color:var(--ink);background:#213526}
.note-dot.scar{border-color:var(--petal);color:var(--petal)}
.key-label{display:flex;justify-content:space-between;gap:8px;align-items:center;margin:0 0 7px}
.key-label .small{font-size:9px;color:var(--dim)}
.keys{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
.key{border-radius:10px;min-height:51px;padding:6px 3px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:#18281c}
.key kbd{font:15px Georgia,serif;color:var(--ink)}
.key small{font-size:8px;color:var(--dim)}
.key.hit{background:var(--fern);color:var(--bg);border-color:var(--fern);transform:translateY(1px)}
.key.hit kbd,.key.hit small{color:var(--bg)}
.key.special{grid-column:span 2;background:#33242d;border-color:#694354;color:var(--petal)}
.key.special kbd,.key.special small{color:var(--petal)}
.control-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.control-row button{flex:1 1 130px}
.save-row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}
.save-row .status{font-size:10px;color:var(--gold);min-height:16px}
.tools{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.tools button{font-size:10px;padding-left:12px;padding-right:12px}
.field{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}
.field h2{font-size:18px}
.field p{font:14px/1.55 Georgia,serif;color:var(--dim);margin:7px 0 0;max-width:700px}
.field .mark{font-size:31px;color:var(--fern);opacity:.85}
.note{font-size:10px;color:var(--dim);line-height:1.6;margin:0 2px}
input[type=file]{display:none}
[hidden]{display:none!important}
@media(max-width:760px){.layout{grid-template-columns:1fr}.right{display:grid;grid-template-columns:1fr 1fr;align-items:start}.right>.card:first-child{grid-column:1/-1}.field{grid-template-columns:1fr auto}}
@media(max-width:480px){header{padding:14px}main{padding:16px 14px 48px}.brand{font-size:27px}.brand small{margin-left:0}.intro{display:block}.intro h2{font-size:24px}.right{display:flex}.card{padding:14px}.tree-card{padding:11px 9px 14px}.tree-empty{inset:20% 12%;font-size:14px}.key{min-height:48px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}.key.hit{transform:none}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Tree Rings<small>A daily tune, grown into a year</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar">
    <button type="button" id="sound" aria-pressed="true">♪ Sound on</button>
  </div>
</header>

<main>
  <div class="intro">
    <div>
      <p class="eyebrow">Nature wing / a living instrument</p>
      <h2>Play one small tune. Grow one whole year.</h2>
      <p>Every note becomes part of today’s ring. The tree remembers the shape of your melody in its grain.</p>
    </div>
  </div>
  <p class="hint">Tap the keys or play <b>A S D F G H J K L ;</b> for up to 16 notes. Hold <b>Shift</b> for a fire scar, then save today’s ring. <b>Play the tree</b> hears the year from the heartwood outward.</p>

  <div class="layout">
    <section class="card tree-card" aria-labelledby="tree-heading">
      <div class="card-head"><h2 id="tree-heading">The living tree</h2><span class="count" id="ringCount">0 rings</span></div>
      <div class="tree-wrap">
        <svg id="tree" viewBox="0 0 520 520" role="img" aria-label="A tree trunk in cross-section">
          <defs>
            <radialGradient id="wood" cx="45%" cy="40%">
              <stop offset="0" stop-color="#d5a873" stop-opacity=".8" />
              <stop offset=".38" stop-color="#a87850" stop-opacity=".55" />
              <stop offset="1" stop-color="#5c4932" stop-opacity=".25" />
            </radialGradient>
            <radialGradient id="heart" cx="42%" cy="35%">
              <stop offset="0" stop-color="#f2c14e" stop-opacity=".95" />
              <stop offset="1" stop-color="#a85f42" stop-opacity=".85" />
            </radialGradient>
            <filter id="ringGlow" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>
          <circle cx="260" cy="260" r="244" fill="#1b2b1e" stroke="#2b3c2e" stroke-width="2" />
          <circle cx="260" cy="260" r="235" fill="url(#wood)" opacity=".66" />
          <g id="grain" fill="none" stroke="#8a6a4a" stroke-width="1" opacity=".24">
            <path d="M55 219C128 180 156 205 207 181S320 151 456 212" />
            <path d="M65 330C137 370 185 335 232 357S357 385 450 315" />
            <path d="M91 122C142 151 186 128 220 143S330 157 421 115" />
          </g>
          <circle id="bark" cx="260" cy="260" r="238" fill="none" stroke="#8a6a4a" stroke-width="13" opacity=".9" />
          <g id="ringLayer"></g>
          <circle id="heartwood" cx="260" cy="260" r="23" fill="url(#heart)" stroke="#f2c14e" stroke-width="2" />
          <circle cx="260" cy="260" r="8" fill="#6e4538" opacity=".55" />
          <circle id="playhead" class="playhead" cx="260" cy="260" r="0" hidden />
        </svg>
        <div id="treeEmpty" class="tree-empty">Your tree is waiting for its first note.<br>Give it a little weather.</div>
      </div>
      <p class="tree-caption" id="treeCaption">Tap a ring to hear that day and see its date.</p>
    </section>

    <div class="right">
      <section class="card" aria-labelledby="today-heading">
        <div class="today-head">
          <div><h2 id="today-heading">Today’s tune</h2><div class="date" id="todayDate"></div></div>
          <div class="season" id="season"><i></i><span></span></div>
        </div>
        <div class="draft" id="draft" aria-live="polite"><span class="empty">No notes yet — find a sound.</span></div>
        <div class="key-label"><span class="label">Home row / major pentatonic</span><span class="small" id="noteCount">0 / 16</span></div>
        <div class="keys" id="keys" role="group" aria-label="Tree ring notes"></div>
        <div class="control-row">
          <button type="button" class="primary" id="save">Save today’s ring</button>
          <button type="button" id="playTree">▶ Play the tree</button>
          <button type="button" id="clearToday">Clear today</button>
        </div>
        <div class="save-row"><span class="status" id="status" role="status"></span><span class="small">Replaceable until midnight.</span></div>
        <div class="tools">
          <button type="button" id="demo">Grow a demo tree</button>
          <button type="button" id="export">Export JSON</button>
          <button type="button" id="import">Import JSON</button>
          <input id="file" type="file" accept="application/json,.json" aria-label="Import tree JSON">
        </div>
      </section>
      <p class="note">Nothing leaves this browser except the ordered notes sent to the town keyboard signal when you save a ring. Your tree itself stays here.</p>
    </div>
  </div>

  <section class="card field" aria-labelledby="field-heading">
    <div><p class="label">Field note</p><h2 id="field-heading">A tree keeps a quiet calendar.</h2><p>Many trees in seasonal climates often add a growth ring each year, with lighter earlywood and darker latewood; ring widths can record past climate — the study is called dendrochronology.</p></div>
    <div class="mark" aria-hidden="true">✳</div>
  </section>
</main>

<script is:inline src="/keyboard.js" data-app="keyboard-rings" async></script>
<script is:inline>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var STORE_KEY = 'pc-rings-v1';
  var MAX_NOTES = 16;
  var HOME_KEYS = ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';'];
  var MIDIS = [60, 62, 64, 67, 69, 72, 74, 76, 79, 81];
  var KEY_LABELS = ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', ';'];
  var COLORS = {
    spring: { label: 'spring', color: '#a9c98a', dark: '#66885c' },
    summer: { label: 'summer', color: '#f2c14e', dark: '#a87532' },
    autumn: { label: 'autumn', color: '#d9974f', dark: '#8b4f35' },
    winter: { label: 'winter', color: '#6fb3b8', dark: '#1d4a55' },
  };
  var state = { v: 1, rings: {} };
  var draft = [];
  var scarDraft = false;
  var ringMeta = [];
  var soundOn = true;
  var audioContext = null;
  var master = null;
  var playback = null;
  var statusTimer = null;
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function pad(n) { return String(n).padStart(2, '0'); }
  function dateKey(date) { return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()); }
  function todayKey() { return dateKey(new Date()); }
  function dateFromKey(key) {
    var parts = String(key).split('-').map(Number);
    return parts.length === 3 && parts.every(function (n) { return isFinite(n); }) ? new Date(parts[0], parts[1] - 1, parts[2]) : new Date();
  }
  function formatDate(key) {
    return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(dateFromKey(key));
  }
  function seasonFor(date) {
    var month = date.getMonth() + 1;
    if (month >= 3 && month <= 5) return COLORS.spring;
    if (month >= 6 && month <= 8) return COLORS.summer;
    if (month >= 9 && month <= 11) return COLORS.autumn;
    return COLORS.winter;
  }
  function hash(text) {
    var h = 2166136261;
    for (var i = 0; i < text.length; i++) { h ^= text.charCodeAt(i); h = Math.imul(h, 16777619); }
    return (h >>> 0) / 4294967295;
  }
  function cleanNotes(raw) {
    if (!Array.isArray(raw)) return [];
    return raw.slice(0, MAX_NOTES).map(function (n) { return Math.round(Number(n)); }).filter(function (n) { return isFinite(n) && n >= 0 && n <= 127; });
  }
  function cleanRings(raw) {
    var out = {};
    if (!raw || typeof raw !== 'object') return out;
    Object.keys(raw).forEach(function (key) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(key)) return;
      var item = raw[key];
      var notes = cleanNotes(item && item.notes);
      if (!notes.length) return;
      out[key] = { date: key, notes: notes, scar: !!(item && item.scar) };
    });
    return out;
  }
  function load() {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (raw) {
        var saved = JSON.parse(raw);
        if (saved && saved.rings) state.rings = cleanRings(saved.rings);
      }
    } catch (e) { state.rings = {}; }
  }
  function persist() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify({ v: 1, rings: state.rings })); } catch (e) { showStatus('This browser could not save the tree.'); }
  }
  function allRings() {
    return Object.keys(state.rings).sort().map(function (key) { return state.rings[key]; });
  }
  function showStatus(text, hold) {
    clearTimeout(statusTimer);
    $('status').textContent = text || '';
    if (text && hold !== false) statusTimer = setTimeout(function () { $('status').textContent = ''; }, 5000);
  }
  function audio() {
    if (!audioContext) {
      audioContext = new (window.AudioContext || window.webkitAudioContext)();
      master = audioContext.createGain();
      master.gain.value = 0.24;
      var comp = audioContext.createDynamicsCompressor();
      comp.threshold.value = -20;
      comp.knee.value = 18;
      comp.ratio.value = 7;
      comp.attack.value = .004;
      comp.release.value = .25;
      master.connect(comp).connect(audioContext.destination);
    }
    if (audioContext.state === 'suspended') audioContext.resume();
    return audioContext;
  }
  function tone(midi, when, length, accent) {
    if (!soundOn) return;
    try {
      var ctx = audio();
      var t = when || ctx.currentTime;
      var f = 440 * Math.pow(2, (midi - 69) / 12);
      var out = ctx.createGain();
      out.gain.setValueAtTime(.0001, t);
      out.gain.exponentialRampToValueAtTime(accent ? .32 : .22, t + .008);
      out.gain.exponentialRampToValueAtTime(.0001, t + (length || .72));
      out.connect(master);
      [[1, 'triangle', 1], [2.01, 'sine', .16]].forEach(function (part) {
        var osc = ctx.createOscillator();
        osc.type = part[1]; osc.frequency.value = f * part[0];
        var partial = ctx.createGain(); partial.gain.value = part[2];
        osc.connect(partial).connect(out); osc.start(t); osc.stop(t + (length || .72) + .05);
      });
    } catch (e) { /* audio is a kindness, not a requirement */ }
  }
  function playTune(notes, step) {
    if (!soundOn || !notes.length) return;
    var ctx = audio();
    var spacing = step || .14;
    notes.forEach(function (note, index) { tone(note, ctx.currentTime + index * spacing, .56, index === notes.length - 1); });
  }
  function signal(notes) {
    var ordered = notes.slice(0, MAX_NOTES);
    var send = function () {
      if (window.PointCastKeyboard && typeof window.PointCastKeyboard.note === 'function') {
        window.PointCastKeyboard.note(ordered, null, { sound: false });
        return true;
      }
      return false;
    };
    if (!send()) window.setTimeout(send, 400);
  }
  function ringPath(radius, ring) {
    var points = 80;
    var seed = hash(ring.date + ring.notes.join(','));
    var amplitude = 1.25 + ring.notes.length * .16;
    var average = ring.notes.reduce(function (sum, note) { return sum + note; }, 0) / ring.notes.length;
    var d = '';
    for (var i = 0; i <= points; i++) {
      var angle = Math.PI * 2 * i / points;
      var note = ring.notes[i % ring.notes.length];
      var contour = (note - average) / 8;
      var wobble = Math.sin(angle * 7 + seed * 12) * amplitude + Math.sin(angle * 13 + seed * 30) * .58 + contour * 1.7;
      var r = radius + wobble;
      var x = 260 + Math.cos(angle) * r;
      var y = 260 + Math.sin(angle) * r;
      d += (i === 0 ? 'M' : 'L') + x.toFixed(2) + ' ' + y.toFixed(2);
    }
    return d + 'Z';
  }
  function scarPath(radius, ring) {
    var angle = hash(ring.date + 'scar') * Math.PI * 2;
    var spread = .34;
    var x1 = 260 + Math.cos(angle - spread) * radius;
    var y1 = 260 + Math.sin(angle - spread) * radius;
    var x2 = 260 + Math.cos(angle + spread) * radius;
    var y2 = 260 + Math.sin(angle + spread) * radius;
    return 'M' + x1.toFixed(2) + ' ' + y1.toFixed(2) + ' A' + radius.toFixed(2) + ' ' + radius.toFixed(2) + ' 0 0 1 ' + x2.toFixed(2) + ' ' + y2.toFixed(2);
  }
  function render() {
    var rings = allRings();
    var layer = $('ringLayer');
    ringMeta = [];
    if (!rings.length) {
      layer.innerHTML = '';
      $('treeEmpty').hidden = false;
      $('ringCount').textContent = '0 rings';
      $('treeCaption').textContent = 'Grow a demo tree, or save a tune for today.';
      return;
    }
    $('treeEmpty').hidden = true;
    $('ringCount').textContent = rings.length + (rings.length === 1 ? ' ring' : ' rings');
    var gap = rings.length === 1 ? 62 : Math.min(38, Math.max(5.35, 195 / (rings.length - 1)));
    var html = '';
    rings.forEach(function (ring, index) {
      var radius = 31 + index * gap;
      var season = seasonFor(dateFromKey(ring.date));
      var width = 1.8 + Math.min(7, ring.notes.length * .38) + (season.label === 'summer' ? 1.05 : 0) - (season.label === 'winter' ? .4 : 0);
      ringMeta.push({ ring: ring, radius: radius, index: index });
      html += '<g class="ring" data-ring-index="' + index + '" tabindex="0" role="button" aria-label="' + formatDate(ring.date) + ', ' + ring.notes.length + ' notes' + (ring.scar ? ', fire scar' : '') + '">';
      html += '<path class="hit" d="' + ringPath(radius, ring) + '" fill="none" stroke="transparent" stroke-width="44" pointer-events="stroke" />';
      html += '<path class="main" d="' + ringPath(radius, ring) + '" fill="none" stroke="' + season.color + '" stroke-width="' + width.toFixed(2) + '" stroke-linecap="round" opacity=".92" />';
      if (ring.scar) html += '<path class="scar" d="' + scarPath(radius, ring) + '" stroke-width="' + Math.max(3, width * 1.7).toFixed(2) + '" />';
      html += '</g>';
    });
    layer.innerHTML = html;
    $('treeCaption').textContent = rings.length < 5 ? 'Your sapling is taking shape. Tap a ring to hear its day.' : 'Tap a ring to hear that day and see its date.';
  }
  function renderToday() {
    var today = todayKey();
    var date = dateFromKey(today);
    var season = seasonFor(date);
    var saved = state.rings[today];
    if (saved && !draft.length) {
      draft = saved.notes.slice();
      scarDraft = !!saved.scar;
    }
    $('todayDate').textContent = formatDate(today);
    $('season').style.setProperty('--season', season.color);
    $('season').querySelector('span').textContent = season.label;
    $('noteCount').textContent = draft.length + ' / ' + MAX_NOTES;
    var draftNode = $('draft');
    draftNode.innerHTML = '';
    if (!draft.length) {
      draftNode.innerHTML = '<span class="empty">No notes yet — find a sound.</span>';
    } else {
      draft.forEach(function (note, index) {
        var dot = document.createElement('span');
        dot.className = 'note-dot' + (scarDraft && index === 0 ? ' scar' : '');
        dot.textContent = KEY_LABELS[MIDIS.indexOf(note)] || '♪';
        dot.title = 'Note ' + (index + 1);
        draftNode.appendChild(dot);
      });
    }
  }
  function keyButtons() {
    var node = $('keys');
    HOME_KEYS.forEach(function (key, index) {
      var button = document.createElement('button');
      button.type = 'button'; button.className = 'key'; button.dataset.key = key;
      button.innerHTML = '<kbd>' + KEY_LABELS[index] + '</kbd><small>' + MIDIS[index] + '</small>';
      button.addEventListener('click', function () { addNote(index, false); });
      node.appendChild(button);
    });
    var special = document.createElement('button');
    special.type = 'button'; special.className = 'key special'; special.dataset.key = 'shift';
    special.innerHTML = '<kbd>✳ Scar note</kbd><small>or hold Shift + a key</small>';
    special.addEventListener('click', function () { addNote(0, true); });
    node.appendChild(special);
  }
  function flashKey(index) {
    var button = document.querySelector('[data-key="' + HOME_KEYS[index] + '"]');
    if (!button) return;
    button.classList.add('hit');
    setTimeout(function () { button.classList.remove('hit'); }, reducedMotion ? 80 : 180);
  }
  function addNote(index, scar) {
    if (draft.length >= MAX_NOTES) { showStatus('Sixteen notes is a whole little season. Save it or start again.'); return; }
    draft.push(MIDIS[index]);
    scarDraft = scarDraft || !!scar;
    flashKey(index);
    tone(MIDIS[index], null, .52, scar);
    renderToday();
  }
  function saveToday() {
    if (!draft.length) { showStatus('Play a few notes first — the tree is listening.'); return; }
    var key = todayKey();
    state.rings[key] = { date: key, notes: draft.slice(0, MAX_NOTES), scar: scarDraft };
    persist();
    signal(state.rings[key].notes);
    render();
    showStatus('Today’s ring is growing.');
  }
  function clearToday() {
    var key = todayKey();
    if (!draft.length && !state.rings[key]) { showStatus('Today is already quiet.'); return; }
    delete state.rings[key];
    draft = [];
    scarDraft = false;
    persist();
    renderToday();
    render();
    showStatus('Today is clear. Make a new little season.');
  }
  function demoRing(date, index) {
    var patterns = [[0, 2, 4, 2], [4, 2, 0, 4, 7], [0, 4, 7, 9, 7, 4], [2, 0, 4, 7, 4, 2, 0]];
    var pattern = patterns[index % patterns.length];
    var notes = pattern.map(function (degree, noteIndex) { return MIDIS[(degree + index + noteIndex) % MIDIS.length]; });
    if (index % 3 === 1) notes.push(MIDIS[(index + 6) % MIDIS.length]);
    return { date: dateKey(date), notes: notes, scar: index % 9 === 4 };
  }
  function growDemo() {
    var base = new Date();
    base.setDate(base.getDate() - 40);
    for (var i = 0; i < 40; i++) { var day = new Date(base); day.setDate(base.getDate() + i); state.rings[dateKey(day)] = demoRing(day, i); }
    persist(); render(); showStatus('A forty-day tree has arrived. Press Play the tree.');
  }
  function setGlow(index, on) {
    var item = document.querySelector('[data-ring-index="' + index + '"]');
    if (item) item.classList.toggle('glow', on);
  }
  function playRing(meta) {
    if (!meta) return;
    audio();
    document.querySelectorAll('.ring.glow').forEach(function (node) { node.classList.remove('glow'); });
    setGlow(meta.index, true);
    $('treeCaption').innerHTML = '<strong>' + formatDate(meta.ring.date) + '</strong> · ' + meta.ring.notes.length + ' notes' + (meta.ring.scar ? ' · fire scar' : '');
    playTune(meta.ring.notes, .15);
    setTimeout(function () { setGlow(meta.index, false); }, Math.max(700, meta.ring.notes.length * 160));
  }
  function animatePlayhead(target, duration) {
    var head = $('playhead');
    head.hidden = false;
    if (reducedMotion) { head.setAttribute('r', target); return; }
    var start = Number(head.getAttribute('r')) || 0;
    var started = performance.now();
    function frame(now) {
      if (!playback || document.hidden) return;
      var p = Math.min(1, (now - started) / duration);
      var eased = 1 - Math.pow(1 - p, 3);
      head.setAttribute('r', (start + (target - start) * eased).toFixed(2));
      if (p < 1) playback.animation = requestAnimationFrame(frame);
    }
    playback.animation = requestAnimationFrame(frame);
  }
  function stopTree() {
    if (!playback) return;
    clearTimeout(playback.timer);
    if (playback.animation) cancelAnimationFrame(playback.animation);
    setGlow(playback.index, false);
    playback = null;
    $('playhead').hidden = true;
    $('playhead').setAttribute('r', '0');
  }
  function nextTreeRing() {
    if (!playback || document.hidden) return;
    var meta = ringMeta[playback.index];
    if (!meta) { stopTree(); showStatus('The year is complete.'); return; }
    setGlow(meta.index, true);
    $('treeCaption').innerHTML = '<strong>' + formatDate(meta.ring.date) + '</strong> · listening outward';
    animatePlayhead(meta.radius, 260);
    playTune(meta.ring.notes, .12);
    var wait = Math.max(430, meta.ring.notes.length * 125 + 180);
    playback.timer = setTimeout(function () { setGlow(meta.index, false); if (playback) { playback.index += 1; nextTreeRing(); } }, wait);
  }
  function playTree() {
    var rings = allRings();
    if (!rings.length) { showStatus('The tree has no days yet. Grow a demo tree or save today.'); return; }
    stopTree();
    audio();
    playback = { index: 0, timer: null, animation: null };
    nextTreeRing();
  }
  function toggleSound() {
    soundOn = !soundOn;
    $('sound').textContent = soundOn ? '♪ Sound on' : '♪ Sound off';
    $('sound').setAttribute('aria-pressed', String(soundOn));
    if (master) master.gain.value = soundOn ? .24 : 0;
  }
  function exportTree() {
    var blob = new Blob([JSON.stringify({ v: 1, rings: state.rings }, null, 2)], { type: 'application/json' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob); link.download = 'pointcast-tree-rings.json'; link.click();
    setTimeout(function () { URL.revokeObjectURL(link.href); }, 500);
    showStatus('Tree exported.');
  }
  function importTree(file) {
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function () {
      try {
        var parsed = JSON.parse(String(reader.result));
        var imported = cleanRings(parsed && parsed.rings);
        if (!Object.keys(imported).length) throw new Error('empty');
        state.rings = imported; persist(); render(); showStatus('Tree imported.');
      } catch (e) { showStatus('That file was not a tree JSON.'); }
    };
    reader.readAsText(file);
  }
  $('sound').addEventListener('click', toggleSound);
  $('save').addEventListener('click', saveToday);
  $('clearToday').addEventListener('click', clearToday);
  $('demo').addEventListener('click', growDemo);
  $('playTree').addEventListener('click', playTree);
  $('export').addEventListener('click', exportTree);
  $('import').addEventListener('click', function () { $('file').click(); });
  $('file').addEventListener('change', function (event) { importTree(event.target.files[0]); event.target.value = ''; });
  $('ringLayer').addEventListener('click', function (event) {
    var node = event.target.closest('[data-ring-index]');
    if (node) playRing(ringMeta[Number(node.dataset.ringIndex)]);
  });
  $('ringLayer').addEventListener('keydown', function (event) {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    event.preventDefault();
    var node = event.target.closest('[data-ring-index]');
    if (node) playRing(ringMeta[Number(node.dataset.ringIndex)]);
  });
  var scarArmed = false;
  document.addEventListener('keydown', function (event) {
    if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
    var key = event.key.toLowerCase();
    if (key === 'shift') { scarArmed = true; return; }
    if (HOME_KEYS.indexOf(key) >= 0) { event.preventDefault(); addNote(HOME_KEYS.indexOf(key), scarArmed || event.shiftKey); return; }
    if (key === 'enter') { event.preventDefault(); saveToday(); }
  });
  document.addEventListener('keyup', function (event) { if (event.key.toLowerCase() === 'shift') scarArmed = false; });
  document.addEventListener('visibilitychange', function () { if (document.hidden) stopTree(); });
  keyButtons();
  load();
  renderToday();
  render();
  if (!allRings().length) showStatus('First, play a few notes. Or grow a demo tree.');
})();
</script>
</body>
</html>
