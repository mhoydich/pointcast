---
const title = 'Tide Pool · PointCast';
const description =
  'Drop musical pebbles into a hand-painted tide pool. Ripples meet, creatures answer, and a three-minute tide changes the sound.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/tidepool">
<meta property="og:title" content="Tide Pool">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
html,body{overflow-x:hidden}
body{margin:0;min-height:100vh;background:radial-gradient(circle at 50% -15%,#294d4c80,transparent 44%),var(--bg);color:var(--ink)}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:#142019;border:1px solid var(--line);border-radius:30px;padding:9px 15px;min-height:44px;cursor:pointer}
button:hover{background:#1e2d22;border-color:#66836d}
button[aria-pressed=true],button.primary{background:var(--gold);border-color:var(--gold);color:var(--bg)}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px;min-height:44px;display:flex;align-items:center}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}
main{width:min(980px,100%);margin:0 auto;padding:22px 20px 64px;display:grid;gap:16px}
.intro{font-family:Georgia,serif;font-size:clamp(18px,3vw,24px);line-height:1.4;margin:0;max-width:760px;color:#dfead9}
.hint{margin:0;color:var(--dim);font-size:11px;line-height:1.65;background:#122018;border:1px solid var(--line);border-radius:12px;padding:10px 14px}
.hint b{color:var(--fern);font-weight:normal}
.instrument{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:14px;align-items:start}
.pool-shell{position:relative;min-width:0;isolation:isolate;border-radius:24px;overflow:hidden;border:1px solid #496653;box-shadow:0 24px 70px #0009,0 0 0 7px #1d2a2066;background:#0a1210;aspect-ratio:1}
#pool{display:block;width:100%;height:100%;touch-action:none;cursor:crosshair}
.empty{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;background:radial-gradient(circle,#10181312 0 25%,#10181399 86%);transition:opacity .5s}
.empty.gone{opacity:0}
.empty span{max-width:250px;padding:12px 16px;border:1px solid #b8d2bc66;border-radius:999px;background:#101813c7;color:#e8f1df;font-family:Georgia,serif;text-align:center;line-height:1.35;box-shadow:0 10px 30px #0008}
.source-img{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
.side{display:flex;flex-direction:column;gap:12px}
.card{background:linear-gradient(155deg,#1b2a20,#111d16);border:1px solid var(--line);border-radius:16px;padding:15px}
.eyebrow{display:block;color:var(--dim);font-size:9px;letter-spacing:.18em;text-transform:uppercase;margin-bottom:9px}
.dial-wrap{display:grid;grid-template-columns:68px 1fr;align-items:center;gap:12px}
.dial{width:68px;height:68px;border-radius:50%;position:relative;border:1px solid #6fb3b866;background:radial-gradient(circle at 50% 68%,#6fb3b866 0 38%,#17251d 40%);box-shadow:inset 0 0 20px #08110b}
.dial:before{content:'';position:absolute;left:33px;top:8px;width:2px;height:25px;border-radius:2px;background:var(--gold);transform-origin:50% 26px;transform:rotate(var(--tide-angle,-80deg));transition:transform 1s linear;box-shadow:0 0 7px #dfc48d}
.dial:after{content:'';position:absolute;left:29px;top:31px;width:9px;height:9px;border-radius:50%;background:var(--gold)}
.tide-name{font-family:Georgia,serif;font-size:20px;color:var(--sea)}
.tide-meta{font-size:9px;color:var(--dim);line-height:1.5;margin-top:3px}
.meter{height:5px;background:#0c150f;border-radius:99px;margin-top:11px;overflow:hidden}
.meter i{display:block;height:100%;width:var(--tide,50%);background:linear-gradient(90deg,var(--deep),var(--sea));border-radius:inherit;transition:width 1s linear}
.creatures{display:grid;gap:7px;font-size:10px;color:var(--dim)}
.creature{display:flex;justify-content:space-between;gap:8px;align-items:center}
.creature b{color:var(--ink);font-weight:normal}
.spark{width:8px;height:8px;border-radius:50%;background:#34483b;box-shadow:0 0 0 0 transparent;transition:.15s}
.spark.on{background:var(--sun);box-shadow:0 0 12px var(--sun)}
.actions{display:grid;gap:8px}
.actions button{width:100%;font-size:10px}
.count{color:var(--dim);font-size:9px;text-align:center;min-height:1.2em}
.field-note{margin:0;border-left:3px solid var(--moss);padding:13px 16px;background:#142019;border-radius:0 12px 12px 0;color:#b8c9b2;font:15px/1.55 Georgia,serif}
.field-note strong{font:9px/1 ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.18em;color:var(--fern);display:block;margin-bottom:7px}
.privacy{color:#6f856f;font-size:9px;line-height:1.55;margin:0}
@media(max-width:760px){.instrument{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr}.actions{grid-column:1/-1}}
@media(max-width:480px){header{padding:14px}main{padding:16px 14px 48px}.brand small{margin-left:0}.toolbar{width:100%}.toolbar button{flex:1}.side{grid-template-columns:1fr}.actions{grid-column:auto}.pool-shell{border-radius:17px}.intro{font-size:19px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.pool-shell{box-shadow:0 12px 28px #0008}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Tide Pool<small>Drop a pebble. Wake the water.</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar">
    <button type="button" id="sound" aria-pressed="true" aria-label="Turn tide pool sound off">♪ Sound on</button>
  </div>
</header>

<main>
  <p class="intro">Each key drops a musical pebble. Make two ripples meet and the pool’s quiet residents answer.</p>
  <p class="hint" id="hint"><b>First visit:</b> tap anywhere in the pool or press a letter. Drop two pebbles near a creature to make crossing waves—or use <b>Meet two waves</b>.</p>

  <section class="instrument" aria-label="Playable tide pool">
    <div class="pool-shell">
      <canvas id="pool" width="720" height="720" tabindex="0" role="application" aria-label="Interactive tide pool. Tap or press letter keys to drop musical pebbles."></canvas>
      <div class="empty" id="empty"><span>The water is still.<br>Drop the first pebble.</span></div>
      <img class="source-img" id="poolImage" src="/images/keyboard/tidepool/pool.jpg" alt="A hand-painted tide pool with a sandy floor and rocks around dark water" width="1200" height="1200">
      <img class="source-img" id="anemoneImage" src="/images/keyboard/tidepool/anemone.jpg" alt="A green sea anemone open in a ring of soft tentacles" width="640" height="640">
      <img class="source-img" id="starImage" src="/images/keyboard/tidepool/sea-star.jpg" alt="An ochre sea star seen from above" width="640" height="640">
      <img class="source-img" id="crabImage" src="/images/keyboard/tidepool/hermit-crab.jpg" alt="A small hermit crab emerging from a spiral shell" width="640" height="426">
      <img class="source-img" id="urchinImage" src="/images/keyboard/tidepool/urchin.jpg" alt="A purple sea urchin with fine violet spines" width="640" height="640">
    </div>

    <aside class="side" aria-label="Pool conditions">
      <div class="card">
        <span class="eyebrow">Three-minute tide</span>
        <div class="dial-wrap">
          <div class="dial" id="dial" role="img" aria-label="Local tide dial"></div>
          <div><div class="tide-name" id="tideName">Rising</div><div class="tide-meta" id="tideMeta">local tide · halfway in</div></div>
        </div>
        <div class="meter" aria-hidden="true"><i id="tideMeter"></i></div>
      </div>

      <div class="card">
        <span class="eyebrow">Pool residents</span>
        <div class="creatures">
          <span class="creature"><b>Anemone</b><i class="spark" id="spark0"></i></span>
          <span class="creature"><b>Ochre sea star</b><i class="spark" id="spark1"></i></span>
          <span class="creature"><b>Hermit crab</b><i class="spark" id="spark2"></i></span>
          <span class="creature"><b>Purple urchin</b><i class="spark" id="spark3"></i></span>
        </div>
      </div>

      <div class="actions">
        <button type="button" class="primary" id="cross">Meet two waves</button>
        <button type="button" id="still">Still the water</button>
        <div class="count" id="count" aria-live="polite">No pebbles yet</div>
      </div>
    </aside>
  </section>

  <p class="field-note"><strong>Field note</strong>Tide pools shelter creatures adapted to being covered and uncovered as tides turn, often twice each day. Ochre sea stars can act as keystone predators in their intertidal communities.</p>
  <p class="privacy">Your pebble count and sound choice stay in this browser. About every five seconds, only the ordered pitches you played join the town keyboard signal—never text or tap positions.</p>
</main>

<script is:inline src="/keyboard.js" data-app="keyboard-tidepool" async></script>
<script is:inline>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var STORE_KEY = 'pc-tidepool-v1';
  var GRID = 120;
  var CELLS = GRID * GRID;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var canvas = $('pool');
  var ctx = canvas.getContext('2d', { alpha: false });
  var rippleCanvas = document.createElement('canvas');
  rippleCanvas.width = GRID; rippleCanvas.height = GRID;
  var rippleCtx = rippleCanvas.getContext('2d');
  var ripplePixels = rippleCtx.createImageData(GRID, GRID);
  var current = new Float32Array(CELLS);
  var previous = new Float32Array(CELLS);
  var next = new Float32Array(CELLS);
  var drops = [];
  var pebbleCount = 0;
  var soundOn = true;
  var running = !document.hidden;
  var frame = 0;
  var lastTime = 0;
  var signalNotes = [];
  var started = false;
  var resizeNeeded = true;
  var tideLevel = 0.5;
  var imagesReady = 0;
  var imageIds = ['poolImage', 'anemoneImage', 'starImage', 'crabImage', 'urchinImage'];

  var creatures = [
    { name: 'anemone', image: 'anemoneImage', x: .31, y: .31, size: .18, note: 76, glow: 0, cool: 0 },
    { name: 'sea star', image: 'starImage', x: .69, y: .34, size: .17, note: 72, glow: 0, cool: 0 },
    { name: 'hermit crab', image: 'crabImage', x: .34, y: .71, size: .21, note: 67, glow: 0, cool: 0, scuttle: 0 },
    { name: 'urchin', image: 'urchinImage', x: .71, y: .70, size: .16, note: 79, glow: 0, cool: 0 }
  ];

  function loadState() {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (saved && isFinite(saved.pebbles)) pebbleCount = Math.max(0, Math.floor(saved.pebbles));
      if (saved && typeof saved.soundOn === 'boolean') soundOn = saved.soundOn;
    } catch (e) { /* storage is optional */ }
  }
  function saveState() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify({ pebbles: pebbleCount, soundOn: soundOn })); }
    catch (e) { /* storage is optional */ }
  }
  function paintState() {
    $('sound').setAttribute('aria-pressed', String(soundOn));
    $('sound').setAttribute('aria-label', soundOn ? 'Turn tide pool sound off' : 'Turn tide pool sound on');
    $('sound').textContent = soundOn ? '♪ Sound on' : '♪ Sound off';
    $('count').textContent = pebbleCount ? pebbleCount + (pebbleCount === 1 ? ' pebble dropped' : ' pebbles dropped') : 'No pebbles yet';
  }

  var ac = null, input = null, filter = null, dry = null, wet = null, convolver = null, master = null;
  function audio() {
    if (!ac) {
      ac = new (window.AudioContext || window.webkitAudioContext)();
      input = ac.createGain(); input.gain.value = 1;
      filter = ac.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 2600; filter.Q.value = .7;
      dry = ac.createGain(); dry.gain.value = .8;
      wet = ac.createGain(); wet.gain.value = .16;
      convolver = ac.createConvolver();
      var length = Math.floor(ac.sampleRate * 2.2);
      var impulse = ac.createBuffer(2, length, ac.sampleRate);
      for (var ch = 0; ch < 2; ch++) {
        var data = impulse.getChannelData(ch);
        for (var i = 0; i < length; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 3.1);
      }
      convolver.buffer = impulse;
      master = ac.createGain(); master.gain.value = soundOn ? .48 : 0;
      var comp = ac.createDynamicsCompressor(); comp.threshold.value = -20; comp.knee.value = 16; comp.ratio.value = 5; comp.attack.value = .01; comp.release.value = .25;
      input.connect(filter); filter.connect(dry).connect(master); filter.connect(convolver).connect(wet).connect(master); master.connect(comp).connect(ac.destination);
    }
    if (ac.state === 'suspended') ac.resume();
    return ac;
  }
  function setTideAudio() {
    if (!ac) return;
    var now = ac.currentTime;
    filter.frequency.setTargetAtTime(3900 - tideLevel * 2650, now, .8);
    wet.gain.setTargetAtTime(.06 + tideLevel * .34, now, .8);
    dry.gain.setTargetAtTime(.92 - tideLevel * .28, now, .8);
  }
  function midiFreq(midi) { return 440 * Math.pow(2, (midi - 69) / 12); }
  function playBloop(midi) {
    if (!soundOn) return;
    var c = audio(), t = c.currentTime, f = midiFreq(midi);
    var osc = c.createOscillator(), overtone = c.createOscillator(), gain = c.createGain();
    osc.type = 'sine'; overtone.type = 'sine';
    osc.frequency.setValueAtTime(f * 1.08, t); osc.frequency.exponentialRampToValueAtTime(f, t + .12);
    overtone.frequency.setValueAtTime(f * 2.04, t); overtone.frequency.exponentialRampToValueAtTime(f * 1.98, t + .18);
    gain.gain.setValueAtTime(.0001, t); gain.gain.exponentialRampToValueAtTime(.16, t + .008); gain.gain.exponentialRampToValueAtTime(.0001, t + .62);
    osc.connect(gain); overtone.connect(gain); gain.connect(input); osc.start(t); overtone.start(t); osc.stop(t + .7); overtone.stop(t + .7);
  }
  function playCreature(creature, strength) {
    var midi = creature.note;
    signalNotes.push(midi);
    if (!soundOn) return;
    var c = audio(), t = c.currentTime, f = midiFreq(midi), out = c.createGain();
    out.gain.value = Math.min(.78, .2 + strength * .55);
    [[1, .12], [2.01, .055], [3.98, .025]].forEach(function (part) {
      var osc = c.createOscillator(), gain = c.createGain();
      osc.type = 'sine'; osc.frequency.value = f * part[0];
      gain.gain.setValueAtTime(.0001, t); gain.gain.exponentialRampToValueAtTime(part[1], t + .008); gain.gain.exponentialRampToValueAtTime(.0001, t + 1.45 / Math.sqrt(part[0]));
      osc.connect(gain).connect(out); osc.start(t); osc.stop(t + 1.6);
    });
    out.connect(input);
  }

  var SCALE = [0, 2, 5, 7, 9];
  function noteAt(x, y) {
    var degree = Math.min(4, Math.floor(x * 5));
    var octave = y < .34 ? 24 : y < .67 ? 12 : 0;
    return 48 + octave + SCALE[degree];
  }
  function inject(x, y, amount) {
    var gx = Math.max(3, Math.min(GRID - 4, Math.round(x * (GRID - 1))));
    var gy = Math.max(3, Math.min(GRID - 4, Math.round(y * (GRID - 1))));
    for (var oy = -3; oy <= 3; oy++) for (var ox = -3; ox <= 3; ox++) {
      var d = Math.sqrt(ox * ox + oy * oy);
      if (d <= 3) current[(gy + oy) * GRID + gx + ox] += amount * (.5 + .5 * Math.cos(d / 3 * Math.PI));
    }
  }
  function dropPebble(x, y, quiet) {
    x = Math.max(.04, Math.min(.96, x)); y = Math.max(.04, Math.min(.96, y));
    started = true; $('empty').classList.add('gone');
    var midi = noteAt(x, y);
    inject(x, y, 1.9);
    drops.push({ x: x, y: y, born: performance.now() });
    if (drops.length > 24) drops.shift();
    pebbleCount++; signalNotes.push(midi);
    if (!quiet) playBloop(midi);
    paintState(); saveState();
    if (reduced) { reducedReaction(x, y); drawScene(true); }
  }
  function reducedReaction(x, y) {
    var recent = drops.filter(function (d) { return performance.now() - d.born < 2400; });
    creatures.forEach(function (creature) {
      var close = recent.filter(function (d) { return Math.hypot(d.x - creature.x, d.y - creature.y) < .28; });
      if (close.length >= 2) react(creature, .75);
    });
  }

  function waveStep() {
    for (var y = 1; y < GRID - 1; y++) {
      var row = y * GRID;
      for (var x = 1; x < GRID - 1; x++) {
        var i = row + x;
        var lap = current[i - 1] + current[i + 1] + current[i - GRID] + current[i + GRID] - 4 * current[i];
        next[i] = (2 * current[i] - previous[i] + .225 * lap) * .993;
      }
    }
    var swap = previous; previous = current; current = next; next = swap; next.fill(0);
  }
  function sampleWave(x, y) {
    var gx = Math.max(1, Math.min(GRID - 2, Math.round(x * (GRID - 1))));
    var gy = Math.max(1, Math.min(GRID - 2, Math.round(y * (GRID - 1))));
    return current[gy * GRID + gx];
  }
  function react(creature, strength) {
    var now = performance.now();
    if (now < creature.cool) return;
    creature.cool = now + 1100;
    creature.glow = Math.max(creature.glow, Math.min(1, .45 + strength));
    if (creature.name === 'hermit crab') creature.scuttle = 1;
    playCreature(creature, strength);
    var idx = creatures.indexOf(creature), spark = $('spark' + idx);
    spark.classList.add('on');
    setTimeout(function () { spark.classList.remove('on'); }, 520);
  }
  function testInterference() {
    var now = performance.now();
    var active = drops.filter(function (d) { return now - d.born < 4800; });
    drops = active;
    if (active.length < 2) return;
    creatures.forEach(function (creature) {
      var amplitude = Math.abs(sampleWave(creature.x, creature.y));
      if (amplitude > .035) react(creature, Math.min(1, amplitude * 6));
    });
  }

  function resizeCanvas() {
    var rect = canvas.getBoundingClientRect();
    var dpr = Math.min(2, window.devicePixelRatio || 1);
    var size = Math.max(280, Math.round(rect.width * dpr));
    if (canvas.width !== size || canvas.height !== size) { canvas.width = size; canvas.height = size; }
    resizeNeeded = false;
  }
  function coverImage(image, w, h) {
    var scale = Math.max(w / image.naturalWidth, h / image.naturalHeight);
    var sw = image.naturalWidth * scale, sh = image.naturalHeight * scale;
    ctx.drawImage(image, (w - sw) / 2, (h - sh) / 2, sw, sh);
  }
  function drawCreature(creature, w, h) {
    var image = $(creature.image); if (!image.complete || !image.naturalWidth) return;
    creature.glow *= reduced ? 1 : .955;
    creature.scuttle = (creature.scuttle || 0) * .94;
    var base = creature.size * w;
    var ratio = image.naturalWidth / image.naturalHeight;
    var dw = ratio >= 1 ? base * ratio : base;
    var dh = ratio >= 1 ? base : base / ratio;
    var pulse = 1 + creature.glow * (creature.name === 'anemone' ? .16 : .07);
    var crabShift = creature.name === 'hermit crab' ? Math.sin(frame * .38) * creature.scuttle * w * .028 : 0;
    ctx.save();
    ctx.translate(creature.x * w + crabShift, creature.y * h);
    if (creature.name === 'sea star') ctx.rotate(creature.glow * .08 * Math.sin(frame * .08));
    ctx.scale(pulse, pulse);
    ctx.globalCompositeOperation = 'source-over';
    ctx.globalAlpha = .86 + creature.glow * .14;
    ctx.shadowColor = creature.name === 'sea star' ? '#f2c14e' : creature.name === 'anemone' ? '#a9c98a' : '#b5a8ee';
    ctx.shadowBlur = 7 + creature.glow * 28;
    ctx.drawImage(keyedSprite(image), -dw / 2, -dh / 2, dw, dh);
    ctx.restore();
  }

  /* Architect pass: the field-guide sprites are JPEGs on a painted dark field.
     Key that field to transparency (sampled from the image's own corners) so
     shadows and glows follow the animal, not the rectangle. */
  function keyOutField(img) {
    var c = document.createElement('canvas');
    c.width = img.naturalWidth; c.height = img.naturalHeight;
    var x = c.getContext('2d');
    x.drawImage(img, 0, 0);
    var d = x.getImageData(0, 0, c.width, c.height), p = d.data, W = c.width, H = c.height;
    var bg = [0, 0, 0], n = 0;
    [[2, 2], [W - 3, 2], [2, H - 3], [W - 3, H - 3]].forEach(function (pt) { var i = (pt[1] * W + pt[0]) * 4; bg[0] += p[i]; bg[1] += p[i + 1]; bg[2] += p[i + 2]; n++; });
    bg = bg.map(function (v) { return v / n; });
    for (var i = 0; i < p.length; i += 4) {
      var dist = Math.abs(p[i] - bg[0]) + Math.abs(p[i + 1] - bg[1]) + Math.abs(p[i + 2] - bg[2]);
      p[i + 3] = Math.round(255 * Math.max(0, Math.min(1, (dist - 16) / 44)));
    }
    x.putImageData(d, 0, 0);
    return c;
  }
  var keyedCache = new Map();
  function keyedSprite(image) {
    if (keyedCache.has(image)) return keyedCache.get(image);
    var out = image;
    try { if (image.complete && image.naturalWidth) { out = keyOutField(image); keyedCache.set(image, out); } } catch (e) { keyedCache.set(image, image); }
    return out;
  }
  function paintRipples(w, h) {
    var pixels = ripplePixels.data;
    for (var y = 0; y < GRID; y++) for (var x = 0; x < GRID; x++) {
      var i = y * GRID + x, p = i * 4;
      var dx = x > 0 && x < GRID - 1 ? current[i + 1] - current[i - 1] : 0;
      var dy = y > 0 && y < GRID - 1 ? current[i + GRID] - current[i - GRID] : 0;
      var light = Math.max(-1, Math.min(1, (dx - dy) * 2.4 + current[i] * .5));
      var power = Math.min(1, Math.abs(light));
      pixels[p] = light > 0 ? 205 : 15;
      pixels[p + 1] = light > 0 ? 244 : 64;
      pixels[p + 2] = light > 0 ? 238 : 82;
      pixels[p + 3] = Math.floor(power * 128);
    }
    rippleCtx.putImageData(ripplePixels, 0, 0);
    ctx.save(); ctx.globalCompositeOperation = 'screen'; ctx.globalAlpha = .78; ctx.imageSmoothingEnabled = true;
    ctx.drawImage(rippleCanvas, 0, 0, w, h); ctx.restore();
  }
  function drawStillRings(w, h) {
    ctx.save();
    drops.slice(-8).forEach(function (d, i) {
      ctx.beginPath(); ctx.arc(d.x * w, d.y * h, w * (.035 + i * .004), 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(190,235,230,' + (.34 - i * .025) + ')'; ctx.lineWidth = Math.max(1, w * .003); ctx.stroke();
    });
    ctx.restore();
  }
  function drawScene(still) {
    if (resizeNeeded) resizeCanvas();
    var w = canvas.width, h = canvas.height, pool = $('poolImage');
    ctx.fillStyle = '#101813'; ctx.fillRect(0, 0, w, h);
    if (pool.complete && pool.naturalWidth) coverImage(pool, w, h);
    else { ctx.fillStyle = '#163331'; ctx.fillRect(0, 0, w, h); }
    ctx.fillStyle = 'rgba(16,56,63,' + (.08 + tideLevel * .3).toFixed(3) + ')'; ctx.fillRect(0, 0, w, h);
    creatures.forEach(function (creature) { drawCreature(creature, w, h); });
    if (still) drawStillRings(w, h); else paintRipples(w, h);
    var shade = ctx.createRadialGradient(w * .5, h * .48, w * .18, w * .5, h * .5, w * .7);
    shade.addColorStop(0, 'rgba(0,0,0,0)'); shade.addColorStop(1, 'rgba(3,12,8,' + (.38 - tideLevel * .12) + ')');
    ctx.fillStyle = shade; ctx.fillRect(0, 0, w, h);
  }
  function updateTide() {
    var phase = (Date.now() % 180000) / 180000;
    tideLevel = .5 - .5 * Math.cos(phase * Math.PI * 2);
    var rising = phase < .5;
    $('tideName').textContent = tideLevel > .86 ? 'High tide' : tideLevel < .14 ? 'Low tide' : rising ? 'Rising' : 'Falling';
    var seconds = Math.max(1, Math.round((rising ? .5 - phase : 1 - phase) * 180));
    $('tideMeta').textContent = 'local tide · ' + seconds + 's to ' + (rising ? 'high' : 'low');
    $('tideMeter').style.width = Math.round(tideLevel * 100) + '%';
    $('dial').style.setProperty('--tide-angle', (-82 + tideLevel * 164) + 'deg');
    $('dial').setAttribute('aria-label', Math.round(tideLevel * 100) + ' percent tide, ' + (rising ? 'rising' : 'falling'));
    setTideAudio();
  }
  function animate(time) {
    if (!running || reduced) return;
    if (!lastTime) lastTime = time;
    var steps = Math.min(2, Math.max(1, Math.round((time - lastTime) / 16.7)));
    for (var i = 0; i < steps; i++) waveStep();
    lastTime = time; frame++;
    if (frame % 3 === 0) testInterference();
    if (frame % 30 === 0) updateTide();
    drawScene(false);
    requestAnimationFrame(animate);
  }

  var KEY_ROWS = ['1234567890', 'qwertyuiop', 'asdfghjkl;', 'zxcvbnm,./'];
  function keyPosition(key) {
    key = key.toLowerCase();
    if (key === ' ') return { x: .5, y: .52 };
    for (var r = 0; r < KEY_ROWS.length; r++) {
      var col = KEY_ROWS[r].indexOf(key);
      if (col >= 0) return { x: .1 + col / Math.max(1, KEY_ROWS[r].length - 1) * .8, y: .16 + r * .225 };
    }
    return null;
  }
  canvas.addEventListener('pointerdown', function (event) {
    if (event.button && event.button !== 0) return;
    event.preventDefault(); canvas.focus();
    var rect = canvas.getBoundingClientRect();
    dropPebble((event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height, false);
  });
  document.addEventListener('keydown', function (event) {
    if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
    var tag = event.target && event.target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'BUTTON') return;
    var pos = keyPosition(event.key);
    if (!pos) return;
    event.preventDefault(); dropPebble(pos.x, pos.y, false);
  });
  $('sound').addEventListener('click', function () {
    soundOn = !soundOn;
    if (soundOn) audio();
    if (master) master.gain.setTargetAtTime(soundOn ? .48 : 0, ac.currentTime, .03);
    paintState(); saveState();
  });
  $('cross').addEventListener('click', function () {
    if (soundOn) audio();
    var target = creatures[(Math.floor(pebbleCount / 2)) % creatures.length];
    var spread = .14;
    dropPebble(target.x - spread, target.y, false);
    setTimeout(function () { if (!document.hidden) dropPebble(target.x + spread, target.y, false); }, 150);
    setTimeout(function () { if (!document.hidden) { inject(target.x, target.y, 1.4); react(target, .95); } }, reduced ? 180 : 900);
  });
  $('still').addEventListener('click', function () {
    current.fill(0); previous.fill(0); next.fill(0); drops = [];
    creatures.forEach(function (creature) { creature.glow = 0; creature.scuttle = 0; });
    $('empty').classList.remove('gone'); started = false; drawScene(true);
  });
  addEventListener('resize', function () { resizeNeeded = true; if (reduced) drawScene(true); });
  document.addEventListener('visibilitychange', function () {
    running = !document.hidden;
    if (!running) { saveState(); return; }
    lastTime = 0; updateTide();
    if (reduced) drawScene(true); else requestAnimationFrame(animate);
  });
  addEventListener('pagehide', function () {
    saveState();
    if (signalNotes.length && window.PointCastKeyboard) {
      window.PointCastKeyboard.note(signalNotes.splice(0, 48), null, { sound: false });
      window.PointCastKeyboard.flush();
    }
  });
  setInterval(function () {
    if (!signalNotes.length || !window.PointCastKeyboard) return;
    window.PointCastKeyboard.note(signalNotes.splice(0, 48), null, { sound: false });
  }, 5000);

  imageIds.forEach(function (id) {
    var image = $(id);
    var ready = function () { imagesReady++; if (imagesReady >= imageIds.length) drawScene(reduced); };
    if (image.complete && image.naturalWidth) ready(); else image.addEventListener('load', ready, { once: true });
  });
  loadState(); paintState(); updateTide(); drawScene(true);
  if (!reduced && running) requestAnimationFrame(animate);
})();
</script>
</body>
</html>
