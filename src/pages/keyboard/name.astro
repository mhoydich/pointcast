---
/**
 * /keyboard/name — Name Song.
 *
 * Every name has a song. Type one and hear it: each letter sings as you type
 * (KeyVoice, same voice as Key Diary and Key Letter), and a pause or Enter
 * plays the whole thing back with a little rhythm — vowels held, consonants
 * short, spaces a breath, landing home on the tonic. The mood is picked from
 * a hash of the name, or pick your own. Save a keepsake card (SVG → PNG) or
 * copy a link that carries the name and mood in the URL fragment — never on
 * a server. Only a sorted, wordless bag of notes reaches the town chord.
 */
const title = 'Name Song · PointCast';
const description =
  'Type a name and hear its song. Every name gets a mood, a melody and a keepsake card you can save or send — the name never leaves your link.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/name">
<meta property="og:title" content="Name Song · PointCast">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--mood:#dfc48d;--paper:#efe8d2;--paper-ink:#2c3326;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 84% 0%,#34413255,transparent 43%),var(--bg);color:var(--ink);min-height:100vh}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:10px 16px;cursor:pointer;font-size:11px;touch-action:manipulation}
button:hover{background:#1e2b20;border-color:#688777}
button.primary{background:var(--mood);border-color:var(--mood);color:var(--bg)}
button[aria-pressed=true]{background:var(--mood);border-color:var(--mood);color:var(--bg)}
button:disabled{opacity:.4;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:820px;margin:0 auto;padding:32px 20px 60px}
.label{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin:0 0 10px}
.intro{font-size:12px;color:var(--dim);line-height:1.7;margin:0 0 22px;max-width:60ch}
.stage{background:linear-gradient(155deg,#1d2c20,#111d16);border:1px solid var(--line);border-radius:16px;padding:24px}
.namefield{display:flex;align-items:baseline;gap:4px;border-bottom:1px dashed var(--line);padding-bottom:14px;margin-bottom:14px}
.namefield input{flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--ink);font-family:Georgia,serif;font-size:clamp(28px,6vw,46px);letter-spacing:-1px;padding:4px 0}
.namefield input::placeholder{color:#4c5c4d}
.moodline{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;color:var(--dim);margin-bottom:16px}
.moodline b{color:var(--mood);font-weight:normal}
.moods{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px}
.moods button{padding:7px 12px;font-size:10px}
.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.actions .meta{font-size:10px;color:var(--dim);margin-left:auto}
.card-wrap{margin-top:22px;border-radius:14px;overflow:hidden;border:1px solid var(--line);background:#0d1711}
.card-wrap svg{display:block;width:100%;height:auto}
.card-empty{padding:60px 20px;text-align:center;font-size:11px;color:var(--dim)}
.linkbox{margin-top:16px;border:1px solid var(--line);border-radius:14px;padding:14px;background:#0d1711;display:none}
.linkbox.show{display:block}
.linkbox input{width:100%;background:#0b120d;border:1px solid var(--line);border-radius:10px;color:var(--ink);font:inherit;font-size:11px;padding:11px;margin:8px 0 10px}
.note{font-size:10px;color:var(--dim);line-height:1.8;margin:14px 0 0}
.history{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.history button{font-size:10px;padding:6px 11px;display:flex;align-items:center;gap:6px}
.history button i{width:8px;height:8px;border-radius:50%;background:var(--c,var(--gold));display:inline-block}
h2{font-family:Georgia,serif;font-weight:normal;font-size:20px;margin:34px 0 4px}
.sub{font-size:11px;color:var(--dim);margin:0 0 16px;line-height:1.7}
.wall{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
.wall button{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:12px 14px;border-radius:12px;text-align:left}
.wall button strong{font-family:Georgia,serif;font-weight:normal;font-size:17px}
.wall button span{font-size:9px;color:var(--dim)}
.wall svg{width:100%;height:16px}
.envelope{display:grid;place-items:center;text-align:center;min-height:50vh;gap:18px}
.envelope .card-wrap{max-width:640px;width:100%}
[hidden]{display:none!important}
@media(max-width:560px){header{padding:16px}main{padding:22px 14px 48px}.stage{padding:16px}.brand small{margin-left:0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Name Song<small>Every name has a song</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="actions">
    <button type="button" id="sound" aria-pressed="true">♪ Sound on</button>
  </div>
</header>

<main>
  <!-- Receiving a shared card -->
  <section id="receive" hidden>
    <div class="envelope">
      <p class="label" id="envLabel">A name song</p>
      <div class="card-wrap"><svg id="cardSvgR" viewBox="0 0 1200 630" role="img" aria-label="Keepsake melody card"></svg></div>
      <div class="actions">
        <button type="button" class="primary" id="hear">▶ Tap to hear it</button>
        <a href="/keyboard/name" style="font-size:11px">Make your own</a>
      </div>
    </div>
  </section>

  <!-- Composing -->
  <section id="compose">
    <p class="label">Type a name</p>
    <p class="intro">Each letter sings as you type. Pause, or press Enter, and the whole name plays back as a little song — vowels held, consonants quick, a space is a breath, and it always comes home at the end.</p>
    <div class="stage">
      <div class="namefield">
        <input id="name" maxlength="40" placeholder="a name…" autocomplete="off" spellcheck="false" aria-label="Name">
      </div>
      <p class="moodline">Your name is in <b id="moodName">—</b> <span id="moodEmoji"></span></p>
      <div class="moods" id="moods" role="group" aria-label="Choose a mood"></div>
      <div class="actions">
        <button type="button" id="play">▶ Play</button>
        <button type="button" id="save" disabled>⬇ Save card</button>
        <button type="button" id="copy" disabled>✳ Copy link</button>
        <span class="meta" id="meta">0 / 40</span>
      </div>
      <div class="card-wrap" id="cardWrap">
        <div class="card-empty" id="cardEmpty">Type a name above to see its song appear here.</div>
        <svg id="cardSvg" viewBox="0 0 1200 630" role="img" aria-label="Keepsake melody card" hidden></svg>
      </div>
      <div class="linkbox" id="linkbox">
        <p class="label">Link copied</p>
        <input id="link" readonly aria-label="Name song link">
      </div>
    </div>
    <div class="history" id="history" aria-label="Names you made"></div>
    <p class="note">Nothing is stored except the last 8 names you make, kept in this browser only. A link holds the name and mood after <code>#</code>, which never reaches our server. Finishing a song sends only a sorted, wordless handful of its notes to the town chord on <a href="/keyboard-signal">/keyboard-signal</a>.</p>

    <h2>The name wall</h2>
    <p class="sub">A few to try. Tap one to hear it.</p>
    <div class="wall" id="wall"></div>
  </section>
</main>

<script is:inline src="/js/keyboard-voice.js"></script>
<script is:inline src="/keyboard.js" data-app="keyboard-name" async></script>
<script is:inline>
(function () {
  'use strict';
  var V = window.KeyVoice;
  var $ = function (id) { return document.getElementById(id); };
  var STORE_KEY = 'pc-name-v1';
  var MAX = 40;
  var VOWELS = 'aeiouyAEIOUY';
  var WALL = ['Ada', 'Kenzo', 'Rosa', 'Milo', 'Juniper', 'Sol'];

  var overrideMood = null;
  var sound = true;
  var songTimers = [];
  var pauseTimer = null;
  var lastCard = null; // { name, mood, events }

  // ---- storage --------------------------------------------------------------
  var store = { history: [], sound: true };
  try {
    var raw = localStorage.getItem(STORE_KEY);
    if (raw) { var parsed = JSON.parse(raw); if (parsed && typeof parsed === 'object') store = parsed; }
  } catch (e) { /* private mode */ }
  if (!Array.isArray(store.history)) store.history = [];
  sound = store.sound !== false;

  function persist() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify({ history: store.history.slice(0, 8), sound: sound })); } catch (e) { /* storage full or blocked */ }
  }
  function remember(name, moodId) {
    var n = name.trim();
    if (!n) return;
    store.history = store.history.filter(function (h) { return h.n.toLowerCase() !== n.toLowerCase(); });
    store.history.unshift({ n: n, m: moodId, t: Date.now() });
    store.history = store.history.slice(0, 8);
    persist();
    paintHistory();
  }
  function paintHistory() {
    var box = $('history');
    box.innerHTML = '';
    store.history.forEach(function (h) {
      var m = V.mood(h.m);
      var b = document.createElement('button');
      b.type = 'button';
      b.style.setProperty('--c', m.color);
      var i = document.createElement('i');
      var span = document.createElement('span');
      span.textContent = h.n;
      b.appendChild(i);
      b.appendChild(span);
      b.addEventListener('click', function () { load(h.n, h.m); });
      box.appendChild(b);
    });
  }

  // ---- mood ------------------------------------------------------------------
  function hashName(s) {
    var h = 0;
    for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
    return h;
  }
  function autoMoodFor(name) {
    var n = name.trim().toLowerCase();
    if (!n) return V.moods[0].id;
    return V.moods[hashName(n) % V.moods.length].id;
  }
  function activeMood() {
    var n = $('name').value;
    return overrideMood || autoMoodFor(n);
  }
  function paintMoodLine() {
    var m = V.mood(activeMood());
    document.documentElement.style.setProperty('--mood', m.color);
    $('moodName').textContent = m.label;
    $('moodEmoji').textContent = m.emoji;
    Array.prototype.forEach.call($('moods').children, function (b) {
      b.setAttribute('aria-pressed', String(b.dataset.mood === m.id));
    });
  }
  V.moods.forEach(function (m) {
    var b = document.createElement('button');
    b.type = 'button';
    b.dataset.mood = m.id;
    b.textContent = m.emoji + ' ' + m.label;
    b.addEventListener('click', function () {
      overrideMood = m.id;
      paintMoodLine();
      drawCard();
      if (sound) m.chord.forEach(function (s, i) { V.play(m.root + s, m.id, V.ctx().currentTime + i * 0.08); });
    });
    $('moods').appendChild(b);
  });

  // ---- building the song ------------------------------------------------------
  function buildEvents(name, moodId) {
    var m = V.mood(moodId);
    var prev = null;
    var events = [];
    for (var i = 0; i < name.length && events.length < 80; i++) {
      var ch = name[i];
      if (/\s/.test(ch)) { events.push({ midi: null, dur: 260, rest: true }); prev = null; continue; }
      var n = V.noteFor(ch, moodId, prev);
      if (n == null) continue;
      var vowel = VOWELS.indexOf(ch) >= 0;
      events.push({ midi: n, dur: vowel ? 430 : 180, rest: false, vowel: vowel });
      prev = n;
    }
    if (events.length) events.push({ midi: m.root, dur: 620, rest: false, cadence: true });
    return events;
  }

  function stopSong() {
    songTimers.forEach(clearTimeout);
    songTimers = [];
  }

  function playSong(name, moodId, onDone) {
    stopSong();
    var events = buildEvents(name, moodId);
    if (!events.length) return;
    var c = V.ctx();
    var t = 0;
    events.forEach(function (ev, i) {
      (function (i, at) {
        songTimers.push(setTimeout(function () {
          if (!ev.rest && sound) V.play(ev.midi, moodId, c.currentTime);
          highlightNote(i);
        }, at));
      })(i, t);
      t += ev.dur * (ev.rest ? 1 : 0.85);
    });
    songTimers.push(setTimeout(function () {
      highlightNote(-1);
      sendToTown(events);
      remember(name, moodId);
      if (onDone) onDone();
    }, t + 300));
  }

  function sendToTown(events) {
    if (!window.PointCastKeyboard) return;
    var notes = events.filter(function (e) { return !e.rest; }).map(function (e) { return e.midi; }).sort(function (a, b) { return a - b; });
    if (!notes.length) return;
    window.PointCastKeyboard.note(notes, null, { sound: false });
  }

  // ---- the keepsake card -------------------------------------------------------
  function smoothPath(points) {
    if (points.length < 2) return '';
    var d = 'M ' + points[0][0].toFixed(1) + ' ' + points[0][1].toFixed(1);
    for (var i = 1; i < points.length; i++) {
      var p0 = points[i - 1], p1 = points[i];
      var mx = (p0[0] + p1[0]) / 2, my = (p0[1] + p1[1]) / 2;
      d += ' Q ' + p0[0].toFixed(1) + ' ' + p0[1].toFixed(1) + ' ' + mx.toFixed(1) + ' ' + my.toFixed(1);
    }
    var last = points[points.length - 1];
    d += ' T ' + last[0].toFixed(1) + ' ' + last[1].toFixed(1);
    return d;
  }

  function cardMarkup(name, moodId, events) {
    var m = V.mood(moodId);
    var pitched = events.filter(function (e) { return !e.rest; });
    var lo = Math.min.apply(null, pitched.map(function (e) { return e.midi; }).concat([60]));
    var hi = Math.max.apply(null, pitched.map(function (e) { return e.midi; }).concat([72]));
    var band = { top: 300, bottom: 500 };
    function yFor(midi) {
      if (hi === lo) return (band.top + band.bottom) / 2;
      return band.bottom - (midi - lo) / (hi - lo) * (band.bottom - band.top);
    }
    var xStart = 110, xEnd = 1090;
    var span = Math.max(1, events.length - 1);
    var svg = '';
    svg += '<rect x="0" y="0" width="1200" height="630" fill="#efe8d2"/>';
    svg += '<rect x="0" y="0" width="1200" height="10" fill="' + m.color + '"/>';
    // staff-like grid, decorative
    for (var r = 0; r < 5; r++) {
      var ly = band.top - 20 + r * ((band.bottom - band.top + 40) / 4);
      svg += '<line x1="' + xStart + '" y1="' + ly.toFixed(1) + '" x2="' + xEnd + '" y2="' + ly.toFixed(1) + '" stroke="#2c332622" stroke-width="1.5"/>';
    }
    // name + mood
    svg += '<text x="100" y="150" font-family="Georgia,serif" font-size="86" fill="#2c3326">' + esc(name || 'a name') + '</text>';
    svg += '<text x="100" y="200" font-family="ui-monospace,Menlo,monospace" font-size="20" letter-spacing="2" fill="' + m.color + '">YOUR NAME IS IN ' + m.label.toUpperCase() + ' ' + m.emoji + '</text>';
    // curve + dots, breaking the line across rests
    var groups = [];
    var cur = [];
    events.forEach(function (ev, i) {
      var x = xStart + (i / span) * (xEnd - xStart);
      if (ev.rest) { if (cur.length) { groups.push(cur); cur = []; } return; }
      cur.push([x, yFor(ev.midi), ev]);
    });
    if (cur.length) groups.push(cur);
    groups.forEach(function (g) {
      if (g.length > 1) svg += '<path d="' + smoothPath(g.map(function (p) { return [p[0], p[1]]; })) + '" fill="none" stroke="' + m.color + '" stroke-width="2.5" stroke-opacity="0.55" stroke-linecap="round"/>';
    });
    groups.forEach(function (g) {
      g.forEach(function (p) {
        var ev = p[2];
        var r = ev.cadence ? 15 : ev.vowel ? 11 : 6.5;
        svg += '<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="' + r + '" fill="' + m.color + '" data-note-i="' + events.indexOf(ev) + '" ' + (ev.cadence ? 'stroke="#2c3326" stroke-width="2"' : '') + '/>';
      });
    });
    svg += '<text x="100" y="580" font-family="ui-monospace,Menlo,monospace" font-size="14" letter-spacing="2" fill="#2c332688">POINTCAST · KEYBOARD · NAME SONG</text>';
    return svg;
  }

  function esc(s) { return String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function highlightNote(i) {
    document.querySelectorAll('#cardSvg circle[data-note-i]').forEach(function (c) {
      var on = Number(c.getAttribute('data-note-i')) === i;
      c.setAttribute('stroke', on ? '#ffffff' : (c.hasAttribute('data-cadence') ? '#2c3326' : 'none'));
      c.setAttribute('stroke-width', on ? '3' : '0');
    });
  }

  function drawCard() {
    var name = $('name').value.trim();
    var svgEl = $('cardSvg');
    if (!name) {
      $('cardEmpty').hidden = false;
      svgEl.hidden = true;
      $('save').disabled = true;
      $('copy').disabled = true;
      lastCard = null;
      return;
    }
    var moodId = activeMood();
    var events = buildEvents(name, moodId);
    lastCard = { name: name, mood: moodId, events: events };
    svgEl.innerHTML = cardMarkup(name, moodId, events);
    $('cardEmpty').hidden = true;
    svgEl.hidden = false;
    $('save').disabled = false;
    $('copy').disabled = false;
  }

  // ---- typing -------------------------------------------------------------------
  var prevTypedNote = null;
  function paintMeta() { $('meta').textContent = $('name').value.length + ' / ' + MAX; }
  $('name').addEventListener('input', function (ev) {
    clearTimeout(pauseTimer);
    if (!$('name').value) overrideMood = null; // empty field: forget any manual mood pick
    paintMoodLine();
    drawCard();
    paintMeta();
    if (ev.inputType === 'insertText' && ev.data) {
      var m = activeMood();
      for (var i = 0; i < ev.data.length; i++) {
        var n = V.noteFor(ev.data[i], m, prevTypedNote);
        if (n != null) { prevTypedNote = n; if (sound) V.play(n, m); }
      }
    }
    if (!$('name').value.trim()) { prevTypedNote = null; return; }
    pauseTimer = setTimeout(runSong, 900);
  });
  $('name').addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'Enter') { e.preventDefault(); clearTimeout(pauseTimer); runSong(); }
  });

  function runSong() {
    var name = $('name').value.trim();
    if (!name) return;
    var moodId = activeMood();
    drawCard();
    playSong(name, moodId);
  }
  $('play').addEventListener('click', function () { clearTimeout(pauseTimer); runSong(); });

  function load(name, moodId) {
    $('name').value = name;
    overrideMood = moodId || null;
    prevTypedNote = null;
    paintMoodLine();
    drawCard();
    paintMeta();
    clearTimeout(pauseTimer);
    playSong(name, activeMood());
  }

  // ---- save + share -----------------------------------------------------------
  function slugify(s) { return String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'name'; }

  $('save').addEventListener('click', function () {
    if (!lastCard) return;
    var svgEl = $('cardSvg');
    var xml = new XMLSerializer().serializeToString(svgEl);
    if (!/^<svg[^>]+xmlns=/.test(xml)) xml = xml.replace('<svg', '<svg xmlns="http://www.w3.org/2000/svg"');
    var svgBlob = new Blob([xml], { type: 'image/svg+xml;charset=utf-8' });
    var url = URL.createObjectURL(svgBlob);
    var img = new Image();
    var done = false;
    function fallback() {
      if (done) return;
      done = true;
      var a = document.createElement('a');
      a.href = URL.createObjectURL(svgBlob);
      a.download = 'name-song-' + slugify(lastCard.name) + '.svg';
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
    }
    img.onload = function () {
      try {
        var canvas = document.createElement('canvas');
        canvas.width = 1200; canvas.height = 630;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, 1200, 630);
        canvas.toBlob(function (blob) {
          if (!blob) return fallback();
          if (done) return;
          done = true;
          var a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'name-song-' + slugify(lastCard.name) + '.png';
          a.click();
          setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
        }, 'image/png');
      } catch (e) { fallback(); }
      URL.revokeObjectURL(url);
    };
    img.onerror = fallback;
    img.src = url;
  });

  function b64url(str) {
    var bytes = new TextEncoder().encode(str), bin = '';
    for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function unb64url(s) {
    var bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text).catch(function () {});
    var box = $('link');
    box.select();
    try { document.execCommand('copy'); } catch (e) { /* still shown on screen */ }
    return Promise.resolve();
  }
  $('copy').addEventListener('click', function () {
    if (!lastCard) return;
    var payload = { v: 1, n: lastCard.name, m: lastCard.mood };
    var url = location.origin + '/keyboard/name#n=' + b64url(JSON.stringify(payload));
    $('link').value = url;
    $('linkbox').classList.add('show');
    copyText(url);
  });

  // ---- name wall ----------------------------------------------------------------
  function miniStrip(events) {
    var pitched = events.filter(function (e) { return !e.rest; });
    if (!pitched.length) return '';
    var lo = Math.min.apply(null, pitched.map(function (e) { return e.midi; }));
    var hi = Math.max.apply(null, pitched.map(function (e) { return e.midi; }));
    var w = 100, h = 16;
    var bars = pitched.slice(0, 20).map(function (e, i) {
      var x = (i / Math.max(1, Math.min(pitched.length, 20) - 1)) * (w - 4);
      var y = hi === lo ? h / 2 : h - 2 - (e.midi - lo) / (hi - lo) * (h - 4);
      return '<rect x="' + x.toFixed(1) + '" y="' + y.toFixed(1) + '" width="2.5" height="2.5" rx="1"/>';
    }).join('');
    return '<svg viewBox="0 0 ' + w + ' ' + h + '" fill="currentColor" aria-hidden="true">' + bars + '</svg>';
  }
  WALL.forEach(function (name) {
    var moodId = autoMoodFor(name);
    var events = buildEvents(name, moodId);
    var m = V.mood(moodId);
    var b = document.createElement('button');
    b.type = 'button';
    b.style.color = m.color;
    b.innerHTML = '<strong style="color:' + m.color + '">' + esc(name) + '</strong>' + miniStrip(events) + '<span>' + m.label + '</span>';
    b.addEventListener('click', function () { load(name, moodId); });
    $('wall').appendChild(b);
  });

  // ---- receiving a shared card --------------------------------------------------
  function decodeHash(hash) {
    var m = /^#n=([A-Za-z0-9_-]{2,600})$/.exec(hash || '');
    if (!m) return null;
    try {
      var d = JSON.parse(unb64url(m[1]));
      if (!d || typeof d.n !== 'string' || !d.n.trim()) return null;
      return { n: d.n.slice(0, MAX), m: V.mood(d.m).id };
    } catch (e) { return null; }
  }
  function showReceived(d) {
    $('receive').hidden = false;
    $('compose').hidden = true;
    var events = buildEvents(d.n, d.m);
    $('cardSvgR').innerHTML = cardMarkup(d.n, d.m, events);
    var m = V.mood(d.m);
    document.documentElement.style.setProperty('--mood', m.color);
    $('envLabel').textContent = d.n + '’s song, in ' + m.label;
    document.title = d.n + '’s song · Name Song · PointCast';
    $('hear').addEventListener('click', function once() {
      playSong(d.n, d.m);
    });
  }
  function route() {
    var d = decodeHash(location.hash);
    if (d) showReceived(d);
    else { $('receive').hidden = true; $('compose').hidden = false; }
  }

  // ---- sound toggle ---------------------------------------------------------------
  function paintSound() {
    $('sound').setAttribute('aria-pressed', String(sound));
    $('sound').textContent = sound ? '♪ Sound on' : '♪ Sound off';
  }
  $('sound').addEventListener('click', function () { sound = !sound; paintSound(); persist(); });

  addEventListener('hashchange', route);
  addEventListener('pagehide', function () { if (window.PointCastKeyboard) window.PointCastKeyboard.flush(); });

  paintSound();
  paintMoodLine();
  paintMeta();
  paintHistory();
  route();
})();
</script>
</body>
</html>
