---
const title = 'Meadow · PointCast';
const description = 'Plant a hillside meadow with your keyboard. Flowers grow, hum their own slow notes, and bees turn them into a wandering melody.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/meadow">
<meta property="og:title" content="Meadow">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box} body{margin:0;min-width:0;min-height:100vh;background:radial-gradient(ellipse at 85% 0,#30483266,transparent 42%),var(--bg);color:var(--ink)}
a{color:var(--gold)} button,input{font:inherit} button{min-height:44px;padding:9px 15px;border:1px solid var(--line);border-radius:30px;background:#142019;color:var(--ink);cursor:pointer;font-size:11px;touch-action:manipulation}button:hover{background:#1d3020;border-color:var(--moss)}button[aria-pressed=true],button.primary{background:var(--gold);border-color:var(--gold);color:var(--bg)}button.danger:hover{background:#422d24;border-color:var(--petal)}:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}.brand{margin:0;font:normal 30px Georgia,serif;letter-spacing:-1px}.brand:before{content:'✳';color:var(--gold);margin-right:12px}.brand small{display:block;margin:6px 0 0 44px;color:var(--dim);font:9px ui-monospace,SFMono-Regular,monospace;letter-spacing:.2em;text-transform:uppercase}nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}nav a{padding:8px 11px;border-radius:20px;color:var(--dim);text-decoration:none}nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:960px;margin:0 auto;padding:22px 20px 62px;display:flex;flex-direction:column;gap:15px}.hint,.card{border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#1a2a1b,#111c15)}.hint{margin:0;padding:11px 14px;color:var(--dim);font-size:11px;line-height:1.7}.hint b{font-weight:normal;color:var(--gold)}.card{padding:14px}.meadow-wrap{position:relative;overflow:hidden;padding:0;background:#0c1711}.meadow-wrap:focus-within{outline:2px solid var(--gold);outline-offset:3px}.scene{display:block;width:100%;height:auto;min-height:345px;touch-action:manipulation;cursor:crosshair}.empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;color:#d2dec1;font:20px Georgia,serif;pointer-events:none;text-shadow:0 1px 4px #101813}.empty span{display:block;margin-top:8px;color:#b3c8a4;font:10px ui-monospace,SFMono-Regular,monospace;letter-spacing:.08em;text-transform:uppercase}.empty[hidden]{display:none}
.controls{display:flex;flex-wrap:wrap;align-items:center;gap:11px}.control{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 4px}.control label{color:var(--dim);font-size:10px;white-space:nowrap}.control output{min-width:14px;color:var(--gold);font:16px Georgia,serif;text-align:right}input[type=range]{width:min(150px,30vw);height:44px;accent-color:var(--sun)}.spacer{flex:1}.status{min-height:18px;color:var(--gold);font-size:10px}.under{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field-note{font:14px/1.55 Georgia,serif;color:#d9e2cf}.eyebrow{display:block;margin-bottom:7px;color:var(--fern);font-size:9px;letter-spacing:.18em;text-transform:uppercase}.legend{display:flex;flex-wrap:wrap;gap:7px;margin-top:9px}.legend span{padding:5px 8px;border:1px solid var(--line);border-radius:20px;color:var(--dim);font-size:9px}.legend i{display:inline-block;width:7px;height:7px;margin-right:5px;border-radius:50%;background:var(--c);vertical-align:middle}.count{font:25px Georgia,serif;color:var(--gold)}.quiet{margin:5px 0 0;color:var(--dim);font-size:10px;line-height:1.55}
@media(max-width:620px){header{padding:14px}.brand small{margin-left:0}main{padding:16px 14px 48px}.scene{min-height:330px}.under{grid-template-columns:1fr}.controls{gap:7px}.control{flex:1 1 145px;justify-content:space-between}input[type=range]{width:105px}.spacer{display:none}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.scene{cursor:default}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Meadow<small>Grow a chord under a big sky</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <button type="button" id="sound" aria-pressed="true">♪ Sound on</button>
</header>
<main>
  <p class="hint"><b>Plant with A–Z or 0–9,</b> or tap the hill. Each row grows a different kind of flower. Give the meadow a moment: every bloom hums its own slow note, and the bees will find a path through it.</p>
  <section class="card meadow-wrap" aria-label="Your growing meadow">
    <canvas class="scene" id="scene" width="920" height="480" tabindex="0" aria-label="Hillside meadow. Tap to plant a seed; use letters and numbers to plant by keyboard."></canvas>
    <div class="empty" id="empty">The hill is waiting.<span>Tap the grass or press a key to plant the first seed.</span></div>
  </section>
  <section class="card controls" aria-label="Meadow controls">
    <button type="button" class="danger" id="scythe" aria-label="Scythe the meadow and clear all flowers">⌁ Scythe</button>
    <div class="control"><label for="pollinators">Pollinators</label><input id="pollinators" type="range" min="0" max="7" value="3"><output id="beeValue">3</output></div>
    <div class="control"><label for="hum">Hum volume</label><input id="hum" type="range" min="0" max="100" value="42"><output id="humValue">42</output></div>
    <span class="spacer"></span><span class="count" id="count">0</span><span class="quiet">flowers<br>growing here</span>
  </section>
  <p class="status" id="status" role="status" aria-live="polite"></p>
  <div class="under">
    <aside class="card field-note"><span class="eyebrow">Field note</span>Many flowering plants rely on bees and other animals for pollination. Bees can see ultraviolet patterns on some petals that human eyes cannot, which may help guide them to nectar and pollen.</aside>
    <aside class="card"><span class="eyebrow">Seed rows</span><div class="legend"><span><i style="--c:#e7a3b3"></i>poppy</span><span><i style="--c:#b5a8ee"></i>lupine</span><span><i style="--c:#f2c14e"></i>daisy</span><span><i style="--c:#f6bb55"></i>sunflower</span><span><i style="--c:#a9c98a"></i>clover</span></div><p class="quiet">At 20 flowers, look toward the sky.</p></aside>
  </div>
</main>
<script is:inline src="/keyboard.js" data-app="keyboard-meadow" async></script>
<script is:inline>
(function () {
  'use strict';
  var STORE_KEY = 'pc-meadow-v1';
  var W = 920, H = 480, GROW_MS = 6000, SKY_MS = 240000;
  var scene = document.getElementById('scene'), ctx = scene.getContext('2d');
  var empty = document.getElementById('empty'), status = document.getElementById('status');
  var countEl = document.getElementById('count'), soundBtn = document.getElementById('sound');
  var pollinators = document.getElementById('pollinators'), hum = document.getElementById('hum');
  var beeValue = document.getElementById('beeValue'), humValue = document.getElementById('humValue');
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var keys = '1234567890qwertyuiopasdfghjklzxcvbnm';
  var keyRows = { '1': 0, '2': 0, '3': 0, '4': 0, '5': 4, '6': 3, '7': 3, '8': 3, '9': 3, '0': 4 };
  'qwertyuiop'.split('').forEach(function (k) { keyRows[k] = 1; });
  'asdfghjkl'.split('').forEach(function (k) { keyRows[k] = 2; });
  'zxcvbnm'.split('').forEach(function (k) { keyRows[k] = 3; });
  var species = [
    { name: 'sunflower', petal: '#f2c14e', center: '#8a6a4a', leaf: '#7fa36b', base: 50 },
    { name: 'poppy', petal: '#e7a3b3', center: '#1d4a55', leaf: '#7fa36b', base: 57 },
    { name: 'lupine', petal: '#b5a8ee', center: '#ede9d7', leaf: '#a9c98a', base: 62 },
    { name: 'daisy', petal: '#ede9d7', center: '#f2c14e', leaf: '#7fa36b', base: 67 },
    { name: 'clover', petal: '#a9c98a', center: '#e7a3b3', leaf: '#7fa36b', base: 72 }
  ];
  var state = { v: 1, flowers: [], bees: 3, hum: 42, muted: false, celebrated: false, skyStarted: Date.now() };
  var falling = [], bees = [], lastFrame = 0, running = true, lastSave = 0, signalQueue = [], signalTimer = null;
  var ac = null, master = null, lastNotice = '';

  function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
  function hash(n) { var x = Math.sin(n * 999.91) * 43758.5453; return x - Math.floor(x); }
  function hill(x) { return 315 + Math.sin(x * 5.2) * 20 + Math.sin(x * 13.1 + 1) * 8 + (x - .5) * 35; }
  function midiFor(key, row) { var i = keys.indexOf(key); return species[row].base + [0,2,4,7,9][Math.max(0, i) % 5] + (Math.floor(Math.max(0, i) / 10) % 2) * 12; }
  function voiceOffset() { var p = ((Date.now() - state.skyStarted) % SKY_MS) / SKY_MS; return p < .22 ? -5 : p < .55 ? 0 : p < .8 ? 2 : -2; }
  function currentSky() { return ((Date.now() - state.skyStarted) % SKY_MS) / SKY_MS; }
  function say(message) { lastNotice = message; status.textContent = message; }
  function save() { try { localStorage.setItem(STORE_KEY, JSON.stringify({ v: 1, flowers: state.flowers.slice(-80), bees: state.bees, hum: state.hum, muted: state.muted, celebrated: state.celebrated, skyStarted: state.skyStarted })); } catch (e) {} }
  function load() {
    try {
      var raw = localStorage.getItem(STORE_KEY); if (!raw) return;
      var saved = JSON.parse(raw); if (!saved || !Array.isArray(saved.flowers)) return;
      state.flowers = saved.flowers.filter(function (f) { return f && isFinite(f.x) && isFinite(f.planted) && isFinite(f.note) && f.x >= 0 && f.x <= 1; }).slice(-80);
      var savedBees = Number(saved.bees), savedHum = Number(saved.hum);
      state.bees = clamp(isFinite(savedBees) ? savedBees : 3, 0, 7); state.hum = clamp(isFinite(savedHum) ? savedHum : 42, 0, 100);
      state.muted = !!saved.muted; state.celebrated = !!saved.celebrated; state.skyStarted = isFinite(saved.skyStarted) ? saved.skyStarted : Date.now();
      if (state.flowers.length) say(state.flowers.length + ' flowers remembered the night. Their stems have grown a little.');
    } catch (e) {}
  }
  function audio() {
    if (!ac) {
      ac = new (window.AudioContext || window.webkitAudioContext)(); master = ac.createGain(); master.gain.value = state.muted ? 0 : .32;
      var comp = ac.createDynamicsCompressor(); comp.threshold.value = -22; comp.knee.value = 16; comp.ratio.value = 8; comp.attack.value = .01; comp.release.value = .25;
      master.connect(comp).connect(ac.destination);
    }
    if (ac.state === 'suspended') ac.resume(); return ac;
  }
  function hz(midi) { return 440 * Math.pow(2, (midi - 69) / 12); }
  function tone(midi, bright, when, length, level) {
    if (state.muted || !ac) return;
    var c = ac, t = when || c.currentTime, f = hz(midi), gain = c.createGain(), filter = c.createBiquadFilter();
    filter.type = 'lowpass'; filter.frequency.value = bright ? 3400 : 1400; gain.gain.setValueAtTime(.0001, t);
    gain.gain.exponentialRampToValueAtTime((level || .06) * (bright ? 1.45 : 1), t + .025);
    gain.gain.exponentialRampToValueAtTime(.0001, t + (length || 1.6)); gain.connect(filter).connect(master);
    [[1, bright ? 'sine' : 'triangle', 1], [2.01, 'sine', .34], [3.98, 'sine', .12]].forEach(function (p) {
      var o = c.createOscillator(), g = c.createGain(); o.type = p[1]; o.frequency.value = f * p[0]; g.gain.value = p[2]; o.connect(g).connect(gain); o.start(t); o.stop(t + (length || 1.6) + .04);
    });
  }
  function queueSignal(note) {
    signalQueue.push(note);
    if (!signalTimer) signalTimer = setTimeout(flushSignal, 5000);
  }
  function flushSignal() {
    signalTimer = null; if (!signalQueue.length || !window.PointCastKeyboard) return;
    var ordered = signalQueue.splice(0); while (ordered.length) window.PointCastKeyboard.note(ordered.splice(0, 64), null, { sound: false });
  }
  function flowerAt(x, row, note) {
    var now = Date.now(), id = now + Math.random() * 1000;
    return { id: id, x: clamp(x, .025, .975), row: row, note: note, planted: now, seed: Math.floor(Math.random() * 1000000), nextHum: now + 1700 + Math.random() * 4000 };
  }
  function plant(x, row, note, fromTap) {
    audio();
    var f = flowerAt(x, row, note); state.flowers.push(f); if (state.flowers.length > 80) state.flowers.shift();
    tone(note, true, ac.currentTime, .72, .13); queueSignal(note); lastFrame = 0; save();
    say((fromTap ? 'A ' : '') + species[row].name + ' seed is waking up.');
    if (state.flowers.length === 20 && !state.celebrated) celebrate();
  }
  function celebrate() {
    state.celebrated = true; save(); say('Twenty flowers! A butterfly opens the sky, and the meadow answers.');
    if (!state.muted && ac) { [60,64,67,72,76].forEach(function (n, i) { tone(n + voiceOffset(), true, ac.currentTime + i * .16, 1.7, .09); }); }
  }
  function keyPlant(key) {
    var k = key.toLowerCase(), row = keyRows[k]; if (row == null) return false;
    var rowKeys = row === 0 ? '1234567890' : row === 1 ? 'qwertyuiop' : row === 2 ? 'asdfghjkl' : row === 3 ? 'zxcvbnm' : '123450';
    var index = rowKeys.indexOf(k); if (index < 0) index = keys.indexOf(k);
    var x = (.07 + (index / Math.max(1, rowKeys.length - 1)) * .86) + (hash(Date.now()) - .5) * .018;
    plant(x, row, midiFor(k, row), false); return true;
  }
  function tapPlant(e) {
    var r = scene.getBoundingClientRect(), x = clamp((e.clientX - r.left) / r.width, .025, .975);
    var relY = (e.clientY - r.top) / r.height, row = relY < .38 ? 4 : relY < .56 ? 1 : relY < .72 ? 2 : 3;
    plant(x, row, species[row].base + [0,2,4,7,9][Math.floor(x * 5) % 5], true);
  }
  function adjustBees() {
    while (bees.length < state.bees) bees.push({ x: .5, y: .22, tx: .5, ty: .22, target: -1, next: 0, phase: Math.random() * 10 });
    while (bees.length > state.bees) bees.pop();
  }
  function chooseFlower(bee, now) {
    if (!state.flowers.length) return; var idx = Math.floor(Math.random() * state.flowers.length), f = state.flowers[idx];
    bee.target = idx; bee.tx = f.x; bee.ty = (hill(f.x) - Math.min(150, 55 + hash(f.seed) * 85)) / H; bee.next = now + 2800 + Math.random() * 3600;
  }
  function beeLand(bee) {
    var f = state.flowers[bee.target]; if (!f) return; f.bright = Date.now() + 650; queueSignal(f.note); if (ac && !state.muted) tone(f.note + 12 + voiceOffset(), true, ac.currentTime, .8, .085);
  }
  function drawSky(p) {
    var stops = p < .25 ? ['#b5a8ee','#6fb3b8'] : p < .58 ? ['#6fb3b8','#dce5bc'] : p < .82 ? ['#e7a3b3','#8a6a4a'] : ['#263758','#101c2c'];
    var grad = ctx.createLinearGradient(0,0,0,H); grad.addColorStop(0,stops[0]); grad.addColorStop(1,stops[1]); ctx.fillStyle = grad; ctx.fillRect(0,0,W,H);
    var sunX = 80 + p * 760, sunY = 105 + Math.sin(p * Math.PI) * -62; ctx.fillStyle = p > .84 || p < .08 ? '#f2c14e88' : '#fff3b8aa'; ctx.beginPath(); ctx.arc(sunX,sunY,25,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#1d4a5533'; for (var i=0;i<5;i++) { ctx.beginPath(); ctx.arc(120+i*190,105+(i%2)*32,30+i*4,0,Math.PI*2); ctx.fill(); }
  }
  function drawHill() {
    ctx.beginPath(); ctx.moveTo(0,H); for (var x=0;x<=W;x+=8) ctx.lineTo(x,hill(x/W)); ctx.lineTo(W,H); ctx.closePath(); var grad=ctx.createLinearGradient(0,270,0,H); grad.addColorStop(0,'#7fa36b');grad.addColorStop(1,'#1d4a55');ctx.fillStyle=grad;ctx.fill();
    ctx.strokeStyle='#a9c98a55';ctx.lineWidth=1; for(var i=0;i<100;i++){var x=hash(i*31)*W,y=hill(x/W)+hash(i*41)*95;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+(hash(i*17)-.5)*4,y-5-hash(i)*8);ctx.stroke();}
  }
  function drawFlower(f, now) {
    var age = clamp((now-f.planted)/GROW_MS,0,1), sp=species[f.row], x=f.x*W, ground=hill(f.x), h=(55+hash(f.seed)*90)*age, y=ground-h;
    ctx.save(); ctx.lineCap='round'; ctx.strokeStyle=sp.leaf;ctx.lineWidth=2+age*2;ctx.beginPath();ctx.moveTo(x,ground); var bends=4; for(var i=1;i<=bends;i++){var t=i/bends, sway=(hash(f.seed+i*7)-.5)*15*Math.sin(t*Math.PI);ctx.lineTo(x+sway,ground-h*t);}ctx.stroke();
    for(var l=1;l<4;l++){var t=(l/4)*age;if(t>.06){var sy=ground-h*t,s=9+hash(f.seed+l*3)*8;ctx.fillStyle=sp.leaf;ctx.beginPath();ctx.ellipse(x+(l%2?1:-1)*s*.55,sy,s,.42*s,(l%2?-.7:.7),0,Math.PI*2);ctx.fill();}}
    if(age>.68){var bloom=(age-.68)/.32, r=(8+hash(f.seed+9)*5)*bloom, bright=f.bright>now;ctx.globalAlpha=bright?1:.94; if(sp.name==='lupine'){for(var j=0;j<6;j++){ctx.fillStyle=sp.petal;ctx.beginPath();ctx.arc(x+(hash(f.seed+j)-.5)*10,y+j*4,r*.48,0,Math.PI*2);ctx.fill();}}else if(sp.name==='clover'){for(var c=0;c<3;c++){ctx.fillStyle=sp.petal;ctx.beginPath();ctx.arc(x+Math.cos(c*2.09)*r*.55,y+Math.sin(c*2.09)*r*.55,r*.65,0,Math.PI*2);ctx.fill();}}else{for(var a=0;a<(sp.name==='sunflower'?14:9);a++){ctx.fillStyle=sp.petal;ctx.beginPath();ctx.ellipse(x+Math.cos(a*6.283/(sp.name==='sunflower'?14:9))*r,y+Math.sin(a*6.283/(sp.name==='sunflower'?14:9))*r,r*.7,r*.3,a*6.283/9,0,Math.PI*2);ctx.fill();}}ctx.fillStyle=sp.center;ctx.beginPath();ctx.arc(x,y,Math.max(2,r*.38),0,Math.PI*2);ctx.fill();}
    ctx.restore();
  }
  function drawBee(bee, now) {
    if (!state.flowers.length) return; if (now >= bee.next || bee.target < 0) chooseFlower(bee,now);
    var dx=bee.tx-bee.x,dy=bee.ty-bee.y,d=Math.sqrt(dx*dx+dy*dy); if(d<.007&&bee.target>=0){if(!bee.landed){bee.landed=true;beeLand(bee);} if(now>bee.next-1200) chooseFlower(bee,now);}else{bee.landed=false;bee.x+=dx*.018;bee.y+=dy*.018;}
    var x=bee.x*W,y=bee.y*H+Math.sin(now/150+bee.phase)*3;ctx.save();ctx.fillStyle='#f2c14e';ctx.beginPath();ctx.ellipse(x,y,5,3,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#1d4a55';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(x-1,y-3);ctx.lineTo(x-1,y+3);ctx.moveTo(x+2,y-3);ctx.lineTo(x+2,y+3);ctx.stroke();ctx.fillStyle='#ede9d7aa';ctx.beginPath();ctx.ellipse(x-3,y-4,4,2,-.5,0,Math.PI*2);ctx.ellipse(x+3,y-4,4,2,.5,0,Math.PI*2);ctx.fill();ctx.restore();
  }
  function drawButterfly(now) { if (!state.celebrated) return; var x=(Math.sin(now/900)*.28+.5)*W,y=75+Math.sin(now/600)*18;ctx.save();ctx.translate(x,y);ctx.fillStyle='#e7a3b3';ctx.beginPath();ctx.ellipse(-6,0,8,5,Math.sin(now/110)*.7,0,Math.PI*2);ctx.ellipse(6,0,8,5,-Math.sin(now/110)*.7,0,Math.PI*2);ctx.fill();ctx.fillStyle='#1d4a55';ctx.fillRect(-1,-4,2,8);ctx.restore(); }
  function drawFalling(now) { falling=falling.filter(function(f){f.vy+=(now-f.last)*.00012;f.y+=f.vy*(now-f.last);f.rot+=.002*(now-f.last);f.last=now;ctx.save();ctx.translate(f.x,f.y);ctx.rotate(f.rot);ctx.strokeStyle=f.color;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(0,20);ctx.stroke();ctx.fillStyle=f.petal;ctx.beginPath();ctx.arc(0,0,7,0,Math.PI*2);ctx.fill();ctx.restore();return f.y<H+30;}); }
  function humFlowers(now) { if (!ac || state.muted || document.hidden) return; state.flowers.forEach(function(f){if(now>=f.nextHum){var age=clamp((now-f.planted)/GROW_MS,0,1);if(age>.55)tone(f.note+voiceOffset(),false,ac.currentTime,2.8,.012+(state.hum/100)*.055);f.nextHum=now+4200+hash(f.seed+now)*5200;}}); }
  function render(now) { if (!running) return; if (document.hidden || (reduced && lastFrame)) { requestAnimationFrame(render); return; } lastFrame=now; drawSky(currentSky());drawHill();state.flowers.forEach(function(f){drawFlower(f,now);});adjustBees();bees.forEach(function(b){drawBee(b,now);});drawButterfly(now);drawFalling(now);humFlowers(now);empty.hidden=state.flowers.length>0;countEl.textContent=String(state.flowers.length);if(now-lastSave>9000){save();lastSave=now;}requestAnimationFrame(render); }
  document.addEventListener('keydown',function(e){if(e.repeat||e.metaKey||e.ctrlKey||e.altKey)return;var tag=e.target&&e.target.tagName;if(tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT')return;if(keyPlant(e.key)){e.preventDefault();}});
  scene.addEventListener('pointerdown',function(e){e.preventDefault();tapPlant(e);});
  document.getElementById('scythe').addEventListener('click',function(){if(!state.flowers.length){say('The hill is clear. Plant a seed when you are ready.');return;}audio();var now=Date.now();state.flowers.forEach(function(f,i){var sp=species[f.row];falling.push({x:f.x*W,y:hill(f.x)-40,vy:0,rot:0,color:sp.leaf,petal:sp.petal,last:now});});if(!state.muted&&ac){[72,69,65,62,57,53,50].forEach(function(n,i){tone(n, false, ac.currentTime+i*.09,.55,.07);});}state.flowers=[];state.celebrated=false;lastFrame=0;save();say('The flowers bowed into the grass. The hill is ready again.');});
  pollinators.addEventListener('input',function(){state.bees=Number(pollinators.value);beeValue.textContent=String(state.bees);save();});hum.addEventListener('input',function(){state.hum=Number(hum.value);humValue.textContent=String(state.hum);save();});
  soundBtn.addEventListener('click',function(){state.muted=!state.muted;if(master)master.gain.value=state.muted?0:.32;soundBtn.setAttribute('aria-pressed',String(!state.muted));soundBtn.textContent=state.muted?'♪ Sound off':'♪ Sound on';save();if(!state.muted)say('Sound will join when you plant the next seed.');});
  document.addEventListener('visibilitychange',function(){if(document.hidden){save();flushSignal();}});addEventListener('pagehide',function(){save();flushSignal();});
  load();pollinators.value=String(state.bees);hum.value=String(state.hum);beeValue.textContent=String(state.bees);humValue.textContent=String(state.hum);soundBtn.setAttribute('aria-pressed',String(!state.muted));soundBtn.textContent=state.muted?'♪ Sound off':'♪ Sound on';requestAnimationFrame(render);
})();
</script>
</body>
</html>
