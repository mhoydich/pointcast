---
// Keyboard Bloom. Notes stay in browser storage.
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Keyboard Bloom · Garden V2</title><meta name="description" content="A quiet notebook with musical typing, local autosave, and a growing garden of ideas."><link rel="canonical" href="https://pointcast.xyz/keyboard/garden">
<style is:inline>
:root{color-scheme:dark;--bg:#0b1412;--panel:#101c19;--line:#263a32;--ink:#e1ebe3;--dim:#93aa9f;--gold:#e6c98a;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink)}button,input,textarea,select{font:inherit;color:inherit}button,select{background:transparent;border:1px solid var(--line);border-radius:7px;padding:9px 12px;cursor:pointer}button:hover{background:#1b2d25;border-color:#688777}button:disabled{opacity:.4;cursor:default}button[aria-pressed=true],.primary{background:var(--gold);color:var(--bg);border-color:var(--gold)}:focus-visible{outline:2px solid var(--gold);outline-offset:3px}header{height:87px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 30px;gap:20px}.brand{margin:0;font-weight:normal;font-family:Georgia,serif;font-size:28px;white-space:nowrap}.brand em{color:var(--gold)}.tag{font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:var(--dim);margin-top:7px}.toolbar{display:flex;gap:9px;align-items:center;font-size:11px}.app{display:grid;grid-template-columns:280px 1fr;height:calc(100dvh - 87px)}.sidebar{border-right:1px solid var(--line);background:var(--panel);padding:24px 16px;display:flex;flex-direction:column;min-height:0;gap:16px}.side-top{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--dim)}#search{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:7px;padding:12px;font-size:12px}.notes{overflow:auto;flex:1}.note{display:block;text-align:left;width:100%;border-color:transparent;padding:17px 12px;margin-bottom:6px}.note.selected{background:#1e3028;border-color:#415b4c}.note strong{font-family:Georgia,serif;font-size:17px;font-weight:normal;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.note small{display:block;font-size:10px;color:var(--dim);margin-top:9px;line-height:1.6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.privacy{font-size:10px;color:var(--dim);line-height:1.7}.side-bottom{display:flex;gap:6px;flex-wrap:wrap}.side-bottom button{font-size:10px}.workspace{display:flex;flex-direction:column;min-width:0;min-height:0;position:relative}.editor-tools{display:flex;align-items:center;justify-content:space-between;padding:23px 36px;font-size:10px;color:var(--dim);gap:12px}.editor-tools button{font-size:10px}.paper{width:min(850px,100%);padding:24px 58px 0;margin:0 auto;flex:1;display:flex;flex-direction:column;min-height:160px}#title{border:0;background:transparent;width:100%;font-family:Georgia,serif;font-size:44px;line-height:1.2;padding:0 0 20px;outline:none}#body{border:0;background:transparent;resize:none;width:100%;flex:1;line-height:1.9;font-family:Georgia,serif;font-size:20px;outline:none;padding:0 0 20px}#title::placeholder{color:#718d7d}#body::placeholder{color:#688172}.statusbar{padding:14px 36px;display:flex;justify-content:space-between;gap:12px;color:var(--dim);font-size:10px}.garden{border-top:1px solid var(--line);padding:17px 36px 23px;background:linear-gradient(0deg,#13211a,transparent)}.garden-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:15px;font-size:10px;color:var(--dim)}.keys{display:flex;gap:5px;justify-content:center}.key{width:40px;height:35px;padding:0;background:#1a2b22;border-color:#334c3d;color:#b5cab9;font-size:10px;box-shadow:0 3px 0 #070e0a;transition:background .15s,transform .15s}.key.lit{background:var(--gold);color:#0b1412;transform:translateY(2px)}#notice{color:var(--gold)}.empty{font-size:12px;line-height:1.8;color:var(--dim);padding:16px}.focus .sidebar,.focus .garden{display:none}.focus .app{grid-template-columns:1fr}[hidden]{display:none!important}#restore{color:var(--gold)}@media(max-width:760px){header{height:auto;min-height:100px;padding:20px;flex-wrap:wrap}.brand{font-size:24px}.toolbar{flex-wrap:wrap}.app{height:auto;min-height:calc(100dvh - 100px);grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid var(--line);padding:16px}.notes{display:flex;max-height:110px;flex:none}.note{min-width:180px;max-width:220px}.privacy{display:none}.workspace{min-height:70dvh}.paper{padding:20px 24px 0}#title{font-size:34px}#body{min-height:260px}.editor-tools,.statusbar{padding:16px 24px}.garden{padding:16px 24px}.key{width:8%;height:33px}.garden-top{flex-wrap:wrap}.focus .workspace{min-height:80dvh}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}

/* Bloom notebook: warm paper, colored keys, a quiet living margin. */
:root{--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d}
body{background:radial-gradient(ellipse at 86% 0%,#34413255,transparent 43%),var(--bg)}
header{height:94px;padding:0 32px;background:#101813b8;backdrop-filter:blur(20px)}
.brand{letter-spacing:-1.3px;font-size:31px}.brand:before{content:'✳';display:inline-block;font-family:Georgia,serif;color:var(--gold);font-size:35px;margin-right:13px;vertical-align:middle}.tag{margin-left:48px;font-size:9px;letter-spacing:.2em}
.toolbar button,.toolbar select{border-radius:30px;padding:11px 15px;background:#1e2b20}.toolbar button[aria-pressed=true]{background:var(--gold)}
.app{height:calc(100dvh - 94px);grid-template-columns:282px 1fr}
.sidebar{padding:26px 17px 18px;background:linear-gradient(155deg,#1d2c20,#111d16)}
.side-top{font-size:10px;letter-spacing:.1em}.primary{border-radius:25px;padding:10px 13px;letter-spacing:0;box-shadow:0 3px 12px #0003}
#search{background:#0d171180;border-radius:9px;border-color:#354833;padding:13px 14px}
.note{position:relative;padding:18px 14px 17px 24px;border-bottom:1px solid #2b3c2e;border-radius:9px;transition:background .2s,border-color .2s}
.note:before{content:'';position:absolute;left:10px;top:25px;width:4px;height:4px;background:#7f9876;border-radius:50%}.note.selected{background:linear-gradient(110deg,#354732aa,#253623aa);border-color:#72846777;box-shadow:0 5px 20px #0002}.note.selected:before{background:var(--gold);box-shadow:0 0 9px #dfc48d66}.note strong{font-size:18px}.note small{font-size:10px;color:#a1b296}
.side-bottom button{border-radius:20px}.privacy{margin-bottom:0;color:#a0ad95}.workspace{background:radial-gradient(ellipse at 75% 90%,#26372550,transparent 55%)}
.editor-tools{padding:24px 38px}.editor-tools button{border-color:transparent;color:#acb59e}.editor-tools button:hover{border-color:var(--line)}
.paper{padding:12px 58px 0;position:relative;max-width:900px}.paper:before{content:'FIELD NOTES / ' attr(data-number);font-size:9px;letter-spacing:.23em;color:#afbd99;display:block;padding-bottom:32px;flex:none}
#title{font-size:clamp(34px,4vw,55px);letter-spacing:-1.5px;color:#ece7d0;padding-bottom:22px}#body{color:#d5dbc5;font-size:21px;line-height:1.85;caret-color:var(--gold)}
.statusbar{padding:16px 38px;color:#9bab90}#saved:before{content:'●';font-size:7px;color:#c4d5a5;vertical-align:2px;margin-right:8px}
.garden{position:relative;margin:10px 30px 22px;border:1px solid #40533a88;border-radius:16px;background:linear-gradient(135deg,#253b27,#18281d 50%,#233126);padding:20px 24px 23px;box-shadow:0 16px 45px #0002,inset 0 1px 0 #d3dfac0c;overflow:hidden}
.garden:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 110%,#c6d87a14,transparent 65%)}
.garden-top{font-size:9px;letter-spacing:.04em;position:relative;z-index:1}.garden-top>span:first-child{color:#c7d4b0;letter-spacing:.14em}.keys{gap:9px;position:relative;z-index:1}.key{--tone:#b7cb9b;width:56px;height:49px;border-radius:9px;background:color-mix(in srgb,var(--tone) 13%,#1a281c);border:1px solid color-mix(in srgb,var(--tone) 40%,#233321);color:var(--tone);box-shadow:0 5px 0 #09100b,0 6px 10px #0004,inset 0 1px 0 #fff1;font-size:12px}
.key:nth-child(3n+1){--tone:#dfbe8e}.key:nth-child(3n+2){--tone:#b3c8a4}.key:nth-child(3n){--tone:#9dbbbb}.key.lit{background:var(--tone);color:#132218;box-shadow:0 0 28px color-mix(in srgb,var(--tone) 35%,transparent),0 2px 0 #09100b;transform:translateY(3px)}
.bloom-orbit{position:absolute;right:41px;top:94px;width:55px;height:55px;pointer-events:none;opacity:.55;transition:transform 1s ease,opacity 1s ease}.bloom-orbit i{position:absolute;width:19px;height:29px;left:18px;top:2px;border:1px solid #acbc8e;border-radius:60% 60% 50% 50%;transform-origin:50% 26px}.bloom-orbit i:nth-child(2){transform:rotate(60deg)}.bloom-orbit i:nth-child(3){transform:rotate(120deg)}.bloom-orbit i:nth-child(4){transform:rotate(180deg)}.bloom-orbit i:nth-child(5){transform:rotate(240deg)}.bloom-orbit i:nth-child(6){transform:rotate(300deg)}.bloom-orbit.alive{transform:rotate(30deg) scale(1.15);opacity:1}
.focus .paper{max-width:850px;padding-top:45px}.focus .bloom-orbit{display:none}
@media(max-width:760px){header{height:auto;padding:19px 20px;gap:19px}.brand{font-size:27px}.tag{font-size:8px;margin-left:45px}.toolbar{width:100%;gap:6px}.toolbar button,.toolbar select{padding:9px 11px;font-size:10px}.app{height:auto;grid-template-columns:1fr}.sidebar{padding:18px 20px;gap:13px}.note{min-width:180px}.notes{gap:8px;max-height:105px}.side-bottom{gap:7px}.side-bottom button{padding:7px 10px}.paper{padding:16px 24px 0}.paper:before{padding-bottom:23px}.editor-tools{padding:17px 24px}.bloom-orbit{display:none}#title{font-size:36px}#body{font-size:19px}.garden{margin:8px 16px 16px;padding:17px 15px 20px}.garden-top{line-height:1.7;gap:6px}.keys{gap:5px}.key{width:10%;height:41px;font-size:11px}.statusbar{padding:16px 24px}.workspace{min-height:75dvh}}
@media(prefers-reduced-motion:reduce){.bloom-orbit,.key,.note{transition:none!important}}

.versions{display:flex;gap:4px;align-items:center;font-size:10px}.versions a{color:var(--dim);text-decoration:none;padding:9px 11px;border-radius:20px;white-space:nowrap}.versions a[aria-current=page]{background:#2c3e2b;color:var(--ink)}.versions small{font-size:8px;color:var(--gold)}@media(max-width:1150px){header{height:auto;min-height:110px;flex-wrap:wrap;padding-block:15px;gap:15px}.app{height:calc(100dvh - 110px)}}@media(max-width:760px){.versions{order:3;flex-wrap:wrap}.versions a{padding:7px 10px}.app{height:auto}}

.app{grid-template-columns:250px minmax(0,1fr) 290px}.paper{padding-inline:35px}.illustrator{border-left:1px solid var(--line);padding:25px 20px;background:linear-gradient(170deg,#243021,#142017);overflow:auto;min-height:0}.illustrator h2{font-family:Georgia,serif;font-size:25px;font-weight:normal;margin:10px 0}.eyebrow{font-size:9px;letter-spacing:.15em;color:var(--gold)}.illustrator p{font-size:11px;line-height:1.8;color:#acbda0}.artwork{margin:23px 0 15px;background:#e6dfc6;border-radius:120px 120px 12px 12px;overflow:hidden;box-shadow:0 12px 30px #0003;aspect-ratio:4/5}.artwork svg{width:100%;height:100%;display:block}.art-controls{display:flex;gap:8px;flex-wrap:wrap}.art-controls button,.art-controls select{font-size:10px;padding:9px}.art-controls .primary{width:100%;margin-top:6px}.illustrator label{font-size:10px;color:var(--dim)}#scene{width:100%;margin:8px 0 3px}.attached-art{display:flex;align-items:center;gap:17px;margin:0 0 20px;padding:12px;border:1px solid var(--line);border-radius:10px}.attached-art svg{width:65px;height:80px;border-radius:5px;background:#e6dfc6}.attached-art figcaption{font-size:11px;color:var(--dim);line-height:1.7;flex:1}.attached-art button{font-size:10px}.paper:before{padding-bottom:20px}#title{font-size:42px}.bloom-orbit{display:none}.garden{margin-inline:20px;padding-inline:15px}.garden-top{flex-wrap:wrap;line-height:1.6}.key{width:42px;height:42px}.statusbar{font-size:9px}#art-status{color:var(--gold);font-size:10px;min-height:32px;line-height:1.7;margin-top:15px}.illustrator .micro{font-size:9px;color:#99ad90}.focus .illustrator{display:none}.focus .app{grid-template-columns:1fr}
@media(max-width:1100px){.app{grid-template-columns:220px minmax(0,1fr)}.illustrator{grid-column:1/-1;display:grid;grid-template-columns:200px 1fr;gap:10px 25px;overflow:visible;border-top:1px solid var(--line)}.illustrator .artwork{grid-column:1;grid-row:1/8;margin:0}.illustrator>*{grid-column:2}.illustrator h2{margin:0}.app{height:auto}.workspace{min-height:75dvh}.sidebar{min-height:75dvh}}
@media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{min-height:0}.paper{padding-inline:24px}#title{font-size:35px}.illustrator{padding:24px;grid-template-columns:1fr}.illustrator>*{grid-column:1}.illustrator .artwork{grid-row:auto;max-width:280px;justify-self:center;width:100%;margin-block:15px}.illustrator .intro{grid-row:1}.illustrator .art-controls{justify-content:center}.illustrator .primary{max-width:280px}.attached-art{margin-bottom:16px}}
.sound-options{position:relative;z-index:1;display:flex;justify-content:center;align-items:center;gap:18px;font-size:9px;color:var(--dim);margin:0 0 18px;flex-wrap:wrap}.sound-options label{display:flex;align-items:center;gap:7px}.sound-options select{font-size:10px;padding:5px 8px;border-radius:20px}.sound-options input{width:80px;accent-color:var(--gold)}.sound-options>span{font-size:9px}.focus .sound-options{display:none}

body[data-skin=midnight]{--bg:#10111f;--panel:#191b2d;--line:#373a56;--ink:#e2e3f6;--dim:#a3a5c4;--gold:#b5a8ee;--wash:#252744;--sheet:#18192c}
body[data-skin=paper]{color-scheme:light;--bg:#f3eedf;--panel:#e5dfcd;--line:#c7bfa7;--ink:#37392b;--dim:#6b6d58;--gold:#797448;--wash:#ddd5be;--sheet:#f3eedf}
body[data-skin=rose]{--bg:#261b23;--panel:#33232d;--line:#62434f;--ink:#f1dfdb;--dim:#c6a3af;--gold:#e7b7a9;--wash:#49303c;--sheet:#2c2029}
body[data-skin=cobalt]{--bg:#101c3a;--panel:#172a50;--line:#354e7c;--ink:#e1eafd;--dim:#a1b8dd;--gold:#e3c876;--wash:#253d65;--sheet:#152242}
body[data-skin]:not([data-skin=moss]){background:var(--bg)}body[data-skin]:not([data-skin=moss]) header{background:var(--bg)}body[data-skin]:not([data-skin=moss]) .sidebar,body[data-skin]:not([data-skin=moss]) .illustrator{background:var(--panel)}body[data-skin]:not([data-skin=moss]) .workspace{background:var(--sheet)}body[data-skin]:not([data-skin=moss]) .garden{background:var(--wash);border-color:var(--line)}body[data-skin]:not([data-skin=moss]) #title,body[data-skin]:not([data-skin=moss]) #body{color:var(--ink)}body[data-skin]:not([data-skin=moss]) .note.selected,body[data-skin]:not([data-skin=moss]) .toolbar button,body[data-skin]:not([data-skin=moss]) .toolbar select,body[data-skin]:not([data-skin=moss]) .versions a[aria-current=page]{background:var(--wash);color:var(--ink);border-color:var(--line)}body[data-skin]:not([data-skin=moss]) #search{background:var(--bg);border-color:var(--line)}body[data-skin]:not([data-skin=moss]) .note small,body[data-skin]:not([data-skin=moss]) .privacy,body[data-skin]:not([data-skin=moss]) .garden-top>span:first-child,body[data-skin]:not([data-skin=moss]) .paper:before,body[data-skin]:not([data-skin=moss]) .illustrator p{color:var(--dim)}body[data-skin]:not([data-skin=moss]) .key{background:var(--panel);border-color:var(--line);color:var(--ink)}body[data-skin]:not([data-skin=moss]) .key.lit{background:var(--gold);color:var(--bg)}body[data-skin]:not([data-skin=moss]) .toolbar button[aria-pressed=true]{background:var(--gold);color:var(--bg)}body[data-skin=paper] #notice{color:#656037}body[data-skin=paper] .statusbar,body[data-skin=paper] .editor-tools,body[data-skin=paper] .editor-tools button{color:#666b55}.sound-options{gap:12px}.toolbar{flex-wrap:wrap}.toolbar select{max-width:140px}.app{min-height:650px}
@media(max-width:760px){.app{min-height:0}.toolbar select{max-width:115px}.sound-options{justify-content:flex-start}.sound-options>span{display:none}}
.sidebar,.illustrator{min-width:0}.paper{min-width:0}.notes{min-width:0}@media(max-width:760px){.app{grid-template-columns:minmax(0,1fr)}.editor-tools{flex-wrap:wrap}.attached-art{margin-inline:0}.attached-art button{padding:7px}.statusbar{flex-wrap:wrap}}
#title:focus-visible,#body:focus-visible{outline:1px solid var(--line);outline-offset:5px;border-radius:3px}
</style></head><body>
<header><div><h1 class="brand">Keyboard <em>Bloom</em></h1><div class="tag">Where thoughts take shape · V2</div></div><nav class="versions" aria-label="Keyboard versions"><a href="/keyboard">Notes</a><a href="/keyboard/garden" aria-current="page">Garden <small>V2</small></a><a href="/keyboard/play">Original instrument ↗</a></nav><div class="toolbar"><button id="sound" aria-pressed="false">♪ Sound off</button><select id="voice" aria-label="Typing voice"><option value="bloom">Bloom</option><option value="piano">Soft piano</option><option value="glass">Glass bells</option><option value="harp">Harp</option><option value="marimba">Marimba</option><option value="reed">Reed</option><option value="pad">Cloud pad</option><option value="pluck">Moon pluck</option></select><select id="skin" aria-label="Visual skin"><option value="moss">Moss</option><option value="midnight">Midnight</option><option value="paper">Paper</option><option value="rose">Rose</option><option value="cobalt">Cobalt</option></select><button id="focus" aria-pressed="false">Focus</button><button id="export">Export note ↓</button></div></header>
<div class="app"><aside class="sidebar" aria-label="Notebook"><div class="side-top"><span>YOUR NOTES <span id="total"></span></span><button class="primary" id="new">+ New note</button></div><input id="search" type="search" aria-label="Search notes" placeholder="Search your thoughts…"><nav class="notes" id="notes" aria-label="Saved notes"></nav><div class="side-bottom"><button id="backup">Back up all</button><button id="import">Import backup</button><button id="trash" aria-pressed="false">Trash</button></div><p class="privacy">Saved in this browser, on this device.<br>Back up your notes to keep a copy.</p></aside>
<main class="workspace"><div class="editor-tools"><span id="date"></span><div><button id="restore" hidden>Restore note</button> <button id="delete">Move to trash</button></div></div><div class="bloom-orbit" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><section class="paper" data-number="01" aria-label="Note editor"><input id="title" aria-label="Note title" placeholder="Untitled thought" maxlength="300"><figure class="attached-art" id="attached" hidden><div id="attached-image"></div><figcaption id="attached-caption"></figcaption><button id="remove-art">Remove</button></figure><textarea id="body" aria-label="Note body" placeholder="Start anywhere. A thought, a list, a little possibility…" spellcheck="true"></textarea></section><div class="statusbar"><span id="saved" role="status">Saved on this device</span><span id="count">0 words</span></div><div class="garden"><div class="garden-top"><span>LET YOUR WORDS MAKE A LITTLE MUSIC</span><span id="notice" role="status">Turn sound on for gentle notes as you type.</span></div><div class="sound-options"><label>Mood <select id="mood"><option value="clean">Clear morning</option><option value="slow">Slow + reverb</option><option value="tape">Tape echoes</option><option value="dream">Dream room</option></select></label><label>Scale <select id="music-scale"><option value="pent">Sunny pentatonic</option><option value="minor">Night garden</option><option value="dorian">Dorian drift</option><option value="whole">Dream tones</option></select></label><label>Volume <input id="volume" type="range" min="0" max="100" value="45" aria-label="Music volume"></label><span>Try a sound. Find your rhythm.</span></div><div class="keys" id="keys" aria-label="Musical keys"></div></div></main><aside class="illustrator" aria-label="Illustration studio"><div class="intro"><span class="eyebrow">A GARDEN FOR YOUR IDEAS</span><h2>Let it take shape.</h2><p>Write a little. Watch a flower grow, or find a scene in your words.</p></div><div class="artwork" id="artwork" role="img" aria-label="Flower illustration"></div><div><label for="scene">ILLUSTRATION</label><select id="scene"><option value="auto">Inspired by my words</option><option value="flowers">Flowers</option><option value="ocean">Ocean</option><option value="mountains">Mountains</option><option value="space">Night sky</option><option value="city">City</option></select></div><p id="art-caption"></p><div class="art-controls"><button id="variation">Another variation ↻</button><button id="save-art">Save image ↓</button><button id="attach-art" class="primary">+ Add to this note</button><button id="export-page">Save illustrated note ↓</button></div><div id="art-status" role="status"></div><p class="micro">Made on your device from simple word cues. No AI request, no upload. Your attached illustration stays with the note and its backup.</p></aside></div><input type="file" id="file" accept="application/json,.json" hidden>
<script is:inline>
(()=>{'use strict';
const $=id=>document.getElementById(id),KEY='pointcast.keyboard.notes.v1';
let audioBus,reverbSend,delaySend;
let data={version:1,notes:[],selected:null},trash=false,sound=false,ctx,saveFailed=false,loadedOK=true,initialNote=false;
const fresh=()=>({id:crypto.randomUUID(),title:'',body:'',created:Date.now(),updated:Date.now(),deleted:false});
function valid(n){return n&&typeof n.id==='string'&&typeof n.title==='string'&&typeof n.body==='string'&&Number.isFinite(n.created)&&Number.isFinite(n.updated)&&typeof n.deleted==='boolean'}
try{const raw=localStorage.getItem(KEY);if(raw){const parsed=JSON.parse(raw);if(parsed.version!==1||!Array.isArray(parsed.notes)||!parsed.notes.every(valid))throw Error('Invalid backup');data=parsed}}catch(e){loadedOK=false;$('saved').textContent='Existing notes could not be loaded. Export new work before closing.'}
if(!data.notes.length){initialNote=true;const n=fresh();data.notes.push(n);data.selected=n.id}
const current=()=>data.notes.find(n=>n.id===data.selected);
function persist(){if(!loadedOK)return;try{localStorage.setItem(KEY,JSON.stringify(data));saveFailed=false;$('saved').textContent='Saved on this device'}catch(e){saveFailed=true;$('saved').textContent='Could not save — export your note before closing.'}}
function title(n){return n.title.trim()||'Untitled thought'}
function render(){const q=$('search').value.trim().toLowerCase();$('notes').replaceChildren();$('total').textContent=data.notes.filter(n=>!n.deleted).length;const list=data.notes.filter(n=>n.deleted===trash&&(!q||(n.title+' '+n.body).toLowerCase().includes(q))).sort((a,b)=>b.updated-a.updated);for(const n of list){const b=document.createElement('button');b.className='note'+(n.id===data.selected?' selected':'');b.setAttribute('aria-current',n.id===data.selected?'true':'false');const t=document.createElement('strong');t.textContent=title(n);const s=document.createElement('small');s.textContent=n.body.replace(/\s+/g,' ').slice(0,65)||'A blank page, all yours.';b.append(t,s);b.onclick=()=>{data.selected=n.id;persist();render();editor()};$('notes').append(b)}if(!list.length){const e=document.createElement('div');e.className='empty';e.textContent=q?'No matching notes.':trash?'The trash is empty.':'Your next thought starts here.';$('notes').append(e)}$('trash').setAttribute('aria-pressed',trash)}
function counts(){const text=$('body').value.trim();const words=text?text.split(/\s+/u).length:0;$('count').textContent=words+' '+(words===1?'word':'words')+' · '+$('body').value.length+' characters'}
function editor(){const n=current();document.querySelector('.paper').dataset.number=String(Math.max(1,data.notes.filter(n=>!n.deleted).findIndex(x=>x.id===n?.id)+1)).padStart(2,'0');$('title').value=n?.title||'';$('body').value=n?.body||'';$('title').disabled=$('body').disabled=!n||n.deleted;$('delete').disabled=!n||n.deleted;$('export').disabled=!n;$('restore').hidden=!n?.deleted;$('date').textContent=n?'CREATED '+new Date(n.created).toLocaleDateString(undefined,{month:'long',day:'numeric',year:'numeric'}):'YOUR NOTEBOOK';counts();renderAttached()}
for(const id of ['title','body'])$(id).addEventListener('input',()=>{const n=current();if(!n||n.deleted)return;n.title=$('title').value;n.body=$('body').value;n.updated=Date.now();bloom();persist();render();counts();updateArt()});
$('new').onclick=()=>{const n=fresh();data.notes.push(n);data.selected=n.id;trash=false;$('search').value='';persist();render();editor();$('title').focus()};
$('search').oninput=render;
$('trash').onclick=()=>{trash=!trash;data.selected=data.notes.find(n=>n.deleted===trash)?.id||null;persist();render();editor()};
$('delete').onclick=()=>{const n=current();if(!n)return;n.deleted=true;n.updated=Date.now();data.selected=data.notes.find(n=>!n.deleted)?.id||null;persist();render();editor();$('notice').textContent='Note moved to Trash. You can restore it anytime.'};
$('restore').onclick=()=>{const n=current();if(!n)return;n.deleted=false;trash=false;persist();render();editor();$('notice').textContent='Note restored.'};
function download(text,name,type){const url=URL.createObjectURL(new Blob([text],{type}));const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
$('export').onclick=()=>{const n=current();if(n)download('# '+title(n)+'\n\n'+n.body+'\n',title(n).replace(/[^a-z0-9_-]/gi,'-').slice(0,80)+'.md','text/markdown')};
$('backup').onclick=()=>download(JSON.stringify(data,null,2),'keyboard-bloom-notes-'+new Date().toISOString().slice(0,10)+'.json','application/json');
$('import').onclick=()=>$('file').click();$('file').onchange=async()=>{const file=$('file').files[0];if(!file)return;try{if(file.size>10000000)throw Error();const incoming=JSON.parse(await file.text());if(incoming.version!==1||!Array.isArray(incoming.notes)||!incoming.notes.every(valid))throw Error();const imported=incoming.notes.map(n=>({...n,id:crypto.randomUUID()}));data.notes.push(...imported);if(imported.length){data.selected=imported[0].id;trash=imported[0].deleted}$('search').value='';persist();render();editor();$('notice').textContent=imported.length+' notes imported. Existing notes kept.'}catch(e){$('notice').textContent='That file is not a valid Notes backup (maximum 10 MB).'}finally{$('file').value=''}};
$('focus').onclick=()=>{const active=document.body.classList.toggle('focus');$('focus').setAttribute('aria-pressed',active);$('focus').textContent=active?'Exit focus':'Focus'};
let bloomTimer;function bloom(){const b=document.querySelector('.bloom-orbit');b.classList.add('alive');clearTimeout(bloomTimer);bloomTimer=setTimeout(()=>b.classList.remove('alive'),850)}
const letters='ASDFGHJKL',steps=[0,2,4,7,9,12,14,16,19];for(const letter of letters){const b=document.createElement('button');b.className='key';b.textContent=letter;b.setAttribute('aria-label','Play '+letter);b.onclick=()=>{sound=true;syncSound();play(letter)};$('keys').append(b)}
function syncSound(){if(audioBus)audioBus.gain.setTargetAtTime(sound?Number($('volume').value)/100:0,ctx.currentTime,.04);$('sound').setAttribute('aria-pressed',sound);$('sound').textContent=sound?'♪ Sound on':'♪ Sound off';$('notice').textContent=sound?'Your words, a little music. Choose a mood below.':'Turn sound on for gentle notes as you type.'}
$('sound').onclick=()=>{sound=!sound;syncSound();if(sound)play('A')};
const PREF='pointcast.keyboard.notes.preferences';
function preferences(){try{localStorage.setItem(PREF,JSON.stringify(Object.fromEntries(['skin','voice','mood','music-scale','volume'].map(id=>[id,$(id).value]))))}catch(e){}}
try{const prefs=JSON.parse(localStorage.getItem(PREF)||'{}');for(const id of ['skin','voice','mood','music-scale','volume']){const el=$(id),value=prefs[id];if(id==='volume'){if(Number.isFinite(Number(value))&&value!==undefined)el.value=String(Math.max(0,Math.min(100,Number(value))))}else if([...el.options].some(o=>o.value===value))el.value=value}}catch(e){}
document.body.dataset.skin=$('skin').value;for(const id of ['skin','voice','mood','music-scale','volume'])$(id).addEventListener('change',()=>{document.body.dataset.skin=$('skin').value;preferences()});
function setupAudio(){if(ctx)return;ctx=new AudioContext();audioBus=ctx.createGain();audioBus.gain.value=Number($('volume').value)/100;const compressor=ctx.createDynamicsCompressor();compressor.threshold.value=-20;compressor.ratio.value=6;audioBus.connect(compressor);compressor.connect(ctx.destination);const verb=ctx.createConvolver(),length=Math.floor(ctx.sampleRate*3.6),impulse=ctx.createBuffer(2,length,ctx.sampleRate);for(let c=0;c<2;c++){const samples=impulse.getChannelData(c);for(let i=0;i<length;i++)samples[i]=(Math.random()*2-1)*Math.pow(1-i/length,2.8)}verb.buffer=impulse;reverbSend=ctx.createGain();reverbSend.gain.value=.5;reverbSend.connect(verb);verb.connect(audioBus);const delay=ctx.createDelay(2),feedback=ctx.createGain(),filter=ctx.createBiquadFilter();delay.delayTime.value=.34;feedback.gain.value=.32;filter.type='lowpass';filter.frequency.value=1700;delaySend=ctx.createGain();delaySend.gain.value=.35;delaySend.connect(delay);delay.connect(filter);filter.connect(feedback);feedback.connect(delay);filter.connect(audioBus)}
const moods={clean:{pitch:1,length:1,wet:0,echo:0},slow:{pitch:.749,length:2.1,wet:.65,echo:.1},tape:{pitch:.944,length:1.2,wet:.12,echo:.45},dream:{pitch:.5,length:2.8,wet:.8,echo:.2}};
const scales={pent:[0,2,4,7,9,12,14,16,19],minor:[0,3,5,7,10,12,15,17,19],dorian:[0,2,3,5,7,9,10,12,14],whole:[0,2,4,6,8,10,12,14,16]};
const voices={bloom:{type:'sine',attack:.015,tail:.65,harmonics:[1,.16]},piano:{type:'sine',attack:.007,tail:1,harmonics:[1,.24,.08]},glass:{type:'sine',attack:.005,tail:1.5,harmonics:[1,.18,.08],ratios:[1,2.76,5.4]},harp:{type:'triangle',attack:.008,tail:.85,harmonics:[1,.08]},marimba:{type:'sine',attack:.006,tail:.26,harmonics:[1,.3],ratios:[1,4]},reed:{type:'triangle',attack:.035,tail:.4,harmonics:[1,.12]},pad:{type:'sine',attack:.14,tail:1.45,harmonics:[1,.3]},pluck:{type:'triangle',attack:.004,tail:.36,harmonics:[1,.2],ratios:[1,2]}};
function play(key){if(!sound||Number($('volume').value)===0)return;try{setupAudio();audioBus.gain.setTargetAtTime(Number($('volume').value)/100,ctx.currentTime,.04);if(ctx.state==='suspended')ctx.resume();const index=letters.includes(key)?letters.indexOf(key):key.charCodeAt(0)%steps.length,notes=scales[$('music-scale').value],v=voices[$('voice').value],mood=moods[$('mood').value],now=ctx.currentTime,frequency=220*mood.pitch*Math.pow(2,notes[index]/12),volume=Number($('volume').value)/100;v.harmonics.forEach((weight,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type=v.type;o.frequency.value=frequency*(v.ratios?.[i]||i+1);g.gain.setValueAtTime(0,now);g.gain.linearRampToValueAtTime(Math.max(.0001,.08*weight),now+v.attack);g.gain.exponentialRampToValueAtTime(.0001,now+v.attack+v.tail*mood.length);o.connect(g);g.connect(audioBus);const wet=ctx.createGain(),echo=ctx.createGain();wet.gain.value=mood.wet;echo.gain.value=mood.echo;g.connect(wet);wet.connect(reverbSend);g.connect(echo);echo.connect(delaySend);o.start(now);o.stop(now+v.attack+v.tail*mood.length+.02);o.onended=()=>{o.disconnect();g.disconnect();wet.disconnect();echo.disconnect()}});const b=$('keys').children[index];b.classList.add('lit');setTimeout(()=>b.classList.remove('lit'),180)}catch(e){sound=false;syncSound();$('notice').textContent='Sound is unavailable in this browser.'}}
$('volume').oninput=()=>{if(audioBus)audioBus.gain.setTargetAtTime(sound?Number($('volume').value)/100:0,ctx.currentTime,.04)};
$('mood').onchange=()=>{if(sound)play('A')};$('voice').onchange=()=>{if(sound)play('A')};$('music-scale').onchange=()=>{if(sound)play('D')};

for(const id of ['title','body'])$(id).addEventListener('input',e=>{if(e.inputType==='insertText'&&!e.isComposing&&/^[a-z]$/i.test(e.data||''))play(e.data.toUpperCase())});
window.addEventListener('beforeunload',e=>{if(saveFailed||!loadedOK){e.preventDefault();e.returnValue=''}});
window.addEventListener('storage',e=>{if(e.key!==KEY||!e.newValue||!loadedOK)return;try{const incoming=JSON.parse(e.newValue);if(incoming.version!==1||!Array.isArray(incoming.notes)||!incoming.notes.every(valid))return;const n=current(),next=incoming.notes.find(x=>x.id===data.selected);const same=!!n&&!!next&&n.title===next.title&&n.body===next.body&&n.deleted===next.deleted&&JSON.stringify(n.illustration)===JSON.stringify(next.illustration);if(saveFailed||(!same&&['title','body'].includes(document.activeElement?.id))){loadedOK=false;$('saved').textContent='This note changed in another tab. Export your work before reloading.';return}const selected=data.selected;data=incoming;data.selected=data.notes.some(x=>x.id===selected)?selected:data.notes.find(x=>!x.deleted)?.id||null;render();if(!same)editor()}catch(e){}});

const TOPICS=['flowers','ocean','mountains','space','city'];let variation=0,choice='auto',artNow;
function safeArt(a){return a&&TOPICS.includes(a.topic)&&Number.isFinite(a.seed)&&Number.isFinite(a.growth)}
function esc(t){return String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function topicFor(text){const cues={ocean:/\b(ocean|sea|wave|beach|water|surf|coast|tide)\b/gi,mountains:/\b(mountain|hike|trail|forest|hill|summit|camp)\b/gi,space:/\b(moon|star|night|dream|space|sky|planet)\b/gi,city:/\b(city|street|building|office|train|town|urban)\b/gi};let winner='flowers',score=0;for(const [name,re]of Object.entries(cues)){const n=(text.match(re)||[]).length;if(n>score){score=n;winner=name}}return winner}
function svgArt(a){let seed=Math.abs(a.seed)%2147483647||1;const rand=()=>{seed=seed*16807%2147483647;return seed/2147483647};const ink='#496044',pink=['#c67b61','#d2a154','#8e9d65','#bc827e'];let shapes='<rect width="320" height="400" fill="#e6dfc6"/><circle cx="242" cy="84" r="35" fill="#d4ad68" opacity=".7"/>';
if(a.topic==='flowers'){const count=Math.min(7,3+Math.floor(a.growth/25));for(let i=0;i<count;i++){const x=48+i*224/(count-1),y=105+rand()*125,r=12+rand()*10,c=pink[Math.floor(rand()*pink.length)];shapes+=`<path d="M${x} 365 Q${x-32} 270 ${x} ${y}" fill="none" stroke="${ink}" stroke-width="2"/><ellipse cx="${x-14}" cy="${y+85}" rx="8" ry="27" transform="rotate(-40 ${x-14} ${y+85})" fill="#718263"/><ellipse cx="${x+9}" cy="${y+118}" rx="7" ry="22" transform="rotate(40 ${x+9} ${y+118})" fill="#899677"/>`;for(let j=0;j<6;j++){const angle=j*Math.PI/3;shapes+=`<ellipse cx="${x+Math.cos(angle)*r*.8}" cy="${y+Math.sin(angle)*r*.8}" rx="${r*.66}" ry="${r*.85}" transform="rotate(${j*60} ${x+Math.cos(angle)*r*.8} ${y+Math.sin(angle)*r*.8})" fill="${c}" opacity=".9"/>`}shapes+=`<circle cx="${x}" cy="${y}" r="6" fill="#6b573b"/>`}}
if(a.topic==='ocean'){for(let i=0;i<8;i++){const y=155+i*29+rand()*15;shapes+=`<path d="M-20 ${y} Q60 ${y-38} 160 ${y} T340 ${y} L340 420 H-20Z" fill="${['#94b6ae','#759b94','#58817d','#446d69'][i%4]}"/>`}}
if(a.topic==='mountains'){shapes+='<path d="M-40 340 92 108 230 340Z" fill="#91a085"/><path d="M60 380 229 125 390 380Z" fill="#60795e"/><path d="m180 200 49-75 47 75-47-29Z" fill="#e9e8d5"/><path d="M0 360 Q180 260 320 350V400H0Z" fill="#3b5946"/>';for(let i=0;i<8;i++){const x=rand()*320,y=320+rand()*60;shapes+=`<path d="m${x} ${y} 12-32 12 32Z" fill="#294c3c"/>`}}
if(a.topic==='space'){shapes='<rect width="320" height="400" fill="#233b3c"/><circle cx="220" cy="108" r="43" fill="#dfc98f"/><circle cx="236" cy="92" r="39" fill="#233b3c"/>';for(let i=0;i<30;i++)shapes+=`<circle cx="${20+rand()*280}" cy="${20+rand()*300}" r="${.6+rand()*1.8}" fill="#e9dfb6"/>`;shapes+='<path d="M0 370Q85 300 155 340T320 320V400H0Z" fill="#496052"/>'}
if(a.topic==='city'){for(let i=0;i<8;i++){const x=i*43-10,y=140+rand()*100;shapes+=`<rect x="${x}" y="${y}" width="38" height="260" fill="${['#687d65','#9a9b77','#b7896c'][i%3]}"/>`;for(let j=0;j<6;j++)shapes+=`<path d="M${x+8} ${y+18+j*25}h7m8 0h7" stroke="#e5d6a5" stroke-width="7"/>`}}
return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 400" role="img" aria-label="${a.topic} illustration"><title>${a.topic} illustration</title>${shapes}<path d="M25 382H295" stroke="#8b9876" opacity=".5"/></svg>`}
function updateArt(){if(!$('artwork'))return;const n=current(),text=(n?.title||'')+' '+(n?.body||'');const topic=choice==='auto'?topicFor(text):choice;let seed=variation+1;for(const c of text.slice(0,30))seed=(seed*31+c.charCodeAt(0))%1000000;artNow={topic,seed,growth:Math.min(120,text.trim().split(/\s+/).length)};$('artwork').innerHTML=svgArt(artNow);$('artwork').setAttribute('aria-label',topic+' illustration');$('art-caption').textContent=choice==='auto'?(topic==='flowers'?'Your flower grows with the length of your note.':(topic==='ocean'?'An ':'A ')+topic+' scene, suggested by words in your note.'):'Your '+topic+' illustration.';$('attach-art').disabled=!n||n.deleted;$('export-page').disabled=!n}
function renderAttached(){const n=current();if(!$('attached'))return;const yes=safeArt(n?.illustration);$('attached').hidden=!yes;if(yes){$('attached-image').innerHTML=svgArt(n.illustration);$('attached-caption').textContent=n.illustration.topic+' · saved with this note';$('remove-art').disabled=n.deleted}updateArt()}
$('scene').onchange=()=>{choice=$('scene').value;updateArt()};$('variation').onclick=()=>{variation++;updateArt()};
$('attach-art').onclick=()=>{const n=current();if(!n||n.deleted)return;n.illustration={...artNow};n.updated=Date.now();persist();renderAttached();$('art-status').textContent=saveFailed||!loadedOK?'Attached in memory. Export this note to keep it.':'Illustration saved with this note.'};
$('remove-art').onclick=()=>{const n=current();if(!n||n.deleted)return;delete n.illustration;persist();renderAttached()};
$('save-art').onclick=()=>download(svgArt(artNow),'bloom-'+artNow.topic+'.svg','image/svg+xml');
$('export-page').onclick=()=>{const n=current();if(!n)return;const art=safeArt(n.illustration)?n.illustration:null;const page='<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+esc(title(n))+'</title><style>body{background:#f1ecd9;color:#263a2a;font:20px/1.7 Georgia,serif;max-width:760px;margin:60px auto;padding:24px}h1{font-size:42px;line-height:1.15}svg{width:240px;max-width:100%;float:right;margin:0 0 24px 30px;border-radius:120px 120px 8px 8px}.body{white-space:pre-wrap;overflow-wrap:anywhere}footer{clear:both;padding-top:40px;font:12px monospace;color:#62755c}</style><h1>'+esc(title(n))+'</h1>'+(art?svgArt(art):'')+'<div class="body">'+esc(n.body)+'</div><footer>Keyboard Bloom · '+new Date(n.created).toLocaleDateString()+'</footer></html>';download(page,title(n).replace(/[^a-z0-9_-]/gi,'-').slice(0,80)+'.html','text/html');$('art-status').textContent=art?'Saved a page with your attached illustration.':'Saved your note. Add an illustration first to include it.'};

if(!current()||current().deleted){data.selected=data.notes.find(n=>!n.deleted)?.id||null}render();editor();updateArt();if(initialNote)persist();
})();
</script></body></html>