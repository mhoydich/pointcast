---
const title = 'Frog Pond · PointCast';
const description = 'A moonlit pond instrument and forgiving call-and-answer rhythm game for five croaking frogs.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/frogs">
<meta property="og:title" content="Frog Pond">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}body{margin:0;min-width:0;background:radial-gradient(ellipse at 80% 0%,#283b3055,transparent 42%),var(--bg);color:var(--ink);min-height:100vh}button{font:inherit;color:inherit;background:#142019;border:1px solid var(--line);border-radius:30px;min-height:44px;padding:9px 14px;cursor:pointer;font-size:11px}button:hover{border-color:var(--fern);background:#203322}button:focus-visible{outline:2px solid var(--sun);outline-offset:3px}button[aria-pressed=true],button.primary{background:var(--gold);border-color:var(--gold);color:var(--bg)}a{color:var(--gold)}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}.brand{margin:0;font-family:Georgia,serif;font-size:30px;font-weight:normal;letter-spacing:-1px}.brand:before{content:'✳';color:var(--gold);margin-right:12px}.brand small{display:block;margin:6px 0 0 44px;color:var(--dim);font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.2em;text-transform:uppercase}nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}.toolbar{display:flex;gap:8px;flex-wrap:wrap}
main{max-width:960px;margin:0 auto;padding:22px 20px 64px;display:grid;gap:15px}.hint,.card{border:1px solid var(--line);border-radius:15px;background:linear-gradient(145deg,#17251b,#111c15)}.hint{margin:0;padding:11px 14px;color:var(--dim);font:12px/1.6 Georgia,serif}.hint b{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:normal;color:var(--gold)}.pond{position:relative;isolation:isolate;overflow:hidden;border:1px solid #405b43;border-radius:19px;aspect-ratio:16/9;min-height:330px;background:#14251e}.pond-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.96}.moonwash{position:absolute;inset:0;background:radial-gradient(circle at 72% 25%,#f2e6a833 0 5%,transparent 20%);pointer-events:none;transition:opacity .8s}.pond.erupt .moonwash{opacity:1;background:radial-gradient(circle at 72% 25%,#fff9bd99 0 5%,#f2c14e44 12%,transparent 28%)}
.scene-label{position:absolute;z-index:3;top:13px;left:14px;padding:6px 9px;border-radius:20px;background:#101813bb;color:var(--fern);font-size:9px;letter-spacing:.15em;text-transform:uppercase}.frog{position:absolute;z-index:2;width:22%;max-width:154px;min-width:74px;aspect-ratio:1;transform:translate(-50%,-50%);border:0;background:transparent;padding:0;border-radius:50%;touch-action:manipulation}.frog:hover{background:transparent;border-color:transparent}.frog:after{content:attr(data-key);position:absolute;right:5%;top:3%;display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--fern);border-radius:50%;background:#101813d9;color:var(--ink);font-size:11px}.frog .art{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 7px 7px #061009aa);transition:opacity .12s,transform .12s}.frog .croak{opacity:0}.frog.call .normal{opacity:0}.frog.call .croak{opacity:1;transform:scale(1.12)}.frog.bull .croak{opacity:0}.frog.bull.call .normal{opacity:1;transform:scale(1.13) translateY(3px)}.frog .ring{position:absolute;inset:10%;border:2px solid transparent;border-radius:50%;pointer-events:none}.frog.lead .ring{border-color:var(--sun);box-shadow:0 0 0 7px #f2c14e33,0 0 25px #f2c14e88}.frog.correct .ring{border-color:var(--fern);box-shadow:0 0 18px #a9c98a99}.frog.wrong{filter:hue-rotate(295deg)}
.f0{left:15%;top:69%}.f1{left:33%;top:53%}.f2{left:52%;top:70%}.f3{left:69%;top:52%}.f4{left:85%;top:71%}.fireflies{position:absolute;z-index:4;inset:0;overflow:hidden;pointer-events:none}.firefly{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--sun);opacity:0;box-shadow:0 0 10px 4px #f2c14e88}.pond.erupt .firefly{opacity:1;animation:rise 2.8s ease-in-out infinite}.firefly:nth-child(1){left:12%;top:72%;animation-delay:.1s}.firefly:nth-child(2){left:25%;top:58%;animation-delay:.7s}.firefly:nth-child(3){left:43%;top:79%;animation-delay:1.3s}.firefly:nth-child(4){left:59%;top:62%;animation-delay:.3s}.firefly:nth-child(5){left:75%;top:75%;animation-delay:1.7s}.firefly:nth-child(6){left:88%;top:51%;animation-delay:.9s}.firefly:nth-child(7){left:67%;top:30%;animation-delay:2s}.firefly:nth-child(8){left:35%;top:34%;animation-delay:1.1s}@keyframes rise{50%{transform:translateY(-28px) scale(1.7);opacity:.9}}
.game{display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px;padding:14px 16px}.eyebrow{display:block;color:var(--dim);font-size:9px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:5px}.game h2{font:normal 21px Georgia,serif;margin:0;color:var(--fern)}.status{margin:5px 0 0;color:var(--dim);font:12px/1.4 Georgia,serif}.score{color:var(--gold);font-size:11px;white-space:nowrap}.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.controls .spacer{flex:1}.legend{padding:12px 15px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;color:var(--dim);font-size:10px}.legend b{font-weight:normal;color:var(--ink)}.field{padding:14px 16px;color:var(--dim);font:13px/1.55 Georgia,serif}.field strong{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--fern);font-size:10px;letter-spacing:.14em;text-transform:uppercase}.field p{margin:5px 0 0}.quiet{font-size:10px;color:#6f876f;min-height:14px}.empty{padding:8px 11px;border-radius:9px;background:#0d1711;color:#69806c;font-size:10px}.pond:not(.started) .frog{opacity:.8}.pond.paused *{animation-play-state:paused!important}@media(max-width:560px){header{padding:14px}.brand small{margin-left:0}main{padding:16px 13px 48px}.pond{min-height:292px;aspect-ratio:auto}.game{grid-template-columns:1fr}.score{order:-1}.frog{width:28%;min-width:66px}.f0{left:13%;top:74%}.f1{left:33%;top:55%}.f2{left:52%;top:74%}.f3{left:70%;top:54%}.f4{left:87%;top:74%}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.firefly{display:none}.pond.erupt .moonwash{opacity:.75}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Frog Pond<small>Five pads. One moonlit answer.</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar"><button type="button" id="sound" aria-pressed="true">♪ Sound on</button></div>
</header>
<main>
  <p class="hint" id="hint"><b>First visit:</b> Press <b>Start a round</b>. Listen to the lead frog, then answer on its glowing pads with <b>A S D F G</b> or a tap. The pond is patient.</p>
  <section class="pond" id="pond" aria-label="Moonlit frog pond instrument">
    <img class="pond-bg" src="/images/keyboard/frogs/pond.jpg" width="1200" height="675" alt="A still moonlit pond with lily pads and reeds">
    <div class="moonwash"></div><span class="scene-label">El Segundo after dark</span>
    <button class="frog f0" data-frog="0" data-key="A" aria-label="A, low chorus frog"><img class="art normal" src="/images/keyboard/frogs/tree-frog.jpg" width="640" height="533" alt="Small Pacific tree frog on a lily pad"><img class="art croak" src="/images/keyboard/frogs/tree-frog-croak.jpg" width="640" height="533" alt="Pacific tree frog calling with its throat sac inflated"><i class="ring"></i></button>
    <button class="frog f1" data-frog="1" data-key="S" aria-label="S, bright chorus frog"><img class="art normal" src="/images/keyboard/frogs/tree-frog.jpg" width="640" height="533" alt="Small Pacific tree frog on a lily pad"><img class="art croak" src="/images/keyboard/frogs/tree-frog-croak.jpg" width="640" height="533" alt="Pacific tree frog calling with its throat sac inflated"><i class="ring"></i></button>
    <button class="frog f2 bull" data-frog="2" data-key="D" aria-label="D, bullfrog"><img class="art normal" src="/images/keyboard/frogs/bullfrog.jpg" width="640" height="640" alt="Large bullfrog on a lily pad"><img class="art croak" src="/images/keyboard/frogs/bullfrog.jpg" width="640" height="640" alt="Large bullfrog calling on a lily pad"><i class="ring"></i></button>
    <button class="frog f3" data-frog="3" data-key="F" aria-label="F, high chorus frog"><img class="art normal" src="/images/keyboard/frogs/tree-frog.jpg" width="640" height="533" alt="Small Pacific tree frog on a lily pad"><img class="art croak" src="/images/keyboard/frogs/tree-frog-croak.jpg" width="640" height="533" alt="Pacific tree frog calling with its throat sac inflated"><i class="ring"></i></button>
    <button class="frog f4" data-frog="4" data-key="G" aria-label="G, moon chorus frog"><img class="art normal" src="/images/keyboard/frogs/tree-frog.jpg" width="640" height="533" alt="Small Pacific tree frog on a lily pad"><img class="art croak" src="/images/keyboard/frogs/tree-frog-croak.jpg" width="640" height="533" alt="Pacific tree frog calling with its throat sac inflated"><i class="ring"></i></button>
    <div class="fireflies" aria-hidden="true"><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i><i class="firefly"></i></div>
  </section>
  <section class="card game" aria-labelledby="game-title"><div><span class="eyebrow">Call and answer</span><h2 id="game-title">Listen. Then croak it back.</h2><p id="status" class="status">The lead frog is waiting for a first round.</p></div><div class="score" id="score">CHORUS 0 / 8</div></section>
  <div class="controls"><button type="button" id="start" class="primary">▶ Start a round</button><button type="button" id="free" aria-pressed="false">Free play</button><button type="button" id="ambient" aria-pressed="false">Night falls</button><span class="spacer"></span><span id="notice" class="quiet" role="status"></span></div>
  <div class="legend"><b>A S D F G</b><span>five pentatonic pads</span><span>•</span><span>Tree frogs say a buzzing two-part “rib-bit”; the bullfrog answers deep.</span></div>
  <aside class="card field"><strong>Field note</strong><p>The small Pacific tree frog, also called the Pacific chorus frog, is known for the classic “ribbit”; it is often said that Hollywood soundtracks used its call.</p></aside>
  <div class="empty" id="empty">No chorus yet. Win a round and another frog will begin keeping the night company.</div>
</main>
<script is:inline src="/keyboard.js" data-app="keyboard-frogs" async></script>
<script is:inline>
(function () {
  'use strict';
  var STORE = 'pc-frogs-v1', KEYS = ['a','s','d','f','g'], MIDI = [57,60,53,64,67];
  var $ = function (s) { return document.getElementById(s); };
  var pond = $('pond'), frogs = Array.prototype.slice.call(document.querySelectorAll('.frog'));
  var soundBtn = $('sound'), startBtn = $('start'), freeBtn = $('free'), ambientBtn = $('ambient'), status = $('status'), score = $('score'), notice = $('notice'), hint = $('hint'), empty = $('empty');
  var state = { wins: 0, sound: true, ambient: false, hintSeen: false };
  try { var saved = JSON.parse(localStorage.getItem(STORE)); if (saved && typeof saved === 'object') { state.wins = Math.max(0, Math.min(8, Number(saved.wins) || 0)); state.sound = saved.sound !== false; state.ambient = !!saved.ambient; state.hintSeen = !!saved.hintSeen; } } catch (e) {}
  var ac = null, bus = null, muted = !state.sound, mode = 'idle', pattern = [], answerAt = 0, answerIndex = 0, leadTimers = [], ambientTimer = null, pending = [], signalTimer = null, hidden = document.hidden;
  function save() { try { localStorage.setItem(STORE, JSON.stringify({ wins: state.wins, sound: state.sound, ambient: state.ambient, hintSeen: state.hintSeen })); } catch (e) {} }
  function say(t) { status.textContent = t; }
  function update() { score.textContent = 'CHORUS ' + state.wins + ' / 8'; soundBtn.setAttribute('aria-pressed', String(state.sound)); soundBtn.textContent = state.sound ? '♪ Sound on' : '♪ Sound off'; ambientBtn.setAttribute('aria-pressed', String(state.ambient)); ambientBtn.textContent = state.ambient ? '☾ Night falls' : '☾ Night falls'; empty.hidden = state.wins > 0; if (state.hintSeen) hint.hidden = true; }
  function audio() { if (!ac) { ac = new (window.AudioContext || window.webkitAudioContext)(); bus = ac.createGain(); bus.gain.value = muted ? 0 : 0.22; var comp = ac.createDynamicsCompressor(); comp.threshold.value = -22; comp.knee.value = 18; comp.ratio.value = 8; bus.connect(comp).connect(ac.destination); } if (ac.state === 'suspended') ac.resume(); return ac; }
  function callTree(frog, when, gain) { var c = audio(), t = when || c.currentTime, f = 185 * Math.pow(2, frog / 12), out = c.createGain(), bp = c.createBiquadFilter(); out.gain.value = gain == null ? 1 : gain; bp.type = 'bandpass'; bp.frequency.value = f * 2.8; bp.Q.value = 5; out.connect(bp).connect(bus); [0, .115].forEach(function (off, i) { var o = c.createOscillator(), g = c.createGain(); o.type = 'sawtooth'; o.frequency.setValueAtTime(f * (i ? 1.12 : 1), t + off); g.gain.setValueAtTime(.0001, t + off); g.gain.exponentialRampToValueAtTime(.34, t + off + .012); g.gain.exponentialRampToValueAtTime(.0001, t + off + .105); o.connect(g).connect(out); o.start(t + off); o.stop(t + off + .13); }); }
  function callBull(when, gain) { var c = audio(), t = when || c.currentTime, out = c.createGain(); out.gain.value = gain == null ? 1 : gain; out.connect(bus); [0,.19,.38].forEach(function (off, i) { var o = c.createOscillator(), g = c.createGain(), lp = c.createBiquadFilter(); o.type = i === 1 ? 'triangle' : 'sine'; o.frequency.value = i === 1 ? 91 : 55; lp.type = 'lowpass'; lp.frequency.value = 330; g.gain.setValueAtTime(.0001,t + off); g.gain.exponentialRampToValueAtTime(.34,t + off + .02); g.gain.exponentialRampToValueAtTime(.0001,t + off + .16); o.connect(g).connect(lp).connect(out); o.start(t + off); o.stop(t + off + .19); }); }
  function pulse(i, kind) { var el = frogs[i]; el.classList.remove('wrong','correct'); el.classList.add('call'); if (kind) el.classList.add(kind); setTimeout(function () { el.classList.remove('call',kind || ''); }, 390); }
  function queueSignal(note) { pending.push(note); if (!signalTimer) signalTimer = setTimeout(sendSignal, 5000); }
  function sendSignal() { signalTimer = null; if (!pending.length) return; var notes = pending.splice(0, 64); if (window.PointCastKeyboard) window.PointCastKeyboard.note(notes, null, { sound: false }); }
  function croak(i, quiet) { if (!quiet && state.sound && !muted) { if (i === 2) callBull(null, .72); else callTree(i - 1, null, .68); } pulse(i); queueSignal(MIDI[i]); }
  function stopLead() { leadTimers.forEach(clearTimeout); leadTimers = []; frogs.forEach(function (f) { f.classList.remove('lead'); }); }
  function makePattern() { var len = Math.min(2 + Math.floor(state.wins / 2), 6), base = (state.wins * 2 + 1) % 5, out = []; for (var i = 0; i < len; i++) out.push((base + i * 2 + (state.wins > 3 && i % 3 === 2 ? 1 : 0)) % 5); return out; }
  function startRound() { if (state.sound && !muted) audio(); stopLead(); state.hintSeen = true; save(); update(); pond.classList.add('started'); mode = 'lead'; pattern = makePattern(); answerIndex = 0; startBtn.disabled = true; say('The lead frog calls ' + pattern.length + ' times. Listen for the glowing pads…'); pattern.forEach(function (n, i) { leadTimers.push(setTimeout(function () { if (hidden || mode !== 'lead') return; frogs[n].classList.add('lead'); croak(n, false); setTimeout(function () { frogs[n].classList.remove('lead'); }, 430); }, 650 + i * 760)); }); leadTimers.push(setTimeout(function () { if (mode !== 'lead') return; mode = 'answer'; answerAt = performance.now(); startBtn.disabled = false; say('Your turn — answer on the glowing pads. There is room to breathe.'); }, 650 + pattern.length * 760 + 190)); }
  function success() { mode = 'idle'; state.wins = Math.min(8, state.wins + 1); save(); update(); if (state.wins >= 8) { pond.classList.add('erupt'); say('THE WHOLE POND ERUPTS. Every voice, one moonlit chord.'); [0,1,2,3,4].forEach(function (n, i) { setTimeout(function () { croak(n, false); }, i * 65); }); notice.textContent = 'Eight in a row. The moon remembers.'; setTimeout(function () { pond.classList.remove('erupt'); }, 5600); } else { say('Good answer. A new voice joins the background chorus.'); notice.textContent = 'Chorus voice ' + state.wins + ' is awake.'; } }
  function miss() { mode = 'idle'; frogs.forEach(function (f) { f.classList.add('wrong'); }); setTimeout(function () { frogs.forEach(function (f) { f.classList.remove('wrong'); }); }, 260); say('Almost. The pond keeps the same pattern if you want another listen.'); notice.textContent = 'No penalty here — try the round again.'; }
  function hit(i) { if (hidden) return; croak(i, false); if (state.ambient && !ambientTimer) ambientTimer = setInterval(ambientTick, 3700); if (mode !== 'answer') { if (mode === 'idle') { mode = 'free'; say('Free play. Start a round when you want the frogs to quiz you.'); } return; } var elapsed = performance.now() - answerAt, expectedTime = answerIndex * 760, close = Math.abs(elapsed - expectedTime) < 720; if (i !== pattern[answerIndex] || !close) { miss(); return; } frogs[i].classList.add('correct'); setTimeout(function () { frogs[i].classList.remove('correct'); }, 310); answerIndex++; if (answerIndex === pattern.length) success(); else say('Yes. ' + (pattern.length - answerIndex) + ' more croak' + (pattern.length - answerIndex === 1 ? '' : 's') + '.'); }
  function ambientTick() { if (!state.ambient || hidden) return; var voices = Math.max(1, state.wins); var n = (Math.floor(Date.now() / 1000) + voices) % 5; croak(n, false); if (voices > 2) setTimeout(function () { if (!hidden && state.ambient) croak((n + 2) % 5, false); }, 240); }
  function setAmbient(on) { state.ambient = on; save(); update(); clearInterval(ambientTimer); ambientTimer = null; if (on) { ambientTick(); ambientTimer = setInterval(ambientTick, 3700); say('Night falls. The growing chorus is keeping its own small time.'); } }
  frogs.forEach(function (f, i) { f.addEventListener('click', function () { hit(i); }); });
  startBtn.addEventListener('click', startRound); freeBtn.addEventListener('click', function () { mode = 'free'; freeBtn.setAttribute('aria-pressed','true'); say('Free play. Make the pond answer itself.'); }); ambientBtn.addEventListener('click', function () { setAmbient(!state.ambient); }); soundBtn.addEventListener('click', function () { state.sound = !state.sound; muted = !state.sound; if (bus) bus.gain.setTargetAtTime(muted ? 0 : .22, ac.currentTime, .03); save(); update(); });
  window.addEventListener('keydown', function (e) { if (e.metaKey || e.ctrlKey || e.altKey || e.repeat) return; var tag = e.target && e.target.tagName; if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return; var i = KEYS.indexOf(String(e.key).toLowerCase()); if (i >= 0) { e.preventDefault(); hit(i); } });
  document.addEventListener('visibilitychange', function () { hidden = document.hidden; pond.classList.toggle('paused', hidden); if (hidden) { stopLead(); if (mode === 'lead' || mode === 'answer') { mode = 'idle'; startBtn.disabled = false; say('The pond waited while you were away. Start a fresh round when ready.'); } } });
  window.addEventListener('pagehide', function () { sendSignal(); });
  update();
})();
</script>
</body>
</html>
