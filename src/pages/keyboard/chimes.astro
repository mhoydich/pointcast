---
const title = 'Wind Chime Porch · PointCast';
const description =
  'Hang bamboo, shell, or brass chimes on a tiny El Segundo porch and let the live evening wind play them.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/chimes">
<meta property="og:title" content="Wind Chime Porch">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;
  --moss:#7fa36b;--fern:#a9c98a;--sea:#6fb3b8;--deep:#1d4a55;--bark:#8a6a4a;--petal:#e7a3b3;--sun:#f2c14e;--dusk:#b5a8ee;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;overflow-x:hidden;background:radial-gradient(ellipse at 82% 0%,#34413255,transparent 42%),var(--bg);color:var(--ink)}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:9px 15px;cursor:pointer;font-size:11px;min-height:44px;touch-action:manipulation}
button:hover{background:#1e2b20;border-color:#688777}
button[aria-pressed=true],button.selected{background:var(--gold);color:var(--bg);border-color:var(--gold)}
button.primary{background:var(--gold);color:var(--bg);border-color:var(--gold)}
button:disabled{opacity:.45;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;margin:6px 0 0 44px;color:var(--dim);font:9px ui-monospace,Menlo,monospace;letter-spacing:.2em;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{padding:8px 11px;border-radius:20px;color:var(--dim);text-decoration:none}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}
main{width:min(940px,100%);margin:0 auto;padding:25px 20px 62px;display:flex;flex-direction:column;gap:16px}
.eyebrow,.label{color:var(--dim);font-size:9px;letter-spacing:.18em;text-transform:uppercase}
.intro{padding:0 4px}
.intro h2{margin:5px 0 6px;font:normal clamp(30px,6vw,48px)/1 Georgia,serif;letter-spacing:-.03em;color:#f1ead7}
.intro p{max-width:620px;margin:0;color:var(--dim);font-size:12px;line-height:1.75}
.card{background:linear-gradient(155deg,#1d2c20,#111d16);border:1px solid var(--line);border-radius:16px;padding:16px 18px}
.weather{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:74px}
.weather-copy{min-width:0;display:flex;flex-direction:column;gap:7px}
.wind-readout{font-family:Georgia,serif;font-size:19px;color:var(--ink);line-height:1.2}
.wind-source{font-size:10px;color:var(--dim)}
.mini-sock{width:72px;height:58px;flex:none;color:var(--sun)}
.porch-card{padding:10px;overflow:hidden}
.stage{position:relative;border:1px solid #3b4f3a;border-radius:12px;overflow:hidden;background:#12211b;isolation:isolate}
#scene{display:block;width:100%;height:auto;min-height:280px}
#gustLines{opacity:0;transition:opacity .2s}
.stage.hot #gustLines{opacity:.9}
.stage.hot{box-shadow:0 0 0 1px #d4775e66,0 0 32px #ca745022 inset}
.quiet{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);padding:8px 12px;border:1px solid #78916d66;border-radius:20px;background:#101813bb;color:#d4ddc7;font-size:10px;white-space:nowrap;pointer-events:none}
.quiet.gone{opacity:0;transition:opacity .35s}
.scene-note{margin:8px 4px 0;color:var(--dim);font-size:10px;line-height:1.5}
.set-panel{display:flex;flex-direction:column;gap:12px}
.set-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}
.set-head strong{font:normal 20px Georgia,serif;color:var(--ink)}
.set-head span{font-size:10px;color:var(--dim)}
.set-buttons{display:flex;gap:7px;flex-wrap:wrap}
.set-buttons button{display:flex;align-items:center;gap:7px;padding:8px 13px}
.set-buttons i{width:10px;height:10px;border-radius:50%;display:inline-block;background:var(--set-color)}
.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:2px}
.actions .spacer{flex:1}
#notice{min-height:14px;color:var(--gold);font-size:10px}
.key-card{display:flex;flex-direction:column;gap:12px}
.key-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline;flex-wrap:wrap}
.key-head strong{font:normal 18px Georgia,serif}
.key-head span{color:var(--dim);font-size:10px}
.key-row{display:grid;grid-template-columns:repeat(6,minmax(44px,1fr));gap:7px}
.key-row button{border-radius:10px;padding:8px 4px;min-height:54px;font-size:14px;color:var(--ink);background:#17251b}
.key-row button small{display:block;margin-top:3px;color:var(--dim);font-size:8px;letter-spacing:.04em}
.key-row button.hit{background:var(--moss);border-color:var(--fern);color:#101813;transform:translateY(2px)}
.key-row button.hit small{color:#19301d}
.status{min-height:16px;color:var(--dim);font-size:10px;line-height:1.5}
.field-note{border-left:3px solid var(--sea);padding:12px 16px;background:#142326;border-radius:0 12px 12px 0}
.field-note .label{color:var(--sea)}
.field-note p{margin:7px 0 0;color:#d5ddd3;font:14px/1.55 Georgia,serif}
[hidden]{display:none!important}
@media(max-width:640px){header{padding:14px}main{padding:19px 14px 48px}.weather{align-items:flex-start}.mini-sock{width:56px}.key-row{grid-template-columns:repeat(6,1fr);gap:5px}.key-row button{font-size:13px;padding-left:2px;padding-right:2px}}
@media(max-width:390px){.brand{font-size:26px}.brand small{margin-left:0}.key-row{grid-template-columns:repeat(4,1fr)}.quiet{font-size:9px;max-width:calc(100% - 24px);text-align:center;white-space:normal}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}.key-row button.hit{transform:none}#gustLines{display:none}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Wind Chime Porch<small>El Segundo, evening sky</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf" aria-current="page">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar"><button type="button" id="sound" aria-pressed="true">♪ Sound on</button></div>
</header>

<main>
  <section class="intro">
    <div class="eyebrow">Nature Wing / a tiny porch</div>
    <h2>Wind Chime Porch</h2>
    <p>Hang a little choir over the eave. El Segundo's wind does the swinging; your fingers can answer back.</p>
  </section>

  <section class="card weather" aria-live="polite">
    <div class="weather-copy">
      <span class="label">The air outside</span>
      <strong class="wind-readout" id="windReadout">Wind now: 4 mph, gusts 7, from the WSW</strong>
      <span class="wind-source" id="windSource">gentle simulated breeze · checking El Segundo</span>
    </div>
    <svg class="mini-sock" viewBox="0 0 80 64" aria-label="A small windsock" role="img">
      <path d="M14 57V12M7 57h16" stroke="currentColor" stroke-width="2" fill="none"/>
      <path d="M14 14h43l-7 12H14z" fill="currentColor" opacity=".25"/>
      <path d="M57 14 73 20 50 26" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M21 14v12M30 14v12M39 14v12M48 14v12" stroke="#101813" stroke-width="2" opacity=".6"/>
    </svg>
  </section>

  <section class="card porch-card" aria-label="Animated wind chime porch">
    <div class="stage" id="stage">
      <svg id="scene" viewBox="0 0 1000 470" role="img" aria-label="A porch eave with hanging wind chimes over the El Segundo evening sky">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#162c35"/><stop offset=".58" stop-color="#365f61"/><stop offset="1" stop-color="#d08b72"/></linearGradient>
          <linearGradient id="water" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#1d4a55"/><stop offset="1" stop-color="#6fb3b8"/></linearGradient>
          <filter id="soft"><feGaussianBlur stdDeviation="12"/></filter>
        </defs>
        <rect width="1000" height="470" fill="url(#sky)"/>
        <circle cx="824" cy="142" r="48" fill="#f2c14e" opacity=".82" filter="url(#soft)"/>
        <circle cx="824" cy="142" r="27" fill="#f2c14e" opacity=".82"/>
        <path d="M0 300Q160 264 320 304T650 298T1000 286V470H0Z" fill="#203f43" opacity=".82"/>
        <path d="M0 340Q230 322 470 343T1000 330V470H0Z" fill="url(#water)" opacity=".72"/>
        <path d="M0 355q110-12 220 0t240 0t260 0t280 0M54 378q160-8 310 0t310 0t270 0" fill="none" stroke="#a9c98a" stroke-width="3" opacity=".35"/>
        <path d="M0 0h1000v65H0z" fill="#172319"/>
        <path d="M0 65h1000v24H0z" fill="#8a6a4a"/>
        <path d="M0 88h1000" stroke="#d6b079" stroke-width="3" opacity=".65"/>
        <g opacity=".35" stroke="#ede9d7" stroke-width="3" fill="none">
          <path d="M123 188q26-24 52 0M142 176q18-19 37 0M640 215q24-21 48 0M655 205q15-17 32 0"/>
        </g>
        <g id="windSock" transform="translate(873 103)">
          <path d="M0 0v69M-7 69H7" stroke="#ede9d7" stroke-width="3" opacity=".75"/>
          <g id="sockFlag"><path d="M0 4h54l-9 18H0z" fill="#e7a3b3" opacity=".88"/><path d="M12 4v18M25 4v18M38 4v18" stroke="#101813" stroke-width="3" opacity=".55"/><path d="M54 4 73 13 45 22" fill="none" stroke="#f2c14e" stroke-width="3"/></g>
        </g>
        <g id="chimeField"></g>
        <g id="gustLines" stroke="#f2c14e" stroke-width="3" stroke-linecap="round" fill="none">
          <path d="M100 260h170M166 280h220M510 250h210M690 275h180"/>
          <path d="M235 314h130M585 312h172" opacity=".65"/>
        </g>
      </svg>
      <div class="quiet" id="quiet">The porch is quiet — tap a tube, or let the breeze find it.</div>
    </div>
    <p class="scene-note">The live wind nudges each pendulum. When a clapper meets a tube, its impact speed chooses the volume.</p>
  </section>

  <section class="card set-panel">
    <div class="set-head"><strong id="setTitle">Bamboo</strong><span id="setSubtitle">hollow wood · pentatonic dusk</span></div>
    <div class="set-buttons" role="group" aria-label="Choose a chime set">
      <button type="button" data-set="bamboo" class="selected"><i style="--set-color:#a9c98a"></i>Bamboo</button>
      <button type="button" data-set="shell"><i style="--set-color:#e7a3b3"></i>Shell</button>
      <button type="button" data-set="brass"><i style="--set-color:#f2c14e"></i>Brass</button>
    </div>
    <div class="actions">
      <button type="button" class="primary" id="listen">Let the wind sing</button>
      <button type="button" id="santaAna">Santa Ana gust</button>
      <button type="button" id="stillness">Stillness · one chime</button>
      <span class="spacer"></span><span id="notice" role="status"></span>
    </div>
  </section>

  <section class="card key-card">
    <div class="key-head"><strong>Strike the tubes</strong><span><b id="activeSetName">Bamboo</b> · A–L on your keyboard, or tap below</span></div>
    <div class="key-row" id="keyRow" role="group" aria-label="Wind chime keys"></div>
    <div class="status" id="status">Choose a set, then wait for the little collisions.</div>
  </section>

  <aside class="field-note">
    <div class="label">Field note</div>
    <p>In coastal Southern California, afternoon sea breezes are common, while Santa Ana winds often blow hot and dry from inland, most often in fall and winter.</p>
  </aside>
</main>

<script is:inline src="/keyboard.js" data-app="keyboard-chimes" async></script>
<script is:inline>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var STORE_KEY = 'pc-chimes-v1';
  var SIGNAL_TAG = { place: 'el-segundo' };
  var WIND_URL = 'https://api.open-meteo.com/v1/forecast?latitude=33.9192&longitude=-118.4165&current=wind_speed_10m,wind_gusts_10m,wind_direction_10m&wind_speed_unit=mph&timezone=America%2FLos_Angeles';
  var KEY_LETTERS = 'abcdefghijkl'.split('');
  var COMPASS = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
  var SETS = {
    bamboo: { label: 'Bamboo', subtitle: 'hollow wood · pentatonic dusk', color: '#a9c98a', notes: [60, 62, 64, 67, 69], lengths: [138, 121, 106, 91, 77], widths: [23, 23, 22, 21, 20], parts: [[1, 'triangle', .17], [2.13, 'sine', .055], [3.76, 'sine', .018]], decay: 1.15, attack: .012 },
    shell: { label: 'Shell', subtitle: 'small bright clinks · salt air', color: '#e7a3b3', notes: [72, 76, 79, 83, 86], lengths: [92, 82, 72, 63, 55], widths: [19, 19, 18, 17, 16], parts: [[1, 'sine', .13], [2.71, 'sine', .05], [4.19, 'sine', .022], [6.8, 'sine', .012]], decay: .72, attack: .004 },
    brass: { label: 'Brass', subtitle: 'long bell partials · Am9', color: '#f2c14e', notes: [57, 60, 64, 67, 71, 76], lengths: [128, 116, 104, 92, 80, 68], widths: [25, 25, 24, 23, 22, 21], parts: [[1, 'sine', .15], [2.01, 'triangle', .055], [3.02, 'sine', .035], [4.2, 'sine', .016]], decay: 2.55, attack: .009 }
  };
  var state = { set: 'bamboo', muted: false, hasPlayed: false };
  var liveWind = { speed: 4, gusts: 7, direction: 247, live: false };
  var tubes = [];
  var audioCtx = null, master = null, audioReady = false;
  var rafId = 0, lastFrame = 0, hidden = document.visibilityState === 'hidden';
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var gustBoost = 0, randomGust = 0, randomGustClock = 0, stillnessUntil = 0, signalNotes = [], signalTimer = null;
  var signalStatusTimer = null;

  function loadState() {
    try {
      var raw = localStorage.getItem(STORE_KEY);
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (saved && SETS[saved.set]) state.set = saved.set;
      state.muted = !!(saved && saved.muted);
      state.hasPlayed = !!(saved && saved.hasPlayed);
    } catch (e) { /* private browsing is fine */ }
  }
  function saveState() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* the porch still plays */ }
  }
  function freq(midi) { return 440 * Math.pow(2, (midi - 69) / 12); }
  function audio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      master = audioCtx.createGain();
      master.gain.value = state.muted ? 0 : .22;
      var compressor = audioCtx.createDynamicsCompressor();
      compressor.threshold.value = -24;
      compressor.knee.value = 18;
      compressor.ratio.value = 5;
      compressor.attack.value = .004;
      compressor.release.value = .55;
      master.connect(compressor).connect(audioCtx.destination);
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    audioReady = true;
    return audioCtx;
  }
  function ensureAudio() { try { audio(); } catch (e) { audioReady = false; } }
  function playTube(index, velocity) {
    if (!audioReady || state.muted) return;
    try {
      var c = audio(), set = SETS[state.set], f = freq(set.notes[index % set.notes.length]);
      var out = c.createGain(), t = c.currentTime, amp = Math.max(.08, Math.min(.32, .12 + velocity * .2));
      out.gain.setValueAtTime(.0001, t);
      out.gain.exponentialRampToValueAtTime(amp, t + set.attack);
      out.gain.exponentialRampToValueAtTime(.0001, t + set.decay);
      out.connect(master);
      set.parts.forEach(function (part) {
        var osc = c.createOscillator(), gain = c.createGain();
        osc.type = part[1]; osc.frequency.value = f * part[0];
        gain.gain.setValueAtTime(.0001, t);
        gain.gain.exponentialRampToValueAtTime(part[2], t + set.attack);
        gain.gain.exponentialRampToValueAtTime(.0001, t + set.decay / Math.sqrt(part[0]));
        osc.connect(gain).connect(out); osc.start(t); osc.stop(t + set.decay + .08);
      });
    } catch (e) { /* audio is a nicety */ }
  }
  function compass(degrees) { return COMPASS[Math.round((((degrees % 360) + 360) % 360) / 22.5) % 16]; }
  function renderWind() {
    $('windReadout').textContent = 'Wind now: ' + Math.round(liveWind.speed) + ' mph, gusts ' + Math.round(liveWind.gusts) + ', from the ' + compass(liveWind.direction);
    var source = liveWind.live ? 'live Open-Meteo reading · refreshed ' + new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) : 'gentle simulated breeze · live reading unavailable';
    $('windSource').textContent = source;
    $('windSock').setAttribute('transform', 'translate(873 103) rotate(' + (liveWind.direction + 180) + ' 0 5)');
    $('sockFlag').style.transformOrigin = '0 5px';
  }
  function setNotice(message) {
    $('notice').textContent = message;
    clearTimeout(signalStatusTimer);
    signalStatusTimer = setTimeout(function () { $('notice').textContent = ''; }, 4200);
  }
  function queueSignal(midi) {
    if (signalNotes.length < 128) signalNotes.push(midi);
    if (!signalTimer) signalTimer = setTimeout(flushSignals, 6000);
  }
  function flushSignals() {
    clearTimeout(signalTimer); signalTimer = null;
    if (!signalNotes.length) return;
    var notes = signalNotes.splice(0, 64);
    if (window.PointCastKeyboard) window.PointCastKeyboard.note(notes, SIGNAL_TAG, { sound: false });
    if (signalNotes.length) signalTimer = setTimeout(flushSignals, 6000);
  }
  function tubeMarkup(x, i, set) {
    var width = set.widths[i], length = set.lengths[i];
    return '<g class="tube" data-index="' + i + '" tabindex="0" role="button" aria-label="' + set.label + ' tube ' + (i + 1) + '" transform="translate(' + x + ' 89)">' +
      '<line class="hanger" x1="0" y1="0" x2="0" y2="18" stroke="#ede9d7" stroke-width="2" opacity=".8"/>' +
      '<circle cx="0" cy="3" r="4" fill="#f2c14e"/>' +
      '<rect class="tube-body" x="' + (-width / 2) + '" y="18" width="' + width + '" height="' + length + '" rx="' + (width / 2) + '" fill="' + set.color + '" opacity=".92"/>' +
      '<path d="M' + (-width / 2 + 4) + ' ' + (length + 22) + 'q' + (width / 2 - 4) + ' 8 0 0" fill="none" stroke="#101813" stroke-width="2" opacity=".5"/>' +
      '<line class="clapper" x1="0" y1="' + (length + 16) + '" x2="0" y2="' + (length + 35) + '" stroke="#ede9d7" stroke-width="2" opacity=".85"/>' +
      '<circle class="clapper-dot" cx="0" cy="' + (length + 37) + '" r="6" fill="#8a6a4a"/>' +
      '<line x1="0" y1="' + (length + 37) + '" x2="0" y2="' + (length + 54) + '" stroke="#8a6a4a" stroke-width="2"/>' +
      '<circle cx="0" cy="' + (length + 56) + '" r="4" fill="#f2c14e"/>' +
      '</g>';
  }
  function buildScene() {
    var set = SETS[state.set], count = set.notes.length, field = $('chimeField'), markup = '';
    tubes = [];
    for (var i = 0; i < count; i++) {
      var x = count === 1 ? 500 : 180 + (640 * i / (count - 1));
      markup += tubeMarkup(Math.round(x), i, set);
      tubes.push({ angle: 0, velocity: 0, side: 0, cooldown: .2, phase: i * 1.7 });
    }
    field.innerHTML = markup;
    field.querySelectorAll('.tube').forEach(function (node) {
      node.addEventListener('pointerdown', function (event) { if (event.button && event.button !== 0) return; event.preventDefault(); userStrike(Number(node.dataset.index), .82); });
      node.addEventListener('keydown', function (event) { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); userStrike(Number(node.dataset.index), .82); } });
    });
    $('setTitle').textContent = set.label;
    $('setSubtitle').textContent = set.subtitle;
    $('activeSetName').textContent = set.label;
    $('keyRow').innerHTML = KEY_LETTERS.map(function (letter, i) {
      var tube = i % count;
      return '<button type="button" data-tube="' + tube + '" aria-label="Strike ' + set.label + ' tube ' + (tube + 1) + ' with ' + letter.toUpperCase() + '">' + letter.toUpperCase() + '<small>tube ' + (tube + 1) + '</small></button>';
    }).join('');
    $('keyRow').querySelectorAll('button').forEach(function (button) {
      button.addEventListener('pointerdown', function (event) { event.preventDefault(); userStrike(Number(button.dataset.tube), .86); });
      button.addEventListener('keydown', function (event) { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); userStrike(Number(button.dataset.tube), .86); } });
    });
    document.querySelectorAll('[data-set]').forEach(function (button) { button.classList.toggle('selected', button.dataset.set === state.set); });
    renderWind(); renderScene();
  }
  function flashTube(index) {
    var node = $('chimeField').querySelector('[data-index="' + index + '"]');
    var button = $('keyRow').querySelector('[data-tube="' + index + '"]');
    if (node) node.classList.add('hit');
    if (button) { button.classList.add('hit'); setTimeout(function () { button.classList.remove('hit'); }, 120); }
    setTimeout(function () { if (node) node.classList.remove('hit'); }, 160);
  }
  function strikeTube(index, velocity, byHand) {
    if (!tubes[index]) return;
    var note = SETS[state.set].notes[index % SETS[state.set].notes.length];
    tubes[index].velocity += (byHand ? .16 : .05) * (velocity || .5);
    playTube(index, velocity || .5);
    queueSignal(note);
    state.hasPlayed = true; saveState();
    $('quiet').classList.add('gone');
    flashTube(index);
    $('status').textContent = byHand ? 'A hand-struck ' + SETS[state.set].label.toLowerCase() + ' note is hanging in the air.' : 'The breeze found tube ' + (index + 1) + '.';
  }
  function userStrike(index, velocity) { ensureAudio(); strikeTube(index, velocity, true); }
  function renderScene() {
    tubes.forEach(function (tube, i) {
      var node = $('chimeField').querySelector('[data-index="' + i + '"]');
      if (node) node.setAttribute('transform', 'translate(' + Math.round(180 + (640 * i / Math.max(1, tubes.length - 1))) + ' 89) rotate(' + (tube.angle * 38).toFixed(2) + ')');
    });
  }
  function physics(now) {
    var dt = Math.min(.045, Math.max(.008, (now - lastFrame) / 1000));
    lastFrame = now;
    var still = now < stillnessUntil;
    gustBoost = Math.max(0, gustBoost - dt * 30);
    randomGustClock -= dt;
    if (randomGustClock <= 0) {
      randomGustClock = .35 + Math.random() * 1.35;
      randomGust = (Math.random() * 2 - 1) * Math.max(0, liveWind.gusts - liveWind.speed) / 8;
    }
    tubes.forEach(function (tube, i) {
      tube.cooldown -= dt;
      if (still) {
        tube.velocity *= Math.pow(.015, dt);
        tube.angle *= Math.pow(.02, dt);
      } else {
        var breeze = (liveWind.speed + Math.max(0, liveWind.gusts - liveWind.speed) * (.35 + .3 * Math.sin(now / 1200 + i))) / 8;
        var gust = gustBoost / 10;
        var push = (breeze + gust) * (.58 * Math.sin(now / 880 + tube.phase) + .32 * Math.sin(now / 1910 + i * 2)) + randomGust;
        tube.velocity += (-tube.angle * 4.8 - tube.velocity * 1.05 + push) * dt;
        tube.angle += tube.velocity * dt;
        tube.angle = Math.max(-.72, Math.min(.72, tube.angle));
        if (Math.abs(tube.angle) > .105 && Math.sign(tube.angle) !== tube.side && Math.abs(tube.velocity) > .095 && tube.cooldown <= 0) {
          tube.side = Math.sign(tube.angle); tube.cooldown = .22;
          strikeTube(i, Math.min(1, .28 + Math.abs(tube.velocity) * 1.2), false);
        } else if (Math.abs(tube.angle) < .045) tube.side = 0;
      }
    });
    renderScene();
    if (gustBoost > 0 && !reducedMotion) $('stage').classList.add('hot');
    else $('stage').classList.remove('hot');
  }
  function frame(now) {
    if (hidden || reducedMotion) { rafId = 0; return; }
    physics(now); rafId = requestAnimationFrame(frame);
  }
  function startAnimation() { if (!hidden && !reducedMotion && !rafId) { lastFrame = performance.now(); rafId = requestAnimationFrame(frame); } }
  function fetchWind() {
    fetch(WIND_URL, { headers: { Accept: 'application/json' } }).then(function (response) {
      if (!response.ok) throw new Error('wind unavailable');
      return response.json();
    }).then(function (payload) {
      var current = payload && payload.current;
      if (!current || !isFinite(Number(current.wind_speed_10m)) || !isFinite(Number(current.wind_gusts_10m)) || !isFinite(Number(current.wind_direction_10m))) throw new Error('wind incomplete');
      liveWind = { speed: Math.max(0, Number(current.wind_speed_10m)), gusts: Math.max(0, Number(current.wind_gusts_10m)), direction: Number(current.wind_direction_10m), live: true };
      renderWind(); setNotice('El Segundo is steering the porch now.');
    }).catch(function () { liveWind.live = false; renderWind(); });
  }
  function chooseSet(name) {
    if (!SETS[name] || name === state.set) return;
    state.set = name; saveState(); buildScene(); setNotice(SETS[name].label + ' is hanging now.');
  }
  function toggleSound() {
    state.muted = !state.muted;
    if (!state.muted) ensureAudio();
    if (master) master.gain.setTargetAtTime(state.muted ? 0 : .22, audioCtx.currentTime, .025);
    $('sound').textContent = state.muted ? '♪ Sound off' : '♪ Sound on';
    $('sound').setAttribute('aria-pressed', String(!state.muted)); saveState();
  }
  function listen() {
    ensureAudio();
    var n = Math.min(1, Math.max(.25, liveWind.gusts / 22));
    gustBoost = liveWind.live ? Math.max(8, liveWind.gusts * .9) : 9;
    for (var i = 0; i < tubes.length; i++) tubes[i].velocity += (i % 2 ? -1 : 1) * n * .16;
    state.hasPlayed = true; saveState(); $('quiet').classList.add('gone');
    $('status').textContent = liveWind.live ? 'Listen: every swing is being pushed by El Segundo\'s real wind.' : 'Listen: a gentle simulated breeze is moving the porch.';
    setNotice(liveWind.live ? 'That breeze is real right now.' : 'A soft fallback breeze is moving the porch.');
  }
  function santaAna() {
    ensureAudio(); gustBoost = 52; stillnessUntil = 0;
    tubes.forEach(function (tube, i) { tube.velocity += (i % 2 ? -1 : 1) * (.65 + Math.random() * .4); });
    $('status').textContent = 'A hot inland gust just crossed the porch.'; setNotice('Santa Ana gust — hot, dry, and loud.');
  }
  function stillness() {
    ensureAudio(); stillnessUntil = performance.now() + 1800; gustBoost = 0;
    tubes.forEach(function (tube) { tube.velocity = 0; tube.angle = 0; tube.side = 0; });
    strikeTube(Math.floor(tubes.length / 2), .95, true); setNotice('Stillness. One note, then the air settles.'); renderScene();
  }
  function keyHandler(event) {
    if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
    var target = event.target;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
    var index = KEY_LETTERS.indexOf(String(event.key || '').toLowerCase());
    if (index < 0) return;
    event.preventDefault(); userStrike(index % tubes.length, .84);
  }
  loadState(); buildScene();
  if (state.hasPlayed) $('quiet').classList.add('gone');
  $('sound').textContent = state.muted ? '♪ Sound off' : '♪ Sound on'; $('sound').setAttribute('aria-pressed', String(!state.muted));
  $('sound').addEventListener('click', toggleSound);
  $('listen').addEventListener('click', listen); $('santaAna').addEventListener('click', santaAna); $('stillness').addEventListener('click', stillness);
  document.querySelectorAll('[data-set]').forEach(function (button) { button.addEventListener('click', function () { chooseSet(button.dataset.set); }); });
  document.addEventListener('keydown', keyHandler);
  document.addEventListener('visibilitychange', function () {
    hidden = document.visibilityState === 'hidden';
    if (hidden) { if (rafId) cancelAnimationFrame(rafId); rafId = 0; flushSignals(); }
    else startAnimation();
  });
  window.addEventListener('pagehide', flushSignals);
  fetchWind(); setInterval(fetchWind, 600000); startAnimation();
})();
</script>
</body>
</html>
