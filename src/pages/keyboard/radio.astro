---
/**
 * /keyboard/radio — Town Radio, a lean-back station.
 *
 * KPCK plays whatever the town's keyboard hears. Pitched phrases from
 * /api/keyboard/signal are quantized into the day's key and played as the
 * lead voice over a slow generated bed (pad + brush kit, optional rain).
 * Unpitched keystroke bursts become soft percussive ticks. When the town
 * goes quiet the DJ pulls a phrase from the archive and plays it again.
 *
 * This is also the "listen" half of the keyboard signal: send a phrase from
 * the on-screen keyboard and it goes out to everyone else's radio too.
 */
const title = 'Town Radio · PointCast';
const description =
  'KPCK · El Segundo. A lean-back station that plays the town keyboard: live phrases quantized into today’s key over a slow pad and brush kit. Send a phrase of your own.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/radio">
<meta property="og:title" content="Town Radio">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 86% 0%,#34413255,transparent 43%),var(--bg);color:var(--ink);min-height:100vh}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:9px 16px;cursor:pointer;font-size:11px;min-height:44px}
button:hover{background:#1e2b20;border-color:#688777}
button[aria-pressed=true]{background:var(--gold);color:var(--bg);border-color:var(--gold)}
button:disabled{opacity:.45;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
main{max-width:1080px;margin:0 auto;padding:26px 24px 60px;display:flex;flex-direction:column;gap:24px}
.card{background:linear-gradient(155deg,#1d2c20,#111d16);border:1px solid var(--line);border-radius:16px;padding:20px}
.label{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);margin:0 0 8px}
.station{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start}
.callsign{display:flex;align-items:center;gap:12px}
.lamp{width:14px;height:14px;border-radius:50%;background:#3a4a3d;box-shadow:inset 0 0 0 1px #0006;flex:none;transition:background .2s,box-shadow .2s}
.lamp.on{background:#ff6b57;box-shadow:0 0 12px #ff6b57cc,inset 0 0 0 1px #0004}
.callname{font-family:Georgia,serif;font-size:30px;margin:0;line-height:1.1}
.calltag{font-size:10px;color:var(--dim);letter-spacing:.14em;text-transform:uppercase;margin:2px 0 0}
.key-of-day{font-size:11px;color:var(--dim);margin:10px 0 0}
.key-of-day b{color:var(--gold);font-weight:normal}
.hint{font-size:11px;color:var(--dim);line-height:1.7;margin:12px 0 0}
.tune{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.mixer{display:flex;flex-direction:column;gap:12px}
.mixrow{display:grid;grid-template-columns:70px 1fr 34px;gap:10px;align-items:center;font-size:10px;color:var(--dim)}
.mixrow input[type=range]{width:100%;accent-color:var(--gold)}
.mixrow .v{text-align:right;font-variant-numeric:tabular-nums}
.now{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center}
.now h2{font-family:Georgia,serif;font-weight:normal;font-size:22px;margin:0 0 4px}
.now .who{font-size:11px;color:var(--dim)}
.now .who b{color:var(--ink);font-weight:normal}
.now .when{font-size:10px;color:var(--dim);margin-top:2px}
.archive-tag{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold);border-radius:20px;padding:4px 10px;white-space:nowrap}
.strip{display:flex;align-items:flex-end;gap:2px;height:48px;margin-top:14px;background:#0d1711;border-radius:10px;padding:8px;overflow:hidden}
.strip i{display:block;width:6px;flex:none;border-radius:2px;background:var(--gold);opacity:.9}
.strip .tickmark{background:var(--dim);opacity:.7}
.strip .empty{font-size:10px;color:var(--dim);align-self:center}
.log{display:flex;flex-direction:column;gap:6px;max-height:280px;overflow:auto}
.row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;font-size:11px;padding:8px 10px;border-radius:10px;background:#0d171188}
.row .who{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .when{color:var(--dim);font-size:10px;white-space:nowrap}
.row.archive{border:1px solid #dfc48d55}
.empty{font-size:11px;color:var(--dim);padding:8px 0}
.piano{position:relative;display:flex;height:130px;margin:10px 0;user-select:none;-webkit-user-select:none;touch-action:manipulation}
.piano .w{flex:1;height:130px;margin-right:3px;border-radius:0 0 9px 9px;background:#ede9d7;border:0;padding:0;box-shadow:inset 0 -7px 0 #cfc8ac;color:#6f6a55;font-size:10px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:10px;min-height:0;transition:transform .05s,background .1s}
.piano .b{position:absolute;top:0;height:80px;border-radius:0 0 7px 7px;background:#1d2a20;border:1px solid #0b120d;padding:0;z-index:1;box-shadow:inset 0 -5px 0 #34463a;color:#7f9480;font-size:9px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:8px;min-height:0}
.piano .on{background:var(--gold)!important;transform:translateY(2px)}
.sendrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:6px;font-size:10px;color:var(--dim)}
footer{max-width:1080px;margin:0 auto;padding:0 24px 40px;font-size:10px;color:var(--dim);line-height:1.8}
[hidden]{display:none!important}
@media(max-width:820px){.station{grid-template-columns:minmax(0,1fr)}.now{grid-template-columns:1fr}}
@media(max-width:560px){header{padding:16px}main{padding:18px 16px 48px}.piano{height:104px}.piano .w{height:104px;font-size:0}.piano .b{height:62px;font-size:0}.callname{font-size:24px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Town Radio<small>KPCK · lean-back live from the keyboard</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/shelf">Shelf</a>
    <a href="/keyboard/diary">Key Diary</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
</header>

<main>
  <section class="card station">
    <div>
      <div class="callsign">
        <span class="lamp" id="lamp" aria-hidden="true"></span>
        <div>
          <p class="callname">KPCK <span style="color:var(--dim);font-size:16px">· El Segundo</span></p>
          <p class="calltag" id="airstate">off air</p>
        </div>
      </div>
      <p class="key-of-day">Today's key: <b id="keyname">tuning up…</b></p>
      <p class="hint" id="firstrun">Press Tune in to start the station. It plays whatever the town types and taps, live, over a slow pad in today's key.</p>
      <div class="tune">
        <button type="button" id="tune" aria-pressed="false">▶ Tune in</button>
        <button type="button" id="rain" aria-pressed="false">☔ Rain off</button>
      </div>
    </div>
    <div class="mixer" role="group" aria-label="Mixer">
      <p class="label" style="margin:0">Mixer</p>
      <div class="mixrow"><span>Bed</span><input type="range" id="mixBed" min="0" max="100" value="60" aria-label="Bed volume"><span class="v" id="mixBedV">60</span></div>
      <div class="mixrow"><span>Phrases</span><input type="range" id="mixPhrases" min="0" max="100" value="90" aria-label="Phrase volume"><span class="v" id="mixPhrasesV">90</span></div>
      <div class="mixrow"><span>Drums</span><input type="range" id="mixDrums" min="0" max="100" value="50" aria-label="Drum volume"><span class="v" id="mixDrumsV">50</span></div>
    </div>
  </section>

  <section class="card">
    <p class="label">Now playing</p>
    <div class="now">
      <div>
        <h2 id="npKind">Waiting for the town…</h2>
        <p class="who" id="npWho">Press <b>Tune in</b> to start listening.</p>
        <p class="when" id="npWhen"></p>
      </div>
      <span class="archive-tag" id="npArchive" hidden>from the archive</span>
    </div>
    <div class="strip" id="npStrip"><span class="empty">the shape of the current phrase will draw here</span></div>
  </section>

  <section class="card">
    <p class="label">Just heard · last 12</p>
    <div class="log" id="log"><p class="empty">Nothing yet. Tune in, or send the first phrase below.</p></div>
  </section>

  <section class="card">
    <p class="label">Send a phrase to the station</p>
    <p class="hint" style="margin:0">Play it on the keyboard, or type <code>A S D F G H J K</code> (black keys <code>W E T Y U</code>). It goes out to every KPCK listener in the town.</p>
    <div class="piano" id="piano" aria-label="One-octave keyboard: click, tap, or type A–K"></div>
    <div class="sendrow"><span id="sendCount">0 notes sent this visit</span></div>
  </section>
</main>
<footer>
  Powered by the <a href="/keyboard-signal">Keyboard Signal</a>: one counter, every source. Mixer levels are kept in this browser only. <a href="/">PointCast</a> · El Segundo.
</footer>

<script is:inline src="/keyboard.js" data-app="keyboard-radio" async></script>
<script is:inline>
(function () {
  'use strict';
  var API = '/api/keyboard/signal';
  var STORE_KEY = 'pc-radio-v1';
  var NOTE_NAMES = ['C', 'C#', 'D', 'Eb', 'E', 'F', 'F#', 'G', 'Ab', 'A', 'Bb', 'B'];
  var MAJOR_STEPS = [0, 2, 4, 5, 7, 9, 11];
  var MINOR_STEPS = [0, 2, 3, 5, 7, 8, 10];
  var PENT_STEPS = [0, 2, 4, 7, 9];
  var $ = function (id) { return document.getElementById(id); };

  // ---- prefs (mixer + rain) -------------------------------------------------
  var prefs = { bed: 0.6, phrases: 0.9, drums: 0.5, rain: false };
  try {
    var raw = localStorage.getItem(STORE_KEY);
    if (raw) {
      var saved = JSON.parse(raw) || {};
      ['bed', 'phrases', 'drums'].forEach(function (k) {
        if (typeof saved[k] === 'number' && saved[k] >= 0 && saved[k] <= 1) prefs[k] = saved[k];
      });
      if (typeof saved.rain === 'boolean') prefs.rain = saved.rain;
    }
  } catch (e) { /* private mode */ }
  function savePrefs() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(prefs)); } catch (e) { /* storage full or blocked */ }
  }

  // ---- key of the day --------------------------------------------------------
  var keyInfo = null; // { rootPc, steps, progression, label }
  function buildKey(key) {
    if (key && key.tonic && key.mode) {
      var rootPc = Math.max(0, NOTE_NAMES.indexOf(key.tonic));
      if (key.mode === 'minor') return { rootPc: rootPc, steps: MINOR_STEPS, progression: [0, 5, 2, 6], label: key.tonic + ' minor' };
      return { rootPc: rootPc, steps: MAJOR_STEPS, progression: [0, 5, 3, 4], label: key.tonic + ' major' };
    }
    return { rootPc: 0, steps: PENT_STEPS, progression: [0, 1, 2, 3], label: 'C major pentatonic (default)' };
  }
  function chordTones(k, degIdx, octaveBase) {
    var len = k.steps.length, out = [];
    for (var t = 0; t < 3; t++) {
      var raw = degIdx + 2 * t;
      var idx = raw % len;
      var oct = Math.floor(raw / len);
      out.push(octaveBase * 12 + k.rootPc + k.steps[idx] + oct * 12);
    }
    return out;
  }
  function snapToKey(midi, k, lo, hi) {
    var pc = ((midi % 12) + 12) % 12;
    var rel = ((pc - k.rootPc) + 12) % 12;
    var best = k.steps[0], dist = 99;
    k.steps.forEach(function (s) {
      var d = Math.min(Math.abs(s - rel), 12 - Math.abs(s - rel));
      if (d < dist) { dist = d; best = s; }
    });
    var n = midi - rel + best;
    while (n < lo) n += 12;
    while (n > hi) n -= 12;
    return n;
  }

  // ---- audio engine -----------------------------------------------------------
  var ac = null, master = null, bedGain = null, phraseGain = null, drumGain = null, rainSrc = null, rainGain = null;
  function audio() {
    if (!ac) {
      ac = new (window.AudioContext || window.webkitAudioContext)();
      var comp = ac.createDynamicsCompressor();
      comp.threshold.value = -20;
      master = ac.createGain();
      master.gain.value = 0.85;
      master.connect(comp).connect(ac.destination);
      bedGain = ac.createGain(); bedGain.gain.value = prefs.bed; bedGain.connect(master);
      phraseGain = ac.createGain(); phraseGain.gain.value = prefs.phrases; phraseGain.connect(master);
      drumGain = ac.createGain(); drumGain.gain.value = prefs.drums; drumGain.connect(master);
      rainGain = ac.createGain(); rainGain.gain.value = 0; rainGain.connect(bedGain);
    }
    if (ac.state === 'suspended') ac.resume();
    return ac;
  }

  function env(ctx, out, t, attack, sustain, release, peak) {
    var g = ctx.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(peak, t + attack);
    g.gain.setValueAtTime(peak, t + attack + sustain);
    g.gain.exponentialRampToValueAtTime(0.0001, t + attack + sustain + release);
    g.connect(out);
    return g;
  }

  function playPad(chord, t, dur, out) {
    try {
      var ctx = audio();
      var g = env(ctx, out, t, 0.9, Math.max(0.2, dur - 1.4), 1.1, 0.16);
      chord.forEach(function (midi, i) {
        var f = 440 * Math.pow(2, (midi - 69) / 12);
        var o = ctx.createOscillator();
        o.type = i === 0 ? 'triangle' : 'sine';
        o.frequency.value = f;
        o.connect(g);
        o.start(t);
        o.stop(t + dur + 0.2);
      });
    } catch (e) { /* audio is a nicety */ }
  }

  function playBass(midi, t, dur, out) {
    try {
      var ctx = audio();
      var f = 440 * Math.pow(2, (midi - 12 - 69) / 12);
      var o = ctx.createOscillator();
      o.type = 'sine';
      o.frequency.value = f;
      var g = env(ctx, out, t, 0.4, Math.max(0.2, dur - 0.9), 0.5, 0.2);
      o.connect(g);
      o.start(t);
      o.stop(t + dur + 0.2);
    } catch (e) { /* fine */ }
  }

  function playLead(midi, t, dur, out) {
    try {
      var ctx = audio();
      var f = 440 * Math.pow(2, (midi - 69) / 12);
      var g = env(ctx, out, t, 0.01, dur * 0.5, dur * 0.7, 0.5);
      [[1, 'triangle', 1], [2, 'sine', 0.28], [3, 'sine', 0.09]].forEach(function (p) {
        var o = ctx.createOscillator();
        o.type = p[1];
        o.frequency.value = f * p[0];
        var pg = ctx.createGain();
        pg.gain.value = p[2];
        o.connect(pg).connect(g);
        o.start(t);
        o.stop(t + dur + 0.6);
      });
    } catch (e) { /* fine */ }
  }

  function playTick(t, out) {
    try {
      var ctx = audio();
      var buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.05), ctx.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 2);
      var src = ctx.createBufferSource();
      src.buffer = buf;
      var hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 2200;
      var g = ctx.createGain();
      g.gain.setValueAtTime(0.001, t);
      g.gain.exponentialRampToValueAtTime(0.4, t + 0.003);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
      src.connect(hp).connect(g).connect(out);
      src.start(t);
      src.stop(t + 0.06);
    } catch (e) { /* fine */ }
  }

  function playKick(t, out) {
    try {
      var ctx = audio();
      var o = ctx.createOscillator();
      o.type = 'sine';
      o.frequency.setValueAtTime(120, t);
      o.frequency.exponentialRampToValueAtTime(38, t + 0.16);
      var g = ctx.createGain();
      g.gain.setValueAtTime(0.55, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
      o.connect(g).connect(out);
      o.start(t);
      o.stop(t + 0.25);
    } catch (e) { /* fine */ }
  }

  function playBrush(t, out) {
    try {
      var ctx = audio();
      var buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.08), ctx.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 1.5);
      var src = ctx.createBufferSource();
      src.buffer = buf;
      var bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 5200;
      bp.Q.value = 0.6;
      var g = ctx.createGain();
      g.gain.setValueAtTime(0.001, t);
      g.gain.exponentialRampToValueAtTime(0.14, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
      src.connect(bp).connect(g).connect(out);
      src.start(t);
      src.stop(t + 0.09);
    } catch (e) { /* fine */ }
  }

  function ensureRain() {
    if (!rainSrc) {
      var ctx = audio();
      var len = ctx.sampleRate * 4;
      var buf = ctx.createBuffer(1, len, ctx.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      rainSrc = ctx.createBufferSource();
      rainSrc.buffer = buf;
      rainSrc.loop = true;
      var lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 3200;
      var hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 700;
      rainSrc.connect(hp).connect(lp).connect(rainGain);
      rainSrc.start();
    }
  }

  // ---- scheduler: pad + kit ticking at 84 BPM, eighth notes ------------------
  var BPM = 84;
  var barDur = (60 / BPM) * 4;
  var eighthDur = barDur / 8;
  var barStartRef = 0;
  var nextBarTime = 0;
  var barIndex = 0;
  var schedulerTimer = null;

  function scheduleBar(t, idx) {
    if (!keyInfo) return;
    if (idx % 2 === 0) {
      var deg = keyInfo.progression[Math.floor(idx / 2) % keyInfo.progression.length];
      var chord = chordTones(keyInfo, deg, 4);
      playPad(chord, t, barDur * 2, bedGain);
      playBass(keyInfo.rootPc + keyInfo.steps[deg % keyInfo.steps.length], t, barDur * 2, bedGain);
    }
    playKick(t, drumGain);
    playKick(t + 4 * eighthDur, drumGain);
    [1, 3, 5, 7].forEach(function (i) { playBrush(t + i * eighthDur, drumGain); });
  }

  function schedulerTick() {
    var ctx = audio();
    while (nextBarTime < ctx.currentTime + 0.6) {
      scheduleBar(nextBarTime, barIndex);
      nextBarTime += barDur;
      barIndex++;
    }
  }
  function startScheduler() {
    var ctx = audio();
    if (schedulerTimer) return;
    barStartRef = ctx.currentTime + 0.1;
    nextBarTime = barStartRef;
    barIndex = 0;
    schedulerTick();
    schedulerTimer = setInterval(schedulerTick, 150);
  }
  function stopScheduler() {
    clearTimeout(schedulerTimer);
    clearInterval(schedulerTimer);
    schedulerTimer = null;
  }
  function quantize(t) {
    var rel = t - barStartRef;
    var q = Math.ceil(rel / eighthDur) * eighthDur;
    return barStartRef + q;
  }

  // ---- phrase playback --------------------------------------------------------
  var log = [];
  var lastActivityAt = Date.now();

  function relTime(at) {
    var s = Math.max(0, Math.round((Date.now() - at) / 1000));
    return s < 5 ? 'just now' : s < 60 ? s + 's ago' : s < 3600 ? Math.round(s / 60) + 'm ago' : Math.round(s / 3600) + 'h ago';
  }

  function renderStrip(phrase) {
    var box = $('npStrip');
    box.innerHTML = '';
    if (phrase.notes && phrase.notes.length) {
      var lo = Math.min.apply(null, phrase.notes), hi = Math.max.apply(null, phrase.notes);
      phrase.notes.slice(0, 48).forEach(function (n) {
        var i = document.createElement('i');
        var h = hi === lo ? 20 : 6 + (n - lo) / (hi - lo) * 34;
        i.style.height = h + 'px';
        box.appendChild(i);
      });
    } else if (phrase.keys) {
      for (var k = 0; k < Math.min(16, phrase.keys); k++) {
        var i2 = document.createElement('i');
        i2.className = 'tickmark';
        i2.style.height = (10 + (k % 4) * 6) + 'px';
        box.appendChild(i2);
      }
    } else {
      var e = document.createElement('span');
      e.className = 'empty';
      e.textContent = 'the shape of the current phrase will draw here';
      box.appendChild(e);
    }
  }

  function renderLog() {
    var box = $('log');
    if (!log.length) { box.innerHTML = '<p class="empty">Nothing yet. Tune in, or send the first phrase below.</p>'; return; }
    box.innerHTML = log.slice(0, 12).map(function (p) {
      var who = p.notes && p.notes.length ? p.notes.length + ' note' + (p.notes.length === 1 ? '' : 's') : (p.keys || 0) + ' key' + (p.keys === 1 ? '' : 's');
      return '<div class="row' + (p.archive ? ' archive' : '') + '"><span class="who"><b>' + esc(p.kind) + ' / ' + esc(p.app) + '</b>' + (p.place ? ' · ' + esc(p.place) : '') + ' — ' + who + (p.archive ? ' · from the archive' : '') + '</span><span class="when">' + relTime(p.at) + '</span></div>';
    }).join('');
  }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function setNowPlaying(phrase, archive) {
    var kind = phrase.notes && phrase.notes.length ? 'Playing a phrase' : 'Playing keystrokes';
    $('npKind').textContent = kind;
    $('npWho').innerHTML = '<b>' + esc(phrase.kind) + ' / ' + esc(phrase.app) + '</b>' + (phrase.place ? ' from ' + esc(phrase.place) : '');
    $('npWhen').textContent = 'sent ' + relTime(phrase.at);
    $('npArchive').hidden = !archive;
    renderStrip(phrase);
  }

  function playPhrase(phrase, archive) {
    var ctx = audio();
    var startAt = Math.max(ctx.currentTime + 0.08, quantize(ctx.currentTime + 0.08));
    if (phrase.notes && phrase.notes.length) {
      phrase.notes.slice(0, 32).forEach(function (n, i) {
        var midi = snapToKey(n, keyInfo, 55, 79);
        playLead(midi, startAt + i * eighthDur, eighthDur * 1.7, phraseGain);
      });
    } else if (phrase.keys) {
      var n = Math.min(16, phrase.keys);
      for (var i = 0; i < n; i++) playTick(startAt + i * 0.12, phraseGain);
    } else {
      return;
    }
    setNowPlaying(phrase, archive);
    log.unshift({ at: phrase.at, kind: phrase.kind, app: phrase.app, place: phrase.place, notes: phrase.notes, keys: phrase.keys, archive: !!archive });
    log = log.slice(0, 12);
    renderLog();
  }

  // ---- data: key of the day, then the live feed ------------------------------
  var latestId = 0;
  var archive = [];
  var mineIds = {};
  var tunedIn = false;
  var pollTimer = null;

  function loadKeyAndArchive() {
    return fetch(API, { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (s) {
      if (!s) return;
      keyInfo = buildKey(s.key && s.key.today);
      $('keyname').textContent = keyInfo.label;
      latestId = s.latestId || 0;
      archive = (s.recent || []).filter(function (p) { return (p.notes && p.notes.length) || p.keys; });
    }).catch(function () { keyInfo = keyInfo || buildKey(null); $('keyname').textContent = keyInfo.label + ' (offline)'; });
  }

  function poll() {
    if (!tunedIn || document.hidden) return;
    fetch(API + '?since=' + latestId, { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (res) {
      if (!res) return;
      latestId = Math.max(latestId, res.latestId || 0);
      (res.phrases || []).forEach(function (p) {
        if (mineIds[p.id]) { delete mineIds[p.id]; return; }
        if (!(p.notes && p.notes.length) && !p.keys) return;
        archive.unshift(p);
        archive = archive.slice(0, 40);
        lastActivityAt = Date.now();
        playPhrase(p, false);
      });
    }).catch(function () {});
  }

  function checkQuiet() {
    if (!tunedIn) return;
    if (Date.now() - lastActivityAt > 20000 && archive.length) {
      var pick = archive[Math.floor(Math.random() * archive.length)];
      playPhrase(pick, true);
      lastActivityAt = Date.now();
    }
  }

  // ---- lamp + air state -------------------------------------------------------
  function setAir(on) {
    $('lamp').classList.toggle('on', on);
    $('airstate').textContent = on ? 'on air' : 'off air';
  }

  $('tune').addEventListener('click', function () {
    tunedIn = !tunedIn;
    audio();
    $('tune').setAttribute('aria-pressed', String(tunedIn));
    $('tune').textContent = tunedIn ? '■ Turn off' : '▶ Tune in';
    setAir(tunedIn);
    $('firstrun').hidden = tunedIn;
    if (tunedIn) {
      lastActivityAt = Date.now();
      startScheduler();
      if (!keyInfo) loadKeyAndArchive().then(poll); else poll();
      clearInterval(pollTimer);
      pollTimer = setInterval(poll, 3000);
    } else {
      stopScheduler();
      clearInterval(pollTimer);
      $('npKind').textContent = 'Off air';
      $('npWho').innerHTML = 'Press <b>Tune in</b> to start listening.';
      $('npWhen').textContent = '';
      $('npArchive').hidden = true;
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && tunedIn) poll();
  });

  setInterval(checkQuiet, 4000);

  // ---- rain toggle ------------------------------------------------------------
  function paintRain() {
    $('rain').setAttribute('aria-pressed', String(prefs.rain));
    $('rain').textContent = prefs.rain ? '☔ Rain on' : '☔ Rain off';
    if (rainGain) rainGain.gain.value = prefs.rain ? 0.18 : 0;
  }
  $('rain').addEventListener('click', function () {
    audio();
    ensureRain();
    prefs.rain = !prefs.rain;
    paintRain();
    savePrefs();
  });

  // ---- mixer --------------------------------------------------------------------
  function wireMixer(id, key) {
    var el = $(id), out = $(id + 'V');
    el.value = String(Math.round(prefs[key] * 100));
    out.textContent = el.value;
    el.addEventListener('input', function () {
      prefs[key] = Number(el.value) / 100;
      out.textContent = el.value;
      audio();
      var node = key === 'bed' ? bedGain : key === 'phrases' ? phraseGain : drumGain;
      if (node) node.gain.value = prefs[key];
      savePrefs();
    });
  }
  wireMixer('mixBed', 'bed');
  wireMixer('mixPhrases', 'phrases');
  wireMixer('mixDrums', 'drums');

  // ---- send a phrase: one-octave keyboard + A–K --------------------------------
  var piano = $('piano');
  var WHITE_KEYS = 'asdfghjk';
  var BLACK_KEYS = { 1: 'w', 3: 'e', 6: 't', 8: 'y', 10: 'u' };
  var WHITE_STEPS = [0, 2, 4, 5, 7, 9, 11, 12];
  var buttons = {};
  var keymap = {};
  var sendPending = [];
  var sendTimer = null;
  var sentCount = 0;

  (function buildPiano() {
    var whites = WHITE_STEPS.length;
    WHITE_STEPS.forEach(function (step, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'w';
      b.dataset.midi = String(60 + step);
      b.setAttribute('aria-label', NOTE_NAMES[step % 12] + (4 + Math.floor(step / 12)));
      if (i < WHITE_KEYS.length) { b.textContent = WHITE_KEYS[i].toUpperCase(); keymap[WHITE_KEYS[i]] = 60 + step; }
      piano.appendChild(b);
      buttons[60 + step] = b;
    });
    for (var s = 0; s < 12; s++) {
      if (!(s in BLACK_KEYS)) continue;
      var whiteBefore = WHITE_STEPS.filter(function (w) { return w < s; }).length;
      var b2 = document.createElement('button');
      b2.type = 'button';
      b2.className = 'b';
      b2.dataset.midi = String(60 + s);
      b2.setAttribute('aria-label', NOTE_NAMES[s % 12] + '4');
      b2.style.left = 'calc(' + (whiteBefore / whites * 100) + '% - ' + (100 / whites * 0.3) + '%)';
      b2.style.width = (100 / whites * 0.6) + '%';
      b2.textContent = BLACK_KEYS[s].toUpperCase();
      keymap[BLACK_KEYS[s]] = 60 + s;
      piano.appendChild(b2);
      buttons[60 + s] = b2;
    }
  })();

  function flash(midi) {
    var b = buttons[midi];
    if (!b) return;
    b.classList.add('on');
    setTimeout(function () { b.classList.remove('on'); }, 150);
  }

  function sendPhrase() {
    clearTimeout(sendTimer);
    if (!sendPending.length || !window.PointCastKeyboard) { sendPending = []; return; }
    var notes = sendPending.slice(0, 24);
    sendPending = [];
    function onEcho(e) {
      if (e.detail && e.detail.id) mineIds[e.detail.id] = true;
      window.removeEventListener('pointcast:keyboard', onEcho);
    }
    window.addEventListener('pointcast:keyboard', onEcho);
    window.PointCastKeyboard.note(notes, null, { sound: false });
  }

  function hitKey(midi) {
    audio();
    var ctx = audio();
    playLead(midi, ctx.currentTime, 0.5, phraseGain);
    flash(midi);
    sentCount++;
    $('sendCount').textContent = sentCount + ' note' + (sentCount === 1 ? '' : 's') + ' sent this visit';
    sendPending.push(midi);
    clearTimeout(sendTimer);
    sendTimer = setTimeout(sendPhrase, 900);
  }

  piano.addEventListener('pointerdown', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    e.preventDefault();
    hitKey(Number(b.dataset.midi));
  });
  document.addEventListener('keydown', function (e) {
    if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    if (t && /INPUT|TEXTAREA|SELECT/.test(t.tagName)) return;
    var midi = keymap[String(e.key || '').toLowerCase()];
    if (midi) { e.preventDefault(); hitKey(midi); }
  });

  function leave() {
    sendPhrase();
    if (window.PointCastKeyboard) window.PointCastKeyboard.flush();
  }
  addEventListener('pagehide', leave);
  document.addEventListener('visibilitychange', function () { if (document.hidden) sendPhrase(); });

  // ---- boot -----------------------------------------------------------------
  paintRain();
  setAir(false);
  loadKeyAndArchive();
})();
</script>
</body>
</html>
