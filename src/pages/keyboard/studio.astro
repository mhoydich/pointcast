---
// Sol Studio: private musical draft with optional, explicit shared passages.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>Sol Studio · Keyboard Bloom</title>
  <meta name="description" content="An expressive writing room where words make music, ideas answer back, and friends can build a piece together.">
  <link rel="canonical" href="https://pointcast.xyz/keyboard/studio">
  <style is:inline>
    :root{color-scheme:dark;--bg:#0e1718;--card:#182628;--raised:#203236;--line:#3c5552;--ink:#f8f0dc;--muted:#acc0b3;--sun:#ffd58b;--peach:#f5a28d;--mint:#9ad2bb;--blue:#a4cde2;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    *{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(circle at 90% -10%,#43554a88,transparent 42%),radial-gradient(circle at -20% 100%,#34556b66,transparent 48%),var(--bg);color:var(--ink)}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}button,input,textarea,select{outline-offset:3px}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--sun)}[hidden]{display:none!important}
    .shell{max-width:1650px;margin:auto;min-height:100dvh;padding:0 24px 28px}.top{height:86px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #69877a45}.brand{display:flex;gap:13px;align-items:center;text-decoration:none;color:var(--ink);font-family:Georgia,serif;font-size:25px;letter-spacing:-.03em}.brand-mark{display:grid;place-items:center;width:39px;height:39px;border:1px solid #ffdf9d80;border-radius:50%;background:radial-gradient(circle,#ffe7a1 0 26%,#efaa6b 27% 46%,transparent 47%);box-shadow:0 0 30px #ffb66c55}.brand em{font-style:italic;color:var(--sun)}.top-right{display:flex;align-items:center;gap:18px}.top a:not(.brand){color:var(--muted);text-decoration:none;font-size:12px}.top a:hover{color:var(--ink)}.eyebrow{color:var(--sun);font-size:10px;text-transform:uppercase;letter-spacing:.22em;font-weight:700}
    .intro{display:flex;align-items:end;justify-content:space-between;gap:18px;padding:31px 4px 25px}.intro h1{font-family:Georgia,serif;font-weight:400;letter-spacing:-.055em;font-size:clamp(36px,5.3vw,70px);line-height:.99;margin:10px 0 8px}.intro h1 i{font-weight:400;color:var(--peach)}.intro p{font-size:14px;color:var(--muted);margin:0;max-width:580px;line-height:1.55}.scene-picker{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.scene-picker button,.segment button{border:1px solid var(--line);background:#ffffff09;border-radius:100px;padding:8px 12px;font-size:11px}.scene-picker button[aria-pressed=true],.segment button[aria-selected=true]{background:var(--sun);border-color:var(--sun);color:#24302e}
    .layout{display:grid;grid-template-columns:minmax(190px, .8fr) minmax(470px,2.3fr) minmax(300px,1fr);gap:17px;align-items:stretch;min-height:680px}.card{border:1px solid #69877a55;background:#142225cc;border-radius:20px;box-shadow:0 18px 45px #030b1240;overflow:hidden}.scene-card{position:relative;display:flex;flex-direction:column;padding:22px;min-height:620px;background:linear-gradient(150deg,#1d3333,#1c3033 55%,#2e3036);isolation:isolate}.scene-card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 54% 23%,#fed99030,transparent 27%),radial-gradient(circle at 0 95%,#9dc4af32,transparent 50%);z-index:-1}.scene-card h2,.rail h2{font-size:11px;text-transform:uppercase;letter-spacing:.19em;color:#bed5c9;margin:0}.scene-card p{font-size:12px;color:var(--muted);line-height:1.6;margin:9px 0}.scene-frame{position:relative;flex:1;min-height:330px;overflow:hidden}.sun{position:absolute;top:15%;left:50%;width:135px;height:135px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle at 40% 36%,#fff8dc,#ffd28e 44%,#ed9c71 75%);box-shadow:0 0 65px #f7bd7755,0 0 140px #e89c6944;transition:transform .5s,filter .7s}.hill{position:absolute;left:-28%;width:156%;height:37%;border-radius:50% 50% 0 0}.hill.one{bottom:15%;background:#3f6762;transform:rotate(-9deg)}.hill.two{bottom:-3%;background:#244946;transform:rotate(10deg)}.horizon{position:absolute;inset:auto 0 14%;height:1px;background:#ffffff36}.constellation{position:absolute;inset:0;pointer-events:none}.star{position:absolute;width:5px;height:5px;border-radius:50%;background:#ffe1a9;box-shadow:0 0 13px #fff7ce;animation:rise 1s ease-out both}.scene-card[data-scene=night]{background:linear-gradient(160deg,#181a38,#253958 60%,#222e43)}.scene-card[data-scene=night] .sun{background:radial-gradient(circle at 36% 35%,#f8f4ec,#bacbe9);box-shadow:0 0 60px #aec5ee66;width:105px;height:105px}.scene-card[data-scene=night] .hill.one{background:#344666}.scene-card[data-scene=night] .hill.two{background:#20314e}.scene-card[data-scene=rain]{background:linear-gradient(160deg,#24445a,#36595e 55%,#314a49)}.scene-card[data-scene=rain] .sun{filter:blur(2px) saturate(.5);opacity:.7}.scene-card[data-scene=rain] .hill.one{background:#568071}.scene-card[data-scene=rain] .hill.two{background:#2c5a56}.scene-card[data-scene=glow]{background:linear-gradient(160deg,#553a46,#725252 55%,#375453)}.scene-card[data-scene=glow] .sun{background:radial-gradient(circle at 40% 36%,#fff1ce,#ffb68e 50%,#eb8ea7);box-shadow:0 0 75px #ed869977}.scene-caption{z-index:1;display:flex;justify-content:space-between;gap:10px;align-items:end;font-family:Georgia,serif;font-style:italic;font-size:18px;line-height:1.25}.scene-caption small{font:10px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted);white-space:nowrap}.scene-card.playing .sun{transform:translateX(-50%) scale(1.055)}
    .editor-card{display:flex;flex-direction:column;background:linear-gradient(145deg,#223334,#172528 60%)}.editor-head{border-bottom:1px solid #74928644;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 22px}.pill{font:10px ui-monospace,monospace;letter-spacing:.08em;border:1px solid #809b8b66;border-radius:50px;padding:7px 10px;color:#d9eadc}.text-button{border:0;background:none;color:var(--mint);font-size:11px;padding:7px;cursor:pointer}.text-button:hover{text-decoration:underline}.editor-body{display:flex;flex-direction:column;padding:36px clamp(24px,5vw,66px) 22px;flex:1;min-height:510px}.draft-label{color:#bbccbb;letter-spacing:.24em;font:10px ui-monospace,monospace;text-transform:uppercase}.title{display:block;background:none;border:0;width:100%;font:400 clamp(32px,3.2vw,52px)/1.15 Georgia,serif;letter-spacing:-.04em;caret-color:var(--sun);margin:20px 0 16px;padding:0}.title::placeholder{color:#a4b9aa}.body{display:block;flex:1;min-height:300px;width:100%;resize:vertical;background:none;border:0;color:#f5ecd8;font:19px/1.85 Georgia,serif;caret-color:var(--sun);padding:0}.body::placeholder{color:#a1b7ab}.editor-foot{border-top:1px solid #74928644;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:#b8cbbb;font:11px ui-monospace,monospace}.editor-foot span:first-child{max-width:65%}.editor-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.editor-actions button{border:1px solid var(--line);border-radius:100px;background:#ffffff0b;color:var(--ink);font:11px ui-sans-serif,sans-serif;padding:8px 11px}.editor-actions button:hover{background:#ffffff1e}.editor-actions .accent{background:var(--sun);color:#273432;border-color:var(--sun)}
    .rail{display:flex;flex-direction:column;min-width:0}.rail-top{padding:19px 18px 0}.rail-top h2{margin-bottom:15px}.segment{display:flex;gap:5px}.segment button{flex:1}.rail-content{padding:21px 18px;display:flex;flex-direction:column;flex:1;min-height:0}.rail-content p{font-size:12px;line-height:1.6;color:var(--muted)}.echo-orb{height:105px;display:grid;place-items:center}.echo-orb span{width:64px;height:64px;display:block;border-radius:50%;background:radial-gradient(circle at 37% 34%,#fff6d9,#e9b588 55%,#ca9189);box-shadow:0 0 0 11px #ffd9a915,0 0 0 24px #ffd9a90b,0 0 35px #f5bc9b77}.echo-quote{font:italic 22px/1.38 Georgia,serif;color:#ffeed3;margin:6px 0 11px}.echo-source{font-size:10px;color:var(--mint);letter-spacing:.1em;text-transform:uppercase}.echo-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.outline,.solid{border:1px solid var(--line);border-radius:100px;background:#ffffff0a;color:var(--ink);font-size:11px;padding:9px 12px}.solid{background:var(--sun);border-color:var(--sun);color:#263532}.outline:hover{background:#ffffff20}.solid:hover{filter:brightness(1.08)}.mini-title{font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:var(--mint);margin:25px 0 10px}.margin{display:flex;flex-direction:column;gap:8px;max-height:230px;overflow:auto;min-height:0}.margin-item,.passage{background:#ffffff0a;border:1px solid #65837548;border-radius:11px;padding:11px 12px;font-size:12px;line-height:1.5;overflow-wrap:anywhere}.margin-item button{display:block;border:0;background:none;color:var(--sun);font-size:10px;padding:7px 0 0}.reply-row{display:flex;gap:5px;margin-top:auto;padding-top:13px}.reply-row input,.room-fields input,.room-fields textarea{border:1px solid var(--line);background:#0e1a1c;color:var(--ink);border-radius:9px;padding:10px;min-width:0}.reply-row input{flex:1;font-size:11px}.reply-row button{border:1px solid var(--line);background:var(--raised);border-radius:8px;padding:0 11px}.room-empty{margin-top:13px}.room-code{font:10px ui-monospace,monospace;color:var(--muted);word-break:break-all}.room-fields{display:flex;flex-direction:column;gap:8px}.room-fields label{display:flex;flex-direction:column;gap:5px;font-size:10px;color:var(--muted)}.room-fields textarea{resize:vertical;min-height:84px;font-size:12px;line-height:1.5}.room-actions{display:flex;gap:7px;flex-wrap:wrap}.passages{display:flex;flex-direction:column;gap:9px;overflow:auto;max-height:250px;min-height:100px;flex:1;padding-right:2px;margin:10px 0}.passage .who{font-size:10px;color:var(--mint);display:flex;justify-content:space-between;gap:8px;margin-bottom:6px}.passage .words{white-space:pre-wrap}.room-tip{font-size:10px!important;color:#bbcfbf!important}
    .score{margin-top:17px;border:1px solid #69877a55;background:#17282a;border-radius:20px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px;padding:17px 20px}.score-title{display:flex;align-items:center;gap:13px}.score-title strong{font:19px Georgia,serif;font-weight:400}.score-title small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.meter{display:flex;gap:4px;align-items:end;height:25px}.meter i{width:3px;height:10px;border-radius:3px;background:var(--peach);opacity:.65;transition:height .2s}.meter i:nth-child(2),.meter i:nth-child(5){height:18px}.meter i:nth-child(3){height:25px}.score.playing .meter i{animation:bar .45s ease-in-out alternate 2}.sound-controls{display:flex;gap:7px;align-items:center;justify-content:flex-end;flex-wrap:wrap}.sound-controls button,.sound-controls select{border:1px solid var(--line);border-radius:100px;background:#243638;padding:8px 11px;font-size:11px}.sound-controls button[aria-pressed=true]{background:var(--sun);color:#263532}.sound-controls label{display:flex;gap:6px;align-items:center;font-size:11px;color:var(--muted)}.sound-controls input{width:80px;accent-color:var(--sun)}.toast{min-height:24px;margin:12px 4px 0;color:var(--mint);font-size:11px}.footer{display:flex;gap:16px;flex-wrap:wrap;padding:8px 4px;color:#a7bbb3;font-size:10px}.footer a{color:var(--sun)}dialog{border:1px solid var(--line);border-radius:18px;background:#1c3031;color:var(--ink);padding:24px;max-width:min(440px,90vw)}dialog::backdrop{background:#061012c9}.import-list{display:flex;flex-direction:column;gap:8px;max-height:260px;overflow:auto;margin:15px 0}.import-list button{border:1px solid var(--line);background:#ffffff0b;text-align:left;border-radius:9px;padding:12px}.import-list button:hover{background:#ffffff21}
    @keyframes rise{from{transform:translateY(16px) scale(.2);opacity:0}to{transform:translateY(0) scale(1);opacity:1}}@keyframes bar{to{height:5px}}
    @media(max-width:1150px){.layout{grid-template-columns:minmax(170px,.7fr) minmax(400px,2fr)}.rail{grid-column:1/-1;min-height:360px}.rail-content{display:grid;grid-template-columns:minmax(200px,1fr) minmax(220px,1fr);column-gap:20px}.rail-content>.mini-title,.rail-content>.margin,.rail-content>.reply-row{grid-column:2}.rail-content>.echo-orb,.rail-content>.echo-quote,.rail-content>.echo-source,.rail-content>.echo-actions,.rail-content>p{grid-column:1}.rail-content.room-layout{display:block}.passages{max-height:350px}}
    @media(max-width:720px){.shell{padding:0 12px 18px}.top{height:auto;min-height:72px;padding:12px 2px}.brand{font-size:21px}.brand-mark{width:31px;height:31px}.top-right{gap:9px;flex-wrap:wrap;justify-content:end}.top a:not(.brand){font-size:10px}.intro{padding:24px 3px 18px;display:block}.intro h1{font-size:45px}.intro p{font-size:12px}.scene-picker{margin-top:15px}.layout{display:flex;flex-direction:column;gap:12px}.scene-card{min-height:220px;height:220px;padding:15px}.scene-frame{position:absolute;inset:0;min-height:0;opacity:.8}.scene-card h2,.scene-card p,.scene-caption{position:relative;z-index:2}.scene-card p{max-width:50%;font-size:10px}.scene-caption{margin-top:auto;font-size:16px}.scene-card .sun{width:85px;height:85px;top:10%;left:70%}.editor-body{min-height:430px;padding:26px 23px 16px}.title{font-size:38px}.body{font-size:18px;min-height:270px}.editor-foot{align-items:start;flex-direction:column}.editor-foot span:first-child{max-width:100%}.rail-content{display:block}.rail{min-height:380px}.score{display:block}.sound-controls{justify-content:flex-start;margin-top:14px}.footer{line-height:1.6}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
<div class="shell">
  <header class="top"><a class="brand" href="/keyboard"><span class="brand-mark" aria-hidden="true"></span><span>Keyboard <em>Bloom</em></span></a><nav class="top-right" aria-label="Keyboard versions"><a href="/keyboard">Notes</a><a href="/keyboard/garden">Garden V2</a><a href="/keyboard/play">Original instrument</a><span class="eyebrow">Sol · V3</span></nav></header>
  <div class="intro"><div><div class="eyebrow">A writing room that listens</div><h1>Let the page <i>play back.</i></h1><p>Write a private draft, hear it take shape, follow an echo, then invite someone to add a line of their own.</p></div><div class="scene-picker" aria-label="Scene"><button type="button" data-scene="dawn" aria-pressed="true">Dawn</button><button type="button" data-scene="night" aria-pressed="false">Night</button><button type="button" data-scene="rain" aria-pressed="false">Rain</button><button type="button" data-scene="glow" aria-pressed="false">Glow</button></div></div>
  <main class="layout">
    <section class="scene-card card" id="scene" data-scene="dawn" aria-label="Living scene"><h2>The little world</h2><p id="scene-text">A room of morning light. Keep writing; it will change with you.</p><div class="scene-frame" aria-hidden="true"><div class="sun"></div><div class="horizon"></div><div class="hill one"></div><div class="hill two"></div><div class="constellation" id="stars"></div></div><div class="scene-caption"><span id="scene-caption">Every word finds a place.</span><small id="scene-count">0 WORDS</small></div></section>
    <section class="editor-card card" aria-label="Private draft"><div class="editor-head"><span class="pill">● PRIVATE DRAFT · SAVED HERE</span><button type="button" class="text-button" id="copy-note">Bring a copy from Notes ↗</button></div><div class="editor-body"><label class="draft-label" for="title">A page to begin</label><input class="title" id="title" maxlength="140" placeholder="Give this moment a name" autocomplete="off"><textarea class="body" id="body" placeholder="Begin anywhere. The room will listen…" aria-label="Private writing"></textarea></div><div class="editor-foot"><span id="save-status" role="status">Private draft stays on this device.</span><div class="editor-actions"><button type="button" id="download-draft">Download draft</button><button type="button" id="use-draft" class="accent">Copy to shared passage ↗</button></div></div></section>
    <aside class="rail card" aria-label="Parallel writing panel"><div class="rail-top"><h2>Alongside the page</h2><div class="segment" role="tablist" aria-label="Alongside views"><button type="button" role="tab" id="echo-tab" aria-selected="true" aria-controls="echo-panel">Echo</button><button type="button" role="tab" id="room-tab" aria-selected="false" aria-controls="room-panel">People</button></div></div>
      <section id="echo-panel" role="tabpanel" class="rail-content"><div class="echo-orb" aria-hidden="true"><span></span></div><div class="echo-source">A thought from your words</div><div class="echo-quote" id="echo-quote">Write a line. I’ll offer a thought when you pause.</div><p id="echo-about">Echo runs here on your device. It never sends your draft away.</p><div class="echo-actions"><button class="solid" id="echo-another" type="button">Another thought ↻</button><button class="outline" id="echo-keep" type="button">Keep in margin</button><button class="outline" id="echo-toggle" type="button" aria-pressed="true">Echo on</button></div><div class="mini-title">The margin</div><div class="margin" id="margin" aria-label="Saved margin thoughts"></div><form class="reply-row" id="reply-form"><input id="reply" maxlength="300" placeholder="Answer in the margin…" aria-label="Answer in the margin"><button type="submit" aria-label="Save answer">↵</button></form></section>
      <section id="room-panel" role="tabpanel" class="rail-content room-layout" hidden><div class="echo-source">A piece made together</div><p class="room-tip">Your draft is private. Only passages you send appear here. Anyone with the invite link can read and add. Shared passages remain available to anyone with the link. Rooms cannot be closed yet.</p><div id="no-room" class="room-empty"><button type="button" id="create-room" class="solid">Start a room +</button><p>Create a link to write alongside friends.</p></div><div id="has-room" hidden><div class="room-actions"><button type="button" id="copy-link" class="outline">Copy invite link</button><button type="button" id="export-room" class="outline">Download piece</button></div><p class="room-code" id="room-code"></p><div class="mini-title" id="room-count">Passages</div><div class="passages" id="passages" aria-label="Shared passages"></div><form id="passage-form" class="room-fields"><label>Your name<input id="writer-name" maxlength="32" placeholder="What should we call you?" autocomplete="nickname" required></label><label>Your next passage<textarea id="passage-text" maxlength="3000" placeholder="Add one sentence, a verse, or a scene…" required></textarea></label><div class="room-actions"><button type="submit" class="solid" id="send-passage">Add to the piece ↗</button><button type="button" class="outline" id="leave-room">Leave room</button></div></form></div><p id="room-status" role="status">A room is created only when you ask.</p></section>
    </aside>
  </main>
  <div class="score" id="score"><div class="score-title"><span class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span><strong>The page is an instrument</strong><small id="score-status">Type a few letters; punctuation resolves a chord.</small></span></div><div class="sound-controls"><button type="button" id="sound" aria-pressed="true">♫ Sound on</button><label for="voice">Voice</label><select id="voice" aria-label="Sound voice"><option value="keys">Warm keys</option><option value="glass">Glass</option><option value="plucks">Soft plucks</option></select><label for="tempo">Feel</label><select id="tempo" aria-label="Music feel"><option value="float">Float</option><option value="slow">Slow + reverb</option><option value="pulse">Little pulse</option></select><label for="volume">Volume</label><input id="volume" type="range" min="0" max="100" value="38" aria-label="Volume"></div></div>
  <p class="toast" id="toast" role="status" aria-live="polite"></p><footer class="footer"><span>Sol Studio · an experiment in writing together</span><span>Draft and margin saved in this browser.</span><span>Shared passages live at your invite link.</span></footer>
</div>
<dialog id="import-dialog"><div class="eyebrow">Bring a copy</div><h2>Choose a private note</h2><p>This copies text into Sol Studio. Nothing is shared with a room.</p><div class="import-list" id="import-list"></div><button class="outline" id="close-import" type="button">Close</button></dialog>
<script is:inline>
(()=>{
  'use strict';
  const $=id=>document.getElementById(id);
  const DRAFT_KEY='pointcast.keyboard.studio.draft.v1';
  const PREF_KEY='pointcast.keyboard.studio.prefs.v1';
  const NOTES_KEY='pointcast.keyboard.notes.v1';
  const SCENES={dawn:['A room of morning light. Keep writing; it will change with you.','Every word finds a place.'],night:['The sky gathers what the page lets go.','A constellation of little thoughts.'],rain:['Let a sentence fall like rain.','Some things grow after rain.'],glow:['A little warmth follows your words.','The page has its own sunset.']};
  const $title=$('title'),$body=$('body'),$toast=$('toast');
  let draft={title:'',body:'',margin:[],revision:0},prefs={scene:'dawn',sound:true,voice:'keys',tempo:'float',volume:38,echo:true};
  let storageConflict=false,storageCorrupt=false,roomTag='',pendingPassage=null;
  let roomId='',roomToken='',roomPassages=[],roomBusy=false,echoTimer=0,echoIndex=0,audio=null,delay=null,master=null,lastNoteAt=0;
  function toast(s){$toast.textContent=s;clearTimeout(toast.timer);toast.timer=setTimeout(()=>$toast.textContent='',4200)}
  function read(key){try{return JSON.parse(localStorage.getItem(key)||'null')}catch{return null}}
  function write(key,value){try{localStorage.setItem(key,JSON.stringify(value));return true}catch{return false}}
  let rawDraft=null;try{rawDraft=localStorage.getItem(DRAFT_KEY)}catch{storageCorrupt=true}
  const previous=read(DRAFT_KEY);if(rawDraft&&!previous)storageCorrupt=true;if(previous&&typeof previous==='object'){draft={title:typeof previous.title==='string'?previous.title:'',body:typeof previous.body==='string'?previous.body:'',margin:Array.isArray(previous.margin)?previous.margin.filter(x=>x&&typeof x.text==='string').slice(-30):[],revision:Number(previous.revision)||0}};
  const savedPrefs=read(PREF_KEY);if(savedPrefs&&typeof savedPrefs==='object')prefs={...prefs,...savedPrefs};
  $title.value=draft.title;$body.value=draft.body;
  function save(){draft.title=$title.value;draft.body=$body.value;if(storageConflict||storageCorrupt){$('save-status').textContent=storageConflict?'Another tab changed this draft. Download your version before reloading.':'Stored draft could not be read. Download this version before changing storage.';return}draft.revision=Math.max(Date.now(),draft.revision+1);$('save-status').textContent=write(DRAFT_KEY,draft)?'● Saved on this device':'Could not save here. Download a copy.'}
  window.addEventListener('storage',event=>{if(event.key!==DRAFT_KEY||!event.newValue)return;let incoming;try{incoming=JSON.parse(event.newValue)}catch{storageConflict=true;save();return}if(!incoming||typeof incoming!=='object'||typeof incoming.title!=='string'||typeof incoming.body!=='string')return;if(incoming.title===draft.title&&incoming.body===draft.body)return;if(document.activeElement===$title||document.activeElement===$body){storageConflict=true;save();return}draft={title:incoming.title,body:incoming.body,margin:Array.isArray(incoming.margin)?incoming.margin.slice(-30):[],revision:Number(incoming.revision)||0};$title.value=draft.title;$body.value=draft.body;renderMargin();updateScene();echo();$('save-status').textContent='● Updated from another tab.'});
  window.addEventListener('beforeunload',event=>{if(storageConflict){event.preventDefault();event.returnValue=''}});
  function savePrefs(){write(PREF_KEY,prefs)}
  function words(s){return (s.trim().match(/\S+/g)||[]).length}
  function updateScene(){const count=words($body.value);$('scene-count').textContent=count+' '+(count===1?'WORD':'WORDS');$('scene-caption').textContent=count>80?'Your world has room to grow.':SCENES[prefs.scene][1];document.querySelectorAll('[data-scene]').forEach(el=>{if(el.tagName==='BUTTON')el.setAttribute('aria-pressed',String(el.dataset.scene===prefs.scene))});$('scene').dataset.scene=prefs.scene;$('scene-text').textContent=SCENES[prefs.scene][0]}
  function star(){const host=$('stars');const el=document.createElement('i');el.className='star';el.style.left=(12+Math.random()*76)+'%';el.style.top=(8+Math.random()*68)+'%';host.append(el);while(host.children.length>Math.min(35,5+Math.ceil(words($body.value)/7)))host.firstElementChild.remove()}
  document.querySelectorAll('.scene-picker button').forEach(button=>button.addEventListener('click',()=>{prefs.scene=button.dataset.scene;savePrefs();updateScene();playTone(1,true)}));
  const cueMap=[{words:/\b(ocean|sea|river|water|rain|wave|lake)\b/i,topic:'water',prompts:['What would this water remember if it could speak?','Let the next line move like a tide: what arrives, and what leaves?','Which small sound is hiding underneath the water?']},{words:/\b(flower|garden|seed|leaf|tree|forest|bloom)\b/i,topic:'growth',prompts:['What is trying to grow in this moment?','Name one thing that needs more light.','What would happen if you let this thought bloom one step further?']},{words:/\b(friend|together|we|us|love|home|family)\b/i,topic:'connection',prompts:['What would the other person say next?','Which part of this moment belongs to both of you?','Try writing one line from someone else’s side of the room.']},{words:/\b(night|moon|star|dark|dream|sleep)\b/i,topic:'night',prompts:['What becomes possible after the room goes quiet?','Which detail only appears in the dark?','Give the night one answer, then let it ask something back.']},{words:/\b(city|street|train|car|building|town)\b/i,topic:'place',prompts:['Who else is moving through this place right now?','What sound would you hear if you paused here?','Move the camera one doorway to the left. What changes?']}];
  const general=['What happens one heartbeat after this line?','What is the surprising detail you have not named yet?','If this were a scene, what would the room sound like?','Leave a little space for someone else to answer.','Which word wants to become the next sentence?'];
  function echo(force=false){if(!prefs.echo)return;const body=$body.value.trim();if(!body){$('echo-quote').textContent='Write a line. I’ll offer a thought when you pause.';$('echo-about').textContent='Echo runs here on your device. It never sends your draft away.';return}const match=cueMap.find(c=>c.words.test(body.slice(-600)));const options=match?match.prompts:general;const i=(words(body)+echoIndex+(force?1:0))%options.length;$('echo-quote').textContent=options[i];$('echo-about').textContent=match?'A '+match.topic+' thread is coming through. Keep it, answer it, or follow your own path.':'A small thought from the rhythm of your writing. Keep it or keep moving.'}
  function scheduleEcho(){clearTimeout(echoTimer);echoTimer=setTimeout(()=>echo(),1000)}
  $('echo-another').onclick=()=>{echoIndex++;echo(true);playTone(3,true)};
  $('echo-toggle').onclick=()=>{prefs.echo=!prefs.echo;savePrefs();$('echo-toggle').setAttribute('aria-pressed',String(prefs.echo));$('echo-toggle').textContent=prefs.echo?'Echo on':'Echo off';$('echo-quote').textContent=prefs.echo?'Write a line. I’ll offer a thought when you pause.':'Echo is quiet.';if(prefs.echo)echo()};
  function addMargin(text){if(!text.trim())return;draft.margin.push({text:text.trim().slice(0,300),at:Date.now()});draft.margin=draft.margin.slice(-30);save();renderMargin()}
  function renderMargin(){const host=$('margin');host.replaceChildren();if(!draft.margin.length){const p=document.createElement('p');p.textContent='Keep a thought here, or answer Echo in your own words.';host.append(p);return}draft.margin.forEach((item,index)=>{const div=document.createElement('div');div.className='margin-item';const line=document.createElement('div');line.textContent=item.text;const button=document.createElement('button');button.type='button';button.textContent='Add to draft ↗';button.onclick=()=>{$body.value+=($body.value.trim()?'\n\n':'')+item.text;save();updateScene();toast('Added to your private draft.')};div.append(line,button);host.append(div)})}
  $('echo-keep').onclick=()=>{if(prefs.echo&&$body.value.trim()){addMargin($('echo-quote').textContent);toast('Saved in the margin.')}else toast('Write a line to give Echo something to work with.')};
  $('reply-form').onsubmit=e=>{e.preventDefault();const input=$('reply');if(!input.value.trim())return;addMargin(input.value);input.value='';toast('Your thought is in the margin.')};
  function download(name,body,type){const blob=new Blob([body],{type});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=name;link.click();setTimeout(()=>URL.revokeObjectURL(link.href),30000)}
  function safeName(s){return (s||'sol-studio').trim().replace(/[^a-z0-9_-]+/gi,'-').slice(0,55)||'sol-studio'}
  $('download-draft').onclick=()=>{const t=$title.value.trim()||'Untitled';download(safeName(t)+'.md','# '+t+'\n\n'+$body.value+'\n','text/markdown');toast('Downloaded your private draft.')};
  $('copy-note').onclick=()=>{const host=$('import-list');host.replaceChildren();const data=read(NOTES_KEY);const notes=Array.isArray(data?.notes)?data.notes.filter(n=>n&&!n.deleted&&typeof n.body==='string'):[];if(!notes.length){const p=document.createElement('p');p.textContent='No saved Notes found in this browser.';host.append(p)}notes.forEach(n=>{const b=document.createElement('button');b.type='button';b.textContent=(n.title||'Untitled')+' · '+n.body.slice(0,60);b.onclick=()=>{const hadText=!!$body.value.trim();if(hadText)$body.value+='\n\n'+n.body;else{$title.value=n.title||'';$body.value=n.body}save();updateScene();scheduleEcho();$('import-dialog').close();toast(hadText?'Appended to your private draft. Nothing was shared.':'Copied into your private draft. Nothing was shared.')};host.append(b)});$('import-dialog').showModal()};
  $('close-import').onclick=()=>$('import-dialog').close();
  function setTab(which){const isRoom=which==='room';$('echo-panel').hidden=isRoom;$('room-panel').hidden=!isRoom;$('echo-tab').setAttribute('aria-selected',String(!isRoom));$('room-tab').setAttribute('aria-selected',String(isRoom));$('echo-tab').tabIndex=isRoom?-1:0;$('room-tab').tabIndex=isRoom?0:-1;if(isRoom&&roomId)refreshRoom()}
  $('echo-tab').onclick=()=>setTab('echo');$('room-tab').onclick=()=>setTab('room');for(const tab of [$('echo-tab'),$('room-tab')])tab.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();const next=tab===$('echo-tab')?$('room-tab'):$('echo-tab');setTab(next===$('room-tab')?'room':'echo');next.focus()}});
  function roomStatus(s){if($('room-status').textContent!==s)$('room-status').textContent=s}
  function roomView(){const has=!!roomId;$('no-room').hidden=has;$('has-room').hidden=!has;$('room-code').textContent=has?'Room '+roomId.slice(0,8)+'… · link needed to join':'';if(has)setTab('room')}
  function roomQuery(id=roomId,token=roomToken){return new URLSearchParams({room:id,token}).toString()}
  function inviteUrl(){const url=new URL(location.href);url.searchParams.set('room',roomId);url.searchParams.set('token',roomToken);return url.toString()}
  function enterRoom(id,token){roomId=id;roomToken=token;roomTag='';roomPassages=[];pendingPassage=null;const url=new URL(location.href);url.searchParams.set('room',id);url.searchParams.set('token',token);history.replaceState(null,'',url);roomView();refreshRoom();roomStatus('Only passages you send are shared here.')}
  $('create-room').onclick=async()=>{
    const button=$('create-room');button.disabled=true;
    try{
      const response=await fetch('/api/keyboard-studio?action=create',{method:'POST',headers:{accept:'application/json'}});
      const json=await response.json();
      if(!response.ok||!/^([0-9a-f]{32})$/.test(json.room)||!/^([0-9a-f]{64})$/.test(json.token))throw Error(json.error||'studio-unavailable');
      enterRoom(json.room,json.token);toast('Room made. Copy the invite link to write together.');
    }catch{toast('Room could not start. Try again shortly.')}finally{button.disabled=false}
  };
  function leaveRoom(message){roomId='';roomToken='';roomPassages=[];roomTag='';pendingPassage=null;const url=new URL(location.href);url.searchParams.delete('room');url.searchParams.delete('token');history.replaceState(null,'',url);roomView();roomStatus(message);setTab('echo')}
  $('leave-room').onclick=()=>leaveRoom('You left the room. The invite link still works; your private draft stays here.');
  $('copy-link').onclick=async()=>{try{await navigator.clipboard.writeText(inviteUrl());toast('Invite link copied.')}catch{window.prompt('Copy this invite link',inviteUrl())}};
  $('use-draft').onclick=()=>{setTab('room');if(!roomId){toast('Start a room, then choose what to share.');return}const text=$body.value.trim();if(!text){toast('Write a private draft first.');return}if(text.length>3000){toast('This draft is over 3,000 characters. Choose a shorter passage.');return}$('passage-text').value=text;toast('Copied into the passage box. Send it when you are ready.')};
  $('export-room').onclick=()=>{if(!roomPassages.length){toast('No passages in this room yet.');return}const content='# Sol Studio · a piece together\n\n'+roomPassages.map(p=>'## '+p.name+'\n\n'+p.text).join('\n\n---\n\n')+'\n';download('sol-studio-piece.md',content,'text/markdown');toast('Downloaded the shared piece.')};
  function renderPassages(){const host=$('passages');host.replaceChildren();$('room-count').textContent=roomPassages.length+' '+(roomPassages.length===1?'passage':'passages');if(!roomPassages.length){const p=document.createElement('p');p.textContent='An open page for the first line.';host.append(p);return}roomPassages.forEach(p=>{const card=document.createElement('article');card.className='passage';const header=document.createElement('div');header.className='who';const name=document.createElement('strong');name.textContent=p.name;const time=document.createElement('time');time.dateTime=new Date(p.at).toISOString();time.textContent=new Date(p.at).toLocaleTimeString([], {hour:'numeric',minute:'2-digit'});header.append(name,time);const body=document.createElement('div');body.className='words';body.textContent=p.text;card.append(header,body);host.append(card)})}
  async function refreshRoom(){if(!roomId||roomBusy||document.hidden)return;roomBusy=true;const target=roomId,token=roomToken;try{const headers={accept:'application/json'};if(roomTag)headers['if-none-match']=roomTag;const response=await fetch('/api/keyboard-studio?'+roomQuery(target,token),{headers,cache:'no-store'});if(response.status===304)return;if(!response.ok)throw Error('Room unavailable');const json=await response.json();if(target===roomId&&token===roomToken&&Array.isArray(json.passages)){roomTag=response.headers.get('etag')||'';const before=roomPassages.length;roomPassages=json.passages;renderPassages();roomStatus('Room is ready · '+roomPassages.length+' passages');if(roomPassages.length>before&&before>0)playTone(5,true)}}catch{if(target===roomId&&token===roomToken)roomStatus('Room could not connect. Your private draft is safe; try again shortly.')}finally{roomBusy=false}}
  $('passage-form').onsubmit=async e=>{e.preventDefault();if(!roomId||!roomToken)return;const name=$('writer-name').value.trim().slice(0,32),text=$('passage-text').value.trim().slice(0,3000);if(!name||!text)return;const button=$('send-passage');button.disabled=true;roomStatus('Adding your passage…');try{const response=await fetch('/api/keyboard-studio?'+roomQuery(),{method:'POST',headers:{'content-type':'application/json',accept:'application/json'},body:JSON.stringify({name,text,clientId:(pendingPassage&&pendingPassage.room===roomId&&pendingPassage.name===name&&pendingPassage.text===text?pendingPassage:(pendingPassage={room:roomId,name,text,id:crypto.randomUUID()})).id})});const json=await response.json();if(!response.ok)throw Error(json.error||'Could not send');$('passage-text').value='';pendingPassage=null;roomTag='';write('pointcast.keyboard.studio.name',name);roomStatus('Your passage joined the piece.');await refreshRoom();playTone(8,true)}catch(error){roomStatus(error.message||'Could not send. Try again.')}finally{button.disabled=false}};
  const storedName=read('pointcast.keyboard.studio.name');if(typeof storedName==='string')$('writer-name').value=storedName;
  const invitation=new URL(location.href).searchParams,requested=invitation.get('room'),requestedToken=invitation.get('token');if(requested&&requestedToken&&/^[0-9a-f]{32}$/.test(requested)&&/^[0-9a-f]{64}$/.test(requestedToken))enterRoom(requested,requestedToken);else if(requested||requestedToken)toast('That room link is not valid.');
  setInterval(()=>{if(roomId&&!document.hidden)refreshRoom()},2500);document.addEventListener('visibilitychange',()=>{if(!document.hidden&&roomId)refreshRoom()});
  function setupAudio(){if(audio)return true;try{audio=new (window.AudioContext||window.webkitAudioContext)();master=audio.createGain();master.gain.value=prefs.sound?prefs.volume/100*.23:0;const compressor=audio.createDynamicsCompressor();compressor.threshold.value=-22;compressor.ratio.value=3;master.connect(compressor);compressor.connect(audio.destination);delay=audio.createDelay(1.8);delay.delayTime.value=.38;const feedback=audio.createGain();feedback.gain.value=.28;delay.connect(feedback);feedback.connect(delay);const wet=audio.createGain();wet.gain.value=.22;delay.connect(wet);wet.connect(master);return true}catch{$('score-status').textContent='Audio is unavailable in this browser.';return false}}
  function playTone(index,quiet=false){if(!prefs.sound||!setupAudio())return;audio.resume();const now=audio.currentTime;const scale=[0,2,4,7,9,12,14,16,19];const degree=scale[Math.abs(index)%scale.length];const base=(prefs.scene==='night'?196:prefs.scene==='rain'?220:261.63)*Math.pow(2,degree/12)*(prefs.tempo==='slow'?.75:1);const voice=prefs.voice;const duration=prefs.tempo==='slow'?1.1:voice==='plucks'?.37:.7;const gain=audio.createGain();gain.gain.setValueAtTime(.0001,now);gain.gain.exponentialRampToValueAtTime((quiet?.32:1)*.18,now+.017);gain.gain.exponentialRampToValueAtTime(.0001,now+duration);gain.connect(master);if(delay&&prefs.tempo!=='pulse')gain.connect(delay);[1,voice==='glass'?2.01:voice==='plucks'?2:1.5].forEach((harmonic,i)=>{const osc=audio.createOscillator();osc.type=voice==='glass'?'sine':voice==='plucks'?'triangle':'sine';osc.frequency.setValueAtTime(base*harmonic,now);const layer=audio.createGain();layer.gain.value=i===0?1:.18;osc.connect(layer);layer.connect(gain);osc.start(now);osc.stop(now+duration+.04)});$('score').classList.remove('playing');void $('score').offsetWidth;$('score').classList.add('playing');$('scene').classList.add('playing');setTimeout(()=>$('scene').classList.remove('playing'),280);lastNoteAt=Date.now()}
  function playText(data){if(!data)return;if(/[a-z0-9.!?]/i.test(data))star();if(!prefs.sound)return;const c=data.toLowerCase().charCodeAt(0);if(/[a-z0-9]/i.test(data)){playTone(c%9)}else if(/[.!?]/.test(data)){playTone(0,true);setTimeout(()=>playTone(4,true),85);setTimeout(()=>playTone(8,true),170)}else if(data===' '&&Date.now()-lastNoteAt>500)playTone(4,true)}
  function edit(e){save();updateScene();scheduleEcho();if(e.inputType==='insertText'&&e.data&&e.data.length===1)playText(e.data)}
  $body.addEventListener('input',edit);$title.addEventListener('input',edit);$body.addEventListener('focus',()=>{if(prefs.sound)setupAudio()});
  $('sound').onclick=()=>{prefs.sound=!prefs.sound;savePrefs();$('sound').setAttribute('aria-pressed',String(prefs.sound));$('sound').textContent=prefs.sound?'♫ Sound on':'♫ Sound off';if(master)master.gain.setTargetAtTime(prefs.sound?prefs.volume/100*.23:0,audio.currentTime,.02);if(prefs.sound){setupAudio();playTone(0,true)}};
  $('voice').onchange=()=>{prefs.voice=$('voice').value;savePrefs();playTone(4,true)};$('tempo').onchange=()=>{prefs.tempo=$('tempo').value;savePrefs();playTone(2,true)};$('volume').oninput=()=>{prefs.volume=Number($('volume').value);savePrefs();if(master)master.gain.setTargetAtTime(prefs.sound?prefs.volume/100*.23:0,audio.currentTime,.02)};
  $('voice').value=['keys','glass','plucks'].includes(prefs.voice)?prefs.voice:'keys';$('tempo').value=['float','slow','pulse'].includes(prefs.tempo)?prefs.tempo:'float';$('volume').value=String(Math.max(0,Math.min(100,Number(prefs.volume)||38)));$('sound').setAttribute('aria-pressed',String(prefs.sound));$('sound').textContent=prefs.sound?'♫ Sound on':'♫ Sound off';$('echo-toggle').setAttribute('aria-pressed',String(prefs.echo));$('echo-toggle').textContent=prefs.echo?'Echo on':'Echo off';
  updateScene();renderMargin();echo();roomView();renderPassages();if(storageCorrupt)$('save-status').textContent='Stored draft could not be read. Download this version before changing storage.';
})();
</script>
