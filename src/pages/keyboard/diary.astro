---
/**
 * /keyboard/diary — Key Diary, a musical notetaker.
 *
 * One page per day. Writing plays the day's mood (vowels on the chord,
 * consonants between, punctuation cadences — see /js/keyboard-voice.js) and
 * the performance is kept with the words, so any day can be played back as
 * it was written, and the week can be hummed.
 *
 * Private by design: entries live in this browser (localStorage) and export
 * as JSON. Only a sorted bag of pitches — never the words, never the order —
 * goes to the keyboard signal, and that can be switched off.
 */
const title = 'Key Diary · PointCast';
const description =
  'A diary that plays as you write. Every day has a mood and a melody; play back any entry the way you wrote it, or hum the week. Your words stay in your browser.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://pointcast.xyz/keyboard/diary">
<meta property="og:title" content="Key Diary">
<meta property="og:description" content={description}>
<style is:inline>
:root{color-scheme:dark;--bg:#101813;--panel:#142019;--line:#2b3c2e;--ink:#ede9d7;--dim:#97ab91;--gold:#dfc48d;--mood:#dfc48d;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 86% 0%,#34413255,transparent 43%),var(--bg);color:var(--ink);min-height:100vh}
a{color:var(--gold)}
button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:30px;padding:9px 14px;cursor:pointer;font-size:11px}
button:hover{background:#1e2b20;border-color:#688777}
button[aria-pressed=true]{background:var(--gold);color:var(--bg);border-color:var(--gold)}
button:disabled{opacity:.4;cursor:default}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 30px;border-bottom:1px solid var(--line)}
.brand{margin:0;font-family:Georgia,serif;font-weight:normal;font-size:30px;letter-spacing:-1px}
.brand:before{content:'✳';color:var(--gold);margin-right:12px}
.brand small{display:block;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.2em;color:var(--dim);margin:6px 0 0 44px;text-transform:uppercase}
nav{display:flex;gap:4px;flex-wrap:wrap;font-size:10px}
nav a{color:var(--dim);text-decoration:none;padding:8px 11px;border-radius:20px}
nav a[aria-current=page]{background:#2c3e2b;color:var(--ink)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap}
.app{display:grid;grid-template-columns:300px minmax(0,1fr);min-height:calc(100vh - 90px)}
aside{border-right:1px solid var(--line);background:linear-gradient(155deg,#1d2c20,#111d16);padding:22px 18px;display:flex;flex-direction:column;gap:18px;min-width:0}
.month-head{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--dim)}
.month-head b{font-family:Georgia,serif;font-weight:normal;font-size:19px;color:var(--ink)}
.month-head button{padding:5px 10px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal .dow{font-size:8px;color:var(--dim);text-align:center;letter-spacing:.1em}
.cal button{aspect-ratio:1;padding:0;border-radius:8px;border-color:transparent;font-size:10px;position:relative;color:var(--dim)}
.cal button.has{color:var(--ink);background:color-mix(in srgb,var(--c) 22%,transparent);border-color:color-mix(in srgb,var(--c) 45%,transparent)}
.cal button.today{outline:1px solid var(--gold);outline-offset:-1px}
.cal button.sel{background:var(--c,var(--gold));color:var(--bg)}
.cal button.humming{box-shadow:0 0 14px var(--c)}
.cal button:disabled{opacity:.25}
.list{display:flex;flex-direction:column;gap:6px;overflow:auto;min-height:0;flex:1}
.list h3,.side-h{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);font-weight:normal;margin:0}
.entry{display:block;text-align:left;border-radius:10px;border-color:transparent;padding:10px 12px;width:100%}
.entry.sel{background:#253623aa;border-color:#72846777}
.entry strong{display:block;font-family:Georgia,serif;font-weight:normal;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.entry small{display:block;color:var(--dim);font-size:10px;margin-top:5px}
.entry canvas{display:block;width:100%;height:18px;margin-top:6px}
.privacy{font-size:10px;line-height:1.7;color:#a0ad95;margin:0}
main{display:flex;flex-direction:column;min-width:0}
.page{width:min(860px,100%);margin:0 auto;padding:30px 44px 18px;display:flex;flex-direction:column;flex:1;min-height:0}
.dateline{font-size:9px;letter-spacing:.24em;color:#afbd99;text-transform:uppercase;margin:0 0 10px}
.day{font-family:Georgia,serif;font-size:clamp(32px,4vw,50px);letter-spacing:-1.5px;margin:0 0 16px;font-weight:normal}
.moods{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px}
.moods button{padding:7px 12px;font-size:10px}
.moods button[aria-pressed=true]{background:var(--mood);border-color:var(--mood);color:var(--bg)}
.sheet{position:relative;flex:1;display:flex;min-height:300px}
textarea{flex:1;width:100%;border:0;background:transparent;resize:none;outline:none;color:#e0e4cf;font-family:Georgia,serif;font-size:21px;line-height:1.85;caret-color:var(--mood);padding:0}
textarea::placeholder{color:#6f8a73}
.reading{position:absolute;inset:0;overflow:auto;font-family:Georgia,serif;font-size:21px;line-height:1.85;white-space:pre-wrap;word-break:break-word;color:#4f6452;pointer-events:none}
.reading b{font-weight:normal;color:var(--ink)}
.reading i{font-style:normal;color:var(--bg);background:var(--mood);border-radius:3px}
.roll{display:block;width:100%;height:84px;margin-top:14px;border-radius:12px;background:#0d1711;border:1px solid var(--line)}
.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
.status{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 44px 22px;font-size:10px;color:var(--dim);width:min(860px,100%);margin:0 auto}
#notice{color:var(--gold)}
[hidden]{display:none!important}
@media(max-width:820px){.app{grid-template-columns:minmax(0,1fr)}aside{border-right:0;border-bottom:1px solid var(--line)}.list{flex-direction:row;overflow-x:auto;max-height:none}.entry{min-width:180px}.page{padding:22px 16px 12px}.status{padding:12px 16px 20px}header{padding:16px}textarea,.reading{font-size:19px}.brand small{margin-left:0}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <h1 class="brand">Key Diary<small>A diary that plays as you write</small></h1>
  <nav aria-label="Keyboard family">
    <a href="/keyboard">Notes</a>
    <a href="/keyboard/diary" aria-current="page">Key Diary</a>
    <a href="/keyboard/letter">Key Letter</a>
    <a href="/keyboard/play">Instrument</a>
    <a href="/keyboard-signal">Signal</a>
  </nav>
  <div class="toolbar">
    <button type="button" id="sound" aria-pressed="true">♪ Sound on</button>
    <button type="button" id="share" aria-pressed="true" title="Adds a sorted bag of your notes (never words or order) to the town chord on /keyboard-signal">✳ Town chord on</button>
  </div>
</header>

<div class="app">
  <aside>
    <div class="month-head">
      <button type="button" id="prev" aria-label="Previous month">‹</button>
      <b id="month">—</b>
      <button type="button" id="next" aria-label="Next month">›</button>
    </div>
    <div class="cal" id="cal" role="grid" aria-label="Diary calendar"></div>
    <div class="list" id="list"><h3>Recent days</h3></div>
    <p class="privacy">Your words never leave this browser. Export keeps a copy. The town chord gets only the notes, shuffled into pitch order — no letters, no melody.</p>
  </aside>

  <main>
    <div class="page">
      <p class="dateline" id="dateline">—</p>
      <h2 class="day" id="dayname">Today</h2>
      <div class="moods" id="moods" role="group" aria-label="Mood of the day"></div>
      <div class="sheet">
        <textarea id="body" spellcheck="true" placeholder="What happened today? Write it down and listen to it."></textarea>
        <div class="reading" id="reading" hidden aria-live="off"></div>
      </div>
      <canvas class="roll" id="roll" aria-label="The melody of this entry"></canvas>
      <div class="controls">
        <button type="button" id="play">▶ Play back the day</button>
        <button type="button" id="stop" hidden>◼ Stop</button>
        <button type="button" id="hum">♫ Hum the week</button>
        <button type="button" id="export">⬇ Export diary</button>
        <button type="button" id="import">⬆ Import</button>
        <input type="file" id="importFile" accept="application/json" hidden>
        <button type="button" id="clear">Clear this day</button>
      </div>
    </div>
    <div class="status"><span id="counts">—</span><span id="notice"></span><span id="saved">saved in this browser</span></div>
  </main>
</div>

<script is:inline src="/js/keyboard-voice.js"></script>
<script is:inline src="/keyboard.js" data-app="keyboard-diary" async></script>
<script is:inline>
(function () {
  'use strict';
  var KEY = 'pc-key-diary-v1';
  var MAX_EVENTS = 8000;
  var V = window.KeyVoice;
  var $ = function (id) { return document.getElementById(id); };
  var pad = function (n) { return String(n).padStart(2, '0'); };
  var dayKey = function (d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); };
  var parseDay = function (k) { var p = k.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); };
  var todayKey = dayKey(new Date());

  var store = { entries: {} };
  try { var raw = localStorage.getItem(KEY); if (raw) store = JSON.parse(raw) || store; } catch (e) { /* private mode */ }
  if (!store.entries || typeof store.entries !== 'object') store.entries = {};
  var prefs = store.prefs || { sound: true, share: true };

  var current = /^\d{4}-\d{2}-\d{2}$/.test(new URLSearchParams(location.search).get('day') || '') ? new URLSearchParams(location.search).get('day') : todayKey;
  if (current > todayKey) current = todayKey;
  var view = parseDay(current);
  view.setDate(1);
  var lastAt = 0;
  var prevNote = null;
  var pendingBag = [];
  var bagTimer = null;
  var playing = null;

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify({ entries: store.entries, prefs: prefs })); $('saved').textContent = 'saved in this browser'; }
    catch (e) { $('saved').textContent = 'not saved: storage is full or blocked — export a copy'; }
  }
  function entry(k) { return store.entries[k] || null; }
  function ensure(k) {
    if (!store.entries[k]) store.entries[k] = { text: '', mood: defaultMood(k), events: [], updatedAt: Date.now() };
    return store.entries[k];
  }
  function defaultMood(k) { return V.moods[parseDay(k).getDay() % V.moods.length].id; }
  function moodOf(k) { var e = entry(k); return (e && e.mood) || defaultMood(k); }

  // ---- mood chips ---------------------------------------------------------
  V.moods.forEach(function (m) {
    var b = document.createElement('button');
    b.type = 'button';
    b.dataset.mood = m.id;
    b.textContent = m.emoji + ' ' + m.label;
    b.addEventListener('click', function () {
      var e = ensure(current);
      e.mood = m.id;
      e.updatedAt = Date.now();
      save();
      paintDay();
      [0, 2, 4].forEach(function (d, i) { if (prefs.sound) V.play(V.mood(m.id).root + V.mood(m.id).chord[i % V.mood(m.id).chord.length], m.id, V.ctx().currentTime + i * 0.09); });
    });
    $('moods').appendChild(b);
  });

  // ---- calendar + list ------------------------------------------------------
  function paintCalendar() {
    var cal = $('cal');
    cal.innerHTML = '';
    ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(function (d) { var s = document.createElement('span'); s.className = 'dow'; s.textContent = d; cal.appendChild(s); });
    $('month').textContent = view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    var first = new Date(view.getFullYear(), view.getMonth(), 1);
    for (var i = 0; i < first.getDay(); i++) cal.appendChild(document.createElement('span'));
    var days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
    for (var d = 1; d <= days; d++) {
      var k = view.getFullYear() + '-' + pad(view.getMonth() + 1) + '-' + pad(d);
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = d;
      b.dataset.day = k;
      var e = entry(k);
      if (e && (e.text || e.events.length)) { b.classList.add('has'); b.style.setProperty('--c', V.mood(e.mood).color); }
      if (k === todayKey) b.classList.add('today');
      if (k === current) { b.classList.add('sel'); b.style.setProperty('--c', V.mood(moodOf(k)).color); }
      if (k > todayKey) b.disabled = true;
      b.setAttribute('aria-label', parseDay(k).toDateString() + (e && e.text ? ', has an entry' : ''));
      cal.appendChild(b);
    }
    $('next').disabled = view.getFullYear() * 12 + view.getMonth() >= new Date().getFullYear() * 12 + new Date().getMonth();
  }
  $('cal').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-day]');
    if (b && !b.disabled) open(b.dataset.day);
  });
  $('prev').addEventListener('click', function () { view.setMonth(view.getMonth() - 1); paintCalendar(); });
  $('next').addEventListener('click', function () { view.setMonth(view.getMonth() + 1); paintCalendar(); });

  function daysWithEntries() {
    return Object.keys(store.entries).filter(function (k) { var e = store.entries[k]; return e && (e.text || e.events.length); }).sort().reverse();
  }

  function spark(canvas, events, color) {
    var dpr = window.devicePixelRatio || 1;
    var w = canvas.clientWidth || 240, h = canvas.clientHeight || 18;
    canvas.width = w * dpr; canvas.height = h * dpr;
    var g = canvas.getContext('2d');
    g.scale(dpr, dpr);
    g.clearRect(0, 0, w, h);
    var notes = events.filter(function (ev) { return ev[1] >= 0; }).slice(0, 120);
    if (!notes.length) return;
    g.fillStyle = color;
    notes.forEach(function (ev, i) {
      var x = i / Math.max(1, notes.length - 1) * (w - 3);
      var y = h - 3 - (Math.max(36, Math.min(96, ev[1])) - 36) / 60 * (h - 5);
      g.fillRect(x, y, 2.5, 2.5);
    });
  }

  function paintList() {
    var list = $('list');
    list.innerHTML = '<h3>Recent days</h3>';
    var keys = daysWithEntries().slice(0, 14);
    if (!keys.length) {
      var p = document.createElement('p');
      p.className = 'privacy';
      p.textContent = 'No entries yet. Today is a good day to start.';
      list.appendChild(p);
      return;
    }
    keys.forEach(function (k) {
      var e = store.entries[k];
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'entry' + (k === current ? ' sel' : '');
      b.dataset.day = k;
      var first = (e.text || '').trim().split('\n')[0] || '(a melody without words)';
      var strong = document.createElement('strong');
      strong.textContent = first.slice(0, 60);
      var small = document.createElement('small');
      var m = V.mood(e.mood);
      small.textContent = parseDay(k).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) + ' · ' + m.emoji + ' ' + m.label;
      var c = document.createElement('canvas');
      b.appendChild(strong); b.appendChild(small); b.appendChild(c);
      list.appendChild(b);
      requestAnimationFrame(function () { spark(c, e.events || [], m.color); });
    });
  }
  $('list').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-day]');
    if (b) open(b.dataset.day);
  });

  // ---- the page -------------------------------------------------------------
  function paintDay() {
    var d = parseDay(current);
    var m = V.mood(moodOf(current));
    document.documentElement.style.setProperty('--mood', m.color);
    $('dateline').textContent = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) + ' · ' + m.label;
    $('dayname').textContent = current === todayKey ? 'Today' : d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
    Array.prototype.forEach.call($('moods').children, function (b) { b.setAttribute('aria-pressed', String(b.dataset.mood === m.id)); });
    paintCounts();
    paintRoll();
    paintCalendar();
    paintList();
  }
  function paintCounts() {
    var e = entry(current);
    var words = e && e.text.trim() ? e.text.trim().split(/\s+/).length : 0;
    var notes = e ? e.events.filter(function (x) { return x[1] >= 0; }).length : 0;
    var total = daysWithEntries().length;
    $('counts').textContent = words + ' word' + (words === 1 ? '' : 's') + ' · ' + notes.toLocaleString() + ' notes · ' + total + ' day' + (total === 1 ? '' : 's') + ' kept';
    $('play').disabled = !notes;
  }
  var rollQueued = false;
  function paintRoll(highlight) {
    if (rollQueued && highlight == null) return;
    rollQueued = true;
    requestAnimationFrame(function () {
      rollQueued = false;
      var canvas = $('roll');
      var dpr = window.devicePixelRatio || 1;
      var w = canvas.clientWidth, h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      var g = canvas.getContext('2d');
      g.scale(dpr, dpr);
      g.clearRect(0, 0, w, h);
      var e = entry(current);
      var evs = (e && e.events) || [];
      var color = V.mood(moodOf(current)).color;
      g.fillStyle = '#2b3c2e';
      for (var r = 1; r < 4; r++) g.fillRect(0, h * r / 4, w, 1);
      if (!evs.length) {
        g.fillStyle = '#6f8a73';
        g.font = '11px ui-monospace, Menlo, monospace';
        g.fillText('the melody of today will draw itself here', 14, h / 2 + 4);
        return;
      }
      // Time axis is compressed like playback: long pauses shrink.
      var t = 0, xs = [];
      evs.forEach(function (ev) { t += gap(ev[0]); xs.push(t); });
      var span = Math.max(t, 1);
      evs.forEach(function (ev, i) {
        if (ev[1] < 0) return;
        var x = 6 + xs[i] / span * (w - 14);
        var y = h - 8 - (Math.max(36, Math.min(96, ev[1])) - 36) / 60 * (h - 16);
        g.globalAlpha = highlight != null && i > highlight ? 0.25 : 0.9;
        g.fillStyle = i === highlight ? '#ffffff' : color;
        g.fillRect(x, y, i === highlight ? 5 : 3, i === highlight ? 5 : 3);
      });
      g.globalAlpha = 1;
    });
  }
  function gap(ms) { return Math.max(70, Math.min(650, ms || 0)); }

  function open(k) {
    stop();
    flushBag();
    current = k;
    var e = entry(k);
    $('body').value = e ? e.text : '';
    view = parseDay(k); view.setDate(1);
    lastAt = 0; prevNote = null;
    history.replaceState(null, '', k === todayKey ? location.pathname : '?day=' + k);
    paintDay();
    $('body').focus({ preventScroll: true });
  }

  // ---- writing makes music ------------------------------------------------------
  function record(ch) {
    var e = ensure(current);
    var now = performance.now();
    var dt = lastAt ? Math.min(1500, Math.round(now - lastAt)) : 0;
    lastAt = now;
    var midi = V.noteFor(ch, e.mood, prevNote);
    if (e.events.length < MAX_EVENTS) e.events.push([dt, midi == null ? -1 : midi]);
    if (midi != null) {
      prevNote = midi;
      if (prefs.sound) V.play(midi, e.mood);
      if (prefs.share) { pendingBag.push(midi); clearTimeout(bagTimer); bagTimer = setTimeout(flushBag, 4000); }
    }
  }
  function flushBag() {
    clearTimeout(bagTimer);
    if (!pendingBag.length || !window.PointCastKeyboard) { pendingBag = []; return; }
    // Pitch order only: the town hears which notes, never the tune or the words.
    var bag = pendingBag.splice(0, 64).sort(function (a, b) { return a - b; });
    window.PointCastKeyboard.note(bag, null, { sound: false });
    pendingBag = [];
  }
  $('body').addEventListener('input', function (ev) {
    var e = ensure(current);
    if (ev.inputType === 'insertText' && ev.data) {
      for (var i = 0; i < ev.data.length && i < 8; i++) record(ev.data[i]);
    } else if (ev.inputType === 'insertLineBreak' || ev.inputType === 'insertParagraph') {
      record('\n');
    } else if (ev.inputType === 'insertCompositionText' && ev.data) {
      record(ev.data.slice(-1));
    }
    e.text = $('body').value;
    e.updatedAt = Date.now();
    save();
    paintCounts();
    paintRoll();
  });
  var listTimer = null;
  $('body').addEventListener('input', function () { clearTimeout(listTimer); listTimer = setTimeout(function () { paintList(); paintCalendar(); }, 1200); });

  // ---- playback -------------------------------------------------------------
  function stop() {
    if (!playing) return;
    playing.timers.forEach(clearTimeout);
    playing = null;
    $('reading').hidden = true;
    $('body').hidden = false;
    $('stop').hidden = true;
    $('play').hidden = false;
    document.querySelectorAll('.cal button.humming').forEach(function (b) { b.classList.remove('humming'); });
    paintRoll();
  }
  function playDay(k, opts) {
    var e = entry(k);
    if (!e || !e.events.length) return 0;
    opts = opts || {};
    var mood = e.mood;
    var text = e.text || '';
    var evs = opts.limit ? e.events.filter(function (x) { return x[1] >= 0; }).slice(0, opts.limit).map(function (x) { return [150, x[1]]; }) : e.events;
    var c = V.ctx();
    var t = 0;
    var reading = $('reading');
    var showText = !opts.limit;
    if (showText) { reading.hidden = false; $('body').hidden = true; }
    evs.forEach(function (ev, i) {
      t += i === 0 ? 0 : gap(ev[0]);
      var at = (opts.offset || 0) + t;
      playing.timers.push(setTimeout(function () {
        if (ev[1] >= 0) V.play(ev[1], mood, c.currentTime);
        if (showText) {
          var upto = Math.round((i + 1) / evs.length * text.length);
          reading.innerHTML = '';
          var b = document.createElement('b'); b.textContent = text.slice(0, Math.max(0, upto - 1));
          var cur = document.createElement('i'); cur.textContent = text.slice(Math.max(0, upto - 1), upto);
          reading.appendChild(b); reading.appendChild(cur); reading.appendChild(document.createTextNode(text.slice(upto)));
          var mark = cur.offsetTop - reading.clientHeight / 2;
          if (mark > 0) reading.scrollTop = mark;
          paintRoll(i);
        }
      }, at));
    });
    return (opts.offset || 0) + t + 900;
  }
  $('play').addEventListener('click', function () {
    stop();
    flushBag();
    playing = { timers: [] };
    $('play').hidden = true;
    $('stop').hidden = false;
    var end = playDay(current);
    playing.timers.push(setTimeout(stop, end));
  });
  $('stop').addEventListener('click', stop);
  $('hum').addEventListener('click', function () {
    stop();
    var week = daysWithEntries().filter(function (k) { return (parseDay(todayKey) - parseDay(k)) / 86400000 < 7; }).sort();
    if (!week.length) { $('notice').textContent = 'Nothing to hum yet: write a line first.'; return; }
    playing = { timers: [] };
    $('play').hidden = true;
    $('stop').hidden = false;
    var offset = 0;
    week.forEach(function (k) {
      var start = offset;
      playing.timers.push(setTimeout(function () {
        document.querySelectorAll('.cal button.humming').forEach(function (b) { b.classList.remove('humming'); });
        var b = document.querySelector('.cal button[data-day="' + k + '"]');
        if (b) { b.classList.add('humming'); b.style.setProperty('--c', V.mood(moodOf(k)).color); }
      }, start));
      offset = playDay(k, { limit: 16, offset: start }) + 250;
    });
    playing.timers.push(setTimeout(stop, offset));
    $('notice').textContent = 'Humming ' + week.length + ' day' + (week.length === 1 ? '' : 's') + '…';
    setTimeout(function () { $('notice').textContent = ''; }, 4000);
  });

  // ---- keep a copy ------------------------------------------------------------
  $('export').addEventListener('click', function () {
    var blob = new Blob([JSON.stringify({ app: 'pointcast-key-diary', version: 1, exportedAt: new Date().toISOString(), entries: store.entries }, null, 1)], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'key-diary-' + todayKey + '.json';
    a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
  });
  $('import').addEventListener('click', function () { $('importFile').click(); });
  $('importFile').addEventListener('change', function (ev) {
    var file = ev.target.files && ev.target.files[0];
    if (!file) return;
    file.text().then(function (txt) {
      var data = JSON.parse(txt);
      if (!data || typeof data.entries !== 'object') throw new Error('not a Key Diary export');
      var added = 0;
      Object.keys(data.entries).forEach(function (k) {
        var e = data.entries[k];
        if (!/^\d{4}-\d{2}-\d{2}$/.test(k) || !e || typeof e.text !== 'string') return;
        var mine = store.entries[k];
        if (mine && mine.updatedAt >= (e.updatedAt || 0)) return;
        store.entries[k] = { text: e.text.slice(0, 100000), mood: V.mood(e.mood).id, events: Array.isArray(e.events) ? e.events.slice(0, MAX_EVENTS) : [], updatedAt: e.updatedAt || Date.now() };
        added++;
      });
      save();
      open(current);
      $('notice').textContent = 'Imported ' + added + ' day' + (added === 1 ? '' : 's') + '.';
    }).catch(function (err) { $('notice').textContent = 'Could not import: ' + err.message; });
    ev.target.value = '';
  });
  $('clear').addEventListener('click', function () {
    if (!entry(current)) return;
    if (!confirm('Clear the words and melody for this day? This cannot be undone (export first to keep a copy).')) return;
    delete store.entries[current];
    save();
    open(current);
  });

  // ---- toggles ------------------------------------------------------------------
  function paintToggles() {
    $('sound').setAttribute('aria-pressed', String(prefs.sound));
    $('sound').textContent = prefs.sound ? '♪ Sound on' : '♪ Sound off';
    $('share').setAttribute('aria-pressed', String(prefs.share));
    $('share').textContent = prefs.share ? '✳ Town chord on' : '✳ Town chord off';
  }
  $('sound').addEventListener('click', function () { prefs.sound = !prefs.sound; paintToggles(); save(); });
  $('share').addEventListener('click', function () { prefs.share = !prefs.share; if (!prefs.share) pendingBag = []; paintToggles(); save(); });
  function leave() { flushBag(); if (window.PointCastKeyboard) window.PointCastKeyboard.flush(); }
  addEventListener('pagehide', leave);
  document.addEventListener('visibilitychange', function () { if (document.hidden) leave(); });
  addEventListener('resize', function () { paintRoll(); });

  paintToggles();
  open(current);
})();
</script>
</body>
</html>
