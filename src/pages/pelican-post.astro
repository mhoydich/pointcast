---
/** /pelican-post — Door 6 of the Ten Doors (2026-11-02). Write what you carry; a pelican lets it go past the breakwater. Nothing is stored or sent. */
import TenDoorsFrame from '../components/TenDoorsFrame.astro';
---

<TenDoorsFrame slug="pelican-post">
  <canvas class="td-canvas" id="pp-bay" width="720" height="400" aria-hidden="true"></canvas>
  <form class="pp-card" id="pp-form" autocomplete="off">
    <label for="pp-text">Postcard to nobody</label>
    <textarea id="pp-text" maxlength="140" rows="3" placeholder="The thing I keep carrying is..."></textarea>
    <div class="pp-foot"><span id="pp-count">140 left</span><button class="td-btn" type="submit">Send it out</button></div>
    <p class="pp-promise">These words never leave this page. They are not saved, not sent, not read by anyone. When the pelican lets go, they are gone.</p>
  </form>
  <p class="td-readout" id="pp-read" aria-live="polite"></p>
</TenDoorsFrame>

<style>
  .pp-card { max-width: 30rem; margin: 1rem auto 0; background: #fffaf0; color: #3a2f25; border-radius: 6px; padding: 1rem 1.1rem; box-shadow: 0 8px 18px rgb(0 0 0 / 0.12); border: 1px dashed #c8b79b; }
  .pp-card label { display: block; font: 600 0.8rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  .pp-card textarea { width: 100%; box-sizing: border-box; font: 1.15rem/1.4 Georgia, 'Times New Roman', serif; border: 0; background: repeating-linear-gradient(#fffaf0 0 1.55rem, #e8dcc6 1.55rem 1.6rem); color: #3a2f25; resize: none; }
  .pp-card textarea:focus { outline: 2px solid #c8b79b; }
  .pp-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; font: 0.8rem ui-monospace, monospace; }
  .pp-promise { font-size: 0.8rem; line-height: 1.45; margin: 0.6rem 0 0; opacity: 0.75; }
  .pp-card.is-gone { animation: pp-lift 1.2s ease-in both; }
  @keyframes pp-lift { to { transform: translateY(-60px) rotate(-6deg); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pp-card.is-gone { animation: none; } }
</style>

<script>
  import { fitCanvas, tone, noise, load, save, audio } from '../lib/ten-doors/audio.mjs';

  const W = 720, H = 400;
  const canvas = document.getElementById('pp-bay');
  const g = fitCanvas(canvas, W, H);
  const form = document.getElementById('pp-form');
  const text = document.getElementById('pp-text');
  const count = document.getElementById('pp-count');
  const read = document.getElementById('pp-read');
  let letGo = load('pelican-post:count', 0); // only a number is kept, never the words
  let bird = null;
  const sayCount = () => { read.textContent = letGo ? `You have let ${letGo} ${letGo === 1 ? 'card' : 'cards'} go from this browser.` : 'Nothing sent yet. Take your time.'; };
  sayCount();
  text.addEventListener('input', () => { count.textContent = `${140 - text.value.length} left`; });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!text.value.trim() || bird) return;
    audio();
    form.classList.add('is-gone');
    bird = { x: 120, y: H - 70, t: 0, carrying: true, dropX: 470 + Math.random() * 80 };
    noise({ length: 0.25, gain: 0.08, freq: 900 });
  });

  function finish() {
    text.value = ''; count.textContent = '140 left';
    letGo += 1; save('pelican-post:count', letGo);
    [72, 76, 79].forEach((m, i) => tone(440 * 2 ** ((m - 69) / 12), { type: 'sine', length: 0.4, release: 1.4, gain: 0.07, when: i * 0.35 }));
    setTimeout(() => { form.classList.remove('is-gone'); sayCount(); }, 1600);
  }

  let card = null;
  function draw(ts) {
    const sky = g.createLinearGradient(0, 0, 0, H);
    sky.addColorStop(0, '#f8d9b0'); sky.addColorStop(1, '#f4e9d8');
    g.fillStyle = sky; g.fillRect(0, 0, W, H);
    g.fillStyle = '#f6c47a'; g.beginPath(); g.arc(560, 120, 34, 0, Math.PI * 2); g.fill();
    g.fillStyle = '#7fa8b8'; g.fillRect(0, 200, W, H - 200);
    for (let i = 0; i < 18; i += 1) { g.fillStyle = 'rgba(255,255,255,0.5)'; g.fillRect((i * 53 + ts / 40) % W, 215 + (i % 6) * 22, 22, 2); }
    // breakwater
    g.fillStyle = '#5c5550'; for (let x = 420; x < 680; x += 26) { g.beginPath(); g.ellipse(x, 214, 16, 9, 0, 0, Math.PI * 2); g.fill(); }
    g.fillStyle = '#ead7b3'; g.beginPath(); g.moveTo(0, H); g.lineTo(0, 300); g.quadraticCurveTo(200, 280, 300, H); g.fill();
    if (bird) {
      bird.t += 1;
      bird.x += 2.2; bird.y = H - 70 - Math.min(180, bird.t * 1.6) + Math.sin(bird.t / 9) * 4;
      if (bird.carrying && bird.x > bird.dropX) { bird.carrying = false; card = { x: bird.x, y: bird.y + 14, vy: 0, a: 1 }; tone(660, { length: 0.05, release: 0.4, gain: 0.05 }); }
      const flap = Math.sin(bird.t / 5) * 10;
      g.strokeStyle = '#3a2f25'; g.lineWidth = 3; g.lineCap = 'round';
      g.beginPath(); g.moveTo(bird.x - 22, bird.y - flap); g.quadraticCurveTo(bird.x - 8, bird.y - 4, bird.x, bird.y); g.quadraticCurveTo(bird.x + 8, bird.y - 4, bird.x + 22, bird.y - flap); g.stroke();
      g.fillStyle = '#c99a4e'; g.beginPath(); g.moveTo(bird.x + 2, bird.y); g.lineTo(bird.x + 18, bird.y + 4); g.lineTo(bird.x + 2, bird.y + 5); g.fill();
      if (bird.carrying) { g.fillStyle = '#fffaf0'; g.fillRect(bird.x - 6, bird.y + 6, 14, 9); }
      if (bird.x > W + 40) { bird = null; finish(); }
    }
    if (card) {
      card.vy += 0.05; card.y += card.vy; card.x += 0.4; card.a -= 0.008;
      g.globalAlpha = Math.max(0, card.a); g.fillStyle = '#fffaf0'; g.fillRect(card.x, card.y, 14, 9); g.globalAlpha = 1;
      if (card.y > 230 || card.a <= 0) { noise({ length: 0.2, gain: 0.05, freq: 1200 }); card = null; }
    }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
</script>
