---
/** /pelican-post — a private, unhurried letting-go ritual. */
import TenDoorsFrame from '../components/TenDoorsFrame.astro';
---

<TenDoorsFrame slug="pelican-post" quiet>
  <div class="pp" data-pelican-post data-state="composing">
    <div class="pp-scene">
      <canvas id="pp-bay" width="720" height="320" aria-hidden="true"></canvas>
      <span class="pp-scene-note" aria-hidden="true">The bay has room.</span>
    </div>
    <div class="pp-tools">
      <span>A quiet moment by the water</span>
      <button id="pp-sound" type="button" aria-pressed="false" disabled>Sound off</button>
    </div>

    <form class="pp-card" id="pp-form" autocomplete="off">
      <label for="pp-text">Postcard to nobody</label>
      <p class="pp-hint">One small thing you’re ready to put down.</p>
      <textarea id="pp-text" maxlength="140" rows="3" placeholder="The thing I keep carrying is…" aria-describedby="pp-count pp-privacy" spellcheck="false" autocapitalize="sentences"></textarea>
      <div class="pp-foot">
        <span id="pp-count">140 characters left</span>
        <button class="pp-action" id="pp-send" type="submit" disabled>Let it go <span aria-hidden="true">↗</span></button>
      </div>
    </form>

    <div class="pp-message" id="pp-journey" hidden>
      <p class="pp-stamp">Out past the breakwater</p>
      <h2>Let the pelican take it.</h2>
      <p>Your words are already cleared. Watch the flight, or skip ahead.</p>
      <button class="pp-action" id="pp-skip" type="button">Skip flight</button>
    </div>

    <div class="pp-message" id="pp-complete" hidden>
      <p class="pp-stamp">No reply needed</p>
      <h2>A little more room.</h2>
      <p>The card is gone. Stay by the water as long as you like.</p>
      <div class="pp-finish-actions">
        <button class="pp-action" id="pp-again" type="button">Write another</button>
        <a href="/ten-doors">Back to Ten Doors <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <p class="pp-status" id="pp-status" role="status" aria-atomic="true">Take your time.</p>
    <p class="pp-privacy" id="pp-privacy">Your words are cleared when you let go or leave this page. They are never saved or sent. Only a count of released cards is kept in this browser.</p>
    <p class="pp-total" id="pp-total"></p>
    <noscript><p class="pp-privacy">This little ritual needs JavaScript. Nothing you type will be submitted.</p></noscript>
  </div>
</TenDoorsFrame>

<style>
  .pp { max-width: 720px; margin-inline: auto; }
  .pp [hidden] { display: none !important; }
  .pp-scene { position: relative; overflow: hidden; border-radius: 14px; background: linear-gradient(#f8d9b0 58%, #7fa8b8 58%); }
  #pp-bay { display: block; width: 100%; height: auto; touch-action: pan-y; }
  .pp-scene-note { position: absolute; top: 1rem; left: 1.2rem; font: italic clamp(1rem, 3vw, 1.4rem)/1.3 Georgia, serif; color: #584639; }
  .pp-tools { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-block: 0.35rem; font: 0.7rem/1.4 ui-monospace, monospace; }
  .pp-tools button { flex-shrink: 0; padding: 0.5rem 0.6rem; min-height: 44px; border: 1px solid #8b7862; border-radius: 999px; background: transparent; color: #3a2f25; cursor: pointer; font: inherit; }
  .pp-tools button[aria-pressed='true'] { background: #3a2f25; color: #fffaf0; }
  .pp-card, .pp-message { box-sizing: border-box; width: 100%; max-width: 32rem; margin: 0.5rem auto 0; padding: clamp(1rem, 3vw, 1.5rem); background: #fffaf0; color: #3a2f25; border: 1px dashed #a69478; border-radius: 6px; box-shadow: 0 8px 18px rgb(0 0 0 / 0.08); }
  .pp-card label, .pp-stamp { display: block; font: 600 0.75rem/1.4 ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }
  .pp-hint { margin: 0.4rem 0 0.8rem; font-size: 0.9rem; line-height: 1.5; }
  .pp-card textarea { width: 100%; box-sizing: border-box; min-height: 6.5rem; font: 1.15rem/1.6 Georgia, serif; border: 1px solid #c8b79b; border-radius: 3px; padding: 0.5rem; background: #fffdf8; color: #3a2f25; resize: vertical; }
  .pp-card textarea::placeholder { color: #746452; opacity: 1; }
  .pp-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.6rem; margin-top: 0.65rem; font: 0.72rem/1.5 ui-monospace, monospace; }
  .pp-action { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 48px; padding: 0.65rem 1rem; border: 2px solid #3a2f25; border-radius: 999px; background: #3a2f25; color: #fffaf0; font: 600 0.85rem/1.3 ui-monospace, monospace; cursor: pointer; touch-action: manipulation; }
  .pp-action:disabled { color: #6e6051; background: #e9dfcf; border-color: #a69478; cursor: default; }
  .pp :is(button, a, textarea):focus-visible { outline: 3px solid #744315; outline-offset: 4px; }
  .pp-message h2 { font: 400 clamp(1.8rem, 5vw, 2.5rem)/1.1 Georgia, serif; letter-spacing: -0.03em; margin: 0.65rem 0; }
  .pp-message p:not(.pp-stamp) { font-size: 1rem; line-height: 1.5; margin: 0 0 1rem; }
  .pp-finish-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .pp-finish-actions a { display: inline-flex; align-items: center; min-height: 48px; color: #3a2f25; font-size: 0.85rem; text-underline-offset: 4px; }
  .pp-status { min-height: 1.5em; text-align: center; font: 600 0.85rem/1.5 ui-monospace, monospace; margin: 1rem 0 0.5rem; }
  .pp-privacy, .pp-total { max-width: 32rem; margin: 0.5rem auto 0; text-align: center; font-size: 0.8rem; line-height: 1.5; color: #635341; }
  .pp-total { font-size: 0.75rem; }
  @media (max-width: 380px) { .pp-tools > span { max-width: 10rem; } .pp-foot { align-items: flex-start; } }
</style>

<script>
  import { mountPelicanPost } from '../lib/ten-doors/pelican-post.mjs';
  let cleanup;
  function mount() {
    cleanup?.();
    const root = document.querySelector('[data-pelican-post]');
    cleanup = root ? mountPelicanPost(root) : undefined;
  }
  function unmount() { cleanup?.(); cleanup = undefined; }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  window.addEventListener('pagehide', unmount);
  window.addEventListener('pageshow', (event) => { if (event.persisted) mount(); });
</script>
