---
import BlockLayout from '../../layouts/BlockLayout.astro';
---
<BlockLayout title="Report a public page — PointCast" description="Tell PointCast about a public profile or collection that needs review." noindex hideAds>
  <main class="me-report"><a href="/me">← Me</a><h1>Report a public page.</h1><p>Your report is private to the PointCast review team. Please describe the issue without including sensitive personal details.</p><form data-me-report><label>What should we review?<textarea name="reason" required maxlength="500" rows="5"></textarea></label><button type="submit">Send report</button></form><p role="status" data-report-status></p></main>
</BlockLayout>
<style>.me-report{max-width:640px;margin:48px auto;padding:24px}.me-report h1{font-size:36px}.me-report p{line-height:1.6}.me-report textarea{display:block;width:100%;margin:12px 0;padding:12px;font:inherit}.me-report button{padding:12px 20px;font:inherit}</style>
<script>
function mount(){const form=document.querySelector<HTMLFormElement>('[data-me-report]');if(!form||form.dataset.bound)return;form.dataset.bound='1';const status=document.querySelector<HTMLElement>('[data-report-status]')!;const params=new URLSearchParams(location.search);form.addEventListener('submit',async(event)=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;status.textContent='Sending…';try{const response=await fetch('/api/me/report',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:params.get('type'),id:params.get('id'),reason:new FormData(form).get('reason')})});const data=await response.json();if(response.status===401){status.textContent='Please sign in to send a report. Copy your draft before leaving this page.';const link=document.createElement('a');link.href=`/auth?returnTo=${encodeURIComponent(location.pathname+location.search)}`;link.textContent=' Sign in';status.append(link);}else if(!response.ok||!data.ok)status.textContent=data.error||'Could not send. Please try again.';else{status.textContent='Thank you. Your report is saved for review.';form.reset();}}catch{status.textContent='Could not send. Your draft is still here; please try again.';}finally{button.disabled=false;}});}
mount();document.addEventListener('astro:page-load',mount);
</script>
