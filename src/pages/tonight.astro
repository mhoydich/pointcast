---
import BlockLayout from '../layouts/BlockLayout.astro';
import guide from '../data/pointcast-tonight.json';

const toIsoLocal = (date: string, time: string) => {
  const match = time.match(/^(\d{1,2}):(\d{2}) (AM|PM)$/);
  if (!match) return date;
  const [, rawHour, minute, meridiem] = match;
  let hour = Number(rawHour) % 12;
  if (meridiem === 'PM') hour += 12;
  return `${date}T${String(hour).padStart(2, '0')}:${minute}:00-07:00`;
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: guide.title,
  description: guide.dek,
  datePublished: guide.publishedDate,
  url: 'https://pointcast.xyz/tonight',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  hasPart: guide.goOut.map((event) => ({
    '@type': 'Event',
    name: event.title,
    startDate: toIsoLocal(event.date, event.time),
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: event.venue, address: event.city },
    url: event.url,
  })),
};

const bestBet = guide.goOut.find((event) => event.id === guide.bestBet.eventId);
const sourceById = new Map(guide.sources.map((source) => [source.id, source]));
---

<BlockLayout
  title="PointCast Tonight · GO OUT / STAY IN"
  description={guide.dek}
  image="/images/pointcast-tonight/social-card.png"
  themeColor="#ffd84a"
  immersive
  showNetworkStrip={false}
  alternates={[{ type: 'application/json', href: '/tonight.json', title: 'PointCast Tonight — structured edition' }]}
  jsonLd={jsonLd}
>
  <div class="tonight" data-tonight-root>
    <header class="masthead">
      <a class="masthead__brand" href="/" aria-label="PointCast home">POINT<span>CAST</span></a>
      <div class="masthead__edition">
        <span>TONIGHT · EDITION {guide.edition}</span>
        <span>EL SEGUNDO · {guide.publishedDate}</span>
      </div>
      <a class="masthead__json" href="/tonight.json">JSON ↗</a>
    </header>

    <section class="hero" aria-labelledby="tonight-title">
      <div class="hero__copy">
        <p class="eyebrow">BLOCK 0559 · A HUMAN-SIZED ENTERTAINMENT SCRAPER</p>
        <h1 id="tonight-title">WHAT ARE<br />WE DOING<br /><em>TONIGHT?</em></h1>
        <p class="hero__dek">One week. Two channels. Official sources. The radius is approximate; the invitation is real.</p>
      </div>

      <div class="hero__dial" aria-hidden="true">
        <div class="hero__antenna"></div>
        <div class="hero__screen">
          <span>CH</span>
          <strong>02/04</strong>
          <small>GO OUT<br />STAY IN</small>
        </div>
        <div class="hero__knob"><i></i></div>
        <div class="hero__speaker"></div>
      </div>
    </section>

    <nav class="channel-switcher" aria-label="Choose a PointCast Tonight channel">
      <button class="channel channel--out is-active" type="button" data-channel-button="out" aria-pressed="true">
        <span>02</span>
        <strong>GO OUT</strong>
        <small>{guide.goOut.length} official-source possibilities</small>
      </button>
      <button class="channel channel--in" type="button" data-channel-button="in" aria-pressed="false">
        <span>04</span>
        <strong>STAY IN</strong>
        <small>{guide.stayIn.length} scheduled signals + {guide.stations.length} stations</small>
      </button>
      <button class="channel channel--all" type="button" data-channel-button="all" aria-pressed="false">
        <span>00</span>
        <strong>ALL SIGNALS</strong>
        <small>Put the whole week on one dial</small>
      </button>
    </nav>

    <div class="live-line" role="status" aria-live="polite">
      <span class="live-line__dot"></span>
      <span data-channel-status>CH 02 · GO OUT · {guide.goOut.length} SIGNALS</span>
      <span>CHECK THE OFFICIAL LINK BEFORE YOU GO</span>
    </div>

    <main class="guide">
      <section class="guide-panel guide-panel--out" data-channel-panel="out" aria-labelledby="go-out-title">
        <div class="section-heading">
          <div>
            <p>CH 02 · THE FRONT DOOR</p>
            <h2 id="go-out-title">GO <em>OUT</em></h2>
          </div>
          <p>Six reasons to leave the couch, arranged like a broadcast week instead of a recommendation engine.</p>
        </div>

        {bestBet && (
          <article class="best-bet">
            <div class="best-bet__stamp">BEST<br />BET</div>
            <div>
              <p>{bestBet.day} · {bestBet.time} · {bestBet.cost}</p>
              <h3>{bestBet.title}</h3>
              <span>{guide.bestBet.why}</span>
            </div>
            <a href={bestBet.url} target="_blank" rel="noopener">OFFICIAL SOURCE ↗</a>
          </article>
        )}

        <div class="event-grid">
          {guide.goOut.map((event, index) => (
            <article class:list={['event-card', index === 0 && 'event-card--first']} id={event.id}>
              <div class="event-card__time">
                <span>{event.day}</span>
                <strong>{event.time}</strong>
                {event.endTime && <small>→ {event.endTime}</small>}
              </div>
              <div class="event-card__body">
                <div class="event-card__meta">
                  <span>{event.distanceBand}</span>
                  <span>{event.cost}</span>
                  <span>{event.status}</span>
                </div>
                <h3>{event.title}</h3>
                <p class="event-card__venue">{event.venue} · {event.city}</p>
                <p>{event.signal}</p>
                <a href={event.url} target="_blank" rel="noopener">
                  CHECK {sourceById.get(event.sourceId)?.publisher ?? 'OFFICIAL SOURCE'} ↗
                </a>
              </div>
              <span class="event-card__number">{String(index + 1).padStart(2, '0')}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="guide-panel guide-panel--in" data-channel-panel="in" aria-labelledby="stay-in-title" hidden>
        <div class="section-heading section-heading--in">
          <div>
            <p>CH 04 · THE CIVIC DIAL</p>
            <h2 id="stay-in-title">STAY <em>IN</em></h2>
          </div>
          <p>Municipal television as local theater: meetings, empty slots, live feeds, and the strange comfort of a channel that belongs to a place.</p>
        </div>

        <div class="tv-grid">
          {guide.stayIn.map((program, index) => (
            <article class:list={['tv-card', program.status === 'canceled' && 'tv-card--canceled']} id={program.id}>
              <div class="tv-card__screen">
                <div class="tv-card__scan"></div>
                <span>{program.status === 'canceled' ? 'OFF AIR' : `LIVE ${program.day}`}</span>
                <strong>{program.time}</strong>
                <small>{program.station}</small>
              </div>
              <div class="tv-card__copy">
                <p>PROGRAM {String(index + 1).padStart(2, '0')} · {program.status}</p>
                <h3>{program.title}</h3>
                <b>{program.channels}</b>
                <span>{program.signal}</span>
                <div>
                  <a href={program.url} target="_blank" rel="noopener">SOURCE ↗</a>
                  <a href={program.watchUrl} target="_blank" rel="noopener">STATION ↗</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="station-strip">
          {guide.stations.map((station) => (
            <a href={station.url} target="_blank" rel="noopener">
              <span>KEEP TUNING</span>
              <strong>{station.name}</strong>
              <small>{station.channels}</small>
              <p>{station.note}</p>
              <b>OPEN STATION ↗</b>
            </a>
          ))}
        </div>
      </section>
    </main>

    <section class="method" aria-labelledby="method-title">
      <div class="method__intro">
        <p>THE SMALL PRINT IS THE PRODUCT</p>
        <h2 id="method-title">WHO GETS<br />TO SCRAPE<br />THE NIGHT?</h2>
        <p>{guide.methodology.refreshPolicy}</p>
        <code>npm run tonight:refresh</code>
      </div>

      <div class="source-ledger">
        <div class="source-ledger__head">
          <span>SOURCE</span><span>ACCESS</span><span>ROBOTS / BOUNDARY</span>
        </div>
        {guide.sources.map((source) => (
          <a href={source.url} target="_blank" rel="noopener">
            <span><strong>{source.label}</strong><small>{source.publisher}</small></span>
            <b class:list={[source.automation === 'allowed' ? 'is-allowed' : 'is-manual']}>{source.automation}</b>
            <span>{source.robots}</span>
          </a>
        ))}
      </div>
    </section>

    <aside class="boundary">
      <div><span>25</span><small>MILES<br />ROUGHLY</small></div>
      <p><strong>THE RING IS A LENS, NOT A PROMISE.</strong> {guide.radius.boundary} {guide.methodology.accuracyBoundary}</p>
    </aside>

    <footer class="footer">
      <div>
        <strong>POINTCAST TONIGHT</strong>
        <span>Official-source entertainment field guide · Edition {guide.edition} · Block 0559</span>
      </div>
      <p>{guide.methodology.relationship}</p>
      <nav aria-label="PointCast Tonight links">
        <a href="/b/0559">BLOCK</a>
        <a href="/tonight.json">JSON</a>
        <a href="/firecrawl">SCRAPING FIELD GUIDE</a>
        <a href="/">POINTCAST</a>
      </nav>
    </footer>
  </div>

  <script>
    const root = document.querySelector('[data-tonight-root]');
    const buttons = [...document.querySelectorAll('[data-channel-button]')];
    const panels = [...document.querySelectorAll('[data-channel-panel]')];
    const status = document.querySelector('[data-channel-status]');
    const labels = {
      out: 'CH 02 · GO OUT · 6 SIGNALS',
      in: 'CH 04 · STAY IN · 3 PROGRAMS + 2 STATIONS',
      all: 'CH 00 · ALL SIGNALS · THE WHOLE WEEK',
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const channel = button.getAttribute('data-channel-button') || 'out';
        buttons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((panel) => {
          const visible = channel === 'all' || panel.getAttribute('data-channel-panel') === channel;
          panel.toggleAttribute('hidden', !visible);
        });
        root?.setAttribute('data-channel', channel);
        if (status) status.textContent = labels[channel as keyof typeof labels] || labels.out;
      });
    });
  </script>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #f2eddf; color: #11100d; }
  :global(*) { box-sizing: border-box; }
  :global([hidden]) { display: none !important; }
  .tonight { --ink: #11100d; --paper: #f2eddf; --yellow: #ffd84a; --blue: #3755f5; --red: #ff4c31; min-height: 100vh; overflow: hidden; background: var(--paper); font-family: "Inter Variable", Arial, sans-serif; }
  .masthead { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 72px; padding: 12px clamp(16px, 3vw, 48px); border-bottom: 3px solid var(--ink); background: var(--paper); font-family: "JetBrains Mono Variable", monospace; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .masthead a { color: inherit; text-decoration: none; }
  .masthead__brand { font-family: "Arial Narrow", "Inter Variable", sans-serif; font-size: clamp(26px, 3vw, 44px); font-weight: 950; letter-spacing: -.08em; line-height: 1; }
  .masthead__brand span { color: var(--blue); }
  .masthead__edition { display: flex; gap: 24px; text-align: center; }
  .masthead__json { justify-self: end; border-bottom: 2px solid; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(390px, .75fr); min-height: 610px; border-bottom: 3px solid var(--ink); background: var(--yellow); }
  .hero__copy { display: flex; flex-direction: column; padding: clamp(28px, 5vw, 80px); border-right: 3px solid var(--ink); background: radial-gradient(circle at 14px 14px, rgba(17,16,13,.15) 1.4px, transparent 1.5px) 0 0 / 28px 28px, var(--yellow); }
  .eyebrow, .section-heading > div > p, .method__intro > p:first-child { margin: 0; font-family: "JetBrains Mono Variable", monospace; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 900px; margin: auto 0 24px; font-family: "Arial Narrow", "Inter Variable", sans-serif; font-size: clamp(70px, 10vw, 156px); font-stretch: condensed; font-weight: 950; letter-spacing: -.085em; line-height: .72; text-transform: uppercase; }
  h1 em { color: var(--blue); font-family: Georgia, serif; font-size: .82em; font-weight: 600; }
  .hero__dek { max-width: 700px; margin: 0; font-size: clamp(18px, 2vw, 28px); font-weight: 650; letter-spacing: -.025em; line-height: 1.15; }
  .hero__dial { position: relative; display: grid; min-height: 610px; place-items: center; overflow: hidden; background: var(--blue); }
  .hero__screen { position: relative; display: flex; width: min(76%, 460px); aspect-ratio: 1.1; flex-direction: column; justify-content: space-between; padding: 34px; border: 8px solid var(--ink); border-radius: 44% 52% 48% 42% / 44% 45% 51% 49%; background: repeating-linear-gradient(0deg, rgba(255,255,255,.08) 0 2px, transparent 2px 6px), #11100d; box-shadow: 22px 26px 0 rgba(17,16,13,.25); color: var(--paper); transform: rotate(-3deg); }
  .hero__screen::after { position: absolute; inset: 11%; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; content: ''; }
  .hero__screen span, .hero__screen small { z-index: 1; font-family: "JetBrains Mono Variable", monospace; font-weight: 900; letter-spacing: .15em; }
  .hero__screen strong { z-index: 1; font-family: "Arial Narrow", "Inter Variable", sans-serif; font-size: clamp(66px, 8vw, 120px); letter-spacing: -.1em; line-height: .8; }
  .hero__screen small { align-self: flex-end; text-align: right; }
  .hero__antenna { position: absolute; top: 9%; width: 240px; height: 120px; border-left: 5px solid var(--ink); border-right: 5px solid var(--ink); transform: rotate(28deg) skewX(-26deg); }
  .hero__knob { position: absolute; right: 8%; bottom: 12%; width: 72px; aspect-ratio: 1; border: 5px solid var(--ink); border-radius: 50%; background: var(--yellow); }
  .hero__knob i { position: absolute; left: 50%; width: 4px; height: 28px; background: var(--ink); transform: translateX(-50%) rotate(35deg); transform-origin: 50% 36px; }
  .hero__speaker { position: absolute; left: 7%; bottom: 8%; width: 78px; height: 48px; background: radial-gradient(circle, var(--ink) 2px, transparent 3px) 0 0 / 11px 11px; transform: rotate(8deg); }
  .channel-switcher { display: grid; grid-template-columns: 1fr 1fr .55fr; border-bottom: 3px solid var(--ink); }
  .channel { display: grid; grid-template-columns: auto 1fr; gap: 0 18px; min-height: 160px; padding: 22px clamp(18px, 3vw, 46px); border: 0; border-right: 3px solid var(--ink); color: var(--ink); cursor: pointer; text-align: left; }
  .channel:last-child { border-right: 0; }
  .channel span { grid-row: span 2; font-family: "JetBrains Mono Variable", monospace; font-size: 14px; font-weight: 900; }
  .channel strong { align-self: end; font-family: "Arial Narrow", "Inter Variable", sans-serif; font-size: clamp(38px, 5.6vw, 84px); font-weight: 950; letter-spacing: -.075em; line-height: .8; }
  .channel small { align-self: start; margin-top: 10px; font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .channel--out { background: var(--yellow); }
  .channel--in { background: var(--blue); color: white; }
  .channel--all { background: var(--paper); }
  .channel.is-active { box-shadow: inset 0 -13px 0 var(--red); }
  .channel:focus-visible { outline: 5px solid var(--red); outline-offset: -5px; }
  .live-line { display: flex; justify-content: space-between; gap: 24px; padding: 11px clamp(16px, 3vw, 48px); border-bottom: 3px solid var(--ink); background: var(--ink); color: white; font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .live-line__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 4px rgba(255,76,49,.25); animation: pulse 1.8s infinite; }
  .guide-panel { border-bottom: 3px solid var(--ink); }
  .section-heading { display: grid; grid-template-columns: 1fr 1fr; min-height: 260px; border-bottom: 3px solid var(--ink); }
  .section-heading > div { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(28px, 4vw, 62px); border-right: 3px solid var(--ink); background: var(--yellow); }
  .section-heading h2 { margin: 36px 0 0; font-family: "Arial Narrow", "Inter Variable", sans-serif; font-size: clamp(70px, 10vw, 150px); font-weight: 950; letter-spacing: -.09em; line-height: .7; }
  .section-heading h2 em { color: var(--blue); font-family: Georgia, serif; font-weight: 600; }
  .section-heading > p { display: flex; align-items: flex-end; margin: 0; padding: clamp(28px, 4vw, 62px); font-family: Georgia, serif; font-size: clamp(23px, 3vw, 42px); font-style: italic; line-height: 1.05; }
  .section-heading--in > div { background: var(--blue); color: white; }
  .section-heading--in h2 em { color: var(--yellow); }
  .best-bet { display: grid; grid-template-columns: 120px 1fr auto; gap: clamp(18px, 3vw, 50px); align-items: center; padding: clamp(24px, 3vw, 44px); border-bottom: 3px solid var(--ink); background: var(--red); color: white; }
  .best-bet__stamp { display: grid; width: 90px; aspect-ratio: 1; place-items: center; border: 3px solid white; border-radius: 50%; font-family: "JetBrains Mono Variable", monospace; font-weight: 900; text-align: center; transform: rotate(-8deg); }
  .best-bet p { margin: 0 0 6px; font-family: "JetBrains Mono Variable", monospace; font-size: 10px; font-weight: 800; letter-spacing: .1em; }
  .best-bet h3 { margin: 0 0 6px; font-size: clamp(28px, 4vw, 55px); letter-spacing: -.05em; line-height: .9; }
  .best-bet a { padding: 12px; border: 2px solid white; color: white; font-family: "JetBrains Mono Variable", monospace; font-size: 10px; font-weight: 900; text-decoration: none; }
  .event-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .event-card { position: relative; display: grid; grid-template-columns: 132px 1fr; min-height: 390px; border-bottom: 3px solid var(--ink); }
  .event-card:nth-child(odd) { border-right: 3px solid var(--ink); }
  .event-card__time { display: flex; flex-direction: column; gap: 8px; padding: 26px 18px; border-right: 3px solid var(--ink); background: var(--yellow); font-family: "JetBrains Mono Variable", monospace; }
  .event-card__time span { font-weight: 900; }
  .event-card__time strong { margin-top: auto; font-size: 24px; line-height: .9; }
  .event-card__time small { font-size: 9px; }
  .event-card__body { display: flex; flex-direction: column; padding: clamp(24px, 3.5vw, 48px); }
  .event-card__meta { display: flex; flex-wrap: wrap; gap: 7px; }
  .event-card__meta span { padding: 5px 7px; border: 1px solid; font-family: "JetBrains Mono Variable", monospace; font-size: 8px; font-weight: 800; text-transform: uppercase; }
  .event-card h3 { max-width: 650px; margin: auto 0 12px; font-size: clamp(30px, 4vw, 58px); letter-spacing: -.06em; line-height: .88; }
  .event-card p { max-width: 570px; margin: 0 0 16px; line-height: 1.35; }
  .event-card__venue { font-family: "JetBrains Mono Variable", monospace; font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .event-card a { align-self: flex-start; margin-top: auto; border-bottom: 2px solid; color: inherit; font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 900; text-decoration: none; }
  .event-card__number { position: absolute; top: 20px; right: 22px; color: rgba(17,16,13,.18); font-size: 40px; font-weight: 950; }
  .guide-panel--in { background: #10152c; color: white; }
  .tv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .tv-card { min-width: 0; padding: clamp(22px, 3vw, 42px); border-right: 3px solid var(--paper); border-bottom: 3px solid var(--paper); }
  .tv-card:last-child { border-right: 0; }
  .tv-card__screen { position: relative; display: flex; min-height: 290px; flex-direction: column; justify-content: space-between; padding: 26px; overflow: hidden; border: 5px solid var(--paper); border-radius: 44% 49% 45% 47%; background: #243c36; box-shadow: 13px 15px 0 var(--blue); color: #a9ffcd; }
  .tv-card__scan { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent 0 4px, rgba(255,255,255,.08) 4px 6px), linear-gradient(120deg, transparent, rgba(255,255,255,.13), transparent); }
  .tv-card__screen span, .tv-card__screen small { z-index: 1; font-family: "JetBrains Mono Variable", monospace; font-size: 10px; font-weight: 900; letter-spacing: .12em; }
  .tv-card__screen strong { z-index: 1; font-size: clamp(48px, 5vw, 76px); letter-spacing: -.08em; }
  .tv-card--canceled .tv-card__screen { background: repeating-linear-gradient(135deg, var(--red) 0 18px, #111 18px 36px); color: white; }
  .tv-card__copy { display: flex; min-height: 330px; flex-direction: column; padding-top: 34px; }
  .tv-card__copy > p { margin: 0; color: var(--yellow); font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 900; letter-spacing: .1em; }
  .tv-card h3 { margin: 18px 0 8px; font-size: clamp(28px, 3vw, 48px); letter-spacing: -.055em; line-height: .9; }
  .tv-card__copy > b { margin-bottom: 22px; font-family: "JetBrains Mono Variable", monospace; font-size: 10px; text-transform: uppercase; }
  .tv-card__copy > span { line-height: 1.45; }
  .tv-card__copy > div { display: flex; gap: 18px; margin-top: auto; padding-top: 24px; }
  .tv-card a { border-bottom: 2px solid; color: white; font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 900; text-decoration: none; }
  .station-strip { display: grid; grid-template-columns: 1fr 1fr; }
  .station-strip > a { display: flex; min-height: 280px; flex-direction: column; padding: clamp(26px, 4vw, 56px); border-right: 3px solid var(--paper); color: white; text-decoration: none; }
  .station-strip > a:last-child { border-right: 0; }
  .station-strip span, .station-strip small, .station-strip b { font-family: "JetBrains Mono Variable", monospace; font-size: 9px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .station-strip strong { margin: auto 0 8px; color: var(--yellow); font-size: clamp(30px, 4vw, 56px); letter-spacing: -.06em; }
  .station-strip p { max-width: 620px; line-height: 1.4; }
  .method { display: grid; grid-template-columns: .72fr 1.28fr; border-bottom: 3px solid var(--ink); }
  .method__intro { display: flex; min-height: 620px; flex-direction: column; padding: clamp(28px, 4vw, 62px); border-right: 3px solid var(--ink); background: var(--yellow); }
  .method__intro h2 { margin: auto 0 28px; font-size: clamp(54px, 7vw, 100px); letter-spacing: -.08em; line-height: .78; }
  .method__intro > p:last-of-type { max-width: 560px; font-size: 18px; line-height: 1.4; }
