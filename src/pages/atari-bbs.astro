---
import BlockLayout from '../layouts/BlockLayout.astro';
import { atariBbs as museum } from '../data/atari-bbs';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: museum.title, description: museum.description,
  url: 'https://pointcast.xyz/atari-bbs',
  about: [{ '@type': 'Thing', name: 'Death Star BBS' }, { '@type': 'Thing', name: 'Atari 130XE' }],
  citation: museum.sources.map(source => source.url),
};
---

<BlockLayout title="Death Star BBS · Atari Museum" description={museum.description} image="/images/atari-bbs/og-atari-bbs.png" themeColor="#eee9dd" immersive isolated hideAds jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/atari-bbs.json', title: 'Museum collection and sources' }]}>
  <div class="museum">
    <header class="museum-nav">
      <a class="wordmark" href="/">POINTCAST<span> / MUSEUM</span></a>
      <nav aria-label="Museum"><a href="/atari-bbs/death-star/">ATASCII BBS</a><a href="/atari-bbs/club/">Club</a><a href="#sources">Sources</a></nav>
    </header>

    <section class="hero" aria-labelledby="museum-title">
      <div class="hero-type">
        <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Atari BBS Museum · Exhibit 001</p>
        <h1 id="museum-title">DEATH<br/>STAR<span class="bbs-word">BBS<span class="square" aria-hidden="true">■</span></span></h1>
        <p class="hero-deck">Before the feed,<br/>there was a phone line.</p>
        <p class="hero-intro">Mike Hoydich was <strong>Overlord</strong>. Frank was <strong>Freddie</strong>. A little Atari became a place to meet.</p>
        <a class="button primary" href="/atari-bbs/death-star/">Enter the ATASCII board <span aria-hidden="true">↗</span></a>
        <p class="tiny hero-note">A personal archive. A playable tribute. <a href="/atari-bbs/club/">A new computer club ↗</a></p>
      </div>
      <figure class="hero-art">
        <div class="photo-label"><span>THE ORIGINAL RIG</span><span>MH / 001</span></div>
        <a class="archive-photo" href="/images/atari-bbs/bbs-rig.jpg" aria-label="Open the full original BBS rig photograph">
          <img src="/images/atari-bbs/bbs-rig.jpg" width="1280" height="691" alt="Mike’s BBS desk: Atari computer, telephone, floppy disks, drive and large television against wood paneling." fetchpriority="high" />
          <span class="enlarge" aria-hidden="true">View full photograph ↗</span>
        </a>
        <figcaption><span>Wood paneling. Floppy disks. A world on the other end.</span><a href={museum.primarySource}>Michael Hoydich’s archive ↗</a></figcaption>
        <div class="artifact-tag"><span class="tag-year">1987</span><div>DEATH STAR BBS<br/><span>Launch year, as remembered by Mike.<br/>Photograph date unconfirmed.</span></div></div>
      </figure>
    </section>

    <div class="spec-strip" aria-label="The original setup, according to Mike’s WordPress account">
      {museum.facts.map(fact => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
    </div>

    <section class="club-door" aria-label="Death Star Computer Club">
      <img src="/images/atari-bbs/club/first-carrier.webp" alt="First Carrier satellite dish badge" width="180" height="180" loading="lazy" />
      <div><p class="eyebrow">The next connection</p><h2>Same curiosity.<br/>A new computer club.</h2><p>Choose a handle. Share a memory. Make something small and strange. The board is open.</p><a href="/atari-bbs/club/">Meet the Death Star Computer Club ↗</a></div>
      <a class="door-bbs" href="/atari-bbs/death-star/">40 × 24<br/><strong>ATASCII</strong><span>A character-built world<br/>with archery inside. ↗</span></a>
    </section>

    <section class="terminal-section section" id="terminal" aria-labelledby="terminal-title">
      <div class="section-heading"><p class="eyebrow">01 / The line is open</p><h2 id="terminal-title">Take a seat at the terminal.</h2><p>A small taste of dialing into somewhere. Read the museum notes, then try your hands at 38-column dash.</p></div>
      <div class="terminal-shell" data-terminal>
        <div class="terminal-chrome"><span><span class="led" aria-hidden="true"></span> DEATH STAR / MUSEUM TERMINAL</span><span data-connection>OFFLINE</span></div>
        <div class="terminal-body">
          <div class="screen">
            <div class="screen-top"><span>ATARI / 8-BIT CULTURE</span><label class="instant-option"><input type="checkbox" data-instant /> Instant text</label></div>
            <pre class="ascii-title" aria-hidden="true">+------------------------------------+
|         D E A T H   S T A R          |
|             B . B . S .             |
+------------------------------------+</pre>
            <pre class="terminal-output" data-output aria-label="Terminal display">The museum terminal is ready.

Connect to browse the archive.
No login. Just a little curiosity.</pre>
            <p class="sr-only" data-announcement role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="terminal-actions"><button class="connect-button" type="button" data-connect>CONNECT AT 300 BAUD</button><button class="skip-text" type="button" data-skip hidden>Show all text</button></div>
            <form class="command-form" data-command-form hidden>
              <label for="museum-command">COMMAND &gt;</label><input id="museum-command" name="command" type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="Try HELP" aria-describedby="command-help"/><button type="submit">ENTER ↵</button>
            </form>
            <p class="command-help" id="command-help">Type HELP for commands, or use the menu.</p>
            <noscript><p>This terminal needs JavaScript. The complete museum collection and source links remain available below.</p></noscript>
          </div>
          <nav class="terminal-menu" aria-label="Terminal commands">
            <p>MAIN MENU</p>
            <button type="button" data-command="H"><kbd>H</kbd><span>The story</span><span aria-hidden="true">↗</span></button>
            <button type="button" data-command="R"><kbd>R</kbd><span>The rig</span><span aria-hidden="true">↗</span></button>
            <button type="button" data-command="G"><kbd>G</kbd><span>38-column dash</span><span aria-hidden="true">↗</span></button>
            <button type="button" data-command="S"><kbd>S</kbd><span>Source notes</span><span aria-hidden="true">↗</span></button>
            <button type="button" data-command="HELP"><kbd>?</kbd><span>Help / menu</span><span aria-hidden="true">↗</span></button>
            <span class="menu-footer">ONE KEY.<br/>ANOTHER DOOR.</span>
          </nav>
        </div>
        <div class="terminal-footer"><span>NEW BROWSER TRIBUTE · ORIGINAL SOFTWARE NOT RECOVERED</span><span>LOCAL SIMULATION</span></div>
      </div>

      <div class="dash" id="dash" tabindex="-1" aria-labelledby="dash-title" hidden>
        <div class="dash-copy"><p class="eyebrow">Door game / New recreation</p><h3 id="dash-title">38-column dash</h3><p>Alternate <kbd>A</kbd> and <kbd>L</kbd>, or tap the two buttons. Each switch moves one column. Reach 38 as quickly as you can.</p><p class="tiny">Inspired by Freddie’s and Jolly Joe’s recollections. This is newly written museum software.</p></div>
        <div class="dash-play"><div class="dash-meter"><span data-dash-count>00 / 38</span><span data-dash-time>0.00 s</span></div><div class="dash-track" role="progressbar" aria-label="Columns completed" aria-valuemin="0" aria-valuemax="38" aria-valuenow="0">{Array.from({ length: 38 }, () => <span></span>)}</div><p data-dash-status role="status" aria-live="polite">Press either key to start. Then alternate.</p><div class="dash-controls"><button type="button" data-step="A"><kbd>A</kbd> LEFT</button><button type="button" data-step="L"><kbd>L</kbd> RIGHT</button></div><div class="dash-bottom"><span data-best>Best time stays in this browser.</span><button type="button" data-reset>Reset race ↺</button></div></div>
      </div>
    </section>

    <section class="collection section" id="collection" aria-labelledby="collection-title">
      <div class="section-heading"><p class="eyebrow">02 / The collection</p><h2 id="collection-title">Small machine. Open world.</h2></div>
      <div class="collection-grid">
        <article class="artifact hardware"><div class="artifact-header"><span>OBJECT 002</span><span>HARDWARE</span></div><a href="/images/atari-bbs/atari-130xe.jpg" aria-label="Open the full Atari 130XE reference photograph"><img src="/images/atari-bbs/atari-130xe.jpg" width="2379" height="1506" loading="lazy" alt="A gray Atari 130XE computer with integrated keyboard and five function keys."/></a><div class="artifact-copy"><h3>Atari 130XE</h3><p>128K of RAM, with extra memory reached through bank switching. ANTIC’s July 1985 report captured the promise of Atari’s new 8-bit computer.</p><p class="tiny">Reference specimen. Photo: <a href={museum.images[1].source}>Multicherry</a> · <a href={museum.images[1].licenseUrl}>CC BY-SA 3.0</a>. Retouched by the photographer; displayed unchanged.</p><a class="text-link" href={museum.sources[2].url}>Read the 1985 report ↗</a></div></article>
        <article class="artifact character"><div class="artifact-header"><span>OBJECT 003</span><span>VISUAL LANGUAGE</span></div><div class="character-image"><img src="/images/atari-bbs/atascii.gif" width="256" height="256" loading="lazy" alt="Matrix of the ATASCII character set, showing letters, numerals, geometric symbols and inverse forms." /></div><div class="artifact-copy"><h3>A world made of characters.</h3><p>Letters, lines, little shapes, and their inverse forms. This ATASCII reference shows the compact visual vocabulary of the Atari screen.</p><p class="tiny">Modern emulator rendering by <a href={museum.images[2].source}>Kim Slawson, corrected by Dpla-fr</a> · <a href={museum.images[2].licenseUrl}>CC0</a>. Displayed unchanged.</p></div></article>
      </div>
    </section>

    <section class="history section" aria-labelledby="history-title">
      <div class="section-heading"><p class="eyebrow">03 / A connection across time</p><h2 id="history-title">The board went quiet.<br/>The conversation carried on.</h2><p>At a BBS, the person running the system was a sysop. Here, the names were Overlord and Freddie.</p></div>
      <div class="timeline">{museum.timeline.map(item => <article><a href={item.source} class="timeline-year">{item.year}<span aria-hidden="true">↗</span></a><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
      <a class="story-link" href={museum.primarySource}><div><span class="eyebrow">The original post + reunion thread</span><strong>Death Star BBS – 1987</strong><span>Michael Hoydich · September 10, 2013</span></div><span aria-hidden="true">↗</span></a>
    </section>

    <section class="sources section" id="sources" aria-labelledby="sources-title">
      <div class="section-heading"><p class="eyebrow">04 / The reading room</p><h2 id="sources-title">Follow the evidence.</h2><p>Personal memories, a real photograph, contemporary reporting. Every exhibit has a way back to its source.</p></div>
      <div class="source-list">{museum.sources.map(source => <article><span class="source-number">{source.id}</span><div><a href={source.url}>{source.title}<span aria-hidden="true"> ↗</span></a><p class="source-publisher">{source.publisher}</p><p>{source.note}</p></div></article>)}</div>
      <details class="archive-notes"><summary>Archive notes & image credits</summary><div><p>In 2018, Mike clarified that the Apple Death Star list on textfiles.com belonged to another board. It is excluded here. Percom-drive and Avatex-modem identifications in the comments are tentative.</p><p>The terminal and game are new interpretations. No original Death Star program or screen capture has been recovered for this exhibit.</p>{museum.images.map(asset => <p><strong>{asset.title}:</strong> {asset.credit}. <a href={asset.source}>Source</a>. {asset.licenseUrl ? <a href={asset.licenseUrl}>{asset.license}</a> : asset.license}. {asset.note}</p>)}</div></details>
    </section>

    <footer class="museum-footer"><div><a class="wordmark" href="/">POINTCAST</a><p>A place for the things that connected us.</p></div><div><a href="/atari-bbs.json">Collection data ↗</a><a href="/apps">More to explore ↗</a><span>Curated by Codex for Mike Hoydich · September 2026</span></div></footer>
  </div>
</BlockLayout>

<script>
  import '../scripts/atari-bbs';
</script>

<style>
  :global(html) { scroll-behavior:smooth; scroll-padding-top:28px; }
  :global(html[data-pc-layout='block']) { --pc-bg:#eee9dd; --pc-ink:#26291f; --pc-accent:#344e37; }
  :global(body.pc-block-shell) { margin:0; background:#eee9dd; color:#26291f; padding-bottom:0; }
  .museum { --ink:#26291f; --paper:#eee9dd; --green:#344e37; --line:#c9c5b8; --mono:'JetBrains Mono Variable',monospace; max-width:1480px; padding:0 56px; margin:auto; font-family:'Inter Variable',sans-serif; }
  .museum * { box-sizing:border-box; }
  .museum a { color:inherit; } .museum strong { font-weight:700; } button,input { font:inherit; } button,a { -webkit-tap-highlight-color:transparent; } button { cursor:pointer; } :global(.museum [hidden]) { display:none!important; }
  a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible,.dash:focus-visible { outline:3px solid #b76628; outline-offset:5px; }
  .museum-nav { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:27px 0; border-bottom:1px solid var(--ink); }
  .wordmark { font-weight:850; letter-spacing:-.045em; text-decoration:none; font-size:21px; } .wordmark span { font-family:var(--mono); font-size:11px; font-weight:500; letter-spacing:.06em; margin-left:14px; }
  nav { display:flex; gap:30px; } .museum-nav nav a { font-size:12px; text-decoration:none; } .museum-nav nav a:hover { text-decoration:underline; }
  .hero { display:grid; grid-template-columns:.9fr 1.2fr; gap:40px; padding:52px 0 44px; align-items:center; }
  .club-door { display:grid; grid-template-columns:150px 1fr 210px; align-items:center; gap:30px; border-bottom:1px solid var(--line); padding:40px 0; } .club-door>img { width:150px;height:150px;object-fit:contain; } .club-door .eyebrow { margin-bottom:12px; } .club-door h2 { font-size:32px; margin:0 0 12px; } .club-door p:not(.eyebrow) { font-size:13px;line-height:1.65;max-width:430px; } .club-door a { font:11px/1.7 var(--mono);text-underline-offset:4px; } .club-door .door-bbs { background:#24322a; color:#e0e8b6; text-decoration:none;padding:28px; } .door-bbs strong { display:block;font-size:26px;margin:14px 0; } .door-bbs span { font-size:9px; } @media(max-width:800px) { .club-door { grid-template-columns:100px 1fr;gap:20px; }.club-door>img { width:100px;height:100px; }.club-door .door-bbs { grid-column:1/-1; }.club-door h2 { font-size:27px; } }
  .eyebrow { font:10px/1.5 var(--mono); letter-spacing:.09em; text-transform:uppercase; margin:0 0 20px; }
  .signal-dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:#a9512c; margin-right:8px; }
  h1 { font-weight:900; font-size:clamp(80px,8.9vw,132px); line-height:.8; letter-spacing:-.075em; margin:30px 0 26px; }
  .bbs-word { display:block; color:var(--green); margin-top:9px; } .square { font-size:.29em; vertical-align:middle; margin-left:15px; }
  .hero-deck { font-size:25px; line-height:1.25; font-weight:500; letter-spacing:-.04em; margin:0 0 15px; } .hero-intro { font-size:14px; line-height:1.7; max-width:335px; margin:0 0 24px; }
  .button { display:inline-flex; gap:38px; align-items:center; justify-content:space-between; padding:15px 18px; text-decoration:none; font-size:12px; font-weight:600; } .primary { background:var(--green); color:#fffef1; } .primary:hover { background:#223725; }
  .tiny { font:10px/1.65 var(--mono); color:#595d50; } .hero-note { margin:12px 0 0; }
  figure { margin:0; } .hero-art { transform:rotate(-1.3deg); margin-top:25px; }
  .photo-label { display:flex; justify-content:space-between; font:10px var(--mono); padding:12px 0; border-top:1px solid var(--ink); }
  .archive-photo { position:relative; display:block; background:#af9b81; } .archive-photo img { width:100%; height:auto; display:block; } .enlarge { position:absolute; bottom:10px; right:10px; padding:7px 10px; background:#eee9dded; color:var(--ink); font:9px var(--mono); }
  figcaption { display:grid; gap:8px; font:10px/1.5 var(--mono); padding:14px 0; border-bottom:1px solid var(--ink); } figcaption a { color:#626251; }
  .artifact-tag { display:flex; gap:22px; align-items:center; margin-top:28px; } .tag-year { font-size:58px; line-height:1; letter-spacing:-.07em; font-weight:800; color:#a9512c; } .artifact-tag div { font:10px/1.6 var(--mono); } .artifact-tag div span { color:#616050; }
  .spec-strip { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--ink); border-bottom:1px solid var(--ink); padding:23px 0; } .spec-strip div { display:grid; gap:8px; padding-left:28px; border-left:1px solid var(--line); } .spec-strip div:first-child { border:0;padding-left:0; } .spec-strip strong { font-size:30px; letter-spacing:-.05em; } .spec-strip span { font:10px/1.4 var(--mono); color:#646557; }
  .section { padding:72px 0; border-bottom:1px solid var(--line); } .section-heading { max-width:650px; margin-bottom:30px; } h2 { font-size:clamp(30px,3.1vw,44px); letter-spacing:-.055em; font-weight:650; line-height:1.08; margin:0 0 18px; } .section-heading>p:last-child:not(.eyebrow) { font-size:14px; line-height:1.75; max-width:490px; color:#646557; margin:0; } .section-heading .eyebrow { margin-bottom:14px; }
  .terminal-shell { background:#18231c; border:7px solid #334033; border-radius:10px; overflow:hidden; color:#bfe6a3; box-shadow:0 9px 0 #202b21,0 16px 32px #20271922; font-family:var(--mono); }
  .terminal-chrome { padding:13px 18px; display:flex; gap:12px; justify-content:space-between; border-bottom:1px solid #526049; font-size:10px; background:#283428; color:#ced0b6; } .led { display:inline-block; width:6px; height:6px; border-radius:50%; background:#b6e799; margin-right:7px; }
  .terminal-body { display:grid; grid-template-columns:1fr 245px; } .screen { position:relative; padding:22px 28px; min-width:0; background:repeating-linear-gradient(0deg,transparent,transparent 3px,#06130d30 3px,#06130d30 4px); } .screen-top { display:flex; justify-content:space-between; gap:12px; color:#91a888; font-size:9px; } .instant-option { display:flex; align-items:center; gap:6px; cursor:pointer; padding:4px 0; } .instant-option input { accent-color:#bfe6a3; }
  .ascii-title { font:clamp(10px,1.45vw,17px)/1.25 var(--mono); margin:25px 0 18px; text-shadow:0 0 14px #a1dc5a33; }
  .terminal-output { min-height:155px; white-space:pre-wrap; overflow-wrap:anywhere; margin:0 0 20px; font:12px/1.8 var(--mono); color:#d1ebbb; }
  .terminal-actions { display:flex; align-items:center; gap:15px; flex-wrap:wrap; } .connect-button { background:#bedf99; color:#1e2c21; border:0; font:11px var(--mono); padding:13px 16px; } .connect-button:hover { background:#daf6b5; } .skip-text { background:none; color:#d1ebbb; border:0; font:10px var(--mono); text-decoration:underline; min-height:44px; }
  .command-form { display:flex; gap:10px; align-items:center; border-top:1px solid #41583d; padding-top:16px; margin-top:10px; font:11px var(--mono); } .command-form input { min-width:0; flex:1; width:100%; border:0; background:#213326; color:#e9f5cb; padding:10px; border-radius:0; font:12px var(--mono); } .command-form input::placeholder { color:#a2b296; } .command-form button { color:#c2e2a9; background:none; border:1px solid #6d8759; padding:10px; font:10px var(--mono); min-height:40px; } .command-help { color:#9aaf8e; font:9px/1.5 var(--mono); margin:16px 0 0; }
  .terminal-menu { display:block; border-left:1px solid #41583d; padding:22px 18px; } .terminal-menu>p { font-size:9px; color:#97ae89; margin:0 0 18px; } .terminal-menu button { display:flex; align-items:center; width:100%; gap:10px; padding:15px 0; border:0; border-bottom:1px solid #3a4c35; color:#cee6b9; background:none; font:11px var(--mono); text-align:left; } .terminal-menu button>span:last-child { margin-left:auto; } .terminal-menu button:hover { color:white; } kbd { font-family:var(--mono); } .terminal-menu kbd { color:#1d2f20; background:#b9d695; width:21px; height:21px; display:grid; place-items:center; font-size:11px; } .menu-footer { display:block; font:10px/1.6 var(--mono); color:#809375; margin-top:28px; }
  .terminal-footer { display:flex; justify-content:space-between; gap:12px; border-top:1px solid #41583d; padding:12px 18px; font:8px/1.5 var(--mono); color:#9eb38e; }
  .dash { margin-top:36px; padding:28px; border:1px solid #b8b9a8; background:#e4e6d6; display:grid; grid-template-columns:.8fr 1.2fr; gap:45px; scroll-margin-top:30px; } .dash h3 { font-size:28px; margin:0 0 12px; letter-spacing:-.04em; } .dash-copy>p:not(.eyebrow):not(.tiny) { font-size:13px; line-height:1.7; } .dash-copy .eyebrow { margin-bottom:12px; } .dash-copy kbd { background:#d5dac6; padding:1px 5px; } .dash-play { min-width:0; } .dash-meter { display:flex; justify-content:space-between; font:20px var(--mono); margin-bottom:18px; } .dash-track { display:grid; grid-template-columns:repeat(38,minmax(0,1fr)); gap:2px; height:35px; padding:6px; background:#c8d1bb; } .dash-track span { background:#b3bea2; } .dash-track span.done { background:#365039; } .dash-play>p { font:10px/1.5 var(--mono); min-height:30px; } .dash-controls { display:flex; gap:12px; } .dash-controls button { flex:1; padding:16px; border:1px solid #82906b; box-shadow:0 3px 0 #82906b; background:#f0f2e5; color:#2e452e; font:12px var(--mono); touch-action:manipulation; } .dash-controls button:active { transform:translateY(2px); box-shadow:0 1px 0 #82906b; } .dash-controls kbd { font-size:22px; margin-right:10px; } .dash-bottom { display:flex; justify-content:space-between; gap:12px; margin-top:20px; font:9px/1.5 var(--mono); } .dash-bottom button { color:inherit; background:none; border:0; text-decoration:underline; padding:0 4px; min-height:30px; }
  .collection-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:28px; } .artifact { border:1px solid var(--line); background:#f5f1e8; display:flex; flex-direction:column; min-width:0; } .artifact-header { display:flex; justify-content:space-between; padding:15px 20px; font:9px var(--mono); border-bottom:1px solid var(--line); } .hardware>a { background:#fff; display:grid; place-items:center; height:290px; } .hardware img { width:100%; height:100%; object-fit:contain; } .character-image { background:#0c0e2a; height:290px; display:grid; place-items:center; } .character-image img { width:216px; height:216px; image-rendering:pixelated; } .artifact-copy { padding:25px; } .artifact-copy h3 { font-size:23px; letter-spacing:-.04em; font-weight:650; margin:0 0 12px; } .artifact-copy p:not(.tiny) { font-size:13px; line-height:1.8; margin:0 0 18px; } .text-link { display:inline-block; font:10px var(--mono); padding-top:10px; text-underline-offset:4px; }
