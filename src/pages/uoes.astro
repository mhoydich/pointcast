---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'University of El Segundo — pointcast.xyz/uoes';
const description =
  'A free, public learning module on how AI agents — Claude, Codex, Manus — actually work together on PointCast.';
const image = 'https://noun.pics/460.svg';

const lessons = [
  {
    number: '01',
    id: '0460',
    title: 'How Claude and Codex work together',
    dek: 'The operating model: one director, three builders, one repo as the shared room.',
    readingTime: '7 min',
  },
  {
    number: '02',
    id: '0461',
    title: 'MCP — the wire between agents',
    dek: 'Host, client, server, transport, schema, and why the wire is not the agent.',
    readingTime: '5 min',
  },
  {
    number: '03',
    id: '0462',
    title: 'Manus and the browser-as-tool',
    dek: 'Browser authority, logged-in work, screenshots, wallet flows, and trust boundaries.',
    readingTime: '5 min',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://pointcast.xyz/uoes',
  name: 'University of El Segundo',
  description,
  url: 'https://pointcast.xyz/uoes',
  provider: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT17M',
  },
  hasPart: lessons.map((lesson) => ({
    '@type': 'CreativeWork',
    position: Number(lesson.number),
    name: lesson.title,
    url: `https://pointcast.xyz/b/${lesson.id}`,
  })),
};
---

<BlockLayout title={title} description={description} image={image} jsonLd={jsonLd}>
  <div class="uoes-page">
    <header class="hero">
      <section class="hero__copy">
        <p class="kicker">CH.FD · UOES</p>
        <h1>University of El Segundo</h1>
        <p class="subtitle">
          A learning module on how AI agents collaborate. Free, public, broadcast from pointcast.xyz.
        </p>
        <p class="intro">
          Three short lessons explain the working triangle behind PointCast: Claude writes and builds, Codex reviews and tightens, Manus handles browser authority, and Mike directs the taste and approvals. The module is written as a public receipt of the collaboration that produced it.
        </p>
      </section>

      <aside class="signal" aria-label="University of El Segundo module signal">
        <div class="signal__bar mono">
          <span>FD</span>
          <span>MODULE</span>
          <span>0460-0462</span>
        </div>
        <img src="https://noun.pics/460.svg" alt="" loading="eager" />
        <div class="signal__grid mono" aria-hidden="true">
          <span>CLAUDE</span>
          <span>CODEX</span>
          <span>MANUS</span>
          <span>MIKE</span>
        </div>
      </aside>
    </header>

    <section class="lessons" aria-label="Lessons">
      {lessons.map((lesson) => (
        <a class="lesson-card" href={`/b/${lesson.id}`}>
          <span class="lesson-card__number mono">{lesson.number}</span>
          <div class="lesson-card__copy">
            <h2>{lesson.title}</h2>
            <p>{lesson.dek}</p>
          </div>
          <div class="lesson-card__meta mono">
            <span>CH.FD · №{lesson.id}</span>
            <span>{lesson.readingTime}</span>
          </div>
        </a>
      ))}
    </section>

    <footer class="class-dismissed">
      <p>Class dismissed. Office hours at the coffee pot.</p>
      <small>co-written by Claude (Anthropic) and Codex (OpenAI), directed by Mike Hoydich</small>
    </footer>
  </div>
</BlockLayout>

<style>
  .uoes-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 18px 84px;
  }

  .mono,
  .kicker,
  .lesson-card__meta,
  .lesson-card__number {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 308px;
    gap: 18px;
    align-items: stretch;
    border-bottom: 1.5px solid #185fa5;
    padding-bottom: 18px;
  }

  .hero__copy {
    min-height: 350px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: 10px solid #185fa5;
    padding: 18px 18px 8px;
    background:
      linear-gradient(90deg, rgba(24, 95, 165, 0.08) 0 1px, transparent 1px 100%),
      linear-gradient(180deg, rgba(24, 95, 165, 0.08) 0 1px, transparent 1px 100%),
      #ffffff;
    background-size: 18px 18px;
  }

  .kicker {
    color: #185fa5;
    font-size: 11px;
    margin: 0 0 10px;
  }

  h1 {
    font-size: clamp(42px, 7vw, 76px);
    line-height: 0.94;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0;
    max-width: 10ch;
  }

  .subtitle {
    font-size: 19px;
    line-height: 1.35;
    color: #12110e;
    margin: 16px 0 0;
    max-width: 34ch;
  }

  .intro {
    font-size: 15px;
    line-height: 1.55;
    color: #38373a;
    margin: 18px 0 0;
    max-width: 68ch;
  }

  .signal {
    border: 1.5px solid #185fa5;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 350px;
    background: #eef4fa;
  }

  .signal__bar,
  .signal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1.5px solid #185fa5;
    color: #0b3e73;
    font-size: 10px;
  }

  .signal__bar span,
  .signal__grid span {
    padding: 8px 9px;
    border-right: 1.5px solid #185fa5;
  }

  .signal__bar span:last-child,
  .signal__grid span:last-child {
    border-right: 0;
  }

  .signal img {
    align-self: center;
    justify-self: center;
    width: min(220px, 80%);
    image-rendering: pixelated;
  }

  .signal__grid {
    grid-template-columns: repeat(4, 1fr);
    border-top: 1.5px solid #185fa5;
    border-bottom: 0;
    background: #fff36f;
  }

  .lessons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 18px;
  }

  .lesson-card {
    min-height: 270px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    padding: 14px;
    border: 1.5px solid #185fa5;
    background: #ffffff;
    color: #12110e;
    text-decoration: none;
  }

  .lesson-card:hover {
    background: #eef4fa;
    text-decoration: none;
  }

  .lesson-card__number {
    color: #185fa5;
    font-size: 26px;
    line-height: 1;
  }

  .lesson-card h2 {
    font-size: 24px;
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0;
  }

  .lesson-card p {
    font-size: 14px;
    line-height: 1.45;
    color: #38373a;
    margin: 10px 0 0;
  }

  .lesson-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1.5px solid #185fa5;
    padding-top: 10px;
    color: #0b3e73;
    font-size: 10px;
  }

  .class-dismissed {
    margin-top: 18px;
    padding: 14px 0 0;
    border-top: 1.5px solid #185fa5;
  }

  .class-dismissed p {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 500;
  }

  .class-dismissed small {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.45;
    color: #5f5e5a;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__copy,
    .signal {
      min-height: 0;
    }

    .signal {
      aspect-ratio: 16 / 9;
    }

    .lessons {
      grid-template-columns: 1fr;
    }

    .lesson-card {
      min-height: 220px;
    }
  }

  @media (max-width: 560px) {
    .uoes-page {
      padding-inline: 12px;
    }

    .hero__copy {
      padding: 16px 14px 8px;
      border-left-width: 7px;
    }

    h1 {
      font-size: 40px;
    }

    .subtitle {
      font-size: 17px;
    }

    .lesson-card__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
