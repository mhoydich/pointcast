---
import {readFileSync} from 'node:fs';
import {resolve} from 'node:path';
import {jobsShell} from '../../lib/opportunities-shell.mjs';

const source=resolve('public/opportunities');
const shell=readFileSync(resolve(source,'index.html'),'utf8');
const catalog=JSON.parse(readFileSync(resolve(source,'catalog.json'),'utf8'));
const html=jobsShell(shell,catalog);
---
<Fragment set:html={html} />
