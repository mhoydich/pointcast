---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Spinning Triptych · three panels, one frame';
const description =
  'A gold-bezel three-panel gallery frame for the Spinning channel. We Don\'t Care (2004), Gotta Have It (2011), Let The Beat Build (2008) — three Kanye-orbit tracks side by side, each with its own pixel-art panel and a small interaction.';

const PANELS = [
  {
    n: 1,
    track: "We Don't Care",
    artist: "Kanye West",
    album: "The College Dropout",
    year: 2004,
    spotifyId: "0IW0qaeyxL5Et4UG2MrJKB",
    blockId: "0453",
    nouns: [188, 488, 644],
    interaction: "chant",
    chant: "WE DON'T CARE",
    blockBody: "panel 1 — track 02 of College Dropout. The kid choir is the whole point.",
    accent: "#993c1d",
    liner: {
      era: "first major-label LP. the sweater raps before the autotune.",
      feel: "kids on the hook, soul-clap drums, defiance you can sing on the way to school.",
      line: "yall can't tell me nothing.",
      nouns: [233, 263],
    },
  },
  {
    n: 2,
    track: "Gotta Have It",
    artist: "Jay-Z × Kanye West",
    album: "Watch The Throne",
    year: 2011,
    spotifyId: "6JFLZH9vCzgqnUToBdiHQb",
    blockId: "0458",
    nouns: [850, 950, 1010],
    interaction: "throne",
    chant: "GOTTA HAVE IT",
    blockBody: "panel 2 — track 07 of Watch The Throne. Two-twenty of strut.",
    accent: "#8a2432",
    liner: {
      era: "the throne tour summer. luxury rap at full volume.",
      feel: "two-twenty straight strut. James-Brown chops, trade-off bars, no hook.",
      line: "gotta have it.",
      nouns: [458, 769],
    },
  },
  {
    n: 3,
    track: "Let The Beat Build",
    artist: "Lil Wayne",
    album: "Tha Carter III",
    year: 2008,
    spotifyId: "3PNGF5i4dhajYEDTuTC2wR",
    blockId: "0459",
    nouns: [1080, 1150, 1188],
    interaction: "stack",
    chant: "LET THE BEAT BUILD",
    blockBody: "panel 3 — Kanye-produced. Kick → snare → bell → choir → horn.",
    accent: "#185fa5",
    liner: {
      era: "carter iii. five-oh-nine of layers stacking, exactly what the title says.",
      feel: "kanye production at its patient: each section adds one element and lets it ride.",
      line: "let the beat build.",
      nouns: [866, 977],
    },
  },
];

const STACK_LAYERS = ["KICK", "SNARE", "BELL", "CHOIR", "HORN"];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/spinning-triptych',
  name: title,
  description,
  url: 'https://pointcast.xyz/spinning-triptych',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  about: PANELS.map((p) => ({
    '@type': 'MusicRecording',
    name: p.track,
    byArtist: { '@type': 'MusicGroup', name: p.artist },
    inAlbum: { '@type': 'MusicAlbum', name: p.album },
    datePublished: String(p.year),
  })),
};
---

<BlockLayout
  title={title}
  description={description}
  image="https://noun.pics/850.svg"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/b/0458.json', title: 'Block 0458 (JSON)' },
  ]}
  frame={{
    image: 'https://noun.pics/850.svg',
    buttons: [
      { label: 'Triptych', action: 'link', target: 'https://pointcast.xyz/spinning-triptych' },
      { label: "We Don't Care · 2004", action: 'link', target: 'https://pointcast.xyz/b/0453' },
      { label: 'Gotta Have It · 2011', action: 'link', target: 'https://pointcast.xyz/b/0458' },
      { label: 'Let The Beat Build · 2008', action: 'link', target: 'https://pointcast.xyz/b/0459' },
    ],
  }}
>
  <div class="trip">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/c/spinning">spinning</a>
      <span aria-hidden="true">/</span>
      <span>triptych</span>
    </nav>

    <header class="head">
      <p class="kicker">CH.SPN · GALLERY · THREE PANELS · ONE FRAME</p>
      <h1>The <em>Spinning</em> Triptych</h1>
      <p class="dek">
        Three Kanye-orbit tracks across seven years. We Don't Care (2004),
        Let The Beat Build (2008), Gotta Have It (2011). Each panel is its
        own room. The frame is the gallery.
      </p>
    </header>

    <div class="frame">
      <span class="frame__corner frame__corner--tl" aria-hidden="true"></span>
      <span class="frame__corner frame__corner--tr" aria-hidden="true"></span>
      <span class="frame__corner frame__corner--bl" aria-hidden="true"></span>
      <span class="frame__corner frame__corner--br" aria-hidden="true"></span>

      <div class="plate plate--top" aria-hidden="true">
        <span class="plate__diamond"></span>
        <span class="plate__text">SPINNING · MMIV → MMXI</span>
        <span class="plate__diamond"></span>
      </div>

      <ol class="panels">
        {PANELS.map((p) => (
          <li class="panel" data-panel={p.n} style={`--accent: ${p.accent};`}>
            <header class="panel__head">
              <span class="panel__num">{`PANEL ${String(p.n).padStart(2, '0')}`}</span>
              <span class="panel__pick" data-pick-badge hidden>★ TODAY'S PICK</span>
              <span class="panel__year">{p.year}</span>
            </header>

            <h2 class="panel__title">{p.track}</h2>
            <p class="panel__artist">{p.artist}</p>
            <p class="panel__album">{p.album}</p>

            <ul class="panel__nouns" aria-label="Panel mascots">
              {p.nouns.map((seed) => (
                <li>
                  <img
                    src={`https://noun.pics/${seed}.svg`}
                    alt={`Visit Noun #${seed}`}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="panel__nounTag">#{seed}</span>
                </li>
              ))}
            </ul>

            <div class="panel__embed">
              <iframe
                src={`https://open.spotify.com/embed/track/${p.spotifyId}?utm_source=pointcast`}
                width="100%"
                height="80"
                frameborder="0"
                allowfullscreen
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                title={`${p.track} — ${p.artist}`}
              ></iframe>
            </div>

            {p.interaction === 'chant' && (
              <div class="ix" data-ix="chant">
                <button type="button" class="ix__btn" data-chant-btn>
                  <span class="ix__label">{p.chant}</span>
                  <span class="ix__count" data-count>0</span>
                </button>
                <p class="ix__hint">tap → flash gold, count up. local only.</p>
              </div>
            )}

            {p.interaction === 'throne' && (
              <div class="ix" data-ix="throne">
                <button type="button" class="ix__btn ix__btn--throne" data-throne-btn>
                  <span class="ix__label">{p.chant}</span>
                  <span class="ix__crown" aria-hidden="true">♛</span>
                </button>
                <div class="ix__meter">
                  <span class="ix__bar" data-throne-bar></span>
                </div>
                <p class="ix__hint">hold the throne. fills, then resets. local only.</p>
              </div>
            )}

            {p.interaction === 'stack' && (
              <div class="ix" data-ix="stack">
                <button type="button" class="ix__btn" data-stack-btn>
                  <span class="ix__label">ADD A LAYER</span>
                  <span class="ix__count" data-stack-step>0 / 5</span>
                </button>
                <ol class="ix__stack" data-stack>
                  {STACK_LAYERS.map((layer, i) => (
                    <li class="ix__layer" data-layer-i={i}>{layer}</li>
                  ))}
                </ol>
                <p class="ix__hint">tap five times. each tap unlocks the next layer.</p>
              </div>
            )}

            <footer class="panel__foot">
              <a href={`/b/${p.blockId}`}>open block /b/{p.blockId} →</a>
              <button type="button" class="panel__flip" data-flip>♪ LINER NOTES</button>
            </footer>

            <aside class="panel__back" data-back aria-hidden="true">
              <header class="panel__head">
                <span class="panel__num">{`LINER · 0${p.n}`}</span>
                <span class="panel__year">{p.year}</span>
              </header>

              <h3 class="panel__backTitle">{`"${p.liner.line}"`}</h3>

              <dl class="panel__liner">
                <div><dt>era</dt><dd>{p.liner.era}</dd></div>
                <div><dt>feel</dt><dd>{p.liner.feel}</dd></div>
              </dl>

              <ul class="panel__backNouns" aria-label="Liner-note mascots">
                {p.liner.nouns.map((seed) => (
                  <li>
                    <img
                      src={`https://noun.pics/${seed}.svg`}
                      alt={`Visit Noun #${seed}`}
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="panel__nounTag">#{seed}</span>
                  </li>
                ))}
              </ul>

              <p class="panel__backNote">
                liner notes are this room's small story — what the song is doing,
                not a discography. the front side is for play. this side is for
                the spin afterwards.
              </p>

              <footer class="panel__backFoot">
                <button type="button" class="panel__flipBack" data-flip-back>← BACK TO FRONT</button>
              </footer>
            </aside>
          </li>
        ))}
      </ol>

      <div class="plate plate--bot" aria-hidden="true">
        <span class="plate__diamond"></span>
        <span class="plate__text">POINTCAST · EL SEGUNDO · MMXXVI</span>
        <span class="plate__diamond"></span>
      </div>
    </div>

    <section class="links">
      <h2 class="bar">NEARBY ROOMS</h2>
      <ul>
        <li><a href="/we-dont-care">/we-dont-care · the deep room (panel 1)</a></li>
        <li><a href="/spinning-stoop">/spinning-stoop · the porch</a></li>
        <li><a href="/listening-room">/listening-room · the lounge</a></li>
        <li><a href="/c/spinning">/c/spinning · channel index</a></li>
      </ul>
    </section>

    <footer class="foot">
      <p>
        a small gallery on a small internet town · <a href="/">pointcast</a> ·
        <a href="/c/spinning">/c/spinning</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      // --- panel flip (sprint 2) ---
      (function flips() {
        const panels = document.querySelectorAll('.panel');
        panels.forEach((panel) => {
          const flipBtn = panel.querySelector('[data-flip]');
          const flipBack = panel.querySelector('[data-flip-back]');
          const back = panel.querySelector('[data-back]');
          if (!flipBtn || !flipBack || !back) return;
          flipBtn.addEventListener('click', () => {
            panel.classList.add('is-flipped');
            back.setAttribute('aria-hidden', 'false');
          });
          flipBack.addEventListener('click', () => {
            panel.classList.remove('is-flipped');
            back.setAttribute('aria-hidden', 'true');
          });
        });
      })();

      // --- today's pick (sprint 2): deterministic per-day highlight ---
      (function todaysPick() {
        const panels = document.querySelectorAll('.panel');
        if (panels.length !== 3) return;
        const d = new Date();
        const key = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
        let h = 5381;
        for (let i = 0; i < key.length; i++) {
          h = ((h << 5) + h + key.charCodeAt(i)) >>> 0;
        }
        const pickN = (h % 3) + 1;
        const picked = document.querySelector('[data-panel="' + pickN + '"]');
        if (!picked) return;
        picked.classList.add('is-pick');
        const badges = picked.querySelectorAll('[data-pick-badge]');
        badges.forEach((b) => b.removeAttribute('hidden'));
      })();

      // --- chant counter (panel 1) ---
      (function chant() {
        const btn = document.querySelector('[data-chant-btn]');
        if (!btn) return;
        const KEY = 'pc:trip:chant:v1';
        const out = btn.querySelector('[data-count]');
        let n = 0;
        try { n = Number(localStorage.getItem(KEY) || '0') || 0; } catch (e) {}
        out.textContent = String(n);
        btn.addEventListener('click', () => {
          n += 1;
          out.textContent = String(n);
          try { localStorage.setItem(KEY, String(n)); } catch (e) {}
          btn.classList.remove('is-flash');
          void btn.offsetWidth;
          btn.classList.add('is-flash');
        });
      })();

      // --- throne meter (panel 2): hold to fill, release resets ---
      (function throne() {
        const btn = document.querySelector('[data-throne-btn]');
        const bar = document.querySelector('[data-throne-bar]');
        if (!btn || !bar) return;
        const FILL_MS = 2400;
        let pressing = false;
        let pressedAt = 0;
        let raf = 0;

        function paint() {
          if (!pressing) return;
          const elapsed = performance.now() - pressedAt;
          const pct = Math.min(100, (elapsed / FILL_MS) * 100);
          bar.style.width = pct + '%';
          if (pct >= 100) {
            btn.classList.add('is-throned');
            setTimeout(() => {
              btn.classList.remove('is-throned');
              bar.style.width = '0%';
              pressing = false;
            }, 700);
            return;
          }
          raf = requestAnimationFrame(paint);
        }
        function down(e) {
          e.preventDefault();
          if (pressing) return;
          pressing = true;
          pressedAt = performance.now();
          paint();
        }
        function up() {
          if (!pressing) return;
          pressing = false;
          cancelAnimationFrame(raf);
          bar.style.width = '0%';
        }
        btn.addEventListener('pointerdown', down);
        btn.addEventListener('pointerup', up);
        btn.addEventListener('pointerleave', up);
        btn.addEventListener('pointercancel', up);
      })();

      // --- stack builder (panel 3) ---
      (function stack() {
        const btn = document.querySelector('[data-stack-btn]');
        const step = document.querySelector('[data-stack-step]');
        const layers = document.querySelectorAll('[data-stack] .ix__layer');
        if (!btn || !step || !layers.length) return;
        const total = layers.length;
        let i = 0;
        btn.addEventListener('click', () => {
          if (i >= total) {
            // reset to start
            layers.forEach((el) => el.classList.remove('is-on'));
            i = 0;
            step.textContent = '0 / ' + total;
            return;
          }
          layers[i].classList.add('is-on');
          i += 1;
          step.textContent = i + ' / ' + total;
          if (i >= total) btn.querySelector('.ix__label').textContent = 'BUILT — TAP TO RESET';
          else btn.querySelector('.ix__label').textContent = 'ADD A LAYER';
        });
      })();
    })();
  </script>

  <style>
    .trip {
      --paper: #fff5e8;
      --ink: #1a1410;
      --gold: #d8a83a;
      --gold-deep: #a3781f;
      --velvet: #2a1a2e;
      --velvet-2: #3a2540;

      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
      color: var(--ink);
      font-family: 'Georgia', 'Times New Roman', serif;
    }

    .crumb {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.7);
      margin-bottom: 1.25rem;
    }
    .crumb a { color: var(--gold-deep); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb span[aria-hidden] { margin: 0 0.4rem; opacity: 0.5; }

    .head {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .kicker {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.22em;
      color: var(--gold-deep);
      margin: 0 0 0.5rem;
    }
    .head h1 {
      font-family: 'Georgia', serif;
      font-weight: 900;
      font-size: clamp(2.4rem, 7vw, 4.5rem);
      line-height: 0.96;
      letter-spacing: -0.02em;
      margin: 0 0 0.6rem;
    }
    .head h1 em { color: var(--gold-deep); font-style: italic; }
    .head .dek { max-width: 60ch; margin: 0 auto; line-height: 1.5; font-size: 1.02rem; }

    /* The cool frame — gold bezel on a velvet background */
    .frame {
      position: relative;
      background:
        radial-gradient(ellipse at center, var(--velvet-2) 0%, var(--velvet) 60%, #1a0e1f 100%);
      border: 10px solid var(--gold);
      box-shadow:
        inset 0 0 0 4px var(--velvet),
        inset 0 0 0 8px var(--gold-deep),
        inset 0 0 0 12px var(--velvet),
        0 18px 40px -12px rgba(0, 0, 0, 0.55);
      padding: 2.4rem 1.4rem 2.2rem;
      margin: 0 0 2rem;
      border-radius: 4px;
    }
    .frame__corner {
      position: absolute;
      width: 38px;
      height: 38px;
      background:
        linear-gradient(135deg, var(--gold) 0% 50%, var(--gold-deep) 50% 100%);
      border: 3px solid var(--ink);
      transform: rotate(45deg);
      z-index: 2;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }
    .frame__corner--tl { top: -22px; left: -22px; }
    .frame__corner--tr { top: -22px; right: -22px; }
    .frame__corner--bl { bottom: -22px; left: -22px; }
    .frame__corner--br { bottom: -22px; right: -22px; }

    .plate {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      margin: 0 auto;
      padding: 0.45rem 1rem;
      background: var(--gold);
      border: 3px solid var(--ink);
      box-shadow:
        inset 0 0 0 2px var(--gold-deep),
        0 2px 0 var(--gold-deep);
      width: fit-content;
      max-width: 90%;
    }
    .plate--top { margin-top: -0.3rem; margin-bottom: 1.6rem; }
    .plate--bot { margin-top: 1.6rem; }
    .plate__text {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.2em;
      color: var(--ink);
      font-weight: 700;
      white-space: nowrap;
    }
    .plate__diamond {
      width: 8px;
      height: 8px;
      background: var(--ink);
      transform: rotate(45deg);
    }

    /* Panels */
    .panels {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.1rem;
    }
    .panel {
      position: relative;
      background: var(--paper);
      border: 4px solid var(--ink);
      box-shadow:
        inset 0 0 0 2px var(--paper),
        inset 0 0 0 4px var(--gold),
        0 8px 0 -2px rgba(0, 0, 0, 0.35);
      padding: 1rem 1rem 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      min-height: 700px;
      transition: box-shadow 0.45s ease, transform 0.45s ease;
    }

    /* Today's Pick — gold halo on one panel, deterministic per day */
    .panel.is-pick {
      box-shadow:
        inset 0 0 0 2px var(--paper),
        inset 0 0 0 4px var(--gold),
        0 0 0 4px var(--gold),
        0 0 24px 4px rgba(216, 168, 58, 0.55),
        0 8px 0 -2px rgba(0, 0, 0, 0.4);
      transform: translateY(-2px);
    }
    .panel__pick {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      padding: 0.18rem 0.45rem;
      background: var(--gold);
      color: var(--ink);
      border: 2px solid var(--ink);
      font-weight: 700;
      white-space: nowrap;
      animation: pickPulse 2.4s ease-in-out infinite;
    }
    @keyframes pickPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(216, 168, 58, 0); }
      50%      { box-shadow: 0 0 0 4px rgba(216, 168, 58, 0.45); }
    }
    .panel__head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      border-bottom: 2px dashed rgba(26, 20, 16, 0.25);
      padding-bottom: 0.5rem;
    }
    .panel__num { font-weight: 700; }
    .panel__year { color: rgba(26, 20, 16, 0.6); }

    .panel__title {
      font-family: 'Georgia', serif;
      font-style: italic;
      font-size: clamp(1.4rem, 2.8vw, 1.85rem);
      line-height: 1.05;
      margin: 0;
      letter-spacing: -0.01em;
    }
    .panel__artist {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      margin: 0;
      color: var(--accent);
      font-weight: 700;
    }
    .panel__album {
      font-size: 0.85rem;
      font-style: italic;
      color: rgba(26, 20, 16, 0.65);
      margin: 0;
    }

    .panel__nouns {
      list-style: none;
      margin: 0;
      padding: 0.55rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.4rem;
      background:
        repeating-linear-gradient(90deg, var(--paper) 0 8px, #f5e3c4 8px 16px);
      border: 2px solid var(--ink);
    }
    .panel__nouns li {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.15rem;
    }
    .panel__nouns img {
      width: 100%;
      max-width: 64px;
      aspect-ratio: 1 / 1;
      image-rendering: pixelated;
      background: var(--paper);
      border: 2px solid var(--ink);
    }
    .panel__nounTag {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      color: rgba(26, 20, 16, 0.55);
    }

    .panel__embed {
      border: 2px solid var(--ink);
      background: #000;
    }
    .panel__embed iframe { display: block; border: 0; }

    /* Per-panel interaction */
    .ix {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .ix__btn {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      padding: 0.85rem 1rem;
      border: 3px solid var(--ink);
      background: var(--accent);
      color: var(--paper);
      font-family: 'Georgia', serif;
      font-style: italic;
      font-weight: 900;
      font-size: 1.05rem;
      letter-spacing: 0.01em;
      cursor: pointer;
      transition: transform 0.06s ease;
      overflow: hidden;
    }
    .ix__btn:active { transform: translateY(1px); }
