---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { coGameWorlds } from '../../lib/co-games-worlds';
const description = 'Pop a little shower of Nouns, or catch the beat in the rhythm arcade. Two tiny musical toys through four strange worlds.';
---
<BlockLayout title="NOUNS: STARJAM" description={description} image="/images/co-games/worlds/moon-station.webp" immersive={true} jsonLd={{ '@context': 'https://schema.org', '@type': 'VideoGame', name: 'NOUNS: STARJAM', description, url: 'https://pointcast.xyz/co-games/flow', isAccessibleForFree: true }}>
<article class="starjam-page">
<div id="nouns-flow" data-mode="drip" data-state="ready" data-pace="gentle" data-world="garden" aria-label="Nouns Starjam musical playground">
  <audio data-flow-track src="/audio/starjam/garden-gentle.m4a" preload="auto" hidden></audio>
  {[0,1,2].map(lane=><audio data-flow-hit-audio={lane} src={`/audio/starjam/hit-${lane}.m4a`} preload="auto" hidden></audio>)}
  <header class="flow-top"><a href="/co-games" class="flow-wordmark" aria-label="Back to co-games"><span class="flow-noggles" aria-hidden="true">⌐◨-◨</span> NOUNS<span class="flow-slash">/</span><b>STARJAM</b></a><div class="flow-top-tools"><button data-flow-sound type="button" aria-label="Mute game sound" aria-pressed="true">♪</button><button data-flow-dialog="flow-settings" type="button" aria-label="Sound and feel">⚙</button><button data-flow-pause type="button" aria-label="Pause battle" disabled>Ⅱ</button></div></header>
  <div class="flow-modes" role="group" aria-label="Choose your game"><button type="button" data-flow-mode="drip" aria-pressed="true">✦ Noun Drip <small>Tap any time</small></button><button type="button" data-flow-mode="rhythm" aria-pressed="false">♫ Rhythm <small>Catch the beat</small></button></div>
  <main class="flow-machine" aria-label="Nouns playground">
    <img data-flow-landscape class="flow-landscape" src="/images/co-games/worlds/lantern-grove.webp" alt="" fetchpriority="high"/>
    <div class="flow-wash" aria-hidden="true"></div>
    <div class="flow-scorebar"><div><span data-flow-score-label>POPS</span><strong data-flow-score>0</strong></div><div class="flow-time"><span data-flow-world-name>Lantern grove</span><b data-flow-time>35s</b></div><div class="flow-streak"><span data-flow-streak-label>FRIENDS</span><strong><span data-flow-streak>0</span><small data-flow-streak-unit>/8</small></strong></div></div>
    <div class="flow-battlebar"><div class="flow-health"><span>YOU + BUDDY <b data-flow-health>100</b></span><div><i data-flow-health-fill></i></div></div><span class="flow-versus">VS</span><div class="flow-health flow-rival-health"><span>RIVAL CREW <b data-flow-enemy>100</b></span><div><i data-flow-enemy-fill></i></div></div></div>
    <div class="flow-crew flow-player-crew" aria-label="Your Nouns crew"><button data-flow-shuffle type="button" aria-label="Shuffle your Nouns"><img data-flow-noun="0" src="/images/co-games/roster/dog.svg" alt="Your Noun" width="80" height="80"/><span>YOU ↻</span></button><div><img data-flow-noun="1" src="/images/co-games/roster/milk.svg" alt="Buddy Noun" width="64" height="64"/><span>BUDDY</span></div></div>
    <div class="flow-crew flow-rival-crew" aria-label="Rival Nouns crew"><div><img data-flow-noun="2" src="/images/co-games/roster/flower.svg" alt="Rival Noun" width="64" height="64"/><span>RIVALS</span></div><div><img data-flow-noun="3" src="/images/co-games/roster/hotdog.svg" alt="Rival Noun" width="80" height="80"/></div></div>
    <div class="flow-track" aria-label="Three rhythm lanes">
      <div class="flow-track-grid" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="flow-vanish" aria-hidden="true">✦</div>
      <div data-flow-notes class="flow-note-layer" aria-hidden="true"></div>
      <div data-flow-effects class="flow-effects" aria-hidden="true"></div>
      <div class="flow-hit-line" aria-hidden="true"><span>HIT THE LIGHT</span></div>
      <div class="flow-pads"><button type="button" data-flow-lane="0" aria-label="Left lane, key D or 1"><span>✦</span><kbd>D</kbd></button><button type="button" data-flow-lane="1" aria-label="Middle lane, key F or 2"><span>◈</span><kbd>F</kbd></button><button type="button" data-flow-lane="2" aria-label="Right lane, key J or 3"><span>✶</span><kbd>J</kbd></button></div>
    </div>
    <div class="drip-stage" data-drip-stage><div class="drip-canopy" aria-hidden="true">✧ <span>little things, falling into place</span> ✧</div><div class="drip-canvas" data-drip-canvas tabindex="-1" aria-label="Noun Drip. Tap any Noun, or use D, F, J to pop a Noun in each column."></div><div class="drip-particles" data-drip-particles aria-hidden="true"></div><div class="drip-floor" aria-hidden="true"><span>D · 1</span><span>F · 2</span><span>J · 3</span></div></div>
    <div class="flow-callout" data-flow-feedback role="status" aria-live="polite">Find your rhythm.</div>
    <div class="flow-ready"><span class="flow-kicker">INSERT A LITTLE WONDER</span><h1><small>NOUNS:</small><b data-flow-game-title>DRIP</b><span aria-hidden="true">✦</span></h1><p data-flow-ready-copy>Tap any Noun.<br/> Let the good feelings pop.</p><div class="flow-ready-tip"><i>1</i><span data-flow-ready-tip-one>Tap a Noun anywhere on the stage.</span></div><div class="flow-ready-tip"><i>2</i><span data-flow-ready-tip-two>No rush. Every pop is a little win.</span></div><span class="flow-practice" data-flow-practice>TAP · TAB + ENTER · OR D / F / J</span></div>
    <div class="flow-pause-card"><span class="flow-kicker">TAKE A BREATH</span><h2 data-flow-pause-title>Your friends are right here.</h2><p>Resume when you’re ready.</p></div>
    <div data-flow-result class="flow-finish-card" hidden aria-live="polite"><div class="flow-finish-stars" aria-hidden="true"><span>✧</span><b>✦</b><span>✶</span></div><span class="flow-kicker" data-flow-result-kicker>NOUNS: STARJAM</span><h2 data-flow-result-title>You made it pop!</h2><p data-flow-result-copy></p><div class="flow-finish-actions"><button type="button" data-flow-restart>Encore ↻</button><button type="button" data-flow-next-world>Next world →</button></div></div>
    <progress data-flow-progress max="100" value="0" aria-label="Track progress"></progress>
  </main>
  <footer class="flow-deck"><div class="flow-deck-main"><div class="flow-pace-control"><label for="flow-pace">FIND YOUR FLOW</label><select id="flow-pace" data-flow-pace><option value="drift">Drift · 72 BPM</option><option value="gentle" selected>Groove · 96 BPM</option><option value="playful">Arcade · 120 BPM</option></select></div><button type="button" data-flow-start class="flow-start">LET’S JAM <span>↗</span></button></div><nav><button type="button" data-flow-dialog="flow-worlds">✦ Worlds</button><span>FREE PLAY · NO DOWNLOAD</span><button type="button" data-flow-dialog="flow-help">How to jam ↗</button></nav></footer>
  <dialog id="flow-worlds" class="flow-dialog" aria-labelledby="flow-worlds-title"><form method="dialog"><button aria-label="Close worlds">×</button></form><span class="flow-kicker">A LITTLE STAR, A LONG WAY HOME</span><h2 id="flow-worlds-title">Choose your stage.</h2><div class="flow-world-grid">{Object.entries(coGameWorlds).map(([id,world])=><button type="button" data-flow-world={id}><img src={world.src} alt="" loading="lazy" width="360" height="180"/><span>0{world.chapter} / {world.name}</span><p>{world.story}</p></button>)}</div><p class="flow-small">Every world has its own note pattern and musical color.</p></dialog>
  <dialog id="flow-settings" class="flow-dialog" aria-labelledby="flow-settings-title"><form method="dialog"><button aria-label="Close sound settings">×</button></form><span class="flow-kicker">YOUR KIND OF ENERGY</span><h2 id="flow-settings-title">Make a little space.</h2><button type="button" data-flow-test-sound>♪ Test sound</button><p data-flow-audio-status class="flow-audio-status" role="status" aria-live="polite">Tap Test sound for a little welcome tune.</p><audio data-flow-speaker-test src="/audio/starjam/welcome.m4a" controls preload="metadata" aria-label="STARJAM welcome tune"></audio><p class="flow-small">Still quiet? <a href="/audio/starjam/welcome.m4a" target="_blank" rel="noopener">Open the tune directly ↗</a>. On iPhone, use the phone’s volume buttons and check the selected speaker or headphones.</p><label for="flow-volume">Volume <span data-flow-volume-value>35%</span></label><input data-flow-volume id="flow-volume" type="range" min="0" max="100" step="1" value="35"/><p class="flow-small">Drift is slow and spacious. Groove adds a soft pulse. Arcade brings more bounce. Choose your pace before a track.</p><button data-flow-haptics type="button" aria-pressed="false">Haptic taps · off</button><p data-flow-haptics-note class="flow-small">Optional on supported devices.</p><p class="flow-small">Sound starts with your tap. Opening a menu or leaving the page pauses the battle. Reduced motion removes decorative movement; the moving notes remain part of play.</p></dialog>
  <dialog id="flow-help" class="flow-dialog" aria-labelledby="flow-help-title"><form method="dialog"><button aria-label="Close instructions">×</button></form><span class="flow-kicker">TWO LITTLE WAYS TO PLAY</span><h2 id="flow-help-title">Find your good feeling.</h2><h3>Noun Drip</h3><p>Tap any Noun while it falls or after it settles. Every pop counts; waiting never costs you anything. Use <b>D / F / J</b> or <b>1 / 2 / 3</b> for the three columns, or Tab to a Noun and press Enter or Space. Enjoy a 35-second shower, then start an encore.</p><h3>Rhythm</h3><ol><li>Start a track. Notes fall toward the three glowing pads.</li><li>Tap the matching pad when a note reaches the light. On a keyboard, use <b>D / F / J</b> or <b>1 / 2 / 3</b>.</li><li>Accurate hits damage the rivals and build your streak. Misses cost health. Your practice buddy helps as you land hits.</li><li>Beat the crew before the track ends. Then take your Nouns to the next world.</li></ol><p>Choose <b>Drift</b> for spacious music. Switching modes starts fresh. Pause whenever you like.</p><p class="flow-small">These games stay on your device. No prizes, purchases or public scores. <a href="/co-games">Explore spell battles</a>.</p><a href="https://nouns.wtf/traits" target="_blank" rel="noreferrer">Nouns artwork · CC0 ↗</a></dialog>
</div>
</article>
</BlockLayout>
<script>
import { mountNounsFlow } from '../../lib/nouns-flow-ui';
import { mountNounsFlowAudio } from '../../lib/nouns-flow-audio';
let cleanup: (() => void) | undefined;
function setup() {
  cleanup?.();
  const root = document.getElementById('nouns-flow');
  if (!root) return;
  const stopAudio = mountNounsFlowAudio(root);
  const stopFlow = mountNounsFlow(root);
  const abort = new AbortController();
  root.querySelectorAll<HTMLButtonElement>('[data-flow-dialog]').forEach(button => button.addEventListener('click', () => {
    const dialog = root.querySelector<HTMLDialogElement>(`#${button.dataset.flowDialog}`);
    dialog?.showModal();
    dialog?.addEventListener('close', () => button.focus(), { once:true, signal:abort.signal });
  }, {signal:abort.signal}));
  cleanup = () => { abort.abort(); stopFlow(); stopAudio(); };
}
setup();
document.addEventListener('astro:page-load', setup);
document.addEventListener('astro:before-swap', () => {cleanup?.();cleanup=undefined;});
</script>
<style is:global>
body:has(.starjam-page){margin:0;background:#090e19!important;color:#f4f6ff;overflow:hidden}body:has(.starjam-page) main{padding:0!important;margin:0!important;max-width:none!important}
.starjam-page{height:100vh;height:100dvh;padding:12px 24px;max-width:1300px;margin:auto;box-sizing:border-box}
#nouns-flow{--mint:#bdfbaf;--violet:#d3b0ff;--peach:#ffb89f;--line:#ffffff25;height:100%;display:flex;flex-direction:column;gap:10px;font:14px/1.4 Arial,Helvetica,sans-serif;color:#f4f6ff;color-scheme:dark}
#nouns-flow *{box-sizing:border-box}#nouns-flow [hidden]{display:none!important}#nouns-flow button,#nouns-flow select,#nouns-flow input{font:inherit}#nouns-flow button{cursor:pointer;touch-action:manipulation}#nouns-flow button:disabled{opacity:.4;cursor:default}#nouns-flow button:focus-visible,#nouns-flow a:focus-visible,#nouns-flow select:focus-visible{outline:2px solid var(--mint);outline-offset:3px}#nouns-flow p{margin:0}#nouns-flow a{color:inherit}
.flow-top{height:44px;display:flex;align-items:center;justify-content:space-between;flex:none}.flow-wordmark{display:flex;align-items:center;gap:9px;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:1.4px}.flow-wordmark b{font-size:16px;letter-spacing:-.3px}.flow-noggles{color:var(--mint);font-size:25px;letter-spacing:-3px;margin-right:3px}.flow-slash{opacity:.3}.flow-top-tools{display:flex;gap:6px}.flow-top-tools button{width:42px;height:42px;border:1px solid var(--line);background:#18202d;border-radius:12px;color:#dce6ed;font-size:20px}.flow-top-tools [aria-pressed=false]{opacity:.45}
#nouns-flow .flow-machine{position:relative;flex:1;min-height:280px;border:1px solid #9daabc42;border-radius:24px;overflow:hidden;isolation:isolate;background:#151d28;box-shadow:0 18px 50px #0004}.flow-landscape{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 62%;z-index:-3;image-rendering:pixelated}.flow-wash{position:absolute;inset:0;background:linear-gradient(180deg,#090f25cc,#10172833 28%,#080f24c9 100%);z-index:-2}.flow-scorebar{height:62px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;padding:10px 22px;position:relative;z-index:5}.flow-scorebar>div{display:flex;flex-direction:column;gap:1px}.flow-scorebar span{font:9px ui-monospace,monospace;letter-spacing:1.3px;color:#dee7edb5}.flow-scorebar strong{font-size:24px;letter-spacing:-1px;font-variant-numeric:tabular-nums}.flow-scorebar small{font-size:14px;color:var(--violet);margin-left:2px}.flow-scorebar .flow-time{text-align:center;gap:3px;white-space:nowrap}.flow-time b{font:12px ui-monospace,monospace;color:#ffffffb5}.flow-scorebar .flow-streak{text-align:right}
.flow-battlebar{position:relative;z-index:5;display:flex;align-items:center;gap:18px;max-width:550px;margin:0 auto;padding:0 22px}.flow-health{flex:1}.flow-health>span{display:flex;justify-content:space-between;font:8px ui-monospace,monospace;letter-spacing:.5px;color:#d7e5df}.flow-health b{color:white;font-size:10px}.flow-health>div{height:5px;background:#fff2;margin-top:5px;border-radius:3px;overflow:hidden}.flow-health i{display:block;height:100%;width:100%;background:var(--mint);box-shadow:0 0 10px var(--mint);transition:width .15s}.flow-rival-health i{background:var(--peach)}.flow-versus{font:italic 900 12px Arial;color:#fff8}
.flow-crew{position:absolute;top:36%;display:flex;align-items:flex-end;gap:3px;z-index:2}.flow-player-crew{left:7%}.flow-rival-crew{right:7%}.flow-crew>div,.flow-crew>button{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;background:none;border:0;color:#fff;padding:0}.flow-crew img{width:clamp(48px,6vw,88px);height:auto;image-rendering:pixelated;filter:drop-shadow(0 5px 5px #0008)}.flow-crew>div img{width:clamp(40px,5vw,70px)}.flow-crew span{font:7px ui-monospace,monospace;letter-spacing:1px;background:#0f1827bd;padding:3px 6px;border-radius:3px;min-height:15px}.flow-rival-crew>div:last-child{padding-bottom:15px}
.flow-track{position:absolute;top:125px;bottom:0;left:50%;transform:translateX(-50%);width:min(42%,440px);min-width:280px;isolation:isolate}.flow-track-grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);background:linear-gradient(#0d112133,#0c152bdd);border-left:1px solid #bdfbaf45;border-right:1px solid #ffb89f45;box-shadow:0 0 55px #02081966;mask-image:linear-gradient(transparent,#000 12%);z-index:-1}.flow-track-grid i{border-right:1px solid #dce8ff18;background:linear-gradient(90deg,#ffffff04,transparent)}.flow-track-grid i:last-child{border:0}.flow-vanish{position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-size:20px;color:#e9f7c1;text-shadow:0 0 20px #faffb9;opacity:.5}.flow-note-layer{position:absolute;inset:0;overflow:hidden;pointer-events:none}.flow-note{position:absolute;width:60%;max-width:64px;height:18px;border:2px solid #f1ffe8;border-radius:6px;background:var(--mint);box-shadow:0 0 15px #bdfbaf70,inset 0 -4px #35543455;will-change:top}.flow-note[data-lane="1"]{background:var(--violet);border-color:#f3e6ff;box-shadow:0 0 15px #d3b0ff70,inset 0 -4px #63417a55}.flow-note[data-lane="2"]{background:var(--peach);border-color:#ffe9df;box-shadow:0 0 15px #ffb89f70,inset 0 -4px #8a493155}.flow-hit-line{position:absolute;top:82%;left:-10px;right:-10px;height:1px;background:#ecffe994;box-shadow:0 0 18px #c4ffc6;pointer-events:none}.flow-hit-line span{position:absolute;top:56px;left:0;right:0;text-align:center;font:8px ui-monospace,monospace;letter-spacing:2px;color:#dae4df77}.flow-pads{position:absolute;top:82%;left:0;right:0;display:grid;grid-template-columns:repeat(3,1fr);transform:translateY(-50%);gap:12px;padding:0 8px}.flow-pads button{height:74px;min-width:0;border:1px solid #bdfbaf7a;background:linear-gradient(#31463be0,#1e332dd9);border-radius:19px;color:var(--mint);box-shadow:0 5px 0 #080e19,0 0 22px #bdfbaf13;display:flex;align-items:center;justify-content:center;gap:7px;transition:background .08s,box-shadow .08s}.flow-pads button:nth-child(2){color:var(--violet);border-color:#d3b0ff7a;background:linear-gradient(#393345e0,#292533d9)}.flow-pads button:nth-child(3){color:var(--peach);border-color:#ffb89f7a;background:linear-gradient(#443737e0,#332528d9)}.flow-pads span{font-size:31px}.flow-pads kbd{font:10px ui-monospace,monospace;opacity:.5}.flow-pads button:active,.flow-pads button[data-active=true]{background:#bdfbaf;color:#101922;box-shadow:0 0 35px #bdfbaf90}.flow-pads button:nth-child(2):active,.flow-pads button:nth-child(2)[data-active=true]{background:var(--violet)}.flow-pads button:nth-child(3):active,.flow-pads button:nth-child(3)[data-active=true]{background:var(--peach)}
.flow-callout{position:absolute;top:93px;left:50%;transform:translateX(-50%);text-align:center;font-size:13px;font-weight:700;letter-spacing:0;z-index:4;pointer-events:none;width:250px;text-shadow:0 2px 18px #000}.flow-ready,.flow-pause-card,.flow-finish-card{position:absolute;z-index:7;left:50%;top:48%;transform:translate(-50%,-50%);width:min(450px,88%);text-align:center;padding:30px 25px;border:1px solid #dce3ff2c;border-radius:26px;background:linear-gradient(135deg,#142335f5,#241e3cec);box-shadow:0 20px 90px #020712a6;backdrop-filter:blur(16px)}.flow-kicker{font:8px ui-monospace,monospace;letter-spacing:2px;color:var(--mint)}.flow-ready h1{position:relative;display:inline-flex;flex-direction:column;font-size:clamp(40px,5.4vw,70px);font-style:italic;letter-spacing:-4px;line-height:.95;margin:19px 0 16px;text-shadow:3px 4px #493575;color:#f5f7df;transform:rotate(-3deg)}.flow-ready h1 small{font-size:15px;letter-spacing:6px;color:var(--violet);text-align:left;margin-left:6px;margin-bottom:5px;text-shadow:none}.flow-ready h1>span{position:absolute;right:-25px;top:-10px;color:var(--mint);font-size:30px;text-shadow:none}.flow-ready>p{font-size:17px;line-height:1.3;color:#e0dcf0}.flow-ready-tip{display:flex;align-items:center;gap:9px;text-align:left;font-size:11px;color:#d9dce8;max-width:275px;margin:18px auto 0}.flow-ready-tip+.flow-ready-tip{margin-top:10px}.flow-ready-tip i{font:9px ui-monospace,monospace;font-style:normal;display:grid;place-items:center;border:1px solid #e2e1ff4d;border-radius:50%;width:20px;height:20px;flex:none}.flow-practice{display:block;font:7px ui-monospace,monospace;letter-spacing:1.5px;color:#b4bad2;margin-top:24px}.flow-pause-card h2,.flow-finish-card h2{font-size:34px;letter-spacing:-1px;line-height:1.05;margin:15px 0}.flow-pause-card p,.flow-finish-card p{font-size:13px;color:#d3cfe2}.flow-finish-actions{display:flex;gap:10px;margin-top:25px}.flow-finish-actions button{flex:1;border:1px solid #c8dbc552;border-radius:10px;background:#29423b;color:#ecffe6;min-height:46px;font-size:12px}.flow-finish-actions button:last-child{background:var(--mint);color:#18251b;border:0;font-weight:700}.flow-pause-card{display:none}#nouns-flow:not([data-state=ready]) .flow-ready{display:none}#nouns-flow[data-state=paused] .flow-pause-card{display:block}#nouns-flow[data-state=ready] .flow-callout,#nouns-flow[data-state=paused] .flow-callout{visibility:hidden}#nouns-flow[data-state=playing] .flow-crew img{animation:flow-bob 1.25s ease-in-out infinite alternate}#nouns-flow[data-state=playing] .flow-crew>div img{animation-delay:.3s}#nouns-flow[data-state=ready] .flow-note-layer:after{content:'';position:absolute;top:60%;left:calc(50% - 27px);width:54px;height:16px;border-radius:5px;background:var(--violet);box-shadow:-92px -130px 0 var(--mint),92px -65px 0 var(--peach);opacity:.45}
