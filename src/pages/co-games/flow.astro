---
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/starjam-pixel.css';
import '../../styles/starjam-crescendo.css';
import { coGameWorlds } from '../../lib/co-games-worlds';
const description = 'Gather 12 sparks, bring your Nouns into the Heartfire Parade, and play toward a musical finale. A tiny arcade through four strange worlds.';
---
<BlockLayout title="NOUNS: STARJAM" description={description} image="/images/co-games/worlds/moon-station.webp" immersive={true} themeColor="#25243c" jsonLd={{ '@context': 'https://schema.org', '@type': 'VideoGame', name: 'NOUNS: STARJAM', description, url: 'https://pointcast.xyz/co-games/flow', isAccessibleForFree: true }}>
<article class="starjam-page">
<div id="nouns-flow" data-ui="pixel" data-mode="drip" data-state="ready" data-pace="gentle" data-world="garden" aria-label="Nouns Starjam musical playground">
  <audio data-flow-track src="/audio/starjam/garden-gentle.m4a" preload="auto" hidden></audio>
  <audio data-drip-clear-audio src="/audio/starjam/level-clear.m4a" preload="none" hidden></audio>
  {[0,1,2].map(lane=><audio data-flow-hit-audio={lane} src={`/audio/starjam/hit-${lane}.m4a`} preload="auto" hidden></audio>)}
  <header class="flow-top"><a href="/co-games" class="flow-wordmark" aria-label="Back to co-games"><span class="flow-noggles" aria-hidden="true">⌐◨-◨</span> NOUNS<span class="flow-slash">/</span><b>STARJAM</b></a><div class="flow-top-tools"><button data-flow-sound type="button" aria-label="Mute game sound" aria-pressed="true">♪</button><button data-flow-dialog="flow-settings" type="button" aria-label="Sound and feel">⚙</button><button data-flow-pause type="button" aria-label="Pause game" disabled>Ⅱ</button></div></header>
  <div class="flow-modes" role="group" aria-label="Choose your game"><button type="button" data-flow-mode="drip" aria-pressed="true"><span class="flow-cartridge-number" aria-hidden="true">01</span><span>✦ Noun Drip <small>Tap any time</small></span></button><button type="button" data-flow-mode="rhythm" aria-pressed="false"><span class="flow-cartridge-number" aria-hidden="true">02</span><span>♫ Rhythm <small>Catch the beat</small></span></button></div>
  <main class="flow-machine" aria-label="Nouns playground">
    <img data-flow-landscape class="flow-landscape" src="/images/co-games/worlds/lantern-grove.webp" alt="" fetchpriority="high"/>
    <img class="drip-story-landscape" src="/images/co-games/worlds/heartfire-parade.webp" alt="" fetchpriority="high"/>
    <div class="flow-wash" aria-hidden="true"></div>
    <div class="drip-heartlight" aria-hidden="true"><span>♥</span><i>✦</i><i>✧</i><i>✦</i><i>✧</i></div>
    <div class="flow-scorebar"><div><span data-flow-score-label>POPS</span><strong data-flow-score>0</strong></div><div class="flow-time"><span data-flow-world-name>Lantern grove</span><b data-flow-time>35s</b></div><div class="flow-streak"><span data-flow-streak-label>FRIENDS</span><strong><span data-flow-streak>0</span><small data-flow-streak-unit>/8</small></strong></div></div>
    <div class="flow-battlebar"><div class="flow-health"><span>YOU + BUDDY <b data-flow-health>100</b></span><div><i data-flow-health-fill></i></div></div><span class="flow-versus">VS</span><div class="flow-health flow-rival-health"><span>RIVAL CREW <b data-flow-enemy>100</b></span><div><i data-flow-enemy-fill></i></div></div></div>
    <div class="flow-crew flow-player-crew" aria-label="Your Nouns crew"><button data-flow-shuffle type="button" aria-label="Shuffle your Nouns"><img data-flow-noun="0" src="/images/co-games/roster/dog.svg" alt="Your Noun" width="80" height="80"/><span>YOU ↻</span></button><div><img data-flow-noun="1" src="/images/co-games/roster/milk.svg" alt="Buddy Noun" width="64" height="64"/><span>BUDDY</span></div></div>
    <div class="flow-crew flow-rival-crew" aria-label="Rival Nouns crew"><div><img data-flow-noun="2" src="/images/co-games/roster/flower.svg" alt="Rival Noun" width="64" height="64"/><span>RIVALS</span></div><div><img data-flow-noun="3" src="/images/co-games/roster/hotdog.svg" alt="Rival Noun" width="80" height="80"/></div></div>
    <div class="flow-track" aria-label="Three rhythm lanes">
      <div class="flow-track-grid" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="flow-vanish" aria-hidden="true">✦</div>
      <div data-flow-notes class="flow-note-layer" aria-hidden="true"></div>
      <div data-flow-effects class="flow-effects" aria-hidden="true"></div>
      <div class="flow-hit-line" aria-hidden="true"><span>HIT THE LIGHT</span></div>
      <div class="flow-pads"><button type="button" data-flow-lane="0" aria-label="Left lane, key D or 1"><span>✦</span><kbd>D</kbd></button><button type="button" data-flow-lane="1" aria-label="Middle lane, key F or 2"><span>◈</span><kbd>F</kbd></button><button type="button" data-flow-lane="2" aria-label="Right lane, key J or 3"><span>✶</span><kbd>J</kbd></button></div>
    </div>
    <section class="drip-quest" aria-label="Heartfire Parade progress">
      <div class="drip-quest-heading"><span>LEVEL <b data-drip-level-number>1</b> · HEARTFIRE PARADE</span><strong data-drip-goal-count>0 / 12</strong></div>
      <progress data-drip-goal-fill max="12" value="0" aria-label="Sparks gathered"></progress>
      <div class="drip-quest-stops" aria-hidden="true"><span>4 · GATHER</span><span>8 · GLOW</span><span>12 · PARADE ♥</span></div>
      <p data-drip-objective class="drip-objective">Gather 12 sparks and wake the lanterns.</p>
    </section>
    <div class="drip-stage" data-drip-stage><div class="drip-canopy"><b data-drip-phase-label>Gather the parade</b><span data-drip-phase-copy>Pop 4 Nouns to get the party moving.</span></div><div class="drip-canvas" data-drip-canvas tabindex="-1" aria-label="Noun Drip. Tap any Noun, or use D, F, J to pop a Noun in each column."></div><div class="drip-particles" data-drip-particles aria-hidden="true"></div><div class="drip-floor" aria-hidden="true"><span>D · 1</span><span>F · 2</span><span>J · 3</span></div></div>
    <div class="drip-parade" aria-hidden="true"><span class="drip-parade-sign">YOUR PARADE →</span><div data-drip-parade></div><span class="drip-parade-heart">♥</span></div>
    <div class="flow-callout" data-flow-feedback role="status" aria-live="polite">Find your rhythm.</div>
    <div class="flow-ready"><span class="flow-kicker">INSERT A LITTLE WONDER</span><h1><small>NOUNS:</small><b data-flow-game-title>DRIP</b><span aria-hidden="true">✦</span></h1><p data-flow-ready-copy>Tap any Noun.<br/> Let the good feelings pop.</p><div class="flow-ready-tip"><i>1</i><span data-flow-ready-tip-one>Tap a Noun anywhere on the stage.</span></div><div class="flow-ready-tip"><i>2</i><span data-flow-ready-tip-two>No rush. Every pop is a little win.</span></div><span class="flow-practice" data-flow-practice>TAP · TAB + ENTER · OR D / F / J</span></div>
    <div class="flow-pause-card"><span class="flow-kicker">TAKE A BREATH</span><h2 data-flow-pause-title>Your friends are right here.</h2><p>Resume when you’re ready.</p></div>
    <div data-flow-result class="flow-finish-card" hidden aria-live="polite"><div class="flow-finish-stars" aria-hidden="true"><span>✧</span><b>✦</b><span>✶</span></div><span class="flow-kicker" data-flow-result-kicker>NOUNS: STARJAM</span><h2 data-flow-result-title>You made it pop!</h2><p data-flow-result-copy></p><div class="flow-finish-actions"><button type="button" data-flow-restart>Encore ↻</button><button type="button" data-flow-next-world>Next world →</button></div></div>
    <progress data-flow-progress max="100" value="0" aria-label="Track progress"></progress>
  </main>
  <footer class="flow-deck"><div class="flow-arcade-sticker" aria-hidden="true"><img src="/images/co-games/roster/flower.svg" alt="" width="64" height="64"/><span>SMALL GAME.<br/>BIG GOOD FEELING.</span></div><div class="flow-deck-main"><div class="flow-pace-control"><label for="flow-pace">FIND YOUR FLOW</label><select id="flow-pace" aria-label="Find your flow" data-flow-pace><option value="drift">Drift · 72 BPM</option><option value="gentle" selected>Groove · 96 BPM</option><option value="playful">Arcade · 120 BPM</option></select></div><button type="button" data-flow-start class="flow-start">LET’S JAM <span>↗</span></button></div><nav><button type="button" data-flow-dialog="flow-worlds">✦ Worlds</button><span>FREE PLAY · NO DOWNLOAD</span><button type="button" data-flow-dialog="flow-help">How to jam ↗</button></nav></footer>
  <dialog id="flow-worlds" class="flow-dialog" aria-labelledby="flow-worlds-title"><form method="dialog"><button aria-label="Close worlds">×</button></form><span class="flow-kicker">A LITTLE STAR, A LONG WAY HOME</span><h2 id="flow-worlds-title">Choose your stage.</h2><div class="flow-world-grid">{Object.entries(coGameWorlds).map(([id,world])=><button type="button" data-flow-world={id}><img src={world.src} alt="" loading="lazy" width="360" height="180"/><span>0{world.chapter} / {world.name}</span><p>{world.story}</p></button>)}</div><p class="flow-small">Every world has its own note pattern and musical color.</p></dialog>
  <dialog id="flow-settings" class="flow-dialog" aria-labelledby="flow-settings-title"><form method="dialog"><button aria-label="Close sound settings">×</button></form><span class="flow-kicker">YOUR KIND OF ENERGY</span><h2 id="flow-settings-title">Make a little space.</h2><button type="button" data-flow-test-sound>♪ Test sound</button><p data-flow-audio-status class="flow-audio-status" role="status" aria-live="polite">Tap Test sound for a little welcome tune.</p><audio data-flow-speaker-test src="/audio/starjam/welcome.m4a" controls preload="metadata" aria-label="STARJAM welcome tune"></audio><p class="flow-small">Still quiet? <a href="/audio/starjam/welcome.m4a" target="_blank" rel="noopener">Open the tune directly ↗</a>. On iPhone, use the phone’s volume buttons and check the selected speaker or headphones.</p><label for="flow-volume">Volume <span data-flow-volume-value>35%</span></label><input data-flow-volume id="flow-volume" type="range" min="0" max="100" step="1" value="35"/><p class="flow-small">Drift is slow and spacious. Groove adds a soft pulse. Arcade brings more bounce. Choose your pace before a track.</p><button data-flow-haptics type="button" aria-pressed="false">Haptic taps · off</button><p data-flow-haptics-note class="flow-small">Optional on supported devices.</p><p class="flow-small">Sound starts with your tap. Opening a menu or leaving the page pauses the game. Reduced motion removes decorative movement; the moving notes remain part of play.</p></dialog>
  <dialog id="flow-help" class="flow-dialog" aria-labelledby="flow-help-title"><form method="dialog"><button aria-label="Close instructions">×</button></form><span class="flow-kicker">TWO LITTLE WAYS TO PLAY</span><h2 id="flow-help-title">Find your good feeling.</h2><h3>Noun Drip · Heartfire Parade</h3><p>Pop <b>12 Nouns in 35 seconds</b> to light the heartfire. Every pop earns a spark; each different friend joins your parade. At 4 sparks the crew gathers, at 8 the stage glows, and at 12 the finale is yours. Keep popping for a bonus until the music ends, then visit the next world.</p><p>Tap any Noun while it falls or after it settles. There are no missed-note penalties. Use <b>D / F / J</b> or <b>1 / 2 / 3</b> for the three columns, or Tab to a Noun and press Enter or Space.</p><h3>Rhythm</h3><ol><li>Start a track. Notes fall toward the three glowing pads.</li><li>Tap the matching pad when a note reaches the light. On a keyboard, use <b>D / F / J</b> or <b>1 / 2 / 3</b>.</li><li>Accurate hits damage the rivals and build your streak. Misses cost health. Your practice buddy helps as you land hits.</li><li>Beat the crew before the track ends. Then take your Nouns to the next world.</li></ol><p>Choose <b>Drift</b> for spacious music. Switching modes starts fresh. Pause whenever you like.</p><p class="flow-small">These games stay on your device. No prizes, purchases or public scores. <a href="/co-games">Explore spell battles</a>.</p><a href="https://nouns.wtf/traits" target="_blank" rel="noreferrer">Nouns artwork · CC0 ↗</a></dialog>
</div>
</article>
</BlockLayout>
<script>
import { mountNounsFlow } from '../../lib/nouns-flow-ui';
import { mountNounsFlowAudio } from '../../lib/nouns-flow-audio';
let cleanup: (() => void) | undefined;
function setup() {
  cleanup?.();
  const root = document.getElementById('nouns-flow');
  if (!root) return;
  const stopAudio = mountNounsFlowAudio(root);
  const stopFlow = mountNounsFlow(root);
  const abort = new AbortController();
  root.querySelectorAll<HTMLButtonElement>('[data-flow-dialog]').forEach(button => button.addEventListener('click', () => {
    const dialog = root.querySelector<HTMLDialogElement>(`#${button.dataset.flowDialog}`);
    dialog?.showModal();
    dialog?.addEventListener('close', () => button.focus(), { once:true, signal:abort.signal });
  }, {signal:abort.signal}));
  cleanup = () => { abort.abort(); stopFlow(); stopAudio(); };
}
setup();
document.addEventListener('astro:page-load', setup);
document.addEventListener('astro:before-swap', () => {cleanup?.();cleanup=undefined;});
</script>
