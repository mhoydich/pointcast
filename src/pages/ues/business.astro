---
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/ues-business.css';
import casebook from '../../data/ues-business-cases.json';
const title = 'Business studies · University of El Segundo';
const description = 'Open local business studies from the University of El Segundo: coffee, regulated retail, evidence, operating models, and a private case-study worksheet.';
const comparisons = [
  ['Customer need', 'Routine, hospitality, taste, convenience', 'Regulated adult retail; demand must be studied within legal boundaries'],
  ['Revenue model', 'Café transactions, beans, wholesale, subscriptions', 'Licensed retail transactions; jurisdiction and license type constrain the model'],
  ['Inventory evidence', 'Public menu or online bean catalog; dated partial assortment', 'Published licensed-store catalog; dated partial inventory'],
  ['Operating bottleneck', 'Labor, throughput, rent, green-coffee cost, waste', 'Licensing, compliance, taxes, labor, rent, product traceability'],
  ['What a map can establish', 'Approximate café/roaster address and distance', 'License-record location and status at the source snapshot'],
  ['What a map cannot establish', 'Live stock, an open door, quality, margins, endorsement', 'Live stock, an open door, total sales, safety, endorsement'],
];
const lessons = [
  ['Start with the customer', 'Describe one recurring problem and the purchase occasion. Separate residents, workers, visitors, online buyers, and business accounts before estimating demand.'],
  ['Draw the operating chain', 'Trace supplier → production → distribution → customer. Name who holds inventory, pays labor, absorbs waste, and carries regulatory obligations.'],
  ['Measure contribution', 'Revenue is not income. Distinguish variable cost, contribution, fixed expense, cash timing, startup spending, tax, debt, and owner compensation.'],
  ['Read scale carefully', 'A city, a county, a state, and a national market are different units. Keep every statistic’s geography, reference period, denominator, and method attached.'],
  ['Change one assumption', 'Build a base case, then reduce volume or raise input costs. Ask which operating choice still works when the optimistic assumption disappears.'],
  ['Publish the boundary', 'List sources, unknowns, and the observation date. Make a useful lesson without turning a sample of shops into a claim about the whole market.'],
];
---
<BlockLayout title={title} description={description} image="/images/ues-business/coffee-field.webp" hideAds jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:title,url:'https://pointcast.xyz/ues/business',isPartOf:{'@type':'EducationalOrganization',name:'University of El Segundo',url:'https://pointcast.xyz/university-of-el-segundo'}}}>
  <main class="study">
    <header class="top"><a class="mark" href="/university-of-el-segundo">UNIVERSITY OF EL SEGUNDO</a><nav aria-label="Business studies"><a href="#cases">Case studies</a><a href="#lessons">Lessons</a><a href="#worksheet">Worksheet</a><a href="/ues">Classes</a><a href="/">PointCast</a></nav></header>
    <section class="hero" aria-labelledby="business-title"><img src="/images/ues-business/coffee-field.webp" alt="" width="1672" height="941" fetchpriority="high" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">LOCAL INQUIRY · OPEN BUSINESS STUDIES</p><h1 id="business-title">A business<br />is a system<br />in a place.</h1><p class="dek">Read the shops around El Segundo as operating models: how value is made, what it costs, and what public evidence can actually tell us.</p><div class="actions"><a class="button" href="#cases">Explore the cases</a><a class="button secondary" href="#worksheet">Make a private study</a></div></div></div></section>
    <div class="band"><div class="wrap"><p><b>University of El Segundo</b> · An independent, unaccredited learning project. Open educational studies; no credential, investment recommendation, company affiliation, or endorsement. First edition observed October 3, 2026.</p></div></div>
    <div class="wrap">
      <section class="content" id="cases"><header class="section-head"><div><p class="eyebrow">01 · THE LOCAL CASEBOOK</p><h2>One region.<br />Different business rules.</h2></div><p>Begin with a bounded field sample. Follow its sources, inspect its operating assumptions, then ask what another neighborhood would change.</p></header><div class="grid">
        {casebook.cases.map(study=><article class="card"><span class="number">CASE {study.number} · {study.name.toUpperCase()}</span><h3>{study.title}</h3><p>{study.summary}</p>{study.href ? <a class="button" href={study.href}>{study.actionLabel}</a> : <><span class="status">{study.state}</span><p class="meta">{study.note}</p></>}</article>)}
      </div></section>
      <section class="content" id="comparison"><header class="section-head"><div><p class="eyebrow">02 · COMPARATIVE METHOD</p><h2>Compare the mechanics.</h2></div><p>A coffee shop and a dispensary can share a street and still operate under very different constraints. These are teaching dimensions, not measured company results.</p></header><div class="table-wrap"><table><caption class="eyebrow">Coffee and regulated retail · conceptual comparison</caption><thead><tr><th scope="col">Dimension</th><th scope="col">Coffee</th><th scope="col">Dispensary study</th></tr></thead><tbody>{comparisons.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div></section>
      <section class="content" id="lessons"><header class="section-head"><div><p class="eyebrow">03 · A SMALL BUSINESS SCHOOL</p><h2>Six useful habits.</h2></div><p>Use public documents, arithmetic, and respectful observation. A desk study is a complete path; visiting a store or buying anything is optional.</p></header><ol class="teaching">{lessons.map(lesson=><li><div><h3>{lesson[0]}</h3><p>{lesson[1]}</p></div></li>)}</ol></section>
      <section class="content" id="worksheet"><header class="section-head"><div><p class="eyebrow">04 · YOUR CASE STUDY</p><h2>Leave with a question<br />you can test.</h2></div><p>Write a one-page study. These fields stay on this page and export only when you choose. The worksheet does not save your notes; download before leaving.</p></header><form id="business-worksheet"><div class="grid">{[
        ['business','Business or model','Example: neighborhood café + wholesale beans'],
        ['customer','Customer and occasion','Who returns, and why?'],
        ['evidence','Evidence with dates and source links','Separate observations from assumptions.'],
        ['economics','Operating assumptions','Ticket, volume, variable cost, labor, rent, cash timing.'],
        ['sensitivity','What would change the conclusion?','Test lower volume, higher cost, or a delayed payment.'],
        ['question','Next research question','Name an unknown and a source that could answer it.'],
      ].map(field=><label class="card">{field[1]}<textarea name={field[0]} rows="4" placeholder={field[2]} style="display:block;width:100%;margin-top:12px;padding:12px;border:1px solid #a4b09c;background:#fffdf7;font:14px Inter,Arial,sans-serif;resize:vertical;min-height:110px"></textarea></label>)}</div><div class="actions"><button id="worksheet-download" type="button" disabled>Download my study (.txt)</button></div><noscript><p class="note">Enable JavaScript to write and export this worksheet. The download button stays disabled so notes cannot be submitted through a URL.</p></noscript><p id="worksheet-status" role="status" aria-live="polite" class="meta">Notes are not saved automatically.</p></form></section>
      <section class="content"><header class="section-head"><div><p class="eyebrow">05 · TWO EXISTING HOMES</p><h2>PointCast × IndustryNext.</h2></div><p>PointCast holds the local research and UES casebook. The existing IndustryNext Communications Lab is the proposed companion for study worksheets and applied communication exercises.</p></header><div class="grid"><article class="card"><h3>The research home</h3><p>Study the source record, map, published market context, and clearly labeled calculations here.</p><a href="/ues/coffee">Coffee atlas and operating models →</a></article><article class="card"><h3>The applied companion</h3><p>IndustryNext’s current Communications Lab provides the natural destination for turning evidence into a clear business brief. A dedicated business-study companion is planned and awaits review.</p><a href="https://www.industrynext.xyz/communications-lab/" target="_blank" rel="noopener noreferrer">Visit the existing IndustryNext Communications Lab ↗</a></article></div></section>
      <footer>Original AI-generated coffee collage, October 3, 2026. Abstract illustration; it depicts no actual business. Research, examples, and curricula are independent editorial work. <a href="/ues/coffee#method">Read the coffee methodology</a> · <a href="/ues">Return to UES classes</a>.</footer>
    </div>
  </main>
</BlockLayout>
<script>
  function setupBusinessWorksheet() {
    const form = document.querySelector<HTMLFormElement>('#business-worksheet');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    form.addEventListener('submit',event=>event.preventDefault());
    const download = form.querySelector<HTMLButtonElement>('#worksheet-download')!;
    download.disabled = false;
    download.addEventListener('click',()=>{
      const data = new FormData(form);
      const headings: Record<string,string> = { business:'Business or model',customer:'Customer and occasion',evidence:'Evidence and sources',economics:'Operating assumptions',sensitivity:'Sensitivity',question:'Next research question' };
      const content = 'University of El Segundo · Private business study\nCreated '+new Date().toISOString()+'\n\n'+Object.entries(headings).map(([key,label])=>label+'\n'+String(data.get(key)||'').trim()).join('\n\n')+'\n\nSelf-authored educational worksheet. Assumptions are not actual company results.\n';
      const url = URL.createObjectURL(new Blob([content],{type:'text/plain;charset=utf-8'}));
      const link = document.createElement('a'); link.href=url; link.download='ues-business-study.txt'; link.click();
      window.setTimeout(()=>URL.revokeObjectURL(url),1000);
      document.querySelector('#worksheet-status')!.textContent='Your study download has been prepared. Keep the file before leaving this page.';
    });
  }
  setupBusinessWorksheet(); document.addEventListener('astro:page-load',setupBusinessWorksheet);
</script>
