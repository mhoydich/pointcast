---
import BlockLayout from '../../layouts/BlockLayout.astro';
import content from '../../components/ues-currency-lab/lab.html?raw';
const title = 'Small paper. Big ideas. · UES Currency Lab';
const description = 'Four hands-on experiments in meaning, graphic design, printed identifiers, and collectible art. Make a Nouns art note and finish a printable project brief.';
---
<BlockLayout title={title} description={description} isolated={true} themeColor="#f6f0e3" jsonLd={{'@context':'https://schema.org','@type':'LearningResource',name:title,description,url:'https://pointcast.xyz/ues/currency-lab/',learningResourceType:'Interactive learning lab',isAccessibleForFree:true,inLanguage:'en',educationalUse:'Self-paced making and reflection'}}>
  <link rel="stylesheet" href="/assets/ues-currency-lab/lab.css" />
  <Fragment set:html={content} />
  <script is:inline type="module" src="/assets/ues-currency-lab/lab.mjs"></script>
</BlockLayout>
