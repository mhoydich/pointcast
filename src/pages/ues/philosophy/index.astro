---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { UES_PHILOSOPHY as series } from '../../../lib/ues-philosophy';
import '../../../styles/ues-philosophy.css';

const title = series.title;
const description = series.dek;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': series.human,
  name: title,
  description,
  url: series.human,
  isPartOf: {
    '@type': 'EducationalOrganization',
    name: 'University of El Segundo',
    url: 'https://pointcast.xyz/university-of-el-segundo',
  },
  hasPart: series.seminars.filter((item) => item.status === 'published').map((item) => ({
    '@type': 'Article',
    '@id': item.human,
    name: item.title,
    url: item.human,
    identifier: item.id,
  })),
};
---

<BlockLayout
  title={title}
  description={description}
  author="New Bot"
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/ues/philosophy.json', title: 'Philosophy series JSON' }]}
>
  <article class="seminar">
    <header class="top">
      <a class="mark" href="/university-of-el-segundo">UNIVERSITY OF EL SEGUNDO</a>
      <nav aria-label="Philosophy">
        <a href="/ues/philosophy/no-degrees-only-receipts/">001</a>
        <a href="/ues/philosophy/the-radius-as-pedagogy/">002</a>
        <a href="/ues">Classes</a>
        <a href="/ues/philosophy.json">JSON</a>
        <a href="/">PointCast</a>
      </nav>
    </header>
    <div class="wrap">
      <header class="hero">
        <p class="eyebrow">{series.kicker} · {series.id}</p>
        <h1>Short seminars for a campus with no campus.</h1>
        <p class="dek">{series.dek}</p>
        <p class="byline">Drafted by New Bot, Mike Hoydich’s assistant. Mike Hoydich publishes. El Segundo is the classroom. These are not degrees.</p>
        <div class="actions">
          <a class="button" href="#catalog">Read the catalog</a>
          <a class="button secondary" href="/ues/philosophy.json">Fetch the JSON</a>
        </div>
      </header>
      <div class="band">
        {series.framing.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <section class="piece" id="catalog">
        <p class="eyebrow">CATALOG</p>
        <h2>Two seminars, and a next shelf.</h2>
        <div class="grid">
          {series.seminars.map((item) => (
            <article class:list={['card', item.status]} id={item.id}>
              <span class="status">{item.number} · {item.status} · {item.id}</span>
              <h3>{item.title}</h3>
              <p>{item.dek}</p>
              {item.status === 'published' && item.human && (
                <p><a href={item.human.replace('https://pointcast.xyz', '')}>Read the seminar</a> · <a href={item.json?.replace('https://pointcast.xyz', '')}>JSON</a></p>
              )}
            </article>
          ))}
        </div>
      </section>
      <footer class="colophon">
        <p>CC0-flavored. Part of <a href="/university-of-el-segundo">the University of El Segundo</a>. The radius policy lives in <a href="/areas">/areas</a> and <a href="/ues/radius">RADIUS / 90245</a>. The open-build survey is <a href="/grok/case-study/">on the grok page</a>.</p>
      </footer>
    </div>
  </article>
</BlockLayout>
