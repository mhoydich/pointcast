---
import BlockLayout from '../../layouts/BlockLayout.astro';
import gallery from '../../data/el-segundo-school-gallery.json';
import {
  RADIUS_CENTER,
  RADIUS_PACKET,
  RADIUS_PRESETS,
  RADIUS_SOURCES,
  calculateRadiusLink,
} from '../../lib/radius-90245';

const title = 'RADIUS / 90245';
const description = 'A live RF field bench for El Segundo: tune a free-space link across the University of El Segundo 25-mile layer, inspect the math, hear the margin, and share the experiment.';
const defaultLink = calculateRadiusLink(RADIUS_PRESETS[1]);
const archiveOrigin = 'https://el-segundo-school-archive.pages.dev';
const ogWork = gallery.works.find((work) => work.number === '253') ?? gallery.works[0];
const ogImage = ogWork ? `${archiveOrigin}${ogWork.src.replace('/images/el-segundo-school', '')}` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': RADIUS_PACKET.canonical,
  name: RADIUS_PACKET.name,
  description,
  url: RADIUS_PACKET.canonical,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any modern browser',
  isPartOf: {
    '@type': 'EducationalOrganization',
    name: 'University of El Segundo',
    url: 'https://pointcast.xyz/university-of-el-segundo',
  },
  spatialCoverage: {
    '@type': 'Place',
    name: RADIUS_CENTER.name,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: RADIUS_CENTER.latitude,
      longitude: RADIUS_CENTER.longitude,
    },
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image={ogImage}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/ues/radius.json', title: 'RADIUS / 90245 machine packet' }]}
>
  <main class="radius" id="radius-90245">
    <header class="topbar">
      <a class="mark" href="/university-of-el-segundo">UNIVERSITY OF EL SEGUNDO</a>
      <nav aria-label="Radius navigation">
        <a href="#bench">Bench</a>
        <a href="#formulas">Method</a>
        <a href="/ues/radius.json">JSON</a>
        <a href="/">PointCast</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="radius-title">
      <div class="hero-copy">
        <p class="eyebrow">FIELD INSTRUMENT 01 · 33.9192° N · 118.4165° W</p>
        <h1 id="radius-title"><span>RADIUS</span><b>/ 90245</b></h1>
        <p class="dek">
          A free-space radio bench centered on El Segundo. Move a receiver through the 25-mile
          field layer. Change the carrier, power, gain, bandwidth, and losses. Watch the geometry
          become a link budget—and listen when the margin disappears.
        </p>
        <div class="hero-actions">
          <a class="primary" href="#bench">Open the field bench</a>
          <button type="button" id="sound-toggle" aria-pressed="false">Hear the signal</button>
          <button type="button" id="share-link">Copy experiment</button>
        </div>
        <p class="share-status" id="share-status" aria-live="polite"></p>
      </div>

      <div class="scope-card">
        <div class="scope-card__head">
          <span>LOCAL REASON</span>
          <i>01</i>
        </div>
        <p>
          Space Systems Command is headquartered in El Segundo. The local engineering culture
          works in links, interfaces, mission threads, networks, and data flows. This is a small
          public instrument in that language—not a recruiting brochure.
        </p>
        <a href={RADIUS_SOURCES[2].url} target="_blank" rel="noreferrer">Primary source · SSC Command Plan ↗</a>
      </div>
    </section>

    <section class="weather-strip" aria-label="Live El Segundo context">
      <div><span>EL SEGUNDO AIR</span><strong id="live-temperature">FETCHING</strong></div>
      <div><span>WIND</span><strong id="live-wind">—</strong></div>
      <div><span>CLOUD</span><strong id="live-cloud">—</strong></div>
      <div><span>MODEL USE</span><strong>CONTEXT ONLY</strong></div>
      <p>Live weather is shown but is not inserted into the free-space equations.</p>
    </section>

    <section class="bench" id="bench" aria-labelledby="bench-title">
      <div class="bench-heading">
        <div>
          <p class="eyebrow">THE 25-MILE LAYER</p>
          <h2 id="bench-title">Move one hypothetical link through the field.</h2>
        </div>
        <p>
          The calculator is deterministic and client-side. Nothing is transmitted. No location,
          settings, or audio leaves this browser.
        </p>
      </div>

      <div class="instrument">
        <div class="radar-column">
          <div class="radar" id="radar" data-state={defaultLink.linkState}>
            <div class="radar-grid" aria-hidden="true"></div>
            <div class="radar-ring radar-ring--25"><span>25 MI</span></div>
            <div class="radar-ring radar-ring--15"><span>15</span></div>
            <div class="radar-ring radar-ring--5"><span>5</span></div>
            <div class="radar-beam" id="radar-beam" aria-hidden="true"></div>
            <div class="radar-path" id="radar-path" aria-hidden="true"></div>
            <div class="radar-target" id="radar-target" aria-hidden="true"><span></span></div>
            <div class="radar-origin"><b>ES</b><span>90245</span></div>
            <span class="direction direction--n">LAX / N</span>
            <span class="direction direction--e">INLAND / E</span>
            <span class="direction direction--s">SOUTH BAY / S</span>
            <span class="direction direction--w">PACIFIC / W</span>
            <canvas id="signal-canvas" width="720" height="720" aria-hidden="true"></canvas>
          </div>

          <label class="bearing-control">
            <span><b>BEARING</b><output id="bearing-value">238°</output></span>
            <input id="bearing" type="range" min="0" max="359" value="238" step="1" aria-label="Receiver bearing in degrees" />
          </label>
          <p class="radar-readout" id="radar-readout" aria-live="polite">
            Receiver 4.50 miles from El Segundo at bearing 238°.
          </p>
        </div>

        <form class="controls" id="radius-controls" onsubmit="return false">
          <fieldset class="presets">
            <legend>STARTING CONDITIONS</legend>
            {RADIUS_PRESETS.map((preset, index) => (
              <button
                type="button"
                data-radius-preset={preset.id}
                aria-pressed={index === 1 ? 'true' : 'false'}
              >
                <b>{preset.label}</b>
                <span>{preset.kicker}</span>
              </button>
            ))}
          </fieldset>

          <div class="control-grid">
            <label>
              <span>DISTANCE <output id="distance-value">4.50 mi</output></span>
              <input id="distance" type="range" min="0.1" max="25" value="4.5" step="0.1" />
            </label>
            <label>
              <span>FREQUENCY <output id="frequency-value">5.800 GHz</output></span>
              <input id="frequency" type="range" min="0.1" max="40" value="5.8" step="0.05" />
            </label>
            <label>
              <span>TRANSMIT POWER <output id="power-value">26.0 dBm</output></span>
              <input id="power" type="range" min="-20" max="60" value="26" step="0.5" />
            </label>
            <label>
              <span>COMBINED GAIN <output id="gain-value">28.0 dBi</output></span>
              <input id="gain" type="range" min="-10" max="80" value="28" step="0.5" />
            </label>
            <label>
              <span>BANDWIDTH <output id="bandwidth-value">20.00 MHz</output></span>
              <input id="bandwidth" type="range" min="0.01" max="200" value="20" step="0.01" />
            </label>
            <label>
              <span>NOISE FIGURE <output id="noise-value">6.0 dB</output></span>
              <input id="noise" type="range" min="0" max="30" value="6" step="0.5" />
            </label>
            <label class="control-grid__wide">
              <span>OTHER LOSSES <output id="loss-value">12.0 dB</output></span>
              <input id="loss" type="range" min="0" max="80" value="12" step="0.5" />
            </label>
          </div>
          <p class="preset-note" id="preset-note">{RADIUS_PRESETS[1].note}</p>
        </form>
      </div>
    </section>

    <section class="results" aria-labelledby="results-title">
      <div class="results-head">
        <p class="eyebrow">CALCULATED NOW</p>
        <h2 id="results-title">The answer, with the assumptions still attached.</h2>
        <div class="link-state" id="link-state" data-state={defaultLink.linkState}>
          <span>LINK STATE</span><strong>{defaultLink.linkState.toUpperCase()}</strong>
        </div>
      </div>

      <div class="result-grid">
        <article class="result-card result-card--hero">
          <span>FREE-SPACE PATH LOSS</span>
          <strong id="result-fspl">{defaultLink.freeSpacePathLossDb.toFixed(2)}</strong>
          <b>dB</b>
          <p>Geometric spreading only. The core reference number.</p>
        </article>
        <article class="result-card">
          <span>RECEIVED POWER</span>
          <strong id="result-rx">{defaultLink.receivedPowerDbm.toFixed(2)}</strong>
          <b>dBm</b>
          <p>After combined antenna gain and the entered extra losses.</p>
        </article>
        <article class="result-card">
          <span>THERMAL NOISE FLOOR</span>
          <strong id="result-noise">{defaultLink.noiseFloorDbm.toFixed(2)}</strong>
          <b>dBm</b>
          <p>At the selected bandwidth and receiver noise figure.</p>
        </article>
        <article class="result-card">
          <span>SNR</span>
          <strong id="result-snr">{defaultLink.snrDb.toFixed(2)}</strong>
          <b>dB</b>
          <p>A reference margin above the modeled noise floor.</p>
        </article>
        <article class="result-card">
          <span>SHANNON CEILING</span>
          <strong id="result-capacity">{defaultLink.shannonCapacityMbps.toFixed(2)}</strong>
          <b>Mb/s</b>
          <p>An ideal upper bound—not a modulation or protocol promise.</p>
        </article>
        <article class="result-card">
          <span>ONE-WAY LIGHT TIME</span>
          <strong id="result-delay">{defaultLink.propagationDelayMicroseconds.toFixed(2)}</strong>
          <b>μs</b>
          <p>Vacuum propagation only, before any system latency.</p>
        </article>
        <article class="result-card">
          <span>MIDPOINT FRESNEL RADIUS</span>
          <strong id="result-fresnel">{defaultLink.firstFresnelRadiusMeters.toFixed(2)}</strong>
          <b>m</b>
          <p>First-zone radius at the path midpoint.</p>
        </article>
        <article class="result-card">
          <span>WAVELENGTH</span>
          <strong id="result-wavelength">{(defaultLink.wavelengthMeters * 100).toFixed(2)}</strong>
          <b>cm</b>
          <p>The physical scale behind the carrier frequency.</p>
        </article>
      </div>
    </section>

    <section class="trace" aria-labelledby="trace-title">
      <div>
        <p class="eyebrow">SIGNAL TRACE</p>
        <h2 id="trace-title">A tone is not proof.</h2>
        <p>
          “Hear the signal” maps modeled SNR to a restrained tone plus noise. It is a sonification,
          not captured RF, a modem, or a prediction of real packet performance.
        </p>
      </div>
      <div class="trace-screen" aria-hidden="true">
        <div id="trace-bars"></div>
        <span>MODELED SNR → SOUND</span>
      </div>
    </section>

    <section class="method" id="formulas" aria-labelledby="method-title">
      <div class="method-copy">
        <p class="eyebrow">METHOD / LIMITS</p>
        <h2 id="method-title">Useful precisely because it refuses to pretend.</h2>
        <p>
          This bench models free-space geometry, thermal noise, and an ideal information ceiling.
          It does not model terrain, structures, foliage, multipath, polarization mismatch,
          antenna pattern, hardware linearity, interference, atmospheric absorption, rain fade,
          Earth curvature, regulation, exposure limits, or installation safety.
        </p>
        <p class="boundary">EDUCATIONAL REFERENCE ONLY · NOT A SITE SURVEY · NOT SPECTRUM AUTHORIZATION · NOT DEPLOYMENT ADVICE</p>
      </div>
      <ol class="formula-list">
        <li><span>01</span><div><b>Free-space path loss</b><code>92.45 + 20 log₁₀(d km) + 20 log₁₀(f GHz)</code></div></li>
        <li><span>02</span><div><b>Received power</b><code>Ptx + antenna gain − other loss − FSPL</code></div></li>
        <li><span>03</span><div><b>Noise floor</b><code>−174 + 10 log₁₀(B Hz) + NF</code></div></li>
        <li><span>04</span><div><b>Shannon ceiling</b><code>B × log₂(1 + SNRlinear)</code></div></li>
        <li><span>05</span><div><b>First Fresnel midpoint</b><code>√(λ × distance / 4)</code></div></li>
        <li><span>06</span><div><b>Light time</b><code>distance / 299,792,458 m/s</code></div></li>
      </ol>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <div>
        <p class="eyebrow">PRIMARY SOURCES</p>
        <h2 id="sources-title">Open the references. Challenge the instrument.</h2>
      </div>
      <div class="source-list">
        {RADIUS_SOURCES.map((source) => (
          <a href={source.url} target="_blank" rel="noreferrer">
            <span>{source.id}</span><b>{source.title}</b><p>{source.use}</p><i>↗</i>
          </a>
        ))}
        <a href="/ues/radius.json">
          <span>machine</span><b>RADIUS / 90245 JSON packet</b><p>Presets, equations, center, source links, and boundary.</p><i>→</i>
        </a>
      </div>
    </section>

    <footer class="radius-footer">
      <p>RADIUS / 90245 · UNIVERSITY OF EL SEGUNDO · POINTCAST · 2026</p>
      <nav aria-label="Radius footer">
        <a href="/university-of-el-segundo">University program</a>
        <a href="/ues">Course rooms</a>
        <a href="/el-segundo-school">Art archive</a>
        <a href="/">PointCast</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<script>
  import {
    RADIUS_PRESETS,
    calculateRadiusLink,
    normalizeRadiusInput,
    radiusInputFromSearch,
    serializeRadiusInput,
  } from '../../lib/radius-90245';

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const controls = {
    distanceMiles: byId<HTMLInputElement>('distance'),
    frequencyGHz: byId<HTMLInputElement>('frequency'),
    transmitPowerDbm: byId<HTMLInputElement>('power'),
    combinedGainDbi: byId<HTMLInputElement>('gain'),
    bandwidthMHz: byId<HTMLInputElement>('bandwidth'),
    noiseFigureDb: byId<HTMLInputElement>('noise'),
    extraLossDb: byId<HTMLInputElement>('loss'),
  };
  const outputs = {
    distanceMiles: byId<HTMLOutputElement>('distance-value'),
    frequencyGHz: byId<HTMLOutputElement>('frequency-value'),
    transmitPowerDbm: byId<HTMLOutputElement>('power-value'),
    combinedGainDbi: byId<HTMLOutputElement>('gain-value'),
    bandwidthMHz: byId<HTMLOutputElement>('bandwidth-value'),
    noiseFigureDb: byId<HTMLOutputElement>('noise-value'),
    extraLossDb: byId<HTMLOutputElement>('loss-value'),
  };
  const bearing = byId<HTMLInputElement>('bearing');
  const radar = byId<HTMLElement>('radar');
  const target = byId<HTMLElement>('radar-target');
  const beam = byId<HTMLElement>('radar-beam');
  const canvas = byId<HTMLCanvasElement>('signal-canvas');
  const ctx = canvas?.getContext('2d') ?? null;
  const soundToggle = byId<HTMLButtonElement>('sound-toggle');
  const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-radius-preset]'));
  let audioContext: AudioContext | null = null;
  let tone: OscillatorNode | null = null;
  let toneGain: GainNode | null = null;
  let noiseSource: AudioBufferSourceNode | null = null;
  let noiseGain: GainNode | null = null;
  let soundEnabled = false;
  let lastResult = calculateRadiusLink(RADIUS_PRESETS[1]);
  let animationFrame = 0;
  let phase = 0;

  const readInput = () => normalizeRadiusInput({
    distanceMiles: Number(controls.distanceMiles?.value),
    frequencyGHz: Number(controls.frequencyGHz?.value),
    transmitPowerDbm: Number(controls.transmitPowerDbm?.value),
    combinedGainDbi: Number(controls.combinedGainDbi?.value),
    bandwidthMHz: Number(controls.bandwidthMHz?.value),
    noiseFigureDb: Number(controls.noiseFigureDb?.value),
    extraLossDb: Number(controls.extraLossDb?.value),
  });

  function setText(id: string, value: string) {
    const element = byId(id);
    if (element) element.textContent = value;
  }

  function applyInput(input: ReturnType<typeof normalizeRadiusInput>) {
    for (const [key, control] of Object.entries(controls)) {
      if (control) control.value = String(input[key as keyof typeof input]);
    }
    update();
  }

  function updateRadar(result: typeof lastResult) {
    const angle = Number(bearing?.value ?? 238);
    const radial = Math.max(0.04, result.distanceMiles / 25) * 42;
    const radians = (angle - 90) * Math.PI / 180;
    const x = 50 + Math.cos(radians) * radial;
    const y = 50 + Math.sin(radians) * radial;
    if (target) {
      target.style.left = `${x}%`;
      target.style.top = `${y}%`;
    }
    if (beam) beam.style.transform = `rotate(${angle}deg)`;
    if (radar) radar.dataset.state = result.linkState;
    setText('bearing-value', `${Math.round(angle)}°`);
    setText('radar-readout', `Receiver ${result.distanceMiles.toFixed(2)} miles from El Segundo at bearing ${Math.round(angle)}°.`);
  }

  function updateSound(result: typeof lastResult) {
    if (!soundEnabled || !audioContext || !tone || !toneGain || !noiseGain) return;
    const normalizedSnr = Math.max(0, Math.min(1, (result.snrDb + 10) / 50));
    const now = audioContext.currentTime;
    tone.frequency.setTargetAtTime(110 + normalizedSnr * 550 + result.frequencyGHz * 2, now, 0.06);
    toneGain.gain.setTargetAtTime(0.012 + normalizedSnr * 0.045, now, 0.08);
    noiseGain.gain.setTargetAtTime(0.04 * (1 - normalizedSnr), now, 0.08);
  }

  function updateTrace(result: typeof lastResult) {
    const holder = byId('trace-bars');
    if (!holder) return;
    const count = 48;
    const normalizedSnr = Math.max(0, Math.min(1, (result.snrDb + 10) / 50));
    holder.replaceChildren(...Array.from({ length: count }, (_, index) => {
      const bar = document.createElement('i');
      const wave = Math.sin(index * 0.62 + result.frequencyGHz) * 0.5 + 0.5;
      const noise = Math.sin(index * 3.71 + result.distanceMiles) * (1 - normalizedSnr);
      bar.style.height = `${12 + Math.max(0, wave * normalizedSnr + noise * 0.45) * 78}%`;
      return bar;
    }));
  }

  function update() {
    lastResult = calculateRadiusLink(readInput());
    if (outputs.distanceMiles) outputs.distanceMiles.textContent = `${lastResult.distanceMiles.toFixed(2)} mi`;
    if (outputs.frequencyGHz) outputs.frequencyGHz.textContent = `${lastResult.frequencyGHz.toFixed(3)} GHz`;
    if (outputs.transmitPowerDbm) outputs.transmitPowerDbm.textContent = `${lastResult.transmitPowerDbm.toFixed(1)} dBm`;
    if (outputs.combinedGainDbi) outputs.combinedGainDbi.textContent = `${lastResult.combinedGainDbi.toFixed(1)} dBi`;
    if (outputs.bandwidthMHz) outputs.bandwidthMHz.textContent = `${lastResult.bandwidthMHz.toFixed(2)} MHz`;
    if (outputs.noiseFigureDb) outputs.noiseFigureDb.textContent = `${lastResult.noiseFigureDb.toFixed(1)} dB`;
    if (outputs.extraLossDb) outputs.extraLossDb.textContent = `${lastResult.extraLossDb.toFixed(1)} dB`;
    setText('result-fspl', lastResult.freeSpacePathLossDb.toFixed(2));
    setText('result-rx', lastResult.receivedPowerDbm.toFixed(2));
    setText('result-noise', lastResult.noiseFloorDbm.toFixed(2));
    setText('result-snr', lastResult.snrDb.toFixed(2));
    setText('result-capacity', lastResult.shannonCapacityMbps >= 1000
      ? `${(lastResult.shannonCapacityMbps / 1000).toFixed(2)}k`
      : lastResult.shannonCapacityMbps.toFixed(2));
    setText('result-delay', lastResult.propagationDelayMicroseconds.toFixed(2));
    setText('result-fresnel', lastResult.firstFresnelRadiusMeters.toFixed(2));
    setText('result-wavelength', (lastResult.wavelengthMeters * 100).toFixed(2));
    const state = byId('link-state');
    if (state) {
      state.dataset.state = lastResult.linkState;
      const label = state.querySelector('strong');
      if (label) label.textContent = lastResult.linkState.replace('-', ' ').toUpperCase();
    }
    updateRadar(lastResult);
    updateTrace(lastResult);
    updateSound(lastResult);
  }

  for (const control of Object.values(controls)) control?.addEventListener('input', () => {
    presetButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
    setText('preset-note', 'Custom field condition. Copy the experiment to preserve these values.');
    update();
  });
  bearing?.addEventListener('input', () => updateRadar(lastResult));

  presetButtons.forEach((button) => button.addEventListener('click', () => {
    const preset = RADIUS_PRESETS.find((item) => item.id === button.dataset.radiusPreset);
    if (!preset) return;
    presetButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    setText('preset-note', preset.note);
    applyInput(preset);
  }));

  byId<HTMLButtonElement>('share-link')?.addEventListener('click', async () => {
    const url = new URL(window.location.href);
    url.search = serializeRadiusInput(readInput()).toString();
    url.searchParams.set('a', String(Math.round(Number(bearing?.value ?? 238))));
    try {
      await navigator.clipboard.writeText(url.toString());
      setText('share-status', 'Experiment URL copied.');
    } catch {
      window.prompt('Copy this experiment URL', url.toString());
      setText('share-status', 'Experiment URL ready to copy.');
    }
  });

  async function startSound() {
    audioContext = new AudioContext();
    tone = audioContext.createOscillator();
    tone.type = 'sine';
    toneGain = audioContext.createGain();
    toneGain.gain.value = 0;
    tone.connect(toneGain).connect(audioContext.destination);
    tone.start();

    const buffer = audioContext.createBuffer(1, audioContext.sampleRate * 2, audioContext.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < data.length; i += 1) data[i] = Math.random() * 2 - 1;
    noiseSource = audioContext.createBufferSource();
    noiseSource.buffer = buffer;
    noiseSource.loop = true;
    noiseGain = audioContext.createGain();
    noiseGain.gain.value = 0;
    noiseSource.connect(noiseGain).connect(audioContext.destination);
    noiseSource.start();
    soundEnabled = true;
    if (soundToggle) {
      soundToggle.setAttribute('aria-pressed', 'true');
      soundToggle.textContent = 'Mute the signal';
    }
    updateSound(lastResult);
  }

  function stopSound() {
    soundEnabled = false;
    if (toneGain && audioContext) toneGain.gain.setTargetAtTime(0, audioContext.currentTime, 0.05);
    if (noiseGain && audioContext) noiseGain.gain.setTargetAtTime(0, audioContext.currentTime, 0.05);
    if (soundToggle) {
      soundToggle.setAttribute('aria-pressed', 'false');
      soundToggle.textContent = 'Hear the signal';
    }
  }

  soundToggle?.addEventListener('click', async () => {
    if (!audioContext) await startSound();
    else if (soundEnabled) stopSound();
    else {
      await audioContext.resume();
      soundEnabled = true;
      soundToggle.setAttribute('aria-pressed', 'true');
      soundToggle.textContent = 'Mute the signal';
      updateSound(lastResult);
    }
  });

  function draw() {
    if (!canvas || !ctx) return;
    const size = canvas.width;
    ctx.clearRect(0, 0, size, size);
    phase += 0.018;
    const stateColor = lastResult.linkState === 'strong'
      ? '83, 255, 170'
      : lastResult.linkState === 'workable'
        ? '220, 255, 63'
        : lastResult.linkState === 'edge'
          ? '255, 177, 46'
          : '255, 77, 77';
    const angle = (Number(bearing?.value ?? 238) - 90) * Math.PI / 180;
    const distanceRatio = lastResult.distanceMiles / 25;
    const radius = size * 0.42 * distanceRatio;
    const startX = size / 2;
    const startY = size / 2;
    const endX = startX + Math.cos(angle) * radius;
    const endY = startY + Math.sin(angle) * radius;
    ctx.strokeStyle = `rgba(${stateColor}, .22)`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(startX, startY);
    ctx.lineTo(endX, endY);
    ctx.stroke();
    for (let i = 0; i < 8; i += 1) {
      const progress = (phase + i / 8) % 1;
      const x = startX + (endX - startX) * progress;
      const y = startY + (endY - startY) * progress;
      ctx.fillStyle = `rgba(${stateColor}, ${0.15 + progress * 0.7})`;
      ctx.beginPath();
      ctx.arc(x, y, 2 + progress * 3, 0, Math.PI * 2);
      ctx.fill();
    }
    animationFrame = requestAnimationFrame(draw);
  }

  async function fetchWeather() {
    const endpoint = 'https://api.open-meteo.com/v1/forecast?latitude=33.9192&longitude=-118.4165&current=temperature_2m,wind_speed_10m,wind_direction_10m,cloud_cover&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=America%2FLos_Angeles';
    try {
      const response = await fetch(endpoint);
      if (!response.ok) throw new Error('weather unavailable');
      const payload = await response.json();
      const current = payload?.current;
      if (!current) throw new Error('weather unavailable');
      setText('live-temperature', `${Math.round(current.temperature_2m)}°F`);
      setText('live-wind', `${Math.round(current.wind_speed_10m)} MPH · ${Math.round(current.wind_direction_10m)}°`);
      setText('live-cloud', `${Math.round(current.cloud_cover)}%`);
    } catch {
      setText('live-temperature', 'OFFLINE');
      setText('live-wind', 'OFFLINE');
      setText('live-cloud', 'OFFLINE');
    }
  }

  const initialSearch = new URLSearchParams(window.location.search);
  if (initialSearch.has('d')) applyInput(radiusInputFromSearch(initialSearch));
  else update();
  const initialBearingValue = initialSearch.get('a');
  const initialBearing = initialBearingValue === null ? Number.NaN : Number(initialBearingValue);
  if (bearing && Number.isFinite(initialBearing)) bearing.value = String(Math.max(0, Math.min(359, initialBearing)));
  updateRadar(lastResult);
  void fetchWeather();
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(animationFrame);
    void audioContext?.close();
  }, { once: true });
</script>

