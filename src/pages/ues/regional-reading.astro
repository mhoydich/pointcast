---
import BlockLayout from '../../layouts/BlockLayout.astro';
import storiesData from '../../data/regional-reading/stories.json';
import { assertRegionalShelf, regionalStoryPath } from '../../lib/regional-reading.mjs';
import '../../styles/editorial-review.css';
const stories = assertRegionalShelf(storiesData);
---
<BlockLayout title="Read a place · UES" description="Sixteen source-based activities about culture, production, history and regional economies in Japan, China, Brazil and the United States." author="PointCast Editorial Desk / Codex" isolated immersive showNetworkStrip={false} jsonLd={null}>
  <main class="ed">
    <header class="mast"><a href="/ues">UNIVERSITY OF EL SEGUNDO</a><nav aria-label="Learning navigation"><a href="/reading/regions">PointCast reading shelf</a><a href="/ues/cartography-course">Cartography course</a></nav></header>
    <header class="hero"><div><p class="kicker">Independent learning / Regional reading</p><h1>Read a place.<br/>Make a question.</h1><p class="dek">Sixteen small activities turn four substantial regional stories into making maps, evidence cards and comparisons worth revisiting.</p></div><aside class="hero-plate"><span>FOUR COUNTRIES</span><strong>16</strong><span>Independent exercises. Inspectable sources. Something tangible to take away.</span></aside></header>
    <p class="note">UES is an independent community-learning project. These activities imply no accreditation, formal university status, institutional partnership or academic credit.</p>
    <nav class="jump" aria-label="Regional companions">{stories.map(story => <a href={`#${story.slug}`}>{story.country}</a>)}</nav>
    {stories.map(story => <section id={story.slug} class="prose"><p class="kicker">{story.country} / Sources checked {story.checkedDate}</p><h2>{story.companions.ues.title}</h2><p>{story.dek}</p>{(story.companions.ues.paragraphs || []).map(p => <p>{p}</p>)}<ol class="checklist">{story.companions.ues.prompts.map(p => <li>{p}</li>)}</ol><p><a href={regionalStoryPath(story)}>Read the complete PointCast story →</a></p><details><summary>Open the learning sources</summary><ul>{story.sources.filter(s => story.companions.ues.sourceIds?.includes(s.id)).map(s => <li><a href={s.url}>{s.title}</a> — {s.publisher}</li>)}</ul></details></section>)}
    <footer>Keep observations separate from interpretation. A national total is not a local outcome. Use public, appropriately licensed material.</footer>
  </main>
</BlockLayout>
