---
import BlockLayout from '../../layouts/BlockLayout.astro';
import atlas from '../../data/ues-coffee-atlas.json';
import economics from '../../data/ues-coffee-economics.json';
import { COFFEE_CENTER, coffeeMapPoint, calculateCafeScenario } from '../../lib/coffee-study.mjs';
import '../../styles/ues-business.css';
const title = 'Coffee / 25 miles · University of El Segundo';
const description = 'A sourced coffee atlas within 25 miles of El Segundo City Hall, with dated café and roaster assortments, accessible search, operating-model lessons, and illustrative economics.';
const records = atlas.records;
const money = (value:number)=>value.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
const base = calculateCafeScenario({ticket:7,orders:180,days:26,variablePercent:30,fixedCosts:19000})!;
const kinds = [...new Set(records.flatMap(record=>record.tags))].sort();
const cafe = economics.unit_economics.cafe;
---
<BlockLayout title={title} description={description} image="/images/ues-business/coffee-field.webp" hideAds alternates={[{type:'application/json',href:'/ues/coffee.json',title:'Coffee atlas and study sources'}]} jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:title,url:'https://pointcast.xyz/ues/coffee',isPartOf:{'@type':'EducationalOrganization',name:'University of El Segundo',url:'https://pointcast.xyz/university-of-el-segundo'},spatialCoverage:{'@type':'Place',name:COFFEE_CENTER.name,geo:{'@type':'GeoCoordinates',latitude:COFFEE_CENTER.latitude,longitude:COFFEE_CENTER.longitude}}}}>
  <main class="study" id="coffee-study">
    <header class="top"><a class="mark" href="/ues/business">UES · BUSINESS STUDIES</a><nav aria-label="Coffee study"><a href="#atlas">Atlas</a><a href="#models">Models</a><a href="#economics">Economics</a><a href="#context">Market context</a><a href="#method">Sources & method</a><a href="/ues">Classes</a></nav></header>
    <section class="hero" aria-labelledby="coffee-title"><img src="/images/ues-business/coffee-field.webp" alt="" width="1672" height="941" fetchpriority="high" /><div class="wrap"><div class="hero-copy"><p class="eyebrow">UNIVERSITY OF EL SEGUNDO · FIELD CASE 01</p><h1 id="coffee-title">Coffee.<br />Twenty-five<br />miles.</h1><p class="dek">The daily cup is a local ritual and a global supply chain. Read a café, a roaster, and a recurring order as three different kinds of business.</p><div class="actions"><a class="button" href="#atlas">Explore the atlas</a><a class="button secondary" href="#economics">Work the numbers</a></div></div></div></section>
    <div class="band"><div class="wrap"><p><b>{records.length} sourced locations · first edition · observed October 3, 2026.</b> A selected sample, not a census. Public menus and catalogs are dated partial assortments; confirm hours and availability with the business.</p></div></div>
    <div class="wrap">
      <section class="content" id="atlas"><header class="section-head"><div><p class="eyebrow">01 · THE FIELD ATLAS</p><h2>Find a place.<br />Follow its evidence.</h2></div><p>Search names, neighborhoods, brewing, and product examples. Distances use a 25-mile WGS84 geodesic radius from City Hall. The schematic places approximate address points by distance and bearing; the full list provides the same information.</p></header>
        <form class="filters" id="coffee-filters" role="search"><label>Search coffee places and products<input type="search" name="query" placeholder="Try whole beans, espresso, or El Segundo" /></label><label>Published offering<select name="kind"><option value="">All offerings</option>{kinds.map(kind=><option value={kind}>{kind}</option>)}</select></label><label>Distance from City Hall<select name="radius"><option value="25">Within 25 miles</option><option value="10">Within 10 miles</option><option value="5">Within 5 miles</option><option value="2">Within 2 miles</option></select></label><button type="reset">Reset</button></form>
        <p id="coffee-results" aria-live="polite" role="status">{records.length} locations shown, sorted by distance.</p><noscript><p class="note">The complete map and list work without JavaScript. Search and selection require JavaScript.</p></noscript>
        <div class="atlas"><div><div class="map" aria-label="Coffee location schematic">
          <div class="map-plot"><svg viewBox="0 0 600 600" role="img" aria-labelledby="map-title map-description"><title id="map-title">Coffee locations by distance and compass bearing from El Segundo City Hall</title><desc id="map-description">A schematic radial map with rings at 5, 10 and 25 miles. Numbered location buttons correspond to the list. No streets or boundaries are shown.</desc><rect width="600" height="600" fill="#e5e9d9"/><circle cx="300" cy="300" r="220" fill="#f4f2e6" stroke="#88967d"/><circle cx="300" cy="300" r="88" fill="none" stroke="#a3af96" stroke-dasharray="4 7"/><circle cx="300" cy="300" r="44" fill="none" stroke="#a3af96" stroke-dasharray="4 7"/><path d="M300 80V520M80 300H520" stroke="#c6cebc"/><path d="M300 55V28m-6 9 6-9 6 9" fill="none" stroke="#202c33" stroke-width="2"/><text x="313" y="40" font-size="14" fill="#202c33">N</text><text x="525" y="305" font-size="13">E</text><text x="295" y="545" font-size="13">S</text><text x="57" y="305" font-size="13">W</text><text x="309" y="503" font-size="12">25 mi</text><text x="309" y="384" font-size="11">10</text><text x="309" y="341" font-size="11">5</text><circle cx="300" cy="300" r="5" fill="#202c33"/><text x="285" y="325" text-anchor="end" font-size="11">City Hall</text></svg>
          {records.map((record,index)=>{const point=coffeeMapPoint(record.distanceMiles,record.bearingDegrees);return <button class="pin" type="button" data-location={record.id} aria-label={`${index+1}. ${record.name}, ${record.distanceMiles.toFixed(2)} miles. Show list entry.`} aria-pressed="false" style={`left:${point.x/6}%;top:${point.y/6}%;`}>{index+1}</button>;})}
          </div><div class="map-caption">Distance/bearing schematic · WGS84 · approximate public source address points. Nearby pins may overlap; use the numbered list to select every location. <b>Center:</b> 350 Main St, El Segundo.</div>
        </div><p class="note">No physical access feature is verified in this edition. Step-free entry, wheelchair-accessible seating, restrooms, hearing access, and parking remain unknown. Use the published source or contact the business if those details determine your visit.</p></div>
        <ol class="result-list" id="coffee-list">{records.map((record,index)=><li class="card" id={`place-${record.id}`} data-place={record.id} tabindex="-1"><span class="number">{String(index+1).padStart(2,'0')} · {record.distanceMiles.toFixed(2)} MI</span><h3>{record.name}</h3><p class="meta">{record.address}<br />{record.coordinateNote}</p><div>{record.tags.map(tag=><span class="tag">{tag}</span>)}</div><p><b>Published examples:</b> {record.assortment.join(' · ')}</p><p class="meta">{record.assortmentNote}</p><details><summary>Source record and access notes</summary><p>Observed {record.observedOn}. Accessibility: {record.accessibility}. Store hours, temporary closure, onsite stock and prices are not verified live.</p><ul>{record.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>{source.note && <> — {source.note}</>}</li>)}</ul></details><button type="button" class="secondary" data-select={record.id}>Select on schematic</button></li>)}</ol></div><p class="empty note" id="coffee-empty" hidden>No locations match those filters. Try a broader search, another offering, or a larger radius.</p>
      </section>
      <section class="content" id="models"><header class="section-head"><div><p class="eyebrow">02 · FOUR OPERATING MODELS</p><h2>Same bean.<br />Different economics.</h2></div><p>These are conceptual teaching cases. The named atlas businesses supply source examples; the operating models do not assert their revenue, margins, staffing, contracts, or customer retention.</p></header><div class="grid">{economics.models.map((model,index)=><article class="card"><span class="number">MODEL {String(index+1).padStart(2,'0')}</span><h3>{model.name}</h3><p>{model.revenue}</p><ul>{model.costs.map(cost=><li>{cost}</li>)}</ul><p><b>Constraint:</b> {model.risks}</p><p><b>Lesson:</b> {model.lesson}</p><details><summary>Study question</summary>{model.questions.map(question=><p>{question}</p>)}</details></article>)}</div></section>
      <section class="content" id="economics"><header class="section-head"><div><p class="eyebrow">03 · ASSUMPTIONS YOU CAN CHANGE</p><h2>A queue is not<br />a profit statement.</h2></div><p>Try a monthly café scenario. All inputs are invented teaching assumptions. The fixed budget includes all scheduled labor and occupancy; variable cost covers ingredients, packaging, payment fees and waste.</p></header><div class="calculator"><form class="calc-inputs" id="cafe-calculator"><label>Average ticket, excluding tax/tips ($)<input name="ticket" type="number" min="0.01" max="100" step="0.01" value="7" required /></label><label>Transactions per day<input name="orders" type="number" min="0" max="5000" step="1" value="180" required /></label><label>Operating days per month<input name="days" type="number" min="1" max="31" step="1" value="26" required /></label><label>Variable cost (% of sales)<input name="variablePercent" type="number" min="0" max="99" step="0.1" value="30" required /></label><label>Fixed monthly budget, including labor ($)<input name="fixedCosts" type="number" min="0" max="1000000" step="100" value="19000" required /></label><div class="actions"><button type="reset">Reset assumptions</button></div></form><div class="calc-output" aria-live="polite" aria-atomic="true"><dl><dt>Illustrative monthly sales</dt><dd id="calc-sales">{money(base.sales)}</dd><dt>Contribution after variable costs</dt><dd id="calc-contribution">{money(base.contribution)}</dd><dt>Result before listed exclusions</dt><dd id="calc-surplus">{money(base.surplus)}</dd><dt>Daily break-even, whole transactions</dt><dd id="calc-break-even">{Math.ceil(base.breakEvenOrders)}</dd></dl><p id="calc-error" role="status">Base teaching scenario. These are not actual shop results.</p></div></div><p class="note">{cafe.exclusions} {cafe.capacity_note}</p><div class="table-wrap"><table><caption class="eyebrow">Sensitivity · independent illustrative cases</caption><thead><tr><th scope="col">Assumption changed</th><th scope="col">Monthly result before exclusions</th><th scope="col">Break-even transactions/day</th></tr></thead><tbody>{cafe.sensitivity.slice(0,5).map(row=><tr><th scope="row">{row.scenario}</th><td>{money(row.monthly_result_before_exclusions_usd)}</td><td>{row.whole_order_break_even_orders_per_day}</td></tr>)}</tbody></table></div><p class="meta">Result = ticket × transactions/day × operating days × (1 − variable-cost fraction) − fixed budget. Break-even/day = fixed budget ÷ [ticket × days × (1 − variable-cost fraction)], rounded up.</p></section>
      <section class="content" id="context"><header class="section-head"><div><p class="eyebrow">04 · FROM THE CITY TO THE CROP</p><h2>Read the market<br />at the right scale.</h2></div><p>Six official indicators frame questions about residents, prices, labor and supply. Reference periods differ. No indicator establishes sales or profitability at an individual café.</p></header><div class="grid">{economics.facts.map(fact=><article class="card"><span class="eyebrow">{fact.kind}</span><h3>{fact.title}</h3><span class="stat">{fact.display_value}</span><p class="meta">{fact.geography}<br />{fact.period} · observed October 3, 2026</p><p>{fact.claim}</p><p class="meta">{fact.caveat}</p><a href={fact.url} target="_blank" rel="noopener noreferrer">Read the official source ↗</a></article>)}</div><div class="note"><b>Classroom interpretation:</b> {economics.outlook.global} {economics.outlook.national}</div></section>
      <section class="content"><header class="section-head"><div><p class="eyebrow">05 · LEARN FROM THE CASE</p><h2>Ask before<br />you extrapolate.</h2></div><p>Use the atlas as a starting sample. A public source can establish an assortment or address while leaving customer demand, margins and company sales unknown.</p></header><ol class="teaching">{economics.teaching_sessions.slice(0,3).map(session=><li><div><h3>{session.title}</h3><p>{session.activity}</p><ul>{session.questions.map(question=><li style="display:list-item;border:0;padding:0">{question}</li>)}</ul></div></li>)}</ol><div class="actions"><a class="button" href="/ues/business#worksheet">Write a private business study</a><a class="button secondary" href="/ues/business#comparison">Compare the case-study methods</a></div></section>
      <section class="content" id="method"><header class="section-head"><div><p class="eyebrow">06 · THE SOURCE LEDGER</p><h2>A bounded<br />first edition.</h2></div><p>Observed October 3, 2026. This is a selected, sourced café/roaster sample within a geometric radius, not an exhaustive directory, a merchant partnership, or an estimate of the whole local coffee market.</p></header><div class="grid"><article class="card"><h3>Location and radius</h3><p>Center: {COFFEE_CENTER.address}; {COFFEE_CENTER.latitude}, {COFFEE_CENTER.longitude}. {COFFEE_CENTER.precision}. Shop points come from Census address matching or documented merchant directions and retain that approximation. Distances and initial bearings use the WGS84 ellipsoid; inclusion uses unrounded distance ≤ 25 miles.</p><p>A geometric radius is not a drive time or trade area. The schematic has no street network, routing, parcel precision, or municipal boundaries.</p><a href="https://geocoding.geo.census.gov/geocoder/" target="_blank" rel="noopener noreferrer">Census Geocoder ↗</a></article><article class="card"><h3>Product and access evidence</h3><p>Merchant-owned pages support addresses and named offerings. A website bean catalog describes a brand’s online assortment; it does not prove the bag is stocked at the mapped café. No live inventory, shop sales, revenue, footfall, quality ranking, or accessibility certification is inferred.</p><p>Public health and local licensing are separate records. This edition has not matched food-facility permits or inspection records to every address.</p><a href="https://ehservices.publichealth.lacounty.gov/" target="_blank" rel="noopener noreferrer">LA County environmental health lookup ↗</a></article></div><ul class="sources">{economics.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.publisher} · {source.title} ↗</a><br />Period: {source.report_period}. Publication: {source.publication_date ?? 'not stated in inspected source'}. Observed {source.observed_on}.</li>)}</ul><p class="note">Official published statistics, forecasts, source-based interpretation, and invented unit economics are labeled separately. The study uses no private financial records. Underlying releases and merchant pages can change after this edition.</p><div class="actions"><a class="button secondary" href="/ues/coffee.json" download="ues-coffee-study-2026-10-03.json">Download source snapshot (JSON)</a><a class="button secondary" href="/ues/business">Return to the casebook</a></div></section>
      <footer>Original AI-generated coffee collage, October 3, 2026; no real shop, brand, or endorsement depicted. Independent UES educational research; UES is unaccredited. Sources remain the authority for their own records. <a href="/ues/coffee.json">Data and provenance</a>.</footer>
    </div>
  </main>
</BlockLayout>
<script>
  import atlas from '../../data/ues-coffee-atlas.json';
  import { matchesCoffee, calculateCafeScenario } from '../../lib/coffee-study.mjs';
  function setupCoffeeStudy() {
    const root = document.querySelector<HTMLElement>('#coffee-study');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const filters = root.querySelector<HTMLFormElement>('#coffee-filters')!;
    let selected = '';
    function select(id:string,move:boolean) {
      selected=id;
      root!.querySelectorAll<HTMLElement>('[data-place]').forEach(card=>card.classList.toggle('selected',card.dataset.place===id));
      root!.querySelectorAll<HTMLButtonElement>('[data-location]').forEach(pin=>pin.setAttribute('aria-pressed',String(pin.dataset.location===id)));
      const card = root!.querySelector<HTMLElement>(`[data-place="${id}"]`);
      if(move && card){card.focus({preventScroll:true});card.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});}
    }
    function updateFilters() {
      const form = new FormData(filters);
      const visible = new Set(atlas.records.filter(record=>matchesCoffee(record,{query:String(form.get('query')||''),kind:String(form.get('kind')||''),radius:Number(form.get('radius'))})).map(record=>record.id));
      root!.querySelectorAll<HTMLElement>('[data-place]').forEach(card=>card.hidden=!visible.has(card.dataset.place!));
      root!.querySelectorAll<HTMLElement>('[data-location]').forEach(pin=>pin.hidden=!visible.has(pin.dataset.location!));
      root!.querySelector('#coffee-results')!.textContent=`${visible.size} ${visible.size===1?'location':'locations'} shown, sorted by distance.`;
      root!.querySelector<HTMLElement>('#coffee-empty')!.hidden=visible.size>0;
      if(selected&&!visible.has(selected))select('',false);
    }
    filters.addEventListener('submit',event=>event.preventDefault());filters.addEventListener('input',updateFilters);filters.addEventListener('change',updateFilters);filters.addEventListener('reset',()=>window.setTimeout(updateFilters,0));
    root.querySelectorAll<HTMLButtonElement>('[data-location]').forEach(pin=>pin.addEventListener('click',()=>select(pin.dataset.location!,true)));
    root.querySelectorAll<HTMLButtonElement>('[data-select]').forEach(button=>button.addEventListener('click',()=>select(button.dataset.select!,false)));
    const calculator = root.querySelector<HTMLFormElement>('#cafe-calculator')!;
    const money = (value:number)=>value.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
    function updateCalculator() {
      const data = new FormData(calculator); const input = Object.fromEntries([...data].map(([key,value])=>[key,Number(value)]));
      const result = calculator.checkValidity()?calculateCafeScenario(input):null;
      const error = root!.querySelector('#calc-error')!;
      if(!result){for(const id of ['sales','contribution','surplus','break-even'])root!.querySelector(`#calc-${id}`)!.textContent='—';error.textContent='Enter valid assumptions within the labeled ranges.';return;}
      root!.querySelector('#calc-sales')!.textContent=money(result.sales);root!.querySelector('#calc-contribution')!.textContent=money(result.contribution);root!.querySelector('#calc-surplus')!.textContent=money(result.surplus);root!.querySelector('#calc-break-even')!.textContent=String(Math.ceil(result.breakEvenOrders));error.textContent='Illustrative scenario. These are not actual shop results.';
    }
    calculator.addEventListener('submit',event=>event.preventDefault());calculator.addEventListener('input',updateCalculator);calculator.addEventListener('reset',()=>window.setTimeout(updateCalculator,0));
  }
  setupCoffeeStudy(); document.addEventListener('astro:page-load',setupCoffeeStudy);
</script>
