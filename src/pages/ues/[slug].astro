---
import BlockLayout from '../../layouts/BlockLayout.astro';
import gallery from '../../data/el-segundo-school-gallery.json';
import { UES_SEASON_ONE_COURSES, type UesSeasonOneCourse } from '../../lib/ues-classes';
import { UES_PROGRAM } from '../../lib/ues-program';

export function getStaticPaths() {
  return UES_SEASON_ONE_COURSES.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props as { course: UesSeasonOneCourse };
const courseIndex = UES_SEASON_ONE_COURSES.findIndex((item) => item.code === course.code);
const previousCourse = courseIndex > 0 ? UES_SEASON_ONE_COURSES.at(courseIndex - 1) : undefined;
const nextCourse = UES_SEASON_ONE_COURSES.at(courseIndex + 1);
const artwork = gallery.works.find((work) => work.number === course.archiveWorkNumber);
const assetOrigin = 'https://el-segundo-school-archive.pages.dev';
const artUrl = (path: string) => `${assetOrigin}${path.replace('/images/el-segundo-school', '')}`;
const helpHref = `mailto:${UES_PROGRAM.contact}?subject=${encodeURIComponent(`${course.code} — ${course.title} question`)}`;
const title = `${course.code} · ${course.title}`;
const description = `${course.frame} A public six-week course room from University of El Segundo.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `https://pointcast.xyz${course.path}`,
  name: course.title,
  courseCode: course.code,
  description: course.frame,
  url: `https://pointcast.xyz${course.path}`,
  numberOfCredits: 0,
  isAccessibleForFree: true,
  inLanguage: 'en',
  coursePrerequisites: 'None. No application, account, live attendance, or wallet is required.',
  provider: { '@type': 'EducationalOrganization', name: UES_PROGRAM.name, url: UES_PROGRAM.home },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: ['online', 'self-paced', 'asynchronous'],
    courseWorkload: `${course.weeklyCommitment.total}; ${course.weeklyCommitment.selfGuidedStudioMinutes} self-guided studio minutes, ${course.weeklyCommitment.fieldworkMinutes.minimum}–${course.weeklyCommitment.fieldworkMinutes.maximum} fieldwork minutes, and ${course.weeklyCommitment.reflectionMinutes} reflection minutes per module.`,
    courseSchedule: { '@type': 'Schedule', repeatFrequency: 'Self-paced', duration: 'P6W' },
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image={artwork ? artUrl(artwork.src) : undefined}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: course.jsonPath, title: `${course.code} course data` }]}
>
  <article class="room">
    <header class="masthead">
      <a class="masthead__mark" href="/">POINTCAST</a>
      <nav aria-label="University of El Segundo">
        <a href="/university-of-el-segundo">University</a>
        <a href="/ues" aria-current="page">Classes</a>
        <a href="/el-segundo-school">Art archive</a>
        <a href="/university-of-el-segundo#fund">Contribute</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="course-title">
      <div class="hero__copy">
        <p class="eyebrow">THE LOCAL TRANSMISSION · ONLINE SEASON 1 · {course.code}</p>
        <div class="status"><span>{course.status}</span><span>start anytime</span><span>self-paced</span><span>$0 tuition</span></div>
        <h1 id="course-title">{course.title}</h1>
        <p class="subtitle">{course.archiveCategory}</p>
        <p class="frame">{course.frame}</p>
        {course.boundary && <p class="boundary"><strong>Course boundary</strong>{course.boundary}</p>}
        <div class="hero__actions">
          <a class="button button--primary" href="#week-1" data-course-start>Start this class</a>
          <a class="button" href="#weeks">Read all six weeks</a>
        </div>
      </div>
      {artwork && (
        <figure class="hero__art">
          <img src={artUrl(artwork.src)} alt={`${artwork.title}, work ${artwork.number} by Michael Hoydich`} width={artwork.width} height={artwork.height} />
          <figcaption>
            <span>COURSE COVER · WORK {artwork.number}</span>
            <b>{artwork.title}</b>
            <a href="/el-segundo-school#gallery">Visit the art archive →</a>
          </figcaption>
        </figure>
      )}
    </section>

    <dl class="facts" aria-label="Course facts">
      <div><dt>Weekly time</dt><dd>{course.weeklyCommitment.total}</dd></div>
      <div><dt>Pace</dt><dd>Start anytime · no deadlines · pause and return.</dd></div>
      <div><dt>Completion</dt><dd>Any four modules plus the final course outcome.</dd></div>
      <div><dt>Materials</dt><dd>{course.materials.join(' · ')}</dd></div>
    </dl>

    <section class="purpose split-section" aria-labelledby="purpose-title">
      <div>
        <p class="eyebrow">WHY THIS CLASS EXISTS</p>
        <h2 id="purpose-title">Make observation useful to somebody else.</h2>
      </div>
      <div class="prose">
        <p>{course.frame}</p>
        <div class="outcome"><span>COURSE OUTCOME · PRIVATE OR PUBLIC</span><strong>{course.outcome}</strong></div>
        <p class="lineage"><b>Builds from Season 0:</b> {course.connectsFrom.join(', ')}.</p>
      </div>
    </section>

    <section class="operation split-section" aria-labelledby="operation-title">
      <div>
        <p class="eyebrow">HOW THE ROOM RUNS</p>
        <h2 id="operation-title">Prompt. Fieldwork. Studio. Receipt.</h2>
      </div>
      <ol class="rhythm">
        <li><span>01</span><div><b>Module prompt</b><p>One central question opens each module. The source shelf is optional; the page itself contains the full path.</p></div></li>
        <li><span>02</span><div><b>Field task</b><p>One {course.weeklyCommitment.fieldworkMinutes.minimum}–{course.weeklyCommitment.fieldworkMinutes.maximum} minute act of looking, making, recording, or hosting.</p></div></li>
        <li><span>03</span><div><b>Self-guided studio</b><p>A {course.weeklyCommitment.selfGuidedStudioMinutes}-minute making, editing, or reflection session you can complete alone.</p></div></li>
        <li><span>04</span><div><b>Module receipt</b><p>A {course.weeklyCommitment.reflectionMinutes}-minute useful trace kept privately or shared only when you choose.</p></div></li>
      </ol>
      <aside class="solo-path"><b>Your solo path counts equally.</b><p>{course.soloPath}</p></aside>
    </section>

    <section
      class="course-desk"
      id="course-desk"
      aria-labelledby="course-desk-title"
      data-course-desk
      data-course-code={course.code}
      data-course-title={course.title}
      data-course-path={course.path}
    >
      <div class="course-desk__intro">
        <p class="eyebrow">YOUR PRIVATE COURSE DESK</p>
        <h2 id="course-desk-title">Start here. No account required.</h2>
        <p>Check off modules as you work. Progress stays in this browser; the university never receives your name, work, location, email, or wallet.</p>
      </div>
      <div class="course-desk__controls">
        <div class="progress-wrap">
          <progress data-course-progress max="5" value="0" aria-label={`${course.code} course completion`} aria-describedby="course-progress-text">0 of 5 completion steps</progress>
          <p id="course-progress-text" data-course-progress-text aria-live="polite">0 of 5 completion steps · finish any four modules plus the final outcome.</p>
        </div>
        <div class="desk-actions">
          <a class="button button--primary" href="#week-1" data-course-continue>Start with module 1</a>
          <button class="button" type="button" data-course-print>Print syllabus</button>
          <a class="button" href="#course-desk" data-course-receipt aria-disabled="true">Download private receipt</a>
          <button class="button button--quiet" type="button" data-course-reset>Reset local progress</button>
        </div>
        <p class="storage-note" data-course-storage aria-live="polite">Local progress is ready. You can also use the class without saving anything.</p>
        <noscript><p class="storage-note">JavaScript is off. The complete class remains available below; print this page or keep your own checklist.</p></noscript>
      </div>
    </section>

    <section class="weeks" id="weeks" aria-labelledby="weeks-title">
      <header>
        <p class="eyebrow">THE SIX-WEEK ROOM</p>
        <h2 id="weeks-title">A complete first syllabus.</h2>
      </header>
      <ol class="week-list">
        {course.weeks.map((week, index) => (
          <li id={`week-${index + 1}`} class="week">
            <div class="week__number"><span>WEEK</span><strong>{String(index + 1).padStart(2, '0')}</strong></div>
            <div class="week__body">
              <p class="week__question">{week.question}</p>
              <h3>{week.title}</h3>
              <div class="week__grid">
                <div><h4>Optional source shelf</h4><ul>{week.sourceShelf.map((source) => <li>{source}</li>)}</ul></div>
                <div><h4>Self-guided studio</h4><p>{week.studio}</p></div>
                <div><h4>Field task</h4><p>{week.fieldTask}</p></div>
                <div class="receipt"><h4>Module receipt · private by default</h4><p>{week.publicReceipt}</p></div>
              </div>
              <label class="week__complete">
                <input type="checkbox" data-course-week={index + 1} />
                <span>Mark module {index + 1} complete</span>
              </label>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="assignments split-section" aria-labelledby="assignments-title">
      <div><p class="eyebrow">WHAT COMPLETION MEANS</p><h2 id="assignments-title">No grades. Real work.</h2></div>
      <div>
        <ol>{course.assignments.map((assignment, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p><b>{assignment.title} · due week {assignment.dueWeek}</b><br />{assignment.brief}</p></li>)}</ol>
        <p class="completion">Complete any four of the six module receipts and finish the course outcome or a private equivalent. There are no grades, deadlines, peer requirements, or public-posting requirements.</p>
        <label class="final-complete">
          <input type="checkbox" data-course-final />
          <span>I finished the course outcome or a private equivalent.</span>
        </label>
      </div>
    </section>

    <section class="access split-section" aria-labelledby="access-title">
      <div><p class="eyebrow">ACCESS IS PART OF THE SYLLABUS</p><h2 id="access-title">More than one way through the room.</h2></div>
      <div>
        <ul>{course.access.map((item) => <li>{item}</li>)}</ul>
        <dl>
          <div><dt>Independent route</dt><dd>Active now. The complete sequence, studio prompts, access paths, and private checklist are on this page.</dd></div>
          <div><dt>Optional faculty profile</dt><dd>{course.instructorProfile}</dd></div>
          <div><dt>Supported cohort</dt><dd>Optional and funding-dependent. Human review or scheduled sessions never gate access or completion.</dd></div>
          <div><dt>Planning cost</dt><dd>${course.budgetUsd.toLocaleString('en-US')} for maintenance, access, materials, and an optional supported cohort—not tuition or admission.</dd></div>
        </dl>
        <p class="rights">Learners retain copyright. Public licensing and Tezos minting are optional and separate. A wallet, public identity, public artifact, or blockchain transaction is never required for this class.</p>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <p class="eyebrow">THE ROOM IS OPEN</p>
      <h2 id="cta-title">Bring one place. Leave one useful trace.</h2>
      <p>Start now, move at your own pace, and keep the work private if that is the right path. Human help and supported cohorts can be added without changing anyone’s right to learn independently.</p>
      <div><a class="button button--primary" href="#week-1" data-course-start>Start {course.code}</a><a class="button" href={helpHref}>Ask for help</a><a class="button" href="/university-of-el-segundo#fund">Support the shared pool</a></div>
      <small>Support does not buy admission, curriculum control, governance rights, or faculty appointments.</small>
    </section>

    <nav class="course-nav" aria-label="More University of El Segundo classes">
      {previousCourse ? <a href={previousCourse.path}><span>Previous</span><b>{previousCourse.code} · {previousCourse.title}</b></a> : <a href="/ues"><span>Catalog</span><b>All online classes</b></a>}
      {nextCourse ? <a href={nextCourse.path}><span>Next</span><b>{nextCourse.code} · {nextCourse.title}</b></a> : <a href="/ues/track-05"><span>Previous curriculum</span><b>UES-05 · The Rebuildable Town</b></a>}
    </nav>
  </article>
</BlockLayout>

<script>
  import {
    createCompletionReceipt,
    createProgress,
    parseProgress,
    progressSummary,
    serializeProgress,
    setFinalOutcome,
    setWeekComplete,
    startProgress,
  } from '../../lib/ues-progress.mjs';

  const desk = document.querySelector<HTMLElement>('[data-course-desk]');

  if (desk) {
    const courseCode = desk.dataset.courseCode ?? '';
    const courseTitle = desk.dataset.courseTitle ?? courseCode;
    const coursePath = desk.dataset.coursePath ?? window.location.pathname;
    const storageKey = `pc:ues:progress:v1:${courseCode}`;
    const weekInputs = [...document.querySelectorAll<HTMLInputElement>('[data-course-week]')];
    const finalInput = document.querySelector<HTMLInputElement>('[data-course-final]');
    const progressBar = desk.querySelector<HTMLProgressElement>('[data-course-progress]');
    const progressText = desk.querySelector<HTMLElement>('[data-course-progress-text]');
    const storageText = desk.querySelector<HTMLElement>('[data-course-storage]');
    const continueLink = desk.querySelector<HTMLAnchorElement>('[data-course-continue]');
    const startLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-course-start]')];
    const receiptLink = desk.querySelector<HTMLAnchorElement>('[data-course-receipt]');
    const resetButton = desk.querySelector<HTMLButtonElement>('[data-course-reset]');
    const printButton = desk.querySelector<HTMLButtonElement>('[data-course-print]');
    let progress = createProgress(courseCode);
    let storageAvailable = true;

    try {
      progress = parseProgress(window.localStorage.getItem(storageKey), courseCode);
    } catch {
      storageAvailable = false;
    }

    const save = () => {
      if (!storageAvailable) return;
      try {
        window.localStorage.setItem(storageKey, serializeProgress(progress));
      } catch {
        storageAvailable = false;
      }
    };

    const receiptDocument = () => {
      const baseReceipt = createCompletionReceipt(progress);
      return baseReceipt ? {
        ...baseReceipt,
        courseTitle,
        courseUrl: new URL(coursePath, window.location.origin).toString(),
      } : null;
    };

    const render = () => {
      const summary = progressSummary(progress);
      weekInputs.forEach((input) => {
        const week = Number(input.dataset.courseWeek);
        input.checked = progress.completedWeeks.includes(week);
      });
      if (finalInput) finalInput.checked = progress.finalOutcome;

      if (progressBar) {
        progressBar.max = summary.max;
        progressBar.value = summary.value;
      }

      if (progressText) {
        const checked = `${progress.completedWeeks.length} of 6 modules checked`;
        progressText.textContent = summary.complete
          ? `${summary.max} of ${summary.max} completion steps · ${checked}. Course complete by self-attestation.`
          : `${summary.value} of ${summary.max} completion steps · ${checked}. Finish any four modules plus the final outcome.`;
      }

      let nextHref = '#week-1';
      let nextLabel = 'Start with module 1';
      if (summary.complete) {
        nextHref = '#assignments-title';
        nextLabel = 'Review your completed course';
      } else if (progress.completedWeeks.length >= 4 && !progress.finalOutcome) {
        nextHref = '#assignments-title';
        nextLabel = 'Finish the final outcome';
      } else if (summary.nextModule) {
        nextHref = `#week-${summary.nextModule}`;
        nextLabel = progress.startedAt ? `Continue with module ${summary.nextModule}` : `Start with module ${summary.nextModule}`;
      }

      if (continueLink) {
        continueLink.href = nextHref;
        continueLink.textContent = nextLabel;
      }
      startLinks.forEach((link) => {
        link.href = nextHref;
        link.textContent = progress.startedAt ? nextLabel : link.textContent;
      });
      if (receiptLink) {
        const receipt = receiptDocument();
        if (receipt) {
          receiptLink.href = `data:application/json;charset=utf-8,${encodeURIComponent(`${JSON.stringify(receipt, null, 2)}\n`)}`;
          receiptLink.download = `${courseCode.toLowerCase()}-self-attested-receipt.json`;
          receiptLink.setAttribute('aria-disabled', 'false');
        } else {
          receiptLink.href = '#course-desk';
          receiptLink.removeAttribute('download');
          receiptLink.setAttribute('aria-disabled', 'true');
        }
      }
      if (storageText) {
        storageText.textContent = storageAvailable
          ? 'Progress is saved only in this browser. Reset it here or download a private receipt when complete.'
          : 'Private saving is unavailable in this browser. The checklist still works until this page closes; print the syllabus to keep a separate record.';
      }
    };

    startLinks.forEach((link) => {
      link.addEventListener('click', () => {
        progress = startProgress(progress);
        save();
        render();
      });
    });
    continueLink?.addEventListener('click', () => {
      progress = startProgress(progress);
      save();
      render();
    });

    weekInputs.forEach((input) => {
      input.addEventListener('change', () => {
        progress = setWeekComplete(progress, Number(input.dataset.courseWeek), input.checked);
        save();
        render();
      });
    });

    finalInput?.addEventListener('change', () => {
      progress = setFinalOutcome(progress, finalInput.checked);
      save();
      render();
    });

    printButton?.addEventListener('click', () => window.print());

    resetButton?.addEventListener('click', () => {
      if (!window.confirm(`Reset private progress for ${courseCode}?`)) return;
      progress = createProgress(courseCode);
      if (storageAvailable) {
        try {
          window.localStorage.removeItem(storageKey);
        } catch {
          storageAvailable = false;
        }
      }
      render();
      continueLink?.focus();
    });

    receiptLink?.addEventListener('click', (event) => {
      if (receiptLink.getAttribute('aria-disabled') === 'true') event.preventDefault();
    });

    render();
  }
</script>

<style>
  .room { --ink:#10120f; --paper:#f1eee3; --acid:#caff24; --blue:#1537e8; --lavender:#ddd1ff; --red:#ff5c43; min-width:0; background:var(--paper); color:var(--ink); }
  .room :is(a,button,input):focus-visible { outline:3px solid var(--acid); outline-offset:3px; }
  .masthead { position:sticky; top:0; z-index:30; min-height:58px; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:8px 14px; border-bottom:1px solid var(--ink); background:rgba(241,238,227,.96); backdrop-filter:blur(10px); }
  .masthead__mark { color:var(--ink); font:700 11px var(--pc-font-mono); letter-spacing:.14em; }
  .masthead nav { display:flex; gap:5px; }
  .masthead nav a { min-height:42px; display:grid; place-items:center; padding:7px 11px; border:1px solid #a5a398; color:var(--ink); font:9px var(--pc-font-mono); text-transform:uppercase; }
  .masthead nav a:hover,.masthead nav a[aria-current="page"] { background:var(--ink); color:var(--paper); text-decoration:none; }
  .hero { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr); min-height:calc(100vh - 58px); border-bottom:1px solid var(--ink); }
  .hero__copy { display:flex; flex-direction:column; padding:clamp(34px,5vw,76px); border-right:1px solid var(--ink); }
  .eyebrow { margin:0; color:var(--blue); font:700 10px/1.5 var(--pc-font-mono); letter-spacing:.12em; text-transform:uppercase; }
  .status { display:flex; flex-wrap:wrap; gap:6px; margin:22px 0 0; }
  .status span { padding:7px 9px; border:1px solid var(--ink); font:9px var(--pc-font-mono); text-transform:uppercase; }
  .status span:first-child { background:var(--acid); }
  h1 { max-width:12ch; margin:clamp(40px,8vh,90px) 0 18px; font-size:clamp(58px,8vw,132px); line-height:.79; letter-spacing:-.075em; }
  .subtitle { margin:0 0 22px; color:var(--blue); font:700 clamp(19px,2vw,27px)/1.15 var(--pc-font-mono); }
  .frame { max-width:760px; margin:0; font:22px/1.42 Georgia,serif; }
  .boundary { max-width:760px; display:grid; gap:7px; margin:24px 0 0; padding:14px; border:2px solid var(--red); background:#fff; font-size:16px; line-height:1.5; }
  .boundary strong { color:#b22d1d; font:700 11px var(--pc-font-mono); text-transform:uppercase; }
  .hero__actions,.cta>div { display:flex; flex-wrap:wrap; gap:8px; margin-top:auto; padding-top:38px; }
  .button { min-height:48px; display:grid; place-items:center; padding:11px 15px; border:1px solid var(--ink); background:transparent; color:var(--ink); font:700 10px var(--pc-font-mono); text-align:center; text-transform:uppercase; cursor:pointer; }
  .button:hover { background:var(--ink); color:var(--paper); text-decoration:none; }
  .button--primary { background:var(--acid); }
  .button:disabled,.button[aria-disabled="true"] { cursor:not-allowed; opacity:.48; }
  .button:disabled:hover,.button[aria-disabled="true"]:hover { background:transparent; color:inherit; }
  .button--quiet { border-style:dashed; }
  .hero__art { min-width:0; display:flex; flex-direction:column; margin:0; padding:clamp(18px,3vw,44px); background:var(--blue); }
  .hero__art img { width:100%; min-height:0; flex:1; object-fit:cover; border:1px solid #99a8ff; box-shadow:14px 14px 0 var(--acid); }
  .hero__art figcaption { display:grid; gap:7px; padding:28px 0 0; color:#fff; }
  .hero__art figcaption span,.hero__art figcaption a { color:var(--acid); font:9px var(--pc-font-mono); text-transform:uppercase; }
  .hero__art figcaption b { font:18px/1.3 Georgia,serif; }
  .facts { display:grid; grid-template-columns:repeat(4,1fr); margin:0; border-bottom:1px solid var(--ink); }
  .facts div { min-height:150px; padding:18px; border-right:1px solid var(--ink); }
  .facts div:last-child { border-right:0; }
  .facts dt { color:var(--blue); font:9px var(--pc-font-mono); text-transform:uppercase; }
  .facts dd { margin:30px 0 0; font:16px/1.45 var(--pc-font-mono); }
  .split-section { display:grid; grid-template-columns:minmax(280px,.75fr) minmax(0,1.25fr); gap:clamp(38px,8vw,140px); padding:clamp(70px,9vw,140px) clamp(18px,5vw,76px); border-bottom:1px solid var(--ink); }
  .split-section h2,.weeks h2,.cta h2 { max-width:12ch; margin:14px 0 0; font-size:clamp(48px,7vw,104px); line-height:.84; letter-spacing:-.065em; }
  .prose>p { max-width:720px; margin:0; font:22px/1.48 Georgia,serif; }
  .outcome { display:grid; gap:14px; margin:48px 0; padding:24px; border:1px solid var(--ink); background:var(--acid); }
  .outcome span { font:9px var(--pc-font-mono); }
  .outcome strong { font-size:clamp(26px,3vw,44px); line-height:1.05; }
  .lineage { font-size:16px!important; }
  .operation { background:var(--lavender); }
  .rhythm { list-style:none; margin:0; padding:0; border-top:1px solid var(--ink); }
  .rhythm li { display:grid; grid-template-columns:48px 1fr; gap:20px; padding:20px 0; border-bottom:1px solid var(--ink); }
  .rhythm li>span { color:var(--blue); font:10px var(--pc-font-mono); }
  .rhythm b { font-size:22px; }
  .rhythm p { margin:7px 0 0; font-size:16px; line-height:1.5; }
  .solo-path { grid-column:2; margin:6px 0 0; padding:22px; border:1px solid var(--ink); background:var(--paper); }
  .solo-path b { font:700 11px var(--pc-font-mono); text-transform:uppercase; }
  .solo-path p { margin:10px 0 0; font:18px/1.5 Georgia,serif; }
  .course-desk { scroll-margin-top:58px; display:grid; grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr); gap:clamp(38px,8vw,140px); padding:clamp(70px,9vw,130px) clamp(18px,5vw,76px); border-bottom:1px solid var(--ink); background:var(--blue); color:#fff; }
  .course-desk .eyebrow { color:var(--acid); }
