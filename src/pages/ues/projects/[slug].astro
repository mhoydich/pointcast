---
import UesProjectFrame from '../../../components/UesProjectFrame.astro';
import desk from '../../../data/ues-project-briefs.json';
export function getStaticPaths() { return desk.projects.map((project) => ({params:{slug:project.slug},props:{project}})); }
const { project: p } = Astro.props;
---
<UesProjectFrame title={p.title + ' · UES build brief'} description={p.summary} slug={p.slug}>
  <div id="project-content">
    <section class="up-detail-hero"><div><a class="up-back" href="/ues/projects">← Three project briefs</a><p class="up-kicker">{p.id} / {p.tag} / PROPOSED BUILD</p><h1>{p.title}</h1><p class="up-detail-subtitle">{p.subtitle}</p><p class="up-dek">{p.summary}</p><a class="up-button up-button-light" href={'/ues/projects/' + p.slug + '/brief.md'} download>Download complete brief <span aria-hidden="true">↓</span></a></div><div class={'up-detail-art up-detail-art-' + p.number} aria-hidden="true"><span>{p.number}</span><i></i><b></b></div></section>
    <section class="up-status" aria-label="Build status"><strong>BRIEF PUBLISHED</strong><p>Prepared for Claude Code. Implementation awaits acknowledgement. New project applications and admissions are closed.</p><a href={'/ues/projects/' + p.slug + '.json'}>Brief data ↗</a></section>
    <div class="up-detail-layout">
      <aside class="up-detail-index"><p class="up-kicker">IN THIS BRIEF</p><nav aria-label="Brief sections"><a href="#question">The question</a><a href="#scope">The build</a><a href="#example">A synthetic example</a><a href="#finish">A testable finish</a><a href="#resources">Existing resources</a></nav><p class="up-small">Proposed tools.<br />Existing classes preserved.<br />Private by default.</p></aside>
      <div class="up-brief-body">
        <section id="question"><p class="up-kicker">01 / PURPOSE</p><h2>{p.question}</h2><p>{p.distinct}</p><div class="up-outcome"><p class="up-kicker">THE THING YOU CAN KEEP</p><p>{p.outcome}</p></div></section>
        <section id="scope"><p class="up-kicker">02 / THE BUILD</p><h2>A small, complete first version.</h2><ol class="up-scope-list">{p.scope.map((item,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}</ol><div class="up-boundary"><strong>Outside this build</strong><p>{p.nonGoals}</p></div></section>
        <section id="example" class="up-example"><p class="up-kicker">{p.sample.label}</p><h2>{p.sample.title}</h2><p>{p.sample.body}</p><p class="up-small">Illustrates the proposed experience. It is not evidence of participant work or a completed tool.</p></section>
        <section id="finish"><p class="up-kicker">03 / ACCEPTANCE</p><h2>A finish you can inspect.</h2><ul class="up-checks">{p.acceptance.map(item=><li>{item}</li>)}</ul><h3>What the builder returns</h3><div class="up-deliverables">{p.deliverables.map(item=><p>{item}</p>)}</div><p class="up-small">Source and tests arrive in a scoped draft PR. Review and coordinated release come before implementation publication. No direct main push.</p></section>
        <section id="resources"><p class="up-kicker">04 / EXISTING RESOURCES</p><h2>Continue with the school.</h2><div class="up-resource-links">{p.links.map(link=><a href={link.path}>{link.label} ↗</a>)}</div><p>These existing routes remain unchanged. Current self-paced access and private completion standards continue under their existing terms.</p></section>
      </div>
    </div>
    <section class="up-next"><p class="up-kicker">THE OTHER ROOMS</p><div>{desk.projects.filter(item=>item.slug!==p.slug).map(item=><a href={'/ues/projects/'+item.slug}><span>{item.id}</span><strong>{item.title}</strong><b aria-hidden="true">↗</b></a>)}</div></section>
  </div>
</UesProjectFrame>

