---
import BlockLayout from '../../layouts/BlockLayout.astro';
import data from '../../data/ues-electricity.json';
import {renderElectricity} from '../../lib/render-electricity.mjs';
import '../../styles/ues-electricity.css';
const title='The state of electricity · University of El Segundo';
const description='A sourced electricity story from history to the modern grid, with California and El Segundo pathways, power and energy lessons, and illustrative solar and storage economics.';
---
<BlockLayout title={title} description={description} hideAds alternates={[{type:'application/json',href:'/ues/electricity.json',title:'Electricity study and source ledger'}]} jsonLd={{'@context':'https://schema.org','@type':'Article',headline:title,dateModified:data.editionDate,url:'https://pointcast.xyz/ues/electricity/',description}}>
<Fragment set:html={renderElectricity(data)} />
</BlockLayout>
<script>import '../../scripts/ues-electricity.mjs';</script>
