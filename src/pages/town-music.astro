---
/**
 * /town-music — the music-app discovery dashboard.
 *
 * One page that surfaces ALL the music work on pointcast.xyz:
 * 8 music pages (Listen → Understand → Play → Create → Capstone),
 * plus your personal state from localStorage — recently heard,
 * saved compositions, drum-school stars, and a journey map.
 *
 * Brand-new visitor sees: page tiles + journey map.
 * Returning visitor sees: their progress, their compositions, their tracks.
 *
 * All state is read from localStorage — no fetch, no API.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Town Music — the whole pointcast music landscape, in one place"
  description="Eight music pages, your saved compositions, your listening history, your drum-school stars, and a journey map from Listen to Capstone. Everything you've done with sound on pointcast, on one page.">
  <main class="tm" id="tm" data-built={built}>
    <!-- ============== HEADER ============== -->
    <header class="tm__top">
      <div class="tm__top-l">
        <p class="tm__kicker">TOWN · MUSIC · the whole landscape</p>
        <h1 class="tm__title">You and music<br/>on pointcast.</h1>
        <p class="tm__sub">Eight pages. One arc. Listen to tunes. Learn how they work. Play games that train your ear. Make your own. Then graduate. This page reads your local progress and shows you where you've been.</p>
      </div>
      <div class="tm__top-r">
        <button class="tm__btn tm__btn--ghost" id="tm-refresh" type="button" title="Re-read localStorage and re-render">
          <span class="tm__btn-icon">↻</span> refresh
        </button>
      </div>
    </header>

    <!-- ============== SECTION 1 — HERO BAND ============== -->
    <section class="tm__section" id="hero-band">
      <header class="tm__section-head">
        <p class="tm__section-label">1 · TODAY'S PROGRESS</p>
        <p class="tm__section-hint">Counts read from this device. Visit a page to start filling in.</p>
      </header>

      <div class="tm__stats">
        <div class="tm__stat">
          <p class="tm__stat-val" id="tm-stat-stars">— / 12</p>
          <p class="tm__stat-label">drum-school stars</p>
        </div>
        <div class="tm__stat">
          <p class="tm__stat-val" id="tm-stat-comps">—</p>
          <p class="tm__stat-label">compositions saved</p>
        </div>
        <div class="tm__stat">
          <p class="tm__stat-val" id="tm-stat-plays">—</p>
          <p class="tm__stat-label">total plays</p>
        </div>
        <div class="tm__stat">
          <p class="tm__stat-val" id="tm-stat-visited">— / 8</p>
          <p class="tm__stat-label">music pages visited</p>
        </div>
      </div>

      <div class="tm__tiles" id="tm-tiles"></div>
    </section>

    <!-- ============== SECTION 2 — RECENTLY HEARD ============== -->
    <section class="tm__section" id="recently-heard">
      <header class="tm__section-head">
        <p class="tm__section-label">2 · RECENTLY HEARD</p>
        <p class="tm__section-hint">Last tracks you played in cast-music-pro.</p>
      </header>
      <div class="tm__recent" id="tm-recent"></div>
    </section>

    <!-- ============== SECTION 3 — YOUR COMPOSITIONS ============== -->
    <section class="tm__section" id="your-compositions">
      <header class="tm__section-head">
        <p class="tm__section-label">3 · YOUR COMPOSITIONS</p>
        <p class="tm__section-hint">Saved at /cast-make and (if it exists) /cast-make-pro. Click to open with the same settings.</p>
      </header>
      <div class="tm__comps" id="tm-comps"></div>
    </section>

    <!-- ============== SECTION 4 — STAR RANKINGS ============== -->
    <section class="tm__section" id="star-rankings">
      <header class="tm__section-head">
        <p class="tm__section-label">4 · DRUM-SCHOOL STARS</p>
        <p class="tm__section-hint">Three stars per game · four games · twelve total. Earn them at /drum-school.</p>
      </header>
      <div class="tm__rank" id="tm-rank">
        <div class="tm__rank-l">
          <p class="tm__rank-title" id="tm-rank-title">Apprentice</p>
          <p class="tm__rank-stars" id="tm-rank-stars">☆ ☆ ☆ ☆ ☆ ☆ ☆ ☆ ☆ ☆ ☆ ☆</p>
          <p class="tm__rank-hint" id="tm-rank-hint">No stars yet · play a game at /drum-school</p>
        </div>
        <div class="tm__rank-r" id="tm-rank-games"></div>
      </div>
    </section>

    <!-- ============== SECTION 5 — JOURNEY MAP ============== -->
    <section class="tm__section" id="journey-map">
      <header class="tm__section-head">
        <p class="tm__section-label">5 · JOURNEY MAP</p>
        <p class="tm__section-hint">Listen → Understand → Play → Create → Capstone. You glow brighter at the pages you've already touched.</p>
      </header>
      <div class="tm__journey" id="tm-journey"></div>
    </section>

    <p class="tm__footnote">
      State read from this device only. Clear it by removing localStorage keys
      <code>pc-ds-stars</code>, <code>pc-make-slot-*</code>, <code>pc-mp-slot-*</code>, <code>pc-cmp-recent</code>, <code>pc-cmp-plays</code>.
      The music landscape · <a href="/cast-music-pro">listen</a> · <a href="/drum-academy">understand</a> · <a href="/drum-school">play</a> · <a href="/cast-make">create</a> · <a href="/">PointCast home</a>.
    </p>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --tm-bg: #0a0610; --tm-bg-2: #170a18;
    --tm-walnut: #5a3422; --tm-flame: #f6c15e; --tm-cream: #f4e7c8;
    --tm-velvet: #1a0820; --tm-glass: rgba(244,231,200,0.04);
    --tm-line: rgba(244,231,200,0.10);
    --tm-text: #f4e7c8; --tm-text-mute: rgba(244,231,200,0.62); --tm-text-quiet: rgba(244,231,200,0.38);
    --tm-display: 'Inter Tight', system-ui, sans-serif;
    --tm-body: 'Inter', system-ui, sans-serif;
    --tm-mono: 'JetBrains Mono', ui-monospace, monospace;
    --tm-good: #a8ff3a; --tm-bad: #ff5f7a;
  }
  body { background: var(--tm-bg); color: var(--tm-text); font-family: var(--tm-body); }

  .tm { max-width: 1020px; margin: 0 auto; padding: 28px 22px 110px 22px; }

  /* ---------- TOP ---------- */
  .tm__top { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; padding: 20px 0 28px 0; border-bottom: 1px solid var(--tm-line); margin-bottom: 28px; }
  @media (max-width: 720px) { .tm__top { grid-template-columns: 1fr; } }
  .tm__kicker { font-family: var(--tm-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--tm-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .tm__title { font-family: var(--tm-display); font-weight: 800; font-size: clamp(34px, 5vw, 58px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 14px 0; color: var(--tm-text); }
  .tm__sub { font-family: var(--tm-body); font-size: 14.5px; color: var(--tm-text-mute); max-width: 620px; line-height: 1.6; margin: 0; }
  .tm__top-r { display: flex; gap: 8px; align-items: flex-start; }

  .tm__btn {
    background: var(--tm-flame); color: var(--tm-velvet);
    border: 0; padding: 10px 16px; border-radius: 8px;
    font-family: var(--tm-display); font-weight: 700; font-size: 13px;
    cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .tm__btn:hover:not(:disabled) { transform: scale(1.04); background: #ffd58a; }
  .tm__btn--ghost { background: transparent; color: var(--tm-text-mute); border: 1px solid var(--tm-line); }
  .tm__btn--ghost:hover:not(:disabled) { background: var(--tm-glass); color: var(--tm-text); border-color: var(--tm-flame); }
  .tm__btn-icon { font-size: 14px; }

  /* ---------- SECTION ---------- */
  .tm__section { margin-bottom: 28px; padding: 22px; background: var(--tm-glass); border: 1px solid var(--tm-line); border-radius: 14px; }
  .tm__section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
  .tm__section-label { font-family: var(--tm-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--tm-flame); text-transform: uppercase; margin: 0; }
  .tm__section-hint { font-family: var(--tm-body); font-size: 13px; color: var(--tm-text-mute); margin: 0; line-height: 1.5; }

  /* ---------- STATS ---------- */
  .tm__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 22px; }
  @media (max-width: 720px) { .tm__stats { grid-template-columns: repeat(2, 1fr); } }
  .tm__stat { padding: 14px 16px; background: rgba(244,231,200,0.04); border: 1px solid var(--tm-line); border-radius: 10px; }
  .tm__stat-val { font-family: var(--tm-display); font-weight: 800; font-size: clamp(22px, 3vw, 30px); color: var(--tm-flame); margin: 0 0 4px 0; letter-spacing: -0.02em; }
  .tm__stat-label { font-family: var(--tm-mono); font-size: 10px; color: var(--tm-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; margin: 0; }

  /* ---------- TILES ---------- */
  .tm__tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 880px) { .tm__tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .tm__tiles { grid-template-columns: 1fr; } }
  .tm__tile {
    background: linear-gradient(135deg, var(--tile-c, var(--tm-walnut)) 0%, var(--tm-velvet) 100%);
    border: 2px solid transparent; border-radius: 12px; padding: 16px;
    text-align: left; cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column; gap: 10px;
    min-height: 180px;
  }
  .tm__tile:hover { transform: translateY(-3px); }
  .tm__tile--visited { border-color: var(--tm-flame); box-shadow: 0 0 0 3px rgba(246,193,94,0.20); }
  .tm__tile--shipping { border-color: rgba(168,255,58,0.40); border-style: dashed; }
  .tm__tile-head { display: flex; align-items: center; gap: 10px; }
  .tm__tile-portrait { width: 44px; height: 44px; border-radius: 50%; background: rgba(0,0,0,0.30); display: grid; place-items: center; flex-shrink: 0; overflow: hidden; }
  .tm__tile-portrait img { width: 80%; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); }
  .tm__tile-name { font-family: var(--tm-display); font-weight: 700; font-size: 14.5px; color: #fff; margin: 0; line-height: 1.15; }
  .tm__tile-path { font-family: var(--tm-mono); font-size: 10px; color: rgba(255,255,255,0.62); margin: 2px 0 0 0; letter-spacing: 0.3px; }
  .tm__tile-desc { font-family: var(--tm-body); font-size: 12.5px; color: rgba(255,255,255,0.78); margin: 0; line-height: 1.45; }
  .tm__tile-badge { font-family: var(--tm-mono); font-size: 9.5px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--tm-good); padding: 3px 7px; border-radius: 4px; background: rgba(168,255,58,0.10); border: 1px solid rgba(168,255,58,0.30); align-self: flex-start; margin-top: auto; }
  .tm__tile-badge--visited { color: var(--tm-flame); background: rgba(246,193,94,0.12); border-color: rgba(246,193,94,0.40); }
  .tm__tile-badge--new { color: var(--tm-good); }

  /* ---------- RECENT ---------- */
  .tm__recent { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  @media (max-width: 880px) { .tm__recent { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .tm__recent { grid-template-columns: repeat(2, 1fr); } }
  .tm__recent-card {
    background: rgba(244,231,200,0.04); border: 1px solid var(--tm-line); border-radius: 10px;
    padding: 12px; text-align: left; text-decoration: none; color: inherit;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .tm__recent-card:hover { background: rgba(244,231,200,0.10); border-color: var(--tm-flame); transform: translateY(-2px); }
  .tm__recent-portrait { width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, var(--rc, var(--tm-walnut)), var(--tm-velvet)); display: grid; place-items: center; }
  .tm__recent-portrait img { width: 80%; image-rendering: pixelated; }
  .tm__recent-name { font-family: var(--tm-display); font-weight: 700; font-size: 12.5px; color: var(--tm-text); margin: 0; line-height: 1.2; text-align: center; }
  .tm__recent-artist { font-family: var(--tm-mono); font-size: 9.5px; color: var(--tm-text-quiet); margin: 0; letter-spacing: 0.3px; text-align: center; }

  /* ---------- COMPS ---------- */
  .tm__comps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  @media (max-width: 880px) { .tm__comps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .tm__comps { grid-template-columns: 1fr; } }
  .tm__comp {
    background: linear-gradient(135deg, var(--cc, var(--tm-walnut)) 0%, var(--tm-velvet) 100%);
    border: 1px solid var(--tm-line); border-radius: 10px;
    padding: 14px; cursor: pointer; text-decoration: none; color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
    display: flex; flex-direction: column; gap: 8px;
  }
  .tm__comp:hover { transform: translateY(-2px); border-color: var(--tm-flame); }
  .tm__comp-head { display: flex; align-items: center; gap: 10px; }
  .tm__comp-portrait { width: 40px; height: 40px; border-radius: 50%; background: rgba(0,0,0,0.30); display: grid; place-items: center; flex-shrink: 0; }
  .tm__comp-portrait img { width: 80%; image-rendering: pixelated; }
  .tm__comp-slot { font-family: var(--tm-mono); font-size: 10px; color: #fff; letter-spacing: 0.5px; text-transform: uppercase; }
  .tm__comp-kit { font-family: var(--tm-display); font-weight: 700; font-size: 14px; color: #fff; margin: 0; line-height: 1.2; }
  .tm__comp-meta { display: flex; gap: 12px; font-family: var(--tm-mono); font-size: 10.5px; color: rgba(255,255,255,0.72); letter-spacing: 0.3px; }
  .tm__comp-meta span { display: inline-flex; align-items: center; gap: 4px; }
  .tm__comp-open { font-family: var(--tm-mono); font-size: 10px; color: var(--tm-flame); letter-spacing: 0.5px; text-transform: uppercase; margin-top: 4px; }

  /* ---------- RANK ---------- */
  .tm__rank { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 720px) { .tm__rank { grid-template-columns: 1fr; } }
  .tm__rank-l { padding: 18px; background: rgba(246,193,94,0.06); border: 1px solid rgba(246,193,94,0.20); border-radius: 12px; }
  .tm__rank-title { font-family: var(--tm-display); font-weight: 800; font-size: clamp(26px, 4vw, 36px); color: var(--tm-flame); margin: 0 0 6px 0; letter-spacing: -0.01em; }
  .tm__rank-stars { font-family: var(--tm-mono); font-size: 18px; color: var(--tm-flame); margin: 0 0 8px 0; letter-spacing: 1px; }
  .tm__rank-hint { font-family: var(--tm-body); font-size: 13px; color: var(--tm-text-mute); margin: 0; line-height: 1.5; }
  .tm__rank-r { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-content: start; }
  .tm__rank-game {
    background: rgba(244,231,200,0.04); border: 1px solid var(--tm-line);
    border-radius: 8px; padding: 10px 12px;
    display: flex; align-items: center; gap: 10px;
  }
  .tm__rank-game-portrait { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--gc, var(--tm-walnut)), var(--tm-velvet)); display: grid; place-items: center; flex-shrink: 0; }
  .tm__rank-game-portrait img { width: 80%; image-rendering: pixelated; }
  .tm__rank-game-info { flex: 1; min-width: 0; }
  .tm__rank-game-name { font-family: var(--tm-display); font-weight: 700; font-size: 12px; color: var(--tm-text); margin: 0; line-height: 1.2; }
  .tm__rank-game-stars { font-family: var(--tm-mono); font-size: 12px; color: var(--tm-flame); margin: 2px 0 0 0; letter-spacing: 0.5px; }

  /* ---------- JOURNEY ---------- */
  .tm__journey {
    position: relative;
    padding: 20px 8px 40px 8px;
    overflow-x: auto;
  }
  .tm__journey-rail { display: flex; align-items: stretch; gap: 0; min-width: 760px; position: relative; padding-top: 28px; }
  .tm__journey-stage {
    flex: 1; min-width: 100px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    position: relative;
    text-decoration: none; color: inherit;
  }
  .tm__journey-stage::before {
    content: ''; position: absolute; top: 36px; right: -50%; width: 100%; height: 2px;
    background: var(--tm-line); z-index: 0;
  }
  .tm__journey-stage:last-child::before { display: none; }
  .tm__journey-stage--visited::before { background: var(--tm-flame); }
  .tm__journey-node {
    width: 72px; height: 72px; border-radius: 50%;
    background: linear-gradient(135deg, var(--jc, var(--tm-walnut)), var(--tm-velvet));
    border: 2px solid var(--tm-line);
    display: grid; place-items: center;
    position: relative; z-index: 1;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tm__journey-stage:hover .tm__journey-node { transform: scale(1.06); }
  .tm__journey-stage--visited .tm__journey-node { border-color: var(--tm-flame); box-shadow: 0 0 0 4px rgba(246,193,94,0.18); }
  .tm__journey-node img { width: 72%; image-rendering: pixelated; opacity: 0.5; filter: grayscale(0.4); transition: opacity 0.15s ease, filter 0.15s ease; }
  .tm__journey-stage--visited .tm__journey-node img { opacity: 1; filter: none; }
  .tm__journey-arc { font-family: var(--tm-mono); font-size: 9.5px; letter-spacing: 0.5px; color: var(--tm-text-quiet); text-transform: uppercase; margin: 0; text-align: center; }
  .tm__journey-stage--visited .tm__journey-arc { color: var(--tm-flame); }
  .tm__journey-name { font-family: var(--tm-display); font-weight: 700; font-size: 12.5px; color: var(--tm-text); margin: 0; text-align: center; line-height: 1.15; }
  .tm__journey-path { font-family: var(--tm-mono); font-size: 9.5px; color: var(--tm-text-quiet); margin: 0; letter-spacing: 0.3px; text-align: center; }
  .tm__journey-progress { font-family: var(--tm-mono); font-size: 9px; color: var(--tm-good); margin: 0; letter-spacing: 0.4px; text-transform: uppercase; }

  /* ---------- EMPTY ---------- */
  .tm__empty {
    padding: 22px 18px; text-align: center;
    background: rgba(244,231,200,0.03); border: 1px dashed var(--tm-line); border-radius: 10px;
  }
  .tm__empty-msg { font-family: var(--tm-body); font-size: 14px; color: var(--tm-text-mute); margin: 0 0 6px 0; line-height: 1.5; }
  .tm__empty-cta { font-family: var(--tm-mono); font-size: 11px; color: var(--tm-flame); text-decoration: none; letter-spacing: 0.5px; text-transform: uppercase; }
  .tm__empty-cta:hover { text-decoration: underline; }

  /* ---------- FOOTNOTE ---------- */
  .tm__footnote { font-family: var(--tm-mono); font-size: 10.5px; color: var(--tm-text-quiet); text-align: center; margin-top: 22px; line-height: 1.8; }
  .tm__footnote a { color: var(--tm-flame); text-decoration: none; }
  .tm__footnote a:hover { text-decoration: underline; }
  .tm__footnote code { background: rgba(244,231,200,0.06); padding: 1px 5px; border-radius: 3px; color: var(--tm-text-mute); font-size: 10px; }
</style>

<script>
  // ===========================================================
  //  TOWN · MUSIC  —  discovery dashboard for the 8 music pages
  //  All state read from localStorage; "refresh" re-reads.
  // ===========================================================

  // ---------- Page tiles ----------
  interface PageTile {
    name: string; path: string; desc: string;
    nounId: number; color: string;
    arc: 'listen' | 'understand' | 'play' | 'create' | 'capstone';
    visitKey: string | null;
    shipping?: boolean;
  }

  const PAGES: PageTile[] = [
    { name: 'Cast Music Pro',  path: '/cast-music-pro',  desc: 'Spotify-shaped player. Curated tracks, mixes, playlists.',  nounId: 1042, color: '#ffd400', arc: 'listen',     visitKey: 'pc-cmp-recent' },
    { name: 'Cast Studio',     path: '/cast-studio',     desc: 'Synth depth + mastering bus. The producer surface.',       nounId: 287,  color: '#f6c15e', arc: 'listen',     visitKey: 'pc-cs-visited' },
    { name: 'Cast Real',       path: '/cast-real',       desc: 'Real recorded instruments via CDN soundfonts.',             nounId: 612,  color: '#ff5f7a', arc: 'listen',     visitKey: 'pc-cr-visited' },
    { name: 'Drum Academy',    path: '/drum-academy',    desc: 'Five Web Audio lessons. Physics of sound, in pieces.',     nounId: 1189, color: '#6f59c0', arc: 'understand', visitKey: 'pc-da-visited' },
    { name: 'Drum School',     path: '/drum-school',     desc: 'Four mini-games. Star system. Train your ear.',            nounId: 313,  color: '#9ed6f0', arc: 'play',       visitKey: 'pc-ds-stars' },
    { name: 'Cast Make',       path: '/cast-make',       desc: '4-bar composer. Save 3 to this device. Share by URL.',     nounId: 523,  color: '#a8ff3a', arc: 'create',     visitKey: 'pc-make-slot-1' },
    { name: 'Cast Make Pro',   path: '/cast-make-pro',   desc: '8-bar pro composer. Eight slots. Just shipping tonight.',  nounId: 928,  color: '#7d9a7c', arc: 'create',     visitKey: 'pc-mp-slot-1', shipping: true },
    { name: 'Cast Graduate',   path: '/cast-graduate',   desc: 'Capstone diploma. The end-of-arc page.',                    nounId: 999,  color: '#e6c2a0', arc: 'capstone',   visitKey: 'pc-cg-visited', shipping: true },
  ];

  const ARC_LABEL: Record<string, string> = {
    listen:     'Listen',
    understand: 'Understand',
    play:       'Play',
    create:     'Create',
    capstone:   'Capstone',
  };

  // ---------- cast-make Kit/Lead definitions (copy of cast-make.astro's data) ----------
  // Needed to (a) name kits and (b) re-encode saved comps into the share-hash format.
  type KitId = 'fog' | 'block' | 'brass' | 'friday';
  interface Kit { id: KitId; name: string; nounId: number; color: string }
  const KITS: Kit[] = [
    { id: 'fog',    name: 'Marine Layer',  nounId: 313, color: '#9ed6f0' },
    { id: 'block',  name: 'Block Runner',  nounId: 523, color: '#a8ff3a' },
    { id: 'brass',  name: 'Brass on Main', nounId: 287, color: '#f6c15e' },
    { id: 'friday', name: 'Friday Five',   nounId: 612, color: '#ff5f7a' },
  ];
  const CHORD_CYCLE = ['I', 'IV', 'V', 'vi'];
  const LEAD_SHAPES = ['silent', 'arp', 'phrase', 'horn'];

  // ---------- cast-music-pro TRACKS (subset — id + name + nounId + color for the "recent" cards) ----------
  // Mirrors cast-music-pro.astro; only the metadata the dashboard needs.
  interface TrackMeta { id: string; name: string; artist: string; artistId: number; color: string }
  const TRACK_LOOKUP: Record<string, TrackMeta> = {
    'morning-fog':       { id: 'morning-fog',       name: 'Morning Fog',          artist: 'Marine Layer',    artistId: 313,  color: '#9ed6f0' },
    'foghorn-letter':    { id: 'foghorn-letter',    name: 'Foghorn Letter',       artist: 'Marine Layer',    artistId: 313,  color: '#9ed6f0' },
    'block-runner-funk': { id: 'block-runner-funk', name: 'Block Runner Funk',    artist: 'Block Runner',    artistId: 523,  color: '#a8ff3a' },
    'sidewalk-claps':    { id: 'sidewalk-claps',    name: 'Sidewalk Claps',       artist: 'Block Runner',    artistId: 523,  color: '#a8ff3a' },
    'sunrise-imperial':  { id: 'sunrise-imperial',  name: 'Sunrise on Imperial',  artist: 'Release Train',   artistId: 1042, color: '#ffd400' },
    'platform-9':        { id: 'platform-9',        name: 'Platform 9',           artist: 'Release Train',   artistId: 1042, color: '#ffd400' },
    'el-segundo-dusk':   { id: 'el-segundo-dusk',   name: 'El Segundo at Dusk',   artist: 'Night Broadcast', artistId: 1189, color: '#6f59c0' },
    'late-station':      { id: 'late-station',      name: 'Late Station',         artist: 'Night Broadcast', artistId: 1189, color: '#6f59c0' },
    'brass-on-main':     { id: 'brass-on-main',     name: 'Brass on Main',        artist: 'Brass on Main',   artistId: 287,  color: '#f6c15e' },
    'aurora-slow':       { id: 'aurora-slow',       name: 'Aurora Slow',          artist: 'Aurora Slow',     artistId: 928,  color: '#7d9a7c' },
  };

  // ---------- localStorage helpers ----------
  function lsGet<T>(key: string, fallback: T): T {
    try {
      const v = localStorage.getItem(key);
      if (v == null) return fallback;
      return JSON.parse(v) as T;
    } catch { return fallback; }
  }
  function lsHas(key: string): boolean {
    try { return localStorage.getItem(key) != null; } catch { return false; }
  }
  function lsAllKeys(prefix: string): string[] {
    const out: string[] = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.startsWith(prefix)) out.push(k);
      }
    } catch {}
    return out;
  }

  // ---------- cast-make share-hash encoder (mirror of cast-make.astro) ----------
  function encodeCompForShare(comp: any): string | null {
    try {
      const kitIdx = KITS.findIndex(k => k.id === comp.kit);
      if (kitIdx < 0) return null;
      const leadIdx = LEAD_SHAPES.indexOf(comp.lead);
      if (leadIdx < 0) return null;
      if (!Array.isArray(comp.chords) || comp.chords.length !== 4) return null;
      const chordIdx = comp.chords.map((s: string) => CHORD_CYCLE.indexOf(s));
      if (chordIdx.some((n: number) => n < 0)) return null;
      const pack = (lane: any) => {
        if (!Array.isArray(lane) || lane.length !== 16) return 0;
        return lane.reduce((acc: number, v: any, i: number) => acc | (v ? (1 << i) : 0), 0);
      };
      const obj = {
        v: 1,
        k: kitIdx,
        b: typeof comp.bpm === 'number' ? comp.bpm : 96,
        c: chordIdx,
        l: leadIdx,
        kk: pack(comp.drums?.kick),
        sn: pack(comp.drums?.snare),
        hh: pack(comp.drums?.hat),
      };
      return btoa(JSON.stringify(obj)).replace(/=+$/, '');
    } catch { return null; }
  }

  // ---------- Stats ----------
  interface Stars { beat: number; chord: number; interval: number; rhythm: number }
  function loadStars(): Stars {
    return lsGet<Stars>('pc-ds-stars', { beat: 0, chord: 0, interval: 0, rhythm: 0 });
  }
  function totalStars(s: Stars) { return (s.beat || 0) + (s.chord || 0) + (s.interval || 0) + (s.rhythm || 0); }

  function countCompositions(): number {
    let n = 0;
    for (let i = 1; i <= 3; i++) if (lsHas(`pc-make-slot-${i}`)) n++;
    for (let i = 1; i <= 8; i++) if (lsHas(`pc-mp-slot-${i}`)) n++;
    return n;
  }

  function totalPlays(): number {
    const plays = lsGet<Record<string, number>>('pc-cmp-plays', {});
    let total = 0;
    Object.values(plays).forEach(n => { if (typeof n === 'number') total += n; });
    return total;
  }

  function visitedPages(): string[] {
    return PAGES.filter(p => p.visitKey && lsHas(p.visitKey)).map(p => p.path);
  }

  // ---------- Rank tiers ----------
  // 12 stars max in the base game set; 21 once games 5-7 ship.
  // Thresholds picked so a first-game-perfect lands at Novice and a full
  // sweep lands at Maestro.
  function rankFor(total: number): { title: string; hint: string } {
    if (total >= 12) return { title: 'Maestro',    hint: 'Full sweep · twelve stars · the whole room knows your name.' };
    if (total >= 9)  return { title: 'Composer',   hint: 'Three games clean · one game to go.' };
    if (total >= 6)  return { title: 'Player',     hint: 'Halfway. Two more games clean and you flip the title.' };
    if (total >= 3)  return { title: 'Novice',     hint: 'One game clean. Pick another at /drum-school.' };
    if (total >= 1)  return { title: 'Apprentice', hint: 'Stars on the board. Keep going.' };
    return { title: 'Apprentice', hint: 'No stars yet · play a game at /drum-school' };
  }

  // ---------- Rendering ----------
  function $(id: string) { return document.getElementById(id); }

  function renderStats() {
    const s = loadStars();
    const t = totalStars(s);
    const comps = countCompositions();
    const plays = totalPlays();
    const visited = visitedPages().length;

    ($('tm-stat-stars') as HTMLParagraphElement).textContent = `${t} / 12`;
    ($('tm-stat-comps') as HTMLParagraphElement).textContent = String(comps);
    ($('tm-stat-plays') as HTMLParagraphElement).textContent = String(plays);
    ($('tm-stat-visited') as HTMLParagraphElement).textContent = `${visited} / 8`;
  }

  function renderTiles() {
    const wrap = $('tm-tiles')!;
    wrap.innerHTML = PAGES.map(p => {
      const visited = !!(p.visitKey && lsHas(p.visitKey));
      const cls = `tm__tile ${visited ? 'tm__tile--visited' : ''} ${p.shipping ? 'tm__tile--shipping' : ''}`;
      const badge = visited
        ? `<span class="tm__tile-badge tm__tile-badge--visited">visited</span>`
        : p.shipping
        ? `<span class="tm__tile-badge tm__tile-badge--new">shipping tonight</span>`
        : `<span class="tm__tile-badge">${ARC_LABEL[p.arc] || p.arc}</span>`;
      return `<a class="${cls}" href="${p.path}" style="--tile-c: ${p.color};">
        <div class="tm__tile-head">
          <div class="tm__tile-portrait"><img src="https://noun.pics/${p.nounId}.svg" alt="" loading="lazy"/></div>
          <div>
            <p class="tm__tile-name">${p.name}</p>
            <p class="tm__tile-path">${p.path}</p>
          </div>
        </div>
        <p class="tm__tile-desc">${p.desc}</p>
        ${badge}
      </a>`;
    }).join('');
  }

  function renderRecent() {
    const wrap = $('tm-recent')!;
    const recent = lsGet<string[]>('pc-cmp-recent', []);
    const valid = recent.filter(id => TRACK_LOOKUP[id]).slice(0, 5);
    if (valid.length === 0) {
      wrap.innerHTML = `<div class="tm__empty" style="grid-column: 1 / -1;">
        <p class="tm__empty-msg">Nothing played yet on this device.</p>
        <a href="/cast-music-pro" class="tm__empty-cta">→ Visit /cast-music-pro to start listening</a>
      </div>`;
      return;
    }
    wrap.innerHTML = valid.map(id => {
      const t = TRACK_LOOKUP[id];
      return `<a class="tm__recent-card" href="/cast-music-pro" style="--rc: ${t.color};">
        <div class="tm__recent-portrait"><img src="https://noun.pics/${t.artistId}.svg" alt="" loading="lazy"/></div>
        <p class="tm__recent-name">${t.name}</p>
        <p class="tm__recent-artist">${t.artist}</p>
      </a>`;
    }).join('');
  }

  function renderComps() {
    const wrap = $('tm-comps')!;
    const cards: string[] = [];

    // cast-make (3 slots)
    for (let i = 1; i <= 3; i++) {
      const raw = (() => { try { return localStorage.getItem(`pc-make-slot-${i}`); } catch { return null; } })();
      if (!raw) continue;
      try {
        const c = JSON.parse(raw);
        const kit = KITS.find(k => k.id === c.kit);
        if (!kit) continue;
        const hash = encodeCompForShare(c);
        const href = hash ? `/cast-make#${hash}` : '/cast-make';
        cards.push(`<a class="tm__comp" href="${href}" style="--cc: ${kit.color};">
          <div class="tm__comp-head">
            <div class="tm__comp-portrait"><img src="https://noun.pics/${kit.nounId}.svg" alt="" loading="lazy"/></div>
            <div>
              <span class="tm__comp-slot">cast-make · slot ${i}</span>
              <p class="tm__comp-kit">${kit.name}</p>
            </div>
          </div>
          <div class="tm__comp-meta">
            <span>${c.bpm || 96} BPM</span>
            <span>${(c.chords || []).join(' · ')}</span>
          </div>
          <p class="tm__comp-open">→ open in cast-make</p>
        </a>`);
      } catch {}
    }

    // cast-make-pro (8 slots, optional shape)
    for (let i = 1; i <= 8; i++) {
      const raw = (() => { try { return localStorage.getItem(`pc-mp-slot-${i}`); } catch { return null; } })();
      if (!raw) continue;
      try {
        const c = JSON.parse(raw);
        // Try to look up kit by id; fall back to a neutral card if the schema differs.
        const kit = KITS.find(k => k.id === c.kit);
        const color = kit?.color || c.color || '#7d9a7c';
        const nounId = kit?.nounId || c.nounId || 928;
        const name = kit?.name || c.name || `Pro slot ${i}`;
        const bpm = c.bpm || 96;
        const chords = (Array.isArray(c.chords) ? c.chords.slice(0, 8) : []).join(' · ');
        cards.push(`<a class="tm__comp" href="/cast-make-pro" style="--cc: ${color};">
          <div class="tm__comp-head">
            <div class="tm__comp-portrait"><img src="https://noun.pics/${nounId}.svg" alt="" loading="lazy"/></div>
            <div>
              <span class="tm__comp-slot">cast-make-pro · slot ${i}</span>
              <p class="tm__comp-kit">${name}</p>
            </div>
          </div>
          <div class="tm__comp-meta">
            <span>${bpm} BPM</span>
            ${chords ? `<span>${chords}</span>` : ''}
          </div>
          <p class="tm__comp-open">→ open in cast-make-pro</p>
        </a>`);
      } catch {}
    }

    if (cards.length === 0) {
      wrap.innerHTML = `<div class="tm__empty" style="grid-column: 1 / -1;">
        <p class="tm__empty-msg">No compositions saved on this device yet.</p>
        <a href="/cast-make" class="tm__empty-cta">→ Save your first at /cast-make</a>
      </div>`;
      return;
    }
    wrap.innerHTML = cards.join('');
  }

  function renderRank() {
    const s = loadStars();
    const t = totalStars(s);
    const r = rankFor(t);

    ($('tm-rank-title') as HTMLParagraphElement).textContent = r.title;
    const stars = '★'.repeat(t) + '☆'.repeat(Math.max(0, 12 - t));
    // Add spaces every 3 for readability
    const formatted = stars.replace(/(.{3})/g, '$1 ').trim();
    ($('tm-rank-stars') as HTMLParagraphElement).textContent = formatted;
    ($('tm-rank-hint') as HTMLParagraphElement).textContent = r.hint;

    const games: { id: keyof Stars; name: string; nounId: number; color: string }[] = [
      { id: 'beat',     name: 'Beat Keeper',  nounId: 313,  color: '#9ed6f0' },
      { id: 'chord',    name: 'Chord Ear',    nounId: 1189, color: '#6f59c0' },
      { id: 'interval', name: 'Interval Ear', nounId: 287,  color: '#f6c15e' },
      { id: 'rhythm',   name: 'Rhythm Echo',  nounId: 612,  color: '#ff5f7a' },
    ];
    const games_wrap = $('tm-rank-games')!;
    games_wrap.innerHTML = games.map(g => {
      const got = s[g.id] || 0;
      const fill = '★'.repeat(got) + '☆'.repeat(3 - got);
      return `<div class="tm__rank-game" style="--gc: ${g.color};">
        <div class="tm__rank-game-portrait"><img src="https://noun.pics/${g.nounId}.svg" alt="" loading="lazy"/></div>
        <div class="tm__rank-game-info">
          <p class="tm__rank-game-name">${g.name}</p>
          <p class="tm__rank-game-stars">${fill}</p>
        </div>
      </div>`;
    }).join('');
  }

  function renderJourney() {
    const wrap = $('tm-journey')!;
    // Order matters — the arc tells a story: Listen → Understand → Play → Create → Capstone.
    const ARC_ORDER: Array<{ arc: PageTile['arc']; pages: PageTile[] }> = [];
    const groups: Record<string, PageTile[]> = { listen: [], understand: [], play: [], create: [], capstone: [] };
    PAGES.forEach(p => { groups[p.arc].push(p); });
    (['listen', 'understand', 'play', 'create', 'capstone'] as const).forEach(arc => {
      if (groups[arc].length) ARC_ORDER.push({ arc, pages: groups[arc] });
    });

    // Each arc gets one row; each page within the arc becomes its own stop on the path.
    // Flatten into a single rail, but tag arc transitions.
    const flat: PageTile[] = [];
    ARC_ORDER.forEach(g => flat.push(...g.pages));
    const visited = new Set(visitedPages());

    const html = `<div class="tm__journey-rail">
      ${flat.map((p) => {
        const isVisited = visited.has(p.path);
        const cls = `tm__journey-stage ${isVisited ? 'tm__journey-stage--visited' : ''}`;
        return `<a class="${cls}" href="${p.path}" style="--jc: ${p.color};">
          <p class="tm__journey-arc">${ARC_LABEL[p.arc]}</p>
          <div class="tm__journey-node"><img src="https://noun.pics/${p.nounId}.svg" alt="" loading="lazy"/></div>
          <p class="tm__journey-name">${p.name}</p>
          <p class="tm__journey-path">${p.path}</p>
          ${isVisited ? `<p class="tm__journey-progress">★ visited</p>` : ''}
        </a>`;
      }).join('')}
    </div>`;
    wrap.innerHTML = html;
  }

  function renderAll() {
    renderStats();
    renderTiles();
    renderRecent();
    renderComps();
    renderRank();
    renderJourney();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderAll();

    $('tm-refresh')?.addEventListener('click', () => {
      const btn = $('tm-refresh') as HTMLButtonElement;
      const orig = btn.innerHTML;
      btn.innerHTML = '<span class="tm__btn-icon">⟳</span> reading…';
      btn.disabled = true;
      // Tiny delay so the button label actually paints — purely cosmetic
      // so users see something changed.
      setTimeout(() => {
        renderAll();
        btn.innerHTML = '<span class="tm__btn-icon">✓</span> updated';
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; }, 900);
      }, 80);
    });

    // Re-render if user comes back via bfcache (e.g. hit back after listening)
    window.addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) renderAll(); });
  });
</script>
</BlockLayout>
