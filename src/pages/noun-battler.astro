---
import BlockLayout from '../layouts/BlockLayout.astro';

const gameUrl = 'https://noun-battler.mhoydich.chatgpt.site';
const title = 'Noun Battler — Pacific 48';
const description =
  'A five-round CC0 Noun stat battle with 48 battlers, a local stamp book, and a portable Passport card.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: title,
  url: 'https://pointcast.xyz/noun-battler',
  description,
  gamePlatform: 'Web browser',
  numberOfPlayers: 1,
  isAccessibleForFree: true,
  applicationCategory: 'Game',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="nb-shell">
    <header class="nb-masthead">
      <a class="nb-back" href="/">POINTCAST / CH.BTL</a>
      <p class="nb-issue">PACIFIC EDITION · SET OF 48 · LOCAL PLAY</p>
    </header>

    <main class="nb-launch" aria-labelledby="nb-title">
      <section class="nb-poster">
        <div class="nb-sun" aria-hidden="true"></div>
        <div class="nb-glasses" aria-hidden="true">
          <span></span><i></i><span></span>
        </div>
        <p class="nb-overline">POINTCAST PRESENTS</p>
        <h1 id="nb-title"><span>NOUN</span> BATTLER</h1>
        <p class="nb-subtitle">PACIFIC 48</p>

        <div class="nb-stamp-row" aria-label="Edition features">
          <span>48<br />BATTLERS</span>
          <span>5<br />ROUNDS</span>
          <span>LOCAL<br />STAMPS</span>
          <span>PORTABLE<br />PASSPORT</span>
        </div>

        <div class="nb-copy">
          <p>Deal two Nouns. Call the stronger stat. Build a record that stays on this device.</p>
          <p>Stamp the visit, print the card, or carry a compact activity receipt into Tezos Passport with one optional signature.</p>
        </div>

        <div class="nb-actions">
          <a class="nb-play" href="#play">PLAY THE PACIFIC 48</a>
          <a class="nb-external" href="/noun-battler-annual">READ THE BATTLE RECORD</a>
          <a class="nb-external" href={gameUrl} target="_blank" rel="noreferrer">OPEN STANDALONE ↗</a>
        </div>

        <p class="nb-note">No wallet required. Cards and stamps are local receipts, not minted tokens.</p>
      </section>

      <aside class="nb-pass" aria-label="Noun Battler Passport specimen">
        <div class="nb-pass-top">
          <span>POINTCAST PASSPORT</span>
          <b>№ 0048</b>
        </div>
        <div class="nb-pass-mark" aria-hidden="true">⌐◨-◨</div>
        <p class="nb-pass-name">PACIFIC PLAYER</p>
        <dl>
          <div><dt>Territory</dt><dd>El Segundo / Web</dd></div>
          <div><dt>Class</dt><dd>Stat Caller</dd></div>
          <div><dt>Ledger</dt><dd>Browser-local</dd></div>
          <div><dt>Visa</dt><dd>Optional Tezos signature</dd></div>
        </dl>
        <div class="nb-seal">P48</div>
        <p class="nb-pass-foot">VALID FOR REPEATED PLAY · NO EXPIRATION</p>
      </aside>
    </main>

    <section class="nb-cabinet" id="play" aria-labelledby="cabinet-title">
      <div class="nb-cabinet-head">
        <div>
          <p>LIVE CABINET / STANDALONE APP</p>
          <h2 id="cabinet-title">Your match starts here.</h2>
        </div>
        <a href={gameUrl} target="_blank" rel="noreferrer">FULL SCREEN ↗</a>
      </div>
      <iframe
        title="Noun Battler — Pacific 48 game"
        src={gameUrl}
        loading="eager"
        allow="clipboard-write"
      ></iframe>
      <noscript><p><a href={gameUrl}>Open Noun Battler to play.</a></p></noscript>
    </section>
  </div>
</BlockLayout>

<style is:global>
  body:has(.nb-shell) {
    margin: 0;
    padding-bottom: 0;
    color: #161515;
    background: #efe6d2;
  }

  body:has(.nb-shell) #pc-fb,
  body:has(.nb-shell) #pc-spell-layer,
  body:has(.nb-shell) #cursor-room,
  body:has(.nb-shell) #pc-freshness,
  body:has(.nb-shell) #pc-first-see {
    display: none !important;
  }

  .nb-shell {
    --ink: #171514;
    --paper: #f6edda;
    --orange: #f05a28;
    --blue: #1459e8;
    --acid: #d8ef52;
    min-height: 100vh;
    overflow: hidden;
    font-family: 'Inter Variable', 'Inter', sans-serif;
    background:
      linear-gradient(90deg, rgba(23, 21, 20, .06) 1px, transparent 1px),
      linear-gradient(rgba(23, 21, 20, .045) 1px, transparent 1px),
      var(--paper);
    background-size: 24px 24px;
  }

  .nb-masthead {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(18px, 4vw, 56px);
    border-bottom: 2px solid var(--ink);
    font: 700 11px/1.2 'JetBrains Mono Variable', monospace;
    letter-spacing: .08em;
  }

  .nb-masthead p { margin: 0; text-align: right; }
  .nb-back { color: var(--ink); text-decoration: none; }

  .nb-launch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(270px, 390px);
    min-height: min(780px, calc(100vh - 42px));
    border-bottom: 2px solid var(--ink);
  }

  .nb-poster {
    position: relative;
    isolation: isolate;
    padding: clamp(42px, 7vw, 104px) clamp(22px, 7vw, 100px) 46px;
    overflow: hidden;
    border-right: 2px solid var(--ink);
  }

  .nb-poster::after {
    content: '';
    position: absolute;
    z-index: -2;
    inset: auto -12vw -30vw auto;
    width: 60vw;
    height: 60vw;
    border: 11vw solid var(--blue);
    border-radius: 50%;
    opacity: .92;
  }

  .nb-sun {
    position: absolute;
    z-index: -1;
    top: -105px;
    right: -55px;
    width: clamp(210px, 31vw, 470px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    mix-blend-mode: multiply;
  }

  .nb-glasses {
    position: absolute;
    top: clamp(74px, 9vw, 126px);
    right: clamp(25px, 8vw, 126px);
    display: flex;
    align-items: center;
    transform: rotate(-7deg);
  }

  .nb-glasses span {
    width: clamp(48px, 7vw, 96px);
    aspect-ratio: 1.25;
    border: clamp(8px, 1vw, 14px) solid var(--ink);
    background: var(--acid);
  }

  .nb-glasses i { width: clamp(14px, 2vw, 28px); height: 10px; background: var(--ink); }

  .nb-overline,
  .nb-subtitle,
  .nb-note,
  .nb-cabinet-head p {
    font-family: 'JetBrains Mono Variable', monospace;
    text-transform: uppercase;
  }

  .nb-overline { margin: 0 0 12px; font-size: 12px; letter-spacing: .18em; }
  .nb-poster h1 { margin: 0; max-width: 760px; font-size: clamp(68px, 12.8vw, 184px); line-height: .72; letter-spacing: -.085em; text-transform: uppercase; }
  .nb-poster h1 span { display: block; color: var(--blue); }
  .nb-subtitle { margin: 26px 0 0; color: var(--orange); font-size: clamp(23px, 3.5vw, 52px); font-weight: 800; letter-spacing: .25em; }

  .nb-stamp-row { display: flex; flex-wrap: wrap; gap: 10px; margin: clamp(38px, 6vw, 78px) 0 30px; }
  .nb-stamp-row span { display: grid; place-items: center; min-width: 92px; aspect-ratio: 1.05; padding: 10px; border: 2px dashed var(--ink); background: rgba(246, 237, 218, .82); font: 800 12px/1.15 'JetBrains Mono Variable', monospace; text-align: center; transform: rotate(-2deg); }
  .nb-stamp-row span:nth-child(even) { transform: rotate(2deg); background: var(--acid); }
  .nb-copy { max-width: 680px; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; font-size: 16px; line-height: 1.45; }
  .nb-copy p { margin: 0; }
  .nb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 32px; }
  .nb-play, .nb-external { font: 800 13px/1 'JetBrains Mono Variable', monospace; text-decoration: none; }
  .nb-play { padding: 17px 20px; color: #fff; background: var(--ink); box-shadow: 6px 6px 0 var(--orange); }
  .nb-external { color: var(--ink); border-bottom: 2px solid; }
  .nb-note { margin: 25px 0 0; max-width: 600px; font-size: 10px; line-height: 1.5; }

  .nb-pass {
    position: relative;
    align-self: center;
    margin: 30px;
    padding: 24px;
    border: 3px solid var(--ink);
    background: var(--acid);
    box-shadow: 12px 12px 0 var(--blue);
    transform: rotate(1.5deg);
  }
  .nb-pass-top { display: flex; justify-content: space-between; gap: 10px; padding-bottom: 10px; border-bottom: 2px solid; font: 800 10px/1.2 'JetBrains Mono Variable', monospace; }
  .nb-pass-mark { display: grid; place-items: center; height: 170px; margin: 18px 0; color: var(--acid); background: var(--blue); font: 900 clamp(40px, 5vw, 72px)/1 monospace; letter-spacing: -.14em; }
  .nb-pass-name { margin: 0 0 18px; font-size: 28px; font-weight: 900; letter-spacing: -.04em; }
  .nb-pass dl { display: grid; gap: 8px; margin: 0; font: 10px/1.3 'JetBrains Mono Variable', monospace; }
  .nb-pass dl div { display: flex; justify-content: space-between; gap: 15px; padding-bottom: 6px; border-bottom: 1px solid; }
  .nb-pass dd { margin: 0; text-align: right; font-weight: 800; }
  .nb-seal { display: grid; place-items: center; width: 70px; aspect-ratio: 1; margin: 22px auto 12px; border: 4px double var(--orange); border-radius: 50%; color: var(--orange); font: 900 19px/1 monospace; transform: rotate(-10deg); }
  .nb-pass-foot { margin: 0; text-align: center; font: 700 9px/1.4 'JetBrains Mono Variable', monospace; }

  .nb-cabinet { padding: clamp(22px, 4vw, 56px); background: var(--ink); }
  .nb-cabinet-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; color: #fff; }
  .nb-cabinet-head p { margin: 0 0 7px; color: var(--acid); font-size: 10px; }
  .nb-cabinet-head h2 { margin: 0; font-size: clamp(25px, 4vw, 56px); line-height: 1; }
  .nb-cabinet-head a { color: #fff; font: 800 11px/1 monospace; }
  .nb-cabinet iframe { display: block; width: 100%; height: min(900px, 90svh); border: 2px solid #fff; background: var(--paper); }

  @media (max-width: 860px) {
    .nb-launch { grid-template-columns: 1fr; }
    .nb-poster { border-right: 0; border-bottom: 2px solid var(--ink); }
    .nb-pass { width: min(70vw, 390px); justify-self: center; }
    .nb-glasses { opacity: .42; }
  }

  @media (max-width: 560px) {
    .nb-masthead { font-size: 9px; }
    .nb-poster { padding-top: 44px; }
    .nb-poster h1 { font-size: clamp(65px, 24vw, 108px); }
    .nb-subtitle { font-size: 20px; letter-spacing: .14em; }
    .nb-copy { grid-template-columns: 1fr; gap: 12px; }
    .nb-stamp-row span { min-width: calc(50% - 8px); box-sizing: border-box; aspect-ratio: 1.45; }
    .nb-pass { width: auto; margin: 26px 20px 38px; }
    .nb-cabinet { padding: 18px 12px 24px; }
    .nb-cabinet-head { align-items: start; }
    .nb-cabinet iframe { height: 88svh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nb-pass, .nb-glasses, .nb-stamp-row span { transform: none; }
  }
</style>
