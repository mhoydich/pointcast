---
/**
 * /drum-runner-v1 — the original endless Beat Runner.
 * while cones and crates roll in from the right, locked to the beat grid.
 * Tap SPACE (or the stage) to JUMP a parabolic arc — clear the obstacle
 * while airborne. Jumping on the beat before it arrives is the cleanest
 * line and banks flow. Clip one and you lose a life; three and you wipe out.
 *
 * Distance in meters is the score. Speed and BPM ramp up the further you
 * get, and a synth groove rides the whole run — kick, hats, snare, bass,
 * all clocked off the same world grid the obstacles spawn on. Best in
 * localStorage. Clean clears broadcast on the shared /api/sounds bus.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Beat Runner v1 · the endless original';
const description = 'Play the original endless Beat Runner. A Noun auto-runs El Segundo while the groove, speed, and obstacle grid keep climbing.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Beat Runner v1', url: 'https://pointcast.xyz/drum-runner-v1', description, gamePlatform: 'Web browser', playMode: 'SinglePlayer' };
---
<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="drn" id="drn">
    <header class="drn__hud">
      <div class="drn__hud-left">
        <span class="drn__dist" id="drn-dist">0</span>
        <span class="drn__dist-label">meters</span>
      </div>
      <div class="drn__hud-mid">
        <span class="drn__flash" id="drn-flash" role="status" aria-live="polite"></span>
      </div>
      <div class="drn__hud-right">
        <span class="drn__lives" id="drn-lives">
          <span class="drn__life"></span>
          <span class="drn__life"></span>
          <span class="drn__life"></span>
        </span>
        <span class="drn__best" id="drn-best-line">best — m</span>
      </div>
    </header>

    <section class="drn__stage" id="drn-stage">
      <canvas class="drn__canvas" id="drn-canvas" role="img" aria-label="Beat Runner playfield: a Noun runs left to right and jumps beat-timed obstacles.">Beat Runner game canvas.</canvas>
      <div class="drn__overlay" id="drn-overlay">
        <h1 class="drn__title" id="drn-title">BEAT RUNNER</h1>
        <p class="drn__sub" id="drn-sub">jump on the beat · SPACE or tap the strip</p>
        <p class="drn__best" id="drn-best">best — m</p>
        <button class="drn__go" id="drn-go" type="button">▶ START THE RUN</button>
      </div>
      <span class="drn__tap-hint" id="drn-tap-hint">tap / SPACE to jump</span>
    </section>

    <div class="drn__controls">
      <button class="drn__jump" id="drn-jump" type="button" aria-label="Jump (Space, Arrow Up, or W)">
        ↑ JUMP <span>space · ↑ · w</span>
      </button>
    </div>

    <nav class="drn__versions" aria-label="Beat Runner versions">
      <span>edition</span>
      <a href="/drum-runner-v1" aria-current="page">v1 endless</a>
      <a href="/drum-runner-v2">v2 postcards</a>
      <a href="/drum-runner-v3">v3 pocket</a>
      <a href="/drum-runner-v4">v4 road band</a>
      <a href="/drum-runner-v5">v5 bright miles</a>
      <a href="/drum-runner-v6">v6 pulse arena</a>
      <a href="/drum-runner">v7 loop siege</a>
    </nav>

    <nav class="drn__siblings" aria-label="More Drum Arcade games">
      <a href="/drum-games">all five</a>
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-quickdraw">quick draw</a>
      <a href="/drum-fill">fill</a>
      <a href="/drum-steady">steady</a>
      <a href="/drum">/drum</a>
    </nav>
  </div>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.drn) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .drn {
      max-width: 640px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 94vh;
    }

    /* HUD */
    .drn__hud {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'JetBrains Mono', monospace;
      padding: 2px 6px;
      min-height: 44px;
      gap: 10px;
    }
    .drn__hud-left { display: flex; align-items: baseline; gap: 8px; }
    .drn__dist {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 34px;
      color: #f6c15e;
      font-variant-numeric: tabular-nums;
      min-width: 52px;
      line-height: 1;
    }
    .drn__dist-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; }
    .drn__hud-mid { flex: 1; text-align: center; }
    .drn__flash {
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }
    .drn__flash--onbeat { color: #8aeac0; text-shadow: 0 0 12px rgba(138,234,192,0.7); }
    .drn__flash--clear { color: #7ac8ed; }
    .drn__flash--hit { color: #ff6b8a; text-shadow: 0 0 12px rgba(255,107,138,0.6); }
    .drn__hud-right { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
    .drn__lives { display: flex; gap: 5px; }
    .drn__life {
      width: 12px; height: 12px; border-radius: 3px;
      background: #ff6b8a;
      box-shadow: 0 0 8px rgba(255,107,138,0.5);
      transition: background 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }
    .drn__life--lost { background: rgba(120,120,140,0.28); box-shadow: none; transform: scale(0.82); }
    .drn__best { font-size: 11px; color: #d4a437; font-variant-numeric: tabular-nums; margin: 0; }

    /* STAGE */
    .drn__stage {
      position: relative;
      flex: 1;
      min-height: 400px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 78%, #1c0e2e 100%);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .drn__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    .drn__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(7,5,15,0.82);
      backdrop-filter: blur(3px);
      z-index: 3;
      text-align: center;
      padding: 20px;
    }
    .drn__overlay--hidden { display: none; }
    .drn__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(28px, 8vw, 50px);
      letter-spacing: 0.18em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .drn__sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
    }
    .drn__overlay .drn__best { color: #d4a437; font-size: 12px; }
    .drn__go {
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .drn__go:hover { transform: translateY(-1px); background: #ffd98a; }

    .drn__tap-hint {
      position: absolute;
      left: 50%; bottom: 10px;
      transform: translateX(-50%);
      z-index: 2;
      pointer-events: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(244,231,200,0.34);
      transition: opacity 220ms ease;
    }
    .drn__tap-hint--gone { opacity: 0; }

    .drn__controls { display: flex; justify-content: center; }
    .drn__jump {
      min-width: 190px;
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      border: 1px solid rgba(246,193,94,0.5);
      border-radius: 999px;
      background: rgba(246,193,94,0.1);
      color: #f6c15e;
      cursor: pointer;
      font: 800 13px/1 'JetBrains Mono', monospace;
      letter-spacing: 0.14em;
    }
    .drn__jump span { color: #8a8a9a; font-size: 9px; font-weight: 500; letter-spacing: 0.08em; }
    .drn__jump:hover { background: rgba(246,193,94,0.18); }
    .drn__jump:focus-visible { outline: 3px solid #7ac8ed; outline-offset: 3px; }

    .drn__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .drn__siblings a { color: #d4a437; text-decoration: none; }
    .drn__siblings a:hover { text-decoration: underline; }
    .drn__versions {
      display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap;
      font: 700 10px/1.4 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .08em;
    }
    .drn__versions span { color: #666477; }
    .drn__versions a { padding: 5px 8px; border: 1px solid #373346; border-radius: 999px; color: #a9a4b4; text-decoration: none; }
    .drn__versions a[aria-current="page"] { border-color: #f6c15e; color: #f6c15e; background: rgba(246,193,94,.1); }
    .drn__versions a:hover { border-color: #f6c15e; color: #f6c15e; }
    @media (prefers-reduced-motion: reduce) {
      .drn *, .drn *::before, .drn *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>

  <script>
    // ---- world & rhythm constants ----
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];
    const BASS = [55.0, 55.0, 73.42, 49.0];   // A1 A1 D2 G1 — one root per bar
    const PPM = 42;            // pixels per meter (score = worldX / PPM)
    const BEAT_PX = 150;       // one beat = this many pixels of world travel
    const BASE_SPEED = 240;    // px/s at the start line
    const MAX_SPEED = 430;     // px/s cap after the ramp
    const SPEED_RAMP = 0.95;   // px/s added per meter travelled
    const SPAWN_AHEAD = 640;   // schedule obstacles this far ahead of the runner
    const RUNNER_W = 46;
    const RUNNER_H = 52;
    const GRAV = 1900;         // px/s^2
    const JUMP_V = 604;        // px/s launch — apex ~96px, airtime ~0.64s
    const INVULN_S = 0.5;      // grace window after a clip
    const KIND_W = [24, 34, 34, 46];
    const KIND_H = [30, 42, 58, 40];

    type Ob = { ox: number; w: number; h: number; kind: number; hit: boolean; cleared: boolean };
    type Runner = { y: number; vy: number; grounded: boolean; squash: number };

    let running = false;
    let worldX = 0;
    let speed = BASE_SPEED;
    let lives = 3;
    let bonus = 0;             // flow bonus meters
    let flow = 0;              // clean-jump streak
    let bestFlow = 0;
    let clears = 0;
    let obstacles: Ob[] = [];
    let nextBeat = 6;          // beat index of the next obstacle slot
    let invuln = 0;
    let seed = 1;
    let downFlash = 0;
    let shakeMag = 0;
    let lastTs = 0;
    let rafId = 0;
    let SESSION_ID = '';
    const runner: Runner = { y: 0, vy: 0, grounded: true, squash: 0 };

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(122, t);
      o.frequency.exponentialRampToValueAtTime(44, t + 0.15);
      g.gain.setValueAtTime(0.42, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.25);
    }
    function pHat(t: number, open = false) {
      const a = ctx();
      const dur = open ? 0.14 : 0.045;
      const buf = a.createBuffer(1, Math.floor(a.sampleRate * dur), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7200;
      const g = a.createGain(); g.gain.value = open ? 0.09 : 0.06;
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    function pSnare(t: number) {
      const a = ctx();
      const buf = a.createBuffer(1, Math.floor(a.sampleRate * 0.2), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const bp = a.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1850; bp.Q.value = 0.8;
      const g = a.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.16, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      n.connect(bp).connect(g).connect(a.destination); n.start(t);
    }
    function pBass(f: number, t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      const lp = a.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 420;
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.24, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.46);
      o.connect(lp).connect(g).connect(a.destination); o.start(t); o.stop(t + 0.5);
    }
    function pJump() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'triangle';
      o.frequency.setValueAtTime(320, t);
      o.frequency.exponentialRampToValueAtTime(660, t + 0.14);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.16, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.2);
    }
    function pLand() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(150, t);
      o.frequency.exponentialRampToValueAtTime(70, t + 0.1);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.13, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.16);
    }
    function pClear() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine'; o.frequency.setValueAtTime(720, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.1, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.16);
    }
    function pChime() {
      const a = ctx(); const t = a.currentTime + 0.003;
      for (const [f, d] of [[880, 0.0], [1320, 0.02]] as [number, number][]) {
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(f, t + d);
        g.gain.setValueAtTime(0.0001, t + d);
        g.gain.exponentialRampToValueAtTime(0.12, t + d + 0.005);
        g.gain.exponentialRampToValueAtTime(0.0001, t + d + 0.24);
        o.connect(g).connect(a.destination); o.start(t + d); o.stop(t + d + 0.28);
      }
    }
    function pHurt() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(180, t);
      o.frequency.exponentialRampToValueAtTime(60, t + 0.34);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.22, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.42);
    }

    // Percussion + bass, clocked off world travel so BPM rides the speed ramp.
    function audioBeats(prev: number, cur: number) {
      const a = ctx();
      const now = a.currentTime + 0.02;
      const bPrev = Math.floor(prev / BEAT_PX);
      const bCur = Math.floor(cur / BEAT_PX);
      for (let b = bPrev + 1; b <= bCur; b++) {
        pKick(now);
        const pos = ((b % 4) + 4) % 4;
        if (pos === 2) pSnare(now);
        if (pos === 0) pBass(BASS[Math.floor(b / 4) % BASS.length], now);
        downFlash = 1;
      }
      const half = BEAT_PX / 2;
      const hPrev = Math.floor(prev / half);
      const hCur = Math.floor(cur / half);
      for (let h = hPrev + 1; h <= hCur; h++) pHat(now, h % 2 === 0);
    }

    // ---- shared bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(seedVal: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // don't flood the bus on dense clears
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: seedVal, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- noun sprite ----
    const nounImg = new Image();
    let nounReady = false;
    nounImg.onload = () => { nounReady = true; };
    function pickNoun() {
      nounReady = false;
      nounImg.src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;
    }

    // ---- canvas ----
    const canvas = document.getElementById('drn-canvas') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.max(1, Math.floor(W * DPR));
      canvas.height = Math.max(1, Math.floor(H * DPR));
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    window.addEventListener('resize', resize);

    function groundY() { return H * 0.80; }
    function runnerScreenX() { return Math.min(W * 0.26, 170); }

    function hashAt(n: number) {
      const s = Math.sin(n * 127.1 + seed * 3.3) * 43758.5453;
      return s - Math.floor(s);
    }

    // ---- spawns ----
    function pickKind(m: number): number {
      const r = Math.random();
      if (m < 150) return r < 0.6 ? 0 : 1;
      if (m < 400) return r < 0.4 ? 0 : r < 0.75 ? 1 : 2;
      return r < 0.3 ? 0 : r < 0.55 ? 1 : r < 0.8 ? 2 : 3;
    }
    function scheduleSpawns() {
      while (nextBeat * BEAT_PX < worldX + SPAWN_AHEAD) {
        const m = worldX / PPM;
        let minG = 5, maxG = 8;
        if (m > 120) { minG = 4; maxG = 6; }
        if (m > 320) { minG = 3; maxG = 5; }
        if (m > 650) { minG = 3; maxG = 4; }
        const kind = pickKind(m);
        obstacles.push({ ox: nextBeat * BEAT_PX, w: KIND_W[kind], h: KIND_H[kind], kind, hit: false, cleared: false });
        nextBeat += minG + Math.floor(Math.random() * (maxG - minG + 1));
      }
    }

    // ---- input / jump ----
    function jump() {
      if (!running) return;
      if (!runner.grounded) return;
      runner.vy = JUMP_V;
      runner.grounded = false;
      pJump();
      // clean = launched near a beat line (the line before the obstacle)
      const phase = ((worldX % BEAT_PX) + BEAT_PX) % BEAT_PX;
      const dist = Math.min(phase, BEAT_PX - phase);
      if (dist < BEAT_PX * 0.16) {
        flow++;
        bestFlow = Math.max(bestFlow, flow);
        bonus += 2;
        pChime();
        flashJudge('onbeat', flow > 1 ? `ON BEAT ×${flow}` : 'ON BEAT');
        if (flow % 8 === 0 && lives < 3) { lives++; updateLives(); }
      }
    }

    // ---- update ----
    function displayScore() { return Math.floor(worldX / PPM) + bonus; }

    function update(dt: number) {
      const m = worldX / PPM;
      speed = Math.min(MAX_SPEED, BASE_SPEED + m * SPEED_RAMP);
      const prevX = worldX;
      worldX += speed * dt;
      audioBeats(prevX, worldX);

      // runner physics
      if (!runner.grounded) {
        runner.y += runner.vy * dt;
        runner.vy -= GRAV * dt;
        if (runner.y <= 0) {
          runner.y = 0; runner.vy = 0; runner.grounded = true; runner.squash = 1;
          pLand();
        }
      }
      if (runner.squash > 0) runner.squash = Math.max(0, runner.squash - dt * 6);
      if (invuln > 0) invuln = Math.max(0, invuln - dt);
      if (downFlash > 0) downFlash = Math.max(0, downFlash - dt * 4);
      if (shakeMag > 0) shakeMag = Math.max(0, shakeMag - dt * 40);

      scheduleSpawns();

      // collisions & clears
      for (const o of obstacles) {
        if (o.hit || o.cleared) continue;
        const overlapX = Math.abs(worldX - o.ox) < (RUNNER_W / 2 + o.w / 2);
        if (overlapX && invuln <= 0 && runner.y < o.h - 4) {
          o.hit = true;
          lives--;
          invuln = INVULN_S;
          flow = 0;
          shakeMag = 9;
          pHurt();
          flashJudge('hit', 'CLIPPED');
          updateLives();
          continue;
        }
        if (o.ox + o.w / 2 < worldX - RUNNER_W / 2) {
          o.cleared = true;
          clears++;
          pClear();
          broadcast(o.kind);
        }
      }
      // prune obstacles well behind the runner
      if (obstacles.length > 40) {
        obstacles = obstacles.filter((o) => o.ox + o.w / 2 > worldX - W);
      }

      distEl.textContent = String(displayScore());
    }

    // ---- draw ----
    function drawBuildings(scroll: number, color: string, step: number, minH: number, maxH: number, seedShift: number) {
      const gy = groundY();
      const off = ((scroll % step) + step) % step;
      cx.fillStyle = color;
      for (let sx = -off - step; sx < W + step; sx += step) {
        const idx = Math.floor((sx + scroll) / step) + seedShift;
        const hh = minH + hashAt(idx) * (maxH - minH);
        const bw = step * (0.6 + hashAt(idx * 1.7) * 0.3);
        const bx = Math.round(sx);
        const by = Math.round(gy - hh);
        cx.fillRect(bx, by, Math.round(bw), Math.round(hh));
        // a couple of lit windows
        if (hashAt(idx * 2.3) > 0.45) {
          cx.fillStyle = 'rgba(246,193,94,0.5)';
          cx.fillRect(bx + 4, by + 6, 3, 3);
          cx.fillRect(bx + Math.round(bw) - 8, by + 12, 3, 3);
          cx.fillStyle = color;
        }
      }
    }

    function draw() {
      cx.clearRect(0, 0, W, H);
      const gy = groundY();
      const rx = runnerScreenX();

      cx.save();
      if (shakeMag > 0) {
        cx.translate((Math.random() - 0.5) * shakeMag, (Math.random() - 0.5) * shakeMag * 0.6);
      }

      // sky
      const sky = cx.createLinearGradient(0, 0, 0, gy);
      sky.addColorStop(0, '#0b0818');
      sky.addColorStop(1, '#241238');
      cx.fillStyle = sky;
      cx.fillRect(-12, 0, W + 24, gy);

      // blue-hour sun low on the horizon
      const sunG = cx.createRadialGradient(W * 0.72, gy - 30, 4, W * 0.72, gy - 30, 90);
      sunG.addColorStop(0, 'rgba(246,193,94,0.42)');
      sunG.addColorStop(1, 'rgba(246,193,94,0)');
      cx.fillStyle = sunG;
      cx.fillRect(W * 0.72 - 90, gy - 120, 180, 120);

      // parallax skyline
      drawBuildings(worldX * 0.14, '#160f2a', 74, 40, 120, 11);
      drawBuildings(worldX * 0.30, '#241635', 58, 26, 82, 47);

      // ground strip
      cx.fillStyle = '#0d0a1a';
      cx.fillRect(-12, gy, W + 24, H - gy + 12);
      cx.strokeStyle = 'rgba(246,193,94,0.55)';
      cx.lineWidth = 2;
      cx.beginPath(); cx.moveTo(-12, gy); cx.lineTo(W + 12, gy); cx.stroke();
      // scrolling sidewalk cracks
      cx.strokeStyle = 'rgba(244,231,200,0.08)';
      cx.lineWidth = 1;
      const crackStep = 46;
      const coff = ((worldX % crackStep) + crackStep) % crackStep;
      for (let x = -coff; x < W; x += crackStep) {
        cx.beginPath(); cx.moveTo(x, gy + 6); cx.lineTo(x, H); cx.stroke();
      }

      // beat ticks — the grid obstacles ride on
      const firstBeat = Math.floor((worldX - rx) / BEAT_PX) - 1;
      for (let b = firstBeat; ; b++) {
        const bx = rx + (b * BEAT_PX - worldX);
        if (bx > W + 20) break;
        if (bx < -20) continue;
        const down = ((b % 4) + 4) % 4 === 0;
        cx.strokeStyle = down
          ? `rgba(246,193,94,${0.28 + downFlash * 0.4})`
          : 'rgba(244,231,200,0.10)';
        cx.lineWidth = down ? 2 : 1;
        cx.beginPath(); cx.moveTo(bx, gy); cx.lineTo(bx, gy + (down ? 12 : 7)); cx.stroke();
      }

      // obstacles
      for (const o of obstacles) {
        const ox = rx + (o.ox - worldX);
        if (ox < -40 || ox > W + 40) continue;
        drawObstacle(o, ox, gy);
        // telegraph: a marker floats above obstacles a beat or two out
        const beatsOut = (o.ox - worldX) / BEAT_PX;
        if (!o.hit && !o.cleared && beatsOut > 0.2 && beatsOut < 2.4) {
          cx.fillStyle = `rgba(122,200,237,${0.7 - beatsOut * 0.2})`;
          cx.beginPath();
          const my = gy - o.h - 16 - Math.sin(worldX * 0.03) * 2;
          cx.moveTo(ox, my + 7); cx.lineTo(ox - 5, my); cx.lineTo(ox + 5, my);
          cx.closePath(); cx.fill();
        }
      }

      // runner shadow
      const shH = runner.y;
      const shScale = Math.max(0.35, 1 - shH / 260);
      cx.fillStyle = `rgba(0,0,0,${0.32 * shScale})`;
      cx.beginPath();
      cx.ellipse(rx, gy + 3, (RUNNER_W / 2) * shScale, 6 * shScale, 0, 0, Math.PI * 2);
      cx.fill();

      // runner
      const bob = runner.grounded ? Math.sin(worldX * 0.09) * 2 : 0;
      const squash = runner.squash;
      const rw = RUNNER_W * (1 + squash * 0.16);
      const rh = RUNNER_H * (1 - squash * 0.22);
      const flicker = invuln > 0 && Math.floor(invuln * 20) % 2 === 0;
      const rTop = gy - rh - runner.y + bob;
      if (!flicker) {
        if (nounReady) {
          cx.save();
          if (!runner.grounded) {
            cx.translate(rx, rTop + rh / 2);
            cx.rotate(Math.max(-0.35, Math.min(0.35, -runner.vy / 2600)));
            cx.drawImage(nounImg, -rw / 2, -rh / 2, rw, rh);
            cx.restore();
          } else {
            cx.drawImage(nounImg, rx - rw / 2, rTop, rw, rh);
          }
        } else {
          cx.fillStyle = '#f6c15e';
          cx.fillRect(rx - rw / 2, rTop, rw, rh);
          cx.fillStyle = '#07050f';
          cx.fillRect(rx - rw / 2 + 8, rTop + 12, 10, 6);
          cx.fillRect(rx + rw / 2 - 18, rTop + 12, 10, 6);
        }
      }

      cx.restore();
    }

    function drawObstacle(o: Ob, ox: number, gy: number) {
      const dim = o.hit;
      if (o.kind === 0) {
        // traffic cone
        cx.fillStyle = dim ? 'rgba(120,120,140,0.4)' : '#ff8a3a';
        cx.beginPath();
        cx.moveTo(ox, gy - o.h);
        cx.lineTo(ox - o.w / 2, gy);
        cx.lineTo(ox + o.w / 2, gy);
        cx.closePath(); cx.fill();
        cx.fillStyle = dim ? 'rgba(200,200,210,0.3)' : '#f4e7c8';
        cx.fillRect(ox - o.w / 2 + 3, gy - o.h * 0.55, o.w - 6, 5);
      } else if (o.kind === 3) {
        // striped barrier
        cx.fillStyle = dim ? 'rgba(120,120,140,0.4)' : '#ff6b8a';
        cx.fillRect(ox - o.w / 2, gy - o.h, o.w, o.h);
        cx.fillStyle = dim ? 'rgba(200,200,210,0.3)' : '#f4e7c8';
        for (let i = 0; i < o.w; i += 12) {
          cx.beginPath();
          cx.moveTo(ox - o.w / 2 + i, gy - o.h);
          cx.lineTo(ox - o.w / 2 + i + 6, gy - o.h);
          cx.lineTo(ox - o.w / 2 + i - 6, gy);
          cx.lineTo(ox - o.w / 2 + i - 12, gy);
          cx.closePath(); cx.fill();
        }
      } else {
        // crate (kind 1) / tall crate (kind 2)
        cx.fillStyle = dim ? 'rgba(120,120,140,0.4)' : '#d4a437';
        cx.fillRect(ox - o.w / 2, gy - o.h, o.w, o.h);
        cx.strokeStyle = dim ? 'rgba(200,200,210,0.3)' : '#07050f';
        cx.lineWidth = 2;
        cx.strokeRect(ox - o.w / 2 + 1, gy - o.h + 1, o.w - 2, o.h - 2);
        cx.beginPath();
        cx.moveTo(ox - o.w / 2, gy - o.h); cx.lineTo(ox + o.w / 2, gy);
        cx.moveTo(ox + o.w / 2, gy - o.h); cx.lineTo(ox - o.w / 2, gy);
        cx.stroke();
      }
    }

    // ---- dom & hud ----
    const distEl = document.getElementById('drn-dist')!;
    const flashEl = document.getElementById('drn-flash')!;
    const bestLine = document.getElementById('drn-best-line')!;
    const overlayBest = document.getElementById('drn-best')!;
    const overlay = document.getElementById('drn-overlay')!;
    const goBtn = document.getElementById('drn-go') as HTMLButtonElement;
    const titleEl = document.getElementById('drn-title')!;
    const subEl = document.getElementById('drn-sub')!;
    const stage = document.getElementById('drn-stage')!;
    const tapHint = document.getElementById('drn-tap-hint')!;
    const jumpBtn = document.getElementById('drn-jump') as HTMLButtonElement;
    const lifeEls = Array.from(document.querySelectorAll('.drn__life')) as HTMLElement[];

    let flashTimer = 0;
    function flashJudge(kind: 'onbeat' | 'clear' | 'hit', text: string) {
      flashEl.textContent = text;
      flashEl.className = `drn__flash drn__flash--${kind}`;
      clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => { flashEl.textContent = ''; }, 460);
    }
    function updateLives() {
      lifeEls.forEach((el, i) => el.classList.toggle('drn__life--lost', i >= lives));
    }

    // ---- run loop ----
    function frame(ts: number) {
      if (!running) return;
      const dt = Math.min((ts - lastTs) / 1000, 0.05);
      lastTs = ts;
      update(dt);
      draw();
      if (lives <= 0) { endRun(); return; }
      rafId = requestAnimationFrame(frame);
    }

    function endRun() {
      running = false;
      cancelAnimationFrame(rafId);
      const dist = displayScore();
      titleEl.textContent = 'WIPEOUT';
      subEl.textContent = `${dist} m · ${clears} cleared · ${bestFlow}× best flow`;
      goBtn.textContent = '▶ RUN IT BACK';
      try {
        const prev = Number(localStorage.getItem('pc-drum-runner-best') || 0);
        if (dist > prev) localStorage.setItem('pc-drum-runner-best', String(dist));
        const b = Math.max(dist, prev);
        bestLine.textContent = `best ${b} m`;
        overlayBest.textContent = `best ${b} m`;
      } catch {
        bestLine.textContent = `best ${dist} m`;
        overlayBest.textContent = `best ${dist} m`;
      }
      overlay.classList.remove('drn__overlay--hidden');
      goBtn.focus({ preventScroll: true });
    }

    function startRun() {
      ctx();
      resize();
      pickNoun();
      running = true;
      worldX = 0;
      speed = BASE_SPEED;
      lives = 3;
      bonus = 0; flow = 0; bestFlow = 0; clears = 0;
      obstacles = [];
      nextBeat = 6;
      invuln = 0; downFlash = 0; shakeMag = 0;
      seed = Math.random() * 1000;
      runner.y = 0; runner.vy = 0; runner.grounded = true; runner.squash = 0;
      updateLives();
      distEl.textContent = '0';
      flashEl.textContent = '';
      tapHint.classList.remove('drn__tap-hint--gone');
      overlay.classList.add('drn__overlay--hidden');
      lastTs = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    // ---- input wiring ----
    function press() {
      if (running) { jump(); tapHint.classList.add('drn__tap-hint--gone'); }
      else startRun();
    }
    goBtn.addEventListener('click', (e) => { e.stopPropagation(); startRun(); });
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement)?.id === 'drn-go') return;
      e.preventDefault();
      press();
    });
    jumpBtn.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      press();
    });
    jumpBtn.addEventListener('click', (e) => {
      if (e.detail === 0) press();
    });
    jumpBtn.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        e.preventDefault();
        press();
      }
    });
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || tag === 'button' || tag === 'a') return;
      if (e.code === 'Space' || e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        if (e.repeat) { e.preventDefault(); return; }
        e.preventDefault();
        press();
      }
    });

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    resize();
    try {
      const b = Number(localStorage.getItem('pc-drum-runner-best') || 0);
      if (b > 0) {
        bestLine.textContent = `best ${b} m`;
        overlayBest.textContent = `best ${b} m`;
      }
    } catch {}
  </script>
</BlockLayout>
