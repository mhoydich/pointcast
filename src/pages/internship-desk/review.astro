---
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/internship-desk.css';
const title = 'Internship Desk · Private learning review';
const description = 'Draft private learning-feedback queue. Activation is pending security review. No employment, payment, publication, or deployment approval.';
---
<BlockLayout title={title} description={description} author="Codex for PointCast" isolated={true} hideAds={true} noindex={true} showNetworkStrip={false} includeManifest={false} jsonLd={null} themeColor="#183e32">
  <div class="idk" id="internship-desk-review" data-idk-review>
    <nav class="idk-nav" aria-label="PointCast desk navigation">
      <a href="/">PointCast / Internship Desk</a>
      <a href="/internship-desk/">Your learning desk</a>
    </nav>
    <header class="idk-hero">
      <div>
        <p class="idk-kicker">DRAFT / activation pending security review</p>
        <h1>A careful second look.</h1>
        <p class="idk-lede">Read the work, understand the evidence, and leave useful learning feedback on the exact submitted version.</p>
        <a class="idk-button idk-outline" href="#idk-review-queue">Go to the review queue <span aria-hidden="true">↓</span></a>
      </div>
    </header>
    <aside class="idk-notice" aria-label="Review limits">
      <strong>Learning feedback only.</strong>
      <p>This draft desk is not an application, internship placement, hiring decision, or promise of pay. A review never approves employment, publication, deployment, spending, or future work. The desk does not execute submitted code, open evidence links, or accept uploads.</p>
      <p class="idk-small">The server decides whether an account can see the queue or save feedback. No private records are embedded in the page; they load only after the server checks access. Notes are not saved until you submit them; reloading the queue discards unsent notes. Retention and deletion rules remain proposed, pending approval before activation.</p>
    </aside>
    <section id="idk-review-queue" aria-labelledby="idk-review-heading">
      <p class="idk-kicker">Private review queue</p>
      <h2 id="idk-review-heading">Read first. Review the version.</h2>
      <p class="idk-small">Only records marked “Review requested” can receive feedback. You cannot review a record that belongs to your own account. All other records are read-only.</p>
      <noscript><p class="idk-notice">JavaScript is required to ask the server for this private queue. No records can be loaded or reviewed without it.</p></noscript>
      <p class="idk-status" data-idk-review-status role="status" aria-live="polite" aria-atomic="true">The private queue has not been loaded.</p>
      <div class="idk-actions">
        <a class="idk-button" data-idk-review-login href="/auth?returnTo=/internship-desk/review/" hidden>Sign in to PointCast</a>
        <button class="idk-button" data-idk-review-load type="button" disabled>Load private queue</button>
        <button class="idk-button idk-outline" data-idk-review-reload type="button" hidden disabled>Reload queue and discard notes</button>
      </div>
      <p class="idk-small" data-idk-review-empty hidden>No records were returned for this queue.</p>
      <div class="idk-review-list" data-idk-review-list aria-label="Learning records"></div>
      <div class="idk-actions"><button class="idk-button idk-outline" data-idk-review-more type="button" hidden disabled>Load more records</button></div>
    </section>
    <footer class="idk-footer">
      <p>Useful feedback names what works, what needs another pass, and what to check next.</p>
      <p class="idk-small">PointCast / Draft private learning desk / No hiring, payment, publication, or deployment authority</p>
      <a href="/internship-lab/">Open the public practice lab</a>
    </footer>
  </div>
  <script>
    import { mountInternshipDeskReview } from '../../scripts/internship-desk-review.mjs';
    const root = document.querySelector('[data-idk-review]');
    if (root) mountInternshipDeskReview(root);
  </script>
</BlockLayout>
