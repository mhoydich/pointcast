---
/**
 * /prayer-labyrinth — The Walk.
 *
 * Per Mike 2026-07-19: "ok have qwen work on next" → "just do it".
 * The room was briefed for Qwen (QWEN-BRIEF, prepped worktree, cut
 * waymarks) but the Token Plan key was still a placeholder, so cc
 * built it to the same brief.
 *
 * Fifth room of the prayer wing. A classical seven-circuit labyrinth
 * as a walking meditation: one path, no choices, mouth to center.
 * Hold and trace the path with pointer or finger — or hold the WALK
 * button and the path walks under you. Crossing into each circuit
 * sounds a soft pentatonic tone and reveals a waymark from the
 * Midjourney session (8 more pieces — 106 of 455 placed). Reaching
 * the center blooms, sounds a low chord, and offers one prayer to
 * the shared ledger — station 'labyrinth', the twelfth.
 *
 * Wandering off the path never punishes; progress just waits.
 *
 * Rooms: indigo morning, ember evening, verdigris bells, oxblood
 * votive, and this — the slate-and-moss walk.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import RoomPresenceChip from '../components/RoomPresenceChip.astro';

const title = 'Prayer Labyrinth · The Walk · PointCast';
const description =
  'A traced walking meditation — a classical seven-circuit labyrinth. Hold and follow the path; each circuit sounds a tone and reveals a waymark. The center offers a prayer.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Prayer Labyrinth — The Walk',
  url: 'https://pointcast.xyz/prayer-labyrinth',
  description,
  applicationCategory: 'MultimediaApplication',
};

const WAYMARK_ALTS = [
  'Warm morning shore at the labyrinth mouth',
  'Blue rocks resting under a pale patch sky',
  'Mossy tide chart breaking into panels',
  'Amber rooms opening onto the sea path',
  'Dark stack rising midway through the walk',
  'Teal terraces stepping down to the water',
  'Collage thickening as the path turns inward',
  'Green-framed heart of the labyrinth',
];

/**
 * Serpentine seven-circuit labyrinth path (the WALKED path, not the
 * walls). Outermost circuit first; each circuit is a 332° arc with
 * the 28° mouth gap at the bottom; radial connectors alternate sides
 * of the mouth so the coil reverses direction each circuit.
 */
const CX = 240;
const CY = 240;
const R0 = 40;       // innermost circuit radius
const STEP = 28;     // radial distance between circuits
const CIRCUITS = 7;
const GAP = 14;      // half-angle of the mouth gap, degrees

const pt = (r: number, aDeg: number): [number, number] => {
  const a = (aDeg * Math.PI) / 180;
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
};
const f = (n: number) => n.toFixed(2);

let d = '';
const boundaries: number[] = []; // analytic cumulative length at each circuit's end
let cum = 0;

// entry stub — a short tail leading into the outermost circuit
const OUTER = R0 + (CIRCUITS - 1) * STEP;
const stubLen = STEP * 0.9;
{
  const [sx, sy] = pt(OUTER + stubLen, 90 + GAP);
  const [ex, ey] = pt(OUTER, 90 + GAP);
  d += `M ${f(sx)} ${f(sy)} L ${f(ex)} ${f(ey)} `;
  cum += stubLen;
}

let dir = 1; // 1 = sweep clockwise (angle increasing), -1 = counterclockwise
for (let i = 0; i < CIRCUITS; i++) {
  const R = OUTER - i * STEP;
  const aStart = dir === 1 ? 90 + GAP : 90 - GAP;
  const aEnd = dir === 1 ? 90 - GAP : 90 + GAP;
  const sweep = dir === 1 ? 1 : 0;
  const [ex, ey] = pt(R, aEnd);
  d += `A ${f(R)} ${f(R)} 0 1 ${sweep} ${f(ex)} ${f(ey)} `;
  cum += 2 * Math.PI * R * ((360 - 2 * GAP) / 360);
  boundaries.push(cum);
  if (i < CIRCUITS - 1) {
    // radial connector inward on the side we just arrived at
    const [nx, ny] = pt(R - STEP, aEnd);
    d += `L ${f(nx)} ${f(ny)} `;
    cum += STEP;
  }
  dir = -dir;
}
// final approach: from the innermost circuit's end, walk into the center
{
  const aEnd = dir === 1 ? 90 - GAP : 90 + GAP; // where the last arc ended (dir already flipped)
  const [ix, iy] = pt(R0, aEnd);
  void ix; void iy; // path cursor is already here
  d += `L ${f(CX)} ${f(CY)} `;
  cum += R0;
}
const PATH_D = d.trim();
const ANALYTIC_LEN = cum;
const BOUNDARIES = boundaries;
---

<BlockLayout title={title} description={description} image="/images/og-prayer-labyrinth.png" jsonLd={jsonLd}>
  <main class="pl" id="pl-main">
    <RoomPresenceChip surface="walk" />

    <header class="pl__header">
      <div class="pl__chrome">
        <span class="pl__chrome-label">THE WALK</span>
        <span class="pl__sep">·</span>
        <span class="pl__chrome-label">PRAYERS</span>
        <span class="pl__total" id="pl-total">—</span>
        <span class="pl__sep">·</span>
        <span class="pl__chrome-label">WALKED</span>
        <span class="pl__total" id="pl-walked">—</span>
      </div>
      <h1 class="pl__title">PRAYER LABYRINTH</h1>
      <p class="pl__tagline">
        one path, no choices, mouth to center · hold and trace, or hold
        <span class="pl__kbd">WALK</span> and the path moves under you · the
        wing keeps its hours at <a href="/prayer-altars">/prayer-altars</a>,
        <a href="/prayer-altars-evening">/prayer-altars-evening</a>,
        <a href="/prayer-bells">/prayer-bells</a>,
        <a href="/prayer-candles">/prayer-candles</a>
      </p>
    </header>

    <section class="pl__room">
      <div class="pl__court">
        <svg
          id="pl-svg"
          class="pl__svg"
          viewBox="0 0 480 480"
          role="application"
          aria-label="Seven-circuit labyrinth. Trace the path from the mouth at the bottom to the center."
        >
          <path class="pl__stone" d={PATH_D} data-analytic={ANALYTIC_LEN} data-boundaries={JSON.stringify(BOUNDARIES)} />
          <path class="pl__walked" id="pl-walk-path" d={PATH_D} />
          <circle class="pl__heart" id="pl-heart" cx="240" cy="240" r="10" />
          <circle class="pl__bloom" id="pl-bloom" cx="240" cy="240" r="12" />
          <circle class="pl__walker" id="pl-walker" r="7" cx="240" cy="464" />
        </svg>
        <p class="pl__status" id="pl-status" aria-live="polite">begin at the mouth, at the bottom</p>
        <div class="pl__controls">
          <button class="pl__walkbtn" type="button" id="pl-hold">HOLD TO WALK</button>
          <button class="pl__againbtn" type="button" id="pl-again" hidden>WALK AGAIN</button>
        </div>
      </div>

      <aside class="pl__way">
        <div class="pl__way-frame" id="pl-way-frame">
          {WAYMARK_ALTS.map((alt, i) => (
            <img
              class:list={['pl__way-img', { 'pl__way-img--on': i === 0 }]}
              src={`/images/prayer-labyrinth/waymark-${i + 1}.jpg`}
              alt={alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              data-way={i}
            />
          ))}
        </div>
        <div class="pl__way-dots" role="list" aria-label="Circuits crossed">
          {WAYMARK_ALTS.map((_, i) => (
            <span class:list={['pl__dot', { 'pl__dot--lit': i === 0 }]} data-dot={i} role="listitem" />
          ))}
        </div>
        <p class="pl__way-caption" id="pl-way-caption">{WAYMARK_ALTS[0]}</p>
      </aside>
    </section>

    <section class="pl__how">
      <h2>HOW THIS WORKS</h2>
      <ol class="pl__how-list">
        <li>
          A classical seven-circuit labyrinth — <em>one path, no choices</em>.
          Press and hold anywhere on it, then trace. The glow follows your
          hand. Wander off and nothing bad happens; the path just waits.
          <span class="pl__kbd">HOLD TO WALK</span> (or holding
          <span class="pl__kbd">space</span>) walks it for you.
        </li>
        <li>
          Crossing into each circuit sounds one soft pentatonic tone, rising
          as you near the center, and turns a waymark — eight more pieces of
          Mike's Midjourney session, chosen as a walk from warm shore to a
          green-framed heart.
        </li>
        <li>
          The center blooms, a low chord settles, and one prayer is offered to
          the wing's perpetual ledger — station <em>labyrinth</em>, the
          twelfth, beside the ten hours and the bell.
        </li>
        <li>
          Walking is the prayer; there is no score and no clock. The whole
          session hangs at <a href="/gallery">/gallery</a>.
        </li>
      </ol>
      <p class="pl__blessing">peace be with you — solvitur ambulando</p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  /* Slate & moss — fifth room of the prayer wing. */
  body:has(#pl-main) {
    background: #101711;
  }

  .pl {
    --pl-slate: #101711;
    --pl-slate-deep: #060a06;
    --pl-moss: #7da87b;
    --pl-brass: #d4a437;
    --pl-brass-soft: #b8862c;
    --pl-brass-deep: #6b4d12;
    --pl-flame: #f6c15e;
    --pl-ink-light: #e6ead9;
    --pl-ink-mid: #a8b8a0;
    --pl-ink-dim: #657a60;
    --pl-rule-soft: rgba(212, 164, 55, 0.18);
    --pl-glow: rgba(125, 168, 123, 0.08);

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 32px 80px;
    color: var(--pl-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(125, 168, 123, 0.10), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(212, 164, 55, 0.06), transparent 70%),
      linear-gradient(180deg, var(--pl-slate) 0%, var(--pl-slate-deep) 100%);
  }

  .pl::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18px 26px, var(--pl-glow) 1px, transparent 1.5px),
      radial-gradient(circle at 64px 58px, var(--pl-glow) 1px, transparent 1.5px);
    background-size: 84px 84px;
    opacity: 0.6;
    z-index: -1;
  }

  /* ── Header ───────────────────────────────────────────── */
  .pl__header {
    text-align: center;
    padding: 36px 16px 24px;
    border-bottom: 1px solid var(--pl-rule-soft);
    margin-bottom: 26px;
  }
  .pl__chrome {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border: 1.5px solid var(--pl-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pl-ink-mid);
    background: rgba(0, 0, 0, 0.3);
  }
  .pl__chrome-label { color: var(--pl-ink-dim); }
  .pl__total { color: var(--pl-brass); font-weight: 700; }
  .pl__sep { color: var(--pl-brass-deep); }

  .pl__title {
    margin: 14px 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(36px, 5.6vw, 68px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--pl-brass);
    text-shadow:
      0 0 24px rgba(212, 164, 55, 0.35),
      0 2px 0 var(--pl-slate-deep);
  }
  .pl__tagline {
    margin: 0 auto;
    max-width: 740px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--pl-ink-mid);
  }
  .pl__tagline a { color: var(--pl-brass); }

  /* ── Room: court + waymarks ───────────────────────────── */
  .pl__room {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(200px, 1fr);
    gap: 26px;
    align-items: start;
    max-width: 980px;
    margin-inline: auto;
  }
  @media (max-width: 820px) {
    .pl__room { grid-template-columns: 1fr; }
    .pl__way { max-width: 340px; margin-inline: auto; }
  }

  .pl__court {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .pl__svg {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    touch-action: none;
    cursor: pointer;
  }
  .pl__stone {
    fill: none;
    stroke: #2b3a2b;
    stroke-width: 13;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pl__walked {
    fill: none;
    stroke: var(--pl-flame);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(246, 193, 94, 0.55));
    /* dasharray is set from JS: [progress, total] */
    stroke-dasharray: 0 99999;
  }
  .pl__walker {
    fill: var(--pl-flame);
    filter: drop-shadow(0 0 8px rgba(246, 193, 94, 0.8));
  }
  .pl__heart {
    fill: none;
    stroke: var(--pl-brass-deep);
    stroke-width: 2;
  }
  .pl__bloom {
    fill: rgba(246, 193, 94, 0.35);
    opacity: 0;
    transform-origin: 240px 240px;
  }
  .pl__bloom.pl__bloom--go {
    animation: pl-bloom 2.6s ease-out;
  }
  @keyframes pl-bloom {
    0%   { opacity: 0; transform: scale(1); }
    18%  { opacity: 1; }
    100% { opacity: 0; transform: scale(22); }
  }

  .pl__status {
    min-height: 22px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--pl-ink-mid);
    text-align: center;
  }

  .pl__controls { display: flex; gap: 12px; align-items: center; }
  .pl__walkbtn, .pl__againbtn {
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 12px 22px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.20em;
    color: var(--pl-slate-deep);
    background: linear-gradient(180deg, var(--pl-brass) 0%, var(--pl-brass-soft) 100%);
    box-shadow:
      0 0 0 2px var(--pl-slate-deep),
      0 4px 0 0 var(--pl-brass-deep),
      0 4px 12px rgba(212, 164, 55, 0.25);
    transition: transform 80ms, box-shadow 80ms;
    user-select: none;
    -webkit-user-select: none;
  }
  .pl__walkbtn:active, .pl__walkbtn.pl__walkbtn--holding {
    transform: translateY(3px);
    box-shadow:
      0 0 0 2px var(--pl-slate-deep),
      0 1px 0 0 var(--pl-brass-deep),
      0 0 16px rgba(246, 193, 94, 0.6);
  }

  /* ── Waymark rail ─────────────────────────────────────── */
  .pl__way {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .pl__way-frame {
    width: 100%;
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    padding: 0;
    background: var(--pl-slate-deep);
    box-shadow:
      0 0 0 2px var(--pl-slate-deep),
      0 0 0 4px var(--pl-brass-deep),
      0 6px 18px rgba(0, 0, 0, 0.5);
  }
  .pl__way-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1100ms ease-in-out;
  }
  .pl__way-img--on { opacity: 1; }
  .pl__way-dots { display: flex; gap: 8px; }
  .pl__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(125, 168, 123, 0.18);
    box-shadow: inset 0 0 0 1px var(--pl-ink-dim);
    transition: background 300ms, box-shadow 300ms;
  }
  .pl__dot--lit {
    background: var(--pl-flame);
    box-shadow: 0 0 8px rgba(246, 193, 94, 0.6);
  }
  .pl__way-caption {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--pl-ink-dim);
    text-align: center;
    min-height: 18px;
  }

  /* ── How ──────────────────────────────────────────────── */
  .pl__how {
    margin-top: 48px;
    padding: 24px 16px;
    max-width: 820px;
    margin-inline: auto;
    border-top: 1px solid var(--pl-rule-soft);
  }
  .pl__how h2 {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 24px;
    color: var(--pl-brass);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }
  .pl__how-list { list-style: decimal; padding-left: 22px; margin: 0; }
  .pl__how-list li {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--pl-ink-mid);
    margin-bottom: 10px;
  }
  .pl__how-list em { color: var(--pl-flame); font-style: italic; font-weight: 500; }
  .pl__how-list a { color: var(--pl-brass); }
  .pl__kbd {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    color: var(--pl-slate-deep);
    background: var(--pl-brass);
    border-radius: 2px;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .pl__blessing {
    margin-top: 28px;
    text-align: center;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--pl-ink-dim);
    letter-spacing: 0.08em;
  }
</style>

<script>
  // ── Identity ─────────────────────────────────────────────
  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) {
        sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(SID_KEY, sid);
      }
      return sid;
    } catch {
      return 'sid-anon-' + Date.now();
    }
  }
  const SID = ensureSid();

  // ── Audio ────────────────────────────────────────────────
  let actx: AudioContext | null = null;
  function ctx(): AudioContext {
    if (!actx) {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  // circuit tones rise toward the center: C4 D4 E4 G4 A4 C5 D5
  const CIRCUIT_NOTES = [261.63, 293.66, 329.63, 392.0, 440.0, 523.25, 587.33];
  function toneAt(f: number, vel = 0.5) {
    try {
      const a = ctx(); const t = a.currentTime;
      const dur = 2.4 * Math.sqrt(261.63 / f);
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.756;
      const g = a.createGain(); const g2 = a.createGain();
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.22 * vel, t + 0.006); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.05 * vel, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + dur * 0.5);
      o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
      o.start(t); o.stop(t + dur + 0.1); o2.start(t); o2.stop(t + dur * 0.5 + 0.1);
    } catch {}
  }
  function centerChord() {
    try {
      const a = ctx(); const t = a.currentTime;
      [130.81, 196.0, 261.63, 392.0].forEach((f) => { // C3 G3 C4 G4
        const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
        const g = a.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(0.14, t + 0.25);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 4.5);
        o.connect(g).connect(a.destination);
        o.start(t); o.stop(t + 4.6);
      });
    } catch {}
  }

  // ── Path machinery ───────────────────────────────────────
  const svg = document.getElementById('pl-svg') as unknown as SVGSVGElement | null;
  const stone = document.querySelector('.pl__stone') as SVGPathElement | null;
  const walkPath = document.getElementById('pl-walk-path') as unknown as SVGPathElement | null;
  const walker = document.getElementById('pl-walker') as unknown as SVGCircleElement | null;
  const statusEl = document.getElementById('pl-status');
  const holdBtn = document.getElementById('pl-hold') as HTMLButtonElement | null;
  const againBtn = document.getElementById('pl-again') as HTMLButtonElement | null;

  const TOL = 24;            // trace tolerance, SVG units
  const WINDOW_BACK = 40;    // how far behind progress a match may sit
  const WINDOW_FWD = 90;     // how far ahead progress may jump per move
  const WALK_SPEED = 115;    // px/s for hold-to-walk

  let L = 0;
  let samples: Array<{ x: number; y: number; s: number }> = [];
  let thresholds: number[] = [];
  let progress = 0;
  let crossed = 0;           // circuits crossed so far (0..7)
  let done = false;
  let posted = false;

  function setup() {
    if (!walkPath || !stone) return;
    L = walkPath.getTotalLength();
    const N = Math.ceil(L / 4);
    samples = [];
    for (let i = 0; i <= N; i++) {
      const s = (i / N) * L;
      const p = walkPath.getPointAtLength(s);
      samples.push({ x: p.x, y: p.y, s });
    }
    // scale analytic circuit boundaries to the browser's true length
    const analytic = parseFloat(stone.dataset.analytic || '0');
    const bounds = JSON.parse(stone.dataset.boundaries || '[]') as number[];
    const scale = analytic > 0 ? L / analytic : 1;
    thresholds = bounds.map((b) => b * scale);
    paint();
  }

  function paint() {
    if (!walkPath) return;
    walkPath.style.strokeDasharray = `${progress} ${L + 10}`;
    if (walker) {
      const p = walkPath.getPointAtLength(Math.min(progress, L));
      walker.setAttribute('cx', String(p.x));
      walker.setAttribute('cy', String(p.y));
    }
  }

  function setStatus(msg: string) { if (statusEl) statusEl.textContent = msg; }

  const STATUS_BY_CIRCUIT = [
    'the first turn — settle your pace',
    'second circuit — the outside world quiets',
    'third — halfway is not the point',
    'fourth — the path doubles back; let it',
    'fifth — nearer than it looks',
    'sixth — the turns tighten, so does focus',
    'seventh — the last circuit before the heart',
  ];

  function revealWaymark(i: number) {
    document.querySelectorAll('.pl__way-img').forEach((img, n) => {
      img.classList.toggle('pl__way-img--on', n === i);
    });
    document.querySelectorAll('.pl__dot').forEach((dot, n) => {
      dot.classList.toggle('pl__dot--lit', n <= i);
    });
    const cap = document.getElementById('pl-way-caption');
    const img = document.querySelector(`.pl__way-img[data-way="${i}"]`) as HTMLImageElement | null;
    if (cap && img) cap.textContent = img.alt;
  }

  function checkThresholds() {
    while (crossed < thresholds.length && progress >= thresholds[crossed]) {
      crossed += 1;
      toneAt(CIRCUIT_NOTES[crossed - 1] ?? 523.25, 0.5);
      revealWaymark(Math.min(crossed, 7));
      setStatus(STATUS_BY_CIRCUIT[crossed - 1] ?? '…');
    }
    if (!done && progress >= L - 3) {
      done = true;
      arrive();
    }
  }

  async function arrive() {
    centerChord();
    revealWaymark(7);
    document.getElementById('pl-bloom')?.classList.add('pl__bloom--go');
    setStatus('the walk is complete — go in peace');
    if (holdBtn) holdBtn.hidden = true;
    if (againBtn) againBtn.hidden = false;
    if (!posted) {
      posted = true;
      try {
        const r = await fetch('/api/prayer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: SID, station: 'labyrinth' }),
        });
        const j = await r.json();
        if (j?.ok) {
          const walkedEl = document.getElementById('pl-walked');
          if (walkedEl) walkedEl.textContent = String(j.count);
          const totEl = document.getElementById('pl-total');
          if (totEl) totEl.textContent = String(j.total);
        }
      } catch { /* offline walks still count in the heart */ }
    }
  }

  function reset() {
    progress = 0;
    crossed = 0;
    done = false;
    posted = false;
    document.getElementById('pl-bloom')?.classList.remove('pl__bloom--go');
    revealWaymark(0);
    setStatus('begin at the mouth, at the bottom');
    if (holdBtn) holdBtn.hidden = false;
    if (againBtn) againBtn.hidden = true;
    paint();
  }

  function advanceTo(s: number) {
    if (done) return;
    if (s > progress) {
      progress = Math.min(s, L);
      paint();
      checkThresholds();
    }
  }

  // ── Trace input ──────────────────────────────────────────
  let tracing = false;

  function svgPointFromEvent(e: PointerEvent): { x: number; y: number } | null {
    if (!svg) return null;
    const p = svg.createSVGPoint();
    p.x = e.clientX; p.y = e.clientY;
    const ctm = svg.getScreenCTM();
    if (!ctm) return null;
    const q = p.matrixTransform(ctm.inverse());
    return { x: q.x, y: q.y };
  }

  function tryAdvanceFromPointer(e: PointerEvent) {
    const q = svgPointFromEvent(e);
    if (!q || samples.length === 0) return;
    const lo = Math.max(0, Math.floor((progress - WINDOW_BACK) / 4));
    const hi = Math.min(samples.length - 1, Math.ceil((progress + WINDOW_FWD) / 4));
    let best = -1;
    let bestD = Infinity;
    for (let i = lo; i <= hi; i++) {
      const dx = samples[i].x - q.x;
      const dy = samples[i].y - q.y;
      const d2 = dx * dx + dy * dy;
      if (d2 < bestD) { bestD = d2; best = i; }
    }
    if (best >= 0 && bestD <= TOL * TOL) advanceTo(samples[best].s);
  }

  svg?.addEventListener('pointerdown', (e) => {
    tracing = true;
    (svg as any).setPointerCapture?.(e.pointerId);
    ctx(); // unlock audio on first gesture
    tryAdvanceFromPointer(e);
  });
  svg?.addEventListener('pointermove', (e) => { if (tracing) tryAdvanceFromPointer(e); });
  const endTrace = () => { tracing = false; };
  window.addEventListener('pointerup', endTrace);
  window.addEventListener('pointercancel', endTrace);

  // ── Hold-to-walk ─────────────────────────────────────────
  // setInterval, not rAF: rAF suspends in throttled/offscreen tabs
  // (and in headless verification panes); a 33ms ticker with real
  // clock deltas keeps the pace honest everywhere.
  let holding = false;
  let lastTick = 0;
  let walkTimer: ReturnType<typeof setInterval> | null = null;
  function startHold() {
    if (holding || done) return;
    holding = true;
    lastTick = performance.now();
    holdBtn?.classList.add('pl__walkbtn--holding');
    ctx();
    walkTimer = setInterval(() => {
      const now = performance.now();
      advanceTo(progress + ((now - lastTick) / 1000) * WALK_SPEED);
      lastTick = now;
    }, 33);
  }
  function endHold() {
    holding = false;
    holdBtn?.classList.remove('pl__walkbtn--holding');
    if (walkTimer) { clearInterval(walkTimer); walkTimer = null; }
  }
  holdBtn?.addEventListener('pointerdown', startHold);
  window.addEventListener('pointerup', endHold);
  window.addEventListener('pointercancel', endHold);
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && !e.repeat) {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
      e.preventDefault();
      startHold();
    }
  });
  window.addEventListener('keyup', (e) => { if (e.code === 'Space') endHold(); });

  againBtn?.addEventListener('click', reset);

  // ── Ledger chip ──────────────────────────────────────────
  async function fetchState() {
    try {
      const r = await fetch('/api/prayer', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) {
        const totEl = document.getElementById('pl-total');
        if (totEl) totEl.textContent = String(j.total ?? 0);
        const walkedEl = document.getElementById('pl-walked');
        if (walkedEl) walkedEl.textContent = String(j.counts?.labyrinth ?? 0);
      }
    } catch { /* offline */ }
  }

  setup();
  fetchState();
  setInterval(fetchState, 15000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) fetchState();
  });
</script>
