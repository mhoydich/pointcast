---
/**
 * /drum-fives — meta-hub for the fives + bell wing.
 *
 * Mike's afternoon run. Eight surfaces in two wings:
 *
 *   FIVES WING (chamber-bus):
 *   - /drum-quintet      five seats, sixteen steps each
 *   - /drum-altars       five altars, weekly Noun rotation
 *   - /drum-altars-tv    projection cast of the chamber
 *
 *   BELL WING (sound + identity):
 *   - /drum-bell-fall    pentatonic rain, click anywhere
 *   - /drum-bell-jar     shake the glass
 *   - /drum-pendulum     meditative swing
 *   - /drum-vespers      bells on the hour
 *   - /drum-saint        patron Noun + altar lane
 *
 * This page is the directory. Each card has a pixel-art glyph,
 * a one-line description, and a live stat where applicable
 * (chamber total, vespers next-hour countdown, saint's patron
 * Noun preview).
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Fives & Bells · Wing Index · PointCast';
const description =
  'Eight surfaces in two wings — the chamber and its bell variants. Fives wing: quintet, altars, altars-tv. Bell wing: fall, jar, pendulum, vespers, saint.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Fives & Bells Wing Index',
  url: 'https://pointcast.xyz/drum-fives',
  description,
  applicationCategory: 'MultimediaApplication',
};

const FIVES = [
  { id: 'quintet',   href: '/drum-quintet',   title: 'QUINTET',     sub: 'five seats, one loop',       glyph: '✦', kind: 'fives' },
  { id: 'altars',    href: '/drum-altars',    title: 'ALTARS',      sub: 'weekly noun rotation',        glyph: '◉', kind: 'fives' },
  { id: 'altars-tv', href: '/drum-altars-tv', title: 'ALTARS · TV', sub: 'projection cast',             glyph: '◈', kind: 'fives' },
];

const BELLS = [
  { id: 'bell-fall', href: '/drum-bell-fall', title: 'BELL FALL',   sub: 'pentatonic rain',             glyph: '✧', kind: 'bell' },
  { id: 'bell-jar',  href: '/drum-bell-jar',  title: 'BELL JAR',    sub: 'shake the glass',             glyph: '◯', kind: 'bell' },
  { id: 'pendulum',  href: '/drum-pendulum',  title: 'PENDULUM',    sub: 'meditative swing',            glyph: '◐', kind: 'bell' },
  { id: 'vespers',   href: '/drum-vespers',   title: 'VESPERS',     sub: 'bells on the hour',           glyph: '⛧', kind: 'bell' },
  { id: 'saint',     href: '/drum-saint',     title: 'SAINT',       sub: 'patron noun · altar lane',    glyph: '✦', kind: 'bell' },
];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="df" id="df-main">
    <DrumNav current="fives" />

    <header class="df__header">
      <div class="df__chrome">
        <span>WING INDEX</span>
        <span class="df__chrome-sep">·</span>
        <span id="df-week">WEEK ---</span>
        <span class="df__chrome-sep">·</span>
        <span id="df-total">— TRIBUTES</span>
      </div>
      <h1 class="df__title">FIVES &amp; BELLS</h1>
      <p class="df__tagline">eight surfaces in two wings · the chamber and its bell variants</p>
    </header>

    <section class="df__wing">
      <header class="df__wing-header">
        <span class="df__wing-label">FIVES WING</span>
        <span class="df__wing-rule"></span>
      </header>
      <div class="df__grid">
        {FIVES.map((s) => (
          <a class="df__card" href={s.href} data-card={s.id}>
            <div class="df__glyph">{s.glyph}</div>
            <div class="df__meta">
              <div class="df__card-title">{s.title}</div>
              <div class="df__card-sub">{s.sub}</div>
              <div class="df__card-stat" data-stat={s.id}>—</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="df__wing">
      <header class="df__wing-header">
        <span class="df__wing-label">BELL WING</span>
        <span class="df__wing-rule"></span>
      </header>
      <div class="df__grid">
        {BELLS.map((s) => (
          <a class="df__card df__card--bell" href={s.href} data-card={s.id}>
            <div class="df__glyph">{s.glyph}</div>
            <div class="df__meta">
              <div class="df__card-title">{s.title}</div>
              <div class="df__card-sub">{s.sub}</div>
              <div class="df__card-stat" data-stat={s.id}>—</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <footer class="df__footer">
      <p>
        Pure-static surfaces (bell-fall, bell-jar, pendulum, vespers) keep their counts in your browser.
        Chamber-bus surfaces (quintet, altars, altars-tv, saint) share state via <a href="/api/altar">/api/altar</a> +
        <a href="/api/quintet">/api/quintet</a>. Receipts in <a href="/b/0421">Block 0421</a>,
        <a href="/b/0423">Block 0423</a>, <a href="/b/0426">Block 0426</a>.
      </p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#df-main) {
    background: #0c0410;
  }

  .df {
    --df-velvet: #1a0820;
    --df-velvet-deep: #0c0410;
    --df-brass: #d4a437;
    --df-brass-soft: #b8862c;
    --df-brass-deep: #6b4d12;
    --df-flame: #f6c15e;
    --df-ink-light: #f4e7c8;
    --df-ink-mid: #c9b78c;
    --df-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--df-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--df-velvet) 0%, var(--df-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .df::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 30px 30px, rgba(212, 164, 55, 0.08) 1.5px, transparent 2px);
    background-size: 130px 130px;
    opacity: 0.4;
    z-index: -1;
  }
  .df .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .df__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(20px, 3vh, 36px);
  }
  .df__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px;
    border: 1.5px solid var(--df-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--df-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .df__chrome-sep { color: var(--df-brass-deep); }
  #df-week, #df-total { color: var(--df-flame); font-weight: 700; }

  .df__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(36px, 6vw, 84px);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--df-brass);
    text-shadow: 0 0 32px rgba(212, 164, 55, 0.45), 0 2px 0 var(--df-velvet-deep);
  }
  .df__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(14px, 1.3vw, 18px);
    color: var(--df-ink-mid);
  }

  /* Wing section */
  .df__wing {
    margin-bottom: clamp(28px, 4vh, 48px);
  }
  .df__wing-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .df__wing-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.30em;
    color: var(--df-brass);
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .df__wing-rule {
    flex: 1;
    height: 1px;
    background: var(--df-brass-deep);
    opacity: 0.5;
  }

  /* Card grid */
  .df__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }

  .df__card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 16px;
    background: linear-gradient(180deg, rgba(44, 13, 54, 0.55), rgba(12, 4, 16, 0.78));
    border: 1.5px solid var(--df-brass-deep);
    text-decoration: none;
    color: var(--df-ink-light);
    transition: transform 120ms, box-shadow 160ms, border-color 160ms;
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.20),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 4px 12px rgba(0, 0, 0, 0.4);
  }
  .df__card:hover {
    transform: translateY(-2px);
    border-color: var(--df-brass);
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 8px 22px rgba(212, 164, 55, 0.18);
    text-decoration: none;
  }

  .df__glyph {
    font-size: 28px;
    color: var(--df-brass);
    line-height: 1;
    text-shadow: 0 0 14px rgba(212, 164, 55, 0.45);
    flex-shrink: 0;
  }
  .df__meta {
    flex: 1;
    min-width: 0;
  }
  .df__card-title {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px;
    letter-spacing: 0.22em;
    color: var(--df-ink-light);
    margin-bottom: 2px;
  }
  .df__card-sub {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--df-ink-dim);
    margin-bottom: 4px;
  }
  .df__card-stat {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--df-flame);
    text-transform: uppercase;
  }

  .df__footer {
    margin-top: clamp(20px, 3vh, 36px);
    padding-top: 18px;
    border-top: 1px solid rgba(212, 164, 55, 0.18);
    text-align: center;
  }
  .df__footer p {
    margin: 0 auto;
    max-width: 640px;
    font-family: 'Lora', Georgia, serif;
    font-size: 14px;
    line-height: 1.55;
    color: var(--df-ink-mid);
  }
  .df__footer a {
    color: var(--df-brass);
    text-decoration: underline;
    text-decoration-color: var(--df-brass-deep);
    text-underline-offset: 3px;
  }
</style>

<script>
  // ── DOM helpers ──────────────────────────────────────
  function setStat(cardId, text) {
    const el = document.querySelector(`[data-stat="${cardId}"]`);
    if (el) el.textContent = text;
  }
  function pad(n) { return String(n).padStart(2, '0'); }
  function fmtCount(n) { return n > 999 ? (n / 1000).toFixed(1) + 'k' : String(n); }

  // ── Identity (for saint patron preview) ──────────────
  async function sha256(s) {
    const buf = new TextEncoder().encode(s);
    const hash = await crypto.subtle.digest('SHA-256', buf);
    return Array.from(new Uint8Array(hash)).map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  function ensureSid() {
    try {
      let sid = localStorage.getItem('pc:sid');
      if (!sid) { sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem('pc:sid', sid); }
      return sid;
    } catch { return 'sid-anon-' + Date.now(); }
  }
  function nounIdFromHash(hash) {
    let n = 0;
    for (let i = 0; i < Math.min(8, hash.length); i++) n = (n * 31 + hash.charCodeAt(i)) | 0;
    return Math.abs(n) % 1200;
  }
  function laneFromHash(hash) {
    let n = 0;
    for (let i = 8; i < Math.min(16, hash.length); i++) n = (n * 31 + hash.charCodeAt(i)) | 0;
    return Math.abs(n) % 5;
  }
  const LANES = ['bell', 'bowl', 'chime', 'gong', 'drone'];

  // ── /api/altar — chamber stats ──────────────────────
  async function refreshAltar() {
    try {
      const r = await fetch('/api/altar', { cache: 'no-store' });
      const j = await r.json();
      if (!j?.ok) return;
      const total = j.totalThisWeek ?? 0;
      const chip = document.getElementById('df-week'); if (chip) chip.textContent = `WEEK ${j.week}`;
      const totalChip = document.getElementById('df-total'); if (totalChip) totalChip.textContent = `${fmtCount(total)} TRIBUTES`;
      setStat('altars', `${total} TRIBUTES THIS WEEK`);
      // altars-tv mirrors the chamber, lit candles count
      const litCandles = j.seeds?.filter((s) => (j.counts?.[String(s)] ?? 0) > 0).length ?? 0;
      setStat('altars-tv', `${litCandles}/5 CANDLES LIT`);
    } catch {}
  }

  // ── /api/quintet — seat status ──────────────────────
  async function refreshQuintet() {
    try {
      const r = await fetch('/api/quintet', { cache: 'no-store' });
      const j = await r.json();
      if (!j?.ok) return;
      const seats = j.state?.seats ?? {};
      const filled = Object.values(seats).filter((v) => v).length;
      setStat('quintet', `${filled}/5 SEATS FILLED`);
    } catch {}
  }

  // ── localStorage-backed surfaces ────────────────────
  function refreshLocalCounts() {
    try {
      const fall = parseInt(localStorage.getItem('pc:bellfall:count') || '0', 10) || 0;
      setStat('bell-fall', fall > 0 ? `${fmtCount(fall)} BELLS FALLEN` : 'TAP THE FIELD');
      const shakes = parseInt(localStorage.getItem('pc:belljar:shakes') || '0', 10) || 0;
      setStat('bell-jar', shakes > 0 ? `${fmtCount(shakes)} SHAKES` : 'CLICK THE JAR');
      const swings = parseInt(localStorage.getItem('pc:pendulum:swings') || '0', 10) || 0;
      const arc = parseFloat(localStorage.getItem('pc:pendulum:arc') || '0') || 0;
      if (swings > 0) {
        setStat('pendulum', `${fmtCount(swings)} SWINGS · ${Math.round(arc)}° MAX`);
      } else {
        setStat('pendulum', 'PUSH THE BELL');
      }
      const tolls = parseInt(localStorage.getItem('pc:vespers:today') || '0', 10) || 0;
      setStat('vespers', tolls > 0 ? `${tolls} TOLLS TODAY` : 'AUTO ON THE HOUR');
    } catch {}
  }

  // ── /drum-vespers next-hour countdown ───────────────
  function paintVespersClock() {
    const now = new Date();
    const next = new Date(now);
    next.setMinutes(0, 0, 0);
    next.setHours(now.getHours() + 1);
    const ms = next.getTime() - now.getTime();
    const m = Math.floor(ms / 60000);
    const s = Math.floor((ms % 60000) / 1000);
    const tolls = parseInt(localStorage.getItem('pc:vespers:today') || '0', 10) || 0;
    const txt = tolls > 0 ? `${tolls} TODAY · NEXT IN ${pad(m)}:${pad(s)}` : `NEXT TOLL IN ${pad(m)}:${pad(s)}`;
    setStat('vespers', txt);
  }

  // ── /drum-saint patron preview ──────────────────────
  async function paintSaint() {
    try {
      const sid = ensureSid();
      const hash = await sha256(sid);
      const noun = nounIdFromHash(hash);
      const laneIdx = laneFromHash(hash);
      setStat('saint', `NOUN ${String(noun).padStart(4, '0')} · ${LANES[laneIdx].toUpperCase()} LANE`);
    } catch {}
  }

  // ── Boot ─────────────────────────────────────────────
  refreshLocalCounts();
  paintSaint();
  refreshAltar();
  refreshQuintet();
  paintVespersClock();
  setInterval(refreshAltar, 6000);
  setInterval(refreshQuintet, 6000);
  setInterval(paintVespersClock, 1000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) { refreshAltar(); refreshQuintet(); refreshLocalCounts(); }
  });
</script>
