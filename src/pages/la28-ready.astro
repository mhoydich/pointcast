---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FEDERATION_POSITION, LA28_CONTEXT, LEGACY_CIRCLE_FUNDERS, PAPER_META, PAPER_NOTES, REFERENCES, TIER_D_AGAINST_LA28, TIMELINE } from '../lib/la28Paper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/la28-ready', name: PAPER_META.title, description, url: 'https://pointcast.xyz/la28-ready', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const allWorks = [
  ...TIER_D_AGAINST_LA28.aligned.map((w) => ({ ...w, band: 'aligned' as const })),
  ...TIER_D_AGAINST_LA28.neutral.map((w) => ({ ...w, band: 'neutral' as const })),
  ...TIER_D_AGAINST_LA28.antiAligned.map((w) => ({ ...w, band: 'anti' as const })),
];
const bandColor: Record<string, string> = { aligned: '#2d6a3d', neutral: '#a8a39a', anti: '#b85a3a' };
const bandLabel: Record<string, string> = { aligned: 'PARTNER', neutral: 'NEUTRAL · SHIP ON FEDERATION CADENCE', anti: 'DEFEND' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/la28-ready.json', title: 'LA28 Forcing Function (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/giant-works">giant-works</a><span aria-hidden="true">/</span><span>la28-ready</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · 16 TIER D WORKS × 1 OLYMPIC FORCING FUNCTION</p>
      <h1>LA28 / READY.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="ctx"><p class="kicker">LA28 CONTEXT</p><h2>The forcing function.</h2>
      <dl class="ctx-dl">
        <div><dt>Opening ceremony</dt><dd>{LA28_CONTEXT.openingCeremony}</dd></div>
        <div><dt>Closing ceremony</dt><dd>{LA28_CONTEXT.closingCeremony}</dd></div>
        <div><dt>Paralympics opening</dt><dd>{LA28_CONTEXT.paralympicsOpening}</dd></div>
        <div><dt>Total athletes</dt><dd>{LA28_CONTEXT.totalAthletes}</dd></div>
        <div><dt>Total events</dt><dd>{LA28_CONTEXT.totalEvents}</dd></div>
        <div><dt>Operating budget</dt><dd>{LA28_CONTEXT.budgetTotal}</dd></div>
        <div><dt>South Bay venues</dt><dd>{LA28_CONTEXT.southBayVenues}</dd></div>
        <div><dt>Corridor venues</dt><dd>{LA28_CONTEXT.corridorVenues}</dd></div>
        <div><dt>Legacy framework</dt><dd>{LA28_CONTEXT.legacyProjects}</dd></div>
      </dl>
    </section>

    <section class="funders"><p class="kicker">LEGACY-CIRCLE FUNDERS · 6</p><h2>Who has signaled what.</h2>
      <ol class="fn-list">{LEGACY_CIRCLE_FUNDERS.map((f) => (
        <li>
          <h3>{f.name}</h3>
          <p><strong>Focus:</strong> {f.focus}</p>
          <p><strong>Engagement window:</strong> {f.engagementWindow}</p>
        </li>
      ))}</ol>
    </section>

    <section class="board"><p class="kicker">THE 16 TIER D WORKS · BY ALIGNMENT</p><h2>Five partner. Six neutral. Five defend.</h2>
      <ol class="board-list">{allWorks.map((w) => (
        <li class={`bw bw--${w.band}`} style={`--bw-color: ${bandColor[w.band]};`}>
          <div class="bw__head">
            <span class="bw__band">{bandLabel[w.band]}</span>
            <h3>{w.work}</h3>
          </div>
          <p><strong>Alignment:</strong> {w.alignment}</p>
          <p><strong>Risk:</strong> {w.risk}</p>
          <p class="bw__rec"><strong>Recommendation:</strong> {w.recommendation}</p>
        </li>
      ))}</ol>
    </section>

    <section class="position"><p class="kicker">FEDERATION POSITION</p><h2>The recommended posture.</h2>
      <div class="pos-grid">
        <div class="pos pos--partner"><h3>Partner with</h3><p>{FEDERATION_POSITION.partnerWith}</p></div>
        <div class="pos pos--neutral"><h3>Decline for</h3><p>{FEDERATION_POSITION.declineFor}</p></div>
        <div class="pos pos--defend"><h3>Defend from</h3><p>{FEDERATION_POSITION.defendFrom}</p></div>
      </div>
      <p class="pos__owner"><strong>Who owns the boundary:</strong> {FEDERATION_POSITION.whoOwnsTheBoundary}</p>
    </section>

    <section class="tl"><p class="kicker">TIMELINE · 2026 Q3 → 2030</p><h2>The federation calendar against the Olympic clock.</h2>
      <ol class="tl-list">{TIMELINE.map((t) => (
        <li>
          <span class="tl__y">{t.year}</span>
          <p>{t.milestone}</p>
        </li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · LA28 + LEGACY-CIRCLE STAFF</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/giant-works">Giant Works · element Tier D</a>
      <a href="/giant-works-art">Giant Works · audio/light/art Tier D</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/la28-ready.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --la-ink:#1a1a1a; --la-paper:#fdf9ee; --la-mustard:#d4a534; --la-rust:#b85a3a; --la-sage:#2d6a3d; --la-strand:#5b8aa8; --la-fog:#d8d2c4; --la-slate:#5a5450; --la-olympic:#3a4a8a; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--la-paper); color: var(--la-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--la-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--la-olympic); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--la-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--la-olympic); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; font-family: Georgia, serif; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--la-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--la-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }

  .ctx-dl { margin: 0; display: grid; gap: 6px; }
  .ctx-dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--la-ink); border-left: 5px solid var(--la-olympic); }
  .ctx-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--la-olympic); padding-top: 2px; }
  .ctx-dl dd { margin: 0; font-size: 14px; line-height: 1.55; font-family: Georgia, serif; }

  .fn-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .fn-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--la-ink); border-left: 6px solid var(--la-mustard); }
  .fn-list p { margin: 0 0 4px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .fn-list strong, .pos__owner strong, .bw strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--la-olympic); margin-right: 4px; }

  .board-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .bw { padding: 14px; background: #fff; border: 2px solid var(--la-ink); border-left: 10px solid var(--bw-color); }
  .bw__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; padding-bottom: 8px; border-bottom: 2px solid var(--bw-color); }
  .bw__band { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .16em; padding: 3px 8px; background: var(--bw-color); color: #fff; }
  .bw h3 { margin: 0; font-family: var(--pc-font-mono); font-size: 16px; flex: 1; }
  .bw p { margin: 0 0 6px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .bw__rec { padding: 10px 12px; background: var(--la-paper); border-left: 4px solid var(--bw-color); margin-top: 8px !important; }

  .position { background: linear-gradient(180deg, var(--la-paper), #fff); }
  .pos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
  .pos { padding: 14px; background: #fff; border: 2px solid var(--la-ink); border-top: 8px solid; }
  .pos--partner { border-top-color: var(--la-sage); }
  .pos--neutral { border-top-color: var(--la-fog); }
  .pos--defend { border-top-color: var(--la-rust); }
  .pos h3 { color: var(--la-ink); margin-bottom: 8px; }
  .pos--partner h3 { color: var(--la-sage); }
  .pos--defend h3 { color: var(--la-rust); }
  .pos p { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .pos__owner { padding: 12px 14px; background: var(--la-paper); border-left: 4px solid var(--la-olympic); font-size: 14px; line-height: 1.6; margin: 0; }

  .tl-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .tl-list li { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--la-ink); border-left: 5px solid var(--la-olympic); align-items: baseline; }
  .tl__y { font-family: var(--pc-font-mono); font-size: 11.5px; font-weight: 700; color: var(--la-olympic); letter-spacing: .1em; }
  .tl-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .invitation { background: var(--la-olympic); color: var(--la-paper); border-top-color: var(--la-olympic); }
  .invitation .kicker { background: var(--la-mustard); color: var(--la-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--la-mustard); color: var(--la-ink); border-left: 4px solid var(--la-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--la-olympic); color: var(--la-paper); text-decoration: none; }
  .links a:hover { background: var(--la-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .pos-grid { grid-template-columns: 1fr; } .ctx-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .tl-list li { grid-template-columns: 1fr; } }
</style>
