  /* Quick tap pad */
  .dd__pad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  @media (max-width: 480px) { .dd__pad { grid-template-columns: repeat(3, 1fr); } }

  .dd__pad-btn {
    appearance: none;
    cursor: pointer;
    aspect-ratio: 1.4 / 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    padding: 12px 10px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    color: var(--color-ink);
    border-radius: 4px;
    transition: transform 70ms, background 70ms, color 70ms, box-shadow 70ms;
    text-align: left;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .dd__pad-btn:hover { background: var(--color-card-hover); }
  .dd__pad-btn:active,
  .dd__pad-btn.is-flash {
    background: var(--color-warm);
    color: #fff;
    transform: translateY(1px);
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.18);
  }
  .dd__pad-name {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }
  .dd__pad-key {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    align-self: flex-end;
    opacity: 0.65;
  }
  .dd__pad-btn:active .dd__pad-key,
  .dd__pad-btn.is-flash .dd__pad-key { color: rgba(255,255,255,0.85); }

  .dd__pad-hint {
    margin: 12px 0 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }
  .dd__pad-hint code {
    font-size: 10px;
    background: var(--color-card-hover);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--color-warm);
  }
  .dd__pad-hint-sub {
    display: block;
    color: var(--color-ink-soft);
    opacity: 0.7;
    margin-top: 2px;
  }

  /* Now playing */
  .dd__now {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    border-radius: 4px;
  }
  .dd__now-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-ink);
    background: var(--color-paper);
    border-radius: 50%;
    font-size: 20px;
    color: var(--color-warm);
  }
  .dd__now-text { flex: 1; min-width: 0; }
  .dd__now-title {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .dd__now-artist {
    margin: 2px 0 0;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .dd__now-cta {
    flex-shrink: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-warm);
    text-decoration: none;
    border: 1px solid var(--color-warm);
    padding: 6px 10px;
    border-radius: 3px;
    transition: background 100ms, color 100ms;
  }
  .dd__now-cta:hover { background: var(--color-warm); color: #fff; text-decoration: none; }
  @media (max-width: 480px) {
    .dd__now { flex-wrap: wrap; }
    .dd__now-cta { flex-basis: 100%; text-align: center; }
  }

  /* Altars */
  .dd__altars {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  @media (max-width: 480px) { .dd__altars { grid-template-columns: repeat(3, 1fr); } }

  .dd__altar {
    appearance: none;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1.5px solid var(--color-ink);
    background: radial-gradient(circle at 50% 35%, var(--color-card-hover), var(--color-card) 70%);
    color: var(--color-ink);
    border-radius: 50%;
    padding: 0;
    transition: transform 100ms, box-shadow 100ms, background 100ms;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .dd__altar:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-warm) 25%, transparent);
  }
  .dd__altar:active,
  .dd__altar.is-ring {
    background: radial-gradient(circle at 50% 35%, var(--color-warm), color-mix(in srgb, var(--color-warm) 65%, var(--color-ink)) 80%);
    color: #fff;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-warm) 35%, transparent);
  }
  .dd__altar:disabled,
  .dd__altar.is-cooldown {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .dd__altar-glyph {
    font-size: 28px;
    line-height: 1;
    font-family: 'Lora', Georgia, serif;
  }
  .dd__altar-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .dd__altar-status {
    margin: 12px 0 0;
    text-align: center;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    min-height: 1.2em;
  }

  /* Identity */
  .dd__section--identity { margin-top: 48px; }
  .dd__identity {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 20px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    border-radius: 4px;
  }
  @media (max-width: 480px) {
    .dd__identity { flex-direction: column; text-align: center; }
  }
  .dd__identity-img {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card-hover);
    image-rendering: pixelated;
    border-radius: 4px;
  }
  .dd__identity-text { display: flex; flex-direction: column; gap: 6px; }
  .dd__identity-label {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .dd__identity-id {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-warm);
    letter-spacing: 0.04em;
  }
  .dd__identity-sub {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 36rem;
  }
  .dd__identity-sub code {
    font-size: 11px;
    background: var(--color-card-hover);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--color-warm);
  }

  /* Footer */
  .dd__footer {
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--color-rule);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .dd__footer code {
    font-size: 10px;
    background: var(--color-card-hover);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--color-warm);
  }
</style>

<script>
  // ════════════════════════════════════════════════════════════════════
  // /dispatch-drum — client-side wiring.
  //
  // Responsibilities, in order:
  //   1. Pick / load the visitor's Noun id and paint both avatars.
  //   2. Try /api/drum for live global tap count; fall back silently.
  //   3. Mock the "in the hub" presence tile (no real source yet).
  //   4. Wire the tap pad → visual flash + keyboard shortcuts.
  //      (Comments mark the POST /api/sounds spot.)
  //   5. Wire the altar buttons → visual ring + 5s cooldown.
  //      (Comments mark the POST /api/altar spot.)
  //
  // No imports, no bundled deps — runs as a plain inline script.
  // ════════════════════════════════════════════════════════════════════

  (function () {
    const NOUN_KEY = 'pc:visitor-noun-id';
    const NOUN_MAX = 1200; // matches the leaderboard helper in /api/drum/top.ts

    /** Pick a stable noun id for this browser; persist for cross-room id. */
    function loadOrAssignNoun() {
      try {
        const raw = localStorage.getItem(NOUN_KEY);
        if (raw) {
          const n = parseInt(raw, 10);
          if (Number.isFinite(n) && n >= 0 && n < NOUN_MAX) return n;
        }
      } catch {}
      const n = Math.floor(Math.random() * NOUN_MAX);
      try { localStorage.setItem(NOUN_KEY, String(n)); } catch {}
      return n;
    }

    function paintNoun(id) {
      const url = `https://noun.pics/${id}.svg`;
      const img1 = document.getElementById('dd-noun-img');
      const img2 = document.getElementById('dd-id-img');
      const num1 = document.getElementById('dd-noun-id');
      const num2 = document.getElementById('dd-id-num');
      if (img1) img1.setAttribute('src', url);
      if (img2) img2.setAttribute('src', url);
      if (num1) num1.textContent = String(id);
      if (num2) num2.textContent = String(id);
    }

    let nounId = loadOrAssignNoun();
    paintNoun(nounId);

    const shuffleBtn = document.getElementById('dd-noun-shuffle');
    if (shuffleBtn) {
      shuffleBtn.addEventListener('click', () => {
        nounId = Math.floor(Math.random() * NOUN_MAX);
        try { localStorage.setItem(NOUN_KEY, String(nounId)); } catch {}
        paintNoun(nounId);
      });
    }

    // ── Global tap count: live fetch, mock fallback ──────────────────
    const FALLBACK_GLOBAL = 23883;
    const globalEl = document.getElementById('dd-global');
    function paintGlobal(n) {
      if (globalEl) globalEl.textContent = n.toLocaleString();
    }
    paintGlobal(FALLBACK_GLOBAL);

    fetch('/api/drum', { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        if (j && typeof j.globalTotal === 'number' && j.globalTotal > 0) {
          paintGlobal(j.globalTotal);
        }
      })
      .catch(() => { /* keep fallback */ });

    // ── Mock presence (humans / agents). No real source wired yet —
    // /api/visit could feed this; left as a TODO. ────────────────────
    const presentEl = document.getElementById('dd-present');
    const humansEl = document.getElementById('dd-humans');
    const agentsEl = document.getElementById('dd-agents');
    function paintPresence() {
      const humans = 1 + Math.floor(Math.random() * 6);   // 1–6
      const agents = Math.floor(Math.random() * 3);        // 0–2
      if (humansEl) humansEl.textContent = String(humans);
      if (agentsEl) agentsEl.textContent = String(agents);
      if (presentEl) presentEl.textContent = String(humans + agents);
    }
    paintPresence();
    setInterval(paintPresence, 12_000);

    // ── Quick tap pad ────────────────────────────────────────────────
    const padBtns = Array.from(document.querySelectorAll('.dd__pad-btn'));
    function flashPad(btn) {
      btn.classList.add('is-flash');
      setTimeout(() => btn.classList.remove('is-flash'), 140);
    }
    function tapPad(btn) {
      flashPad(btn);
      // const instrument = btn.dataset.instrument;
      // const idx = Number(btn.dataset.padIndex || 0);
      // To wire live broadcast — POST to /api/sounds:
      //   fetch('/api/sounds', {
      //     method: 'POST',
      //     headers: { 'Content-Type': 'application/json' },
      //     body: JSON.stringify({
      //       type: 'button',
      //       seed: idx,
      //       sessionId: getOrCreateSessionId(),
      //     }),
      //   });
      // /api/sounds accepts the 'button' type already (see ALLOWED_TYPES
      // in functions/api/sounds.ts). The cast surfaces — /drum-tv,
      // /drum-marquee, /drum-viz — will then flash the matching tile
      // for any other listener.
    }
    padBtns.forEach((btn) => {
      btn.addEventListener('click', () => tapPad(btn));
    });

    // Keyboard shortcuts: Q W E R / A S D F / Z X C V → 12 instruments.
    const keyMap = {
      KeyQ: 0, KeyW: 1, KeyE: 2, KeyR: 3,
      KeyA: 4, KeyS: 5, KeyD: 6, KeyF: 7,
      KeyZ: 8, KeyX: 9, KeyC: 10, KeyV: 11,
    };
    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      const target = e.target;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) return;
      const idx = keyMap[e.code];
      if (idx === undefined) return;
      const btn = padBtns[idx];
      if (btn) tapPad(btn);
    });

    // ── Altars ───────────────────────────────────────────────────────
    const altarBtns = Array.from(document.querySelectorAll('.dd__altar'));
    const altarStatus = document.getElementById('dd-altar-status');
    let altarLockedUntil = 0;

    function setAltarStatus(text) {
      if (altarStatus) altarStatus.textContent = text;
    }

    function ringAltar(btn) {
      const now = Date.now();
      if (now < altarLockedUntil) {
        const wait = Math.ceil((altarLockedUntil - now) / 1000);
        setAltarStatus(`cooling down · ${wait}s`);
        return;
      }
      altarLockedUntil = now + 5_000;
      btn.classList.add('is-ring');
      setTimeout(() => btn.classList.remove('is-ring'), 600);

      const id = btn.dataset.altar || 'altar';
      setAltarStatus(`✺ rang ${id} · 5s cooldown`);
      // To wire live tribute — POST to /api/altar:
      //   fetch('/api/altar', {
      //     method: 'POST',
      //     headers: { 'Content-Type': 'application/json' },
      //     body: JSON.stringify({ kind: id, nounId, sessionId: getOrCreateSessionId() }),
      //   });
      // /api/altar tracks tributes in KV under `altar:week:{iso-week}`
      // and the conductor / lobby surfaces poll the resulting count.

      altarBtns.forEach((b) => b.classList.add('is-cooldown'));
      setTimeout(() => {
        altarBtns.forEach((b) => b.classList.remove('is-cooldown'));
        if (Date.now() >= altarLockedUntil) setAltarStatus('ready');
      }, 5_000);

      // Tick the cooldown text down each second.
      const tickAt = Date.now();
      const tick = setInterval(() => {
        const remaining = altarLockedUntil - Date.now();
        if (remaining <= 0) { clearInterval(tick); return; }
        if (Date.now() - tickAt < 700) return; // skip first tick
        const s = Math.ceil(remaining / 1000);
        setAltarStatus(`cooling down · ${s}s`);
      }, 500);
    }

    altarBtns.forEach((btn) => {
      btn.addEventListener('click', () => ringAltar(btn));
    });
    setAltarStatus('ready');

  })();
</script>
