---
/**
 * /dispatch-drum — command center for the PointCast drum hub.
 *
 * One page that gathers the things scattered across /drum*: the global
 * tap counter, a portal grid into all 11 drum rooms, a top-10
 * leaderboard, a quick instrument tap-pad, a now-playing surface,
 * the five altar tributes, and the visitor's Noun identity.
 *
 * Almost entirely client-side. The tap pad and altar buttons render
 * visual feedback only — comments mark where to wire the real
 * /api/sounds and /api/altar endpoints. The leaderboard is mock
 * (frozen snapshot the brief gave us). Global tap count fetches
 * /api/drum on load and falls back to the same snapshot if the
 * endpoint isn't reachable.
 *
 * Layout: BlockLayout legacy mode for the warm cream palette. Section CSS uses the
 * .dd__* prefix so the styles don't leak into other surfaces.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Dispatch Drum';
const description =
  'Command center for the PointCast drum hub — global tap counter, multi-room portal, leaderboard, quick tap pad, altar tributes, and your Noun identity.';

// All 11 drum rooms surfaced in the controller grid.
const ROOMS = [
  { href: '/drum',          version: 'v1',    label: 'classic',   icon: '◐', sub: 'cookie-clicker · the original' },
  { href: '/drum-v2',       version: 'v2',    label: 'collab',    icon: '◓', sub: 'pentatonic harmony · token' },
  { href: '/drum-v3',       version: 'v3',    label: 'spotify',   icon: '♪', sub: 'drum along to a track' },
  { href: '/drum-v4',       version: 'v4',    label: 'orchestra', icon: '⚇', sub: '12 instruments · 6 genres' },
  { href: '/drum-v5',       version: 'v5',    label: 'loops',     icon: '↻', sub: 'build · share · url' },
  { href: '/drum-v6',       version: 'v6',    label: 'choir',     icon: '◈', sub: '12 voices · 4 progressions' },
  { href: '/drum-v7',       version: 'v7',    label: 'big',       icon: '⬢', sub: '30 nouns · instrument board' },
  { href: '/drum-v8',       version: 'v8',    label: 'symphony',  icon: '✦', sub: '42 nouns · giant orchestra' },
  { href: '/drum-v9',       version: 'v9',    label: 'lounge',    icon: '~', sub: 'smooth jazz · sax' },
  { href: '/drum-apr26',    version: 'apr26', label: 'sequencer', icon: '▦', sub: '8-pad beat machine' },
  { href: '/drum-trophies', version: '⌐◨-◨',  label: 'trophies',  icon: '★', sub: 'on-chain · tezos', gold: true },
] as const;

// 12 instruments for the quick tap pad. Each maps to a /api/sounds
// "button" event seeded by instrument index when wired up.
const PAD = [
  { id: 'kick',     label: 'kick',     keyHint: 'Q' },
  { id: 'snare',    label: 'snare',    keyHint: 'W' },
  { id: 'hihat',    label: 'hihat',    keyHint: 'E' },
  { id: 'openhat',  label: 'openhat',  keyHint: 'R' },
  { id: 'clap',     label: 'clap',     keyHint: 'A' },
  { id: 'tom',      label: 'tom',      keyHint: 'S' },
  { id: 'bass',     label: 'bass',     keyHint: 'D' },
  { id: 'lead',     label: 'lead',     keyHint: 'F' },
  { id: 'pad',      label: 'pad',      keyHint: 'Z' },
  { id: 'bell',     label: 'bell',     keyHint: 'X' },
  { id: 'shaker',   label: 'shaker',   keyHint: 'C' },
  { id: 'cymbal',   label: 'cymbal',   keyHint: 'V' },
] as const;

// Five altars from /drum-altars. Each fans out a tribute event with a
// 5-second cooldown when wired to /api/altar.
const ALTARS = [
  { id: 'bell',  label: 'BELL',  glyph: '✺' },
  { id: 'bowl',  label: 'BOWL',  glyph: '◯' },
  { id: 'chime', label: 'CHIME', glyph: '☷' },
  { id: 'gong',  label: 'GONG',  glyph: '◉' },
  { id: 'drone', label: 'DRONE', glyph: '∞' },
] as const;

// Frozen leaderboard snapshot per brief. When wired live, swap with a
// fetch to /api/drum/top → { entries: [{ rank, hash, nounId, count }] }.
const LEADERBOARD = [
  { rank:  1, nounId: 253,  count: 7272 },
  { rank:  2, nounId: 752,  count: 6599 },
  { rank:  3, nounId: 156,  count: 4398 },
  { rank:  4, nounId: 886,  count: 4134 },
  { rank:  5, nounId: 805,  count: 2444 },
  { rank:  6, nounId: 1008, count:  852 },
  { rank:  7, nounId: 731,  count:  643 },
  { rank:  8, nounId: 680,  count:  538 },
  { rank:  9, nounId: 662,  count:  380 },
  { rank: 10, nounId: 554,  count:  243 },
] as const;

// Mock starting global tap count. The page tries /api/drum on mount
// and updates if it succeeds; otherwise this number stays.
const GLOBAL_TAPS_FALLBACK = 23_883;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Dispatch Drum',
  url: 'https://pointcast.xyz/dispatch-drum',
  description,
  applicationCategory: 'Dashboard',
  applicationSubCategory: 'Music',
};
---

<BlockLayout legacy title={title} description={description} image="/images/og-drum.png">
  <main class="dd" id="dd-main">

    <!-- ════ 1 · HEADER + GLOBAL STAT HUD + VISITOR NOUN ════ -->
    <header class="dd__header">
      <p class="dd__kicker">DISPATCH DRUM · ROOM 00 · COMMAND CENTER</p>
      <h1 class="dd__title">Dispatch Drum</h1>
      <p class="dd__lede">
        A command center for the drum hub. Watch the rooms, tap the pad, ring an altar.
      </p>

      <div class="dd__hero">
        <div class="dd__visitor" aria-label="Your visitor identity">
          <img
            id="dd-noun-img"
            class="dd__noun-img"
            src="https://noun.pics/42.svg"
            alt="Your Noun avatar"
            width="128"
            height="128"
            loading="eager"
          />
          <div class="dd__visitor-text">
            <p class="dd__visitor-label">YOUR NOUN</p>
            <p class="dd__visitor-id">#<span id="dd-noun-id">42</span></p>
            <button id="dd-noun-shuffle" type="button" class="dd__visitor-shuffle">
              shuffle ↻
            </button>
          </div>
        </div>

        <div class="dd__stats">
          <div class="dd__stat dd__stat--big">
            <p class="dd__stat-label">GLOBAL TAPS</p>
            <p class="dd__stat-value" id="dd-global">23,883</p>
            <p class="dd__stat-sub">all surfaces · all time</p>
          </div>
          <div class="dd__stat">
            <p class="dd__stat-label">IN THE HUB</p>
            <p class="dd__stat-value" id="dd-present">—</p>
            <p class="dd__stat-sub">
              <span id="dd-humans">—</span> humans · <span id="dd-agents">—</span> agents
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- ════ 2 · MULTI-ROOM CONTROLLER ════ -->
    <section class="dd__section" aria-labelledby="dd-rooms-h">
      <header class="dd__section-head">
        <h2 id="dd-rooms-h" class="dd__section-title">Rooms</h2>
        <p class="dd__section-sub">11 drum surfaces · tap a card to enter</p>
      </header>

      <div class="dd__rooms-grid" role="list">
        {ROOMS.map((r) => (
          <a
            href={r.href}
            class={`dd__room${r.gold ? ' dd__room--gold' : ''}`}
            role="listitem"
          >
            <div class="dd__room-top">
              <span class="dd__room-icon" aria-hidden="true">{r.icon}</span>
              <span class="dd__room-version">{r.version}</span>
            </div>
            <p class="dd__room-label">{r.label}</p>
            <p class="dd__room-sub">{r.sub}</p>
            <p class="dd__room-cta">ENTER →</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ════ 3 · LEADERBOARD ════ -->
    <section class="dd__section" aria-labelledby="dd-board-h">
      <header class="dd__section-head">
        <h2 id="dd-board-h" class="dd__section-title">Leaderboard</h2>
        <p class="dd__section-sub">top 10 drummers · all-time</p>
      </header>

      <ol class="dd__board" role="list">
        {LEADERBOARD.map((row) => (
          <li class={`dd__board-row${row.rank === 1 ? ' dd__board-row--gold' : ''}`}>
            <span class="dd__board-rank">#{row.rank}</span>
            <img
              class="dd__board-noun"
              src={`https://noun.pics/${row.nounId}.svg`}
              alt={`Noun #${row.nounId}`}
              width="48"
              height="48"
              loading="lazy"
            />
            <span class="dd__board-name">Noun #{row.nounId}</span>
            <span class="dd__board-count">{row.count.toLocaleString()}</span>
            <span class="dd__board-unit">taps</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ════ 4 · QUICK TAP PAD ════ -->
    <section class="dd__section" aria-labelledby="dd-pad-h">
      <header class="dd__section-head">
        <h2 id="dd-pad-h" class="dd__section-title">Quick Tap Pad</h2>
        <p class="dd__section-sub">12 instruments · tap without leaving the page</p>
      </header>

      <div class="dd__pad" role="group" aria-label="Instrument pad">
        {PAD.map((p, i) => (
          <button
            type="button"
            class="dd__pad-btn"
            data-instrument={p.id}
            data-pad-index={i}
            aria-label={`Tap ${p.label}`}
          >
            <span class="dd__pad-name">{p.label}</span>
            <span class="dd__pad-key" aria-hidden="true">{p.keyHint}</span>
          </button>
        ))}
      </div>
      <p class="dd__pad-hint">
        visual feedback only — wire <code>POST /api/sounds</code>
        <span class="dd__pad-hint-sub">{`{ type: 'button', seed: <index>, sessionId }`}</span>
        to broadcast to other listeners.
      </p>
    </section>

    <!-- ════ 5 · NOW PLAYING ════ -->
    <section class="dd__section" aria-labelledby="dd-now-h">
      <header class="dd__section-head">
        <h2 id="dd-now-h" class="dd__section-title">Now Playing</h2>
        <p class="dd__section-sub">spotify track shared on /drum-v3</p>
      </header>

      <div class="dd__now" id="dd-now">
        <div class="dd__now-icon" aria-hidden="true">♪</div>
        <div class="dd__now-text">
          <p class="dd__now-title" id="dd-now-title">No track playing</p>
          <p class="dd__now-artist" id="dd-now-artist">
            open <a href="/drum-v3">/drum-v3</a> to set one
          </p>
        </div>
        <a class="dd__now-cta" href="/drum-v3">SET A TRACK →</a>
      </div>
    </section>

    <!-- ════ 6 · ALTARS ════ -->
    <section class="dd__section" aria-labelledby="dd-altar-h">
      <header class="dd__section-head">
        <h2 id="dd-altar-h" class="dd__section-title">Altars</h2>
        <p class="dd__section-sub">ring an altar · one tribute every 5 seconds</p>
      </header>

      <div class="dd__altars" role="group" aria-label="Five altars">
        {ALTARS.map((a) => (
          <button
            type="button"
            class="dd__altar"
            data-altar={a.id}
            aria-label={`Ring the ${a.label.toLowerCase()} altar`}
          >
            <span class="dd__altar-glyph" aria-hidden="true">{a.glyph}</span>
            <span class="dd__altar-label">{a.label}</span>
          </button>
        ))}
      </div>
      <p class="dd__altar-status" id="dd-altar-status" aria-live="polite">
        ready
      </p>
    </section>

    <!-- ════ 7 · NOUNS IDENTITY PANEL ════ -->
    <section class="dd__section dd__section--identity" aria-labelledby="dd-id-h">
      <header class="dd__section-head">
        <h2 id="dd-id-h" class="dd__section-title">Your Identity</h2>
        <p class="dd__section-sub">cc0 noun pixel art · stable per browser</p>
      </header>

      <div class="dd__identity">
        <img
          id="dd-id-img"
          class="dd__identity-img"
          src="https://noun.pics/42.svg"
          alt="Your Noun identity"
          width="180"
          height="180"
          loading="lazy"
        />
        <div class="dd__identity-text">
          <p class="dd__identity-label">YOUR NOUN</p>
          <p class="dd__identity-id">#<span id="dd-id-num">42</span></p>
          <p class="dd__identity-sub">
            stored locally as <code>pc:visitor-noun-id</code>. matches the avatar
            up top. shuffle there to get a new one — every drum room recognizes the same
            noun id.
          </p>
        </div>
      </div>
    </section>

    <footer class="dd__footer">
      <p>
        ⌐◨-◨ this is the dispatch desk. mechanics are live in the rooms — taps and altars
        here are previews until <code>/api/sounds</code> + <code>/api/altar</code> are
        wired in.
      </p>
    </footer>

  </main>
</BlockLayout>

<style is:global>
  /* Dispatch Drum styles — scoped via .dd__* prefix.
     Inherits the v1 warm cream palette via BlockLayout legacy mode. */
  .dd {
    max-width: 60rem;
    margin: 0 auto;
    padding: 24px 20px 80px;
    color: var(--color-ink);
    font-family: var(--pc-font-sans, 'Inter Variable', 'Inter', system-ui, sans-serif);
  }

  /* Header */
  .dd__header {
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1.5px solid var(--color-rule);
  }
  .dd__kicker {
    margin: 0 0 12px;
    font-family: var(--pc-font-mono, 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-warm);
    font-weight: 500;
  }
  .dd__title {
    margin: 0 0 8px;
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 6vw, 52px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    line-height: 1.05;
  }
  .dd__lede {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  .dd__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 18px;
    align-items: stretch;
  }
  @media (max-width: 640px) {
    .dd__hero { grid-template-columns: 1fr; }
  }

  .dd__visitor {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    border-radius: 4px;
  }
  .dd__noun-img {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card-hover);
    image-rendering: pixelated;
    border-radius: 2px;
  }
  .dd__visitor-text { display: flex; flex-direction: column; gap: 4px; }
  .dd__visitor-label {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .dd__visitor-id {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }
  .dd__visitor-shuffle {
    margin-top: 4px;
    align-self: flex-start;
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-rule);
    color: var(--color-ink-soft);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 4px 10px;
    cursor: pointer;
    border-radius: 3px;
    transition: background 100ms, color 100ms, border-color 100ms;
  }
  .dd__visitor-shuffle:hover {
    background: var(--color-warm);
    color: #fff;
    border-color: var(--color-warm);
  }

  .dd__stats {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 12px;
  }
  @media (max-width: 480px) { .dd__stats { grid-template-columns: 1fr; } }

  .dd__stat {
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    padding: 14px 16px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dd__stat-label {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .dd__stat-value {
    margin: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 700;
    color: var(--color-warm);
    letter-spacing: 0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .dd__stat--big .dd__stat-value { color: var(--color-ink); }
  .dd__stat--big {
    background: var(--color-card-hover);
    border-color: var(--color-warm);
  }
  .dd__stat-sub {
    margin: 2px 0 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* Sections */
  .dd__section { margin-top: 40px; }
  .dd__section-head { margin-bottom: 14px; }
  .dd__section-title {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.005em;
  }
  .dd__section-sub {
    margin: 4px 0 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* Rooms grid */
  .dd__rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .dd__room {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 14px 12px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 90ms, background 90ms, box-shadow 90ms;
  }
  .dd__room:hover {
    background: var(--color-card-hover);
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 var(--color-ink);
    text-decoration: none;
  }
  .dd__room--gold {
    border-color: var(--color-warm);
    background: linear-gradient(180deg, var(--color-card-hover), var(--color-card));
  }
  .dd__room--gold:hover { box-shadow: 3px 3px 0 var(--color-warm); }
  .dd__room-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dd__room-icon {
    font-size: 22px;
    line-height: 1;
    color: var(--color-warm);
  }
  .dd__room-version {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    background: var(--color-paper);
    padding: 2px 6px;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
  }
  .dd__room-label {
    margin: 4px 0 0;
    font-family: 'Lora', Georgia, serif;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.1;
  }
  .dd__room-sub {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .dd__room-cta {
    margin: 8px 0 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-warm);
    font-weight: 500;
  }

  /* Leaderboard */
  .dd__board {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1.5px solid var(--color-ink);
    background: var(--color-card);
    border-radius: 4px;
    overflow: hidden;
  }
  .dd__board-row {
    display: grid;
    grid-template-columns: 50px 56px 1fr auto auto;
    gap: 12px;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-rule);
  }
  .dd__board-row:last-child { border-bottom: 0; }
  .dd__board-row--gold {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-warm) 18%, transparent), transparent 60%);
  }
  .dd__board-rank {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink-soft);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .dd__board-row--gold .dd__board-rank { color: var(--color-warm); }
  .dd__board-noun {
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-rule);
    background: var(--color-card-hover);
    image-rendering: pixelated;
    border-radius: 2px;
  }
  .dd__board-row--gold .dd__board-noun { border-color: var(--color-warm); border-width: 1.5px; }
  .dd__board-name {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }
  .dd__board-count {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .dd__board-row--gold .dd__board-count { color: var(--color-warm); }
  .dd__board-unit {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  @media (max-width: 480px) {
    .dd__board-row {
      grid-template-columns: 36px 40px 1fr auto;
      gap: 8px;
      padding: 8px 10px;
    }
    .dd__board-noun { width: 40px; height: 40px; }
