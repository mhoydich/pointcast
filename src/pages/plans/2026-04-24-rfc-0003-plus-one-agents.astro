  .prose :global(h3){margin:28px 0 10px;font:500 19px/1.3 var(--pc-font-sans);color:var(--pc-ink)}
  .prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 14px}
  .prose :global(ul),.prose :global(ol){padding-left:1.3em}
