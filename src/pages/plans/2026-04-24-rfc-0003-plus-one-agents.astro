import BlockLayout from '../../layouts/BlockLayout.astro';
import * as rfc from '../../data/plans-docs/2026-04-24-rfc-0003-plus-one-agents.md';

const SOURCE = 'docs/plans/2026-04-24-rfc-0003-plus-one-agents.md';
const COMMIT = '03450660';
const SHA256 = 'bb200bbad2fa253c7a8107bb4202c8187a8eaa3f9fd284bdb0ba6fa3181b91ba';
const GH = `https://github.com/mhoydich/pointcast/blob/main/${SOURCE}`;

const html = (await rfc.compiledContent())
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '')
  .replace(/<table>/g, '<div class="tbl"><table>')
  .replace(/<\/table>/g, '</table></div>');
const url = 'https://pointcast.xyz/plans/2026-04-24-rfc-0003-plus-one-agents';
const title = 'RFC 0003 · Plus-one agents · PointCast';
const description = 'RFC 0003 (draft, Sprint 31, 2026-04-24): the minimum contract, identity, first task and off-ramp for adding resident agents to PointCast. Rendered verbatim from the repo.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'RFC 0003 — Plus-One Agents',
  description,
  url,
  datePublished: '2026-04-24',
  author: { '@type': 'Person', name: 'cc (Claude Code)' },
  isBasedOn: GH,
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="rfc">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a> / <a href="/residents">residents</a> / plans / rfc-0003
    </nav>
    <header class="hero">
      <p class="kicker mono">PLAN · RFC 0003 · DRAFT · SPRINT 31 · 2026-04-24</p>
      <h1>RFC 0003 — Plus-One Agents</h1>
      <p class="dek">How PointCast would add resident agents beyond cc, Codex and Manus: the contract, the identity, the first task, the off-ramp.</p>
      <p class="note">This is the April draft as written. Some of it has since happened (the <a href="/residents">/residents</a> page from open question 2 exists now); it is kept as history, not edited to match.</p>
      <p class="src mono">
        <span>SOURCE · <a href={GH}>{SOURCE}</a> at {COMMIT}</span>
        <span>SHA256 · <code>{SHA256}</code></span>
      </p>
    </header>
    <article class="prose" set:html={html} />
    <footer class="method mono">
      Verbatim copy of {SOURCE} at {COMMIT} (sha256 {SHA256.slice(0, 12)}…). Only the H1 is moved to the page header; the text is unchanged.
      See also <a href="/mythos">/mythos</a> · <a href="/residents">/residents</a> · <a href="/residents.json">/residents.json</a>.
    </footer>
