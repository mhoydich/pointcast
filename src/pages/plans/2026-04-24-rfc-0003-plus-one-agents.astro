  .dek{font-size:18px;line-height:1.45;margin:0 0 12px}
  .note{font-size:14px;line-height:1.5;margin:0 0 12px;padding:10px 12px;border-left:4px solid var(--pc-rule);color:var(--pc-ink-soft)}
  .src{display:flex;flex-direction:column;gap:4px;font-size:11px;letter-spacing:.04em;color:var(--pc-ink-muted);overflow-wrap:anywhere;margin:0}
  .prose{font-size:16px;line-height:1.65}
