---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { todaysGalleryManifest } from '../../lib/todays-gallery';

const description = 'Permanent index of PointCast Today’s Art editions, with human galleries and matching public manifests.';
---

<BlockLayout
  title="Today's Art Editions"
  description={description}
  themeColor="#e7dfcf"
  alternates={[{ type: 'application/json', href: '/gallery/editions.json', title: "Today's Art edition index" }]}
>
  <div class="editions">
    <nav class="mono"><a href="/">POINTCAST</a><span>/</span><a href="/gallery">GALLERY</a><span>/</span><b>EDITIONS</b><a class="json" href="/gallery/editions.json">JSON ↗</a></nav>
    <header>
      <p class="kicker mono">POINTCAST CURATOR'S DESK · PERMANENT EDITIONS</p>
      <h1>Today,<br /><i>kept.</i></h1>
      <p>Each daily hanging gets a stable record, a public manifest, and its own visual thesis. The front room can change without erasing yesterday.</p>
    </header>
    <main>
      <article>
        <div class="date mono"><time datetime={todaysGalleryManifest.date}>20 JUL 2026</time><span>EDIT 001</span></div>
        <div>
          <p class="mono">MIDJOURNEY · IDEOGRAM · IMAGEAPP</p>
          <h2>Money, flowers,<br />and signal.</h2>
          <p>Twenty-eight works in four rooms: bright new signal gardens and flowers, the El Segundo School after hours, Los Angeles money posters, and a stranger ImageApp ocean.</p>
        </div>
        <div class="actions mono"><a href="/gallery/today">ENTER EDITION →</a><a href="/gallery/today.json">READ MANIFEST ↗</a></div>
      </article>
    </main>
    <footer class="mono">ONE EDITION LIVE · CURATED AND PUBLISHED ≠ MINTED</footer>
  </div>
</BlockLayout>

<style>
  .editions { min-height: 100vh; color: #18140f; background: #e7dfcf; }
  .mono { font-family: var(--pc-font-mono); }
  nav { display: flex; gap: 9px; padding: 12px clamp(16px, 4vw, 64px); color: #eee8dc; background: #18140f; font-size: 8px; letter-spacing: .14em; }
  nav a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  nav .json { margin-left: auto; }
  header { display: grid; grid-template-columns: 1.15fr .55fr; align-items: end; gap: 40px; min-height: 62vh; padding: clamp(42px, 8vw, 120px) clamp(16px, 4vw, 64px); border-bottom: 1px solid #18140f; }
  header .kicker { grid-column: 1 / -1; align-self: start; margin: 0; color: #a63424; font-size: 8px; letter-spacing: .16em; }
  h1, h2 { margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-weight: 400; letter-spacing: -.06em; }
  h1 { font-size: clamp(72px, 13vw, 180px); line-height: .75; }
  h1 i { color: #a63424; font-weight: 400; }
  header > p:last-child { max-width: 42ch; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(17px, 2vw, 24px); line-height: 1.4; }
  main { padding: clamp(32px, 6vw, 84px) clamp(16px, 4vw, 64px); }
  article { display: grid; grid-template-columns: .35fr 1fr .3fr; gap: 30px; padding: clamp(22px, 4vw, 50px); background: #d7ddd3; border: 1px solid #18140f; }
  .date { display: flex; flex-direction: column; gap: 8px; font-size: 9px; letter-spacing: .13em; }
  article > div > .mono { color: #a63424; font-size: 8px; letter-spacing: .14em; }
  h2 { font-size: clamp(44px, 7vw, 96px); line-height: .84; }
  article p:not(.mono) { max-width: 62ch; font-size: 12px; line-height: 1.55; }
  .actions { display: flex; align-items: flex-end; flex-direction: column; gap: 12px; font-size: 8px; letter-spacing: .1em; }
  .actions a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  footer { padding: 18px clamp(16px, 4vw, 64px) 60px; font-size: 8px; letter-spacing: .13em; }
  @media (max-width: 760px) { header, article { grid-template-columns: 1fr; } .actions { align-items: flex-start; } }
</style>
