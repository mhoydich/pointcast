---
import { Image } from 'astro:assets';
import BlockLayout from '../../layouts/BlockLayout.astro';
import signalGarden from '../../assets/todays-art/2026-07-20-signal-garden.png';
import flowerOne from '../../assets/todays-art/2026-07-20-flower-field-01.png';
import flowerTwo from '../../assets/todays-art/2026-07-20-flower-field-02.png';
import flowerThree from '../../assets/todays-art/2026-07-20-flower-field-03.png';
import flowerFour from '../../assets/todays-art/2026-07-20-flower-field-04.png';
import ideoOne from '../../assets/todays-art/ideogram/everything-is-possible-01.webp';
import ideoTwo from '../../assets/todays-art/ideogram/everything-is-possible-02.webp';
import ideoFour from '../../assets/todays-art/ideogram/everything-is-possible-04.webp';
import ideoSix from '../../assets/todays-art/ideogram/everything-is-possible-06.webp';
import ideoNine from '../../assets/todays-art/ideogram/everything-is-possible-09.webp';
import ideoTen from '../../assets/todays-art/ideogram/everything-is-possible-10.webp';
import moneyOcean from '../../assets/todays-art/imageapp/money-ocean.png';
import soTired from '../../assets/todays-art/imageapp/so-tired.png';
import sailboat from '../../assets/todays-art/imageapp/sailboat.png';
import colorFieldOne from '../../assets/todays-art/imageapp/color-field-01.png';
import colorFieldTwo from '../../assets/todays-art/imageapp/color-field-02.png';
import { IDEOGRAM_CUTS, IMAGEAPP_CUTS, MIDJOURNEY_DEEP_CUTS, todaysGalleryManifest } from '../../lib/todays-gallery';

const currentMidjourney = [
  [signalGarden, 'Signal Garden / Palos Verdes', 'The horizon as receiver: ocean light, dishes, courts, and a green civic hillside.'],
  [flowerOne, 'Flowers for the Wire I', 'Silver ground, persimmon center, pink canopy.'],
  [flowerTwo, 'Flowers for the Wire II', 'Deep green weather with orange, violet, and turquoise coming forward.'],
  [flowerThree, 'Flowers for the Wire III', 'Cyan, red-orange, yellow, and hot pink in the clearest pop register.'],
  [flowerFour, 'Flowers for the Wire IV', 'The unruly cut: a whole wall of bloom with no polite center.'],
] as const;

const ideogramImages = [ideoOne, ideoTwo, ideoFour, ideoSix, ideoNine, ideoTen];
const imageappImages = [moneyOcean, soTired, sailboat, colorFieldOne, colorFieldTwo];
const archiveBase = 'https://el-segundo-school-archive.pages.dev/display';
const description = "PointCast's July 20 art edit: new Midjourney signal gardens and flowers, deep cuts from the 652-work archive, an Ideogram money-poster suite, and ImageApp profile works.";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: todaysGalleryManifest.title,
  description,
  url: 'https://pointcast.xyz/gallery/today',
  creator: { '@type': 'Person', name: 'Michael Hoydich' },
  datePublished: '2026-07-20',
};
---

<BlockLayout
  title="Today's Art"
  description={description}
  themeColor="#d8ded5"
  image="https://el-segundo-school-archive.pages.dev/display/505-fcb16b222410.webp"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/gallery/today.json', title: "Today's Art manifest" }]}
>
  <div class="art-edit">
    <nav class="art-nav mono" aria-label="Gallery navigation">
      <a href="/">POINTCAST</a><span>/</span><a href="/gallery">GALLERY</a><span>/</span><b>TODAY</b>
      <a class="art-nav__editions" href="/gallery/editions">ALL EDITIONS</a><a class="art-nav__manifest" href="/gallery/today.json">JSON MANIFEST ↗</a>
    </nav>

    <header class="hero">
      <p class="eyebrow mono">TODAY'S ART · 20 JUL 2026 · EDIT 001</p>
      <h1>Money, flowers,<br /><em>and signal.</em></h1>
      <div class="hero__dek">
        <p>A PointCast hanging in four rooms. Start in today’s bright Midjourney weather, go down into the archive, turn toward a Los Angeles money-poster suite, then leave through ImageApp’s stranger ocean.</p>
        <p class="mono">28 WORKS · 3 TOOLS · 1 ARTIST<br />CURATED BY MICHAEL HOYDICH + POINTCAST</p>
      </div>
    </header>

    <section class="room room--now" aria-labelledby="room-now">
      <header class="room__head">
        <p class="room__number mono">ROOM 01 / NOW</p>
        <h2 id="room-now">Signal garden,<br /><i>then flowers.</i></h2>
        <p>Five works from today. The wide civic landscape sets the frequency; the flowers answer in saturation.</p>
      </header>
      <div class="now-grid">
        {currentMidjourney.map(([src, title, note], index) => (
          <figure class:list={[index === 0 && 'anchor']}>
            <Image src={src} alt={title} widths={index === 0 ? [720, 1200, 1600] : [400, 700, 1000]} sizes={index === 0 ? '(max-width: 800px) 100vw, 64vw' : '(max-width: 800px) 50vw, 32vw'} format="webp" loading={index < 2 ? 'eager' : 'lazy'} />
            <figcaption><b>{String(index + 1).padStart(2, '0')} · {title}</b><span>{note}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="room room--archive" aria-labelledby="room-archive">
      <header class="room__head room__head--dark">
        <p class="room__number mono">ROOM 02 / MIDJOURNEY DEEP CUT</p>
        <h2 id="room-archive">The school<br /><i>after hours.</i></h2>
        <p>Twelve deliberate pulls from the 652-work El Segundo School archive: governance, flowers, graphic studies, fieldwork, and open studies.</p>
      </header>
      <div class="archive-grid">
        {MIDJOURNEY_DEEP_CUTS.map(([id, title, category], index) => (
          <figure>
            <a href={`${archiveBase}/${id}.webp`} target="_blank" rel="noreferrer">
              <img src={`${archiveBase}/${id}.webp`} alt={title} loading="lazy" width="800" height="1200" />
            </a>
            <figcaption><b>{String(index + 6).padStart(2, '0')} · {title}</b><span class="mono">{category}</span></figcaption>
          </figure>
        ))}
      </div>
      <a class="room__exit mono" href="/el-segundo-school">ENTER THE COMPLETE 652-WORK ARCHIVE →</a>
    </section>

    <section class="room room--ideogram" aria-labelledby="room-ideogram">
      <header class="room__head">
        <p class="room__number mono">ROOM 03 / IDEOGRAM PROFILE DEEP CUT</p>
        <h2 id="room-ideogram">Everything<br /><i>is possible.</i></h2>
        <p>Six cuts from the signed-in <b>mhoydich</b> archive. One tight visual system: pool decks, institutional concrete, old Los Angeles cars, cash, gold, black-and-white grain, and an unreasonably confident red.</p>
      </header>
      <div class="poster-grid">
        {ideogramImages.map((src, index) => (
          <figure>
            <Image src={src} alt={IDEOGRAM_CUTS[index][1]} widths={[420, 720, 1000]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" loading="lazy" />
            <figcaption><b>{IDEOGRAM_CUTS[index][1]}</b><span class="mono">IDEOGRAM · {IDEOGRAM_CUTS[index][0]}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="room room--imageapp" aria-labelledby="room-imageapp">
      <header class="room__head room__head--imageapp">
        <p class="room__number mono">ROOM 04 / IMAGEAPP.XYZ · MIKEIMAGEAPP</p>
        <h2 id="room-imageapp">Money ocean,<br /><i>then get out.</i></h2>
        <p>The local profile export became the source while ImageApp was in maintenance mode. The prompt-named <em>Money Ocean</em> is the hinge; tires, sail, and two Pacific color fields carry the room away from literal wealth.</p>
      </header>
      <div class="imageapp-grid">
        {imageappImages.map((src, index) => (
          <figure class:list={[index === 0 && 'money-ocean']}>
            <Image src={src} alt={IMAGEAPP_CUTS[index][1]} widths={index === 0 ? [720, 1100, 1500] : [420, 720, 1000]} sizes={index === 0 ? '(max-width: 800px) 100vw, 66vw' : '(max-width: 800px) 50vw, 33vw'} format="webp" loading="lazy" />
            <figcaption><b>{IMAGEAPP_CUTS[index][1]}</b><span class="mono">{IMAGEAPP_CUTS[index][2]}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <footer class="colophon">
      <p class="mono">POINTCAST TODAY'S ART · EDIT 001 · EL SEGUNDO, CALIFORNIA</p>
      <p>Original source files are preserved. Tool and profile provenance stays visible. No work in this edit is represented as minted.</p>
      <div><a href="/gallery">ONGOING GALLERY</a><a href="/el-segundo-school">MIDJOURNEY ARCHIVE</a><a href="/gallery/today.json">PUBLIC MANIFEST</a></div>
    </footer>
  </div>
</BlockLayout>

<style>
  .art-edit { --paper: #eee8da; --ink: #17140f; --red: #b92d21; overflow: hidden; color: var(--ink); background: var(--paper); }
  .mono { font-family: var(--pc-font-mono); }
  .art-nav { display: flex; align-items: center; gap: 9px; padding: 12px clamp(16px, 4vw, 64px); color: #e9e4d8; background: #151515; font-size: 8px; letter-spacing: .15em; }
  .art-nav a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .art-nav__editions { margin-left: auto; }
  .hero { min-height: 78vh; display: grid; grid-template-columns: 1fr minmax(280px, .48fr); align-content: space-between; gap: 32px; padding: clamp(28px, 6vw, 90px) clamp(16px, 4vw, 64px); background: #d8ded5; border-bottom: 1px solid var(--ink); }
  .eyebrow { grid-column: 1 / -1; margin: 0; color: var(--red); font-size: 9px; letter-spacing: .17em; }
  .hero h1, .room h2 { margin: 0; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-weight: 400; letter-spacing: -.065em; }
  .hero h1 { align-self: end; font-size: clamp(58px, 10vw, 154px); line-height: .78; }
  .hero h1 em, .room h2 i { color: var(--red); font-weight: 400; }
  .hero__dek { align-self: end; max-width: 52ch; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: clamp(17px, 1.8vw, 23px); line-height: 1.4; }
  .hero__dek .mono { margin-top: 32px; font-size: 8px; line-height: 1.7; letter-spacing: .13em; }
  .room { padding: clamp(42px, 8vw, 120px) clamp(16px, 4vw, 64px); }
  .room__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .65fr); gap: 12px 48px; align-items: end; margin-bottom: clamp(30px, 5vw, 72px); }
  .room__number { grid-column: 1 / -1; margin: 0; font-size: 8px; letter-spacing: .16em; }
  .room h2 { font-size: clamp(48px, 8vw, 118px); line-height: .82; }
  .room__head > p:last-child { max-width: 52ch; margin: 0; font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: clamp(16px, 1.6vw, 21px); line-height: 1.42; }
  figure { min-width: 0; margin: 0; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; flex-direction: column; gap: 5px; padding: 10px 0 20px; }
  figcaption b { font-family: 'Iowan Old Style', 'Palatino', Georgia, serif; font-size: 17px; font-weight: 500; }
  figcaption span { color: #5f574d; font-size: 9px; line-height: 1.4; }
  .now-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 10px; }
  .now-grid .anchor { grid-row: span 2; }
  .now-grid figure { background: #f9f4e9; border: 1px solid var(--ink); }
  .now-grid figure:not(.anchor) img { aspect-ratio: 1 / 1; object-fit: cover; }
  .now-grid .anchor img { height: 100%; min-height: 520px; object-fit: cover; }
  .now-grid figcaption { padding: 12px; }
  .room--archive { color: #eee8da; background: #151515; }
  .room--archive .room__head p, .room--archive figcaption span { color: #a9a394; }
  .room--archive h2 i { color: #f1644e; }
  .archive-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px 16px; }
  .archive-grid img { aspect-ratio: 2 / 3; object-fit: cover; filter: saturate(.88); transition: filter 220ms ease; }
  .archive-grid a:hover img { filter: saturate(1.1); }
  .room__exit { display: inline-block; margin-top: 34px; color: inherit; font-size: 9px; letter-spacing: .14em; text-decoration: none; border-bottom: 1px solid currentColor; }
  .room--ideogram { background: #e8e4db; }
  .poster-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 20px; }
  .poster-grid figure { padding: 8px; background: #f6f2e8; border: 1px solid #24211d; box-shadow: 0 12px 24px rgba(23,20,15,.08); }
  .poster-grid figcaption { padding: 11px 4px 4px; }
  .room--imageapp { background: #efb8ba; }
  .room__head--imageapp h2 i { color: #007f84; }
  .imageapp-grid { display: grid; grid-template-columns: 1.45fr 1fr 1fr; gap: 10px 16px; }
  .imageapp-grid .money-ocean { grid-row: span 2; }
  .imageapp-grid figure img { aspect-ratio: 1 / 1; object-fit: cover; }
  .imageapp-grid .money-ocean img { height: 100%; min-height: 650px; }
  .colophon { display: grid; grid-template-columns: .7fr 1fr 1fr; gap: 28px; padding: 30px clamp(16px, 4vw, 64px) 60px; color: #e9e4d8; background: #151515; font-size: 11px; line-height: 1.6; }
  .colophon .mono { font-size: 8px; letter-spacing: .14em; }
  .colophon p { margin: 0; }
  .colophon div { display: flex; flex-wrap: wrap; align-content: start; gap: 10px 16px; }
  .colophon a { color: inherit; font-family: var(--pc-font-mono); font-size: 8px; letter-spacing: .12em; text-decoration: none; border-bottom: 1px solid currentColor; }
  @media (prefers-reduced-motion: reduce) { .archive-grid img { transition: none; } }
  @media (max-width: 900px) {
    .hero, .room__head { grid-template-columns: 1fr; }
    .hero { min-height: 68vh; }
    .now-grid, .imageapp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .now-grid .anchor, .imageapp-grid .money-ocean { grid-column: 1 / -1; grid-row: auto; }
    .now-grid .anchor img, .imageapp-grid .money-ocean img { height: auto; min-height: 0; }
    .archive-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .colophon { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .art-nav span { display: none; }
    .hero { min-height: 62vh; }
    .now-grid, .poster-grid, .imageapp-grid { grid-template-columns: 1fr; }
    .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .colophon { grid-template-columns: 1fr; }
  }
</style>
