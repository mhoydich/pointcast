---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { july20GalleryManifest } from '../../lib/todays-gallery';
---

<BlockLayout
  title="Money, Flowers, Signal"
  description="Permanent record for PointCast Today's Art edit 001, published July 20, 2026."
  themeColor="#d8ded5"
  alternates={[{ type: 'application/json', href: '/gallery/2026-07-20.json', title: 'Edit 001 manifest' }]}
>
  <main class="archived-edition">
    <nav class="mono"><a href="/">POINTCAST</a><span>/</span><a href="/gallery/editions">EDITIONS</a><span>/</span><b>EDIT 001</b></nav>
    <header>
      <p class="mono">TODAY'S ART · 20 JUL 2026 · PERMANENT RECORD</p>
      <h1>Money, flowers,<br /><i>and signal.</i></h1>
      <p>The first PointCast daily hanging: twenty-eight works across fresh and archival Midjourney, a signed-in Ideogram profile deep cut, and a preserved ImageApp profile export.</p>
      <div class="mono"><a href="/gallery/2026-07-20.json">READ THE PUBLIC MANIFEST →</a><a href="/gallery/editions">ALL EDITIONS →</a></div>
    </header>
    <footer class="mono">{july20GalleryManifest.artist} + POINTCAST · CURATED AND PUBLISHED ≠ MINTED</footer>
  </main>
</BlockLayout>

<style>
  .archived-edition { min-height: 100vh; color: #17140f; background: #d8ded5; }
  .mono { font-family: var(--pc-font-mono); }
  nav { display: flex; gap: 9px; padding: 12px clamp(16px, 4vw, 64px); color: #eee8dc; background: #17140f; font-size: 8px; letter-spacing: .14em; }
  nav a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  header { min-height: 78vh; display: grid; align-content: space-between; gap: 42px; padding: clamp(44px, 8vw, 120px) clamp(16px, 4vw, 64px); }
  header > .mono:first-child { color: #a63424; font-size: 8px; letter-spacing: .15em; }
  h1 { margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(60px, 11vw, 156px); font-weight: 400; line-height: .78; letter-spacing: -.07em; }
  h1 i { color: #a63424; font-weight: 400; }
  header > p:not(.mono) { max-width: 52ch; margin: 0; font-family: 'Iowan Old Style', Palatino, Georgia, serif; font-size: clamp(18px, 2vw, 26px); line-height: 1.4; }
  header > div { display: flex; flex-wrap: wrap; gap: 14px 24px; font-size: 8px; letter-spacing: .12em; }
  header a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  footer { padding: 24px clamp(16px, 4vw, 64px) 60px; color: #eee8dc; background: #17140f; font-size: 8px; letter-spacing: .13em; }
</style>
