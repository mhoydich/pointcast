  .instructions span, .instructions strong, .sound-button, .dash-button { font-family: 'JetBrains Mono Variable', monospace; }
  .instructions span { font-size: 8px; font-weight: 850; letter-spacing: .12em; }
  .instructions strong { margin-top: 5px; font-size: 10px; }
  .dash-button { position: relative; min-height: 75px; padding: 10px 16px; overflow: hidden; border: 0; border-left: 2px solid var(--ink); border-right: 2px solid var(--ink); background: #ddd5c5; color: var(--ink); cursor: pointer; text-align: left; }
  .dash-button[data-ready='true'] { background: var(--gold); }
