  .start-card > p:not(.start-card__kicker):not(.start-card__note) { max-width: 490px; margin: 18px 0; font-size: 15px; line-height: 1.4; font-weight: 650; }
  .time-pick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin: 15px 0 10px; }
  .time-pick button { min-height: 62px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; }
  .time-pick button[aria-pressed='true'] { background: var(--gold); box-shadow: inset 0 -6px 0 rgba(20,33,61,.16); }
  .time-pick strong, .time-pick span { display: block; }
  .time-pick strong { font: 900 25px/.9 'Inter Variable', sans-serif; }
  .time-pick span { margin-top: 5px; font: 800 7px/1 'JetBrains Mono Variable', monospace; letter-spacing: .1em; }
  .start-button { width: 100%; min-height: 54px; padding: 0 17px; border: 3px solid var(--ink); display: flex; align-items: center; justify-content: space-between; background: var(--ink); color: #fff; cursor: pointer; font: 900 12px/1 'JetBrains Mono Variable', monospace; letter-spacing: .08em; }
  .start-button:hover { background: var(--red); }
