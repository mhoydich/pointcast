    color: #fff;
    text-shadow: 5px 5px 0 var(--ink);
    font: 950 clamp(76px, 14vw, 190px)/.8 'Inter Variable', sans-serif;
    letter-spacing: -.08em;
  }
  .countdown.is-visible { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .tag-flash { padding: 12px 18px; background: var(--red); border: 4px solid var(--ink); font-size: clamp(32px, 7vw, 88px); white-space: nowrap; }
  .tag-flash.is-showing { animation: tag-pop .62s ease-out; }
  @keyframes tag-pop { 0% { opacity: 0; transform: translate(-50%,-30%) scale(.65) rotate(-3deg); } 18%,65% { opacity: 1; transform: translate(-50%,-50%) scale(1) rotate(0); } 100% { opacity: 0; transform: translate(-50%,-75%) scale(.9); } }

  .control-bar {
    min-height: 78px;
