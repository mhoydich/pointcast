  .start-card__note { margin: 12px 0 0; text-align: center; font: 700 7px/1.3 'JetBrains Mono Variable', monospace; letter-spacing: .08em; }

  .countdown, .tag-flash {
    position: absolute;
    z-index: 8;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.7);
