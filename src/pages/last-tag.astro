  .dash-button span { display: block; font-size: 8px; font-weight: 900; letter-spacing: .1em; }
  .dash-button strong { display: block; margin: 4px 0 8px; font-size: 18px; }
  .dash-button i { display: block; height: 7px; border: 1px solid var(--ink); background: #fff; }
  .dash-button b { display: block; height: 100%; width: 100%; background: var(--ink); }
  .sound-button { min-width: 110px; border: 0; background: var(--ink); color: #fff; cursor: pointer; font-size: 8px; font-weight: 900; }
  .live-status { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); }

  .rule-strip {
    width: min(100%, 1180px);
    margin: 22px auto 0;
    padding: 0 18px 38px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .rule-strip article { min-height: 165px; padding: 20px; border: 2px solid var(--ink); border-right: 0; background: var(--paper); }
  .rule-strip article:last-child { border-right: 2px solid var(--ink); }
  .rule-strip span { font: 900 9px/1 'JetBrains Mono Variable', monospace; }
  .rule-strip strong { display: block; margin-top: 22px; font-size: 18px; }
  .rule-strip p { margin: 8px 0 0; font-size: 12px; line-height: 1.4; }
  .game-foot { min-height: 70px; padding: 0 clamp(18px, 4vw, 60px); border-top: 3px solid var(--ink); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; background: var(--ink); color: #fff; font: 800 9px/1 'JetBrains Mono Variable', monospace; letter-spacing: .09em; }
  .game-foot a { color: #fff; text-align: center; }
  .game-foot span:last-child { text-align: right; }

  @media (max-width: 760px) {
    .game-head { min-height: 78px; grid-template-columns: 1fr auto; }
    .title-lockup { grid-column: 1 / -1; grid-row: 2; padding-top: 10px; }
    .title-lockup h1 { font-size: 50px; }
    .game-head nav { font-size: 8px; }
    .scorebar { grid-template-columns: 1.3fr 1.1fr repeat(3, .75fr); }
    .scorebar > div { padding: 8px; }
    .scorebar strong { font-size: 23px; }
    .arena-wrap { min-height: 0; aspect-ratio: auto; overflow: visible; }
    #arena { width: 100%; height: auto; aspect-ratio: 8 / 5; }
    .start-card { position: relative; inset: auto; width: 100%; transform: none; padding: 17px; border: 0; border-top: 3px solid var(--ink); box-shadow: none; }
    .start-card__top span:last-child { display: none; }
    .start-card__kicker { margin-top: 16px; }
    .start-card h2 { font-size: clamp(44px, 16vw, 72px); }
