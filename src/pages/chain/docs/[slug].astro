---
/**
 * /chain/docs/{slug} — one pointcast-chain doc, rendered from a verbatim copy
 * of the repo's markdown (src/data/chain-docs/). The source commit and the
 * file's sha256 sit at the top and the bottom of every page.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import ChainHeader from '../../../components/chain/ChainHeader.astro';
import { CHANNELS } from '../../../lib/channels';
import { CHAIN_DOCS, DOCS_COMMIT, prepareDocHtml, type ChainDoc } from '../../../data/chain-docs';
import '../../../styles/chain.css';

type MdModule = { compiledContent: () => Promise<string>; getHeadings: () => { depth: number; slug: string; text: string }[] };

export function getStaticPaths() {
  return CHAIN_DOCS.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props as { doc: ChainDoc };
const modules = import.meta.glob<MdModule>('../../../data/chain-docs/*.md', { eager: true });
const mod = Object.entries(modules).find(([path]) => path.endsWith(`/${doc.file}`))?.[1];
if (!mod) throw new Error(`chain doc missing: ${doc.file}`);

const html = prepareDocHtml(await mod.compiledContent());
const headings = mod.getHeadings();
const docTitle = headings.find((h) => h.depth === 1)?.text ?? doc.title;
const toc = headings.filter((h) => h.depth === 2);
const i = CHAIN_DOCS.findIndex((d) => d.slug === doc.slug);
const prev = CHAIN_DOCS[i - 1];
const next = CHAIN_DOCS[i + 1];
const ch = CHANNELS.FD;
const url = `https://pointcast.xyz/chain/docs/${doc.slug}/`;
const title = `${doc.title.replace(/\.$/, '')} · PointCast Chain docs`;
const description = `${doc.summary} Copied from the pointcast-chain repo (${doc.source} at ${DOCS_COMMIT}).`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: docTitle,
  name: doc.title,
  description,
  url,
  dateModified: '2026-10-03',
  isPartOf: { '@type': 'CollectionPage', name: 'PointCast Chain docs', url: 'https://pointcast.xyz/chain/docs/' },
  about: { '@type': 'SoftwareSourceCode', name: 'pointcast-chain', version: DOCS_COMMIT },
};
---

<BlockLayout title={title} description={description} image="/images/og/b/0660.png" imageWidth={1200} imageHeight={630} jsonLd={jsonLd} hideAds>
  <div class="chn" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <ChainHeader current="docs" trail={[{ label: 'docs', href: '/chain/docs/' }, { label: doc.slug }]} />

    <header class="hero hero--doc">
      <p class="kicker">DOCS · {doc.kicker}</p>
      <h1>{docTitle}</h1>
      <p class="dek">{doc.summary}</p>
      <p class="src">
        <span>SOURCE · pointcast-chain/<b>{doc.source}</b> at <b>{DOCS_COMMIT}</b></span>
        <span>SHA256 · <code>{doc.sha256}</code></span>
      </p>
    </header>

    <div class="doc">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="kicker">ON THIS PAGE</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class="prose" set:html={html} />
    </div>

    <nav class="pager" aria-label="More docs">
      {prev ? <a href={`/chain/docs/${prev.slug}/`}><span>← PREVIOUS</span>{prev.title}</a> : <a href="/chain/docs/"><span>← ALL DOCS</span>The docs index.</a>}
      {next ? <a href={`/chain/docs/${next.slug}/`}><span>NEXT →</span>{next.title}</a> : <a href="/chain/dev"><span>NEXT →</span>The dev tools.</a>}
    </nav>

    <footer class="method">
      <p class="kicker">METHOD</p>
      <p>
        This page renders a verbatim copy of <code>{doc.source}</code> from the pointcast-chain repository at {DOCS_COMMIT}
        (sha256 above). Two things change at render time and nothing else: links to other published docs point at their
        pages here, and local file paths are shortened (<code>~</code> for the home folder). The repo itself is local and has
        no public remote, so links to its other files appear as plain text. It is a working document: plans in it are plans.
      </p>
    </footer>
  </div>
</BlockLayout>

<style>
  .hero--doc{padding-bottom:18px}
  .hero--doc h1{font-size:clamp(30px,4.6vw,52px);line-height:1.04}
  .src{display:flex;flex-direction:column;gap:4px;margin:18px 0 0;font:400 11px/1.6 var(--pc-font-mono);letter-spacing:.06em;color:var(--pc-ink-muted);overflow-wrap:anywhere}
  .src b{font-weight:500;color:var(--c800)}
  .src code{font-size:11px}
  .doc{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr);gap:28px;align-items:start;padding-top:8px;border-top:1.5px solid var(--c600)}
  .toc{position:sticky;top:12px;padding-top:14px;max-height:calc(100vh - 24px);overflow:auto}
  .toc ol{list-style:none;margin:0;padding:0;font:400 13px/1.45 var(--pc-font-sans)}
  .toc li{margin:0 0 7px}
  .toc a{color:var(--pc-ink-soft)}
  .toc a:hover{color:var(--c800)}
  .prose{min-width:0;max-width:820px;padding-top:6px;font:400 16px/1.65 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .prose :global(h2){margin:44px 0 12px;padding-top:12px;border-top:1px solid var(--pc-rule-soft);font:500 26px/1.15 var(--pc-font-sans);letter-spacing:-.02em;color:var(--pc-ink);scroll-margin-top:12px}
  .prose :global(h2:first-child){margin-top:12px}
  .prose :global(h3){margin:30px 0 10px;font:500 19px/1.3 var(--pc-font-sans);color:var(--pc-ink);scroll-margin-top:12px}
  .prose :global(h4){margin:22px 0 8px;font:500 12px/1.5 var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--c800)}
  .prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 14px}
  .prose :global(ul),.prose :global(ol){padding-left:1.3em}
  .prose :global(li){margin:0 0 6px}
  .prose :global(li > ul),.prose :global(li > ol){margin:6px 0 0}
  .prose :global(strong){color:var(--pc-ink)}
  .prose :global(a){color:var(--c800);border-bottom:1px solid var(--c600)}
  .prose :global(a:hover){text-decoration:none;background:var(--c50)}
  .prose :global(blockquote){margin:0 0 16px;padding:12px 14px;border-left:6px solid var(--c600);background:var(--c50);color:var(--pc-ink-soft)}
  .prose :global(blockquote p:last-child){margin-bottom:0}
  .prose :global(hr){border:0;border-top:1px solid var(--pc-rule);margin:28px 0}
  .prose :global(.tbl){margin:0 0 16px}
  .prose :global(table){font-size:14px}
  .prose :global(.doc__repo){font-family:var(--pc-font-mono);font-size:.88em;color:var(--pc-ink);border-bottom:1px dotted var(--pc-rule)}
  .pager{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:48px}
  .pager a{display:block;padding:14px 16px;border:1.5px solid var(--c600);font:500 16px/1.35 var(--pc-font-sans);color:var(--pc-ink)}
  .pager a:hover{background:var(--c50);text-decoration:none}
  .pager a:last-child{text-align:right}
  .pager span{display:block;margin-bottom:6px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;color:var(--c800)}
  @media (max-width:900px){
    .doc{grid-template-columns:minmax(0,1fr);gap:0}
    .toc{position:static;max-height:none;padding:14px 0;border-bottom:1px solid var(--pc-rule-soft)}
    .toc ol{columns:2;column-gap:18px}
  }
  @media (max-width:640px){
    .toc ol{columns:1}
    .pager{grid-template-columns:minmax(0,1fr)}
    .pager a:last-child{text-align:left}
    .prose{font-size:15px}
  }
</style>
