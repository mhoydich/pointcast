---
/**
 * /chain/docs/ — the pointcast-chain docs, readable on the site. Each doc is
 * a verbatim copy of the repo file at DOCS_COMMIT; see src/data/chain-docs.ts.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import ChainHeader from '../../../components/chain/ChainHeader.astro';
import { CHANNELS } from '../../../lib/channels';
import { CHAIN_DOCS, DOCS_COMMIT } from '../../../data/chain-docs';
import '../../../styles/chain.css';

const ch = CHANNELS.FD;
const title = 'PointCast Chain docs';
const description = `The pointcast-chain docs in full: the README, the design notes, the v2 plan, the wallet scope, art minting, the simulator’s findings and two review reports, copied from the repo at ${DOCS_COMMIT}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://pointcast.xyz/chain/docs/',
  hasPart: CHAIN_DOCS.map((d) => ({ '@type': 'TechArticle', name: d.title, url: `https://pointcast.xyz/chain/docs/${d.slug}/` })),
  isPartOf: { '@type': 'WebPage', name: 'PointCast Chain', url: 'https://pointcast.xyz/chain' },
};
---

<BlockLayout title={title} description={description} image="/images/og/b/0660.png" imageWidth={1200} imageHeight={630} jsonLd={jsonLd} hideAds>
  <div class="chn" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <ChainHeader current="docs" />

    <header class="hero">
      <p class="kicker">CHAIN · DOCS · FROM THE REPO AT {DOCS_COMMIT}</p>
      <h1>The docs, in full.</h1>
      <p class="dek">
        Eight documents from the pointcast-chain repository, copied word for word. They are long, and they are working
        documents: where they describe a plan, it is a plan. Start with the README, or with the design notes if you want
        the why.
      </p>
    </header>

    <ol class="cards docs">
      {CHAIN_DOCS.map((d, i) => (
        <li class={`card${i < 2 ? ' card--tint' : ''}`}>
          <p class="card__k">{String(i + 1).padStart(2, '0')} · {d.kicker}</p>
          <h3><a href={`/chain/docs/${d.slug}/`}>{d.title}</a></h3>
          <p>{d.summary}</p>
          <p class="card__links"><span class="src">{d.source}</span><a href={`/chain/docs/${d.slug}/`}>Read →</a></p>
        </li>
      ))}
    </ol>

    <section class="sec" aria-labelledby="more-title">
      <p class="kicker">ALSO ON THE SITE</p>
      <h2 id="more-title" class="h2">Run it, then read the source.</h2>
      <ul class="rows">
        <li><b><a href="/chain/dev">Dev tools</a></b><span>The quickstart, every HTTP route, the MCP tools, the CLI and the SDK, built from the node’s own route declarations.</span></li>
        <li><b><a href="/chain/sdk/pointcast-chain.js">pointcast-chain.js</a></b><span>The zero-dependency SDK as one static file, unchanged from the repo.</span></li>
        <li><b><a href="/chain/case-study">Case study</a></b><span>How the chain was built in two days by a team of AI agents, in the University of El Segundo casebook format.</span></li>
      </ul>
    </section>

    <footer class="method">
      <p class="kicker">METHOD</p>
      <p>
        Each doc page shows the repo path, the commit and the file’s sha256, so anyone with the repo can check the copy.
        The repo is local and has no public remote. Pages change two things at render time: links between these docs,
        and local file paths, which are shortened.
      </p>
    </footer>
  </div>
</BlockLayout>

<style>
  .docs h3 a{color:var(--pc-ink)}
  .docs h3 a:hover{color:var(--c800);text-decoration:none}
  .docs .src{font:400 11px var(--pc-font-mono);letter-spacing:.02em;text-transform:none;color:var(--pc-ink-muted);margin-right:auto}
</style>
