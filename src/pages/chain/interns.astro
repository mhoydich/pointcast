---
/**
 * /chain/interns — ten intern exploration assignments for pointcast-chain.
 * Data: src/data/chain-interns.ts (also served as /chain/interns.json).
 * Shape and voice follow the PointCast intern desk: project briefs, not
 * employment offers; submissions through /ping, reviewed before follow-up.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import ChainHeader from '../../components/chain/ChainHeader.astro';
import { CHANNELS } from '../../lib/channels';
import { ASSIGNMENTS, INTERN_PROGRAM } from '../../data/chain-interns';
import '../../styles/chain.css';

const ch = CHANNELS.FD;
const title = 'PointCast Chain intern assignments';
const description =
  'Ten exploration assignments for interns on pointcast-chain: run a node and VERIFY, audit the Block Yard and First Mints on phones, write a simulator scenario, test passkeys, spec an El Segundo oracle feed, and explain the chain to a neighbor. No keys, no money, no posting.';
const md = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description,
  url: 'https://pointcast.xyz/chain/interns/',
  numberOfItems: ASSIGNMENTS.length,
  itemListElement: ASSIGNMENTS.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'LearningResource', name: a.title, identifier: a.id, timeRequired: a.time, educationalLevel: a.difficulty, url: `https://pointcast.xyz/chain/interns/#${a.id.toLowerCase()}` },
  })),
};
---

<BlockLayout title={title} description={description} image="/images/og/b/0660.png" imageWidth={1200} imageHeight={630} jsonLd={jsonLd} hideAds alternates={[{ type: 'application/json', href: '/chain/interns.json', title: 'PointCast Chain intern assignments (JSON)' }]}>
  <div class="chn" style={`--c50:${ch.color50};--c600:${ch.color600};--c800:${ch.color800}`}>
    <ChainHeader current="interns" />

    <header class="hero">
      <p class="kicker">CHAIN · INTERN EXPLORATION ASSIGNMENTS · {INTERN_PROGRAM.statusLabel.toUpperCase()}</p>
      <h1>Ten small, safe ways in.</h1>
      <p class="dek">
        Each assignment is a question, a few numbered steps and one thing to hand back. Some need the chain’s source; most
        work from public pages today. None needs a key, money or a public post.
      </p>
      <p class="jump">
        <a href="#rules">the rules</a><a href="#list">the ten</a><a href="#submit">how to submit</a><a href="/chain/interns.json">interns.json</a>
      </p>
    </header>

    <section id="rules" class="sec" aria-labelledby="rules-title">
      <p class="kicker">01 · THE RULES · FOR EVERY ASSIGNMENT</p>
      <h2 id="rules-title" class="h2">No keys, no money, no posting.</h2>
      <ul class="bullets">{INTERN_PROGRAM.rules.map((r) => <li>{r}</li>)}</ul>
      <p class="note" style="margin-top:14px">{INTERN_PROGRAM.sourceAccess}</p>
      <p class="fine">
        These are educational project briefs. Applications are closed, and pay, hours, the hiring entity, supervision,
        eligibility, agreements and privacy terms are all unsettled; nobody starts as an employee from this page. The wider
        PointCast intern desk is at <a href="/intern">/intern</a>.
      </p>
    </section>

    <section id="list" class="sec" aria-labelledby="list-title">
      <p class="kicker">02 · THE TEN · SPREAD FROM A FIRST AFTERNOON TO A FEW DAYS</p>
      <h2 id="list-title" class="h2">Pick one. Finish it. Send it in.</h2>
      <div class="tbl">
        <table>
          <thead><tr><th scope="col">Id</th><th scope="col">Assignment</th><th scope="col">Level</th><th scope="col">Time</th><th scope="col">Source</th></tr></thead>
          <tbody>
            {ASSIGNMENTS.map((a) => (
              <tr>
                <td><code>{a.id}</code></td>
                <th scope="row"><a href={`#${a.id.toLowerCase()}`}>{a.title}</a></th>
                <td>{a.difficulty}</td>
                <td>{a.time}</td>
                <td>{a.needsSource ? 'needs the source' : 'public pages'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ol class="assignments">
        {ASSIGNMENTS.map((a, i) => (
          <li id={a.id.toLowerCase()} class={`asg${i % 2 === 0 ? ' asg--tint' : ''}`}>
            <p class="card__k">{a.id} · {a.difficulty.toUpperCase()} · {a.time.toUpperCase()}{a.needsSource ? ' · NEEDS THE SOURCE' : ''}</p>
            <h3>{a.title}.</h3>
            <p class="asg__why"><b>Why it matters.</b> {a.why}</p>
            <div class="asg__grid">
              <div>
                <p class="asg__h">Steps</p>
                <ol class="steps">{a.steps.map((s) => <li set:html={md(s)} />)}</ol>
              </div>
              <div>
                <p class="asg__h">Deliverable</p>
                <p class="asg__p">{a.deliverable}</p>
                <p class="asg__h">Skills</p>
                <p class="asg__p">{a.skills.join(' · ')}</p>
                <p class="asg__h">What not to do</p>
                <ul class="bullets asg__no">{a.doNot.map((d) => <li>{d}</li>)}</ul>
                <p class="asg__h">Read first</p>
                <p class="card__links">{a.read.map((r) => <a href={r.href}>{r.label} →</a>)}</p>
              </div>
            </div>
            <p class="asg__submit">Submit: a note through <a href="/ping">/ping</a> with <code>{a.id}</code> and a link to your deliverable.</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="submit" class="sec" aria-labelledby="submit-title">
      <p class="kicker">03 · HOW TO SUBMIT · THE INTERN DESK’S PATTERN</p>
      <h2 id="submit-title" class="h2">One note, reviewed before anything is public.</h2>
      <p class="note">{INTERN_PROGRAM.submit.how}</p>
      <p class="cta">
        <a class="btn" href="/ping">Open /ping</a>
        <a class="btn btn--ghost" href="/chain/interns.json">interns.json</a>
        <span>The same assignments, machine-readable.</span>
      </p>
    </section>

    <footer class="method">
      <p class="kicker">METHOD</p>
      <p>
        Assignments follow the PointCast intern desk’s shape (<a href="/intern.json">/intern.json</a>,
        <a href="/internships/roles.json">roles.json</a>, <a href="/internships/program.json">program.json</a>) and cite the
        pointcast-chain docs at {INTERN_PROGRAM.sourceCommit}. Edition {INTERN_PROGRAM.edition}. Written by Claude Code.
      </p>
    </footer>
  </div>
</BlockLayout>

<style>
  .assignments{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:8px}
  .asg{border:1.5px solid var(--c600);padding:18px;scroll-margin-top:12px;min-width:0}
  .asg--tint{background:var(--c50)}
  .asg h3{margin:0;font:500 clamp(20px,2.4vw,24px)/1.2 var(--pc-font-sans);letter-spacing:-.015em}
  .asg__why{margin:10px 0 0;max-width:820px;font:400 15px/1.6 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .asg__why b{color:var(--pc-ink)}
  .asg__grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:20px;margin-top:14px;padding-top:14px;border-top:1px solid var(--pc-rule-soft)}
  .asg__h{margin:0 0 6px;font:500 10px/1.5 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .asg__h:not(:first-child){margin-top:14px}
  .asg__p{margin:0;font:400 14px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .asg__no{font-size:14px}
  .asg__submit{margin:14px 0 0;padding-top:10px;border-top:1px solid var(--pc-rule-soft);font:400 12px/1.5 var(--pc-font-mono);color:var(--pc-ink-muted)}
  .asg__submit a{color:var(--c800)}
  @media (max-width:760px){.asg__grid{grid-template-columns:minmax(0,1fr)}}
</style>
