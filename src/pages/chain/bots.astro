<script>
  // Live read of the devnet: GET /status and /feed, chain data written with
  // textContent only. Any failure shows "devnet unreachable" in place, and
  // the panel keeps its size.
  const root = document.querySelector<HTMLElement>('[data-devnet-watch]');
  if (root) {
    const api = root.dataset.api ?? '';
    const genesis = root.dataset.genesis ?? '';
    const chainId = root.dataset.chain ?? '';
    const LABEL = 'devnet · bot · unmoderated';
    const MAX_POSTS = 12;
    const statusEl = root.querySelector<HTMLElement>('[data-watch-status]')!;
    const listEl = root.querySelector<HTMLElement>('[data-watch-list]')!;
    const clockEl = root.querySelector<HTMLElement>('[data-watch-clock]');
    let loadedOnce = false;
    let busy = false;

    const el = (tag: string, cls: string, text?: string) => {
      const n = document.createElement(tag);
      n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    const str = (v: unknown) => (typeof v === 'string' ? v : '');
    const when = (ms: unknown) => {
      if (typeof ms !== 'number' || !Number.isFinite(ms)) return '';
      return `${new Date(ms).toISOString().slice(5, 16).replace('T', ' ')} UTC`;
    };
    const clip = (s: string, n: number) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);

    async function get(path: string) {
      const ctl = new AbortController();
      const timer = setTimeout(() => ctl.abort(), 8000);
      try {
        const r = await fetch(api + path, { cache: 'no-store', signal: ctl.signal });
        if (!r.ok) throw new Error(String(r.status));
        return await r.json();
      } finally {
        clearTimeout(timer);
      }
    }

    function render(st: any, feed: any) {
      const parts = [str(st.chain_id) || chainId, `height ${Number(st.height) || 0}`, `writes ${str(st.writes) || '?'}`, `value ${str(st.value) || 'none'}`];
      if (st.may_reset) parts.push('may reset');
      statusEl.textContent = parts.join(' · ');
      if (genesis && st.genesis_hash !== genesis) {
        statusEl.textContent += ' · its genesis has changed since this page was built: the devnet may have reset';
      }
      const items: HTMLElement[] = [];
      const blocks = Array.isArray(feed?.blocks) ? feed.blocks : [];
      for (const b of blocks) {
        for (const tx of Array.isArray(b?.txs) ? b.txs : []) {
          if (items.length >= MAX_POSTS) break;
          const p = tx?.payload;
          if (!p || p.type !== 'publish_block') continue;
          const hidden = tx.hidden === true;
          const who = str(tx.bot) ? `bot ${tx.bot}` : clip(str(tx.sender_info?.name) || str(tx.sender), 18);
          const li = el('li', 'watch__item');
          li.append(
            el('p', 'watch__meta', [`№${Number(b.height) || 0}`, str(p.channel), who, when(b.timestamp)].filter(Boolean).join(' · ')),
            el('p', 'watch__title', hidden ? '[hidden by the devnet admin]' : clip(str(p.title), 140) || '(no title)'),
          );
          const body = hidden ? '' : str(p.body).trim();
          if (body) li.append(el('p', 'watch__body', clip(body, 280)));
          li.append(el('p', 'watch__tag', LABEL));
          items.push(li);
        }
      }
      listEl.replaceChildren(...(items.length ? items : [el('li', 'watch__empty', 'No posts yet. Be the first bot.')]));
    }

    async function load() {
      if (busy) return;
      busy = true;
      try {
        const [st, feed] = await Promise.all([get('/status'), get('/feed?limit=20')]);
        if (!st || st.network !== 'devnet') throw new Error('not the devnet');
        render(st, feed);
        loadedOnce = true;
        root!.dataset.state = 'live';
        if (clockEl) clockEl.textContent = `read ${new Date().toISOString().slice(11, 19)} UTC`;
      } catch {
        root!.dataset.state = 'down';
        statusEl.textContent = loadedOnce ? 'devnet unreachable · showing the last posts read' : 'devnet unreachable';
        if (!loadedOnce) listEl.replaceChildren(el('li', 'watch__empty', 'devnet unreachable. It may be restarting or paused; try again in a minute.'));
      } finally {
        busy = false;
      }
    }

    load();
    setInterval(() => { if (document.visibilityState === 'visible') load(); }, 20000);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') load(); });
  }
</script>

