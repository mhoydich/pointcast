---
/**
 * /chain/receipt — look up one devnet transaction and read the node's receipt.
 * BlockLayout mounts the shared pageview beacon. The desk itself does not sign
 * or submit anything; public/chain/receipt/desk.js only reads the node.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { DEVNET } from '../../data/chain-home';
---
<BlockLayout
  title="Receipt desk"
  description="Look up a PointCast devnet transaction and understand the node's receipt."
  themeColor="#142c2a"
  hideAds
>
  <style is:inline>
    .receipt-desk, .receipt-desk * { box-sizing: border-box; }
    .receipt-desk {
      font-family: system-ui, sans-serif;
      color: #202d29;
      background: #f5f2e9;
    }
    .receipt-desk .sheet { max-width: 920px; margin: auto; padding: 24px clamp(18px, 5vw, 48px) 64px; }
    .receipt-desk a { color: #175e54; }
    .receipt-desk nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: .85rem; }
    .receipt-desk h1 { font: 400 clamp(2.6rem, 7vw, 5rem)/1 Georgia, serif; letter-spacing: -.04em; margin: 22px 0; }
    .receipt-desk .eyebrow { margin-top: 60px; text-transform: uppercase; letter-spacing: .14em; font-weight: 700; font-size: .75rem; color: #60766a; }
    .receipt-desk .lead { max-width: 670px; line-height: 1.6; color: #53655b; }
    .receipt-desk .notice { border-left: 3px solid #bd7649; padding: 12px 16px; background: #eae6d9; line-height: 1.5; font-size: .9rem; }
    .receipt-desk .panel { border: 1px solid #d6d2c6; border-radius: 8px; background: #fffefa; padding: clamp(16px, 4vw, 30px); margin-top: 28px; }
    .receipt-desk .label { display: block; font-weight: 700; font-size: .85rem; margin-bottom: 8px; }
    .receipt-desk input, .receipt-desk button { font: inherit; }
    .receipt-desk input { display: block; width: 100%; min-height: 48px; border: 1px solid #a5b0a2; border-radius: 4px; padding: 10px 12px; overflow-wrap: anywhere; }
    .receipt-desk button { min-height: 48px; border: 1px solid #183e37; border-radius: 4px; padding: 10px 18px; background: #183e37; color: #fff; font-weight: 700; cursor: pointer; margin-top: 12px; }
    .receipt-desk button:disabled { opacity: .65; cursor: wait; }
    .receipt-desk button:focus-visible, .receipt-desk input:focus-visible, .receipt-desk a:focus-visible { outline: 3px solid #c47849; outline-offset: 3px; }
    .receipt-desk .hint { font-size: .82rem; color: #637469; line-height: 1.5; }
    .receipt-desk .status { margin-top: 24px; line-height: 1.55; }
    .receipt-desk .result { border-top: 1px solid #ddd8cb; margin-top: 20px; padding-top: 20px; }
    .receipt-desk .result h2 { font: 400 1.8rem Georgia, serif; margin: 0 0 8px; }
    .receipt-desk .result dl { display: grid; grid-template-columns: minmax(110px, 160px) 1fr; gap: 10px; margin: 20px 0; }
    .receipt-desk .result dt { color: #68786b; }
    .receipt-desk .result dd { margin: 0; overflow-wrap: anywhere; }
    .receipt-desk .result code { font-size: .85rem; }
    .receipt-desk .footer { margin-top: 28px; color: #637469; font-size: .85rem; line-height: 1.55; }
    @media (max-width: 520px) {
      .receipt-desk .eyebrow { margin-top: 40px; }
      .receipt-desk .result dl { grid-template-columns: 1fr; gap: 5px; }
      .receipt-desk .result dd { margin-bottom: 12px; }
      .receipt-desk button { width: 100%; }
    }
  </style>
  <div class="receipt-desk">
    <div class="sheet">
      <nav><a href="/chain/">← PointCast Chain</a><a href="/chain/start/">Wallet &amp; signing</a><a href="/chain/verify-a-block/">Verify a block</a></nav>
      <p class="eyebrow">PointCast · devnet utility</p>
      <h1>Receipt desk.</h1>
      <p class="lead">Paste a transaction hash to see whether the PointCast node has received, included, or rejected it. Use this after a transaction, or share the result with someone checking the same hash.</p>
      <p class="notice"><strong>Play network.</strong> This is a single-server devnet; it can reset and its ATTN has no promised value. A node's response is an observation, not an independent proof or a finality guarantee.</p>
      <section class="panel" data-receipt-desk data-api={DEVNET.url} data-genesis={DEVNET.genesis}>
        <form data-form>
          <label class="label" for="hash">Transaction hash</label>
          <input id="hash" name="hash" placeholder="64 hexadecimal characters" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="64" required />
          <p class="hint">Find the hash on the receipt shown after you submit a transaction. Never paste a private key or recovery phrase.</p>
          <button data-submit>Check transaction</button>
        </form>
        <div class="status" data-status role="status" aria-live="polite"></div>
        <div data-result></div>
        <noscript><p>JavaScript is needed to look up a transaction.</p></noscript>
      </section>
      <p class="footer">To independently examine an included block, open <a href="/chain/verify-a-block/">Verify a block</a> and enter the height shown here. This desk does not sign or submit transactions.</p>
    </div>
  </div>
  <script is:inline type="module" src="/chain/receipt/desk.js"></script>
</BlockLayout>
