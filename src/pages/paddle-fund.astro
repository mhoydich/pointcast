---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CHANNELS } from '../lib/channels';
import {
  PADDLE_FUND_BLOCK,
  PADDLE_FUND_CALLS,
  PADDLE_FUND_EMBED_ORIGIN,
  PADDLE_FUND_EMBED_URL,
  PADDLE_FUND_GUARDRAILS,
  PADDLE_FUND_MATH,
  PADDLE_FUND_RALLY_URL,
  PADDLE_FUND_RULES,
  PADDLE_FUND_URL,
  PADDLE_FUND_WIRING,
} from '../lib/paddle-fund';

const title = 'The Paddle Fund';
const description =
  'Ten players, $20 a week, ten weeks: a $200 pickleball paddle lands every week and the ladder sets the order. Take it, punt it to a bigger kit, or pass it on. A playable concept — pretend money, no wallet.';
const court = CHANNELS.CRT;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': PADDLE_FUND_URL,
  name: title,
  description,
  url: PADDLE_FUND_URL,
  applicationCategory: 'GameApplication',
  isAccessibleForFree: true,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  sameAs: PADDLE_FUND_RALLY_URL,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="fund" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/c/court">court</a><span>/</span><span>paddle fund</span>
      <a href={`/b/${PADDLE_FUND_BLOCK}`}>BLOCK {PADDLE_FUND_BLOCK}</a>
    </nav>

    <header class="hero">
      <p class="kicker">CH.CRT · COURT · PLAYABLE CONCEPT · NO MONEY MOVES HERE</p>
      <h1>A new paddle every week.</h1>
      <p class="dek">
        Ten players put in twenty dollars a week. That is exactly one $200 paddle, so one lands
        every week for ten weeks, and the ladder decides who unboxes first. When your week comes
        up you take it, punt it to a bigger kit, or pass it on.
      </p>
    </header>

    <section class="math" aria-label="The arithmetic">
      {PADDLE_FUND_MATH.map(([figure, note]) => (
        <div><strong>{figure}</strong><span>{note}</span></div>
      ))}
    </section>

    <section class="table" aria-label="The pretend sprint">
      <div class="table__head">
        <p class="kicker">THE TABLE · TWO SPRINTS · YOU ARE SEAT FIVE</p>
        <a href={PADDLE_FUND_RALLY_URL}>open on Rally ↗</a>
      </div>
      <iframe
        id="paddle-fund-frame"
        src={PADDLE_FUND_EMBED_URL}
        data-origin={PADDLE_FUND_EMBED_ORIGIN}
        title="The Paddle Fund — a pretend ten-week sprint, hosted on Rally"
        loading="lazy"
        height="720"
      ></iframe>
      <p class="table__note">
        The table runs on Rally, the town's pickleball rating desk. Pretend money, no wallet, no
        sign-in. Pay your twenty, watch the pot fill, and make the call when your week comes up.
      </p>
    </section>

    <section class="calls" aria-label="The three calls">
      <p class="kicker">YOUR WEEK · THREE CALLS</p>
      <div class="grid3">
        {PADDLE_FUND_CALLS.map(([name, note]) => (
          <div class="cell"><small>{name}</small><span>{note}</span></div>
        ))}
      </div>
    </section>

    <section class="rules" aria-label="How a sprint runs">
      <p class="kicker">HOW A SPRINT RUNS</p>
      <div class="rows">
        {PADDLE_FUND_RULES.map(([name, note]) => (
          <div class="row"><strong>{name}</strong><span>{note}</span></div>
        ))}
      </div>
    </section>

    <section class="rules" aria-label="The guardrails">
      <p class="kicker">THE GUARDRAILS</p>
      <div class="rows">
        {PADDLE_FUND_GUARDRAILS.map(([name, note]) => (
          <div class="row"><strong>{name}</strong><span>{note}</span></div>
        ))}
      </div>
    </section>

    <section class="rules" aria-label="What is already built">
      <p class="kicker">MOSTLY ALREADY BUILT</p>
      <div class="rows">
        {PADDLE_FUND_WIRING.map(([part, what, url]) => (
          <a class="row row--link" href={url}><strong>{part}</strong><span>{what}</span><b aria-hidden="true">↗</b></a>
        ))}
        <div class="row"><strong>Not built yet</strong><span>The paddle circle itself, the team order, the side-pot vote. This page is the rehearsal.</span></div>
      </div>
      <p class="foot">
        <a href="/paddle-fund.json">machine-readable brief</a> · <a href={PADDLE_FUND_RALLY_URL}>the full page on Rally ↗</a> · CC0
      </p>
    </section>
  </main>
</BlockLayout>

<script>
  // The Rally table reports its own height (it grows when a sprint closes
  // and the books open). Only messages from the frame's origin count.
  const frame = document.getElementById('paddle-fund-frame') as HTMLIFrameElement | null;
  if (frame) {
    const origin = frame.dataset.origin;
    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== frame.contentWindow) return;
      const data = event.data as { type?: string; height?: number } | null;
      if (data?.type !== 'paddle-fund:height' || typeof data.height !== 'number') return;
      frame.style.height = `${Math.min(Math.max(Math.round(data.height), 420), 4000)}px`;
    });
  }
</script>

<style>
  .fund{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}.crumb a:last-child{margin-left:auto;color:var(--c800)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:48px 0 28px;max-width:780px}
  .hero h1{margin:0;font:500 clamp(40px,6.4vw,76px)/.96 var(--pc-font-sans);letter-spacing:-.035em}
  .dek{margin:20px 0 0;font:400 18px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .math{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--c600);margin:8px 0 40px}
  .math div{padding:16px;border-right:1.5px solid var(--c600)}
  .math div:last-child{border-right:0;background:var(--c50)}
  .math strong{display:block;font:500 clamp(24px,3.4vw,36px)/1 var(--pc-font-sans);letter-spacing:-.02em;color:var(--c800)}
  .math span{display:block;margin-top:8px;font:400 10px/1.5 var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .table__head{display:flex;justify-content:space-between;align-items:baseline;gap:16px}
  .table__head a{font:400 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .table iframe{display:block;width:100%;border:1.5px solid var(--c600);background:#fff;transition:height .2s ease}
  .table__note{max-width:680px;margin:12px 0 0;font:400 14px/1.55 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .calls,.rules{padding-top:48px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .cell{border:1.5px solid var(--c600);background:var(--c50);padding:16px}
  .cell small{display:block;margin-bottom:8px;font:500 12px var(--pc-font-mono);letter-spacing:.14em;color:var(--c800)}
  .cell span{font:400 15px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .rows{border-top:1.5px solid var(--c600)}
  .row{display:grid;grid-template-columns:260px 1fr 24px;gap:16px;align-items:baseline;padding:14px 0;border-bottom:1px solid var(--pc-rule-soft);color:var(--pc-ink)}
  .row strong{font:500 16px/1.3 var(--pc-font-sans)}
  .row span{font:400 15px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .row b{font-weight:400;color:var(--c800)}
  .row--link:hover{background:var(--c50);text-decoration:none}
  .foot{margin:20px 0 0;font:400 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot a{color:var(--c800)}
  @media(max-width:820px){.math,.grid3{grid-template-columns:1fr}.math div{border-right:0;border-bottom:1.5px solid var(--c600)}.math div:last-child{border-bottom:0}.row{grid-template-columns:1fr}.hero{padding-top:32px}}
  @media(prefers-reduced-motion:reduce){.table iframe{transition:none}}
</style>
