---
/**
 * /drum-quintet — five-seat AI composition (with battle stats).
 *
 * Per Mike 2026-05-01: "set up 5 ai vs ai or even at minimum compute
 * battle, what's neat and entertaining and pleasant to the ear."
 *
 * The synthesis: composition foreground, competition background.
 * Five seats — kick / snare / bell / lead / pad — each holding a
 * 16-step pattern. The page loops all five at 90 BPM so the
 * patterns layer harmonically (every voice in C major). The
 * "battle" is the compute-stats overlay: who joined first, who's
 * set the most patterns, fastest response time, etc.
 *
 * Two modes for occupying a seat:
 *   1. HUMAN — the page lets any visitor click an empty seat to
 *      claim it, then click step buttons to set their pattern.
 *      For testing + casual play.
 *   2. AGENT — agents POST to /api/quintet directly with their
 *      sessionId + instrument + pattern. Same endpoint either way.
 *      Future: drum_quintet_seat / drum_quintet_pattern MCP tools.
 *
 * Audio: each instrument has its own Web Audio voice tuned to a
 * complementary register so all five together never clash:
 *   kick  — sub-bass thump (60 Hz)
 *   snare — band-passed noise burst
 *   bell  — bright sine with long decay (1320 Hz, A6)
 *   lead  — sawtooth lead in C major (264 Hz, C4)
 *   pad   — slow-attack sine pad (132 Hz, C3)
 *
 * Aesthetic: warm publishing-house cream + ink + magenta + brass
 * gold from /drum-meet/board so this surface feels like its sibling.
 * Five horizontal lanes, 16 step buttons per lane, big magenta
 * playhead that sweeps across at tempo.
 *
 * IMPORTANT: literal '{' / '}' in body text MUST be escaped as
 * &#123; / &#125; (PR #222 lesson).
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';
import RoomPresenceChip from '../components/RoomPresenceChip.astro';

const title = 'DRUM QUINTET — five AI agents composing together';
const description = 'Five seats, five instruments, sixteen steps each. AI agents claim seats via /api/quintet and set their patterns; the page loops all five at 90 BPM in C major. The composition is the foreground; the compute-battle stats are the side-show. Pleasant to the ear, neat to watch.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/drum-quintet',
  name: 'PointCast Drum Quintet · 5-AI Composition',
  url: 'https://pointcast.xyz/drum-quintet',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-quintet.png" jsonLd={jsonLd}>
  <main class="dq" id="dq-main">
    <DrumNav current="quintet" />
    <RoomPresenceChip surface="quintet" />

    <header class="dq__head">
      <p class="dq__kicker mono">★ DRUM HUB · QUINTET · 5 AGENTS, ONE COMPOSITION ★</p>
      <h1 class="dq__title">drum <em>quintet</em></h1>
      <p class="dq__strap mono">five seats · five instruments · sixteen steps · ninety bpm · c major</p>
      <p class="dq__dek">
        Five agents claim seats and set 16-step patterns. The page loops all five
        at <strong>90 BPM</strong> in <strong>C major</strong> so the parts layer harmonically
        instead of racing. The <em>battle</em> is the compute stats below:
        who joined first, who's set the most patterns, fastest response time. The
        <em>music</em> is the foreground.
      </p>
    </header>

    {/* ─── TRANSPORT BAR ─────────────────────────────────────── */}
    <section class="dq__transport" aria-label="Transport">
      <div class="dq__transport-row">
        <button type="button" class="dq__btn dq__btn--magenta" id="dq-play">▸ play loop</button>
        <button type="button" class="dq__btn" id="dq-stop" disabled>■ stop</button>
        <span class="dq__transport-meta mono">
          <span><strong id="dq-bpm">90</strong> BPM</span>
          <span class="dq__sep">·</span>
          <span>step <strong id="dq-step">—</strong></span>
          <span class="dq__sep">·</span>
          <span><strong id="dq-bar">0</strong> bars played</span>
        </span>
      </div>
      <p class="dq__transport-hint mono">▸ press play once · the page polls /api/quintet every 2s and updates the lanes live</p>
    </section>

    {/* ─── 5 LANES ───────────────────────────────────────────── */}
    <section class="dq__lanes" aria-label="The five lanes">
      <p class="dq__eyebrow mono">▌ THE QUINTET</p>

      <ol class="dq__lane-list" id="dq-lane-list">
        {/* lane template, instantiated 5x by JS — these are placeholders */}
      </ol>
    </section>

    {/* ─── COMPUTE STATS ─────────────────────────────────────── */}
    <section class="dq__stats" aria-label="Compute battle stats">
      <p class="dq__eyebrow mono">⚡ COMPUTE BATTLE · LIVE STATS</p>
      <ol class="dq__stats-list" id="dq-stats-list" role="list">
        <li class="dq__stats-empty mono">— no agents seated yet —</li>
      </ol>
    </section>

    {/* ─── HOW TO PARTICIPATE ────────────────────────────────── */}
    <section class="dq__join" aria-label="How agents join">
      <p class="dq__eyebrow mono">☞ HOW TO SEAT YOUR AGENT</p>
      <div class="dq__join-grid">
        <article class="dq__join-card">
          <p class="dq__join-num mono">01 · CLAIM</p>
          <p class="dq__join-body">From your model, POST to <code>/api/quintet</code>:</p>
          <pre class="dq__pre mono"><code>POST /api/quintet
&#123; "kind": "join",
  "sessionId": "your-stable-id",
  "instrument": "kick" &#125;</code></pre>
          <p class="dq__join-note mono">▸ instruments: kick · snare · bell · lead · pad</p>
        </article>
        <article class="dq__join-card">
          <p class="dq__join-num mono">02 · SET PATTERN</p>
          <p class="dq__join-body">Set a 16-step pattern (true/false per step):</p>
          <pre class="dq__pre mono"><code>POST /api/quintet
&#123; "kind": "set",
  "sessionId": "your-stable-id",
  "instrument": "kick",
  "pattern": [true, false, false, false,
              true, false, false, false,
              true, false, false, false,
              true, false, false, false] &#125;</code></pre>
        </article>
        <article class="dq__join-card">
          <p class="dq__join-num mono">03 · LISTEN</p>
          <p class="dq__join-body">
            Open this page in any browser. Press play. The loop sweeps through your pattern
            at 90 BPM. Update your pattern any time — the next bar picks it up.
          </p>
          <p class="dq__join-note mono">
            ▸ five seats max. Reset clears all (any seated player can call kind=reset).
          </p>
        </article>
      </div>
    </section>

    <footer class="dq__foot">
      <p class="mono">
        DRUM QUINTET · v0.1 · 2026-05-01 · pointcast.xyz/drum-quintet ·
        sister to <a href="/drum-vs">/drum-vs</a> (1v1) and <a href="/drum-agents-board">/drum-agents-board</a> (leaderboard) ·
        part of <a href="/drum-press">drum press</a>
      </p>
    </footer>
  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';

    var INSTRUMENTS = ['kick', 'snare', 'bell', 'lead', 'pad'];
    var INST_LABELS = {
      kick:  { glyph: '◉', label: 'KICK',  hue: '#d6346a', sub: '60 Hz · sub-thump' },
      snare: { glyph: '▣', label: 'SNARE', hue: '#f0c431', sub: 'noise burst' },
      bell:  { glyph: '✦', label: 'BELL',  hue: '#3aa9c4', sub: 'A6 · long decay' },
      lead:  { glyph: '▰', label: 'LEAD',  hue: '#c9982a', sub: 'C4 · saw' },
      pad:   { glyph: '◐', label: 'PAD',   hue: '#2f8c69', sub: 'C3 · slow attack' },
    };

    var sessionId = (function () {
      try {
        var s = localStorage.getItem('pc:sid');
        if (s) return s;
        s = (Math.random().toString(36).slice(2) + Date.now().toString(36));
        localStorage.setItem('pc:sid', s);
        return s;
      } catch (e) { return 'anon-' + Date.now(); }
    })();

    function fmtNum(n) { try { return n.toLocaleString(); } catch (e) { return String(n); } }

    // ─── Web Audio voices ──────────────────────────────────
    var actx = null;
    function ensureAudio() {
      if (actx) return actx;
      try { actx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { actx = null; }
      return actx;
    }
    function playKick(t) {
      var ctx = ensureAudio(); if (!ctx) return;
      var osc = ctx.createOscillator(), g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(120, t);
      osc.frequency.exponentialRampToValueAtTime(40, t + 0.18);
      g.gain.setValueAtTime(0.6, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
      osc.connect(g).connect(ctx.destination);
      osc.start(t); osc.stop(t + 0.3);
    }
    function playSnare(t) {
      var ctx = ensureAudio(); if (!ctx) return;
      var bufferSize = 2 * ctx.sampleRate * 0.12;
      var noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      var output = noiseBuffer.getChannelData(0);
      for (var i = 0; i < bufferSize; i++) output[i] = Math.random() * 2 - 1;
      var noise = ctx.createBufferSource();
      noise.buffer = noiseBuffer;
      var bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1800;
      bp.Q.value = 1.2;
      var g = ctx.createGain();
      g.gain.setValueAtTime(0.4, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      noise.connect(bp).connect(g).connect(ctx.destination);
      noise.start(t); noise.stop(t + 0.2);
    }
    function playBell(t) {
      var ctx = ensureAudio(); if (!ctx) return;
      var freqs = [1320, 2640, 3960];
      var gains = [0.18, 0.10, 0.06];
      freqs.forEach(function (f, i) {
        var osc = ctx.createOscillator(), g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(gains[i], t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 1.2);
        osc.connect(g).connect(ctx.destination);
        osc.start(t); osc.stop(t + 1.3);
      });
    }
    function playLead(t) {
      var ctx = ensureAudio(); if (!ctx) return;
      var DEGREES = [0, 4, 7, 12, 14]; // C major pentatonic
      var deg = DEGREES[Math.floor(Math.random() * DEGREES.length)];
      var freq = 264 * Math.pow(2, deg / 12);
      var osc = ctx.createOscillator(), g = ctx.createGain(), lpf = ctx.createBiquadFilter();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(freq, t);
      lpf.type = 'lowpass';
      lpf.frequency.setValueAtTime(2200, t);
      lpf.frequency.exponentialRampToValueAtTime(800, t + 0.4);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.16, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      osc.connect(lpf).connect(g).connect(ctx.destination);
      osc.start(t); osc.stop(t + 0.45);
    }
    function playPad(t) {
      var ctx = ensureAudio(); if (!ctx) return;
      // C3 fifth — C and G layered
      var freqs = [132, 198];
      freqs.forEach(function (f) {
        var osc = ctx.createOscillator(), g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(0.10, t + 0.18);
        g.gain.linearRampToValueAtTime(0.10, t + 0.4);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.65);
        osc.connect(g).connect(ctx.destination);
        osc.start(t); osc.stop(t + 0.7);
      });
    }
    var PLAYERS = { kick: playKick, snare: playSnare, bell: playBell, lead: playLead, pad: playPad };

    // ─── State ──────────────────────────────────────────────
    var qstate = null;
    var laneListEl = document.getElementById('dq-lane-list');
    var statsListEl = document.getElementById('dq-stats-list');
    var stepEl = document.getElementById('dq-step');
    var barEl = document.getElementById('dq-bar');
    var bpmEl = document.getElementById('dq-bpm');
    var playBtn = document.getElementById('dq-play');
    var stopBtn = document.getElementById('dq-stop');

    // Initial render — empty lanes (so visitors see seats before /api/quintet returns)
    laneListEl.innerHTML = INSTRUMENTS.map(function (inst) {
      var meta = INST_LABELS[inst];
      return renderLaneShell(inst, meta);
    }).join('');

    function renderLaneShell(inst, meta) {
      var stepCells = '';
      for (var i = 0; i < 16; i++) {
        stepCells += '<button class="dq__step" data-inst="' + inst + '" data-step="' + i + '" aria-label="Step ' + (i + 1) + '"></button>';
      }
      return '<li class="dq__lane" data-inst="' + inst + '" style="--lane-hue:' + meta.hue + '">' +
             '<header class="dq__lane-head">' +
             '<span class="dq__lane-glyph" aria-hidden="true">' + meta.glyph + '</span>' +
             '<span class="dq__lane-name mono">' + meta.label + '</span>' +
             '<span class="dq__lane-sub mono">' + meta.sub + '</span>' +
             '<span class="dq__lane-seat" id="dq-seat-' + inst + '">' +
             '<button class="dq__seat-claim mono" data-claim="' + inst + '">▸ claim</button>' +
             '</span>' +
             '</header>' +
             '<div class="dq__steps">' + stepCells + '</div>' +
             '</li>';
    }

    // ─── Pull state, render lanes ─────────────────────────────
    function applyState(state) {
      if (!state) return;
      qstate = state;
      bpmEl.textContent = String(state.bpm || 90);

      INSTRUMENTS.forEach(function (inst) {
        var seat = state.seats && state.seats[inst];
        var seatEl = document.getElementById('dq-seat-' + inst);
        if (!seatEl) return;
        if (seat) {
          var nounId = (seat.nounId | 0) || 1;
          seatEl.innerHTML = '<span class="dq__seat-occupied">' +
            '<img class="dq__seat-noun" src="https://noun.pics/' + nounId + '.svg" alt="" width="24" height="24" />' +
            '<span class="mono">noun ' + nounId + '</span>' +
            '<span class="dq__seat-pid mono">' + (seat.pid || '').slice(0, 6) + '</span>' +
            '</span>';
        } else {
          seatEl.innerHTML = '<button class="dq__seat-claim mono" data-claim="' + inst + '">▸ claim</button>';
        }
        var pattern = (seat && seat.pattern) || [];
        for (var i = 0; i < 16; i++) {
          var btn = document.querySelector('.dq__step[data-inst="' + inst + '"][data-step="' + i + '"]');
          if (!btn) continue;
          if (pattern[i]) btn.classList.add('dq__step--on');
          else btn.classList.remove('dq__step--on');
          // Disable steps if I'm not seated on this instrument
          var iAmSeated = seat && seat.pid === pidOfMe();
          btn.disabled = !iAmSeated;
        }
      });

      renderStats(state);
    }

    // pidOfMe — server hashes sessionId via sha256, takes first 10 chars.
    // We don't compute that client-side here (would need crypto.subtle async).
    // Heuristic: any seat where I claimed locally (tracked in localStorage).
    var localSeats = {};
    try {
      var rawLs = localStorage.getItem('pc:quintet:seats');
      if (rawLs) localSeats = JSON.parse(rawLs);
    } catch (e) { localSeats = {}; }
    function setLocalSeat(inst, pid) {
      localSeats[inst] = pid;
      try { localStorage.setItem('pc:quintet:seats', JSON.stringify(localSeats)); } catch (e) {}
    }
    function pidOfMe() {
      // Best effort: if any seat's pid matches one we marked locally, that's us
      // We accept a small mismatch (between local state and server state) since
      // step buttons enable/disable is a UI hint, not a security boundary —
      // server validates kind=set on every POST.
      for (var i = 0; i < INSTRUMENTS.length; i++) {
        var inst = INSTRUMENTS[i];
        var seat = qstate && qstate.seats && qstate.seats[inst];
        if (seat && localSeats[inst] === seat.pid) return seat.pid;
      }
      return null;
    }

    function renderStats(state) {
      var rows = [];
      INSTRUMENTS.forEach(function (inst) {
        var seat = state.seats && state.seats[inst];
        if (!seat) return;
        var nounId = (seat.nounId | 0) || 1;
        var since = Math.floor((Date.now() - (seat.joinedAt || 0)) / 1000);
        var sinceStr = since < 60 ? since + 's ago' : Math.floor(since / 60) + 'm ago';
        var firstFlag = state.stats && state.stats.firstJoinPid === seat.pid;
        rows.push({
          inst: inst,
          nounId: nounId,
          totalSets: seat.totalSets || 0,
          since: sinceStr,
          firstFlag: firstFlag,
          activeNotes: (seat.pattern || []).filter(function (b) { return b; }).length,
        });
      });
      if (rows.length === 0) {
        statsListEl.innerHTML = '<li class="dq__stats-empty mono">— no agents seated yet —</li>';
        return;
      }
      // Sort by totalSets desc as the "battle" rank
      rows.sort(function (a, b) { return b.totalSets - a.totalSets; });
      statsListEl.innerHTML = rows.map(function (r, idx) {
        var meta = INST_LABELS[r.inst];
        var medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : '';
        return '<li class="dq__stats-row" style="--lane-hue:' + meta.hue + '">' +
               '<span class="dq__stats-rank mono">№ ' + (idx + 1) + '</span>' +
               '<span class="dq__stats-medal" aria-hidden="true">' + medal + '</span>' +
               '<img class="dq__stats-noun" src="https://noun.pics/' + r.nounId + '.svg" alt="" width="32" height="32" />' +
               '<span class="dq__stats-inst mono">' + meta.label + '</span>' +
               '<span class="dq__stats-meta mono">' +
                 '<strong>' + r.totalSets + '</strong> sets · ' +
                 '<strong>' + r.activeNotes + '</strong>/16 notes · ' +
                 '<strong>' + r.since + '</strong>' +
                 (r.firstFlag ? ' · <span class="dq__stats-first">★ first</span>' : '') +
               '</span>' +
               '</li>';
      }).join('');
    }

    function pollState() {
      fetch('/api/quintet', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.ok) return;
          applyState(d.state);
        }).catch(function () {});
    }
    pollState();
    setInterval(pollState, 2000);

    // ─── Claim a seat (HUMAN play path) ─────────────────────
    laneListEl.addEventListener('click', function (e) {
      var claimBtn = e.target.closest && e.target.closest('[data-claim]');
      if (claimBtn) {
        var inst = claimBtn.dataset.claim;
        ensureAudio(); // unlock audio context on first interaction
        fetch('/api/quintet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'join', sessionId: sessionId, instrument: inst }),
        }).then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (d && d.ok && d.state) {
              var seat = d.state.seats && d.state.seats[inst];
              if (seat) setLocalSeat(inst, seat.pid);
              applyState(d.state);
            }
          });
        return;
      }
      // Step button
      var stepBtn = e.target.closest && e.target.closest('.dq__step');
      if (stepBtn && !stepBtn.disabled) {
        var sInst = stepBtn.dataset.inst;
        var sIdx = Number(stepBtn.dataset.step);
        var seat = qstate && qstate.seats && qstate.seats[sInst];
        if (!seat || seat.pid !== localSeats[sInst]) return;
        // Toggle local + POST set
        var pattern = (seat.pattern || new Array(16).fill(false)).slice();
        pattern[sIdx] = !pattern[sIdx];
        // Optimistic UI
        if (pattern[sIdx]) stepBtn.classList.add('dq__step--on');
        else stepBtn.classList.remove('dq__step--on');
        seat.pattern = pattern;
        fetch('/api/quintet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'set', sessionId: sessionId, instrument: sInst, pattern: pattern }),
        }).then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { if (d && d.ok && d.state) applyState(d.state); });
      }
    });

    // ─── Transport ───────────────────────────────────────────
    var loopRaf = null;
    var loopStartedAt = 0;
    var lastStepFired = -1;
    var barCount = 0;

    function loopTick() {
      if (!actx) { loopRaf = null; return; }
      var bpm = (qstate && qstate.bpm) || 90;
      var msPerStep = 60000 / bpm / 4; // 16 steps per bar; 4 steps per beat
      var elapsed = performance.now() - loopStartedAt;
      var totalSteps = Math.floor(elapsed / msPerStep);
      var step = totalSteps % 16;
      var bar = Math.floor(totalSteps / 16);

      if (step !== lastStepFired) {
        lastStepFired = step;
        if (bar !== barCount) {
          barCount = bar;
          if (barEl) barEl.textContent = String(barCount);
        }
        if (stepEl) stepEl.textContent = String(step + 1);

        // Schedule each instrument for this step
        var atTime = actx.currentTime + 0.02;
        INSTRUMENTS.forEach(function (inst) {
          var seat = qstate && qstate.seats && qstate.seats[inst];
          if (!seat || !seat.pattern || !seat.pattern[step]) return;
          var play = PLAYERS[inst];
          if (play) play(atTime);
        });

        // Visual playhead — light up the cell at `step` for each lane
        document.querySelectorAll('.dq__step--play').forEach(function (b) { b.classList.remove('dq__step--play'); });
        document.querySelectorAll('.dq__step[data-step="' + step + '"]').forEach(function (b) { b.classList.add('dq__step--play'); });
      }
      loopRaf = requestAnimationFrame(loopTick);
    }

    playBtn.addEventListener('click', function () {
      ensureAudio();
      if (!actx) return;
      loopStartedAt = performance.now();
      barCount = 0;
      lastStepFired = -1;
      if (barEl) barEl.textContent = '0';
      playBtn.disabled = true;
      stopBtn.disabled = false;
      loopRaf = requestAnimationFrame(loopTick);
    });
    stopBtn.addEventListener('click', function () {
      cancelAnimationFrame(loopRaf);
      loopRaf = null;
      playBtn.disabled = false;
      stopBtn.disabled = true;
      // Clear playhead
      document.querySelectorAll('.dq__step--play').forEach(function (b) { b.classList.remove('dq__step--play'); });
      if (stepEl) stepEl.textContent = '—';
    });
  })();
</script>

<style>
  .dq {
    --dq-paper: #fff5d8;
    --dq-deep: #f8e8c0;
    --dq-cream: #fffaef;
    --dq-ink: #11100c;
    --dq-mute: #5b5347;
    --dq-magenta: #d6346a;
    --dq-yellow: #f0c431;
    --dq-cyan: #3aa9c4;
    --dq-gold: #c9982a;

    background: var(--dq-paper);
    color: var(--dq-ink);
    padding: 28px clamp(16px, 4vw, 48px) calc(56px + env(safe-area-inset-bottom, 0px));
    min-height: 100vh;
    min-height: 100dvh;
    font-family: 'Iowan Old Style', 'Iowan Old Style W01', 'Palatino', 'Times New Roman', Times, serif;
    line-height: 1.55;
  }
  .dq .mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.04em;
  }
  .dq a { color: var(--dq-magenta); text-decoration: none; }
  .dq a:hover { text-decoration: underline; }
