---
/**
 * /noun-loom — collective slow garden of Nouns + drones.
 *
 * Mike 2026-05-08: "fresh batch of ideas" → "yep go." 2 of 3.
 *
 * 16×6 grid (96 cells). Each cell has an x/y position that determines
 * its drone pitch (column = pentatonic scale degree; row = octave).
 * Each cell can hold a Noun. Visitor clicks an empty cell to plant —
 * a random Noun lands there + their drone joins the layered chord.
 *
 * Deterministic seed: today's date hashes to a base set of ~12-18
 * Nouns prefilled across the loom. Everyone visiting today sees the
 * same starting garden. Tomorrow it's different. Visitor's own plants
 * persist via localStorage.
 *
 * Sound: when playing, the layered drone of every planted cell
 * sustains. Adding a plant fades in its tone over 1.6s. The collective
 * sound evolves as more Nouns appear.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Noun Loom · plant a Noun, hear a drone · PointCast';
const description = 'Plant a Noun in a 16×6 grid. Each Noun is a sustained drone. Garden evolves over time; every day reseeds.';

const COLS = 16;
const ROWS = 6;
---

<BlockLayout title={title} description={description}>
  <main class="nlm">
    <header class="nlm__header">
      <h1 class="nlm__title">NOUN LOOM</h1>
      <p class="nlm__tag">plant a noun · each one is a drone · the loom sounds like everyone together</p>
    </header>

    <section class="nlm__panel">
      <button class="nlm__btn nlm__btn--big" id="nlm-toggle" type="button">▶ TUNE THE LOOM</button>
      <button class="nlm__btn" id="nlm-clear" type="button">✕ CLEAR MY PLANTS</button>
      <span class="nlm__count" id="nlm-count">— planted</span>
      <span class="nlm__date" id="nlm-date">today's seed: —</span>
    </section>

    <section class="nlm__loom" id="nlm-loom" data-state="idle"
             style={`--cols: ${COLS}; --rows: ${ROWS};`}>
      {Array.from({length: COLS * ROWS}).map((_, i) => {
        const col = i % COLS;
        const row = Math.floor(i / COLS);
        return (
          <button class="nlm__cell" data-i={i} data-col={col} data-row={row} type="button" aria-label={`Plant at column ${col + 1} row ${row + 1}`}></button>
        );
      })}
    </section>

    <section class="nlm__legend">
      <p class="nlm__legend-line"><strong>Pitch:</strong> column = note (pentatonic), row = octave (deeper at the bottom).</p>
      <p class="nlm__legend-line"><strong>Today's garden:</strong> deterministic from the date — every visitor today hears the same starting chord. Tomorrow it reseeds.</p>
      <p class="nlm__legend-line"><strong>Your plants:</strong> persist in your browser. CLEAR MY PLANTS removes them; the seeded ones stay.</p>
    </section>

    <section class="nlm__siblings">
      <a href="/noun-cinema">/noun-cinema</a>
      <a href="/drum-map">/drum-map</a>
      <a href="/drum-parade">/drum-parade</a>
      <a href="/drum-quintet">/drum-quintet</a>
    </section>
  </main>
</BlockLayout>

<style>
  .nlm { max-width: 1200px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #1a0820; background: linear-gradient(180deg, #f4e7c8 0%, #fffaf0 100%); min-height: 100vh; }
  .nlm__header { text-align: center; margin: 18px 0 18px; }
  .nlm__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 72px); letter-spacing: 0.16em; margin: 0; text-shadow: 2px 2px 0 rgba(125, 154, 124, 0.40); }
  .nlm__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #5a3422; opacity: 0.85; margin: 6px 0 0; }

  .nlm__panel { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; padding: 14px; border: 2px solid #1a0820; background: #fffaf0; box-shadow: 4px 4px 0 0 #1a0820; margin: 14px 0; }
  .nlm__btn { padding: 10px 18px; border: 2px solid #1a0820; background: #fffaf0; color: #1a0820; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; transition: transform 100ms, box-shadow 100ms; box-shadow: 3px 3px 0 0 #1a0820; }
  .nlm__btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 0 #1a0820; }
  .nlm__btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }
  .nlm__btn--big { background: #7d9a7c; color: #fffaf0; }
  .nlm__count, .nlm__date { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.14em; color: #5a3422; }
  .nlm__date { margin-left: auto; }

  .nlm__loom { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 4px; padding: 10px; border: 2px solid #1a0820; background: #fffaf0; box-shadow: 4px 4px 0 0 #1a0820; }
  .nlm__cell { aspect-ratio: 1; padding: 0; border: 1px solid rgba(26, 8, 32, 0.22); background: rgba(125, 154, 124, 0.08); cursor: pointer; transition: background 80ms, transform 80ms, border-color 80ms; position: relative; overflow: hidden; }
  .nlm__cell:hover { background: rgba(212, 164, 55, 0.20); border-color: #1a0820; }
  .nlm__cell.nlm__cell--planted { background: #fffaf0; border: 2px solid #1a0820; cursor: default; }
  .nlm__cell.nlm__cell--mine { border-color: #d4a437; box-shadow: inset 0 0 0 2px #d4a437; }
  .nlm__cell.nlm__cell--ringing { animation: nlm-ring 1.6s ease-out 1; }
  @keyframes nlm-ring { 0% { box-shadow: 0 0 0 0 #d4a437; } 50% { box-shadow: 0 0 0 6px rgba(212, 164, 55, 0.40); } 100% { box-shadow: 0 0 0 0 transparent; } }
  .nlm__cell img { width: 100%; height: 100%; image-rendering: pixelated; display: block; pointer-events: none; }

  .nlm__legend { padding: 14px; border: 2px dashed rgba(26, 8, 32, 0.40); background: #f4e7c8; margin: 14px 0; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; line-height: 1.6; color: #5a3422; }
  .nlm__legend-line { margin: 0; padding: 2px 0; }
  .nlm__legend-line strong { color: #1a0820; }

  .nlm__siblings { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .nlm__siblings a { color: #5a3422; text-decoration: none; }
  .nlm__siblings a:hover { color: #1a0820; text-decoration: underline; }

  @media (max-width: 720px) { .nlm__loom { gap: 2px; padding: 6px; } }
</style>

<script>
  const COLS = 16, ROWS = 6;
  // Pentatonic in C: C D E G A. Spread across columns. Octave by row (bottom = lowest).
  const PENTATONIC = [0, 2, 4, 7, 9]; // C D E G A
  // Pitch for cell: octave from row + scale degree from col modulo 5.
  function freqFor(col: number, row: number): number {
    const baseOctaveHz = 130.81; // C3
    const deg = PENTATONIC[col % PENTATONIC.length];
    const octShift = (ROWS - 1 - row); // bottom row = octave 0; top = highest
    const semitones = octShift * 12 + deg;
    return baseOctaveHz * Math.pow(2, semitones / 12);
  }

  let actx: AudioContext | null = null;
  function ctx() { if (!actx) { const AC = (window as any).AudioContext || (window as any).webkitAudioContext; actx = new AC(); } if (actx && actx.state === 'suspended') actx.resume(); return actx!; }

  // Each cell with a Noun gets a sustained sine; gain controlled by a master gain.
  // Map cell-index → { osc, gain }
  const voices = new Map<number, { osc: OscillatorNode; gain: GainNode }>();
  let masterGain: GainNode | null = null;

  function ensureMaster() {
    if (!masterGain) {
      const a = ctx();
      masterGain = a.createGain();
      masterGain.gain.value = 0; // start silent
      masterGain.connect(a.destination);
    }
    return masterGain!;
  }

  function startVoice(i: number, col: number, row: number) {
    if (voices.has(i)) return;
    const a = ctx();
    const m = ensureMaster();
    const osc = a.createOscillator();
    const g = a.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freqFor(col, row), a.currentTime);
    // Per-voice gain, ramp up gently.
    g.gain.setValueAtTime(0, a.currentTime);
    g.gain.linearRampToValueAtTime(0.04, a.currentTime + 1.6);
    osc.connect(g).connect(m);
    osc.start();
    voices.set(i, { osc, gain: g });
  }
  function stopVoice(i: number) {
    const v = voices.get(i);
    if (!v) return;
    const a = ctx();
    v.gain.gain.cancelScheduledValues(a.currentTime);
    v.gain.gain.setValueAtTime(v.gain.gain.value, a.currentTime);
    v.gain.gain.linearRampToValueAtTime(0, a.currentTime + 0.6);
    setTimeout(() => { try { v.osc.stop(); } catch {} }, 700);
    voices.delete(i);
  }

  // Deterministic seed for today: hash YYYY-MM-DD → 12-18 cells.
  function todaysSeed(): { plants: Record<number, number>; dateStr: string } {
    const today = new Date();
    const dateStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
    let h = 0;
    for (let i = 0; i < dateStr.length; i++) h = ((h << 5) - h + dateStr.charCodeAt(i)) | 0;
    // PRNG seeded by h
    let s = Math.abs(h) || 1;
    function rand() { s = (s * 1664525 + 1013904223) >>> 0; return s / 0x100000000; }
    const count = 12 + Math.floor(rand() * 7); // 12-18
    const plants: Record<number, number> = {};
    let placed = 0; let tries = 0;
    while (placed < count && tries < 400) {
      const col = Math.floor(rand() * COLS);
      const row = Math.floor(rand() * ROWS);
      const idx = row * COLS + col;
      if (!plants[idx]) {
        plants[idx] = Math.floor(rand() * 1200);
        placed++;
      }
      tries++;
    }
    return { plants, dateStr };
  }

  // Load my plants from localStorage.
  function loadMyPlants(): Record<number, number> {
    try { return JSON.parse(localStorage.getItem('noun-loom-mine') || '{}'); } catch { return {}; }
  }
  function saveMyPlants(p: Record<number, number>) {
    try { localStorage.setItem('noun-loom-mine', JSON.stringify(p)); } catch {}
  }
  function clearMyPlants() {
    try { localStorage.removeItem('noun-loom-mine'); } catch {}
  }

  const seed = todaysSeed();
  let mine = loadMyPlants();

  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('.nlm__cell'));
  const dateEl = document.getElementById('nlm-date');
  const countEl = document.getElementById('nlm-count');
  const toggleBtn = document.getElementById('nlm-toggle') as HTMLButtonElement;
  const clearBtn = document.getElementById('nlm-clear');
  const loomEl = document.getElementById('nlm-loom') as HTMLElement;

  let playing = false;

  function plantCell(idx: number, nounId: number, isMine: boolean) {
    const cell = cells[idx];
    if (!cell || cell.classList.contains('nlm__cell--planted')) return;
    const img = document.createElement('img');
    img.src = `https://noun.pics/${nounId}.svg`;
    img.alt = `Noun ${nounId}`;
    img.loading = 'lazy';
    cell.appendChild(img);
    cell.classList.add('nlm__cell--planted');
    if (isMine) cell.classList.add('nlm__cell--mine');
    const col = Number(cell.dataset.col);
    const row = Number(cell.dataset.row);
    if (playing) startVoice(idx, col, row);
  }

  function unplantCell(idx: number) {
    const cell = cells[idx];
    if (!cell) return;
    cell.classList.remove('nlm__cell--planted', 'nlm__cell--mine');
    cell.innerHTML = '';
    stopVoice(idx);
  }

  function paintAll() {
    cells.forEach((c, i) => unplantCell(i));
    Object.entries(seed.plants).forEach(([k, v]) => plantCell(Number(k), v, false));
    Object.entries(mine).forEach(([k, v]) => plantCell(Number(k), v, true));
    if (countEl) countEl.textContent = `${Object.keys(seed.plants).length + Object.keys(mine).length} planted`;
  }

  function rampMaster(target: number) {
    const m = ensureMaster();
    const a = ctx();
    m.gain.cancelScheduledValues(a.currentTime);
    m.gain.setValueAtTime(m.gain.value, a.currentTime);
    m.gain.linearRampToValueAtTime(target, a.currentTime + 1.0);
  }

  function start() {
    if (playing) return;
    ctx();
    playing = true;
    rampMaster(0.7);
    // Boot all voices.
    cells.forEach((c, i) => {
      if (c.classList.contains('nlm__cell--planted')) {
        startVoice(i, Number(c.dataset.col), Number(c.dataset.row));
      }
    });
    toggleBtn.textContent = '■ HUSH THE LOOM';
    if (loomEl) loomEl.dataset.state = 'playing';
  }
  function stop() {
    if (!playing) return;
    playing = false;
    rampMaster(0);
    setTimeout(() => { voices.forEach((_, i) => stopVoice(i)); }, 1200);
    toggleBtn.textContent = '▶ TUNE THE LOOM';
    if (loomEl) loomEl.dataset.state = 'idle';
  }

  cells.forEach((c, i) => c.addEventListener('click', () => {
    if (c.classList.contains('nlm__cell--planted')) return;
    // Pick a Noun for this plant: deterministic from index + day
    const noun = (seed.plants[i] || 0) + Math.floor(Math.random() * 1200);
    const id = noun % 1200;
    mine[i] = id;
    saveMyPlants(mine);
    plantCell(i, id, true);
    c.classList.add('nlm__cell--ringing');
    setTimeout(() => c.classList.remove('nlm__cell--ringing'), 1700);
    if (countEl) countEl.textContent = `${Object.keys(seed.plants).length + Object.keys(mine).length} planted`;
  }));

  toggleBtn.addEventListener('click', () => { playing ? stop() : start(); });
  clearBtn?.addEventListener('click', () => {
    Object.keys(mine).forEach(k => unplantCell(Number(k)));
    mine = {};
    clearMyPlants();
    if (countEl) countEl.textContent = `${Object.keys(seed.plants).length} planted`;
  });

  if (dateEl) dateEl.textContent = `today's seed: ${seed.dateStr}`;
  paintAll();
</script>
