---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ACOUSTIC_DESIGN, BATH_MASTER_ROLE, FUNDING_CALENDAR, FUNDING_TIMELINE, HUNDRED_FOUNDING_BATHERS, MECHANICAL_SYSTEMS, PAPER_META, PAPER_NOTES, PARKS_DEPT_MOU, PHILOSOPHICAL_NOTES, PROGRAM, REFERENCES, STRUCTURE_AND_MATERIAL } from '../lib/bathHousePaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/bath-house', name: PAPER_META.title, description, url: 'https://pointcast.xyz/bath-house', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/bath-house.json', title: 'The Bath House (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/giant-works">giant-works</a><span aria-hidden="true">/</span><span>bath-house</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · TIER D · WATER · $13M TOTAL · 2028 Q3 OPEN</p>
      <h1>THE / BATH / HOUSE.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="program"><p class="kicker">PROGRAM · {PROGRAM.totalArea}</p><h2>What gets built.</h2>
      <dl class="meta-dl">
        <div><dt>Total area</dt><dd>{PROGRAM.totalArea}</dd></div>
        <div><dt>Occupancy max</dt><dd>{PROGRAM.occupancyMax}</dd></div>
        <div><dt>Operating hours</dt><dd>{PROGRAM.operatingHours}</dd></div>
        <div><dt>Programmed area</dt><dd>{PROGRAM.totalProgrammedArea}</dd></div>
      </dl>
      <h3 class="sh">Spaces · {PROGRAM.spaces.length}</h3>
      <ol class="sp-list">{PROGRAM.spaces.map((s) => (
        <li>
          <h4>{s.name} <span class="sp__meta">{s.area} · {s.temp} · {s.capacity}</span></h4>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="struct"><p class="kicker">STRUCTURE + MATERIAL</p><h2>How it is built to last 100 years.</h2>
      <dl class="dl">
        <div><dt>Primary structure</dt><dd>{STRUCTURE_AND_MATERIAL.primaryStructure}</dd></div>
        <div><dt>Primary stone</dt><dd>{STRUCTURE_AND_MATERIAL.primaryStone}</dd></div>
        <div><dt>Secondary stone</dt><dd>{STRUCTURE_AND_MATERIAL.secondaryStone}</dd></div>
        <div><dt>Woods</dt><dd>{STRUCTURE_AND_MATERIAL.woods}</dd></div>
        <div><dt>Metals</dt><dd>{STRUCTURE_AND_MATERIAL.metals}</dd></div>
        <div><dt>Glazing</dt><dd>{STRUCTURE_AND_MATERIAL.glazing}</dd></div>
        <div><dt>Acoustic treatment</dt><dd>{STRUCTURE_AND_MATERIAL.acousticTreatment}</dd></div>
      </dl>
    </section>

    <section class="mech"><p class="kicker">MECHANICAL SYSTEMS</p><h2>How it runs.</h2>
      <dl class="dl">
        <div><dt>Heating</dt><dd>{MECHANICAL_SYSTEMS.heating}</dd></div>
        <div><dt>Filtration</dt><dd>{MECHANICAL_SYSTEMS.filtration}</dd></div>
        <div><dt>Water makeup</dt><dd>{MECHANICAL_SYSTEMS.waterMakeup}</dd></div>
        <div><dt>Ventilation</dt><dd>{MECHANICAL_SYSTEMS.ventilation}</dd></div>
        <div><dt>Electrical</dt><dd>{MECHANICAL_SYSTEMS.electrical}</dd></div>
        <div><dt>Plumbing</dt><dd>{MECHANICAL_SYSTEMS.plumbing}</dd></div>
      </dl>
    </section>

    <section class="acoustic"><p class="kicker">ACOUSTIC DESIGN</p><h2>How it sounds.</h2>
      <p class="block"><strong>Philosophy:</strong> {ACOUSTIC_DESIGN.philosophy}</p>
      <p class="block"><strong>Treatment:</strong> {ACOUSTIC_DESIGN.treatment}</p>
      <p class="block"><strong>Isolation:</strong> {ACOUSTIC_DESIGN.isolation}</p>
    </section>

    <section class="fund"><p class="kicker">FUNDING CALENDAR · {FUNDING_CALENDAR.total}</p><h2>How it is paid for.</h2>
      <ol class="src-list">{FUNDING_CALENDAR.sourceMix.map((s) => (
        <li>
          <h4>{s.source} <span class="src__amt">{s.amount}</span></h4>
          <p class="src__when"><strong>Timing:</strong> {s.timing}</p>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
      <h3 class="sh">Stretch targets</h3>
      <ol class="src-list src-list--stretch">{FUNDING_CALENDAR.stretchTargets.map((s) => (
        <li>
          <h4>{s.item} <span class="src__amt">{s.amount}</span></h4>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="tl"><p class="kicker">TIMELINE · 2026 Q3 → 2028 Q4</p><h2>The path to opening.</h2>
      <ol class="tl-list">{FUNDING_TIMELINE.map((t) => (
        <li>
          <span class="tl__q">{t.quarter}</span>
          <p>{t.milestone}</p>
        </li>
      ))}</ol>
    </section>

    <section class="mou"><p class="kicker">PARKS-DEPARTMENT MOU · 99-YEAR GROUND LEASE TEMPLATE</p><h2>How the federation and the host city share the land.</h2>
      <p class="block"><strong>Tenor:</strong> {PARKS_DEPT_MOU.tenor}</p>
      <h3 class="sh">Key terms · {PARKS_DEPT_MOU.keyTerms.length}</h3>
      <ol class="terms-list">{PARKS_DEPT_MOU.keyTerms.map((t) => (<li>{t}</li>))}</ol>
    </section>

    <section class="role"><p class="kicker">BATH MASTER · ROLE SPEC</p><h2>Who runs the building day-to-day.</h2>
      <dl class="dl">
        <div><dt>Type</dt><dd>{BATH_MASTER_ROLE.type}</dd></div>
        <div><dt>Reports to</dt><dd>{BATH_MASTER_ROLE.reportsTo}</dd></div>
        <div><dt>Compensation</dt><dd>Base: {BATH_MASTER_ROLE.compensation.base}. Sabbatical: {BATH_MASTER_ROLE.compensation.sabbatical}. Pension: {BATH_MASTER_ROLE.compensation.pension}.</dd></div>
        <div><dt>Termination</dt><dd>{BATH_MASTER_ROLE.termination}</dd></div>
      </dl>
      <h3 class="sh">Primary duties · {BATH_MASTER_ROLE.primaryDuties.length}</h3>
      <ul class="dt-list">{BATH_MASTER_ROLE.primaryDuties.map((d) => (<li>{d}</li>))}</ul>
      <h3 class="sh">Qualifications · {BATH_MASTER_ROLE.qualifications.length}</h3>
      <ul class="dt-list">{BATH_MASTER_ROLE.qualifications.map((q) => (<li>{q}</li>))}</ul>
    </section>

    <section class="founders"><p class="kicker">100 FOUNDING BATHERS · CAMPAIGN</p><h2>The structural-financial community.</h2>
      <p class="block"><strong>Thesis:</strong> {HUNDRED_FOUNDING_BATHERS.thesis}</p>
      <p class="block"><strong>Who they are:</strong> {HUNDRED_FOUNDING_BATHERS.whoTheyAre}</p>
      <p class="block"><strong>Campaign:</strong> {HUNDRED_FOUNDING_BATHERS.campaign}</p>
      <h3 class="sh">Rights · {HUNDRED_FOUNDING_BATHERS.rights.length}</h3>
      <ul class="dt-list">{HUNDRED_FOUNDING_BATHERS.rights.map((r) => (<li>{r}</li>))}</ul>
      <h3 class="sh">Obligations · {HUNDRED_FOUNDING_BATHERS.obligations.length}</h3>
      <ul class="dt-list">{HUNDRED_FOUNDING_BATHERS.obligations.map((o) => (<li>{o}</li>))}</ul>
    </section>

    <section class="phil"><p class="kicker">PHILOSOPHICAL NOTES</p><h2>Why this, why now, why here.</h2>
      <p class="block"><strong>Why a bath house:</strong> {PHILOSOPHICAL_NOTES.whyABathHouse}</p>
      <p class="block"><strong>Why concrete:</strong> {PHILOSOPHICAL_NOTES.whyConcrete}</p>
      <p class="block"><strong>Why the corridor midpoint:</strong> {PHILOSOPHICAL_NOTES.whyAtTheCorridorMidpoint}</p>
      <p class="block"><strong>Why not private:</strong> {PHILOSOPHICAL_NOTES.whyNotPrivate}</p>
      <p class="block"><strong>Why not just a pool:</strong> {PHILOSOPHICAL_NOTES.whyNotJustAPool}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · ARCHITECTS · FUNDERS · BATH MASTER · FOUNDING BATHERS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/giant-works">Giant Works · element Tier D</a>
      <a href="/giant-works-art">Giant Works · Art</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/la28-ready">LA28 Forcing Function</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/hermosa-beach">Hermosa Beach (host site)</a>
      <a href="/bath-house.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --bh-ink:#1a1a1a; --bh-paper:#fdf9ee; --bh-mustard:#d4a534; --bh-rust:#b85a3a; --bh-sage:#2d6a3d; --bh-water:#3d6a8a; --bh-fog:#d8d2c4; --bh-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--bh-paper); color: var(--bh-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--bh-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--bh-water); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--bh-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--bh-water); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--bh-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--bh-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--bh-water); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--bh-water); }
  h4 { font-family: var(--pc-font-mono); font-size: 13.5px; margin: 0 0 6px; font-weight: 700; }

  .meta-dl, .dl { margin: 0 0 12px; display: grid; gap: 6px; }
  .meta-dl > div, .dl > div { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--bh-ink); border-left: 5px solid var(--bh-water); }
  .meta-dl dt, .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--bh-water); padding-top: 2px; }
  .meta-dl dd, .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--bh-water); max-width: 72ch; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--bh-water); margin-right: 6px; }

  .sp-list, .src-list, .tl-list, .terms-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .sp-list li, .src-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--bh-ink); border-left: 6px solid var(--bh-water); }
  .sp__meta, .src__amt { font-family: var(--pc-font-mono); font-size: 10.5px; letter-spacing: .1em; color: var(--bh-rust); margin-left: 8px; font-weight: 500; }
  .sp-list p, .src-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .src__when { padding: 6px 10px; background: var(--bh-paper); border-left: 3px solid var(--bh-mustard); margin: 6px 0 !important; font-size: 12.5px !important; }
  .src__when strong, .src-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--bh-water); margin-right: 4px; }
  .src-list--stretch li { border-left-color: var(--bh-fog); }

  .tl-list li { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--bh-ink); border-left: 5px solid var(--bh-water); align-items: baseline; }
  .tl__q { font-family: var(--pc-font-mono); font-size: 11.5px; font-weight: 700; color: var(--bh-water); letter-spacing: .1em; }
  .tl-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .terms-list { list-style: decimal; padding-left: 22px; }
  .terms-list li { padding: 6px 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; border: none; background: none; }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }

  .invitation { background: var(--bh-water); color: var(--bh-paper); border-top-color: var(--bh-water); }
  .invitation .kicker { background: var(--bh-mustard); color: var(--bh-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--bh-mustard); color: var(--bh-ink); border-left: 4px solid var(--bh-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--bh-water); color: var(--bh-paper); text-decoration: none; }
  .links a:hover { background: var(--bh-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .meta-dl > div, .dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .tl-list li { grid-template-columns: 1fr; } }
</style>
