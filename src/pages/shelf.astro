---
import BlockLayout from '../layouts/BlockLayout.astro';

const WALLET = 'tz1UWibBbQXvuSkThsLUGAaL4R5j7X3PSCKj';
---
<BlockLayout
  title="The shelf · PointCast"
  description="What the PointCast collector wallet holds on Tezos, read live from the public TzKT indexer. Display only."
  hideAds
>
  <link slot="head" rel="stylesheet" href="/kit/tezos-desk.css" />
  <main class="shelf-page">
    <h1>The shelf</h1>
    <p>
      This shows what the PointCast collector wallet holds on Tezos, read live from the public TzKT indexer.
      It is display only: no wallet connect, no sign-in.
    </p>
    <div
      data-office-shelf
      data-wallet={WALLET}
      data-title="the collector's shelf"
      data-limit="24"
    ></div>
    <p class="shelf-link">
      <a href={`https://objkt.com/users/${WALLET}`} rel="noopener noreferrer">The collector on objkt</a>
    </p>
  </main>
  <script src="/kit/office-shelf.js" is:inline defer></script>
</BlockLayout>

<style>
  .shelf-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: var(--td-ink, inherit);
  }
  .shelf-page h1 { margin: 0 0 0.5rem; }
  .shelf-link { margin-top: 1.5rem; }
  .shelf-link a { color: var(--td-accent, inherit); }
</style>
