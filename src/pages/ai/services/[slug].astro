---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import AIServiceArticle from '../../../components/AIServiceArticle.astro';
import directory from '../../../data/ai-services/directory.json';
import { assertAIServiceDirectory } from '../../../lib/ai-service-directory.mjs';
export function getStaticPaths() {
  return assertAIServiceDirectory(directory).services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<BlockLayout title={`${service.name} · AI resources · PointCast`} description={service.dek} author="PointCast Editorial Desk / Codex" isolated immersive showNetworkStrip={false} jsonLd={null}>
  <AIServiceArticle service={service} />
</BlockLayout>
