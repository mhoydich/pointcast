---
import { brand, essentials, rest, kits, campDays, fieldBook, voice, palette } from '../data/staycamp';

const canonical = 'https://pointcast.xyz/staycamp';
const title = 'Staycamp · Camp in. Lights optional.';
const description =
  'A home camping kit brand concept: a living-room campout on an ordinary weekend, and two calm weeks of water, warmth, light and routine when the power takes a long break.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Staycamp',
  description,
  url: canonical,
  creator: { '@type': 'Organization', name: 'PointCast' },
  isAccessibleForFree: true,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#2F4A3A" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topline wrap"><span>A PointCast brand concept</span><span>Not a product · nothing is for sale</span></div>

    <header class="site-header wrap">
      <a class="mark" href="#main" aria-label="Staycamp">
        <svg viewBox="0 0 40 32" width="34" height="27" aria-hidden="true"><path d="M20 3 37 29H3Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M20 15 26 29H14Z" fill="#D7643A"/></svg>
        <span>staycamp</span>
      </a>
      <nav aria-label="Sections">
        <a href="#essentials">The four</a><a href="#camp">Camp</a><a href="#kits">Kits</a><a href="#field-book">Field Book</a><a href="#voice">Voice</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div>
          <p class="eyebrow">Home camping kits</p>
          <h1>Camp in.<br /><em>Lights optional.</em></h1>
          <p class="intro">{brand.promise}</p>
          <p class="actions"><a class="button" href="#kits">See the kits</a><a href="#field-book">Read the Field Book</a></p>
        </div>
        <figure class="scene" aria-label="Illustration: a small tent pitched in a living room by lantern light, stars in the window.">
          <svg viewBox="0 0 480 360" role="img" aria-hidden="true">
            <rect width="480" height="360" rx="18" fill="#27324B" />
            <rect x="300" y="40" width="130" height="120" rx="6" fill="#1D2638" stroke="#F3ECDF" stroke-opacity=".35" stroke-width="4" />
            <line x1="365" y1="40" x2="365" y2="160" stroke="#F3ECDF" stroke-opacity=".35" stroke-width="3" />
            <circle cx="330" cy="75" r="2.4" fill="#F3ECDF" /><circle cx="400" cy="62" r="1.8" fill="#F3ECDF" /><circle cx="385" cy="120" r="2" fill="#F3ECDF" /><circle cx="345" cy="132" r="1.5" fill="#F3ECDF" /><circle cx="412" cy="100" r="9" fill="#E9B84C" opacity=".9" />
            <rect y="270" width="480" height="90" fill="#202A3F" />
            <ellipse cx="200" cy="292" rx="170" ry="26" fill="#D7643A" opacity=".55" />
            <path d="M200 120 300 280H100Z" fill="#2F4A3A" />
            <path d="M200 120 300 280H200Z" fill="#26402F" />
            <path d="M200 190 230 280H170Z" fill="#E9B84C" opacity=".85" />
            <rect x="345" y="226" width="26" height="44" rx="6" fill="#F3ECDF" />
            <rect x="350" y="214" width="16" height="12" rx="3" fill="#F3ECDF" />
            <circle cx="358" cy="248" r="40" fill="#E9B84C" opacity=".14" />
            <rect x="351" y="236" width="14" height="22" rx="4" fill="#E9B84C" />
          </svg>
        </figure>
      </section>

      <section class="idea">
        <div class="wrap two">
          <div><p class="eyebrow">The idea</p><h2>Your house is the campsite.</h2></div>
          <div>
            <p class="big">{brand.idea}</p>
            <p>Most preparedness gear is sold with a siren in the background. Staycamp is sold with a kettle. It is the same practical list, framed as what it really is for most households: a trip you take without leaving home.</p>
          </div>
        </div>
      </section>

      <section id="essentials" class="section wrap">
        <div class="heading"><p class="eyebrow">01 · The four that matter</p><h2>Water, warmth, the loo, and your medicine.</h2><p>Everything else is logistics. These four are where the kit spends its money.</p></div>
        <div class="grid four">
          {essentials.map((e) => (
            <article class="card" id={e.id}>
              <p class="tag">{e.need}</p>
              <h3>{e.kitName}</h3>
              <p class="line">{e.line}</p>
              <ul>{e.packs.map((p) => <li>{p}</li>)}</ul>
              <p class="note">{e.fieldNote}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="camp" class="section band">
        <div class="wrap">
          <div class="heading"><p class="eyebrow">02 · The rest of camp</p><h2>Sorted by what it depends on.</h2><p>Pumps need power, card readers need the network, towers need fuel. Each piece of gear stands in for one of those quiet dependencies.</p></div>
          <div class="grid rest">
            {rest.map((g) => (
              <article><p class="tag">{g.need}</p><h3>{g.name}</h3><p>{g.line}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section id="kits" class="section wrap">
        <div class="heading"><p class="eyebrow">03 · The kits</p><h2>Start with a weekend. Grow into a fortnight.</h2><p>Prices are concept pricing for the brand study.</p></div>
        <div class="grid kits">
          {kits.map((k, i) => (
            <article class:list={['kit', { featured: i === 1 }]}>
              <p class="tag">{k.span}</p>
              <h3>{k.name}</h3>
              <p class="for">{k.forWho}</p>
              <ul>{k.includes.map((x) => <li>{x}</li>)}</ul>
              <p class="price">{k.price}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section dusk">
        <div class="wrap">
          <div class="heading"><p class="eyebrow">04 · Camp days</p><h2>Days three to fourteen are about people.</h2><p>Gear runs the first few days. After that, it is neighbours, a rhythm, and having packed for the whole trip.</p></div>
          <div class="grid three">
            {campDays.map((c) => (
              <article><h3>{c.name}</h3><p>{c.line}</p></article>
            ))}
          </div>
          <p class="story">When the lights went out across the northeastern US and Ontario on 14 August 2003, the thing most people remembered afterwards was strangers directing traffic at dark intersections. That is the camp Staycamp is packing for.</p>
        </div>
      </section>

      <section id="field-book" class="section wrap">
        <div class="heading"><p class="eyebrow">05 · The Field Book</p><h2>The numbers, printed inside every lid.</h2><p>General guidance, plainly stated. Your local emergency office and your own clinician come first.</p></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Topic</th><th scope="col">Figure</th><th scope="col">What it means</th></tr></thead>
            <tbody>
              {fieldBook.map((r) => (
                <tr><th scope="row">{r.topic}</th><td class="fig">{r.figure}</td><td>{r.detail}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="voice" class="section band">
        <div class="wrap">
          <div class="heading"><p class="eyebrow">06 · Voice and look</p><h2>Calm, warm, useful.</h2><p>The brand is a good camp counsellor: knows the rules, never raises their voice.</p></div>
          <div class="grid three">
            <article><h3>We say</h3><ul class="chips">{voice.say.map((w) => <li>{w}</li>)}</ul></article>
            <article><h3>We never say</h3><ul class="chips no">{voice.avoid.map((w) => <li>{w}</li>)}</ul></article>
            <article><h3>House rules</h3><ol>{voice.rules.map((r) => <li>{r}</li>)}</ol></article>
          </div>
          <div class="swatches">
            {palette.map((c) => (
              <div class="swatch"><span style={`background:${c.hex}`}></span><strong>{c.name}</strong><code>{c.hex}</code><small>{c.use}</small></div>
            ))}
          </div>
          <div class="grid three pack">
            <article><h3>Packaging</h3><p>A canvas duffel for the Weekender and a pine-slatted crate for the Fortnight, built to sit in a hall closet without looking like a bunker. Each pouch is labelled like a cabin bunk: The Canteen, The Den, The Little House.</p></article>
            <article><h3>Photography</h3><p>Real living rooms at dusk. Kids in sleeping bags, a pot on the camp stove by an open window, the CO alarm visible on the shelf. Never empty streets, never flashlights in faces.</p></article>
            <article><h3>What we will not sell</h3><p>Fear, weapons, countdown timers, candles, or anything with a flame and no alarm. We do not sell fuel or generators, and we never suggest running either indoors.</p></article>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <p><strong>staycamp</strong> is a brand concept written by cc for PointCast. It is not a product, and nothing on this page is for sale. Safety figures are general guidance for planning, not a substitute for local emergency advice or your clinician.</p>
      <p><a href="/">← PointCast</a></p>
    </footer>
  </body>
</html>

<style>
  :root{--canvas:#F3ECDF;--canvas-2:#E9E0CF;--pine:#2F4A3A;--ember:#D7643A;--dusk:#27324B;--lantern:#E9B84C;--line:rgba(47,74,58,.22);color:var(--pine);background:var(--canvas);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:17px;scroll-behavior:smooth}
  *{box-sizing:border-box}body{margin:0;background:var(--canvas)}a{color:inherit;text-underline-offset:.2em}a:focus-visible{outline:3px solid var(--ember);outline-offset:4px}
  h1,h2,h3{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-weight:700;line-height:1.05;margin:0;letter-spacing:-.01em}
  h2{font-size:clamp(2rem,4.2vw,3.3rem)}h3{font-size:1.35rem;margin-bottom:.5rem}p{line-height:1.6;margin:0 0 1em}
  .wrap{max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,4vw,48px)}
  .skip{position:absolute;left:-999px}.skip:focus{left:16px;top:16px;background:var(--pine);color:var(--canvas);padding:8px 12px;z-index:5}
  .topline{display:flex;justify-content:space-between;gap:16px;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;padding-block:10px;border-bottom:1px solid var(--line)}
  .site-header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:20px;flex-wrap:wrap}
  .mark{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:"Iowan Old Style",Georgia,serif;font-size:1.7rem;font-weight:700;letter-spacing:-.02em}
  .site-header nav{display:flex;gap:18px;flex-wrap:wrap;font-size:.85rem}
  .eyebrow,.tag{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:var(--ember);margin-bottom:.8rem}
  .hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,56px);align-items:center;padding-block:clamp(28px,5vw,72px)}
  .hero h1{font-size:clamp(3rem,7vw,5.6rem);margin-bottom:1.4rem}.hero h1 em{font-style:italic;color:var(--ember)}
  .intro{font-size:clamp(1.05rem,1.6vw,1.25rem);max-width:36ch}
  .actions{display:flex;gap:22px;align-items:center;flex-wrap:wrap;margin-top:1.6rem}
  .button{background:var(--pine);color:var(--canvas);padding:12px 20px;border-radius:999px;text-decoration:none;font-weight:600}
  .scene{margin:0}.scene svg{width:100%;height:auto;display:block}
  .idea{background:var(--pine);color:var(--canvas);padding-block:clamp(48px,6vw,88px)}.idea .eyebrow{color:var(--lantern)}
  .two{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(24px,4vw,64px)}.big{font-size:clamp(1.15rem,1.8vw,1.45rem);line-height:1.45}
  .section{padding-block:clamp(52px,6vw,96px)}.heading{max-width:52rem;margin-bottom:2.2rem}.heading h2{margin-bottom:.8rem}
  .band{background:var(--canvas-2)}
  .grid{display:grid;gap:22px}.four{grid-template-columns:repeat(4,minmax(0,1fr))}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.rest{grid-template-columns:repeat(4,minmax(0,1fr))}.kits{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start}
  .card,.kit{background:#FBF7F0;border:1px solid var(--line);border-radius:14px;padding:22px}
  .card .line{font-weight:600}.card ul,.kit ul{padding-left:1.1em;margin:0 0 1em;font-size:.9rem}.card li,.kit li{margin-bottom:.4em;line-height:1.45}
  .note{font-size:.82rem;border-top:1px dashed var(--line);padding-top:.8em;margin:0;font-style:italic}
  .rest article{border-top:2px solid var(--pine);padding-top:16px}.rest p:not(.tag){font-size:.9rem}
  .kit .for{font-size:.9rem;opacity:.8}.price{font-family:"Iowan Old Style",Georgia,serif;font-size:2rem;margin:0}
  .kit.featured{background:var(--pine);color:var(--canvas);border-color:var(--pine)}.kit.featured .tag{color:var(--lantern)}
  .dusk{background:var(--dusk);color:var(--canvas)}.dusk .eyebrow{color:var(--lantern)}.dusk article{border-top:2px solid var(--lantern);padding-top:16px}
  .story{margin-top:2.4rem;max-width:48rem;font-family:"Iowan Old Style",Georgia,serif;font-size:1.2rem;font-style:italic}
  .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:#FBF7F0}
  table{border-collapse:collapse;width:100%;font-size:.92rem;min-width:560px}th,td{text-align:left;vertical-align:top;padding:14px 16px;border-bottom:1px solid var(--line)}
  thead th{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}tbody tr:last-child>*{border-bottom:0}.fig{font-weight:700;white-space:nowrap;color:var(--ember)}
  .chips{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}.chips li{background:var(--pine);color:var(--canvas);padding:5px 12px;border-radius:999px;font-size:.85rem}
  .chips.no li{background:transparent;color:var(--pine);border:1px solid var(--line);text-decoration:line-through;text-decoration-color:var(--ember)}
  ol{padding-left:1.2em;margin:0;font-size:.9rem}ol li{margin-bottom:.5em;line-height:1.45}
  .swatches{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-block:2.4rem}
  .swatch{display:flex;flex-direction:column;gap:3px;font-size:.85rem}.swatch span{height:72px;border-radius:10px;border:1px solid var(--line);margin-bottom:6px}.swatch small{opacity:.75}
  .pack p{font-size:.9rem}
  .foot{padding-block:36px 56px;border-top:1px solid var(--line);font-size:.85rem}
  @media(max-width:980px){.four,.rest{grid-template-columns:repeat(2,minmax(0,1fr))}.kits,.three{grid-template-columns:1fr}.swatches{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:720px){.hero,.two{grid-template-columns:1fr}.four,.rest{grid-template-columns:1fr}.swatches{grid-template-columns:repeat(2,minmax(0,1fr))}.topline{font-size:.62rem}}
  @media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}}
</style>
