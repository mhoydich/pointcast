---
import BlockLayout from '../layouts/BlockLayout.astro';
import gallery from '../data/el-segundo-school-gallery.json';

const categories = Array.from(new Set(gallery.works.map((work) => work.category)));
const assetOrigin = 'https://el-segundo-school-archive.pages.dev';
const title = '/el-segundo-school — 652 works · gallery + makers';
const description = 'A three-dimensional archive of 652 works by Michael Hoydich, with one-tez Passport postcard and Stampz custom-stamp makers on Tezos Mainnet.';
const data = JSON.stringify(gallery.works.map((work) => ({
  ...work,
  src: `${assetOrigin}${work.src.replace('/images/el-segundo-school', '')}`,
  thumb: `${assetOrigin}${work.thumb.replace('/images/el-segundo-school', '')}`,
}))).replace(/</g, '\\u003c');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The El Segundo School — 652 Works',
  description,
  url: 'https://pointcast.xyz/el-segundo-school',
  creator: { '@type': 'Person', name: 'Michael Hoydich' },
  numberOfItems: gallery.count,
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="ess">
    <header class="ess__head">
      <nav aria-label="El Segundo School sections">
        <a href="/">PointCast</a>
        <a href="#gallery">Gallery</a>
        <a href="?make=postcard">Passport</a>
        <a href="?make=stamp">Stampz</a>
        <a href="#physical">Physical</a>
        <a href="/university-of-el-segundo">Fund UES</a>
        <a href="https://el-segundo-school-daily.mhoydich.chatgpt.site/">Daily Wall 001 ↗</a>
      </nav>
      <div class="wallet-desk">
        <button class="wallet" id="wallet-connect" type="button">Connect Tezos wallet</button>
        <span id="wallet-status" role="status" aria-live="polite"></span>
      </div>
    </header>

    <section class="hero">
      <p class="eyebrow">POINTCAST FIELD BUILDING 07 · EL SEGUNDO, CALIFORNIA · 2026-07-17</p>
      <h1><span>THE EL SEGUNDO</span><span>SCHOOL</span></h1>
      <div class="hero__facts">
        <p><b>{gallery.count}</b> ORIGINAL WORKS</p>
        <p><b>{gallery.sets}</b> SETS OF FOUR</p>
        <p><b>1 ꜩ</b> MAKER EDITIONS</p>
        <p id="conditions"><b>—</b> EL SEGUNDO AIR</p>
      </div>
      <p class="hero__note">Michael Hoydich with Midjourney · directed in El Segundo · archived by original and display SHA-256 · PointCast + Passport + Stampz · Tezos Mainnet.</p>
    </section>

    <section class="gallery" id="gallery">
      <div class="gallery__head">
        <div>
          <p class="eyebrow">THE THREE-DIMENSIONAL INDEX</p>
          <h2>Walk the<br/>whole day.</h2>
        </div>
        <div class="gallery__tools">
          <label>Search <input id="gallery-search" type="search" placeholder="flower, alumni, genetics…" /></label>
          <div class="filters" role="group" aria-label="Filter the archive">
            <button type="button" data-filter="all" aria-pressed="true">All {gallery.count}</button>
            {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
          </div>
          <div class="gallery__views" role="group" aria-label="Choose gallery view">
            <span>View</span>
            <button type="button" data-view="salon" aria-pressed="true">3D salon</button>
            <button type="button" data-view="sets">Sets of four</button>
            <button type="button" data-view="index">Contact sheet</button>
            <button type="button" id="gallery-random">Random work ↗</button>
          </div>
          <p id="gallery-instruction">Drag to tilt · scroll to travel · select any wall to enter the maker.</p>
          <button class="gallery__mobile-all" id="gallery-mobile-all" type="button" hidden>Load all 652 works on this device</button>
        </div>
      </div>
      <div class="gallery__viewport" id="gallery-viewport">
        <div class="gallery__world" id="gallery-world" aria-live="polite"></div>
      </div>
      <div class="gallery__count"><span id="visible-count">0</span> works in this wing</div>
    </section>

    <section class="makers" id="makers">
      <div>
        <p class="eyebrow">PASSPORT MAKER · STAMPZ MAKER</p>
        <h2>Take one<br/>with you.</h2>
      </div>
      <div class="maker-intro">
        <p>Select any work upstairs. Turn it into a 6 × 4 Passport postcard or a custom Stampz object. The print file is yours; the collector edition is an atomic Mainnet action: exactly 1 ꜩ to Michael Hoydich and the mint in one wallet approval.</p>
        <button id="maker-random" type="button">Choose a work for me →</button>
      </div>
    </section>

    <section class="physical" id="physical">
      <p class="eyebrow">OBJECT DESK · AFTER THE TOKEN</p>
      <h2>Sticker, magnet,<br/>or both.</h2>
      <p>Every maker exports a high-resolution PNG plus a production brief. The handoff stays explicit: download the art, choose a printer, review their proof, then approve and pay the printer on their site.</p>
      <div class="vendor-grid">
        <a href="https://www.stickermule.com/products/rectangle-stickers" target="_blank" rel="noreferrer"><b>Sticker Mule</b><span>rectangle stickers · proof workflow ↗</span></a>
        <a href="https://www.stickermule.com/products/custom-magnets" target="_blank" rel="noreferrer"><b>Sticker Mule</b><span>custom magnets · 2–5 in + custom ↗</span></a>
        <a href="https://stickerapp.com/custom-stickers" target="_blank" rel="noreferrer"><b>StickerApp</b><span>die cut, square, circle, rounded ↗</span></a>
      </div>
    </section>

    <footer>
      <span>THE EL SEGUNDO SCHOOL · MICHAEL HOYDICH</span>
      <span>652 PNG ORIGINALS · NO AI UPSCALE REQUIRED</span>
      <a href="/postcards">POINTCAST /POSTCARDS →</a>
    </footer>
  </div>

  <dialog class="maker" id="maker-dialog">
    <div class="maker__bar">
      <button class="maker__close" id="maker-close" type="button" aria-label="Close maker and return to the gallery">← Back to gallery</button>
      <span>Passport + Stampz maker · Tezos Mainnet</span>
      <a href="/university-of-el-segundo">Fund the University →</a>
    </div>
    <div class="maker__preview"><canvas id="maker-canvas" width="1800" height="1200"></canvas></div>
    <form class="maker__panel" method="dialog" onsubmit="return false">
      <p class="eyebrow" id="maker-work-label">WORK —</p>
      <h2 id="maker-work-title">Select a work</h2>
      <div class="kind-switch" role="group" aria-label="Maker type">
        <button type="button" data-kind="postcard" aria-pressed="true">Passport postcard</button>
        <button type="button" data-kind="stamp">Stampz stamp</button>
      </div>
      <label>Title <input id="maker-title" maxlength="72" value="Greetings from El Segundo" /></label>
      <label>Message <textarea id="maker-message" maxlength="180" rows="4">Field notes from a school without walls.</textarea></label>
      <label>Credit <input id="maker-credit" maxlength="72" value="Michael Hoydich · The El Segundo School" /></label>
      <label>Crop <input id="maker-crop" type="range" min="0" max="100" value="50" /></label>
      <fieldset>
        <legend>Ink field</legend>
        <label><input type="radio" name="accent" value="acid" checked /> Acid</label>
        <label><input type="radio" name="accent" value="blue" /> Blue</label>
        <label><input type="radio" name="accent" value="red" /> Red</label>
        <label><input type="radio" name="accent" value="paper" /> Paper</label>
        <label><input type="radio" name="accent" value="black" /> Black</label>
      </fieldset>
      <label>Object shape
        <select id="maker-shape"><option value="rectangle">Rectangle</option><option value="rounded">Rounded</option><option value="circle">Circle</option></select>
      </label>
      <div class="maker__actions">
        <button id="download-print" type="button">Download print PNG</button>
        <button id="download-brief" type="button">Sticker / magnet brief</button>
        <button id="mint-composition" type="button">Mint · 1 ꜩ + gas</button>
      </div>
      <label class="consent"><input id="mint-consent" type="checkbox" /> I understand Kukai or Temple will show the exact Mainnet operation before anything is signed.</label>
      <p class="maker__status" id="maker-status" role="status">Choose a format, tune the type, then download or mint.</p>
      <a class="maker__operation" id="maker-operation" target="_blank" rel="noreferrer" hidden>View operation on TzKT ↗</a>
    </form>
  </dialog>

  <script id="ess-gallery-data" type="application/json" set:html={data}></script>
</BlockLayout>

<script>
  type GalleryWork = {
    id: string;
    number: string;
    title: string;
    category: string;
    src: string;
    thumb: string;
    width: number;
    height: number;
    displaySha256: string;
    originalSha256: string;
    set: number;
    variant: number;
    session: number;
    prompt: string;
    sourceWidth: number;
    sourceHeight: number;
  };

  const works = JSON.parse(document.getElementById('ess-gallery-data')?.textContent || '[]') as GalleryWork[];
  const world = document.getElementById('gallery-world')!;
  const viewport = document.getElementById('gallery-viewport')!;
  const visibleCount = document.getElementById('visible-count')!;
  const search = document.getElementById('gallery-search') as HTMLInputElement;
  const dialog = document.getElementById('maker-dialog') as HTMLDialogElement;
  const canvas = document.getElementById('maker-canvas') as HTMLCanvasElement;
  const context = canvas.getContext('2d')!;
  const workLabel = document.getElementById('maker-work-label')!;
  const workTitle = document.getElementById('maker-work-title')!;
  const titleInput = document.getElementById('maker-title') as HTMLInputElement;
  const messageInput = document.getElementById('maker-message') as HTMLTextAreaElement;
  const creditInput = document.getElementById('maker-credit') as HTMLInputElement;
  const cropInput = document.getElementById('maker-crop') as HTMLInputElement;
  const shapeInput = document.getElementById('maker-shape') as HTMLSelectElement;
  const status = document.getElementById('maker-status')!;
  const operationLink = document.getElementById('maker-operation') as HTMLAnchorElement;
  const connectButton = document.getElementById('wallet-connect') as HTMLButtonElement;
  const walletStatus = document.getElementById('wallet-status')!;
  let selected = works[0];
  let selectedKind: 'postcard' | 'stamp' = 'postcard';
  let selectedFilter = 'all';
  let selectedView: 'salon' | 'sets' | 'index' = 'salon';
  let mobileExpanded = false;
  let walletAddress = '';
  let previewImage = new Image();
  let tezosModule: Promise<typeof import('../lib/el-segundo-school-mint')> | null = null;
  previewImage.decoding = 'async';
  previewImage.crossOrigin = 'anonymous';

  const palettes: Record<string, { ink: string; paper: string; accent: string }> = {
    acid: { ink: '#11120f', paper: '#f1efe5', accent: '#caff24' },
    blue: { ink: '#f1efe5', paper: '#0826d6', accent: '#caff24' },
    red: { ink: '#11120f', paper: '#fa4428', accent: '#f1efe5' },
    paper: { ink: '#11120f', paper: '#f1efe5', accent: '#0826d6' },
    black: { ink: '#f1efe5', paper: '#11120f', accent: '#fa4428' },
  };

  function currentAccent() {
    return (document.querySelector('input[name="accent"]:checked') as HTMLInputElement)?.value || 'acid';
  }

  function filteredWorks() {
    const query = search.value.trim().toLowerCase();
    return works.filter((work) =>
      (selectedFilter === 'all' || work.category === selectedFilter) &&
      (!query || `${work.title} ${work.prompt} ${work.category} ${work.number}`.toLowerCase().includes(query))
    );
  }

  function renderGallery() {
    const list = filteredWorks();
    const compact = window.matchMedia('(max-width: 720px)').matches;
    const isUnfiltered = selectedFilter === 'all' && !search.value.trim();
    const rendered = compact && isUnfiltered && !mobileExpanded ? list.slice(0, 48) : list;
    const mobileAll = document.getElementById('gallery-mobile-all') as HTMLButtonElement | null;
    if (mobileAll) {
      mobileAll.hidden = !compact || !isUnfiltered || mobileExpanded;
      mobileAll.textContent = `Load all ${list.length} works on this device`;
    }
    world.replaceChildren();
    const fragment = document.createDocumentFragment();
    rendered.forEach((work, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'art-wall';
      button.style.setProperty('--art-ratio', `${work.width} / ${work.height}`);
      button.style.setProperty('--z', `${(index % 7) * 8}px`);
      button.style.setProperty('--lean', `${index % 2 ? 1.4 : -1.4}deg`);
      button.innerHTML = `<img src="${work.thumb}" alt="" loading="lazy" width="${work.width}" height="${work.height}"/><span><b>${work.number}</b>${work.title}<i>SET ${String(work.set).padStart(3, '0')} · V${work.variant}</i></span>`;
      button.setAttribute('aria-label', `Open maker with work ${work.number}: ${work.title}`);
      button.addEventListener('click', () => openMaker(work));
      fragment.append(button);
    });
    world.append(fragment);
    visibleCount.textContent = rendered.length === list.length ? String(list.length) : `${rendered.length} of ${list.length}`;
  }

  function setGalleryView(view: 'salon' | 'sets' | 'index') {
    selectedView = view;
    world.dataset.view = view;
    document.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.view === view));
    });
    const instruction = document.getElementById('gallery-instruction');
    if (instruction) instruction.textContent = view === 'salon'
      ? 'Drag to tilt · scroll to travel · select any wall to enter the maker.'
      : view === 'sets'
        ? 'Every four consecutive works preserve the original Midjourney set.'
        : 'A compact, uncropped index of all 652 works.';
    try { localStorage.setItem('el-segundo-school-view', view); } catch { /* private mode */ }
  }

  function drawWrappedText(text: string, x: number, y: number, width: number, lineHeight: number, maxLines: number) {
    const words = text.split(/\s+/).filter(Boolean);
    const lines: string[] = [];
    let line = '';
    for (const word of words) {
      const next = line ? `${line} ${word}` : word;
      if (context.measureText(next).width > width && line) {
        lines.push(line); line = word;
      } else line = next;
      if (lines.length === maxLines - 1) break;
    }
    if (line && lines.length < maxLines) lines.push(line);
    lines.forEach((value, index) => context.fillText(value, x, y + index * lineHeight));
  }

  function drawCover(image: HTMLImageElement, x: number, y: number, width: number, height: number, crop: number) {
    const imageRatio = image.naturalWidth / image.naturalHeight;
    const boxRatio = width / height;
    let sourceWidth = image.naturalWidth;
    let sourceHeight = image.naturalHeight;
    if (imageRatio > boxRatio) sourceWidth = image.naturalHeight * boxRatio;
    else sourceHeight = image.naturalWidth / boxRatio;
    const sourceX = (image.naturalWidth - sourceWidth) * crop / 100;
    const sourceY = (image.naturalHeight - sourceHeight) * crop / 100;
    context.drawImage(image, sourceX, sourceY, sourceWidth, sourceHeight, x, y, width, height);
  }

  function drawMaker() {
    if (!previewImage.complete || !previewImage.naturalWidth) return;
    const stamp = selectedKind === 'stamp';
    canvas.width = stamp ? 1200 : 1800;
    canvas.height = 1200;
    const palette = palettes[currentAccent()] || palettes.acid;
    context.fillStyle = palette.paper;
    context.fillRect(0, 0, canvas.width, canvas.height);
    const crop = Number(cropInput.value);

    if (stamp) {
      drawCover(previewImage, 70, 70, 1060, 820, crop);
      context.fillStyle = palette.paper;
      context.fillRect(70, 920, 1060, 210);
      context.fillStyle = palette.ink;
      context.font = '700 42px Arial';
      context.fillText(titleInput.value.toUpperCase(), 100, 988, 1000);
      context.font = '28px Georgia';
      drawWrappedText(messageInput.value, 100, 1040, 980, 34, 2);
      context.strokeStyle = palette.accent;
      context.lineWidth = 16;
      context.setLineDash([12, 18]);
      context.strokeRect(28, 28, 1144, 1144);
      context.setLineDash([]);
    } else {
      context.fillStyle = palette.accent;
      context.fillRect(82, 82, 580, 1036);
      drawCover(previewImage, 720, 82, 998, 1036, crop);
      context.fillStyle = palette.ink;
      context.font = '700 34px Arial';
      context.fillText(titleInput.value.toUpperCase(), 112, 160, 520);
      context.font = '58px Georgia';
      drawWrappedText(messageInput.value, 112, 250, 510, 66, 9);
      context.font = '20px monospace';
      context.fillText(creditInput.value.toUpperCase(), 112, 1060, 510);
    }
    context.font = '18px monospace';
    context.fillStyle = palette.ink;
    context.textAlign = 'right';
    context.fillText(`POINTCAST · WORK ${selected.number} · ${selected.originalSha256.slice(0, 12)}`, canvas.width - 52, canvas.height - 44);
    context.textAlign = 'left';
  }

  function openMaker(work: GalleryWork) {
    selected = work;
    workLabel.textContent = `WORK ${work.number} · SET ${String(work.set).padStart(3, '0')} · ${work.category}`;
    workTitle.textContent = work.title;
    previewImage = new Image();
    previewImage.decoding = 'async';
    previewImage.crossOrigin = 'anonymous';
    previewImage.onload = drawMaker;
    previewImage.src = work.src;
    status.textContent = 'Choose a format, tune the type, then download or mint.';
    operationLink.hidden = true;
    if (!dialog.open) dialog.showModal();
  }

  async function connect() {
    connectButton.disabled = true;
    connectButton.textContent = 'Opening wallet…';
    try {
      walletStatus.textContent = 'Mainnet · choose Kukai, Temple, or another Beacon wallet.';
      tezosModule ??= import('../lib/el-segundo-school-mint');
      const { connectSchoolWallet } = await tezosModule;
      walletAddress = await connectSchoolWallet();
      connectButton.textContent = `${walletAddress.slice(0, 6)}…${walletAddress.slice(-4)}`;
      walletStatus.textContent = 'Connected · no operation has been signed.';
      return walletAddress;
    } catch (error) {
      connectButton.textContent = 'Connect Tezos wallet';
      const message = error instanceof Error ? error.message : String(error);
      walletStatus.textContent = /abort|cancel|reject|closed/i.test(message)
        ? 'Wallet window closed · nothing signed.'
        : `Wallet unavailable · ${message.slice(0, 84)}`;
      console.error('[El Segundo School wallet]', error);
      throw error;
    } finally {
      connectButton.disabled = false;
    }
  }

  function makerPayload(owner: string) {
    return {
      kind: selectedKind,
      workId: selected.id,
      owner,
      title: titleInput.value,
      message: messageInput.value,
      credit: creditInput.value,
      accent: currentAccent(),
      crop: Number(cropInput.value),
      shape: shapeInput.value,
    };
  }

  function download(name: string, blob: Blob) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url; link.download = name; link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  connectButton.addEventListener('click', () => void connect().catch(() => undefined));
  function closeMaker() {
    dialog.close();
    const url = new URL(window.location.href);
    if (url.searchParams.has('make')) {
      url.searchParams.delete('make');
      history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  }

  document.getElementById('maker-close')?.addEventListener('click', closeMaker);
  dialog.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMaker();
  });
  document.getElementById('maker-random')?.addEventListener('click', () => openMaker(works[Math.floor(Math.random() * works.length)]));
  document.getElementById('gallery-mobile-all')?.addEventListener('click', () => {
    mobileExpanded = true;
    renderGallery();
  });
  search.addEventListener('input', renderGallery);
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      selectedFilter = button.dataset.filter || 'all';
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      renderGallery();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach((button) => {
    button.addEventListener('click', () => {
      const view = button.dataset.view;
      if (view === 'salon' || view === 'sets' || view === 'index') setGalleryView(view);
    });
  });
  document.getElementById('gallery-random')?.addEventListener('click', () => {
    const list = filteredWorks();
    if (list.length) openMaker(list[Math.floor(Math.random() * list.length)]);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((button) => {
    button.addEventListener('click', () => {
      selectedKind = button.dataset.kind === 'stamp' ? 'stamp' : 'postcard';
      document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      titleInput.value = selectedKind === 'stamp' ? 'Stampz / El Segundo' : 'Greetings from El Segundo';
      const url = new URL(window.location.href);
      url.searchParams.set('make', selectedKind);
      history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      drawMaker();
    });
  });
  [titleInput, messageInput, creditInput, cropInput, shapeInput].forEach((input) => input.addEventListener('input', drawMaker));
  document.querySelectorAll<HTMLInputElement>('input[name="accent"]').forEach((input) => input.addEventListener('change', drawMaker));

  document.getElementById('download-print')?.addEventListener('click', () => {
    drawMaker();
    canvas.toBlob((blob) => { if (blob) download(`el-segundo-${selectedKind}-${selected.number}.png`, blob); }, 'image/png');
  });
  document.getElementById('download-brief')?.addEventListener('click', () => {
    const brief = {
      schema: 'pointcast.physical-object-request.v1',
      createdAt: new Date().toISOString(),
      requestedObjects: ['sticker', 'magnet'],
      artFile: `el-segundo-${selectedKind}-${selected.number}.png`,
      work: { id: selected.id, number: selected.number, title: selected.title, originalSha256: selected.originalSha256 },
      maker: makerPayload(walletAddress || 'connect-wallet-before-mint'),
      production: selectedKind === 'postcard'
        ? { sizeInches: '6 x 4', pixels: '1800 x 1200', targetDpi: 300, finish: 'matte', proofRequired: true }
        : { sizeInches: '3 x 3', pixels: '1200 x 1200', targetDpi: 300, finish: 'matte or holographic', proofRequired: true },
      vendors: [
        'https://www.stickermule.com/products/rectangle-stickers',
        'https://www.stickermule.com/products/custom-magnets',
        'https://stickerapp.com/custom-stickers',
      ],
      note: 'Draft request only. Review the vendor proof and price before placing an order.',
    };
    download(`el-segundo-${selectedKind}-${selected.number}-physical-request.json`, new Blob([JSON.stringify(brief, null, 2)], { type: 'application/json' }));
  });

  document.getElementById('mint-composition')?.addEventListener('click', async () => {
    const consent = document.getElementById('mint-consent') as HTMLInputElement;
    if (!consent.checked) { status.textContent = 'Check the Mainnet acknowledgement before opening the wallet.'; return; }
    const mintButton = document.getElementById('mint-composition') as HTMLButtonElement;
    mintButton.disabled = true;
    operationLink.hidden = true;
    try {
      status.textContent = 'Connecting Tezos Mainnet…';
      const owner = walletAddress || await connect();
      tezosModule ??= import('../lib/el-segundo-school-mint');
      const { createSchoolCollector, findSchoolCollector, mintSchoolComposition } = await tezosModule;
      status.textContent = 'Looking for your PointCast maker collection…';
      let contract = await findSchoolCollector(owner);
      if (!contract) {
        status.textContent = 'First visit: review collection creation in your wallet. This is gas only.';
        const created = await createSchoolCollector(owner);
        contract = created.contract;
      }
      status.textContent = 'Registering the composition recipe…';
      const response = await fetch('/api/el-segundo-school/compositions', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(makerPayload(owner)),
      });
      if (!response.ok) throw new Error('COMPOSITION_STORAGE_UNAVAILABLE');
      const composition = await response.json() as { id: string; artifactUri: string; metadataUri: string };
      status.textContent = 'Review the atomic 1 ꜩ payment + mint in your wallet…';
      const operation = await mintSchoolComposition({
        owner,
        contract,
        work: selected,
        composition: { ...composition, kind: selectedKind, title: titleInput.value, message: messageInput.value },
      });
      operationLink.href = `https://tzkt.io/${operation.opHash}`;
      operationLink.hidden = false;
      status.textContent = 'Broadcast. Waiting for one Mainnet confirmation…';
      await operation.confirmation;
      status.textContent = 'Minted on Tezos Mainnet. Your print file and physical request remain available here.';
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      status.textContent = /abort|cancel|reject/i.test(message)
        ? 'Wallet request closed. Nothing was minted and no tez moved.'
        : `Mint did not finish: ${message.slice(0, 120)}`;
    } finally {
      mintButton.disabled = false;
    }
  });

  let drag = false;
  viewport.addEventListener('pointerdown', () => { drag = true; });
  window.addEventListener('pointerup', () => { drag = false; world.style.removeProperty('--tilt-x'); world.style.removeProperty('--tilt-y'); });
  viewport.addEventListener('pointermove', (event) => {
    if (!drag || selectedView !== 'salon') return;
    const box = viewport.getBoundingClientRect();
    world.style.setProperty('--tilt-y', `${((event.clientX - box.left) / box.width - .5) * 12}deg`);
    world.style.setProperty('--tilt-x', `${((event.clientY - box.top) / box.height - .5) * -7}deg`);
  });

  void fetch('https://api.open-meteo.com/v1/forecast?latitude=33.9192&longitude=-118.4165&current=temperature_2m,weather_code&temperature_unit=fahrenheit')
    .then((response) => response.json())
    .then((weather) => {
      const element = document.getElementById('conditions');
      if (element && Number.isFinite(weather?.current?.temperature_2m)) element.innerHTML = `<b>${Math.round(weather.current.temperature_2m)}°F</b> EL SEGUNDO AIR`;
    }).catch(() => undefined);

  const requestedMaker = new URLSearchParams(window.location.search).get('make');
  if (requestedMaker === 'stamp') {
    selectedKind = 'stamp';
    titleInput.value = 'Stampz / El Segundo';
    document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.kind === 'stamp'));
    });
  }
  try {
    const savedView = localStorage.getItem('el-segundo-school-view');
    if (savedView === 'sets' || savedView === 'index') setGalleryView(savedView);
    else setGalleryView(window.matchMedia('(max-width: 720px)').matches ? 'index' : 'salon');
  } catch { setGalleryView('salon'); }
  renderGallery();
  if (requestedMaker === 'postcard' || requestedMaker === 'stamp') openMaker(works[0]);
</script>

