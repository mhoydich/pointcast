<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b2632" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="description"
      content="One PointCast invitation for today: spend ninety seconds finding the seat nobody designed, then make a private field receipt."
    />
    <link rel="canonical" href="https://pointcast.xyz/field" />
    <link rel="alternate" type="application/json" href="/field.json" title="PointCast Field invitation data" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="Find the seat nobody designed — PointCast Field" />
    <meta
      property="og:description"
      content="Look for something that was not sold as furniture, but quietly gives a person permission to stop."
    />
    <meta property="og:url" content="https://pointcast.xyz/field" />
    <meta property="og:image" content="https://pointcast.xyz/images/og/b/0546.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Find the seat nobody designed — PointCast Field" />
    <meta
      name="twitter:description"
      content="One ninety-second field invitation. No account, no feed, one observation."
    />
    <meta name="twitter:image" content="https://pointcast.xyz/images/og/b/0546.png" />
    <title>PointCast Field — Find the seat nobody designed</title>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Action",
        "@id": "https://pointcast.xyz/field#invitation",
        "name": "Find the seat nobody designed",
        "description": "A ninety-second PointCast field invitation to notice an object that quietly gives a person permission to stop.",
        "url": "https://pointcast.xyz/field",
        "isPartOf": {
          "@type": "CreativeWorkSeries",
          "name": "Beach Commons",
          "url": "https://pointcast.xyz/beach-commons"
        }
      }
    </script>
    <style>
      :root {
        color-scheme: light;
        --navy: #0b2632;
        --navy-2: #123d4a;
        --paper: #f4efd9;
        --paper-2: #e9dfc2;
        --ink: #102a33;
        --orange: #f06a3f;
        --yellow: #f2c85f;
        --blue: #69b2c5;
        --green: #7ea68d;
        --white: #fffdf5;
        --line: rgba(16, 42, 51, 0.22);
        --mono: "SFMono-Regular", "IBM Plex Mono", "JetBrains Mono", Consolas, monospace;
        --sans: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
        --serif: Iowan Old Style, "Palatino Linotype", Palatino, Georgia, serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        background: var(--navy);
        scroll-behavior: smooth;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      button,
      input,
      textarea {
        color: inherit;
        font: inherit;
      }

      button,
      a,
      label {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        cursor: pointer;
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      [hidden] {
        display: none !important;
      }

      :focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 4px;
      }

      ::selection {
        background: var(--yellow);
        color: var(--navy);
      }

      .skip {
        position: fixed;
        z-index: 100;
        top: 8px;
        left: 8px;
        padding: 12px 15px;
        background: var(--yellow);
        color: var(--navy);
        font: 800 11px/1 var(--mono);
        text-decoration: none;
        text-transform: uppercase;
        transform: translateY(-180%);
      }

      .skip:focus {
        transform: translateY(0);
      }

      .topbar {
        position: relative;
        z-index: 20;
        display: grid;
        min-height: 58px;
        grid-template-columns: minmax(0, 1fr) auto auto;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        background: var(--navy);
        color: var(--white);
      }

      .topbar > * {
        display: flex;
        align-items: center;
        padding: 0 clamp(15px, 2.5vw, 32px);
        border-left: 1px solid rgba(255, 255, 255, 0.2);
        font: 750 10px/1 var(--mono);
        letter-spacing: 0.11em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .topbar__brand {
        border-left: 0;
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.17em;
      }

      .topbar__live {
        gap: 8px;
      }

      .topbar__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 0 5px rgba(240, 106, 63, 0.16);
        animation: pulse 2.8s ease-in-out infinite;
      }

      @keyframes pulse {
        50% {
          box-shadow: 0 0 0 10px rgba(240, 106, 63, 0);
        }
      }

      .intro {
        display: grid;
        min-height: calc(100svh - 58px);
        grid-template-columns: minmax(0, 0.94fr) minmax(420px, 1.06fr);
        background: var(--navy);
        color: var(--white);
      }

      .intro__copy {
        position: relative;
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(26px, 4vw, 56px) clamp(18px, 5vw, 72px) clamp(22px, 3.5vw, 44px);
      }

      .eyebrow {
        margin: 0;
        color: var(--yellow);
        font: 800 10px/1.35 var(--mono);
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .intro h1 {
        max-width: 8ch;
        margin: 0.18em 0 0;
        font-size: clamp(58px, 7.4vw, 112px);
        font-weight: 900;
        letter-spacing: -0.078em;
        line-height: 0.79;
      }

      .intro h1 em {
        display: block;
        color: var(--yellow);
        font-family: var(--serif);
        font-size: 0.74em;
        font-weight: 400;
        letter-spacing: -0.045em;
        line-height: 1;
      }

      .intro__dek {
        max-width: 31ch;
        margin: 24px 0 0;
        color: rgba(255, 253, 245, 0.82);
        font-size: clamp(18px, 1.8vw, 26px);
        font-weight: 520;
        letter-spacing: -0.03em;
        line-height: 1.12;
      }

      .intro__action {
        margin-top: clamp(26px, 4vw, 48px);
      }

      .primary {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        min-width: min(100%, 360px);
        gap: 28px;
        border: 0;
        padding: 18px 20px;
        background: var(--orange);
        color: var(--white);
        box-shadow: 7px 7px 0 var(--yellow);
        font: 850 12px/1 var(--mono);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: transform 160ms ease, box-shadow 160ms ease;
      }

      .primary:hover {
        box-shadow: 3px 3px 0 var(--yellow);
        transform: translate(4px, 4px);
      }

      .primary span:last-child {
        font-size: 20px;
      }

      .intro__promise {
        display: flex;
        flex-wrap: wrap;
        gap: 9px 22px;
        margin-top: 16px;
        color: rgba(255, 253, 245, 0.58);
        font: 650 9px/1.3 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .intro__visual {
        position: relative;
        height: calc(100svh - 58px);
        min-height: 650px;
        overflow: hidden;
        background: #ceb47d;
      }

      .intro__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.88) contrast(0.98);
      }

      .intro__visual::after {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, transparent 45%, rgba(11, 38, 50, 0.58)),
          linear-gradient(90deg, rgba(11, 38, 50, 0.14), transparent 24%);
        content: "";
        pointer-events: none;
      }

      .stamp {
        position: absolute;
        z-index: 2;
        top: clamp(18px, 3vw, 34px);
        right: clamp(18px, 3vw, 34px);
        display: grid;
        width: clamp(104px, 12vw, 162px);
        aspect-ratio: 1;
        place-items: center;
        border: 2px solid var(--white);
        border-radius: 50%;
        background: var(--orange);
        color: var(--white);
        text-align: center;
        transform: rotate(7deg);
      }

      .stamp strong {
        display: block;
        font: 900 clamp(27px, 3vw, 44px)/0.9 var(--sans);
        letter-spacing: -0.05em;
      }

      .stamp span {
        display: block;
        margin-top: 7px;
        font: 700 8px/1.2 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .visual-caption {
        position: absolute;
        z-index: 2;
        right: 18px;
        bottom: 18px;
        left: 18px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        padding: 13px 15px;
        background: rgba(11, 38, 50, 0.9);
        color: var(--white);
        font: 650 9px/1.4 var(--mono);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .field {
        background: var(--paper);
      }

      .field__head {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        border-bottom: 1px solid var(--line);
      }

      .field__label,
      .field__question {
        padding: clamp(28px, 4vw, 52px) clamp(18px, 5vw, 72px);
      }

      .field__label {
        border-right: 1px solid var(--line);
        background: var(--yellow);
      }

      .field__label strong {
        display: block;
        margin-top: 14px;
        font-size: clamp(34px, 4vw, 58px);
        font-weight: 900;
        letter-spacing: -0.065em;
        line-height: 0.88;
      }

      .field__question h2 {
        max-width: 20ch;
        margin: 0;
        font-size: clamp(40px, 4vw, 56px);
        font-weight: 850;
        letter-spacing: -0.067em;
        line-height: 0.88;
      }

      .field__question p {
        max-width: 58ch;
        margin: 18px 0 0;
        font-size: clamp(16px, 1.5vw, 20px);
        line-height: 1.35;
      }

      .prompt-grid {
        display: grid;
        min-height: calc(100svh - 58px);
        grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
      }

      .timer-panel {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(28px, 3.5vw, 48px);
        background: var(--blue);
        color: var(--navy);
      }

      .timer {
        display: grid;
        width: min(100%, 240px);
        aspect-ratio: 1;
        place-items: center;
        border: clamp(13px, 1.7vw, 24px) solid var(--navy);
        border-radius: 50%;
        background: rgba(255, 253, 245, 0.22);
      }

      .timer__number {
        display: block;
        font-size: clamp(72px, 7vw, 104px);
        font-weight: 900;
        letter-spacing: -0.08em;
        line-height: 0.72;
      }

      .timer__unit {
        display: block;
        margin-top: 18px;
        font: 750 10px/1 var(--mono);
        letter-spacing: 0.15em;
        text-align: center;
        text-transform: uppercase;
      }

      .timer-panel__note {
        max-width: 35ch;
        margin: 18px 0 0;
        font-size: 14px;
        line-height: 1.4;
      }

      .checklist {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(28px, 3.5vw, 48px) clamp(18px, 5vw, 72px);
      }

      .checklist h3 {
        max-width: 12ch;
        margin: 12px 0 20px;
        font-size: clamp(36px, 4vw, 56px);
        font-weight: 880;
        letter-spacing: -0.06em;
        line-height: 0.91;
      }

      .conditions {
        margin: 0;
        padding: 0;
        counter-reset: conditions;
        list-style: none;
      }

      .conditions li {
        display: grid;
        min-height: 52px;
        grid-template-columns: 48px 1fr;
        align-items: center;
        border-top: 1px solid var(--line);
        font-size: clamp(15px, 1.45vw, 19px);
        line-height: 1.25;
        counter-increment: conditions;
      }

      .conditions li::before {
        color: var(--orange);
        content: "0" counter(conditions);
        font: 800 10px/1 var(--mono);
      }

      .found {
        width: 100%;
        margin-top: 20px;
        border: 2px solid var(--navy);
        padding: 17px 20px;
        background: var(--navy);
        color: var(--white);
        font: 850 12px/1 var(--mono);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .found:hover {
        background: var(--orange);
        border-color: var(--orange);
      }

      .observe {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, 0.72fr);
        background: var(--paper);
      }

      .observe__form {
        padding: clamp(42px, 7vw, 98px) clamp(18px, 6vw, 92px);
      }

      .observe h2 {
        max-width: 12ch;
        margin: 18px 0 42px;
        font-size: clamp(46px, 7vw, 104px);
        font-weight: 900;
        letter-spacing: -0.075em;
        line-height: 0.83;
      }

      fieldset {
        margin: 0 0 30px;
        border: 0;
        padding: 0;
      }

      legend,
      .field-label {
        display: block;
        margin-bottom: 13px;
        font: 800 10px/1.3 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .chip input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
      }

      .chip span {
        display: block;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 11px 15px;
        background: transparent;
        font-size: 14px;
        font-weight: 700;
      }

      .chip input:checked + span {
        background: var(--navy);
        color: var(--white);
      }

      .chip input:focus-visible + span {
        outline: 3px solid var(--orange);
        outline-offset: 3px;
      }

      .note-wrap {
        position: relative;
      }

      textarea {
        width: 100%;
        min-height: 120px;
        resize: vertical;
        border: 1px solid var(--ink);
        border-radius: 0;
        padding: 15px 16px 34px;
        background: var(--white);
        font-size: 17px;
        line-height: 1.4;
      }

      .count {
        position: absolute;
        right: 12px;
        bottom: 10px;
        color: rgba(16, 42, 51, 0.58);
        font: 700 9px/1 var(--mono);
      }

      .photo {
        display: grid;
        min-height: 132px;
        place-items: center;
        border: 1px dashed var(--ink);
        padding: 18px;
        background: var(--paper-2);
        text-align: center;
        cursor: pointer;
      }

      .photo input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
      }

      .photo strong {
        display: block;
        font-size: 15px;
      }

      .photo small {
        display: block;
        margin-top: 7px;
        color: rgba(16, 42, 51, 0.65);
        font: 650 9px/1.4 var(--mono);
        text-transform: uppercase;
      }

      .photo-preview {
        width: 100%;
        max-height: 300px;
        margin-top: 12px;
        object-fit: cover;
      }

      .make-receipt {
        width: 100%;
        margin-top: 24px;
        border: 0;
        padding: 18px 20px;
        background: var(--orange);
        color: var(--white);
        font: 850 12px/1 var(--mono);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .observe__aside {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(38px, 6vw, 82px) clamp(20px, 4vw, 56px);
        background: var(--navy);
        color: var(--white);
      }

      .observe__aside blockquote {
        margin: 0;
        color: var(--yellow);
        font-family: var(--serif);
        font-size: clamp(36px, 5vw, 70px);
        font-style: italic;
        letter-spacing: -0.04em;
        line-height: 0.98;
      }

      .observe__aside p {
        max-width: 36ch;
        margin: 42px 0 0;
        color: rgba(255, 253, 245, 0.7);
        line-height: 1.5;
      }

      .privacy {
        border-top: 1px solid rgba(255, 255, 255, 0.24);
        padding-top: 20px;
        color: rgba(255, 253, 245, 0.58);
        font: 650 9px/1.5 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .receipt-stage {
        display: grid;
        min-height: calc(100svh - 58px);
        grid-template-columns: minmax(0, 1fr) minmax(300px, 0.58fr);
        background: var(--paper-2);
      }

      .receipt-wrap {
        display: grid;
        place-items: center;
        padding: clamp(28px, 6vw, 82px);
      }

      .receipt {
        position: relative;
        width: min(100%, 690px);
        min-height: 760px;
        overflow: hidden;
        border: 1px solid rgba(16, 42, 51, 0.45);
        padding: clamp(25px, 5vw, 54px);
        background: var(--white);
        box-shadow: 18px 18px 0 var(--blue);
      }

      .receipt::before,
      .receipt::after {
        position: absolute;
        right: -44px;
        border-radius: 50%;
        content: "";
      }

      .receipt::before {
        top: -48px;
        width: 180px;
        height: 180px;
        background: var(--yellow);
      }

      .receipt::after {
        top: 72px;
        width: 116px;
        height: 116px;
        background: var(--orange);
        mix-blend-mode: multiply;
      }

      .receipt__top {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 17px;
        font: 800 9px/1.4 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .receipt h2 {
        position: relative;
        z-index: 2;
        max-width: 8ch;
        margin: 44px 0 16px;
        font-size: clamp(52px, 7vw, 88px);
        font-weight: 900;
        letter-spacing: -0.075em;
        line-height: 0.82;
      }

      .receipt__kind {
        margin: 0;
        color: var(--orange);
        font: 800 11px/1.4 var(--mono);
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .receipt__note {
        max-width: 31ch;
        margin: 34px 0 0;
        font-family: var(--serif);
        font-size: clamp(25px, 3.5vw, 42px);
        font-style: italic;
        letter-spacing: -0.035em;
        line-height: 1.08;
      }

      .receipt__photo {
        width: 100%;
        height: 235px;
        margin-top: 34px;
        object-fit: cover;
        filter: saturate(0.82) contrast(1.05);
      }

      .receipt__footer {
        display: grid;
        margin-top: 42px;
        border-top: 1px solid var(--line);
        grid-template-columns: repeat(3, 1fr);
      }

      .receipt__footer div {
        padding: 16px 14px 0 0;
        font: 700 9px/1.45 var(--mono);
        text-transform: uppercase;
      }

      .receipt__footer strong {
        display: block;
        margin-top: 7px;
        font-family: var(--sans);
        font-size: 15px;
        letter-spacing: -0.02em;
        text-transform: none;
      }

      .receipt-actions {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(38px, 6vw, 78px) clamp(22px, 4vw, 56px);
        background: var(--navy);
        color: var(--white);
      }

      .receipt-actions h3 {
        margin: 17px 0 24px;
        color: var(--yellow);
        font-family: var(--serif);
        font-size: clamp(38px, 4.5vw, 66px);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.045em;
        line-height: 0.96;
      }

      .receipt-actions p {
        max-width: 36ch;
        color: rgba(255, 253, 245, 0.7);
        line-height: 1.5;
      }

      .action-stack {
        display: grid;
        gap: 10px;
        margin-top: 34px;
      }

      .action-button,
      .action-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 52px;
        border: 1px solid rgba(255, 255, 255, 0.38);
        padding: 0 16px;
        background: transparent;
        color: var(--white);
        font: 750 10px/1 var(--mono);
        letter-spacing: 0.05em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .action-button:hover,
      .action-link:hover {
        background: var(--white);
        color: var(--navy);
      }

      .backstage {
        display: grid;
        grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
        border-top: 1px solid var(--line);
        background: var(--paper);
      }

      .backstage__label,
      .backstage__copy {
        padding: clamp(40px, 7vw, 92px) clamp(18px, 5vw, 72px);
      }

      .backstage__label {
        border-right: 1px solid var(--line);
      }

      .backstage__label strong {
        display: block;
        max-width: 9ch;
        margin-top: 16px;
        font-size: clamp(36px, 5vw, 68px);
        letter-spacing: -0.06em;
        line-height: 0.9;
      }

      .backstage__copy h2 {
        max-width: 16ch;
        margin: 0;
        font-size: clamp(40px, 5.5vw, 76px);
        letter-spacing: -0.065em;
        line-height: 0.9;
      }

      .backstage__copy p {
        max-width: 56ch;
        margin: 26px 0 0;
        font-size: 18px;
        line-height: 1.48;
      }

      .story-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 32px;
      }

      .story-links a {
        border-bottom: 2px solid var(--ink);
        padding: 10px 0 7px;
        font: 800 10px/1 var(--mono);
        letter-spacing: 0.05em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .story-links a + a {
        margin-left: 22px;
      }

      .prototype-note {
        padding: 16px clamp(18px, 5vw, 72px);
        background: var(--orange);
        color: var(--white);
        font: 750 9px/1.4 var(--mono);
        letter-spacing: 0.08em;
        text-align: center;
        text-transform: uppercase;
      }

      @media (max-width: 900px) {
        .topbar {
          grid-template-columns: 1fr auto;
        }

        .topbar__date {
          display: none;
        }

        .intro,
        .prompt-grid,
        .observe,
        .receipt-stage,
        .backstage {
          grid-template-columns: 1fr;
        }

        .intro {
          min-height: 0;
        }

        .intro__copy {
          min-height: 680px;
        }

        .intro__visual {
          height: 72svh;
          min-height: 72svh;
        }

        .field__head {
          grid-template-columns: 1fr;
        }

        .field__label {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .timer-panel {
          min-height: 480px;
          align-items: center;
          text-align: center;
        }

        .found {
          position: fixed;
          z-index: 70;
          right: 18px;
          bottom: 18px;
          left: 18px;
          width: auto;
          box-shadow: 7px 7px 0 var(--orange);
        }

        .observe__aside {
          min-height: 480px;
        }

        .receipt-actions {
          min-height: 520px;
        }

        .backstage__label {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }
      }

      @media (max-width: 560px) {
        .topbar > * {
          padding: 0 14px;
        }

        .intro__copy {
          min-height: calc(100svh - 58px);
        }

        .intro h1 {
          font-size: clamp(58px, 20vw, 88px);
        }

        .intro__visual {
          height: 64svh;
          min-height: 64svh;
        }

        .visual-caption {
          grid-template-columns: 1fr;
          gap: 5px;
        }

        .field__question h2 {
          font-size: 52px;
        }

        .checklist {
          padding-bottom: 60px;
        }

        .receipt-wrap {
          overflow: hidden;
          padding: 20px 16px 40px;
        }

        .receipt {
          min-height: 680px;
          box-shadow: 9px 9px 0 var(--blue);
        }

        .receipt__footer {
          grid-template-columns: 1fr;
        }

        .receipt__footer div + div {
          border-top: 1px solid var(--line);
        }

        .story-links {
          align-items: flex-start;
          flex-direction: column;
        }

        .story-links a + a {
          margin-left: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to today’s invitation</a>

    <header class="topbar">
      <a class="topbar__brand" href="https://pointcast.xyz/">PointCast</a>
      <span class="topbar__live"><i class="topbar__dot" aria-hidden="true"></i> Field · Observation 01</span>
      <span class="topbar__date" data-today>Thursday · July 30</span>
    </header>

    <main id="main">
      <section class="intro" data-stage="intro">
        <div class="intro__copy">
          <div>
            <p class="eyebrow">Today’s invitation · 90 seconds · wherever you are</p>
            <h1>Find the seat <em>nobody designed.</em></h1>
            <p class="intro__dek">
              Look for something that was not sold as furniture, but quietly
              gives a person permission to stop.
            </p>
          </div>

          <div class="intro__action">
            <button class="primary" type="button" data-begin>
              <span>Take the field prompt</span>
              <span aria-hidden="true">↘</span>
            </button>
            <div class="intro__promise">
              <span>No account</span>
              <span>No feed</span>
              <span>One observation</span>
            </div>
          </div>
        </div>

        <div class="intro__visual" aria-label="Illustrated Beach Commons field scene">
          <img
            src="/beach-commons/v17/assets/poster-01.png"
            alt="An illustrated public science fair beside the beach, with small structures, visitors, dunes, and the Pacific."
          />
          <div class="stamp" aria-hidden="true">
            <div>
              <strong>90</strong>
              <span>seconds<br />outside the feed</span>
            </div>
          </div>
          <div class="visual-caption">
            <span>Beach Commons question desk · PointCast Field</span>
            <span>The article is backstage</span>
          </div>
        </div>
      </section>

      <section class="field" data-stage="field" hidden>
        <div class="prompt-grid">
          <div class="timer-panel">
            <div>
              <p class="eyebrow">Field time remaining</p>
              <div class="timer" role="timer" aria-live="polite">
                <div>
                  <span class="timer__number" data-timer>90</span>
                  <span class="timer__unit">seconds</span>
                </div>
              </div>
            </div>
            <p class="timer-panel__note">
              You do not need to travel to the beach. A curb, planter edge,
              loading dock, low wall, warm step, or patch of shade can answer.
            </p>
          </div>

          <div class="checklist">
            <p class="eyebrow">The assignment · look, don’t scroll</p>
            <h3>What makes an object become a place?</h3>
            <ol class="conditions">
              <li>It is outdoors or part of shared everyday space.</li>
              <li>It was not primarily introduced as a chair.</li>
              <li>Its shape, view, shade, or convenience invites a body.</li>
            </ol>
            <button class="found" type="button" data-found>I found one →</button>
          </div>
        </div>
      </section>

      <section class="observe" data-stage="observe" hidden>
        <form class="observe__form" data-observation-form>
          <p class="eyebrow">Your tiny field note</p>
          <h2>What gave it permission?</h2>

          <fieldset>
            <legend>Choose the strongest quality</legend>
            <div class="chips">
              <label class="chip">
                <input type="radio" name="quality" value="shade" checked />
                <span>Shade</span>
              </label>
              <label class="chip">
                <input type="radio" name="quality" value="view" />
                <span>A view</span>
              </label>
              <label class="chip">
                <input type="radio" name="quality" value="shape" />
                <span>The right shape</span>
              </label>
              <label class="chip">
                <input type="radio" name="quality" value="convenience" />
                <span>Convenience</span>
              </label>
              <label class="chip">
                <input type="radio" name="quality" value="evidence" />
                <span>Evidence of others</span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Where did you notice it?</legend>
            <div class="chips">
              <label class="chip">
                <input type="radio" name="place" value="near the water" checked />
                <span>Near the water</span>
              </label>
              <label class="chip">
                <input type="radio" name="place" value="on my block" />
                <span>On my block</span>
              </label>
              <label class="chip">
                <input type="radio" name="place" value="between places" />
                <span>Between places</span>
              </label>
              <label class="chip">
                <input type="radio" name="place" value="somewhere else" />
                <span>Somewhere else</span>
              </label>
            </div>
          </fieldset>

          <label class="field-label" for="field-note">One sentence, if it wants one</label>
          <div class="note-wrap">
            <textarea
              id="field-note"
              name="note"
              maxlength="120"
              placeholder="The sun-warmed wall became a bench exactly where the bike path meets the view."
            ></textarea>
            <span class="count"><span data-count>0</span>/120</span>
          </div>

          <label class="photo">
            <input type="file" accept="image/*" capture="environment" data-photo />
            <span>
              <strong data-photo-label>Add a photograph — optional</strong>
              <small>Private to this browser · nothing uploads</small>
            </span>
          </label>
          <img class="photo-preview" data-photo-preview alt="Preview of your field observation" hidden />

          <button class="make-receipt" type="submit">Make my field receipt →</button>
        </form>

        <aside class="observe__aside">
          <div>
            <p class="eyebrow">Why this counts</p>
            <blockquote>“Contribution is visible without requiring an account.”</blockquote>
            <p>
              The article carries the argument. Your brief act supplies the
              world. Neither needs to impersonate the other.
            </p>
          </div>
          <div class="privacy">
            On-device boundary · your choices remain in this browser · no
            location, image, or identity is transmitted
          </div>
        </aside>
      </section>

      <section class="receipt-stage" data-stage="receipt" hidden>
        <div class="receipt-wrap">
          <article class="receipt" aria-labelledby="receipt-title">
            <div class="receipt__top">
              <span>PointCast Field</span>
              <span>Field receipt · 001</span>
            </div>
            <h2 id="receipt-title">An unofficial seat.</h2>
            <p class="receipt__kind" data-receipt-kind>Made by shade · near the water</p>
            <p class="receipt__note" data-receipt-note>
              Someone could choose to pause here.
            </p>
            <img class="receipt__photo" data-receipt-photo alt="Your unofficial seat observation" hidden />
            <div class="receipt__footer">
              <div>
                Observed
                <strong data-receipt-date>July 30, 2026</strong>
              </div>
              <div>
                Attention spent
                <strong data-receipt-time>90 seconds</strong>
              </div>
              <div>
                Next question
                <strong>Does comfort appear before permission?</strong>
              </div>
            </div>
          </article>
        </div>

        <aside class="receipt-actions">
          <div>
            <p class="eyebrow">Something changed because you came</p>
            <h3>You turned an object into evidence.</h3>
            <p>
              In a live edition, many tiny receipts would become the next
              PointCast story: a public atlas of where everyday comfort
              appears without a plan.
            </p>
            <div class="action-stack">
              <button class="action-button" type="button" data-share>
                <span>Share the observation</span><span>↗</span>
              </button>
              <button class="action-button" type="button" data-again>
                <span>Notice another</span><span>↺</span>
              </button>
              <a class="action-link" href="https://pointcast.xyz/beach-commons/v16">
                <span>Read the field study</span><span>15 min ↗</span>
              </a>
            </div>
          </div>
          <div class="privacy" data-share-status aria-live="polite">
            The long story is optional. Your act already counts.
          </div>
        </aside>
      </section>

      <section class="backstage" data-backstage>
        <div class="backstage__label">
          <p class="eyebrow">Backstage · the world model</p>
          <strong>For anyone who wants the whole thought.</strong>
        </div>
        <div class="backstage__copy">
          <h2>The article is the receipt, not the invitation.</h2>
          <p>
            Seventeen Beach Commons editions supply the reporting, voice,
            constraints, local questions, and public imagination behind this
            ninety-second act. PointCast Field lets somebody touch that
            intelligence before asking them to read it.
          </p>
          <div class="story-links">
            <a href="https://pointcast.xyz/beach-commons/v16">The Billion Little New Yorkers ↗</a>
            <a href="https://pointcast.xyz/beach-commons/v17">Ask the Beach ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="prototype-note">
      PointCast Field · live invitation · private field receipt · no public count
    </footer>

    <script>
      (() => {
        const stages = Array.from(document.querySelectorAll("[data-stage]"));
        const backstage = document.querySelector("[data-backstage]");
        const timerOutput = document.querySelector("[data-timer]");
        const note = document.querySelector("#field-note");
        const count = document.querySelector("[data-count]");
        const form = document.querySelector("[data-observation-form]");
        const photo = document.querySelector("[data-photo]");
        const photoLabel = document.querySelector("[data-photo-label]");
        const photoPreview = document.querySelector("[data-photo-preview]");
        const receiptPhoto = document.querySelector("[data-receipt-photo]");
        const shareStatus = document.querySelector("[data-share-status]");
        let timerId = null;
        let secondsLeft = 90;
        let photoUrl = "";

        const today = new Date();
        const longDate = new Intl.DateTimeFormat("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
        }).format(today);
        const topDate = new Intl.DateTimeFormat("en-US", {
          weekday: "long",
          month: "long",
          day: "numeric",
        }).format(today);
        document.querySelector("[data-today]").textContent = topDate;
        document.querySelector("[data-receipt-date]").textContent = longDate;

        function showStage(name) {
          stages.forEach((stage) => {
            stage.hidden = stage.getAttribute("data-stage") !== name;
          });
          backstage.hidden = name !== "intro";
          window.scrollTo({ top: 0, behavior: "auto" });
        }

        function startTimer() {
          secondsLeft = 90;
          timerOutput.textContent = String(secondsLeft);
          window.clearInterval(timerId);
          timerId = window.setInterval(() => {
            secondsLeft = Math.max(0, secondsLeft - 1);
            timerOutput.textContent = String(secondsLeft);
            if (secondsLeft === 0) {
              window.clearInterval(timerId);
              document.querySelector("[data-found]").textContent = "Time — record what you noticed →";
            }
          }, 1000);
        }

        function clearPhoto() {
          if (photoUrl) URL.revokeObjectURL(photoUrl);
          photoUrl = "";
          photo.value = "";
          photoPreview.hidden = true;
          photoPreview.removeAttribute("src");
          receiptPhoto.hidden = true;
          receiptPhoto.removeAttribute("src");
          photoLabel.textContent = "Add a photograph — optional";
        }

        document.querySelector("[data-begin]").addEventListener("click", () => {
          showStage("field");
          startTimer();
        });

        document.querySelector("[data-found]").addEventListener("click", () => {
          window.clearInterval(timerId);
          showStage("observe");
        });

        note.addEventListener("input", () => {
          count.textContent = String(note.value.length);
        });

        photo.addEventListener("change", () => {
          const file = photo.files && photo.files[0];
          if (!file) {
            clearPhoto();
            return;
          }
          if (photoUrl) URL.revokeObjectURL(photoUrl);
          photoUrl = URL.createObjectURL(file);
          photoPreview.src = photoUrl;
          photoPreview.hidden = false;
          photoLabel.textContent = file.name;
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const quality = String(data.get("quality") || "shape");
          const place = String(data.get("place") || "somewhere nearby");
          const noteValue = String(data.get("note") || "").trim();
          const elapsed = Math.max(1, 90 - secondsLeft);
          const qualityLabels = {
            shade: "shade",
            view: "a view",
            shape: "the right shape",
            convenience: "convenience",
            evidence: "evidence of others",
          };

          document.querySelector("[data-receipt-kind]").textContent =
            `Made by ${qualityLabels[quality] || quality} · ${place}`;
          document.querySelector("[data-receipt-note]").textContent =
            noteValue || "Someone could choose to pause here.";
          document.querySelector("[data-receipt-time]").textContent =
            `${elapsed} ${elapsed === 1 ? "second" : "seconds"}`;

          if (photoUrl) {
            receiptPhoto.src = photoUrl;
            receiptPhoto.hidden = false;
          }

          try {
            localStorage.setItem(
              "pointcast-field-observation-v1",
              JSON.stringify({ quality, place, note: noteValue, elapsed, date: today.toISOString() }),
            );
          } catch {}

          showStage("receipt");
        });

        document.querySelector("[data-again]").addEventListener("click", () => {
          form.reset();
          note.value = "";
          count.textContent = "0";
          clearPhoto();
          document.querySelector("[data-found]").textContent = "I found one →";
          shareStatus.textContent = "The long story is optional. Your act already counts.";
          showStage("field");
          startTimer();
        });

        document.querySelector("[data-share]").addEventListener("click", async () => {
          const kind = document.querySelector("[data-receipt-kind]").textContent;
          const noteText = document.querySelector("[data-receipt-note]").textContent;
          const text = `POINTCAST FIELD · FIELD RECEIPT 001\nAn unofficial seat — ${kind}.\n${noteText}\n\nToday’s question: Does comfort appear before permission?`;
          try {
            if (navigator.share) {
              await navigator.share({ title: "PointCast Field · Field Receipt 001", text });
              shareStatus.textContent = "Observation shared.";
            } else {
              await navigator.clipboard.writeText(text);
              shareStatus.textContent = "Field receipt copied to your clipboard.";
            }
          } catch (error) {
            if (error && error.name !== "AbortError") {
              shareStatus.textContent = "Sharing was unavailable. Your receipt is still here.";
            }
          }
        });
      })();
    </script>
  </body>
</html>
