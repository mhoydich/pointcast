const bucketLabels: Record<Bucket, string> = {
  pop: 'POP CULTURE',
  socal: 'SO-CAL',
  '80s': '80s · TRAPPER · ATARI · BBS',
  coleco: 'COLECOVISION',
  intelli: 'INTELLIVISION',
};

const bucketCounts: Record<Bucket, number> = posters.reduce(
  (acc, p) => ({ ...acc, [p.bucket]: (acc[p.bucket] ?? 0) + 1 }),
  { pop: 0, socal: 0, '80s': 0, coleco: 0, intelli: 0 } as Record<Bucket, number>,
);
---

<BlockLayout title={title} description={description} image="/tribute-posters/01-desert-spaceport-cantina.png" jsonLd={jsonLd}>
  <main class="tp" id="tp-main">

    <header class="tp__header">
      <div class="tp__chrome">
        <span>TRIBUTE POSTERS</span>
        <span class="tp__chrome-sep">·</span>
        <span>{posters.length}</span>
        <span class="tp__chrome-sep">·</span>
        <span>EL SEGUNDO</span>
      </div>
      <h1 class="tp__title">TRIBUTE POSTERS</h1>
      <p class="tp__tagline">small house. coffee pot always on. seventy posters on the wall.</p>

      <div class="tp__filters" role="tablist" aria-label="Filter by bucket">
        <button class="tp__filter is-active" type="button" data-filter="all">
          ALL <span class="tp__filter-count">{posters.length}</span>
        </button>
        {(Object.keys(bucketLabels) as Bucket[]).map((b) => (
          <button class="tp__filter" type="button" data-filter={b}>
            {bucketLabels[b]} <span class="tp__filter-count">{bucketCounts[b]}</span>
          </button>
        ))}
      </div>
    </header>

    <section class="tp__grid" id="tp-grid">
      {posters.map((p) => (
        <button
          class="tp__cell"
          type="button"
          data-bucket={p.bucket}
          data-id={p.id}
          data-slug={p.slug}
          data-title={p.title}
          aria-label={`${p.id} — ${p.title}`}
        >
          <img
            class="tp__cell-img"
            src={`/tribute-posters/${p.id}-${p.slug}.png`}
            alt={`PointCast tribute poster ${p.id}: ${p.title}`}
            loading="lazy"
            decoding="async"
            width="1254"
            height="1254"
          />
          <span class="tp__cell-id">{p.id}</span>
          <span class="tp__cell-title">{p.title}</span>
        </button>
      ))}
    </section>

    <footer class="tp__footer">
      <p class="tp__footer-line">
        generated 2026-05-05 with codex + image_gen · 70/70 saved · 0 reframed · 0 failed
      </p>
      <p class="tp__footer-line tp__footer-line--dim">
        click any poster to enlarge · press esc to close
      </p>
    </footer>
  </main>

  <div class="tp__lightbox" id="tp-lightbox" role="dialog" aria-modal="true" aria-hidden="true" hidden>
    <button class="tp__lightbox-close" id="tp-close" aria-label="Close">×</button>
    <button class="tp__lightbox-nav tp__lightbox-nav--prev" id="tp-prev" aria-label="Previous">‹</button>
    <figure class="tp__lightbox-figure">
      <img class="tp__lightbox-img" id="tp-lightbox-img" alt="" />
      <figcaption class="tp__lightbox-cap" id="tp-lightbox-cap">— —</figcaption>
    </figure>
    <button class="tp__lightbox-nav tp__lightbox-nav--next" id="tp-next" aria-label="Next">›</button>
  </div>
</BlockLayout>

<style is:global>
  body:has(#tp-main) { background: #0c0410; }
  .tp {
    --tp-velvet: #1a0820;
    --tp-velvet-deep: #0c0410;
    --tp-brass: #d4a437;
    --tp-brass-deep: #6b4d12;
    --tp-flame: #f6c15e;
    --tp-ink-light: #f4e7c8;
    --tp-ink-mid: #c9b78c;
    --tp-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--tp-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.08), transparent 55%),
      linear-gradient(180deg, var(--tp-velvet) 0%, var(--tp-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }

  .tp__header { text-align: center; padding: clamp(12px, 1.5vh, 24px) 0 clamp(20px, 3vh, 32px); }
  .tp__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--tp-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--tp-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .tp__chrome-sep { color: var(--tp-brass-deep); }

  .tp__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 76px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--tp-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--tp-velvet-deep);
  }
  .tp__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--tp-ink-mid);
  }

  .tp__filters {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 8px; margin: clamp(16px, 2vh, 24px) auto 0; max-width: 920px;
  }
  .tp__filter {
    appearance: none; cursor: pointer;
    padding: 8px 14px; border: 1px solid var(--tp-brass-deep);
    border-radius: 999px; background: rgba(0, 0, 0, 0.4);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--tp-ink-mid);
    transition: color 120ms, border-color 120ms, background 120ms;
  }
  .tp__filter:hover { color: var(--tp-flame); border-color: var(--tp-brass); }
  .tp__filter.is-active {
    color: var(--tp-velvet-deep);
    background: linear-gradient(180deg, var(--tp-brass) 0%, oklch(0.62 0.18 60) 100%);
    border-color: var(--tp-brass);
  }
  .tp__filter-count {
    display: inline-block; margin-left: 6px;
    padding: 1px 7px; border-radius: 999px;
    background: rgba(0, 0, 0, 0.35); color: var(--tp-flame);
    font-size: 10px;
  }
  .tp__filter.is-active .tp__filter-count { background: var(--tp-velvet-deep); color: var(--tp-flame); }

  .tp__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    max-width: 1180px;
    margin: clamp(16px, 2vh, 24px) auto 0;
  }
  @media (max-width: 1100px) { .tp__grid { grid-template-columns: repeat(5, 1fr); } }
  @media (max-width: 760px) { .tp__grid { grid-template-columns: repeat(3, 1fr); gap: 6px; } }
  @media (max-width: 460px) { .tp__grid { grid-template-columns: repeat(2, 1fr); gap: 5px; } }

  .tp__cell {
    appearance: none; border: 0; cursor: pointer; padding: 0;
    position: relative; aspect-ratio: 1;
    background: var(--tp-velvet-deep);
    overflow: hidden;
    border: 1.5px solid rgba(212, 164, 55, 0.20);
    transition: transform 200ms, box-shadow 200ms, border-color 200ms;
  }
  .tp__cell:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px rgba(212, 164, 55, 0.35);
    border-color: var(--tp-brass);
    z-index: 2;
  }
  .tp__cell.is-hidden { display: none; }
  .tp__cell-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    image-rendering: pixelated;
  }
  .tp__cell-id {
    position: absolute; top: 4px; left: 4px;
    padding: 2px 6px; border-radius: 4px;
    background: rgba(0, 0, 0, 0.7); color: var(--tp-flame);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
    pointer-events: none;
  }
  .tp__cell-title {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 6px 8px;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.75) 60%);
    color: var(--tp-ink-light);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px; letter-spacing: 0.04em;
    text-align: left;
    pointer-events: none;
    opacity: 0; transition: opacity 200ms;
  }
  .tp__cell:hover .tp__cell-title { opacity: 1; }

  .tp__footer { text-align: center; padding: clamp(28px, 4vh, 48px) 0 0; }
  .tp__footer-line {
    margin: 4px 0; font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--tp-ink-mid);
  }
  .tp__footer-line--dim { color: var(--tp-ink-dim); }

  /* Lightbox */
  .tp__lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: none; align-items: center; justify-content: center;
    background: rgba(8, 4, 16, 0.94);
    padding: clamp(16px, 3vw, 48px);
  }
  .tp__lightbox.is-open { display: flex; }
  .tp__lightbox-figure {
    margin: 0; max-width: min(94vw, 1100px); max-height: 88vh;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .tp__lightbox-img {
    max-width: 100%; max-height: calc(88vh - 60px);
    border: 2px solid var(--tp-brass); border-radius: 4px;
    box-shadow: 0 0 60px rgba(212, 164, 55, 0.25);
    image-rendering: pixelated;
  }
  .tp__lightbox-cap {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--tp-flame);
  }
  .tp__lightbox-close, .tp__lightbox-nav {
    position: absolute; appearance: none; cursor: pointer; border: 0;
    background: rgba(0, 0, 0, 0.5); color: var(--tp-flame);
    width: 44px; height: 44px; border-radius: 999px;
    font-size: 28px; line-height: 1;
    transition: background 120ms, color 120ms;
  }
  .tp__lightbox-close:hover, .tp__lightbox-nav:hover { background: var(--tp-brass); color: var(--tp-velvet-deep); }
  .tp__lightbox-close { top: 16px; right: 16px; }
  .tp__lightbox-nav--prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .tp__lightbox-nav--next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>

<script>
  const grid = document.getElementById('tp-grid');
  const cells = Array.from(grid?.querySelectorAll('.tp__cell') ?? []) as HTMLButtonElement[];
  const filterBtns = Array.from(document.querySelectorAll('.tp__filter')) as HTMLButtonElement[];
  const lightbox = document.getElementById('tp-lightbox') as HTMLDivElement | null;
  const lbImg = document.getElementById('tp-lightbox-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('tp-lightbox-cap');
  const lbClose = document.getElementById('tp-close');
  const lbPrev = document.getElementById('tp-prev');
  const lbNext = document.getElementById('tp-next');

  let currentIdx = -1;
  let visibleCells: HTMLButtonElement[] = cells.slice();

  function applyFilter(filter: string) {
    cells.forEach((c) => {
      const match = filter === 'all' || c.dataset.bucket === filter;
      c.classList.toggle('is-hidden', !match);
    });
    visibleCells = cells.filter((c) => !c.classList.contains('is-hidden'));
    filterBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.filter === filter));
  }

  filterBtns.forEach((b) => {
    b.addEventListener('click', () => applyFilter(b.dataset.filter ?? 'all'));
  });

  function openAt(idx: number) {
    if (idx < 0 || idx >= visibleCells.length || !lbImg || !lbCap || !lightbox) return;
    currentIdx = idx;
    const cell = visibleCells[idx];
    const id = cell.dataset.id ?? '';
    const slug = cell.dataset.slug ?? '';
    const title = cell.dataset.title ?? '';
    lbImg.src = `/tribute-posters/${id}-${slug}.png`;
    lbImg.alt = `PointCast tribute poster ${id}: ${title}`;
    lbCap.textContent = `#${id} · ${title}`;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.removeAttribute('hidden');
  }

  function closeLb() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.setAttribute('hidden', '');
    currentIdx = -1;
  }

  cells.forEach((cell) => {
    cell.addEventListener('click', () => {
      const idx = visibleCells.indexOf(cell);
      openAt(idx);
    });
  });

  lbClose?.addEventListener('click', closeLb);
  lbPrev?.addEventListener('click', () => openAt((currentIdx - 1 + visibleCells.length) % visibleCells.length));
  lbNext?.addEventListener('click', () => openAt((currentIdx + 1) % visibleCells.length));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLb(); });

  document.addEventListener('keydown', (e) => {
    if (currentIdx < 0) return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowLeft') openAt((currentIdx - 1 + visibleCells.length) % visibleCells.length);
    else if (e.key === 'ArrowRight') openAt((currentIdx + 1) % visibleCells.length);
  });
</script>
