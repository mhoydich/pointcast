---
/**
 * /tribute-posters — A wall of 70 PointCast tribute posters.
 *
 * Mike: "use the chatgpt and manus image generators … create pointcast
 * tribute posters, 20 pop culture, 10 southern california, 20 80s mead
 * trapper keeper atari, bbs, 16 coleco vision, 4 intellivision."
 *
 * Codex generated all 70 via image_gen (gpt-image-1) at 1254×1254 PNG,
 * matching a single aesthetic: chunky pixel rendering, saturated retro
 * palette, POINTCAST arcade-marquee wordmark, "small house. coffee pot
 * always on." tagline, El Segundo skyline strip across the bottom.
 *
 * This room shows them all in a grid. Click any to open a lightbox.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Tribute Posters · PointCast';
const description =
  '70 PointCast tribute posters across pop culture, Southern California, 80s Trapper Keeper / Atari / BBS, ColecoVision, and Intellivision. Click any to open.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'PointCast Tribute Posters',
  url: 'https://pointcast.xyz/tribute-posters',
  description,
};

type Bucket = 'pop' | 'socal' | '80s' | 'coleco' | 'intelli';
type Poster = { id: string; slug: string; bucket: Bucket; title: string };

const posters: Poster[] = [
