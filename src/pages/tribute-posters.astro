  { id: '19', slug: 'maximalist-talking-room', bucket: 'pop', title: 'Maximalist Talking Room' },
  { id: '20', slug: 'bathrobe-bowling-alley', bucket: 'pop', title: 'Bathrobe Bowling Alley' },
