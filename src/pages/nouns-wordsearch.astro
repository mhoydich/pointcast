---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Nouns Wordsearch';
const description = 'Drag across a Win95 letter grid to find Nouns arcade words on mobile.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/nouns-wordsearch', name: title, description, url: 'https://pointcast.xyz/nouns-wordsearch' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-wordsearch>
    <section class="window" aria-labelledby="wordsearch-title">
      <header class="titlebar"><span>Nouns Wordsearch</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Nouns Wordsearch menu">
        <button type="button" data-new>Game</button>
        <a href="/noggle-lights-out">Lights</a>
        <a href="/pixel-pipes">Pipes</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">DRAG · WORDS · GRID</p><h1 id="wordsearch-title">Find the words.</h1><p>Drag in a straight line across letters. Reverse directions count.</p></div>
        <div class="meters"><span>Found <strong data-found>0/8</strong></span><span>Time <strong data-time>0:00</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="play">
        <div class="boardwrap">
          <div class="lettergrid" data-grid aria-label="Nouns wordsearch grid"></div>
          <div class="overlay" data-overlay hidden>
            <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="wordsearch-dialog-title">
              <header class="dlgbar"><span id="wordsearch-dialog-title" data-dialog-title>Cleared</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
              <div class="dlgbody"><p data-dialog-message>All words found.</p><button type="button" data-restart>New Game</button></div>
            </div>
          </div>
        </div>
        <aside class="wordlist" aria-label="Words to find" data-wordlist></aside>
      </div>
      <footer class="status" data-status aria-live="polite">Drag across NOUNS to start.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-wordsearch]');
  if (root) {
    const gridEl = root.querySelector<HTMLElement>('[data-grid]');
    const wordListEl = root.querySelector<HTMLElement>('[data-wordlist]');
    const foundEl = root.querySelector<HTMLElement>('[data-found]');
    const timeEl = root.querySelector<HTMLElement>('[data-time]');
    const bestEl = root.querySelector<HTMLElement>('[data-best]');
    const statusEl = root.querySelector<HTMLElement>('[data-status]');
    const overlay = root.querySelector<HTMLElement>('[data-overlay]');
    const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
    const slug = 'nouns-wordsearch';
    const statsKey = 'pc:arcade:' + slug;
    const profileKey = 'pc:arcade:profile';
    const gameName = 'Words';
    const badge = 'wordsearch-sweep';
    const size = 7;
    const words = [
      { text: 'NOUNS', r: 0, c: 0, dr: 0, dc: 1 },
      { text: 'NOGGLE', r: 0, c: 0, dr: 1, dc: 0 },
      { text: 'ARCADE', r: 6, c: 1, dr: 0, dc: 1 },
      { text: 'PIXEL', r: 0, c: 6, dr: 1, dc: 0 },
      { text: 'TEZOS', r: 5, c: 2, dr: 0, dc: 1 },
      { text: 'BLOCK', r: 1, c: 1, dr: 1, dc: 0 },
      { text: 'CAST', r: 3, c: 2, dr: 0, dc: 1 },
      { text: 'DAO', r: 2, c: 4, dr: 1, dc: -1 },
    ];
    const filler = 'POINTCASTNOGGLESXYZ';
    let letters: string[][] = [];
    let cells: HTMLElement[] = [];
    let found = new Set<string>();
    let selected: HTMLElement[] = [];
    let dragging = false;
    let startTime = 0;
    let elapsed = 0;
    let raf = 0;
    let won = false;
    let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestTime: 0 }).bestTime || 0);

    function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
    function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
    function fmt(seconds: number) {
      const s = Math.max(0, Math.floor(seconds));
      return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    }
    function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
    function recordPlay(clear: boolean) {
      const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: 0 });
      if (!clear) stats.plays = Number(stats.plays || 0) + 1;
      if (clear) {
        stats.clears = Number(stats.clears || 0) + 1;
        const current = Math.max(1, Math.floor(elapsed));
        stats.bestTime = Number(stats.bestTime || 0) ? Math.min(Number(stats.bestTime), current) : current;
      }
      writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestTime: Number(stats.bestTime || 0) });
      const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
      profile.lastPlayed = gameName;
      if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
      if (clear) {
        profile.clears = Number(profile.clears || 0) + 1;
        profile.clearStreak = Number(profile.clearStreak || 0) + 1;
        profile.lastCleared = gameName;
        const earned = ['first-win', badge];
        if (profile.clearStreak >= 3) earned.push('three-game-streak');
        profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
      }
      writeJson(profileKey, profile);
      best = Number(stats.bestTime || best || 0);
    }
    function renderMeters() {
      if (foundEl) foundEl.textContent = found.size + '/' + words.length;
      if (timeEl) timeEl.textContent = fmt(elapsed);
      if (bestEl) bestEl.textContent = best ? fmt(best) : '--';
    }
    function placeWords() {
      letters = Array.from({ length: size }, () => Array(size).fill(''));
      for (const word of words) {
        for (let i = 0; i < word.text.length; i++) {
          letters[word.r + word.dr * i][word.c + word.dc * i] = word.text[i];
        }
      }
      let f = 0;
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (!letters[r][c]) letters[r][c] = filler[(f++ + r * 3 + c * 5) % filler.length];
        }
      }
    }
    function wordCells(word: string) {
      const spec = words.find((w) => w.text === word);
      if (!spec) return [];
      const out: HTMLElement[] = [];
      for (let i = 0; i < spec.text.length; i++) {
        const idx = (spec.r + spec.dr * i) * size + spec.c + spec.dc * i;
        if (cells[idx]) out.push(cells[idx]);
      }
      return out;
    }
    function build() {
      if (!gridEl || !wordListEl) return;
      gridEl.innerHTML = '';
      wordListEl.innerHTML = '';
      cells = [];
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'cell';
          cell.textContent = letters[r][c];
          cell.dataset.r = String(r);
          cell.dataset.c = String(c);
          gridEl.appendChild(cell);
          cells.push(cell);
        }
      }
      for (const word of words) {
        const item = document.createElement('span');
        item.textContent = word.text;
        item.dataset.word = word.text;
        wordListEl.appendChild(item);
      }
    }
    function clearSelection() {
      selected.forEach((cell) => cell.classList.remove('is-selected'));
      selected = [];
    }
    function addCell(cell: HTMLElement) {
      if (!cell.classList.contains('cell')) return;
      if (selected.includes(cell)) return;
      selected.push(cell);
      cell.classList.add('is-selected');
    }
    function cellFromPoint(x: number, y: number) {
      const el = document.elementFromPoint(x, y) as HTMLElement | null;
      return el?.closest('.cell') as HTMLElement | null;
    }
    function selectionWord() {
      return selected.map((cell) => cell.textContent || '').join('');
    }
    function isStraightLine() {
      if (selected.length < 2) return true;
      const coords = selected.map((cell) => [Number(cell.dataset.r), Number(cell.dataset.c)]);
      const dr = Math.sign(coords[1][0] - coords[0][0]);
      const dc = Math.sign(coords[1][1] - coords[0][1]);
      if (dr === 0 && dc === 0) return false;
      for (let i = 1; i < coords.length; i++) {
        if (coords[i][0] !== coords[0][0] + dr * i || coords[i][1] !== coords[0][1] + dc * i) return false;
      }
      return true;
    }
    function finishSelection() {
      const picked = selectionWord();
      const reversed = picked.split('').reverse().join('');
      const match = isStraightLine() ? words.find((word) => word.text === picked || word.text === reversed) : null;
      if (match && !found.has(match.text)) {
        found.add(match.text);
        const target = root.querySelector<HTMLElement>('[data-word="' + match.text + '"]');
        if (target) target.classList.add('is-found');
        wordCells(match.text).forEach((cell) => cell.classList.add('is-found'));
        setStatus('Found ' + match.text + '.');
        if (found.size === words.length) win();
      } else if (picked.length) {
        setStatus('No match for ' + picked + '.');
      }
      selected.forEach((cell) => cell.classList.remove('is-selected'));
      selected = [];
    }
    function win() {
      if (won) return;
      won = true;
      elapsed = (performance.now() - startTime) / 1000;
      recordPlay(true);
      renderMeters();
      setStatus('All words found in ' + fmt(elapsed) + '.');
      if (dialogMessage) dialogMessage.textContent = 'All words found in ' + fmt(elapsed) + '.';
      if (overlay) overlay.hidden = false;
    }
    function newGame() {
      cancelAnimationFrame(raf);
      placeWords();
      found = new Set();
      selected = [];
      dragging = false;
      won = false;
      elapsed = 0;
      startTime = performance.now();
      if (overlay) overlay.hidden = true;
      build();
      recordPlay(false);
      renderMeters();
      setStatus('Drag across a hidden word.');
      raf = requestAnimationFrame(loop);
    }
    function loop(now: number) {
      if (!won) elapsed = (now - startTime) / 1000;
      renderMeters();
      raf = requestAnimationFrame(loop);
    }
    gridEl?.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      const cell = (event.target as HTMLElement).closest('.cell') as HTMLElement | null;
      if (!cell) return;
      gridEl.setPointerCapture(event.pointerId);
      dragging = true;
      clearSelection();
      addCell(cell);
    });
    gridEl?.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      event.preventDefault();
      const cell = cellFromPoint(event.clientX, event.clientY);
      if (cell) addCell(cell);
    });
    gridEl?.addEventListener('pointerup', (event) => {
      if (!dragging) return;
      event.preventDefault();
      dragging = false;
      finishSelection();
    });
    gridEl?.addEventListener('pointercancel', () => {
      dragging = false;
      clearSelection();
    });
    root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
    root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else { startTime = performance.now() - elapsed * 1000; raf = requestAnimationFrame(loop); }
    });
    newGame();
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,820px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:44ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; flex-wrap:wrap; gap:6px; }
  .meters span { min-width:70px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 18px/1 "Courier New",monospace; color:#000080; }
  .play { display:grid; grid-template-columns:auto minmax(150px,1fr); gap:10px; align-items:start; padding:0 10px 10px; }
  .boardwrap { position:relative; width:min(calc(100vw - 36px),364px); }
  .lettergrid { display:grid; grid-template-columns:repeat(7,44px); gap:4px; width:max-content; max-width:100%; padding:4px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#9a9c8f; touch-action:none; user-select:none; -webkit-user-select:none; }
  .cell { width:44px; height:44px; display:grid; place-items:center; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; color:#000; font:700 20px/1 "Courier New",monospace; padding:0; }
  .cell.is-selected { background:#000080; color:#fff; }
  .cell.is-found { background:#ffffcc; color:#000080; box-shadow:inset 0 0 0 2px #ffff00; }
  .wordlist { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; }
  .wordlist span { min-height:34px; display:flex; align-items:center; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font:700 13px/1 "Courier New",monospace; }
  .wordlist span.is-found { color:#008000; text-decoration:line-through; background:#ffffcc; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 10px 10px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
  @media (max-width:720px) {
    .play { grid-template-columns:1fr; justify-items:center; }
    .wordlist { width:min(calc(100vw - 36px),364px); }
  }
</style>
