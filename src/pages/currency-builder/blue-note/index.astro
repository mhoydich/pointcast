---
/**
 * /currency-builder/blue-note/ — the KansasDAO Blue Note, back in
 * circulation: where it came from, the Series 1 note you earn with a
 * three-day streak, and the Blue Note Circle (passing a note to a friend).
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import { SERIES_ONE, noteFiles, serial } from '../../../lib/currency-builder/series-one.mjs';
import { MAX_PASSES_PER_DAY } from '../../../lib/network-points.mjs';
import { artFor } from '../../../data/currency-builder/rails-art.mjs';
import '../../../styles/currency-builder.css';

const blue = SERIES_ONE.notes.find((n) => n.id === 'blue');
const files = noteFiles(blue);
const art = artFor('blue-note');
const description = 'The KansasDAO Blue Note, back in circulation: a collectible Nouns Money note you earn with three check-ins in a row, and can pass to a friend once a day. No cash value.';

const lineage = [
  { when: 'Block 0702', href: '/b/0702', what: 'Blue Notes first proposed as Community Time Notes: edition-one collectible contribution receipts, not legal tender.' },
  { when: 'Block 0711', href: '/b/0711', what: 'The Enjoy. Money plan names the KansasDAO Blue Note as one of three Series 1 paper notes.' },
  { when: 'Series 1', href: '/currency-builder/series-1/#blue', what: 'The Blue Note is drawn and earned: every third day in a row you check in.' },
  { when: 'Blue Note Circle', href: '#circle', what: 'Next: pass a Blue Note you hold to a friend, one a day. Reserved, not live.' },
];
---
<BlockLayout title="Blue Note · Nouns Money · Currency Builder" description={description} image={files.front} imageAlt="The KansasDAO Blue Note, Nouns Money Series 1" themeColor="#e8edf6" immersive hideAds showNetworkStrip={false}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="blue-note" json="/currency-builder/series-1.json" />

      <section class="cb-hero" aria-labelledby="bn-title" style={`--accent:${blue.palette.accent}`}>
        <div>
          <p class="cb-kicker">KansasDAO · Nouns Money · Series 1</p>
          <h1 id="bn-title">The Blue Note<em>.</em><br />Back in circulation.</h1>
          <p class="cb-dek">Three days in a row earns one. Holding one turns your profile border cobalt. And soon you can hand one to a friend.</p>
          <div class="cb-actions">
            <a href="/currency-builder/series-1/#blue">The Series 1 note ↗</a>
            <a href="/points/">How points work ↗</a>
          </div>
          <p class="cb-disclose">A collectible mark. Never sold, bought, redeemed or traded for money, and not part of Good Feels or any cannabis program. Nouns art is CC0; not affiliated with or endorsed by Nouns DAO.</p>
        </div>
        <div class="bn-face"><img src={files.front} width="1200" height="600" alt={`Front of the ${blue.long}`} /></div>
      </section>

      <section class="cb-section" aria-labelledby="bn-line">
        <h2 id="bn-line">Where it came from</h2>
        <ol class="bn-lineage">
          {lineage.map((step) => <li><a href={step.href}>{step.when}</a><span>{step.what}</span></li>)}
        </ol>
      </section>

      <section class="cb-section" id="circle" aria-labelledby="bn-circle">
        <h2 id="bn-circle">The Blue Note Circle</h2>
        <p class="cb-dek" style="max-width:56ch">A note you earned can be passed on as a gift. It leaves your count and joins theirs, and both ledgers record it.</p>
        <ul class="bn-rules">
          <li><strong>One a day.</strong> Each member can pass {MAX_PASSES_PER_DAY} held note a day, to another member.</li>
          <li><strong>No points move.</strong> Passing writes a 0-point line on each side. The points you earned stay yours.</li>
          <li><strong>Both chains agree.</strong> Your line names who it went to; theirs names your line's id. Re-hash either and you can see the other.</li>
          <li><strong>Gifts only.</strong> Nothing is sold, bought or asked for in return. A pass can't be undone, so the sender is asked first.</li>
        </ul>
        <p class="cb-disclose">Reserved: the rules and the tests are in the open spec; passing is not switched on.</p>
      </section>

      {art.length > 0 && (
        <section class="cb-section" aria-labelledby="bn-art">
          <h2 id="bn-art">Art pass, November 9</h2>
          <div class="rails-art">
            {art.map((a) => <figure><img src={a.src} width={a.width} height={a.height} alt={a.alt} loading="lazy" /><figcaption>{a.caption}</figcaption></figure>)}
          </div>
        </section>
      )}

      <section class="cb-section" aria-labelledby="bn-back">
        <h2 id="bn-back">The back of the note</h2>
        <div class="cb-faces">
          <img src={files.back} width="1200" height="600" alt={`Back of the ${blue.long}: how it is earned`} loading="lazy" />
          <p class="cb-dek" style="max-width:40ch">{blue.how}<br /><span class="bn-serial">{serial(blue)} · Noun #{blue.nounId}</span></p>
        </div>
      </section>

      <footer class="cb-foot">
        <p>Rules: <a href="/points.json">points.json</a> · rails: <a href="/nouns-money/rails/">how the four layers fit</a> · edition: <a href="/currency-builder/series-1.json">series-1.json</a>.</p>
      </footer>
    </div>
  </div>
</BlockLayout>

<style>
  .bn-face img { width: 100%; height: auto; display: block; border: 1px solid var(--cb-line); box-shadow: 0 10px 28px rgba(15, 35, 71, 0.18); transform: rotate(-2deg); }
  .bn-lineage { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 2px solid var(--cb-ink); }
  .bn-lineage li { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--cb-line); }
  .bn-lineage a { font-family: var(--cb-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #1f4fa8; }
  .bn-rules { margin: 0; padding: 0 0 0 18px; display: grid; gap: 10px; max-width: 62ch; font-size: 17px; line-height: 1.5; }
  .bn-serial { font-family: var(--cb-mono); font-size: 13px; color: var(--cb-muted); }
  .rails-art { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .rails-art img { width: 100%; height: auto; display: block; border: 1px solid var(--cb-line); }
  .rails-art figcaption { font-size: 13px; color: var(--cb-muted); margin-top: 6px; }
  @media (max-width: 640px) { .bn-lineage li { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .bn-lineage a { color: #8fb0f0; } }
  :root[data-theme="dark"] .bn-lineage a { color: #8fb0f0; }
</style>
