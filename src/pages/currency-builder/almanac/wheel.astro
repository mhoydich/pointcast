---
// /currency-builder/almanac/wheel/ — The Almanac Wheel: spin the 52-week dial, pull a week's note, stamp the weeks you noticed, and tune KALM on the little radio.
// Built 2026-10-22 by Claude Code from the Almanac data. Audio is Web Audio,
// generated in the browser; the announcer is the browser's own speech voice.
import { ALMANAC, noteFiles } from '../../../lib/currency-builder/almanac.mjs';

const WEEKS = ALMANAC.currencies.map((e) => ({
  w: e.week, q: e.quarter, n: e.name, when: e.when, where: e.where, line: e.line, how: e.how,
  noun: e.nounId, src: e.source_title, url: e.source_url, img: noteFiles(e).front,
}));
const QUARTERS = ALMANAC.quarters.map((q) => ({ id: q.id, name: q.name, motto: q.motto, accent: q.palette.accent, accent2: q.palette.accent2 }));
const data = `const WEEKS=${JSON.stringify(WEEKS)};const QUARTERS=${JSON.stringify(QUARTERS)};`.replace(/</g, '\\u003c');
const url = 'https://pointcast.xyz/currency-builder/almanac/wheel/';
const description = "Spin a 52-week dial of the South Bay year and pull that week's Almanac note, with an AM radio companion: static, station idents, quarter soundbeds and a read-aloud announcer.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Almanac Wheel</title>
<meta name="description" content={description}>
<meta property="og:title" content='The Almanac Wheel'>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/images/og/currency-builder-almanac.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={url}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@500;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=DM+Mono:wght@400;500&display=swap">
<style is:global>
/* Reset the artifact skeleton gave this page. */
:root { padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
body { margin: 0; }
img { max-width: 100%; }
[hidden] { display: none !important; }

/* Layout: a tide-chart page. The year is a dial on the left that you spin; the week it lands on prints its note on the right. */
:root {
  --fog: #e6edee;        /* paper: marine-layer gray, a touch of sea-glass */
  --fog-2: #d6e1e3;
  --ink: #15303b;        /* harbor-chart navy */
  --ink-soft: #46606a;
  --brass: #b5832b;      /* dial pointer, stamps */
  --foam: #fbfdfd;
  --rain: #2f6f9f; --bloom: #7b52ab; --swell: #d26a1f; --wind: #9c3d2c;
  --display: "DynaPuff", "Comic Sans MS", "Trebuchet MS", system-ui, sans-serif;
  --body: "Literata", Georgia, "Times New Roman", serif;
  --mono: "DM Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --fog: #0f1d24; --fog-2: #18303a; --ink: #e2eef0; --ink-soft: #9db6bd; --brass: #e0ad55; --foam: #132730;
  --rain: #6aa9d6; --bloom: #b391dd; --swell: #f09a55; --wind: #e07a64; color-scheme: dark } }
:root[data-theme="dark"] {
  --fog: #0f1d24; --fog-2: #18303a; --ink: #e2eef0; --ink-soft: #9db6bd; --brass: #e0ad55; --foam: #132730;
  --rain: #6aa9d6; --bloom: #b391dd; --swell: #f09a55; --wind: #e07a64; color-scheme: dark }

* { box-sizing: border-box; }
body { background: var(--fog); color: var(--ink); font-family: var(--body); font-size: 17px; line-height: 1.55; }
.page { max-width: 1180px; margin: 0 auto; padding-block: 28px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.kicker { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); margin: 0; }
h1 { font-family: var(--display); font-weight: 700; font-size: clamp(40px, 7vw, 76px); line-height: .95; letter-spacing: -.01em; margin: 10px 0 12px; text-wrap: balance; }
h1 span { color: var(--brass); }
.dek { max-width: 58ch; margin: 0; color: var(--ink-soft); }
header { display: grid; gap: 4px; margin-bottom: 26px; }

.stage { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 36px; align-items: start; }
@media (max-width: 860px) { .stage { grid-template-columns: minmax(0, 1fr); } }

.dialbox { display: grid; gap: 14px; justify-items: center; }
.dial { width: 100%; max-width: 440px; aspect-ratio: 1; position: relative; }
.dial svg { width: 100%; height: 100%; display: block; }
#wheel { transform-origin: 50% 50%; }
#wheel .tick { cursor: pointer; }
#wheel .tick:focus-visible { outline: none; }
#wheel .tick:focus-visible path { stroke: var(--brass); stroke-width: 3; }
.pointer { fill: var(--brass); }
.hub-num { font-family: var(--display); font-weight: 700; fill: var(--ink); }
.hub-sub { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; fill: var(--ink-soft); text-transform: uppercase; }
.qlabel { font-family: var(--mono); font-size: 10.5px; letter-spacing: .18em; fill: var(--ink-soft); text-transform: uppercase; }

.controls { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
button { font: 500 14px/1 var(--mono); letter-spacing: .06em; color: var(--ink); background: var(--foam);
  border: 1.5px solid var(--ink); border-radius: 999px; padding: 12px 18px; cursor: pointer; }
button:hover { background: var(--fog-2); }
button:focus-visible { outline: 3px solid var(--brass); outline-offset: 3px; }
button.primary { background: var(--ink); color: var(--fog); }
button.primary:hover { filter: brightness(1.15); }

.note { display: grid; gap: 16px; min-width: 0; }
.notecard { background: var(--foam); border: 1px solid var(--fog-2); padding: 12px; box-shadow: 0 14px 30px -18px rgba(21,48,59,.45);
  transform: rotate(-1.2deg); transition: transform .5s cubic-bezier(.2,.8,.2,1); }
.notecard:hover { transform: rotate(0deg) translateY(-2px); }
.notecard > img { display: block; width: 100%; height: auto; }
.notecard.flip { animation: drop .55s cubic-bezier(.2,.8,.2,1); }
@keyframes drop { from { transform: rotate(-6deg) translateY(-18px); opacity: .25; } to { transform: rotate(-1.2deg); opacity: 1; } }
.meta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 20px; align-items: baseline; }
.meta h2 { font-family: var(--display); font-weight: 700; font-size: clamp(28px, 4vw, 40px); line-height: 1.05; margin: 0; text-wrap: balance; }
.meta .when { font-family: var(--mono); font-size: 13px; color: var(--ink-soft); text-align: right; }
.how { margin: 0; max-width: 62ch; }
.facts { display: flex; flex-wrap: wrap; gap: 8px 18px; font-family: var(--mono); font-size: 12.5px; color: var(--ink-soft); }
.facts a { color: inherit; }
.chip { display: inline-flex; align-items: center; gap: 7px; }
.chip i { width: 9px; height: 9px; border-radius: 50%; background: var(--q); display: inline-block; }

.stampbtn { justify-self: start; }
.stampbtn[aria-pressed="true"] { background: var(--brass); border-color: var(--brass); color: #1c1407; }

.year { margin-top: 44px; border-top: 1.5px solid var(--ink); padding-top: 18px; display: grid; gap: 12px; }
.year h3 { font-family: var(--display); font-weight: 500; font-size: 24px; margin: 0; }
.year p { margin: 0; color: var(--ink-soft); max-width: 62ch; }
.dots { display: grid; grid-template-columns: repeat(26, minmax(0, 1fr)); gap: 5px; max-width: 760px; }
@media (max-width: 560px) { .dots { grid-template-columns: repeat(13, minmax(0, 1fr)); } }
.dots button { aspect-ratio: 1; padding: 0; border-radius: 50%; border: 1.5px solid var(--q); background: transparent; font-size: 9px; color: var(--ink-soft); }
.dots button.got { background: var(--q); color: var(--foam); }
.dots button.on { outline: 2px solid var(--brass); outline-offset: 2px; }
.tally { font-family: var(--mono); font-size: 13px; }

/* The radio: a small bakelite set under the dial. */
.radio { width: 100%; max-width: 440px; display: grid; gap: 12px; padding: 16px; border: 1.5px solid var(--ink); border-radius: 18px;
  background: var(--foam); box-shadow: inset 0 0 0 4px var(--fog-2); }
.radio-face { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; }
.lamp { width: 14px; height: 14px; border-radius: 50%; background: var(--fog-2); border: 1.5px solid var(--ink-soft); transition: background .3s, box-shadow .3s; }
.lamp.on { background: #e8452c; border-color: #e8452c; box-shadow: 0 0 10px 2px rgba(232,69,44,.55); }
.call { font-family: var(--display); font-weight: 700; font-size: 18px; margin: 0; line-height: 1.1; }
.radio .sub { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-soft); margin: 2px 0 0; }
.freq { text-align: right; font-family: var(--mono); line-height: 1; }
.freq output { display: block; font-size: 28px; font-weight: 500; color: var(--brass); font-variant-numeric: tabular-nums; }
.freq span { font-size: 10px; letter-spacing: .14em; color: var(--ink-soft); }
.band { position: relative; height: 26px; border-radius: 6px; background:
  repeating-linear-gradient(90deg, var(--ink-soft) 0 1px, transparent 1px 5.5%), var(--fog-2); opacity: .9; }
.band i { position: absolute; top: -3px; bottom: -3px; width: 3px; border-radius: 2px; background: #e8452c; left: 50%; transition: left .5s cubic-bezier(.15,.85,.2,1); }
.radio-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
.radio-buttons button { padding: 10px 14px; font-size: 13px; }
.radio-buttons button[aria-pressed="true"] { background: var(--ink); color: var(--fog); }
.radio-note { margin: 0; font-family: var(--mono); font-size: 11.5px; color: var(--ink-soft); }
@media (prefers-reduced-motion: reduce) { .band i { transition: none; } }
footer { margin-top: 36px; font-size: 13px; color: var(--ink-soft); max-width: 70ch; }
footer a { color: inherit; }
@media (prefers-reduced-motion: reduce) { .notecard, .notecard.flip { animation: none; transition: none; } }
</style>
</head>
<body>
<div class="page">
  <header>
    <p class="kicker">Nouns Money · Currency Builder · Almanac</p>
    <h1>The Almanac <span>Wheel</span></h1>
    <p class="dek">Fifty-two notes, one for every week of the South Bay year. You can't buy one. You earn it by noticing: a meteor counted, a whale blow, a grunion night, the earliest sunset. Spin the year and see what it owes you.</p>
  </header>

  <section class="stage">
    <div class="dialbox">
      <div class="dial">
        <svg viewBox="0 0 440 440" role="img" aria-labelledby="dialTitle">
          <title id="dialTitle">A dial of the 52 weeks of the year, grouped into four quarters</title>
          <g id="wheel"></g>
          <path class="pointer" d="M220 6 L232 30 L208 30 Z"/>
          <circle cx="220" cy="220" r="78" fill="var(--foam)" stroke="var(--ink)" stroke-width="1.5"/>
          <text class="hub-sub" x="220" y="196" text-anchor="middle">week</text>
          <text id="hubNum" class="hub-num" x="220" y="252" text-anchor="middle" font-size="64">42</text>
          <text class="hub-sub" x="220" y="275" text-anchor="middle">of 52</text>
        </svg>
      </div>
      <div class="controls">
        <button id="spin" class="primary" type="button">Spin the year</button>
        <button id="today" type="button">This week</button>
        <button id="prev" type="button" aria-label="Previous week">◂</button>
        <button id="next" type="button" aria-label="Next week">▸</button>
      </div>
      <section class="radio" aria-labelledby="radioTitle">
        <div class="radio-face">
          <span id="lamp" class="lamp" aria-hidden="true"></span>
          <div class="radio-id">
            <p id="radioTitle" class="call">KALM · Almanac Radio</p>
            <p class="sub">El Segundo · a station for each week</p>
          </div>
          <div class="freq"><output id="freq" aria-live="off">1350</output><span>kHz AM</span></div>
        </div>
        <div class="band" aria-hidden="true"><i id="needle"></i></div>
        <div class="radio-buttons">
          <button id="power" type="button" aria-pressed="false">Turn the radio on</button>
          <button id="read" type="button">Read this week aloud</button>
          <button id="tour" type="button" aria-pressed="false">Play the year</button>
        </div>
        <p id="radioNote" class="radio-note">Sound starts when you press a button. Spinning the dial tunes across the band.</p>
      </section>
    </div>

    <article class="note" aria-live="polite">
      <div id="card" class="notecard"></div>
      <div class="meta">
        <h2 id="name"></h2>
        <div id="when" class="when"></div>
      </div>
      <p id="line" class="how" style="font-style:italic"></p>
      <p id="how" class="how"></p>
      <div class="facts">
        <span class="chip" id="qchip"><i></i><span></span></span>
        <span id="where"></span>
        <span id="noun"></span>
        <a id="src" href="#" target="_blank" rel="noopener"></a>
      </div>
      <button id="stamp" class="stampbtn" type="button" aria-pressed="false">I noticed it this year</button>
    </article>
  </section>

  <section class="year" aria-labelledby="yearTitle">
    <h3 id="yearTitle">Your year so far</h3>
    <p>Stamp a week when you've actually seen its sign. A full year is 52. Stamps stay in this browser only, and nobody keeps score but you.</p>
    <div class="dots" id="dots"></div>
    <div class="tally" id="tally"></div>
  </section>

  <footer>
    Design concepts from Currency Builder. Not legal tender, not for sale, no cash value. Notes are traded one for one and never sold. Wildlife comes first: fences, trails and closed seasons outrank any note. Dates are typical for Southern California and shift from year to year. Each Noun is an actual CC0 Noun drawn from its on-chain seed; not affiliated with Nouns DAO. All 52 notes: <a href="/currency-builder/almanac/">the Almanac</a>. Tune the whole band on <a href="/currency-builder/almanac/radio/">KALM Almanac Radio</a>.
  </footer>
</div>

<script is:inline set:html={data}></script>
<script is:inline>
(() => {
  const NS = 'http://www.w3.org/2000/svg';
  const qOf = (id) => QUARTERS.find((q) => q.id === id);
  const qVar = (id) => `var(--${id})`;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wheel = document.getElementById('wheel');
  const C = 220, R1 = 108, R2 = 196;
  const step = 360 / 52;
  let current = 1, rotation = 0, spinning = false;

  const pt = (r, deg) => { const a = (deg - 90) * Math.PI / 180; return [C + r * Math.cos(a), C + r * Math.sin(a)]; };
  const wedge = (i) => {
    const a0 = i * step + 0.6, a1 = (i + 1) * step - 0.6;
    const [x0, y0] = pt(R2, a0), [x1, y1] = pt(R2, a1), [x2, y2] = pt(R1, a1), [x3, y3] = pt(R1, a0);
    return `M${x0} ${y0} A${R2} ${R2} 0 0 1 ${x1} ${y1} L${x2} ${y2} A${R1} ${R1} 0 0 0 ${x3} ${y3} Z`;
  };

  // Rim, wedges and quarter labels.
  const rim = document.createElementNS(NS, 'circle');
  Object.entries({ cx: C, cy: C, r: 208, fill: 'none', stroke: 'var(--ink)', 'stroke-width': 1.5 }).forEach(([k, v]) => rim.setAttribute(k, v));
  wheel.appendChild(rim);
  const ticks = WEEKS.map((w, i) => {
    const g = document.createElementNS(NS, 'g');
    g.setAttribute('class', 'tick'); g.setAttribute('tabindex', '0'); g.setAttribute('role', 'button');
    g.setAttribute('aria-label', `Week ${w.w}: ${w.n}`);
    const p = document.createElementNS(NS, 'path');
    p.setAttribute('d', wedge(i)); p.setAttribute('fill', qVar(w.q)); p.setAttribute('stroke', 'var(--fog)'); p.setAttribute('stroke-width', '1');
    const [tx, ty] = pt(R2 - 14, (i + 0.5) * step);
    const t = document.createElementNS(NS, 'text');
    t.setAttribute('x', tx); t.setAttribute('y', ty + 3.5); t.setAttribute('text-anchor', 'middle');
    t.setAttribute('font-family', 'DM Mono, monospace'); t.setAttribute('font-size', '9'); t.setAttribute('fill', 'var(--foam)');
    t.textContent = w.w;
    g.append(p, t);
    g.addEventListener('click', () => goTo(w.w, true));
    g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); goTo(w.w, true); } });
    wheel.appendChild(g);
    return p;
  });
  QUARTERS.forEach((q, k) => {
    const [x, y] = pt(R1 - 16, k * 90 + 45);
    const t = document.createElementNS(NS, 'text');
    t.setAttribute('class', 'qlabel'); t.setAttribute('x', x); t.setAttribute('y', y + 4); t.setAttribute('text-anchor', 'middle');
    t.textContent = q.name.split(' ')[0];
    wheel.appendChild(t);
  });

  // Week of the year, the way the Almanac counts it: Jan 1–7 is week 1.
  const thisWeek = () => {
    const now = new Date(), start = new Date(now.getFullYear(), 0, 1);
    return Math.min(52, Math.floor((now - start) / 864e5 / 7) + 1);
  };

  const stamps = (() => { try { return new Set(JSON.parse(localStorage.getItem('almanac-stamps') || '[]')); } catch { return new Set(); } })();
  const save = () => { try { localStorage.setItem('almanac-stamps', JSON.stringify([...stamps])); } catch {} };

  const dots = document.getElementById('dots');
  const dotEls = WEEKS.map((w) => {
    const b = document.createElement('button');
    b.type = 'button'; b.textContent = w.w; b.style.setProperty('--q', qVar(w.q));
    b.setAttribute('aria-label', `Week ${w.w}, ${w.n}`);
    b.addEventListener('click', () => goTo(w.w, true));
    dots.appendChild(b); return b;
  });

  const $ = (id) => document.getElementById(id);

  // Each week has its own spot on the AM band, 540 to 1700 kHz in 10 kHz channels.
  const kHz = (w) => 540 + Math.round(((w - 1) * 1160 / 51) / 10) * 10;
  const bandPos = (k) => `${((k - 540) / 1160) * 100}%`;

  /* ---------- KALM: an AM radio built from Web Audio ----------
     Every sound runs through one AM chain: a 300 Hz–3 kHz band, a soft tube clip,
     a slow fading wobble, and a bed of static and crackle underneath. */
  const radio = (() => {
    let ctx = null, chain = null, staticGain = null, bed = null, fade = null, on = false;
    const pent = [0, 2, 4, 7, 9];
    const noiseBuf = (c) => { const b = c.createBuffer(1, c.sampleRate * 2, c.sampleRate), d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; return b; };
    function build() {
      const C = new (window.AudioContext || window.webkitAudioContext)();
      const hp = C.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 320; hp.Q.value = 0.8;
      const lp = C.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2900; lp.Q.value = 1.1;
      const peak = C.createBiquadFilter(); peak.type = 'peaking'; peak.frequency.value = 1400; peak.gain.value = 5; peak.Q.value = 0.9;
      const clip = C.createWaveShaper(); const curve = new Float32Array(1024);
      for (let i = 0; i < 1024; i++) { const x = i / 512 - 1; curve[i] = Math.tanh(2.6 * x) / Math.tanh(2.6); }
      clip.curve = curve; clip.oversample = '2x';
      const wob = C.createGain(); wob.gain.value = 0.85;
      const lfo = C.createOscillator(); lfo.frequency.value = 0.11; const lfoAmt = C.createGain(); lfoAmt.gain.value = 0.13;
      lfo.connect(lfoAmt).connect(wob.gain); lfo.start();
      const comp = C.createDynamicsCompressor(); comp.threshold.value = -20; comp.ratio.value = 6;
      const out = C.createGain(); out.gain.value = 0.9;
      const input = C.createGain();
      input.connect(hp).connect(peak).connect(lp).connect(clip).connect(wob).connect(comp).connect(out).connect(C.destination);
      // Static: band-limited hiss plus random crackle pops.
      const hiss = C.createBufferSource(); hiss.buffer = noiseBuf(C); hiss.loop = true;
      const hissBp = C.createBiquadFilter(); hissBp.type = 'bandpass'; hissBp.frequency.value = 1800; hissBp.Q.value = 0.5;
      const sg = C.createGain(); sg.gain.value = 0;
      hiss.connect(hissBp).connect(sg).connect(input); hiss.start();
      ctx = C; chain = input; staticGain = sg;
      (function crackle() {
        if (!ctx) return;
        if (on && Math.random() < 0.55) {
          const t = ctx.currentTime, o = ctx.createBufferSource(), g = ctx.createGain();
          o.buffer = noiseBuf(ctx); g.gain.setValueAtTime(0.05 + Math.random() * 0.12, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.012 + Math.random() * 0.02);
          o.connect(g).connect(chain); o.start(t, Math.random()); o.stop(t + 0.05);
        }
        setTimeout(crackle, 90 + Math.random() * 420);
      })();
    }
    const env = (node, t, peak, a, d) => { node.gain.setValueAtTime(0.0001, t); node.gain.exponentialRampToValueAtTime(peak, t + a); node.gain.exponentialRampToValueAtTime(0.0001, t + a + d); };
    function bell(freq, t, peak = 0.22, d = 1.6) {
      [[1, 1], [2.01, 0.45], [2.76, 0.3], [5.4, 0.12]].forEach(([m, a]) => {
        const o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'sine'; o.frequency.value = freq * m;
        env(g, t, peak * a, 0.008, d / m); o.connect(g).connect(chain); o.start(t); o.stop(t + d + 0.1);
      });
    }
    // The station ident: three notes, "Al-ma-nac", keyed to the quarter, then the week's own bell.
    function ident(w) {
      const t = ctx.currentTime + 0.05, qi = Math.floor((w - 1) / 13), root = [220, 247, 196, 175][qi];
      [0, 4, 7].forEach((s, i) => bell(root * 2 ** (s / 12), t + i * 0.19, 0.16, 0.9));
      const deg = (w - 1) % 10, step = pent[deg % 5] + 12 * Math.floor(deg / 5);
      bell(440 * 2 ** (step / 12), t + 0.75, 0.26, 2.2);
    }
    // Quarter beds, quiet and through the same speaker: rain, birdsong, surf, wind.
    function setBed(q) {
      if (bed && bed.q === q) return;
      if (bed) { const old = bed; old.g.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.4); setTimeout(() => old.stop(), 1600); }
      const g = ctx.createGain(); g.gain.value = 0.0001; g.connect(chain);
      const src = ctx.createBufferSource(); src.buffer = noiseBuf(ctx); src.loop = true;
      const f = ctx.createBiquadFilter(), timers = [];
      const amp = ctx.createGain(); src.connect(f).connect(amp).connect(g); src.start();
      if (q === 'rain') { f.type = 'highpass'; f.frequency.value = 1600; amp.gain.value = 0.35;
        timers.push(setInterval(() => { if (on) bell(1800 + Math.random() * 1400, ctx.currentTime, 0.03, 0.12); }, 140)); }
      if (q === 'bloom') { f.type = 'bandpass'; f.frequency.value = 900; amp.gain.value = 0.08;
        timers.push(setInterval(() => { if (!on || Math.random() < 0.4) return; const t = ctx.currentTime, o = ctx.createOscillator(), e = ctx.createGain();
          o.frequency.setValueAtTime(2100 + Math.random() * 600, t); o.frequency.exponentialRampToValueAtTime(3200 + Math.random() * 500, t + 0.09);
          env(e, t, 0.05, 0.01, 0.12); o.connect(e).connect(chain); o.start(t); o.stop(t + 0.2); }, 520)); }
      if (q === 'swell') { f.type = 'lowpass'; f.frequency.value = 700; amp.gain.value = 0.2;
        const l = ctx.createOscillator(), la = ctx.createGain(); l.frequency.value = 0.09; la.gain.value = 0.19; l.connect(la).connect(amp.gain); l.start(); timers.push(() => l.stop()); }
      if (q === 'wind') { f.type = 'bandpass'; f.Q.value = 3; f.frequency.value = 600; amp.gain.value = 0.32;
        const l = ctx.createOscillator(), la = ctx.createGain(); l.frequency.value = 0.07; la.gain.value = 380; l.connect(la).connect(f.frequency); l.start(); timers.push(() => l.stop()); }
      g.gain.setTargetAtTime(0.5, ctx.currentTime, 0.8);
      bed = { q, g, stop() { try { src.stop(); } catch {} timers.forEach((x) => typeof x === 'function' ? x() : clearInterval(x)); } };
    }
    return {
      get on() { return on; },
      async power(want) {
        if (want && !ctx) build();
        if (!ctx) return;
        await ctx.resume().catch(() => {});
        on = want;
        staticGain.gain.setTargetAtTime(want ? 0.05 : 0, ctx.currentTime, 0.2);
        if (!want && bed) { bed.g.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.2); const b = bed; bed = null; setTimeout(() => b.stop(), 900); }
        if (!want && window.speechSynthesis) speechSynthesis.cancel();
      },
      // Tuning: static swells while a heterodyne whistle sweeps between stations.
      tune(ms) {
        if (!on) return;
        const t = ctx.currentTime, s = ms / 1000, o = ctx.createOscillator(), g = ctx.createGain();
        o.type = 'sine'; o.frequency.setValueAtTime(600, t);
        for (let i = 1; i <= 6; i++) o.frequency.linearRampToValueAtTime(300 + Math.random() * 2600, t + (s * i) / 6);
        g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.07, t + 0.15); g.gain.setTargetAtTime(0.0001, t + s * 0.8, 0.12);
        o.connect(g).connect(chain); o.start(t); o.stop(t + s + 0.6);
        staticGain.gain.cancelScheduledValues(t); staticGain.gain.setTargetAtTime(0.32, t, 0.08); staticGain.gain.setTargetAtTime(0.05, t + s, 0.15);
        if (bed) { bed.g.gain.setTargetAtTime(0.05, t, 0.1); }
      },
      land(w) { if (!on) return; ident(w); setBed(WEEKS[w - 1].q); bed.g.gain.setTargetAtTime(0.5, ctx.currentTime + 0.4, 0.6); },
      duck(down) { if (on && bed) bed.g.gain.setTargetAtTime(down ? 0.12 : 0.5, ctx.currentTime, 0.3); },
    };
  })();

  // The announcer. Browser speech can't be routed through Web Audio, so the voice stays
  // clean while the station's static and bed duck underneath it.
  const canSpeak = 'speechSynthesis' in window && typeof SpeechSynthesisUtterance === 'function';
  const spell = (n) => String(n);
  function script(w) {
    const k = WEEKS[w - 1];
    return `You're tuned to K A L M, Almanac Radio, at ${kHz(w)} on your A M dial. Week ${spell(w)}. ${k.n}. ${k.when}. ${k.line} Where to look: ${k.where.toLowerCase()}. ${k.how} That's week ${spell(w)} on K A L M.`;
  }
  function speak(w, done) {
    if (!canSpeak) { done && setTimeout(done, 6000); return; }
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(script(w));
    u.rate = 0.98; u.pitch = 0.85;
    const v = speechSynthesis.getVoices().find((x) => /en-US/i.test(x.lang) && /male|daniel|fred|alex|guy|david/i.test(x.name)) || speechSynthesis.getVoices().find((x) => /^en/i.test(x.lang));
    if (v) u.voice = v;
    u.onstart = () => radio.duck(true);
    u.onend = u.onerror = () => { radio.duck(false); done && done(); };
    speechSynthesis.speak(u);
  }

  function render(w, animate) {
    const week = WEEKS[w - 1], q = qOf(week.q);
    $('hubNum').textContent = w;
    $('freq').textContent = kHz(w);
    $('needle').style.left = bandPos(kHz(w));
    if (radio.on) $('radioNote').textContent = `On the air at ${kHz(w)} kHz. Spin the dial to tune across the band.`;
    const card = $('card');
    const im = document.createElement('img'); im.src = week.img; im.width = 1200; im.height = 600; im.alt = `Front of ${week.n}, week ${week.w} of the Almanac, with actual Noun #${week.noun}`; card.replaceChildren(im);
    if (animate && !reduce) { card.classList.remove('flip'); void card.offsetWidth; card.classList.add('flip'); }
    $('name').textContent = week.n;
    $('when').textContent = week.when;
    $('line').textContent = week.line;
    $('how').textContent = week.how;
    $('qchip').style.setProperty('--q', qVar(week.q));
    $('qchip').querySelector('span').textContent = `${q.name} · ${q.motto}`;
    $('where').textContent = week.where;
    $('noun').textContent = `Actual Noun #${week.noun}`;
    $('src').textContent = `Source: ${week.src} ↗`; $('src').href = week.url;
    const got = stamps.has(w);
    $('stamp').setAttribute('aria-pressed', String(got));
    $('stamp').textContent = got ? `Stamped · week ${w} is yours` : 'I noticed it this year';
    ticks.forEach((p, i) => p.setAttribute('opacity', i === w - 1 ? '1' : '0.55'));
    dotEls.forEach((b, i) => { b.classList.toggle('got', stamps.has(i + 1)); b.classList.toggle('on', i === w - 1); });
    const n = stamps.size;
    $('tally').textContent = n === 52 ? '52 of 52. A whole year, noticed.' : `${n} of 52 stamped${n ? '' : ' — start with this week'}.`;
  }

  // Turn the wheel so week w sits under the pointer at the top.
  function goTo(w, animate, extraTurns = 0) {
    current = w;
    const target = -((w - 0.5) * step);
    let next = target - 360 * extraTurns;
    while (next > rotation) next -= 360;          // always turn the same way, like a real dial
    if (!extraTurns && rotation - next > 180) next += 360;
    const dur = reduce || !animate ? 0 : extraTurns ? 2600 : 500;
    wheel.style.transition = dur ? `transform ${dur}ms cubic-bezier(.15,.85,.2,1)` : 'none';
    wheel.style.transform = `rotate(${next}deg)`;
    rotation = next;
    if (animate) radio.tune(Math.max(dur, 350));
    const landed = () => { if (animate) radio.land(w); };
    if (dur) { spinning = true; setTimeout(() => { spinning = false; render(w, true); landed(); }, extraTurns ? dur : 350); if (!extraTurns) render(w, true); }
    else { render(w, false); if (animate) setTimeout(landed, 350); }
  }

  // Radio controls.
  let touring = false;
  const setPower = async (want) => {
    await radio.power(want);
    $('power').setAttribute('aria-pressed', String(want));
    $('power').textContent = want ? 'Turn the radio off' : 'Turn the radio on';
    $('lamp').classList.toggle('on', want);
    $('radioNote').textContent = want ? `On the air at ${kHz(current)} kHz. Spin the dial to tune across the band.` : 'Sound starts when you press a button. Spinning the dial tunes across the band.';
    if (!want) stopTour();
  };
  const stopTour = () => { touring = false; $('tour').setAttribute('aria-pressed', 'false'); $('tour').textContent = 'Play the year'; if (canSpeak) speechSynthesis.cancel(); };
  const tourStep = () => {
    if (!touring) return;
    speak(current, () => { if (!touring) return; setTimeout(() => { if (!touring) return; goTo(current === 52 ? 1 : current + 1, true); setTimeout(tourStep, 1900); }, 700); });
  };
  $('power').addEventListener('click', () => setPower(!radio.on));
  $('read').addEventListener('click', async () => { if (!radio.on) await setPower(true); radio.land(current); setTimeout(() => speak(current), 1500); });
  $('tour').addEventListener('click', async () => {
    if (touring) return stopTour();
    if (!radio.on) await setPower(true);
    touring = true; $('tour').setAttribute('aria-pressed', 'true'); $('tour').textContent = 'Stop the tour';
    radio.land(current); setTimeout(tourStep, 1500);
  });
  if (!canSpeak) { $('read').hidden = true; $('tour').textContent = 'Play the year (music only)'; }
  document.addEventListener('visibilitychange', () => { if (document.hidden && radio.on) setPower(false); });

  $('spin').addEventListener('click', () => { if (spinning) return; let w; do { w = 1 + Math.floor(Math.random() * 52); } while (w === current); goTo(w, true, 3); });
  $('today').addEventListener('click', () => goTo(thisWeek(), true));
  $('prev').addEventListener('click', () => goTo(current === 1 ? 52 : current - 1, true));
  $('next').addEventListener('click', () => goTo(current === 52 ? 1 : current + 1, true));
  $('stamp').addEventListener('click', () => { stamps.has(current) ? stamps.delete(current) : stamps.add(current); save(); render(current, false); });

  goTo(thisWeek(), false);
})();
</script>
</body>
</html>
