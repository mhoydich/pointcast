---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { ALMANAC, BASE, noteFiles, nounArt } from '../../../lib/currency-builder/almanac.mjs';
import Top from '../../../components/currency-builder/Top.astro';
import '../../../styles/currency-builder.css';

const byQuarter = ALMANAC.quarters.map((quarter) => ({
  ...quarter,
  currencies: ALMANAC.currencies.filter((entry) => entry.quarter === quarter.id),
}));
const heroSlugs = ['the-perseids', 'el-segundo-blue', 'southbound'];
const hero = heroSlugs.map((slug) => ALMANAC.currencies.find((entry) => entry.slug === slug));
const total = ALMANAC.currencies.length;
const description = 'Fifty-two Currency Builder design concepts, one for each week of the South Bay year, from the Quadrantids to the Christmas Bird Count. Each carries a different actual CC0 Noun. Not legal tender; no cash value.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: ALMANAC.title,
  url: `https://pointcast.xyz${BASE}/`,
  description,
  isAccessibleForFree: true,
  creator: { '@type': 'Person', name: 'Mike Hoydich' },
  hasPart: ALMANAC.currencies.map((entry) => ({ '@type': 'CreativeWork', name: entry.name, url: `https://pointcast.xyz${BASE}/${entry.slug}/` })),
};
---
<BlockLayout title="Almanac · 52 currencies · Currency Builder" description={description} image="/images/og/currency-builder-almanac.png" imageAlt="Three Almanac currency designs from Currency Builder, each with an actual Noun" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/almanac.json', title: 'Almanac · machine edition' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="almanac" json="/currency-builder/almanac.json" />

      <section class="cb-hero" aria-labelledby="cb-title">
        <div>
          <p class="cb-kicker">Nouns Money · Almanac collection</p>
          <h1 id="cb-title">Almanac<em>.</em></h1>
          <p class="cb-dek">Fifty-two currencies, one for each week of the South Bay year: whales both ways, king tides, grunion nights, the El Segundo blue, eight meteor showers and the earliest sunset. Every note carries a different actual Noun.</p>
          <div class="cb-stats">
            <div><strong>{total}</strong><span>weeks</span></div>
            <div><strong>{new Set(ALMANAC.currencies.map((entry) => entry.nounId)).size}</strong><span>actual Nouns</span></div>
            <div><strong>4</strong><span>quarters</span></div>
            <div><strong>{total * 2}</strong><span>print faces</span></div>
          </div>
          <p class="cb-disclose">Design concepts for a community almanac. Not legal tender, not for sale, no cash value, no redemption and no financial rights. Nouns art is CC0; no Nouns DAO endorsement is implied.</p>
        </div>
        <div class="cb-stack" aria-hidden="true">
          {hero.map((entry) => <img src={noteFiles(entry).front} width="1200" height="600" alt="" />)}
        </div>
      </section>

      <nav class="cb-chips" aria-label="Almanac quarters">
        {byQuarter.map((quarter) => <a href={`#${quarter.id}`} style={`--chip:${quarter.palette.accent}`}><i></i>{quarter.name} · {quarter.currencies.length}</a>)}
      </nav>

      {byQuarter.map((quarter) => (
        <section class="cb-theme" id={quarter.id} aria-labelledby={`${quarter.id}-title`} style={`--accent:${quarter.palette.accent}`}>
          <div class="cb-theme-head">
            <h2 id={`${quarter.id}-title`}>{quarter.name}<em>.</em><br />{quarter.motto}</h2>
            <p>{quarter.summary}</p>
          </div>
          <div class="cb-grid">
            {quarter.currencies.map((entry) => {
              const art = nounArt(entry.nounId);
              return (
                <a class="cb-card" href={`${BASE}/${entry.slug}/`}>
                  <img src={noteFiles(entry).front} width="1200" height="600" loading="lazy" alt="" />
                  <div>
                    <p class="cb-code">Week {entry.week} · Noun #{entry.nounId} · {art.labels.head}</p>
                    <h3>{entry.name}</h3>
                    <p class="cb-unit">{entry.when}</p>
                    <p class="cb-line">{entry.line}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <h2 class="cb-sr" id="rules-title">How an Almanac note works</h2>
      <section class="cb-rules" aria-labelledby="rules-title">
        <article><span>01</span><h3>Earned by noticing</h3><p>One note per person who logs that week's sign in the town almanac: a count, a photo, a time and a place. Zero meteors still counts.</p></article>
        <article><span>02</span><h3>Traded one for one</h3><p>Missed the Perseids? Trade a spare week for it. A full year is 52 notes, and every week is worth the same.</p></article>
        <article><span>03</span><h3>Never sold</h3><p>No one sells a note and no one redeems one for anything. The only thing a note proves is that someone was paying attention that week.</p></article>
        <article><span>04</span><h3>Wildlife first</h3><p>Fences, trails and closed seasons outrank any note. Plovers, terns and the El Segundo blue are watched from outside the fence, and grunion are never taken.</p></article>
      </section>

      <section class="cb-section cb-two" aria-labelledby="actual-title">
        <div>
          <h2 id="actual-title">Fifty-two actual Nouns.</h2>
          <p>Each week's Noun is chosen for its head or accessory: a whale for each gray whale passage, a jellyfish for the by-the-wind sailors, a trash can for Coastal Cleanup Day, a field-guide dictionary for the night migrants and a dinosaur for the Christmas Bird Count. No Noun appears twice.</p>
          <p>The pixels are drawn from the official CC0 Nouns trait data using each Noun's on-chain seed, as recorded in the <a href="/images/nouns-money/source-100/provenance.json">Nouns #0–99 provenance file</a>. Every note's reverse lists the traits and links to the Noun itself, and every week's page links the source for its natural event.</p>
        </div>
        <div>
          <h2>Built for currencybuilder.xyz.</h2>
          <ul class="cb-list">
            <li><span>Machine edition</span><span><a href="/currency-builder/almanac.json">almanac.json</a></span></li>
            <li><span>Print faces</span><span>{total * 2} SVGs · front and back</span></li>
            <li><span>Trim</span><span>{ALMANAC.trim_mm.join(' × ')} mm · 2:1</span></li>
            <li><span>Year wheel</span><span>52 ticks on every note, its own week lit</span></li>
            <li><span>Status</span><span>Design concepts · no physical edition yet</span></li>
          </ul>
        </div>
      </section>

      <footer class="cb-foot">
        <p>Currency Builder · Almanac, a Nouns Money collection from El Segundo. Design concepts only: these notes are not money, are not sold and carry no promise of goods, services, cash or returns. Dates are typical for Southern California and shift from year to year; check the linked source before heading out.</p>
        <p>Nouns art is CC0; Currency Builder is not affiliated with or endorsed by Nouns DAO. Collection data and print SVGs: <a href="/currency-builder/almanac.json">/currency-builder/almanac.json</a>.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
