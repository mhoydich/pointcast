---
// /currency-builder/almanac/radio/ — KALM Almanac Radio: a tabletop AM set with 52 stations, one per Almanac week, each with its own tune, week sounds and announcer.
// Built 2026-10-22 by Claude Code from the Almanac data. Audio is Web Audio,
// generated in the browser; the announcer is the browser's own speech voice.
import { ALMANAC, noteFiles } from '../../../lib/currency-builder/almanac.mjs';

const WEEKS = ALMANAC.currencies.map((e) => ({
  w: e.week, q: e.quarter, n: e.name, when: e.when, where: e.where, line: e.line, how: e.how,
  noun: e.nounId, src: e.source_title, url: e.source_url, img: noteFiles(e).front,
}));
const QUARTERS = ALMANAC.quarters.map((q) => ({ id: q.id, name: q.name, motto: q.motto, accent: q.palette.accent, accent2: q.palette.accent2 }));
const data = `const WEEKS=${JSON.stringify(WEEKS)};const QUARTERS=${JSON.stringify(QUARTERS)};`.replace(/</g, '\\u003c');
const url = 'https://pointcast.xyz/currency-builder/almanac/radio/';
const description = "A 1950s tabletop AM radio with 52 stations, one for each Almanac week: tune through static to each week's tune and sounds, watch the magic eye close, and let the announcer read the note.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>KALM Almanac Radio</title>
<meta name="description" content={description}>
<meta property="og:title" content='KALM Almanac Radio'>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/images/og/currency-builder-almanac.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={url}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Limelight&family=Libre+Franklin:wght@400;600&family=Courier+Prime:wght@400;700&display=swap">
<style is:global>
/* Reset the artifact skeleton gave this page. */
:root { padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
body { margin: 0; }
img { max-width: 100%; }
[hidden] { display: none !important; }

/* Layout: one object on a wall. A 1950s seafoam tabletop radio, dial glass on top, grille and knobs below, the station's note on the shelf beneath it.
   Single-look by choice: the radio is the same object in any room, so every color is set explicitly. */
:root {
  --wall: #1e3a3f;        /* dusk-teal living-room wall */
  --wall-2: #26474d;
  --body: #9fd3c4;        /* seafoam bakelite */
  --body-hi: #c4e8dc;
  --body-lo: #6fa898;
  --chrome: #dfe6e4;
  --glass: #f2b84b;       /* lit amber dial glass */
  --glass-lo: #c9812a;
  --ink: #2a1d12;         /* dial printing */
  --needle: #c8321f;
  --eye: #5dff9a;         /* magic-eye phosphor */
  --paper: #f4efe4;
  --text: #eaf3f1;
  --text-soft: #a9c7c3;
  --deco: "Limelight", "Didot", "Bodoni 72", Georgia, serif;
  --sans: "Libre Franklin", "Helvetica Neue", Arial, sans-serif;
  --type: "Courier Prime", "Courier New", ui-monospace, monospace;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { background: var(--wall); }
body { color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.55;
  background: radial-gradient(ellipse at 50% 0%, var(--wall-2), var(--wall) 70%) fixed; }
.page { max-width: 980px; margin: 0 auto; padding-block: 28px 60px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  display: grid; gap: 28px; }
header { display: grid; gap: 6px; }
.kicker { margin: 0; font-family: var(--type); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--text-soft); }
h1 { margin: 0; font-family: var(--deco); font-weight: 400; font-size: clamp(38px, 7vw, 68px); line-height: 1; letter-spacing: .02em; color: var(--body-hi); text-wrap: balance; }
.dek { margin: 0; max-width: 62ch; color: var(--text-soft); }

/* ---------- the radio ---------- */
.radio { position: relative; border-radius: 46px 46px 30px 30px; padding: clamp(14px, 3vw, 26px);
  background: linear-gradient(170deg, var(--body-hi), var(--body) 38%, var(--body-lo));
  box-shadow: 0 30px 60px -24px rgba(0,0,0,.7), inset 0 2px 0 rgba(255,255,255,.55), inset 0 -6px 14px rgba(0,0,0,.18);
  display: grid; gap: clamp(12px, 2.4vw, 20px); }
.radio::after { content: ""; position: absolute; left: 12%; right: 12%; bottom: -14px; height: 14px; border-radius: 0 0 10px 10px; background: #3a2c22; z-index: -1; }
.brand { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-inline: 6px; color: #234a42; }
.brand b { font-family: var(--deco); font-weight: 400; font-size: clamp(22px, 4vw, 32px); letter-spacing: .08em; }
.brand span { font-family: var(--type); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }

.dial { position: relative; height: clamp(92px, 17vw, 128px); border-radius: 16px; overflow: hidden; cursor: ew-resize; touch-action: none;
  background: linear-gradient(180deg, #fff3cf, var(--glass) 30%, var(--glass-lo));
  box-shadow: inset 0 0 0 5px var(--chrome), inset 0 0 0 7px #9aa7a4, inset 0 10px 24px rgba(255,255,255,.4), inset 0 -16px 30px rgba(120,60,10,.35);
  transition: filter .4s; }
.dial.off { filter: saturate(.25) brightness(.72); }
.dial svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.dial text { font-family: var(--type); fill: var(--ink); }
.needle { position: absolute; top: 9px; bottom: 9px; width: 3px; margin-left: -1.5px; background: var(--needle); border-radius: 2px; box-shadow: 0 0 6px rgba(200,50,31,.6); left: 50%; }

.lower { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(12px, 3vw, 26px); align-items: center; }
@media (max-width: 620px) { .lower { grid-template-columns: minmax(0, 1fr); } }
.grille { position: relative; height: clamp(150px, 26vw, 200px); border-radius: 18px; overflow: hidden;
  background: repeating-linear-gradient(90deg, #2f3a38 0 7px, #c9d3d0 7px 9px); box-shadow: inset 0 0 0 4px var(--chrome), inset 0 0 24px rgba(0,0,0,.6); }
.grille canvas { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: screen; }
.grille .badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 66px; height: 66px; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fff, var(--chrome) 45%, #8f9b98); display: grid; place-items: center; box-shadow: 0 3px 8px rgba(0,0,0,.4); }
.grille .badge span { font-family: var(--deco); font-size: 15px; color: #234a42; letter-spacing: .04em; }

.panel { display: grid; gap: 12px; justify-items: center; }
.knobs { display: flex; gap: 18px; align-items: flex-start; }
.knobwrap { display: grid; gap: 6px; justify-items: center; }
.knob { width: 84px; height: 84px; border-radius: 50%; cursor: grab; touch-action: none; position: relative;
  background: radial-gradient(circle at 35% 30%, #fbf6ea, #d8cdb6 55%, #8d7f65); box-shadow: 0 6px 12px rgba(0,0,0,.35), inset 0 -3px 6px rgba(0,0,0,.2); }
.knob::before { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: repeating-conic-gradient(rgba(0,0,0,.12) 0 4deg, transparent 4deg 12deg); }
.knob i { position: absolute; left: 50%; top: 8px; width: 4px; height: 20px; margin-left: -2px; border-radius: 2px; background: #5b2a14; transform-origin: 2px 34px; }
.knob:focus-visible { outline: 3px solid var(--eye); outline-offset: 4px; }
.knob:active { cursor: grabbing; }
.label { font-family: var(--type); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #234a42; }
.eye { width: 44px; height: 44px; border-radius: 50%; background: #0b1a12; box-shadow: inset 0 0 0 3px #222, 0 0 0 2px var(--chrome); }
.eye svg { width: 100%; height: 100%; display: block; }
.buttons { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
button { font: 700 13px/1 var(--type); letter-spacing: .08em; text-transform: uppercase; color: #234a42; cursor: pointer;
  background: linear-gradient(180deg, #fffaf0, #e1d6c0); border: 0; border-radius: 10px; padding: 11px 14px;
  box-shadow: 0 3px 0 #8d7f65, 0 5px 8px rgba(0,0,0,.25); }
button:active { transform: translateY(2px); box-shadow: 0 1px 0 #8d7f65; }
button:focus-visible { outline: 3px solid var(--eye); outline-offset: 3px; }
button[aria-pressed="true"] { background: linear-gradient(180deg, #ffe7a6, var(--glass)); }
#power[aria-pressed="true"] { background: linear-gradient(180deg, #ffd0c6, #f0705a); color: #3a0e06; }

/* ---------- the shelf: what's on the air ---------- */
.shelf { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 22px; align-items: start; }
@media (max-width: 760px) { .shelf { grid-template-columns: minmax(0, 1fr); } }
.card { background: var(--paper); padding: 10px; transform: rotate(-1.4deg); box-shadow: 0 16px 30px -16px rgba(0,0,0,.7); transition: opacity .3s, filter .3s; }
.card > img { display: block; width: 100%; height: auto; }
.card.faint { opacity: .45; filter: blur(1.2px) grayscale(.5); }
.onair { display: grid; gap: 8px; min-width: 0; }
.onair .freq { font-family: var(--type); font-size: 13px; letter-spacing: .12em; color: var(--glass); text-transform: uppercase; margin: 0; }
.onair h2 { margin: 0; font-family: var(--deco); font-weight: 400; font-size: clamp(28px, 4.4vw, 40px); line-height: 1.05; color: var(--body-hi); text-wrap: balance; }
.onair p { margin: 0; max-width: 60ch; }
.onair .soft { color: var(--text-soft); }
.onair .meta { font-family: var(--type); font-size: 13px; color: var(--text-soft); display: flex; flex-wrap: wrap; gap: 4px 16px; }
.onair a { color: var(--glass); }
.log { font-family: var(--type); font-size: 13px; color: var(--text-soft); border-top: 1px solid var(--wall-2); padding-top: 14px; display: grid; gap: 6px; }
.log ol { margin: 0; padding-left: 20px; display: grid; gap: 2px; }
footer { font-size: 13px; color: var(--text-soft); max-width: 72ch; }
footer a { color: var(--text-soft); }
@media (prefers-reduced-motion: reduce) { .card, .dial { transition: none; } }
</style>
</head>
<body>
<div class="page">
  <header>
    <p class="kicker">Nouns Money · Currency Builder · Almanac</p>
    <h1>KALM Almanac Radio</h1>
    <p class="dek">Fifty-two stations, one for every week of the South Bay year, spread across the AM band from 540 to 1700. Turn it on and tune. Between stations you get static; land on one and you hear its program: a little tune for its quarter and the sounds of its week.</p>
  </header>

  <section class="radio" aria-label="Radio">
    <div class="brand"><b>KALM</b><span>Almanac · Model 52</span></div>
    <div id="dial" class="dial off" aria-hidden="true">
      <svg id="scale" viewBox="0 0 1000 120" preserveAspectRatio="none"></svg>
      <div id="needle" class="needle"></div>
    </div>
    <div class="lower">
      <div class="grille" aria-hidden="true"><canvas id="viz"></canvas><div class="badge"><span>KALM</span></div></div>
      <div class="panel">
        <div class="knobs">
          <div class="knobwrap">
            <div id="volKnob" class="knob" role="slider" tabindex="0" aria-label="Volume" aria-valuemin="0" aria-valuemax="10" aria-valuenow="6"><i></i></div>
            <span class="label">Volume</span>
          </div>
          <div class="knobwrap">
            <div class="eye" title="Tuning eye: it closes when a station comes in"><svg viewBox="-22 -22 44 44"><circle r="17" fill="#0f3a22"/><path id="eyeWedge" fill="var(--eye)" d=""/><circle r="5" fill="#0b1a12"/></svg></div>
            <span class="label">Signal</span>
          </div>
          <div class="knobwrap">
            <div id="tuneKnob" class="knob" role="slider" tabindex="0" aria-label="Tuning, in kilohertz" aria-valuemin="540" aria-valuemax="1700" aria-valuenow="1350"><i></i></div>
            <span class="label">Tuning</span>
          </div>
        </div>
        <div class="buttons">
          <button id="power" type="button" aria-pressed="false">Power</button>
          <button id="seekDown" type="button" aria-label="Seek down to the previous station">◂ Seek</button>
          <button id="seekUp" type="button" aria-label="Seek up to the next station">Seek ▸</button>
          <button id="thisWeek" type="button">This week</button>
          <button id="announcer" type="button" aria-pressed="true">Announcer</button>
          <button id="tone" type="button" aria-pressed="true">Narrow AM</button>
        </div>
      </div>
    </div>
  </section>

  <section class="shelf" aria-live="polite">
    <div id="card" class="card faint"></div>
    <div class="onair">
      <p id="freqLine" class="freq">1350 kHz</p>
      <h2 id="title">Between stations</h2>
      <p id="line" class="soft"></p>
      <p id="how"></p>
      <div id="meta" class="meta"></div>
      <div class="log"><span>Stations you've heard on this visit</span><ol id="log"><li>None yet. Power on and tune.</li></ol></div>
    </div>
  </section>

  <footer>Design concepts from Currency Builder: not legal tender, not for sale, no cash value. Notes are traded one for one and never sold. Wildlife comes first; fences, trails and closed seasons outrank any note. Dates are typical for Southern California and shift from year to year. Every Noun is an actual CC0 Noun drawn from its on-chain seed; not affiliated with Nouns DAO. The announcer is your browser's own voice. All 52 notes: <a href="/currency-builder/almanac/">the Almanac</a>. Prefer a wheel? <a href="/currency-builder/almanac/wheel/">Spin the Almanac Wheel</a>.</footer>
</div>

<script is:inline set:html={data}></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const MIN = 540, MAX = 1700;
  const kHz = (w) => 540 + Math.round(((w - 1) * 1160 / 51) / 10) * 10;
  const STATIONS = WEEKS.map((w) => ({ ...w, k: kHz(w.w) }));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- what each week sounds like ---------- */
  const KIND = [
    [/Quadrantids|Lyrids|Aquariids|Perseids|Orionids|Leonids|Geminids/, 'meteor'],
    [/Southbound|Northbound/, 'whale'],
    [/Grunion|Last Run|Sand Crabs/, 'splash'],
    [/Backyard|Swallow|Tern|Plover|Pelican|Shorebird|Night Migrants|Christmas|First Flight/, 'birds'],
    [/Grove|Monarch|El Segundo Blue/, 'flutter'],
    [/Spring Forward|Fall Back|Early Dark/, 'clock'],
    [/Even Day|Long Day|Short Day|Aphelion/, 'sun'],
    [/King Tide|Swell|First Northwest|Warm Water|Sailor|Jelly|Blue Glow/, 'surf'],
    [/May Gray|Thunderheads|Santa Ana|First Rain/, 'weather'],
    [/Green Week|Poppy|Jacaranda|Toyon/, 'chimes'],
    [/Cleanup/, 'clink'],
  ];
  const kindOf = (name) => (KIND.find(([re]) => re.test(name)) || [0, 'chimes'])[1];

  /* ---------- dial scale ---------- */
  const scale = $('scale');
  const xOf = (k) => 40 + ((k - MIN) / (MAX - MIN)) * 920;
  let s = '';
  for (let k = 540; k <= 1700; k += 20) {
    const big = k % 100 === 0;
    s += `<line x1="${xOf(k)}" x2="${xOf(k)}" y1="${big ? 68 : 76}" y2="88" stroke="#2a1d12" stroke-width="${big ? 2 : 1}" opacity=".8"/>`;
  }
  [55, 60, 70, 80, 100, 120, 140, 160, 170].forEach((n) => { s += `<text x="${xOf(n * 10)}" y="60" text-anchor="middle" font-size="22" font-weight="700">${n}</text>`; });
  STATIONS.forEach((st) => { s += `<circle cx="${xOf(st.k)}" cy="98" r="3.2" fill="${({ rain: '#235a86', bloom: '#5d3a8f', swell: '#a8480f', wind: '#7c2a1d' })[st.q]}"/>`; });
  s += `<text x="500" y="28" text-anchor="middle" font-size="15" letter-spacing="6">KILOCYCLES · ×10</text>`;
  scale.innerHTML = s;

  /* ---------- state ---------- */
  let freq = 1350, vol = 6, on = false, narrow = true, announce = true;
  try { const f = +localStorage.getItem('kalm-freq'); if (f >= MIN && f <= MAX) freq = f; } catch {}
  const heard = [];

  const nearest = (k) => STATIONS.reduce((a, b) => (Math.abs(b.k - k) < Math.abs(a.k - k) ? b : a));
  const signalOf = (k) => { const st = nearest(k), d = Math.abs(st.k - k); return { st, d, sig: Math.max(0, 1 - d / 6) ** 1.6 }; };

  /* ---------- audio ---------- */
  let A = null;
  const noise = (c, secs = 2) => { const b = c.createBuffer(1, c.sampleRate * secs, c.sampleRate), d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; return b; };
  function build() {
    const C = new (window.AudioContext || window.webkitAudioContext)();
    const N = noise(C);
    // AM chain: band-limit, a little resonant honk, tube clip, selective fading, compressor, volume.
    const input = C.createGain();
    const hp = C.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 300;
    const peak = C.createBiquadFilter(); peak.type = 'peaking'; peak.frequency.value = 1300; peak.Q.value = 1; peak.gain.value = 6;
    const lp = C.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2800; lp.Q.value = 1.2;
    const clip = C.createWaveShaper(); const cv = new Float32Array(2048);
    for (let i = 0; i < 2048; i++) { const x = i / 1024 - 1; cv[i] = Math.tanh(3 * x) / Math.tanh(3); }
    clip.curve = cv; clip.oversample = '2x';
    const fade = C.createGain(); fade.gain.value = 0.85;
    const fl = C.createOscillator(); fl.frequency.value = 0.09; const fla = C.createGain(); fla.gain.value = 0.15; fl.connect(fla).connect(fade.gain); fl.start();
    const fl2 = C.createOscillator(); fl2.frequency.value = 0.037; const fl2a = C.createGain(); fl2a.gain.value = 500; fl2.connect(fl2a).connect(lp.frequency); fl2.start();
    const comp = C.createDynamicsCompressor(); comp.threshold.value = -22; comp.ratio.value = 5;
    const master = C.createGain(); master.gain.value = 0;
    const an = C.createAnalyser(); an.fftSize = 256;
    input.connect(hp).connect(peak).connect(lp).connect(clip).connect(fade).connect(comp).connect(master).connect(an).connect(C.destination);
    // Static and crackle.
    const hiss = C.createBufferSource(); hiss.buffer = N; hiss.loop = true;
    const hbp = C.createBiquadFilter(); hbp.type = 'bandpass'; hbp.frequency.value = 1700; hbp.Q.value = 0.4;
    const staticG = C.createGain(); staticG.gain.value = 0;
    hiss.connect(hbp).connect(staticG).connect(input); hiss.start();
    // 60-cycle hum, barely there.
    const hum = C.createOscillator(); hum.frequency.value = 60; const humG = C.createGain(); humG.gain.value = 0.012; hum.connect(humG).connect(input); hum.start();
    // Heterodyne whistle: what you hear when a carrier is near but not tuned.
    const het = C.createOscillator(); het.type = 'sine'; const hetG = C.createGain(); hetG.gain.value = 0; het.connect(hetG).connect(input); het.start();
    // The station's own program runs into this gain, scaled by signal strength.
    const prog = C.createGain(); prog.gain.value = 0; prog.connect(input);
    A = { C, N, input, hp, lp, peak, master, an, staticG, het, hetG, prog, station: null, timers: [], nextNote: 0, step: 0 };
    (function crackle() {
      if (!A) return;
      if (on && Math.random() < 0.6) {
        const t = C.currentTime, src = C.createBufferSource(), g = C.createGain();
        src.buffer = N; g.gain.setValueAtTime(0.06 + Math.random() * 0.16 * (1.2 - lastSig), t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.01 + Math.random() * 0.02);
        src.connect(g).connect(input); src.start(t, Math.random()); src.stop(t + 0.05);
      }
      setTimeout(crackle, 80 + Math.random() * 380);
    })();
    setTone();
  }
  function setTone() {
    if (!A) return;
    const t = A.C.currentTime;
    A.hp.frequency.setTargetAtTime(narrow ? 300 : 90, t, 0.05);
    A.lp.frequency.setTargetAtTime(narrow ? 2800 : 7000, t, 0.05);
    A.peak.gain.setTargetAtTime(narrow ? 6 : 1.5, t, 0.05);
  }

  /* instruments */
  const env = (g, t, p, a, d) => { g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(p, t + a); g.gain.exponentialRampToValueAtTime(0.0001, t + a + d); };
  function tone(dest, f, t, d, type = 'sine', p = 0.2, a = 0.01) {
    const o = A.C.createOscillator(), g = A.C.createGain(); o.type = type; o.frequency.value = f; env(g, t, p, a, d);
    o.connect(g).connect(dest); o.start(t); o.stop(t + a + d + 0.05); return o;
  }
  function burst(dest, t, d, f0, f1, type = 'bandpass', p = 0.3, q = 1) {
    const s = A.C.createBufferSource(), f = A.C.createBiquadFilter(), g = A.C.createGain(); s.buffer = A.N; f.type = type; f.Q.value = q;
    f.frequency.setValueAtTime(f0, t); f.frequency.exponentialRampToValueAtTime(f1, t + d); env(g, t, p, Math.min(0.08, d / 3), d);
    s.connect(f).connect(g).connect(dest); s.start(t, Math.random()); s.stop(t + d + 0.1);
  }
  const FX = {
    meteor(d, t) { burst(d, t, 1.1, 5000, 400, 'bandpass', 0.35, 3); tone(d, 1760, t + 1.0, 0.6, 'sine', 0.12); },
    whale(d, t) { const o = A.C.createOscillator(), g = A.C.createGain(); o.type = 'sine';
      o.frequency.setValueAtTime(340, t); o.frequency.exponentialRampToValueAtTime(620, t + 0.9); o.frequency.exponentialRampToValueAtTime(260, t + 2.4);
      env(g, t, 0.28, 0.4, 2.2); o.connect(g).connect(d); o.start(t); o.stop(t + 2.8); },
    splash(d, t) { for (let i = 0; i < 4; i++) burst(d, t + i * 0.13 + Math.random() * 0.05, 0.18, 2600, 900, 'bandpass', 0.22, 2); },
    birds(d, t) { for (let i = 0; i < 3; i++) { const o = A.C.createOscillator(), g = A.C.createGain(), tt = t + i * 0.16;
      o.frequency.setValueAtTime(2300 + Math.random() * 500, tt); o.frequency.exponentialRampToValueAtTime(3400 + Math.random() * 400, tt + 0.08); env(g, tt, 0.12, 0.01, 0.1); o.connect(g).connect(d); o.start(tt); o.stop(tt + 0.2); } },
    flutter(d, t) { for (let i = 0; i < 10; i++) tone(d, 1900 + (i % 2) * 300, t + i * 0.05, 0.04, 'triangle', 0.07, 0.005); },
    clock(d, t) { for (let i = 0; i < 4; i++) burst(d, t + i * 0.5, 0.04, i % 2 ? 1800 : 2600, 1500, 'bandpass', 0.35, 8); },
    sun(d, t) { [523.25, 659.25, 783.99].forEach((f, i) => tone(d, f, t + i * 0.02, 2.6, 'sine', 0.08, 0.5)); },
    surf(d, t) { burst(d, t, 2.4, 500, 1800, 'lowpass', 0.32, 0.5); },
    weather(d, t) { burst(d, t, 1.8, 300, 120, 'lowpass', 0.45, 0.7); },
    chimes(d, t) { [1318.5, 1568, 1760, 2093].forEach((f, i) => tone(d, f, t + i * 0.11 + Math.random() * 0.05, 1.2, 'sine', 0.06)); },
    clink(d, t) { tone(d, 2400, t, 0.25, 'square', 0.05); tone(d, 3100, t + 0.09, 0.2, 'square', 0.04); },
  };
  // Quarter programs: scale, tempo, meter and instrument.
  const STYLE = {
    rain:  { scale: [0, 3, 5, 7, 10], root: 196, bpm: 76, beats: 4, lead: 'sine', bass: 'triangle' },
    bloom: { scale: [0, 2, 4, 7, 9], root: 262, bpm: 98, beats: 4, lead: 'triangle', bass: 'sine' },
    swell: { scale: [0, 2, 4, 5, 7, 9, 10], root: 220, bpm: 116, beats: 4, lead: 'square', bass: 'triangle' },
    wind:  { scale: [0, 2, 3, 5, 7, 8, 10], root: 175, bpm: 84, beats: 3, lead: 'sawtooth', bass: 'sine' },
  };
  const seeded = (n) => { let x = (n * 2654435761) >>> 0 || 1; return () => { x ^= x << 13; x >>>= 0; x ^= x >>> 17; x ^= x << 5; x >>>= 0; return x / 4294967296; }; };
  function program(st) {
    const sty = STYLE[st.q], rand = seeded(st.w * 97 + 13);
    const bars = 4, len = bars * sty.beats * 2;          // eighth notes
    const notes = Array.from({ length: len }, (_, i) => (i % 2 && rand() < 0.35) ? null : sty.scale[Math.floor(rand() * sty.scale.length)] + (rand() < 0.25 ? 12 : 0));
    const bass = Array.from({ length: bars }, () => sty.scale[Math.floor(rand() * 3)] - 12);
    return { sty, notes, bass, len, kind: kindOf(st.n) };
  }
  function startProgram(st) {
    stopProgram();
    const p = program(st), C = A.C, dest = C.createGain(); dest.gain.value = 1; dest.connect(A.prog);
    const eighth = 60 / p.sty.bpm / 2;
    let step = 0, next = C.currentTime + 0.1, fxAt = C.currentTime + 1.2;
    const f = (semi) => p.sty.root * 2 ** (semi / 12);
    const tick = setInterval(() => {
      while (next < C.currentTime + 0.25) {
        const n = p.notes[step % p.len];
        if (n !== null) tone(dest, f(n), next, eighth * 1.6, p.sty.lead, p.sty.lead === 'sine' ? 0.16 : 0.07);
        if (step % (p.sty.beats * 2) === 0) tone(dest, f(p.bass[Math.floor(step / (p.sty.beats * 2)) % p.bass.length]), next, eighth * p.sty.beats * 1.8, p.sty.bass, 0.2, 0.02);
        if (p.sty.beats === 3 && step % 2 === 0 && step % 6) [0, 4, 7].forEach((s) => tone(dest, f(p.bass[0] + 12 + s), next, eighth, 'sine', 0.035));
        next += eighth; step++;
      }
      if (C.currentTime > fxAt) { FX[p.kind](dest, C.currentTime + 0.05); fxAt = C.currentTime + 5 + Math.random() * 4; }
    }, 60);
    A.station = st.w; A.timers = [tick]; A.dest = dest;
  }
  function stopProgram() {
    if (!A) return;
    A.timers.forEach(clearInterval); A.timers = [];
    if (A.dest) { const d = A.dest; d.gain.setTargetAtTime(0.0001, A.C.currentTime, 0.05); setTimeout(() => d.disconnect(), 400); A.dest = null; }
    A.station = null;
  }

  /* ---------- the announcer ---------- */
  const canSpeak = 'speechSynthesis' in window && typeof SpeechSynthesisUtterance === 'function';
  if (!canSpeak) $('announcer').hidden = true;
  let lockTimer = null, announced = null;
  function announceNow(st) {
    if (!canSpeak || !announce || !on) return;
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(`K A L M, Almanac Radio, ${st.k} on your dial. Week ${st.w}: ${st.n}. ${st.when}. ${st.line} ${st.how}`);
    u.rate = 1.02; u.pitch = 0.8;
    const voices = speechSynthesis.getVoices();
    const v = voices.find((x) => /en-US/i.test(x.lang) && /daniel|fred|alex|guy|david|male/i.test(x.name)) || voices.find((x) => /^en/i.test(x.lang));
    if (v) u.voice = v;
    u.onstart = () => A && A.prog.gain.setTargetAtTime(lastSig * 0.25, A.C.currentTime, 0.2);
    u.onend = u.onerror = () => A && A.prog.gain.setTargetAtTime(lastSig, A.C.currentTime, 0.4);
    speechSynthesis.speak(u);
  }

  /* ---------- tuning ---------- */
  let lastSig = 0, shown = null;
  function apply(fromUser = true) {
    const { st, d, sig } = signalOf(freq);
    lastSig = sig;
    $('needle').style.left = `${(xOf(freq) / 1000) * 100}%`;
    $('tuneKnob').querySelector('i').style.transform = `rotate(${((freq - MIN) / (MAX - MIN)) * 300 - 150}deg)`;
    $('tuneKnob').setAttribute('aria-valuenow', String(Math.round(freq)));
    $('tuneKnob').setAttribute('aria-valuetext', sig > 0.5 ? `${Math.round(freq)} kilohertz, week ${st.w}, ${st.n}` : `${Math.round(freq)} kilohertz, between stations`);
    // Magic eye: wide open with no signal, nearly closed when locked on.
    const open = on ? (1 - sig) * 150 + 12 : 175, a0 = (-90 - open / 2) * Math.PI / 180, a1 = (-90 + open / 2) * Math.PI / 180;
    const big = 360 - open > 180 ? 1 : 0;
    $('eyeWedge').setAttribute('d', on ? `M0 0 L${17 * Math.cos(a1)} ${17 * Math.sin(a1)} A17 17 0 ${big} 1 ${17 * Math.cos(a0)} ${17 * Math.sin(a0)} Z` : '');
    if (A && on) {
      const t = A.C.currentTime;
      A.prog.gain.setTargetAtTime(sig, t, 0.05);
      A.staticG.gain.setTargetAtTime(0.06 + (1 - sig) * 0.4, t, 0.05);
      const off = d;
      A.het.frequency.setTargetAtTime(120 + off * 420, t, 0.03);
      A.hetG.gain.setTargetAtTime(d > 0.4 && d < 6 ? 0.06 * (1 - d / 6) : 0, t, 0.04);
      if (sig > 0.05 && A.station !== st.w) startProgram(st);
      if (sig <= 0.05 && A.station !== null) stopProgram();
    }
    // The shelf shows the nearest station, sharp when it's in, blurred when it isn't.
    if (shown !== st.w) {
      shown = st.w;
      const im = document.createElement('img'); im.src = st.img; im.width = 1200; im.height = 600; im.alt = `Front of ${st.n}, week ${st.w} of the Almanac, with actual Noun #${st.noun}`; $('card').replaceChildren(im);
    }
    const inTune = sig > 0.55;
    $('card').classList.toggle('faint', !inTune);
    $('freqLine').textContent = `${Math.round(freq)} kHz${inTune ? ` · KALM week ${st.w}` : ''}`;
    $('title').textContent = inTune ? st.n : 'Between stations';
    $('line').textContent = inTune ? st.line : `Static. The nearest station is week ${st.w}, ${st.n}, at ${st.k}.`;
    $('how').textContent = inTune ? st.how : '';
    $('meta').innerHTML = inTune ? `<span>${st.when}</span><span>${st.where}</span><span>Actual Noun #${st.noun}</span><a href="${st.url}" target="_blank" rel="noopener">Source ↗</a>` : '';
    // Lock-in: hold a station for a moment and the announcer reads it, once per visit to it.
    clearTimeout(lockTimer);
    if (inTune && sig > 0.85 && on && announced !== st.w) lockTimer = setTimeout(() => { announced = st.w; log(st); announceNow(st); }, 1100);
    if (!inTune) { announced = announced === st.w ? announced : null; if (canSpeak && fromUser) speechSynthesis.cancel(); }
    try { localStorage.setItem('kalm-freq', String(Math.round(freq))); } catch {}
  }
  function log(st) {
    if (heard.includes(st.w)) return;
    heard.push(st.w);
    $('log').innerHTML = heard.map((w) => { const x = STATIONS[w - 1]; return `<li>${x.k} kHz · week ${x.w} · ${x.n}</li>`; }).join('');
  }
  const setFreq = (k, user = true) => { freq = Math.max(MIN, Math.min(MAX, k)); apply(user); };

  // Seek: sweep to the next station the way a car radio does.
  let seeking = null;
  function seek(dir) {
    cancelAnimationFrame(seeking);
    const here = Math.round(freq);
    const target = dir > 0 ? (STATIONS.find((s) => s.k > here + 1) || STATIONS[0]).k : ([...STATIONS].reverse().find((s) => s.k < here - 1) || STATIONS[51]).k;
    if (reduce) return setFreq(target);
    const start = freq, t0 = performance.now(), dur = 380 + Math.min(1400, Math.abs(target - start) * 2.2);
    const stepF = (now) => { const p = Math.min(1, (now - t0) / dur), e = 1 - (1 - p) ** 3; setFreq(start + (target - start) * e); if (p < 1) seeking = requestAnimationFrame(stepF); };
    seeking = requestAnimationFrame(stepF);
  }

  /* ---------- controls ---------- */
  function knob(el, get, set, perPx) {
    let y0 = null, v0 = 0;
    el.addEventListener('pointerdown', (e) => { y0 = e.clientY + e.clientX * -0.6; v0 = get(); el.setPointerCapture(e.pointerId); cancelAnimationFrame(seeking); });
    el.addEventListener('pointermove', (e) => { if (y0 === null) return; set(v0 + (y0 - (e.clientY + e.clientX * -0.6)) * perPx); });
    el.addEventListener('pointerup', () => { y0 = null; });
    el.addEventListener('pointercancel', () => { y0 = null; });
    el.addEventListener('wheel', (e) => { e.preventDefault(); set(get() - Math.sign(e.deltaY) * perPx * 6); }, { passive: false });
  }
  knob($('tuneKnob'), () => freq, (v) => setFreq(v), 1.6);
  $('tuneKnob').addEventListener('keydown', (e) => {
    const steps = { ArrowUp: 1, ArrowRight: 1, ArrowDown: -1, ArrowLeft: -1, PageUp: 10, PageDown: -10 };
    if (e.key in steps) { e.preventDefault(); setFreq(freq + steps[e.key] * (e.shiftKey ? 10 : 1)); }
    if (e.key === 'Home') { e.preventDefault(); setFreq(MIN); }
    if (e.key === 'End') { e.preventDefault(); setFreq(MAX); }
  });
  const setVol = (v) => {
    vol = Math.max(0, Math.min(10, v));
    $('volKnob').querySelector('i').style.transform = `rotate(${(vol / 10) * 300 - 150}deg)`;
    $('volKnob').setAttribute('aria-valuenow', String(Math.round(vol)));
    if (A) A.master.gain.setTargetAtTime(on ? (vol / 10) ** 1.5 : 0, A.C.currentTime, 0.05);
  };
  knob($('volKnob'), () => vol, setVol, 0.05);
  $('volKnob').addEventListener('keydown', (e) => { const k = { ArrowUp: 1, ArrowRight: 1, ArrowDown: -1, ArrowLeft: -1 }[e.key]; if (k) { e.preventDefault(); setVol(vol + k); } });
  // Drag on the dial glass to tune, too.
  const dial = $('dial');
  let dx0 = null, df0 = 0;
  dial.addEventListener('pointerdown', (e) => { dx0 = e.clientX; df0 = freq; dial.setPointerCapture(e.pointerId); cancelAnimationFrame(seeking); });
  dial.addEventListener('pointermove', (e) => { if (dx0 === null) return; const w = dial.getBoundingClientRect().width; setFreq(df0 + ((e.clientX - dx0) / (w * 0.92)) * (MAX - MIN)); });
  dial.addEventListener('pointerup', () => { dx0 = null; });

  $('power').addEventListener('click', async () => {
    if (!A) build();
    await A.C.resume().catch(() => {});
    on = !on;
    $('power').setAttribute('aria-pressed', String(on));
    dial.classList.toggle('off', !on);
    setVol(vol);
    if (!on) { stopProgram(); if (canSpeak) speechSynthesis.cancel(); announced = null; }
    apply(false);
  });
  $('seekUp').addEventListener('click', () => seek(1));
  $('seekDown').addEventListener('click', () => seek(-1));
  $('thisWeek').addEventListener('click', () => {
    const now = new Date(), w = Math.min(52, Math.floor((now - new Date(now.getFullYear(), 0, 1)) / 864e5 / 7) + 1);
    const target = kHz(w); cancelAnimationFrame(seeking);
    if (reduce) return setFreq(target);
    const start = freq, t0 = performance.now(), dur = 900;
    const stepF = (n) => { const p = Math.min(1, (n - t0) / dur), e = 1 - (1 - p) ** 3; setFreq(start + (target - start) * e); if (p < 1) seeking = requestAnimationFrame(stepF); };
    seeking = requestAnimationFrame(stepF);
  });
  $('announcer').addEventListener('click', () => { announce = !announce; $('announcer').setAttribute('aria-pressed', String(announce)); if (!announce && canSpeak) speechSynthesis.cancel(); else announced = null, apply(false); });
  $('tone').addEventListener('click', () => { narrow = !narrow; $('tone').setAttribute('aria-pressed', String(narrow)); $('tone').textContent = narrow ? 'Narrow AM' : 'Wide AM'; setTone(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden && on) $('power').click(); });

  /* ---------- the grille glows with the sound ---------- */
  const cv = $('viz'), g2 = cv.getContext('2d');
  let bins = null;
  function draw() {
    const r = cv.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1);
    if (cv.width !== Math.round(r.width * dpr)) { cv.width = Math.round(r.width * dpr); cv.height = Math.round(r.height * dpr); }
    g2.clearRect(0, 0, cv.width, cv.height);
    if (A && on) {
      bins = bins || new Uint8Array(A.an.frequencyBinCount);
      A.an.getByteFrequencyData(bins);
      const cols = Math.floor(cv.width / (9 * dpr));
      for (let i = 0; i < cols; i++) {
        const v = bins[Math.floor((i / cols) * 70) + 2] / 255, h = v * cv.height;
        g2.fillStyle = `rgba(242,184,75,${0.15 + v * 0.6})`;
        g2.fillRect(i * 9 * dpr, (cv.height - h) / 2, 7 * dpr, h);
      }
    }
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);

  setVol(vol);
  apply(false);
})();
</script>
</body>
</html>
