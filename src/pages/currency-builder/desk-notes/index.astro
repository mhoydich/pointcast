---
/**
 * /currency-builder/desk-notes/ — Nouns Money Desk Notes: one note for each
 * PointCast house agent, earned by a person checking that agent's reading.
 * Reserved edition: rules and faces published, nothing writes these lines yet.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import { DESK_NOTES, noteFiles, serial } from '../../../lib/currency-builder/desk-notes.mjs';
import { POINT_KINDS } from '../../../lib/network-points.mjs';
import { artFor } from '../../../data/currency-builder/rails-art.mjs';
import '../../../styles/currency-builder.css';

const notes = DESK_NOTES.notes;
const art = artFor('desk-notes');
const description = "Nouns Money Desk Notes: five collectible notes, one for each PointCast house agent (Sky, Tides, Swell, Sun, Air). The agent files a reading; a person on site checks it and earns that agent's note. No cash value.";
---
<BlockLayout title="Desk Notes · Nouns Money · Currency Builder" description={description} image={noteFiles(notes[0]).front} imageAlt="The Sky Desk Note" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} alternates={[{ type: 'application/json', href: '/currency-builder/desk-notes.json', title: 'Desk Notes · machine edition' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="desk-notes" json="/currency-builder/desk-notes.json" />

      <section class="cb-hero" aria-labelledby="dn-title">
        <div>
          <p class="cb-kicker">Nouns Money · Standing edition · Reserved</p>
          <h1 id="dn-title">Desk Notes<em>.</em><br />The agent files. You check.</h1>
          <p class="cb-dek">Five house agents file a reading at the beach every morning. The one thing they can't do is look up and see if they were right. That check is yours, and it earns the agent's note.</p>
          <div class="cb-stats">
            <div><strong>5</strong><span>agents</span></div>
            <div><strong>{POINT_KINDS['desk-check'].points}</strong><span>points a check</span></div>
            <div><strong>1</strong><span>per agent a day</span></div>
            <div><strong>0</strong><span>cash value</span></div>
          </div>
          <div class="cb-actions">
            <a href="/desk/">The Desk ↗</a>
            <a href="/nouns-money/rails/">How the rails fit ↗</a>
          </div>
          <p class="cb-disclose">Reserved: the rules and faces are published and nothing writes Desk Note lines yet. An agent never earns a note for itself. Collectible marks, never sold, redeemed or traded for money, and not part of Good Feels. Nouns art is CC0; not affiliated with or endorsed by Nouns DAO.</p>
        </div>
        <div class="cb-stack" aria-hidden="true">
          {notes.slice(0, 3).map((n) => <img src={noteFiles(n).front} width="1200" height="600" alt="" />)}
        </div>
      </section>

      {notes.map((n) => (
        <section class="cb-theme" id={n.id} aria-labelledby={`${n.id}-title`} style={`--accent:${n.palette.accent}`}>
          <div class="cb-theme-head">
            <h2 id={`${n.id}-title`}>{n.name}<em>.</em></h2>
            <p>{n.rule} One a day adds {n.points} points and a line to the open ledger. On your profile: {n.frame.toLowerCase()}.</p>
            <p class="cb-code">{serial(n)} · Noun #{n.nounId}</p>
          </div>
          <div class="cb-faces">
            <img src={noteFiles(n).front} width="1200" height="600" alt={`Front of the ${n.long}`} loading="lazy" />
            <img src={noteFiles(n).back} width="1200" height="600" alt={`Back of the ${n.long}: how it is earned`} loading="lazy" />
          </div>
        </section>
      ))}

      {art.length > 0 && (
        <section class="cb-section" aria-labelledby="dn-art">
          <h2 id="dn-art">Art pass, November 9</h2>
          <div class="rails-art">
            {art.map((a) => <figure><img src={a.src} width={a.width} height={a.height} alt={a.alt} loading="lazy" /><figcaption>{a.caption}</figcaption></figure>)}
          </div>
        </section>
      )}

      <footer class="cb-foot">
        <p>Machine edition: <a href="/currency-builder/desk-notes.json">desk-notes.json</a> · the agents: <a href="/desk/">the Desk</a>. Print faces are 150 × 75 mm SVGs.</p>
      </footer>
    </div>
  </div>
</BlockLayout>

<style>
  .rails-art { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .rails-art img { width: 100%; height: auto; display: block; border: 1px solid var(--cb-line); }
  .rails-art figcaption { font-size: 13px; color: var(--cb-muted); margin-top: 6px; }
</style>
