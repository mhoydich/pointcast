---
/**
 * /currency-builder/series-1/ — Nouns Money Series 1, the three notes you
 * earn by checking in: Enjoy. · KansasDAO Blue Note · Nouns Reserve.
 * Drawn by src/lib/currency-builder/series-one.mjs; earn rules from the open
 * ledger (src/lib/network-points.mjs).
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import ProfileLedgerCard from '../../../components/ProfileLedgerCard.astro';
import { SERIES_ONE, noteFiles, serial } from '../../../lib/currency-builder/series-one.mjs';
import { PROFILE_UNLOCKS, SISTER_TOWNS } from '../../../lib/network-points.mjs';
import { SERIES_ONE_ART } from '../../../data/currency-builder/series-one-art.mjs';
import '../../../styles/currency-builder.css';

const notes = SERIES_ONE.notes;
const description = 'Nouns Money Series 1 from Hoydich Enterprises: three collectible notes you earn by checking in on the PointCast network. Enjoy. for each day, a KansasDAO Blue Note for three in a row, a Nouns Reserve for seven or a new network town. No cash value.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Nouns Money · Series 1',
  description,
  url: 'https://pointcast.xyz/currency-builder/series-1/',
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Hoydich Enterprises' },
  hasPart: notes.map((n) => ({ '@type': 'CreativeWork', name: n.long, image: `https://pointcast.xyz${noteFiles(n).front}` })),
};
---
<BlockLayout title="Series 1 · Nouns Money · Currency Builder" description={description} image={noteFiles(notes[0]).front} imageAlt="The Enjoy. note, Nouns Money Series 1" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/series-1.json', title: 'Series 1 · machine edition' }, { type: 'application/json', href: '/points.json', title: 'Network Points rules' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="series-1" json="/currency-builder/series-1.json" />

      <section class="cb-hero" aria-labelledby="cb-title">
        <div>
          <p class="cb-kicker">Nouns Money · Hoydich Enterprises · {SERIES_ONE.season}</p>
          <h1 id="cb-title">Series 1<em>.</em><br />Earned by showing up.</h1>
          <p class="cb-dek">Three notes, and the only way to get one is to check in. From El Segundo, from Elizabeth, from anywhere on the network. Each lands on your profile, on every site, next to your points and your drum.</p>
          <div class="cb-stats">
            <div><strong>3</strong><span>notes</span></div>
            <div><strong>{notes.length}</strong><span>actual Nouns</span></div>
            <div><strong>{SISTER_TOWNS.length}</strong><span>network towns</span></div>
            <div><strong>0</strong><span>cash value</span></div>
          </div>
          <div class="cb-actions">
            <a href="/points/">How points work ↗</a>
            <a href="/nouns-money/enjoy/">The Enjoy. plan ↗</a>
          </div>
          <p class="cb-disclose">Collectible marks. Not legal tender, never sold, never redeemed, never traded for money, and not part of Good Feels or any cannabis program. Nouns art is CC0; not affiliated with or endorsed by Nouns DAO.</p>
        </div>
        <div class="cb-stack" aria-hidden="true">
          {notes.map((n) => <img src={noteFiles(n).front} width="1200" height="600" alt="" />)}
        </div>
      </section>

      {notes.map((n) => (
        <section class="cb-theme" id={n.id} aria-labelledby={`${n.id}-title`} style={`--accent:${n.palette.accent}`}>
          <div class="cb-theme-head">
            <h2 id={`${n.id}-title`}>{n.long}<em>.</em></h2>
            <p>{n.rule} Each one adds {n.points} points and a line to the open ledger. On your profile: {n.frame.toLowerCase()}.</p>
            <p class="cb-code">{serial(n)} · Noun #{n.nounId}</p>
          </div>
          <div class="cb-faces">
            <img src={noteFiles(n).front} width="1200" height="600" alt={`Front of the ${n.long}`} loading="lazy" />
            <img src={noteFiles(n).back} width="1200" height="600" alt={`Back of the ${n.long}: how it is earned`} loading="lazy" />
          </div>
        </section>
      ))}

      <section class="cb-section" aria-labelledby="s1-marks">
        <h2 id="s1-marks">What notes do on a profile</h2>
        <p class="cb-dek" style="max-width:56ch">Notes change how your profile card looks on PointCast, elsegundo.xyz, Industry Next and UES: {PROFILE_UNLOCKS.map((u) => u.label).join(', ')}. That is all they do. Here is yours:</p>
        <ProfileLedgerCard mode="me" app="series-1" />
      </section>

      {SERIES_ONE_ART.length > 0 && (
        <section class="cb-section" aria-labelledby="s1-art">
          <h2 id="s1-art">Art pass, November 9</h2>
          <p class="cb-dek" style="max-width:56ch">Midjourney studies for the printed notes, made from the November 8 mood boards (nounish pixel, retro-tech El Segundo). Directional art, not the print faces.</p>
          <div class="s1-art">
            {SERIES_ONE_ART.map((a) => (
              <figure><img src={a.src} width={a.width} height={a.height} alt={a.alt} loading="lazy" /><figcaption>{a.caption}</figcaption></figure>
            ))}
          </div>
        </section>
      )}

      <footer class="cb-foot">
        <p>Machine edition: <a href="/currency-builder/series-1.json">series-1.json</a> · ledger rules: <a href="/points.json">points.json</a> · line schema: <a href="/points/schema.json">schema.json</a>. Print faces are 150 × 75 mm SVGs.</p>
      </footer>
    </div>
  </div>
</BlockLayout>

<style>
  .s1-art { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .s1-art img { width: 100%; height: auto; display: block; border: 1px solid var(--cb-line); }
  .s1-art figcaption { font-size: 13px; color: var(--cb-muted); margin-top: 6px; }
</style>
