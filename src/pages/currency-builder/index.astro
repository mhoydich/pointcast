---
import BlockLayout from '../../layouts/BlockLayout.astro';
import Top from '../../components/currency-builder/Top.astro';
import { COMMONS } from '../../lib/currency-builder/commons.mjs';
import { BARTER } from '../../lib/currency-builder/barter.mjs';
import { ALMANAC } from '../../lib/currency-builder/almanac.mjs';
import { FEATURES } from '../../lib/currency-builder/security-edition.mjs';
import '../../styles/currency-builder.css';

const collections = [
  {
    href: '/currency-builder/commons/',
    image: '/images/og/currency-builder-commons.png',
    name: 'Commons',
    count: COMMONS.currencies.length,
    nouns: new Set(COMMONS.currencies.map((entry) => entry.nounId)).size,
    blurb: 'Currencies for the things a town shares: rooms and rides, radios and routers, pies and tool sheds, jars and fixes.',
  },
  {
    href: '/currency-builder/barter/',
    image: '/images/og/currency-builder-barter.png',
    name: 'Global Barter',
    count: BARTER.currencies.length,
    nouns: new Set(BARTER.currencies.map((entry) => entry.nounId)).size,
    blurb: 'Currencies inspired by the ways people trade without money around the world, each citing the tradition behind it.',
  },
  {
    href: '/currency-builder/almanac/',
    image: '/images/og/currency-builder-almanac.png',
    name: 'Almanac',
    count: ALMANAC.currencies.length,
    nouns: new Set(ALMANAC.currencies.map((entry) => entry.nounId)).size,
    blurb: 'One note for each week of the South Bay year, earned by noticing: whales both ways, grunion nights, the El Segundo blue, meteor showers and the earliest sunset.',
  },
  {
    href: '/currency-builder/security/',
    image: '/images/og/currency-builder-security.png',
    name: 'Security Edition',
    count: COMMONS.currencies.length + BARTER.currencies.length + ALMANAC.currencies.length,
    nouns: new Set([...COMMONS.currencies, ...BARTER.currencies, ...ALMANAC.currencies].map((entry) => entry.nounId)).size,
    blurb: `Every note again, set like a banknote: an engraved portrait of its full Noun, guilloche, watermark, thread, foil and ${FEATURES.length} printed features in all.`,
  },
];
const description = 'Currency Builder designs, prints and produces community-currency art. Collections of Nouns Money design concepts, each note carrying an actual CC0 Noun.';
---
<BlockLayout title="Currency Builder · design, print, produce" description={description} image="/images/og/currency-builder-commons.png" imageAlt="Commons currency designs from Currency Builder" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={null}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="home" />
      <section class="cb-hero" aria-labelledby="cb-title" style="grid-template-columns:minmax(0,1fr)">
        <div>
          <p class="cb-kicker">Nouns Money · El Segundo</p>
          <h1 id="cb-title">Design. Print.<br />Produce<em>.</em></h1>
          <p class="cb-dek" style="max-width:48ch">Currency Builder makes community-currency art: notes, stamps and medals for the ways people share and trade. Every note carries an actual CC0 Noun.</p>
          <p class="cb-disclose">Design concepts. Not legal tender, not for sale, no cash value, no redemption and no investment rights. Nouns art is CC0; not affiliated with or endorsed by Nouns DAO.</p>
        </div>
      </section>
      <section class="cb-collections" aria-label="Collections">
        {collections.map((c) => (
          <a class="cb-collection" href={c.href}>
            <img src={c.image} width="1200" height="630" alt="" loading="lazy" />
            <div>
              <p class="cb-code">{c.count} currencies · {c.nouns} actual Nouns</p>
              <h2>{c.name}</h2>
              <p>{c.blurb}</p>
            </div>
          </a>
        ))}
      </section>
      <footer class="cb-foot">
        <p>Machine editions: <a href="/currency-builder/commons.json">commons.json</a> · <a href="/currency-builder/barter.json">barter.json</a> · <a href="/currency-builder/almanac.json">almanac.json</a>. Print faces, including the <a href="/currency-builder/security/">Security Edition</a>, are 150 × 75 mm SVGs.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
