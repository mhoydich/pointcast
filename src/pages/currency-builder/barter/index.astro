---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import { BARTER, BASE, noteFiles, nounArt } from '../../../lib/currency-builder/barter.mjs';
import '../../../styles/currency-builder.css';

const byRegion = BARTER.regions.map((region) => ({
  ...region,
  currencies: BARTER.currencies.filter((entry) => entry.region === region.id),
})).filter((region) => region.currencies.length);
const hero = byRegion.slice(0, 3).map((region) => region.currencies[0]);
const total = BARTER.currencies.length;
const description = `${total} Currency Builder design concepts inspired by barter traditions around the world, each carrying a different actual CC0 Noun. Not legal tender; no cash value.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: BARTER.title,
  url: `https://pointcast.xyz${BASE}/`,
  description,
  isAccessibleForFree: true,
  creator: { '@type': 'Person', name: 'Mike Hoydich' },
  hasPart: BARTER.currencies.map((entry) => ({ '@type': 'CreativeWork', name: entry.name, url: `https://pointcast.xyz${BASE}/${entry.slug}/` })),
};
---
<BlockLayout title={`Global Barter · ${total} currencies · Currency Builder`} description={description} image="/images/og/currency-builder-barter.png" imageAlt="Three Global Barter currency designs from Currency Builder, each with an actual Noun" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/barter.json', title: 'Global Barter · machine edition' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <Top current="barter" json="/currency-builder/barter.json" />

      <section class="cb-hero" aria-labelledby="cb-title">
        <div>
          <p class="cb-kicker">Nouns Money · Global Barter collection</p>
          <h1 id="cb-title">Global Barter<em>.</em></h1>
          <p class="cb-dek">{total} currencies inspired by the ways people trade without money, from salt caravans and barter fairs to work parties and repair cafés. Every note carries a different actual Noun.</p>
          <div class="cb-stats">
            <div><strong>{total}</strong><span>currencies</span></div>
            <div><strong>{new Set(BARTER.currencies.map((entry) => entry.nounId)).size}</strong><span>actual Nouns</span></div>
            <div><strong>{byRegion.length}</strong><span>regions</span></div>
            <div><strong>{total * 2}</strong><span>print faces</span></div>
          </div>
          <p class="cb-disclose">Design concepts inspired by real traditions, not issued by or for the communities that keep them. Not legal tender, not for sale, no cash value, no redemption and no investment rights. Nouns art is CC0; not affiliated with or endorsed by Nouns DAO.</p>
        </div>
        <div class="cb-stack" aria-hidden="true">
          {hero.map((entry) => <img src={noteFiles(entry).front} width="1200" height="600" alt="" />)}
        </div>
      </section>

      <nav class="cb-chips" aria-label="Global Barter regions">
        {byRegion.map((region) => <a href={`#${region.id}`} style={`--chip:${region.palette.accent}`}><i></i>{region.name} · {region.currencies.length}</a>)}
      </nav>

      {byRegion.map((region) => (
        <section class="cb-theme" id={region.id} aria-labelledby={`${region.id}-title`} style={`--accent:${region.palette.accent}`}>
          <div class="cb-theme-head">
            <h2 id={`${region.id}-title`}>{region.name}<em>.</em><br />{region.motto}</h2>
            <p>{region.summary}</p>
          </div>
          <div class="cb-grid">
            {region.currencies.map((entry) => {
              const art = nounArt(entry.nounId);
              return (
                <a class="cb-card" href={`${BASE}/${entry.slug}/`}>
                  <img src={noteFiles(entry).front} width="1200" height="600" loading="lazy" alt="" />
                  <div>
                    <p class="cb-code">{entry.code} · Noun #{entry.nounId} · {art.labels.head}</p>
                    <h3>{entry.name}</h3>
                    <p class="cb-unit">{entry.place} · {entry.era}</p>
                    <p class="cb-line">{entry.line}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <h2 class="cb-sr" id="rules-title">How a Global Barter note works</h2>
      <section class="cb-rules" aria-labelledby="rules-title">
        <article><span>01</span><h3>Bring something</h3><p>Goods, a skill or a few hours of help. Every note starts with something real changing hands.</p></article>
        <article><span>02</span><h3>Take a ticket</h3><p>The note remembers the trade when the other half can't happen today, which is what barter has always needed.</p></article>
        <article><span>03</span><h3>Trade across time</h3><p>Spend it next week, next season or at another member's table. Like for like, whenever both sides are ready.</p></article>
        <article><span>04</span><h3>Settle in goods, never cash</h3><p>In these designs no note is sold or redeemed for money. Any group that runs one should still check how local law treats barter and community credit.</p></article>
      </section>

      <section class="cb-section cb-two" aria-labelledby="sources-title">
        <div>
          <h2 id="sources-title">Real traditions, cited.</h2>
          <p>Each note is inspired by a documented practice, from caravan trades to barter fairs, work parties, mutual-credit circuits and swap networks. Every reverse names the tradition and its era and cites a source; the detail pages link to it.</p>
          <p>These are design studies. The traditions belong to the people who keep them, and nothing here speaks for them.</p>
        </div>
        <div>
          <h2>Built for currencybuilder.xyz.</h2>
          <ul class="cb-list">
            <li><span>Machine edition</span><span><a href="/currency-builder/barter.json">barter.json</a></span></li>
            <li><span>Print faces</span><span>{total * 2} SVGs · front and back</span></li>
            <li><span>Trim</span><span>{BARTER.trim_mm.join(' × ')} mm · 2:1</span></li>
            <li><span>Nouns</span><span>#0–#99, each used once</span></li>
            <li><span>Status</span><span>Design concepts · no physical edition yet</span></li>
          </ul>
        </div>
      </section>

      <footer class="cb-foot">
        <p>Currency Builder · Global Barter, a Nouns Money collection from El Segundo. Design concepts only: these notes are not money, are not sold and carry no promise of goods, services, cash or returns. Any group that wants to run one should first check local rules for barter tax reporting, gift certificates and stored value, wage-and-hour law, and food and market permits.</p>
        <p>Nouns art is CC0; not affiliated with or endorsed by Nouns DAO. Collection data and print SVGs: <a href="/currency-builder/barter.json">/currency-builder/barter.json</a>.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
