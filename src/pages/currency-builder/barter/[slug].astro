---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import Top from '../../../components/currency-builder/Top.astro';
import { BARTER, BASE, noteFiles, nounArt, serial, region as regionOf } from '../../../lib/currency-builder/barter.mjs';
import '../../../styles/currency-builder.css';

export function getStaticPaths() {
  return BARTER.currencies.map((entry, index) => ({ params: { slug: entry.slug }, props: { entry, index } }));
}

const { entry, index } = Astro.props;
const region = regionOf(entry.region);
const art = nounArt(entry.nounId);
const files = noteFiles(entry);
const units = entry.denomination === 1 ? entry.unit : entry.units;
const total = BARTER.currencies.length;
const prev = BARTER.currencies[(index - 1 + total) % total];
const next = BARTER.currencies[(index + 1) % total];
const description = `${entry.name}: ${entry.line} Inspired by ${entry.tradition} (${entry.place}). A Global Barter design with actual Noun #${entry.nounId}. Design concept, not legal tender.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${entry.name} · Global Barter`,
  url: `https://pointcast.xyz${BASE}/${entry.slug}/`,
  description,
  image: `https://pointcast.xyz${files.front}`,
  citation: entry.source_url,
  isPartOf: { '@type': 'CollectionPage', name: BARTER.title, url: `https://pointcast.xyz${BASE}/` },
  isAccessibleForFree: true,
};
---
<BlockLayout title={`${entry.name} · Global Barter · Currency Builder`} description={description} image="/images/og/currency-builder-barter.png" imageAlt="Three Global Barter currency designs from Currency Builder, each with an actual Noun" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/barter.json', title: 'Global Barter · machine edition' }]}>
  <div class="cb" style={`--accent:${region.palette.accent}`}>
    <div class="cb-wrap">
      <Top current="barter" json="/currency-builder/barter.json" />

      <p class="cb-crumbs"><a href={`${BASE}/`}>Global Barter</a> / <a href={`${BASE}/#${region.id}`}>{region.name}</a> / {entry.code}</p>

      <section class="cb-detail-head" aria-labelledby="cb-name">
        <p class="cb-kicker">{region.name} · {entry.place} · {entry.code}</p>
        <h1 id="cb-name">{entry.name}</h1>
        <p>{entry.line}</p>
      </section>

      <section class="cb-faces" aria-label="Note faces">
        <figure>
          <a href={files.front}><img src={files.front} width="1200" height="600" alt={`Front of ${entry.name}: ${entry.denomination} ${units}, inspired by ${entry.tradition}, with actual Noun #${entry.nounId}`} /></a>
          <figcaption>Front · {BARTER.trim_mm.join(' × ')} mm</figcaption>
        </figure>
        <figure>
          <a href={files.back}><img src={files.back} width="1200" height="600" loading="lazy" alt={`Back of ${entry.name}: the ${entry.tradition} tradition, how a note would work, and the traits of Noun #${entry.nounId}`} /></a>
          <figcaption>Back · the tradition</figcaption>
        </figure>
      </section>

      <section class="cb-two" aria-label="Currency details">
        <div>
          <p class="cb-kicker">The tradition · {entry.era}</p>
          <h2 class="cb-tradition">{entry.tradition}</h2>
          <p style="font-size:19px;line-height:1.55">{entry.fact}</p>
          <p class="cb-source">Source: <a href={entry.source_url} rel="noopener">{entry.source_title} ↗</a></p>
          <p class="cb-kicker" style="margin-top:28px">How a note would work</p>
          <p style="font-size:19px;line-height:1.55">{entry.how}</p>
          <p class="cb-disclose">Design concept inspired by this tradition, not issued by or for the people who keep it. Not legal tender, not for sale, no cash value, no redemption and no investment rights.</p>
          <div class="cb-actions">
            <a href={files.front} download>Front SVG ↓</a>
            <a href={files.back} download>Back SVG ↓</a>
            <a href="/currency-builder/barter.json">Machine edition</a>
          </div>
        </div>
        <ul class="cb-list">
          <li><span>Place</span><span>{entry.place}</span></li>
          <li><span>Era</span><span>{entry.era}</span></li>
          <li><span>Region</span><span>{region.name}</span></li>
          <li><span>Unit</span><span>{entry.unit} · {entry.units}</span></li>
          <li><span>Face value</span><span>{entry.denomination} {units}</span></li>
          <li><span>Serial</span><span>{serial(entry)}</span></li>
          <li><span>Noun</span><span><a href={art.officialUrl}>Actual Noun #{entry.nounId} ↗</a></span></li>
          <li><span>Why this Noun</span><span>{entry.noun_fit}</span></li>
          <li><span>Head</span><span>{art.labels.head}</span></li>
          <li><span>Glasses</span><span>{art.labels.glasses}</span></li>
          <li><span>Body</span><span>{art.labels.body}</span></li>
          <li><span>Accessory</span><span>{art.labels.accessory}</span></li>
          <li><span>Seed</span><span>bg {art.seed.background} · body {art.seed.body} · acc {art.seed.accessory} · head {art.seed.head} · glasses {art.seed.glasses}</span></li>
        </ul>
      </section>

      <nav class="cb-pager" aria-label="More Global Barter currencies">
        <a href={`${BASE}/${prev.slug}/`}>← {prev.code} {prev.name}</a>
        <a href={`${BASE}/`}>All {total}</a>
        <a href={`${BASE}/${next.slug}/`}>{next.code} {next.name} →</a>
      </nav>

      <footer class="cb-foot">
        <p>Currency Builder · Global Barter. Nouns art is CC0; the Noun's pixels are drawn from the official trait data using its on-chain seed as recorded in the Nouns #0–99 provenance file. Not affiliated with or endorsed by Nouns DAO.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
