---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { COMMONS, BASE, noteFiles, nounArt, serial, theme as themeOf } from '../../../lib/currency-builder/commons.mjs';
import '../../../styles/currency-builder-commons.css';

export function getStaticPaths() {
  return COMMONS.currencies.map((entry, index) => ({ params: { slug: entry.slug }, props: { entry, index } }));
}

const { entry, index } = Astro.props;
const theme = themeOf(entry.theme);
const art = nounArt(entry.nounId);
const files = noteFiles(entry);
const units = entry.denomination === 1 ? entry.unit : entry.units;
const total = COMMONS.currencies.length;
const prev = COMMONS.currencies[(index - 1 + total) % total];
const next = COMMONS.currencies[(index + 1) % total];
const description = `${entry.name}: ${entry.line} A Commons ${theme.name.toLowerCase()} currency design with actual Noun #${entry.nounId}. Design concept, not legal tender.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${entry.name} · Commons`,
  url: `https://pointcast.xyz${BASE}/${entry.slug}/`,
  description,
  image: `https://pointcast.xyz${files.front}`,
  isPartOf: { '@type': 'CollectionPage', name: COMMONS.title, url: `https://pointcast.xyz${BASE}/` },
  isAccessibleForFree: true,
};
---
<BlockLayout title={`${entry.name} · Commons · Currency Builder`} description={description} image="/images/og/currency-builder-commons.png" imageAlt="Three Commons currency designs from Currency Builder, each with an actual Noun" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/commons.json', title: 'Commons · machine edition' }]}>
  <div class="cb" style={`--accent:${theme.palette.accent}`}>
    <div class="cb-wrap">
      <header class="cb-top">
        <a class="cb-mark" href={`${BASE}/`}>CURRENCY <span>BUILDER</span></a>
        <nav class="cb-nav" aria-label="Currency Builder">
          <a href={`${BASE}/`}>Commons</a>
          <a href="/nouns-money/">Nouns Money ↗</a>
          <a href="/currency/">Currency atlas ↗</a>
          <a href="/currency-builder/commons.json">JSON</a>
        </nav>
      </header>

      <p class="cb-crumbs"><a href={`${BASE}/`}>Commons</a> / <a href={`${BASE}/#${theme.id}`}>{theme.name}</a> / {entry.code}</p>

      <section class="cb-detail-head" aria-labelledby="cb-name">
        <p class="cb-kicker">{theme.name} · {theme.motto} · {entry.code}</p>
        <h1 id="cb-name">{entry.name}</h1>
        <p>{entry.line}</p>
      </section>

      <section class="cb-faces" aria-label="Note faces">
        <figure>
          <a href={files.front}><img src={files.front} width="1200" height="600" alt={`Front of ${entry.name}: ${entry.denomination} ${units}, actual Noun #${entry.nounId} with ${art.labels.head} head`} /></a>
          <figcaption>Front · {COMMONS.trim_mm.join(' × ')} mm</figcaption>
        </figure>
        <figure>
          <a href={files.back}><img src={files.back} width="1200" height="600" loading="lazy" alt={`Back of ${entry.name}: how it would work, and the traits of Noun #${entry.nounId}`} /></a>
          <figcaption>Back · how it would work</figcaption>
        </figure>
      </section>

      <section class="cb-two" aria-label="Currency details">
        <div>
          <p class="cb-kicker">How it would work</p>
          <p style="font-size:20px;line-height:1.5">{entry.how}</p>
          <p class="cb-disclose">Design concept for a community-credit system. Not legal tender, not for sale, no cash value, no redemption and no investment rights. In this design, credit is earned by contributing and spent on the shared thing.</p>
          <div class="cb-actions">
            <a href={files.front} download>Front SVG ↓</a>
            <a href={files.back} download>Back SVG ↓</a>
            <a href="/currency-builder/commons.json">Machine edition</a>
          </div>
        </div>
        <ul class="cb-list">
          <li><span>Unit</span><span>{entry.unit} · {entry.units}</span></li>
          <li><span>Face value</span><span>{entry.denomination} {units}</span></li>
          <li><span>Serial</span><span>{serial(entry)}</span></li>
          <li><span>System</span><span>{theme.name}</span></li>
          <li><span>Noun</span><span><a href={art.officialUrl}>Actual Noun #{entry.nounId} ↗</a></span></li>
          <li><span>Head</span><span>{art.labels.head}</span></li>
          <li><span>Glasses</span><span>{art.labels.glasses}</span></li>
          <li><span>Body</span><span>{art.labels.body}</span></li>
          <li><span>Accessory</span><span>{art.labels.accessory}</span></li>
          <li><span>Seed</span><span>bg {art.seed.background} · body {art.seed.body} · acc {art.seed.accessory} · head {art.seed.head} · glasses {art.seed.glasses}</span></li>
        </ul>
      </section>

      <nav class="cb-pager" aria-label="More Commons currencies">
        <a href={`${BASE}/${prev.slug}/`}>← {prev.code} {prev.name}</a>
        <a href={`${BASE}/`}>All 40</a>
        <a href={`${BASE}/${next.slug}/`}>{next.code} {next.name} →</a>
      </nav>

      <footer class="cb-foot">
        <p>Currency Builder · Commons. Nouns art is CC0; the Noun's pixels are drawn from the official trait data using its on-chain seed as recorded in the Nouns #0–99 provenance file. Not affiliated with or endorsed by Nouns DAO.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
