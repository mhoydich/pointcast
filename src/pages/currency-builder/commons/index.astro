---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { COMMONS, BASE, noteFiles, nounArt } from '../../../lib/currency-builder/commons.mjs';
import '../../../styles/currency-builder-commons.css';

const byTheme = COMMONS.themes.map((theme) => ({
  ...theme,
  currencies: COMMONS.currencies.filter((entry) => entry.theme === theme.id),
}));
const heroSlugs = ['porch-note', 'microgrid', 'slice'];
const hero = heroSlugs.map((slug) => COMMONS.currencies.find((entry) => entry.slug === slug));
const description = 'Forty Currency Builder design concepts for renting, meshing, sharing and bartering, each carrying a different actual CC0 Noun. Not legal tender; no cash value.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: COMMONS.title,
  url: `https://pointcast.xyz${BASE}/`,
  description,
  isAccessibleForFree: true,
  creator: { '@type': 'Person', name: 'Mike Hoydich' },
  hasPart: COMMONS.currencies.map((entry) => ({ '@type': 'CreativeWork', name: entry.name, url: `https://pointcast.xyz${BASE}/${entry.slug}/` })),
};
---
<BlockLayout title="Commons · 40 currencies · Currency Builder" description={description} image="/images/og/currency-builder-commons.png" imageAlt="Three Commons currency designs from Currency Builder, each with an actual Noun" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/currency-builder/commons.json', title: 'Commons · machine edition' }]}>
  <div class="cb">
    <div class="cb-wrap">
      <header class="cb-top">
        <a class="cb-mark" href={`${BASE}/`}>CURRENCY <span>BUILDER</span></a>
        <nav class="cb-nav" aria-label="Currency Builder">
          <a href={`${BASE}/`} aria-current="page">Commons</a>
          <a href="/nouns-money/">Nouns Money ↗</a>
          <a href="/currency/">Currency atlas ↗</a>
          <a href="/currency-builder/commons.json">JSON</a>
        </nav>
      </header>

      <section class="cb-hero" aria-labelledby="cb-title">
        <div>
          <p class="cb-kicker">Nouns Money · Commons collection</p>
          <h1 id="cb-title">Commons<em>.</em></h1>
          <p class="cb-dek">Forty currencies for the things a town shares: rooms and rides, radios and routers, pies and tool sheds, jars and fixes. Every note carries a different actual Noun.</p>
          <div class="cb-stats">
            <div><strong>40</strong><span>currencies</span></div>
            <div><strong>40</strong><span>actual Nouns</span></div>
            <div><strong>4</strong><span>systems</span></div>
            <div><strong>80</strong><span>print faces</span></div>
          </div>
          <p class="cb-disclose">Design concepts for community-credit systems. Not legal tender, not for sale, no cash value, no redemption and no investment rights. Nouns art is CC0; no Nouns DAO endorsement is implied.</p>
        </div>
        <div class="cb-stack" aria-hidden="true">
          {hero.map((entry) => <img src={noteFiles(entry).front} width="1200" height="600" alt="" />)}
        </div>
      </section>

      <nav class="cb-chips" aria-label="Commons systems">
        {byTheme.map((theme) => <a href={`#${theme.id}`} style={`--chip:${theme.palette.accent}`}><i></i>{theme.name} · {theme.currencies.length}</a>)}
      </nav>

      {byTheme.map((theme) => (
        <section class="cb-theme" id={theme.id} aria-labelledby={`${theme.id}-title`} style={`--accent:${theme.palette.accent}`}>
          <div class="cb-theme-head">
            <h2 id={`${theme.id}-title`}>{theme.name}<em>.</em><br />{theme.motto}</h2>
            <p>{theme.summary}</p>
          </div>
          <div class="cb-grid">
            {theme.currencies.map((entry) => {
              const art = nounArt(entry.nounId);
              const units = entry.denomination === 1 ? entry.unit : entry.units;
              return (
                <a class="cb-card" href={`${BASE}/${entry.slug}/`}>
                  <img src={noteFiles(entry).front} width="1200" height="600" loading="lazy" alt="" />
                  <div>
                    <p class="cb-code">{entry.code} · Noun #{entry.nounId} · {art.labels.head}</p>
                    <h3>{entry.name}</h3>
                    <p class="cb-unit">{entry.denomination} {units}</p>
                    <p class="cb-line">{entry.line}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <h2 class="cb-sr" id="rules-title">How a Commons currency works</h2>
      <section class="cb-rules" aria-labelledby="rules-title">
        <article><span>01</span><h3>Earned by contributing</h3><p>You get credit for hosting, lending, relaying, cooking, fixing or cleaning: the work that keeps the shared thing going.</p></article>
        <article><span>02</span><h3>Spent on the shared thing</h3><p>Credit buys a turn with the room, the ride, the tool, the court or the jar. It is a queue with manners, not a wallet.</p></article>
        <article><span>03</span><h3>Never sold, never cashed out</h3><p>In these designs no one sells credit and no one redeems it for money. Any group that runs one should still check how local law treats community credit.</p></article>
        <article><span>04</span><h3>A ledger people can read</h3><p>Balances are public to members, disputes go to a person at a table, and the rules fit on the back of the note.</p></article>
      </section>

      <section class="cb-section cb-two" aria-labelledby="actual-title">
        <div>
          <h2 id="actual-title">Forty actual Nouns.</h2>
          <p>Each note's Noun is chosen for its head: a house for the Porch Note, a lightning bolt for the Microgrid, a pizza for the Slice, an oyster for the Shell. No Noun appears twice.</p>
          <p>The pixels are drawn from the official CC0 Nouns trait data using each Noun's on-chain seed, as recorded from the Nouns subgraph in the <a href="/images/nouns-money/source-100/provenance.json">Nouns #0–99 provenance file</a>, where the renders are checked against the official trait data. Every note's reverse lists the traits and links to the Noun itself.</p>
        </div>
        <div>
          <h2>Built for currencybuilder.xyz.</h2>
          <ul class="cb-list">
            <li><span>Machine edition</span><span><a href="/currency-builder/commons.json">commons.json</a></span></li>
            <li><span>Print faces</span><span>80 SVGs · front and back</span></li>
            <li><span>Trim</span><span>{COMMONS.trim_mm.join(' × ')} mm · 2:1</span></li>
            <li><span>Art source</span><span>Official CC0 trait data · recorded on-chain seeds</span></li>
            <li><span>Status</span><span>Design concepts · no physical edition yet</span></li>
          </ul>
        </div>
      </section>

      <footer class="cb-foot">
        <p>Currency Builder · Commons, a Nouns Money collection from El Segundo. Design concepts only: these notes are not money, are not sold and carry no promise of goods, services, cash or returns. Any group that wants to run one should first check local rules for time banks, gift certificates and stored value, wage-and-hour law, barter tax reporting, food permits, and any utility, transport or fishing rules that apply.</p>
        <p>Nouns art is CC0; Currency Builder is not affiliated with or endorsed by Nouns DAO. Collection data and print SVGs: <a href="/currency-builder/commons.json">/currency-builder/commons.json</a>.</p>
      </footer>
    </div>
  </div>
</BlockLayout>
