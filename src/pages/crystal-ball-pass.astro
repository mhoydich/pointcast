---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  CRYSTAL_BALL_PASS_DESCRIPTION,
  CRYSTAL_BALL_PASS_TITLE,
  CRYSTAL_BALL_PASS_TRAIL,
} from '../lib/crystal-ball-pass';
import '../styles/crystal-ball-pass.css';

const firstScene = CRYSTAL_BALL_PASS_TRAIL[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': 'https://pointcast.xyz/crystal-ball-pass#game',
  name: CRYSTAL_BALL_PASS_TITLE,
  description: CRYSTAL_BALL_PASS_DESCRIPTION,
  url: 'https://pointcast.xyz/crystal-ball-pass',
  image: 'https://pointcast.xyz/images/crystal-ball-pass/og.png',
  gamePlatform: 'Web browser',
  applicationCategory: 'GameApplication',
  playMode: 'SinglePlayer',
  author: {
    '@type': 'Organization',
    name: 'PointCast × Codex',
    url: 'https://pointcast.xyz',
  },
};
---

<BaseLayout
  title={`${CRYSTAL_BALL_PASS_TITLE} — A very small forest expedition`}
  description={CRYSTAL_BALL_PASS_DESCRIPTION}
  image="/images/crystal-ball-pass/og.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/crystal-ball-pass.json', title: 'Crystal Ball Pass game manifest' }]}
>
  <main id="pass-app" class="pass-shell phase-0" style={`--scene-hue:${firstScene.hue};--trail-progress:0%`}>
    <div class="pass-stage" aria-hidden="true">
      <div class="pass-sky"></div>
      <div class="pass-moon"></div>
      <div class="pass-mountain pass-mountain--back"></div>
      <div class="pass-mountain pass-mountain--front"></div>
      <div class="pass-mist pass-mist--one"></div>
      <div class="pass-mist pass-mist--two"></div>
      <div class="pass-trees pass-trees--back">
        {Array.from({ length: 12 }).map(() => <i></i>)}
      </div>
      <div class="pass-river"></div>
      <div class="pass-trees pass-trees--front">
        {Array.from({ length: 9 }).map(() => <i></i>)}
      </div>
      <div class="pass-orb"><span></span></div>
      <div class="pass-fireflies">
        {Array.from({ length: 14 }).map(() => <i></i>)}
      </div>
      <div class="pass-grain"></div>
    </div>

    <header class="pass-topbar">
      <a class="pass-wordmark" href="/" aria-label="PointCast home">
        <span class="pass-mark">✦</span>
        <span>POINTCAST / CRYSTAL BALL PASS</span>
      </a>
      <div class="pass-tools">
        <button class="pass-utility" id="sound-toggle" type="button" aria-label="Mute forest sound">
          <span class="pass-sound-dot active"></span>
          <span data-sound-label>SOUND ON</span>
        </button>
        <button class="pass-utility" id="magic-open" type="button" aria-haspopup="dialog">CAMP MAGIC</button>
      </div>
    </header>

    <section class="pass-map" aria-label="Trail progress">
      <div class="pass-map-label"><span>FERNWAKE</span><span data-progress-label>0% TO THE PASS</span></div>
      <div class="pass-track">
        <span class="pass-track-fill"></span>
        {CRYSTAL_BALL_PASS_TRAIL.map((scene, index) => (
          <i class={index === 0 ? 'current' : ''} data-track-point={index} title={scene.place}></i>
        ))}
        <i class="pass-marker">◇</i>
      </div>
    </section>

    <section class="pass-layout">
      <aside class="pass-stats" aria-label="Trail status">
        <div class="pass-day"><small>PASSAGE</small><strong data-day>01</strong></div>
        <dl>
          <div><dt>TRAIL</dt><dd><span data-miles>0</span> MI</dd></div>
          <div>
            <dt>WARMTH</dt><dd><span data-warmth>78</span>%</dd>
            <span class="pass-meter"><i data-warmth-meter style="width:78%"></i></span>
          </div>
          <div><dt>FOOD</dt><dd><span data-food>7</span> MEALS</dd></div>
          <div><dt>WONDER</dt><dd data-wonder>12</dd></div>
        </dl>
        <p class="pass-weather" data-weather>{firstScene.weather}</p>
      </aside>

      <section class="pass-story" aria-live="polite">
        <div data-playing-view>
          <div class="pass-location"><span data-place>{firstScene.place}</span><span data-time>{firstScene.time}</span></div>
          <h1 data-title>{firstScene.title}</h1>
          <p class="pass-story-copy" data-story>{firstScene.story}</p>
          <div class="pass-choices" data-choices>
            {firstScene.choices.map((choice, index) => (
              <button class="pass-choice" type="button" data-choice={index}>
                <span class="pass-choice-number">0{index + 1}</span>
                <span class="pass-choice-copy"><strong>{choice.label}</strong><small>{choice.detail}</small></span>
                <span class="pass-choice-arrow">↗</span>
              </button>
            ))}
          </div>
        </div>
        <div class="pass-ending" data-ending hidden>
          <span class="pass-ending-kicker" data-ending-kicker>PASSAGE COMPLETE</span>
          <h1 data-ending-title>The crystal remembers you.</h1>
          <p data-ending-copy></p>
          <div class="pass-score"><span>FOREST SCORE</span><strong data-score>0</strong></div>
          <button class="pass-restart" type="button" data-restart>WALK IT AGAIN <span>↻</span></button>
        </div>
      </section>

      <aside class="pass-micro">
        <div class="pass-micro-head"><span>CODEX MICRO</span><span class="pass-micro-light"></span></div>
        <div class="pass-micro-screen">
          <div class="pass-pixel-face" aria-hidden="true"><i></i><i></i><b></b></div>
          <p data-micro>{firstScene.micro}</p>
        </div>
        <div class="pass-micro-dial"><span>CM–01</span><i></i><span>FOREST OS</span></div>
        <div class="pass-logbook">
          <span>RECENT FIELD NOTES</span>
          <ol data-log><li>Packed: wool blanket, six oatcakes, one questionable compass.</li></ol>
        </div>
      </aside>
    </section>

    <footer class="pass-footer">
      <span>A VERY SMALL FOREST EXPEDITION</span>
      <span><a href="/reviews/crystal-ball-pass">POINTCAST REVIEW 4.6 / 5 ↗</a> · NO ACCOUNT REQUIRED</span>
    </footer>

    <div class="pass-intro" data-intro>
      <div class="pass-intro-card">
        <span class="pass-eyebrow">A POINTCAST × CODEX MICRO ADVENTURE</span>
        <div class="pass-intro-orb" aria-hidden="true"><span>✦</span></div>
        <h1>CRYSTAL<br />BALL PASS</h1>
        <p>Forty-two miles of wet socks, strange weather, luminous mushrooms, and one very patient mountain.</p>
        <button class="pass-begin" type="button" data-begin>BEGIN PASSAGE <span>→</span></button>
        <small>PLAYS IN ABOUT 5 MINUTES · HEADPHONES NICE, NOT REQUIRED</small>
      </div>
    </div>

    <div class="pass-drawer-scrim" data-drawer hidden>
      <section class="pass-drawer" role="dialog" aria-modal="true" aria-labelledby="camp-magic-title">
        <button class="pass-drawer-close" type="button" data-drawer-close aria-label="Close camp magic">×</button>
        <span class="pass-eyebrow">OPTIONAL CAMP MAGIC</span>
        <h2 id="camp-magic-title">Let the room join the trail.</h2>
        <p class="pass-drawer-intro">Accounts are never required. This field edition opens the official service login separately and keeps the game itself private.</p>
        <article class="pass-service">
          <div class="pass-service-icon">♫</div>
          <div><strong>Spotify</strong><p>Open Spotify, then bring back whatever sounds like fog.</p></div>
          <a href="https://accounts.spotify.com/" target="_blank" rel="noopener noreferrer" data-service="Spotify">OPEN LOGIN ↗</a>
        </article>
        <article class="pass-service">
          <div class="pass-service-icon">☼</div>
          <div><strong>Philips Hue</strong><p>Preview the current scene color, with or without a bridge.</p></div>
          <a href="https://account.meethue.com/" target="_blank" rel="noopener noreferrer" data-service="Hue">OPEN LOGIN ↗</a>
        </article>
        <button class="pass-light-preview" type="button" data-light-preview>
          <span data-light-swatch style={`background:${firstScene.hue}`}></span>
          <b data-light-label>PREVIEW FOREST LIGHT</b>
          <small data-light-place>{firstScene.place.toUpperCase()} · {firstScene.hue}</small>
        </button>
        <p class="pass-service-note" data-service-note></p>
        <small class="pass-privacy">No Spotify or Hue account data is received by this page.</small>
      </section>
    </div>
  </main>

  <script>
    import { CRYSTAL_BALL_PASS_TRAIL } from '../lib/crystal-ball-pass';
    import type { CrystalBallPassChoice, CrystalBallPassStats } from '../lib/crystal-ball-pass';

    const app = document.querySelector<HTMLElement>('#pass-app');
    if (!app) throw new Error('Crystal Ball Pass app shell was not found.');

    const query = <T extends Element>(selector: string) => {
      const element = app.querySelector<T>(selector);
      if (!element) throw new Error(`Crystal Ball Pass control missing: ${selector}`);
      return element;
    };

    let sceneIndex = 0;
    let stats: CrystalBallPassStats = { warmth: 78, provisions: 7, wonder: 12, miles: 0 };
    let log = ['Packed: wool blanket, six oatcakes, one questionable compass.'];
    let soundOn = true;
    let audioContext: AudioContext | null = null;

    const clamp = (value: number, minimum = 0, maximum = 100) =>
      Math.min(maximum, Math.max(minimum, value));

    const playTone = (frequency: number) => {
      if (!soundOn) return;
      const AudioCtor = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioCtor) return;
      audioContext ??= new AudioCtor();
      const now = audioContext.currentTime;
      const oscillator = audioContext.createOscillator();
      const overtone = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      overtone.type = 'triangle';
      oscillator.frequency.setValueAtTime(frequency, now);
      overtone.frequency.setValueAtTime(frequency * 1.505, now);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.07, now + 0.03);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.6);
      oscillator.connect(gain);
      overtone.connect(gain);
      gain.connect(audioContext.destination);
      oscillator.start(now);
      overtone.start(now);
      oscillator.stop(now + 1.65);
      overtone.stop(now + 1.65);
    };

    const updateStats = () => {
      query<HTMLElement>('[data-miles]').textContent = String(stats.miles);
      query<HTMLElement>('[data-warmth]').textContent = String(stats.warmth);
      query<HTMLElement>('[data-food]').textContent = String(stats.provisions);
      query<HTMLElement>('[data-wonder]').textContent = String(stats.wonder);
      query<HTMLElement>('[data-warmth-meter]').style.width = `${stats.warmth}%`;
    };

    const updateLog = () => {
      const list = query<HTMLOListElement>('[data-log]');
      list.replaceChildren(...log.slice(0, 3).map((entry) => {
        const item = document.createElement('li');
        item.textContent = entry;
        return item;
      }));
    };

    const finish = (won: boolean) => {
      query<HTMLElement>('[data-playing-view]').hidden = true;
      query<HTMLElement>('[data-ending]').hidden = false;
      query<HTMLElement>('[data-ending-kicker]').textContent = won ? 'PASSAGE COMPLETE' : 'THE FOREST WAITS';
      query<HTMLElement>('[data-ending-title]').textContent = won ? 'The crystal remembers you.' : 'Cold wins this round.';
      query<HTMLElement>('[data-ending-copy]').textContent = won
        ? `You reached Crystal Ball Pass with ${stats.warmth}% warmth and enough wonder to light the walk home.`
        : 'Codex Micro has marked a warm cabin nearby. Rest, repack, and try the trail again.';
      query<HTMLElement>('[data-score]').textContent = String(Math.max(0, stats.wonder + stats.warmth + stats.provisions * 3));
      app.style.setProperty('--trail-progress', won ? '100%' : `${Math.round((sceneIndex / CRYSTAL_BALL_PASS_TRAIL.length) * 100)}%`);
    };

    const choose = (choice: CrystalBallPassChoice) => {
      playTone(choice.tone);
      stats = {
        warmth: clamp(stats.warmth + (choice.delta.warmth ?? 0)),
        provisions: Math.max(0, stats.provisions + (choice.delta.provisions ?? 0)),
        wonder: clamp(stats.wonder + (choice.delta.wonder ?? 0), 0, 120),
        miles: stats.miles + (choice.delta.miles ?? 0),
      };
      log = [choice.result, ...log].slice(0, 4);
      updateStats();
      updateLog();
      if (stats.warmth <= 0) return finish(false);
      if (sceneIndex === CRYSTAL_BALL_PASS_TRAIL.length - 1) return finish(true);
      sceneIndex += 1;
      renderScene();
    };

    const renderChoices = () => {
      const choices = query<HTMLElement>('[data-choices]');
      choices.replaceChildren(...CRYSTAL_BALL_PASS_TRAIL[sceneIndex].choices.map((choice, index) => {
        const button = document.createElement('button');
        button.className = 'pass-choice';
        button.type = 'button';
        const number = document.createElement('span');
        number.className = 'pass-choice-number';
        number.textContent = `0${index + 1}`;
        const copy = document.createElement('span');
        copy.className = 'pass-choice-copy';
        const title = document.createElement('strong');
        title.textContent = choice.label;
        const detail = document.createElement('small');
        detail.textContent = choice.detail;
        copy.append(title, detail);
        const arrow = document.createElement('span');
        arrow.className = 'pass-choice-arrow';
        arrow.textContent = '↗';
        button.append(number, copy, arrow);
        button.addEventListener('click', () => choose(choice));
        return button;
      }));
    };

    const renderScene = () => {
      const scene = CRYSTAL_BALL_PASS_TRAIL[sceneIndex];
      const progress = Math.round((sceneIndex / CRYSTAL_BALL_PASS_TRAIL.length) * 100);
      app.className = `pass-shell phase-${Math.min(sceneIndex, 6)}${app.classList.contains('hue-preview') ? ' hue-preview' : ''}`;
      app.style.setProperty('--scene-hue', scene.hue);
      app.style.setProperty('--trail-progress', `${progress}%`);
      query<HTMLElement>('[data-progress-label]').textContent = `${progress}% TO THE PASS`;
      query<HTMLElement>('[data-place]').textContent = scene.place;
      query<HTMLElement>('[data-time]').textContent = scene.time;
      query<HTMLElement>('[data-weather]').textContent = scene.weather;
      query<HTMLElement>('[data-title]').textContent = scene.title;
      query<HTMLElement>('[data-story]').textContent = scene.story;
      query<HTMLElement>('[data-micro]').textContent = scene.micro;
      query<HTMLElement>('[data-day]').textContent = `0${Math.min(3, 1 + Math.floor(sceneIndex / 3))}`;
      query<HTMLElement>('[data-light-swatch]').style.background = scene.hue;
      query<HTMLElement>('[data-light-place]').textContent = `${scene.place.toUpperCase()} · ${scene.hue}`;
      app.querySelectorAll<HTMLElement>('[data-track-point]').forEach((point, index) => {
        point.className = index < sceneIndex ? 'passed' : index === sceneIndex ? 'current' : '';
      });
      renderChoices();
    };

    query<HTMLButtonElement>('[data-begin]').addEventListener('click', () => {
      query<HTMLElement>('[data-intro]').hidden = true;
      playTone(392);
    });

    app.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) => {
      button.addEventListener('click', () => choose(CRYSTAL_BALL_PASS_TRAIL[0].choices[Number(button.dataset.choice)]));
    });

    query<HTMLButtonElement>('#sound-toggle').addEventListener('click', () => {
      soundOn = !soundOn;
      query<HTMLElement>('[data-sound-label]').textContent = soundOn ? 'SOUND ON' : 'SOUND OFF';
      query<HTMLElement>('.pass-sound-dot').classList.toggle('active', soundOn);
      query<HTMLButtonElement>('#sound-toggle').ariaLabel = soundOn ? 'Mute forest sound' : 'Turn on forest sound';
      if (soundOn) playTone(392);
    });

    const drawer = query<HTMLElement>('[data-drawer]');
    query<HTMLButtonElement>('#magic-open').addEventListener('click', () => { drawer.hidden = false; });
    query<HTMLButtonElement>('[data-drawer-close]').addEventListener('click', () => { drawer.hidden = true; });
    drawer.addEventListener('click', (event) => { if (event.target === drawer) drawer.hidden = true; });

    query<HTMLButtonElement>('[data-light-preview]').addEventListener('click', () => {
      const enabled = app.classList.toggle('hue-preview');
      query<HTMLElement>('[data-light-label]').textContent = enabled ? 'LIGHT PREVIEW ON' : 'PREVIEW FOREST LIGHT';
      query<HTMLButtonElement>('[data-light-preview]').classList.toggle('active', enabled);
    });

    app.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach((link) => {
      link.addEventListener('click', () => {
        query<HTMLElement>('[data-service-note]').textContent = `${link.dataset.service} opened separately. This page receives no account or playback data.`;
      });
    });

    query<HTMLButtonElement>('[data-restart]').addEventListener('click', () => {
      sceneIndex = 0;
      stats = { warmth: 78, provisions: 7, wonder: 12, miles: 0 };
      log = ['Packed: wool blanket, six oatcakes, one questionable compass.'];
      query<HTMLElement>('[data-playing-view]').hidden = false;
      query<HTMLElement>('[data-ending]').hidden = true;
      updateStats();
      updateLog();
      renderScene();
    });
  </script>
</BaseLayout>
