---
/**
 * /nouns-stamps — postage-stamp grid of Nouns.
 *
 * Mike: "go 5 more." Fifth of five. Vintage postage-stamp aesthetic
 * — a 6×4 sheet of 24 stamps, each carrying a Noun. Each stamp has
 * a perforated edge (CSS radial-gradient mask), a denomination, a
 * country-of-origin label ("EL SEGUNDO"), and a stamp color
 * (assorted muted vintage palettes). Hover for hover-glow.
 *
 * Click any stamp to "cancel" it — a soft postmark stamp overlay
 * appears (concentric circles + date), with a thunk sound.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Stamps · Noun Postage · PointCast';
const description =
  'A sheet of vintage Noun postage stamps. Click to cancel any stamp with a postmark.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Stamps',
  url: 'https://pointcast.xyz/nouns-stamps',
  description,
  applicationCategory: 'VisualArts',
};

// 24 stamps — vintage muted color palette assortment
const COLORS = [
  '#9c4a32', '#3a6f4a', '#5a3a18', '#3a4a6a', '#7a4a30',
  '#4a6a3a', '#7a3a52', '#5a5a2a', '#3a4a5a', '#7a5a32',
  '#4a3a6a', '#6a4a4a', '#3a5a3a', '#5a3a2a', '#3a3a5a',
  '#7a4a3a', '#4a4a4a', '#5a3a3a', '#3a5a4a', '#6a3a4a',
  '#4a3a3a', '#5a4a3a', '#3a4a4a', '#6a4a3a',
];
const DENOMINATIONS = ['1¢', '3¢', '5¢', '10¢', '15¢', '25¢', '50¢', '$1', '$2'];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="ns" id="ns-main">
    <DrumNav current="stamps" />

    <header class="ns__header">
      <div class="ns__chrome">
        <span>STAMPS</span>
        <span class="ns__chrome-sep">·</span>
        <span>NOUN POSTAGE · EL SEGUNDO</span>
        <span class="ns__chrome-sep">·</span>
        <span id="ns-cancelled">0 CANCELLED</span>
      </div>
      <h1 class="ns__title">POSTAGE</h1>
      <p class="ns__tagline">a sheet of twenty-four · click to cancel each one</p>
    </header>

    <section class="ns__sheet" id="ns-sheet">
      {Array.from({ length: 24 }, (_, i) => i).map((i) => {
        const color = COLORS[i % COLORS.length];
        const denom = DENOMINATIONS[i % DENOMINATIONS.length];
        return (
          <button class="ns__stamp" type="button" data-idx={i} style={`--stamp-color: ${color};`}>
            <div class="ns__stamp-bg"></div>
            <div class="ns__stamp-inner">
              <div class="ns__stamp-top">
                <span class="ns__stamp-country">EL SEGUNDO</span>
                <span class="ns__stamp-denom">{denom}</span>
              </div>
              <img class="ns__stamp-noun" alt="" data-stamp-noun loading="lazy" />
              <div class="ns__stamp-bottom">
                <span class="ns__stamp-num" data-stamp-num>—</span>
                <span class="ns__stamp-pc">P / C</span>
              </div>
            </div>
            <div class="ns__cancel" aria-hidden="true">
              <svg viewBox="0 0 100 100" width="80" height="80">
                <circle cx="50" cy="50" r="38" fill="none" stroke="#1a1a1a" stroke-width="2.5"/>
                <circle cx="50" cy="50" r="32" fill="none" stroke="#1a1a1a" stroke-width="1.2"/>
                <text x="50" y="38" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="8" font-weight="bold" letter-spacing="2" fill="#1a1a1a">PC POST</text>
                <text x="50" y="56" text-anchor="middle" font-family="Gloock, Lora, serif" font-size="14" font-weight="bold" fill="#1a1a1a" data-cancel-date>—</text>
                <text x="50" y="68" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="6" letter-spacing="1.5" fill="#1a1a1a">EL SEGUNDO</text>
                <line x1="22" y1="22" x2="78" y2="78" stroke="#1a1a1a" stroke-width="2" opacity="0.5"/>
              </svg>
            </div>
          </button>
        );
      })}
    </section>

    <footer class="ns__controls">
      <button class="ns__btn ns__btn--primary" id="ns-refresh" type="button">FRESH SHEET</button>
      <p class="ns__instructions">
        Click any stamp to apply a postmark cancellation. FRESH SHEET prints a new sheet of 24.
      </p>
    </footer>
    <aside class="ns__arcade">
      <div><span>NEW / TEN SMALL PRESSES</span><h2>Noun stamps now have an arcade wing.</h2><p>Choose one of ten visual presses, set the signal, then carry the exact draft into Nounfound for a wallet-approved mint.</p></div>
      <a href="https://arcade-60.mhoydich.chatgpt.site/#minters" target="_blank" rel="noreferrer">OPEN THE TEN PRESSES ↗</a>
    </aside>
  </main>
</BlockLayout>

<style is:global>
  body:has(#ns-main) { background: #f4e9d2; }
  .ns__arcade{max-width:1080px;margin:38px auto 0;padding:30px;border:2px solid var(--ns-ink);background:#c7e744;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end}.ns__arcade span{font:700 9px var(--pc-font-mono,monospace);letter-spacing:.15em}.ns__arcade h2{font:400 clamp(30px,4vw,58px)/.95 'Gloock',Georgia,serif;margin:18px 0}.ns__arcade p{font:italic 16px/1.45 'Lora',Georgia,serif;max-width:660px}.ns__arcade a{padding:15px 18px;background:var(--ns-ink);color:#f4e9d2;text-decoration:none;font:700 9px var(--pc-font-mono,monospace);letter-spacing:.13em;white-space:nowrap}@media(max-width:700px){.ns__arcade{grid-template-columns:1fr}.ns__arcade a{text-align:center}}
  .ns {
    --ns-paper: #f4e9d2;
    --ns-paper-deep: #d8c89e;
    --ns-ink: #1a1a1a;
    --ns-rose: #c4351c;
    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 32px clamp(16px, 2vw, 56px) 48px;
    color: var(--ns-ink);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 100%, rgba(0, 0, 0, 0.06), transparent 60%),
      var(--ns-paper);
    min-height: calc(100vh - 80px);
  }
  .ns::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 30% 30%, rgba(0, 0, 0, 0.04) 1.5px, transparent 2px),
      radial-gradient(circle at 70% 70%, rgba(0, 0, 0, 0.03) 1.5px, transparent 2px);
    background-size: 90px 90px;
    opacity: 0.7;
  }
  .ns .drum-nav { opacity: 0.55; }
  .ns .drum-nav__pill { color: #1a1a1a; }

  .ns__header { text-align: center; margin-bottom: clamp(24px, 4vh, 40px); }
  .ns__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 5px 18px; border: 2px solid var(--ns-ink); border-radius: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ns-ink); background: #ffffff;
  }
  .ns__chrome-sep { color: var(--ns-rose); }
  #ns-cancelled { color: var(--ns-rose); font-weight: 700; }

  .ns__title {
    margin: clamp(12px, 1.6vh, 20px) 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(48px, 8vw, 108px); font-weight: 400; letter-spacing: 0.04em;
    color: var(--ns-ink); line-height: 0.95;
  }
  .ns__tagline {
    margin: 0 auto; max-width: 520px;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(14px, 1.3vw, 18px); color: #5a5a5a;
  }

  /* Sheet — 6 cols × 4 rows */
  .ns__sheet {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(8px, 1.2vw, 16px);
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px;
    background: var(--ns-paper-deep);
    border: 2px solid var(--ns-ink);
    box-shadow:
      inset 0 0 30px rgba(0, 0, 0, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.15);
  }
  @media (max-width: 720px) { .ns__sheet { grid-template-columns: repeat(3, 1fr); } }

  /* Stamp — perforated edge via CSS mask */
  .ns__stamp {
    position: relative;
    appearance: none;
    border: 0;
    cursor: pointer;
    aspect-ratio: 3 / 4;
    padding: 0;
    background: transparent;
    transition: transform 200ms;
  }
  .ns__stamp:hover {
    transform: translateY(-3px) rotate(-1deg);
    z-index: 2;
  }
  .ns__stamp-bg {
    position: absolute;
    inset: 0;
    background: var(--stamp-color, #5a3a2a);
    /* Perforated edge — radial-gradient holes around the border */
    -webkit-mask:
      radial-gradient(circle 4px at 0 0, transparent 99%, #000 100%) 0 0 / 12px 12px,
      linear-gradient(#000, #000);
    mask:
      radial-gradient(circle 4px at 0 0, transparent 99%, #000 100%) 0 0 / 12px 12px,
      linear-gradient(#000, #000);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    box-shadow: inset 0 0 0 6px rgba(244, 233, 210, 0.12);
  }
  /* Simpler perforation alternative: fake border-image with circles */
  .ns__stamp-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 8px solid transparent;
    background:
      radial-gradient(circle at 8px 8px, transparent 4px, var(--ns-paper-deep) 4.5px) 0 0 / 16px 16px,
      transparent;
    /* this trick doesn't work cleanly cross-browser; the mask above carries the look */
    pointer-events: none;
  }
  .ns__stamp-inner {
    position: absolute;
    inset: 14px;
    background: rgba(244, 233, 210, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 6px 4px;
    z-index: 1;
  }
  .ns__stamp-top, .ns__stamp-bottom {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 7px;
    letter-spacing: 0.15em;
    color: var(--stamp-color, #5a3a2a);
    text-transform: uppercase;
    font-weight: 700;
  }
  .ns__stamp-denom { font-size: 11px; }
  .ns__stamp-noun {
    flex: 1;
    width: 90%;
    object-fit: contain;
    image-rendering: pixelated;
    margin: 4px 0;
  }
  .ns__stamp-pc { color: rgba(0, 0, 0, 0.4); }

  /* Cancel postmark — hidden by default, shown when stamp is cancelled */
  .ns__cancel {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-12deg) scale(1.2);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    transition: opacity 220ms ease-out, transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
    mix-blend-mode: multiply;
  }
  .ns__stamp.ns__stamp--cancelled .ns__cancel {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(-12deg) scale(1);
  }
  .ns__stamp.ns__stamp--cancelled { cursor: default; }
  .ns__stamp.ns__stamp--cancelled:hover { transform: none; }

  /* Controls */
  .ns__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 24px);
    flex-wrap: wrap;
    margin: clamp(28px, 4vh, 44px) auto 0;
    max-width: 880px;
  }
  .ns__btn {
    appearance: none; border: 0; cursor: pointer;
    padding: 12px 28px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px; font-weight: 800; letter-spacing: 0.22em;
    color: #fff; background: var(--ns-ink);
    border: 2px solid var(--ns-ink);
    box-shadow: 4px 4px 0 0 var(--ns-rose);
    transition: transform 80ms, box-shadow 80ms, background 120ms;
  }
  .ns__btn:hover { background: var(--ns-rose); box-shadow: 4px 4px 0 0 var(--ns-ink); }
  .ns__btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 0 var(--ns-rose); }

  .ns__instructions {
    margin: 0 auto;
    max-width: 480px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: #5a5a5a;
    text-align: center;
  }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  // Postmark "thunk" — short low thump
  function playThunk() {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 110;
    o.frequency.exponentialRampToValueAtTime(50, t + 0.08);
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.30, t + 0.005);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
    o.connect(g).connect(a.destination);
    o.start(t); o.stop(t + 0.20);

    // Brief noise burst — paper crackle
    const buf = a.createBuffer(1, a.sampleRate * 0.04, a.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
    const n = a.createBufferSource(); n.buffer = buf;
    const filt = a.createBiquadFilter(); filt.type = 'highpass'; filt.frequency.value = 1500;
    const ng = a.createGain(); ng.gain.setValueAtTime(0.10, t); ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
    n.connect(filt).connect(ng).connect(a.destination);
    n.start(t);
  }

  const stampEls = Array.from(document.querySelectorAll('.ns__stamp'));
  const refreshBtn = document.getElementById('ns-refresh');
  const cancelledEl = document.getElementById('ns-cancelled');
  let cancelledCount = 0;

  function todayStr() {
    const d = new Date();
    const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
    return `${months[d.getMonth()]} ${d.getDate()}`;
  }

  function refresh() {
    cancelledCount = 0;
    stampEls.forEach((el) => {
      const noun = Math.floor(Math.random() * 1200);
      const img = el.querySelector('[data-stamp-noun]');
      if (img) img.src = `https://noun.pics/${noun}.svg`;
      const numEl = el.querySelector('[data-stamp-num]');
      if (numEl) numEl.textContent = String(noun).padStart(4, '0');
      const dateEl = el.querySelector('[data-cancel-date]');
      if (dateEl) dateEl.textContent = todayStr();
      el.classList.remove('ns__stamp--cancelled');
    });
    if (cancelledEl) cancelledEl.textContent = '0 CANCELLED';
  }

  stampEls.forEach((el) => {
    el.addEventListener('click', () => {
      if (el.classList.contains('ns__stamp--cancelled')) return;
      el.classList.add('ns__stamp--cancelled');
      try { playThunk(); } catch {}
      cancelledCount += 1;
      if (cancelledEl) cancelledEl.textContent = `${cancelledCount} CANCELLED`;
    });
  });
  refreshBtn?.addEventListener('click', refresh);
  refresh();
</script>
