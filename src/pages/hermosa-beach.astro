---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FIRST_NINETY_DAYS_PLAN, INHERITED_FROM_ES, INSTANCE_META, INSTANCE_NOTES, HB_SIX_SHAPES, HB_SNAPSHOT, HB_SPECIFIC_TERRAIN, REFERENCES, STRAND_CORRIDOR_POSITION } from '../lib/hermosaBeach';
const title = `${INSTANCE_META.title} — ${INSTANCE_META.subtitle}`;
const description = INSTANCE_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/hermosa-beach', name: INSTANCE_META.title, description, url: 'https://pointcast.xyz/hermosa-beach', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const statusColor: Record<string, string> = { shipping: '#2d6a3d', building: '#d4a534', forming: '#b85a3a', dormant: '#5a5450', speculative: '#a8a39a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/hermosa-beach.json', title: 'Hermosa Beach instance (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/manhattan-beach">manhattan-beach</a><span aria-hidden="true">/</span><span>hermosa-beach</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{INSTANCE_META.paperNumber} · SECOND CONCRETE FORK · 6-SHAPE STACK · 13-WEEK PLAN</p>
      <h1>HERMOSA / BEACH.</h1>
      <p class="subtitle">{INSTANCE_META.subtitle}</p>
      <p class="thesis">{INSTANCE_META.thesis}</p>
    </header>

    <section class="snapshot"><p class="kicker">SNAPSHOT</p><h2>Hermosa Beach at a glance.</h2>
      <dl class="snap-dl">
        <div><dt>Population</dt><dd>{HB_SNAPSHOT.population}</dd></div>
        <div><dt>Geography</dt><dd>{HB_SNAPSHOT.geography}</dd></div>
        <div><dt>Borders</dt><dd>{HB_SNAPSHOT.borders}</dd></div>
        <div><dt>Median income</dt><dd>{HB_SNAPSHOT.medianIncome}</dd></div>
        <div><dt>Tech density</dt><dd>{HB_SNAPSHOT.techDensity}</dd></div>
        <div><dt>Strand frontage</dt><dd>{HB_SNAPSHOT.beachCorridor}</dd></div>
        <div><dt>Parkland</dt><dd>{HB_SNAPSHOT.parksAcres}</dd></div>
        <div><dt>Existing civic</dt><dd>{HB_SNAPSHOT.existingCivic}</dd></div>
      </dl>
    </section>

    <section class="inherited"><p class="kicker">INHERITED FROM EL SEGUNDO · 8 ITEMS</p><h2>What HB starts with.</h2>
      <ol class="inh-list">{INHERITED_FROM_ES.map((i) => (
        <li><h3>{i.item}</h3><p>{i.detail}</p></li>
      ))}</ol>
    </section>

    <section class="terrain"><p class="kicker">HB-SPECIFIC TERRAIN · 7 FEATURES</p><h2>Where HB differs.</h2>
      <ol class="ter-list">{HB_SPECIFIC_TERRAIN.map((t) => (
        <li>
          <h3>{t.feature}</h3>
          <p class="ter__ues"><strong>ES analogue:</strong> {t.uesAnalogue}</p>
          <p class="ter__diff"><strong>HB difference:</strong> {t.hbDifference}</p>
        </li>
      ))}</ol>
    </section>

    <section class="shapes"><p class="kicker">SIX-SHAPE STATUS · HB</p><h2>What ships first.</h2>
      <ol class="shape-list">{HB_SIX_SHAPES.map((s) => (
        <li class={`sh sh--${s.hbStatus}`}>
          <div class="sh__head">
            <span class="sh__num">{String(s.number).padStart(2,'0')}</span>
            <h3>{s.name}</h3>
            <span class="sh__status" style={`background: ${statusColor[s.hbStatus]};`}>{s.hbStatus.toUpperCase()}</span>
          </div>
          <p><strong>Starting point:</strong> {s.startingPoint}</p>
          <p><strong>First 90 days:</strong> {s.firstNinetyDays}</p>
        </li>
      ))}</ol>
    </section>

    <section class="plan"><p class="kicker">13-WEEK PLAN · DAY 0 → DAY 90</p><h2>What the local Land would do.</h2>
      <ol class="plan-list">{FIRST_NINETY_DAYS_PLAN.map((p) => (
        <li>
          <span class="plan__week">WEEK {p.week}</span>
          <div>
            <h3>{p.milestone}</h3>
            <p>{p.detail}</p>
          </div>
        </li>
      ))}</ol>
    </section>

    <section class="strand"><p class="kicker">STRAND CORRIDOR · MIDPOINT POSITION</p><h2>Why Hermosa is the federation midpoint.</h2>
      <p class="lede">{STRAND_CORRIDOR_POSITION.thesis}</p>
      <h3 class="strand-h">Why the midpoint matters</h3>
      <ol class="strand-list">{STRAND_CORRIDOR_POSITION.whyMidpointMatters.map((e) => (<li>{e}</li>))}</ol>
      <p class="strand__parallel"><strong>Parallel to the cases:</strong> {STRAND_CORRIDOR_POSITION.parallelToCases}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · LOCAL LAND CALL</p>
      <p>{INSTANCE_NOTES.uesNote}</p>
      <p class="invite-cta">{INSTANCE_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/forkable-radius">The Forkable Radius · framework</a>
      <a href="/manhattan-beach">Manhattan Beach · first fork</a>
      <a href="/commons">Commons · ES proto</a>
      <a href="/marine-layer">Marine Layer · ES proto</a>
      <a href="/common-forms">Common Forms · architecture template</a>
      <a href="/civic-personal-agent">Civic Personal Agent · Shape #1</a>
      <a href="/mutual-aid-mesh">Mutual Aid Mesh · Shape #3</a>
      <a href="/hermosa-beach.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --hb-ink:#1a1a1a; --hb-paper:#fdf9ee; --hb-mustard:#d4a534; --hb-rust:#b85a3a; --hb-sage:#2d6a3d; --hb-navy:#3a4a8a; --hb-strand:#5b8aa8; --hb-fog:#d8d2c4; --hb-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--hb-paper); color: var(--hb-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--hb-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--hb-strand); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--hb-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--hb-strand); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--hb-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  .lede { font-size: 15px; line-height: 1.6; margin: 0 0 16px; max-width: 72ch; }

  .snapshot { background: linear-gradient(135deg, #fff, var(--hb-paper)); }
  .snap-dl { margin: 0; display: grid; gap: 6px; }
  .snap-dl > div { display: grid; grid-template-columns: 160px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--hb-ink); }
  .snap-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--hb-strand); padding-top: 2px; }
  .snap-dl dd { margin: 0; font-size: 14px; line-height: 1.55; }

  .inherited { background: var(--hb-paper); }
  .inh-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .inh-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--hb-ink); border-left: 6px solid var(--hb-sage); }
  .inh-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 6px; font-weight: 700; }
  .inh-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .terrain { background: linear-gradient(180deg, #fff, var(--hb-paper)); }
  .ter-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ter-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--hb-ink); border-left: 8px solid var(--hb-strand); }
  .ter-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }
  .ter-list p { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .ter__ues { padding: 6px 10px; background: var(--hb-paper); border-left: 3px solid var(--hb-fog); font-size: 12.5px !important; }
  .ter__diff { padding: 6px 10px; background: var(--hb-paper); border-left: 3px solid var(--hb-rust); font-size: 12.5px !important; }
  .ter-list strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--hb-strand); margin-right: 4px; }

  .shape-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sh { padding: 12px 14px; background: #fff; border: 2px solid var(--hb-ink); border-left: 8px solid var(--hb-fog); }
  .sh--shipping { border-left-color: var(--hb-sage); }
  .sh--building { border-left-color: var(--hb-mustard); }
  .sh--forming { border-left-color: var(--hb-rust); }
  .sh--dormant { border-left-color: var(--hb-slate); }
  .sh--speculative { border-left-color: var(--hb-fog); }
  .sh__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
  .sh__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--hb-strand); }
  .sh h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0; font-weight: 700; flex: 1; }
  .sh__status { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; padding: 2px 6px; color: #fff; }
  .sh--speculative .sh__status, .sh--dormant .sh__status { color: #fff; }
  .sh p { margin: 0 0 4px; font-size: 12.5px; line-height: 1.5; }
  .sh strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--hb-strand); margin-right: 4px; }

  .plan { background: var(--hb-paper); }
  .plan-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .plan-list li { display: grid; grid-template-columns: 80px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--hb-ink); border-left: 6px solid var(--hb-mustard); align-items: baseline; }
  .plan__week { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--hb-rust); padding: 2px 6px; background: var(--hb-paper); display: inline-block; }
  .plan-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 4px; font-weight: 700; }
  .plan-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .strand { background: linear-gradient(180deg, var(--hb-paper), #fff); border-top: 8px solid var(--hb-strand); }
  .strand-h { font-family: var(--pc-font-mono); font-size: 13px; margin: 16px 0 8px; font-weight: 700; text-transform: uppercase; color: var(--hb-strand); }
  .strand-list { list-style: decimal; padding-left: 22px; margin: 0 0 14px; font-size: 14px; line-height: 1.55; }
  .strand-list li { margin-bottom: 6px; }
  .strand__parallel { padding: 12px 14px; background: var(--hb-paper); border-left: 4px solid var(--hb-strand); font-size: 13.5px; line-height: 1.55; }
  .strand__parallel strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--hb-strand); margin-right: 4px; }

  .invitation { background: var(--hb-strand); color: var(--hb-paper); border-top-color: var(--hb-strand); }
  .invitation .kicker { background: var(--hb-mustard); color: var(--hb-ink); }
  .invitation h2 { color: var(--hb-paper); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--hb-mustard); color: var(--hb-ink); border-left: 4px solid var(--hb-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--hb-strand); color: var(--hb-paper); text-decoration: none; }
  .links a:hover { background: var(--hb-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .inh-list { grid-template-columns: 1fr; } .snap-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .plan-list li { grid-template-columns: 1fr; } }
</style>
