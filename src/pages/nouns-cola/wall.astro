---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import BlockLayout from '../../layouts/BlockLayout.astro';

const colaDir = join(process.cwd(), 'public/cola');
const generated = existsSync(colaDir)
  ? readdirSync(colaDir).filter((name) => /^\d{4}-\d{2}-\d{2}\.png$/.test(name)).sort().reverse()
  : [];

const seedPosters = [
  '/images/nouns-cola/ads-generated-v2/poster-01-hero.png',
  '/images/nouns-cola/ads-generated-v2/poster-02-night.png',
  '/images/nouns-cola/ads-generated-v2/poster-03-pop.png',
  '/images/nouns-cola/ads-generated-v2/poster-04-mural.png',
];
---

<BlockLayout
  title="Nouns Cola Wall"
  description="Running wall of nightly Nouns Cola posters generated locally from the Set 02 visual language."
>
  <main class="wall">
    <nav class="crumb"><a href="/">Home</a><span>/</span><a href="/nouns-cola">nouns-cola</a><span>/wall</span></nav>
    <header class="top">
      <p class="kicker">NIGHTLY WALL</p>
      <h1>Nouns Cola keeps putting posters up.</h1>
      <p>Set 02 is the seed. Nightly runs save to <code>/public/cola/YYYY-MM-DD.png</code> and publish a block receipt.</p>
    </header>

    <section class="grid" aria-label="Generated Nouns Cola posters">
      {generated.map((name) => (
        <figure>
          <img src={`/cola/${name}`} alt={`Nouns Cola nightly poster ${name.replace('.png', '')}`} loading="lazy" width="1024" height="1536" />
          <figcaption>{name.replace('.png', '')}</figcaption>
        </figure>
      ))}
      {seedPosters.map((src, index) => (
        <figure class="seed">
          <img src={src} alt={`Nouns Cola Set 02 seed poster ${index + 1}`} loading="lazy" width="1024" height="1536" />
          <figcaption>set 02 seed {index + 1}</figcaption>
        </figure>
      ))}
    </section>
  </main>
</BlockLayout>

<style>
  .wall {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 18px 80px;
  }

  .crumb,
  .kicker,
  figcaption {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    gap: 8px;
    color: #6d665d;
    font-size: 11px;
    margin-bottom: 20px;
  }

  .crumb a {
    color: #8b2b25;
    text-decoration: none;
  }

  .top {
    border-bottom: 2px solid #1f1b18;
    padding-bottom: 20px;
    margin-bottom: 20px;
  }

  .kicker {
    color: #8b2b25;
    font-size: 12px;
  }

  h1 {
    max-width: 920px;
    margin: 8px 0 12px;
    font-size: clamp(42px, 8vw, 92px);
    line-height: .92;
  }

  .top p:last-child {
    max-width: 690px;
    color: #4c453e;
    font-size: 18px;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 14px;
  }

  figure {
    margin: 0;
    background: #fffaf0;
    border: 1px solid #d8ccba;
    padding: 8px;
  }

  figure.seed {
    opacity: .72;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: #1f1b18;
  }

  figcaption {
    margin-top: 8px;
    color: #6d665d;
    font-size: 10px;
  }
</style>
