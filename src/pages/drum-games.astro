---
import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';
import { DRUM_GAMES } from '../lib/drum-games';

const title = 'Drum Arcade';
const description = 'Five playable PointCast drum games: memory, reaction, groove completion, beat-running, and silent-tempo control. Free, instant, and saved locally.';
const paths = JSON.stringify(DRUM_GAMES.map((game) => game.path));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/drum-games',
  name: 'PointCast Drum Arcade',
  description,
  url: 'https://pointcast.xyz/drum-games',
  numberOfItems: DRUM_GAMES.length,
  hasPart: DRUM_GAMES.map((game) => ({
    '@type': 'VideoGame',
    name: game.name,
    description: game.description,
    url: `https://pointcast.xyz${game.path}`,
    gamePlatform: 'Web browser',
    playMode: 'SinglePlayer',
  })),
};
---

<BlockLayout
  title={title}
  description={description}
  image="/images/og-drum.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/drum-games.json', title: 'PointCast Drum Arcade JSON' }]}
>
  <div class="dga" data-drum-arcade data-paths={paths}>
    <div class="dga__nav"><DrumNav current="games" /></div>

    <header class="dga__hero">
      <div class="dga__hero-copy">
        <p class="dga__eyebrow">POINTCAST · DRUM HOUSE · FIVE GAMES</p>
        <h1><span>FIND</span> THE BEAT.</h1>
        <p class="dga__dek">
          Five small tests of a drummer's brain: remember, wait, fill, jump, hold steady.
          Every game starts in one tap. Your best stays in this browser.
        </p>
        <div class="dga__actions">
          <a class="dga__action dga__action--hot" href="/drum-says">Start with memory</a>
          <button class="dga__action" type="button" data-random-game>Surprise me</button>
          <a class="dga__action" href="/drum-games.json">Read the JSON</a>
        </div>
      </div>

      <div class="dga__kit" aria-label="Five-game drum kit">
        {DRUM_GAMES.map((game, index) => (
          <a
            class="dga__kit-pad"
            href={game.path}
            style={`--pad-accent:${game.accent}; --pad-index:${index};`}
            aria-label={`Play ${game.name}`}
          >
            <img src={`https://noun.pics/${game.nounId}.svg`} alt="" width="72" height="72" loading={index === 0 ? 'eager' : 'lazy'} />
            <span>{game.number}</span>
          </a>
        ))}
        <div class="dga__kit-center" aria-hidden="true">
          <strong>5</strong>
          <span>games</span>
        </div>
      </div>
    </header>

    <section class="dga__scoreline" aria-label="Local Drum Arcade profile">
      <div><span>Games</span><strong>{DRUM_GAMES.length}</strong></div>
      <div><span>Best marks here</span><strong data-scores-here>0</strong></div>
      <div><span>Account</span><strong>Not needed</strong></div>
      <div><span>Audio</span><strong>Web Audio</strong></div>
    </section>

    <section class="dga__shelf" aria-labelledby="shelf-title">
      <header class="dga__section-head">
        <p>THE FIVE-GAME SET</p>
        <h2 id="shelf-title">Different reflexes. One shared pulse.</h2>
      </header>

      <ol class="dga__games">
        {DRUM_GAMES.map((game) => (
          <li>
            <article class="dga__game" style={`--game-accent:${game.accent};`}>
              <a class="dga__game-main" href={game.path}>
                <span class="dga__game-number">{game.number}</span>
                <div class="dga__portrait">
                  <span class="dga__portrait-ring" aria-hidden="true"></span>
                  <img src={`https://noun.pics/${game.nounId}.svg`} alt={`Noun for ${game.name}`} width="136" height="136" loading="lazy" />
                </div>
                <div class="dga__game-copy">
                  <span class="dga__game-kicker">{game.kicker}</span>
                  <h3>{game.name}</h3>
                  <p>{game.description}</p>
                </div>
              </a>

              <dl class="dga__game-meta">
                <div><dt>Tests</dt><dd>{game.skill}</dd></div>
                <div><dt>Controls</dt><dd>{game.controls}</dd></div>
                <div
                  data-best-row
                  data-best-key={game.bestKey}
                  data-best-unit={game.bestUnit}
                  data-best-direction={game.bestDirection}
                  data-secondary-key={game.secondaryKey}
                  data-secondary-unit={game.secondaryUnit}
                >
                  <dt>Local best</dt>
                  <dd data-best-value>No score yet</dd>
                </div>
              </dl>

              <a class="dga__play" href={game.path}>Play {game.shortName} <span aria-hidden="true">→</span></a>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="dga__route" aria-labelledby="route-title">
      <div>
        <p class="dga__eyebrow">A GOOD FIRST RUN</p>
        <h2 id="route-title">Warm the brain, then the hands.</h2>
      </div>
      <ol>
        <li><strong>Drum Says</strong><span>Hear the shape.</span></li>
        <li><strong>Quick Draw</strong><span>Learn not to flinch.</span></li>
        <li><strong>Fill the Bar</strong><span>Put the note where it belongs.</span></li>
        <li><strong>Beat Runner</strong><span>Carry the pocket across four scenes.</span></li>
        <li><strong>Steady Hands</strong><span>Keep the pulse after it disappears.</span></li>
      </ol>
    </section>

    <footer class="dga__footer">
      <p>Scores live in localStorage. Sounds are synthesized in-browser. No samples, signup, wallet, or install.</p>
      <nav aria-label="More PointCast play">
        <a href="/drum">Drum room</a>
        <a href="/drum-press">Drum Press</a>
        <a href="/win95-games">Retro Arcade</a>
        <a href="/explore">Explore</a>
      </nav>
    </footer>
  </div>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-drum-arcade]');

  function readLocal(key?: string): string {
    if (!key) return '';
    try { return localStorage.getItem(key) || ''; } catch { return ''; }
  }

  let scoresHere = 0;
  document.querySelectorAll<HTMLElement>('[data-best-row]').forEach((row) => {
    const value = Number(readLocal(row.dataset.bestKey));
    if (!Number.isFinite(value) || value <= 0) return;

    scoresHere += 1;
    const output = row.querySelector<HTMLElement>('[data-best-value]');
    if (!output) return;

    const rounded = row.dataset.bestDirection === 'low'
      ? Math.round(value)
      : Math.round(value).toLocaleString();
    const secondary = readLocal(row.dataset.secondaryKey);
    const secondaryCopy = secondary
      ? ` · ${secondary}${row.dataset.secondaryUnit || ''}`
      : '';
    output.textContent = `${rounded}${row.dataset.bestUnit || ''}${secondaryCopy}`;
    row.classList.add('has-score');
  });

  const scoreCount = document.querySelector<HTMLElement>('[data-scores-here]');
  if (scoreCount) scoreCount.textContent = String(scoresHere);

  document.querySelector<HTMLButtonElement>('[data-random-game]')?.addEventListener('click', () => {
    if (!root) return;
    try {
      const paths = JSON.parse(root.dataset.paths || '[]') as string[];
      const path = paths[Math.floor(Math.random() * paths.length)];
      if (path) window.location.assign(path);
    } catch { /* the fixed first-game link remains available */ }
  });
</script>

<style>
  :global(body:has(.dga)) { background:#070812; color:#f6f0df; }
  .dga {
    --ink:#f6f0df;
    --dim:#a8a5b4;
    --panel:#101321;
    --line:rgba(246,240,223,.16);
    min-height:100vh;
    margin:0;
    padding:18px clamp(16px,4vw,56px) 56px;
    overflow:hidden;
    background:
      radial-gradient(circle at 82% 8%, rgba(122,200,237,.13), transparent 32%),
      radial-gradient(circle at 12% 32%, rgba(255,107,138,.11), transparent 34%),
      #070812;
    font-family:var(--pc-font-sans, Inter, system-ui, sans-serif);
  }
  .dga__nav { max-width:1240px; margin:0 auto; }
  .dga__nav :global(.drum-nav__item) { background:#101321; color:#c9c4d3; border-color:#34384a; }
  .dga__nav :global(.drum-nav__item.is-active) { color:#070812; background:#f6c15e; border-color:#f6c15e; }

  .dga__hero {
    max-width:1240px;
    min-height:560px;
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,1.05fr) minmax(390px,.95fr);
    gap:clamp(28px,5vw,72px);
    align-items:center;
    padding:clamp(48px,7vw,92px) 0 64px;
  }
  .dga__eyebrow,.dga__section-head p {
    margin:0 0 14px;
    color:#f6c15e;
    font:500 11px/1.2 var(--pc-font-mono, monospace);
    letter-spacing:.24em;
    text-transform:uppercase;
  }
  .dga__hero h1 {
    margin:0;
    font-size:clamp(70px,10vw,152px);
    line-height:.76;
    letter-spacing:-.075em;
    font-weight:500;
  }
  .dga__hero h1 span { display:block; color:#ff6b8a; }
  .dga__dek { max-width:690px; margin:30px 0 0; color:#c9c4d3; font-size:clamp(17px,2vw,23px); line-height:1.5; }
  .dga__actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:30px; }
  .dga__action {
    min-height:44px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:10px 16px;
    border:1px solid #3b4052;
    border-radius:999px;
    background:#101321;
    color:#f6f0df;
    cursor:pointer;
    font:500 11px/1 var(--pc-font-mono, monospace);
    letter-spacing:.11em;
    text-transform:uppercase;
    text-decoration:none;
  }
  .dga__action:hover { border-color:#f6c15e; text-decoration:none; }
  .dga__action--hot { background:#f6c15e; border-color:#f6c15e; color:#090a12; }

  .dga__kit { position:relative; min-height:440px; display:grid; place-items:center; }
  .dga__kit::before,.dga__kit::after { content:''; position:absolute; border:1px solid var(--line); border-radius:50%; }
  .dga__kit::before { width:360px; height:360px; }
  .dga__kit::after { width:260px; height:260px; border-style:dashed; animation:dga-spin 32s linear infinite; }
  .dga__kit-pad {
    position:absolute;
    left:50%;
    top:50%;
    width:96px;
    height:96px;
    display:grid;
    place-items:center;
    border:2px solid var(--pad-accent);
    border-radius:50%;
    background:color-mix(in srgb,var(--pad-accent) 16%,#0c0e19);
    box-shadow:0 0 28px color-mix(in srgb,var(--pad-accent) 22%,transparent);
    text-decoration:none;
    transform:translate(-50%,-50%);
    transition:transform .16s ease,box-shadow .16s ease;
  }
  .dga__kit-pad:nth-of-type(1) { left:50%; top:8%; }
  .dga__kit-pad:nth-of-type(2) { left:84%; top:36%; }
  .dga__kit-pad:nth-of-type(3) { left:71%; top:78%; }
  .dga__kit-pad:nth-of-type(4) { left:29%; top:78%; }
  .dga__kit-pad:nth-of-type(5) { left:16%; top:36%; }
  .dga__kit-pad:hover { transform:translate(-50%,-50%) scale(1.08); box-shadow:0 0 42px color-mix(in srgb,var(--pad-accent) 42%,transparent); }
  .dga__kit-pad img { width:72px; height:72px; image-rendering:pixelated; border-radius:50%; }
  .dga__kit-pad span { position:absolute; right:-4px; bottom:-4px; display:grid; place-items:center; width:28px; height:28px; border-radius:50%; background:var(--pad-accent); color:#070812; font:500 10px/1 var(--pc-font-mono, monospace); }
  .dga__kit-center { position:relative; z-index:1; width:132px; height:132px; display:grid; place-content:center; text-align:center; border:1px solid #484d61; border-radius:50%; background:#101321; box-shadow:0 18px 50px rgba(0,0,0,.45); }
  .dga__kit-center strong { font-size:64px; line-height:.8; color:#f6c15e; }
  .dga__kit-center span { margin-top:10px; color:#a8a5b4; font:500 10px/1 var(--pc-font-mono, monospace); letter-spacing:.2em; text-transform:uppercase; }
  @keyframes dga-spin { to { transform:rotate(360deg); } }

  .dga__scoreline { max-width:1240px; margin:0 auto 82px; display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--line); background:rgba(16,19,33,.75); }
  .dga__scoreline div { min-height:96px; padding:20px; border-right:1px solid var(--line); display:flex; flex-direction:column; justify-content:space-between; }
  .dga__scoreline div:last-child { border-right:0; }
  .dga__scoreline span { color:#8d8a99; font:500 9px/1 var(--pc-font-mono, monospace); letter-spacing:.18em; text-transform:uppercase; }
  .dga__scoreline strong { font-size:clamp(21px,3vw,34px); font-weight:500; }

  .dga__shelf { max-width:1240px; margin:0 auto; }
  .dga__section-head { display:flex; align-items:end; justify-content:space-between; gap:24px; padding-bottom:20px; border-bottom:1px solid var(--line); }
  .dga__section-head p { margin:0; }
  .dga__section-head h2,.dga__route h2 { max-width:720px; margin:0; font-size:clamp(31px,5vw,64px); line-height:.95; letter-spacing:-.045em; font-weight:500; }
  .dga__games { margin:0; padding:0; list-style:none; }
  .dga__game { position:relative; display:grid; grid-template-columns:minmax(0,1fr) 290px 150px; align-items:stretch; border-bottom:1px solid var(--line); background:linear-gradient(90deg,color-mix(in srgb,var(--game-accent) 0%,transparent),transparent); transition:background .18s ease; }
  .dga__game:hover { background:linear-gradient(90deg,color-mix(in srgb,var(--game-accent) 11%,transparent),transparent 72%); }
  .dga__game-main { min-height:245px; display:grid; grid-template-columns:54px 150px minmax(0,1fr); gap:24px; align-items:center; padding:26px 28px 26px 0; color:inherit; text-decoration:none; }
  .dga__game-main:hover { text-decoration:none; }
  .dga__game-number { align-self:start; padding-top:9px; color:var(--game-accent); font:500 13px/1 var(--pc-font-mono, monospace); letter-spacing:.16em; }
  .dga__portrait { position:relative; width:140px; height:140px; display:grid; place-items:center; }
  .dga__portrait-ring { position:absolute; inset:2px; border:1px solid var(--game-accent); border-radius:50%; opacity:.45; }
  .dga__portrait img { position:relative; width:116px; height:116px; border-radius:50%; image-rendering:pixelated; }
  .dga__game-kicker { color:var(--game-accent); font:500 9px/1.2 var(--pc-font-mono, monospace); letter-spacing:.18em; text-transform:uppercase; }
  .dga__game h3 { margin:10px 0 10px; font-size:clamp(32px,4vw,58px); line-height:.9; letter-spacing:-.04em; font-weight:500; }
  .dga__game p { max-width:570px; margin:0; color:#aaa7b5; line-height:1.48; }
  .dga__game-meta { margin:0; padding:30px 22px; border-left:1px solid var(--line); display:grid; align-content:center; gap:20px; }
  .dga__game-meta div { display:grid; grid-template-columns:80px 1fr; gap:10px; }
  .dga__game-meta dt { color:#777584; font:500 9px/1.2 var(--pc-font-mono, monospace); letter-spacing:.12em; text-transform:uppercase; }
  .dga__game-meta dd { margin:0; color:#d4cfda; font-size:13px; line-height:1.35; }
  .dga__game-meta .has-score dd { color:var(--game-accent); }
  .dga__play { display:grid; place-items:center; padding:18px; border-left:1px solid var(--line); color:var(--game-accent); font:500 10px/1.5 var(--pc-font-mono, monospace); letter-spacing:.12em; text-align:center; text-transform:uppercase; text-decoration:none; }
  .dga__play:hover { background:var(--game-accent); color:#080912; text-decoration:none; }

  .dga__route { max-width:1240px; margin:100px auto 0; padding:42px; display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:58px; border:1px solid var(--line); background:#101321; }
  .dga__route ol { margin:0; padding:0; list-style:none; counter-reset:route; }
  .dga__route li { counter-increment:route; display:grid; grid-template-columns:30px 150px 1fr; gap:10px; align-items:baseline; padding:13px 0; border-bottom:1px solid var(--line); }
  .dga__route li::before { content:counter(route,decimal-leading-zero); color:#f6c15e; font:500 10px/1 var(--pc-font-mono, monospace); }
  .dga__route li:last-child { border-bottom:0; }
  .dga__route strong { color:#f6f0df; }
  .dga__route li span { color:#8d8a99; }

  .dga__footer { max-width:1240px; margin:42px auto 0; padding-top:20px; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:24px; color:#777584; font:500 10px/1.6 var(--pc-font-mono, monospace); letter-spacing:.06em; }
  .dga__footer p { margin:0; }
  .dga__footer nav { display:flex; flex-wrap:wrap; gap:16px; }
  .dga__footer a { color:#aaa7b5; }

  @media (max-width:920px) {
    .dga__hero { grid-template-columns:1fr; min-height:0; }
    .dga__kit { min-height:420px; }
    .dga__game { grid-template-columns:minmax(0,1fr) 230px; }
    .dga__play { grid-column:1/-1; min-height:52px; border-left:0; border-top:1px solid var(--line); }
    .dga__game-main { grid-template-columns:44px 116px minmax(0,1fr); }
    .dga__portrait { width:112px; height:112px; }
    .dga__portrait img { width:92px; height:92px; }
    .dga__route { grid-template-columns:1fr; }
  }
  @media (max-width:640px) {
    .dga { padding-inline:12px; }
    .dga__hero { padding-top:40px; }
    .dga__hero h1 { font-size:clamp(66px,23vw,108px); }
    .dga__kit { transform:scale(.78); margin:-38px -60px; }
    .dga__scoreline { grid-template-columns:repeat(2,1fr); }
    .dga__scoreline div:nth-child(2) { border-right:0; }
    .dga__scoreline div:nth-child(-n+2) { border-bottom:1px solid var(--line); }
    .dga__section-head { display:block; }
    .dga__section-head h2 { margin-top:12px; }
    .dga__game { grid-template-columns:1fr; padding:24px 0; }
    .dga__game-main { min-height:0; grid-template-columns:32px 76px minmax(0,1fr); gap:12px; padding:0 4px 22px; }
    .dga__portrait { width:76px; height:76px; }
    .dga__portrait img { width:62px; height:62px; }
    .dga__game h3 { font-size:34px; }
    .dga__game p { grid-column:1/-1; font-size:14px; }
    .dga__game-meta { border:1px solid var(--line); padding:18px; }
    .dga__play { border:1px solid var(--line); border-top:0; }
    .dga__route { margin-top:64px; padding:24px 18px; gap:28px; }
    .dga__route li { grid-template-columns:28px 110px 1fr; font-size:13px; }
    .dga__footer { display:block; }
    .dga__footer nav { margin-top:18px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .dga__kit::after { animation:none; }
    .dga__kit-pad,.dga__game { transition:none; }
  }
</style>
