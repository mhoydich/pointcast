---
import BlockLayout from '../layouts/BlockLayout.astro';
import elementalSoundscape from '../assets/shrines/elemental-shrine/elemental-shrine-elevenlabs.m4a?url';
import socialCard from '../assets/shrines/elemental-shrine/elemental-shrine-og.png';

const title = 'Elemental Shrine · Four Presences';
const description =
  'A quiet interactive altar of stone, light, fire, and water, with an original elemental soundscape created in ElevenLabs.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/elemental-shrine',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
  creator: {
    '@type': 'Person',
    name: 'Mike Hoydich',
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialCard.src}
  imageWidth={1200}
  imageHeight={630}
  themeColor="#111310"
  immersive
  jsonLd={jsonLd}
>
  <section class="es" id="elemental-shrine" data-complete="false" data-sound="false" aria-labelledby="es-title">
    <div class="es__grain" aria-hidden="true"></div>
    <div class="es__glow es__glow--left" aria-hidden="true"></div>
    <div class="es__glow es__glow--right" aria-hidden="true"></div>

    <nav class="es__nav" aria-label="Shrine navigation">
      <a href="/" aria-label="Return to PointCast home">← PointCast</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Elemental Shrine</span>
    </nav>

    <header class="es__header">
      <div class="es__heading">
        <p class="es__kicker">A place to set down what you carry</p>
        <h1 id="es-title">ELEMENTAL SHRINE</h1>
        <p class="es__invitation">Touch stone, light, fire, and water. Then be still.</p>
      </div>

      <div class="es__sound-panel" role="group" aria-label="Sound controls">
        <button class="es__sound" id="es-sound" type="button" aria-pressed="false">
          <span class="es__sound-mark" aria-hidden="true">◌</span>
          <span id="es-sound-label">Begin listening</span>
        </button>
        <label class="es__volume" for="es-volume">
          <span>Volume</span>
          <input id="es-volume" type="range" min="0" max="100" value="24" step="1" />
        </label>
      </div>
    </header>

    <div class="es__altar" role="group" aria-label="Four elemental presences">
      <div class="es__arch" aria-hidden="true"></div>
      <div class="es__horizon" aria-hidden="true"></div>

      <button
        class="es__presence es__presence--light"
        type="button"
        data-element="light"
        aria-pressed="false"
        aria-describedby="es-light-phrase"
      >
        <span class="es__light-visual" aria-hidden="true">
          <span class="es__light-ray es__light-ray--one"></span>
          <span class="es__light-ray es__light-ray--two"></span>
          <span class="es__light-ray es__light-ray--three"></span>
          <span class="es__lamp"></span>
        </span>
        <span class="es__presence-copy">
          <span class="es__element">LIGHT</span>
          <span class="es__phrase" id="es-light-phrase">let it be seen</span>
        </span>
      </button>

      <button
        class="es__presence es__presence--stone"
        type="button"
        data-element="stone"
        aria-pressed="false"
        aria-describedby="es-stone-phrase"
      >
        <span class="es__stone-visual" aria-hidden="true">
          <span class="es__stone es__stone--one"></span>
          <span class="es__stone es__stone--two"></span>
          <span class="es__stone es__stone--three"></span>
          <span class="es__stone es__stone--four"></span>
          <span class="es__stone-shadow"></span>
        </span>
        <span class="es__presence-copy">
          <span class="es__element">STONE</span>
          <span class="es__phrase" id="es-stone-phrase">set it down</span>
        </span>
      </button>

      <div class="es__center" aria-hidden="true">
        <span class="es__offering-ring"></span>
        <span class="es__offering-dot"></span>
      </div>

      <button
        class="es__presence es__presence--fire"
        type="button"
        data-element="fire"
        aria-pressed="false"
        aria-describedby="es-fire-phrase"
      >
        <span class="es__fire-visual" aria-hidden="true">
          <span class="es__ember es__ember--one"></span>
          <span class="es__ember es__ember--two"></span>
          <span class="es__ember es__ember--three"></span>
          <span class="es__flame es__flame--outer"></span>
          <span class="es__flame es__flame--inner"></span>
          <span class="es__coal"></span>
        </span>
        <span class="es__presence-copy">
          <span class="es__element">FIRE</span>
          <span class="es__phrase" id="es-fire-phrase">let it change</span>
        </span>
      </button>

      <button
        class="es__presence es__presence--water"
        type="button"
        data-element="water"
        aria-pressed="false"
        aria-describedby="es-water-phrase"
      >
        <span class="es__water-visual" aria-hidden="true">
          <span class="es__basin-rim"></span>
          <span class="es__water-surface"></span>
          <span class="es__ripple es__ripple--one"></span>
          <span class="es__ripple es__ripple--two"></span>
          <span class="es__ripple es__ripple--three"></span>
          <span class="es__drop"></span>
        </span>
        <span class="es__presence-copy">
          <span class="es__element">WATER</span>
          <span class="es__phrase" id="es-water-phrase">let it pass</span>
        </span>
      </button>

      <div class="es__completion" id="es-completion" aria-hidden="true" inert>
        <p>All four are present.</p>
        <p>Nothing more is asked.</p>
        <button id="es-again" type="button">Begin again</button>
      </div>
    </div>

    <footer class="es__footer">
      <p>Move in any order. Each presence may be revisited.</p>
      <p>Original elemental soundscape created with ElevenLabs.</p>
    </footer>

    <p class="es__status" id="es-status" aria-live="polite" aria-atomic="true"></p>
    <audio id="es-ambience" src={elementalSoundscape} preload="metadata" loop playsinline></audio>
  </section>

  <script is:inline>
    (() => {
      const shrine = document.querySelector('#elemental-shrine');
      const soundButton = document.querySelector('#es-sound');
      const soundLabel = document.querySelector('#es-sound-label');
      const volumeControl = document.querySelector('#es-volume');
      const ambience = document.querySelector('#es-ambience');
      const status = document.querySelector('#es-status');
      const completion = document.querySelector('#es-completion');
      const againButton = document.querySelector('#es-again');
      const presenceButtons = Array.from(document.querySelectorAll('[data-element]'));

      if (!(shrine instanceof HTMLElement) ||
          !(soundButton instanceof HTMLButtonElement) ||
          !(soundLabel instanceof HTMLElement) ||
          !(volumeControl instanceof HTMLInputElement) ||
          !(ambience instanceof HTMLAudioElement) ||
          !(status instanceof HTMLElement) ||
          !(completion instanceof HTMLElement) ||
          !(againButton instanceof HTMLButtonElement)) return;

      const visited = new Set();
      const cueLocks = new Map();
      let audioContext = null;
      let ambienceSource = null;
      let ambienceGain = null;
      let masterGain = null;
      let compressor = null;
      let soundOn = false;
      let fadeFrame = 0;
      let activeVoices = 0;
      let audioFailed = false;
      let listeningIntent = false;
      let soundOperation = 0;

      const announcements = {
        stone: 'Stone rests.',
        light: 'Light is present.',
        fire: 'Fire is tended.',
        water: 'Water moves.',
      };

      function say(message) {
        status.textContent = '';
        window.setTimeout(() => { status.textContent = message; }, 30);
      }

      function volumeValue() {
        const value = Number.parseInt(volumeControl.value, 10) / 100;
        return Math.pow(Math.max(0, Math.min(1, value)), 1.2);
      }

      function getAudioContext() {
        if (audioContext) return audioContext;
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return null;
        audioContext = new AudioContextClass();
        compressor = audioContext.createDynamicsCompressor();
        compressor.threshold.value = -28;
        compressor.knee.value = 18;
        compressor.ratio.value = 8;
        compressor.attack.value = 0.006;
        compressor.release.value = 0.35;
        masterGain = audioContext.createGain();
        masterGain.gain.value = volumeValue();
        masterGain.connect(compressor);
        compressor.connect(audioContext.destination);
        ambienceGain = audioContext.createGain();
        ambienceGain.gain.value = 0;
        ambienceGain.connect(masterGain);
        ambienceSource = audioContext.createMediaElementSource(ambience);
        ambienceSource.connect(ambienceGain);
        return audioContext;
      }

      function fadeAmbience(target, duration = 900, after) {
        if (!audioContext || !ambienceGain) {
          if (after) after();
          return;
        }
        cancelAnimationFrame(fadeFrame);
        const start = performance.now();
        const from = ambienceGain.gain.value;
        const ease = (value) => 1 - Math.pow(1 - value, 3);
        const frame = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          ambienceGain.gain.value = from + (target - from) * ease(progress);
          if (progress < 1) fadeFrame = requestAnimationFrame(frame);
          else if (after) after();
        };
        fadeFrame = requestAnimationFrame(frame);
      }

      async function beginListening() {
        if (audioFailed) {
          say('Sound unavailable — the shrine still works silently.');
          return;
        }
        const operation = ++soundOperation;
        listeningIntent = true;
        soundLabel.textContent = 'Preparing sound…';
        let context = null;
        try {
          context = getAudioContext();
          if (!context) throw new Error('Web Audio is unavailable');
          if (context.state === 'suspended') await context.resume();
          if (document.hidden || operation !== soundOperation || !listeningIntent) {
            ambience.pause();
            if (context.state === 'running') void context.suspend().catch(() => {});
            if (document.hidden && operation === soundOperation) {
              stopListening('Listening paused while you were away. Begin again when ready.', true);
            }
            return;
          }
          await ambience.play();
          if (document.hidden || operation !== soundOperation || !listeningIntent) {
            ambience.pause();
            if (context.state === 'running') void context.suspend().catch(() => {});
            if (document.hidden && operation === soundOperation) {
              stopListening('Listening paused while you were away. Begin again when ready.', true);
            }
            return;
          }
          soundOn = true;
          shrine.dataset.sound = 'true';
          soundButton.setAttribute('aria-pressed', 'true');
          soundLabel.textContent = 'Listening';
          fadeAmbience(0.92, 2200);
          say('The elemental soundscape is present.');
        } catch (_error) {
          if (operation !== soundOperation) return;
          listeningIntent = false;
          soundOperation += 1;
          audioFailed = true;
          soundOn = false;
          ambience.pause();
          if (context?.state === 'running') void context.suspend().catch(() => {});
          shrine.dataset.sound = 'false';
          soundButton.setAttribute('aria-pressed', 'false');
          soundLabel.textContent = 'Sound unavailable';
          say('Sound unavailable — the shrine still works silently.');
        }
      }

      function stopListening(message = 'The shrine is silent.', immediate = false) {
        listeningIntent = false;
        const operation = ++soundOperation;
        soundOn = false;
        shrine.dataset.sound = 'false';
        soundButton.setAttribute('aria-pressed', 'false');
        soundLabel.textContent = 'Begin listening';
        if (immediate) {
          cancelAnimationFrame(fadeFrame);
          if (ambienceGain) ambienceGain.gain.value = 0;
          ambience.pause();
          if (audioContext?.state === 'running') void audioContext.suspend().catch(() => {});
          say(message);
          return;
        }
        fadeAmbience(0, 650, () => {
          if (operation !== soundOperation || listeningIntent) return;
          ambience.pause();
          if (audioContext?.state === 'running') void audioContext.suspend().catch(() => {});
        });
        say(message);
      }

      function connectVoice(node) {
        if (!audioContext || !masterGain || activeVoices >= 4) return false;
        node.connect(masterGain);
        activeVoices += 1;
        window.setTimeout(() => { activeVoices = Math.max(0, activeVoices - 1); }, 1800);
        return true;
      }

      function tone(frequency, duration, peak, type = 'sine', delay = 0, endFrequency = null) {
        if (!soundOn || !audioContext || !masterGain || activeVoices >= 4) return;
        const now = audioContext.currentTime + delay;
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();
        oscillator.type = type;
        oscillator.frequency.setValueAtTime(frequency, now);
        if (endFrequency) oscillator.frequency.exponentialRampToValueAtTime(endFrequency, now + duration);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(peak, now + Math.min(0.05, duration / 4));
        gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
        oscillator.connect(gain);
        if (!connectVoice(gain)) return;
        oscillator.start(now);
        oscillator.stop(now + duration + 0.05);
      }

      function crackle() {
        if (!soundOn || !audioContext || !masterGain || activeVoices >= 4) return;
        const length = Math.floor(audioContext.sampleRate * 0.22);
        const buffer = audioContext.createBuffer(1, length, audioContext.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < length; i += 1) {
          const envelope = Math.pow(1 - i / length, 3);
          data[i] = (Math.random() * 2 - 1) * envelope;
        }
        const source = audioContext.createBufferSource();
        const filter = audioContext.createBiquadFilter();
        const gain = audioContext.createGain();
        filter.type = 'bandpass';
        filter.frequency.value = 2300;
        filter.Q.value = 0.65;
        gain.gain.value = 0.018;
        source.buffer = buffer;
        source.connect(filter);
        filter.connect(gain);
        if (!connectVoice(gain)) return;
        source.start();
      }

      function playCue(element, final = false) {
        if (!soundOn) return;
        const context = getAudioContext();
        if (!context || context.state !== 'running') return;
        if (final) {
          tone(196, 1.7, 0.034, 'sine');
          tone(294, 1.45, 0.018, 'sine', 0.08);
          return;
        }
        const last = cueLocks.get(element) || 0;
        if (performance.now() - last < 350) return;
        cueLocks.set(element, performance.now());
        if (element === 'stone') {
          tone(116.54, 1.2, 0.032, 'sine', 0, 92.5);
          tone(174.61, 0.85, 0.014, 'triangle', 0.025, 146.83);
        } else if (element === 'light') {
          tone(880, 0.75, 0.012, 'sine');
          tone(1318.51, 0.9, 0.008, 'sine', 0.075);
        } else if (element === 'fire') {
          crackle();
          tone(246.94, 0.55, 0.009, 'triangle', 0.02, 220);
        } else if (element === 'water') {
          tone(523.25, 0.95, 0.016, 'sine', 0, 392);
          tone(783.99, 0.65, 0.008, 'sine', 0.045, 659.25);
        }
      }

      function pulse(button) {
        button.classList.remove('is-touched');
        requestAnimationFrame(() => button.classList.add('is-touched'));
        window.setTimeout(() => button.classList.remove('is-touched'), 900);
      }

      function tend(button) {
        const element = button.dataset.element;
        if (!element) return;
        pulse(button);
        playCue(element);
        if (visited.has(element)) {
          say(announcements[element]);
          return;
        }
        visited.add(element);
        button.setAttribute('aria-pressed', 'true');
        button.classList.add('is-present');
        say(announcements[element]);

        if (visited.size === presenceButtons.length) {
          shrine.dataset.complete = 'true';
          completion.setAttribute('aria-hidden', 'false');
          completion.removeAttribute('inert');
          window.setTimeout(() => {
            playCue('', true);
            say('All four are present. Nothing more is asked.');
          }, 450);
        }
      }

      function beginAgain() {
        visited.clear();
        shrine.dataset.complete = 'false';
        presenceButtons.forEach((button) => {
          button.setAttribute('aria-pressed', 'false');
          button.classList.remove('is-present', 'is-touched');
        });
        const first = presenceButtons.find((button) => button instanceof HTMLButtonElement);
        first?.focus();
        completion.setAttribute('aria-hidden', 'true');
        completion.setAttribute('inert', '');
        say('The shrine is ready. Move in any order.');
      }

      presenceButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.addEventListener('click', () => tend(button));
      });

      soundButton.addEventListener('click', () => {
        if (soundOn || listeningIntent) stopListening();
        else beginListening();
      });

      volumeControl.addEventListener('input', () => {
        if (masterGain && audioContext) {
          masterGain.gain.cancelScheduledValues(audioContext.currentTime);
          masterGain.gain.setTargetAtTime(volumeValue(), audioContext.currentTime, 0.04);
        }
      });

      ambience.addEventListener('error', () => {
        listeningIntent = false;
        soundOperation += 1;
        audioFailed = true;
        soundOn = false;
        shrine.dataset.sound = 'false';
        soundButton.setAttribute('aria-pressed', 'false');
        soundLabel.textContent = 'Sound unavailable';
        say('Sound unavailable — the shrine still works silently.');
      });

      againButton.addEventListener('click', beginAgain);

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) return;
        if (!listeningIntent && !soundOn && ambience.paused) return;
        stopListening('Listening paused while you were away. Begin again when ready.', true);
      });
    })();
  </script>
</BlockLayout>

<style>
  :global(html) {
    background: #111310;
  }

  :global(body) {
    padding-bottom: 0 !important;
    background: #111310 !important;
  }

  :global(.skip-link) {
    z-index: 1000;
  }

  .es {
    --field: #111310;
    --field-deep: #090b09;
    --stone: #8d8a7e;
    --stone-light: #b9b4a2;
    --paper: #ddd0ae;
    --paper-soft: rgba(221, 208, 174, 0.66);
    --paper-faint: rgba(221, 208, 174, 0.24);
    --ember: #c96f32;
    --ember-bright: #efbb72;
    --water: #668b8e;
    --water-bright: #93bec0;
    --light: #f1ddb0;
    min-height: 100svh;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: max(1rem, env(safe-area-inset-top)) clamp(1rem, 3vw, 3rem) max(1.25rem, env(safe-area-inset-bottom));
    color: var(--paper);
    background:
      radial-gradient(circle at 50% 22%, rgba(241, 221, 176, 0.07), transparent 25rem),
      radial-gradient(circle at 10% 84%, rgba(102, 139, 142, 0.12), transparent 29rem),
      radial-gradient(circle at 88% 80%, rgba(201, 111, 50, 0.08), transparent 25rem),
      linear-gradient(152deg, #151813 0%, var(--field) 46%, var(--field-deep) 100%);
  }

  .es__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      radial-gradient(circle at 18% 28%, rgba(255,255,255,0.22) 0 0.5px, transparent 0.8px),
      radial-gradient(circle at 72% 64%, rgba(255,255,255,0.16) 0 0.45px, transparent 0.75px);
    background-size: 7px 7px, 11px 11px;
    mix-blend-mode: soft-light;
  }

  .es__glow {
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.04;
    z-index: -1;
  }

  .es__glow--left { left: -20rem; top: 25%; background: var(--water); }
  .es__glow--right { right: -20rem; top: 35%; background: var(--ember); }

  .es__nav {
    position: relative;
    z-index: 12;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font: 500 0.68rem/1 var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(221, 208, 174, 0.5);
  }

  .es__nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: rgba(221, 208, 174, 0.76);
    text-decoration: none;
  }

  .es__nav a:hover { color: var(--light); }

  .es__header {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    max-width: 94rem;
    margin: clamp(1rem, 2.5vh, 2rem) auto 0;
  }

  .es__heading { max-width: 58rem; }

  .es__kicker,
  .es__invitation,
  .es__footer,
  .es__sound-panel {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
  }

  .es__kicker {
    margin: 0 0 0.55rem;
    color: var(--paper-soft);
    font-size: clamp(0.64rem, 1vw, 0.77rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .es h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.55rem, 5.2vw, 6rem);
    font-weight: 400;
    letter-spacing: 0.055em;
    line-height: 0.88;
    text-wrap: balance;
    text-shadow: 0 0 2rem rgba(241, 221, 176, 0.08);
  }

  .es__invitation {
    margin: 0.85rem 0 0;
    color: var(--paper-soft);
    font-size: clamp(0.76rem, 1.15vw, 0.92rem);
    letter-spacing: 0.06em;
  }

  .es__sound-panel {
    display: grid;
    gap: 0.65rem;
    min-width: min(100%, 15rem);
    padding: 0.75rem;
    border: 1px solid rgba(221, 208, 174, 0.14);
    background: rgba(8, 10, 8, 0.46);
    backdrop-filter: blur(14px);
  }

  .es__sound {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid rgba(221, 208, 174, 0.34);
    border-radius: 999px;
    padding: 0.65rem 1rem;
    color: var(--paper);
    background: rgba(221, 208, 174, 0.04);
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .es__sound:hover { border-color: rgba(241, 221, 176, 0.7); }
  .es__sound[aria-pressed='true'] { background: rgba(102, 139, 142, 0.16); }
  .es__sound-mark { font-size: 1.1rem; }
  .es[data-sound='true'] .es__sound-mark { animation: es-listening 3.8s ease-in-out infinite; }

  .es__volume {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem;
    color: rgba(221, 208, 174, 0.58);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .es__volume input {
    width: 100%;
    accent-color: var(--water-bright);
    cursor: pointer;
  }

  .es__altar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(16rem, 1.15fr) minmax(12rem, 1fr);
    grid-template-rows: minmax(9rem, 0.85fr) minmax(12rem, 1.2fr) minmax(9rem, 0.85fr);
    grid-template-areas:
      '. light .'
      'stone center fire'
      'water water water';
    min-height: clamp(30rem, calc(100svh - 15.5rem), 46rem);
    max-width: 94rem;
    margin: clamp(0.6rem, 2vh, 1.5rem) auto 0;
    border-bottom: 1px solid rgba(221, 208, 174, 0.13);
  }

  .es__arch {
    position: absolute;
    inset: 1.5rem 6% 0;
    border: 1px solid rgba(221, 208, 174, 0.12);
    border-bottom: 0;
    border-radius: 48% 48% 0 0 / 28% 28% 0 0;
