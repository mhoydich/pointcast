---
/**
 * /drum-holding-back — drum room around Simply Red, "Holding Back the Years".
 *
 * Mike: "a drum room around https://open.spotify.com/track/1yg7fwwYmx9DQ2TdXUmfpJ,
 * holding back the years, simply red."
 *
 * Spotify embed at the top. Below: five soft drum pads tuned to the
 * E-minor pentatonic (E2 G2 A2 B2 D3) so any taps you make are in
 * key with the track. Each pad: warm sine + brief filtered noise
 * burst, like a felted mallet on a soft wood. A slow Em9 pad fades
 * in with the first tap and stays underneath, ~30s ramp.
 *
 * Velvet maroon + amber palette, aged-paper texture in the corners.
 * The room is built for sitting in, not for cranking out beats.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Holding Back the Years · drum room · PointCast';
const description =
  'A slow drum room around Simply Red\'s "Holding Back the Years". Five soft pads tuned to E-minor pentatonic. Spotify embed up top. Tap quietly.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Drum Room · Holding Back the Years',
  url: 'https://pointcast.xyz/drum-holding-back',
  description,
  applicationCategory: 'MultimediaApplication',
};

const TRACK_ID = '1yg7fwwYmx9DQ2TdXUmfpJ';

const PADS = [
  { note: 'E',  freq: 164.81, label: 'E2', hue: 22  },
  { note: 'G',  freq: 196.00, label: 'G2', hue: 50  },
  { note: 'A',  freq: 220.00, label: 'A2', hue: 80  },
  { note: 'B',  freq: 246.94, label: 'B2', hue: 200 },
  { note: 'D',  freq: 293.66, label: 'D3', hue: 320 },
];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dh" id="dh-main">
    <DrumNav current="holding-back" />

    <header class="dh__header">
      <div class="dh__chrome">
        <span>DRUM ROOM</span>
        <span class="dh__chrome-sep">·</span>
        <span>SIMPLY RED</span>
        <span class="dh__chrome-sep">·</span>
        <span>E MINOR PENTATONIC</span>
      </div>
      <h1 class="dh__title">HOLDING BACK<br/>THE YEARS</h1>
      <p class="dh__tagline">tap quietly. the room is built for sitting in.</p>
    </header>

    <section class="dh__embed-wrap">
      <iframe
        class="dh__embed"
        title="Holding Back the Years — Simply Red"
        src={`https://open.spotify.com/embed/track/${TRACK_ID}?utm_source=pointcast`}
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </section>

    <section class="dh__pads" aria-label="Five soft drum pads tuned to E minor pentatonic">
      {PADS.map((p, i) => (
        <button class="dh__pad" type="button" data-idx={i} data-freq={p.freq} aria-label={`Pad ${p.label}`}>
          <span class="dh__pad-note">{p.note}</span>
          <span class="dh__pad-octave">{p.label}</span>
          <span class="dh__pad-glow" style={`background: radial-gradient(circle, oklch(0.65 0.20 ${p.hue}) 0%, transparent 70%);`}></span>
        </button>
      ))}
    </section>

    <footer class="dh__readout">
      <div class="dh__panel">
        <div class="dh__panel-label">YOUR TAPS</div>
        <div class="dh__panel-value" id="dh-taps">0</div>
      </div>
      <div class="dh__quote">
        <span class="dh__quote-mark">"</span>
        <span class="dh__quote-text">i'll keep holding on</span>
        <span class="dh__quote-mark">"</span>
      </div>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dh-main) { background: #1a0510; }

  .dh {
    --dh-maroon: #2a0d18;
    --dh-maroon-deep: #15050a;
    --dh-maroon-mid: #3a1422;
    --dh-amber: #d6a247;
    --dh-amber-soft: #b6822a;
    --dh-amber-deep: #6b4a12;
    --dh-rose: #d6346a;
    --dh-cream: #f4e7c8;
    --dh-ink-mid: #c9b78c;
    --dh-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dh-cream);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(214, 162, 71, 0.14), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(214, 52, 106, 0.10), transparent 70%),
      linear-gradient(180deg, var(--dh-maroon) 0%, var(--dh-maroon-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .dh::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 30px 30px, rgba(214, 162, 71, 0.07) 1.5px, transparent 2px),
      radial-gradient(circle at 90px 70px, rgba(214, 52, 106, 0.05) 1.5px, transparent 2px);
    background-size: 130px 130px;
    opacity: 0.5;
    z-index: -1;
  }
  .dh .drum-nav {
    opacity: 0.40;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .dh__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(20px, 3vh, 32px);
  }
  .dh__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px;
    border: 1.5px solid var(--dh-amber-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dh-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .dh__chrome-sep { color: var(--dh-amber-deep); }
  .dh__title {
    margin: clamp(10px, 1.4vh, 18px) 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(36px, 6vw, 84px);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: var(--dh-amber);
    text-shadow:
      0 0 32px rgba(214, 162, 71, 0.45),
      0 2px 0 var(--dh-maroon-deep);
  }
  .dh__tagline {
    margin: 0 auto;
    max-width: 520px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--dh-ink-mid);
  }

  /* Spotify embed wrap */
  .dh__embed-wrap {
    max-width: 720px;
    margin: 0 auto clamp(24px, 4vh, 40px);
    padding: 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1.5px solid var(--dh-amber-deep);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 rgba(214, 162, 71, 0.20),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 6px 18px rgba(0, 0, 0, 0.4);
  }
  .dh__embed {
    width: 100%;
    border-radius: 8px;
    display: block;
  }

  /* Drum pads — five horizontal pads */
  .dh__pads {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(10px, 1.5vw, 20px);
    max-width: 720px;
    margin: 0 auto clamp(20px, 3vh, 32px);
  }
  .dh__pad {
    position: relative;
    appearance: none;
    border: 0;
    cursor: pointer;
    aspect-ratio: 1;
    background: linear-gradient(180deg, var(--dh-maroon-mid) 0%, var(--dh-maroon-deep) 100%);
    border: 1.5px solid var(--dh-amber-deep);
    box-shadow:
      inset 0 1px 0 rgba(214, 162, 71, 0.18),
      inset 0 -2px 0 rgba(0, 0, 0, 0.4),
      0 4px 0 0 var(--dh-maroon-deep),
      0 4px 12px rgba(0, 0, 0, 0.4);
    color: var(--dh-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    overflow: hidden;
    transition: transform 80ms, box-shadow 100ms;
  }
  .dh__pad:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(214, 162, 71, 0.30),
      inset 0 -2px 0 rgba(0, 0, 0, 0.4),
      0 5px 0 0 var(--dh-maroon-deep),
      0 6px 16px rgba(214, 162, 71, 0.18);
  }
  .dh__pad:active, .dh__pad.dh__pad--struck {
    transform: translateY(3px);
    box-shadow:
      inset 0 1px 0 rgba(214, 162, 71, 0.40),
      inset 0 -2px 0 rgba(0, 0, 0, 0.4),
      0 1px 0 0 var(--dh-maroon-deep),
      0 0 22px rgba(214, 162, 71, 0.55);
  }

  .dh__pad-note {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 42px);
    color: var(--dh-amber);
    line-height: 1;
    text-shadow: 0 0 14px rgba(214, 162, 71, 0.45);
  }
  .dh__pad-octave {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--dh-ink-dim);
  }

  /* Glow rises briefly on tap */
  .dh__pad-glow {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    opacity: 0;
    filter: blur(18px);
    mix-blend-mode: screen;
    transition: opacity 380ms ease-out;
  }
  .dh__pad.dh__pad--struck .dh__pad-glow {
    opacity: 0.70;
    transition: opacity 80ms ease-out;
  }

  /* Readout + quote */
  .dh__readout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vw, 60px);
    flex-wrap: wrap;
    padding: clamp(14px, 2vh, 24px) 0;
    border-top: 1px solid rgba(214, 162, 71, 0.18);
  }
  .dh__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 16px;
    border: 1px solid var(--dh-amber-deep);
    background: rgba(0, 0, 0, 0.3);
    min-width: 110px;
  }
  .dh__panel-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dh-ink-dim);
  }
  .dh__panel-value {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 800;
    color: var(--dh-amber);
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px rgba(214, 162, 71, 0.35);
  }
  .dh__quote {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(15px, 1.5vw, 20px);
    color: var(--dh-rose);
    text-shadow: 0 0 12px rgba(214, 52, 106, 0.30);
  }
  .dh__quote-mark { color: var(--dh-amber); font-style: normal; }
</style>

<script>
  // ── Audio ────────────────────────────────────────────
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  // Soft felted-mallet voice: sine fundamental + brief filtered noise burst
  function playPad(freq) {
    const a = ctx(); const t = a.currentTime;
    // Sine body
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 2.0;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.30, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.10, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
    o.connect(g).connect(a.destination);
    o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.7); o2.start(t); o2.stop(t + 1.0);

    // Noise burst — felted-mallet "thump" attack
    const bufferSize = a.sampleRate * 0.06;
    const buffer = a.createBuffer(1, bufferSize, a.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
    const noise = a.createBufferSource(); noise.buffer = buffer;
    const noiseFilter = a.createBiquadFilter(); noiseFilter.type = 'bandpass';
    noiseFilter.frequency.value = freq * 1.5;
    noiseFilter.Q.value = 2.5;
    const noiseGain = a.createGain();
    noiseGain.gain.setValueAtTime(0.18, t);
    noiseGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
    noise.connect(noiseFilter).connect(noiseGain).connect(a.destination);
    noise.start(t);
  }

  // Slow Em9 pad — fades in with first tap and stays
  let padNodes = null;
  function startBackingPad() {
    if (padNodes) return;
    const a = ctx(); const t = a.currentTime;
    // Em9: E G B D F# (1, ♭3, 5, ♭7, 9). Drop the 9th to keep it cozy: E G B D
    const FREQS = [82.41, 98.00, 123.47, 146.83]; // E2 G2 B2 D3
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 1100;
    const masterGain = a.createGain();
    masterGain.gain.setValueAtTime(0.0001, t);
    masterGain.gain.exponentialRampToValueAtTime(0.07, t + 30);
    filt.connect(masterGain); masterGain.connect(a.destination);
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.06 + Math.random() * 0.04;
      const lfoGain = a.createGain(); lfoGain.gain.value = 0.4;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      lfo.start(t); o.connect(filt); o.start(t);
      return { o, lfo };
    });
    padNodes = { oscs, filt, masterGain };
  }

  // ── DOM + state ──────────────────────────────────────
  const padEls = Array.from(document.querySelectorAll('.dh__pad'));
  const tapsEl = document.getElementById('dh-taps');
  let taps = 0;
  let backingStarted = false;

  function paint() {
    if (tapsEl) tapsEl.textContent = String(taps);
  }
  paint();

  function strikePad(idx) {
    const padEl = padEls[idx];
    if (!padEl) return;
    if (!backingStarted) {
      backingStarted = true;
      try { startBackingPad(); } catch {}
    }
    const freq = parseFloat(padEl.dataset.freq || '220');
    try { playPad(freq); } catch {}
    padEl.classList.remove('dh__pad--struck');
    void padEl.offsetWidth;
    padEl.classList.add('dh__pad--struck');
    setTimeout(() => padEl.classList.remove('dh__pad--struck'), 220);
    taps += 1;
    paint();
  }

  padEls.forEach((el, i) => {
    el.addEventListener('click', () => strikePad(i));
  });

  // Keyboard: 1-5 strike pads
  window.addEventListener('keydown', (e) => {
    if (e.key === '1') strikePad(0);
    else if (e.key === '2') strikePad(1);
    else if (e.key === '3') strikePad(2);
    else if (e.key === '4') strikePad(3);
    else if (e.key === '5') strikePad(4);
  });
</script>
