---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  POINTCAST_25,
  POINTCAST_25_SIGNAL_LABELS,
  type PointCast25Signal,
} from '../../lib/pointcast-25';
import {
  POINTCAST_25_DISSENTS,
  pointcast25TeamSlug,
} from '../../lib/pointcast-25-audience';
import { POINTCAST_25_ALABAMA } from '../../lib/pointcast-25-alabama';

const description =
  'PointCast 25 is a college-football poll with receipts: one case, one doubt, and one next proof for every ranked team.';
const topFive = POINTCAST_25.teams.slice(0, 5);
const published = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Los_Angeles',
}).format(new Date(POINTCAST_25.publishedAt));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': 'https://pointcast.xyz/25#board',
      name: `${POINTCAST_25.title} — Board ${POINTCAST_25.board}`,
      description,
      url: 'https://pointcast.xyz/25',
      numberOfItems: POINTCAST_25.teams.length,
      datePublished: POINTCAST_25.publishedAt,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: POINTCAST_25.teams.map((team) => ({
        '@type': 'ListItem',
        position: team.rank,
        name: team.school,
        description: team.reason,
      })),
    },
    {
      '@type': 'Product',
      '@id': 'https://pointcast.xyz/25#season-ticket',
      name: POINTCAST_25.sale.name,
      description: POINTCAST_25.sale.promise,
      brand: {
        '@type': 'Brand',
        name: 'PointCast',
      },
      offers: {
        '@type': 'Offer',
        price: String(POINTCAST_25.sale.priceUsd),
        priceCurrency: 'USD',
        url: POINTCAST_25.sale.checkout,
        availability: 'https://schema.org/InStock',
      },
    },
  ],
};
---

<BlockLayout
  title="25 FOR REASONS"
  description={description}
  image="/images/pointcast-25/board-000.png"
  themeColor="#f4ff3f"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/25.json', title: 'PointCast 25 Board 000 JSON' },
    { type: 'application/rss+xml', href: '/c/spinning.rss', title: 'PointCast Spinning RSS' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/pointcast-25/board-000.png',
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Open the 25', action: 'link', target: 'https://pointcast.xyz/25' },
      { label: '$25 season ticket', action: 'link', target: 'https://pointcast.xyz/api/25/checkout' },
    ],
  }}
  immersive={true}
  showNetworkStrip={false}
>
  <div class="p25">
    <header class="mast">
      <a class="mast__brand" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav class="mast__nav" aria-label="PointCast 25 navigation">
        <a href="/25/magazine">Magazine</a>
        <a href="/25/fan-clique">Fan Clique</a>
        <a href="/25/magazine/sound-of-focus">Sound Desk</a>
        <a href="#board">The 25</a>
        <a href="/25/alabama-after-saban">Alabama file</a>
        <a href="/25/disagreements">Disagreements</a>
        <a href="/25/receipts">Receipts</a>
        <a href="#method">Method</a>
        <a href="/25/season">Season ledger</a>
        <a href="/c/spinning.rss">Follow</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="p25-title">
        <div class="hero__number" aria-hidden="true">25</div>
        <div class="hero__copy">
          <p class="eyebrow">BOARD {POINTCAST_25.board} · PRESEASON · {published}</p>
          <h1 id="p25-title">FOR<br /><em>REASONS</em></h1>
          <p class="hero__dek">{POINTCAST_25.subtitle}</p>
          <p class="hero__question">{POINTCAST_25.question}</p>
          <div class="hero__actions">
            <a class="button button--ink" href="#board">Read the board ↓</a>
            <a
              class="button button--paper"
              href="/api/25/checkout"
              target="_blank"
              rel="noopener sponsored"
              data-checkout-link
            >
              Buy season ticket · $25
            </a>
          </div>
        </div>
        <ol class="hero__five" aria-label="Top five">
          {topFive.map((team) => (
            <li>
              <span>{String(team.rank).padStart(2, '0')}</span>
              <strong>{team.school}</strong>
              <small>{team.conference}</small>
            </li>
          ))}
        </ol>
      </section>

      <div class="ticker" aria-label="PointCast 25 publishing schedule">
        <span>NEW BOARD TUESDAY · 08:08 PT</span>
        <span>THE REASONS MOVE OR THE TEAM DOESN’T</span>
        <span>NO DELETED PRESEASON TAKES</span>
      </div>

      <section class="opening" aria-labelledby="opening-title">
        <p class="section-label">WHY THIS EXISTS</p>
        <div>
          <h2 id="opening-title">The number is the headline.<br />The reason is the product.</h2>
          <p>
            A rank without a claim is disposable. Every team below carries a case,
            a doubt, and the next proof we require. When the board moves, the old
            sentence stays attached. At the end of the season, the whole argument
            remains available for autopsy.
          </p>
        </div>
      </section>

      <a class="magazine-door" href="/25/magazine">
        <span class="magazine-door__issue">ISSUE 001 · THE OPEN FIELD</span>
        <strong>THE RANKING IS<br />ONE DEPARTMENT.</strong>
        <p>
          Enter the complete PointCast College Football magazine: the board,
          receipts, 35-program Song Yard, mascot desk, future school, Saturday
          Commons, the longform House Desk, and a season ledger that remembers.
        </p>
        <b>OPEN THE MAGAZINE ↗</b>
      </a>

      <a class="fan-clique-door" href="/25/fan-clique">
        <span>
          <small>CROWD DESK 001 · LIVE</small>
          <strong>FAN<br />CLIQUE</strong>
        </span>
        <p>
          Not the best team. Just the school whose people found one button and
          clicked it most. Pick yours, count one, bring the crowd.
        </p>
        <b>VOTE FOR MY TEAM ↗</b>
      </a>

      <a class="focus-door" href="/25/magazine/sound-of-focus">
        <img
          src="/images/pointcast-focus/social-card.png"
          alt="25 × Tone Bloom — The Sound of Focus"
          width="1200"
          height="630"
          loading="lazy"
        />
        <span class="focus-door__copy">
          <small>SOUND DESK 001 · POINTCAST 25 × TONE BLOOM</small>
          <strong>THE SOUND<br />OF FOCUS</strong>
          <p>
            Film room, playbook, belief board, Saturday operations, and the walk
            home become five listening states and one playable study.
          </p>
          <b>OPEN THE FEATURE ↗</b>
        </span>
      </a>

      <section class="field-file" aria-labelledby="field-file-title">
        <div class="field-file__mark" aria-hidden="true">A</div>
        <div class="field-file__copy">
          <p class="section-label">NEW · FIELD FILE 001 · BLOCK 0529</p>
          <h2 id="field-file-title">{POINTCAST_25_ALABAMA.title}</h2>
          <p>{POINTCAST_25_ALABAMA.description}</p>
          <div class="field-file__facts" aria-label="Alabama field file facts">
            <span>POINTCAST #{POINTCAST_25_ALABAMA.board.pointcastRank}</span>
            <span>SEC MEDIA #{POINTCAST_25_ALABAMA.board.secMediaRank}</span>
            <span>DEBOER {POINTCAST_25_ALABAMA.board.deboerRecord}</span>
          </div>
          <a class="button button--signal" href="/25/alabama-after-saban">
            Read the complete field file →
          </a>
        </div>
      </section>

      <section class="disagreement" aria-labelledby="disagreement-title">
        <div class="disagreement__lead">
          <p class="section-label">THE DISAGREEMENT INDEX</p>
          <h2 id="disagreement-title">The reference is useful.<br />The distance is the story.</h2>
          <p>
            Five teams PointCast believes in more than ESPN’s preseason FPI.
            Every difference carries a reason, a doubt, and a next proof.
          </p>
          <a class="button button--signal" href="/25/disagreements">Open all five disagreements →</a>
        </div>
        <ol>
          {POINTCAST_25_DISSENTS.map((team) => (
            <li style={`--team-accent:${team.accent}`}>
              <a href={`/25/teams/${team.slug}`}>
                <span>#{team.rank}</span>
                <strong>{team.school}</strong>
                <small>{team.referenceRank ? `FPI #${team.referenceRank}` : 'FPI NR'}</small>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="board-shell" id="board" aria-labelledby="board-title">
        <div class="board-head">
          <div>
            <p class="section-label">THE BELIEF BOARD</p>
            <h2 id="board-title">Board {POINTCAST_25.board}</h2>
          </div>
          <p class="board-head__note">
            Tap a team for its receipts. Pin teams locally for your Saturday board.
            Nothing is transmitted.
          </p>
        </div>

        <div class="filters" role="group" aria-label="Filter the PointCast 25">
          <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All 25</button>
          <button type="button" class="filter" data-filter="title-weather" aria-pressed="false">Title weather</button>
          <button type="button" class="filter" data-filter="playoff-weather" aria-pressed="false">Playoff</button>
          <button type="button" class="filter" data-filter="fault-line" aria-pressed="false">Fault lines</button>
          <button type="button" class="filter" data-filter="outsider" aria-pressed="false">Outsiders</button>
          <button type="button" class="filter" data-filter="saved" aria-pressed="false">My board</button>
        </div>
        <p class="filter-status" data-filter-status aria-live="polite">Showing all 25 teams.</p>

        <ol class="board-list">
          {POINTCAST_25.teams.map((team) => (
            <li
              class="team"
              data-team
              data-school={team.short}
              data-signal={team.signal}
              style={`--team-accent:${team.accent}`}
            >
              <article>
                <div class="team__rank">
                  <span>{String(team.rank).padStart(2, '0')}</span>
                  <small>{team.movement}</small>
                </div>
                <div class="team__identity">
                  <p>{team.conference} · {POINTCAST_25_SIGNAL_LABELS[team.signal as PointCast25Signal]}</p>
                  <h3><a href={`/25/teams/${pointcast25TeamSlug(team.school)}`}>{team.school}</a></h3>
                  <p class="team__reason">{team.reason}</p>
                </div>
                <button
                  class="pin"
                  type="button"
                  data-pin={team.short}
                  aria-pressed="false"
                  aria-label={`Pin ${team.school} to my board`}
                >
                  <span aria-hidden="true">＋</span>
                  <span data-pin-label>Pin</span>
                </button>
                <details class="receipts">
                  <summary>Open the reasons</summary>
                  <div class="receipts__grid">
                    <div>
                      <span>CASE</span>
                      <p>{team.case}</p>
                    </div>
                    <div>
                      <span>DOUBT</span>
                      <p>{team.doubt}</p>
                    </div>
                    <div>
                      <span>NEXT PROOF</span>
                      <p>{team.proof}</p>
                    </div>
                  </div>
                </details>
              </article>
            </li>
          ))}
        </ol>
      </section>

      <section class="method" id="method" aria-labelledby="method-title">
        <div class="method__lead">
          <p class="section-label">THE METHOD</p>
          <h2 id="method-title">Opinion, made falsifiable.</h2>
          <p>
            This is not a résumé ranking, a recruiting ranking, or a television
            inventory list. It is an authored belief board informed by available
            evidence and preserved in public.
          </p>
        </div>
        <ol class="method__grid">
          {POINTCAST_25.methodology.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.label}</h3>
              <p>{item.note}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="week" aria-labelledby="week-title">
        <p class="section-label">THE WEEK</p>
        <h2 id="week-title">One season. Four useful moments.</h2>
        <div class="week__grid">
          {Object.entries(POINTCAST_25.cadence).map(([day, note]) => (
            <article>
              <h3>{day}</h3>
              <p>{note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="ticket" id="ticket" aria-labelledby="ticket-title">
        <div class="ticket__stub">
          <span>PC25</span>
          <span>2026</span>
          <strong>$25</strong>
        </div>
        <div class="ticket__copy">
          <p class="section-label">FOUNDING SEASON TICKET</p>
          <h2 id="ticket-title">Back the complete argument.</h2>
          <p>{POINTCAST_25.sale.promise}</p>
          <ul>
            <li>One payment. Not a recurring charge.</li>
            <li>The public board, Tuesday editions, permanent team pages, and the end-of-season autopsy.</li>
            <li>Card entry and payment receipt handled on Stripe’s hosted checkout.</li>
            <li>PointCast never receives or stores your card number.</li>
          </ul>
          <div class="ticket__actions">
            <a
              class="button button--signal"
              href="/api/25/checkout"
              target="_blank"
              rel="noopener sponsored"
              data-checkout-link
            >
              Buy the $25 Season Ticket ↗
            </a>
            <a class="text-link" href="/25/terms">Plain-language terms</a>
          </div>
        </div>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <div>
          <p class="section-label">SOURCE DESK</p>
          <h2 id="sources-title">Receipts behind Board {POINTCAST_25.board}.</h2>
        </div>
        <ol>
          {POINTCAST_25.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener">
                <strong>{source.label}</strong>
                <span>{source.publisher} · checked {source.checkedAt} ↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <footer class="p25-footer">
        <div>
          <strong>25 FOR REASONS</strong>
          <span>Board {POINTCAST_25.board} · Block 0510</span>
        </div>
      <nav aria-label="PointCast 25 footer navigation">
        <a href="/25/magazine">Magazine</a>
        <a href="/25/magazine/sound-of-focus">Sound Desk</a>
        <a href="/25/disagreements">Disagreements</a>
        <a href="/25/receipts">Receipts</a>
        <a href="/25/boards/000">Permanent Board 000</a>
        <a href="/25/season">Season ledger</a>
        <a href="/25.json">JSON</a>
          <a href="/c/spinning.rss">RSS</a>
          <a href="/b/0510">Permanent Block</a>
          <a href="/">PointCast</a>
        </nav>
      </footer>
    </main>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('.p25');
      if (!(root instanceof HTMLElement)) return;

      const key = 'pointcast:25:watchlist:v1';
      const teamRows = [...root.querySelectorAll('[data-team]')];
      const filterButtons = [...root.querySelectorAll('[data-filter]')];
      const status = root.querySelector('[data-filter-status]');

      let saved = [];
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || '[]');
        saved = Array.isArray(parsed) ? parsed.filter((value) => typeof value === 'string') : [];
      } catch {
        saved = [];
      }

      function refreshPins() {
        root.querySelectorAll('[data-pin]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const school = button.dataset.pin || '';
          const active = saved.includes(school);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
          const label = button.querySelector('[data-pin-label]');
          if (label) label.textContent = active ? 'Pinned' : 'Pin';
        });
      }

      function applyFilter(filter) {
        let visible = 0;
        teamRows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const show =
            filter === 'all'
            || (filter === 'saved' && saved.includes(row.dataset.school || ''))
            || row.dataset.signal === filter;
          row.hidden = !show;
          if (show) visible += 1;
        });

        filterButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const active = button.dataset.filter === filter;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (status) {
          status.textContent = filter === 'saved'
            ? (visible ? `Showing ${visible} pinned ${visible === 1 ? 'team' : 'teams'}.` : 'Your board is empty. Pin a team to begin.')
            : `Showing ${visible} ${visible === 1 ? 'team' : 'teams'}.`;
        }
      }

      filterButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all'));
      });

      root.querySelectorAll('[data-pin]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const school = button.dataset.pin || '';
          saved = saved.includes(school)
            ? saved.filter((value) => value !== school)
            : [...saved, school];
          try {
            localStorage.setItem(key, JSON.stringify(saved));
          } catch {}
          refreshPins();
          const activeFilter = filterButtons.find((item) => item.getAttribute('aria-pressed') === 'true');
          if (activeFilter instanceof HTMLButtonElement && activeFilter.dataset.filter === 'saved') {
            applyFilter('saved');
          }
        });
      });

      refreshPins();
    })();
  </script>
</BlockLayout>

<style>
  :global(html) {
    background: #f3f0e8;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f0e8;
    color: #10100f;
    font-family: var(--pc-font-sans);
  }

  :global([hidden]) {
    display: none !important;
  }

  .p25 {
    --signal: #f4ff3f;
    --paper: #f3f0e8;
    --ink: #10100f;
    min-height: 100vh;
    overflow: hidden;
  }

  .mast {
    align-items: center;
    background: var(--ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    color: white;
    display: flex;
    justify-content: space-between;
    padding: 14px clamp(16px, 3vw, 42px);
  }

  .mast__brand {
    color: white;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .mast__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .mast__nav a,
  .p25-footer a {
    color: inherit;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero {
    background: var(--ink);
    color: white;
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(360px, 1fr) minmax(240px, 0.65fr);
    min-height: 690px;
    position: relative;
  }

  .hero__number {
    align-items: flex-start;
    color: var(--signal);
    display: flex;
    font-size: clamp(250px, 34vw, 620px);
    font-weight: 900;
    letter-spacing: -0.13em;
    line-height: 0.76;
    padding-top: 66px;
    transform: translateX(-0.04em);
  }

  .hero__copy {
    align-self: center;
    padding: 70px 24px 70px 10px;
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-label {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .hero h1 {
    font-size: clamp(68px, 9.2vw, 150px);
    font-weight: 900;
    letter-spacing: -0.09em;
    line-height: 0.75;
    margin: 0;
    text-transform: uppercase;
  }

  .hero h1 em {
    color: var(--signal);
    font-style: normal;
  }

  .hero__dek {
    font-size: clamp(22px, 2.3vw, 38px);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 32px 0 8px;
  }

  .hero__question {
    color: #c8c7c0;
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    max-width: 560px;
  }

  .hero__actions,
  .ticket__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .button {
    align-items: center;
    border: 1px solid currentColor;
    display: inline-flex;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 800;
    justify-content: center;
    letter-spacing: 0.08em;
    min-height: 48px;
    padding: 0 18px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .button--ink {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }

  .button--paper {
    color: white;
  }

  .button--signal {
    background: var(--signal);
    border-color: var(--ink);
    color: var(--ink);
  }

  .hero__five {
    align-self: end;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    list-style: none;
    margin: 0;
    padding: 0 0 42px;
  }

  .hero__five li {
    align-items: baseline;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    display: grid;
    gap: 12px;
    grid-template-columns: 34px 1fr auto;
    padding: 16px 22px;
  }

  .hero__five span,
  .hero__five small {
    color: #a7a6a0;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__five strong {
    font-size: 18px;
    letter-spacing: -0.04em;
  }

  .ticker {
    background: var(--signal);
    display: flex;
    gap: 48px;
    justify-content: center;
    overflow: hidden;
    padding: 12px 18px;
    white-space: nowrap;
  }

  .ticker span {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .opening,
  .method,
  .week,
  .sources {
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(150px, 0.3fr) minmax(0, 1fr);
    padding: clamp(60px, 9vw, 130px) clamp(18px, 5vw, 78px);
  }

  .opening h2,
  .method h2,
  .week h2,
  .sources h2,
  .ticket h2 {
    font-size: clamp(42px, 6.6vw, 94px);
    letter-spacing: -0.07em;
    line-height: 0.9;
    margin: 0;
  }

  .opening p:not(.section-label),
  .method__lead > p:not(.section-label),
  .ticket__copy > p {
    font-size: clamp(18px, 2vw, 28px);
    line-height: 1.45;
    max-width: 860px;
  }

  .magazine-door {
    display: grid;
