---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import frozen from '../../../lib/pointcast-25-board-000.frozen.json';
import { pointcast25TeamSlug } from '../../../lib/pointcast-25-audience';

// Board 000 renders from its frozen capture, never from the live POINTCAST_25
// object. The current board moves every Tuesday; this page does not.
const teams = frozen.teams.map((team) => ({ ...team, slug: pointcast25TeamSlug(team.school) }));

const description =
  'Permanent preseason edition of the 2026 PointCast college-football Top 25: all 25 teams, opening reasons, and links to the complete public receipts.';
const pageUrl = 'https://pointcast.xyz/25/boards/000';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${pageUrl}#board`,
  name: 'PointCast 25 — 2026 preseason Board 000',
  description,
  url: pageUrl,
  datePublished: frozen.publishedAt,
  numberOfItems: teams.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: teams.map((team) => ({
    '@type': 'ListItem',
    position: team.rank,
    url: `https://pointcast.xyz/25/teams/${team.slug}`,
    name: team.school,
    description: team.reason,
  })),
};
---

<BlockLayout
  title="2026 College Football Preseason Top 25 — Board 000"
  description={description}
  image="/images/pointcast-25/board-000.png"
  themeColor="#f4ff3f"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    {
      type: 'application/json',
      href: '/25/boards/000.json',
      title: 'PointCast 25 Board 000 immutable JSON',
    },
  ]}
>
  <main class="board-page">
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <nav aria-label="Board 000 navigation">
        <a href="/25">Current board</a>
        <a href="/25/disagreements">Disagreements</a>
        <a href="/25/receipts">Receipts</a>
        <a href="/25/boards/001">Board 001</a>
        <a href="/25/boards/000.json">JSON</a>
      </nav>
    </header>

    <section class="hero">
      <div class="number">000</div>
      <div>
        <p>PERMANENT BOARD · JULY 27, 2026 · PRESEASON</p>
        <h1>THE OPENING<br /><em>POSITION.</em></h1>
        <p class="dek">{frozen.question}</p>
      </div>
    </section>

    <section class="notice">
      <strong>IMMUTABLE EDITION</strong>
      <p>
        This page preserves the human-readable opening board. The current
        presentation may move; these rankings and reasons do not.
      </p>
    </section>

    <ol class="board">
      {teams.map((team) => (
        <li style={`--team:${team.accent}`}>
          <a href={`/25/teams/${team.slug}`}>
            <span class="rank">{String(team.rank).padStart(2, '0')}</span>
            <span class="identity">
              <small>{team.conference}</small>
              <strong>{team.school}</strong>
            </span>
            <span class="reason">{team.reason}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>

    <section class="after">
      <div>
        <p>WHAT AGED WELL?</p>
        <h2>Come back when<br />the evidence arrives.</h2>
      </div>
      <div>
        <a href="/25/receipts">Open the public receipt book →</a>
        <a href="/25/season">Open the season ledger →</a>
        <a href="/25/disagreements">See what PointCast believes differently →</a>
      </div>
    </section>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #10100f;
    color: #f6f3e9;
    font-family: var(--pc-font-sans);
  }

  .board-page {
    margin: 0 auto;
    max-width: 1500px;
  }

  .mast,
  .mast nav {
    align-items: center;
    display: flex;
  }

  .mast {
    border-bottom: 1px solid #44433f;
    justify-content: space-between;
    padding: 20px clamp(18px, 4vw, 64px);
  }

  .brand {
    font-size: 18px;
    font-weight: 900;
  }

  .mast nav {
    gap: clamp(12px, 2vw, 28px);
  }

  a {
    color: inherit;
    text-underline-offset: 4px;
  }

  .mast a,
  .hero p,
  .notice strong,
  .identity small,
  .after p {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(240px, 0.4fr) 1fr;
    min-height: 72vh;
    padding: 55px clamp(18px, 5vw, 80px);
  }

  .number {
    color: #f4ff3f;
    font-size: clamp(130px, 24vw, 360px);
    font-weight: 900;
    letter-spacing: -0.14em;
    line-height: 0.7;
    writing-mode: vertical-rl;
  }

  .hero > div:last-child {
    align-self: end;
  }

  .hero h1 {
    font-size: clamp(65px, 10vw, 150px);
    letter-spacing: -0.08em;
    line-height: 0.78;
    margin: 35px 0 48px;
  }

  .hero em {
    color: #f4ff3f;
    font-style: normal;
  }

  .dek {
    font-family: var(--pc-font-sans) !important;
    font-size: clamp(23px, 3vw, 42px) !important;
    letter-spacing: -0.03em !important;
    line-height: 1.15;
    max-width: 900px;
    text-transform: none !important;
  }

  .notice {
    background: #f4ff3f;
    color: #10100f;
    display: grid;
    gap: 30px;
    grid-template-columns: 0.3fr 1fr;
    padding: 34px clamp(18px, 5vw, 80px);
  }

  .notice p {
    font-size: clamp(18px, 2vw, 28px);
    margin: 0;
  }

  .board {
    list-style: none;
    margin: 0;
    padding: 0 clamp(18px, 5vw, 80px);
  }

  .board li {
    border-bottom: 1px solid #44433f;
  }

  .board a {
    align-items: center;
    display: grid;
    gap: 20px;
    grid-template-columns: 70px minmax(170px, 0.33fr) 1fr 30px;
    padding: 25px 0;
    text-decoration: none;
  }

  .rank {
    color: var(--team);
    font-size: 40px;
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .identity {
    display: flex;
    flex-direction: column;
  }

  .identity strong {
    font-size: clamp(24px, 3vw, 42px);
    letter-spacing: -0.05em;
  }

  .reason {
    font-size: clamp(16px, 1.7vw, 23px);
    line-height: 1.35;
  }

  .arrow {
    color: #f4ff3f;
    font-size: 28px;
  }

  .after {
    display: grid;
    gap: 50px;
    grid-template-columns: 1fr 0.65fr;
    padding: 100px clamp(18px, 5vw, 80px);
  }

  .after h2 {
    font-size: clamp(45px, 7vw, 100px);
    letter-spacing: -0.07em;
    line-height: 0.9;
    margin: 22px 0 0;
  }

  .after > div:last-child {
    align-self: end;
    display: flex;
    flex-direction: column;
    font-size: 18px;
    gap: 18px;
  }

  @media (max-width: 740px) {
    .mast {
      align-items: flex-start;
    }

    .mast nav {
      align-items: flex-end;
      flex-direction: column;
      gap: 8px;
    }

    .hero,
    .notice,
    .after {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
    }

    .number {
      font-size: 150px;
      writing-mode: initial;
    }

    .board a {
      align-items: start;
      grid-template-columns: 48px 1fr 26px;
    }

    .reason {
      grid-column: 2 / -1;
    }
  }
</style>
