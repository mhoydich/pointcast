---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { POINTCAST_25 } from '../../lib/pointcast-25';
import {
  POINTCAST_25_DISSENTS,
  POINTCAST_25_REFERENCE,
} from '../../lib/pointcast-25-audience';

const description =
  'Five 2026 college-football teams PointCast ranks higher than ESPN FPI, with the reason, strongest doubt, and next proof for every disagreement.';
const pageUrl = 'https://pointcast.xyz/25/disagreements';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#list`,
      name: 'The PointCast 2026 preseason disagreement index',
      description,
      url: pageUrl,
      datePublished: POINTCAST_25.publishedAt,
      numberOfItems: POINTCAST_25_DISSENTS.length,
      itemListElement: POINTCAST_25_DISSENTS.map((team, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://pointcast.xyz/25/teams/${team.slug}`,
        name: `${team.school}: PointCast No. ${team.rank}, ${POINTCAST_25_REFERENCE.shortName} ${team.referenceRank ? `No. ${team.referenceRank}` : 'unranked'}`,
        description: team.dissent,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'PointCast', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: '25 FOR REASONS', item: 'https://pointcast.xyz/25' },
        { '@type': 'ListItem', position: 3, name: 'Disagreements', item: pageUrl },
      ],
    },
  ],
};
---

<BlockLayout
  title="2026 College Football Disagreement Index"
  description={description}
  image="/images/pointcast-25/disagreement-000.png"
  themeColor="#f4ff3f"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    {
      type: 'application/json',
      href: '/25/disagreements.json',
      title: 'PointCast 25 Disagreement Index JSON',
    },
  ]}
>
  <main class="dissent-page">
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <nav aria-label="PointCast 25 disagreement navigation">
        <a href="/25">Current 25</a>
        <a href="/25/boards/000">Board 000</a>
        <a href="/25/receipts">Receipts</a>
        <a href="/25/disagreements.json">JSON</a>
      </nav>
    </header>

    <section class="hero">
      <p class="kicker">POINTCAST 25 · BOARD {POINTCAST_25.board} · PRESEASON</p>
      <h1>THE<br /><em>DISAGREEMENT</em><br />INDEX</h1>
      <div class="hero__bottom">
        <p>
          Five teams we believe in more than one prominent national model.
          The reference is useful. The distance is the story.
        </p>
        <button type="button" data-copy-page>Copy this desk ↗</button>
      </div>
    </section>

    <section class="method" aria-labelledby="method-title">
      <p class="label">WHAT THIS IS</p>
      <div>
        <h2 id="method-title">Not anti-model.<br />Pro-disagreement.</h2>
        <p>
          {POINTCAST_25_REFERENCE.shortName} asks a predictive question.
          PointCast asks who we would trust next Saturday. This desk shows the
          five largest positive PointCast convictions that produce a useful argument.
        </p>
      </div>
    </section>

    <ol class="dissents">
      {POINTCAST_25_DISSENTS.map((team, index) => (
        <li style={`--team:${team.accent}`}>
          <article>
            <div class="dissent__number">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <small>DISAGREEMENT</small>
            </div>
            <div class="dissent__copy">
              <p>{team.conference} · PointCast #{team.rank}</p>
              <h2><a href={`/25/teams/${team.slug}`}>{team.school}</a></h2>
              <div class="rank-line">
                <span>POINTCAST <strong>#{team.rank}</strong></span>
                <span>{POINTCAST_25_REFERENCE.shortName} <strong>{team.referenceRank ? `#${team.referenceRank}` : 'NR'}</strong></span>
              </div>
              <p class="stance">{team.dissent}</p>
              <dl>
                <div>
                  <dt>WHY</dt>
                  <dd>{team.reason}</dd>
                </div>
                <div>
                  <dt>DOUBT</dt>
                  <dd>{team.doubt}</dd>
                </div>
                <div>
                  <dt>NEXT PROOF</dt>
                  <dd>{team.proof}</dd>
                </div>
              </dl>
              <div class="actions">
                <a href={`/25/teams/${team.slug}`}>Open {team.school}’s complete case →</a>
                <button
                  type="button"
                  data-copy-team
                  data-team={team.school}
                  data-url={`https://pointcast.xyz/25/teams/${team.slug}`}
                  data-copy={`${team.school}: PointCast #${team.rank}; ${POINTCAST_25_REFERENCE.shortName} ${team.referenceRank ? `#${team.referenceRank}` : 'unranked'}. ${team.dissent}`}
                >
                  Copy disagreement
                </button>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>

    <section class="reference" aria-labelledby="reference-title">
      <div>
        <p class="label">REFERENCE RECEIPT</p>
        <h2 id="reference-title">{POINTCAST_25_REFERENCE.name}</h2>
      </div>
      <div>
        <p>{POINTCAST_25_REFERENCE.note}</p>
        <p>
          Published {POINTCAST_25_REFERENCE.publishedAt}; checked by PointCast
          {POINTCAST_25_REFERENCE.checkedAt}.
        </p>
        <a href={POINTCAST_25_REFERENCE.url} target="_blank" rel="noopener">
          Read the source board ↗
        </a>
      </div>
    </section>

    <footer>
      <div>
        <strong>THE ARGUMENT CONTINUES</strong>
        <span>New PointCast board Tuesday · 08:08 PT</span>
      </div>
      <nav aria-label="PointCast 25 disagreement footer">
        <a href="/25">Read all 25</a>
        <a href="/25/receipts">Grade the claims</a>
        <a href="/c/spinning.rss">Follow by RSS</a>
      </nav>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const setCopyState = (button, label) => {
        const original = button.textContent;
        button.textContent = label;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1800);
      };

      const copy = async (button, value) => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(value);
          setCopyState(button, 'Copied ✓');
        } catch {
          const fallback = document.createElement('textarea');
          fallback.value = value;
          fallback.setAttribute('readonly', '');
          fallback.style.position = 'fixed';
          fallback.style.opacity = '0';
          document.body.appendChild(fallback);
          fallback.select();
          const copied = document.execCommand('copy');
          fallback.remove();
          setCopyState(button, copied ? 'Copied ✓' : 'Copy unavailable');
        }
      };

      document.querySelector('[data-copy-page]')?.addEventListener('click', (event) => {
        const button = event.currentTarget;
        if (button instanceof HTMLButtonElement) {
          copy(button, 'The PointCast 2026 college-football Disagreement Index: five teams ranked higher than ESPN FPI, with receipts. https://pointcast.xyz/25/disagreements');
        }
      });

      document.querySelectorAll('[data-copy-team]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          copy(button, `${button.dataset.copy} ${button.dataset.url}`);
        });
      });
    })();
  </script>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #10100f;
    color: #f7f5ee;
    font-family: var(--pc-font-sans);
  }

  .dissent-page {
    margin: 0 auto;
    max-width: 1500px;
    overflow: hidden;
  }

  .mast,
  .mast nav,
  footer,
  footer nav,
  .actions {
    align-items: center;
    display: flex;
  }

  .mast {
    border-bottom: 1px solid #44433f;
    justify-content: space-between;
    padding: 20px clamp(18px, 4vw, 64px);
  }

  .brand {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .mast nav,
  footer nav,
  .actions {
    gap: clamp(12px, 2vw, 28px);
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .mast a,
  .kicker,
  .label,
  .dissent__number,
  .dissent__copy > p:first-child,
  .rank-line,
  dt,
  button,
  footer {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    min-height: 82vh;
    padding: 60px clamp(18px, 5vw, 80px) 48px;
  }

  .hero h1 {
    font-size: clamp(70px, 13vw, 190px);
    letter-spacing: -0.09em;
    line-height: 0.74;
    margin: 60px 0;
  }

  .hero em {
    color: #f4ff3f;
    font-style: normal;
  }

  .hero__bottom {
    align-items: end;
    display: flex;
    gap: 40px;
    justify-content: space-between;
    margin-left: auto;
    max-width: 900px;
  }

  .hero__bottom p {
    font-size: clamp(22px, 3vw, 38px);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }

  button {
    background: #f4ff3f;
    border: 0;
    border-radius: 999px;
    color: #10100f;
    cursor: pointer;
    flex: 0 0 auto;
    font-weight: 800;
    padding: 14px 18px;
  }

  button:focus-visible,
  a:focus-visible {
    outline: 3px solid #f4ff3f;
    outline-offset: 4px;
  }

  .method,
  .reference {
    border-top: 1px solid #44433f;
    display: grid;
    gap: 50px;
    grid-template-columns: 0.3fr 1fr;
    padding: 80px clamp(18px, 5vw, 80px);
  }

  .method h2,
  .reference h2 {
    font-size: clamp(40px, 6vw, 86px);
    letter-spacing: -0.07em;
    line-height: 0.95;
    margin: 0;
  }

  .method div > p,
  .reference div > p {
    font-size: clamp(19px, 2vw, 28px);
    line-height: 1.5;
    max-width: 850px;
  }

  .dissents {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dissents > li {
    border-top: 1px solid #44433f;
    padding: 65px clamp(18px, 5vw, 80px);
  }

  .dissents article {
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(150px, 0.28fr) 1fr;
  }

  .dissent__number {
    color: var(--team);
    display: flex;
    flex-direction: column;
  }

  .dissent__number span {
    font-family: var(--pc-font-sans);
    font-size: clamp(100px, 14vw, 190px);
    font-weight: 900;
    letter-spacing: -0.11em;
    line-height: 0.8;
  }

  .dissent__copy h2 {
    font-size: clamp(60px, 10vw, 145px);
    letter-spacing: -0.09em;
    line-height: 0.8;
    margin: 26px 0;
  }

  .dissent__copy h2 a {
    text-decoration: none;
  }

  .rank-line {
    border-bottom: 1px solid #575650;
    border-top: 1px solid #575650;
    display: flex;
    gap: 30px;
    padding: 16px 0;
  }

  .rank-line strong {
    color: #f4ff3f;
    font-size: 20px;
  }

  .stance {
    color: #f4ff3f;
    font-size: clamp(24px, 3vw, 42px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 42px 0;
  }

  dl {
    margin: 0;
  }

  dl div {
    border-top: 1px solid #44433f;
    display: grid;
    gap: 22px;
    grid-template-columns: 100px 1fr;
    padding: 20px 0;
  }

  dt {
    color: #aaa8a1;
  }

  dd {
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.45;
    margin: 0;
  }

  .actions {
    justify-content: space-between;
    margin-top: 28px;
  }

  .actions > a {
    font-weight: 800;
  }

  .actions button {
    background: transparent;
    border: 1px solid #77756d;
    color: #f7f5ee;
  }

  .reference {
    background: #f4ff3f;
    color: #10100f;
  }

  .reference a {
    font-weight: 800;
  }

  footer {
    justify-content: space-between;
    padding: 40px clamp(18px, 5vw, 80px);
  }

  footer div {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 760px) {
    .mast {
      align-items: flex-start;
    }

    .mast nav {
      align-items: flex-end;
      flex-direction: column;
      gap: 8px;
    }

    .hero {
      min-height: 0;
    }

    .hero h1 {
      font-size: clamp(42px, 13vw, 56px);
      line-height: 0.8;
    }

    .hero__bottom,
    footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .method,
    .reference,
    .dissents article {
      grid-template-columns: 1fr;
    }

    .dissent__number {
      align-items: baseline;
      flex-direction: row;
      gap: 14px;
    }

    dl div {
      grid-template-columns: 74px 1fr;
    }

    .actions {
      align-items: flex-start;
      flex-direction: column;
    }

    footer nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      scroll-behavior: auto !important;
    }
  }
</style>
