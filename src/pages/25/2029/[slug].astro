---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import PointCast2029Mark from '../../../components/PointCast2029Mark.astro';
import {
  POINTCAST_2029,
  POINTCAST_2029_IDENTITIES,
  type PointCast2029Identity,
} from '../../../lib/pointcast-2029';

export function getStaticPaths() {
  return POINTCAST_2029_IDENTITIES.map((identity) => ({
    params: { slug: identity.slug },
    props: { identity },
  }));
}

interface Props {
  identity: PointCast2029Identity;
}

const { identity } = Astro.props;
const description = `${identity.school}, reimagined for 2029 by PointCast: the ${identity.markName} abstract mark, a future stadium, campus intervention, and student gear system.`;
const previous = POINTCAST_2029_IDENTITIES[(identity.rank - 2 + POINTCAST_2029_IDENTITIES.length) % POINTCAST_2029_IDENTITIES.length];
const next = POINTCAST_2029_IDENTITIES[identity.rank % POINTCAST_2029_IDENTITIES.length];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${identity.school} / ${identity.markName} — PointCast 25 / 2029`,
  description,
  url: identity.canonical,
  datePublished: POINTCAST_2029.publishedAt,
  creator: { '@type': 'Organization', name: 'PointCast' },
  isPartOf: { '@type': 'CreativeWork', name: POINTCAST_2029.title, url: POINTCAST_2029.canonical },
};
---

<BlockLayout
  title={`${identity.school} / ${identity.markName} — PointCast 25 / 2029`}
  description={description}
  image={identity.houseArt}
  themeColor={identity.primary}
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: `/25/2029/${identity.slug}.json`, title: `${identity.school} 2029 identity JSON` },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main
    class="system"
    style={`--primary:${identity.primary};--secondary:${identity.secondary};--paper:${identity.paper}`}
  >
    <header class="mast">
      <a href="/25/2029">← SATURDAY, REBRANDED</a>
      <span>#{String(identity.rank).padStart(2, '0')} / 25 · HOUSE {identity.house}</span>
      <a href={`/25/2029/${identity.slug}.json`}>JSON ↗</a>
    </header>

    <section class="hero">
      <div class="hero__mark">
        <p>UNOFFICIAL 2029 IDENTITY SYSTEM</p>
        <PointCast2029Mark
          paths={identity.markPaths}
          label={`${identity.markName}, PointCast's unofficial 2029 abstract mark proposal for ${identity.school}`}
        />
      </div>
      <div class="hero__copy">
        <p>{identity.conference} · {identity.city}, {identity.state}</p>
        <h1>{identity.school}</h1>
        <h2>{identity.markName}</h2>
        <p class="hero__thesis">{identity.thesis}</p>
        <div class="colors" aria-label="Proposed color system">
          <span style={`--color:${identity.primary}`}><b></b>{identity.primary}</span>
          <span style={`--color:${identity.secondary}`}><b></b>{identity.secondary}</span>
          <span style={`--color:${identity.paper}`}><b></b>{identity.paper}</span>
        </div>
      </div>
    </section>

    <section class="source">
      <span>PLACE INPUT</span>
      <strong>{identity.localResource}</strong>
      <p>
        The local input comes from PointCast’s sourced mascot field card. The design
        direction is PointCast interpretation, not an institutional claim.
      </p>
      <a href={identity.sourceUrl} target="_blank" rel="noopener">{identity.sourceLabel} source ↗</a>
    </section>

    <section class="directions">
      <article>
        <span>01 / STADIUM</span>
        <h3>A field that gives something back.</h3>
        <p>{identity.stadium}</p>
      </article>
      <article>
        <span>02 / CAMPUS</span>
        <h3>The signal leaves the merch table.</h3>
        <p>{identity.campus}</p>
      </article>
      <article>
        <span>03 / STUDENT GEAR</span>
        <h3>Repair is part of the identity.</h3>
        <p>{identity.gear}</p>
      </article>
    </section>

    <section class="house">
      <div>
        <p>MARK HOUSE {String(identity.house).padStart(2, '0')}</p>
        <h2>One system among five unrelated signals.</h2>
        <p>
          The shared house is a presentation device, not a template. Every mark
          should remain recognizable in one color, in motion, at sixteen pixels,
          in embroidery, and at stadium scale.
        </p>
      </div>
      <figure>
        <img
          src={identity.houseArt}
          alt={`Mark House ${identity.house}, an original abstract identity specimen plate containing the ${identity.markName} system`}
          width="1024"
          height="1536"
        />
      </figure>
    </section>

    <aside class="boundary">
      <strong>UNOFFICIAL / SPECULATIVE / NOT FOR SALE</strong>
      <p>{POINTCAST_2029.boundary}</p>
    </aside>

    <nav class="pager" aria-label="Browse the 25 identity systems">
      <a href={`/25/2029/${previous.slug}`}>
        <small>← #{String(previous.rank).padStart(2, '0')}</small>
        <strong>{previous.school}</strong>
        <span>{previous.markName}</span>
      </a>
      <a href="/25/2029">
        <small>ALL</small>
        <strong>Signal wall</strong>
        <span>25 systems</span>
      </a>
      <a href={`/25/2029/${next.slug}`}>
        <small>#{String(next.rank).padStart(2, '0')} →</small>
        <strong>{next.school}</strong>
        <span>{next.markName}</span>
      </a>
    </nav>
  </main>
</BlockLayout>

<style>
  :global(body) { background: #191917; }
  :global(.block-layout__main) { padding: 0 !important; max-width: none !important; }
  :global(.site-header), :global(.network-strip) { display: none !important; }
  .system {
    min-height: 100vh;
    color: #181815;
    background:
      linear-gradient(rgba(0,0,0,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,.035) 1px, transparent 1px),
      var(--paper);
    background-size: 24px 24px;
    font-family: "Helvetica Neue", Arial, sans-serif;
  }
  .mast {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .85rem 2vw;
    border-bottom: 2px solid #181815;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .mast a { color: inherit; }
  .hero { min-height: 660px; display: grid; grid-template-columns: 1fr 1fr; border-bottom: 2px solid #181815; }
  .hero__mark {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    color: var(--primary);
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--secondary) 18%, transparent) 0 2px, transparent 3px) 0 0/20px 20px,
      var(--paper);
    border-right: 2px solid #181815;
  }
  .hero__mark p { margin: 0; color: #181815; font-size: .65rem; font-weight: 900; letter-spacing: .1em; }
  .hero__mark svg { width: min(80%, 490px); margin: auto; filter: drop-shadow(16px 16px 0 color-mix(in srgb, var(--secondary) 24%, transparent)); }
  .hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(3rem, 7vw, 8rem); background: var(--primary); }
  .hero__copy > p:first-child { margin: 0 0 1rem; font-size: .7rem; font-weight: 900; text-transform: uppercase; letter-spacing: .1em; }
  .hero h1 { margin: 0; font: clamp(4rem, 8vw, 9rem)/.82 Impact, "Arial Black", sans-serif; letter-spacing: -.05em; text-transform: uppercase; }
  .hero h2 { margin: .5rem 0 0; color: var(--paper); font: clamp(1.7rem, 3vw, 3.4rem)/1 Impact, sans-serif; text-transform: uppercase; }
  .hero__thesis { max-width: 38rem; font-size: 1.2rem; line-height: 1.3; font-weight: 700; }
  .colors { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1rem; }
  .colors span { display: flex; align-items: center; gap: .35rem; font: 800 .62rem/1 monospace; }
  .colors b { width: 20px; height: 20px; display: block; background: var(--color); border: 1px solid #181815; }
  .source { display: grid; grid-template-columns: .5fr 1.4fr 1.2fr auto; gap: 1.5rem; align-items: start; padding: 2rem 3vw; border-bottom: 2px solid #181815; }
  .source span { color: var(--primary); font-size: .65rem; font-weight: 900; }
  .source strong { font-size: 1.25rem; }
  .source p { margin: 0; font-size: .82rem; line-height: 1.45; }
  .source a { color: inherit; font-size: .65rem; font-weight: 900; text-transform: uppercase; }
  .directions { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 2px solid #181815; }
  .directions article { min-height: 350px; padding: 3rem 2.5vw; border-right: 2px solid #181815; }
  .directions article:last-child { border-right: 0; }
  .directions span { color: var(--primary); font-size: .68rem; font-weight: 900; letter-spacing: .08em; }
  .directions h3 { margin: 3rem 0 1rem; font: clamp(2rem, 3.5vw, 4rem)/.9 Impact, sans-serif; text-transform: uppercase; }
  .directions p { max-width: 32rem; font-size: 1rem; line-height: 1.45; font-weight: 650; }
  .house { display: grid; grid-template-columns: .8fr 1.2fr; min-height: 800px; color: var(--paper); background: var(--secondary); border-bottom: 2px solid #181815; }
  .house > div { align-self: center; padding: 5vw; }
  .house > div > p:first-child { font-size: .68rem; font-weight: 900; letter-spacing: .1em; }
  .house h2 { margin: 1rem 0; font: clamp(3rem, 6vw, 7rem)/.85 Impact, sans-serif; text-transform: uppercase; }
  .house > div > p:last-child { max-width: 38rem; font-size: 1rem; line-height: 1.5; }
  .house figure { margin: 0; border-left: 2px solid #181815; }
  .house img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .boundary { display: grid; grid-template-columns: .7fr 1.3fr; gap: 2rem; padding: 2rem 3vw; color: #181815; background: #e0ac27; border-bottom: 2px solid #181815; }
  .boundary strong { font: 1.6rem/.9 Impact, sans-serif; }
  .boundary p { margin: 0; font-size: .8rem; line-height: 1.45; }
  .pager { display: grid; grid-template-columns: repeat(3, 1fr); }
  .pager a { min-height: 150px; display: flex; flex-direction: column; justify-content: center; padding: 1.5rem 3vw; color: inherit; text-decoration: none; border-right: 2px solid #181815; }
  .pager a:nth-child(2) { align-items: center; text-align: center; }
  .pager a:nth-child(3) { align-items: flex-end; text-align: right; border-right: 0; }
  .pager small { color: var(--primary); font-size: .65rem; font-weight: 900; }
  .pager strong { font: 1.8rem/1 Impact, sans-serif; text-transform: uppercase; }
  .pager span { font-size: .7rem; text-transform: uppercase; }
  @media (max-width: 760px) {
    .hero, .source, .house, .boundary { grid-template-columns: 1fr; }
    .hero__mark { min-height: 460px; border-right: 0; border-bottom: 2px solid #181815; }
    .hero__copy { min-height: 520px; padding: 4rem 1rem; }
    .source { gap: .7rem; padding: 2rem 1rem; }
    .directions { grid-template-columns: 1fr; }
    .directions article { min-height: 0; border-right: 0; border-bottom: 2px solid #181815; padding: 3rem 1rem; }
    .directions article:last-child { border-bottom: 0; }
    .directions h3 { margin-top: 1.5rem; }
    .house > div { padding: 5rem 1rem; }
    .house figure { min-height: 630px; border-left: 0; border-top: 2px solid #181815; }
    .boundary { padding: 2rem 1rem; }
    .pager strong { font-size: 1.15rem; }
    .pager a { padding: 1rem; }
  }
</style>
