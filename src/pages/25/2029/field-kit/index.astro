---
import BlockLayout from '../../../../layouts/BlockLayout.astro';
import PointCast2029Mark from '../../../../components/PointCast2029Mark.astro';
import {
  FIELD_KIT_ACCESSORIES,
  FIELD_KIT_PATTERN_RECIPES,
  FIELD_KIT_PLATES,
  FIELD_KIT_TEXT_PARTS,
  POINTCAST_2029_FIELD_KIT,
} from '../../../../lib/pointcast-2029-field-kit';
import { POINTCAST_2029_IDENTITIES } from '../../../../lib/pointcast-2029';

const stadiums = FIELD_KIT_PLATES.filter((plate) => plate.kind === 'stadium');
const fanRituals = FIELD_KIT_PLATES.filter((plate) => plate.kind === 'fan');
const thirdSpaces = FIELD_KIT_PLATES.filter((plate) => plate.kind === 'third-space');
const accessories = FIELD_KIT_PLATES.filter((plate) => plate.kind === 'accessory');

const description =
  'A playable 2029 college-football field kit: twelve original stadium, fan, third-space, and lo-fi accessory plates plus 25 stamps, eight procedural backgrounds, and a local text generator.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: `${POINTCAST_2029_FIELD_KIT.title} — PointCast 25 / 2029 Field Kit`,
      description,
      url: POINTCAST_2029_FIELD_KIT.canonical,
      datePublished: POINTCAST_2029_FIELD_KIT.publishedAt,
      creator: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'CreativeWork',
        name: 'Saturday, Rebranded — PointCast 25 / 2029',
        url: POINTCAST_2029_FIELD_KIT.parent,
      },
      about: [
        'college football',
        'stadium design',
        'fan experience',
        'third places',
        'student-made accessories',
        'procedural graphic design',
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Saturday Commons 2029 visual plates',
      numberOfItems: FIELD_KIT_PLATES.length,
      itemListElement: FIELD_KIT_PLATES.map((plate, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: plate.title,
        description: plate.thesis,
      })),
    },
  ],
};
---

<BlockLayout
  title="Saturday Commons — PointCast 25 / 2029 Field Kit"
  description={description}
  image="/images/pointcast-2029-field-kit/social-card.png"
  themeColor="#c94a31"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/2029/field-kit.json',
      title: 'Saturday Commons 2029 Field Kit JSON',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <div class="field-kit">
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="Saturday Commons navigation">
        <a href="/25/2029">2029</a>
        <a href="#views">Views</a>
        <a href="/25/2029/song-yard">Song Yard</a>
        <a href="#loom">Pattern loom</a>
        <a href="#stamps">Stamps</a>
        <a href="#language">Text</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="field-kit-title">
        <div class="hero__copy">
          <p class="eyebrow">POINTCAST 25 · FIELD KIT · YEAR 2029</p>
          <h1 id="field-kit-title">
            <span>SATURDAY</span>
            COMMONS.
          </h1>
          <p class="hero__dek">
            The logos are only the first inch. Now build the places, rituals,
            pockets, stamps, and strange little sentences that make a Saturday
            belong to people.
          </p>
          <div class="hero__actions">
            <a href="#loom">Open the pattern loom ↓</a>
            <a href="/25/2029/song-yard">Practice a stadium song ↗</a>
            <button type="button" data-share-edition>Copy this field kit</button>
          </div>
          <dl class="hero__facts">
            <div><dt>12</dt><dd>new visual plates</dd></div>
            <div><dt>25</dt><dd>identity stamps</dd></div>
            <div><dt>08</dt><dd>background recipes</dd></div>
          </dl>
        </div>

        <div class="hero__world" aria-label="Saturday Commons visual studies">
          <figure class="hero__plate hero__plate--main">
            <img
              src={stadiums[0].image}
              alt={stadiums[0].alt}
              width="1024"
              height="1536"
            />
          </figure>
          <figure class="hero__plate hero__plate--second">
            <img
              src={fanRituals[1].image}
              alt={fanRituals[1].alt}
              width="1024"
              height="1536"
            />
          </figure>
          <div class="hero__ticket">
            <span>PC25 / 2029</span>
            <strong>FIELD<br />KIT</strong>
            <small>print · carry · gather</small>
          </div>
        </div>
      </section>

      <div class="marquee" aria-label="Field kit principles">
        <span>THE STADIUM WORKS ON MONDAY</span>
        <span>THE FAN IS A PARTICIPANT</span>
        <span>THE THIRD SPACE IS THE PRODUCT</span>
        <span>PAPER SURVIVES THE APP</span>
      </div>

      <section class="opening-note" aria-labelledby="opening-note-title">
        <p class="section-tag">THE SECOND PRESENTATION</p>
        <div>
          <h2 id="opening-note-title">A brand is what people<br />can do together.</h2>
          <div class="opening-note__columns">
            <p>
              The first 2029 draft made twenty-five visual systems. This field
              kit asks the more interesting question: what happens after the
              mark leaves the screen?
            </p>
            <p>
              It becomes a transit porch, rain gutter, stamp drawer, radio
              ritual, repair patch, quiet room, postgame table, and a sentence
              somebody wants to carry home.
            </p>
          </div>
        </div>
      </section>

      <section class="plate-section plate-section--stadiums" id="views" aria-labelledby="views-title">
        <header class="section-head">
          <div>
            <p class="section-tag">FOUR STADIUM VIEWS</p>
            <h2 id="views-title">Look away from<br />the fifty-yard line.</h2>
          </div>
          <p>
            The useful future appears at the edge: arriving, sitting, repairing,
            broadcasting, sheltering, and opening the doors again on Monday.
          </p>
        </header>

        <div class="stadium-grid">
          {stadiums.map((plate, index) => (
            <figure class:list={['plate-card', index === 0 && 'plate-card--wide']}>
              <img
                src={plate.image}
                alt={plate.alt}
                width="1024"
                height="1536"
                loading={index > 1 ? 'lazy' : 'eager'}
              />
              <figcaption>
                <span>{plate.kicker}</span>
                <h3>{plate.title}</h3>
                <p>{plate.thesis}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="plate-section plate-section--fans" aria-labelledby="fans-title">
        <header class="section-head section-head--light">
          <div>
            <p class="section-tag">THREE FAN RITUALS</p>
            <h2 id="fans-title">Arrival. Radio.<br />Afterglow.</h2>
          </div>
          <p>
            No loyalty points. No attention trap. Three small rituals create
            memory through movement, listening, trade, food, and a shared table.
          </p>
        </header>

        <div class="portrait-grid">
          {fanRituals.map((plate) => (
            <figure class="portrait-card">
              <img src={plate.image} alt={plate.alt} width="1024" height="1536" loading="lazy" />
              <figcaption>
                <span>{plate.kicker}</span>
                <h3>{plate.title}</h3>
                <p>{plate.thesis}</p>
              </figcaption>
            </figure>
          ))}
        </div>

        <a class="song-yard-door" href="/25/2029/song-yard">
          <span class="song-yard-door__index">FIELD KIT ROOM 02 / AUDIO PRACTICE</span>
          <strong>THE SONG<br />YARD.</strong>
          <p>
            Six original song seeds. Four rehearsal parts. One spatial bowl.
            Optional local-only pitch listening. No recordings, uploads,
            official fight songs, or autoplay.
          </p>
          <span class="song-yard-door__action">Learn one part, then open the bowl ↗</span>
        </a>
      </section>

      <section class="plate-section plate-section--third" aria-labelledby="third-title">
        <header class="section-head">
          <div>
            <p class="section-tag">THREE THIRD SPACES</p>
            <h2 id="third-title">Print. Quiet.<br />Weather.</h2>
          </div>
          <p>
            A stadium becomes culturally interesting when it gives students a
            reason to enter without buying a ticket.
          </p>
        </header>

        <div class="portrait-grid portrait-grid--offset">
          {thirdSpaces.map((plate, index) => (
            <figure class:list={['portrait-card', index === 1 && 'portrait-card--drop']}>
              <img src={plate.image} alt={plate.alt} width="1024" height="1536" loading="lazy" />
              <figcaption>
                <span>{plate.kicker}</span>
                <h3>{plate.title}</h3>
                <p>{plate.thesis}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="loom" id="loom" aria-labelledby="loom-title">
        <header class="section-head section-head--loom">
          <div>
            <p class="section-tag">THE PATTERN LOOM</p>
            <h2 id="loom-title">Twenty-five signals.<br />Eight fields.</h2>
          </div>
          <p>
            Select a 2029 identity, choose a recipe, and weave a downloadable
            background locally in your browser. No upload, account, or telemetry.
          </p>
        </header>

        <div class="loom__workspace">
          <form class="loom__controls" data-loom-form>
            <label>
              <span>Identity stamp</span>
              <select data-identity-select>
                {POINTCAST_2029_IDENTITIES.map((identity, index) => (
                  <option value={index}>{String(identity.rank).padStart(2, '0')} · {identity.school} · {identity.markName}</option>
                ))}
              </select>
            </label>

            <label>
              <span>Background recipe</span>
              <select data-recipe-select>
                {FIELD_KIT_PATTERN_RECIPES.map((recipe) => (
                  <option value={recipe.id}>{recipe.name}</option>
                ))}
              </select>
            </label>

            <label>
              <span>Signal density <output data-density-output>4</output></span>
              <input data-density type="range" min="2" max="8" step="1" value="4" />
            </label>

            <label class="check">
              <input data-invert type="checkbox" />
              <span>Night field</span>
            </label>

            <div class="loom__buttons">
              <button type="button" data-spin>Spin the field</button>
              <button type="button" data-download-background>Download PNG</button>
            </div>

            <p class="local-note">
              Generated here. Saved only when you ask. The selected identity is
              PointCast’s unofficial 2029 concept, not a school mark.
            </p>
          </form>

          <div class="loom__canvas-wrap">
            <canvas
              data-pattern-canvas
              width="1200"
              height="1500"
              role="img"
              aria-label="Generated 2029 identity background using the Night Seed stamp and Procession pattern"
            ></canvas>
            <div class="loom__caption" aria-live="polite">
              <span data-canvas-rank>#01</span>
              <div>
                <strong data-canvas-title>Night Seed / Procession</strong>
                <small data-canvas-note>Even ranks march; odd ranks answer.</small>
              </div>
            </div>
          </div>
        </div>

        <div class="recipe-grid" aria-label="Eight background recipes">
          {FIELD_KIT_PATTERN_RECIPES.map((recipe, index) => (
            <button type="button" data-recipe-card={recipe.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{recipe.name}</strong>
              <small>{recipe.note}</small>
            </button>
          ))}
        </div>
      </section>

      <section class="stamp-lab" id="stamps" aria-labelledby="stamps-title">
        <header class="section-head section-head--light">
          <div>
            <p class="section-tag">THE STAMP CABINET</p>
            <h2 id="stamps-title">Pick one.<br />Make a trail.</h2>
          </div>
          <p>
            Every 2029 system becomes a rubber-stamp-scale object. Keep a local
            set, export a clean PNG, or push the stamp into the pattern loom.
          </p>
        </header>

        <div class="stamp-lab__grid">
          <div class="stamp-cabinet" role="group" aria-label="Choose one of 25 identity stamps">
            {POINTCAST_2029_IDENTITIES.map((identity, index) => (
              <button
                type="button"
                data-stamp-index={index}
                aria-label={`Select ${identity.markName}, the unofficial 2029 ${identity.school} stamp`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                style={`--ink:${identity.primary};--paper:${identity.paper}`}
              >
                <PointCast2029Mark paths={identity.markPaths} label="" decorative />
                <span>{String(identity.rank).padStart(2, '0')}</span>
              </button>
            ))}
          </div>

          <article class="stamp-proof">
            <div class="stamp-proof__paper" data-stamp-proof style={`--ink:${POINTCAST_2029_IDENTITIES[0].primary};--paper:${POINTCAST_2029_IDENTITIES[0].paper}`}>
              <PointCast2029Mark
                paths={POINTCAST_2029_IDENTITIES[0].markPaths}
                label={`${POINTCAST_2029_IDENTITIES[0].markName} stamp proof`}
                class="stamp-proof__mark"
              />
              <span data-proof-rank>01 / 25</span>
            </div>
            <p>STAMP PROOF / YEAR 2029</p>
            <h3 data-proof-title>Night Seed</h3>
            <small data-proof-school>Ohio State · Columbus, Ohio</small>
            <div class="stamp-proof__actions">
              <button type="button" data-collect-stamp>Keep this stamp</button>
              <button type="button" data-download-stamp>Download stamp</button>
            </div>
          </article>
        </div>

        <aside class="stamp-book" aria-labelledby="stamp-book-title">
          <div>
            <p class="section-tag">BROWSER-LOCAL STAMP BOOK</p>
            <h3 id="stamp-book-title">Your Saturday trail</h3>
          </div>
          <div class="stamp-book__kept" data-kept-stamps>
            <p>Keep up to eight stamps. Nothing leaves this browser.</p>
          </div>
          <div class="stamp-book__actions">
            <button type="button" data-copy-stamp-book>Copy receipt</button>
            <button type="button" data-clear-stamp-book>Clear</button>
          </div>
          <p class="stamp-book__status" data-stamp-status aria-live="polite">No stamps kept yet.</p>
        </aside>
      </section>

      <section class="language-machine" id="language" aria-labelledby="language-title">
        <div class="language-machine__intro">
          <p class="section-tag">THE SATURDAY LANGUAGE MACHINE</p>
          <h2 id="language-title">Three lines.<br />One small invitation.</h2>
          <p>
            Generate a line for the walk, the section, the print table, or the
            meal after. Put it on your current field and download the result.
          </p>
        </div>

        <div class="language-machine__desk">
          <div class="language-machine__output" aria-live="polite">
            <span>PC25 / PUBLIC LANGUAGE / 2029</span>
            <p data-language-output>
              MEET ME<br />
              UNDER THE RAIN ROOF<br />
              STAY FOR SOUP.
            </p>
            <small data-language-signature>— NIGHT SEED / PROCESSION</small>
          </div>
          <div class="language-machine__controls">
            <button type="button" data-generate-language>Another invitation</button>
            <button type="button" data-add-language>Add to background</button>
            <button type="button" data-copy-language>Copy text</button>
            <button type="button" data-clear-language>Remove from background</button>
          </div>
          <p class="language-machine__status" data-language-status aria-live="polite">
            Ready to make a field note.
          </p>
        </div>
      </section>

      <section class="accessories" aria-labelledby="accessories-title">
        <header class="section-head">
          <div>
            <p class="section-tag">LO-FI ACCESSORIES / 2029</p>
            <h2 id="accessories-title">Things worth<br />putting in a pocket.</h2>
          </div>
          <p>
            Useful, repairable, inexpensive, and slightly strange. None are
            licensed products or currently for sale.
          </p>
        </header>

        <div class="accessories__grid">
          {accessories.map((plate) => (
            <figure>
              <img src={plate.image} alt={plate.alt} width="1024" height="1536" loading="lazy" />
              <figcaption>
                <span>{plate.kicker}</span>
                <h3>{plate.title}</h3>
                <p>{plate.thesis}</p>
              </figcaption>
            </figure>
          ))}
          <ol>
            {FIELD_KIT_ACCESSORIES.map((item, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>
            ))}
          </ol>
        </div>
      </section>

      <aside class="boundary">
        <strong>UNOFFICIAL 2029 FIELD STUDY.</strong>
        <p>{POINTCAST_2029_FIELD_KIT.boundary}</p>
      </aside>

      <footer class="field-kit__footer">
        <p>POINTCAST 25 / SATURDAY COMMONS / FIELD KIT 01</p>
        <h2>The field is not the whole place.</h2>
        <nav aria-label="Field kit closing links">
          <a href="/25/2029">Return to Saturday, Rebranded</a>
          <a href="/25">Read the current PointCast 25</a>
          <a href="/25/2029/field-kit.json">Inspect the JSON</a>
          <a href="/b/0525">Block 0525</a>
        </nav>
      </footer>
    </main>
  </div>

  <script
    define:vars={{
      identities: POINTCAST_2029_IDENTITIES,
      recipes: FIELD_KIT_PATTERN_RECIPES,
      textParts: FIELD_KIT_TEXT_PARTS,
    }}
  >
    const root = document.querySelector('.field-kit');
    const canvas = root?.querySelector('[data-pattern-canvas]');
    const form = root?.querySelector('[data-loom-form]');
    const identitySelect = root?.querySelector('[data-identity-select]');
    const recipeSelect = root?.querySelector('[data-recipe-select]');
    const densityInput = root?.querySelector('[data-density]');
    const densityOutput = root?.querySelector('[data-density-output]');
    const invertInput = root?.querySelector('[data-invert]');
    const canvasRank = root?.querySelector('[data-canvas-rank]');
    const canvasTitle = root?.querySelector('[data-canvas-title]');
    const canvasNote = root?.querySelector('[data-canvas-note]');
    const proof = root?.querySelector('[data-stamp-proof]');
    const proofTitle = root?.querySelector('[data-proof-title]');
    const proofSchool = root?.querySelector('[data-proof-school]');
    const proofRank = root?.querySelector('[data-proof-rank]');
    const languageOutput = root?.querySelector('[data-language-output]');
    const languageSignature = root?.querySelector('[data-language-signature]');
    const languageStatus = root?.querySelector('[data-language-status]');
    const stampStatus = root?.querySelector('[data-stamp-status]');
    const keptStamps = root?.querySelector('[data-kept-stamps]');
    const storageKey = 'pointcast:25-2029:field-kit-stamps';
    const maxStamps = 8;

    let selectedIdentity = 0;
    let selectedRecipe = 'procession';
    let density = 4;
    let night = false;
    let languageLines = ['MEET ME', 'UNDER THE RAIN ROOF', 'STAY FOR SOUP.'];
    let showLanguage = false;
    let spin = 0;
    let kept = [];

    const currentIdentity = () => identities[selectedIdentity];
    const currentRecipe = () => recipes.find((recipe) => recipe.id === selectedRecipe) || recipes[0];

    function hexToRgb(hex) {
      const value = hex.replace('#', '');
      return {
        r: Number.parseInt(value.slice(0, 2), 16),
        g: Number.parseInt(value.slice(2, 4), 16),
        b: Number.parseInt(value.slice(4, 6), 16),
      };
    }

    function rgba(hex, alpha) {
      const { r, g, b } = hexToRgb(hex);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function drawMark(ctx, identity, x, y, size, color, rotation = 0, alpha = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.scale(size / 100, size / 100);
      ctx.translate(-50, -50);
      ctx.fillStyle = color;
      ctx.globalAlpha = alpha;
      for (const source of identity.markPaths) {
        ctx.fill(new Path2D(source), 'evenodd');
      }
      ctx.restore();
    }

    function drawRegistration(ctx, width, height, color) {
      ctx.save();
      ctx.globalAlpha = 0.16;
      ctx.fillStyle = color;
      for (let y = 18; y < height; y += 31) {
        for (let x = 15 + ((y / 31) % 2) * 8; x < width; x += 37) {
          if ((x * 13 + y * 7) % 11 < 2) ctx.fillRect(x, y, 2, 2);
        }
      }
      ctx.restore();
    }

    function renderPattern() {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const identity = currentIdentity();
      const recipe = currentRecipe();
      const width = canvas.width;
      const height = canvas.height;
      const paper = night ? identity.secondary : identity.paper;
      const ink = night ? identity.paper : identity.primary;
      const second = night ? identity.primary : identity.secondary;
      const d = density;

      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = paper;
      ctx.fillRect(0, 0, width, height);

      if (recipe.id === 'procession') {
        const columns = d + 2;
        const gap = width / columns;
        const markSize = Math.min(150, gap * 0.58);
        for (let row = -1; row < d * 2 + 2; row += 1) {
          for (let column = 0; column < columns; column += 1) {
            const x = gap * (column + 0.5) + (row % 2 ? gap * 0.5 : 0);
            const y = 90 + row * (height / (d * 2));
            drawMark(ctx, identity, x, y, markSize, (row + column) % 3 === 0 ? second : ink, 0, 0.9);
          }
        }
        ctx.fillStyle = rgba(second, 0.12);
        ctx.fillRect(0, height * 0.44, width, height * 0.12);
      } else if (recipe.id === 'terrace') {
        for (let row = 0; row < d + 3; row += 1) {
          const y = 80 + row * (height - 160) / (d + 2);
          const inset = (row % 4) * 65;
          ctx.fillStyle = row % 2 ? rgba(ink, 0.86) : rgba(second, 0.8);
          ctx.fillRect(inset, y, width - inset * 2, 24 + row * 4);
          drawMark(ctx, identity, width - 90 - inset, y + 18, 56 + row * 4, paper, 0, 0.9);
        }
      } else if (recipe.id === 'rain') {
        const columns = d * 5;
        for (let column = 0; column < columns; column += 1) {
          const x = (column + 0.5) * width / columns;
          const offset = ((column * 97 + spin * 43) % 190);
          ctx.strokeStyle = column % 3 === 0 ? ink : second;
          ctx.globalAlpha = 0.28 + (column % 4) * 0.12;
          ctx.lineWidth = 4 + (column % 3) * 3;
          ctx.beginPath();
          ctx.moveTo(x, -40 + offset);
          ctx.lineTo(x, height - 80 + offset);
          ctx.stroke();
          if (column % 4 === 0) drawMark(ctx, identity, x, 160 + ((column * 137) % 1100), 52, ink, 0, 0.8);
        }
        ctx.globalAlpha = 1;
      } else if (recipe.id === 'orbit') {
        const centerX = width / 2;
        const centerY = height / 2;
        for (let ring = 1; ring <= d; ring += 1) {
          const radius = ring * Math.min(width, height) / (d * 2 + 1);
          ctx.strokeStyle = ring % 2 ? rgba(ink, 0.64) : rgba(second, 0.5);
          ctx.lineWidth = 5;
          ctx.beginPath();
          ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
          ctx.stroke();
          const nodes = ring + 2;
          for (let node = 0; node < nodes; node += 1) {
            const angle = (node / nodes) * Math.PI * 2 + spin * 0.18 + ring * 0.2;
            drawMark(
              ctx,
              identity,
              centerX + Math.cos(angle) * radius,
              centerY + Math.sin(angle) * radius,
              Math.max(32, 100 - ring * 9),
              ring % 2 ? ink : second,
              angle,
              0.9,
            );
          }
        }
        drawMark(ctx, identity, centerX, centerY, 250, ink, spin * 0.05);
      } else if (recipe.id === 'ticker') {
        const rows = d + 3;
        for (let row = 0; row < rows; row += 1) {
          const y = row * height / rows;
          ctx.fillStyle = row % 3 === 0 ? ink : row % 3 === 1 ? paper : second;
          ctx.fillRect(0, y, width, height / rows + 2);
          for (let column = 0; column < d + 4; column += 1) {
            const x = (column + 0.5) * width / (d + 4);
            drawMark(ctx, identity, x, y + height / rows / 2, 54, row % 3 === 1 ? ink : paper, 0, 0.88);
          }
        }
      } else if (recipe.id === 'quilt') {
        const cells = d + 1;
        const cell = width / cells;
        for (let row = 0; row < Math.ceil(height / cell); row += 1) {
          for (let column = 0; column < cells; column += 1) {
            const color = (row + column) % 4 === 0 ? ink : (row + column) % 4 === 1 ? second : paper;
            ctx.fillStyle = color;
            ctx.fillRect(column * cell, row * cell, cell + 1, cell + 1);
            if ((row + column) % 2 === 0) {
              drawMark(ctx, identity, column * cell + cell / 2, row * cell + cell / 2, cell * 0.56, color === paper ? ink : paper);
            }
          }
        }
      } else if (recipe.id === 'broadcast') {
        const centerX = width * 0.48;
        const centerY = height * 0.47;
        const rays = d * 7;
        ctx.strokeStyle = rgba(second, 0.7);
        ctx.lineWidth = 6;
        for (let ray = 0; ray < rays; ray += 1) {
          const angle = ray / rays * Math.PI * 2 + spin * 0.08;
          ctx.beginPath();
          ctx.moveTo(centerX + Math.cos(angle) * 150, centerY + Math.sin(angle) * 150);
          ctx.lineTo(centerX + Math.cos(angle) * 900, centerY + Math.sin(angle) * 900);
          ctx.stroke();
        }
        ctx.fillStyle = paper;
        ctx.beginPath();
        ctx.arc(centerX, centerY, 230, 0, Math.PI * 2);
        ctx.fill();
        drawMark(ctx, identity, centerX, centerY, 360, ink, spin * 0.04);
      } else {
        ctx.fillStyle = ink;
        ctx.fillRect(0, 0, width, height * 0.62);
        ctx.fillStyle = second;
        ctx.beginPath();
        ctx.arc(width * 0.2, height * 0.18, width * 0.34, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = paper;
        ctx.fillRect(width * 0.1, height * 0.58, width * 0.8, 12);
        drawMark(ctx, identity, width * 0.78, height * 0.78, 230, second, spin * 0.08);
      }

      drawRegistration(ctx, width, height, second);

      if (showLanguage) {
        ctx.save();
        ctx.fillStyle = night ? identity.paper : '#f0e7d0';
        ctx.globalAlpha = 0.94;
        ctx.fillRect(70, height - 500, width - 140, 390);
        ctx.globalAlpha = 1;
        ctx.fillStyle = identity.secondary;
        ctx.font = '900 82px Arial Narrow, Impact, sans-serif';
        ctx.textBaseline = 'top';
        languageLines.forEach((line, index) => ctx.fillText(line, 110, height - 455 + index * 102, width - 220));
        ctx.font = '700 24px ui-monospace, monospace';
        ctx.fillText(`${identity.markName.toUpperCase()} / ${recipe.name.toUpperCase()} / 2029`, 112, height - 145);
        ctx.restore();
      }

      if (canvasRank) canvasRank.textContent = `#${String(identity.rank).padStart(2, '0')}`;
      if (canvasTitle) canvasTitle.textContent = `${identity.markName} / ${recipe.name}`;
      if (canvasNote) canvasNote.textContent = recipe.note;
      canvas.setAttribute(
        'aria-label',
        `Generated 2029 identity background using the ${identity.markName} stamp and ${recipe.name} pattern`,
      );
      if (languageSignature) languageSignature.textContent = `— ${identity.markName.toUpperCase()} / ${recipe.name.toUpperCase()}`;
    }

    function syncSelection(nextIndex) {
      selectedIdentity = Number(nextIndex);
      if (identitySelect) identitySelect.value = String(selectedIdentity);
      const identity = currentIdentity();
      root?.querySelectorAll('[data-stamp-index]').forEach((button) => {
        button.setAttribute('aria-pressed', String(Number(button.dataset.stampIndex) === selectedIdentity));
      });

      if (proof) {
        proof.style.setProperty('--ink', identity.primary);
        proof.style.setProperty('--paper', identity.paper);
        const mark = proof.querySelector('svg');
        if (mark) {
          mark.innerHTML = `<title>${identity.markName} stamp proof</title>${identity.markPaths
            .map((path) => `<path d="${path}" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>`)
            .join('')}`;
          mark.setAttribute('aria-label', `${identity.markName} stamp proof`);
        }
      }
      if (proofTitle) proofTitle.textContent = identity.markName;
      if (proofSchool) proofSchool.textContent = `${identity.school} · ${identity.city}, ${identity.state}`;
      if (proofRank) proofRank.textContent = `${String(identity.rank).padStart(2, '0')} / 25`;
      renderPattern();
    }

    function syncRecipe(nextRecipe) {
      selectedRecipe = nextRecipe;
      if (recipeSelect) recipeSelect.value = selectedRecipe;
      root?.querySelectorAll('[data-recipe-card]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.recipeCard === selectedRecipe));
      });
      renderPattern();
    }

    function downloadCanvas(source, filename) {
      if (!(source instanceof HTMLCanvasElement)) return;
      source.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        link.click();
        window.setTimeout(() => URL.revokeObjectURL(url), 500);
      }, 'image/png');
    }

    function renderStampDownload() {
      const identity = currentIdentity();
      const stampCanvas = document.createElement('canvas');
      stampCanvas.width = 1200;
      stampCanvas.height = 1200;
      const ctx = stampCanvas.getContext('2d');
      if (!ctx) return;
      ctx.fillStyle = identity.paper;
      ctx.fillRect(0, 0, 1200, 1200);
      ctx.strokeStyle = identity.primary;
      ctx.lineWidth = 14;
      ctx.setLineDash([6, 18]);
      ctx.strokeRect(64, 64, 1072, 1072);
      ctx.setLineDash([]);
      drawMark(ctx, identity, 600, 555, 650, identity.primary, -0.025);
      drawRegistration(ctx, 1200, 1200, identity.secondary);
      ctx.fillStyle = identity.secondary;
      ctx.font = '700 24px ui-monospace, monospace';
      ctx.fillText(`POINTCAST 25 / ${String(identity.rank).padStart(2, '0')} / 2029`, 96, 1090);
      downloadCanvas(stampCanvas, `pointcast-2029-${identity.slug}-stamp.png`);
    }

    function loadKept() {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
        kept = Array.isArray(value)
          ? value.filter((slug) => identities.some((identity) => identity.slug === slug)).slice(0, maxStamps)
          : [];
      } catch {
        kept = [];
      }
      renderKept();
    }

    function saveKept() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(kept));
      } catch {
        // The stamp book remains usable for this tab when storage is unavailable.
      }
      renderKept();
    }

    function renderKept() {
      if (!keptStamps) return;
      if (!kept.length) {
        keptStamps.innerHTML = '<p>Keep up to eight stamps. Nothing leaves this browser.</p>';
        if (stampStatus) stampStatus.textContent = 'No stamps kept yet.';
        return;
      }
      keptStamps.innerHTML = kept.map((slug) => {
        const identity = identities.find((candidate) => candidate.slug === slug);
        return identity
          ? `<span style="--chip:${identity.primary};--chip-paper:${identity.paper}"><b>${String(identity.rank).padStart(2, '0')}</b>${identity.markName}</span>`
          : '';
      }).join('');
      if (stampStatus) stampStatus.textContent = `${kept.length} of ${maxStamps} stamps kept locally.`;
    }

    function currentLanguageText() {
      return languageLines.join('\n');
    }

    function renderLanguage() {
      if (languageOutput) {
        languageOutput.innerHTML = languageLines.map((line) => line.replaceAll('&', '&amp;').replaceAll('<', '&lt;')).join('<br>');
      }
      renderPattern();
    }

    identitySelect?.addEventListener('change', () => syncSelection(identitySelect.value));
    recipeSelect?.addEventListener('change', () => syncRecipe(recipeSelect.value));
    densityInput?.addEventListener('input', () => {
      density = Number(densityInput.value);
      if (densityOutput) densityOutput.textContent = String(density);
      renderPattern();
    });
    invertInput?.addEventListener('change', () => {
      night = invertInput.checked;
      renderPattern();
    });
    form?.addEventListener('submit', (event) => event.preventDefault());

    root?.querySelectorAll('[data-recipe-card]').forEach((button) => {
      button.addEventListener('click', () => syncRecipe(button.dataset.recipeCard));
    });
    root?.querySelectorAll('[data-stamp-index]').forEach((button) => {
      button.addEventListener('click', () => syncSelection(button.dataset.stampIndex));
    });
    root?.querySelector('[data-spin]')?.addEventListener('click', () => {
      spin += 1;
      selectedIdentity = (selectedIdentity + 7) % identities.length;
      selectedRecipe = recipes[(recipes.findIndex((recipe) => recipe.id === selectedRecipe) + 3) % recipes.length].id;
      density = 2 + ((density + spin) % 7);
      if (densityInput) densityInput.value = String(density);
      if (densityOutput) densityOutput.textContent = String(density);
      syncSelection(selectedIdentity);
      syncRecipe(selectedRecipe);
    });
    root?.querySelector('[data-download-background]')?.addEventListener('click', () => {
      downloadCanvas(canvas, `pointcast-2029-${currentIdentity().slug}-${selectedRecipe}.png`);
    });
    root?.querySelector('[data-download-stamp]')?.addEventListener('click', renderStampDownload);

    root?.querySelector('[data-collect-stamp]')?.addEventListener('click', () => {
      const slug = currentIdentity().slug;
      if (kept.includes(slug)) {
        kept = kept.filter((candidate) => candidate !== slug);
        if (stampStatus) stampStatus.textContent = `${currentIdentity().markName} removed from the local stamp book.`;
      } else if (kept.length >= maxStamps) {
        if (stampStatus) stampStatus.textContent = `The stamp book holds ${maxStamps}. Remove one before adding another.`;
        return;
      } else {
        kept = [...kept, slug];
        if (stampStatus) stampStatus.textContent = `${currentIdentity().markName} added to the local stamp book.`;
      }
      saveKept();
    });

    root?.querySelector('[data-clear-stamp-book]')?.addEventListener('click', () => {
      kept = [];
      saveKept();
    });
    root?.querySelector('[data-copy-stamp-book]')?.addEventListener('click', async () => {
      const receipt = kept.length
        ? `POINTCAST 25 / SATURDAY COMMONS / 2029\n${kept.map((slug) => {
            const identity = identities.find((candidate) => candidate.slug === slug);
            return identity ? `${String(identity.rank).padStart(2, '0')} · ${identity.school} · ${identity.markName}` : '';
          }).join('\n')}\nUnofficial speculative field kit · ${location.href}`
        : 'POINTCAST 25 / SATURDAY COMMONS / 2029\nNo stamps kept yet.';
      try {
        await navigator.clipboard.writeText(receipt);
        if (stampStatus) stampStatus.textContent = 'Stamp-book receipt copied.';
      } catch {
        if (stampStatus) stampStatus.textContent = 'Copy unavailable. Your local stamps are still here.';
      }
    });

    root?.querySelector('[data-generate-language]')?.addEventListener('click', () => {
      spin += 1;
      languageLines = [
        textParts.openings[(spin * 3 + selectedIdentity) % textParts.openings.length],
        textParts.places[(spin * 5 + density) % textParts.places.length],
        textParts.endings[(spin * 7 + selectedIdentity) % textParts.endings.length],
      ];
      renderLanguage();
      if (languageStatus) languageStatus.textContent = 'A new local invitation is ready.';
    });
    root?.querySelector('[data-add-language]')?.addEventListener('click', () => {
      showLanguage = true;
      renderPattern();
      if (languageStatus) languageStatus.textContent = 'Invitation added to the downloadable background.';
    });
    root?.querySelector('[data-clear-language]')?.addEventListener('click', () => {
      showLanguage = false;
      renderPattern();
      if (languageStatus) languageStatus.textContent = 'Invitation removed from the background.';
    });
    root?.querySelector('[data-copy-language]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`${currentLanguageText()}\n— ${currentIdentity().markName.toUpperCase()} / 2029`);
        if (languageStatus) languageStatus.textContent = 'Invitation copied.';
      } catch {
        if (languageStatus) languageStatus.textContent = 'Copy unavailable. The invitation remains visible.';
      }
    });
    root?.querySelector('[data-share-edition]')?.addEventListener('click', async (event) => {
      try {
        await navigator.clipboard.writeText('https://pointcast.xyz/25/2029/field-kit');
        event.currentTarget.textContent = 'Field kit copied';
      } catch {
        event.currentTarget.textContent = 'pointcast.xyz/25/2029/field-kit';
      }
    });

    loadKept();
    renderPattern();
  </script>
</BlockLayout>

