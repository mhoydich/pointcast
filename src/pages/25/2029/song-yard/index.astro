  .bowl__field {
    position: absolute;
    inset: 35% 27%;
    display: grid;
    place-content: center;
    border: 2px solid rgba(245, 237, 219, 0.6);
    color: rgba(245, 237, 219, 0.68);
    text-align: center;
  }

  .bowl__field span { font-size: 0.55rem; letter-spacing: 0.12em; }
  .bowl__field strong {
    margin-top: 0.5rem;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(1.9rem, 4vw, 3.6rem);
    line-height: 0.82;
  }

  .bowl__section {
    position: absolute;
    display: flex;
    min-width: 180px;
    flex-direction: column;
