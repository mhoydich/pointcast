    position: absolute;
    top: -22px;
    left: 50%;
    display: grid;
    width: min(86%, 720px);
    grid-template-columns: repeat(16, 1fr);
    border: 2px solid var(--cream);
    background: #0d1217;
    transform: translateX(-50%);
