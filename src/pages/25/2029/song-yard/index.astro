---
import BlockLayout from '../../../../layouts/BlockLayout.astro';
import {
  SONG_YARD_PROGRAMS,
  SONG_YARD_REPERTOIRE_PROGRAMS,
} from '../../../../lib/pointcast-college-football-magazine';
import {
  POINTCAST_2029_SONG_YARD,
  SONG_YARD_PARTS,
  SONG_YARD_PRACTICE_PATH,
  SONG_YARD_RULES,
  SONG_YARD_SEEDS,
} from '../../../../lib/pointcast-2029-song-yard';

const description =
  'A playable stadium-song practice commons with 35 programs, a source-labeled pop repertoire atlas, six original song seeds, four rehearsal parts, and an optional browser-local pitch listener.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'The Song Yard — PointCast 25 / 2029',
      description,
      url: POINTCAST_2029_SONG_YARD.canonical,
      applicationCategory: 'MusicApplication',
      operatingSystem: 'Web browser',
      isAccessibleForFree: true,
      datePublished: POINTCAST_2029_SONG_YARD.publishedAt,
      creator: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'CreativeWork',
        name: 'Saturday Commons — PointCast 25 / 2029 Field Kit',
        url: POINTCAST_2029_SONG_YARD.parent,
      },
      featureList: [
        'Thirty-five selectable college-football programs',
        'Source-labeled stadium repertoire for sixteen programs',
        'Six original PointCast song seeds',
        'Four-part sample-free Web Audio rehearsal',
        'Four-section spatial bowl mode',
        'Tempo and key adjustment',
        'Optional local-only microphone pitch listener',
        'No recording, upload, account, autoplay, or telemetry',
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Song Yard original practice seeds',
      numberOfItems: SONG_YARD_SEEDS.length,
      itemListElement: SONG_YARD_SEEDS.map((seed, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: seed.title,
        description: seed.note,
      })),
    },
  ],
};
---

<BlockLayout
  title="The Song Yard — PointCast 25 / 2029"
  description={description}
  image="/images/pointcast-2029-song-yard/social-card.png"
  themeColor="#e4ad31"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/2029/song-yard.json',
      title: 'The Song Yard machine-readable practice score',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <div
    class="song-yard"
    data-song-yard
    style={`--team:${SONG_YARD_PROGRAMS[0].primary};--team-two:${SONG_YARD_PROGRAMS[0].secondary};--team-paper:${SONG_YARD_PROGRAMS[0].paper}`}
  >
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="The Song Yard navigation">
        <a href="/25/magazine">Magazine</a>
        <a href="/25/2029">Rebranded</a>
        <a href="/25/2029/field-kit">Field kit</a>
        <a href="#repertoire">Repertoire</a>
        <a href="#practice">Practice</a>
        <a href="#pitch">Pitch</a>
        <a href="#method">Method</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="song-yard-title">
        <div class="hero__copy">
          <p class="eyebrow">POINTCAST 25 · AUDIO PRACTICE AREA · YEAR 2029</p>
          <h1 id="song-yard-title">
            <span>THE SONG</span>
            YARD.
          </h1>
          <p class="hero__dek">
            A stadium song should be learned somewhere kind before it is expected
            somewhere loud.
          </p>
          <div class="hero__actions">
            <a href="#practice">Open rehearsal ↓</a>
            <button type="button" data-share-song-yard>Copy the yard</button>
          </div>
          <dl class="hero__facts">
            <div><dt>06</dt><dd>original song seeds</dd></div>
            <div><dt>04</dt><dd>parts in the bowl</dd></div>
            <div><dt>{SONG_YARD_PROGRAMS.length}</dt><dd>programs in the yard</dd></div>
          </dl>
        </div>

        <div class="hero__world" aria-label="Imagined band terrace and stadium song practice">
          <figure class="hero__photo hero__photo--main">
            <img
              src="/images/pointcast-2029-field-kit/stadium-band-terrace.webp"
              alt="Imagined nighttime band terrace in a porous clay stadium with musicians, radio desk, ceiling fans, river views, and warm stair lights"
              width="1024"
              height="1536"
            />
          </figure>
          <figure class="hero__photo hero__photo--small">
            <img
              src="/images/pointcast-2029-field-kit/fan-section-radio.webp"
              alt="Fans sharing a hand-crank radio and paper guide in an imagined 2029 stadium section"
              width="1024"
              height="1536"
            />
          </figure>
          <div class="hero__score">
            <span>PUBLIC SCORE / 0527</span>
            <strong>CALL<br />↘<br />ANSWER</strong>
            <small>LEARN IT OUTSIDE · SING IT INSIDE</small>
          </div>
          <div class="hero__pulse" aria-hidden="true">
            {Array.from({ length: 12 }, (_, index) => <i style={`--i:${index}`}></i>)}
          </div>
        </div>
      </section>

      <div class="marquee" aria-label="Song Yard principles">
        <span>ONE PHRASE</span>
        <span>ONE VISIBLE ENTRANCE</span>
        <span>ONE PART FOR ORDINARY VOICES</span>
        <span>ONE QUIET REPRISE</span>
      </div>

      <section class="thesis" aria-labelledby="thesis-title">
        <p class="section-tag">WHY A PRACTICE COMMONS?</p>
        <div>
          <h2 id="thesis-title">Tradition needs<br />a rehearsal room.</h2>
          <div class="thesis__columns">
            <p>
              Songs do not become traditions because they are launched. They
              become traditions because the easy part is clear, the difficult
              part belongs to someone, and people have a low-pressure place to
              try again.
            </p>
            <p>
              The Song Yard puts that place beside the transit porch and print
              hall. Learn a call on Tuesday. Print the words on Friday. Let four
              parts find one another on Saturday. Keep the last version quiet
              enough for the walk home.
            </p>
          </div>
        </div>
      </section>

      <section class="repertoire" id="repertoire" aria-labelledby="repertoire-title" data-repertoire-atlas>
        <header class="repertoire__head">
          <div>
            <p class="section-tag">THE REPERTOIRE DESK · REPORTED + PROPOSED</p>
            <h2 id="repertoire-title">What the bowl<br />already knows.</h2>
          </div>
          <div class="repertoire__intro">
            <p>
              Popular music becomes football culture in different ways. Some songs
              are repeated stadium rituals. Some are documented band performances.
              Some simply belong on the reporting desk as regional candidates.
            </p>
            <a href="/25/magazine">Open the full college-football magazine ↗</a>
          </div>
        </header>

        <div class="evidence-key" aria-label="Repertoire evidence key">
          <span><i class="key-dot key-dot--ritual"></i> Stadium ritual</span>
          <span><i class="key-dot key-dot--performance"></i> Documented performance</span>
          <span><i class="key-dot key-dot--candidate"></i> PointCast candidate</span>
        </div>

        <div class="repertoire__filters" role="group" aria-label="Filter the repertoire desk">
          <button type="button" data-repertoire-filter="all" aria-pressed="true">All dossiers</button>
          <button type="button" data-repertoire-filter="pointcast-25" aria-pressed="false">Inside the 25</button>
          <button type="button" data-repertoire-filter="open-field" aria-pressed="false">Open field</button>
          <button type="button" data-repertoire-filter="stadium-ritual" aria-pressed="false">Verified rituals</button>
        </div>
        <p class="repertoire__status" data-repertoire-status aria-live="polite">
          Showing {SONG_YARD_REPERTOIRE_PROGRAMS.length} researched program dossiers.
        </p>

        <div class="repertoire-grid">
          {SONG_YARD_REPERTOIRE_PROGRAMS.map((program) => (
            <article
              class="repertoire-card"
              id={program.slug}
              data-repertoire-card
              data-program-slug={program.slug}
              data-cohort={program.cohort}
              data-evidence={program.repertoire.map((track) => track.evidence).join(' ')}
              style={`--card-ink:${program.primary};--card-two:${program.secondary};--card-paper:${program.paper}`}
            >
              <header>
                <span>{String(program.fieldNumber).padStart(2, '0')} / {program.cohort === 'open-field' ? 'OPEN FIELD' : 'POINTCAST 25'}</span>
                <svg viewBox="0 0 100 100" aria-hidden="true">
                  {program.markPaths.map((path) => <path d={path}></path>)}
                </svg>
              </header>
              <button type="button" class="repertoire-card__program" data-load-program={program.slug}>
                <small>{program.city}, {program.state} · {program.conference}</small>
                <strong>{program.school}</strong>
                <span>{program.markName} · Load in practice ↑</span>
              </button>
              <ol>
                {program.repertoire.map((track) => (
                  <li data-track-evidence={track.evidence}>
                    <div>
                      <span class:list={[
                        'evidence-chip',
                        `evidence-chip--${track.evidence}`,
                      ]}>
                        {track.evidence === 'stadium-ritual'
                          ? 'stadium ritual'
                          : track.evidence === 'documented-performance'
                            ? 'documented use'
                            : 'PointCast candidate'}
                      </span>
                      <span>{track.moment}</span>
                    </div>
                    <h3>{track.title}</h3>
                    <p class="repertoire-card__artist">{track.artist}</p>
                    <p>{track.note}</p>
                    <nav aria-label={`${track.title} references`}>
                      <a href={track.sourceUrl} target="_blank" rel="noopener">Source ↗</a>
                      <a href={track.listenUrl} target="_blank" rel="noopener">Find on Spotify ↗</a>
                    </nav>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>

        <aside class="rights-note">
          <strong>REFERENCE, NOT RESTREAM.</strong>
          <p>
            PointCast publishes titles, artists, editorial notes, source links,
            and provider-search links. It does not host recordings, reproduce
            lyrics, rebuild protected melodies, or imply that a candidate is an
            adopted school tradition.
          </p>
        </aside>
      </section>

      <section class="practice" id="practice" aria-labelledby="practice-title">
        <header class="section-head">
          <div>
            <p class="section-tag">THE PUBLIC REHEARSAL DESK</p>
            <h2 id="practice-title">Learn one part.<br />Then open the bowl.</h2>
          </div>
          <p>
            Every sound is synthesized live from oscillators and generated noise.
            These are original PointCast exercises—not official school music,
            sampled crowds, or reconstructed fight songs.
          </p>
        </header>

        <div class="identity-rail">
          <div class="identity-rail__mark">
            <svg
              data-identity-mark
              viewBox="0 0 100 100"
              role="img"
              aria-label={`${SONG_YARD_PROGRAMS[0].markName}, PointCast's unofficial abstract mark proposal for ${SONG_YARD_PROGRAMS[0].school}`}
            >
              {SONG_YARD_PROGRAMS[0].markPaths.map((path) => <path d={path}></path>)}
            </svg>
          </div>
          <div class="identity-rail__copy">
            <span>WHOSE YARD IS PRACTICING?</span>
            <strong data-identity-name>{SONG_YARD_PROGRAMS[0].school}</strong>
            <small data-identity-mark-name>{SONG_YARD_PROGRAMS[0].markName}</small>
          </div>
          <label>
            <span>Program identity · 35 schools</span>
            <select data-identity-select>
              {SONG_YARD_PROGRAMS.map((program) => (
                <option value={program.slug}>
                  {String(program.fieldNumber).padStart(2, '0')} · {program.school} · {program.markName}{program.cohort === 'open-field' ? ' · OPEN FIELD' : ''}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div class="seed-shelf" aria-label="Choose one of six original song seeds">
          {SONG_YARD_SEEDS.map((seed, index) => (
            <button
              type="button"
              data-seed-id={seed.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{seed.title}</strong>
              <small>{seed.kicker} · {seed.bpm} BPM</small>
            </button>
          ))}
        </div>

        <div class="rehearsal-desk">
          <article class="score-card">
            <div class="score-card__top">
              <span data-song-kicker>{SONG_YARD_SEEDS[0].kicker}</span>
              <span>ORIGINAL / 2029</span>
            </div>
            <h3 data-song-title>{SONG_YARD_SEEDS[0].title}</h3>
            <div class="score-card__line score-card__line--call">
              <span>CALL</span>
              <strong data-song-call>{SONG_YARD_SEEDS[0].call}</strong>
            </div>
            <div class="score-card__line score-card__line--answer">
              <span>ANSWER</span>
              <strong data-song-answer>{SONG_YARD_SEEDS[0].answer}</strong>
            </div>
            <p data-song-note>{SONG_YARD_SEEDS[0].note}</p>
          </article>

          <div class="control-card">
            <div class="control-card__ranges">
              <label>
                <span>Tempo <output data-bpm-output>{SONG_YARD_SEEDS[0].bpm}</output> BPM</span>
                <input
                  data-bpm
                  type="range"
                  min="66"
                  max="124"
                  step="1"
                  value={SONG_YARD_SEEDS[0].bpm}
                />
              </label>
              <label>
                <span>Key shift <output data-key-output>home</output></span>
                <input data-key type="range" min="-5" max="5" step="1" value="0" />
              </label>
              <label class="loop-control">
                <input data-loop type="checkbox" checked />
                <span>Keep looping until I stop</span>
              </label>
            </div>
            <div class="control-card__buttons">
              <button type="button" data-play-part>Practice my part</button>
              <button type="button" data-play-bowl>Open the whole bowl</button>
              <button type="button" data-stop>Stop</button>
            </div>
            <p data-transport-status aria-live="polite">
              The yard is quiet. Choose a part or open the whole bowl.
            </p>
          </div>
        </div>

        <div class="part-grid" role="group" aria-label="Choose one rehearsal part">
          {SONG_YARD_PARTS.map((part, index) => (
            <button
              type="button"
              data-practice-part={part.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{String(index + 1).padStart(2, '0')} / {part.section}</span>
              <strong>{part.name}</strong>
              <small>{part.short}</small>
            </button>
          ))}
        </div>

        <div class="part-note">
          <span>YOUR PART</span>
          <strong data-part-title>{SONG_YARD_PARTS[0].name} · {SONG_YARD_PARTS[0].section}</strong>
          <p data-part-instruction>{SONG_YARD_PARTS[0].instruction}</p>
        </div>

        <div class="bowl" aria-label="Four-section stadium song model">
          <div class="bowl__score" aria-label="Sixteen-step song guide">
            {Array.from({ length: 16 }, (_, index) => (
              <i
                data-beat-step={index}
                aria-hidden="true"
                class:list={[
                  index === 0 || index === 8 ? 'phrase-start' : '',
                  index % 4 === 0 ? 'beat-start' : '',
                ]}
              ></i>
            ))}
          </div>
          <div class="bowl__field">
            <span>THE QUIET FIELD</span>
            <strong>SPACE<br />IS A PART</strong>
          </div>
          {SONG_YARD_PARTS.map((part) => (
            <div class={`bowl__section bowl__section--${part.id}`} data-bowl-section={part.id}>
              <span>{part.section}</span>
              <strong>{part.name}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="pitch-lab" id="pitch" aria-labelledby="pitch-title">
        <div class="pitch-lab__intro">
          <p class="section-tag">OPTIONAL LOCAL PITCH LISTENER</p>
          <h2 id="pitch-title">Find home.<br />Keep your voice.</h2>
          <p>
            Stop the guide, allow microphone access, and hum the target gently.
            The listener estimates pitch inside this browser. It never records,
            stores, transmits, identifies, or scores your voice.
          </p>
        </div>
        <div class="pitch-lab__instrument">
          <div class="pitch-target">
            <span>TARGET</span>
            <strong data-target-note>C4</strong>
          </div>
          <div class="pitch-reading">
            <span>YOU</span>
            <strong data-pitch-note>—</strong>
          </div>
          <div class="pitch-meter" data-pitch-meter style="--pitch-position:50%">
            <span></span>
            <i aria-hidden="true"></i>
          </div>
          <button type="button" data-mic-toggle aria-pressed="false">
            Listen to my pitch
          </button>
          <p data-mic-status aria-live="polite">
            Off by default. Microphone permission is optional.
          </p>
        </div>
      </section>

      <section class="method" id="method" aria-labelledby="method-title">
        <header class="section-head section-head--light">
          <div>
            <p class="section-tag">A TWELVE-MINUTE PRACTICE</p>
            <h2 id="method-title">The song earns<br />the stadium.</h2>
          </div>
          <p>
            A simple public rehearsal makes authorship, access, range, and
            participation visible before the crowd is asked to perform.
          </p>
        </header>
        <ol class="practice-path">
          {SONG_YARD_PRACTICE_PATH.map((step) => (
            <li>
              <span>{step.minute}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.instruction}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <p class="section-tag">EIGHT RULES FOR A SONG PEOPLE CAN ENTER</p>
        <h2 id="rules-title">Write for the<br />second singer.</h2>
        <ol>
          {SONG_YARD_RULES.map((rule, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{rule}</p>
            </li>
          ))}
        </ol>
      </section>

      <aside class="boundary">
        <strong>UNOFFICIAL PRACTICE STUDY.</strong>
        <p>{POINTCAST_2029_SONG_YARD.boundary}</p>
        <p>
          The optional microphone mode performs transient pitch analysis in the
          current page only. It creates no recording, file, account, voiceprint,
          score, upload, analytics event, or server request.
        </p>
      </aside>

      <footer class="closing">
        <p>POINTCAST 25 / THE SONG YARD / PUBLIC SCORE 0527</p>
        <h2>Sing it before<br />you sell it.</h2>
        <nav aria-label="Song Yard closing links">
          <a href="/25/magazine">Open the college-football magazine</a>
          <a href="/25/2029/field-kit">Return to Saturday Commons</a>
          <a href="/25/2029">See all 25 identities</a>
          <a href="/25/2029/song-yard.json">Inspect the JSON</a>
          <a href="/b/0527">Block 0527</a>
        </nav>
      </footer>
    </main>
  </div>
</BlockLayout>

<script>
  import { mountSongYard } from '../../../../lib/pointcast-2029-song-yard-audio';

  let releaseSongYard: (() => void) | undefined;

  function bootSongYard() {
    releaseSongYard?.();
    const root = document.querySelector<HTMLElement>('[data-song-yard]');
    if (!root) return;
    releaseSongYard = mountSongYard(root);

    root.querySelector<HTMLButtonElement>('[data-share-song-yard]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const url = 'https://pointcast.xyz/25/2029/song-yard';
      try {
        await navigator.clipboard.writeText(url);
        button.textContent = 'Yard copied';
      } catch {
        button.textContent = url;
      }
    });

    const repertoireCards = Array.from(root.querySelectorAll<HTMLElement>('[data-repertoire-card]'));
    const repertoireFilters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-repertoire-filter]'));
    const repertoireStatus = root.querySelector<HTMLElement>('[data-repertoire-status]');
    const identitySelect = root.querySelector<HTMLSelectElement>('[data-identity-select]');

    const filterRepertoire = (filter: string) => {
      let visible = 0;
      repertoireCards.forEach((card) => {
        const show = filter === 'all'
          || card.dataset.cohort === filter
          || card.dataset.evidence?.split(' ').includes(filter);
        card.hidden = !show;
        if (show) visible += 1;
      });
      repertoireFilters.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.repertoireFilter === filter));
      });
      if (repertoireStatus) {
        repertoireStatus.textContent = `Showing ${visible} researched program dossier${visible === 1 ? '' : 's'}.`;
      }
    };

    repertoireFilters.forEach((button) => button.addEventListener('click', () => {
      filterRepertoire(button.dataset.repertoireFilter || 'all');
    }));

    root.querySelectorAll<HTMLButtonElement>('[data-load-program]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!identitySelect || !button.dataset.loadProgram) return;
        identitySelect.value = button.dataset.loadProgram;
        identitySelect.dispatchEvent(new Event('change', { bubbles: true }));
        root.querySelector('#practice')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  document.addEventListener('astro:page-load', bootSongYard);
  bootSongYard();
</script>

<style>
  :global(body) {
    margin: 0;
    background: #161b20;
  }

  :global(body > main) {
    min-width: 0;
  }

  .song-yard {
    --ink: #171715;
    --paper: #eee5cf;
    --cream: #f5eddb;
    --gold: #e4ad31;
    --blue: #244b8f;
    --red: #c94a31;
    --green: #557455;
    --line: rgba(23, 23, 21, 0.28);
    min-height: 100vh;
    overflow: hidden;
    color: var(--ink);
    background:
      linear-gradient(rgba(23, 23, 21, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 23, 21, 0.055) 1px, transparent 1px),
      var(--paper);
    background-size: 34px 34px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .song-yard * { box-sizing: border-box; }
  .song-yard button, .song-yard select, .song-yard input { font: inherit; }
  .song-yard button, .song-yard a { -webkit-tap-highlight-color: transparent; }

  .topbar {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.4rem;
    border-bottom: 2px solid var(--ink);
    background: rgba(238, 229, 207, 0.96);
  }

  .topbar a {
    color: inherit;
    text-decoration: none;
  }

  .wordmark {
    font-family: "Arial Black", "Helvetica Neue", sans-serif;
    font-size: 0.95rem;
    letter-spacing: -0.07em;
  }

  .topbar nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  .topbar nav a {
    padding: 0.3rem 0;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topbar nav a:hover,
  .topbar nav a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .hero {
    display: grid;
    min-height: min(790px, calc(100vh - 54px));
    grid-template-columns: minmax(0, 1fr) minmax(480px, 0.95fr);
