---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import PointCast2029Mark from '../../../components/PointCast2029Mark.astro';
import {
  POINTCAST_2029,
  POINTCAST_2029_CONFERENCES,
  POINTCAST_2029_IDENTITIES,
} from '../../../lib/pointcast-2029';

const description =
  'PointCast redesigns its current college-football Top 25 for 2029: 25 original abstract marks, future stadiums, campus interventions, and student-made gear.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: `${POINTCAST_2029.title} — PointCast 25 / 2029`,
      description,
      url: POINTCAST_2029.canonical,
      datePublished: POINTCAST_2029.publishedAt,
      creator: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: { '@type': 'CreativeWorkSeries', name: 'PointCast 25' },
      about: ['college football', 'identity design', 'stadium design', 'student culture'],
    },
    {
      '@type': 'ItemList',
      name: 'PointCast 25 / 2029 visual expansion draft',
      numberOfItems: POINTCAST_2029_IDENTITIES.length,
      itemListElement: POINTCAST_2029_IDENTITIES.map((identity) => ({
        '@type': 'ListItem',
        position: identity.rank,
        url: identity.canonical,
        name: `${identity.school} — ${identity.markName}`,
        description: identity.thesis,
      })),
    },
  ],
};
---

<BlockLayout
  title="Saturday, Rebranded — PointCast 25 / 2029"
  description={description}
  image="/images/pointcast-2029/social-card.png"
  themeColor="#df4b2f"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/25/2029.json', title: 'PointCast 25 / 2029 JSON' },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <div class="r29" data-signal-wall data-view="mark">
    <header class="topbar">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="Saturday, Rebranded navigation">
        <a href="/25">The live 25</a>
        <a href="#marks">25 marks</a>
        <a href="#stadiums">Stadiums</a>
        <a href="#gear">Gear</a>
        <a href="/b/0524">Block 0524</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="r29-title">
        <div class="hero__copy">
          <p class="eyebrow">POINTCAST 25 · VISUAL EXPANSION DRAFT · YEAR 2029</p>
          <h1 id="r29-title"><span>SATURDAY,</span><br />REBRANDED.</h1>
          <p class="hero__dek">
            If PointCast got the call to rebuild the visual culture of the current
            twenty-five, this is the first presentation.
          </p>
          <div class="hero__actions">
            <a href="#marks">Draft all 25 marks ↓</a>
            <button type="button" data-share>Copy this edition</button>
          </div>
        </div>
        <div class="hero__plates" aria-label="Identity system studies">
          <figure class="hero__plate hero__plate--one">
            <img
              src="/images/pointcast-2029/mark-house-03.png"
              alt="Original abstract identity marks presented as patches, scoreboard pixels, flags, and architectural tiles"
              width="1024"
              height="1536"
            />
          </figure>
          <figure class="hero__plate hero__plate--two">
            <img
              src="/images/pointcast-2029/stadium-mountain-rain.png"
              alt="Imagined 2029 mountain stadium with translucent rain roof, timber structure, tram, cisterns, and student rain capes"
              width="1024"
              height="1536"
            />
          </figure>
          <div class="hero__ticket">
            <span>PC25 / 2029</span>
            <strong>25</strong>
            <small>new visual systems</small>
          </div>
        </div>
      </section>

      <div class="marquee" aria-label="Creative direction">
        <span>PLACE BEFORE MASCOT</span>
        <span>STADIUM AS PUBLIC INFRASTRUCTURE</span>
        <span>STUDENT-MADE GEAR</span>
        <span>PAPER SURVIVES THE APP</span>
      </div>

      <section class="brief" aria-labelledby="brief-title">
        <p class="section-tag">THE ASSIGNMENT</p>
        <div>
          <h2 id="brief-title">Not new logos.<br />New relationships to place.</h2>
          <p>
            The familiar sports redesign starts by polishing a mascot, widening a
            letter, and issuing a black alternate. This one starts elsewhere:
            What weather shaped the campus? What should a stadium give back to its
            town? What would students make if the identity belonged to them?
          </p>
          <p>
            Every school gets a wholly original abstract mark, a future-stadium move,
            a campus intervention, and a repairable game-day kit. The result is
            intentionally unofficial: a visual argument, not a leaked plan.
          </p>
        </div>
      </section>

      <section class="houses" aria-labelledby="houses-title">
        <div class="section-head">
          <div>
            <p class="section-tag">FIVE MARK HOUSES</p>
            <h2 id="houses-title">Twenty-five signals.<br />No borrowed letters.</h2>
          </div>
          <p>
            Each house holds five unrelated marks. They share material discipline,
            not a master template.
          </p>
        </div>
        <div class="house-strip">
          {POINTCAST_2029.visualPlates.slice(0, 5).map((plate, index) => (
            <figure>
              <img
                src={plate.image}
                alt={`${plate.title}: original abstract identity system specimens for the 2029 visual expansion draft`}
                width="1024"
                height="1536"
                loading={index > 1 ? 'lazy' : 'eager'}
              />
              <figcaption>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{plate.title}</strong>
                <small>Ranks {index * 5 + 1}–{index * 5 + 5}</small>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="signal-wall" id="marks" aria-labelledby="marks-title">
        <div class="section-head section-head--wall">
          <div>
            <p class="section-tag">THE SIGNAL WALL</p>
            <h2 id="marks-title">Pick a lens.<br />Open any system.</h2>
          </div>
          <p>
            Keep favorites in this browser. Nothing is transmitted. Each system also
            has a permanent human page and adjacent JSON record.
          </p>
        </div>

        <div class="wall-controls">
          <div class="control-group" role="group" aria-label="Choose a design lens">
            <span>Lens</span>
            <button class="is-active" type="button" data-view-button="mark" aria-pressed="true">Mark</button>
            <button type="button" data-view-button="stadium" aria-pressed="false">Stadium</button>
            <button type="button" data-view-button="campus" aria-pressed="false">Campus</button>
            <button type="button" data-view-button="gear" aria-pressed="false">Gear</button>
          </div>
          <div class="control-group control-group--conference" role="group" aria-label="Filter by conference">
            <span>Field</span>
            <button class="is-active" type="button" data-conference="all" aria-pressed="true">All 25</button>
            {POINTCAST_2029_CONFERENCES.map((conference) => (
              <button type="button" data-conference={conference} aria-pressed="false">{conference}</button>
            ))}
            <button type="button" data-conference="saved" aria-pressed="false">My five</button>
          </div>
        </div>
        <p class="wall-status" data-wall-status aria-live="polite">Showing all 25 identity systems.</p>

        <ol class="mark-grid">
          {POINTCAST_2029_IDENTITIES.map((identity) => (
            <li
              class="mark-card"
              data-identity-card
              data-slug={identity.slug}
              data-conference={identity.conference}
              style={`--primary:${identity.primary};--secondary:${identity.secondary};--paper:${identity.paper}`}
            >
              <article>
                <div class="mark-card__top">
                  <span>#{String(identity.rank).padStart(2, '0')}</span>
                  <span>HOUSE {identity.house}</span>
                  <button
                    type="button"
                    data-keep={identity.slug}
                    aria-pressed="false"
                    aria-label={`Keep ${identity.school} in my five`}
                  >＋</button>
                </div>
                <a class="mark-card__mark" href={`/25/2029/${identity.slug}`}>
                  <PointCast2029Mark
                    paths={identity.markPaths}
                    label={`${identity.markName}, PointCast's unofficial 2029 abstract mark proposal for ${identity.school}`}
                  />
                </a>
                <div class="mark-card__identity">
                  <p>{identity.conference} · {identity.city}, {identity.state}</p>
                  <h3><a href={`/25/2029/${identity.slug}`}>{identity.school}</a></h3>
                  <strong>{identity.markName}</strong>
                </div>
                <div class="mark-card__lens">
                  <p data-lens-panel="mark">{identity.thesis}</p>
                  <p data-lens-panel="stadium">{identity.stadium}</p>
                  <p data-lens-panel="campus">{identity.campus}</p>
                  <p data-lens-panel="gear">{identity.gear}</p>
                </div>
                <div class="mark-card__foot">
                  <span class="swatch" style={`--swatch:${identity.primary}`}></span>
                  <span class="swatch" style={`--swatch:${identity.secondary}`}></span>
                  <a href={`/25/2029/${identity.slug}`}>Open system ↗</a>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>

      <section class="future-section" id="stadiums" aria-labelledby="stadiums-title">
        <div class="future-section__copy">
          <p class="section-tag">THREE STADIUM FUTURES</p>
          <h2 id="stadiums-title">The field should work all week.</h2>
          <p>
            In 2029, the interesting stadium is a weather instrument, transit stop,
            winter garden, shade machine, public kitchen, rehearsal room, and civic
            porch. Premium space can exist. It just cannot be the big idea.
          </p>
        </div>
        <div class="stadium-grid">
          {POINTCAST_2029.visualPlates.filter((plate) => plate.kind === 'stadium').map((plate, index) => (
            <figure>
              <img
                src={plate.image}
                alt={`${plate.title}, an original speculative 2029 college-football stadium study`}
                width="1024"
                height="1536"
                loading="lazy"
              />
              <figcaption>
                <span>0{index + 1}</span>
                <strong>{plate.title}</strong>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="gear-section" id="gear" aria-labelledby="gear-title">
        <div class="gear-grid">
          {POINTCAST_2029.visualPlates.filter((plate) => plate.kind === 'gear').map((plate) => (
            <figure>
              <img
                src={plate.image}
                alt={`${plate.title}, an original speculative 2029 student game-day gear study`}
                width="1024"
                height="1536"
                loading="lazy"
              />
              <figcaption>{plate.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="gear-section__copy">
          <p class="section-tag">STUDENT GEAR / 2029</p>
          <h2 id="gear-title">A uniform for everyone who makes Saturday.</h2>
          <p>
            Band members, radio hosts, grounds crew, photographers, food-table
            volunteers, bus stewards, and the person biking in from a shift all
            belong to the visual culture. The kit layers, repairs, reverses, and
            carries things.
          </p>
          <ul>
            <li>Recycled nylon and wool, never disposable novelty fabric.</li>
            <li>Small woven marks, large functional color fields.</li>
            <li>Repair patches are status, not damage to hide.</li>
            <li>Student print labs own the seasonal layer.</li>
          </ul>
        </div>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <div class="rules__intro">
          <p class="section-tag">DIRECTOR’S RULES</p>
          <h2 id="rules-title">Six things the deck refuses.</h2>
        </div>
        <ol>
          {POINTCAST_2029.rules.map((rule, index) => (
            <li>
              <span>0{index + 1}</span>
              <p>{rule}</p>
            </li>
          ))}
        </ol>
      </section>

      <aside class="boundary" aria-labelledby="boundary-title">
        <strong id="boundary-title">THIS IS AN UNOFFICIAL VISUAL EXPANSION DRAFT.</strong>
        <p>{POINTCAST_2029.boundary}</p>
      </aside>

      <section class="finale">
        <p>POINTCAST 25 / BOARD {POINTCAST_2029.board} / YEAR 2029</p>
        <h2>The sport already has brands.<br />What it needs are better places.</h2>
        <div>
          <a href="#marks">Return to the signal wall ↑</a>
          <a href="/25">Read the current ranking →</a>
          <a href="/mascot-battler">Play the mascot atlas →</a>
          <a href="/25/2029.json">Inspect the JSON →</a>
        </div>
      </section>
    </main>
  </div>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-signal-wall]');
  const status = document.querySelector<HTMLElement>('[data-wall-status]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-identity-card]'));
  const keepKey = 'pointcast:25-2029:kept';
  const maxKept = 5;
  let activeConference = 'all';
  let kept: string[] = [];

  try {
    const stored = JSON.parse(localStorage.getItem(keepKey) || '[]');
    if (Array.isArray(stored)) kept = stored.filter((value) => typeof value === 'string').slice(0, maxKept);
  } catch {
    kept = [];
  }

  function renderKept() {
    document.querySelectorAll<HTMLButtonElement>('[data-keep]').forEach((button) => {
      const slug = button.dataset.keep || '';
      const isKept = kept.includes(slug);
      button.setAttribute('aria-pressed', String(isKept));
      button.textContent = isKept ? '×' : '＋';
    });
  }

  function filterCards() {
    let visible = 0;
    cards.forEach((card) => {
      const show = activeConference === 'all'
        || (activeConference === 'saved' && kept.includes(card.dataset.slug || ''))
        || card.dataset.conference === activeConference;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (status) {
      status.textContent = activeConference === 'saved'
        ? `Showing ${visible} kept system${visible === 1 ? '' : 's'} of ${maxKept}.`
        : activeConference === 'all'
          ? 'Showing all 25 identity systems.'
          : `Showing ${visible} ${activeConference} identity system${visible === 1 ? '' : 's'}.`;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-view-button]').forEach((button) => {
    button.addEventListener('click', () => {
      const view = button.dataset.viewButton || 'mark';
      if (root) root.dataset.view = view;
      document.querySelectorAll<HTMLButtonElement>('[data-view-button]').forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-conference]').forEach((button) => {
    button.addEventListener('click', () => {
      activeConference = button.dataset.conference || 'all';
      document.querySelectorAll<HTMLButtonElement>('[data-conference]').forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      filterCards();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-keep]').forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.keep || '';
      if (kept.includes(slug)) {
        kept = kept.filter((item) => item !== slug);
      } else if (kept.length < maxKept) {
        kept.push(slug);
      } else {
        kept = [...kept.slice(1), slug];
      }
      localStorage.setItem(keepKey, JSON.stringify(kept));
      renderKept();
      if (activeConference === 'saved') filterCards();
    });
  });

  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(window.location.href);
      button.textContent = 'Edition copied ✓';
    } catch {
      button.textContent = 'Copy the URL above';
    }
  });

  renderKept();
  filterCards();
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #171816; }
  :global(.block-layout__main) { padding: 0 !important; max-width: none !important; }
  :global(.site-header), :global(.network-strip) { display: none !important; }

  .r29 {
    --paper: #e6ddc7;
    --ink: #171816;
    --red: #df4b2f;
    --blue: #244d95;
    --green: #315b46;
    --yellow: #e0ac27;
    min-height: 100vh;
    color: var(--ink);
    background:
      linear-gradient(rgba(23,24,22,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23,24,22,.035) 1px, transparent 1px),
      var(--paper);
    background-size: 28px 28px;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .topbar {
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: .8rem 2vw;
    border-bottom: 2px solid var(--ink);
    background: var(--paper);
    position: relative;
    z-index: 5;
  }

  .topbar > a {
    color: inherit;
    font-weight: 950;
    letter-spacing: -.05em;
    text-decoration: none;
    font-size: 1.25rem;
  }

  .topbar nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  .topbar nav a {
    color: inherit;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .hero {
    min-height: 790px;
    display: grid;
    grid-template-columns: .88fr 1.12fr;
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 8rem) clamp(1.25rem, 5vw, 6rem);
    position: relative;
  }

  .hero__copy::before {
    content: "";
    position: absolute;
    width: 18vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
    top: -7vw;
    left: -6vw;
    mix-blend-mode: multiply;
  }

  .eyebrow, .section-tag {
    margin: 0 0 1rem;
    font-size: .72rem;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(4.5rem, 9.2vw, 10.5rem);
    line-height: .73;
    letter-spacing: -.06em;
    text-transform: uppercase;
  }

  .hero h1 span {
    color: transparent;
    -webkit-text-stroke: .025em var(--ink);
  }

  .hero__dek {
    max-width: 34rem;
    margin: 2.5rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.8rem);
    line-height: 1.1;
    font-weight: 700;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }
  .hero__actions a, .hero__actions button {
    border: 2px solid var(--ink);
    border-radius: 0;
    padding: .8rem 1rem;
    color: var(--paper);
    background: var(--ink);
    font: inherit;
    font-size: .75rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .hero__actions button { color: var(--ink); background: transparent; }
  .hero__plates {
    position: relative;
    min-height: 790px;
    background: var(--blue);
    border-left: 2px solid var(--ink);
  }

  .hero__plate { position: absolute; margin: 0; overflow: hidden; border: 2px solid var(--ink); background: #ddd; }
  .hero__plate img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__plate--one { width: 58%; height: 78%; left: 5%; top: 7%; transform: rotate(-3deg); }
  .hero__plate--two { width: 48%; height: 70%; right: -2%; bottom: -3%; transform: rotate(4deg); }

  .hero__ticket {
    position: absolute;
    z-index: 3;
    left: 48%;
    top: 16%;
    width: 180px;
    aspect-ratio: .7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: var(--ink);
    background: var(--yellow);
    border: 2px solid var(--ink);
    transform: rotate(9deg);
    box-shadow: 10px 10px 0 var(--ink);
  }

  .hero__ticket span, .hero__ticket small { font-weight: 900; text-transform: uppercase; }
  .hero__ticket strong { font: 8rem/.7 Impact, sans-serif; letter-spacing: -.08em; }

  .marquee {
    display: flex;
    gap: 2.5rem;
    overflow: hidden;
    padding: .8rem 1rem;
    color: var(--paper);
    background: var(--ink);
    white-space: nowrap;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .marquee span::after { content: "✦"; margin-left: 2.5rem; color: var(--yellow); }

  .brief {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 2rem;
    padding: clamp(4rem, 9vw, 9rem) 5vw;
    border-bottom: 2px solid var(--ink);
  }

  .brief h2, .section-head h2, .future-section h2, .gear-section h2, .rules h2, .finale h2 {
    margin: 0;
    font: clamp(3rem, 6vw, 7.4rem)/.86 Impact, "Arial Black", sans-serif;
    letter-spacing: -.045em;
    text-transform: uppercase;
  }

  .brief > div > p {
    max-width: 56rem;
    font-size: clamp(1.15rem, 1.8vw, 1.65rem);
    line-height: 1.25;
  }

  .houses, .signal-wall, .future-section, .gear-section, .rules { padding: clamp(4rem, 8vw, 8rem) 3vw; }
  .houses { color: var(--paper); background: var(--ink); }
  .section-head {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .section-head > p { max-width: 29rem; font-size: 1.05rem; line-height: 1.4; }
  .house-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .house-strip figure { margin: 0; min-width: 0; }
  .house-strip img {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    display: block;
    border: 1px solid #76756d;
    filter: saturate(.88) contrast(1.02);
  }

  .house-strip figure:nth-child(even) { transform: translateY(2rem); }
  .house-strip figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: .6rem;
    margin-top: .8rem;
    font-size: .72rem;
    text-transform: uppercase;
  }
  .house-strip figcaption span { grid-row: 1 / 3; color: var(--yellow); font-size: 1.6rem; font-weight: 900; }
  .house-strip figcaption small { opacity: .65; }

  .signal-wall { border-bottom: 2px solid var(--ink); }
  .wall-controls { display: grid; gap: 1rem; margin-bottom: 1rem; }
  .control-group { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; }
  .control-group > span {
    width: 5rem;
    font-size: .66rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .control-group button {
    border: 1.5px solid var(--ink);
    border-radius: 99px;
    padding: .5rem .8rem;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: .7rem;
    font-weight: 800;
    cursor: pointer;
