---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { POINTCAST_25, POINTCAST_25_EDITIONS } from '../../lib/pointcast-25';

const description =
  'The permanent 2026 PointCast 25 season ledger: every board, every opening reason, and every movement kept for the final autopsy.';
---

<BlockLayout
  title="25 FOR REASONS — 2026 Season Ledger"
  description={description}
  image="/images/pointcast-25/board-000.png"
  themeColor="#f4ff3f"
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    { type: 'application/json', href: '/25/season.json', title: 'PointCast 25 2026 Season Ledger JSON' },
    { type: 'application/rss+xml', href: '/c/spinning.rss', title: 'PointCast Spinning RSS' },
  ]}
>
  <main class="ledger">
    <header>
      <nav aria-label="Season ledger navigation">
        <a href="/25">← Current board</a>
        <a href="/25/receipts">Receipt book</a>
        <a href="/25/disagreements">Disagreements</a>
        <a href="/25/season.json">Ledger JSON</a>
      </nav>
      <p>POINTCAST 25 · 2026</p>
      <h1>Nothing<br />quietly<br /><em>disappears.</em></h1>
      <div class="intro">
        <strong>The season ledger</strong>
        <p>
          Every Tuesday board keeps its opening sentence, position, and proof.
          At season’s end, this becomes the autopsy: what we saw, what we missed,
          and which reasons survived contact.
        </p>
      </div>
    </header>

    <section aria-labelledby="boards-title">
      <div class="section-head">
        <p>BOARDS ON RECORD</p>
        <h2 id="boards-title">{POINTCAST_25_EDITIONS.length.toString().padStart(3, '0')}</h2>
      </div>

      <ol class="boards">
        {POINTCAST_25_EDITIONS.map((edition) => (
          <li>
            <article>
              <div class="board-id">
                <span>BOARD</span>
                <strong>{edition.board}</strong>
                <small>{edition.status}</small>
              </div>
              <div class="board-copy">
                <time datetime={edition.publishedAt}>
                  {new Intl.DateTimeFormat('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    timeZone: 'America/Los_Angeles',
                  }).format(new Date(edition.publishedAt))}
                </time>
                <h3>{edition.question}</h3>
                <ol aria-label={`Board ${edition.board} top five`}>
                  {edition.leaders.map((team) => (
                    <li>
                      <span>{String(team.rank).padStart(2, '0')}</span>
                      <strong>{team.school}</strong>
                      <p>{team.reason}</p>
                    </li>
                  ))}
                </ol>
                <div class="links">
                  <a href={edition.current}>Read current presentation</a>
                  <a href={edition.snapshot}>Read permanent Board {edition.board}</a>
                  <a href={edition.human}>Permanent Block {edition.block}</a>
                  <a href={edition.machine}>Immutable board JSON</a>
                </div>
                {'integrity' in edition && (
                  <p class="integrity">
                    Verify the frozen board yourself: the JSON above hashes to
                    <code>{edition.integrity}</code>
                  </p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <footer>
      <strong>NEXT BOARD</strong>
      <span>Tuesday · 08:08 PT</span>
      <a href="/api/25/checkout" target="_blank" rel="noopener sponsored">Back the season · $25 ↗</a>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #10100f;
    color: #f7f5ee;
    font-family: var(--pc-font-sans);
  }

  .ledger {
    background: #10100f;
    color: #f7f5ee;
    margin: 0 auto;
    max-width: 1500px;
    min-height: 100vh;
    overflow-x: hidden;
  }

  header {
    border-bottom: 1px solid #3d3c38;
    min-height: 82vh;
    padding: 24px clamp(18px, 4vw, 70px) 70px;
  }

  nav,
  header > p,
  .section-head p,
  time,
  .board-id,
  .links,
  footer {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    justify-content: space-between;
  }

  a {
    color: inherit;
  }

  header > p {
    color: #aaa8a1;
    margin-top: 80px;
  }

  h1 {
    font-size: clamp(74px, 13vw, 190px);
    letter-spacing: -0.09em;
    line-height: 0.74;
    margin: 50px 0;
    text-transform: uppercase;
  }

  h1 em {
    color: #f4ff3f;
    font-style: normal;
  }

  .intro {
    display: grid;
    gap: 30px;
    grid-template-columns: 0.5fr 1fr;
    margin-left: auto;
    max-width: 780px;
  }

  .intro p {
    font-size: clamp(18px, 2vw, 28px);
    line-height: 1.45;
    margin: 0;
  }

  section {
    padding: 80px clamp(18px, 4vw, 70px);
  }

  .section-head {
    align-items: baseline;
    border-bottom: 8px solid #f7f5ee;
    display: flex;
    justify-content: space-between;
  }

  .section-head h2 {
    color: #f4ff3f;
    font-size: clamp(80px, 13vw, 180px);
    letter-spacing: -0.09em;
    line-height: 0.7;
    margin: 0;
  }

  .boards {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .boards > li {
    border-bottom: 1px solid #3d3c38;
    padding: 40px 0;
  }

  article {
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(150px, 0.28fr) 1fr;
  }

  .board-id {
    display: flex;
    flex-direction: column;
  }

  .board-id strong {
    color: #f4ff3f;
    font-family: var(--pc-font-sans);
    font-size: clamp(70px, 10vw, 130px);
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .board-copy h3 {
    font-size: clamp(28px, 4vw, 55px);
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 24px 0 40px;
  }

  .board-copy > ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .board-copy > ol li {
    align-items: baseline;
    border-top: 1px solid #3d3c38;
    display: grid;
    gap: 18px;
    grid-template-columns: 30px minmax(130px, 0.35fr) 1fr;
    padding: 14px 0;
  }

  .board-copy > ol span,
  .board-copy > ol p {
    color: #aaa8a1;
    font-size: 12px;
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
  }

  .integrity {
    color: #8f8e85;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    margin: 16px 0 0;
    text-transform: uppercase;
  }

  .integrity code {
    display: block;
    margin-top: 4px;
    overflow-wrap: anywhere;
    text-transform: none;
  }

  .links a,
  footer a {
    border: 1px solid #77756f;
    padding: 13px;
    text-decoration: none;
  }

  footer {
    align-items: center;
    background: #f4ff3f;
    color: #10100f;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    padding: 28px clamp(18px, 4vw, 70px);
  }

  footer a {
    border-color: #10100f;
  }

  @media (max-width: 680px) {
    header {
      min-height: auto;
    }

    .intro,
    article {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(48px, 14.5vw, 58px);
      line-height: 0.8;
    }

    .board-copy > ol li {
      grid-template-columns: 24px 1fr;
    }

    .board-copy > ol p {
      grid-column: 2;
    }

    footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
