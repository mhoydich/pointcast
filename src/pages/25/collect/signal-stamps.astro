---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import MintButton from '../../../components/MintButton.astro';
import { SATURDAY_SIGNAL_CONFERENCES as conferences, SATURDAY_SIGNAL_CONTRACT as contract, SATURDAY_SIGNAL_STAMPS as feature, SATURDAY_SIGNAL_TEAMS as teams } from '../../../lib/pointcast-signal-stamps';
const jsonLd = {'@context':'https://schema.org','@graph':[
  {'@type':'CreativeWorkSeries',name:`${feature.title} — ${feature.issue}`,description:feature.dek,url:feature.canonical,image:feature.socialImage,datePublished:feature.publishedAt,isAccessibleForFree:true,numberOfItems:teams.length,license:'https://creativecommons.org/publicdomain/zero/1.0/',publisher:{'@type':'Organization',name:'PointCast'}},
  {'@type':'ItemList',name:'Saturday Signal Nouns College 50',numberOfItems:teams.length,itemListElement:teams.map((team)=>({'@type':'ListItem',position:team.fieldNumber,name:`${team.markName} Noun — ${team.school}`,url:`${feature.canonical}#${team.slug}`,image:`https://pointcast.xyz${team.stampUrl}`}))}
]};
---
<BlockLayout title={`${feature.title} — ${feature.issue}`} description={feature.dek} image={feature.socialImage} themeColor="#171816" jsonLd={jsonLd} alternates={[{type:'application/json',href:'/25/collect/signal-stamps.json',title:'Saturday Signal Nouns data'}]} immersive={true} showNetworkStrip={false}>
<main class="press">
  <header class="mast"><a href="/" class="brand">POINTCAST</a><span>COLLEGE 50 · FIELD EDITION 2026</span><nav><a href="#press-floor">PRESS FLOOR</a><a href="#research">RESEARCH</a><a href="/25/magazine">MAGAZINE</a></nav></header>
  <section class="hero">
    <img src={feature.collectionSheet} alt="A print wall of fifty colorful Saturday Signal Nouns wearing rectangular noggles" width="1500" height="750" fetchpriority="high" />
    <div class="hero__wash"></div><div class="hero__copy"><p class="eyebrow">THE NOUN PRESS · DROP 001 · CC0</p><h1>SATURDAY<br/><em>SIGNAL</em><br/>NOUNS</h1><p class="dek">{feature.dek}</p><p class="actions"><a href="#press-floor">CHOOSE A NOUN ↓</a><a href={feature.collectionSheet} download>TAKE THE SHEET ↗</a></p></div>
    <div class="totals"><b>50</b><span>FIELD NOUNS</span><b>150</b><span>FREE FILES</span><b>0 ꜩ</b><span>MINT PRICE</span></div>
  </section>
  <section class="dispatch"><p><em>A school is more than a logo. A Noun is permission to keep building.</em></p><p>River light, limestone, pine, transit, weather, type, and a print lab at 2 a.m. become the field around fifty characters assembled from official Nouns CC0 traits. They are place portraits—not redrawn mascots.</p><div>{feature.trendLens.map((item)=><span>{item}</span>)}</div></section>
  <section class="noun-source"><div><p class="eyebrow">OFFICIAL TRAITS · OPEN DNA</p><h2>REAL NOUNS.<br/>LOCAL FIELDS.</h2></div><div><p>Every character uses the checked-in Nouns trait system: pixel body, accessory, head, and noggles. PointCast adds the campus-place field, editorial name, print texture, profile crop, and wallpaper.</p><p><a href={feature.nounsSource.href} target="_blank" rel="noopener">EXPLORE THE OFFICIAL NOUNS TRAITS ↗</a></p></div></section>
  <section class="mint"><div><p class="eyebrow">TEZOS · OPEN PRESS</p><h2>FREE TO TAKE.<br/>FINITE TO COLLECT.</h2></div><div><p>Every field is prepared as a free Tezos edition: 100 copies maximum, one per wallet, no sale price. The collector pays network gas only. Downloads remain free whether or not you mint.</p><dl><div><dt>PRICE</dt><dd>0 ꜩ + network gas</dd></div><div><dt>CAP</dt><dd>100 / field</dd></div><div><dt>RIGHTS</dt><dd>CC0 where possible</dd></div><div><dt>WALLET</dt><dd>Kukai / Beacon</dd></div></dl>{contract.live&&contract.kt1?<a href={`https://tzkt.io/${contract.kt1}`}>LIVE CONTRACT ↗</a>:<p class="pending">● ART + METADATA LIVE · CONTRACT ORIGINATION AWAITS CREATOR SIGNATURE</p>}</div></section>
  <section id="press-floor" class="floor">
    <header><div><p class="eyebrow">PRESS FLOOR / 01–50</p><h2>PICK THE FIELD<br/>THAT FEELS LIKE HOME.</h2></div><div class="controls"><label>FIND A SCHOOL OR SIGNAL<input type="search" placeholder="Try Morgantown or desert…" data-search/></label><div><button class="active" data-filter="all">ALL 50</button>{conferences.map((c)=><button data-filter={c}>{c}</button>)}</div><p data-count>50 fields on the press</p></div></header>
    <div class="grid">{teams.map((team)=><article id={team.slug} data-card data-conference={team.conference} data-search-value={`${team.school} ${team.short} ${team.city} ${team.state} ${team.markName} ${team.localSignal} ${team.designLens}`.toLowerCase()} style={`--p:${team.primary};--s:${team.secondary};--paper:${team.paper}`}>
      <div class="num">NOUN {String(team.fieldNumber).padStart(2,'0')} · FIELD EDITION</div><a class="art" href={team.stampUrl} download><img src={team.stampUrl} alt={`${team.markName}, a Nouns CC0 field character for ${team.school}`} width="1024" height="1024" loading="lazy"/></a>
      <div class="body"><small>{team.school} · {team.city}</small><h3>{team.markName}</h3><p class="signal">{team.localSignal}</p><p class="lens">NOUN DNA · OFFICIAL CC0 TRAITS<br/>DESIGN LENS · {team.designLens}</p><div class="takes"><a href={team.stampUrl} download>STAMP<small>1024 PNG</small></a><a href={team.profileUrl} download>PROFILE<small>512 PNG</small></a><a href={team.wallpaperUrl} download>WALL<small>1920 WEBP</small></a></div><div class="card-foot"><a href={team.designSourceUrl} target="_blank" rel="noopener">{team.designSourceLabel} ↗</a><a href={team.metadataUrl}>DNA JSON ↗</a></div>{contract.live&&contract.kt1?<MintButton contract={contract.kt1} tokenId={team.id} priceMutez={0} kind="faucet" label="MINT FREE NOUN →"/>:<button class="waiting" disabled>MINT OPENS AFTER ORIGINATION</button>}</div>
    </article>)}</div><p class="empty" data-empty hidden>No field matched that signal.</p>
  </section>
  <section class="sheet"><img src={feature.collectionSheet} alt="All fifty Saturday Signal Nouns arranged as one print wall" width="1500" height="750" loading="lazy"/><div><p class="eyebrow">THE WHOLE ISSUE · ONE SHEET</p><h2>THE COLLEGE 50<br/>AS NOUNS.</h2><p>Download it, print it, use it as your desktop, or cut the fields apart. The collection is released as culture before inventory.</p><a href={feature.collectionSheet} download>DOWNLOAD THE SHEET ↗</a></div></section>
  <section id="research" class="research"><div><p class="eyebrow">RESEARCH DESK</p><h2>50 SCHOOLS.<br/>50 DESIGN LENSES.</h2><p>Every field links to an official university art, architecture, or design program. They are research context—not collaborators or endorsers.</p></div><ol>{teams.map((team)=><li><span>{String(team.fieldNumber).padStart(2,'0')}</span><div><b>{team.school}</b><small>{team.designLens}</small></div><a href={team.designSourceUrl} target="_blank" rel="noopener">{team.designSourceLabel} ↗</a></li>)}</ol></section>
  <section class="prov"><div><p class="eyebrow">NOUNS DNA · SIX STUDIES · ONE PRESS</p><h2>THE TRAITS MAKE CHARACTERS.<br/>POINTCAST MAKES THE ISSUE.</h2></div><div>{feature.press.map((item)=><p>{item}</p>)}<p class="provlinks"><a href={feature.nounsSource.href} target="_blank" rel="noopener">NOUNS TRAITS ↗</a><a href={feature.provenance}>SHA-256 MANIFEST ↗</a><a href={feature.contractMetadata}>CONTRACT JSON ↗</a><a href="/25/collect/signal-stamps.json">COLLECTION JSON ↗</a></p></div></section>
  <footer><p>{feature.boundary}</p><p>{feature.license}</p><nav><a href="/25/magazine">MAGAZINE</a><a href="/25">POINTCAST 25</a><a href="/">HOME</a></nav></footer>
</main>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('[data-card]')], search=document.querySelector<HTMLInputElement>('[data-search]'), buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')], count=document.querySelector<HTMLElement>('[data-count]'), empty=document.querySelector<HTMLElement>('[data-empty]'); let conference='all';
const refresh=()=>{const q=(search?.value||'').trim().toLowerCase();let visible=0;cards.forEach(card=>{const show=(conference==='all'||card.dataset.conference===conference)&&(!q||(card.dataset.searchValue||'').includes(q));card.hidden=!show;if(show)visible++});if(count)count.textContent=`${visible} field${visible===1?'':'s'} on the press`;if(empty)empty.hidden=visible!==0};search?.addEventListener('input',refresh);buttons.forEach(button=>button.addEventListener('click',()=>{conference=button.dataset.filter||'all';buttons.forEach(b=>b.classList.toggle('active',b===button));refresh()}));
</script>
</BlockLayout>
<style>
:global(body){margin:0;background:#efe6cf;color:#171816}:global(*){box-sizing:border-box}.press{--ink:#171816;--paper:#efe6cf;--acid:#d8ff3e;min-height:100vh;background:var(--paper);font-family:var(--pc-font-mono,ui-monospace,monospace)}a{color:inherit}.mast{height:58px;padding:0 22px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:2px solid var(--ink);font-size:10px;letter-spacing:.15em}.mast a{text-decoration:none}.brand{font-size:15px;font-weight:900}.mast nav{justify-self:end;display:flex;gap:18px}.hero{min-height:calc(100vh - 58px);position:relative;overflow:hidden;color:#fff7e8;background:#171816;display:flex;align-items:flex-end}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(1.18)}.hero__wash{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,13,12,.93),rgba(12,13,12,.3)),linear-gradient(0deg,rgba(12,13,12,.7),transparent 55%)}.hero__copy{position:relative;z-index:1;width:min(860px,75vw);padding:70px 5vw 62px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.hero h1,h2{font-family:Arial Narrow,Inter,sans-serif;font-weight:950;letter-spacing:-.06em;margin:0}.hero h1{font-size:clamp(72px,11.5vw,190px);line-height:.72}.hero h1 em{color:var(--acid);font-style:normal}.dek{max-width:660px;font:clamp(17px,2vw,25px)/1.35 Georgia,serif;margin-top:38px}.actions{display:flex;gap:9px;flex-wrap:wrap}.actions a,.sheet>div>a{padding:14px 18px;border:2px solid currentColor;text-decoration:none;font-size:10px;font-weight:800}.actions a:first-child,.sheet>div>a{color:var(--ink);background:var(--acid);border-color:var(--acid)}.totals{position:absolute;right:25px;bottom:25px;z-index:1;display:grid;grid-template-columns:auto auto;gap:4px 12px;padding:16px;border:2px solid #fff7e8;background:#17181699}.totals b{font-size:26px;color:var(--acid)}.totals span{font-size:9px;align-self:center}.dispatch{display:grid;grid-template-columns:1fr 2fr;gap:34px;padding:60px 5vw;border-bottom:2px solid var(--ink);font:clamp(20px,2.2vw,31px)/1.25 Georgia,serif}.dispatch p{margin:0}.dispatch div{grid-column:2;display:flex;gap:7px;flex-wrap:wrap}.dispatch span{font:9px var(--pc-font-mono,monospace);border:1px solid;padding:7px 11px;border-radius:99px;text-transform:uppercase}.noun-source{display:grid;grid-template-columns:1fr 1fr;gap:5vw;padding:75px 5vw;color:#f4ecd8;background:#4130a0}.noun-source>div>p:not(.eyebrow){font:20px/1.45 Georgia,serif}.noun-source a{display:inline-block;padding:12px;border:2px solid var(--acid);color:var(--acid);font:800 9px var(--pc-font-mono,monospace);text-decoration:none}.mint{display:grid;grid-template-columns:1fr 1fr;gap:5vw;padding:75px 5vw;color:#f4ecd8;background:var(--ink)}h2{font-size:clamp(46px,6.5vw,104px);line-height:.83}.mint>div>p:not(.eyebrow){font:20px/1.45 Georgia,serif}.mint dl{display:grid;grid-template-columns:1fr 1fr;border:1px solid #777}.mint dl div{padding:14px;border:1px solid #777}.mint dt{color:var(--acid);font-size:9px}.mint dd{margin:5px 0 0;font-size:11px}.pending{border:1px solid var(--acid);padding:12px!important;font:9px var(--pc-font-mono,monospace)!important;letter-spacing:.12em}.floor{padding:70px 3vw}.floor>header{display:grid;grid-template-columns:1.1fr 1fr;gap:4vw;margin:0 2vw 40px}.controls label{display:block;font-size:9px;letter-spacing:.14em}.controls input{display:block;width:100%;padding:14px;margin:8px 0;border:2px solid;background:transparent;font:16px Georgia,serif}.controls div{display:flex;flex-wrap:wrap;gap:5px}.controls button{padding:7px 9px;border:1px solid;background:transparent;font:8px var(--pc-font-mono,monospace);text-transform:uppercase;cursor:pointer}.controls button.active{color:var(--paper);background:var(--ink)}.controls>p{font-size:9px;text-transform:uppercase}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--ink);border:2px solid var(--ink)}article{min-width:0;background:var(--paper);scroll-margin-top:20px}article[hidden]{display:none}.num{padding:10px 12px;color:var(--paper);background:var(--s);font-size:9px;letter-spacing:.18em}.art{display:block;background:var(--p);overflow:hidden}.art img{display:block;width:100%;aspect-ratio:1;object-fit:cover;transition:.3s}.art:hover img{transform:scale(1.025)}.body{padding:16px}.body>small{font-size:8px;text-transform:uppercase}.body h3{font:900 clamp(25px,2.7vw,44px)/.9 Arial Narrow,Inter,sans-serif;letter-spacing:-.045em;margin:7px 0 15px}.signal{min-height:42px;font:15px/1.3 Georgia,serif}.lens{min-height:48px;font-size:8px;line-height:1.55;text-transform:uppercase}.takes{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid;margin:15px 0}.takes a{padding:9px 7px;border-right:1px solid;text-decoration:none;font-size:8px;font-weight:800}.takes a:last-child{border:0}.takes small{display:block;font-size:6px;opacity:.65}.card-foot{min-height:45px;display:flex;justify-content:space-between;gap:10px;font-size:7px;text-transform:uppercase}.card-foot a:first-child{max-width:75%}.waiting{width:100%;padding:10px;border:1px dashed;background:transparent;font:8px var(--pc-font-mono,monospace)}.empty{text-align:center;padding:60px}.sheet{display:grid;grid-template-columns:1.2fr .8fr;color:#f4ecd8;background:#4130a0}.sheet img{width:100%;height:100%;object-fit:cover}.sheet>div{padding:7vw 5vw;align-self:center}.sheet>div>p:not(.eyebrow){font:18px/1.45 Georgia,serif;margin:26px 0}.research{display:grid;grid-template-columns:.8fr 1.2fr;gap:7vw;padding:90px 5vw}.research>div{position:sticky;top:30px;align-self:start}.research>div>p:last-child{font:18px/1.45 Georgia,serif}.research ol{list-style:none;margin:0;padding:0;border-top:2px solid}.research li{display:grid;grid-template-columns:38px 1fr 1fr;gap:12px;padding:14px 0;border-bottom:1px solid;align-items:center}.research li b,.research li small{display:block}.research li b{font:18px Georgia,serif}.research li small,.research li>a{font-size:8px;text-transform:uppercase}.prov{display:grid;grid-template-columns:1.2fr .8fr;gap:6vw;padding:85px 5vw;background:var(--acid)}.prov>div:last-child>p:not(.provlinks){border-top:1px solid;padding:12px 0;margin:0;font-size:10px;text-transform:uppercase}.provlinks{display:flex;flex-wrap:wrap;gap:7px}.provlinks a{padding:9px;border:1px solid;font-size:8px}footer{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:34px 5vw;color:#f4ecd8;background:var(--ink);font-size:8px;text-transform:uppercase}footer nav{grid-column:1/-1;display:flex;gap:20px}footer a{color:var(--acid)}
@media(max-width:1050px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.mast{grid-template-columns:1fr auto;height:52px;padding:0 14px}.mast>span{display:none}.mast nav a:not(:first-child){display:none}.hero{min-height:760px}.hero__copy{width:100%;padding:90px 20px 150px}.hero h1{font-size:22vw}.totals{left:20px;right:auto}.dispatch,.noun-source,.mint,.floor>header,.sheet,.research,.prov{grid-template-columns:1fr}.dispatch div{grid-column:1}.grid{grid-template-columns:repeat(2,1fr)}.floor{padding:55px 8px}.body{padding:10px}.takes{grid-template-columns:1fr}.takes a{border-right:0;border-bottom:1px solid}.card-foot{display:block}.card-foot a{display:block;margin-bottom:6px}.sheet>div,.research,.prov,.noun-source,.mint{padding:55px 20px}.research>div{position:static}.research li{grid-template-columns:30px 1fr}.research li>a{grid-column:2}footer{grid-template-columns:1fr}footer nav{grid-column:1;flex-direction:column}}
</style>
