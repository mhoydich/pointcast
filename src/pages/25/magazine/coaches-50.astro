---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import {
  COACH_AXIS_LABELS,
  COACHES_50_PLATES,
  COACHES_50_SOURCES,
  COACHES_50_TIERS,
  POINTCAST_COACHES_50,
  POINTCAST_COACHES_FEATURE,
  weightedRoomIndex,
} from '../../../lib/pointcast-coaches-50';

const feature = POINTCAST_COACHES_FEATURE;
const conferences = [...new Set(POINTCAST_COACHES_50.map((coach) => coach.conference))].sort();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${feature.title} — ${feature.subtitle}`,
  alternativeHeadline: feature.dek,
  description: feature.dek,
  datePublished: feature.publishedAt,
  dateModified: feature.updatedAt,
  url: feature.canonical,
  image: feature.socialImage,
  author: { '@type': 'Organization', name: 'PointCast Editorial Desk' },
  publisher: { '@type': 'Organization', name: 'PointCast' },
  isPartOf: {
    '@type': 'PublicationIssue',
    name: "PointCast College Football — Issue 001: Talkin' Season",
    url: feature.magazine,
  },
  about: [
    'college football coaches',
    'FBS football',
    'college athletics finance',
    'player development',
    'football facilities',
    'regional sports culture',
  ],
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: POINTCAST_COACHES_50.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: POINTCAST_COACHES_50.map((coach) => ({
      '@type': 'ListItem',
      position: coach.rank,
      name: `${coach.coach}, ${coach.school}`,
    })),
  },
};
---

<BlockLayout
  title="The Coaches' Room — The PointCast 50 for 2026"
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#dcff3f"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/coaches-50.json',
      title: "The Coaches' Room structured edition",
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="coaches">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · COACHES DESK 001</span>
      <nav aria-label="The Coaches' Room navigation">
        <a href="/25">The 25</a>
        <a href="/25/magazine">Issue 001</a>
        <a href="/25/magazine/coaches-50.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="coaches-title">
      <div class="hero__art">
        <img
          src={COACHES_50_PLATES[0].image}
          alt="An imagined empty football film room before dawn"
          width="1024"
          height="1536"
        />
        <div class="hero__art-note">
          <span>PLATE 01 / THE HEADSET</span>
          <p>Imagined editorial scene. No real coach or campus depicted.</p>
        </div>
      </div>
      <div class="hero__copy">
        <p class="eyebrow">THE POINTCAST 50 · AS OF {feature.asOf}</p>
        <h1 id="coaches-title">THE<br /><em>COACHES’</em><br />ROOM</h1>
        <p class="hero__dek">{feature.dek}</p>
        <div class="hero__actions">
          <a href="#ranking">Enter the ranking ↓</a>
          <a href={feature.playlist.url} target="_blank" rel="noopener">Play the room ↗</a>
        </div>
      </div>
      <aside class="hero__score" aria-label="PointCast seven-room scoring system">
        <span>THE ROOM INDEX</span>
        {COACH_AXIS_LABELS.map((axis) => (
          <div>
            <b>{String(axis.weight).padStart(2, '0')}</b>
            <p>{axis.label}</p>
          </div>
        ))}
        <small>WEIGHTS TOTAL 100. THE RANKING REMAINS EDITORIAL.</small>
      </aside>
    </section>

    <section class="opening" aria-labelledby="opening-title">
      <p class="section-index">00 / THE QUESTION</p>
      <div>
        <h2 id="opening-title">The most visible person<br />in a system too large<br />for one person to control.</h2>
        <p class="standfirst">{feature.thesis}</p>
        <div class="opening__columns">
          <p>
            College football still sells the coach as monarch: one headset, one
            office, one contract, one answer. But the 2026 job looks closer to a
            small state. A coach inherits a labor market, a front office, a
            donor graph, a regional player economy, an academic institution, a
            physical plant, and tens of thousands of people who carry the story
            home.
          </p>
          <p>
            So this is not a list of résumés wearing quarter-zips. It is a
            ranking of operators inside particular rooms. Kirby Smart’s room is
            not Curt Cignetti’s room. Kyle Whittingham’s Michigan room is not
            the Utah room that made him. Lane Kiffin at LSU is a merger between
            two forms of abundance. The room changes the coach; the coach
            changes what the room believes it can do.
          </p>
        </div>
      </div>
    </section>

    <section class="room-model" aria-labelledby="room-model-title">
      <header>
        <p class="section-index">01 / SEVEN ROOMS</p>
        <h2 id="room-model-title">Score the ecosystem.<br /><em>Do not confuse it for the person.</em></h2>
        <p>
          Each rating is a 1–10 editorial aperture. The weighted Room Index
          shows how complete the environment feels today; the numbered ranking
          still gives extra weight to coaching proof, conversion, and the exact
          stakes of 2026.
        </p>
      </header>
      <ol>
        {COACH_AXIS_LABELS.map((axis, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <small>{axis.weight}% OF THE ROOM INDEX</small>
              <h3>{axis.label}</h3>
              <p>{axis.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="new-rooms" aria-labelledby="new-rooms-title">
      <figure>
        <img
          src={COACHES_50_PLATES[1].image}
          alt="An imagined table of roster pieces, blank ledgers, facility samples, and a stadium model"
          width="1024"
          height="1536"
          loading="lazy"
        />
        <figcaption>PLATE 02 · {COACHES_50_PLATES[1].caption}</figcaption>
      </figure>
      <div>
        <p class="section-index">02 / 2026’S GREAT EXPERIMENT</p>
        <h2 id="new-rooms-title">Four masters.<br />Four unfamiliar rooms.</h2>
        <p>
          Whittingham to Michigan. Campbell to Penn State. Franklin to Virginia
          Tech. Kiffin to LSU. These moves make 2026 a cleaner test of coaching
          portability than the sport usually offers.
        </p>
        <div class="new-rooms__cards">
          {POINTCAST_COACHES_50.filter((coach) => [9, 10, 19, 20].includes(coach.rank)).map((coach) => (
            <article>
              <span>#{String(coach.rank).padStart(2, '0')}</span>
              <h3>{coach.coach}</h3>
              <strong>{coach.school}</strong>
              <p>{coach.question}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ranking" id="ranking" data-ranking-root aria-labelledby="ranking-title">
      <header class="ranking__header">
        <div>
          <p class="section-index">03 / THE POINTCAST 50</p>
          <h2 id="ranking-title">The board,<br /><em>with doubt attached.</em></h2>
        </div>
        <p>
          Filter the room, then open any card for the seven-axis profile. A
          ranking is useful only when it remembers the next question.
        </p>
      </header>

      <div class="ranking__controls" aria-label="Filter coach ranking">
        <label>
          <span>CONFERENCE</span>
          <select data-conference-filter>
            <option value="all">All conferences</option>
            {conferences.map((conference) => <option value={conference}>{conference}</option>)}
          </select>
        </label>
        <label>
          <span>SEARCH</span>
          <input data-coach-search type="search" placeholder="Coach, program, region…" />
        </label>
        <div class="ranking__count" aria-live="polite">
          <strong data-ranking-count>{POINTCAST_COACHES_50.length}</strong>
          <span>ROOMS OPEN</span>
        </div>
      </div>

      <div class="ranking__tiers">
        {COACHES_50_TIERS.map((tier, tierIndex) => {
          const start = tierIndex === 0 ? 1 : tierIndex === 1 ? 11 : tierIndex === 2 ? 26 : 41;
          const end = tierIndex === 0 ? 10 : tierIndex === 1 ? 25 : tierIndex === 2 ? 40 : 50;
          return (
            <section data-tier={tier.id} aria-labelledby={`tier-${tier.id}`}>
              <header>
                <span>{tier.ranks}</span>
                <div>
                  <h3 id={`tier-${tier.id}`}>{tier.title}</h3>
                  <p>{tier.note}</p>
                </div>
              </header>
              <div class="coach-grid">
                {POINTCAST_COACHES_50.filter((coach) => coach.rank >= start && coach.rank <= end).map((coach) => (
                  <article
                    class:list={['coach-card', { 'coach-card--top': coach.rank <= 10 }]}
                    data-coach-card
                    data-conference={coach.conference}
                    data-search={`${coach.coach} ${coach.school} ${coach.region} ${coach.signal}`.toLowerCase()}
                  >
                    <div class="coach-card__top">
                      <span class="coach-card__rank">{String(coach.rank).padStart(2, '0')}</span>
                      <div class="coach-card__identity">
                        <small>{coach.signal}</small>
                        <h4>{coach.coach}</h4>
                        <p>{coach.school} · {coach.conference}</p>
                      </div>
                      <div class="coach-card__index">
                        <strong>{weightedRoomIndex(coach.scores)}</strong>
                        <small>ROOM<br />INDEX</small>
                      </div>
                    </div>
                    <div class="coach-card__region">{coach.region}</div>
                    <p class="coach-card__case">{coach.case}</p>
                    <blockquote>2026: {coach.question}</blockquote>
                    <details>
                      <summary>OPEN THE SEVEN ROOMS <b aria-hidden="true">＋</b></summary>
                      <div class="coach-card__scores">
                        {COACH_AXIS_LABELS.map((axis) => (
                          <div style={`--score:${coach.scores[axis.id]}`}>
                            <span>{axis.label}</span>
                            <i aria-hidden="true"><b></b></i>
                            <strong>{coach.scores[axis.id]}</strong>
                          </div>
                        ))}
                      </div>
                    </details>
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
      <p class="ranking__empty" data-ranking-empty hidden>
        No room matches that filter. Try the whole field.
      </p>
    </section>

    <section class="capital" aria-labelledby="capital-title">
      <div class="capital__copy">
        <p class="section-index">04 / CAPITAL IS NOT THE COACH</p>
        <h2 id="capital-title">A building is<br />an amplifier.</h2>
        <p>
          The first year of the House settlement brought a direct-benefit cap
          of roughly $20.5 million. Coaching staffs now sit inside front offices
          managing revenue sharing, NIL, retention, scouting, acquisition,
          contracts, and the old work of teaching. The richest room can still
          waste its temperature.
        </p>
        <p>
          That is why PointCast’s capital score measures conversion. A coach at
          Army or Boise State should not lose a ranking argument simply because
          another coach works beside more waterfalls and donor suites. The
          useful question is: what did the room make possible, and what did the
          coach make of the room?
        </p>
        <a href="#sources">Inspect the research desk ↓</a>
      </div>
      <figure>
        <img
          src={COACHES_50_PLATES[2].image}
          alt="An imagined worn football locker room with repaired equipment and two empty chairs"
          width="1024"
          height="1536"
          loading="lazy"
        />
        <figcaption>PLATE 03 · {COACHES_50_PLATES[2].caption}</figcaption>
      </figure>
    </section>

    <section class="region" aria-labelledby="region-title">
      <figure>
        <img
          src={COACHES_50_PLATES[3].image}
          alt="An imagined rainy recruiting drive through a football field, farmland, river, and city"
          width="1024"
          height="1536"
          loading="lazy"
        />
        <figcaption>PLATE 04 · {COACHES_50_PLATES[3].caption}</figcaption>
      </figure>
      <div>
        <p class="section-index">05 / THE REGION COACHES TOO</p>
        <h2 id="region-title">The recruiting road<br />is part of the staff.</h2>
        <p>
          Georgia’s in-state abundance, BYU’s diaspora, Iowa’s developmental
          body types, Miami’s South Florida speed, Texas Tech’s high-school
          network, Army’s mission, and Rutgers’ New Jersey corridor are not
          scenery. They are operating conditions.
        </p>
        <p>
          Great fit can look like destiny after the fact. A better test is
          whether the coach makes the region more visible to itself: high-school
          coaches recognized, alumni reactivated, local players developed, fans
          given a language that belongs to the place.
        </p>
        <div class="region__signals">
          <span>PIPELINES</span>
          <span>WEATHER</span>
          <span>DISTANCE</span>
          <span>MEMORY</span>
          <span>LANGUAGE</span>
          <span>BELONGING</span>
        </div>
      </div>
    </section>

    <section class="crowd" aria-labelledby="crowd-title">
      <figure>
        <img
          src={COACHES_50_PLATES[4].image}
          alt="An imagined packed stadium at wet November twilight, seen beside one empty chair"
          width="1024"
          height="1536"
          loading="lazy"
        />
      </figure>
      <div class="crowd__copy">
        <p class="section-index">06 / THE PUBLIC ROOM</p>
        <h2 id="crowd-title">The crowd is not<br />a customer segment.</h2>
        <p>
          It is unpaid distribution, inherited memory, jury, choir, pressure,
          weather, and the person driving four hours home after the loss. The
          best fan relationship is not permanent approval. It is a credible
          bargain about effort, identity, access, and what tomorrow’s program
          is trying to become.
        </p>
        <blockquote>
          “A coach does not have to win every argument with the crowd. The coach
          has to keep the argument about football.”
        </blockquote>
      </div>
    </section>

    <section class="playlist" aria-labelledby="playlist-title">
      <div class="playlist__copy">
        <p class="section-index">07 / COMPANION LISTENING</p>
        <h2 id="playlist-title">THE<br />COACHES’<br /><em>ROOM</em></h2>
        <p>{feature.playlist.note}</p>
        <a href={feature.playlist.url} target="_blank" rel="noopener">OPEN THE 13-SONG PLAYLIST ↗</a>
        <small>
          Spotify playback is provided by Spotify. PointCast does not host or
          restream recordings.
        </small>
      </div>
      <div class="playlist__player">
        <iframe
          title={feature.playlist.title}
          src="https://open.spotify.com/embed/playlist/5HAh6Bu2OhiZxbDNAKbL6a?utm_source=pointcast&theme=0"
          width="100%"
          height="500"
          frameborder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <section class="aura" aria-labelledby="aura-title">
      <figure>
        <img
          src={COACHES_50_PLATES[5].image}
          alt="An imagined dark stadium tunnel with one anonymous figure at the field entrance"
          width="1024"
          height="1536"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="section-index">08 / THE TUNNEL TEST</p>
        <h2 id="aura-title">Aura is the loan<br />belief makes to proof.</h2>
        <p>
          It can arrive through charisma, history, television, a rivalry win, a
          great quarterback, a terrifying defense, or one sentence that the
          entire building repeats. It is useful. It is also perishable.
        </p>
        <p>
          The best coaches convert aura into ordinary behavior before the loan
          comes due. Meetings begin on time. Assistants know the decision
          rights. Players understand the role. The facility serves the work.
          The recruiting message resembles the lived day. Then the tunnel feels
          inevitable because the room behind it is not pretending.
        </p>
      </div>
    </section>

    <section class="method" aria-labelledby="method-title">
      <div>
        <p class="section-index">09 / HOW TO DISAGREE</p>
        <h2 id="method-title">A timestamp,<br />not a monument.</h2>
      </div>
      <div class="method__copy">
        <p>{feature.methodology}</p>
        <p>
          New evidence begins immediately: fall camp, injuries, role decisions,
          retention, first-game substitutions, late-game choices, and what the
          program says after its first public failure. This board should move.
          The JSON edition preserves today’s order so the season can audit it.
        </p>
        <div class="method__boundary">
          <strong>EDITORIAL BOUNDARY</strong>
          <p>{feature.boundary}</p>
        </div>
      </div>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-title">
      <header>
        <p class="section-index">10 / RESEARCH DESK</p>
        <h2 id="sources-title">Receipts<br />for the room.</h2>
        <p>
          Current job assignments, reference rankings, primary announcements,
          postseason structure, and the capital context behind the 2026 job.
          Accessed July 29, 2026.
        </p>
      </header>
      <ol>
        {COACHES_50_SOURCES.map((source, index) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{source.label}</strong>
                <p>{source.role}</p>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="feature-footer">
      <div>
        <span>POINTCAST COLLEGE FOOTBALL · ISSUE 001</span>
        <h2>THE RANKING<br />IS ONE<br /><em>DEPARTMENT.</em></h2>
      </div>
      <nav aria-label="Continue reading PointCast College Football">
        <a href="/25/magazine">Magazine front door ↗</a>
        <a href="/25">The current 25 ↗</a>
        <a href="/25/2029/song-yard">The Song Yard ↗</a>
        <a href="/25/magazine/sorority-row">House Desk 002 ↗</a>
        <a href="/b/0541">Permanent Block 0541 ↗</a>
      </nav>
    </footer>
  </main>

  <script>
    const rankingRoot = document.querySelector('[data-ranking-root]');
    if (rankingRoot instanceof HTMLElement) {
      const conferenceSelect = rankingRoot.querySelector('[data-conference-filter]');
      const searchInput = rankingRoot.querySelector('[data-coach-search]');
      const cards = [...rankingRoot.querySelectorAll('[data-coach-card]')];
      const tiers = [...rankingRoot.querySelectorAll('[data-tier]')];
      const count = rankingRoot.querySelector('[data-ranking-count]');
      const empty = rankingRoot.querySelector('[data-ranking-empty]');

      const applyFilters = () => {
        const conference =
          conferenceSelect instanceof HTMLSelectElement ? conferenceSelect.value : 'all';
        const query =
          searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
        let visible = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const matchesConference =
            conference === 'all' || card.dataset.conference === conference;
          const matchesSearch = !query || (card.dataset.search || '').includes(query);
          const show = matchesConference && matchesSearch;
          card.hidden = !show;
          if (show) visible += 1;
        });

        tiers.forEach((tier) => {
          if (!(tier instanceof HTMLElement)) return;
          tier.hidden = !tier.querySelector('[data-coach-card]:not([hidden])');
        });

        if (count) count.textContent = String(visible);
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      };

      conferenceSelect?.addEventListener('change', applyFilters);
      searchInput?.addEventListener('input', applyFilters);
    }
  </script>
</BlockLayout>

<style>
  :global(html) {
    background: #171815;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #171815;
    color: #f1f0e8;
  }

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  .coaches {
    --paper: #efeee5;
    --ink: #171815;
    --acid: #dcff3f;
    --orange: #ff5d2d;
    --green: #153d2c;
    --line: rgba(239, 238, 229, 0.24);
    width: 100%;
    overflow: clip;
    background: var(--ink);
    color: var(--paper);
    font-family: Inter, sans-serif;
  }

  .mast {
    min-height: 58px;
    padding: 0 2vw;
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    font: 700 0.68rem/1 JetBrains Mono, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mast > a {
    color: var(--acid);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .mast nav {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }

  .mast nav a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    min-height: calc(100svh - 58px);
    display: grid;
    grid-template-columns: minmax(280px, 0.88fr) minmax(480px, 1.4fr) minmax(150px, 0.42fr);
    border-bottom: 1px solid var(--line);
  }

  .hero__art {
    position: relative;
    min-height: 760px;
    overflow: hidden;
  }

  .hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 65%, var(--ink));
    pointer-events: none;
  }

  .hero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.05);
  }

  .hero__art-note {
    position: absolute;
    z-index: 1;
    left: 1.4rem;
    right: 1.4rem;
    bottom: 1.4rem;
    padding: 0.9rem;
    background: rgba(23, 24, 21, 0.84);
    backdrop-filter: blur(8px);
    font: 0.62rem/1.45 JetBrains Mono, monospace;
    text-transform: uppercase;
  }

  .hero__art-note span {
    color: var(--acid);
  }

  .hero__art-note p {
    margin: 0.4rem 0 0;
  }

  .hero__copy {
    min-width: 0;
    padding: clamp(3rem, 7vw, 8rem) clamp(2rem, 5vw, 6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow,
  .section-index {
    margin: 0;
    color: var(--acid);
    font: 700 0.66rem/1 JetBrains Mono, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 1.3rem 0 2rem;
    font-size: clamp(4.6rem, 10.5vw, 11.5rem);
    font-weight: 900;
    line-height: 0.74;
    letter-spacing: -0.095em;
    text-transform: uppercase;
  }

  .hero h1 em {
    color: var(--acid);
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .hero__dek {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    line-height: 1.35;
  }

  .hero__actions {
    margin-top: 2.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__actions a,
  .capital__copy > a,
  .playlist__copy > a {
    padding: 0.95rem 1.2rem;
    border: 1px solid var(--paper);
    color: var(--paper);
    font: 700 0.7rem/1 JetBrains Mono, monospace;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero__actions a:first-child {
    background: var(--acid);
    border-color: var(--acid);
