---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  LANE_KIFFIN_FINEBAUM_CLOSE,
  LANE_KIFFIN_FOE_BOARD,
  LANE_KIFFIN_ROSTER_BOARD,
  LANE_KIFFIN_SOURCES,
  LANE_KIFFIN_TEMPERATURE_FEATURE,
  LANE_KIFFIN_TEMPERATURE_READINGS,
  LANE_KIFFIN_TIMELINE,
  kiffinSource,
} from '../../../lib/pointcast-lane-kiffin-temperature';

const feature = LANE_KIFFIN_TEMPERATURE_FEATURE;
const sourceKindLabel = {
  primary: 'PRIMARY',
  reported: 'REPORTING',
  commentary: 'COMMENTARY',
} as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: `${feature.title} — ${feature.subtitle}`,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        name: "PointCast College Football — Issue 001: Talkin' Season",
        url: 'https://pointcast.xyz/25/magazine',
      },
      about: [
        'Lane Kiffin',
        'LSU football',
        'Ole Miss football',
        '2026 college football season',
        'college football coaching',
      ],
      citation: LANE_KIFFIN_SOURCES.map((source) => source.url),
    },
    {
      '@type': 'ItemList',
      name: 'Lane Kiffin ecosystem temperature readings',
      numberOfItems: LANE_KIFFIN_TEMPERATURE_READINGS.length,
      itemListElement: LANE_KIFFIN_TEMPERATURE_READINGS.map((reading, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${reading.label}: ${reading.temperature} — ${reading.headline}`,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#f4c430"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/lane-kiffin-temperature.json',
      title: 'Lane Kiffin Temperature Check structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="kiffin">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · COACHES DESK 003</span>
      <nav aria-label="Lane Kiffin Temperature Check navigation">
        <a href="/25/magazine/coach-weather">WEATHER</a>
        <a href="/25/magazine/coaches-50">THE 50</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href="/25/magazine/lane-kiffin-temperature.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="kiffin-title">
      <div class="hero__copy">
        <p class="eyebrow">DISPATCH {feature.dispatch} · {feature.asOf} · {feature.status}</p>
        <h1 id="kiffin-title"><span>LANE</span><br />KIFFIN<br /><em>CHECK.</em></h1>
        <p class="hero__dek">{feature.dek}</p>
        <div class="hero__actions">
          <a href="#readings">Read the ecosystem ↓</a>
          <a href="#paul">What would Paul say? ↘</a>
        </div>
      </div>

      <div class="hero__meter" aria-label={`PointCast preseason temperature ${feature.overallTemperature} out of 100`}>
        <div class="hero__score">
          <span>POINTCAST PRESEASON SIGNAL</span>
          <strong>{feature.overallTemperature}<sup>°</sup></strong>
          <b>{feature.overallBand}</b>
        </div>
        <div class="thermometer" aria-hidden="true">
          <span style={`--temperature:${feature.overallTemperature}%`}></span>
        </div>
        <div class="hero__meter-note">
          <span>01 / NEW JOB</span>
          <span>40 / REPORTED TRANSFERS</span>
          <span>09 / POINTCAST COACH RANK</span>
          <span>00 / LSU GAMES PLAYED</span>
        </div>
      </div>

      <p class="hero__boundary">TEMPERATURE IS NARRATIVE PRESSURE, NOT A WIN PROJECTION.</p>
    </section>

    <section class="opening" aria-labelledby="opening-title">
      <p class="section-index">00 / THE MERGER</p>
      <div class="opening__headline">
        <h2 id="opening-title">Two forms of<br /><em>abundance.</em></h2>
        <p>{feature.thesis}</p>
      </div>
      <div class="opening__columns">
        <p>
          Kiffin comes to Baton Rouge with the thing LSU has repeatedly tried to
          purchase and repeatedly found difficult to stabilize: a modern offensive
          identity that can recruit, improvise, and replace itself. LSU gives him the
          inverse gift—one of the sport’s deepest local player ecologies, a national
          championship memory, and a Saturday that already knows how to become theater.
        </p>
        <p>
          The complication is alive in Oxford. Ole Miss did not collapse when Kiffin
          left. It reached a national semifinal, kept Trinidad Chambliss and Kewan
          Lacy, signed the No. 2 portal class, and placed Pete Golding at the center of
          its own continuation story. LSU’s first season therefore begins with a
          working control group.
        </p>
      </div>
      <aside class="opening__receipt">
        <span>THE QUESTION</span>
        <strong>Can motion<br />create stability?</strong>
        <small>POINTCAST COACHES’ ROOM · RANK #09</small>
      </aside>
    </section>

    <section class="readings" id="readings" aria-labelledby="readings-title">
      <header class="section-head">
        <div>
          <p class="section-index">01 / EIGHT READINGS</p>
          <h2 id="readings-title">Where the heat<br /><em>actually lives.</em></h2>
        </div>
        <p>
          Each number is an editorial pressure signal out of 100. It measures how
          much attention, expectation, change, or unresolved meaning currently sits
          in the room—not how good the room is.
        </p>
      </header>

      <div class="reading-grid">
        {LANE_KIFFIN_TEMPERATURE_READINGS.map((reading, index) => (
          <article class={`reading reading--${reading.band}`} id={reading.id}>
            <div class="reading__top">
              <span>{String(index + 1).padStart(2, '0')} / {reading.label}</span>
              <strong>{reading.temperature}<sup>°</sup></strong>
            </div>
            <div class="reading__bar" aria-hidden="true">
              <i style={`--temperature:${reading.temperature}%`}></i>
            </div>
            <h3>{reading.headline}</h3>
            <p>{reading.read}</p>
            <blockquote>{reading.proof}</blockquote>
            <div class="reading__sources">
              {reading.sourceIds.map((sourceId) => {
                const source = kiffinSource(sourceId);
                return <a href={source.url} target="_blank" rel="noopener">{source.outlet} ↗</a>;
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="split" aria-labelledby="split-title">
      <div class="split__lsu">
        <p class="section-index">02 / THE SPLIT SCREEN</p>
        <span>BATON ROUGE · NEW ROOM</span>
        <h2 id="split-title">LSU bought<br /><em>the future.</em></h2>
        <ul>
          <li><b>$91M</b><span>reported seven-year coaching deal</span></li>
          <li><b>#01</b><span>reported 2026 portal class</span></li>
          <li><b>40</b><span>reported transfer additions</span></li>
          <li><b>NFL</b><span>LSU’s description of its new front office</span></li>
        </ul>
      </div>
      <div class="split__olemiss">
        <span>OXFORD · OLD ROOM</span>
        <h2>Ole Miss kept<br /><em>the argument.</em></h2>
        <ul>
          <li><b>13–2</b><span>2025 final record</span></li>
          <li><b>CFP</b><span>national-semifinal appearance</span></li>
          <li><b>#02</b><span>reported 2026 portal class</span></li>
          <li><b>SEP 19</b><span>LSU returns to Oxford</span></li>
        </ul>
      </div>
      <p class="split__caption">
        The defining rivalry is temporarily between Kiffin’s institutional
        possibility and the program that proved it could continue without him.
      </p>
    </section>

    <section class="roster" aria-labelledby="roster-title">
      <header class="section-head section-head--light">
        <div>
          <p class="section-index">03 / PEOPLE INSIDE THE SYSTEM</p>
          <h2 id="roster-title">A roster is not<br /><em>a receipt yet.</em></h2>
        </div>
        <p>
          The transfer haul explains the temperature, not the outcome. These four
          figures show the merger’s basic architecture before a shared LSU snap.
        </p>
      </header>
      <div class="roster__grid">
        {LANE_KIFFIN_ROSTER_BOARD.map((person, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')} · {person.role}</span>
            <h3>{person.name}</h3>
            <small>{person.origin}</small>
            <p>{person.read}</p>
          </article>
        ))}
      </div>
      <div class="roster__note">
        <strong>THE PLAYER BOUNDARY</strong>
        <p>
          This page reports roster construction and public records. It does not
          infer private player trust, happiness, promises, compensation, health, or
          locker-room sentiment.
        </p>
      </div>
    </section>

    <section class="timeline" aria-labelledby="timeline-title">
      <header>
        <p class="section-index">04 / ELEVEN MONTHS OF WEATHER</p>
        <h2 id="timeline-title">The move keeps<br /><em>happening.</em></h2>
      </header>
      <ol>
        {LANE_KIFFIN_TIMELINE.map((event, index) => {
          const source = kiffinSource(event.sourceId);
          return (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <small>{event.date}</small>
              <h3>{event.title}</h3>
              <p>{event.note}</p>
              <a href={source.url} target="_blank" rel="noopener">Receipt ↗</a>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="foes" aria-labelledby="foes-title">
      <header class="section-head">
        <div>
          <p class="section-index">05 / THE FOE BOARD</p>
          <h2 id="foes-title">Five games that<br /><em>change the sentence.</em></h2>
        </div>
        <p>
          Preseason language is generous. These are the games most likely to replace
          the current description of Kiffin at LSU with a different one.
        </p>
      </header>
      <div class="foes__board">
        {LANE_KIFFIN_FOE_BOARD.map((foe, index) => (
          <article>
            <div>
              <span>{foe.date}</span>
              <small>{foe.place}</small>
            </div>
            <b>{String(index + 1).padStart(2, '0')}</b>
            <h3>{foe.opponent}</h3>
            <h4>{foe.label}</h4>
            <p>{foe.read}</p>
          </article>
        ))}
      </div>
      <a class="foes__schedule" href="https://lsusports.net/sports/fb/schedule" target="_blank" rel="noopener">
        Open the official LSU schedule <b>↗</b>
      </a>
    </section>

    <section class="finebaum" id="paul" aria-labelledby="paul-title">
      <div class="finebaum__flag">
        <span>{LANE_KIFFIN_FINEBAUM_CLOSE.label}</span>
        <b aria-hidden="true">PF?</b>
      </div>
      <div class="finebaum__body">
        <p class="section-index">06 / THE LAST WORD, CAREFULLY</p>
        <h2 id="paul-title">{LANE_KIFFIN_FINEBAUM_CLOSE.title}</h2>
        <p class="finebaum__setup">{LANE_KIFFIN_FINEBAUM_CLOSE.setup}</p>
        <blockquote>“{LANE_KIFFIN_FINEBAUM_CLOSE.synthesis}”</blockquote>
        <p class="finebaum__method">{LANE_KIFFIN_FINEBAUM_CLOSE.method}</p>
        <div class="finebaum__sources">
          {LANE_KIFFIN_FINEBAUM_CLOSE.sourceIds.map((sourceId) => {
            const source = kiffinSource(sourceId);
            return <a href={source.url} target="_blank" rel="noopener">{source.outlet} · documented comment ↗</a>;
          })}
        </div>
      </div>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p class="section-index">07 / SOURCE ROOM</p>
        <h2 id="sources-title">The receipts stay<br /><em>with the heat.</em></h2>
        <p>
          Primary program records establish people, dates, roster, schedule, and
          structure. Independent reporting supplies contract and market context.
          Commentary is labeled as commentary.
        </p>
      </header>
      <ol>
        {LANE_KIFFIN_SOURCES.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <small>{sourceKindLabel[source.kind]} · {source.outlet}</small>
              <h3>{source.label}</h3>
              <p>{source.note}</p>
            </div>
            <a href={source.url} target="_blank" rel="noopener" aria-label={`Open ${source.label}`}>↗</a>
          </li>
        ))}
      </ol>
    </section>

    <SeasonTicket25 context="Independent Coaches Desk reporting, recurring weather checks, and the complete 2026 season ledger are funded by the Founding Season Ticket." />

    <aside class="boundary">
      <strong>UNOFFICIAL EDITORIAL TEMPERATURE.</strong>
      <p>{feature.boundary}</p>
      <p>{feature.finebaumBoundary}</p>
    </aside>

    <footer class="footer">
      <div>
        <span>POINTCAST COLLEGE FOOTBALL</span>
        <strong>COACHES DESK 003 · BLOCK {feature.block}</strong>
      </div>
      <p>Pressure is not proof. The season supplies the receipt.</p>
      <nav aria-label="Lane Kiffin Temperature Check closing links">
        <a href="/25/magazine/coach-weather">Coach Weather</a>
        <a href="/25/magazine/coaches-50#coach-9">The PointCast 50</a>
        <a href="/25/season">Season ledger</a>
        <a href={`/b/${feature.block}`}>Block {feature.block}</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #120c1d; }

  .kiffin {
    --ink: #17121f;
    --purple: #3a1263;
    --purple-dark: #180b29;
    --gold: #f4c430;
    --cream: #f3edda;
    --red: #f04b3f;
    --blue: #5c91ff;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--pc-font-mono);
  }

  .kiffin * { box-sizing: border-box; }
  .kiffin a { color: inherit; }

  .mast {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    padding: 0 clamp(1rem, 3vw, 3rem);
    border-bottom: 2px solid var(--gold);
    background: var(--purple-dark);
    color: var(--cream);
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .mast > a { color: var(--gold); }
  .mast nav { display: flex; align-items: stretch; height: 100%; }
  .mast nav a { display: grid; place-items: center; padding: 0 0.75rem; border-left: 1px solid rgba(244, 196, 48, 0.35); text-decoration: none; }
  .mast nav a:hover, .mast nav a:focus-visible { background: var(--gold); color: var(--ink); }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    min-height: 820px;
    border-bottom: 4px solid var(--ink);
    background:
      radial-gradient(circle at 78% 8%, rgba(244, 196, 48, 0.4), transparent 22%),
      linear-gradient(135deg, var(--purple-dark) 0 57%, var(--purple) 57% 100%);
    color: var(--cream);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(244, 196, 48, 0.45) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 196, 48, 0.3) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .hero__copy { position: relative; z-index: 1; display: flex; flex-direction: column; padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 5vw, 5rem); }
  .eyebrow, .section-index { margin: 0; font-size: 0.62rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; }
  .hero h1 { margin: 1.2rem 0 2rem; font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(5rem, 12vw, 11.5rem); letter-spacing: -0.045em; line-height: 0.72; }
  .hero h1 span { color: var(--gold); }
  .hero h1 em { color: var(--red); font-family: Georgia, serif; font-weight: 400; }
  .hero__dek { max-width: 760px; margin: auto 0 0; font-family: var(--pc-font-sans); font-size: clamp(1.35rem, 2.3vw, 2.2rem); font-weight: 750; line-height: 1.2; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
  .hero__actions a { padding: 0.9rem 1.1rem; border: 1px solid var(--gold); color: var(--gold); font-size: 0.66rem; font-weight: 900; text-decoration: none; text-transform: uppercase; }
  .hero__actions a:first-child { background: var(--gold); color: var(--ink); }
  .hero__actions a:hover, .hero__actions a:focus-visible { background: var(--cream); border-color: var(--cream); color: var(--ink); }

  .hero__meter { position: relative; z-index: 1; display: grid; grid-template-rows: auto 1fr auto; gap: 1.4rem; padding: clamp(2rem, 5vw, 5rem); border-left: 2px solid var(--gold); }
  .hero__score { display: grid; }
  .hero__score > span { color: var(--gold); font-size: 0.64rem; font-weight: 900; letter-spacing: 0.11em; }
  .hero__score strong { font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(7rem, 15vw, 14rem); letter-spacing: -0.06em; line-height: 0.8; }
  .hero__score sup, .reading__top sup { font-size: 0.32em; vertical-align: top; }
  .hero__score b { justify-self: start; padding: 0.3rem 0.6rem; background: var(--red); font-size: 0.67rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .thermometer { position: relative; align-self: stretch; justify-self: center; width: 64px; min-height: 260px; border: 3px solid var(--cream); border-radius: 40px; background: rgba(255,255,255,0.05); overflow: hidden; }
  .thermometer::after { position: absolute; left: 50%; bottom: 9px; width: 44px; aspect-ratio: 1; border-radius: 50%; background: var(--red); content: ''; transform: translateX(-50%); }
  .thermometer span { position: absolute; inset: auto 15px 25px; height: var(--temperature); max-height: calc(100% - 40px); background: linear-gradient(var(--gold), var(--red)); border-radius: 20px; }
  .hero__meter-note { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: rgba(243, 237, 218, 0.72); font-size: 0.56rem; font-weight: 800; line-height: 1.35; }
  .hero__boundary { position: absolute; right: 1rem; bottom: 1rem; z-index: 2; margin: 0; color: rgba(243, 237, 218, 0.58); font-size: 0.48rem; letter-spacing: 0.08em; }

  .opening { position: relative; display: grid; grid-template-columns: 160px minmax(0, 0.85fr) minmax(300px, 0.7fr); gap: clamp(2rem, 5vw, 5rem); padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 5vw, 5rem); border-bottom: 3px solid var(--ink); }
  .opening > .section-index { writing-mode: vertical-rl; }
  .opening__headline h2, .section-head h2, .split h2, .timeline h2, .finebaum h2, .sources h2 { margin: 0; font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(4rem, 8vw, 8.5rem); letter-spacing: -0.06em; line-height: 0.78; text-transform: uppercase; }
  .opening__headline h2 em, .section-head h2 em, .split h2 em, .timeline h2 em, .sources h2 em { color: var(--purple); font-family: Georgia, serif; font-weight: 400; }
  .opening__headline > p { max-width: 780px; margin: 3rem 0 0; font-family: var(--pc-font-sans); font-size: clamp(1.4rem, 2.1vw, 2rem); font-weight: 750; line-height: 1.28; }
  .opening__columns { display: grid; gap: 1.6rem; align-content: start; padding-top: 1rem; }
  .opening__columns p { margin: 0; font-family: var(--pc-font-sans); font-size: 1rem; line-height: 1.65; }
  .opening__receipt { grid-column: 2 / -1; display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: end; padding: 1.4rem; border: 2px solid var(--ink); background: var(--gold); }
  .opening__receipt span, .opening__receipt small { font-size: 0.58rem; font-weight: 900; letter-spacing: 0.1em; }
  .opening__receipt strong { font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(2rem, 4vw, 4rem); line-height: 0.9; text-transform: uppercase; }

  .readings { padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 4rem); background: #e7dfc8; border-bottom: 4px solid var(--ink); }
  .section-head { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 3rem; align-items: end; margin-bottom: 4rem; }
  .section-head .section-index { margin-bottom: 1rem; }
  .section-head > p { max-width: 580px; margin: 0; font-family: var(--pc-font-sans); font-size: 1rem; line-height: 1.6; }
  .reading-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid var(--ink); }
  .reading { display: flex; flex-direction: column; min-height: 520px; padding: clamp(1.4rem, 3vw, 2.6rem); border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--cream); }
  .reading:nth-child(2n) { border-right: 0; }
  .reading:nth-last-child(-n+2) { border-bottom: 0; }
  .reading--boiling { --reading-color: var(--red); }
  .reading--hot { --reading-color: var(--gold); }
  .reading--watch { --reading-color: var(--blue); }
  .reading__top { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .reading__top span { padding: 0.35rem 0.5rem; background: var(--reading-color); font-size: 0.58rem; font-weight: 900; letter-spacing: 0.08em; }
  .reading__top strong { font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(4rem, 8vw, 7.5rem); letter-spacing: -0.05em; line-height: 0.8; }
  .reading__bar { height: 10px; margin: 1rem 0 2.5rem; background: rgba(23, 18, 31, 0.12); }
  .reading__bar i { display: block; width: var(--temperature); height: 100%; background: var(--reading-color); }
  .reading h3 { max-width: 680px; margin: 0; font-family: var(--pc-font-sans); font-size: clamp(1.6rem, 2.6vw, 2.6rem); line-height: 1.05; }
  .reading > p { max-width: 700px; margin: 1.4rem 0; font-family: var(--pc-font-sans); line-height: 1.6; }
  .reading blockquote { margin: auto 0 0; padding: 1rem 0 0; border-top: 1px solid var(--ink); font-family: Georgia, serif; font-size: 1.05rem; font-style: italic; line-height: 1.45; }
  .reading__sources { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }
  .reading__sources a { font-size: 0.54rem; font-weight: 900; text-transform: uppercase; }

  .split { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 4px solid var(--ink); color: var(--cream); }
