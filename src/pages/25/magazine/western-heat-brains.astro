---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  BRAINS_DIALS,
  BRAINS_POWER_25,
  BRAINS_SCOREBOARD,
  BRAINS_SOURCES,
  BRAINS_WESTERN_SCOUTING,
  WESTERN_HEAT_BRAINS_FEATURE,
  WESTERN_HEAT_PROGRAMS,
  WESTERN_HEAT_SOURCES,
  brainsSource,
} from '../../../lib/pointcast-western-heat-brains';

const feature = WESTERN_HEAT_BRAINS_FEATURE;
const citations = [...WESTERN_HEAT_SOURCES, ...BRAINS_SOURCES].map((source) => source[3]);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: feature.title,
      alternativeHeadline: feature.subtitle,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        issueNumber: feature.issue,
        name: 'PointCast College Football — Special Double Issue 002',
        url: feature.canonical,
      },
      about: [
        'Colorado Buffaloes football',
        'Arizona State Sun Devils football',
        'Wyoming Cowboys football',
        'higher education research and development',
        'student engineering competitions',
        '2026 college football season',
      ],
      citation: citations,
    },
    {
      '@type': 'ItemList',
      name: 'Brains Power 25 — FY2024 university research expenditure',
      numberOfItems: BRAINS_POWER_25.length,
      itemListElement: BRAINS_POWER_25.map(([rank, institution, , amount]) => ({
        '@type': 'ListItem',
        position: rank,
        name: institution,
        description: `$${(amount / 1000).toFixed(3)} billion in FY2024 R&D expenditure`,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#ff5a23"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/western-heat-brains.json',
      title: 'Western Heat / Brains 25 structured double issue',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="double-issue">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · SPECIAL DOUBLE ISSUE 002</span>
      <nav aria-label="Double issue navigation">
        <a href="#western">WESTERN HEAT</a>
        <a href="#brains">BRAINS 25</a>
        <a href="/25/magazine">MAGAZINE</a>
        <a href="/25/magazine/western-heat-brains.json">JSON ↗</a>
      </nav>
    </header>

    <section class="cover" aria-labelledby="double-title">
      <img
        src={feature.heroImage}
        alt="Abstract split landscape moving from orange Western terrain into a midnight research ecology of botanical and orbital forms"
        width="1731"
        height="909"
        fetchpriority="high"
      />
      <div class="cover__veil" aria-hidden="true"></div>
      <div class="cover__copy">
        <p>POINTCAST MAGAZINE · AUGUST 8, 2026</p>
        <h1 id="double-title"><span>WESTERN<br />HEAT</span><em>/</em><span>BRAINS<br />25</span></h1>
        <blockquote>“{feature.subtitle}”</blockquote>
      </div>
      <div class="cover__ledger" aria-label="Double issue contents">
        <span><b>03</b> football programs</span>
        <span><b>25</b> research machines</span>
        <span><b>05</b> results under pressure</span>
      </div>
      <p class="art-credit">ORIGINAL ABSTRACT EDITORIAL ART · NOT DOCUMENTARY PHOTOGRAPHY OR OFFICIAL SCHOOL MARKS</p>
    </section>

    <nav class="issue-switch" aria-label="Open a side of the double issue">
      <span>OPEN THE DOUBLE ISSUE</span>
      <a href="#western">01 · WESTERN HEAT</a>
      <a href="#brains">25 · BRAINS 25</a>
    </nav>

    <section class="western" id="western" aria-labelledby="western-title">
      <header class="edition-head edition-head--western">
        <div>
          <p class="eyebrow">01 / COLLEGE FOOTBALL · PRESEASON 2026</p>
          <h2 id="western-title">What is<br />football <em>for?</em></h2>
        </div>
        <p>Tempe compresses a metropolis. Boulder converts attention. Laramie renews a state’s invitation home.</p>
      </header>

      <figure class="field-plate field-plate--western">
        <img
          src={feature.westernImage}
          alt="Abstract cut-paper Western landscape combining Sonoran thermal waves, cobalt alpine forms, and Wyoming high plains"
          width="1536"
          height="1024"
          loading="eager"
        />
        <figcaption>THE WESTERN FIELD · SONORAN HEAT / FRONT RANGE ALTITUDE / HIGH-PLAINS EXPOSURE</figcaption>
      </figure>

      <div class="heat-board" aria-label="Western Heat Index programs">
        {WESTERN_HEAT_PROGRAMS.map((program) => (
          <a class={`heat-card heat-card--${program.id}`} href={`#heat-${program.id}`}>
            <p>{program.order} · {program.status}</p>
            <strong>{program.temperature}°</strong>
            <h3>{program.school}</h3>
            <small>{program.record}</small>
            <span>{program.question}</span>
          </a>
        ))}
      </div>

      <section class="western-lede" aria-labelledby="western-lede-title">
        <p class="section-label">THE QUESTION BENEATH THE RECORD</p>
        <div>
          <h3 id="western-lede-title">Three neighbors.<br />Three different jobs.</h3>
          <p class="lead">Tempe is hot enough to reorganize a day. Boulder is high enough to make a visitor notice the second quarter. Laramie puts 7,220 on the stadium because the number is not trivia; it is the premise.</p>
          <p>Arizona State and Colorado live in the Big 12, a conference whose map treats proximity as a suggestion. Wyoming enters a rebuilt Mountain West. The three campuses recruit some of the same families, share roads and weather systems, and offer almost opposite answers to the same question.</p>
          <p>At Arizona State, football can make a vast metropolitan university feel like one place. At Colorado, it can turn national attention into a campus asset—if the attention survives the star cycle. At Wyoming, it can function as a state commons for the only four-year public university in Wyoming.</p>
          <blockquote>“The temperature is not weather. It is pressure, leverage, and what happens when the season changes the meaning of the school.”</blockquote>
        </div>
      </section>

      <div class="program-readouts">
        {WESTERN_HEAT_PROGRAMS.map((program) => (
          <article class={`program-readout program-readout--${program.id}`} id={`heat-${program.id}`}>
            <header>
              <p>{program.order} · {program.status}</p>
              <span>{program.temperature}°</span>
              <h3>{program.school}</h3>
              <strong>{program.thesis}</strong>
            </header>
            <dl>
              <div><dt>CASE</dt><dd>{program.case}</dd></div>
              <div><dt>DOUBT</dt><dd>{program.doubt}</dd></div>
              <div><dt>NEXT PROOF</dt><dd>{program.nextProof}</dd></div>
              <div><dt>WHAT IT DOES TO THE SCHOOL</dt><dd>{program.schoolEffect}</dd></div>
              <div><dt>MOVEMENT</dt><dd>{program.movement}</dd></div>
            </dl>
          </article>
        ))}
      </div>

      <section class="forecast" aria-labelledby="forecast-title">
        <div>
          <p class="section-label">THE 2026 WESTERN FORECAST</p>
          <h3 id="forecast-title">Best team.<br />Loudest construction site.<br />Most meaning per win.</h3>
        </div>
        <div class="forecast__copy">
          <p>Arizona State is the best football proposition today. Colorado is the most watched construction site. Wyoming carries the most meaning per win.</p>
          <p>ASU’s 2024 breakthrough turned into a sold-out 2025 opener, a record student crowd, and measurable visitor spending. Colorado sold out season tickets before a 3–9 season, then watched late-year crowds thin: attention is a lease, not an endowment. Wyoming’s offense struggled while the institution’s stakes grew; a study cited by UW estimates all athletics—not football alone—at $206.4 million in average annual statewide economic impact.</p>
          <blockquote>If the football team vanished tomorrow, what part of the university would become harder to explain?</blockquote>
          <p>At ASU, the Valley loses a shared Saturday. At Colorado, the campus loses its loudest national door. At Wyoming, an entire state loses one of its most dependable invitations home.</p>
        </div>
      </section>

      <details class="sources sources--western">
        <summary>FOOTBALL RECEIPTS · CHECKED AUGUST 8, 2026</summary>
        <ul>
          {WESTERN_HEAT_SOURCES.map(([, label, outlet, url]) => (
            <li><a href={url}>{label}</a><span>{outlet}</span></li>
          ))}
        </ul>
      </details>
    </section>

    <section class="brains" id="brains" aria-labelledby="brains-title">
      <header class="edition-head edition-head--brains">
        <div>
          <p class="eyebrow">25 / SCIENCE + UNIVERSITIES · SCOREBOARD 001</p>
          <h2 id="brains-title">Power is<br /><em>not proof.</em></h2>
        </div>
        <p>Money is the roster sheet. Missions, prototypes, papers, deployments, and student competitions are the games.</p>
      </header>

      <figure class="field-plate field-plate--brains">
        <img
          src={feature.brainsImage}
          alt="Abstract midnight research ecosystem of roots, circuits, orbital rings, lunar dust, cells, and ocean currents"
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>THE BRAINS FIELD · ROOT SYSTEMS / QUANTUM CLOCKS / LUNAR DUST / PUBLIC PROOF</figcaption>
      </figure>

      <section class="brains-lede" aria-labelledby="brains-lede-title">
        <p class="section-label">A SPORTS DESK FOR AMERICAN RESEARCH</p>
        <div>
          <h3 id="brains-lede-title">They are already playing.<br />The scoreboard is late.</h3>
          <p class="lead">College football has a complete language for collective excellence: rankings, rivalry games, recruiting classes, breakout freshmen, coaching trees, film rooms, facilities races, strength of schedule, game control, and one beautiful corrective—eventually, somebody has to play.</p>
          <p>American science has almost all of those things. It simply presents them as separate websites. A university can announce a billion dollars in research and never tell the public what happened on Tuesday. A student team can build the best lunar robot in the country and disappear into a departmental news release.</p>
          <blockquote>Brains 25 gives research a sports desk without turning truth into sports entertainment.</blockquote>
          <p>Three boards stay separate: the Power 25 for audited resources; the Saturday Scoreboard for verified results; and an editorial ballot built from case, doubt, next proof, and movement. Money is not discovery. A press release is not replication. A Nobel Prize is not an undergraduate experience.</p>
        </div>
      </section>

      <section class="power" aria-labelledby="power-title">
        <header>
          <p class="section-label">NSF / NCSES · FY2024 · PUBLISHED FEBRUARY 2026</p>
          <h3 id="power-title">The Power 25</h3>
          <p>U.S. universities reported $117.7 billion in R&D expenditure. The official top 25 below measures the size of each research machine—not who won today.</p>
        </header>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Rank</th><th>Institution</th><th>Reading</th><th>FY24 R&amp;D</th></tr></thead>
            <tbody>
              {BRAINS_POWER_25.map(([rank, institution, reading, amount]) => (
                <tr><td>{rank}</td><td>{institution}</td><td>{reading}</td><td>${(amount / 1000).toFixed(3)}B</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">Johns Hopkins includes the Applied Physics Laboratory. Maryland combines Baltimore and College Park in this survey. Twenty-eight of the top 30 institutions had medical schools. Scale is real; comparison still requires context.</p>
      </section>

      <section class="scoreboard" aria-labelledby="scoreboard-title">
        <header>
          <p class="section-label">CATEGORY OF THE DAY · SYSTEMS UNDER PRESSURE</p>
          <h3 id="scoreboard-title">What worked<br />outside the lab?</h3>
          <p>These are separate competitions, not one invented national championship. What unites them is contact with a real test.</p>
        </header>
        <div class="score-grid">
          {BRAINS_SCOREBOARD.map((item) => (
            <article>
              <span>{String(item.rank).padStart(2, '0')}</span>
              <h4>{item.school}</h4>
              <strong>{item.result}</strong>
              <p>{item.read}</p>
              <small>STAR · {item.star}</small>
              <a href={brainsSource(item.sourceId).url}>OFFICIAL RESULT ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="stars" aria-labelledby="stars-title">
        <header>
          <p class="section-label">THE STARS DESK</p>
          <h3 id="stars-title">Name the people.<br />Keep the team visible.</h3>
        </header>
        <div>
          <article><small>JOHNS HOPKINS APL</small><h4>The team that touches the Sun</h4><p>In June, Parker Solar Probe completed its 28th close pass, again reaching about 3.8 million miles from the solar surface. Project scientist <b>Nour Rawafi</b> and mission systems engineer <b>John Wirzburger</b> help make a mission visible without pretending one person built it.</p><a href={brainsSource('parker').url}>NASA RECEIPT ↗</a></article>
          <article><small>ARIZONA STATE</small><h4>A university flying toward 2029</h4><p><b>Lindy Elkins-Tanton</b> is principal investigator of NASA’s Psyche mission, led from ASU. The long cruise turns science into a season: calibration, operations, student work, and public explanation before arrival.</p><a href={brainsSource('psyche').url}>NASA RECEIPT ↗</a></article>
          <article><small>COLORADO</small><h4>Quantum as a contact sport</h4><p><b>Adam Kaufman</b>, <b>Anya Grafov</b>, and the larger JILA/NIST ecosystem make institutional boundaries productive. The next proof is translation: which systems become reliable, useful, and legible beyond one celebrated lab?</p><a href={brainsSource('colorado-quantum').url}>CU RECEIPT ↗</a></article>
          <article><small>WYOMING</small><h4>Small denominator, real acceleration</h4><p><b>Thomas Boothby</b> studies extreme survival and rural public value. <b>Lily Brongo</b> studies navigation under stress. At Wyoming’s 2026 undergraduate research event, 273 students took the field.</p><a href={brainsSource('wyoming-students').url}>UW RECEIPT ↗</a></article>
        </div>
      </section>

      <section class="western-scouting" aria-labelledby="scouting-title">
        <header>
          <p class="section-label">TWO-WAY PROGRAMS · FOOTBALL / RESEARCH</p>
          <h3 id="scouting-title">The same university<br />changes shape.</h3>
        </header>
        <div>
          {BRAINS_WESTERN_SCOUTING.map((entry) => (
            <article>
              <span>#{entry.rank} · {entry.amount}</span>
              <h4>{entry.school}</h4>
              <p>{entry.proof}</p>
              <small>PEOPLE TO KNOW · {entry.stars}</small>
            </article>
          ))}
        </div>
      </section>

      <section class="method" aria-labelledby="method-title">
        <article>
          <p class="section-label">THE POINTCAST CONTRACT</p>
          <h3 id="method-title">Case.<br />Doubt.<br />Next proof.<br /><em>Movement.</em></h3>
          <p>A paper is not a touchdown and a university is not a team. The useful borrowing is not hype; it is legibility, recurrence, and memory.</p>
          <p>Every ranked entry gets a strongest current case, an honest doubt, an observable next proof, and an exact change from the previous edition. Category standings keep a giant medical center from swallowing the whole sport.</p>
        </article>
        <ol>
          {BRAINS_DIALS.map(([number, name, description]) => (
            <li><b>{number} · {name}</b><span>{description}</span></li>
          ))}
        </ol>
      </section>

      <details class="sources sources--brains">
        <summary>SCIENCE RECEIPTS · CHECKED AUGUST 8, 2026</summary>
        <ul>
          {BRAINS_SOURCES.map(([, label, outlet, url]) => (
            <li><a href={url}>{label}</a><span>{outlet}</span></li>
          ))}
        </ul>
      </details>
    </section>

    <section class="close" aria-labelledby="close-title">
      <p>SPECIAL DOUBLE ISSUE 002 · THE POINTCAST READ</p>
      <h2 id="close-title">A Saturday can make<br />a university <em>legible.</em></h2>
      <blockquote>“At ASU, the Valley gets one clock. At Colorado, attention gets a destination. At Wyoming, a state gets an invitation home. In Brains 25, the same campuses have to show what worked on Tuesday.”</blockquote>
      <div><a href="/25/magazine">RETURN TO THE MAGAZINE ↗</a><a href="/25">OPEN THE POINTCAST 25 ↗</a><a href="/b/0568">READ BLOCK 0568 ↗</a></div>
      <small>{feature.boundary}</small>
    </section>

    <SeasonTicket25 surface="western-heat-brains" />
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #eee6d4; }
  .double-issue { --ink: #11120f; --paper: #eee6d4; --white: #fffdf5; --orange: #ff5a23; --gold: #ffc643; --blue: #2439d8; --night: #09101e; --lab: #b7ff4a; --violet: #9a75ff; color: var(--ink); background: var(--paper); font-family: Georgia, 'Times New Roman', serif; overflow: clip; }
  .double-issue * { box-sizing: border-box; }
  .double-issue a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .mast { position: sticky; top: 0; z-index: 20; min-height: 64px; padding: 12px clamp(16px, 3vw, 46px); border-bottom: 2px solid; background: rgba(238,230,212,.95); backdrop-filter: blur(14px); display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; font-family: Arial, sans-serif; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .mast > a { font-family: Georgia, serif; font-size: 25px; letter-spacing: -.05em; text-transform: none; text-decoration: none; }
  .mast > span { text-align: center; }
  .mast nav { display: flex; gap: 16px; }
  .cover { position: relative; min-height: calc(100svh - 64px); background: var(--night); color: var(--white); border-bottom: 2px solid var(--ink); overflow: hidden; }
  .cover > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .cover__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,11,8,.18), rgba(12,11,8,.05) 48%, rgba(9,16,30,.14)), linear-gradient(0deg, rgba(5,5,4,.78), transparent 55%); }
  .cover__copy { position: absolute; inset: clamp(28px, 5vw, 72px); z-index: 2; display: flex; flex-direction: column; justify-content: space-between; }
  .cover__copy > p, .eyebrow, .section-label { margin: 0; font-family: Arial, sans-serif; font-size: 11px; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
  .cover h1 { margin: auto 0 28px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: end; gap: clamp(15px, 3vw, 50px); font-size: clamp(62px, 8vw, 136px); line-height: .72; letter-spacing: -.085em; text-shadow: 0 4px 24px rgba(0,0,0,.35); }
  .cover h1 span:last-child { color: var(--lab); text-align: right; }
  .cover h1 em { color: var(--gold); font-size: .55em; font-style: normal; }
  .cover blockquote { margin: 0; max-width: 870px; font-size: clamp(21px, 2.8vw, 43px); font-weight: 800; line-height: 1; }
  .cover__ledger { position: absolute; z-index: 3; right: clamp(20px, 4vw, 64px); bottom: 36px; display: flex; border: 2px solid var(--white); background: rgba(9,16,30,.84); }
  .cover__ledger span { padding: 13px 18px; border-right: 1px solid; font-family: Arial, sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; }
  .cover__ledger span:last-child { border: 0; }
  .cover__ledger b { display: block; color: var(--lab); font-family: Georgia, serif; font-size: 30px; }
  .art-credit { position: absolute; z-index: 3; left: clamp(20px, 4vw, 64px); bottom: 10px; margin: 0; font-family: Arial, sans-serif; font-size: 8px; letter-spacing: .1em; }
  .issue-switch { position: sticky; top: 64px; z-index: 15; padding: 15px clamp(16px, 4vw, 64px); border-bottom: 2px solid; background: var(--white); display: flex; align-items: center; gap: 12px; font-family: Arial, sans-serif; font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .issue-switch span { margin-right: auto; }
  .issue-switch a { padding: 9px 13px; border: 2px solid; text-decoration: none; }
  .edition-head { min-height: 72vh; padding: clamp(58px, 9vw, 130px) clamp(18px, 7vw, 110px); display: grid; grid-template-columns: 1.4fr .6fr; gap: clamp(40px, 8vw, 130px); align-items: end; }
  .edition-head h2 { margin: 14px 0 0; font-size: clamp(70px, 12vw, 190px); line-height: .72; letter-spacing: -.08em; }
  .edition-head h2 em { color: var(--orange); }
  .edition-head > p { margin: 0; font-size: clamp(24px, 3vw, 44px); font-weight: 800; line-height: 1; }
  .edition-head--brains { color: var(--white); background: var(--night); }
  .edition-head--brains h2 em, .edition-head--brains .eyebrow { color: var(--lab); }
  .field-plate { position: relative; margin: 0; height: min(78vw, 880px); border-block: 2px solid currentColor; overflow: hidden; }
  .field-plate img { width: 100%; height: 100%; object-fit: cover; }
  .field-plate figcaption { position: absolute; left: 18px; bottom: 18px; padding: 8px 10px; color: var(--white); background: rgba(9,16,30,.86); font-family: Arial, sans-serif; font-size: 9px; font-weight: 800; letter-spacing: .1em; }
  .heat-board { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 2px solid; }
  .heat-card { min-height: 470px; padding: clamp(25px, 3.5vw, 54px); border-right: 2px solid; display: flex; flex-direction: column; text-decoration: none; transition: color .16s ease, background .16s ease; }
  .heat-card:last-child { border-right: 0; }
  .heat-card > p, .heat-card > small { font-family: Arial, sans-serif; font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .heat-card > strong { margin: 45px 0 30px; font-family: 'Courier New', monospace; font-size: clamp(78px, 9vw, 135px); letter-spacing: -.09em; line-height: .75; }
  .heat-card h3 { margin: 0; font-size: clamp(36px, 4.5vw, 66px); line-height: .86; letter-spacing: -.055em; }
  .heat-card > span { margin-top: auto; padding-top: 35px; font-size: 22px; font-weight: 800; line-height: 1.05; }
  .heat-card--colorado:hover { color: var(--white); background: var(--orange); }
  .heat-card--arizona-state:hover { background: var(--gold); }
  .heat-card--wyoming:hover { color: var(--white); background: var(--blue); }
  .western-lede, .brains-lede { padding: clamp(70px, 10vw, 150px) clamp(18px, 8vw, 130px); display: grid; grid-template-columns: .45fr 1.25fr; gap: clamp(40px, 8vw, 130px); }
  .western-lede > div, .brains-lede > div { max-width: 920px; }
  .western-lede h3, .brains-lede h3, .forecast h3, .power h3, .scoreboard h3, .stars h3, .western-scouting h3, .method h3 { margin: 0 0 30px; font-size: clamp(48px, 7.5vw, 115px); line-height: .83; letter-spacing: -.06em; }
  .western-lede p, .brains-lede p, .forecast__copy p, .method p { font-size: clamp(19px, 1.65vw, 25px); }
  .western-lede .lead, .brains-lede .lead { font-size: clamp(27px, 3.2vw, 47px); font-weight: 800; line-height: 1.02; }
  .western-lede blockquote, .brains-lede blockquote, .forecast blockquote { margin: 50px 0; font-size: clamp(32px, 4.4vw, 68px); font-weight: 900; line-height: .95; letter-spacing: -.04em; }
  .program-readouts { border-top: 2px solid; }
