  .machine>header .section-label { grid-column:1/-1; }
  .machine>header>p:last-child { font:21px/1.45 Georgia,serif; }
  .machine__grid { display:grid; grid-template-columns:repeat(2,1fr); border-top:2px solid #171511; }
  .machine__grid article { min-height:420px; padding:32px; border-bottom:1px solid #171511; border-right:1px solid #171511; }
  .machine__grid article:nth-child(even) { border-right:0; }
  .machine__grid article:last-child { grid-column:1/-1; min-height:330px; }
  .machine__grid article>div { display:flex; justify-content:space-between; font:800 10px/1 Arial,sans-serif; letter-spacing:.13em; }
