---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  GEORGIA_2026_LEDGER,
  GEORGIA_GROUND_ZERO_FEATURE,
  GEORGIA_GROUND_ZERO_READOUT,
  GEORGIA_GROUND_ZERO_SOURCES,
  GEORGIA_HEDGES_TEST,
  GEORGIA_MACHINE_INPUTS,
  georgiaGroundZeroSource,
} from '../../../lib/pointcast-georgia-ground-zero';

const feature = GEORGIA_GROUND_ZERO_FEATURE;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: `${feature.title} — ${feature.subtitle}`,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        name: "PointCast College Football — Issue 001: Talkin' Season",
        url: 'https://pointcast.xyz/25/magazine',
      },
      about: [
        'University of Georgia',
        'Georgia Bulldogs football',
        'Athens, Georgia',
        'Kirby Smart',
        '2026 college football season',
        'college student experience',
      ],
      citation: GEORGIA_GROUND_ZERO_SOURCES.map((source) => source.url),
    },
    {
      '@type': 'ItemList',
      name: 'The Hedges Test — seven questions for keeping college football human',
      numberOfItems: GEORGIA_HEDGES_TEST.length,
      itemListElement: GEORGIA_HEDGES_TEST.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.question,
        description: item.read,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#b4232f"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/georgia-ground-zero.json',
      title: 'Georgia, Ground Zero structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="georgia">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · PROGRAM DESK 001</span>
      <nav aria-label="Georgia Ground Zero navigation">
        <a href="/25">THE 25</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href="/25/magazine/georgia-ground-zero.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="georgia-title">
      <img
        src="/images/pointcast-georgia-ground-zero/the-machine-and-the-bell.webp"
        alt="Editorial collage of a vast night football stadium embedded in a campus town, with students, a band, buses, practice rooms, a chapel bell, and a worker setting a barricade before sunrise"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="hero__copy">
        <p>FIELD REPORT · ATHENS, GEORGIA · {feature.asOf}</p>
        <h1 id="georgia-title"><span>GEORGIA,</span><br />GROUND<br /><em>ZERO.</em></h1>
        <p class="hero__dek">{feature.dek}</p>
        <a href="#the-scene">Enter before sunrise ↓</a>
      </div>
      <p class="hero__credit">THE MACHINE AND THE BELL · ORIGINAL POINTCAST EDITORIAL ART · NOT DOCUMENTARY PHOTOGRAPHY</p>
    </section>

    <section class="opening" id="the-scene" aria-labelledby="opening-title">
      <p class="section-label">00 / BEFORE THE RED ARRIVES</p>
      <div class="opening__headline">
        <h2 id="opening-title">Ground zero<br />starts in the <em>dark.</em></h2>
        <p>
          Nearly two hours before sunrise, before the red dresses and black polos,
          before the first television hit, UGA Police commanders install hydraulic
          traffic barricades around Sanford Stadium. Two miles away, bus drivers
          begin their first runs. The command room will eventually watch more than
          fifty screens. Custodians, grounds crews, dining staff, medical teams,
          officers, drivers, and outside agencies will turn a normal college town
          into a one-day city for more than 93,000 people.
          <a href={georgiaGroundZeroSource('gameday-workers').url}>That is UGA’s own account.</a>
        </p>
      </div>
      <div class="opening__body">
        <p class="lead">
          It is tempting to begin Georgia football with Kirby Smart, a blue-chip
          depth chart, or the hedges. The more revealing opening is a worker in a
          reflective vest setting a barrier in the dark. The spectacle depends on
          a system. The system depends on people the broadcast rarely names.
        </p>
        <p>
          Georgia is college football’s ground zero because almost every force
          reorganizing the sport is unusually concentrated here: a state thick
          with players, an institution with immense recurring capital, a coach who
          has made development reproducible, an NFL pipeline recruits can see, a
          national-title standard, a city whose scale lets the university and the
          town occupy the same Saturday, and a fan base large enough to make the
          whole thing feel civic.
        </p>
        <p>
          It is also ground zero for the harder question. When college football
          becomes this capable—when rosters, revenue sharing, acquisition,
          facilities, security, content, hospitality, and expectation all become
          professional—what keeps it from becoming only a professional operation
          wearing a university’s old clothes?
        </p>
      </div>
      <aside class="opening__thesis">
        <span>THE POINTCAST READ</span>
        <blockquote>“{feature.thesis}”</blockquote>
      </aside>
    </section>

    <section class="readout" aria-label="Georgia Ground Zero readout">
      {GEORGIA_GROUND_ZERO_READOUT.map((fact) => (
        <article>
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
          <p>{fact.note}</p>
          <a href={georgiaGroundZeroSource(fact.sourceId).url}>RECEIPT ↗</a>
        </article>
      ))}
    </section>

    <section class="machine" aria-labelledby="machine-title">
      <header>
        <p class="section-label">01 / HOW THE MACHINE WORKS</p>
        <h2 id="machine-title">Five inputs.<br /><em>No alibi.</em></h2>
        <p>
          The word “machine” can flatten the achievement into cash and recruiting.
          Georgia’s real advantage is that five systems reinforce one another.
          Remove any one and the room becomes merely expensive.
        </p>
      </header>
      <div class="machine__grid">
        {GEORGIA_MACHINE_INPUTS.map((input) => (
          <article>
            <div><span>{input.number}</span><b>{input.name}</b></div>
            <h3>{input.title}</h3>
            <p>{input.body}</p>
            <p class="receipts">
              {input.sourceIds.map((sourceId, index) => (
                <>
                  {index > 0 && ' · '}
                  <a href={georgiaGroundZeroSource(sourceId).url}>{georgiaGroundZeroSource(sourceId).outlet} ↗</a>
                </>
              ))}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="season" aria-labelledby="season-title">
      <div class="season__copy">
        <p class="section-label">02 / THE 2026 AUDIT</p>
        <h2 id="season-title">Can the system<br />replace its own <em>memory?</em></h2>
        <p>
          Georgia enters 2026 as the winner of consecutive SEC championships and
          the loser of a 39–34 CFP quarterfinal to Ole Miss. That is the Georgia
          condition now: a 12–2 season can be both proof of the standard and a live
          source of irritation.
        </p>
        <p>
          The useful complication is experience. In March, Smart called this the
          fewest returning starters Georgia has had in his tenure. In August, he
          described a healthy camp group of roughly 125 to 127 players while the
          operating roster moves toward the new post-settlement limit. The mandate
          remains old-fashioned—run the ball, stop the run—while the desired gains
          are modern and measurable: explosive plays, havoc, turnovers.
        </p>
        <p>
          This is why 2026 matters beyond Georgia. If the Bulldogs are excellent
          again, the season will validate something more durable than one recruiting
          class. It will suggest that the institution has learned how to teach its
          own standard. If the room wobbles, the problem will not be a missing input.
          It will be the human difficulty of turning a fresh group into shared memory.
        </p>
        <p class="receipts">
          <a href={georgiaGroundZeroSource('spring').url}>Spring practice ↗</a> ·
          <a href={georgiaGroundZeroSource('fall-camp').url}>Fall camp ↗</a> ·
          <a href={georgiaGroundZeroSource('season-close').url}>2025 close ↗</a>
        </p>
      </div>
      <div class="season__board">
        <header><span>THE EIGHT-GAME SPINE</span><b>2026 · OFFICIAL SCHEDULE</b></header>
        {GEORGIA_2026_LEDGER.map((game) => (
          <a href={georgiaGroundZeroSource('schedule').url}>
            <time>{game.date}</time>
            <strong>{game.opponent}</strong>
            <span>{game.place}</span>
            <em>{game.read}</em>
          </a>
        ))}
      </div>
    </section>

    <section class="student" aria-labelledby="student-title">
      <div class="student__label">
        <span>03</span>
        <p>THE STUDENT<br />IS NOT SET DRESSING</p>
      </div>
      <div class="student__copy">
        <h2 id="student-title">The cheapest seat<br />carries the most <em>meaning.</em></h2>
        <p class="lead">
          A Georgia student is simultaneously the most essential participant in
          the Saturday story and one of its most tightly administered customers.
        </p>
        <p>
          The 2026 full home package is a remarkable $80 for seven games. That is
          real access. It is also conditional: if demand exceeds supply, students
          can be assigned a three-game red package or four-game black package by a
          priority lottery. One unused ticket produces a strike; two strikes remove
          postseason eligibility. Tickets cannot transfer directly between
          students. Away prices run from $140 for Florida to $265 for Alabama.
          Entry is digital, seating is general admission except organization blocks,
          and re-entry is not allowed.
        </p>
        <p>
          Each rule has an operational logic. Together they reveal the tension.
          Students generate the sound, continuity, youth, risk, handmade dress,
          remembered friendships, and future alumni demand that make the television
          product valuable. Yet the more valuable the product becomes, the more
          managed their presence can feel.
        </p>
        <p>
          The non-machine move is not nostalgia for paper tickets. It is a firm
          design priority: treat student access as part of the competitive and
          cultural infrastructure, not as inventory left after every other revenue
          decision. A full student section is not a discount. It is the part of the
          program that still knows tomorrow’s exam exists.
        </p>
        <a class="source-button" href={georgiaGroundZeroSource('student-tickets').url}>READ THE 2026 STUDENT TICKET RULES ↗</a>
      </div>
      <aside class="student__ticket">
        <p>STUDENT HOME PACKAGE</p>
        <strong>$80</strong>
        <span>7 GAMES · SUBJECT TO DEMAND + PRIORITY</span>
        <hr />
        <p>ALABAMA AWAY</p>
        <strong>$265</strong>
        <span>1 TICKET · SUBJECT TO AVAILABILITY</span>
        <small>ONE UNUSED TICKET = ONE STRIKE<br />TWO STRIKES = NO POSTSEASON ELIGIBILITY</small>
      </aside>
    </section>

    <section class="town" aria-labelledby="town-title">
      <div class="town__image">
        <img
          src="/images/pointcast-georgia-ground-zero/the-machine-and-the-bell.webp"
          alt="Detail of students, a marching band, chapel bell, stadium, and downtown rooms in the original PointCast editorial collage"
          width="1536"
          height="1024"
          loading="lazy"
        />
      </div>
      <div class="town__copy">
        <p class="section-label">04 / WHY ATHENS MATTERS</p>
        <h2 id="town-title">A football city<br />with another <em>frequency.</em></h2>
        <p>
          Athens keeps Georgia from feeling like a football industrial park. Sanford
          is not a remote bowl surrounded by parking geometry; it sits inside a
          campus, beside a town, near classrooms, bars, porches, churches, shops,
          studios, and stages. A person can feel the day change on foot.
        </p>
        <p>
          The city’s music history matters because it proves the place can produce
          a national signal without a central office ordering it into existence.
          R.E.M. and the B-52s are the famous names, but the useful inheritance is
          the method: students, cheap rooms, local collaborators, experiments, and
          enough friction to make a scene. Football’s scale should not erase that
          ecology. It should learn from it.
        </p>
        <p>
          A good Georgia Saturday therefore has two economies. One is optimized:
          tickets, transit, safety, broadcast windows, donor hospitality, roster
          operations. The other is porous: the person who walks downtown, the band
          heard from a side street, the breakfast shift, the house gathering, the
          student who stays for a local show, the vendor whose best customer returns
          in February. The first economy makes the event work. The second makes it
          belong somewhere.
        </p>
        <p class="receipts">
          <a href={georgiaGroundZeroSource('sanford').url}>Sanford Stadium ↗</a> ·
          <a href={georgiaGroundZeroSource('athens-music').url}>Athens music ↗</a> ·
          <a href={georgiaGroundZeroSource('gameday-workers').url}>Game-day workers ↗</a>
        </p>
      </div>
    </section>

    <section class="modern" aria-labelledby="modern-title">
      <p class="section-label">05 / THE MODERN COLLEGE EXPERIENCE</p>
      <div class="modern__headline">
        <h2 id="modern-title">Professional inputs.<br />University <em>obligations.</em></h2>
        <p>
          The old amateur story was never an honest description of the labor or the
          money. The post-House era permits direct institutional benefits to athletes,
          replaces scholarship limits with roster limits at participating schools,
          and makes the financial operating system more explicit. That is progress.
          It also removes the last excuse for treating care as accidental.
        </p>
      </div>
      <div class="modern__columns">
        <article>
          <span>THE PLAYER</span>
          <p>
            Compensation and elite development belong in the same sentence as health,
            education, time, agency, and exit options. “Student-athlete” should not be
            used to hide labor; “employee” should not be used to shrink a young person
            into one line of roster value.
          </p>
        </article>
        <article>
          <span>THE FAN</span>
          <p>
            Modern convenience is useful until every tradition becomes a funnel. The
            fan experience needs prices and spaces that allow the state to recognize
            itself, including people without donor history or a premium credential.
          </p>
        </article>
        <article>
          <span>THE UNIVERSITY</span>
          <p>
            Football can be a front porch, laboratory, employer, gathering ritual,
            and source of pride. It cannot become the institution’s only convincing
            public story. The academic bell has to remain audible through the lights.
          </p>
        </article>
        <article>
          <span>THE STATE</span>
          <p>
            Georgia high schools feed the sport’s national talent economy. The flagship
            obligation is larger than winning recruiting battles: respect the local
            coaches, families, schools, and communities that make the radius productive.
          </p>
        </article>
      </div>
      <p class="modern__source"><a href={georgiaGroundZeroSource('house-settlement').url}>NCAA · settlement implementation ↗</a></p>
    </section>

    <section class="test" aria-labelledby="test-title">
      <header>
        <p class="section-label">06 / HOW TO KEEP IT NON-MACHINE</p>
        <h2 id="test-title">The Hedges<br /><em>Test.</em></h2>
        <p>
          Seven questions for Georgia—and every program copying Georgia—to ask
          while the system is still capable of hearing the answer.
        </p>
      </header>
      <ol>
        {GEORGIA_HEDGES_TEST.map((item) => (
          <li>
            <span>{item.number}</span>
            <div>
              <h3>{item.question}</h3>
              <p>{item.read}</p>
            </div>
          </li>
        ))}
      </ol>
      <aside>
        <p>
          On August 20, 2026, women’s soccer—not football—is scheduled to stage
          the first public event in Sanford Stadium’s fall calendar, with Georgia
          marking the thirtieth anniversary of the 1996 Olympic gold-medal match.
          A football cathedral opening its gates to another team is a small decision
          with a large idea inside it: the building can belong to the university.
        </p>
        <a href={georgiaGroundZeroSource('fall-camp').url}>THE SANFORD SOCCER NOTE ↗</a>
      </aside>
    </section>

    <section class="close" aria-labelledby="close-title">
      <p class="section-label">07 / AFTER THE BELL</p>
      <h2 id="close-title">What Georgia<br />has to <em>protect.</em></h2>
      <div class="close__body">
        <p class="lead">
          Georgia does not need to become less serious about football. It needs to
          remain serious about everything football cannot manufacture.
        </p>
        <p>
          A machine can schedule the bus. It cannot make the ride a student remembers
          twenty years later. It can optimize a roster. It cannot decide whether a
          player felt known while he was on it. It can sell the room. It cannot make
          the town worth walking into. It can amplify the band. It cannot write the
          song that arrives from a basement nobody funded. It can count the crowd.
          It cannot explain why somebody rings the Chapel Bell for an academic win.
        </p>
        <p>
          That is the useful meaning of ground zero. Georgia is not merely where the
          modern sport looks most complete. It is where the argument about what the
          sport is for becomes hardest to avoid. The operation is already excellent.
          The next championship is maintaining a Saturday large enough for the worker,
          the player, the student, the fan, the town, the other team, the other sport,
          and the person who came to Athens for a reason football will never know.
        </p>
        <blockquote>THE MACHINE WORKS.<br />THE BELL STILL HAS TO RING.</blockquote>
      </div>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p class="section-label">SOURCE ROOM / OPEN RECEIPTS</p>
        <h2 id="sources-title">Reporting before mythology.</h2>
        <p>Primary and official-data sources lead. PointCast interpretation stays labeled as interpretation.</p>
      </header>
      <ol>
        {GEORGIA_GROUND_ZERO_SOURCES.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <small>{source.kind.toUpperCase()} · {source.outlet}</small>
              <a href={source.url}>{source.label} ↗</a>
              <p>{source.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <div>
        <p>{feature.byline}</p>
        <p>{feature.boundary}</p>
        <p>{feature.visualCredit}</p>
      </div>
      <nav aria-label="Next PointCast reads">
        <a href="/25/magazine">College Football Issue 001 ↗</a>
        <a href="/25/magazine/coaches-50#coach-2">Kirby Smart in The PointCast 50 ↗</a>
        <a href="/25/magazine/georgia-ground-zero.json">Machine-readable edition ↗</a>
        <a href="/b/0566">Permanent release Block ↗</a>
      </nav>
    </footer>
    <SeasonTicket25 />
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #efeadf; color: #171511; }
  :global(*) { box-sizing: border-box; }
  :global(a) { color: inherit; }
  .georgia { --red:#b4232f; --black:#171511; --paper:#efeadf; --bone:#f7f3e8; --green:#263f31; --gold:#d3a84c; background:var(--paper); font-family:Arial, Helvetica, sans-serif; overflow:hidden; }
  .mast { min-height:58px; padding:0 3vw; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; border-bottom:1px solid rgba(239,234,223,.3); background:#151511; color:var(--paper); font:700 11px/1.1 "Arial Narrow",Arial,sans-serif; letter-spacing:.12em; position:relative; z-index:5; }
  .mast>a { font-size:15px; text-decoration:none; letter-spacing:-.02em; }
  .mast nav { display:flex; justify-content:flex-end; gap:22px; }
  .mast nav a { text-decoration:none; }
  .hero { position:relative; min-height:calc(100svh - 58px); background:#111; color:#fff; display:flex; align-items:flex-end; }
  .hero>img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero__wash { position:absolute; inset:0; background:linear-gradient(90deg,rgba(13,12,10,.78) 0,rgba(13,12,10,.25) 48%,rgba(13,12,10,.08) 75%),linear-gradient(0deg,rgba(13,12,10,.74),transparent 55%); }
  .hero__copy { position:relative; z-index:2; width:min(760px,78vw); padding:7vw 4vw 7vw; }
  .hero__copy>p:first-child,.section-label { font:800 11px/1.1 "Arial Narrow",Arial,sans-serif; letter-spacing:.15em; text-transform:uppercase; }
  .hero h1 { margin:24px 0 22px; font:900 clamp(76px,13.2vw,210px)/.7 "Arial Narrow",Impact,Arial,sans-serif; letter-spacing:-.075em; text-transform:uppercase; }
  .hero h1 span { color:var(--paper); }
  .hero h1 em { color:#ff3848; font-style:normal; }
  .hero__dek { max-width:620px; font:600 clamp(18px,2.1vw,31px)/1.13 Georgia,serif; }
  .hero__copy>a { display:inline-block; margin-top:22px; border:1px solid #fff; padding:13px 17px; text-decoration:none; font:800 11px/1 Arial,sans-serif; letter-spacing:.1em; }
  .hero__credit { position:absolute; z-index:2; right:3vw; bottom:3vw; max-width:270px; margin:0; text-align:right; font:700 9px/1.35 Arial,sans-serif; letter-spacing:.1em; }
  .opening { padding:9vw 5vw 7vw; display:grid; grid-template-columns:.45fr 1.25fr 1.15fr; gap:4vw; border-bottom:1px solid #a49d8e; }
  .opening>.section-label { grid-column:1/-1; }
  .opening__headline h2,.machine h2,.season h2,.student h2,.town h2,.modern h2,.test h2,.close h2 { margin:0; font:900 clamp(48px,7vw,116px)/.83 "Arial Narrow",Impact,Arial,sans-serif; letter-spacing:-.055em; text-transform:uppercase; }
  h2 em { color:var(--red); font-family:Georgia,serif; font-weight:400; text-transform:none; }
  .opening__headline>p { margin:32px 0 0; font:600 17px/1.4 Georgia,serif; }
  .opening__body p { margin:0 0 1.25em; font:17px/1.58 Georgia,serif; }
  .opening__body .lead,.student .lead,.close .lead { font-size:24px; line-height:1.35; }
