  .readout article { min-height:260px; padding:28px 2.2vw; border-right:1px solid #47433b; display:flex; flex-direction:column; }
  .readout strong { font:900 clamp(32px,4vw,66px)/1 "Arial Narrow",Impact,sans-serif; color:#ff4250; letter-spacing:-.05em; }
