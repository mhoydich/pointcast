---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import { HOUSE_WE_BORROWED } from '../../../lib/pointcast-college-house';
import { ROW_BY_ROW } from '../../../lib/pointcast-sorority-row';
import { POINTCAST_SOUND_OF_FOCUS } from '../../../lib/pointcast-focus';
import {
  COLLEGE_FOOTBALL_MAGAZINE,
  COLLEGE_FOOTBALL_RESEARCH_SOURCES,
  SONG_YARD_PROGRAMS,
  SONG_YARD_REPERTOIRE,
  SONG_YARD_REPERTOIRE_PROGRAMS,
} from '../../../lib/pointcast-college-football-magazine';

const openField = SONG_YARD_PROGRAMS.filter((program) => program.cohort === 'open-field');
const documentedTracks = SONG_YARD_REPERTOIRE.filter((track) => track.evidence !== 'pointcast-candidate');
const description =
  'PointCast College Football groups the belief board, receipts, stadium-song repertoire, mascot atlas, 2029 identities, Saturday Commons, and season ledger into one living magazine.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Periodical',
      name: COLLEGE_FOOTBALL_MAGAZINE.title,
      description,
      url: COLLEGE_FOOTBALL_MAGAZINE.canonical,
      publisher: { '@type': 'Organization', name: 'PointCast' },
    },
    {
      '@type': 'PublicationIssue',
      issueNumber: COLLEGE_FOOTBALL_MAGAZINE.issue,
      name: COLLEGE_FOOTBALL_MAGAZINE.issueName,
      datePublished: COLLEGE_FOOTBALL_MAGAZINE.publishedAt,
      isPartOf: {
        '@type': 'Periodical',
        name: COLLEGE_FOOTBALL_MAGAZINE.title,
        url: COLLEGE_FOOTBALL_MAGAZINE.canonical,
      },
      hasPart: COLLEGE_FOOTBALL_MAGAZINE.departments.map((department) => ({
        '@type': 'CreativeWork',
        name: department.name,
        description: department.description,
        url: `https://pointcast.xyz${department.href}`,
      })),
    },
  ],
};
---

<BlockLayout
  title="PointCast College Football — Issue 001"
  description={description}
  image="/images/pointcast-college-football-magazine/social-card.png"
  themeColor="#f2ff3f"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine.json',
      title: 'PointCast College Football Issue 001 JSON',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="magazine">
    <header class="masthead">
      <div class="masthead__utility">
        <a href="/" aria-label="PointCast home">POINTCAST</a>
        <span>COLLEGE FOOTBALL · ISSUE {COLLEGE_FOOTBALL_MAGAZINE.issue}</span>
        <a href="/25/magazine.json">JSON ↗</a>
      </div>
      <div class="masthead__name">
        <span>THE LIVING SATURDAY MAGAZINE</span>
        <h1>COLLEGE<br />FOOTBALL</h1>
        <p>POINTCAST</p>
      </div>
      <nav aria-label="College Football magazine departments">
        {COLLEGE_FOOTBALL_MAGAZINE.departments.map((department) => (
          <a href={department.href}>{department.number} {department.name}</a>
        ))}
      </nav>
    </header>

    <section class="cover" aria-labelledby="cover-title">
      <div class="cover__story">
        <p>ISSUE {COLLEGE_FOOTBALL_MAGAZINE.issue} · {COLLEGE_FOOTBALL_MAGAZINE.issueName}</p>
        <h2 id="cover-title">The ranking<br />is one<br /><em>department.</em></h2>
        <p class="cover__dek">{COLLEGE_FOOTBALL_MAGAZINE.thesis}</p>
        <div class="cover__actions">
          <a href="/25">Read the belief board</a>
          <a href="/25/2029/song-yard">Open The Song Yard</a>
        </div>
      </div>
      <div class="cover__visual">
        <img
          src="/images/pointcast-2029-field-kit/stadium-band-terrace.png"
          alt="Imagined public band terrace inside a porous night stadium"
          width="1024"
          height="1536"
        />
        <div class="cover__sticker">
          <span>INSIDE</span>
          <strong>{SONG_YARD_PROGRAMS.length}</strong>
          <small>PROGRAMS IN THE YARD</small>
        </div>
        <div class="cover__barcode" aria-hidden="true">
          {Array.from({ length: 18 }, (_, index) => <i style={`--w:${index % 4 === 0 ? 4 : index % 3 === 0 ? 2 : 1}`}></i>)}
        </div>
      </div>
    </section>

    <section class="contents" aria-labelledby="contents-title">
      <header>
        <p>CONTENTS / ISSUE {COLLEGE_FOOTBALL_MAGAZINE.issue}</p>
        <h2 id="contents-title">{COLLEGE_FOOTBALL_MAGAZINE.departments.length} desks.<br />One season.</h2>
      </header>
      <ol>
        {COLLEGE_FOOTBALL_MAGAZINE.departments.map((department) => (
          <li>
            <a href={department.href}>
              <span>{department.number}</span>
              <div>
                <small>{department.kicker}</small>
                <h3>{department.name}</h3>
                <p>{department.description}</p>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="sound-feature" aria-labelledby="sound-feature-title">
      <div class="sound-feature__image">
        <img
          src="/images/pointcast-focus/social-card.png"
          alt="25 × Tone Bloom graphic field of colored chimes and stereo waves"
          width="1200"
          height="630"
          loading="lazy"
        />
        <span>SOUND DESK 001 · POINTCAST 25 × TONE BLOOM</span>
      </div>
      <div class="sound-feature__copy">
        <p>FILM ROOM / PLAYBOOK / BOARD / OPERATIONS / WALK HOME</p>
        <h2 id="sound-feature-title">THE SOUND<br />OF <em>FOCUS.</em></h2>
        <blockquote>“{POINTCAST_SOUND_OF_FOCUS.subtitle}”</blockquote>
        <p>
          Five kinds of college-football attention become a 25-second read,
          five Spotify rooms, and a private 25-minute Tone Bloom field study.
        </p>
        <a href="/25/magazine/sound-of-focus">
          Enter the Sound Desk <b aria-hidden="true">↗</b>
        </a>
      </div>
    </section>

    <section class="house-feature" aria-labelledby="house-feature-title">
      <div class="house-feature__image">
        <img
          src={HOUSE_WE_BORROWED.plates[3].image}
          alt={HOUSE_WE_BORROWED.plates[3].alt}
          width="1600"
          height="900"
          loading="lazy"
        />
        <span>HOUSE DESK 001 · A MIDJOURNEY VISUAL ESSAY</span>
      </div>
      <div class="house-feature__copy">
        <p>COLLEGE LIFE / FRATERNITY / BELONGING</p>
        <h2 id="house-feature-title">THE HOUSE<br />WE <em>BORROWED.</em></h2>
        <blockquote>“{HOUSE_WE_BORROWED.thesis}”</blockquote>
        <p>{HOUSE_WE_BORROWED.standfirst}</p>
        <a href="/25/magazine/the-house-we-borrowed">
          Enter the house <b aria-hidden="true">↗</b>
        </a>
      </div>
    </section>

    <section class="house-feature house-feature--row" aria-labelledby="row-feature-title">
      <div class="house-feature__image">
        <img
          src={ROW_BY_ROW.plates[7].image}
          alt={ROW_BY_ROW.plates[7].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <span>HOUSE DESK 002 · EIGHT MIDJOURNEY ARCHITECTURE PLATES</span>
      </div>
      <div class="house-feature__copy">
        <p>SORORITY ROW / ARCHITECTURE / 2030</p>
        <h2 id="row-feature-title">ROW<br /><em>/ ROW.</em></h2>
        <blockquote>“{ROW_BY_ROW.thesis}”</blockquote>
        <p>{ROW_BY_ROW.deck}</p>
        <a href="/25/magazine/sorority-row">
          Enter the row <b aria-hidden="true">↗</b>
        </a>
      </div>
    </section>

    <section class="repertoire-feature" aria-labelledby="repertoire-feature-title">
      <header>
        <p>THE SONG YARD / REPERTOIRE REPORT 001</p>
        <h2 id="repertoire-feature-title">Before a crowd<br />sings, report<br />what it knows.</h2>
        <p>
          This first repertoire issue distinguishes repeated stadium ritual from
          a documented one-off performance and from PointCast’s own regional
          proposal. Every entry keeps its source and opens licensed-provider
          search rather than copying audio or lyrics.
        </p>
      </header>
      <div class="repertoire-feature__numbers">
        <div>
          <strong>{SONG_YARD_REPERTOIRE_PROGRAMS.length}</strong>
          <span>researched dossiers</span>
        </div>
        <div>
          <strong>{SONG_YARD_REPERTOIRE.length}</strong>
          <span>song references</span>
        </div>
        <div>
          <strong>{documentedTracks.length}</strong>
          <span>documented uses</span>
        </div>
      </div>
      <div class="repertoire-feature__roll">
        {SONG_YARD_REPERTOIRE_PROGRAMS.map((program) => (
          <a
            href={`/25/2029/song-yard#${program.slug}`}
            style={`--program:${program.primary};--program-paper:${program.paper}`}
          >
            <span>{String(program.fieldNumber).padStart(2, '0')}</span>
            <strong>{program.school}</strong>
            <small>{program.repertoire[0]?.title}</small>
          </a>
        ))}
      </div>
      <a class="repertoire-feature__door" href="/25/2029/song-yard#repertoire">
        Open all repertoire dossiers and load a program into practice <b>↗</b>
      </a>
    </section>

    <section class="open-field" aria-labelledby="open-field-title">
      <div class="open-field__intro">
        <p>BEYOND THE CURRENT 25</p>
        <h2 id="open-field-title">The open<br />field begins.</h2>
        <p>
          Ranking is not the border of the magazine. These programs enter through
          stadium culture first and become available inside The Song Yard now.
        </p>
      </div>
      <ol>
        {openField.map((program) => (
          <li style={`--program:${program.primary};--program-two:${program.secondary};--program-paper:${program.paper}`}>
            <span>{String(program.fieldNumber).padStart(2, '0')}</span>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              {program.markPaths.map((path) => <path d={path}></path>)}
            </svg>
            <div>
              <small>{program.conference} · {program.city}, {program.state}</small>
              <h3>{program.school}</h3>
              <p>{program.markName} · {program.currentStadium}</p>
            </div>
            <a href={`/25/2029/song-yard#${program.slug}`}>Open dossier ↗</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="issue-map" aria-labelledby="issue-map-title">
      <header>
        <p>THE MAGAZINE SYSTEM</p>
        <h2 id="issue-map-title">What changes<br />through the year.</h2>
      </header>
      <div>
        <article>
          <span>TUESDAY</span>
          <h3>The Board moves.</h3>
          <p>Reasons, doubts, next proofs, and disagreements are rewritten in public.</p>
        </article>
        <article>
          <span>THURSDAY</span>
          <h3>The issue deepens.</h3>
          <p>Program dossiers, stadium life, local songs, mascot history, and the watch order expand.</p>
        </article>
        <article>
          <span>SATURDAY</span>
          <h3>The rooms become tools.</h3>
          <p>Field mode, Song Yard practice, printable kit, and playable myth enter the game day.</p>
        </article>
        <article>
          <span>DECEMBER</span>
          <h3>The magazine remembers.</h3>
          <p>The season ledger holds every prior claim for the committee comparison and final autopsy.</p>
        </article>
      </div>
    </section>

    <section class="source-desk" aria-labelledby="source-title">
      <header>
        <p>RESEARCH DESK / PUBLIC NOTES</p>
        <h2 id="source-title">A source is part<br />of the design.</h2>
      </header>
      <div class="source-desk__policy">
        <ol>
          {COLLEGE_FOOTBALL_MAGAZINE.sourcePolicy.map((rule, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{rule}</p></li>
          ))}
        </ol>
      </div>
      <div class="source-desk__links">
        {COLLEGE_FOOTBALL_RESEARCH_SOURCES.map((source) => (
          <a href={source.url} target="_blank" rel="noopener">{source.label} ↗</a>
        ))}
      </div>
    </section>

    <SeasonTicket25 context="Issue 001 and every department in it are funded by the Founding Season Ticket." />

    <aside class="boundary">
      <strong>UNOFFICIAL EDITORIAL SYSTEM.</strong>
      <p>{COLLEGE_FOOTBALL_MAGAZINE.boundary}</p>
    </aside>

    <footer>
      <div>
        <span>POINTCAST COLLEGE FOOTBALL</span>
        <strong>ISSUE {COLLEGE_FOOTBALL_MAGAZINE.issue}</strong>
      </div>
      <p>The season is bigger than the ranking.</p>
      <nav aria-label="Magazine closing links">
        <a href="/25">Current board</a>
        <a href="/25/season">Season ledger</a>
        <a href="/25/2029/song-yard">Song Yard</a>
        <a href="/mascot-battler">Mascot desk</a>
        <a href="/b/0530">Block 0530</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #131313;
  }

  .magazine {
    --ink: #171716;
    --paper: #f1ead8;
    --signal: #f2ff3f;
    --red: #d94f36;
    --blue: #254b90;
    --green: #3f694b;
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--ink);
    background:
      linear-gradient(rgba(23, 23, 22, 0.045) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 31px;
    font-family: var(--pc-font-mono);
  }

  .magazine * { box-sizing: border-box; }
  .magazine a { color: inherit; }

  .masthead {
    border-bottom: 3px solid var(--ink);
    background: var(--paper);
  }

  .masthead__utility {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem clamp(1rem, 4vw, 4rem);
    border-bottom: 1px solid var(--ink);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .masthead__name {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: 1.1rem clamp(1rem, 4vw, 4rem) 0.7rem;
  }

  .masthead__name > span {
    grid-column: 1 / -1;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .masthead h1 {
    margin: 0.3rem 0 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(4rem, 11vw, 10.5rem);
    letter-spacing: -0.07em;
    line-height: 0.72;
  }

  .masthead__name p {
    align-self: end;
    margin: 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(2rem, 5vw, 5rem);
    writing-mode: vertical-rl;
  }

  .masthead > nav {
    display: flex;
    gap: 1px;
    overflow-x: auto;
    border-top: 1px solid var(--ink);
    background: var(--ink);
  }

  .masthead > nav a {
    flex: 1 0 auto;
    padding: 0.8rem 1rem;
    background: var(--paper);
    font-size: 0.56rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .masthead > nav a:hover,
  .masthead > nav a:focus-visible { background: var(--signal); }

  .cover {
    display: grid;
    min-height: 780px;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.75fr);
    border-bottom: 3px solid var(--ink);
  }

  .cover__story {
    display: flex;
    flex-direction: column;
    padding: clamp(3rem, 8vw, 7rem) clamp(1rem, 5vw, 5rem);
    background: var(--signal);
  }

  .cover__story > p:first-child {
    margin: 0;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .cover h2,
  .contents h2,
  .sound-feature h2,
  .house-feature h2,
  .repertoire-feature h2,
  .open-field h2,
  .issue-map h2,
  .source-desk h2 {
    margin: 1.5rem 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(4.2rem, 9vw, 9rem);
    letter-spacing: -0.065em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .cover h2 em { color: var(--red); font-style: normal; }

  .cover__dek {
    max-width: 720px;
    margin: auto 0 0;
    font-family: var(--pc-font-sans);
    font-size: clamp(1.2rem, 2.1vw, 2rem);
    font-weight: 750;
    line-height: 1.25;
  }

  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .cover__actions a,
  .repertoire-feature__door {
    min-height: 48px;
    padding: 0.9rem 1rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    font-size: 0.65rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .cover__visual {
    position: relative;
    min-height: 660px;
    overflow: hidden;
    border-left: 3px solid var(--ink);
    background: var(--blue);
  }

  .cover__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75) contrast(1.04);
  }

  .cover__sticker {
    position: absolute;
    top: 7%;
    right: 5%;
    display: grid;
    width: 180px;
    min-height: 210px;
    place-items: center;
    padding: 0.8rem;
    border: 4px solid var(--ink);
    background: var(--red);
    box-shadow: 9px 10px 0 var(--ink);
    transform: rotate(4deg);
    text-align: center;
  }

  .cover__sticker span,
  .cover__sticker small { font-size: 0.6rem; font-weight: 900; }
  .cover__sticker strong {
    font-family: Impact, sans-serif;
    font-size: 6rem;
    line-height: 0.8;
  }

  .cover__barcode {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    width: 190px;
    height: 72px;
    gap: 3px;
    padding: 0.6rem;
    background: var(--paper);
  }

  .cover__barcode i { width: calc(var(--w) * 2px); background: var(--ink); }

  .contents,
  .house-feature,
  .repertoire-feature,
  .open-field,
  .issue-map,
  .source-desk {
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 5vw, 5rem);
    border-bottom: 3px solid var(--ink);
  }

  .contents > header,
  .house-feature > header,
  .repertoire-feature > header,
  .issue-map > header,
  .source-desk > header {
    display: grid;
    grid-template-columns: 0.38fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .contents header p,
  .repertoire-feature header > p:first-child,
  .open-field__intro > p:first-child,
  .issue-map header p,
  .source-desk header p {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .contents h2,
  .house-feature h2,
  .repertoire-feature h2,
  .issue-map h2,
  .source-desk h2 { margin-top: 0; }

  .contents > ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 3rem 0 0;
    padding: 0;
    border: 2px solid var(--ink);
    list-style: none;
  }

  .contents li { border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .contents li:nth-child(2n) { border-right: 0; }

  .contents li a {
    display: grid;
    min-height: 230px;
    grid-template-columns: 70px 1fr auto;
    gap: 1rem;
    padding: 1.2rem;
    text-decoration: none;
  }

  .contents li a:hover,
  .contents li a:focus-visible { background: var(--signal); }
  .contents li a > span {
    color: var(--red);
    font-family: Impact, sans-serif;
    font-size: 3.6rem;
  }
  .contents h3 {
    margin: 0.5rem 0;
    font-family: Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .contents small { font-weight: 900; text-transform: uppercase; }
  .contents li p { max-width: 560px; font-family: var(--pc-font-sans); line-height: 1.45; }

  .sound-feature {
    display: grid;
    min-height: 690px;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    border-bottom: 3px solid var(--ink);
    background: #b6a6ef;
  }

  .sound-feature__image {
    position: relative;
    min-height: 590px;
    overflow: hidden;
    border-right: 3px solid var(--ink);
    background: var(--ink);
  }

  .sound-feature__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sound-feature__image span {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 0.75rem;
    background: var(--ink);
    color: var(--signal);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .sound-feature__copy {
    align-self: center;
    padding: clamp(2rem, 6vw, 6rem);
  }

  .sound-feature__copy > p:first-child {
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .sound-feature h2 { margin: 1rem 0; }
  .sound-feature h2 em { color: var(--red); font-style: normal; }

  .sound-feature blockquote {
    margin: 1.5rem 0;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
    font-family: var(--pc-font-sans);
    font-size: clamp(1.35rem, 2.5vw, 2.3rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .sound-feature__copy > p:not(:first-child) {
    font-family: var(--pc-font-sans);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .sound-feature__copy > a {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
    padding: 1rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.65rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .house-feature {
    display: grid;
    min-height: 760px;
    grid-template-columns: minmax(0, 1.05fr) minmax(400px, 0.8fr);
    padding: 0;
    color: var(--paper);
    background: #8d2d26;
  }

  .house-feature__image {
