---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { POINTCAST_SOUND_OF_FOCUS } from '../../../lib/pointcast-focus';

const feature = POINTCAST_SOUND_OF_FOCUS;
const description =
  'A 25-second pre-snap read, five focus states, five Spotify rooms, and one playable Tone Bloom study by Michael Hoydich.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: feature.title,
  alternativeHeadline: feature.subtitle,
  description,
  datePublished: feature.publishedAt,
  url: feature.canonical,
  image: feature.socialImage,
  author: {
    '@type': 'Person',
    name: feature.byline,
  },
  isPartOf: {
    '@type': 'PublicationIssue',
    name: "PointCast College Football — Issue 001: Talkin' Season",
    url: feature.parent,
  },
  about: [
    'college football',
    'attention',
    'focus',
    'sound',
    'background music',
    'binaural beats',
    'caffeine',
    'adaptogens',
    'nootropics',
    'cannabis',
  ],
};
---

<BlockLayout
  title="The Sound of Focus — 25 × Tone Bloom"
  description={description}
  image={feature.socialImage}
  themeColor="#d8f000"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/sound-of-focus.json',
      title: 'The Sound of Focus structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="focus">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · SOUND DESK 001</span>
      <nav aria-label="Sound of Focus navigation">
        <a href="/25">The 25</a>
        <a href="/25/magazine">Issue 001</a>
        <a href="/25/magazine/sound-of-focus.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="focus-title">
      <div class="hero__number" aria-hidden="true">25</div>
      <div class="hero__copy">
        <p>POINTCAST 25 × TONE BLOOM · MICHAEL HOYDICH</p>
        <h1 id="focus-title">THE SOUND<br />OF <em>FOCUS</em></h1>
        <p class="hero__dek">{feature.subtitle}</p>
        <div class="hero__actions">
          <a class="button button--signal" href={feature.interactiveLab}>Open the 25-minute instrument ↗</a>
          <a class="button button--paper" href="#snap">Run the 25-second read ↓</a>
        </div>
      </div>
      <div class="hero__signal" aria-hidden="true">
        {feature.focusModes.map((mode, index) => (
          <i style={`--i:${index};--mode:${mode.color}`}></i>
        ))}
      </div>
    </section>

    <section class="lede">
      <p class="section-label">THE FIELD QUESTION</p>
      <div>
        <h2>The game is loud.<br />The work is not.</h2>
        <p class="standfirst">{feature.thesis}</p>
        <div class="lede__columns">
          <p>
            A quarterback does not focus by staring harder at one defender. The
            useful sequence is wider: hold the whole shell, notice the conflict,
            narrow to the answer, execute, and then release enough of the last
            play to see the next one.
          </p>
          <p>
            The same aperture moves through the rest of college football. Film
            study is sustained attention. A playbook protects language. A belief
            board needs generative attention. Saturday operations need tempo.
            The walk home needs no new assignment.
          </p>
        </div>
      </div>
    </section>

    <section class="snap" id="snap" data-snap-root aria-labelledby="snap-title">
      <header>
        <p class="section-label">THE 25-SECOND READ</p>
        <h2 id="snap-title">Wide. Conflict. Narrow. Go.</h2>
        <p>
          A tiny attention model, not a quarterback simulator. Run the clock and
          watch the field ask for four different shapes of focus.
        </p>
      </header>
      <div class="snap__instrument">
        <div class="snap__clock">
          <small data-snap-phase>READY</small>
          <strong data-snap-time>25</strong>
          <span>SECONDS</span>
        </div>
        <div class="snap__field" data-snap-field data-phase="ready" aria-hidden="true">
          <i class="route route--one"></i>
          <i class="route route--two"></i>
          <i class="route route--three"></i>
          <i class="route route--four"></i>
          <i class="route route--five"></i>
          <span class="ball">●</span>
          <b class="target"></b>
        </div>
        <div class="snap__copy">
          <strong data-snap-title>See the whole shell.</strong>
          <p data-snap-copy>
            Start wide. The first job is not to pick an answer; it is to preserve
            enough field to notice what changes.
          </p>
          <button type="button" data-snap-start>RUN THE READ →</button>
        </div>
      </div>
    </section>

    <section class="five" aria-labelledby="five-title">
      <header>
        <p class="section-label">FIVE WORKING STATES</p>
        <h2 id="five-title">The task changes<br />the soundtrack.</h2>
      </header>
      <div class="five__tabs" role="tablist" aria-label="Five college-football focus modes">
        {feature.focusModes.map((mode, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`focus-panel-${mode.id}`}
            id={`focus-tab-${mode.id}`}
            data-focus-tab={mode.id}
            style={`--mode:${mode.color}`}
          >
            <span>{mode.number}</span>
            <strong>{mode.pointcastName}</strong>
            <small>{mode.attention}</small>
          </button>
        ))}
      </div>
      <div class="five__panels">
        {feature.focusModes.map((mode, index) => (
          <article
            id={`focus-panel-${mode.id}`}
            role="tabpanel"
            aria-labelledby={`focus-tab-${mode.id}`}
            data-focus-panel={mode.id}
            hidden={index !== 0}
            style={`--mode:${mode.color}`}
          >
            <div class="five__panel-number">{mode.number}</div>
            <div class="five__panel-copy">
              <p>{mode.toneBloomName} / {mode.attention}</p>
              <h3>{mode.pointcastName}</h3>
              <strong>{mode.job}</strong>
              <p>{mode.collegeFootballUse}</p>
              <blockquote>“{mode.question}”</blockquote>
            </div>
            <div class="five__panel-sound">
              <span>THE SOUND</span>
              <p>{mode.sound}</p>
              <a href={mode.playlist.url} target="_blank" rel="noopener">
                SPOTIFY / {mode.playlist.name} ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="lab" aria-labelledby="lab-title">
      <div class="lab__art">
        <img
          src="/images/pointcast-focus/social-card-v2.png"
          alt="25 × Tone Bloom graphic field of colored chimes and stereo waves"
          width="1200"
          height="630"
          loading="lazy"
        />
      </div>
      <div class="lab__copy">
        <p class="section-label">THE PLAYABLE COMPANION</p>
        <h2 id="lab-title">Do not ask what works.<br /><em>Run the study.</em></h2>
        <p>
          Tone Bloom turns these five states into filtered noise, sparse chimes,
          optional split-ear beats, and a private 25-minute N-of-1 study. Rotate
          Tone Bloom, Spotify, and silence. Rate focus before and after. Count
          distractions. Name the actual output.
        </p>
        <ul>
          <li>No account and no uploaded study data.</li>
          <li>Five Spotify playlists created for the feature.</li>
          <li>Twenty-five practical focus moves.</li>
          <li>An evidence cabinet for caffeine, adaptogens, nootropics, prescriptions, and cannabis.</li>
        </ul>
        <a href={feature.interactiveLab}>OPEN 25 × TONE BLOOM ↗</a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <header>
        <p class="section-label">THE ATTENTION BOARD</p>
        <h2 id="principles-title">Five things the scoreboard cannot tell you.</h2>
      </header>
      <ol>
        {feature.principles.map((principle) => (
          <li>
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="chemistry" aria-labelledby="chemistry-title">
      <header>
        <p class="section-label">THE ENHANCER QUESTION</p>
        <h2 id="chemistry-title">Potential<br />is not proof.</h2>
        <p>
          College football is full of performance language. That makes clean
          boundaries more important, not less. This is education, not medical
          advice or a protocol.
        </p>
      </header>
      <div class="chemistry__grid">
        {feature.enhancers.map((enhancer, index) => (
          <article class:list={{ 'is-cannabis': enhancer.name === 'Cannabis' }}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{enhancer.name}</h3>
            <strong>{enhancer.verdict}</strong>
            <p>{enhancer.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="research" aria-labelledby="research-title">
      <div>
        <p class="section-label">RESEARCH DESK</p>
        <h2 id="research-title">Read past<br />the promise.</h2>
        <p>
          The useful finding is usually narrower than the marketing sentence.
          These are the primary research and public-health sources carried into
          the interactive companion.
        </p>
      </div>
      <ol>
        {feature.sources.map((source, index) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{source.label}</strong>
              <b>↗</b>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <div>
        <strong>THE SOUND OF FOCUS</strong>
        <span>POINTCAST COLLEGE FOOTBALL · SOUND DESK 001</span>
      </div>
      <p>
        CONCEIVED, CURATED + WRITTEN BY<br />
        <b>MICHAEL HOYDICH</b>
      </p>
      <p>
        INTERACTIVE SCORE + BUILD<br />
        <b>GPT‑5.6 SOL WITH MICHAEL HOYDICH</b>
      </p>
      <nav aria-label="Sound of Focus footer navigation">
        <a href={feature.interactiveLab}>PLAY THE STUDY ↗</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href={`/b/${feature.block}`}>BLOCK {feature.block}</a>
      </nav>
      <small>{feature.boundary}</small>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('.focus');
      if (!(root instanceof HTMLElement)) return;

      const tabs = [...root.querySelectorAll('[data-focus-tab]')];
      const panels = [...root.querySelectorAll('[data-focus-panel]')];

      function openMode(id) {
        tabs.forEach((tab) => {
          if (!(tab instanceof HTMLButtonElement)) return;
          const active = tab.dataset.focusTab === id;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.dataset.focusPanel !== id;
        });
      }

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLButtonElement)) return;
        tab.addEventListener('click', () => openMode(tab.dataset.focusTab || 'film-room'));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(index + direction + tabs.length) % tabs.length];
          if (!(next instanceof HTMLButtonElement)) return;
          openMode(next.dataset.focusTab || 'film-room');
          next.focus();
        });
      });

      const snap = root.querySelector('[data-snap-root]');
      if (!(snap instanceof HTMLElement)) return;
      const button = snap.querySelector('[data-snap-start]');
      const time = snap.querySelector('[data-snap-time]');
      const phase = snap.querySelector('[data-snap-phase]');
      const title = snap.querySelector('[data-snap-title]');
      const copy = snap.querySelector('[data-snap-copy]');
      const field = snap.querySelector('[data-snap-field]');
      if (!(button instanceof HTMLButtonElement) || !time || !phase || !title || !copy || !(field instanceof HTMLElement)) return;

      const phases = [
        { min: 18, id: 'scan', label: 'SCAN WIDE', title: 'See the whole shell.', copy: 'Do not pick an answer yet. Preserve enough field to notice what changes.' },
        { min: 10, id: 'conflict', label: 'FIND CONFLICT', title: 'Read the thing that cannot be right twice.', copy: 'The useful cue is often the defender, sentence, or piece of evidence pulled between two jobs.' },
        { min: 3, id: 'narrow', label: 'NARROW', title: 'Commit the aperture.', copy: 'A wide read becomes useful only when it hands the work to one clear next action.' },
        { min: 1, id: 'execute', label: 'EXECUTE', title: 'Go before certainty returns.', copy: 'Decision is a different state from search. Protect the action from one more comparison.' },
        { min: 0, id: 'release', label: 'RELEASE', title: 'Let the last rep leave.', copy: 'Recovery is not empty. Widen enough to see the next field.' },
      ];

      let timer = 0;
      let remaining = 25;

      function render() {
        const current = phases.find((item) => remaining >= item.min) || phases[phases.length - 1];
        time.textContent = String(remaining).padStart(2, '0');
        phase.textContent = current.label;
        title.textContent = current.title;
        copy.textContent = current.copy;
        field.dataset.phase = current.id;
      }

      button.addEventListener('click', () => {
        if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
        remaining = 25;
        button.disabled = true;
        button.textContent = 'READING…';
        render();
        timer = window.setInterval(() => {
          remaining -= 1;
          render();
          if (remaining <= 0) {
            window.clearInterval(timer);
            timer = 0;
            button.disabled = false;
            button.textContent = 'RUN IT AGAIN →';
          }
        }, 1000);
      });
    })();
  </script>
</BlockLayout>

<style>
  :global(html) {
    background: #07162f;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #07162f;
    color: #07162f;
    font-family: var(--pc-font-sans);
  }

  :global([hidden]) {
    display: none !important;
  }

  .focus {
    --ink: #07162f;
    --paper: #f4ead8;
    --signal: #d8f000;
    --orange: #ff6038;
    --blue: #2364ef;
    --lavender: #b6a6ef;
    min-height: 100vh;
    overflow: hidden;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 4px solid var(--orange);
    outline-offset: 4px;
  }

  .mast {
    align-items: center;
    background: var(--ink);
    border-bottom: 5px solid var(--signal);
    color: var(--paper);
    display: grid;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 800;
    grid-template-columns: 1fr auto 1fr;
    letter-spacing: 0.11em;
    min-height: 62px;
    padding: 0 3vw;
    text-transform: uppercase;
  }

  .mast > a,
  .mast nav a {
    color: inherit;
    text-decoration: none;
  }

  .mast > a {
    font-family: var(--pc-font-sans);
    font-size: 18px;
    font-weight: 950;
    letter-spacing: -0.06em;
  }

  .mast nav {
    display: flex;
    gap: 18px;
    justify-content: flex-end;
  }

  .hero {
    background:
      radial-gradient(circle at 87% 14%, var(--lavender) 0 6%, transparent 6.2%),
      linear-gradient(111deg, var(--ink) 0 70%, #1b3683 70%);
    border-bottom: 5px solid var(--ink);
    color: var(--paper);
    display: grid;
    grid-template-columns: minmax(250px, 0.7fr) minmax(420px, 1.3fr);
    min-height: 720px;
    overflow: hidden;
    position: relative;
  }

  .hero::after {
    border: clamp(36px, 5vw, 84px) solid var(--orange);
    border-radius: 50%;
    bottom: -22vw;
    box-shadow:
      0 0 0 clamp(26px, 4vw, 66px) var(--ink),
      0 0 0 clamp(55px, 8vw, 135px) var(--signal),
      0 0 0 clamp(86px, 12vw, 205px) var(--blue);
    content: '';
    height: 45vw;
    position: absolute;
    right: -7vw;
    width: 45vw;
  }

  .hero__number {
    align-self: center;
    font-size: clamp(240px, 35vw, 560px);
    font-weight: 950;
    letter-spacing: -0.16em;
    line-height: 0.64;
    padding-left: 2vw;
    position: relative;
    z-index: 1;
  }

  .hero__copy {
    align-self: center;
    max-width: 900px;
    padding: 70px 5vw 90px 20px;
    position: relative;
    z-index: 3;
  }

  .hero__copy > p:first-child,
  .section-label {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  .hero h1 {
    font-size: clamp(74px, 10vw, 150px);
    letter-spacing: -0.09em;
    line-height: 0.75;
    margin: 0;
  }

  .hero h1 em {
    color: var(--signal);
    font-style: normal;
    text-shadow: 7px 7px 0 var(--blue);
  }

  .hero__dek {
    font-size: clamp(20px, 2.4vw, 38px);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.2;
    max-width: 670px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .button {
    align-items: center;
    border: 2px solid currentColor;
    display: inline-flex;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    font-weight: 900;
    justify-content: center;
    letter-spacing: 0.07em;
    min-height: 50px;
    padding: 0 18px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .button--signal {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }

  .button--paper {
    color: var(--paper);
  }

  .hero__signal {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: absolute;
    right: 3vw;
    top: 35px;
    z-index: 3;
  }

  .hero__signal i {
    background: var(--mode);
    border: 3px solid var(--paper);
    border-radius: 50%;
    height: clamp(24px, 3vw, 46px);
    width: clamp(24px, 3vw, 46px);
  }

  .lede,
  .snap,
  .five,
  .principles,
  .chemistry,
  .research {
    border-bottom: 5px solid var(--ink);
    padding: clamp(55px, 8vw, 110px) clamp(18px, 5vw, 78px);
  }

  .lede {
    background: var(--paper);
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(150px, 0.28fr) 1fr;
  }

  .lede h2,
  .snap h2,
  .five h2,
  .lab h2,
  .principles h2,
  .chemistry h2,
  .research h2 {
    font-size: clamp(50px, 8vw, 118px);
    letter-spacing: -0.08em;
    line-height: 0.82;
    margin: 0;
  }

  .standfirst {
    font-size: clamp(22px, 2.6vw, 38px);
    font-weight: 720;
    letter-spacing: -0.035em;
    line-height: 1.25;
    max-width: 980px;
  }

  .lede__columns {
    column-count: 2;
    column-gap: 40px;
    max-width: 980px;
  }

  .lede__columns p {
    break-inside: avoid;
    font-size: 17px;
    font-weight: 620;
    line-height: 1.55;
    margin: 0;
  }

  .snap {
    background: var(--signal);
  }

  .snap > header {
    display: grid;
    gap: 30px;
    grid-template-columns: 0.35fr 1fr 0.55fr;
  }

  .snap > header > p:last-child {
    font-size: 17px;
    font-weight: 650;
    line-height: 1.45;
    margin: 0;
  }

  .snap__instrument {
    background: var(--paper);
    border: 4px solid var(--ink);
    box-shadow: 12px 12px 0 var(--ink);
    display: grid;
    grid-template-columns: 0.28fr 1fr 0.45fr;
    margin-top: 60px;
    min-height: 430px;
  }

  .snap__clock {
    align-content: center;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    padding: 20px;
    text-align: center;
  }

  .snap__clock small,
  .snap__clock span {
    color: var(--signal);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .snap__clock strong {
    font-size: clamp(90px, 13vw, 190px);
    letter-spacing: -0.1em;
    line-height: 0.85;
  }

  .snap__field {
    background:
      linear-gradient(90deg, rgba(244, 234, 216, 0.1) 1px, transparent 1px) 0 0 / 10% 100%,
      linear-gradient(rgba(244, 234, 216, 0.08) 1px, transparent 1px) 0 0 / 100% 20%,
      #174f3c;
    border-right: 3px solid var(--ink);
    color: var(--paper);
    min-height: 430px;
    overflow: hidden;
    position: relative;
  }

  .route {
    background: var(--paper);
    border: 4px solid var(--ink);
    border-radius: 50%;
    height: 34px;
    position: absolute;
    transition: all 0.5s ease;
    width: 34px;
  }

  .route--one { left: 16%; top: 19%; }
  .route--two { left: 38%; top: 34%; }
  .route--three { left: 63%; top: 16%; }
  .route--four { left: 75%; top: 62%; }
  .route--five { left: 29%; top: 73%; }

  .ball {
    bottom: 12%;
    font-size: 30px;
    left: 49%;
    position: absolute;
  }

  .target {
    border: 7px solid var(--signal);
    border-radius: 50%;
    height: 82px;
    opacity: 0;
    position: absolute;
    right: 13%;
    top: 51%;
    transition: opacity 0.4s ease, transform 0.4s ease;
    width: 82px;
  }

  .snap__field[data-phase='conflict'] .route--two,
  .snap__field[data-phase='conflict'] .route--four {
    background: var(--orange);
    transform: scale(1.5);
  }

  .snap__field[data-phase='narrow'] .route:not(.route--four),
  .snap__field[data-phase='execute'] .route:not(.route--four) {
    opacity: 0.15;
    transform: scale(0.6);
  }

  .snap__field[data-phase='narrow'] .route--four,
  .snap__field[data-phase='execute'] .route--four {
    background: var(--signal);
    transform: scale(1.65);
  }

  .snap__field[data-phase='execute'] .target {
    opacity: 1;
    transform: scale(1.25);
  }

  .snap__field[data-phase='release'] .route {
    background: var(--lavender);
    opacity: 0.7;
    transform: scale(0.85);
  }

  .snap__copy {
    align-content: center;
    display: grid;
    padding: 26px;
  }

  .snap__copy strong {
