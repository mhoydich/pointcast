---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  TEXAS_2026_BOARD,
  TEXAS_FOOTBALL_FEATURE,
  TEXAS_FOOTBALL_LEDGER,
  TEXAS_HISTORY_OBJECTS,
  TEXAS_SOURCES,
  texasSource,
} from '../../../lib/pointcast-texas-football-history';

const feature = TEXAS_FOOTBALL_FEATURE;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: feature.title,
      alternativeHeadline: feature.displayTitle,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        issueNumber: feature.issue,
        name: 'PointCast College Football — Archive Issue 003',
        url: feature.canonical,
      },
      about: ['Texas Longhorns football', 'University of Texas at Austin', 'college football history', '2026 college football season'],
      citation: TEXAS_SOURCES.map((source) => source[3]),
    },
    {
      '@type': 'ItemList',
      name: 'A history of Texas football in ten objects',
      numberOfItems: TEXAS_HISTORY_OBJECTS.length,
      itemListElement: TEXAS_HISTORY_OBJECTS.map((object, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: object.object,
        description: object.title,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#bf4d20"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/texas-football-history.json',
      title: 'The History of Texas Football structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="texas-history">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · ARCHIVE DESK 001 · ISSUE 003</span>
      <nav aria-label="Texas history navigation">
        <a href="#objects">TEN OBJECTS</a>
        <a href="#song">THE SONG</a>
        <a href="#2026">2026</a>
        <a href="/25/magazine/texas-football-history.json">JSON ↗</a>
      </nav>
    </header>

    <section class="cover" aria-labelledby="texas-title">
      <img
        src={feature.heroImage}
        alt="Abstract Texas football history as burnt-orange geological layers with a memorial arch, oil derrick, wishbone diagram, and line from 1893 to 2026"
        width="1800"
        height="1100"
        fetchpriority="high"
      />
      <div class="cover__shade" aria-hidden="true"></div>
      <div class="cover__copy">
        <p>POINTCAST MAGAZINE · AUGUST 12, 2026</p>
        <h1 id="texas-title">THE HISTORY<br />OF <em>TEXAS</em><br />FOOTBALL</h1>
        <blockquote>“{feature.subtitle}”</blockquote>
      </div>
      <div class="cover__index" aria-label="Issue summary">
        <span><b>10</b> objects</span>
        <span><b>134</b> seasons</span>
        <span><b>01</b> unfinished year</span>
      </div>
      <p class="art-credit">ORIGINAL POINTCAST VECTOR FIELD · NO OFFICIAL SCHOOL MARKS</p>
    </section>

    <nav class="era-rail" aria-label="Texas football eras">
      <span>1893 · VARSITY</span>
      <span>1924 · MEMORIAL</span>
      <span>1968 · WISHBONE</span>
      <span>1970 · WHITTIER</span>
      <span>2006 · FOURTH-AND-FIVE</span>
      <span>2026 · UNFINISHED</span>
    </nav>

    <section class="opening" aria-labelledby="opening-title">
      <p class="section-label">THE ONE-SENTENCE HISTORY</p>
      <div>
        <h2 id="opening-title">Texas was never<br /><em>inevitable.</em></h2>
        <p class="lead">The oldest feeling at Texas is that Texas has always been Texas. It has not.</p>
        <p>It began as students arranging a game. The colors were a vote. The mascot was an alumni purchase. The stadium was a memorial. The dynasty was an offensive experiment. Integration arrived late enough to complicate the championship photographs. Television made the program both richer and more portable. Conference realignment moved a 131-year-old institution into a new neighborhood.</p>
        <p>The continuity is not that nothing changed. The continuity is the size of the claim: this team can make a young public university feel ancient, make a campus feel like a state, and make one Saturday look like evidence about who Texas is.</p>
        <blockquote>Texas football is not a monument. It is a construction site that learned how to call itself a monument.</blockquote>
      </div>
    </section>

    <section class="ledger" aria-label="Texas football historical ledger">
      {TEXAS_FOOTBALL_LEDGER.map(([value, label]) => (
        <div><strong>{value}</strong><span>{label}</span></div>
      ))}
    </section>

    <section class="objects" id="objects" aria-labelledby="objects-title">
      <header class="objects__head">
        <p class="section-label">THE STATE IN TEN OBJECTS</p>
        <h2 id="objects-title">Things that<br />became <em>Texas.</em></h2>
        <p>Not the ten greatest moments. Ten objects that reveal how an institution manufactures continuity.</p>
      </header>

      <div class="object-list">
        {TEXAS_HISTORY_OBJECTS.map((object) => {
          const source = texasSource(object.sourceId);
          return (
            <article class="object-card" id={`object-${object.number}`}>
              <header>
                <span>{object.number}</span>
                <p>{object.year}</p>
                <h3>{object.object}</h3>
              </header>
              <div class="object-card__body">
                <h4>{object.title}</h4>
                <p>{object.body}</p>
                <blockquote>{object.turn}</blockquote>
                {source && <a href={source[3]}>RECEIPT · {source[2]} ↗</a>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="song" id="song" aria-labelledby="song-title">
      <div class="song__mark" aria-hidden="true"><span>♪</span><b>1903</b></div>
      <div class="song__copy">
        <p class="section-label">SONGS ARE ARCHIVES TOO</p>
        <h2 id="song-title">The tune can unite.<br />The footnote must remain.</h2>
        <p>UT’s historical committee found that “The Eyes of Texas” almost certainly debuted in blackface at a racist setting, while also finding no evidence the lyrics were written as nostalgia for slavery and very low likelihood that the title came from Robert E. Lee. The same song later appeared at funerals, commencements, protests, battlefields, and football games—and became a new site of student-athlete dissent in 2020.</p>
        <p>The point is not to flatten those facts into a verdict. It is to insist that belonging grows stronger when the archive stays open.</p>
        <a href="https://eyesoftexas.utexas.edu/full-report/">READ THE UNIVERSITY’S FULL HISTORICAL REPORT ↗</a>
      </div>
    </section>

    <section class="machine" aria-labelledby="machine-title">
      <header>
        <p class="section-label">HOW THE MACHINE WORKS</p>
        <h2 id="machine-title">Capital.<br />Place.<br />Repetition.</h2>
      </header>
      <div class="machine__grid">
        <article><span>01</span><h3>Capital makes scale possible.</h3><p>University Lands, donors, tickets, media, and facilities live in different ledgers. Together they produce an institution that can think in decades and build at city scale.</p></article>
        <article><span>02</span><h3>Place makes it legible.</h3><p>Austin, the Forty Acres, the Tower, Dallas in October, College Station in November, and high-school towns across Texas make the program more than a professional franchise with homework.</p></article>
        <article><span>03</span><h3>Repetition makes it sacred.</h3><p>Wear the color. Make the sign. Light the Tower. Cross the fairgrounds. Sing, argue, return. A ritual becomes tradition only when another generation decides it is still worth doing.</p></article>
        <article><span>04</span><h3>Players make it human.</h3><p>The institution supplies the stage, but people remember Campbell’s shoulders, Whittier’s courage, Williams breaking free, Young making a fourth-down choice, and the current team becoming itself in public.</p></article>
      </div>
    </section>

    <section class="present" id="2026" aria-labelledby="present-title">
      <header>
        <p class="section-label">ONE UNFINISHED SEASON · AS OF AUGUST 12, 2026</p>
        <h2 id="present-title">The map moved.<br />The pressure <em>did not.</em></h2>
        <p>Texas enters 2026 after three straight 10-win seasons: CFP semifinals in 2023 and 2024, then a 10–3 finish and Citrus Bowl win over Michigan in 2025. Steve Sarkisian is 48–20 at Texas. The Longhorns are no longer asking whether they can return to national relevance. They are asking what permanence costs inside the SEC.</p>
      </header>
      <div class="schedule-board">
        {TEXAS_2026_BOARD.map(([date, opponent, setting, meaning]) => (
          <article><span>{date}</span><h3>{opponent}</h3><p>{setting}</p><strong>{meaning}</strong></article>
        ))}
      </div>
      <div class="present__close">
        <p>The schedule is unusually good history-writing material. Texas State begins the year inside DKR. Ohio State arrives at night with College GameDay. Texas makes its first trip to Neyland Stadium. Oklahoma waits in the Cotton Bowl. LSU offers a new conference cathedral. A&M gets the final Friday night.</p>
        <blockquote>History is no longer the thing Texas can point to when the present disappoints. History is the standard the present has volunteered to meet.</blockquote>
      </div>
    </section>

    <section class="ending" aria-labelledby="ending-title">
      <p class="section-label">WHAT SURVIVED</p>
      <h2 id="ending-title">Not the formation.<br />Not the conference.<br /><em>The appetite.</em></h2>
      <p>Texas survived gold uniforms, bright orange, two world wars, the end of the Southwest Conference, lean decades, great coaches, fired coaches, protests, new money, bigger scoreboards, and a move east.</p>
      <p>What survived was the belief that a football team can carry more than a football result. That belief is beautiful. It is also dangerous. It can make athletes into symbols before they get to be students, turn a university into a brand before it gets to be a place, and make honest criticism feel like disloyalty.</p>
      <p>The best Texas history does not reduce the program’s size. It gives the size somewhere honest to stand.</p>
    </section>

    <details class="sources">
      <summary>18 OFFICIAL + ARCHIVAL RECEIPTS · CHECKED AUGUST 12, 2026</summary>
      <ol>
        {TEXAS_SOURCES.map(([, label, outlet, url]) => (
          <li><a href={url}>{label}</a><span>{outlet}</span></li>
        ))}
      </ol>
    </details>

    <footer class="issue-footer">
      <p>POINTCAST COLLEGE FOOTBALL · ARCHIVE DESK 001 · BLOCK 0569</p>
      <div><a href="/25/magazine">RETURN TO THE MAGAZINE ↗</a><a href="/b/0569">READ BLOCK 0569 ↗</a><a href="/25">OPEN THE POINTCAST 25 ↗</a></div>
      <small>{feature.boundary}</small>
    </footer>

    <SeasonTicket25 surface="texas-football-history" />
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #100d0b; color: #17120f; }
  :global(.site-header), :global(.site-footer) { display: none !important; }
  .texas-history { --burnt: #bf4d20; --cream: #f4e6ca; --chalk: #fff8e8; --night: #100d0b; --blue: #183857; --gold: #f3c95c; overflow: hidden; background: var(--cream); font-family: Arial, Helvetica, sans-serif; }
  .mast { min-height: 44px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 0 1rem; color: var(--chalk); background: var(--night); border-bottom: 1px solid rgba(255,255,255,.2); font-size: .65rem; font-weight: 800; letter-spacing: .12em; }
  .mast a { color: inherit; text-decoration: none; }
  .mast > span { text-align: center; }
  .mast nav { display: flex; gap: 1rem; }
  .cover { position: relative; min-height: min(82vw, 920px); display: flex; align-items: flex-end; isolation: isolate; color: var(--chalk); background: var(--night); }
  .cover > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; }
  .cover__shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(11,8,7,.83) 0%, rgba(11,8,7,.35) 57%, rgba(11,8,7,.1) 100%), linear-gradient(0deg, rgba(11,8,7,.62), transparent 50%); }
  .cover__copy { width: min(960px, 86vw); padding: clamp(4rem, 9vw, 9rem) clamp(1.25rem, 5vw, 5rem); }
  .cover__copy > p, .section-label { margin: 0 0 1rem; font-size: .7rem; font-weight: 900; letter-spacing: .2em; text-transform: uppercase; }
  .cover h1 { margin: 0; font-size: clamp(4rem, 10.5vw, 10rem); line-height: .78; letter-spacing: -.075em; text-transform: uppercase; }
  .cover h1 em { color: var(--gold); font-family: Georgia, serif; font-weight: 400; }
  .cover blockquote { max-width: 600px; margin: 2rem 0 0; padding-left: 1rem; border-left: 5px solid var(--gold); font: italic clamp(1.15rem, 2.2vw, 2rem)/1.3 Georgia, serif; }
  .cover__index { position: absolute; right: 1rem; bottom: 1rem; display: grid; gap: .35rem; text-align: right; font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .cover__index b { display: inline-block; min-width: 3ch; color: var(--gold); font-size: 1rem; }
  .art-credit { position: absolute; right: 1rem; top: 1rem; margin: 0; font-size: .54rem; letter-spacing: .15em; writing-mode: vertical-rl; }
  .era-rail { display: flex; overflow-x: auto; color: var(--chalk); background: var(--burnt); border-top: 5px solid var(--gold); scrollbar-width: thin; }
  .era-rail span { flex: 1 0 auto; padding: .8rem 1.2rem; border-right: 1px solid rgba(255,255,255,.35); font-size: .62rem; font-weight: 900; letter-spacing: .11em; }
  .opening { display: grid; grid-template-columns: minmax(160px, 1fr) minmax(0, 3fr); gap: 2rem; padding: clamp(4rem, 9vw, 9rem) clamp(1.2rem, 6vw, 7rem); }
  .opening h2, .objects__head h2, .song h2, .machine h2, .present h2, .ending h2 { margin: 0 0 2rem; font-size: clamp(3rem, 7vw, 7.2rem); line-height: .86; letter-spacing: -.065em; text-transform: uppercase; }
  h2 em { color: var(--burnt); font-family: Georgia, serif; font-weight: 400; text-transform: none; }
  .opening .lead { margin: 0 0 1.4rem; font: 700 clamp(1.5rem, 3.3vw, 3rem)/1.12 Georgia, serif; }
  .opening div > p:not(.lead), .present header > p, .present__close p, .ending p { max-width: 760px; font: 1.05rem/1.65 Georgia, serif; }
  .opening blockquote, .present__close blockquote { max-width: 740px; margin: 2rem 0 0; padding: 1.25rem 0 1.25rem 1.4rem; border-left: 8px solid var(--burnt); font: italic 1.5rem/1.35 Georgia, serif; }
  .ledger { display: grid; grid-template-columns: repeat(6, 1fr); border-block: 1px solid #806e5b; background: #ead8b6; }
  .ledger div { min-height: 132px; display: flex; flex-direction: column; justify-content: space-between; padding: 1rem; border-right: 1px solid #806e5b; }
  .ledger strong { color: var(--burnt); font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.06em; }
  .ledger span { font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .objects { padding: clamp(4rem, 8vw, 8rem) 0 0; background: #f6ead3; }
  .objects__head { display: grid; grid-template-columns: 1fr 2.7fr 1fr; gap: 2rem; align-items: end; padding: 0 clamp(1.2rem, 6vw, 7rem) 4rem; }
  .objects__head h2 { margin: 0; }
  .objects__head > p:last-child { font: italic 1.1rem/1.5 Georgia, serif; }
  .object-list { border-top: 1px solid #806e5b; }
  .object-card { display: grid; grid-template-columns: minmax(230px, 1fr) minmax(0, 3fr); border-bottom: 1px solid #806e5b; }
  .object-card:nth-child(3n + 1) header { background: var(--burnt); color: var(--chalk); }
  .object-card:nth-child(3n + 2) header { background: var(--blue); color: var(--chalk); }
  .object-card:nth-child(3n) header { background: var(--gold); color: var(--night); }
  .object-card header { min-height: 360px; display: grid; grid-template-rows: auto auto 1fr; padding: 1.4rem; }
  .object-card header > span { font-size: clamp(4rem, 9vw, 9rem); font-weight: 900; line-height: .8; letter-spacing: -.08em; opacity: .9; }
  .object-card header p { margin: 1rem 0; font-size: .72rem; font-weight: 900; letter-spacing: .15em; }
  .object-card header h3 { align-self: end; max-width: 11ch; margin: 0; font: italic clamp(1.7rem, 3vw, 3.4rem)/1 Georgia, serif; }
  .object-card__body { padding: clamp(2rem, 5vw, 5rem); background: var(--cream); }
  .object-card__body h4 { max-width: 900px; margin: 0 0 1.5rem; font-size: clamp(2rem, 4.3vw, 4.8rem); line-height: .95; letter-spacing: -.05em; }
  .object-card__body > p { max-width: 820px; font: 1.05rem/1.7 Georgia, serif; }
  .object-card__body blockquote { max-width: 760px; margin: 2rem 0; padding-left: 1rem; border-left: 5px solid var(--burnt); font: italic 1.35rem/1.4 Georgia, serif; }
  .object-card__body a, .song a { display: inline-block; padding-bottom: .25rem; color: inherit; border-bottom: 2px solid var(--burnt); font-size: .66rem; font-weight: 900; letter-spacing: .1em; text-decoration: none; }
  .song { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(0, 2.3fr); color: var(--chalk); background: var(--night); }
  .song__mark { min-height: 650px; display: flex; flex-direction: column; justify-content: space-between; padding: 2rem; color: var(--night); background: var(--gold); }
  .song__mark span { font: 12rem/1 Georgia, serif; }
  .song__mark b { font-size: clamp(4rem, 9vw, 9rem); letter-spacing: -.08em; }
  .song__copy { padding: clamp(3rem, 8vw, 8rem); }
  .song__copy p:not(.section-label) { max-width: 820px; font: 1.05rem/1.7 Georgia, serif; }
  .song a { margin-top: 1.5rem; color: var(--gold); border-color: var(--gold); }
  .machine { padding: clamp(4rem, 8vw, 8rem) clamp(1.2rem, 6vw, 7rem); background: var(--blue); color: var(--chalk); }
  .machine > header { display: grid; grid-template-columns: 1fr 3fr; gap: 2rem; }
  .machine__grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid rgba(255,255,255,.5); }
  .machine__grid article { min-height: 340px; padding: 1.25rem; border-right: 1px solid rgba(255,255,255,.5); }
  .machine__grid span { color: var(--gold); font-size: 3rem; font-weight: 900; }
  .machine__grid h3 { margin: 4rem 0 1rem; font-size: 1.5rem; line-height: 1; }
  .machine__grid p { font: .95rem/1.55 Georgia, serif; }
  .present { padding: clamp(4rem, 9vw, 9rem) clamp(1.2rem, 6vw, 7rem); background: var(--cream); }
  .present > header { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
  .present > header .section-label { grid-column: 1 / -1; }
  .schedule-board { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 4rem; border: 1px solid #806e5b; }
  .schedule-board article { min-height: 210px; display: flex; flex-direction: column; padding: 1rem; border-right: 1px solid #806e5b; border-bottom: 1px solid #806e5b; }
  .schedule-board span { color: var(--burnt); font-size: .7rem; font-weight: 900; letter-spacing: .14em; }
  .schedule-board h3 { margin: 2.2rem 0 .35rem; font-size: clamp(1.8rem, 3.2vw, 3.5rem); line-height: .95; }
  .schedule-board p { margin: 0; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .schedule-board strong { margin-top: auto; font: italic 1rem/1.3 Georgia, serif; }
  .present__close { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 4rem; }
  .ending { padding: clamp(5rem, 11vw, 11rem) clamp(1.2rem, 9vw, 11rem); color: var(--chalk); background: var(--burnt); }
  .ending h2 { max-width: 1100px; }
  .ending h2 em { color: var(--gold); }
  .ending p { margin-left: auto; color: var(--chalk); }
  .sources { padding: 2rem clamp(1.2rem, 6vw, 7rem); color: var(--chalk); background: var(--night); border-top: 1px solid rgba(255,255,255,.35); }
  .sources summary { cursor: pointer; font-size: .7rem; font-weight: 900; letter-spacing: .14em; }
  .sources ol { columns: 2; gap: 3rem; padding-left: 1.3rem; }
  .sources li { break-inside: avoid; margin: 1rem 0; padding-left: .5rem; font-size: .75rem; }
  .sources a { color: var(--chalk); }
  .sources span { display: block; margin-top: .25rem; color: #c7bba7; font-size: .62rem; letter-spacing: .06em; }
  .issue-footer { padding: 2.5rem clamp(1.2rem, 6vw, 7rem); color: var(--night); background: var(--gold); }
  .issue-footer p { font-size: .68rem; font-weight: 900; letter-spacing: .14em; }
  .issue-footer div { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0; }
  .issue-footer a { color: inherit; font-size: .7rem; font-weight: 900; text-decoration: none; border-bottom: 2px solid; }
  .issue-footer small { display: block; max-width: 1000px; font: .72rem/1.5 Georgia, serif; }
  @media (max-width: 850px) {
    .mast { grid-template-columns: 1fr auto; }
    .mast > span { display: none; }
    .mast nav a:nth-child(-n+2) { display: none; }
    .cover { min-height: 780px; }
    .cover__copy { padding-bottom: 8rem; }
    .opening, .objects__head, .present > header, .machine > header { grid-template-columns: 1fr; }
    .ledger { grid-template-columns: repeat(3, 1fr); }
    .object-card, .song { grid-template-columns: 1fr; }
    .object-card header { min-height: 250px; }
    .song__mark { min-height: 300px; }
    .song__mark span { font-size: 7rem; }
    .machine__grid { grid-template-columns: 1fr 1fr; }
    .schedule-board { grid-template-columns: 1fr 1fr; }
    .present__close { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cover h1 { font-size: 3.45rem; }
    .cover__index { left: 1rem; right: auto; text-align: left; }
    .ledger { grid-template-columns: 1fr 1fr; }
    .ledger div { min-height: 112px; }
    .objects__head { gap: .5rem; }
    .object-card header { min-height: 220px; }
    .machine__grid, .schedule-board { grid-template-columns: 1fr; }
    .sources ol { columns: 1; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; } }
</style>
