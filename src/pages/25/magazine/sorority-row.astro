---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { ROW_BY_ROW, ROW_BY_ROW_SOURCES } from '../../../lib/pointcast-sorority-row';

const sourceById = new Map(ROW_BY_ROW_SOURCES.map((source) => [source.id, source]));
const getSource = (id: string) => {
  const source = sourceById.get(id);
  if (!source) throw new Error(`Unknown ROW / ROW source: ${id}`);
  return source;
};

const description =
  'PointCast puts Sorority Row on the architect’s table: an SEC–Big Ten social-infrastructure showdown, a current field report on national and local Greek life, and three practical playbooks for 2030.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ROW_BY_ROW.title,
  alternativeHeadline: ROW_BY_ROW.subtitle,
  description,
  datePublished: ROW_BY_ROW.publishedAt,
  dateModified: ROW_BY_ROW.publishedAt,
  mainEntityOfPage: ROW_BY_ROW.canonical,
  isPartOf: {
    '@type': 'PublicationIssue',
    name: `PointCast College Football — Issue ${ROW_BY_ROW.issue}`,
    url: ROW_BY_ROW.magazine,
  },
  author: {
    '@type': 'Person',
    name: 'Michael Hoydich',
  },
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  image: 'https://pointcast.xyz/images/pointcast-sorority-row/social-card.png',
  about: [
    'Fraternities and sororities',
    'College football',
    'Campus architecture',
    'National Panhellenic Conference',
    'National Pan-Hellenic Council',
    'North American Interfraternity Conference',
  ],
};
---

<BlockLayout
  title={`${ROW_BY_ROW.title} — Sorority Row and the Social Architecture of 2030`}
  description={description}
  image="/images/pointcast-sorority-row/social-card.png"
  themeColor="#ff5b46"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/sorority-row.json',
      title: 'ROW / ROW machine edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="row-story" data-row-story data-architect-mode="street" data-conference="all">
    <header class="utility">
      <a href="/25/magazine">← ISSUE {ROW_BY_ROW.issue}</a>
      <span>{ROW_BY_ROW.kicker} · {ROW_BY_ROW.readingTime}</span>
      <a href="/25/magazine/sorority-row.json">JSON ↗</a>
    </header>

    <section class="hero" aria-labelledby="row-title">
      <div class="hero__wash hero__wash--one" aria-hidden="true"></div>
      <div class="hero__wash hero__wash--two" aria-hidden="true"></div>
      <div class="hero__copy">
        <p class="eyebrow">HOUSE DESK 002 · ARCHITECTURE / POWER / SATURDAY</p>
        <h1 id="row-title">
          <span>ROW</span>
          <i>/</i>
          <span>ROW</span>
        </h1>
        <p class="hero__subtitle">{ROW_BY_ROW.subtitle}</p>
        <p class="hero__byline">A FIELD REPORT BY MICHAEL HOYDICH · 8 IMAGINED MIDJOURNEY PLATES</p>
        <blockquote>“{ROW_BY_ROW.thesis}”</blockquote>
      </div>
      <div class="hero__images" aria-label="Imagined SEC and Big Ten row studies">
        <figure class="hero__plate hero__plate--south">
          <img
            src={ROW_BY_ROW.plates[0].image}
            alt={ROW_BY_ROW.plates[0].alt}
            width="1536"
            height="1024"
          />
          <figcaption>SEC / PORCH WEATHER</figcaption>
        </figure>
        <figure class="hero__plate hero__plate--north">
          <img
            src={ROW_BY_ROW.plates[1].image}
            alt={ROW_BY_ROW.plates[1].alt}
            width="1536"
            height="1024"
          />
          <figcaption>BIG TEN / VESTIBULE WEATHER</figcaption>
        </figure>
      </div>
      <a class="hero__door" href="#architect-table">PUT IT ON THE TABLE ↓</a>
    </section>

    <section class="architect-bar" id="architect-table" aria-labelledby="architect-title">
      <div>
        <p>ARCHITECT MODE</p>
        <h2 id="architect-title">A house changes when you change the scale.</h2>
      </div>
      <div class="architect-bar__controls" role="group" aria-label="Choose an architectural reading">
        {ROW_BY_ROW.viewModes.map((mode, index) => (
          <button
            type="button"
            data-architect-button={mode.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            {mode.label}
          </button>
        ))}
      </div>
      <p class="architect-bar__note" data-view-note>{ROW_BY_ROW.viewModes[0].note}</p>
    </section>

    <section class="opening" aria-labelledby="opening-title">
      <div class="opening__index">00 / BEFORE THE MATCHUP</div>
      <div class="opening__copy">
        <p class="eyebrow">THE HOUSE IS AN ARGUMENT</p>
        <h2 id="opening-title">The facade is only the first witness.</h2>
        <p class="lede">{ROW_BY_ROW.deck}</p>
        <div class="opening__columns">
          <p>
            Sorority Row is often photographed as a string of facades: columns,
            lawns, brick, white paint, flowers, bodies arranged on steps. The
            architectural reading begins where the photograph usually stops.
            Who owns the building? Who pays to enter it? Which council has an
            address? Where does the route home begin? Who maintains the kitchen
            after the image is taken?
          </p>
          <p>
            College football makes those questions louder. On Saturday, the
            chapter house becomes gate, costume room, hospitality suite,
            alumni club, transit stop, and neighborhood amplifier. The game
            does not create the social system. It reveals the system at full
            volume.
          </p>
        </div>
        <p class="boundary-note">{ROW_BY_ROW.sampleBoundary}</p>
      </div>
    </section>

    <section class="showdown" aria-labelledby="showdown-title">
      <header class="showdown__header">
        <div>
          <p>POINTCAST DESIGN MATCHUP</p>
          <h2 id="showdown-title">{ROW_BY_ROW.showdown.title}</h2>
        </div>
        <p>{ROW_BY_ROW.showdown.note}</p>
        <div class="showdown__controls" role="group" aria-label="Spotlight a conference lens">
          <button type="button" data-conference-button="sec" aria-pressed="false">SEC</button>
          <button type="button" data-conference-button="all" aria-pressed="true">BOTH</button>
          <button type="button" data-conference-button="big-ten" aria-pressed="false">BIG TEN</button>
        </div>
      </header>

      <div class="showdown__sides">
        <article class="conference conference--sec" data-conference-card="sec">
          <span class="conference__ghost">SEC</span>
          <p>{ROW_BY_ROW.showdown.sec.climate}</p>
          <h3>{ROW_BY_ROW.showdown.sec.socialUnit}</h3>
          <dl>
            <div>
              <dt>INHERITED STRENGTH</dt>
              <dd>{ROW_BY_ROW.showdown.sec.inheritedStrength}</dd>
            </div>
            <div>
              <dt>PRESSURE POINT</dt>
              <dd>{ROW_BY_ROW.showdown.sec.pressurePoint}</dd>
            </div>
            <div>
              <dt>2030 MOVE</dt>
              <dd>{ROW_BY_ROW.showdown.sec.move2030}</dd>
            </div>
          </dl>
        </article>
        <div class="showdown__slash" aria-hidden="true">/</div>
        <article class="conference conference--big-ten" data-conference-card="big-ten">
          <span class="conference__ghost">B1G</span>
          <p>{ROW_BY_ROW.showdown.bigTen.climate}</p>
          <h3>{ROW_BY_ROW.showdown.bigTen.socialUnit}</h3>
          <dl>
            <div>
              <dt>INHERITED STRENGTH</dt>
              <dd>{ROW_BY_ROW.showdown.bigTen.inheritedStrength}</dd>
            </div>
            <div>
              <dt>PRESSURE POINT</dt>
              <dd>{ROW_BY_ROW.showdown.bigTen.pressurePoint}</dd>
            </div>
            <div>
              <dt>2030 MOVE</dt>
              <dd>{ROW_BY_ROW.showdown.bigTen.move2030}</dd>
            </div>
          </dl>
        </article>
      </div>

      <div class="rounds" role="table" aria-label="SEC and Big Ten architecture matchup">
        <div class="rounds__head" role="row">
          <span role="columnheader">ROUND</span>
          <span role="columnheader">SEC</span>
          <span role="columnheader">BIG TEN</span>
          <span role="columnheader">CALL</span>
        </div>
        {ROW_BY_ROW.showdown.rounds.map((round, index) => (
          <div class="rounds__row" role="row">
            <span role="cell"><b>{String(index + 1).padStart(2, '0')}</b>{round.category}</span>
            <span role="cell">{round.sec}</span>
            <span role="cell">{round.bigTen}</span>
            <strong role="cell">{round.call}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="plate plate--wide" aria-labelledby="architect-cut-title">
      <figure>
        <img
          src={ROW_BY_ROW.plates[2].image}
          alt={ROW_BY_ROW.plates[2].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>
          <span>PLATE {ROW_BY_ROW.plates[2].number} · {ROW_BY_ROW.plates[2].moment}</span>
          <p>{ROW_BY_ROW.plates[2].caption}</p>
        </figcaption>
      </figure>
      <div class="plate__copy">
        <p>ARCHITECT’S NOTE</p>
        <h2 id="architect-cut-title">{ROW_BY_ROW.plates[2].name}</h2>
        <p>{ROW_BY_ROW.plates[2].designRead}</p>
        <ul class="room-key" aria-label="Rooms in the 2030 house proposal">
          <li><span>01</span>PUBLIC KITCHEN</li>
          <li><span>02</span>QUIET FLOOR</li>
          <li><span>03</span>RITUAL ROOM</li>
          <li><span>04</span>WELLNESS ROOM</li>
          <li><span>05</span>REPAIR / TOOL LIBRARY</li>
          <li><span>06</span>COURTYARD + RAIN GARDEN</li>
          <li><span>07</span>REHEARSAL ROOM</li>
          <li><span>08</span>EQUIVALENT ACCESS ROUTE</li>
        </ul>
      </div>
    </section>

    <section class="field-state" aria-labelledby="field-state-title">
      <header>
        <p>THE MODERN FIELD / DATED SNAPSHOTS</p>
        <h2 id="field-state-title">Large enough to be infrastructure.</h2>
        <p>
          These figures come from official school reports with different
          dates and definitions. Read them as scale signals, not a normalized
          conference ranking.
        </p>
      </header>
      <div class="campus-grid">
        {ROW_BY_ROW.campusSnapshots.map((campus) => {
          const source = getSource(campus.sourceId);
          return (
            <article data-campus-conference={campus.conference === 'SEC' ? 'sec' : 'big-ten'}>
              <div>
                <span>{campus.conference}</span>
                <small>{campus.asOf}</small>
              </div>
              <h3>{campus.school}</h3>
              <strong>{campus.figure}</strong>
              <p class="campus-grid__label">{campus.label}</p>
              <p>{campus.detail}</p>
              <a href={source.url} rel="noreferrer">Official source ↗</a>
            </article>
          );
        })}
      </div>
    </section>

    <section class="housing-gap" aria-labelledby="housing-gap-title">
      <div class="housing-gap__copy">
        <p>THE ARCHITECTURAL POWER MAP</p>
        <h2 id="housing-gap-title">A council without a house is still a council. It is simply asked to make culture without comparable real estate.</h2>
        <p>{ROW_BY_ROW.housingGap.read}</p>
        <a href={getSource(ROW_BY_ROW.housingGap.sourceId).url} rel="noreferrer">
          University of Michigan community statistics ↗
        </a>
      </div>
      <div class="housing-gap__chart" aria-label="Recognized chapter housing facilities at Michigan in Winter 2026">
        {ROW_BY_ROW.housingGap.figures.map((item) => (
          <div class:list={['housing-gap__bar', { 'housing-gap__bar--zero': item.houses === 0 }]}>
            <span>{item.council}</span>
            <i style={`--houses:${item.houses}`} aria-hidden="true"></i>
            <strong>{item.houses}</strong>
          </div>
        ))}
        <p>RECOGNIZED CHAPTER HOUSING FACILITIES · WINTER 2026</p>
      </div>
    </section>

    <section class="plate plate--threshold" aria-labelledby="threshold-title">
      <figure>
        <img
          src={ROW_BY_ROW.plates[3].image}
          alt={ROW_BY_ROW.plates[3].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>
          <span>PLATE {ROW_BY_ROW.plates[3].number} · {ROW_BY_ROW.plates[3].moment}</span>
          <p>{ROW_BY_ROW.plates[3].caption}</p>
        </figcaption>
      </figure>
      <div class="plate__copy">
        <p>THE FIRST CONTRACT</p>
        <h2 id="threshold-title">{ROW_BY_ROW.plates[3].name}</h2>
        <p>{ROW_BY_ROW.plates[3].designRead}</p>
        <blockquote>
          The National Panhellenic Conference’s own 2025 access guide identifies
          unclear cost, hidden time commitments, physical barriers, and uneven
          event-space quality as obstacles to joining.
        </blockquote>
        <a href={getSource('npc-barriers').url} rel="noreferrer">Read the NPC access guide ↗</a>
      </div>
    </section>

    <section class="saturday-pair" aria-labelledby="saturday-title">
      <header>
        <p>SATURDAY IS A STRESS TEST</p>
        <h2 id="saturday-title">Same voltage. Different weatherproofing.</h2>
      </header>
      <div class="saturday-pair__grid">
        {ROW_BY_ROW.plates.slice(4, 6).map((plate) => (
          <article>
            <figure>
              <img src={plate.image} alt={plate.alt} width="1536" height="1024" loading="lazy" />
              <figcaption>PLATE {plate.number} · {plate.moment}</figcaption>
            </figure>
            <h3>{plate.name}</h3>
            <p>{plate.caption}</p>
            <p>{plate.designRead}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="national-field" aria-labelledby="national-field-title">
      <header>
        <p>NATIONAL SCALE / LOCAL CONSEQUENCE</p>
        <h2 id="national-field-title">There is no single “Greek life.”</h2>
        <p>
          The modern field is a plural system of councils, headquarters,
          campus chapters, local organizations, alumni corporations, property
          owners, and universities. The familiar row represents only part of it.
        </p>
      </header>
      <div class="national-field__numbers">
        {ROW_BY_ROW.nationalScale.map((item) => (
          <article>
            <span>{item.short}</span>
            <strong>{item.figure}</strong>
            <p>{item.label}</p>
            <small>{item.detail}</small>
            <a href={getSource(item.sourceId).url} rel="noreferrer">Source ↗</a>
          </article>
        ))}
      </div>

      <div class="models" aria-label="Organization model comparison">
        {ROW_BY_ROW.organizationModels.map((model, index) => (
          <article class={`model model--${model.id}`}>
            <div class="model__number">{String(index + 1).padStart(2, '0')}</div>
            <p>{model.label}</p>
            <h3>{model.promise}</h3>
            <div class="model__columns">
              <div>
                <h4>WHAT IT CAN HOLD</h4>
                <ul>{model.assets.map((asset) => <li>{asset}</li>)}</ul>
              </div>
              <div>
                <h4>WHAT CAN BREAK</h4>
                <ul>{model.risks.map((risk) => <li>{risk}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="origin-line" aria-labelledby="origin-title">
      <header>
        <p>ORIGINS / PUBLIC HISTORY / LIVING TRADITION</p>
        <h2 id="origin-title">The letters changed before the houses did.</h2>
        <p>{ROW_BY_ROW.traditionBoundary}</p>
      </header>
      <ol>
        {ROW_BY_ROW.timeline.map((event) => (
          <li>
            <div class="origin-line__year">{event.year}</div>
            <div>
              <h3>{event.title}</h3>
              <p>{event.body}</p>
              {event.sourceId !== 'pointcast' && (
                <a href={getSource(event.sourceId).url} rel="noreferrer">Source ↗</a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="missing-house" aria-labelledby="missing-house-title">
      <figure>
        <img
          src={ROW_BY_ROW.plates[6].image}
          alt={ROW_BY_ROW.plates[6].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>PLATE {ROW_BY_ROW.plates[6].number} · {ROW_BY_ROW.plates[6].moment}</figcaption>
      </figure>
      <div>
        <p>CAPITAL IS A TRADITION TOO</p>
        <h2 id="missing-house-title">{ROW_BY_ROW.plates[6].name}</h2>
        <blockquote>“{ROW_BY_ROW.plates[6].caption}”</blockquote>
        <p>{ROW_BY_ROW.plates[6].designRead}</p>
        <p>
          The NPHC was founded in 1930 in response to an academic world
          structured by racial exclusion. Its public tradition joins
          scholarship, service, cultural preservation, advocacy, and lifelong
          membership. A 2030 campus should fund the spaces those practices
          require without treating another council’s mansion as the default
          architectural answer.
        </p>
        <a href={getSource('nphc-about').url} rel="noreferrer">NPHC history and mission ↗</a>
      </div>
    </section>

    <section class="law-line" aria-labelledby="law-title">
      <div class="law-line__stamp">PUBLIC LAW<br />118–173</div>
      <div>
        <p>THE MODERN SAFETY FLOOR</p>
        <h2 id="law-title">A ritual can remain private. Its safety contract cannot.</h2>
        <p>
          The Stop Campus Hazing Act became law on December 23, 2024. It adds
          hazing incidents to campus security reporting and requires covered
          institutions to disclose current hazing policy, reporting,
          investigation, and prevention information. The law applies across
          student organizations—not only fraternities and sororities.
        </p>
        <a href={getSource('stop-campus-hazing').url} rel="noreferrer">
          Read the law and CRS summary ↗
        </a>
      </div>
    </section>

    <section class="playbooks" aria-labelledby="playbooks-title">
      <header>
        <p>THREE PLAYBOOKS / NOW → 2030</p>
        <h2 id="playbooks-title">Do not wait for the future house to start changing the contract.</h2>
      </header>
      <div class="playbooks__list">
        {ROW_BY_ROW.playbooks.map((playbook) => (
          <article>
            <div class="playbook__top">
              <span>{playbook.number}</span>
              <p>{playbook.horizon}</p>
            </div>
            <h3>{playbook.name}</h3>
            <blockquote>{playbook.wager}</blockquote>
            <ol>
              {playbook.moves.map((move, index) => (
                <li><b>{String(index + 1).padStart(2, '0')}</b>{move}</li>
              ))}
            </ol>
            <p class="playbook__measure"><strong>PROOF:</strong> {playbook.measure}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="future-row" aria-labelledby="future-title">
      <figure>
        <img
          src={ROW_BY_ROW.plates[7].image}
          alt={ROW_BY_ROW.plates[7].alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>PLATE {ROW_BY_ROW.plates[7].number} · {ROW_BY_ROW.plates[7].moment}</figcaption>
      </figure>
      <div class="future-row__copy">
        <p>THE FINAL RENDER IS A GOVERNANCE DIAGRAM</p>
        <h2 id="future-title">{ROW_BY_ROW.plates[7].name}</h2>
        <p>{ROW_BY_ROW.plates[7].caption}</p>
        <p>{ROW_BY_ROW.plates[7].designRead}</p>
        <ul>
          {ROW_BY_ROW.principles2030.map((principle, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{principle}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p>RECEIPT WALL</p>
        <h2 id="sources-title">The rendering is speculative. The field report keeps its sources.</h2>
      </header>
      <ol>
        {ROW_BY_ROW_SOURCES.filter((source) => source.id !== 'pointcast').map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{source.label}</h3>
              <p>{source.publisher} · {source.date}</p>
              <small>{source.supports.join(' · ')}</small>
            </div>
            <a href={source.url} rel="noreferrer" aria-label={`Open ${source.label}`}>↗</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="editorial-note" aria-labelledby="editorial-note-title">
      <p>EDITORIAL + VISUAL BOUNDARY</p>
      <h2 id="editorial-note-title">A design reading, not a chapter directory.</h2>
      <p>{ROW_BY_ROW.boundary}</p>
      <dl>
        <div>
          <dt>CONCEPT + EDITORIAL DIRECTION</dt>
          <dd>{ROW_BY_ROW.credits.conceptAndEditorialDirection}</dd>
        </div>
        <div>
          <dt>RESEARCH + WRITING + DESIGN + BUILD</dt>
          <dd>{ROW_BY_ROW.credits.researchWritingDesignAndImplementation}</dd>
        </div>
        <div>
          <dt>IMAGE DIRECTION</dt>
          <dd>{ROW_BY_ROW.credits.imageDirection}</dd>
        </div>
        <div>
          <dt>IMAGE GENERATION</dt>
          <dd>{ROW_BY_ROW.credits.imageGeneration} · {ROW_BY_ROW.credits.imageCount} selected plates</dd>
        </div>
      </dl>
      <p class="editorial-note__small">
        Midjourney job IDs, image indices, prompt summaries, source records,
        dated-field boundaries, and editorial flags travel with the
        <a href="/25/magazine/sorority-row.json"> JSON edition ↗</a>.
      </p>
    </section>

    <footer class="closing">
      <div>
        <span>POINTCAST COLLEGE FOOTBALL</span>
        <strong>HOUSE DESK 002 · BLOCK {ROW_BY_ROW.block}</strong>
      </div>
      <nav aria-label="ROW / ROW closing links">
        <a href="/25/magazine/the-house-we-borrowed">The House We Borrowed</a>
        <a href="/25/magazine">Issue 001</a>
        <a href={`/b/${ROW_BY_ROW.block}`}>Permanent Block</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<script define:vars={{ viewModes: ROW_BY_ROW.viewModes }}>
  const story = document.querySelector('[data-row-story]');
  const architectButtons = Array.from(document.querySelectorAll('[data-architect-button]'));
  const note = document.querySelector('[data-view-note]');
  const conferenceButtons = Array.from(document.querySelectorAll('[data-conference-button]'));

  architectButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.getAttribute('data-architect-button') || 'street';
      story?.setAttribute('data-architect-mode', mode);
      architectButtons.forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      });
      const active = viewModes.find((item) => item.id === mode);
      if (note && active) note.textContent = active.note;
    });
  });

  conferenceButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const conference = button.getAttribute('data-conference-button') || 'all';
      story?.setAttribute('data-conference', conference);
      conferenceButtons.forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === button));
      });
    });
  });
</script>

<style>
  :global(html) {
    background: #efe9dc;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #efe9dc;
    color: #171713;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    color: inherit;
  }

  .row-story {
    --ink: #171713;
    --paper: #efe9dc;
    --acid: #e7ff42;
    --coral: #ff5b46;
    --sec: #fc5f3f;
    --big: #254ae8;
    --blue-paper: #cdd8ff;
    --rule: rgba(23, 23, 19, 0.24);
    overflow: clip;
  }

  .utility {
    align-items: center;
    background: var(--ink);
    color: #fff;
    display: grid;
    font-size: 0.65rem;
    font-weight: 800;
    gap: 1rem;
    grid-template-columns: auto 1fr auto;
    letter-spacing: 0.12em;
    padding: 0.85rem clamp(1rem, 3vw, 3rem);
    position: relative;
    z-index: 8;
  }

  .utility span {
    text-align: center;
  }

  .utility a {
    text-decoration: none;
  }

  .hero {
    background: #151616;
    color: #fff;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: min(880px, 92svh);
    overflow: hidden;
    position: relative;
  }

  .hero__wash {
    border-radius: 999px;
    filter: blur(80px);
    opacity: 0.5;
    position: absolute;
  }

  .hero__wash--one {
    background: var(--sec);
    height: 28rem;
    left: -10rem;
    top: 4rem;
    width: 28rem;
  }

  .hero__wash--two {
    background: var(--big);
    bottom: -12rem;
    height: 30rem;
    right: 20%;
    width: 30rem;
  }

  .hero__copy {
    align-self: center;
    min-width: 0;
    padding: clamp(3rem, 8vw, 8rem) clamp(1.2rem, 5vw, 5rem);
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .hero__byline {
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero h1 {
    align-items: center;
    display: flex;
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(5.2rem, 13vw, 12.5rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.72;
    margin: 1.4rem 0 2rem;
    text-transform: uppercase;
  }

  .hero h1 span:last-child {
    color: var(--acid);
  }

  .hero h1 i {
    color: var(--coral);
    font-family: Georgia, serif;
    font-size: 0.55em;
    font-weight: 400;
    margin: 0 0.04em;
  }

  .hero__subtitle {
    font-family: Georgia, serif;
    font-size: clamp(1.2rem, 2.3vw, 2rem);
    line-height: 1.2;
    margin: 0 0 1.5rem;
    max-width: 30rem;
  }

  .hero__byline {
    color: #bcbcb4;
  }

  .hero blockquote {
    border-left: 5px solid var(--acid);
    font-family: Georgia, serif;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    margin: 3rem 0 0;
    max-width: 38rem;
    padding-left: 1.3rem;
  }

  .hero__images {
    min-height: 660px;
    min-width: 0;
    position: relative;
  }

  .hero__plate {
    background: #292929;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.5);
    margin: 0;
    overflow: hidden;
    position: absolute;
  }

  .hero__plate img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .hero__plate figcaption {
    background: rgba(16, 16, 15, 0.82);
    bottom: 0;
    font-size: 0.6rem;
    font-weight: 900;
    left: 0;
    letter-spacing: 0.13em;
    padding: 0.75rem 1rem;
    position: absolute;
  }

  .hero__plate--south {
    height: 54%;
    left: 2%;
    top: 7%;
    transform: rotate(-2deg);
    width: 75%;
    z-index: 2;
  }

  .hero__plate--north {
    bottom: 5%;
    height: 48%;
    right: -3%;
    transform: rotate(2.5deg);
    width: 72%;
    z-index: 3;
  }

  .hero__door {
    background: var(--acid);
    bottom: 0;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 950;
    left: 0;
    letter-spacing: 0.12em;
    padding: 1rem 1.3rem;
    position: absolute;
    text-decoration: none;
    z-index: 4;
  }

  .architect-bar {
    align-items: center;
    background: var(--acid);
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(15rem, 1fr) auto minmax(16rem, 1fr);
    padding: 1.2rem clamp(1rem, 4vw, 4rem);
    position: relative;
  }

  .architect-bar p,
  .architect-bar h2 {
    margin: 0;
  }

  .architect-bar > div:first-child p {
    font-size: 0.6rem;
    font-weight: 950;
    letter-spacing: 0.16em;
  }

  .architect-bar h2 {
    font-family: Georgia, serif;
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 400;
    margin-top: 0.25rem;
  }

  .architect-bar__controls {
    display: flex;
  }

  .architect-bar__controls button {
    background: transparent;
    border: 1px solid var(--ink);
    border-right: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.75rem 1rem;
    text-transform: uppercase;
  }

  .architect-bar__controls button:last-child {
    border-right: 1px solid var(--ink);
  }

  .architect-bar__controls button span {
    font-size: 0.48rem;
    margin-right: 0.35rem;
    opacity: 0.6;
  }

  .architect-bar__controls button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--acid);
  }

  .architect-bar__note {
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .row-story[data-architect-mode="section"] :is(.plate figure, .hero__plate, .missing-house figure, .future-row figure)::after {
    background-image:
      linear-gradient(rgba(231, 255, 66, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(231, 255, 66, 0.18) 1px, transparent 1px);
    background-size: 7% 7%;
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .row-story[data-architect-mode="system"] :is(.campus-grid, .national-field__numbers, .housing-gap__chart) {
    box-shadow: 0 0 0 5px var(--acid);
  }

  .opening,
  .field-state,
  .national-field,
  .origin-line,
  .playbooks,
  .sources {
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 6vw, 7rem);
  }

  .opening {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(8rem, 0.25fr) minmax(0, 1fr);
  }

  .opening__index {
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .opening__copy > h2,
  .field-state h2,
  .national-field h2,
  .origin-line h2,
  .playbooks h2,
  .sources h2 {
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(3.4rem, 8vw, 8rem);
    letter-spacing: -0.055em;
    line-height: 0.88;
    margin: 0.6rem 0 2rem;
    max-width: 13ch;
    text-transform: uppercase;
  }

  .opening .lede {
    font-family: Georgia, serif;
    font-size: clamp(1.45rem, 3vw, 2.65rem);
    line-height: 1.2;
    max-width: 29ch;
  }

  .opening__columns {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 68rem;
  }

  .opening__columns p,
  .opening .boundary-note {
    font-family: Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .boundary-note {
    background: #fff;
    border-left: 6px solid var(--coral);
    margin-top: 3rem;
    max-width: 58rem;
    padding: 1.25rem 1.4rem;
  }

  .showdown {
    background: var(--ink);
    color: #fff;
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 4rem);
  }

  .showdown__header {
    align-items: end;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.45fr) auto;
    margin-bottom: 3rem;
  }

  .showdown__header p {
    font-size: 0.7rem;
    line-height: 1.5;
    margin: 0;
  }

  .showdown__header > div:first-child > p {
    color: var(--acid);
    font-weight: 900;
    letter-spacing: 0.15em;
  }

  .showdown h2 {
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(3rem, 7vw, 7rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin: 0.5rem 0 0;
  }

  .showdown__controls {
    display: flex;
  }

  .showdown__controls button {
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
    cursor: pointer;
    font-size: 0.62rem;
    font-weight: 900;
    padding: 0.8rem;
  }

  .showdown__controls button[aria-pressed="true"] {
    background: var(--acid);
    color: var(--ink);
  }

  .showdown__sides {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem minmax(0, 1fr);
  }

  .conference {
    min-height: 38rem;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 5rem);
    position: relative;
    transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .conference--sec {
    background: var(--sec);
    color: #25120e;
  }

  .conference--big-ten {
    background: var(--blue-paper);
    color: #081747;
  }

  .conference__ghost {
    bottom: -0.19em;
    color: rgba(255, 255, 255, 0.3);
    font-family: Impact, sans-serif;
    font-size: clamp(10rem, 24vw, 24rem);
    letter-spacing: -0.08em;
    line-height: 0.7;
    position: absolute;
    right: -0.06em;
  }

  .conference > p,
  .conference > h3,
  .conference dl {
    position: relative;
    z-index: 1;
  }

  .conference > p {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference h3 {
    font-family: Georgia, serif;
    font-size: clamp(2.1rem, 4.5vw, 4.8rem);
    line-height: 0.98;
    margin: 1rem 0 4rem;
  }

  .conference dl {
    display: grid;
    gap: 1.2rem;
    max-width: 36rem;
  }

  .conference dl div {
    border-top: 1px solid currentColor;
    padding-top: 0.8rem;
  }

  .conference dt {
    font-size: 0.58rem;
    font-weight: 950;
    letter-spacing: 0.14em;
  }

  .conference dd {
    font-family: Georgia, serif;
    line-height: 1.5;
    margin: 0.45rem 0 0;
  }

  .showdown__slash {
    align-items: center;
    color: var(--acid);
    display: flex;
    font-family: Georgia, serif;
    font-size: 7rem;
    font-style: italic;
    justify-content: center;
  }

  .row-story[data-conference="sec"] .conference--big-ten,
  .row-story[data-conference="big-ten"] .conference--sec {
    filter: grayscale(1);
    opacity: 0.28;
    transform: scale(0.985);
  }

  .rounds {
    border-top: 1px solid #fff;
    margin-top: 4rem;
  }

  .rounds__head,
  .rounds__row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    display: grid;
    gap: 1rem;
    grid-template-columns: 0.8fr 1.2fr 1.2fr 0.45fr;
    padding: 1rem 0;
  }

  .rounds__head {
    color: var(--acid);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .rounds__row {
    font-family: Georgia, serif;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .rounds__row span:first-child {
    font-family: Inter, sans-serif;
    font-weight: 800;
  }

  .rounds__row span:first-child b {
    color: var(--coral);
    margin-right: 0.7rem;
  }

  .rounds__row strong {
    color: var(--acid);
    font-family: Inter, sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .plate {
    align-items: stretch;
    background: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.55fr);
  }

  .plate figure,
  .missing-house figure,
  .future-row figure {
    margin: 0;
    min-height: 34rem;
    overflow: hidden;
    position: relative;
  }

  .plate figure img,
  .missing-house figure img,
  .future-row figure img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .plate figcaption,
  .missing-house figcaption,
  .future-row figcaption {
    background: rgba(20, 20, 17, 0.88);
    bottom: 0;
    color: #fff;
    left: 0;
    padding: 1rem;
    position: absolute;
    right: 0;
  }

  .plate figcaption span,
  .missing-house figcaption,
  .future-row figcaption {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .plate figcaption p {
    font-family: Georgia, serif;
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0.45rem 0 0;
    max-width: 56rem;
  }

  .plate__copy {
    padding: clamp(2rem, 5vw, 5rem);
  }

  .plate__copy > p:first-child,
  .field-state header > p:first-child,
  .national-field header > p:first-child,
  .origin-line header > p:first-child,
  .playbooks header > p:first-child,
  .sources header > p:first-child,
  .future-row__copy > p:first-child,
  .missing-house > div > p:first-child {
    color: var(--coral);
    font-size: 0.64rem;
    font-weight: 950;
    letter-spacing: 0.16em;
  }

  .plate__copy h2 {
    font-family: Impact, sans-serif;
    font-size: clamp(3rem, 6vw, 6rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin: 0.8rem 0 2rem;
  }

  .plate__copy > p:not(:first-child),
  .plate__copy blockquote {
    font-family: Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .room-key {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .room-key li {
    border-top: 1px solid var(--rule);
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.7rem 0;
  }

  .room-key span {
    color: var(--coral);
    display: inline-block;
    width: 2.5rem;
  }

  .field-state {
    background: #efe9dc;
  }

  .field-state header,
  .national-field header {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.45fr);
    margin-bottom: 4rem;
  }

  .field-state header > p:first-child,
  .national-field header > p:first-child {
    grid-column: 1 / -1;
  }

  .field-state header h2,
  .national-field header h2 {
    margin-bottom: 0;
  }

  .field-state header > p:last-child,
  .national-field header > p:last-child {
    align-self: end;
    font-family: Georgia, serif;
    line-height: 1.6;
  }

  .campus-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .campus-grid article {
    background: #fff;
    display: flex;
    flex-direction: column;
    min-height: 24rem;
    padding: 1.5rem;
  }

  .campus-grid article > div {
    display: flex;
    justify-content: space-between;
  }

  .campus-grid article > div span,
  .campus-grid article > div small {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .campus-grid article[data-campus-conference="sec"] > div span {
    color: var(--sec);
  }

  .campus-grid article[data-campus-conference="big-ten"] > div span {
    color: var(--big);
  }

  .campus-grid h3 {
    font-family: Georgia, serif;
    font-size: 1.75rem;
    margin: 2rem 0 auto;
  }

  .campus-grid article > strong {
    font-family: Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    letter-spacing: -0.04em;
  }

  .campus-grid__label {
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  .campus-grid article > p:last-of-type {
    font-family: Georgia, serif;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .campus-grid a,
  .housing-gap a,
  .plate__copy a,
  .missing-house a,
  .law-line a {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    margin-top: 1rem;
  }

  .housing-gap {
    background: var(--blue-paper);
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(22rem, 1.2fr);
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 6vw, 7rem);
  }

  .housing-gap__copy > p:first-child {
    color: var(--big);
    font-size: 0.62rem;
    font-weight: 950;
    letter-spacing: 0.16em;
  }

  .housing-gap h2 {
    font-family: Georgia, serif;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.06;
  }

  .housing-gap__copy > p:not(:first-child) {
    font-family: Georgia, serif;
    line-height: 1.65;
  }

  .housing-gap__chart {
    align-self: center;
    background: #fff;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .housing-gap__bar {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(10rem, 0.85fr) minmax(8rem, 1fr) 2.5rem;
    margin-bottom: 1.2rem;
  }

  .housing-gap__bar span {
    font-size: 0.72rem;
    font-weight: 800;
  }

  .housing-gap__bar i {
    background: var(--big);
    display: block;
    height: 1rem;
    min-width: 3px;
    transform: scaleX(calc(var(--houses) / 17));
    transform-origin: left;
  }

  .housing-gap__bar--zero i {
    background: var(--coral);
  }

  .housing-gap__bar strong {
    font-family: Impact, sans-serif;
    font-size: 1.8rem;
  }

  .housing-gap__chart > p {
    border-top: 1px solid var(--ink);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    padding-top: 1rem;
  }

  .plate--threshold {
    background: #f7c7bb;
    grid-template-columns: minmax(20rem, 0.65fr) minmax(0, 1.35fr);
  }

  .plate--threshold figure {
    order: 2;
  }

  .plate__copy blockquote {
    border-left: 4px solid var(--coral);
    margin: 2rem 0;
    padding-left: 1rem;
  }

  .saturday-pair {
    background: var(--ink);
    color: #fff;
    padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 4rem);
  }

  .saturday-pair > header {
    align-items: end;
    display: grid;
    gap: 2rem;
    grid-template-columns: 0.3fr 1fr;
    margin-bottom: 3rem;
  }

  .saturday-pair header p {
    color: var(--acid);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .saturday-pair h2 {
    font-family: Impact, sans-serif;
    font-size: clamp(3rem, 7vw, 7rem);
    letter-spacing: -0.05em;
    line-height: 0.88;
    margin: 0;
  }

  .saturday-pair__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .saturday-pair article {
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.8rem 0.8rem 2rem;
  }

  .saturday-pair figure {
    aspect-ratio: 3 / 2;
    margin: 0;
    overflow: hidden;
    position: relative;
  }

  .saturday-pair img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .saturday-pair figcaption {
    background: var(--acid);
    bottom: 0;
    color: var(--ink);
    font-size: 0.58rem;
    font-weight: 900;
    left: 0;
    letter-spacing: 0.1em;
    padding: 0.65rem;
    position: absolute;
  }

  .saturday-pair h3 {
    font-family: Impact, sans-serif;
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.04em;
    margin: 1.5rem 1rem 0;
  }

  .saturday-pair article > p {
    font-family: Georgia, serif;
    line-height: 1.6;
    margin: 1rem;
  }

  .national-field {
    background: #fff;
  }

  .national-field__numbers {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 5rem;
  }

  .national-field__numbers article {
    background: var(--paper);
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    padding: 1.5rem;
  }

  .national-field__numbers span {
    color: var(--coral);
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.12em;
