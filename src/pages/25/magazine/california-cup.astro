---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  CALIFORNIA_CUP_FEATURE,
  CALIFORNIA_CUP_GAMES,
  CALIFORNIA_CUP_INVITATION_DIMENSIONS,
  CALIFORNIA_CUP_PRIVACY,
  CALIFORNIA_CUP_PROGRAMS,
  CALIFORNIA_CUP_RULES,
  CALIFORNIA_CUP_SOURCES,
  CALIFORNIA_CUP_STANDINGS,
} from '../../../lib/pointcast-california-cup';

const feature = CALIFORNIA_CUP_FEATURE;
const clientData = {
  games: CALIFORNIA_CUP_GAMES.map((game) => ({
    id: game.id,
    order: game.order,
    date: game.date,
    label: game.label,
    away: game.away,
    awaySlug: game.awaySlug,
    home: game.home,
    homeSlug: game.homeSlug,
  })),
  dimensions: CALIFORNIA_CUP_INVITATION_DIMENSIONS,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: `${feature.title} — ${feature.subtitle}`,
      description: feature.dek,
      url: feature.canonical,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web',
      isAccessibleForFree: true,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      publisher: { '@type': 'Organization', name: 'PointCast' },
    },
    {
      '@type': 'ItemList',
      name: '2026 California Cup schedule',
      numberOfItems: CALIFORNIA_CUP_GAMES.length,
      itemListElement: CALIFORNIA_CUP_GAMES.map((game) => ({
        '@type': 'ListItem',
        position: game.order,
        name: game.game,
        url: feature.canonical,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#d8fa48"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/california-cup.json',
      title: 'California Cup schedule, rules, and standings',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="cup">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · STATE DESK 002</span>
      <nav aria-label="California Cup navigation">
        <a href="#table">TABLE</a>
        <a href="#circuit">CIRCUIT</a>
        <a href="#my-card">MY CARD</a>
        <a href="/25/magazine/california-cup.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="cup-title">
      <div class="hero__paper" aria-hidden="true">
        <span>LOS ANGELES</span><i></i><span>FRESNO</span><i></i><span>SAN JOSÉ</span><i></i><span>BERKELEY</span><i></i><span>SAN DIEGO</span>
      </div>
      <div class="hero__copy">
        <p>POINTCAST PRESEASON BOARD · AS OF {feature.asOf}</p>
        <h1 id="cup-title">THE<br /><em>CALIFORNIA</em><br />CUP</h1>
        <blockquote>“{feature.subtitle}”</blockquote>
        <a href="#circuit">BUILD MY CIRCUIT ↓</a>
      </div>
      <div class="hero__seal" aria-label="California Cup preseason status">
        <span>CALIFORNIA</span>
        <strong>00</strong>
        <b>OF 07 FINAL</b>
        <small>PRESEASON</small>
      </div>
      <div class="hero__ledger">
        <div><strong>07</strong><span>IN-STATE GAMES</span></div>
        <div><strong>08</strong><span>PROGRAMS</span></div>
        <div><strong>02</strong><span>SEPARATE TROPHIES</span></div>
      </div>
    </section>

    <section class="premise" aria-labelledby="premise-title">
      <p class="index">00 / KEEP THE TABLE</p>
      <div>
        <h2 id="premise-title">Who won?<br /><em>Who invited?</em></h2>
        <p>{feature.thesis}</p>
      </div>
      <aside>
        <strong>RESULT ≠ RITUAL</strong>
        <p>
          Football points never change because the hot dog was good. Invitation
          points never pretend the home team won. Two trophies keep both truths.
        </p>
      </aside>
    </section>

    <section class="two-cups" aria-label="California Cup scoring rules">
      <article>
        <span>01 / THE SCOREBOARD</span>
        <h2>{CALIFORNIA_CUP_RULES.footballCup.name}</h2>
        <strong>3 POINTS / WIN</strong>
        <p>{CALIFORNIA_CUP_RULES.footballCup.note}</p>
      </article>
      <article>
        <span>02 / THE INVITATION</span>
        <h2>{CALIFORNIA_CUP_RULES.invitationCup.name}</h2>
        <strong>50 POINTS / HOST</strong>
        <p>{CALIFORNIA_CUP_RULES.invitationCup.note}</p>
      </article>
    </section>

    <section class="table" id="table" aria-labelledby="table-title">
      <header>
        <div>
          <p class="index">01 / PRESEASON TABLE</p>
          <h2 id="table-title">Everybody<br /><em>starts level.</em></h2>
        </div>
        <p>
          The published board moves only after a completed game. Predictions live
          on your circuit card below and never enter these standings.
        </p>
      </header>
      <div class="table__wrap" role="region" aria-label="California Cup standings" tabindex="0">
        <table>
          <thead>
            <tr><th>#</th><th>PROGRAM</th><th>P</th><th>W</th><th>L</th><th>PF</th><th>PA</th><th>PTS</th><th>INV.</th></tr>
          </thead>
          <tbody>
            {CALIFORNIA_CUP_STANDINGS.map((program, index) => (
              <tr style={`--team:${program.primary};--accent:${program.accent}`}>
                <td>{String(index + 1).padStart(2, '0')}</td>
                <th scope="row"><i aria-hidden="true"></i><span>{program.name}</span><small>{program.region}</small></th>
                <td>{program.played}</td><td>{program.wins}</td><td>{program.losses}</td>
                <td>{program.pointsFor}</td><td>{program.pointsAgainst}</td>
                <td><strong>{program.tablePoints}</strong></td><td>—</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table__note">INV. remains blank until a cited postgame field report scores the host invitation.</p>
    </section>

    <section class="dimensions" aria-labelledby="dimensions-title">
      <header>
        <p class="index">02 / FIVE WAYS IN</p>
        <h2 id="dimensions-title">The invitation<br /><em>scorecard.</em></h2>
      </header>
      <ol>
        {CALIFORNIA_CUP_INVITATION_DIMENSIONS.map((dimension, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{dimension.label}</h3>
            <p>{dimension.question}</p>
            <strong>0–10</strong>
          </li>
        ))}
      </ol>
    </section>

    <section class="circuit" id="circuit" aria-labelledby="circuit-title">
      <header>
        <div>
          <p class="index">03 / THE SEVEN-GAME LINE</p>
          <h2 id="circuit-title">Make a private<br /><em>circuit card.</em></h2>
        </div>
        <div class="circuit__privacy">
          <span>ACCOUNT</span><strong>NONE</strong>
          <span>SERVER WRITE</span><strong>NONE</strong>
          <span>DEFAULT</span><strong>PRIVATE</strong>
        </div>
      </header>

      <p class="circuit__intro">
        Pick a winner and the invitation detail you most want PointCast to notice.
        Your choices stay in this browser until you copy, share, or clear them.
      </p>

      <ol class="games">
        {CALIFORNIA_CUP_GAMES.map((game) => {
          const source = CALIFORNIA_CUP_SOURCES.find((entry) => entry.id === game.sourceId);
          return (
            <li class="game" data-game={game.id}>
              <div class="game__rail"><span>{String(game.order).padStart(2, '0')}</span><i aria-hidden="true"></i></div>
              <article>
                <header>
                  <div><span>{game.day}</span><strong>{game.date}</strong></div>
                  <div><span>{game.city}</span><strong>{game.kickoff}</strong></div>
                  <small>{game.label}</small>
                </header>
                <div class="game__matchup">
                  <button type="button" data-pick={game.awaySlug} aria-pressed="false">
                    <span>AWAY</span><strong>{game.away}</strong><small>PICK TO WIN</small>
                  </button>
                  <b>AT</b>
                  <button type="button" data-pick={game.homeSlug} aria-pressed="false">
                    <span>HOME</span><strong>{game.home}</strong><small>PICK TO WIN</small>
                  </button>
                </div>
                <div class="game__watch">
                  <span>WHAT SHOULD THE FIELD REPORT NOTICE?</span>
                  <div>
                    {CALIFORNIA_CUP_INVITATION_DIMENSIONS.map((dimension) => (
                      <button type="button" data-watch={dimension.id} aria-pressed="false">{dimension.label}</button>
                    ))}
                  </div>
                </div>
                <footer>
                  <span>{game.venue}</span>
                  {source && <a href={source.url} target="_blank" rel="noopener">OFFICIAL SCHEDULE ↗</a>}
                </footer>
              </article>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="my-card" id="my-card" aria-labelledby="my-card-title">
      <div class="my-card__ticket">
        <header><span>POINTCAST · STATE DESK 002</span><b>PRIVATE UNTIL SHARED</b></header>
        <h2 id="my-card-title">MY CALIFORNIA<br />CIRCUIT CARD</h2>
        <div class="my-card__score">
          <div><strong data-pick-count>0</strong><span>OF 7 PICKS</span></div>
          <div><strong data-watch-count>0</strong><span>FIELD NOTES</span></div>
        </div>
        <ol data-receipt-list>
          {CALIFORNIA_CUP_GAMES.map((game) => (
            <li><span>{String(game.order).padStart(2, '0')} · {game.date}</span><strong>OPEN PICK</strong><small>NO FIELD NOTE YET</small></li>
          ))}
        </ol>
        <p data-card-status role="status" aria-live="polite">Your circuit is empty. Start with one game.</p>
      </div>
      <aside>
        <p class="index">04 / TAKE IT WITH YOU</p>
        <h2>A season<br /><em>worth returning to.</em></h2>
        <p>
          Copy the readable card, export its tiny JSON receipt, or use your device’s
          share sheet. Nothing leaves the browser before one of those gestures.
        </p>
        <div class="my-card__actions">
          <button type="button" data-copy-card>COPY CARD</button>
          <button type="button" data-copy-json>COPY JSON</button>
          <button type="button" data-share-card>SHARE ↗</button>
          <button type="button" class="clear" data-clear-card>CLEAR</button>
        </div>
        <small>{feature.boundary}</small>
      </aside>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p class="index">05 / CURRENT SCHEDULE RECEIPTS</p>
        <h2 id="sources-title">Five official<br /><em>doors.</em></h2>
        <p>
          Schedule state was refreshed on August 3. Times can still move; the
          linked athletics pages remain the final pregame authority.
        </p>
      </header>
      <ol>
        {CALIFORNIA_CUP_SOURCES.map((source, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><div><small>{source.outlet}</small><a href={source.url} target="_blank" rel="noopener">{source.label} ↗</a><p>{source.note}</p></div></li>
        ))}
      </ol>
    </section>

    <footer class="credits">
      <div><strong>THE CALIFORNIA CUP</strong><span>POINTCAST · 2026</span></div>
      <p>THE SCOREBOARD REMEMBERS WHO WON.<br />THE MAGAZINE REMEMBERS WHO INVITED.</p>
      <nav aria-label="California Cup companions">
        <a href="/25/magazine/california-football">STATE REPORT</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href="/b/0559">BLOCK 0559</a>
      </nav>
    </footer>

    <SeasonTicket25 source="california-cup" variant="light" />
  </main>

  <script id="california-cup-data" type="application/json" is:inline set:html={JSON.stringify(clientData)}></script>
  <script is:inline>
    (() => {
      const STORAGE_KEY = 'pointcast.california-cup.card.v1';
      const data = JSON.parse(document.getElementById('california-cup-data')?.textContent || '{"games":[],"dimensions":[]}');
      const dimensionMap = new Map(data.dimensions.map((item) => [item.id, item.label]));
      const state = { predictions: {}, watches: {} };

      const safeRead = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          if (parsed && typeof parsed === 'object') {
            state.predictions = parsed.predictions && typeof parsed.predictions === 'object' ? parsed.predictions : {};
            state.watches = parsed.watches && typeof parsed.watches === 'object' ? parsed.watches : {};
          }
        } catch {}
      };

      const safeWrite = () => {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
      };

      const programName = (game, slug) => slug === game.awaySlug ? game.away : slug === game.homeSlug ? game.home : null;

      const receipt = () => ({
        spec: 'pointcast.california-cup.circuit-card/v1',
        season: 2026,
        privateByDefault: true,
        generatedAt: new Date().toISOString(),
        source: 'https://pointcast.xyz/25/magazine/california-cup',
        games: data.games.map((game) => ({
          id: game.id,
          date: game.date,
          game: `${game.away} at ${game.home}`,
          predictedWinner: programName(game, state.predictions[game.id]),
          fieldNote: dimensionMap.get(state.watches[game.id]) || null,
        })),
      });

      const receiptText = () => {
        const rows = receipt().games.map((game, index) =>
          `${String(index + 1).padStart(2, '0')} · ${game.date} · ${game.game}\n   PICK: ${game.predictedWinner || 'OPEN'} · NOTICE: ${game.fieldNote || 'OPEN'}`
        );
        return `MY CALIFORNIA CIRCUIT CARD · 2026\n${rows.join('\n')}\n\nBuild yours: https://pointcast.xyz/25/magazine/california-cup`;
      };

      const render = () => {
        document.querySelectorAll('[data-game]').forEach((root) => {
          const id = root.dataset.game;
          root.querySelectorAll('[data-pick]').forEach((button) => {
            const active = state.predictions[id] === button.dataset.pick;
            button.setAttribute('aria-pressed', String(active));
            button.classList.toggle('is-active', active);
            const small = button.querySelector('small');
            if (small) small.textContent = active ? 'MY PICK ✓' : 'PICK TO WIN';
          });
          root.querySelectorAll('[data-watch]').forEach((button) => {
            const active = state.watches[id] === button.dataset.watch;
            button.setAttribute('aria-pressed', String(active));
            button.classList.toggle('is-active', active);
          });
        });

        const picks = Object.keys(state.predictions).length;
        const watches = Object.keys(state.watches).length;
        const pickCount = document.querySelector('[data-pick-count]');
        const watchCount = document.querySelector('[data-watch-count]');
        const status = document.querySelector('[data-card-status]');
        if (pickCount) pickCount.textContent = String(picks);
        if (watchCount) watchCount.textContent = String(watches);
        if (status) status.textContent = picks || watches
          ? `${picks} winner ${picks === 1 ? 'pick' : 'picks'} and ${watches} field ${watches === 1 ? 'note' : 'notes'} saved in this browser.`
          : 'Your circuit is empty. Start with one game.';

        document.querySelectorAll('[data-receipt-list] li').forEach((row, index) => {
          const game = data.games[index];
          row.querySelector('strong').textContent = programName(game, state.predictions[game.id]) || 'OPEN PICK';
          row.querySelector('small').textContent = dimensionMap.get(state.watches[game.id]) || 'NO FIELD NOTE YET';
        });
      };

      document.querySelectorAll('[data-game]').forEach((root) => {
        const id = root.dataset.game;
        root.querySelectorAll('[data-pick]').forEach((button) => button.addEventListener('click', () => {
          state.predictions[id] = state.predictions[id] === button.dataset.pick ? undefined : button.dataset.pick;
          if (!state.predictions[id]) delete state.predictions[id];
          safeWrite(); render();
        }));
        root.querySelectorAll('[data-watch]').forEach((button) => button.addEventListener('click', () => {
          state.watches[id] = state.watches[id] === button.dataset.watch ? undefined : button.dataset.watch;
          if (!state.watches[id]) delete state.watches[id];
          safeWrite(); render();
        }));
      });

      const copy = async (value, message) => {
        try {
          await navigator.clipboard.writeText(value);
          const status = document.querySelector('[data-card-status]');
          if (status) status.textContent = message;
        } catch {
          const status = document.querySelector('[data-card-status]');
          if (status) status.textContent = 'Copy was unavailable. Your browser-local card is unchanged.';
        }
      };

      document.querySelector('[data-copy-card]')?.addEventListener('click', () => copy(receiptText(), 'Circuit card copied. You decide where it goes.'));
      document.querySelector('[data-copy-json]')?.addEventListener('click', () => copy(JSON.stringify(receipt(), null, 2), 'Circuit card JSON copied.'));
      document.querySelector('[data-share-card]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try { await navigator.share({ title: 'My California Circuit Card', text: receiptText(), url: location.href }); } catch {}
        } else {
          await copy(receiptText(), 'Share sheet unavailable, so the card was copied instead.');
        }
      });
      document.querySelector('[data-clear-card]')?.addEventListener('click', () => {
        state.predictions = {}; state.watches = {};
        try { localStorage.removeItem(STORAGE_KEY); } catch {}
        render();
      });

      safeRead();
      render();
    })();
  </script>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #eee6d2; color: #151915; }
  :global(.block-page), :global(.block-wrap) { max-width: none !important; padding: 0 !important; }
  .cup { --ink:#151915; --paper:#eee6d2; --blue:#10283a; --acid:#d8fa48; --orange:#f05a32; --gold:#f1a63b; font-family: Arial, Helvetica, sans-serif; overflow:hidden; }
  .mast { min-height:3.25rem; display:grid; grid-template-columns:auto 1fr auto; gap:1.5rem; align-items:center; padding:.75rem 1.25rem; background:var(--ink); color:var(--paper); border-bottom:1px solid #ffffff44; font:700 .68rem/1.2 monospace; letter-spacing:.08em; }
  .mast a { color:inherit; text-decoration:none; } .mast>a{font-size:.9rem}.mast>span{text-align:center}.mast nav{display:flex;gap:1rem}.mast nav a:hover{color:var(--acid)}
  .hero { min-height:calc(100vh - 3.25rem); position:relative; display:grid; grid-template-columns:1fr minmax(15rem,25vw); align-items:center; gap:4rem; padding:clamp(3rem,6vw,7rem); background:var(--blue); color:white; }
  .hero::before { content:""; position:absolute; inset:0; opacity:.24; background:radial-gradient(circle at 78% 28%,var(--acid) 0 2px,transparent 3px),radial-gradient(circle at 68% 58%,var(--gold) 0 3px,transparent 4px),repeating-linear-gradient(107deg,transparent 0 46px,#ffffff18 47px 48px); }
  .hero__paper { position:absolute; left:44%; right:4%; top:12%; display:flex; align-items:center; transform:rotate(-8deg); color:#ffffff88; font:700 .55rem/1 monospace; letter-spacing:.1em; }
  .hero__paper i { height:1px; flex:1; min-width:1rem; background:var(--acid); box-shadow:0 0 12px var(--acid); }
  .hero__copy,.hero__seal,.hero__ledger{position:relative;z-index:1}.hero__copy>p{margin:0 0 1.5rem;color:var(--acid);font:700 .72rem/1.2 monospace;letter-spacing:.16em}.hero h1{margin:0;font-size:clamp(4.5rem,11vw,10rem);line-height:.72;letter-spacing:-.08em}.hero h1 em{color:var(--gold);font-style:normal}.hero blockquote{margin:2rem 0;font:italic 500 clamp(1.6rem,3vw,3rem)/1 Georgia,serif}.hero__copy>a{display:inline-block;padding:1rem 1.25rem;background:var(--acid);color:var(--ink);font:900 .75rem/1 monospace;text-decoration:none;letter-spacing:.06em}
  .hero__seal{aspect-ratio:1;border:2px solid var(--acid);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 0 0 10px var(--blue),0 0 0 12px #d8fa4855,0 0 60px #d8fa4833;transform:rotate(5deg)}.hero__seal span,.hero__seal b,.hero__seal small{font:700 .65rem/1 monospace;letter-spacing:.12em}.hero__seal strong{font:900 clamp(5rem,10vw,9rem)/.8 Arial}.hero__seal b{color:var(--acid)}.hero__seal small{margin-top:1rem;padding:.45rem .7rem;background:var(--orange)}
  .hero__ledger{position:absolute;right:3rem;bottom:2rem;display:flex;border:1px solid #ffffff66}.hero__ledger div{padding:.7rem 1rem;border-right:1px solid #ffffff66}.hero__ledger div:last-child{border:0}.hero__ledger strong,.hero__ledger span{display:block}.hero__ledger strong{font:900 1.7rem/1 Arial}.hero__ledger span{font:700 .55rem/1.2 monospace}
  .index{margin:0 0 1rem;font:700 .68rem/1.2 monospace;letter-spacing:.13em}.premise{display:grid;grid-template-columns:.35fr 1.2fr .65fr;gap:3rem;padding:clamp(4rem,8vw,8rem) clamp(1.5rem,6vw,6rem);align-items:start}.premise h2,.table h2,.dimensions h2,.circuit h2,.my-card aside h2,.sources h2{margin:0;font-size:clamp(3.5rem,7vw,7rem);line-height:.8;letter-spacing:-.07em}.premise h2 em,.table h2 em,.dimensions h2 em,.circuit h2 em,.my-card aside h2 em,.sources h2 em{color:var(--orange);font:italic 500 .9em/1 Georgia,serif}.premise>div>p{max-width:45rem;font:700 clamp(1.2rem,2vw,1.7rem)/1.4}.premise aside{padding:1.5rem;background:var(--acid);box-shadow:.6rem .6rem 0 var(--ink);transform:rotate(1.5deg)}.premise aside strong{font:900 1.5rem/1 Arial}.premise aside p{font:600 .95rem/1.5 Georgia,serif}
