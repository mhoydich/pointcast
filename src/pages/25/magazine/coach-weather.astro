---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  COACH_AXIS_LABELS,
  POINTCAST_COACHES_50,
  type CoachAxis,
} from '../../../lib/pointcast-coaches-50';
import {
  COACH_WEATHER_BANDS,
  COACH_WEATHER_CADENCE,
  COACH_WEATHER_FEATURE,
  COACH_WEATHER_FRONTS,
  PROGRAM_BUILD_DEFAULT,
  matchProgramBuild,
  normalizeProgramShape,
} from '../../../lib/pointcast-coach-weather';

const feature = COACH_WEATHER_FEATURE;
const initialMatch = matchProgramBuild(PROGRAM_BUILD_DEFAULT);
const axisLabel = (axis: CoachAxis) =>
  COACH_AXIS_LABELS.find((entry) => entry.id === axis)?.label ?? axis;
const radarStyle = (index: number) => {
  const angle = ((index * 29 + 8) * Math.PI) / 180;
  const radius = 22 + (index % 4) * 7;
  return `--x:${50 + Math.cos(angle) * radius}%;--y:${50 + Math.sin(angle) * radius}%`;
};
const matcherData = POINTCAST_COACHES_50.map((coach) => ({
  rank: coach.rank,
  coach: coach.coach,
  school: coach.school,
  conference: coach.conference,
  signal: coach.signal,
  case: coach.case,
  question: coach.question,
  shape: normalizeProgramShape(coach.scores),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `${feature.title} — ${feature.subtitle}`,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        name: "PointCast College Football — Issue 001: Talkin' Season",
        url: 'https://pointcast.xyz/25/magazine',
      },
      about: [
        'college football coaches',
        '2026 college football season',
        'program building',
        'college football pressure',
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Coach Weather preseason pressure map',
      numberOfItems: COACH_WEATHER_FRONTS.length,
      itemListElement: COACH_WEATHER_FRONTS.map((front) => ({
        '@type': 'ListItem',
        position: front.order,
        name: `${front.coach.coach}, ${front.coach.school}: ${front.headline}`,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title} — ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#c7ff3f"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/coach-weather.json',
      title: 'Coach Weather structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="weather">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · COACHES DESK 002</span>
      <nav aria-label="Coach Weather navigation">
        <a href="/25/magazine/coaches-50">THE 50</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href="/25/magazine/coach-weather.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="weather-title">
      <div class="hero__copy">
        <p class="eyebrow">DISPATCH {feature.dispatch} · {feature.asOf} · PRESEASON BASELINE</p>
        <h1 id="weather-title">COACH<br /><em>WEATHER</em></h1>
        <p class="hero__dek">{feature.dek}</p>
        <p class="hero__thesis">{feature.thesis}</p>
        <div class="hero__actions">
          <a href="#front-map">Read the front map ↓</a>
          <a href="#build">Build your program ↘</a>
        </div>
      </div>

      <div class="radar" aria-label="Editorial radar showing twelve preseason coach-pressure fronts">
        <div class="radar__rings" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <b></b>
        </div>
        {COACH_WEATHER_FRONTS.map((front, index) => (
          <a
            href={`#front-${front.order}`}
            class={`radar__front radar__front--${front.band}`}
            style={radarStyle(index)}
            aria-label={`${front.coach.coach}, ${front.pressure} pressure`}
          >
            <span>{front.pressure}</span>
          </a>
        ))}
        <div class="radar__label">
          <strong>12</strong>
          <span>ROOMS<br />OPEN</span>
        </div>
      </div>

      <aside class="hero__legend" aria-label="Coach Weather legend">
        {COACH_WEATHER_BANDS.map((band) => (
          <div>
            <i style={`--band:${band.color}`}></i>
            <span>{band.label}</span>
          </div>
        ))}
        <small>PRESSURE IS NOT A PERFORMANCE GRADE.</small>
      </aside>
    </section>

    <section class="baseline" aria-labelledby="baseline-title">
      <p class="section-index">00 / THE HONEST OPEN</p>
      <div>
        <h2 id="baseline-title">Nothing moved.<br /><em>That matters.</em></h2>
        <p>{feature.baseline}</p>
      </div>
      <div class="baseline__receipt">
        <span>RANKING BASE</span>
        <strong>50</strong>
        <small>COACHES</small>
        <span>MOVEMENT</span>
        <strong>±00</strong>
        <small>PRESEASON</small>
      </div>
    </section>

    <section class="front-map" id="front-map" aria-labelledby="front-map-title" data-weather-map>
      <header class="front-map__header">
        <div>
          <p class="section-index">01 / THE FRONT MAP</p>
          <h2 id="front-map-title">Pressure before<br />the record.</h2>
        </div>
        <div class="front-map__tools">
          <p>
            Save coaches locally, then return to your weather instead of
            rebuilding a feed from scratch.
          </p>
          <button type="button" data-watch-filter aria-pressed="false">
            MY WEATHER · <b data-watch-count>0</b>
          </button>
        </div>
      </header>

      {COACH_WEATHER_BANDS.map((band) => (
        <section
          class={`weather-band weather-band--${band.id}`}
          aria-labelledby={`band-${band.id}`}
          style={`--band:${band.color}`}
        >
          <header>
            <p>{band.note}</p>
            <h3 id={`band-${band.id}`}>{band.label}</h3>
          </header>
          <div class="front-grid">
            {COACH_WEATHER_FRONTS.filter((front) => front.band === band.id).map((front) => (
              <article
                class="front-card"
                id={`front-${front.order}`}
                data-weather-card
                data-coach={front.coach.coach}
              >
                <div class="front-card__top">
                  <span class="front-card__number">{String(front.order).padStart(2, '0')}</span>
                  <div>
                    <small>POINTCAST RANK #{String(front.coach.rank).padStart(2, '0')}</small>
                    <h4>{front.coach.coach}</h4>
                    <p>{front.coach.school} · {front.coach.conference}</p>
                  </div>
                  <div class="front-card__pressure">
                    <strong>{front.pressure}</strong>
                    <span>PRESSURE</span>
                  </div>
                </div>
                <div class="front-card__room">
                  <span>EXACT ROOM</span>
                  <strong>{axisLabel(front.exactRoom)}</strong>
                  <span>MOVEMENT</span>
                  <strong>±00</strong>
                </div>
                <h5>{front.headline}</h5>
                <p>{front.forecast}</p>
                <blockquote>{front.trigger}</blockquote>
                <button
                  type="button"
                  class="watch-button"
                  data-watch-coach={front.coach.coach}
                  aria-pressed="false"
                >
                  <span data-watch-label>WATCH THIS ROOM</span>
                  <b aria-hidden="true">＋</b>
                </button>
              </article>
            ))}
          </div>
        </section>
      ))}

      <p class="front-map__empty" data-watch-empty hidden>
        Your weather is empty. Save one room, then this becomes your private
        return map.
      </p>
    </section>

    <section class="room-week" aria-labelledby="room-week-title">
      <figure>
        <img
          src="/images/pointcast-coaches-50/poster-02.webp"
          alt="An imagined football program planning table with anonymous hands, maps, budget sheets, and field diagrams"
          width="1024"
          height="1536"
          loading="lazy"
        />
        <figcaption>
          ROOM OF THE WEEK · IMAGINED EDITORIAL SCENE · NO REAL COACH OR CAMPUS
        </figcaption>
      </figure>
      <div class="room-week__copy">
        <p class="section-index">02 / ROOM OF THE WEEK</p>
        <span class="room-week__rank">#10 · KYLE WHITTINGHAM · MICHIGAN</span>
        <h2 id="room-week-title">Can an operating system<br /><em>change climates?</em></h2>
        <p class="room-week__standfirst">
          Great fit becomes invisible. After enough years, the coach’s habits
          begin to look like the place’s natural weather. Michigan makes that
          illusion testable.
        </p>
        <div class="room-week__columns">
          <p>
            Whittingham’s Utah program joined physical standards, staff memory,
            player development, regional knowledge, and public expectation so
            tightly that it became difficult to say where the coach ended and
            the institution began. Michigan did not hire that history. It hired
            the person believed to have made the history repeatable.
          </p>
          <p>
            The first audit is not wins. It is translation. Which meetings,
            staffing choices, practice rhythms, personnel preferences, and
            decision rights travel immediately? Which depended on Salt Lake
            City, a specific recruiting map, or two decades of accumulated
            trust? Portability is the room under pressure.
          </p>
        </div>
        <blockquote>
          The weather moves when Michigan stops looking like a program receiving
          Whittingham and starts looking like a Whittingham program.
        </blockquote>
        <a href="/25/magazine/coaches-50#ranking">Open the complete ranking ↗</a>
      </div>
    </section>

    <section class="cadence" aria-labelledby="cadence-title">
      <header>
        <p class="section-index">03 / RETURN RHYTHM</p>
        <h2 id="cadence-title">A season people<br /><em>can anticipate.</em></h2>
        <p>
          The ranking moves only when evidence moves it. Coach Weather gives the
          space between rankings a reliable editorial clock.
        </p>
      </header>
      <ol>
        {COACH_WEATHER_CADENCE.map((entry) => (
          <li>
            <div>
              <strong>{entry.day}</strong>
              <span>{entry.time}</span>
            </div>
            <h3>{entry.title}</h3>
            <p>{entry.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="builder" id="build" aria-labelledby="build-title" data-build-root>
      <header>
        <p class="section-index">04 / BUILD YOUR PROGRAM</p>
        <h2 id="build-title">You get<br /><em>100 points.</em></h2>
        <p>
          Decide what your football institution values. PointCast compares the
          shape—not the ranking—to all 50 published coach rooms.
        </p>
      </header>

      <div class="builder__workbench">
        <div class="builder__controls">
          <div class="builder__budget">
            <span>ALLOCATED</span>
            <strong data-build-total>100</strong>
            <small>/ 100</small>
          </div>

          <div class="builder__presets" aria-label="Program build presets">
            <button type="button" data-build-preset="20,15,20,10,10,10,15">BALANCED</button>
            <button type="button" data-build-preset="15,20,15,10,10,15,15">POWERHOUSE</button>
            <button type="button" data-build-preset="25,5,25,15,10,5,15">BUILDER</button>
            <button type="button" data-build-preset="15,5,20,25,15,5,15">LOCAL</button>
            <button type="button" data-build-preset="15,10,15,10,15,10,25">AURA</button>
          </div>

          <div class="builder__axes">
            {COACH_AXIS_LABELS.map((axis) => (
              <label>
                <span>
                  <strong>{axis.label}</strong>
                  <small>{axis.note}</small>
                </span>
                <input
                  type="range"
                  min="0"
                  max="40"
                  step="5"
                  value={PROGRAM_BUILD_DEFAULT[axis.id]}
                  data-build-axis={axis.id}
                  aria-label={`${axis.label} allocation`}
                />
                <output data-build-output={axis.id}>
                  {PROGRAM_BUILD_DEFAULT[axis.id]}
                </output>
              </label>
            ))}
          </div>
          <p class="builder__instruction" data-build-instruction>
            Your 100-point room is ready.
          </p>
        </div>

        <article class="match-card" data-match-card>
          <div class="match-card__top">
            <span>YOUR PROGRAM MATCH</span>
            <strong data-match-similarity>{initialMatch.similarity}%</strong>
          </div>
          <div class="match-card__rank">
            <span data-match-rank>#{String(initialMatch.coach.rank).padStart(2, '0')}</span>
            <small>POINTCAST 50</small>
          </div>
          <h3 data-match-school>{initialMatch.coach.school}</h3>
          <h4 data-match-coach>{initialMatch.coach.coach}</h4>
          <p class="match-card__signal" data-match-signal>{initialMatch.coach.signal}</p>
          <p data-match-case>{initialMatch.coach.case}</p>
          <blockquote data-match-question>
            2026: {initialMatch.coach.question}
          </blockquote>
          <div class="match-card__signature">
            <span>SIGNATURE ROOMS</span>
            <strong data-match-signature>
              {initialMatch.signature.map(axisLabel).join(' + ')}
            </strong>
          </div>
          <div class="match-card__actions">
            <button type="button" data-share-match>SHARE RESULT ↗</button>
            <button type="button" data-download-match>DOWNLOAD CARD ↓</button>
          </div>
          <small>
            Shape match, not endorsement. Your allocation remains on this device.
          </small>
        </article>
      </div>
    </section>

    <section class="return-door" aria-labelledby="return-title">
      <div>
        <p class="section-index">05 / KEEP THE RECEIPTS</p>
        <h2 id="return-title">Do not ask people<br />to remember the argument.</h2>
        <p>
          Coach Weather will preserve every baseline, forecast, movement, and
          reason. The public page remains free. The Founding Season Ticket funds
          the recurring desk, the Sunday audio, and the end-of-season autopsy.
        </p>
        <div class="return-door__links">
          <a href="/subscribe">Follow PointCast feeds + email ↗</a>
          <a href="/25/season">Open the season ledger ↗</a>
        </div>
      </div>
      <SeasonTicket25 context="Coach Weather, weekly movement receipts, and the season autopsy are funded by the Founding Season Ticket." />
    </section>

    <section class="boundary" aria-labelledby="boundary-title">
      <p class="section-index">06 / EDITORIAL BOUNDARY</p>
      <div>
        <h2 id="boundary-title">Pressure is not<br />a firing rumor.</h2>
        <p>{feature.boundary}</p>
        <p>{feature.matcherBoundary}</p>
      </div>
    </section>

    <footer class="feature-footer">
      <div>
        <span>POINTCAST COLLEGE FOOTBALL · COACHES DESK 002</span>
        <h2>THE POSITION<br />MEETS THE<br /><em>PRESSURE.</em></h2>
      </div>
      <nav aria-label="Continue reading PointCast College Football">
        <a href="/25/magazine/coaches-50">The PointCast 50 ↗</a>
        <a href="/25/magazine">Magazine front door ↗</a>
        <a href="/25/season">Season ledger ↗</a>
        <a href="/b/0545">Permanent Block 0545 ↗</a>
      </nav>
    </footer>

    <script
      type="application/json"
      id="coach-weather-match-data"
      set:html={JSON.stringify(matcherData).replace(/</g, '\\u003c')}
    ></script>
  </main>

  <script>
    const weatherMap = document.querySelector('[data-weather-map]');

    if (weatherMap instanceof HTMLElement) {
      const storageKey = 'pointcast:coach-weather-watchlist:v1';
      const buttons = [...weatherMap.querySelectorAll('[data-watch-coach]')];
      const cards = [...weatherMap.querySelectorAll('[data-weather-card]')];
      const filter = weatherMap.querySelector('[data-watch-filter]');
      const count = weatherMap.querySelector('[data-watch-count]');
      const empty = weatherMap.querySelector('[data-watch-empty]');
      let watched = new Set();
      let onlyWatched = false;

      try {
        const stored = JSON.parse(localStorage.getItem(storageKey) || '[]');
        watched = new Set(Array.isArray(stored) ? stored.filter((item) => typeof item === 'string') : []);
      } catch {
        watched = new Set();
      }

      const syncWatchlist = () => {
        buttons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const coach = button.dataset.watchCoach || '';
          const active = watched.has(coach);
          button.setAttribute('aria-pressed', String(active));
          const label = button.querySelector('[data-watch-label]');
          const icon = button.querySelector('b');
          if (label) label.textContent = active ? 'WATCHING THIS ROOM' : 'WATCH THIS ROOM';
          if (icon) icon.textContent = active ? '✓' : '＋';
        });

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.hidden = onlyWatched && !watched.has(card.dataset.coach || '');
        });

        if (count) count.textContent = String(watched.size);
        if (filter instanceof HTMLButtonElement) {
          filter.setAttribute('aria-pressed', String(onlyWatched));
        }
        if (empty instanceof HTMLElement) {
          empty.hidden = !(onlyWatched && watched.size === 0);
        }
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const coach = button.dataset.watchCoach || '';
          if (!coach) return;
          if (watched.has(coach)) watched.delete(coach);
          else watched.add(coach);
          try {
            localStorage.setItem(storageKey, JSON.stringify([...watched]));
          } catch {
            // The watchlist remains useful for the current visit when storage is unavailable.
          }
          syncWatchlist();
        });
      });

      filter?.addEventListener('click', () => {
        onlyWatched = !onlyWatched;
        syncWatchlist();
      });

      syncWatchlist();
    }

    const buildRoot = document.querySelector('[data-build-root]');
    const matchDataNode = document.querySelector('#coach-weather-match-data');

    if (
      buildRoot instanceof HTMLElement &&
      matchDataNode instanceof HTMLScriptElement
    ) {
      const axes = ['program', 'capital', 'players', 'region', 'fans', 'facilities', 'aura'];
      const labels = {
        program: 'Program',
        capital: 'Capital',
        players: 'Players',
        region: 'Region',
        fans: 'Fans',
        facilities: 'Facilities',
        aura: 'Aura',
      };
      const inputs = axes.map((axis) => buildRoot.querySelector(`[data-build-axis="${axis}"]`));
      const outputs = axes.map((axis) => buildRoot.querySelector(`[data-build-output="${axis}"]`));
      const totalNode = buildRoot.querySelector('[data-build-total]');
      const instruction = buildRoot.querySelector('[data-build-instruction]');
      const matchCard = buildRoot.querySelector('[data-match-card]');
      const coaches = JSON.parse(matchDataNode.textContent || '[]');
      let currentMatch = null;

      const currentValues = () =>
        inputs.map((input) =>
          input instanceof HTMLInputElement ? Number(input.value) : 0,
        );

      const writeMatch = (match) => {
        currentMatch = match;
        const write = (selector, value) => {
          const node = buildRoot.querySelector(selector);
          if (node) node.textContent = value;
        };
        write('[data-match-similarity]', `${match.similarity}%`);
        write('[data-match-rank]', `#${String(match.rank).padStart(2, '0')}`);
        write('[data-match-school]', match.school);
        write('[data-match-coach]', match.coach);
        write('[data-match-signal]', match.signal);
        write('[data-match-case]', match.case);
        write('[data-match-question]', `2026: ${match.question}`);
        write(
          '[data-match-signature]',
          match.signature.map((axis) => labels[axis] || axis).join(' + '),
        );
      };

      const findMatch = (values) => {
        const matches = coaches.map((coach) => {
          const distance = axes.reduce(
            (sum, axis, index) =>
              sum + Math.abs(values[index] - Number(coach.shape[axis] || 0)),
            0,
          );
          const signature = [...axes]
            .sort((a, b) => Number(coach.shape[b]) - Number(coach.shape[a]))
            .slice(0, 2);
          return {
            ...coach,
            signature,
            similarity: Math.max(0, Math.round(100 - distance / 2)),
          };
        });

        return matches.sort(
          (a, b) => b.similarity - a.similarity || a.rank - b.rank,
        )[0];
      };

      const syncBuild = ({ updateUrl = true } = {}) => {
        const values = currentValues();
        const total = values.reduce((sum, value) => sum + value, 0);

        values.forEach((value, index) => {
          if (outputs[index]) outputs[index].textContent = String(value);
          if (inputs[index] instanceof HTMLInputElement) {
            inputs[index].style.setProperty('--fill', `${(value / 40) * 100}%`);
          }
        });

        if (totalNode) totalNode.textContent = String(total);
        buildRoot.dataset.ready = String(total === 100);

        if (total !== 100) {
          if (instruction) {
            instruction.textContent =
              total < 100
                ? `${100 - total} points remain.`
                : `Remove ${total - 100} points.`;
          }
          return;
        }

        if (instruction) instruction.textContent = 'Your 100-point room is ready.';
        const match = findMatch(values);
        if (match) writeMatch(match);

        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set('build', values.join('-'));
          history.replaceState({}, '', url);
        }
      };

      inputs.forEach((input) => input?.addEventListener('input', () => syncBuild()));

      buildRoot.querySelectorAll('[data-build-preset]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const values = (button.dataset.buildPreset || '')
            .split(',')
            .map(Number);
          if (values.length !== axes.length) return;
          inputs.forEach((input, index) => {
            if (input instanceof HTMLInputElement) input.value = String(values[index]);
          });
          syncBuild();
        });
      });

      const shareButton = buildRoot.querySelector('[data-share-match]');
      shareButton?.addEventListener('click', async () => {
        if (!currentMatch || !(shareButton instanceof HTMLButtonElement)) return;
        const share = {
          title: `My Coach Weather program match: ${currentMatch.school}`,
          text: `My 100-point football room matches ${currentMatch.coach} at ${currentMatch.school}.`,
          url: window.location.href,
        };

        try {
          if (navigator.share) await navigator.share(share);
          else await navigator.clipboard.writeText(`${share.text} ${share.url}`);
          shareButton.textContent = navigator.share ? 'SHARED ✓' : 'LINK COPIED ✓';
        } catch {
          shareButton.textContent = 'SHARE READY ↗';
        }

        window.setTimeout(() => {
          shareButton.textContent = 'SHARE RESULT ↗';
        }, 1800);
      });

      const downloadButton = buildRoot.querySelector('[data-download-match]');
      downloadButton?.addEventListener('click', () => {
        if (!currentMatch) return;
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 630;
        const context = canvas.getContext('2d');
        if (!context) return;

        context.fillStyle = '#111914';
        context.fillRect(0, 0, 1200, 630);
        context.fillStyle = '#c7ff3f';
        context.fillRect(0, 0, 1200, 22);
        context.fillStyle = '#ff6843';
        context.fillRect(0, 22, 22, 608);
        context.strokeStyle = 'rgba(199,255,63,.34)';
        context.lineWidth = 2;
        [110, 190, 270].forEach((radius) => {
          context.beginPath();
          context.arc(970, 320, radius, 0, Math.PI * 2);
          context.stroke();
        });

        context.fillStyle = '#c7ff3f';
        context.font = '700 18px monospace';
        context.fillText('POINTCAST · COACH WEATHER · BUILD YOUR PROGRAM', 58, 78);
        context.fillStyle = '#f4f2e8';
        context.font = '900 78px Arial';
        context.fillText('MY PROGRAM', 56, 190);
        context.fillStyle = '#c7ff3f';
        context.font = 'italic 92px Georgia';
        context.fillText(currentMatch.school.toUpperCase(), 52, 296);
        context.fillStyle = '#f4f2e8';
        context.font = '700 34px Arial';
        context.fillText(`${currentMatch.coach} · ${currentMatch.similarity}% SHAPE MATCH`, 58, 358);
        context.fillStyle = '#aab4a8';
        context.font = '700 17px monospace';
        context.fillText(
          `SIGNATURE: ${currentMatch.signature.map((axis) => labels[axis].toUpperCase()).join(' + ')}`,
          58,
          410,
        );

        const values = currentValues();
        axes.forEach((axis, index) => {
          const x = 58 + (index % 4) * 185;
          const y = 482 + Math.floor(index / 4) * 58;
          context.fillStyle = '#ff6843';
          context.font = '900 30px Arial';
          context.fillText(String(values[index]).padStart(2, '0'), x, y);
          context.fillStyle = '#f4f2e8';
          context.font = '700 12px monospace';
          context.fillText(labels[axis].toUpperCase(), x + 46, y - 5);
        });

        context.fillStyle = '#111914';
        context.fillRect(889, 239, 162, 162);
        context.fillStyle = '#c7ff3f';
        context.font = '900 72px Arial';
        context.textAlign = 'center';
        context.fillText(`#${String(currentMatch.rank).padStart(2, '0')}`, 970, 338);
        context.fillStyle = '#f4f2e8';
        context.font = '700 13px monospace';
        context.fillText('POINTCAST 50', 970, 373);
        context.textAlign = 'left';

        const link = document.createElement('a');
        link.download = `coach-weather-${currentMatch.school
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      });

      const sharedBuild = new URL(window.location.href).searchParams.get('build');
      const sharedValues = sharedBuild?.split('-').map(Number);
      if (
        sharedValues?.length === axes.length &&
        sharedValues.every(
          (value) => Number.isFinite(value) && value >= 0 && value <= 40,
        ) &&
        sharedValues.reduce((sum, value) => sum + value, 0) === 100
      ) {
        inputs.forEach((input, index) => {
          if (input instanceof HTMLInputElement) {
            input.value = String(sharedValues[index]);
          }
        });
      }

      syncBuild({ updateUrl: false });
    }
  </script>
</BlockLayout>

