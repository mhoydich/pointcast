---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import SeasonTicket25 from '../../../components/SeasonTicket25.astro';
import {
  CALIFORNIA_ATTENDANCE_2025,
  CALIFORNIA_CIRCUIT_2026,
  CALIFORNIA_CONFERENCE_MAP,
  CALIFORNIA_FOOTBALL_COMPACT,
  CALIFORNIA_FOOTBALL_FEATURE,
  CALIFORNIA_FOOTBALL_SOURCES,
  CALIFORNIA_PROGRAM_PULSE,
  californiaFootballSource,
} from '../../../lib/pointcast-california-football';

const feature = CALIFORNIA_FOOTBALL_FEATURE;
const maximumAttendance = Math.max(...CALIFORNIA_ATTENDANCE_2025.map((entry) => entry.average));
const formatter = new Intl.NumberFormat('en-US');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      headline: `${feature.title}. ${feature.subtitle}`,
      description: feature.dek,
      datePublished: feature.publishedAt,
      dateModified: feature.updatedAt,
      url: feature.canonical,
      image: feature.socialImage,
      author: { '@type': 'Organization', name: feature.byline },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      isPartOf: {
        '@type': 'PublicationIssue',
        name: "PointCast College Football — Issue 001: Talkin' Season",
        url: 'https://pointcast.xyz/25/magazine',
      },
      about: [
        'California college football',
        '2026 college football season',
        'USC football',
        'UCLA football',
        'California football',
        'Stanford football',
        'Fresno State football',
        'San Diego State football',
        'San Jose State football',
        'Sacramento State football',
      ],
      citation: CALIFORNIA_FOOTBALL_SOURCES.map((source) => source.url),
    },
    {
      '@type': 'ItemList',
      name: 'PointCast California Football Compact',
      numberOfItems: CALIFORNIA_FOOTBALL_COMPACT.length,
      itemListElement: CALIFORNIA_FOOTBALL_COMPACT.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.title,
        description: item.promise,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${feature.title}. ${feature.subtitle}`}
  description={feature.dek}
  image={feature.socialImage}
  themeColor="#f3a33b"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/california-football.json',
      title: 'California Football State Report structured edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="california">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · STATE DESK 001</span>
      <nav aria-label="California football report navigation">
        <a href="#map">MAP</a>
        <a href="#compact">COMPACT</a>
        <a href="/25/magazine/california-cup">CUP</a>
        <a href="/25/magazine">ISSUE 001</a>
        <a href="/25/magazine/california-football.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="california-title">
      <img
        src={feature.heroImage}
        alt="Generated editorial collage of California landscapes, stadium lights, rail lines, and radio signals at blue hour"
        width="1920"
        height="1080"
        loading="eager"
      />
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="hero__copy">
        <p>{feature.status} · AS OF {feature.asOf}</p>
        <h1 id="california-title">CALIFORNIA<br />FOOTBALL<br /><em>IS NOT DEAD.</em></h1>
        <strong>{feature.subtitle}</strong>
        <blockquote>“{feature.dek}”</blockquote>
      </div>
      <div class="hero__ledger" aria-label="California 2026 college-football map summary">
        <span><b>08</b> FBS programs</span>
        <span><b>05</b> conferences</span>
        <span><b>01</b> missing ritual</span>
      </div>
      <p class="hero__credit">GENERATED EDITORIAL COLLAGE · NOT DOCUMENTARY PHOTOGRAPHY</p>
    </section>

    <section class="lede" aria-labelledby="lede-title">
      <p class="section-index">00 / THE STATE OF THE STATE</p>
      <div class="lede__headline">
        <h2 id="lede-title">Plenty of<br /><em>football.</em><br />No common map.</h2>
        <p>{feature.thesis}</p>
      </div>
      <div class="lede__body">
        <p>
          California enters 2026 with one of the strangest football geographies in
          America. Los Angeles belongs to the Big Ten. Berkeley and Palo Alto belong
          to the Atlantic Coast Conference. Fresno and San Diego open a rebuilt
          Pac-12. San José stays in the Mountain West. Sacramento begins life in the
          FBS as a football-only member of the Mid-American Conference.
        </p>
        <p>
          It is an impressive collection of institutions with almost no collective
          identity. The sport is present. The shared Saturday is not.
        </p>
      </div>
      <aside>
        <span>THE POINTCAST READ</span>
        <strong>THIS IS A<br />RELATIONSHIP<br />PROBLEM.</strong>
        <small>NOT AN AUDIENCE AUTOPSY.</small>
      </aside>
    </section>

    <section class="map" id="map" aria-labelledby="map-title">
      <header class="section-head">
        <div>
          <p class="section-index">01 / THE BROKEN MAP</p>
          <h2 id="map-title">Eight signals.<br /><em>Five directions.</em></h2>
        </div>
        <p>
          Sacramento State’s arrival and the new Pac-12 make 2026 unusually alive.
          They also make the fragmentation impossible to ignore.
        </p>
      </header>
      <div class="map__grid">
        {CALIFORNIA_CONFERENCE_MAP.map((conference, index) => (
          <article>
            <div>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <small>{conference.direction}</small>
            </div>
            <h3>{conference.conference}</h3>
            <strong>{conference.programs.join(' · ')}</strong>
            <p>{conference.note}</p>
          </article>
        ))}
      </div>
      <div class="map__sources">
        <a href={californiaFootballSource('sac-state-mac').url} target="_blank" rel="noopener">SACRAMENTO STATE ↗</a>
        <a href={californiaFootballSource('pac-12-launch').url} target="_blank" rel="noopener">NEW PAC-12 ↗</a>
      </div>
    </section>

    <section class="pulse" aria-labelledby="pulse-title">
      <header class="section-head section-head--dark">
        <div>
          <p class="section-index">02 / THE TEMPERATURE</p>
          <h2 id="pulse-title">Nobody is<br /><em>standing still.</em></h2>
        </div>
        <p>
          The state is not in sleepy continuity. Every room is trying to become
          legible again—to a nation, a region, a campus, or itself.
        </p>
      </header>
      <div class="pulse__grid">
        {CALIFORNIA_PROGRAM_PULSE.map((program, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')} · {program.region}</span>
            <h3>{program.program}</h3>
            <small>{program.coach}</small>
            <strong>{program.chapter}</strong>
            <p>{program.read}</p>
            <div>
              {program.sourceIds.map((sourceId) => {
                const source = californiaFootballSource(sourceId);
                return <a href={source.url} target="_blank" rel="noopener">{source.outlet} ↗</a>;
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="attendance" aria-labelledby="attendance-title">
      <header class="section-head">
        <div>
          <p class="section-index">03 / DO PEOPLE CARE?</p>
          <h2 id="attendance-title">Selectively.<br /><em>That matters.</em></h2>
        </div>
        <p>
          The official 2025 averages do not describe an empty state. They describe
          several different relationships between a program and its place.
        </p>
      </header>
      <div class="attendance__chart" aria-label="Average 2025 home football attendance by California program">
        {CALIFORNIA_ATTENDANCE_2025.map((entry, index) => (
          <div class="attendance__row">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{entry.program}</strong>
            <div aria-hidden="true"><i style={`--attendance:${(entry.average / maximumAttendance) * 100}%`}></i></div>
            <b>{formatter.format(entry.average)}</b>
            <small>{entry.capacityRead}</small>
          </div>
        ))}
      </div>
      <div class="attendance__read">
        <p>
          USC still pulls like a national brand. Fresno State fills its civic role.
          UCLA, Stanford, San Diego State, and San José State show how much routine
          remains available to rebuild.
        </p>
        <a href={californiaFootballSource('ncaa-attendance').url} target="_blank" rel="noopener">2025 NCAA ATTENDANCE REPORT ↗</a>
      </div>
    </section>

    <section class="participation" aria-labelledby="participation-title">
      <div>
        <p class="section-index">04 / THE GAME IS CHANGING</p>
        <h2 id="participation-title">Not dying.<br /><em>Diversifying.</em></h2>
        <p>
          California’s 2024–25 participation survey counted 91,411 boys in
          11-player football, up 1.9 percent, and 19,921 girls in flag football—an
          84 percent jump in the second sanctioned season.
        </p>
        <p>
          Any honest answer about the future of California football has to include
          the version of the game growing fastest.
        </p>
        <a href={californiaFootballSource('cif-participation').url} target="_blank" rel="noopener">CIF PARTICIPATION REPORTING ↗</a>
      </div>
      <aside aria-label="California high-school football participation signals">
        <div><strong>91,411</strong><span>BOYS · 11-PLAYER</span></div>
        <div><strong>19,921</strong><span>GIRLS · FLAG</span></div>
        <div><strong>+84%</strong><span>FLAG · YEAR OVER YEAR</span></div>
      </aside>
    </section>

    <section class="circuit" aria-labelledby="circuit-title">
      <header class="section-head section-head--dark">
        <div>
          <p class="section-index">05 / THE CIRCUIT ALREADY EXISTS</p>
          <h2 id="circuit-title">Follow the<br /><em>state lines.</em></h2>
        </div>
        <p>
          The conferences do not provide a California season. The 2026 schedule
          quietly does. These games can become the spine of a shared public table.
        </p>
      </header>
      <ol>
        {CALIFORNIA_CIRCUIT_2026.map((game, index) => {
          const source = californiaFootballSource(game.sourceId);
          return (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <small>{game.date} · {game.kickoff}</small>
              <h3>{game.game}</h3>
              <strong>{game.label}</strong>
              <a href={source.url} target="_blank" rel="noopener">SOURCE ↗</a>
            </li>
          );
        })}
      </ol>
    </section>

    <a class="cup-door" href="/25/magazine/california-cup">
      <span>COMPACT PROMISE 05 · NOW PLAYABLE</span>
      <strong>THE CALIFORNIA CUP</strong>
      <p>Seven games. Two separate trophies. One private circuit card.</p>
      <b>KEEP THE TABLE ↗</b>
    </a>

    <section class="answer" aria-labelledby="answer-title">
      <p class="section-index">06 / SHOULD CALIFORNIA CARE MORE?</p>
      <h2 id="answer-title">YES.<br /><em>DIFFERENTLY.</em></h2>
      <div>
        <p>
          California should not cosplay as the SEC. It will never organize its
          entire civic calendar around college football. There are too many cities,
          professional teams, immigrant traditions, creative industries, beaches,
          mountains, and beautiful alternatives competing for Saturday.
        </p>
        <p>
          That is not a weakness. It is the design brief.
        </p>
        <p>
          California football can become the country’s most interesting regional
          expression of the sport: sunset kickoffs, regional food, local music,
          campus design, Mexican American culture, Asian American culture, Black
          California traditions, agricultural communities, aerospace towns, surf
          cities, and the new world of girls’ flag.
        </p>
      </div>
    </section>

    <section class="compact" id="compact" aria-labelledby="compact-title">
      <header>
        <p class="section-index">07 / A POINTCAST PROPOSAL</p>
        <h2 id="compact-title">THE CALIFORNIA<br /><em>FOOTBALL COMPACT</em></h2>
        <p>Five invitations for 2026. None requires pretending football is a religion.</p>
      </header>
      <ol>
        {CALIFORNIA_FOOTBALL_COMPACT.map((item) => (
          <li>
            <span>{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <strong>{item.promise}</strong>
              <p>{item.reason}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="close" aria-labelledby="close-title">
      <span>THE CLOSING ARGUMENT</span>
      <h2 id="close-title">California does not need to become more like the South.</h2>
      <p>It needs to become more like California, together, on Saturdays.</p>
      <strong>
        The state already has the players, campuses, history, weather, cities, and
        stadiums. What it does not yet have is a common story.
      </strong>
      <b>California should care more about college football—but first, college football must care more about California.</b>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header>
        <p class="section-index">08 / RECEIPTS</p>
        <h2 id="sources-title">THE SOURCE<br /><em>ROOM.</em></h2>
        <p>{feature.boundary}</p>
      </header>
      <ol>
        {CALIFORNIA_FOOTBALL_SOURCES.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <small>{source.kind.toUpperCase()} · {source.outlet}</small>
              <a href={source.url} target="_blank" rel="noopener">{source.label} ↗</a>
              <p>{source.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="credits">
      <p>REPORTING + WRITING · CODEX / OPENAI</p>
      <p>EDITORIAL DIRECTION · MICHAEL HOYDICH</p>
      <p>VISUAL · {feature.visualCredit}</p>
      <a href="/b/0557">PERMANENT BLOCK 0557 ↗</a>
    </footer>

    <SeasonTicket25 source="california-football" variant="light" />
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #f1ead9; color: #151915; }
  :global(.block-page) { max-width: none !important; padding: 0 !important; }
  :global(.block-wrap) { max-width: none !important; }

  .california {
    --ink: #151915;
    --paper: #f1ead9;
    --blue: #10283a;
    --poppy: #ef5a31;
    --gold: #f3a33b;
    --fog: #d8e0dc;
    --signal: #d8fa48;
    font-family: Arial, Helvetica, sans-serif;
    overflow: hidden;
  }

  .mast {
    min-height: 3.25rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: .75rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid rgba(255,255,255,.3);
    font: 700 .68rem/1.2 monospace;
    letter-spacing: .08em;
  }
  .mast a { color: inherit; text-decoration: none; }
  .mast > a { font-size: .9rem; }
  .mast > span { text-align: center; }
  .mast nav { display: flex; gap: 1rem; }
  .mast nav a:hover { color: var(--signal); }

  .hero { min-height: 86vh; position: relative; display: grid; align-items: end; background: var(--blue); color: white; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,15,24,.92) 0%, rgba(5,15,24,.72) 36%, rgba(5,15,24,.08) 76%), linear-gradient(0deg, rgba(5,15,24,.9), transparent 45%); }
  .hero__copy { position: relative; z-index: 1; padding: clamp(2rem, 5vw, 5.5rem); max-width: 58rem; }
  .hero__copy > p { margin: 0 0 1.25rem; font: 700 .72rem/1.2 monospace; letter-spacing: .16em; color: var(--signal); }
  .hero h1 { margin: 0; font-size: clamp(3.6rem, 10vw, 9rem); line-height: .76; letter-spacing: -.075em; }
  .hero h1 em { color: var(--gold); font-style: normal; }
  .hero__copy > strong { display: block; margin-top: 1.4rem; font: italic 500 clamp(2rem, 4vw, 4.5rem)/1 Georgia, serif; color: var(--fog); }
  .hero blockquote { max-width: 42rem; margin: 2rem 0 0; padding-left: 1rem; border-left: .35rem solid var(--poppy); font: 700 clamp(1rem, 1.7vw, 1.35rem)/1.35 Arial, sans-serif; }
  .hero__ledger { position: absolute; z-index: 2; right: 1.25rem; bottom: 1.25rem; display: grid; gap: .25rem; width: min(21rem, 34vw); }
  .hero__ledger span { display: grid; grid-template-columns: 3.5rem 1fr; align-items: center; padding: .65rem .8rem; background: rgba(216,250,72,.92); color: var(--ink); font: 700 .7rem/1 monospace; text-transform: uppercase; }
  .hero__ledger b { font: 900 1.8rem/.9 Arial, sans-serif; }
  .hero__credit { position: absolute; z-index: 2; top: 1rem; right: 1.25rem; margin: 0; font: 700 .58rem/1 monospace; letter-spacing: .08em; writing-mode: vertical-rl; }

  .section-index { margin: 0 0 1rem; font: 700 .68rem/1.2 monospace; letter-spacing: .13em; }
  .section-head { display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; align-items: end; margin-bottom: 3rem; }
  .section-head h2 { margin: 0; font-size: clamp(3rem, 7vw, 7rem); line-height: .82; letter-spacing: -.07em; }
  .section-head h2 em { color: var(--poppy); font: italic 500 .9em/1 Georgia, serif; }
  .section-head > p { max-width: 34rem; margin: 0; font: 700 1.15rem/1.45 Arial, sans-serif; }
  .section-head--dark h2 em { color: var(--signal); }

  .lede { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; padding: clamp(4rem, 9vw, 9rem) clamp(1.5rem, 6vw, 6rem); border-bottom: 1px solid var(--ink); }
  .lede > .section-index { grid-column: 1 / -1; }
  .lede__headline h2 { margin: 0; font-size: clamp(3.5rem, 8vw, 8rem); line-height: .78; letter-spacing: -.075em; }
  .lede__headline h2 em { color: var(--poppy); font: italic 500 .9em/1 Georgia, serif; }
  .lede__headline > p { max-width: 46rem; margin: 2rem 0 0; font: 700 clamp(1.2rem, 2vw, 1.65rem)/1.4 Arial, sans-serif; }
  .lede__body { columns: 2; column-gap: 2rem; align-self: end; font: 500 1.05rem/1.6 Georgia, serif; }
  .lede__body p { margin: 0 0 1.25rem; }
  .lede aside { position: absolute; right: 0; top: 0; padding: 1rem; background: var(--signal); color: var(--ink); transform: rotate(2deg); box-shadow: .55rem .55rem 0 var(--ink); }
  .lede aside span, .lede aside small { display: block; font: 700 .6rem/1.3 monospace; letter-spacing: .08em; }
  .lede aside strong { display: block; margin: .6rem 0; font: 900 1.4rem/.9 Arial, sans-serif; }

  .map, .attendance, .sources { padding: clamp(4rem, 8vw, 8rem) clamp(1.5rem, 6vw, 6rem); }
  .map__grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); border: 1px solid var(--ink); }
  .map__grid article { min-height: 22rem; padding: 1.25rem; border-right: 1px solid var(--ink); display: flex; flex-direction: column; }
  .map__grid article:last-child { border-right: 0; }
  .map__grid article > div { display: flex; justify-content: space-between; font: 700 .6rem/1.2 monospace; }
  .map__grid h3 { margin: 4rem 0 .5rem; font-size: clamp(1.5rem, 2.2vw, 2.5rem); line-height: .9; letter-spacing: -.04em; }
  .map__grid strong { font: 700 .72rem/1.5 monospace; color: #884326; }
  .map__grid p { margin: auto 0 0; font: 500 .9rem/1.45 Georgia, serif; }
  .map__sources { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem; }
  .map__sources a, .attendance__read a, .participation a { color: inherit; font: 700 .65rem/1 monospace; }

  .pulse, .circuit { padding: clamp(4rem, 8vw, 8rem) clamp(1.5rem, 6vw, 6rem); background: var(--blue); color: var(--paper); }
  .cup-door { display: grid; grid-template-columns: .6fr 1.2fr 1fr auto; gap: 2rem; align-items: center; padding: 2rem clamp(1.5rem, 6vw, 6rem); background: var(--signal); color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink); }
  .cup-door span, .cup-door b { font: 700 .65rem/1.3 monospace; letter-spacing: .06em; }
  .cup-door strong { font: 900 clamp(1.8rem, 3vw, 3.5rem)/.9 Arial, sans-serif; letter-spacing: -.04em; }
  .cup-door p { margin: 0; font: 700 1rem/1.35 Arial, sans-serif; }
  .cup-door:hover { background: var(--gold); }
  .pulse__grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); border: 1px solid rgba(255,255,255,.45); }
  .pulse article { min-height: 27rem; padding: 1.2rem; display: flex; flex-direction: column; border-right: 1px solid rgba(255,255,255,.3); border-bottom: 1px solid rgba(255,255,255,.3); }
  .pulse article:nth-child(4n) { border-right: 0; }
  .pulse article > span { font: 700 .62rem/1.2 monospace; letter-spacing: .05em; color: var(--signal); }
  .pulse h3 { margin: 2.5rem 0 .25rem; font-size: clamp(1.8rem, 3vw, 3.2rem); line-height: .87; letter-spacing: -.05em; }
  .pulse article > small { font: 700 .7rem/1.2 monospace; color: #aebcc4; }
  .pulse article > strong { margin: auto 0 .6rem; font: italic 600 1.2rem/1.15 Georgia, serif; color: var(--gold); }
  .pulse article > p { margin: 0; font: 500 .92rem/1.45 Georgia, serif; }
  .pulse article > div { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
  .pulse article a { color: var(--paper); font: 700 .55rem/1 monospace; }

  .attendance__chart { border-top: 1px solid var(--ink); }
  .attendance__row { display: grid; grid-template-columns: 2.5rem minmax(7rem,1fr) 4fr 5rem 9rem; gap: 1rem; align-items: center; padding: .9rem 0; border-bottom: 1px solid var(--ink); }
  .attendance__row > span, .attendance__row > small { font: 700 .62rem/1.2 monospace; }
  .attendance__row > strong { font-size: 1rem; text-transform: uppercase; }
  .attendance__row > div { height: 1.35rem; background: rgba(21,25,21,.12); }
  .attendance__row i { display: block; width: var(--attendance); height: 100%; background: var(--poppy); }
  .attendance__row b { text-align: right; font: 900 1.15rem/1 monospace; }
  .attendance__read { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-top: 2rem; }
  .attendance__read p { max-width: 44rem; margin: 0; font: italic 600 1.35rem/1.35 Georgia, serif; }

  .participation { display: grid; grid-template-columns: 1fr 1fr; background: var(--gold); border-block: 1px solid var(--ink); }
  .participation > div { padding: clamp(3rem, 7vw, 7rem); }
  .participation h2 { margin: 0 0 2rem; font-size: clamp(3.5rem, 7vw, 7rem); line-height: .82; letter-spacing: -.07em; }
  .participation h2 em { color: #9a2e1f; font: italic 500 .85em/1 Georgia, serif; }
  .participation p { max-width: 42rem; font: 600 1.1rem/1.5 Georgia, serif; }
  .participation aside { display: grid; grid-template-rows: repeat(3,1fr); border-left: 1px solid var(--ink); }
