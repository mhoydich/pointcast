---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { HOUSE_WE_BORROWED } from '../../../lib/pointcast-college-house';

const description = HOUSE_WE_BORROWED.subtitle;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: HOUSE_WE_BORROWED.title,
  alternativeHeadline: HOUSE_WE_BORROWED.subtitle,
  description,
  datePublished: HOUSE_WE_BORROWED.publishedAt,
  author: {
    '@type': 'Person',
    name: 'Michael Hoydich',
    url: 'https://pointcast.xyz/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  isPartOf: {
    '@type': 'PublicationIssue',
    name: `PointCast College Football — Issue ${HOUSE_WE_BORROWED.issue}`,
    url: HOUSE_WE_BORROWED.magazine,
  },
  mainEntityOfPage: HOUSE_WE_BORROWED.canonical,
  image: HOUSE_WE_BORROWED.plates.map((plate) => `https://pointcast.xyz${plate.image}`),
};
---

<BlockLayout
  title={`${HOUSE_WE_BORROWED.title} — PointCast College Football`}
  description={description}
  image="/images/pointcast-college-house/social-card.png"
  themeColor="#8d2d26"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/magazine/the-house-we-borrowed.json',
      title: 'The House We Borrowed machine-readable edition',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <article class="house" data-house-light="dusk">
    <header class="utility">
      <a href="/25/magazine">← ISSUE 001</a>
      <span>HOUSE DESK 001 · {HOUSE_WE_BORROWED.readingTime}</span>
      <a href="/25/magazine/the-house-we-borrowed.json">JSON ↗</a>
    </header>

    <section class="hero" aria-labelledby="house-title">
      <img
        src={HOUSE_WE_BORROWED.plates[0].image}
        alt={HOUSE_WE_BORROWED.plates[0].alt}
        width="1200"
        height="1500"
        fetchpriority="high"
      />
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="hero__copy">
        <p>{HOUSE_WE_BORROWED.kicker}</p>
        <h1 id="house-title">THE HOUSE<br />WE <em>BORROWED.</em></h1>
        <p class="hero__dek">{HOUSE_WE_BORROWED.subtitle}</p>
        <p class="hero__byline">AN ESSAY BY MICHAEL HOYDICH · VISUALS MADE WITH MIDJOURNEY</p>
      </div>
      <div class="hero__key" aria-label="House key">
        <span>KEY</span>
        <strong>4</strong>
        <small>YEARS<br />ON LOAN</small>
      </div>
      <a class="hero__door" href="#front-door">OPEN THE FRONT DOOR ↓</a>
    </section>

    <nav class="room-nav" aria-label="Rooms in The House We Borrowed">
      {HOUSE_WE_BORROWED.plates.map((plate) => (
        <a href={`#${plate.id}`}><span>{plate.number}</span>{plate.id.replaceAll('-', ' ')}</a>
      ))}
    </nav>

    <section class="front-door" id="front-door" aria-labelledby="front-door-title">
      <div class="front-door__label">
        <p>AN ODE, WITH THE DOOR OPEN</p>
        <div class="light-switch" aria-label="Change the house light">
          <span>HOUSE LIGHT</span>
          <button type="button" data-house-light-button="dusk" aria-pressed="true">DUSK</button>
          <button type="button" data-house-light-button="kitchen" aria-pressed="false">KITCHEN</button>
          <button type="button" data-house-light-button="morning" aria-pressed="false">MORNING</button>
        </div>
      </div>
      <div class="front-door__lead">
        <h2 id="front-door-title">{HOUSE_WE_BORROWED.thesis}</h2>
        <p>{HOUSE_WE_BORROWED.standfirst}</p>
      </div>
      <div class="front-door__body">
        {HOUSE_WE_BORROWED.prologue.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="contact-sheet" aria-label="The six rooms">
      {HOUSE_WE_BORROWED.plates.map((plate, index) => (
        <a href={`#${plate.id}`} class:list={['contact-sheet__plate', index === 3 && 'contact-sheet__plate--wide']}>
          <img
            src={plate.image}
            alt=""
            width={index === 3 ? 1600 : 1200}
            height={index === 3 ? 900 : 1500}
            loading="lazy"
          />
          <span>{plate.number} / {plate.moment}</span>
        </a>
      ))}
    </section>

    <div class="chapters">
      {HOUSE_WE_BORROWED.plates.map((plate, index) => (
        <section
          class:list={['chapter', index % 2 === 1 && 'chapter--reverse']}
          id={plate.id}
          aria-labelledby={`${plate.id}-title`}
        >
          <figure>
            <img
              src={plate.image}
              alt={plate.alt}
              width={index === 3 ? 1600 : 1200}
              height={index === 3 ? 900 : 1500}
              loading="lazy"
            />
            <figcaption>
              <span>PLATE {plate.number} · {plate.moment}</span>
              <p>{plate.caption}</p>
            </figcaption>
          </figure>
          <div class="chapter__copy">
            <span>{plate.number}</span>
            <p>{plate.moment}</p>
            <h2 id={`${plate.id}-title`}>{plate.title}</h2>
            {plate.essay.map((paragraph, paragraphIndex) =>
              paragraphIndex === 0 ? <p class="chapter__first">{paragraph}</p> : <p>{paragraph}</p>
            )}
          </div>
        </section>
      ))}
    </div>

    <section class="refusal" aria-labelledby="refusal-title">
      <header>
        <p>THE ODE’S CONDITIONS</p>
        <h2 id="refusal-title">WHAT THE<br />WARM LIGHT<br /><em>CANNOT HIDE.</em></h2>
      </header>
      <div class="refusal__cards">
        {HOUSE_WE_BORROWED.refusals.map((refusal, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{refusal.title}</h3>
            <p>{refusal.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rules" aria-labelledby="rules-title">
      <header>
        <p>A HOUSE CODE FOR THE NEXT PEOPLE</p>
        <h2 id="rules-title">SIX THINGS<br />WORTH PASSING ON.</h2>
      </header>
      <ol>
        {HOUSE_WE_BORROWED.houseRules.map((rule, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{rule}</strong></li>
        ))}
      </ol>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <img
        src={HOUSE_WE_BORROWED.plates[5].image}
        alt=""
        width="1200"
        height="1500"
        loading="lazy"
      />
      <div>
        <p>THE FRONT DOOR / AGAIN</p>
        <h2 id="closing-title">{HOUSE_WE_BORROWED.closing}</h2>
        <strong>THE HOUSE WAS BORROWED.<br />THE FRIENDSHIP WAS NOT.</strong>
      </div>
    </section>

    <section class="credits" aria-labelledby="credits-title">
      <div>
        <p>EDITORIAL NOTE</p>
        <h2 id="credits-title">A MEMORY,<br />NOT A MODEL.</h2>
      </div>
      <div class="credits__copy">
        <p>{HOUSE_WE_BORROWED.boundary}</p>
        <dl>
          <div><dt>CONCEPT + EDITORIAL DIRECTION</dt><dd>{HOUSE_WE_BORROWED.credits.conceptAndEditorialDirection}</dd></div>
          <div><dt>WRITING + DESIGN + BUILD</dt><dd>{HOUSE_WE_BORROWED.credits.writingDesignAndImplementation}</dd></div>
          <div><dt>IMAGE DIRECTION</dt><dd>{HOUSE_WE_BORROWED.credits.imageDirection}</dd></div>
          <div><dt>IMAGE GENERATION</dt><dd>{HOUSE_WE_BORROWED.credits.imageGeneration} · {HOUSE_WE_BORROWED.credits.imageCount} selected plates</dd></div>
        </dl>
        <p class="credits__provenance">
          Every plate is an imagined scene. Midjourney job IDs, image indices,
          prompt summaries, and the machine-readable editorial boundary travel
          with the <a href="/25/magazine/the-house-we-borrowed.json">JSON edition ↗</a>.
        </p>
      </div>
    </section>

    <footer>
      <div>
        <span>POINTCAST COLLEGE FOOTBALL</span>
        <strong>HOUSE DESK 001 · BLOCK {HOUSE_WE_BORROWED.block}</strong>
      </div>
      <nav aria-label="The House We Borrowed closing links">
        <a href="/25/magazine">Issue 001</a>
        <a href="/25/2029/song-yard">Song Yard</a>
        <a href="/25/2029/field-kit">Saturday Commons</a>
        <a href={`/b/${HOUSE_WE_BORROWED.block}`}>Permanent Block</a>
      </nav>
    </footer>
  </article>
</BlockLayout>

<script>
  const house = document.querySelector<HTMLElement>('[data-house-light]');
  const lightButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-house-light-button]'));

  lightButtons.forEach((button) => button.addEventListener('click', () => {
    if (!house) return;
    const light = button.dataset.houseLightButton || 'dusk';
    house.dataset.houseLight = light;
    lightButtons.forEach((candidate) => {
      candidate.setAttribute('aria-pressed', String(candidate === button));
    });
  }));
</script>

<style>
  :global(body) {
    margin: 0;
    background: #171310;
  }

  .house {
    --ink: #181310;
    --paper: #ede2cb;
    --paper-two: #d8c6a3;
    --oxblood: #8d2d26;
    --blue: #233b58;
    --gold: #d49c3d;
    --light: rgba(231, 155, 77, 0.28);
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--ink);
    background:
      linear-gradient(rgba(24, 19, 16, 0.045) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 29px;
    font-family: var(--pc-font-mono);
    transition: background-color 450ms ease, color 450ms ease;
  }

  .house[data-house-light="kitchen"] {
    --paper: #ead2a9;
    --paper-two: #c99355;
    --oxblood: #9e3625;
    --blue: #2f3840;
    --gold: #ffd078;
    --light: rgba(255, 192, 94, 0.35);
  }

  .house[data-house-light="morning"] {
    --paper: #eef0e5;
    --paper-two: #cbd4ca;
    --oxblood: #7f4337;
    --blue: #476a72;
    --gold: #ddb84f;
    --light: rgba(184, 220, 220, 0.3);
  }

  .house * { box-sizing: border-box; }
  .house a { color: inherit; }

  .utility {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem clamp(0.9rem, 3vw, 3rem);
    color: var(--paper);
    background: var(--ink);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .hero {
    position: relative;
    min-height: min(960px, 96svh);
    overflow: hidden;
    color: #fff6e3;
    background: var(--ink);
  }

  .hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.76) contrast(1.02) brightness(0.72);
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(24, 19, 16, 0.92) 0%, rgba(24, 19, 16, 0.55) 50%, rgba(24, 19, 16, 0.1) 100%),
      radial-gradient(circle at 72% 38%, var(--light), transparent 34%),
      linear-gradient(0deg, rgba(24, 19, 16, 0.75), transparent 45%);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(920px, 78vw);
    min-height: min(960px, 96svh);
    flex-direction: column;
    justify-content: center;
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 6vw, 6rem);
  }

  .hero__copy > p:first-child,
  .hero__byline {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 950px;
    margin: 1.3rem 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(5rem, 12.2vw, 12rem);
    letter-spacing: -0.073em;
    line-height: 0.73;
    text-wrap: balance;
  }

  .hero h1 em {
    color: var(--gold);
    font-style: normal;
  }

  .hero__dek {
    max-width: 680px;
    font-family: var(--pc-font-sans);
    font-size: clamp(1.25rem, 2.5vw, 2.25rem);
    font-weight: 750;
    line-height: 1.18;
  }

  .hero__byline { margin-top: 2rem; color: var(--gold); }

  .hero__key {
    position: absolute;
    z-index: 3;
    top: 9%;
    right: 4%;
    display: grid;
    width: 170px;
    min-height: 220px;
    place-items: center;
    padding: 1rem;
    border: 3px solid var(--ink);
    color: var(--ink);
    background: var(--gold);
    box-shadow: 10px 12px 0 var(--oxblood);
    transform: rotate(3deg);
    text-align: center;
  }

  .hero__key span,
  .hero__key small { font-size: 0.62rem; font-weight: 900; }
  .hero__key strong { font-family: Impact, sans-serif; font-size: 6.5rem; line-height: 0.8; }

  .hero__door {
    position: absolute;
    z-index: 3;
    right: 2rem;
    bottom: 2rem;
    min-height: 48px;
    padding: 0.9rem 1rem;
    border: 2px solid #fff6e3;
    background: rgba(24, 19, 16, 0.7);
    font-size: 0.65rem;
    font-weight: 900;
    text-decoration: none;
  }

  .room-nav {
    display: flex;
    gap: 1px;
    overflow-x: auto;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--ink);
  }

  .room-nav a {
    flex: 1 0 170px;
    padding: 0.85rem;
    background: var(--paper);
    font-size: 0.57rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .room-nav a:hover,
  .room-nav a:focus-visible { background: var(--gold); }
  .room-nav span { margin-right: 0.7rem; color: var(--oxblood); font-size: 1.2rem; }

  .front-door {
    display: grid;
    grid-template-columns: minmax(180px, 0.3fr) minmax(0, 0.9fr) minmax(300px, 0.56fr);
    gap: clamp(2rem, 5vw, 6rem);
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 5vw, 5rem);
    border-bottom: 3px solid var(--ink);
  }

  .front-door__label > p,
  .front-door__lead > p:first-child {
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .front-door__lead h2 {
    margin: 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(3.3rem, 7vw, 7.6rem);
    letter-spacing: -0.06em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .front-door__lead > p {
    margin-top: 2rem;
    font-family: var(--pc-font-sans);
    font-size: 1.15rem;
    font-weight: 720;
    line-height: 1.55;
  }

  .front-door__body {
    padding-top: 0.4rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    line-height: 1.7;
  }

  .front-door__body p:first-child::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    color: var(--oxblood);
    font-family: Impact, sans-serif;
    font-size: 5.6em;
    line-height: 0.72;
  }

  .light-switch {
    display: grid;
    gap: 0.4rem;
    margin-top: 3rem;
    padding: 0.8rem;
    border: 2px solid var(--ink);
    background: var(--paper-two);
  }

  .light-switch span { margin-bottom: 0.3rem; font-size: 0.55rem; font-weight: 900; }
  .light-switch button {
    min-height: 42px;
    border: 1px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
    font-size: 0.58rem;
    font-weight: 900;
    cursor: pointer;
  }
  .light-switch button[aria-pressed="true"] { color: var(--paper); background: var(--ink); }

  .contact-sheet {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
    padding: 2px;
    border-bottom: 3px solid var(--ink);
    background: var(--ink);
  }

  .contact-sheet__plate {
    position: relative;
    min-height: 380px;
    overflow: hidden;
    background: var(--blue);
  }

  .contact-sheet__plate--wide { grid-column: span 2; }
  .contact-sheet img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.78); transition: transform 500ms ease, filter 500ms ease; }
  .contact-sheet a:hover img,
  .contact-sheet a:focus-visible img { transform: scale(1.025); filter: saturate(1); }
  .contact-sheet span {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    left: 0.7rem;
    padding: 0.55rem;
    color: var(--paper);
    background: rgba(24, 19, 16, 0.82);
    font-size: 0.58rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .chapters { background: var(--paper); }

  .chapter {
    display: grid;
    min-height: 850px;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.82fr);
    border-bottom: 3px solid var(--ink);
  }

  .chapter--reverse { grid-template-columns: minmax(420px, 0.82fr) minmax(0, 1.05fr); }
  .chapter--reverse figure { order: 2; }
  .chapter--reverse .chapter__copy { order: 1; }

  .chapter figure {
    position: relative;
    min-height: 720px;
    margin: 0;
    overflow: hidden;
    background: var(--blue);
  }

  .chapter figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.02);
  }

  .chapter figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    max-width: 620px;
    padding: 0.8rem;
    color: var(--paper);
    background: rgba(24, 19, 16, 0.88);
  }

  .chapter figcaption span { color: var(--gold); font-size: 0.58rem; font-weight: 900; text-transform: uppercase; }
  .chapter figcaption p { margin: 0.4rem 0 0; font-family: var(--pc-font-sans); font-size: 0.88rem; line-height: 1.45; }

  .chapter__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 7rem) clamp(1.2rem, 5vw, 5rem);
  }

  .chapter__copy > span {
    color: var(--oxblood);
    font-family: Impact, sans-serif;
    font-size: clamp(5rem, 11vw, 11rem);
    line-height: 0.72;
  }

  .chapter__copy > p:nth-child(2) {
    margin: 1rem 0 0;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chapter h2 {
    margin: 1.3rem 0 2.2rem;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(3rem, 6vw, 6.5rem);
    letter-spacing: -0.06em;
    line-height: 0.84;
  }

  .chapter__copy > p:not(:nth-child(2)) {
    max-width: 680px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.05rem, 1.45vw, 1.26rem);
    line-height: 1.68;
  }

  .chapter__first { font-size: clamp(1.25rem, 1.9vw, 1.62rem) !important; line-height: 1.5 !important; }

  .refusal {
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 5vw, 5rem);
    color: var(--paper);
    background: var(--oxblood);
    border-bottom: 3px solid var(--ink);
  }

  .refusal > header {
    display: grid;
    grid-template-columns: 0.3fr 1fr;
    gap: 2rem;
  }

  .refusal header p,
  .rules header p,
  .closing > div > p,
  .credits > div:first-child > p { font-size: 0.62rem; font-weight: 900; letter-spacing: 0.08em; }

  .refusal h2,
  .rules h2,
  .credits h2 {
    margin: 0;
    font-family: Impact, "Arial Black", sans-serif;
    font-size: clamp(4rem, 9vw, 9rem);
    letter-spacing: -0.065em;
    line-height: 0.78;
  }

  .refusal h2 em { color: var(--gold); font-style: normal; }
  .refusal__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 4rem;
    border: 2px solid var(--paper);
  }

  .refusal__cards article { min-height: 330px; padding: 1.2rem; border-right: 1px solid var(--paper); }
  .refusal__cards article:last-child { border-right: 0; }
  .refusal__cards span { color: var(--gold); font-family: Impact, sans-serif; font-size: 3rem; }
  .refusal__cards h3 { margin: 4rem 0 1rem; font-family: Impact, sans-serif; font-size: 2.4rem; line-height: 0.9; }
  .refusal__cards p { font-family: var(--pc-font-sans); font-size: 1rem; line-height: 1.55; }

  .rules {
    padding: clamp(4rem, 9vw, 9rem) clamp(1rem, 5vw, 5rem);
    background: var(--gold);
    border-bottom: 3px solid var(--ink);
  }

  .rules > header {
    display: grid;
    grid-template-columns: 0.3fr 1fr;
    gap: 2rem;
  }

  .rules ol {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 4rem 0 0;
    padding: 0;
    border: 2px solid var(--ink);
    list-style: none;
  }

  .rules li {
    display: grid;
    min-height: 150px;
    grid-template-columns: 78px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .rules li:nth-child(2n) { border-right: 0; }
  .rules li:nth-last-child(-n + 2) { border-bottom: 0; }
  .rules li span { color: var(--oxblood); font-family: Impact, sans-serif; font-size: 3.5rem; }
  .rules li strong { font-family: var(--pc-font-sans); font-size: clamp(1.2rem, 2vw, 2rem); text-transform: uppercase; }

  .closing {
    position: relative;
    display: grid;
    min-height: 880px;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
    color: var(--paper);
    background: var(--blue);
    border-bottom: 3px solid var(--ink);
