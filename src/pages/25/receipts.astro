---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { POINTCAST_25 } from '../../lib/pointcast-25';
import { POINTCAST_25_RECEIPTS, POINTCAST_25_TEAMS } from '../../lib/pointcast-25-audience';

const description =
  'The public 2026 PointCast college-football prediction tracker: 25 preseason claims, the next proof required, and a permanent grade when the evidence arrives.';
const pageUrl = 'https://pointcast.xyz/25/receipts';
const statuses = [
  ['OPEN', 'The claim is waiting for relevant evidence.'],
  ['ALIVE', 'Evidence arrived and the claim still holds.'],
  ['COMPLICATED', 'The claim needs a public revision, not deletion.'],
  ['PROVEN', 'The required proof arrived.'],
  ['DEAD', 'The evidence broke the claim.'],
] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'PointCast 25 2026 prediction receipts',
  description,
  url: pageUrl,
  datePublished: POINTCAST_25.publishedAt,
  creator: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://pointcast.xyz/25/receipts.json',
  },
  variableMeasured: ['PointCast rank', 'claim status', 'claim', 'next observable proof'],
};
---

<BlockLayout
  title="2026 College Football Prediction Tracker"
  description={description}
  image="/images/pointcast-25/board-000.png"
  themeColor="#ff6a3d"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    {
      type: 'application/json',
      href: '/25/receipts.json',
      title: 'PointCast 25 Prediction Receipts JSON',
    },
  ]}
>
  <main class="receipt-page">
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <nav aria-label="PointCast 25 receipt navigation">
        <a href="/25">Current 25</a>
        <a href="/25/disagreements">Disagreements</a>
        <a href="/25/season">Season ledger</a>
        <a href="/25/receipts.json">JSON</a>
      </nav>
    </header>

    <section class="hero">
      <p>POINTCAST 25 · 2026 · PUBLIC CLAIM TRACKER</p>
      <h1>KEEP<br />THE<br /><em>RECEIPTS.</em></h1>
      <div>
        <strong>{POINTCAST_25_RECEIPTS.length} OPEN CLAIMS</strong>
        <p>
          Anybody can rank teams. This is where the reasons get graded.
          Every preseason sentence stays visible after the season starts.
        </p>
      </div>
    </section>

    <section class="key" aria-labelledby="key-title">
      <p class="label">THE GRADING KEY</p>
      <div>
        <h2 id="key-title">Revision is allowed.<br />Disappearance isn’t.</h2>
        <ol>
          {statuses.map(([status, note]) => (
            <li>
              <strong>{status}</strong>
              <span>{note}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="book" aria-labelledby="book-title">
      <div class="book__head">
        <div>
          <p class="label">BOARD {POINTCAST_25.board} · PRESEASON</p>
          <h2 id="book-title">The open book</h2>
        </div>
        <p>Published July 27, 2026 · first evidence arrives Week Zero</p>
      </div>

      <ol>
        {POINTCAST_25_TEAMS.map((team) => (
          <li>
            <article>
              <div class="rank">{String(team.rank).padStart(2, '0')}</div>
              <div class="team">
                <span>{team.conference}</span>
                <h3><a href={`/25/teams/${team.slug}`}>{team.school}</a></h3>
              </div>
              <div class="claim">
                <span>CLAIM</span>
                <p>{team.reason}</p>
              </div>
              <div class="proof">
                <span>NEXT PROOF</span>
                <p>{team.proof}</p>
              </div>
              <div class="state">OPEN</div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="closing">
      <p class="label">THE FINAL PRODUCT</p>
      <h2>At season’s end:<br />an autopsy, not a victory montage.</h2>
      <p>
        Every proven read, surviving doubt, public revision, and dead claim will
        remain attached to the board that opened it.
      </p>
      <a href="/25/season">Open the permanent season ledger →</a>
    </section>

    <footer>
      <span>POINTCAST 25 · BOARD {POINTCAST_25.board}</span>
      <nav aria-label="PointCast 25 receipt footer">
        <a href="/25">The complete ranking</a>
        <a href="/25/disagreements">The disagreement index</a>
        <a href="/c/spinning.rss">Follow the season</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #f3efe3;
    color: #151412;
    font-family: var(--pc-font-sans);
  }

  .receipt-page {
    margin: 0 auto;
    max-width: 1500px;
    overflow: hidden;
  }

  .mast,
  .mast nav,
  footer,
  footer nav {
    align-items: center;
    display: flex;
  }

  .mast {
    border-bottom: 1px solid #151412;
    justify-content: space-between;
    padding: 20px clamp(18px, 4vw, 64px);
  }

  .brand {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .mast nav,
  footer nav {
    gap: clamp(12px, 2vw, 28px);
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .mast a,
  .hero > p,
  .label,
  .book__head > p,
  .team > span,
  .claim > span,
  .proof > span,
  .state,
  footer {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    min-height: 82vh;
    padding: 55px clamp(18px, 5vw, 80px);
  }

  .hero h1 {
    font-size: clamp(90px, 18vw, 260px);
    letter-spacing: -0.11em;
    line-height: 0.67;
    margin: 60px 0;
  }

  .hero em {
    color: #ff4c18;
    font-style: normal;
  }

  .hero > div {
    align-items: baseline;
    display: grid;
    gap: 40px;
    grid-template-columns: 0.4fr 1fr;
    margin-left: auto;
    max-width: 900px;
  }

  .hero strong {
    color: #ff4c18;
    font-family: var(--pc-font-mono);
    font-size: 16px;
  }

  .hero div p,
  .closing > p {
    font-size: clamp(21px, 3vw, 38px);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }

  .key {
    background: #151412;
    color: #f3efe3;
    display: grid;
    gap: 40px;
    grid-template-columns: 0.3fr 1fr;
    padding: 85px clamp(18px, 5vw, 80px);
  }

  .key h2,
  .book__head h2,
  .closing h2 {
    font-size: clamp(42px, 7vw, 100px);
    letter-spacing: -0.08em;
    line-height: 0.88;
    margin: 0;
  }

  .key ol {
    list-style: none;
    margin: 60px 0 0;
    padding: 0;
  }

  .key li {
    border-top: 1px solid #4d4b45;
    display: grid;
    gap: 20px;
    grid-template-columns: 140px 1fr;
    padding: 14px 0;
  }

  .key li strong {
    color: #ff6a3d;
    font-family: var(--pc-font-mono);
  }

  .book {
    padding: 80px clamp(18px, 5vw, 80px);
  }

  .book__head {
    align-items: end;
    border-bottom: 8px solid #151412;
    display: flex;
    justify-content: space-between;
    padding-bottom: 25px;
  }

  .book__head h2 {
    margin-top: 14px;
  }

  .book > ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .book > ol > li {
    border-bottom: 1px solid #aaa69a;
  }

  article {
    align-items: start;
    display: grid;
    gap: 18px;
    grid-template-columns: 64px minmax(150px, 0.3fr) 1fr 1fr 72px;
    padding: 24px 0;
  }

  .rank {
    color: #ff4c18;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .team h3 {
    font-size: clamp(21px, 2vw, 32px);
    letter-spacing: -0.05em;
    margin: 5px 0 0;
  }

  .claim p,
  .proof p {
    font-size: 15px;
    line-height: 1.45;
    margin: 5px 0 0;
  }

  .claim > span,
  .proof > span {
    color: #76736b;
  }

  .state {
    background: #ff4c18;
    color: #fff;
    padding: 6px 8px;
    text-align: center;
  }

  .closing {
    border-top: 1px solid #151412;
    padding: 95px clamp(18px, 5vw, 80px);
  }

  .closing h2 {
    margin: 24px 0 40px;
  }

  .closing > p {
    max-width: 900px;
  }

  .closing > a {
    display: inline-block;
    font-weight: 800;
    margin-top: 38px;
  }

  footer {
    background: #ff4c18;
    color: #fff;
    justify-content: space-between;
    padding: 36px clamp(18px, 5vw, 80px);
  }

  @media (max-width: 920px) {
    article {
      grid-template-columns: 55px 1fr 70px;
    }

    .claim,
    .proof {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 700px) {
    .mast {
      align-items: flex-start;
    }

    .mast nav,
    footer nav {
      align-items: flex-end;
      flex-direction: column;
      gap: 8px;
    }

    .hero {
      min-height: 0;
    }

    .hero > div,
    .key {
      grid-template-columns: 1fr;
    }

    .key li {
      grid-template-columns: 105px 1fr;
    }

    .book__head,
    footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    article {
      grid-template-columns: 48px 1fr;
    }

    .state {
      grid-column: 1;
      grid-row: 2;
    }

    .claim,
    .proof {
      grid-column: 2;
    }
  }
</style>
