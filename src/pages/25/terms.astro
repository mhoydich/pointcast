---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { POINTCAST_25 } from '../../lib/pointcast-25';

const description =
  'Plain-language purchase and privacy terms for the PointCast 25 / 2026 Founding Season Ticket.';
---

<BlockLayout
  title="PointCast 25 Season Ticket terms"
  description={description}
  image="/images/pointcast-25/board-000.png"
  themeColor="#f4ff3f"
  immersive={true}
  showNetworkStrip={false}
>
  <main class="terms">
    <header>
      <a href="/25">← Board {POINTCAST_25.board}</a>
      <p>POINTCAST 25 · PLAIN-LANGUAGE TERMS</p>
      <h1>One season.<br />One payment.</h1>
    </header>

    <section>
      <h2>What you are buying</h2>
      <p>
        The PointCast 25 / 2026 Founding Season Ticket is a one-time
        <strong>${POINTCAST_25.sale.priceUsd} USD</strong> purchase supporting
        PointCast’s 2026 college-football editorial season. It is not a recurring
        subscription and does not renew automatically.
      </p>
    </section>

    <section>
      <h2>What PointCast is promising</h2>
      <p>
        PointCast intends to publish a public Tuesday belief board during the
        2026 season, with reasons, movement history, source receipts, permanent
        team pages, and an end-of-season accountability ledger. Rankings
        are editorial opinion and may change as evidence changes.
      </p>
    </section>

    <section>
      <h2>Public work, paid backing</h2>
      <p>
        The ranking remains publicly readable. The Season Ticket is patronage for
        producing and preserving the work; it does not promise gambling advice,
        game access, licensed highlights, guaranteed outcomes, or a financial return.
      </p>
    </section>

    <section>
      <h2>Cards, email, and privacy</h2>
      <p>
        Checkout, card entry, payment authorization, and the purchase receipt are
        handled on Stripe’s hosted service. PointCast does not receive or store
        your full card number. Stripe may collect the email and billing information
        required to process the payment and send a receipt under its own terms and
        privacy policy.
      </p>
    </section>

    <section>
      <h2>Questions and refund requests</h2>
      <p>
        Write <a href="mailto:hello@pointcast.xyz">hello@pointcast.xyz</a> with
        the purchase email and receipt reference. Do not send card details.
      </p>
    </section>

    <footer>
      <a class="buy" href="/api/25/checkout" target="_blank" rel="noopener sponsored">
        Buy the ${POINTCAST_25.sale.priceUsd} Season Ticket ↗
      </a>
      <a href="/25">Return to the board</a>
      <span>Effective July 27, 2026 · El Segundo, California</span>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #f3f0e8;
    color: #11110f;
    font-family: var(--pc-font-sans);
  }

  .terms {
    margin: 0 auto;
    max-width: 900px;
    padding: 24px 18px 100px;
  }

  header {
    border-bottom: 8px solid #11110f;
    padding: 20px 0 70px;
  }

  header > a,
  header p,
  footer {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  a {
    color: inherit;
  }

  h1 {
    font-size: clamp(68px, 13vw, 150px);
    letter-spacing: -0.09em;
    line-height: 0.78;
    margin: 80px 0 0;
  }

  section {
    border-bottom: 1px solid #11110f;
    display: grid;
    gap: 30px;
    grid-template-columns: minmax(170px, 0.35fr) 1fr;
    padding: 36px 0;
  }

  h2 {
    font-size: 22px;
    letter-spacing: -0.04em;
    margin: 0;
  }

  section p {
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
  }

  footer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: space-between;
    padding-top: 36px;
  }

  .buy {
    background: #f4ff3f;
    border: 1px solid #11110f;
    font-weight: 800;
    padding: 16px;
    text-decoration: none;
  }

  footer span {
    color: #63615b;
  }

  @media (max-width: 640px) {
    section {
      grid-template-columns: 1fr;
    }

    footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
