---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  DIVISION_ONE_CONFERENCES,
  DIVISION_ONE_DIRECTORY,
  DIVISION_ONE_PROGRAMS,
  DIVISION_ONE_STATE_NAMES,
  DIVISION_ONE_STATES,
} from '../../lib/pointcast-division-one-directory';

const description =
  'A complete student-facing directory of all 266 NCAA Division I football programs for 2026–27: 138 FBS, 128 FCS, official campus and athletics links, transparent PointCast field order, filters, and a private local shortlist.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${DIVISION_ONE_DIRECTORY.canonical}#dataset`,
  name: `${DIVISION_ONE_DIRECTORY.title} — Division I Football Directory`,
  description,
  url: DIVISION_ONE_DIRECTORY.canonical,
  datePublished: DIVISION_ONE_DIRECTORY.publishedAt,
  dateModified: DIVISION_ONE_DIRECTORY.publishedAt,
  temporalCoverage: DIVISION_ONE_DIRECTORY.academicYear,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: DIVISION_ONE_DIRECTORY.machineEdition,
  },
  creator: { '@type': 'Organization', name: 'PointCast' },
  measurementTechnique: 'NCAA membership-directory snapshot plus PointCast Board 000 editorial order',
  variableMeasured: ['subdivision', 'conference', 'state', 'institution type', 'HBCU status', 'PointCast top-25 rank'],
};
---

<BlockLayout
  title="The Saturday Atlas — 266 Division I Football Programs"
  description={description}
  image="/images/pointcast-d1-directory/social-card.png"
  themeColor="#10130f"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/25/directory.json', title: 'The Saturday Atlas dataset' },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: DIVISION_ONE_DIRECTORY.socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Open all 266', action: 'link', target: DIVISION_ONE_DIRECTORY.canonical },
      { label: 'Machine edition', action: 'link', target: DIVISION_ONE_DIRECTORY.machineEdition },
    ],
  }}
>
  <main class="atlas">
    <header class="atlas-mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · DIRECTORY DESK 001</span>
      <nav aria-label="Directory utility">
        <a href="/25">THE 25</a>
        <a href="/25/magazine">MAGAZINE</a>
        <a href="/25/directory.json">JSON</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="atlas-title">
      <div class="hero__signal" aria-hidden="true">
        <span>DIVISION</span>
        <strong>I</strong>
        <i>2026–27</i>
      </div>
      <div class="hero__copy">
        <p class="eyebrow">EVERY PROGRAM · ONE HONEST PLACE TO BEGIN</p>
        <h1 id="atlas-title">THE<br /><em>SATURDAY</em><br />ATLAS</h1>
        <p class="dek">{DIVISION_ONE_DIRECTORY.subtitle}</p>
        <p class="promise">{DIVISION_ONE_DIRECTORY.studentPromise}</p>
        <div class="hero__actions">
          <a href="#directory">Find a program ↓</a>
          <a href="#student-lens">Use the student lens</a>
        </div>
      </div>
      <dl class="hero__count">
        <div><dt>{DIVISION_ONE_DIRECTORY.counts.programs}</dt><dd>Division I programs</dd></div>
        <div><dt>{DIVISION_ONE_DIRECTORY.counts.fbs}</dt><dd>FBS</dd></div>
        <div><dt>{DIVISION_ONE_DIRECTORY.counts.fcs}</dt><dd>FCS</dd></div>
        <div><dt>{DIVISION_ONE_DIRECTORY.counts.hbcu}</dt><dd>HBCUs</dd></div>
      </dl>
    </section>

    <section class="truth-strip" aria-label="Directory method">
      <strong>THE TOP 25 IS A RANKING.</strong>
      <span>THE OTHER 241 ARE A DIRECTORY.</span>
      <a href="#method">READ THE DIFFERENCE ↘</a>
    </section>

    <section class="student-lens" id="student-lens" aria-labelledby="student-lens-title">
      <header>
        <p class="section-label">THE STUDENT LENS</p>
        <h2 id="student-lens-title">Football is one room.<br /><em>You live in the whole house.</em></h2>
      </header>
      <div class="student-lens__intro">
        <p>
          A stadium can reveal scale, ritual, weather, distance, money, and the way a
          campus gathers. It cannot tell you whether the school is right for you.
          Start with the signal, then keep asking better questions.
        </p>
        <a href="https://www.ncaa.org/student-athletes/future" target="_blank" rel="noopener">NCAA future student-athletes ↗</a>
      </div>
      <ol>
        {DIVISION_ONE_DIRECTORY.studentQuestions.map((question, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><p>{question}</p></li>
        ))}
      </ol>
    </section>

    <section class="directory" id="directory" aria-labelledby="directory-title">
      <header class="directory__head">
        <div>
          <p class="section-label">THE COMPLETE FIELD · NCAA DIRECTORY SNAPSHOT {DIVISION_ONE_DIRECTORY.asOf}</p>
          <h2 id="directory-title">Find your Saturday.</h2>
        </div>
        <p>
          Search names and conferences. Sort the field. Save a shortlist on this
          device. Open the campus before the athletics site.
        </p>
      </header>

      <div class="directory__controls" aria-label="Filter the Division I directory">
        <label class="search-control">
          <span>SEARCH</span>
          <input type="search" placeholder="School, conference, state…" autocomplete="off" data-atlas-search />
        </label>
        <label>
          <span>SUBDIVISION</span>
          <select data-atlas-subdivision>
            <option value="all">FBS + FCS</option>
            <option value="FBS">FBS only</option>
            <option value="FCS">FCS only</option>
          </select>
        </label>
        <label>
          <span>STATE</span>
          <select data-atlas-state>
            <option value="all">Every state</option>
            {DIVISION_ONE_STATES.map((state) => <option value={state}>{DIVISION_ONE_STATE_NAMES[state]} · {state}</option>)}
          </select>
        </label>
        <label>
          <span>CONFERENCE</span>
          <select data-atlas-conference>
            <option value="all">Every conference</option>
            {DIVISION_ONE_CONFERENCES.map((conference) => <option value={conference}>{conference}</option>)}
          </select>
        </label>
        <label>
          <span>INSTITUTION</span>
          <select data-atlas-type>
            <option value="all">Public + private</option>
            <option value="Public">Public</option>
            <option value="Private">Private</option>
          </select>
        </label>
        <label>
          <span>SORT</span>
          <select data-atlas-sort>
            <option value="field">PointCast field order</option>
            <option value="name">School A–Z</option>
            <option value="state">State, then school</option>
            <option value="conference">Conference, then school</option>
          </select>
        </label>
        <label class="check-control"><input type="checkbox" data-atlas-hbcu /><span>HBCUs only</span></label>
        <label class="check-control"><input type="checkbox" data-atlas-saved /><span>My shortlist only</span></label>
      </div>

      <div class="directory__status" aria-live="polite">
        <p><strong data-atlas-count>{DIVISION_ONE_PROGRAMS.length}</strong> programs on the field</p>
        <p><span data-atlas-saved-count>0</span> saved on this device</p>
        <button type="button" data-atlas-reset>Reset the field</button>
      </div>

      <ol class="program-list" data-atlas-list>
        {DIVISION_ONE_PROGRAMS.map((program) => (
          <li
            id={program.slug}
            class={`program program--${program.subdivision.toLowerCase()}`}
            data-program
            data-field={program.fieldPosition}
            data-rank={program.pointcastRank ?? ''}
            data-name={program.displayName.toLowerCase()}
            data-official={program.officialName.toLowerCase()}
            data-subdivision={program.subdivision}
            data-conference={program.conference}
            data-state={program.state}
            data-state-name={program.stateName.toLowerCase()}
            data-type={program.institutionType}
            data-hbcu={String(program.hbcu)}
          >
            <article>
              <div class="program__position">
                <span>{String(program.fieldPosition).padStart(3, '0')}</span>
                <small>{program.pointcastRank ? `POINTCAST #${program.pointcastRank}` : 'DIRECTORY ORDER'}</small>
              </div>
              <div class="program__identity">
                <div class="program__chips">
                  <span>{program.subdivision}</span>
                  <span>{program.state}</span>
                  <span>{program.institutionType}</span>
                  {program.hbcu && <span class="program__hbcu">HBCU</span>}
                </div>
                <h3>{program.displayName}</h3>
                {program.displayName !== program.officialName && <p class="program__official">{program.officialName}</p>}
                <p class="program__conference">{program.conference}</p>
              </div>
              <div class="program__actions">
                {program.institutionUrl && <a href={program.institutionUrl} target="_blank" rel="noopener">Campus ↗</a>}
                {program.athleticsUrl && <a href={program.athleticsUrl} target="_blank" rel="noopener">Athletics ↗</a>}
                <button type="button" data-atlas-save={program.slug} aria-pressed="false">＋ Shortlist</button>
              </div>
            </article>
          </li>
        ))}
      </ol>
      <div class="directory__empty" data-atlas-empty hidden>
        <strong>No program matches that map.</strong>
        <button type="button" data-atlas-reset>Clear the filters</button>
      </div>
    </section>

    <section class="method" id="method" aria-labelledby="method-title">
      <div>
        <p class="section-label">HOW THE ORDER WORKS</p>
        <h2 id="method-title">A ranking where we have an argument.<br /><em>A directory everywhere else.</em></h2>
      </div>
      <div class="method__copy">
        <p>{DIVISION_ONE_DIRECTORY.fieldOrder}</p>
        <p>
          The source snapshot is the NCAA’s 2026–27 FBS and FCS member-directory
          output. Names, subdivision, conference, state, public/private status,
          HBCU status, and destination links come from that directory. PointCast
          supplies the display names, interaction, and top-25 overlay.
        </p>
      </div>
      <dl>
        <div><dt>01–25</dt><dd>Current PointCast Board 000. Football belief, with receipts.</dd></div>
        <div><dt>26–138</dt><dd>Remaining FBS programs, alphabetical. Browse order only.</dd></div>
        <div><dt>139–266</dt><dd>FCS programs, alphabetical. Browse order only.</dd></div>
        <div><dt>LOCAL</dt><dd>Your shortlist stays in this browser. It is not transmitted.</dd></div>
      </dl>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header><p class="section-label">SOURCE DESK</p><h2 id="sources-title">Start official.<br />Stay curious.</h2></header>
      <ol>
        {DIVISION_ONE_DIRECTORY.sources.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <a href={source.url} target="_blank" rel="noopener">{source.label} ↗</a>
            <small>CHECKED {source.checkedAt}</small>
          </li>
        ))}
      </ol>
    </section>

    <footer class="atlas-footer">
      <p>{DIVISION_ONE_DIRECTORY.boundaries.affiliation}</p>
      <p>{DIVISION_ONE_DIRECTORY.boundaries.admissions}</p>
      <nav><a href="/25/directory.json">JSON</a><a href="/b/0570">BLOCK 0570</a><a href="/25/magazine">MAGAZINE</a><a href="/25">THE 25</a></nav>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const storageKey = 'pointcast:d1-shortlist:v1';
      const list = document.querySelector('[data-atlas-list]');
      if (!list) return;

      const cards = Array.from(list.querySelectorAll('[data-program]'));
      const search = document.querySelector('[data-atlas-search]');
      const subdivision = document.querySelector('[data-atlas-subdivision]');
      const state = document.querySelector('[data-atlas-state]');
      const conference = document.querySelector('[data-atlas-conference]');
      const type = document.querySelector('[data-atlas-type]');
      const sort = document.querySelector('[data-atlas-sort]');
      const hbcu = document.querySelector('[data-atlas-hbcu]');
      const savedOnly = document.querySelector('[data-atlas-saved]');
      const count = document.querySelector('[data-atlas-count]');
      const savedCount = document.querySelector('[data-atlas-saved-count]');
      const empty = document.querySelector('[data-atlas-empty]');
      let saved = new Set();

      try {
        const parsed = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (Array.isArray(parsed)) saved = new Set(parsed.filter((item) => typeof item === 'string'));
      } catch (_) {}

      const normalized = (value) => String(value || '').toLowerCase().trim();
      const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });

      function persist() {
        try { localStorage.setItem(storageKey, JSON.stringify(Array.from(saved))); } catch (_) {}
      }

      function updateSaveButtons() {
        document.querySelectorAll('[data-atlas-save]').forEach((button) => {
          const isSaved = saved.has(button.dataset.atlasSave);
          button.setAttribute('aria-pressed', String(isSaved));
          button.textContent = isSaved ? '✓ Shortlisted' : '＋ Shortlist';
        });
        savedCount.textContent = String(saved.size);
      }

      function compareCards(a, b) {
        const mode = sort.value;
        if (mode === 'name') return collator.compare(a.dataset.name, b.dataset.name);
        if (mode === 'state') {
          return collator.compare(a.dataset.stateName, b.dataset.stateName) || collator.compare(a.dataset.name, b.dataset.name);
        }
        if (mode === 'conference') {
          return collator.compare(a.dataset.conference, b.dataset.conference) || collator.compare(a.dataset.name, b.dataset.name);
        }
        return Number(a.dataset.field) - Number(b.dataset.field);
      }

      function render() {
        const query = normalized(search.value);
        let shown = 0;

        cards.sort(compareCards).forEach((card) => {
          const haystack = normalized([
            card.dataset.name,
            card.dataset.official,
            card.dataset.conference,
            card.dataset.state,
            card.dataset.stateName,
            card.dataset.subdivision,
          ].join(' '));
          const matches =
            (!query || haystack.includes(query)) &&
            (subdivision.value === 'all' || card.dataset.subdivision === subdivision.value) &&
            (state.value === 'all' || card.dataset.state === state.value) &&
            (conference.value === 'all' || card.dataset.conference === conference.value) &&
            (type.value === 'all' || card.dataset.type === type.value) &&
            (!hbcu.checked || card.dataset.hbcu === 'true') &&
            (!savedOnly.checked || saved.has(card.id));
          card.hidden = !matches;
          if (matches) shown += 1;
          list.appendChild(card);
        });

        count.textContent = String(shown);
        empty.hidden = shown !== 0;
        updateSaveButtons();
      }

      document.querySelectorAll('[data-atlas-save]').forEach((button) => {
        button.addEventListener('click', () => {
          const slug = button.dataset.atlasSave;
          if (saved.has(slug)) saved.delete(slug); else saved.add(slug);
          persist();
          render();
        });
      });

      [search, subdivision, state, conference, type, sort, hbcu, savedOnly].forEach((control) => {
        control.addEventListener(control === search ? 'input' : 'change', render);
      });

      document.querySelectorAll('[data-atlas-reset]').forEach((button) => {
        button.addEventListener('click', () => {
          search.value = '';
          subdivision.value = 'all';
          state.value = 'all';
          conference.value = 'all';
          type.value = 'all';
          sort.value = 'field';
          hbcu.checked = false;
          savedOnly.checked = false;
          render();
          search.focus();
        });
      });

      render();
    })();
  </script>
</BlockLayout>

<style>
  :global(body) { background: #ece9dc; }
  .atlas { --ink:#10130f; --paper:#f4f0df; --signal:#d7ff35; --blue:#87cfff; --red:#ff6d49; color:var(--ink); background:var(--paper); font-family:var(--pc-font-sans); }
  .atlas * { box-sizing:border-box; }
  .atlas a { color:inherit; }
  .atlas-mast { position:sticky; z-index:20; top:0; display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:center; min-height:54px; padding:10px clamp(16px,4vw,64px); color:#fff; background:rgba(16,19,15,.96); border-bottom:1px solid rgba(255,255,255,.25); backdrop-filter:blur(16px); font-family:var(--pc-font-mono); font-size:10px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .atlas-mast > a { font-size:16px; text-decoration:none; }
  .atlas-mast nav { display:flex; justify-content:flex-end; gap:18px; }
  .atlas-mast nav a { text-decoration:none; }
  .atlas-mast nav a:hover { color:var(--signal); }
  .hero { display:grid; grid-template-columns:.62fr 1.18fr .62fr; min-height:760px; border-bottom:2px solid var(--ink); background:linear-gradient(100deg,#10130f 0 22%,#f4f0df 22% 78%,#87cfff 78%); }
  .hero__signal { position:relative; display:flex; min-width:0; flex-direction:column; justify-content:space-between; padding:clamp(26px,4vw,70px); overflow:hidden; color:var(--signal); font-family:var(--pc-font-mono); }
  .hero__signal::before { position:absolute; inset:18% -80% auto -20%; height:42%; border:20px solid var(--signal); border-radius:50%; content:''; transform:rotate(-18deg); opacity:.86; }
  .hero__signal span,.hero__signal i { position:relative; z-index:1; font-size:12px; font-style:normal; font-weight:800; letter-spacing:.15em; }
  .hero__signal strong { position:relative; z-index:1; align-self:center; font-family:var(--pc-font-sans); font-size:clamp(190px,24vw,360px); font-weight:950; letter-spacing:-.15em; line-height:.7; transform:translateX(-.08em); }
  .hero__copy { display:flex; min-width:0; flex-direction:column; justify-content:center; padding:clamp(38px,7vw,110px); }
  .eyebrow,.section-label { margin:0 0 18px; font-family:var(--pc-font-mono); font-size:10px; font-weight:900; letter-spacing:.14em; text-transform:uppercase; }
  .hero h1 { margin:0; font-size:clamp(70px,10vw,162px); font-weight:950; letter-spacing:-.085em; line-height:.72; }
  .hero h1 em { color:#145df5; font-style:normal; }
  .dek { max-width:680px; margin:38px 0 8px; font-size:clamp(22px,2.4vw,38px); font-weight:750; letter-spacing:-.035em; line-height:1.04; }
  .promise { max-width:660px; font-size:16px; line-height:1.55; }
  .hero__actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
  .hero__actions a { padding:13px 16px; border:1px solid var(--ink); background:#fff; font-family:var(--pc-font-mono); font-size:10px; font-weight:900; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; box-shadow:4px 4px 0 var(--ink); }
  .hero__actions a:first-child { background:var(--signal); }
  .hero__count { display:flex; flex-direction:column; justify-content:flex-end; margin:0; padding:clamp(20px,3vw,46px); }
  .hero__count div { padding:18px 0; border-top:1px solid var(--ink); }
  .hero__count dt { font-size:clamp(54px,6vw,98px); font-weight:950; letter-spacing:-.08em; line-height:.76; }
  .hero__count dd { margin:8px 0 0; font-family:var(--pc-font-mono); font-size:9px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  .truth-strip { display:flex; justify-content:space-between; gap:24px; padding:15px clamp(16px,4vw,64px); color:#fff; background:#145df5; border-bottom:2px solid var(--ink); font-family:var(--pc-font-mono); font-size:11px; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .truth-strip span { color:var(--signal); }
  .student-lens { display:grid; grid-template-columns:.8fr .7fr 1fr; border-bottom:2px solid var(--ink); }
  .student-lens > * { padding:clamp(30px,5vw,80px); }
  .student-lens header,.student-lens__intro { border-right:1px solid var(--ink); }
  .student-lens h2,.directory__head h2,.method h2,.sources h2 { margin:0; font-size:clamp(46px,6vw,94px); font-weight:900; letter-spacing:-.07em; line-height:.85; }
  .student-lens h2 em,.method h2 em { color:#145df5; font-style:normal; }
  .student-lens__intro { display:flex; flex-direction:column; justify-content:space-between; font-size:17px; line-height:1.55; }
  .student-lens__intro a { width:fit-content; font-family:var(--pc-font-mono); font-size:10px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .student-lens ol { margin:0; list-style:none; }
  .student-lens li { display:grid; grid-template-columns:40px 1fr; gap:12px; padding:15px 0; border-top:1px solid var(--ink); }
  .student-lens li:first-child { border-top:0; }
  .student-lens li span { font-family:var(--pc-font-mono); font-size:10px; font-weight:900; }
  .student-lens li p { margin:0; font-size:15px; line-height:1.4; }
  .directory { padding:clamp(26px,5vw,78px); border-bottom:2px solid var(--ink); background:#fffdf5; }
  .directory__head { display:grid; grid-template-columns:1.2fr .8fr; gap:32px; align-items:end; padding-bottom:30px; }
  .directory__head p:last-child { max-width:520px; justify-self:end; font-size:18px; line-height:1.5; }
  .directory__controls { display:grid; grid-template-columns:2fr repeat(5,minmax(130px,1fr)); gap:1px; border:1px solid var(--ink); background:var(--ink); }
  .directory__controls label { display:flex; min-width:0; flex-direction:column; gap:8px; padding:11px; background:var(--paper); }
  .directory__controls label > span { font-family:var(--pc-font-mono); font-size:8px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  .directory__controls input,.directory__controls select { width:100%; min-width:0; border:0; border-bottom:1px solid var(--ink); border-radius:0; background:transparent; color:var(--ink); font:600 13px/1.2 var(--pc-font-sans); }
  .directory__controls input { padding:5px 0; }
  .directory__controls select { padding:4px 18px 4px 0; }
  .directory__controls .check-control { flex-direction:row; align-items:center; justify-content:center; background:var(--signal); }
  .check-control input { width:18px; height:18px; accent-color:#10130f; }
  .directory__status { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:14px 0; border-bottom:3px solid var(--ink); font-family:var(--pc-font-mono); font-size:10px; font-weight:800; text-transform:uppercase; }
  .directory__status p { margin:0; }
  .directory__status strong { font-size:18px; }
  .directory__status button,.directory__empty button { border:0; background:none; font:inherit; text-decoration:underline; text-transform:uppercase; cursor:pointer; }
  .program-list { margin:0; padding:0; list-style:none; }
  .program { border-bottom:1px solid var(--ink); }
  .program[hidden] { display:none; }
  .program article { display:grid; grid-template-columns:150px minmax(0,1fr) auto; gap:24px; align-items:center; min-height:132px; padding:18px 8px; transition:background 120ms ease,transform 120ms ease; }
  .program article:hover { background:#fff; transform:translateX(3px); }
  .program--fcs article { background:rgba(135,207,255,.12); }
  .program__position { display:flex; flex-direction:column; gap:8px; }
  .program__position > span { font-size:44px; font-weight:950; letter-spacing:-.08em; line-height:.8; }
