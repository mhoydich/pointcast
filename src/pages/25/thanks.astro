---
import BlockLayout from '../../layouts/BlockLayout.astro';
---

<BlockLayout
  title="Season Ticket received"
  description="Thank you for backing the PointCast 25 / 2026 editorial season."
  image="/images/pointcast-25/board-000.png"
  themeColor="#f4ff3f"
  immersive={true}
  showNetworkStrip={false}
  noindex={true}
>
  <main class="thanks">
    <p>POINTCAST 25 · FOUNDING SEASON</p>
    <h1>You were here<br />at Board 000.</h1>
    <p class="dek">
      Stripe will send the payment receipt to the email used at checkout.
      Keep it as the Season Ticket record. PointCast never receives your full card number.
    </p>
    <div>
      <a href="/25">Return to the 25</a>
      <a href="/c/spinning.rss">Follow the Spinning feed</a>
    </div>
    <small>
      If a receipt does not arrive, contact
      <a href="mailto:hello@pointcast.xyz">hello@pointcast.xyz</a> without sending card details.
    </small>
  </main>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #10100f;
    color: white;
    font-family: var(--pc-font-sans);
  }

  .thanks {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    max-width: 1100px;
    min-height: 100vh;
    padding: 40px 20px;
  }

  .thanks > p:first-child,
  small {
    color: #b7b6ae;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    color: #f4ff3f;
    font-size: clamp(70px, 13vw, 170px);
    letter-spacing: -0.09em;
    line-height: 0.78;
    margin: 38px 0;
  }

  .dek {
    font-size: clamp(18px, 2.4vw, 30px);
    line-height: 1.45;
    max-width: 800px;
  }

  .thanks div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0 70px;
  }

  .thanks div a {
    border: 1px solid white;
    color: white;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 16px;
    text-decoration: none;
    text-transform: uppercase;
  }

  small a {
    color: inherit;
  }
</style>
