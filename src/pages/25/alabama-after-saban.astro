---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { POINTCAST_25_ALABAMA } from '../../lib/pointcast-25-alabama';

const file = POINTCAST_25_ALABAMA;
const socialImage = 'https://pointcast.xyz/images/og/b/0529.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${file.canonical}#article`,
      headline: file.title,
      alternativeHeadline: file.shortTitle,
      description: file.description,
      url: file.canonical,
      mainEntityOfPage: file.canonical,
      image: socialImage,
      datePublished: file.publishedAt,
      dateModified: file.updatedAt,
      articleSection: ['Alabama football', 'Nick Saban', 'SEC primer'],
      isPartOf: {
        '@type': 'CollectionPage',
        '@id': 'https://pointcast.xyz/25#board',
        name: '25 FOR REASONS',
      },
      about: [
        {
          '@type': 'SportsTeam',
          name: 'Alabama Crimson Tide football',
          sport: 'College football',
        },
        {
          '@type': 'Person',
          name: 'Nick Saban',
          jobTitle: 'College Football Analyst',
        },
        {
          '@type': 'SportsOrganization',
          name: 'Southeastern Conference',
        },
      ],
      author: {
        '@type': 'Organization',
        name: 'PointCast',
        url: 'https://pointcast.xyz',
      },
      citation: file.sources.map((source) => source.url),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'PointCast', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: '25 FOR REASONS', item: 'https://pointcast.xyz/25' },
        { '@type': 'ListItem', position: 3, name: file.shortTitle, item: file.canonical },
      ],
    },
  ],
};
---

<BlockLayout
  title={file.title}
  description={file.description}
  image="/images/og/b/0529.png"
  themeColor="#9e1b32"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    {
      type: 'application/json',
      href: '/25/alabama-after-saban.json',
      title: `${file.title} JSON`,
    },
  ]}
>
  <article class="alabama-file">
    <header class="mast">
      <a class="brand" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="Alabama field file navigation">
        <a href="/25">The 25</a>
        <a href="/25/teams/alabama">Alabama receipt</a>
        <a href="#saban">Nick Saban</a>
        <a href="#sec">SEC primer</a>
        <a href="/25/alabama-after-saban.json">JSON</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="article-title">
        <div class="hero__mark" aria-hidden="true">A</div>
        <div class="hero__copy">
          <p class="eyebrow">{file.eyebrow}</p>
          <h1 id="article-title">
            THE STATE OF<br />
            <em>ALABAMA</em>
            <span>/</span>
            THE STATE OF<br />
            NICK SABAN
          </h1>
          <p class="dek">{file.dek}</p>
          <div class="hero__links">
            <a href="#alabama">Begin the file ↓</a>
            <a href="/b/0529">Permanent Block 0529 ↗</a>
          </div>
        </div>
      </section>

      <section class="score-strip" aria-label="Alabama 2026 state at a glance">
        <div>
          <span>2025</span>
          <strong>{file.board['2025Record']}</strong>
          <small>SEC title game · CFP win</small>
        </div>
        <div>
          <span>DEBOER</span>
          <strong>{file.board.deboerRecord}</strong>
          <small>Two Alabama seasons</small>
        </div>
        <div>
          <span>POINTCAST</span>
          <strong>#{file.board.pointcastRank}</strong>
          <small>Board 000</small>
        </div>
        <div>
          <span>SEC MEDIA</span>
          <strong>#{file.board.secMediaRank}</strong>
          <small>Preseason order</small>
        </div>
      </section>

      <section class="thesis">
        <p class="label">THE FILE IN ONE PARAGRAPH</p>
        <p>{file.thesis}</p>
      </section>

      <section class="chapter" id="alabama" aria-labelledby="alabama-title">
        <header class="chapter__head">
          <p class="label">PART I · THE PROGRAM</p>
          <h2 id="alabama-title">Alabama has to<br />become a verb again.</h2>
        </header>
        <div class="arguments">
          {file.alabama.map((item) => (
            <section>
              <span>{item.number}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </section>
          ))}
        </div>
      </section>

      <section class="quarterback" aria-labelledby="quarterback-title">
        <header>
          <p class="label">THE QUARTERBACK REFERENDUM</p>
          <h2 id="quarterback-title">{file.quarterback.question}</h2>
        </header>
        <div class="quarterback__grid">
          {file.quarterback.candidates.map((candidate, index) => (
            <article class={index === 0 ? 'index-even' : undefined}>
              <p class="candidate__label">{candidate.label}</p>
              <h3>{candidate.name}</h3>
              <p class="candidate__evidence">{candidate.evidence}</p>
              <dl>
                <div>
                  <dt>CASE</dt>
                  <dd>{candidate.case}</dd>
                </div>
                <div>
                  <dt>RISK</dt>
                  <dd>{candidate.risk}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section class="schedule" aria-labelledby="schedule-title">
        <header>
          <p class="label">THE FOUR-DATE SEASON</p>
          <h2 id="schedule-title">The schedule will not wait for the new identity.</h2>
        </header>
        <ol>
          {file.schedule.map((game) => (
            <li>
              <span class="schedule__date">{game.date}</span>
              <strong>{game.opponent}</strong>
              <div>
                <small>{game.label}</small>
                <p>{game.note}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="saban" id="saban" aria-labelledby="saban-title">
        <div class="saban__number" aria-hidden="true">7</div>
        <div class="saban__body">
          <p class="label">PART II · THE FORMER COACH</p>
          <h2 id="saban-title">The state<br />of Nick Saban.</h2>
          <p class="saban__headline">{file.saban.headline}</p>
          <div class="saban__notes">
            <article>
              <span>NOW</span>
              <p>{file.saban.current}</p>
            </article>
            <article>
              <span>ALABAMA</span>
              <p>{file.saban.transition}</p>
            </article>
            <article>
              <span>WASHINGTON</span>
              <p>{file.saban.policy}</p>
            </article>
            <article>
              <span>THE COUNTER-READ</span>
              <p>{file.saban.counter}</p>
            </article>
          </div>
          <blockquote>{file.saban.verdict}</blockquote>
        </div>
      </section>

      <section class="sec" id="sec" aria-labelledby="sec-title">
        <header class="sec__head">
          <div>
            <p class="label">PART III · A LIGHT SEC PRIMER</p>
            <h2 id="sec-title">Sixteen teams.<br />Four useful shelves.</h2>
          </div>
          <p>{file.secPrimer.intro}</p>
        </header>
        <ol class="sec__tiers">
          {file.secPrimer.tiers.map((tier, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <small>{tier.label}</small>
                <h3>{tier.teams}</h3>
                <p>{tier.note}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="sec__math">
          <div>
            <p class="label">ALABAMA’S CLEANEST MATH</p>
            <h3>Four games decide whether the argument is national or nostalgic.</h3>
          </div>
          <ol>
            {file.secPrimer.alabamaMath.map((line) => <li>{line}</li>)}
          </ol>
        </div>
      </section>

      <section class="verdict" aria-labelledby="verdict-title">
        <header>
          <p class="label">{file.pointcastVerdict.label}</p>
          <h2 id="verdict-title">The case.<br />The doubt.<br />The proof.</h2>
        </header>
        <div class="verdict__receipts">
          <article>
            <span>CASE</span>
            <p>{file.pointcastVerdict.case}</p>
          </article>
          <article>
            <span>DOUBT</span>
            <p>{file.pointcastVerdict.doubt}</p>
          </article>
          <article>
            <span>NEXT PROOF</span>
            <p>{file.pointcastVerdict.proof}</p>
          </article>
        </div>
        <p class="verdict__final">{file.pointcastVerdict.final}</p>
      </section>

      <section class="sources" aria-labelledby="sources-title">
        <header>
          <p class="label">THE RECEIPT BOOK</p>
          <h2 id="sources-title">Sources checked<br />July 28, 2026.</h2>
          <p>
            This is a preseason editorial, not a result. Facts are sourced;
            interpretations and thresholds are PointCast judgments.
          </p>
        </header>
        <ol>
          {file.sources.map((source, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <a href={source.url} target="_blank" rel="noopener">
                <strong>{source.label}</strong>
                <small>{source.publisher} ↗</small>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="footer">
      <div>
        <span>POINTCAST 25 · FIELD FILE 001</span>
        <strong>THE REASONS MOVE OR THE TEAM DOESN’T.</strong>
      </div>
      <nav aria-label="Article footer navigation">
        <a href="/25">Current 25</a>
        <a href="/25/teams/alabama">Alabama receipt</a>
        <a href="/25/alabama-after-saban.json">Machine edition</a>
        <a href="/b/0529">Block 0529</a>
      </nav>
    </footer>
  </article>
</BlockLayout>

<style>
  :global(html) {
    background: #f1ede3;
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #f1ede3;
    color: #12110f;
    font-family: var(--pc-font-sans);
    margin: 0;
  }

  .alabama-file {
    --crimson: #9e1b32;
    --dark-crimson: #5b0e1f;
    --ink: #12110f;
    --paper: #f1ede3;
    --signal: #f4ff3f;
    min-height: 100vh;
    overflow: hidden;
  }

  .mast,
  .mast nav,
  .footer,
  .footer nav {
    align-items: center;
    display: flex;
  }

  .mast {
    background: var(--ink);
    border-bottom: 1px solid #4b4944;
    color: white;
    justify-content: space-between;
    padding: 16px clamp(18px, 4vw, 64px);
  }

  .brand {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.05em;
  }

  .mast nav,
  .footer nav {
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 28px);
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .mast a,
  .footer a,
  .label,
  .eyebrow,
  .score-strip span,
  .score-strip small,
  .candidate__label,
  dt,
  .schedule small,
  .saban__notes span,
  .sec__tiers small,
  .verdict__receipts span,
  .sources small,
  .footer span {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    background:
      radial-gradient(circle at 82% 18%, rgba(158, 27, 50, 0.34), transparent 36%),
      var(--ink);
    color: white;
    display: grid;
    grid-template-columns: minmax(260px, 0.55fr) minmax(0, 1fr);
    min-height: min(880px, calc(100vh - 52px));
    position: relative;
  }

  .hero__mark {
    align-self: stretch;
    background: var(--crimson);
    color: var(--paper);
    display: flex;
    font-size: clamp(300px, 43vw, 760px);
    font-weight: 900;
    justify-content: center;
    letter-spacing: -0.15em;
    line-height: 0.78;
    overflow: hidden;
    padding-top: 72px;
    text-indent: -0.08em;
  }

  .hero__copy {
    align-self: end;
    padding: 70px clamp(22px, 5vw, 82px) 72px;
    position: relative;
  }

  .eyebrow,
  .label {
    font-weight: 800;
    margin: 0 0 18px;
  }

  .hero h1 {
    font-size: clamp(54px, 7.2vw, 118px);
    letter-spacing: -0.08em;
    line-height: 0.78;
    margin: 0;
    text-transform: uppercase;
  }

  .hero h1 em {
    color: #ff365c;
    font-style: normal;
  }

  .hero h1 span {
    color: var(--signal);
    display: inline-block;
    margin: 0.14em 0 0.05em;
  }

  .dek {
    color: #d7d3ca;
    font-size: clamp(20px, 2vw, 31px);
    letter-spacing: -0.035em;
    line-height: 1.38;
    margin: 38px 0 0;
    max-width: 820px;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .hero__links a {
    border: 1px solid #75726c;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 16px 18px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero__links a:first-child {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
    font-weight: 900;
  }

  .score-strip {
    background: var(--signal);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .score-strip > div {
    border-right: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    min-height: 132px;
    padding: 20px clamp(16px, 2vw, 30px);
  }

  .score-strip > div:last-child {
    border-right: 0;
  }

  .score-strip strong {
    font-size: clamp(42px, 5vw, 76px);
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .score-strip small {
    margin-top: auto;
  }

  .thesis {
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(150px, 0.28fr) 1fr;
    padding: clamp(64px, 9vw, 130px) clamp(18px, 6vw, 96px);
  }

  .thesis > p:last-child {
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 1.08;
    margin: 0;
    max-width: 1200px;
  }

  .chapter {
    border-bottom: 1px solid var(--ink);
    padding: clamp(72px, 10vw, 150px) clamp(18px, 6vw, 96px);
  }

  .chapter__head {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(150px, 0.28fr) 1fr;
    margin-bottom: 80px;
  }

  .chapter h2,
  .quarterback h2,
  .schedule h2,
  .saban h2,
  .sec h2,
  .verdict h2,
  .sources h2 {
    font-size: clamp(50px, 8vw, 126px);
    letter-spacing: -0.08em;
    line-height: 0.84;
    margin: 0;
  }

  .arguments {
    border-top: 1px solid var(--ink);
  }

  .arguments > section {
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 42px;
    grid-template-columns: 90px 1fr;
    padding: 34px 0;
  }

  .arguments > section > span {
    color: var(--crimson);
    font-size: 56px;
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .arguments h3 {
    font-size: clamp(28px, 4vw, 58px);
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 0 0 16px;
  }

  .arguments p {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(18px, 1.65vw, 25px);
    line-height: 1.58;
    margin: 0;
    max-width: 970px;
  }

  .quarterback {
    background: var(--crimson);
    color: white;
    padding: clamp(72px, 10vw, 150px) clamp(18px, 6vw, 96px);
  }

  .quarterback > header {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(180px, 0.33fr) 1fr;
    margin-bottom: 74px;
  }

  .quarterback__grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, 1fr);
  }

  .quarterback__grid > article {
    background: var(--dark-crimson);
    padding: clamp(28px, 4vw, 58px);
  }

  .quarterback__grid > article.index-even {
    background: #f1ede3;
    color: var(--ink);
  }

  .candidate__label {
    color: var(--signal);
  }

  .index-even .candidate__label {
    color: var(--crimson);
  }

  .quarterback h3 {
    font-size: clamp(44px, 6vw, 88px);
    letter-spacing: -0.075em;
    line-height: 0.9;
    margin: 18px 0 28px;
  }

  .candidate__evidence {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.6;
    min-height: 9em;
  }

  .quarterback dl,
  .quarterback dd {
    margin: 0;
  }

  .quarterback dl {
    border-top: 1px solid currentColor;
  }

  .quarterback dl > div {
    border-bottom: 1px solid currentColor;
    display: grid;
    gap: 22px;
    grid-template-columns: 70px 1fr;
    padding: 20px 0;
  }

  .quarterback dd {
    font-size: 16px;
    line-height: 1.5;
  }

  .schedule {
    border-bottom: 1px solid var(--ink);
    padding: clamp(72px, 10vw, 150px) clamp(18px, 6vw, 96px);
  }

  .schedule > header {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(180px, 0.33fr) 1fr;
    margin-bottom: 70px;
  }

  .schedule ol,
  .sec__tiers,
  .sources ol {
    border-top: 1px solid var(--ink);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .schedule li {
    align-items: start;
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 24px;
    grid-template-columns: 90px minmax(180px, 0.35fr) 1fr;
    padding: 28px 0;
  }

  .schedule__date {
    color: var(--crimson);
    font-family: var(--pc-font-mono);
    font-size: 13px;
    font-weight: 900;
  }

  .schedule strong {
    font-size: clamp(26px, 3.5vw, 50px);
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .schedule p {
    font-size: 16px;
    line-height: 1.55;
    margin: 7px 0 0;
  }

  .saban {
    background: var(--ink);
    color: white;
    display: grid;
    grid-template-columns: minmax(240px, 0.38fr) 1fr;
  }

  .saban__number {
    align-items: start;
    background: var(--signal);
    color: var(--ink);
    display: flex;
    font-size: clamp(300px, 43vw, 690px);
    font-weight: 900;
    justify-content: center;
    letter-spacing: -0.12em;
    line-height: 0.78;
    overflow: hidden;
    padding-top: 70px;
  }

  .saban__body {
    padding: clamp(72px, 10vw, 150px) clamp(22px, 6vw, 96px);
  }

  .saban h2 {
    color: var(--signal);
  }

  .saban__headline {
    color: #d7d3ca;
    font-size: clamp(23px, 3vw, 42px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.2;
    margin: 42px 0 62px;
    max-width: 920px;
  }

  .saban__notes {
    border-top: 1px solid #57544e;
  }

  .saban__notes article {
    border-bottom: 1px solid #57544e;
    display: grid;
    gap: 24px;
    grid-template-columns: 140px 1fr;
    padding: 26px 0;
  }

  .saban__notes span {
    color: var(--signal);
  }

  .saban__notes p {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(17px, 1.5vw, 23px);
    line-height: 1.6;
    margin: 0;
    max-width: 900px;
  }

  .saban blockquote {
    border-left: 8px solid var(--crimson);
    font-size: clamp(25px, 3.6vw, 54px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.18;
    margin: 70px 0 0;
    padding-left: 28px;
  }

  .sec {
    border-bottom: 1px solid var(--ink);
    padding: clamp(72px, 10vw, 150px) clamp(18px, 6vw, 96px);
  }

  .sec__head {
    align-items: end;
    display: grid;
    gap: 70px;
    grid-template-columns: 1fr 0.55fr;
    margin-bottom: 80px;
  }

  .sec__head > p {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(18px, 1.8vw, 27px);
    line-height: 1.55;
    margin: 0;
  }

  .sec__tiers li {
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 34px;
    grid-template-columns: 80px 1fr;
    padding: 28px 0;
  }

  .sec__tiers > li > span {
    color: var(--crimson);
    font-size: 45px;
    font-weight: 900;
    letter-spacing: -0.07em;
  }

  .sec__tiers h3 {
    font-size: clamp(28px, 4vw, 58px);
    letter-spacing: -0.055em;
    line-height: 1;
    margin: 8px 0 14px;
  }

  .sec__tiers p {
    font-size: 17px;
    line-height: 1.55;
    margin: 0;
    max-width: 960px;
  }

  .sec__math {
    background: var(--signal);
    display: grid;
    gap: 60px;
    grid-template-columns: 0.75fr 1fr;
    margin-top: 80px;
    padding: clamp(30px, 5vw, 68px);
  }

  .sec__math h3 {
    font-size: clamp(30px, 4.2vw, 58px);
    letter-spacing: -0.06em;
    line-height: 1;
    margin: 0;
  }

  .sec__math ol {
    border-top: 1px solid var(--ink);
    margin: 0;
    padding: 0;
  }

  .sec__math li {
    border-bottom: 1px solid var(--ink);
    font-size: 17px;
    line-height: 1.5;
    list-style-position: inside;
    padding: 20px 0;
