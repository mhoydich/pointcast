---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import {
  FAN_CLIQUE_RALLY,
  FAN_CLIQUE_RALLY_TEAMS,
} from '../../../lib/pointcast-fan-clique-rally';

const rally = FAN_CLIQUE_RALLY;
const conferences = Array.from(
  new Set(FAN_CLIQUE_RALLY_TEAMS.map((team) => team.conference)),
);
const challengeXUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  rally.challengeCopy,
)}`;
const sharePayload = {
  challenge: rally.challengeCopy,
  teams: Object.fromEntries(
    FAN_CLIQUE_RALLY_TEAMS.map((team) => [
      team.slug,
      {
        rally: team.rallyCopy,
        group: team.groupCopy,
      },
    ]),
  ),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: rally.subtitle,
      headline: rally.title,
      description: rally.dek,
      url: rally.canonical,
      image: rally.socialImage,
      datePublished: rally.publishedAt,
      isAccessibleForFree: true,
      publisher: { '@type': 'Organization', name: 'PointCast' },
    },
    {
      '@type': 'ItemList',
      name: 'Fan Clique school rally links',
      numberOfItems: FAN_CLIQUE_RALLY_TEAMS.length,
      itemListElement: FAN_CLIQUE_RALLY_TEAMS.map((team, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: team.school,
        url: team.gameUrl,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${rally.subtitle} — ${rally.title}`}
  description={rally.dek}
  image={rally.socialImage}
  themeColor="#d8ff3e"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: '/25/fan-clique/rally.json',
      title: 'Fan Clique Rally Kit data and school links',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="rally">
    <header class="mast">
      <a class="mast__brand" href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · RALLY KIT 001</span>
      <nav aria-label="Rally Kit navigation">
        <a href="/25/fan-clique">LIVE GAME</a>
        <a href="#school-desk">SCHOOL DESK</a>
        <a href="/25/fan-clique/rally.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="rally-title">
      <img
        src={rally.assets[0].src}
        alt="An empty fictional football stadium charged with flying paper tickets, orange pennants, and one acid-lime signal light"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__veil"></div>
      <div class="hero__copy">
        <p>FAN CLIQUE / RALLY KIT 001 / THE ROOM IS OPEN</p>
        <h1 id="rally-title">
          MAKE YOUR SCHOOL
          <em>IMPOSSIBLE TO IGNORE.</em>
        </h1>
        <div class="hero__lower">
          <p>{rally.dek}</p>
          <div>
            <a href="#school-desk">FIND MY SCHOOL ↓</a>
            <a class="button--ghost" href="/25/fan-clique">OPEN THE LIVE BOARD ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pulse" aria-label="Live Fan Clique campaign pulse">
      <div class="pulse__live">
        <i data-live-light></i>
        <span data-live-label>CALLING THE LIVE BOARD</span>
      </div>
      <div>
        <small>PEOPLE IN THE ROOM</small>
        <strong data-total>0</strong>
      </div>
      <div>
        <small>CURRENTLY LOUDEST</small>
        <strong data-leader>FIRST CLICK TAKES IT</strong>
      </div>
      <div class="pulse__hundred">
        <span><small>FIRST ROOM</small><b data-progress-label>0 / 100</b></span>
        <div><i data-progress></i></div>
      </div>
    </section>

    <section class="ladder" aria-labelledby="ladder-title">
      <header>
        <p>THE LAUNCH LADDER</p>
        <h2 id="ladder-title">DON’T “GO VIRAL.”<br /><em>OPEN A ROOM.</em></h2>
      </header>
      <ol>
        {rally.launchLadder.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <small>{step.threshold} ACCEPTED {step.threshold === 1 ? 'CLICK' : 'CLICKS'}</small>
            <strong>{step.label}</strong>
            <p>{step.instruction}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="rush" aria-labelledby="rush-title">
      <figure>
        <img
          src={rally.assets[1].src}
          alt="Five colorful abstract campus crowds converging on one shared fictional stadium"
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>PLATE 02 / CONFERENCE RUSH / ORIGINAL POINTCAST CAMPAIGN ART</figcaption>
      </figure>
      <div class="rush__copy">
        <p>THE OPENING PLAY</p>
        <h2 id="rush-title">FIVE RELAYS.<br />ONE FIELD.</h2>
        <div class="relay-list">
          <span>01</span><p><strong>Student group chat.</strong> The fastest ten people who already care.</p>
          <span>02</span><p><strong>School-specific social.</strong> One public call with the exact team link.</p>
          <span>03</span><p><strong>Local Saturday place.</strong> Diner, barbershop, radio desk, tailgate, watch party.</p>
          <span>04</span><p><strong>Alumni relay.</strong> One chapter sends the call to another city.</p>
          <span>05</span><p><strong>Rivalry reply.</strong> Tag one opposing crowd only after yours is on the board.</p>
        </div>
      </div>
    </section>

    <section class="school-desk" id="school-desk" aria-labelledby="school-desk-title">
      <header>
        <div>
          <p>THE SCHOOL DESK / {FAN_CLIQUE_RALLY_TEAMS.length} CALLS READY</p>
          <h2 id="school-desk-title">PICK YOUR PEOPLE.<br /><em>PASS THE TICKET.</em></h2>
        </div>
        <label>
          <span>FIND A SCHOOL OR CITY</span>
          <input
            type="search"
            placeholder="Michigan State, Tempe, Rutgers…"
            autocomplete="off"
            data-school-search
          />
        </label>
      </header>

      <div class="filters" aria-label="Filter rally cards by conference">
        <button type="button" data-conference="all" aria-pressed="true">
          ALL {FAN_CLIQUE_RALLY_TEAMS.length}
        </button>
        {conferences.map((conference) => (
          <button type="button" data-conference={conference} aria-pressed="false">
            {conference}
          </button>
        ))}
      </div>

      <p class="desk-status" data-desk-status role="status" aria-live="polite">
        Every school starts with the same tool: a direct link and a sentence worth passing.
      </p>

      <div class="team-grid">
        {FAN_CLIQUE_RALLY_TEAMS.map((team) => {
          const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(team.rallyCopy)}`;
          return (
            <article
              class="team-card"
              style={`--team:${team.primary};--team-two:${team.secondary};--team-paper:${team.paper}`}
              data-team-card
              data-school={`${team.school} ${team.short}`.toLowerCase()}
              data-city={`${team.city} ${team.state}`.toLowerCase()}
              data-conference={team.conference}
            >
              <header>
                <span>{team.fieldNumber}</span>
                <small>{team.conference} · {team.city}</small>
                <b data-team-count={team.slug}>0</b>
              </header>
              <div class="team-card__identity">
                <svg viewBox="0 0 100 100" aria-hidden="true">
                  {team.markPaths.map((path) => <path d={path}></path>)}
                </svg>
                <div>
                  <strong>{team.school}</strong>
                  <p>“{team.school} people: the room is open. One browser, one click. Bring the crowd.”</p>
                </div>
              </div>
              <div class="team-card__actions">
                <a href={team.gameUrl}>OPEN TEAM ↗</a>
                <button type="button" data-copy-key={`${team.slug}:rally`}>COPY RALLY CALL</button>
                <a href={xUrl} target="_blank" rel="noreferrer">OPEN X DRAFT ↗</a>
                <button type="button" data-copy-key={`${team.slug}:group`}>COPY GROUP CHAT</button>
              </div>
            </article>
          );
        })}
      </div>
      <p class="no-results" data-no-results hidden>
        No school matched. Clear the search and reopen the whole field.
      </p>
    </section>

    <section class="media-call" aria-labelledby="media-call-title">
      <p class="media-call__kicker">THE PUBLIC INVITATION / NO BACK CHANNEL REQUIRED</p>
      <div class="media-call__title">
        <span>BARSTOOL,</span>
        <h2 id="media-call-title">PICK A<br /><em>SCHOOL.</em></h2>
      </div>
      <div class="media-call__body">
        <p>
          Choose any one of the thirty-five programs. Send its exact link into
          the room. Call one rival. Then let the public board—not a studio
          graphic—show which crowd actually arrives.
        </p>
        <blockquote>
          “WHICH SCHOOL OWNS THE ROOM WHEN THE INVITATION IS THE SAME?”
        </blockquote>
        <div class="media-call__actions">
          <a href={challengeXUrl} target="_blank" rel="noreferrer">
            OPEN THE PUBLIC X DRAFT ↗
          </a>
          <button type="button" data-copy-key="challenge">COPY THE CHALLENGE</button>
        </div>
        <div class="media-call__targets">
          {rally.mediaTargets.map((target) => (
            <a href={target.href} target="_blank" rel="noreferrer">
              <small>OPEN INVITATION TO</small>
              <strong>{target.name}</strong>
              <span>{target.role}</span>
            </a>
          ))}
        </div>
        <p class="media-call__note">
          No logo swap, no implied partnership, no private upload. The public
          URL is the artifact. {rally.boundary}
        </p>
      </div>
    </section>

    <section class="relay" aria-labelledby="relay-title">
      <figure>
        <img
          src={rally.assets[2].src}
          alt="A collage of students, families, neighborhood places, alumni, and stadium crowds passing a bright paper ticket"
          width="1536"
          height="1024"
          loading="lazy"
        />
      </figure>
      <div>
        <p>PLATE 03 / SEND IN YOUR PEOPLE</p>
        <h2 id="relay-title">THE LINK SHOULD<br />TRAVEL LIKE A TICKET.</h2>
        <p>
          Campus to town. Town to family. Family to alumni. Alumni back to the
          gate. The campaign gets interesting when the click carries a local
          path—not when the same account posts five times.
        </p>
        <a href="#school-desk">TAKE A SCHOOL-SPECIFIC CALL ↑</a>
      </div>
    </section>

    <footer>
      <div>
        <span>POINTCAST · COLLEGE FOOTBALL · RALLY KIT 001</span>
        <span data-footer-live>THE ROOM IS OPEN</span>
      </div>
      <p>YOUR PEOPLE<br /><em>WERE HERE.</em></p>
      <nav aria-label="Rally Kit related pages">
        <a href="/25/fan-clique">LIVE FAN CLIQUE</a>
        <a href="/25/magazine">THE MAGAZINE</a>
        <a href="/25">25 FOR REASONS</a>
        <a href="/25/fan-clique/rally.json">CAMPAIGN JSON</a>
      </nav>
      <small>{rally.boundary}</small>
    </footer>
  </main>

  <script
    type="application/json"
    id="fan-clique-rally-copy"
    set:html={JSON.stringify(sharePayload)}
  ></script>

  <script is:inline>
    (() => {
      const payload = JSON.parse(
        document.getElementById('fan-clique-rally-copy')?.textContent || '{}',
      );
      const cards = Array.from(document.querySelectorAll('[data-team-card]'));
      const search = document.querySelector('[data-school-search]');
      const noResults = document.querySelector('[data-no-results]');
      const deskStatus = document.querySelector('[data-desk-status]');
      const total = document.querySelector('[data-total]');
      const leader = document.querySelector('[data-leader]');
      const liveLight = document.querySelector('[data-live-light]');
      const liveLabel = document.querySelector('[data-live-label]');
      const progress = document.querySelector('[data-progress]');
      const progressLabel = document.querySelector('[data-progress-label]');
      const footerLive = document.querySelector('[data-footer-live]');
      let activeConference = 'all';

      const copyText = async (text) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        area.remove();
      };

      document.querySelectorAll('[data-copy-key]').forEach((button) => {
        button.addEventListener('click', async () => {
          const [slug, kind] = String(button.dataset.copyKey).split(':');
          const text =
            slug === 'challenge'
              ? payload.challenge
              : payload.teams?.[slug]?.[kind];
          if (!text) return;
          try {
            await copyText(text);
            const original = button.textContent;
            button.textContent = 'COPIED ✓';
            setTimeout(() => {
              button.textContent = original;
            }, 1800);
          } catch {
            deskStatus.textContent =
              'Copy was blocked by this browser. Open the X draft or select the call manually.';
          }
        });
      });

      const applyFilters = () => {
        const term = String(search?.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const conferenceMatch =
            activeConference === 'all' ||
            card.dataset.conference === activeConference;
          const searchMatch =
            !term ||
            card.dataset.school.includes(term) ||
            card.dataset.city.includes(term);
          const show = conferenceMatch && searchMatch;
          card.hidden = !show;
          if (show) visible += 1;
        });
        noResults.hidden = visible > 0;
        deskStatus.textContent = visible
          ? `${visible} school ${visible === 1 ? 'call is' : 'calls are'} ready to travel.`
          : 'No school matched that search.';
      };

      document.querySelectorAll('[data-conference]').forEach((button) => {
        button.addEventListener('click', () => {
          activeConference = button.dataset.conference;
          document.querySelectorAll('[data-conference]').forEach((peer) => {
            peer.setAttribute('aria-pressed', String(peer === button));
          });
          applyFilters();
        });
      });
      search?.addEventListener('input', applyFilters);

      const refresh = async () => {
        try {
          const response = await fetch('/api/fan-clique', {
            headers: { Accept: 'application/json' },
            cache: 'no-store',
          });
          if (!response.ok) throw new Error(`Standings returned ${response.status}`);
          const data = await response.json();
          const standings = Array.isArray(data.standings) ? data.standings : [];
          const totalCount = standings.reduce(
            (sum, entry) => sum + (Number(entry.count) || 0),
            0,
          );
          const loudest = standings
            .filter((entry) => Number(entry.count) > 0)
            .sort(
              (a, b) =>
                Number(b.count) - Number(a.count) ||
                Number(a.fieldNumber) - Number(b.fieldNumber),
            )[0];

          total.textContent = totalCount.toLocaleString();
          leader.textContent = loudest
            ? `${loudest.school} · ${Number(loudest.count).toLocaleString()}`
            : 'FIRST CLICK TAKES IT';
          liveLight.classList.toggle('is-live', Boolean(data.live));
          liveLabel.textContent = data.live ? 'LIVE BOARD' : 'STORE OFFLINE';
          footerLive.textContent = data.live
            ? `${totalCount.toLocaleString()} PEOPLE IN THE ROOM`
            : 'THE ROOM IS RECONNECTING';
          const firstRoom = Math.min(100, totalCount);
          progress.style.width = `${firstRoom}%`;
          progressLabel.textContent = `${firstRoom} / 100`;

          standings.forEach((entry) => {
            const target = document.querySelector(
              `[data-team-count="${entry.slug}"]`,
            );
            if (target) {
              target.textContent = Number(entry.count).toLocaleString();
              target.title = `${Number(entry.count).toLocaleString()} accepted clicks`;
            }
          });
        } catch {
          liveLabel.textContent = 'BOARD RECONNECTING';
          footerLive.textContent = 'THE ROOM IS RECONNECTING';
        }
      };

      refresh();
      window.setInterval(() => {
        if (document.visibilityState === 'visible') refresh();
      }, 30000);
    })();
  </script>
</BlockLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #111713; }

  .rally {
    --ink: #111713;
    --paper: #f3eddb;
    --signal: #d8ff3e;
    --orange: #ff5b35;
    --blue: #243eff;
    --oxblood: #7c1c2c;
    min-height: 100vh;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--pc-font-sans);
  }
  .mast {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 64px;
    padding: 0 clamp(1rem, 4vw, 4rem);
    border-bottom: 2px solid var(--ink);
    background: var(--signal);
    font-size: 0.62rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mast a { color: inherit; text-decoration: none; }
  .mast__brand { font-size: 0.78rem; }
  .mast nav { display: flex; justify-content: flex-end; gap: 1.1rem; }
  .mast nav a:hover,
  .mast nav a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }

  .hero {
    position: relative;
    min-height: min(900px, calc(100vh - 64px));
    color: var(--paper);
    background: var(--ink);
    isolation: isolate;
  }
  .hero > img,
  .hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero > img { object-fit: cover; }
  .hero__veil {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(17, 23, 19, 0.96) 0%, rgba(17, 23, 19, 0.84) 46%, rgba(17, 23, 19, 0.08) 78%),
      linear-gradient(0deg, rgba(17, 23, 19, 0.88), transparent 48%);
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    box-sizing: border-box;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 5rem);
  }
  .hero__copy > p {
    margin: 0;
    color: var(--signal);
    font-size: 0.66rem;
    font-weight: 950;
    letter-spacing: 0.1em;
  }
  .hero h1 {
    max-width: 960px;
    margin: 4rem 0;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(5.6rem, 12.5vw, 12rem);
    letter-spacing: -0.06em;
    line-height: 0.78;
    text-transform: uppercase;
  }
  .hero h1 em { display: block; color: var(--signal); font-style: normal; }
  .hero__lower {
    display: grid;
    grid-template-columns: minmax(280px, 680px) auto;
    gap: 2rem;
    align-items: end;
  }
  .hero__lower > p {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 2rem);
    font-weight: 760;
    line-height: 1.22;
  }
  .hero__lower > div { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: flex-end; }
  .hero__lower a,
  .relay a {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    padding: 0 1rem;
    border: 2px solid var(--signal);
    color: var(--ink);
    background: var(--signal);
    font-size: 0.62rem;
    font-weight: 950;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero__lower .button--ghost { color: var(--paper); background: rgba(17, 23, 19, 0.72); }

  .pulse {
    display: grid;
    grid-template-columns: 0.58fr 0.42fr minmax(280px, 1fr) minmax(240px, 0.7fr);
    border-block: 2px solid var(--ink);
    background: var(--orange);
  }
  .pulse > div {
    display: flex;
    min-height: 112px;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    border-right: 2px solid var(--ink);
  }
  .pulse > div:last-child { border-right: 0; }
  .pulse small,
  .pulse__live span {
    font-size: 0.59rem;
    font-weight: 950;
    letter-spacing: 0.08em;
  }
  .pulse strong { font-family: Impact, sans-serif; font-size: clamp(2rem, 5vw, 4.6rem); line-height: 0.9; text-transform: uppercase; }
  .pulse__live { flex-direction: row !important; align-items: center; justify-content: flex-start !important; gap: 0.7rem; background: var(--signal); }
  .pulse__live i {
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .pulse__live i.is-live { background: var(--blue); box-shadow: 0 0 0 6px rgba(36, 62, 255, 0.18); }
  .pulse__hundred span { display: flex; justify-content: space-between; }
  .pulse__hundred b { font-size: 0.7rem; }
  .pulse__hundred > div { height: 18px; border: 2px solid var(--ink); background: var(--paper); }
  .pulse__hundred i { display: block; width: 0; height: 100%; background: var(--blue); transition: width 450ms ease; }

  .ladder {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(5rem, 9vw, 9rem) clamp(1rem, 5vw, 5rem);
  }
  .ladder header > p,
  .rush__copy > p,
  .school-desk header > div > p,
  .relay > div > p:first-child,
  .media-call__kicker {
    margin: 0 0 1.3rem;
    color: var(--blue);
    font-size: 0.62rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ladder h2,
  .rush h2,
  .school-desk h2,
  .relay h2 {
    margin: 0;
    font-family: Impact, sans-serif;
    font-size: clamp(4.4rem, 8.8vw, 9rem);
    letter-spacing: -0.055em;
    line-height: 0.8;
    text-transform: uppercase;
  }
  .ladder h2 em,
  .school-desk h2 em { color: var(--blue); font-style: normal; }
  .ladder ol { margin: 0; padding: 0; border: 2px solid var(--ink); list-style: none; }
  .ladder li {
    display: grid;
    grid-template-columns: 60px 0.55fr 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 130px;
    padding: 1rem;
    border-bottom: 2px solid var(--ink);
  }
  .ladder li:last-child { border-bottom: 0; color: var(--paper); background: var(--blue); }
  .ladder li > span { font-family: Impact, sans-serif; font-size: 2.8rem; }
  .ladder li small { font-size: 0.56rem; font-weight: 950; }
  .ladder li strong { font-family: Impact, sans-serif; font-size: clamp(2rem, 4vw, 4rem); line-height: 0.9; }
  .ladder li p { grid-column: 2 / -1; margin: -0.45rem 0 0; font-size: 0.82rem; font-weight: 750; }

  .rush {
    display: grid;
