---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Metronome — tempo, subdivision, polyrhythm, tap" description="A proper musician's metronome. Tempo 40-220, time signatures, subdivisions, tap-to-set, polyrhythm mode. Keep time without the app store.">
  <main class="cm" id="cm" data-built={built}>
    <header class="cm__hero">
      <p class="cm__kicker">CAST · METRONOME · tempo · subdivision · polyrhythm</p>
      <h1 class="cm__title">Click.</h1>
      <p class="cm__sub">A proper metronome. Tempo, time signature, subdivision, tap-to-set, polyrhythm. Keep time without the app store.</p>
    </header>

    <section class="cm__stage" id="cm-stage" data-state="idle">
      <div class="cm__pulse">
        <div class="cm__pulse-noun"><img id="cm-noun" src="https://noun.pics/287.svg" alt="A Noun, counting"/></div>
      </div>
      <div class="cm__beat-row" id="cm-beat-row"></div>
      <div class="cm__bpm-readout">
        <span class="cm__bpm-readout-val" id="cm-bpm-readout">96</span>
        <span class="cm__bpm-readout-unit">BPM</span>
      </div>
    </section>

    <section class="cm__transport">
      <button class="cm__play" id="cm-play" type="button" aria-label="Start / stop">
        <span id="cm-play-icon">▶</span>
      </button>
      <button class="cm__tap" id="cm-tap" type="button" title="Tap to set tempo">
        <span class="cm__tap-icon">●</span>
        <span class="cm__tap-label" id="cm-tap-label">TAP</span>
      </button>
      <div class="cm__vol-wrap">
        <button class="cm__vol-btn" id="cm-mute" type="button" aria-label="Mute">♪</button>
        <input type="range" class="cm__vol-slider" id="cm-vol" min="0" max="100" value="55"/>
      </div>
    </section>

    <section class="cm__controls">
      <div class="cm__ctl">
        <label class="cm__ctl-label" for="cm-bpm">TEMPO</label>
        <input type="range" class="cm__ctl-slider" id="cm-bpm" min="40" max="220" step="1" value="96"/>
        <div class="cm__ctl-presets">
          <button data-bpm="60" type="button">60</button>
          <button data-bpm="80" type="button">80</button>
          <button data-bpm="96" type="button">96</button>
          <button data-bpm="120" type="button">120</button>
          <button data-bpm="160" type="button">160</button>
        </div>
      </div>

      <div class="cm__ctl">
        <label class="cm__ctl-label" for="cm-meter">METER</label>
        <div class="cm__pill-row" id="cm-meter-row">
          <button class="cm__pill cm__pill--active" data-meter="4">4/4</button>
          <button class="cm__pill" data-meter="3">3/4</button>
          <button class="cm__pill" data-meter="6">6/8</button>
          <button class="cm__pill" data-meter="5">5/4</button>
          <button class="cm__pill" data-meter="7">7/8</button>
        </div>
      </div>

      <div class="cm__ctl">
        <label class="cm__ctl-label" for="cm-sub">SUBDIVISION</label>
        <div class="cm__pill-row" id="cm-sub-row">
          <button class="cm__pill cm__pill--active" data-sub="1">quarter</button>
          <button class="cm__pill" data-sub="2">8ths</button>
          <button class="cm__pill" data-sub="3">triplets</button>
          <button class="cm__pill" data-sub="4">16ths</button>
        </div>
      </div>

      <div class="cm__ctl">
        <label class="cm__ctl-label">POLYRHYTHM</label>
        <div class="cm__pill-row" id="cm-poly-row">
          <button class="cm__pill cm__pill--active" data-poly="0">off</button>
          <button class="cm__pill" data-poly="2">2 over 3</button>
          <button class="cm__pill" data-poly="3">3 over 4</button>
          <button class="cm__pill" data-poly="4">4 over 5</button>
        </div>
        <p class="cm__poly-hint" id="cm-poly-hint">Off · just the primary click track.</p>
      </div>
    </section>

    <section class="cm__tips">
      <h2 class="cm__tips-title">Practice patterns</h2>
      <ul class="cm__tips-list">
        <li><strong>Tap to set tempo</strong> — hit TAP four times to lock the metronome to your tapping speed.</li>
        <li><strong>Subdivision</strong> drops higher-frequency clicks between the downbeats so you can feel the inner pulse. Useful for rhythmic accuracy.</li>
        <li><strong>Polyrhythm</strong> overlays a second click track at a different ratio. "2 over 3" plays 2 even clicks against 3 even clicks in the same time. Hard at first.</li>
        <li><strong>Spacebar</strong> = start/stop · <strong>T</strong> = tap · <strong>↑/↓</strong> = ±1 BPM · <strong>←/→</strong> = ±5 BPM.</li>
      </ul>
    </section>

    <footer class="cm__foot">
      <p>Built {built.slice(0,10)} · pure Web Audio · no app, no install</p>
      <p>← <a href="/drum-school">/drum-school</a> · <a href="/cast-loop">/cast-loop</a> · <a href="/town-music">/town-music</a> · <a href="/">PointCast home</a></p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cm-bg: #0a0610;
    --cm-walnut: #5a3422;
    --cm-flame: #f6c15e;
    --cm-cream: #f4e7c8;
    --cm-velvet: #1a0820;
    --cm-line: rgba(244,231,200,0.10);
    --cm-text: #f4e7c8;
    --cm-text-mute: rgba(244,231,200,0.62);
    --cm-text-quiet: rgba(244,231,200,0.38);
    --cm-good: #a8ff3a;
    --cm-bad: #ff5f7a;
    --cm-display: 'Inter Tight', system-ui, sans-serif;
    --cm-body: 'Inter', system-ui, sans-serif;
    --cm-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  body { background: var(--cm-bg); color: var(--cm-text); font-family: var(--cm-body); }

  .cm { max-width: 760px; margin: 0 auto; padding: 36px 22px 60px 22px;
        display: flex; flex-direction: column; gap: 28px; }

  /* HERO */
  .cm__kicker { font-family: var(--cm-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--cm-flame); text-transform: uppercase; margin: 0 0 10px 0; }
  .cm__title { font-family: var(--cm-display); font-weight: 900; font-size: clamp(48px, 9vw, 80px); line-height: 0.94; letter-spacing: -0.025em; margin: 0 0 12px 0;
    background: linear-gradient(180deg, var(--cm-cream), var(--cm-flame));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .cm__sub { font-family: var(--cm-body); font-size: 14.5px; line-height: 1.55; color: var(--cm-text-mute); max-width: 560px; margin: 0; }

  /* STAGE */
  .cm__stage {
    padding: 28px 24px; background: linear-gradient(180deg, rgba(244,231,200,0.05), rgba(244,231,200,0.02));
    border: 1px solid var(--cm-line); border-radius: 16px;
    display: flex; flex-direction: column; align-items: center; gap: 22px;
  }
  .cm__pulse { position: relative; width: 110px; height: 110px; }
  .cm__pulse-noun {
    position: absolute; inset: 0; border-radius: 50%;
    background: linear-gradient(135deg, var(--cm-walnut), var(--cm-velvet));
    display: grid; place-items: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.4s ease;
  }
  .cm__pulse-noun img { width: 80%; image-rendering: pixelated; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.4)); }
  .cm__stage[data-state="playing"] .cm__pulse-noun {
    animation: cm-pulse var(--beat-sec, 0.625s) ease-in-out infinite;
  }
  .cm__stage[data-state="playing"][data-downbeat="1"] .cm__pulse-noun {
    background: linear-gradient(135deg, var(--cm-flame), var(--cm-walnut));
  }
  @keyframes cm-pulse {
    0% { transform: scale(1); }
    8% { transform: scale(1.10); }
    100% { transform: scale(1); }
  }

  .cm__beat-row { display: flex; gap: 8px; min-height: 14px; }
  .cm__beat {
    width: 14px; height: 14px; border-radius: 50%;
    background: rgba(244,231,200,0.10);
    transition: background 0.06s ease, transform 0.06s ease;
  }
  .cm__beat--cur { background: var(--cm-cream); transform: scale(1.25); }
  .cm__beat--down { outline: 2px solid var(--cm-flame); outline-offset: 1px; }
  .cm__beat--cur.cm__beat--down { background: var(--cm-flame); }

  .cm__bpm-readout {
    display: flex; align-items: baseline; gap: 6px;
    font-family: var(--cm-display); color: var(--cm-text);
  }
  .cm__bpm-readout-val { font-weight: 900; font-size: 72px; letter-spacing: -0.03em; line-height: 1; }
  .cm__bpm-readout-unit { font-family: var(--cm-mono); font-size: 13px; color: var(--cm-text-mute); letter-spacing: 0.4px; }

  /* TRANSPORT */
  .cm__transport {
    display: grid; grid-template-columns: auto auto 1fr; gap: 14px; align-items: center;
    padding: 14px 18px; background: rgba(244,231,200,0.04); border: 1px solid var(--cm-line); border-radius: 12px;
  }
  @media (max-width: 560px) { .cm__transport { grid-template-columns: 1fr 1fr; } .cm__vol-wrap { grid-column: 1 / -1; justify-content: center; } }
  .cm__play {
    width: 56px; height: 56px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, var(--cm-flame) 0%, var(--cm-walnut) 75%, var(--cm-velvet) 100%);
    border: 2px solid rgba(244,231,200,0.18);
    color: var(--cm-velvet); font-size: 22px; font-weight: 800; padding-left: 3px;
    cursor: pointer; display: grid; place-items: center;
    transition: transform 0.15s ease;
    box-shadow: 0 6px 16px rgba(0,0,0,0.4);
  }
  .cm__play:hover { transform: scale(1.05); }
  .cm__play:focus-visible { outline: 3px solid var(--cm-flame); outline-offset: 4px; }
  .cm__play--on #cm-play-icon { padding-left: 0; }

  .cm__tap {
    display: flex; align-items: center; gap: 8px;
    background: rgba(244,231,200,0.04); border: 2px dashed rgba(244,231,200,0.30);
    color: var(--cm-text); font-family: var(--cm-mono); font-size: 11px;
    letter-spacing: 0.5px; padding: 12px 18px; border-radius: 12px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.06s ease;
  }
  .cm__tap:hover { background: rgba(244,231,200,0.10); border-color: var(--cm-flame); }
  .cm__tap:active, .cm__tap--press { transform: scale(0.97); background: rgba(246,193,94,0.16); border-color: var(--cm-flame); border-style: solid; }
  .cm__tap-icon { color: var(--cm-flame); font-size: 14px; transition: color 0.1s ease; }

  .cm__vol-wrap { display: flex; align-items: center; gap: 10px; justify-self: end; }
  .cm__vol-btn { background: transparent; border: 0; font-size: 18px; color: var(--cm-text-mute); cursor: pointer; padding: 4px 8px; transition: color 0.18s ease; }
  .cm__vol-btn:hover { color: var(--cm-text); }
  .cm__vol-btn--muted { color: var(--cm-bad); text-decoration: line-through; }
  .cm__vol-slider { width: 100px; -webkit-appearance: none; appearance: none; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer; }
  .cm__vol-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--cm-flame); cursor: pointer; }
  .cm__vol-slider:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--cm-flame); outline-offset: 3px; }

  /* CONTROLS */
  .cm__controls {
    display: flex; flex-direction: column; gap: 22px;
    padding: 20px 22px; background: rgba(244,231,200,0.03); border: 1px solid var(--cm-line); border-radius: 12px;
  }
  .cm__ctl { display: flex; flex-direction: column; gap: 10px; }
  .cm__ctl-label { font-family: var(--cm-mono); font-size: 10px; letter-spacing: 0.7px; color: var(--cm-text-quiet); text-transform: uppercase; }
  .cm__ctl-slider {
    -webkit-appearance: none; appearance: none; width: 100%; height: 4px;
    background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer;
  }
  .cm__ctl-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--cm-flame); cursor: pointer; }
  .cm__ctl-slider:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--cm-flame); outline-offset: 3px; }
  .cm__ctl-presets { display: flex; gap: 6px; flex-wrap: wrap; }
  .cm__ctl-presets button {
    background: rgba(244,231,200,0.04); color: var(--cm-text-mute);
    border: 1px solid var(--cm-line); border-radius: 999px;
    padding: 4px 12px; font-family: var(--cm-mono); font-size: 11px; cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cm__ctl-presets button:hover { background: rgba(244,231,200,0.10); color: var(--cm-text); border-color: var(--cm-flame); }

  .cm__pill-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .cm__pill {
    background: rgba(244,231,200,0.04); color: var(--cm-text-mute);
    border: 1px solid var(--cm-line); border-radius: 8px;
    padding: 6px 12px; font-family: var(--cm-mono); font-size: 11px; cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cm__pill:hover { background: rgba(244,231,200,0.10); color: var(--cm-text); }
  .cm__pill--active { background: rgba(246,193,94,0.16); color: var(--cm-flame); border-color: var(--cm-flame); }
  .cm__poly-hint { font-family: var(--cm-mono); font-size: 10.5px; color: var(--cm-text-quiet); margin: 0; letter-spacing: 0.3px; }

  /* TIPS */
  .cm__tips { padding: 22px; background: rgba(244,231,200,0.03); border: 1px solid var(--cm-line); border-radius: 12px; }
  .cm__tips-title { font-family: var(--cm-display); font-weight: 700; font-size: 18px; margin: 0 0 12px 0; letter-spacing: -0.01em; }
  .cm__tips-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .cm__tips-list li { font-family: var(--cm-body); font-size: 13.5px; line-height: 1.5; color: var(--cm-text-mute); }
  .cm__tips-list strong { color: var(--cm-flame); font-weight: 600; }

  /* FOOT */
  .cm__foot {
    padding-top: 24px; border-top: 1px solid var(--cm-line);
    font-family: var(--cm-mono); font-size: 11px; color: var(--cm-text-quiet); line-height: 1.7; text-align: center;
  }
  .cm__foot a { color: var(--cm-flame); text-decoration: none; }
  .cm__foot a:hover { text-decoration: underline; }
</style>

<script>
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';

  // ============================================================
  //  CAST · METRONOME — proper time-keeper
  //  Tempo, meter (3/4/5/6/7), subdivision (q/8/3plet/16),
  //  polyrhythm (off, 2:3, 3:4, 4:5), tap-to-set, mute.
  // ============================================================

  let ctx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let sched: AudioScheduler | null = null;
  let volume = 55;
  let muted = false;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterGain = ctx.createGain(); masterGain.gain.value = volume / 100;
    masterGain.connect(ctx.destination);
    sched = createAudioScheduler(ctx);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running' && running) sched?.resume();
    });
    return ctx;
  }

  function click(t: number, accent: 'down' | 'beat' | 'sub' | 'poly') {
    if (muted) return;
    const c = ac();
    const o = c.createOscillator();
    const g = c.createGain();
    // Different timbres so polyrhythm clicks don't mush with the primary ones
    const config = {
      down: { freq: 2000, gain: 0.30, dur: 0.05, type: 'square' as OscillatorType },
      beat: { freq: 1500, gain: 0.18, dur: 0.04, type: 'square' as OscillatorType },
      sub:  { freq: 900,  gain: 0.10, dur: 0.03, type: 'square' as OscillatorType },
      poly: { freq: 600,  gain: 0.14, dur: 0.05, type: 'triangle' as OscillatorType },
    }[accent];
    o.type = config.type; o.frequency.value = config.freq;
    g.gain.setValueAtTime(0.001, t);
    g.gain.exponentialRampToValueAtTime(config.gain, t + 0.001);
    g.gain.exponentialRampToValueAtTime(0.001, t + config.dur);
    o.connect(g); g.connect(masterGain!);
    sched!.trackSource(o); o.start(t); o.stop(t + config.dur + 0.01);
  }

  // ---------- State ----------
  let bpm = 96;
  let meter = 4;           // beats per measure
  let subdivision = 1;     // clicks per beat (1=quarter, 2=8th, 3=triplet, 4=16th)
  let polyRatio = 0;       // 0=off, else: polyRatio clicks against `meter` beats in one measure
  let running = false;
  let scheduleStartCtxTime = 0;
  let curBeat = 0;
  let measureCount = 0;
  let rafId = 0;

  // ---------- Tap-to-set ----------
  let tapTimes: number[] = [];
  let tapTimeoutId: number | null = null;
  function handleTap() {
    const now = performance.now() / 1000;
    tapTimes.push(now);
    // Keep last 5 taps within 3 seconds
    tapTimes = tapTimes.filter(t => now - t < 3.0);
    if (tapTimes.length >= 2) {
      const intervals: number[] = [];
      for (let i = 1; i < tapTimes.length; i++) intervals.push(tapTimes[i] - tapTimes[i-1]);
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      if (avg > 0.2 && avg < 3.0) {
        const newBpm = Math.round(60 / avg);
        if (newBpm >= 40 && newBpm <= 220) {
          setBpm(newBpm);
          flashTap();
        }
      }
    } else {
      flashTap();
    }
    if (tapTimeoutId) clearTimeout(tapTimeoutId);
    tapTimeoutId = window.setTimeout(() => { tapTimes = []; }, 2500) as unknown as number;
  }
  function flashTap() {
    const btn = document.getElementById('cm-tap')!;
    btn.classList.add('cm__tap--press');
    setTimeout(() => btn.classList.remove('cm__tap--press'), 100);
  }

  // ---------- Scheduler ----------
  function scheduleMeasure(startTime: number) {
    const beatDur = 60 / bpm;
    const measureDur = meter * beatDur;
    // Primary track: meter beats, each subdivided
    for (let b = 0; b < meter; b++) {
      const beatStart = startTime + b * beatDur;
      // Visual schedule via RAF runs separately; here we schedule audio only
      for (let s = 0; s < subdivision; s++) {
        const subOffset = s * (beatDur / subdivision);
        const t = beatStart + subOffset;
        const accent = (b === 0 && s === 0) ? 'down' : (s === 0 ? 'beat' : 'sub');
        click(t, accent);
      }
    }
    // Polyrhythm: polyRatio clicks evenly across the same measureDur (excluding zero)
    if (polyRatio > 0) {
      for (let i = 0; i < polyRatio; i++) {
        const t = startTime + (i / polyRatio) * measureDur;
        // Don't double-fire when poly click coincides with the downbeat
        if (i === 0) continue;
        click(t, 'poly');
      }
    }
    // Re-schedule next measure
    sched!.schedule(() => {
      measureCount++;
      scheduleMeasure(startTime + measureDur);
    }, startTime + measureDur);
  }

  function start() {
    const c = ac(); if (c.state === 'suspended') c.resume();
    if (sched) sched.stopAll();
    running = true;
    measureCount = 0;
    curBeat = 0;
    scheduleStartCtxTime = c.currentTime + 0.1;
    scheduleMeasure(scheduleStartCtxTime);
    updatePlayBtn(true);
    renderBeats();
    runRender();
    // Set the pulse animation period to one beat
    const stage = document.getElementById('cm-stage') as HTMLDivElement;
    stage.style.setProperty('--beat-sec', `${60 / bpm}s`);
    stage.dataset.state = 'playing';
  }
  function stop() {
    if (sched) sched.stopAll();
    running = false;
    cancelAnimationFrame(rafId);
    updatePlayBtn(false);
    const stage = document.getElementById('cm-stage') as HTMLDivElement;
    stage.dataset.state = 'idle';
    stage.dataset.downbeat = '0';
    // Clear beat highlights
    document.querySelectorAll('.cm__beat').forEach(b => b.classList.remove('cm__beat--cur'));
  }
  function toggle() { if (running) stop(); else start(); }

  function updatePlayBtn(on: boolean) {
    const icon = document.getElementById('cm-play-icon')!;
    const btn = document.getElementById('cm-play')!;
    icon.textContent = on ? '◼' : '▶';
    btn.classList.toggle('cm__play--on', on);
  }

  function setBpm(newBpm: number) {
    bpm = Math.max(40, Math.min(220, newBpm));
    const slider = document.getElementById('cm-bpm') as HTMLInputElement;
    slider.value = String(bpm);
    document.getElementById('cm-bpm-readout')!.textContent = String(bpm);
    if (running) { stop(); start(); }
  }

  // ---------- Render ----------
  function renderBeats() {
    const wrap = document.getElementById('cm-beat-row')!;
    wrap.innerHTML = Array.from({length: meter}, (_, i) => `<div class="cm__beat ${i === 0 ? 'cm__beat--down' : ''}" data-beat="${i}"></div>`).join('');
  }

  function runRender() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!running || !ctx) return;
      const elapsed = ctx.currentTime - scheduleStartCtxTime;
      const beatDur = 60 / bpm;
      if (elapsed < 0) { rafId = requestAnimationFrame(tick); return; }
      const totalBeats = Math.floor(elapsed / beatDur);
      const beatInMeasure = totalBeats % meter;
      if (beatInMeasure !== curBeat) {
        curBeat = beatInMeasure;
        document.querySelectorAll<HTMLDivElement>('.cm__beat').forEach((el, i) => {
          el.classList.toggle('cm__beat--cur', i === curBeat);
        });
        const stage = document.getElementById('cm-stage') as HTMLDivElement;
        stage.dataset.downbeat = curBeat === 0 ? '1' : '0';
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  function updatePolyHint() {
    const el = document.getElementById('cm-poly-hint')!;
    if (polyRatio === 0) el.textContent = 'Off · just the primary click track.';
    else el.textContent = `${polyRatio} clicks against ${meter} beats over one measure. Lower triangle voice.`;
  }

  // ---------- Init ----------
  document.addEventListener('DOMContentLoaded', () => {
    renderBeats();
    updatePolyHint();

    document.getElementById('cm-play')?.addEventListener('click', toggle);
    document.getElementById('cm-tap')?.addEventListener('click', handleTap);

    const bpmSlider = document.getElementById('cm-bpm') as HTMLInputElement;
    bpmSlider.addEventListener('input', () => setBpm(Number(bpmSlider.value)));

    document.querySelectorAll<HTMLButtonElement>('[data-bpm]').forEach(b => {
      b.addEventListener('click', () => setBpm(Number(b.dataset.bpm)));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-meter]').forEach(b => {
      b.addEventListener('click', () => {
        meter = Number(b.dataset.meter);
        document.querySelectorAll<HTMLButtonElement>('[data-meter]').forEach(x => x.classList.toggle('cm__pill--active', x === b));
        renderBeats();
        updatePolyHint();
        if (running) { stop(); start(); }
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-sub]').forEach(b => {
      b.addEventListener('click', () => {
        subdivision = Number(b.dataset.sub);
        document.querySelectorAll<HTMLButtonElement>('[data-sub]').forEach(x => x.classList.toggle('cm__pill--active', x === b));
        if (running) { stop(); start(); }
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-poly]').forEach(b => {
      b.addEventListener('click', () => {
        polyRatio = Number(b.dataset.poly);
        document.querySelectorAll<HTMLButtonElement>('[data-poly]').forEach(x => x.classList.toggle('cm__pill--active', x === b));
        updatePolyHint();
        if (running) { stop(); start(); }
      });
    });

    document.getElementById('cm-vol')?.addEventListener('input', (e) => {
      volume = Number((e.target as HTMLInputElement).value);
      if (masterGain) masterGain.gain.setTargetAtTime(volume / 100, ac().currentTime, 0.04);
    });

    document.getElementById('cm-mute')?.addEventListener('click', (e) => {
      muted = !muted;
      const btn = e.currentTarget as HTMLButtonElement;
      btn.classList.toggle('cm__vol-btn--muted', muted);
      btn.setAttribute('aria-label', muted ? 'Unmute' : 'Mute');
    });

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); toggle(); return; }
      if (e.key === 't' || e.key === 'T') { e.preventDefault(); handleTap(); return; }
      if (e.key === 'ArrowUp')    { e.preventDefault(); setBpm(bpm + 1); return; }
      if (e.key === 'ArrowDown')  { e.preventDefault(); setBpm(bpm - 1); return; }
      if (e.key === 'ArrowRight') { e.preventDefault(); setBpm(bpm + 5); return; }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); setBpm(bpm - 5); return; }
    });
  });
</script>
</BlockLayout>
