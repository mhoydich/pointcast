---
import BlockLayout from '../../layouts/BlockLayout.astro';
import catalog from '../../data/everyday.json';
import '../../styles/everyday.css';
const categories = [
  {id:'wear', name:'Wear', note:'Easy layers. Useful pockets.'},
  {id:'carry', name:'Carry', note:'Take what you need. Leave your hands free.', image:'/images/everyday/day-tote.webp', alt:'Cream canvas Day Tote with long cobalt handles, an outer pocket and a tomato tab; $12 target retail'},
  {id:'home', name:'Home', note:'Small objects. A little less friction.', image:'/images/everyday/in-use.webp', alt:'An adult in a cobalt tee and cream trousers picks up the canvas day tote in a sunny apartment entry'},
];
const description = 'Everyday Works: twelve original wear, carry and home utility concepts. Accessible target retail prices of $3–$29. A design study, not for sale.';
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage', name:catalog.brand, description, url:'https://pointcast.xyz/everyday/', creativeWorkStatus:'Concept design study', hasPart:catalog.products.map(p=>({'@type':'CreativeWork',name:p.name,description:p.use,url:`https://pointcast.xyz/everyday/#${p.id}`,creativeWorkStatus:'Concept'}))};
---
<BlockLayout title="Everyday Works · Good things. Ordinary days." description={description} image="/images/everyday/collection-wide.webp" imageWidth={1536} imageHeight={1024} isolated={true} hideAds={true} showNetworkStrip={false} themeColor="#164cc8" jsonLd={jsonLd} alternates={[{type:'application/json',href:'/everyday.json',title:'Everyday Works concept catalog'}]}>
  <div class="everyday">
    <header class="everyday-header">
      <a class="everyday-wordmark" href="/everyday/" aria-label="Everyday Works home">EVERYDAY<br/>WORKS ↗</a>
      <nav aria-label="Everyday Works catalog"><a href="#wear">Wear</a><a href="#carry">Carry</a><a href="#home">Home</a><a href="/">PointCast ↗</a></nav>
    </header>
    <section class="everyday-hero" aria-labelledby="everyday-title">
      <div><p class="everyday-kicker">PointCast design study / 001</p><h1 id="everyday-title">Good things.<br/>Ordinary days.</h1><p class="everyday-hero__intro">The things you reach for without thinking. Made useful, made simple, with a price that makes sense.</p><a class="everyday-action" href="#catalog">Meet the twelve <span aria-hidden="true">↓</span></a><p class="everyday-hero__price">Wear · Carry · Home / $3–$29 target retail</p></div>
      <div><img src="/images/everyday/collection-wide.webp" width="1536" height="1024" alt="An illustrative collection of useful everyday clothes, bags and home objects in cobalt, tomato and butter yellow" fetchpriority="high" decoding="async"/><p class="everyday-image-note">AI-generated concept illustration. Bottle and contents are styling props. The $3 Bottle Loop is an accessory only.</p></div>
    </section>
    <aside class="everyday-notice" aria-label="Collection status"><strong>A line of ideas, for now.</strong><p>{catalog.priceDisclaimer} These are original product concepts, not manufactured goods or available inventory. There is nothing to order here. Every material, size and construction detail below is a proposed design specification.</p></aside>
    <section class="everyday-principles" aria-label="The design principles">
      <article><h2>Useful first.</h2><p>A pocket where your hand expects it. A strap that adjusts. An object that earns its space by doing a job.</p></article>
      <article><h2>Plain on purpose.</h2><p>Clear names, familiar materials and shared colors. The interest is in the way a thing works.</p></article>
      <article><h2>Price is part of the design.</h2><p>Fewer parts. Simple cuts. Nesting, folding and replaceable pieces considered from the first sketch.</p></article>
    </section>
    <section id="catalog" aria-labelledby="everyday-catalog-title">
      <header class="everyday-catalog-head"><h2 id="everyday-catalog-title">A little kit for living.</h2><p>Twelve concepts. Three parts of your day.<br/>All prices are target retail in USD.</p></header>
      {categories.map(category => <section class="everyday-category" id={category.id} aria-labelledby={`everyday-${category.id}-title`}>
        <header><h3 id={`everyday-${category.id}-title`}>{category.name}</h3><p>{category.note}</p></header>
        {category.image && <><img class="everyday-category__art" src={category.image} alt={category.alt} width="1536" height="1024" loading="lazy" decoding="async"/><p class="everyday-image-note">AI-generated concept illustration / stool shape and tote details vary; written specifications show design intent.</p></>}
        <ol class="everyday-products">{catalog.products.filter(p=>p.category===category.id).map(p => <li class="everyday-product" id={p.id} data-everyday-product>
          <div class="everyday-product__top"><span class="everyday-product__number">{p.code}</span><span class="everyday-product__swatch" style={`background:${p.swatch}`} aria-hidden="true"></span></div>
          <h4>{p.name}</h4><p class="everyday-product__use">{p.use}</p><p class="everyday-product__price"><b>${p.targetRetailUsd}</b>target retail / concept</p>
          <details><summary>Proposed design details</summary><dl><dt>Material</dt><dd>{p.material}</dd><dt>Construction</dt><dd>{p.construction}</dd><dt>Size</dt><dd>{p.dimensions}</dd><dt>Color studies</dt><dd>{p.colors.join(' · ')}</dd><dt>What needs testing</dt><dd>{p.feasibility}</dd></dl></details>
        </li>)}</ol>
      </section>)}
    </section>
    <section class="everyday-next" aria-labelledby="everyday-next-title"><div><p class="everyday-kicker">From sketch to something real</p><h2 id="everyday-next-title">The ordinary<br/>deserves a good test.</h2></div><div><p>This collection sets a direction. Making it real means testing everyday use and whether the target price survives honest production math.</p><ul><li>Make physical samples and test fit, load, wear and cleaning.</li><li>Check material sourcing, product safety and repair options.</li><li>Quote manufacturing, packaging, freight and taxes before setting a sale price.</li></ul><p class="everyday-image-note">No prototypes, performance tests, supplier quotes or production schedule are claimed.</p></div></section>
    <footer class="everyday-footer"><p>EVERYDAY WORKS / an original PointCast concept line<br/>Independent design study · October 2026</p><nav aria-label="More from Everyday Works"><a href="/everyday.json">Read the concept catalog JSON</a><a href="/manufacturing/">Explore the regional making atlas</a><a href="/">Back to PointCast</a></nav></footer>
  </div>
</BlockLayout>
<style is:global>body:has(.everyday){background:#f7f3e9}@media(prefers-color-scheme:dark){body:has(.everyday){background:#18212d}}</style>
