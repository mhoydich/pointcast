---
import { chapters, sources, authorship, copyright, verifiedDate } from '../data/bukowski';
const source = (id: string) => sources.find(s => s.id === id)!;
const shelf = [
  { id: 'post-office', kind: 'THE NOVEL', title: 'Post Office', detail: 'Begin with work. The 1971 first novel draws on postal life through Henry Chinaski, Bukowski’s roughly autobiographical fictional character.', action: 'Visit the publisher' },
  { id: 'pleasures', kind: 'THE POETRY', title: 'The Pleasures of the Damned', detail: 'A broad poetry entry point: the publisher’s collection gathers poems from 1951–1993. Follow the official book page for edition details.', action: 'Visit the publisher' },
  { id: 'interviews', kind: 'THE CONVERSATION', title: 'Sunlight Here I Am', detail: 'Interviews and Encounters, 1963–1993, edited by David Stephen Calonne. This catalog record has restricted access; it is not a free-text edition.', action: 'Open the catalog record' },
  { id: 'periodicals', kind: 'THE ARCHIVE', title: 'The little magazines', detail: 'Trace the writing through The Huntington’s periodical collection. A research catalog, with access determined by the library.', action: 'Explore the archive' },
];
---
<!doctype html>
<html lang="en" data-motion="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Charles Bukowski — The ordinary stays · PointCast</title>
    <meta name="description" content="An independent digital ode to Charles Bukowski: original people-free artwork, four new animated tribute poems, and a sourced reading guide." />
    <meta name="theme-color" content="#111416" />
    <link rel="canonical" href="https://pointcast.xyz/bukowski/" />
    <link rel="alternate" type="text/plain" href="/bukowski.txt" title="Plain text poems and guide" />
    <meta property="og:title" content="Charles Bukowski — The ordinary stays" />
    <meta property="og:description" content="One night. Four ordinary things. Original art and new poems in a PointCast literary tribute." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pointcast.xyz/bukowski/" />
    <meta property="og:image" content="https://pointcast.xyz/images/bukowski/room.webp" />
    <meta property="og:image:alt" content="A fictional empty room with a typewriter and amber window light." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#story">Skip to the story</a>
    <header class="masthead">
      <a class="wordmark" href="/">POINTCAST<span> / literary nights</span></a>
      <div class="reading-tools">
        <a href="/bukowski.txt">Plain text ↗</a>
        <button id="motion-toggle" type="button" aria-pressed="false" hidden>Motion off</button>
      </div>
    </header>
    <main>
      <section class="hero" aria-labelledby="title">
        <img class="hero-image" src="/images/bukowski/room.webp" width="1536" height="746" alt="A fictional empty room with a typewriter, chipped cup, blank paper and a chair in amber and neon light." fetchpriority="high" />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-rule"></span> AN INDEPENDENT ODE / 1920–1994</p>
          <h1 id="title">Charles<br />Bukowski<span class="period">.</span></h1>
          <p class="hero-line">the ordinary stays.</p>
          <p class="hero-intro">An empty room. A late street. A folded ticket.<br class="desktop-break" /> A little light left on the page.</p>
          <a class="enter" href="#story">Enter the night <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-credit">Fictional scene / original generated art<br />No people. Just what remains.</p>
      </section>
      <nav class="chapter-nav" aria-label="Story chapters">
        <span class="nav-caption">ONE NIGHT / FOUR THINGS</span>
        <div class="chapter-links">
          {chapters.map(c => <a href={`#${c.id}`} data-chapter-link={c.id}><span>{c.number}</span> {c.name.replace('The ', '')}</a>)}
          <a href="#reading">Reading desk</a>
        </div>
        <div class="progress-track" aria-hidden="true"><span id="story-progress"></span></div>
      </nav>
      <div id="story" class="story-intro wrap">
        <p class="eyebrow">OBJECTS THAT HOLD A LIFE</p>
        <p class="opening">Some lives become a legend.<br />Look closer: a cup, a street,<br /><em>a page that hasn’t given up.</em></p>
        <p class="attribution">Four original PointCast tribute poems, written by Codex with AI assistance. New writing for this ode; these are <strong>not poems or quotations by Bukowski.</strong></p>
        <p class="story-note">Read at your own pace. Each chapter’s motion settles after a few seconds. The motion control and your device’s reduced-motion setting keep everything still.</p>
      </div>
      {chapters.map((c, i) => (
        <section class:list={['chapter', { reverse: i % 2 === 1 }]} id={c.id} data-chapter aria-labelledby={`${c.id}-title`}>
          <figure class="chapter-art">
            <div class="art-window"><img src={`/images/bukowski/${c.image}.webp`} width="1536" height={c.image === 'room' ? 746 : 1024} alt={c.alt} loading="lazy" decoding="async" /></div>
            <figcaption><span>{c.caption}</span><span>{c.time}</span></figcaption>
          </figure>
          <div class="chapter-copy">
            <p class="eyebrow chapter-number">{c.number} / {c.name.toUpperCase()}</p>
            <h2 id={`${c.id}-title`}>{c.title}</h2>
            <p class="chapter-introduction">{c.introduction}</p>
            <article class="poem" aria-labelledby={`${c.id}-poem-title`}>
              <h3 id={`${c.id}-poem-title`}>{c.poemTitle}</h3>
              <p class="poem-byline">Original tribute poem / Codex for PointCast</p>
              <div class="poem-text">{c.lines.map((line, n) => line ? <span class="poem-line" style={`--line:${n}`}>{line}</span> : <br />)}</div>
            </article>
            <p class="afterword">{c.afterword}</p>
            <a class="next-chapter" href={i < chapters.length - 1 ? `#${chapters[i + 1].id}` : '#reading'}>{i < chapters.length - 1 ? `Next / ${chapters[i + 1].name.toLowerCase()}` : 'Continue / the reading desk'} <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      ))}
      <section class="context wrap" id="context" aria-labelledby="context-title">
        <p class="eyebrow">BEHIND THE NIGHT</p>
        <div class="context-grid">
          <h2 id="context-title">A writer.<br />A city.<br /><em>A complicated legacy.</em></h2>
          <div class="context-prose">
            <p>Charles Bukowski (1920–1994) was born in Andernach, Germany, grew up in Los Angeles, and died in San Pedro. The city’s jobs, rented rooms and outsiders became recurring material. <a href={source('poets').url}>Academy of American Poets ↗</a></p>
            <p>He sorted mail at the Los Angeles Terminal Annex in the 1950s and 1960s. At 49, support from John Martin of Black Sparrow Press allowed him to write full time. His first novel, <cite>Post Office</cite>, appeared in 1971. <a href={source('huntington').url}>The Huntington ↗</a></p>
            <p>Direct, conversational language could hold humor, loneliness and tenderness alongside the hard public persona. Henry Chinaski, a recurring character, is roughly autobiographical; fiction is not a documentary record. <a href={source('exhibition').url}>Exhibition context ↗</a></p>
            <aside class="critical-note"><h3>Read with your eyes open.</h3><p>This ode celebrates attention to ordinary life. It also acknowledges the misogyny and racism discussed in Bukowski’s work and interviews. Admiring a sentence does not require excusing its worldview. Addiction is not a requirement for creativity. <a href={source('criticism').url}>Jason Diamond’s critical essay ↗</a></p></aside>
          </div>
        </div>
      </section>
      <section class="reading wrap" id="reading" aria-labelledby="reading-title">
        <div class="section-heading"><div><p class="eyebrow">THE READING DESK</p><h2 id="reading-title">Go to the work.</h2></div><p>Books, criticism and archives.<br />Follow the source; keep your own judgment.</p></div>
        <div class="shelf">
          {shelf.map((book, i) => <article class="book-card"><span class="book-number">0{i + 1}</span><p class="eyebrow">{book.kind}</p><h3>{book.title}</h3><p>{book.detail}</p><a href={source(book.id).url}>{book.action} <span aria-hidden="true">↗</span></a></article>)}
        </div>
        <p class="availability">Links lead to independent publishers and libraries. Editions, access and availability may change. PointCast does not sell or stock these books.</p>
        <details class="reading-prompt"><summary>A few ways to read slowly <span aria-hidden="true">+</span></summary><div><p>Notice an ordinary object and what the sentence makes it carry. Listen for the break between a joke and a wound. Ask what the speaker observes, and what the speaker refuses to see.</p><p>These are PointCast reading prompts, offered as interpretation. For another perspective, read <a href={source('criticism').url}>“Thirst Trap” by Jason Diamond</a> alongside the books. For the publishing history, explore <a href={source('black-sparrow').url}>Western Michigan’s Black Sparrow Press holdings</a>.</p></div></details>
      </section>
      <section class="colophon wrap" id="sources" aria-labelledby="sources-title">
        <p class="eyebrow">COLOPHON / KEEP THE ATTRIBUTION</p>
        <h2 id="sources-title">New poems. Real sources.</h2>
        <p>{authorship}</p>
        <p>{copyright}</p>
        <details class="source-list"><summary>Source appendix <span>{sources.length} references / checked {verifiedDate} <span aria-hidden="true">+</span></span></summary><ol>{sources.map(s => <li><a href={s.url}>{s.title} ↗</a><p>{s.note}</p></li>)}</ol><p class="verification-note">Poetry Foundation’s direct page returned an access error during research; its indexed essay was inspected. Library catalogs describe holdings and restrictions, rather than guaranteeing online reading.</p></details>
        <div class="colophon-links"><a href="/bukowski.txt">Read or save the plain text ↗</a><a href="/bukowski.json">Structured story and sources ↗</a><a href="#title">Back to the room ↑</a></div>
      </section>
    </main>
    <footer class="footer wrap"><a href="/">POINTCAST</a><p>The ordinary stays.</p><span>AN INDEPENDENT TRIBUTE / OCTOBER 2026</span></footer>
    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('#motion-toggle');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let wantsMotion = true;
      try { wantsMotion = localStorage.getItem('pointcast-bukowski-motion') !== 'off'; } catch {}
      function syncMotion() {
        const enabled = wantsMotion && !reduced.matches;
        root.dataset.motion = enabled ? 'on' : 'off';
        if (button) {
          button.hidden = false;
          button.disabled = reduced.matches;
          button.textContent = reduced.matches ? 'Reduced motion' : enabled ? 'Motion on' : 'Motion off';
          button.setAttribute('aria-pressed', String(enabled));
          button.title = reduced.matches ? 'Your device requests reduced motion.' : 'Turn the chapter animation on or off';
        }
      }
      syncMotion();
      button?.addEventListener('click', () => {
        wantsMotion = !wantsMotion;
        try { localStorage.setItem('pointcast-bukowski-motion', wantsMotion ? 'on' : 'off'); } catch {}
        syncMotion();
      });
      reduced.addEventListener('change', syncMotion);
      const storyChapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('arrived');
              document.querySelectorAll('[data-chapter-link]').forEach(link => {
                if (link.getAttribute('data-chapter-link') === entry.target.id) link.setAttribute('aria-current', 'location');
                else link.removeAttribute('aria-current');
              });
              const progress = document.querySelector<HTMLElement>('#story-progress');
              if (progress) progress.style.width = `${(storyChapters.indexOf(entry.target as HTMLElement) + 1) / storyChapters.length * 100}%`;
            }
          });
        }, { threshold: 0.2 });
        storyChapters.forEach(chapter => observer.observe(chapter));
      }
    </script>
  </body>
</html>
<style is:global>
  :root{color-scheme:dark;--ink:#111416;--cream:#f3eadb;--muted:#bdb5a7;--copper:#e5a172;--rule:#393d3d;scroll-behavior:smooth;scroll-padding-top:95px}
