display:inline-block;width:32px;height:1px;background:var(--copper);vertical-align:middle;margin-right:14px}h1{font-size:clamp(64px,7.9vw,128px);font-weight:normal;line-height:.92;letter-spacing:-.065em;margin:38px 0 14px}.period{color:var(--copper)}.hero-line{color:var(--copper);font-size:clamp(25px,3vw,44px);font-style:italic;margin:20px 0 34px}.hero-intro{color:#e6ded2;font-size:17px;line-height:1.75;max-width:370px}.enter{display:inline-flex;gap:40px;align-items:center;margin-top:30px;font:12px 'Courier New',monospace;padding:16px 0;border-bottom:1px solid var(--copper);text-decoration:none}.enter span{font-size:24px}.hero-credit{position:absolute;bottom:28px;right:42px;color:var(--muted);font-size:10px;text-align:right;line-height:1.8}.chapter-nav{position:sticky;top:0;z-index:10;background:#111416f5;backdrop-filter:blur(12px);border-block:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between;padding:0 42px;min-height:68px;font-size:11px;gap:25px}.nav-caption{font-size:9px;letter-spacing:.1em;color:var(--muted)}.chapter-links{display:flex;align-items:center;gap:30px}.chapter-links a{text-decoration:none;display:inline-flex;align-items:center;gap:7px;min-height:52px}.chapter-links a span{color:var(--muted);font-size:9px}.chapter-links a[aria-current]{color:var(--copper)}.progress-track{position:absolute;bottom:-1px;left:0;right:0;height:2px}.progress-track span{display:block;height:100%;width:0;background:var(--copper)}.story-intro{padding-block:125px;max-width:760px}.opening{font-size:clamp(32px,3.8vw,54px);line-height:1.2;letter-spacing:-.03em}.opening em{color:var(--copper)}.attribution{font-size:15px;line-height:1.8;color:var(--muted);max-width:530px;margin-top:38px}.attribution strong{font-weight:normal;color:var(--cream)}.story-note{color:var(--muted);font:11px/1.8 'Courier New',monospace;max-width:510px}.chapter{display:grid;grid-template-columns:1.08fr 1fr;border-top:1px solid var(--rule);min-height:860px;scroll-margin-top:80px;max-width:1600px;margin:auto}.chapter.reverse .chapter-art{order:2}.chapter-art{margin:0;min-width:0;display:flex;flex-direction:column;background:#0d1011}.art-window{flex:1;overflow:hidden;min-height:520px}.art-window img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}.chapter:first-of-type .art-window img{object-position:62% center}figcaption{display:flex;justify-content:space-between;gap:14px;padding:22px 28px;color:var(--muted);font-size:9px;line-height:1.6;text-transform:uppercase;letter-spacing:.04em}.chapter-copy{padding:72px clamp(32px,5vw,80px);display:flex;flex-direction:column;align-items:flex-start}.chapter h2{font-size:clamp(29px,3vw,43px);line-height:1.1;letter-spacing:-.035em;font-weight:normal;max-width:350px;margin:20px 0}.chapter-introduction{font-size:14px;line-height:1.8;color:var(--muted);max-width:330px}.poem{border-left:1px solid #c39368;padding-left:26px;margin-top:30px}.poem h3{font-weight:normal;font-style:italic;font-size:22px;margin:0 0 8px}.poem-byline{font-size:9px;color:var(--copper);line-height:1.6;margin:0 0 24px}.poem-text{font-size:clamp(17px,1.6vw,21px);line-height:1.58;letter-spacing:-.015em}.poem-line{display:block}.poem-text br{display:block;content:'';margin-top:.7em}.afterword{font-size:10px;line-height:1.8;max-width:310px;color:var(--muted);margin:28px 0}.next-chapter{font-size:11px;text-decoration:none;display:flex;gap:20px;align-items:center;min-height:44px;margin-top:auto}.next-chapter span{color:var(--copper);font-size:20px}.context{padding-block:140px;border-top:1px solid var(--rule)}.context-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.context h2{font-size:clamp(38px,4.2vw,62px);font-weight:normal;line-height:1.12;letter-spacing:-.03em;margin-top:28px}.context h2 em{color:var(--copper)}.context-prose{font-size:17px;line-height:1.8;padding-top:16px}.context-prose a{font:10px/1.7 'Courier New',monospace;color:var(--copper);display:inline}.critical-note{border-left:1px solid var(--copper);padding:5px 0 5px 25px;margin-top:35px}.critical-note h3{font-size:22px;font-weight:normal;margin:0}.critical-note p{font-size:15px;color:var(--muted)}.reading{padding-block:100px;border-top:1px solid var(--rule)}.section-heading{display:flex;gap:30px;justify-content:space-between;align-items:flex-end;margin-bottom:45px}.section-heading h2,.colophon h2{font-size:clamp(36px,4vw,54px);font-weight:normal;letter-spacing:-.035em;margin:16px 0 0}.section-heading>p{color:var(--muted);font-size:14px;line-height:1.6}.shelf{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--rule)}.book-card{position:relative;padding:36px 26px 22px;display:flex;flex-direction:column;border-right:1px solid var(--rule)}.book-card:last-child{border-right:0}.book-number{color:#a0988b;font-size:12px;margin-bottom:40px}.book-card .eyebrow{font-size:9px}.book-card h3{font-size:27px;font-weight:normal;line-height:1.1;letter-spacing:-.03em;margin:10px 0 14px;min-height:60px}.book-card>p:not(.eyebrow){font-size:13px;line-height:1.8;color:var(--muted)}.book-card a{font:10px/1.7 'Courier New',monospace;min-height:48px;display:flex;gap:8px;align-items:center;margin-top:auto;color:var(--copper);text-decoration:none}.book-card a span{margin-left:auto;font-size:20px}.availability{font-size:10px;line-height:1.8;color:var(--muted);margin-top:22px}.reading-prompt,.source-list{border-block:1px solid var(--rule);margin-top:45px}summary{cursor:pointer;min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:17px;list-style:none}summary::-webkit-details-marker{display:none}summary span{font:11px 'Courier New',monospace;color:var(--muted)}summary [aria-hidden]{color:var(--copper);font-size:23px}details[open] summary [aria-hidden]{transform:rotate(45deg)}.reading-prompt>div{font-size:16px;line-height:1.85;max-width:790px;padding-bottom:24px}.reading-prompt a{color:var(--copper)}.colophon{border-top:1px solid var(--rule);padding-block:95px}.colophon>p:not(.eyebrow){max-width:750px;color:var(--muted);font-size:14px;line-height:1.9}.colophon h2{margin-bottom:28px}.source-list ol{padding:12px 0 14px 30px;columns:2;column-gap:70px;font-size:14px}.source-list li{break-inside:avoid;margin:0 0 24px;padding-left:5px}.source-list li a{color:var(--cream)}.source-list li p{font-size:12px;line-height:1.8;color:var(--muted);margin-top:10px}.verification-note{font-size:11px;line-height:1.8;color:var(--muted);max-width:690px;margin:0 0 30px}.colophon-links{display:flex;flex-wrap:wrap;gap:30px;font-size:11px;margin-top:34px}.colophon-links a{min-height:44px;display:flex;align-items:center;color:var(--copper)}.footer{padding-block:30px 50px;border-top:1px solid var(--rule);display:flex;justify-content:space-between;align-items:center;gap:24px}.footer>a{font-size:12px;letter-spacing:.13em;text-decoration:none}.footer>p{font-family:Georgia,serif;font-size:20px;font-style:italic;color:var(--copper)}.footer>span{font-size:9px;color:var(--muted)}
  html[data-motion="on"] .arrived .poem-line{animation:line-arrives .65s both;animation-delay:calc(var(--line)*.075s)}html[data-motion="on"] .arrived .art-window img{animation:room-settles 3s ease-out both}@keyframes line-arrives{from{transform:translateY(7px)}to{transform:translateY(0)}}@keyframes room-settles{from{transform:scale(1.035)}to{transform:scale(1)}}
