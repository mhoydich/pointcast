---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  OPEN_TO_WORK_BOARD,
  UNIFORM_OBSERVATIONS,
  UNIFORMS_POST,
  WORKLIFE_PUBLICATION,
} from '../../lib/worklife-publication';

const post = UNIFORMS_POST;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.displayTitle,
  description: post.description,
  url: post.canonicalUrl,
  image: `https://pointcast.xyz${post.cover}`,
  datePublished: post.publishedAt,
  isPartOf: {
    '@type': 'Periodical',
    name: WORKLIFE_PUBLICATION.title,
    url: WORKLIFE_PUBLICATION.canonicalUrl,
  },
  publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title={`${post.displayTitle} — WORK/LIFE`}
  description={post.description}
  image={`https://pointcast.xyz${post.cover}`}
  themeColor="#d7f51b"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: post.jsonRoute, title: `${post.displayTitle} JSON` }]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="uniforms" id="main-content">
    <nav class="uniforms__wire mono" aria-label="Breadcrumb">
      <a href="/">POINTCAST</a><span>/</span><a href="/worklife">WORK/LIFE</a><span>/</span><span>UNIFORMS</span>
      <span class="uniforms__wire-end">THE SHIFT / BLOCK {post.blockId}</span>
    </nav>

    <header class="uniforms__hero">
      <div class="uniforms__hero-copy">
        <p class="mono">{post.kicker}</p>
        <h1><span>THE CLOTHES</span><span>HAVE CLOCKED IN</span></h1>
        <p>{post.dek}</p>
        <div class="uniforms__stamp mono">ISSUED 08.03.26<br />RETURN CONDITION: HUMAN</div>
      </div>
      <figure>
        <img src={post.cover} alt={post.coverAlt} width="1536" height="1536" />
        <figcaption class="mono">PLATE 01 / PORTABLE ORG CHART</figcaption>
      </figure>
    </header>

    <article>
      <section class="uniforms__lede">
        <p class="uniforms__drop">U</p>
        <div>
          <p>
            A uniform is an instruction written on a body. It can say <em>trust me</em>,
            <em>ask me</em>, <em>do not cross this line</em>, <em>I belong here</em>, or
            <em>I am not the person in charge</em>—sometimes all before the person wearing it
            has decided how they feel about the job.
          </p>
          <p>
            We tend to treat uniforms as costumes for obvious occupations: the reflective vest,
            the scrubs, the apron, the blazer. But most workplaces have one. The black T-shirt,
            the neutral sneaker, the conference fleece, the camera strap, the permanent headphones:
            an anti-uniform becomes a uniform as soon as enough people recognize the code.
          </p>
        </div>
        <aside>
          <p class="mono">FIELD NOTE</p>
          <p>Clothes do not merely express the worker. Work recruits clothes to organize the room.</p>
        </aside>
      </section>

      <section class="uniforms__rack" aria-labelledby="uniform-rack-title">
        <header>
          <p class="mono">SIX GARMENTS / SIX INSTRUCTIONS</p>
          <h2 id="uniform-rack-title">Read the role before the résumé.</h2>
        </header>
        <ol>
          {UNIFORM_OBSERVATIONS.map((item, index) => (
            <li style={`--swatch:${item.color}`}>
              <span class="uniforms__number mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="uniforms__swatch" aria-hidden="true"></span>
              <h3>{item.garment}</h3>
              <strong class="mono">{item.action}</strong>
              <p>{item.note}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="uniforms__instrument" data-uniform-instrument>
        <div>
          <p class="mono">LOCAL FITTING ROOM / NO DATA LEAVES</p>
          <h2>What is the uniform doing?</h2>
          <p data-uniform-copy>
            A signal makes the role readable from across the room. It saves an introduction and starts an expectation.
          </p>
        </div>
        <div class="uniforms__mode" data-uniform-visual="signal" aria-live="polite">
          <span data-uniform-word>SIGNAL</span>
          <div aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="uniforms__controls" role="group" aria-label="Choose what a uniform is doing">
          <button type="button" data-uniform-mode="signal" aria-pressed="true">SIGNAL</button>
          <button type="button" data-uniform-mode="protect" aria-pressed="false">PROTECT</button>
          <button type="button" data-uniform-mode="belong" aria-pressed="false">BELONG</button>
          <button type="button" data-uniform-mode="disappear" aria-pressed="false">DISAPPEAR</button>
        </div>
      </section>

      <section class="uniforms__essay">
        <div>
          <p class="mono">THE PROMISE</p>
          <h2>A good uniform removes one decision and adds one protection.</h2>
          <p>
            It can make the wearer visible near traffic, keep private clothing clean, carry the tools
            of a shift, or let a frightened stranger locate help. It can turn a group into a team and
            make competence easier to find. At its best, the uniform takes on some of the work.
          </p>
        </div>
        <div>
          <p class="mono">THE COST</p>
          <h2>A bad uniform asks the body to disappear inside the role.</h2>
          <p>
            It can advertise availability without offering authority, enforce an idea of gender or
            class, make discomfort look professional, or follow somebody home as smell, stain,
            posture, and mood. The clearer the role becomes, the easier it is to forget the person.
          </p>
        </div>
      </section>

      <section class="uniforms__after" aria-labelledby="after-shift-title">
        <header>
          <p class="mono">MIDJOURNEY ARCHIVE / AFTER SHIFT</p>
          <h2 id="after-shift-title">The room keeps performing office.</h2>
          <p>
            These two studies came from Michael Hoydich’s May 2026 Midjourney archive. They are not
            documentary pictures of work. They are placed here because the emptiness makes a useful
            argument: screens, chairs, plants, art, and water coolers stay dressed for work after the
            worker has gone home.
          </p>
        </header>
        <div>
          {post.visualArchive.images.map((image, index) => (
            <figure>
              <img src={image.src} alt={image.alt} width="1024" height="1024" loading="lazy" />
              <figcaption><span class="mono">STUDY 0{index + 1}</span><b>{image.title}</b></figcaption>
            </figure>
          ))}
        </div>
        <p class="uniforms__credit mono">{post.visualArchive.credit}</p>
      </section>

      <section class="uniforms__close">
        <p class="mono">END OF SHIFT / CHECK THE LABEL</p>
        <h2>Who does the garment let you be—and who does it require you to stop being?</h2>
        <p>
          The useful question is not whether a workplace has uniforms. It is whether the worker gets
          any say in the fit, the signal, the care instructions, and when the clothes are finally allowed
          to clock out.
        </p>
        <div>
          <a href={OPEN_TO_WORK_BOARD.route}>Make an OPEN TO WORK signal ↗</a>
          <a href="/worklife">Return to WORK/LIFE ↗</a>
          <a href={post.jsonRoute}>Inspect the post JSON ↗</a>
        </div>
      </section>
    </article>
  </main>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-uniform-instrument]');
    if (!root) return;
    const copy = root.querySelector('[data-uniform-copy]');
    const visual = root.querySelector('[data-uniform-visual]');
    const word = root.querySelector('[data-uniform-word]');
    const modes = {
      signal: 'A signal makes the role readable from across the room. It saves an introduction and starts an expectation.',
      protect: 'Protection places fabric between the worker and the weather, stain, heat, dirt, gaze, or other cost of the task.',
      belong: 'Belonging turns separate bodies into a visible team. The comfort is real; so is the pressure to match.',
      disappear: 'Disappearance lets the service arrive without the person becoming the story. It can be relief, erasure, or both.',
    };
    root.querySelectorAll('[data-uniform-mode]').forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.getAttribute('data-uniform-mode');
        if (!mode || !modes[mode]) return;
        root.querySelectorAll('[data-uniform-mode]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        copy.textContent = modes[mode];
        visual.setAttribute('data-uniform-visual', mode);
        word.textContent = mode.toUpperCase();
      });
    });
  })();
</script>

<style>
  :global(body){margin:0;background:#bbb8ad}.uniforms{--ink:#12120f;--paper:#f3eedb;--acid:#d7f51b;--blue:#1747d1;--orange:#ef542e;width:min(1500px,calc(100% - 24px));margin:12px auto 48px;border:2px solid var(--ink);background:var(--paper);color:var(--ink);overflow:hidden}.uniforms a{color:inherit}.mono{font-family:var(--pc-font-mono)}
  .uniforms__wire{display:flex;gap:8px;align-items:center;padding:10px 14px;background:var(--ink);color:var(--paper);font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__wire-end{margin-left:auto}
  .uniforms__hero{display:grid;grid-template-columns:1.08fr .92fr;min-height:760px;border-bottom:2px solid var(--ink);background:var(--acid)}.uniforms__hero-copy{position:relative;display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,6vw,96px);border-right:2px solid var(--ink)}.uniforms__hero-copy>p:first-child{margin:0 0 40px;font-size:10px;font-weight:900;letter-spacing:.11em}.uniforms__hero h1{margin:0;font-size:clamp(68px,9.4vw,145px);line-height:.76;letter-spacing:-.075em}.uniforms__hero h1 span{display:block}.uniforms__hero h1 span:last-child{margin-top:.14em;color:var(--blue)}.uniforms__hero-copy>p:not(:first-child){max-width:680px;margin:48px 0 0;font-size:21px;line-height:1.38}.uniforms__stamp{align-self:flex-end;margin-top:55px;padding:12px 15px;border:3px solid var(--orange);color:var(--orange);font-size:10px;font-weight:900;line-height:1.45;transform:rotate(-3deg)}.uniforms__hero figure{position:relative;margin:0;background:var(--paper)}.uniforms__hero figure img{display:block;width:100%;height:100%;object-fit:cover}.uniforms__hero figcaption{position:absolute;right:14px;bottom:14px;padding:9px 12px;background:var(--ink);color:var(--paper);font-size:9px;font-weight:900}
  .uniforms__lede{display:grid;grid-template-columns:auto minmax(0,1.25fr) minmax(260px,.55fr);gap:24px;padding:clamp(42px,7vw,105px);border-bottom:2px solid var(--ink)}.uniforms__drop{margin:0;color:var(--orange);font-size:170px;font-weight:950;line-height:.7}.uniforms__lede>div p{margin:0;font-family:Georgia,serif;font-size:clamp(22px,2.2vw,32px);line-height:1.46}.uniforms__lede>div p+p{margin-top:28px}.uniforms__lede aside{align-self:start;padding:24px;border:2px solid var(--ink);background:var(--blue);color:var(--paper)}.uniforms__lede aside p{margin:0;font-size:16px;line-height:1.4}.uniforms__lede aside p:first-child{margin-bottom:42px;font-size:9px;font-weight:900;letter-spacing:.1em}
  .uniforms__rack{border-bottom:2px solid var(--ink)}.uniforms__rack>header{display:grid;grid-template-columns:.45fr 1.55fr;align-items:end;padding:46px;border-bottom:2px solid var(--ink);background:var(--orange)}.uniforms__rack header p{margin:0;font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__rack h2{margin:0;font-size:clamp(48px,6vw,88px);line-height:.9;letter-spacing:-.06em}.uniforms__rack ol{display:grid;grid-template-columns:repeat(3,1fr);margin:0;padding:0;list-style:none}.uniforms__rack li{position:relative;min-height:360px;padding:28px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);overflow:hidden}.uniforms__rack li:nth-child(3n){border-right:0}.uniforms__rack li:nth-last-child(-n+3){border-bottom:0}.uniforms__number{position:relative;z-index:2;font-size:10px;font-weight:900}.uniforms__swatch{position:absolute;right:-35px;top:-35px;width:190px;height:190px;border:2px solid var(--ink);border-radius:50%;background:var(--swatch)}.uniforms__rack h3{position:relative;z-index:2;margin:100px 0 8px;font-size:39px;letter-spacing:-.055em}.uniforms__rack strong{position:relative;z-index:2;color:var(--blue);font-size:10px;letter-spacing:.08em}.uniforms__rack li p{position:relative;z-index:2;max-width:35ch;margin:45px 0 0;font-size:16px;line-height:1.42}
  .uniforms__instrument{display:grid;grid-template-columns:1fr 1fr;border-bottom:2px solid var(--ink);background:var(--blue);color:var(--paper)}.uniforms__instrument>div:first-child{padding:clamp(40px,6vw,85px);border-right:2px solid var(--ink)}.uniforms__instrument p{margin:0;font-size:18px;line-height:1.45}.uniforms__instrument p:first-child{font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__instrument h2{margin:32px 0;font-size:clamp(52px,6vw,88px);line-height:.9;letter-spacing:-.06em}.uniforms__mode{position:relative;display:grid;place-items:center;min-height:520px;overflow:hidden;background:var(--acid);color:var(--ink)}.uniforms__mode>span{position:relative;z-index:2;font-size:clamp(64px,9vw,140px);font-weight:950;letter-spacing:-.08em;transform:rotate(-8deg)}.uniforms__mode>div{position:absolute;inset:0}.uniforms__mode i{position:absolute;display:block;width:44%;height:44%;border:3px solid var(--ink);border-radius:50%}.uniforms__mode i:nth-child(1){left:-8%;top:-8%}.uniforms__mode i:nth-child(2){right:-8%;top:-8%}.uniforms__mode i:nth-child(3){left:-8%;bottom:-8%}.uniforms__mode i:nth-child(4){right:-8%;bottom:-8%}.uniforms__mode[data-uniform-visual="protect"]{background:var(--orange)}.uniforms__mode[data-uniform-visual="belong"]{background:var(--paper)}.uniforms__mode[data-uniform-visual="disappear"]{background:var(--ink);color:var(--paper)}.uniforms__mode[data-uniform-visual="disappear"] i{border-color:#4b4b44}.uniforms__controls{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--ink)}.uniforms__controls button{padding:16px;border:0;border-right:2px solid var(--ink);background:var(--paper);color:var(--ink);font:900 11px var(--pc-font-mono);cursor:pointer}.uniforms__controls button:last-child{border-right:0}.uniforms__controls button[aria-pressed="true"]{background:var(--ink);color:var(--acid)}
  .uniforms__essay{display:grid;grid-template-columns:1fr 1fr;border-bottom:2px solid var(--ink)}.uniforms__essay>div{padding:clamp(45px,7vw,100px)}.uniforms__essay>div:first-child{border-right:2px solid var(--ink);background:var(--paper)}.uniforms__essay>div:last-child{background:var(--orange)}.uniforms__essay p{margin:0;font-size:18px;line-height:1.5}.uniforms__essay p:first-child{font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__essay h2{margin:42px 0;font-size:clamp(45px,5vw,76px);line-height:.93;letter-spacing:-.055em}
  .uniforms__after{padding:clamp(38px,6vw,86px);border-bottom:2px solid var(--ink);background:var(--ink);color:var(--paper)}.uniforms__after header{display:grid;grid-template-columns:.35fr 1.1fr .8fr;gap:34px;align-items:end;margin-bottom:44px}.uniforms__after header p{margin:0;font-size:15px;line-height:1.45}.uniforms__after header p:first-child{font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__after h2{margin:0;font-size:clamp(52px,6.6vw,100px);line-height:.85;letter-spacing:-.065em}.uniforms__after>div{display:grid;grid-template-columns:1fr 1fr;gap:18px}.uniforms__after figure{margin:0;border:2px solid var(--paper)}.uniforms__after img{display:block;width:100%;height:auto}.uniforms__after figcaption{display:flex;justify-content:space-between;gap:16px;padding:14px;background:var(--paper);color:var(--ink)}.uniforms__after figcaption span{font-size:9px;font-weight:900}.uniforms__credit{margin:16px 0 0;text-align:right;font-size:9px;letter-spacing:.08em}
  .uniforms__close{padding:clamp(48px,8vw,120px);background:var(--acid)}.uniforms__close>p:first-child{margin:0;font-size:9px;font-weight:900;letter-spacing:.1em}.uniforms__close h2{max-width:1200px;margin:42px 0;font-size:clamp(55px,8vw,125px);line-height:.86;letter-spacing:-.07em}.uniforms__close>p:not(:first-child){max-width:760px;margin:0;font-size:21px;line-height:1.45}.uniforms__close>div{display:flex;flex-wrap:wrap;gap:10px;margin-top:40px}.uniforms__close a{padding:13px 15px;border:2px solid var(--ink);font:900 10px var(--pc-font-mono);text-decoration:none}.uniforms__close a:first-child{background:var(--ink);color:var(--paper)}
  @media(max-width:900px){.uniforms__hero,.uniforms__instrument,.uniforms__essay{grid-template-columns:1fr}.uniforms__hero-copy,.uniforms__instrument>div:first-child,.uniforms__essay>div:first-child{border-right:0;border-bottom:2px solid var(--ink)}.uniforms__hero figure img{height:auto}.uniforms__lede{grid-template-columns:auto 1fr}.uniforms__lede aside{grid-column:2}.uniforms__rack ol{grid-template-columns:repeat(2,1fr)}.uniforms__rack li:nth-child(3n){border-right:2px solid var(--ink)}.uniforms__rack li:nth-child(2n){border-right:0}.uniforms__rack li:nth-last-child(-n+3){border-bottom:2px solid var(--ink)}.uniforms__rack li:nth-last-child(-n+2){border-bottom:0}.uniforms__after header{grid-template-columns:1fr 2fr}.uniforms__after header p:last-child{grid-column:2}}
  @media(max-width:620px){.uniforms{width:calc(100% - 12px);margin:6px auto 28px}.uniforms__wire-end{display:none}.uniforms__hero{min-height:0}.uniforms__hero-copy{padding:42px 20px}.uniforms__hero h1{font-size:clamp(57px,19vw,84px)}.uniforms__stamp{align-self:flex-start}.uniforms__lede{grid-template-columns:1fr;padding:44px 20px}.uniforms__drop{font-size:110px}.uniforms__lede aside{grid-column:auto}.uniforms__rack>header{grid-template-columns:1fr;padding:36px 20px}.uniforms__rack header p{margin-bottom:24px}.uniforms__rack ol{grid-template-columns:1fr}.uniforms__rack li,.uniforms__rack li:nth-child(2n),.uniforms__rack li:nth-child(3n){min-height:320px;border-right:0;border-bottom:2px solid var(--ink)}.uniforms__rack li:last-child{border-bottom:0}.uniforms__instrument>div:first-child{padding:44px 20px}.uniforms__mode{min-height:360px}.uniforms__controls{grid-template-columns:1fr 1fr}.uniforms__controls button:nth-child(2){border-right:0}.uniforms__controls button:nth-child(-n+2){border-bottom:2px solid var(--ink)}.uniforms__essay>div{padding:50px 20px}.uniforms__after{padding:48px 18px}.uniforms__after header{grid-template-columns:1fr}.uniforms__after header p:last-child{grid-column:auto}.uniforms__after>div{grid-template-columns:1fr}.uniforms__close{padding:54px 20px}.uniforms__close h2{font-size:clamp(52px,16vw,82px)}}
  @media(prefers-reduced-motion:reduce){.uniforms__mode>span{transform:none}}
</style>
