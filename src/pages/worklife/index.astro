---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  MANIC_MONDAY,
  WORKLIFE_DESKS,
  WORKLIFE_PUBLICATION,
} from '../../lib/worklife-publication';

const publication = WORKLIFE_PUBLICATION;
const opener = MANIC_MONDAY;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Periodical',
  '@id': `${publication.canonicalUrl}#publication`,
  name: publication.title,
  description: publication.description,
  url: publication.canonicalUrl,
  inLanguage: 'en-US',
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  hasPart: [
    {
      '@type': 'MusicPlaylist',
      name: opener.displayTitle,
      url: opener.canonicalUrl,
      image: `https://pointcast.xyz${opener.cover}`,
      datePublished: opener.publishedAt,
      numTracks: opener.trackCount,
    },
  ],
};
---

<BlockLayout
  title={`${publication.title} — A PointCast publication`}
  description={publication.description}
  image={`https://pointcast.xyz${opener.cover}`}
  themeColor="#d7f51b"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: publication.jsonRoute, title: `${publication.title} JSON` },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: `https://pointcast.xyz${opener.cover}`,
    aspectRatio: '1:1',
    buttons: [
      { label: 'Open issue 001', action: 'link', target: opener.canonicalUrl },
      { label: 'Play on Spotify', action: 'link', target: opener.spotifyUrl },
      { label: 'Publication JSON', action: 'link', target: `https://pointcast.xyz${publication.jsonRoute}` },
    ],
  }}
>
  <main class="worklife" id="main-content">
    <nav class="worklife__crumb mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><span>WORK/LIFE</span>
    </nav>

    <header class="worklife__mast">
      <div class="worklife__name" aria-label="Work Life">
        <span>WORK</span>
        <span>LIFE</span>
      </div>
      <div class="worklife__slash" aria-hidden="true">/</div>
      <div class="worklife__mission">
        <p class="mono">A POINTCAST PUBLICATION / OPENING SHIFT</p>
        <h1>{publication.dek}</h1>
        <p>{publication.description}</p>
      </div>
    </header>

    <section class="worklife__opener" aria-labelledby="worklife-opener-title">
      <a class="worklife__cover" href={opener.route}>
        <img src={opener.cover} alt={opener.coverAlt} width="1536" height="1536" />
        <span class="mono">PLAY ISSUE 001 ↗</span>
      </a>
      <div class="worklife__opener-copy">
        <p class="mono">ISSUE 001 / MONDAY, AUGUST 3 / BLOCK {opener.blockId}</p>
        <h2 id="worklife-opener-title">It’s just another <em>Manic Monday.</em></h2>
        <p>{opener.description}</p>
        <blockquote>
          Monday is the opener, not the subject. The subject is the whole
          arrangement: what we do, what it costs, what it gives us, and who is
          still there when the screen goes dark.
        </blockquote>
        <dl>
          <div><dt>tracks</dt><dd>{opener.trackCount}</dd></div>
          <div><dt>runtime</dt><dd>{opener.duration}</dd></div>
          <div><dt>opening song</dt><dd>The Bangles</dd></div>
        </dl>
        <div class="worklife__actions">
          <a href={opener.route}>Read + play the issue ↗</a>
          <a href={opener.spotifyUrl} target="_blank" rel="noopener">Open Spotify ↗</a>
          <a href={opener.jsonRoute}>Inspect JSON ↗</a>
        </div>
      </div>
    </section>

    <section class="worklife__desks" aria-labelledby="worklife-desks-title">
      <header>
        <p class="mono">THE PUBLICATION / SIX DESKS</p>
        <h2 id="worklife-desks-title">The job is never only the job.</h2>
        <p>
          WORK/LIFE follows the working day outward: into bodies, rooms,
          relationships, neighborhoods, money, tools, taste, and time.
        </p>
      </header>
      <ol>
        {WORKLIFE_DESKS.map((desk, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h3>{desk.title}</h3>
            <p>{desk.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="worklife__promise" aria-labelledby="worklife-promise-title">
      <div>
        <p class="mono">EDITORIAL PROMISE / V1</p>
        <h2 id="worklife-promise-title">Useful, funny, reported, alive.</h2>
      </div>
      <ol>
        <li><b>01</b><span>Start with a real behavior, object, tension, or working day.</span></li>
        <li><b>02</b><span>Keep labor, management, ownership, and risk visible.</span></li>
        <li><b>03</b><span>Make every issue pleasurable enough to read off the clock.</span></li>
        <li><b>04</b><span>Give the human page a machine-readable twin and a permanent receipt.</span></li>
      </ol>
    </section>

    <section class="worklife__next" aria-labelledby="worklife-next-title">
      <p class="mono">ON THE WORKTABLE / OPEN BRIEFS, NOT PUBLISHED STORIES</p>
      <h2 id="worklife-next-title">The desk we bring home. Lunch isn’t a bug. Forty-seven tabs and one physical notebook.</h2>
      <p>{publication.cadence.note}</p>
    </section>

    <footer class="worklife__footer">
      <p>{publication.participation.note}</p>
      <nav aria-label="WORK/LIFE participation">
        <a href="/super-follow">Follow on this device</a>
        <a href="/ping">Pitch WORK/LIFE</a>
        <a href="/wednesday">Visit the playlist desk</a>
        <a href={publication.jsonRoute}>Publication JSON</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #d8d4c6; }
  .worklife {
    --ink: #11110f;
    --paper: #f4efdd;
    --acid: #d7f51b;
    --blue: #1747d1;
    --orange: #ef542e;
    width: min(1500px, calc(100% - 24px));
    margin: 12px auto 48px;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .worklife a { color: inherit; }
  .mono { font-family: var(--pc-font-mono); }
  .worklife__crumb {
    display: flex; gap: 8px; padding: 10px 14px; background: var(--ink); color: var(--paper);
    font-size: 9px; font-weight: 900; letter-spacing: .12em;
  }
  .worklife__mast {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .45fr);
    min-height: 680px; border-bottom: 2px solid var(--ink); background: var(--acid);
  }
  .worklife__name {
    display: flex; flex-direction: column; justify-content: center; padding: 34px 26px;
    border-right: 2px solid var(--ink); font-size: clamp(115px, 19vw, 285px); font-weight: 950;
    line-height: .69; letter-spacing: -.105em; overflow: hidden;
  }
  .worklife__name span:last-child { color: var(--blue); transform: translateX(8%); }
  .worklife__slash {
    position: absolute; left: 56%; top: 43%; z-index: 2; color: var(--orange);
    font-size: clamp(180px, 28vw, 430px); font-weight: 950; line-height: .6; transform: rotate(10deg);
  }
  .worklife__mission { display: flex; flex-direction: column; justify-content: flex-end; gap: 24px; padding: clamp(28px, 4vw, 58px); }
  .worklife__mission p { margin: 0; font-size: 16px; line-height: 1.35; }
  .worklife__mission > p:first-child { font-size: 9px; font-weight: 900; letter-spacing: .12em; }
  .worklife__mission h1 { margin: auto 0 0; font-size: clamp(38px, 4.8vw, 74px); line-height: .94; letter-spacing: -.055em; }
  .worklife__opener { display: grid; grid-template-columns: minmax(340px, .9fr) minmax(0, 1.1fr); border-bottom: 2px solid var(--ink); }
  .worklife__cover { position: relative; display: block; min-width: 0; border-right: 2px solid var(--ink); background: var(--acid); }
  .worklife__cover img { display: block; width: 100%; height: 100%; min-height: 660px; object-fit: cover; }
  .worklife__cover span { position: absolute; right: 16px; bottom: 16px; padding: 11px 14px; background: var(--ink); color: var(--paper); font-size: 10px; font-weight: 900; }
  .worklife__opener-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(30px, 6vw, 90px); }
  .worklife__opener-copy > p:first-child { margin: 0 0 18px; font-size: 10px; font-weight: 900; letter-spacing: .09em; }
  .worklife__opener-copy h2 { margin: 0; font-size: clamp(58px, 8vw, 122px); line-height: .83; letter-spacing: -.075em; }
  .worklife__opener-copy h2 em { display: block; color: var(--orange); font-style: normal; }
  .worklife__opener-copy > p:not(:first-child) { max-width: 760px; margin: 28px 0 0; font-size: 20px; line-height: 1.36; }
  .worklife__opener-copy blockquote { margin: 30px 0; padding: 20px 24px; border-left: 8px solid var(--blue); background: #fff; font-size: 18px; line-height: 1.4; }
  .worklife__opener-copy dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border: 2px solid var(--ink); }
  .worklife__opener-copy dl div { padding: 14px; }
  .worklife__opener-copy dl div + div { border-left: 2px solid var(--ink); }
  .worklife__opener-copy dt { font: 800 9px var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .worklife__opener-copy dd { margin: 5px 0 0; font-size: 20px; font-weight: 850; }
  .worklife__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .worklife__actions a { padding: 12px 14px; border: 2px solid var(--ink); font: 900 10px var(--pc-font-mono); text-decoration: none; }
  .worklife__actions a:first-child { background: var(--ink); color: var(--paper); }
  .worklife__desks { display: grid; grid-template-columns: minmax(290px, .6fr) minmax(0, 1.4fr); border-bottom: 2px solid var(--ink); }
  .worklife__desks > header { padding: clamp(32px, 5vw, 72px); border-right: 2px solid var(--ink); background: var(--blue); color: var(--paper); }
  .worklife__desks header > p:first-child { margin: 0; font-size: 9px; font-weight: 900; letter-spacing: .1em; }
  .worklife__desks h2 { margin: 26px 0; font-size: clamp(48px, 6vw, 86px); line-height: .88; letter-spacing: -.06em; }
  .worklife__desks header > p:last-child { margin: 0; font-size: 18px; line-height: 1.4; }
  .worklife__desks ol { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; padding: 0; list-style: none; }
  .worklife__desks li { min-height: 230px; padding: 30px; border-bottom: 2px solid var(--ink); }
  .worklife__desks li:nth-child(odd) { border-right: 2px solid var(--ink); }
  .worklife__desks li:nth-last-child(-n+2) { border-bottom: 0; }
  .worklife__desks li > span { color: var(--orange); font-size: 11px; font-weight: 900; }
  .worklife__desks h3 { margin: 48px 0 10px; font-size: 34px; letter-spacing: -.045em; }
  .worklife__desks li p { margin: 0; max-width: 44ch; font-size: 15px; line-height: 1.45; }
  .worklife__promise { display: grid; grid-template-columns: .75fr 1.25fr; border-bottom: 2px solid var(--ink); background: var(--acid); }
  .worklife__promise > div { padding: clamp(32px, 5vw, 68px); border-right: 2px solid var(--ink); }
  .worklife__promise p { margin: 0; font-size: 9px; font-weight: 900; letter-spacing: .1em; }
  .worklife__promise h2 { margin: 24px 0 0; font-size: clamp(48px, 6vw, 88px); line-height: .88; letter-spacing: -.065em; }
  .worklife__promise ol { margin: 0; padding: 0; list-style: none; }
  .worklife__promise li { display: grid; grid-template-columns: 70px 1fr; align-items: center; min-height: 95px; padding: 0 26px; border-bottom: 2px solid var(--ink); }
  .worklife__promise li:last-child { border-bottom: 0; }
  .worklife__promise b { color: var(--orange); font: 900 14px var(--pc-font-mono); }
  .worklife__promise span { font-size: 17px; font-weight: 750; }
  .worklife__next { padding: clamp(42px, 7vw, 110px); border-bottom: 2px solid var(--ink); }
  .worklife__next > p:first-child { margin: 0; font-size: 9px; font-weight: 900; letter-spacing: .11em; }
  .worklife__next h2 { max-width: 1200px; margin: 34px 0; font-size: clamp(42px, 6.3vw, 96px); line-height: .94; letter-spacing: -.06em; }
  .worklife__next > p:last-child { max-width: 760px; margin: 0; font-size: 17px; line-height: 1.45; }
  .worklife__footer { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding: 28px; background: var(--ink); color: var(--paper); }
  .worklife__footer p { margin: 0; font-size: 13px; line-height: 1.45; }
  .worklife__footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 16px; font: 800 10px var(--pc-font-mono); }
  @media (max-width: 900px) {
    .worklife__mast { grid-template-columns: 1fr; min-height: 0; }
    .worklife__name { min-height: 500px; border-right: 0; border-bottom: 2px solid var(--ink); }
    .worklife__slash { left: auto; right: 5%; top: 25%; }
    .worklife__mission { min-height: 390px; }
    .worklife__opener, .worklife__desks, .worklife__promise { grid-template-columns: 1fr; }
    .worklife__cover, .worklife__desks > header, .worklife__promise > div { border-right: 0; border-bottom: 2px solid var(--ink); }
    .worklife__cover img { min-height: 0; }
  }
  @media (max-width: 620px) {
    .worklife { width: calc(100% - 12px); margin: 6px auto 24px; }
    .worklife__mast { min-height: 0; }
    .worklife__name { min-height: 350px; padding: 24px 14px; font-size: clamp(86px, 27vw, 150px); }
    .worklife__mission { min-height: 340px; padding: 26px 20px; }
    .worklife__opener-copy { padding: 38px 20px; }
    .worklife__opener-copy h2 { font-size: clamp(55px, 19vw, 88px); }
    .worklife__opener-copy dl { grid-template-columns: 1fr; }
    .worklife__opener-copy dl div + div { border-left: 0; border-top: 2px solid var(--ink); }
    .worklife__desks ol { grid-template-columns: 1fr; }
    .worklife__desks li, .worklife__desks li:nth-child(odd), .worklife__desks li:nth-last-child(-n+2) { border-right: 0; border-bottom: 2px solid var(--ink); }
    .worklife__desks li:last-child { border-bottom: 0; }
    .worklife__promise li { grid-template-columns: 48px 1fr; padding: 14px 18px; }
    .worklife__footer { grid-template-columns: 1fr; }
    .worklife__footer nav { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
  @media print {
    :global(body) { background: #fff; }
    .worklife { width: 100%; margin: 0; border: 0; }
    .worklife__actions, .worklife__footer nav { display: none; }
  }
</style>
