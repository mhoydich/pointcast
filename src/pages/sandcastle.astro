---
/**
 * /sandcastle — hold back the tide.
 *
 * A Missile Command (Atari, 1980, designed by Dave Theurer) made innocent:
 * six sandcastles and three bucket brigades on the beach, thin wave lines
 * running down from the sea, sand bursts that open and close to stop them.
 * Wave two of the Cabinet Row games, directed by Michael Hoydich.
 *
 * Drawn in vector style (thin lines and circles) over the machine palettes
 * of src/lib/breakwater/waves.mjs, lettered with the shared 3x5 font, every
 * sound synthesized in the browser. Pure rules live in
 * src/lib/sandcastle/shore.mjs and are covered by tests/sandcastle.test.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';

const description = 'Hold back the tide: six sandcastles, three bucket brigades and thin wave lines running down from the sea. Throw sand bursts to stop them, in Atari 800XL or Commodore 64 blue with synthesized chip sound and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/sandcastle';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Sandcastle',
      alternateName: 'Sandcastle: hold back the tide',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/sandcastle/og.png',
      gamePlatform: 'Web browser',
      genre: 'Shoot-em-up',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Cabinet Row', item: 'https://pointcast.xyz/cabinet-row' },
        { '@type': 'ListItem', position: 4, name: 'Sandcastle', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Sandcastle"
  description={description}
  image="/images/sandcastle/og.png"
  imageAlt="A blue playfield drawn in thin lines: wave lines running down from the sea toward six sandcastles and three buckets, with round sand bursts opening in the air, beside the words Sandcastle, hold back the tide."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/sandcastle.json', title: 'Sandcastle rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/sandcastle/og.png',
    buttons: [
      { label: 'Play Sandcastle', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="sc" data-sc data-machine="xl" data-crt="on">
    <div class="sc-stage" data-stage>
      <header class="sc-bar">
        <a class="sc-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="sc-name" aria-hidden="true">SANDCASTLE</span>
        <div class="sc-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (X)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (Z)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="sc-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Sandcastle playfield. Tap or click where a wave line is heading to throw a sand burst there."></canvas>
        <div class="sc-scan" aria-hidden="true"></div>
        <noscript><p class="sc-noscript">Sandcastle needs JavaScript to draw the beach and make its sounds. The rules and moods are readable at <a href="/sandcastle.json">/sandcastle.json</a>.</p></noscript>
      </div>
      <footer class="sc-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-round>ROUND 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-sand>SAND 10 10 10</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="sc-notes">
      <p class="sc-eyebrow">PointCast / Games / Cabinet Row / Sandcastle</p>
      <h1>Hold back the tide.</h1>
      <p class="sc-lede">Six sandcastles, three bucket brigades and a sea that keeps sending thin wave lines up the beach. Throw sand where a line is going; the burst opens, holds and closes, and stops whatever runs into it.</p>

      <div class="sc-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Every wave line you stop raises its <strong>energy</strong>, and three in one burst raises it more. A castle washed away lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="sc-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major arpeggio, slightly wider bursts.</li>
            <li><b>FLOW</b> a run of saves. Bright lines, the music opens up.</li>
            <li><b>RUSH</b> hot colors and raster bars in the border, a faster tempo, more lines that split, and now and then a fast rogue wave.</li>
            <li><b>DRIFT</b> after a castle falls. The lines slow, the bursts open wider, the notes thin out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.id === 'calm' ? 'castles rebuild at the end of every round and the game never ends' : d.id === 'play' ? 'six castles, one rebuilt every 10,000 points' : 'starts hot, leans into the splits'}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave after a game, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue lines. Raw square waves with a noise bite, in the POKEY spirit. A READY and a RUN before the beach.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. The banner, LOAD and RUN before the beach.'}</p>
          ))}
          <p>Sandcastle is a tribute to Missile Command, the 1980 Atari arcade game designed by Dave Theurer: three bases, six cities, an end-of-wave bonus for what is left. Here the cities are sandcastles and the bases are buckets, and nothing is emulated or copied. The lines, the font, the music and the palettes were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-sandcastle-notes.md">research note on the original</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Each brigade holds ten handfuls of sand a round, and the middle one throws fastest. A wave line stopped is 25 points, a rogue wave 125. A wave line that reaches a castle washes it away; one that reaches a bucket empties it until the next round. When a round's waves are spent, every castle standing is worth 100 and every handful left 5, all times the round's multiplier, which climbs every second round to six. A castle is rebuilt every 10,000 points. The game ends when the last castle goes, except on CALM.</p>
          <h2>Controls</h2>
          <ul>
            <li>Tap or click where a wave line is heading: the nearest brigade with sand throws there.</li>
            <li>Keys: arrows or W A S D move the crosshair, Space throws from the nearest brigade, 1, 2 and 3 throw from the left, middle and right one. P pauses, F full screen, M sound, C scanlines, X switches machines, Z turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="sc-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026, as one of the five wave-two Cabinet Row games. Original code, art and synthesized sound; no ROMs, no recordings. Missile Command, Atari and the machine names are named as tributes only.</p>
        <p><a href="/cabinet-row">Cabinet Row</a> · <a href="/breakwater">Breakwater</a> · <a href="/sandcastle.json">sandcastle.json</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .sc { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .sc[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .sc-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .sc-stage:fullscreen { height: 100%; min-height: 0; }
  .sc-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .sc-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .sc-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .sc-home:hover { color: #fff; }
  .sc-name { color: #fff; font-weight: 700; margin-right: auto; }
  .sc-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; margin-left: auto; }
  .sc-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .sc-controls button:hover { background: #1f2456; }
  .sc-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .sc-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .sc-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .sc-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sc-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .sc[data-crt='off'] .sc-scan { display: none; }
  .sc-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .sc-noscript a { color: var(--paddle); }
  .sc-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .sc-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .sc-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .sc-readout a:hover { color: #fff; }
  .sc-stage:fullscreen .sc-readout a { display: none; }
  .sc-stage:-webkit-full-screen .sc-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sc-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .sc-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .sc-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .sc-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .sc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .sc-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .sc-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .sc-grid h2 + h2, .sc-grid p + h2, .sc-grid ul + h2 { margin-top: 22px; }
  .sc-grid p { margin: 0 0 12px; }
  .sc-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .sc-grid li { margin-bottom: 6px; }
  .sc-moods { list-style: none; padding: 0; }
  .sc-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .sc-notes a { color: #a9b9f5; }
  .sc-notes a:hover { color: #fff; }
  .sc-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .sc-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .sc-stage { min-height: 0; }
    .sc-bar { gap: 8px; padding: 6px 10px; }
    .sc-name { display: none; }
    .sc-controls { gap: 4px; }
    .sc-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .sc-readout { gap: 10px; font-size: 9px; height: 26px; }
    .sc-readout [data-r-fps], .sc-readout [data-r-tempo] { display: none; }
    .sc-grid { grid-template-columns: 1fr; gap: 20px; }
    .sc-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .sc-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import {
    W, H_MIN, H_MAX, HUD, SEA_Y, SAND_PER_BRIGADE, createGame, startRound, takeEvents, step, roundDone, endRound,
    throwSand, setCalm, setHeight, autoAim, clampTarget, groundY,
  } from '../lib/sandcastle/shore.mjs';

  const root = document.querySelector('[data-sc]');
  if (root) main(root);

  function main(root) {
    let H = H_MIN;
    const STORE = 'sandcastle:v1';
    const CROSS_SPEED = 190;
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      round: root.querySelector('[data-r-round]'),
      fps: root.querySelector('[data-r-fps]'),
      sand: root.querySelector('[data-r-sand]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) && settings.best > 0 ? Math.floor(settings.best) : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    /** What the game does with the mood: line speed, burst size and the RUSH extras. */
    const tune = () => ({ speed: response.speed * (response.label === 'DRIFT' ? 0.85 : 1), burst: response.paddle, rush: response.label === 'RUSH' });

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      const PROG = {
        major: [[60, 64, 67, 72], [57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67]],
        bright: [[60, 64, 67, 71], [62, 66, 69, 74], [65, 69, 72, 76], [67, 71, 74, 78]],
        minor: [[57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67], [57, 60, 64, 69]],
        soft: [[60, 67, 72, 76], [53, 60, 65, 69], [57, 64, 69, 72], [55, 62, 67, 71]],
      };
      const ARP = [0, 2, 1, 3, 2, 1, 3, 0];
      const PENTA = [0, 2, 4, 7, 9, 12, 14, 16, 19, 21, 24];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, freq = 2400, q = 0.8) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = q;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        if (idx % 8 === 0) voice({ freq: midi(chord[0] - 24), type: bass(), t, dur: 0.24, vol: 0.18, dest: music, r: 0.08 });
        const gate = scale === 'soft' ? 0.32 : 0.5 + density * 0.45;
        if (Math.random() < gate) {
          const n = chord[ARP[idx % ARP.length]] + (scale === 'minor' && idx % 4 === 2 ? 12 : 0);
          voice({ freq: midi(n), type: 'square', t, dur: scale === 'soft' ? 0.2 : 0.09, vol: scale === 'soft' ? 0.08 : 0.1, dest: music, r: 0.04, detune: machineId === 'xl' ? 4 : 0 });
        }
        if (scale === 'minor' && (idx === 4 || idx === 12)) noise(t, 0.03, 0.05);
      }
      function schedule() {
        if (!ac || !musicOn) return;
        // A throttled interval (hidden tab) must not replay every missed step as one burst.
        if (nextNote < ac.currentTime - 0.1) { nextNote = ac.currentTime + 0.05; step += 1; }
        while (nextNote < ac.currentTime + 0.14) {
          playStep(step, nextNote);
          nextNote += 60 / tempo / 4;
          step += 1;
        }
      }
