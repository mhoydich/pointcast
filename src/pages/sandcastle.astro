      for (const f of G.floats) { ctx.globalAlpha = alpha * (1 - f.t / 0.8); text(f.text, f.x, Math.round(f.y) - 10, 1, m.bright, 'center'); }
      ctx.globalAlpha = 1;
    }
    function drawCross() {
      const m = M();
      const { x, y } = G.cross;
      ctx.strokeStyle = m.bright; ctx.lineWidth = 1;
      line(x - 6, y, x - 2, y); line(x + 2, y, x + 6, y); line(x, y - 6, x, y - 2); line(x, y + 2, x, y + 6);
    }
    function drawHud() {
      const m = M();
      const S = G.S;
      text(String(S ? S.score : 0).padStart(6, '0'), 6, 8, 3, m.bright);
      const label = G.attract ? 'ATTRACT' : response.label;
      const col = legible(G.attract || label === 'DRIFT' ? m.text : label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : m.bands.green);
      text(label, W / 2 + 14, 11, 2, col, 'center');
      if (!G.attract && S) text(DIALS[mood.dial].unlimitedBalls ? 'CALM' : `X${S.plan.multiplier}`, W - 6, 11, 2, soft(), 'right');
      // Mood tape along the bottom of the score bar.
      if (!G.attract && mood.tape.length) {
        const n = Math.min(60, mood.tape.length), start = mood.tape.length - n;
        for (let i = 0; i < n; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(6 + i * 3, HUD - 4, 2, 2);
        }
      }
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const ln of G.boot.lines) {
        if (left <= 0) break;
        const shown = ln.slice(0, Math.min(ln.length, left));
        text(shown, 10, y, 2, m.text);
        left -= ln.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    /** `color` lifted toward white until it reads at 4.5:1 or better on the field, for every in-field word. */
    const legibleCache = new Map();
    const luminance = (c) => { const v = (Array.isArray(c) ? c : hex(c)).map((x) => x / 255).map((x) => (x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4)); return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]; };
    function legible(color) {
      const field = M().field, key = `${field}${color}`;
      if (legibleCache.has(key)) return legibleCache.get(key);
      const lf = luminance(field);
      let out = color;
      for (let t = 0; t <= 1.001; t += 0.05) {
        const A = hex(color), c = A.map((x) => Math.round(x + (255 - x) * t));
        const lc = luminance(c);
        if ((Math.max(lc, lf) + 0.05) / (Math.min(lc, lf) + 0.05) >= 4.6) { out = rgb(c); break; }
        out = rgb(c);
      }
      legibleCache.set(key, out);
      return out;
    }
    const soft = () => legible(M().text);
    const blinkOn = () => REDUCED || Math.floor(G.t * 2) % 2 === 0;
    function drawTitle() {
      const m = M();
      drawSea(0.5); drawPlay(0.3); drawBeach(0.45);
      rainbowText('SANDCASTLE', W / 2, 84, 6, [m.bands.red, m.bands.orange, m.bands.yellow, m.bands.green]);
      text('HOLD BACK THE TIDE', W / 2, 128, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 150, 2, m.bright, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 166, 2, m.bright, 'center');
      if (blinkOn()) text(COARSE ? 'TAP TO PLAY' : 'CLICK OR PRESS SPACE', W / 2, 212, 2, m.paddle, 'center');
      text(COARSE ? 'TAP WHERE THE WAVES GO' : 'AIM AHEAD OF THE WAVES', W / 2, 232, 2, m.bright, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, 256, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, groundY(G.S) - 44, 2, soft(), 'center');
    }
    function drawTally() {
      const m = M(); const r = G.tally; if (!r) return;
      const shown = Math.min(1, G.t / 1.4);
      text(`ROUND ${r.round} DONE`, W / 2, 112, 3, m.bright, 'center');
      text(`CASTLES ${r.standing} X ${100 * r.mult}`, W / 2, 146, 2, m.bands.yellow, 'center');
      text(`SAND ${Math.round(r.sand * shown)} X ${5 * r.mult}`, W / 2, 162, 2, m.bright, 'center');
      text(`BONUS ${Math.round(r.bonus * shown)}`, W / 2, 182, 2, m.paddle, 'center');
      if (r.allStanding) text('EVERY CASTLE STANDING', W / 2, 204, 2, legible(m.bands.green), 'center');
      if (r.rebuilt) text(r.rebuilt > 1 ? `${r.rebuilt} CASTLES REBUILT` : 'CASTLE REBUILT', W / 2, 220, 2, m.bright, 'center');
    }
    function drawOver() {
      const m = M();
      text('THE TIDE IS IN', W / 2, 104, 3, m.bright, 'center');
      text('GAME OVER', W / 2, 128, 4, m.bright, 'center');
      text(`SCORE ${String(G.S.score).padStart(6, '0')}`, W / 2, 166, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 182, 2, m.bands.yellow, 'center');
      text(`ROUND ${G.S.round}  PEAK ${mood.peak}`, W / 2, 198, 2, soft(), 'center');
      if (blinkOn() && G.t > 0.6) text(COARSE ? 'TAP TO PLAY AGAIN' : 'CLICK OR SPACE TO PLAY AGAIN', W / 2, 236, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      ctx.save();
      ctx.beginPath(); ctx.rect(0, 0, W, H); ctx.clip();
      if (G.phase === 'boot') { drawBoot(); ctx.restore(); return; }
      drawField();
      drawHud();
      if (G.phase === 'title') { drawTitle(); ctx.restore(); return; }
      const m = M();
      drawSea(1);
      if (G.phase === 'over') { drawPlay(0.22); drawBeach(0.4); drawOver(); ctx.restore(); return; }
      drawPlay(1); drawBeach(1);
      if (G.phase === 'play' || G.phase === 'paused') drawCross();
      if (G.phase === 'tally') drawTally();
      if (G.phase === 'play' && G.banner > 0) {
        text(`ROUND ${G.S.round}`, W / 2, 120, 4, m.bright, 'center');
        if (G.S.plan.multiplier > 1) text(`X${G.S.plan.multiplier} POINTS`, W / 2, 148, 2, m.paddle, 'center');
        if (G.S.round === 1) text(COARSE ? 'TAP WHERE THE WAVES GO' : 'CLICK, SPACE OR 1 2 3', W / 2, 164, 2, m.paddle, 'center');
      }
      if (G.phase === 'lost') { text('THE LAST CASTLE', W / 2, 140, 2, m.bright, 'center'); text('IS GONE', W / 2, 156, 2, m.bright, 'center'); }
      if (G.phase === 'paused') { text('PAUSED', W / 2, 150, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 180, 2, m.paddle, 'center'); }
      if (G.msgT > 0 && G.msg && G.phase === 'play' && G.banner <= 0) text(G.msg, W / 2, 196, G.msgScale, m.bright, 'center');
      ctx.restore();
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        readout.mood.textContent = `${G.attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${G.attract ? 104 : response.tempo} BPM ${G.attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.sand.textContent = G.S && !G.attract ? `SAND ${G.S.brigades.map((b) => (b.washed ? '--' : String(b.sand).padStart(2, '0'))).join(' ')}` : `SAND ${SAND_PER_BRIGADE} ${SAND_PER_BRIGADE} ${SAND_PER_BRIGADE}`;
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    /** One gesture: skip the boot, start a game, resume, or throw sand at the crosshair from `brigade` (null: the nearest). */
    function action(brigade = null) {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return; }
      if (G.phase === 'title' || (G.phase === 'over' && G.t > 0.6)) { newGame(); return; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); return; }
      if (G.phase === 'play') throwSand(G.S, brigade, G.cross.x, G.cross.y, G.hue++);
    }
    canvas.addEventListener('pointermove', (e) => {
      if (G.attract || !G.S) return;
      const p = pointerToField(e);
      G.cross = clampTarget(G.S, p.x, p.y);
    });
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      // The tap that moves the crosshair also throws, from the new position.
      if (!G.attract && G.S) { const p = pointerToField(e); G.cross = clampTarget(G.S, p.x, p.y); }
      action(null);
      // Throw events from a tap play their sound now, before the next frame.
      if (G.S && !G.attract) handle(takeEvents(G.S));
    });
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    const MOVE_KEYS = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'KeyA', 'KeyD', 'KeyW', 'KeyS']);
    const BRIGADE_KEYS = { Digit1: 0, Digit2: 1, Digit3: 2, Numpad1: 0, Numpad2: 1, Numpad3: 2 };
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; arrows and letters still reach the game from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (MOVE_KEYS.has(k)) { G.keys[k] = true; e.preventDefault(); audio.unlock(); return; }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); if (!e.repeat) action(null); handle(takeEventsSafe()); return; }
      if (k in BRIGADE_KEYS) { if (!e.repeat) action(BRIGADE_KEYS[k]); handle(takeEventsSafe()); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'KeyX') { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); return; }
      if (k === 'KeyZ') { audio.unlock(); cycleDial(); }
    });
    const takeEventsSafe = () => (G.S && !G.attract ? takeEvents(G.S) : []);
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function togglePause() {
      if (G.phase === 'play' || G.phase === 'tally') { G.resume = G.phase; G.phase = 'paused'; audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        G.keys = {};
        if (G.phase === 'play' || G.phase === 'tally') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', () => { G.keys = {}; });
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    const DIAL_NOTES = {
      calm: 'Castles rebuild every round and the game never ends.',
      play: 'Six castles, one rebuilt every 10,000 points.',
      rush: 'Starts hot. More lines split, and rogue waves come in.',
    };
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      // A game in progress follows the dial; a final loss already in its pause stays final.
      if (G.S && !G.attract) { setCalm(G.S, DIALS[next].unlimitedBalls); handle(takeEvents(G.S)); }
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${DIAL_NOTES[next]}`);
      if (G.phase === 'play') showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space throws again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
