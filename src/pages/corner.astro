---
import '../styles/corner-engineering.css';

const title = 'Corner Engineering Pulse V3 — PointCast';
const description = 'A playful mission layer for traceable engineering signals, crew quests, workcell check-ins, and digital-thread momentum.';
const facilities = [
  { id: 'fal', code: 'BLDG 40-26', name: 'Final Assembly', people: 184, status: 'nominal', x: 31, y: 34, color: '#25d996' },
  { id: 'ironbird', code: 'LAB 9C', name: 'Flight Controls Integration', people: 42, status: 'attention', x: 68, y: 31, color: '#ffb11b' },
  { id: 'wing', code: 'CWC-04', name: 'Composite Wing Cell', people: 89, status: 'nominal', x: 44, y: 69, color: '#63a7ff' },
  { id: 'ramp', code: 'RAMP N7', name: 'Flight Test Ramp', people: 27, status: 'restricted', x: 79, y: 72, color: '#ff6257' },
  { id: 'supplier', code: 'NODE S-12', name: 'Supplier Integration', people: 16, status: 'nominal', x: 19, y: 78, color: '#ac8cff' },
];
const signals = [
  { kind: 'handoff', glyph: '↪', color: '#63a7ff', author: 'Priya Nair', initials: 'PN', role: 'Flight controls · shift lead', time: '6m', facility: 'LAB 9C · Flight Controls Integration', body: 'Iron-bird run 24-117 stopped at step 6.3 after a transient disagreement on channel B. Hardware is safe. Recorder package and annotated bus trace are attached to the handoff; next shift should reproduce at the cold-start boundary before swapping the LRU.', refs: ['TST-24-117','SYS-FC-8842','LOG-6C91'], replies: 8, acks: 14, priority: 'P2' },
  { kind: 'change', glyph: '△', color: '#ac8cff', author: 'Marcus Lee', initials: 'ML', role: 'Structures · stress', time: '18m', facility: 'CWC-04 · Composite Wing Cell', body: 'Actuator-bracket FEM baseline C is ready for peer review. Margin moved +0.07 after the fastener preload correction; no geometry delta. Compare against the released load envelope, not yesterday’s local export.', refs: ['CHG-7714','MBSE-221.4','BASE-C'], replies: 4, acks: 22 },
  { kind: 'hazard', glyph: '!', color: '#ff6257', author: 'Alina Sorensen', initials: 'AS', role: 'Quality engineering', time: '27m', facility: 'BLDG 40-26 · Final Assembly', body: 'Tool-control boundary at station 31 is temporarily narrowed during overhead access. The condition is controlled and placarded. Treat the east aisle as one-way until the 15:00 verification walk closes the mitigation.', refs: ['HAZ-0429','CTRL-188','AREA-ST31'], replies: 11, acks: 37, priority: 'P1' },
  { kind: 'test', glyph: '✓', color: '#25d996', author: 'Dev Patel', initials: 'DP', role: 'Loads & dynamics', time: '41m', facility: 'CWC-04 · Composite Wing Cell', body: 'Acoustic-fatigue coupon series cleared the 30k-cycle gate. Correlation is inside the predeclared band on all four channels. Raw data is immutable; the reduced packet is queued for model update review.', refs: ['TST-AF-443','DATA-77F2','V&V-GATE-3'], replies: 6, acks: 31 },
  { kind: 'ask', glyph: '?', color: '#ffb11b', author: 'Owen Hart', initials: 'OH', role: 'Manufacturing engineering', time: '58m', facility: 'NODE S-12 · Supplier Integration', body: 'Looking for the owner of the JT lightweight-view export used in supplier packet 12. The current file resolves the assembly but drops two datum labels. Need a provenance-confirmed replacement before 16:30 PT.', refs: ['ASK-1902','SUP-PKT-12','CFG-JT-88'], replies: 3, acks: 9 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://pointcast.xyz/corner" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://pointcast.xyz/images/og/corner-engineering-v3.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://pointcast.xyz/images/og/corner-engineering-v3.png" />
  </head>
  <body>
    <main class="engineering-shell">
      <header class="system-bar">
        <a class="system-brand" href="/apps" aria-label="Back to PointCast apps">
          <span class="corner-mark" aria-hidden="true"><i></i><i></i><i></i><b></b></span>
          <span><strong>CORNER</strong><small>ENGINEERING PULSE / V3 / POINTCAST</small></span>
        </a>
        <div class="system-context"><span class="concept-badge">CONCEPT SYSTEM · SYNTHETIC DATA</span><span class="secure-state"><i></i> MESH CONNECTED · 7 NODES</span></div>
        <label class="global-search"><span>⌕</span><input data-search placeholder="Search trace, asset, person…" aria-label="Search engineering signals" /><kbd>⌘ K</kbd></label>
        <button class="shift-chip" data-toast="Shift B handoff packet is current">SHIFT B <span>14:32 PT</span></button>
      </header>

      <aside class="nav-rail">
        <nav aria-label="Engineering modules">
          <a class="active" href="#pulse"><span>◉</span><b>Pulse</b><small>05</small></a>
          <button data-open-map><span>⌘</span><b>Map</b><small>05</small></button>
          <button data-toast="Asset graph loaded · 1,284 nodes"><span>◇</span><b>Assets</b><small>1.2k</small></button>
          <button data-filter="handoff"><span>↪</span><b>Handoffs</b><small>12</small></button>
          <button data-filter="hazard"><span>!</span><b>Risks</b><small class="risk-count">03</small></button>
          <button data-filter="change"><span>△</span><b>Baselines</b><small>08</small></button>
          <button data-missions><span>✦</span><b>Missions</b><small>03</small></button>
        </nav>
        <div class="rail-footer"><span class="avatar avatar-self">YO</span><b>YOU</b><i>•••</i></div>
      </aside>

      <section class="pulse-column" id="pulse" data-pulse>
        <div class="pulse-heading">
          <div><p class="mono-label">MISSION LAYER V3 / LIVE ENGINEERING CONTEXT</p><h1>Make the invisible work visible.</h1><p>Traceable engineering signals become shared missions—so crews can find context, close loops, and move the program together.</p></div>
          <button class="command-button" data-command>⌘ Command</button>
        </div>
        <div class="metric-strip" aria-label="Program status">
          <div><span>WORKCELLS ONLINE</span><strong>47 <i>/ 49</i></strong><small class="good">+2 since 06:00</small></div><div><span>OPEN HANDOFFS</span><strong>12</strong><small>3 due this shift</small></div><div><span>CONTROLLED RISKS</span><strong class="amber">03</strong><small>0 unmitigated</small></div><div><span>SIGNAL STREAK</span><strong><span data-streak>4</span> <i>DAYS</i></strong><small class="good"><span data-score>860</span> points</small></div>
        </div>

        <section class="mission-deck" aria-label="Crew missions" data-mission-deck>
          <header><div><span class="mono-label">CREW MISSIONS / THIS SHIFT</span><strong>Turn engineering follow-through into a team sport.</strong></div><span class="mission-score"><b data-score>860</b> SIGNAL PTS</span></header>
          <div class="mission-grid">
            <article style="--mission:#63a7ff" data-mission="cold-start" data-reward="36"><div class="mission-title"><span>◎</span><div><small>MISSION COLD-START</small><strong>Close the cold-start loop</strong></div><b data-progress>72%</b></div><p>Reproduce channel B, attach evidence, hand off cleanly</p><div class="mission-progress"><i style="width:72%"></i></div><footer><span><i>PN</i><i>ML</i><i>YO</i><b>+2</b></span><button data-boost>Boost +36</button></footer></article>
            <article style="--mission:#ac8cff" data-mission="trace-sprint" data-reward="48"><div class="mission-title"><span>◇</span><div><small>MISSION TRACE-SPRINT</small><strong>Trace sprint</strong></div><b data-progress>70%</b></div><p>Bring 10 active change packets to full trace coverage</p><div class="mission-progress"><i style="width:70%"></i></div><footer><span><i>AS</i><i>DP</i><i>YO</i><b>+3</b></span><button data-boost>Boost +48</button></footer></article>
            <article style="--mission:#25d996" data-mission="orbit-relay" data-reward="64"><div class="mission-title"><span>↗</span><div><small>MISSION ORBIT-RELAY</small><strong>Orbit relay</strong></div><b data-progress>54%</b></div><p>Connect five disciplines in one useful response chain</p><div class="mission-progress"><i style="width:54%"></i></div><footer><span><i>OH</i><i>PN</i><i>YO</i><b>+2</b></span><button data-boost>Boost +64</button></footer></article>
          </div>
        </section>
        <div class="filter-row" role="group" aria-label="Filter signals">
          <button class="selected" data-filter="all">All signals</button><button data-filter="handoff">Handoffs</button><button data-filter="hazard">Hazards</button><button data-filter="change">Changes</button><button data-filter="test">Tests</button><button data-filter="ask">Asks</button><span data-count>05 SIGNALS</span>
        </div>

        <section class="engineering-composer" aria-label="Publish engineering signal">
          <div class="composer-topline"><span class="avatar avatar-self">YO</span><div><span class="mono-label">PUBLISH TO</span><button class="facility-choice" data-open-map><i style="background:#ffb11b"></i><span data-facility-label>LAB 9C · Flight Controls Integration</span>⌄</button></div><span class="access-chip">INTERNAL · PROGRAM</span></div>
          <textarea data-draft maxlength="600" rows="3" placeholder="Share a handoff, test result, controlled risk, configuration change, or precise ask…"></textarea>
          <div class="composer-bottom"><div class="kind-selector" role="group" aria-label="Signal type"><button class="selected" data-kind="handoff" style="--kind:#63a7ff"><span>↪</span>Handoff</button><button data-kind="hazard" style="--kind:#ff6257"><span>!</span>Hazard</button><button data-kind="change" style="--kind:#ac8cff"><span>△</span>Change</button><button data-kind="test" style="--kind:#25d996"><span>✓</span>Test</button><button data-kind="ask" style="--kind:#ffb11b"><span>?</span>Ask</button></div><div class="publish-controls"><span data-draft-count>0/600</span><button data-publish disabled>Publish signal ↗</button></div></div>
        </section>

        <div class="signal-list" aria-live="polite" data-signal-list>
          {signals.map((signal) => (
            <article class={`signal-card signal-${signal.kind}`} data-signal data-kind-value={signal.kind} data-search-value={`${signal.author} ${signal.role} ${signal.facility} ${signal.body} ${signal.refs.join(' ')}`.toLowerCase()} style={`--signal:${signal.color}`}>
              <div class="signal-spine"><span>{signal.glyph}</span><i></i></div>
              <div class="signal-body">
                <header><span class="avatar">{signal.initials}</span><div class="identity"><strong>{signal.author}</strong><span>{signal.role}</span></div><div class="signal-context"><span class="kind-badge">{signal.kind}</span>{signal.priority && <span class={`priority priority-${signal.priority}`}>{signal.priority}</span>}<time>{signal.time}</time></div></header>
                <button class="facility-link" data-open-map><i style={`background:${signal.color}`}></i>{signal.facility}<span>↗</span></button>
                <p>{signal.body}</p>
                <div class="trace-row"><span>TRACE</span>{signal.refs.map((ref) => <button data-toast={`${ref} opened in the local trace view`}>{ref}</button>)}</div>
                <footer><button data-thread>◌ <span>{signal.replies}</span> thread</button><button data-ack>✓ <span>{signal.acks}</span> acknowledge</button><button data-save>◇ save</button><button data-copy={`TRACE ${signal.refs[0]} — ${signal.body}`}>↗ copy brief</button></footer>
              </div>
            </article>
          ))}
          <div class="empty-state" data-empty hidden><strong>No signals in this slice.</strong><span>Clear the search or open another engineering channel.</span></div>
        </div>
      </section>

      <aside class="context-panel" aria-label="Facility context map" data-map>
        <div class="context-heading"><div><span class="mono-label">LIVE FACILITY GRAPH</span><strong>Northwest engineering mesh</strong></div><button data-close-map aria-label="Close map">×</button></div>
        <div class="facility-map"><div class="grid-lines"></div><div class="runway runway-a"></div><div class="runway runway-b"></div><span class="map-axis axis-x">EAST / 047</span><span class="map-axis axis-y">NORTH / 122</span>
          {facilities.map((facility, index) => <button class={`facility-node status-${facility.status} ${index === 1 ? 'active' : ''}`} data-facility={facility.id} data-code={facility.code} data-name={facility.name} data-people={facility.people} data-color={facility.color} style={`left:${facility.x}%;top:${facility.y}%;--node:${facility.color}`}><i></i><span><strong>{facility.code}</strong><small>{facility.people} online</small></span></button>)}
          <div class="map-legend"><span><i class="nominal"></i>Nominal</span><span><i class="attention"></i>Attention</span><span><i class="restricted"></i>Restricted</span></div>
        </div>
        <section class="facility-card"><div class="facility-title"><span class="facility-icon" data-facility-icon style="background:#ffb11b">⌖</span><div><small data-selected-code>LAB 9C</small><h2 data-selected-name>Flight Controls Integration</h2><p>Systems test / connected workcell</p></div><span class="state state-attention">LIVE</span></div><div class="facility-stats"><div><span>PEOPLE</span><strong data-selected-people>42</strong></div><div><span>ENV</span><strong>70.1°F</strong></div><div><span>LINK</span><strong>98.82%</strong></div></div><button class="checkin-button" data-checkin>Check into workcell <span>+20 →</span></button></section>
        <section class="crew-constellation"><div class="panel-title"><span><i class="crew-dot"></i>CREW CONSTELLATION</span><small>4 IN ORBIT</small></div><div class="constellation-field" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b><b></b><b></b></div><div class="crew-list"><button data-crew="Priya"><span style="--crew:#63a7ff">PN</span><span><strong>Priya</strong><small>Controls</small></span><b>IN LAB</b></button><button data-crew="Marcus"><span style="--crew:#ac8cff">ML</span><span><strong>Marcus</strong><small>Structures</small></span><b>FOCUSED</b></button><button data-crew="Alina"><span style="--crew:#ff6257">AS</span><span><strong>Alina</strong><small>Quality</small></span><b>ON WALK</b></button><button data-crew="Dev"><span style="--crew:#25d996">DP</span><span><strong>Dev</strong><small>Loads</small></span><b>ONLINE</b></button></div><button class="rally-button" data-rally>Rally the crew <span>✦</span></button></section>
        <section class="telemetry-card"><div class="panel-title"><span><i></i>SYSTEM TELEMETRY</span><small>60 MIN</small></div><div class="spark-chart" aria-label="System telemetry chart">{Array.from({length:12}).map(() => <i></i>)}<b></b></div><div class="telemetry-values"><span><b>2.8 ms</b>mesh latency</span><span><b>1.2 GB/s</b>trace ingest</span><span><b>0</b>dropped packets</span></div></section>
        <section class="risk-queue"><div class="panel-title"><span><i class="risk-dot"></i>CONTROLLED RISK QUEUE</span><small>3 OPEN</small></div><button data-filter="hazard"><span class="risk-rank">2C</span><span><strong>Station 31 aisle control</strong><small>Mitigation active · verify 15:00</small></span><b>HAZ-0429</b></button><button data-toast="Risk RSK-221 opened"><span class="risk-rank amber-rank">1D</span><span><strong>Iron-bird channel B transient</strong><small>Reproduction queued · shift B</small></span><b>RSK-221</b></button></section>
      </aside>

      <nav class="mobile-nav" aria-label="Mobile engineering navigation"><button class="active" data-close-map><span>◉</span>Pulse</button><button data-open-map><span>⌘</span>Map</button><button class="mobile-compose" data-compose>＋</button><button data-filter="handoff"><span>↪</span>Handoffs</button><button data-filter="hazard"><span>!</span>Risks</button></nav>

      <div class="command-scrim" data-command-scrim hidden><section class="command-palette" role="dialog" aria-modal="true" aria-label="Engineering command palette"><header><span>⌕</span><input data-command-search placeholder="Jump to signal, facility, trace…" /><kbd>ESC</kbd></header><p>QUICK ROUTES</p><button data-filter="handoff"><span>↪</span><div><strong>Open shift handoffs</strong><small>12 active across the mesh</small></div><kbd>H</kbd></button><button data-filter="hazard"><span>!</span><div><strong>Open controlled risks</strong><small>3 mitigations under verification</small></div><kbd>R</kbd></button><button data-open-map><span>⌘</span><div><strong>Facility graph</strong><small>5 connected workcells</small></div><kbd>M</kbd></button><button data-filter="change"><span>△</span><div><strong>Configuration changes</strong><small>Baselines, deltas, approvals</small></div><kbd>C</kbd></button></section></div>
      <div class="toast" data-toast-output role="status" hidden></div>
    </main>

    <script is:inline>
      (() => {
        const $ = (s, root = document) => root.querySelector(s);
        const $$ = (s, root = document) => Array.from(root.querySelectorAll(s));
        const pulse = $('[data-pulse]'); const map = $('[data-map]'); const scrim = $('[data-command-scrim]');
        const output = $('[data-toast-output]'); let activeFilter = 'all'; let activeKind = 'handoff'; let selectedCode = 'LAB 9C';
        let score = { points: 860, streak: 4, boosts: {} }; try { score = { ...score, ...JSON.parse(localStorage.getItem('corner-v3-score') || '{}') }; } catch {}
        const renderScore = () => { $$('[data-score]').forEach(node => node.textContent = Number(score.points).toLocaleString()); $('[data-streak]').textContent = score.streak; $$('[data-mission]').forEach(card => { if (!score.boosts?.[card.dataset.mission]) return; const base = Number(card.querySelector('[data-progress]').textContent.replace('%','')); const progress = Math.min(100, base + 8); card.querySelector('[data-progress]').textContent = progress + '%'; card.querySelector('.mission-progress i').style.width = progress + '%'; card.querySelector('[data-boost]').textContent = 'Boosted ✓'; }); };
        const addScore = (points, streak = 0) => { score.points += points; score.streak += streak; localStorage.setItem('corner-v3-score', JSON.stringify(score)); renderScore(); };
        const toast = (message) => { output.textContent = message; output.hidden = false; clearTimeout(window.__cornerToast); window.__cornerToast = setTimeout(() => output.hidden = true, 2400); };
        const applyFilters = () => { const q = ($('[data-search]')?.value || '').trim().toLowerCase(); let count = 0; $$('[data-signal]').forEach(card => { const show = (activeFilter === 'all' || card.dataset.kindValue === activeFilter) && (!q || card.dataset.searchValue.includes(q)); card.hidden = !show; if (show) count++; }); $('[data-count]').textContent = String(count).padStart(2,'0') + ' SIGNALS'; $('[data-empty]').hidden = count > 0; $$('[data-filter]').forEach(button => button.classList.toggle('selected', button.dataset.filter === activeFilter)); };
        $$('[data-filter]').forEach(button => button.addEventListener('click', () => { activeFilter = button.dataset.filter; applyFilters(); pulse.classList.remove('mobile-hidden'); map.classList.remove('mobile-map-open'); scrim.hidden = true; }));
        $('[data-search]')?.addEventListener('input', applyFilters);
        $$('[data-toast]').forEach(button => button.addEventListener('click', () => toast(button.dataset.toast)));
        $$('[data-open-map]').forEach(button => button.addEventListener('click', () => { map.classList.add('mobile-map-open'); pulse.classList.add('mobile-hidden'); scrim.hidden = true; }));
        $$('[data-close-map]').forEach(button => button.addEventListener('click', () => { map.classList.remove('mobile-map-open'); pulse.classList.remove('mobile-hidden'); }));
        $$('[data-facility]').forEach(button => button.addEventListener('click', () => { $$('[data-facility]').forEach(node => node.classList.remove('active')); button.classList.add('active'); selectedCode = button.dataset.code; $('[data-selected-code]').textContent = button.dataset.code; $('[data-selected-name]').textContent = button.dataset.name; $('[data-selected-people]').textContent = button.dataset.people; $('[data-facility-label]').textContent = button.dataset.code + ' · ' + button.dataset.name; $('[data-facility-icon]').style.background = button.dataset.color; }));
        $$('[data-kind]').forEach(button => button.addEventListener('click', () => { activeKind = button.dataset.kind; $$('[data-kind]').forEach(item => item.classList.toggle('selected', item === button)); }));
        const draft = $('[data-draft]'); const publish = $('[data-publish]'); draft.addEventListener('input', () => { $('[data-draft-count]').textContent = draft.value.length + '/600'; publish.disabled = !draft.value.trim(); });
        publish.addEventListener('click', () => { const text = draft.value.trim(); if (!text) return; const card = document.createElement('article'); card.className = 'signal-card signal-' + activeKind; card.dataset.signal = ''; card.dataset.kindValue = activeKind; card.dataset.searchValue = text.toLowerCase(); card.style.setProperty('--signal', activeKind === 'hazard' ? '#ff6257' : '#63a7ff'); card.innerHTML = `<div class="signal-spine"><span>↗</span><i></i></div><div class="signal-body"><header><span class="avatar avatar-self">YO</span><div class="identity"><strong>You</strong><span>Engineering contributor</span></div><div class="signal-context"><span class="kind-badge">${activeKind}</span><time>now</time></div></header><button class="facility-link"><i style="background:#63a7ff"></i>${selectedCode}<span>↗</span></button><p></p><div class="trace-row"><span>TRACE</span><button>LOCAL-${String(Date.now()).slice(-4)}</button></div><footer><button>◌ <span>0</span> thread</button><button data-ack>✓ <span>0</span> acknowledge</button><button data-save>◇ save</button></footer></div>`; card.querySelector('p').textContent = text; $('[data-signal-list]').prepend(card); draft.value = ''; draft.dispatchEvent(new Event('input')); activeFilter = 'all'; applyFilters(); addScore(35, 1); toast(`${activeKind.toUpperCase()} published · +35 signal points`); });
        document.addEventListener('click', event => { const ack = event.target.closest('[data-ack]'); if (ack) { const n = ack.querySelector('span'); const active = ack.classList.toggle('acknowledged'); n.textContent = Math.max(0, Number(n.textContent) + (active ? 1 : -1)); } const save = event.target.closest('[data-save]'); if (save) { const active = save.classList.toggle('saved'); save.textContent = active ? '◆ saved' : '◇ save'; } const copy = event.target.closest('[data-copy]'); if (copy) navigator.clipboard?.writeText(copy.dataset.copy); if (event.target === scrim) scrim.hidden = true; });
        $('[data-command]').addEventListener('click', () => { scrim.hidden = false; $('[data-command-search]').focus(); }); $('[data-compose]').addEventListener('click', () => { pulse.classList.remove('mobile-hidden'); map.classList.remove('mobile-map-open'); draft.focus(); }); $('[data-checkin]').addEventListener('click', () => { addScore(20); toast(`Checked into ${selectedCode} · +20 signal points`); }); $('[data-thread]')?.addEventListener('click', () => toast('Thread view is staged for the shared backend'));
        $('[data-missions]').addEventListener('click', () => $('[data-mission-deck]').scrollIntoView({ behavior: 'smooth' }));
        $$('[data-boost]').forEach(button => button.addEventListener('click', () => { const card = button.closest('[data-mission]'); const id = card.dataset.mission; if (score.boosts?.[id]) return toast('Mission already boosted this shift · invite a crewmate next'); score.boosts = { ...(score.boosts || {}), [id]: 8 }; const reward = Number(card.dataset.reward); addScore(reward, 1); toast(`Mission boosted · +${reward} signal points`); }));
        $$('[data-crew]').forEach(button => button.addEventListener('click', () => toast(`${button.dataset.crew} pinged · context bundle attached`))); $('[data-rally]').addEventListener('click', () => toast('Crew rally opened · 3 context bundles ready'));
        renderScore();
        window.addEventListener('keydown', event => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); scrim.hidden = !scrim.hidden; if (!scrim.hidden) $('[data-command-search]').focus(); } if (event.key === 'Escape') scrim.hidden = true; });
      })();
    </script>
  </body>
</html>
