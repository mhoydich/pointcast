  // =========================================================
  //  GAME 4 · RHYTHM ECHO
  // =========================================================
  (() => {
    const STEP_FREQS = [220, 277, 330, 415]; // A3, C#4, E4, G#4 = pad colors
    let round = 0; let cur: number[] = []; // sequence of pad indices
    let userSeq: number[] = []; let listening = false; let active = false;
    let startCtxTime = 0; let stepDur = 0.50; // 120 BPM eighths-ish; gets faster

    function reset() {
      document.querySelectorAll('.ds__rhythm-step').forEach(s => s.className = 'ds__rhythm-step');
    }

    function playStep(idx: number, when: number, vel = 1) {
      playKick(when, 0.6 * vel);
      playSineNote(when, STEP_FREQS[idx], 0.18, 0.12 * vel);
    }

    function generateSeq(n: number): number[] {
      const out: number[] = [];
      for (let i = 0; i < n; i++) out.push(Math.floor(Math.random() * 4));
      return out;
    }

    async function startRound() {
      const c = ac(); if (c.state === 'suspended') await c.resume();
      reset();
      round++;
      if (round > 3) { finish(); return; }
      // Increasing length and speed
      const len = 3 + round; // 4, 5, 6
      stepDur = 0.55 - round * 0.05; // 0.50, 0.45, 0.40
      cur = generateSeq(len);
      userSeq = [];
      ($('rhythm-status') as HTMLParagraphElement).textContent = `Round ${round} of 3 · listen first (${len} steps)…`;
      ($('rhythm-status') as HTMLParagraphElement).className = 'ds__game-status';
      listening = true; active = false;
      // Schedule cue playback
      startCtxTime = c.currentTime + 0.4;
      cur.forEach((padIdx, i) => {
        const t = startCtxTime + i * stepDur;
        playStep(padIdx, t);
        // Visual cue on strip
        setTimeout(() => {
          const step = document.querySelector(`.ds__rhythm-step[data-step="${i}"]`) as HTMLElement;
          if (step) { step.classList.add('ds__rhythm-step--cue'); setTimeout(() => step.classList.remove('ds__rhythm-step--cue'), 200); }
          // Pad visual flash
          const pad = document.querySelector(`.ds__pad[data-pad="${padIdx}"]`) as HTMLButtonElement;
          if (pad) { pad.classList.add('ds__pad--press'); setTimeout(() => pad.classList.remove('ds__pad--press'), 140); }
        }, (t - c.currentTime) * 1000);
      });
      // After cue, open up player input
      setTimeout(() => {
        listening = false; active = true;
        ($('rhythm-status') as HTMLParagraphElement).textContent = `Your turn · echo the ${len} steps in time. Use mouse, touch, or keys A/S/D/F.`;
      }, (cur.length * stepDur + 0.4) * 1000);
    }

    function tapPad(idx: number) {
      if (!active) return;
      const c = ac();
      playStep(idx, c.currentTime, 1);
      // Visual
      const pad = document.querySelector(`.ds__pad[data-pad="${idx}"]`) as HTMLButtonElement;
      if (pad) { pad.classList.add('ds__pad--press'); setTimeout(() => pad.classList.remove('ds__pad--press'), 100); }
      const stepIdx = userSeq.length;
      userSeq.push(idx);
      const right = cur[stepIdx] === idx;
      const stepEl = document.querySelector(`.ds__rhythm-step[data-step="${stepIdx}"]`) as HTMLElement;
      if (stepEl) stepEl.classList.add(right ? 'ds__rhythm-step--player' : 'ds__rhythm-step--miss');
      if (userSeq.length >= cur.length) { active = false; setTimeout(() => evaluateRound(), 400); }
    }

    function evaluateRound() {
      const matches = cur.filter((c, i) => userSeq[i] === c).length;
      const allMatch = matches === cur.length;
      ($('rhythm-status') as HTMLParagraphElement).textContent = `${matches} / ${cur.length} steps correct ${allMatch ? '· echoed perfectly · next round →' : '· next round →'}`;
      ($('rhythm-status') as HTMLParagraphElement).className = 'ds__game-status ' + (allMatch ? 'ds__game-status--success' : 'ds__game-status--fail');
      if (!allMatch) { finishWithCount(round - 1); return; }
      setTimeout(() => startRound(), 1300);
    }

    function finishWithCount(roundsCompleted: number) {
      const earned = Math.min(3, Math.max(0, roundsCompleted));
      ($('rhythm-status') as HTMLParagraphElement).textContent = `Done · echoed ${roundsCompleted} of 3 rounds · ${earned ? '★'.repeat(earned) : 'no stars yet — try again'}`;
      ($('rhythm-status') as HTMLParagraphElement).className = 'ds__game-status ' + (earned >= 1 ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('rhythm-start') as HTMLButtonElement).disabled = false;
      ($('rhythm-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.rhythm)}${'☆'.repeat(3 - stars.rhythm)}`;
      active = false; round = 0;
      if (earned > 0) recordStars('rhythm', earned);
    }
    function finish() { finishWithCount(3); }

    function start() {
      round = 0;
      ($('rhythm-start') as HTMLButtonElement).disabled = true;
      startRound();
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('rhythm-start')?.addEventListener('click', start);
      // Rhythm pads — wire mousedown for low-latency mouse, touchstart for
      // touch (no 300ms click delay), AND a debounced fallback click handler
      // so keyboard Space/Enter on a focused pad still works (a11y, Codex).
      document.querySelectorAll<HTMLButtonElement>('#rhythm-pads .ds__pad').forEach(p => {
        let lastFire = 0;
        const fire = () => { const now = Date.now(); if (now - lastFire < 60) return; lastFire = now; tapPad(Number(p.dataset.pad)); };
        p.addEventListener('mousedown', fire);
        p.addEventListener('touchstart', (e) => { e.preventDefault(); fire(); }, { passive: false });
        // Click is the keyboard activation event for a focused button.
        // Browsers also fire it after mousedown — the debounce above stops doubles.
        p.addEventListener('click', fire);
      });
      document.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.tagName === 'INPUT' || (e.target as HTMLElement)?.tagName === 'BUTTON') return;
        const map: Record<string, number> = { 'a': 0, 's': 1, 'd': 2, 'f': 3 };
        const idx = map[e.key.toLowerCase()];
        if (idx !== undefined) { e.preventDefault(); tapPad(idx); }
      });
      ($('rhythm-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.rhythm)}${'☆'.repeat(3 - stars.rhythm)}`;
    });
  })();

  // =========================================================
  //  GAME 5 · KEY RECOGNITION
  // =========================================================
  (() => {
    const ROUNDS = 5;
    type Key = 'C' | 'F' | 'G' | 'D';
    const KEYS: Key[] = ['C', 'F', 'G', 'D'];
    // 4-note phrase per key: root · 3rd · 5th · octave (4 semis = major 3rd, 7 = 5th, 12 = octave).
    const ROOT_NOTE: Record<Key, string> = { C: 'C4', F: 'F4', G: 'G4', D: 'D4' };
    const KEY_NAMES: Record<Key, string> = { C: 'C major', F: 'F major', G: 'G major', D: 'D major' };

    let round = 0; let correct = 0;
    let cur: { key: Key; freqs: number[] } | null = null;
    let active = false; let replays = 0;

    function buildPhrase(k: Key) {
      const base = noteHz(ROOT_NOTE[k]);
      return [0, 4, 7, 12].map(s => base * Math.pow(2, s / 12));
    }

    function playPhrase(freqs: number[]) {
      const c = ac(); const t = c.currentTime + 0.05;
      const NOTE_DUR = 0.55; const STEP = 0.42;
      freqs.forEach((f, i) => playSineNote(t + i * STEP, f, NOTE_DUR, 0.16));
    }

    function enableChoices(on: boolean) {
      document.querySelectorAll<HTMLButtonElement>('#key-choices .ds__choice').forEach(b => {
        b.disabled = !on; b.classList.remove('ds__choice--correct', 'ds__choice--wrong');
      });
    }

    function nextRound() {
      round++;
      if (round > ROUNDS) { finish(); return; }
      const key = KEYS[Math.floor(Math.random() * KEYS.length)];
      cur = { key, freqs: buildPhrase(key) };
      replays = 0;
      ($('key-status') as HTMLParagraphElement).textContent = `Round ${round} of ${ROUNDS} · listen…`;
      ($('key-status') as HTMLParagraphElement).className = 'ds__game-status';
