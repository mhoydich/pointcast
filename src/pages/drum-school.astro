      ($('key-replay') as HTMLButtonElement).disabled = true;
      playPhrase(cur.freqs);
      // Phrase lasts ~4 * 0.42s. Open input shortly after.
      setTimeout(() => {
        if (cur) {
          ($('key-status') as HTMLParagraphElement).textContent = `Round ${round} of ${ROUNDS} · which key?`;
          ($('key-q') as HTMLParagraphElement).textContent = '?';
          enableChoices(true);
          ($('key-replay') as HTMLButtonElement).disabled = false;
          active = true;
        }
      }, 4 * 420 + 200);
    }

    function answer(k: Key) {
