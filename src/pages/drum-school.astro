      active = false;
      const right = k === cur.key;
      if (right) correct++;
      document.querySelectorAll<HTMLButtonElement>('#key-choices .ds__choice').forEach(b => {
        const kk = b.dataset.key as Key;
        if (kk === cur!.key) b.classList.add('ds__choice--correct');
        else if (kk === k) b.classList.add('ds__choice--wrong');
        b.disabled = true;
      });
      ($('key-replay') as HTMLButtonElement).disabled = true;
      ($('key-q') as HTMLParagraphElement).textContent = right ? `✓ ${KEY_NAMES[cur.key]}` : `✗ that was ${KEY_NAMES[cur.key]}`;
      ($('key-status') as HTMLParagraphElement).textContent = `Score · ${correct} / ${round}`;
      ($('key-status') as HTMLParagraphElement).className = 'ds__game-status ' + (right ? 'ds__game-status--success' : 'ds__game-status--fail');
      setTimeout(() => nextRound(), 1300);
    }

    function start() {
      const c = ac(); if (c.state === 'suspended') c.resume();
      round = 0; correct = 0;
      ($('key-start') as HTMLButtonElement).disabled = true;
      nextRound();
    }

    function finish() {
      const pct = correct / ROUNDS;
      const earned = pct === 1 ? 3 : pct >= 0.8 ? 2 : pct >= 0.6 ? 1 : 0;
      ($('key-status') as HTMLParagraphElement).textContent = `Done · ${correct} / ${ROUNDS} correct · ${earned ? '★'.repeat(earned) : 'no stars yet — try again'}`;
      ($('key-status') as HTMLParagraphElement).className = 'ds__game-status ' + (earned >= 1 ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('key-q') as HTMLParagraphElement).textContent = '—';
      ($('key-start') as HTMLButtonElement).disabled = false;
      ($('key-replay') as HTMLButtonElement).disabled = true;
      ($('key-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.key)}${'☆'.repeat(3 - stars.key)}`;
      enableChoices(false);
      if (earned > 0) recordStars('key', earned);
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('key-start')?.addEventListener('click', start);
      $('key-replay')?.addEventListener('click', () => {
        if (!cur || replays >= 1) return;
        replays++;
        playPhrase(cur.freqs);
        ($('key-replay') as HTMLButtonElement).disabled = true;
      });
      document.querySelectorAll<HTMLButtonElement>('#key-choices .ds__choice').forEach(b => b.addEventListener('click', () => answer(b.dataset.key as Key)));
      ($('key-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.key)}${'☆'.repeat(3 - stars.key)}`;
    });
  })();

  // =========================================================
  //  GAME 6 · TEMPO TAP
  // =========================================================
  (() => {
    const ROUNDS = 3;
    let round = 0; let bestEarnedThisRun = 0;
    let trueBPM = 0; let taps: number[] = []; let active = false;
    let cuePending = false;
    // Track scheduled cue oscillators + visual timers so a fast restart can
    // cancel them before scoring.
    let pendingTimers: number[] = [];
    let pendingNotes: AudioScheduledSourceNode[] = [];

    function clearPending() {
      pendingTimers.forEach(t => clearTimeout(t)); pendingTimers = [];
      pendingNotes.forEach(s => { try { s.stop(); } catch {} try { s.disconnect(); } catch {} });
      pendingNotes = [];
    }

    function playCuePhrase(bpm: number) {
      const c = ac();
      const beat = 60 / bpm;
      const start = c.currentTime + 0.4;
      // 8 ascending beats of C-major arpeggio at the cue tempo (root, 3rd, 5th, 8va · twice).
      const freqs = [noteHz('C4'), noteHz('E4'), noteHz('G4'), noteHz('C5'), noteHz('C4'), noteHz('E4'), noteHz('G4'), noteHz('C5')];
      for (let i = 0; i < 8; i++) {
        const when = start + i * beat;
        const o = c.createOscillator(); const g = c.createGain();
        o.type = 'triangle'; o.frequency.value = freqs[i];
        g.gain.setValueAtTime(0.001, when);
        g.gain.exponentialRampToValueAtTime(0.18, when + 0.04);
        g.gain.exponentialRampToValueAtTime(0.001, when + Math.min(beat * 0.9, 0.45));
        o.connect(g); g.connect(c.destination);
        o.start(when); o.stop(when + beat + 0.1);
        pendingNotes.push(o);
      }
      return start + 8 * beat;
    }

    function startTapWindow(bpm: number) {
      trueBPM = bpm; taps = []; active = true;
      ($('tempo-status') as HTMLParagraphElement).textContent = `Tap the big button on the beat · at least 4 taps · then press "lock in BPM".`;
      ($('tempo-q') as HTMLParagraphElement).textContent = '0 taps';
      ($('tempo-lock') as HTMLButtonElement).disabled = true;
    }

    async function startRound() {
      const c = ac(); if (c.state === 'suspended') await c.resume();
      clearPending();
      round++;
      if (round > ROUNDS) { finish(); return; }
      // Random BPM 60-160, integer.
      const bpm = Math.floor(60 + Math.random() * 101);
      ($('tempo-status') as HTMLParagraphElement).textContent = `Round ${round} of ${ROUNDS} · listen…`;
      ($('tempo-status') as HTMLParagraphElement).className = 'ds__game-status';
      ($('tempo-q') as HTMLParagraphElement).textContent = '· · · ·';
      ($('tempo-lock') as HTMLButtonElement).disabled = true;
      cuePending = true; active = false;
      const cueEnd = playCuePhrase(bpm);
      const c2 = ac();
      const tid = window.setTimeout(() => {
        cuePending = false;
        startTapWindow(bpm);
      }, Math.max(0, (cueEnd - c2.currentTime) * 1000));
      pendingTimers.push(tid);
    }

    function tap() {
      if (!active) return;
      taps.push(ac().currentTime);
      ($('tempo-q') as HTMLParagraphElement).textContent = `${taps.length} tap${taps.length === 1 ? '' : 's'}`;
      if (taps.length >= 4) {
        ($('tempo-lock') as HTMLButtonElement).disabled = false;
      }
    }

    function lockIn() {
      if (!active || taps.length < 4) return;
      active = false;
      // Average inter-tap interval.
      const intervals: number[] = [];
      for (let i = 1; i < taps.length; i++) intervals.push(taps[i] - taps[i - 1]);
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      const guess = Math.round(60 / avg);
      const errPct = Math.abs(guess - trueBPM) / trueBPM;
      const earned = errPct <= 0.05 ? 3 : errPct <= 0.15 ? 2 : errPct <= 0.30 ? 1 : 0;
      bestEarnedThisRun = Math.max(bestEarnedThisRun, earned);
      const status = $('tempo-status') as HTMLParagraphElement;
      status.textContent = `Round ${round} · your tempo · ${guess} BPM · true · ${trueBPM} BPM · ${(errPct * 100).toFixed(1)}% off · ${earned ? '★'.repeat(earned) : 'no stars'}`;
      status.className = 'ds__game-status ' + (earned >= 1 ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('tempo-q') as HTMLParagraphElement).textContent = `${guess} → ${trueBPM}`;
      ($('tempo-lock') as HTMLButtonElement).disabled = true;
      setTimeout(() => startRound(), 1600);
    }

    function finish() {
      const earned = bestEarnedThisRun;
      ($('tempo-status') as HTMLParagraphElement).textContent = `Done · best of ${ROUNDS} rounds · ${earned ? '★'.repeat(earned) : 'no stars yet — try again'}`;
      ($('tempo-status') as HTMLParagraphElement).className = 'ds__game-status ' + (earned >= 1 ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('tempo-q') as HTMLParagraphElement).textContent = '—';
      ($('tempo-start') as HTMLButtonElement).disabled = false;
      ($('tempo-lock') as HTMLButtonElement).disabled = true;
      ($('tempo-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.tempo)}${'☆'.repeat(3 - stars.tempo)}`;
      round = 0; active = false;
      if (earned > 0) recordStars('tempo', earned);
    }

    function start() {
      round = 0; bestEarnedThisRun = 0;
      ($('tempo-start') as HTMLButtonElement).disabled = true;
      startRound();
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('tempo-start')?.addEventListener('click', start);
      $('tempo-lock')?.addEventListener('click', lockIn);
      $('tempo-tap-btn')?.addEventListener('mousedown', () => { tap(); ($('tempo-tap-btn') as HTMLButtonElement)?.classList.add('ds__big-tap--press'); setTimeout(() => $('tempo-tap-btn')?.classList.remove('ds__big-tap--press'), 80); });
      $('tempo-tap-btn')?.addEventListener('touchstart', (e) => { e.preventDefault(); tap(); }, { passive: false });
      ($('tempo-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.tempo)}${'☆'.repeat(3 - stars.tempo)}`;
    });
  })();

  // =========================================================
  //  GAME 7 · MELODY MEMORY
  // =========================================================
  (() => {
    const NOTES: ('C'|'D'|'E'|'F'|'G'|'A'|'B')[] = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
    const NOTE_FREQ: Record<string, number> = {
      C: noteHz('C4'), D: noteHz('D4'), E: noteHz('E4'),
      F: noteHz('F4'), G: noteHz('G4'), A: noteHz('A4'), B: noteHz('B4'),
    };
    const ROUND_LENS = [3, 4, 5];

    let round = 0; let perfectRounds = 0;
    let cur: string[] = []; let userSeq: string[] = [];
    let listening = false; let active = false;
    let pendingTimers: number[] = [];

    function clearPending() {
      pendingTimers.forEach(t => clearTimeout(t)); pendingTimers = [];
    }

    function generateSeq(n: number): string[] {
      const out: string[] = [];
      for (let i = 0; i < n; i++) out.push(NOTES[Math.floor(Math.random() * NOTES.length)]);
      return out;
    }

    function flashKey(n: string, dur = 380) {
      const el = document.querySelector(`#melody-piano .ds__piano-key[data-note="${n}"]`) as HTMLButtonElement | null;
      if (!el) return;
      el.classList.add('ds__piano-key--cue');
      const tid = window.setTimeout(() => el.classList.remove('ds__piano-key--cue'), dur);
      pendingTimers.push(tid);
    }

    function enableKeys(on: boolean) {
      document.querySelectorAll<HTMLButtonElement>('#melody-piano .ds__piano-key').forEach(b => { b.disabled = !on; });
    }

    async function startRound() {
      const c = ac(); if (c.state === 'suspended') await c.resume();
      clearPending();
      round++;
      if (round > ROUND_LENS.length) { finish(); return; }
      const len = ROUND_LENS[round - 1];
      cur = generateSeq(len); userSeq = [];
      ($('melody-status') as HTMLParagraphElement).textContent = `Round ${round} of ${ROUND_LENS.length} · ${len} notes · listen…`;
      ($('melody-status') as HTMLParagraphElement).className = 'ds__game-status';
      ($('melody-q') as HTMLParagraphElement).textContent = '· · ·';
      listening = true; active = false;
      enableKeys(false);
      const NOTE_DUR = 0.5; const STEP = 0.55;
      const start = c.currentTime + 0.35;
      cur.forEach((n, i) => {
        const when = start + i * STEP;
        playSineNote(when, NOTE_FREQ[n], NOTE_DUR, 0.18);
        const tid = window.setTimeout(() => flashKey(n, 400), (when - c.currentTime) * 1000);
        pendingTimers.push(tid);
      });
      // Open input after the cue finishes.
      const openTid = window.setTimeout(() => {
        listening = false; active = true;
        enableKeys(true);
        ($('melody-status') as HTMLParagraphElement).textContent = `Your turn · tap the ${len} notes in order.`;
        ($('melody-q') as HTMLParagraphElement).textContent = '?';
      }, (cur.length * STEP + 0.35) * 1000);
      pendingTimers.push(openTid);
    }

    function tapKey(n: string) {
      if (!active) return;
      const c = ac();
      playSineNote(c.currentTime, NOTE_FREQ[n], 0.4, 0.18);
      const el = document.querySelector(`#melody-piano .ds__piano-key[data-note="${n}"]`) as HTMLButtonElement | null;
      if (el) { el.classList.add('ds__piano-key--press'); setTimeout(() => el.classList.remove('ds__piano-key--press'), 120); }
      userSeq.push(n);
      const right = cur[userSeq.length - 1] === n;
      if (!right) {
        // Continue accepting input until length matches, then evaluate.
      }
      ($('melody-q') as HTMLParagraphElement).textContent = `${userSeq.length} / ${cur.length}`;
      if (userSeq.length >= cur.length) {
        active = false;
        enableKeys(false);
        setTimeout(() => evaluateRound(), 300);
      }
    }

    function evaluateRound() {
      const matches = cur.filter((c, i) => userSeq[i] === c).length;
      const perfect = matches === cur.length;
      if (perfect) perfectRounds++;
      ($('melody-status') as HTMLParagraphElement).textContent = `${matches} / ${cur.length} correct ${perfect ? '· perfect echo · next round →' : '· not quite · next round →'}`;
      ($('melody-status') as HTMLParagraphElement).className = 'ds__game-status ' + (perfect ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('melody-q') as HTMLParagraphElement).textContent = perfect ? '✓' : '✗';
      setTimeout(() => startRound(), 1400);
    }

    function finish() {
      const earned = Math.min(3, Math.max(0, perfectRounds));
      ($('melody-status') as HTMLParagraphElement).textContent = `Done · ${perfectRounds} of ${ROUND_LENS.length} perfect · ${earned ? '★'.repeat(earned) : 'no stars yet — try again'}`;
      ($('melody-status') as HTMLParagraphElement).className = 'ds__game-status ' + (earned >= 1 ? 'ds__game-status--success' : 'ds__game-status--fail');
      ($('melody-q') as HTMLParagraphElement).textContent = '—';
      ($('melody-start') as HTMLButtonElement).disabled = false;
      ($('melody-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.melody)}${'☆'.repeat(3 - stars.melody)}`;
      enableKeys(false);
      round = 0; active = false;
      if (earned > 0) recordStars('melody', earned);
    }

    function start() {
      round = 0; perfectRounds = 0;
      ($('melody-start') as HTMLButtonElement).disabled = true;
      startRound();
    }

    document.addEventListener('DOMContentLoaded', () => {
      $('melody-start')?.addEventListener('click', start);
      document.querySelectorAll<HTMLButtonElement>('#melody-piano .ds__piano-key').forEach(b => {
        let lastFire = 0;
        const fire = () => { const now = Date.now(); if (now - lastFire < 60) return; lastFire = now; tapKey(b.dataset.note as string); };
        b.addEventListener('mousedown', fire);
        b.addEventListener('touchstart', (e) => { e.preventDefault(); fire(); }, { passive: false });
        b.addEventListener('click', fire);
      });
      ($('melody-score') as HTMLSpanElement).textContent = `best · ${'★'.repeat(stars.melody)}${'☆'.repeat(3 - stars.melody)}`;
    });
  })();

  // =========================================================
  //  Init
  // =========================================================
  document.addEventListener('DOMContentLoaded', () => {
    renderRoster();
    renderWallet();
    updateLessonStars();
    $('ds-celebrate-close')?.addEventListener('click', () => { ($('ds-celebrate') as HTMLDivElement).hidden = true; });
    $('ds-celebrate')?.addEventListener('click', (e) => { if (e.target === $('ds-celebrate')) ($('ds-celebrate') as HTMLDivElement).hidden = true; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ($('ds-celebrate') as HTMLDivElement).hidden = true; });
  });
</script>
</BlockLayout>