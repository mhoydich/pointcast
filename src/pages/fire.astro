---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FIRE_PRACTICES, FIRE_REALMS, FOUR_ELEMENTS, PRINCIPLES, SAFETY_CHECKLIST, SYNTHESIS_NOTES, TRACK_META } from '../lib/fire';
const title = `${TRACK_META.title} — ${TRACK_META.subtitle}`;
const description = TRACK_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Course', '@id': 'https://pointcast.xyz/fire', name: TRACK_META.title, description, url: 'https://pointcast.xyz/fire', provider: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/fire.json', title: 'Fire (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span><span>fire</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{TRACK_META.paperNumber} · FIRE · 4 REALMS · 4 PRACTICES</p>
      <h1>FIRE.</h1>
      <p class="subtitle">{TRACK_META.subtitle}</p>
      <p class="thesis">{TRACK_META.thesis}</p>
    </header>

    <section><p class="kicker">PRINCIPLES</p><h2>Six rules before any flame.</h2>
      <ol class="rules">{PRINCIPLES.map((p, i) => (<li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>))}</ol>
    </section>

    <section><p class="kicker">FOUR REALMS OF FIRE</p><h2>Where fire lives in the radius.</h2>
      <ol class="realms">{FIRE_REALMS.map((r) => (
        <li><h3>{r.name}</h3><p>{r.detail}</p><p class="cohort"><strong>Cohort posture:</strong> {r.cohortPosture}</p></li>
      ))}</ol>
    </section>

    <section class="safety"><p class="kicker">SAFETY CHECKLIST · ALWAYS</p><h2>Seven items. Every fire.</h2>
      <ol class="safety-list">{SAFETY_CHECKLIST.map((s, i) => (
        <li><span class="sf__num">{String(i+1).padStart(2,'0')}</span><div><h3>{s.item}</h3><p>{s.detail}</p></div></li>
      ))}</ol>
    </section>

    <section><p class="kicker">FOUR PRACTICES</p><h2>What the cohort does at the fire.</h2>
      <ol class="practices">{FIRE_PRACTICES.map((p) => (
        <li><div class="pr__head"><h3>{p.name}</h3><span class="pr__cad">{p.cadence}</span></div><p>{p.detail}</p></li>
      ))}</ol>
    </section>

    <section class="synthesis"><p class="kicker">FOUR-ELEMENT SYNTHESIS</p><h2>The sensory frame complete.</h2>
      <p class="lede">{SYNTHESIS_NOTES.closingThesis}</p>
      <ol class="elements">{FOUR_ELEMENTS.map((e) => (
        <li class={`elem elem--${e.element.toLowerCase()}`}>
          <span class="elem__sym">{e.element}</span>
          <h3>{e.track}</h3>
          <p class="elem__pn">{e.paperNumber}</p>
          <p class="elem__focus">{e.sensoryFocus}</p>
          <p class="elem__prac"><strong>Practice:</strong> {e.practice}</p>
          <a class="elem__link" href={e.url}>{e.url} →</a>
        </li>
      ))}</ol>
    </section>

    <section><p class="kicker">BIBLIOGRAPHY</p><h2>Sources for the indigenous-knowledge arc.</h2>
      <ol class="bib">{SYNTHESIS_NOTES.bibliography.map((b) => (<li set:html={b} />))}</ol>
    </section>

    <section class="links">
      <a href="/geology">Geology · earth</a>
      <a href="/ocean-wing">Ocean Wing · water</a>
      <a href="/marine-layer">Marine Layer · air</a>
      <a href="/nature-practice">Nature Practice · pathway</a>
      <a href="/common-forms">Common Forms · architecture</a>
      <a href="/commons">Commons</a>
      <a href="/university-of-el-segundo">UES tracks</a>
      <a href="/fire.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --fr-ink:#1a1a1a; --fr-paper:#fdf9ee; --fr-flame:#e8722a; --fr-ember:#b85a3a; --fr-coal:#3a1a0e; --fr-ash:#a8a39a; --fr-spark:#f0c050; --fr-earth:#7a4f1a; --fr-water:#2a5a8a; --fr-air:#a8b8c8; --fr-sage:#7a8c4f; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--fr-paper); color: var(--fr-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--fr-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; background: radial-gradient(circle at 80% 30%, rgba(232,114,42,.18), transparent 60%); }
  .hero__bar { height: 14px; background: var(--fr-coal); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #fff; margin: 0 0 10px; padding: 4px 8px; background: var(--fr-flame); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 132px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; color: var(--fr-coal); }
  .subtitle { font-size: 20px; font-weight: 500; margin: 0 0 14px; max-width: 50ch; }
  .thesis { font-size: 16px; line-height: 1.6; max-width: 70ch; margin: 0; }
  section { padding: 30px 28px; border-top: 4px solid var(--fr-coal); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  .lede { font-size: 16px; line-height: 1.6; margin: 0 0 18px; max-width: 72ch; }

  .rules { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rules li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--fr-ink); align-items: baseline; }
  .rules span { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--fr-flame); }
  .rules p { margin: 0; font-size: 15px; line-height: 1.5; }

  .realms { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .realms li { padding: 16px 18px; background: #fff; border: 2px solid var(--fr-ink); border-left: 8px solid var(--fr-flame); }
  .realms h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 8px; font-weight: 700; }
  .realms p { margin: 0 0 8px; font-size: 14px; line-height: 1.55; }
  .realms .cohort { padding: 10px 12px; background: var(--fr-paper); border-left: 4px solid var(--fr-ember); font-size: 13.5px; }
  .realms strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fr-flame); margin-right: 4px; }

  .safety { background: #fff8f0; border-top-color: var(--fr-flame); }
  .safety-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .safety-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--fr-flame); align-items: baseline; }
  .sf__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: #fff; background: var(--fr-flame); padding: 4px 0; text-align: center; }
  .safety-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 4px; font-weight: 700; }
  .safety-list p { margin: 0; font-size: 13.5px; line-height: 1.5; }

  .practices { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .practices li { padding: 14px 16px; background: #fff; border: 2px solid var(--fr-ink); border-left: 8px solid var(--fr-spark); }
  .pr__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .pr__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; font-weight: 700; }
  .pr__cad { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--fr-ember); padding: 2px 6px; background: var(--fr-paper); }
  .practices p { margin: 0; font-size: 14px; line-height: 1.55; }

  .synthesis { background: linear-gradient(135deg, #fff, var(--fr-paper)); border-top-color: var(--fr-coal); border-top-width: 8px; }
  .elements { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .elem { padding: 16px 18px; background: #fff; border: 3px solid var(--fr-ink); display: grid; gap: 6px; }
  .elem--earth { border-left: 14px solid var(--fr-earth); }
  .elem--water { border-left: 14px solid var(--fr-water); }
  .elem--fire { border-left: 14px solid var(--fr-flame); background: #fff8f0; }
  .elem--air { border-left: 14px solid var(--fr-air); }
  .elem__sym { font-family: var(--pc-font-mono); font-size: 14px; letter-spacing: .22em; font-weight: 700; color: var(--fr-coal); }
  .elem h3 { font-family: var(--pc-font-mono); font-size: 18px; margin: 0; font-weight: 700; }
  .elem__pn { margin: 0; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; color: #5a5450; }
  .elem__focus { margin: 4px 0 0; font-size: 13.5px; line-height: 1.5; }
  .elem__prac { margin: 4px 0 0; font-size: 13px; color: #2a2a2a; }
  .elem strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fr-coal); margin-right: 4px; }
  .elem__link { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .04em; color: var(--fr-coal); text-decoration: underline; text-underline-offset: 3px; padding-top: 4px; }

  .bib { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .bib li { margin-bottom: 6px; }
  .bib em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--fr-coal); color: var(--fr-paper); text-decoration: none; }
  .links a:hover { background: var(--fr-flame); }

  @media (max-width: 800px) { h1 { font-size: 96px; } .elements { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 64px; } .safety-list li { grid-template-columns: 1fr; } }
</style>
