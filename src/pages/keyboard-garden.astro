---
// /keyboard-garden — Keyboard Garden. A solo arcade for the whole keyboard:
// flowers sprout on random keys, bud → bloom → wilt. Pick each one while it's
// in bloom. Your streak climbs a pentatonic run, so a good run is a melody.
// Golden sunflowers want a quick mash and give a heart back. Three wilts and
// the garden closes. Today's garden is seeded by the date, so everyone plays
// the same sprouts; ?beat=<score> turns a link into a challenge.
// Solo sibling of /keyboard, /keyboard-quartet, /keyboard-rush.
// Built 2026-09-23 by Claude Code on a brief from Mike.
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Keyboard Garden · PointCast</title>
<meta name="description" content="Flowers sprout on your keys. Pick them while they bloom, before they wilt. A solo keyboard arcade where a good streak is a melody.">
<meta property="og:title" content="Keyboard Garden">
<meta property="og:description" content="Flowers sprout on your keys. Pick them before they wilt.">
<meta property="og:url" content="https://pointcast.xyz/keyboard-garden">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/og/garden.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="A drawn keyboard with flowers sprouting on some of its keys.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Keyboard Garden">
<meta name="twitter:description" content="Flowers sprout on your keys. Pick them before they wilt.">
<meta name="twitter:image" content="https://pointcast.xyz/og/garden.png">
<link rel="canonical" href="https://pointcast.xyz/keyboard-garden">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:inline>
  [hidden]{display:none!important;}
  :root{
    --ground:#0b1412;
    --ground-2:#101c19;
    --key:#16241f;
    --key-edge:#243630;
    --ink:#dfe9e3;
    --ink-dim:#7f9a90;
    --ink-faint:#42584f;
    --accent:#e6c98a;
    --gold:#ffd166;
    --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --serif:"Instrument Serif",Georgia,"Times New Roman",serif;
    color-scheme:dark;
  }
  html,body{min-height:100%;}
  body{
    margin:0;background:var(--ground);color:var(--ink);
    font-family:var(--mono);font-size:13px;
    display:flex;flex-direction:column;min-height:100vh;min-height:100dvh;
    padding-inline:16px;padding-block:14px 12px;box-sizing:border-box;
    -webkit-user-select:none;user-select:none;
  }
  a{color:var(--accent);}
  header{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;padding-bottom:10px;border-bottom:1px solid var(--key-edge);}
  h1{font-family:var(--serif);font-weight:400;font-size:30px;line-height:1;margin:0;}
  h1 em{color:var(--accent);font-style:italic;}
  .back{font-size:12px;color:var(--ink-dim);text-decoration:none;}
  .back:hover{color:var(--accent);}
  .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-left:auto;}
  button{
    font-family:var(--mono);font-size:12px;color:var(--ink);
    background:var(--ground-2);border:1px solid var(--key-edge);border-radius:4px;
    padding:5px 9px;cursor:pointer;
  }
  button:focus-visible{outline:2px solid var(--accent);outline-offset:1px;}
  button[aria-pressed="true"]{background:var(--accent);color:var(--ground);border-color:var(--accent);}
  .primary{background:var(--accent);color:var(--ground);border-color:var(--accent);font-weight:500;}

  main{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding-block:16px;container-type:inline-size;}
  .hud{display:flex;gap:26px;align-items:baseline;flex-wrap:wrap;justify-content:center;font-variant-numeric:tabular-nums;}
  .hud .n{font-family:var(--serif);font-size:34px;line-height:1;}
  .hud .l{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-dim);display:block;margin-top:2px;}
  #hearts{font-size:22px;letter-spacing:4px;color:#ff8f70;}
  #hearts .gone{color:var(--ink-faint);}
  #mult{color:var(--accent);}
  #say{font-family:var(--serif);font-size:clamp(20px,3vw,30px);min-height:1.2em;margin:0;text-align:center;}
  #say em{color:var(--accent);}

  .kb{--u:min(8.4cqw, 74px);display:flex;flex-direction:column;gap:calc(var(--u)*.12);}
  .row{display:flex;gap:calc(var(--u)*.12);height:var(--u);}
  .row[data-r="1"]{padding-left:calc(var(--u)*.5);}
  .row[data-r="2"]{padding-left:calc(var(--u)*.75);}
  .row[data-r="3"]{padding-left:calc(var(--u)*1.25);}
  .key{
    position:relative;width:var(--u);height:100%;flex:0 0 auto;
    border-radius:calc(var(--u)*.16);background:var(--key);border:1px solid var(--key-edge);
    box-shadow:inset 0 -3px 0 rgba(0,0,0,.35);box-sizing:border-box;
    display:flex;align-items:flex-end;justify-content:flex-start;padding:calc(var(--u)*.1);
    cursor:pointer;touch-action:none;overflow:hidden;
    transition:background .15s ease, transform .05s ease;
  }
  .key .cap{font-size:calc(var(--u)*.2);color:var(--ink-faint);font-weight:500;position:relative;z-index:1;}
  .key svg{position:absolute;inset:8% 8% 14%;width:84%;height:78%;pointer-events:none;transition:transform .25s ease, opacity .25s ease, filter .3s ease;transform-origin:50% 100%;}
  .key.bud svg{transform:scale(.45);}
  .key.bloom svg{transform:scale(1);}
  .key.bloom{background:color-mix(in oklab, var(--f) 16%, var(--key));border-color:color-mix(in oklab, var(--f) 55%, var(--key-edge));}
  .key.bloom .cap{color:var(--ink);}
  .key.fade svg{transform:scale(.85) rotate(12deg);filter:saturate(.25) brightness(.7);}
  .key.gold{background:color-mix(in oklab, var(--gold) 22%, var(--key));border-color:var(--gold);animation:goldpulse .35s ease-in-out infinite alternate;}
  .key.gold svg{transform:scale(1.05);}
  .key.gold .cap{color:var(--gold);}
  @keyframes goldpulse{to{box-shadow:0 0 22px var(--gold), inset 0 -3px 0 rgba(0,0,0,.35);}}
  .key .need{position:absolute;top:4%;right:8%;font-size:calc(var(--u)*.2);color:var(--gold);font-weight:500;z-index:1;}
  .key.hit{transform:translateY(2px) scale(.96);}
  .key.picked{background:color-mix(in oklab, var(--f) 55%, var(--key));}
  .key.miss{background:#2a1b14;}
  .key.wilt{background:#231a12;}
  .pop{position:absolute;left:50%;top:10%;transform:translateX(-50%);font-size:calc(var(--u)*.22);font-weight:500;color:var(--accent);animation:pop .6s ease-out forwards;pointer-events:none;z-index:2;white-space:nowrap;}
  @keyframes pop{to{transform:translate(-50%,-120%);opacity:0;}}

  .card{border:1px dashed var(--key-edge);border-radius:12px;padding:16px 20px;text-align:center;max-width:560px;display:flex;flex-direction:column;gap:10px;align-items:center;}
  .card h2{font-family:var(--serif);font-weight:400;font-size:clamp(28px,4vw,40px);line-height:1.05;margin:0;}
  .card h2 em{color:var(--accent);}
  .card p{color:var(--ink-dim);font-size:12px;line-height:1.55;margin:0;}
  .card .row2{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;}
  .stats{display:flex;gap:22px;flex-wrap:wrap;justify-content:center;font-size:11px;color:var(--ink-dim);letter-spacing:.06em;text-transform:uppercase;}
  .stats b{display:block;font-family:var(--serif);font-size:26px;font-weight:400;color:var(--ink);text-transform:none;letter-spacing:0;}
  #shareStatus{font-size:11px;color:var(--ink-dim);min-height:1.2em;}

  footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:10px;border-top:1px solid var(--key-edge);color:var(--ink-dim);font-size:11px;letter-spacing:.03em;}
  footer b{color:var(--ink);font-weight:500;}

  @media (max-width:640px){
    h1{font-size:24px;}
    .kb{--u:min(8.9cqw, 60px);}
    .hud{gap:16px;}
    .hud .n{font-size:26px;}
    footer{font-size:10px;}
  }
  @media (prefers-reduced-motion:reduce){
    .key svg,.key{transition:none;}
    .key.gold,.pop{animation:none;}
  }
</style>
</head>
<body>
<header>
  <h1>Keyboard <em>Garden</em></h1>
  <a class="back" href="/keyboard">Solo keyboard</a>
  <a class="back" href="/keyboard-rush">Bloom Rush</a>
  <a class="back" href="/keyboard-quartet">Quartet</a>
  <div class="controls">
    <button id="dailyBtn" aria-pressed="true" title="Everyone gets the same sprouts today">Today's garden</button>
    <button id="freeBtn" aria-pressed="false" title="A fresh random garden every run">Free play</button>
  </div>
</header>

<main>
  <div class="hud">
    <div><span class="n" id="score">0</span><span class="l">points</span></div>
    <div><span class="n" id="streak">0</span><span class="l">streak</span></div>
    <div><span class="n" id="mult">×1</span><span class="l">bonus</span></div>
    <div><span id="hearts" aria-label="3 hearts left">♥♥♥</span><span class="l">hearts</span></div>
  </div>
  <p id="say" aria-live="polite"></p>
  <div class="kb" id="kb" aria-label="The garden: your keyboard"></div>

  <div class="card" id="intro">
    <h2 id="introTitle">Flowers sprout on your keys. <em>Pick them while they bloom.</em></h2>
    <p id="introSub">Buds open, bloom, then wilt. Tap the key while it's in full bloom for 3 points, early or late for 1. Your streak climbs a scale, and every 10 picks raises the bonus. Golden sunflowers want a quick mash and give a heart back. Three wilts and the garden closes.</p>
    <div class="row2"><button id="startBtn" class="primary">Start (Space)</button></div>
  </div>

  <div class="card" id="over" hidden>
    <h2 id="overTitle"></h2>
    <div class="stats" id="stats"></div>
    <p id="overSub"></p>
    <div class="row2">
      <button id="againBtn" class="primary">Again (Space)</button>
      <button id="shareBtn">Challenge a friend</button>
    </div>
    <div id="shareStatus" aria-live="polite"></div>
  </div>
</main>

<footer>
  <span><b>Space</b> start &nbsp; <b>Esc</b> give up &nbsp; any key in the garden picks what's growing there</span>
  <span id="bestLine"></span>
</footer>

<script is:inline>
(() => {
'use strict';

/* ---------- the board ---------- */
const ROWS = [
  {codes:['Digit1','Digit2','Digit3','Digit4','Digit5','Digit6','Digit7','Digit8','Digit9','Digit0'], caps:'1234567890'},
  {codes:['KeyQ','KeyW','KeyE','KeyR','KeyT','KeyY','KeyU','KeyI','KeyO','KeyP'], caps:'QWERTYUIOP'},
  {codes:['KeyA','KeyS','KeyD','KeyF','KeyG','KeyH','KeyJ','KeyK','KeyL','Semicolon'], caps:'ASDFGHJKL;'},
  {codes:['KeyZ','KeyX','KeyC','KeyV','KeyB','KeyN','KeyM','Comma','Period','Slash'], caps:'ZXCVBNM,./'},
];
const PETALS = ['#ff8f70','#e6c98a','#6fd3c1','#b69cff','#ef7d6b','#8fdc7a','#6fc9e6','#f2a7c3'];
const kb = document.getElementById('kb');
const keys = new Map();   // code -> {el, code}
const allCodes = [];
ROWS.forEach((r,ri)=>{
  const row = document.createElement('div'); row.className='row'; row.dataset.r = ri;
  r.codes.forEach((c,i)=>{
    const el = document.createElement('div');
    el.className = 'key'; el.dataset.code = c;
    el.innerHTML = `<span class="cap">${r.caps[i]}</span>`;
    row.appendChild(el); keys.set(c,{el,code:c}); allCodes.push(c);
  });
  kb.appendChild(row);
});
function flowerSvg(color, gold){
  const petals = [0,60,120,180,240,300].map(a=>{ const r=a*Math.PI/180; return `<ellipse cx="${(20+Math.cos(r)*8).toFixed(1)}" cy="${(16+Math.sin(r)*8).toFixed(1)}" rx="6" ry="6" fill="${color}"/>`; }).join('');
  return `<svg viewBox="0 0 40 44" aria-hidden="true"><path d="M20 44 Q 22 32 20 22" stroke="#4d8a6c" stroke-width="3" fill="none"/><ellipse cx="14" cy="34" rx="5" ry="2.6" fill="#4d8a6c" transform="rotate(-30 14 34)"/>${petals}<circle cx="20" cy="16" r="${gold?6:4.5}" fill="${gold?'#8a5a12':'#fff4d6'}"/></svg>`;
}

/* ---------- seeded randomness (today's garden) ---------- */
function laDate(){ return new Intl.DateTimeFormat('en-CA',{timeZone:'America/Los_Angeles',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()); }
function hashStr(s){ let h=2166136261; for(let i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619); } return h>>>0; }
function mulberry(a){ return ()=>{ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
let rand = Math.random;

/* ---------- audio ---------- */
let ctx, master, wet;
function makeIR(seconds, decay){
  const rate=ctx.sampleRate, len=rate*seconds, buf=ctx.createBuffer(2,len,rate);
  for(let ch=0;ch<2;ch++){ const d=buf.getChannelData(ch); for(let i=0;i<len;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/len,decay); }
  return buf;
}
function boot(){
  if(ctx){ if(ctx.state==='suspended') ctx.resume(); return; }
  ctx = new (window.AudioContext||window.webkitAudioContext)();
  const comp = ctx.createDynamicsCompressor(); comp.threshold.value=-16; comp.ratio.value=6;
  master = ctx.createGain(); master.gain.value=0.6; master.connect(comp); comp.connect(ctx.destination);
  const conv = ctx.createConvolver(); conv.buffer = makeIR(2.4,3.2);
  wet = ctx.createGain(); wet.gain.value=0.3; wet.connect(conv); conv.connect(master);
}
const mtof = m => 440*Math.pow(2,(m-69)/12);
const STEPS = [0,2,4,7,9];
const runMidi = n => 62 + Math.floor((n%15)/5)*12 + STEPS[n%5];
function note(midi, vel=0.7, t, kind='bloom'){
  boot(); t = t ?? ctx.currentTime;
  const f = mtof(midi), out = ctx.createGain(), pan = ctx.createStereoPanner();
  pan.pan.value = Math.random()*0.6-0.3; out.connect(pan); pan.connect(master); pan.connect(wet);
  const osc = (type, freq, gain, dec) => { const o=ctx.createOscillator(); o.type=type; o.frequency.value=freq; const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(gain*vel,t+0.005); g.gain.exponentialRampToValueAtTime(0.0001,t+dec); o.connect(g); g.connect(out); o.start(t); o.stop(t+dec+0.05); };
  if(kind==='gold'){ osc('sine',f,0.35,1.1); osc('sine',f*3.01,0.1,0.4); osc('sine',f*2,0.08,0.6); }
  else { osc('triangle',f,0.4,0.9); osc('sine',f*2,0.1,0.35); }
}
function chord(base, kind){ boot(); const t=ctx.currentTime; [0,2,4,5,7].forEach((s,i)=>note(runMidi(base+s)+12, 0.45, t+i*0.05, kind)); }
function thud(){ boot(); const t=ctx.currentTime; const o=ctx.createOscillator(); o.type='sine'; o.frequency.setValueAtTime(170,t); o.frequency.exponentialRampToValueAtTime(80,t+0.1); const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.18,t+0.005); g.gain.exponentialRampToValueAtTime(0.0001,t+0.14); o.connect(g); g.connect(master); o.start(t); o.stop(t+0.16); }
function wiltSound(){ boot(); const t=ctx.currentTime; const o=ctx.createOscillator(); o.type='triangle'; o.frequency.setValueAtTime(330,t); o.frequency.exponentialRampToValueAtTime(150,t+0.45); const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.22,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+0.5); o.connect(g); g.connect(master); o.start(t); o.stop(t+0.55); }

/* ---------- state ---------- */
const $ = id => document.getElementById(id);
const scoreEl=$('score'), streakEl=$('streak'), multEl=$('mult'), heartsEl=$('hearts'), sayEl=$('say');
const intro=$('intro'), over=$('over'), dailyBtn=$('dailyBtn'), freeBtn=$('freeBtn');
let daily = true, mode = 'idle';          // idle | play | over
let score=0, streak=0, bestStreak=0, hearts=3, picks=0, perfects=0, golds=0;
let sprouts = new Map();                  // code -> sprout
let t0=0, nextSpawn=0, nextGold=0, raf=0, pausedAt=0;
const MAX_HEARTS = 3;

const mult = () => Math.min(4, 1 + Math.floor(streak/10));
function paintHud(){
  scoreEl.textContent = score; streakEl.textContent = streak; multEl.textContent = '×'+mult();
  heartsEl.innerHTML = Array.from({length:MAX_HEARTS},(_,i)=>i<hearts?'♥':'<span class="gone">♥</span>').join('');
  heartsEl.setAttribute('aria-label', `${hearts} ${hearts===1?'heart':'hearts'} left`);
}
function say(html){ sayEl.innerHTML = html; }
function pop(el, text){ const p=document.createElement('span'); p.className='pop'; p.textContent=text; el.appendChild(p); setTimeout(()=>p.remove(),600); }
function flashClass(el, cls, ms=160){ el.classList.add(cls); setTimeout(()=>el.classList.remove(cls), ms); }

/* difficulty: it speeds up with every pick */
const spawnGap = () => Math.max(330, 1050 * Math.pow(0.982, picks));
const lifeFor = () => Math.max(1250, 2800 * Math.pow(0.99, picks));

function clearKey(code){
  const k = keys.get(code); k.el.classList.remove('bud','bloom','fade','gold'); k.el.style.removeProperty('--f');
  k.el.querySelectorAll('svg,.need').forEach(n=>n.remove());
}
function spawn(now, gold=false){
  const free = allCodes.filter(c=>!sprouts.has(c));
  if(!free.length) return;
  const code = free[Math.floor(rand()*free.length)];
  const color = gold ? '#ffd166' : PETALS[Math.floor(rand()*PETALS.length)];
  const s = { code, born:now, life: gold ? 3000 : lifeFor(), gold, need: gold ? 6 : 0, color };
  sprouts.set(code, s);
  const el = keys.get(code).el;
  el.style.setProperty('--f', color);
  el.insertAdjacentHTML('beforeend', flowerSvg(color, gold));
  if(gold){ el.classList.add('gold'); el.insertAdjacentHTML('beforeend', `<span class="need">×${s.need}</span>`); say('<em>A golden sunflower!</em> Mash it!'); }
  else el.classList.add('bud');
}
function stageOf(s, now){ const f=(now-s.born)/s.life; return f<0.3?'bud':f<0.8?'bloom':f<1?'fade':'dead'; }

function frame(now){
  if(mode!=='play') return;
  if(now >= nextSpawn){ spawn(now); nextSpawn = now + spawnGap() * (0.75 + rand()*0.5); }
  if(now >= nextGold){ spawn(now, true); nextGold = now + 16000 + rand()*8000; }
  sprouts.forEach(s=>{
    const st = stageOf(s, now), el = keys.get(s.code).el;
    if(s.gold){ if(st==='dead'){ sprouts.delete(s.code); clearKey(s.code); say('The sunflower closed.'); } return; }
    if(st==='dead'){ wilt(s); return; }
    if(!el.classList.contains(st)){ el.classList.remove('bud','bloom','fade'); el.classList.add(st); }
  });
  raf = requestAnimationFrame(frame);
}
function wilt(s){
  sprouts.delete(s.code); clearKey(s.code);
  const el = keys.get(s.code).el; flashClass(el,'wilt',400);
  hearts--; streak = 0; wiltSound(); paintHud();
  say(hearts>0 ? `<em>${keyCap(s.code)}</em> wilted.` : '');
  if(hearts<=0) finish();
}
const keyCap = code => keys.get(code).el.querySelector('.cap').textContent;

function press(code){
  boot();
  const k = keys.get(code); if(!k) return;
  flashClass(k.el,'hit',90);
  if(mode!=='play'){ note(runMidi(allCodes.indexOf(code)%15), 0.5); return; }
  const s = sprouts.get(code), now = performance.now();
  if(!s){ if(streak>0) say('Oops, bare soil. Streak reset.'); streak = 0; thud(); flashClass(k.el,'miss',180); paintHud(); return; }
  if(s.gold){
    s.need--; note(runMidi(12 - s.need + streak), 0.6, undefined, 'gold');
    const need = k.el.querySelector('.need'); if(need) need.textContent = '×'+s.need;
    if(s.need<=0){
      sprouts.delete(code); clearKey(code); golds++;
      const pts = 10*mult(); score += pts; pop(k.el, '+'+pts);
      const healed = hearts < MAX_HEARTS; if(healed) hearts++;
      chord(streak, 'gold'); say(healed ? '<em>Sunflower!</em> A heart grows back.' : '<em>Sunflower!</em> Big points.');
      paintHud();
    }
    return;
  }
  const st = stageOf(s, now);
  sprouts.delete(code); clearKey(code);
  const perfect = st==='bloom';
  streak++; picks++; bestStreak = Math.max(bestStreak, streak); if(perfect) perfects++;
  const pts = (perfect?3:1) * mult(); score += pts;
  k.el.style.setProperty('--f', s.color); flashClass(k.el,'picked',180);
  pop(k.el, '+'+pts);
  note(runMidi(streak-1), perfect?0.8:0.5);
  if(streak%10===0){ chord(streak); say(`<em>${streak} in a row!</em> Bonus ×${mult()}.`); }
  else if(!perfect) say(st==='bud' ? 'A little early.' : 'Just in time.');
  else if(streak>2) say('');
  paintHud();
}

function start(){
  boot(); cancelAnimationFrame(raf);
  sprouts.forEach(s=>clearKey(s.code)); sprouts.clear();
  rand = daily ? mulberry(hashStr('keyboard-garden:'+laDate())) : Math.random;
  score=0; streak=0; bestStreak=0; hearts=MAX_HEARTS; picks=0; perfects=0; golds=0; paintHud();
  intro.hidden = true; over.hidden = true; mode = 'play';
  const now = performance.now(); t0 = now; nextSpawn = now + 500; nextGold = now + 14000 + rand()*6000;
  say(daily ? `Today's garden · ${laDate()}` : 'Free play');
  raf = requestAnimationFrame(frame);
}
function bestKey(){ return daily ? 'kg:best:'+laDate() : 'kg:best:free'; }
function getBest(k){ try{ return +localStorage.getItem(k)||0; }catch(_){ return 0; } }
function finish(){
  mode = 'over'; cancelAnimationFrame(raf);
  sprouts.forEach(s=>clearKey(s.code)); sprouts.clear();
  const prev = getBest(bestKey()), allPrev = getBest('kg:best:all');
  const isBest = score > prev;
  try{ if(isBest) localStorage.setItem(bestKey(), score); if(score>allPrev) localStorage.setItem('kg:best:all', score); }catch(_){}
  chord(0);
  const beat = challenge();
  $('overTitle').innerHTML = beat && score > beat ? `You beat <em>${beat}</em> with ${score}!` : isBest && prev ? `New best: <em>${score}</em>` : `The garden closed at <em>${score}.</em>`;
  $('stats').innerHTML = `<span><b>${picks}</b>picked</span><span><b>${perfects}</b>in full bloom</span><span><b>${bestStreak}</b>best streak</span><span><b>${golds}</b>sunflowers</span>`;
  $('overSub').textContent = (daily ? `Today's best: ${Math.max(score,prev)}.` : `Free-play best: ${Math.max(score,prev)}.`) + (beat && score <= beat ? ` The challenge was ${beat}. So close.` : '');
  $('shareStatus').textContent = '';
  over.hidden = false; say(''); paintBest();
}
function giveUp(){ if(mode==='play'){ hearts = 0; paintHud(); finish(); } }
function paintBest(){ const d=getBest('kg:best:'+laDate()), a=getBest('kg:best:all'); $('bestLine').textContent = a ? `today's best ${d} · all-time ${a}` : 'three wilts and the garden closes'; }

function challenge(){ const b = new URLSearchParams(location.search).get('beat'); return /^\d{1,6}$/.test(b||'') ? +b : 0; }
$('shareBtn').onclick = async ()=>{
  const u = new URL('/keyboard-garden', location.origin); u.searchParams.set('beat', score);
  const text = `I picked ${score} points in Keyboard Garden. Beat it?`;
  try{
    if(navigator.share){ await navigator.share({title:'Keyboard Garden', text, url:u.href}); $('shareStatus').textContent='Sent.'; }
    else { await navigator.clipboard.writeText(u.href); $('shareStatus').textContent='Challenge link copied.'; }
  }catch(e){ if(!e || e.name!=='AbortError') $('shareStatus').textContent = u.href; }
  $('shareBtn').blur();
};

function setDaily(on){ if(mode==='play') return; daily=on; dailyBtn.setAttribute('aria-pressed',on); freeBtn.setAttribute('aria-pressed',!on); }
dailyBtn.onclick = ()=>{ setDaily(true); dailyBtn.blur(); };
freeBtn.onclick = ()=>{ setDaily(false); freeBtn.blur(); };
$('startBtn').onclick = ()=>{ start(); $('startBtn').blur(); };
$('againBtn').onclick = ()=>{ start(); $('againBtn').blur(); };

addEventListener('keydown', e=>{
  if(e.metaKey||e.ctrlKey||e.altKey) return;
  if(e.code==='Space'){ e.preventDefault(); if(mode!=='play' && !e.repeat) start(); return; }
  if(e.code==='Escape'){ giveUp(); return; }
  if(!keys.has(e.code)) return;
  e.preventDefault(); if(e.repeat) return;
  press(e.code);
});
kb.addEventListener('pointerdown', e=>{ const el=e.target.closest('.key'); if(!el) return; e.preventDefault(); press(el.dataset.code); });

/* pause while the tab is hidden, so a phone call doesn't wilt the garden */
document.addEventListener('visibilitychange', ()=>{
  if(mode!=='play') return;
  if(document.hidden){ pausedAt = performance.now(); cancelAnimationFrame(raf); }
  else if(pausedAt){ const d = performance.now()-pausedAt; sprouts.forEach(s=>s.born+=d); nextSpawn+=d; nextGold+=d; pausedAt=0; raf=requestAnimationFrame(frame); }
});

/* arriving on a challenge */
const beat = challenge();
if(beat){
  $('introTitle').innerHTML = `Someone picked <em>${beat} points.</em> Beat it.`;
  $('introSub').textContent = `Flowers sprout on your keys. Pick them in full bloom for 3 points, early or late for 1. Streaks raise the bonus, golden sunflowers want a mash and give a heart back. Three wilts and the garden closes.`;
}
paintHud(); paintBest();
})();
</script>
</body>
</html>
