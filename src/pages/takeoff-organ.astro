---
/** Takeoff Organ v2 — eight notes, tiny departures, optional sky chords. */
import TenDoorsFrame from '../components/TenDoorsFrame.astro';
import { NOTES, PLANS } from '../lib/ten-doors/takeoff.mjs';
import { PAD_COLORS } from '../lib/ten-doors/takeoff-render.mjs';
const first = PLANS[0];
---

<TenDoorsFrame slug="takeoff-organ" quiet isolated>
  <div id="to-app" class="to-app" data-takeoff-v2 tabindex="0" role="group" aria-label="Takeoff Organ instrument" aria-describedby="to-help">
    <div class="to-toolbar">
      <span class="to-airport"><span aria-hidden="true">↗</span> YOUR LITTLE AIRPORT</span>
      <div class="to-tools">
        <button id="to-sound" type="button" aria-pressed="false" disabled><span aria-hidden="true">♪</span> <span data-sound-label>Sound off</span></button>
        <button id="to-pause" type="button" disabled>Pause</button>
      </div>
    </div>
    <div class="to-scene">
      <canvas id="to-sky" width="900" height="400" aria-hidden="true"></canvas>
      <p class="to-scene-fallback" hidden>The illustration is unavailable here. The note pads and chord guide still work.</p>
      <div class="to-scene-label" aria-hidden="true"><span>EL SEGUNDO · PACIFIC SKY</span><span id="to-aircount">Ready for takeoff</span></div>
    </div>

    <section class="to-guide" aria-labelledby="to-title">
      <div class="to-guide-top">
        <div><p class="to-eyebrow" id="to-eyebrow">A little sky chord</p><h2 id="to-title">{first.title}</h2></div>
        <button id="to-next" class="to-next" type="button" disabled>Next chord <span aria-hidden="true">→</span></button>
      </div>
      <p class="to-hint" id="to-hint">Tap the three marked notes. Let them overlap.</p>
      <div id="to-goals" class="to-goals" role="list" aria-label="Chord departures">
        {first.lanes.map((lane) => <div class="to-goal" role="listitem" data-goal-slot><span class="to-goal-note">{lane + 1} · {NOTES[lane]}</span><span class="to-goal-state">Ready</span></div>)}
      </div>
      <div class="to-stamps" id="to-stamps" role="group" aria-label="Your explored sky chords">
        {PLANS.map((plan) => <span data-stamp={plan.id} role="img" title={plan.title} aria-label={`${plan.title}, unexplored`}><span aria-hidden="true">✦</span></span>)}
        <span id="to-stamp-label">Five little skies to explore</span>
      </div>
    </section>

    <div class="to-pads" role="group" aria-label="Eight musical departure lanes">
      {NOTES.map((note, lane) => (
        <button class="to-pad" type="button" data-to-lane={lane} style={`--pad:${PAD_COLORS[lane]}`} aria-label={`Launch lane ${lane + 1}, ${note}`} disabled>
          <span class="to-pad-top"><span>{lane + 1}</span><svg viewBox="0 0 32 24" width="25" height="19" aria-hidden="true"><path d="M2 12 13 8 11 2 15 2 21 8 29 10Q33 12 29 14L21 16 15 22 11 22 13 16Z" fill="currentColor" /></svg></span>
          <strong>{note.slice(0, -1)}<sub>{note.slice(-1)}</sub></strong>
          <span class="to-pad-hint">Play a note</span>
        </button>
      ))}
    </div>

    <div class="to-bottom">
      <div class="to-mode" role="group" aria-label="Choose how to play">
        <button id="to-guide-mode" type="button" aria-pressed="true" disabled>Sky chords</button>
        <button id="to-free-mode" type="button" aria-pressed="false" disabled>Free play</button>
      </div>
      <div class="to-extra">
        <button id="to-auto" type="button" aria-pressed="false" hidden disabled>Auto fly</button>
        <button id="to-clear" type="button" disabled>Clear sky</button>
      </div>
    </div>
    <p id="to-status" class="to-status" role="status" aria-atomic="true">Tap a note. Watch it take off.</p>
    <p id="to-help" class="to-help">Every note is welcome. Keys 1–8 play while the instrument is focused. Space pauses outside buttons. Sound is optional.</p>
    <noscript><p class="to-help">This instrument needs JavaScript to launch its planes. The instructions below remain available.</p></noscript>
  </div>
</TenDoorsFrame>

<style is:global>
  .td[data-door='takeoff-organ'] .td-stage { padding: 0; color: #24314c; background: #fbfaf6; border-radius: 30px; box-shadow: 0 20px 60px #2235521a, 0 2px 5px #22355212; overflow: hidden; }
  .td[data-door='takeoff-organ'] .td-pitch { max-width: 44rem; }
</style>
<style>
  .to-app { outline: none; }
  .to-app [hidden] { display: none !important; }
  .to-app:focus-visible { outline: 3px solid #345fbd; outline-offset: -4px; border-radius: 30px; }
  .to-app button { font: inherit; font-size: .78rem; font-weight: 600; line-height: 1.2; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .to-app button:focus-visible { outline: 3px solid #244c9a; outline-offset: 3px; }
  .to-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 14px; }
  .to-airport { display: flex; align-items: center; gap: 6px; font: 700 0.57rem/1.3 ui-monospace, monospace; letter-spacing: 0.07em; color: #596376; }
  .to-airport > span { display: grid; place-items: center; background: #e8edf5; width: 24px; height: 24px; border-radius: 50%; font-size: 1rem; color: #36528a; }
  .to-tools, .to-extra { display: flex; gap: 6px; }
  .to-tools button, .to-extra button { min-height: 44px; padding: 8px 11px; border: 1px solid #d9dfe7; background: #fff; color: #34415a; border-radius: 14px; }
  .to-tools button[aria-pressed='true'], .to-extra button[aria-pressed='true'] { background: #273d69; border-color: #273d69; color: white; }
  .to-scene { position: relative; overflow: hidden; background: linear-gradient(#f6c5b1, #b5bede 65%, #467298); }
  #to-sky { width: 100%; height: clamp(195px, 31vw, 340px); display: block; touch-action: pan-y; }
  .to-scene-label { position: absolute; inset: auto 14px 11px; display: flex; justify-content: space-between; gap: 10px; color: #f9f5ee; font: 600 0.55rem/1.3 ui-monospace, monospace; letter-spacing: 0.06em; pointer-events: none; text-shadow: 0 1px 4px #172c4e; }
  .to-scene-fallback { min-height: 170px; padding: 24px; box-sizing: border-box; line-height: 1.5; }
  .to-guide { padding: 14px 20px 10px; background: linear-gradient(135deg,#fffdf8,#f3f5f8); border-bottom: 1px solid #e7e7e2; }
  .to-guide.is-complete { background: linear-gradient(120deg,#e7f7ec,#f6faf0); }
  .to-guide-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .to-eyebrow { margin: 0 0 3px; font: 700 0.56rem ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.1em; color: #6c7484; }
  h2 { margin: 0; font-size: clamp(1.2rem, 4vw, 1.6rem); line-height: 1.1; letter-spacing: -0.035em; font-weight: 750; }
  .to-next { min-height: 44px; padding: 10px 13px; background: #293f6c; color: #fff; border: 0; border-radius: 14px; box-shadow: 0 3px 0 #15294e; white-space: nowrap; }
  .to-next:disabled { background: #e4e7ec; color: #758094; box-shadow: none; cursor: default; }
  .to-hint { margin: 7px 0 10px; font-size: 0.78rem; line-height: 1.4; color: #566176; }
  .to-goals { display: flex; gap: 6px; }
  .to-goal { flex: 1; min-width: 0; display: flex; justify-content: space-between; align-items: center; gap: 5px; padding: 8px 9px; background: #e9edf2; border: 1px solid #dce2e9; border-radius: 11px; font-size: 0.67rem; line-height: 1.3; }
  .to-goal-note { font-weight: 750; color: #334363; }
  .to-goal-state { font-size: 0.625rem; color: #626e83; }
  .to-goal.is-airborne { background: #e2edf9; border-color: #b7d1f0; }
  .to-goal.is-clear { background: #d9efdf; border-color: #aacdb3; }
  .to-goal.is-clear .to-goal-state { color: #286044; font-weight: 750; }
  .to-stamps { display: flex; align-items: center; gap: 4px; margin-top: 9px; }
  .to-stamps > span[data-stamp] { display: grid; place-items: center; width: 15px; height: 15px; border-radius: 50%; background: #e8e9e8; color: #a0a6ab; font-size: 0.65rem; }
  .to-stamps > span.is-earned { color: #77521a; background: #f6d782; }
  #to-stamp-label { font-size: 0.61rem; margin-left: 4px; color: #70798a; }
  .to-pads { display: grid; grid-template-columns: repeat(8,minmax(0,1fr)); gap: 9px; padding: 17px 18px 13px; }
  .to-pad { position: relative; min-width: 0; min-height: 105px; display: flex; flex-direction: column; text-align: left; justify-content: space-between; padding: 9px 10px; border: 1px solid #ffffffbb; border-bottom: 4px solid #26334d20; border-radius: 18px; background: linear-gradient(155deg,#ffffff70,transparent 65%),var(--pad); color: #26334d; box-shadow: inset 0 1px 0 #ffffffc9, 0 5px 0 #26334d14, 0 7px 12px #26334d0c; transition: transform .12s ease, box-shadow .12s ease, filter .12s ease; }
  .to-pad::after { content: ''; position: absolute; inset: 3px 5px auto; height: 28%; border-radius: 14px 14px 55% 55%; background: #ffffff21; pointer-events: none; }
  .to-pad:active, .to-pad.is-lit { transform: translateY(3px); filter: brightness(1.06); box-shadow: inset 0 2px 5px #26334d15, 0 2px 0 #26334d14, 0 0 0 3px #ffffff; }
  .to-pad.is-goal { outline: 2px solid #596d8d; outline-offset: 2px; }
  .to-pad:focus-visible { outline: 3px solid #234c9a; outline-offset: 4px; }
  .to-pad-top { display: flex; justify-content: space-between; align-items: center; width: 100%; font: 750 0.63rem ui-monospace, monospace; opacity: .8; }
  .to-pad strong { font-size: 1.7rem; line-height: 1; letter-spacing: -.07em; font-weight: 800; }
  .to-pad sub { font-size: .55em; vertical-align: baseline; margin-left: 2px; }
  .to-pad-hint { font-size: .625rem; line-height: 1.2; font-weight: 650; }
  .to-pad:disabled { cursor: default; filter: saturate(.5); opacity: .65; }
  .to-bottom { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 2px 18px 0; flex-wrap: wrap; }
  .to-mode { display: inline-flex; background: #e9ecf0; border: 1px solid #e0e4ea; padding: 3px; border-radius: 14px; }
  .to-mode button { min-height: 44px; padding: 7px 11px; border: 0; border-radius: 10px; color: #596479; background: transparent; }
  .to-mode button[aria-pressed='true'] { background: white; color: #263b64; box-shadow: 0 2px 5px #22355212; }
  .to-status { margin: 12px 18px 5px; font-size: .8rem; line-height: 1.45; color: #344562; min-height: 1.45em; font-weight: 650; }
  .to-help { margin: 0 18px; padding-bottom: 16px; font-size: .75rem; line-height: 1.5; color: #667185; }
  @media(max-width:680px) { .to-pads { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8px; padding: 14px; } .to-pad { min-height: 88px; border-radius: 16px; padding: 8px 9px; } .to-pad strong { font-size: 1.5rem; } .to-guide { padding: 12px 14px 9px; } .to-goal { flex-direction: column; gap: 1px; padding: 6px; } .to-bottom { padding-inline: 14px; } }
  @media(max-width:370px) { .to-airport { max-width: 77px; font-size: .5rem; } .to-toolbar { padding-inline: 11px; } .to-tools button { padding-inline: 9px; font-size: .69rem; } .to-next { padding-inline: 10px; font-size: .69rem; } .to-mode button { padding-inline: 9px; } .to-extra button { padding-inline: 9px; } }
  @media(prefers-reduced-motion:reduce) { .to-pad { transition: none; } .to-pad:active,.to-pad.is-lit { transform: none; } }
</style>

<script>
  import { mountTakeoff } from '../lib/ten-doors/takeoff-client.mjs';
  let cleanup, mounted;
  function mount() {
    const root = document.querySelector('[data-takeoff-v2]');
    if (root === mounted && cleanup) return;
    cleanup?.(); mounted = root;
    cleanup = root ? mountTakeoff(root) : undefined;
  }
  function unmount() { cleanup?.(); cleanup = undefined; mounted = undefined; }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  window.addEventListener('pagehide', unmount);
  window.addEventListener('pageshow', (event) => { if (event.persisted) mount(); });
</script>
