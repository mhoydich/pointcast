---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect.astro';
import { PASSPORT_STAMPS } from '../lib/play-layer';
import {
  TEZOS_PASSPORT_NETWORK,
  TEZOS_PASSPORT_PORTS,
  TEZOS_PASSPORT_SCHEMA,
  TEZOS_PASSPORT_SEAL_SCHEMA,
  TEZOS_PASSPORT_STORAGE,
  TEZOS_PASSPORT_VERSION,
  TEZOS_PASSPORT_VISAS,
} from '../lib/tezos-passport';

const SAMPLE_ADDRESS = 'tz2FjJhB1gb9Xc2qNB7QgFkdBZkGCCRMxdFw';
const liveVisas = TEZOS_PASSPORT_VISAS.filter((visa) => visa.status === 'live');
const totalPoints = PASSPORT_STAMPS.reduce((sum, stamp) => sum + stamp.points, 0);
const appData = {
  version: TEZOS_PASSPORT_VERSION,
  network: TEZOS_PASSPORT_NETWORK,
  schema: TEZOS_PASSPORT_SCHEMA,
  sealSchema: TEZOS_PASSPORT_SEAL_SCHEMA,
  storage: TEZOS_PASSPORT_STORAGE,
  sampleAddress: SAMPLE_ADDRESS,
  ports: TEZOS_PASSPORT_PORTS,
  stamps: PASSPORT_STAMPS,
  visas: TEZOS_PASSPORT_VISAS,
};

const description =
  'A dual-ledger PointCast passport: private local ritual stamps on one page, public Tezos collection visas on the other, with optional wallet-signed journey seals.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/passport#tezos-passport',
  name: 'PointCast Tezos Passport',
  description,
  url: 'https://pointcast.xyz/passport',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  featureList: [
    'Browser-local PointCast ritual stamps',
    'Public Tezos holdings from TzKT',
    'Shareable wallet-address passport views',
    'Optional Beacon wallet-signed journey seals',
  ],
};
---

<BaseLayout title="Tezos Passport" description={description}>
  <main class="passport-office" data-passport-office>
    <header class="office-bar">
      <a class="office-brand" href="/" aria-label="PointCast home">
        <span aria-hidden="true">PC</span>
        <strong>PointCast</strong>
        <em>Passport Office</em>
      </a>
      <nav aria-label="Passport routes">
        <a href="/play">Play</a>
        <a href="/wallet">Wallet</a>
        <a href="/minted">Minted</a>
        <a href="/passport.json">JSON</a>
      </nav>
      <WalletConnect />
    </header>

    <section class="office-intro" aria-labelledby="passport-title">
      <div class="office-intro__copy">
        <p class="eyebrow">TEZOS MAINNET · LOCAL-FIRST · v{TEZOS_PASSPORT_VERSION}</p>
        <h1 id="passport-title">A passport with two kinds of truth.</h1>
        <p class="office-intro__dek">
          PointCast rituals stay private on this device. Public Tezos artifacts become visas.
          Connect only when you want to prove the journey belongs to your wallet.
        </p>
      </div>
      <div class="office-intro__actions">
        <button class="command command--ink" type="button" data-open-wallet>Connect Tezos</button>
        <button class="command" type="button" data-load-sample>View sample</button>
        <span class="office-status" data-office-status aria-live="polite">Visitor edition ready.</span>
      </div>
      <form class="address-desk" data-address-form>
        <label for="passport-address">Inspect a public Tezos passport</label>
        <div>
          <input
            id="passport-address"
            name="address"
            type="text"
            spellcheck="false"
            autocomplete="off"
            placeholder="tz1… / tz2… / tz3… / tz4…"
            data-address-input
          />
          <button type="submit">Open address</button>
        </div>
      </form>
    </section>

    <section class="passport-book" aria-label="PointCast Tezos passport booklet">
      <article class="passport-page identity-page">
        <div class="page-running-head">
          <span>POINTCAST</span>
          <strong>TEZOS PASSPORT</strong>
          <span data-passport-mode>VISITOR</span>
        </div>

        <div class="identity-grid">
          <div class="portrait-frame">
            <img data-passport-portrait src="https://noun.pics/137.svg" alt="Generated PointCast passport portrait" width="180" height="180" loading="eager" />
            <span data-network-badge>XTZ · MAINNET</span>
          </div>
          <dl class="identity-facts">
            <div>
              <dt>Passport no.</dt>
              <dd data-passport-id>PC-LOCAL</dd>
            </div>
            <div>
              <dt>Holder</dt>
              <dd data-holder-name>Visitor edition</dd>
            </div>
            <div>
              <dt>Port of entry</dt>
              <dd data-port>El Segundo Terminal</dd>
            </div>
            <div>
              <dt>First seen</dt>
              <dd data-first-seen>Local today</dd>
            </div>
          </dl>
        </div>

        <div class="wallet-line">
          <span>Tezos address</span>
          <code data-wallet-address>not connected</code>
        </div>

        <div class="ledger-totals" aria-label="Passport totals">
          <div>
            <span>Local stamps</span>
            <strong><span data-local-count>0</span> / {PASSPORT_STAMPS.length}</strong>
            <small><span data-local-points>0</span> / {totalPoints} points</small>
          </div>
          <div>
            <span>Tezos visas</span>
            <strong><span data-visa-count>0</span> / {liveVisas.length}</strong>
            <small><span data-token-count>0</span> artifacts held</small>
          </div>
          <div>
            <span>Chain trail</span>
            <strong data-chain-age>—</strong>
            <small><span data-chain-actions>0</span> transactions</small>
          </div>
        </div>

        <div class="privacy-mark">
          <span aria-hidden="true">LOCAL</span>
          <p><strong>This page:</strong> your PointCast stamp book. It is not attached to a wallet until you choose to seal it.</p>
        </div>
      </article>

      <article class="passport-page visa-page">
        <div class="page-running-head">
          <span>PUBLIC LEDGER</span>
          <strong>COLLECTION VISAS</strong>
          <span>{liveVisas.length} LIVE</span>
        </div>
        <div class="visa-grid" data-visa-grid>
          {TEZOS_PASSPORT_VISAS.map((visa) => (
            <article
              class:list={['visa-stamp', visa.status === 'future' && 'is-future']}
              data-visa-id={visa.id}
              data-visa-contract={visa.contract}
              data-image-kind={visa.imageKind}
              style={`--visa-accent:${visa.accent}`}
            >
              <div class="visa-stamp__head">
                <span>{visa.stampCode}</span>
                <strong data-visa-state>{visa.status === 'live' ? 'CHECKING' : 'FUTURE'}</strong>
              </div>
              <div class="visa-stamp__body">
                <div class="visa-stamp__mark" aria-hidden="true">{visa.stampCode.slice(0, 2)}</div>
                <div>
                  <p>{visa.checkpoint}</p>
                  <h2>{visa.title}</h2>
                  <span>{visa.collection} · {visa.symbol}</span>
                </div>
              </div>
              <p class="visa-stamp__note">{visa.note}</p>
              <div class="visa-stamp__tokens" data-visa-tokens>
                <span>{visa.status === 'live' ? 'Connect or inspect an address.' : 'Awaiting contract origination.'}</span>
              </div>
              <footer>
                <a href={visa.route}>Open route</a>
                {visa.contract.startsWith('KT1') ? (
                  <a href={`https://tzkt.io/${visa.contract}`} target="_blank" rel="noopener">TzKT</a>
                ) : (
                  <span>Not live yet</span>
                )}
              </footer>
            </article>
          ))}
        </div>
      </article>
    </section>

    <section class="seal-desk" aria-labelledby="seal-title">
      <div>
        <p class="eyebrow">THE SEAL DESK · OPTIONAL</p>
        <h2 id="seal-title">Sign the journey, not every footstep.</h2>
        <p>
          One Beacon signature binds the current local stamp IDs and public collection visas to your
          Tezos address. No transaction is submitted. No gas is spent. The proof stays on this device
          until you copy it.
        </p>
      </div>
      <div class="seal-controls">
        <button class="command command--seal" type="button" data-seal-journey>Seal current edition</button>
        <button class="command" type="button" data-share-public disabled>Copy public passport</button>
        <button class="command" type="button" data-copy-proof disabled>Copy signed proof</button>
        <output data-seal-status aria-live="polite">No signed edition on this device.</output>
      </div>
      <div class="seal-impression" data-seal-impression aria-hidden="true">
        <span>PC</span>
        <strong>UNSEALED</strong>
        <small>TEZOS</small>
      </div>
    </section>

    <section class="local-ledger" aria-labelledby="local-ledger-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">LOCAL LEDGER · THIS BROWSER ONLY</p>
          <h2 id="local-ledger-title">The places you actually went.</h2>
        </div>
        <p>Stamp manually, or let PointCast rituals write the same local key as you move through the site.</p>
      </header>
      <div class="local-stamp-grid">
        {PASSPORT_STAMPS.map((stamp) => (
          <article class="local-stamp" data-local-stamp={stamp.id}>
            <div>
              <span>{stamp.category}</span>
              <strong>{stamp.points}</strong>
            </div>
            <h3>{stamp.label}</h3>
            <p>{stamp.description}</p>
            <footer>
              <a href={stamp.route}>{stamp.action}</a>
              <button type="button" data-stamp-button data-stamp-id={stamp.id}>Stamp</button>
            </footer>
            <small data-stamp-state>open</small>
          </article>
        ))}
      </div>
    </section>

    <section class="passport-footnotes" aria-label="Passport notes">
      <div>
        <strong>Public view</strong>
        <p><code>/passport?address=tz…</code> shows only public TzKT data. It cannot read another visitor's local stamps.</p>
      </div>
      <div>
        <strong>Signed edition</strong>
        <p>The copied proof includes the message, payload, signature, public key, and address needed for independent verification.</p>
      </div>
      <div>
        <strong>Agent entry</strong>
        <p><a href="/passport.json">/passport.json</a> describes every visa, contract, storage key, and privacy boundary.</p>
      </div>
      <div>
        <strong>Halation</strong>
        <p><a href="https://passportz.xyz/halation" target="_blank" rel="noopener">Passport Image Diary ↗</a> · <a href="https://halation-diary.mhoydich.chatgpt.site" target="_blank" rel="noopener">Standalone Halation ↗</a></p>
      </div>
    </section>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/json" id="tezos-passport-data" is:inline set:html={JSON.stringify(appData)}></script>
  </main>
</BaseLayout>

<script>
  (function () {
    var root = document.querySelector('[data-passport-office]');
    var dataEl = document.getElementById('tezos-passport-data');
    if (!root || !dataEl) return;

    var DATA = JSON.parse(dataEl.textContent || '{}');
    var ADDRESS_RE = /^(tz1|tz2|tz3|tz4)[1-9A-HJ-NP-Za-km-z]{33}$/;
    var state = {
      address: '',
      mode: 'visitor',
      account: null,
      balances: [],
      latestProof: null,
    };

    function readJson(key, fallback) {
      try {
        var raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch (error) {
        return fallback;
      }
    }

    function writeJson(key, value) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (error) {}
    }

    function shortAddress(address) {
      return address ? address.slice(0, 7) + '…' + address.slice(-5) : 'not connected';
    }

    function hashText(value) {
      var hash = 2166136261;
      for (var index = 0; index < value.length; index += 1) {
        hash ^= value.charCodeAt(index);
        hash = Math.imul(hash, 16777619);
      }
      return hash >>> 0;
    }

    function passportId() {
      var key = DATA.storage.localPassportId;
      try {
        var existing = localStorage.getItem(key);
        if (existing) return existing;
        var bytes = new Uint8Array(4);
        crypto.getRandomValues(bytes);
        var id = 'PC-' + Array.from(bytes, function (byte) { return byte.toString(16).padStart(2, '0'); }).join('').toUpperCase();
        localStorage.setItem(key, id);
        return id;
      } catch (error) {
        return 'PC-LOCAL';
      }
    }

    function localStamps() {
      var value = readJson(DATA.storage.localStamps, {});
      return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
    }

    function localStampSummary() {
      var current = localStamps();
      var completed = DATA.stamps.filter(function (stamp) { return Boolean(current[stamp.id]); });
      return {
        ids: completed.map(function (stamp) { return stamp.id; }).sort(),
        count: completed.length,
        points: completed.reduce(function (sum, stamp) { return sum + Number(stamp.points || 0); }, 0),
      };
    }

    function setText(selector, value) {
      var el = root.querySelector(selector);
      if (el) el.textContent = String(value);
    }

    function setStatus(message, kind) {
      var status = root.querySelector('[data-office-status]');
      if (!status) return;
      status.textContent = message;
      status.setAttribute('data-kind', kind || 'quiet');
    }

    function portFor(value) {
      return DATA.ports[hashText(value) % DATA.ports.length];
    }

    function portraitFor(value) {
      return 1 + (hashText(value) % 1199);
    }

    function chainAge(firstSeen) {
      if (!firstSeen) return '—';
      var started = Date.parse(firstSeen);
      if (!Number.isFinite(started)) return '—';
      var days = Math.max(0, Math.floor((Date.now() - started) / 86400000));
      if (days < 365) return days + 'd';
      var years = Math.floor(days / 365);
      return years + 'y ' + (days % 365) + 'd';
    }

    function readConnectedWallet() {
      var stored = readJson(DATA.storage.wallet, null);
      if (stored && stored.chain === 'tezos' && ADDRESS_RE.test(stored.address || '')) return stored.address;
      try {
        var legacy = localStorage.getItem('pc:wallet-active') || '';
        return ADDRESS_RE.test(legacy) ? legacy : '';
      } catch (error) {
        return '';
      }
    }

    function tokenParts(row) {
      return {
        contract: row['token.contract.address'] || (row.token && row.token.contract && row.token.contract.address) || '',
        tokenId: String(row['token.tokenId'] !== undefined ? row['token.tokenId'] : (row.token && row.token.tokenId) || ''),
        balance: Number(row.balance || 0),
      };
    }

    function imageFor(visa, tokenId) {
      var id = Number(tokenId);
      if (visa.imageKind === 'noun') return 'https://noun.pics/' + id + '.svg';
      if (visa.imageKind === 'coffee') {
        return '/images/coffee-mugs/espresso.svg';
      }
      if (visa.imageKind === 'morning-ocean') {
        return '/images/morning-ocean/tokens/' + String(id).padStart(2, '0') + '.png';
      }
      return '';
    }

    function paintLocal() {
      var current = localStamps();
      var summary = localStampSummary();
      setText('[data-local-count]', summary.count);
      setText('[data-local-points]', summary.points);

      root.querySelectorAll('[data-local-stamp]').forEach(function (card) {
        var id = card.getAttribute('data-local-stamp');
        var collected = Boolean(current[id]);
        card.classList.toggle('is-stamped', collected);
        var button = card.querySelector('[data-stamp-button]');
        var stampState = card.querySelector('[data-stamp-state]');
        if (button) {
          button.disabled = collected;
          button.textContent = collected ? 'Stamped' : 'Stamp';
        }
        if (stampState) {
          var at = collected && current[id] && current[id].at;
          stampState.textContent = at ? 'stamped · ' + new Date(at).toLocaleDateString() : 'open';
        }
      });
    }

    function paintIdentity() {
      var id = passportId();
      var seed = state.address || id;
      var port = portFor(seed);
      var portrait = root.querySelector('[data-passport-portrait]');
      if (portrait) portrait.setAttribute('src', 'https://noun.pics/' + portraitFor(seed) + '.svg');
      setText('[data-passport-id]', state.address ? 'PC-' + hashText(state.address).toString(16).toUpperCase().padStart(8, '0') : id);
      setText('[data-passport-mode]', state.mode === 'connected' ? 'HOLDER' : state.mode === 'public' ? 'PUBLIC' : state.mode === 'sample' ? 'SAMPLE' : 'VISITOR');
      setText('[data-holder-name]', state.address ? shortAddress(state.address) : 'Visitor edition');
      setText('[data-port]', port);
      setText('[data-wallet-address]', state.address || 'not connected');
      setText('[data-first-seen]', state.account && state.account.firstActivityTime
        ? new Date(state.account.firstActivityTime).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
        : 'Local today');
      setText('[data-chain-age]', chainAge(state.account && state.account.firstActivityTime));
      setText('[data-chain-actions]', state.account && state.account.numTransactions ? Number(state.account.numTransactions).toLocaleString() : '0');
    }

    function clearTokenPreview(container, message) {
      if (!container) return;
      container.replaceChildren();
      var empty = document.createElement('span');
      empty.textContent = message;
      container.appendChild(empty);
    }

    function paintVisas() {
      var unlocked = 0;
      var totalTokens = 0;

      DATA.visas.forEach(function (visa) {
        var card = root.querySelector('[data-visa-id="' + visa.id + '"]');
        if (!card) return;
        var visaState = card.querySelector('[data-visa-state]');
        var tokensEl = card.querySelector('[data-visa-tokens]');
        if (visa.status !== 'live') {
          if (visaState) visaState.textContent = 'FUTURE';
          clearTokenPreview(tokensEl, 'Awaiting contract origination.');
          return;
        }

        var held = state.balances.map(tokenParts).filter(function (row) {
          return row.contract === visa.contract && row.balance > 0;
        });
        var heldCount = held.reduce(function (sum, row) { return sum + row.balance; }, 0);
        totalTokens += heldCount;
        if (held.length > 0) unlocked += 1;
        card.classList.toggle('is-unlocked', held.length > 0);
        if (visaState) visaState.textContent = held.length > 0 ? heldCount + ' HELD' : state.address ? 'OPEN' : 'CHECKING';

        if (!state.address) {
          clearTokenPreview(tokensEl, 'Connect or inspect an address.');
          return;
        }
        if (held.length === 0) {
          clearTokenPreview(tokensEl, 'No ' + visa.symbol + ' carried by this address.');
          return;
        }

        tokensEl.replaceChildren();
        held.slice(0, 6).forEach(function (token) {
          var link = document.createElement('a');
          link.href = 'https://objkt.com/tokens/' + visa.contract + '/' + token.tokenId;
          link.target = '_blank';
          link.rel = 'noopener';
          link.title = visa.collection + ' #' + token.tokenId + ' · balance ' + token.balance;
          var source = imageFor(visa, token.tokenId);
          if (source) {
            var image = document.createElement('img');
            image.src = source;
            image.alt = '';
            image.width = 42;
            image.height = 42;
            image.loading = 'lazy';
            image.addEventListener('error', function () { image.remove(); });
            link.appendChild(image);
          }
          var label = document.createElement('span');
          label.textContent = '#' + token.tokenId + (token.balance > 1 ? ' ×' + token.balance : '');
          link.appendChild(label);
          tokensEl.appendChild(link);
        });
      });

      setText('[data-visa-count]', unlocked);
      setText('[data-token-count]', totalTokens);
    }

    function latestProof() {
      var seals = readJson(DATA.storage.signedSeals, []);
      return Array.isArray(seals) && seals.length ? seals[0] : null;
    }

    function paintSeal() {
      state.latestProof = latestProof();
      var proof = state.latestProof;
      var status = root.querySelector('[data-seal-status]');
      var impression = root.querySelector('[data-seal-impression]');
      var copy = root.querySelector('[data-copy-proof]');
      var share = root.querySelector('[data-share-public]');
      if (share) share.disabled = !state.address;
      if (copy) copy.disabled = !proof;
      if (status) {
        status.textContent = proof
          ? 'Latest seal · ' + new Date(proof.issuedAt).toLocaleString() + ' · ' + shortAddress(proof.address)
          : 'No signed edition on this device.';
      }
      if (impression) {
        impression.classList.toggle('is-sealed', Boolean(proof));
        var strong = impression.querySelector('strong');
        if (strong) strong.textContent = proof ? 'SEALED' : 'UNSEALED';
      }
    }

    function paint() {
      paintLocal();
      paintIdentity();
      paintVisas();
      paintSeal();
    }

    async function loadAddress(address, mode) {
      if (!ADDRESS_RE.test(address || '')) {
        setStatus('That does not look like a Tezos implicit address.', 'error');
        return;
      }
      state.address = address;
      state.mode = mode || 'public';
      state.account = null;
      state.balances = [];
      paint();
      setStatus('Reading public mainnet data from TzKT…', 'loading');

      var liveContracts = DATA.visas
        .filter(function (visa) { return visa.status === 'live'; })
        .map(function (visa) { return visa.contract; })
        .join(',');
      var balanceUrl = 'https://api.tzkt.io/v1/tokens/balances' +
        '?account=' + encodeURIComponent(address) +
        '&token.contract.in=' + encodeURIComponent(liveContracts) +
        '&balance.gt=0' +
        '&select=token.contract.address,token.tokenId,balance' +
        '&limit=200';

      try {
        var results = await Promise.all([
          fetch('https://api.tzkt.io/v1/accounts/' + encodeURIComponent(address), { cache: 'no-store' }),
          fetch(balanceUrl, { cache: 'no-store' }),
        ]);
        if (!results[0].ok || !results[1].ok) throw new Error('tzkt-response');
        state.account = await results[0].json();
        var rows = await results[1].json();
        state.balances = Array.isArray(rows) ? rows : [];
        setStatus((mode === 'connected' ? 'Connected passport' : mode === 'sample' ? 'Sample passport' : 'Public passport') + ' · live from TzKT.', 'ready');
      } catch (error) {
        state.account = null;
        state.balances = [];
        setStatus('TzKT did not answer. Your local stamps are still available.', 'error');
      }
      paint();
    }

    function publicUrl(address) {
      var url = new URL('/passport', window.location.origin);
      url.searchParams.set('address', address);
      return url.toString();
    }

    async function copyText(value, success) {
      try {
        await navigator.clipboard.writeText(value);
        setStatus(success, 'ready');
      } catch (error) {
        setStatus('Clipboard unavailable. Use the address bar instead.', 'error');
      }
    }

    async function sealJourney() {
      var button = root.querySelector('[data-seal-journey]');
      if (button) button.disabled = true;
      setStatus('Opening a Tezos wallet for one signature…', 'loading');
      try {
        var tezos = await import('../lib/tezos');
        var address = await tezos.connectKukai();
        if (!ADDRESS_RE.test(address)) throw new Error('wallet-address');
        writeJson(DATA.storage.wallet, { chain: 'tezos', address: address, provider: 'kukai' });
        window.dispatchEvent(new CustomEvent('pc:wallet-change', { detail: { chain: 'tezos', address: address, provider: 'kukai' } }));
        if (state.address !== address) await loadAddress(address, 'connected');

        var local = localStampSummary();
        var visaIds = DATA.visas.filter(function (visa) {
          return state.balances.map(tokenParts).some(function (token) {
            return token.contract === visa.contract && token.balance > 0;
          });
        }).map(function (visa) { return visa.id; }).sort();
        var tokenCount = state.balances.map(tokenParts).reduce(function (sum, token) { return sum + token.balance; }, 0);
        var issuedAt = new Date().toISOString();
        var edition = {
          schema: DATA.sealSchema,
          version: DATA.version,
          issuedAt: issuedAt,
          address: address,
          passportId: 'PC-' + hashText(address).toString(16).toUpperCase().padStart(8, '0'),
          port: portFor(address),
          local: local,
          tezos: {
            network: DATA.network,
            visaIds: visaIds,
            tokenCount: tokenCount,
            firstActivityTime: state.account && state.account.firstActivityTime || null,
          },
        };
        var message = 'PointCast Tezos Passport\n' + JSON.stringify(edition);
        var signed = await tezos.signTezosPayload(message);
        var proof = Object.assign({}, edition, {
          message: message,
          payload: signed.payload,
          signature: signed.signature,
          publicKey: signed.publicKey || null,
        });
        var seals = readJson(DATA.storage.signedSeals, []);
        if (!Array.isArray(seals)) seals = [];
        seals.unshift(proof);
        writeJson(DATA.storage.signedSeals, seals.slice(0, 8));
        setStatus('Journey sealed. No transaction was submitted.', 'ready');
        paintSeal();
      } catch (error) {
        var cancelled = String(error && error.message || error).toLowerCase().includes('cancel');
        setStatus(cancelled ? 'Signature cancelled. Nothing changed.' : 'The passport could not be sealed. Try the wallet again.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    }

    root.querySelectorAll('[data-stamp-button]').forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.getAttribute('data-stamp-id');
        if (!id) return;
        var current = localStamps();
        if (!current[id]) current[id] = { id: id, at: new Date().toISOString(), via: 'tezos-passport-office' };
        writeJson(DATA.storage.localStamps, current);
        paintLocal();
        setStatus('Local stamp added. It has not left this browser.', 'ready');
      });
    });

    root.querySelector('[data-open-wallet]')?.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('pc:open-wallet-menu'));
    });
    root.querySelector('[data-load-sample]')?.addEventListener('click', function () {
      history.replaceState(null, '', publicUrl(DATA.sampleAddress));
      var input = root.querySelector('[data-address-input]');
      if (input) input.value = DATA.sampleAddress;
      loadAddress(DATA.sampleAddress, 'sample');
    });
    root.querySelector('[data-address-form]')?.addEventListener('submit', function (event) {
      event.preventDefault();
      var input = root.querySelector('[data-address-input]');
      var address = input ? input.value.trim() : '';
      if (ADDRESS_RE.test(address)) history.replaceState(null, '', publicUrl(address));
      loadAddress(address, 'public');
    });
    root.querySelector('[data-seal-journey]')?.addEventListener('click', sealJourney);
    root.querySelector('[data-share-public]')?.addEventListener('click', function () {
      if (state.address) copyText(publicUrl(state.address), 'Public wallet passport copied. Local stamps were not included.');
    });
    root.querySelector('[data-copy-proof]')?.addEventListener('click', function () {
      if (state.latestProof) copyText(JSON.stringify(state.latestProof, null, 2), 'Signed proof copied.');
    });

    window.addEventListener('pc:wallet-change', function (event) {
      var wallet = event.detail;
      if (wallet && wallet.chain === 'tezos' && ADDRESS_RE.test(wallet.address || '')) {
        loadAddress(wallet.address, 'connected');
      }
    });
    window.addEventListener('storage', function (event) {
      if (event.key === DATA.storage.localStamps || event.key === DATA.storage.signedSeals) paint();
    });

    paint();
    var queryAddress = new URLSearchParams(window.location.search).get('address') || '';
    var connectedAddress = readConnectedWallet();
    if (ADDRESS_RE.test(queryAddress)) {
      var queryInput = root.querySelector('[data-address-input]');
      if (queryInput) queryInput.value = queryAddress;
      loadAddress(queryAddress, connectedAddress === queryAddress ? 'connected' : 'public');
    } else if (connectedAddress) {
      loadAddress(connectedAddress, 'connected');
    }
  })();
</script>

