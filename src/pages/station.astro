---
/**
 * /station — Mike Hoydich Radio. The broadcaster's station page: on air now, the
 * listening wall, the play log (what, when), the station clock, the numbers, the
 * rotation, a wall of sleeves. Everything is drawn from /api/station, which counts
 * it from the station's own log (functions/api/spotify/_station.ts). All text goes
 * in through textContent; covers are only ever i.scdn.co.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import HomeMusicViz from '../components/HomeMusicViz.astro';

const title = 'Mike Hoydich Radio';
const description = 'One listener’s radio station from El Segundo: what is on air now, what has been playing and when, the station clock, heavy rotation, deep cuts, and a wall of sleeves.';
---
<BlockLayout title={title} description={description} hideAds showNetworkStrip={false} alternates={[{ type: 'application/json', href: '/station.json', title: 'Station log and numbers' }]}>
  <main class="stn" data-station>
    <header class="stn-head">
      <p class="stn-kicker"><a href="/">PointCast</a> · <a href="/c/spinning">Spinning</a> · El Segundo · 33.92°N 118.42°W</p>
      <h1>Mike Hoydich <em>Radio</em></h1>
      <p class="stn-dek">One listener’s station. Whatever is playing on Mike’s Spotify is what is on air. The log below is what has been playing, and when.</p>
      <div class="stn-dial" aria-hidden="true"><span>88</span><span>92</span><span>96</span><span>100</span><span>104</span><span>108</span><i data-dial-needle></i></div>
    </header>

    <section class="stn-air" aria-labelledby="stn-air-title" data-air data-live="false">
      <img class="stn-air__cover" data-air-cover alt="" width="300" height="300" hidden />
      <div class="stn-air__body">
        <p class="stn-lamp"><i aria-hidden="true"></i><b data-air-state>Tuning in…</b></p>
        <h2 id="stn-air-title" data-air-title>—</h2>
        <p class="stn-air__artist" data-air-artist></p>
        <p class="stn-air__actions"><a data-air-link href="/c/spinning" target="_blank" rel="noopener">Open in Spotify ↗</a><a href="/#music-on">Music on? The front door shelf →</a></p>
      </div>
    </section>

    <HomeMusicViz />

    <section class="stn-panel stn-notes" id="notes" aria-labelledby="stn-notes-title" data-notes hidden>
      <div class="stn-notes__head">
        <div>
          <p class="stn-notes__kicker" data-notes-kicker>Liner notes</p>
          <h2 id="stn-notes-title" data-notes-title>—</h2>
          <p class="stn-sub" data-notes-line></p>
        </div>
        <button type="button" class="stn-more" data-notes-back hidden>Back to what is on air</button>
      </div>
      <div class="stn-notes__grid" data-notes-grid></div>
      <p class="stn-notes__src">Text from <a href="https://en.wikipedia.org/" target="_blank" rel="noopener">Wikipedia</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>. A note appears only when the article’s own description names this artist. Nothing here is generated. Press <b>notes</b> on any play in the log to read about that one.</p>
    </section>

    <section class="stn-nums" aria-label="The station in numbers">
      <ul data-nums></ul>
      <p class="stn-note" data-window></p>
    </section>

    <section class="stn-panel stn-rw" id="rewind" aria-labelledby="stn-rw-title" data-rw hidden>
      <div class="stn-rw__head">
        <div>
          <p class="stn-notes__kicker">Rewind · Spotify’s own long view of this one account</p>
          <h2 id="stn-rw-title">The long view</h2>
          <p class="stn-sub">Spotify ranks an account’s artists and tracks over three windows: about four weeks, about six months, and a year or more. It gives ranks, not play counts, and does not say how it ranks. Everything below is those three lists set side by side.</p>
        </div>
        <div class="stn-rw__tabs" role="tablist" aria-label="Window"><button type="button" role="tab" data-rw-tab="years" aria-selected="true">All time</button><button type="button" role="tab" data-rw-tab="months" aria-selected="false">Six months</button><button type="button" role="tab" data-rw-tab="weeks" aria-selected="false">Four weeks</button></div>
      </div>
      <ol class="stn-rw__faces" data-rw-artists></ol>
      <div class="stn-rw__cols">
        <div><h3 data-rw-tracks-title>Top tracks</h3><ol class="stn-rw__tracks" data-rw-tracks></ol></div>
        <div class="stn-rw__moves">
          <div data-rw-box="newObsessions" hidden><h3>New lately</h3><p class="stn-sub">In the four-week list, in neither of the longer ones.</p><p class="stn-rw__chips"></p></div>
          <div data-rw-box="alwaysThere" hidden><h3>Always there</h3><p class="stn-sub">In all three windows at once.</p><p class="stn-rw__chips"></p></div>
          <div data-rw-box="faded" hidden><h3>Gone quiet</h3><p class="stn-sub">All-time top fifteen, absent from the last six months.</p><p class="stn-rw__chips"></p></div>
          <div data-rw-box="genres" hidden><h3>Spotify’s genre tags</h3><p class="stn-sub">From the all-time artists, weighted by rank. Spotify leaves many artists untagged.</p><p class="stn-rw__chips"></p></div>
          <div data-rw-box="decades" hidden><h3>All-time top tracks by decade</h3><div class="stn-bars" data-rw-decades></div></div>
        </div>
      </div>
      <div class="stn-rw__lib" data-rw-lib hidden></div>
      <p class="stn-notes__src" data-rw-asof></p>
    </section>

    <section class="stn-panel stn-req" id="requests" aria-labelledby="stn-req-title" data-req>
      <div class="stn-req__head">
        <div>
          <h2 id="stn-req-title">The request line</h2>
          <p class="stn-sub">Put a track in front of the station: a Spotify link and one sentence of why. People and AI agents use the same line (agents come in over <a href="/for-agents">MCP</a> as <code>station_request</code>). If the station plays it, the line says so.</p>
        </div>
        <p class="stn-req__count" data-req-count></p>
      </div>
      <form class="stn-req__form" data-req-form novalidate>
        <label><span>Spotify track link</span><input data-req-url type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://open.spotify.com/track/…" required /></label>
        <label><span>Why this one, for this station?</span><input data-req-why type="text" maxlength="200" placeholder="It sits right between the Nick Drake and the Boards of Canada." required /></label>
        <label class="stn-req__who"><span>From</span><input data-req-who type="text" maxlength="40" placeholder="your name" autocomplete="nickname" /></label>
        <button type="submit" class="stn-more">Put it on the line</button>
        <p class="stn-req__status" data-req-status role="status">Public and unverified, like the town square. A few requests an hour.</p>
      </form>
      <ol class="stn-req__list" data-req-list><li class="stn-empty">Reading the line…</li></ol>
    </section>

    <div class="stn-cols">
      <section class="stn-panel" aria-labelledby="stn-log-title">
        <h2 id="stn-log-title">What has been playing</h2>
        <p class="stn-sub">Newest first · station time (Pacific) · <b>●</b> from Spotify’s history · <b>○</b> seen by the town’s signal</p>
        <div data-log><p class="stn-empty">Reading the log…</p></div>
      </section>

      <div class="stn-side">
        <section class="stn-panel" aria-labelledby="stn-clock-title">
          <h2 id="stn-clock-title">The station clock</h2>
          <p class="stn-sub" data-clock-sub>When the station is on, hour by hour.</p>
          <div class="stn-clock" data-clock role="img" aria-label="Plays by hour of day"></div>
          <div class="stn-week" data-week role="img" aria-label="Plays by weekday"></div>
        </section>
        <section class="stn-panel" aria-labelledby="stn-era-title">
          <h2 id="stn-era-title">The station’s era</h2>
          <p class="stn-sub">Plays by the decade the record came out.</p>
          <div class="stn-bars" data-decades><p class="stn-empty">No release years in the log yet.</p></div>
          <p class="stn-meter" data-meter hidden><span>Deep cuts</span><i><b data-meter-fill></b></i><span>Chart hits</span></p>
          <p class="stn-sub" data-meter-note hidden></p>
        </section>
      </div>
    </div>

    <section class="stn-panel" aria-labelledby="stn-rot-title">
      <h2 id="stn-rot-title">Start here</h2>
      <p class="stn-sub">The station’s own recommendations, counted from the log. No algorithm: what gets played again, what just arrived, and what almost nobody else is playing.</p>
      <div class="stn-shelves">
        <div><h3>Heavy rotation</h3><ol data-list="heavyRotation"><li class="stn-empty">Needs a track played twice.</li></ol></div>
        <div><h3>New this week</h3><ol data-list="newThisWeek"><li class="stn-empty">Nothing new in the log yet.</li></ol></div>
        <div><h3>Deep cuts</h3><ol data-list="deepCuts"><li class="stn-empty">Needs popularity data from Spotify.</li></ol></div>
        <div><h3>Artists on the station</h3><ol data-list="topArtists"><li class="stn-empty">No artists in the log yet.</li></ol></div>
      </div>
    </section>

    <section class="stn-panel" aria-labelledby="stn-wall-title">
      <h2 id="stn-wall-title">The wall of sleeves</h2>
      <p class="stn-sub">Every cover the station has played lately, newest first.</p>
      <div class="stn-sleeves" data-sleeves><p class="stn-empty">The wall fills as the station plays.</p></div>
    </section>

    <section class="stn-panel stn-how" aria-labelledby="stn-how-title">
      <h2 id="stn-how-title">How the station works</h2>
      <p>PointCast does not stream audio. The station is a public log of what Mike’s Spotify account played, kept on purpose by the broadcaster. Two sources feed it: what the town’s now-playing signal saw while someone was here to ask, and Spotify’s recently-played list when the broadcaster has allowed it. Every number on this page is counted from that log. Nothing here guesses how a track sounds.</p>
      <p data-scope-note hidden></p>
      <p class="stn-how__links"><a href="/station.json">station.json</a><a href="/now-playing.json">now-playing.json</a><a href="/listening-room">The listening room</a><a href="/privacy">Privacy</a><a href="/api/spotify/auth?returnTo=/station" data-manage hidden>Broadcaster: reauthorize Spotify (adds history)</a><button type="button" data-companion hidden aria-pressed="false">Broadcaster: show what is on air next to my face in town</button><button type="button" data-erase hidden>Broadcaster: erase the log</button></p>
    </section>
  </main>
</BlockLayout>

<script>
  type Play = { id: string; t: string; a: string; al?: string; img?: string; url: string; at: string; src: 'seen' | 'spotify' };
  type Card = { t?: string; a?: string; name?: string; img?: string; url?: string; plays?: number; pop?: number; genres?: string[] };
  const TZ = 'America/Los_Angeles';
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };
  const cover = (src: string | undefined, size: number) => { const i = el('img'); i.alt = ''; i.width = size; i.height = size; i.loading = 'lazy'; i.decoding = 'async'; if (src && src.startsWith('https://i.scdn.co/')) i.src = src; else i.dataset.blank = 'true'; return i; };
  const spotify = (u?: string) => (u && u.startsWith('https://open.spotify.com/') ? u : '');
  const ago = (iso: string) => { const m = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000)); return m < 1 ? 'just now' : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.round(m / 60)} h ago` : `${Math.round(m / 1440)} d ago`; };
  const hourName = (h: number) => `${h % 12 || 12} ${h < 12 ? 'am' : 'pm'}`;

  function mountStation() {
    const root = document.querySelector<HTMLElement>('[data-station]');
    if (!root || root.dataset.mounted) return; root.dataset.mounted = 'true';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    function paintAir(n: Record<string, unknown> | null, lastPlay: Play | undefined) {
      const air = $('[data-air]'), live = Boolean(n && n.live);
      const t = live ? String(n!.title || '') : lastPlay?.t || String(n?.title || ''), a = live ? String(n!.artist || '') : lastPlay?.a || String(n?.artist || '');
      air.dataset.live = String(live);
      $('[data-air-state]').textContent = live ? 'On air now' : lastPlay ? `Off air · last played ${ago(lastPlay.at)}` : 'Off air';
      $('[data-air-title]').textContent = t || 'Nothing on the log yet'; $('[data-air-artist]').textContent = a;
      const img = $<HTMLImageElement>('[data-air-cover]'), src = live ? String(n!.image || '') : lastPlay?.img || String(n?.image || '');
      if (src.startsWith('https://i.scdn.co/')) { img.src = src; img.hidden = false; } else img.hidden = true;
      const link = $<HTMLAnchorElement>('[data-air-link]'), href = spotify(live ? String(n!.url || '') : lastPlay?.url || String(n?.url || '')); if (href) link.href = href;
      // The needle sits somewhere on the dial for each track: decoration, seeded by the title.
      let h = 0; for (const c of t) h = (h * 31 + c.charCodeAt(0)) >>> 0; $('[data-dial-needle]').style.left = `${6 + (h % 880) / 10}%`;
    }

    function paintNums(s: Record<string, number | string | null>, from: string | null) {
      const items: [string, string, string][] = [
        [String(s.plays ?? 0), 'plays logged', ''],
        [s.minutes ? `${Math.round(Number(s.minutes) / 60 * 10) / 10}` : '—', 'hours on air', s.minutes ? '' : 'needs durations'],
        [String(s.daysOnAir ?? 0), 'days on air', s.streakDays ? `${s.streakDays}-day streak` : ''],
        [String(s.distinctArtists ?? 0), 'artists', `${s.distinctTracks ?? 0} tracks`],
        [s.plays ? `${Math.round(Number(s.repeatShare) * 100)}%` : '—', 'replays', 'plays of a track already in the log'],
        [s.signature ? String(s.signature) : '—', 'kind of station', s.peakHour !== null && s.peakHour !== undefined ? `busiest around ${hourName(Number(s.peakHour))}` : ''],
      ];
      $('[data-nums]').replaceChildren(...items.map(([v, k, n]) => { const li = el('li'); li.append(el('b', '', v), el('span', '', k)); if (n) li.append(el('small', '', n)); return li; }));
      $('[data-window]').textContent = from ? `Log opened ${new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: TZ }).format(new Date(from))}. The page shows this month and last.` : 'The log is empty. It starts filling the next time the station is on air.';
    }

    function paintLog(plays: Play[]) {
      const box = $('[data-log]'); if (!plays.length) { box.replaceChildren(el('p', 'stn-empty', 'Nothing logged yet. The first track the station plays will show up here.')); return; }
      const dayFmt = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: TZ }), timeFmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: TZ });
      const nodes: HTMLElement[] = []; let day = '', list: HTMLOListElement | null = null;
      for (const p of plays) {
        const d = dayFmt.format(new Date(p.at)); if (d !== day) { day = d; nodes.push(el('h3', 'stn-day', d)); list = el('ol', 'stn-log'); nodes.push(list); }
        const li = el('li'); const time = el('time', '', timeFmt.format(new Date(p.at))); time.dateTime = p.at;
        const a = el('a'); a.href = spotify(p.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; a.append(el('b', '', p.t), el('span', '', p.a));
        const src = el('i', '', p.src === 'spotify' ? '●' : '○'); src.title = p.src === 'spotify' ? 'From Spotify’s recently-played list' : 'Seen by the town’s now-playing signal';
        const nb = el('button', 'stn-log__notes', 'notes'); nb.type = 'button'; nb.setAttribute('aria-label', `Liner notes for ${p.t} by ${p.a}`);
        nb.addEventListener('click', () => { void showNotes({ t: p.t, a: p.a, al: p.al, yr: (p as Play & { yr?: number }).yr }, true); });
        li.append(time, cover(p.img, 40), a, nb, src); list!.append(li);
      }
      box.replaceChildren(...nodes);
      // Keep the column the height of its neighbours: two dozen rows, the rest behind one button.
      const rows = [...box.querySelectorAll<HTMLElement>('.stn-log li')]; if (rows.length <= 24 || box.dataset.open === 'true') return;
      rows.slice(24).forEach((r) => { r.hidden = true; });
      box.querySelectorAll<HTMLElement>('.stn-day, .stn-log').forEach((n) => { if (n.matches('.stn-log') ? !n.querySelector('li:not([hidden])') : !(n.nextElementSibling as HTMLElement | null)?.querySelector('li:not([hidden])')) n.hidden = true; });
      const more = el('button', 'stn-more', `Show all ${rows.length} plays`); more.type = 'button';
      more.addEventListener('click', () => { box.dataset.open = 'true'; box.querySelectorAll<HTMLElement>('[hidden]').forEach((n) => { n.hidden = false; }); more.remove(); });
      box.append(more);
    }

    function paintClock(byHour: number[], byWeekday: number[], sub: string) {
      const NS = 'http://www.w3.org/2000/svg', max = Math.max(1, ...byHour), svg = document.createElementNS(NS, 'svg'); svg.setAttribute('viewBox', '-110 -110 220 220');
      const mk = (tag: string, attrs: Record<string, string | number>) => { const n = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v)); return n; };
      svg.append(mk('circle', { r: 38, class: 'stn-clock__hub' }));
      byHour.forEach((n, h) => {
        const a0 = (h / 24) * Math.PI * 2 - Math.PI / 2 + .02, a1 = ((h + 1) / 24) * Math.PI * 2 - Math.PI / 2 - .02, r0 = 40, r1 = 40 + 8 + 52 * (n / max);
        const pt = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
        const wedge = mk('path', { d: `M${pt(r0, a0)} L${pt(r1, a0)} A${r1} ${r1} 0 0 1 ${pt(r1, a1)} L${pt(r0, a1)} A${r0} ${r0} 0 0 0 ${pt(r0, a0)}Z`, class: n ? (h >= 19 || h < 5 ? 'stn-clock__w stn-clock__w--night' : 'stn-clock__w') : 'stn-clock__w stn-clock__w--off' });
        const tip = document.createElementNS(NS, 'title'); tip.textContent = `${hourName(h)}: ${n} play${n === 1 ? '' : 's'}`; wedge.append(tip); svg.append(wedge);
      });
      [[0, '12a'], [6, '6a'], [12, '12p'], [18, '6p']].forEach(([h, label]) => { const a = (Number(h) / 24) * Math.PI * 2 - Math.PI / 2; const tx = mk('text', { x: (26 * Math.cos(a)).toFixed(1), y: (26 * Math.sin(a) + 3).toFixed(1), class: 'stn-clock__t' }); tx.textContent = String(label); svg.append(tx); });
      $('[data-clock]').replaceChildren(svg); $('[data-clock-sub]').textContent = sub;
      const wmax = Math.max(1, ...byWeekday);
      $('[data-week]').replaceChildren(...['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d, i) => { const c = el('span'); const bar = el('i'); bar.style.height = `${6 + 44 * (byWeekday[i] / wmax)}px`; if (!byWeekday[i]) bar.dataset.off = 'true'; c.title = `${d}: ${byWeekday[i]} plays`; c.append(bar, el('small', '', d)); return c; }));
    }

    function paintEra(decades: { decade: number; plays: number }[], pop: number | null, explicitShare: number) {
      if (decades.length) { const max = Math.max(...decades.map((d) => d.plays)); $('[data-decades]').replaceChildren(...decades.map((d) => { const row = el('p'); const bar = el('i'); bar.style.width = `${Math.max(3, 100 * d.plays / max)}%`; row.append(el('span', '', `${d.decade}s`), bar, el('b', '', String(d.plays))); return row; })); }
      if (pop !== null) { $('[data-meter]').hidden = false; $('[data-meter-fill]').style.left = `${pop}%`; const note = $('[data-meter-note]'); note.hidden = false; note.textContent = `Average Spotify popularity ${pop} of 100${explicitShare ? ` · ${Math.round(explicitShare * 100)}% marked explicit` : ''}.`; }
    }

    function paintList(name: string, items: Card[]) {
      const ol = root.querySelector<HTMLElement>(`[data-list="${name}"]`); if (!ol || !items.length) return;
      ol.replaceChildren(...items.slice(0, 8).map((c) => {
        const li = el('li'), a = el('a'); a.href = spotify(c.url) || '#'; if (spotify(c.url)) { a.target = '_blank'; a.rel = 'noopener'; }
        a.append(cover(c.img, 44), (() => { const s = el('span'); s.append(el('b', '', c.t || c.name || ''), el('small', '', [c.a, c.plays ? `${c.plays} play${c.plays === 1 ? '' : 's'}` : '', typeof c.pop === 'number' ? `popularity ${c.pop}` : ''].filter(Boolean).join(' · '))); return s; })());
        li.append(a); return li;
      }));
    }

    // ── liner notes: sourced, never generated (functions/api/station/notes.ts) ──
    type Focus = { t: string; a: string; al?: string; yr?: number };
    let airFocus: Focus | null = null, shownKey = '', pinned = false;
    async function showNotes(f: Focus, byHand = false) {
      const key = `${f.t}|${f.a}`; if (!byHand && (pinned || key === shownKey)) return;
      shownKey = key; pinned = byHand && key !== (airFocus ? `${airFocus.t}|${airFocus.a}` : '');
      const box = $('[data-notes]'), grid = $('[data-notes-grid]');
      $('[data-notes-kicker]').textContent = pinned ? 'Liner notes · from the log' : 'Liner notes · on the station now';
      $('[data-notes-title]').textContent = `${f.t} — ${f.a}`;
      const age = f.yr ? new Date().getFullYear() - f.yr : 0;
      $('[data-notes-line]').textContent = f.yr ? `Released ${f.yr}${age > 0 ? ` · ${age} year${age === 1 ? '' : 's'} ago` : ' · this year'}${f.al ? ` · on ${f.al}` : ''}` : (f.al ? `On ${f.al}` : '');
      $('[data-notes-back]').hidden = !pinned; box.hidden = false; grid.replaceChildren(el('p', 'stn-empty', 'Looking through the stacks…'));
      if (byHand) box.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      let j: { notes?: { kind: string; title: string; description: string; extract: string; url: string; image?: string }[] } | null = null;
      try { const r = await fetch(`/api/station/notes?${new URLSearchParams({ title: f.t, artist: f.a, ...(f.al ? { album: f.al } : {}) })}`, { headers: { accept: 'application/json' } }); j = r.ok ? await r.json() : null; } catch { /* below */ }
      if (shownKey !== key) return; // a newer request won
      const notes = j?.notes ?? [];
      if (!notes.length) { grid.replaceChildren(el('p', 'stn-empty', j ? 'No article could be matched with confidence for this one, so there is nothing to show. Better blank than wrong.' : 'The stacks are not answering right now.')); return; }
      const label: Record<string, string> = { song: 'The song', record: 'The record', artist: 'The artist' };
      grid.replaceChildren(...notes.map((n) => {
        const card = el('article', 'stn-liner'); card.dataset.kind = n.kind;
        if (n.image && /^https:\/\/(upload|thumb)\.wikimedia\.org\/wikipedia\/commons\//.test(n.image)) { const i = el('img'); i.src = n.image; i.alt = ''; i.loading = 'lazy'; card.append(i); }
        const a = el('a', '', 'Read the rest on Wikipedia ↗'); a.href = n.url.startsWith('https://en.wikipedia.org/wiki/') ? n.url : 'https://en.wikipedia.org/'; a.target = '_blank'; a.rel = 'noopener';
        card.append(el('h3', '', label[n.kind] || n.kind), el('p', 'stn-liner__title', n.title), el('p', 'stn-liner__desc', n.description), el('p', 'stn-liner__text', n.extract), a); return card;
      }));
    }
    $('[data-notes-back]').addEventListener('click', () => { pinned = false; shownKey = ''; if (airFocus) void showNotes(airFocus); });

    // ── rewind: Spotify's three windows, side by side (needs user-top-read; library needs user-library-read) ──
    let rewind: Record<string, any> | null = null, rwTab = 'years';
    function paintRewind(rw: Record<string, any> | null) {
      const box = $('[data-rw]'); rewind = rw;
      const any = rw && ['weeks', 'months', 'years'].some((k) => (rw.artists?.[k] || []).length || (rw.tracks?.[k] || []).length);
      box.hidden = !any; if (!any || !rw) return;
      const faces = (rw.artists[rwTab] || []) as Card[];
      $('[data-rw-artists]').replaceChildren(...faces.map((c, i) => { const li = el('li'), a = el('a'); a.href = spotify(c.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; a.append(cover(c.img, 120), el('small', '', String(i + 1).padStart(2, '0')), el('b', '', c.name || ''), el('span', '', (c.genres || []).slice(0, 2).join(' · '))); li.append(a); return li; }));
      $('[data-rw-tracks-title]').textContent = `Top tracks · ${rw.windows?.[rwTab] || ''}`;
      $('[data-rw-tracks]').replaceChildren(...((rw.tracks[rwTab] || []) as (Card & { yr?: number })[]).map((c) => { const li = el('li'), a = el('a'); a.href = spotify(c.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; const sp = el('span'); sp.append(el('b', '', c.t || ''), el('small', '', [c.a, c.yr].filter(Boolean).join(' · '))); a.append(cover(c.img, 44), sp); li.append(a); const nb = el('button', 'stn-log__notes', 'notes'); nb.type = 'button'; nb.addEventListener('click', () => { void showNotes({ t: c.t || '', a: c.a || '', yr: c.yr }, true); }); li.append(nb); return li; }));
      const chips = (name: string, items: string[]) => { const b = root.querySelector<HTMLElement>(`[data-rw-box="${name}"]`)!; b.hidden = !items.length; b.querySelector('.stn-rw__chips')!.replaceChildren(...items.map((t) => el('span', '', t))); };
      chips('newObsessions', (rw.newObsessions || []).map((x: Card) => x.name)); chips('alwaysThere', (rw.alwaysThere || []).map((x: Card) => x.name)); chips('faded', (rw.faded || []).map((x: Card) => x.name)); chips('genres', rw.genres || []);
      const dec = (rw.topTrackDecades || []) as { decade: number; tracks: number }[], dbox = root.querySelector<HTMLElement>('[data-rw-box="decades"]')!; dbox.hidden = !dec.length;
      if (dec.length) { const max = Math.max(...dec.map((d) => d.tracks)); $('[data-rw-decades]').replaceChildren(...dec.map((d) => { const row = el('p'), bar = el('i'); bar.style.width = `${Math.max(3, 100 * d.tracks / max)}%`; row.append(el('span', '', `${d.decade}s`), bar, el('b', '', String(d.tracks))); return row; })); }
      const lib = $('[data-rw-lib]'), L = rw.library; lib.hidden = !L;
      if (L) {
        const fmt = (iso: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: TZ }).format(new Date(iso)); const nodes: HTMLElement[] = [el('h3', '', 'The saved library')];
        const line = el('p', 'stn-rw__first'); line.append(el('b', '', `${Number(L.total).toLocaleString('en-US')} saved songs.`)); if (L.first) { line.append(' The first one ever saved: '); const a = el('a', '', `${L.first.t} — ${L.first.a}`); a.href = spotify(L.first.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; line.append(a, `, on ${fmt(L.first.savedAt)}.`); } nodes.push(line);
        if ((L.latest || []).length) { const ol = el('ol', 'stn-rw__saves'); ol.append(...L.latest.map((x: Record<string, string>) => { const li = el('li'), a = el('a'); a.href = spotify(x.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; a.append(cover(x.img, 40), el('b', '', x.t), el('span', '', x.a), el('small', '', fmt(x.savedAt))); li.append(a); return li; })); nodes.push(el('p', 'stn-sub', 'Latest saves'), ol); }
        lib.replaceChildren(...nodes);
      }
      $('[data-rw-asof]').textContent = `As Spotify had it on ${new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeStyle: 'short', timeZone: TZ }).format(new Date(rw.asOf))} Pacific. Refreshed twice a day.`;
    }
    root.querySelectorAll<HTMLButtonElement>('[data-rw-tab]').forEach((b) => b.addEventListener('click', () => { rwTab = b.dataset.rwTab!; root.querySelectorAll('[data-rw-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b))); paintRewind(rewind); }));

    async function load() {
      let j: Record<string, any> | null = null;
      try { const r = await fetch('/api/station', { headers: { accept: 'application/json' } }); j = r.ok ? await r.json() : null; } catch { /* below */ }
      if (!j) { $('[data-air-state]').textContent = 'The station desk is not answering. Try again in a minute.'; $('[data-log]').replaceChildren(el('p', 'stn-empty', 'The log could not be read just now.')); return; }
      const recent: Play[] = Array.isArray(j.recent) ? j.recent : [], s = j.stats || {};
      paintAir(j.onAir || null, recent[0]); paintNums(s, j.window?.from ?? null); paintLog(recent);
      // Notes follow what is on air; off air they stay with the last thing played.
      const air = j.onAir && j.onAir.live ? j.onAir : null, match = air ? recent.find((p) => p.id === air.trackId) : recent[0];
      airFocus = match ? { t: match.t, a: match.a, al: match.al, yr: (match as Play & { yr?: number }).yr } : air ? { t: String(air.title), a: String(air.artist) } : null;
      if (airFocus) void showNotes(airFocus);
      paintClock(s.byHour || new Array(24).fill(0), s.byWeekday || new Array(7).fill(0), s.signature ? `${s.signature === 'Late night' ? 'A late-night' : `A${/^[AE]/.test(s.signature) ? 'n' : ''} ${String(s.signature).toLowerCase()}`} station. Busiest around ${hourName(Number(s.peakHour))}, Pacific.` : 'When the station is on, hour by hour. Fills in as the log grows.');
      paintEra(s.decades || [], s.averagePopularity ?? null, s.explicitShare || 0);
      for (const name of ['heavyRotation', 'newThisWeek', 'deepCuts', 'topArtists']) paintList(name, s[name] || []);
      paintRewind(j.rewind || null);
      const covers: string[] = Array.isArray(j.covers) ? j.covers : [];
      if (covers.length) $('[data-sleeves]').replaceChildren(...covers.map((c) => cover(c, 96)));
      const scope = $('[data-scope-note]'), src = j.sources || {};
      if (src.history !== true) { scope.hidden = false; scope.textContent = src.history === false ? 'Right now the log only has what the town’s signal saw: Spotify has not been asked for play history. When the broadcaster reconnects Spotify, exact history and the long view fill in.' : 'The station has not checked Spotify’s play history yet. Until it does, the log only has what the town’s signal saw.'; }
    }
    void load();
    const t = setInterval(() => { if (document.visibilityState === 'visible') void load(); }, 90000);
    document.addEventListener('astro:before-swap', () => clearInterval(t), { once: true });

    // ── the request line ───────────────────────────────────────────
    const reqList = $('[data-req-list]'), reqStatus = $('[data-req-status]'), reqForm = $<HTMLFormElement>('[data-req-form]');
    const who = $<HTMLInputElement>('[data-req-who]'); try { who.value = localStorage.getItem('pc:station:who') || ''; } catch {}
    let canManage = false;
    const art = (src?: string) => { const i = el('img'); i.alt = ''; i.width = 48; i.height = 48; i.loading = 'lazy'; if (src && /^https:\/\/(i\.scdn\.co|[a-z0-9-]+\.spotifycdn\.com)\//.test(src)) i.src = src; else i.dataset.blank = 'true'; return i; };
    async function loadRequests() {
      let j: Record<string, any> | null = null; try { const r = await fetch('/api/station/requests', { headers: { accept: 'application/json' } }); j = r.ok ? await r.json() : null; } catch { /* below */ }
      if (!j) { reqList.replaceChildren(el('li', 'stn-empty', 'The line could not be read just now.')); return; }
      $('[data-req-count]').textContent = j.requests.length ? `${j.open} waiting · ${j.played} played` : '';
      if (!j.requests.length) { reqList.replaceChildren(el('li', 'stn-empty', 'Nobody has asked for anything yet. The first request is yours.')); return; }
      reqList.replaceChildren(...j.requests.map((r: Record<string, any>) => {
        const li = el('li'); if (r.playedAt) li.dataset.played = 'true';
        const a = el('a'); a.href = spotify(r.url) || '#'; a.target = '_blank'; a.rel = 'noopener'; a.append(el('b', '', r.title), el('span', '', r.artist));
        const from = el('p', 'stn-req__from'); from.append(el('span', '', `${r.who}`)); if (r.via === 'agent') from.append(el('i', '', 'AI')); from.append(el('small', '', ` · ${ago(r.at)}`));
        const body = el('div'); body.append(a, el('p', 'stn-req__why', `“${r.why}”`), from);
        const state = el('p', 'stn-req__state', r.playedAt ? `✓ played ${new Intl.DateTimeFormat('en-US', { weekday: 'short', hour: 'numeric', minute: '2-digit', timeZone: TZ }).format(new Date(r.playedAt))}` : 'waiting');
        li.append(art(r.image), body, state);
        if (canManage) { const x = el('button', 'stn-req__x', 'remove'); x.type = 'button'; x.addEventListener('click', async () => { const d = await fetch(`/api/station/requests?id=${encodeURIComponent(r.id)}`, { method: 'DELETE' }); if (d.ok) void loadRequests(); }); li.append(x); }
        return li;
      }));
    }
    reqForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const url = $<HTMLInputElement>('[data-req-url]'), why = $<HTMLInputElement>('[data-req-why]');
      const say = (t: string, tone = '') => { reqStatus.textContent = t; reqStatus.dataset.tone = tone; };
      if (!/^(https?:\/\/open\.spotify\.com\/(intl-[a-z]{2,5}\/)?track\/|spotify:track:)/.test(url.value.trim())) { say('That needs to be a Spotify track link. In Spotify: Share → Copy song link.', 'warn'); url.focus(); return; }
      if (why.value.trim().length < 8) { say('Say why in a sentence. The reason is the point of a request.', 'warn'); why.focus(); return; }
      try { localStorage.setItem('pc:station:who', who.value.trim()); } catch {}
      const noun = Number((document.querySelector<HTMLImageElement>('[data-pc-ref="fb-noun"]')?.src.match(/(\d+)\.svg/) || [])[1]);
      say('Looking it up with Spotify…');
      try {
        const r = await fetch('/api/station/requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url: url.value.trim(), why: why.value.trim(), who: who.value.trim(), ...(Number.isInteger(noun) ? { noun } : {}), via: 'page' }) });
        const j = await r.json().catch(() => null);
        if (!r.ok || !j?.ok) { say(j?.error || 'The line did not take that. Nothing was saved.', 'warn'); return; }
        say(`On the line: ${j.request.title} — ${j.request.artist}. If the station plays it, this page will say so.`, 'ok'); url.value = ''; why.value = ''; void loadRequests();
      } catch { say('The line could not be reached. Nothing was saved.', 'warn'); }
    });
    void loadRequests();

    // Broadcaster-only controls. The server checks the role again on every action.
    fetch('/api/spotify/broadcast', { headers: { accept: 'application/json' } }).then((r) => (r.ok ? r.json() : null)).then((b) => {
      if (!b?.canManage) return; canManage = true; void loadRequests();
      $('[data-manage]').hidden = false; const erase = $<HTMLButtonElement>('[data-erase]'); erase.hidden = false;
      // The companion: the on-air track rides next to the broadcaster's face everywhere in town (cursor-room reads pc:music:auto).
      const comp = $<HTMLButtonElement>('[data-companion]'); comp.hidden = false;
      const paintComp = () => { let on = false; try { on = localStorage.getItem('pc:music:auto') === 'station'; } catch {} comp.setAttribute('aria-pressed', String(on)); comp.textContent = on ? 'Broadcaster: on-air track is showing next to my face · turn off' : 'Broadcaster: show what is on air next to my face in town'; };
      comp.addEventListener('click', () => { try { if (localStorage.getItem('pc:music:auto') === 'station') localStorage.removeItem('pc:music:auto'); else localStorage.setItem('pc:music:auto', 'station'); } catch {} paintComp(); window.dispatchEvent(new CustomEvent('pc:music:auto')); });
      paintComp();
      erase.addEventListener('click', async () => { if (!confirm('Erase the whole station log? This cannot be undone.')) return; const r = await fetch('/api/station', { method: 'DELETE' }); erase.textContent = r.ok ? 'Log erased' : 'Could not erase'; if (r.ok) void load(); });
    }).catch(() => {});
  }
