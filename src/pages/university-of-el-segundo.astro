---
import BlockLayout from '../layouts/BlockLayout.astro';
import gallery from '../data/el-segundo-school-gallery.json';
import { ONLINE_SEASON_ONE, UES_SEASON_ONE_BUDGET, UES_SEASON_ONE_COURSES } from '../lib/ues-classes';
import {
  ONLINE_SEASON_ZERO,
  UES_CITY_TIERS,
  UES_COURSES,
  UES_FIELD_BUDGET,
  UES_FUNDING_MILESTONES,
  UES_GOVERNANCE,
  UES_ONLINE_BUDGET,
  UES_PROGRAM,
  UES_SATELLITE_MODEL,
  UES_SCALE_SCENARIOS,
  UES_SOURCES,
} from '../lib/ues-program';

const title = 'Fund the University of El Segundo';
const description =
  'The public operating and funding program for an online-first, locally authored University of El Segundo: two online terms, transparent costs, a 25-mile field layer, and Tezos contribution paths.';
const assetOrigin = 'https://el-segundo-school-archive.pages.dev';
const UES_FUND_WALLET = 'tz2FjJhB1gb9Xc2qNB7QgFkdBZkGCCRMxdFw';
const featuredNumbers = new Set(['001', '141', '253', '317', '365', '501']);
const featuredWorks = gallery.works.filter((work) => featuredNumbers.has(work.number));
const artUrl = (src: string) => `${assetOrigin}${src.replace('/images/el-segundo-school', '')}`;
const formatUsd = (value: number) => `$${value.toLocaleString('en-US')}`;
const sources = Object.values(UES_SOURCES);
const activeClassHelpHref = `mailto:${UES_PROGRAM.contact}?subject=${encodeURIComponent('University of El Segundo — self-paced class help')}`;
const teachHref = `mailto:${UES_PROGRAM.contact}?subject=${encodeURIComponent('University of El Segundo — course proposal')}`;
const partnerHref = `mailto:${UES_PROGRAM.contact}?subject=${encodeURIComponent('University of El Segundo — local partner space')}`;

const contributionOptions = [
  { amount: 1, label: 'Signal', note: 'Put a public receipt on the board.' },
  { amount: 10, label: 'Materials', note: 'Strengthen the shared materials pool.' },
  { amount: 50, label: 'Access', note: 'Support learner access and participation.' },
  { amount: 250, label: 'Faculty', note: 'Move the teaching pool forward.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': 'https://pointcast.xyz/university-of-el-segundo',
  name: UES_PROGRAM.name,
  description,
  url: UES_PROGRAM.home,
  founder: { '@type': 'Person', name: 'Michael Hoydich' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'El Segundo',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'University of El Segundo online terms',
    itemListElement: [...UES_COURSES, ...UES_SEASON_ONE_COURSES].map((course) => ({
      '@type': 'Course',
      name: course.title,
      courseCode: course.code,
      description: course.frame,
      provider: { '@type': 'EducationalOrganization', name: UES_PROGRAM.name },
    })),
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image={featuredWorks[0] ? artUrl(featuredWorks[0].src) : undefined}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/university-of-el-segundo.json', title: 'UES program data' }]}
>
  <div class="ues">
    <header class="ues-nav">
      <a class="ues-nav__mark" href="/">POINTCAST</a>
      <nav aria-label="University program sections">
        <a href="/ues">Class catalog</a>
        <a href="#program">Program</a>
        <a href="#courses">Classes</a>
        <a href="#next-term">Active term</a>
        <a href="#budget">Costs</a>
        <a href="#local">25-mile layer</a>
        <a href="/ues/radius">Signal lab</a>
        <a href="#scale">Scale</a>
        <a class="ues-nav__fund" href="#fund">Contribute</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="ues-title">
      <div class="hero__copy">
        <p class="eyebrow">UNIVERSITY OF EL SEGUNDO · TEN ACTIVE ONLINE CLASSES · START ANYTIME</p>
        <h1 id="ues-title">Fund a university that starts with the place it is in.</h1>
        <p class="hero__dek">
          Local knowledge. Paid teachers. Tuition-free learners. Public notes and receipts.
          First online, then El Segundo and the 25-mile radius, then locally authored satellites
          that keep their own character.
        </p>
        <div class="hero__actions">
          <a class="button button--acid" href="#fund">Contribute on Tezos</a>
          <a class="button" href="/ues#current-term">Start a class</a>
          <a class="button" href="/ues">Enter the class catalog</a>
          <a class="button" href="/ues/radius">Open RADIUS / 90245</a>
        </div>
        <dl class="hero__facts">
          <div><dt>Active model</dt><dd>Self-paced</dd></div>
          <div><dt>Supported learners planned</dt><dd>{ONLINE_SEASON_ONE.planningLearners}</dd></div>
          <div><dt>Courses outlined</dt><dd>{UES_COURSES.length + UES_SEASON_ONE_COURSES.length}</dd></div>
          <div><dt>Active-term target</dt><dd>{formatUsd(UES_SEASON_ONE_BUDGET.totalUsd)}</dd></div>
        </dl>
      </div>

      <div class="hero__archive" aria-label="Works from The El Segundo School archive">
        {featuredWorks.slice(0, 4).map((work) => (
          <a href="/el-segundo-school#gallery" aria-label={`Open archive work ${work.number}: ${work.title}`}>
            <img
              src={artUrl(work.thumb)}
              alt=""
              width={work.width}
              height={work.height}
              loading="eager"
            />
            <span>{work.number} · SET {String(work.set).padStart(3, '0')}</span>
          </a>
        ))}
        <p>ART IS PART OF THE OPERATING SYSTEM · 652 WORKS BY MICHAEL HOYDICH</p>
      </div>
    </section>

    <section class="manifesto" aria-label="University character">
      <p>LOCAL</p><p>LOCAL</p><p>LOCAL</p>
      <blockquote>“{UES_PROGRAM.character}”</blockquote>
      <p class="manifesto__credit">MICHAEL HOYDICH · EL SEGUNDO · 2026</p>
    </section>

    <section class="program section" id="program" aria-labelledby="program-title">
      <div class="section__intro">
        <p class="eyebrow">01 · HOW THE ACTIVE SCHOOL RUNS</p>
        <h2 id="program-title">A small school with a repeatable rhythm.</h2>
        <p>
          Online Season 1 is active now. Choose any class, move through six self-guided modules,
          complete any four field receipts, and finish one private or public outcome. No account,
          application, deadline, live attendance, peer response, public post, or wallet is required.
        </p>
      </div>
      <div class="rhythm">
        <article>
          <span>01</span>
          <h3>Start anytime</h3>
          <strong>Six readable modules</strong>
          <p>The complete sequence is public and usable without an account. Pause and return on your own schedule.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Field task</h3>
          <strong>One local act</strong>
          <p>Observe, map, study, make, host, repair, listen, or use the equivalent safe indoor and paper path.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Private receipt</h3>
          <strong>Local progress</strong>
          <p>Checkmarks stay in the learner’s browser. A private self-attested completion file is optional.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Human support</h3>
          <strong>Optional, when funded</strong>
          <p>Faculty review, cohorts, access help, and material grants add care without becoming permission to learn.</p>
        </article>
      </div>
      <div class="open-calls">
        <a href="/ues#current-term"><b>Learn</b><span>Start an active class →</span></a>
        <a href={teachHref}><b>Teach</b><span>Propose a six-week course →</span></a>
        <a href={partnerHref}><b>Host</b><span>Offer a local room or field site →</span></a>
        <a href="#fund"><b>Fund</b><span>Contribute to the shared pool →</span></a>
      </div>
    </section>

    <section class="courses section" id="courses" aria-labelledby="courses-title">
      <div class="section__intro section__intro--split">
        <div>
          <p class="eyebrow">02 · ONLINE SEASON 0</p>
          <h2 id="courses-title">Eight studios. No department costume.</h2>
        </div>
        <p>
          Capacity is 60 learners, with 12–18 people in a studio. Enrollment is tuition-free
          for the pilot. Each syllabus publishes its access path, expectations, and public outcome first.
        </p>
      </div>
      <div class="course-grid">
        {UES_COURSES.map((course, index) => (
          <article class="course">
            <div class="course__top">
              <span>{course.code}</span>
              <span>{String(index + 1).padStart(2, '0')} / {String(UES_COURSES.length).padStart(2, '0')}</span>
            </div>
            <h3>{course.title}</h3>
            <p>{course.frame}</p>
            <dl>
              <div><dt>Run</dt><dd>{course.delivery}</dd></div>
              <div><dt>Leaves behind</dt><dd>{course.publicOutcome}</dd></div>
            </dl>
            {course.boundary && <p class="course__boundary">BOUNDARY · {course.boundary}</p>}
            <a href={course.path ?? '/ues#launch-studios'}>Read this foundation in the catalog →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="next-term section" id="next-term" aria-labelledby="next-term-title">
      <div class="section__intro section__intro--split">
        <div>
          <p class="eyebrow">02B · ONLINE SEASON 1 · THE LOCAL TRANSMISSION</p>
          <h2 id="next-term-title">Ten rooms are active now.</h2>
        </div>
        <p>
          Start any class without an account, application, deadline, wallet, or live-attendance requirement.
          Each room has six self-guided modules, local progress, a private finish path, and a course-level budget.
          Funding maintains access and can add optional cohorts or human review; it never unlocks admission.
        </p>
      </div>
      <div class="next-term__facts">
        <div><span>Duration</span><strong>{ONLINE_SEASON_ONE.durationWeeks} modules</strong></div>
        <div><span>Access</span><strong>Uncapped</strong></div>
        <div><span>Tuition</span><strong>$0</strong></div>
        <div><span>Planning target</span><strong>{formatUsd(UES_SEASON_ONE_BUDGET.totalUsd)}</strong></div>
      </div>
      <div class="next-course-grid">
        {UES_SEASON_ONE_COURSES.map((course) => (
          <article>
            <div><span>{course.code}</span><span>{course.status}</span><span>{formatUsd(course.budgetUsd)}</span></div>
            <h3><a href={course.path}>{course.title}</a></h3>
            <p>{course.archiveCategory}</p>
            <dl><dt>Leaves behind</dt><dd>{course.outcome}</dd></dl>
            {course.boundary && <p class="next-course__boundary">BOUNDARY · {course.boundary}</p>}
            <a href={course.path}>Start this course →</a>
          </article>
        ))}
      </div>
      <div class="next-term__actions">
        <a class="button button--acid" href="/ues#current-term">Start a class now</a>
        <a class="button" href={activeClassHelpHref}>Ask for class help</a>
      </div>
    </section>

    <section class="budget section" id="budget" aria-labelledby="budget-title">
      <div class="section__intro section__intro--split">
        <div>
          <p class="eyebrow">03 · OPEN BOOK</p>
          <h2 id="budget-title">Pay people before building an institution costume.</h2>
        </div>
        <p>
          These are planning budgets, published early so faculty, learners, and contributors can challenge them.
          Every active pool gets a monthly plain-language receipt.
        </p>
      </div>

      <div class="budget-grid">
        {[UES_ONLINE_BUDGET, UES_FIELD_BUDGET, UES_SATELLITE_MODEL.seedBudget].map((budget, index) => (
          <article class:list={['budget-card', index === 0 && 'budget-card--primary']}>
            <div class="budget-card__head">
              <p>{budget.duration}</p>
              <h3>{budget.name}</h3>
              <strong>{formatUsd(budget.totalUsd)}</strong>
            </div>
            <ol>
              {budget.lines.map((line) => (
                <li>
                  <div><b>{line.label}</b><span>{line.purpose}</span></div>
                  <strong>{formatUsd(line.amountUsd)}</strong>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
      <p class="budget__unit">
        Online Season 0 plans to spend about <strong>{formatUsd(Math.round(UES_ONLINE_BUDGET.totalUsd / ONLINE_SEASON_ZERO.learnerCapacity))}</strong>
        per available learner seat. Learners pay <strong>$0 tuition</strong> in the launch cohort.
      </p>
      <p class="budget__unit">
        Active Online Season 1 has a <strong>{formatUsd(UES_SEASON_ONE_BUDGET.totalUsd)}</strong> planning target for ten maintained course rooms,
        access work, materials, and optional supported cohorts serving {ONLINE_SEASON_ONE.planningLearners} planned supported learners.
        Self-paced access stays <strong>uncapped and $0</strong>; contribution never buys admission.
      </p>
    </section>

    <section class="fund section" id="fund" aria-labelledby="fund-title">
      <div class="fund__copy">
        <p class="eyebrow">04 · CONTRIBUTE ON TEZOS</p>
        <h2 id="fund-title">A contribution is support. It does not buy control.</h2>
        <p>
          Connect a Beacon-compatible wallet and choose an amount. The wallet will show the exact
          Tezos Mainnet transfer and network fee before you sign. Nothing moves until you approve it there.
        </p>
        <div class="fund__rules">
          <span>NOT AN INVESTMENT</span>
          <span>NO FINANCIAL RETURN</span>
          <span>NO GOVERNANCE RIGHTS</span>
          <span>CURRENTLY NOT TAX-DEDUCTIBLE</span>
        </div>
        <p class="fund__wallet">
          Public program wallet<br />
          <a href={`https://tzkt.io/${UES_FUND_WALLET}`} target="_blank" rel="noreferrer">{UES_FUND_WALLET} ↗</a>
        </p>
      </div>

      <form class="fund-desk" id="ues-fund-form" onsubmit="return false">
        <div class="fund-desk__top">
          <span>TEZOS MAINNET · DIRECT SUPPORT</span>
          <button id="ues-connect" type="button">Connect wallet</button>
        </div>
        <div class="amounts" role="group" aria-label="Choose a contribution amount">
          {contributionOptions.map((option, index) => (
            <button type="button" data-ues-amount={option.amount} aria-pressed={index === 0 ? 'true' : 'false'}>
              <strong>{option.amount} ꜩ</strong>
              <b>{option.label}</b>
              <span>{option.note}</span>
            </button>
          ))}
        </div>
        <label class="custom-amount">
          <span>Or enter an amount</span>
          <span><input id="ues-custom-amount" type="number" min="0.1" max="10000" step="0.1" placeholder="0.1" /> ꜩ</span>
        </label>
        <label class="acknowledgement">
          <input id="ues-fund-consent" type="checkbox" />
          <span>I understand this is a voluntary, non-tax-deductible Mainnet contribution—not a purchase, investment, or promise of influence—and that my wallet will show the exact amount and gas before signing.</span>
        </label>
        <button class="fund-desk__submit" id="ues-contribute" type="button" disabled>Review 1 ꜩ contribution in wallet</button>
        <p class="fund-desk__status" id="ues-fund-status" role="status" aria-live="polite">No wallet connected. No transaction has started.</p>
        <a class="fund-desk__operation" id="ues-fund-operation" target="_blank" rel="noreferrer" hidden>View operation on TzKT ↗</a>
      </form>
    </section>

    <section class="milestones section" aria-labelledby="milestones-title">
      <div class="section__intro">
        <p class="eyebrow">05 · FUNDING LADDER</p>
        <h2 id="milestones-title">Every threshold opens a specific door.</h2>
      </div>
      <ol>
        {UES_FUNDING_MILESTONES.map((milestone, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{formatUsd(milestone.amountUsd)}</strong>
            <div><h3>{milestone.name}</h3><p>{milestone.unlocks}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="local section" id="local" aria-labelledby="local-title">
      <div class="local__art">
        {featuredWorks.slice(4, 6).map((work) => (
          <a href="/el-segundo-school">
            <img src={artUrl(work.thumb)} alt="" width={work.width} height={work.height} loading="lazy" />
            <span>FIELD STUDY · WORK {work.number}</span>
          </a>
        ))}
      </div>
      <div class="local__copy">
        <p class="eyebrow">06 · EL SEGUNDO + 25 MILES</p>
        <h2 id="local-title">Online first. Rooms second. A campus can be a network of good hosts.</h2>
        <p>
          The first physical layer stays light: libraries, parks, recreation rooms, studios, cafés,
          gardens, courts, workshops, and schools. No permanent lease in year one. The published
          City fee index is a planning reference—not a quote—so every venue is re-priced before booking.
        </p>
        <ol class="local__stages">
          <li><span>01</span><div><b>El Segundo anchor</b><p>Two recurring partner rooms, one field day, one open studio, one monthly public receipt.</p></div></li>
          <li><span>02</span><div><b>25-mile ring</b><p>South Bay, Westside, central Los Angeles, and nearby communities connected by faculty and field sites—not a centralized campus.</p></div></li>
          <li><span>03</span><div><b>Local authorship</b><p>Pay the person who knows the block, garden, court, archive, shop, or civic process. Keep travel and access grants in the budget.</p></div></li>
        </ol>
        <a class="source-link" href={UES_SOURCES.cityFees.url} target="_blank" rel="noreferrer">Read the City’s official financial reports and fee index ↗</a>
      </div>
    </section>

    <section class="scale section" id="scale" aria-labelledby="scale-title">
      <div class="section__intro section__intro--split">
        <div>
          <p class="eyebrow">07 · SATELLITE COMMONS</p>
          <h2 id="scale-title">Scale the method. Keep the accent.</h2>
        </div>
        <p>
          A satellite is not a branch-office copy of El Segundo. It is one paid local steward,
          a partner-space network, a small advisory table, locally authored courses, and a shared public protocol.
        </p>
      </div>

      <div class="city-tiers">
        {UES_CITY_TIERS.map((tier) => (
          <article>
            <p>{tier.label}</p>
            <h3>{tier.examples.join(' · ')}</h3>
            <strong>{formatUsd(tier.annualPlanningRangeUsd.minimum)}–{formatUsd(tier.annualPlanningRangeUsd.maximum)} / year</strong>
            <span>{tier.character}</span>
          </article>
        ))}
      </div>

      <div class="scale-lab" data-active-budget={UES_SEASON_ONE_BUDGET.totalUsd} data-foundation-budget={UES_ONLINE_BUDGET.totalUsd}>
        <div class="scale-lab__controls">
          <p class="eyebrow">PLANNING CALCULATOR · ACTIVE + FOUNDATION BASE</p>
          <label>
            <span>Six-month city seeds</span>
            <strong id="ues-city-count">5</strong>
            <input id="ues-city-range" type="range" min="0" max="25" value="5" step="1" />
          </label>
          <label class="scale-lab__check"><input id="ues-field-toggle" type="checkbox" checked /> Include El Segundo + 25-mile field layer</label>
          <p>Each seed uses the published <strong>{formatUsd(UES_SATELLITE_MODEL.seedBudget.totalUsd)}</strong> six-month model. The shared commons allowance grows with the network.</p>
        </div>
        <div class="scale-lab__result">
          <span>PROGRAM + EXPANSION TOTAL</span>
          <strong id="ues-scale-total">$363,600</strong>
          <dl>
            <div><dt>Active self-paced term</dt><dd id="ues-scale-active">$46,600</dd></div>
            <div><dt>Online Season 0</dt><dd id="ues-scale-online">$30,500</dd></div>
            <div><dt>25-mile layer</dt><dd id="ues-scale-field">$29,000</dd></div>
            <div><dt>City seeds</dt><dd id="ues-scale-cities">$187,500</dd></div>
            <div><dt>Shared commons</dt><dd id="ues-scale-commons">$70,000</dd></div>
          </dl>
          <small>Planning estimate, not an announced location commitment or fundraising promise. This view includes the active Local Transmission target and the Season 0 foundation before field or satellite expansion.</small>
        </div>
      </div>

      <div class="scale-presets" aria-label="Published scale scenarios">
        {UES_SCALE_SCENARIOS.map((scenario) => (
          <div><span>{scenario.label}</span><strong>{formatUsd(scenario.totalUsd)}</strong></div>
        ))}
      </div>

      <ol class="satellite-rules">
        {UES_SATELLITE_MODEL.rules.map((rule, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{rule}</li>)}
      </ol>
    </section>

    <section class="governance section" aria-labelledby="governance-title">
      <div>
        <p class="eyebrow">08 · THE PROMISE</p>
        <h2 id="governance-title">Collective does not mean vague.</h2>
      </div>
      <div>
        <ol>
          {UES_GOVERNANCE.rules.map((rule) => <li>{rule}</li>)}
        </ol>
        <div class="governance__caveats">
          {UES_GOVERNANCE.caveats.map((caveat) => <p>{caveat}</p>)}
        </div>
      </div>
    </section>

    <section class="sources section" aria-labelledby="sources-title">
      <div>
        <p class="eyebrow">09 · SOURCES + MACHINE PATH</p>
        <h2 id="sources-title">Read the assumptions.</h2>
      </div>
      <div>
        <ul>
          {sources.map((source) => (
            <li><a href={source.url} target="_blank" rel="noreferrer"><b>{source.title} ↗</b><span>{source.use}</span></a></li>
          ))}
        </ul>
        <a class="json-link" href="/university-of-el-segundo.json">Read the complete program as JSON →</a>
      </div>
    </section>

    <footer class="ues-footer">
      <div>
        <p>UNIVERSITY OF EL SEGUNDO</p>
        <h2>A school without walls still needs people who show up.</h2>
      </div>
      <nav aria-label="University footer links">
        <a href="/ues#current-term">Start a class</a>
        <a href={teachHref}>Teach</a>
        <a href={partnerHref}>Host</a>
        <a href="#fund">Fund</a>
        <a href="/el-segundo-school">Art archive</a>
        <a href="/ues">Course rooms</a>
      </nav>
      <p>ACTIVE ONLINE · FORMING LOCALLY · MICHAEL HOYDICH · POINTCAST · 2026</p>
    </footer>
  </div>
</BlockLayout>

<script>
  const connectButton = document.getElementById('ues-connect') as HTMLButtonElement | null;
  const contributeButton = document.getElementById('ues-contribute') as HTMLButtonElement | null;
  const consent = document.getElementById('ues-fund-consent') as HTMLInputElement | null;
  const customAmount = document.getElementById('ues-custom-amount') as HTMLInputElement | null;
  const fundStatus = document.getElementById('ues-fund-status');
  const operationLink = document.getElementById('ues-fund-operation') as HTMLAnchorElement | null;
  const amountButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ues-amount]'));
  let selectedAmount = 1;
  let connectedAddress = '';
  let fundModule: Promise<typeof import('../lib/ues-fund')> | null = null;

  function formatAmount(amount: number) {
    return Number.isInteger(amount) ? String(amount) : amount.toLocaleString('en-US', { maximumFractionDigits: 6 });
  }

  function setSelectedAmount(amount: number, selectedButton?: HTMLButtonElement) {
    if (!Number.isFinite(amount) || amount < 0.1 || amount > 10000) return;
    selectedAmount = amount;
    amountButtons.forEach((button) => button.setAttribute('aria-pressed', String(button === selectedButton)));
    if (contributeButton) contributeButton.textContent = `Review ${formatAmount(amount)} ꜩ contribution in wallet`;
  }

  amountButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const amount = Number(button.dataset.uesAmount);
      if (customAmount) customAmount.value = '';
      setSelectedAmount(amount, button);
    });
  });

  customAmount?.addEventListener('input', () => {
    const amount = Number(customAmount.value);
    if (Number.isFinite(amount) && amount >= 0.1 && amount <= 10000) setSelectedAmount(amount);
  });

  consent?.addEventListener('change', () => {
    if (contributeButton) contributeButton.disabled = !consent.checked;
  });

  connectButton?.addEventListener('click', async () => {
    connectButton.disabled = true;
    connectButton.textContent = 'Opening wallet…';
    if (fundStatus) fundStatus.textContent = 'Choose a Beacon-compatible Tezos wallet. No transaction is being requested.';
    try {
      fundModule ??= import('../lib/ues-fund');
      const { connectUesWallet } = await fundModule;
      connectedAddress = await connectUesWallet();
      connectButton.textContent = `${connectedAddress.slice(0, 6)}…${connectedAddress.slice(-4)}`;
      if (fundStatus) fundStatus.textContent = 'Wallet connected. No contribution has been signed or sent.';
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      connectButton.textContent = 'Connect wallet';
      if (fundStatus) fundStatus.textContent = /abort|cancel|reject|closed/i.test(message)
        ? 'Wallet window closed. Nothing was signed or sent.'
        : `Wallet connection did not finish: ${message.slice(0, 100)}`;
    } finally {
      connectButton.disabled = false;
    }
  });

  contributeButton?.addEventListener('click', async () => {
    if (!consent?.checked) {
      if (fundStatus) fundStatus.textContent = 'Read and check the Mainnet acknowledgement first.';
      return;
    }
    if (!Number.isFinite(selectedAmount) || selectedAmount < 0.1 || selectedAmount > 10000) {
      if (fundStatus) fundStatus.textContent = 'Choose an amount from 0.1 to 10,000 tez.';
      return;
    }

    contributeButton.disabled = true;
    if (operationLink) operationLink.hidden = true;
    try {
      fundModule ??= import('../lib/ues-fund');
      const { contributeToUes } = await fundModule;
      if (fundStatus) fundStatus.textContent = `Review the ${formatAmount(selectedAmount)} ꜩ Mainnet contribution and gas in your wallet.`;
      const operation = await contributeToUes(selectedAmount);
      connectedAddress = operation.owner;
      if (connectButton) connectButton.textContent = `${connectedAddress.slice(0, 6)}…${connectedAddress.slice(-4)}`;
      if (operationLink) {
        operationLink.href = `https://tzkt.io/${operation.opHash}`;
        operationLink.hidden = false;
      }
      if (fundStatus) fundStatus.textContent = 'Broadcast. Waiting for one Tezos Mainnet confirmation…';
      await operation.confirmation;
      if (fundStatus) fundStatus.textContent = 'Confirmed on Tezos Mainnet. Thank you for helping the University begin.';
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (fundStatus) fundStatus.textContent = /abort|cancel|reject|closed/i.test(message)
        ? 'Wallet request closed. No tez moved.'
        : `Contribution did not finish: ${message.slice(0, 120)}`;
    } finally {
      contributeButton.disabled = !consent.checked;
    }
  });

  const cityRange = document.getElementById('ues-city-range') as HTMLInputElement | null;
  const fieldToggle = document.getElementById('ues-field-toggle') as HTMLInputElement | null;
  const scaleLab = document.querySelector<HTMLElement>('.scale-lab');
  const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

  function commonsForCities(cities: number) {
    if (cities <= 0) return 0;
    if (cities <= 5) return cities * 14000;
    if (cities <= 12) return 70000 + (cities - 5) * (50000 / 7);
    return 120000 + (cities - 12) * (90000 / 13);
  }

  function updateScale() {
    const cities = Number(cityRange?.value || 0);
    const active = Number(scaleLab?.dataset.activeBudget || 0);
    const online = Number(scaleLab?.dataset.foundationBudget || 0);
    const field = fieldToggle?.checked ? 29000 : 0;
    const citySeeds = cities * 37500;
    const commons = Math.round(commonsForCities(cities));
    const total = active + online + field + citySeeds + commons;
    const values: Record<string, string> = {
      'ues-city-count': String(cities),
      'ues-scale-total': usd.format(total),
      'ues-scale-active': usd.format(active),
      'ues-scale-online': usd.format(online),
      'ues-scale-field': usd.format(field),
      'ues-scale-cities': usd.format(citySeeds),
      'ues-scale-commons': usd.format(commons),
    };
    Object.entries(values).forEach(([id, value]) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    });
  }

  cityRange?.addEventListener('input', updateScale);
  fieldToggle?.addEventListener('change', updateScale);
  updateScale();
</script>

