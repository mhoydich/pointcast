---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  FIRST_TIDE_FORMAT,
  LOCAL_AREA_RADIUS,
  UNIVERSITY_PARTICIPATION_TIERS,
  UNIVERSITY_TRACKS,
} from '../lib/localAreas';

const title = 'University of El Segundo';
const description =
  'The beginning of University of El Segundo: a local course framework, participation model, and first-session format for the PointCast 25-mile radius.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': 'https://pointcast.xyz/university-of-el-segundo',
  name: title,
  description,
  url: 'https://pointcast.xyz/university-of-el-segundo',
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: LOCAL_AREA_RADIUS.anchor.coords.latitude,
      longitude: LOCAL_AREA_RADIUS.anchor.coords.longitude,
    },
    geoRadius: LOCAL_AREA_RADIUS.radiusMeters,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'University of El Segundo tracks',
    itemListElement: UNIVERSITY_TRACKS.map((track) => ({
      '@type': 'Course',
      name: track.title,
      description: track.frame,
    })),
  },
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/areas">areas</a>
      <span>/</span>
      <span>university-of-el-segundo</span>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">UNIVERSITY OF EL SEGUNDO · FIRST TIDE</p>
        <h1>A neighborhood learning club with receipts.</h1>
        <p>
          No tuition, no degrees, no campus costume. UES is a practical
          framework for local sessions where people teach what they actually
          know, then publish the note so the next person can join.
        </p>
      </div>
      <div class="crest" aria-label="University of El Segundo crest">
        <span class="crest__sun"></span>
        <span class="crest__line crest__line--one"></span>
        <span class="crest__line crest__line--two"></span>
        <span class="crest__book"></span>
        <p>FIRST TIDE</p>
      </div>
    </header>

    <section class="section" aria-labelledby="tracks-heading">
      <div class="section__head">
        <p class="kicker">COURSE TRACKS</p>
        <h2 id="tracks-heading">Six ways to practice local knowledge.</h2>
      </div>
      <div class="tracks">
        {UNIVERSITY_TRACKS.map((track, index) => (
          <article class="track">
            <span>TRACK {index + 1}</span>
            <h3>{track.title}</h3>
            <p>{track.frame}</p>
            <div class="track__first">
              <strong>First session</strong>
              <small>{track.firstSession}</small>
            </div>
            <ul>
              {track.connectsTo.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section participation" aria-labelledby="participation-heading">
      <div>
        <p class="kicker">PARTICIPATION</p>
        <h2 id="participation-heading">Roles that keep the room alive.</h2>
        <p>
          The useful artifact is not a grade. It is a session note, a roster
          entry, a photo receipt, a paddle handoff, a garden source, or a next
          host. Participation should feel visible without becoming homework.
        </p>
      </div>
      <ol class="tiers">
        {UNIVERSITY_PARTICIPATION_TIERS.map((tier) => (
          <li>
            <span>{tier.threshold}</span>
            <h3>{tier.name}</h3>
            <p>{tier.role}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section first-tide" aria-labelledby="first-heading">
      <div class="section__head">
        <p class="kicker">FIRST SESSION</p>
        <h2 id="first-heading">First Tide, 75 minutes.</h2>
      </div>
      <ol class="run">
        {FIRST_TIDE_FORMAT.map((item) => (
          <li>
            <time>{item.minutes}</time>
            <div>
              <h3>{item.label}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section links" aria-label="Connected local areas">
      <a href="/meetups">List First Tide on Meetups</a>
      <a href="/paddle-exchange">Feed Court Craft from Paddle Tide</a>
      <a href="/honey-league">Cross-list Honey & Garden</a>
      <a href="/areas.json">Read the JSON framework</a>
    </section>
  </div>
</BlockLayout>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 20px 88px;
  }

  .crumb,
  .kicker,
  .track span,
  .tiers span,
  .run time {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--pc-ink-muted);
    margin-bottom: 24px;
  }

  .kicker {
    color: #6f4f14;
    margin: 0 0 8px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 34px;
    align-items: center;
    padding-bottom: 30px;
    border-bottom: 2px solid var(--pc-ink);
  }

  h1 {
    font-size: 48px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0 0 16px;
    max-width: 13ch;
  }

  .hero p,
  .participation p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--pc-ink-soft);
    margin: 0;
    max-width: 68ch;
  }

  .crest {
    border: 1px solid #e3bc69;
    background: #fff4dc;
    min-height: 270px;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }

  .crest__sun {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #f3c85a;
    border: 2px solid #12110e;
    position: absolute;
    top: 44px;
  }

  .crest__line {
    position: absolute;
    left: 36px;
    right: 36px;
    height: 18px;
    border-top: 2px solid #185fa5;
    border-radius: 50%;
  }

  .crest__line--one {
    top: 132px;
  }

  .crest__line--two {
    top: 154px;
  }

  .crest__book {
    position: absolute;
    bottom: 54px;
    width: 104px;
    height: 44px;
    border: 2px solid #12110e;
    border-top: 0;
    background: linear-gradient(90deg, #fff 0 48%, #12110e 48% 52%, #fff 52% 100%);
  }

  .crest p {
    align-self: end;
    margin: 0 0 20px;
    font-family: var(--pc-font-mono);
    color: #6f4f14;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  .section {
    padding: 34px 0;
    border-bottom: 1px solid var(--pc-rule-soft);
  }

  .section__head {
    margin-bottom: 18px;
  }

  h2 {
    font-size: 28px;
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: 0;
    margin: 0;
  }

  .tracks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .track {
    border: 1px solid #e3bc69;
    background: #fffdfa;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .track span,
  .tiers span,
  .run time {
    color: #6f4f14;
  }

  .track h3,
  .tiers h3,
  .run h3 {
    font-size: 20px;
    line-height: 1.18;
    font-weight: 500;
    margin: 0;
  }

  .track p,
  .track__first small,
  .run p,
  .tiers p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
    margin: 0;
  }

  .track__first {
    border-top: 1px solid #e3bc69;
    padding-top: 10px;
    display: grid;
    gap: 4px;
  }

  .track__first strong {
    font-size: 13px;
  }

  .track ul {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .track li {
    border: 1px solid #e3bc69;
    background: #fff4dc;
    color: #6f4f14;
    font-size: 12px;
    padding: 3px 6px;
  }

  .participation {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 30px;
    align-items: start;
  }

  .tiers,
  .run {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .tiers li {
    border-left: 3px solid #6f4f14;
    background: #fff4dc;
    padding: 12px 14px;
  }

  .run li {
    display: grid;
    grid-template-columns: 86px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--pc-rule);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .links a {
    border: 1px solid #6f4f14;
    color: #6f4f14;
    background: #fff;
    padding: 10px 12px;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .hero,
    .participation {
      grid-template-columns: 1fr;
    }

    .crest {
      max-width: 320px;
    }

    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    h1 {
      font-size: 34px;
      max-width: 100%;
    }

    .tracks,
    .run li {
      grid-template-columns: 1fr;
    }

    .page {
      padding-inline: 16px;
    }
  }
</style>
