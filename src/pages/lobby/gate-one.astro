---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LobbyGatePage from '../../components/LobbyGatePage.astro';

const gate = {
  id: 'knock',
  number: '01',
  title: 'The Brass Knock',
  eyebrow: 'lobby gate run',
  target: 5,
  actionLabel: 'Knock',
  completeLabel: 'Gate one opened. The mat says go upstairs.',
  nextHref: '/lobby/gate-two',
  nextLabel: 'Go to gate two',
  type: 'tap',
} as const;
---

<BaseLayout title="gate one · pointcast" description="Lobby gate run: knock five times.">
  <LobbyGatePage gate={gate} />
</BaseLayout>
