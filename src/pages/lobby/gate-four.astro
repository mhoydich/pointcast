---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LobbyGatePage from '../../components/LobbyGatePage.astro';

const gate = {
  id: 'routes',
  number: '04',
  title: 'Six Route Stamps',
  eyebrow: 'lobby gate run',
  target: 6,
  actionLabel: 'Stamp',
  completeLabel: 'All six exits have ink. The last door wakes up.',
  nextHref: '/lobby/gate-five',
  nextLabel: 'Go to gate five',
  type: 'routes',
  tasks: [
    { label: 'Booth stamp', note: 'what residents are listening to', href: '/booth' },
    { label: 'CB stamp', note: 'what residents are saying', href: '/cb' },
    { label: 'Now stamp', note: 'current signal board', href: '/now' },
    { label: 'Town stamp', note: 'walk the map edge', href: '/town' },
    { label: 'Wire stamp', note: 'thin news from the wall', href: '/wire' },
    { label: 'Play stamp', note: 'somewhere less serious', href: '/play' },
  ],
} as const;
---

<BaseLayout title="gate four · pointcast" description="Lobby gate run: stamp six routes.">
