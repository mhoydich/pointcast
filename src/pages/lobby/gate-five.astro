---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LobbyGatePage from '../../components/LobbyGatePage.astro';

const gate = {
  id: 'again',
  number: '05',
  title: 'Keep Going Machine',
  eyebrow: 'lobby gate run',
  target: 8,
  actionLabel: 'Draw',
  completeLabel: 'The machine is still warm. You earned the loop back.',
  nextHref: '/lobby#lobby-gates',
  nextLabel: 'Return to lobby with stamps',
  type: 'draw',
  tasks: [
    { label: 'Blink twice at the route board', note: 'the board blinks back once' },
    { label: 'Press the imaginary elevator button', note: 'floor L, for lobby' },
    { label: 'Name one chair captain', note: 'temporary office, no paperwork' },
    { label: 'Balance a sound on the desk', note: 'do not let it roll' },
    { label: 'Teach the doormat a shortcut', note: 'it already knows three' },
    { label: 'Wave at the 100-rung ladder', note: 'rung 092 is dramatic' },
    { label: 'Pocket a ceremonial breadcrumb', note: 'useful in corridors' },
    { label: 'Tell the lobby to keep going', note: 'the lobby agrees' },
  ],
} as const;
---

<BaseLayout title="gate five · pointcast" description="Lobby gate run: keep going.">
  <LobbyGatePage gate={gate} />
</BaseLayout>
