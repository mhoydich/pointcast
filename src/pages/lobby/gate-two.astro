---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LobbyGatePage from '../../components/LobbyGatePage.astro';

const gate = {
  id: 'errands',
  number: '02',
  title: 'Ten Tiny Things',
  eyebrow: 'lobby gate run',
  target: 10,
  actionLabel: 'Stamp',
  completeLabel: 'The errand clerk nods. Gate three is available.',
  nextHref: '/lobby/gate-three',
  nextLabel: 'Go to gate three',
  type: 'checklist',
  tasks: [
    { label: 'Straighten the visitor badge', note: 'make it official-ish' },
    { label: 'Tap the open sign', note: 'do not ask why it hums' },
    { label: 'Count the lobby chairs', note: 'there are enough today' },
    { label: 'Check the guestbook margin', note: 'someone drew a tiny arrow' },
    { label: 'Say hello to /cb', note: 'the radio room hears everything' },
    { label: 'Dust the route map', note: 'six exits reappear' },
    { label: 'Wake the jukebox', note: 'one polite chime only' },
    { label: 'Fold one pixel napkin', note: 'corner to corner' },
    { label: 'Stamp the tiny passport', note: 'now it feels serious' },
    { label: 'Point at the exit sign', note: 'the sign points back' },
  ],
} as const;
---

<BaseLayout title="gate two · pointcast" description="Lobby gate run: do ten tiny things.">
  <LobbyGatePage gate={gate} />
</BaseLayout>
