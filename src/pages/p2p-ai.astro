---
import BlockLayout from '../layouts/BlockLayout.astro';
import { COLLECTIVE_TOOLS_SPECULATION, FOUR_TRANSITIONS, MIST_PRECEDENT, PAPER_META, PAPER_NOTES, PERMISSIONING_RECOMMENDATIONS, REFERENCES, RESEARCH_FRAMEWORK, THE_CASE_STUDY } from '../lib/p2pAiPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/p2p-ai', name: PAPER_META.title, description, url: 'https://pointcast.xyz/p2p-ai', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const stageColor: Record<string, string> = { 'arrived (2025-2026)': '#2d6a3d', 'forming (2026-2028 estimated)': '#d4a534', 'unsolved (open)': '#b85a3a', 'speculative (2027+)': '#5b3d7a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/p2p-ai.json', title: 'Peer-to-Peer AI (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">UES</a><span aria-hidden="true">/</span><span>p2p-ai</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY</p>
      <h1>PEER / TO / PEER / AI.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="cs"><p class="kicker">CASE STUDY · ONE END-USER · 2026-05-08</p><h2>{THE_CASE_STUDY.title}</h2>
      <p class="lede">{THE_CASE_STUDY.description}</p>
      <h3 class="sh">Surfaces connected · {THE_CASE_STUDY.surfacesConnected.length}</h3>
      <ol class="surf-list">{THE_CASE_STUDY.surfacesConnected.map((s) => (
        <li>
          <h4>{s.surface} <span class="surf__type">— {s.connectorType}</span></h4>
          <p class="surf__data"><strong>Data exposed:</strong> {s.dataExposed}</p>
          <p class="surf__use"><strong>Use cases:</strong> {s.useCases}</p>
        </li>
      ))}</ol>
      <h3 class="sh">What sits above</h3>
      <p class="block"><strong>Intelligence layer:</strong> {THE_CASE_STUDY.intelligenceLayer}</p>
      <p class="block"><strong>Output formats:</strong> {THE_CASE_STUDY.outputFormats}</p>
      <p class="block"><strong>What this looks like from inside:</strong> {THE_CASE_STUDY.whatThisLooksLikeFromInside}</p>
    </section>

    <section class="trans"><p class="kicker">FOUR TRANSITIONS · ARRIVED → FORMING → UNSOLVED → SPECULATIVE</p><h2>What the AI-client emergence looks like in 2026.</h2>
      <ol class="tr-list">{FOUR_TRANSITIONS.map((t, i) => (
        <li class="tr" style={`--st-color: ${stageColor[t.stage]};`}>
          <div class="tr__head">
            <span class="tr__num">{String(i+1).padStart(2,'0')}</span>
            <h3>{t.title}</h3>
            <span class="tr__stage">{t.stage}</span>
          </div>
          <p class="tr__desc">{t.description}</p>
          <p class="tr__what"><strong>What changed:</strong> {t.whatChanged}</p>
          <p class="tr__broken"><strong>What remains broken:</strong> {t.whatRemainsBroken}</p>
        </li>
      ))}</ol>
    </section>

    <section class="mist"><p class="kicker">MIST PRECEDENT · 2015-2019 · DEPRECATED</p><h2>{MIST_PRECEDENT.title}</h2>
      <p class="lede">{MIST_PRECEDENT.description}</p>
      <p class="block"><strong>What it was:</strong> {MIST_PRECEDENT.whatItWas}</p>
      <h3 class="sh">What Mist got right · {MIST_PRECEDENT.whatItGotRight.length}</h3>
      <ul class="dt-list dt-list--right">{MIST_PRECEDENT.whatItGotRight.map((w) => (<li>{w}</li>))}</ul>
      <h3 class="sh">What Mist got wrong · {MIST_PRECEDENT.whatItGotWrong.length}</h3>
      <ul class="dt-list dt-list--wrong">{MIST_PRECEDENT.whatItGotWrong.map((w) => (<li>{w}</li>))}</ul>
      <h3 class="sh">What the AI-client emergence can learn · {MIST_PRECEDENT.whatTheAiClientEmergenceCanLearn.length}</h3>
      <ol class="dt-list dt-list--learn">{MIST_PRECEDENT.whatTheAiClientEmergenceCanLearn.map((w) => (<li>{w}</li>))}</ol>
    </section>

    <section class="rf"><p class="kicker">RESEARCH FRAMEWORK · UES PARTICIPATORY-ACTION COHORT</p><h2>How UES studies this as it happens.</h2>
      <p class="lede">{RESEARCH_FRAMEWORK.description}</p>
      <h3 class="sh">Cohort</h3>
      <dl class="dl">
        <div><dt>Size</dt><dd>{RESEARCH_FRAMEWORK.cohort.size}</dd></div>
        <div><dt>Diversity</dt><dd>{RESEARCH_FRAMEWORK.cohort.diversity}</dd></div>
        <div><dt>Consent</dt><dd>{RESEARCH_FRAMEWORK.cohort.consent}</dd></div>
        <div><dt>Duration</dt><dd>{RESEARCH_FRAMEWORK.cohort.duration}</dd></div>
      </dl>
      <h3 class="sh">Six-week cycle cadence</h3>
      <ol class="wk-list">{RESEARCH_FRAMEWORK.weeklyCadence.map((w) => (
        <li>
          <span class="wk__n">WEEK {w.week}</span>
          <div>
            <h4>{w.theme}</h4>
            <p>{w.practice}</p>
          </div>
        </li>
      ))}</ol>
      <h3 class="sh">Outputs · {RESEARCH_FRAMEWORK.outputs.length}</h3>
      <ul class="dt-list">{RESEARCH_FRAMEWORK.outputs.map((o) => (<li>{o}</li>))}</ul>
      <p class="block"><strong>Governance:</strong> {RESEARCH_FRAMEWORK.governance}</p>
    </section>

    <section class="coll"><p class="kicker">COLLECTIVE TOOLS · QUALITY-OF-LIFE SPECULATION · 8 PROSPECTIVE</p><h2>What the federation could build once permissioning stabilizes.</h2>
      <ol class="ct-list">{COLLECTIVE_TOOLS_SPECULATION.map((c) => (
        <li>
          <h4>{c.tool} <span class="ct__stage">— {c.stage}</span></h4>
          <p>{c.description}</p>
        </li>
      ))}</ol>
    </section>

    <section class="perm"><p class="kicker">PERMISSIONING · 7 WORKING-POSITION RECOMMENDATIONS</p><h2>What the federation defends until vendors deliver.</h2>
      <ol class="perm-list">{PERMISSIONING_RECOMMENDATIONS.map((p, i) => (
        <li><span class="perm__n">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COHORT · RESEARCHERS · VENDOR STAFF</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/eth-legacy">ETH Legacy · token-deployment retrospective</a>
      <a href="/pointcast-connectors">PointCast Connectors · live MCP inventory</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/marine-layer">Marine Layer · cohort precedent</a>
      <a href="/p2p-ai.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --p2p-ink:#1a1a1a; --p2p-paper:#fdf9ee; --p2p-mustard:#d4a534; --p2p-rust:#b85a3a; --p2p-sage:#2d6a3d; --p2p-violet:#5b3d7a; --p2p-fog:#d8d2c4; --p2p-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--p2p-paper); color: var(--p2p-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--p2p-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--p2p-violet); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--p2p-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--p2p-violet); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 86px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--p2p-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--p2p-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--p2p-violet); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--p2p-violet); }
  h4 { font-family: var(--pc-font-mono); font-size: 13.5px; margin: 0 0 6px; font-weight: 700; }

  .lede { font-size: 15.5px; line-height: 1.65; margin: 0 0 16px; max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--p2p-violet); max-width: 72ch; font-family: Georgia, serif; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--p2p-violet); margin-right: 6px; }

  .surf-list, .ct-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .surf-list li, .ct-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--p2p-ink); border-left: 6px solid var(--p2p-violet); }
  .surf__type, .ct__stage { font-family: var(--pc-font-mono); font-size: 10.5px; letter-spacing: .1em; color: var(--p2p-rust); margin-left: 6px; font-weight: 500; }
  .surf__data, .surf__use { padding: 6px 10px; background: var(--p2p-paper); border-left: 3px solid var(--p2p-mustard); margin: 6px 0 !important; font-size: 13px !important; line-height: 1.55; }
  .surf-list strong, .perm-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--p2p-violet); margin-right: 4px; }
  .surf-list p, .ct-list p { margin: 0 0 4px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .tr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .tr { padding: 14px; background: #fff; border: 2px solid var(--p2p-ink); border-left: 10px solid var(--st-color); }
  .tr__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; padding-bottom: 8px; border-bottom: 2px solid var(--st-color); }
  .tr__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--st-color); }
  .tr h3 { margin: 0; font-family: var(--pc-font-mono); font-size: 16px; flex: 1; }
  .tr__stage { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .12em; padding: 3px 8px; background: var(--st-color); color: #fff; }
  .tr__desc { font-size: 14px; line-height: 1.6; margin: 0 0 10px; font-family: Georgia, serif; }
  .tr__what, .tr__broken { padding: 8px 12px; background: var(--p2p-paper); margin: 0 0 6px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .tr__what { border-left: 3px solid var(--p2p-sage); }
  .tr__broken { border-left: 3px solid var(--p2p-rust); }
  .tr strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--st-color); margin-right: 4px; }

  .dl { margin: 0 0 12px; display: grid; gap: 6px; }
  .dl > div { display: grid; grid-template-columns: 140px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--p2p-ink); border-left: 5px solid var(--p2p-violet); }
  .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--p2p-violet); padding-top: 2px; }
  .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .wk-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .wk-list li { display: grid; grid-template-columns: 90px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--p2p-ink); border-left: 5px solid var(--p2p-violet); align-items: baseline; }
  .wk__n { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--p2p-rust); padding: 2px 6px; background: var(--p2p-paper); display: inline-block; letter-spacing: .1em; }
  .wk-list h4 { margin: 0 0 4px; }
  .wk-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }
  .dt-list--right li::marker { color: var(--p2p-sage); }
  .dt-list--wrong li::marker { color: var(--p2p-rust); }
  .dt-list--learn { list-style: decimal; }
  .dt-list--learn li::marker { color: var(--p2p-violet); font-family: var(--pc-font-mono); font-weight: 700; }

  .perm-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .perm-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--p2p-ink); border-left: 6px solid var(--p2p-mustard); align-items: baseline; }
  .perm__n { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--p2p-violet); }
  .perm-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  .invitation { background: var(--p2p-violet); color: var(--p2p-paper); border-top-color: var(--p2p-violet); }
  .invitation .kicker { background: var(--p2p-mustard); color: var(--p2p-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--p2p-mustard); color: var(--p2p-ink); border-left: 4px solid var(--p2p-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .85; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--p2p-violet); color: var(--p2p-paper); text-decoration: none; }
  .links a:hover { background: var(--p2p-rust); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .wk-list li, .perm-list li { grid-template-columns: 1fr; } }
</style>
