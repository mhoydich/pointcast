---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Swipe Golf';
const description = 'Flick a Noun ball through nine small mini-putt holes in the PointCast Win95 Retro Arcade.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/swipe-golf', name: title, description, url: 'https://pointcast.xyz/swipe-golf' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-golf>
    <section class="window" aria-labelledby="golf-title">
      <header class="titlebar"><span>Swipe Golf</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Swipe Golf menu">
        <button type="button" data-new>Game</button>
        <a href="/noun-runner">Runner</a>
        <a href="/nouns-bubble-pop">Bubbles</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">FLICK · PUTT · NINE</p><h1 id="golf-title">Putt nine.</h1><p>Touch-drag from the Noun ball, release toward the cup, and finish all nine holes.</p></div>
        <div class="meters"><span>Hole <strong data-hole>1/9</strong></span><span>Strokes <strong data-strokes>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage">
        <canvas data-canvas width="360" height="520" aria-label="Swipe Golf play field"></canvas>
        <div class="overlay" data-overlay hidden>
          <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="golf-dialog-title">
            <header class="dlgbar"><span id="golf-dialog-title" data-dialog-title>Ready</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
            <div class="dlgbody"><p data-dialog-message>Flick to putt.</p><button type="button" data-restart>New Game</button></div>
          </div>
        </div>
      </div>
      <footer class="status" data-status aria-live="polite">Drag from the ball toward the cup.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-golf]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width;
      const H = canvas.height;
      const slug = 'swipe-golf';
      const statsKey = 'pc:arcade:' + slug;
      const profileKey = 'pc:arcade:profile';
      const gameName = 'Golf';
      const badge = 'golf-nine';
      const holeEl = root.querySelector<HTMLElement>('[data-hole]');
      const strokesEl = root.querySelector<HTMLElement>('[data-strokes]');
      const bestEl = root.querySelector<HTMLElement>('[data-best]');
      const statusEl = root.querySelector<HTMLElement>('[data-status]');
      const overlay = root.querySelector<HTMLElement>('[data-overlay]');
      const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
      const noun = new Image();
      noun.src = 'https://noun.pics/517.svg';
      type Obstacle = { x: number; y: number; w: number; h: number };
      type Hole = { start: [number, number]; cup: [number, number]; par: number; obstacles: Obstacle[] };
      const holes: Hole[] = [
        { start: [70, 452], cup: [286, 82], par: 2, obstacles: [{ x: 138, y: 246, w: 98, h: 16 }] },
        { start: [286, 444], cup: [78, 88], par: 3, obstacles: [{ x: 92, y: 204, w: 168, h: 16 }, { x: 92, y: 316, w: 16, h: 92 }] },
        { start: [64, 420], cup: [304, 124], par: 3, obstacles: [{ x: 126, y: 150, w: 16, h: 210 }, { x: 210, y: 256, w: 96, h: 16 }] },
        { start: [180, 452], cup: [180, 70], par: 2, obstacles: [{ x: 70, y: 210, w: 84, h: 16 }, { x: 206, y: 306, w: 84, h: 16 }] },
        { start: [80, 430], cup: [292, 236], par: 3, obstacles: [{ x: 128, y: 118, w: 16, h: 182 }, { x: 214, y: 246, w: 16, h: 166 }] },
        { start: [294, 424], cup: [72, 212], par: 3, obstacles: [{ x: 74, y: 308, w: 162, h: 16 }, { x: 220, y: 122, w: 16, h: 154 }] },
        { start: [66, 456], cup: [286, 72], par: 4, obstacles: [{ x: 70, y: 168, w: 190, h: 16 }, { x: 104, y: 328, w: 190, h: 16 }] },
        { start: [290, 456], cup: [72, 72], par: 4, obstacles: [{ x: 110, y: 110, w: 16, h: 280 }, { x: 224, y: 142, w: 16, h: 280 }] },
        { start: [180, 448], cup: [180, 70], par: 5, obstacles: [{ x: 68, y: 170, w: 110, h: 16 }, { x: 182, y: 260, w: 110, h: 16 }, { x: 68, y: 350, w: 110, h: 16 }] },
      ];
      const ball = { x: 0, y: 0, vx: 0, vy: 0, r: 15 };
      let holeIndex = 0;
      let strokes = 0;
      let holeStrokes = 0;
      let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestMoves: 0 }).bestMoves || 0);
      let aiming = false;
      let aimStart = { x: 0, y: 0 };
      let aimNow = { x: 0, y: 0 };
      let sinking = false;
      let won = false;
      let last = 0;
      let raf = 0;

      function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
      function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
      function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestMoves: 0 });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestMoves = Number(stats.bestMoves || 0) ? Math.min(Number(stats.bestMoves), strokes) : strokes;
        }
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestMoves: Number(stats.bestMoves || 0) });
        const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
        profile.lastPlayed = gameName;
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = gameName;
          const earned = ['first-win', badge];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
        best = Number(stats.bestMoves || best || 0);
      }
      function renderMeters() {
        if (holeEl) holeEl.textContent = Math.min(holeIndex + 1, 9) + '/9';
        if (strokesEl) strokesEl.textContent = String(strokes);
        if (bestEl) bestEl.textContent = best ? String(best) : '--';
      }
      function showDialog(title: string, message: string) {
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogMessage) dialogMessage.textContent = message;
        if (overlay) overlay.hidden = false;
      }
      function hideDialog() { if (overlay) overlay.hidden = true; }
      function currentHole() { return holes[Math.min(holeIndex, holes.length - 1)]; }
      function speed() { return Math.hypot(ball.vx, ball.vy); }
      function resetBall() {
        const hole = currentHole();
        ball.x = hole.start[0];
        ball.y = hole.start[1];
        ball.vx = 0;
        ball.vy = 0;
        holeStrokes = 0;
      }
      function newGame() {
        cancelAnimationFrame(raf);
        holeIndex = 0;
        strokes = 0;
        won = false;
        sinking = false;
        aiming = false;
        hideDialog();
        resetBall();
        recordPlay(false);
        renderMeters();
        setStatus('Hole 1. Drag from the ball toward the cup.');
        last = 0;
        raf = requestAnimationFrame(frame);
      }
      function finishHole() {
        if (sinking || won) return;
        sinking = true;
        ball.vx = 0;
        ball.vy = 0;
        const hole = currentHole();
        ball.x = hole.cup[0];
        ball.y = hole.cup[1];
        setStatus('Hole ' + (holeIndex + 1) + ' sunk in ' + holeStrokes + ' strokes.');
        window.setTimeout(() => {
          holeIndex++;
          if (holeIndex >= holes.length) {
            won = true;
            sinking = false;
            recordPlay(true);
            renderMeters();
            setStatus('Nine holes finished in ' + strokes + ' strokes.');
            showDialog('Cleared!', 'Nine holes finished in ' + strokes + ' strokes. Badge logged locally.');
            return;
          }
          sinking = false;
          resetBall();
          renderMeters();
          setStatus('Hole ' + (holeIndex + 1) + '. Par ' + currentHole().par + '.');
        }, 720);
      }
      function canvasPoint(event: PointerEvent) {
        const rect = canvas.getBoundingClientRect();
        return { x: (event.clientX - rect.left) * (W / rect.width), y: (event.clientY - rect.top) * (H / rect.height) };
      }
      function update(dt: number) {
        if (won || sinking) return;
        ball.x += ball.vx * dt;
        ball.y += ball.vy * dt;
        ball.vx *= Math.pow(0.985, dt * 60);
        ball.vy *= Math.pow(0.985, dt * 60);
        if (speed() < 9) { ball.vx = 0; ball.vy = 0; }
        if (ball.x < 18 + ball.r) { ball.x = 18 + ball.r; ball.vx = Math.abs(ball.vx) * 0.72; }
        if (ball.x > W - 18 - ball.r) { ball.x = W - 18 - ball.r; ball.vx = -Math.abs(ball.vx) * 0.72; }
        if (ball.y < 18 + ball.r) { ball.y = 18 + ball.r; ball.vy = Math.abs(ball.vy) * 0.72; }
        if (ball.y > H - 18 - ball.r) { ball.y = H - 18 - ball.r; ball.vy = -Math.abs(ball.vy) * 0.72; }
        for (const o of currentHole().obstacles) {
          const cx = Math.max(o.x, Math.min(ball.x, o.x + o.w));
          const cy = Math.max(o.y, Math.min(ball.y, o.y + o.h));
          const dx = ball.x - cx;
          const dy = ball.y - cy;
          if (dx * dx + dy * dy <= ball.r * ball.r) {
            if (Math.abs(dx) > Math.abs(dy)) {
              ball.x = cx + Math.sign(dx || 1) * (ball.r + 1);
              ball.vx *= -0.76;
            } else {
              ball.y = cy + Math.sign(dy || 1) * (ball.r + 1);
              ball.vy *= -0.76;
            }
          }
        }
        const [cx, cy] = currentHole().cup;
        if (Math.hypot(ball.x - cx, ball.y - cy) < 21 && speed() < 190) finishHole();
      }
      function drawBevelRect(x: number, y: number, w: number, h: number, color: string) {
        ctx.fillStyle = color;
        ctx.fillRect(x, y, w, h);
        ctx.fillStyle = 'rgba(255,255,255,.62)';
        ctx.fillRect(x, y, w, 3);
        ctx.fillRect(x, y, 3, h);
        ctx.fillStyle = 'rgba(0,0,0,.35)';
        ctx.fillRect(x, y + h - 3, w, 3);
        ctx.fillRect(x + w - 3, y, 3, h);
      }
      function draw() {
        const hole = currentHole();
        ctx.fillStyle = '#0b7f5d';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#086a52';
        for (let y = 24; y < H; y += 32) ctx.fillRect(0, y, W, 2);
        drawBevelRect(12, 12, W - 24, H - 24, 'rgba(0,0,0,0)');
        for (const obstacle of hole.obstacles) drawBevelRect(obstacle.x, obstacle.y, obstacle.w, obstacle.h, '#c0c0c0');
        ctx.fillStyle = '#101018';
        ctx.beginPath();
        ctx.arc(hole.cup[0], hole.cup[1], 18, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = '#ffffcc';
        ctx.font = '700 13px Courier New';
        ctx.textAlign = 'left';
        ctx.fillText('HOLE ' + (holeIndex + 1) + '  PAR ' + hole.par, 20, 34);
        if (aiming) {
          ctx.strokeStyle = '#ffff00';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(ball.x, ball.y);
          ctx.lineTo(aimNow.x, aimNow.y);
          ctx.stroke();
        }
        if (noun.complete && noun.naturalWidth) {
          ctx.drawImage(noun, ball.x - 17, ball.y - 17, 34, 34);
        } else {
          ctx.fillStyle = '#f7c325';
          ctx.beginPath();
          ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      function frame(t: number) {
        const dt = last ? Math.min(0.033, (t - last) / 1000) : 0;
        last = t;
        update(dt);
        draw();
        raf = requestAnimationFrame(frame);
      }
      canvas.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        if (won || sinking || speed() > 1) return;
        const p = canvasPoint(event);
        canvas.setPointerCapture(event.pointerId);
        aiming = true;
        aimStart = p;
        aimNow = p;
      });
      canvas.addEventListener('pointermove', (event) => {
        if (!aiming) return;
        event.preventDefault();
        aimNow = canvasPoint(event);
      });
      canvas.addEventListener('pointerup', (event) => {
        if (!aiming) return;
        event.preventDefault();
        aimNow = canvasPoint(event);
        aiming = false;
        const dx = aimNow.x - aimStart.x;
        const dy = aimNow.y - aimStart.y;
        const power = Math.min(520, Math.hypot(dx, dy) * 3.2);
        if (power < 20) return;
        const angle = Math.atan2(dy, dx);
        ball.vx = Math.cos(angle) * power;
        ball.vy = Math.sin(angle) * power;
        strokes++;
        holeStrokes++;
        renderMeters();
        setStatus('Stroke ' + strokes + '.');
      });
      canvas.addEventListener('pointercancel', () => { aiming = false; });
      root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else { last = 0; raf = requestAnimationFrame(frame); }
      });
      renderMeters();
      newGame();
    }
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,760px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:44ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; flex-wrap:wrap; gap:6px; }
  .meters span { min-width:70px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 18px/1 "Courier New",monospace; color:#000080; }
  .stage { position:relative; width:min(calc(100vw - 36px),360px); margin:4px auto 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#0b7f5d; }
  canvas { display:block; width:100%; height:auto; image-rendering:pixelated; touch-action:none; user-select:none; -webkit-user-select:none; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 8px 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
</style>
