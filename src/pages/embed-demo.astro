---
/**
 * /embed-demo — proves <pointcast-room> drops on any page.
 *
 * Sprint 5 of the live-artifacts arc. The page is intentionally
 * styled as someone else's site (a fake personal blog) so the
 * embed's Shadow-DOM isolation is visible: the outer page uses
 * one typography/palette, the embed brings its own.
 *
 * Includes a copy-able snippet so visitors can paste the embed
 * into their own blog or doc.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = '<pointcast-room> embed — drop a live room into any page';
const description = 'A web component that fetches a PointCast room contract and renders it inline. Shadow DOM keeps your styles out and the room\'s styles in.';
---

<BlockLayout title={title} description={description}>
  <main class="embed-demo">

    <header class="embed-demo__head">
      <p class="kicker mono">DISTRIBUTION · SPRINT 5 · LIVE ARTIFACTS</p>
      <h1>&lt;pointcast-room&gt; — a live room you can drop anywhere.</h1>
      <p class="dek">
        One script tag. One custom element. The room fetches its contract from
        <a href="/meditate.json">/meditate.json</a>, validates against
        <a href="/room-contract/v1.json">room-contract v1</a>, and renders inside
        its own Shadow DOM — your site's CSS won't leak in, and the room's CSS
        won't leak out. Drop it on a blog, a doc, a Notion page that allows HTML,
        or another node entirely via the <code>host</code> attribute.
      </p>
    </header>

    <section class="embed-demo__snippet">
      <p class="embed-demo__kicker mono">PASTE THIS</p>
      <pre><code>{`<script src="https://pointcast.xyz/embed.js" defer></script>
<pointcast-room id="meditate"></pointcast-room>`}</code></pre>
      <p class="embed-demo__note">
        Or render a room from a federated node:
        <code>{`<pointcast-room id="meditate" host="https://yournode.example"></pointcast-room>`}</code>
      </p>
    </section>

    {/* The actual blog-shell wrapper — different typography, different palette */}
    <article class="blog">
      <header class="blog__head">
        <p class="blog__kicker">A fake personal blog · 2026-05-14</p>
        <h2 class="blog__title">On hosting a room someone else built.</h2>
        <p class="blog__byline">— anonymous reader</p>
      </header>

      <p class="blog__p">
        I read about PointCast last week and wanted to put a live room on my own
        site. Most embeddable widgets I've tried over the years either inherit my
        styles in ugly ways or override them aggressively. The PointCast embed
        uses Shadow DOM, which means the room lives inside a sealed boundary —
        my serif body type doesn't reach in, and the room's italic display type
        doesn't reach out into this paragraph.
      </p>

      <p class="blog__p">
        Here's the meditation room, served by <code>pointcast.xyz</code>:
      </p>

      <!-- Live embed in the middle of the post -->
      <div class="blog__embed">
        <pointcast-room id="meditate"></pointcast-room>
      </div>

      <p class="blog__p">
        It loads its contract from <code>/meditate.json</code>. If I click
        "Ring the room", it POSTs to <code>/drum-v6/sing</code> and renders
        the receipt right below the button. Same room as the canonical page
        at <a href="https://pointcast.xyz/r/meditate">pointcast.xyz/r/meditate</a>,
        just hosted on my surface instead of theirs.
      </p>
    </article>

    <footer class="embed-demo__foot mono">
      <span><strong>more:</strong></span>
      <a href="/r/meditate">canonical /r/meditate</a>
      <a href="/r/federation/demo">/r/federation/demo</a>
      <a href="/embed.js">/embed.js source</a>
      <a href="/meditate.json">/meditate.json</a>
    </footer>

  </main>
</BlockLayout>

<script src="/embed.js" defer></script>

<style>
  .embed-demo {
    max-width: 1040px;
    margin: 0 auto;
    padding: 32px 22px 60px;
    background: #f7f5ef;
    min-height: calc(100vh - 88px);
    color: #1f1b15;
  }

  .embed-demo__head { margin: 0 0 28px; }
  .embed-demo__head .kicker {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: #6a6154;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .embed-demo__head h1 {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .embed-demo__head .dek {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4434;
    max-width: 740px;
  }
  .embed-demo__head .dek a { color: #c4952e; text-decoration: none; border-bottom: 1px solid currentColor; }
  .embed-demo__head .dek code { background: rgba(31,27,21,0.07); padding: 1px 5px; border-radius: 2px; font-size: 13px; }

  /* Snippet card */
  .embed-demo__snippet {
    margin: 0 0 36px;
    padding: 16px 18px;
    background: #1f1b15;
    border-radius: 8px;
    color: #fbf3df;
  }
  .embed-demo__kicker {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: #c4952e;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .embed-demo__snippet pre {
    margin: 0 0 12px;
    overflow-x: auto;
  }
  .embed-demo__snippet code {
    display: block;
    padding: 12px 14px;
    background: rgba(255,255,255,0.06);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 12.5px;
    line-height: 1.5;
    color: #f3eccd;
  }
  .embed-demo__note {
    margin: 0;
    font-size: 12px;
    color: #d5cbb1;
    line-height: 1.5;
  }
  .embed-demo__note code {
    background: rgba(255,255,255,0.1);
    padding: 1px 4px;
    border-radius: 2px;
  }

  /* The fake-blog wrapper — deliberately different from the room's typography */
  .blog {
    margin: 0 0 40px;
    padding: 32px 36px 36px;
    background: #fff;
    border: 1px solid #ddd9cc;
    border-radius: 12px;
    box-shadow: 0 4px 22px rgba(31, 27, 21, 0.06);
    font-family: 'Charter', 'Iowan Old Style', Georgia, serif;
    color: #2a2418;
  }
  .blog__head {
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ddd9cc;
  }
  .blog__kicker {
    margin: 0 0 8px;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #6a6154;
  }
  .blog__title {
    margin: 0 0 6px;
    font-family: 'Charter', 'Iowan Old Style', Georgia, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .blog__byline {
    margin: 0;
    font-size: 13px;
    color: #6a6154;
    font-style: italic;
  }
  .blog__p {
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.65;
    color: #2a2418;
  }
  .blog__p code {
    font-family: ui-monospace, monospace;
    font-size: 14px;
    background: rgba(31,27,21,0.06);
    padding: 1px 5px;
    border-radius: 2px;
  }
  .blog__p a {
    color: #1f1b15;
    text-decoration: underline;
    text-decoration-color: #c4952e;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .blog__embed {
    margin: 22px -8px 26px;
    padding: 18px;
    background: #f7f5ef;
    border-radius: 8px;
  }

  .embed-demo__foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px dashed #ddd9cc;
    font-size: 11px;
    color: #6a6154;
    letter-spacing: 0.04em;
  }
  .embed-demo__foot strong {
    color: #4a4434;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 500;
  }
  .embed-demo__foot a {
    color: #1f1b15;
    text-decoration: none;
    border-bottom: 1px solid #ddd9cc;
  }
  .embed-demo__foot a:hover { border-bottom-color: #1f1b15; }

  @media (max-width: 640px) {
    .blog { padding: 22px 20px 24px; }
    .blog__embed { margin: 18px -4px 22px; padding: 12px; }
  }
</style>
