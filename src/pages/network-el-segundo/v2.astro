---
import TezosSessionBridge from '../../components/TezosSessionBridge.astro';

const releaseUrl = 'https://network-el-segundo.mhoydich.chatgpt.site/v2';
const canonicalUrl = 'https://pointcast.xyz/network-el-segundo/v2';
const title = 'Network El Segundo V2 — 100 Windows';
const description =
  'A living nighttime signal wall where each verified Tezos wallet lights one of 100 public windows.';
const authUrl = `/auth/project?target=network-el-segundo&return_to=${encodeURIComponent(releaseUrl)}&source=direct`;
const shareCopy = `Network El Segundo V2 is a city of 100 windows. Each verified Tezos wallet lights one public window with a free Kukai message signature. Zero tez: ${canonicalUrl} #Tezos #TezosArt`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111c" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-v2.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-v2.png" />
    <style is:global>
      :root {
        --night: #07111c;
        --paper: #f4f0df;
        --cyan: #53efff;
        --orange: #ff5a2f;
        --yellow: #f4ff52;
      }
      * { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; overflow-x: hidden; background: var(--night); color: var(--paper); }
      body { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .v2-frame { min-height: 100vh; display: grid; grid-template-rows: auto auto 1fr; }
      .v2-rail {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1rem;
        min-height: 3.5rem;
        padding: .55rem .8rem;
        border-bottom: 1px solid rgba(244, 240, 223, .5);
        background: var(--night);
        font-size: .62rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .v2-rail a { color: inherit; font-weight: 900; text-underline-offset: 3px; }
      .v2-rail__mark { display: flex; align-items: center; gap: .5rem; min-width: 0; }
      .v2-rail__mark span { width: .55rem; height: .55rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 16px var(--cyan); }
      .v2-rail__join { padding: .4rem .55rem; border: 1px solid var(--cyan); background: var(--cyan); color: var(--night) !important; text-decoration: none; }
      .v2-status {
        display: grid;
        grid-template-columns: auto minmax(14rem, 1fr) auto;
        align-items: center;
        gap: .7rem 1rem;
        padding: .65rem .8rem;
        border-bottom: 1px solid var(--night);
        background: var(--orange);
        color: var(--night);
      }
      .v2-status__count { display: flex; align-items: baseline; gap: .4rem; }
      .v2-status__count strong { font: 900 1.8rem/1 Arial, sans-serif; letter-spacing: -.06em; }
      .v2-status__count span, .v2-status p { font-size: .62rem; }
      .v2-status p { margin: 0; line-height: 1.4; }
      .v2-status__actions { display: flex; flex-wrap: wrap; gap: .35rem; }
      .v2-status__actions a,
      .v2-status__actions button {
        appearance: none;
        padding: .43rem .55rem;
        border: 1px solid var(--night);
        border-radius: 0;
        background: var(--yellow);
        color: var(--night);
        cursor: pointer;
        font: 900 .58rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        text-decoration: none;
        text-transform: uppercase;
      }
      .v2-stage { position: relative; min-height: calc(100vh - 7.7rem); background: var(--night); }
      .v2-stage iframe { display: block; width: 100%; height: calc(100vh - 7.7rem); min-height: 680px; border: 0; background: var(--night); }
      .v2-stage__fallback {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: .55rem .65rem;
        border: 1px solid var(--cyan);
        background: var(--night);
        color: var(--cyan);
        font-size: .6rem;
      }
      @media (max-width: 46rem) {
        .v2-rail { grid-template-columns: 1fr auto; }
        .v2-rail > a:not(.v2-rail__join) { display: none; }
        .v2-status { grid-template-columns: auto 1fr; }
        .v2-status__actions { grid-column: 1 / -1; }
        .v2-status__actions a, .v2-status__actions button { flex: 1; }
        .v2-stage { min-height: calc(100svh - 10.5rem); }
        .v2-stage iframe { height: calc(100svh - 10.5rem); min-height: 640px; }
        .v2-stage__fallback { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .v2-rail__mark span { box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <main class="v2-frame">
      <nav class="v2-rail" aria-label="PointCast V2 release navigation">
        <span class="v2-rail__mark"><span aria-hidden="true"></span><a href="/">PointCast</a> / Network El Segundo / V2</span>
        <a href="/network-el-segundo">Open V1</a>
        <a class="v2-rail__join" href={authUrl}>Light a window / 0 ꜩ</a>
      </nav>
      <aside class="v2-status" aria-label="100 Windows public status">
        <div class="v2-status__count">
          <strong data-participant-count>—</strong>
          <span>/ 100 WINDOWS LIT</span>
        </div>
        <p>Each verified wallet lights one public window. Addresses stay private; the installation receives only the shared count.</p>
        <div class="v2-status__actions">
          <button type="button" data-share-v2>Transmit V2</button>
          <a href="/api/network-el-segundo/participants">Inspect count</a>
        </div>
      </aside>
      <section class="v2-stage" aria-label="Network El Segundo V2 — 100 Windows">
        <iframe
          src={releaseUrl}
          title="Network El Segundo V2 — 100 Windows interactive installation"
          allow="clipboard-write; web-share"
          loading="eager"
        ></iframe>
        <a class="v2-stage__fallback" href={releaseUrl} target="_blank" rel="noopener">Open V2 directly ↗</a>
      </section>
    </main>
    <TezosSessionBridge />
    <script define:vars={{ shareCopy, canonicalUrl }}>
      const count = document.querySelector('[data-participant-count]');
      void fetch('/api/network-el-segundo/participants', { cache: 'no-store' })
        .then((response) => response.json())
        .then((result) => {
          if (count) count.textContent = String(Math.max(0, Number(result.count) || 0)).padStart(2, '0');
        })
        .catch(() => {
          if (count) count.textContent = '—';
        });

      document.querySelector('[data-share-v2]')?.addEventListener('click', () => {
        if (typeof navigator.share === 'function') {
          void navigator.share({ title: 'Network El Segundo V2 — 100 Windows', text: shareCopy, url: canonicalUrl }).catch(() => {});
          return;
        }
        void navigator.clipboard.writeText(shareCopy);
      });
    </script>
  </body>
</html>
