---
const releaseUrl = 'https://network-el-segundo.mhoydich.chatgpt.site/mesh-commons';
const canonicalUrl = 'https://pointcast.xyz/network-el-segundo/mesh-commons';
const jsonUrl = 'https://pointcast.xyz/network-el-segundo/mesh-commons.json';
const title = 'Mesh Commons — Network El Segundo';
const description =
  'A cash-floor, two-year plan for a useful community mesh across a 25-mile El Segundo horizon, with local-only sites, games, radio, maps, and a library.';
const shareCopy =
  `Mesh Commons: three rooftops make the first honest mesh. The two-year Network El Segundo plan starts with a $295–$395 proof link, local-only sites and games, and a 25-mile planning horizon—not blanket coverage. ${canonicalUrl}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071018" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href={jsonUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-mesh-commons.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-mesh-commons.png" />
    <style is:global>
      :root {
        --night: #071018;
        --paper: #f4eddd;
        --cyan: #5df1ff;
        --sun: #f7ff5e;
        --orange: #ff6a3d;
      }
      * { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; overflow-x: hidden; background: var(--night); color: var(--paper); }
      body { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .mesh-frame { min-height: 100vh; display: grid; grid-template-rows: auto auto 1fr; }
      .mesh-rail {
        min-height: 3.5rem;
        padding: .55rem .8rem;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid rgba(244, 237, 221, .45);
        font-size: .62rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .mesh-rail a { color: inherit; font-weight: 900; text-underline-offset: 3px; }
      .mesh-rail__mark { display: flex; align-items: center; gap: .5rem; min-width: 0; }
      .mesh-rail__mark span { width: .55rem; height: .55rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 16px var(--cyan); }
      .mesh-rail__json { color: var(--cyan) !important; }
      .mesh-rail__direct { padding: .42rem .58rem; border: 1px solid var(--cyan); background: var(--cyan); color: var(--night) !important; text-decoration: none; }
      .mesh-status {
        padding: .62rem .8rem;
        display: grid;
        grid-template-columns: auto minmax(14rem, 1fr) auto;
        align-items: center;
        gap: .7rem 1rem;
        border-bottom: 1px solid var(--night);
        background: var(--sun);
        color: var(--night);
      }
      .mesh-status strong { font: 900 1.45rem/1 Arial, sans-serif; letter-spacing: -.05em; }
      .mesh-status p { margin: 0; font-size: .62rem; line-height: 1.4; }
      .mesh-status__actions { display: flex; gap: .35rem; }
      .mesh-status__actions a,
      .mesh-status__actions button {
        appearance: none;
        padding: .43rem .55rem;
        border: 1px solid var(--night);
        border-radius: 0;
        background: var(--night);
        color: var(--paper);
        cursor: pointer;
        font: 900 .58rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        text-decoration: none;
        text-transform: uppercase;
      }
      .mesh-stage { position: relative; min-height: calc(100vh - 7.7rem); background: var(--night); }
      .mesh-stage iframe { display: block; width: 100%; height: calc(100vh - 7.7rem); min-height: 760px; border: 0; background: var(--night); }
      .mesh-stage__fallback {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: .55rem .65rem;
        border: 1px solid var(--cyan);
        background: var(--night);
        color: var(--cyan);
        font-size: .6rem;
      }
      @media (max-width: 46rem) {
        .mesh-rail { grid-template-columns: 1fr auto; }
        .mesh-rail__json { display: none; }
        .mesh-status { grid-template-columns: 1fr; }
        .mesh-status__actions a, .mesh-status__actions button { flex: 1; }
        .mesh-stage { min-height: calc(100svh - 11rem); }
        .mesh-stage iframe { height: calc(100svh - 11rem); min-height: 720px; }
        .mesh-stage__fallback { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .mesh-rail__mark span { box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <main class="mesh-frame">
      <nav class="mesh-rail" aria-label="PointCast Mesh Commons navigation">
        <span class="mesh-rail__mark"><span aria-hidden="true"></span><a href="/">PointCast</a> / Network El Segundo / Field Note 004</span>
        <a class="mesh-rail__json" href="/network-el-segundo/mesh-commons.json">Machine plan</a>
        <a class="mesh-rail__direct" href={releaseUrl} target="_blank" rel="noopener">Open regular site ↗</a>
      </nav>
      <aside class="mesh-status" aria-label="Mesh Commons plan facts">
        <strong>25 MILES · 24 MONTHS · $295 FIRST LINK</strong>
        <p>Planning artifact, not active coverage, an internet service offering, emergency infrastructure, a site survey, or permission to install.</p>
        <div class="mesh-status__actions">
          <button type="button" data-share-mesh-commons>Transmit</button>
          <a href="/b/0489">Read Block 0489</a>
        </div>
      </aside>
      <section class="mesh-stage" aria-label="Network El Segundo Mesh Commons plan">
        <iframe
          src={releaseUrl}
          title="Mesh Commons — a two-year community network plan for El Segundo"
          allow="clipboard-write; web-share"
          loading="eager"
        ></iframe>
        <a class="mesh-stage__fallback" href={releaseUrl} target="_blank" rel="noopener">Open the regular site ↗</a>
      </section>
    </main>
    <script define:vars={{ shareCopy, canonicalUrl }}>
      document.querySelector('[data-share-mesh-commons]')?.addEventListener('click', () => {
        if (typeof navigator.share === 'function') {
          void navigator.share({ title: 'Mesh Commons — Network El Segundo', text: shareCopy, url: canonicalUrl }).catch(() => {});
          return;
        }
        void navigator.clipboard.writeText(shareCopy);
      });
    </script>
  </body>
</html>
