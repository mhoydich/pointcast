---
import BlockLayout from '../../layouts/BlockLayout.astro';
import networkDesk from '../../assets/campaigns/network-el-segundo-2026/network-desk.jpg';
import networkGoodVibes from '../../assets/campaigns/network-el-segundo-2026/good-vibes-pickleball.jpg';
import networkFlowers from '../../assets/campaigns/network-el-segundo-2026/dot-matrix-flowers.jpg';

const campaignUrl = 'https://pointcast.xyz/network-el-segundo';
const relayCampaignUrl = 'https://pointcast.xyz/auth/project?target=network-el-segundo&return_to=https%3A%2F%2Fnetwork-el-segundo.mhoydich.chatgpt.site%2F&source=share_kit&utm_source=share_kit&utm_medium=relay&utm_campaign=pc-network-el-segundo-2026';
const shareUrl = 'https://pointcast.xyz/network-el-segundo/share';
const participantUrl = 'https://pointcast.xyz/api/network-el-segundo/participants';
const funnelUrl = 'https://pointcast.xyz/api/network-el-segundo/funnel?days=7';
const communityUpdate = `Network El Segundo is opening a public First 100 Signal for Tezos artists, collectors, and builders. One free Kukai wallet-control signature turns on one light—zero tez, no purchase, mint, funding, or transaction: ${relayCampaignUrl}

Verified-wallet counter: ${participantUrl}
Privacy-safe public funnel: ${funnelUrl}`;
const channelAuthUrl = (source: string) =>
  `https://pointcast.xyz/auth/project?target=network-el-segundo&return_to=https%3A%2F%2Fnetwork-el-segundo.mhoydich.chatgpt.site%2F&source=${source}`;
const communityRooms = [
  {
    id: 'tezos_discord',
    label: 'Official Tezos Discord',
    roomUrl: 'https://discord.com/invite/tezos',
    note: 'Use one relevant community channel; do not mass-post or DM members.',
    copy: `I made a free Tezos participation artwork: one Kukai wallet-control signature turns on one of 100 public lights. Zero tez, no purchase, mint, funding, or transaction. The next light is open: ${channelAuthUrl('tezos_discord')}`,
  },
  {
    id: 'tezos_agora',
    label: 'Tezos Agora · Community Updates',
    roomUrl: 'https://forum.tezosagora.org/c/community-updates/17',
    note: 'Long-form project update with the public counter and methodology.',
    copy: `Network El Segundo has opened a public First 100 Signal: one unique verified Tezos wallet turns on one public light. The free Kukai signature moves no tez and approves no transaction. Join: ${channelAuthUrl('tezos_agora')}\n\nPublic counter: ${participantUrl}\nMethodology: ${funnelUrl}`,
  },
  {
    id: 'teia',
    label: 'Teia Community Discord',
    roomUrl: 'https://discord.com/invite/US8gMfEkM2',
    note: 'Art-and-community fit; introduce the work in context and avoid unsolicited DMs.',
    copy: `Teia artists and collectors: Network El Segundo is building a 100-wallet public light artwork. One free Kukai signature turns on the next light—no mint, purchase, tez, or transaction: ${channelAuthUrl('teia')}`,
  },
  {
    id: 'objkt',
    label: 'objkt Community Discord',
    roomUrl: 'https://discord.gg/Gcr9Dk6qKk',
    note: 'Collector-and-artist fit; community discussion only, not a support request.',
    copy: `objkt artists and collectors: a free Kukai wallet-control signature turns on one light in Network El Segundo's First 100 Signal. Zero tez, no mint, purchase, or transaction: ${channelAuthUrl('objkt')}`,
  },
];
const kukaiPitch = `Hi Kukai team,

Network El Segundo is a free Tezos community artwork using Kukai message signatures: one verified wallet turns on one light in a public First 100 Signal. There is no purchase, mint, funding, or transaction required, and the verified count is published through a public API.

Campaign: ${campaignUrl}
Public counter: ${participantUrl}
Press filing: https://pointcast.xyz/press/network-el-segundo-opens-first-100-tezos-wallet-roster

Would you consider it for Kukai Discover or another appropriate community surface?`;
const relayMessages = [
  {
    label: 'THE CLEAN INVITE',
    audience: 'One Tezos person',
    image: networkDesk.src,
    copy: `Network El Segundo is forming a public first 100. Join with one free Kukai wallet signature—zero tez, no purchase, mint, funding, or transaction: ${relayCampaignUrl} #Tezos #TezosArt`,
  },
  {
    label: 'THE ART ROOM INVITE',
    audience: 'Artists + collectors',
    image: networkFlowers.src,
    copy: `Tezos artists, collectors, and builders: the next founding seat is open in Network El Segundo. One free Kukai signature moves the transparent counter; no purchase or transaction: ${relayCampaignUrl} #TezosArt`,
  },
  {
    label: 'AFTER YOU JOIN',
    audience: 'Your one-to-one relay',
    image: networkGoodVibes.src,
    copy: `I joined Network El Segundo's first 100 verified Tezos wallets. It took one free Kukai message signature and zero tez. Take the next seat, then invite one person: ${relayCampaignUrl}`,
  },
];

const title = 'Pass the Signal — Network El Segundo';
const description = 'Copy, share, or download the zero-cost invitation for Network El Segundo’s first 100 verified Tezos wallets.';
---

<BlockLayout legacy title={title} description={description} image="https://network-el-segundo.mhoydich.chatgpt.site/og.png">
  <div class="relay-page">
    <nav class="relay-nav" aria-label="Network El Segundo relay navigation">
      <a href="/network-el-segundo">← Join desk</a>
      <span>NETWORK EL SEGUNDO / RELAY KIT</span>
      <a href="/api/network-el-segundo/funnel?days=7">Public funnel ↗</a>
    </nav>

    <header class="relay-hero">
      <div class="relay-hero__signal">
        <p class="relay-kicker">PASS THE SIGNAL / FIRST 100</p>
        <h1>Seat <span data-next-seat>2</span><br />is open.</h1>
      </div>
      <div class="relay-hero__action">
        <strong data-relay-count>1 / 100 verified</strong>
        <p>Zero tez. One Kukai message signature. No purchase, mint, funding, or transaction.</p>
        <div class="relay-actions">
          <a class="relay-button relay-button--primary" href={relayCampaignUrl}>Take the next seat</a>
          <button class="relay-button" type="button" data-share-message>Share the invitation</button>
          <button class="relay-button" type="button" data-copy-message={relayMessages[0].copy}>Copy clean invite</button>
        </div>
        <p class="relay-status" data-relay-status aria-live="polite"></p>
      </div>
    </header>

    <section class="relay-rule" aria-label="Founding relay rule">
      <span>01</span><p>Join with one free wallet-control signature.</p>
      <span>02</span><p>Watch the public counter move by one.</p>
      <span>03</span><p>Invite one Tezos artist, collector, builder, or curious friend.</p>
    </section>

    <section class="relay-cards" aria-labelledby="relay-cards-title">
      <header>
        <p class="relay-kicker">THREE POSTER DOORS / NO PAID MEDIA</p>
        <h2 id="relay-cards-title">Pick the note that fits the room.</h2>
      </header>
      <div class="relay-cards__grid">
        {relayMessages.map((message, index) => (
          <article class="relay-card">
            <img src={message.image} alt="" width="1312" height="736" loading={index === 0 ? 'eager' : 'lazy'} />
            <div class="relay-card__copy">
              <p class="relay-kicker">{message.label} / {message.audience}</p>
              <p>{message.copy}</p>
              <div class="relay-card__actions">
                <button type="button" data-copy-message={message.copy}>Copy message</button>
                <a href={message.image} download>Download poster</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="relay-rooms" aria-labelledby="relay-rooms-title">
      <div>
        <p class="relay-kicker">WHERE TO CARRY IT</p>
        <h2 id="relay-rooms-title">One real note beats a hundred tags.</h2>
        <p class="relay-rooms__boundary">Draft-only handoffs. Nothing on this page posts or sends itself.</p>
      </div>
      <div class="relay-rooms__links">
        <a href={`mailto:?subject=${encodeURIComponent('Take a founding seat in Network El Segundo')}&body=${encodeURIComponent(relayMessages[0].copy)}`}>Email one person ↗</a>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(relayMessages[0].copy)}`} target="_blank" rel="noopener">Open an X draft ↗</a>
        <button type="button" data-copy-message={communityUpdate}>Copy community update</button>
        {communityRooms.map((room) => (
          <div class="relay-room">
            <a data-relay-event="tezos_rooms" href={room.roomUrl} target="_blank" rel="noopener">
              <strong>{room.label} ↗</strong>
              <span>{room.note}</span>
            </a>
            <button type="button" data-copy-message={room.copy}>Copy attributed invite</button>
          </div>
        ))}
        <a data-relay-event="tezos_rooms" href={`mailto:contact@kukai.app?subject=${encodeURIComponent('Kukai Discover suggestion — Network El Segundo')}&body=${encodeURIComponent(kukaiPitch)}`}>Draft Kukai Discover pitch ↗</a>
        <a data-relay-event="tezos_rooms" href="https://tezos.com/community" target="_blank" rel="noopener">Full Tezos community directory ↗</a>
        <a href="https://www.tumblr.com/joinusyee/822872758617800704/network-el-segundo-the-first-100-wallets-buy-the" target="_blank" rel="noopener">Tumblr signal ↗</a>
        <a href="https://hoydich.wordpress.com/2026/07/22/network-el-segundo-the-first-100-wallets-make-the-network/" target="_blank" rel="noopener">WordPress story ↗</a>
        <a href="/press/network-el-segundo-opens-first-100-tezos-wallet-roster">Press filing ↗</a>
      </div>
    </section>

    <footer class="relay-footer">
      <p>The verified-wallet counter is the only participation total. Browser events are aggregate funnel signals, not unique people.</p>
      <p>The 50% post-sale distribution idea remains a prototype. No sale contract, payout contract, token, automated yield system, investment, or return is live.</p>
      <a href={shareUrl}>pointcast.xyz/network-el-segundo/share</a>
    </footer>
  </div>

  <script define:vars={{ campaignUrl, relayMessages }}>
    const participantEndpoint = '/api/network-el-segundo/participants';
    const funnelEndpoint = '/api/network-el-segundo/funnel';
    const status = document.querySelector('[data-relay-status]');

    function trackingDisabled() {
      try {
        return navigator.doNotTrack === '1' || localStorage.getItem('pc:no-track') === '1';
      } catch {
        return navigator.doNotTrack === '1';
      }
    }

    function sendRelayEvent(event) {
      if (trackingDisabled()) return;
      const body = JSON.stringify({ event, source: 'share_kit' });
      if (navigator.sendBeacon?.(funnelEndpoint, new Blob([body], { type: 'application/json' }))) return;
      void fetch(funnelEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true,
      });
    }

    async function copyMessage(message) {
      await navigator.clipboard.writeText(message);
      if (status) status.textContent = 'Invitation copied. Send it to one person, in context.';
      sendRelayEvent('copy');
    }

    document.querySelectorAll<HTMLElement>('[data-copy-message]').forEach((button) => {
      button.addEventListener('click', () => {
        void copyMessage(button.dataset.copyMessage || campaignUrl).catch(() => {
          if (status) status.textContent = campaignUrl;
        });
      });
    });

    document.querySelectorAll<HTMLElement>('[data-relay-event]').forEach((link) => {
      link.addEventListener('click', () => sendRelayEvent(link.dataset.relayEvent));
    });

    document.querySelector('[data-share-message]')?.addEventListener('click', () => {
      if (typeof navigator.share === 'function') {
        void navigator.share({
          title: 'Network El Segundo — First 100',
          text: relayMessages[0].copy,
          url: relayCampaignUrl,
        }).then(() => sendRelayEvent('relay')).catch(() => {});
        return;
      }
      void copyMessage(relayMessages[0].copy);
    });

    async function refreshCounter() {
      try {
        const response = await fetch(participantEndpoint, { cache: 'no-store' });
        const payload = await response.json();
        if (!response.ok || payload.ok !== true) return;
        const nextSeat = Math.min(payload.target, payload.count + 1);
        document.querySelectorAll('[data-next-seat]').forEach((element) => { element.textContent = String(nextSeat); });
        document.querySelectorAll('[data-relay-count]').forEach((element) => { element.textContent = `${payload.count} / ${payload.target} verified`; });
      } catch {
        // The share kit remains useful if the public counter is temporarily unavailable.
      }
    }

    void refreshCounter();
  </script>
</BlockLayout>

<style>
  :global(body) { margin: 0; background: #f2efe6; color: #111; }
  .relay-page { --yellow: #f2ff47; --pink: #ff4f9f; --blue: #1748d1; min-height: 100vh; font-family: var(--pc-font-sans, Arial, sans-serif); }
  .relay-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 18px; background: #111; color: #fff; font: 700 10px/1.2 var(--pc-font-mono, monospace); letter-spacing: .08em; text-transform: uppercase; }
  .relay-nav a { color: inherit; }
  .relay-hero { min-height: 68vh; display: grid; grid-template-columns: 1.25fr .75fr; background: var(--yellow); border-bottom: 2px solid #111; }
  .relay-hero__signal { display: flex; justify-content: space-between; flex-direction: column; padding: clamp(28px, 6vw, 84px); border-right: 2px solid #111; }
  .relay-kicker { margin: 0; font: 800 10px/1.35 var(--pc-font-mono, monospace); letter-spacing: .12em; text-transform: uppercase; }
  .relay-hero h1 { margin: 24px 0 0; font-size: clamp(76px, 14vw, 230px); font-weight: 400; line-height: .72; letter-spacing: -.075em; }
  .relay-hero h1 span { color: var(--pink); }
  .relay-hero__action { display: flex; justify-content: flex-end; flex-direction: column; gap: 18px; padding: clamp(28px, 5vw, 72px); background: var(--pink); }
  .relay-hero__action strong { font: 800 clamp(24px, 4vw, 56px)/1 var(--pc-font-mono, monospace); }
  .relay-hero__action > p { max-width: 38ch; font-size: clamp(17px, 2vw, 25px); line-height: 1.2; }
  .relay-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .relay-button, .relay-card__actions a, .relay-card__actions button { padding: 12px 14px; border: 2px solid #111; color: #111; background: #fff; box-shadow: 4px 4px 0 #111; font: 800 10px/1 var(--pc-font-mono, monospace); text-decoration: none; text-transform: uppercase; cursor: pointer; }
  .relay-button--primary { background: var(--yellow); }
  .relay-status { min-height: 1.3em; margin: 0; font: 700 10px/1.3 var(--pc-font-mono, monospace); }
  .relay-rule { display: grid; grid-template-columns: auto 1fr auto 1fr auto 1fr; gap: 16px; padding: 24px; border-bottom: 2px solid #111; background: #fff; }
  .relay-rule span { color: var(--blue); font: 900 30px/1 var(--pc-font-mono, monospace); }
  .relay-rule p { margin: 0; max-width: 30ch; font-size: 15px; font-weight: 700; line-height: 1.25; }
  .relay-cards { padding: clamp(32px, 6vw, 84px) 18px; }
  .relay-cards > header { display: grid; grid-template-columns: 1fr 2fr; gap: 24px; margin-bottom: 28px; }
  .relay-cards h2, .relay-rooms h2 { margin: 0; font-size: clamp(42px, 7vw, 100px); font-weight: 400; line-height: .9; letter-spacing: -.055em; }
  .relay-cards__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .relay-card { min-width: 0; border: 2px solid #111; background: #fff; }
  .relay-card:nth-child(2) { transform: translateY(24px); }
  .relay-card img { display: block; width: 100%; aspect-ratio: 1 / .82; object-fit: cover; border-bottom: 2px solid #111; }
  .relay-card__copy { padding: 18px; }
  .relay-card__copy > p:not(.relay-kicker) { min-height: 9em; font-size: 14px; line-height: 1.45; }
  .relay-card__actions { display: flex; flex-wrap: wrap; gap: 9px; }
  .relay-card__actions a, .relay-card__actions button { padding: 9px 10px; border-width: 1px; box-shadow: 2px 2px 0 #111; }
  .relay-rooms { display: grid; grid-template-columns: 1.2fr .8fr; gap: 36px; padding: clamp(36px, 7vw, 96px) clamp(18px, 6vw, 84px); color: #fff; background: var(--blue); }
  .relay-rooms__boundary { max-width: 45ch; margin: 28px 0 0; color: #f2ff47; font: 700 10px/1.45 var(--pc-font-mono, monospace); letter-spacing: .06em; text-transform: uppercase; }
  .relay-rooms__links { display: grid; align-content: end; border-top: 1px solid #fff; }
  .relay-rooms__links > a, .relay-rooms__links > button { appearance: none; width: 100%; padding: 13px 0; border: 0; border-bottom: 1px solid #fff; color: inherit; background: transparent; font: 700 12px/1.2 var(--pc-font-mono, monospace); text-align: left; text-decoration: none; text-transform: uppercase; cursor: pointer; }
  .relay-room { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 12px 0; border-bottom: 1px solid #fff; }
  .relay-room a { display: grid; gap: 5px; color: inherit; text-decoration: none; }
  .relay-room strong { font: 800 12px/1.2 var(--pc-font-mono, monospace); text-transform: uppercase; }
  .relay-room span { max-width: 52ch; color: #c5d7ff; font: 500 10px/1.4 var(--pc-font-mono, monospace); }
  .relay-room button { appearance: none; padding: 8px 10px; border: 1px solid #fff; color: #fff; background: transparent; font: 700 9px/1.1 var(--pc-font-mono, monospace); text-transform: uppercase; cursor: pointer; }
  .relay-footer { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 28px 18px; background: #111; color: #fff; font: 500 10px/1.5 var(--pc-font-mono, monospace); }
  .relay-footer p { margin: 0; max-width: 72ch; }
  .relay-footer a { grid-column: 1 / -1; color: var(--yellow); }
  @media (max-width: 760px) {
    .relay-nav { align-items: flex-start; flex-direction: column; }
    .relay-hero { min-height: 0; grid-template-columns: 1fr; }
    .relay-hero__signal { min-height: 46vh; border-right: 0; border-bottom: 2px solid #111; }
    .relay-hero h1 { font-size: clamp(88px, 29vw, 150px); }
    .relay-hero__action { gap: 14px; padding: 24px 18px 28px; }
    .relay-rule { grid-template-columns: auto 1fr; }
    .relay-cards > header, .relay-rooms, .relay-footer { grid-template-columns: 1fr; }
    .relay-cards__grid { grid-template-columns: 1fr; }
    .relay-card:nth-child(2) { transform: none; }
    .relay-card__copy > p:not(.relay-kicker) { min-height: 0; }
    .relay-room { grid-template-columns: 1fr; }
    .relay-room button { width: 100%; }
    .relay-footer a { grid-column: 1; overflow-wrap: anywhere; }
  }
  @media (prefers-reduced-motion: reduce) { .relay-card:nth-child(2) { transform: none; } }
</style>
