---
const releaseUrl = 'https://network-el-segundo.mhoydich.chatgpt.site/field-kit';
const canonicalUrl = 'https://pointcast.xyz/network-el-segundo/field-kit';
const jsonUrl = 'https://pointcast.xyz/network-el-segundo/field-kit.json';
const title = 'Local Signal Field Kit — Network El Segundo';
const description =
  'Eight neighbor-scale communication products and a three-phase rollout map for an opt-in El Segundo mesh.';
const shareCopy =
  `Local Signal Field Kit: eight neighbor-scale instruments for an opt-in El Segundo mesh—beams, window lights, quiet chimes, touch signals, and mini fireworks with zero fire. Designed by MH. ${canonicalUrl}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b10" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href={jsonUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-field-kit.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://network-el-segundo.mhoydich.chatgpt.site/og-field-kit.png" />
    <style is:global>
      :root {
        --night: #070b10;
        --paper: #f5eee0;
        --cyan: #63f5ff;
        --acid: #f5ff59;
      }
      * { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; overflow-x: hidden; background: var(--night); color: var(--paper); }
      body { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .field-frame { min-height: 100vh; display: grid; grid-template-rows: auto auto 1fr; }
      .field-rail {
        min-height: 3.5rem;
        padding: .55rem .8rem;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid rgba(245, 238, 224, .45);
        background: var(--night);
        font-size: .62rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .field-rail a { color: inherit; font-weight: 900; text-underline-offset: 3px; }
      .field-rail__mark { display: flex; align-items: center; gap: .5rem; min-width: 0; }
      .field-rail__mark span { width: .55rem; height: .55rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 16px var(--cyan); }
      .field-rail__json { color: var(--cyan) !important; }
      .field-rail__direct { padding: .42rem .58rem; border: 1px solid var(--cyan); background: var(--cyan); color: var(--night) !important; text-decoration: none; }
      .field-status {
        padding: .62rem .8rem;
        display: grid;
        grid-template-columns: auto minmax(14rem, 1fr) auto;
        align-items: center;
        gap: .7rem 1rem;
        border-bottom: 1px solid var(--night);
        background: var(--acid);
        color: var(--night);
      }
      .field-status strong { font: 900 1.45rem/1 Arial, sans-serif; letter-spacing: -.05em; }
      .field-status p { margin: 0; font-size: .62rem; line-height: 1.4; }
      .field-status__actions { display: flex; gap: .35rem; }
      .field-status__actions a,
      .field-status__actions button {
        appearance: none;
        padding: .43rem .55rem;
        border: 1px solid var(--night);
        border-radius: 0;
        background: var(--night);
        color: var(--paper);
        cursor: pointer;
        font: 900 .58rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        text-decoration: none;
        text-transform: uppercase;
      }
      .field-stage { position: relative; min-height: calc(100vh - 7.7rem); background: var(--night); }
      .field-stage iframe { display: block; width: 100%; height: calc(100vh - 7.7rem); min-height: 720px; border: 0; background: var(--night); }
      .field-stage__fallback {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: .55rem .65rem;
        border: 1px solid var(--cyan);
        background: var(--night);
        color: var(--cyan);
        font-size: .6rem;
      }
      @media (max-width: 46rem) {
        .field-rail { grid-template-columns: 1fr auto; }
        .field-rail__json { display: none; }
        .field-status { grid-template-columns: 1fr; }
        .field-status__actions a, .field-status__actions button { flex: 1; }
        .field-stage { min-height: calc(100svh - 11rem); }
        .field-stage iframe { height: calc(100svh - 11rem); min-height: 680px; }
        .field-stage__fallback { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .field-rail__mark span { box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <main class="field-frame">
      <nav class="field-rail" aria-label="PointCast Local Signal Field Kit navigation">
        <span class="field-rail__mark"><span aria-hidden="true"></span><a href="/">PointCast</a> / Network El Segundo / Field Note 003</span>
        <a class="field-rail__json" href="/network-el-segundo/field-kit.json">Machine release</a>
        <a class="field-rail__direct" href={releaseUrl} target="_blank" rel="noopener">Open regular site ↗</a>
      </nav>
      <aside class="field-status" aria-label="Local Signal Field Kit release facts">
        <strong>8 OBJECTS · 4 SIGNALS · 24 NODES</strong>
        <p>Concept products and an opt-in rollout study. No municipal affiliation, emergency channel, surveillance, certified hardware, pyrotechnics, or live location system.</p>
        <div class="field-status__actions">
          <button type="button" data-share-field-kit>Transmit</button>
          <a href="/b/0488">Read Block 0488</a>
        </div>
      </aside>
      <section class="field-stage" aria-label="Local Signal Field Kit interactive site">
        <iframe
          src={releaseUrl}
          title="Local Signal Field Kit — eight products and an El Segundo rollout map"
          allow="clipboard-write; web-share"
          loading="eager"
        ></iframe>
        <a class="field-stage__fallback" href={releaseUrl} target="_blank" rel="noopener">Open the regular site ↗</a>
      </section>
    </main>
    <script define:vars={{ shareCopy, canonicalUrl }}>
      document.querySelector('[data-share-field-kit]')?.addEventListener('click', () => {
        if (typeof navigator.share === 'function') {
          void navigator.share({ title: 'Local Signal Field Kit', text: shareCopy, url: canonicalUrl }).catch(() => {});
          return;
        }
        void navigator.clipboard.writeText(shareCopy);
      });
    </script>
  </body>
</html>
