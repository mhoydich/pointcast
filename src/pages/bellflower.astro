---
import {
  BELLFLOWER_META,
  BELLFLOWER_RECEIPT_KEY,
  BELLFLOWER_RECEIPT_SCHEMA,
  BELLFLOWER_STAGES,
  BELLFLOWER_STORAGE_KEY,
} from '../lib/bellflower.mjs';

const first = BELLFLOWER_STAGES[0];
const pageTitle = `${BELLFLOWER_META.title} | PointCast`;
const canonical = `https://pointcast.xyz${BELLFLOWER_META.route}`;
const stagesJson = JSON.stringify(BELLFLOWER_STAGES);
const runtimeJson = JSON.stringify({
  storageKey: BELLFLOWER_STORAGE_KEY,
  receiptKey: BELLFLOWER_RECEIPT_KEY,
  receiptSchema: BELLFLOWER_RECEIPT_SCHEMA,
  meta: BELLFLOWER_META,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: BELLFLOWER_META.title,
  alternateName: BELLFLOWER_META.subtitle,
  url: canonical,
  description: BELLFLOWER_META.description,
  applicationCategory: 'MultimediaApplication',
  gamePlatform: 'Web browser',
  isAccessibleForFree: true,
  numberOfPlayers: 1,
  author: {
    '@type': 'Person',
    name: 'Michael Hoydich',
  },
  image: `https://pointcast.xyz${first.background}`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#11150e" />
    <meta name="description" content={BELLFLOWER_META.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={BELLFLOWER_META.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://pointcast.xyz${first.background}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href={BELLFLOWER_META.jsonRoute} title="Bellflower JSON" />
    <link rel="preload" as="image" href={first.background} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <main
      class="bf"
      data-bellflower
      data-stage={first.id}
      data-stage-index="0"
      data-audio-state="locked"
      data-muted="false"
      data-motion="full"
      data-complete="false"
      data-play-count="0"
      data-replay-count="0"
      data-noun-image="loading"
      style={`--bf-bg: url('${first.background}'); --bf-accent: ${first.accent}; --bf-bloom: ${first.bloom}; --bf-shadow: ${first.shadow};`}
    >
      <script id="bellflower-stages" type="application/json" set:html={stagesJson}></script>
      <script id="bellflower-runtime" type="application/json" set:html={runtimeJson}></script>

      <div class="bf__backdrop" aria-hidden="true"></div>
      <div class="bf__shade" aria-hidden="true"></div>
      <div class="bf__wash" aria-hidden="true"></div>
      <div class="bf__bloom-layer" data-bloom-layer aria-hidden="true"></div>

      <header class="bf__topbar" data-ui>
        <a class="bf__exit" href="/" aria-label="Exit Bellflower to PointCast">Exit</a>
        <div class="bf__identity" aria-label="Bellflower progress">
          <strong>Bellflower</strong>
          <span data-stage-counter>01 / 10</span>
        </div>
        <div class="bf__controls" aria-label="Sound and game controls">
          <button type="button" data-sound aria-pressed="true">Sound on</button>
          <button type="button" data-replay>Replay</button>
          <button type="button" data-art-queue>Art queue</button>
          <button type="button" data-restart>Restart</button>
        </div>
      </header>

      <section
        class="bf__field"
        data-field
        tabindex="0"
        aria-label="Bellflower listening field. Click, tap, or press Space or Enter to ring."
      >
        <div class="bf__stage-copy">
          <p class="bf__visit" data-visit-label>Visit 01 · {first.sound.label}</p>
          <h1 data-title>{first.title}</h1>
          <p data-whisper>{first.whisper}</p>
        </div>

        <button
          class="bf__ritual"
          type="button"
          data-ritual
          aria-label={`Ring ${first.sound.label}. ${first.ritual}`}
          aria-keyshortcuts="Space Enter"
        >
          <span class="bf__noun-halo" aria-hidden="true"></span>
          <img
            class="bf__noun"
            data-noun
            src={`https://noun.pics/${first.nounId}.svg`}
            alt={`Noun ${first.nounId}, the listening companion for ${first.title}`}
            width="420"
            height="420"
            decoding="async"
          />
          <span class="bf__strike-mark" aria-hidden="true"></span>
          <span class="bf__press-label">Press to sound</span>
        </button>

        <div class="bf__lower">
          <div class="bf__ritual-copy" aria-live="polite">
            <p data-ritual-copy>{first.ritual}</p>
            <div class="bf__strikes" data-strike-dots aria-label={`0 of ${first.strikesRequired} sounds complete`}>
              {Array.from({ length: first.strikesRequired }).map(() => <i></i>)}
            </div>
            <p class="bf__status" data-status>Sound begins with your first gesture.</p>
          </div>

          <nav class="bf__navigation" aria-label="Visit navigation" data-ui>
            <button type="button" data-back disabled>Back</button>
            <button type="button" data-next disabled>Continue</button>
          </nav>
        </div>
      </section>

      <footer class="bf__credit">
        <span>Created for Michael Hoydich</span>
        <a href="/bellflower.json">JSON</a>
      </footer>

      <dialog class="bf__dialog bf__dialog--art" data-art-dialog aria-labelledby="bf-art-title">
        <div class="bf__dialog-head">
          <div>
            <p>Later-art queue</p>
            <h2 id="bf-art-title">Bellflower environments</h2>
          </div>
          <button type="button" data-close-art aria-label="Close art queue">Close</button>
        </div>
        <p class="bf__dialog-note">
          The live game uses existing PointCast shrine artwork. These prompts are a secondary queue for a later replacement pass and do not claim that new images already exist.
        </p>
        <ol class="bf__prompt-list">
          {BELLFLOWER_STAGES.map((stage) => (
            <li>
              <div>
                <span>{String(stage.number).padStart(2, '0')}</span>
                <strong>{stage.title}</strong>
              </div>
              <p>{stage.midjourney}</p>
              <button type="button" data-copy-prompt={stage.number - 1}>Copy prompt</button>
            </li>
          ))}
        </ol>
      </dialog>

      <dialog class="bf__dialog bf__dialog--receipt" data-receipt-dialog aria-labelledby="bf-receipt-title">
        <div class="bf__dialog-head">
          <div>
            <p>Listening complete</p>
            <h2 id="bf-receipt-title">The garden keeps the sound.</h2>
          </div>
          <button type="button" data-close-receipt aria-label="Close completion receipt">Close</button>
        </div>
        <p class="bf__dialog-note">
          Ten Nouns, ten original Web Audio instruments, one local-only pilgrimage.
        </p>
        <pre data-receipt-json tabindex="0"></pre>
        <div class="bf__receipt-actions">
          <button type="button" data-copy-receipt>Copy receipt JSON</button>
          <button type="button" data-restart-receipt>Begin again</button>
          <a href="/">Exit to PointCast</a>
        </div>
      </dialog>

      <div class="bf__announcer" data-announcer aria-live="assertive" aria-atomic="true"></div>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-width: 320px;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #080a08;
  }

  button,
  a {
    font: inherit;
  }

  button {
    letter-spacing: 0;
  }

  .bf {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    color: #fff;
    background: var(--bf-shadow);
  }

  .bf__backdrop,
  .bf__shade,
  .bf__wash,
  .bf__bloom-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bf__backdrop {
    z-index: -4;
    background-image: var(--bf-bg);
    background-position: center;
    background-size: cover;
    transform: scale(1.015);
    transition: opacity 520ms ease, transform 9s ease;
    animation: bf-breathe 18s ease-in-out infinite alternate;
  }

  .bf__shade {
    z-index: -3;
    background:
      linear-gradient(180deg, rgba(4, 6, 5, 0.72) 0%, rgba(4, 6, 5, 0.12) 28%, rgba(4, 6, 5, 0.08) 56%, rgba(4, 6, 5, 0.78) 100%),
      linear-gradient(90deg, rgba(3, 5, 4, 0.22), transparent 34%, transparent 66%, rgba(3, 5, 4, 0.22));
  }

  .bf__wash {
    z-index: -2;
    background: color-mix(in srgb, var(--bf-accent) 34%, transparent);
    opacity: 0;
  }

  .bf.is-blooming .bf__wash {
    animation: bf-wash 900ms ease-out;
  }

  .bf__bloom-layer {
    z-index: 2;
    overflow: hidden;
  }

  .bf__topbar {
    position: absolute;
    z-index: 8;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: minmax(58px, 1fr) auto minmax(340px, 1fr);
    align-items: center;
    min-height: 64px;
    padding: max(10px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) 8px max(14px, env(safe-area-inset-left));
    background: rgba(4, 6, 5, 0.42);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(14px);
  }

  .bf__exit,
  .bf__controls button,
  .bf__navigation button,
  .bf__dialog button,
  .bf__dialog a {
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 6px;
    background: rgba(6, 8, 7, 0.58);
    color: #fff;
    text-decoration: none;
    cursor: pointer;
  }

  .bf__exit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
  }

  .bf__identity {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .bf__identity strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .bf__identity span,
  .bf__visit,
  .bf__status,
  .bf__credit,
  .bf__dialog-head p,
  .bf__prompt-list span {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .bf__controls {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }

  .bf__controls button {
    min-width: 76px;
    padding: 0 12px;
  }

  .bf__exit:hover,
  .bf__controls button:hover,
  .bf__navigation button:hover:not(:disabled),
  .bf__dialog button:hover,
  .bf__dialog a:hover {
    border-color: var(--bf-bloom);
    background: color-mix(in srgb, var(--bf-accent) 22%, rgba(6, 8, 7, 0.76));
  }

  :focus-visible {
    outline: 3px solid var(--bf-bloom);
    outline-offset: 3px;
  }

  .bf__field {
    position: absolute;
    inset: 64px 0 0;
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    padding: 20px max(18px, env(safe-area-inset-right)) max(42px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left));
    cursor: crosshair;
  }

  .bf__stage-copy {
    max-width: min(720px, calc(100vw - 40px));
    text-align: center;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.82);
  }

  .bf__visit {
    margin: 0 0 8px;
    color: var(--bf-bloom);
  }

  .bf__stage-copy h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 38px;
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .bf__stage-copy > p:last-child {
    margin: 8px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    line-height: 1.35;
  }

  .bf__ritual {
    position: relative;
    display: grid;
    place-items: center;
    width: min(44vmin, 430px);
    aspect-ratio: 1;
    min-width: 230px;
    border: 0;
    border-radius: 50%;
    padding: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .bf__noun-halo {
    position: absolute;
    inset: 9%;
    border: 1px solid color-mix(in srgb, var(--bf-bloom) 62%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bf-shadow) 36%, transparent);
    box-shadow:
      0 0 90px color-mix(in srgb, var(--bf-accent) 32%, transparent),
      inset 0 0 60px color-mix(in srgb, var(--bf-accent) 16%, transparent);
    backdrop-filter: blur(3px);
    animation: bf-halo 7s ease-in-out infinite;
  }

  .bf__noun {
    position: relative;
    z-index: 2;
    width: 78%;
    height: 78%;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.62));
    transition: transform 250ms ease, filter 250ms ease;
  }

  .bf__ritual:hover .bf__noun {
    transform: translateY(-4px);
    filter:
      drop-shadow(0 20px 24px rgba(0, 0, 0, 0.62))
      drop-shadow(0 0 18px color-mix(in srgb, var(--bf-accent) 45%, transparent));
  }

  .bf__ritual.is-ringing .bf__noun {
    animation: bf-noun-ring 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .bf__strike-mark {
    position: absolute;
    z-index: 3;
    bottom: 8%;
    width: 50px;
    height: 50px;
    border: 2px solid var(--bf-bloom);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bf-accent) 42%, rgba(8, 10, 8, 0.78));
    box-shadow: 0 0 28px color-mix(in srgb, var(--bf-accent) 48%, transparent);
  }

  .bf__strike-mark::before,
  .bf__strike-mark::after {
    content: "";
    position: absolute;
    left: 50%;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .bf__strike-mark::before {
    top: 10px;
    width: 22px;
    height: 18px;
    border: 2px solid #fff;
    border-bottom: 0;
  }

  .bf__strike-mark::after {
    bottom: 9px;
    width: 27px;
    height: 2px;
    background: #fff;
  }

  .bf__press-label {
    position: absolute;
    z-index: 3;
    bottom: 0;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(5, 7, 6, 0.64);
    font-size: 12px;
  }

  .bf__lower {
    display: grid;
    grid-template-columns: minmax(260px, 560px) auto;
    align-items: end;
    gap: 28px;
    width: min(960px, calc(100vw - 40px));
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.85);
  }

  .bf__ritual-copy > p:first-child {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.35;
  }

  .bf__strikes {
    display: flex;
    gap: 7px;
    min-height: 13px;
    margin: 10px 0;
  }

  .bf__strikes i {
    display: block;
    width: 28px;
    height: 5px;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.28);
  }

  .bf__strikes i.is-sounded {
    border-color: var(--bf-bloom);
    background: var(--bf-accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--bf-accent) 62%, transparent);
  }

  .bf__status {
    min-height: 16px;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .bf__navigation {
    display: flex;
    gap: 8px;
  }

  .bf__navigation button {
    min-width: 104px;
    padding: 0 16px;
  }

  .bf__navigation button:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  .bf__navigation [data-next]:not(:disabled) {
    border-color: var(--bf-bloom);
    background: color-mix(in srgb, var(--bf-accent) 44%, rgba(6, 8, 7, 0.7));
  }

  .bf__credit {
    position: absolute;
    z-index: 7;
    left: max(14px, env(safe-area-inset-left));
    bottom: max(10px, env(safe-area-inset-bottom));
    display: flex;
    gap: 12px;
    color: rgba(255, 255, 255, 0.62);
  }

  .bf__credit a {
    color: inherit;
  }

  .bf__particle,
  .bf__flower {
    position: absolute;
    left: var(--x);
    top: var(--y);
    pointer-events: none;
  }

  .bf__particle {
    width: var(--size);
    height: calc(var(--size) * 1.55);
    border-radius: 100% 0 100% 0;
    background: var(--color);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color) 65%, transparent);
    animation: bf-petal var(--duration) cubic-bezier(0.15, 0.72, 0.25, 1) forwards;
  }

  .bf__flower {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 -11px 0 2px var(--color),
      0 11px 0 2px var(--color),
      -11px 0 0 2px var(--color),
      11px 0 0 2px var(--color);
    animation: bf-flower 1500ms ease-out forwards;
  }

  .bf__dialog {
    width: min(760px, calc(100vw - 32px));
    max-height: min(84svh, 820px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    padding: 0;
    overflow: auto;
    background: #101411;
    color: #f7fbf5;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.7);
  }

  .bf__dialog::backdrop {
    background: rgba(3, 5, 4, 0.78);
    backdrop-filter: blur(8px);
  }

  .bf__dialog-head {
    position: sticky;
    z-index: 2;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background: #101411;
  }

  .bf__dialog-head p,
  .bf__dialog-head h2 {
    margin: 0;
  }

  .bf__dialog-head p {
    margin-bottom: 4px;
    color: var(--bf-bloom);
  }

  .bf__dialog-head h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .bf__dialog-head button {
    min-width: 70px;
    padding: 0 12px;
  }

  .bf__dialog-note {
    margin: 0;
    padding: 18px 20px;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.5;
  }

  .bf__prompt-list {
    margin: 0;
    padding: 0 20px 24px;
    list-style: none;
  }

  .bf__prompt-list li {
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .bf__prompt-list li > div {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .bf__prompt-list strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    font-weight: 500;
  }

  .bf__prompt-list p {
    margin: 10px 0 14px;
    color: rgba(255, 255, 255, 0.72);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 12px;
    line-height: 1.55;
  }

  .bf__prompt-list button,
  .bf__receipt-actions button,
  .bf__receipt-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
  }

  .bf__dialog--receipt pre {
    max-height: 300px;
    margin: 0 20px;
    padding: 16px;
    overflow: auto;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    background: #080a08;
    color: #dcead8;
    font-size: 11px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .bf__receipt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 18px 20px 24px;
  }

  .bf__announcer {
    position: fixed;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes bf-breathe {
    from { transform: scale(1.015); }
    to { transform: scale(1.045); }
  }

  @keyframes bf-halo {
    0%, 100% { transform: scale(0.98); opacity: 0.72; }
    50% { transform: scale(1.025); opacity: 1; }
  }

  @keyframes bf-wash {
    0% { opacity: 0; }
    18% { opacity: 0.34; }
    100% { opacity: 0; }
  }

  @keyframes bf-noun-ring {
    0% { transform: translateY(0) scale(1); }
    25% { transform: translateY(-7px) scale(1.035) rotate(-1deg); }
    58% { transform: translateY(1px) scale(0.995) rotate(0.8deg); }
    100% { transform: translateY(0) scale(1) rotate(0); }
  }

  @keyframes bf-petal {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--rotation)) scale(0.4);
    }
    18% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) rotate(calc(var(--rotation) + 150deg)) scale(1.05);
    }
  }

  @keyframes bf-flower {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0); }
    28% { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5) rotate(55deg); }
  }

  @media (max-width: 820px) {
    .bf {
      min-height: 620px;
    }

    .bf__topbar {
      grid-template-columns: 54px 1fr;
      min-height: 106px;
      gap: 8px;
      padding-bottom: 9px;
    }

    .bf__identity {
      justify-self: end;
    }

    .bf__controls {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      width: 100%;
    }

    .bf__controls button {
      min-width: 0;
      min-height: 44px;
      padding: 0 6px;
      font-size: 12px;
    }

    .bf__field {
      inset: 106px 0 0;
      grid-template-rows: auto minmax(0, 1fr) auto;
      padding-top: 14px;
      padding-bottom: max(56px, env(safe-area-inset-bottom));
    }

    .bf__stage-copy h1 {
      font-size: 30px;
    }

    .bf__stage-copy > p:last-child {
      font-size: 15px;
    }

    .bf__ritual {
      width: min(58vmin, 370px);
      min-width: 210px;
    }

    .bf__lower {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 13px;
      width: min(560px, calc(100vw - 32px));
      text-align: center;
    }

    .bf__ritual-copy > p:first-child {
      font-size: 16px;
    }

    .bf__strikes,
    .bf__navigation {
      justify-content: center;
    }

    .bf__credit {
      right: max(12px, env(safe-area-inset-right));
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .bf__identity strong {
      font-size: 18px;
    }

    .bf__field {
      padding-left: 12px;
      padding-right: 12px;
    }

    .bf__visit {
      margin-bottom: 5px;
    }

    .bf__stage-copy h1 {
      font-size: 26px;
    }

    .bf__stage-copy > p:last-child {
      margin-top: 5px;
      font-size: 14px;
    }

    .bf__ritual {
      width: min(64vmin, 300px);
      min-width: 190px;
    }

    .bf__strike-mark {
      width: 44px;
      height: 44px;
    }

    .bf__press-label {
      font-size: 11px;
    }

    .bf__navigation {
      width: 100%;
    }

    .bf__navigation button {
      flex: 1;
      min-width: 0;
    }

    .bf__dialog-head {
      padding: 14px;
    }

    .bf__dialog-head h2 {
      font-size: 21px;
    }

    .bf__dialog-note,
    .bf__prompt-list,
    .bf__receipt-actions {
      padding-left: 14px;
      padding-right: 14px;
    }

    .bf__dialog--receipt pre {
      margin: 0 14px;
    }
  }

  @media (max-height: 700px) and (min-width: 821px) {
    .bf__field {
      padding-top: 12px;
      padding-bottom: 34px;
    }

    .bf__stage-copy h1 {
      font-size: 30px;
    }

    .bf__ritual {
      width: min(38vmin, 320px);
      min-width: 210px;
    }

    .bf__lower {
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bf__backdrop,
    .bf__noun-halo,
    .bf__ritual.is-ringing .bf__noun,
    .bf.is-blooming .bf__wash,
    .bf__particle,
    .bf__flower {
      animation: none !important;
      transition: none !important;
    }
  }

  .bf[data-motion="reduced"] .bf__backdrop,
  .bf[data-motion="reduced"] .bf__noun-halo,
  .bf[data-motion="reduced"] .bf__ritual.is-ringing .bf__noun,
  .bf[data-motion="reduced"].is-blooming .bf__wash,
  .bf[data-motion="reduced"] .bf__particle,
  .bf[data-motion="reduced"] .bf__flower {
    animation: none !important;
    transition: none !important;
  }
</style>

<script>
  import { createBellflowerAudio } from '../lib/bellflower-audio';

  type Stage = {
    id: string;
    number: number;
    title: string;
    whisper: string;
    ritual: string;
    completion: string;
    background: string;
    backgroundAlt: string;
    nounId: number;
    accent: string;
    bloom: string;
    shadow: string;
    strikesRequired: number;
    sound: {
      id: string;
      label: string;
      baseHz: number;
      partials: number[];
      sequence: number[];
      decay: number;
      attack: number;
      brightness: number;
      noise: number;
      wet: number;
    };
    midjourney: string;
  };

  type ProgressState = {
    version: 1;
    current: number;
    startedAt: string;
    updatedAt: string;
    counts: Record<string, number>;
    completed: Record<string, string>;
  };

  type RuntimeData = {
    storageKey: string;
    receiptKey: string;
    receiptSchema: string;
    meta: {
      version: number;
      title: string;
      route: string;
      jsonRoute: string;
      credit: string;
    };
  };

  const root = document.querySelector<HTMLElement>('[data-bellflower]');
  const stagesNode = document.querySelector<HTMLScriptElement>('#bellflower-stages');
  const runtimeNode = document.querySelector<HTMLScriptElement>('#bellflower-runtime');

  if (root && stagesNode && runtimeNode) {
    const stages = JSON.parse(stagesNode.textContent || '[]') as Stage[];
    const runtime = JSON.parse(runtimeNode.textContent || '{}') as RuntimeData;
    const audio = createBellflowerAudio();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const forcedReducedMotion = new URLSearchParams(location.search).get('motion') === 'reduced';
    const clamp = (value: number, min = 0, max = 1) =>
      Math.min(max, Math.max(min, value));
    const isReducedMotion = () => forcedReducedMotion || reducedMotion.matches;

    const stageCounter = root.querySelector<HTMLElement>('[data-stage-counter]');
    const visitLabel = root.querySelector<HTMLElement>('[data-visit-label]');
    const title = root.querySelector<HTMLElement>('[data-title]');
    const whisper = root.querySelector<HTMLElement>('[data-whisper]');
    const ritual = root.querySelector<HTMLButtonElement>('[data-ritual]');
    const noun = root.querySelector<HTMLImageElement>('[data-noun]');
    const ritualCopy = root.querySelector<HTMLElement>('[data-ritual-copy]');
    const strikeDots = root.querySelector<HTMLElement>('[data-strike-dots]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const announcer = root.querySelector<HTMLElement>('[data-announcer]');
    const bloomLayer = root.querySelector<HTMLElement>('[data-bloom-layer]');
    const field = root.querySelector<HTMLElement>('[data-field]');
    const soundButton = root.querySelector<HTMLButtonElement>('[data-sound]');
    const replayButton = root.querySelector<HTMLButtonElement>('[data-replay]');
    const backButton = root.querySelector<HTMLButtonElement>('[data-back]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-next]');
    const restartButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-restart], [data-restart-receipt]'));
    const artDialog = root.querySelector<HTMLDialogElement>('[data-art-dialog]');
    const receiptDialog = root.querySelector<HTMLDialogElement>('[data-receipt-dialog]');
    const receiptJson = root.querySelector<HTMLElement>('[data-receipt-json]');
    const copyReceiptButton = root.querySelector<HTMLButtonElement>('[data-copy-receipt]');

    let muted = false;
    let bloomSerial = 0;
    let receiptTimer = 0;
    let state = readState();

    function defaultState(): ProgressState {
      const now = new Date().toISOString();
      return {
        version: 1,
        current: 0,
        startedAt: now,
        updatedAt: now,
        counts: {},
        completed: {},
      };
    }

    function readState(): ProgressState {
      try {
        const parsed = JSON.parse(localStorage.getItem(runtime.storageKey) || 'null');
        if (!parsed || parsed.version !== 1) return defaultState();
        return {
          version: 1,
          current: Number.isFinite(parsed.current) ? parsed.current : 0,
          startedAt: parsed.startedAt || new Date().toISOString(),
          updatedAt: parsed.updatedAt || new Date().toISOString(),
          counts: parsed.counts || {},
          completed: parsed.completed || {},
        };
      } catch {
        return defaultState();
      }
    }

    function writeState() {
      state.updatedAt = new Date().toISOString();
      try {
        localStorage.setItem(runtime.storageKey, JSON.stringify(state));
      } catch {}
    }

    function clampIndex(index: number) {
      return Math.max(0, Math.min(stages.length - 1, index));
    }

    function announce(message: string) {
      if (!announcer) return;
      announcer.textContent = '';
      window.setTimeout(() => {
        announcer.textContent = message;
      }, 20);
    }

    function copyText(text: string) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    function renderDots(stage: Stage, count: number) {
      if (!strikeDots) return;
      strikeDots.innerHTML = '';
      for (let index = 0; index < stage.strikesRequired; index += 1) {
        const dot = document.createElement('i');
        dot.classList.toggle('is-sounded', index < count);
        strikeDots.appendChild(dot);
      }
      strikeDots.setAttribute(
        'aria-label',
        `${Math.min(count, stage.strikesRequired)} of ${stage.strikesRequired} sounds complete`,
      );
    }

    function renderProgress(stage: Stage) {
      const count = Math.min(state.counts[stage.id] || 0, stage.strikesRequired);
      const complete = Boolean(state.completed[stage.id]) || count >= stage.strikesRequired;
      renderDots(stage, count);
      if (status) {
        status.textContent = complete
          ? stage.completion
          : count === 0
            ? 'Sound begins with your first gesture.'
            : `${stage.strikesRequired - count} ${stage.strikesRequired - count === 1 ? 'sound' : 'sounds'} until the next visit.`;
      }
      if (backButton) backButton.disabled = state.current === 0;
      if (nextButton) {
        nextButton.disabled = !complete;
        nextButton.textContent = state.current === stages.length - 1 ? 'Open receipt' : 'Continue';
      }
      root.dataset.complete = String(complete);
    }

    function paint(index: number, shouldFocus = false) {
      window.clearTimeout(receiptTimer);
      state.current = clampIndex(index);
      const stage = stages[state.current];
      root.dataset.stage = stage.id;
      root.dataset.stageIndex = String(state.current);
      root.style.setProperty('--bf-bg', `url('${stage.background}')`);
      root.style.setProperty('--bf-accent', stage.accent);
      root.style.setProperty('--bf-bloom', stage.bloom);
      root.style.setProperty('--bf-shadow', stage.shadow);

      if (stageCounter) stageCounter.textContent = `${String(stage.number).padStart(2, '0')} / ${String(stages.length).padStart(2, '0')}`;
      if (visitLabel) visitLabel.textContent = `Visit ${String(stage.number).padStart(2, '0')} · ${stage.sound.label}`;
      if (title) title.textContent = stage.title;
      if (whisper) whisper.textContent = stage.whisper;
      if (ritualCopy) ritualCopy.textContent = stage.ritual;
      if (ritual) ritual.setAttribute('aria-label', `Ring ${stage.sound.label}. ${stage.ritual}`);
      if (noun) {
        root.dataset.nounImage = 'loading';
        noun.src = `https://noun.pics/${stage.nounId}.svg`;
        noun.alt = `Noun ${stage.nounId}, the listening companion for ${stage.title}`;
      }

      renderProgress(stage);
      writeState();
      history.replaceState(null, '', `#${stage.id}`);
      const nextStage = stages[state.current + 1];
      if (nextStage) {
        const preload = new Image();
        preload.src = nextStage.background;
      }
      if (shouldFocus) field?.focus({ preventScroll: true });
    }

    function makeFlower(x: number, y: number, color: string, delay: number) {
      if (!bloomLayer) return;
      const flower = document.createElement('span');
      flower.className = 'bf__flower';
      flower.style.setProperty('--x', `${x * 100}%`);
      flower.style.setProperty('--y', `${y * 100}%`);
      flower.style.setProperty('--color', color);
      flower.style.animationDelay = `${delay}ms`;
      bloomLayer.appendChild(flower);
      window.setTimeout(() => flower.remove(), 1900 + delay);
    }

    function bloom(x: number, y: number, stage: Stage) {
      bloomSerial += 1;
      root.classList.remove('is-blooming');
      void root.offsetWidth;
      root.classList.add('is-blooming');
      window.setTimeout(() => root.classList.remove('is-blooming'), 950);

      if (isReducedMotion() || !bloomLayer) {
        makeFlower(x, y, stage.bloom, 0);
        return;
      }

      const count = 18;
      for (let index = 0; index < count; index += 1) {
        const particle = document.createElement('span');
        const angle = (Math.PI * 2 * index) / count + bloomSerial * 0.31;
        const distance = 70 + ((index * 37 + bloomSerial * 17) % 150);
        const color = index % 3 === 0 ? '#ffffff' : index % 2 === 0 ? stage.bloom : stage.accent;
        particle.className = 'bf__particle';
        particle.style.setProperty('--x', `${x * 100}%`);
        particle.style.setProperty('--y', `${y * 100}%`);
        particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
        particle.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
        particle.style.setProperty('--size', `${7 + ((index * 5) % 10)}px`);
        particle.style.setProperty('--rotation', `${Math.round((angle * 180) / Math.PI)}deg`);
        particle.style.setProperty('--duration', `${1050 + ((index * 79) % 700)}ms`);
        particle.style.setProperty('--color', color);
        bloomLayer.appendChild(particle);
        window.setTimeout(() => particle.remove(), 1900);
      }
      makeFlower(clamp(x - 0.12), clamp(y + 0.04), stage.bloom, 180);
      makeFlower(clamp(x + 0.14), clamp(y - 0.07), stage.accent, 300);
      makeFlower(clamp(x + 0.02), clamp(y + 0.13), '#ffffff', 420);
    }

    async function soundStage(stage: Stage, x: number, y: number, replay = false) {
      const playCount = Number(root.dataset.playCount || '0') + 1;
      root.dataset.playCount = String(playCount);
      if (replay) {
        root.dataset.replayCount = String(Number(root.dataset.replayCount || '0') + 1);
      }
      const result = await audio.play(stage.sound, {
        x,
        y,
        variation: (state.counts[stage.id] || 0) + bloomSerial * 0.1,
      });
      root.dataset.audioState = result.state;
      if (!result.supported && status) {
        status.textContent = 'Visual mode · Web Audio is unavailable here.';
      }
    }

    async function ring(x: number, y: number) {
      const stage = stages[state.current];
      if (!stage) return;
      const existing = state.counts[stage.id] || 0;
      const count = Math.min(stage.strikesRequired, existing + 1);
      state.counts[stage.id] = count;
      if (count >= stage.strikesRequired && !state.completed[stage.id]) {
        state.completed[stage.id] = new Date().toISOString();
      }
      bloom(x, y, stage);
      if (ritual) {
        ritual.classList.remove('is-ringing');
        void ritual.offsetWidth;
        ritual.classList.add('is-ringing');
        window.setTimeout(() => ritual.classList.remove('is-ringing'), 680);
      }
      await soundStage(stage, x, y);
      renderProgress(stage);
      writeState();
      announce(
        count >= stage.strikesRequired
          ? `${stage.completion} Continue is ready.`
          : `${stage.sound.label}. ${stage.strikesRequired - count} remaining.`,
      );

      if (stage.number === stages.length && count >= stage.strikesRequired) {
        const receipt = ensureReceipt();
        showReceipt(receipt, 1250);
      }
    }

    function createReceipt() {
      const completedAt = new Date().toISOString();
      return {
        schema: runtime.receiptSchema,
        version: runtime.meta.version,
        receiptId:
          globalThis.crypto?.randomUUID?.() ||
          `bellflower-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`,
        experience: runtime.meta.title,
        route: `https://pointcast.xyz${runtime.meta.route}`,
        creditedTo: 'Michael Hoydich',
        startedAt: state.startedAt,
        completedAt,
        stagesCompleted: stages.length,
        stageIds: stages.map((stage) => stage.id),
        nounIds: stages.map((stage) => stage.nounId),
        soundSource: 'Original browser-native Web Audio synthesis; no sampled recordings.',
        storage: 'Local browser only',
      };
    }

    function ensureReceipt() {
      try {
        const existing = JSON.parse(localStorage.getItem(runtime.receiptKey) || 'null');
        if (existing?.schema === runtime.receiptSchema) return existing;
      } catch {}
      const receipt = createReceipt();
      try {
        localStorage.setItem(runtime.receiptKey, JSON.stringify(receipt));
      } catch {}
      return receipt;
    }

    function showReceipt(receipt = ensureReceipt(), delay = 0) {
      window.clearTimeout(receiptTimer);
      receiptTimer = window.setTimeout(() => {
        if (receiptJson) receiptJson.textContent = JSON.stringify(receipt, null, 2);
        if (receiptDialog && !receiptDialog.open) receiptDialog.showModal();
      }, delay);
    }

    function restart() {
      window.clearTimeout(receiptTimer);
      audio.quiet();
      try {
        localStorage.removeItem(runtime.storageKey);
        localStorage.removeItem(runtime.receiptKey);
      } catch {}
      state = defaultState();
      receiptDialog?.close();
      paint(0, true);
      announce('Bellflower restarted at Hush Gate.');
    }

    field?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-ui]')) return;
      ring(
        clamp(event.clientX / Math.max(1, window.innerWidth)),
        clamp(event.clientY / Math.max(1, window.innerHeight)),
      );
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== ' ' && event.key !== 'Enter') return;
      const target = event.target as HTMLElement;
      if (target.closest('a, button, input, textarea, select, summary, dialog')) return;
      event.preventDefault();
      ring(0.5, 0.5);
    });

    soundButton?.addEventListener('click', async () => {
      muted = !muted;
      await audio.setMuted(muted);
      root.dataset.muted = String(muted);
      root.dataset.audioState = muted ? 'muted' : audio.getState();
      soundButton.setAttribute('aria-pressed', String(!muted));
      soundButton.textContent = muted ? 'Sound muted' : 'Sound on';
      announce(muted ? 'Sound muted.' : 'Sound on.');
    });

    replayButton?.addEventListener('click', async () => {
      const stage = stages[state.current];
      bloom(0.5, 0.5, stage);
      await soundStage(stage, 0.5, 0.5, true);
      announce(`${stage.sound.label} replayed.`);
    });

    backButton?.addEventListener('click', () => paint(state.current - 1, true));
    nextButton?.addEventListener('click', () => {
      if (state.current === stages.length - 1) {
        showReceipt();
        return;
      }
      paint(state.current + 1, true);
    });
    restartButtons.forEach((button) => button.addEventListener('click', restart));

    root.querySelector<HTMLButtonElement>('[data-art-queue]')?.addEventListener('click', () => artDialog?.showModal());
    root.querySelector<HTMLButtonElement>('[data-close-art]')?.addEventListener('click', () => artDialog?.close());
    root.querySelector<HTMLButtonElement>('[data-close-receipt]')?.addEventListener('click', () => receiptDialog?.close());

    root.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
      button.addEventListener('click', async () => {
        const index = Number(button.dataset.copyPrompt);
        await copyText(stages[index]?.midjourney || '');
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = 'Copy prompt';
        }, 1200);
      });
    });

    copyReceiptButton?.addEventListener('click', async () => {
      await copyText(receiptJson?.textContent || JSON.stringify(ensureReceipt(), null, 2));
      copyReceiptButton.textContent = 'Copied';
      window.setTimeout(() => {
        copyReceiptButton.textContent = 'Copy receipt JSON';
      }, 1200);
    });

    noun?.addEventListener('load', () => {
      root.dataset.nounImage = 'loaded';
    });
    noun?.addEventListener('error', () => {
      root.dataset.nounImage = 'error';
      if (status) status.textContent = 'The Noun portrait is resting; the instrument still works.';
    });

    reducedMotion.addEventListener('change', () => {
      root.dataset.motion = isReducedMotion() ? 'reduced' : 'full';
    });
    root.dataset.motion = isReducedMotion() ? 'reduced' : 'full';

    const hashIndex = stages.findIndex((stage) => `#${stage.id}` === location.hash);
    paint(hashIndex >= 0 ? hashIndex : clampIndex(state.current));
    window.addEventListener('pagehide', () => audio.quiet(), { once: true });
  }
</script>
