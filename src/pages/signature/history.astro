---
/**
 * /signature/history — an editorial history of signatures.
 * Every claim in the paragraphs is tied to a source in signature-history.ts.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/signature.css';
import { HISTORY } from '../../data/signature-history';
import { HISTORY_PATH, HONESTY, NOT_LEGAL, PATH } from '../../data/signature-studio';

const title = 'A history of signatures: seals, marks, statutes, and keys';
const description = `${NOT_LEGAL} Seals, marks, John Hancock, notarization, ESIGN and UETA, public-key signatures, and wallet signatures, with the sources.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: 'https://pointcast.xyz' + HISTORY_PATH + '/',
  datePublished: '2026-10-20',
  dateModified: '2026-10-20',
  author: { '@type': 'Organization', name: 'PointCast' },
  isPartOf: { '@type': 'WebApplication', name: 'Signature Studio', url: 'https://pointcast.xyz' + PATH + '/' },
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/signature/history.json', title: 'Signature history JSON' }]}
>
  <article class="sig sig-history">
    <p class="sig-kicker">Signature Studio · history · {HONESTY}</p>
    <h1>A history of signatures</h1>
    <p class="sig-dek">Seals, marks, a parchment, a notary, two statutes, and a key. The sentences below stay inside what the linked sources say.</p>
    <p class="sig-banner" role="note">{NOT_LEGAL} The studio can hash a picture, check an ed25519 signature, and ask one devnet to seal a post. It does not identify a person, keep a legal record, or perform a notarial act.</p>
    <p><a href={PATH}>Back to Signature Studio</a></p>
    <ul class="sig-jump">
      {HISTORY.map((section) => (
        <li><a href={'#' + section.id}>{section.title}</a></li>
      ))}
    </ul>
    {HISTORY.map((section) => (
      <section class="sig-section" id={section.id} aria-labelledby={section.id + '-title'}>
        <p class="sig-kicker">{section.kicker}</p>
        <h2 id={section.id + '-title'}>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <h3>Sources</h3>
        <ul class="sig-sources">
          {section.sources.map((source) => (
            <li>
              <a href={source.href}>{source.label}</a>
              {source.note ? <span> — {source.note}</span> : null}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</BlockLayout>
