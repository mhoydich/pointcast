---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Rivers — four polyrhythmic loops phasing in and out" description="Four loops at different tempos and different lengths, all playing simultaneously. They line up at the start, then drift, then meet again hours later. Steve Reich did this on tape in 1968. Web Audio does it in your tab in 2026.">
  <main class="cr" id="cr" data-built={built}>
    <header class="cr__hero">
      <p class="cr__kicker">CAST · RIVERS · polyrhythm · phasing · four loops</p>
      <h1 class="cr__title">Rivers.</h1>
      <p class="cr__sub">Four loops at different tempos and different lengths, playing at the same time. They line up at the start, then drift apart, then eventually meet again. Steve Reich did this with tape in 1968. Web Audio does it in your tab now.</p>
    </header>

    <section class="cr__panel">
      <div class="cr__set">
        <p class="cr__set-label">KEY</p>
        <div class="cr__pills" id="cr-key-pills">
          <button class="cr__pill cr__pill--active" data-key="Am">A minor</button>
          <button class="cr__pill" data-key="C">C major</button>
          <button class="cr__pill" data-key="Dm">D minor</button>
          <button class="cr__pill" data-key="Em">E minor</button>
          <button class="cr__pill" data-key="Cpent">C pent</button>
        </div>
      </div>
      <div class="cr__set">
        <p class="cr__set-label">MASTER TEMPO · <span id="cr-tempo-val">90</span> BPM scale</p>
        <input type="range" class="cr__tempo" id="cr-tempo" min="50" max="150" value="90"/>
      </div>
    </section>

    <section class="cr__viz">
      <canvas class="cr__canvas" id="cr-canvas" width="700" height="700"></canvas>
      <div class="cr__voices" id="cr-voices"></div>
    </section>

    <section class="cr__transport">
      <button class="cr__play" id="cr-play" type="button">
        <span class="cr__play-icon" id="cr-play-icon">▶</span>
        <span class="cr__play-label" id="cr-play-label">FLOW</span>
      </button>
      <button class="cr__reset" id="cr-reset" type="button">SYNC</button>
      <span class="cr__hint" id="cr-hint">All four rivers start together. Press FLOW. They drift. They meet again at the master cycle marker.</span>
    </section>

    <section class="cr__about">
      <h2 class="cr__about-h">How four rivers phase</h2>
      <p>Each river has its own tempo (in BPM) and its own loop length (in beats). At the start they all line up. Once the music starts, each river plays its loop independently. A 5-beat loop at 80 BPM repeats every 3.75 seconds. A 7-beat loop at 110 BPM repeats every 3.82 seconds. They drift slowly and only line up again at the master cycle — the least common multiple of all four loop durations.</p>
      <p>The default rivers were chosen so the master cycle is several minutes long: 4 beats @ 70, 5 beats @ 88, 7 beats @ 110, 6 beats @ 132. Listen for two or three minutes and you'll hear chords, near-misses, and unexpected unison hits as the streams cross.</p>
      <p>Each river is a 4-voice synth: detuned sine fundamentals with a fast attack and ~1.5s decay. River colors: flame, rose, sky, mint. Active beat lights as a glowing dot on the rotating ring.</p>
      <p>Mute a river by clicking its row. Unmute by clicking again. <strong>SYNC</strong> restarts all four rivers from beat zero so they line up again.</p>
      <p>Pair with <a href="/cast-metronome">/cast-metronome</a> for the polyrhythm pill, <a href="/cast-pulse">/cast-pulse</a> for single-tempo grooves, <a href="/cast-wander">/cast-wander</a> for non-tempo ambient.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cr-ink: #0a0612;
      --cr-walnut: #4a2a1a;
      --cr-flame: #f6c15e;
      --cr-flame-deep: #d68f2c;
      --cr-cream: #f4e7c8;
      --cr-cream-dim: #c8b48a;
      --cr-cream-dimmer: #8b7a5a;
      --cr-rose: #e6788c;
      --cr-sky: #9ed6f0;
      --cr-mint: #9bd7b8;
    }

    body:has(.cr) {
      background: radial-gradient(circle at 50% 0%, #1a0a28 0%, var(--cr-ink) 60%);
      color: var(--cr-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cr { max-width: 1080px; margin: 0 auto; padding: 48px 24px 80px; }

    .cr__hero { text-align: center; margin-bottom: 32px; }
    .cr__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cr-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cr__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 140px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cr-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.45);
    }
    .cr__sub {
      max-width: 720px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cr-cream-dim);
    }

    /* PANEL */
    .cr__panel {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 12px;
      margin-bottom: 22px;
    }
    @media (max-width: 700px) { .cr__panel { grid-template-columns: 1fr; } }
    .cr__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .cr__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--cr-cream-dimmer);
      margin: 0 0 8px;
    }
    .cr__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .cr__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cr-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cr__pill:hover { background: rgba(246,193,94,0.10); }
    .cr__pill--active {
      background: var(--cr-flame);
      color: var(--cr-walnut);
      border-color: var(--cr-flame);
    }
    .cr__tempo { width: 100%; accent-color: var(--cr-flame); }

    /* VIZ */
    .cr__viz {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 14px;
      margin-bottom: 22px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 20px;
      padding: 18px;
    }
    @media (max-width: 880px) {
      .cr__viz { grid-template-columns: 1fr; }
    }
    .cr__canvas {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      max-height: 70vh;
      background: rgba(0,0,0,0.3);
      border-radius: 14px;
      display: block;
    }
    .cr__voices {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .cr__voice {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 10px 12px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 10px;
      cursor: pointer;
      transition: background 80ms ease, border 80ms ease;
    }
    .cr__voice:hover { background: rgba(244,231,200,0.04); }
    .cr__voice--muted { opacity: 0.4; }
    .cr__voice-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .cr__voice-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .cr__voice-name {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      flex: 1;
    }
    .cr__voice-state {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.12em;
      color: var(--cr-cream-dimmer);
      text-transform: uppercase;
    }
    .cr__voice--muted .cr__voice-state { color: var(--cr-rose); }
    .cr__voice-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--cr-cream-dim);
    }

    /* TRANSPORT */
    .cr__transport {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 32px;
    }
    .cr__play {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 26px;
      border-radius: 12px;
      border: 0;
      background: var(--cr-flame);
      color: var(--cr-walnut);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      box-shadow: 0 4px 14px rgba(246,193,94,0.32);
    }
    .cr__play:hover { background: var(--cr-flame-deep); }
    .cr__reset {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--cr-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cr__reset:hover { background: rgba(246,193,94,0.12); }
    .cr__hint {
      flex: 1;
      min-width: 180px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cr-cream-dimmer);
    }

    /* ABOUT */
    .cr__about {
      max-width: 760px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cr__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cr-cream);
      margin: 0 0 12px;
    }
    .cr__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--cr-cream-dim);
      margin: 0 0 12px;
    }
    .cr__about strong { color: var(--cr-cream); }
    .cr__about a { color: var(--cr-flame); text-decoration: none; }
    .cr__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- music data ----
    const MAJOR = [0, 2, 4, 5, 7, 9, 11];
    const MINOR = [0, 2, 3, 5, 7, 8, 10];
    const PENT  = [0, 2, 4, 7, 9];
    type KeyKey = 'Am' | 'C' | 'Dm' | 'Em' | 'Cpent';
    const KEYS: Record<KeyKey, { rootMidi: number; scale: number[] }> = {
      'Am':    { rootMidi: 57, scale: MINOR },
      'C':     { rootMidi: 60, scale: MAJOR },
      'Dm':    { rootMidi: 62, scale: MINOR },
      'Em':    { rootMidi: 52, scale: MINOR },
      'Cpent': { rootMidi: 60, scale: PENT },
    };

    // Rivers: each has tempo (BPM at master=100), loop in scale-degree indices.
    // Loop lengths intentionally coprime (4,5,6,7) so phasing is rich.
    type River = {
      name: string;
      color: string;
      colorVar: string;
      bpmAt100: number;
      loopDegrees: number[];  // indices into a 2-octave version of the scale
      octaveOffset: number;   // shift entire river up/down octaves
    };
    const RIVERS: River[] = [
      { name: 'one',   color: '#f6c15e', colorVar: '--cr-flame', bpmAt100: 70,  loopDegrees: [0, 4, 7, 4],                       octaveOffset: 0  },
      { name: 'two',   color: '#e6788c', colorVar: '--cr-rose',  bpmAt100: 88,  loopDegrees: [7, 9, 11, 9, 7],                   octaveOffset: 1  },
      { name: 'three', color: '#9ed6f0', colorVar: '--cr-sky',   bpmAt100: 110, loopDegrees: [0, 3, 5, 7, 5, 3, 2],              octaveOffset: 0  },
      { name: 'four',  color: '#9bd7b8', colorVar: '--cr-mint',  bpmAt100: 132, loopDegrees: [0, 2, 4, 7, 9, 7],                  octaveOffset: -1 },
    ];

    // ---- state ----
    let currentKey: KeyKey = 'Am';
    let masterTempo = 90;  // 50-150
    let muted: boolean[] = [false, false, false, false];
    let playing = false;
    let startCtxTime = 0;
    let rafId: number | null = null;

    // Track which beat each river is on, what its next scheduled beat time is
    let nextBeatTime: number[] = [0, 0, 0, 0];
    let beatIdx: number[] = [0, 0, 0, 0];
    let scheduleTimer: number | null = null;

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.4;
      masterGain.connect(ctx.destination);
    }
    function midiToHz(m: number) { return 440 * Math.pow(2, (m - 69) / 12); }

    function riverBPM(riverIdx: number): number {
      const r = RIVERS[riverIdx];
      return r.bpmAt100 * (masterTempo / 100);
    }
    function riverBeatSec(riverIdx: number): number {
      return 60 / riverBPM(riverIdx);
    }

    function riverNoteMidi(riverIdx: number, deg: number): number {
      const r = RIVERS[riverIdx];
      const k = KEYS[currentKey];
      // Use 2-octave scale; allow degrees to wrap
      const totalDegrees = k.scale.length * 2;
      const idx = ((deg % totalDegrees) + totalDegrees) % totalDegrees;
      const oct = Math.floor(idx / k.scale.length);
      const inOct = idx % k.scale.length;
      return k.rootMidi + (oct + r.octaveOffset) * 12 + k.scale[inOct];
    }

    function playNote(riverIdx: number, midi: number, atCtxTime: number) {
      if (!ctx || !scheduler || !masterGain) return;
      const hz = midiToHz(midi);
      const r = RIVERS[riverIdx];
      // Detuned sines for a soft tone, slightly different timbre per river
      const detune = riverIdx % 2 === 0 ? 5 : -5;
      const stacks = [
        { freq: hz,     gain: 0.18, decay: 1.4 },
        { freq: hz,     gain: 0.12, detune, decay: 1.4 },
        { freq: hz * 2, gain: 0.04, decay: 0.6 },
      ];
      for (const v of stacks) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = v.freq;
        if ((v as any).detune) osc.detune.value = (v as any).detune;
        g.gain.setValueAtTime(0.0001, atCtxTime);
        g.gain.exponentialRampToValueAtTime(v.gain, atCtxTime + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, atCtxTime + v.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(atCtxTime);
        osc.stop(atCtxTime + v.decay + 0.1);
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.25;
      for (let i = 0; i < RIVERS.length; i++) {
        while (nextBeatTime[i] < horizon) {
          if (!muted[i]) {
            const r = RIVERS[i];
            const deg = r.loopDegrees[beatIdx[i] % r.loopDegrees.length];
            const midi = riverNoteMidi(i, deg);
            playNote(i, midi, nextBeatTime[i]);
          }
          beatIdx[i]++;
          nextBeatTime[i] += riverBeatSec(i);
        }
      }
      scheduleTimer = window.setTimeout(scheduleAhead, 50);
    }

    function startFlow() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      startCtxTime = ctx.currentTime + 0.1;
      for (let i = 0; i < RIVERS.length; i++) {
        nextBeatTime[i] = startCtxTime;
        beatIdx[i] = 0;
      }
      document.getElementById('cr-play-icon')!.textContent = '■';
      document.getElementById('cr-play-label')!.textContent = 'STOP';
      scheduleAhead();
      tickViz();
    }

    function stopFlow() {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (rafId != null) { cancelAnimationFrame(rafId); rafId = null; }
      if (scheduler) scheduler.stopAll();
      document.getElementById('cr-play-icon')!.textContent = '▶';
      document.getElementById('cr-play-label')!.textContent = 'FLOW';
      drawViz();
    }

    function syncFlow() {
      if (!playing) return;
      // Restart all rivers from beat 0 now
      ensureCtx();
      if (!ctx) return;
      if (scheduler) scheduler.stopAll();
      startCtxTime = ctx.currentTime + 0.05;
      for (let i = 0; i < RIVERS.length; i++) {
        nextBeatTime[i] = startCtxTime;
        beatIdx[i] = 0;
      }
    }

    // ---- visualization ----
    function drawViz() {
      const canvas = document.getElementById('cr-canvas') as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      const W = canvas.width, H = canvas.height;
      const cx = W / 2, cy = H / 2;
      c2.clearRect(0, 0, W, H);
      // Background star/glow
      const grad = c2.createRadialGradient(cx, cy, 0, cx, cy, Math.max(W, H) / 2);
      grad.addColorStop(0, 'rgba(246,193,94,0.06)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      c2.fillStyle = grad;
      c2.fillRect(0, 0, W, H);

      // Each river is a concentric ring
      const maxR = Math.min(W, H) * 0.42;
      const minR = maxR * 0.32;
      for (let i = 0; i < RIVERS.length; i++) {
        const r = RIVERS[i];
        const radius = minR + ((maxR - minR) * i / (RIVERS.length - 1));
        // ring
        c2.strokeStyle = `${r.color}40`;
        c2.lineWidth = 1.5;
        c2.beginPath();
        c2.arc(cx, cy, radius, 0, Math.PI * 2);
        c2.stroke();
        // pegs (one per loop note)
        for (let k = 0; k < r.loopDegrees.length; k++) {
          const angle = (k / r.loopDegrees.length) * Math.PI * 2 - Math.PI / 2;
          const px = cx + radius * Math.cos(angle);
          const py = cy + radius * Math.sin(angle);
          c2.fillStyle = `${r.color}80`;
          c2.beginPath();
          c2.arc(px, py, 4, 0, Math.PI * 2);
          c2.fill();
        }
        // current playhead position
        if (playing && ctx) {
          const elapsed = ctx.currentTime - startCtxTime;
          const beatsPassed = elapsed / riverBeatSec(i);
          const loopPos = beatsPassed % r.loopDegrees.length;  // 0..len
          const angle = (loopPos / r.loopDegrees.length) * Math.PI * 2 - Math.PI / 2;
          const px = cx + radius * Math.cos(angle);
          const py = cy + radius * Math.sin(angle);
          // glow
          c2.fillStyle = muted[i] ? `${r.color}20` : r.color;
          c2.beginPath();
          c2.arc(px, py, 10, 0, Math.PI * 2);
          c2.fill();
          c2.shadowBlur = 18;
          c2.shadowColor = r.color;
          c2.fillStyle = muted[i] ? `${r.color}30` : r.color;
          c2.beginPath();
          c2.arc(px, py, 6, 0, Math.PI * 2);
          c2.fill();
          c2.shadowBlur = 0;
        }
        // label
        c2.fillStyle = muted[i] ? `${r.color}50` : r.color;
        c2.font = 'bold 11px JetBrains Mono, monospace';
        c2.fillText(r.name, cx + radius + 8, cy + 4);
      }

      // center bullseye
      c2.fillStyle = 'rgba(244,231,200,0.5)';
      c2.beginPath();
      c2.arc(cx, cy, 3, 0, Math.PI * 2);
      c2.fill();
    }
    function tickViz() {
      drawViz();
      if (playing) rafId = requestAnimationFrame(tickViz);
    }

    function renderVoices() {
      const wrap = document.getElementById('cr-voices')!;
      wrap.innerHTML = RIVERS.map((r, i) => `
        <div class="cr__voice${muted[i] ? ' cr__voice--muted' : ''}" data-i="${i}">
          <div class="cr__voice-row">
            <div class="cr__voice-dot" style="background:${r.color}"></div>
            <span class="cr__voice-name">River ${r.name}</span>
            <span class="cr__voice-state">${muted[i] ? 'MUTED' : 'ON'}</span>
          </div>
          <div class="cr__voice-meta">${Math.round(riverBPM(i))} BPM · ${r.loopDegrees.length}-beat loop</div>
        </div>
      `).join('');
    }

    function init() {
      renderVoices();
      drawViz();

      document.getElementById('cr-key-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-key]');
        if (!btn) return;
        currentKey = btn.getAttribute('data-key') as KeyKey;
        document.querySelectorAll('#cr-key-pills .cr__pill').forEach(el =>
          el.classList.toggle('cr__pill--active', el === btn));
      });

      const tempoSlider = document.getElementById('cr-tempo') as HTMLInputElement;
      tempoSlider.addEventListener('input', () => {
        masterTempo = parseInt(tempoSlider.value);
        document.getElementById('cr-tempo-val')!.textContent = String(masterTempo);
        renderVoices();
      });

      document.getElementById('cr-voices')!.addEventListener('click', e => {
        const row = (e.target as HTMLElement).closest('.cr__voice');
        if (!row) return;
        const i = parseInt(row.getAttribute('data-i')!);
        muted[i] = !muted[i];
        renderVoices();
      });

      document.getElementById('cr-play')!.addEventListener('click', () => {
        if (playing) stopFlow();
        else startFlow();
      });
      document.getElementById('cr-reset')!.addEventListener('click', () => {
        syncFlow();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) stopFlow();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
