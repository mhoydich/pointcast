---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CITATIONS, COASTAL_SITES, OCEAN_PRACTICES, PRINCIPLES, SMALL_INTERVENTIONS, TIDE_SURF_REALITIES, TRACK_META } from '../lib/oceanWing';
const title = `${TRACK_META.title} — ${TRACK_META.subtitle}`;
const description = TRACK_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Course', '@id': 'https://pointcast.xyz/ocean-wing', name: TRACK_META.title, description, url: 'https://pointcast.xyz/ocean-wing', provider: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/ocean-wing.json', title: 'Ocean Wing (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span><span>ocean-wing</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{TRACK_META.paperNumber} · WATER · 12 SITES · 4 PRACTICES</p>
      <h1>OCEAN / WING.</h1>
      <p class="subtitle">{TRACK_META.subtitle}</p>
      <p class="thesis">{TRACK_META.thesis}</p>
    </header>

    <section class="elements-frame">
      <p class="kicker">FOUR ELEMENTS · UES SENSORY FRAME</p>
      <h2>Where this track sits.</h2>
      <ol class="four">
        <li class="el el--earth"><span>EARTH</span><a href="/geology">/geology · Track 08</a></li>
        <li class="el el--water el--active"><span>WATER</span><strong>Ocean Wing · Track 09 · here</strong></li>
        <li class="el el--fire"><span>FIRE</span><a href="/fire">/fire · Track 11 · forthcoming</a></li>
        <li class="el el--air"><span>AIR</span><a href="/marine-layer">/marine-layer · Track 07</a></li>
      </ol>
    </section>

    <section><p class="kicker">PRINCIPLES</p><h2>Six rules before the first wade.</h2>
      <ol class="rules">{PRINCIPLES.map((p, i) => (<li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>))}</ol>
    </section>

    <section><p class="kicker">TIDE & SURF REALITIES</p><h2>Six things the ocean does whether you watch or not.</h2>
      <ol class="realities">{TIDE_SURF_REALITIES.map((r) => (<li><h3>{r.name}</h3><p>{r.detail}</p><p class="cohort"><strong>Cohort:</strong> {r.cohortNote}</p></li>))}</ol>
    </section>

    <section><p class="kicker">TWELVE COASTAL SITES</p><h2>The Pacific edge of the radius, named.</h2>
      <ol class="sites">{COASTAL_SITES.map((s) => (
        <li class={`site site--${s.kind}`}>
          <div class="site__head"><span class="site__kind">{s.kind.toUpperCase()}</span><span class="site__city">{s.city}</span></div>
          <h3>{s.name}</h3>
          <dl>
            <div><dt>Access</dt><dd>{s.access}</dd></div>
            <div><dt>Sand</dt><dd>{s.sand}</dd></div>
            <div><dt>Surf</dt><dd>{s.surf}</dd></div>
            <div><dt>Teaches</dt><dd>{s.whatItTeaches}</dd></div>
            {s.marineLayerLink && (<div><dt>Marine Layer</dt><dd><a href={s.marineLayerLink}>cross-linked</a></dd></div>)}
          </dl>
        </li>
      ))}</ol>
    </section>

    <section><p class="kicker">FOUR PRACTICES</p><h2>What the cohort does at the water.</h2>
      <ol class="practices">{OCEAN_PRACTICES.map((p) => (
        <li><div class="pr__head"><h3>{p.name}</h3><span class="pr__cad">{p.cadence}</span></div><p>{p.detail}</p><p class="pr__log"><strong>Logs to:</strong> {p.logsTo}</p></li>
      ))}</ol>
    </section>

    <section><p class="kicker">CIVIC INTERVENTIONS</p><h2>Three small architectural acts on the coastline.</h2>
      <ol class="interventions">{SMALL_INTERVENTIONS.map((i) => (
        <li><div class="iv__head"><span class="iv__cf">Common Forms {i.commonsCommission}</span><span class="iv__cost">{i.cost}</span></div><h3>{i.name}</h3><p>{i.detail}</p></li>
      ))}</ol>
    </section>

    <section><p class="kicker">CITATIONS</p><h2>Sources.</h2>
      <ol class="cites">{CITATIONS.map((c) => (<li><span class="cites__key">[{c.key}]</span><p>{c.source}</p></li>))}</ol>
    </section>

    <section class="links">
      <a href="/marine-layer">Marine Layer · air</a>
      <a href="/geology">Geology · earth</a>
      <a href="/fire">Fire · forthcoming</a>
      <a href="/commons">PointCast Commons</a>
      <a href="/common-forms">Common Forms · architecture</a>
      <a href="/university-of-el-segundo">UES tracks</a>
      <a href="/ocean-wing.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --ow-ink:#1a1a1a; --ow-paper:#f4ecd9; --ow-water:#2a5a8a; --ow-deep:#1a3a5a; --ow-foam:#d8e8ec; --ow-sand:#d8b48f; --ow-rust:#b85a3a; --ow-mustard:#d4a534; --ow-sage:#7a8c4f; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--ow-paper); color: var(--ow-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--ow-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--ow-deep); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ow-ink); margin: 0 0 10px; padding: 4px 8px; background: var(--ow-foam); display: inline-block; border: 1px solid var(--ow-water); }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 20px; font-weight: 500; margin: 0 0 14px; max-width: 50ch; }
  .thesis { font-size: 16px; line-height: 1.6; max-width: 70ch; margin: 0; }
  section { padding: 30px 28px; border-top: 4px solid var(--ow-deep); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .elements-frame { background: linear-gradient(180deg, var(--ow-foam), var(--ow-paper)); }
  .four { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .el { padding: 14px; border: 2px solid var(--ow-ink); background: #fff; }
  .el--active { background: var(--ow-water); color: var(--ow-foam); border-color: var(--ow-deep); }
  .el span { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; display: block; margin-bottom: 6px; }
  .el a, .el strong { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .04em; color: inherit; }
  .el--earth { background: var(--ow-sand); }
  .el--fire { background: #f7eedf; opacity: 0.7; }
  .el--air { background: #eef4fa; }

  .rules { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rules li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--ow-ink); align-items: baseline; }
  .rules span { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--ow-water); }
  .rules p { margin: 0; font-size: 15px; line-height: 1.5; }

  .realities { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .realities li { padding: 14px 16px; background: #fff; border: 2px solid var(--ow-ink); border-left: 8px solid var(--ow-water); }
  .realities h3 { font-family: var(--pc-font-mono); font-size: 14px; letter-spacing: .04em; margin: 0 0 6px; font-weight: 700; }
  .realities p { margin: 0 0 6px; font-size: 14px; line-height: 1.55; }
  .realities .cohort { font-size: 13px; color: #2a2a2a; }
  .realities strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; margin-right: 4px; }

  .sites { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .site { padding: 14px 16px; background: #fff; border: 2px solid var(--ow-ink); border-left: 8px solid var(--ow-water); }
  .site--pier { border-left-color: var(--ow-rust); }
  .site--overlook { border-left-color: var(--ow-sand); }
  .site--tide-pool { border-left-color: var(--ow-sage); }
  .site--preserve { border-left-color: var(--ow-sage); }
  .site--jetty { border-left-color: var(--ow-ink); }
  .site__head { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 4px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .site__kind { color: var(--ow-water); font-weight: 700; }
  .site__city { color: #5a5450; }
  .site h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 8px; font-weight: 700; }
  .site dl { margin: 0; display: grid; gap: 4px; }
  .site dl > div { display: grid; grid-template-columns: 70px 1fr; gap: 8px; padding: 3px 0; border-top: 1px solid #e8e0c8; font-size: 13px; }
  .site dl > div:first-child { border-top: 0; }
  .site dt { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--ow-water); padding-top: 2px; }
  .site dd { margin: 0; line-height: 1.45; color: #2a2a2a; }
  .site dd a { color: var(--ow-water); }

  .practices { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .practices li { padding: 14px 16px; background: #fff; border: 2px solid var(--ow-ink); border-left: 8px solid var(--ow-mustard); }
  .pr__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .pr__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; font-weight: 700; }
  .pr__cad { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ow-rust); padding: 2px 6px; background: var(--ow-paper); }
  .practices p { margin: 0 0 6px; font-size: 14px; line-height: 1.55; }
  .pr__log { font-size: 12px; color: #2a2a2a; }
  .pr__log strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; margin-right: 4px; }

  .interventions { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .interventions li { padding: 14px 16px; background: #fff; border: 2px solid var(--ow-ink); }
  .iv__head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .iv__cf { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; padding: 3px 7px; background: var(--ow-water); color: var(--ow-foam); }
  .iv__cost { font-family: var(--pc-font-mono); font-size: 13px; color: var(--ow-rust); font-weight: 700; }
  .interventions h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 6px; font-weight: 700; }
  .interventions p { margin: 0; font-size: 14px; line-height: 1.55; }

  .cites { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .cites li { display: grid; grid-template-columns: 200px 1fr; gap: 12px; padding: 8px 12px; background: #fff; border-left: 2px solid var(--ow-water); }
  .cites__key { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .04em; color: var(--ow-water); padding-top: 2px; }
  .cites p { margin: 0; font-size: 13px; line-height: 1.5; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--ow-deep); color: var(--ow-foam); text-decoration: none; }
  .links a:hover { background: var(--ow-water); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .four { grid-template-columns: 1fr 1fr; } .sites { grid-template-columns: 1fr; } .cites li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .four { grid-template-columns: 1fr; } }
</style>
