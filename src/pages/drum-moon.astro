---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Moon — bells in moonlight, ten minutes" description="A pavilion looking onto the same garden by moonlight. The kit is mostly bells and hi-hats, with the occasional far kick like thunder behind the hills. There is no daytime peak. The drama is in the silence between bells.">
  <main class="dm" id="dm" data-built={built}>
    <header class="dm__hero">
      <p class="dm__kicker">DRUM · MOON · bells in night · ten minutes</p>
      <h1 class="dm__title">The same garden, by moonlight.</h1>
      <p class="dm__sub">The pavilion looks onto the same garden as Drum Garden — only now it's late, the moon is up, and the kit has been replaced by bells. A small temple bell, a hand bell, a cluster of wind chimes. A kick somewhere far behind the hills, used like thunder. There is no peak. The drama is in the silence between bells.</p>
    </header>

    <section class="dm__stage" id="dm-stage" data-state="idle">
      <div class="dm__pavilion" aria-hidden="true">
        <div class="dm__rail dm__rail--top"></div>
        <div class="dm__rail dm__rail--bottom"></div>
        <div class="dm__post dm__post--left"></div>
        <div class="dm__post dm__post--right"></div>
        <svg class="dm__scene" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="dmSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0a1228"/>
              <stop offset="60%" stop-color="#162038"/>
              <stop offset="100%" stop-color="#1e2842"/>
            </linearGradient>
            <linearGradient id="dmSand" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#4d4d5a"/>
              <stop offset="100%" stop-color="#262838"/>
            </linearGradient>
            <radialGradient id="dmMoon" cx="50%" cy="50%" r="60%">
              <stop offset="0%" stop-color="#fff7d8"/>
              <stop offset="65%" stop-color="#e8d8a0"/>
              <stop offset="100%" stop-color="#a8946a"/>
            </radialGradient>
            <radialGradient id="dmMoonGlow" cx="50%" cy="50%" r="55%">
              <stop offset="0%" stop-color="rgba(255,247,216,0.5)"/>
              <stop offset="60%" stop-color="rgba(255,247,216,0.12)"/>
              <stop offset="100%" stop-color="rgba(255,247,216,0)"/>
            </radialGradient>
            <radialGradient id="dmRockBig" cx="40%" cy="35%" r="65%">
              <stop offset="0%" stop-color="#5e6068"/>
              <stop offset="60%" stop-color="#3e424a"/>
              <stop offset="100%" stop-color="#1e2028"/>
            </radialGradient>
            <radialGradient id="dmRockMid" cx="50%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#525660"/>
              <stop offset="100%" stop-color="#2a2e36"/>
            </radialGradient>
            <linearGradient id="dmBellMetal" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#d6c890"/>
              <stop offset="55%" stop-color="#a89460"/>
              <stop offset="100%" stop-color="#6a5a38"/>
            </linearGradient>
            <pattern id="dmSandRake" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
              <path d="M 0 11 Q 11 8 22 11" stroke="rgba(255,255,255,0.06)" stroke-width="0.8" fill="none"/>
            </pattern>
          </defs>

          <!-- Night sky -->
          <rect x="0" y="0" width="1200" height="320" fill="url(#dmSky)"/>
          <!-- Stars -->
          <g fill="rgba(255,255,255,0.7)">
            <circle cx="120" cy="80" r="1.2"/>
            <circle cx="260" cy="50" r="0.9"/>
            <circle cx="380" cy="110" r="1"/>
            <circle cx="430" cy="60" r="0.7"/>
            <circle cx="180" cy="160" r="0.8"/>
            <circle cx="600" cy="40" r="1.1"/>
            <circle cx="720" cy="90" r="0.9"/>
            <circle cx="880" cy="55" r="1.2"/>
            <circle cx="950" cy="140" r="0.7"/>
            <circle cx="1070" cy="80" r="0.9"/>
            <circle cx="1140" cy="180" r="0.8"/>
            <circle cx="510" cy="180" r="0.8"/>
            <circle cx="320" cy="220" r="0.6"/>
            <circle cx="780" cy="220" r="0.8"/>
          </g>
          <!-- Moon glow -->
          <circle cx="280" cy="160" r="170" fill="url(#dmMoonGlow)"/>
          <!-- Moon -->
          <circle cx="280" cy="160" r="56" fill="url(#dmMoon)"/>
          <!-- Moon craters (subtle) -->
          <circle cx="260" cy="150" r="6" fill="#bba670" opacity="0.5"/>
          <circle cx="295" cy="170" r="4" fill="#bba670" opacity="0.45"/>
          <circle cx="284" cy="142" r="3" fill="#bba670" opacity="0.4"/>

          <!-- Distant hill silhouette behind moon -->
          <path d="M 0 320 L 0 280 L 140 240 L 300 270 L 480 230 L 660 260 L 840 220 L 1020 250 L 1200 230 L 1200 320 Z" fill="#0e1426" opacity="0.85"/>

          <!-- Sand (moonlit) -->
          <rect x="0" y="300" width="1200" height="300" fill="url(#dmSand)"/>
          <rect x="0" y="300" width="1200" height="300" fill="url(#dmSandRake)" opacity="0.4"/>
          <g fill="none" stroke="rgba(255,255,255,0.10)" stroke-width="1.2">
            <ellipse cx="380" cy="420" rx="180" ry="50"/>
            <ellipse cx="380" cy="420" rx="230" ry="65"/>
            <ellipse cx="380" cy="420" rx="290" ry="82"/>
            <ellipse cx="380" cy="420" rx="360" ry="100"/>
          </g>
          <g fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.0">
            <ellipse cx="820" cy="430" rx="140" ry="42"/>
            <ellipse cx="820" cy="430" rx="190" ry="56"/>
            <ellipse cx="820" cy="430" rx="250" ry="72"/>
          </g>

          <!-- Big rock (darker) -->
          <g transform="translate(380, 380)">
            <path d="M -150 30 Q -160 -50 -110 -85 Q -50 -110 30 -100 Q 110 -90 145 -50 Q 165 0 140 38 Q 110 60 60 60 Q 0 65 -60 55 Q -130 50 -150 30 Z"
                  fill="url(#dmRockBig)" stroke="rgba(20,20,28,0.8)" stroke-width="1"/>
            <!-- Moon-highlight on top edge -->
            <path d="M -90 -56 Q -50 -82 0 -82 Q 50 -78 80 -60" fill="none" stroke="rgba(255,247,216,0.32)" stroke-width="2"/>
          </g>
          <!-- Small rock -->
          <g transform="translate(1010, 410)">
            <path d="M -55 18 Q -60 -22 -32 -38 Q 0 -50 35 -42 Q 60 -32 60 -8 Q 55 18 28 26 Q -10 32 -55 18 Z"
                  fill="url(#dmRockMid)" stroke="rgba(20,20,28,0.8)" stroke-width="0.6"/>
          </g>
          <!-- Mid rock -->
          <g transform="translate(620, 430)">
            <path d="M -38 12 Q -42 -18 -22 -28 Q 0 -36 24 -28 Q 42 -16 40 4 Q 32 22 8 24 Q -22 22 -38 12 Z"
                  fill="url(#dmRockMid)" stroke="rgba(20,20,28,0.8)" stroke-width="0.5"/>
          </g>

          <!-- Bonsai pine (silvered by moonlight) -->
          <g class="dm__bonsai">
            <path d="M 1085 295 Q 1080 250 1095 215 Q 1110 195 1115 170 Q 1112 150 1118 140"
                  fill="none" stroke="#2a1e16" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M 1100 240 Q 1115 230 1132 220"
                  fill="none" stroke="#2a1e16" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M 1108 195 Q 1095 188 1080 192"
                  fill="none" stroke="#2a1e16" stroke-width="2" stroke-linecap="round"/>
            <g class="dm__bonsai-needles">
              <ellipse cx="1090" cy="195" rx="42" ry="22" fill="#3a4a44" opacity="0.85"/>
              <ellipse cx="1090" cy="190" rx="36" ry="16" fill="#586d5c" opacity="0.6"/>
              <ellipse cx="1132" cy="218" rx="26" ry="14" fill="#3a4a44" opacity="0.85"/>
              <ellipse cx="1132" cy="213" rx="22" ry="9" fill="#586d5c" opacity="0.6"/>
              <ellipse cx="1118" cy="138" rx="34" ry="20" fill="#3a4a44" opacity="0.85"/>
              <ellipse cx="1118" cy="133" rx="28" ry="14" fill="#586d5c" opacity="0.6"/>
              <ellipse cx="1080" cy="245" rx="20" ry="11" fill="#3a4a44" opacity="0.85"/>
            </g>
          </g>

          <!-- Bell trio: temple bell (large center), hand bell (small left), wind-chime cluster (right) -->
          <!-- Temple bell on stand -->
          <g class="dm__drum dm__drum--temple" data-voice="temple">
            <line x1="820" y1="320" x2="820" y2="430" stroke="#2a1e16" stroke-width="2"/>
            <!-- Bell yoke -->
            <line x1="780" y1="320" x2="860" y2="320" stroke="#2a1e16" stroke-width="2.5"/>
            <line x1="780" y1="320" x2="780" y2="335" stroke="#2a1e16" stroke-width="2"/>
            <line x1="860" y1="320" x2="860" y2="335" stroke="#2a1e16" stroke-width="2"/>
            <!-- Bell body -->
            <path d="M 780 335 Q 770 380 820 415 Q 870 380 860 335 Z"
                  fill="url(#dmBellMetal)" stroke="#3a2a18" stroke-width="1"/>
            <ellipse cx="820" cy="412" rx="42" ry="6" fill="#5a4628" stroke="#3a2a18" stroke-width="0.8"/>
            <circle cx="820" cy="345" r="3" fill="#3a2a18"/>
            <!-- Pulse ring -->
            <ellipse class="dm__drum-ring" cx="820" cy="375" rx="62" ry="58" fill="none" stroke="#e8d8a0" stroke-width="2.5" opacity="0"/>
          </g>

          <!-- Hand bell (small, left side) -->
          <g class="dm__drum dm__drum--hand" data-voice="hand">
            <line x1="700" y1="420" x2="700" y2="470" stroke="#2a1e16" stroke-width="1.8"/>
            <path d="M 685 420 Q 680 396 700 388 Q 720 396 715 420 Z"
                  fill="url(#dmBellMetal)" stroke="#3a2a18" stroke-width="0.8"/>
            <ellipse cx="700" cy="418" rx="16" ry="3" fill="#5a4628" stroke="#3a2a18" stroke-width="0.5"/>
            <circle cx="700" cy="395" r="1.5" fill="#3a2a18"/>
            <ellipse class="dm__drum-ring" cx="700" cy="405" r="26" ry="22" fill="none" stroke="#e8d8a0" stroke-width="2" opacity="0"/>
          </g>

          <!-- Wind chimes (right side, hanging from a curved arm) -->
          <g class="dm__drum dm__drum--chime" data-voice="chime">
            <!-- Arm -->
            <path d="M 950 320 Q 970 340 970 380" fill="none" stroke="#2a1e16" stroke-width="2"/>
            <line x1="950" y1="320" x2="950" y2="345" stroke="#2a1e16" stroke-width="2"/>
            <!-- 4 tubes of varying lengths -->
            <line x1="955" y1="385" x2="955" y2="445" stroke="url(#dmBellMetal)" stroke-width="3"/>
            <line x1="966" y1="385" x2="966" y2="455" stroke="url(#dmBellMetal)" stroke-width="3"/>
            <line x1="977" y1="385" x2="977" y2="465" stroke="url(#dmBellMetal)" stroke-width="3"/>
            <line x1="988" y1="385" x2="988" y2="450" stroke="url(#dmBellMetal)" stroke-width="3"/>
            <!-- A small striker -->
            <circle cx="972" cy="478" r="2.5" fill="#3a2a18"/>
            <!-- Pulse ring -->
            <ellipse class="dm__drum-ring" cx="972" cy="425" rx="32" ry="50" fill="none" stroke="#e8d8a0" stroke-width="2" opacity="0"/>
          </g>

          <!-- Distant kick (just a soft cloud silhouette over the hills) -->
          <g class="dm__drum dm__drum--kick" data-voice="kick">
            <ellipse cx="900" cy="265" rx="68" ry="14" fill="rgba(20,28,52,0.6)"/>
            <ellipse cx="930" cy="258" rx="32" ry="8" fill="rgba(40,50,80,0.5)"/>
            <ellipse class="dm__drum-ring" cx="900" cy="265" rx="86" ry="22" fill="none" stroke="#9ed6f0" stroke-width="2" opacity="0"/>
          </g>

          <!-- Hi-hat (small left side, like a hanging cymbal) -->
          <g class="dm__drum dm__drum--hat" data-voice="hat">
            <line x1="200" y1="408" x2="200" y2="450" stroke="#2a1e16" stroke-width="1.5"/>
            <ellipse cx="200" cy="408" rx="24" ry="5" fill="url(#dmBellMetal)" stroke="#3a2a18" stroke-width="0.4" opacity="0.8"/>
            <ellipse class="dm__drum-ring" cx="200" cy="408" rx="32" ry="8" fill="none" stroke="#e8d8a0" stroke-width="1.5" opacity="0"/>
          </g>

          <!-- Two crickets visible: small dots near the moss -->
          <g class="dm__cricket" data-i="0">
            <circle cx="290" cy="465" r="1.5" fill="#9ed68a"/>
          </g>
          <g class="dm__cricket" data-i="1">
            <circle cx="540" cy="475" r="1.5" fill="#9ed68a"/>
          </g>

          <!-- Moss patch (dim under moonlight) -->
          <g opacity="0.6">
            <ellipse cx="320" cy="460" rx="50" ry="8" fill="#4a6a4a" opacity="0.5"/>
            <ellipse cx="340" cy="464" rx="20" ry="4" fill="#3a5a3a"/>
            <ellipse cx="305" cy="462" rx="15" ry="3" fill="#4a6a4a"/>
            <ellipse cx="450" cy="478" rx="14" ry="3" fill="#3a5a3a"/>
          </g>

          <!-- Floor shadow band -->
          <ellipse cx="600" cy="540" rx="320" ry="10" fill="rgba(0,0,0,0.32)"/>
        </svg>
      </div>

      <div class="dm__overlay" id="dm-overlay">
        <button class="dm__play" id="dm-play" type="button" aria-label="Begin">
          <span class="dm__play-icon" id="dm-play-icon">▶</span>
          <span class="dm__play-label" id="dm-play-label">Begin</span>
        </button>
        <p class="dm__overlay-hint">ten minutes · headphones recommended · no buttons after this</p>
      </div>

      <div class="dm__status" id="dm-status" hidden>
        <span class="dm__status-time" id="dm-status-time">00:00</span>
        <span class="dm__status-sep">of</span>
        <span class="dm__status-total">10:00</span>
        <span class="dm__status-section" id="dm-status-section">first hush</span>
        <button class="dm__end" id="dm-end" type="button">end early</button>
      </div>
    </section>

    <section class="dm__about">
      <h2 class="dm__about-h">No peak</h2>
      <p>Drum Garden has a daytime arc — it builds toward noon-energy and lets go. Drum Moon refuses that shape. The whole ten minutes stays near the lower end of the dynamic range. The hand bell appears more often than the temple bell. The temple bell appears more often than the kick. The kick — modeled as a low rumble like thunder behind the hills — almost never appears at all.</p>
      <p>Two crickets chirp in the foreground, blinking in and out of phase like crickets do. They're not on the beat. The hi-hat ticks on a slower scale, like the breath of someone watching the moon.</p>
      <p>The sections are named for night-quiet, not for energy levels: <em>first hush, owl, deep night, distant temple, breath, far thunder, settled, second owl, before dawn, last bell</em>. The "far thunder" section is the most active — but its highest density is still lower than Drum Garden's quietest.</p>
      <p>Companion: <a href="/drum-garden">/drum-garden</a> · <a href="/drum-rain">/drum-rain</a> · <a href="/drum-temple">/drum-temple</a>.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --dm-frame: #1f5e3a;
      --dm-cream: #0f1424;
      --dm-text: #2a3326;
      --dm-text-dim: #5a6356;
      --dm-text-dimmer: #8a9285;
    }

    body:has(.dm) {
      background: radial-gradient(circle at 50% 20%, #f8f6ec 0%, #ece8d8 70%);
      color: var(--dm-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dm { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }

    .dm__hero { text-align: left; max-width: 760px; margin: 0 auto 36px; }
    .dm__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--dm-frame);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .dm__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--dm-text);
    }
    .dm__sub {
      font-size: 17px; line-height: 1.55;
      color: var(--dm-text-dim);
      margin: 0;
    }

    .dm__stage { position: relative; margin-bottom: 36px; }
    .dm__pavilion {
      position: relative;
      aspect-ratio: 2 / 1;
      max-height: 70vh;
      background: var(--dm-cream);
      border: 14px solid var(--dm-frame);
      border-radius: 4px;
      box-shadow: 0 24px 60px rgba(31,94,58,0.18), inset 0 0 0 3px rgba(255,255,255,0.4);
      overflow: hidden;
    }
    .dm__rail { position: absolute; left: 0; right: 0; height: 16px; background: var(--dm-frame); z-index: 2; }
    .dm__rail--top { top: 0; }
    .dm__rail--bottom { bottom: 0; }
    .dm__post { position: absolute; top: 0; bottom: 0; width: 14px; background: var(--dm-frame); z-index: 2; }
    .dm__post--left  { left: 33%; }
    .dm__post--right { right: 33%; }
    .dm__scene { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }

    @keyframes dmPulse {
      0%   { opacity: 0.85; transform: scale(1); }
      100% { opacity: 0;    transform: scale(1.32); }
    }
    .dm__drum-ring.dm__drum-ring--pulse {
      animation: dmPulse 2.4s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .dm__drum--struck { animation: dmStrike 0.5s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes dmStrike {
      0% { transform: translateY(0); }
      20% { transform: translateY(1.5px); }
      100% { transform: translateY(0); }
    }
    .dm__bonsai-needles {
      transform-origin: 1100px 240px;
      animation: dmSway 17s ease-in-out infinite alternate;
    }
    @keyframes dmSway {
      from { transform: rotate(-0.8deg); }
      to   { transform: rotate(0.8deg); }
    }
    .dm__cricket {
      animation: dmBlink 4s ease-in-out infinite;
      opacity: 0.7;
    }
    .dm__cricket[data-i="1"] { animation-delay: 1.6s; animation-duration: 5.4s; }
    @keyframes dmBlink {
      0%, 30%, 100% { opacity: 0.7; }
      15%           { opacity: 0; }
      45%, 75%      { opacity: 0.4; }
    }

    .dm__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(244,241,229,0.35) 0%, rgba(244,241,229,0.08) 60%, transparent 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .dm__stage[data-state="playing"] .dm__overlay,
    .dm__stage[data-state="ended"] .dm__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .dm__stage[data-state="ended"] .dm__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .dm__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .dm__play-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: var(--dm-frame);
      color: #fff;
      font-size: 32px;
      display: flex; align-items: center; justify-content: center;
      box-shadow:
        0 14px 36px rgba(31,94,58,0.32),
        inset 0 -4px 8px rgba(0,0,0,0.12),
        inset 0 4px 6px rgba(255,255,255,0.18);
      transition: transform 100ms ease;
    }
    .dm__play:hover .dm__play-icon { transform: scale(1.04); }
    .dm__play:active .dm__play-icon { transform: scale(0.96); }
    .dm__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: var(--dm-text);
      letter-spacing: 0.04em;
    }
    .dm__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--dm-text-dimmer);
      text-transform: lowercase;
      margin: 0;
    }

    .dm__status {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(244,241,229,0.85);
      border: 1px solid rgba(31,94,58,0.18);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--dm-text-dim);
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .dm__stage[data-state="playing"] .dm__status,
    .dm__stage[data-state="ended"] .dm__status { opacity: 1; }
    .dm__stage[data-state="ended"] .dm__status { opacity: 0.7; }
    .dm__status-time { font-weight: 600; color: var(--dm-text); font-variant-numeric: tabular-nums; }
    .dm__status-sep { color: var(--dm-text-dimmer); }
    .dm__status-total { color: var(--dm-text); }
    .dm__status-section { margin-left: 12px; color: var(--dm-frame); text-transform: uppercase; }
    .dm__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(31,94,58,0.32);
      border-radius: 8px;
      color: var(--dm-frame);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .dm__end:hover { background: rgba(31,94,58,0.08); }

    .dm__about { max-width: 720px; margin: 0 auto; padding: 12px 0 0; }
    .dm__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dm-text);
      margin: 0 0 14px;
    }
    .dm__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--dm-text-dim);
      margin: 0 0 14px;
    }
    .dm__about em { color: var(--dm-frame); font-style: italic; }
    .dm__about a {
      color: var(--dm-frame);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    @media (max-width: 640px) {
      .dm__pavilion { border-width: 10px; }
      .dm__post { width: 10px; }
      .dm__rail { height: 12px; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Voice = 'temple' | 'hand' | 'chime' | 'hat' | 'kick' | 'cricket';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.55;
      masterGain.connect(ctx.destination);
    }
    function noise(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 3;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }

    // Temple bell: warm, low-mid, longer decay
    function playTempleBell(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const partials = [
        { freq: 320, gain: 0.30, decay: 6.5 },
        { freq: 480, gain: 0.20, decay: 5.0 },
        { freq: 768, gain: 0.10, decay: 3.4 },
        { freq: 1120, gain: 0.06, decay: 2.0 },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      flashDrum('temple');
    }

    // Hand bell: bright, smaller, shorter
    function playHandBell(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const partials = [
        { freq: 880, gain: 0.18, decay: 2.6 },
        { freq: 1320, gain: 0.12, decay: 2.0 },
        { freq: 2112, gain: 0.06, decay: 1.0 },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.005);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      flashDrum('hand');
    }

    // Wind chime: 4 detuned partials simultaneously, hand-tuned to harmonize
    function playChime(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // Pentatonic-ish so any number sounds good
      const freqs = [784, 988, 1175, 1568];  // G5, B5, D6, G6
      // Pick 2-3 random freqs to fire near-simultaneously
      const shuffled = [...freqs].sort(() => Math.random() - 0.5);
      const count = 2 + Math.floor(Math.random() * 2);  // 2-3
      for (let i = 0; i < count; i++) {
        const f = shuffled[i];
        const offset = i * 0.02;  // slight stagger
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = f;
        g.gain.setValueAtTime(0.0001, t + offset);
        g.gain.exponentialRampToValueAtTime(0.16 * vel, t + offset + 0.004);
        g.gain.exponentialRampToValueAtTime(0.0001, t + offset + 1.6);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t + offset);
        osc.stop(t + offset + 1.7);
        // Soft harmonic partial
        const osc2 = ctx.createOscillator();
        const g2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.value = f * 2;
        g2.gain.setValueAtTime(0.0001, t + offset);
        g2.gain.exponentialRampToValueAtTime(0.05 * vel, t + offset + 0.004);
        g2.gain.exponentialRampToValueAtTime(0.0001, t + offset + 0.6);
        osc2.connect(g2).connect(masterGain);
        scheduler.trackSource(osc2);
        osc2.start(t + offset);
        osc2.stop(t + offset + 0.7);
      }
      flashDrum('chime');
    }

    // Hi-hat: very soft HP noise
    function playHat(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 9200;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      src.connect(hp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.07);
      flashDrum('hat');
    }

    // Distant kick: very low, very soft, with a long noise tail (thunder)
    function playKick(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(48, t);
      osc.frequency.exponentialRampToValueAtTime(28, t + 0.4);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.28 * vel, t + 0.05);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.95);
      // Long low-rumble tail
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 160;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.2);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
      src.connect(lp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 1.85);
      flashDrum('kick');
    }

    // Cricket chirp: short BP noise tone
    function playCricket(t: number) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = 4200 + Math.random() * 800;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.04, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.05);
    }

    function flashDrum(voice: Voice) {
      const group = document.querySelector(`.dm__drum--${voice}`);
      if (!group) return;
      group.classList.remove('dm__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('dm__drum--struck');
      setTimeout(() => group.classList.remove('dm__drum--struck'), 520);
      const ring = group.querySelector('.dm__drum-ring');
      if (ring) {
        ring.classList.remove('dm__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('dm__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('dm__drum-ring--pulse'), 2500);
      }
    }

    // ---- arc ----
    // Note: max sparsity here is intentionally lower than /drum-garden's quietest
    type Section = {
      name: string;
      sparsity: number;
      weights: Partial<Record<Voice, number>>;
      ringTempleOnEntry?: boolean;
    };
    const SECTIONS: Section[] = [
      { name: 'first hush',     sparsity: 0.03, weights: { hat: 5, hand: 1 },                            ringTempleOnEntry: true },
      { name: 'owl',            sparsity: 0.06, weights: { hat: 4, hand: 2, chime: 1 } },
      { name: 'deep night',     sparsity: 0.09, weights: { hat: 4, hand: 3, chime: 1.5 } },
      { name: 'distant temple', sparsity: 0.10, weights: { hat: 3, hand: 3, chime: 2, temple: 0.6 } },
      { name: 'breath',         sparsity: 0.08, weights: { hat: 5, hand: 2, chime: 1 } },
      { name: 'far thunder',    sparsity: 0.12, weights: { hat: 3, hand: 2, chime: 2, temple: 0.4, kick: 0.5 } },
      { name: 'settled',        sparsity: 0.08, weights: { hat: 4, hand: 2, chime: 1.5 } },
      { name: 'second owl',     sparsity: 0.06, weights: { hat: 4, hand: 2, chime: 1 } },
      { name: 'before dawn',    sparsity: 0.04, weights: { hat: 3, hand: 1.5, chime: 0.6 } },
      { name: 'last bell',      sparsity: 0.02, weights: { hat: 2, hand: 0.8 },                          ringTempleOnEntry: true },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 38;  // even slower than /drum-temple
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 2;
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let cricketTimer: number | null = null;
    let lastTempleSection = -1;
    let schedulingComplete = false;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) { r -= w; if (r <= 0) return v; }
      return entries[0][0];
    }

    function fireVoice(voice: Voice, t: number, vel: number) {
      switch (voice) {
        case 'temple': playTempleBell(t, vel); break;
        case 'hand':   playHandBell(t, vel); break;
        case 'chime':  playChime(t, vel); break;
        case 'hat':    playHat(t, vel); break;
        case 'kick':   playKick(t, vel); break;
        case 'cricket': playCricket(t); break;
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.5;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        if (elapsed >= TOTAL_SEC) { schedulingComplete = true; break; }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(Math.max(0, elapsed) / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        if (section.ringTempleOnEntry && sectionIdx !== lastTempleSection) {
          const sectionStartSec = sectionIdx * SECTION_LEN_SEC;
          if (Math.abs(elapsed - sectionStartSec) < SLOT_SEC * 0.6) {
            playTempleBell(nextSlotTime, 0.8);
            lastTempleSection = sectionIdx;
          }
        }

        const slotInBar = slotIdx % 8;
        const isDownbeat = slotInBar === 0;
        let p = section.sparsity;
        if (isDownbeat) p = Math.min(1, p * 1.6);
        if (Math.random() < p) {
          let voice = pickWeighted(section.weights);
          if (voice) {
            const vel = isDownbeat ? 0.9 : 0.45 + Math.random() * 0.4;
            fireVoice(voice, nextSlotTime, vel);
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 90);
    }

    function scheduleCricket() {
      if (!playing || !ctx) return;
      // Random short cricket chirps every 4-10 seconds, ignoring beat grid
      const delay = 3500 + Math.random() * 7000;
      cricketTimer = window.setTimeout(() => {
        if (!playing || !ctx) return;
        const numChirps = 2 + Math.floor(Math.random() * 4);
        for (let i = 0; i < numChirps; i++) {
          playCricket(ctx!.currentTime + 0.02 + i * 0.16);
        }
        scheduleCricket();
      }, delay);
    }

    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('dm-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('dm-status-section')!.textContent = SECTIONS[si].name;
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      lastTempleSection = -1;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('dm-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('dm-status')!.removeAttribute('hidden');
      scheduleAhead();
      scheduleCricket();
      tickUi();
    }
    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      if (cricketTimer != null) { clearTimeout(cricketTimer); cricketTimer = null; }
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('dm-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('dm-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('dm-play')!.addEventListener('click', () => startPlaying());
      document.getElementById('dm-end')!.addEventListener('click', () => stopPlaying(false));
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
