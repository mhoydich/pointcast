---
/**
 * Homepage v2027 — the newsroom desk.
 *
 * Rebuilt 2026-05-07 from a 2007-line additive stack of ~30 pulse modules
 * to a focused four-section editorial home. The diagnosis was: every new
 * feature got another always-on strip on `/`, so nothing felt fresh and
 * the operating mode of the project (parallel agents shipping work in
 * stages) was invisible.
 *
 * The new layout, top to bottom:
 *
 *   1. THE LEAD          — single editorial hero, one big headline,
 *                           time-of-day kicker, latest-block-as-content.
 *   2. OPERATING MODE    — three columns: WHAT'S IN FLIGHT (open PRs,
 *                           drafts) · JUST LANDED (last 3 ships) ·
 *                           HEARTBEAT (today/week/total counts).
 *   3. TODAY / THIS WEEK — proper editorial cards, not pulse strips.
 *                           Three columns max. Recent first.
 *   4. ARCHIVE TEASER    — link into the giant chronological scroll
 *                           (Wave 2 — mile markers, sticky date anchor,
 *                           lazy chunks).
 *
 * The persistent live element (presence, ROOM/ASK/CAST, ON AIR) stays in
 * the existing FooterBar in BlockLayout — no changes there.
 *
 * Pulse modules removed from this page (TideSurf, SportsTicker,
 * AltarsPulse, QuintetPulseModule, ProcessionPulseModule,
 * OfferingsPulseModule, ChamberMega, WingPulseModule, NetworkStrip,
 * NatureFieldDeskStrip, etc.) still live at their own routes. They aren't
 * deleted; they just stop competing for the homepage.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import BlockCard from '../components/BlockCard.astro';
import { getCollection } from 'astro:content';
import { CHANNELS } from '../lib/channels';
import opmodeData from '../data/operating-mode.json';
import HomeCheckinHint from '../components/HomeCheckinHint.astro';
import HomePlacesDirectory from '../components/HomePlacesDirectory.astro';

// ---------- Data: blocks ----------
const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const sevenDaysAgo = new Date(startOfToday);
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);

const todayBlocks = allBlocks.filter(b => new Date(b.data.timestamp) >= startOfToday);
const weekBlocks  = allBlocks.filter(b => new Date(b.data.timestamp) >= sevenDaysAgo);

const justLanded = allBlocks.slice(0, 3);
const blockCount = allBlocks.length;

// First block ever (for the archive teaser "since" date).
const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

// ---------- Data: lead ----------
// The lead is the latest block, framed editorially with a time-of-day
// kicker. Always feels fresh because new blocks trigger a rebuild.
const lead = allBlocks[0];

function timeOfDayKicker(d: Date): string {
  const h = d.getHours();
  if (h >= 5 && h < 11)  return 'MORNING DESK';
  if (h >= 11 && h < 17) return 'MIDDAY · SHIP ROOM';
  if (h >= 17 && h < 22) return 'EVENING DISPATCH';
  return 'OVERNIGHT BUILD';
}

const todayStr = now.toISOString().slice(0, 10);
const leadKicker = `${timeOfDayKicker(now)} · ${todayStr}`;

const leadChannel = lead ? CHANNELS[lead.data.channel] : null;
const leadHref = lead?.data.external?.url
  || (lead ? `/b/${lead.data.id}` : '#');
const leadCta = (lead?.data.external?.label
  || (lead?.data.type === 'READ' ? 'read the brief' : 'open block')) + ' →';

// ---------- Data: opmode ----------
interface InFlightItem {
  id: string;
  title: string;
  kind: string;
  ref: string;
  url: string | null;
  owner: string;
  stage: string;
}
const opmode = opmodeData as {
  updatedAt: string;
  updatedBy: string;
  inFlight: InFlightItem[];
};

function fmtRelative(iso: string): string {
  const t = new Date(iso);
  const diffMs = +now - +t;
  if (diffMs < 0) return 'just now';
  const m = Math.round(diffMs / 60000);
  if (m < 60)   return `${m}m ago`;
  const h = Math.round(m / 60);
  if (h < 24)   return `${h}h ago`;
  const d = Math.round(h / 24);
  if (d < 30)   return `${d}d ago`;
  return t.toISOString().slice(0, 10);
}

// ---------- SEO / layout props ----------
const title = 'PointCast — agent-native broadcast from El Segundo';
const description = lead?.data.dek
  ? `Latest: ${lead.data.dek} · ${blockCount} blocks since ${sinceDate}.`
  : `An agent-native broadcast from El Segundo. ${blockCount} blocks and counting.`;

// Schema.org graph: Organization (the project) + WebSite (the surface) +
// CollectionPage (this homepage). Multi-node graph so /agents and search
// crawlers see the full publishing entity, not just a page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://pointcast.xyz/#org',
      name: 'PointCast',
      alternateName: 'University of El Segundo',
      url: 'https://pointcast.xyz',
      description: 'Agent-native broadcast from El Segundo. Parallel civic infrastructure built block by block.',
      foundingDate: sinceDate,
      areaServed: { '@type': 'Place', name: 'El Segundo, California (25-mile radius)' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://pointcast.xyz/#site',
      url: 'https://pointcast.xyz',
      name: 'PointCast',
      publisher: { '@id': 'https://pointcast.xyz/#org' },
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://pointcast.xyz/archive?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://pointcast.xyz/#home',
      url: 'https://pointcast.xyz/',
      name: title,
      description,
      isPartOf: { '@id': 'https://pointcast.xyz/#site' },
      publisher: { '@id': 'https://pointcast.xyz/#org' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: blockCount,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        name: `${blockCount} blocks since ${sinceDate}`,
      },
    },
  ],
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="home2027">

    {/* ============== 1. THE LEAD ============== */}
    {lead && (
      <section
        class="lead"
        style={`--ch-600: ${leadChannel?.color600 || '#1f1b15'}; --ch-50: ${leadChannel?.color50 || '#f5efe4'};`}
      >
        <p class="lead__kicker">{leadKicker} · CH.{lead.data.channel} · /{lead.data.id}</p>
        <h1 class="lead__title">{lead.data.title}</h1>
        {lead.data.dek && <p class="lead__dek">{lead.data.dek}</p>}
        <div class="lead__row">
          <a class="lead__cta" href={leadHref}>{leadCta}</a>
          {lead.data.external?.url && <a class="lead__alt" href={`/b/${lead.data.id}`}>open block →</a>}
          <span class="lead__by">
            by <strong>{lead.data.author || 'mh'}</strong>
            <span class="lead__dot">·</span>
            <time datetime={lead.data.timestamp}>{fmtRelative(lead.data.timestamp)}</time>
          </span>
        </div>
      </section>
    )}

    {/* ============== 1b. CHECK-IN HINT (returning visitors only) ==========
       Renders nothing for first-timers (no localStorage state). Clients
       with a /me state see a one-line "you're checked in / you haven't
       checked in" affordance with a link into /me. The component swaps
       in client-side from localStorage so the static HTML stays
       cacheable and the build doesn't differ per-visitor. */}
    <HomeCheckinHint />

    {/* ============== 2. OPERATING MODE ============== */}
    <section class="opmode" aria-label="Operating mode">
      <header class="opmode__head">
        <p class="kicker">OPERATING MODE</p>
        <span class="opmode__updated">updated {fmtRelative(opmode.updatedAt)} by {opmode.updatedBy}</span>
      </header>
      <div class="opmode__grid">

        <div class="opmode__col opmode__col--flight">
          <h3 class="opmode__h">IN FLIGHT</h3>
          <ul class="flight">
            {opmode.inFlight.length === 0 && (
              <li class="flight__empty">no work currently in flight.</li>
            )}
            {opmode.inFlight.map(f => (
              <li class="flight__row">
                <a href={f.url || '#'} class="flight__link">
                  <span class={`flight__kind flight__kind--${f.kind.toLowerCase()}`}>
                    {f.kind}{f.ref !== 'tbd' ? ` ${f.ref}` : ''}
                  </span>
                  <span class="flight__title">{f.title}</span>
                </a>
                <span class="flight__meta">{f.owner} · {f.stage}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="opmode__col opmode__col--landed">
          <h3 class="opmode__h">JUST LANDED</h3>
          <ul class="landed">
            {justLanded.map(b => (
              <li class="landed__row">
                <a href={`/b/${b.data.id}`} class="landed__link">
                  <span class="landed__id">/{b.data.id}</span>
                  <span class="landed__title">{b.data.title}</span>
                </a>
                <span class="landed__meta">CH.{b.data.channel} · {fmtRelative(b.data.timestamp)}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="opmode__col opmode__col--heartbeat">
          <h3 class="opmode__h">HEARTBEAT</h3>
          <dl class="heartbeat">
            <div class="heartbeat__stat">
              <dt>{todayBlocks.length}</dt>
              <dd>shipped today</dd>
            </div>
            <div class="heartbeat__stat">
              <dt>{weekBlocks.length}</dt>
              <dd>this week</dd>
            </div>
            <div class="heartbeat__stat">
              <dt>{blockCount}</dt>
              <dd>blocks total</dd>
            </div>
            <div class="heartbeat__stat heartbeat__stat--small">
              <dt>{(weekBlocks.length / 7).toFixed(1)}</dt>
              <dd>blocks / day · 7-day avg</dd>
            </div>
          </dl>
          <p class="heartbeat__since">since <time datetime={sinceDate}>{sinceDate}</time></p>
        </div>

      </div>
    </section>

    {/* ============== 3. TODAY ============== */}
    {todayBlocks.length > 0 && (
      <section class="band" id="today" aria-label="Today">
        <header class="band__head">
          <p class="kicker">TODAY · {todayStr}</p>
          <span class="band__count">{todayBlocks.length} block{todayBlocks.length === 1 ? '' : 's'}</span>
        </header>
        <div class="band__grid">
          {todayBlocks.slice(0, 6).map(block => <BlockCard block={block} />)}
        </div>
      </section>
    )}

    {/* ============== 3b. THIS WEEK ============== */}
    {weekBlocks.length > todayBlocks.length && (
      <section class="band" id="week" aria-label="This week">
        <header class="band__head">
          <p class="kicker">THIS WEEK</p>
          <span class="band__count">{weekBlocks.length - todayBlocks.length} more in last 7 days</span>
        </header>
        <div class="band__grid">
          {weekBlocks.slice(todayBlocks.length, todayBlocks.length + 9).map(block => (
            <BlockCard block={block} />
          ))}
        </div>
      </section>
    )}

    {/* ============== 3c. PLACES DIRECTORY ==============
       Yahoo / Craigslist-style link tree. Hand-curated index of every
       public surface, organized by purpose. Adds discovery the
       editorial lead/operating-mode/today flow doesn't provide. */}
    <HomePlacesDirectory />

    {/* ============== 4. ARCHIVE TEASER ============== */}
    <section class="archive-teaser" aria-label="Archive">
      <p class="kicker">ARCHIVE</p>
      <h2 class="archive-teaser__h">
        {blockCount} blocks since <time datetime={sinceDate}>{sinceDate}</time>.
      </h2>
      <p class="archive-teaser__dek">
        Every block ever published, in order. The full chronological scroll —
        with mile markers, sticky date anchor, and decreasing density as you
        go deeper — lands in <strong>v2027 wave 2</strong>. For now, jump in:
      </p>
      <div class="archive-teaser__row">
        <a class="archive-teaser__cta" href="/archive">browse the archive →</a>
        <a class="archive-teaser__alt" href="/blocks.json">/blocks.json (agents)</a>
        <a class="archive-teaser__alt" href="/feed.xml">RSS feed</a>
        <a class="archive-teaser__alt" href="/for-agents">/for-agents</a>
      </div>
    </section>

  </main>
</BlockLayout>

<style>
  .home2027 {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 20px 80px;
    font-family: var(--font-body);
  }

  .home2027 .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-warm);
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  /* ============== LEAD ============== */
  .lead {
    padding: 60px 0 56px;
    border-bottom: 1.5px solid var(--color-rule);
    margin-bottom: 36px;
  }
  .lead__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ch-600, var(--color-warm));
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .lead__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6.5vw, 84px);
    line-height: 1.02;
    font-weight: 600;
    margin: 0 0 18px;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .lead__dek {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.45;
    color: var(--color-ink-soft);
    max-width: 780px;
    margin: 0 0 28px;
  }
  .lead__row {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: 18px;
  }
  .lead__cta {
    display: inline-block;
    padding: 12px 22px;
    background: var(--color-ink);
    color: #fff !important;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.12s;
  }
  .lead__cta:hover { background: var(--color-warm); text-decoration: none; }
  .lead__alt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }
  .lead__alt:hover { color: var(--color-ink); }
  .lead__by {
    font-size: 13px;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
  }
  .lead__by strong { color: var(--color-ink); font-weight: 500; }
  .lead__dot { margin: 0 6px; }

  /* ============== OPERATING MODE ============== */
  .opmode {
    margin: 0 0 48px;
    padding: 22px;
    background: var(--color-card);
    border: 1.5px solid var(--color-rule);
    border-radius: 3px;
  }
  .opmode__head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
    margin: 0 0 16px;
  }
  .opmode__updated {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
  }
  .opmode__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 880px) {
    .opmode__grid { grid-template-columns: 1fr; gap: 24px; }
  }
  .opmode__col { min-width: 0; }
  .opmode__h {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-ink);
    text-transform: uppercase;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-rule);
  }

  /* IN FLIGHT */
  .flight { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .flight__empty { font-size: 13px; color: var(--color-ink-soft); }
  .flight__row { display: flex; flex-direction: column; gap: 2px; }
  .flight__link {
    display: flex; align-items: baseline; gap: 8px;
    text-decoration: none; color: var(--color-ink);
    line-height: 1.3;
  }
  .flight__link:hover .flight__title { color: var(--color-warm); }
  .flight__kind {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    padding: 1px 6px;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    color: var(--color-ink-soft);
    flex: 0 0 auto;
    text-transform: uppercase;
  }
  .flight__kind--pr { color: var(--color-accent); border-color: var(--color-accent); }
  .flight__title {
    font-size: 14px;
    font-weight: 500;
    transition: color 0.12s;
  }
  .flight__meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    padding-left: 50px;
  }

  /* JUST LANDED */
  .landed { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .landed__row { display: flex; flex-direction: column; gap: 2px; }
  .landed__link {
    display: flex; align-items: baseline; gap: 8px;
    text-decoration: none; color: var(--color-ink);
    line-height: 1.3;
  }
  .landed__link:hover .landed__title { color: var(--color-warm); }
  .landed__id {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    flex: 0 0 auto;
  }
  .landed__title { font-size: 14px; font-weight: 500; transition: color 0.12s; }
  .landed__meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    padding-left: 46px;
  }

  /* HEARTBEAT */
  .heartbeat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 18px;
    margin: 0;
  }
  .heartbeat__stat dt {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .heartbeat__stat dd {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }
  .heartbeat__stat--small {
    grid-column: span 2;
    border-top: 1px dashed var(--color-rule);
    padding-top: 10px;
    margin-top: 4px;
  }
  .heartbeat__stat--small dt {
    font-size: 22px;
    color: var(--color-ink-soft);
  }
  .heartbeat__since {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
  }

  /* ============== BANDS (TODAY / WEEK) ============== */
  .band { margin: 0 0 48px; }
  .band__head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin: 0 0 18px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--color-rule);
  }
  .band__count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
  }
  .band__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  /* ============== ARCHIVE TEASER ============== */
  .archive-teaser {
    margin: 64px 0 0;
    padding: 40px 28px;
    border: 1.5px dashed var(--color-rule);
    border-radius: 3px;
    background: var(--color-card);
    text-align: center;
  }
  .archive-teaser__h {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    margin: 0 0 14px;
    color: var(--color-ink);
  }
  .archive-teaser__h time {
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-ink-soft);
    letter-spacing: 0.04em;
  }
  .archive-teaser__dek {
    max-width: 580px; margin: 0 auto 22px;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .archive-teaser__dek strong { color: var(--color-ink); font-weight: 500; }
  .archive-teaser__row {
    display: flex; flex-wrap: wrap; gap: 16px;
    justify-content: center; align-items: center;
  }
  .archive-teaser__cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--color-ink);
    color: #fff !important;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
  }
  .archive-teaser__cta:hover { background: var(--color-warm); }
  .archive-teaser__alt {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .archive-teaser__alt:hover { color: var(--color-ink); }

  @media (max-width: 600px) {
    .home2027 { padding: 16px 16px 60px; }
    .lead { padding: 36px 0; }
    .opmode { padding: 16px; }
    .archive-teaser { padding: 28px 18px; }
  }
</style>
