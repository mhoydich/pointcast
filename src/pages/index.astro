      linear-gradient(180deg, rgba(104, 64, 146, 0.1) 0 28%, transparent 28% 100%),
      linear-gradient(135deg, rgba(238, 88, 119, 0.16), rgba(236, 214, 112, 0.24) 34%, rgba(80, 139, 91, 0.18) 62%, rgba(78, 126, 169, 0.16));
