  .discovery-all summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    color: #2f5f9f;
    cursor: pointer;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
