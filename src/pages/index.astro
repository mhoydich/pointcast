  openPrs: 60,               // gh pr list --state open (2026-09-01)
  prsByMonth: [              // gh pr list --state merged --json mergedAt, bucketed (2026-09-01)
    { label: 'Apr', count: 241 }, { label: 'May', count: 361 }, { label: 'Jun', count: 5 }, { label: 'Jul', count: 165 }, { label: 'Aug', count: 48 }, { label: 'Sep', count: 0 },
  ],
