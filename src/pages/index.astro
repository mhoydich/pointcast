    <script id="fresh-hero-signals" type="application/json" is:inline set:html={JSON.stringify(heroSignals)} />
    <script id="bells-bloom-transmissions" type="application/json" is:inline set:html={JSON.stringify(BELLS_BLOOM_TRANSMISSIONS)} />
    <script is:inline>
      (() => {
        const images = [...document.querySelectorAll('.fresh-home img')];

        images.forEach((image) => {
          if (!(image instanceof HTMLImageElement)) return;

          const retryOnce = () => {
            if (image.dataset.loadRetry === 'true') return;

            const failedSource = image.currentSrc || image.src;
            if (!failedSource) return;

            image.dataset.loadRetry = 'true';
            const retryUrl = new URL(failedSource, window.location.href);
            retryUrl.searchParams.set('pc-image-retry', '1');
            image.src = retryUrl.toString();
          };

          image.addEventListener('error', retryOnce);
          if (image.complete && image.naturalWidth === 0) retryOnce();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const payload = document.querySelector('#bells-bloom-transmissions');
        const root = document.querySelector('[data-today-signal]');
        if (!(root instanceof HTMLElement)) return;

        let transmissions = [];
        try {
          transmissions = JSON.parse(payload?.textContent || '[]');
        } catch {
          return;
        }
        if (!Array.isArray(transmissions) || transmissions.length === 0) return;

        const image = root.querySelector('[data-today-signal-image]');
        const title = root.querySelector('[data-today-signal-title]');
        const dek = root.querySelector('[data-today-signal-dek]');
        const label = root.querySelector('[data-today-signal-label]');
        const kicker = root.querySelector('[data-today-signal-kicker]');
        const date = root.querySelector('[data-today-signal-date]');
        const count = root.querySelector('[data-today-signal-count]');
        const mode = root.querySelector('[data-today-signal-mode]');
        const railLabel = root.querySelector('[data-today-signal-rail-label]');
        const selectors = [...root.querySelectorAll('[data-today-signal-select]')];
        const archiveAt = Date.parse(root.dataset.archiveAt || '');
        let active = 0;
        let manuallySelected = false;

        const liveIndex = () => {
          const now = Date.now();
          let next = 0;
          transmissions.forEach((transmission, index) => {
            if (Date.parse(transmission.publishAt) <= now) next = index;
          });
          return next;
        };

        const show = (nextIndex, announce = false) => {
          active = Math.max(0, Math.min(transmissions.length - 1, nextIndex));
          const transmission = transmissions[active];
          const archived = Number.isFinite(archiveAt) && Date.now() >= archiveAt;

          if (image instanceof HTMLImageElement) {
            image.src = transmission.image;
            image.alt = transmission.alt;
          }
          if (title) title.textContent = transmission.title;
          if (dek) {
            dek.textContent = archived
              ? `Bell ${transmission.id} of 28. One of seven recent transmissions from the Bells / Bloom archive.`
              : `Bell ${transmission.id} of 28. One morning transmission from Bells / Bloom, changing daily at 8:08 PT.`;
          }
          if (label) label.textContent = archived ? 'Recent transmissions' : 'Today’s signal';
          if (kicker) kicker.textContent = archived ? 'Bells / Bloom · recent transmissions' : 'Bell of the day · 08:08 PT';
          if (date) date.textContent = transmission.dateLabel;
          if (count) count.textContent = `Bell ${transmission.id} / 28`;
          if (mode) mode.textContent = archived ? '7 transmissions' : 'Changes daily';
          if (railLabel) railLabel.textContent = archived ? 'Recent transmissions' : 'This week at 08:08 PT';
          root.dataset.archive = archived ? 'true' : 'false';

          selectors.forEach((selector, selectorIndex) => {
            selector.setAttribute('aria-pressed', selectorIndex === active ? 'true' : 'false');
          });

          if (announce) {
            if (title instanceof HTMLElement) {
              title.setAttribute('tabindex', '-1');
              title.focus({ preventScroll: true });
            }
          }
        };

        selectors.forEach((selector, selectorIndex) => {
          selector.addEventListener('click', () => {
            manuallySelected = true;
            show(selectorIndex, true);
          });
        });

        show(liveIndex());
        window.setInterval(() => {
          if (!manuallySelected) show(liveIndex());
        }, 30_000);
      })();
    </script>
    <script is:inline>
      (() => {
        const clock = document.querySelector('#fresh-clock');
        const updateClock = () => {
          if (!clock) return;
          clock.textContent = new Intl.DateTimeFormat('en-US', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: false,
            timeZone: 'America/Los_Angeles',
            timeZoneName: 'short',
          }).format(new Date());
        };
        updateClock();
        window.setInterval(updateClock, 30_000);

        const payload = document.querySelector('#fresh-hero-signals');
        let signals = [];
        try {
          signals = JSON.parse(payload?.textContent || '[]');
        } catch {
          signals = [];
        }

        const art = document.querySelector('[data-fresh-hero-art]');
        const image = document.querySelector('[data-fresh-hero-image]');
        const title = document.querySelector('[data-fresh-hero-title]');
        const index = document.querySelector('[data-fresh-hero-index]');
        const frequency = document.querySelector('[data-fresh-hero-frequency]');
        const note = document.querySelector('[data-fresh-hero-note]');
        const link = document.querySelector('[data-fresh-hero-link]');
        const button = document.querySelector('[data-fresh-shuffle]');
        const status = document.querySelector('[data-fresh-signal-status]');
        const presetButtons = [...document.querySelectorAll('[data-fresh-signal-select]')];
        let active = 0;
        let changeTimer = 0;

        const tune = (nextIndex) => {
          if (!(art instanceof HTMLElement) || !(image instanceof HTMLImageElement) || signals.length < 2) return;
          active = ((nextIndex % signals.length) + signals.length) % signals.length;
          const next = signals[active];
          art.dataset.changing = 'true';
          window.clearTimeout(changeTimer);
          changeTimer = window.setTimeout(() => {
            image.src = next.src;
            image.alt = next.alt;
            image.style.objectPosition = next.imagePosition || 'center center';
            if (title) title.textContent = next.title;
            if (index) index.textContent = `Field signal ${String(active + 1).padStart(2, '0')} / ${String(signals.length).padStart(2, '0')}`;
            if (frequency) frequency.textContent = next.frequency;
            if (note) note.textContent = next.note;
            if (link instanceof HTMLAnchorElement) link.href = next.href;
            if (status) status.textContent = `Receiving ${next.title}, ${next.frequency}. ${next.note}`;
            art.dataset.signalId = next.id;
            art.style.setProperty('--fresh-signal-color', next.color);
            document.documentElement.style.setProperty('--fresh-acid', next.color);
            presetButtons.forEach((preset, presetIndex) => {
              preset.setAttribute('aria-pressed', presetIndex === active ? 'true' : 'false');
            });
            art.dataset.changing = 'false';
          }, 120);
        };

        button?.addEventListener('click', () => tune(active + 1));
        presetButtons.forEach((preset, presetIndex) => {
          preset.addEventListener('click', () => tune(presetIndex));
        });

        art?.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          tune(active + (event.key === 'ArrowRight' ? 1 : -1));
          const nextButton = presetButtons[((active % presetButtons.length) + presetButtons.length) % presetButtons.length];
          if (nextButton instanceof HTMLButtonElement) nextButton.focus();
        });
      })();
    </script>
  </div>

  <script>
    type LiveNowPlaying = {
      title?: string;
      artist?: string;
      status?: string;
      live?: boolean;
    };
    type LiveNowWindow = Window & {
      __pointcastLiveNowTimer?: number;
    };

    function initLiveNowPlaying() {
      const root = document.querySelector<HTMLElement>('[data-live-now-playing]');
      if (!root) return;
      const liveWindow = window as LiveNowWindow;
      if (liveWindow.__pointcastLiveNowTimer) {
        window.clearInterval(liveWindow.__pointcastLiveNowTimer);
      }

      const refresh = async () => {
        try {
          const response = await fetch('/now-playing.json', {
            cache: 'no-store',
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          const playing = await response.json() as LiveNowPlaying;
          const state = root.querySelector<HTMLElement>('[data-live-now-state-text]');
          const label = root.querySelector<HTMLElement>('[data-live-now-label]');
          const title = root.querySelector<HTMLElement>('[data-live-now-title]');
          const onAir = playing.status === 'playing' && playing.live === true;
          if (state) state.textContent = onAir ? 'On air' : 'Standby';
          if (label) label.textContent = onAir ? 'Currently spinning' : 'Last signal';
          if (title && playing.title) {
            title.textContent = playing.artist
              ? `${playing.title} · ${playing.artist}`
              : playing.title;
          }
          root.dataset.state = onAir ? 'live' : 'standby';
          root.setAttribute(
            'aria-label',
            `${onAir ? 'Currently spinning' : 'Last PointCast signal'}: ${playing.title ?? 'unknown'}${playing.artist ? ` by ${playing.artist}` : ''}`,
          );
        } catch {
          // The built-in editorial signal remains visible when live auth is offline.
        }
      };

      void refresh();
      liveWindow.__pointcastLiveNowTimer = window.setInterval(refresh, 60_000);
    }

    initLiveNowPlaying();
    document.addEventListener('astro:page-load', initLiveNowPlaying);
  </script>
