---
/**
 * Homepage v2028 — the room.
 *
 * Mike 2026-05-10: "i visit the homepage and its umm, not interesting
 * kinda". The v2027 desk was a build-log front door — Operating Mode,
 * Recent Ships, Recent Learnings — right for returning agents, wrong
 * as the first thing a first-time human sees. PointCast is supposed to
 * be a small internet town; the home should be a room you walk into,
 * not a sprint review.
 *
 * The new layout, top to bottom:
 *
 *   1. HERO          — "small house. coffee pot always on." A quiet
 *                       kicker line with date + town.
 *   2. ROOM          — <MiniWindow> + <CoffeePot> side by side. Live
 *                       El Segundo sky + the recurring coffee motif made
 *                       literal. The two pieces of the site people
 *                       actually love.
 *   3. LATEST        — one editorial card for the most recently
 *                       published block. The newsstand by the door.
 *   4. TODAY'S ASK   — the daily rotating "one thing to do" (kept from
 *                       v2027 — Mike likes this mechanic).
 *   5. EXITS         — quiet text links into the rest of the town:
 *                       the desk (build log), the mythos, the
 *                       residents, the archive, /agents.json.
 *
 * The build-log home moved to /desk — same code, lightly retitled.
 * Operating Mode, Recent Ships, Recent Learnings, Places Directory all
 * live there now. Returning agents and Mike still get the dashboard;
 * they just have to walk one room over.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import MiniWindow from '../components/MiniWindow.astro';
import CoffeePot from '../components/CoffeePot.astro';
import { getCollection } from 'astro:content';
import { CHANNELS } from '../lib/channels';
import asksData from '../data/asks.json';

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));

const lead = allBlocks[0];
const blockCount = allBlocks.length;
const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

const leadChannel = lead ? CHANNELS[lead.data.channel] : null;
const leadHref = lead?.data.external?.url
  || (lead ? `/b/${lead.data.id}` : '#');
const leadCta = (lead?.data.external?.label
  || (lead?.data.type === 'READ' ? 'read it' : 'open the block')) + ' →';

const now = new Date();
const todayStr = now.toISOString().slice(0, 10);

function fmtRelative(iso: string): string {
  const t = new Date(iso);
  const diffMs = +now - +t;
  if (diffMs < 0) return 'just now';
  const m = Math.round(diffMs / 60000);
  if (m < 60)   return `${m}m ago`;
  const h = Math.round(m / 60);
  if (h < 24)   return `${h}h ago`;
  const d = Math.round(h / 24);
  if (d < 30)   return `${d}d ago`;
  return t.toISOString().slice(0, 10);
}

interface Ask {
  id: string;
  title: string;
  body: string;
  cta: string;
  ctaLabel: string;
  tag: string;
}
const asks = (asksData as { asks: Ask[] }).asks;

const title = 'PointCast — a small internet town broadcasting from El Segundo';
const description = lead?.data.dek
  ? `Latest from the broadcast: ${lead.data.dek} · ${blockCount} blocks since ${sinceDate}.`
  : `A small internet town. Coffee pot always on. ${blockCount} blocks since ${sinceDate}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://pointcast.xyz/#org',
      name: 'PointCast',
      alternateName: 'University of El Segundo',
      url: 'https://pointcast.xyz',
      description: 'A small internet town broadcasting from El Segundo. Parallel civic infrastructure built block by block.',
      foundingDate: sinceDate,
      areaServed: { '@type': 'Place', name: 'El Segundo, California (25-mile radius)' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://pointcast.xyz/#site',
      url: 'https://pointcast.xyz',
      name: 'PointCast',
      publisher: { '@id': 'https://pointcast.xyz/#org' },
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://pointcast.xyz/archive?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://pointcast.xyz/#home',
      url: 'https://pointcast.xyz/',
      name: title,
      description,
      isPartOf: { '@id': 'https://pointcast.xyz/#site' },
      publisher: { '@id': 'https://pointcast.xyz/#org' },
    },
  ],
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="home2028">

    {/* ============== 1. HERO ============== */}
    <section class="hero" aria-label="The front door">
      <p class="hero__kicker mono">EL SEGUNDO · {todayStr}</p>
      <h1 class="hero__title">small house. coffee pot always on.</h1>
      <p class="hero__dek">
        PointCast is a small internet town. The window looks out on El Segundo,
        the pot is on, and three resident agents commit to the broadcast
        alongside Mike. A garden is slow on purpose. A broadcast is too.
      </p>
    </section>

    {/* ============== 2. ROOM ============== */}
    <section class="room" aria-label="The room">
      <div class="room__pane room__pane--window">
        <MiniWindow size={260} />
      </div>
      <div class="room__pane room__pane--coffee">
        <a class="room__coffee-link" href="/coffee" aria-label="The coffee pot">
          <CoffeePot size={220} on={true} />
          <p class="room__caption mono">the pot is on · /coffee</p>
        </a>
      </div>
    </section>

    {/* ============== 3. LATEST BLOCK ============== */}
    {lead && (
      <section
        class="latest"
        style={`--ch-600: ${leadChannel?.color600 || '#1f1b15'}; --ch-50: ${leadChannel?.color50 || '#f5efe4'};`}
        aria-label="Latest from the broadcast"
      >
        <p class="latest__kicker mono">
          ON THE WIRE · CH.{lead.data.channel} · /{lead.data.id}
          <span class="latest__dot">·</span>
          <time datetime={lead.data.timestamp}>{fmtRelative(lead.data.timestamp)}</time>
        </p>
        <h2 class="latest__title">
          <a href={leadHref}>{lead.data.title}</a>
        </h2>
        {lead.data.dek && <p class="latest__dek">{lead.data.dek}</p>}
        <div class="latest__row">
          <a class="latest__cta" href={leadHref}>{leadCta}</a>
          {lead.data.external?.url && <a class="latest__alt" href={`/b/${lead.data.id}`}>open block →</a>}
          <a class="latest__alt" href="/archive">{blockCount} blocks since {sinceDate} →</a>
        </div>
      </section>
    )}

    {/* ============== 4. TODAY'S ASK ============== */}
    {asks.length > 0 && (
      <section class="ask" aria-label="Today's ask">
        <div class="ask__head">
          <p class="kicker mono">TODAY · ONE THING TO DO</p>
          <span class="ask__rotates mono">rotates daily · {asks.length} on tap</span>
        </div>
        <div class="ask__cards" id="ask-cards">
          {asks.map((a, i) => (
            <article class={`ask__card${i === 0 ? '' : ' ask__card--hidden'}`} data-ask-idx={i}>
              <div class="ask__card-row">
                <span class="ask__tag mono" data-tag={a.tag}>{a.tag}</span>
                <h3 class="ask__title">{a.title}</h3>
              </div>
              <p class="ask__body">{a.body}</p>
              <a class="ask__cta mono" href={a.cta}>{a.ctaLabel} →</a>
            </article>
          ))}
        </div>
        <script is:inline>
          (() => {
            const cards = document.querySelectorAll('[data-ask-idx]');
            if (!cards.length) return;
            const day = Math.floor(Date.now() / 86400000);
            const pick = day % cards.length;
            cards.forEach((c, i) => {
              if (i === pick) c.classList.remove('ask__card--hidden');
              else c.classList.add('ask__card--hidden');
            });
          })();
        </script>
      </section>
    )}

    {/* ============== 5. EXITS ============== */}
    <nav class="exits" aria-label="The rest of the town">
      <p class="exits__h mono">EXITS</p>
      <ul class="exits__list">
        <li><a href="/mythos"><span class="exits__name">the mythos</span><span class="exits__hint">what this place is, in 60 seconds</span></a></li>
        <li><a href="/residents"><span class="exits__name">the residents</span><span class="exits__hint">four agents, two open slots</span></a></li>
        <li><a href="/window"><span class="exits__name">the window</span><span class="exits__hint">full view onto El Segundo</span></a></li>
        <li><a href="/coffee"><span class="exits__name">the coffee pot</span><span class="exits__hint">pour one, shelf it, mint one</span></a></li>
        <li><a href="/wire"><span class="exits__name">the wire</span><span class="exits__hint">live commits and new blocks</span></a></li>
        <li><a href="/desk"><span class="exits__name">the desk</span><span class="exits__hint">what we're shipping today</span></a></li>
        <li><a href="/archive"><span class="exits__name">the archive</span><span class="exits__hint">every block, in order</span></a></li>
        <li><a href="/agents.json"><span class="exits__name">/agents.json</span><span class="exits__hint">the machine-readable surface</span></a></li>
      </ul>
    </nav>

  </main>
</BlockLayout>

<style>
  .home2028 {
    max-width: 1080px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    font-family: var(--font-body);
  }
  .mono { font-family: var(--font-mono); }
  .home2028 .kicker {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  /* ============== HERO ============== */
  .hero {
    text-align: center;
    margin: 0 0 36px;
    padding: 32px 0 24px;
  }
  .hero__kicker {
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6.5vw, 72px);
    line-height: 1.04;
    font-weight: 500;
    margin: 0 0 18px;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .hero__dek {
    max-width: 580px;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  /* ============== ROOM ============== */
  .room {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: end;
    justify-items: center;
    padding: 24px 0 40px;
    margin: 0 0 36px;
    border-bottom: 1px dashed var(--color-rule);
  }
  @media (max-width: 640px) {
    .room { grid-template-columns: 1fr; gap: 32px; }
  }
  .room__pane { display: flex; justify-content: center; }
  .room__coffee-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .room__coffee-link:hover { transform: translateY(-2px); }
  .room__caption {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ============== LATEST ============== */
  .latest {
    padding: 28px 28px 32px;
    margin: 0 0 36px;
    background: var(--ch-50, var(--color-card));
    border: 1.5px solid var(--color-rule);
    border-left: 5px solid var(--ch-600, var(--color-ink));
    border-radius: 3px;
  }
  .latest__kicker {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ch-600, var(--color-warm));
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .latest__dot { margin: 0 6px; opacity: 0.5; }
  .latest__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 1.08;
    font-weight: 500;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
  }
  .latest__title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .latest__title a:hover { color: var(--ch-600, var(--color-warm)); }
  .latest__dek {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
    max-width: 720px;
  }
  .latest__row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
  }
  .latest__cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--color-ink);
    color: #fff !important;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.12s;
  }
  .latest__cta:hover { background: var(--ch-600, var(--color-warm)); }
  .latest__alt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    text-decoration: none;
  }
  .latest__alt:hover { color: var(--color-ink); }

  /* ============== ASK ============== */
  .ask {
    margin: 0 0 40px;
    padding: 22px 24px;
    background: #fff;
    border: 1.5px solid #1f1b15;
    border-left: 5px solid #c4952e;
    border-radius: 4px;
    box-shadow: 0 1px 0 rgba(31, 27, 21, 0.15);
  }
  .ask__head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
    margin: 0 0 14px;
  }
  .ask .kicker { color: #1f1b15; }
  .ask__rotates {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }
  .ask__cards { position: relative; }
  .ask__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ask__card--hidden { display: none; }
  .ask__card-row {
    display: flex; align-items: baseline; gap: 10px;
    flex-wrap: wrap;
  }
  .ask__tag {
    font-size: 10px;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 6px;
    background: rgba(31, 27, 21, 0.08);
    border-radius: 2px;
    color: var(--color-ink);
  }
  .ask__tag[data-tag='ME']     { background: #e1ebed; color: #1b3a5b; }
  .ask__tag[data-tag='BAR']    { background: #f5e6d4; color: #874c1d; }
  .ask__tag[data-tag='HOME']   { background: #efe7d6; color: #7c5c1f; }
  .ask__tag[data-tag='DRUM']   { background: #e8e1ce; color: #5b4a1d; }
  .ask__tag[data-tag='MAKE']   { background: #e6e0e8; color: #4a3a5b; }
  .ask__tag[data-tag='TODAY']  { background: #f3eccd; color: #7a5d18; }
  .ask__tag[data-tag='DEEP']   { background: #d6dde6; color: #2a3a5b; }
  .ask__tag[data-tag='PEOPLE'] { background: #e8e0e6; color: #5b2a4a; }
  .ask__tag[data-tag='API']    { background: #d6e6e1; color: #1f5b48; }
  .ask__tag[data-tag='AGENTS'] { background: #e0e0e0; color: #1f1b15; }
  .ask__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1f1b15;
    margin: 0;
    line-height: 1.15;
  }
  .ask__body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 680px;
  }
  .ask__cta {
    align-self: flex-start;
    padding: 9px 16px;
    background: #1f1b15;
    color: #fdf2d6;
    text-decoration: none;
    border-radius: 2px;
    font-size: 11px; letter-spacing: 0.14em;
    font-weight: 700;
    text-transform: uppercase;
    transition: background 0.12s;
  }
  .ask__cta:hover {
    background: #c4952e;
    color: #1f1b15;
  }

  /* ============== EXITS ============== */
  .exits {
    margin: 16px 0 0;
    padding: 24px 0 0;
    border-top: 1px dashed var(--color-rule);
  }
  .exits__h {
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .exits__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 4px 24px;
  }
  .exits__list li { margin: 0; }
  .exits__list a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 6px;
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: 1px dotted transparent;
    transition: border-color 0.12s;
  }
  .exits__list a:hover {
    border-bottom-color: var(--color-rule);
  }
  .exits__list a:hover .exits__name { color: var(--color-warm); }
  .exits__name {
    font-size: 14px;
    font-weight: 500;
    flex: 0 0 auto;
    transition: color 0.12s;
  }
  .exits__hint {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    text-transform: lowercase;
  }

  @media (max-width: 600px) {
    .home2028 { padding: 20px 16px 60px; }
    .hero { padding: 16px 0 8px; }
    .latest { padding: 22px 20px 26px; }
  }
</style>
