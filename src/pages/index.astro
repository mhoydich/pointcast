---
/**
 * PointCast front door — focused live edition.
 *
 * The archive remains broad; the homepage is deliberately edited:
 * one live signal, one current feature, three clear doors, four current
 * stories, then channels.
 * This keeps PointCast legible on a first visit without hiding any route,
 * feed, block, app, room, or machine-readable surface.
 */
import { getCollection } from 'astro:content';
import BlockLayout from '../layouts/BlockLayout.astro';
import SuperAuthRibbon from '../components/SuperAuthRibbon.astro';
import SuperFollowRibbon from '../components/SuperFollowRibbon.astro';
import WalletChip from '../components/WalletChip.astro';
import { CHANNEL_LIST } from '../lib/channels';
import { HOME_FRESH_FEATURE } from '../lib/home-freshness';
import { HOME_SIGNALS } from '../lib/home-signals';
import {
  BELLS_BLOOM_ARCHIVE_AT,
  BELLS_BLOOM_MANIFEST_HREF,
  BELLS_BLOOM_SHOWCAST_HREF,
  BELLS_BLOOM_TRANSMISSIONS,
  getBellsBloomTransmission,
  isBellsBloomArchive,
} from '../lib/bells-bloom-transmissions';
import '../styles/front-door-fresh.css';

import windowsArtwork from '../assets/campaigns/network-el-segundo-2026/100-windows.png';
import commonsArtwork from '../assets/campaigns/local-star-commons-2026/commons-og.png';
import switchboardArtwork from '../assets/sunset-switchboard/og.png';
import gardenKiosk from '../assets/todays-art/2026-07-21/midjourney/garden-kiosk.webp';
import qwenWeatherArtwork from '../assets/campaigns/qwen-weather-2026/weather-organism.jpg';

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

const latestBlock = allBlocks[0] ?? null;
const nowPlaying = allBlocks.find((block) => {
  const meta = block.data.meta as Record<string, unknown> | undefined;
  return meta?.currentlyPlaying === true;
}) ?? latestBlock;
const blockCount = allBlocks.length;
const showLatestShip = latestBlock?.data.id !== HOME_FRESH_FEATURE.blockId;

const homeDescription = 'PointCast is an agent-native broadcast from El Segundo: live work, art, rooms, games, public experiments, and machine-readable receipts.';

const heroSignals = HOME_SIGNALS;
const activeTransmission = getBellsBloomTransmission();
const bellsBloomIsArchive = isBellsBloomArchive();
const activeTransmissionDescription = `Bell ${activeTransmission.id} of 28. One morning transmission from Bells / Bloom, changing daily at 8:08 PT.`;

const stories = [
  {
    href: '/network-el-segundo/v2',
    image: windowsArtwork.src,
    alt: 'Network El Segundo wall of one hundred public windows',
    channel: 'CH.ESC · NOTE',
    id: '0486',
    title: 'A city of 100 windows.',
    dek: 'Every verified Tezos wallet turns on one public light. The wall shows a count, never the addresses.',
    light: false,
  },
  {
    href: '/local-star-commons',
    image: commonsArtwork.src,
    alt: 'Local Star Commons founding release artwork',
    channel: 'CH.ESC · NOTE',
    id: '0490',
    title: 'Useful things, governed in common.',
    dek: 'Six local-first objects and a contribution-governed founding movement.',
    light: true,
  },
  {
    href: '/sunset-switchboard',
    image: switchboardArtwork.src,
    alt: 'Sunset Switchboard broadcast instrument at dusk',
    channel: 'CH.ESC · APP',
    id: '0487',
    title: 'Route one good signal before dark.',
    dek: 'Choose a sky, tune a band, set the reach, and leave no tracking trail.',
    light: false,
  },
  {
    href: '/gallery/today',
    image: gardenKiosk.src,
    alt: 'A bright civic garden kiosk from the PointCast visual desk',
    channel: 'TODAY’S ART',
    id: 'VISUAL DESK',
    title: 'One visual signal for the day.',
    dek: 'The art desk becomes a place to pause, not another mile of homepage.',
    light: true,
  },
];

function prettyShipTime(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/Los_Angeles',
    timeZoneName: 'short',
  }).format(date);
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/#home',
  name: 'PointCast front door',
  description: homeDescription,
  url: 'https://pointcast.xyz/',
  inLanguage: 'en-US',
  hasPart: allBlocks.slice(0, 20).map((block) => ({
    '@type': 'CreativeWork',
    '@id': `https://pointcast.xyz/b/${block.data.id}`,
    name: block.data.title,
    datePublished: block.data.timestamp.toISOString(),
    url: `https://pointcast.xyz/b/${block.data.id}`,
  })),
  mainEntity: {
    '@type': 'Review',
    '@id': 'https://pointcast.xyz/reviews/year-one#review',
    name: 'Year One: the mall learned to surf',
    description: 'A glossy, fast-reading edit of 116 impossible wave pedestals.',
    datePublished: '2026-07-26T21:15:00-07:00',
    url: 'https://pointcast.xyz/reviews/year-one',
    image: 'https://pointcast.xyz/images/year-one/year-one-og.jpg',
  },
};

const alternates = [
  { type: 'application/json', href: '/blocks.json', title: 'All blocks (JSON)' },
  { type: 'application/rss+xml', href: '/feed.xml', title: 'PointCast RSS' },
  { type: 'application/feed+json', href: '/feed.json', title: 'PointCast JSON Feed' },
  ...CHANNEL_LIST.map((channel) => ({
    type: 'application/rss+xml',
    href: `/c/${channel.slug}.rss`,
    title: `PointCast · ${channel.name}`,
  })),
];
---

<BlockLayout
  title="Home"
  description={homeDescription}
  image="https://pointcast.xyz/images/year-one/year-one-og.jpg"
  themeColor="#eaff62"
  jsonLd={jsonLd}
  alternates={alternates}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: 'https://pointcast.xyz/images/year-one/cover.webp',
    aspectRatio: '1:1',
    buttons: [
      { label: 'Open what is live', action: 'link', target: 'https://pointcast.xyz/now' },
      { label: 'Play something', action: 'link', target: 'https://pointcast.xyz/win95-games' },
      { label: 'For agents', action: 'link', target: 'https://pointcast.xyz/for-agents' },
    ],
  }}
>
  <div class="fresh-home">
    <div class="fresh-on-air" aria-label="Currently spinning on PointCast" data-live-now-playing>
      <span class="fresh-on-air__label" data-live-now-state>
        <span class="fresh-on-air__dot" aria-hidden="true"></span>
        <span data-live-now-state-text>On air</span>
      </span>
      <span class="fresh-on-air__track">
        <strong data-live-now-label>Currently spinning</strong>
        <span data-live-now-title>{nowPlaying?.data.title ?? 'PointCast live signal'}</span>
      </span>
      <a class="fresh-on-air__action" href="/now-playing.json">Read the signal →</a>
    </div>

    <div class="fresh-shell">
      <header class="fresh-masthead">
        <a class="fresh-brand" href="/" aria-label="PointCast home">PointCast</a>
        <div class="fresh-masthead__meta" aria-label="PointCast status">
          <span>{blockCount} blocks</span>
          <span>El Segundo</span>
          <span id="fresh-clock">—:— PT</span>
        </div>
        <div class="fresh-utility">
          <div class="fresh-wallet"><WalletChip /></div>
          <a href="/now">Now</a>
          <a class="fresh-utility__spotify" href="/auth#spotify" title="Spotify authorization and Super Auth controls">Spotify auth</a>
          <a href="/archive">Archive</a>
          <a href="/for-agents">For agents</a>
        </div>
      </header>

      <div class="fresh-main">
        <section class="year-one-splash" aria-labelledby="year-one-splash-title" data-year-one-splash>
          <a class="year-one-splash__link" href="/reviews/year-one">
            <span class="year-one-splash__topline">
              <span>PointCast / Special issue</span>
              <span>Review Lab · Issue 03</span>
              <span>July 2026</span>
            </span>

            <span class="year-one-splash__copy">
              <span class="year-one-splash__eyebrow">Cover story / Year One</span>
              <span class="year-one-splash__title" id="year-one-splash-title">
                <span>Year</span>
                <span>One</span>
              </span>
              <span class="year-one-splash__kicker">The mall learned to surf.</span>
              <span class="year-one-splash__dek">
                116 impossible wave pedestals. One glorious, easy-reading issue.
              </span>
              <span class="year-one-splash__cta">Open the issue <b aria-hidden="true">↗</b></span>
            </span>

            <span class="year-one-splash__media" aria-hidden="true">
              <img
                class="year-one-splash__cover"
                src="/images/year-one/cover.webp"
                alt=""
                width="1800"
                height="1800"
                loading="eager"
                fetchpriority="high"
              />
              <img
                class="year-one-splash__detail"
                src="/images/year-one/neon-ring.webp"
                alt=""
                width="1456"
                height="1456"
                loading="lazy"
              />
              <span class="year-one-splash__score">
                <b>4.5</b>
                <span>/ 5</span>
              </span>
              <span class="year-one-splash__burst">Best<br />in show</span>
            </span>

            <span class="year-one-splash__bottomline">
              <span>22 selected works</span>
              <span>29 prompt families</span>
              <span>Block 0507</span>
              <strong>Read now →</strong>
            </span>
          </a>
        </section>

        <section class="fresh-hero" aria-labelledby="fresh-hero-title">
          <div class="fresh-hero__copy">
            <div>
              <p class="fresh-eyebrow">
                <span class="fresh-live-dot" aria-hidden="true"></span>
                Front door / fresh signal
              </p>
              <h1 id="fresh-hero-title">Live work, <em>still moving.</em></h1>
              <p class="fresh-hero__dek">
                PointCast is an agent-native broadcast from El Segundo: art,
                rooms, public experiments, games, and machine-readable receipts.
              </p>
              <div class="fresh-hero__actions">
                <a class="fresh-button fresh-button--primary" href="/now">Open what is live</a>
                <a class="fresh-button fresh-button--quiet" href="#fresh-doors">Choose a door</a>
              </div>
            </div>
            <div class="fresh-hero__foot" aria-label="PointCast operating notes">
              <span>● No account to look around</span>
              <span>● Human + agent readable</span>
              <span>● Tezos first</span>
            </div>
          </div>

          <figure
            class="fresh-hero__art"
            data-fresh-hero-art
            data-signal-id={heroSignals[0].id}
            style={`--fresh-signal-color: ${heroSignals[0].color}`}
          >
            <img
              src={heroSignals[0].src}
              alt={heroSignals[0].alt}
              width="896"
              height="1344"
              loading="eager"
              fetchpriority="high"
              data-fresh-hero-image
            />
            <div class="fresh-hero__scan" aria-hidden="true"></div>
            <figcaption class="fresh-hero__art-label">
              <span class="fresh-hero__art-meta">
                <span data-fresh-hero-index>Field signal 01 / 04</span>
                <span data-fresh-hero-frequency>{heroSignals[0].frequency}</span>
              </span>
              <strong data-fresh-hero-title>{heroSignals[0].title}</strong>
              <span data-fresh-hero-note>{heroSignals[0].note}</span>
              <a href={heroSignals[0].href} data-fresh-hero-link>Open frequency ↗</a>
            </figcaption>
            <div class="fresh-signal-tuner">
              <div class="fresh-signal-tuner__presets" role="group" aria-label="Choose a field signal">
                {heroSignals.map((signal, signalIndex) => (
                  <button
                    type="button"
                    data-fresh-signal-select={signalIndex}
                    aria-label={`Tune to ${signal.title}, ${signal.frequency}`}
                    aria-pressed={signalIndex === 0 ? 'true' : 'false'}
                  >
                    <span>{String(signalIndex + 1).padStart(2, '0')}</span>
                    <small>{signal.frequency}</small>
                  </button>
                ))}
              </div>
              <button class="fresh-shuffle" type="button" data-fresh-shuffle>Change the signal ↻</button>
            </div>
            <p class="fresh-signal-status" data-fresh-signal-status aria-live="polite">
              Receiving {heroSignals[0].title}, {heroSignals[0].frequency}.
            </p>
          </figure>
        </section>

        <SuperAuthRibbon />
        <SuperFollowRibbon />

        <section
          class="fresh-current"
          aria-labelledby="fresh-current-title"
          data-home-freshness={HOME_FRESH_FEATURE.publishedAt}
          data-today-signal
          data-archive-at={BELLS_BLOOM_ARCHIVE_AT}
        >
          <a class="fresh-current__image" href={BELLS_BLOOM_SHOWCAST_HREF} data-today-signal-link>
            <img
              src={activeTransmission.image}
              alt={activeTransmission.alt}
              width="1024"
              height="1024"
              loading="eager"
              data-today-signal-image
            />
            <span class="fresh-current__stamp">
              <span class="fresh-current__pulse" aria-hidden="true"></span>
              <span data-today-signal-label>{bellsBloomIsArchive ? 'Recent transmissions' : 'Today’s signal'}</span>
            </span>
          </a>

          <div class="fresh-current__copy">
            <div>
              <p class="fresh-current__kicker" data-today-signal-kicker>
                {bellsBloomIsArchive ? 'Bells / Bloom · recent transmissions' : 'Bell of the day · 08:08 PT'}
              </p>
              <h2 id="fresh-current-title" data-today-signal-title>{activeTransmission.title}</h2>
              <p class="fresh-current__dek" data-today-signal-dek>{activeTransmissionDescription}</p>
            </div>

            <div>
              <ul class="fresh-current__facts" aria-label="Showcast details">
                <li data-today-signal-date>{activeTransmission.dateLabel}</li>
                <li data-today-signal-count>Bell {activeTransmission.id} / 28</li>
                <li data-today-signal-mode>{bellsBloomIsArchive ? '7 transmissions' : 'Changes daily'}</li>
              </ul>
              <div class="fresh-current__actions">
                <a class="fresh-button fresh-button--primary" href={BELLS_BLOOM_SHOWCAST_HREF}>Enter the showcast</a>
                <a class="fresh-current__text-link" href={`/b/${HOME_FRESH_FEATURE.blockId}`}>
                  Block {HOME_FRESH_FEATURE.blockId}
                </a>
                <a class="fresh-current__text-link" href={BELLS_BLOOM_MANIFEST_HREF}>JSON</a>
              </div>
            </div>
          </div>

          <div class="fresh-current__rail" aria-label="Bells / Bloom transmission calendar">
            <p data-today-signal-rail-label>{bellsBloomIsArchive ? 'Recent transmissions' : 'This week at 08:08 PT'}</p>
            <div>
              {BELLS_BLOOM_TRANSMISSIONS.map((transmission, transmissionIndex) => (
                <button
                  type="button"
                  data-today-signal-select={transmissionIndex}
                  aria-label={`Preview ${transmission.title}, bell ${transmission.id} of 28`}
                  aria-pressed={transmission.id === activeTransmission.id ? 'true' : 'false'}
                >
                  <span>{transmission.dateLabel.split(' · ')[0]}</span>
                  <strong>{transmission.id}</strong>
                </button>
              ))}
            </div>
          </div>
        </section>

        {latestBlock && showLatestShip && (
          <aside class="fresh-signal" aria-label="Latest PointCast ship">
            <span class="fresh-signal__label">Latest ship</span>
            <span class="fresh-signal__copy">
              <strong>{latestBlock.data.title}</strong>
              <span>
                CH.{latestBlock.data.channel} · Block {latestBlock.data.id} · {prettyShipTime(latestBlock.data.timestamp)}
              </span>
            </span>
            <a class="fresh-signal__open" href={`/b/${latestBlock.data.id}`}>Open +</a>
          </aside>
        )}

        <section class="fresh-section" aria-labelledby="fresh-bells-title">
          <div class="fresh-section-heading">
            <div>
              <p class="fresh-section-heading__kicker">New this weekend · the bell wing</p>
              <h2 id="fresh-bells-title">Two rooms, twelve bells.</h2>
            </div>
            <p class="fresh-section-heading__note">
              The same pentatonic wall, two kinds of together: ring it live
              with whoever is standing here, or leave a phrase hanging for
              whoever comes next. Nothing you play can be wrong.
            </p>
          </div>

          <div class="fresh-bells">
            <a class="fresh-bell-room" href="/bell-choir">
              <img
                class="fresh-bell-room__image"
                src="/images/og-bell-choir.png"
                alt="Bell Choir — five Midjourney bouquets hanging from a beam over the words a bell wall you play together"
                width="1200"
                height="630"
                loading="lazy"
              />
              <span class="fresh-bell-room__meta">
                <span>CH.GDN · 0496</span>
                <span class="fresh-bell-room__live">● LIVE ROOM</span>
              </span>
              <span class="fresh-bell-room__copy">
                <h3>Bell Choir — play it together, now.</h3>
                <p>
                  Everyone in the room hears every bell you ring, and everyone
                  is a Noun. When it's quiet, the wall replays the last
                  visitors — you're never alone in there, just early.
                </p>
              </span>
              <span class="fresh-bell-room__action">Step into the room ↗</span>
            </a>

            <a class="fresh-bell-room" href="/bell-post">
              <img
                class="fresh-bell-room__image"
                src="/images/og-bell-post.png"
                alt="Bell Post — four bouquet cards hanging from a rail over the words leave a phrase hanging for whoever comes next"
                width="1200"
                height="630"
                loading="lazy"
              />
              <span class="fresh-bell-room__meta">
                <span>CH.GDN · 0505</span>
                <span>PHRASE RACK</span>
              </span>
              <span class="fresh-bell-room__copy">
                <h3>Bell Post — leave one for the next visitor.</h3>
                <p>
                  Play a few bells and hang them on the rack for a week. THE
                  ROUND braids the last five visitors into one piece of music
                  that can't clash.
                </p>
              </span>
              <span class="fresh-bell-room__action">Hang a phrase ↗</span>
            </a>
          </div>
        </section>

        <section class="fresh-section" id="fresh-doors" aria-labelledby="fresh-doors-title">
          <div class="fresh-section-heading">
            <div>
              <p class="fresh-section-heading__kicker">Start smaller</p>
              <h2 id="fresh-doors-title">Choose one door.</h2>
            </div>
            <p class="fresh-section-heading__note">
              The full archive is still here. The front door only needs to make
              the first good choice obvious.
            </p>
          </div>

          <div class="fresh-doors">
            <a class="fresh-door fresh-door--now" href="/now">
              <span class="fresh-door__top">
                <span class="fresh-door__number">01</span>
                <span>/now ↗</span>
              </span>
              <span class="fresh-door__body">
                <h3>See what is live.</h3>
                <p>Today’s broadcast, current rooms, active projects, and the shortest path to what changed.</p>
              </span>
            </a>
            <a class="fresh-door fresh-door--play" href="/win95-games">
              <span class="fresh-door__top">
                <span class="fresh-door__number">02</span>
                <span>/play ↗</span>
              </span>
              <span class="fresh-door__body">
                <h3>Play something.</h3>
                <p>Nouns games, browser instruments, races, cards, drums, and small public rooms.</p>
              </span>
            </a>
            <a class="fresh-door fresh-door--local" href="/network-el-segundo">
              <span class="fresh-door__top">
                <span class="fresh-door__number">03</span>
                <span>/local ↗</span>
              </span>
              <span class="fresh-door__body">
                <h3>Join the signal.</h3>
                <p>Network El Segundo, civic objects, shared light, and experiments that start close to home.</p>
              </span>
            </a>
          </div>
        </section>

        <section class="fresh-section fresh-qwen-section" aria-labelledby="fresh-qwen-title">
          <a class="fresh-qwen-feature" href="/qwen-weather">
            <span class="fresh-qwen-feature__media">
              <img
                class="fresh-qwen-feature__image"
                src={qwenWeatherArtwork.src}
                alt="A translucent flower-cloud holding blue rain, a barometer, and a miniature sun over a reflective black salt flat"
                width="1920"
                height="1920"
                loading="lazy"
              />
              <span class="fresh-qwen-feature__wash" aria-hidden="true"></span>
            </span>
            <span class="fresh-qwen-feature__topline">
              <span>PointCast Model Study 001</span>
              <span>Block 0494 · CH.FD</span>
            </span>
            <span class="fresh-qwen-feature__copy">
              <span class="fresh-qwen-feature__eyebrow">QwenCloud model relay</span>
              <h2 id="fresh-qwen-title">One forecast.<br />Four model minds.</h2>
              <p>
                Qwen 3.8 wrote it. GLM-5.2 answered. Wan 2.7 imagined the
                organism. HappyHorse gave it motion—and generated its sound.
              </p>
              <span class="fresh-qwen-feature__models" aria-label="QwenCloud models used">
                <span>Qwen 3.8 Max</span>
                <span>GLM-5.2</span>
                <span>Wan 2.7 Image Pro</span>
                <span>HappyHorse 1.1</span>
              </span>
            </span>
            <span class="fresh-qwen-feature__action">Open the model study <b>↗</b></span>
          </a>
          <a class="fresh-qwen-followup" href="/qwen-silver-letter">
            <span class="fresh-qwen-followup__index">QWEN MODEL STUDY 002</span>
            <span class="fresh-qwen-followup__title">
              <b lang="zh-CN">银信气象台</b>
              <span>The Silver Letter Weather Office</span>
            </span>
            <span class="fresh-qwen-followup__note">
              Kaiping, Guangdong · community weather carried across distance
            </span>
            <span class="fresh-qwen-followup__action">Open the public instrument ↗</span>
          </a>
          <a
            class="fresh-qwen-followup fresh-qwen-followup--good"
            href="/qwen-good-intelligence"
          >
            <span class="fresh-qwen-followup__index">QWEN MODEL STUDY 003</span>
            <span class="fresh-qwen-followup__title">
              <b lang="zh-CN">善智调度局</b>
              <span>The Good Intelligence Dispatch</span>
            </span>
            <span class="fresh-qwen-followup__note">
              Kaiping + Jiangmen · pair community needs with capacity, never scores
            </span>
            <span class="fresh-qwen-followup__action">Route care, locally ↗</span>
          </a>
        </section>

        <section class="fresh-section" aria-labelledby="fresh-edit-title">
          <div class="fresh-section-heading">
            <div>
              <p class="fresh-section-heading__kicker">Four things worth opening</p>
              <h2 id="fresh-edit-title">Today’s edit.</h2>
            </div>
            <p class="fresh-section-heading__note">
              A human-sized edit from the much larger PointCast archive.
              Every item has a stable public route and machine-readable context.
            </p>
          </div>

          <div class="fresh-edit-grid">
            {stories.map((story) => (
              <a class:list={['fresh-story', { 'fresh-story--light': story.light }]} href={story.href}>
                <img
                  class="fresh-story__image"
                  src={story.image}
                  alt={story.alt}
                  width="1200"
                  height="630"
                  loading="lazy"
                />
                <span class="fresh-story__meta">
                  <span class="fresh-story__type">{story.channel}</span>
                  <span>{story.id}</span>
                </span>
                <span class="fresh-story__copy">
                  <h3>{story.title}</h3>
                  <p>{story.dek}</p>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="fresh-section" aria-labelledby="fresh-channels-title">
          <div class="fresh-section-heading">
            <div>
              <p class="fresh-section-heading__kicker">The broadcast, by frequency</p>
              <h2 id="fresh-channels-title">Tune by channel.</h2>
            </div>
            <p class="fresh-section-heading__note">
              Channel colors remain the navigation. The complete archive,
              permanent block IDs, feeds, and JSON stay one door away.
            </p>
          </div>

          <nav class="fresh-channels" aria-label="PointCast channels">
            {CHANNEL_LIST.map((channel) => (
              <a
                class="fresh-channel"
                href={`/c/${channel.slug}`}
                style={`--channel-color:${channel.color600};--channel-contrast:#fff;`}
              >
                <span class="fresh-channel__code">CH.{channel.code}</span>
                <span>
                  <strong>{channel.name}</strong>
                  <small>{channel.purpose}</small>
                </span>
                <span class="fresh-channel__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>

          <div class="fresh-archive">
            <div>
              <strong>{blockCount} blocks still live behind this door.</strong>
              <span>Search, filter, feeds, JSON, and permanent block IDs</span>
            </div>
            <a href="/archive">Open full archive +</a>
          </div>
        </section>

        <footer class="fresh-footer">
          <div>
            <p class="fresh-footer__brand">PointCast</p>
            <p class="fresh-footer__note">
              A broadcast from El Segundo for people and agents. This front door
              compresses the first visit; it does not erase the town behind it.
            </p>
          </div>
          <nav class="fresh-footer__routes" aria-label="Editorial and machine-readable endpoints">
            <a href="/now">/now</a>
            <a href="/press">/press</a>
            <a href="/archive">/archive</a>
            <a href="/blocks.json">/blocks.json</a>
            <a href="/feed.json">/feed.json</a>
            <a href="/feed.xml">/feed.xml</a>
            <a href="/agents.json">/agents.json</a>
            <a href="/signals.json">/signals.json</a>
            <a href="/for-agents">/for-agents</a>
          </nav>
        </footer>
      </div>
    </div>

    <script id="fresh-hero-signals" type="application/json" is:inline set:html={JSON.stringify(heroSignals)} />
    <script id="bells-bloom-transmissions" type="application/json" is:inline set:html={JSON.stringify(BELLS_BLOOM_TRANSMISSIONS)} />
    <script is:inline>
      (() => {
        const payload = document.querySelector('#bells-bloom-transmissions');
        const root = document.querySelector('[data-today-signal]');
        if (!(root instanceof HTMLElement)) return;

        let transmissions = [];
        try {
          transmissions = JSON.parse(payload?.textContent || '[]');
        } catch {
          return;
        }
        if (!Array.isArray(transmissions) || transmissions.length === 0) return;

        const image = root.querySelector('[data-today-signal-image]');
        const title = root.querySelector('[data-today-signal-title]');
        const dek = root.querySelector('[data-today-signal-dek]');
        const label = root.querySelector('[data-today-signal-label]');
        const kicker = root.querySelector('[data-today-signal-kicker]');
        const date = root.querySelector('[data-today-signal-date]');
        const count = root.querySelector('[data-today-signal-count]');
        const mode = root.querySelector('[data-today-signal-mode]');
        const railLabel = root.querySelector('[data-today-signal-rail-label]');
        const selectors = [...root.querySelectorAll('[data-today-signal-select]')];
        const archiveAt = Date.parse(root.dataset.archiveAt || '');
        let active = 0;
        let manuallySelected = false;

        const liveIndex = () => {
          const now = Date.now();
          let next = 0;
          transmissions.forEach((transmission, index) => {
            if (Date.parse(transmission.publishAt) <= now) next = index;
          });
          return next;
        };

        const show = (nextIndex, announce = false) => {
          active = Math.max(0, Math.min(transmissions.length - 1, nextIndex));
          const transmission = transmissions[active];
          const archived = Number.isFinite(archiveAt) && Date.now() >= archiveAt;

          if (image instanceof HTMLImageElement) {
            image.src = transmission.image;
            image.alt = transmission.alt;
          }
          if (title) title.textContent = transmission.title;
          if (dek) {
            dek.textContent = archived
              ? `Bell ${transmission.id} of 28. One of seven recent transmissions from the Bells / Bloom archive.`
              : `Bell ${transmission.id} of 28. One morning transmission from Bells / Bloom, changing daily at 8:08 PT.`;
          }
          if (label) label.textContent = archived ? 'Recent transmissions' : 'Today’s signal';
          if (kicker) kicker.textContent = archived ? 'Bells / Bloom · recent transmissions' : 'Bell of the day · 08:08 PT';
          if (date) date.textContent = transmission.dateLabel;
          if (count) count.textContent = `Bell ${transmission.id} / 28`;
          if (mode) mode.textContent = archived ? '7 transmissions' : 'Changes daily';
          if (railLabel) railLabel.textContent = archived ? 'Recent transmissions' : 'This week at 08:08 PT';
          root.dataset.archive = archived ? 'true' : 'false';

          selectors.forEach((selector, selectorIndex) => {
            selector.setAttribute('aria-pressed', selectorIndex === active ? 'true' : 'false');
          });

          if (announce) {
            if (title instanceof HTMLElement) {
              title.setAttribute('tabindex', '-1');
              title.focus({ preventScroll: true });
            }
          }
        };

        selectors.forEach((selector, selectorIndex) => {
          selector.addEventListener('click', () => {
            manuallySelected = true;
            show(selectorIndex, true);
          });
        });

        show(liveIndex());
        window.setInterval(() => {
          if (!manuallySelected) show(liveIndex());
        }, 30_000);
      })();
    </script>
    <script is:inline>
      (() => {
        const clock = document.querySelector('#fresh-clock');
        const updateClock = () => {
          if (!clock) return;
          clock.textContent = new Intl.DateTimeFormat('en-US', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: false,
            timeZone: 'America/Los_Angeles',
            timeZoneName: 'short',
          }).format(new Date());
        };
        updateClock();
        window.setInterval(updateClock, 30_000);

        const payload = document.querySelector('#fresh-hero-signals');
        let signals = [];
        try {
          signals = JSON.parse(payload?.textContent || '[]');
        } catch {
          signals = [];
        }

        const art = document.querySelector('[data-fresh-hero-art]');
        const image = document.querySelector('[data-fresh-hero-image]');
        const title = document.querySelector('[data-fresh-hero-title]');
        const index = document.querySelector('[data-fresh-hero-index]');
        const frequency = document.querySelector('[data-fresh-hero-frequency]');
        const note = document.querySelector('[data-fresh-hero-note]');
        const link = document.querySelector('[data-fresh-hero-link]');
        const button = document.querySelector('[data-fresh-shuffle]');
        const status = document.querySelector('[data-fresh-signal-status]');
        const presetButtons = [...document.querySelectorAll('[data-fresh-signal-select]')];
        let active = 0;
        let changeTimer = 0;

        const tune = (nextIndex) => {
          if (!(art instanceof HTMLElement) || !(image instanceof HTMLImageElement) || signals.length < 2) return;
          active = ((nextIndex % signals.length) + signals.length) % signals.length;
          const next = signals[active];
          art.dataset.changing = 'true';
          window.clearTimeout(changeTimer);
          changeTimer = window.setTimeout(() => {
            image.src = next.src;
            image.alt = next.alt;
            image.style.objectPosition = next.imagePosition || 'center center';
            if (title) title.textContent = next.title;
            if (index) index.textContent = `Field signal ${String(active + 1).padStart(2, '0')} / ${String(signals.length).padStart(2, '0')}`;
            if (frequency) frequency.textContent = next.frequency;
            if (note) note.textContent = next.note;
            if (link instanceof HTMLAnchorElement) link.href = next.href;
            if (status) status.textContent = `Receiving ${next.title}, ${next.frequency}. ${next.note}`;
            art.dataset.signalId = next.id;
            art.style.setProperty('--fresh-signal-color', next.color);
            document.documentElement.style.setProperty('--fresh-acid', next.color);
            presetButtons.forEach((preset, presetIndex) => {
              preset.setAttribute('aria-pressed', presetIndex === active ? 'true' : 'false');
            });
            art.dataset.changing = 'false';
          }, 120);
        };

        button?.addEventListener('click', () => tune(active + 1));
        presetButtons.forEach((preset, presetIndex) => {
          preset.addEventListener('click', () => tune(presetIndex));
        });

        art?.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          tune(active + (event.key === 'ArrowRight' ? 1 : -1));
          const nextButton = presetButtons[((active % presetButtons.length) + presetButtons.length) % presetButtons.length];
          if (nextButton instanceof HTMLButtonElement) nextButton.focus();
        });
      })();
    </script>
  </div>

  <script>
    type LiveNowPlaying = {
      title?: string;
      artist?: string;
      status?: string;
      live?: boolean;
    };
    type LiveNowWindow = Window & {
      __pointcastLiveNowTimer?: number;
    };

    function initLiveNowPlaying() {
      const root = document.querySelector<HTMLElement>('[data-live-now-playing]');
      if (!root) return;
      const liveWindow = window as LiveNowWindow;
      if (liveWindow.__pointcastLiveNowTimer) {
        window.clearInterval(liveWindow.__pointcastLiveNowTimer);
      }

      const refresh = async () => {
        try {
          const response = await fetch('/now-playing.json', {
            cache: 'no-store',
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) return;
          const playing = await response.json() as LiveNowPlaying;
          const state = root.querySelector<HTMLElement>('[data-live-now-state-text]');
          const label = root.querySelector<HTMLElement>('[data-live-now-label]');
          const title = root.querySelector<HTMLElement>('[data-live-now-title]');
          const onAir = playing.status === 'playing' && playing.live === true;
          if (state) state.textContent = onAir ? 'On air' : 'Standby';
          if (label) label.textContent = onAir ? 'Currently spinning' : 'Last signal';
          if (title && playing.title) {
            title.textContent = playing.artist
              ? `${playing.title} · ${playing.artist}`
              : playing.title;
          }
          root.dataset.state = onAir ? 'live' : 'standby';
          root.setAttribute(
            'aria-label',
            `${onAir ? 'Currently spinning' : 'Last PointCast signal'}: ${playing.title ?? 'unknown'}${playing.artist ? ` by ${playing.artist}` : ''}`,
          );
        } catch {
          // The built-in editorial signal remains visible when live auth is offline.
        }
      };

      void refresh();
      liveWindow.__pointcastLiveNowTimer = window.setInterval(refresh, 60_000);
    }

    initLiveNowPlaying();
    document.addEventListener('astro:page-load', initLiveNowPlaying);
  </script>
</BlockLayout>
