---
/**
 * Homepage v2027 — the newsroom desk.
 *
 * Rebuilt 2026-05-07 from a 2007-line additive stack of ~30 pulse modules
 * to a focused four-section editorial home. The diagnosis was: every new
 * feature got another always-on strip on `/`, so nothing felt fresh and
 * the operating mode of the project (parallel agents shipping work in
 * stages) was invisible.
 *
 * The new layout, top to bottom:
 *
 *   1. THE LEAD          — single editorial hero, one big headline,
 *                           time-of-day kicker, latest-block-as-content.
 *   2. OPERATING MODE    — three columns: WHAT'S IN FLIGHT (open PRs,
 *                           drafts) · JUST LANDED (last 3 ships) ·
 *                           HEARTBEAT (today/week/total counts).
 *   3. TODAY / THIS WEEK — proper editorial cards, not pulse strips.
 *                           Three columns max. Recent first.
 *   4. ARCHIVE TEASER    — link into the giant chronological scroll
 *                           (Wave 2 — mile markers, sticky date anchor,
 *                           lazy chunks).
 *
 * The persistent live element (presence, ROOM/ASK/CAST, ON AIR) stays in
 * the existing FooterBar in BlockLayout — no changes there.
 *
 * Pulse modules removed from this page (TideSurf, SportsTicker,
 * AltarsPulse, QuintetPulseModule, ProcessionPulseModule,
 * OfferingsPulseModule, ChamberMega, WingPulseModule, NetworkStrip,
 * NatureFieldDeskStrip, etc.) still live at their own routes. They aren't
 * deleted; they just stop competing for the homepage.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import BlockCard from '../components/BlockCard.astro';
import { getCollection } from 'astro:content';
import { CHANNELS } from '../lib/channels';
import opmodeData from '../data/operating-mode.json';
import shipsData from '../data/recent-ships.json';
import asksData from '../data/asks.json';
import learningsData from '../data/learning-notes.json';
import morningHeroData from '../data/morning-hero.json';
import shipsStoriesData from '../data/recent-ships-stories.json';
import HomeCheckinHint from '../components/HomeCheckinHint.astro';
import HomePlacesDirectory from '../components/HomePlacesDirectory.astro';

// ---------- Data: blocks ----------
const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const sevenDaysAgo = new Date(startOfToday);
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);

const todayBlocks = allBlocks.filter(b => new Date(b.data.timestamp) >= startOfToday);
const weekBlocks  = allBlocks.filter(b => new Date(b.data.timestamp) >= sevenDaysAgo);

const justLanded = allBlocks.slice(0, 3);
const blockCount = allBlocks.length;

// First block ever (for the archive teaser "since" date).
const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

// ---------- Data: lead ----------
// The lead is whatever the LATEST thing we shipped is — block OR feature
// PR, whichever is newer. Mike 2026-05-08: "kinda not fresh" — the
// homepage looked stale because the lead was a 1-day-old block while
// 12 feature PRs had landed since. Ship-as-lead fixes that — every PR
// I merge auto-becomes the lead until the next thing lands.
const latestBlock = allBlocks[0];
// `ships` is parsed below — we forward-declare the picked lead
// variables and resolve them after ships exists. Done as a thunk to
// keep the data section logically grouped.

function timeOfDayKicker(d: Date): string {
  const h = d.getHours();
  if (h >= 5 && h < 11)  return 'MORNING DESK';
  if (h >= 11 && h < 17) return 'MIDDAY · SHIP ROOM';
  if (h >= 17 && h < 22) return 'EVENING DISPATCH';
  return 'OVERNIGHT BUILD';
}

const todayStr = now.toISOString().slice(0, 10);
const todayKicker = timeOfDayKicker(now);

// ---------- Data: opmode ----------
interface InFlightItem {
  id: string;
  title: string;
  kind: string;
  ref: string;
  url: string | null;
  owner: string;
  stage: string;
}
const opmode = opmodeData as {
  updatedAt: string;
  updatedBy: string;
  inFlight: InFlightItem[];
};

interface ShipItem {
  ref: string;
  title: string;
  href: string;
  tag: string;
  at: string;
}
const ships = (shipsData as { updatedAt: string; updatedBy: string; ships: ShipItem[] }).ships
  .slice()
  .sort((a, b) => +new Date(b.at) - +new Date(a.at));
// Group shipped-today vs shipped-earlier-this-week for visual emphasis.
const shipsToday = ships.filter(s => new Date(s.at) >= startOfToday);
const shipsEarlier = ships.filter(s => new Date(s.at) < startOfToday).slice(0, 4);

// ---------- LEAD: article quality gate (Mike 2026-05-12 sprint PR 5) ----------
// Mike: "articles are eh." Default behavior was that any newer block
// of any kind claimed the hero — even generic agent-authored content.
// Fix: only blocks with `featured: true` in frontmatter can claim the
// LEAD over a ship. Everything else is honored in /archive but doesn't
// own the front door.
//
// Resolution chain (after Morning Hero):
//   1. ship vs featured-block, whichever is newer
//   2. if no featured block and no ship → fall back to latest block
//   3. if literally nothing → no lead rendered
const latestShip = ships[0] || null;
const latestShipAt = latestShip ? +new Date(latestShip.at) : 0;

const latestFeaturedBlock = allBlocks.find(b => b.data.featured === true) || null;
const latestFeaturedAt = latestFeaturedBlock ? +new Date(latestFeaturedBlock.data.timestamp) : 0;

// Last-resort fallback only if no ship + no featured block exists.
const latestBlockAt = latestBlock ? +new Date(latestBlock.data.timestamp) : 0;

// Pick the lead source.
const useShipAsLead = !!latestShip && latestShipAt >= latestFeaturedAt;
const useFeaturedBlockAsLead = !useShipAsLead && !!latestFeaturedBlock;
const useLastResortBlockAsLead = !useShipAsLead && !useFeaturedBlockAsLead && !!latestBlock;

// The block that gets rendered IF a block path wins. Prefer featured.
const lead = useFeaturedBlockAsLead ? latestFeaturedBlock : (useLastResortBlockAsLead ? latestBlock : null);
const leadKicker = `${todayKicker} · ${todayStr}`;
const leadChannel = lead ? CHANNELS[lead.data.channel] : null;
const leadHref = lead?.data.external?.url
  || (lead ? `/b/${lead.data.id}` : '#');
const leadCta = (lead?.data.external?.label
  || (lead?.data.type === 'READ' ? 'read the brief' : 'open block')) + ' →';

// Ship-lead variables (used when useShipAsLead is true).
const shipLead = latestShip;
const shipLeadKicker = shipLead
  ? `${todayKicker} · ${todayStr} · FRESH SHIP ${shipLead.ref} · ${shipLead.tag}`
  : '';

// ---------- Data: morning hero ----------
// Mike 2026-05-12: "when i say check in the morning, it should be
// interesting and its ok, hasn't been". The Morning Hero replaces the
// homepage LEAD when there's a curated entry for today — image-led,
// real-voice editorial, one specific thing to try. Falls back to the
// ship-or-block LEAD when no entry for today exists.
interface MorningPost {
  date: string;
  kicker: string;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  cta: string;
  ctaHref: string;
  secondaryCta?: string;
  secondaryHref?: string;
  byline?: string;
}
const morningPosts = (morningHeroData as { posts: MorningPost[] }).posts;
const morningHero = morningPosts.find((p) => p.date === todayStr) || null;

// ---------- Data: ships as stories ----------
// Mike 2026-05-12: "all the work highlights aren't resonating". Ships
// now render as paragraphs with images instead of ref-rows. This is
// the editorial format; the brief recent-ships.json stays as the
// metadata feed for agents.
interface ShipStory {
  ref: string;
  tag: string;
  at: string;
  title: string;
  body: string;
  image?: string;
  tryHref: string;
  tryLabel: string;
}
const shipStories = (shipsStoriesData as { stories: ShipStory[] }).stories
  .slice()
  .sort((a, b) => +new Date(b.at) - +new Date(a.at))
  .slice(0, 6);

// ---------- Data: asks (daily rotation) ----------
// All asks render in the page; client-side JS picks today's by
// day-of-year. Keeps the homepage feeling alive between deploys —
// even if we don't ship for a few days, the visible ask still rotates.
interface Ask {
  id: string;
  title: string;
  body: string;
  cta: string;
  ctaLabel: string;
  tag: string;
}
const asks = (asksData as { asks: Ask[] }).asks;

// ---------- Data: learning notes ----------
interface Note { id: string; at: string; title: string; body: string; }
const learnings = (learningsData as { updatedAt: string; updatedBy: string; notes: Note[] }).notes;
const recentLearnings = learnings.slice(0, 5);

// ---------- Momentum stats ----------
// Compute "ship days in last 14" from blocks + recent-ships (so feature
// PRs that aren't blocks still count). This is the editorial momentum
// stat surfaced on the homepage HEARTBEAT — meaningful even at zero
// traffic because it's about WHAT WE SHIPPED, not who saw it.
const fourteenDaysAgo = new Date(startOfToday);
fourteenDaysAgo.setDate(fourteenDaysAgo.getDate() - 13);

const dayKeysShipped = new Set<string>();
for (const b of allBlocks) {
  const d = new Date(b.data.timestamp);
  if (d >= fourteenDaysAgo) dayKeysShipped.add(d.toISOString().slice(0, 10));
}
for (const s of ships) {
  const d = new Date(s.at);
  if (d >= fourteenDaysAgo) dayKeysShipped.add(d.toISOString().slice(0, 10));
}
const shipDays14 = dayKeysShipped.size;

// Consecutive ship streak: walk back from today, stop at the first
// gap-day. Counts both blocks and ships so a feature-only day still
// keeps the streak alive.
let shipStreak = 0;
{
  const cursor = new Date(startOfToday);
  while (true) {
    const key = cursor.toISOString().slice(0, 10);
    if (!dayKeysShipped.has(key)) break;
    shipStreak++;
    cursor.setDate(cursor.getDate() - 1);
  }
}

// PRs in recent-ships.json shipped in the last 7 days.
const sevenDaysAgoTs = +sevenDaysAgo;
const shipsLast7 = ships.filter(s => +new Date(s.at) >= sevenDaysAgoTs).length;

function fmtRelative(iso: string): string {
  const t = new Date(iso);
  const diffMs = +now - +t;
  if (diffMs < 0) return 'just now';
  const m = Math.round(diffMs / 60000);
  if (m < 60)   return `${m}m ago`;
  const h = Math.round(m / 60);
  if (h < 24)   return `${h}h ago`;
  const d = Math.round(h / 24);
  if (d < 30)   return `${d}d ago`;
  return t.toISOString().slice(0, 10);
}

// ---------- SEO / layout props ----------
const title = 'PointCast — agent-native broadcast from El Segundo';
const description = lead?.data.dek
  ? `Latest: ${lead.data.dek} · ${blockCount} blocks since ${sinceDate}.`
  : `An agent-native broadcast from El Segundo. ${blockCount} blocks and counting.`;

// Schema.org graph: Organization (the project) + WebSite (the surface) +
// CollectionPage (this homepage). Multi-node graph so /agents and search
// crawlers see the full publishing entity, not just a page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://pointcast.xyz/#org',
      name: 'PointCast',
      alternateName: 'University of El Segundo',
      url: 'https://pointcast.xyz',
      description: 'Agent-native broadcast from El Segundo. Parallel civic infrastructure built block by block.',
      foundingDate: sinceDate,
      areaServed: { '@type': 'Place', name: 'El Segundo, California (25-mile radius)' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://pointcast.xyz/#site',
      url: 'https://pointcast.xyz',
      name: 'PointCast',
      publisher: { '@id': 'https://pointcast.xyz/#org' },
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://pointcast.xyz/archive?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://pointcast.xyz/#home',
      url: 'https://pointcast.xyz/',
      name: title,
      description,
      isPartOf: { '@id': 'https://pointcast.xyz/#site' },
      publisher: { '@id': 'https://pointcast.xyz/#org' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: blockCount,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        name: `${blockCount} blocks since ${sinceDate}`,
      },
    },
  ],
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="home2027">

    {/* ============== 1. THE LEAD ==============
       v3: when there's a Morning Hero entry for today, render IT.
       Mike 2026-05-12: "the morning experience isn't interesting,
       articles are eh, surfacing isn't capturing the depth." The
       Morning Hero is image-led with two-sentence human-voice editorial
       and one specific thing to try — a story, not a ref-list.
       Falls back to the ship-or-block LEAD when no entry for today. */}
    {morningHero ? (
      <section class="morn" aria-label="Today's hero">
        <a class="morn__imgwrap" href={morningHero.ctaHref}>
          <img class="morn__img" src={morningHero.image} alt={morningHero.imageAlt} loading="eager" />
        </a>
        <div class="morn__body">
          <p class="morn__kicker mono">{morningHero.kicker}</p>
          <h1 class="morn__title">{morningHero.title}</h1>
          <p class="morn__body-text">{morningHero.body}</p>
          <div class="morn__row">
            <a class="morn__cta" href={morningHero.ctaHref}>{morningHero.cta} →</a>
            {morningHero.secondaryCta && morningHero.secondaryHref && (
              <a class="morn__alt" href={morningHero.secondaryHref}>{morningHero.secondaryCta} →</a>
            )}
            {morningHero.byline && (
              <span class="morn__by mono">by <strong>{morningHero.byline}</strong></span>
            )}
          </div>
        </div>
      </section>
    ) : useShipAsLead && shipLead ? (
      <section class="lead lead--ship" style="--ch-600: #c4952e; --ch-50: #fffaf0;">
        <p class="lead__kicker">{shipLeadKicker}</p>
        <h1 class="lead__title">{shipLead.title}</h1>
        <div class="lead__row">
          <a class="lead__cta" href={shipLead.href}>open it →</a>
          <a class="lead__alt" href="https://github.com/mhoydich/pointcast/pulls?q=is%3Apr+is%3Amerged">all PRs →</a>
          <span class="lead__by">
            by <strong>cc</strong>
            <span class="lead__dot">·</span>
            <time datetime={shipLead.at}>{fmtRelative(shipLead.at)}</time>
          </span>
        </div>
        {latestBlock && (
          <p class="lead__alt-block">
            ↓ latest content block: <a href={`/b/${latestBlock.data.id}`}>/{latestBlock.data.id} — {latestBlock.data.title}</a>
            <span class="lead__dot">·</span>
            <time datetime={latestBlock.data.timestamp}>{fmtRelative(latestBlock.data.timestamp)}</time>
          </p>
        )}
      </section>
    ) : lead && (
      <section
        class="lead"
        style={`--ch-600: ${leadChannel?.color600 || '#1f1b15'}; --ch-50: ${leadChannel?.color50 || '#f5efe4'};`}
      >
        <p class="lead__kicker">{leadKicker} · CH.{lead.data.channel} · /{lead.data.id}</p>
        <h1 class="lead__title">{lead.data.title}</h1>
        {lead.data.dek && <p class="lead__dek">{lead.data.dek}</p>}
        <div class="lead__row">
          <a class="lead__cta" href={leadHref}>{leadCta}</a>
          {lead.data.external?.url && <a class="lead__alt" href={`/b/${lead.data.id}`}>open block →</a>}
          <span class="lead__by">
            by <strong>{lead.data.author || 'mh'}</strong>
            <span class="lead__dot">·</span>
            <time datetime={lead.data.timestamp}>{fmtRelative(lead.data.timestamp)}</time>
          </span>
        </div>
      </section>
    )}

    {/* ============== 1b. CHECK-IN HINT (returning visitors only) ==========
       Renders nothing for first-timers (no localStorage state). Clients
       with a /me state see a one-line "you're checked in / you haven't
       checked in" affordance with a link into /me. The component swaps
       in client-side from localStorage so the static HTML stays
       cacheable and the build doesn't differ per-visitor. */}
    <HomeCheckinHint />

    {/* ============== 1c. TODAY'S ASK (daily rotation) ==============
       Mike 2026-05-08: "create a system to keep the homepage fresh and
       active, like requesting people build inventory". All asks bake
       into the HTML; client-side JS picks today's by day-of-year so
       the visible ask rotates even between deploys. JS-off visitors
       see the first ask. Single CTA per ask — primary action, not
       a list. */}
    {asks.length > 0 && (
      <section class="ask" aria-label="Today's ask">
        <div class="ask__head">
          <p class="kicker">TODAY · ONE THING TO DO</p>
          <span class="ask__rotates mono">rotates daily · {asks.length} on tap</span>
        </div>
        <div class="ask__cards" id="ask-cards">
          {asks.map((a, i) => (
            <article class={`ask__card${i === 0 ? '' : ' ask__card--hidden'}`} data-ask-idx={i}>
              <div class="ask__card-row">
                <span class="ask__tag" data-tag={a.tag}>{a.tag}</span>
                <h3 class="ask__title">{a.title}</h3>
              </div>
              <p class="ask__body">{a.body}</p>
              <a class="ask__cta" href={a.cta}>{a.ctaLabel} →</a>
            </article>
          ))}
        </div>
        <script is:inline>
          (() => {
            // Day-of-year → consistent for all visitors today, rotates
            // overnight. UTC so timezone doesn't fragment the rotation.
            const cards = document.querySelectorAll('[data-ask-idx]');
            if (!cards.length) return;
            const day = Math.floor(Date.now() / 86400000);
            const pick = day % cards.length;
            cards.forEach((c, i) => {
              if (i === pick) c.classList.remove('ask__card--hidden');
              else c.classList.add('ask__card--hidden');
            });
          })();
        </script>
      </section>
    )}

    {/* ============== 2. OPERATING MODE ============== */}
    <section class="opmode" aria-label="Operating mode">
      <header class="opmode__head">
        <p class="kicker">OPERATING MODE</p>
        <span class="opmode__updated">updated {fmtRelative(opmode.updatedAt)} by {opmode.updatedBy}</span>
      </header>
      <div class="opmode__grid">

        <div class="opmode__col opmode__col--flight">
          <h3 class="opmode__h">IN FLIGHT</h3>
          <ul class="flight">
            {opmode.inFlight.length === 0 && (
              <li class="flight__empty">no work currently in flight.</li>
            )}
            {opmode.inFlight.map(f => (
              <li class="flight__row">
                <a href={f.url || '#'} class="flight__link">
                  <span class={`flight__kind flight__kind--${f.kind.toLowerCase()}`}>
                    {f.kind}{f.ref !== 'tbd' ? ` ${f.ref}` : ''}
                  </span>
                  <span class="flight__title">{f.title}</span>
                </a>
                <span class="flight__meta">{f.owner} · {f.stage}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="opmode__col opmode__col--landed">
          <h3 class="opmode__h">JUST LANDED</h3>
          <ul class="landed">
            {justLanded.map(b => (
              <li class="landed__row">
                <a href={`/b/${b.data.id}`} class="landed__link">
                  <span class="landed__id">/{b.data.id}</span>
                  <span class="landed__title">{b.data.title}</span>
                </a>
                <span class="landed__meta">CH.{b.data.channel} · {fmtRelative(b.data.timestamp)}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="opmode__col opmode__col--heartbeat">
          <h3 class="opmode__h">HEARTBEAT</h3>
          <dl class="heartbeat">
            <div class="heartbeat__stat">
              <dt>{shipStreak}</dt>
              <dd>day ship streak</dd>
            </div>
            <div class="heartbeat__stat">
              <dt>{shipDays14}<span class="heartbeat__denom">/14</span></dt>
              <dd>ship days · last 14</dd>
            </div>
            <div class="heartbeat__stat">
              <dt>{shipsLast7}</dt>
              <dd>feature PRs · last 7d</dd>
            </div>
            <div class="heartbeat__stat">
              <dt>{blockCount}</dt>
              <dd>blocks total</dd>
            </div>
          </dl>
          <p class="heartbeat__since">
            since <time datetime={sinceDate}>{sinceDate}</time> ·
            <span class="heartbeat__editorial">no traffic yet, still getting better every day</span>
          </p>
        </div>

      </div>
    </section>

    {/* ============== 2b. RECENT SHIPS — AS STORIES ==============
       Mike 2026-05-12: "all the work highlights aren't resonating".
       Each ship is now a paragraph with an image + a TRY action,
       not a ref-row. Sourced from src/data/recent-ships-stories.json.
       The brief recent-ships.json stays as the metadata feed for
       agents (see operating-mode.json + ships rendering elsewhere). */}
    {shipStories.length > 0 && (
      <section class="story-feed" aria-label="Recent ships as stories">
        <header class="story-feed__head">
          <p class="kicker">RECENT · WHAT WE SHIPPED</p>
          <a href="https://github.com/mhoydich/pointcast/pulls?q=is%3Apr+is%3Amerged" class="story-feed__cta">all PRs →</a>
        </header>

        <ol class="story-feed__list">
          {shipStories.map((s) => (
            <li class="story">
              {s.image && (
                <a class="story__imgwrap" href={s.tryHref}>
                  <img class="story__img" src={s.image} alt={s.title} loading="lazy" />
                </a>
              )}
              <div class="story__body">
                <header class="story__head">
                  <span class="story__ref mono">{s.ref}</span>
                  <span class="story__tag mono" data-tag={s.tag}>{s.tag}</span>
                  <span class="story__when mono">{fmtRelative(s.at)}</span>
                </header>
                <h3 class="story__title">{s.title}</h3>
                <p class="story__body-text">{s.body}</p>
                <a class="story__try" href={s.tryHref}>{s.tryLabel} →</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {/* ============== 2c. LEARNING NOTES ==============
       Hand-curated "what we figured out lately" — editorial signal that
       even at zero traffic, the project is improving. From
       src/data/learning-notes.json. Cap at 5 visible. New notes go on
       top in the file; older ones stay in the file but drop off the
       homepage. */}
    {recentLearnings.length > 0 && (
      <section class="learnings" aria-label="Recent learnings">
        <header class="learnings__head">
          <p class="kicker">RECENT LEARNINGS · what we figured out</p>
          <span class="learnings__cta mono">we are getting better and better</span>
        </header>
        <ul class="learnings__list">
          {recentLearnings.map(n => (
            <li class="learning">
              <p class="learning__title">{n.title}</p>
              <p class="learning__body">{n.body}</p>
              <p class="learning__at mono">{n.at}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ============== 3. TODAY ============== */}
    {todayBlocks.length > 0 && (
      <section class="band" id="today" aria-label="Today">
        <header class="band__head">
          <p class="kicker">TODAY · {todayStr}</p>
          <span class="band__count">{todayBlocks.length} block{todayBlocks.length === 1 ? '' : 's'}</span>
        </header>
        <div class="band__grid">
          {todayBlocks.slice(0, 6).map(block => <BlockCard block={block} />)}
        </div>
      </section>
    )}

    {/* ============== 3b. THIS WEEK ============== */}
    {weekBlocks.length > todayBlocks.length && (
      <section class="band" id="week" aria-label="This week">
        <header class="band__head">
          <p class="kicker">THIS WEEK</p>
          <span class="band__count">{weekBlocks.length - todayBlocks.length} more in last 7 days</span>
        </header>
        <div class="band__grid">
          {weekBlocks.slice(todayBlocks.length, todayBlocks.length + 9).map(block => (
            <BlockCard block={block} />
          ))}
        </div>
      </section>
    )}

    <section class="arcade-callout" aria-label="Retro Arcade">
