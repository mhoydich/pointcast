    display: flex;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    color: var(--pc-ink);
  }

  .discovery-proof a:hover { color: #0f6e56; text-decoration: none; }
  .discovery-proof a strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
  .discovery-proof a span { color: var(--pc-ink-soft); font-size: 12px; white-space: nowrap; }

  .broadcast-lower {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: end;
    margin: 34px 0 12px;
    padding-top: 16px;
    border-top: 2px solid var(--pc-ink);
