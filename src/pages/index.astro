      description: 'A four-voice playable drum garden and sixteen-step sequencer. The pads sit on the front door; the full garden lives at /rosebud.',
    },
    { '@type': 'Periodical', '@id': 'https://pointcast.xyz/25/magazine#publication', name: 'PointCast College Football', url: 'https://pointcast.xyz/25/magazine' },
    { '@type': 'Periodical', '@id': 'https://pointcast.xyz/worklife#publication', name: 'WORK/LIFE', url: 'https://pointcast.xyz/worklife' },
    { '@type': 'Periodical', '@id': 'https://pointcast.xyz/wednesday#publication', name: 'WEDNESDAY 9:34', url: 'https://pointcast.xyz/wednesday' },
    { '@type': 'Periodical', '@id': 'https://pointcast.xyz/beach-commons#publication', name: 'Beach Commons', url: 'https://pointcast.xyz/beach-commons' },
  ],
};

const alternates = [
  { type: 'application/json', href: '/blocks.json', title: 'All blocks (JSON)' },
  { type: 'application/rss+xml', href: '/feed.xml', title: 'PointCast RSS' },
  { type: 'application/feed+json', href: '/feed.json', title: 'PointCast JSON Feed' },
  ...CHANNEL_LIST.map((channel) => ({
    type: 'application/rss+xml',
    href: `/c/${channel.slug}.rss`,
    title: `PointCast · ${channel.name}`,
  })),
];
---

<BlockLayout
  title="Home"
  description={homeDescription}
  image={socialImage}
  imageWidth={1200}
  imageHeight={630}
  themeColor="#185FA5"
  jsonLd={jsonLd}
  alternates={alternates}
  immersive={false}
  showNetworkStrip={false}
  frame={{
    image: socialImage,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Play Rosebud', action: 'link', target: 'https://pointcast.xyz/rosebud' },
      { label: 'Read the magazine', action: 'link', target: 'https://pointcast.xyz/25/magazine' },
      { label: 'For agents', action: 'link', target: 'https://pointcast.xyz/for-agents' },
    ],
  }}
>
  <div class="home" data-front-door>
    <header class="masthead" aria-label="PointCast masthead">
      <a class="masthead__brand" href="/" aria-label="PointCast home">PointCast</a>
      <p class="masthead__meta">
        <span>{blockCount} blocks</span>
        <span>El Segundo · 33.92°N 118.42°W</span>
        <span id="home-clock">—:— PT</span>
        <span class="masthead__air" data-live-now-playing hidden>on air · <b data-live-now-title></b></span>
      </p>
      <nav class="masthead__utility" aria-label="Quick exits">
        <span class="masthead__wallet"><WalletChip /></span>
        <a href="/now">Now</a>
        <a href="/rooms">Rooms</a>
        <a href="/archive">Archive</a>
        <a href="/for-agents">For agents</a>
      </nav>
    </header>

    <HomePlayFirst taps={PINNED.drumTaps} blockCount={blockCount} />

    <div id="start-here">
      <HomeStartHere blockCount={blockCount} />
    </div>

    <HomeGlance numbers={glance} asOf={builtOn} />

    <HomeMagazineRack covers={covers} volumes={beachCommonsVolumes} editorialBlocksSinceJuly={editorialBlocksSinceJuly} latestId={latestId} />

    <HomeDrumUniverse families={drumFamilies} games={drumGames} rooms={drumRooms} taps={PINNED.drumTaps} pages={drumPages} doors={drumDoors} />

    <HomeRoomsShelf rooms={rooms} />

    <HomeConstellation satellites={satellites} contracts={contracts} countedAt={PINNED.countedAt} />

    <HomeAgentDesk surfaces={agentSurfaces} residents={residents} evidence={evidence} />

    <HomeShipLog milestones={milestones} totals={shipTotals} prsByMonth={PINNED.prsByMonth} blocksByMonth={blocksByMonth} authors={authors} imported={blocksImported} />

    <HomeScoreboard />

    <HomeWire latest={latestWire} total={blockCount} sinceLabel={sinceLabel} />

    <HomeBackCatalog pool={catalogPool} total={blockCount} />

    <section class="shelf channels" id="channels" aria-labelledby="channels-title" style="--shelf-color:#12110E;--shelf-color-2:#185FA5">
      <div class="shelf__head">
        <div>
          <p class="shelf__kicker">Channels · {CHANNEL_LIST.length} codes · {CHANNEL_LIST.length} colors · {CHANNEL_LIST.length} feeds</p>
          <h2 class="shelf__title" id="channels-title">Ten lanes, <em>one grammar.</em></h2>
          <p class="shelf__dek">Front Door for agent-era thinking, Garden for quiet noticing. Court for pickleball, Spinning for music, El Segundo for the town itself. Each has a code, a color, and an RSS feed. No eleventh without Mike.</p>
        </div>
        <div class="shelf__actions">
          <a href="/moods">Moods</a>
          <a href="/random">A random door</a>
        </div>
      </div>
      <nav class="channels__grid" aria-label="PointCast channels">
        {CHANNEL_LIST.map((channel) => (
          <a class="channels__cell" href={`/c/${channel.slug}`} style={`--ch:${channel.color600};--ch-bg:${channel.color50};--ch-ink:${channel.color800}`}>
            <span class="channels__code">CH.{channel.code}</span>
            <strong>{channel.name}</strong>
            <small>{channel.purpose}</small>
            <span class="channels__feeds"><span>{allBlocks.filter((b) => b.data.channel === channel.code).length} blocks</span> · JSON · RSS</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="shelf machine" aria-labelledby="machine-title" style="--shelf-color:#185FA5;--shelf-color-2:#993C1D">
      <div class="shelf__head shelf__head--stack">
        <div>
          <p class="shelf__kicker">Editorial and machine-readable endpoints · every page has a JSON twin</p>
          <h2 class="shelf__title" id="machine-title">Read it however <em>you read.</em></h2>
        </div>
      </div>
      <ul class="machine__list">
        <li><a href="/press">/press</a><span>the press wire</span></li>
        <li><a href="/archive">/archive</a><span>every block, newest first</span></li>
        <li><a href="/blocks.json">/blocks.json</a><span>the whole archive as JSON</span></li>
        <li><a href="/feed.json">/feed.json</a><span>JSON Feed 1.1</span></li>
        <li><a href="/feed.xml">/feed.xml</a><span>RSS</span></li>
        <li><a href="/agents.json">/agents.json</a><span>the machine door</span></li>
        <li><a href="/for-agents">/for-agents</a><span>the same door, in prose</span></li>
        <li><a href="/llms.txt">/llms.txt</a><span>orientation for language models</span></li>
        <li><a href="/super-follow">/super-follow</a><span>a company is not one feed</span></li>
        <li><a href="/send.json">/send.json</a><span>the one-sheets · plain text at /send/&lt;slug&gt;.txt</span></li>
        <li><a href="/register.json">/register.json</a><span>the experiment register</span></li>
        <li><a href="/now.json">/now.json</a><span>right now, as JSON</span></li>
        <li><a href="/signals.json">/signals.json</a><span>the four field signals, as JSON</span></li>
        <li><a href="/me" title="Private PointCast identity and holdings">Your profile</a><span>/me · linked identities + holdings</span></li>
      </ul>
      <p class="shelf__foot">
        <span>A garden is slow on purpose. A broadcast is too.</span>
        <span>the coffee pot, still on · <a href="/mythos">what is this place</a> · <a href="/about">about</a> · <a href="/residents">who lives here</a></span>
      </p>
    </section>
  </div>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-front-door]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    // PT clock in the masthead.
    const clock = document.getElementById('home-clock');
    const tick = () => {
      if (!clock) return;
      try {
        clock.textContent = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' }).format(new Date()) + ' PT';
      } catch {}
    };
    tick();
    window.setInterval(tick, 30000);

    // Currently spinning, if the booth says so.
    fetch('/now-playing.json', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        if (!j) return;
        const title = j.title || j.track?.title || j.nowPlaying?.title || j.item?.title;
        const artist = j.artist || j.track?.artist || '';
        const line = root.querySelector('[data-live-now-playing]');
        const out = root.querySelector('[data-live-now-title]');
        if (title && line && out) { out.textContent = artist ? `${title} — ${artist}` : String(title); line.hidden = false; }
      })
      .catch(() => {});

    // Live numbers on the glance row; the build-time value stays if a fetch fails.
    const setGlance = (id, value) => {
      const el = root.querySelector(`[data-glance="${id}"]`);
      if (el && typeof value === 'number') el.textContent = value.toLocaleString('en-US');
    };
    // One request per endpoint for the whole page; sections listen for the event instead of fetching again.
    fetch('/api/drum', { headers: { accept: 'application/json' } }).then((r) => (r.ok ? r.json() : null)).then((j) => {
      if (!j || typeof j.globalTotal !== 'number') return;
      setGlance('drum-taps', j.globalTotal);
      root.querySelectorAll('[data-drum-taps], [data-drum-global]').forEach((el) => { el.textContent = j.globalTotal.toLocaleString('en-US'); });
      document.dispatchEvent(new CustomEvent('pc:drum', { detail: j }));
    }).catch(() => {});
    fetch('/api/visit', { headers: { accept: 'application/json' } }).then((r) => (r.ok ? r.json() : null)).then((j) => {
      if (!j || typeof j.count !== 'number') return;
      setGlance('visits', j.count);
      document.dispatchEvent(new CustomEvent('pc:visit', { detail: j }));
    }).catch(() => {});
  })();
</script>

<style>
  .masthead { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px 20px; padding: 14px 0 10px; border-bottom: 2px solid #111; }
  .masthead__brand { font-size: 22px; font-weight: 730; letter-spacing: -.04em; color: #111; }
  .masthead__meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; font: 700 9px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: #5F5E5A; }
  .masthead__air b { color: #111; text-transform: none; letter-spacing: 0; }
  .masthead__utility { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .masthead__utility a { padding: 7px 9px; border: 1px solid #111; font: 700 9px var(--pc-font-mono); letter-spacing: .09em; text-transform: uppercase; color: #111; }
  .masthead__utility a:hover { background: #111; color: #fff; text-decoration: none; }
  .masthead__wallet { display: inline-flex; }
  #start-here { scroll-margin-top: 12px; }

  .channels__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .channels__cell { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 14px; border-right: 1px solid rgba(0,0,0,.18); border-bottom: 1px solid rgba(0,0,0,.18); border-top: 4px solid var(--ch); color: #111; background: #fff; }
  .channels__cell:nth-child(5n) { border-right: 0; }
  .channels__cell:nth-child(n+6) { border-bottom: 0; }
  .channels__cell:hover { background: var(--ch-bg); text-decoration: none; }
  .channels__code { font: 700 8px var(--pc-font-mono); letter-spacing: .12em; color: var(--ch-ink); }
  .channels__cell strong { font-size: 15px; font-weight: 600; letter-spacing: -.02em; }
  .channels__cell small { font-size: 11.5px; line-height: 1.35; color: rgba(0,0,0,.72); }
  .channels__feeds { margin-top: auto; padding-top: 8px; font: 700 8px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: #5F5E5A; }
  .channels__feeds span { color: #111; }

  .machine__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .machine__list li { display: flex; flex-direction: column; gap: 3px; min-width: 0; padding: 12px 14px; border-right: 1px solid rgba(0,0,0,.18); border-bottom: 1px solid rgba(0,0,0,.18); overflow-wrap: anywhere; }
  .machine__list li:nth-child(4n) { border-right: 0; }
  .machine .shelf__foot { border-top: 0; }
  .machine__list a { font: 700 11px var(--pc-font-mono); letter-spacing: .04em; color: #185FA5; }
  .machine__list span { font-size: 11.5px; color: rgba(0,0,0,.72); }

  @media (max-width: 880px) {
    .masthead { grid-template-columns: 1fr auto; }
    .masthead__meta { grid-column: 1 / -1; order: 3; }
    .channels__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .channels__cell:nth-child(5n) { border-right: 1px solid rgba(0,0,0,.18); }
    .channels__cell:nth-child(2n) { border-right: 0; }
    .channels__cell:nth-child(n+6) { border-bottom: 1px solid rgba(0,0,0,.18); }
    .channels__cell:nth-child(n+9) { border-bottom: 0; }
    .machine__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .machine__list li:nth-child(4n) { border-right: 1px solid rgba(0,0,0,.18); }
    .machine__list li:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .masthead { grid-template-columns: 1fr; }
    .channels__grid, .machine__list { grid-template-columns: 1fr; }
    .channels__cell, .machine__list li { border-right: 0 !important; border-bottom: 1px solid rgba(0,0,0,.18) !important; }
    .channels__cell:last-child { border-bottom: 0 !important; }
  }
</style>
