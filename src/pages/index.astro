    border: 1px solid rgba(196, 149, 46, 0.2);
  }

  .agent-native-brief__noun {
    display: inline-grid;
    grid-template-columns: 28px auto;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 3px 8px 3px 3px;
    border: 1px solid rgba(196, 149, 46, 0.26);
    background: rgba(255, 255, 255, 0.42);
    color: var(--pc-ink-soft);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 1200ms ease,
      border-color 1200ms ease,
      color 1200ms ease,
      transform 1600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .agent-native-brief__noun:hover {
    border-color: rgba(104, 64, 146, 0.36);
    background: rgba(248, 223, 228, 0.72);
    color: #684092;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .agent-native-brief__noun img {
    display: block;
    width: 28px;
    height: 28px;
    image-rendering: pixelated;
  }

  .agent-native-brief__matrix {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }

  .agent-native-brief__cell {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 7px;
    min-width: 0;
    min-height: 126px;
    padding: 14px;
    border: 1px solid rgba(196, 149, 46, 0.25);
    border-top: 0;
    background:
      linear-gradient(180deg, rgba(238, 88, 119, 0.18) 0 7px, transparent 7px),
      linear-gradient(135deg, rgba(251, 232, 219, 0.86), rgba(248, 223, 228, 0.62));
    color: var(--pc-ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    transition:
      border-color 1400ms ease,
      box-shadow 1800ms ease,
      transform 1800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .agent-native-brief__cell:nth-child(2) {
    background:
      linear-gradient(180deg, rgba(78, 126, 169, 0.18) 0 7px, transparent 7px),
      linear-gradient(135deg, rgba(235, 244, 247, 0.82), rgba(246, 240, 216, 0.62));
  }

  .agent-native-brief__cell:nth-child(3) {
    background:
      linear-gradient(180deg, rgba(79, 139, 91, 0.18) 0 7px, transparent 7px),
      linear-gradient(135deg, rgba(241, 248, 232, 0.82), rgba(255, 248, 225, 0.62));
  }

  .agent-native-brief__cell:nth-child(4) {
    background:
      linear-gradient(180deg, rgba(196, 149, 46, 0.22) 0 7px, transparent 7px),
      linear-gradient(135deg, rgba(255, 247, 210, 0.86), rgba(237, 229, 247, 0.58));
  }

  .agent-native-brief__cell:hover {
    border-color: rgba(104, 64, 146, 0.34);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.54), 0 14px 34px rgba(106, 36, 78, 0.06);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .agent-native-brief__cell--primary {
    background:
      linear-gradient(180deg, rgba(238, 88, 119, 0.2) 0 7px, transparent 7px),
      linear-gradient(135deg, rgba(251, 232, 219, 0.9), rgba(248, 223, 228, 0.66));
  }

  .agent-native-brief__label,
  .agent-native-brief__cell strong,
  .agent-native-brief__signals {
    font-family: var(--pc-font-mono);
  }

  .agent-native-brief__label {
    color: var(--pc-ink-muted);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .agent-native-brief__cell strong {
    min-width: 0;
    overflow-wrap: anywhere;
    color: #8a2e62;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .agent-native-brief__cell span:last-child {
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.35;
  }

  .agent-native-brief__signals {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .agent-native-brief__signals li {
    border: 1px solid rgba(196, 149, 46, 0.24);
    padding: 5px 8px;
    background: rgba(255, 248, 225, 0.58);
    color: var(--pc-ink-soft);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 1400ms ease, border-color 1400ms ease;
  }

  .agent-native-brief__signals li:nth-child(2n) {
    background: rgba(237, 229, 247, 0.58);
  }

  .agent-native-brief__signals li:nth-child(3n) {
    background: rgba(240, 247, 236, 0.62);
  }

  .agent-native-brief__signals li:nth-child(4n) {
    background: rgba(248, 223, 228, 0.58);
  }

  @keyframes agentNativeBriefGlow {
    0% {
      background-position: 0 0, 0 0, 38% 46%;
    }

    100% {
      background-position: 0 0, 0 0, 62% 54%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .agent-native-brief {
      animation: agentNativeBriefGlow 28s ease-in-out infinite alternate;
    }
  }

  @media (max-width: 920px) {
    .agent-native-brief {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .agent-native-brief {
      width: calc(100vw - 40px);
      max-width: calc(100vw - 40px);
      padding: 16px;
      overflow: hidden;
    }

    .agent-native-brief__title {
      font-size: 27px;
    }

    .agent-native-brief__matrix {
      grid-template-columns: 1fr;
    }

    .agent-native-brief__cell {
      min-height: 0;
    }
  }

  .hello-module {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin: 14px 0;
  }

  .hello-module :global(.block-card) {
    min-height: 168px;
  }

  /* Channel chip bar — flex-wrap desktop, horizontal-scroll + sticky on mobile */
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px dashed var(--pc-rule);
    margin-bottom: 14px;
    background: var(--pc-bg);
  }

  @media (max-width: 767px) {
    .channels {
      width: 100%;
      max-width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      position: sticky;
      top: 0;
      z-index: 10;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .channels::-webkit-scrollbar { display: none; }
    .chip { flex-shrink: 0; }
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 1px solid var(--ch-600);
    background: var(--ch-50);
    color: var(--ch-800);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background-color 0.12s;
  }
  .chip:hover {
    background: color-mix(in oklab, var(--ch-600) 20%, #fff);
    text-decoration: none;
  }
  .chip__dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: var(--ch-600);
    border-radius: 50%;
  }
  .chip__code { font-weight: 500; }
  .chip__name { font-weight: 400; color: var(--pc-ink-soft); }

  .first-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 14px;
  }

  .first-block :global(.block-card) {
    min-height: 210px;
  }

  .first-block :global(.block-card.span-2x1),
  .first-block :global(.block-card.span-2x2),
  .first-block :global(.block-card.span-3x2) {
    grid-column: 1;
    grid-row: auto;
  }

  @media (max-width: 639px) {
    .first-block {
      margin-top: 12px;
    }

    .first-block :global(.block-card) {
      min-height: 180px;
    }
  }

  /* Self-healing grid per BLOCKS.md: auto-fit + minmax(220px, 1fr) */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    grid-auto-rows: minmax(170px, auto);
    grid-auto-flow: dense;
    gap: 8px;
    margin-top: 14px;
  }

  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
      /* Mike 2026-04-18 home-mobile-lighten: more breathing room between
         cards on mobile. The horizontal gap is moot at single-column;
         the vertical gap is what makes the scroll feel airier. */
      gap: 16px;
      grid-auto-rows: minmax(120px, auto);
    }
  }

  /* ══ SCROLL RHYTHM ═════════════════════════════════════════════════════
     Per-position decoration so the feed doesn't read as 48 identical tiles.
     Rules layer in source order — each block matches based on its DOM
     index (grid-auto-flow:dense doesn't change nth-child). Deliberately
     subtle: varies tone, weight, and micro-detail, never layout. */

  /* Every 5th card gets a paper-tint fill over the standard white. */
  .grid :global(.block-card:nth-child(5n+2):not(.type-visit):not(.type-note):not(.block-card--detail)) {
    background: #fafaf7;
  }

  /* Every 7th card gets a thicker 3px left accent (was 6px only on READ). */
  .grid :global(.block-card:nth-child(7n+3):not(.type-visit):not(.block-card--detail)) {
    border-left-width: 3px;
  }

  /* Every 9th card drops the border entirely and relies on a faint
     shadow instead — reads as an "open" card amid the bordered ones. */
  .grid :global(.block-card:nth-child(9n+4):not(.type-visit):not(.type-note):not(.type-link):not(.type-mint):not(.type-faucet):not(.block-card--detail)) {
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--pc-rule, #C4C2BC), inset 4px 0 0 var(--ch-600);
  }

  /* Every 11th card inverts: dark bg + light text. Only applies where
     it won't collide with VISIT (which is already dark). */
  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail)) {
    background: #12110E;
    border-color: var(--ch-800);
  }

  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__title) {
    color: #f2efe9;
  }

  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__dek),
  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__body) {
    color: #c4c2bc;
  }

  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__header),
  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__code),
  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__time),
  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__kicker) {
    color: color-mix(in oklab, var(--ch-600) 55%, #fff);
  }

  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail) .block-card__meta) {
    color: color-mix(in oklab, var(--ch-600) 55%, #fff);
  }

  .grid :global(.block-card:nth-child(11n+6):not(.type-visit):not(.type-mint):not(.type-faucet):not(.type-listen):not(.type-watch):not(.block-card--detail):hover .block-card__title) {
    color: #fff;
  }

  .endpoints {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1.5px solid var(--pc-ink);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .endpoints__label { margin: 0; color: var(--pc-ink-soft); font-weight: 500; }
  .endpoints__list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .endpoints__list a { color: var(--pc-accent); }

  .discovery-front-door {
    margin: 18px 0 30px;
    padding: 18px 0 0;
    border-top: 2px solid var(--pc-ink);
    border-bottom: 1px solid var(--pc-ink);
    color: var(--pc-ink);
  }

  .discovery-front-door__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    gap: 28px;
    align-items: end;
  }

  .discovery-front-door__kicker,
  .discovery-group__kicker,
  .broadcast-lower__kicker {
    margin: 0 0 7px;
    color: #a25b20;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .discovery-front-door h2 {
    max-width: 760px;
    margin: 0;
    font-family: var(--pc-font-sans);
    font-size: 52px;
    font-weight: 680;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .discovery-front-door__dek {
    max-width: 660px;
    margin: 12px 0 0;
    color: var(--pc-ink-soft);
    font-size: 16px;
    line-height: 1.45;
  }

  .discovery-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 8px;
    border: 1px solid var(--pc-ink);
    background: #fffdf7;
  }

  .discovery-search input {
    width: 100%;
    min-height: 42px;
    padding: 8px 10px;
    border: 1px solid var(--pc-rule);
    border-radius: 0;
    background: #fff;
    color: var(--pc-ink);
    font-family: var(--pc-font-sans);
    font-size: 15px;
  }

  .discovery-search input:focus {
    outline: 2px solid #d69c26;
    outline-offset: 1px;
  }

  .discovery-search__count {
    min-width: 82px;
    color: var(--pc-ink-soft);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-align: right;
    white-space: nowrap;
  }

  .discovery-categories {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 18px;
    border-top: 1px solid var(--pc-rule);
    border-bottom: 1px solid var(--pc-rule);
  }

  .discovery-category {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border-right: 1px solid var(--pc-rule);
    color: var(--pc-ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .discovery-category:last-child { border-right: 0; }
  .discovery-category:hover,
  .discovery-category--active {
    background: #f3dfaa;
    color: #6f271a;
    text-decoration: none;
  }

  .discovery-featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .discovery-featured-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 7px;
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--pc-ink);
    background: #fffdf7;
    color: var(--pc-ink);
  }

  .discovery-featured-card:hover {
    background: #fff7d9;
    text-decoration: none;
    transform: translateY(-2px);
  }

  .discovery-featured-card img {
    width: 100%;
    aspect-ratio: 16 / 8;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--pc-rule);
    background: #e8f0e6;
  }

  .discovery-featured-card__label,
  .discovery-item__kicker,
  .discovery-all__category,
  .discovery-all__kicker {
    color: #0f6e56;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .discovery-featured-card strong {
    font-size: 23px;
    line-height: 1;
    font-weight: 700;
  }

  .discovery-featured-card > span:last-child {
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.35;
  }

  .discovery-directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
  }

  .discovery-group {
    min-width: 0;
    border-top: 2px solid var(--pc-ink);
  }

  .discovery-group__header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: start;
    min-height: 96px;
    padding: 12px 0 10px;
  }

  .discovery-group__header h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1;
    font-weight: 680;
  }

  .discovery-group__header p:last-child {
    max-width: 250px;
    margin: 7px 0 0;
    color: var(--pc-ink-soft);
    font-size: 13px;
    line-height: 1.3;
  }

  .discovery-group__cta {
    flex: 0 0 auto;
    padding-top: 3px;
    color: #2f5f9f;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .discovery-list,
  .discovery-all__list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .discovery-item {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 18px;
    gap: 3px 10px;
    min-height: 94px;
    padding: 10px;
    border: 1px solid var(--pc-rule);
    background: #fff;
    color: var(--pc-ink);
  }

