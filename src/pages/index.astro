---
/**
 * pointcast.xyz v2 — home grid.
 *
 * Every content surface is a Block (per BLOCKS.md). The home page is a
 * dense auto-fit grid of BlockCards, most recent first. Size variants
 * are honored on desktop; mobile collapses to a single column with a
 * sticky channel chip bar at top.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import BlockCard from '../components/BlockCard.astro';
import BlockReorder from '../components/BlockReorder.astro';
import PresenceBar from '../components/PresenceBar.astro';
import StreakBadge from '../components/StreakBadge.astro';
import WalletChip from '../components/WalletChip.astro';
import HomeMajors from '../components/HomeMajors.astro';
import SitTile from '../components/SitTile.astro';
import FreshDeck from '../components/FreshDeck.astro';
import PollsOnHome from '../components/PollsOnHome.astro';
import MoodChip from '../components/MoodChip.astro';
import FreshStrip from '../components/FreshStrip.astro';
import VisitorHereStrip from '../components/VisitorHereStrip.astro';
import WingPulseModule from '../components/WingPulseModule.astro';
import AltarsPulseModule from '../components/AltarsPulseModule.astro';
import QuintetPulseModule from '../components/QuintetPulseModule.astro';
import ProcessionPulseModule from '../components/ProcessionPulseModule.astro';
import OfferingsPulseModule from '../components/OfferingsPulseModule.astro';
import ChamberMegaModule from '../components/ChamberMegaModule.astro';
import HomeRingPad from '../components/HomeRingPad.astro';
import NetworkStrip from '../components/NetworkStrip.astro';
import TodayOnPointCast from '../components/TodayOnPointCast.astro';
import DailyDropStrip from '../components/DailyDropStrip.astro';
import SportsStrip from '../components/SportsStrip.astro';
import SportsDeskStrip from '../components/SportsDeskStrip.astro';
import LASportsTicker from '../components/LASportsTicker.astro';
import SportsTicker from '../components/SportsTicker.astro';
import MorningPara from '../components/MorningPara.astro';
import NatureFieldDeskStrip from '../components/NatureFieldDeskStrip.astro';
import NativePlantingYield from '../components/NativePlantingYield.astro';
import AgentLedger from '../components/AgentLedger.astro';
import HomeFireplace from '../components/HomeFireplace.astro';
import AppLaunchStrip from '../components/AppLaunchStrip.astro';
import BuddhaHeadRotator from '../components/BuddhaHeadRotator.astro';
import PointCastPlayStrip from '../components/PointCastPlayStrip.astro';
import ZenCatTodayCard from '../components/ZenCatTodayCard.astro';
import WalletShelfModule from '../components/WalletShelfModule.astro';
import NounsPortraitStrip from '../components/NounsPortraitStrip.astro';
import DrumCrewStrip from '../components/DrumCrewStrip.astro';
import KettleStrip from '../components/KettleStrip.astro';
import AgentLane from '../components/AgentLane.astro';
import DrumPressMarquee from '../components/DrumPressMarquee.astro';
import BirthdayLane from '../components/BirthdayLane.astro';
import DrumVsLane from '../components/DrumVsLane.astro';
import DrumLeagueStrip from '../components/DrumLeagueStrip.astro';
import FeedbackBlock from '../components/FeedbackBlock.astro';
import NounsWoodChopStrip from '../components/NounsWoodChopStrip.astro';
import NowLine from '../components/NowLine.astro';
import frontDoorStreetImage from '../assets/bell-fall-v2/bg-05-yellow-car.jpg';
import frontDoorFlowerImage from '../assets/bell-fall-v2/bg-13-blue-flower.jpg';
import { POINTCAST_APPS } from '../lib/pointcast-apps';
import { PLAY_SURFACES } from '../lib/play-layer';
import { ARCADE_ASSETS, RETRO_ARCADE_GAMES } from '../lib/retro-arcade';

// Removed 2026-04-19 21:55 PT per Mike: "six things isn't working,
// morning brief isn't working, novice voter isn't working, remove
// for now". Old MorningBrief, TodayStrip, VoterStats components still
// on disk; not imported. Can return when a new shape is agreed.
import { CHANNEL_LIST } from '../lib/channels';
import { getCollection } from 'astro:content';

const HELLO_MIKE_BLOCK_ID = '0334';
const HOUSEPLANTS_FIRST_BLOCK_ID = '0333';

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

const firstBlock = allBlocks.find((block) => block.data.id === HOUSEPLANTS_FIRST_BLOCK_ID) ?? allBlocks[0] ?? null;
const helloMikeCandidate = allBlocks.find((block) => block.data.id === HELLO_MIKE_BLOCK_ID) ?? null;
const helloMikeBlock = helloMikeCandidate?.data.id !== firstBlock?.data.id ? helloMikeCandidate : null;
const pinnedBlockIds = new Set([firstBlock?.data.id, helloMikeBlock?.data.id].filter(Boolean));
const blocks = allBlocks.filter((block) => !pinnedBlockIds.has(block.data.id));
const blockCount = allBlocks.length;
const latestShips = allBlocks.slice(0, 5);
const leadShip = latestShips[0] ?? null;
const shipDeck = latestShips.slice(1);
const homeDescription = 'PointCast is an agent-native broadcast from El Segundo: live posts, rooms, games, agent surfaces, participation memory, Nouns experiments, and machine-readable feeds in one place.';

function prettyShipTime(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/Los_Angeles',
    timeZoneName: 'short',
  }).format(date);
}

const todaysShipSteps = [
  'Open the app shell first; it is the phone-home view.',
  'Use Chartmaker when a source wants to become a board, remix, or timeline.',
  'Verify the live JSON before calling a route shipped.',
];

const frontDoorApps = [
  {
    href: '/app',
    label: 'Native shell',
    route: '/app',
    note: 'Installable home: now, rooms, profile, collect, agents.',
  },
  {
    href: '/chartmaker',
    label: 'Chartmaker v3',
    route: '/chartmaker',
    note: 'Today board, remix queue, sources, and chart JSON.',
  },
  {
    href: '/rooms',
    label: 'Town map',
    route: '/rooms',
    note: 'The lived map of playable PointCast surfaces.',
  },
  {
    href: '/win95-games',
    label: 'Retro arcade',
    route: '/win95-games',
    note: 'Windows 95 worthy Nouns games with local scores.',
  },
  {
    href: '/for-agents',
    label: 'Agent dock',
    route: '/for-agents',
    note: 'Machine-readable paths, feeds, manifests, and receipts.',
  },
];

const discoveryFeatured = [
  {
    href: '/win95-games',
    label: 'PLAY',
    title: 'Retro Arcade',
    note: 'Four Nouns games with local scores, quick rounds, and a proper little desktop.',
    image: ARCADE_ASSETS.desktop,
    alt: 'Pixel-art Windows 95 arcade desktop',
  },
  {
    href: '/app',
    label: 'APP',
    title: 'PointCast Shell',
    note: 'Now, rooms, drum, profile, collect, and agents in one place to start from.',
    image: frontDoorStreetImage.src,
    alt: 'Bright watercolor street with a yellow car',
  },
  {
    href: '/drum-press',
    label: 'CATALOG',
    title: 'Drum Press',
    note: 'A shelf of participatory drum surfaces, from birthday rooms to agent play.',
    image: frontDoorFlowerImage.src,
    alt: 'Bright blue and orange flower study',
  },
];

const discoveryPlayItems = [
  ...RETRO_ARCADE_GAMES.map((game) => ({
    href: game.path,
    title: game.name,
    kicker: game.kicker,
    description: game.description,
  })),
  ...PLAY_SURFACES.map((surface) => ({
    href: surface.route,
    title: surface.title,
    kicker: surface.code,
    description: surface.summary,
  })),
];

const discoveryAppItems = POINTCAST_APPS
  .filter((app) => app.channel !== 'CH.BTL')
  .map((app) => ({
    href: app.path,
    title: app.name,
    kicker: app.kicker,
    description: app.description,
  }));

const discoveryRoomItems = [
  { href: '/rooms', title: 'Rooms', kicker: 'TOWN MAP', description: 'The lived map of PointCast rooms, places, and active surfaces.' },
  { href: '/bar-v6', title: 'The Live Bar', kicker: 'BAR', description: 'A shared browser room for messages, spells, and small visits.' },
  { href: '/kettle', title: 'Kettle', kicker: 'KITCHEN', description: 'A cozy multiplayer room for making a little noise together.' },
  { href: '/radio', title: 'PointCast Radio', kicker: 'BROADCAST', description: 'Drops, quests, polls, races, and room states in one text-first desk.' },
  { href: '/now', title: 'Now', kicker: 'LIVE INDEX', description: 'A compact read on what is live, moving, and worth opening today.' },
  { href: '/nouns-nation/', title: 'Nouns Nation', kicker: 'WORLD', description: 'A playable Nouns world with places to visit and things to do.' },
];

const discoveryGroups = [
  {
    id: 'play',
    label: 'Play',
    note: 'Games, races, quests, and daily loops.',
    href: '/win95-games',
    cta: 'Browse the arcade',
    items: discoveryPlayItems.slice(0, 8),
  },
  {
    id: 'apps',
    label: 'Apps & tools',
    note: 'Useful surfaces for making, collecting, and exploring.',
    href: '/app',
    cta: 'Open the app shell',
    items: discoveryAppItems.slice(0, 11),
  },
  {
    id: 'rooms',
    label: 'Rooms & places',
    note: 'Go somewhere with a little more life in it.',
    href: '/rooms',
    cta: 'See the town map',
    items: discoveryRoomItems,
  },
];

const discoveryAllItems = [
  ...discoveryPlayItems.map((item) => ({ ...item, category: 'play' })),
  ...discoveryAppItems.map((item) => ({ ...item, category: 'apps' })),
  ...discoveryRoomItems.map((item) => ({ ...item, category: 'rooms' })),
];

// JSON-LD — make the home a CollectionPage so agents can parse the list.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/#home',
  name: 'PointCast Gamgee front door',
  description: homeDescription,
  url: 'https://pointcast.xyz/',
  inLanguage: 'en-US',
  hasPart: allBlocks.slice(0, 20).map((b) => ({
    '@type': 'CreativeWork',
    '@id': `https://pointcast.xyz/b/${b.data.id}`,
    name: b.data.title,
    datePublished: b.data.timestamp.toISOString(),
    url: `https://pointcast.xyz/b/${b.data.id}`,
  })),
};

const alternates = [
  { type: 'application/json', href: '/blocks.json', title: 'All blocks (JSON)' },
  { type: 'application/rss+xml', href: '/feed.xml', title: 'PointCast (RSS · all blocks)' },
  { type: 'application/feed+json', href: '/feed.json', title: 'PointCast (JSON Feed 1.1)' },
  ...CHANNEL_LIST.map((c) => ({
    type: 'application/rss+xml',
    href: `/c/${c.slug}.rss`,
    title: `PointCast · ${c.name} (RSS)`,
  })),
];

const contents = [
  { href: '#ship-lane', label: 'Ship Lane', note: 'Today’s clean entry point' },
  { href: '#chartmaker-home', label: 'Chartmaker', note: 'v3 board and source lab' },
  { href: '#nature-field-desk', label: 'Nature', note: 'Fresh El Segundo field desk' },
  { href: '#release', label: 'Release', note: 'Gamgee RC0 and agent paths' },
  { href: '/areas', label: 'Areas', note: 'Paddles, meetups, UES, Honey League' },
  { href: '/nouns-nation/', label: 'Nouns Nation', note: 'V3 desk, TV, federation' },
  { href: '#pattern', label: 'Pattern', note: 'Agent-native publishing' },
  { href: '#featured', label: 'Featured', note: 'Pinned blocks' },
  { href: '#fresh', label: 'Fresh', note: 'New, mood, and presence' },
  { href: '#nouns-portraits', label: 'Portraits', note: 'Five Tezos-mintable Nouns' },
  { href: '#network', label: 'Network', note: 'People, apps, and activity' },
  { href: '#play', label: 'Play', note: 'Passport, quests, walk, radio' },
  { href: '#wood-chop', label: 'Wood Chop', note: 'Pixel Nouns collect loop' },
  { href: '#today', label: 'Today', note: 'Highlights, drop, sports' },
  { href: '#interact', label: 'Interact', note: 'Polls, random deck, channels' },
  { href: '#feedback', label: 'Feedback', note: 'Share what should change' },
  { href: '#majors', label: 'Majors', note: 'Drum, Cast, Meditate' },
  { href: '#blocks', label: 'Blocks', note: 'Full public grid' },
  { href: '#endpoints', label: 'Endpoints', note: 'Site map and feeds' },
];
---

<BlockLayout
  title="Home"
  description={homeDescription}
  jsonLd={jsonLd}
  alternates={alternates}
  frame={{
    image: 'https://pointcast.xyz/images/og/og-home-v2.png',
    buttons: [
      { label: 'Open /internships', action: 'link', target: 'https://pointcast.xyz/internships' },
      { label: 'Open /gamgee', action: 'link', target: 'https://pointcast.xyz/gamgee' },
      { label: 'Open /now', action: 'link', target: 'https://pointcast.xyz/now' },
      { label: '/for-agents', action: 'link', target: 'https://pointcast.xyz/for-agents' },
      { label: '/agents.json', action: 'link', target: 'https://pointcast.xyz/agents.json' },
    ],
  }}
>
  <div class="page">

    <h1 class="sr-only">PointCast Gamgee - an agent-native broadcast from El Segundo with human and machine-readable paths.</h1>

    <!-- Masthead — one line. Wordmark, block count, current time, agent link. -->
    <header class="masthead">
      <a href="/" class="wordmark" aria-label="PointCast home">POINTCAST</a>
      <span class="sep" aria-hidden="true">·</span>
      <span class="meta">{blockCount} BLOCKS</span>
      <span class="sep" aria-hidden="true">·</span>
      <time class="meta time" id="pc-clock">— : —</time>
      <PresenceBar />
      <StreakBadge variant="compact" />
      <span class="spacer" aria-hidden="true"></span>
      <WalletChip />
      <a href="/for-agents" class="agent-link">/for-agents →</a>
    </header>

    <NowLine blocks={allBlocks} blockCount={blockCount} />

    <section class="discovery-front-door" aria-labelledby="discovery-title">
      <div class="discovery-front-door__intro">
        <div>
          <p class="discovery-front-door__kicker mono">POINTCAST DIRECTORY · PLAY FIRST</p>
          <h2 id="discovery-title">What do you want to do?</h2>
          <p class="discovery-front-door__dek">
            Games, apps, rooms, and tools to open right now. The broadcast is still here when you feel like reading it.
          </p>
        </div>
        <div class="discovery-search">
          <label class="sr-only" for="home-directory-search">Search PointCast games, apps, rooms, and tools</label>
          <input
            id="home-directory-search"
            type="search"
            placeholder="Search games, apps, rooms..."
            autocomplete="off"
            data-home-directory-search
          />
          <span class="discovery-search__count mono" data-directory-count>{discoveryAllItems.length} SURFACES</span>
        </div>
      </div>

      <nav class="discovery-categories mono" aria-label="PointCast discovery categories">
        <a class="discovery-category discovery-category--active" href="#discovery-play">Play</a>
        <a class="discovery-category" href="#discovery-apps">Apps &amp; tools</a>
        <a class="discovery-category" href="#discovery-rooms">Rooms &amp; places</a>
        <a class="discovery-category" href="/drum-press">Drum Press</a>
        <a class="discovery-category" href="/for-agents">Agents</a>
        <a class="discovery-category" href="#broadcast-lower">Read</a>
      </nav>

      <div class="discovery-featured" aria-label="Featured ways to start">
        {discoveryFeatured.map((card, index) => (
          <a class="discovery-featured-card" href={card.href}>
            <img
              src={card.image}
              alt={card.alt}
              width="640"
              height="360"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <span class="discovery-featured-card__label mono">{card.label}</span>
            <strong>{card.title}</strong>
            <span>{card.note}</span>
          </a>
        ))}
      </div>

      <div class="discovery-directory" aria-label="PointCast surface directory">
        {discoveryGroups.map((group) => (
          <section id={`discovery-${group.id}`} class="discovery-group" aria-labelledby={`discovery-${group.id}-title`}>
            <div class="discovery-group__header">
              <div>
                <p class="discovery-group__kicker mono">{group.id}</p>
                <h3 id={`discovery-${group.id}-title`}>{group.label}</h3>
                <p>{group.note}</p>
              </div>
              <a class="discovery-group__cta mono" href={group.href}>{group.cta} +</a>
            </div>
            <ul class="discovery-list">
              {group.items.map((item) => (
                <li>
                  <a class="discovery-item" href={item.href}>
                    <span class="discovery-item__kicker mono">{item.kicker}</span>
                    <strong>{item.title}</strong>
                    <span>{item.description}</span>
                    <span class="discovery-item__arrow" aria-hidden="true">+</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <details class="discovery-all" data-directory-all>
        <summary class="mono">Browse every surface <span data-directory-summary>{discoveryAllItems.length} listed</span></summary>
        <ul class="discovery-all__list">
          {discoveryAllItems.map((item) => (
            <li data-directory-search-item data-searchable={`${item.title} ${item.kicker} ${item.description} ${item.category}`.toLowerCase()}>
              <a class="discovery-all__item" href={item.href}>
                <span class="discovery-all__category mono">{item.category}</span>
                <strong>{item.title}</strong>
                <span class="discovery-all__kicker mono">{item.kicker}</span>
                <span>{item.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="discovery-all__empty" data-directory-empty hidden>No matching surfaces yet.</p>
      </details>

      {leadShip && (
        <div class="discovery-proof">
          <span class="discovery-proof__label mono">LATEST SHIP</span>
          <a href={`/b/${leadShip.data.id}`}><strong>{leadShip.data.title}</strong><span>{prettyShipTime(leadShip.data.timestamp)}</span></a>
          <span class="discovery-proof__count mono">{blockCount} BLOCKS · {latestShips.length} RECENT</span>
        </div>
      )}
    </section>

    <script is:inline>
      (() => {
        const input = document.querySelector('[data-home-directory-search]');
        const details = document.querySelector('[data-directory-all]');
        const count = document.querySelector('[data-directory-count]');
        const summary = document.querySelector('[data-directory-summary]');
        const empty = document.querySelector('[data-directory-empty]');
        const items = Array.from(document.querySelectorAll('[data-directory-search-item]'));
        if (!(input instanceof HTMLInputElement) || !(details instanceof HTMLDetailsElement)) return;

        const total = items.length;
        const updateDirectory = () => {
          const query = input.value.trim().toLowerCase();
          let visible = 0;
          items.forEach((item) => {
            const searchable = item.getAttribute('data-searchable') || '';
            const matches = !query || searchable.includes(query);
            item.hidden = !matches;
            if (matches) visible += 1;
          });
          details.open = Boolean(query);
          if (count) count.textContent = query ? `${visible} MATCHES` : `${total} SURFACES`;
          if (summary) summary.textContent = query ? `${visible} matches` : `${total} listed`;
          if (empty) empty.hidden = !query || visible > 0;
        };

        input.addEventListener('input', updateDirectory);
      })();
    </script>

    <section id="broadcast-lower" class="broadcast-lower" aria-labelledby="broadcast-lower-title">
      <div>
        <p class="broadcast-lower__kicker mono">THE BROADCAST</p>
        <h2 id="broadcast-lower-title">What is new, live, and worth following.</h2>
      </div>
      <a class="broadcast-lower__link mono" href="/archive">Read the archive +</a>
    </section>

    <NatureFieldDeskStrip />

    <section id="ship-lane" class="monday-meditation ship-lane" aria-labelledby="ship-lane-title">
      <div class="monday-meditation__copy">
        <p class="monday-meditation__kicker">Thursday ship lane / 90 seconds</p>
        <h2 id="ship-lane-title" class="monday-meditation__title">Enter through one clean app surface.</h2>
        <p class="monday-meditation__dek">
          Today’s homepage job is orientation: give visitors a phone-home screen, give builders a chart lab, give agents stable JSON, and keep the receipt trail obvious.
        </p>
      </div>
      <ol class="monday-meditation__steps" aria-label="Today ship lane steps">
        {todaysShipSteps.map((step) => <li>{step}</li>)}
      </ol>
      <a class="monday-meditation__link" href="/app">Open /app</a>
    </section>

    <nav class="contents" aria-labelledby="contents-title">
      <div class="contents__header">
        <p class="contents__eyebrow">Table of Contents</p>
        <h2 id="contents-title" class="contents__title">What is on PointCast</h2>
      </div>
      <ol class="contents__list">
        {contents.map((item, index) => (
          <li class="contents__item">
            <a href={item.href} class="contents__link">
              <span class="contents__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="contents__copy">
                <span class="contents__label">{item.label}</span>
                <span class="contents__note">{item.note}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="contents__routes" aria-label="Common PointCast routes">
        <a href="/now">/now</a>
        <a href="/app">/app</a>
        <a href="/chartmaker">/chartmaker</a>
        <a href="/areas">/areas</a>
        <a href="/for-agents">/for-agents</a>
        <a href="/search">/search</a>
        <a href="/archive">/archive</a>
        <a href="/blocks.json">/blocks.json</a>
      </div>
    </nav>

    <HomeFireplace />

    <section id="chartmaker-home" class="chartmaker-home" aria-labelledby="chartmaker-home-title">
      <div class="chartmaker-home__copy">
        <p class="chartmaker-home__kicker mono">CHARTMAKER V3 · LIVE SOURCE LAB</p>
        <h2 id="chartmaker-home-title">Turn the day into boards, remixes, and timelines.</h2>
        <p>
          Chartmaker is the new app layer for data play: ten charts for the day,
          five remix prompts, a source catalog, and a JSON payload agents can inspect.
        </p>
        <div class="chartmaker-home__actions">
          <a href="/chartmaker">Open Chartmaker</a>
          <a href="/chartmaker.json">Read JSON</a>
          <a href="/chart">Chart of the day</a>
        </div>
      </div>
      <div class="chartmaker-home__board" aria-label="Chartmaker v3 board summary">
        <div>
          <span class="chartmaker-home__metric">10</span>
          <span>today charts</span>
        </div>
        <div>
          <span class="chartmaker-home__metric">5</span>
          <span>remix queue</span>
        </div>
        <div>
          <span class="chartmaker-home__metric">JSON</span>
          <span>live source contract</span>
        </div>
      </div>
    </section>

    <section id="release" class="gamgee-front-door" aria-labelledby="gamgee-front-door-title">
      <div class="gamgee-front-door__copy">
        <p class="gamgee-front-door__kicker">Fresh home signal</p>
        <h2 id="gamgee-front-door-title" class="gamgee-front-door__title">PointCast is live work, posted while the day is still moving.</h2>
        <p class="gamgee-front-door__dek">Today the front door points at participation: internships, memory notes, Nouns interest, information gathering, rewards, grants, rooms, and the confidence to make something useful enough to remember.</p>
        <ul class="gamgee-front-door__signals" aria-label="Gamgee release signals">
          <li>{blockCount} blocks</li>
          <li>Claude + Codex + Manus</li>
          <li>Build it, stamp it, remember it</li>
        </ul>
      </div>
      <nav class="gamgee-front-door__paths" aria-label="Gamgee entry points">
        {frontDoorApps.map((item) => (
          <a href={item.href} class="gamgee-front-door__path">
            <span class="gamgee-front-door__label">{item.label}</span>
            <span class="gamgee-front-door__target">{item.route}</span>
            <span class="gamgee-front-door__note">{item.note}</span>
          </a>
        ))}
        <a href="/now" class="gamgee-front-door__path">
          <span class="gamgee-front-door__label">Live state</span>
          <span class="gamgee-front-door__target">/now</span>
          <span class="gamgee-front-door__note">See what is current today.</span>
        </a>
        <a href="/agents.json" class="gamgee-front-door__path">
          <span class="gamgee-front-door__label">Manifest</span>
