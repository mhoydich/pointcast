// ---------- blocks: computed, never typed ----------
const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());
const blockCount = allBlocks.length;
const latestBlock = allBlocks[0] ?? null;
const latestId = latestBlock?.data.id ?? '0000';
const ptMonthDay = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' });
const ptMonthYear = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'America/Los_Angeles' });
const firstBlock = allBlocks[allBlocks.length - 1] ?? null;
const sinceLabel = firstBlock ? ptMonthYear.format(firstBlock.data.timestamp) : '';

const hostOf = (url?: string) => {
  if (!url) return '';
  try { const u = new URL(url, 'https://pointcast.xyz'); return u.host === 'pointcast.xyz' ? u.pathname : u.host.replace(/^www\./, ''); } catch { return ''; }
};
const latestWire: WireItem[] = allBlocks.slice(0, 8).map((block) => {
  const d = block.data;
  return {
    id: d.id,
    title: d.title,
    channel: d.channel,
    type: d.type,
    date: ptMonthDay.format(d.timestamp),
    href: `/b/${d.id}`,
    image: `/images/og/b/${d.id}.png`,
    dek: d.dek ?? '',
    external: d.external?.url ? hostOf(d.external.url) : undefined,
  };
});

// Blocks per month + per author, for the ship log. Pre-repo imports (2025) are bucketed once.
const monthKey = (t: Date) => new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', timeZone: 'America/Los_Angeles' }).format(t);
const monthCounts = new Map<string, number>();
const authorCounts = new Map<string, number>();
for (const block of allBlocks) {
  const key = monthKey(block.data.timestamp);
  const bucket = key < '2026-04' ? 'imports' : key;
  monthCounts.set(bucket, (monthCounts.get(bucket) ?? 0) + 1);
  const author = ((block.data as { author?: string }).author ?? 'unsigned').toString();
  authorCounts.set(author, (authorCounts.get(author) ?? 0) + 1);
}
const monthLabel = (key: string) => key === 'imports' ? '2025' : new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(new Date(`${key}-15T12:00:00Z`));
const blocksByMonth = ['2026-04', '2026-05', '2026-06', '2026-07', '2026-08', '2026-09']
  .map((key) => ({ label: monthLabel(key), count: monthCounts.get(key) ?? 0 }));
const blocksImported = monthCounts.get('imports') ?? 0; // pre-repo blocks carried in from 2025
const authors = [...authorCounts.entries()].sort((a, b) => b[1] - a[1]).map(([name, blocks]) => ({ name, blocks }));

// Editorial blocks since July 1: any block whose destination is one of the magazine wing's paths.
const EDITORIAL_PATHS = ['/25', '/worklife', '/wednesday', '/tonight', '/noticing', '/digital-pets', '/beach-commons', '/ai-income', '/next-models', '/firecrawl', '/haptic-dreams', '/second-shift', '/playlists', '/reviews', 'mhoydich.github.io'];
const julyFirst = new Date('2026-07-01T00:00:00-07:00').getTime();
const editorialBlocksSinceJuly = allBlocks.filter((b) => {
  if (b.data.timestamp.getTime() < julyFirst) return false;
  const url = b.data.external?.url ?? '';
  return EDITORIAL_PATHS.some((p) => url.includes(`pointcast.xyz${p}`) || url.includes(p));
}).length;

// Back-catalog pool: 30+ days old, has a dek, round-robin across channels so
// no single desk (Cola posters, objkt drops) floods the shelf.
const CATALOG_MIN_AGE_MS = 30 * 24 * 60 * 60 * 1000;
const catalogCutoff = Date.now() - CATALOG_MIN_AGE_MS;
const catalogByChannel = new Map<string, typeof allBlocks>();
for (const block of allBlocks) {
  const d = block.data;
  if (d.timestamp.getTime() > catalogCutoff) continue;
  if (!d.dek || d.type === 'BIRTHDAY') continue;
  if (/^Nouns Cola poster/i.test(d.title)) continue;
  const list = catalogByChannel.get(d.channel) ?? [];
  if (list.length >= 6) continue;
  list.push(block);
  catalogByChannel.set(d.channel, list);
}
const catalogPool: CatalogItem[] = [];
for (let round = 0; catalogPool.length < 30; round++) {
  let added = false;
  for (const [, list] of catalogByChannel) {
    const block = list[round];
    if (!block) continue;
    added = true;
    const d = block.data;
    const channel = getChannel(d.channel);
    const media = d.media as { kind?: string; src?: string; thumbnail?: string; alt?: string } | undefined;
    // Prefer the block's own OG card (~13 KB) over the full-size social card; a declared thumbnail wins,
    // and a block whose card has not been generated yet falls back to its Noun.
    const ogCard = `/images/og/b/${d.id}.png`;
    const image = media?.thumbnail ?? (existsSync(`public${ogCard}`) ? ogCard : `https://noun.pics/${d.noun ?? Number(d.id)}.svg`);
    catalogPool.push({
      id: d.id,
      title: d.title,
      dek: d.dek ?? '',
      code: d.channel,
      channelName: channel?.name ?? d.channel,
      color: channel?.color800 ?? '#111',
      bg: channel?.color50 ?? '#fff',
      date: ptMonthYear.format(d.timestamp),
      image,
      imageAlt: media?.alt ?? '',
      href: `/b/${d.id}`,
    });
    if (catalogPool.length >= 30) break;
  }
  if (!added) break;
}

