  visitsTotal: 108864,       // GET /api/visit .count (2026-09-01) — refreshed live below
  visitsLast100: [           // GET /api/visit .log[] tallied (2026-09-01, 82-minute window) — refreshed live below
    { type: 'bot:other', count: 90 }, { type: 'bot:seo', count: 6 }, { type: 'bot:google', count: 1 },
    { type: 'bot:apple', count: 1 }, { type: 'bot:baidu', count: 1 }, { type: 'ai:anthropic', count: 1 }, { type: 'human', count: 0 },
