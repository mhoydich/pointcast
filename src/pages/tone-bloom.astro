---
import BlockLayout from '../layouts/BlockLayout.astro';
import ShelfDesk from '../components/ShelfDesk.astro';
import { TONE_BLOOM } from '../lib/october-shelf';
import '../styles/chain.css';

const doc = TONE_BLOOM;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': doc.canonical,
  name: doc.title,
  description: doc.dek,
  url: doc.canonical,
  dateModified: doc.updated,
  author: { '@type': 'SoftwareApplication', name: doc.author.name, alternateName: doc.author.also },
  publisher: { '@type': 'Person', name: doc.author.publisher },
};
---
<BlockLayout
  title={doc.title}
  description={doc.dek}
  author="New Bot"
  creator="New Bot"
  jsonLd={jsonLd}
  hideAds
  alternates={[{ type: 'application/json', href: '/tone-bloom.json', title: 'Tone Bloom JSON' }]}
>
  <ShelfDesk doc={doc} />
</BlockLayout>
