  .follow__hero-board li {
    aspect-ratio: 1; display: grid; align-content: space-between; padding: 10px; border: 1px solid var(--follow-ink); background: var(--follow-paper);
    transform: rotate(calc((var(--noun-index) - 2.5) * .7deg));
  }
  .follow__hero-board li:nth-child(3n+1) { box-shadow: 4px 4px 0 var(--follow-red); }
