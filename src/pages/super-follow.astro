---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  SUPER_FOLLOW_BOUNDARIES,
  SUPER_FOLLOW_LENSES,
  SUPER_FOLLOW_OUTPUTS,
  SUPER_FOLLOW_PORTABLE_FOLLOW,
  SUPER_FOLLOW_RELATIONSHIPS,
  SUPER_FOLLOW_SIGNALS,
  SUPER_FOLLOW_SOURCES,
} from '../data/super-follow';

const sourceById = new Map(SUPER_FOLLOW_SOURCES.map((source) => [source.id, source]));
const description = 'Super Follow turns scattered public sources into personal, attributable broadcasters with a local Follow Shelf, portable receipts, standards feeds, relationship states, and a bounded Want Desk.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/super-follow#app',
  name: 'Super Follow — personal broadcaster studio',
  description,
  url: 'https://pointcast.xyz/super-follow',
  applicationCategory: 'NewsApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  about: {
    '@type': 'Organization',
    name: 'Sony',
    url: 'https://www.sony.com/',
  },
};
---

<BlockLayout
  title="Super Follow"
  description={description}
  themeColor="#eaff57"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/super-follow.json', title: 'Super Follow machine contract' },
    { type: 'application/feed+json', href: '/super-follow.feed.json', title: 'Sony personal broadcaster JSON Feed' },
    { type: 'application/rss+xml', href: '/super-follow.xml', title: 'Sony personal broadcaster RSS' },
  ]}
>
  <main
    class="follow"
    data-super-follow
    data-mode="basic"
    data-expression="editorial"
    data-shelf-limit={SUPER_FOLLOW_PORTABLE_FOLLOW.maximumLocalBroadcasters}
    data-source-limit={SUPER_FOLLOW_PORTABLE_FOLLOW.sourceLimitPerBroadcaster}
  >
    <header class="follow__topbar">
      <a href="/" aria-label="PointCast home"><strong>PointCast</strong><span>/ Super Follow</span></a>
      <nav aria-label="Super Follow routes">
        <a href="#follow-shelf">Shelf</a>
        <a href="#studio">Studio</a>
        <a href="#sources">Sources</a>
        <a href="#relationship">Relationship</a>
        <a href="#want-desk">Want Desk</a>
      </nav>
      <a class="follow__machine" href="/super-follow.json">JSON ↗</a>
    </header>

    <section class="follow__hero" aria-labelledby="follow-title">
      <div class="follow__hero-copy">
        <p class="follow__kicker">SUPER FOLLOW · PERSONAL BROADCASTER 001</p>
        <h1 id="follow-title">Follow Sony.<br /><em>Your way.</em></h1>
        <p class="follow__dek">
          One company can have a hundred feeds. Super Follow gathers the official
          sources, keeps every receipt, and lets the reader choose the expression.
        </p>
        <div class="follow__hero-actions">
          <a href="#studio">Tune the Sony lens</a>
          <a href="#follow-composer">Build another</a>
          <button type="button" data-local-follow>Follow locally</button>
        </div>
        <p class="follow__local-state" data-local-follow-state aria-live="polite">
          Directional prototype · nothing is following you.
        </p>
      </div>

      <div class="follow__hero-board" aria-label="Super Follow noun flow">
        <div class="follow__sony-card">
          <span>SUBJECT</span>
          <strong>SONY</strong>
          <small>INDEPENDENT FIELD PROTOTYPE</small>
        </div>
        <ol>
          {['Source', 'Lens', 'Signal', 'Follow', 'Want', 'Receipt'].map((noun, index) => (
            <li style={`--noun-index:${index}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{noun}</strong>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="follow__premise" aria-label="Super Follow premise">
      <strong>NOT A SOCIAL FOLLOW BUTTON.</strong>
      <p>A small factory for a personal, attributable, subscribable broadcaster.</p>
      <span>SOURCES → CANON → LENS → BROADCAST → RELATIONSHIP → MARKET</span>
    </section>

    <section class="follow-shelf" id="follow-shelf" aria-labelledby="follow-shelf-title">
      <header>
        <div>
          <p class="follow__kicker">FOLLOW SHELF · DEVICE LOCAL</p>
          <h2 id="follow-shelf-title">Build a shelf of signals.</h2>
        </div>
        <p>
          Sony is the first card, not the whole product. Keep a small collection
          of companies, scenes, products, and odd obsessions—with the source
          doors written directly on every receipt.
        </p>
      </header>

      <div class="follow-shelf__grid">
        <section class="follow-shelf__collection" aria-labelledby="saved-follows-title">
          <div class="follow-shelf__tools">
            <div>
              <span id="saved-follows-title">YOUR LOCAL BROADCASTERS</span>
              <strong data-shelf-count>0 follows</strong>
            </div>
            <div>
              <button type="button" data-copy-shelf>Copy shelf JSON</button>
              <button type="button" data-clear-shelf>Clear local shelf</button>
            </div>
          </div>

          <div class="follow-shelf__cards" data-follow-shelf-list>
            <article class="follow-shelf__empty" data-follow-shelf-empty>
              <span>EMPTY SHELF</span>
              <strong>Follow Sony, or build the next broadcaster.</strong>
              <p>Nothing here has left this browser.</p>
            </article>
          </div>

          <aside class="follow-shelf__receipt" aria-live="polite">
            <span>PORTABLE FOLLOW RECEIPT</span>
            <pre data-follow-receipt>{`{
  "schema": "pointcast.follow/v1",
  "state": "waiting-for-a-local-follow",
  "networkTransmission": false
}`}</pre>
          </aside>
        </section>

        <form class="follow-composer" id="follow-composer" data-follow-composer>
          <div class="follow-composer__title">
            <span>NEW BROADCASTER</span>
            <strong>One subject.<br />Several doors.</strong>
          </div>
          <label>
            <span>SUBJECT NOUN</span>
            <input name="subject" maxlength="80" required placeholder="A studio, company, city, artist…" />
          </label>
          <label>
            <span>CANONICAL FRONT DOOR</span>
            <input name="canonicalUrl" type="url" required placeholder="https://example.com/" />
          </label>
          <label>
            <span>SOURCE DOORS · ONE URL PER LINE</span>
            <textarea
              name="sources"
              rows="5"
              required
              placeholder={`Newsroom
https://example.com/news
Product
https://example.com/products`}
            ></textarea>
            <small>Optional label, then URL. Up to eight public HTTP(S) doors.</small>
          </label>
          <label>
            <span>LENS NOUNS</span>
            <input name="lensNouns" maxlength="120" placeholder="Research, releases, products" />
          </label>
          <div class="follow-composer__row">
            <label>
              <span>EXPRESSION</span>
              <select name="expression">
                <option value="editorial">Editorial</option>
                <option value="quiet">Quiet</option>
                <option value="radar">Radar</option>
                <option value="product">Product</option>
              </select>
            </label>
            <label>
              <span>CADENCE</span>
              <select name="cadence">
                <option value="daily">Daily edit</option>
                <option value="weekly" selected>Sunday digest</option>
                <option value="live">Live when connected later</option>
              </select>
            </label>
          </div>
          <button type="submit">Put this follow on my shelf →</button>
          <p data-follow-composer-status aria-live="polite">
            Local receipt only · no crawl, account, message, or subscription request.
          </p>
        </form>
      </div>
    </section>

    <section class="studio" id="studio" aria-labelledby="studio-title">
      <header class="studio__header">
        <div>
          <p class="follow__kicker">THE LENS</p>
          <h2 id="studio-title">What do you mean by “Sony”?</h2>
        </div>
        <div class="mode-switch" role="group" aria-label="Choose lens complexity">
          <button type="button" data-mode-select="basic" aria-pressed="true">Basic</button>
          <button type="button" data-mode-select="advanced" aria-pressed="false">Advanced</button>
        </div>
      </header>

      <div class="studio__grid">
        <aside class="lens-panel" aria-label="Personal broadcaster controls">
          <fieldset>
            <legend>INTEREST NOUNS</legend>
            <div class="lens-chips">
              {SUPER_FOLLOW_LENSES.map((lens) => (
                <label style={`--lens-color:${lens.color}`}>
                  <input
                    type="checkbox"
                    value={lens.id}
                    data-lens-topic
                    data-lens-topics={lens.topics.join(' ')}
                    checked={lens.id === 'camera' || lens.id === 'research'}
                  />
                  <span>{lens.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend>EXPRESSION</legend>
            <div class="expression-list">
              <button type="button" data-expression-select="quiet" aria-pressed="false">
                <b>Quiet</b><small>fewer, slower, official</small>
              </button>
              <button type="button" data-expression-select="editorial" aria-pressed="true">
                <b>Editorial</b><small>one useful reading order</small>
              </button>
              <button type="button" data-expression-select="radar" aria-pressed="false">
                <b>Radar</b><small>research + product movement</small>
              </button>
              <button type="button" data-expression-select="product" aria-pressed="false">
                <b>Product</b><small>products only when relevant</small>
              </button>
            </div>
          </fieldset>

          <div class="advanced-panel" data-advanced-panel>
            <fieldset>
              <legend>SOURCE WEIGHTS</legend>
              <div class="source-toggles">
                {SUPER_FOLLOW_SOURCES.map((source) => (
                  <label>
                    <input
                      type="checkbox"
                      value={source.id}
                      data-source-toggle
                      data-source-name={source.name}
                      data-source-url={source.url}
                      data-source-feed={source.feedUrl || ''}
                      checked
                    />
                    <span style={`--source-color:${source.color}`}>{source.noun}</span>
                    <small>{source.transport}</small>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset>
              <legend>DELIVERY</legend>
              <label class="select-row">
                <span>CADENCE</span>
                <select data-cadence>
                  <option value="live">Live feed</option>
                  <option value="daily">Daily edit</option>
                  <option value="weekly" selected>Sunday digest</option>
                </select>
              </label>
              <label class="check-row">
                <input type="checkbox" data-commerce-toggle checked />
                <span>Allow relevant product signals</span>
              </label>
            </fieldset>

            <aside class="advanced-note">
              <span>ADVANCED SECURITY DIRECTION</span>
              <p>Revocable grants · sender-constrained DPoP tokens · signed webhooks · source receipts.</p>
            </aside>
          </div>
        </aside>

        <section class="broadcaster" aria-labelledby="broadcaster-title">
          <header class="broadcaster__header">
            <div>
              <p>YOUR SONY / SUNDAY EDIT</p>
              <h3 id="broadcaster-title">Cameras, research, and useful ownership signals.</h3>
            </div>
            <span data-signal-count>{SUPER_FOLLOW_SIGNALS.length} signals</span>
          </header>

          <div class="broadcaster__view-switch" role="group" aria-label="Choose output expression">
            <button type="button" data-view-select="cards" aria-pressed="true">Dashboard</button>
            <button type="button" data-view-select="digest" aria-pressed="false">Digest</button>
            <button type="button" data-view-select="machine" aria-pressed="false">Feed</button>
          </div>

          <div class="signal-list" data-signal-list>
            {SUPER_FOLLOW_SIGNALS.map((signal, index) => {
              const source = sourceById.get(signal.sourceId)!;
              return (
                <article
                  data-signal
                  data-source={signal.sourceId}
                  data-topics={signal.topics.join(' ')}
                  data-commerce={signal.commerce ? 'true' : 'false'}
                  style={`--signal-color:${source.color}`}
                >
                  <div class="signal-card__number">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <b>{signal.noun}</b>
                  </div>
                  <div class="signal-card__copy">
                    <p>{source.name} · {new Date(signal.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</p>
                    <h4>{signal.title}</h4>
                    <p>{signal.summary}</p>
                    <div>
                      {signal.topics.map((topic) => <span>#{topic}</span>)}
                      {signal.commerce && <span>PRODUCT-ADJACENT</span>}
                    </div>
                  </div>
                  <a href={signal.url} target="_blank" rel="noopener">
                    Official source <span aria-hidden="true">↗</span>
                  </a>
                </article>
              );
            })}
          </div>

          <div class="empty-signal" data-empty-signal hidden>
            <strong>No signals match this lens.</strong>
            <p>Open another noun or return to the editorial expression.</p>
          </div>

          <aside class="broadcaster__machine-preview" data-machine-preview hidden>
            <span>APPLICATION / FEED+JSON</span>
            <code>{`{
  "title": "Mike’s Sony broadcaster",
  "lens": ["camera", "research"],
  "expression": "editorial",
  "receipts": true,
  "relationship": "following"
}`}</code>
          </aside>

          <footer class="broadcaster__subscribe">
            <div>
              <strong>Keep the broadcaster.</strong>
              <span data-subscribe-note>Save this lens locally or use a standards feed.</span>
            </div>
            <nav aria-label="Sony broadcaster subscriptions">
              <a href="/super-follow.xml">RSS</a>
              <a href="/super-follow.feed.json">JSON Feed</a>
              <button type="button" data-local-follow>Follow locally</button>
            </nav>
          </footer>
        </section>
      </div>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-title">
      <header>
        <p class="follow__kicker">SOURCE RECEIPTS</p>
        <h2 id="sources-title">No mystery meat feed.</h2>
        <p>Each lane says who published it, what kind of source it is, and where the original lives.</p>
      </header>
      <div class="sources__grid">
        {SUPER_FOLLOW_SOURCES.map((source, index) => (
          <a href={source.url} target="_blank" rel="noopener" style={`--source-color:${source.color}`}>
            <span>{String(index + 1).padStart(2, '0')} · {source.trust}</span>
            <strong>{source.noun}</strong>
            <h3>{source.name}</h3>
            <p>{source.note}</p>
            <small>{source.feedUrl ? 'OFFICIAL FEED + PAGE' : 'OFFICIAL PAGE'} ↗</small>
          </a>
        ))}
      </div>
    </section>

    <section class="relationship" id="relationship" aria-labelledby="relationship-title">
      <header>
        <p class="follow__kicker">THE RELATIONSHIP RAIL</p>
        <h2 id="relationship-title">A follow can grow up.</h2>
        <p>Reading is not agreement. Agreement is not a signature. A signature is not a purchase.</p>
      </header>
      <div class="relationship__rail" role="list" aria-label="Relationship states">
        {SUPER_FOLLOW_RELATIONSHIPS.map((state, index) => (
          <button
            type="button"
            role="listitem"
            data-relationship-select={state.id}
            data-status={state.status}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{state.noun}</strong>
            <small>{state.status}</small>
          </button>
        ))}
      </div>
      <aside class="relationship__detail" aria-live="polite">
        <span data-relationship-code>01 / OBSERVE</span>
        <strong data-relationship-title>Public sources with receipts.</strong>
        <p data-relationship-note>{SUPER_FOLLOW_RELATIONSHIPS[0].note}</p>
      </aside>
    </section>

    <section class="want-desk" id="want-desk" aria-labelledby="want-title">
      <div class="want-desk__intro">
        <p class="follow__kicker">WANT DESK · RFP 001</p>
        <h2 id="want-title">Say what would be useful.</h2>
        <p>
          Modern shopping can begin with a declared need, not a surveillance
          profile. Make a local Want; decide later who may see it.
        </p>
        <div class="want-desk__nouns" aria-label="Want flow">
          <span>WANT</span><i></i><span>INVITE</span><i></i><span>OFFER</span><i></i><span>RECEIPT</span>
        </div>
      </div>

      <form class="want-form" data-want-form>
        <label class="want-form__prompt">
          <span>I AM LOOKING FOR</span>
          <textarea name="request" rows="4">A compact Sony camera with excellent low-light performance, under $2,000, before August.</textarea>
        </label>
        <div class="want-form__row">
          <label>
            <span>CATEGORY</span>
            <select name="category">
              <option value="camera">Camera</option>
              <option value="audio">Audio</option>
              <option value="game">Game</option>
              <option value="service">Service</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            <span>BUDGET</span>
            <input name="budget" value="USD 2,000 maximum" />
          </label>
          <label>
            <span>VISIBILITY</span>
            <select name="visibility">
              <option value="private">Private draft</option>
              <option value="invited">Invited sellers later</option>
              <option value="public">Public RFP later</option>
            </select>
          </label>
        </div>
        <label class="check-row">
          <input type="checkbox" name="allowOffers" />
          <span>Allow structured offers later—never automatic checkout.</span>
        </label>
        <button type="submit">Make a local Want →</button>
        <p data-want-status aria-live="polite">Nothing has been sent anywhere.</p>
      </form>

      <aside class="want-receipt" aria-labelledby="want-receipt-title">
        <span id="want-receipt-title">LOCAL WANT RECEIPT</span>
        <pre data-want-output>{`{
  "state": "draft",
  "subject": "Sony camera",
  "visibility": "private",
  "sent": false
}`}</pre>
      </aside>
    </section>

    <section class="security" aria-labelledby="security-title">
      <header>
        <p class="follow__kicker">MODERN CONNECTIONS · LATER</p>
        <h2 id="security-title">Security underneath. Nouns up top.</h2>
      </header>
      <div>
        <article><span>01</span><strong>Grant</strong><p>Narrow scope, purpose, duration, and revocation.</p></article>
        <article><span>02</span><strong>DPoP</strong><p>Sender-constrained tokens for connected devices and agents.</p></article>
        <article><span>03</span><strong>Webhook</strong><p>Signed source and offer events with replay protection.</p></article>
        <article><span>04</span><strong>Receipt</strong><p>Human-readable proof of what was agreed and what happened.</p></article>
      </div>
    </section>

    <footer class="follow__footer">
      <div>
        <strong>PROTOTYPE BOUNDARY</strong>
        <ul>{SUPER_FOLLOW_BOUNDARIES.map((boundary) => <li>{boundary}</li>)}</ul>
      </div>
      <nav aria-label="Super Follow outputs">
        {SUPER_FOLLOW_OUTPUTS.map((output) => (
          <a href={output.href}><strong>{output.noun}</strong><span>{output.type}</span></a>
        ))}
      </nav>
    </footer>
  </main>

  <script>
    type FollowMode = 'basic' | 'advanced';
    type FollowExpression = 'quiet' | 'editorial' | 'radar' | 'product';
    type FollowView = 'cards' | 'digest' | 'machine';

    interface SavedLens {
      mode: FollowMode;
      expression: FollowExpression;
      topics: string[];
      sources: string[];
      commerce: boolean;
      cadence: string;
      followed?: boolean;
    }

    interface FollowSourceReceipt {
      label: string;
      url: string;
      feedUrl?: string;
    }

    interface SavedBroadcaster {
      schema: 'pointcast.follow/v1';
      id: string;
      subject: string;
      canonicalUrl: string;
      sources: FollowSourceReceipt[];
      lensNouns: string[];
      expression: FollowExpression;
      cadence: string;
      relationship: 'following';
      storage: 'browser-local';
      networkTransmission: false;
      sourceFetch: false;
      connected: false;
      signed: false;
      createdAt: string;
      updatedAt: string;
    }

    const LENS_KEY = 'pc:super-follow:sony:v1';
    const SHELF_KEY = 'pc:super-follow:shelf:v1';
    const WANT_KEY = 'pc:super-follow:wants:v1';

    function initSuperFollow() {
      const root = document.querySelector<HTMLElement>('[data-super-follow]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const shelfLimit = Math.max(1, Number(root.dataset.shelfLimit || 12));
      const sourceLimit = Math.max(1, Number(root.dataset.sourceLimit || 8));

      const defaultLens: SavedLens = {
        mode: 'basic',
        expression: 'editorial',
        topics: ['camera', 'research'],
        sources: Array.from(root.querySelectorAll<HTMLInputElement>('[data-source-toggle]')).map((input) => input.value),
        commerce: true,
        cadence: 'weekly',
      };

      let lens = defaultLens;
      try {
        const saved = JSON.parse(localStorage.getItem(LENS_KEY) || 'null') as Partial<SavedLens> | null;
        if (saved) lens = { ...defaultLens, ...saved };
      } catch {
        lens = defaultLens;
      }

      let view: FollowView = 'cards';

      const modeButtons = root.querySelectorAll<HTMLButtonElement>('[data-mode-select]');
      const expressionButtons = root.querySelectorAll<HTMLButtonElement>('[data-expression-select]');
      const viewButtons = root.querySelectorAll<HTMLButtonElement>('[data-view-select]');
      const topicInputs = root.querySelectorAll<HTMLInputElement>('[data-lens-topic]');
      const sourceInputs = root.querySelectorAll<HTMLInputElement>('[data-source-toggle]');
      const commerceInput = root.querySelector<HTMLInputElement>('[data-commerce-toggle]');
      const cadenceInput = root.querySelector<HTMLSelectElement>('[data-cadence]');
      const signals = root.querySelectorAll<HTMLElement>('[data-signal]');
      const count = root.querySelector<HTMLElement>('[data-signal-count]');
      const empty = root.querySelector<HTMLElement>('[data-empty-signal]');
      const machinePreview = root.querySelector<HTMLElement>('[data-machine-preview]');
      const followState = root.querySelector<HTMLElement>('[data-local-follow-state]');
      const shelfList = root.querySelector<HTMLElement>('[data-follow-shelf-list]');
      const shelfEmpty = root.querySelector<HTMLElement>('[data-follow-shelf-empty]');
      const shelfCount = root.querySelector<HTMLElement>('[data-shelf-count]');
      const shelfReceipt = root.querySelector<HTMLElement>('[data-follow-receipt]');
      const followComposer = root.querySelector<HTMLFormElement>('[data-follow-composer]');
      const followComposerStatus = root.querySelector<HTMLElement>('[data-follow-composer-status]');
      let shelf: SavedBroadcaster[] = [];

      function cleanHttpUrl(value: string): string | null {
        try {
          const url = new URL(value.trim());
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return null;
          url.hash = '';
          return url.toString();
        } catch {
          return null;
        }
      }

      function safeText(value: unknown, maximum: number): string {
        return typeof value === 'string' ? value.trim().slice(0, maximum) : '';
      }

      function hostLabel(url: string): string {
        try {
          return new URL(url).hostname.replace(/^www\./, '');
        } catch {
          return 'Source';
        }
      }

      function normalizeBroadcaster(value: unknown): SavedBroadcaster | null {
        if (!value || typeof value !== 'object') return null;
        const candidate = value as Partial<SavedBroadcaster>;
        const subject = safeText(candidate.subject, 80);
        const canonicalUrl = cleanHttpUrl(String(candidate.canonicalUrl || ''));
        if (!subject || !canonicalUrl || !Array.isArray(candidate.sources)) return null;
        const sources = candidate.sources
          .map((source) => {
            if (!source || typeof source !== 'object') return null;
            const sourceValue = source as Partial<FollowSourceReceipt>;
            const url = cleanHttpUrl(String(sourceValue.url || ''));
            if (!url) return null;
            const feedUrl = sourceValue.feedUrl ? cleanHttpUrl(String(sourceValue.feedUrl)) : null;
            return {
              label: safeText(sourceValue.label, 60) || hostLabel(url),
              url,
              ...(feedUrl ? { feedUrl } : {}),
            };
          })
          .filter((source): source is FollowSourceReceipt => Boolean(source))
          .slice(0, sourceLimit);
        if (!sources.length) return null;
        const expression: FollowExpression = ['quiet', 'editorial', 'radar', 'product'].includes(String(candidate.expression))
          ? candidate.expression as FollowExpression
          : 'editorial';
        const now = new Date().toISOString();
        return {
          schema: 'pointcast.follow/v1',
          id: safeText(candidate.id, 100) || `follow-${Date.now().toString(36)}`,
          subject,
          canonicalUrl,
          sources,
          lensNouns: Array.isArray(candidate.lensNouns)
            ? candidate.lensNouns.map((noun) => safeText(noun, 30)).filter(Boolean).slice(0, 6)
            : [],
          expression,
          cadence: safeText(candidate.cadence, 20) || 'weekly',
          relationship: 'following',
          storage: 'browser-local',
          networkTransmission: false,
          sourceFetch: false,
          connected: false,
          signed: false,
          createdAt: safeText(candidate.createdAt, 40) || now,
          updatedAt: safeText(candidate.updatedAt, 40) || now,
        };
      }

      function loadShelf() {
        try {
          const stored = JSON.parse(localStorage.getItem(SHELF_KEY) || '[]');
          shelf = Array.isArray(stored)
            ? stored.map(normalizeBroadcaster).filter((follow): follow is SavedBroadcaster => Boolean(follow)).slice(0, shelfLimit)
            : [];
        } catch {
          shelf = [];
        }
      }

      function saveShelf(): boolean {
        try {
          localStorage.setItem(SHELF_KEY, JSON.stringify(shelf));
          return true;
        } catch {
          return false;
        }
      }

      function showFollowReceipt(follow: unknown) {
        if (shelfReceipt) shelfReceipt.textContent = JSON.stringify(follow, null, 2);
      }

      function makeTextElement<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        className: string,
        text: string,
      ): HTMLElementTagNameMap[K] {
        const element = document.createElement(tag);
        if (className) element.className = className;
        element.textContent = text;
        return element;
      }

      function renderShelf() {
        if (!shelfList) return;
        shelfList.querySelectorAll('[data-follow-card]').forEach((card) => card.remove());
        if (shelfEmpty) shelfEmpty.hidden = shelf.length > 0;
        if (shelfCount) shelfCount.textContent = `${shelf.length} follow${shelf.length === 1 ? '' : 's'}`;

        const colors = ['#eaff57', '#5ce1e6', '#ff8cc6', '#ffb347', '#d7c8ff'];
        shelf.forEach((follow, index) => {
          const card = document.createElement('article');
          card.className = 'follow-shelf__card';
          card.dataset.followCard = follow.id;
          card.style.setProperty('--card-color', colors[index % colors.length]);

          const eyebrow = makeTextElement('div', 'follow-shelf__card-meta', `LOCAL FOLLOW · ${String(index + 1).padStart(2, '0')}`);
          const title = makeTextElement('h3', '', follow.subject);
          const canonical = document.createElement('a');
          canonical.href = follow.canonicalUrl;
          canonical.target = '_blank';
          canonical.rel = 'noopener';
          canonical.textContent = hostLabel(follow.canonicalUrl);

          const facts = document.createElement('div');
          facts.className = 'follow-shelf__facts';
          facts.append(
            makeTextElement('span', '', `${follow.sources.length} source${follow.sources.length === 1 ? '' : 's'}`),
            makeTextElement('span', '', follow.cadence),
            makeTextElement('span', '', follow.expression),
          );
          if (follow.lensNouns.length) {
            facts.append(makeTextElement('span', '', follow.lensNouns.join(' · ')));
          }

          const actions = document.createElement('div');
          actions.className = 'follow-shelf__card-actions';
          for (const [action, label] of [['view', 'Open receipt'], ['copy', 'Copy JSON'], ['remove', 'Remove local']]) {
            const button = makeTextElement('button', '', label);
            button.type = 'button';
            button.dataset.followAction = action;
            button.dataset.followId = follow.id;
            actions.append(button);
          }

          card.append(eyebrow, title, canonical, facts, actions);
          shelfList.append(card);
        });
      }

      function upsertFollow(value: SavedBroadcaster): boolean {
        const normalized = normalizeBroadcaster(value);
        if (!normalized) return false;
        shelf = [normalized, ...shelf.filter((follow) => follow.id !== normalized.id)].slice(0, shelfLimit);
        const stored = saveShelf();
        renderShelf();
        showFollowReceipt(normalized);
        return stored;
      }

      function parseSourceDoors(value: string): FollowSourceReceipt[] {
        const lines = value.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
        const sources: FollowSourceReceipt[] = [];
        const seen = new Set<string>();
        let pendingLabel = '';
        for (const line of lines) {
          const url = cleanHttpUrl(line);
          if (!url) {
            pendingLabel = line.slice(0, 60);
            continue;
          }
          if (seen.has(url)) continue;
          seen.add(url);
          sources.push({ label: pendingLabel || hostLabel(url), url });
          pendingLabel = '';
          if (sources.length >= sourceLimit) break;
        }
        return sources;
      }

      function sonyFollowReceipt(): SavedBroadcaster {
        const now = new Date().toISOString();
        const existing = shelf.find((follow) => follow.id === 'sony');
        const checkedSources = Array.from(sourceInputs).filter((input) => input.checked);
        return {
          schema: 'pointcast.follow/v1',
          id: 'sony',
          subject: 'Sony',
          canonicalUrl: 'https://www.sony.com/',
          sources: checkedSources.map((input) => ({
            label: input.dataset.sourceName || hostLabel(input.dataset.sourceUrl || ''),
            url: input.dataset.sourceUrl || 'https://www.sony.com/',
            ...(input.dataset.sourceFeed ? { feedUrl: input.dataset.sourceFeed } : {}),
          })),
          lensNouns: Array.from(topicInputs)
            .filter((input) => input.checked)
            .map((input) => input.nextElementSibling?.textContent?.trim() || input.value),
          expression: lens.expression,
          cadence: cadenceInput?.value || lens.cadence,
          relationship: 'following',
          storage: 'browser-local',
          networkTransmission: false,
          sourceFetch: false,
          connected: false,
          signed: false,
          createdAt: existing?.createdAt || now,
          updatedAt: now,
        };
      }

      loadShelf();

      function selectedLensIds(): string[] {
        return Array.from(topicInputs).filter((input) => input.checked).map((input) => input.value);
      }

      function selectedTopics(): string[] {
        return Array.from(topicInputs)
          .filter((input) => input.checked)
          .flatMap((input) => (input.dataset.lensTopics || input.value).split(' '));
      }

      function selectedSources(): string[] {
        return Array.from(sourceInputs).filter((input) => input.checked).map((input) => input.value);
      }

      function syncControls() {
        root!.dataset.mode = lens.mode;
        root!.dataset.expression = lens.expression;
        modeButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.modeSelect === lens.mode));
        });
        expressionButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.expressionSelect === lens.expression));
        });
        topicInputs.forEach((input) => {
          input.checked = lens.topics.includes(input.value);
        });
        sourceInputs.forEach((input) => {
          input.checked = lens.sources.includes(input.value);
        });
        if (commerceInput) commerceInput.checked = lens.commerce;
        if (cadenceInput) cadenceInput.value = lens.cadence;
        if (followState && lens.followed) {
          followState.textContent = `Following locally · ${lens.cadence} · ${lens.expression} lens.`;
        }
      }

      function renderSignals() {
        const topics = selectedTopics();
        const sources = selectedSources();
        const allowCommerce = commerceInput?.checked ?? true;
        let visible = 0;

        signals.forEach((signal) => {
          const signalTopics = (signal.dataset.topics || '').split(' ');
          const sourceMatch = sources.includes(signal.dataset.source || '');
          const topicMatch = topics.length === 0 || topics.some((topic) => signalTopics.includes(topic));
          const commerceMatch = allowCommerce || signal.dataset.commerce !== 'true';
          const expressionMatch =
            lens.expression === 'product'
              ? signal.dataset.commerce === 'true'
              : lens.expression === 'quiet'
                ? signal.dataset.commerce !== 'true'
                : true;
          const show = sourceMatch && topicMatch && commerceMatch && expressionMatch;
          signal.hidden = !show;
          if (show) visible += 1;
        });

        count && (count.textContent = `${visible} signal${visible === 1 ? '' : 's'}`);
        if (empty) empty.hidden = visible !== 0;
        if (machinePreview) machinePreview.hidden = view !== 'machine';
        root!.dataset.view = view;
      }

      function updateLensFromControls() {
        lens = {
          ...lens,
          topics: selectedLensIds(),
          sources: selectedSources(),
          commerce: commerceInput?.checked ?? true,
          cadence: cadenceInput?.value || 'weekly',
        };
        renderSignals();
      }

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          lens.mode = button.dataset.modeSelect as FollowMode;
          syncControls();
          renderSignals();
        });
      });

      expressionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          lens.expression = button.dataset.expressionSelect as FollowExpression;
          syncControls();
          renderSignals();
        });
      });

      viewButtons.forEach((button) => {
        button.addEventListener('click', () => {
          view = button.dataset.viewSelect as FollowView;
          viewButtons.forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === button));
          });
          renderSignals();
        });
      });

      topicInputs.forEach((input) => input.addEventListener('change', updateLensFromControls));
      sourceInputs.forEach((input) => input.addEventListener('change', updateLensFromControls));
      commerceInput?.addEventListener('change', updateLensFromControls);
      cadenceInput?.addEventListener('change', updateLensFromControls);

      root.querySelectorAll<HTMLButtonElement>('[data-local-follow]').forEach((button) => {
        button.addEventListener('click', () => {
          updateLensFromControls();
          lens.followed = true;
          try {
            localStorage.setItem(LENS_KEY, JSON.stringify(lens));
            syncControls();
            button.textContent = 'Following locally ✓';
            const shelfStored = upsertFollow(sonyFollowReceipt());
            if (followState && !shelfStored) {
              followState.textContent = 'Sony receipt prepared, but this browser blocked the Follow Shelf.';
            }
          } catch {
            if (followState) {
              followState.textContent = 'This browser blocked local storage. RSS and JSON Feed still work.';
            }
          }
        });
      });

      shelfList?.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-follow-action]');
        if (!button) return;
        const follow = shelf.find((candidate) => candidate.id === button.dataset.followId);
        if (!follow) return;
        const action = button.dataset.followAction;
        if (action === 'view') {
          showFollowReceipt(follow);
          button.textContent = 'Receipt open ✓';
        }
        if (action === 'copy') {
          showFollowReceipt(follow);
          try {
            await navigator.clipboard.writeText(JSON.stringify(follow, null, 2));
            button.textContent = 'Copied ✓';
          } catch {
            button.textContent = 'Receipt open below';
          }
        }
        if (action === 'remove') {
          shelf = shelf.filter((candidate) => candidate.id !== follow.id);
          saveShelf();
          renderShelf();
          showFollowReceipt(shelf);
          if (followComposerStatus) {
            followComposerStatus.textContent = `${follow.subject} was removed from this browser’s shelf. Nothing was sent.`;
          }
        }
      });

      root.querySelector<HTMLButtonElement>('[data-copy-shelf]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const packet = {
          schema: 'pointcast.follow-shelf/v1',
          follows: shelf,
          networkTransmission: false,
        };
        showFollowReceipt(packet);
        try {
          await navigator.clipboard.writeText(JSON.stringify(packet, null, 2));
          button.textContent = 'Shelf copied ✓';
        } catch {
          button.textContent = 'Shelf opened below';
        }
      });

      root.querySelector<HTMLButtonElement>('[data-clear-shelf]')?.addEventListener('click', () => {
        if (!window.confirm('Clear every local Super Follow receipt from this browser?')) return;
        shelf = [];
        saveShelf();
        renderShelf();
        showFollowReceipt(shelf);
        if (followComposerStatus) followComposerStatus.textContent = 'Local shelf cleared. Nothing was sent anywhere.';
      });

      followComposer?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(followComposer);
        const subject = safeText(form.get('subject'), 80);
        const canonicalUrl = cleanHttpUrl(String(form.get('canonicalUrl') || ''));
        const sources = parseSourceDoors(String(form.get('sources') || ''));
        if (!subject || !canonicalUrl || !sources.length) {
          if (followComposerStatus) {
            followComposerStatus.textContent = 'Add a subject, a valid HTTP(S) front door, and at least one valid source URL.';
          }
          return;
        }
        const lensNouns = String(form.get('lensNouns') || '')
          .split(',')
          .map((noun) => safeText(noun, 30))
          .filter(Boolean)
          .slice(0, 6);
        const now = new Date().toISOString();
        const slug = subject.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'subject';
        const follow: SavedBroadcaster = {
          schema: 'pointcast.follow/v1',
          id: `${slug}-${Date.now().toString(36)}`,
          subject,
          canonicalUrl,
          sources,
          lensNouns,
          expression: String(form.get('expression') || 'editorial') as FollowExpression,
          cadence: String(form.get('cadence') || 'weekly'),
          relationship: 'following',
          storage: 'browser-local',
          networkTransmission: false,
          sourceFetch: false,
          connected: false,
          signed: false,
          createdAt: now,
          updatedAt: now,
        };
        const stored = upsertFollow(follow);
        if (followComposerStatus) {
          followComposerStatus.textContent = stored
            ? `${subject} is on this browser’s shelf. No source was fetched and no follow request was sent.`
            : 'Receipt prepared, but this browser blocked local storage. Nothing was sent.';
        }
      });

      const relationshipStates = [
        ['observing', 'Public sources with receipts.'],
        ['following', 'One saved lens and standards feeds.'],
        ['connected', 'Owned products, support, or membership.'],
        ['agreed', 'A narrow bilateral purpose and data boundary.'],
        ['signed', 'A revocable grant or relationship receipt.'],
        ['transacting', 'Structured offers with separate checkout approval.'],
      ];
      const relationshipButtons = root.querySelectorAll<HTMLButtonElement>('[data-relationship-select]');
      relationshipButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.relationshipSelect || 'observing';
          const index = relationshipStates.findIndex(([stateId]) => stateId === id);
          const state = relationshipStates[Math.max(index, 0)];
          const note = button.dataset.status === 'future'
            ? `${state[1]} Direction only—this state is not active.`
            : state[1];
          relationshipButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          const code = root.querySelector<HTMLElement>('[data-relationship-code]');
          const title = root.querySelector<HTMLElement>('[data-relationship-title]');
          const detail = root.querySelector<HTMLElement>('[data-relationship-note]');
          code && (code.textContent = `${String(index + 1).padStart(2, '0')} / ${id.toUpperCase()}`);
          title && (title.textContent = state[1]);
          detail && (detail.textContent = note);
        });
      });

      const wantForm = root.querySelector<HTMLFormElement>('[data-want-form]');
      wantForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(wantForm);
        const receipt = {
          schema: 'pointcast.want/v1',
          id: `want-local-${Date.now().toString(36)}`,
          subject: String(form.get('request') || '').trim(),
          category: String(form.get('category') || 'other'),
          budget: String(form.get('budget') || '').trim(),
          visibility: String(form.get('visibility') || 'private'),
          allowOffersLater: form.get('allowOffers') === 'on',
          state: 'local-draft',
          sent: false,
          orderCreated: false,
          paymentInitiated: false,
          createdAt: new Date().toISOString(),
        };
        const output = root.querySelector<HTMLElement>('[data-want-output]');
        const status = root.querySelector<HTMLElement>('[data-want-status]');
        output && (output.textContent = JSON.stringify(receipt, null, 2));
        try {
          const stored = JSON.parse(localStorage.getItem(WANT_KEY) || '[]');
          const existing = Array.isArray(stored) ? stored : [];
          localStorage.setItem(WANT_KEY, JSON.stringify([receipt, ...existing].slice(0, 6)));
          status && (status.textContent = 'Local Want saved. Nothing was sent; no seller, order, or payment was created.');
        } catch {
          status && (status.textContent = 'Want receipt prepared, but this browser blocked local storage. Nothing was sent.');
        }
      });

      syncControls();
      if (lens.followed) {
        upsertFollow(sonyFollowReceipt());
      } else {
        renderShelf();
      }
      renderSignals();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSuperFollow, { once: true });
    } else {
      initSuperFollow();
    }
  </script>
</BlockLayout>

