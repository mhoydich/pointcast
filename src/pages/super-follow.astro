  .follow-shelf__card-actions button {
    min-height: 38px; padding: 9px 10px; border: 1px solid; background: white; color: inherit;
    font: 800 8px/1 var(--pc-font-mono); letter-spacing: .05em; text-transform: uppercase; cursor: pointer;
  }
  .follow-shelf__cards { min-height: 410px; display: grid; grid-template-columns: 1fr 1fr; align-content: start; gap: 10px; padding: 16px; }
