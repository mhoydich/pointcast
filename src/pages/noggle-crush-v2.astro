---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Noggle Crush v2';
const description = 'A Windows 95 Nouns match-3 campaign: five rising levels, striped and rainbow specials, plus new bomb noggles from cross-shaped matches.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Game',
  '@id': 'https://pointcast.xyz/noggle-crush-v2',
  name: title,
  description,
  url: 'https://pointcast.xyz/noggle-crush-v2',
};
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.desktop} jsonLd={jsonLd}>
  <main class="desk" data-crush style={`--arcade-desktop:url('${ARCADE_ASSETS.desktop}');`}>
    <section class="window" aria-labelledby="crush-title">
      <header class="titlebar"><span id="crush-title">Noggle Crush v2</span><span class="buttons" aria-hidden="true"><i>_</i><i>□</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Crush menu">
        <button type="button" data-new>Game</button>
        <button type="button" data-hint>Hint</button>
        <a href="/win95-games">All games</a>
        <a href="/noggle-crush">v1</a>
        <a href="/nouns-jam-v2">Jam v2</a>
        <a href="/nouns-jelly-v2">Jelly v2</a>
      </nav>
      <div class="toolbar">
        <span>Level <strong data-level>1</strong></span>
        <span>Score <strong data-score>0</strong></span>
        <span>Moves <strong data-moves>20</strong></span>
        <span>Target <strong data-target>1500</strong></span>
        <span>Best lvl <strong data-best>--</strong></span>
        <p data-status>Swap neighbors to line up three or more. Clear the target before moves run out.</p>
      </div>
      <div class="felt">
        <div class="board" data-board aria-label="Noggle Crush board"></div>
      </div>
      <footer class="status">Match 4 = striped (row + column). Match 5 = rainbow (clears a color). Cross match = BOMB (3×3). NEW: swap two specials to combo them — striped+striped cross, bomb+bomb 5×5, rainbow+special superclears, rainbow+rainbow wipes the board.</footer>
      <div class="overlay" data-overlay hidden>
        <div class="dialog">
          <header class="titlebar"><span data-overlay-title>Level clear</span></header>
          <p data-overlay-copy>Nice crushing.</p>
          <button type="button" data-again>Continue</button>
        </div>
      </div>
    </section>
  </main>
</BlockLayout>

<script>
  const size = 8;
  const statsKey = 'pc:arcade:noggle-crush-v2';
  const profileKey = 'pc:arcade:profile';
  const LEVELS = [
    { target: 1500, moves: 20 },
    { target: 2500, moves: 22 },
    { target: 3500, moves: 24 },
    { target: 5000, moves: 26 },
    { target: 7000, moves: 28 },
  ];
  const TYPES = [
    { noun: 4, color: '#ff8ba8' },
    { noun: 11, color: '#ffc96b' },
    { noun: 27, color: '#7de08f' },
    { noun: 52, color: '#7ec2ff' },
    { noun: 73, color: '#c9a0f0' },
    { noun: 98, color: '#fff27a' },
  ];
  const boardEl = document.querySelector<HTMLElement>('[data-board]');
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  const levelEl = document.querySelector<HTMLElement>('[data-level]');
  const scoreEl = document.querySelector<HTMLElement>('[data-score]');
  const movesEl = document.querySelector<HTMLElement>('[data-moves]');
  const targetEl = document.querySelector<HTMLElement>('[data-target]');
  const bestEl = document.querySelector<HTMLElement>('[data-best]');
  const overlayEl = document.querySelector<HTMLElement>('[data-overlay]');
  const overlayTitleEl = document.querySelector<HTMLElement>('[data-overlay-title]');
  const overlayCopyEl = document.querySelector<HTMLElement>('[data-overlay-copy]');
  let grid = []; // { type, special: null | 'striped' | 'rainbow' | 'bomb' } or null
  let level = 0;
  let score = 0;
  let moves = LEVELS[0].moves;
  let selected = -1;
  let busy = false;
  let over = false;
  let won = false;

  function readJson(key, fallback) {
    try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
  }
  function writeJson(key, value) { localStorage.setItem(key, JSON.stringify(value)); }
  function say(text) { if (statusEl) statusEl.textContent = text; }
  function idx(x, y) { return y * size + x; }
  function randomTile() { return { type: Math.floor(Math.random() * TYPES.length), special: null }; }

  function updateArcadeProfile(kind) {
    // kind: 'play' (new game), 'level' (cleared a level), 'campaign' (cleared final level)
    const stats = readJson(statsKey, { plays: 0, clears: 0, bestLevel: null });
    if (kind === 'play') stats.plays = Number(stats.plays || 0) + 1;
    if (kind === 'level' || kind === 'campaign') {
      stats.bestLevel = Math.max(Number(stats.bestLevel || 0), level + 1);
    }
    if (kind === 'campaign') stats.clears = Number(stats.clears || 0) + 1;
    writeJson(statsKey, stats);
    const profile = readJson(profileKey, { achievements: [] });
    if (kind === 'play') { profile.totalPlays = Number(profile.totalPlays || 0) + 1; profile.lastPlayed = 'Crush v2'; }
    if (kind === 'campaign') {
      profile.clears = Number(profile.clears || 0) + 1;
      profile.clearStreak = Number(profile.clearStreak || 0) + 1;
      profile.lastCleared = 'Crush v2';
      const earned = ['first-win', 'crush-clear', 'crush-campaign'];
      if (profile.clearStreak >= 3) earned.push('three-game-streak');
      profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
    }
    writeJson(profileKey, profile);
  }

  // Returns { hit:Set, specials:Map<index,kind> }. Bombs come from cells that sit
  // in both a horizontal and a vertical run of 3+ (a cross / T / L shape).
  function findMatches() {
    const hMember = new Map(); // index -> horizontal run length
    const vMember = new Map();
    const hit = new Set();
    const runInfo = []; // { cells:[], dir }
    const scan = (cells, member) => {
      let run = [cells[0]];
      const flush = () => {
        if (run.length >= 3 && grid[run[0]] && grid[run[0]].special !== 'rainbow') {
          run.forEach((i) => { hit.add(i); member.set(i, run.length); });
          runInfo.push({ cells: [...run] });
        }
      };
      for (let k = 1; k < cells.length; k++) {
        const a = grid[cells[k]];
        const b = grid[run[0]];
        if (a && b && a.type === b.type && a.special !== 'rainbow' && b.special !== 'rainbow') run.push(cells[k]);
        else { flush(); run = [cells[k]]; }
      }
      flush();
    };
    for (let y = 0; y < size; y++) scan(Array.from({ length: size }, (_, x) => idx(x, y)), hMember);
    for (let x = 0; x < size; x++) scan(Array.from({ length: size }, (_, y) => idx(x, y)), vMember);
    const specials = new Map();
    // Cross intersections -> bomb (highest priority).
    for (const i of hit) {
      if (hMember.has(i) && vMember.has(i) && !specials.has(i)) specials.set(i, 'bomb');
    }
    // Straight runs -> rainbow (5+) or striped (exactly 4), placed at run center if free.
    for (const run of runInfo) {
      const free = run.cells.find((i) => !specials.has(i));
      if (free === undefined) continue;
      if (run.cells.length >= 5) specials.set(free, 'rainbow');
      else if (run.cells.length === 4 && !specials.has(free)) specials.set(free, 'striped');
    }
    return { hit, specials };
  }

  function expandSpecials(hit) {
    let changed = true;
    while (changed) {
      changed = false;
      for (const i of Array.from(hit)) {
        const cell = grid[i];
        if (!cell) continue;
        const x = i % size;
        const y = Math.floor(i / size);
        if (cell.special === 'striped') {
          cell.special = null;
          for (let k = 0; k < size; k++) {
            if (!hit.has(idx(k, y)) && grid[idx(k, y)]) { hit.add(idx(k, y)); changed = true; }
            if (!hit.has(idx(x, k)) && grid[idx(x, k)]) { hit.add(idx(x, k)); changed = true; }
          }
        } else if (cell.special === 'bomb') {
          cell.special = null;
          for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
            const nx = x + dx, ny = y + dy;
            if (nx < 0 || ny < 0 || nx >= size || ny >= size) continue;
            const j = idx(nx, ny);
            if (!hit.has(j) && grid[j]) { hit.add(j); changed = true; }
          }
        }
      }
    }
  }

  function collapse() {
    for (let x = 0; x < size; x++) {
      const column = [];
      for (let y = size - 1; y >= 0; y--) if (grid[idx(x, y)]) column.push(grid[idx(x, y)]);
      for (let y = size - 1; y >= 0; y--) grid[idx(x, y)] = column[size - 1 - y] || randomTile();
    }
  }

  function resolve(cascade = 1) {
    const { hit, specials } = findMatches();
    if (!hit.size) {
      if (cascade > 2) say(`Cascade x${cascade - 1}!`);
      return endCheck();
    }
    expandSpecials(hit);
    score += hit.size * 10 * cascade;
    hit.forEach((i) => {
      if (specials.has(i)) grid[i] = { type: grid[i].type, special: specials.get(i) };
      else grid[i] = null;
    });
    render(hit);
    window.setTimeout(() => {
      collapse();
      render();
      window.setTimeout(() => resolve(cascade + 1), 140);
    }, 200);
  }

  function clearColor(type) {
    const hit = new Set();
    grid.forEach((cell, i) => { if (cell && cell.type === type) hit.add(i); });
    expandSpecials(hit);
    score += hit.size * 15;
    hit.forEach((i) => { grid[i] = null; });
    render(hit);
    window.setTimeout(() => {
      collapse();
      render();
      window.setTimeout(() => resolve(2), 140);
    }, 200);
  }

  function wouldMatch(a, b) {
    const tmp = grid[a]; grid[a] = grid[b]; grid[b] = tmp;
    const { hit } = findMatches();
    grid[b] = grid[a]; grid[a] = tmp;
    return hit.size > 0;
  }

  function anyMoveLeft() {
    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
      const i = idx(x, y);
      if (grid[i]?.special === 'rainbow') return true;
      if (x + 1 < size && wouldMatch(i, idx(x + 1, y))) return true;
      if (y + 1 < size && wouldMatch(i, idx(x, y + 1))) return true;
    }
    return false;
  }

  function endCheck() {
    busy = false;
    renderStats();
    if (over || won) return;
    if (score >= LEVELS[level].target) {
      if (level + 1 >= LEVELS.length) {
        won = true;
        updateArcadeProfile('campaign');
        showOverlay('Campaign clear!', `You crushed all ${LEVELS.length} levels. Final score ${score}.`, 'Play again');
      } else {
        updateArcadeProfile('level');
        showOverlay(`Level ${level + 1} clear`, `Score ${score} beat the ${LEVELS[level].target} target. On to level ${level + 2}.`, 'Continue');
      }
      return;
    }
    if (moves <= 0) {
      over = true;
      showOverlay('Out of moves', `Level ${level + 1} needed ${LEVELS[level].target}, you had ${score}. Run it back.`, 'Retry');
      return;
    }
    if (!anyMoveLeft()) {
      say('No moves left on the board. Reshuffling.');
      do { grid = grid.map(() => randomTile()); } while (findMatches().hit.size || !anyMoveLeft());
      render();
    }
  }

  function showOverlay(title, copy, buttonLabel) {
    if (overlayTitleEl) overlayTitleEl.textContent = title;
    if (overlayCopyEl) overlayCopyEl.textContent = copy;
    const btn = document.querySelector<HTMLButtonElement>('[data-again]');
    if (btn) btn.textContent = buttonLabel;
    overlayEl?.removeAttribute('hidden');
  }

  // Swapping two specials always works and fires a combo instead of a normal match.
  function comboSwap(a, b) {
    const A = grid[a];
    const B = grid[b];
    const sa = A.special;
    const sb = B.special;
    busy = true;
    moves -= 1;
    const hit = new Set();
    const addRow = (y) => { for (let k = 0; k < size; k++) if (grid[idx(k, y)]) hit.add(idx(k, y)); };
    const addCol = (x) => { for (let k = 0; k < size; k++) if (grid[idx(x, k)]) hit.add(idx(x, k)); };
    const addBlast = (i, r) => {
      const x = i % size, y = Math.floor(i / size);
      for (let dy = -r; dy <= r; dy++) for (let dx = -r; dx <= r; dx++) {
        const nx = x + dx, ny = y + dy;
        if (nx >= 0 && ny >= 0 && nx < size && ny < size && grid[idx(nx, ny)]) hit.add(idx(nx, ny));
      }
    };
    const ax = a % size, ay = Math.floor(a / size);
    // Consume the swapped specials up front so expandSpecials doesn't re-fire them.
    A.special = null;
    B.special = null;
    if (sa === 'rainbow' && sb === 'rainbow') {
      grid.forEach((c, i) => { if (c) hit.add(i); });
      say('DOUBLE RAINBOW! Full board clear.');
    } else if (sa === 'rainbow' || sb === 'rainbow') {
      const other = sa === 'rainbow' ? B : A;
      const kind = sa === 'rainbow' ? sb : sa;
      grid.forEach((c, i) => {
        if (c && c.type === other.type) {
          if (kind === 'bomb') addBlast(i, 1);
          else { addRow(Math.floor(i / size)); addCol(i % size); }
          hit.add(i);
        }
      });
      say(kind === 'bomb' ? 'Rainbow + bomb! A blast on every match.' : 'Rainbow + striped! Stripes fire everywhere.');
    } else if (sa === 'bomb' && sb === 'bomb') {
      addBlast(a, 2);
      addBlast(b, 2);
      say('Double bomb! 5×5 blast.');
    } else if (sa === 'bomb' || sb === 'bomb') {
      for (let d = -1; d <= 1; d++) {
        addRow(Math.min(size - 1, Math.max(0, ay + d)));
        addCol(Math.min(size - 1, Math.max(0, ax + d)));
      }
      say('Striped + bomb! Triple-thick cross.');
    } else {
      addRow(ay);
      addCol(ax);
      addRow(Math.floor(b / size));
      addCol(b % size);
      say('Double striped! Cross clear.');
    }
    hit.add(a);
    hit.add(b);
    expandSpecials(hit);
    score += hit.size * 20;
    hit.forEach((i) => { grid[i] = null; });
    render(hit);
    window.setTimeout(() => {
      collapse();
      render();
      window.setTimeout(() => resolve(2), 140);
    }, 200);
  }

  function trySwap(a, b) {
    if (busy || over || won) return;
    const cellA = grid[a];
    const cellB = grid[b];
    if (!cellA || !cellB) return;
    if (cellA.special && cellB.special) { comboSwap(a, b); return; }
    if (cellA.special === 'rainbow' || cellB.special === 'rainbow') {
      busy = true;
      moves -= 1;
      const other = cellA.special === 'rainbow' ? cellB : cellA;
      grid[cellA.special === 'rainbow' ? a : b] = null;
      say('Rainbow noggle! Clearing the whole color.');
      clearColor(other.type);
      return;
    }
    if (!wouldMatch(a, b)) { say('That swap makes no match.'); return; }
    busy = true;
    moves -= 1;
    const tmp = grid[a]; grid[a] = grid[b]; grid[b] = tmp;
    render();
    window.setTimeout(() => resolve(1), 120);
  }

  function renderStats() {
    if (levelEl) levelEl.textContent = String(level + 1);
    if (scoreEl) scoreEl.textContent = String(score);
    if (movesEl) movesEl.textContent = String(moves);
    if (targetEl) targetEl.textContent = String(LEVELS[level].target);
    const stats = readJson(statsKey, {});
    if (bestEl) bestEl.textContent = stats.bestLevel ? String(stats.bestLevel) : '--';
  }

  function render(clearing = new Set()) {
    if (!boardEl) return;
    boardEl.innerHTML = grid.map((cell, i) => {
      if (!cell) return `<button class="tile is-empty" data-index="${i}" aria-label="empty"></button>`;
      const t = TYPES[cell.type];
      const classes = ['tile'];
      if (i === selected) classes.push('is-selected');
      if (clearing.has(i)) classes.push('is-clearing');
      if (cell.special === 'striped') classes.push('is-striped');
      if (cell.special === 'rainbow') classes.push('is-rainbow');
      if (cell.special === 'bomb') classes.push('is-bomb');
      return `<button class="${classes.join(' ')}" data-index="${i}" style="--tile:${t.color}" aria-label="noggle ${cell.type + 1}${cell.special ? ' ' + cell.special : ''}">
        <img src="https://noun.pics/${t.noun}.svg" alt="" loading="lazy">
        ${cell.special === 'bomb' ? '<b class="mark">✸</b>' : ''}
      </button>`;
    }).join('');
    renderStats();
  }

  function hint() {
    if (busy || over || won) return;
    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
      const i = idx(x, y);
      const pairs = [x + 1 < size ? idx(x + 1, y) : -1, y + 1 < size ? idx(x, y + 1) : -1];
      for (const j of pairs) {
        if (j >= 0 && wouldMatch(i, j)) {
          [i, j].forEach((k) => {
            const el = boardEl?.querySelector(`[data-index="${k}"]`);
            el?.classList.add('is-hint');
            window.setTimeout(() => el?.classList.remove('is-hint'), 1200);
          });
          say('Try that highlighted swap.');
          return;
        }
      }
    }
    say('No swaps found. Start a new game.');
  }

  function buildBoard() {
    do { grid = Array.from({ length: size * size }, randomTile); } while (findMatches().hit.size || !anyMoveLeft());
  }

  function startLevel(n) {
    level = n;
    score = 0;
    moves = LEVELS[n].moves;
    selected = -1;
    busy = false;
    over = false;
    won = false;
    overlayEl?.setAttribute('hidden', '');
    buildBoard();
    say(`Level ${n + 1}: hit ${LEVELS[n].target} points in ${LEVELS[n].moves} moves.`);
    render();
  }

  function newGame() {
    updateArcadeProfile('play');
    startLevel(0);
  }

  function advance() {
    // Continue after a level clear; retry / restart otherwise.
    if (won || over) { newGame(); return; }
    if (score >= LEVELS[level].target && level + 1 < LEVELS.length) startLevel(level + 1);
    else newGame();
  }

  boardEl?.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest('[data-index]');
    if (!el || busy || over || won) return;
    const i = Number(el.getAttribute('data-index'));
    if (selected < 0) { selected = i; render(); return; }
    if (selected === i) { selected = -1; render(); return; }
    const dx = Math.abs((selected % size) - (i % size));
    const dy = Math.abs(Math.floor(selected / size) - Math.floor(i / size));
    if (dx + dy === 1) {
      const a = selected;
      selected = -1;
      trySwap(a, i);
    } else {
      selected = i;
      render();
    }
  });
  document.querySelector('[data-new]')?.addEventListener('click', newGame);
  document.querySelector('[data-again]')?.addEventListener('click', advance);
  document.querySelector('[data-hint]')?.addEventListener('click', hint);
  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() === 'n') newGame();
    if (event.key.toLowerCase() === 'h') hint();
  });
  newGame();
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:18px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; }
  .window { position:relative; max-width:920px; margin:0 auto; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; box-shadow:2px 2px 0 #000; }
  .titlebar { display:flex; justify-content:space-between; min-height:28px; padding:3px 5px 3px 7px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:4px; }
  .buttons i { display:grid; place-items:center; width:19px; height:18px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { border:0; background:transparent; color:#000; padding:4px 8px; font:inherit; text-decoration:none; }
  .menubar button:hover,.menubar a:hover { background:#000080; color:#fff; }
  .toolbar { display:grid; grid-template-columns:repeat(5,80px) minmax(0,1fr); gap:6px; padding:7px; border-top:1px solid #fff; border-bottom:1px solid #808080; }
  .toolbar span,.toolbar p,.status { margin:0; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 7px; font-size:12px; }
  .toolbar strong { float:right; font-family:"Courier New",monospace; }
  .felt { display:grid; place-items:center; min-height:560px; padding:18px; background:linear-gradient(rgba(0,62,48,.34),rgba(0,52,42,.58)),var(--arcade-desktop) center/cover; overflow:auto; }
  .board { display:grid; grid-template-columns:repeat(8,52px); gap:3px; padding:10px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#c0c0c0; }
  /* Tiles are injected via innerHTML, so they miss Astro's scope attribute — anchor them to the scoped board instead. */
  .board :global(.tile) { position:relative; width:52px; height:52px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:var(--tile,#c0c0c0); padding:0; cursor:pointer; transition:transform .12s; }
  .board :global(.tile img) { width:40px; height:40px; image-rendering:pixelated; }
  .board :global(.tile:hover) { transform:scale(1.06); }
  .board :global(.tile.is-selected) { outline:3px solid #ffff00; outline-offset:-4px; }
  .board :global(.tile.is-hint) { outline:3px solid #00ff80; outline-offset:-4px; }
  .board :global(.tile.is-clearing) { transform:scale(.2); opacity:.2; transition:transform .18s,opacity .18s; }
  .board :global(.tile.is-empty) { background:#9a9a9a; border-color:#808080 #fff #fff #808080; cursor:default; }
  .board :global(.tile.is-striped) { background:repeating-linear-gradient(45deg,var(--tile),var(--tile) 6px,#fff 6px,#fff 10px); }
  .board :global(.tile.is-rainbow) { background:conic-gradient(#ff8ba8,#ffc96b,#fff27a,#7de08f,#7ec2ff,#c9a0f0,#ff8ba8); }
  .board :global(.tile.is-bomb) { box-shadow:inset 0 0 0 3px #000, inset 0 0 0 6px #ffff00; }
  .board :global(.tile .mark) { position:absolute; right:2px; bottom:0; font-size:14px; color:#000; text-shadow:0 0 3px #ffff00; }
  .status { margin:4px; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,64,.45); }
  .overlay[hidden] { display:none; }
