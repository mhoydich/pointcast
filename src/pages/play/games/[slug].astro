---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import GameHeader from '../../../components/games/GameHeader.astro';
import GameCard from '../../../components/games/GameCard.astro';
import { GAME_LIBRARY, gameLanding, gameDownload, gameDownloadLabel, gameDownloadType, type LibraryGame } from '../../../lib/game-library';
import '../../../styles/game-library.css';
export function getStaticPaths(){return GAME_LIBRARY.map(game=>({params:{slug:game.slug},props:{game}}));}
const {game}=Astro.props as {game:LibraryGame};
const related=GAME_LIBRARY.filter(item=>item.slug!==game.slug&&item.family===game.family).slice(0,3);
const jsonLd={'@context':'https://schema.org','@type':'VideoGame',name:game.name,description:game.description,url:`https://pointcast.xyz${gameLanding(game)}`,gamePlatform:'Web browser'};
---
<BlockLayout title={`${game.name} · Games`} author="PointCast" description={game.description} image={game.hero} jsonLd={jsonLd} immersive isolated showNetworkStrip={false} alternates={[{type:'application/json',href:'/games.json',title:'PointCast game library'}]}>
  <div class="gp-site" style={`--game-accent:${game.accent}`}><GameHeader current="game" /><div id="main">
    <nav class="gp-breadcrumb" aria-label="Breadcrumb"><a href="/games/">All games</a><span aria-hidden="true">/</span><span>{game.family}</span></nav>
    <section class="gp-game-hero"><div class="gp-game-hero-copy"><span class="gp-kicker">{game.kicker}</span><h1>{game.name}</h1><p class="gp-game-dek">{game.description}</p><div class="gp-pills"><span>{game.players}</span><span>Browser play</span><span>{gameDownloadType(game)}</span></div><div class="gp-button-row"><a class="gp-button gp-button-dark" href={game.playUrl}>Play now <span aria-hidden="true">↗</span></a><a class="gp-button gp-button-light" href="#download">Take it home <span aria-hidden="true">↓</span></a><a class="gp-text-link" href="#participate">Join in →</a></div></div><div class="gp-game-hero-art">{game.hero ? <img src={game.hero} alt={`${game.name} game artwork`} width="960" height="720" fetchpriority="high" /> : <span class="gp-hero-letter" aria-hidden="true">{game.name.split(' ').map(part=>part[0]).slice(0,2).join('')}</span>}<span class="gp-sticker">PRESS PLAY. SEE WHAT HAPPENS.</span></div></section>
    <section class="gp-how" aria-labelledby="how-title"><div class="gp-section-head"><div><span class="gp-kicker">THE FIRST GOOD MINUTE</span><h2 id="how-title">Here’s how it goes.</h2></div><a class="gp-text-link" href={game.playUrl}>Try a round ↗</a></div><ol class="gp-steps">{game.steps.map((step,index)=><li><span class="gp-step-number">{String(index+1).padStart(2,'0')}</span><p>{step}</p></li>)}</ol><div class="gp-controls"><strong>Your controls</strong><ul>{game.controls.map(control=><li>{control}</li>)}</ul></div></section>
    <section id="participate" class="gp-participate" aria-labelledby="participate-title"><div class="gp-section-head"><div><span class="gp-kicker">A WAY INTO THE GAME</span><h2 id="participate-title">Come and join in.</h2></div></div><div class="gp-participation-grid">{game.participation.map(action=><a href={action.url} class="gp-participation-card"><span aria-hidden="true">↗</span><h3>{action.label}</h3><p>{action.description}</p></a>)}<div class="gp-participation-card gp-share-card"><span aria-hidden="true">✳</span><h3>Bring a friend.</h3><p>Share this page so someone else can find the rules and join you.</p><button type="button" id="share-game" class="gp-text-button" data-share-url={`https://pointcast.xyz${gameLanding(game)}`}>Copy game link →</button><label id="share-fallback" hidden>Game link<input type="text" readonly value={`https://pointcast.xyz${gameLanding(game)}`} /></label><p id="share-status" class="gp-small" role="status"></p></div></div><p class="gp-participation-note">{game.networkNote}</p></section>
    <section id="download" class="gp-download" aria-labelledby="download-title"><div><span class="gp-kicker">{gameDownloadType(game).toUpperCase()}</span><h2 id="download-title">Take {game.name}<br />with you.</h2><p>{game.download.note}</p><a class="gp-button gp-button-dark" href={gameDownload(game)} download={`${game.slug}.zip`}>{gameDownloadLabel(game)} <span aria-hidden="true">↓</span></a><p class="gp-small">ZIP download · instructions included · no account required</p></div><div class="gp-download-details"><h3>{game.download.kind==='online'?'Your shortcut to the live game.':'Your own little copy.'}</h3><ol>{game.download.kind==='online'?<><li>Download and unzip the kit.</li><li>Open its launch file or browser shortcut.</li><li>Play on the game’s website with an Internet connection.</li></>:<><li>Download and unzip the game pack.</li><li>Follow the included guide to start the local game.</li><li>Play locally. The guide explains which features need a connection.</li></>}</ol><div class="gp-save-note"><strong>About your save</strong><p>{game.saveNote}</p></div></div></section>
    {game.editions.length>0&&<section class="gp-editions" aria-labelledby="editions-title"><div class="gp-section-head"><div><span class="gp-kicker">MORE OF THIS WORLD</span><h2 id="editions-title">Pick an edition.</h2></div></div><div class="gp-edition-grid">{game.editions.map(edition=><a href={edition.url}><span>{edition.name}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
    {related.length>0&&<section class="gp-related"><div class="gp-section-head"><h2>Stay a little longer.</h2><a class="gp-text-link" href="/games/">All games ↗</a></div><div class="gp-game-grid">{related.map(item=><GameCard game={item} />)}</div></section>}
  </div><footer class="gp-footer"><a href="/games/">← Back to all games</a><span>PointCast · a little time well played.</span><a href="/games.json">Game library JSON</a></footer></div>
</BlockLayout>
<script>
  function setupGameShare(){const button=document.querySelector<HTMLButtonElement>('#share-game');if(!button||button.dataset.bound)return;button.dataset.bound='true';button.addEventListener('click',async()=>{const url=button.dataset.shareUrl??'';const status=document.querySelector('#share-status');try{await navigator.clipboard.writeText(url);if(status)status.textContent='Copied. Share it wherever you like.';}catch{const fallback=document.querySelector<HTMLElement>('#share-fallback');if(fallback){fallback.hidden=false;fallback.querySelector('input')?.select();}if(status)status.textContent='Select and copy the link above.';}});}
  setupGameShare();document.addEventListener('astro:page-load',setupGameShare);
</script>
