---
/**
 * /archive — Home v2027 Wave 2: the giant chronological scroll.
 *
 * Mike 2026-05-07 (after Home v2027 Wave 1 shipped): "yep, wave 2, keep
 * going". The Wave 1 home pinned a single editorial lead + operating
 * mode + today/week. The archive page is its sibling — *all* of the
 * history, in one giant scroll, with mile markers and decreasing
 * density so a visitor can both zoom out (jump nav, sticky anchor) and
 * zoom in (full cards in the recent month).
 *
 * Design pattern (newspaper archive + NYT-style scroll):
 *
 *   1. HERO — stats banner with block count + first/latest date.
 *   2. STICKY DATE ANCHOR — floating chip that appears on scroll,
 *      updates as the viewport crosses each month marker.
 *   3. JUMP NAV — sticky right sidebar listing every month; click to
 *      smooth-scroll, updates active state via IntersectionObserver.
 *   4. MONTH MARKERS — bigger than v1 dividers: month label + block
 *      count + latest title + first/last date for the month.
 *   5. DECREASING DENSITY — three tiers:
 *      • CURRENT MONTH (≤30 days):    full editorial cards, 3-col grid
 *      • RECENT MONTHS (30–90 days):  title + dek + meta, compact rows
 *      • DEEP (>90 days):             one-line lozenges, channel/id/date
 *      Caps the visual weight at the top so recent stuff reads as news;
 *      older months become reference material as you go deeper.
 *   6. URL HASH ROUTING — every month marker updates the hash on scroll
 *      so back/forward navigates between months and direct-link to a
 *      month works (`/archive#2026-04`).
 *   7. FILTERS preserved from v1 — channel + type + search remain on
 *      every density tier; "ALL" stays the default.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { getCollection } from 'astro:content';
import { CHANNELS, CHANNEL_LIST } from '../lib/channels';
import { BLOCK_TYPE_LIST } from '../lib/block-types';

// ───── Data ────────────────────────────────────────────────────
const blocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

const now = new Date();
const monthMs = 30 * 24 * 60 * 60 * 1000;

function tierForBlock(b: typeof blocks[number]): 'full' | 'compact' | 'deep' {
  const ageMs = +now - +b.data.timestamp;
  if (ageMs <= monthMs)         return 'full';
  if (ageMs <= 3 * monthMs)     return 'compact';
  return 'deep';
}

// ───── Aggregate counts (for filter chip badges) ───────────────
const channelCounts: Record<string, number> = {};
const typeCounts: Record<string, number> = {};
for (const b of blocks) {
  channelCounts[b.data.channel] = (channelCounts[b.data.channel] ?? 0) + 1;
  typeCounts[b.data.type]       = (typeCounts[b.data.type]      ?? 0) + 1;
}

// ───── Group into months ───────────────────────────────────────
interface MonthGroup {
  /** "2026-04" — used as anchor id, hash key, sort key. */
  key: string;
  /** "APRIL 2026" — display label. */
  label: string;
  /** "APR 2026" — short label for nav + sticky anchor. */
  shortLabel: string;
  blocks: typeof blocks;
  /** Most-recent block (first in array since list is reverse-chrono). */
  latest: typeof blocks[number];
  /** Oldest block in the month (last in array). */
  oldest: typeof blocks[number];
  /** Count of blocks in this month. */
  count: number;
  /** Mixed density tier — `full` if any block is current month. */
  tier: 'full' | 'compact' | 'deep';
}

const months: MonthGroup[] = [];
for (const b of blocks) {
  const d = b.data.timestamp;
  const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  let group = months[months.length - 1];
  if (!group || group.key !== key) {
    const label = new Intl.DateTimeFormat('en-US', {
      month: 'long', year: 'numeric', timeZone: 'UTC',
    }).format(d).toUpperCase();
    const shortLabel = new Intl.DateTimeFormat('en-US', {
      month: 'short', year: 'numeric', timeZone: 'UTC',
    }).format(d).toUpperCase();
    group = {
      key, label, shortLabel, blocks: [], latest: b, oldest: b, count: 0,
      tier: tierForBlock(b),
    };
    months.push(group);
  }
  group.blocks.push(b);
  group.oldest = b;
  group.count = group.blocks.length;
  // Tier of the GROUP is the loosest tier across its blocks (i.e. if any
  // block is "full" the whole month renders full; if all are deep, deep).
  // Picking by the group's first block (the latest) is a good proxy — a
  // month at most spans 31 days so everything in it lands in the same
  // tier within tolerance.
  group.tier = tierForBlock(group.latest);
}

// Latest + oldest for the hero stats banner.
const latestDate = blocks[0]?.data.timestamp;
const oldestDate = blocks[blocks.length - 1]?.data.timestamp;
const yearRange = latestDate && oldestDate
  ? (latestDate.getUTCFullYear() === oldestDate.getUTCFullYear()
      ? `${latestDate.getUTCFullYear()}`
      : `${oldestDate.getUTCFullYear()}–${latestDate.getUTCFullYear()}`)
  : `${now.getUTCFullYear()}`;

function fmtMonthDay(d: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short', day: '2-digit', timeZone: 'UTC',
  }).format(d).toUpperCase();
}

function fmtDay(d: Date): string {
  return String(d.getUTCDate()).padStart(2, '0');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://pointcast.xyz/archive',
      name: `PointCast archive · ${blocks.length} blocks`,
      description: `Chronological index of every PointCast block, ${yearRange}.`,
      url: 'https://pointcast.xyz/archive',
      hasPart: blocks.slice(0, 50).map((b) => ({
        '@type': 'CreativeWork',
        name: b.data.title,
        datePublished: b.data.timestamp.toISOString(),
        url: `https://pointcast.xyz/b/${b.data.id}`,
        identifier: b.data.id,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://pointcast.xyz/archive#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Archive', item: 'https://pointcast.xyz/archive' },
      ],
    },
  ],
};
---

<BlockLayout
  title="Archive"
  description={`Chronological index of every PointCast block. ${blocks.length} blocks across ${months.length} months, ${yearRange}.`}
  image="/images/og/archive.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/archive.json', title: 'Archive (JSON)' }]}
>
  <div class="archive2027">

    <header class="archive__hero">
      <p class="archive__crumb">
        <a href="/">home</a>
        <span aria-hidden="true">›</span>
        <span>archive</span>
      </p>
      <p class="archive__kicker">
        ARCHIVE · {blocks.length} BLOCKS · {months.length} MONTHS · {yearRange}
      </p>
      <h1 class="archive__title">Every block, chronologically.</h1>
      <p class="archive__dek">
        The homepage is the living feed. This is the record. Every block
        ever published, reverse-chronological, with mile markers per
        month, decreasing density as you scroll deeper, and a jump nav
        on the right. Sibling: <a href="/archive.json">/archive.json</a>.
      </p>
      {oldestDate && (
        <p class="archive__since">
          first block <time datetime={oldestDate.toISOString()}>{fmtMonthDay(oldestDate)} {oldestDate.getUTCFullYear()}</time>
          {' · '}
          latest <time datetime={latestDate?.toISOString()}>{latestDate ? fmtMonthDay(latestDate) : '—'}</time>
        </p>
      )}
    </header>

    <section class="archive__filters" aria-label="Filters">
      <div class="archive__filter-row">
        <p class="archive__filter-label">CHANNEL</p>
        <div class="archive__chips" data-filter-group="channel">
          <button type="button" class="archive__chip archive__chip--active" data-filter="all" data-group="channel">
            ALL <span class="archive__chip-count">{blocks.length}</span>
          </button>
          {CHANNEL_LIST.filter((c) => (channelCounts[c.code] ?? 0) > 0).map((c) => (
            <button
              type="button"
              class="archive__chip"
              data-filter={c.code}
              data-group="channel"
              style={`--chip-c: ${c.color600}; --chip-c50: ${c.color50};`}
            >
              CH.{c.code} <span class="archive__chip-count">{channelCounts[c.code] ?? 0}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="archive__filter-row">
        <p class="archive__filter-label">TYPE</p>
        <div class="archive__chips" data-filter-group="type">
          <button type="button" class="archive__chip archive__chip--active" data-filter="all" data-group="type">
            ALL <span class="archive__chip-count">{blocks.length}</span>
          </button>
          {BLOCK_TYPE_LIST.filter((t) => (typeCounts[t.code] ?? 0) > 0).map((t) => (
            <button type="button" class="archive__chip" data-filter={t.code} data-group="type">
              {t.label} <span class="archive__chip-count">{typeCounts[t.code] ?? 0}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="archive__filter-row">
        <p class="archive__filter-label">SEARCH</p>
        <input
          type="search"
          class="archive__search"
          id="archive-search"
          placeholder="Title, channel, number…"
          aria-label="Search archive"
        />
      </div>
    </section>

    <div class="archive__body">

      {/* Sticky date anchor — appears on scroll past the hero, updates
          as month markers cross the viewport. JS sets data-active. */}
      <aside class="archive__anchor" id="archive-anchor" data-state="hidden" aria-hidden="true">
        <span class="archive__anchor-month" id="archive-anchor-month">—</span>
        <span class="archive__anchor-count" id="archive-anchor-count">—</span>
      </aside>

      <main class="archive__stream" id="archive-stream">
        {months.map((m) => (
          <section
            class={`archive__month archive__month--${m.tier}`}
            data-month={m.key}
            id={`m-${m.key}`}
          >
            {/* MILE MARKER */}
            <header class="archive__marker">
              <div class="archive__marker-row">
                <span class="archive__marker-label">{m.label}</span>
                <span class="archive__marker-count mono">
                  {m.count} {m.count === 1 ? 'BLOCK' : 'BLOCKS'}
                </span>
              </div>
              <p class="archive__marker-latest">
                <span class="archive__marker-eyebrow mono">LATEST</span>
                <a href={`/b/${m.latest.data.id}`}>{m.latest.data.title}</a>
                <span class="archive__marker-meta mono">CH.{m.latest.data.channel} · {fmtMonthDay(m.latest.data.timestamp)}</span>
              </p>
              <span class="archive__marker-rule" aria-hidden="true"></span>
            </header>

            {/* BLOCKS — three density tiers */}
            {m.tier === 'full' && (
              <div class="archive__grid archive__grid--full">
                {m.blocks.map((b) => {
                  const ch = CHANNELS[b.data.channel];
                  const d = b.data.timestamp;
                  return (
                    <a
                      class="archive__card"
                      href={`/b/${b.data.id}`}
                      data-row="block"
                      data-channel={b.data.channel}
                      data-type={b.data.type}
                      data-search={`${b.data.title} ${b.data.id} ${ch.code} ${b.data.type} ${ch.name}`.toLowerCase()}
                      style={`--card-c: ${ch.color600}; --card-c50: ${ch.color50};`}
                    >
                      <div class="archive__card-head mono">
                        <span class="archive__card-id">/{b.data.id}</span>
                        <span class="archive__card-ch">CH.{b.data.channel}</span>
                        <time class="archive__card-date" datetime={d.toISOString()}>{fmtMonthDay(d)}</time>
                      </div>
                      <h3 class="archive__card-title">{b.data.title}</h3>
                      {b.data.dek && <p class="archive__card-dek">{b.data.dek}</p>}
                    </a>
                  );
                })}
              </div>
            )}

            {m.tier === 'compact' && (
              <ul class="archive__list archive__list--compact">
                {m.blocks.map((b) => {
                  const ch = CHANNELS[b.data.channel];
                  const d = b.data.timestamp;
                  return (
                    <li
                      data-row="block"
                      data-channel={b.data.channel}
                      data-type={b.data.type}
                      data-search={`${b.data.title} ${b.data.id} ${ch.code} ${b.data.type} ${ch.name}`.toLowerCase()}
                    >
                      <a
                        class="archive__row archive__row--compact"
                        href={`/b/${b.data.id}`}
                        style={`--row-c: ${ch.color600};`}
                      >
                        <span class="archive__row-date mono">
                          <span class="archive__row-day">{fmtDay(d)}</span>
                          <span class="archive__row-mon">{fmtMonthDay(d).split(' ')[0]}</span>
                        </span>
                        <span class="archive__row-tag mono">CH.{b.data.channel}</span>
                        <span class="archive__row-id mono">/{b.data.id}</span>
                        <span class="archive__row-title">
                          {b.data.title}
                          {b.data.dek && <span class="archive__row-dek"> — {b.data.dek}</span>}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}

            {m.tier === 'deep' && (
              <ul class="archive__list archive__list--deep">
                {m.blocks.map((b) => {
                  const ch = CHANNELS[b.data.channel];
                  const d = b.data.timestamp;
                  return (
                    <li
                      data-row="block"
                      data-channel={b.data.channel}
                      data-type={b.data.type}
                      data-search={`${b.data.title} ${b.data.id} ${ch.code} ${b.data.type} ${ch.name}`.toLowerCase()}
                    >
                      <a
                        class="archive__row archive__row--deep"
                        href={`/b/${b.data.id}`}
                        style={`--row-c: ${ch.color600};`}
                      >
                        <span class="archive__row-tag mono">CH.{b.data.channel}</span>
                        <span class="archive__row-id mono">/{b.data.id}</span>
                        <span class="archive__row-title">{b.data.title}</span>
                        <time class="archive__row-date mono" datetime={d.toISOString()}>{fmtMonthDay(d)}</time>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))}

        <footer class="archive__foot">
          <p class="archive__foot-h mono">END OF ARCHIVE</p>
          <p class="archive__foot-dek">
            {blocks.length} blocks since {oldestDate ? fmtMonthDay(oldestDate) + ' ' + oldestDate.getUTCFullYear() : '—'}.
            New blocks land daily — back to <a href="/">the home</a> for what shipped today.
          </p>
        </footer>
      </main>

      {/* Jump nav — sticky right sidebar with month list */}
      <nav class="archive__jump" id="archive-jump" aria-label="Jump to month">
        <p class="archive__jump-eyebrow mono">JUMP TO</p>
        <ul>
          {months.map((m) => (
            <li>
              <a
                href={`#m-${m.key}`}
                class="archive__jump-link"
                data-jump={m.key}
              >
                <span class="archive__jump-label mono">{m.shortLabel}</span>
                <span class="archive__jump-count mono">{m.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>
  </div>
</BlockLayout>

<script is:inline>
(() => {
  // ───── Filters (channel + type + search) ─────────────────────
  const stream = document.getElementById('archive-stream');
  const search = document.getElementById('archive-search');
  let active = { channel: 'all', type: 'all', q: '' };

  function applyFilters() {
    const blocks = stream?.querySelectorAll('[data-row="block"]');
    if (!blocks) return;
    const q = active.q.toLowerCase().trim();
    blocks.forEach(el => {
      const ch = el.getAttribute('data-channel') || '';
      const ty = el.getAttribute('data-type') || '';
      const sx = el.getAttribute('data-search') || '';
      const channelHit = active.channel === 'all' || active.channel === ch;
      const typeHit    = active.type    === 'all' || active.type    === ty;
      const searchHit  = !q || sx.includes(q);
      el.style.display = (channelHit && typeHit && searchHit) ? '' : 'none';
    });
    // Hide month sections that have no visible blocks left.
    document.querySelectorAll('.archive__month').forEach(sec => {
      const visible = sec.querySelectorAll('[data-row="block"]:not([style*="display: none"])').length;
      sec.style.display = visible === 0 ? 'none' : '';
    });
  }

  document.querySelectorAll('[data-group="channel"] .archive__chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-group="channel"] .archive__chip').forEach(b => b.classList.remove('archive__chip--active'));
      btn.classList.add('archive__chip--active');
      active.channel = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });
  document.querySelectorAll('[data-group="type"] .archive__chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-group="type"] .archive__chip').forEach(b => b.classList.remove('archive__chip--active'));
      btn.classList.add('archive__chip--active');
      active.type = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });
  search?.addEventListener('input', e => {
    active.q = e.target.value;
    applyFilters();
  });

  // ───── Sticky date anchor + jump nav active state ────────────
  const anchorEl   = document.getElementById('archive-anchor');
  const anchorMon  = document.getElementById('archive-anchor-month');
  const anchorCnt  = document.getElementById('archive-anchor-count');
  const jumpLinks  = document.querySelectorAll('.archive__jump-link');
  const sections   = document.querySelectorAll('.archive__month');

  function setActive(monthKey, label, count, totalLeft) {
    if (!anchorEl) return;
    anchorEl.dataset.state = 'shown';
    anchorEl.setAttribute('aria-hidden', 'false');
    if (anchorMon) anchorMon.textContent = label || '—';
    if (anchorCnt) anchorCnt.textContent = (count != null && totalLeft != null)
      ? `${count} block${count === 1 ? '' : 's'} · ${totalLeft} left in archive`
      : '—';
    jumpLinks.forEach(a => {
      a.classList.toggle('archive__jump-link--active', a.getAttribute('data-jump') === monthKey);
    });
    if (history && history.replaceState) {
      try { history.replaceState(null, '', `#m-${monthKey}`); } catch (e) {}
    }
  }

  // Hide the anchor near the top of the page so it doesn't collide with
  // the hero. Show it once we've scrolled past the filters.
  function maybeHideAnchor() {
    if (!anchorEl) return;
    if (window.scrollY < 240) {
      anchorEl.dataset.state = 'hidden';
      anchorEl.setAttribute('aria-hidden', 'true');
    }
  }

  // Compute prefix counts so the anchor can show "X left below".
  const monthMeta = Array.from(sections).map(s => ({
    key: s.getAttribute('data-month') || '',
    label: s.querySelector('.archive__marker-label')?.textContent?.trim() || '',
    count: s.querySelectorAll('[data-row="block"]').length,
    el: s,
  }));
  let cumulativeRemaining = monthMeta.reduce((s, m) => s + m.count, 0);
  for (const m of monthMeta) {
    cumulativeRemaining -= m.count;
    m.totalLeft = cumulativeRemaining;
    m.cumLeft   = cumulativeRemaining; // alias
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      // Sort entries by document order; pick the topmost intersecting one
      // as the active section. Falls back to nearest-to-top on edge cases.
      const top = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (top) {
        const key = top.target.getAttribute('data-month') || '';
        const m = monthMeta.find(mm => mm.key === key);
        if (m) setActive(m.key, m.label, m.count, m.totalLeft);
      }
      maybeHideAnchor();
    }, {
      // Trigger when a marker is in the top third of the viewport.
      rootMargin: '-12% 0px -60% 0px',
      threshold: 0,
    });
    sections.forEach(s => observer.observe(s));
    window.addEventListener('scroll', maybeHideAnchor, { passive: true });
  }

  // ───── Smooth-scroll jump links ──────────────────────────────
  jumpLinks.forEach(a => {
    a.addEventListener('click', e => {
      const key = a.getAttribute('data-jump');
      if (!key) return;
      const target = document.getElementById(`m-${key}`);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Update hash without jumping (smoothScroll handles position).
      try { history.pushState(null, '', `#m-${key}`); } catch (err) {}
    });
  });

  // Honor an inbound hash on load — scroll to that month after layout.
  window.addEventListener('load', () => {
    const h = (location.hash || '').replace(/^#m-/, '');
    if (h && /^\d{4}-\d{2}$/.test(h)) {
      const target = document.getElementById(`m-${h}`);
      if (target) target.scrollIntoView({ behavior: 'auto', block: 'start' });
    }
  });
})();
</script>

<style>
  .archive2027 {
    max-width: 1280px; margin: 0 auto; padding: 24px 20px 80px;
    font-family: var(--font-body);
  }

  /* HERO */
  .archive__hero { margin: 0 0 24px; padding: 36px 0 28px; border-bottom: 1.5px solid var(--color-rule); }
  .archive__crumb {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    color: var(--color-ink-soft); text-transform: uppercase;
    margin: 0 0 16px;
  }
  .archive__crumb a { color: var(--color-ink-soft); text-decoration: none; }
  .archive__crumb a:hover { color: var(--color-ink); }
  .archive__crumb span { margin: 0 6px; }
  .archive__kicker {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase;
    margin: 0 0 12px;
  }
  .archive__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05; font-weight: 600;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .archive__dek {
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5; color: var(--color-ink-soft);
    max-width: 720px; margin: 0 0 14px;
  }
  .archive__since {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--color-ink-soft); margin: 0;
  }
  .archive__since time { color: var(--color-ink); }

  /* FILTERS */
  .archive__filters {
    margin: 0 0 28px;
    padding: 16px 0;
    display: grid; gap: 12px;
  }
  .archive__filter-row {
    display: grid; grid-template-columns: 90px 1fr; gap: 14px;
    align-items: start;
  }
  @media (max-width: 640px) {
    .archive__filter-row { grid-template-columns: 1fr; gap: 6px; }
  }
  .archive__filter-label {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em;
    color: var(--color-ink-soft); text-transform: uppercase;
    margin: 4px 0 0;
  }
  .archive__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .archive__chip {
    padding: 6px 10px;
    border: 1.5px solid var(--color-rule);
    background: #fff;
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.12em; text-transform: uppercase;
    cursor: pointer; border-radius: 2px;
    color: var(--color-ink);
  }
  .archive__chip:hover { border-color: var(--chip-c, var(--color-warm)); }
  .archive__chip--active {
    background: var(--chip-c, var(--color-ink));
    color: #fff;
    border-color: var(--chip-c, var(--color-ink));
  }
