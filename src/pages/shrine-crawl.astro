---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  BELL_MODE_COPY,
  SHRINE_CRAWL,
  SHRINE_CRAWL_DAILY_RECEIPT_SCHEMA,
  SHRINE_CRAWL_DAILY_ROUTE_LENGTH,
  SHRINE_CRAWL_META,
  SHRINE_CRAWL_RECEIPT_SCHEMA,
  SHRINE_CRAWL_SCREENSAVER_DURATION_MS,
  SHRINE_CRAWL_STORAGE,
} from '../lib/shrine-bell-crawl';
import { absoluteImage, absoluteUrl, SITE_URL } from '../lib/unfurl-shrines';

const title = SHRINE_CRAWL_META.title;
const description = SHRINE_CRAWL_META.description;
const first = SHRINE_CRAWL[0];
const firstStyle = `--active-bg: url('${first.background}'); --active-accent: ${first.accent}; --active-glow: ${first.glow};`;
const shrineJson = JSON.stringify(SHRINE_CRAWL);
const receiptSchemaJson = JSON.stringify(SHRINE_CRAWL_RECEIPT_SCHEMA);
const dailyReceiptSchemaJson = JSON.stringify(SHRINE_CRAWL_DAILY_RECEIPT_SCHEMA);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': absoluteUrl('/shrine-crawl'),
      name: title,
      description,
      url: absoluteUrl('/shrine-crawl'),
      isPartOf: { '@type': 'WebSite', name: 'PointCast', url: SITE_URL },
      image: absoluteImage('/images/shrines/shrine-background-sheet.png'),
    },
    {
      '@type': 'ItemList',
      '@id': absoluteUrl('/shrine-crawl#visits'),
      name: 'PointCast shrine bell crawl visits',
      numberOfItems: SHRINE_CRAWL.length,
      itemListElement: SHRINE_CRAWL.map((shrine) => ({
        '@type': 'ListItem',
        position: shrine.number,
        url: absoluteUrl(`/shrine-crawl#${shrine.id}`),
        name: shrine.title,
        description: shrine.subtitle,
      })),
    },
  ],
};
---

<BlockLayout
  title={title}
  description={description}
  image="/images/shrines/shrine-background-sheet.png"
  imageAlt="Generated PointCast shrine background sheet"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/shrine-crawl.json', title: '24 Shrine Bell Crawl JSON' }]}
  frame={{
    image: 'https://pointcast.xyz/images/shrines/shrine-background-sheet.png',
    buttons: [
      { label: 'Open crawl', action: 'link', target: absoluteUrl('/shrine-crawl') },
      { label: 'Crawl JSON', action: 'link', target: absoluteUrl('/shrine-crawl.json') },
      { label: 'Shrines', action: 'link', target: absoluteUrl('/shrines') },
      { label: 'Next sprint', action: 'link', target: absoluteUrl('/next-sprint') },
    ],
  }}
>
  <div
    class="shrine-crawl"
    data-shrine-crawl
    data-state-key={SHRINE_CRAWL_STORAGE.state}
    data-legacy-state-key={SHRINE_CRAWL_STORAGE.legacyState}
    data-receipt-key={SHRINE_CRAWL_STORAGE.receipt}
    data-daily-key={SHRINE_CRAWL_STORAGE.daily}
    data-daily-route-length={SHRINE_CRAWL_DAILY_ROUTE_LENGTH}
    data-screensaver-duration={SHRINE_CRAWL_SCREENSAVER_DURATION_MS}
    data-receipt-schema={receiptSchemaJson}
    data-daily-receipt-schema={dailyReceiptSchemaJson}
    style={firstStyle}
  >
    <script id="shrine-crawl-data" type="application/json" set:html={shrineJson}></script>

    <nav class="crumb mono" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/shrines">shrines</a>
      <span>/</span>
      <span>crawl</span>
      <a href="/shrine-crawl.json">JSON</a>
    </nav>

    <header class="hero">
      <div class="hero__shade"></div>
      <div class="hero__copy">
        <p class="kicker mono">SHRINE BELL CRAWL</p>
        <h1>24 shrine visits, each with a bell and a next door.</h1>
        <p>{description}</p>
        <div class="hero__actions" aria-label="Primary crawl actions">
          <a href="#crawl-console">Start Crawl</a>
          <a href="/shrine-crawl?mode=daily">Today's Six</a>
          <a href="/shrine-crawl?mode=screensaver">Screensaver</a>
          <a href="/shrine-crawl.json">Prompt Queue</a>
        </div>
      </div>
      <div class="hero__stats" aria-label="Crawl stats">
        <span><strong>{SHRINE_CRAWL.length}</strong> shrines</span>
        <span><strong>{SHRINE_CRAWL_DAILY_ROUTE_LENGTH}</strong> daily stops</span>
        <span><strong>{SHRINE_CRAWL_META.modes.length}</strong> bell modes</span>
      </div>
    </header>

    <main class="console" id="crawl-console">
      <section class="stage" data-stage aria-live="polite">
        <div class="stage__background"></div>
        <div class="stage__content">
          <div class="stage__meta">
            <span class="mono" data-shrine-count>01 / 24</span>
            <span class="mono" data-shrine-mode>{BELL_MODE_COPY[first.bell.mode]}</span>
          </div>
          <div class="noun-token" aria-hidden="true">
            <img data-shrine-noun src={`https://noun.pics/${first.bell.noun}.svg`} alt="" width="180" height="180" loading="eager" decoding="async" />
          </div>
          <div class="stage__copy">
            <h2 data-shrine-title>{first.title}</h2>
            <p data-shrine-subtitle>{first.subtitle}</p>
            <p class="task" data-shrine-task>{first.task}</p>
          </div>
          <div class="bell-panel">
            <button class="ring-button" data-ring type="button">
              <span data-bell-label>{first.bell.label}</span>
              <small class="mono" data-bell-noun>NOUN {first.bell.noun}</small>
            </button>
            <div class="note-row" data-notes>
              {first.bell.notes.map((note) => <span>{note}</span>)}
            </div>
          </div>
          <div class="stage__actions">
            <button data-next-shrine type="button">Visit Next Shrine</button>
            <a data-open-route href={first.route}>{first.routeLabel}</a>
          </div>
          <div class="screensaver-controls" aria-label="Screensaver controls">
            <button data-screensaver-toggle type="button" title="Pause autoplay">Pause</button>
            <button data-screensaver-next type="button" title="Next shrine">Next Shrine</button>
            <a href="/shrine-crawl" title="Exit screensaver">Exit Screensaver</a>
          </div>
        </div>
      </section>

      <section class="daily-passport" data-daily-passport hidden aria-label="Today's shrine passport">
        <div class="daily-passport__head">
          <div>
            <p class="kicker mono">TODAY'S SIX</p>
            <strong data-daily-date>Daily pilgrimage</strong>
          </div>
          <span class="mono" data-daily-progress>0 / 6 BELLS</span>
        </div>
        <ol class="daily-passport__stamps">
          {Array.from({ length: SHRINE_CRAWL_DAILY_ROUTE_LENGTH }, (_, index) => (
            <li>
              <button type="button" data-daily-stop={index} aria-label={`Open daily shrine ${index + 1}`}>
                <span class="mono">{String(index + 1).padStart(2, '0')}</span>
                <strong data-daily-stop-title>Waiting</strong>
              </button>
            </li>
          ))}
        </ol>
        <div class="daily-passport__receipt" data-daily-receipt hidden>
          <strong>Passport complete.</strong>
          <span class="mono" data-daily-receipt-id></span>
          <button type="button" data-copy-daily-receipt>Copy Daily Receipt</button>
        </div>
        <a class="daily-passport__exit mono" href="/shrine-crawl">All 24 Shrines</a>
      </section>

      <aside class="prompt-panel" aria-label="Midjourney shrine prompt">
        <div class="prompt-panel__head">
          <div>
            <p class="kicker mono">MIDJOURNEY QUEUE</p>
            <h2>Background recipe</h2>
          </div>
          <button data-copy-prompt type="button">Copy Prompt</button>
        </div>
        <pre data-prompt>{first.midjourney}</pre>
      </aside>
    </main>

    <section class="progress-band" aria-label="Local crawl progress">
      <div>
        <span class="mono" data-progress-label>0 visited / 0 rung</span>
        <strong data-progress-title>Start at the brass door.</strong>
      </div>
      <div class="progress">
        <span data-visited-bar></span>
        <span data-rung-bar></span>
      </div>
    </section>

    <section class="receipt-panel" data-receipt-panel hidden aria-label="Pilgrimage receipt">
      <div>
        <p class="kicker mono">PILGRIMAGE RECEIPT</p>
        <h2 data-receipt-title>All 24 bells have answered.</h2>
        <p data-receipt-summary>A local completion receipt is ready.</p>
      </div>
      <div class="receipt-panel__actions">
        <button data-copy-receipt type="button">Copy Receipt JSON</button>
        <a href="/shrine-crawl.json">Receipt Schema</a>
      </div>
      <pre data-receipt-json>{}</pre>
    </section>

    <section class="rail" aria-label="Shrine rail">
      {SHRINE_CRAWL.map((shrine, index) => (
        <button
          class={index === 0 ? 'rail__button is-active' : 'rail__button'}
          type="button"
          data-shrine-select={index}
          style={`--accent: ${shrine.accent}; --glow: ${shrine.glow};`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="mono">{String(shrine.number).padStart(2, '0')}</span>
          <strong>{shrine.title}</strong>
          <small>{shrine.route}</small>
        </button>
      ))}
    </section>

    <section class="visit-grid" id="visits" aria-label="All shrine visits">
      {SHRINE_CRAWL.map((shrine) => (
        <article class="visit-card" id={shrine.id} style={`--accent: ${shrine.accent}; --glow: ${shrine.glow}; --bg: url('${shrine.background}');`}>
          <div class="visit-card__image" aria-hidden="true"></div>
          <div class="visit-card__body">
            <span class="mono">SHRINE {String(shrine.number).padStart(2, '0')} / {BELL_MODE_COPY[shrine.bell.mode]}</span>
            <h2>{shrine.title}</h2>
            <p>{shrine.subtitle}</p>
            <div class="visit-card__links">
              <a href={shrine.route}>{shrine.routeLabel}</a>
              <a href={`/shrine-crawl#${shrine.id}`}>Permalink</a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </div>

  <script>
    import { playEmojiChime, playNounVoice } from '../lib/chimes';
    import { getShrineDailyRouteIds } from '../lib/shrine-bell-crawl';

    function emptyState() {
      return {
        current: 0,
        visited: {},
        rung: {},
        screensaver: { running: false, paused: false },
      };
    }

    function readState(stateKey, legacyStateKey) {
      try {
        const raw = localStorage.getItem(stateKey) || localStorage.getItem(legacyStateKey) || '{}';
        const parsed = JSON.parse(raw) || {};
        return {
          current: Number.isFinite(parsed.current) ? parsed.current : 0,
          visited: parsed.visited || {},
          rung: parsed.rung || {},
          screensaver: {
            running: Boolean(parsed.screensaver?.running),
            paused: Boolean(parsed.screensaver?.paused),
          },
        };
      } catch (error) {
        return emptyState();
      }
    }

    function writeState(stateKey, state) {
      try {
        localStorage.setItem(stateKey, JSON.stringify(state));
      } catch (error) {}
    }

    function getLocalDateKey(date = new Date()) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function copyText(text) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    function playBell(shrine, gain = 1) {
      const noun = Number(shrine.bell.noun) || 0;
      playNounVoice(noun, 0.24 * gain);
      if (shrine.bell.mode === 'chord') {
        window.setTimeout(() => playNounVoice(noun + 7, 0.16 * gain), 100);
      }
      if (shrine.bell.mode === 'cascade') {
        window.setTimeout(() => playNounVoice(noun + 11, 0.17 * gain), 120);
        window.setTimeout(() => playNounVoice(noun + 23, 0.14 * gain), 260);
      }
      if (shrine.bell.mode === 'drone') {
        window.setTimeout(() => playNounVoice(noun + 1, 0.12 * gain), 180);
        if (gain > 0.5) window.setTimeout(() => playEmojiChime(), 520);
      }
    }

    function initShrineCrawl() {
      const root = document.querySelector('[data-shrine-crawl]');
      if (!root || root.hasAttribute('data-shrine-crawl-bound')) return;
      root.setAttribute('data-shrine-crawl-bound', '');

      const dataNode = root.querySelector('#shrine-crawl-data');
      const shrines = JSON.parse(dataNode?.textContent || '[]');
      if (!shrines.length) return;

      const stateKey = root.getAttribute('data-state-key') || 'pc:shrine-crawl:v2';
      const legacyStateKey = root.getAttribute('data-legacy-state-key') || 'pc:shrine-crawl:v1';
      const receiptKey = root.getAttribute('data-receipt-key') || 'pc:shrine-crawl:v2:receipt';
      const dailyKey = root.getAttribute('data-daily-key') || 'pc:shrine-crawl:v3:daily';
      const dailyRouteLength = Number(root.getAttribute('data-daily-route-length') || 6);
      const receiptSchema = readJsonFromString(root.getAttribute('data-receipt-schema') || '{}', {});
      const dailyReceiptSchema = readJsonFromString(root.getAttribute('data-daily-receipt-schema') || '{}', {});
      const screensaverDuration = Number(root.getAttribute('data-screensaver-duration') || 18000);
      const params = new URLSearchParams(window.location.search);
      const startsInScreensaver = params.get('mode') === 'screensaver';
      const startsInDaily = params.get('mode') === 'daily';
      const state = readState(stateKey, legacyStateKey);
      const dateKey = getLocalDateKey();
      const dailyRouteIds = getShrineDailyRouteIds(dateKey, dailyRouteLength);
      const dailyRoute = dailyRouteIds
        .map((id) => shrines.find((shrine) => shrine.id === id))
        .filter(Boolean);
      const buttons = Array.from(root.querySelectorAll('[data-shrine-select]'));
      const dailyPassport = root.querySelector('[data-daily-passport]');
      const dailyButtons = Array.from(root.querySelectorAll('[data-daily-stop]'));
      const dailyDate = root.querySelector('[data-daily-date]');
      const dailyProgress = root.querySelector('[data-daily-progress]');
      const dailyReceipt = root.querySelector('[data-daily-receipt]');
      const dailyReceiptId = root.querySelector('[data-daily-receipt-id]');
      const copyDailyReceiptButton = root.querySelector('[data-copy-daily-receipt]');
      const hero = root.querySelector('.hero');
      const title = root.querySelector('[data-shrine-title]');
      const subtitle = root.querySelector('[data-shrine-subtitle]');
      const task = root.querySelector('[data-shrine-task]');
      const count = root.querySelector('[data-shrine-count]');
      const mode = root.querySelector('[data-shrine-mode]');
      const nounImage = root.querySelector('[data-shrine-noun]');
      const bellLabel = root.querySelector('[data-bell-label]');
      const bellNoun = root.querySelector('[data-bell-noun]');
      const notes = root.querySelector('[data-notes]');
      const prompt = root.querySelector('[data-prompt]');
      const openRoute = root.querySelector('[data-open-route]');
      const progressLabel = root.querySelector('[data-progress-label]');
      const progressTitle = root.querySelector('[data-progress-title]');
      const visitedBar = root.querySelector('[data-visited-bar]');
      const rungBar = root.querySelector('[data-rung-bar]');
      const ringButton = root.querySelector('[data-ring]');
      const nextButton = root.querySelector('[data-next-shrine]');
      const copyButton = root.querySelector('[data-copy-prompt]');
      const screensaverToggle = root.querySelector('[data-screensaver-toggle]');
      const screensaverNext = root.querySelector('[data-screensaver-next]');
      const receiptPanel = root.querySelector('[data-receipt-panel]');
      const receiptTitle = root.querySelector('[data-receipt-title]');
      const receiptSummary = root.querySelector('[data-receipt-summary]');
      const receiptJson = root.querySelector('[data-receipt-json]');
      const copyReceiptButton = root.querySelector('[data-copy-receipt]');
      let screensaverTimer = 0;
      let audioUnlocked = false;

      const modeCopy = {
        single: 'one clear bell',
        chord: 'two bells in agreement',
        cascade: 'three bells down the rail',
        drone: 'a low bell with a bright answer',
      };
      const dailyLedger = readDailyLedger();
      const dailyState = dailyLedger.days[dateKey] || {
        visited: {},
        rung: {},
        completedAt: null,
        receipt: null,
      };
      dailyLedger.days[dateKey] = dailyState;

      function markVisited(shrine) {
        state.visited[shrine.id] = true;
        writeState(stateKey, state);
      }

      function readJsonFromString(raw, fallback) {
        try {
          return raw ? JSON.parse(raw) : fallback;
        } catch (error) {
          return fallback;
        }
      }

      function readDailyLedger() {
        try {
          const parsed = JSON.parse(localStorage.getItem(dailyKey) || '{}') || {};
          return {
            version: 3,
            days: parsed.days && typeof parsed.days === 'object' ? parsed.days : {},
          };
        } catch (error) {
          return { version: 3, days: {} };
        }
      }

      function writeDailyLedger() {
        try {
          const retainedDays = Object.keys(dailyLedger.days).sort().slice(-31);
          dailyLedger.days = Object.fromEntries(
            retainedDays.map((day) => [day, dailyLedger.days[day]]),
          );
          localStorage.setItem(dailyKey, JSON.stringify(dailyLedger));
        } catch (error) {}
      }

      function readReceipt() {
        try {
          return JSON.parse(localStorage.getItem(receiptKey) || 'null');
        } catch (error) {
          return null;
        }
      }

      function writeReceipt(receipt) {
        try {
          localStorage.setItem(receiptKey, JSON.stringify(receipt));
        } catch (error) {}
      }

      function buildReceipt() {
        const rungShrines = shrines.filter((shrine) => state.rung[shrine.id]);
        const visitedShrines = shrines.filter((shrine) => state.visited[shrine.id]);
        return {
          type: receiptSchema.type || 'pointcast.shrine-crawl.receipt.v2',
          receiptId: `pc-shrine-${Date.now().toString(36)}`,
          completedAt: new Date().toISOString(),
          count: rungShrines.length,
          source: `${window.location.origin}/shrine-crawl`,
          screensaverUrl: `${window.location.origin}/shrine-crawl?mode=screensaver`,
          localOnly: true,
          rungShrines: rungShrines.map((shrine) => ({
            id: shrine.id,
            number: shrine.number,
            title: shrine.title,
            route: shrine.route,
            bell: shrine.bell.label,
          })),
          visitedShrines: visitedShrines.map((shrine) => shrine.id),
        };
      }

      function ensureReceipt() {
        const rung = shrines.filter((shrine) => state.rung[shrine.id]).length;
        if (rung !== shrines.length) return readReceipt();
        const existing = readReceipt();
        if (existing?.count === shrines.length) return existing;
        const receipt = buildReceipt();
        writeReceipt(receipt);
        return receipt;
      }

      function renderReceipt() {
        const receipt = ensureReceipt();
        if (!receiptPanel || !receiptJson) return;
        if (!receipt) {
          receiptPanel.hidden = true;
          return;
        }
        receiptPanel.hidden = false;
        if (receiptTitle) receiptTitle.textContent = 'All 24 bells have answered.';
        if (receiptSummary) {
          receiptSummary.textContent = `${receipt.receiptId} · completed ${new Date(receipt.completedAt).toLocaleString()}`;
        }
        receiptJson.textContent = JSON.stringify(receipt, null, 2);
      }

      function buildDailyReceipt() {
        const completedAt = dailyState.completedAt || new Date().toISOString();
        return {
          type: dailyReceiptSchema.type || 'pointcast.shrine-crawl.daily-receipt.v3',
          receiptId: `pc-shrine-daily-${dateKey.replaceAll('-', '')}`,
          dateKey,
          completedAt,
          count: dailyRoute.length,
          source: `${window.location.origin}/shrine-crawl?mode=daily`,
          localOnly: true,
          shrineIds: dailyRoute.map((shrine) => shrine.id),
          shrines: dailyRoute.map((shrine) => ({
            id: shrine.id,
            number: shrine.number,
            title: shrine.title,
            bell: shrine.bell.label,
          })),
        };
      }

      function ensureDailyReceipt() {
        if (!dailyRoute.length || !dailyRoute.every((shrine) => dailyState.rung[shrine.id])) {
          return dailyState.receipt || null;
        }
        if (dailyState.receipt?.dateKey === dateKey) return dailyState.receipt;
        dailyState.completedAt = new Date().toISOString();
        dailyState.receipt = buildDailyReceipt();
        writeDailyLedger();
        return dailyState.receipt;
      }

      function renderDailyPassport() {
        if (!dailyPassport) return;
        dailyPassport.hidden = !startsInDaily;
        if (!startsInDaily) return;

        const rung = dailyRoute.filter((shrine) => dailyState.rung[shrine.id]).length;
        const date = new Date(`${dateKey}T12:00:00`);
        if (dailyDate) {
          dailyDate.textContent = new Intl.DateTimeFormat(undefined, {
            weekday: 'long',
            month: 'long',
            day: 'numeric',
          }).format(date);
        }
        if (dailyProgress) dailyProgress.textContent = `${rung} / ${dailyRoute.length} BELLS`;
        root.setAttribute('data-daily-rung-count', String(rung));

        dailyButtons.forEach((button, index) => {
          const shrine = dailyRoute[index];
          if (!shrine) {
            button.hidden = true;
            return;
          }
          button.hidden = false;
          button.style.setProperty('--stamp-accent', shrine.accent);
          button.classList.toggle('is-active', state.current === shrines.indexOf(shrine));
          button.classList.toggle('is-rung', Boolean(dailyState.rung[shrine.id]));
          button.setAttribute('aria-pressed', state.current === shrines.indexOf(shrine) ? 'true' : 'false');
          button.setAttribute('aria-label', `${index + 1}. ${shrine.title}${dailyState.rung[shrine.id] ? ', rung' : ''}`);
          const stopTitle = button.querySelector('[data-daily-stop-title]');
          if (stopTitle) stopTitle.textContent = shrine.title;
        });

        const receipt = ensureDailyReceipt();
        if (dailyReceipt) dailyReceipt.hidden = !receipt;
        if (dailyReceiptId) dailyReceiptId.textContent = receipt?.receiptId || '';
      }

      function renderProgress() {
        const visited = shrines.filter((shrine) => state.visited[shrine.id]).length;
        const rung = shrines.filter((shrine) => state.rung[shrine.id]).length;
        if (progressLabel) progressLabel.textContent = `${visited} visited / ${rung} rung`;
        if (progressTitle) {
          progressTitle.textContent = rung === shrines.length ? 'All bells have answered.' : `${shrines.length - rung} bells still waiting.`;
        }
        if (visitedBar) visitedBar.style.width = `${Math.round((visited / shrines.length) * 100)}%`;
        if (rungBar) rungBar.style.width = `${Math.round((rung / shrines.length) * 100)}%`;
        root.setAttribute('data-visited-count', String(visited));
        root.setAttribute('data-rung-count', String(rung));
        renderReceipt();
        renderDailyPassport();
      }

      function setScreensaver(running, paused = false) {
        state.screensaver.running = Boolean(running);
        state.screensaver.paused = Boolean(paused);
        root.classList.toggle('is-screensaver', state.screensaver.running);
        root.classList.toggle('is-screensaver-paused', state.screensaver.paused);
        if (screensaverToggle) {
          screensaverToggle.textContent = state.screensaver.paused ? 'Resume' : 'Pause';
          screensaverToggle.setAttribute('title', state.screensaver.paused ? 'Resume autoplay' : 'Pause autoplay');
        }
        writeState(stateKey, state);
        scheduleScreensaver();
      }

      function scheduleScreensaver() {
        window.clearTimeout(screensaverTimer);
        if (!state.screensaver.running || state.screensaver.paused) return;
        screensaverTimer = window.setTimeout(() => {
          advanceScreensaver();
        }, screensaverDuration);
      }

      function advanceScreensaver() {
        paint(state.current + 1, { updateHash: true, scroll: false });
        const shrine = shrines[state.current] || shrines[0];
        if (audioUnlocked) {
          playBell(shrine, 0.42);
          state.rung[shrine.id] = true;
          writeState(stateKey, state);
          renderProgress();
          paint(state.current, { updateHash: true, scroll: false });
        }
        scheduleScreensaver();
      }

      function paint(index, options = {}) {
        const clamped = ((index % shrines.length) + shrines.length) % shrines.length;
        const shrine = shrines[clamped];
        state.current = clamped;
        markVisited(shrine);
        if (startsInDaily && dailyRouteIds.includes(shrine.id)) {
          dailyState.visited[shrine.id] = true;
          writeDailyLedger();
        }
        root.style.setProperty('--active-bg', `url('${shrine.background}')`);
        root.style.setProperty('--active-accent', shrine.accent);
        root.style.setProperty('--active-glow', shrine.glow);

        if (title) title.textContent = shrine.title;
        if (subtitle) subtitle.textContent = shrine.subtitle;
        if (task) task.textContent = shrine.task;
        if (count) count.textContent = `${String(shrine.number).padStart(2, '0')} / ${String(shrines.length).padStart(2, '0')}`;
        if (mode) mode.textContent = modeCopy[shrine.bell.mode] || shrine.bell.mode;
        if (nounImage) nounImage.setAttribute('src', `https://noun.pics/${shrine.bell.noun}.svg`);
        if (bellLabel) bellLabel.textContent = shrine.bell.label;
        if (bellNoun) bellNoun.textContent = `NOUN ${shrine.bell.noun}`;
        if (prompt) prompt.textContent = shrine.midjourney;
        if (openRoute) {
          openRoute.setAttribute('href', shrine.route);
          openRoute.textContent = shrine.routeLabel;
        }
        if (notes) notes.innerHTML = shrine.bell.notes.map((note) => `<span>${note}</span>`).join('');
        if (hero) hero.style.setProperty('background-image', `var(--active-bg)`);

        buttons.forEach((button, buttonIndex) => {
          const active = buttonIndex === clamped;
          button.classList.toggle('is-active', active);
          button.classList.toggle('is-visited', Boolean(state.visited[shrines[buttonIndex].id]));
          button.classList.toggle('is-rung', Boolean(state.rung[shrines[buttonIndex].id]));
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        writeState(stateKey, state);
        renderProgress();
        if (options.updateHash) {
          history.replaceState(null, '', `${window.location.pathname}${window.location.search}#${shrine.id}`);
        }
        if (options.scroll) root.querySelector('[data-stage]')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }

      function unlockAudio() {
        audioUnlocked = true;
      }

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          unlockAudio();
          paint(Number(button.getAttribute('data-shrine-select')) || 0, { updateHash: true, scroll: true });
          scheduleScreensaver();
        });
      });

      dailyButtons.forEach((button) => {
        button.addEventListener('click', () => {
          unlockAudio();
          const shrine = dailyRoute[Number(button.getAttribute('data-daily-stop')) || 0];
          const index = shrines.indexOf(shrine);
          if (index >= 0) paint(index, { updateHash: true, scroll: false });
        });
      });

      ringButton?.addEventListener('click', () => {
        unlockAudio();
        const shrine = shrines[state.current] || shrines[0];
        playBell(shrine);
        state.rung[shrine.id] = true;
        if (startsInDaily && dailyRouteIds.includes(shrine.id)) {
          dailyState.rung[shrine.id] = true;
          writeDailyLedger();
        }
        writeState(stateKey, state);
        paint(state.current, { updateHash: true });
        scheduleScreensaver();
      });

      nextButton?.addEventListener('click', () => {
        unlockAudio();
        if (startsInDaily) {
          const currentDailyIndex = dailyRoute.findIndex(
            (shrine) => shrines.indexOf(shrine) === state.current,
          );
          const nextShrine = dailyRoute[(currentDailyIndex + 1) % dailyRoute.length];
          paint(shrines.indexOf(nextShrine), { updateHash: true, scroll: false });
        } else {
          paint(state.current + 1, { updateHash: true, scroll: true });
        }
        scheduleScreensaver();
      });

      screensaverNext?.addEventListener('click', () => {
        unlockAudio();
        advanceScreensaver();
      });

      screensaverToggle?.addEventListener('click', () => {
        unlockAudio();
        setScreensaver(true, !state.screensaver.paused);
      });

      copyButton?.addEventListener('click', async () => {
        const shrine = shrines[state.current] || shrines[0];
        await copyText(shrine.midjourney);
        copyButton.textContent = 'Copied';
        window.setTimeout(() => {
          copyButton.textContent = 'Copy Prompt';
        }, 1200);
      });

      copyReceiptButton?.addEventListener('click', async () => {
        const receipt = ensureReceipt();
        if (!receipt) return;
        await copyText(JSON.stringify(receipt, null, 2));
        copyReceiptButton.textContent = 'Copied';
        window.setTimeout(() => {
          copyReceiptButton.textContent = 'Copy Receipt JSON';
        }, 1200);
      });

      copyDailyReceiptButton?.addEventListener('click', async () => {
        const receipt = ensureDailyReceipt();
        if (!receipt) return;
        await copyText(JSON.stringify(receipt, null, 2));
        copyDailyReceiptButton.textContent = 'Copied';
        window.setTimeout(() => {
          copyDailyReceiptButton.textContent = 'Copy Daily Receipt';
        }, 1200);
      });

      window.addEventListener('hashchange', () => {
        const nextIndex = shrines.findIndex((shrine) => `#${shrine.id}` === window.location.hash);
        if (nextIndex >= 0) paint(nextIndex, { scroll: false });
      });

      const hashIndex = shrines.findIndex((shrine) => `#${shrine.id}` === window.location.hash);
      if (startsInScreensaver) {
        setScreensaver(true, false);
      } else {
        setScreensaver(false, false);
      }
      root.classList.toggle('is-daily', startsInDaily);
      if (startsInDaily && nextButton) nextButton.textContent = 'Next Daily Shrine';
      const firstWaitingDaily = dailyRoute.find((shrine) => !dailyState.rung[shrine.id]) || dailyRoute[0];
      const dailyInitialIndex = shrines.indexOf(firstWaitingDaily);
      paint(
        hashIndex >= 0
          ? hashIndex
          : startsInDaily && dailyInitialIndex >= 0
            ? dailyInitialIndex
            : state.current,
        { updateHash: startsInScreensaver || startsInDaily },
      );
    }

    initShrineCrawl();
    document.addEventListener('astro:page-load', initShrineCrawl);
  </script>
</BlockLayout>

