---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Throw — jazz fours with the computer" description="Trade four bars with the computer. The computer plays a phrase, then you play whatever you want for four bars, then the computer answers. No scoring, no right answer. Just a duet that doesn't end.">
  <main class="cth" id="cth" data-built={built}>
    <header class="cth__hero">
      <p class="cth__kicker">CAST · THROW · jazz fours · trading · no score</p>
      <h1 class="cth__title">Throw.</h1>
      <p class="cth__sub">Computer plays four bars. You play four bars back. Then the computer answers, and you go again. It's the way jazz musicians have been talking to each other for a hundred years, only there's no human on the other side and no one is keeping score.</p>
    </header>

    <section class="cth__panel">
      <div class="cth__set">
        <p class="cth__set-label">KEY</p>
        <div class="cth__pills" id="cth-key-pills">
          <button class="cth__pill cth__pill--active" data-key="C">C</button>
          <button class="cth__pill" data-key="D">D</button>
          <button class="cth__pill" data-key="Eb">E♭</button>
          <button class="cth__pill" data-key="F">F</button>
          <button class="cth__pill" data-key="G">G</button>
          <button class="cth__pill" data-key="A">A</button>
          <button class="cth__pill" data-key="Bb">B♭</button>
        </div>
      </div>
      <div class="cth__set">
        <p class="cth__set-label">TEMPO · <span id="cth-tempo-val">96</span> BPM</p>
        <input type="range" class="cth__tempo" id="cth-tempo" min="60" max="140" value="96"/>
      </div>
      <div class="cth__set">
        <p class="cth__set-label">VOICE</p>
        <div class="cth__pills" id="cth-voice-pills">
          <button class="cth__pill cth__pill--active" data-voice="vib">vib</button>
          <button class="cth__pill" data-voice="rhodes">rhodes</button>
          <button class="cth__pill" data-voice="flute">flute</button>
        </div>
      </div>
    </section>

    <section class="cth__stage" data-phase="idle" id="cth-stage">
      <div class="cth__phase-card">
        <p class="cth__phase-text" id="cth-phase-text">READY</p>
        <p class="cth__phase-sub" id="cth-phase-sub">Press Play to start trading.</p>
        <div class="cth__bar-readout">
          <span class="cth__bar-num" id="cth-bar-num">—</span>
          <span class="cth__bar-of">of 4</span>
        </div>
      </div>
      <canvas class="cth__roll" id="cth-roll" width="900" height="180"></canvas>
    </section>

    <section class="cth__keyboard" id="cth-keyboard"></section>

    <section class="cth__transport">
      <button class="cth__play" id="cth-play" type="button">
        <span class="cth__play-icon" id="cth-play-icon">▶</span>
        <span class="cth__play-label" id="cth-play-label">START TRADING</span>
      </button>
      <button class="cth__newphrase" id="cth-newphrase" type="button">NEW COMPUTER PHRASE</button>
    </section>

    <section class="cth__about">
      <h2 class="cth__about-h">What's happening under the hood</h2>
      <p>Each round is four bars at 4/4. The computer phrase is one of twelve hand-written 4-bar melodies in C major, transposed to your chosen key. Phrases use scale degrees 1/2/3/5/6 — major pentatonic — so anything you play on top in those degrees fits.</p>
      <p>Your keyboard has five keys mapped to those same pentatonic degrees. Hit a key and a note plays + writes itself onto the piano roll under the playhead. There's no scoring — the page records the exchange so you can hear the shape of the conversation.</p>
      <p>Voice palettes: <strong>vib</strong> is three detuned sines with a soft attack, <strong>rhodes</strong> is a sine + 2× harmonic with quick decay, <strong>flute</strong> is a triangle wave with a slow attack curve. All Web Audio, no samples.</p>
      <p>Pair with <a href="/cast-jam">/cast-jam</a> for free-time play, <a href="/cast-clap">/cast-clap</a> for strict rhythm matching, <a href="/cast-loop">/cast-loop</a> if you want to record what you played and loop it.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cth-ink: #0c0814;
      --cth-walnut: #4a2a1a;
      --cth-flame: #f6c15e;
      --cth-flame-deep: #d68f2c;
      --cth-cream: #f4e7c8;
      --cth-cream-dim: #c8b48a;
      --cth-cream-dimmer: #8b7a5a;
      --cth-mauve: #b39ddb;
      --cth-mint: #9bd7b8;
      --cth-rose: #e6788c;
      --cth-sky: #9ed6f0;
    }

    body:has(.cth) {
      background: radial-gradient(circle at 50% 0%, #2a1428 0%, var(--cth-ink) 60%);
      color: var(--cth-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cth { max-width: 980px; margin: 0 auto; padding: 48px 24px 80px; }

    .cth__hero { text-align: center; margin-bottom: 32px; }
    .cth__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cth-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cth__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 138px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cth-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.45);
    }
    .cth__sub {
      max-width: 680px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cth-cream-dim);
    }

    /* PANEL */
    .cth__panel {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }
    @media (max-width: 800px) { .cth__panel { grid-template-columns: 1fr; } }
    .cth__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .cth__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--cth-cream-dimmer);
      margin: 0 0 8px;
    }
    .cth__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .cth__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cth-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cth__pill:hover { background: rgba(246,193,94,0.10); }
    .cth__pill--active {
      background: var(--cth-flame);
      color: var(--cth-walnut);
      border-color: var(--cth-flame);
    }
    .cth__tempo { width: 100%; accent-color: var(--cth-flame); }

    /* STAGE */
    .cth__stage {
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 18px;
      padding: 20px 22px;
      margin-bottom: 22px;
    }
    .cth__phase-card {
      display: flex;
      align-items: baseline;
      gap: 18px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .cth__phase-text {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: 32px;
      color: var(--cth-flame);
      margin: 0;
      letter-spacing: -0.01em;
    }
    .cth__stage[data-phase="computer"] .cth__phase-text { color: var(--cth-mauve); }
    .cth__stage[data-phase="user"] .cth__phase-text { color: var(--cth-flame); animation: cthBeat 0.6s ease-in-out infinite alternate; }
    @keyframes cthBeat { from { opacity: 0.6; } to { opacity: 1; } }
    .cth__phase-sub {
      flex: 1;
      min-width: 180px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--cth-cream-dim);
      margin: 0;
    }
    .cth__bar-readout {
      font-family: 'Inter Tight', sans-serif;
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .cth__bar-num {
      font-weight: 700;
      font-size: 28px;
      color: var(--cth-flame);
      font-variant-numeric: tabular-nums;
    }
    .cth__bar-of {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cth-cream-dimmer);
    }
    .cth__roll {
      width: 100%;
      height: 180px;
      background: rgba(0,0,0,0.3);
      border-radius: 10px;
      display: block;
    }

    /* KEYBOARD */
    .cth__keyboard {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-bottom: 22px;
    }
    .cth__key {
      aspect-ratio: 3 / 4;
      max-height: 200px;
      border-radius: 14px;
      border: 0;
      background: linear-gradient(180deg, rgba(246,193,94,0.18) 0%, rgba(74,42,26,0.4) 100%);
      box-shadow: inset 0 -8px 14px rgba(0,0,0,0.4), 0 6px 20px rgba(0,0,0,0.32);
      cursor: pointer;
      padding: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      padding-bottom: 16px;
      transition: transform 60ms ease, box-shadow 100ms ease;
    }
    .cth__key:hover { transform: translateY(-2px); }
    .cth__key:active, .cth__key--down {
      transform: translateY(2px) scale(0.98);
      background: linear-gradient(180deg, rgba(246,193,94,0.42) 0%, rgba(74,42,26,0.55) 100%);
    }
    .cth__key-name {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cth-cream);
    }
    .cth__key-kbd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--cth-cream-dimmer);
      letter-spacing: 0.1em;
    }
    .cth__key--locked {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* TRANSPORT */
    .cth__transport {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 32px;
    }
    .cth__play {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      border-radius: 12px;
      border: 0;
      background: var(--cth-flame);
      color: var(--cth-walnut);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      box-shadow: 0 4px 14px rgba(246,193,94,0.32);
    }
    .cth__play:hover { background: var(--cth-flame-deep); }
    .cth__newphrase {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--cth-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cth__newphrase:hover { background: rgba(246,193,94,0.12); }

    /* ABOUT */
    .cth__about {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cth__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cth-cream);
      margin: 0 0 12px;
    }
    .cth__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--cth-cream-dim);
      margin: 0 0 12px;
    }
    .cth__about strong { color: var(--cth-cream); }
    .cth__about a { color: var(--cth-flame); text-decoration: none; }
    .cth__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // Pentatonic scale degrees (1, 2, 3, 5, 6) in semitones from root
    const PENT_DEGREES = [0, 2, 4, 7, 9];     // C-D-E-G-A in C
    const PENT_NAMES = ['1', '2', '3', '5', '6'];
    const PENT_KEYBOARDS = ['A', 'S', 'D', 'F', 'G'];

    // Key roots: MIDI of C4 = 60. Each is the MIDI of the root.
    const KEY_ROOTS: Record<string, number> = {
      'C':  60, 'D':  62, 'Eb': 63, 'F':  65, 'G':  67, 'A':  69, 'Bb': 70,
    };

    // 12 hand-written phrases. Each is an array of notes:
    // { degree: 0-4 (index into PENT_DEGREES), startBeat: 0-15.75, durationBeats: number }
    // 4 bars × 4 beats = 16 beats total.
    type PhraseNote = { degree: number; startBeat: number; durationBeats: number };
    const PHRASES: PhraseNote[][] = [
      // Phrase 1: simple stepwise climb + return
      [
        { degree: 0, startBeat: 0,    durationBeats: 1 },
        { degree: 1, startBeat: 1,    durationBeats: 1 },
        { degree: 2, startBeat: 2,    durationBeats: 1 },
        { degree: 3, startBeat: 3,    durationBeats: 1 },
        { degree: 4, startBeat: 4,    durationBeats: 2 },
        { degree: 3, startBeat: 6,    durationBeats: 2 },
        { degree: 2, startBeat: 8,    durationBeats: 4 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 2: 8th note bebop-ish
      [
        { degree: 0, startBeat: 0,    durationBeats: 0.5 },
        { degree: 1, startBeat: 0.5,  durationBeats: 0.5 },
        { degree: 2, startBeat: 1,    durationBeats: 0.5 },
        { degree: 3, startBeat: 1.5,  durationBeats: 0.5 },
        { degree: 4, startBeat: 2,    durationBeats: 1 },
        { degree: 2, startBeat: 3,    durationBeats: 1 },
        { degree: 0, startBeat: 4,    durationBeats: 2 },
        { degree: 2, startBeat: 6.5,  durationBeats: 1.5 },
        { degree: 1, startBeat: 8,    durationBeats: 1 },
        { degree: 0, startBeat: 9,    durationBeats: 3 },
        { degree: 2, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 3: leap + answer
      [
        { degree: 0, startBeat: 0,    durationBeats: 2 },
        { degree: 4, startBeat: 2,    durationBeats: 2 },
        { degree: 3, startBeat: 4,    durationBeats: 1 },
        { degree: 2, startBeat: 5,    durationBeats: 1 },
        { degree: 1, startBeat: 6,    durationBeats: 2 },
        { degree: 2, startBeat: 8.5,  durationBeats: 0.5 },
        { degree: 3, startBeat: 9,    durationBeats: 0.5 },
        { degree: 4, startBeat: 9.5,  durationBeats: 2.5 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 4: syncopated
      [
        { degree: 2, startBeat: 0.5,  durationBeats: 0.5 },
        { degree: 1, startBeat: 1,    durationBeats: 0.5 },
        { degree: 0, startBeat: 1.5,  durationBeats: 1.5 },
        { degree: 4, startBeat: 3.5,  durationBeats: 0.5 },
        { degree: 3, startBeat: 4,    durationBeats: 1 },
        { degree: 2, startBeat: 5.5,  durationBeats: 0.5 },
        { degree: 1, startBeat: 6,    durationBeats: 2 },
        { degree: 3, startBeat: 8,    durationBeats: 1.5 },
        { degree: 4, startBeat: 9.5,  durationBeats: 1.5 },
        { degree: 2, startBeat: 11,   durationBeats: 1 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 5: triplet feel
      [
        { degree: 0, startBeat: 0,       durationBeats: 0.67 },
        { degree: 2, startBeat: 0.67,    durationBeats: 0.67 },
        { degree: 4, startBeat: 1.33,    durationBeats: 0.67 },
        { degree: 3, startBeat: 2,       durationBeats: 1 },
        { degree: 1, startBeat: 3,       durationBeats: 1 },
        { degree: 0, startBeat: 4,       durationBeats: 2 },
        { degree: 2, startBeat: 6,       durationBeats: 2 },
        { degree: 4, startBeat: 8.5,     durationBeats: 1.5 },
        { degree: 3, startBeat: 10,      durationBeats: 2 },
        { degree: 0, startBeat: 12,      durationBeats: 4 },
      ],
      // Phrase 6: question (ends on 5, expecting answer)
      [
        { degree: 0, startBeat: 0,    durationBeats: 1 },
        { degree: 1, startBeat: 1,    durationBeats: 1 },
        { degree: 2, startBeat: 2,    durationBeats: 2 },
        { degree: 4, startBeat: 4,    durationBeats: 2 },
        { degree: 3, startBeat: 6,    durationBeats: 1 },
        { degree: 2, startBeat: 7,    durationBeats: 1 },
        { degree: 1, startBeat: 8,    durationBeats: 2 },
        { degree: 3, startBeat: 10,   durationBeats: 2 },
        { degree: 3, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 7: ascending arpeggio + tail
      [
        { degree: 0, startBeat: 0,    durationBeats: 0.5 },
        { degree: 2, startBeat: 0.5,  durationBeats: 0.5 },
        { degree: 4, startBeat: 1,    durationBeats: 0.5 },
        { degree: 3, startBeat: 1.5,  durationBeats: 0.5 },
        { degree: 2, startBeat: 2,    durationBeats: 2 },
        { degree: 1, startBeat: 4.5,  durationBeats: 0.5 },
        { degree: 2, startBeat: 5,    durationBeats: 1 },
        { degree: 0, startBeat: 6,    durationBeats: 2 },
        { degree: 4, startBeat: 8.5,  durationBeats: 1.5 },
        { degree: 3, startBeat: 10,   durationBeats: 1 },
        { degree: 2, startBeat: 11,   durationBeats: 1 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 8: minor 6 lean (uses degree 4 a lot)
      [
        { degree: 4, startBeat: 0,    durationBeats: 1 },
        { degree: 3, startBeat: 1,    durationBeats: 0.5 },
        { degree: 2, startBeat: 1.5,  durationBeats: 0.5 },
        { degree: 4, startBeat: 2,    durationBeats: 1 },
        { degree: 2, startBeat: 3,    durationBeats: 1 },
        { degree: 4, startBeat: 4,    durationBeats: 2 },
        { degree: 0, startBeat: 6,    durationBeats: 2 },
        { degree: 4, startBeat: 8,    durationBeats: 0.5 },
        { degree: 3, startBeat: 8.5,  durationBeats: 0.5 },
        { degree: 2, startBeat: 9,    durationBeats: 1 },
        { degree: 1, startBeat: 10,   durationBeats: 2 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 9: wide intervals
      [
        { degree: 0, startBeat: 0,    durationBeats: 1.5 },
        { degree: 4, startBeat: 1.5,  durationBeats: 0.5 },
        { degree: 1, startBeat: 2,    durationBeats: 1.5 },
        { degree: 3, startBeat: 3.5,  durationBeats: 0.5 },
        { degree: 0, startBeat: 4,    durationBeats: 1 },
        { degree: 4, startBeat: 5,    durationBeats: 1 },
        { degree: 2, startBeat: 6,    durationBeats: 2 },
        { degree: 1, startBeat: 8,    durationBeats: 1 },
        { degree: 3, startBeat: 9,    durationBeats: 1 },
        { degree: 0, startBeat: 10,   durationBeats: 2 },
        { degree: 2, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 10: descending stepwise
      [
        { degree: 4, startBeat: 0,    durationBeats: 1 },
        { degree: 3, startBeat: 1,    durationBeats: 1 },
        { degree: 2, startBeat: 2,    durationBeats: 1 },
        { degree: 1, startBeat: 3,    durationBeats: 1 },
        { degree: 0, startBeat: 4,    durationBeats: 4 },
        { degree: 1, startBeat: 8,    durationBeats: 1 },
        { degree: 2, startBeat: 9,    durationBeats: 1 },
        { degree: 1, startBeat: 10,   durationBeats: 2 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
      // Phrase 11: melodic motif × 2
      [
        { degree: 0, startBeat: 0,    durationBeats: 1 },
        { degree: 2, startBeat: 1,    durationBeats: 1 },
        { degree: 1, startBeat: 2,    durationBeats: 1 },
        { degree: 0, startBeat: 3,    durationBeats: 1 },
        { degree: 2, startBeat: 4,    durationBeats: 1 },
        { degree: 4, startBeat: 5,    durationBeats: 1 },
        { degree: 3, startBeat: 6,    durationBeats: 1 },
        { degree: 2, startBeat: 7,    durationBeats: 1 },
        { degree: 0, startBeat: 8,    durationBeats: 1 },
        { degree: 2, startBeat: 9,    durationBeats: 1 },
        { degree: 1, startBeat: 10,   durationBeats: 1 },
        { degree: 0, startBeat: 11,   durationBeats: 5 },
      ],
      // Phrase 12: long opening, busy ending
      [
        { degree: 0, startBeat: 0,    durationBeats: 4 },
        { degree: 4, startBeat: 4,    durationBeats: 2 },
        { degree: 3, startBeat: 6,    durationBeats: 1 },
        { degree: 2, startBeat: 7,    durationBeats: 1 },
        { degree: 1, startBeat: 8,    durationBeats: 0.5 },
        { degree: 2, startBeat: 8.5,  durationBeats: 0.5 },
        { degree: 3, startBeat: 9,    durationBeats: 0.5 },
        { degree: 4, startBeat: 9.5,  durationBeats: 0.5 },
        { degree: 3, startBeat: 10,   durationBeats: 0.5 },
        { degree: 2, startBeat: 10.5, durationBeats: 0.5 },
        { degree: 1, startBeat: 11,   durationBeats: 1 },
        { degree: 0, startBeat: 12,   durationBeats: 4 },
      ],
    ];

    type Voice = 'vib' | 'rhodes' | 'flute';
    let currentKey = 'C';
    let tempo = 96;
    let voice: Voice = 'vib';
    let currentPhraseIdx = 0;
    let phase: 'idle' | 'computer' | 'user' = 'idle';
    let playing = false;

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let phaseStartCtxTime = 0;
    let userHits: { degree: number; beat: number }[] = [];
    let rafId: number | null = null;
    let timers: number[] = [];

    function beatSec() { return 60 / tempo; }
    function midiToHz(m: number) { return 440 * Math.pow(2, (m - 69) / 12); }

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }

    function playNote(midi: number, atCtxTime: number, durationSec: number, isComputer = false) {
      if (!ctx || !scheduler || !masterGain) return;
      const hz = midiToHz(midi);
      const t = atCtxTime;
      // Voice-specific stacks
      const stacks: { type: OscillatorType; freq: number; gain: number; detune?: number }[] =
        voice === 'sine' as any ? [{ type: 'sine', freq: hz, gain: 0.32 }] :
        voice === 'vib' ? [
          { type: 'sine', freq: hz, gain: 0.26 },
          { type: 'sine', freq: hz, gain: 0.18, detune: 5 },
          { type: 'sine', freq: hz, gain: 0.18, detune: -7 },
        ] :
        voice === 'rhodes' ? [
          { type: 'sine', freq: hz, gain: 0.34 },
          { type: 'sine', freq: hz * 2, gain: 0.10 },
        ] :
        // flute
        [
          { type: 'triangle', freq: hz, gain: 0.32 },
          { type: 'sine', freq: hz, gain: 0.14, detune: 4 },
        ];

      const attackSec = voice === 'flute' ? 0.05 : voice === 'rhodes' ? 0.005 : 0.015;
      const decayTarget = voice === 'rhodes' ? 0.4 : 1.0;  // rhodes-y
      const releaseSec = 0.18;
      const tail = Math.max(durationSec, 0.18);
      for (const v of stacks) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = v.type;
        osc.frequency.value = v.freq;
        if (v.detune) osc.detune.value = v.detune;
        const peak = v.gain * (isComputer ? 0.9 : 1.0);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(peak, t + attackSec);
        // sustain → decay portion
        g.gain.setTargetAtTime(peak * decayTarget, t + attackSec, durationSec * 0.3 + 0.1);
        g.gain.setValueAtTime(g.gain.value, t + tail - releaseSec);
        g.gain.exponentialRampToValueAtTime(0.0001, t + tail);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + tail + 0.05);
      }
    }

    function clearTimers() {
      for (const id of timers) clearTimeout(id);
      timers = [];
      if (rafId != null) cancelAnimationFrame(rafId);
      rafId = null;
    }

    function pickPhrase() {
      // pick a different phrase
      let next = currentPhraseIdx;
      while (next === currentPhraseIdx) next = Math.floor(Math.random() * PHRASES.length);
      currentPhraseIdx = next;
    }

    function startComputer() {
      if (!ctx) return;
      phase = 'computer';
      document.getElementById('cth-stage')!.setAttribute('data-phase', 'computer');
      document.getElementById('cth-phase-text')!.textContent = 'COMPUTER';
      document.getElementById('cth-phase-sub')!.textContent = 'listen';
      pickPhrase();
      const phrase = PHRASES[currentPhraseIdx];
      const root = KEY_ROOTS[currentKey];
      const bs = beatSec();
      phaseStartCtxTime = ctx.currentTime + 0.06;
      // schedule each note
      for (const n of phrase) {
        const midi = root + PENT_DEGREES[n.degree];
        const at = phaseStartCtxTime + n.startBeat * bs;
        playNote(midi, at, n.durationBeats * bs, true);
      }
      // schedule the switch to user at end of 16 beats
      const endCtx = phaseStartCtxTime + 16 * bs;
      timers.push(window.setTimeout(() => startUser(), (endCtx - ctx.currentTime) * 1000));
      drawRoll();
    }

    function startUser() {
      if (!ctx) return;
      phase = 'user';
      userHits = [];
      document.getElementById('cth-stage')!.setAttribute('data-phase', 'user');
      document.getElementById('cth-phase-text')!.textContent = 'YOUR TURN';
      document.getElementById('cth-phase-sub')!.textContent = 'play four bars, anything in the scale';
      phaseStartCtxTime = ctx.currentTime + 0.04;
      const bs = beatSec();
      const endCtx = phaseStartCtxTime + 16 * bs;
      timers.push(window.setTimeout(() => {
        if (!playing) return;
        startComputer();
      }, (endCtx - ctx.currentTime) * 1000));
      drawRoll();
    }

    function userTap(degree: number) {
      if (!ctx || phase !== 'user') return;
      const root = KEY_ROOTS[currentKey];
      const midi = root + PENT_DEGREES[degree];
      playNote(midi, ctx.currentTime + 0.005, 0.5, false);
      const bs = beatSec();
      const beat = (ctx.currentTime - phaseStartCtxTime) / bs;
      if (beat >= 0 && beat < 16) {
        userHits.push({ degree, beat });
      }
      // pressed feedback
      const key = document.querySelector(`.cth__key[data-i="${degree}"]`);
      if (key) {
        key.classList.add('cth__key--down');
        setTimeout(() => key.classList.remove('cth__key--down'), 110);
      }
    }

    function drawRoll() {
      const canvas = document.getElementById('cth-roll') as HTMLCanvasElement;
      const ctx2 = canvas.getContext('2d')!;
      const W = canvas.width, H = canvas.height;
      ctx2.clearRect(0, 0, W, H);
      // background lanes (5 lanes for 5 pentatonic degrees, top = highest)
      const laneH = H / 5;
      for (let i = 0; i < 5; i++) {
        ctx2.fillStyle = i % 2 === 0 ? 'rgba(244,231,200,0.04)' : 'rgba(244,231,200,0.02)';
        ctx2.fillRect(0, i * laneH, W, laneH);
        // degree label
        ctx2.fillStyle = 'rgba(244,231,200,0.32)';
        ctx2.font = '9px JetBrains Mono, monospace';
        ctx2.fillText(PENT_NAMES[4 - i], 6, i * laneH + 12);
      }
      // bar gridlines
      for (let bar = 0; bar <= 4; bar++) {
        const x = (bar / 4) * W;
        ctx2.strokeStyle = bar === 0 || bar === 4 ? 'rgba(246,193,94,0.32)' : 'rgba(244,231,200,0.08)';
        ctx2.lineWidth = bar === 0 || bar === 4 ? 1.5 : 1;
        ctx2.beginPath(); ctx2.moveTo(x, 0); ctx2.lineTo(x, H); ctx2.stroke();
      }
      // computer phrase notes (lavender)
      if (phase === 'computer' || phase === 'user') {
        const phrase = PHRASES[currentPhraseIdx];
        for (const n of phrase) {
          const x = (n.startBeat / 16) * W;
          const w = (n.durationBeats / 16) * W;
          const y = (4 - n.degree) * laneH + 4;
          ctx2.fillStyle = phase === 'computer' ? 'rgba(179,157,219,0.65)' : 'rgba(179,157,219,0.32)';
          roundRect(ctx2, x, y, Math.max(2, w - 2), laneH - 8, 4);
          ctx2.fill();
        }
      }
      // user hits (flame)
      for (const h of userHits) {
        const x = (h.beat / 16) * W;
        const y = (4 - h.degree) * laneH + 4;
        ctx2.fillStyle = '#f6c15e';
        roundRect(ctx2, x, y, 6, laneH - 8, 3);
        ctx2.fill();
      }
      // playhead
      if (ctx && (phase === 'computer' || phase === 'user')) {
        const bs = beatSec();
        const beat = (ctx.currentTime - phaseStartCtxTime) / bs;
        if (beat >= 0 && beat <= 16) {
          const x = (beat / 16) * W;
          ctx2.strokeStyle = phase === 'computer' ? 'rgba(179,157,219,0.9)' : 'rgba(246,193,94,0.9)';
          ctx2.lineWidth = 2;
          ctx2.beginPath(); ctx2.moveTo(x, 0); ctx2.lineTo(x, H); ctx2.stroke();
          // bar number
          const bar = Math.floor(beat / 4) + 1;
          document.getElementById('cth-bar-num')!.textContent = String(Math.min(4, bar));
        }
      }
      if (playing) rafId = requestAnimationFrame(drawRoll);
    }

    function roundRect(ctx2: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      ctx2.beginPath();
      ctx2.moveTo(x + r, y);
      ctx2.lineTo(x + w - r, y);
      ctx2.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx2.lineTo(x + w, y + h - r);
      ctx2.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx2.lineTo(x + r, y + h);
      ctx2.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx2.lineTo(x, y + r);
      ctx2.quadraticCurveTo(x, y, x + r, y);
    }

    function startTrading() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      document.getElementById('cth-play-icon')!.textContent = '■';
      document.getElementById('cth-play-label')!.textContent = 'STOP';
      startComputer();
    }

    function stopTrading() {
      playing = false;
      clearTimers();
      if (scheduler) scheduler.stopAll();
      phase = 'idle';
      document.getElementById('cth-stage')!.setAttribute('data-phase', 'idle');
      document.getElementById('cth-phase-text')!.textContent = 'READY';
      document.getElementById('cth-phase-sub')!.textContent = 'Press Play to start trading.';
      document.getElementById('cth-bar-num')!.textContent = '—';
      document.getElementById('cth-play-icon')!.textContent = '▶';
      document.getElementById('cth-play-label')!.textContent = 'START TRADING';
      const canvas = document.getElementById('cth-roll') as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      c2.clearRect(0, 0, canvas.width, canvas.height);
    }

    function renderKeyboard() {
      const wrap = document.getElementById('cth-keyboard')!;
      wrap.innerHTML = PENT_DEGREES.map((_, i) => `
        <button class="cth__key" data-i="${i}">
          <span class="cth__key-name">${PENT_NAMES[i]}</span>
          <span class="cth__key-kbd">${PENT_KEYBOARDS[i]}</span>
        </button>
      `).join('');
    }

    function init() {
      renderKeyboard();
      // initial pill state
      document.querySelectorAll('.cth__pill').forEach(el => {
        const k = el.getAttribute('data-key');
        const v = el.getAttribute('data-voice');
        if (k === currentKey) el.classList.add('cth__pill--active');
        if (v === voice) el.classList.add('cth__pill--active');
      });

      document.getElementById('cth-key-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-key]');
        if (!btn) return;
        currentKey = btn.getAttribute('data-key')!;
        document.querySelectorAll('#cth-key-pills .cth__pill').forEach(el =>
          el.classList.toggle('cth__pill--active', el === btn));
      });
      document.getElementById('cth-voice-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-voice]');
        if (!btn) return;
        voice = btn.getAttribute('data-voice') as Voice;
        document.querySelectorAll('#cth-voice-pills .cth__pill').forEach(el =>
          el.classList.toggle('cth__pill--active', el === btn));
      });
      const tempoSlider = document.getElementById('cth-tempo') as HTMLInputElement;
      tempoSlider.addEventListener('input', () => {
        tempo = parseInt(tempoSlider.value);
        document.getElementById('cth-tempo-val')!.textContent = String(tempo);
      });

      // keyboard taps
      document.getElementById('cth-keyboard')!.addEventListener('pointerdown', e => {
        const btn = (e.target as HTMLElement).closest('.cth__key');
        if (!btn) return;
        e.preventDefault();
        const i = parseInt(btn.getAttribute('data-i')!);
        userTap(i);
      });

      // keyboard keys
      window.addEventListener('keydown', e => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        const idx = PENT_KEYBOARDS.indexOf(e.key.toUpperCase());
        if (idx >= 0) { e.preventDefault(); userTap(idx); }
      });

      // play
      document.getElementById('cth-play')!.addEventListener('click', () => {
        if (playing) stopTrading();
        else startTrading();
      });
      // new phrase mid-flight: queue a different phrase for the next computer turn
      document.getElementById('cth-newphrase')!.addEventListener('click', () => {
        if (!playing) {
          ensureCtx();
          startTrading();
        } else if (phase === 'user') {
          // pre-pick a different phrase so the next computer turn uses it
          let next = currentPhraseIdx;
          while (next === currentPhraseIdx) next = Math.floor(Math.random() * PHRASES.length);
          currentPhraseIdx = next - 1; // pickPhrase will pick a different one again
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) stopTrading();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
