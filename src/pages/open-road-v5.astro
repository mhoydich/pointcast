---
import BlockLayout from '../layouts/BlockLayout.astro';
import farSail from '../assets/shrines/open-road-v5/far-sail.webp';
import farPier from '../assets/shrines/open-road-v5/far-pier.webp';
import farWindow from '../assets/shrines/open-road-v5/far-window.webp';
import farFuji from '../assets/shrines/open-road-v5/far-fuji.webp';
import farOcean from '../assets/shrines/open-road-v5/far-ocean.webp';
import nearCabin from '../assets/shrines/open-road-v5/near-cabin.webp';
import nearChapel from '../assets/shrines/open-road-v5/near-chapel.webp';
import nearTatami from '../assets/shrines/open-road-v5/near-tatami.webp';
import nearNeon from '../assets/shrines/open-road-v5/near-neon.webp';
import nearLamp from '../assets/shrines/open-road-v5/near-lamp.webp';
import socialCard from '../assets/shrines/open-road-v5/open-road-v5-og.jpg';

const title = 'Open Road V · The Window You Make';
const description =
  'Choose five works from a deeper image archive and let them become a personal stained-glass window and five-line prayer.';
const PETAL_COUNT = 5;

const fragments = [
  {
    id: 'sail',
    group: 'far',
    name: 'Sail',
    blessing: 'Bless the balance that keeps a small sail upright.',
    image: farSail,
    alt: 'A white sailboat crosses blue-green water beneath a coral sun, framed like a sophisticated 1980s computer-game poster.',
  },
  {
    id: 'pier',
    group: 'far',
    name: 'Pier',
    blessing: 'Bless the table that stays open beside the weather.',
    image: farPier,
    alt: 'A small Japanese ramen house stands at the end of a wet pier while immense pale waves gather around it.',
  },
  {
    id: 'ocean-window',
    group: 'far',
    name: 'Ocean room',
    blessing: 'Bless the room that lets the sea come near.',
    image: farWindow,
    alt: 'Books and flowers sit at a wooden window as a luminous turquoise ocean wave rises just beyond the glass.',
  },
  {
    id: 'fuji',
    group: 'far',
    name: 'Fuji',
    blessing: 'Bless the mountain that does not hurry.',
    image: farFuji,
    alt: 'Mount Fuji rendered in thick blue and white paint above a fiery forest of red and gold autumn leaves.',
  },
  {
    id: 'indigo-sea',
    group: 'far',
    name: 'Indigo sea',
    blessing: 'Bless the wave that returns without repeating.',
    image: farOcean,
    alt: 'An indigo ocean and distant mountain drawn in delicate vintage lines beneath layered clouds and a quiet sun.',
  },
  {
    id: 'cabin',
    group: 'near',
    name: 'Cabin',
    blessing: 'Bless the quiet instruments of attention.',
    image: nearCabin,
    alt: 'A rose-colored midcentury captain’s cabin curves around a small table, soft seats, and a distant control console.',
  },
  {
    id: 'chapel',
    group: 'near',
    name: 'Open chapel',
    blessing: 'Bless the shelter with no locked door.',
    image: nearChapel,
    alt: 'A round timber pavilion glows warmly in a dark garden, open on every side beside a thin curtain of water.',
  },
  {
    id: 'tatami',
    group: 'near',
    name: 'Tatami room',
    blessing: 'Bless the room that makes space for green.',
    image: nearTatami,
    alt: 'A spare green-and-white tatami pavilion opens completely to a small rock garden and sculpted pine.',
  },
  {
    id: 'neon-bloom',
    group: 'near',
    name: 'Night bloom',
    blessing: 'Bless the bloom that carries its own night.',
    image: nearNeon,
    alt: 'Translucent flowers glow in hair-thin coral, violet, blue, and gold lines against a deep black field.',
  },
  {
    id: 'lamplight',
    group: 'near',
    name: 'Lamplight',
    blessing: 'Bless the small light kept for another.',
    image: nearLamp,
    alt: 'A patterned ceramic lamp glows against a coral wall while a small pale cat sits quietly in its shadow.',
  },
];

const groups = [
  { id: 'far', name: 'Far signals', note: 'weather · water · distance' },
  { id: 'near', name: 'Small sanctuaries', note: 'shelter · bloom · lamplight' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v5',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout title={title} description={description} image={socialCard.src} jsonLd={jsonLd}>
  <section
    class="or5"
    id="open-road-v5-shrine"
    aria-labelledby="or5-title"
    data-complete="false"
    data-paused="false"
  >
    <span class="or5__glint" id="or5-glint" aria-hidden="true"></span>

    <nav class="or5__wayfinding" aria-label="Open Road editions">
      <a href="/" aria-label="Return to PointCast home"><span aria-hidden="true">←</span> PointCast</a>
      <span aria-hidden="true">·</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <a href="/open-road-v3">III</a>
      <a href="/open-road-v4">IV</a>
      <span aria-current="page">V</span>
    </nav>

    <header class="or5__header">
      <div class="or5__title-lockup">
        <span class="or5__edition" aria-hidden="true">V</span>
        <div>
          <p class="or5__eyebrow">Open Road V · The Window You Make</p>
          <h1 id="or5-title">Choose five fragments.<br />Let one light pass through.</h1>
          <p class="or5__opening">
            Ten works from the deeper archive. No prescribed path. The prayer follows the order you choose.
          </p>
        </div>
      </div>

      <button class="or5__sound" id="or5-sound" type="button" aria-pressed="false">
        <span aria-hidden="true">◌</span>
        <span id="or5-sound-label">Glass tones off</span>
      </button>
    </header>

    <main class="or5__workbench">
      <section class="or5__window-panel" aria-labelledby="or5-window-title">
        <div class="or5__window-heading">
          <div>
            <p class="or5__section-mark">Your window</p>
            <h2 id="or5-window-title">Five pieces of one light</h2>
          </div>
          <p class="or5__count" id="or5-count" aria-hidden="true">0 / 5</p>
        </div>

        <div class="or5__rosette" id="or5-rosette" aria-label="Five-petal image window">
          <span class="or5__halo" aria-hidden="true"></span>
          {Array.from({ length: PETAL_COUNT }, (_, index) => (
            <button
              class="or5__petal"
              type="button"
              data-petal={index}
              style={`--petal: ${index};`}
              aria-label={`Empty window petal ${index + 1}`}
              disabled
            >
              <span class="or5__petal-empty" aria-hidden="true">{index + 1}</span>
              <img data-petal-image alt="" hidden />
            </button>
          ))}
          <div class="or5__heart" aria-hidden="true">
            <span></span>
            <i></i>
          </div>
          <span class="or5__sweep" aria-hidden="true"></span>
        </div>

        <div class="or5__prayer" aria-labelledby="or5-prayer-title">
          <p class="or5__section-mark" id="or5-prayer-title">The prayer taking shape</p>
          <ol id="or5-prayer-lines">
            {Array.from({ length: PETAL_COUNT }, (_, index) => (
              <li data-prayer-line={index}>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p>Choose a fragment.</p>
              </li>
            ))}
          </ol>
          <p class="or5__closing" id="or5-closing" hidden>
            What was separate has learned one light.
          </p>
        </div>

        <div class="or5__actions">
          <button id="or5-undo" type="button" disabled><span aria-hidden="true">↶</span> Undo</button>
          <button id="or5-reset" type="button" disabled>Begin again</button>
          <button id="or5-share" class="or5__share" type="button" hidden>
            <span aria-hidden="true">↗</span> Share this window
          </button>
        </div>
      </section>

      <section class="or5__library" aria-labelledby="or5-library-title">
        <div class="or5__library-heading">
          <p class="or5__section-mark">Fragment library</p>
          <h2 id="or5-library-title">Choose in any order</h2>
          <p>A chosen work remains available to inspect, but it cannot enter the window twice.</p>
        </div>

        {groups.map((group) => (
          <section class="or5__group" aria-labelledby={`or5-group-${group.id}`}>
            <header>
              <h3 id={`or5-group-${group.id}`}>{group.name}</h3>
              <span>{group.note}</span>
            </header>
            <div class="or5__fragments" role="group" aria-label={group.name}>
              {fragments.map((fragment) => fragment.group === group.id && (
                <article class="or5__fragment-card" data-card={fragment.id}>
                  <button
                    class="or5__fragment"
                    type="button"
                    data-fragment
                    data-id={fragment.id}
                    data-name={fragment.name}
                    data-blessing={fragment.blessing}
                    data-image={fragment.image.src}
                    data-alt={fragment.alt}
                    aria-label={`Add ${fragment.name} to the window`}
                    aria-pressed="false"
                  >
                    <span class="or5__fragment-image">
                      <img src={fragment.image.src} alt="" loading="lazy" decoding="async" />
                      <i aria-hidden="true">+</i>
                    </span>
                    <span class="or5__fragment-copy">
                      <strong>{fragment.name}</strong>
                      <small>{fragment.blessing}</small>
                    </span>
                  </button>
                  <button
                    class="or5__inspect"
                    type="button"
                    data-inspect
                    data-name={fragment.name}
                    data-image={fragment.image.src}
                    data-alt={fragment.alt}
                    aria-label={`View the full ${fragment.name} image`}
                  >
                    View whole image
                  </button>
                </article>
              ))}
            </div>
          </section>
        ))}
      </section>
    </main>

    <footer class="or5__footer">
      <p>The window belongs to the order you chose.</p>
      <a href="/open-road-v4"><span aria-hidden="true">←</span> Return to the bell</a>
    </footer>

    <p class="sr-only" id="or5-status" role="status" aria-live="polite" aria-atomic="true">
      The window is empty. Choose five fragments.
    </p>

    <dialog class="or5__dialog" id="or5-dialog" aria-labelledby="or5-dialog-title">
      <div class="or5__dialog-inner">
        <header>
          <div>
            <p class="or5__section-mark">The whole image</p>
            <h2 id="or5-dialog-title">Fragment</h2>
          </div>
          <button id="or5-dialog-close" type="button" aria-label="Close full image">×</button>
        </header>
        <figure>
          <img id="or5-dialog-image" src={farSail.src} alt="" />
          <figcaption id="or5-dialog-caption"></figcaption>
        </figure>
      </div>
    </dialog>
  </section>
</BlockLayout>

<style>
  :global(body:has(#open-road-v5-shrine)) {
    background: #110e18;
  }

  :global(body:has(#open-road-v5-shrine) #pc-fb),
  :global(body:has(#open-road-v5-shrine) #pc-spell-layer),
  :global(body:has(#open-road-v5-shrine) #cursor-room),
  :global(body:has(#open-road-v5-shrine) #pc-freshness),
  :global(body:has(#open-road-v5-shrine) #pc-first-see) {
    display: none !important;
  }

  :global(body:has(#open-road-v5-shrine) #main-content) {
    max-width: none;
    padding: 0;
  }

  :global(html.cr-cursor-active body:has(#open-road-v5-shrine)),
  :global(html.cr-cursor-active body:has(#open-road-v5-shrine) #main-content),
  :global(html.cr-cursor-active body:has(#open-road-v5-shrine) #main-content *) {
    cursor: auto !important;
  }

  :global(html.cr-cursor-active body:has(#open-road-v5-shrine) a),
  :global(html.cr-cursor-active body:has(#open-road-v5-shrine) button) {
    cursor: pointer !important;
  }

  .or5 {
    --ink: #110e18;
    --ink-soft: #1c1724;
    --glass: #292031;
    --parchment: #eadfc8;
    --paper-soft: #c9bea8;
    --copper: #b87349;
    --copper-light: #e2ae79;
    --sage: #87a58f;
    --line: rgba(226, 174, 121, 0.28);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--parchment);
    background:
      radial-gradient(circle at 19% 8%, rgba(111, 65, 103, 0.2), transparent 31rem),
      radial-gradient(circle at 74% 35%, rgba(184, 115, 73, 0.11), transparent 38rem),
      linear-gradient(145deg, #17111d 0%, #0d0c13 57%, #15101a 100%);
    font-family: Georgia, 'Times New Roman', serif;
    isolation: isolate;
  }

  .or5::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: '';
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 4px 4px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .or5__glint {
    display: none;
    position: fixed;
    z-index: 40;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    pointer-events: none;
    background: #ffe9bd;
    box-shadow: 0 0 11px 3px rgba(226, 174, 121, 0.55);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .or5__wayfinding,
  .or5__header,
  .or5__workbench,
  .or5__footer {
    width: min(1540px, calc(100% - 64px));
    margin-inline: auto;
  }

  .or5__wayfinding {
    display: flex;
    align-items: center;
    gap: 11px;
    padding-block: 24px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--paper-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .or5__wayfinding a {
    color: inherit;
    text-decoration: none;
  }

  .or5__wayfinding a:hover,
  .or5__wayfinding a:focus-visible {
    color: var(--copper-light);
  }

  .or5__wayfinding [aria-current='page'] {
    color: var(--copper-light);
  }

  .or5__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
    padding-block: clamp(34px, 5vw, 74px) clamp(32px, 4vw, 60px);
  }

  .or5__title-lockup {
    display: flex;
    align-items: flex-start;
    gap: clamp(18px, 3vw, 42px);
  }

  .or5__edition {
    margin-top: -0.12em;
    color: transparent;
    font-size: clamp(5rem, 10vw, 9.5rem);
    font-style: italic;
    line-height: 0.84;
    -webkit-text-stroke: 1px rgba(226, 174, 121, 0.55);
  }

  .or5__eyebrow,
  .or5__section-mark {
    margin: 0 0 12px;
    color: var(--copper-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.67rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .or5 h1 {
    max-width: 880px;
    margin: 0;
    font-size: clamp(2.4rem, 5.1vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .or5__opening {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--paper-soft);
    font-size: clamp(1rem, 1.5vw, 1.28rem);
    line-height: 1.6;
  }

  .or5__sound {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 15px;
    color: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(24, 19, 30, 0.72);
    font: 600 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .or5__sound[aria-pressed='true'] {
    color: var(--parchment);
    border-color: var(--copper);
    background: rgba(184, 115, 73, 0.15);
  }

  .or5__workbench {
    display: grid;
    grid-template-columns: minmax(430px, 0.92fr) minmax(520px, 1.08fr);
    gap: clamp(28px, 4vw, 70px);
    align-items: start;
    padding-bottom: 70px;
  }

  .or5__window-panel {
    position: sticky;
    top: 20px;
    min-width: 0;
    padding: clamp(22px, 3vw, 40px);
    border: 1px solid var(--line);
    background: rgba(13, 12, 19, 0.68);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(12px);
  }

  .or5__window-heading,
  .or5__library-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
  }

  .or5__window-heading h2,
  .or5__library-heading h2,
  .or5__dialog h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .or5__count {
    margin: 0;
    color: var(--copper-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
  }

  .or5__rosette {
    position: relative;
    width: min(100%, 570px);
    margin: clamp(24px, 4vw, 50px) auto 38px;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .or5__rosette::before,
  .or5__rosette::after,
  .or5__halo {
    position: absolute;
    inset: 5%;
    border: 1px solid rgba(226, 174, 121, 0.16);
    border-radius: 50%;
    content: '';
  }

  .or5__rosette::after {
    inset: 17%;
    border-style: dashed;
    opacity: 0.55;
    animation: or5-turn 50s linear infinite;
  }

  .or5__halo {
    inset: 22%;
    border: 0;
    background: radial-gradient(circle, rgba(226, 174, 121, 0.13), transparent 68%);
    filter: blur(16px);
    opacity: 0.25;
    transition: opacity 1.2s ease, transform 1.2s ease;
  }

  .or5__petal {
    --angle: calc(var(--petal) * 72deg);
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: 34%;
    height: 42%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(226, 174, 121, 0.45);
    border-radius: 55% 55% 30% 30% / 66% 66% 28% 28%;
    background: linear-gradient(180deg, rgba(70, 50, 75, 0.3), rgba(16, 13, 21, 0.72));
    clip-path: polygon(50% 0, 89% 16%, 100% 64%, 72% 89%, 50% 100%, 28% 89%, 0 64%, 11% 16%);
    transform: translate(-50%, -100%) rotate(var(--angle)) translateY(-8%);
    transform-origin: 50% 100%;
    transition: filter 240ms ease, opacity 240ms ease;
  }

  .or5__petal:not(:disabled):hover,
  .or5__petal:not(:disabled):focus-visible {
    filter: brightness(1.12) saturate(1.08);
  }

  .or5__petal img {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    object-fit: cover;
    transform: rotate(calc(var(--angle) * -1));
    transition: opacity 500ms ease, filter 500ms ease;
  }

  .or5__petal.is-new img {
    animation: or5-arrive 820ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .or5__petal-empty {
    display: grid;
    position: absolute;
    inset: 18%;
    place-items: center;
    color: rgba(234, 223, 200, 0.25);
    font: 500 0.72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    transform: rotate(calc(var(--angle) * -1));
  }

  .or5__petal.is-filled .or5__petal-empty {
    display: none;
  }

  .or5__heart {
    display: grid;
    position: absolute;
    z-index: 5;
    inset: 40%;
    place-items: center;
    border: 1px solid rgba(226, 174, 121, 0.55);
    border-radius: 50%;
    background: #18121d;
    box-shadow: 0 0 0 8px rgba(17, 14, 24, 0.78);
    transition: background 1.2s ease, box-shadow 1.2s ease, transform 1.2s ease;
  }

  .or5__heart span,
  .or5__heart i {
    position: absolute;
    width: 24%;
    height: 24%;
    border: 1px solid rgba(226, 174, 121, 0.45);
    transform: rotate(45deg);
  }

  .or5__heart i {
    transform: rotate(90deg);
  }

  .or5[data-complete='true'] .or5__heart {
    background: #f0c486;
    box-shadow:
      0 0 0 8px rgba(17, 14, 24, 0.76),
      0 0 34px 12px rgba(240, 196, 134, 0.4),
      0 0 90px 30px rgba(184, 115, 73, 0.2);
    transform: scale(1.05);
  }

  .or5[data-complete='true'] .or5__halo {
    opacity: 1;
    transform: scale(1.18);
  }

  .or5__sweep {
    position: absolute;
    z-index: 6;
    inset: 7%;
    overflow: hidden;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
  }

  .or5__sweep::after {
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: -28%;
    width: 22%;
    content: '';
    background: linear-gradient(90deg, transparent, rgba(255, 238, 197, 0.55), transparent);
    filter: blur(9px);
    transform: rotate(12deg);
  }

  .or5[data-complete='true'] .or5__sweep {
    opacity: 1;
  }

  .or5[data-complete='true'] .or5__sweep::after {
    animation: or5-sweep 9s ease-in-out infinite;
  }

  .or5__prayer {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .or5__prayer ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .or5__prayer li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 12px;
    align-items: baseline;
    min-height: 42px;
    padding-block: 9px;
    border-bottom: 1px solid rgba(226, 174, 121, 0.12);
  }

  .or5__prayer li span {
    color: rgba(226, 174, 121, 0.55);
    font: 500 0.6rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
  }

  .or5__prayer li p {
    margin: 0;
    color: rgba(201, 190, 168, 0.42);
    font-size: clamp(0.94rem, 1.2vw, 1.08rem);
    line-height: 1.4;
  }

  .or5__prayer li.is-filled p {
    color: var(--parchment);
  }

  .or5__closing {
    margin: 24px 0 0;
    color: var(--copper-light);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-style: italic;
    line-height: 1.35;
  }

  .or5__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .or5__actions button {
    min-height: 44px;
    padding: 10px 15px;
    color: var(--paper-soft);
    border: 1px solid var(--line);
    background: transparent;
    font: 600 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .or5__actions button:hover:not(:disabled),
  .or5__actions button:focus-visible:not(:disabled) {
    color: var(--parchment);
    border-color: var(--copper-light);
  }

  .or5__actions button:disabled {
    opacity: 0.34;
  }

  .or5__actions .or5__share {
    color: #18121d;
    border-color: var(--copper-light);
    background: var(--copper-light);
  }

  .or5__library {
    min-width: 0;
  }

  .or5__library-heading {
    display: block;
    padding: 0 0 26px;
    border-bottom: 1px solid var(--line);
  }

  .or5__library-heading > p:last-child {
    max-width: 600px;
    margin: 13px 0 0;
    color: var(--paper-soft);
    line-height: 1.55;
  }

  .or5__group {
    padding-block: 28px 34px;
    border-bottom: 1px solid var(--line);
  }

  .or5__group > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 17px;
  }

  .or5__group h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 400;
  }

  .or5__group header span {
    color: rgba(201, 190, 168, 0.62);
    font: 500 0.62rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .or5__fragments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .or5__fragment-card {
    position: relative;
    min-width: 0;
    border: 1px solid rgba(226, 174, 121, 0.19);
    background: rgba(31, 24, 38, 0.56);
    transition: border-color 220ms ease, opacity 220ms ease, transform 220ms ease;
  }

  .or5__fragment-card:hover {
    border-color: rgba(226, 174, 121, 0.46);
    transform: translateY(-2px);
  }

  .or5__fragment-card.is-selected {
    border-color: var(--copper);
    background: rgba(184, 115, 73, 0.11);
  }

  .or5__fragment {
    display: grid;
    width: 100%;
    padding: 0;
    color: inherit;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .or5__fragment:disabled {
    opacity: 0.42;
  }

  .or5__fragment-image {
    display: block;
    position: relative;
    height: clamp(150px, 17vw, 245px);
    padding: 9px;
    overflow: hidden;
    background: rgba(7, 7, 10, 0.72);
  }

  .or5__fragment-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 400ms ease;
  }

  .or5__fragment:not(:disabled):hover .or5__fragment-image img,
  .or5__fragment:focus-visible .or5__fragment-image img {
    transform: scale(1.025);
  }

  .or5__fragment-image i {
    display: grid;
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 30px;
    height: 30px;
    place-items: center;
    color: #1b131e;
    border-radius: 50%;
    background: var(--parchment);
    font: normal 1.1rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: transform 240ms ease, background 240ms ease;
  }

  .or5__fragment[aria-pressed='true'] .or5__fragment-image i {
    background: var(--copper-light);
    transform: rotate(45deg);
  }

  .or5__fragment-copy {
    display: grid;
    gap: 7px;
    padding: 15px 15px 11px;
  }

  .or5__fragment-copy strong {
    font-size: 1.08rem;
    font-weight: 400;
  }

  .or5__fragment-copy small {
    min-height: 2.8em;
    color: var(--paper-soft);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .or5__inspect {
    min-height: 38px;
    margin: 0 15px 13px;
    padding: 0;
    color: rgba(226, 174, 121, 0.75);
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    font: 600 0.6rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .or5__inspect:hover,
  .or5__inspect:focus-visible {
    color: var(--copper-light);
    border-bottom-color: currentColor;
  }

  .or5__footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-block: 26px 40px;
    color: var(--paper-soft);
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }

  .or5__footer p {
    margin: 0;
    font-style: italic;
  }

  .or5__footer a {
    color: var(--copper-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.67rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .or5__dialog {
    width: min(1100px, calc(100% - 34px));
    max-height: calc(100vh - 34px);
    padding: 0;
    color: var(--parchment);
    border: 1px solid var(--copper);
    background: #141019;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7);
  }

  .or5__dialog::backdrop {
    background: rgba(5, 4, 8, 0.84);
    backdrop-filter: blur(8px);
  }

  .or5__dialog-inner {
    padding: clamp(18px, 3vw, 34px);
  }

  .or5__dialog header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .or5__dialog header button {
    width: 44px;
    height: 44px;
    color: var(--parchment);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    font: 300 1.5rem/1 sans-serif;
  }

  .or5__dialog figure {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .or5__dialog figure img {
    width: 100%;
    height: min(70vh, 760px);
    object-fit: contain;
    background: #09080d;
  }

  .or5__dialog figcaption {
    color: var(--paper-soft);
    line-height: 1.5;
  }

  @keyframes or5-arrive {
    from { opacity: 0; filter: saturate(0.2) brightness(1.7); transform: rotate(calc(var(--angle) * -1)) scale(1.22); }
    to { opacity: 1; filter: none; transform: rotate(calc(var(--angle) * -1)) scale(1); }
  }

  @keyframes or5-sweep {
    0%, 18% { transform: translateX(0) rotate(12deg); opacity: 0; }
    32% { opacity: 0.72; }
    62% { transform: translateX(650%) rotate(12deg); opacity: 0; }
    100% { transform: translateX(650%) rotate(12deg); opacity: 0; }
  }

  @keyframes or5-turn {
    to { transform: rotate(360deg); }
  }

  @media (pointer: fine) {
    .or5__glint { display: block; }
  }

  @media (max-width: 1050px) {
    .or5__workbench {
      grid-template-columns: 1fr;
    }

    .or5__window-panel {
      position: relative;
      top: 0;
    }

    .or5__fragment-image {
      height: min(31vw, 280px);
    }
  }

  @media (min-width: 1051px) and (max-height: 1050px) {
    .or5__window-panel {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 680px) {
    .or5__wayfinding,
    .or5__header,
    .or5__workbench,
    .or5__footer {
      width: min(100% - 28px, 1540px);
    }

    .or5__header {
      display: grid;
      padding-block: 30px 38px;
    }

    .or5__title-lockup {
      gap: 13px;
    }

    .or5__edition {
      font-size: 4.3rem;
    }

    .or5 h1 {
      font-size: clamp(2.18rem, 11vw, 3.4rem);
    }

    .or5__sound {
      justify-self: start;
    }

    .or5__window-panel {
      padding: 20px 14px 24px;
    }

    .or5__rosette {
      width: 100%;
      margin-block: 26px 30px;
    }

    .or5__fragments {
      display: flex;
      gap: 12px;
      padding-bottom: 8px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .or5__fragment-card {
      flex: 0 0 min(78vw, 330px);
      scroll-snap-align: start;
    }

    .or5__fragment-image {
      height: 230px;
    }

    .or5__group > header,
    .or5__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .or5 *,
    .or5 *::before,
    .or5 *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }

  .or5[data-paused='true'] *,
  .or5[data-paused='true'] *::before,
  .or5[data-paused='true'] *::after {
    animation-play-state: paused !important;
  }
</style>

<script>
  const shrine = document.getElementById('open-road-v5-shrine');
  const fragmentButtons = Array.from(document.querySelectorAll('#open-road-v5-shrine [data-fragment]'));
  const inspectButtons = Array.from(document.querySelectorAll('#open-road-v5-shrine [data-inspect]'));
  const petalButtons = Array.from(document.querySelectorAll('#open-road-v5-shrine [data-petal]'));
  const prayerLines = Array.from(document.querySelectorAll('#open-road-v5-shrine [data-prayer-line]'));
  const undoButton = document.getElementById('or5-undo');
  const resetButton = document.getElementById('or5-reset');
  const shareButton = document.getElementById('or5-share');
  const soundButton = document.getElementById('or5-sound');
  const soundLabel = document.getElementById('or5-sound-label');
  const count = document.getElementById('or5-count');
  const closing = document.getElementById('or5-closing');
  const status = document.getElementById('or5-status');
  const dialog = document.getElementById('or5-dialog');
  const dialogClose = document.getElementById('or5-dialog-close');
  const dialogTitle = document.getElementById('or5-dialog-title');
  const dialogImage = document.getElementById('or5-dialog-image');
  const dialogCaption = document.getElementById('or5-dialog-caption');
  const glint = document.getElementById('or5-glint');
  const PETAL_COUNT = 5;
  const toneScale = [261.63, 293.66, 329.63, 392, 440];
  let selected = [];
  let lastInspectionTrigger = null;
  let soundOn = false;
  let audioContext = null;
  let masterGain = null;
  let compressor = null;
  const activeOscillators = new Set();

  const getFragment = (button) => ({
    id: button.dataset.id || '',
    name: button.dataset.name || 'Fragment',
    blessing: button.dataset.blessing || '',
    image: button.dataset.image || '',
    alt: button.dataset.alt || '',
  });

  const allFragments = fragmentButtons.map(getFragment);

  function announce(message) {
    if (status) status.textContent = message;
  }

  function syncHash() {
    const url = new URL(window.location.href);
    if (selected.length) url.hash = `window=${selected.map((fragment) => fragment.id).join(',')}`;
    else url.hash = '';
    history.replaceState(null, '', url);
  }

  function stopActiveOscillators() {
    activeOscillators.forEach((oscillator) => {
      try { oscillator.stop(); } catch {}
    });
    activeOscillators.clear();
  }

  async function ensureAudio() {
    if (audioContext) {
      if (audioContext.state === 'suspended') await audioContext.resume();
      return audioContext;
    }
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) return null;
    audioContext = new AudioContextClass();
    compressor = audioContext.createDynamicsCompressor();
    compressor.threshold.value = -30;
    compressor.knee.value = 18;
    compressor.ratio.value = 4;
    compressor.attack.value = 0.01;
    compressor.release.value = 0.35;
    masterGain = audioContext.createGain();
    masterGain.gain.value = 0.18;
    masterGain.connect(compressor);
    compressor.connect(audioContext.destination);
    return audioContext;
  }

  function playTone(index, completion = false) {
    if (!soundOn || document.hidden || !audioContext || !masterGain) return;
    const frequencies = completion ? toneScale : [toneScale[index % toneScale.length]];
    frequencies.forEach((frequency, chordIndex) => {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      const now = audioContext.currentTime + chordIndex * 0.035;
      oscillator.type = chordIndex % 2 ? 'sine' : 'triangle';
      oscillator.frequency.setValueAtTime(frequency, now);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(completion ? 0.022 : 0.032, now + 0.035);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + (completion ? 1.8 : 1.05));
      oscillator.connect(gain);
      gain.connect(masterGain);
      oscillator.start(now);
      oscillator.stop(now + (completion ? 1.9 : 1.15));
      activeOscillators.add(oscillator);
      oscillator.addEventListener('ended', () => activeOscillators.delete(oscillator), { once: true });
    });
  }

  function render({ newest = false, updateHash = true } = {}) {
    const complete = selected.length === PETAL_COUNT;
    shrine.dataset.complete = String(complete);
    if (count) count.textContent = `${selected.length} / ${PETAL_COUNT}`;

    petalButtons.forEach((petal, index) => {
      const fragment = selected[index];
      const image = petal.querySelector('[data-petal-image]');
      petal.classList.toggle('is-filled', Boolean(fragment));
      petal.classList.toggle('is-new', newest && index === selected.length - 1);
      petal.disabled = !fragment;
      if (!fragment) {
        petal.setAttribute('aria-label', `Empty window petal ${index + 1}`);
        if (image) {
          image.hidden = true;
          image.removeAttribute('src');
          image.alt = '';
        }
      } else {
        petal.setAttribute('aria-label', `View ${fragment.name}, window petal ${index + 1}`);
        petal.dataset.name = fragment.name;
        petal.dataset.image = fragment.image;
        petal.dataset.alt = fragment.alt;
        if (image) {
          image.src = fragment.image;
          image.alt = '';
          image.hidden = false;
        }
      }
    });

    prayerLines.forEach((line, index) => {
      const fragment = selected[index];
      const text = line.querySelector('p');
      line.classList.toggle('is-filled', Boolean(fragment));
      if (text) text.textContent = fragment?.blessing || 'Choose a fragment.';
    });

    fragmentButtons.forEach((button) => {
      const chosen = selected.some((fragment) => fragment.id === button.dataset.id);
      button.setAttribute('aria-pressed', String(chosen));
      button.disabled = complete && !chosen;
      button.closest('[data-card]')?.classList.toggle('is-selected', chosen);
    });

    if (undoButton) undoButton.disabled = selected.length === 0;
    if (resetButton) resetButton.disabled = selected.length === 0;
    if (shareButton) shareButton.hidden = !complete;
    if (closing) closing.hidden = !complete;
    if (updateHash) syncHash();
  }

  function addFragment(button) {
    const fragment = getFragment(button);
    if (selected.some((chosen) => chosen.id === fragment.id)) {
      announce(`${fragment.name} is already part of the window.`);
      return;
    }
    if (selected.length >= PETAL_COUNT) {
      announce('The window is complete. Undo one fragment or begin again to change it.');
      return;
    }
    selected = [...selected, fragment];
    const complete = selected.length === PETAL_COUNT;
    render({ newest: true });
    playTone(selected.length - 1, complete);
    announce(complete
      ? 'The five-petal window is complete. What was separate has learned one light.'
      : `${fragment.name} entered petal ${selected.length} of ${PETAL_COUNT}.`);
  }

  function restoreFromHash() {
    const rawHash = window.location.hash.replace(/^#/, '');
    if (rawHash && !rawHash.startsWith('window=')) return;
    const params = new URLSearchParams(rawHash);
    const ids = (params.get('window') || '').split(',').filter(Boolean).slice(0, PETAL_COUNT);
    const restored = [];
    ids.forEach((id) => {
      const fragment = allFragments.find((candidate) => candidate.id === id);
      if (fragment && !restored.some((candidate) => candidate.id === fragment.id)) restored.push(fragment);
    });
    selected = restored;
    render({ updateHash: false });
    if (selected.length) announce(`Restored a window with ${selected.length} of ${PETAL_COUNT} fragments.`);
  }

  function openInspection(trigger, name, image, alt) {
    if (!dialog || !dialogTitle || !dialogImage || !dialogCaption) return;
    lastInspectionTrigger = trigger;
    dialogTitle.textContent = name;
    dialogImage.src = image;
    dialogImage.alt = alt;
    dialogCaption.textContent = alt;
    dialog.showModal();
    dialogClose?.focus({ preventScroll: true });
  }

  fragmentButtons.forEach((button) => button.addEventListener('click', () => addFragment(button)));

  inspectButtons.forEach((button) => button.addEventListener('click', () => {
    openInspection(
      button,
      button.dataset.name || 'Fragment',
      button.dataset.image || '',
      button.dataset.alt || '',
    );
  }));

  petalButtons.forEach((button) => button.addEventListener('click', () => {
    if (!button.dataset.image) return;
    openInspection(
      button,
      button.dataset.name || 'Fragment',
      button.dataset.image,
      button.dataset.alt || '',
    );
  }));

  undoButton?.addEventListener('click', () => {
    const removed = selected.pop();
    render();
    announce(removed ? `${removed.name} left the window. ${selected.length} fragments remain.` : 'The window is empty.');
  });

  resetButton?.addEventListener('click', () => {
    selected = [];
    render();
    announce('The window is empty again. Choose five fragments.');
    fragmentButtons[0]?.focus({ preventScroll: true });
  });

  shareButton?.addEventListener('click', async () => {
    const url = new URL(window.location.href);
    url.hash = `window=${selected.map((fragment) => fragment.id).join(',')}`;
    const text = `${selected.map((fragment) => fragment.blessing).join('\n')}\n\nWhat was separate has learned one light.`;
    try {
      if (navigator.share) {
        await navigator.share({ title: 'Open Road V · The Window You Make', text, url: url.toString() });
        announce('Your window is ready to travel.');
      } else {
        await navigator.clipboard.writeText(`${text}\n${url}`);
        announce('The prayer and its window link were copied.');
      }
    } catch (error) {
      if (error?.name !== 'AbortError') announce('The window link is in the address bar and ready to copy.');
    }
  });

  soundButton?.addEventListener('click', async () => {
    soundOn = !soundOn;
    soundButton.setAttribute('aria-pressed', String(soundOn));
    if (soundOn) {
      if (soundLabel) soundLabel.textContent = 'Glass tones on';
      const context = await ensureAudio();
      if (!soundOn || document.hidden) return;
      if (!context) {
        soundOn = false;
        soundButton.setAttribute('aria-pressed', 'false');
        if (soundLabel) soundLabel.textContent = 'Glass tones unavailable';
        announce('Glass tones are unavailable in this browser.');
        return;
      }
      playTone(Math.max(0, selected.length - 1));
      announce('Glass tones are on. Each new fragment will sound softly.');
    } else {
      if (soundLabel) soundLabel.textContent = 'Glass tones off';
      stopActiveOscillators();
      announce('Glass tones are off.');
    }
  });

  dialogClose?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => lastInspectionTrigger?.focus({ preventScroll: true }));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && dialog?.open) {
      event.preventDefault();
      dialog.close();
      return;
    }
    const activeIndex = fragmentButtons.indexOf(document.activeElement);
    if (activeIndex < 0) return;
    const step = event.key === 'ArrowLeft' ? -1
      : event.key === 'ArrowRight' ? 1
      : event.key === 'ArrowUp' ? -2
      : event.key === 'ArrowDown' ? 2
      : 0;
    if (!step) return;
    event.preventDefault();
    for (let attempt = 1; attempt <= fragmentButtons.length; attempt += 1) {
      const nextIndex = (activeIndex + step * attempt + fragmentButtons.length * 2) % fragmentButtons.length;
      if (!fragmentButtons[nextIndex]?.disabled) {
        fragmentButtons[nextIndex].focus({ preventScroll: true });
        break;
      }
    }
  });

  document.addEventListener('visibilitychange', () => {
    shrine.dataset.paused = String(document.hidden);
    if (document.hidden) {
      stopActiveOscillators();
      audioContext?.suspend().catch(() => {});
    } else if (soundOn) {
      audioContext?.resume().catch(() => {});
    }
  });

  window.addEventListener('hashchange', restoreFromHash);

  if (glint && window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (event) => {
      glint.style.left = `${event.clientX}px`;
      glint.style.top = `${event.clientY}px`;
      glint.style.opacity = '0.72';
    }, { passive: true });
    document.documentElement.addEventListener('mouseleave', () => { glint.style.opacity = '0'; });
  }

  restoreFromHash();
</script>
