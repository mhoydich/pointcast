---
/**
 * /window-home — first-principles homepage candidate (Option A from the
 * 2026-05-23 audit).
 *
 * The pattern this is breaking: /index.astro was rebuilt 2026-05-07 to
 * "a focused four-section editorial home." Ten days later it had 15
 * sections (LEAD, broadcast hero, applications gallery, wall strip,
 * morning hero, asks, opmode, ships-as-stories, learnings, today, week,
 * arcade, horizon, places, archive). Every "feels stale" prompt added
 * another section instead of cutting.
 *
 * This page asks one question instead: "what is PointCast at its core?"
 * Answer per memory: "a small internet town from El Segundo." So the
 * homepage IS a wide pixel-art window onto El Segundo — sky tinted by
 * time-of-day, weather-aware clouds, a row of clickable buildings along
 * the foot. One digest line. Four exit links. Two sections, not 15.
 *
 * Lives at /window-home so Mike can A/B against / for a day. If it
 * holds up, promotion is one PR that swaps the file at /index.astro.
 *
 * Aesthetic register: deliberately not the "newsroom desk" Gloock /
 * warm-parchment of the current /. This is the geocities + sim city
 * register Mike has been asking for — saturated colors, chunky pixel
 * borders, the town reads as a place not a dashboard.
 *
 * Window-rendering technique borrowed wholesale from /window (sun, moon,
 * stars, clouds, marine layer, horizon — all CSS, no canvas). Refresh
 * intervals match: TOD every minute, weather every 5 min.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { getCollection } from 'astro:content';
import shipsData from '../data/recent-ships.json';

interface Weather {
  ok: boolean; name?: string; tempF?: number; condition?: string;
}
let weather: Weather = { ok: false };
try {
  const res = await fetch('https://pointcast.xyz/api/weather?lat=33.92&lng=-118.42&label=el-segundo', {
    signal: AbortSignal.timeout(2500),
  });
  if (res.ok) weather = await res.json();
} catch { /* fall through to stub */ }
const tempF = weather.tempF ?? 62;
const condition = (weather.condition ?? 'overcast').toLowerCase();

function timeOfDayFromHour(h: number) {
  if (h >= 5  && h <  7)  return 'dawn';
  if (h >= 7  && h < 11)  return 'morning';
  if (h >= 11 && h < 14)  return 'midday';
  if (h >= 14 && h < 17)  return 'afternoon';
  if (h >= 17 && h < 19)  return 'sunset';
  if (h >= 19 && h < 21)  return 'dusk';
  return 'night';
}
const ptHourFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Los_Angeles', hour: 'numeric', hour12: false,
});
const ptHour = parseInt(ptHourFmt.format(new Date()), 10);
const tod = timeOfDayFromHour(ptHour);

function conditionTag(c: string) {
  if (/fog|mist|marine/.test(c)) return 'foggy';
  if (/clear|sun/.test(c))       return 'clear';
  if (/overcast/.test(c))        return 'overcast';
  return 'cloudy';
}
const cond = conditionTag(condition);

const allBlocks = (await getCollection('blocks', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.timestamp) - +new Date(a.data.timestamp));
const blockCount = allBlocks.length;
const latestBlock = allBlocks[0];

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const todayBlocks = allBlocks.filter(b => new Date(b.data.timestamp) >= startOfToday);

interface ShipItem { ref: string; title: string; href: string; tag: string; at: string; }
const ships = (shipsData as { ships: ShipItem[] }).ships
  .slice().sort((a, b) => +new Date(b.at) - +new Date(a.at));
const sevenDaysAgo = new Date(startOfToday);
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
const shipsLast7 = ships.filter(s => +new Date(s.at) >= +sevenDaysAgo).length;

const firstBlock = allBlocks[allBlocks.length - 1];
const sinceDate = firstBlock
  ? new Date(firstBlock.data.timestamp).toISOString().slice(0, 10)
  : '2025-01-14';

// Seven rooms along the skyline. Order is L→R on desktop. Each has a
// shape modifier (--tower / --dome / --peak / --awning / --steam /
// --crt / --house) that styles the silhouette in CSS. No SVGs — flat
// divs with box-shadows so the buildings read as deliberately chunky
// rather than detailed.
const ROOMS = [
  { id: 'drum',   shape: 'dome',   href: '/drum',         label: 'The drum',      sub: 'one tap, anyone hears',     color: '#cf3c3c' },
  { id: 'bar',    shape: 'awning', href: '/bar-v6',       label: 'The bar',       sub: 'cast +cat, walk the street', color: '#c4952e' },
  { id: 'coffee', shape: 'steam',  href: '/coffee',       label: 'The coffee',    sub: 'pour from the live shelf',  color: '#7a4a1f' },
  { id: 'arcade', shape: 'crt',    href: '/win95-games',  label: 'The arcade',    sub: 'solitaire · mines · memory', color: '#5a5aaa' },
  { id: 'mythos', shape: 'peak',   href: '/mythos',       label: 'The mythos',    sub: '60-second read · 15 worlds', color: '#1f5b48' },
  { id: 'wire',   shape: 'tower',  href: '/wire',         label: 'The wire',      sub: 'live commits + new blocks',  color: '#1b3a5b' },
  { id: 'house',  shape: 'house',  href: '/residents',    label: 'The residents', sub: 'four agents, two open slots', color: '#5b2a4a' },
] as const;

const title = 'PointCast — a small internet town from El Segundo';
const description = `Live from El Segundo. ${blockCount} blocks since ${sinceDate}. It's ${tempF}°F and ${condition}. Open the window.`;
---

<BlockLayout title={title} description={description}>
  <main class="wh">

    <header class="wh__head">
      <p class="wh__kicker mono">
        EL&nbsp;SEGUNDO · 33.92°N&nbsp;118.42°W · <span id="wh-temp">{tempF}</span>°F · <span id="wh-cond">{condition}</span>
      </p>
      <h1 class="wh__title">A small internet town.</h1>
      <p class="wh__sub">
        Open the window — the sky knows what time it is. The town has rooms.
      </p>
    </header>

    {/* ============== THE WINDOW ============== */}
    <section class="wh-stage" aria-label="A live view from El Segundo">
      <div class="wh-frame" data-tod={tod} data-cond={cond} id="wh-frame">

        <div class="wh-sky">
          <div class="wh-sun"  aria-hidden="true"></div>
          <div class="wh-moon" aria-hidden="true"></div>
          <div class="wh-stars" aria-hidden="true">
            <span class="wh-star" style="left:6%;  top:14%; animation-delay: 0s;"></span>
            <span class="wh-star" style="left:14%; top:28%; animation-delay: 1.2s;"></span>
            <span class="wh-star" style="left:22%; top:8%;  animation-delay: 0.5s;"></span>
            <span class="wh-star" style="left:34%; top:22%; animation-delay: 1.9s;"></span>
            <span class="wh-star" style="left:46%; top:6%;  animation-delay: 0.3s;"></span>
            <span class="wh-star" style="left:58%; top:18%; animation-delay: 2.6s;"></span>
            <span class="wh-star" style="left:68%; top:30%; animation-delay: 1.4s;"></span>
            <span class="wh-star" style="left:78%; top:10%; animation-delay: 0.8s;"></span>
            <span class="wh-star" style="left:88%; top:24%; animation-delay: 2.2s;"></span>
            <span class="wh-star" style="left:94%; top:14%; animation-delay: 0.1s;"></span>
          </div>
          <div class="wh-cloud wh-cloud--1" aria-hidden="true"></div>
          <div class="wh-cloud wh-cloud--2" aria-hidden="true"></div>
          <div class="wh-cloud wh-cloud--3" aria-hidden="true"></div>
          <div class="wh-cloud wh-cloud--4" aria-hidden="true"></div>
          <div class="wh-marine"  aria-hidden="true"></div>
          <div class="wh-horizon" aria-hidden="true"></div>
        </div>

        {/* Ground band — saturated strip that grounds the skyline */}
        <div class="wh-ground" aria-hidden="true"></div>

        {/* SKYLINE — seven clickable buildings. The whole nav element is
            the homepage navigation; the editorial header above is just
            for context. Tooltip shows on hover/focus. */}
        <nav class="wh-skyline" aria-label="Rooms in town">
          {ROOMS.map((r, i) => (
            <a
              class={`wh-bldg wh-bldg--${r.shape}`}
              href={r.href}
              style={`--room: ${r.color}; --idx: ${i};`}
              data-room={r.id}
            >
              <span class="wh-bldg__shape" aria-hidden="true">
                <span class="wh-bldg__body"></span>
                <span class="wh-bldg__roof"></span>
                <span class="wh-bldg__sign"></span>
                <span class="wh-bldg__door"></span>
              </span>
              <span class="wh-bldg__tip">
                <span class="wh-bldg__tip-label">{r.label}</span>
                <span class="wh-bldg__tip-sub">{r.sub}</span>
              </span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    {/* ============== ONE DIGEST LINE ============== */}
    <section class="wh-digest" aria-label="Today on PointCast">
      <p class="wh-digest__line">
        <span class="wh-digest__date mono">TODAY · {now.toISOString().slice(0,10)}</span>
        <span class="wh-digest__sep">·</span>
        <span class="wh-digest__stat"><strong>{todayBlocks.length}</strong>&nbsp;new&nbsp;block{todayBlocks.length === 1 ? '' : 's'}</span>
        <span class="wh-digest__sep">·</span>
        <span class="wh-digest__stat"><strong>{shipsLast7}</strong>&nbsp;ships&nbsp;this&nbsp;week</span>
        <span class="wh-digest__sep">·</span>
        <span class="wh-digest__stat"><strong>{blockCount}</strong>&nbsp;blocks&nbsp;since&nbsp;{sinceDate}</span>
      </p>
      {latestBlock && (
        <p class="wh-digest__latest">
          ↪ latest: <a href={`/b/${latestBlock.data.id}`}>/{latestBlock.data.id} — {latestBlock.data.title}</a>
        </p>
      )}
    </section>

    {/* ============== EXITS ============== */}
    <nav class="wh-exits" aria-label="More from the town">
      <a href="/wire"       class="wh-exit mono">→ the wire</a>
      <a href="/archive"    class="wh-exit mono">browse the archive</a>
      <a href="/mythos"     class="wh-exit mono">read the mythos</a>
      <a href="/for-agents" class="wh-exit mono">/for-agents</a>
    </nav>

  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';
    var frame  = document.getElementById('wh-frame');
    var tempEl = document.getElementById('wh-temp');
    var condEl = document.getElementById('wh-cond');
    if (!frame) return;
    function ptHour() {
      try {
        var f = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', hour: 'numeric', hour12: false });
        return parseInt(f.format(new Date()), 10);
      } catch (e) { return new Date().getHours(); }
    }
    function tod(h) {
      if (h >= 5  && h <  7) return 'dawn';
      if (h >= 7  && h < 11) return 'morning';
      if (h >= 11 && h < 14) return 'midday';
      if (h >= 14 && h < 17) return 'afternoon';
      if (h >= 17 && h < 19) return 'sunset';
      if (h >= 19 && h < 21) return 'dusk';
      return 'night';
    }
    function ctag(c) {
      c = (c || '').toLowerCase();
      if (/fog|mist|marine/.test(c)) return 'foggy';
      if (/clear|sun/.test(c))       return 'clear';
      if (/overcast/.test(c))        return 'overcast';
      return 'cloudy';
    }
    function refreshTod() { frame.setAttribute('data-tod', tod(ptHour())); }
    function refreshWeather() {
      fetch('/api/weather?lat=33.92&lng=-118.42&label=el-segundo', { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.ok) return;
          if (tempEl && d.tempF != null) tempEl.textContent = String(d.tempF);
          if (condEl && d.condition)     condEl.textContent = String(d.condition).toLowerCase();
          frame.setAttribute('data-cond', ctag(d.condition));
        }).catch(function () { /* keep current state */ });
    }
    refreshTod();
    setInterval(refreshTod,     60000);
    setInterval(refreshWeather, 300000);
  })();
</script>

<style>
  .wh {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 20px 60px;
    font-family: var(--font-body);
  }
  .wh .mono { font-family: var(--font-mono); }

  /* ============== HEADER ============== */
  .wh__head {
    text-align: center;
    margin: 0 0 22px;
  }
  .wh__kicker {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: #6b6256;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .wh__title {
    font-family: 'DM Serif Display', 'Lora', Georgia, serif;
    font-size: clamp(42px, 7vw, 76px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.018em;
    margin: 0 0 10px;
    color: #1f1b15;
  }
  .wh__sub {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.4;
    color: #6b6256;
    margin: 0;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ============== THE WINDOW ============== */
  .wh-stage {
    margin: 28px auto 32px;
    display: flex;
    justify-content: center;
  }
  .wh-frame {
    position: relative;
    width: 100%;
    max-width: 1080px;
    aspect-ratio: 16 / 9;
    border: 12px solid #f3ece0;
    border-bottom-width: 14px;
    border-radius: 4px;
    box-shadow:
      inset 0 0 0 2px #d8cdb8,
      inset 0 0 0 4px rgba(0, 0, 0, 0.04),
      0 12px 36px rgba(31, 27, 21, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.7);
    overflow: hidden;
    background: #b8e0f0;
  }

  .wh-sky {
    position: absolute;
    inset: 0;
    transition: background 4s ease-in-out;
  }
  .wh-frame[data-tod="dawn"]      .wh-sky { background: linear-gradient(180deg, #f7c0a0 0%, #ffd5b4 35%, #c8b495 75%, #a89880 100%); }
  .wh-frame[data-tod="morning"]   .wh-sky { background: linear-gradient(180deg, #b8d8e6 0%, #d4e4ec 50%, #e0d8c4 100%); }
  .wh-frame[data-tod="midday"]    .wh-sky { background: linear-gradient(180deg, #6cb4d8 0%, #a8d4e8 50%, #c8e0ec 100%); }
  .wh-frame[data-tod="afternoon"] .wh-sky { background: linear-gradient(180deg, #88b8d4 0%, #c4d4e0 60%, #e6d8c0 100%); }
  .wh-frame[data-tod="sunset"]    .wh-sky { background: linear-gradient(180deg, #d68a4e 0%, #e87a5a 30%, #c46478 60%, #6c4a78 100%); }
  .wh-frame[data-tod="dusk"]      .wh-sky { background: linear-gradient(180deg, #3c3680 0%, #5a4488 35%, #7c4878 70%, #a06082 100%); }
  .wh-frame[data-tod="night"]     .wh-sky { background: linear-gradient(180deg, #0a1428 0%, #1a2440 60%, #2a3058 100%); }

  /* Sun */
  .wh-sun {
    position: absolute;
    width: 52px; height: 52px;
    border-radius: 50%;
    background: #ffe07a;
    box-shadow: 0 0 30px rgba(255, 224, 122, 0.6);
    left: 60%; top: 20%;
    opacity: 0;
    transition: opacity 4s, top 4s ease-in-out, left 4s ease-in-out, background 4s, box-shadow 4s;
  }
  .wh-frame[data-tod="dawn"]      .wh-sun { opacity: 1;   left: 12%; top: 58%; background: #ffb088; box-shadow: 0 0 28px rgba(255, 130, 90, 0.55); }
  .wh-frame[data-tod="morning"]   .wh-sun { opacity: 0.9; left: 26%; top: 30%; background: #fff0c8; }
  .wh-frame[data-tod="midday"]    .wh-sun { opacity: 1;   left: 50%; top: 12%; background: #fff5b0; box-shadow: 0 0 40px rgba(255, 245, 176, 0.65); }
  .wh-frame[data-tod="afternoon"] .wh-sun { opacity: 1;   left: 72%; top: 24%; background: #ffe07a; }
  .wh-frame[data-tod="sunset"]    .wh-sun { opacity: 1;   left: 86%; top: 56%; background: #ff7a4e; box-shadow: 0 0 44px rgba(255, 122, 78, 0.75); }
  .wh-frame[data-tod="dusk"]      .wh-sun { opacity: 0.3; left: 92%; top: 74%; background: #c46478; }
  .wh-frame[data-tod="night"]     .wh-sun { opacity: 0; }

  /* Moon */
  .wh-moon {
    position: absolute;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #f0ebd8;
    box-shadow:
      inset -10px -2px 0 0 rgba(0, 0, 0, 0.15),
      0 0 18px rgba(240, 235, 216, 0.45);
    left: 30%; top: 22%;
    opacity: 0;
    transition: opacity 4s, top 4s ease-in-out, left 4s ease-in-out;
  }
  .wh-frame[data-tod="dusk"]  .wh-moon { opacity: 0.7; left: 26%; top: 26%; }
  .wh-frame[data-tod="night"] .wh-moon { opacity: 1;   left: 34%; top: 16%; }
  .wh-frame[data-tod="dawn"]  .wh-moon { opacity: 0.4; left: 72%; top: 28%; }

  /* Stars */
  .wh-stars {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 4s;
  }
  .wh-frame[data-tod="dusk"]  .wh-stars { opacity: 0.5; }
  .wh-frame[data-tod="night"] .wh-stars { opacity: 1; }
  .wh-frame[data-tod="dawn"]  .wh-stars { opacity: 0.3; }
  .wh-star {
    position: absolute;
    width: 2px; height: 2px;
    background: #fffaf0;
    border-radius: 50%;
    box-shadow: 0 0 3px rgba(255, 250, 240, 0.7);
    animation: wh-twinkle 3.4s ease-in-out infinite;
  }
  @keyframes wh-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.4); }
  }

  /* Clouds — four passes across a wider scene */
  .wh-cloud {
    position: absolute;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    filter: blur(0.5px);
    will-change: transform;
  }
  .wh-cloud--1 { width: 110px; height: 26px; top: 18%; left: -120px; animation: wh-drift 80s linear infinite; }
  .wh-cloud--2 { width:  78px; height: 20px; top: 32%; left: -90px;  animation: wh-drift 62s linear infinite; animation-delay: -25s; }
  .wh-cloud--3 { width: 140px; height: 30px; top: 10%; left: -160px; animation: wh-drift 100s linear infinite; animation-delay: -40s; }
  .wh-cloud--4 { width:  64px; height: 18px; top: 26%; left: -80px;  animation: wh-drift 55s linear infinite; animation-delay: -10s; }
  @keyframes wh-drift {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(100vw + 200px)); }
  }
  .wh-frame[data-cond="clear"]    .wh-cloud { opacity: 0.18; }
  .wh-frame[data-cond="cloudy"]   .wh-cloud { opacity: 0.7;  }
  .wh-frame[data-cond="overcast"] .wh-cloud { opacity: 0.88; background: rgba(220, 220, 220, 0.92); }
  .wh-frame[data-cond="foggy"]    .wh-cloud { opacity: 0.55; filter: blur(2px); }
  .wh-frame[data-tod="night"]     .wh-cloud { background: rgba(140, 140, 160, 0.72); }
  .wh-frame[data-tod="dusk"]      .wh-cloud { background: rgba(180, 160, 180, 0.72); }

  /* Marine layer */
  .wh-marine {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 22%;
    background: linear-gradient(180deg, transparent 0%, rgba(220, 224, 230, 0.45) 60%, rgba(220, 224, 230, 0.7) 100%);
    transition: height 4s, opacity 4s;
    opacity: 0.55;
  }
  .wh-frame[data-cond="foggy"]    .wh-marine { height: 56%; opacity: 0.9; }
  .wh-frame[data-cond="overcast"] .wh-marine { height: 32%; opacity: 0.7; }
  .wh-frame[data-cond="clear"]    .wh-marine { opacity: 0.22; }

  /* Horizon — thin warm band at the meeting line */
  .wh-horizon {
    position: absolute;
    left: 0; right: 0; bottom: 30%;
    height: 2px;
    background: rgba(255, 220, 180, 0.4);
    opacity: 0;
    transition: opacity 4s;
  }
  .wh-frame[data-tod="sunset"] .wh-horizon,
  .wh-frame[data-tod="dawn"]   .wh-horizon { opacity: 1; }

  /* Ground — saturated strip behind the skyline */
  .wh-ground {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 18%;
    background: linear-gradient(180deg, rgba(31, 27, 21, 0.10) 0%, rgba(31, 27, 21, 0.45) 100%);
    pointer-events: none;
  }

  /* ============== SKYLINE ============== */
  .wh-skyline {
    position: absolute;
    left: 0; right: 0; bottom: 4%;
    height: 38%;
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    padding: 0 4%;
    z-index: 2;
  }
  .wh-bldg {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: clamp(40px, 9vw, 92px);
    height: 100%;
    text-decoration: none;
    color: inherit;
    transform: translateY(0);
    transition: transform 0.22s cubic-bezier(0.16, 0.84, 0.30, 1.00);
    will-change: transform;
  }
  .wh-bldg:hover, .wh-bldg:focus-visible { transform: translateY(-5px); outline: none; }

  /* Shape container — fills the whole bldg so children with height: NN%
     compute against a real box. Without an explicit height the container
     collapses and the silhouette renders at 0px. */
  .wh-bldg__shape {
    position: absolute;
    inset: 0;
    display: block;
  }
  .wh-bldg__body, .wh-bldg__roof, .wh-bldg__sign, .wh-bldg__door {
    display: block;
    position: absolute;
    background: var(--room);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
  }

  /* TOWER — narrow stacked rectangles (wire) */
  .wh-bldg--tower .wh-bldg__body {
    left: 30%; right: 30%; bottom: 0; height: 70%;
    background: var(--room);
  }
  .wh-bldg--tower .wh-bldg__roof {
    left: 42%; right: 42%; bottom: 70%; height: 25%;
    background: var(--room);
  }
  .wh-bldg--tower .wh-bldg__sign {
    left: 48%; right: 48%; bottom: 95%; height: 12%;
    width: 4%;
    background: #fffaf0;
    border-radius: 50%;
    min-width: 4px;
    box-shadow: 0 0 6px rgba(255, 250, 240, 0.8);
  }
  .wh-bldg--tower .wh-bldg__door { display: none; }

  /* DOME — wide base with half-circle on top (drum) */
  .wh-bldg--dome .wh-bldg__body {
    left: 10%; right: 10%; bottom: 0; height: 50%;
  }
  .wh-bldg--dome .wh-bldg__roof {
    left: 5%; right: 5%; bottom: 50%; height: 50%;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .wh-bldg--dome .wh-bldg__sign {
    left: 45%; right: 45%; bottom: 96%; height: 8%;
    width: 10%;
    background: var(--room);
    border-radius: 50%;
    min-width: 6px;
  }
  .wh-bldg--dome .wh-bldg__door {
    left: 40%; right: 40%; bottom: 0; height: 18%;
