---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CHANNELS } from '../lib/channels';
import { LIVE_ORACLES, oracleEndpoints } from '../../functions/_lib/oracles/index';
import { ORACLE_ROADMAP, ORACLE_YIELD_MODEL } from '../lib/oracle-roadmap';

const title = 'PointCast oracles: local truth, one cent an answer';
const description = 'Paid x402 oracles from a small internet town in El Segundo: the Marine Layer Oracle and the Paddle Oracle, with sources, signed answers, and a public ledger of who supplied the facts. Etherlink today; Base and the x402 Bazaar when the key is in.';
const fd = CHANNELS.FD;
const oracles = LIVE_ORACLES.map((o) => ({ ...o, endpoints: oracleEndpoints(o) }));
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: 'https://pointcast.xyz/oracles' };
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="orx" style={`--c50:${fd.color50};--c600:${fd.color600};--c800:${fd.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><span>oracles</span></nav>
    <header class="hero">
      <p class="kicker">THE ORACLE DESK · x402 · 0.01 USDC AN ANSWER</p>
      <h1>Local truth, one cent an answer.</h1>
      <p class="dek">Agents can ask the town questions nobody else answers well: did the fog burn off over El Segundo this morning, which paddle fits under $200 and is legal. Every answer carries its sources, and the town key signs it. Every cent writes a public ledger row naming who supplied the facts.</p>
      <p class="status" id="rails">Etherlink: open. Base and x402 Bazaar: checking…</p>
    </header>

    <section class="sec" aria-label="Live oracles">
      <p class="kicker">LIVE · {oracles.length} ORACLES</p>
      <div class="cards">
        {oracles.map((o) => (
          <article class="card" id={o.id}>
            <h2><a href={o.room}>{o.name}</a></h2>
            <p>{o.description}</p>
            <dl>
              <dt>Etherlink</dt><dd><code>{o.endpoints.etherlink.method} {o.endpoints.etherlink.url}</code></dd>
              <dt>Base</dt><dd><code>{o.endpoints.base.method} {o.endpoints.base.url}</code></dd>
              <dt>Facts from</dt><dd>{o.contributor.name}: {o.contributor.terms}</dd>
              <dt>Ledger</dt><dd class="ledger" data-oracle={o.id}>loading…</dd>
            </dl>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" aria-label="How it pays">
      <p class="kicker">HOW A CENT MOVES</p>
      <ol class="steps">
        <li><b>A bare request returns the price.</b> Both rails answer an unpaid call with a <code>402</code>, so catalogs and crawlers can read the terms.</li>
        <li><b>The answer is computed before anyone pays.</b> If a source is down or returns junk, the oracle says so with a <code>503</code> and nothing settles.</li>
        <li><b>One cent settles, and the answer comes back signed.</b> A lost response is recovered by resending the same request, with no second charge.</li>
        <li><b>The split is recorded.</b> Half to the house, half to the network, and the network half is logged against the contributor whose facts answered the question. That's the data-dividend ledger. Paying it out is a separate, human step.</li>
      </ol>
    </section>

    <section class="sec" aria-label="Next oracles">
      <p class="kicker">NEXT · PLANNED, NOT LIVE</p>
      <div class="rows">
        {ORACLE_ROADMAP.map((p) => (
          <div class="row">
            <strong>{p.name}<small>{p.kind}</small></strong>
            <span><em>{p.question}</em> {p.evidence}</span>
            <span class="lever">{p.yieldLever}</span>
          </div>
        ))}
      </div>
      <p class="fine">Evidence cites a survey of all 16,874 x402 Bazaar listings on September 24, 2026.</p>
    </section>

    <section class="sec" aria-label="Where yield comes from">
      <p class="kicker">WHERE A YIELD COMES FROM · STATED HONESTLY</p>
      <div class="rows">
        {ORACLE_YIELD_MODEL.map((y) => (<div class="row two"><strong>{y.lever}</strong><span>{y.honest}</span></div>))}
      </div>
    </section>

    <p class="foot"><a href="/oracles.json">oracles.json</a> · <a href="/x402">x402 at PointCast</a> · <a href="/till">the till</a> · <a href="/agents.json">agents.json</a></p>
  </main>
</BlockLayout>

<script>
  fetch('/oracles.json').then((r) => r.json()).then((data) => {
    const rails = document.getElementById('rails');
    if (rails) {
      const base = data.rails?.base?.state;
      rails.textContent = base === 'open'
        ? 'Etherlink: open. Base and x402 Bazaar: open.'
        : 'Etherlink: open. Base and x402 Bazaar: waiting on the operator to add the CDP key.';
    }
    for (const node of document.querySelectorAll<HTMLElement>('.ledger')) {
      const o = (data.oracles || []).find((x: { id: string }) => x.id === node.dataset.oracle);
      if (!o || !o.ledger) { node.textContent = 'ledger unavailable right now'; continue; }
      node.textContent = o.ledger.settledCalls
        ? `${o.ledger.settledCalls} paid answers · ${o.ledger.grossUsdc} USDC · data dividends: ${o.ledger.dataDividends.map((d: { contributor: string; networkHalfUsdc: string }) => `${d.contributor} ${d.networkHalfUsdc}`).join(', ')}`
        : 'no paid answers yet. The first cent from a stranger is the number to watch.';
    }
  }).catch(() => {
    for (const node of document.querySelectorAll<HTMLElement>('.ledger')) node.textContent = 'ledger unavailable right now';
  });
</script>

<style>
  .orx{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:44px 0 8px;max-width:880px}
  .hero h1{margin:0;font:500 clamp(40px,6.4vw,76px)/.96 var(--pc-font-sans);letter-spacing:-.035em}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .status{margin:14px 0 0;font:500 11px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--c800)}
  .sec{padding-top:44px}
  .cards{display:grid;grid-template-columns:1fr 1fr;border:1.5px solid var(--c600)}
  .card{padding:18px}
  .card+.card{border-left:1.5px solid var(--c600)}
  .card h2{margin:0 0 8px;font:500 24px/1.1 var(--pc-font-sans);letter-spacing:-.02em}
  .card h2 a{color:var(--pc-ink)}
  .card p{margin:0 0 12px;font:400 14px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  dl{display:grid;grid-template-columns:90px 1fr;gap:6px 12px;margin:0;font:400 13px/1.45 var(--pc-font-sans)}
  dt{font:500 10px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--pc-ink-muted);padding-top:2px}
  dd{margin:0;color:var(--pc-ink-soft);min-width:0}
  code{font:400 12px var(--pc-font-mono);word-break:break-all;color:var(--pc-ink)}
  .ledger{color:var(--c800)}
  .steps{margin:0;padding-left:20px;max-width:880px;font:400 15px/1.6 var(--pc-font-sans)}
  .steps li{margin-bottom:10px}
  .rows{border-top:1.5px solid var(--c600)}
  .row{display:grid;grid-template-columns:200px 1fr 1fr;gap:16px;padding:13px 0;border-bottom:1px solid var(--pc-rule-soft);font:400 14px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .row.two{grid-template-columns:200px 1fr}
  .row strong{font:500 15px/1.3 var(--pc-font-sans);color:var(--pc-ink)}
  .row strong small{display:block;font:400 10px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .row em{font-style:normal;color:var(--pc-ink)}
  .lever{color:var(--c800)}
  .fine{margin:10px 0 0;font:400 12.5px/1.55 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .foot{margin:40px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot a{color:var(--c800)}
  @media(max-width:820px){.cards{grid-template-columns:1fr}.card+.card{border-left:0;border-top:1.5px solid var(--c600)}.row,.row.two{grid-template-columns:1fr;gap:6px}.hero{padding-top:28px}}
</style>
