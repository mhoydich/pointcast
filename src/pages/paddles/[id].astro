---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { BUILDS, MONTHS, hostOf, priceLabel } from '../../lib/paddle-calendar';
import { paddlePlate } from '../../lib/paddle-drawing.mjs';
import {
  CERT_WORDS,
  LIFECYCLE_WORDS,
  PADDLES,
  PADDLE_BAG_URL,
  PADDLE_REGISTER_URL,
  PATENT_WORDS,
  REGISTER_STATS,
  CHANGE_WORDS,
  brandUrl,
  changesFor,
  neighbours,
  paddleUrl,
  plateVariants,
  type Paddle,
} from '../../lib/paddle-register';

export function getStaticPaths() {
  return PADDLES.map((paddle) => ({ params: { id: paddle.id }, props: { paddle } }));
}

const { paddle: p } = Astro.props as { paddle: Paddle };
const court = CHANNELS.CRT;
const build = BUILDS[p.build];
const price = priceLabel(p as any);
const fullDate = (iso: string, precision?: string) =>
  precision === 'day' || !precision ? `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${Number(iso.slice(8, 10))}, ${iso.slice(0, 4)}` : `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;

const title = `${p.brand} ${p.model}: release date, price, approval status`;
const description = `${p.brand} ${p.model}: ${p.status === 'upcoming' ? 'on sale' : 'launched'} ${p.dateLabel} ${p.year}, ${price} list. ${build.label}. USA Pickleball: ${CERT_WORDS[p.reg.usap].toLowerCase()}. UPA-A: ${CERT_WORDS[p.reg.upaa].toLowerCase()}. Timeline, construction, a to-scale drawing, and links to every lab that measured it.`;

const variants = plateVariants(p);
const plates = variants.map((v, i) => ({
  v,
  plate: paddlePlate({ variant: v, shapes: p.shapes, build: p.build, layers: p.core.layers, color: build.color, id: `pl${i}`, dims: true }),
}));
const lead = plates[0].plate;
const measured = p.variants.filter((v) => v.sw || v.tw || v.weightOz || v.lengthIn);
const near = neighbours(p);
const kindWord: Record<string, string> = {
  teaser: 'TEASED', approval: 'APPROVAL', preorder: 'PREORDER', launch: 'LAUNCH', ship: 'SHIPPED', variant: 'NEW VARIANT',
  delist: 'DELISTED', legal: 'LEGAL', price: 'PRICE', upcoming: 'ON SALE',
};
const certTone = (v: string) => (v === 'yes' ? 'ok' : v === 'no' ? 'no' : v === 'split' ? 'split' : 'quiet');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${PADDLE_REGISTER_URL}/${p.id}`,
  name: `${p.brand} ${p.model}`,
  brand: { '@type': 'Brand', name: p.brand },
  category: 'Pickleball paddle',
  description: p.take,
  releaseDate: p.date,
  image: `https://pointcast.xyz/images/og/paddles/${p.id}.png`,
  url: `${PADDLE_REGISTER_URL}/${p.id}`,
  ...(p.msrp != null ? { offers: { '@type': 'Offer', price: p.msrp, priceCurrency: 'USD', ...(p.productUrl ? { url: p.productUrl } : {}) } } : {}),
  isPartOf: { '@type': 'Dataset', name: 'The Paddle Register', url: PADDLE_REGISTER_URL },
};
---

<BlockLayout title={title} description={description} image={`/images/og/paddles/${p.id}.png`} jsonLd={jsonLd}>
  <main class="pad" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800};--b:${build.color}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href="/paddles">paddles</a><span>/</span><a href={brandUrl(p.brand)}>{p.brand}</a><span>/</span><span>{p.model}</span>
      <a href={`/paddles/${p.id}.json`}>JSON</a>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">THE PADDLE REGISTER · {p.year} · {LIFECYCLE_WORDS[p.reg.lifecycle || 'current'].toUpperCase()}</p>
        <h1><span>{p.brand}</span> {p.model}</h1>
        <p class="dek">{p.take}</p>
        <dl class="facts">
          <div><dt>List price</dt><dd>{price}</dd></div>
          <div><dt>{p.status === 'upcoming' ? 'On sale' : 'Launched'}</dt><dd>{p.dateLabel}, {p.year}<small>date known to the {p.precision}</small></dd></div>
          <div><dt>Build</dt><dd>{build.label}</dd></div>
          {p.thickness && <div><dt>Thickness</dt><dd>{p.thickness}</dd></div>}
          {p.shapes && <div><dt>Shapes</dt><dd>{p.shapes}</dd></div>}
          {p.pro && <div><dt>Pro</dt><dd>{p.pro}</dd></div>}
          {p.madeIn && <div><dt>Made in</dt><dd>{p.madeIn}</dd></div>}
          {p.warranty && <div><dt>Warranty</dt><dd>{p.warranty}</dd></div>}
        </dl>
        <p class="hero__links">
          {p.productUrl && <a href={p.productUrl} rel="noopener">photos and colorways at {hostOf(p.productUrl)} ↗</a>}
          {p.year === 2026 && <a href={`/paddle-calendar#${p.id}`}>its row on the 2026 calendar</a>}
        </p>
      </div>
      <figure class="plate">
        <div class="plate__svg" set:html={lead.svg} />
        <figcaption>
          Drawn to scale from {lead.geometry.own ? 'the published dimensions' : `a nominal ${lead.geometry.shape} outline; this paddle's own dimensions are not published`}.
          Left: the face. Right: cut away to the core. An original drawing, not a product photo.
        </figcaption>
      </figure>
    </header>

    <section class="status" aria-label="Where it is legal">
      <div class={`cell cell--${certTone(p.reg.usap)}`}>
        <small>USA PICKLEBALL</small><strong>{CERT_WORDS[p.reg.usap]}</strong>
        <span>Sanctioned amateur play.{p.reg.usapSource && <> <a href={p.reg.usapSource} rel="noopener">{hostOf(p.reg.usapSource)} ↗</a></>}</span>
      </div>
      <div class={`cell cell--${certTone(p.reg.upaa)}`}>
        <small>UPA-A</small><strong>{CERT_WORDS[p.reg.upaa]}</strong>
        <span>PPA Tour and MLP.{p.reg.upaaSource && <> <a href={p.reg.upaaSource} rel="noopener">{hostOf(p.reg.upaaSource)} ↗</a></>}</span>
      </div>
      <div class={`cell cell--${p.reg.quiet ? 'ok' : 'quiet'}`}>
        <small>QUIET CATEGORY</small><strong>{p.reg.quiet ? 'Listed' : 'Not listed'}</strong>
        <span>USAP's under-80 dB list for noise-restricted courts.</span>
      </div>
      <div class={`cell cell--${p.reg.patent === 'none-known' ? 'quiet' : 'split'}`}>
        <small>PATENTS</small><strong>{PATENT_WORDS[p.reg.patent || 'none-known']}</strong>
        <span>{p.reg.investigation ? p.reg.investigation : 'Brand-level status, from the ITC case file and settlements.'}</span>
      </div>
    </section>
    {p.certNote && <p class="certnote"><b>Certification note.</b> {p.certNote}</p>}
    <p class="checked">Status checked {fullDate(REGISTER_STATS.asOf)}. Lists change; confirm on the USAP and UPA-A lists before a tournament.</p>

    <section class="sec" aria-label="Timeline">
      <p class="kicker">TIMELINE</p>
      <ol class="timeline">
        {p.timeline.map((t) => (
          <li>
            <span class="timeline__date">{fullDate(t.date, t.precision)}</span>
            <b>{kindWord[t.kind] ?? t.kind.toUpperCase()}</b>
            <span>{t.text}{t.source && <> <a href={t.source} rel="noopener">{hostOf(t.source)} ↗</a></>}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec build" aria-label="Construction">
      <div>
        <p class="kicker">HOW IT IS BUILT</p>
        <p class="build__tech">{p.tech}</p>
        <ol class="layers">
          {lead.layers.map((l) => (<li><i>{l.n}</i><span>{l.text}</span></li>))}
        </ol>
        {p.core.layers.length === 0 && <p class="fine">No layer-by-layer core description is on file for this paddle yet. The drawing shows the general construction for this build type.</p>}
        <dl class="kv">
          {p.core.face && (<><dt>Face</dt><dd>{p.core.face}</dd></>)}
          {p.core.edge && (<><dt>Edge</dt><dd>{p.core.edge}</dd></>)}
          {p.colorways.length > 0 && (<><dt>Colorways</dt><dd>{p.colorways.join(' · ')}</dd></>)}
        </dl>
        {p.core.source && <p class="fine">Construction per <a href={p.core.source} rel="noopener">{hostOf(p.core.source)} ↗</a></p>}
        {p.notes && <p class="build__note">{p.notes}</p>}
      </div>
      {plates.length > 1 && (
        <div class="shapes">
          {plates.slice(1).map(({ v, plate }) => (
            <figure>
              <div set:html={plate.svg} />
              <figcaption>{v.name || plate.geometry.shape}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </section>

    {measured.length > 0 && (
      <section class="sec" aria-label="Variants and measurements">
        <p class="kicker">VARIANTS · PUBLISHED AND MEASURED NUMBERS</p>
        <div class="tablewrap">
          <table>
            <thead><tr><th>Variant</th><th>Shape</th><th>Length × width</th><th>Handle</th><th>Core</th><th>Weight</th><th>Swingweight</th><th>Twistweight</th><th>From</th></tr></thead>
            <tbody>
              {measured.map((v) => (
                <tr>
                  <th>{v.name || '—'}</th>
                  <td>{v.shape || '—'}</td>
                  <td>{v.lengthIn && v.widthIn ? `${v.lengthIn} × ${v.widthIn} in` : '—'}</td>
                  <td>{v.handleIn ? `${v.handleIn} in` : '—'}</td>
                  <td>{v.thicknessMm ? `${v.thicknessMm} mm` : '—'}</td>
                  <td>{v.weightOz ? `${v.weightOz} oz` : '—'}</td>
                  <td>{v.sw ?? '—'}</td>
                  <td>{v.tw ?? '—'}</td>
                  <td>{v.specSource ? <a href={v.specSource} rel="noopener">{hostOf(v.specSource)} ↗</a> : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine">Swingweight and twistweight are each lab's own measurement of its own sample. Unit-to-unit variance is normal.</p>
      </section>
    )}

    <section class="sec" aria-label="The labs">
      <p class="kicker">MEASURED BY THE LABS</p>
      {p.labs.length > 0 ? (
        <div class="rows">
          {p.labs.map((l) => (
            <a class="row row--link" href={l.url} rel="noopener"><strong>{l.lab}</strong><span>{l.kind === 'database-entry' ? 'Database entry' : l.kind === 'video' ? 'Video review' : 'Review'} · {hostOf(l.url)}</span><b aria-hidden="true">↗</b></a>
          ))}
        </div>
      ) : (
        <p class="fine">No lab page linked yet. If you know of one, the dataset is open.</p>
      )}
      <p class="fine">The register does not re-measure paddles or copy a lab's numbers wholesale. Power, pop and spin belong to the people with the radar guns; go read them.</p>
    </section>

    <section class="sec split" aria-label="After purchase">
      <div class="bag" id="field" data-paddle={p.id}>
        <p class="kicker">FIELD REPORTS · AFTER YOU BUY IT</p>
        <h2>Reviewers measure a paddle new. Nobody measures it at hour sixty.</h2>
        <div class="field" id="field-body"><p>Loading field reports…</p></div>
        <noscript><p>Field reports load with JavaScript. The aggregates are also at <a href={`/api/paddles/wear?id=${p.id}`}>/api/paddles/wear?id={p.id}</a>.</p></noscript>
        <p>Keep a bag on Rally: log the hours you put on this paddle, when the grit fades, and when it goes dead. It stays on your device until you press "send a wear report", and the report carries no name.</p>
        <a class="btn" href={`${PADDLE_BAG_URL}?add=${p.id}`} rel="noopener">Open the bag on Rally ↗</a>
        <a class="btn btn--quiet" href={`/paddles/compare?ids=${p.id}`}>Compare with…</a>
      </div>
      <div>
        <p class="kicker">SOURCES · {p.confidence.toUpperCase()} CONFIDENCE</p>
        <ul class="sources">
          {p.sources.map((s) => (<li><a href={s} rel="noopener">{hostOf(s)} ↗</a></li>))}
        </ul>
        <details class="correct" id="correct" data-paddle={p.id}>
          <summary><span>Report a correction</span><small id="correct-open" hidden></small></summary>
          <form id="correct-form" novalidate>
            <p class="fine">Something on this page is wrong? Say which fact and paste the page that shows it. Corrections without a source are not accepted. Accepted ones show in <a href="/paddles/changes">the changes feed</a>.</p>
            <label><span>Field</span>
              <select name="field" required>
                <option value="launch-date">Launch date</option>
                <option value="price">Price</option>
                <option value="usap">USA Pickleball status</option>
                <option value="upaa">UPA-A status</option>
                <option value="dimensions">Dimensions</option>
                <option value="construction">Construction</option>
                <option value="pro">Pro</option>
                <option value="lifecycle">Lifecycle</option>
                <option value="other">Other</option>
              </select>
            </label>
            <label><span>What is wrong, and what is right</span>
              <textarea name="claim" rows="4" minlength="10" maxlength="600" required placeholder="The list price is $229, not $249."></textarea>
            </label>
            <label><span>Source URL (required)</span>
              <input name="source" type="url" inputmode="url" maxlength="500" required placeholder="https://" />
            </label>
            <label><span>Contact (optional, never published)</span>
              <input name="contact" type="text" maxlength="120" autocomplete="off" placeholder="email or handle, if you want a reply someday" />
            </label>
            <div class="correct__row">
              <button class="btn" type="submit">Send</button>
              <output id="correct-out" aria-live="polite"></output>
            </div>
          </form>
        </details>
      </div>
    </section>

    {changesFor(p.id).length > 0 && (
      <section class="sec" aria-label="Changes to this record">
        <p class="kicker">CHANGES TO THIS RECORD</p>
        <ol class="timeline">
          {changesFor(p.id).map((c) => (<li><span class="timeline__date">{fullDate(c.date)}</span><b>{CHANGE_WORDS[c.kind] ?? c.kind.toUpperCase()}</b><span>{c.text}{c.source && <> <a href={c.source} rel="noopener">{hostOf(c.source)} ↗</a></>}</span></li>))}
        </ol>
        <p class="fine"><a href="/paddles/changes">Every change to the register</a>, with an RSS feed.</p>
      </section>
    )}

    <section class="sec" aria-label="Nearby in the register">
      <p class="kicker">NEARBY IN THE REGISTER</p>
      <div class="near">
        {near.map((q) => (
          <a href={paddleUrl(q)} style={`--b:${BUILDS[q.build].color}`}>
            <small>{q.brand} · {q.year}</small>
            <strong>{q.model}</strong>
            <span>{priceLabel(q as any)} · {BUILDS[q.build].short}</span>
          </a>
        ))}
      </div>
      <p class="foot"><a href="/paddles">the whole register</a> · <a href={brandUrl(p.brand)}>everything from {p.brand}</a> · <a href="/paddle-calendar">the 2026 calendar</a> · CC0</p>
    </section>
  </main>
</BlockLayout>

<script>
  // Corrections desk. Posts to /api/paddles/correct; the reviewer reads the
  // queue in the weekly refresh. Nothing here is applied automatically.
  const box = document.getElementById('correct') as HTMLDetailsElement | null;
  const form = document.getElementById('correct-form') as HTMLFormElement | null;
  const out = document.getElementById('correct-out');
  const openTag = document.getElementById('correct-open');
  const paddleId = box?.dataset.paddle || '';

  const SID_KEY = 'pc:paddles:sid';
  let memSid = '';
  const randomHex = () => {
    const b = new Uint8Array(16);
    crypto.getRandomValues(b);
    return Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
  };
  const sessionId = () => {
    try {
      const have = localStorage.getItem(SID_KEY);
      if (have && /^[0-9a-f]{16,64}$/.test(have)) return have;
      const fresh = randomHex();
      localStorage.setItem(SID_KEY, fresh);
      return fresh;
    } catch {
      if (!memSid) memSid = randomHex();
      return memSid;
    }
  };

  const say = (text: string) => { if (out) out.textContent = text; };

  if (box && form && paddleId) {
    fetch(`/api/paddles/correct?id=${encodeURIComponent(paddleId)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const n = d && d.ok && typeof d.open === 'number' ? d.open : 0;
        if (n > 0 && openTag) {
          openTag.textContent = `${n} correction${n === 1 ? '' : 's'} waiting for review`;
          openTag.hidden = false;
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      const claim = String(fd.get('claim') || '').trim();
      const source = String(fd.get('source') || '').trim();
      const contact = String(fd.get('contact') || '').trim();
      if (claim.length < 10) return say('Not sent: say what is wrong in at least ten characters.');
      if (!/^https:\/\//.test(source)) return say('Not sent: a source URL starting with https:// is required.');
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      say('Sending…');
      try {
        const r = await fetch('/api/paddles/correct', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: sessionId(), paddleId, field: String(fd.get('field') || 'other'), claim, source, ...(contact ? { contact } : {}) }),
        });
        const d = await r.json().catch(() => null);
        if (r.status === 429) say('Try again in about a minute.');
        else if (r.ok && d && d.ok) {
          say('Sent. It goes into the weekly review; the changes feed shows what was accepted.');
          form.reset();
          if (openTag && typeof d.open === 'number' && d.open > 0) {
            openTag.textContent = `${d.open} correction${d.open === 1 ? '' : 's'} waiting for review`;
            openTag.hidden = false;
          }
        } else say(`Not sent: ${(d && d.reason) || `the desk answered ${r.status}`}`);
      } catch {
        say('Not sent: the desk did not answer. Check the connection and try again.');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
  // Field reports: aggregates only, shown once three reports are in. This
  // script was meant to ship with v2 and did not; the panel read "Loading"
  // until the corrections desk review caught it.
  const field = document.getElementById('field');
  const fieldBody = document.getElementById('field-body');
  if (field && fieldBody) {
    const stat = (v: string | number, label: string) => { const d = document.createElement('div'); const st = document.createElement('strong'); st.textContent = String(v); const l = document.createElement('span'); l.textContent = label; d.append(st, l); return d; };
    fetch(`/api/paddles/wear?id=${encodeURIComponent(field.dataset.paddle || '')}`).then((r) => r.json()).then((d) => {
      fieldBody.replaceChildren();
      const a = d?.aggregates;
      if (!a) {
        const p = document.createElement('p');
        p.textContent = d?.n ? `${d.n} report${d.n === 1 ? '' : 's'} in so far. The panel opens at ${d.minShown ?? 3}.` : 'No field reports yet. Be the first: keep a bag on Rally and send one when you have hours on it.';
        fieldBody.append(p);
        return;
      }
      const grid = document.createElement('div'); grid.className = 'stat';
      grid.append(stat(a.medianHours, `median hours · ${a.n} reports`), stat(a.fade ? a.fade.medianHours : '—', a.fade ? `median hours to grit fading · ${a.fade.n}` : 'grit fading · under 3 reports'), stat(`${Math.round(a.dead.share * 100)}%`, a.dead.n ? `report it went dead · median ${a.dead.medianHours} h` : 'report it went dead'));
      fieldBody.append(grid);
      const note = document.createElement('small');
      const ratings = Object.entries(a.ratings || {}).sort().map(([k, v]) => `${k}: ${v}`).join(', ');
      note.textContent = `Self-reported by players from The Bag on Rally, unaudited. Median ${a.medianSessions} sessions over ${a.medianMonths} months.${ratings ? ` Rating buckets: ${ratings}.` : ''} Aggregates only; raw reports are never published.`;
      fieldBody.append(note);
    }).catch(() => { fieldBody.replaceChildren(); const p = document.createElement('p'); p.textContent = 'Field reports could not be loaded right now.'; fieldBody.append(p); });
  }
</script>

<style>
  .pad{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;flex-wrap:wrap;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}.crumb a:last-child{margin-left:auto;color:var(--c800)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:32px;padding:40px 0 32px;align-items:start}
  .hero h1{margin:0;font:500 clamp(34px,5.2vw,62px)/.98 var(--pc-font-sans);letter-spacing:-.035em;text-wrap:balance}
  .hero h1 span{display:block;font-size:.5em;letter-spacing:-.01em;color:var(--pc-ink-muted);margin-bottom:6px}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .facts{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin:24px 0 0;border-top:1.5px solid var(--c600)}
  .facts div{padding:10px 12px 10px 0;border-bottom:1px solid var(--pc-rule-soft)}
  .facts dt{font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .facts dd{margin:4px 0 0;font:500 16px/1.3 var(--pc-font-sans);font-variant-numeric:tabular-nums}
  .facts small{display:block;margin-top:2px;font:400 10px var(--pc-font-mono);letter-spacing:.04em;color:var(--pc-ink-muted);text-transform:uppercase}
  .hero__links{display:flex;flex-wrap:wrap;gap:6px 18px;margin:16px 0 0;font:400 13px var(--pc-font-sans)}
  .hero__links a{color:var(--c800)}
  .plate{margin:0;border:1.5px solid var(--c600);background:#fff}
  .plate__svg{padding:14px 10px 6px;border-left:6px solid var(--b)}
  .plate :global(svg){display:block;width:100%;height:auto;max-height:560px}
  .plate figcaption{padding:10px 12px;border-top:1px solid var(--pc-rule-soft);font:400 12px/1.5 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .status{display:grid;grid-template-columns:repeat(4,1fr);border:1.5px solid var(--c600)}
  .cell{padding:14px;border-right:1.5px solid var(--c600)}
  .cell:last-child{border-right:0}
  .cell small{display:block;font:500 10px var(--pc-font-mono);letter-spacing:.12em;color:var(--pc-ink-muted)}
  .cell strong{display:block;margin:8px 0 6px;font:500 19px/1.15 var(--pc-font-sans);letter-spacing:-.01em}
  .cell span{font:400 12.5px/1.5 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .cell a{color:var(--c800)}
