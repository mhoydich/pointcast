---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { BUILDS, MONTHS } from '../../lib/paddle-calendar';
import { PADDLES, PADDLE_REGISTER_URL, REGISTER_STATS, legalUpaa, legalUsap, paddleUrl, splitRulebook, whenLabel, type LegalBucket, type Paddle } from '../../lib/paddle-register';

const title = 'Which paddles are approved: USA Pickleball, UPA-A, quiet courts';
const description = `Every paddle in the register sorted by rulebook: on the USA Pickleball approved list, on the UPA-A list for PPA and MLP play, in the USAP Quiet Category, and the paddles that are legal under one rulebook and not the other, with the reason. Status checked ${REGISTER_STATS.asOf}, with links to both official lists.`;
const court = CHANNELS.CRT;
const asOf = `${MONTHS[Number(REGISTER_STATS.asOf.slice(5, 7)) - 1]} ${Number(REGISTER_STATS.asOf.slice(8, 10))}, ${REGISTER_STATS.asOf.slice(0, 4)}`;
const bucket = (fn: (p: Paddle) => LegalBucket) => {
  const out: Record<LegalBucket, Paddle[]> = { on: [], some: [], pending: [], off: [], unknown: [] };
  for (const p of PADDLES) out[fn(p)].push(p);
  return out;
};
const usap = bucket(legalUsap), upaa = bucket(legalUpaa);
const quiet = PADDLES.filter((p) => p.reg.quiet);
const split = splitRulebook();
const BUCKET: Record<LegalBucket, string> = { on: 'On the list', some: 'Some variants only', pending: 'Pending', off: 'Not on the list', unknown: 'Not confirmed by the register' };
const jsonLd = { '@context': 'https://schema.org', '@type': 'Dataset', name: title, description, url: `${PADDLE_REGISTER_URL}/legal`, dateModified: REGISTER_STATS.asOf, isAccessibleForFree: true, license: 'https://creativecommons.org/publicdomain/zero/1.0/', isPartOf: { '@type': 'Dataset', name: 'The Paddle Register', url: PADDLE_REGISTER_URL } };
---

<BlockLayout title={title} description={description} image="/images/og/paddles.png" jsonLd={jsonLd}>
  <main class="leg" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><a href="/paddles">paddles</a><span>/</span><span>legal</span></nav>
    <header class="hero">
      <p class="kicker">THE PADDLE REGISTER · WHERE EACH ONE IS LEGAL · CHECKED {asOf.toUpperCase()}</p>
      <h1>Can I bring it?</h1>
      <p class="dek">Two rulebooks govern the sport. USA Pickleball approves paddles for sanctioned amateur play and certifies for life on a new paddle. UPA-A approves them for the PPA Tour and MLP, certifies for two years, and tests after an artificial break-in. They do not always agree. This page says what each list carried on the day the register last checked.</p>
      <p class="official">Official lists: <a href="https://equipment.usapickleball.org/" rel="noopener">USA Pickleball approved paddles ↗</a> · <a href="https://upaa.unitedpickleball.com/approved-paddles" rel="noopener">UPA-A approved paddles ↗</a>. Confirm there before an event; lists change without notice.</p>
    </header>

    <section class="sec split" aria-label="Legal under one rulebook, not the other">
      <p class="kicker">ONE LIST, NOT THE OTHER · {split.length} PADDLES</p>
      <div class="rows">
        {split.map(({ paddle: p, usap: u, upaa: t, why }) => (
          <a class="row" href={paddleUrl(p)} style={`--b:${BUILDS[p.build].color}`}>
            <strong>{p.brand} {p.model}<small>{whenLabel(p)}</small></strong>
            <span class="cells"><b class={`s s--${u}`}>USAP: {BUCKET[u]}</b><b class={`s s--${t}`}>UPA-A: {BUCKET[t]}</b></span>
            <span class="why">{why}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="tabs" role="tablist" aria-label="Rulebook">
      <a href="#usap" role="tab">USA Pickleball</a><a href="#upaa" role="tab">UPA-A · PPA and MLP</a><a href="#quiet" role="tab">Quiet category</a>
    </div>

    {([['usap', 'USA PICKLEBALL · SANCTIONED AMATEUR PLAY', usap], ['upaa', 'UPA-A · PPA TOUR AND MLP', upaa]] as const).map(([id, label, b]) => (
      <section class="sec" id={id} aria-label={label}>
        <p class="kicker">{label}</p>
        {(['on', 'some', 'pending', 'off', 'unknown'] as LegalBucket[]).filter((k) => b[k].length).map((k) => (
          <details open={k === 'on' || k === 'off' || k === 'some'}>
            <summary><b class={`s s--${k}`}>{BUCKET[k]}</b><span>{b[k].length}</span></summary>
            <ul class="list">
              {b[k].map((p) => (<li style={`--b:${BUILDS[p.build].color}`}><a href={paddleUrl(p)}>{p.brand} {p.model}</a><small>{whenLabel(p)} · {p.thickness || BUILDS[p.build].short}</small>{k !== 'on' && p.certNote && <em>{p.certNote}</em>}</li>))}
            </ul>
          </details>
        ))}
        <p class="fine">"Not on the list" means the register did not find it on the official list on {asOf}. "Not confirmed" means no source the register checked stated it either way; it is not a verdict.</p>
      </section>
    ))}

    <section class="sec" id="quiet" aria-label="Quiet category">
      <p class="kicker">USAP QUIET CATEGORY · UNDER 80 DB, UNDER 600 HZ</p>
      {quiet.length ? (
        <ul class="list">{quiet.map((p) => (<li style={`--b:${BUILDS[p.build].color}`}><a href={paddleUrl(p)}>{p.brand} {p.model}</a><small>{whenLabel(p)}</small></li>))}</ul>
      ) : <p class="fine">None in the register yet.</p>}
      <p class="fine">The category exists for courts near houses. As of the last check, one brand in the register is on it with a paddle that is also tournament-legal. <a href="https://usapickleball.org/equipment/usa-pickleball-announces-its-first-certified-quiet-product-the-owl-by-owl-sport/" rel="noopener">USAP's announcement ↗</a></p>
    </section>

    <p class="foot"><a href="/paddles">the whole register</a> · <a href="/paddles/compare">compare paddles</a> · <a href="/paddle-calendar#ahead">the Oct 1 spin-test change</a> · CC0</p>
  </main>
</BlockLayout>

<style>
  .leg{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:44px 0 8px;max-width:860px}
  .hero h1{margin:0;font:500 clamp(40px,6.4vw,76px)/.96 var(--pc-font-sans);letter-spacing:-.035em}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .official{margin:14px 0 0;font:400 14px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .official a,.fine a,.list a{color:var(--c800)}
  .sec{padding-top:44px;scroll-margin-top:12px}
  .rows{border-top:1.5px solid var(--c600)}
  .row{display:grid;grid-template-columns:260px 300px 1fr;gap:16px;align-items:baseline;padding:13px 0 13px 14px;border-bottom:1px solid var(--pc-rule-soft);border-left:4px solid var(--b);color:var(--pc-ink)}
  .row:hover{background:var(--c50);text-decoration:none}
  .row strong{font:500 16px/1.3 var(--pc-font-sans)}
  .row strong small{display:block;font:400 10px var(--pc-font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .cells{display:flex;flex-wrap:wrap;gap:6px}
  .why{font:400 13.5px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .s{padding:3px 7px;border:1px solid var(--pc-rule);font:500 10px var(--pc-font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--pc-ink-soft)}
  .s--on{background:var(--c50);border-color:var(--c600);color:var(--c800)}.s--off{border-color:#8a2432;color:#8a2432}.s--some,.s--pending{border-color:#8a4b00;color:#8a4b00}
  .tabs{display:flex;gap:0;margin-top:44px;border:1.5px solid var(--c600)}
  .tabs a{flex:1;padding:10px 12px;text-align:center;font:500 11px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800);border-right:1.5px solid var(--c600)}
  .tabs a:last-child{border-right:0}.tabs a:hover{background:var(--c50);text-decoration:none}
  details{border-top:1.5px solid var(--c600)}
  summary{display:flex;align-items:center;gap:12px;padding:12px 0;cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary span{font:400 12px var(--pc-font-mono);color:var(--pc-ink-muted)}
  .list{margin:0 0 12px;padding:0;list-style:none;columns:2;column-gap:24px}
  .list li{break-inside:avoid;padding:6px 0 6px 12px;border-left:3px solid var(--b);margin-bottom:6px;font:400 15px/1.35 var(--pc-font-sans)}
  .list small{display:block;font:400 10px var(--pc-font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .list em{display:block;margin-top:3px;font:400 12.5px/1.45 var(--pc-font-sans);font-style:normal;color:var(--pc-ink-soft)}
  .fine{margin:10px 0 0;max-width:760px;font:400 12.5px/1.55 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .foot{margin:40px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .foot a{color:var(--c800)}
  @media(max-width:820px){.row{grid-template-columns:1fr;gap:6px}.list{columns:1}.tabs{flex-direction:column}.tabs a{border-right:0;border-bottom:1.5px solid var(--c600)}.hero{padding-top:28px}}
</style>
