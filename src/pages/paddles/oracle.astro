---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { PAID_TOWN_ACTIONS } from '../../../functions/_lib/paid-town-actions';
import { REGISTER_STATS } from '../../lib/paddle-register';
import { answerOracle, ORACLE_ENDPOINT, parseOracleQuery, type OracleQuery } from '../../lib/paddle-oracle';

const title = 'The Paddle Oracle: one cent, one sourced answer';
const description = `Ask the PointCast Paddle Register one question and get the best matching paddles back, every fact with its source URL, under a signed x402 receipt. 0.01 USDC per answer. The register itself stays free at /paddles. ${REGISTER_STATS.paddles} paddles, checked ${REGISTER_STATS.asOf}.`;
const court = CHANNELS.CRT;
const entry = PAID_TOWN_ACTIONS.oracle;
const sample = answerOracle(parseOracleQuery(entry.body) as OracleQuery);
const sampleShown = { ...sample, paddles: sample.paddles.slice(0, 1).map((p) => ({ id: p.id, brand: p.brand, model: p.model, listPriceUsd: p.listPriceUsd, status: { usap: p.status.usap, upaa: p.status.upaa }, summary: p.summary, sources: p.sources, '…': 'plus core, variants, timeline, lab links, changes' })) };
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebAPI', name: 'The Paddle Oracle', description, url: 'https://pointcast.xyz/paddles/oracle',
  documentation: 'https://pointcast.xyz/paddles/oracle', offers: { '@type': 'Offer', price: '0.01', priceCurrency: 'USD' },
  provider: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout title={title} description={description} image="/images/og/paddles.png" jsonLd={jsonLd}>
  <main class="orc" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><a href="/paddles">paddles</a><span>/</span><span>oracle</span></nav>
    <header class="hero">
      <p class="kicker">THE PADDLE REGISTER · A PAID ANSWER DESK FOR AGENTS · 0.01 USDC</p>
      <h1>Ask the register. One cent.</h1>
      <p class="dek">Send one question, like "control paddle under $200 that's USAP legal". You get back the best matching paddles from the register, each with its sources, lab links and history, and a signed receipt. A plain search picks the answer, not a model, so the same question gets the same answer.</p>
      <p class="dek">The register stays free: every paddle page is at <a href="/paddles">/paddles</a>. The oracle charges for doing the lookup in one call, with a receipt your agent can cite.</p>
    </header>

    <section class="sec" aria-label="Free preview">
      <p class="kicker">FREE PREVIEW · HOW MANY WOULD MATCH</p>
      <form class="ask" id="ask">
        <label>Question<input name="q" maxlength="200" placeholder="control paddle for a 4.0 player" /></label>
        <label>Max price ($)<input name="maxPrice" type="number" min="1" max="2000" placeholder="200" /></label>
        <label>Build<select name="build"><option value="">any</option><option>foam</option><option>hybrid</option><option>poly</option><option>rib</option></select></label>
        <label>Thickness (mm)<input name="thicknessMm" type="number" min="8" max="25" step="0.5" placeholder="16" /></label>
        <label class="chk"><input name="usap" type="checkbox" value="true" /> USAP legal only</label>
        <button type="submit">Count matches</button>
      </form>
      <p class="out" id="out" aria-live="polite">The preview is free and only tells you how many paddles match. The records cost a cent.</p>
    </section>

    <section class="sec" aria-label="Two rails">
      <p class="kicker">TWO RAILS · SAME ANSWERS · ONE CENT</p>
      <div class="rails">
        <div><b>Base · Coinbase CDP</b><code>GET https://pointcast.xyz/api/oracle/paddles?q=…</code><span>USDC on Base, EIP-3009 "exact". Settles through Coinbase's facilitator, which lists the route in the x402 Bazaar after its first paid call. Any stock x402 client works: <code>@x402/fetch</code>, <code>x402-axios</code>, the CDP wallet. Resending the same payment after a lost response returns the stored answer with no second charge. <em id="base-state">Checking status…</em></span></div>
        <div><b>Etherlink · Permit2</b><code>POST {ORACLE_ENDPOINT}</code><span>USDC on Etherlink through the TZ APAC facilitator, with an Idempotency-Key. This is the rail every paid town action uses.</span></div>
      </div>
    </section>

    <section class="sec" aria-label="How an agent pays">
      <p class="kicker">HOW AN AGENT PAYS ON ETHERLINK · x402 v2</p>
      <ol class="steps">
        <li><b>Ask without paying.</b> <code>POST {ORACLE_ENDPOINT}</code> with the question. You get a <code>402</code> and a <code>Payment-Required</code> header: 0.01 USDC on Etherlink, exact scheme, through Permit2.</li>
        <li><b>Sign the terms</b> in any x402 v2 client that speaks the <code>pointcast.bubbletez-permit2-exact/v1</code> profile.</li>
        <li><b>Send it again</b> with <code>Payment-Signature</code> and a stable <code>Idempotency-Key</code>. The answer comes back with a signed receipt. Retrying with the same key returns the same answer and never charges twice.</li>
      </ol>
      <pre class="code">{entry.curl}</pre>
      <p class="fine">A bare <code>GET</code> or an empty <code>POST</code> also returns the 402, so catalogs and crawlers can read the price. Half of each cent goes to the house and half to the register's network share, same as every paid town action. See <a href="/till">/till</a>.</p>
    </section>

    <section class="sec" aria-label="Sample answer">
      <p class="kicker">WHAT YOU GET · SAMPLE, TRIMMED</p>
      <pre class="code">{JSON.stringify({ q: entry.body }, null, 2)}</pre>
      <pre class="code">{JSON.stringify(sampleShown, null, 2)}</pre>
    </section>

    <p class="foot"><a href="/paddles">the whole register, free</a> · <a href="/paddles/legal">who's legal</a> · <a href="/paddle-calendar">the 2026 calendar</a> · <a href="/x402">x402 at PointCast</a> · data CC0</p>
  </main>
</BlockLayout>

<script>
  const baseState = document.getElementById('base-state');
  fetch('/api/oracle/paddles').then(async (r) => {
    if (!baseState) return;
    if (r.status === 402) baseState.textContent = 'Status: open. A bare request returns the Base price.';
    else if (r.status === 503) baseState.textContent = 'Status: waiting on the operator to add the CDP key. Etherlink is open now.';
    else baseState.textContent = `Status: ${r.status}.`;
  }).catch(() => { if (baseState) baseState.textContent = ''; });
  const form = document.getElementById('ask') as HTMLFormElement | null;
  const out = document.getElementById('out');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!out) return;
    const data = new FormData(form);
    const params = new URLSearchParams({ preview: '1' });
    for (const key of ['q', 'maxPrice', 'build', 'thicknessMm']) {
      const value = String(data.get(key) ?? '').trim();
      if (value) params.set(key, value);
    }
    if (data.get('usap')) params.set('usap', 'true');
    out.textContent = 'Counting…';
    try {
      const response = await fetch(`/api/agent/oracle?${params}`);
      const body = await response.json();
      out.textContent = response.ok
        ? `${body.matched} of ${body.register.paddles} paddles match. Pay one cent through the endpoint to get the records with sources.`
        : body.error || 'The preview could not run.';
    } catch {
      out.textContent = 'The preview could not run.';
    }
  });
</script>

<style>
  .orc{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .hero{padding:44px 0 8px;max-width:860px}
  .hero h1{margin:0;font:500 clamp(40px,6.4vw,76px)/.96 var(--pc-font-sans);letter-spacing:-.035em}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .dek a,.fine a,.foot a{color:var(--c800)}
  .sec{padding-top:44px}
  .ask{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:12px;align-items:end;padding:16px;border:1.5px solid var(--c600)}
  .ask label{display:flex;flex-direction:column;gap:5px;font:500 10px var(--pc-font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--pc-ink-soft)}
  .ask input,.ask select{padding:8px;border:1px solid var(--pc-rule);font:400 15px var(--pc-font-sans);color:var(--pc-ink);background:var(--pc-bg, #fff);border-radius:0}
  .ask .chk{flex-direction:row;align-items:center;gap:8px;grid-column:span 2}
  .ask button{grid-column:span 2;padding:10px 14px;border:1.5px solid var(--c600);background:var(--c600);color:#fff;font:500 11px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border-radius:0}
  .out{margin:12px 0 0;font:400 15px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .rails{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1.5px solid var(--c600)}
  .rails>div{display:flex;flex-direction:column;gap:8px;padding:16px;font:400 14px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .rails>div+div{border-left:1.5px solid var(--c600)}
  .rails b{font:500 11px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .rails>div>code{word-break:break-all;color:var(--pc-ink)}
  .rails em{font-style:normal;color:var(--c800)}
  .steps{margin:0;padding-left:20px;max-width:860px;font:400 15px/1.6 var(--pc-font-sans)}
  .steps li{margin-bottom:10px}
  code{font:400 13px var(--pc-font-mono)}
  .code{margin:12px 0 0;padding:14px;border:1px solid var(--pc-rule);background:var(--c50);font:400 12px/1.5 var(--pc-font-mono);white-space:pre-wrap;word-break:break-word;overflow-x:auto}
  .fine{margin:12px 0 0;max-width:760px;font:400 12.5px/1.55 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .foot{margin:40px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  @media(max-width:820px){.rails{grid-template-columns:1fr}.rails>div+div{border-left:0;border-top:1.5px solid var(--c600)}.ask{grid-template-columns:1fr}.ask .chk,.ask button{grid-column:auto}.hero{padding-top:28px}}
</style>
