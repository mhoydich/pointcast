---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CHANNELS } from '../../lib/channels';
import { BUILDS, PADDLE_CALENDAR, hostOf } from '../../lib/paddle-calendar';
import { PADDLES, PADDLE_REGISTER_URL, PRO_ROWS, REGISTER_STATS, brandUrl, paddleUrl, whenLabel } from '../../lib/paddle-register';

const title = 'Who plays what: pro paddles, with dates and sources';
const description = `Which paddle each pro plays, from the register's own records and the 2026 signings table: ${PRO_ROWS.length} players linked to their current paddle, where they came from, and when they moved. Every row carries a source.`;
const court = CHANNELS.CRT;
const moves = PADDLE_CALENDAR.moves as { player: string; from: string; to: string; note: string }[];
// Signings whose paddle is not (yet) a named line in the register still get a row, linked to the brand file when there is one.
const named = new Set(PRO_ROWS.map((r) => r.player));
const brandSlug = (b: string) => PADDLES.find((p) => p.brand.toLowerCase() === b.toLowerCase().split(' / ')[0])?.brand;
const unplaced = moves.flatMap((m) => m.player.split('·').map((s) => s.trim()).filter((pl) => !named.has(pl)).map((pl) => ({ player: pl, brand: m.to, from: m.from, note: m.note, brandOnFile: brandSlug(m.to) })));
const groups = [...new Set(PRO_ROWS.map((r) => r.paddle.brand))].sort().map((brand) => ({ brand, rows: PRO_ROWS.filter((r) => r.paddle.brand === brand) }));
const src = PADDLE_CALENDAR.anchors.find((a) => /Waters/.test(a.title))?.source || 'https://www.thedinkpickleball.com/tracking-all-the-new-pro-paddle-deals-in-2026/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Dataset', name: title, description, url: `${PADDLE_REGISTER_URL}/pros`, dateModified: REGISTER_STATS.asOf, isAccessibleForFree: true, license: 'https://creativecommons.org/publicdomain/zero/1.0/', isPartOf: { '@type': 'Dataset', name: 'The Paddle Register', url: PADDLE_REGISTER_URL } };
---

<BlockLayout title={title} description={description} image="/images/og/paddles.png" jsonLd={jsonLd}>
  <main class="pros" style={`--c50:${court.color50};--c600:${court.color600};--c800:${court.color800}`}>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span>/</span><a href="/paddles">paddles</a><span>/</span><span>pros</span></nav>
    <header class="hero">
      <p class="kicker">THE PADDLE REGISTER · WHO PLAYS WHAT · 2026</p>
      <h1>What the pros are holding.</h1>
      <p class="dek">A player's paddle is a fact with a date on it. This table joins the pros named on each paddle's page to the 2026 signings ledger, so the answer to "what does she play" comes with where she came from, when she moved, and a source. Signature paddles are marked. Most contracts end December 31; the table will move in January.</p>
    </header>

    {groups.map((g) => (
      <section class="sec" aria-label={g.brand}>
        <p class="kicker"><a href={brandUrl(g.brand)}>{g.brand.toUpperCase()}</a> · {g.rows.length}</p>
        <div class="rows">
          {g.rows.map((r) => (
            <div class="row" style={`--b:${BUILDS[r.paddle.build].color}`}>
              <strong>{r.player}</strong>
              <span><a href={paddleUrl(r.paddle)}>{r.paddle.model}</a><small>{whenLabel(r.paddle)} · {r.paddle.msrp != null ? `$${r.paddle.msrp}` : ''}{/signature|own spec|signature/i.test(r.paddle.take + r.paddle.tech + r.paddle.model) ? ' · signature' : ''}</small></span>
              <span class="move">{r.from ? <>from <b>{r.from}</b></> : <>on {g.brand}</>}{r.note ? ` · ${r.note}` : ''}</span>
            </div>
          ))}
        </div>
      </section>
    ))}

    {unplaced.length > 0 && (
      <section class="sec" aria-label="Signed, paddle not yet in the register">
        <p class="kicker">SIGNED IN 2026 · PADDLE NOT YET A NAMED LINE IN THE REGISTER</p>
        <div class="rows">
          {unplaced.map((u) => (
            <div class="row row--soft">
              <strong>{u.player}</strong>
              <span>{u.brandOnFile ? <a href={brandUrl(u.brandOnFile)}>{u.brand}</a> : u.brand}</span>
              <span class="move">{u.from ? <>from <b>{u.from}</b></> : 'new signing'}{u.note ? ` · ${u.note}` : ''}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <p class="fine">Signings from The Dink's and The Kitchen's 2026 trackers (<a href={src} rel="noopener">{hostOf(src)} ↗</a>) and each paddle's own sources. A pro's page-level paddle is the model the brand or a launch article names; on-court paddles change week to week and the register does not track that.</p>
    <p class="foot"><a href="/paddles">the whole register</a> · <a href="/paddle-calendar#moves">the full signings table</a> · <a href="/paddles/changes">what changed</a> · CC0</p>
  </main>
</BlockLayout>

<style>
  .pros{max-width:1120px;margin:0 auto;padding:20px 18px 96px;color:var(--pc-ink)}
  .crumb{display:flex;gap:9px;align-items:center;padding:6px 0 16px;border-bottom:1px solid var(--pc-rule);font:10px var(--pc-font-mono);text-transform:uppercase;letter-spacing:.1em}
  .crumb a{color:var(--pc-ink)}
  .kicker{margin:0 0 12px;font:500 10px var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--c800)}
  .kicker a{color:var(--c800)}
  .hero{padding:44px 0 8px;max-width:860px}
  .hero h1{margin:0;font:500 clamp(40px,6.4vw,76px)/.96 var(--pc-font-sans);letter-spacing:-.035em}
  .dek{margin:18px 0 0;font:400 17px/1.55 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .sec{padding-top:36px}
  .rows{border-top:1.5px solid var(--c600)}
  .row{display:grid;grid-template-columns:240px 300px 1fr;gap:16px;align-items:baseline;padding:12px 0 12px 14px;border-bottom:1px solid var(--pc-rule-soft);border-left:4px solid var(--b,var(--pc-rule))}
  .row strong{font:500 16px/1.3 var(--pc-font-sans)}
  .row a{color:var(--c800)}
  .row small{display:block;font:400 10px var(--pc-font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--pc-ink-muted)}
  .move{font:400 14px/1.5 var(--pc-font-sans);color:var(--pc-ink-soft)}
  .move b{font-weight:500;color:var(--pc-ink)}
  .row--soft{border-left-style:dashed}
  .fine{margin:32px 0 0;max-width:760px;font:400 12.5px/1.55 var(--pc-font-sans);color:var(--pc-ink-muted)}
  .fine a,.foot a{color:var(--c800)}
  .foot{margin:24px 0 0;font:400 10px/1.8 var(--pc-font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--pc-ink-muted)}
  @media(max-width:820px){.row{grid-template-columns:1fr;gap:4px}.hero{padding-top:28px}}
</style>
