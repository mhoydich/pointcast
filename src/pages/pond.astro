---
import BlockLayout from '../layouts/BlockLayout.astro';

// The Pond — a holders' room + curated shows for Froggos (Tezos).
// Read-only: everything comes from objkt's public GraphQL indexer in the
// browser. No contracts, no KV writes, no custody. Shows live in the URL.
const FROGGOS = 'KT1QqTVamPvqEHMCKkzvYN8mxsxCCYjQKsdD';
const title = 'The Pond · a room for Froggos holders';
const description = 'Froggos holders get a seat in the pond: see your frogs, hang a small curated show, and send buyers to objkt with your name on the wall. Read-only, no new contracts.';
---

<BlockLayout title={title} description={description} themeColor="#2F6B3A">
  <main class="pond" data-pond data-contract={FROGGOS}>
    <nav class="pond-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>The Pond</span>
    </nav>

    <header class="pond-mast">
      <p class="pond-kicker">The Pond · Froggos on Tezos · holders' room + curated shows</p>
      <h1>A seat for every frog.</h1>
      <p class="pond-lede">
        <a href="https://www.froggos.xyz" rel="noopener">Froggos</a> is 2,500 hand-drawn frogs on Tezos.
        If one lives in your wallet, you have a seat here. Anyone can hang a show of up to eight frogs,
        and every link to objkt carries the curator's name.
      </p>
      <dl class="pond-census" data-pond-census aria-live="polite">
        <div><dt>Frogs indexed</dt><dd data-k="items">…</dd></div>
        <div><dt>Holders</dt><dd data-k="owners">…</dd></div>
        <div><dt>Floor</dt><dd data-k="floor">…</dd></div>
        <div><dt>Lifetime volume</dt><dd data-k="volume">…</dd></div>
      </dl>
      <p class="pond-fine">
        Live from objkt's public index. Froggos art belongs to its makers
        (<a href="https://x.com/FroggosTez" rel="noopener">@FroggosTez</a>); PointCast only reads the chain and links out.
        Not affiliated.
      </p>
    </header>

    <section class="pond-section" aria-labelledby="seat-title">
      <div class="pond-head">
        <p class="pond-kicker">01 · Your seat</p>
        <h2 id="seat-title">Frogs in your wallet</h2>
      </div>
      <form class="pond-look" data-pond-look>
        <label for="pond-addr">Tezos address</label>
        <input id="pond-addr" name="addr" autocomplete="off" spellcheck="false" placeholder="tz1… (signed-in Kukai fills this)" />
        <button type="submit">Look in the pond</button>
      </form>
      <p class="pond-status" data-pond-seat-status aria-live="polite">Sign in with Kukai at <a href="/auth">/auth</a>, or paste any address to look. Looking is public; nothing is signed.</p>
      <div class="pond-water" data-pond-water hidden>
        <div class="pond-ripples" aria-hidden="true"><span></span><span></span><span></span></div>
        <ul class="pond-pads" data-pond-pads></ul>
      </div>
    </section>

    <section class="pond-section" aria-labelledby="show-title">
      <div class="pond-head">
        <p class="pond-kicker" data-pond-show-kicker>02 · On the wall</p>
        <h2 id="show-title" data-pond-show-title>Show 000 · The floor, hung properly</h2>
        <p class="pond-show-by" data-pond-show-by>Curated by the house: the eight cheapest frogs listed right now, updated every visit.</p>
        <p class="pond-show-note" data-pond-show-note hidden></p>
      </div>
      <ol class="pond-wall" data-pond-wall></ol>
      <p class="pond-status" data-pond-wall-status aria-live="polite"></p>
    </section>

    <section class="pond-section" aria-labelledby="hang-title">
      <div class="pond-head">
        <p class="pond-kicker">03 · Hang a show</p>
        <h2 id="hang-title">Curate up to eight frogs</h2>
        <p>
          A show is a link, and nothing is stored on our side. Pick frogs by number, give the show a name and a sentence,
          then share the link. If the curator address holds a Froggo, the wall marks it as a holder's show.
        </p>
      </div>
      <form class="pond-hang" data-pond-hang>
        <label>Show title <input name="t" maxlength="60" required placeholder="Frogs in fisherman hats" /></label>
        <label>Why these frogs? <textarea name="n" maxlength="280" rows="2" placeholder="One sentence for the wall."></textarea></label>
        <label>Curator (tz address or name) <input name="by" maxlength="40" required placeholder="tz1… or a name" /></label>
        <label>Frog numbers, comma separated (max 8) <input name="ids" required placeholder="797, 1000, 2161" inputmode="numeric" /></label>
        <div class="pond-hang-actions">
          <button type="submit">Hang it</button>
          <button type="button" data-pond-copy hidden>Copy show link</button>
        </div>
        <output class="pond-status" data-pond-hang-status></output>
      </form>
    </section>

    <section class="pond-section pond-rules" aria-labelledby="rules-title">
      <div class="pond-head">
        <p class="pond-kicker">04 · How the pond works</p>
        <h2 id="rules-title">Credit now, a cut once we can count it.</h2>
      </div>
      <ol>
        <li><strong>Holders get a seat.</strong> We check ownership on the public index. No signature and no custody.</li>
        <li><strong>Curators get their name on the wall.</strong> Every objkt link in a show says who hung it.</li>
        <li><strong>Sales happen on objkt.</strong> The artists' royalties stay on-chain, as they are today.</li>
        <li><strong>The curator's cut comes later.</strong> Paid curation (about 10% of a sale the curator brought in) starts only once a referral can be proven on-chain. Until then, credit is the only payment, and we won't promise one we can't pay.</li>
        <li><strong>Show 001 has three open seats for holders.</strong> Hang a show, then send the link to the PointCast Shortwave (<a href="/shortwave">/shortwave</a>).</li>
      </ol>
    </section>
  </main>
</BlockLayout>

<style is:global>
  .pond { --pond-green:#2F6B3A; --pond-pad:#7FB069; --pond-water:#D8ECE4; --pond-deep:#1E4A3A;
    max-width: 1080px; margin: 0 auto; padding: 16px 16px 64px; color: var(--pc-ink, #12110E); font-family: var(--pc-font-sans, Inter, system-ui, sans-serif); }
  .pond a { color: var(--pond-deep); }
  .pond-crumb { display:flex; gap:8px; font: 400 11px/1 var(--pc-font-mono, monospace); text-transform:uppercase; letter-spacing:.1em; color: var(--pc-ink-muted,#5F5E5A); margin-bottom: 24px; }
  .pond-kicker { font: 500 11px/1.4 var(--pc-font-mono, monospace); text-transform:uppercase; letter-spacing:.1em; color: var(--pond-green); margin: 0 0 8px; }
  .pond h1 { font-size: clamp(34px, 6vw, 60px); font-weight: 500; line-height: 1.02; margin: 0 0 16px; letter-spacing: -.02em; }
  .pond h2 { font-size: clamp(22px, 3vw, 30px); font-weight: 500; margin: 0 0 8px; }
  .pond-lede { font-size: 18px; line-height: 1.5; max-width: 62ch; margin: 0 0 24px; }
  .pond-census { display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 0; border: 1.5px solid var(--pond-green); margin: 0 0 8px; }
  .pond-census div { padding: 12px; border-right: 1px solid var(--pc-rule-soft,#E5E3DE); }
  .pond-census div:last-child { border-right: 0; }
  .pond-census dt { font: 400 10px/1.3 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; color: var(--pc-ink-muted,#5F5E5A); }
  .pond-census dd { margin: 4px 0 0; font: 500 22px/1.1 var(--pc-font-mono, monospace); }
  .pond-fine { font-size: 12px; color: var(--pc-ink-muted,#5F5E5A); margin: 0; }
  .pond-section { margin-top: 48px; border-top: 1.5px solid var(--pc-ink,#12110E); padding-top: 16px; }
  .pond-head p { max-width: 64ch; line-height: 1.5; }
  .pond-look, .pond-hang { display:grid; gap: 8px; max-width: 640px; }
  .pond-look { grid-template-columns: 1fr auto; align-items:end; }
  .pond-look label { grid-column: 1 / -1; font: 400 11px/1 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; }
  .pond-hang label { display:grid; gap: 4px; font: 400 11px/1.3 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; }
  .pond input, .pond textarea { font: 400 15px/1.4 var(--pc-font-sans, Inter, sans-serif); text-transform: none; letter-spacing: 0; padding: 10px; border: 1.5px solid var(--pc-rule,#C4C2BC); border-radius: 2px; background: #fff; color: inherit; min-width: 0; }
  .pond input:focus, .pond textarea:focus { outline: 2px solid var(--pond-green); outline-offset: 1px; }
  .pond button { font: 500 12px/1 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; padding: 12px 14px; border: 1.5px solid var(--pond-deep); background: var(--pond-green); color: #fff; border-radius: 2px; cursor: pointer; }
  .pond button[type=button] { background: #fff; color: var(--pond-deep); }
  .pond-hang-actions { display:flex; gap: 8px; flex-wrap: wrap; }
  .pond-status { font-size: 14px; color: var(--pc-ink-soft,#38373A); min-height: 1.4em; }
  .pond-water { position: relative; overflow: hidden; margin-top: 16px; background: radial-gradient(ellipse at 30% 20%, #EAF5EF, var(--pond-water) 60%, #BFDDD1); border: 1.5px solid var(--pond-deep); padding: 24px 16px; min-height: 180px; }
  .pond-ripples span { position:absolute; width: 120px; height: 40px; border: 1.5px solid rgba(30,74,58,.25); border-radius: 50%; animation: pond-ripple 6s ease-out infinite; }
  .pond-ripples span:nth-child(1) { left: 12%; top: 30%; }
  .pond-ripples span:nth-child(2) { left: 62%; top: 60%; animation-delay: 2s; }
  .pond-ripples span:nth-child(3) { left: 40%; top: 12%; animation-delay: 4s; }
  @keyframes pond-ripple { from { transform: scale(.3); opacity: .9; } to { transform: scale(2.2); opacity: 0; } }
  .pond-pads { position: relative; list-style: none; margin: 0; padding: 0; display:grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 16px; }
  .pond-pad { text-align: center; animation: pond-bob 4s ease-in-out infinite; }
  .pond-pad:nth-child(2n) { animation-delay: -1.3s; } .pond-pad:nth-child(3n) { animation-delay: -2.6s; }
  @keyframes pond-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  .pond-pad a { display:block; text-decoration: none; }
  .pond-pad img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; background: var(--pond-pad); border: 4px solid var(--pond-pad); box-shadow: 0 6px 0 rgba(30,74,58,.18); image-rendering: auto; }
  .pond-pad span { display:block; margin-top: 6px; font: 400 11px/1.2 var(--pc-font-mono, monospace); letter-spacing: .06em; color: var(--pond-deep); }
  .pond-wall { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .pond-frame { border: 1.5px solid var(--pc-ink,#12110E); padding: 8px; background: #fff; }
  .pond-frame img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; background: var(--pond-water); }
  .pond-frame h3 { font-size: 15px; font-weight: 500; margin: 8px 0 2px; }
  .pond-frame p { font: 400 11px/1.4 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .08em; color: var(--pc-ink-muted,#5F5E5A); margin: 0 0 8px; }
  .pond-frame a.pond-buy { display:block; text-align:center; font: 500 11px/1 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; padding: 10px; border: 1.5px solid var(--pond-deep); color: var(--pond-deep); text-decoration: none; }
  .pond-frame a.pond-buy:hover { background: var(--pond-water); }
  .pond-show-by { font: 400 12px/1.4 var(--pc-font-mono, monospace); text-transform: uppercase; letter-spacing: .08em; color: var(--pc-ink-soft,#38373A); }
  .pond-badge { display:inline-block; margin-left: 6px; padding: 2px 6px; background: var(--pond-green); color: #fff; font: 500 10px/1.4 var(--pc-font-mono, monospace); }
  .pond-show-note { font-size: 17px; font-style: italic; }
  .pond-rules ol { max-width: 68ch; line-height: 1.55; padding-left: 20px; }
  .pond-rules li { margin-bottom: 8px; }
  @media (max-width: 640px) {
    .pond-census { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .pond-census div:nth-child(2) { border-right: 0; }
    .pond-census div:nth-child(-n+2) { border-bottom: 1px solid var(--pc-rule-soft,#E5E3DE); }
    .pond-look { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .pond-pad, .pond-ripples span { animation: none; } }
</style>

<script>
  const OBJKT = 'https://data.objkt.com/v3/graphql';
  const TZ = /^tz[1-4][1-9A-HJ-NP-Za-km-z]{33}$/;
  const MAX_FROGS = 8;

  type Tok = { token_id: string; name?: string | null; thumbnail_uri?: string | null; display_uri?: string | null; listings_active?: { price: number }[] };

  async function gql<T>(query: string, variables: Record<string, unknown> = {}): Promise<T> {
    const res = await fetch(OBJKT, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ query, variables }) });
    const json = await res.json();
    if (!res.ok || json.errors) throw new Error('objkt index unavailable');
    return json.data as T;
  }

  const tez = (mutez: number | null | undefined) => mutez == null ? '—' : `${(mutez / 1e6).toLocaleString(undefined, { maximumFractionDigits: mutez >= 1e9 ? 0 : 2 })} ꜩ`;
  const img = (uri?: string | null) => {
    const cid = (uri || '').replace(/^ipfs:\/\//, '').replace(/^ipfs\//, '');
    return cid ? `https://assets.objkt.media/file/assets-003/${cid}/artifact` : '';
  };
  const shortAddr = (a: string) => TZ.test(a) ? `${a.slice(0, 6)}…${a.slice(-4)}` : a;

  // Shows travel in the URL: base64url(JSON {t, n, by, ids}).
  type Show = { t: string; n: string; by: string; ids: string[] };
  function cleanShow(raw: Partial<Show>): Show | null {
    const ids = Array.from(new Set((raw.ids || []).map((x) => String(x).trim()).filter((x) => /^\d{1,5}$/.test(x)))).slice(0, MAX_FROGS);
    const t = String(raw.t || '').trim().slice(0, 60);
    if (!t || !ids.length) return null;
    return { t, n: String(raw.n || '').trim().slice(0, 280), by: String(raw.by || '').trim().slice(0, 40), ids };
  }
  function encodeShow(show: Show): string {
    const bytes = new TextEncoder().encode(JSON.stringify(show));
    let bin = ''; bytes.forEach((b) => { bin += String.fromCharCode(b); });
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function decodeShow(param: string | null): Show | null {
    if (!param) return null;
    try {
      const bin = atob(param.replace(/-/g, '+').replace(/_/g, '/'));
      return cleanShow(JSON.parse(new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)))));
    } catch { return null; }
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text != null) node.textContent = text;
    return node;
  }

  async function holderCount(contract: string, addr: string): Promise<number> {
    const d = await gql<{ token_holder: { quantity: number }[] }>(
      `query($c:String!,$a:String!){ token_holder(where:{holder_address:{_eq:$a}, quantity:{_gt:"0"}, token:{fa_contract:{_eq:$c}}}, limit:1){ quantity } }`,
      { c: contract, a: addr });
    return d.token_holder.length;
  }

  function mountPond() {
    const root = document.querySelector<HTMLElement>('[data-pond]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = '1';
    const C = root.dataset.contract!;
    const objktToken = (id: string) => `https://objkt.com/tokens/${C}/${id}`;

    // Census
    gql<{ fa: { items: number; owners: number; floor_price: number; volume_total: number }[] }>(
      `query($c:String!){ fa(where:{contract:{_eq:$c}}){ items owners floor_price volume_total } }`, { c: C })
      .then(({ fa }) => {
        const f = fa[0]; if (!f) return;
        const set = (k: string, v: string) => { const n = root.querySelector(`[data-pond-census] [data-k="${k}"]`); if (n) n.textContent = v; };
        set('items', f.items.toLocaleString()); set('owners', f.owners.toLocaleString());
        set('floor', tez(f.floor_price)); set('volume', tez(f.volume_total));
      })
      .catch(() => { root.querySelectorAll('[data-pond-census] dd').forEach((n) => { n.textContent = '—'; }); });

    // 01 · Your seat
    const look = root.querySelector<HTMLFormElement>('[data-pond-look]')!;
    const addrInput = look.querySelector<HTMLInputElement>('input')!;
    const seatStatus = root.querySelector<HTMLElement>('[data-pond-seat-status]')!;
    const water = root.querySelector<HTMLElement>('[data-pond-water]')!;
    const pads = root.querySelector<HTMLElement>('[data-pond-pads]')!;
    const hangBy = root.querySelector<HTMLInputElement>('[data-pond-hang] input[name=by]')!;
    const hangIds = root.querySelector<HTMLInputElement>('[data-pond-hang] input[name=ids]')!;

    async function lookIn(addr: string) {
      if (!TZ.test(addr)) { seatStatus.textContent = 'That doesn’t look like a Tezos address (tz1…, tz2…, tz3…, tz4…).'; return; }
      seatStatus.textContent = 'Looking in the pond…';
      try {
        const d = await gql<{ token_holder: { quantity: number; token: Tok }[] }>(
          `query($c:String!,$a:String!){ token_holder(where:{holder_address:{_eq:$a}, quantity:{_gt:"0"}, token:{fa_contract:{_eq:$c}}}, order_by:{token:{token_id:asc}}, limit:100){ quantity token{ token_id name thumbnail_uri } } }`,
          { c: C, a: addr });
        pads.replaceChildren();
        if (!d.token_holder.length) {
          water.hidden = true;
          seatStatus.replaceChildren(`No frogs at ${shortAddr(addr)} yet. `, Object.assign(el('a', '', 'See what’s on the floor →'), { href: `https://objkt.com/collections/${C}`, rel: 'noopener' }));
          return;
        }
        for (const h of d.token_holder) {
          const li = el('li', 'pond-pad');
          const a = Object.assign(el('a'), { href: objktToken(h.token.token_id), rel: 'noopener', title: h.token.name || '' });
          const im = Object.assign(el('img'), { src: img(h.token.thumbnail_uri), alt: h.token.name || `Froggo #${h.token.token_id}`, loading: 'lazy', width: 120, height: 120 });
          a.append(im, el('span', '', `#${h.token.token_id}`));
          li.append(a); pads.append(li);
        }
        water.hidden = false;
        const n = d.token_holder.length;
        seatStatus.textContent = `${shortAddr(addr)} has a seat: ${n} frog${n === 1 ? '' : 's'} in the pond. Hang a show with them below.`;
        if (!hangBy.value) hangBy.value = addr;
        if (!hangIds.value) hangIds.value = d.token_holder.slice(0, MAX_FROGS).map((h) => h.token.token_id).join(', ');
      } catch {
        seatStatus.textContent = 'The objkt index didn’t answer. Try again in a moment.';
      }
    }
    look.addEventListener('submit', (e) => { e.preventDefault(); void lookIn(addrInput.value.trim()); });

    // Signed-in Kukai/Temple/Umami → prefill + look.
    fetch('/api/auth/session', { credentials: 'same-origin' })
      .then((r) => r.ok ? r.json() : null)
      .then((s) => {
        const tz = s?.user?.identities?.find((i: { id?: string }) => TZ.test(String(i?.id || '')))?.id;
        if (tz && !addrInput.value) { addrInput.value = tz; void lookIn(tz); }
      })
      .catch(() => {});

    // 02 · On the wall
    const wall = root.querySelector<HTMLElement>('[data-pond-wall]')!;
    const wallStatus = root.querySelector<HTMLElement>('[data-pond-wall-status]')!;
    const showTitle = root.querySelector<HTMLElement>('[data-pond-show-title]')!;
    const showBy = root.querySelector<HTMLElement>('[data-pond-show-by]')!;
    const showNote = root.querySelector<HTMLElement>('[data-pond-show-note]')!;
    const showKicker = root.querySelector<HTMLElement>('[data-pond-show-kicker]')!;

    function hang(tokens: Tok[], curator: string) {
      wall.replaceChildren();
      tokens.forEach((t, i) => {
        const li = el('li', 'pond-frame');
        const im = Object.assign(el('img'), { src: img(t.thumbnail_uri), alt: t.name || `Froggo #${t.token_id}`, loading: 'lazy', width: 288, height: 288 });
        const price = t.listings_active?.[0]?.price;
        const buy = Object.assign(el('a', 'pond-buy', price != null ? `On objkt · ${tez(price)}` : 'View on objkt'), { href: objktToken(t.token_id), rel: 'noopener' });
        buy.dataset.curator = curator;
        li.append(im, el('h3', '', t.name || `Froggos #${t.token_id}`), el('p', '', `No. ${String(i + 1).padStart(2, '0')} · hung by ${curator}`), buy);
        wall.append(li);
      });
    }

    async function showFromUrl(show: Show) {
      showKicker.textContent = '02 · On the wall · a curated show';
      showTitle.textContent = show.t;
      showBy.textContent = `Curated by ${shortAddr(show.by || 'a guest')}`;
      if (show.n) { showNote.textContent = `“${show.n}”`; showNote.hidden = false; }
      wallStatus.textContent = 'Hanging frogs…';
      try {
        const d = await gql<{ token: Tok[] }>(
          `query($c:String!,$ids:[String!]){ token(where:{fa_contract:{_eq:$c}, token_id:{_in:$ids}}){ token_id name thumbnail_uri listings_active(order_by:{price:asc}, limit:1){ price } } }`,
          { c: C, ids: show.ids });
        const byId = new Map(d.token.map((t) => [t.token_id, t]));
        const ordered = show.ids.map((id) => byId.get(id)).filter(Boolean) as Tok[];
        hang(ordered, shortAddr(show.by || 'a guest'));
        const missing = show.ids.length - ordered.length;
        wallStatus.textContent = missing ? `${missing} frog number${missing === 1 ? '' : 's'} not found in the collection.` : '';
        if (TZ.test(show.by) && (await holderCount(C, show.by)) > 0) showBy.append(el('span', 'pond-badge', 'Holder'));
      } catch { wallStatus.textContent = 'The objkt index didn’t answer. The show link is fine, so reload in a moment.'; }
    }

    async function houseShow() {
      try {
        const d = await gql<{ listing_active: { price: number; token: Tok }[] }>(
          `query($c:String!){ listing_active(where:{fa_contract:{_eq:$c}}, order_by:{price:asc}, limit:24){ price token{ token_id name thumbnail_uri } } }`, { c: C });
        const seen = new Set<string>(); const picks: Tok[] = [];
        for (const l of d.listing_active) {
          if (seen.has(l.token.token_id)) continue;
          seen.add(l.token.token_id); picks.push({ ...l.token, listings_active: [{ price: l.price }] });
          if (picks.length === MAX_FROGS) break;
        }
        hang(picks, 'the house');
      } catch { wallStatus.textContent = 'The objkt index didn’t answer. Reload in a moment.'; }
    }

    const current = decodeShow(new URL(location.href).searchParams.get('show'));
    void (current ? showFromUrl(current) : houseShow());

    // 03 · Hang a show
    const hangForm = root.querySelector<HTMLFormElement>('[data-pond-hang]')!;
    const hangStatus = root.querySelector<HTMLOutputElement>('[data-pond-hang-status]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-pond-copy]')!;
    let lastLink = '';
    hangForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(hangForm);
      const show = cleanShow({ t: String(f.get('t')), n: String(f.get('n')), by: String(f.get('by')), ids: String(f.get('ids')).split(/[\s,]+/) });
      if (!show) { hangStatus.textContent = 'A show needs a title and at least one frog number.'; return; }
      lastLink = `${location.origin}/pond?show=${encodeShow(show)}`;
      history.pushState(null, '', `/pond?show=${encodeShow(show)}`);
      copyBtn.hidden = false;
      hangStatus.textContent = `Hung ${show.ids.length} frog${show.ids.length === 1 ? '' : 's'}. The wall above now shows your show.`;
      void showFromUrl(show);
      document.getElementById('show-title')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    copyBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(lastLink); hangStatus.textContent = 'Show link copied.'; }
      catch { hangStatus.textContent = lastLink; }
    });
  }

  mountPond();
  document.addEventListener('astro:page-load', mountPond);
</script>
