---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  AREA_NEXT_STEPS,
  LOCAL_AREAS,
  LOCAL_AREA_RADIUS,
  MEETUP_SERIES,
} from '../lib/localAreas';

const title = 'PointCast Areas';
const description =
  'New PointCast local areas inside the 25-mile participation radius: paddle exchange, Mike-led meetups, University of El Segundo, and Local Honey League.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/areas',
  name: title,
  description,
  url: 'https://pointcast.xyz/areas',
  hasPart: LOCAL_AREAS.map((area) => ({
    '@type': 'CreativeWork',
    '@id': `https://pointcast.xyz${area.path}`,
    name: area.name,
    description: area.description,
    url: `https://pointcast.xyz${area.path}`,
  })),
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/areas.json', title: 'PointCast Areas (JSON)' }]}
>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/local">local</a>
      <span aria-hidden="true">/</span>
      <span>areas</span>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">POINTCAST AREAS · 25-MILE PARTICIPATION LAYER</p>
        <h1>Four local rooms that can become real on a Saturday.</h1>
        <p>
          The 100-mile lens is still right for broadcast. These are tighter:
          paddles, events, courses, and league tables need repeat contact, court
          handoffs, and people who can actually show up.
        </p>
      </div>
      <figure class="radius" aria-label="25-mile PointCast participation radius">
        <svg viewBox="0 0 320 320" role="img" aria-labelledby="radius-title radius-desc">
          <title id="radius-title">25-mile participation radius</title>
          <desc id="radius-desc">A simple radius map centered on El Segundo with ocean, courts, and local area markers.</desc>
          <rect x="0" y="0" width="320" height="320" fill="#fbfbf8" />
          <rect x="0" y="0" width="112" height="320" fill="#d9eef1" />
          <path d="M112 0 C98 58 128 105 112 159 C97 211 124 258 106 320" fill="none" stroke="#185fa5" stroke-width="3" />
          <circle cx="160" cy="168" r="118" fill="none" stroke="#12110e" stroke-width="2" />
          <circle cx="160" cy="168" r="6" fill="#c95c2e" stroke="#12110e" stroke-width="2" />
          <path d="M160 168 L160 50" stroke="#12110e" stroke-width="2" stroke-dasharray="5 7" />
          <g fill="#12110e" font-family="monospace" font-size="11">
            <text x="135" y="38">25 MI</text>
            <text x="172" y="174">EL SEGUNDO</text>
            <text x="22" y="40">PACIFIC</text>
          </g>
          <g>
            <circle cx="143" cy="122" r="11" fill="#e7f4ef" stroke="#0f6258" stroke-width="2" />
            <circle cx="218" cy="132" r="11" fill="#eef4fa" stroke="#185fa5" stroke-width="2" />
            <circle cx="194" cy="216" r="11" fill="#fff4dc" stroke="#6f4f14" stroke-width="2" />
            <circle cx="119" cy="217" r="11" fill="#fff0bf" stroke="#9a5f0b" stroke-width="2" />
          </g>
        </svg>
        <figcaption>
          <strong>{LOCAL_AREA_RADIUS.label}</strong>
          <span>{LOCAL_AREA_RADIUS.radiusMiles} miles from El Segundo</span>
        </figcaption>
      </figure>
    </header>

    <section class="section" aria-labelledby="area-heading">
      <div class="section__head">
        <p class="kicker">THE AREAS</p>
        <h2 id="area-heading">Local programs with public doors.</h2>
      </div>
      <div class="areas">
        {LOCAL_AREAS.map((area) => (
          <article class="area" style={`--area-ink:${area.palette.ink}; --area-wash:${area.palette.wash}; --area-rule:${area.palette.rule};`}>
            <div class="area__top">
              <span>{area.kicker}</span>
              <span>{area.status}</span>
            </div>
            <h3>{area.name}</h3>
            <p class="area__noun">{area.noun}</p>
            <p>{area.description}</p>
            <ul>
              {area.actions.map((action) => <li>{action}</li>)}
            </ul>
            <a href={area.path}>Open {area.shortName} &rarr;</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section split" aria-labelledby="radius-heading">
      <div>
        <p class="kicker">RADIUS DECISION</p>
        <h2 id="radius-heading">Start at 25, keep 100 for broadcast.</h2>
        <p>{LOCAL_AREA_RADIUS.policy}</p>
      </div>
      <div class="rulebook">
        <p class="rulebook__label">first operating pass</p>
        <ol>
          {AREA_NEXT_STEPS.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="meetup-heading">
      <div class="section__head">
        <p class="kicker">CALENDAR SEEDS</p>
        <h2 id="meetup-heading">Meetups are the connective tissue.</h2>
      </div>
      <div class="series">
        {MEETUP_SERIES.map((series) => (
          <article class="series__item">
            <span>{series.cadence}</span>
            <h3>{series.title}</h3>
            <p>{series.format}</p>
            <small>{series.where} · {series.connectedArea}</small>
          </article>
        ))}
      </div>
    </section>

    <aside class="machine">
      <p class="kicker">MACHINE-READABLE</p>
      <a href="/areas.json">/areas.json</a>
    </aside>
  </div>
</BlockLayout>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 20px 88px;
  }

  .crumb,
  .kicker,
  .area__top,
  .series__item span,
  .rulebook__label {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--pc-ink-muted);
    margin-bottom: 24px;
  }

  .kicker {
    color: var(--pc-ink-muted);
    margin: 0 0 8px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 32px;
    align-items: center;
    padding-bottom: 30px;
    border-bottom: 2px solid var(--pc-ink);
  }

  .hero h1 {
    font-size: 48px;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 500;
    margin: 0 0 16px;
    max-width: 12ch;
  }

  .hero p {
    font-size: 17px;
    line-height: 1.55;
    color: var(--pc-ink-soft);
    margin: 0;
    max-width: 64ch;
  }

  .radius {
    margin: 0;
    border: 1px solid var(--pc-rule);
    background: #fff;
  }

  .radius svg {
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }

  .radius figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-top: 1px solid var(--pc-rule);
    font-size: 13px;
  }

  .radius figcaption span {
    color: var(--pc-ink-muted);
  }

  .section {
    padding: 34px 0;
    border-bottom: 1px solid var(--pc-rule-soft);
  }

  .section__head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    margin-bottom: 18px;
  }

  h2 {
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: 0;
    font-weight: 500;
    margin: 0;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .area {
    border: 1px solid var(--area-rule);
    background: var(--area-wash);
    padding: 16px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .area__top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--area-ink);
  }

  .area h3,
  .series__item h3 {
    font-size: 20px;
    line-height: 1.18;
    letter-spacing: 0;
    font-weight: 500;
    margin: 0;
  }

  .area__noun {
    color: var(--area-ink);
    font-family: var(--pc-font-mono);
    font-size: 12px;
    margin: 0;
  }

  .area p {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    color: var(--pc-ink-soft);
  }

  .area ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .area li {
    font-size: 12px;
    color: var(--area-ink);
    border: 1px solid currentColor;
    padding: 3px 6px;
    background: #fff;
  }

  .area a {
    margin-top: auto;
    color: var(--area-ink);
    font-weight: 500;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
    gap: 34px;
  }

  .split p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--pc-ink-soft);
  }

  .rulebook {
    border-left: 3px solid #c95c2e;
    padding-left: 18px;
  }

  .rulebook__label {
    color: #8a421e;
    margin: 0 0 8px;
  }

  .rulebook ol {
    margin: 0;
    padding-left: 22px;
  }

  .rulebook li {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 1.45;
  }

  .series {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .series__item {
    border-top: 3px solid var(--pc-ink);
    padding: 12px 0 0;
  }

  .series__item span,
  .series__item small {
    color: var(--pc-ink-muted);
  }

  .series__item p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
  }

  .series__item small {
    display: block;
    font-size: 12px;
    line-height: 1.4;
  }

  .machine {
    margin-top: 28px;
    padding: 16px;
    border: 1px solid var(--pc-rule);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero,
    .split {
      grid-template-columns: 1fr;
    }

    .radius {
      max-width: 420px;
    }

    .areas,
    .series {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .page {
      padding-inline: 16px;
    }

    .hero h1 {
      font-size: 34px;
      max-width: 100%;
    }

    .hero p {
      font-size: 15px;
    }

    .areas,
    .series {
      grid-template-columns: 1fr;
    }

    .section__head,
    .machine,
    .radius figcaption {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
