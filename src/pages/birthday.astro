---
/**
 * /birthday — Mike's birthday party invite, May 18 2026.
 *
 * A very mondrian california bistro interior (Midjourney --sref 56). Massive
 * avocado-green "6:30 pm" set over the booth. White underlined credits in the
 * corners. Photograph as canvas, type as architecture.
 *
 * Shipped 2026-05-16 — cc
 */
import BlockLayout from '../layouts/BlockLayout.astro';
---
<BlockLayout
  title="6:30 pm — May 18"
  description="Mike Hoydich birthday celebration. Ed's house, El Segundo. Monday May 18th, 6:30pm. 678 west palm avenue. Bring food and craft beer. Coors on tap."
  image="/images/birthday/bistro-2026-05-18.jpg"
>
  <main class="bday">
    <figure class="bday__card" aria-label="Birthday invite">
      <img
        class="bday__photo"
        src="/images/birthday/bistro-2026-05-18.jpg"
        alt="A very mondrian california bistro interior — purple booth, plants, palms outside"
        width="1024"
        height="1024"
      />
      <h1 class="bday__time">6:30 pm</h1>
      <div class="bday__corner bday__corner--left">
        <p><a href="#">mike hoydich birthday<br/>celebration</a></p>
        <p><a href="#">ed&rsquo;s house<br/>el segundo</a></p>
      </div>
      <div class="bday__corner bday__corner--right">
        <p><a href="#">monday may 18th<br/>bring food and craft beer</a></p>
        <p><a href="#">coors on tap</a></p>
        <p><a href="https://www.google.com/maps/search/?api=1&query=678+West+Palm+Avenue+El+Segundo+CA" target="_blank" rel="noopener">678 west palm avenue</a></p>
      </div>
    </figure>

    <aside class="bday__note">
      <p>kettle&rsquo;s on. coffee, on.</p>
      <p><a href="/">← pointcast</a></p>
    </aside>
  </main>
</BlockLayout>

<style>
  :global(body) { background: #0c0c0c; }

  .bday {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    gap: 1.5rem;
    background: #0c0c0c;
  }

  .bday__card {
    position: relative;
    width: min(100%, 900px);
    aspect-ratio: 1 / 1;
    margin: 0;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.04);
  }

  .bday__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bday__time {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -54%);
    margin: 0;
    font-family: 'Inter Variable', system-ui, -apple-system, sans-serif;
    font-weight: 900;
    font-size: clamp(4rem, 18vw, 11rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #87932a;
    text-shadow: 0 2px 0 rgba(0,0,0,0.08);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .bday__corner {
    position: absolute;
    bottom: clamp(0.6rem, 2.5%, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: 'Inter Variable', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: clamp(0.6rem, 1.3vw, 0.85rem);
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.55);
  }
  .bday__corner--left  { left:  clamp(0.8rem, 3%, 1.5rem); text-align: left; }
  .bday__corner--right { right: clamp(0.8rem, 3%, 1.5rem); text-align: right; }
  .bday__corner p { margin: 0; }
  .bday__corner a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .bday__corner a:hover { color: #fffbe6; }

  .bday__note {
    color: #aaa;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.75rem;
    text-align: center;
    line-height: 1.6;
  }
  .bday__note a { color: #ddd; text-decoration: underline; }
</style>
