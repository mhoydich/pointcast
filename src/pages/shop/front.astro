---
/**
 * /shop/front — served at the root of shop.pointcast.xyz.
 * The front of the PointCast Shop: every guide, every priced pick, the lanes,
 * the policy, and the machine-readable doors. Data: src/lib/shop-front.ts.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  SHOP_GUIDES, SHOP_PICKS, SHOP_LANES, SHOP_POLICY, SHOP_ENDPOINTS,
  SHOP_ORIGIN, SITE, LAUNCHED_ON,
} from '../../lib/shop-front';

const title = 'PointCast Shop';
const description = 'The PointCast Shop, from El Segundo: buying guides, desk reviews, the paddle register and every priced pick in one list. No paid links. Readable by people and agents.';
const guideTitle = Object.fromEntries(SHOP_GUIDES.map((g) => [g.id, g.title]));
const guideShort: Record<string, string> = { 'ai-work-life': 'AI', 'machine-room': 'Machines', 'ai-plans': 'AI plans', 'playstation-2026': 'PS5', 'home-robots': 'Robots', bags: 'Bags', 'modular-carry': 'Modular', 'lego-sets': 'LEGO', 'hummingbird-feeders': 'Feeders' };
const pickGuides = [...new Set(SHOP_PICKS.map((p) => p.guide))];
const priced = SHOP_PICKS.filter((p) => p.price !== null);
const band = (n: number | null) => (n === null ? 'unpriced' : n < 25 ? 'under25' : n < 100 ? 'under100' : 'over100');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SHOP_ORIGIN}/#page`,
      name: title,
      description,
      url: `${SHOP_ORIGIN}/`,
      isPartOf: { '@type': 'WebSite', name: 'PointCast', url: SITE },
      publisher: { '@type': 'Organization', name: 'PointCast', url: SITE, address: { '@type': 'PostalAddress', addressLocality: 'El Segundo', addressRegion: 'CA', addressCountry: 'US' } },
      datePublished: LAUNCHED_ON,
      hasPart: SHOP_GUIDES.map((g) => ({ '@type': 'Article', headline: g.title, url: SITE + g.href, dateModified: g.asOf, image: SITE + g.image })),
    },
    {
      '@type': 'ItemList',
      '@id': `${SHOP_ORIGIN}/#picks`,
      name: 'Every pick in the PointCast Shop',
      numberOfItems: SHOP_PICKS.length,
      itemListElement: SHOP_PICKS.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Product',
          name: p.name,
          brand: { '@type': 'Brand', name: p.brand },
          url: SITE + p.reviewUrl,
          ...(p.image ? { image: SITE + p.image } : {}),
          ...(p.price !== null ? { offers: { '@type': 'Offer', price: p.price.toFixed(2), priceCurrency: 'USD', url: p.url } } : {}),
        },
      })),
    },
  ],
};
---
<BlockLayout
  title={`${title} — guides, picks and the register | PointCast`}
  description={description}
  image="/images/shop-front/og.jpg"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/shop/front.json', title: 'PointCast Shop (JSON)' },
    { type: 'text/plain', href: '/shop/llms.txt', title: 'PointCast Shop for language models' },
  ]}
  immersive
>
  <div class="sf">
    <div class="ticker" aria-hidden="true"><div class="ticker__run">
      {Array.from({ length: 2 }).map(() => (<span>● OPEN · LAUNCH DAY · TUESDAY SEPTEMBER 29, 2026 · {SHOP_GUIDES.length} GUIDES · {SHOP_PICKS.length} PICKS · 0 PAID LINKS · FROM EL SEGUNDO · READ BY PEOPLE AND AGENTS ·&nbsp;</span>))}
    </div></div>
    <nav class="mast" aria-label="PointCast Shop">
      <a class="mast__brand" href="/">POINTCAST<span> SHOP</span></a>
      <a href="#guides">Guides</a><a href="#picks">Every pick</a><a href="#lanes">Lanes</a><a href="#agents">For agents</a>
    </nav>

    <main>
      <header class="hero">
        <div class="hero__copy">
          <p class="eyebrow">SHOP.POINTCAST.XYZ · OPENED {LAUNCHED_ON}</p>
          <h1>Things worth<br/>carrying <em>home.</em></h1>
          <p class="dek">PointCast’s shopping desk, from El Segundo. Buying guides you can trust, every price dated, and no paid links. Readable by people and agents.</p>
          <div class="hero__actions">
            <a class="btn btn--sun" href="#picks">See every pick →</a>
            <a class="btn" href="/reviews/bags">Today: Bags for a South Bay day</a>
          </div>
        </div>
        <figure class="hero__art">
          <span class="open-sign" aria-hidden="true">WE’RE<br/><b>OPEN</b></span>
          <img src="/images/bags/carry-kit.jpg" alt="Illustrated specimen sheet of bags, a cooler, a chair-ready duffel, keys, pickleballs and a phone on a lanyard" width="1200" height="1200" fetchpriority="high" />
          <figcaption>Illustration: Astra (Codex) for PointCast</figcaption>
        </figure>
      </header>

      <section class="stats" aria-label="The shop in numbers">
        <div><strong>{SHOP_GUIDES.length}</strong><span>guides & registers</span></div>
        <div><strong>{SHOP_PICKS.length}</strong><span>picks, {priced.length} with a dated price</span></div>
        <div><strong>{SHOP_GUIDES.find((g) => g.id === 'paddles')?.count}</strong><span>paddles in the register</span></div>
        <div><strong>0</strong><span>paid links</span></div>
      </section>

      <section id="guides" class="guides" aria-labelledby="guides-title">
        <div class="head"><p class="eyebrow">THE GUIDES</p><h2 id="guides-title">Start with a question,<br/>not a product.</h2></div>
        <div class="guide-grid">
          {SHOP_GUIDES.map((g, i) => (
            <article class:list={['guide', { 'guide--lead': i === 0 }]}>
              <a class="guide__img" href={g.href}><img src={g.image} alt={g.imageAlt} loading={i < 2 ? 'eager' : 'lazy'} /></a>
              <div class="guide__body">
                <p class="eyebrow">{g.kind} · {g.count} {g.countLabel} · {g.asOf}</p>
                <h3><a href={g.href}>{g.title}</a></h3>
                <p>{g.dek}</p>
                <p class="guide__links"><a href={g.href}>Read →</a>{g.json && <a class="mono" href={g.json}>JSON</a>}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="picks" class="picks" aria-labelledby="picks-title">
        <div class="head"><p class="eyebrow">EVERY PICK, ONE LIST</p><h2 id="picks-title">Everything we’d<br/>tell a friend to buy.</h2></div>
        <div class="filters" role="group" aria-label="Filter picks">
          <span class="filters__label mono">GUIDE</span>
          <button type="button" data-guide="all" aria-pressed="true">All</button>
          {pickGuides.map((g) => <button type="button" data-guide={g} aria-pressed="false">{guideShort[g] ?? g}</button>)}
          <span class="filters__label mono">PRICE</span>
          <button type="button" data-band="all" aria-pressed="true">Any</button>
          <button type="button" data-band="under25" aria-pressed="false">Under $25</button>
          <button type="button" data-band="under100" aria-pressed="false">$25–99</button>
          <button type="button" data-band="over100" aria-pressed="false">$100+</button>
        </div>
        <p id="pick-count" class="fine" aria-live="polite">Showing all {SHOP_PICKS.length} picks.</p>
        <ol class="pick-list">
          {SHOP_PICKS.map((p) => (
            <li class="pick" data-guide={p.guide} data-band={band(p.price)}>
              <a class="pick__img" href={p.reviewUrl} tabindex="-1" aria-hidden="true">{p.image ? <img src={p.image} alt="" loading="lazy" /> : <span class="pick__noimg mono">{p.brand.slice(0, 2).toUpperCase()}</span>}</a>
              <div class="pick__main">
                <p class="eyebrow">{p.brand} · <a href={p.reviewUrl}>{guideShort[p.guide] ?? guideTitle[p.guide]}</a></p>
                <h3><a href={p.reviewUrl}>{p.name}</a></h3>
                <p class="pick__verdict">{p.verdict}</p>
              </div>
              <div class="pick__buy">
                <strong>{p.price === null ? p.priceText : p.priceText}</strong>
                <a href={p.url} rel="noopener noreferrer">At the maker ↗</a>
              </div>
            </li>
          ))}
        </ol>
        <p class="fine">* See the guide for the note on that price. Prices are US list prices checked on each guide’s date; the maker’s page is the truth.</p>
      </section>

      <section id="lanes" class="lanes" aria-labelledby="lanes-title">
        <div class="head"><p class="eyebrow">THE LANES</p><h2 id="lanes-title">Where the rest<br/>of the shop lives.</h2></div>
        <ul class="lane-grid">
          {SHOP_LANES.map((l) => <li><a href={l.href}><strong>{l.label} →</strong><span>{l.note}</span></a></li>)}
        </ul>
      </section>

      <section class="policy" aria-labelledby="policy-title">
        <p class="eyebrow">HOW THIS SHOP WORKS</p>
        <h2 id="policy-title">Four rules.</h2>
        <ol>{SHOP_POLICY.map((rule) => <li>{rule}</li>)}</ol>
      </section>

      <section class="making" aria-labelledby="making-title">
        <p class="eyebrow">ON THE WORKBENCH</p>
        <h2 id="making-title">One strap for the whole day.</h2>
        <p>Every bag in the bags guide has its own strap, its own clip, and its own idea of where the phone goes. We’re studying the companies that solved this with a system: one strap, one clip, pods that hook on and off, a chair that clips to the kit. Nothing is for sale yet. If you’d carry it, say so on <a href="/shortwave">Shortwave</a>.</p>
        <p><a class="btn btn--sun" href="/reviews/bags#missing-title">Read the idea →</a></p>
      </section>

      <section id="agents" class="agents" aria-labelledby="agents-title">
        <div>
          <p class="eyebrow">FOR AGENTS</p>
          <h2 id="agents-title">Shop with an agent.</h2>
          <p>Every guide publishes its picks, prices, caveats and sources as JSON with open CORS. Start with the shop file; it links the rest. Please cite the guide and its date when you quote a price.</p>
        </div>
        <div>
          <ul>{SHOP_ENDPOINTS.map((e) => <li><a class="mono" href={e.href}>{e.href}</a><span>{e.label}</span></li>)}</ul>
          <pre class="mono"><code>curl -s https://pointcast.xyz/shop/front.json | jq '.picks[] | {'{'}name, priceText, url{'}'}'</code></pre>
        </div>
      </section>

      <footer class="foot">
        <p>PointCast Shop · El Segundo, California · opened {LAUNCHED_ON}</p>
        <p><a href="/">PointCast</a> · <a href="/reviews">Review Lab</a> · <a href="/shop">Catalog</a> · <a href="/paddles">Paddle Register</a></p>
      </footer>
    </main>
  </div>
</BlockLayout>
<script>
  const init = () => {
    const root = document.querySelector('.sf'); if (!root || root.hasAttribute('data-ready')) return; root.setAttribute('data-ready', 'true');
    let guide = 'all'; let band = 'all';
    const picks = [...root.querySelectorAll<HTMLElement>('.pick')];
    const apply = () => {
      let n = 0;
      picks.forEach((p) => { const show = (guide === 'all' || p.dataset.guide === guide) && (band === 'all' || p.dataset.band === band); p.hidden = !show; if (show) n++; });
      root.querySelectorAll<HTMLButtonElement>('[data-guide]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.guide === guide)));
      root.querySelectorAll<HTMLButtonElement>('[data-band]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.band === band)));
      const out = root.querySelector('#pick-count'); if (out) out.textContent = n === picks.length ? `Showing all ${n} picks.` : `Showing ${n} of ${picks.length} picks.`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-guide]').forEach((b) => b.addEventListener('click', () => { guide = b.dataset.guide || 'all'; apply(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-band]').forEach((b) => b.addEventListener('click', () => { band = b.dataset.band || 'all'; apply(); }));
  };
  init(); document.addEventListener('astro:page-load', init);
</script>
<style>
  :global(body) { margin: 0; background: #e9e9e4; color: #111; }
  .sf { --ink:#111; --paper:#e9e9e4; --card:#f6f6f2; --cobalt:#1f3fe0; --sun:#f6d615; --red:#e8401c; --line:#b9b9b1; font-family: Arial, Helvetica, sans-serif; color: var(--ink); background: var(--paper); }
  .sf * { box-sizing: border-box; }
  .sf a { color: inherit; }
  .mono { font-family: ui-monospace, Menlo, monospace; }
  .eyebrow { font: 700 11px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 1.6px; text-transform: uppercase; margin: 0 0 14px; }
  .fine { font-size: 12px; line-height: 1.6; color: #4a4a44; }
  main { max-width: 1440px; margin: auto; }

  .ticker { background: var(--ink); color: var(--sun); overflow: hidden; white-space: nowrap; font: 700 11px/30px ui-monospace, Menlo, monospace; letter-spacing: 1.5px; }
  .ticker__run { display: inline-block; animation: sf-tick 40s linear infinite; }
  @keyframes sf-tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__run { animation: none; } }

  .mast { display: flex; gap: 22px; align-items: center; padding: 18px 5vw; border-bottom: 1px solid var(--ink); font-size: 12px; font-weight: 800; flex-wrap: wrap; }
  .mast a { text-decoration: none; }
  .mast__brand { margin-right: auto; font-size: 20px; letter-spacing: -1px; }
  .mast__brand span { color: var(--cobalt); }

  .hero { display: grid; grid-template-columns: 1.1fr 1fr; border-bottom: 1px solid var(--ink); }
  .hero__copy { padding: 64px 6vw 56px; display: flex; flex-direction: column; justify-content: center; }
  h1 { font-size: clamp(56px, 7.4vw, 116px); line-height: .9; letter-spacing: -.065em; margin: 18px 0 26px; }
  h1 em { font-family: Georgia, serif; font-weight: 400; color: var(--cobalt); }
  .dek { font-size: 20px; line-height: 1.45; max-width: 34ch; margin: 0 0 28px; }
  .hero__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 12px 18px; border: 1px solid var(--ink); font-size: 13px; font-weight: 700; text-decoration: none; background: transparent; }
  .btn--sun { background: var(--sun); }
  .btn:hover { background: #fff; }
  .hero__art { position: relative; margin: 0; background: #fff; border-left: 1px solid var(--ink); padding: 34px; display: flex; flex-direction: column; justify-content: center; }
  .hero__art img { width: 100%; height: auto; display: block; }
  .hero__art figcaption { font: 10px ui-monospace, Menlo, monospace; letter-spacing: 1px; text-align: center; margin-top: 14px; }
  .open-sign { position: absolute; top: 16px; left: 16px; z-index: 1; background: var(--red); color: #fff; border: 3px solid var(--ink); padding: 10px 14px; font: 700 11px/1.1 ui-monospace, Menlo, monospace; letter-spacing: 2px; transform: rotate(-6deg); box-shadow: 4px 4px 0 var(--ink); }
  .open-sign b { font-size: 26px; letter-spacing: 1px; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--ink); background: var(--card); }
  .stats div { padding: 22px 5vw 22px 24px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .stats div:first-child { padding-left: 6vw; }
  .stats div:last-child { border-right: 0; }
  .stats strong { font-size: 40px; letter-spacing: -2px; color: var(--cobalt); }
  .stats span { font-size: 13px; color: #3c3c37; }

  .head { border-top: 4px solid var(--ink); padding-top: 22px; }
  h2 { font-size: clamp(30px, 4.2vw, 56px); line-height: 1.02; letter-spacing: -.05em; margin: 0 0 28px; }
  .guides, .picks, .lanes { padding: 64px 6vw 0; }

  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .guide { background: var(--card); border: 1px solid var(--ink); display: flex; flex-direction: column; min-width: 0; }
  .guide--lead { grid-column: span 2; flex-direction: row; }
  .guide__img { display: block; background: #fff; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--ink); }
  .guide--lead .guide__img { aspect-ratio: auto; flex: 1 1 50%; border-bottom: 0; border-right: 1px solid var(--ink); }
  .guide__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .guide__body { padding: 18px 20px 20px; flex: 1 1 50%; }
  .guide__body .eyebrow { color: var(--cobalt); }
  .guide h3 { font-size: 24px; line-height: 1.1; letter-spacing: -.8px; margin: 0 0 10px; }
  .guide--lead h3 { font-size: 34px; }
  .guide h3 a { text-decoration: none; }
  .guide__body > p { font-size: 15px; line-height: 1.55; margin: 0 0 12px; }
  .guide__links { display: flex; gap: 16px; font-weight: 700; font-size: 13px; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
  .filters__label { font-size: 11px; font-weight: 700; letter-spacing: 1.4px; margin: 0 4px 0 8px; }
  .filters__label:first-child { margin-left: 0; }
  .filters button { font: 700 12px Arial; cursor: pointer; padding: 10px 15px; min-height: 44px; border: 1px solid var(--ink); border-radius: 30px; background: transparent; color: var(--ink); }
  .filters button[aria-pressed="true"] { background: var(--cobalt); border-color: var(--cobalt); color: #fff; }
  .pick-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .pick { display: grid; grid-template-columns: 88px 1fr auto; gap: 18px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .pick[hidden] { display: none; }
  .pick__img { width: 88px; height: 88px; background: #fff; border: 1px solid #d6d6cf; display: grid; place-items: center; overflow: hidden; }
  .pick__img img { width: 100%; height: 100%; object-fit: contain; }
  .pick__noimg { font-size: 22px; font-weight: 700; color: var(--cobalt); }
  .pick__main .eyebrow { margin-bottom: 4px; color: #55554f; }
  .pick__main h3 { font-size: 19px; margin: 0 0 4px; letter-spacing: -.4px; }
  .pick__main h3 a { text-decoration: none; }
  .pick__verdict { margin: 0; font-size: 14px; line-height: 1.5; color: #33332f; max-width: 70ch; }
  .pick__buy { text-align: right; display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
  .pick__buy strong { font-size: 18px; white-space: nowrap; }
  .pick__buy a { font-size: 12px; font-weight: 700; white-space: nowrap; }

  .lane-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .lane-grid a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px; border: 1px solid var(--ink); background: var(--card); text-decoration: none; }
  .lane-grid a:hover { background: var(--sun); }
  .lane-grid strong { font-size: 16px; }
  .lane-grid span { font-size: 13px; line-height: 1.5; color: #3c3c37; }

  .policy { margin: 64px 6vw 0; padding: 36px 0 0; border-top: 4px solid var(--ink); }
  .policy ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; counter-reset: rule; }
  .policy li { counter-increment: rule; font-size: 15px; line-height: 1.55; }
  .policy li::before { content: counter(rule, decimal-leading-zero); display: block; font: 700 28px ui-monospace, Menlo, monospace; color: var(--cobalt); margin-bottom: 8px; }

  .making { margin: 64px 6vw 0; padding: 40px; background: var(--cobalt); color: #fff; }
  .making .eyebrow { color: var(--sun); }
  .making p { font-size: 17px; line-height: 1.6; max-width: 70ch; }
  .making a:not(.btn) { color: var(--sun); }
  .making .btn { color: var(--ink); }

  .agents { margin: 64px 6vw 0; padding: 40px; background: var(--ink); color: var(--paper); display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; }
  .agents .eyebrow { color: var(--sun); }
  .agents p { font-size: 16px; line-height: 1.6; }
  .agents ul { list-style: none; margin: 0 0 18px; padding: 0; }
  .agents li { display: flex; flex-direction: column; gap: 2px; padding: 10px 0; border-bottom: 1px solid #3a3a36; }
  .agents li a { color: var(--sun); font-size: 14px; }
  .agents li span { font-size: 13px; color: #c8c8c0; }
  .agents pre { margin: 0; padding: 14px; background: #1e1e1b; font-size: 12px; white-space: pre-wrap; word-break: break-all; }

  .foot { padding: 40px 6vw 60px; font-size: 13px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

  a:focus-visible, button:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }

  @media (max-width: 1100px) {
    .guide-grid { grid-template-columns: 1fr 1fr; }
    .lane-grid { grid-template-columns: repeat(3, 1fr); }
    .policy ol { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .mast { padding: 14px 16px; gap: 14px; }
    .mast__brand { width: 100%; }
    .hero { grid-template-columns: 1fr; }
    .hero__copy { padding: 36px 16px; }
    .hero__art { border-left: 0; border-top: 1px solid var(--ink); padding: 56px 16px 18px; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stats div, .stats div:first-child { padding: 16px; border-bottom: 1px solid var(--line); }
    .stats div:nth-child(2) { border-right: 0; }
    .stats strong { font-size: 30px; }
    .guides, .picks, .lanes { padding: 44px 16px 0; }
    .guide-grid { grid-template-columns: 1fr; }
    .guide--lead { grid-column: auto; flex-direction: column; }
    .guide--lead .guide__img { aspect-ratio: 1 / 1; border-right: 0; border-bottom: 1px solid var(--ink); }
    .guide--lead h3 { font-size: 26px; }
    .pick { grid-template-columns: 64px 1fr; gap: 12px; }
    .pick__img { width: 64px; height: 64px; }
    .pick__buy { grid-column: 2; flex-direction: row; justify-content: space-between; align-items: center; text-align: left; }
    .lane-grid { grid-template-columns: 1fr; }
    .policy, .making, .agents { margin: 44px 16px 0; }
    .policy ol { grid-template-columns: 1fr; }
    .making, .agents { padding: 28px 20px; }
    .agents { grid-template-columns: 1fr; gap: 10px; }
    .foot { padding: 32px 16px 48px; }
  }
</style>
