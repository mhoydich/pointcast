---
import PuzzleFrame from '../../components/PuzzleFrame.astro';

const publishers = [
  {
    name: 'Ravensburger',
    category: 'A broad starting point',
    formats: 'Large Format · adult jigsaws · 3D/photo routes',
    description: 'The jigsaw catalogue includes a Larger Puzzle Pieces filter and 300-, 500- and 750-piece Large Format choices. The site also links 3D and custom-photo routes. Useful when grip and finished size matter as much as the picture.',
    lookFor: 'Check the individual puzzle’s piece count, finished dimensions and age label.',
    url: 'https://www.ravensburger.us/en-US/products/jigsaw-puzzles',
    mark: '01',
  },
  {
    name: 'Galison',
    category: 'Illustration at the table',
    formats: '500 · 1000 pieces',
    description: 'An art and gift publisher with artist-designed puzzles and distinct 500- and 1000-piece categories. A place to browse illustration, city scenes and pattern-led designs.',
    lookFor: 'Choose a picture with regions you can recognize after it is cut into pieces.',
    url: 'https://www.galison.com/',
    mark: '02',
  },
  {
    name: 'Cloudberries',
    category: 'Find your kind of challenge',
    formats: '50 · 100 · 500 · 1000 pieces',
    description: 'The catalogue separates easy and hard themes, gradients, abstract designs, and ribbon and random cuts. Those filters make a useful comparison of image difficulty and cut style.',
    lookFor: 'A lower piece count can still be difficult when colours or patterns repeat.',
    url: 'https://cloudberries.co.uk/',
    mark: '03',
  },
  {
    name: 'Pomegranate',
    category: 'An art collection in pieces',
    formats: '120–2000 pieces · circular · double-sided',
    description: 'Browse puzzles by artist and piece count, with circular and double-sided examples in the collection. Useful for discovering an artwork and then choosing how to spend time with it.',
    lookFor: 'Check whether the finished shape fits the board or frame you already own.',
    url: 'https://www.pomegranate.com/collections/puzzles',
    mark: '04',
  },
  {
    name: 'JIGGY',
    category: 'Meet the artist',
    formats: '450 · 500 · 800 pieces · puzzle club',
    description: 'A catalogue built around credited artists, alongside personalized puzzles and a recurring puzzle club. Useful for comparing an individual edition with a subscription model.',
    lookFor: 'Read renewal and cancellation terms before choosing a recurring plan.',
    url: 'https://jiggypuzzles.com/',
    mark: '05',
  },
  {
    name: 'eeBoo Piece & Love',
    category: 'Illustrated worlds',
    formats: 'Adult 500 · 1000 pieces',
    description: 'The Piece & Love range has 500- and 1000-piece routes and theme browsing, including botanical and magical worlds. The site also carries separate children’s puzzle ranges.',
    lookFor: 'Keep the adult range and the child’s age-appropriate product label distinct.',
    url: 'https://eeboo.com/collections/puzzles',
    mark: '06',
  },
  {
    name: 'Piecework',
    category: 'A playful still life',
    formats: '1000 pieces · selected 300-piece gift sets',
    description: 'Browse staged scenes, food, leisure and home-life subjects. The official catalogue includes 1000-piece puzzles and selected 300-piece gift sets for a different session length.',
    lookFor: 'Inspect the image for visual landmarks as well as its colour palette.',
    url: 'https://pieceworkpuzzles.com/',
    mark: '07',
  },
  {
    name: 'Springbok',
    category: 'A familiar puzzle night',
    formats: '500-piece examples · seasonal scenes',
    description: 'The official store shows seasonal, food and landscape subjects, including a range of 500-piece examples. It also links its customer-care, store-finder and shipping-and-return pages.',
    lookFor: 'Use the retailer’s current support and return policy when comparing sellers.',
    url: 'https://www.springbok-puzzles.com/',
    mark: '08',
  },
  {
    name: 'Artifact Puzzles',
    category: 'Explore the wooden cut',
    formats: 'Wood · art · varied piece counts',
    description: 'An official shop for wooden art puzzles, with ranges including Artifact, Ecru, Stumpcraft and Mr. Gogo. Its catalogue distinguishes their finishes and manufacturing origins and lets you browse by count and difficulty.',
    lookFor: 'Read the selected puzzle’s material, cut, dimensions and origin rather than assuming every range is alike.',
    url: 'https://www.artifactpuzzles.com/',
    mark: '09',
  },
];
---

<PuzzleFrame title="Puzzle shop" description="A PointCast directory of official puzzle publishers, a practical buying guide, and original puzzle concepts to explore." active="shop">
  <section class="p-section shop-hero" aria-labelledby="shop-title">
    <div>
      <p class="eyebrow">PointCast Store / Curated puzzle links</p>
      <h1 id="shop-title">Find your next<br />tableful.</h1>
      <p class="p-lead">A picture you want to live with. A challenge that fits your evening. A box worth passing to a friend.</p>
      <p class="shop-intro">Start with the official publishers below, then buy on their sites. This is an editorial directory: PointCast does not take payment or fulfil these orders. The ten original PointCast concepts are ideas in development and are not for sale.</p>
      <div class="shop-actions">
        <a class="p-button" href="#publishers">Browse 9 publishers <span aria-hidden="true">↘</span></a>
        <a class="p-button" href="/puzzles/#concepts">See our 10 concepts <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="shop-note" aria-label="Start with four questions">
      <p class="eyebrow">Before the box</p>
      <ol>
        <li><span>01</span> How much table space?</li>
        <li><span>02</span> How large are the pieces?</li>
        <li><span>03</span> How much repeated colour?</li>
        <li><span>04</span> One session or a slow project?</li>
      </ol>
      <p>The piece count is only one part of the choice.</p>
    </aside>
  </section>

  <section class="p-section" aria-labelledby="choose-title">
    <p class="eyebrow">Choose the experience</p>
    <h2 id="choose-title">What do you want from the table?</h2>
    <div class="p-grid chooser-grid">
      <article class="p-card">
        <h3>A gentle first session</h3>
        <p>Look for distinct objects, several colour zones, generous piece size and a finished size you can leave out. Compare Ravensburger’s Larger Puzzle Pieces filter or Cloudberries’ 50- and 100-piece categories. Suit the choice to the person.</p>
        <a href="#publisher-ravensburger">Compare large-piece formats <span aria-hidden="true">→</span></a>
      </article>
      <article class="p-card">
        <h3>A picture to linger over</h3>
        <p>Choose an artist or subject you enjoy exploring. Treat the box image as a map: consider whether you want a busy illustrated world, a photographic still life or a reproduction of an artwork.</p>
        <a href="#publisher-pomegranate">Explore Pomegranate’s art range <span aria-hidden="true">→</span></a>
      </article>
      <article class="p-card">
        <h3>Something unfamiliar</h3>
        <p>Try a different cut or outline, a circular image, a double-sided puzzle or a 3D format. Check the product’s instructions and final dimensions; these choices change the solving experience.</p>
        <a href="#publisher-ravensburger">Browse Ravensburger’s formats <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="p-section" id="publishers" aria-labelledby="publishers-title">
    <div class="section-line">
      <div>
        <p class="eyebrow">Source-linked directory</p>
        <h2 id="publishers-title">Nine doors into puzzles.</h2>
      </div>
      <p class="shop-date">Official catalogues checked<br /><time datetime="2026-10-03">3 October 2026</time></p>
    </div>
    <p class="directory-note">The links on each card are also its source. Formats describe what was visible on the official catalogue when checked; they do not promise availability. Browse the retailer’s current product and policy pages for price, stock, destination coverage, taxes, delivery and returns. Listing a publisher here does not imply a partnership.</p>
    <div class="p-grid publisher-grid">
      {publishers.map((publisher) => (
        <article class="p-card publisher" id={`publisher-${publisher.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '')}`}>
          <div class="publisher-top"><span class="publisher-number" aria-hidden="true">{publisher.mark}</span><p class="eyebrow">{publisher.category}</p></div>
          <h3>{publisher.name}</h3>
          <p class="publisher-formats">{publisher.formats}</p>
          <p>{publisher.description}</p>
          <p class="publisher-tip"><strong>Before you choose:</strong> {publisher.lookFor}</p>
          <a class="p-button" href={publisher.url} target="_blank" rel="noopener noreferrer">Visit official {publisher.name} site <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="p-section" aria-labelledby="buy-check-title">
    <p class="eyebrow">A useful buying checklist</p>
    <h2 id="buy-check-title">A good fit starts before checkout.</h2>
    <div class="p-grid">
      <article class="p-card"><h3>Read the physical details</h3><p>Measure your surface against the finished dimensions. Look for actual piece size, board or wood material, surface finish and the supplied reference image. “Large pieces” and a low piece count are different details.</p></article>
      <article class="p-card"><h3>Choose for the person</h3><p>Ask about grip, vision, preferred challenge and the amount of time available. High contrast, recognizable landmarks, a matte finish and a large reference image are useful things to compare. An accessibility label is not a substitute for the person’s preference.</p></article>
      <article class="p-card"><h3>Check the seller’s terms</h3><p>Compare the delivered total, the return window, treatment of opened boxes, and missing-piece or damaged-box support. Personalized items and subscriptions may have different terms. Keep the order details and box batch code if there is one.</p></article>
      <article class="p-card"><h3>Plan a second life</h3><p>Rebag the complete pieces and keep the box image when sharing a used puzzle. Label any known missing pieces. If you want to frame it, check the dimensions and the adhesive’s instructions before making the change permanent.</p></article>
    </div>
  </section>

  <section class="p-section shop-concepts" aria-labelledby="pointcast-concepts-title">
    <div>
      <p class="eyebrow">PointCast / Original studies</p>
      <h2 id="pointcast-concepts-title">Maybe we make our own.</h2>
      <p class="p-lead">Ten original visual directions, each with a story, an audience and a proposed piece plan.</p>
      <p>These are concept artworks, not inventory, preorders or production-ready products. Explore the collection, see how a puzzle is made, and work through the economics before choosing a pilot.</p>
    </div>
    <div class="shop-actions">
      <a class="p-button" href="/puzzles/#concepts">Explore the 10 concepts <span aria-hidden="true">→</span></a>
      <a class="p-button" href="/puzzles/make/">From art to physical proof <span aria-hidden="true">→</span></a>
      <a class="p-button" href="/puzzles/business/">Study the business plan <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PuzzleFrame>

<style>
  h1 { margin: .35rem 0 1.35rem; font-size: clamp(3rem, 6.3vw, 6.7rem); line-height: .98; letter-spacing: -.065em; font-weight: 500; }
  h2 { max-width: 22ch; }
  .shop-hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 4rem; align-items: end; }
  .shop-intro, .directory-note { max-width: 70ch; line-height: 1.65; }
  .shop-note { border: 1px solid currentColor; padding: clamp(1.5rem, 3vw, 2.4rem); background: #e9f4ed; }
  .shop-note ol { list-style: none; margin: 2rem 0; padding: 0; }
  .shop-note li { padding: 1rem 0; border-top: 1px solid #b8cbc0; font-size: 1.03rem; }
  .shop-note li:last-child { border-bottom: 1px solid #b8cbc0; }
  .shop-note li span { margin-right: 1.1rem; font: .8rem var(--pc-font-mono); color: #45624e; }
  .shop-note > p:last-child { font-size: .9rem; line-height: 1.55; margin-bottom: 0; }
  .shop-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .section-line { display: flex; justify-content: space-between; gap: 2rem; align-items: end; }
  .shop-date { font: .78rem/1.5 var(--pc-font-mono); text-align: right; flex-shrink: 0; }
  .directory-note { margin: 1.2rem 0 2rem; font-size: .94rem; }
  .publisher-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .publisher { display: flex; flex-direction: column; scroll-margin-top: 2rem; }
  .publisher-top { display: flex; gap: .9rem; align-items: center; }
  .publisher-number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid #b4c6b9; border-radius: 50%; font: .75rem var(--pc-font-mono); flex-shrink: 0; }
  .publisher-top .eyebrow { margin: 0; }
  .publisher h3 { font-size: 1.75rem; letter-spacing: -.04em; margin-bottom: .35rem; }
  .publisher-formats { margin-top: 0; color: #46634f; font: .8rem/1.6 var(--pc-font-mono); }
  .publisher-tip { font-size: .9rem; line-height: 1.55; border-top: 1px solid #d9e4dd; padding-top: 1rem; margin-top: auto; }
  .publisher .p-button { align-self: start; margin-top: .4rem; }
  .shop-concepts { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; background: #e9f4ed; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid #b4c6b9; }
  .shop-concepts .shop-actions { flex-direction: column; align-items: start; justify-content: center; margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) { .shop-hero, .shop-concepts { grid-template-columns: 1fr; gap: 2rem; } .publisher-grid { grid-template-columns: 1fr; } .section-line { flex-direction: column; align-items: start; gap: .4rem; } .shop-date { text-align: left; } }
</style>
