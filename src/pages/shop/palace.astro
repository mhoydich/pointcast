---
import BaseLayout from '../../layouts/BaseLayout.astro';

const variations = [
  {
    name: 'Counter Tee',
    kind: 'tee',
    accent: '#ff4c35',
    shade: '#20160c',
    note: 'Ink-black cotton energy, imaginary run, no checkout.',
  },
  {
    name: 'Southbank Hoodie',
    kind: 'hoodie',
    accent: '#325dc7',
    shade: '#f5df4d',
    note: 'Blue tape sleeve blocks, heavy on the weather.',
  },
  {
    name: 'Tri-Corner Deck',
    kind: 'deck',
    accent: '#31a66a',
    shade: '#20160c',
    note: 'Three-corner geometry, not a logo, just a shove-it diagram.',
  },
  {
    name: 'Queue Beanie',
    kind: 'beanie',
    accent: '#ff7a1a',
    shade: '#efe7d6',
    note: 'Warm head, cold pavement, waiting outside for no reason.',
  },
  {
    name: 'Static Scarf',
    kind: 'scarf',
    accent: '#d83aa2',
    shade: '#20160c',
    note: 'Football scarf meets VHS tracking issue.',
  },
  {
    name: 'Sticker Sheet',
    kind: 'stickers',
    accent: '#8dd8ff',
    shade: '#20160c',
    note: 'Pixel labels for bins, boards, laptops, lampposts.',
  },
];
---

<BaseLayout
  title="Palace Capsule Study"
  description="A PointCast concept product page in a London skate-shop register. Not affiliated with Palace Skateboards. No checkout, no prices, no real product imagery."
>
  <div class="palace-page">
    <a class="back-link" href="/shop">Shop</a>

    <section class="hero" aria-labelledby="palace-title">
      <div class="hero-copy">
        <p class="eyebrow">Concept page / aesthetic study</p>
        <h1 id="palace-title">PointCast x Palace-aesthetic capsule that fell off the back of a server rack.</h1>
        <p>
          Six imaginary goods for the person who says "just browsing" and then
          opens twelve tabs. London skate-shop voltage, El Segundo broadcast
          warmth, zero claim that this is real commerce.
        </p>

        <div class="hero-actions">
          <a class="buy-link" href="/reads/palace">Buy button, but it reads the note</a>
          <a class="ghost-link" href="#lookbook">Lookbook</a>
        </div>

        <aside class="disclaimer" aria-label="Concept disclaimer">
          <strong>Concept only.</strong>
          This page is not affiliated with, endorsed by, or connected to Palace
          Skateboards. No real Palace logos, product photography, inventory, or
          checkout are used here. Read the cultural note at
          <a href="/reads/palace">/reads/palace</a>.
        </aside>
      </div>

      <article class="product-hero" data-hero-card>
        <div class="tape-row">
          <span>PAL STUDY 09</span>
          <span>SP</span>
          <span data-tape-time>11:00 UK</span>
        </div>

        <div class="product-art product-art--tee" data-hero-art>
          <div class="triangle-field" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="garment garment--tee" aria-hidden="true">
            <span>POINT</span>
            <span>CAST</span>
          </div>
          <div class="scanlines" aria-hidden="true"></div>
        </div>

        <div class="product-caption">
          <p class="eyebrow">Launch object</p>
          <h2 data-hero-title>Counter Tee</h2>
          <p data-hero-note>Ink-black cotton energy, imaginary run, no checkout.</p>
          <div class="price-row">
            <span>Price</span>
            <strong>concept only</strong>
          </div>
        </div>
      </article>
    </section>

    <section id="lookbook" class="lookbook" aria-labelledby="lookbook-title">
      <div class="section-head">
        <p class="eyebrow">Lookbook</p>
        <h2 id="lookbook-title">Six things from the non-drop.</h2>
      </div>

      <div class="lookbook-grid">
        {variations.map((item, index) => (
          <button
            class="look-card"
            type="button"
            style={`--accent:${item.accent}; --shade:${item.shade};`}
            data-name={item.name}
            data-kind={item.kind}
            data-note={item.note}
            aria-label={`Preview ${item.name}`}
          >
            <span class="look-card__number">{String(index + 1).padStart(2, '0')}</span>
            <span class={`mini-art mini-art--${item.kind}`} aria-hidden="true">
              <svg viewBox="0 0 180 180" role="img">
                <rect width="180" height="180" fill="var(--accent)" />
                <path d="M0 30H180M0 70H180M0 110H180M0 150H180" stroke="var(--shade)" stroke-width="10" opacity="0.42" />
                <path d="M30 152L90 28L150 152Z" fill="none" stroke="var(--shade)" stroke-width="9" stroke-linejoin="round" />
                <rect x="52" y="64" width="76" height="76" fill="var(--shade)" opacity="0.9" />
                <path d="M64 84H116M64 104H116M64 124H116" stroke="var(--accent)" stroke-width="8" />
              </svg>
            </span>
            <span class="look-card__name">{item.name}</span>
            <span class="look-card__meta">concept only</span>
          </button>
        ))}
      </div>
    </section>

    <section class="copy-block" aria-labelledby="copy-title">
      <p class="eyebrow">Ad copy recovered from a damp printer</p>
      <h2 id="copy-title">Wear it to the shop. Wear it to the tab you forgot was playing audio.</h2>
      <p>
        Proper gear for loitering near a brilliant idea. The tee says nothing
        useful. The deck has opinions. The hoodie looks like it owes the bus
        driver an apology. If anyone asks what the triangle means, tell them it
        is a queue seen from above.
      </p>
    </section>

    <section class="schedule" aria-labelledby="schedule-title">
      <div>
        <p class="eyebrow">Drop schedule</p>
        <h2 id="schedule-title">Friday 11am UK time. Limited. Don't ask.</h2>
      </div>
      <p>
        Calendar energy only. No live sale, no checkout, no claimed quantity.
        The page is a stage mark for a possible future product lane.
      </p>
    </section>

    <footer class="final-disclaimer">
      <strong>Not affiliated with Palace Skateboards.</strong>
      This is a PointCast concept page and aesthetic study. It uses original
      placeholder SVG/CSS art, generic three-corner composition, and no real
      Palace marks or product photography. Context lives at
      <a href="/reads/palace">/reads/palace</a>.
    </footer>
  </div>

  <script is:inline>
    (() => {
      const cards = document.querySelectorAll('.look-card');
      const art = document.querySelector('[data-hero-art]');
      const title = document.querySelector('[data-hero-title]');
      const note = document.querySelector('[data-hero-note]');
      const tape = document.querySelector('[data-tape-time]');

      const stamps = ['11:00 UK', 'SP MODE', 'TRACKING', 'NO CART', 'CONCEPT'];
      let stampIndex = 0;

      window.setInterval(() => {
        if (!tape) return;
        stampIndex = (stampIndex + 1) % stamps.length;
        tape.textContent = stamps[stampIndex];
      }, 1400);

      cards.forEach((card) => {
        card.addEventListener('click', () => {
          const kind = card.getAttribute('data-kind') || 'tee';
          if (title) title.textContent = card.getAttribute('data-name') || 'Capsule object';
          if (note) note.textContent = card.getAttribute('data-note') || 'Concept only.';
          if (art) {
            art.className = `product-art product-art--${kind}`;
          }

          cards.forEach((item) => item.removeAttribute('aria-pressed'));
          card.setAttribute('aria-pressed', 'true');
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .palace-page {
    min-height: 100vh;
    padding: 28px clamp(16px, 4vw, 48px) 72px;
    color: #f6ebd9;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 76, 53, 0.22), transparent 30%),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 4px),
      linear-gradient(135deg, #15120f 0%, #20160c 52%, #2b1b16 100%);
  }

  .back-link,
  .eyebrow,
  .hero-actions a,
  .disclaimer,
  .tape-row,
  .price-row,
  .look-card,
  .final-disclaimer {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 28px;
    color: rgba(246, 235, 217, 0.7);
    font-size: 0.68rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: #ff4c35;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 480px);
    gap: clamp(24px, 6vw, 72px);
    align-items: center;
    width: min(100%, 1180px);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #f5df4d;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .hero h1 {
    margin: 0;
    max-width: 760px;
    color: #fff7e8;
    font-family: Syne, Impact, sans-serif;
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    font-weight: 700;
    line-height: 0.88;
  }

  .hero-copy > p {
    max-width: 640px;
    color: rgba(246, 235, 217, 0.78);
    font-size: clamp(1rem, 2vw, 1.14rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 18px;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 13px 16px;
    border: 2px solid #f6ebd9;
    border-radius: 0;
    font-size: 0.65rem;
    text-decoration: none;
  }

  .buy-link {
    background: #f6ebd9;
    color: #20160c;
  }

  .ghost-link {
    color: #f6ebd9;
  }

  .hero-actions a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 #ff4c35;
  }

  .disclaimer {
    max-width: 690px;
    padding: 14px 16px;
    border: 2px solid rgba(246, 235, 217, 0.45);
    background: rgba(0, 0, 0, 0.28);
    color: rgba(246, 235, 217, 0.82);
    font-size: 0.62rem;
    line-height: 1.65;
  }

  .disclaimer strong,
  .final-disclaimer strong {
    color: #f5df4d;
  }

  .disclaimer a,
  .final-disclaimer a {
    color: #8dd8ff;
  }

  .product-hero {
    border: 3px solid #f6ebd9;
    background: #f6ebd9;
    color: #20160c;
    box-shadow: 12px 12px 0 #ff4c35;
    transform: rotate(1.25deg);
  }

  .tape-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: #20160c;
    color: #f6ebd9;
    font-size: 0.6rem;
  }

  .product-art {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(32, 22, 12, 0.14) 50%, transparent 50%) 0 0 / 22px 22px,
      #ff4c35;
  }

  .product-art--hoodie { background-color: #325dc7; }
  .product-art--deck { background-color: #31a66a; }
  .product-art--beanie { background-color: #ff7a1a; }
  .product-art--scarf { background-color: #d83aa2; }
  .product-art--stickers { background-color: #8dd8ff; }

  .triangle-field {
    position: absolute;
    inset: 36px;
  }

  .triangle-field span {
    position: absolute;
    width: 190px;
    height: 190px;
    border: 12px solid #20160c;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    opacity: 0.9;
  }

  .triangle-field span:nth-child(1) {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .triangle-field span:nth-child(2) {
    left: 12px;
    bottom: 18px;
    transform: rotate(-8deg);
  }

  .triangle-field span:nth-child(3) {
    right: 12px;
    bottom: 18px;
    transform: rotate(8deg);
  }

  .garment {
    position: absolute;
    left: 50%;
    bottom: 42px;
    transform: translateX(-50%) rotate(-2deg);
    width: 230px;
    height: 245px;
    background: #20160c;
    color: #f6ebd9;
    display: grid;
    place-content: center;
    gap: 2px;
    clip-path: polygon(22% 0, 78% 0, 100% 22%, 82% 40%, 82% 100%, 18% 100%, 18% 40%, 0 22%);
    font-family: Syne, Impact, sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 0.86;
    text-align: center;
  }

  .product-art--hoodie .garment {
    border-radius: 45% 45% 12px 12px;
    clip-path: polygon(28% 0, 72% 0, 88% 15%, 100% 34%, 84% 47%, 84% 100%, 16% 100%, 16% 47%, 0 34%, 12% 15%);
  }

  .product-art--deck .garment {
    width: 116px;
    height: 310px;
    border-radius: 60px;
    clip-path: none;
  }

  .product-art--beanie .garment {
    width: 260px;
    height: 150px;
    border-radius: 130px 130px 18px 18px;
    clip-path: none;
  }

  .product-art--scarf .garment {
    width: 340px;
    height: 105px;
    clip-path: none;
  }

  .product-art--stickers .garment {
    width: 260px;
    height: 260px;
    clip-path: polygon(12% 0, 88% 0, 100% 12%, 100% 88%, 88% 100%, 12% 100%, 0 88%, 0 12%);
  }

  .scanlines {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 5px),
      radial-gradient(rgba(255, 255, 255, 0.38) 1px, transparent 1px);
    background-size: auto, 7px 7px;
    mix-blend-mode: multiply;
    opacity: 0.36;
    pointer-events: none;
  }

  .product-caption {
    padding: 20px;
  }

  .product-caption h2 {
    margin: 0;
    font-family: Syne, Impact, sans-serif;
    font-size: 2.1rem;
    line-height: 0.95;
  }

  .product-caption p {
    margin: 10px 0 16px;
    color: rgba(32, 22, 12, 0.68);
    line-height: 1.55;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 13px;
    border-top: 2px solid rgba(32, 22, 12, 0.18);
    font-size: 0.62rem;
  }

  .price-row strong {
    color: #ff4c35;
  }

  .lookbook,
  .copy-block,
  .schedule,
  .final-disclaimer {
    width: min(100%, 1180px);
    margin: 72px auto 0;
  }

  .section-head h2,
  .copy-block h2,
  .schedule h2 {
    margin: 0;
    color: #fff7e8;
    font-family: Syne, Impact, sans-serif;
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 0.95;
  }

  .lookbook-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
  }

  .look-card {
    display: grid;
    gap: 12px;
    padding: 12px;
    border: 2px solid #f6ebd9;
    background: #20160c;
    color: #f6ebd9;
    text-align: left;
    cursor: pointer;
  }

  .look-card:hover,
  .look-card[aria-pressed="true"] {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--accent);
  }

  .look-card__number,
  .look-card__meta {
    font-size: 0.58rem;
    color: rgba(246, 235, 217, 0.68);
  }

  .mini-art {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid rgba(246, 235, 217, 0.38);
  }

  .mini-art svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .look-card__name {
    font-size: 0.82rem;
    font-weight: 800;
  }

  .copy-block {
    padding: clamp(22px, 5vw, 46px);
    border: 3px solid #f5df4d;
    background:
      repeating-linear-gradient(90deg, rgba(245, 223, 77, 0.12) 0 18px, transparent 18px 36px),
      rgba(0, 0, 0, 0.22);
  }

  .copy-block p {
    max-width: 760px;
    color: rgba(246, 235, 217, 0.8);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .schedule {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 360px);
    gap: 24px;
    align-items: end;
    padding-top: 26px;
    border-top: 3px solid #f6ebd9;
  }

  .schedule p {
    margin: 0;
    color: rgba(246, 235, 217, 0.78);
    line-height: 1.65;
  }

  .final-disclaimer {
    padding: 16px;
    border: 2px solid rgba(246, 235, 217, 0.42);
    color: rgba(246, 235, 217, 0.78);
    font-size: 0.62rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .hero,
    .schedule {
      grid-template-columns: 1fr;
    }

    .product-hero {
      transform: none;
    }

    .lookbook-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .palace-page {
      padding-inline: 12px;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 15vw, 4.4rem);
    }

    .product-art {
      min-height: 340px;
    }

    .garment {
      width: 190px;
      height: 212px;
      font-size: 1.75rem;
    }

    .triangle-field span {
      width: 138px;
      height: 138px;
      border-width: 9px;
    }

    .lookbook-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
