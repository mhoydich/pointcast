---
/**
 * /shop/stall — the cozy alternate to /shop.
 *
 * Where /shop is the production commerce hub (Good Feels SKUs, mood pairings,
 * structured catalog), /shop/stall is the slow shelf: PointCast objects,
 * Tezos drops, concept studies, and one open ask. Sprint 4 opener.
 * Commissioned via mcp__codex (read-only), eighth codex burn this run.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const guideSeed = 417;
const guideImage = `https://noun.pics/${guideSeed}.svg`;

const stateKey = [
  {
    label: 'Live',
    tone: 'live',
    note: 'Actually open, contract known, no invented counts.',
  },
  {
    label: 'Pending',
    tone: 'pending',
    note: 'Staged, waiting on the chain step.',
  },
  {
    label: 'Concept',
    tone: 'concept',
    note: 'A sketch with a table tag, not checkout.',
  },
  {
    label: 'Queued',
    tone: 'queued',
    note: 'Written down, not yet on the counter.',
  },
] as const;

const products = [
  {
    title: 'Palace, the London brand',
    code: 'PAL',
    state: 'concept',
    stateLabel: 'Concept',
    href: '/shop/palace',
    shape: 'palace',
    accent: '#a34f2a',
    tone: '#fff1e4',
    price: 'concept only',
    priceNote: 'no checkout, no affiliation, no stock',
    dek: 'A streetwear and inspiration study for a cross-brand idea that belongs on a mood board before it belongs on a hanger.',
    facts: [
      'streetwear / inspiration / cross-brand collab idea',
      'Sprint 3 concept page, already staged',
    ],
    cta: 'open concept page',
  },
  {
    title: 'Coffee Mugs FA2',
    code: 'MUG',
    state: 'pending',
    stateLabel: 'Minting soon',
    href: '/coffee',
    shape: 'mug',
    accent: '#23758a',
    tone: '#e5f6f8',
    price: 'free mint planned + gas',
    priceNote: 'drop pending origination per Sprint 4 brief',
    dek: 'Five small mug tokens for the coffee room, with the pot still on and the shelf waiting for Mike signing.',
    facts: [
      'source: contracts/v2/coffee_mugs_fa2.py',
      'coffee room stays the front counter for now',
    ],
    cta: 'visit coffee room',
  },
  {
    title: 'Visit Nouns FA2',
    code: 'VST',
    state: 'live',
    stateLabel: 'Live',
    href: '/drops',
    shape: 'noun',
    accent: '#1d748e',
    tone: '#e8f4f8',
    price: 'free mint + gas',
    priceNote: 'open-supply seeds 0-1199',
    dek: 'The live PointCast Nouns lane on Tezos, already originated and used as the public seed shelf.',
    facts: [
      'KT1LP1oTBuudRubAYQDErH7i7mSwazVdohxh',
      'open-supply Noun seeds 0-1199',
    ],
    cta: 'see drops',
  },
  {
    title: 'Drum Token',
    code: 'DRM',
    state: 'queued',
    stateLabel: 'Queued',
    href: '/drum',
    shape: 'drum',
    accent: '#8d8a84',
    tone: '#f0efeb',
    price: 'not listed',
    priceNote: 'attention coin, no sale table yet',
    dek: 'An FA1.2 attention coin for the drum room, still in the queue and not pretending otherwise.',
    facts: [
      'FA1.2 token lane',
      'claim flow follows the drum room later',
    ],
    cta: 'open drum room',
  },
  {
    title: 'Prize Cast',
    code: 'CST',
    state: 'queued',
    stateLabel: 'Queued',
    href: '/cast',
    shape: 'ticket',
    accent: '#7f827f',
    tone: '#f2f2ef',
    price: 'no sale',
    priceNote: 'written, not compiled yet',
    dek: 'A no-loss savings and prize idea with the front room built, the contract written, and the compile step still ahead.',
    facts: [
      'contract source written',
      'mainnet origination not live',
    ],
    cta: 'read cast room',
  },
  {
    title: 'What should we make next?',
    code: 'ASK',
    state: 'ask',
    stateLabel: 'Open ask',
    href: '/ask',
    shape: 'ask',
    accent: '#6f5b46',
    tone: '#fff7ea',
    price: 'one clear note',
    priceNote: 'plain text is enough',
    dek: 'The last tile is just an index card at the edge of the table, waiting for the next small thing.',
    facts: [
      'suggest an object, drop, room, or token',
      'the shelf is allowed to stay irregular',
    ],
    cta: 'leave an ask',
  },
] as const;
---

<BaseLayout
  title="The PointCast Stall"
  description="A small PointCast stall hub: slow goods, concept objects, Tezos drops, and a few things waiting on the shelf. Sister surface to /shop (the production catalog)."
>
  <div class="shop-stall">
    <nav class="crumb mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a>
      <span aria-hidden="true">/</span>
      <a href="/shop">shop</a>
      <span aria-hidden="true">/</span>
      <span>stall</span>
    </nav>

    <header class="hero" aria-labelledby="shop-title">
      <div class="hero__copy">
        <p class="kicker mono">small things, hand-staged.</p>
        <h1 id="shop-title">The PointCast Stall</h1>
        <p class="lede">
          A slow shelf for PointCast goods, chain objects, and half-real product
          studies. Things show up here because somebody wanted to make them,
          not because a launch calendar got hungry. Sister surface to
          <a href="/shop">/shop</a>, which carries the production catalog.
        </p>
        <p class="stall-clock mono" data-stall-clock>slow shelf / table open</p>
      </div>

      <figure class="guide" aria-label="Noun guide at the shop stall">
        <div class="guide__awning" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="guide__seat">
          <img
            src={guideImage}
            alt={`Noun seed ${guideSeed}, the shop guide`}
            width="160"
            height="160"
            loading="eager"
            decoding="async"
          />
          <span class="guide__stool" aria-hidden="true"></span>
        </div>
        <figcaption>
          Seed {guideSeed} has the merchant stool today. Watching the table,
          not hovering over anyone.
        </figcaption>
      </figure>
    </header>

    <section class="state-board" aria-label="Shop state key">
      <p class="state-board__label mono">table tags</p>
      <ul role="list">
        {stateKey.map((item) => (
          <li>
            <span class={`state-chip state-chip--${item.tone}`}>{item.label}</span>
            <p>{item.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="products" aria-labelledby="products-title">
      <div class="section-head">
        <p class="section-head__kicker mono">six things on the cloth</p>
        <h2 id="products-title">Browse the stall.</h2>
      </div>

      <ul class="product-grid" role="list">
        {products.map((item) => (
          <li class="product-item">
            <a
              class={`product-card product-card--${item.state}`}
              href={item.href}
              data-shape={item.shape}
              style={`--accent: ${item.accent}; --tone: ${item.tone};`}
            >
              <span class="product-card__top">
                <span class={`state-chip state-chip--${item.state}`}>
                  {item.stateLabel}
                </span>
                <span class="product-card__code mono">{item.code}</span>
              </span>

              <span class="product-card__object" aria-hidden="true">
                <span class="product-card__shadow"></span>
                <span class="product-card__mark mono">{item.code}</span>
                <span class="product-card__tag"></span>
              </span>

              <span class="product-card__body">
                <span class="product-card__kind mono">{item.shape}</span>
                <span class="product-card__title">{item.title}</span>
                <span class="product-card__dek">{item.dek}</span>
              </span>

              <span class="price-line">
                <span class="mono">price</span>
                <strong>{item.price}</strong>
              </span>
              <span class="price-note">{item.priceNote}</span>

              <ul class="fact-list" role="list">
                {item.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>

              <span class="product-card__cta mono">{item.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <aside class="counter-note" aria-label="Shop posture note">
      <p class="mono">merchant note</p>
      <h2>No pressure at the counter.</h2>
      <p>
        Some of this is chain work, some of it is design play, and some of it
        is just a label on a box we might come back to. The point is to keep the
        shelf legible without pretending everything is ready.
      </p>
    </aside>

    <footer class="stall-footer">
      <p>
        <em>
          the stall is small. the shelf restocks slowly. nothing here is trying
          to be your daily driver.
        </em>
      </p>
    </footer>

    <script is:inline>
      (() => {
        const stamp = document.querySelector('[data-stall-clock]');
        if (!stamp) return;

        const hour = new Date().getHours();
        if (hour < 10) {
          stamp.textContent = 'setting out the cloth';
        } else if (hour < 15) {
          stamp.textContent = 'stall open / sun on the tags';
        } else if (hour < 19) {
          stamp.textContent = 'late table / still browsing';
        } else {
          stamp.textContent = 'lamps on / shelf quiet';
        }
      })();
    </script>
  </div>
</BaseLayout>

<style>
  .shop-stall {
    --sand: #f2e3cb;
    --paper: #fffaf1;
    --paper-deep: #f7eddc;
    --ink: #191611;
    --ink-soft: #453c32;
    --muted: #75695d;
    --rule: #d8c6aa;
    --ocean: #23758a;
    --rust: #a34f2a;
    --soft-gray: #8d8a84;
    --live: #2f7455;
    --ask: #6f5b46;

    min-height: 100vh;
    padding: 24px clamp(16px, 4vw, 48px) 78px;
    color: var(--ink);
    background:
      linear-gradient(180deg, rgba(255, 250, 241, 0.92), rgba(242, 227, 203, 0.96)),
      repeating-linear-gradient(
        90deg,
        rgba(163, 79, 42, 0.08) 0 18px,
        rgba(255, 250, 241, 0.1) 18px 36px
      );
    font-family: Lora, Georgia, serif;
  }

  .shop-stall *,
  .shop-stall *::before,
  .shop-stall *::after {
    box-sizing: border-box;
  }

  .shop-stall a {
    color: inherit;
  }

  .mono {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(100%, 1120px);
    margin: 0 auto 30px;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .crumb a {
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .crumb a:hover {
    color: var(--rust);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 320px);
    gap: 34px;
    align-items: end;
    width: min(100%, 1120px);
    margin: 0 auto 28px;
    padding-bottom: 34px;
    border-bottom: 2px solid var(--ink);
  }

  .hero__copy {
    max-width: 760px;
  }

  .kicker {
    margin: 0 0 14px;
    color: var(--rust);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hero h1 {
    margin: 0;
    max-width: 11ch;
    font-family: Syne, Lora, Georgia, serif;
    font-size: 3.45rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .lede {
    max-width: 62ch;
    margin: 20px 0 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .lede a {
    color: var(--ocean);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .stall-clock {
    display: inline-flex;
    margin: 22px 0 0;
    padding: 8px 0 0;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.68rem;
  }

  .guide {
    position: relative;
    margin: 0;
    padding: 18px 16px 16px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 250, 241, 0.88), rgba(247, 237, 220, 0.92));
    box-shadow: 0 14px 32px rgba(25, 22, 17, 0.08);
  }

  .guide__awning {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 18px;
    margin: -6px 0 18px;
    border: 1px solid rgba(25, 22, 17, 0.16);
    border-radius: 6px 6px 2px 2px;
    overflow: hidden;
  }

  .guide__awning span:nth-child(1),
  .guide__awning span:nth-child(3) {
    background: #f3d7bd;
  }

  .guide__awning span:nth-child(2) {
    background: #fff7ea;
  }

  .guide__seat {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 190px;
  }

  .guide__seat img {
    position: relative;
    z-index: 2;
    width: min(150px, 70%);
    height: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 10px 0 rgba(25, 22, 17, 0.1));
  }

  .guide__stool {
    position: absolute;
    left: 50%;
    bottom: 20px;
    width: 112px;
    height: 68px;
    transform: translateX(-50%);
    border: 2px solid rgba(25, 22, 17, 0.72);
    border-top-width: 8px;
    border-radius: 8px 8px 4px 4px;
    background:
      linear-gradient(90deg, transparent 16px, rgba(25, 22, 17, 0.5) 16px 19px, transparent 19px 93px, rgba(25, 22, 17, 0.5) 93px 96px, transparent 96px),
      #d7b889;
  }

  .guide figcaption {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .state-board {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    width: min(100%, 1120px);
    margin: 0 auto 30px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .state-board__label {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .state-board ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .state-board li {
    min-width: 0;
  }

  .state-board p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .state-chip {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: var(--paper);
    color: var(--muted);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .state-chip--live {
    color: var(--live);
    background: #eef8ef;
  }

  .state-chip--pending {
    color: var(--ocean);
    background: #e8f6f8;
  }

  .state-chip--concept {
    color: var(--rust);
    background: #fff1e4;
  }

  .state-chip--queued {
    color: var(--soft-gray);
    background: #f2f2ef;
  }

  .state-chip--ask {
    color: var(--ask);
    background: #fff7ea;
  }

  .products {
    width: min(100%, 1120px);
    margin: 0 auto;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .section-head__kicker {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .section-head h2 {
    margin: 0;
    font-family: Syne, Lora, Georgia, serif;
    font-size: 1.7rem;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-item {
    min-width: 0;
  }

  .product-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 250, 241, 0.9), rgba(255, 250, 241, 0.72)),
      var(--tone);
    text-decoration: none;
    box-shadow: 0 10px 22px rgba(25, 22, 17, 0.07);
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      border-color 0.16s ease;
  }

  .product-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 16px 30px rgba(25, 22, 17, 0.11);
  }

  .product-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .product-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .product-card__code {
    color: color-mix(in srgb, var(--accent) 78%, var(--ink));
    font-size: 0.72rem;
    font-weight: 700;
  }

  .product-card__object {
    position: relative;
    display: grid;
    min-height: 114px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(25, 22, 17, 0.18);
    border-radius: 6px;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.42) 0 12px,
        rgba(255, 255, 255, 0.08) 12px 24px
      ),
      var(--tone);
  }

  .product-card__object::before {
    position: absolute;
    inset: 12px;
    border: 1px dashed color-mix(in srgb, var(--accent) 42%, transparent);
    border-radius: 5px;
    content: "";
  }

  .product-card__shadow {
    position: absolute;
    right: 22px;
    bottom: 17px;
    left: 22px;
    height: 14px;
    border-radius: 999px;
    background: rgba(25, 22, 17, 0.12);
  }

  .product-card__mark {
    position: relative;
    z-index: 2;
    display: grid;
    width: 72px;
    height: 72px;
    place-items: center;
    border: 3px solid var(--accent);
    border-radius: 7px;
    background: var(--paper);
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 700;
    box-shadow: 8px 8px 0 rgba(25, 22, 17, 0.1);
  }

  .product-card__tag {
    position: absolute;
    top: 18px;
    right: 20px;
    width: 34px;
    height: 24px;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background:
      linear-gradient(90deg, transparent 0 12px, var(--accent) 12px 13px, transparent 13px),
      var(--paper);
    transform: rotate(7deg);
  }

  .product-card[data-shape="palace"] .product-card__mark {
    transform: skew(-6deg) rotate(-2deg);
  }

  .product-card[data-shape="mug"] .product-card__mark {
    border-radius: 8px 8px 18px 18px;
  }

  .product-card[data-shape="mug"] .product-card__mark::after {
    position: absolute;
    right: -18px;
    width: 18px;
    height: 28px;
    border: 3px solid var(--accent);
    border-left: 0;
    border-radius: 0 12px 12px 0;
    content: "";
  }

  .product-card[data-shape="noun"] .product-card__mark {
    border-radius: 4px;
    box-shadow:
      0 0 0 8px rgba(35, 117, 138, 0.08),
      8px 8px 0 rgba(25, 22, 17, 0.1);
  }

  .product-card[data-shape="drum"] .product-card__mark {
    border-radius: 50%;
  }

  .product-card[data-shape="ticket"] .product-card__mark {
    border-style: dashed;
    transform: rotate(2deg);
  }

  .product-card[data-shape="ask"] .product-card__mark {
    width: 88px;
    border-radius: 3px;
    transform: rotate(-3deg);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .product-card__kind {
    color: color-mix(in srgb, var(--accent) 78%, var(--muted));
    font-size: 0.64rem;
    font-weight: 700;
  }

  .product-card__title {
    color: var(--ink);
    font-family: Syne, Lora, Georgia, serif;
    font-size: 1.3rem;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .product-card__dek {
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .price-line {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 10px;
    align-items: baseline;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(25, 22, 17, 0.14);
  }

  .price-line span {
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .price-line strong {
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .price-note {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .fact-list {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact-list li {
    position: relative;
    padding-left: 14px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .fact-list li::before {
    position: absolute;
    left: 0;
    color: var(--accent);
    content: "";
    width: 5px;
    height: 5px;
    top: 0.58em;
    border-radius: 50%;
    background: currentColor;
  }

  .product-card__cta {
    display: inline-flex;
    width: fit-content;
    margin-top: 2px;
    color: color-mix(in srgb, var(--accent) 82%, var(--ink));
    font-size: 0.68rem;
    font-weight: 700;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .counter-note {
    width: min(100%, 1120px);
    margin: 28px auto 0;
    padding: 24px 0 0;
    border-top: 2px solid var(--ink);
  }

  .counter-note > p:first-child {
    margin: 0 0 8px;
