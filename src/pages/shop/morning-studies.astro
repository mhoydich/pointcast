---
import BlockLayout from '../../layouts/BlockLayout.astro';
const title = 'Morning Studies — Hoydich Advertising | PointCast';
const description = 'Explore bright, retro-inspired art directions and request a quote for a brand-free or rights-cleared print edition or an original commission. No checkout or payment on this page.';
const canonical = 'https://pointcast.xyz/shop/morning-studies/';
const inquiry = 'mailto:hello@pointcast.xyz?subject=Morning%20Studies%20purchase%20inquiry&body=I%20would%20like%20a%20quote%20for%20a%20brand-free%20or%20rights-cleared%20Morning%20Studies%20edition.%0A%0ATheme%3A%0AFormat%20and%20size%3A%0AQuantity%3A%0ADelivery%20country%3A%0A%0AI%20understand%20this%20is%20an%20inquiry%2C%20not%20an%20order.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, about: { '@type': 'CreativeWork', name: 'Morning Studies', genre: 'Independent AI-assisted visual studies' }, publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' } };
---
<BlockLayout title={title} description={description} image="/images/morning-studies/concept-preview.avif" imageAlt="Unofficial AI-generated retro breakfast advertising concept board; reference only, not branded merchandise for sale." jsonLd={jsonLd} themeColor="#f5efe2" immersive isolated includeManifest={false} alternates={[{ type: 'application/json', href: '/shop/morning-studies/catalog.json', title: 'Morning Studies inquiry catalog' }]}>
  <main class="ms">
    <nav class="ms-nav" aria-label="Breadcrumb"><a class="ms-logo" href="/">PointCast<span aria-hidden="true">↗</span></a><span>HOYDICH ADVERTISING / STUDIO 001</span><a href="/shop">Back to the shop</a></nav>
    <header class="ms-hero">
      <div><p class="ms-kicker">MORNING STUDIES · PRINT &amp; COMMISSION INQUIRIES</p><h1>Good mornings.<br /><em>Better walls.</em></h1><p class="ms-dek">Coastal light. A court after breakfast. A little more colour in the day.</p><p class="ms-intro">Choose a direction. Ask about a print or a new piece. We agree the finished artwork, rights, format and full price before there is an order.</p><a class="ms-button" href="#inquire">Request a quote <span aria-hidden="true">↗</span></a><p class="ms-small">By quotation. No payment or automatic booking.</p></div>
      <aside class="ms-ticket" aria-label="The studio offer"><span class="ms-ticket-top">SOMETHING FOR YOUR WALL</span><div class="ms-sun" aria-hidden="true"></div><p class="ms-ticket-title">A brighter<br />point of view.</p><dl><div><dt>01 / A print</dt><dd>One finished piece</dd></div><div><dt>02 / A series</dt><dd>A small, connected set</dd></div><div><dt>03 / A commission</dt><dd>Something made for you</dd></div></dl><span class="ms-ticket-end">ART FIRST. TERMS BEFORE PAYMENT.</span></aside>
    </header>
    <section class="ms-study" aria-labelledby="study-title"><div><p class="ms-kicker">THE STARTING POINT / NOT THE FINAL PRODUCT</p><h2 id="study-title">An optimistic<br />way to look at things.</h2><p>These AI-assisted visual studies explore sunny coastal days, sport, curiosity and adventure through the language of vintage advertising.</p><p><strong>The preview references Kellogg’s branding.</strong> It is independent, unofficial concept work—not commissioned, approved, sponsored or sold by Kellogg’s or any depicted brand. Logos, mascots, packaging and advertising claims in the generated study are not verified product information.</p><p>Branded studies are shown as portfolio references only. The studio offer is a separately approved, brand-free or rights-cleared edition, or an original commission. No brand, mascot or commercial advertising rights are offered here.</p></div><figure><div class="ms-proof-label">UNOFFICIAL CONCEPT · PORTFOLIO REFERENCE ONLY</div><img src="/images/morning-studies/concept-preview.avif" alt="Eight generated retro advertising directions with coastal, sporting, mountain, breakfast and city scenes; unofficial Kellogg-branded study." width="360" height="240" loading="lazy" /><figcaption>Low-resolution concept preview, not a print master. Generated lettering and details require editing. Final artwork and a size-appropriate proof must be approved before a sale.</figcaption></figure></section>
    <section class="ms-section" aria-labelledby="offer-title"><div class="ms-section-head"><p class="ms-kicker">THREE WAYS TO START</p><h2 id="offer-title">Choose the shape<br />of your edition.</h2><p>All options are inquiries. Price and feasibility depend on the agreed final work.</p></div><div class="ms-offers"><article><span class="ms-number">01</span><h3>A single print.</h3><p>Ask about a brand-free or rights-cleared piece for a wall, a desk or a gift. Size, paper, production, framing and delivery are quoted before purchase.</p><p class="ms-price">PRICE BY QUOTATION</p><a href={inquiry}>Ask about a print ↗</a></article><article><span class="ms-number">02</span><h3>A small series.</h3><p>Explore a coordinated group around a theme: coast, court, garden or morning. We first confirm the number of pieces, final imagery and format.</p><p class="ms-price">SCOPE &amp; PRICE TO BE AGREED</p><a href={inquiry}>Ask about a series ↗</a></article><article><span class="ms-number">03</span><h3>Your own world.</h3><p>Discuss an original commission for a place, project or personal collection. Any business use requires an explicit scope and agreed usage rights.</p><p class="ms-price">AVAILABILITY TO BE CONFIRMED</p><a href={inquiry}>Discuss a commission ↗</a></article></div></section>
    <section class="ms-process ms-section" aria-labelledby="process-title"><div><p class="ms-kicker">A REAL OFFER NEEDS A CLEAR HANDOFF</p><h2 id="process-title">Quote.<br />Proof.<br /><em>Then decide.</em></h2></div><ol><li><h3>Tell us what caught your eye.</h3><p>Send a theme or image reference, desired format, quantity and delivery country. A full home address or payment details are not needed for a first inquiry.</p></li><li><h3>Review the written offer.</h3><p>The seller confirms availability, final artwork, permitted use, edition terms if any, full price, taxes and shipping as applicable, timing, revisions and cancellation or return terms.</p></li><li><h3>Approve before paying.</h3><p>A suitable proof and an agreed offer come first. Payment instructions are supplied separately only after acceptance. This page does not process payments or place orders.</p></li></ol></section>
    <section class="ms-inquiry" id="inquire" aria-labelledby="inquiry-title"><div><p class="ms-kicker">HOYDICH ADVERTISING / VIA POINTCAST</p><h2 id="inquiry-title">Start with<br /><em>“that one.”</em></h2><p>Tell us the direction you like. We will need to agree an actual edition before anything is sold.</p><a class="ms-button" href={inquiry}>Open a purchase inquiry ↗</a><p class="ms-small">Opens your email app. You choose whether to send.<br />Or write to <a href="mailto:hello@pointcast.xyz">hello@pointcast.xyz</a> with “Morning Studies” in the subject.</p></div><div class="ms-terms"><h3>Before you inquire</h3><p>No checkout, booking, deposit or preorder is open here. No finished physical inventory, print quantity, edition scarcity or delivery date is claimed.</p><p>Reference images are not final print-ready files. No instant digital download, NFT, token, card deck, framing or commercial license is included.</p><p>Branded reference studies are not available as official merchandise. Any final artwork must be separately approved for its intended use; a disclaimer is not a brand license.</p><p>An inquiry creates no obligation to buy. Do not email payment-card details.</p></div></section>
    <footer class="ms-footer"><p>HOYDICH ADVERTISING · AI-ASSISTED STUDIO STUDIES<br />POINTCAST / MORNING STUDIES / 001</p><p><a href="/shop">The shop</a> · <a href="/shop/morning-studies/catalog.json">Offer data</a></p><p>Good work. Clearly offered.</p></footer>
  </main>
</BlockLayout>
<style>
.ms{--paper:#f5efe2;--ink:#122d3c;--red:#ba3a2b;--line:#c6bdab;--gold:#e7b641;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif;overflow-wrap:break-word}.ms *{box-sizing:border-box}.ms a{color:inherit;text-underline-offset:4px}.ms a:focus-visible{outline:3px solid var(--red);outline-offset:5px}.ms-nav,.ms-hero,.ms-study,.ms-section,.ms-inquiry,.ms-footer{padding-left:max(6vw,24px);padding-right:max(6vw,24px)}.ms-nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:24px;padding-bottom:24px;border-bottom:1px solid var(--line)}.ms-logo{font-size:27px;font-weight:bold;letter-spacing:-1.5px;text-decoration:none}.ms-logo span{margin-left:8px;color:var(--red)}.ms-nav>span,.ms-kicker,.ms-ticket-top,.ms-ticket-end,.ms-price,.ms-footer,.ms-proof-label{font:11px/1.7 ui-monospace,Menlo,monospace;letter-spacing:1.4px}.ms-nav>a:last-child{font-size:13px}.ms-hero{display:grid;grid-template-columns:1.5fr 1fr;gap:6vw;align-items:center;padding-top:80px;padding-bottom:84px}.ms-kicker{margin:0 0 26px}.ms h1,.ms h2,.ms h3,.ms-ticket-title{font-family:Georgia,serif;font-weight:normal}.ms h1{font-size:clamp(52px,6.7vw,112px);line-height:.98;letter-spacing:-.055em;margin:0 0 32px}.ms em{color:var(--red);font-weight:normal}.ms-dek{font-size:clamp(19px,2vw,25px);line-height:1.5;max-width:520px}.ms-intro{font-size:16px;line-height:1.75;max-width:520px;margin-bottom:28px}.ms-button{display:inline-flex;align-items:center;justify-content:center;gap:30px;background:var(--ink);color:var(--paper)!important;font-size:15px;text-decoration:none;padding:17px 22px;border:1px solid var(--ink)}.ms-button:hover{background:var(--red);border-color:var(--red)}.ms-small{font-size:12px;line-height:1.8;max-width:470px}.ms-ticket{position:relative;border:1px solid var(--ink);padding:27px 28px;background:#ead7ad;box-shadow:9px 9px 0 var(--paper),10px 10px 0 var(--ink);max-width:430px;justify-self:end;width:100%;overflow:hidden}.ms-ticket-top,.ms-ticket-end{display:block;text-align:center}.ms-sun{width:96px;height:96px;border-radius:50%;background:var(--red);margin:28px auto 16px;box-shadow:0 0 0 9px #ead7ad,0 0 0 10px var(--red)}.ms-ticket-title{font-size:49px;line-height:1.08;letter-spacing:-2px;text-align:center;margin:28px 0}.ms-ticket dl{margin:0 0 24px;border-top:1px solid var(--ink)}.ms-ticket dl>div{display:flex;justify-content:space-between;gap:10px;padding:13px 0;border-bottom:1px solid var(--ink);font-size:12px}.ms-ticket dd{margin:0;text-align:right}.ms-study{display:grid;grid-template-columns:1.1fr 1fr;gap:7vw;align-items:center;background:#e8e8dc;padding-top:64px;padding-bottom:64px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.ms h2{font-size:clamp(36px,4.1vw,62px);line-height:1.05;letter-spacing:-2px;margin:0 0 27px}.ms-study p:not(.ms-kicker){font-size:14px;line-height:1.85}.ms-study figure{margin:0;max-width:440px;justify-self:end}.ms-proof-label{background:var(--ink);color:var(--paper);padding:11px 14px;font-size:10px;letter-spacing:.6px}.ms-study img{display:block;width:100%;height:auto;border:1px solid var(--ink)}.ms-study figcaption{font-size:12px;line-height:1.7;margin-top:14px}.ms-section{padding-top:70px;padding-bottom:70px}.ms-section-head>p:last-child{font-size:15px;line-height:1.7}.ms-offers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:34px}.ms-offers article{border:1px solid var(--line);padding:27px;display:flex;flex-direction:column}.ms-number{color:var(--red);font-family:Georgia,serif;font-size:42px}.ms h3{font-size:29px;letter-spacing:-.7px;margin:15px 0}.ms-offers article>p:not(.ms-price){font-size:14px;line-height:1.8;flex-grow:1}.ms-price{font-size:10px;letter-spacing:.7px;border-top:1px solid var(--line);padding-top:18px;margin-top:20px}.ms-offers article>a{font-size:14px;font-weight:bold}.ms-process{display:grid;grid-template-columns:1fr 1.15fr;gap:8vw;border-top:1px solid var(--line)}.ms-process ol{list-style:none;counter-reset:steps;margin:0;padding:0}.ms-process li{counter-increment:steps;border-bottom:1px solid var(--line);padding:0 0 15px 40px;position:relative}.ms-process li:before{content:'0' counter(steps);position:absolute;left:0;top:7px;color:var(--red);font:13px ui-monospace,monospace}.ms-process li h3{font-size:24px}.ms-process li p{font-size:14px;line-height:1.8}.ms-inquiry{display:grid;grid-template-columns:1fr 1fr;gap:8vw;background:var(--ink);color:var(--paper);padding-top:68px;padding-bottom:68px}.ms-inquiry em{color:var(--gold)}.ms-inquiry .ms-button{background:var(--gold);border-color:var(--gold);color:var(--ink)!important}.ms-inquiry p{font-size:14px;line-height:1.85;max-width:470px}.ms-inquiry .ms-small{font-size:12px}.ms-terms{border:1px solid #5d6c70;padding:12px 26px}.ms-terms h3{font-size:25px}.ms-terms p{font-size:12px}.ms-footer{display:flex;justify-content:space-between;gap:25px;padding-top:26px;padding-bottom:26px;font-size:10px;letter-spacing:.6px}.ms-footer p{margin:0}@media(min-width:1600px){.ms-nav,.ms-hero,.ms-study,.ms-section,.ms-inquiry,.ms-footer{padding-left:calc((100vw - 1408px)/2);padding-right:calc((100vw - 1408px)/2)}}@media(max-width:800px){.ms-nav>span{display:none}.ms-hero{grid-template-columns:1fr;padding-top:48px;gap:45px}.ms-ticket{justify-self:start;max-width:100%}.ms-ticket-title{font-size:43px}.ms-study{grid-template-columns:1fr;gap:32px}.ms-study figure{justify-self:start;max-width:440px;width:100%}.ms-offers{grid-template-columns:1fr}.ms-process,.ms-inquiry{grid-template-columns:1fr;gap:25px}.ms-footer{flex-wrap:wrap}.ms h1{letter-spacing:-3px}.ms-section,.ms-inquiry{padding-top:50px;padding-bottom:50px}}@media(prefers-reduced-motion:reduce){.ms *{scroll-behavior:auto}}
</style>
