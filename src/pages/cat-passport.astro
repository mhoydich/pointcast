---
import BlockLayout from '../layouts/BlockLayout.astro';
import MicroAppShell from '../components/MicroAppShell.astro';
import {
  ZEN_CAT_GENESIS_COLLECTIBLES,
  ZEN_CAT_WORLD_COLLECTIBLES,
} from '../data/zen-cat-collectibles';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('cat-passport')!;
const title = app.name;
const description = app.description;
const heroImages = [0, 2, 5, 8, 10, 14].map((index) => ZEN_CAT_GENESIS_COLLECTIBLES[index]).filter(Boolean);
const countries = Array.from(new Set(ZEN_CAT_WORLD_COLLECTIBLES.map((item) => item.country))).sort((a, b) => a.localeCompare(b));
const gems = Array.from(new Set(ZEN_CAT_WORLD_COLLECTIBLES.map((item) => item.gem))).sort((a, b) => a.localeCompare(b));
const passportData = ZEN_CAT_WORLD_COLLECTIBLES.map((item) => ({
  id: item.id,
  number: item.number,
  title: item.title,
  city: item.city,
  country: item.country,
  landmark: item.landmark,
  cat: item.cat,
  gem: item.gem,
  mood: item.mood,
  rarity: item.rarity,
  palette: item.palette,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/cat-passport',
  name: app.name,
  description,
  url: app.url,
  applicationCategory: 'TravelApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <MicroAppShell
    app={app}
    headline="Stamp a luxury cat route across the world."
    dek="A calm passport for the Zen Cat world series: landmarks, gemstones, city moods, and a local stamp shelf for future mintable art cards."
    images={heroImages.map((item) => ({
      src: item.imageUrl,
      alt: `${item.title} Zen Cat genesis collectible`,
    }))}
    stats={[
      { label: 'World Cards', value: ZEN_CAT_WORLD_COLLECTIBLES.length },
      { label: 'Countries', value: countries.length },
      { label: 'Gems', value: gems.length },
      { label: 'Mode', value: 'passport' },
    ]}
    links={[
      { href: '/zen-cats', label: 'Garden' },
      { href: '/zen-cats.json', label: 'JSON' },
    ]}
  >
    <section class="app-section passport" data-cat-passport>
      <div class="tool-grid">
        <div class="tool-panel">
          <h2>Route Finder</h2>
          <div class="field-stack">
            <label>
              Country
              <select data-filter-country>
                <option value="all">All countries</option>
                {countries.map((country) => <option value={country}>{country}</option>)}
              </select>
            </label>
            <label>
              Gem
              <select data-filter-gem>
                <option value="all">All gems</option>
                {gems.map((gem) => <option value={gem}>{gem}</option>)}
              </select>
            </label>
          </div>
          <div class="button-row">
            <button type="button" data-find-route>Find route</button>
            <button type="button" data-stamp-route>Stamp passport</button>
          </div>
          <p class="mono-note" data-route-count>{ZEN_CAT_WORLD_COLLECTIBLES.length} possible routes.</p>
        </div>

        <article class="passport-card" data-passport-card>
          <div class="passport-card__art" data-passport-art style={`--ground:${ZEN_CAT_WORLD_COLLECTIBLES[0].palette.ground};--accent:${ZEN_CAT_WORLD_COLLECTIBLES[0].palette.accent};--ink:${ZEN_CAT_WORLD_COLLECTIBLES[0].palette.ink};`}>
            <span data-passport-number>No. {String(ZEN_CAT_WORLD_COLLECTIBLES[0].number).padStart(2, '0')}</span>
          </div>
          <div class="passport-card__copy">
            <p class="mono-note" data-passport-kicker>{ZEN_CAT_WORLD_COLLECTIBLES[0].country} · {ZEN_CAT_WORLD_COLLECTIBLES[0].gem}</p>
            <h2 data-passport-title>{ZEN_CAT_WORLD_COLLECTIBLES[0].title}</h2>
            <p data-passport-detail>{ZEN_CAT_WORLD_COLLECTIBLES[0].cat} near {ZEN_CAT_WORLD_COLLECTIBLES[0].landmark}.</p>
            <dl>
              <div><dt>City</dt><dd data-passport-city>{ZEN_CAT_WORLD_COLLECTIBLES[0].city}</dd></div>
              <div><dt>Mood</dt><dd data-passport-mood>{ZEN_CAT_WORLD_COLLECTIBLES[0].mood}</dd></div>
              <div><dt>Rarity</dt><dd data-passport-rarity>{ZEN_CAT_WORLD_COLLECTIBLES[0].rarity}</dd></div>
            </dl>
          </div>
        </article>
      </div>

      <section class="stamp-ledger" aria-labelledby="stamp-title">
        <div>
          <h2 id="stamp-title">Passport Shelf</h2>
          <p class="mono-note"><span data-stamp-count>0</span> stamps collected locally.</p>
        </div>
        <button type="button" data-clear-stamps>Clear stamps</button>
        <ol class="stamp-list" data-stamp-list></ol>
      </section>
    </section>
  </MicroAppShell>
  <script id="cat-passport-data" type="application/json" is:inline set:html={JSON.stringify(passportData)}></script>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-cat-passport]');
    const dataEl = document.querySelector('#cat-passport-data');
    if (!root || !dataEl) return;
    const routes = JSON.parse(dataEl.textContent || '[]');
    const storageKey = 'pc:cat-passport:stamps';
    let selected = routes[0];
    const els = {
      country: root.querySelector('[data-filter-country]'),
      gem: root.querySelector('[data-filter-gem]'),
      count: root.querySelector('[data-route-count]'),
      art: root.querySelector('[data-passport-art]'),
      number: root.querySelector('[data-passport-number]'),
      kicker: root.querySelector('[data-passport-kicker]'),
      title: root.querySelector('[data-passport-title]'),
      detail: root.querySelector('[data-passport-detail]'),
      city: root.querySelector('[data-passport-city]'),
      mood: root.querySelector('[data-passport-mood]'),
      rarity: root.querySelector('[data-passport-rarity]'),
      stampCount: root.querySelector('[data-stamp-count]'),
      stampList: root.querySelector('[data-stamp-list]'),
    };
    const stamps = () => {
      try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch { return []; }
    };
    const saveStamps = (items) => localStorage.setItem(storageKey, JSON.stringify(items.slice(-50)));
    const filtered = () => routes.filter((route) =>
      (els.country.value === 'all' || route.country === els.country.value) &&
      (els.gem.value === 'all' || route.gem === els.gem.value)
    );
    const renderRoute = (route) => {
      selected = route || routes[0];
      els.art.style.setProperty('--ground', selected.palette.ground);
      els.art.style.setProperty('--accent', selected.palette.accent);
      els.art.style.setProperty('--ink', selected.palette.ink);
      els.number.textContent = `No. ${String(selected.number).padStart(2, '0')}`;
      els.kicker.textContent = `${selected.country} · ${selected.gem}`;
      els.title.textContent = selected.title;
      els.detail.textContent = `${selected.cat} near ${selected.landmark}.`;
      els.city.textContent = selected.city;
      els.mood.textContent = selected.mood;
      els.rarity.textContent = selected.rarity;
    };
    const renderCount = () => {
      const pool = filtered();
      els.count.textContent = `${pool.length} possible route${pool.length === 1 ? '' : 's'}.`;
      return pool;
    };
    const renderStamps = () => {
      const items = stamps();
      els.stampCount.textContent = String(items.length);
      els.stampList.innerHTML = items.slice().reverse().map((item) =>
        `<li><strong>${item.title}</strong><span>${item.city}, ${item.country} · ${item.gem}</span></li>`
      ).join('');
    };
    els.country.addEventListener('change', renderCount);
    els.gem.addEventListener('change', renderCount);
    root.querySelector('[data-find-route]')?.addEventListener('click', () => {
      const pool = renderCount();
      const index = Math.floor((Date.now() / 1709) % Math.max(pool.length, 1));
      renderRoute(pool[index] || routes[0]);
    });
    root.querySelector('[data-stamp-route]')?.addEventListener('click', () => {
      const items = stamps().filter((item) => item.id !== selected.id);
      items.push({ ...selected, stampedAt: new Date().toLocaleDateString() });
      saveStamps(items);
      renderStamps();
    });
    root.querySelector('[data-clear-stamps]')?.addEventListener('click', () => {
      localStorage.removeItem(storageKey);
      renderStamps();
    });
    renderCount();
    renderRoute(selected);
    renderStamps();
  })();
</script>

<style>
  .passport-card {
    display: grid;
    grid-template-columns: minmax(180px, 0.85fr) minmax(0, 1fr);
    gap: 14px;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 14px;
  }
  .passport-card__art {
    position: relative;
    min-height: 320px;
    border: 1px solid rgba(18, 17, 14, 0.12);
    background:
      radial-gradient(circle at 50% 42%, var(--accent) 0 14%, transparent 15%),
      linear-gradient(90deg, transparent 44%, rgba(255,255,255,0.32) 45% 55%, transparent 56%),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.16) 0 2px, transparent 2px 8px),
      var(--ground);
    overflow: hidden;
  }
  .passport-card__art::before {
    content: "";
    position: absolute;
    inset: 18% 18% 10%;
    border: 3px solid var(--ink);
    border-radius: 50% 50% 42% 42%;
    opacity: 0.72;
  }
  .passport-card__art::after {
    content: "";
    position: absolute;
    left: 27%;
    right: 27%;
    top: 22%;
    height: 22%;
    border-left: 36px solid transparent;
    border-right: 36px solid transparent;
    border-bottom: 70px solid rgba(255, 255, 255, 0.72);
    opacity: 0.84;
  }
  .passport-card__art span {
    position: absolute;
    left: 12px;
    bottom: 10px;
    color: var(--ink);
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  dl {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
  }
  dt {
    color: var(--pc-ink-muted);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dd {
    margin: 3px 0 0;
  }
  .stamp-ledger {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: start;
    margin-top: 14px;
    border: 1px solid var(--pc-rule-soft);
    padding: 14px;
    background: #f8f7f2;
  }
  .stamp-list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stamp-list li {
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 10px;
  }
  .stamp-list span {
    display: block;
    margin-top: 5px;
    color: var(--pc-ink-muted);
    font-size: 12px;
    line-height: 1.35;
  }
  @media (max-width: 840px) {
    .passport-card,
    .stamp-ledger {
      grid-template-columns: 1fr;
    }
    .stamp-list {
      grid-template-columns: 1fr;
    }
  }
</style>
