---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Loop — a Noun loop pedal" description="A loop pedal for the Nouns. Arm a voice, play a four-bar phrase, the page loops it forever. Stack four voices on top of each other. Layer up a song from nothing.">
  <main class="cl" id="cl" data-built={built}>
    <header class="cl__hero">
      <p class="cl__kicker">CAST · LOOP · a Noun loop pedal</p>
      <h1 class="cl__title">Layer one voice. Then another.</h1>
      <p class="cl__sub">Tap a voice's <strong>ARM</strong> button. The next four bars, your key-taps record into that voice. After four bars, your phrase loops automatically. Stack up to four voices.</p>
    </header>

    <section class="cl__transport">
      <button class="cl__play" id="cl-play" type="button" aria-label="Start / stop the grid">
        <span id="cl-play-icon">▶</span>
      </button>
      <div class="cl__transport-meta">
        <p class="cl__transport-name" id="cl-bar-readout">— bar — · — beat —</p>
        <p class="cl__transport-sub">4-bar grid · 16ths quantized · arm a voice to record</p>
      </div>
      <div class="cl__bpm">
        <label class="cl__bpm-label" for="cl-bpm">BPM</label>
        <input type="range" class="cl__bpm-slider" id="cl-bpm" min="70" max="140" step="2" value="96"/>
        <span class="cl__bpm-val" id="cl-bpm-val">96</span>
      </div>
    </section>

    <section class="cl__voices" id="cl-voices">
      <!-- populated by JS -->
    </section>

    <section class="cl__keyboard-wrap">
      <p class="cl__section-label">PLAY · 8 keys, A-K · pitches change with the armed voice's range</p>
      <div class="cl__keyboard" id="cl-keyboard" role="group" aria-label="Loop keyboard"></div>
      <p class="cl__keyboard-hint" id="cl-keyboard-hint">Hit play. Arm a voice. Tap or press A-K. The page records.</p>
    </section>

    <footer class="cl__foot">
      <p>Built {built.slice(0,10)} · No CDN. Pure Web Audio. 4 voices · 4 bars · 16 quantized steps per bar.</p>
      <p>Other ways to make music: <a href="/cast-make">/cast-make</a> · <a href="/cast-make-pro">/cast-make-pro</a> · <a href="/cast-jam">/cast-jam</a> · <a href="/cast-on">/cast-on</a> · <a href="/town-music">/town-music</a> · <a href="/">PointCast home</a></p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cl-bg: #0a0610;
    --cl-walnut: #5a3422;
    --cl-flame: #f6c15e;
    --cl-cream: #f4e7c8;
    --cl-velvet: #1a0820;
    --cl-line: rgba(244,231,200,0.10);
    --cl-text: #f4e7c8;
    --cl-text-mute: rgba(244,231,200,0.62);
    --cl-text-quiet: rgba(244,231,200,0.38);
    --cl-good: #a8ff3a;
    --cl-bad: #ff5f7a;
    --cl-display: 'Inter Tight', system-ui, sans-serif;
    --cl-body: 'Inter', system-ui, sans-serif;
    --cl-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  body { background: var(--cl-bg); color: var(--cl-text); font-family: var(--cl-body); }

  .cl { max-width: 960px; margin: 0 auto; padding: 36px 22px 60px 22px; display: flex; flex-direction: column; gap: 26px; }

  /* HERO */
  .cl__kicker { font-family: var(--cl-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--cl-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .cl__title { font-family: var(--cl-display); font-weight: 800; font-size: clamp(40px, 7vw, 60px); line-height: 0.96; letter-spacing: -0.02em; margin: 0 0 14px 0; }
  .cl__sub { font-family: var(--cl-body); font-size: 15px; line-height: 1.6; color: var(--cl-text-mute); max-width: 620px; margin: 0; }
  .cl__sub strong { color: var(--cl-flame); font-weight: 600; }

  /* TRANSPORT */
  .cl__transport { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; padding: 16px 22px; background: rgba(244,231,200,0.04); border: 1px solid var(--cl-line); border-radius: 12px; }
  @media (max-width: 560px) { .cl__transport { grid-template-columns: auto 1fr; } .cl__bpm { grid-column: 1 / -1; justify-content: center; } }
  .cl__play {
    width: 58px; height: 58px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, var(--cl-flame) 0%, var(--cl-walnut) 75%, var(--cl-velvet) 100%);
    border: 2px solid rgba(244,231,200,0.18);
    color: var(--cl-velvet); font-size: 22px; font-weight: 800; padding-left: 3px;
    cursor: pointer;
    display: grid; place-items: center;
    box-shadow: 0 6px 18px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.18) inset;
    transition: transform 0.15s ease;
  }
  .cl__play:hover { transform: scale(1.05); }
  .cl__play:focus-visible { outline: 3px solid var(--cl-flame); outline-offset: 4px; }
  .cl__play--on { padding-left: 0; }
  .cl__transport-meta { min-width: 0; }
  .cl__transport-name { font-family: var(--cl-mono); font-size: 13px; color: var(--cl-flame); margin: 0; letter-spacing: 0.4px; font-weight: 500; }
  .cl__transport-sub { font-family: var(--cl-mono); font-size: 10.5px; color: var(--cl-text-mute); margin: 4px 0 0 0; letter-spacing: 0.3px; }
  .cl__bpm { display: flex; align-items: center; gap: 10px; }
  .cl__bpm-label { font-family: var(--cl-mono); font-size: 10px; color: var(--cl-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; }
  .cl__bpm-slider { width: 100px; -webkit-appearance: none; appearance: none; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer; }
  .cl__bpm-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--cl-flame); cursor: pointer; }
  .cl__bpm-val { font-family: var(--cl-display); font-weight: 700; font-size: 18px; color: var(--cl-text); min-width: 32px; text-align: right; letter-spacing: -0.01em; }

  /* VOICE LANES */
  .cl__voices { display: grid; gap: 10px; }
  .cl__voice {
    display: grid; grid-template-columns: 130px 1fr auto; gap: 14px; align-items: center;
    padding: 12px 14px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--voice-c) 14%, var(--cl-velvet)) 0%, var(--cl-velvet) 100%);
    border: 2px solid transparent; border-radius: 10px;
    transition: border-color 0.18s ease;
  }
  .cl__voice--armed { border-color: var(--cl-bad); box-shadow: 0 0 0 4px color-mix(in srgb, var(--cl-bad) 18%, transparent); }
  .cl__voice--filled { border-color: color-mix(in srgb, var(--voice-c) 60%, transparent); }
  @media (max-width: 720px) { .cl__voice { grid-template-columns: 130px 1fr; } .cl__voice-actions { grid-column: 1 / -1; justify-content: end; } }

  .cl__voice-id { display: flex; align-items: center; gap: 10px; }
  .cl__voice-noun { width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.30); display: grid; place-items: center; flex-shrink: 0; }
  .cl__voice-noun img { width: 80%; image-rendering: pixelated; }
  .cl__voice-name { font-family: var(--cl-display); font-weight: 700; font-size: 14px; color: #fff; margin: 0; line-height: 1.2; }
  .cl__voice-tag { font-family: var(--cl-mono); font-size: 9px; color: rgba(255,255,255,0.65); margin: 2px 0 0 0; letter-spacing: 0.3px; text-transform: uppercase; }

  /* Step grid showing recorded events for this voice across 4 bars × 16 steps */
  .cl__voice-grid { display: grid; grid-template-columns: repeat(64, 1fr); gap: 1px; height: 28px; align-items: stretch; }
  .cl__voice-cell { background: rgba(244,231,200,0.04); border-radius: 1px; height: 100%; transition: background 0.05s ease; }
  .cl__voice-cell:nth-child(16n+1) { background: rgba(244,231,200,0.10); }
  .cl__voice-cell--on { background: var(--voice-c); }
  .cl__voice-cell--cur { outline: 1px solid var(--cl-cream); outline-offset: -1px; }

  /* Per-voice action buttons */
  .cl__voice-actions { display: flex; gap: 6px; }
  .cl__voice-btn {
    padding: 6px 10px; border-radius: 6px; font-family: var(--cl-mono); font-size: 10px;
    letter-spacing: 0.4px; cursor: pointer; text-transform: uppercase;
    border: 1px solid rgba(244,231,200,0.18); background: rgba(0,0,0,0.30); color: rgba(255,255,255,0.78);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cl__voice-btn:hover { background: rgba(244,231,200,0.10); color: #fff; }
  .cl__voice-btn--arm { border-color: var(--cl-bad); color: var(--cl-bad); }
  .cl__voice-btn--armed { background: var(--cl-bad); color: var(--cl-velvet); font-weight: 700; }
  .cl__voice-btn--clear { color: var(--cl-text-quiet); }

  /* KEYBOARD */
  .cl__keyboard-wrap { padding: 22px 22px 18px 22px; background: linear-gradient(180deg, rgba(244,231,200,0.04), rgba(244,231,200,0.01)); border: 1px solid var(--cl-line); border-radius: 14px; }
  .cl__section-label { font-family: var(--cl-mono); font-size: 10px; letter-spacing: 0.6px; color: var(--cl-text-quiet); text-transform: uppercase; margin: 0 0 14px 0; }
  .cl__keyboard { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; height: 160px; }
  @media (max-width: 560px) { .cl__keyboard { gap: 4px; height: 130px; } }
  .cl__key {
    background: linear-gradient(180deg, var(--key-c, var(--cl-cream)) 0%, color-mix(in srgb, var(--key-c, var(--cl-cream)) 70%, #000) 100%);
    border: 2px solid rgba(0,0,0,0.30);
    border-radius: 9px;
    cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 8px 4px;
    transition: transform 0.06s ease, filter 0.06s ease;
    font-family: var(--cl-mono); color: var(--cl-velvet);
    box-shadow: 0 3px 10px rgba(0,0,0,0.25), 0 -2px 4px rgba(0,0,0,0.15) inset;
  }
  .cl__key:active, .cl__key--press { transform: translateY(2px) scale(0.97); filter: brightness(1.18); }
  .cl__key:focus-visible { outline: 2px solid var(--cl-flame); outline-offset: 3px; }
  .cl__key--root { background: linear-gradient(180deg, var(--cl-flame), color-mix(in srgb, var(--cl-flame) 60%, #000)); }
  .cl__key-letter { font-size: 16px; font-weight: 700; opacity: 0.85; }
  .cl__key-note { font-size: 10px; opacity: 0.55; }
  .cl__keyboard-hint { font-family: var(--cl-mono); font-size: 10.5px; color: var(--cl-text-quiet); margin: 10px 0 0 0; text-align: center; }

  /* FOOT */
  .cl__foot { padding-top: 24px; border-top: 1px solid var(--cl-line); font-family: var(--cl-mono); font-size: 11px; color: var(--cl-text-quiet); line-height: 1.7; text-align: center; }
  .cl__foot a { color: var(--cl-flame); text-decoration: none; }
  .cl__foot a:hover { text-decoration: underline; }
</style>

<script>
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';

  // ============================================================
  //  CAST · LOOP — 4-voice loop pedal
  //  Real-time recording: while a voice is "armed", every key tap
  //  is recorded against the running 4-bar grid quantized to 16ths.
  //  After 4 bars of recording, the loop arms and plays alongside.
  // ============================================================

  const BARS = 4;
  const STEPS_PER_BAR = 16;
  const TOTAL_STEPS = BARS * STEPS_PER_BAR; // 64

  type VoiceId = 0 | 1 | 2 | 3;
  interface Voice {
    id: VoiceId;
    name: string;
    tag: string;
    color: string;
    nounId: number;
    // Synth signature
    timbre: 'pluck' | 'bell' | 'pad' | 'bass';
    // Pitch palette (8 frequencies for the keyboard)
    pitches: number[];
    // Recorded events as a Map<stepIndex, pitchIndex>. Up to 4 events per step.
    recorded: Map<number, number[]>;
  }

  function pitchesFromRoot(root: number, scale: number[]): number[] {
    return scale.map(s => root * Math.pow(2, s / 12));
  }

  // Ionian scale in absolute Hz, 1 octave + octave
  const MAJOR_SCALE = [0, 2, 4, 5, 7, 9, 11, 12];

  // Each voice has a different timbre + pitch range, but they share the same scale family.
  const VOICES: Voice[] = [
    { id: 0, name: 'Brass on Main',  tag: 'BELL',  color: '#f6c15e', nounId: 287,
      timbre: 'bell',  pitches: pitchesFromRoot(523.25, MAJOR_SCALE), recorded: new Map() }, // C5
    { id: 1, name: 'Block Runner',   tag: 'PLUCK', color: '#a8ff3a', nounId: 523,
      timbre: 'pluck', pitches: pitchesFromRoot(261.63, MAJOR_SCALE), recorded: new Map() }, // C4
    { id: 2, name: 'Marine Layer',   tag: 'PAD',   color: '#9ed6f0', nounId: 313,
      timbre: 'pad',   pitches: pitchesFromRoot(196.00, MAJOR_SCALE), recorded: new Map() }, // G3
    { id: 3, name: 'Night Broadcast',tag: 'BASS',  color: '#6f59c0', nounId: 1189,
      timbre: 'bass',  pitches: pitchesFromRoot(98.00, MAJOR_SCALE),  recorded: new Map() }, // G2
  ];

  // ---------- Audio engine ----------
  let ctx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let sched: AudioScheduler | null = null;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterGain = ctx.createGain(); masterGain.gain.value = 0.62;
    masterGain.connect(ctx.destination);
    sched = createAudioScheduler(ctx);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running' && playing) sched?.resume();
    });
    return ctx;
  }

  // Per-timbre note synths. Each is short-lived; auto-cleans via shared scheduler trackSource.
  function fireNote(voice: Voice, pitchIdx: number, when?: number) {
    const c = ac();
    const t = when ?? (c.currentTime + 0.005);
    const freq = voice.pitches[pitchIdx];
    const o = c.createOscillator();
    const g = c.createGain();
    const f = c.createBiquadFilter();
    if (voice.timbre === 'bell') {
      // 3 partial sines
      [1, 2, 3].forEach((mult, i) => {
        const oo = c.createOscillator(); const gg = c.createGain();
        oo.frequency.value = freq * mult;
        oo.type = 'sine';
        gg.gain.setValueAtTime(0.001, t);
        gg.gain.exponentialRampToValueAtTime(0.16 / (i + 1), t + 0.01);
        gg.gain.exponentialRampToValueAtTime(0.001, t + 0.7 - i * 0.15);
        oo.connect(gg); gg.connect(masterGain!);
        sched!.trackSource(oo); oo.start(t); oo.stop(t + 0.8);
      });
      return;
    }
    if (voice.timbre === 'pluck') {
      o.type = 'sawtooth'; o.frequency.value = freq;
      f.type = 'lowpass'; f.frequency.setValueAtTime(2400, t); f.frequency.exponentialRampToValueAtTime(800, t + 0.30); f.Q.value = 4;
      g.gain.setValueAtTime(0.001, t);
      g.gain.exponentialRampToValueAtTime(0.22, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.30);
      o.connect(f); f.connect(g); g.connect(masterGain!);
      sched!.trackSource(o); o.start(t); o.stop(t + 0.35);
      return;
    }
    if (voice.timbre === 'pad') {
      // Detuned triangle pair, long sustain
      const o2 = c.createOscillator();
      o.type = 'triangle'; o.frequency.value = freq;
      o2.type = 'triangle'; o2.frequency.value = freq * 1.006;
      f.type = 'lowpass'; f.frequency.value = 1600; f.Q.value = 0.7;
      g.gain.setValueAtTime(0.001, t);
      g.gain.linearRampToValueAtTime(0.10, t + 0.18);
      g.gain.linearRampToValueAtTime(0.001, t + 1.2);
      o.connect(f); o2.connect(f); f.connect(g); g.connect(masterGain!);
      sched!.trackSource(o); o.start(t); o.stop(t + 1.25);
      sched!.trackSource(o2); o2.start(t); o2.stop(t + 1.25);
      return;
    }
    // bass
    o.type = 'sine'; o.frequency.value = freq * 0.5;
    const oSub = c.createOscillator(); oSub.type = 'sine'; oSub.frequency.value = freq * 0.25;
    const gSub = c.createGain();
    f.type = 'lowpass'; f.frequency.value = 600; f.Q.value = 0.7;
    g.gain.setValueAtTime(0.001, t);
    g.gain.exponentialRampToValueAtTime(0.32, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.50);
    gSub.gain.setValueAtTime(0.001, t);
    gSub.gain.exponentialRampToValueAtTime(0.18, t + 0.025);
    gSub.gain.exponentialRampToValueAtTime(0.001, t + 0.55);
    o.connect(f); f.connect(g); g.connect(masterGain!);
    oSub.connect(gSub); gSub.connect(masterGain!);
    sched!.trackSource(o); o.start(t); o.stop(t + 0.55);
    sched!.trackSource(oSub); oSub.start(t); oSub.stop(t + 0.60);
  }

  function playMetronome(t: number, isDownbeat: boolean) {
    const c = ac();
    const o = c.createOscillator();
    const g = c.createGain();
    o.type = 'square'; o.frequency.value = isDownbeat ? 1800 : 1200;
    g.gain.setValueAtTime(0.001, t);
    g.gain.exponentialRampToValueAtTime(isDownbeat ? 0.10 : 0.05, t + 0.001);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
    o.connect(g); g.connect(masterGain!);
    sched!.trackSource(o); o.start(t); o.stop(t + 0.05);
  }

  // ---------- Grid scheduler ----------
  let playing = false;
  let bpm = 96;
  let armedVoice: VoiceId | null = null;
  let cycleStartCtxTime = 0;
  let stepInterval = 0; // seconds per 16th step
  let rafId = 0;
  let curStep = 0;

  function startGrid() {
    const c = ac(); if (c.state === 'suspended') c.resume();
    if (sched) sched.stopAll();
    cycleStartCtxTime = c.currentTime + 0.1;
    stepInterval = 60 / bpm / 4;
    playing = true;
    scheduleCycle();
    runRender();
    setPlayIcon(true);
  }
  function stopGrid() {
    if (sched) sched.stopAll();
    playing = false;
    cancelAnimationFrame(rafId);
    setPlayIcon(false);
    document.querySelectorAll('.cl__voice-cell').forEach(el => el.classList.remove('cl__voice-cell--cur'));
  }

  // Schedule one full 4-bar cycle worth of metronome + recorded notes.
  // After the cycle ends, re-schedule the next one (loop forever).
  function scheduleCycle() {
    const start = cycleStartCtxTime;
    // Metronome: kick-ish click on every beat (16 beats in 4 bars), louder on downbeats
    for (let s = 0; s < TOTAL_STEPS; s++) {
      const t = start + s * stepInterval;
      if (s % 4 === 0) playMetronome(t, s === 0);
    }
    // Recorded notes from each voice
    for (const voice of VOICES) {
      voice.recorded.forEach((pitchIndices, stepIdx) => {
        const t = start + stepIdx * stepInterval;
        for (const p of pitchIndices) fireNote(voice, p, t);
      });
    }
    // Schedule next cycle at end
    const cycleSec = TOTAL_STEPS * stepInterval;
    sched!.schedule(() => {
      cycleStartCtxTime = start + cycleSec;
      // End-of-cycle: if a voice was armed, transition to "filled"
      if (armedVoice !== null) {
        const v = VOICES[armedVoice];
        if (v.recorded.size > 0) {
          // keep filled state; just disarm
          armedVoice = null;
          renderVoices();
        } else {
          // armed but never recorded — stay armed for another cycle
          // (gives the user a head start)
        }
      }
      scheduleCycle();
    }, start + cycleSec);
  }

  // Called when user taps a key while playing. Records into the armed voice
  // (quantized to the current step). Always fires the audible note too.
  function tapKey(pitchIdx: number) {
    if (!playing) { /* still play the note */ if (!ctx) ac(); fireNote(VOICES[0], pitchIdx); return; }
    const c = ac();
    const elapsed = c.currentTime - cycleStartCtxTime;
    let step = Math.round(elapsed / stepInterval);
    // Wrap to current cycle
    while (step < 0) step += TOTAL_STEPS;
    step = step % TOTAL_STEPS;
    if (armedVoice === null) {
      // play through voice 0 by default (the bell, sounds nice over anything)
      fireNote(VOICES[0], pitchIdx);
      return;
    }
    const v = VOICES[armedVoice];
    const list = v.recorded.get(step) || [];
    if (!list.includes(pitchIdx)) list.push(pitchIdx);
    v.recorded.set(step, list);
    fireNote(v, pitchIdx); // also play it now
    renderVoiceGrid(v);
  }

  function setPlayIcon(on: boolean) {
    const ic = document.getElementById('cl-play-icon')!;
    const btn = document.getElementById('cl-play')!;
    ic.textContent = on ? '◼' : '▶';
    btn.classList.toggle('cl__play--on', on);
  }

  // ---------- Render ----------
  function renderVoices() {
    const wrap = document.getElementById('cl-voices')!;
    wrap.innerHTML = VOICES.map(v => `
      <div class="cl__voice ${armedVoice === v.id ? 'cl__voice--armed' : ''} ${v.recorded.size > 0 ? 'cl__voice--filled' : ''}" data-voice="${v.id}" style="--voice-c: ${v.color};">
        <div class="cl__voice-id">
          <div class="cl__voice-noun"><img src="https://noun.pics/${v.nounId}.svg" alt=""/></div>
          <div>
            <p class="cl__voice-name">${v.name}</p>
            <p class="cl__voice-tag">${v.tag}</p>
          </div>
        </div>
        <div class="cl__voice-grid" id="cl-grid-${v.id}">
          ${Array.from({length: TOTAL_STEPS}, (_, i) => `<div class="cl__voice-cell ${v.recorded.has(i) ? 'cl__voice-cell--on' : ''}" data-step="${i}"></div>`).join('')}
        </div>
        <div class="cl__voice-actions">
          <button class="cl__voice-btn cl__voice-btn--arm ${armedVoice === v.id ? 'cl__voice-btn--armed' : ''}" data-arm="${v.id}" type="button">${armedVoice === v.id ? '● rec' : 'arm'}</button>
          <button class="cl__voice-btn cl__voice-btn--clear" data-clear="${v.id}" type="button">clear</button>
        </div>
      </div>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-arm]').forEach(b => {
      b.addEventListener('click', () => {
        const id = Number(b.dataset.arm) as VoiceId;
        armedVoice = (armedVoice === id) ? null : id;
        renderVoices();
        renderKeyboard();
      });
    });
    wrap.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach(b => {
      b.addEventListener('click', () => {
        const id = Number(b.dataset.clear) as VoiceId;
        VOICES[id].recorded.clear();
        renderVoices();
      });
    });
  }

  function renderVoiceGrid(voice: Voice) {
    const grid = document.getElementById(`cl-grid-${voice.id}`);
    if (!grid) return;
    grid.querySelectorAll<HTMLDivElement>('.cl__voice-cell').forEach((cell, i) => {
      cell.classList.toggle('cl__voice-cell--on', voice.recorded.has(i));
    });
  }

  function renderKeyboard() {
    const wrap = document.getElementById('cl-keyboard')!;
    const KEYS = ['A','S','D','F','G','H','J','K'];
    const NOTES = ['C','D','E','F','G','A','B','C'];
    const v = armedVoice !== null ? VOICES[armedVoice] : VOICES[0];
    wrap.innerHTML = NOTES.map((n, i) => {
      const isRoot = i === 0 || i === 7;
      const tint = isRoot ? '' : ` style="--key-c: color-mix(in srgb, ${v.color} ${4 + i * 1.4}%, var(--cl-cream));"`;
      return `<button class="cl__key ${isRoot ? 'cl__key--root' : ''}" data-pitch="${i}" type="button" aria-label="${n}"${tint}><span class="cl__key-letter">${KEYS[i]}</span><span class="cl__key-note">${n}</span></button>`;
    }).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-pitch]').forEach(b => {
      const idx = Number(b.dataset.pitch);
      const fire = () => {
        tapKey(idx);
        b.classList.add('cl__key--press');
        setTimeout(() => b.classList.remove('cl__key--press'), 90);
      };
      b.addEventListener('pointerdown', fire);
      b.addEventListener('click', (e) => { if ((e as MouseEvent).detail === 0) fire(); });
    });
    const hint = document.getElementById('cl-keyboard-hint')!;
    if (!playing) {
      hint.textContent = 'Hit play. Arm a voice. Tap or press A-K. The page records into the armed voice.';
    } else if (armedVoice === null) {
      hint.textContent = 'Playing. Arm a voice to start recording, or just tap keys to audition.';
    } else {
      const av = VOICES[armedVoice];
      hint.textContent = `Recording into ${av.name} (${av.tag}). Tap A-K to lay down a phrase. Tap arm again to stop.`;
    }
  }

  function runRender() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!playing || !ctx) return;
      const elapsed = ctx.currentTime - cycleStartCtxTime;
      let step = Math.floor(elapsed / stepInterval);
      if (step < 0) step = 0;
      step = step % TOTAL_STEPS;
      if (step !== curStep) {
        curStep = step;
        // Highlight current step across all voice grids
        VOICES.forEach(v => {
          const grid = document.getElementById(`cl-grid-${v.id}`);
          if (!grid) return;
          grid.querySelectorAll<HTMLDivElement>('.cl__voice-cell').forEach((cell, i) => {
            cell.classList.toggle('cl__voice-cell--cur', i === step);
          });
        });
        // Bar/beat readout
        const bar = Math.floor(step / STEPS_PER_BAR) + 1;
        const beat = Math.floor((step % STEPS_PER_BAR) / 4) + 1;
        const ix = (step % 4) + 1;
        const readout = document.getElementById('cl-bar-readout')!;
        readout.textContent = `bar ${bar} of ${BARS} · beat ${beat} · 16th ${ix}${armedVoice !== null ? '  ·  ● REC ' + VOICES[armedVoice].name : ''}`;
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }

  // ---------- Keyboard hotkeys ----------
  const KEY_MAP: Record<string, number> = { 'a': 0, 's': 1, 'd': 2, 'f': 3, 'g': 4, 'h': 5, 'j': 6, 'k': 7 };
  function bindKeyboardHotkeys() {
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); if (playing) stopGrid(); else startGrid(); return; }
      const idx = KEY_MAP[e.key.toLowerCase()];
      if (idx === undefined || e.repeat) return;
      e.preventDefault();
      tapKey(idx);
      const btn = document.querySelector(`[data-pitch="${idx}"]`) as HTMLButtonElement | null;
      if (btn) { btn.classList.add('cl__key--press'); setTimeout(() => btn.classList.remove('cl__key--press'), 90); }
    });
  }

  // ---------- Init ----------
  document.addEventListener('DOMContentLoaded', () => {
    renderVoices();
    renderKeyboard();
    document.getElementById('cl-play')?.addEventListener('click', () => { if (playing) stopGrid(); else startGrid(); });
    const bpmSlider = document.getElementById('cl-bpm') as HTMLInputElement;
    const bpmVal = document.getElementById('cl-bpm-val')!;
    bpmSlider.addEventListener('input', () => {
      bpm = Number(bpmSlider.value);
      bpmVal.textContent = String(bpm);
      if (playing) { stopGrid(); startGrid(); }
    });
    bindKeyboardHotkeys();
  });
</script>
</BlockLayout>
