---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';
const title = 'Nouns Slide';
const description = "A Windows 95 15-puzzle of today's PointCast Noun. Slide tiles to reassemble the daily Noun and beat your best time.";
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/nouns-slide', name: title, description, url: 'https://pointcast.xyz/nouns-slide' };
---
<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-slide>
    <section class="window" aria-labelledby="slide-title">
      <header class="titlebar"><span>Nouns Slide</span><span class="buttons" aria-hidden="true"><i>_</i><i>▫</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Nouns Slide menu">
        <button type="button" data-new>Game</button>
        <button type="button" data-peek aria-label="Peek at the full Noun">Peek</button>
        <a href="/noggle-drop">Drop</a> <a href="/nouns-2048">2048</a> <a href="/nouns-snake">Snake</a> <a href="/nouns-slide">Slide</a> <a href="/nouns-reversi">Reversi</a> <a href="/nouns-breakout">Breakout</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div>
          <p class="kicker">DAILY · 15-PUZZLE · NOUN</p>
          <h1 id="slide-title">Nouns Slide</h1>
          <p class="how">Slide tiles next to the gap to rebuild today's Noun. Click a tile or use the arrow keys.</p>
          <p class="target" data-target>Loading today's Noun…</p>
        </div>
        <div class="meters">
          <span>Moves <strong data-moves>0</strong></span>
          <span>Time <strong data-time>00:00</strong></span>
          <span>Best <strong data-best>--</strong></span>
        </div>
      </div>
      <div class="playframe">
        <div class="board" data-board aria-label="Sliding puzzle of the daily Noun" role="group"></div>
        <div class="solved" data-solved hidden>
          <div class="solved-card">
            <p class="solved-kicker">SOLVED!</p>
            <p class="solved-line" data-solved-line>Noun reassembled.</p>
            <button type="button" data-new-2>New Game</button>
          </div>
        </div>
      </div>
      <div class="dpad" aria-label="Slide controls">
        <button type="button" data-dir="up" aria-label="Slide up">▲</button>
        <div class="dpad-row">
          <button type="button" data-dir="left" aria-label="Slide left">◀</button>
          <button type="button" data-dir="down" aria-label="Slide down">▼</button>
          <button type="button" data-dir="right" aria-label="Slide right">▶</button>
        </div>
      </div>
      <footer class="status" data-status>Ready.</footer>
    </section>
  </main>
<script>
  const root = document.querySelector<HTMLElement>('[data-slide]');
  if (root) {
    const slug = 'nouns-slide';
    const statsKey = 'pc:arcade:' + slug;
    const profileKey = 'pc:arcade:profile';
    const N = 4;
    const TILES = N * N; // 16, blank is value 15 in solved state
    const BLANK = TILES - 1; // 15

    function readJson(key: string, fallback: any) {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    }
    function writeJson(key: string, value: any) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage full / disabled */ }
    }

    function recordPlay(clear: boolean, seconds?: number, moveCount?: number) {
      const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: null, bestScore: null, bestMoves: null });
      if (!clear) {
        stats.plays = Number(stats.plays || 0) + 1;
      } else {
        stats.clears = Number(stats.clears || 0) + 1;
        // bestTime = MIN seconds across sessions
        if (typeof seconds === 'number') {
          stats.bestTime = stats.bestTime ? Math.min(Number(stats.bestTime), seconds) : seconds;
        }
        // bestMoves = MIN moves across sessions
        if (typeof moveCount === 'number') {
          stats.bestMoves = stats.bestMoves ? Math.min(Number(stats.bestMoves), moveCount) : moveCount;
        }
      }
      writeJson(statsKey, stats);
      const profile = readJson(profileKey, { achievements: [] });
      profile.lastPlayed = 'Slide';
      if (!clear) {
        profile.totalPlays = Number(profile.totalPlays || 0) + 1;
      } else {
        profile.clears = Number(profile.clears || 0) + 1;
        profile.clearStreak = Number(profile.clearStreak || 0) + 1;
        profile.lastCleared = 'Slide';
        const earned = ['first-win', 'slide-solver'];
        if (Number(profile.clearStreak || 0) >= 3) earned.push('three-game-streak');
        profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
      }
      writeJson(profileKey, profile);
    }

    // --- Daily Noun seed, America/Los_Angeles ---
    function dayOfYearPT(): { year: number; doy: number; label: string } {
      const now = new Date();
      const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit',
      });
      const parts = fmt.format(now); // YYYY-MM-DD
      const [y, m, d] = parts.split('-').map((s) => parseInt(s, 10));
      const start = Date.UTC(y, 0, 0);
      const cur = Date.UTC(y, m - 1, d);
      const doy = Math.floor((cur - start) / 86400000);
      const label = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Los_Angeles', month: 'short', day: 'numeric', year: 'numeric',
      }).format(now);
      return { year: y, doy, label };
    }
    const { year, doy, label: dateLabel } = dayOfYearPT();
    const daySeed = year * 1000 + doy;
    const nounId = (daySeed * 7) % 1200;
    const nounUrl = 'https://noun.pics/' + nounId + '.svg';

    // --- Elements (all guarded) ---
    const boardEl = document.querySelector<HTMLElement>('[data-board]');
    const movesEl = document.querySelector<HTMLElement>('[data-moves]');
    const timeEl = document.querySelector<HTMLElement>('[data-time]');
    const bestEl = document.querySelector<HTMLElement>('[data-best]');
    const statusEl = document.querySelector<HTMLElement>('[data-status]');
    const targetEl = document.querySelector<HTMLElement>('[data-target]');
    const solvedEl = document.querySelector<HTMLElement>('[data-solved]');
    const solvedLineEl = document.querySelector<HTMLElement>('[data-solved-line]');
    const newBtn = document.querySelector<HTMLButtonElement>('[data-new]');
    const newBtn2 = document.querySelector<HTMLButtonElement>('[data-new-2]');
    const peekBtn = document.querySelector<HTMLButtonElement>('[data-peek]');

    // Board is the one element we truly cannot run without.
    if (!boardEl) throw new Error('slide: board missing');

    // --- State ---
    // board[pos] = tile value (0..15); 15 is the blank
    const SOLVED = Array.from({ length: TILES }, (_, i) => i);
    let board = SOLVED.slice();
    let blankPos = BLANK;
    let moves = 0;
    let startTime = 0;
    let elapsed = 0;
    let running = false;
    let solved = false;
    let timerRAF = 0;

    if (targetEl) targetEl.textContent = 'Noun #' + nounId + ' — ' + dateLabel;

    function fmtTime(s: number): string {
      const total = Math.max(0, Math.floor(s));
      const mm = Math.floor(total / 60).toString().padStart(2, '0');
      const ss = (total % 60).toString().padStart(2, '0');
      return mm + ':' + ss;
    }

    function renderBest() {
      const stats = readJson(statsKey, { bestTime: null, bestMoves: null });
      if (!bestEl) return;
      if (stats.bestTime) {
        const t = fmtTime(Number(stats.bestTime));
        bestEl.textContent = stats.bestMoves ? t + ' / ' + Number(stats.bestMoves) + 'm' : t;
      } else {
        bestEl.textContent = '--';
      }
    }

    function bgPosFor(value: number): string {
      // value is the tile's home index in the solved image (0..15)
      const r = Math.floor(value / N);
      const c = value % N;
      // background-size 400% 400% => percentage positioning aligns col/row
      const x = (c / (N - 1)) * 100;
      const y = (r / (N - 1)) * 100;
      return x + '% ' + y + '%';
    }

    function buildBoard() {
      boardEl!.innerHTML = '';
      for (let pos = 0; pos < TILES; pos++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'tile';
        cell.setAttribute('data-pos', String(pos));
        boardEl!.appendChild(cell);
      }
      paintBoard();
    }

    function paintBoard() {
      const cells = boardEl!.querySelectorAll<HTMLButtonElement>('.tile');
      cells.forEach((cell, pos) => {
        const value = board[pos];
        if (value === BLANK && !solved) {
          cell.classList.add('blank');
          cell.style.backgroundImage = '';
          cell.setAttribute('aria-label', 'gap');
          cell.setAttribute('aria-disabled', 'true');
        } else {
          cell.classList.remove('blank');
          cell.removeAttribute('aria-disabled');
          cell.style.backgroundImage = "url('" + nounUrl + "')";
          cell.style.backgroundSize = '400% 400%';
          cell.style.backgroundPosition = bgPosFor(value);
          cell.setAttribute('aria-label', 'tile ' + (value + 1));
        }
      });
    }

    function neighborsOf(pos: number): number[] {
      const r = Math.floor(pos / N);
      const c = pos % N;
      const out: number[] = [];
      if (r > 0) out.push(pos - N);
      if (r < N - 1) out.push(pos + N);
      if (c > 0) out.push(pos - 1);
      if (c < N - 1) out.push(pos + 1);
      return out;
    }

    function shuffle() {
      board = SOLVED.slice();
      blankPos = BLANK;
      let prev = -1;
      for (let i = 0; i < 240; i++) {
        const nbrs = neighborsOf(blankPos).filter((p) => p !== prev);
        const pool = nbrs.length ? nbrs : neighborsOf(blankPos);
        const pick = pool[Math.floor(Math.random() * pool.length)];
        prev = blankPos;
        board[blankPos] = board[pick];
        board[pick] = BLANK;
        blankPos = pick;
      }
      // Guard: near-impossible, but never hand the player a solved board.
      if (isSolved()) {
        const nbrs = neighborsOf(blankPos);
        const q = nbrs[0];
        board[blankPos] = board[q];
        board[q] = BLANK;
        blankPos = q;
      }
    }

    function isSolved(): boolean {
      for (let i = 0; i < TILES; i++) if (board[i] !== i) return false;
      return true;
    }

    function tick() {
      if (!running) return;
      elapsed = (Date.now() - startTime) / 1000;
      if (timeEl) timeEl.textContent = fmtTime(elapsed);
      timerRAF = requestAnimationFrame(tick);
    }

    function startTimer() {
      startTime = Date.now() - elapsed * 1000;
      running = true;
      cancelAnimationFrame(timerRAF);
      timerRAF = requestAnimationFrame(tick);
    }
    function stopTimer() {
      running = false;
      cancelAnimationFrame(timerRAF);
    }

    function newGame() {
      stopTimer();
      solved = false;
      moves = 0;
      elapsed = 0;
      if (movesEl) movesEl.textContent = '0';
      if (timeEl) timeEl.textContent = '00:00';
      if (solvedEl) solvedEl.hidden = true;
      shuffle();
      paintBoard();
      if (statusEl) statusEl.textContent = 'Shuffled. Your first move starts the timer.';
      recordPlay(false);
      running = false; // timer starts on first move
    }

    function tryMoveTileAt(pos: number) {
      if (solved) return;
      if (!neighborsOf(pos).includes(blankPos)) return; // not adjacent to blank
      board[blankPos] = board[pos];
      board[pos] = BLANK;
      blankPos = pos;
      afterMove();
    }

    // dir = the arrow pressed; the tile on that side of the blank slides in.
    function moveByDir(dir: string) {
      if (solved) return;
      const r = Math.floor(blankPos / N);
      const c = blankPos % N;
      let src = -1;
      if (dir === 'up' && r < N - 1) src = blankPos + N;        // tile below slides up
      else if (dir === 'down' && r > 0) src = blankPos - N;     // tile above slides down
      else if (dir === 'left' && c < N - 1) src = blankPos + 1; // tile right slides left
      else if (dir === 'right' && c > 0) src = blankPos - 1;    // tile left slides right
      if (src < 0) return;
      board[blankPos] = board[src];
      board[src] = BLANK;
      blankPos = src;
      afterMove();
    }

    function afterMove() {
      if (!running && !solved) startTimer();
      moves++;
      if (movesEl) movesEl.textContent = String(moves);
      paintBoard();
      if (isSolved()) {
        win();
      } else if (statusEl) {
        statusEl.textContent = 'Moves: ' + moves + '. Keep sliding.';
      }
    }

    function win() {
      solved = true;
      stopTimer();
      const secs = Math.max(1, Math.round(elapsed));
      paintBoard(); // reveal full noun (blank tile now shows its image)
      recordPlay(true, secs, moves);
      renderBest();
      if (solvedLineEl) solvedLineEl.textContent = 'Noun #' + nounId + ' in ' + fmtTime(secs) + ' · ' + moves + ' moves';
      if (solvedEl) solvedEl.hidden = false;
      if (statusEl) statusEl.textContent = 'Solved! Noun #' + nounId + ' reassembled.';
    }

    let peekTimer = 0;
    function peek() {
      if (solved) return;
      boardEl!.classList.add('peeking');
      boardEl!.querySelectorAll<HTMLButtonElement>('.tile').forEach((cell, pos) => {
        cell.style.backgroundImage = "url('" + nounUrl + "')";
        cell.style.backgroundSize = '400% 400%';
        cell.style.backgroundPosition = bgPosFor(pos);
        cell.classList.remove('blank');
      });
      if (statusEl) statusEl.textContent = 'Peeking at the full Noun…';
      window.clearTimeout(peekTimer);
      peekTimer = window.setTimeout(() => {
        boardEl!.classList.remove('peeking');
        if (!solved) {
          paintBoard();
          if (statusEl) statusEl.textContent = 'Back to the puzzle.';
        }
      }, 1100);
    }

    // --- Events ---
    boardEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const t = target ? target.closest('.tile') as HTMLElement | null : null;
      if (!t) return;
      const pos = Number(t.getAttribute('data-pos'));
      if (Number.isInteger(pos)) tryMoveTileAt(pos);
    });

    window.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      let dir = '';
      if (e.key === 'ArrowUp') dir = 'up';
      else if (e.key === 'ArrowDown') dir = 'down';
      else if (e.key === 'ArrowLeft') dir = 'left';
      else if (e.key === 'ArrowRight') dir = 'right';
      if (dir) { e.preventDefault(); moveByDir(dir); }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => {
      b.addEventListener('click', () => moveByDir(b.getAttribute('data-dir') || ''));
    });

    newBtn?.addEventListener('click', newGame);
    newBtn2?.addEventListener('click', newGame);
    peekBtn?.addEventListener('click', peek);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        // Freeze accumulated time and cancel the RAF loop so it can't leak.
        if (running) {
          elapsed = (Date.now() - startTime) / 1000;
          running = false;
        }
        cancelAnimationFrame(timerRAF);
      } else if (!solved && moves > 0) {
        startTimer(); // resumes from accumulated elapsed
      }
    });

    // --- Boot ---
    renderBest();
    buildBoard();
    newGame();
  }
</script>
<style>
  :global(body) { background: #008080; }
  .desk {
    background: #008080;
    font-family: "MS Sans Serif", Tahoma, system-ui, sans-serif;
    min-height: calc(100vh - 88px);
    padding: 18px;
  }
  .desk *, .desk *::before, .desk *::after { box-sizing: border-box; }
  .window {
    max-width: 1040px;
    margin: 0 auto;
    background: #c0c0c0;
    border: 2px solid;
    border-color: #fff #404040 #404040 #fff;
    box-shadow: 2px 2px 0 #000;
  }
  .titlebar {
    background: linear-gradient(90deg, #000080, #1084d0);
    color: #fff; font-weight: 700; font-size: 13px; padding: 3px 5px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .buttons { display: flex; gap: 2px; }
  .buttons i {
    width: 19px; height: 18px; display: grid; place-items: center;
    border: 2px solid; border-color: #fff #404040 #404040 #fff;
    background: #c0c0c0; color: #000; font-style: normal; font-size: 11px; line-height: 1;
  }
  .menubar {
    display: flex; gap: 2px; padding: 4px 5px; border-bottom: 1px solid #808080;
    flex-wrap: wrap; align-items: center;
  }
  .menubar button, .menubar a {
    border: 0; background: transparent; color: #000; padding: 4px 8px;
    text-decoration: none; font-family: inherit; font-size: 12px; cursor: pointer;
  }
  .menubar button:hover, .menubar a:hover { background: #000080; color: #fff; }
  .menubar button:focus-visible, .menubar a:focus-visible { outline: 1px dotted #000; outline-offset: -3px; }
  .hero {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; padding: 14px 16px 6px; flex-wrap: wrap;
  }
  .kicker {
    font: 700 10px/1 "Courier New", monospace; letter-spacing: .12em;
    color: #000080; text-transform: uppercase; margin: 0 0 6px;
  }
  h1 {
    font-size: clamp(30px, 6vw, 64px); line-height: .94; font-weight: 700; margin: 0;
    color: #000;
  }
  .how { margin: 8px 0 4px; font-size: 12px; color: #202020; max-width: 42ch; }
  .target {
    margin: 2px 0 0; font: 700 12px/1.2 "Courier New", monospace; color: #D22209;
  }
  .meters { display: flex; gap: 8px; flex-wrap: wrap; }
  .meters span {
    border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff;
    padding: 5px 9px; font-size: 12px; color: #000; white-space: nowrap;
  }
  .meters strong { font-family: "Courier New", monospace; color: #000080; }
  .playframe {
    margin: 8px 16px 14px; padding: 10px;
    border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff;
    position: relative;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 2px;
    width: min(440px, 82vw);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    background: #808080;
    border: 2px solid; border-color: #404040 #fff #fff #404040;
    padding: 2px;
  }
  /* Board cells are injected via innerHTML, so they miss Astro's scope attribute — anchor them to the scoped board instead. */
  .board :global(.tile) {
    border: 2px solid; border-color: #fff #404040 #404040 #fff;
    background-color: #d5d7e3;
    background-repeat: no-repeat;
    padding: 0; margin: 0; cursor: pointer;
    image-rendering: pixelated;
    transition: filter .08s ease;
    min-width: 0;
    font-size: 0;
  }
  .board :global(.tile:hover:not(.blank)) { filter: brightness(1.06); }
  .board :global(.tile:active:not(.blank)) { border-color: #404040 #fff #fff #404040; }
  .board :global(.tile:focus-visible) { outline: 2px solid #ffff00; outline-offset: -4px; }
  .board :global(.tile.blank) {
    background: #c0c0c0;
    border-color: #808080 #b8b8b8 #b8b8b8 #808080;
    cursor: default;
  }
  .board.peeking :global(.tile) { border-color: #F7C325 #b8951a #b8951a #F7C325; }
  .solved {
    position: absolute; inset: 10px; display: grid; place-items: center;
    background: rgba(0, 0, 128, .55); z-index: 4;
  }
  .solved[hidden] { display: none; }
  .solved-card {
    background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff;
    box-shadow: 2px 2px 0 #000; padding: 18px 22px; text-align: center; max-width: 320px;
  }
  .solved-kicker {
    font: 700 12px/1 "Courier New", monospace; letter-spacing: .18em;
    color: #D22209; margin: 0 0 8px;
  }
  .solved-line { font-size: 13px; color: #000; margin: 0 0 14px; }
  .solved-card button {
    font-family: inherit; font-size: 12px; padding: 6px 16px; cursor: pointer;
    background: #c0c0c0; color: #000;
    border: 2px solid; border-color: #fff #404040 #404040 #fff;
  }
  .solved-card button:active { border-color: #404040 #fff #fff #404040; }
  .dpad {
    display: none; margin: 0 16px 12px; flex-direction: column; align-items: center; gap: 4px;
  }
  .dpad-row { display: flex; gap: 4px; }
  .dpad button {
    width: 52px; height: 44px; font-size: 18px; cursor: pointer;
    background: #c0c0c0; color: #000; font-family: inherit;
    border: 2px solid; border-color: #fff #404040 #404040 #fff;
  }
  .dpad button:active { border-color: #404040 #fff #fff #404040; }
  .status {
    margin: 0; padding: 6px 10px;
    border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff;
    font-size: 12px; color: #000;
  }
  @media (prefers-reduced-motion: reduce) {
    .board :global(.tile) { transition: none; }
  }
  @media (max-width: 760px) {
    .desk { padding: 8px; }
    .hero { padding: 10px 10px 4px; }
    .playframe { margin: 8px 10px 10px; }
    .board { width: min(94vw, 380px); }
    .meters { width: 100%; }
    .dpad { display: flex; }
    h1 { font-size: clamp(26px, 9vw, 40px); }
  }
</style>
</BlockLayout>
