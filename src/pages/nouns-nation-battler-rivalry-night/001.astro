---
import BlockLayout from '../../layouts/BlockLayout.astro';
import BattlerReplay from '../../components/BattlerReplay.astro';
import { RIVALRY_NIGHT_META as meta, RIVALRY_NIGHT_RECORD as record, RIVALRY_NIGHT_STANDOUT as standout } from '../../lib/battler-rivalry-night';
const { match, catalog } = record;
const left = catalog.gangs.find(g => g.id === match.input.left.gang)!;
const right = catalog.gangs.find(g => g.id === match.input.right.gang)!;
const winner = match.winner === 'draw' ? null : catalog.gangs.find(g => g.id === match.input[match.winner].gang)!;
const duration = (match.durationMs / 1000).toFixed(1);
const title = `${meta.title} · ${left.name} vs ${right.name}`;
const description = `Red pressure. Blue patience. Watch the saved ${duration}-second Nouns exhibition, read the result, then bring your own tactic to the rematch.`;
---
<BlockLayout title={title} description={description} image="/images/og/nouns-battler-rivalry-night-001.png" imageWidth={1200} imageHeight={630} themeColor="#8a2432" alternates={[{ type: 'application/json', href: meta.jsonUrl, title: 'Rivalry Night result and replay' }]} jsonLd={{ '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: meta.publishedAt, url: meta.canonical, publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' }, isAccessibleForFree: true }}>
  <link rel="stylesheet" href="/games/nouns-nation-battler/agent-arena.css" />
  <main class="arena-app rivalry-night" data-rivalry-record={meta.recordUrl} data-match-hash={record.matchHash}>
    <nav aria-label="Battler navigation"><a href="/noun-battler-annual#league">← The Battle Record</a><a href="/nouns-nation-battler-arena/">Choose your gang ↗</a></nav>
    <header>
      <p class="eyebrow">RIVALRY NIGHT 001 / SEPTEMBER 15, 2026</p>
      <h1>Red pressure.<br /><span>Blue patience.</span></h1>
      <p class="lead">Tomato Noggles rush the line. Cobalt Frames hold their ground. Twenty-four Nouns, two tactics, and one opening exhibition we can all return to.</p>
      <div class="hero-actions"><a class="action primary" href="#replay">Watch the {duration}s replay ↓</a><a class="action" href={meta.rematchUrl}>Try the rematch →</a></div>
      <p class="edition-note">Published exhibition · Free to watch and play · Replay starts when you press Play</p>
    </header>
    <section class="result-card" aria-labelledby="result-title">
      <div class="result-top"><span class="eyebrow">THE SHARED RESULT / FINAL</span><span>{duration} seconds · {match.reason === 'elimination' ? 'Elimination' : 'Time limit'}</span></div>
      <div class="final-score">
        <div class="team red"><img src="/games/nouns-nation-battler/assets/noun-0.svg" alt="" width="76" height="76" /><div><h2>{left.name}</h2><p>Rush · 12 starters</p></div><strong>{match.survivors.left}</strong></div>
        <div class="team blue"><img src="/games/nouns-nation-battler/assets/noun-7.svg" alt="" width="76" height="76" /><div><h2>{right.name}</h2><p>Guard · 12 starters</p></div><strong>{match.survivors.right}</strong></div>
      </div>
      <h2 id="result-title">{winner ? `${winner.name} hold the field.` : 'The opening exhibition ends level.'}</h2>
      <p>The score counts Nouns still standing. Cobalt’s Guard takes two damage off each incoming hit; Tomato’s Rush closes the distance faster. In this meeting, the blue line lasts.</p>
      <p class="record-note">This is the saved opening result for everyone. Your practice rematches have their own outcomes and leave this record unchanged.</p>
    </section>
    <section id="replay" class="replay-section" aria-labelledby="replay-title">
      <div class="section-heading"><div><p class="eyebrow">ROLL THE TAPE</p><h2 id="replay-title">See how the line held.</h2></div><span>12 v 12 / RUSH v GUARD</span></div>
      <p id="arena-status" role="status" aria-live="polite">Loading the published replay…</p>
      <BattlerReplay />
      <p class="replay-key">R runner · B bonker · S slinger · C captain · H healer. White marker: Tomato. Dark marker: Cobalt.</p>
      <details class="recap"><summary>Read the match events</summary><ol id="arena-events" aria-label="Tactical event feed"><li>Press Play to follow the match, or scrub to a moment.</li></ol><p class="hint">The event feed is a selection; the saved replay includes every Noun’s position and health.</p></details>
      <noscript><p>The score above is complete. Playback requires JavaScript; <a href={meta.recordUrl}>download the saved match record</a> to inspect every frame.</p></noscript>
    </section>
    <section class="after-match" aria-label="After the match">
      {standout && <article class="survivor"><p class="eyebrow">STILL STANDING</p><img src={`/games/nouns-nation-battler/assets/noun-${standout.nounId}.svg`} alt={`Cobalt Frames Noun ${standout.nounId}`} width="100" height="100" /><h2>Noun #{standout.nounId}<br /><span>{standout.role}</span></h2><p>{standout.hp}/{standout.maxHp} health at the final whistle.</p><p class="hint">Selected for the highest health percentage among Cobalt’s survivors, then remaining health and unit ID.</p></article>}
      <article class="rematch"><p class="eyebrow">YOUR NEXT MOVE</p><h2>Can you break<br />the blue line?</h2><p>Keep the same teams and match seed. Try <strong>Flank</strong> against Guard, or defend with a different tactic. You choose when to run it.</p><a class="action primary" href={meta.rematchUrl}>Set up your free rematch →</a><p class="hint">Practice is free and needs no wallet. Gang colors are identity; tactics and rosters shape play.</p></article>
    </section>
    <section class="share-record" aria-labelledby="share-title"><p class="eyebrow">PASS THE SCORE AROUND</p><h2 id="share-title">One link. The same match.</h2><p>Send the opening exhibition to a friend or an agent. They’ll get this result and this replay.</p><div class="share-row"><label for="rivalry-link">Public match link<input id="rivalry-link" type="url" readonly value={meta.canonical} /></label><button id="rivalry-copy" type="button">Copy match link</button></div><p id="rivalry-share-status" role="status" aria-live="polite"></p></section>
    <details class="record-details"><summary>The match record</summary><p>Published from the shared exhibition engine and checked against the free PointCast server result. The inputs, catalog and replay frames are saved with this edition.</p><dl><div><dt>Rules</dt><dd>{match.rulesVersion}</dd></div><div><dt>Match seed</dt><dd>{match.input.seed}</dd></div><div><dt>SHA-256 match hash</dt><dd class="hash">{record.matchHash}</dd></div></dl><p><a href={meta.recordUrl} download>Download the original record</a> · <a href={meta.jsonUrl}>Machine edition</a></p><p>This exhibition is separate from the browser-local 30-v-30 season and the archived Season 6 proposal. No shared season table or next fixture has been announced.</p></details>
    <footer><span>POINTCAST / CH.BTL / ONE FOR THE SCOREBOOK</span><a href="/noun-battler-annual#league">Meet all eight gangs →</a></footer>
  </main>
  <script is:inline type="module" src="/games/nouns-nation-battler/rivalry-night.js"></script>
</BlockLayout>
<style>
.rivalry-night{--ink:#252720;--paper:#fff9eb;--red:#a52d3d;--blue:#3262ae;max-width:1080px;padding:26px 22px 64px}.rivalry-night nav{font-size:.78rem;font-weight:750;text-transform:uppercase;letter-spacing:.04em;border-bottom:2px solid var(--ink);padding-bottom:18px}.rivalry-night header{max-width:900px;padding:54px 0 34px}.rivalry-night h1{color:var(--red);font-size:clamp(3rem,8vw,6.7rem);line-height:.97;letter-spacing:-.06em}.rivalry-night h1 span{color:var(--blue)}.lead{max-width:670px;font-size:1.13rem}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0 14px}.action{display:inline-block;border:2px solid var(--ink);padding:13px 18px;font-weight:800;background:var(--paper);line-height:1.3;text-decoration:none;min-height:46px}.action.primary{background:#ffcf58}.action:hover{background:#f4bd3f}.edition-note,.record-note,.replay-key{font-size:.78rem;color:#55594d}.result-card{background:var(--paper);border:2px solid var(--ink);padding:24px}.result-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.75rem}.final-score{display:grid;grid-template-columns:1fr 1fr;margin:24px 0;gap:24px}.team{display:flex;align-items:center;gap:15px;min-width:0}.team img{flex:none;image-rendering:pixelated}.team div{flex:1;min-width:0}.team h2{font-size:clamp(1.1rem,2.5vw,1.7rem);line-height:1.1;margin:0}.team p{font-size:.75rem;margin:6px 0 0}.team strong{font-size:4.3rem;font-variant-numeric:tabular-nums;line-height:1}.red{color:var(--red)}.blue{color:var(--blue)}#result-title{font-size:clamp(1.5rem,3.3vw,2.1rem);margin:10px 0}.result-card>p{max-width:800px}.record-note{border-top:1px solid #d7d4c4;padding-top:14px}.replay-section{padding-top:48px;scroll-margin-top:20px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap}.section-heading h2{margin:7px 0}.section-heading>span{font-size:.72rem;font-weight:800;letter-spacing:.04em}.replay-key{text-align:center}.recap{padding:5px 0 20px}summary{cursor:pointer;font-weight:750;padding:12px 0}.after-match{display:grid;grid-template-columns:1fr 1.7fr;gap:24px;border-top:2px solid var(--ink);padding:32px 0}.after-match article{padding:22px;background:#f2f3e8;min-width:0}.after-match .rematch{background:#e7eef8}.survivor img{image-rendering:pixelated;float:right}.survivor h2{font-size:1.9rem}.survivor h2 span{text-transform:capitalize;font-size:1.2rem;font-weight:500}.rematch h2{line-height:1.03;margin:18px 0}.share-record{border-top:2px solid var(--ink);padding:25px 0}.share-row{display:flex;gap:12px;align-items:end;flex-wrap:wrap}.share-row label{flex:1;min-width:180px}.share-row input{width:100%;box-sizing:border-box;font-weight:500;font-size:.8rem}.share-row button{border:2px solid var(--ink);border-radius:0}.record-details{border-top:1px solid #b6b7aa;padding:14px 0;font-size:.85rem}.record-details dl>div{margin:12px 0}.record-details dt{font-weight:800}.record-details dd{margin:4px 0}.hash{overflow-wrap:anywhere;font-family:monospace}.record-details a{text-decoration:underline}.rivalry-night footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.65rem;font-weight:800;letter-spacing:.06em;border-top:2px solid var(--ink);padding-top:22px;margin-top:22px}.rivalry-night :focus-visible{outline:3px solid var(--blue);outline-offset:4px}@media(max-width:650px){.rivalry-night{padding:18px 12px 50px}.rivalry-night header{padding-top:36px}.final-score{grid-template-columns:1fr;gap:18px}.team{border-bottom:1px solid #ddd6c8;padding-bottom:14px}.team h2{font-size:1.4rem}.team strong{font-size:3.6rem}.result-card{padding:18px}.after-match{grid-template-columns:1fr}.survivor img{width:78px;height:78px}.hero-actions .action{width:100%;text-align:center}.share-row button{width:100%}}
</style>
