      let { x, y } = entityXY(k);
      if (k.state === 'fall') y += G.t * G.t * 300;
      const blink = G.phase === 'lost' && G.cause !== 'fall' && Math.floor(G.t * 8) % 2 === 1;
      if (blink && !REDUCED) return;
      drawCrab(x, Math.min(y, H + 20), k.face, blink ? 0.5 : 1);
    }
    function drawBorder() {
      const m = M();
      ctx.fillStyle = m.border;
      ctx.fillRect(0, 0, cssW, cssH);
      const label = G.attract ? 'DAWN' : response.label;
      const bars = G.loading > 0 ? 'load' : label === 'RUSH' ? 0.62 : label === 'FLOW' ? 0.34 : label === 'DAWN' ? 0.12 : 0;
      if (bars === 'load') {
        ctx.globalAlpha = REDUCED ? 0.5 : 0.9;
        for (let y = 0; y < cssH; y += 3) {
          // Reduced motion: a still, striped border instead of a per-frame strobe.
          const k = REDUCED ? Math.floor(y / 12) % m.raster.length : Math.floor(Math.random() * m.raster.length);
          ctx.fillStyle = m.raster[k]; ctx.fillRect(0, y, cssW, 3);
        }
        ctx.globalAlpha = 1;
      } else if (bars > 0) {
        const h = 6, speed = REDUCED ? 0 : (response.tempo / 60) * 40;
        const shift = (G.t * speed) % (m.raster.length * h * 2);
        ctx.globalAlpha = bars;
        // Color index and pixel offset both come from `base` and `f`, so the bars never snap backward.
        const f = shift % h, base = shift - f, period = m.raster.length * 2;
        for (let y = -period * h; y < cssH + h; y += h) {
          const idx = Math.round((y - base) / h);
          const k = ((idx % period) + period) % period;
          if (k >= m.raster.length) continue;
          ctx.fillStyle = m.raster[k];
          ctx.fillRect(0, y + f, cssW, h);
        }
        ctx.globalAlpha = 1;
      }
    }
    function drawField() {
      const m = M();
      ctx.fillStyle = m.field;
      ctx.fillRect(0, 0, W, H);
      // The shore below the pyramid: foam dashes drifting one way, one color, offset from a single value.
      const foam = py(ROWS) + 14;
      if (foam < H - 6) {
        const drift = REDUCED ? 0 : (G.t * 9) % 24;
        ctx.fillStyle = m.dim;
        for (let row = 0; row < 3; row += 1) {
          const y = foam + row * 9;
          if (y > H - 4) break;
          for (let x = -24 + ((drift + row * 8) % 24); x < W; x += 24) {
            const x0 = Math.max(0, Math.round(x)), x1 = Math.min(W, Math.round(x) + 10);
            if (x1 > x0) ctx.fillRect(x0, y, x1 - x0, 1);
          }
        }
      }
      if (G.flash > 0) { ctx.globalAlpha = Math.min(REDUCED ? 0.12 : 0.45, G.flash); ctx.fillStyle = m.bright; ctx.fillRect(0, 0, W, H); ctx.globalAlpha = 1; }
    }
    function drawHud() {
      const m = M();
      const g = G.game;
      text(String(g.score).padStart(6, '0'), WALL + 2, 8, 3, m.bright);
      const label = response.label;
      const col = label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : label === 'DRIFT' ? soft() : m.bands.green;
      text(label, W / 2 + 10, 11, 2, col, 'center');
      if (unlimited()) text('CALM', W - WALL - 2, 11, 2, soft(), 'right');
      else {
        ctx.fillStyle = m.bands.red;
        for (let i = 0; i < Math.min(G.lives, 6); i += 1) { const x = W - WALL - 2 - (i + 1) * 9; ctx.fillRect(x, 13, 7, 3); ctx.fillStyle = m.paddle; ctx.fillRect(x + 1, 10, 4, 3); ctx.fillStyle = m.bands.red; }
      }
      ctx.fillStyle = m.text; ctx.globalAlpha = 0.5; ctx.fillRect(WALL, HUD - 2, W - 2 * WALL, 1); ctx.globalAlpha = 1;
      if (mood.tape.length) {
        const n = Math.min(60, mood.tape.length), start = mood.tape.length - n;
        for (let i = 0; i < n; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(WALL + i * 3, HUD - 6, 2, 2);
        }
      }
      // "Change to": the target top, and the rule.
      text('TO', WALL + 2, HUD + 8, 2, soft());
      const tx = WALL + 2 + textWidth('TO', 2) + 16;
      const tcy = HUD + 13;
      ctx.fillStyle = m.bands.green;
      for (let dy = -5; dy < 5; dy += 1) { const half = Math.round(10 * (1 - Math.abs(dy + 0.5) / 5)); if (half > 0) ctx.fillRect(tx - half, tcy + dy, half * 2, 1); }
      text(RULES[g.pyr.rule].label, W - WALL - 2, HUD + 8, 2, soft(), 'right');
    }
    function drawTouchGuides() {
      // Faint corner chevrons: the four quadrants a tap can pick.
      if (!COARSE || G.phase !== 'play') return;
      const m = M();
      ctx.globalAlpha = 0.4; ctx.fillStyle = m.text;
      const corners = [[WALL + 6, HUD + 30, -1, -1], [W - WALL - 6, HUD + 30, 1, -1], [WALL + 6, H - 12, -1, 1], [W - WALL - 6, H - 12, 1, 1]];
      for (const [x, y, sx, sy] of corners) {
        for (let i = 0; i < 6; i += 1) { ctx.fillRect(x - sx * i, y, 2, 2); ctx.fillRect(x, y - sy * i, 2, 2); }
      }
      ctx.globalAlpha = 1;
    }
    function drawPlay() {
      drawHud();
      drawCrabNow(true); drawHazards(true);
      drawPyramid(1);
      drawBuoys();
      drawHazards(false); drawCrabNow(false);
      for (const p of G.particles) {
        ctx.globalAlpha = 1 - p.t / p.life;
        ctx.fillStyle = p.color;
        ctx.fillRect(Math.round(p.x), Math.round(p.y), 2, 2);
      }
      ctx.globalAlpha = 1;
      drawTouchGuides();
      const m = M();
      const my = Math.min(H - 40, py(ROWS) + 6);
      if (G.phase === 'paused') {
        text('PAUSED', W / 2, my, 4, m.bright, 'center');
        text(COARSE ? 'TAP TO RESUME' : 'P OR SPACE TO RESUME', W / 2, my + 26, 2, m.paddle, 'center');
      } else if (G.msgT > 0 && G.msg) {
        text(G.msg, W / 2, my, 3, m.bright, 'center');
        if (G.msg2) text(G.msg2, W / 2, my + 22, 2, m.paddle, 'center');
      }
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawControlsCard(y) {
      const m = M();
      // A little cube with the four hops at its corners.
      const cx = W / 2, cy = y + 20;
      diamond(cx, cy, m.bands.yellow);
      ctx.fillStyle = m.bright;
      for (let i = 0; i < 8; i += 1) { ctx.fillRect(cx - 24 - i * 2, cy - 12 - i, 2, 1); ctx.fillRect(cx + 22 + i * 2, cy - 12 - i, 2, 1); ctx.fillRect(cx - 24 - i * 2, cy + 12 + i, 2, 1); ctx.fillRect(cx + 22 + i * 2, cy + 12 + i, 2, 1); }
      if (COARSE) {
        text('TAP A CORNER', W / 2, y - 12, 2, m.bright, 'center');
        text('UP-LEFT', WALL + 4, y - 4, 2, m.bright); text('UP-RIGHT', W - WALL - 4, y - 4, 2, m.bright, 'right');
        text('DOWN-LEFT', WALL + 4, y + 36, 2, m.bright); text('DOWN-RIGHT', W - WALL - 4, y + 36, 2, m.bright, 'right');
        text('HOLD TO KEEP HOPPING', W / 2, y + 54, 2, soft(), 'center');
      } else {
        text('Q OR LEFT', WALL + 4, y - 4, 2, m.bright); text('E OR UP', W - WALL - 4, y - 4, 2, m.bright, 'right');
        text('A OR DOWN', WALL + 4, y + 36, 2, m.bright); text('D OR RIGHT', W - WALL - 4, y + 36, 2, m.bright, 'right');
        text('OR CLICK A CORNER', W / 2, y + 54, 2, soft(), 'center');
      }
    }
    function drawTitle() {
      const m = M();
      ctx.globalAlpha = 0.22; drawPyramid(0.22); drawBuoys(); drawCrabNow(false); ctx.globalAlpha = 1;
      const top = 36 + Math.floor((H - H_MIN) * 0.3);
      rainbowText('SEA GLASS', W / 2, top, 6, [m.bands.green, m.raster[4], m.bands.yellow, m.bright]);
      text('TURN EVERY STONE', W / 2, top + 40, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}  DIAL ${DIALS[mood.dial].label}`, W / 2, top + 56, 2, m.bright, 'center');
      drawControlsCard(top + 98);
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY' : 'CLICK OR PRESS SPACE', W / 2, top + 182, 2, m.paddle, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, top + 202, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 20, 2, soft(), 'center');
    }
    function drawOver() {
      const m = M();
      drawHud();
      drawPyramid(0.3);
      text('GAME OVER', W / 2, 118, 5, m.bright, 'center');
      text(`SCORE ${String(G.game.score).padStart(6, '0')}`, W / 2, 172, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 188, 2, m.bands.yellow, 'center');
      text(`PYRAMIDS ${G.game.level}  PEAK ${mood.peak}`, W / 2, 204, 2, soft(), 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY AGAIN' : 'CLICK OR SPACE TO PLAY AGAIN', W / 2, 256, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawField();
      if (G.phase === 'title') { drawTitle(); return; }
      if (G.phase === 'over') { drawOver(); return; }
      drawPlay();
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const g = G.game;
        readout.mood.textContent = `${G.attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${G.attract ? 100 : response.tempo} BPM ${G.attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.vec.textContent = g ? `GLASS ${CUBES - remaining(g.pyr)}/${CUBES}` : 'GLASS 0/28';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    /** Start, skip or resume. Returns true when it consumed the press. */
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return true; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return true; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); return true; }
      return false;
    }
    function hop(dir) {
      if (G.phase !== 'play' || !G.game) return;
      queueHop(G.game, dir);
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      if (action()) return;
      const p = pointerToField(e);
      const dir = quadrantDir(p.x, p.y, W / 2, H / 2);
      G.hold = { dir, t: 0, id: e.pointerId };
      hop(dir);
    });
    canvas.addEventListener('pointermove', (e) => {
      // Sliding a held finger into another quadrant turns the held hop that way.
      if (!G.hold || G.hold.id !== e.pointerId) return;
      const p = pointerToField(e);
      G.hold.dir = quadrantDir(p.x, p.y, W / 2, H / 2);
    });
    const release = (e) => { if (G.hold && G.hold.id === e.pointerId) G.hold = null; };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('lostpointercapture', release);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; hop keys and letters still reach the game from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (KEYMAP[k]) {
        e.preventDefault();
        if (e.repeat) return;
        audio.unlock();
        if (G.phase === 'boot' || G.phase === 'title' || G.phase === 'over' || G.phase === 'paused') { action(); return; }
        G.keys[k] = true;
        G.keyOrder = G.keyOrder.filter((x) => x !== k).concat(k);
        hop(KEYMAP[k]);
        return;
      }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); action(); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; G.keyOrder = G.keyOrder.filter((x) => x !== e.code); });
    function releaseAll() { G.keys = {}; G.keyOrder = []; G.hold = null; }
    function togglePause() {
      if (G.phase === 'play') { G.resume = 'play'; G.phase = 'paused'; releaseAll(); audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        releaseAll();
        if (G.phase === 'play') { G.resume = 'play'; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', releaseAll);
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      // The new dial shapes the pyramids still to come; the current one keeps its rule.
      if (G.game && !G.attract) setGameDial(G.game, next);
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}.`);
      if (G.phase === 'play' || G.phase === 'title') showMsg(DIALS[next].label, '', 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space plays again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
