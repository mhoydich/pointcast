---
/**
 * /sea-glass — turn every stone. A cube-hopping pyramid game for PointCast's
 * cabinet row, after Gottlieb's 1982 Q*bert (Warren Davis and Jeff Lee).
 *
 * Directed by Michael Hoydich (2026-10-22): 80s innocence, the joy of the
 * compute and flow, mood-state symbiosis, mobile and full screen, audio-visual
 * multimedia, Atari and Commodore inspired, rendered modern. A wave-two thread.
 *
 * The playfield is drawn on a canvas from the shared 3x5 pixel font, plain
 * rects and original sprites; every sound is synthesized in the browser.
 * Pure logic lives in src/lib/sea-glass (pyramid, sprites) and the shared
 * src/lib/breakwater modules, covered by tests/sea-glass.test.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';

const description = 'A cube-hopping pyramid game with 1980s innocence: a hermit crab turns twenty-eight cubes from sand to sea glass in Atari 800XL or Commodore 64 colors, with bubbles, a gull, two lifebuoys, synthesized chip sound and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/sea-glass';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Sea Glass',
      alternateName: 'Sea Glass: turn every stone',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/sea-glass/og.png',
      gamePlatform: 'Web browser',
      genre: 'Action puzzle',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Sea Glass', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Sea Glass"
  description={description}
  image="/images/sea-glass/og.png"
  imageAlt="A pyramid of isometric cubes on a blue field, some tops sand and some sea-glass green, with a small hermit crab hopping on top beside the words Sea Glass, turn every stone."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/sea-glass.json', title: 'Sea Glass rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/sea-glass/og.png',
    buttons: [
      { label: 'Play Sea Glass', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="sg" data-sg data-machine="xl" data-crt="on">
    <div class="sg-stage" data-stage>
      <header class="sg-bar">
        <a class="sg-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="sg-name" aria-hidden="true">SEA GLASS</span>
        <div class="sg-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="sg-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Sea Glass playfield. Tap a corner of the field, or press Q, E, A or D, to hop the crab that way."></canvas>
        <div class="sg-scan" aria-hidden="true"></div>
        <noscript><p class="sg-noscript">Sea Glass needs JavaScript to draw the pyramid and make its sounds. The rules and moods are readable at <a href="/sea-glass.json">/sea-glass.json</a>.</p></noscript>
      </div>
      <footer class="sg-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-wave>PYRAMID 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-vec>GLASS 0/28</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="sg-notes">
      <p class="sg-eyebrow">PointCast / Games / Sea Glass</p>
      <h1>Turn every stone.</h1>
      <p class="sg-lede">Twenty-eight cubes stacked seven rows high, a hermit crab on top, and every landing turns a cube from sand to sea glass. Turn them all and the shore builds another.</p>

      <div class="sg-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Every cube you turn raises its <strong>energy</strong>, and every full row raises it more. A fall or a hazard lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="sg-moods">
            <li><b>DAWN</b> warming up. Cool sea glass, a slow major arpeggio, a little more room between bubbles.</li>
            <li><b>FLOW</b> a run of cubes without a slip. Brighter glass, the music opens up.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, a faster tempo, quicker hazards, and in a long run one more bubble.</li>
            <li><b>DRIFT</b> after losses. The bubbles slow, the gull flies off and stays away, the notes thin out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.id === 'calm' ? 'no game over; a fall puts the crab back on top' : d.id === 'rush' ? 'more bubbles, and two landings per cube sooner' : 'three crabs, an extra crab every 6000 points'}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave after playing, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue text. Raw square waves with a noise bite, in the POKEY spirit. A blue READY and a RUN before the pyramid.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The crab, the bubble, the gull, the lifebuoys, the music and the palettes were made for this page; there is no arcade character, no speech balloon and no Gottlieb art. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-sea-glass-notes.md">research note on the 1982 original</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Each landing turns a cube's top: 25 points for sea glass, 15 for the frosted step between. The first pyramids need one landing per cube; later ones need two; later still, landing on finished glass turns it back to sand. Clearing a pyramid scores 1000 plus 250 for each pyramid before it (up to eight), and 50 for each lifebuoy left floating. Bubbles drop in at the top and bounce down at random. The gull follows you; take a lifebuoy with the gull close behind and it follows you off the edge for 500. Hopping off the pyramid, or touching a bubble or the gull, costs a crab.</p>
          <h2>Controls</h2>
          <ul>
            <li>Touch or mouse: tap the quadrant of the field you want to hop toward (top-left is up-left, bottom-right is down-right). Hold to keep hopping.</li>
            <li>Keys: Q up-left, E up-right, A down-left, D down-right. Arrows turned 45 degrees, as the 1983 home ports did: ↑ up-right, ← up-left, ↓ down-left, → down-right. Hold a key to keep hopping.</li>
            <li>Space starts, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="sg-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026. Original code, art and synthesized sound; no ROMs, no recordings. Q*bert, Gottlieb and the machine names are mentioned as history and tribute.</p>
        <p><a href="/cabinet-row">Cabinet Row</a> · <a href="/sea-glass.json">sea-glass.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .sg { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .sg[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .sg-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .sg-stage:fullscreen { height: 100%; min-height: 0; }
  .sg-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .sg-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .sg-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .sg-home:hover { color: #fff; }
  .sg-name { color: #fff; font-weight: 700; margin-right: auto; }
  .sg-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .sg-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .sg-controls button:hover { background: #1f2456; }
  .sg-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .sg-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .sg-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .sg-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: pointer; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sg-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .sg[data-crt='off'] .sg-scan { display: none; }
  .sg-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .sg-noscript a { color: var(--paddle); }
  .sg-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .sg-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .sg-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .sg-readout a:hover { color: #fff; }
  .sg-stage:fullscreen .sg-readout a { display: none; }
  .sg-stage:-webkit-full-screen .sg-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sg-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .sg-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .sg-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .sg-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .sg-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .sg-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .sg-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .sg-grid h2 + h2, .sg-grid p + h2, .sg-grid ul + h2 { margin-top: 22px; }
  .sg-grid p { margin: 0 0 12px; }
  .sg-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .sg-grid li { margin-bottom: 6px; }
  .sg-moods { list-style: none; padding: 0; }
  .sg-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .sg-notes a { color: #a9b9f5; }
  .sg-notes a:hover { color: #fff; }
  .sg-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .sg-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .sg-stage { min-height: 0; }
    .sg-bar { gap: 8px; padding: 6px 10px; }
    .sg-name { display: none; }
    .sg-controls { gap: 4px; }
    .sg-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .sg-readout { gap: 10px; font-size: 9px; height: 26px; }
    .sg-readout [data-r-vec], .sg-readout [data-r-fps] { display: none; }
    .sg-grid { grid-template-columns: 1fr; gap: 20px; }
    .sg-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .sg-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { ROWS, CUBES, KEYMAP, RULES, onPyramid, cubeIndex, screenOf, quadrantDir, createGame, queueHop, stepGame, respawn, nextPyramid, setGameDial, autoDir, posOf, remaining } from '../lib/sea-glass/pyramid.mjs';
  import { CRAB, BUBBLE, GULL, GULL_FLAP, eachSpritePixel, eachBuoyPixel } from '../lib/sea-glass/sprites.mjs';

  const root = document.querySelector('[data-sg]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = 288, H_MIN = 384, H_MAX = 480, WALL = 8, HUD = 32;
    let H = H_MIN;
    // One cube: an 18-pixel half width, a 9-pixel half-height top, 20-pixel sides; one row down is 29.
    const CW = 18, TH = 9, SH = 20, RY = TH + SH;
    let X0 = W / 2, Y0 = 84;
    const LIVES = 3;
    const STORE = 'sea-glass:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      wave: root.querySelector('[data-r-wave]'),
      fps: root.querySelector('[data-r-fps]'),
      vec: root.querySelector('[data-r-vec]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) && settings.best > 0 ? Math.floor(settings.best) : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const toHex = (c) => `#${c.map((v) => v.toString(16).padStart(2, '0')).join('')}`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return toHex([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    const unlimited = () => DIALS[mood.dial].unlimitedBalls;

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // A shoreline loop: the same four-chord shapes as the cabinet, voiced a little higher and wider.
      const PROG = {
        major: [[62, 66, 69, 74], [59, 62, 66, 71], [55, 59, 62, 67], [57, 61, 64, 69]],
        bright: [[62, 66, 69, 73], [64, 68, 71, 76], [67, 71, 74, 78], [69, 73, 76, 81]],
        minor: [[59, 62, 66, 71], [55, 59, 62, 67], [57, 61, 64, 69], [59, 62, 66, 71]],
        soft: [[62, 69, 74, 78], [55, 62, 67, 71], [59, 66, 71, 74], [57, 64, 69, 73]],
      };
      const ARP = [0, 2, 1, 3, 2, 1, 3, 2];
      const PENTA = [0, 2, 4, 7, 9, 12, 14, 16, 19, 21, 24, 26, 28, 31, 33, 36];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, band = 2400) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = band; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        if (idx % 8 === 0) voice({ freq: midi(chord[0] - 24), type: bass(), t, dur: 0.24, vol: 0.17, dest: music, r: 0.09 });
        const gate = scale === 'soft' ? 0.32 : 0.5 + density * 0.45;
        if (idx % 2 === 0 || Math.random() < gate * 0.6) {
          if (Math.random() < gate) {
            const n = chord[ARP[idx % ARP.length]] + (scale === 'bright' && idx % 8 === 6 ? 12 : 0);
