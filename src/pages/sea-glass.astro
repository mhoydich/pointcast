        clear() { if (!ac) return; const t = ac.currentTime; [62, 66, 69, 74, 78, 81, 86].forEach((n, i) => voice({ freq: midi(n), type: 'square', t: t + i * 0.07, dur: 0.14, vol: 0.16, r: 0.08 })); },
