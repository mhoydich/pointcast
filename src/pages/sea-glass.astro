        buoy() { if (!ac) return; const t = ac.currentTime; [60, 64, 67, 72, 76, 79, 84].forEach((n, i) => voice({ freq: midi(n), type: 'triangle', t: t + i * 0.09, dur: 0.1, vol: 0.13, r: 0.05 })); },
