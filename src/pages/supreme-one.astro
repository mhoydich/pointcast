---
/**
 * /supreme-one — Supreme One · November. Five Supreme Office Nouns, each a
 * faucet that would drip one token a day to any address. Concept stage: the
 * tokens are not poured yet, so "Get in line" posts a public line to the Loom
 * (#supreme-one) and nothing touches a chain. The kit (art, manifest, card
 * snippet) is CC0. See src/data/supreme-one.ts for the switch-on list.
 */
import { SUPREME_CHAIN, SUPREME_NOUNS, SUPREME_LOOM, SUPREME_SWITCH_ON, SUPREME_URL } from '../data/supreme-one';

const title = 'Supreme One · November';
const description = 'Five Supreme Office Nouns on Solana, each a faucet: one token a day to any Solana address you name. Get in line now; the spigots pour later. Free kit, CC0.';
const loomHref = 'https://pointcast.xyz/loom?to=' + encodeURIComponent(SUPREME_LOOM) + '#thread';
const snippet = `<a href="${SUPREME_URL}#mug" style="display:inline-flex;align-items:center;gap:10px;padding:10px 16px;border-radius:999px;background:#0f1b33;color:#fff;font:600 15px system-ui;text-decoration:none"><img src="https://pointcast.xyz/supreme-one/nouns/mug.svg" width="28" height="28" alt="" style="image-rendering:pixelated">Supreme Mug · one a day</a>`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={SUPREME_URL}>
<link rel="alternate" type="application/json" href="/supreme-one.json" title="Supreme One kit (JSON)">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={SUPREME_URL}>
<meta property="og:type" content="website">
<meta name="theme-color" content="#f4f1e8">
<link rel="icon" href="/supreme-one/nouns/mug.svg" type="image/svg+xml">
<style is:inline>
:root{--paper:#f4f1e8;--card:#fffdf7;--soft:#ebe6d8;--soft-2:#e2dccb;--ink:#0f1b33;--ink-2:#5a6273;--rule:#d9d2bf;--blue:#1f3fe0;--on-blue:#fff;--red:#e8231c;--r:22px;--g:16px;
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,system-ui,sans-serif;--mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#0e121b;--card:#161b26;--soft:#1b2130;--soft-2:#232a3b;--ink:#eef0f4;--ink-2:#9aa3b4;--rule:#2a3244;--blue:#7f9bff;--on-blue:#0e121b;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:400 16px/1.5 var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--blue)}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px;border-radius:6px}
.wrap{max-width:1040px;margin:0 auto;padding:0 var(--g)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.eyebrow{margin:0 0 10px;font:700 13px/1.3 var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--red)}
.pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 20px;border-radius:999px;border:1.5px solid var(--ink);background:transparent;color:var(--ink);font:600 15px/1 var(--sans);text-decoration:none;cursor:pointer}
.pill.fill{background:var(--ink);color:var(--paper)}
.pill:disabled{opacity:.5;cursor:default}
.pill[data-armed="1"]{background:var(--red);border-color:var(--red);color:#fff}
.hero{padding:56px 0 8px;text-align:center}
.hero h1{margin:0;font:900 clamp(44px,10vw,92px)/.98 var(--sans);letter-spacing:-.045em;text-transform:uppercase}
.hero h1 .soft{display:block;color:var(--ink-2);font-size:.62em;letter-spacing:-.03em}
.lede{max-width:600px;margin:18px auto 0;font-size:clamp(17px,2.6vw,21px);line-height:1.45;color:var(--ink-2);text-wrap:pretty}
.ctas{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px}
.strip{display:flex;justify-content:center;gap:clamp(6px,2vw,18px);margin-top:34px}
.strip img{width:clamp(52px,15vw,120px);height:auto;image-rendering:pixelated;border-radius:16px;background:var(--soft)}
.sec{padding:60px 0 0}
.sec h2{margin:0;font:800 clamp(30px,6vw,48px)/1.04 var(--sans);letter-spacing:-.03em;text-wrap:balance}
.sec h2 .soft{color:var(--ink-2)}
.sec .sub{margin:10px 0 22px;color:var(--ink-2);max-width:640px}
.nouns{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
@media (max-width:420px){.noun .b{padding:12px}.noun h3{font-size:18px}.noun .drip{flex-direction:column;align-items:flex-start;gap:2px}}
.noun{display:flex;flex-direction:column;border-radius:var(--r);background:var(--card);border:2px solid var(--rule);overflow:hidden;scroll-margin-top:16px}
.noun .art{display:grid;place-items:center;aspect-ratio:1.25;background:var(--soft)}
.noun .art img{width:62%;height:auto;image-rendering:pixelated}
.noun .b{display:flex;flex-direction:column;gap:6px;padding:16px}
.noun .k{font:700 12px/1 var(--mono);letter-spacing:.08em;color:var(--ink-2)}
.noun h3{margin:0;font:800 21px/1.15 var(--sans);letter-spacing:-.02em}
.noun p{margin:0;font-size:15px;color:var(--ink-2)}
.noun .drip{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding:10px 12px;border-radius:14px;background:var(--soft);font:600 14px/1.2 var(--sans)}
.noun .drip span{font:500 12px/1.2 var(--mono);color:var(--ink-2)}
.noun .pick{margin-top:8px}
.noun[aria-current="true"]{border-color:var(--ink)}
.noun[aria-current="true"] .pick{background:var(--ink);color:var(--paper)}
.line{display:grid;gap:14px;padding:22px;border-radius:26px;background:var(--ink);color:var(--paper)}
@media (min-width:860px){.line{grid-template-columns:1fr 1fr;padding:32px}}
.line h2{color:var(--paper)}.line h2 .soft{color:color-mix(in srgb,var(--paper) 55%,transparent)}
.line p{margin:0;color:color-mix(in srgb,var(--paper) 72%,transparent)}
.line label{display:block;margin:0 0 6px;font:600 14px/1.3 var(--sans)}
.line input,.line select{width:100%;min-height:50px;padding:0 16px;border-radius:14px;border:1.5px solid color-mix(in srgb,var(--paper) 25%,transparent);background:transparent;color:var(--paper);font:400 17px/1 var(--sans)}
.line select option{color:#0f1b33}
.line .pill{border-color:var(--paper);color:var(--paper)}
.line .pill.fill{background:var(--paper);color:var(--ink)}
.line .pill[data-armed="1"]{background:var(--red);border-color:var(--red);color:#fff}
.line .stat{min-height:22px;font-size:14px;color:#c8f560}
.line .fine{font-size:13px;color:color-mix(in srgb,var(--paper) 58%,transparent)}
.line a{color:#c8f560}
.steps{counter-reset:s;list-style:none;margin:0;padding:0;display:grid;gap:10px}
.steps li{counter-increment:s;display:flex;gap:14px;align-items:flex-start;padding:16px;border-radius:18px;background:var(--soft)}
.steps li::before{content:counter(s);flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--card);font:800 15px/1 var(--sans)}
.kit{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
.kit a{display:flex;flex-direction:column;gap:4px;padding:16px;border-radius:18px;background:var(--card);border:1px solid var(--rule);color:var(--ink);text-decoration:none}
.kit a b{font:700 16px/1.25 var(--sans)}.kit a span{font-size:13px;color:var(--ink-2)}
.kit a:hover{border-color:var(--ink)}
pre{margin:12px 0 0;padding:16px;border-radius:16px;background:var(--soft);overflow:auto;font:12.5px/1.5 var(--mono);white-space:pre-wrap;word-break:break-all}
footer{margin-top:64px;padding:26px 0 48px;border-top:1px solid var(--rule);font-size:13.5px;color:var(--ink-2)}
footer p{margin:0 0 6px}
</style>
</head>
<body>
<main>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">supreme one · november · on solana</p>
      <h1>Supreme<br>Office Nouns<span class="soft">Five faucets.</span></h1>
      <p class="lede">Five office nouns on Solana, each a faucet. Sign up and each one drips one token a day to any Solana address you name. The spigots haven't poured yet, so today you get in line.</p>
      <div class="ctas">
        <a class="pill fill" href="#line">Get in line</a>
        <a class="pill" href="#kit">Take the kit ›</a>
      </div>
      <div class="strip" aria-hidden="true">
        {SUPREME_NOUNS.map((n) => <img src={n.art} alt="" width="120" height="120">)}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-five">
    <div class="wrap">
      <p class="eyebrow">the five</p>
      <h2 id="h-five">One a day.<br><span class="soft">Each one, every day.</span></h2>
      <p class="sub">Pick a noun. Each faucet drips its own {SUPREME_CHAIN.standard} on {SUPREME_CHAIN.name}: one a day, held for you, sent to whatever Solana address you name when you want it.</p>
      <div class="nouns">
        {SUPREME_NOUNS.map((n, i) => (
          <article class="noun" id={n.slug} data-noun={n.slug}>
            <div class="art"><img src={n.art} alt={`${n.name}, a pixel office noun`} width="160" height="160" loading="lazy"></div>
            <div class="b">
              <span class="k">NO. {String(i + 1).padStart(2, '0')} · {n.ticker} · SOL</span>
              <h3>{n.name}</h3>
              <p>{n.line}</p>
              <div class="drip">{n.drip}<span>not poured yet</span></div>
              <button class="pill pick" type="button" data-pick={n.slug}>Pick {n.name.replace('Supreme ', '')}</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="line" aria-labelledby="h-line">
    <div class="wrap">
      <div class="line">
        <div>
          <p class="eyebrow">sign up</p>
          <h2 id="h-line">Get in line.<br><span class="soft">First drips go to the line.</span></h2>
          <p style="margin-top:12px">Today this puts your name and your noun on the Loom at <a href={loomHref}>{SUPREME_LOOM}</a>, in public. No wallet address yet, nothing to sign, nothing stored on this page but your pick. When the spigots pour, the line hears first.</p>
        </div>
        <form id="lineForm" autocomplete="off" novalidate>
          <label for="who">Your name (shown in public)</label>
          <input id="who" name="who" maxlength="40" placeholder="a name or a handle" autocapitalize="words">
          <label for="which" style="margin-top:12px">Your noun</label>
          <select id="which" name="which">
            {SUPREME_NOUNS.map((n) => <option value={n.slug}>{n.name} · {n.drip}</option>)}
          </select>
          <div class="ctas" style="justify-content:flex-start">
            <button class="pill fill" type="submit" id="lineGo" data-label="Get in line">Get in line</button>
            <a class="pill" href={loomHref}>See the line ›</a>
          </div>
          <p class="stat" id="lineStat" role="status" aria-live="polite"></p>
          <p class="fine">Names on the Loom are not signed. A place in line is not a promise of tokens, and the tokens have no promised value.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-pour">
    <div class="wrap">
      <p class="eyebrow">before the first drip</p>
      <h2 id="h-pour">What pours them.<br><span class="soft">Nothing sends until all five are true.</span></h2>
      <ol class="steps" style="margin-top:22px">
        {SUPREME_SWITCH_ON.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <section class="sec" id="kit" aria-labelledby="h-kit">
    <div class="wrap">
      <p class="eyebrow">the kit · cc0</p>
      <h2 id="h-kit">Take the kit.<br><span class="soft">Free to use, no credit needed.</span></h2>
      <p class="sub">Five pixel nouns, the manifest and a drop-in card. Released CC0: use them anywhere, change them, sell what you make.</p>
      <div class="kit">
        {SUPREME_NOUNS.map((n) => <a href={n.art} download><b>{n.slug}.svg</b><span>32×32 pixel art, scales clean</span></a>)}
        <a href="/supreme-one.json"><b>supreme-one.json</b><span>The five, their drips, the sign-up and the switch-on list, for agents</span></a>
      </div>
      <p class="sub" style="margin:22px 0 0">A drop-in card for any page:</p>
      <pre id="snippet">{snippet}</pre>
      <div class="ctas" style="justify-content:flex-start"><button class="pill" type="button" id="copySnip">Copy the card</button></div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p>Supreme One · November, a PointCast series on Solana (SPL tokens, not created yet). "Supreme" here is the plain word for the highest kind; it is not affiliated with any brand.</p>
    <p>Art: original pixel office nouns, CC0. <a href="/faucet/hello">The PointCast faucet</a> · <a href={loomHref}>{SUPREME_LOOM} on the Loom</a> · <a href="/supreme-one.json">supreme-one.json</a></p>
  </div>
</footer>

<script is:inline>
(function(){
  'use strict';
  var $=function(id){return document.getElementById(id)};
  var store={get:function(k){try{return localStorage.getItem('supreme1.'+k)}catch(e){return null}},set:function(k,v){try{localStorage.setItem('supreme1.'+k,v)}catch(e){}}};
  var names={};document.querySelectorAll('[data-noun]').forEach(function(a){names[a.dataset.noun]=a.querySelector('h3').textContent});
  function pick(slug){
    if(!names[slug])return;
    $('which').value=slug;
    document.querySelectorAll('[data-noun]').forEach(function(a){a.setAttribute('aria-current',a.dataset.noun===slug?'true':'false')});
  }
  document.querySelectorAll('[data-pick]').forEach(function(b){b.addEventListener('click',function(){pick(b.dataset.pick);$('line').scrollIntoView({behavior:'smooth',block:'start'});try{$('who').focus({preventScroll:true})}catch(e){}})});
  $('which').addEventListener('change',function(){pick($('which').value)});
  var hash=(location.hash||'').slice(1);pick(names[hash]?hash:($('which').value));
  var done=store.get('inline');
  if(done&&names[done])$('lineStat').textContent='You are in line for '+names[done]+'.';
  var saved=store.get('name');if(saved)$('who').value=saved;
  /* posting is public, so it takes a second tap */
  var go=$('lineGo'),armTimer=0;
  $('lineForm').addEventListener('submit',function(e){
    e.preventDefault();
    var who=$('who').value.trim().replace(/\s+/g,' ').slice(0,40),slug=$('which').value;
    if(!who){$('lineStat').textContent='Add a name first. It shows in public.';$('who').focus();return}
    if(go.dataset.armed!=='1'){go.dataset.armed='1';go.textContent='Tap again to post';$('lineStat').textContent='This posts “IN LINE · '+names[slug]+'” on the Loom under “'+who+'”, in public.';clearTimeout(armTimer);armTimer=setTimeout(function(){go.dataset.armed='';go.textContent=go.dataset.label},6000);return}
    clearTimeout(armTimer);go.dataset.armed='';go.disabled=true;go.textContent='Posting…';
    fetch('/api/loom',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({to:'#supreme-one',from:{name:who,kind:'human'},kind:'note',body:'IN LINE · '+names[slug]+' · one a day, when the spigot pours. via pointcast.xyz/supreme-one'})})
      .then(function(r){return r.json().catch(function(){return{}}).then(function(j){if(!r.ok||j.ok===false)throw new Error(j.error||'rejected');return j})})
      .then(function(){store.set('inline',slug);store.set('name',who);$('lineStat').textContent='You are in line for '+names[slug]+'. It is on the Loom now.';go.textContent='In line';})
      .catch(function(){go.disabled=false;go.textContent=go.dataset.label;$('lineStat').textContent='That did not post. Try again in a moment.'});
  });
  $('copySnip').addEventListener('click',function(){var t=$('snippet').textContent,b=this;(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(function(){b.textContent='Copied'},function(){b.textContent='Select the text above to copy'})});
})();
</script>
</body>
</html>
