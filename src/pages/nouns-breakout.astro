---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';
const title = 'Nouns Breakout';
const description = 'A Windows 95 Nouns brick-breaker: bounce the ball off a noggle paddle, smash the palette wall, and reveal a hidden Noun.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/nouns-breakout', name: title, description, url: 'https://pointcast.xyz/nouns-breakout' };
---
<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-breakout>
    <section class="window" aria-labelledby="breakout-title">
      <header class="titlebar"><span>Nouns Breakout</span><span class="buttons" aria-hidden="true"><i>_</i><i>&#9633;</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Nouns Breakout menu">
        <button type="button" data-new>Game</button>
        <button type="button" data-pause aria-pressed="false">Pause</button>
        <button type="button" data-diff aria-label="Toggle difficulty">Speed: Normal</button>
        <a href="/noggle-drop">Drop</a> <a href="/nouns-2048">2048</a> <a href="/nouns-snake">Snake</a> <a href="/nouns-slide">Slide</a> <a href="/nouns-reversi">Reversi</a> <a href="/nouns-breakout">Breakout</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">PADDLE &middot; BRICKS &middot; BOUNCE</p><h1 id="breakout-title">Break the wall.</h1><p>Move the noggle paddle, launch with Space or a tap, and clear every brick to reveal the Noun.</p></div>
        <div class="meters"><span>Score <strong data-score>0</strong></span><span>Lives <strong data-lives>3</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage" data-stage>
        <canvas data-canvas width="720" height="480" aria-label="Nouns Breakout play field" role="img"></canvas>
        <div class="overlay" data-overlay hidden>
          <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="dlg-title">
            <header class="titlebar dlgbar"><span id="dlg-title" data-dlg-title>Ready</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
            <div class="dlgbody"><p data-dlg-msg>Press Start to play.</p><button type="button" data-dlg-btn>Start</button></div>
          </div>
        </div>
      </div>
      <div class="touchpad">
        <button type="button" data-left aria-label="Move paddle left">&#9668;</button>
        <button type="button" data-launch aria-label="Launch ball">LAUNCH</button>
        <button type="button" data-right aria-label="Move paddle right">&#9658;</button>
      </div>
      <footer class="status" data-status aria-live="polite">Ready. Launch the ball to begin.</footer>
    </section>
  </main>
</BlockLayout>
<script>
  const root = document.querySelector<HTMLElement>('[data-breakout]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (root && canvas && stage) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width, H = canvas.height;
      const $ = (s: string) => root.querySelector<HTMLElement>(s);
      const scoreEl = $('[data-score]'), livesEl = $('[data-lives]'), bestEl = $('[data-best]');
      const statusEl = $('[data-status]');
      const overlay = $('[data-overlay]'), dlgTitle = $('[data-dlg-title]'), dlgMsg = $('[data-dlg-msg]');
      const dlgBtn = $('[data-dlg-btn]') as HTMLButtonElement | null;
      const pauseBtn = $('[data-pause]') as HTMLButtonElement | null;
      const diffBtn = $('[data-diff]') as HTMLButtonElement | null;

      const slug = 'nouns-breakout';
      const statsKey = 'pc:arcade:' + slug;
      const profileKey = 'pc:arcade:profile';
      function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
      function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage full / disabled */ } }

      function persistBest() {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: null, bestScore: null });
        const nextBest = Math.max(Number(stats.bestScore || 0), score);
        stats.bestScore = nextBest;
        writeJson(statsKey, stats);
        if (best == null || nextBest > best) best = nextBest;
      }

      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestTime: null, bestScore: null });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestScore = Math.max(Number(stats.bestScore || 0), score);
        }
        writeJson(statsKey, stats);
        const profile = readJson(profileKey, { achievements: [] });
        profile.lastPlayed = 'Breakout';
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = 'Breakout';
          const earned = ['first-win', 'brick-clear'];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
      }
      function loadBest() { const s = readJson(statsKey, {}); return s && s.bestScore != null ? Number(s.bestScore) : null; }

      const NOUN = { yellow: '#F7C325', red: '#E84D6A', deepred: '#D22209', blue: '#4A9EFF', green: '#2CC5A0', grey: '#d5d7e3' };
      const ROW_COLORS = [NOUN.deepred, NOUN.red, NOUN.yellow, NOUN.green, NOUN.blue, NOUN.grey];

      // Hidden noun behind bricks
      const nounImg = new Image();
      let nounReady = false;
      nounImg.onload = () => { nounReady = true; };
      nounImg.onerror = () => { nounReady = false; };
      function pickNoun() { nounReady = false; nounImg.src = 'https://noun.pics/' + Math.floor(Math.random() * 1200) + '.svg'; }

      // Layout
      const COLS = 10, PAD = 8, TOP = 56;
      const BW = (W - PAD * (COLS + 1)) / COLS, BH = 22;
      type Brick = { x: number; y: number; alive: boolean; color: string; pts: number };
      let bricks: Brick[] = [];
      let rows = 5;

      // State
      const paddle = { x: W / 2, y: H - 30, w: 108, h: 14 };
      const ball = { x: W / 2, y: H - 44, vx: 0, vy: 0, r: 7 };
      let stuck = true;
      let score = 0, lives = 3, level = 1, remaining = 0;
      let running = false, paused = false, over = true, best = loadBest();
      let cleared = false; // guards recordPlay(true) once per wall
      let baseSpeed = 300; // px/sec
      let diffMult = 1;

      const keys = { left: false, right: false };
      let pointerX: number | null = null;

      function buildLevel() {
        rows = Math.min(6, 4 + level);
        bricks = [];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < COLS; c++) {
            const color = ROW_COLORS[r % ROW_COLORS.length];
            const pts = (rows - r) * 10;
            bricks.push({ x: PAD + c * (BW + PAD), y: TOP + r * (BH + PAD), alive: true, color, pts });
          }
        }
        remaining = bricks.length;
      }

      function resetBall() {
        stuck = true;
        ball.x = paddle.x; ball.y = paddle.y - ball.r - 2; ball.vx = 0; ball.vy = 0;
      }

      function launch() {
        if (!running || paused || over || !stuck) return;
        stuck = false;
        const spd = baseSpeed * diffMult;
        const a = -Math.PI / 2 + (Math.random() * 0.7 - 0.35);
        ball.vx = Math.cos(a) * spd; ball.vy = Math.sin(a) * spd;
        setStatus('Ball in play. Keep it up!');
      }

      function setStatus(t: string) { if (statusEl) statusEl.textContent = t; }
      function render() {
        if (scoreEl) scoreEl.textContent = String(score);
        if (livesEl) livesEl.textContent = String(lives);
        if (bestEl) bestEl.textContent = best == null ? '--' : String(best);
      }

      function newGame() {
        score = 0; lives = 3; level = 1;
        baseSpeed = 300;
        cleared = false;
        pickNoun();
        buildLevel();
        resetBall();
        over = false; running = true; paused = false;
        if (pauseBtn) { pauseBtn.setAttribute('aria-pressed', 'false'); pauseBtn.textContent = 'Pause'; }
        hideOverlay();
        recordPlay(false);
        render();
        setStatus('New game. Press Space or tap Launch.');
        ensureLoop();
      }

      function nextLevel() {
        level++;
        baseSpeed = Math.min(300 + level * 30, 480);
        cleared = false;
        pickNoun();
        buildLevel();
        resetBall();
        setStatus('Level ' + level + '. New wall!');
        render();
      }

      function loseLife() {
        lives--;
        render();
        if (lives <= 0) {
          gameOver();
        } else {
          resetBall();
          setStatus('Ball lost. ' + lives + ' lives left. Launch again.');
        }
      }

      function gameOver() {
        running = false; over = true;
        persistBest();
        render();
        showOverlay('Game Over', 'Score: ' + score + '. Bricks got the better of you.', 'New Game');
        setStatus('Game over. Final score ' + score + '.');
      }

      function winLevel() {
        if (cleared) return;
        cleared = true;
        recordPlay(true);
        persistBest();
        render();
        running = false;
        showOverlay('Cleared!', 'Wall cleared - score ' + score + '. Advance to a denser wall?', 'Next Wall');
        setStatus('Cleared! The Noun is revealed.');
      }

      // Overlay
      let overlayMode: 'start' | 'over' | 'win' = 'start';
      function showOverlay(t: string, m: string, btn: string) {
        if (!overlay) return;
        overlayMode = t === 'Cleared!' ? 'win' : (t === 'Game Over' ? 'over' : 'start');
        if (dlgTitle) dlgTitle.textContent = t;
        if (dlgMsg) dlgMsg.textContent = m;
        if (dlgBtn) { dlgBtn.textContent = btn; }
        overlay.hidden = false;
        if (dlgBtn) dlgBtn.focus();
      }
      function hideOverlay() { if (overlay) overlay.hidden = true; }

      // Physics - fixed timestep
      const STEP = 1 / 120;
      let acc = 0, last = 0, rafId = 0;

      function clamp(v: number, a: number, b: number) { return v < a ? a : v > b ? b : v; }

      function step() {
        // paddle
        const pspd = 520 * STEP;
        if (keys.left) paddle.x -= pspd;
        if (keys.right) paddle.x += pspd;
        if (pointerX != null) paddle.x = pointerX;
        paddle.x = clamp(paddle.x, paddle.w / 2, W - paddle.w / 2);

        if (stuck) { ball.x = paddle.x; ball.y = paddle.y - ball.r - 2; return; }

        ball.x += ball.vx * STEP;
        ball.y += ball.vy * STEP;

        // walls
        if (ball.x - ball.r < 0) { ball.x = ball.r; ball.vx = Math.abs(ball.vx); }
        if (ball.x + ball.r > W) { ball.x = W - ball.r; ball.vx = -Math.abs(ball.vx); }
        if (ball.y - ball.r < 0) { ball.y = ball.r; ball.vy = Math.abs(ball.vy); }

        // paddle collision
        if (ball.vy > 0 && ball.y + ball.r >= paddle.y - paddle.h / 2 && ball.y - ball.r <= paddle.y + paddle.h / 2 &&
            ball.x >= paddle.x - paddle.w / 2 - ball.r && ball.x <= paddle.x + paddle.w / 2 + ball.r) {
          const rel = (ball.x - paddle.x) / (paddle.w / 2); // -1..1
          const a = -Math.PI / 2 + clamp(rel, -1, 1) * (Math.PI / 3);
          const spd = Math.min(Math.hypot(ball.vx, ball.vy) * 1.01, 620);
          ball.vx = Math.cos(a) * spd; ball.vy = Math.sin(a) * spd;
          ball.y = paddle.y - paddle.h / 2 - ball.r - 0.5;
        }

        // bricks
        for (const b of bricks) {
          if (!b.alive) continue;
          if (ball.x + ball.r > b.x && ball.x - ball.r < b.x + BW && ball.y + ball.r > b.y && ball.y - ball.r < b.y + BH) {
            b.alive = false; remaining--; score += b.pts;
            // decide bounce axis by overlap
            const ox = Math.min(ball.x + ball.r - b.x, b.x + BW - (ball.x - ball.r));
            const oy = Math.min(ball.y + ball.r - b.y, b.y + BH - (ball.y - ball.r));
            if (ox < oy) ball.vx = -ball.vx; else ball.vy = -ball.vy;
            // speed up slightly as bricks fall
            const spd = Math.min(Math.hypot(ball.vx, ball.vy) * 1.008, 620);
            const cur = Math.hypot(ball.vx, ball.vy) || 1;
            ball.vx = ball.vx / cur * spd; ball.vy = ball.vy / cur * spd;
            render();
            if (remaining <= 0) { winLevel(); return; }
            break;
          }
        }

        // bottom
        if (ball.y - ball.r > H) { loseLife(); }
      }

      function drawBg() {
        ctx.fillStyle = '#0b0b2a';
        ctx.fillRect(0, 0, W, H);
        // faint noun behind the wall
        if (nounReady) {
          ctx.save();
          ctx.globalAlpha = 0.32;
          const size = Math.min(W - 40, TOP + rows * (BH + PAD) - 20);
          const dx = (W - size) / 2, dy = TOP - 10;
          try { ctx.drawImage(nounImg, dx, dy, size, size); } catch (e) { /* slow/invalid asset - skip */ }
          ctx.restore();
        }
      }

      function drawBrick(b: Brick) {
        ctx.fillStyle = b.color;
        ctx.fillRect(b.x, b.y, BW, BH);
        // Win95 bevel
        ctx.fillStyle = 'rgba(255,255,255,0.55)';
        ctx.fillRect(b.x, b.y, BW, 2); ctx.fillRect(b.x, b.y, 2, BH);
        ctx.fillStyle = 'rgba(0,0,0,0.35)';
        ctx.fillRect(b.x, b.y + BH - 2, BW, 2); ctx.fillRect(b.x + BW - 2, b.y, 2, BH);
      }

      function drawPaddle() {
        const px = paddle.x - paddle.w / 2, py = paddle.y - paddle.h / 2;
        // noggle-style: white frame + two lens blocks
        ctx.fillStyle = '#c0c0c0'; ctx.fillRect(px, py, paddle.w, paddle.h);
        ctx.fillStyle = 'rgba(255,255,255,0.7)'; ctx.fillRect(px, py, paddle.w, 2); ctx.fillRect(px, py, 2, paddle.h);
        ctx.fillStyle = 'rgba(0,0,0,0.45)'; ctx.fillRect(px, py + paddle.h - 2, paddle.w, 2); ctx.fillRect(px + paddle.w - 2, py, 2, paddle.h);
        const lw = paddle.w * 0.34, lh = paddle.h - 6, ly = py + 3;
        ctx.fillStyle = NOUN.red; ctx.fillRect(px + paddle.w * 0.1, ly, lw, lh);
        ctx.fillStyle = '#fff'; ctx.fillRect(px + paddle.w * 0.1 + lw * 0.45, ly, lw * 0.3, lh);
        ctx.fillStyle = NOUN.red; ctx.fillRect(px + paddle.w * 0.56, ly, lw, lh);
        ctx.fillStyle = '#fff'; ctx.fillRect(px + paddle.w * 0.56 + lw * 0.45, ly, lw * 0.3, lh);
      }

      function drawBall() {
        ctx.fillStyle = NOUN.yellow;
        ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.7)';
        ctx.beginPath(); ctx.arc(ball.x - 2, ball.y - 2, ball.r * 0.4, 0, Math.PI * 2); ctx.fill();
      }

      function draw() {
        drawBg();
        for (const b of bricks) if (b.alive) drawBrick(b);
        drawPaddle();
        drawBall();
      }

      function frame(t: number) {
        rafId = 0;
        if (!last) last = t;
        let dt = (t - last) / 1000; last = t;
        if (dt > 0.1) dt = 0.1; // clamp big gaps
        if (running && !paused && !over) {
          acc += dt;
          let guard = 0;
          while (acc >= STEP && guard < 600) { step(); acc -= STEP; guard++; if (over || !running) break; }
        }
        draw();
        if (running && !paused && !over) rafId = requestAnimationFrame(frame);
      }

      function ensureLoop() {
        if (rafId) return;
        if (!running || paused || over) return;
        last = 0; acc = 0;
        rafId = requestAnimationFrame(frame);
      }
      function stopLoop() { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } }

      // Controls
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { keys.left = true; pointerX = null; }
        else if (e.key === 'ArrowRight') { keys.right = true; pointerX = null; }
        else if (e.key === ' ' || e.code === 'Space') { e.preventDefault(); launch(); }
        else if (e.key.toLowerCase() === 'p') { togglePause(); }
      });
      document.addEventListener('keyup', (e) => {
        if (e.key === 'ArrowLeft') keys.left = false;
        else if (e.key === 'ArrowRight') keys.right = false;
      });

      function stageX(clientX: number) {
        const r = canvas!.getBoundingClientRect();
        if (r.width === 0) return paddle.x;
        return clamp((clientX - r.left) / r.width * W, paddle.w / 2, W - paddle.w / 2);
      }
      canvas.addEventListener('mousemove', (e) => { if (running && !over) { pointerX = stageX(e.clientX); keys.left = keys.right = false; } });
      canvas.addEventListener('mousedown', () => launch());
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches[0]) { pointerX = stageX(e.touches[0].clientX); }
        launch(); e.preventDefault();
      }, { passive: false });
      canvas.addEventListener('touchmove', (e) => {
        if (e.touches[0] && running && !over) { pointerX = stageX(e.touches[0].clientX); }
        e.preventDefault();
      }, { passive: false });

      // Touchpad buttons
      const leftBtn = $('[data-left]'), rightBtn = $('[data-right]'), launchBtn = $('[data-launch]');
      function hold(el: HTMLElement | null, on: () => void, off: () => void) {
        if (!el) return;
        const start = (e: Event) => { e.preventDefault(); pointerX = null; on(); };
        const end = (e: Event) => { e.preventDefault(); off(); };
        el.addEventListener('touchstart', start, { passive: false });
        el.addEventListener('touchend', end); el.addEventListener('touchcancel', end);
        el.addEventListener('mousedown', start); el.addEventListener('mouseup', end); el.addEventListener('mouseleave', end);
      }
      hold(leftBtn, () => { keys.left = true; }, () => { keys.left = false; });
      hold(rightBtn, () => { keys.right = true; }, () => { keys.right = false; });
      if (launchBtn) launchBtn.addEventListener('click', (e) => { e.preventDefault(); launch(); });

      // Menu buttons
      const newBtn = $('[data-new]');
      if (newBtn) newBtn.addEventListener('click', () => newGame());
      function togglePause() {
        if (!running || over) return;
        paused = !paused;
        if (pauseBtn) { pauseBtn.setAttribute('aria-pressed', String(paused)); pauseBtn.textContent = paused ? 'Resume' : 'Pause'; }
        if (paused) { stopLoop(); setStatus('Paused.'); draw(); }
        else { setStatus('Resumed.'); ensureLoop(); }
      }
      if (pauseBtn) pauseBtn.addEventListener('click', togglePause);
      if (diffBtn) diffBtn.addEventListener('click', () => {
        diffMult = diffMult === 1 ? 1.35 : (diffMult === 1.35 ? 0.8 : 1);
        const label = diffMult === 1 ? 'Normal' : (diffMult === 1.35 ? 'Fast' : 'Easy');
        diffBtn.textContent = 'Speed: ' + label;
        setStatus('Difficulty set to ' + label + '. Starts next game.');
      });

      if (dlgBtn) dlgBtn.addEventListener('click', () => {
        if (overlayMode === 'win') { hideOverlay(); running = true; over = false; paused = false; nextLevel(); ensureLoop(); }
        else { newGame(); }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { stopLoop(); }
        else if (running && !paused && !over) { ensureLoop(); }
      });

      // init
      pickNoun();
      buildLevel();
      resetBall();
      render();
      draw();
      showOverlay('Ready', 'Move the noggle paddle, launch with Space or a tap, clear the wall to reveal the Noun. 3 lives.', 'Start');
    }
  }
</script>
<style>
  :global(body) { background: #008080; }
  .desk { background: #008080; font-family: "MS Sans Serif", Tahoma, system-ui, sans-serif; min-height: calc(100vh - 88px); padding: 18px; box-sizing: border-box; }
  .desk *, .desk *::before, .desk *::after { box-sizing: border-box; }
  .window { max-width: 1040px; margin: 0 auto; background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; box-shadow: 2px 2px 0 #000; }
  .titlebar { background: linear-gradient(90deg, #000080, #1084d0); color: #fff; font-weight: 700; font-size: 13px; padding: 3px 5px; display: flex; justify-content: space-between; align-items: center; }
  .buttons { display: flex; gap: 2px; }
  .buttons i { width: 19px; height: 18px; display: grid; place-items: center; border: 2px solid; border-color: #fff #404040 #404040 #fff; background: #c0c0c0; color: #000; font-style: normal; font-size: 11px; line-height: 1; }
  .menubar { display: flex; flex-wrap: wrap; gap: 2px; padding: 4px 5px; border-bottom: 1px solid #808080; align-items: center; }
  .menubar button, .menubar a { border: 0; background: transparent; color: #000; padding: 4px 8px; text-decoration: none; font: inherit; font-size: 12px; cursor: pointer; }
  .menubar button:hover, .menubar a:hover { background: #000080; color: #fff; }
  .hero { display: flex; flex-wrap: wrap; gap: 14px; justify-content: space-between; align-items: flex-end; padding: 12px 14px 6px; }
  .hero > div:first-child { max-width: 620px; }
  .hero p { font-size: 13px; margin: 6px 0 0; }
  .kicker { font: 700 10px/1 "Courier New", monospace; letter-spacing: .12em; color: #000080; text-transform: uppercase; margin: 0; }
  h1 { font-size: clamp(30px, 6vw, 64px); line-height: .94; font-weight: 700; margin: 4px 0 0; color: #000; }
  .meters { display: flex; gap: 8px; flex-wrap: wrap; }
  .meters span { border: 2px solid; border-color: #808080 #fff #fff #808080; background: #fff; padding: 4px 8px; font-size: 12px; }
  .meters strong { font-family: "Courier New", monospace; color: #000080; }
  .stage { position: relative; margin: 8px 14px; border: 2px solid; border-color: #808080 #fff #fff #808080; background: #000; }
  canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; touch-action: none; background: #0b0b2a; }
  .overlay { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0,0,0,0.45); }
  .overlay[hidden] { display: none; }
  .dialog { width: min(340px, 86%); background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; box-shadow: 2px 2px 0 #000; }
  .dlgbar { font-size: 12px; }
  .dlgbody { padding: 14px; text-align: center; }
  .dlgbody p { font-size: 13px; margin: 0 0 12px; color: #000; }
  .dlgbody button { padding: 6px 18px; font: inherit; font-weight: 700; background: #c0c0c0; border: 2px solid; border-color: #fff #404040 #404040 #fff; cursor: pointer; }
