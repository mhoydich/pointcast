---
import BlockLayout from '../layouts/BlockLayout.astro';
import openRoadImage from '../assets/shrines/open-road-chevy.webp';
import openRoadOg from '../assets/shrines/open-road-og.jpg';

const title = 'Shrine of the Open Road';
const description =
  'A quiet one-minute shrine for the open road: breathe with a 1955 Chevrolet, offer a light, and leave gently.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shrine of the Open Road',
  url: 'https://pointcast.xyz/open-road',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={openRoadOg.src}
  jsonLd={jsonLd}
>
  <section class="ors" id="open-road-shrine" aria-labelledby="ors-title" data-state="idle" data-phase="rest">
    <span class="ors__dove-cursor" id="ors-dove-cursor" aria-hidden="true">🕊︎</span>

    <a class="ors__exit" href="/" aria-label="Return to PointCast home">
      <span aria-hidden="true">←</span> PointCast
    </a>

    <div class="ors__sanctuary">
      <header class="ors__header">
        <p class="ors__mark" aria-hidden="true">✦</p>
        <h1 class="ors__eyebrow" id="ors-title">A shrine for the open road</h1>
      </header>

      <figure class="ors__icon">
        <div class="ors__aura" aria-hidden="true"></div>
        <div class="ors__frame">
          <img
            src={openRoadImage.src}
            alt="Pop-art collage of a turquoise and ochre 1955 Chevrolet beneath pink, gold, and cream geometric fields, with a dark leafy branch at right."
            width={openRoadImage.width}
            height={openRoadImage.height}
            decoding="async"
            fetchpriority="high"
          />
          <span class="ors__glint" aria-hidden="true"></span>
        </div>
      </figure>

      <div class="ors__altar" aria-hidden="true">
        <span class="ors__altar-line"></span>
        <div class="ors__votives">
          <span class="ors__votive ors__votive--attendant is-lit"></span>
          <span class="ors__votive ors__votive--offering" id="ors-offering"></span>
          <span class="ors__votive ors__votive--attendant is-lit"></span>
        </div>
        <span class="ors__altar-line"></span>
      </div>

      <blockquote class="ors__prayer">
        <p>
          <span id="ors-prayer-line-one">May what carries you</span>
          <span id="ors-prayer-line-two">also bring you home.</span>
        </p>
      </blockquote>

      <div class="ors__practice">
        <p class="ors__cue" id="ors-cue">Sit for one minute. Let the road pass through you.</p>
        <div class="ors__progress" aria-hidden="true">
          <span id="ors-progress"></span>
        </div>
        <div class="ors__miles" aria-hidden="true">
          <span class="ors__mile"></span>
          <span class="ors__mile"></span>
          <span class="ors__mile"></span>
          <span class="ors__mile"></span>
          <span class="ors__mile"></span>
        </div>
      </div>

      <p class="sr-only" id="ors-cadence">
        During stillness, breathe in gently for five seconds, then breathe out for seven seconds. Repeat at your own pace for one minute.
      </p>

      <div class="ors__controls" role="group" aria-label="Shrine controls">
        <button
          class="ors__button ors__button--enter"
          id="ors-enter"
          type="button"
          aria-describedby="ors-cadence"
        >Enter stillness</button>
        <button
          class="ors__button ors__button--offer"
          id="ors-offer"
          type="button"
          aria-pressed="false"
        >Offer a light</button>
      </div>

      <p class="ors__footnote">No destination is required here.</p>
      <p class="ors__status sr-only" id="ors-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>
</BlockLayout>

<style is:global>
  body:has(#open-road-shrine) {
    --ors-pine: #061711;
    --ors-pine-light: #0a271d;
    --ors-parchment: #e9e1c8;
    --ors-parchment-dim: #b9af93;
    --ors-gold: #c7a84a;
    --ors-gold-deep: #766126;
    --ors-orchid: #d88ace;
    margin: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    background: var(--ors-pine);
  }

  body:has(#open-road-shrine) #pc-fb,
  body:has(#open-road-shrine) #pc-spell-layer,
  body:has(#open-road-shrine) #cursor-room,
  body:has(#open-road-shrine) #pc-freshness,
  body:has(#open-road-shrine) #pc-first-see {
    display: none !important;
  }

  body:has(#open-road-shrine) #main-content {
    min-width: 0;
  }

  html.cr-cursor-active body:has(#open-road-shrine),
  html.cr-cursor-active body:has(#open-road-shrine) #main-content,
  html.cr-cursor-active body:has(#open-road-shrine) #main-content * {
    cursor: auto !important;
  }

  html.cr-cursor-active body:has(#open-road-shrine) a,
  html.cr-cursor-active body:has(#open-road-shrine) button {
    cursor: pointer !important;
  }

  html.cr-cursor-active body:has(#open-road-shrine) button:disabled {
    cursor: default !important;
  }

  .ors {
    min-height: 100svh;
    min-height: 100dvh;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(28px, 5vh, 58px) clamp(18px, 4vw, 64px) clamp(34px, 5vh, 64px);
    color: var(--ors-parchment);
    background:
      radial-gradient(circle at 50% 38%, rgba(199, 168, 74, 0.075), transparent 38%),
      linear-gradient(145deg, #04100c 0%, var(--ors-pine) 48%, #071c15 100%);
    font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .ors::before,
  .ors::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: -1;
  }

  .ors::before {
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(233, 225, 200, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(233, 225, 200, 0.04) 1px, transparent 1px);
    background-size: 96px 96px;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
  }

  .ors::after {
    width: 44vw;
    height: 44vw;
    right: -28vw;
    top: -20vw;
    border: 1px solid rgba(216, 138, 206, 0.12);
    transform: rotate(45deg);
    box-shadow: 0 0 0 9vw rgba(216, 138, 206, 0.012);
  }

  .ors__dove-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ors__dove-cursor {
      position: fixed;
      z-index: 30;
      left: 0;
      top: 0;
      display: block;
      color: #fff9de;
      font-family: 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif;
      font-size: 21px;
      line-height: 1;
      opacity: 0;
      pointer-events: none;
      text-shadow:
        0 0 1px rgba(6, 23, 17, 0.96),
        0 2px 8px rgba(6, 23, 17, 0.72),
        0 0 13px rgba(199, 168, 74, 0.24);
      transform: translate3d(-40px, -40px, 0);
      transition: opacity 180ms ease;
      will-change: transform;
    }

    .ors__dove-cursor.is-visible {
      opacity: 0.92;
    }
  }

  .ors__exit {
    position: absolute;
    z-index: 5;
    top: clamp(16px, 2.4vw, 30px);
    left: clamp(16px, 2.4vw, 30px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    color: rgba(233, 225, 200, 0.74);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer !important;
    transition: color 220ms ease;
  }

  .ors__exit:hover,
  .ors__exit:focus-visible {
    color: var(--ors-parchment);
    text-decoration: none;
  }

  .ors__sanctuary {
    width: min(100%, 860px);
    display: grid;
    justify-items: center;
    gap: clamp(12px, 1.8vh, 20px);
    text-align: center;
  }

  .ors__header {
    display: grid;
    justify-items: center;
    gap: 7px;
  }

  .ors__mark {
    margin: 0;
    color: var(--ors-gold);
    font-family: Georgia, serif;
    font-size: 13px;
    line-height: 1;
    opacity: 0.82;
  }

  .ors__eyebrow {
    margin: 0;
    color: rgba(233, 225, 200, 0.68);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(9px, 0.72vw, 11px);
    font-weight: 400;
    letter-spacing: 0.31em;
    line-height: 1.4;
    text-transform: uppercase;
    transition: opacity 600ms ease;
  }

  .ors__icon {
    width: min(62vh, 72vw, 620px);
    max-width: 100%;
    position: relative;
    margin: 0;
    aspect-ratio: 1;
  }

  .ors__aura {
    position: absolute;
    inset: 7%;
    border-radius: 10%;
    background:
      radial-gradient(circle at 50% 58%, rgba(226, 182, 59, 0.38), rgba(199, 168, 74, 0.15) 44%, transparent 74%),
      radial-gradient(circle at 69% 35%, rgba(216, 138, 206, 0.13), transparent 62%);
    filter: blur(clamp(32px, 6vw, 70px));
    opacity: 0.38;
    transform: scale(0.98);
    will-change: transform, opacity;
  }

  .ors__frame {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100%;
    padding: clamp(5px, 0.72vw, 8px);
    border: 1px solid rgba(199, 168, 74, 0.72);
    background: rgba(233, 225, 200, 0.055);
    box-shadow:
      0 0 0 4px var(--ors-pine),
      0 0 0 5px rgba(233, 225, 200, 0.2),
      0 24px 70px rgba(0, 0, 0, 0.52);
    overflow: hidden;
  }

  .ors__frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    transform: scale(1);
    transform-origin: 53% 61%;
    will-change: transform;
  }

  .ors__glint {
    position: absolute;
    z-index: 2;
    left: 53%;
    top: 61%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 243, 184, 0.68);
    box-shadow:
      0 0 7px 2px rgba(255, 224, 120, 0.44),
      0 0 24px 7px rgba(226, 182, 59, 0.18);
    opacity: 0.5;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .ors__altar {
    width: min(100%, 540px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 18px;
    margin-top: -4px;
  }

  .ors__altar-line {
    height: 1px;
    margin-bottom: 5px;
    background: linear-gradient(90deg, transparent, rgba(199, 168, 74, 0.38));
  }

  .ors__altar-line:last-child {
    transform: scaleX(-1);
  }

  .ors__votives {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }

  .ors__votive {
    width: 12px;
    height: 10px;
    position: relative;
    display: block;
    border: 1px solid rgba(233, 225, 200, 0.32);
    border-radius: 2px 2px 4px 4px;
    background: rgba(233, 225, 200, 0.08);
    box-shadow: inset 0 -3px 3px rgba(0, 0, 0, 0.22);
  }

  .ors__votive::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 5px;
    height: 9px;
    border-radius: 55% 45% 55% 45%;
    background: #ffe8a1;
    box-shadow:
      0 0 4px 1px rgba(255, 222, 117, 0.8),
      0 0 12px 3px rgba(226, 182, 59, 0.4);
    opacity: 0;
    transform: translateX(-50%) rotate(4deg) scale(0.7);
    transform-origin: center bottom;
  }

  .ors__votive.is-lit::before {
    opacity: 0.92;
    animation: ors-votive 3.1s ease-in-out infinite alternate;
  }

  .ors__votive--attendant:first-child::before { animation-duration: 2.8s; }
  .ors__votive--attendant:last-child::before { animation-duration: 3.4s; animation-delay: -1.2s; }
  .ors__votive--offering.is-lit::before { animation-duration: 3s; animation-delay: -0.6s; }

  .ors__prayer {
    margin: 0;
  }

  .ors__prayer p {
    margin: 0;
    color: var(--ors-parchment);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    font-size: clamp(21px, 2.2vw, 31px);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.18;
  }

  .ors__prayer span {
    display: block;
  }

  .ors__practice {
    min-height: 31px;
    display: grid;
    justify-items: center;
    gap: 11px;
  }

  .ors__cue {
    margin: 0;
    color: rgba(233, 225, 200, 0.58);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(12px, 1vw, 14px);
    font-style: italic;
    letter-spacing: 0.025em;
    transition: color 500ms ease, opacity 500ms ease;
  }

  .ors__progress {
    width: min(58vw, 250px);
    height: 1px;
    overflow: hidden;
    background: rgba(199, 168, 74, 0.18);
  }

  .ors__progress span {
    width: 100%;
    height: 100%;
    display: block;
    background: linear-gradient(90deg, var(--ors-gold-deep), #e2b63b, var(--ors-parchment));
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .ors__miles {
    display: flex;
    justify-content: center;
    gap: 11px;
    min-height: 5px;
  }

  .ors__mile {
    width: 4px;
    height: 4px;
    display: block;
    border: 1px solid rgba(199, 168, 74, 0.42);
    border-radius: 50%;
    background: transparent;
    transition:
      background-color 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease;
  }

  .ors__mile.is-passed {
    border-color: rgba(255, 232, 161, 0.94);
    background: rgba(255, 232, 161, 0.9);
    box-shadow: 0 0 7px rgba(226, 182, 59, 0.48);
  }

  .ors__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px 24px;
    flex-wrap: wrap;
  }

  .ors__button {
    min-height: 44px;
    appearance: none;
    border: 0;
    border-bottom: 1px solid rgba(199, 168, 74, 0.34);
    border-radius: 0;
    padding: 10px 3px 8px;
    color: rgba(233, 225, 200, 0.72);
    background: transparent;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer !important;
    transition: color 220ms ease, border-color 220ms ease, opacity 220ms ease;
  }

  .ors__button:hover,
  .ors__button:focus-visible {
    color: var(--ors-parchment);
    border-bottom-color: var(--ors-gold);
  }

  .ors__button:focus-visible,
  .ors__exit:focus-visible {
    outline: 1px solid var(--ors-gold);
    outline-offset: 5px;
  }

  .ors__button:disabled {
    color: rgba(233, 225, 200, 0.35);
    border-bottom-color: transparent;
    cursor: default !important;
  }

  .ors__footnote {
    margin: 0;
    color: rgba(233, 225, 200, 0.58);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: 11px;
    font-style: italic;
    letter-spacing: 0.025em;
  }

  .ors[data-state='sitting'] .ors__aura {
    animation: ors-breathe 12s ease-in-out infinite;
  }

  .ors[data-state='sitting'] .ors__frame img {
    animation: ors-icon-drift 24s ease-in-out infinite;
  }

  .ors[data-state='sitting'] .ors__glint {
    animation: ors-glint 6s ease-in-out infinite;
  }

  .ors[data-state='sitting'] .ors__eyebrow,
  .ors[data-state='sitting'] .ors__mark,
  .ors[data-state='sitting'] .ors__footnote,
  .ors[data-state='sitting'] .ors__button--offer {
    opacity: 0.38;
  }

  .ors[data-state='sitting'][data-phase='receive'] .ors__cue {
    color: rgba(233, 225, 200, 0.78);
  }

  .ors[data-state='sitting'][data-phase='release'] .ors__cue {
    color: rgba(199, 168, 74, 0.74);
  }

  .ors[data-paused='true'] *,
  .ors[data-paused='true'] *::before,
  .ors[data-paused='true'] *::after {
    animation-play-state: paused !important;
  }

  @keyframes ors-breathe {
    0% { opacity: 0.32; transform: scale(0.98); }
    41.667% { opacity: 0.52; transform: scale(1.025); }
    100% { opacity: 0.32; transform: scale(0.98); }
  }

  @keyframes ors-icon-drift {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.008); }
  }

  @keyframes ors-glint {
    0%, 100% { opacity: 0.38; transform: translate(-50%, -50%) scale(0.72); }
    42% { opacity: 0.88; transform: translate(-50%, -50%) scale(1.18); }
  }

  @keyframes ors-votive {
    0% { transform: translateX(-50%) rotate(-3deg) scale(0.88); opacity: 0.7; }
    45% { transform: translateX(-50%) rotate(5deg) scale(1.02); opacity: 1; }
    100% { transform: translateX(-50%) rotate(-1deg) scale(0.92); opacity: 0.82; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 680px) {
    .ors {
      align-items: start;
      overflow: visible;
      padding-top: 62px;
    }

    .ors__sanctuary {
      gap: 13px;
    }

    .ors__icon {
      width: min(88vw, 54vh, 520px);
    }

    .ors__exit {
      top: 10px;
      left: 8px;
    }

    .ors__controls {
      gap: 4px 20px;
    }
  }

  @media (max-height: 720px) and (min-width: 681px) {
    .ors {
      padding-top: 28px;
      padding-bottom: 30px;
    }

    .ors__sanctuary {
      gap: 9px;
    }

    .ors__icon {
      width: min(56vh, 520px);
    }

    .ors__footnote {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ors *,
    .ors *::before,
    .ors *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    .ors__aura {
      opacity: 0.42;
      transform: none;
    }

    .ors__frame img {
      transform: none;
    }

    .ors__votive.is-lit::before {
      opacity: 0.9;
      transform: translateX(-50%);
    }
  }
</style>

<script>
  const shrine = document.getElementById('open-road-shrine');
  const enterButton = document.getElementById('ors-enter');
  const offerButton = document.getElementById('ors-offer');
  const offering = document.getElementById('ors-offering');
  const cue = document.getElementById('ors-cue');
  const progress = document.getElementById('ors-progress');
  const prayerLineOne = document.getElementById('ors-prayer-line-one');
  const prayerLineTwo = document.getElementById('ors-prayer-line-two');
  const status = document.getElementById('ors-status');
  const doveCursor = document.getElementById('ors-dove-cursor');
  const mileMarkers = Array.from(document.querySelectorAll('.ors__mile'));

  if (
    shrine instanceof HTMLElement &&
    enterButton instanceof HTMLButtonElement &&
    offerButton instanceof HTMLButtonElement &&
    offering instanceof HTMLElement &&
    cue instanceof HTMLElement &&
    progress instanceof HTMLElement &&
    prayerLineOne instanceof HTMLElement &&
    prayerLineTwo instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const SIT_DURATION = 60_000;
    const RECEIVE_DURATION = 5_000;
    const RELEASE_DURATION = 7_000;
    const BREATH_DURATION = RECEIVE_DURATION + RELEASE_DURATION;
    const LIGHT_STORAGE_KEY = 'pc:open-road:light';

    let state = 'idle';
    let accumulated = 0;
    let lastResumedAt = 0;
    let animationFrame = 0;
    let visiblePhase = 'rest';

    const setPrayer = (lineOne, lineTwo) => {
      prayerLineOne.textContent = lineOne;
      prayerLineTwo.textContent = lineTwo;
    };

    const setProgress = (value) => {
      const bounded = Math.min(1, Math.max(0, value));
      progress.style.transform = `scaleX(${bounded})`;
    };

    const setMiles = (elapsed) => {
      const passed = Math.min(mileMarkers.length, Math.floor(elapsed / BREATH_DURATION));
      mileMarkers.forEach((marker, index) => {
        marker.classList.toggle('is-passed', index < passed);
      });
    };

    const getClosingPrayer = () => {
      const hour = new Date().getHours();

      if (hour >= 5 && hour < 12) {
        return ['Travel with wonder.', 'Return with gratitude.'];
      }

      if (hour >= 12 && hour < 17) {
        return ['Go with clear eyes.', 'Come home unhurried.'];
      }

      if (hour >= 17 && hour < 21) {
        return ['Let evening receive you.', 'Return in peace.'];
      }

      return ['May the dark hold gently.', 'May every road lead home.'];
    };

    const setPhase = (nextPhase) => {
      if (visiblePhase === nextPhase) return;
      visiblePhase = nextPhase;
      shrine.dataset.phase = nextPhase;
      cue.textContent = nextPhase === 'receive' ? 'Receive' : 'Release';
    };

    const reset = (announce = true) => {
      cancelAnimationFrame(animationFrame);
      state = 'idle';
      accumulated = 0;
      visiblePhase = 'rest';
      shrine.dataset.state = 'idle';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      setPrayer('May what carries you', 'also bring you home.');
      cue.textContent = 'Sit for one minute. Let the road pass through you.';
      enterButton.textContent = 'Enter stillness';
      setProgress(0);
      setMiles(0);
      if (announce) status.textContent = 'Stillness ended.';
    };

    const complete = () => {
      cancelAnimationFrame(animationFrame);
      state = 'complete';
      accumulated = SIT_DURATION;
      visiblePhase = 'rest';
      shrine.dataset.state = 'complete';
      shrine.dataset.phase = 'rest';
      delete shrine.dataset.paused;
      const [lineOne, lineTwo] = getClosingPrayer();
      setPrayer(lineOne, lineTwo);
      cue.textContent = 'The road is open.';
      enterButton.textContent = 'Sit again';
      setProgress(1);
      setMiles(SIT_DURATION);
      status.textContent = `One minute complete. ${lineOne} ${lineTwo}`;
    };

    const tick = (now) => {
      if (state !== 'sitting' || document.hidden) return;
      const elapsed = accumulated + (now - lastResumedAt);
      setProgress(elapsed / SIT_DURATION);
      setMiles(elapsed);

      const breathPosition = elapsed % BREATH_DURATION;
      setPhase(breathPosition < RECEIVE_DURATION ? 'receive' : 'release');

      if (elapsed >= SIT_DURATION) {
        complete();
        return;
      }

      animationFrame = requestAnimationFrame(tick);
    };

    const start = () => {
      cancelAnimationFrame(animationFrame);
      state = 'sitting';
      accumulated = 0;
      lastResumedAt = performance.now();
      visiblePhase = 'rest';
      shrine.dataset.state = 'sitting';
      shrine.dataset.phase = 'receive';
      delete shrine.dataset.paused;
      setPrayer('May what carries you', 'also bring you home.');
      cue.textContent = 'Receive';
      visiblePhase = 'receive';
      enterButton.textContent = 'Leave stillness';
      setProgress(0);
      setMiles(0);
      status.textContent = 'One minute of stillness has begun.';
      animationFrame = requestAnimationFrame(tick);
    };

    enterButton.addEventListener('click', () => {
      if (state === 'sitting') reset();
      else start();
    });

    const lightOffering = (announce = true) => {
      offering.classList.add('is-lit');
      offerButton.textContent = 'Light offered';
      offerButton.setAttribute('aria-pressed', 'true');
      offerButton.disabled = true;
      if (announce) status.textContent = 'Your light is offered.';
    };

    try {
      if (sessionStorage.getItem(LIGHT_STORAGE_KEY) === '1') lightOffering(false);
    } catch {
      // The votive still works when storage is unavailable.
    }

    offerButton.addEventListener('click', () => {
      lightOffering();
      try {
        sessionStorage.setItem(LIGHT_STORAGE_KEY, '1');
      } catch {
        // Keep the light for this page even when storage is unavailable.
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && state === 'sitting') {
        reset();
        enterButton.focus();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (state !== 'sitting') return;

      if (document.hidden) {
        accumulated += performance.now() - lastResumedAt;
        shrine.dataset.paused = 'true';
        cancelAnimationFrame(animationFrame);
        return;
      }

      lastResumedAt = performance.now();
      delete shrine.dataset.paused;
      animationFrame = requestAnimationFrame(tick);
    });

    if (doveCursor instanceof HTMLElement && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let targetX = -40;
      let targetY = -40;
      let currentX = -40;
      let currentY = -40;
      let doveFrame = 0;

      const placeDove = () => {
        const ease = reduceMotion ? 1 : 0.24;
        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;
        doveCursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;

        if (Math.abs(targetX - currentX) > 0.2 || Math.abs(targetY - currentY) > 0.2) {
          doveFrame = requestAnimationFrame(placeDove);
        } else {
          doveFrame = 0;
        }
      };

      window.addEventListener('pointermove', (event) => {
        targetX = event.clientX + 13;
        targetY = event.clientY - 20;
        doveCursor.classList.add('is-visible');
        if (!doveFrame) doveFrame = requestAnimationFrame(placeDove);
      }, { passive: true });

      window.addEventListener('mouseout', (event) => {
        if (!event.relatedTarget) doveCursor.classList.remove('is-visible');
      });
    }
  }
</script>
