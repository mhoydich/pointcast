---
/**
 * /soft-landing — a lunar lander for the 8-bit heart.
 *
 * Brief by Michael Hoydich, 2026-10-22: 80s innocence, the joy of the compute
 * and flow, mood-state symbiosis, mobile and full screen, audio-visual
 * multimedia, Atari and Commodore inspired, rendered modern. Thread 3 of the
 * five games that followed Breakwater; it shares Breakwater's font, palettes
 * and mood model (src/lib/breakwater) and adds its own physics, skylines and
 * landing judgement in src/lib/soft-landing, covered by tests/soft-landing.test.mjs.
 *
 * Everything in the playfield is stroked lines and 3x5 pixel digits on a
 * canvas; every sound is synthesized in the browser.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { LIMITS } from '../lib/soft-landing/landing.mjs';
import { PAD_KINDS, RUSH_PAD } from '../lib/soft-landing/skyline.mjs';

const description = 'A lunar lander with 1980s innocence: a vector skyline in Atari 800XL or Commodore 64 blue, a main engine and two side jets, pads worth more the narrower they are, a synthesized engine roar, and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/soft-landing';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Soft Landing',
      alternateName: 'Soft Landing: a lunar lander for the 8-bit heart',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/soft-landing/og.png',
      gamePlatform: 'Web browser',
      genre: 'Lunar lander',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Soft Landing', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
const pads = [...PAD_KINDS, RUSH_PAD];
---

<BlockLayout
  title="Soft Landing"
  description={description}
  image="/images/soft-landing/og.png"
  imageAlt="A blue playfield with a jagged white vector skyline, three landing pads marked 1X, 2X and 4X, and a small lander with a flame beside the words Soft Landing, a lunar lander for the 8-bit heart."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/soft-landing.json', title: 'Soft Landing rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/soft-landing/og.png',
    buttons: [
      { label: 'Play Soft Landing', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="sl" data-sl data-machine="xl" data-crt="on">
    <div class="sl-stage" data-stage>
      <header class="sl-bar">
        <a class="sl-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="sl-name" aria-hidden="true">SOFT LANDING</span>
        <div class="sl-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="sl-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Soft Landing playfield. Hold the engine to slow your fall, tilt with the side jets, and set down level on a pad."></canvas>
        <div class="sl-scan" aria-hidden="true"></div>
        <noscript><p class="sl-noscript">Soft Landing needs JavaScript to fly the lander and make its sounds. The rules and moods are readable at <a href="/soft-landing.json">/soft-landing.json</a>.</p></noscript>
      </div>
      <footer class="sl-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>80 BPM</span>
        <span data-r-land>LAND 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-vec>ALT 0 VS 0</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="sl-notes">
      <p class="sl-eyebrow">PointCast / Games / Soft Landing</p>
      <h1>A lunar lander for the 8-bit heart.</h1>
      <p class="sl-lede">A small ship, a little fuel, a wobbly skyline drawn in lines, and three pads that pay more the narrower they are. Set down slow, straight and level. Pick the blue you grew up with.</p>

      <div class="sl-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Controlled burns and every hundred units of safe descent raise its <strong>energy</strong>. A crash lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="sl-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major arpeggio, slightly wide pads.</li>
            <li><b>FLOW</b> a run of good landings. Bright colors, the music opens up, a breath of wind.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, a crosswind, and a narrow pad worth five.</li>
            <li><b>DRIFT</b> after a crash. Gravity softens, the pads widen, the notes thin out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.id === 'calm' ? 'unlimited fuel and a crash never ends the game' : d.id === 'play' ? 'three landers and a tank of 1200' : 'starts hot with a tank of 900'}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave after a game, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue lines. A raw filtered-noise roar and square-wave cues, in the POKEY spirit. A blue READY and a RUN before the skyline.' : 'The blue field inside a light-blue border. A resonant filter on the roar and a sweep on every cue, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The pixel font, the palettes and the mood model are shared with <a href="/breakwater">Breakwater</a>; the physics, the skylines, the lander and the sounds were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-soft-landing-notes.md">research note on Lunar Lander and its home-computer descendants</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Gravity pulls, the main engine pushes along the ship's axis, the side jets tilt it. A landing is safe when it is on a pad with both feet, falling slower than {LIMITS.vy} units a second, drifting slower than {LIMITS.vx}, and within about {Math.round((LIMITS.angle * 180) / Math.PI)} degrees of level. Pads: {pads.map((p, i) => <span>{p.width} wide pays {p.mult}×{i < pads.length - 1 ? ', ' : ''}</span>)} (the last only in RUSH). Points are the multiplier times 50, plus 25 more for a truly soft touch, plus fuel left over ten. A landing refunds fuel by the multiplier and brings a new skyline. Three landers; a crash on CALM costs nothing.</p>
          <h2>Controls</h2>
          <ul>
            <li>Touch: hold the middle of the field to burn, the left and right thirds to tilt.</li>
            <li>Keys: ↑ or Space burns, ← → or A D tilt, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="sl-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026. Original code, art and synthesized sound; no ROMs, no recordings. Machine names are tributes.</p>
        <p><a href="/soft-landing.json">soft-landing.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .sl { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .sl[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .sl-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .sl-stage:fullscreen, .sl-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .sl-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .sl-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .sl-home:hover { color: #fff; }
  .sl-name { color: #fff; font-weight: 700; margin-right: auto; }
  .sl-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .sl-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .sl-controls button:hover { background: #1f2456; }
  .sl-controls button[aria-pressed='false'] { color: #6b7199; text-decoration: line-through; }
  .sl-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .sl-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .sl-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sl-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .sl[data-crt='off'] .sl-scan { display: none; }
  .sl-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .sl-noscript a { color: var(--paddle); }
  .sl-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .sl-readout span { white-space: nowrap; }
  .sl-readout a { margin-left: auto; color: var(--text); text-decoration: none; }
  .sl-readout a:hover { color: #fff; }
  .sl-stage:fullscreen .sl-readout a, .sl-stage:-webkit-full-screen .sl-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sl-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .sl-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .sl-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .sl-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .sl-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .sl-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .sl-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .sl-grid h2 + h2, .sl-grid p + h2, .sl-grid ul + h2 { margin-top: 22px; }
  .sl-grid p { margin: 0 0 12px; }
  .sl-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .sl-grid li { margin-bottom: 6px; }
  .sl-moods { list-style: none; padding: 0; }
  .sl-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .sl-notes a { color: #a9b9f5; }
  .sl-notes a:hover { color: #fff; }
  .sl-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .sl-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .sl-stage { min-height: 0; }
    .sl-bar { gap: 8px; padding: 6px 10px; }
    .sl-name { display: none; }
    .sl-controls { gap: 4px; }
    .sl-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .sl-readout { gap: 10px; font-size: 9px; height: 26px; }
    .sl-readout [data-r-vec], .sl-readout [data-r-fps] { display: none; }
    .sl-grid { grid-template-columns: 1fr; gap: 20px; }
    .sl-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .sl-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { LANDER, FUEL_START, FUEL_REFUND, createLander, stepLander, wrapX, ceiling, createBurnTracker } from '../lib/soft-landing/physics.mjs';
  import { generateSkyline, mulberry32, widestPad } from '../lib/soft-landing/skyline.mjs';
  import { LIMITS, REASON_TEXT, altitudeOf, touchedDown, judgeLanding, landingScore, descentMarks, envFor, autopilot } from '../lib/soft-landing/landing.mjs';

  const root = document.querySelector('[data-sl]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = 288, H_MIN = 384, H_MAX = 480, WALL = 8, HUD = 32;
    let H = H_MIN;
    const LANDERS = 3;
    const STORE = 'soft-landing:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      land: root.querySelector('[data-r-land]'),
      fps: root.querySelector('[data-r-fps]'),
      vec: root.querySelector('[data-r-vec]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) ? settings.best : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    const signed = (v, w = 3) => (v < 0 ? '-' : '+') + String(Math.min(999, Math.round(Math.abs(v)))).padStart(w, '0');

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music, roarGain, roarFilter;
      let tempo = 80, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0, roarLevel = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      const PROG = {
        major: [[60, 64, 67, 72], [57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67]],
        bright: [[60, 64, 67, 71], [62, 66, 69, 74], [65, 69, 72, 76], [67, 71, 74, 78]],
        minor: [[57, 60, 64, 69], [53, 57, 60, 65], [55, 59, 62, 67], [57, 60, 64, 69]],
        soft: [[60, 67, 72, 76], [53, 60, 65, 69], [57, 64, 69, 72], [55, 62, 67, 71]],
      };
      const ARP = [0, 2, 1, 3, 2, 0, 3, 1];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        // The engine: a looping noise bed through a low-pass filter; its gain follows the throttle.
        const len = ac.sampleRate * 2;
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = Math.random() * 2 - 1;
        const src = ac.createBufferSource(); src.buffer = buf; src.loop = true;
        roarFilter = ac.createBiquadFilter(); roarFilter.type = 'lowpass'; roarFilter.frequency.value = 420; roarFilter.Q.value = machineId === 'c64' ? 5 : 0.9;
        roarGain = ac.createGain(); roarGain.gain.value = 0;
        src.connect(roarFilter); roarFilter.connect(roarGain); roarGain.connect(sfx);
        src.start();
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, freq = 2400, type = 'bandpass') {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = type; f.frequency.value = freq; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const lead = () => (machineId === 'c64' ? 'triangle' : 'square');
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
