    function drawHud() {
      const m = M();
      text(String(G.score).padStart(6, '0'), WALL + 2, 8, 3, m.bright);
      const label = G.attract ? 'ATTRACT' : response.label;
      const col = G.attract ? m.dim : label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : label === 'DRIFT' ? m.text : m.bands.green;
      text(label, W / 2 + 10, 11, 2, col, 'center');
      if (!G.attract) {
        if (response.unlimitedBalls) text('CALM', W - WALL - 2, 11, 2, m.text, 'right');
        else {
          // One little lander per ship in reserve.
          ctx.strokeStyle = m.paddle; ctx.lineWidth = 1;
          for (let i = 0; i < Math.min(G.landers, 6); i += 1) {
            const x = W - WALL - 4 - (i + 1) * 10, y = 10;
            ctx.beginPath(); ctx.moveTo(x, y + 4); ctx.lineTo(x + 2, y); ctx.lineTo(x + 5, y); ctx.lineTo(x + 7, y + 4); ctx.lineTo(x + 5, y + 6); ctx.lineTo(x + 2, y + 6); ctx.closePath(); ctx.stroke();
          }
        }
      }
      ctx.fillStyle = m.text; ctx.globalAlpha = 0.5; ctx.fillRect(WALL, HUD - 2, W - 2 * WALL, 1); ctx.globalAlpha = 1;
      // mood tape along the top edge
      if (!G.attract && mood.tape.length) {
        const n = Math.min(60, mood.tape.length), start = mood.tape.length - n;
        for (let i = 0; i < n; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(WALL + i * 3, HUD - 6, 2, 2);
        }
      }
    }
    function drawInstruments() {
      const l = G.lander;
      if (!l || G.attract) return;
      const m = M();
      const alt = Math.max(0, altitudeOf(l, G.sky));
      const vsOk = l.vy <= LIMITS.vy, hsOk = Math.abs(l.vx) <= LIMITS.vx;
      const warn = m.bands.red, good = m.text;
      const x = W - WALL - 2, y0 = HUD + 6;
      text(`ALT ${String(Math.round(Math.min(999, alt))).padStart(3, '0')}`, x, y0, 2, good, 'right');
      text(`HS ${signed(l.vx)}`, x, y0 + 12, 2, hsOk ? good : warn, 'right');
      text(`VS ${signed(-l.vy)}`, x, y0 + 24, 2, vsOk ? good : warn, 'right');
      const fuel = Number.isFinite(l.fuel) ? String(Math.round(l.fuel)).padStart(4, '0') : 'CALM';
      text(`FUEL ${fuel}`, x, y0 + 36, 2, Number.isFinite(l.fuel) && l.fuel < 150 ? warn : good, 'right');
      // Attitude: a short bar that tilts with the ship, level when it is level.
      const ax = x - 14, ay = y0 + 54;
      ctx.strokeStyle = Math.abs(l.angle) <= LIMITS.angle ? good : warn; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(ax - Math.cos(l.angle) * 10, ay - Math.sin(l.angle) * 10); ctx.lineTo(ax + Math.cos(l.angle) * 10, ay + Math.sin(l.angle) * 10); ctx.stroke();
      ctx.fillStyle = m.dim; ctx.fillRect(ax - 12, ay + 4, 24, 1);
      if (G.wind && response.label === 'RUSH') text(G.wind < 0 ? '<WIND' : 'WIND>', x, y0 + 64, 1, m.bands.orange, 'right');
    }
    function drawParticles(alpha) {
      for (const p of G.particles) {
        ctx.globalAlpha = alpha * (1 - p.t / p.life);
        ctx.fillStyle = p.color;
        ctx.fillRect(Math.round(p.x), Math.round(p.y), 2, 2);
      }
      ctx.globalAlpha = 1;
    }
    function drawHints() {
      const m = M();
      if (G.hint <= 0 || G.descent > 0 || G.landings > 0) return;
      ctx.globalAlpha = Math.min(1, G.hint);
      if (COARSE) {
        text('TILT', W / 6, H - 22, 2, m.text, 'center');
        text('HOLD BURN', W / 2, H - 22, 2, m.paddle, 'center');
        text('TILT', (5 * W) / 6, H - 22, 2, m.text, 'center');
        ctx.fillStyle = m.text; ctx.globalAlpha *= 0.35;
        ctx.fillRect(W / 3, H - 40, 1, 36); ctx.fillRect((2 * W) / 3, H - 40, 1, 36);
      } else {
        text('UP OR SPACE BURNS', W / 2, H - 34, 2, m.paddle, 'center');
        text('LEFT RIGHT TILT', W / 2, H - 22, 2, m.text, 'center');
      }
      ctx.globalAlpha = 1;
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawTitle() {
      const m = M();
      drawStars(0.5); drawSky(0.45); drawParticles(0.5); if (G.lander) drawLander(G.lander, 0.6);
      rainbowText('SOFT', W / 2, 78, 7, [m.bands.red, m.bands.orange, m.bands.yellow, m.bands.green]);
      rainbowText('LANDING', W / 2, 120, 6, [m.bands.green, m.bands.yellow, m.bands.orange, m.bands.red, m.bands.yellow, m.bands.green, m.bands.orange]);
      text('A LUNAR LANDER FOR THE 8-BIT HEART', W / 2, 160, 1, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 176, 2, m.text, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 192, 2, m.text, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY' : 'TAP OR PRESS SPACE', W / 2, 232, 2, m.paddle, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, 262, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 26, 2, m.dim, 'center');
    }
    function drawOver() {
      const m = M();
      drawStars(0.5); drawSky(0.4); drawParticles(0.4);
      text('GAME OVER', W / 2, 108, 5, m.bright, 'center');
      text(`SCORE ${String(G.score).padStart(6, '0')}`, W / 2, 162, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 178, 2, m.bands.yellow, 'center');
      text(`LANDINGS ${G.landings}  PEAK ${mood.peak}`, W / 2, 194, 2, m.text, 'center');
      if (G.outOfFuel) text('OUT OF FUEL', W / 2, 212, 2, m.bands.red, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO FLY AGAIN' : 'TAP OR SPACE TO FLY AGAIN', W / 2, 250, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawField();
      if (G.phase === 'title') { drawTitle(); return; }
      if (G.phase === 'over') { drawHud(); drawOver(); return; }
      drawStars(1); drawSky(1); drawHud(); drawInstruments();
      if (G.lander && (G.lander.alive || G.phase === 'landed')) drawLander(G.lander, 1);
      drawParticles(1);
      drawHints();
      const m = M();
      if (G.phase === 'paused') { text('PAUSED', W / 2, 200, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 232, 2, m.text, 'center'); }
      if (G.msgT > 0 && G.msg) text(G.msg, W / 2, 196, G.msgScale, G.msgColor || m.bright, 'center');
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const l = G.lander;
        readout.mood.textContent = `${G.attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${G.attract ? 84 : Math.max(60, response.tempo - 24)} BPM ${G.attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.vec.textContent = l && G.sky ? `ALT ${Math.max(0, Math.round(altitudeOf(l, G.sky)))} VS ${Math.round(-l.vy)} G ${G.env.gravity}` : 'ALT 0 VS 0';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      const p = pointerToField(e);
      const playing = G.phase === 'play';
      // A touch that starts a game is held from its own position: the same frame reads it as a control.
      G.touches.set(e.pointerId, zoneOf(p.x));
      if (!playing) action();
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!G.touches.has(e.pointerId)) return;
      const p = pointerToField(e);
      G.touches.set(e.pointerId, zoneOf(p.x));
    });
    const release = (e) => { G.touches.delete(e.pointerId); };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('lostpointercapture', release);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      if (t && typeof t.closest === 'function' && t.closest('a, button, input, textarea, select, [contenteditable]')) return;
      const k = e.code;
      if (k === 'ArrowLeft' || k === 'ArrowRight' || k === 'KeyA' || k === 'KeyD' || k === 'ArrowUp' || k === 'KeyW') { G.keys[k] = true; e.preventDefault(); audio.unlock(); return; }
      if (k === 'Space' || k === 'Enter') {
        e.preventDefault();
        if (G.phase === 'play') { G.keys.Space = true; audio.unlock(); return; }
        if (!e.repeat) action();
        return;
      }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function dropInputs() { G.keys = {}; G.touches.clear(); audio.roar(0); }
    function togglePause() {
      if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; dropInputs(); audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        dropInputs();
        if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', dropInputs);
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      audio.roar(0);
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      if (!G.attract) {
        if (response.unlimitedBalls) { G.fuel = Infinity; if (G.lander) G.lander.fuel = Infinity; }
        else {
          if (!Number.isFinite(G.fuel)) { G.fuel = FUEL_START[next]; if (G.lander) G.lander.fuel = G.fuel; }
          if (G.landers <= 0) G.landers = 1;
        }
      }
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}.`);
      showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    btn.machine.addEventListener('click', () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    btn.dial.addEventListener('click', () => { audio.unlock(); cycleDial(); });
    btn.sound.addEventListener('click', toggleSound);
    btn.crt.addEventListener('click', toggleCrt);
    btn.full.addEventListener('click', toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    // QA hook, opt-in by URL: ?debug exposes the state read-only and lets a test fly the autopilot.
    if (new URLSearchParams(location.search).has('debug')) window.__softLanding = { G, mood, response: () => response };
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
