---
/**
 * /shrine-flame — twelve candles. Light what you came here to light.
 *
 * Second shrine in the elemental pair. Where /shrine-water is a still
 * pool, /shrine-flame is twelve candles on a stone slab at dusk. Tap a
 * candle and a flame appears. Lit candles flicker quietly until the
 * tab closes; counts persist in localStorage. Once you've lit all
 * twelve the altar is full and a softer ambient hum rises.
 *
 * Audio:
 *   • Ambient crackle: short noise bursts gated through a resonant
 *     lowpass filter, every 3-7 seconds, low volume. Wood + ember.
 *   • Light-a-candle chime: a soft brass-bell pluck (sine 880Hz + 1760Hz
 *     shimmer) with the same 2.2s convolution reverb as /shrine-water,
 *     so the two shrines share a sonic room.
 *   • When altar full (all 12 lit): a low sustained drone fades in,
 *     ~200Hz, very quiet. Goes away when you blow out a candle.
 *
 * State (localStorage 'pc:shrine-flame:v1'):
 *   { candlesLit: number[12], totalLifetime: number, firstVisit, lastVisit }
 *   candlesLit is a 12-element boolean-ish array (1 if lit, 0 if not).
 *   totalLifetime accumulates across visits even after you blow out.
 *
 * Distinct from existing pixel-art /drum-shrine (single-Noun temple)
 * and from /shrine-water (pool). Apple-quality gallery aesthetic.
 *
 * Shipped 2026-05-16. Fourth shrine. Fire element. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Shrine of Flame — twelve candles at dusk"
  description="A stone slab with twelve unlit candles. Tap each one to light it. The candles flicker quietly. When all twelve are lit, a soft drone rises. Local-only; nothing leaves your browser."
  image="/images/og-drum.png"
>
  <main class="shf" id="shf" data-built={built}>
    <!-- Backdrop: dusk stone slab placeholder -->
    <div class="shf__backdrop" id="shf-backdrop" aria-hidden="true"></div>

    <!-- The card -->
    <article class="shf__card" id="shf-card">
      <header class="shf__head">
        <p class="shf__kicker">SHRINE · FLAME · TWELVE CANDLES</p>
        <h1 class="shf__title">Light what you came here to light.</h1>
        <p class="shf__sub">A row of twelve unlit candles on a stone slab at dusk. Tap any one to light it. They'll flicker until you leave. Nothing about your candles goes anywhere.</p>
      </header>

      <!-- The altar — twelve candle slots -->
      <div class="shf__altar" id="shf-altar" role="group" aria-label="Twelve candles">
        <!-- Twelve buttons get inserted by JS so we can wire each independently -->
      </div>

      <!-- Foot -->
      <footer class="shf__foot">
        <p class="shf__count" id="shf-count">your first visit</p>
        <div class="shf__actions">
          <button class="shf__btn shf__btn--blow" id="shf-blow" type="button" disabled>↻ blow them out</button>
          <button class="shf__btn shf__btn--light-all" id="shf-light-all" type="button">⊙ light them all</button>
        </div>
        <p class="shf__links">
          <a href="/shrine-water">↗ /shrine-water</a>
          <span class="shf__dot">·</span>
          <a href="/shrine-bird">↗ /shrine-bird</a>
          <span class="shf__dot">·</span>
          <a href="/aviary">↗ /aviary</a>
        </p>
      </footer>
    </article>
  </main>

  <style is:global>
    :root {
      --shf-ink: #06050a;
      --shf-deep: #1a1208;
      --shf-ember: #c46428;
      --shf-flame-core: #ffe1a0;
      --shf-flame-tip: #ff9c45;
      --shf-mist: #f4dcb0;
      --shf-cream: #f4ede0;
      --shf-cream-dim: rgba(244, 237, 224, 0.62);
      --shf-cream-dimmer: rgba(244, 237, 224, 0.34);
      --shf-accent: #f6b97a;
      --shf-card-bg: rgba(14, 8, 4, 0.42);
      --shf-card-border: rgba(244, 237, 224, 0.12);
      --shf-candle-wax: #e8dcb0;
      --shf-candle-shadow: #806638;
    }

    html, body { background: var(--shf-ink); margin: 0; padding: 0; height: 100%; }
    body:has(.shf) {
      color: var(--shf-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .shf {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* BACKDROP — dusk stone slab placeholder */
    .shf__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 50% 30%, rgba(246, 185, 122, 0.20) 0%, transparent 50%),
        radial-gradient(ellipse at 30% 80%, rgba(196, 100, 40, 0.18) 0%, transparent 55%),
        linear-gradient(180deg, #100a08 0%, #1a1208 50%, #221610 100%);
      animation: shfBackdrop 24s ease-in-out infinite alternate;
    }
    @keyframes shfBackdrop {
      0%   { filter: brightness(1.0); }
      100% { filter: brightness(1.06); }
    }
    .shf__backdrop--image {
      background-image: url('/images/shrines/shrine-flame.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    .shf__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(6, 5, 10, 0.50) 95%);
      pointer-events: none;
    }
    /* Warm glow that intensifies when the altar fills */
    .shf__backdrop--glowing::after {
      background: radial-gradient(ellipse at 50% 60%, rgba(246, 185, 122, 0.08) 0%, transparent 50%),
                  radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(6, 5, 10, 0.50) 95%);
      transition: background 800ms ease;
    }

    /* CARD */
    .shf__card {
      position: relative;
      z-index: 1;
      max-width: 540px;
      width: 100%;
      padding: 36px 32px 24px;
      background: var(--shf-card-bg);
      border: 1px solid var(--shf-card-border);
      border-radius: 28px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.50),
        0 8px 24px rgba(0, 0, 0, 0.30),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: shfCardEnter 1.6s cubic-bezier(0.16, 0.84, 0.30, 1.00) both;
    }
    @keyframes shfCardEnter {
      0%   { opacity: 0; transform: translateY(28px) scale(0.96); filter: blur(8px); }
      50%  { opacity: 0.9; filter: blur(2px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* HEAD */
    .shf__head { margin-bottom: 28px; }
    .shf__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--shf-cream-dim);
      text-transform: uppercase;
      margin: 0 0 16px;
      font-weight: 500;
    }
    .shf__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: clamp(28px, 4vw, 36px);
      letter-spacing: -0.020em;
      line-height: 1.12;
      margin: 0 0 12px;
      color: var(--shf-cream);
    }
    .shf__sub {
      font-size: 14px;
      line-height: 1.55;
      color: var(--shf-cream-dim);
      margin: 0;
    }

    /* ALTAR — twelve candle row */
    .shf__altar {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 4px;
      padding: 30px 8px 14px;
      margin: 0 -8px 22px;
      border-radius: 14px;
      background:
        linear-gradient(180deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.35) 100%),
        linear-gradient(90deg, rgba(40, 26, 16, 0.30) 0%, rgba(60, 36, 22, 0.30) 50%, rgba(40, 26, 16, 0.30) 100%);
      box-shadow:
        inset 0 1px 0 rgba(244, 237, 224, 0.06),
        inset 0 -10px 24px rgba(0, 0, 0, 0.35);
    }
    @media (max-width: 480px) {
      .shf__altar { gap: 2px; padding-top: 24px; }
    }

    .shf__candle {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      background: transparent;
      border: 0;
      padding: 0 0 4px;
      cursor: pointer;
      height: 84px;
      outline: none;
      transition: transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .shf__candle:hover { transform: translateY(-2px); }
    .shf__candle:active { transform: translateY(0); }
    .shf__candle:focus-visible {
      outline: 2px solid rgba(246, 185, 122, 0.6);
      outline-offset: 2px;
      border-radius: 4px;
    }
    .shf__candle-body {
      width: 10px;
      height: 56px;
      background:
        linear-gradient(180deg, var(--shf-candle-wax) 0%, #d4c590 100%);
      border-radius: 1.5px 1.5px 1px 1px;
      box-shadow:
        inset 1px 0 0 rgba(255, 255, 255, 0.30),
        inset -1px 0 0 rgba(80, 60, 30, 0.30),
        0 2px 4px rgba(0, 0, 0, 0.5);
    }
    .shf__candle-wick {
      width: 1.5px;
      height: 6px;
      background: #2a1810;
      margin-bottom: -1px;
      position: relative;
      z-index: 2;
    }
    .shf__candle-flame {
      position: absolute;
      bottom: 56px;
      left: 50%;
      width: 10px;
      height: 16px;
      transform: translateX(-50%) scale(0);
      transform-origin: bottom center;
      opacity: 0;
      pointer-events: none;
      background: radial-gradient(ellipse at 50% 90%, var(--shf-flame-core) 0%, var(--shf-flame-tip) 40%, rgba(255, 156, 69, 0.20) 75%, transparent 100%);
      border-radius: 50% 50% 40% 40% / 70% 70% 30% 30%;
      filter: blur(0.5px);
      box-shadow:
        0 0 16px rgba(255, 200, 100, 0.50),
        0 0 32px rgba(246, 185, 122, 0.30);
      transition: opacity 400ms ease, transform 600ms cubic-bezier(0.25, 0.6, 0.30, 1);
    }
    .shf__candle--lit .shf__candle-flame {
      opacity: 1;
      transform: translateX(-50%) scale(1);
      animation: shfFlameFlicker 0.6s ease-in-out infinite alternate;
    }
    @keyframes shfFlameFlicker {
      0%   { transform: translateX(-50%) scale(1.00) rotate(-2deg); opacity: 0.92; }
      30%  { transform: translateX(-55%) scale(1.06) rotate(-1deg); opacity: 1.00; }
      55%  { transform: translateX(-50%) scale(0.96) rotate(2deg); opacity: 0.95; }
      80%  { transform: translateX(-45%) scale(1.04) rotate(1deg); opacity: 0.98; }
      100% { transform: translateX(-50%) scale(1.00) rotate(0deg); opacity: 1.00; }
    }
    /* Soft warm halo on the candle when lit */
    .shf__candle--lit .shf__candle-body {
      box-shadow:
        inset 1px 0 0 rgba(255, 235, 180, 0.50),
        inset -1px 0 0 rgba(140, 80, 30, 0.40),
        0 2px 4px rgba(0, 0, 0, 0.4),
        0 0 12px rgba(255, 200, 100, 0.20);
    }
    /* Slight stagger so flames don't all flicker in sync */
    .shf__candle:nth-child(3n+1) .shf__candle-flame { animation-delay: 0.10s; }
    .shf__candle:nth-child(3n+2) .shf__candle-flame { animation-delay: 0.30s; }

    /* FOOTER */
    .shf__foot { text-align: center; }
    .shf__count {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 14px;
      color: var(--shf-cream-dim);
      margin: 0 0 14px;
      letter-spacing: 0.01em;
      min-height: 1.4em;
    }
    .shf__count strong {
      color: var(--shf-accent);
      font-weight: 600;
      font-style: normal;
    }
    .shf__actions {
      display: inline-flex;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .shf__btn {
      border: 1px solid rgba(244, 237, 224, 0.16);
      background: rgba(244, 237, 224, 0.04);
      color: var(--shf-cream-dim);
      padding: 7px 14px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .shf__btn:hover:not(:disabled) {
      background: rgba(244, 237, 224, 0.10);
      color: var(--shf-cream);
      border-color: rgba(244, 237, 224, 0.30);
    }
    .shf__btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .shf__btn--light-all {
      background: rgba(246, 185, 122, 0.10);
      border-color: rgba(246, 185, 122, 0.32);
      color: var(--shf-accent);
    }
    .shf__btn--light-all:hover:not(:disabled) {
      background: rgba(246, 185, 122, 0.18);
      border-color: rgba(246, 185, 122, 0.55);
    }
    .shf__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--shf-cream-dimmer);
      margin: 0;
    }
    .shf__links a {
      color: var(--shf-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .shf__links a:hover { color: var(--shf-cream); }
    .shf__dot { display: inline-block; margin: 0 6px; opacity: 0.4; }

    @media (max-width: 540px) {
      .shf__card { padding: 28px 22px 20px; border-radius: 22px; }
      .shf__candle { height: 70px; }
      .shf__candle-body { height: 46px; }
      .shf__candle-flame { bottom: 46px; width: 8px; height: 13px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .shf__card, .shf__backdrop { animation: none; }
      .shf__candle--lit .shf__candle-flame { animation: none; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const NUM_CANDLES = 12;
    const STORAGE_KEY = 'pc:shrine-flame:v1';

    interface FlameState {
      candlesLit: number[];  // 12-element 0/1 array
      totalLifetime: number; // cumulative candles ever lit
      firstVisit: number;
      lastVisit: number;
    }
    function freshState(): FlameState {
      return {
        candlesLit: new Array(NUM_CANDLES).fill(0),
        totalLifetime: 0,
        firstVisit: Date.now(),
        lastVisit: Date.now(),
      };
    }
    function loadState(): FlameState {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          if (p && Array.isArray(p.candlesLit) && p.candlesLit.length === NUM_CANDLES) {
            return {
              candlesLit: p.candlesLit.map((v: any) => v ? 1 : 0),
              totalLifetime: typeof p.totalLifetime === 'number' ? p.totalLifetime : 0,
              firstVisit: p.firstVisit || Date.now(),
              lastVisit: p.lastVisit || Date.now(),
            };
          }
        }
      } catch { /* ignore */ }
      return freshState();
    }
    function saveState(s: FlameState) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch { /* ignore */ }
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let droneOsc: OscillatorNode | null = null;
    let droneGain: GainNode | null = null;
    let ambientTimer: number | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.35;
      masterGain.connect(ctx.destination);
      // Convolution reverb — shares a 2.2s tail with /shrine-water so the
      // two elemental shrines feel like they're in the same room.
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 2.2);
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.4);
        }
      }
      convolver.buffer = ir;
      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.70;
      wetGain.gain.value = 0.40;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }
    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    // Soft brass-bell chime when a candle is lit
    function playChime() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const base = 880;  // A5
      // Fundamental
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = base;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.30, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.06, t + 0.10);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.5);
      osc.connect(g);
      connectVoice(g);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 1.6);
      // 2x shimmer
      const o2 = ctx.createOscillator();
      const g2 = ctx.createGain();
      o2.type = 'sine';
      o2.frequency.value = base * 2;
      g2.gain.setValueAtTime(0.0001, t);
      g2.gain.exponentialRampToValueAtTime(0.08, t + 0.008);
      g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
      o2.connect(g2);
      connectVoice(g2);
      scheduler.trackSource(o2);
      o2.start(t);
      o2.stop(t + 0.7);
      // Tiny 3x sparkle
      const o3 = ctx.createOscillator();
      const g3 = ctx.createGain();
      o3.type = 'sine';
      o3.frequency.value = base * 3;
      g3.gain.setValueAtTime(0.0001, t);
      g3.gain.exponentialRampToValueAtTime(0.03, t + 0.010);
      g3.gain.exponentialRampToValueAtTime(0.0001, t + 0.30);
      o3.connect(g3);
      connectVoice(g3);
      scheduler.trackSource(o3);
      o3.start(t);
      o3.stop(t + 0.35);
    }

    // Ambient crackle: short noise burst, lowpass-filtered to a warm pop
    function playCrackle() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const dur = 0.04 + Math.random() * 0.10;
      // Tiny noise buffer
      const bufLen = Math.floor(ctx.sampleRate * dur);
      const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufLen; i++) {
        // Pink-ish noise: bias toward lower frequencies via running sum
        data[i] = (Math.random() * 2 - 1) * (1 - i / bufLen);
      }
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 800 + Math.random() * 600;  // 800..1400Hz
      filter.Q.value = 1.2;
      const g = ctx.createGain();
      const peak = 0.08 + Math.random() * 0.10;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(peak, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      src.connect(filter).connect(g);
      connectVoice(g);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + dur + 0.05);
    }

    function startAmbient() {
      if (ambientTimer != null) return;
      const tick = () => {
        // Only play crackles when at least one candle is lit
        const litCount = currentState.candlesLit.reduce((a, b) => a + b, 0);
        if (litCount > 0) {
          // Maybe a tight burst (2 crackles)
          playCrackle();
          if (Math.random() < 0.3) {
            setTimeout(playCrackle, 60 + Math.random() * 80);
          }
        }
        ambientTimer = window.setTimeout(tick, 3000 + Math.random() * 4000);
      };
      ambientTimer = window.setTimeout(tick, 2400 + Math.random() * 2400);
    }
    function stopAmbient() {
      if (ambientTimer != null) { clearTimeout(ambientTimer); ambientTimer = null; }
    }

    // Drone for "altar full" state — ~200Hz sustained sine, very quiet
    function startDrone() {
      if (droneOsc || !ctx || !masterGain) return;
      const t = ctx.currentTime;
      droneOsc = ctx.createOscillator();
      droneGain = ctx.createGain();
      droneOsc.type = 'sine';
      droneOsc.frequency.value = 196.00;  // G3 — sits below the bell chime's A5
      droneGain.gain.setValueAtTime(0.0001, t);
      droneGain.gain.exponentialRampToValueAtTime(0.05, t + 2.4);
      droneOsc.connect(droneGain).connect(masterGain);
      droneOsc.start(t);
      // Slight detune over time gives organic feel
      droneOsc.detune.setValueAtTime(0, t);
    }
    function stopDrone() {
      if (!droneOsc || !droneGain || !ctx) return;
      const t = ctx.currentTime;
      droneGain.gain.cancelScheduledValues(t);
      droneGain.gain.setValueAtTime(droneGain.gain.value, t);
      droneGain.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
      const oldOsc = droneOsc;
      droneOsc = null;
      droneGain = null;
      setTimeout(() => { try { oldOsc.stop(); } catch { /* ignore */ } }, 1500);
    }

    // ---- DOM + state ----
    let currentState = freshState();

    function renderCandles() {
      const altar = document.getElementById('shf-altar')!;
      altar.innerHTML = '';
      for (let i = 0; i < NUM_CANDLES; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isLit = currentState.candlesLit[i] === 1;
        btn.className = 'shf__candle' + (isLit ? ' shf__candle--lit' : '');
        btn.dataset.idx = String(i);
        btn.setAttribute('aria-label', `Candle ${i + 1} · ${isLit ? 'lit' : 'unlit'}`);
        btn.setAttribute('aria-pressed', String(isLit));

        const flame = document.createElement('span');
        flame.className = 'shf__candle-flame';
        btn.appendChild(flame);

        const wick = document.createElement('span');
        wick.className = 'shf__candle-wick';
        btn.appendChild(wick);

        const body = document.createElement('span');
        body.className = 'shf__candle-body';
        btn.appendChild(body);

        btn.addEventListener('click', () => toggleCandle(i));
        altar.appendChild(btn);
      }
    }

    function toggleCandle(i: number) {
      const wasLit = currentState.candlesLit[i] === 1;
      currentState.candlesLit[i] = wasLit ? 0 : 1;
      if (!wasLit) {
        currentState.totalLifetime += 1;
        playChime();
        ensureCtx();
        startAmbient();
      }
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderCandles();
      refreshFooter();
      checkAltarFull();
    }

    function lightAll() {
      ensureCtx();
      startAmbient();
      let newLit = 0;
      for (let i = 0; i < NUM_CANDLES; i++) {
        if (currentState.candlesLit[i] === 0) {
          currentState.candlesLit[i] = 1;
          currentState.totalLifetime += 1;
          newLit++;
        }
      }
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderCandles();
      refreshFooter();
      // Staggered chimes: one per second new candle, capped at 4 chimes
      // so it feels celebratory but not noisy.
      const chimeCount = Math.min(4, newLit);
      for (let i = 0; i < chimeCount; i++) {
        setTimeout(playChime, i * 200);
      }
      checkAltarFull();
    }

    function blowOut() {
      currentState.candlesLit.fill(0);
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderCandles();
      refreshFooter();
      stopDrone();
      // Small soft "puff" — a single low-pass-filtered burst
      playCrackle();
    }

    function checkAltarFull() {
      const litCount = currentState.candlesLit.reduce((a, b) => a + b, 0);
      const backdrop = document.getElementById('shf-backdrop')!;
      if (litCount === NUM_CANDLES) {
        backdrop.classList.add('shf__backdrop--glowing');
        ensureCtx();
        startDrone();
      } else {
        backdrop.classList.remove('shf__backdrop--glowing');
        stopDrone();
      }
    }

    function refreshFooter() {
      const el = document.getElementById('shf-count')!;
      const litCount = currentState.candlesLit.reduce((a, b) => a + b, 0);
      const total = currentState.totalLifetime;
      const blowBtn = document.getElementById('shf-blow')! as HTMLButtonElement;
      blowBtn.disabled = litCount === 0;
      const lightAllBtn = document.getElementById('shf-light-all')! as HTMLButtonElement;
      lightAllBtn.disabled = litCount === NUM_CANDLES;
      if (total === 0) {
        el.innerHTML = 'your first visit';
      } else if (litCount === 0) {
        el.innerHTML = `you've lit <strong>${total}</strong> candle${total === 1 ? '' : 's'} here altogether`;
      } else if (litCount === NUM_CANDLES) {
        el.innerHTML = `all twelve burning · <strong>${total}</strong> lifetime`;
      } else {
        el.innerHTML = `<strong>${litCount}</strong> of 12 lit · <strong>${total}</strong> lifetime`;
      }
    }

    function init() {
      currentState = loadState();
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderCandles();
      refreshFooter();

      // Wire actions
      document.getElementById('shf-light-all')!.addEventListener('click', lightAll);
      document.getElementById('shf-blow')!.addEventListener('click', blowOut);

      // Wake audio + ambient on first interaction anywhere
      const wake = () => {
        ensureCtx();
        startAmbient();
        document.removeEventListener('pointerdown', wake);
        document.removeEventListener('keydown', wake);
        // Check if we restored to a full altar so the drone starts immediately
        checkAltarFull();
      };
      document.addEventListener('pointerdown', wake);
      document.addEventListener('keydown', wake);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { stopAmbient(); stopDrone(); }
        else if (ctx) { startAmbient(); checkAltarFull(); }
      });

      // Keyboard: digits 1-9 + 0 for the first 10 candles, space to blow out all
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        // Digits 1-9 → candles 0..8
        if (e.code.startsWith('Digit')) {
          const n = parseInt(e.code.slice(5), 10);
          if (!Number.isNaN(n) && n >= 1 && n <= 9) {
            e.preventDefault();
            toggleCandle(n - 1);
          }
        } else if (e.code === 'Digit0') {
          // 0 → candle 9
          e.preventDefault();
          toggleCandle(9);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          if (currentState.candlesLit.some(v => v === 1)) blowOut();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
