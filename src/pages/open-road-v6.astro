---
import BlockLayout from '../layouts/BlockLayout.astro';
import sky from '../assets/shrines/open-road-v6/01-sky.webp';
import view from '../assets/shrines/open-road-v6/02-view.webp';
import path from '../assets/shrines/open-road-v6/03-path.webp';
import water from '../assets/shrines/open-road-v6/04-water.webp';
import garden from '../assets/shrines/open-road-v6/05-garden.webp';
import keptThings from '../assets/shrines/open-road-v6/06-kept-things.webp';
import homeLight from '../assets/shrines/open-road-v6/07-home-light.webp';
import bloom from '../assets/shrines/open-road-v6/08-bloom.webp';
import moon from '../assets/shrines/open-road-v6/09-moon.webp';
import farLight from '../assets/shrines/open-road-v6/10-far-light.webp';
import socialCard from '../assets/shrines/open-road-v6/open-road-v6-og.jpg';

const title = 'Open Road VI · A Light for Pete';
const description =
  'A one-minute image vigil for Pete: ten works from the deeper archive, one unhurried passage, and optional opening and closing bells.';
const VIGIL_DURATION = 60_000;
const SLIDE_DURATION = 6_000;

const images = [
  {
    id: 'sky',
    name: 'Sky',
    line: 'May there be room enough.',
    image: sky,
    alt: 'Golden paper-textured clouds drift across a broad field of clear blue.',
  },
  {
    id: 'view',
    name: 'The view',
    line: 'May the horizon stay open.',
    image: view,
    alt: 'A calm blue ocean horizon appears through a dark architectural opening above a field of red flowers.',
  },
  {
    id: 'path',
    name: 'The path',
    line: 'May the way open.',
    image: path,
    alt: 'A bright geometric walkway leads through a lush modern garden toward blocks of yellow, red, and green.',
  },
  {
    id: 'water',
    name: 'Quiet water',
    line: 'May what is heavy be carried.',
    image: water,
    alt: 'Delicate pale-blue line waves meet an empty gray shore beneath a quiet cream sky.',
  },
  {
    id: 'garden',
    name: 'The garden',
    line: 'May tenderness outlast the season.',
    image: garden,
    alt: 'A saturated coastal garden surrounds a round white shelter with blue water and pale mountains beyond.',
  },
  {
    id: 'kept-things',
    name: 'Kept things',
    line: 'May what was loved remain near.',
    image: keptThings,
    alt: 'Orange flowers in a clear vase rest on old books beside a sunlit library window.',
  },
  {
    id: 'home-light',
    name: 'Home light',
    line: 'May there always be a place of rest.',
    image: homeLight,
    alt: 'A serene white-arched courtyard holds trees, wooden benches, and a few warm evening lamps.',
  },
  {
    id: 'bloom',
    name: 'The bloom',
    line: 'May warmth remain.',
    image: bloom,
    alt: 'A single bird-of-paradise flower rises from a rough clay pot into a wide band of angled sunlight.',
  },
  {
    id: 'moon',
    name: 'Moon offering',
    line: 'May distance soften.',
    image: moon,
    alt: 'A spare green still life places dark branches and round forms beneath a quiet white moon.',
  },
  {
    id: 'far-light',
    name: 'Far light',
    line: 'May love keep watch.',
    image: farLight,
    alt: 'A small bright sailing ship moves below misty blue mountains while pale birds cross the open air.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: 'https://pointcast.xyz/open-road-v6',
  description,
  applicationCategory: 'LifestyleApplication',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title={title}
  description={description}
  image={socialCard.src}
  imageWidth={1600}
  imageHeight={900}
  themeColor="#080713"
  immersive
  jsonLd={jsonLd}
>
  <section
    class="or6"
    id="open-road-v6-vigil"
    aria-labelledby="or6-title"
    data-state="idle"
    data-held="false"
    data-paused="false"
    style={`--or6-count: ${images.length};`}
  >
    <span class="or6__glint" id="or6-glint" aria-hidden="true"></span>

    <nav class="or6__wayfinding" aria-label="Open Road editions">
      <a href="/" aria-label="Return to PointCast home"><span aria-hidden="true">←</span> PointCast</a>
      <span aria-hidden="true">·</span>
      <a href="/open-road">I</a>
      <a href="/open-road-v2">II</a>
      <a href="/open-road-v3">III</a>
      <a href="/open-road-v4">IV</a>
      <a href="/open-road-v5">V</a>
      <span aria-current="page">VI</span>
      <a href="/open-road-v7">VII</a>
    </nav>

    <header class="or6__header">
      <div>
        <p class="or6__eyebrow">Open Road VI</p>
        <p class="or6__dedication">A light for Pete</p>
      </div>
      <button class="or6__sound" id="or6-sound" type="button" aria-pressed="false">
        <span class="or6__sound-mark" aria-hidden="true">◌</span>
        <span id="or6-sound-label">Bells off</span>
      </button>
    </header>

    <div class="or6__body">
      <section class="or6__vigil" aria-label="One-minute image vigil for Pete">
        <div class="or6__stage" id="or6-stage">
          <div class="or6__aura" aria-hidden="true"></div>
          <div class="or6__slides" id="or6-slides">
            {images.map((moment, index) => (
              <figure
                class:list={['or6__slide', { 'is-active': index === 0 }]}
                data-slide={index}
                data-name={moment.name}
                data-line={moment.line}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <img
                  src={moment.image.src}
                  alt={moment.alt}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
            ))}
          </div>

          <div class="or6__welcome" id="or6-welcome">
            <p class="or6__welcome-mark" aria-hidden="true">VI</p>
            <p class="or6__welcome-dedication">For Pete</p>
            <h1 id="or6-title">Stay for one quiet minute.</h1>
            <p>Ten images from the deeper archive. One unhurried passage. For Pete.</p>
            <button class="or6__begin" id="or6-begin" type="button">Begin the minute</button>
            <small>No words are required.</small>
          </div>

          <div class="or6__caption" id="or6-caption" aria-hidden="true">
            <div>
              <p class="or6__active-label">A quiet minute for Pete.</p>
              <h2 id="or6-moment-name">Sky</h2>
              <p id="or6-moment-line">May there be room enough.</p>
            </div>
            <p class="or6__counter" id="or6-counter" aria-hidden="true">01 / 10</p>
          </div>

          <div class="or6__closing" id="or6-closing" aria-hidden="true">
            <p class="or6__closing-mark" aria-hidden="true">✦</p>
            <h2>For Pete.</h2>
            <p>Held in love.<br />Carried in light.</p>
            <div class="or6__closing-actions">
              <button id="or6-still" type="button">Sit a little longer</button>
              <button id="or6-restart" type="button">Begin again</button>
              <button id="or6-share" type="button">Share this tribute</button>
            </div>
          </div>

          <button class="or6__return" id="or6-return" type="button">Return to the tribute</button>
        </div>

        <div class="or6__progress" id="or6-progress" aria-hidden="true">
          <span id="or6-progress-dot"></span>
          <i id="or6-progress-line"></i>
        </div>

        <div class="or6__controls" id="or6-controls" aria-label="Vigil controls">
          <button id="or6-prev" type="button" aria-label="Previous image"><span aria-hidden="true">←</span> Previous</button>
          <button id="or6-hold" class="or6__hold" type="button" aria-pressed="false">Hold this image</button>
          <button id="or6-next" type="button" aria-label="Next image">Next <span aria-hidden="true">→</span></button>
          <button id="or6-leave" class="or6__leave" type="button">Leave the vigil</button>
        </div>

        <ol class="or6__sequence" id="or6-sequence" aria-label="Ten images in the vigil">
          {images.map((moment, index) => (
            <li class:list={{ 'is-active': index === 0 }} data-sequence={index}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i aria-hidden="true"></i>
              <span class="or6__sr">{moment.name}: {moment.line}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <footer class="or6__footer">
      <p>For Pete · No words are required.</p>
      <a href="/open-road-v5">Return to The Window You Make</a>
    </footer>

    <p class="or6__sr" id="or6-status" aria-live="polite" aria-atomic="true"></p>
  </section>
</BlockLayout>

<style>
  :global(body:has(#open-road-v6-vigil)) {
    margin: 0;
    padding-bottom: 0;
    background: #080713;
    overflow-x: hidden;
  }

  :global(body:has(#open-road-v6-vigil) #pc-fb),
  :global(body:has(#open-road-v6-vigil) #pc-spell-layer),
  :global(body:has(#open-road-v6-vigil) #cursor-room),
  :global(body:has(#open-road-v6-vigil) #pc-freshness),
  :global(body:has(#open-road-v6-vigil) #pc-first-see) {
    display: none !important;
  }

  :global(body:has(#open-road-v6-vigil) #main-content) {
    max-width: none;
    padding: 0;
  }

  :global(html.cr-cursor-active body:has(#open-road-v6-vigil)),
  :global(html.cr-cursor-active body:has(#open-road-v6-vigil) #main-content),
  :global(html.cr-cursor-active body:has(#open-road-v6-vigil) #main-content *) {
    cursor: auto !important;
  }

  :global(html.cr-cursor-active body:has(#open-road-v6-vigil) a),
  :global(html.cr-cursor-active body:has(#open-road-v6-vigil) button) {
    cursor: pointer !important;
  }

  .or6 {
    --ink: #f3eddd;
    --muted: #bdb5a7;
    --amber: #d9a65e;
    --amber-bright: #f0c47f;
    --night: #080713;
    --violet: #171329;
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    color: var(--ink);
    background:
      radial-gradient(circle at 82% 16%, rgba(110, 77, 112, 0.18), transparent 34rem),
      radial-gradient(circle at 14% 68%, rgba(54, 67, 110, 0.14), transparent 38rem),
      linear-gradient(155deg, #080713 0%, #100c1c 48%, #090711 100%);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .or6::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: '';
    opacity: 0.3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(circle at center, black, transparent 82%);
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button {
    font: inherit;
  }

  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--amber-bright);
    outline-offset: 4px;
  }

  .or6__sr {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .or6__wayfinding,
  .or6__header,
  .or6__body,
  .or6__footer {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .or6__wayfinding {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: max(18px, env(safe-area-inset-top));
    color: #888195;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .or6__wayfinding a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .or6__wayfinding a:hover {
    color: var(--ink);
  }

  .or6__wayfinding [aria-current='page'] {
    color: var(--amber-bright);
  }

  .or6__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-block: 28px 22px;
  }

  .or6__eyebrow,
  .or6__dedication,
  .or6__header p {
    margin: 0;
  }

  .or6__eyebrow {
    color: #8e8799;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.27em;
    text-transform: uppercase;
  }

  .or6__dedication {
    padding-top: 7px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    letter-spacing: 0.015em;
  }

  .or6__sound {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    padding: 0 15px;
    border: 1px solid rgba(243, 237, 221, 0.17);
    border-radius: 999px;
    color: #b7afc0;
    background: rgba(11, 9, 20, 0.72);
    cursor: pointer;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }

  .or6__sound[aria-pressed='true'] {
    border-color: rgba(240, 196, 127, 0.52);
    color: var(--amber-bright);
    background: rgba(83, 55, 30, 0.22);
  }

  .or6__sound-mark {
    font-size: 1rem;
  }

  .or6__body {
    padding-bottom: 32px;
  }

  .or6__vigil {
    position: relative;
  }

  .or6__stage {
    position: relative;
    display: grid;
    min-height: min(68svh, 760px);
    overflow: hidden;
    border: 1px solid rgba(243, 237, 221, 0.13);
    border-radius: 3px;
    background: #06050d;
    box-shadow:
      0 36px 90px rgba(0, 0, 0, 0.46),
      inset 0 0 0 8px rgba(255, 255, 255, 0.015),
      inset 0 0 0 9px rgba(240, 196, 127, 0.06);
  }

  .or6__aura {
    position: absolute;
    inset: 8%;
    z-index: 0;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.16;
    background: radial-gradient(circle, rgba(228, 178, 109, 0.42), rgba(70, 52, 92, 0.08) 44%, transparent 72%);
    filter: blur(48px);
  }

  .or6__slides,
  .or6__slide {
    position: absolute;
    inset: 0;
  }

  .or6__slide {
    z-index: 1;
    display: grid;
    margin: 0;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.5s ease, visibility 1.5s step-end;
  }

  .or6__slide::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 6, 14, 0.16), transparent 24%, transparent 64%, rgba(7, 6, 14, 0.8)),
      linear-gradient(90deg, rgba(7, 6, 14, 0.22), transparent 22%, transparent 78%, rgba(7, 6, 14, 0.22));
  }

  .or6__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.5s ease, visibility 0s;
  }

  .or6__slide img {
    width: 100%;
    height: 100%;
    padding: clamp(22px, 4vw, 54px);
    object-fit: contain;
    filter: saturate(0.88) brightness(0.85);
    transform: scale(1);
  }

  .or6[data-state='running'] .or6__slide.is-active img {
    animation: or6-drift 6s linear both;
  }

  .or6[data-held='true'] .or6__slide.is-active img {
    animation-play-state: paused;
  }

  @keyframes or6-drift {
    from { transform: scale(1); }
    to { transform: scale(1.012); }
  }

  .or6__welcome,
  .or6__closing {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 32px;
    text-align: center;
    background:
      radial-gradient(circle at center, rgba(21, 17, 37, 0.62), rgba(7, 6, 14, 0.9) 66%),
      linear-gradient(rgba(7, 6, 14, 0.54), rgba(7, 6, 14, 0.86));
    backdrop-filter: blur(8px);
  }

  .or6__welcome-mark {
    margin: 0 0 4px;
    color: rgba(240, 196, 127, 0.25);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5rem, 13vw, 10rem);
    font-weight: 400;
    line-height: 0.8;
  }

  .or6__welcome-dedication {
    margin: 20px 0 12px;
    color: var(--amber-bright);
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .or6__welcome h1 {
    max-width: 760px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.97;
  }

  .or6__welcome > p:not(.or6__welcome-mark, .or6__welcome-dedication) {
    max-width: 580px;
    margin: 24px 0 28px;
    color: #c9c1cf;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.6;
  }

  .or6__begin {
    min-height: 52px;
    padding: 0 27px;
    border: 1px solid rgba(240, 196, 127, 0.74);
    border-radius: 999px;
    color: #15101c;
    background: var(--amber-bright);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .or6__begin:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(217, 166, 94, 0.2);
  }

  .or6__welcome small {
    margin-top: 18px;
    color: #81798a;
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
  }

  .or6__caption {
    position: absolute;
    right: clamp(24px, 5vw, 64px);
    bottom: clamp(24px, 5vw, 58px);
    left: clamp(24px, 5vw, 64px);
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    pointer-events: none;
    text-shadow: 0 2px 20px #05040b, 0 1px 4px #05040b;
  }

  .or6__active-label {
    margin: 0 0 9px;
    color: var(--amber-bright);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .or6__caption h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .or6__caption h2 + p {
    margin: 8px 0 0;
    color: #e7dfd4;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 2vw, 1.24rem);
    font-style: italic;
  }

  .or6__counter {
    margin: 0;
    color: rgba(243, 237, 221, 0.58);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.2em;
  }

  .or6__progress {
    position: relative;
    height: 2px;
    margin-top: 18px;
    overflow: hidden;
    background: rgba(243, 237, 221, 0.11);
  }

  .or6__progress span {
    position: absolute;
    top: -4px;
    width: 12px;
    height: 10px;
    border-radius: 50%;
    background: var(--amber-bright);
    box-shadow: 0 0 20px rgba(240, 196, 127, 0.9);
    left: 0;
    transform: translateX(-50%);
  }

  .or6__progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: linear-gradient(90deg, #8b5c32, var(--amber-bright));
    box-shadow: 0 0 16px rgba(240, 196, 127, 0.4);
  }

  .or6__controls {
    display: grid;
    grid-template-columns: 1fr minmax(170px, 1.3fr) 1fr auto;
    gap: 10px;
    margin-top: 14px;
  }

  .or6__controls button,
  .or6__closing-actions button,
  .or6__return {
    min-height: 46px;
    padding: 0 16px;
    border: 1px solid rgba(243, 237, 221, 0.15);
    border-radius: 2px;
    color: #c9c1cf;
    background: rgba(18, 14, 30, 0.7);
    cursor: pointer;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }

  .or6__controls button:hover,
  .or6__closing-actions button:hover,
  .or6__return:hover {
    border-color: rgba(240, 196, 127, 0.52);
    color: var(--ink);
    background: rgba(63, 44, 50, 0.48);
  }

  .or6__controls .or6__hold {
    border-color: rgba(240, 196, 127, 0.42);
    color: var(--amber-bright);
  }

  .or6__controls .or6__hold[aria-pressed='true'] {
    color: #17101d;
    background: var(--amber-bright);
  }

  .or6__controls .or6__leave {
    color: #8e8799;
  }

  .or6__sequence {
    display: grid;
    grid-template-columns: repeat(var(--or6-count), 1fr);
    gap: 8px;
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
  }

  .or6__sequence li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 8px;
    color: #9b93a8;
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    transition: color 250ms ease;
  }

  .or6__sequence i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: height 250ms ease, box-shadow 250ms ease;
  }

  .or6__sequence li.is-active {
    color: var(--amber-bright);
  }

  .or6__sequence li.is-active i {
    height: 2px;
    box-shadow: 0 0 10px rgba(240, 196, 127, 0.55);
  }

  .or6__closing {
    display: none;
  }

  .or6__closing-mark {
    margin: 0 0 18px;
    color: var(--amber-bright);
    font-size: 1.2rem;
  }

  .or6__closing h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .or6__closing > p:not(.or6__closing-mark) {
    margin: 22px 0 30px;
    color: #d8cfda;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2.5vw, 1.7rem);
    font-style: italic;
    line-height: 1.5;
  }

  .or6__closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .or6__return {
    position: absolute;
    right: 24px;
    bottom: 24px;
    z-index: 7;
    display: none;
  }

  .or6[data-state='idle'] .or6__caption,
  .or6[data-state='idle'] .or6__progress,
  .or6[data-state='idle'] .or6__controls,
  .or6[data-state='idle'] .or6__sequence {
    visibility: hidden;
  }

  .or6[data-state='running'] .or6__welcome,
  .or6[data-state='complete'] .or6__welcome,
  .or6[data-state='still'] .or6__welcome {
    display: none;
  }

  .or6[data-state='complete'] .or6__closing {
    display: grid;
  }

  .or6[data-state='complete'] .or6__caption,
  .or6[data-state='complete'] .or6__controls,
  .or6[data-state='still'] .or6__caption,
  .or6[data-state='still'] .or6__progress,
  .or6[data-state='still'] .or6__controls,
  .or6[data-state='still'] .or6__sequence {
    display: none;
  }

  .or6[data-state='still'] .or6__return {
    display: block;
  }

  .or6[data-held='true'] .or6__progress {
    box-shadow: 0 0 18px rgba(240, 196, 127, 0.12);
  }

  .or6__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px max(26px, env(safe-area-inset-bottom));
    color: #9b93a8;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.78rem;
    font-style: italic;
  }

  .or6__footer p {
    margin: 0;
  }

  .or6__footer a {
    color: #b3aabd;
    text-decoration-color: rgba(179, 170, 189, 0.42);
    text-underline-offset: 4px;
  }

  .or6__glint {
    position: fixed;
    z-index: 20;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: #ffe0a7;
    box-shadow: 0 0 18px 6px rgba(240, 196, 127, 0.35);
    transition: opacity 250ms ease;
  }

  @media (max-width: 760px) {
    .or6__wayfinding,
    .or6__header,
    .or6__body,
    .or6__footer {
      width: min(100% - 28px, 1180px);
    }

    .or6__wayfinding {
      gap: 9px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .or6__wayfinding::-webkit-scrollbar {
      display: none;
    }

    .or6__header {
      padding-block: 20px 16px;
    }

    .or6__stage {
      min-height: 64svh;
    }

    .or6__slide img {
      padding: 18px;
    }

    .or6__caption {
      right: 22px;
      bottom: 22px;
      left: 22px;
    }

    .or6__controls {
      grid-template-columns: 1fr 1fr;
    }

    .or6__controls .or6__hold,
    .or6__controls .or6__leave {
      grid-column: span 2;
    }

    .or6__sequence {
      gap: 4px;
    }

    .or6__sequence li {
      display: block;
      text-align: center;
    }

    .or6__sequence i {
      margin-top: 5px;
    }

    .or6__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .or6__closing-actions {
      flex-direction: column;
      width: min(100%, 280px);
    }
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .or6__header {
      padding-block: 16px 14px;
    }

    .or6__stage {
      min-height: 560px;
    }

    .or6__welcome-mark {
      font-size: 5rem;
    }

    .or6__welcome h1 {
      font-size: 3.4rem;
    }
  }

  @media (pointer: coarse) {
    .or6__glint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    .or6__slide,
    .or6__slide.is-active {
      transition-duration: 0.01ms;
    }

    .or6[data-state='running'] .or6__slide.is-active img {
      animation: none !important;
    }

    .or6__begin,
    .or6__progress span,
    .or6__progress i,
    .or6__sequence li,
    .or6__sequence i {
      transition-duration: 0.01ms;
    }
  }
</style>

<script define:vars={{ VIGIL_DURATION, SLIDE_DURATION }}>
  const shrine = document.querySelector('#open-road-v6-vigil');
  const slides = [...document.querySelectorAll('[data-slide]')];
  const sequence = [...document.querySelectorAll('[data-sequence]')];
  const beginButton = document.querySelector('#or6-begin');
  const prevButton = document.querySelector('#or6-prev');
  const nextButton = document.querySelector('#or6-next');
  const holdButton = document.querySelector('#or6-hold');
  const leaveButton = document.querySelector('#or6-leave');
  const stillButton = document.querySelector('#or6-still');
  const restartButton = document.querySelector('#or6-restart');
  const shareButton = document.querySelector('#or6-share');
  const returnButton = document.querySelector('#or6-return');
  const soundButton = document.querySelector('#or6-sound');
  const soundLabel = document.querySelector('#or6-sound-label');
  const caption = document.querySelector('#or6-caption');
  const closing = document.querySelector('#or6-closing');
  const momentName = document.querySelector('#or6-moment-name');
  const momentLine = document.querySelector('#or6-moment-line');
  const counter = document.querySelector('#or6-counter');
  const status = document.querySelector('#or6-status');
  const glint = document.querySelector('#or6-glint');
  const progressDot = document.querySelector('#or6-progress-dot');
  const progressLine = document.querySelector('#or6-progress-line');

  const VIGIL_MS = Number(VIGIL_DURATION);
  const STEP_MS = Number(SLIDE_DURATION);
  let state = 'idle';
  let held = false;
  let elapsed = 0;
  let currentIndex = 0;
  let lastFrame = 0;
  let frameId = 0;
  let soundOn = false;
  let audioContext = null;
  let masterGain = null;
  let compressor = null;
  const activeOscillators = new Set();

  function announce(message) {
    if (status) status.textContent = message;
  }

  function setState(nextState) {
    state = nextState;
    if (shrine) shrine.dataset.state = nextState;
    const active = nextState === 'running';
    caption?.setAttribute('aria-hidden', String(!active));
    closing?.setAttribute('aria-hidden', String(nextState !== 'complete'));
  }

  function updateProgress() {
    const progress = Math.max(0, Math.min(1, elapsed / VIGIL_MS));
    shrine?.style.setProperty('--or6-progress', String(progress));
    const percent = `${progress * 100}%`;
    if (progressDot) progressDot.style.left = percent;
    if (progressLine) progressLine.style.width = percent;
  }

  function showMoment(index, shouldAnnounce = true) {
    currentIndex = Math.max(0, Math.min(slides.length - 1, index));
    slides.forEach((slide, slideIndex) => {
      const active = slideIndex === currentIndex;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
    });
    sequence.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === currentIndex));

    const activeSlide = slides[currentIndex];
    const name = activeSlide?.dataset.name || 'Image';
    const line = activeSlide?.dataset.line || '';
    if (momentName) momentName.textContent = name;
    if (momentLine) momentLine.textContent = line;
    if (counter) counter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;

    const nextImage = slides[Math.min(slides.length - 1, currentIndex + 1)]?.querySelector('img');
    nextImage?.decode?.().catch(() => {});
    if (shouldAnnounce) announce(`${name}. ${line} Image ${currentIndex + 1} of ${slides.length}.`);
  }

  function stopOscillators() {
    activeOscillators.forEach((oscillator) => {
      try { oscillator.stop(); } catch {}
    });
    activeOscillators.clear();
  }

  async function ensureAudio() {
    if (audioContext) {
      if (audioContext.state === 'suspended') await audioContext.resume();
      return audioContext;
    }
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) return null;
    audioContext = new AudioContextClass();
    compressor = audioContext.createDynamicsCompressor();
    compressor.threshold.value = -32;
    compressor.knee.value = 20;
    compressor.ratio.value = 4;
    compressor.attack.value = 0.012;
    compressor.release.value = 0.5;
    masterGain = audioContext.createGain();
    masterGain.gain.value = 0.14;
    masterGain.connect(compressor);
    compressor.connect(audioContext.destination);
    return audioContext;
  }

  function playBell(frequency) {
    if (!soundOn || document.hidden || !audioContext || !masterGain) return;
    [frequency, frequency * 2.01].forEach((tone, index) => {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      const now = audioContext.currentTime + index * 0.025;
      oscillator.type = index ? 'sine' : 'triangle';
      oscillator.frequency.setValueAtTime(tone, now);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(index ? 0.009 : 0.025, now + 0.045);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.2);
      oscillator.connect(gain);
      gain.connect(masterGain);
      oscillator.start(now);
      oscillator.stop(now + 2.3);
      activeOscillators.add(oscillator);
      oscillator.addEventListener('ended', () => activeOscillators.delete(oscillator), { once: true });
    });
  }

  function cancelVigilFrame() {
    if (frameId) cancelAnimationFrame(frameId);
    frameId = 0;
  }

  function finishVigil() {
    cancelVigilFrame();
    elapsed = VIGIL_MS;
    held = false;
    shrine.dataset.held = 'false';
    holdButton?.setAttribute('aria-pressed', 'false');
    if (holdButton) holdButton.textContent = 'Hold this image';
    showMoment(slides.length - 1, false);
    updateProgress();
    setState('complete');
    playBell(392);
    announce('The quiet minute is complete. For Pete. Held in love. Carried in light.');
    requestAnimationFrame(() => stillButton?.focus({ preventScroll: true }));
  }

  function onFrame(now) {
    if (state !== 'running') return;
    if (!lastFrame) lastFrame = now;
    const delta = Math.min(250, Math.max(0, now - lastFrame));
    lastFrame = now;
    if (!held && !document.hidden) {
      elapsed += delta;
      if (elapsed >= VIGIL_MS) {
        finishVigil();
        return;
      }
      const nextIndex = Math.min(slides.length - 1, Math.floor(elapsed / STEP_MS));
      if (nextIndex !== currentIndex) showMoment(nextIndex);
      updateProgress();
    }
    frameId = requestAnimationFrame(onFrame);
  }

  function beginVigil() {
    cancelVigilFrame();
    elapsed = 0;
    held = false;
    lastFrame = 0;
    shrine.dataset.held = 'false';
    holdButton?.setAttribute('aria-pressed', 'false');
    if (holdButton) holdButton.textContent = 'Hold this image';
    setState('running');
    showMoment(0);
    updateProgress();
    playBell(261.63);
    announce('A quiet minute for Pete has begun. Sky. May there be room enough. Image 1 of 10.');
    requestAnimationFrame(() => holdButton?.focus({ preventScroll: true }));
    frameId = requestAnimationFrame(onFrame);
  }

  function leaveVigil() {
    cancelVigilFrame();
    stopOscillators();
    elapsed = 0;
    held = false;
    lastFrame = 0;
    shrine.dataset.held = 'false';
    holdButton?.setAttribute('aria-pressed', 'false');
    if (holdButton) holdButton.textContent = 'Hold this image';
    setState('idle');
    showMoment(0, false);
    updateProgress();
    announce('The vigil is at rest. Begin again whenever you are ready.');
    requestAnimationFrame(() => beginButton?.focus({ preventScroll: true }));
  }

  function toggleHold() {
    if (state !== 'running') return;
    held = !held;
    lastFrame = performance.now();
    shrine.dataset.held = String(held);
    holdButton?.setAttribute('aria-pressed', String(held));
    if (holdButton) holdButton.textContent = held ? 'Let it pass' : 'Hold this image';
    announce(held ? 'This image is being held. The quiet minute is paused.' : 'The image is passing again. The quiet minute continues.');
  }

  function moveMoment(step) {
    if (state !== 'running') return;
    const target = Math.max(0, Math.min(slides.length - 1, currentIndex + step));
    if (target === currentIndex) return;
    elapsed = target * STEP_MS;
    lastFrame = performance.now();
    showMoment(target);
    updateProgress();
  }

  beginButton?.addEventListener('click', beginVigil);
  restartButton?.addEventListener('click', beginVigil);
  prevButton?.addEventListener('click', () => moveMoment(-1));
  nextButton?.addEventListener('click', () => moveMoment(1));
  holdButton?.addEventListener('click', toggleHold);
  leaveButton?.addEventListener('click', leaveVigil);

  stillButton?.addEventListener('click', () => {
    setState('still');
    announce('The final image will remain still. No words are required.');
    requestAnimationFrame(() => returnButton?.focus({ preventScroll: true }));
  });

  returnButton?.addEventListener('click', () => {
    setState('complete');
    announce('For Pete. Held in love. Carried in light.');
    requestAnimationFrame(() => stillButton?.focus({ preventScroll: true }));
  });

  shareButton?.addEventListener('click', async () => {
    const url = new URL('/open-road-v6', window.location.origin).toString();
    const text = 'For Pete. Held in love. Carried in light.';
    try {
      if (navigator.share) {
        await navigator.share({ title: 'Open Road VI · A Light for Pete', text, url });
        announce('The tribute is ready to travel.');
      } else {
        await navigator.clipboard.writeText(`${text}\n${url}`);
        announce('The tribute link was copied.');
      }
    } catch (error) {
      if (error?.name !== 'AbortError') announce('The tribute remains here and is ready to share from the address bar.');
    }
  });

  soundButton?.addEventListener('click', async () => {
    soundOn = !soundOn;
    soundButton.setAttribute('aria-pressed', String(soundOn));
    if (soundOn) {
      if (soundLabel) soundLabel.textContent = 'Bells on';
      const context = await ensureAudio();
      if (!soundOn || document.hidden) return;
      if (!context) {
        soundOn = false;
        soundButton.setAttribute('aria-pressed', 'false');
        if (soundLabel) soundLabel.textContent = 'Bells unavailable';
        announce('Bells are unavailable in this browser. The vigil remains silent.');
        return;
      }
      announce('Bells are on. One will sound at the beginning and one at the end.');
    } else {
      if (soundLabel) soundLabel.textContent = 'Bells off';
      stopOscillators();
      announce('Bells are off. The vigil will remain silent.');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && state !== 'idle') {
      event.preventDefault();
      leaveVigil();
      return;
    }
    if (state !== 'running') return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      moveMoment(-1);
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      moveMoment(1);
    } else if (
      (event.key === ' ' || event.code === 'Space')
      && (!(event.target instanceof Element) || !event.target.closest('button, a'))
    ) {
      event.preventDefault();
      toggleHold();
    }
  });

  document.addEventListener('visibilitychange', () => {
    shrine.dataset.paused = String(document.hidden);
    lastFrame = performance.now();
    if (document.hidden) {
      stopOscillators();
      audioContext?.suspend().catch(() => {});
    } else if (soundOn) {
      audioContext?.resume().catch(() => {});
    }
  });

  if (glint && window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (event) => {
      glint.style.left = `${event.clientX}px`;
      glint.style.top = `${event.clientY}px`;
      glint.style.opacity = '0.68';
    }, { passive: true });
    document.documentElement.addEventListener('mouseleave', () => { glint.style.opacity = '0'; });
  }

  showMoment(0, false);
  updateProgress();
</script>
