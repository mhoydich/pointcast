---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ANTI_TIME_PATTERNS, PAPER_META, PAPER_NOTES, PHILOSOPHICAL_NOTES, PRACTICE_LADDER, REFERENCES, TEN_TIME_FRAMES, THE_DIAGNOSIS, TIME_ATLAS } from '../lib/timePaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/time', name: PAPER_META.title, description, url: 'https://pointcast.xyz/time', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/time.json', title: 'Time (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">UES</a><span aria-hidden="true">/</span><span>time</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY</p>
      <h1>TIME.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="dx"><p class="kicker">THE DIAGNOSIS</p><h2>What modern stress actually is.</h2>
      <p class="block"><strong>What stress is:</strong> {THE_DIAGNOSIS.whatStressIs}</p>
      <p class="block"><strong>How the clock got here:</strong> {THE_DIAGNOSIS.howTheClockGotHere}</p>
      <p class="block"><strong>The Thompson thesis:</strong> {THE_DIAGNOSIS.thompsonThesis}</p>
      <p class="block"><strong>Why it hurts:</strong> {THE_DIAGNOSIS.whyItHurts}</p>
      <p class="block"><strong>What the corridor already does:</strong> {THE_DIAGNOSIS.whatTheCorridorAlreadyDoes}</p>
    </section>

    <section class="frames"><p class="kicker">TEN TIME FRAMES · ALONGSIDE THE INDUSTRIAL CLOCK</p><h2>The corridor's working alternatives.</h2>
      <ol class="tf-list">{TEN_TIME_FRAMES.map((t, i) => (
        <li>
          <div class="tf__head"><span class="tf__num">{String(i+1).padStart(2,'0')}</span><h3>{t.name}</h3></div>
          <p class="tf__desc">{t.description}</p>
          <p class="tf__meta"><strong>Cadence:</strong> {t.cadence}</p>
          <p class="tf__row"><strong>Corridor practice:</strong> {t.corridorPractice}</p>
          <p class="tf__row"><strong>Human tradition:</strong> {t.humanTradition}</p>
          <p class="tf__row"><strong>Scientific basis:</strong> {t.scientificBasis}</p>
          <p class="tf__why"><strong>Why it helps:</strong> {t.whyItHelps}</p>
        </li>
      ))}</ol>
    </section>

    <section class="atlas"><p class="kicker">UES TIME ATLAS · DAILY → DECENNIAL</p><h2>{TIME_ATLAS.description}</h2>
      <h3 class="sh">Daily</h3>
      <ol class="atlas-list">{TIME_ATLAS.daily.map((d) => (<li><span class="atlas__when">{d.time}</span><div><span class="atlas__frame">{d.frame}</span><p>{d.practice}</p></div></li>))}</ol>
      <h3 class="sh">Weekly</h3>
      <ol class="atlas-list">{TIME_ATLAS.weekly.map((d) => (<li><span class="atlas__when">{d.day}</span><div><span class="atlas__frame">{d.frame}</span><p>{d.practice}</p></div></li>))}</ol>
      <h3 class="sh">Monthly</h3>
      <ol class="atlas-list">{TIME_ATLAS.monthly.map((d) => (<li><span class="atlas__when">{d.event}</span><div><span class="atlas__frame">{d.frame}</span><p>{d.practice}</p></div></li>))}</ol>
      <h3 class="sh">Seasonal</h3>
      <ol class="atlas-list">{TIME_ATLAS.seasonal.map((d) => (<li><span class="atlas__when">{d.event}</span><div><span class="atlas__frame">{d.frame}</span><p>{d.practice}</p></div></li>))}</ol>
      <h3 class="sh">Multi-year</h3>
      <ol class="atlas-list">{TIME_ATLAS.multiYear.map((d) => (<li><span class="atlas__when">{d.interval}</span><div><span class="atlas__frame">{d.frame}</span><p>{d.practice}</p></div></li>))}</ol>
    </section>

    <section class="anti"><p class="kicker">EIGHT ANTI-TIME PATTERNS · INDUSTRIAL-CLOCK INJURIES</p><h2>What to subtract.</h2>
      <ol class="ax-list">{ANTI_TIME_PATTERNS.map((a) => (
        <li>
          <h3>{a.pattern}</h3>
          <p class="ax__rep"><strong>Replacement:</strong> {a.replacement}</p>
          <p class="ax__cost"><strong>Cost of the pattern:</strong> {a.cost}</p>
        </li>
      ))}</ol>
    </section>

    <section class="ladder"><p class="kicker">EIGHT-WEEK PRACTICE LADDER</p><h2>How to begin.</h2>
      <ol class="lad-list">{PRACTICE_LADDER.map((p) => (
        <li>
          <h3>{p.stage}</h3>
          <p>{p.practice}</p>
        </li>
      ))}</ol>
    </section>

    <section class="phil"><p class="kicker">PHILOSOPHICAL NOTES</p><h2>Why this paper, why now.</h2>
      <p class="block"><strong>Why time and not productivity:</strong> {PHILOSOPHICAL_NOTES.whyTimeAndNotProductivity}</p>
      <p class="block"><strong>Why not just meditation:</strong> {PHILOSOPHICAL_NOTES.whyNotJustMeditation}</p>
      <p class="block"><strong>Why not abolish the clock:</strong> {PHILOSOPHICAL_NOTES.whyNotAbolishTheClock}</p>
      <p class="block"><strong>Why the corridor matters:</strong> {PHILOSOPHICAL_NOTES.whyTheCorridorMatters}</p>
      <p class="block"><strong>Why now:</strong> {PHILOSOPHICAL_NOTES.whyNow}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COHORT · RESEARCHERS · PRACTITIONERS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/marine-layer">Marine Layer · UES-WP-2026-01</a>
      <a href="/p2p-ai">Peer-to-Peer AI · UES-WP-2026-15</a>
      <a href="/bath-house">Bath House · UES-WP-2026-14</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/time.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --tm-ink:#1a1a1a; --tm-paper:#fdf9ee; --tm-mustard:#d4a534; --tm-rust:#b85a3a; --tm-sage:#2d6a3d; --tm-violet:#5b3d7a; --tm-tide:#3d6a8a; --tm-fog:#d8d2c4; --tm-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--tm-paper); color: var(--tm-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--tm-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--tm-tide); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--tm-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--tm-tide); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 140px; line-height: .9; font-weight: 700; letter-spacing: -.04em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--tm-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--tm-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--tm-tide); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--tm-tide); }

  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--tm-tide); max-width: 72ch; font-family: Georgia, serif; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--tm-tide); margin-right: 6px; }

  .tf-list, .ax-list, .lad-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .tf-list li { padding: 14px; background: #fff; border: 2px solid var(--tm-ink); border-left: 8px solid var(--tm-tide); }
  .tf__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 2px solid var(--tm-tide); }
  .tf__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--tm-tide); }
  .tf__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .tf__desc { font-size: 14px; line-height: 1.6; margin: 0 0 8px; font-family: Georgia, serif; }
  .tf__meta, .tf__row, .tf__why { padding: 7px 10px; background: var(--tm-paper); margin: 0 0 5px; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--tm-fog); }
  .tf__why { border-left-color: var(--tm-sage); }
  .tf-list strong, .ax-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--tm-tide); margin-right: 4px; }

  .atlas-list { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 6px; }
  .atlas-list li { display: grid; grid-template-columns: 220px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--tm-ink); border-left: 5px solid var(--tm-tide); align-items: baseline; }
  .atlas__when { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--tm-rust); letter-spacing: .08em; }
  .atlas__frame { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--tm-tide); display: block; margin-bottom: 4px; }
  .atlas-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .ax-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--tm-ink); border-left: 6px solid var(--tm-rust); }
  .ax-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }
  .ax-list p { margin: 0 0 5px; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .ax__rep { padding: 6px 10px; background: var(--tm-paper); border-left: 3px solid var(--tm-sage); }
  .ax__cost { padding: 6px 10px; background: var(--tm-paper); border-left: 3px solid var(--tm-rust); }

  .lad-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--tm-ink); border-left: 6px solid var(--tm-mustard); }
  .lad-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 6px; font-weight: 700; color: var(--tm-tide); }
  .lad-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  .invitation { background: var(--tm-tide); color: var(--tm-paper); border-top-color: var(--tm-tide); }
  .invitation .kicker { background: var(--tm-mustard); color: var(--tm-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--tm-mustard); color: var(--tm-ink); border-left: 4px solid var(--tm-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .85; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--tm-tide); color: var(--tm-paper); text-decoration: none; }
  .links a:hover { background: var(--tm-rust); }

  @media (max-width: 800px) { h1 { font-size: 96px; } .atlas-list li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 64px; } }
</style>
