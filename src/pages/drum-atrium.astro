---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Atrium — bossa nova through tall windows, ten minutes" description="A daytime room. Tall windows looking onto palms and a pool, jewel-toned banquettes inside, a small kit at the back. Bossa rhythm in late-morning light. Set it and listen.">
  <main class="da" id="da" data-built={built}>
    <header class="da__hero">
      <p class="da__kicker">DRUM · ATRIUM · bossa · tall windows · ten minutes</p>
      <h1 class="da__title">The room with the palms.</h1>
      <p class="da__sub">A daytime room. Tall windows on the left looking onto palm trees and a swimming pool, jewel-toned tropical-print banquettes inside, a stone wall on the right, a small kit at the back. The light comes in warm and bright. The rhythm is bossa nova: kick on one, brush on two and four, light shaker on the eighth notes. Ten minutes of late morning that turns into noon and back.</p>
    </header>

    <section class="da__stage" id="da-stage" data-state="idle">
      <div class="da__room" aria-hidden="true">
        <svg class="da__scene" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="daSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a8d8e8"/>
              <stop offset="100%" stop-color="#d8e8f0"/>
            </linearGradient>
            <linearGradient id="daPool" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#5ca5c0"/>
              <stop offset="100%" stop-color="#2a6a85"/>
            </linearGradient>
            <linearGradient id="daWall" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c8b09a"/>
              <stop offset="100%" stop-color="#8a7058"/>
            </linearGradient>
            <linearGradient id="daFloor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#5a3822"/>
              <stop offset="100%" stop-color="#2a1c12"/>
            </linearGradient>
            <pattern id="daStone" x="0" y="0" width="120" height="80" patternUnits="userSpaceOnUse">
              <rect width="120" height="80" fill="#a89078"/>
              <rect x="0" y="0" width="60" height="40" fill="#9a8068" stroke="#6a4828" stroke-width="0.6"/>
              <rect x="60" y="0" width="60" height="40" fill="#b09680" stroke="#6a4828" stroke-width="0.6"/>
              <rect x="0" y="40" width="40" height="40" fill="#a08868" stroke="#6a4828" stroke-width="0.6"/>
              <rect x="40" y="40" width="80" height="40" fill="#9a7e60" stroke="#6a4828" stroke-width="0.6"/>
            </pattern>
            <pattern id="daUphol" x="0" y="0" width="100" height="70" patternUnits="userSpaceOnUse">
              <rect width="100" height="70" fill="#2a4a36"/>
              <!-- Tropical floral pattern: jewel tones over deep green -->
              <ellipse cx="20" cy="14" rx="14" ry="9" fill="#d23e58" opacity="0.78"/>
              <ellipse cx="14" cy="10" rx="6" ry="3" fill="#f4c150" opacity="0.85"/>
              <ellipse cx="58" cy="32" rx="16" ry="11" fill="#7a3c8a" opacity="0.78"/>
              <ellipse cx="62" cy="34" rx="6" ry="4" fill="#e85e6b" opacity="0.85"/>
              <ellipse cx="84" cy="58" rx="12" ry="8" fill="#f08038" opacity="0.78"/>
              <ellipse cx="86" cy="60" rx="5" ry="3" fill="#f4c150" opacity="0.85"/>
              <ellipse cx="40" cy="56" rx="10" ry="6" fill="#3c8a6e" opacity="0.78"/>
              <ellipse cx="42" cy="58" rx="4" ry="2.5" fill="#9bd28a" opacity="0.85"/>
              <ellipse cx="92" cy="10" rx="6" ry="4" fill="#9bd28a" opacity="0.7"/>
              <ellipse cx="8" cy="64" rx="5" ry="3" fill="#3c6e8a" opacity="0.7"/>
            </pattern>
            <linearGradient id="daDrumShell" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a87838"/>
              <stop offset="55%" stop-color="#7a5220"/>
              <stop offset="100%" stop-color="#3a2208"/>
            </linearGradient>
            <linearGradient id="daDrumHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f0e0c0"/>
              <stop offset="100%" stop-color="#c8a878"/>
            </linearGradient>
            <radialGradient id="daCymbal" cx="50%" cy="35%" r="70%">
              <stop offset="0%" stop-color="#e8c878"/>
              <stop offset="65%" stop-color="#a8853a"/>
              <stop offset="100%" stop-color="#5a4218"/>
            </radialGradient>
            <radialGradient id="daPalmLeaf" cx="50%" cy="50%" r="60%">
              <stop offset="0%" stop-color="#5a8a48"/>
              <stop offset="100%" stop-color="#1c4a28"/>
            </radialGradient>
          </defs>

          <!-- Right side: stone wall + ceiling slab + back portion -->
          <rect x="0" y="0" width="1400" height="700" fill="#3a2818"/>
          <!-- Floor -->
          <rect x="0" y="620" width="1400" height="180" fill="url(#daFloor)"/>
          <!-- Decorative tiled pattern on floor -->
          <g>
            {Array.from({ length: 14 }, (_, i) => Array.from({ length: 4 }, (_, j) => {
              const x = i * 100;
              const y = 620 + j * 45;
              const fill = (i + j) % 3 === 0 ? '#7a4a28' : (i + j) % 3 === 1 ? '#5a3822' : '#3a2412';
              return <rect x={x} y={y} width="100" height="45" fill={fill} stroke="#1a0c04" stroke-width="0.4" opacity={0.72 + j * 0.04}/>;
            })).flat()}
          </g>

          <!-- LEFT HALF: Tall windows with palms + pool visible through them -->
          <!-- Sky outside -->
          <rect x="0" y="0" width="700" height="640" fill="url(#daSky)"/>
          <!-- Distant pool + landscaping -->
          <rect x="0" y="450" width="700" height="190" fill="url(#daPool)"/>
          <!-- Pool tile rim -->
          <rect x="0" y="440" width="700" height="14" fill="#c8b878"/>
          <!-- Pool water shimmer -->
          <g stroke="rgba(255,255,255,0.4)" stroke-width="1" fill="none">
            <path d="M 0 480 Q 60 478 120 480 Q 180 482 240 480 Q 300 478 360 480 Q 420 482 480 480 Q 540 478 600 480 Q 660 482 700 480"/>
            <path d="M 0 520 Q 60 522 120 520 Q 180 518 240 520 Q 300 522 360 520 Q 420 518 480 520 Q 540 522 600 520 Q 660 518 700 520"/>
            <path d="M 0 570 Q 60 572 120 570 Q 180 568 240 570 Q 300 572 360 570 Q 420 568 480 570 Q 540 572 600 570 Q 660 568 700 570"/>
          </g>
          <!-- Distant palm tree silhouettes outside -->
          <g transform="translate(140, 440)">
            <rect x="-3" y="-180" width="6" height="180" fill="#3a2410"/>
            <g fill="url(#daPalmLeaf)">
              <path d="M 0 -180 Q -80 -200 -130 -150 Q -100 -190 -10 -170 Z"/>
              <path d="M 0 -180 Q 80 -200 130 -150 Q 100 -190 10 -170 Z"/>
              <path d="M 0 -180 Q -50 -240 -80 -270 Q -20 -250 5 -190 Z"/>
              <path d="M 0 -180 Q 50 -240 80 -270 Q 20 -250 -5 -190 Z"/>
              <path d="M 0 -180 Q -100 -180 -160 -160 Q -90 -150 -10 -170 Z"/>
              <path d="M 0 -180 Q 100 -180 160 -160 Q 90 -150 10 -170 Z"/>
            </g>
          </g>
          <g transform="translate(440, 440)">
            <rect x="-2.5" y="-150" width="5" height="150" fill="#3a2410"/>
            <g fill="url(#daPalmLeaf)">
              <path d="M 0 -150 Q -70 -170 -110 -120 Q -85 -160 -8 -140 Z"/>
              <path d="M 0 -150 Q 70 -170 110 -120 Q 85 -160 8 -140 Z"/>
              <path d="M 0 -150 Q -40 -200 -65 -220 Q -15 -210 4 -160 Z"/>
              <path d="M 0 -150 Q 40 -200 65 -220 Q 15 -210 -4 -160 Z"/>
            </g>
          </g>
          <g transform="translate(620, 440)">
            <rect x="-2" y="-120" width="4" height="120" fill="#3a2410"/>
            <g fill="url(#daPalmLeaf)" opacity="0.85">
              <path d="M 0 -120 Q -55 -135 -90 -95 Q -68 -125 -6 -110 Z"/>
              <path d="M 0 -120 Q 55 -135 90 -95 Q 68 -125 6 -110 Z"/>
              <path d="M 0 -120 Q -30 -160 -50 -175 Q -10 -165 3 -130 Z"/>
              <path d="M 0 -120 Q 30 -160 50 -175 Q 10 -165 -3 -130 Z"/>
            </g>
          </g>

          <!-- Window frames overlay -->
          <!-- Frame top -->
          <rect x="0" y="0" width="700" height="40" fill="#3a2818"/>
          <!-- Frame bottom (sill above the floor) -->
          <rect x="0" y="620" width="700" height="20" fill="#3a2818"/>
          <!-- Vertical mullions -->
          <rect x="170" y="40" width="14" height="600" fill="#3a2818"/>
          <rect x="340" y="40" width="14" height="600" fill="#3a2818"/>
          <rect x="510" y="40" width="14" height="600" fill="#3a2818"/>
          <!-- Top header bar of windows -->
          <rect x="0" y="120" width="700" height="14" fill="#3a2818"/>

          <!-- RIGHT HALF: stone wall (after windows end) -->
          <rect x="700" y="0" width="700" height="640" fill="url(#daStone)"/>
          <rect x="700" y="0" width="700" height="640" fill="url(#daStone)"/>

          <!-- Large interior potted palm — between windows and right wall area -->
          <g transform="translate(800, 480)">
            <!-- Pot -->
            <path d="M -50 140 L -60 60 L 60 60 L 50 140 Z" fill="#7a4828" stroke="#3a2410" stroke-width="1.5"/>
            <ellipse cx="0" cy="60" rx="60" ry="10" fill="#3a2410"/>
            <!-- Palm trunk -->
            <rect x="-5" y="-180" width="10" height="240" fill="#5a3a1c"/>
            <ellipse cx="0" cy="-180" rx="14" ry="6" fill="#4a2c12"/>
            <!-- Big palm fronds -->
            <g fill="url(#daPalmLeaf)">
              <path d="M 0 -180 Q -180 -220 -260 -140 Q -200 -180 -10 -200 Z"/>
              <path d="M 0 -180 Q 180 -220 260 -140 Q 200 -180 10 -200 Z"/>
              <path d="M 0 -180 Q -130 -300 -180 -380 Q -100 -340 -5 -200 Z"/>
              <path d="M 0 -180 Q 130 -300 180 -380 Q 100 -340 5 -200 Z"/>
              <path d="M 0 -180 Q -260 -190 -340 -150 Q -240 -160 -10 -185 Z" opacity="0.85"/>
              <path d="M 0 -180 Q 260 -190 340 -150 Q 240 -160 10 -185 Z" opacity="0.85"/>
              <path d="M -10 -190 Q -100 -260 -130 -310 Q -50 -290 -5 -200 Z" opacity="0.85"/>
              <path d="M 10 -190 Q 100 -260 130 -310 Q 50 -290 5 -200 Z" opacity="0.85"/>
            </g>
          </g>

          <!-- Tropical floral plant — foreground bottom-left -->
          <g transform="translate(360, 720)">
            <!-- Pot -->
            <path d="M -38 80 L -45 30 L 45 30 L 38 80 Z" fill="#7a4828" stroke="#3a2410" stroke-width="1.2"/>
            <ellipse cx="0" cy="30" rx="45" ry="7" fill="#3a2410"/>
            <!-- Bird-of-paradise-like leaves -->
            <g fill="url(#daPalmLeaf)">
              <ellipse cx="-30" cy="-10" rx="14" ry="30" transform="rotate(-12 -30 -10)"/>
              <ellipse cx="0" cy="-20" rx="14" ry="36"/>
              <ellipse cx="30" cy="-10" rx="14" ry="30" transform="rotate(12 30 -10)"/>
              <ellipse cx="-50" cy="0" rx="12" ry="24" transform="rotate(-25 -50 0)"/>
              <ellipse cx="50" cy="0" rx="12" ry="24" transform="rotate(25 50 0)"/>
            </g>
            <!-- Orange flower accent -->
            <ellipse cx="0" cy="-30" rx="6" ry="10" fill="#f08038"/>
            <ellipse cx="0" cy="-30" rx="3" ry="6" fill="#f4c150"/>
          </g>

          <!-- Light streaming in: warm gradient over the room interior -->
          <g style="mix-blend-mode: screen; opacity: 0.18">
            <polygon points="50,40 660,40 760,640 200,640" fill="#fff5d8"/>
          </g>

          <!-- Banquette (jewel-tone tropical print) — back-right corner of the room -->
          <rect x="900" y="490" width="380" height="150" fill="url(#daUphol)" stroke="#1a0c04" stroke-width="2"/>
          <rect x="900" y="488" width="380" height="6" fill="#2a1c12"/>
          <rect x="900" y="640" width="380" height="14" fill="#2a1c12"/>

          <!-- Mid-century lounge chair (foreground right) -->
          <g transform="translate(1180, 720)">
            <!-- Chair shadow -->
            <ellipse cx="0" cy="40" rx="58" ry="6" fill="rgba(0,0,0,0.42)"/>
            <!-- Chair legs -->
            <rect x="-44" y="0" width="3" height="30" fill="#1a0c04" transform="rotate(-8 -44 0)"/>
            <rect x="44" y="0" width="3" height="30" fill="#1a0c04" transform="rotate(8 44 0)"/>
            <!-- Seat -->
            <ellipse cx="0" cy="0" rx="56" ry="14" fill="#a55a3c" stroke="#3a1c08" stroke-width="1.2"/>
            <!-- Backrest -->
            <path d="M -38 -10 Q -42 -50 0 -60 Q 42 -50 38 -10 Z" fill="#a55a3c" stroke="#3a1c08" stroke-width="1.2"/>
          </g>

          <!-- Drum kit at the back, slightly off-center, in the warm interior light -->
          <!-- Kick -->
          <g class="da__drum da__drum--kick" data-voice="kick">
            <ellipse cx="940" cy="620" rx="48" ry="9" fill="rgba(0,0,0,0.35)"/>
            <ellipse cx="940" cy="590" rx="50" ry="40" fill="url(#daDrumShell)" stroke="#1a0c04" stroke-width="0.8"/>
            <ellipse cx="940" cy="590" rx="38" ry="30" fill="url(#daDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <circle cx="940" cy="590" r="6" fill="#3a1c08" opacity="0.85"/>
            <ellipse class="da__drum-ring" cx="940" cy="590" rx="56" ry="46" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Snare on stand -->
          <g class="da__drum da__drum--snare" data-voice="snare">
            <line x1="1020" y1="580" x2="1020" y2="630" stroke="#3a2a1c" stroke-width="2"/>
            <ellipse cx="1020" cy="630" rx="12" ry="3" fill="rgba(0,0,0,0.3)"/>
            <rect x="996" y="552" width="48" height="30" rx="3" fill="url(#daDrumShell)" stroke="#1a0c04" stroke-width="0.5"/>
            <ellipse cx="1020" cy="552" rx="24" ry="6" fill="url(#daDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <ellipse class="da__drum-ring" cx="1020" cy="552" rx="30" ry="10" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Ride cymbal -->
          <g class="da__drum da__drum--ride" data-voice="ride">
            <line x1="880" y1="560" x2="880" y2="615" stroke="#3a2a1c" stroke-width="2"/>
            <ellipse cx="880" cy="558" rx="36" ry="7" fill="url(#daCymbal)" stroke="#5a4218" stroke-width="0.5"/>
            <ellipse cx="880" cy="558" rx="3" ry="2" fill="#5a4218"/>
            <ellipse class="da__drum-ring" cx="880" cy="558" rx="44" ry="11" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Shaker (small, on banquette) -->
          <g class="da__drum da__drum--shaker" data-voice="shaker">
            <rect x="1150" y="486" width="32" height="14" rx="4" fill="#7a4828" stroke="#1a0c04" stroke-width="0.5"/>
            <ellipse class="da__drum-ring" cx="1166" cy="493" r="20" ry="10" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Bongos (small pair, on a chair at far left) -->
          <g class="da__drum da__drum--bongo" data-voice="bongo">
            <ellipse cx="180" cy="710" rx="26" ry="5" fill="rgba(0,0,0,0.4)"/>
            <rect x="158" y="650" width="44" height="56" rx="3" fill="url(#daDrumShell)" stroke="#1a0c04" stroke-width="0.5"/>
            <ellipse cx="180" cy="650" rx="22" ry="5" fill="url(#daDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <rect x="208" y="660" width="38" height="46" rx="3" fill="url(#daDrumShell)" stroke="#1a0c04" stroke-width="0.5"/>
            <ellipse cx="227" cy="660" rx="19" ry="4" fill="url(#daDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <ellipse class="da__drum-ring" cx="203" cy="655" rx="60" ry="14" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>

          <!-- Subtle floor highlight under windows -->
          <ellipse cx="350" cy="780" rx="320" ry="14" fill="rgba(255,245,216,0.10)"/>
        </svg>
      </div>

      <div class="da__overlay" id="da-overlay">
        <button class="da__play" id="da-play" type="button" aria-label="Begin">
          <span class="da__play-icon" id="da-play-icon">▶</span>
          <span class="da__play-label" id="da-play-label">Begin</span>
        </button>
        <p class="da__overlay-hint">ten minutes · bossa nova · no buttons after this</p>
      </div>

      <div class="da__status" id="da-status" hidden>
        <span class="da__status-time" id="da-status-time">00:00</span>
        <span class="da__status-sep">of</span>
        <span class="da__status-total">10:00</span>
        <span class="da__status-section" id="da-status-section">empty room</span>
        <button class="da__end" id="da-end" type="button">end early</button>
      </div>
    </section>

    <section class="da__about">
      <h2 class="da__about-h">A different room</h2>
      <p>The pavilions are private. The booth is intimate. This room is <em>public</em> — the kind of hotel atrium where you can walk in at eleven in the morning and the staff will let you sit by the windows with a coffee for an hour. The kit is at the back; nobody's actively playing it, but the room remembers how a rhythm goes.</p>
      <p>Audio is bossa-nova-shaped. Kick on beat 1. Cross-stick on the rim on beats 2 and 4 (the bossa clave-ish backbeat). A shaker rides the 8th notes. The ride cymbal comes in for the busier middle sections. A small bongo pair adds the syncopation that bossa needs to feel right. Walking-bass sub on quarter notes — but lighter than the booth's, hinting at an upright more than playing one.</p>
      <p>Arc: <em>empty room, first guests, conversation, midday warmth, noon, the quiet after lunch, second wave, the light shifts, late afternoon, closing the doors</em>. Sparsity peaks at 0.55 in "noon" — the busiest the room gets. By "closing" we're back to single shaker hits between long silences.</p>
      <p>Sister surfaces: <a href="/drum-pavilion">/drum-pavilion</a> (5 zen pavilions) · <a href="/drum-booth">/drum-booth</a> (jazz booth) · individual atriums vary by time of day. This page is the third visual register opened in the meditative-drum series.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --da-text: #2a3326;
      --da-text-dim: #5a6356;
      --da-text-dimmer: #8a9285;
      --da-warm: #d68f2c;
      --da-warm-deep: #a36b1c;
    }

    body:has(.da) {
      background: radial-gradient(circle at 50% 20%, #f4ead0 0%, #d8c898 70%);
      color: var(--da-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .da { max-width: 1400px; margin: 0 auto; padding: 48px 24px 80px; }

    .da__hero { text-align: left; max-width: 760px; margin: 0 auto 36px; }
    .da__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--da-warm-deep);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .da__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--da-text);
    }
    .da__sub {
      font-size: 17px; line-height: 1.55;
      color: var(--da-text-dim);
      margin: 0;
    }

    .da__stage { position: relative; margin-bottom: 36px; }
    .da__room {
      position: relative;
      aspect-ratio: 7 / 4;
      max-height: 80vh;
      background: #2a1a0a;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0,0,0,0.4), inset 0 0 0 3px rgba(0,0,0,0.4);
    }
    .da__scene { position: absolute; inset: 0; width: 100%; height: 100%; }

    @keyframes daPulse {
      0%   { opacity: 0.85; transform: scale(1); }
      100% { opacity: 0;    transform: scale(1.18); }
    }
    .da__drum-ring.da__drum-ring--pulse {
      animation: daPulse 1.4s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .da__drum--struck { animation: daStrike 0.36s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes daStrike {
      0% { transform: translateY(0); }
      30% { transform: translateY(2px) scale(0.985); }
      100% { transform: translateY(0); }
    }

    .da__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(20,10,0,0.32) 0%, rgba(20,10,0,0.6) 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .da__stage[data-state="playing"] .da__overlay,
    .da__stage[data-state="ended"] .da__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .da__stage[data-state="ended"] .da__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .da__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0; border: 0; background: transparent; cursor: pointer;
    }
    .da__play-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: #f4c150;
      color: #3a1c08;
      font-size: 32px;
      display: flex; align-items: center; justify-content: center;
      box-shadow:
        0 14px 36px rgba(244,193,80,0.45),
        inset 0 -4px 8px rgba(0,0,0,0.18),
        inset 0 4px 6px rgba(255,255,255,0.4);
      transition: transform 100ms ease;
    }
    .da__play:hover .da__play-icon { transform: scale(1.04); }
    .da__play:active .da__play-icon { transform: scale(0.96); }
    .da__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: #f4e0a8;
      letter-spacing: 0.04em;
    }
    .da__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: rgba(244,224,168,0.7);
      text-transform: lowercase;
      margin: 0;
    }

    .da__status {
      position: absolute;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(30,18,8,0.78);
      border: 1px solid rgba(244,193,80,0.3);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: #d8c89c;
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .da__stage[data-state="playing"] .da__status,
    .da__stage[data-state="ended"] .da__status { opacity: 1; }
    .da__stage[data-state="ended"] .da__status { opacity: 0.7; }
    .da__status-time { font-weight: 600; color: #f4e0a8; font-variant-numeric: tabular-nums; }
    .da__status-sep { color: rgba(216,200,156,0.6); }
    .da__status-total { color: #f4e0a8; }
    .da__status-section { margin-left: 12px; color: #f4c150; text-transform: uppercase; }
    .da__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(244,193,80,0.4);
      border-radius: 8px;
      color: #f4c150;
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .da__end:hover { background: rgba(244,193,80,0.15); }

    .da__about { max-width: 720px; margin: 0 auto; padding: 12px 0 0; }
    .da__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--da-text);
      margin: 0 0 14px;
    }
    .da__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--da-text-dim);
      margin: 0 0 14px;
    }
    .da__about em { color: var(--da-warm-deep); font-style: italic; }
    .da__about a {
      color: var(--da-warm-deep);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Voice = 'kick' | 'snare' | 'ride' | 'shaker' | 'bongo' | 'sub';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.55;
      masterGain.connect(ctx.destination);
    }
    function noise(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 3;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }

    function playKick(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(78, t);
      osc.frequency.exponentialRampToValueAtTime(48, t + 0.16);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.40 * vel, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.44);
      flashDrum('kick');
    }

    // Bossa cross-stick: short woody triangle blip — not a snare sweep
    function playSnare(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(620, t);
      osc.frequency.exponentialRampToValueAtTime(440, t + 0.05);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.20 * vel, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.08);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.1);
      flashDrum('snare');
    }

    function playRide(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // Lighter ride than the booth — softer bell
      const partials = [
        { freq: 1500, gain: 0.10, decay: 1.0, type: 'triangle' as OscillatorType },
        { freq: 2200, gain: 0.05, decay: 0.7, type: 'triangle' as OscillatorType },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = p.type;
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.003);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 6000;
      bp.Q.value = 0.5;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.05 * vel, t + 0.02);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.8);
      src.connect(bp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.85);
      flashDrum('ride');
    }

    // Shaker: short HP noise pulse, like a single shake of a cabasa
    function playShaker(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 5200;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.08 * vel, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      src.connect(hp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.07);
      flashDrum('shaker');
    }

    // Bongo pair: high (290Hz) and low (180Hz) sine drops with noise transient
    function playBongo(t: number, vel = 1, high = true) {
      if (!ctx || !scheduler || !masterGain) return;
      const fund = high ? 290 : 180;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(fund, t);
      osc.frequency.exponentialRampToValueAtTime(fund * 0.6, t + 0.18);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.26 * vel, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.32);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.36);
      // Snap transient
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = high ? 1800 : 900;
      bp.Q.value = 1.4;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.003);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      src.connect(bp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.08);
      flashDrum('bongo');
    }

    function playSub(t: number, vel = 1, freq = 110) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, t);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.92, t + 0.4);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.12 * vel, t + 0.04);
      g.gain.setValueAtTime(g.gain.value, t + 0.34);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.75);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.8);
    }

    function flashDrum(voice: Voice) {
      const group = document.querySelector(`.da__drum--${voice}`);
      if (!group) return;
      group.classList.remove('da__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('da__drum--struck');
      setTimeout(() => group.classList.remove('da__drum--struck'), 380);
      const ring = group.querySelector('.da__drum-ring');
      if (ring) {
        ring.classList.remove('da__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('da__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('da__drum-ring--pulse'), 1500);
      }
    }

    // ---- arc ----
    type Section = {
      name: string;
      sparsity: number;
      weights: Partial<Record<Voice, number>>;
      walkingBass?: boolean;
      bassNotes?: number[];
      shakerOn?: boolean;  // shaker on every 8th note
      bongoOn?: boolean;   // bongo syncopation
    };
    const SECTIONS: Section[] = [
      { name: 'empty room',       sparsity: 0.05, weights: { ride: 4, shaker: 1 } },
      { name: 'first guests',     sparsity: 0.15, weights: { ride: 4, snare: 1, kick: 1 }, shakerOn: true, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'conversation',     sparsity: 0.28, weights: { ride: 4, snare: 2, kick: 1.5 }, shakerOn: true, walkingBass: true, bassNotes: [110, 110, 146.83, 130.81] },
      { name: 'midday warmth',    sparsity: 0.40, weights: { ride: 4, snare: 2.5, kick: 1.5, bongo: 0.5 }, shakerOn: true, bongoOn: true, walkingBass: true, bassNotes: [110, 130.81, 146.83, 130.81] },
      { name: 'noon',             sparsity: 0.55, weights: { ride: 5, snare: 3, kick: 2, bongo: 1 }, shakerOn: true, bongoOn: true, walkingBass: true, bassNotes: [110, 110, 164.81, 146.83] },
      { name: 'quiet after lunch',sparsity: 0.20, weights: { ride: 4, snare: 1.5, kick: 1 }, shakerOn: true, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'second wave',      sparsity: 0.42, weights: { ride: 4, snare: 2.5, kick: 1.5, bongo: 0.5 }, shakerOn: true, walkingBass: true, bongoOn: true, bassNotes: [110, 130.81, 146.83, 130.81] },
      { name: 'the light shifts', sparsity: 0.26, weights: { ride: 4, snare: 1.5, kick: 1 }, shakerOn: true, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'late afternoon',   sparsity: 0.12, weights: { ride: 4, snare: 1, shaker: 2 } },
      { name: 'closing the doors',sparsity: 0.04, weights: { ride: 3, shaker: 1 } },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 76;
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 4;
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let schedulingComplete = false;
    let lastShakerSlot = -1;
    let lastBongoBar = -1;
    let lastWalkSlot = -1;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) { r -= w; if (r <= 0) return v; }
      return entries[0][0];
    }

    function fireVoice(voice: Voice, t: number, vel: number) {
      switch (voice) {
        case 'kick':   playKick(t, vel); break;
        case 'snare':  playSnare(t, vel); break;
        case 'ride':   playRide(t, vel); break;
        case 'shaker': playShaker(t, vel); break;
        case 'bongo':  playBongo(t, vel, Math.random() < 0.6); break;
        case 'sub':    playSub(t, vel); break;
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.6;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        if (elapsed >= TOTAL_SEC) { schedulingComplete = true; break; }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(Math.max(0, elapsed) / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        const slotInBar = slotIdx % 16;
        const beatInBar = Math.floor(slotInBar / SUBDIVISION);
        const isQuarter = (slotInBar % SUBDIVISION) === 0;
        const is8th = (slotInBar % (SUBDIVISION / 2)) === 0;
        const isDownbeat = slotInBar === 0;
        const isBeat2 = slotInBar === 4;
        const isBeat3 = slotInBar === 8;
        const isBeat4 = slotInBar === 12;

        // Continuous shaker on every 8th when shakerOn
        if (section.shakerOn && is8th && lastShakerSlot !== slotIdx) {
          playShaker(nextSlotTime, 0.6);
          lastShakerSlot = slotIdx;
        }

        // Walking bass on quarters when walkingBass
        if (section.walkingBass && section.bassNotes && isQuarter && lastWalkSlot !== slotIdx) {
          const bassFreq = section.bassNotes[beatInBar % section.bassNotes.length];
          playSub(nextSlotTime, 0.7, bassFreq);
          lastWalkSlot = slotIdx;
        }

        // Bossa kick on beat 1 + small kick on "and of 2" (the bossa pattern hint)
        if (section.weights.kick && isDownbeat && Math.random() < 0.85) {
          playKick(nextSlotTime, 0.95);
        }
        // Cross-stick on beats 2 and 4 (bossa backbeat)
        if (section.weights.snare && (isBeat2 || isBeat4) && Math.random() < 0.7) {
          playSnare(nextSlotTime, isBeat4 ? 0.8 : 0.7);
        }

        // Bongo syncopation: on the 'and of 3' (8th note offbeat)
        const currentBar = Math.floor(slotIdx / 16);
        if (section.bongoOn && slotInBar === 10 && lastBongoBar !== currentBar && Math.random() < 0.55) {
          playBongo(nextSlotTime, 0.65, Math.random() < 0.55);
          lastBongoBar = currentBar;
        }

        // Fill with weighted random voices at lower probability
        let p = section.sparsity * 0.5;
        if (Math.random() < p) {
          let voice = pickWeighted(section.weights);
          // Ride on 8ths
          if (is8th && Math.random() < 0.5 && section.weights.ride) voice = 'ride';
          if (voice) {
            const vel = 0.5 + Math.random() * 0.3;
            fireVoice(voice, nextSlotTime, vel);
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 70);
    }

    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('da-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('da-status-section')!.textContent = SECTIONS[si].name;
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      lastShakerSlot = lastBongoBar = lastWalkSlot = -1;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('da-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('da-status')!.removeAttribute('hidden');
      scheduleAhead();
      tickUi();
    }
    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('da-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('da-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('da-play')!.addEventListener('click', () => startPlaying());
      document.getElementById('da-end')!.addEventListener('click', () => stopPlaying(false));
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
