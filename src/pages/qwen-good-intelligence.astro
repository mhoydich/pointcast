---
const canonical = 'https://pointcast.xyz/qwen-good-intelligence';
const title = '善智调度局 — Qwen Model Study 003';
const description =
  'A device-local care-routing instrument rooted in Kaiping and Jiangmen, Guangdong. Pair one community need with one available capacity—without scoring people.';
const ogImage = 'https://pointcast.xyz/images/qwen-good-intelligence/og.png';

const needs = [
  { id: 'meals', zh: '热饭', en: 'Warm meals', mark: '饭' },
  { id: 'elders', zh: '探访长者', en: 'Elder check-ins', mark: '访' },
  { id: 'learning', zh: '学习物资', en: 'Learning kits', mark: '学' },
  { id: 'repairs', zh: '小修小补', en: 'Small repairs', mark: '修' },
];

const capacities = [
  { id: 'time', zh: '时间', en: 'Time', mark: '时' },
  { id: 'transport', zh: '车程', en: 'Transport', mark: '车' },
  { id: 'translation', zh: '翻译', en: 'Translation', mark: '译' },
  { id: 'materials', zh: '物资', en: 'Materials', mark: '物' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  alternateName: 'The Good Intelligence Dispatch',
  description,
  url: canonical,
  image: ogImage,
  datePublished: '2026-07-25T20:50:12.000Z',
  creator: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  about: [
    'Kaiping and Jiangmen, Guangdong',
    'community care routing',
    'Qwen language and audio model relay design',
  ],
  mainEntityOfPage: 'https://pointcast.xyz/qwen-good-intelligence.json',
  isPartOf: {
    '@type': 'CreativeWorkSeries',
    name: 'PointCast Qwen Model Studies',
    url: 'https://pointcast.xyz/qwen-weather',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/json"
      href="/qwen-good-intelligence.json"
      title="Good Intelligence Dispatch machine record"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f0ead9" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: light;
        --ink: #111d1b;
        --ink-soft: #334b44;
        --paper: #f0ead9;
        --paper-deep: #ded4bd;
        --jade: #116754;
        --jade-dark: #093d35;
        --cinnabar: #c33f2d;
        --gold: #bf9b4b;
        --line: rgba(17, 29, 27, 0.2);
        --serif: "Songti SC", STSong, "Noto Serif CJK SC", Iowan Old Style,
          Baskerville, "Times New Roman", serif;
        --sans: "Helvetica Neue", "PingFang SC", "Noto Sans CJK SC", Arial,
          sans-serif;
        --mono: "SFMono-Regular", "IBM Plex Mono", Menlo, Consolas, monospace;
        --gutter: clamp(18px, 5vw, 78px);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--paper);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background:
          linear-gradient(rgba(17, 29, 27, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(17, 29, 27, 0.035) 1px, transparent 1px),
          var(--paper);
        background-size: 28px 28px;
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      button {
        color: inherit;
        font: inherit;
        -webkit-tap-highlight-color: transparent;
      }

      ::selection {
        background: var(--cinnabar);
        color: var(--paper);
      }

      :focus-visible {
        outline: 3px solid var(--cinnabar);
        outline-offset: 4px;
      }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 100;
        padding: 10px 14px;
        background: var(--ink);
        color: var(--paper);
        transform: translateY(-160%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .masthead {
        position: absolute;
        inset: 0 0 auto;
        z-index: 10;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 18px var(--gutter);
        border-bottom: 1px solid rgba(240, 234, 217, 0.25);
        color: var(--paper);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .masthead a {
        text-decoration: none;
      }

      .masthead__brand {
        font-family: var(--serif);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: none;
      }

      .masthead__model {
        color: #f8d682;
      }

      .masthead__place {
        justify-self: end;
        opacity: 0.68;
      }

      .hero {
        position: relative;
        display: grid;
        min-height: 100svh;
        grid-template-columns: minmax(0, 1fr) minmax(300px, 0.78fr);
        align-items: end;
        overflow: hidden;
        padding: clamp(126px, 19vh, 190px) var(--gutter) clamp(40px, 7vw, 92px);
        background: var(--jade-dark);
        color: var(--paper);
      }

      .hero__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        opacity: 0.68;
        filter: saturate(0.9) contrast(1.05);
      }

      .hero::after {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          linear-gradient(90deg, rgba(5, 39, 34, 0.95), rgba(5, 39, 34, 0.48) 56%, rgba(5, 39, 34, 0.2)),
          linear-gradient(180deg, rgba(5, 39, 34, 0.15), rgba(5, 39, 34, 0.82));
        content: "";
      }

      .hero__copy,
      .hero__thesis {
        position: relative;
        z-index: 2;
      }

      .kicker,
      .section-label {
        margin: 0 0 18px;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .kicker {
        color: #f8d682;
      }

      h1,
      h2,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 780px;
        margin-bottom: 24px;
        font-family: var(--serif);
        font-size: clamp(66px, 10.5vw, 164px);
        font-weight: 500;
        letter-spacing: -0.07em;
        line-height: 0.82;
      }

      h1 small {
        display: block;
        margin-top: 24px;
        font-family: var(--sans);
        font-size: clamp(14px, 1.3vw, 20px);
        font-weight: 500;
        letter-spacing: 0.16em;
        line-height: 1.3;
        text-transform: uppercase;
      }

      .hero__intro {
        max-width: 650px;
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(20px, 2vw, 30px);
        line-height: 1.35;
      }

      .hero__thesis {
        align-self: end;
        justify-self: end;
        max-width: 340px;
        padding: 22px;
        border: 1px solid rgba(240, 234, 217, 0.42);
        background: rgba(4, 33, 29, 0.62);
        backdrop-filter: blur(12px);
      }

      .hero__thesis span {
        display: block;
        margin-bottom: 42px;
        color: #f8d682;
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero__thesis p {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(24px, 2.5vw, 38px);
        line-height: 1.12;
      }

      .boundary {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 8vw;
        padding: clamp(72px, 11vw, 154px) var(--gutter);
        border-bottom: 1px solid var(--line);
      }

      .section-label {
        color: var(--cinnabar);
      }

      .boundary h2,
      .workbench h2,
      .qwen h2 {
        margin-bottom: 18px;
        font-family: var(--serif);
        font-size: clamp(42px, 6vw, 88px);
        font-weight: 500;
        letter-spacing: -0.055em;
        line-height: 0.95;
      }

      .boundary__rules {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
      }

      .boundary__rule {
        min-height: 190px;
        padding: 22px;
        background: var(--paper);
      }

      .boundary__rule span {
        color: var(--cinnabar);
        font-family: var(--mono);
        font-size: 10px;
      }

      .boundary__rule b {
        display: block;
        margin: 34px 0 10px;
        font-family: var(--serif);
        font-size: 25px;
        font-weight: 600;
      }

      .boundary__rule p {
        margin: 0;
        color: var(--ink-soft);
        line-height: 1.5;
      }

      .workbench {
        padding: clamp(72px, 10vw, 142px) var(--gutter);
        background: #e7dfca;
      }

      .workbench__heading {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(250px, 0.65fr);
        gap: 8vw;
        align-items: end;
        margin-bottom: 52px;
      }

      .workbench__heading p:last-child {
        margin-bottom: 10px;
        color: var(--ink-soft);
        line-height: 1.6;
      }

      .selector-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
      }

      .selector {
        padding: 22px;
        border: 1px solid var(--ink);
        background: rgba(240, 234, 217, 0.65);
      }

      .selector h3 {
        margin: 0 0 18px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .selector__buttons {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .choice {
        min-height: 94px;
        padding: 15px;
        border: 1px solid var(--line);
        background: transparent;
        text-align: left;
        cursor: pointer;
        transition: background 180ms ease, color 180ms ease, transform 180ms ease;
      }

      .choice:hover {
        transform: translateY(-2px);
      }

      .choice[aria-pressed="true"] {
        background: var(--jade);
        color: #fff9e9;
      }

      .choice b,
      .choice span {
        display: block;
      }

      .choice b {
        margin-bottom: 8px;
        font-family: var(--serif);
        font-size: 24px;
      }

      .choice span {
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .dispatch {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        margin-top: 24px;
        border: 1px solid var(--ink);
        background: var(--paper);
      }

      .dispatch__seal {
        display: grid;
        place-items: center;
        min-height: 260px;
        border-right: 1px solid var(--ink);
        background: var(--cinnabar);
        color: var(--paper);
        font-family: var(--serif);
        font-size: 82px;
      }

      .dispatch__copy {
        display: grid;
        align-content: center;
        padding: clamp(26px, 5vw, 72px);
      }

      .dispatch__meta {
        margin-bottom: 28px;
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .dispatch__copy h3 {
        margin: 0 0 10px;
        font-family: var(--serif);
        font-size: clamp(30px, 4vw, 56px);
        font-weight: 500;
        line-height: 1.1;
      }

      .dispatch__copy p {
        max-width: 760px;
        margin: 0;
        color: var(--ink-soft);
        font-size: clamp(16px, 1.5vw, 21px);
        line-height: 1.55;
      }

      .matrix {
        padding: clamp(72px, 10vw, 142px) var(--gutter);
        background: var(--jade-dark);
        color: var(--paper);
      }

      .matrix__heading {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        align-items: end;
        margin-bottom: 38px;
      }

      .matrix__heading h2 {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(38px, 5vw, 70px);
        font-weight: 500;
        letter-spacing: -0.05em;
      }

      .matrix__heading p {
        max-width: 420px;
        margin: 0;
        color: rgba(240, 234, 217, 0.68);
        line-height: 1.55;
      }

      .matrix__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid rgba(240, 234, 217, 0.3);
        border-left: 1px solid rgba(240, 234, 217, 0.3);
      }

      .matrix__cell {
        display: grid;
        min-height: 140px;
        align-content: space-between;
        padding: 16px;
        border-right: 1px solid rgba(240, 234, 217, 0.3);
        border-bottom: 1px solid rgba(240, 234, 217, 0.3);
        transition: background 180ms ease;
      }

      .matrix__cell span {
        color: #f8d682;
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .matrix__cell b {
        font-family: var(--serif);
        font-size: 24px;
        font-weight: 500;
      }

      .matrix__cell[data-active="true"] {
        background: var(--cinnabar);
      }

      .qwen {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 700px;
        background: var(--ink);
        color: var(--paper);
      }

      .qwen__lead {
        display: grid;
        align-content: space-between;
        min-height: 700px;
        padding: clamp(48px, 7vw, 104px) var(--gutter);
        background:
          radial-gradient(circle at 80% 18%, rgba(191, 155, 75, 0.22), transparent 30%),
          var(--ink);
      }

      .qwen__name {
        color: #f8d682;
        font-family: var(--mono);
        font-size: clamp(38px, 6vw, 88px);
        font-weight: 800;
        letter-spacing: -0.08em;
      }

      .qwen__lead p {
        max-width: 640px;
        font-family: var(--serif);
        font-size: clamp(22px, 2.4vw, 34px);
        line-height: 1.3;
      }

      .qwen__roles {
        display: grid;
        grid-template-rows: repeat(3, 1fr);
        border-left: 1px solid rgba(240, 234, 217, 0.24);
      }

      .qwen__role {
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 22px;
        align-items: center;
        padding: clamp(28px, 5vw, 68px);
        border-bottom: 1px solid rgba(240, 234, 217, 0.24);
      }

      .qwen__role span {
        color: #f8d682;
        font-family: var(--mono);
        font-size: 10px;
      }

      .qwen__role h3 {
        margin: 0 0 8px;
        font-family: var(--serif);
        font-size: clamp(25px, 3vw, 40px);
        font-weight: 500;
      }

      .qwen__role p {
        margin: 0;
        color: rgba(240, 234, 217, 0.64);
        line-height: 1.55;
      }

      .local-only {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8vw;
        padding: clamp(72px, 10vw, 142px) var(--gutter);
        border-bottom: 1px solid var(--line);
      }

      .local-only h2 {
        margin: 0;
        font-family: var(--mono);
        font-size: clamp(30px, 5vw, 72px);
        letter-spacing: -0.06em;
        line-height: 0.95;
      }

      .local-only__copy p {
        color: var(--ink-soft);
        font-size: 18px;
        line-height: 1.65;
      }

      .local-only__links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 28px;
      }

      .local-only__links a {
        padding: 11px 14px;
        border: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      footer {
        display: grid;
        grid-template-columns: 1fr 2fr auto;
        gap: 40px;
        padding: 28px var(--gutter);
        background: var(--paper);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.07em;
        line-height: 1.5;
        text-transform: uppercase;
      }

      footer div span {
        display: block;
      }

      footer p {
        max-width: 640px;
        margin: 0;
        color: var(--ink-soft);
      }

      footer > a {
        font-size: 18px;
        text-decoration: none;
      }

      @media (max-width: 840px) {
        .masthead {
          grid-template-columns: 1fr auto;
        }

        .masthead__model {
          display: none;
        }

        .hero,
        .boundary,
        .workbench__heading,
        .qwen,
        .local-only {
          grid-template-columns: 1fr;
        }

        .hero {
          align-content: end;
        }

        .hero__thesis {
          justify-self: stretch;
          margin-top: 40px;
        }

        .boundary__rules {
          margin-top: 14px;
        }

        .qwen__roles {
          border-top: 1px solid rgba(240, 234, 217, 0.24);
          border-left: 0;
        }

        .qwen__lead {
          min-height: 540px;
        }
      }

      @media (max-width: 620px) {
        .selector-grid,
        .boundary__rules {
          grid-template-columns: 1fr;
        }

        .selector__buttons {
          grid-template-columns: 1fr 1fr;
        }

        .dispatch {
          grid-template-columns: 1fr;
        }

        .dispatch__seal {
          min-height: 120px;
          border-right: 0;
          border-bottom: 1px solid var(--ink);
          font-size: 58px;
        }

        .matrix__heading {
          display: block;
        }

        .matrix__heading p {
          margin-top: 18px;
        }

        .matrix__grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .matrix__cell {
          min-height: 120px;
        }

        .qwen__role {
          grid-template-columns: 50px 1fr;
          padding-inline: 22px;
        }

        footer {
          grid-template-columns: 1fr auto;
        }

        footer p {
          grid-column: 1 / -1;
          grid-row: 2;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the instrument</a>

    <header class="masthead">
      <a class="masthead__brand" href="/">PointCast</a>
      <span class="masthead__model">Qwen Model Study 003</span>
      <span class="masthead__place">开平 · 江门 · 广东</span>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero__image"
          src="/images/qwen-good-intelligence/og.png"
          alt=""
          width="1200"
          height="630"
        />
        <div class="hero__copy">
          <p class="kicker">Qwen Model Study 003 · intelligence for good</p>
          <h1 id="hero-title" lang="zh-CN">
            善智
            <small>The Good Intelligence Dispatch</small>
          </h1>
          <p class="hero__intro">
            A small civic instrument for pairing what a neighborhood needs with
            what it already knows how to give.
          </p>
        </div>
        <aside class="hero__thesis">
          <span>Governing principle / 原则</span>
          <p>Intelligence for good does not score people. It routes care.</p>
        </aside>
      </section>

      <section class="boundary" aria-labelledby="boundary-title">
        <div>
          <p class="section-label">01 / The boundary</p>
          <h2 id="boundary-title">The person is never the input.</h2>
        </div>
        <div class="boundary__rules">
          <article class="boundary__rule">
            <span>NO. 01</span>
            <b>No resident scores</b>
            <p>There is no profile, risk rank, reputation number, or hidden priority.</p>
          </article>
          <article class="boundary__rule">
            <span>NO. 02</span>
            <b>No eligibility decisions</b>
            <p>The instrument cannot decide who deserves a meal, visit, kit, or repair.</p>
          </article>
          <article class="boundary__rule">
            <span>NO. 03</span>
            <b>No automatic allocation</b>
            <p>It cannot move money, assign services, dispatch a person, or promise delivery.</p>
          </article>
          <article class="boundary__rule">
            <span>NO. 04</span>
            <b>Community veto</b>
            <p>Every suggested brief is provisional. Local people can revise it or refuse it.</p>
          </article>
        </div>
      </section>

      <section class="workbench" aria-labelledby="workbench-title">
        <div class="workbench__heading">
          <div>
            <p class="section-label">02 / Pair care with capacity</p>
            <h2 id="workbench-title">Choose one of each.</h2>
          </div>
          <p>
            This is a coordination sketch, not a request form. No name, address,
            story, or location is collected.
          </p>
        </div>

        <div class="selector-grid">
          <div class="selector">
            <h3>A · Community need / 社区需要</h3>
            <div class="selector__buttons">
              {
                needs.map((need, index) => (
                  <button
                    class="choice"
                    type="button"
                    data-need={need.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <b lang="zh-CN">{need.zh}</b>
                    <span>{need.en}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="selector">
            <h3>B · Available capacity / 可用能力</h3>
            <div class="selector__buttons">
              {
                capacities.map((capacity, index) => (
                  <button
                    class="choice"
                    type="button"
                    data-capacity={capacity.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <b lang="zh-CN">{capacity.zh}</b>
                    <span>{capacity.en}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <article class="dispatch" aria-live="polite">
          <div class="dispatch__seal" data-dispatch-seal>善</div>
          <div class="dispatch__copy">
            <div class="dispatch__meta">Local action brief · suggestion only</div>
            <h3 data-dispatch-zh lang="zh-CN">用一小时，约好一张共享饭桌。</h3>
            <p data-dispatch-en>
              Offer one hour to coordinate a shared meal table. Confirm dietary
              needs and timing with the people involved before acting.
            </p>
          </div>
        </article>
      </section>

      <section class="matrix" aria-labelledby="matrix-title">
        <div class="matrix__heading">
          <h2 id="matrix-title">16 routes. No rankings.</h2>
          <p>
            Each cell is a possible relationship between a need and a capacity.
            The active pair is marked in red.
          </p>
        </div>
        <div class="matrix__grid">
          {
            needs.flatMap((need) =>
              capacities.map((capacity) => (
                <div
                  class="matrix__cell"
                  data-cell={`${need.id}:${capacity.id}`}
                  data-active={need.id === 'meals' && capacity.id === 'time' ? 'true' : 'false'}
                >
                  <span>{need.en} × {capacity.en}</span>
                  <b lang="zh-CN">{need.mark} · {capacity.mark}</b>
                </div>
              )),
            )
          }
        </div>
      </section>

      <section class="qwen" aria-labelledby="qwen-title">
        <div class="qwen__lead">
          <div>
            <p class="section-label">03 / The Qwen role</p>
            <div class="qwen__name">QWEN / 通义</div>
          </div>
          <div>
            <h2 id="qwen-title">Language serves the relationship.</h2>
            <p>
              Qwen may help translate and clarify a pairing authored by a
              community. It may not decide who deserves help.
            </p>
          </div>
        </div>
        <div class="qwen__roles">
          <article class="qwen__role">
            <span>01 / 写</span>
            <div>
              <h3>Draft the brief</h3>
              <p>Turn one chosen need and one chosen capacity into plain bilingual action language.</p>
            </div>
          </article>
          <article class="qwen__role">
            <span>02 / 读</span>
            <div>
              <h3>Voice after review</h3>
              <p>Read a community-approved version with locally directed language and pronunciation.</p>
            </div>
          </article>
          <article class="qwen__role">
            <span>03 / 停</span>
            <div>
              <h3>Stop at the boundary</h3>
              <p>No ranking, eligibility, enforcement, identity inference, or automated public-service decision.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="local-only" aria-labelledby="local-title">
        <h2 id="local-title">NOTHING LEAVES THIS DEVICE</h2>
        <div class="local-only__copy">
          <p>
            The PointCast edition runs entirely in this page. It stores no
            identity, location, or free text. It makes no automated decision.
            Qwen language and audio are staged until current-plan entitlement is
            verified; the public instrument does not make a live model call.
          </p>
          <p>
            The regional frame is Kaiping and Jiangmen, Guangdong: a contemporary
            civic artwork about mutual aid and practical coordination, not a
            claim to represent every local experience.
          </p>
          <div class="local-only__links">
            <a href="/qwen-good-intelligence.json">Machine record</a>
            <a href="/qwen-silver-letter">Study 002 · 银信气象台</a>
            <a href="/qwen-weather">Study 001 · Weather Memory</a>
            <a
              href="https://qwen-weather-memory.mhoydich.chatgpt.site/good-intelligence"
              rel="noreferrer"
            >
              Owner-only shared study
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div>
        <span>PointCast · Model Study 003</span>
        <span>善智调度局 / Good Intelligence</span>
      </div>
      <p>
        A public, device-local PointCast instrument. Suggestion only. Care remains
        accountable to the people giving and receiving it.
      </p>
      <a href="#" aria-label="Return to top">↑</a>
    </footer>

    <script is:inline>
      (() => {
        const briefs = {
          'meals:time': ['善', '用一小时，约好一张共享饭桌。', 'Offer one hour to coordinate a shared meal table. Confirm dietary needs and timing with the people involved before acting.'],
          'meals:transport': ['送', '把热饭送到约好的会合点。', 'Offer a short transport loop for warm meals. Confirm the route and handoff with local organizers first.'],
          'meals:translation': ['译', '把菜单与饮食需要说明白。', 'Translate menus and dietary needs so the shared meal works for everyone at the table.'],
          'meals:materials': ['饭', '先列一张小而明确的食材单。', 'Offer a short, confirmed ingredient list rather than an open-ended donation request.'],
          'elders:time': ['访', '约一次短探访，先问对方是否方便。', 'Offer one short check-in. Ask the elder when and how they would like to be contacted.'],
          'elders:transport': ['车', '提供一段有明确起点和终点的车程。', 'Offer one clearly bounded ride, with the destination and return plan confirmed by the rider.'],
          'elders:translation': ['听', '协助把问题听清，也把回答说明白。', 'Help translate a conversation while keeping the elder—not the translator—in control of the exchange.'],
          'elders:materials': ['物', '先问需要，再带一件合适的物品。', 'Ask first, then bring one agreed item. Avoid guessing what another household needs.'],
          'learning:time': ['学', '留出一小时，一起整理学习包。', 'Offer one hour to assemble learning kits with a teacher, family, or neighborhood organizer.'],
          'learning:transport': ['送', '把已确认的学习包送到公共会合点。', 'Deliver confirmed learning kits to a public handoff point chosen by the community.'],
          'learning:translation': ['译', '把一页学习说明翻成家里常用的语言。', 'Translate one page of learning instructions into the language used at home, then invite review.'],
          'learning:materials': ['书', '补齐一份明确清单里的学习用品。', 'Fill one bounded list of supplies. Do not infer a student’s need from personal data.'],
          'repairs:time': ['修', '约一次短检查，先确认住户同意。', 'Offer a brief inspection only after the resident agrees to the time and scope.'],
          'repairs:transport': ['车', '帮忙运送一件已确认的工具或材料。', 'Transport one confirmed tool or material, with no address retained by this instrument.'],
          'repairs:translation': ['译', '把维修范围、费用和风险说清楚。', 'Translate the repair scope, costs, and risks so the resident can make the decision.'],
          'repairs:materials': ['补', '提供一份小修所需的明确材料包。', 'Offer a small, agreed repair kit. The resident or local coordinator chooses what is appropriate.'],
        };
        let activeNeed = 'meals';
        let activeCapacity = 'time';
        const zh = document.querySelector('[data-dispatch-zh]');
        const en = document.querySelector('[data-dispatch-en]');
        const seal = document.querySelector('[data-dispatch-seal]');

        const render = () => {
          const key = `${activeNeed}:${activeCapacity}`;
          const brief = briefs[key];
          if (!brief) return;
          if (seal) seal.textContent = brief[0];
          if (zh) zh.textContent = brief[1];
          if (en) en.textContent = brief[2];
          document.querySelectorAll('[data-cell]').forEach((cell) => {
            cell.setAttribute('data-active', cell.getAttribute('data-cell') === key ? 'true' : 'false');
          });
        };

        document.querySelectorAll('[data-need]').forEach((button) => {
          button.addEventListener('click', () => {
            activeNeed = button.getAttribute('data-need') || activeNeed;
            document.querySelectorAll('[data-need]').forEach((item) => {
              item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
            });
            render();
          });
        });

        document.querySelectorAll('[data-capacity]').forEach((button) => {
          button.addEventListener('click', () => {
            activeCapacity = button.getAttribute('data-capacity') || activeCapacity;
            document.querySelectorAll('[data-capacity]').forEach((item) => {
              item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
            });
            render();
          });
        });
      })();
    </script>
  </body>
</html>
