---
/** /drum-runner — Beat Runner v7: Loop Siege. */
import BlockLayout from '../layouts/BlockLayout.astro';
import marineBackdrop from '../assets/drum-runner-v3/marine-layer.webp';
import { SIEGE_LANE_META, SIEGE_LANE_ORDER, SIEGE_WAVES } from '../lib/drum-runner-v7';

const title = 'Beat Runner v7 · Loop Siege';
const description = 'A fast four-gate rhythm defense game where every drum hit attacks now and returns one loop later as a ghost attack.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Beat Runner v7: Loop Siege',
  url: 'https://pointcast.xyz/drum-runner',
  description,
  gamePlatform: 'Web browser',
  playMode: 'SinglePlayer',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="siege" id="siege" data-phase="intro" data-wave="0" data-ghost="false" data-drop="false">
    <header class="siege__hud" aria-label="Loop Siege status">
      <div><span>score</span><strong id="siege-score">0</strong></div>
      <div class="siege__wave-block"><span id="siege-wave-no">WAVE 01 / 04</span><strong id="siege-wave-name">First Ring</strong><span id="siege-tempo">132 BPM</span></div>
      <div><span>chain</span><strong id="siege-combo">—</strong><span id="siege-kills">0 clears</span></div>
      <div class="siege__shields" id="siege-shields" aria-label="4 of 4 core shields remaining"><span></span><span></span><span></span><span></span></div>
      <div class="siege__power" id="siege-power" aria-label="Next earned power at six clears"><span>POWER</span><strong id="siege-power-copy">0 / 6</strong><i><b id="siege-power-fill"></b></i></div>
    </header>

    <section class="siege__stage" id="siege-stage" aria-label="Loop Siege playfield">
      <canvas
        id="siege-canvas"
        role="img"
        aria-label="Four colored gates surround a center Noun. Strike any drum on the eighth-note grid to attack that gate and write a sixteen-step loop. The previous loop returns as ghost attacks."
      >Loop Siege rhythm defense canvas.</canvas>

      <button class="siege__core" id="siege-drop" type="button" aria-label="Center Noun. DROP is not charged." disabled>
        <span aria-hidden="true"></span>
        <img id="siege-noun" src="https://noun.pics/137.svg" alt="" width="88" height="88" />
        <small id="siege-drop-copy">CORE</small>
      </button>

      <span class="siege__gate siege__gate--west" aria-hidden="true">← KICK</span>
      <span class="siege__gate siege__gate--north" aria-hidden="true">↑ CLAP</span>
      <span class="siege__gate siege__gate--south" aria-hidden="true">↓ TOM</span>
      <span class="siege__gate siege__gate--east" aria-hidden="true">BELL →</span>
      <div class="siege__judge" id="siege-judge" role="status" aria-live="polite" aria-atomic="true"></div>
      <div class="siege__flash" id="siege-flash" aria-hidden="true" hidden></div>

      <div class="siege__loop" id="siege-loop" role="img" aria-label="Sixteen-step loop. Empty and ready to record.">
        <div class="siege__loop-head"><span id="siege-loop-mode">WRITE LOOP 01</span><strong id="siege-loop-clock">01 / 16</strong></div>
        <div class="siege__loop-cells" aria-hidden="true">
          {Array.from({ length: 16 }, (_, step) => <span data-loop-step={step}><i></i><b></b></span>)}
        </div>
      </div>

      <div class="siege__overlay" id="siege-overlay">
        <article class="siege__card">
          <div class="siege__card-art" style={`background-image:linear-gradient(180deg,rgba(4,7,17,.02),rgba(4,7,17,.84)),url(${marineBackdrop.src})`} aria-hidden="true">
            <span>PLAY NOW</span><strong>FIGHT LATER</strong><small>YOUR LOOP HAS YOUR BACK</small>
          </div>
          <div class="siege__card-body">
            <div class="siege__eyebrow"><span id="siege-card-kicker">BEAT RUNNER V7 · LOOP SIEGE</span><span id="siege-card-tempo">132→180 BPM · ~55 SEC</span></div>
            <h1 id="siege-card-title">WRITE THE BEAT.<br />DEFEND THE NOUN.</h1>
            <p id="siege-card-sub">Choose the threatened gate. Every hit fires now and enters a 16-step loop. One loop later, your ghost drummer fires the same pattern again.</p>

            <div class="siege__noun-picker" id="siege-noun-picker" aria-label="Choose your center Noun">
              <button type="button" data-noun="137" aria-pressed="true"><img src="https://noun.pics/137.svg" alt="" width="42" height="42" /><span>Noun 137</span></button>
              <button type="button" data-noun="418" aria-pressed="false"><img src="https://noun.pics/418.svg" alt="" width="42" height="42" /><span>Noun 418</span></button>
              <button type="button" data-noun="855" aria-pressed="false"><img src="https://noun.pics/855.svg" alt="" width="42" height="42" /><span>Noun 855</span></button>
            </div>

            <div class="siege__card-stats" aria-label="Loop Siege details">
              <span><small id="siege-stat-a-label">choice</small><strong id="siege-stat-a">any gate</strong></span>
              <span><small id="siege-stat-b-label">memory</small><strong id="siege-stat-b">16 steps</strong></span>
              <span><small id="siege-stat-c-label">reward</small><strong id="siege-stat-c">ghost fire</strong></span>
            </div>

            <ol class="siege__route" id="siege-route" aria-label="Four Loop Siege waves">
              {SIEGE_WAVES.map((wave, index) => <li data-route-index={index}><span>{wave.number}</span><b>{wave.name}</b><small>{wave.bpm} · {wave.noteBudget} hits</small></li>)}
            </ol>
            <p class="siege__best" id="siege-best">best — pts</p>
            <button class="siege__go" id="siege-go" type="button">▶ START THE SIEGE</button>
            <p class="siege__input-note">D F J K · ARROWS · TAP · SPACE QUEUES DROP</p>
          </div>
        </article>
      </div>
    </section>

    <div class="siege__pads" role="group" aria-label="Loop Siege attack drums">
      {SIEGE_LANE_ORDER.map((lane) => (
        <button
          class={`siege__pad siege__pad--${lane}`}
          type="button"
          data-lane={lane}
          aria-label={`Attack ${lane} ${SIEGE_LANE_META[lane].label}. ${SIEGE_LANE_META[lane].key} key or ${SIEGE_LANE_META[lane].arrow} arrow.`}
          aria-keyshortcuts={`${SIEGE_LANE_META[lane].key} ${SIEGE_LANE_META[lane].arrowKey}`}
          style={`--lane:${SIEGE_LANE_META[lane].color}`}
          disabled
        ><span>{SIEGE_LANE_META[lane].arrow}</span><strong>{SIEGE_LANE_META[lane].label}</strong><small>{SIEGE_LANE_META[lane].key}</small></button>
      ))}
    </div>

    <div class="siege__utility">
      <button id="siege-sound" type="button" aria-pressed="true">SOUND ON</button>
      <div class="siege__sync" aria-label="Timing sync adjustment"><button id="siege-sync-minus" type="button" aria-label="Move the grid 15 milliseconds earlier">−</button><span id="siege-sync-copy">SYNC 0MS</span><button id="siege-sync-plus" type="button" aria-label="Move the grid 15 milliseconds later">＋</button></div>
      <span id="siege-latency">latency auto</span>
    </div>

    <section class="siege__manifesto" aria-labelledby="siege-manifesto-title">
      <div><p>LOOP SIEGE DESIGN NOTE</p><h2 id="siege-manifesto-title">The rhythm is a plan—not a prompt.</h2></div>
      <ol>
        <li><span>01</span><strong>Choose</strong><p>Attack the gate whose deadline matters. There is no prescribed chart.</p></li>
        <li><span>02</span><strong>Write</strong><p>Your accepted hits become a 16-step phrase with chords and rests.</p></li>
        <li><span>03</span><strong>Trust the ghost</strong><p>The prior phrase returns once, then gets replaced by the loop you are writing now.</p></li>
      </ol>
    </section>

    <p class="sr-only" id="siege-live" role="status" aria-live="polite" aria-atomic="true">Loop Siege ready. Four attack drums, sixteen loop steps, four waves from 132 to 180 BPM.</p>

    <nav class="siege__versions" aria-label="Beat Runner versions">
      <span>edition</span>
      <a href="/drum-runner-v1">v1 endless</a><a href="/drum-runner-v2">v2 postcards</a><a href="/drum-runner-v3">v3 pocket</a><a href="/drum-runner-v4">v4 road band</a><a href="/drum-runner-v5">v5 bright miles</a><a href="/drum-runner-v6">v6 pulse arena</a><a href="/drum-runner" aria-current="page">v7 loop siege</a>
    </nav>
    <nav class="siege__siblings" aria-label="More Drum Arcade games"><a href="/drum-games">all five</a><a href="/drum-says">drum says</a><a href="/drum-quickdraw">quick draw</a><a href="/drum-fill">fill</a><a href="/drum-steady">steady</a><a href="/drum">/drum</a></nav>
  </div>

  <style is:global>
    html, body { margin: 0; background: #fff4d8; }
    body:has(.siege) { min-height: 100vh; overflow-x: hidden; color: #111522; font-family: Inter,-apple-system,BlinkMacSystemFont,system-ui,sans-serif; background: radial-gradient(circle at 8% 12%,rgba(255,207,74,.52),transparent 28%),radial-gradient(circle at 94% 34%,rgba(99,207,255,.42),transparent 26%),linear-gradient(145deg,#fff9e9 0%,#ffe1bd 48%,#ffd1e3 100%); }
    .sr-only { position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important; }
    .siege { --accent:#ffcf4a;--accent-soft:#ff8d6e;width:min(100%,960px);min-height:100vh;margin:0 auto;padding:12px 14px 108px;display:flex;flex-direction:column;gap:11px;box-sizing:border-box; }
    .siege button,.siege a{-webkit-tap-highlight-color:transparent}.siege button{font:inherit}.siege button:focus-visible,.siege a:focus-visible{outline:3px solid #111522;outline-offset:3px}
    .siege__hud{min-height:68px;display:grid;grid-template-columns:1fr 1.8fr .9fr .72fr 1.12fr;border:2px solid #111522;border-radius:20px;background:rgba(255,252,241,.93);box-shadow:0 7px 0 rgba(17,21,34,.13);overflow:hidden;backdrop-filter:blur(12px)}
    .siege__hud>div{min-width:0;padding:8px 11px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(17,21,34,.16)}.siege__hud>div:last-child{border:0}.siege__hud span{font:700 8px/1.2 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.siege__hud strong{font:900 20px/.96 Inter,sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.siege__wave-block strong{font-size:16px}.siege__shields{display:grid!important;grid-template-columns:repeat(2,12px);place-content:center;gap:5px}.siege__shields span{width:12px;height:12px;border:2px solid #111522;border-radius:4px;background:var(--accent)}.siege__shields span.is-empty{background:transparent;opacity:.25}.siege__power{gap:4px}.siege__power i{height:7px;border:1px solid #111522;border-radius:99px;background:#fff;overflow:hidden}.siege__power b{display:block;width:0;height:100%;background:linear-gradient(90deg,#ff6faa,#ffcf4a,#56dfb1);transition:width .15s}.siege[data-drop="true"] .siege__power{background:#111522;color:#fff}.siege[data-drop="true"] .siege__power b{width:100%!important}
    .siege__stage{position:relative;height:550px;border:2px solid #111522;border-radius:28px;overflow:hidden;background:#0b1020;box-shadow:0 10px 0 rgba(17,21,34,.15)}#siege-canvas{display:block;width:100%;height:100%}.siege__core{position:absolute;z-index:7;left:50%;top:48%;width:116px;height:116px;transform:translate(-50%,-50%);border:0;border-radius:50%;background:transparent;display:grid;place-items:center;cursor:default}.siege__core span{position:absolute;inset:7px;border:5px solid rgba(255,255,255,.85);border-radius:50%;box-shadow:0 0 0 9px rgba(17,21,34,.68),0 0 32px var(--accent)}.siege__core img{position:relative;width:82px;height:82px;image-rendering:pixelated;filter:drop-shadow(0 4px 0 rgba(0,0,0,.3))}.siege__core small{position:absolute;bottom:-8px;padding:4px 8px;border:2px solid #111522;border-radius:99px;background:#fff;color:#111522;font:900 8px/1 'IBM Plex Mono',monospace}.siege__core:not(:disabled){cursor:pointer}.siege__core:not(:disabled) span{animation:dropReady .45s steps(2,end) infinite;background:rgba(255,207,74,.3)}@keyframes dropReady{50%{transform:scale(1.08);border-color:#ffcf4a}}
    .siege__gate{position:absolute;z-index:4;padding:4px 7px;border-radius:6px;background:rgba(9,12,25,.72);color:#fff;font:900 9px/1 'IBM Plex Mono',monospace;letter-spacing:.06em}.siege__gate--west{left:10px;top:44%}.siege__gate--east{right:10px;top:44%}.siege__gate--north{top:10px;left:50%;transform:translateX(-50%)}.siege__gate--south{bottom:78px;left:50%;transform:translateX(-50%)}
    .siege__judge{position:absolute;z-index:12;left:50%;top:27%;transform:translate(-50%,-50%) scale(.8);padding:6px 10px;border:2px solid #111522;border-radius:8px;background:#fff;color:#111522;opacity:0;font:1000 15px/1 'IBM Plex Mono',monospace;pointer-events:none}.siege__judge.is-showing{animation:judgePop .48s ease-out}@keyframes judgePop{0%{opacity:0;transform:translate(-50%,-20%) scale(.7)}20%,72%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-72%) scale(.9)}}.siege__flash{position:absolute;z-index:11;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 5px 0 #111522;font:1000 clamp(46px,10vw,92px)/.8 Inter,sans-serif;letter-spacing:-.07em;pointer-events:none}
    .siege__loop{position:absolute;z-index:8;left:12px;right:12px;bottom:10px;padding:7px 8px 8px;border:2px solid #111522;border-radius:14px;background:rgba(255,252,241,.94);box-shadow:0 4px 0 rgba(17,21,34,.24)}.siege__loop-head{display:flex;justify-content:space-between;margin-bottom:5px;font:900 8px/1 'IBM Plex Mono',monospace}.siege__loop-cells{display:grid;grid-template-columns:repeat(16,1fr);gap:3px}.siege__loop-cells>span{position:relative;height:22px;border:1px solid #111522;border-radius:4px;background:#fff;overflow:hidden}.siege__loop-cells>span:nth-child(4n+1){border-left-width:3px}.siege__loop-cells>span.is-now{box-shadow:inset 0 -5px 0 var(--accent)}.siege__loop-cells i,.siege__loop-cells b{position:absolute;left:2px;right:2px;height:6px;border-radius:5px}.siege__loop-cells i{top:3px}.siege__loop-cells b{bottom:3px;opacity:.55}.siege__loop-cells i.has-west,.siege__loop-cells b.has-west{background:#ffcf4a}.siege__loop-cells i.has-north,.siege__loop-cells b.has-north{background:#ff6faa}.siege__loop-cells i.has-south,.siege__loop-cells b.has-south{background:#56dfb1}.siege__loop-cells i.has-east,.siege__loop-cells b.has-east{background:#63cfff}.siege__loop-cells i.is-chord,.siege__loop-cells b.is-chord{background:linear-gradient(90deg,#ffcf4a,#ff6faa,#56dfb1,#63cfff)}
    .siege__overlay{position:absolute;z-index:20;inset:0;display:grid;place-items:center;padding:20px;background:rgba(7,9,18,.3);backdrop-filter:blur(5px)}.siege__overlay[hidden]{display:none}.siege__card{width:min(100%,790px);max-height:100%;display:grid;grid-template-columns:.78fr 1.22fr;border:2px solid #111522;border-radius:24px;overflow:hidden;background:#fffaf0;box-shadow:0 12px 0 rgba(17,21,34,.38)}.siege__card-art{min-height:420px;padding:17px;display:flex;flex-direction:column;justify-content:flex-end;background-position:center;background-size:cover;color:#fff}.siege__card-art span,.siege__card-art small{font:800 9px/1.2 'IBM Plex Mono',monospace;letter-spacing:.08em}.siege__card-art strong{font:1000 35px/.82 Inter,sans-serif;letter-spacing:-.08em}.siege__card-body{padding:18px 20px 16px;overflow:auto}.siege__eyebrow{display:flex;justify-content:space-between;gap:10px;font:800 8px/1.2 'IBM Plex Mono',monospace}.siege__card h1{margin:12px 0 8px;font:1000 clamp(31px,5vw,48px)/.83 Inter,sans-serif;letter-spacing:-.075em}.siege__card p{margin:0 0 10px;font:600 12px/1.38 Inter,sans-serif}.siege__noun-picker{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:10px 0}.siege__noun-picker[hidden]{display:none}.siege__noun-picker button{min-width:0;padding:5px;border:2px solid transparent;border-radius:11px;background:#f1e8d5;display:flex;align-items:center;gap:5px;font:800 8px/1 'IBM Plex Mono',monospace}.siege__noun-picker button[aria-pressed="true"]{border-color:#111522;background:#ffcf4a}.siege__noun-picker img{width:34px;height:34px;image-rendering:pixelated}.siege__card-stats{display:grid;grid-template-columns:repeat(3,1fr);margin:9px 0;border:1px solid rgba(17,21,34,.24);border-radius:10px;overflow:hidden}.siege__card-stats span{padding:6px;border-right:1px solid rgba(17,21,34,.18)}.siege__card-stats span:last-child{border:0}.siege__card-stats small{display:block;font:700 7px/1 'IBM Plex Mono',monospace;text-transform:uppercase}.siege__card-stats strong{font:900 10px/1 Inter,sans-serif}.siege__route{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin:9px 0;padding:0;list-style:none}.siege__route[hidden]{display:none}.siege__route li{padding:6px;border:1px solid rgba(17,21,34,.24);border-radius:7px;display:grid;gap:2px}.siege__route li.is-current{background:var(--accent);border-color:#111522}.siege__route span,.siege__route small{font:700 7px/1 'IBM Plex Mono',monospace}.siege__route b{font:900 8px/1 Inter,sans-serif}.siege__best{font:800 8px/1 'IBM Plex Mono',monospace!important}.siege__go{width:100%;min-height:45px;border:2px solid #111522;border-radius:11px;background:#111522;color:#fff;font:1000 12px/1 'IBM Plex Mono',monospace;box-shadow:0 5px 0 var(--accent);cursor:pointer}.siege__input-note{text-align:center;margin-top:9px!important;font:800 7px/1 'IBM Plex Mono',monospace!important}
    .siege__pads { display:grid;grid-template-columns:repeat(4,1fr);gap:8px;touch-action: none }.siege__pad { min-height: 78px;padding:8px 12px;border:2px solid #111522;border-radius:17px;background:var(--lane);color:#111522;box-shadow:0 6px 0 rgba(17,21,34,.24);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:7px;text-align:left;touch-action: none;user-select:none;cursor:pointer }.siege__pad:disabled{opacity:.48;cursor:default}.siege__pad>span{font:1000 27px/1 Inter,sans-serif}.siege__pad>strong{font:1000 11px/1 Inter,sans-serif}.siege__pad>small{font:900 12px/1 'IBM Plex Mono',monospace}.siege__pad.is-hit{transform:translateY(4px);box-shadow:0 2px 0 rgba(17,21,34,.24);filter:brightness(1.12)}
    .siege__utility{display:flex;align-items:center;justify-content:center;gap:8px}.siege__utility button,.siege__utility span{min-height:28px;padding:0 9px;border:1px solid rgba(17,21,34,.3);border-radius:99px;background:rgba(255,252,241,.72);font:800 8px/28px 'IBM Plex Mono',monospace}.siege__sync{display:flex}.siege__sync>*{border-radius:0!important}.siege__sync>*:first-child{border-radius:99px 0 0 99px!important}.siege__sync>*:last-child{border-radius:0 99px 99px 0!important}.siege__manifesto{padding:20px;border:2px solid #111522;border-radius:22px;background:rgba(255,252,241,.7);display:grid;grid-template-columns:.9fr 1.5fr;gap:20px}.siege__manifesto>div>p{margin:0;font:800 8px/1 'IBM Plex Mono',monospace}.siege__manifesto h2{margin:5px 0 0;font:1000 29px/.9 Inter,sans-serif;letter-spacing:-.055em}.siege__manifesto ol{margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:9px;list-style:none}.siege__manifesto li{padding:10px;border:1px solid rgba(17,21,34,.22);border-radius:11px}.siege__manifesto li span{font:800 8px/1 'IBM Plex Mono',monospace}.siege__manifesto li strong{display:block;margin-top:4px;font:1000 12px/1 Inter,sans-serif}.siege__manifesto li p{margin:5px 0 0;font:600 10px/1.3 Inter,sans-serif}.siege__versions,.siege__siblings{display:flex;flex-wrap:wrap;justify-content:center;gap:5px}.siege__versions span,.siege__versions a,.siege__siblings a{padding:5px 8px;border:1px solid rgba(17,21,34,.25);border-radius:99px;background:rgba(255,252,241,.68);color:#3d3540;font:700 8px/1 'IBM Plex Mono',monospace;text-decoration:none}.siege__versions a[aria-current="page"]{background:#111522;color:#fff;border-color:#111522}
    @media (max-width: 700px){.siege{padding:8px 8px 240px}.siege__hud{grid-template-columns:1fr 1.5fr 1fr}.siege__hud>div{padding:7px}.siege__shields{border-right:0!important;border-top:1px solid rgba(17,21,34,.15)}.siege__power{grid-column:2/4;border-top:1px solid rgba(17,21,34,.15);border-right:0!important}.siege__stage{height:clamp(300px,calc(100dvh - 328px),500px);border-radius:20px}.siege__overlay{padding:12px}.siege__card{grid-template-columns:1fr;width:min(100%,430px)}.siege__card-art{min-height:92px;padding:10px}.siege__card-art strong{font-size:24px}.siege__card-body{padding:12px}.siege__card h1{font-size:35px}.siege__loop{left:6px;right:6px}.siege__loop-cells{gap:2px}.siege__loop-cells>span{height:19px}.siege__pads { position:fixed;z-index:35;left:8px;right:8px;bottom:50px;grid-template-columns: repeat(2, 1fr);gap:7px;padding:8px;border:2px solid #111522;border-radius:19px;background:rgba(255,248,229,.96);box-shadow:0 -7px 24px rgba(17,21,34,.18);touch-action:none }.siege__pad{min-height:72px}.siege__manifesto{grid-template-columns:1fr}.siege__manifesto ol{grid-template-columns:1fr 1fr 1fr}}
    @media(max-width:410px){.siege__card-art{display:none}.siege__card h1{font-size:31px}.siege__card-sub{font-size:11px}.siege__noun-picker{margin:6px 0}.siege__route{margin:6px 0}.siege__core{width:96px;height:96px}.siege__core img{width:68px;height:68px}.siege__gate--south{bottom:73px}}
    @media (max-width: 700px) and (max-height: 620px){.siege{padding-bottom:150px}.siege__stage{height:clamp(250px,calc(100dvh - 260px),330px)}.siege__pads{grid-template-columns:repeat(4,1fr);bottom:44px}.siege__pad{min-height:60px;padding:6px;grid-template-columns:1fr auto;text-align:center}.siege__pad>strong{display:none}.siege__pad>span{font-size:22px}}
    @media(prefers-reduced-motion:reduce){.siege__judge.is-showing,.siege__core:not(:disabled) span{animation-duration:.01ms!important;animation-iteration-count:1!important}}
  </style>

  <script>
    import marineBackdrop from '../assets/drum-runner-v3/marine-layer.webp?url';
    import pierBackdrop from '../assets/drum-runner-v3/el-porto-pier.webp?url';
    import groceryBackdrop from '../assets/drum-runner-v3/grocery-3pm.webp?url';
