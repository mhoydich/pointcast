    function runWaveTransition(transition:'next'|'complete'){if(document.hidden){deferredTransition=transition;return}deferredTransition=null;if(transition==='complete')finishRun();else{goButton.hidden=false;startWave(waveIndex+1)}}
    function finishRun(){stopScheduled();setPhase('complete');cancelAnimationFrame(animationFrame);const totalGrades=gradeCounts.perfect+gradeCounts.great+gradeCounts.good+gradeCounts.late;const precision=totalGrades?Math.round((gradeCounts.perfect+gradeCounts.great*.7+gradeCounts.good*.4)/totalGrades*100):0;const grade=precision>=90?'S':precision>=80?'A':precision>=68?'B':precision>=55?'C':'D';if(score>best){best=score;writeStorage(SIEGE_BEST_KEY, String(best))}overlay.hidden=false;nounPicker.hidden=true;routeEl.hidden=false;cardKickerEl.textContent='LOOP SIEGE COMPLETE · FOUR GATES';cardTempoEl.textContent=`MAX CHAIN ${maxCombo} · BEST ${best.toLocaleString()}`;cardTitleEl.innerHTML=`GRADE ${grade}<br />${score.toLocaleString()} PTS`;cardSubEl.textContent=`You cleared ${kills} raiders with ${acceptedHits} authored drum attacks. Each loop fought once, then made room for the next idea.`;statALabel.textContent='perfect';statA.textContent=String(gradeCounts.perfect);statBLabel.textContent='great';statB.textContent=String(gradeCounts.great);statCLabel.textContent='loose';statC.textContent=String(gradeCounts.late);bestEl.textContent=`best ${best.toLocaleString()} pts`;goButton.hidden=false;goButton.textContent='▶ PLAY AGAIN';liveEl.textContent=`Loop Siege complete. Grade ${grade}, ${score} points, ${kills} raiders cleared.`;drawSiege(waveStart+waveEndBeat(currentWave())*secondsPerBeat(currentWave().bpm));goButton.focus({preventScroll:true})}

    function runFrame(){if(phase!=='countin'&&phase!=='playing')return;const now = siegeAudioNow();if(phase==='countin'){flashEl.hidden=false;const remaining=Math.ceil((waveStart-now)/secondsPerBeat(currentWave().bpm));flashEl.textContent=remaining>0?String(Math.min(3,remaining)):'GO';if(now>=waveStart){setPhase('playing');advanceLoop(now)}}else if(now>waveStart+.35){flashEl.hidden=true}if(phase==='playing'){advanceLoop(now);const absolute=absoluteStepAtTime(now,waveStart,currentWave().bpm);if(absolute!==activeAbsoluteStep){activeAbsoluteStep=absolute;const step=absolute%SIEGE_LOOP_STEPS;updateLoopRail(step);if(dropQueued&&absolute>0&&absolute%8===0)fireDrop(now)}processEchoes(now);const deadline=resolveEnemyDeadlines(enemies,currentBeat(now),shields);enemies=deadline.enemies;shields=deadline.shields;if(deadline.breaches){combo=0;showJudge(deadline.breaches>1?'GATES BREACHED':'GATE BREACHED','miss');tone(actx!.currentTime+.003,78,.32,.16,'sawtooth');updateHud();liveEl.textContent=`${deadline.breaches} gate ${deadline.breaches===1?'breach':'breaches'}. ${shields} shields remain.`;if(shields===0)failWave()}if(!waveClosing&&currentBeat(now)>=waveEndBeat(currentWave()))finishWave()}drawSiege(now);if(phase==='countin'||phase==='playing')animationFrame=requestAnimationFrame(runFrame)}

    function resizeCanvas(){const rect=canvas.getBoundingClientRect();const ratio=Math.min(2,window.devicePixelRatio||1);const width=Math.max(1,Math.round(rect.width*ratio));const height=Math.max(1,Math.round(rect.height*ratio));if(canvas.width!==width||canvas.height!==height){canvas.width=width;canvas.height=height}context.setTransform(ratio,0,0,ratio,0,0);return{width:rect.width,height:rect.height}}
    function drawCover(image:HTMLImageElement,width:number,height:number){if(!image.complete||!image.naturalWidth)return;const scale=Math.max(width/image.naturalWidth,height/image.naturalHeight);const sourceWidth=width/scale;const sourceHeight=height/scale;context.drawImage(image,(image.naturalWidth-sourceWidth)/2,(image.naturalHeight-sourceHeight)/2,sourceWidth,sourceHeight,0,0,width,height)}
    function gatePoint(lane:SiegeLane,width:number,height:number){if(lane==='west')return{x:20,y:height*.46};if(lane==='east')return{x:width-20,y:height*.46};if(lane==='north')return{x:width/2,y:18};return{x:width/2,y:height-90}}
    function drawSiege(now:number){const{width,height}=resizeCanvas();const wave=SIEGE_WAVES[Math.min(waveIndex,SIEGE_WAVES.length-1)];context.save();context.fillStyle='#0b1020';context.fillRect(0,0,width,height);drawCover(backdropImages[Math.min(waveIndex,backdropImages.length-1)],width,height);const wash=context.createLinearGradient(0,0,0,height);wash.addColorStop(0,'rgba(8,12,26,.32)');wash.addColorStop(.55,'rgba(7,10,22,.62)');wash.addColorStop(1,'rgba(5,8,18,.88)');context.fillStyle=wash;context.fillRect(0,0,width,height);const center={x:width/2,y:height*.48};const beat=secondsPerBeat(wave.bpm);const beatFloat=waveStart>0?(now-waveStart)/beat:0;const pulse=1-(((beatFloat%1)+1)%1);SIEGE_LANE_ORDER.forEach((lane)=>{const gate=gatePoint(lane,width,height);context.beginPath();context.moveTo(gate.x,gate.y);context.lineTo(center.x,center.y);context.lineWidth=12;context.strokeStyle=`${SIEGE_LANE_META[lane].color}55`;context.stroke();context.setLineDash([6,11]);context.lineDashOffset=-beatFloat*24;context.lineWidth=2;context.strokeStyle='rgba(255,255,255,.58)';context.stroke();context.setLineDash([])});context.beginPath();context.arc(center.x,center.y,67+pulse*7,0,Math.PI*2);context.strokeStyle=dropReady?'#ffcf4a':'rgba(255,255,255,.7)';context.lineWidth=dropReady?7:3;context.stroke();if(phase==='countin'||phase==='playing'){const beatNow=currentBeat(now);enemies.forEach((enemy)=>{if(enemy.dead||enemy.breached||beatNow<enemy.spawnBeat)return;const gate=gatePoint(enemy.lane,width,height);const progress=enemyApproachProgress(enemy,beatNow);const stop=76;const vx=center.x-gate.x;const vy=center.y-gate.y;const length=Math.hypot(vx,vy)||1;const target={x:center.x-vx/length*stop,y:center.y-vy/length*stop};const eased=progress**1.12;const x=gate.x+(target.x-gate.x)*eased;const y=gate.y+(target.y-gate.y)*eased;const color=SIEGE_LANE_META[enemy.lane].color;context.save();context.shadowColor=color;context.shadowBlur=13;context.fillStyle=enemy.tier===3?'#111522':color;context.strokeStyle=progress>.78?'#ff6f87':'#fff';context.lineWidth=progress>.78?5:3;context.beginPath();if(enemy.tier===1)context.arc(x,y,15,0,Math.PI*2);else context.roundRect(x-18,y-16,36,32,enemy.tier===3?5:11);context.fill();context.stroke();context.shadowBlur=0;context.fillStyle=enemy.tier===3?color:'#111522';context.font='900 11px IBM Plex Mono, monospace';context.textAlign='center';context.textBaseline='middle';context.fillText(String(enemy.hp),x,y);context.restore()})}bursts=bursts.filter((burst)=>now-burst.at<.38);bursts.forEach((burst)=>{const age=Math.max(0,now-burst.at);const progress=age/.38;const gate=gatePoint(burst.lane,width,height);const startX=center.x+(gate.x-center.x)*.12;const startY=center.y+(gate.y-center.y)*.12;const x=startX+(gate.x-startX)*progress;const y=startY+(gate.y-startY)*progress;context.beginPath();context.arc(x,y,burst.source==='drop'?16:burst.source==='ghost'?10:12,0,Math.PI*2);context.fillStyle=burst.source==='ghost'?'rgba(218,184,255,.72)':burst.source==='drop'?'#fff':'#ffcf4a';context.fill();context.strokeStyle=SIEGE_LANE_META[burst.lane].color;context.lineWidth=4;context.stroke()});context.restore()}

    async function startOrRetry(){const audio=ensureAudio();if(!audio)return;await audio.resume();if(phase==='failed'&&snapshot)restoreSnapshot(snapshot);if(phase==='intro'||phase==='complete'){score=0;kills=0;combo=0;maxCombo=0;acceptedHits=0;dropReady=false;dropQueued=false;gradeCounts={perfect:0,great:0,good:0,late:0};waveIndex=0}nounPicker.hidden=false;routeEl.hidden=false;goButton.hidden=false;startWave(waveIndex)}
    goButton.addEventListener('click',()=>{void startOrRetry()});
    nounPicker.addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-noun]');if(!button)return;selectedNoun=clampNumber(Number(button.dataset.noun),0,1199);writeStorage('pc:nounId',String(selectedNoun));nounEl.src=`https://noun.pics/${selectedNoun}.svg`;nounPicker.querySelectorAll<HTMLButtonElement>('[data-noun]').forEach((choice)=>choice.setAttribute('aria-pressed',String(choice===button)))});
    padButtons.forEach((button)=>{
      button.addEventListener('pointerdown',(event)=>{
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        event.preventDefault();
        performLane(button.dataset.lane as SiegeLane, event.timeStamp);
      });
      button.addEventListener('click',(event)=>{if(event.detail>0)return;performLane(button.dataset.lane as SiegeLane,event.timeStamp)});
    });
    document.addEventListener('keydown',(event)=>{
      if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
      if((event.target as HTMLElement)?.matches('input, textarea, select'))return;
      if(event.key===' '||event.key==='Enter'&&(event.target===dropButton)){if(dropReady){event.preventDefault();queueDrop()}return}
      const lane = laneForKey(event.key);
      if(!lane)return;
      event.preventDefault();
      performLane(lane,event.timeStamp);
    });
    dropButton.addEventListener('click',queueDrop);
    soundButton.addEventListener('click',async()=>{const audio=ensureAudio();if(!audio)return;await audio.resume();muted=!muted;writeStorage(SIEGE_MUTED_KEY,muted?'1':'0');masterGain?.gain.setTargetAtTime(muted?.0001:.72,audio.currentTime,.015);soundButton.textContent=muted?'SOUND OFF':'SOUND ON';soundButton.setAttribute('aria-pressed',String(!muted))});
    function adjustSync(delta:number){syncMs=clampNumber(syncMs+delta,-150,150);writeStorage(SIEGE_SYNC_KEY,String(syncMs));syncCopy.textContent=`SYNC ${syncMs>0?'+':''}${syncMs}MS`;liveEl.textContent=`Timing sync ${syncMs} milliseconds.`}syncMinus.addEventListener('click',()=>adjustSync(-15));syncPlus.addEventListener('click',()=>adjustSync(15));
    document.addEventListener('visibilitychange',()=>{if(document.hidden&&(phase==='countin'||phase==='playing'))failWave();if(!document.hidden&&deferredTransition){const transition=deferredTransition;deferredTransition=null;transitionTimer=window.setTimeout(()=>runWaveTransition(transition),250)}});window.addEventListener('resize',()=>drawSiege(siegeAudioNow()),{passive:true});
    function initialize(){const choices=[137,418,855];if(!choices.includes(selectedNoun))selectedNoun=137;nounEl.src=`https://noun.pics/${selectedNoun}.svg`;nounPicker.querySelectorAll<HTMLButtonElement>('[data-noun]').forEach((button)=>button.setAttribute('aria-pressed',String(Number(button.dataset.noun)===selectedNoun)));bestEl.textContent=best?`best ${best.toLocaleString()} pts`:'best — pts';soundButton.textContent=muted?'SOUND OFF':'SOUND ON';soundButton.setAttribute('aria-pressed',String(!muted));syncCopy.textContent=`SYNC ${syncMs>0?'+':''}${syncMs}MS`;updateWaveUi();updateHud();updateLoopRail(0);drawSiege(0)}initialize();
  </script>
</BlockLayout>
