---
import BlockLayout from '../layouts/BlockLayout.astro';

const POSTERS = [
  {
    title: 'Hero',
    file: '/images/nouns-cola/ads-generated-v2/poster-01-hero.png',
    note: 'Minimal product-as-hero launch statement.',
  },
  {
    title: 'Night',
    file: '/images/nouns-cola/ads-generated-v2/poster-02-night.png',
    note: 'Blue-hour city icon treatment.',
  },
  {
    title: 'Pop',
    file: '/images/nouns-cola/ads-generated-v2/poster-03-pop.png',
    note: 'Color-block fashion-pop energy.',
  },
  {
    title: 'Mural',
    file: '/images/nouns-cola/ads-generated-v2/poster-04-mural.png',
    note: 'Public-wall campaign artifact.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': 'https://pointcast.xyz/nouns-cola-posters-02',
      name: 'Nouns Cola AI Posters · Set 02',
      description: 'A second set of Nouns Cola individual poster advertisements generated with ChatGPT image generation and published through PointCast.',
      url: 'https://pointcast.xyz/nouns-cola-posters-02',
      inLanguage: 'en-US',
    },
  ],
};
---

<BlockLayout
  title="Nouns Cola AI Posters · Set 02"
  description="A second set of Nouns Cola individual poster advertisements generated with ChatGPT image generation and published through PointCast."
  image="/images/og/nouns-cola-posters-02.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/nouns-cola-posters-02.json', title: 'Nouns Cola posters set 02 (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-cola-posters-02.png',
    buttons: [
      { label: 'Open posters', action: 'link', target: 'https://pointcast.xyz/nouns-cola-posters-02' },
      { label: 'Open board', action: 'link', target: 'https://pointcast.xyz/nouns-cola' },
      { label: 'Case study', action: 'link', target: 'https://pointcast.xyz/nouns-cola-case-study' },
      { label: 'Agent JSON', action: 'link', target: 'https://pointcast.xyz/nouns-cola-posters-02.json' },
    ],
  }}
>
  <div class="cola-page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-cola">Nouns Cola</a>
      <span aria-hidden="true">/</span>
      <span>poster set 02</span>
    </nav>

    <header class="hero">
      <div class="hero__copy">
        <p class="kicker">NOUNS COLA / AI POSTERS</p>
        <h1 class="display">Another set of ads, one poster at a time.</h1>
        <p class="dek">
          Four new individual advertisements generated with ChatGPT image
          generation: hero, night, pop, and mural. Each one pushes the drink a
          little deeper into campaign-world territory instead of leaving it as a
          single packaging image.
        </p>
        <div class="hero__actions" aria-label="Primary actions">
          <a class="btn btn--primary" href="/nouns-cola-case-study">Open AI case study</a>
          <a class="btn btn--ghost" href="/nouns-cola">Open operating board</a>
          <a class="btn btn--ghost" href="/nouns-cola-posters-02.json">Agent JSON</a>
        </div>
      </div>
      <figure class="hero__visual">
        <img src={POSTERS[0].file} alt="Nouns Cola AI poster set hero image" width="1024" height="1536" />
        <figcaption class="mono">SET 02 / HERO + NIGHT + POP + MURAL</figcaption>
      </figure>
    </header>

    <section class="status" aria-label="Poster set status">
      <div><span class="mono">SET</span><strong>02</strong></div>
      <div><span class="mono">FORMAT</span><strong>individual posters</strong></div>
      <div><span class="mono">TOOL</span><strong>ChatGPT image generation</strong></div>
      <div><span class="mono">COUNT</span><strong>4 concepts</strong></div>
      <div><span class="mono">SURFACE</span><strong>PointCast</strong></div>
    </section>

    <section class="band">
      <div class="section-head">
        <p class="kicker">POSTERS</p>
        <h2>Four campaign moods, four separate artifacts.</h2>
        <p>
          This set is intentionally tighter than a giant board. Each image is
          meant to stand on its own as a poster, a street placement, or a print
          campaign surface.
        </p>
      </div>
      <div class="poster-grid">
        {POSTERS.map((poster) => (
          <article class="poster-card">
            <img src={poster.file} alt={`Nouns Cola poster: ${poster.title}`} width="1024" height="1536" loading="lazy" />
            <div class="poster-card__meta">
              <strong>{poster.title}</strong>
              <p>{poster.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="team">
      <div>
        <p class="kicker">GO TEAM</p>
        <h2>The can keeps getting more legible as campaign matter.</h2>
      </div>
      <ul>
        <li><strong>Hero</strong><span>clean launch statement</span></li>
        <li><strong>Night</strong><span>city-energy campaign version</span></li>
        <li><strong>Pop</strong><span>graphic youth-culture treatment</span></li>
        <li><strong>Mural</strong><span>public-world identity direction</span></li>
      </ul>
    </section>
  </div>
</BlockLayout>

<style>
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .poster-card {
    display: grid;
    gap: 0.8rem;
  }

  .poster-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    border: 1px solid rgba(17, 19, 15, 0.08);
    background: #f3eee4;
  }

  .poster-card__meta strong {
    display: block;
    font-size: 1.05rem;
  }

  .poster-card__meta p {
    margin: 0.35rem 0 0;
    color: #62584e;
  }

  @media (max-width: 820px) {
    .poster-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
