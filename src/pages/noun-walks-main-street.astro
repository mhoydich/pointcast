---
/**
 * /noun-walks-main-street — Noun #742 (Main Street) walks down a
 * pixel-art Main Street with drum-driven footsteps.
 *
 * Mike 2026-05-07: "build an animated version of a noun walking down
 * a main street, use codex for image generation, with audio, and
 * interaction drum like stuffs."
 *
 * Image-gen MCP (Higgsfield) was out of credits, so the backdrop is
 * hand-drawn SVG pixel-art — fits the Nouns aesthetic better than
 * AI-generated photoreal anyway. Three parallax layers scroll behind
 * the Noun (sky/sun stays put, distant buildings slow, foreground
 * sidewalk + meters + palm fast). The Noun bobs in place on each kick.
 *
 * Drum-like interaction: 4-step pattern across kick/snare/bell, tap
 * any cell to toggle. Tempo slider controls walking speed. Loop
 * starts on tap (audio gating).
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Main Street Walk · Noun #742 walks · PointCast';
const description =
  'Noun #742 (Main Street) walks down a pixel-art El Segundo backdrop. Drum-driven footsteps, tap-to-set 4-step pattern, tempo slider.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Main Street Walk',
  url: 'https://pointcast.xyz/noun-walks-main-street',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="msw" id="msw-main">

    <header class="msw__header">
      <h1 class="msw__title">MAIN STREET WALK</h1>
      <p class="msw__tag">Noun #742 walks · drum drives the footsteps · tap to set the rhythm</p>
    </header>

    <section class="msw__stage" id="msw-stage" aria-label="Noun walking down Main Street">
      {/* Sky + sun (parallax 0 — fixed) */}
      <svg class="msw__layer msw__sky" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="msw-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#9ed6f0"/>
            <stop offset="60%" stop-color="#d6e8ee"/>
            <stop offset="100%" stop-color="#f5d9b8"/>
          </linearGradient>
        </defs>
        <rect width="320" height="180" fill="url(#msw-sky)"/>
        {/* sun */}
        <circle cx="248" cy="44" r="14" fill="#ffd266"/>
        <circle cx="248" cy="44" r="9"  fill="#fff7c8"/>
        {/* clouds */}
        <g fill="#ffffff" fill-opacity="0.85">
          <rect x="40"  y="30" width="22" height="6"/>
          <rect x="46"  y="24" width="14" height="6"/>
          <rect x="124" y="56" width="18" height="5"/>
          <rect x="128" y="51" width="10" height="5"/>
        </g>
      </svg>

      {/* Rich pixel-art Main Street asset (parallax slow) */}
      <div class="msw__layer msw__bg-buildings" id="msw-bg-buildings" aria-hidden="true">
        <img src="/images/main-street-pixel.svg" alt="" width="100%" height="100%" style="image-rendering: pixelated;" />
      </div>

      {/* Rich pixel-art Main Street asset (parallax medium) */}
      <div class="msw__layer msw__mid" id="msw-mid" aria-hidden="true">
        <img src="/images/main-street-pixel.svg" alt="" width="100%" height="100%" style="image-rendering: pixelated;" />
      </div>

      {/* Sidewalk + street props (parallax fast) */}
      <div class="msw__layer msw__fg" id="msw-fg" aria-hidden="true">
        <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice">
          {/* sidewalk */}
          <rect x="0" y="160" width="320" height="20" fill="#b8b3a8"/>
          <g fill="#5a574e">
            <rect x="0"   y="160" width="320" height="2"/>
            <rect x="20"  y="162" width="2"   height="18"/>
            <rect x="60"  y="162" width="2"   height="18"/>
            <rect x="100" y="162" width="2"   height="18"/>
            <rect x="140" y="162" width="2"   height="18"/>
            <rect x="180" y="162" width="2"   height="18"/>
            <rect x="220" y="162" width="2"   height="18"/>
            <rect x="260" y="162" width="2"   height="18"/>
            <rect x="300" y="162" width="2"   height="18"/>
          </g>
          {/* parking meter */}
          <rect x="42" y="146" width="3"  height="14" fill="#3a3530"/>
          <rect x="38" y="138" width="11" height="10" fill="#9a8a44"/>
          <rect x="40" y="140" width="7"  height="6"  fill="#1a0820"/>
          {/* USPS mailbox */}
          <rect x="240" y="142" width="14" height="18" fill="#3a5fb8"/>
          <rect x="238" y="140" width="18" height="4"  fill="#264284"/>
          <rect x="246" y="148" width="3"  height="3"  fill="#fff"/>
          {/* palm tree */}
          <rect x="288" y="140" width="3"  height="22" fill="#5a3a22"/>
          <g fill="#3f5840">
            <rect x="280" y="134" width="20" height="3"/>
            <rect x="284" y="130" width="14" height="3"/>
            <rect x="282" y="128" width="6"  height="2"/>
            <rect x="294" y="128" width="6"  height="2"/>
          </g>
        </svg>
      </div>

      {/* The Noun walking */}
      <div class="msw__noun-stage">
        <div class="msw__noun" id="msw-noun">
          <img src="https://noun.pics/742.svg" alt="Noun 742 — Main Street" width="100" height="100" />
        </div>
        <div class="msw__shadow" id="msw-shadow" aria-hidden="true"></div>
      </div>

      {/* HUD overlay */}
      <div class="msw__hud" id="msw-hud" aria-hidden="true">
        <span class="msw__hud-step" id="msw-hud-step">— / 4</span>
        <span class="msw__hud-bpm" id="msw-hud-bpm">— bpm</span>
      </div>
    </section>

    <section class="msw__panel">
      <div class="msw__panel-row">
        <button class="msw__btn" id="msw-toggle" type="button">▶ TAP TO START</button>
        <label class="msw__tempo">
          <span class="msw__tempo-label">TEMPO</span>
          <input type="range" id="msw-tempo" min="60" max="140" step="2" value="90"/>
          <span id="msw-tempo-readout">90 bpm</span>
        </label>
      </div>

      <div class="msw__pattern" role="grid" aria-label="4-step drum pattern">
        <div class="msw__lane" data-inst="kick">
          <span class="msw__lane-label">KICK · footstep</span>
          <span class="msw__cells">
            <button class="msw__cell" data-inst="kick" data-step="0" aria-pressed="true"></button>
            <button class="msw__cell" data-inst="kick" data-step="1" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="kick" data-step="2" aria-pressed="true"></button>
            <button class="msw__cell" data-inst="kick" data-step="3" aria-pressed="false"></button>
          </span>
        </div>
        <div class="msw__lane" data-inst="snare">
          <span class="msw__lane-label">SNARE · stride accent</span>
          <span class="msw__cells">
            <button class="msw__cell" data-inst="snare" data-step="0" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="snare" data-step="1" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="snare" data-step="2" aria-pressed="true"></button>
            <button class="msw__cell" data-inst="snare" data-step="3" aria-pressed="false"></button>
          </span>
        </div>
        <div class="msw__lane" data-inst="bell">
          <span class="msw__lane-label">BELL · birds &amp; horns</span>
          <span class="msw__cells">
            <button class="msw__cell" data-inst="bell" data-step="0" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="bell" data-step="1" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="bell" data-step="2" aria-pressed="false"></button>
            <button class="msw__cell" data-inst="bell" data-step="3" aria-pressed="true"></button>
          </span>
        </div>
      </div>
    </section>

    <section class="msw__siblings">
      <a href="/drum-nouns-concert">/drum-nouns-concert · 5-noun band</a>
      <a href="/drum-solo-jam">/drum-solo-jam · 90 BPM groove</a>
      <a href="/drum-ambient-noun">/drum-ambient-noun · ambient sway</a>
    </section>
  </main>
</BlockLayout>

<style>
  .msw {
    max-width: 1100px;
    margin: 0 auto;
    padding: 18px 16px 60px;
    font-family: var(--pc-font-sans, system-ui, sans-serif);
    color: #1a0820;
    background: #fffaf0;
    min-height: 100vh;
  }
  .msw__header { text-align: center; margin: 18px 0 18px; }
  .msw__title {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: clamp(34px, 6.5vw, 68px);
    letter-spacing: 0.16em;
    margin: 0;
    color: #1a0820;
    text-shadow: 2px 2px 0 rgba(212, 164, 55, 0.35);
  }
  .msw__tag {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5a3422;
    opacity: 0.85;
    margin: 6px 0 0;
  }

  .msw__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 3px solid #1a0820;
    box-shadow: 6px 6px 0 0 #1a0820;
    background: #9ed6f0;
    image-rendering: pixelated;
  }
  .msw__layer { position: absolute; inset: 0; }
  .msw__layer svg,
  .msw__layer img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    object-fit: fill;
  }
  .msw__sky { z-index: 1; }
  .msw__bg-buildings {
    z-index: 2;
    width: 200%;
    opacity: 0.45;
    animation: msw-scroll var(--bg-dur, 26s) linear infinite;
    animation-play-state: paused;
  }
  .msw__mid {
    z-index: 3;
    width: 200%;
    opacity: 0.95;
    animation: msw-scroll var(--mid-dur, 14s) linear infinite;
    animation-play-state: paused;
  }
  .msw__fg {
    z-index: 5;
    width: 200%;
    animation: msw-scroll var(--fg-dur, 7s) linear infinite;
    animation-play-state: paused;
  }
  .msw__stage[data-state='playing'] .msw__bg-buildings,
  .msw__stage[data-state='playing'] .msw__mid,
  .msw__stage[data-state='playing'] .msw__fg {
    animation-play-state: running;
  }
  @keyframes msw-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .msw__noun-stage {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .msw__noun {
    width: clamp(80px, 13vw, 130px);
    height: clamp(80px, 13vw, 130px);
    image-rendering: pixelated;
    transform-origin: 50% 100%;
    transition: transform 60ms ease-out;
    filter: drop-shadow(2px 4px 0 rgba(0, 0, 0, 0.35));
  }
  .msw__noun img {
    width: 100%; height: 100%;
    image-rendering: pixelated;
  }
  .msw__noun.msw__noun--kick  { transform: translateY(-7px) scale(1.03); }
  .msw__noun.msw__noun--snare { transform: translateY(-3px) translateX(2px); }
  .msw__noun.msw__noun--bell  { transform: scale(1.04) rotate(1deg); }

  .msw__shadow {
    width: 80%;
    height: 8px;
    margin: -4px auto 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0.45) 0%, transparent 75%);
  }

  .msw__hud {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 6;
    display: inline-flex;
    gap: 12px;
    padding: 4px 10px;
    border: 1.5px solid #1a0820;
    background: rgba(255, 250, 240, 0.92);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a0820;
  }

  .msw__panel {
    margin-top: 22px;
    padding: 16px;
    border: 2px solid #1a0820;
    background: #f4e7c8;
  }
  .msw__panel-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .msw__btn {
    padding: 12px 24px;
    border: 2px solid #1a0820;
    background: #d4a437;
    color: #1a0820;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.20em;
    cursor: pointer;
    transition: transform 100ms, box-shadow 100ms;
    box-shadow: 3px 3px 0 0 #1a0820;
  }
  .msw__btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 0 #1a0820; }
  .msw__btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }

  .msw__tempo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a0820;
  }
  .msw__tempo input[type='range'] { width: 180px; }
  .msw__tempo-label { font-weight: 800; }

  .msw__pattern {
    display: grid;
    gap: 8px;
  }
  .msw__lane {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: center;
    gap: 14px;
  }
  .msw__lane-label {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5a3422;
  }
  .msw__cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .msw__cell {
    height: 38px;
    border: 2px solid #1a0820;
    background: #fffaf0;
    cursor: pointer;
    transition: transform 80ms, background 80ms, box-shadow 80ms;
    position: relative;
  }
  .msw__cell:hover { background: #f4e7c8; }
  .msw__cell[aria-pressed='true'] { background: #d4a437; }
  .msw__cell[data-active='true'] {
    box-shadow: 0 0 0 3px #f6c15e, 3px 3px 0 0 #1a0820;
    transform: translate(-1px, -1px);
  }
  .msw__cell[aria-pressed='true'][data-active='true'] {
    background: #f6c15e;
  }

  .msw__siblings {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 22px;
    flex-wrap: wrap;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
  }
  .msw__siblings a { color: #5a3422; text-decoration: none; }
  .msw__siblings a:hover { color: #1a0820; text-decoration: underline; }

  @media (max-width: 720px) {
    .msw__lane { grid-template-columns: 1fr; gap: 4px; }
    .msw__title { font-size: 30px; }
    .msw__tempo input[type='range'] { width: 120px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .msw__bg-buildings, .msw__mid, .msw__fg { animation: none !important; }
    .msw__noun { transition: none !important; }
  }
</style>

<script>
  // 4-step pattern, in BPM = quarter notes per minute. Default 90.
  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('.msw__cell'));
  const stage = document.getElementById('msw-stage');
  const noun = document.getElementById('msw-noun');
  const toggleBtn = document.getElementById('msw-toggle') as HTMLButtonElement | null;
  const tempoEl = document.getElementById('msw-tempo') as HTMLInputElement | null;
  const tempoReadout = document.getElementById('msw-tempo-readout');
  const stepReadout = document.getElementById('msw-hud-step');
  const bpmReadout = document.getElementById('msw-hud-bpm');

  const pattern: Record<string, boolean[]> = {
    kick: [true, false, true, false],
    snare: [false, false, true, false],
    bell: [false, false, false, true],
  };

  cells.forEach((cell) => {
    cell.addEventListener('click', () => {
      const inst = cell.dataset.inst!;
      const step = Number(cell.dataset.step);
      const cur = cell.getAttribute('aria-pressed') === 'true';
      const next = !cur;
      cell.setAttribute('aria-pressed', String(next));
      pattern[inst][step] = next;
    });
  });

  let actx: AudioContext | null = null;
  function ctx() {
    if (!actx) {
      const AC = (window as any).AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
    }
    if (actx && actx.state === 'suspended') actx.resume();
    return actx!;
  }
  function playKick(t: number) {
    const a = ctx();
    const o = a.createOscillator(), g = a.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(120, t);
    o.frequency.exponentialRampToValueAtTime(40, t + 0.2);
    g.gain.setValueAtTime(0.55, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.28);
    o.connect(g).connect(a.destination);
    o.start(t); o.stop(t + 0.32);
  }
  function playSnare(t: number) {
    const a = ctx();
    const buf = a.createBuffer(1, a.sampleRate * 0.12, a.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
    const noise = a.createBufferSource(); noise.buffer = buf;
    const bp = a.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1800; bp.Q.value = 1.2;
    const g = a.createGain();
    g.gain.setValueAtTime(0.36, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
    noise.connect(bp).connect(g).connect(a.destination);
    noise.start(t); noise.stop(t + 0.2);
  }
  function playBell(t: number) {
    const a = ctx();
    const freqs = [1320, 2640, 3960];
    const gains = [0.16, 0.09, 0.05];
    freqs.forEach((f, i) => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(gains[i], t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.0);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 1.1);
    });
  }
  const PLAYERS: Record<string, (t: number) => void> = {
    kick: playKick, snare: playSnare, bell: playBell,
  };

  function nounFlash(cls: string) {
    if (!noun) return;
    noun.classList.remove('msw__noun--kick', 'msw__noun--snare', 'msw__noun--bell');
    void (noun as HTMLElement).offsetWidth;
    noun.classList.add(cls);
    setTimeout(() => noun.classList.remove(cls), 110);
  }

  function paintActiveCells(step: number) {
    cells.forEach((cell) => {
      cell.dataset.active = String(Number(cell.dataset.step) === step);
    });
  }

  let timer: number | null = null;
  let step = 0;
  let bpm = 90;
  let playing = false;

  function setTempo(newBpm: number) {
    bpm = Math.max(60, Math.min(140, newBpm));
    if (tempoReadout) tempoReadout.textContent = `${bpm} bpm`;
    if (bpmReadout) bpmReadout.textContent = `${bpm} bpm`;
    if (stage) {
      // Walking-speed durations scale inversely with BPM.
      // At 90 BPM: fg=7s, mid=14s, bg=26s. Scale: 90/bpm.
      const scale = 90 / bpm;
      (stage as HTMLElement).style.setProperty('--fg-dur',  `${(7  * scale).toFixed(2)}s`);
      (stage as HTMLElement).style.setProperty('--mid-dur', `${(14 * scale).toFixed(2)}s`);
      (stage as HTMLElement).style.setProperty('--bg-dur',  `${(26 * scale).toFixed(2)}s`);
    }
    if (playing) {
      if (timer != null) clearInterval(timer);
      timer = window.setInterval(tick, stepMs());
    }
  }
  function stepMs(): number { return (60 / bpm) * 1000; } // quarter note per step

  function tick() {
    const t = ctx().currentTime + 0.02;
    paintActiveCells(step);
    if (stepReadout) stepReadout.textContent = `${step + 1} / 4`;
    Object.entries(pattern).forEach(([inst, pat]) => {
      if (pat[step]) {
        try { PLAYERS[inst](t); } catch {}
        nounFlash(`msw__noun--${inst}`);
      }
    });
    step = (step + 1) % 4;
  }

  function start() {
    if (playing) return;
    ctx();
    playing = true;
    step = 0;
    if (stage) (stage as HTMLElement).dataset.state = 'playing';
    if (toggleBtn) toggleBtn.textContent = '■ STOP';
    tick();
    timer = window.setInterval(tick, stepMs());
  }
  function stop() {
    if (!playing) return;
    playing = false;
    if (timer != null) { clearInterval(timer); timer = null; }
    if (stage) (stage as HTMLElement).dataset.state = 'paused';
    if (toggleBtn) toggleBtn.textContent = '▶ TAP TO START';
    paintActiveCells(-1);
    if (stepReadout) stepReadout.textContent = '— / 4';
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => { playing ? stop() : start(); });
  }
  if (tempoEl) {
    tempoEl.addEventListener('input', (e) => {
      const v = Number((e.target as HTMLInputElement).value);
      setTempo(v);
    });
  }
  setTempo(90);
</script>
