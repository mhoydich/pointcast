---
/**
 * /ten-doors — the hallway for ten new PointCast areas opened 2026-11-02.
 * Michael Hoydich asked for "10 new pointcast areas, drum etc, be inventive";
 * Claude Code built them. The list is src/lib/ten-doors.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { DOORS, SITE, TEN_DOORS_DATE } from '../lib/ten-doors.mjs';

const title = 'Ten Doors';
const description = 'Ten new PointCast areas, all free in the browser: an organ played by LAX departures, a refinery skyline drum machine, a kite in the sea breeze, a parking meter oracle, a drum round with the house agents, a pelican that carries worries out to sea, a green flash timing game, sidewalk chalk that sings, an ice cream truck route and a daily tide pool census.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/ten-doors#hub`,
      name: title,
      description,
      url: `${SITE}/ten-doors`,
      datePublished: TEN_DOORS_DATE,
      inLanguage: 'en-US',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#site`, name: 'PointCast', url: `${SITE}/` },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: DOORS.length,
        itemListElement: DOORS.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name, url: `${SITE}/${d.slug}`, description: d.pitch })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Ten Doors', item: `${SITE}/ten-doors` },
      ],
    },
  ],
};
---

<BlockLayout
  title={title}
  description={description}
  themeColor="#1d1410"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/ten-doors.json', title: 'Ten Doors (JSON)' }]}
>
  <div class="tdh">
    <nav class="tdh-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Ten Doors</span></nav>
    <header>
      <p class="tdh-kicker">New in town · {TEN_DOORS_DATE}</p>
      <h1>Ten Doors</h1>
      <p class="tdh-lede">Ten new rooms off the PointCast hallway. Four instruments, four games, an oracle and a quiet place. Most of them could only be here: the departures, the refinery lights, the sea breeze, the meters on Main Street, the sunset into the bay.</p>
      <p class="tdh-small">Everything plays in the browser, with sound made on the spot. No account, nothing to buy. These room tools do not upload cards, drawings, patterns or scores. Site Room presence shares cursors and chat when you turn it on. Agents get a JSON door for each.</p>
    </header>
    <ol class="tdh-grid">
      {DOORS.map((d, i) => (
        <li>
          <a href={`/${d.slug}`} style={`--c:${d.color};--i:${d.ink}`}>
            <span class="tdh-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="tdh-k">{d.kicker}</span>
            <strong>{d.name}</strong>
            <span class="tdh-p">{d.pitch}</span>
          </a>
          <a class="tdh-json" href={`/${d.slug}.json`}>/{d.slug}.json</a>
        </li>
      ))}
    </ol>
    <p class="tdh-small">Asked for by Michael Hoydich ("make 10 new pointcast areas, drum etc, be inventive"). Built by Claude Code. Original rules, art drawn in code. <a href="/drum">The Drum house</a> · <a href="/play">Play</a> · <a href="/for-agents">For agents</a> · <a href="/ten-doors.json">Hub JSON</a></p>
  </div>
</BlockLayout>

<style>
  .tdh { max-width: 1080px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  .tdh-crumb { display: flex; gap: 0.45rem; font: 0.8rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: #666; margin-bottom: 1rem; }
  .tdh-crumb a { color: inherit; }
  .tdh-kicker { font: 600 0.8rem ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: 0.1em; color: #6b5040; margin: 0; }
  h1 { font-size: clamp(2.6rem, 9vw, 5rem); line-height: 0.95; margin: 0.3rem 0 0.8rem; letter-spacing: -0.03em; }
  .tdh-lede { font-size: 1.2rem; line-height: 1.5; max-width: 46rem; margin: 0 0 0.6rem; }
  .tdh-small { font-size: 0.9rem; line-height: 1.5; color: #555; max-width: 46rem; }
  .tdh-grid { list-style: none; padding: 0; margin: 1.6rem 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.9rem; }
  .tdh-grid li { display: flex; flex-direction: column; gap: 0.3rem; }
  .tdh-grid a:first-child { display: flex; flex-direction: column; gap: 0.35rem; min-height: 12rem; padding: 1rem 1.1rem; border-radius: 18px; background: var(--c); color: var(--i); text-decoration: none; box-shadow: 0 10px 24px rgb(0 0 0 / 0.14); transition: transform 0.15s ease; }
  .tdh-grid a:first-child:hover, .tdh-grid a:first-child:focus-visible { transform: translateY(-3px); }
  .tdh-num { font: 700 0.85rem ui-monospace, monospace; opacity: 0.7; }
  .tdh-k { font: 600 0.72rem ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85; }
  .tdh-grid strong { font-size: 1.5rem; line-height: 1.1; }
  .tdh-p { font-size: 0.92rem; line-height: 1.4; }
  .tdh-json { font: 0.75rem ui-monospace, monospace; color: #6b5040; padding-left: 0.4rem; }
  @media (prefers-reduced-motion: reduce) { .tdh-grid a:first-child { transition: none; } }
</style>
