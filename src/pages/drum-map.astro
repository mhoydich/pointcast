---
/**
 * /drum-map — visual atlas of all drum surfaces.
 *
 * Mike 2026-05-08: "fresh batch of ideas" → "yep go." 3 of 3.
 *
 * Drum hub now has 20+ surfaces. The map gives visitors one place to
 * see them all. Pixel-art card grid grouped by category. Each card
 * shows a representative Noun + name + one-line tagline + path. Click
 * any card to teleport.
 *
 * Aesthetic: warm cream background, brass-and-velvet card chrome,
 * chunky pixel Nouns. Iso-perspective optional; for v1 it's a clean
 * sectioned grid with category headers.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Drum Hub Map · 20+ drum surfaces in one place · PointCast';
const description = 'Visual atlas of every Noun-drum surface in the hub. Click any tile to teleport.';

const SECTIONS = [
  {
    title: 'PERFORM · solo + small',
    sub: 'one or a few nouns play at you',
    cards: [
      { url: '/drum-solo-jam',         name: 'Solo Jam',           noun: 523,  tag: 'one noun, 90 BPM groove' },
      { url: '/drum-ambient-noun',     name: 'Ambient Noun',       noun: 1042, tag: 'slow sway · pad + bell' },
      { url: '/noun-walks-main-street',name: 'Main Street Walk',   noun: 742,  tag: 'noun walks · drum-driven footsteps' },
    ],
  },
  {
    title: 'PERFORM · ensemble',
    sub: 'several nouns play together',
    cards: [
      { url: '/drum-quintet',          name: 'Quintet',            noun: 1189, tag: 'five seats · pick + pattern' },
      { url: '/drum-nouns-concert',    name: 'Nouns Concert',      noun: 313,  tag: '5 nouns stationary · full band' },
      { url: '/drum-parade',           name: 'Noun Parade',        noun: 287,  tag: '6 nouns walking polyphonically' },
    ],
  },
  {
    title: 'DISCOVER',
    sub: 'pick + listen',
    cards: [
      { url: '/drum-radio',            name: 'Drum Radio',         noun: 928,  tag: 'live event-driven station' },
      { url: '/drum-noun-radio',       name: 'Noun Radio Station', noun: 612,  tag: 'auto-DJ · 6 preset tracks' },
      { url: '/drum-jukebox',          name: 'Noun Jukebox',       noun: 1084, tag: '9-tile picker grid' },
    ],
  },
  {
    title: 'PRESENCE · the wing',
    sub: 'shared chamber surfaces',
    cards: [
      { url: '/drum-room',             name: 'The Wing Room',      noun: 742,  tag: 'tap to ring · others hear' },
      { url: '/drum-altars',           name: 'Altars',             noun: 1042, tag: 'weekly tributes · candle ring' },
      { url: '/drum-procession',       name: 'Procession',         noun: 523,  tag: 'collective step count' },
      { url: '/drum-offering',         name: 'Offerings',          noun: 313,  tag: 'visitor intentions archive' },
    ],
  },
  {
    title: 'COMPETE · async',
    sub: 'two nouns, one outcome',
    cards: [
      { url: '/drum-duel',             name: 'Duel',               noun: 612,  tag: '1v1 tap race · 20 seconds' },
      { url: '/drum-beat-battle',      name: 'Beat Battle',        noun: 1189, tag: '4-bar phrases · audience votes' },
    ],
  },
  {
    title: 'CANVAS · collective',
    sub: 'add to a shared thing',
    cards: [
      { url: '/drum-warhol-live',      name: 'Warhol Wall',        noun: 1042, tag: '24-tile shared pop-art wall' },
      { url: '/drum-relay-2',          name: 'Relay Chain',        noun: 287,  tag: '3-tap fragments make 12-link chain' },
      { url: '/noun-loom',             name: 'Noun Loom',          noun: 928,  tag: 'plant nouns · each is a drone' },
    ],
  },
  {
    title: 'COMPOSE · roll your own',
    sub: 'tools that produce a thing',
    cards: [
      { url: '/drum-looper',           name: 'Noun Looper',        noun: 523,  tag: '16-step overdub recorder · share URL' },
      { url: '/noun-cinema',           name: 'Noun Cinema',        noun: 313,  tag: 'silent film in 4 scenes' },
    ],
  },
];
---

<BlockLayout title={title} description={description}>
  <main class="dmap">
    <header class="dmap__header">
      <h1 class="dmap__title">DRUM HUB MAP</h1>
      <p class="dmap__tag">{SECTIONS.reduce((n, s) => n + s.cards.length, 0)} surfaces · click any tile to teleport</p>
    </header>

    {SECTIONS.map((sec) => (
      <section class="dmap__section">
        <header class="dmap__sec-head">
          <h2 class="dmap__sec-title">{sec.title}</h2>
          <p class="dmap__sec-sub">{sec.sub}</p>
        </header>
        <div class="dmap__grid">
          {sec.cards.map((c) => (
            <a class="dmap__tile" href={c.url}>
              <div class="dmap__tile-frame">
                <img class="dmap__noun" src={`https://noun.pics/${c.noun}.svg`} alt="" width="70" height="70" loading="lazy"/>
              </div>
              <div class="dmap__tile-meta">
                <span class="dmap__tile-name">{c.name}</span>
                <span class="dmap__tile-url">{c.url}</span>
                <span class="dmap__tile-tag">{c.tag}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="dmap__siblings">
      <a href="/scorebook">/scorebook · machine-readable</a>
      <a href="/scorebook.json">/scorebook.json</a>
      <a href="/wire">/wire · publishing log</a>
    </section>
  </main>
</BlockLayout>

<style>
  .dmap { max-width: 1200px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #1a0820; background: #fffaf0; min-height: 100vh; }
  .dmap__header { text-align: center; margin: 18px 0 22px; }
  .dmap__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 72px); letter-spacing: 0.16em; margin: 0; text-shadow: 2px 2px 0 rgba(212, 164, 55, 0.40); }
  .dmap__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #5a3422; opacity: 0.85; margin: 6px 0 0; }

  .dmap__section { margin: 22px 0; }
  .dmap__sec-head { padding: 8px 0 10px; border-bottom: 2px solid #1a0820; margin-bottom: 12px; display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .dmap__sec-title { font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; letter-spacing: 0.24em; margin: 0; color: #1a0820; font-weight: 800; }
  .dmap__sec-sub { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.10em; margin: 0; color: #5a3422; opacity: 0.85; }

  .dmap__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
  .dmap__tile { display: grid; grid-template-columns: 84px 1fr; gap: 12px; padding: 10px; align-items: center; border: 2px solid #1a0820; background: #f4e7c8; box-shadow: 4px 4px 0 0 #1a0820; text-decoration: none; transition: transform 100ms, box-shadow 100ms, background 100ms; }
  .dmap__tile:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 0 #1a0820; background: #f6c15e; text-decoration: none; }
  .dmap__tile:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 #1a0820; }
  .dmap__tile-frame { width: 84px; height: 84px; border: 2px solid #1a0820; background: #fffaf0; padding: 6px; display: flex; align-items: center; justify-content: center; }
  .dmap__noun { width: 70px; height: 70px; image-rendering: pixelated; filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.20)); }
  .dmap__tile-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dmap__tile-name { font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; font-weight: 800; letter-spacing: 0.06em; color: #1a0820; }
  .dmap__tile-url { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.10em; color: #b8431a; }
  .dmap__tile-tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.04em; color: #5a3422; opacity: 0.85; line-height: 1.3; }

  .dmap__siblings { display: flex; justify-content: center; gap: 14px; margin-top: 28px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .dmap__siblings a { color: #5a3422; text-decoration: none; }
  .dmap__siblings a:hover { color: #1a0820; text-decoration: underline; }
</style>
