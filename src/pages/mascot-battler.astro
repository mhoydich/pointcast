---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  MASCOT_ARENAS,
  MASCOT_BATTLER,
  MASCOT_CARDS,
  MASCOT_CLASSES,
  MASCOT_CONFERENCES,
} from '../lib/mascot-battler';

const description =
  'Explore 25 college-football mascot cards, their local resources and traditions, then battle a conference deck against a creature class in three deterministic rounds.';

const cardPayload = MASCOT_CARDS.map((card) => ({
  slug: card.slug,
  school: card.school,
  short: card.short,
  conference: card.conference,
  mascot: card.mascot,
  mascotClass: card.mascotClass,
  className: card.className,
  rank: card.rank,
  accent: card.accent,
  art: card.art,
  locality: card.locality,
  legacy: card.legacy,
  myth: card.myth,
  balance: card.balance,
  form: card.form,
  ability: card.ability,
  localResource: card.localResource,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${MASCOT_BATTLER.canonical}#game`,
      name: MASCOT_BATTLER.title,
      description,
      url: MASCOT_BATTLER.canonical,
      image: 'https://pointcast.xyz/images/og/b/0522.png',
      applicationCategory: 'BrowserGame',
      gamePlatform: 'Web browser',
      playMode: 'SinglePlayer',
      numberOfPlayers: 1,
      author: {
        '@type': 'Organization',
        name: 'PointCast',
        url: 'https://pointcast.xyz',
      },
    },
    {
      '@type': 'Dataset',
      '@id': `${MASCOT_BATTLER.canonical}.json#dataset`,
      name: 'PointCast Mascot Atlas — Board 000',
      description:
        'Twenty-five unofficial editorial mascot cards with conference, creature class, locality, tradition, current PointCast rank, five game stats, original art family, and official athletics source.',
      url: MASCOT_BATTLER.machineEdition,
      creator: {
        '@type': 'Organization',
        name: 'PointCast',
      },
      temporalCoverage: '2026',
      spatialCoverage: 'United States',
      license: 'https://creativecommons.org/licenses/by/4.0/',
    },
  ],
};
---

<BlockLayout
  title="Saturday Myth Machine — College Football Mascot Card Battler"
  description={description}
  image="/images/og/b/0522.png"
  themeColor="#e8ff3f"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
  alternates={[
    {
      type: 'application/json',
      href: '/mascot-battler.json',
      title: 'Mascot Atlas and Battler JSON',
    },
  ]}
>
  <main class="machine" id="main-content">
    <header class="mast">
      <a class="brand" href="/">POINTCAST</a>
      <nav aria-label="Mascot Battler navigation">
        <a href="#battle">Battle</a>
        <a href="#atlas">Atlas</a>
        <a href="/25">The 25</a>
        <a href="/mascot-battler.json">JSON</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="myth-title">
      <div class="hero__copy">
        <p class="kicker">POINTCAST 25 · BOARD {MASCOT_BATTLER.board} · UNOFFICIAL FIELD GUIDE</p>
        <h1 id="myth-title">SATURDAY<br /><em>MYTH</em><br />MACHINE</h1>
        <p class="hero__dek">
          Twenty-five schools. Eight creature families. Every mascot gets a place,
          a past, a current argument, and one gloriously debatable card.
        </p>
        <div class="hero__actions">
          <a href="#battle">Start a clash ↓</a>
          <button type="button" data-copy-page>Copy the game ↗</button>
        </div>
        <dl class="hero__stats">
          <div><dt>Cards</dt><dd>{MASCOT_BATTLER.cardCount}</dd></div>
          <div><dt>Classes</dt><dd>{MASCOT_BATTLER.classCount}</dd></div>
          <div><dt>Rounds</dt><dd>03</dd></div>
          <div><dt>Price</dt><dd>FREE</dd></div>
        </dl>
      </div>
      <div class="hero__plates" aria-label="Four original mascot field plates">
        {MASCOT_CLASSES.slice(0, 4).map((type) => (
          <figure style={`--plate:${type.color}`}>
            <img src={type.art} alt={`Original ${type.name} mascot-class field illustration`} />
            <figcaption>{type.name} · {type.fieldName}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="battle" id="battle" aria-labelledby="battle-title">
      <div class="section-head">
        <div>
          <p class="label">THE SATURDAY LAB</p>
          <h2 id="battle-title">Conference<br />vs. creature.</h2>
        </div>
        <p>
          The left deck draws from one conference. The right deck draws from one
          mascot class. Three rounds score place, lore, and Saturday force.
          Same choices, same arena, same result—until you turn the weather.
        </p>
      </div>

      <div class="console" data-battle-console>
        <div class="console__controls">
          <label>
            <span>01 · CONFERENCE DECK</span>
            <select data-conference>
              {MASCOT_CONFERENCES.map((conference) => (
                <option value={conference} selected={conference === 'SEC'}>{conference}</option>
              ))}
            </select>
          </label>
          <div class="versus" aria-hidden="true">VS</div>
          <label>
            <span>02 · CREATURE DECK</span>
            <select data-class>
              {MASCOT_CLASSES.map((type) => (
                <option value={type.id} selected={type.id === 'aerial'}>{type.name}</option>
              ))}
            </select>
          </label>
          <label>
            <span>03 · ARENA</span>
            <select data-arena>
              {MASCOT_ARENAS.map((arena) => (
                <option value={arena.id} selected={arena.id === 'night'}>{arena.name}</option>
              ))}
            </select>
          </label>
          <button class="fight" type="button" data-fight>
            RUN THREE ROUNDS ↯
          </button>
        </div>

        <div class="scoreboard">
          <div class="scoreboard__headline">
            <div>
              <small data-left-label>SEC</small>
              <strong data-left-score>0</strong>
            </div>
            <p data-battle-status aria-live="polite">THE FIELD IS WAITING.</p>
            <div>
              <small data-right-label>AERIAL</small>
              <strong data-right-score>0</strong>
            </div>
          </div>
          <ol class="rounds" data-rounds>
            <li><span>01 · PLACE</span><p>Local resources meet arena weather.</p></li>
            <li><span>02 · LORE</span><p>Tradition and creature myth get a vote.</p></li>
            <li><span>03 · SATURDAY</span><p>Current form, legacy, and balance close it.</p></li>
          </ol>
          <div class="winner" data-winner hidden>
            <img data-winner-art src="/images/mascot-battler/type-null.png" alt="" />
            <div>
              <span>FIELD MVP</span>
              <strong data-winner-name></strong>
              <p data-winner-note></p>
              <a data-winner-link href="#atlas">Open the card →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="rule-strip">
        {MASCOT_BATTLER.rules.map((rule, index) => (
          <p><span>{String(index + 1).padStart(2, '0')}</span>{rule}</p>
        ))}
      </div>
    </section>

    <section class="classes" aria-labelledby="class-title">
      <div class="section-head section-head--light">
        <div>
          <p class="label">THE CREATURE FAMILIES</p>
          <h2 id="class-title">Eight ways<br />to be strange.</h2>
        </div>
        <p>
          The illustrations are original archetype plates—not reproductions of
          school logos or official costume designs. The school facts live in HTML;
          the pictures establish a shared collectible ecology.
        </p>
      </div>
      <div class="class-grid">
        {MASCOT_CLASSES.map((type, index) => (
          <article style={`--class:${type.color}`}>
            <img src={type.art} alt={`Original ${type.name} creature-family field plate`} loading="lazy" />
            <div>
              <span>{String(index + 1).padStart(2, '0')} · {type.name}</span>
              <h3>{type.fieldName}</h3>
              <p>{type.instinct}</p>
              <small>STRONG AGAINST · {type.strongAgainst.toUpperCase()}</small>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas" id="atlas" aria-labelledby="atlas-title">
      <div class="section-head">
        <div>
          <p class="label">THE MASCOT ATLAS · 25 CARDS</p>
          <h2 id="atlas-title">Place is<br />a stat.</h2>
        </div>
        <div class="atlas__intro">
          <p>
            Locality measures how specifically a mascot belongs to its home.
            Legacy measures accumulated football memory. Myth measures symbolic
            force. Form comes from current PointCast Board 000 rank. Balance keeps
            every card playable.
          </p>
          <p class="collection-line">
            <strong data-collection-count>0</strong> cards kept in this browser.
          </p>
        </div>
      </div>

      <div class="filters" aria-label="Filter mascot atlas">
        <button type="button" data-filter-kind="all" aria-pressed="true">ALL 25</button>
        {MASCOT_CONFERENCES.map((conference) => (
          <button type="button" data-filter-kind="conference" data-filter-value={conference} aria-pressed="false">
            {conference}
          </button>
        ))}
        {MASCOT_CLASSES.map((type) => (
          <button type="button" data-filter-kind="class" data-filter-value={type.id} aria-pressed="false">
            {type.name}
          </button>
        ))}
      </div>

      <div class="card-grid" data-card-grid>
        {MASCOT_CARDS.map((card) => (
          <article
            class="school-card"
            data-card={card.slug}
            data-conference={card.conference}
            data-class={card.mascotClass}
            style={`--team:${card.accent}`}
          >
            <div class="school-card__image">
              <img src={card.art} alt={`Original ${card.className} field illustration for the ${card.school} card`} loading="lazy" />
              <span>#{String(card.rank).padStart(2, '0')}</span>
              <small>{card.className}</small>
            </div>
            <div class="school-card__body">
              <p>{card.conference} · {card.city}, {card.state}</p>
              <h3>{card.school}</h3>
              <strong>{card.mascot}</strong>
              <dl>
                <div><dt>LOC</dt><dd>{card.locality}</dd></div>
                <div><dt>LEG</dt><dd>{card.legacy}</dd></div>
                <div><dt>MYT</dt><dd>{card.myth}</dd></div>
                <div><dt>FRM</dt><dd>{card.form}</dd></div>
                <div><dt>BAL</dt><dd>{card.balance}</dd></div>
              </dl>
              <p class="ability"><span>{card.ability}</span>{card.abilityText}</p>
              <p class="resource">{card.localResource}</p>
              <div class="school-card__actions">
                <a href={`/mascot-battler/${card.slug}`}>Open field card →</a>
                <button type="button" data-keep-card={card.slug}>Keep +</button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="boundary" aria-labelledby="boundary-title">
      <div>
        <p class="label">THE BORING BUT IMPORTANT PART</p>
        <h2 id="boundary-title">Unofficial.<br />Opinionated.<br />No wagers.</h2>
      </div>
      <div>
        <p>{MASCOT_BATTLER.boundary}</p>
        <p>
          Mascot identities and tradition notes link to official athletics sources
          on each school card. Game stats are PointCast editorial numbers made for
          this toy. They are not institutional rankings, animal claims, or measures
          of the students who perform mascot roles.
        </p>
        <nav aria-label="Mascot Battler reference links">
          <a href="/mascot-battler.json">Download the atlas JSON</a>
          <a href="/25">Read 25 For Reasons</a>
          <a href="/noun-battler-annual">Visit The Battle Record</a>
        </nav>
      </div>
    </section>

    <footer>
      <strong>SATURDAY MYTH MACHINE</strong>
      <span>POINTCAST · EL SEGUNDO · 2026</span>
      <a href="#main-content">Back to kickoff ↑</a>
    </footer>
  </main>

  <script
    id="mascot-card-data"
    type="application/json"
    set:html={JSON.stringify({
      cards: cardPayload,
      classes: MASCOT_CLASSES,
      arenas: MASCOT_ARENAS,
    })}
  ></script>

  <script is:inline>
    (() => {
      const root = document.querySelector('.machine');
      const payload = JSON.parse(document.querySelector('#mascot-card-data')?.textContent || '{}');
      if (!root || !Array.isArray(payload.cards)) return;

      const cards = payload.cards;
      const classes = new Map(payload.classes.map((entry) => [entry.id, entry]));
      const arenas = new Map(payload.arenas.map((entry) => [entry.id, entry]));
      const conferenceSelect = root.querySelector('[data-conference]');
      const classSelect = root.querySelector('[data-class]');
      const arenaSelect = root.querySelector('[data-arena]');
      const fightButton = root.querySelector('[data-fight]');
      const roundsEl = root.querySelector('[data-rounds]');
      const statusEl = root.querySelector('[data-battle-status]');
      const leftScoreEl = root.querySelector('[data-left-score]');
      const rightScoreEl = root.querySelector('[data-right-score]');
      const leftLabelEl = root.querySelector('[data-left-label]');
      const rightLabelEl = root.querySelector('[data-right-label]');
      const winnerEl = root.querySelector('[data-winner]');
      const hash = (value) => Array.from(value).reduce((total, character) => {
        return ((total << 5) - total + character.charCodeAt(0)) | 0;
      }, 0);

      const pick = (deck, round, seed) => {
        if (!deck.length) return null;
        return deck[Math.abs(seed + round * 7) % deck.length];
      };

      const classEdge = (attacker, defender) => {
        if (attacker.mascotClass === 'null' || defender.mascotClass === 'null') return 0;
        const attackClass = classes.get(attacker.mascotClass);
        const defendClass = classes.get(defender.mascotClass);
        if (attackClass?.strongAgainst === defender.mascotClass) return 7;
        if (defendClass?.strongAgainst === attacker.mascotClass) return -7;
        return 0;
      };

      const arenaBonus = (card, arena) => arena?.favored?.includes(card.mascotClass) ? 8 : 0;

      const roundScore = (card, opponent, round, arena, deckBonus) => {
        const base = round === 0
          ? card.locality + Math.round(card.balance / 5)
          : round === 1
            ? card.myth + Math.round(card.legacy / 6)
            : card.form + Math.round(card.balance / 4) + Math.round(card.legacy / 8);
        let total = base + arenaBonus(card, arena) + classEdge(card, opponent) + deckBonus;
        if (card.slug === 'alabama' && round === 1) total = Math.max(total, 105);
        if (card.slug === 'boise-state' && card.rank > opponent.rank) total += 11;
        if (card.slug === 'south-carolina' && arena?.id === 'heat') total += 5;
        if (card.slug === 'michigan') total += 4;
        return total;
      };

      const renderBattle = () => {
        const conference = conferenceSelect?.value;
        const classId = classSelect?.value;
        const arena = arenas.get(arenaSelect?.value);
        const leftDeck = cards.filter((card) => card.conference === conference);
        const rightDeck = cards.filter((card) => card.mascotClass === classId);
        if (!leftDeck.length || !rightDeck.length || !arena) return;

        const seed = hash(`${conference}:${classId}:${arena.id}`);
        const roundNames = ['PLACE', 'LORE', 'SATURDAY'];
        let leftWins = 0;
        let rightWins = 0;
        const appearances = [];
        const roundMarkup = roundNames.map((roundName, round) => {
          const left = pick(leftDeck, round, seed);
          const rightChoices = rightDeck.filter((card) => card.slug !== left.slug);
          const right = pick(rightChoices.length ? rightChoices : rightDeck, round, seed + 11);
          const leftScore = roundScore(left, right, round, arena, 4);
          const rightScore = roundScore(right, left, round, arena, 4);
          appearances.push({ card: left, score: leftScore }, { card: right, score: rightScore });
          let result = 'TIE';
          if (leftScore > rightScore) { leftWins += 1; result = conference; }
          if (rightScore > leftScore) { rightWins += 1; result = classes.get(classId)?.name || classId; }
          if (leftScore === rightScore && (left.slug === 'south-carolina' || right.slug === 'south-carolina')) {
            const cockyLeft = left.slug === 'south-carolina';
            leftWins += cockyLeft ? 1 : 0;
            rightWins += cockyLeft ? 0 : 1;
            result = cockyLeft ? conference : classes.get(classId)?.name || classId;
          }
          return `
            <li class="${leftScore === rightScore ? 'is-tie' : ''}">
              <span>0${round + 1} · ${roundName}</span>
              <div>
                <a href="/mascot-battler/${left.slug}">${left.school}</a>
                <strong>${leftScore}</strong>
              </div>
              <small>${arena.name} · ${result} TAKES IT</small>
              <div>
                <strong>${rightScore}</strong>
                <a href="/mascot-battler/${right.slug}">${right.school}</a>
              </div>
            </li>
          `;
        }).join('');

        const leftWon = leftWins > rightWins;
        const tie = leftWins === rightWins;
        const winningSide = tie ? 'DRAW' : leftWon ? conference : classes.get(classId)?.name || classId;
        const winningCards = appearances
          .filter((entry) => tie || (leftWon ? leftDeck.includes(entry.card) : rightDeck.includes(entry.card)))
          .sort((a, b) => b.score - a.score);
        const mvp = winningCards[0]?.card || appearances[0].card;

        roundsEl.innerHTML = roundMarkup;
        leftScoreEl.textContent = String(leftWins);
        rightScoreEl.textContent = String(rightWins);
        leftLabelEl.textContent = conference.toUpperCase();
        rightLabelEl.textContent = (classes.get(classId)?.name || classId).toUpperCase();
        statusEl.textContent = tie
          ? `${arena.name.toUpperCase()} PRODUCES A DRAW. RUN IT BACK.`
          : `${winningSide.toUpperCase()} WINS ${Math.max(leftWins, rightWins)}–${Math.min(leftWins, rightWins)}.`;
        winnerEl.hidden = false;
        winnerEl.querySelector('[data-winner-art]').src = mvp.art;
        winnerEl.querySelector('[data-winner-art]').alt = `${mvp.school} ${mvp.className} field card`;
        winnerEl.querySelector('[data-winner-name]').textContent = `${mvp.school} · ${mvp.mascot}`;
        winnerEl.querySelector('[data-winner-note]').textContent = `${mvp.ability}: ${mvp.localResource}`;
        winnerEl.querySelector('[data-winner-link]').href = `/mascot-battler/${mvp.slug}`;
      };

      fightButton?.addEventListener('click', renderBattle);

      const storageKey = 'pc:mascot-atlas:cards';
      const readCollection = () => {
        try {
          const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
          return Array.isArray(value) ? value.filter((slug) => typeof slug === 'string') : [];
        } catch {
          return [];
        }
      };

      const updateCollection = () => {
        const kept = new Set(readCollection());
        root.querySelectorAll('[data-keep-card]').forEach((button) => {
          const isKept = kept.has(button.dataset.keepCard);
          button.textContent = isKept ? 'Kept ✓' : 'Keep +';
          button.setAttribute('aria-pressed', String(isKept));
        });
        const count = root.querySelector('[data-collection-count]');
        if (count) count.textContent = String(kept.size);
      };

      root.querySelectorAll('[data-keep-card]').forEach((button) => {
        button.addEventListener('click', () => {
          const slug = button.dataset.keepCard;
          const kept = new Set(readCollection());
          kept.has(slug) ? kept.delete(slug) : kept.add(slug);
          localStorage.setItem(storageKey, JSON.stringify(Array.from(kept)));
          updateCollection();
        });
      });
      updateCollection();

      const filterButtons = Array.from(root.querySelectorAll('[data-filter-kind]'));
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const kind = button.dataset.filterKind;
          const value = button.dataset.filterValue;
          filterButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          root.querySelectorAll('[data-card]').forEach((card) => {
            card.hidden = kind === 'conference'
              ? card.dataset.conference !== value
              : kind === 'class'
                ? card.dataset.class !== value
                : false;
          });
        });
      });

      const copyButton = root.querySelector('[data-copy-page]');
      copyButton?.addEventListener('click', async () => {
        const copy = 'Saturday Myth Machine: 25 college-football mascot cards, eight creature families, and a conference-vs-type battler. https://pointcast.xyz/mascot-battler';
        const original = copyButton.textContent;
        try {
          await navigator.clipboard.writeText(copy);
          copyButton.textContent = 'Copied ✓';
        } catch {
          copyButton.textContent = 'Copy unavailable';
        }
        window.setTimeout(() => { copyButton.textContent = original; }, 1800);
      });
    })();
  </script>
</BlockLayout>

<style>
  :global(body) {
    margin: 0;
    background: #eee9dc;
    color: #111;
    font-family: var(--pc-font-sans);
  }

  :global(*) { box-sizing: border-box; }
  :global(button), :global(select) { font: inherit; }
  [hidden] { display: none !important; }

  .machine {
    min-height: 100vh;
    overflow: hidden;
  }

  .mast,
  .mast nav,
  .hero__actions,
  .hero__stats,
  .scoreboard__headline,
  .school-card__actions,
  footer {
    align-items: center;
    display: flex;
  }

  .mast {
    background: #f6f0df;
    border-bottom: 1px solid #111;
    justify-content: space-between;
    padding: 18px clamp(18px, 4vw, 64px);
  }

  .mast nav { gap: clamp(12px, 2.6vw, 34px); }
  .mast a, .brand { color: inherit; }
  .brand { font-size: 18px; font-weight: 950; text-decoration: none; }
  .mast nav a, .kicker, .label, .mast .brand, dt, .school-card__body > p:first-child,
  .school-card__image small, .class-grid span, .class-grid small, footer, .filters button,
  .console__controls span, .rounds span, .rounds small, .winner span {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(520px, 1.1fr);
    min-height: 88vh;
  }

  .hero__copy {
    background: #121a2b;
    color: #f7f1df;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(54px, 8vw, 130px) clamp(22px, 6vw, 96px);
  }

  .kicker { color: #e8ff3f; margin: 0 0 48px; }
  .hero h1, .section-head h2 {
    font-size: clamp(68px, 7.5vw, 136px);
    letter-spacing: -.085em;
    line-height: .72;
    margin: 0;
    text-transform: uppercase;
  }
  .hero h1 em { color: #e8ff3f; font-style: normal; }
  .hero__dek {
    font-size: clamp(22px, 2.4vw, 38px);
    letter-spacing: -.035em;
    line-height: 1.08;
    margin: 54px 0 34px;
    max-width: 760px;
  }
  .hero__actions { gap: 12px; flex-wrap: wrap; }
  .hero__actions a, .hero__actions button, .fight {
    background: #e8ff3f;
    border: 1px solid #111;
    border-radius: 999px;
    color: #111;
    cursor: pointer;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .08em;
    padding: 14px 19px;
    text-decoration: none;
