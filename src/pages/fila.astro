---
import FilaLayout from '../layouts/FilaLayout.astro';
import FilaLookbook from '../components/fila/FilaLookbook.astro';
import { SOURCES, TIMELINE, sourceFor } from '../data/fila-study';
import rights from '../../docs/research/fila-image-rights.json';
const portrait = rights.images.find(image => image.id === 'borg-1978')!;
const landscape = rights.images.find(image => image.id === 'borg-1975')!;
const seles = rights.images.find(image => image.id === 'seles-circa-1991')!;
const goerges = rights.images.find(image => image.id === 'goerges-2014')!;
---
<FilaLayout title="FILA / From thread to court to culture" description="An illustrated FILA brand exhibition: Italian textile origins, tennis design, global eras and twelve independently imagined 2027 looks. Sources and image credits included.">
  <section class="hero reveal" aria-labelledby="exhibition-title">
    <div class="section-label"><span>POINTCAST BRAND STUDY / 01</span><span>1911 → 2027</span></div>
    <h1 id="exhibition-title"><span class="hero-name">FILA</span><span class="hero-subtitle">From thread<br /> to court<br /> <em>to culture.</em></span></h1>
    <div class="hero-caption"><p>An Italian beginning.<br />A line the world learned to read.</p><a href="/fila/2027/">Enter the 2027 lookbook <span aria-hidden="true">↗</span></a></div>
    <figure class="hero-art"><img src="/images/fila/court-material-study.webp" width="1600" height="900" fetchpriority="high" alt="Original interpretive artwork of a clay tennis court, cream rib-knit drape, navy plinth and suspended ivory tennis ball." /><figcaption>COURT / MATERIAL STUDY · Original AI-generated interpretive artwork, 2026. Not an archival FILA photograph.</figcaption></figure>
  </section>
  <section class="local-edition" aria-labelledby="local-edition-title"><a class="local-edition-image" href="/fila/el-segundo/"><img src="/images/fila-el-segundo/courtyard-hero.webp" width="1672" height="941" loading="lazy" alt="Original AI-generated campaign concept for the independent El Segundo collection." /></a><div><p class="eyebrow">NEW CHAPTER / INDEPENDENT EL SEGUNDO V2</p><h2 id="local-edition-title">Let the town<br />change the <em>line.</em></h2><p>Nine new looks. Ocean blues, silver working forms and warm court-to-Main-Street utility.</p><a href="/fila/el-segundo/">Enter the El Segundo collection ↗</a><p class="local-edition-label">Original AI-generated concepts. No FILA affiliation or available inventory.</p></div></section>
  <section class="opening" aria-labelledby="opening-title"><p class="eyebrow">AN INDEPENDENT EDITORIAL EXHIBITION</p><h2 id="opening-title">Before it was a logo,<br />it was <em>a way to move.</em></h2><div><p>FILA is a useful study in how a sports brand becomes a cultural language: textile knowledge, a recognizable court silhouette, memorable athletes, regional businesses and periodic fashion reinterpretations.</p><p>This exhibition follows those layers, then asks what an independently imagined 2027 line could carry forward. The historical photographs are licensed documentary images. The artworks and future garments are clearly labeled original AI-generated interpretations.</p></div></section>
  <section class="archive-room" id="history" aria-labelledby="archive-title">
    <div class="archive-copy"><p class="eyebrow">ROOM 01 / THE LINE</p><h2 id="archive-title">The court<br />was the<br /><em>canvas.</em></h2><p>Pierluigi Rolando’s White Line made color part of tennis dress. The museum dates its launch to 1974; its BB1 pinstripe prototype to 1975. The collar, stripe and boundary between colors give the body a graphic rhythm.</p><p>Borg’s five consecutive Wimbledon singles titles, 1976–1980, made that athletic era unforgettable. Here, he is photographed in Rotterdam in 1978.</p><a class="source-link" href={sourceFor('white-line').url}>Read the museum’s White Line account ↗</a></div>
    <figure class="borg-portrait"><img src="/images/fila/borg-1978.webp" width="1600" height="2416" loading="lazy" alt={portrait.alt} /><figcaption><span>BJÖRN BORG / ROTTERDAM / 1978</span><span>Koen Suyk / Anefo, Nationaal Archief · <a href={portrait.licenseUrl}>CC0</a> · <a href={portrait.sourcePage}>Source ↗</a></span></figcaption></figure>
    <div class="archive-number" aria-hidden="true">74</div>
  </section>
  <section class="timeline-room" aria-labelledby="timeline-title"><div class="section-label"><span>ROOM 02 / THE ERAS</span><span>DATES MATTER</span></div><h2 id="timeline-title">One name.<br /><em>Several chapters.</em></h2><div class="timeline">{TIMELINE.map((era,index) => <article><span class="era-index">{String(index+1).padStart(2,'0')}</span><p class="era-date">{era.date}</p><div><h3>{era.title}</h3><p>{era.body}</p><a href={sourceFor(era.source).url}>{sourceFor(era.source).title} ↗</a>{index === 1 && <a href={sourceFor('bb1').url}>1975 BB1 record ↗</a>}{index === 7 && <><a href={sourceFor('history').url}>2025 corporate record ↗</a><a href={sourceFor('white-open').url}>2026 event announcement ↗</a></>}</div></article>)}</div></section>
  <section class="photo-salon" aria-labelledby="salon-title"><div class="section-label"><span>ROOM 03 / DATED APPEARANCES</span><span>THE ARCHIVE IN COLOR</span></div><h2 id="salon-title">Clothing remembers<br /><em>the body.</em></h2><div class="salon-grid"><figure class="salon-borg"><img src="/images/fila/borg-1975.webp" width="1600" height="1061" loading="lazy" alt={landscape.alt} /><figcaption>Borg / Rotterdam, 1 March 1975.<br />Rob Bogaerts / Anefo, Nationaal Archief · CC0. <a href={landscape.sourcePage}>Source ↗</a></figcaption></figure><figure class="salon-seles"><img src="/images/fila/seles-circa-1991.webp" width="732" height="1024" loading="lazy" alt={seles.alt} /><figcaption>Seles / San Antonio, circa 1991.<br />“img019”, C Thomas (MadMarlin) · CC BY 2.0. <a href={seles.sourcePage}>Source ↗</a></figcaption></figure><figure class="salon-goerges"><img src="/images/fila/goerges-2014.webp" width="1600" height="1135" loading="lazy" alt={goerges.alt} /><figcaption>Görges / U.S. Open, 26 August 2014.<br />Steven Pisano · CC BY 2.0. <a href={goerges.sourcePage}>Source ↗</a></figcaption></figure><div class="salon-note"><p class="eyebrow">EDITORIAL READING</p><p>A pinstripe can become a signal. A bright panel can become an era. The recognizability comes from the relationship between shape, color and the moving person.</p><p class="salon-small">These photographs document dated FILA apparel appearances. They do not imply a present-day endorsement.</p></div></div></section>
  <section class="material-room" aria-labelledby="material-title"><figure><img src="/images/fila/knit-sculpture-study.webp" width="1024" height="1536" loading="lazy" alt="Original interpretive artwork: ivory rib-knit sculpture with red and navy stripes and a tennis-racquet shadow." /><figcaption>KNIT / SCULPTURE STUDY · Original AI-generated interpretive artwork, 2026. Not a FILA archive object.</figcaption></figure><div><p class="eyebrow">A BRIDGE TO 2027</p><h2 id="material-title">Keep the<br /> rhythm.<br /> <em>Change the<br /> register.</em></h2><p>Our proposed line carries the collar, the graphic boundary and the ease of sport into three settings: the court, the club, the coast. It stretches the silhouette while keeping the visual grammar legible.</p><a class="source-link" href="/fila/2027/">Open the focused lookbook ↗</a></div></section>
  <FilaLookbook />
  <section class="genealogy" aria-labelledby="genealogy-title"><p class="eyebrow">DESIGN GENEALOGY / OUR INTERPRETATION</p><h2 id="genealogy-title">Across generations.<br /><em>Through our lens.</em></h2><div class="influence-grid"><article><span>1937 / 1949</span><h3>Geometry as structure.</h3><p>Wright’s low spatial rhythm and the Eames House’s modular construction become calm proportions and rectangular seam boundaries. These are design inferences, not claims of a historical FILA relationship.</p><a href={sourceFor('eames').url}>Eames House history ↗</a><a href={sourceFor('wright').url}>Taliesin West ↗</a></article><article><span>1970s</span><h3>The tennis line.</h3><p>The sourced FILA core: collar, stripe, knit edge and disciplined color. The Court capsule starts here and changes fit, layering and everyday use.</p><a href={sourceFor('white-line').url}>White Line ↗</a></article><article><span>1980s / 1990s → NOW</span><h3>Volume after dark.</h3><p>Los Angeles clubwear is a user-directed mood reference; we have not established a specific FILA lineage for it. Supreme’s documented skate origins and contemporary loose fit inform room around the body. Club carries that attitude into brick and navy.</p><a href={sourceFor('supreme').url}>Supreme’s origins ↗</a><a href={sourceFor('supreme-2026').url}>2026 proportion reference ↗</a></article><article><span>SOUTHERN CALIFORNIA / 2027</span><h3>The horizon edits.</h3><p>Seafoam, deep teal and ivory translate ocean and palm-shade color into restrained panels. Premium understatement comes from fewer surface gestures. The user’s interest in Nouns playfulness informs the collection’s small names and serial rhythm.</p><p class="inference-label">User-directed references + PointCast interpretation. No outside design copied.</p></article></div></section>
  <section class="rally-lessons" aria-labelledby="rally-title"><p class="eyebrow">TRANSFERABLE LESSONS / RALLY</p><h2 id="rally-title">Build a grammar<br />people can <em>feel.</em></h2><ol><li><span>01</span><div><h3>Start from the actual game.</h3><p>Observe how people warm up, reach, wait and leave. Develop RALLY’s own fit and material system around those moments.</p></div></li><li><span>02</span><div><h3>Make the family legible.</h3><p>Repeat a small original vocabulary of proportion, seam and color. Recognition should survive a small image and an unbranded sample.</p></div></li><li><span>03</span><div><h3>Let place do real work.</h3><p>Use local light, climate and community rituals to generate design choices. Test them with the people who will wear the clothes.</p></div></li></ol><p class="rally-note">These are editorial lessons, not an invitation to copy FILA marks, garments, athlete imagery or someone else’s graphics.</p></section>
  <section class="source-room" id="sources" aria-labelledby="sources-title"><div class="section-label"><span>READING ROOM</span><span>CHECKED 2 OCTOBER 2026</span></div><h2 id="sources-title">Sources &<br /><em>image credits.</em></h2><p class="source-intro">Company and museum sources establish brand chronology; athlete records establish results. Outside design references inform our independent concept. Current context is dated, and the October 2026 event is described as upcoming.</p><ol class="source-list">{SOURCES.map(source => <li id={`source-${source.id}`}><a href={source.url}>{source.title} ↗</a><p>{source.note}</p></li>)}</ol><div id="credits" class="credits"><h3>The photographs</h3>{rights.images.map(im => <article><h4>{im.caption}</h4><p>{im.title} — {im.author}{'collection' in im ? `, ${im.collection}` : ''}. <a href={im.licenseUrl}>{im.license}</a>. <a href={im.sourcePage}>Source file ↗</a>{'originalSource' in im && <> · <a href={im.originalSource}>Original photographer’s page ↗</a></>}</p><p>Resized and converted to WebP for this exhibition; responsive display may crop the frame. {im.id === 'seles-circa-1991' && 'The Commons version includes prior color/contrast adjustments. The photographer’s event-year estimate is uncertain, so we use “circa 1991”.'}</p></article>)}<h3>The original art & future looks</h3><p>Court / Material Study, Knit / Sculpture Study, and all twelve concept outfits were generated for PointCast with built-in imagegen on 2 October 2026. No historical reference photographs were used as generation inputs. The outfits are independent imagined designs, not official FILA releases, endorsements, available inventory or physical samples.</p><p>Front/back views are generated interpretations. The Detail view crops the front rendering; it cannot verify a textile’s actual hand, construction or performance. All material and function notes are development proposals.</p><p class="credits-links"><a href="/fila.json">Read the structured study and credits ↗</a><a href="https://github.com/mhoydich/pointcast/tree/main/docs/research">Research and generation provenance in the repository ↗</a></p></div></section>
</FilaLayout>
<style>
  .local-edition{display:grid;grid-template-columns:1.35fr 1fr;gap:5vw;padding:60px var(--gutter);background:#145fc4;color:#f3eedf;align-items:center}.local-edition-image img{width:100%;height:auto;display:block}.local-edition h2{font-size:clamp(38px,5vw,70px);line-height:.95;letter-spacing:-.06em;margin:22px 0}.local-edition h2 em{font-family:Georgia,serif;font-weight:400}.local-edition p:not(.eyebrow){font-size:13px;max-width:36ch}.local-edition a:not(.local-edition-image){font-size:11px;min-height:44px;display:inline-flex;align-items:center}.local-edition .local-edition-label{font-size:9px!important}.local-edition :focus-visible{outline-color:#f3eedf}@media(max-width:600px){.local-edition{grid-template-columns:1fr;padding:35px var(--gutter);gap:25px}.local-edition h2{font-size:45px}}

  .hero{padding:25px var(--gutter) 0}.hero h1{margin:38px 0 32px;display:grid;grid-template-columns:1.6fr 1fr;gap:3vw;align-items:center}.hero-name{font-size:clamp(150px,27vw,450px);font-weight:650;line-height:.7;letter-spacing:-.11em;margin-left:-.025em}.hero-subtitle{font-size:clamp(32px,5.7vw,90px);letter-spacing:-.06em;line-height:.95;font-weight:500}.hero-subtitle em,.opening em,.archive-copy em,.timeline-room em,.photo-salon em,.material-room em,.genealogy em,.rally-lessons em,.source-room em{font-family:Georgia,serif;font-weight:400}.hero-caption{display:flex;justify-content:space-between;align-items:end;margin-bottom:32px;gap:30px}.hero-caption p{font-size:13px;line-height:1.55;margin:0}.hero-caption a{font-size:12px;text-decoration:none;border-bottom:1px solid #12223b;padding:12px 0;display:flex;gap:70px}.hero-art{position:relative}.hero-art img{display:block;width:100%;height:auto}.hero-art figcaption,figure figcaption{font-family:'JetBrains Mono Variable',monospace;font-size:9px;line-height:1.6;margin:12px 0;letter-spacing:.02em}.opening{padding:90px var(--gutter) 100px;display:grid;grid-template-columns:1.35fr 1fr;gap:30px 6vw}.opening .eyebrow{grid-column:1/-1;margin:0}.opening h2{font-size:clamp(40px,5.3vw,85px);line-height:1.05;letter-spacing:-.06em;margin:0}.opening>div p{font-size:14px;margin:0 0 20px;line-height:1.8}.archive-room{position:relative;background:var(--navy);color:var(--cream);display:grid;grid-template-columns:1fr 1fr;padding:80px var(--gutter);gap:6vw;overflow:hidden;scroll-margin-top:64px}.archive-copy{position:relative;z-index:1;align-self:center}.archive-copy h2{font-size:clamp(58px,8.7vw,140px);letter-spacing:-.065em;line-height:.91;margin:30px 0}.archive-copy p:not(.eyebrow){font-size:13px;line-height:1.8;max-width:41ch}.source-link{font-size:11px;display:inline-block;text-underline-offset:5px;padding:15px 0}.borg-portrait{position:relative;z-index:1;max-width:510px;margin-left:auto;align-self:center}.borg-portrait img{display:block;width:100%;height:auto}.borg-portrait figcaption{display:flex;flex-direction:column;font-size:8px}.archive-number{position:absolute;font-size:45vw;line-height:.7;bottom:30px;left:0;font-weight:600;letter-spacing:-.1em;color:#27374e;z-index:0}.timeline-room{padding:80px var(--gutter)}.timeline-room>h2,.photo-salon h2,.genealogy h2,.rally-lessons h2,.source-room h2{font-size:clamp(50px,7vw,110px);line-height:.95;letter-spacing:-.065em;margin:35px 0 60px}.timeline article{display:grid;grid-template-columns:40px 240px 1fr;gap:30px;border-top:1px solid #12223b55;padding:27px 0 32px}.timeline article:last-child{border-bottom:1px solid #12223b55}.era-index{font:10px 'JetBrains Mono Variable',monospace;color:var(--red);padding-top:7px}.era-date{font-size:19px;margin:0;line-height:1.5;letter-spacing:-.03em}.timeline h3{font-size:25px;margin:0;letter-spacing:-.04em}.timeline article div p{font-size:13px;line-height:1.8;max-width:72ch;margin:12px 0}.timeline article a{font-family:'JetBrains Mono Variable',monospace;font-size:9px;display:block;line-height:1.8;margin-top:6px}.photo-salon{padding:70px var(--gutter);background:#ded8cb}.salon-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:45px 6vw;align-items:start}.salon-grid img{display:block;width:100%;height:auto}.salon-seles{padding-top:110px}.salon-goerges{width:82%}.salon-note{align-self:center}.salon-note>p:not(.eyebrow){font-size:24px;line-height:1.5;letter-spacing:-.03em}.salon-note .salon-small{font-size:11px!important;letter-spacing:0!important;line-height:1.7!important}.material-room{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:80px var(--gutter);align-items:center}.material-room figure{max-width:470px}.material-room img{width:100%;height:auto;display:block}.material-room h2{font-size:clamp(52px,7vw,110px);line-height:.93;letter-spacing:-.065em;margin:30px 0}.material-room p:not(.eyebrow){font-size:14px;line-height:1.8;max-width:39ch}.genealogy{padding:80px var(--gutter);border-top:1px solid var(--navy)}.influence-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px}.influence-grid article{border-top:2px solid var(--red);padding-top:20px}.influence-grid span{font-family:'JetBrains Mono Variable',monospace;font-size:9px}.influence-grid h3{font-size:24px;letter-spacing:-.04em;line-height:1.15;margin:20px 0}.influence-grid p{font-size:12px;line-height:1.8}.influence-grid a{font-size:10px;display:block;margin-top:12px}.inference-label{font-size:10px!important;border-left:1px solid var(--red);padding-left:12px}.rally-lessons{padding:75px var(--gutter);background:var(--red);color:var(--cream)}.rally-lessons ol{padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.rally-lessons li{border-top:1px solid #efeade80;padding-top:20px}.rally-lessons li>span{font:11px 'JetBrains Mono Variable',monospace}.rally-lessons h3{font-size:27px;letter-spacing:-.04em;line-height:1.15}.rally-lessons li p{font-size:13px;line-height:1.8}.rally-note{font:10px/1.8 'JetBrains Mono Variable',monospace;max-width:90ch;margin-top:35px}.source-room{padding:80px var(--gutter);scroll-margin-top:64px}.source-intro{font-size:14px;line-height:1.8;max-width:80ch}.source-list{padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0 50px;counter-reset:sources;margin-top:40px}.source-list li{padding:18px 0;border-top:1px solid #12223b44;counter-increment:sources}.source-list li>a{font-size:12px;font-weight:500;line-height:1.7}.source-list li>a::before{content:counter(sources,decimal-leading-zero) ' / ';font-family:'JetBrains Mono Variable',monospace;font-size:10px;color:var(--red)}.source-list p{font-size:11px;line-height:1.8;max-width:68ch;margin:8px 0}.credits{margin-top:70px;border-top:1px solid #12223b;padding-top:30px;scroll-margin-top:80px;max-width:900px}.credits h3{font-size:28px;letter-spacing:-.04em;margin:20px 0}.credits h4{font-size:14px;line-height:1.6;margin:25px 0 5px}.credits p{font-size:11px;line-height:1.8;margin:7px 0 14px}.credits-links a{display:block;margin-top:12px}
  @media(max-width:900px){.timeline article{grid-template-columns:25px 180px 1fr;gap:22px}.influence-grid{grid-template-columns:1fr 1fr}.hero h1{grid-template-columns:1.3fr 1fr}.hero-name{font-size:26vw}.hero-subtitle{font-size:6vw}.rally-lessons ol{gap:25px}}
  @media(max-width:600px){.hero{padding-top:20px}.hero h1{display:block;margin:45px 0 30px}.hero-name{display:block;font-size:44vw;letter-spacing:-.105em}.hero-subtitle{display:block;font-size:13vw;margin:38px 0 0;line-height:.95}.hero-caption{align-items:start;gap:20px;margin-bottom:25px}.hero-caption p{font-size:10px;max-width:44%}.hero-caption a{font-size:10px;gap:8px;padding-top:0;max-width:50%;line-height:1.7}.hero-art{margin:0 calc(-1 * var(--gutter))}.hero-art img{aspect-ratio:1.25;object-fit:cover}.hero-art figcaption{font-size:8px;padding:0 var(--gutter);margin:12px 0}.opening{grid-template-columns:1fr;gap:25px;padding:55px var(--gutter)}.opening h2{font-size:12vw}.opening>div p{font-size:13px}.archive-room{grid-template-columns:1fr;gap:35px;padding:50px var(--gutter)}.archive-copy h2{font-size:20vw;margin:30px 0}.archive-copy p:not(.eyebrow){font-size:13px;max-width:none}.borg-portrait{margin:0 auto;width:85%}.archive-number{font-size:90vw;bottom:45%;left:10%}.timeline-room{padding:50px var(--gutter)}.timeline-room>h2,.photo-salon h2,.genealogy h2,.rally-lessons h2,.source-room h2{font-size:13vw;margin:30px 0 40px}.timeline article{grid-template-columns:25px 1fr;gap:10px 16px;padding:22px 0}.era-date{font-size:17px}.timeline article>div{grid-column:2}.timeline h3{font-size:23px}.timeline article div p{font-size:12px}.timeline article a{font-size:9px}.photo-salon{padding:50px var(--gutter)}.salon-grid{gap:30px 20px;grid-template-columns:1fr 1fr}.salon-borg{grid-column:1/-1}.salon-seles{padding-top:0}.salon-goerges{width:100%;grid-column:1/-1}.salon-note{grid-row:2;grid-column:2}.salon-note>p:not(.eyebrow){font-size:16px}.salon-note .salon-small{font-size:9px!important}.salon-grid figcaption{font-size:8px}.material-room{grid-template-columns:1fr;gap:20px;padding:50px var(--gutter)}.material-room figure{width:74%;margin:0 auto}.material-room h2{font-size:15vw}.material-room p:not(.eyebrow){font-size:13px}.genealogy{padding:50px var(--gutter)}.influence-grid{gap:30px 24px}.influence-grid h3{font-size:22px}.influence-grid p{font-size:11px}.influence-grid span{font-size:8px}.rally-lessons{padding:50px var(--gutter)}.rally-lessons ol{grid-template-columns:1fr;gap:15px}.rally-lessons li{display:grid;grid-template-columns:25px 1fr;gap:15px}.rally-lessons h3{font-size:25px;margin:0 0 15px}.rally-lessons li p{font-size:12px}.source-room{padding:50px var(--gutter)}.source-list{grid-template-columns:1fr;gap:0}.source-intro{font-size:12px}.credits{margin-top:45px}.credits p{font-size:10px}}
</style>
