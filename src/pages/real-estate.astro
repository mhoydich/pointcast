---
import BlockLayout from '../layouts/BlockLayout.astro';
import {study,methodology,sources} from '../lib/real-estate-study.mjs';
import {STUDY_CENTER,radiusBoundary,localMarkets,propertyTypes} from '../lib/real-estate-local.mjs';
import {INPUT_FIELDS,DEFAULT_INPUTS,compareScenarios,SCENARIOS} from '../lib/real-estate-scenario.mjs';
import '../styles/real-estate.css';
const results=compareScenarios(),base=results[1];
const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
const project=(lat:number,lon:number)=>({x:380+(lon-STUDY_CENTER.lon)*Math.cos(STUDY_CENTER.lat*Math.PI/180)*69.0934/25*300,y:380-(lat-STUDY_CENTER.lat)*69.0934/25*300});
const pts=(coords:number[][])=>coords.map(([lat,lon])=>{const p=project(lat,lon);return `${p.x},${p.y}`}).join(' ');
const boundary=radiusBoundary().map(p=>{const a=project(p.lat,p.lon);return `${a.x},${a.y}`}).join(' ');
const groups=[...new Set(INPUT_FIELDS.map(f=>f.group))];
const first=localMarkets[0];
const sourceLinks=(ids:string[])=>sources.filter(s=>ids?.includes(s.id));
const fhfa=study.snapshots.fhfa;
---
<BlockLayout title="Groundwork · Real Estate Observatory" description="A source-backed 25-mile El Segundo study, global real-estate field guide and editable hypothetical five-year acquisition lab." isolated immersive showNetworkStrip={false} themeColor="#eae6dc" image="/images/real-estate/social.png" alternates={[{type:'application/json',href:'/real-estate.json',title:'Study, sources and assumptions'}]} jsonLd={{'@context':'https://schema.org','@type':'LearningResource',name:study.title,url:'https://pointcast.xyz/real-estate/',datePublished:study.edition,learningResourceType:'Educational atlas and hypothetical financial model',isAccessibleForFree:true,description:methodology.scope}}>
<div class="re" data-real-estate>
<a class="re-skip" href="#local">Skip to the study</a>
<header class="re-masthead"><a href="/" class="re-wordmark">POINTCAST<span>FIELD STUDIES / 001</span></a><div class="re-edition">REAL ESTATE OBSERVATORY<br/><span>V1 · RESEARCH CHECKED 03 OCT 2026</span></div><a href="#lab" class="re-nav-cta">Open the portfolio lab ↗</a></header>
<nav class="re-sections" aria-label="Study sections"><a href="#local">01 Local atlas</a><a href="#global">02 World lens</a><a href="#foundations">03 How it works</a><a href="#lab">04 Five-year lab</a><a href="#feeds">05 Evidence desk</a><a href="#sources">Source ledger</a></nav>
<section class="re-hero" aria-labelledby="re-title"><div class="re-hero-copy"><p class="re-kicker">START WITH A PLACE. FOLLOW THE CASH.</p><h1 id="re-title">Ground<br/><em>work.</em></h1><p class="re-dek">Land. Income. Time.<br/>A world of real estate,<br/>beginning 25 miles from home.</p><p class="re-intro">Follow the coast, cross the basin, meet the rules. Then build an imaginary portfolio and see what survives five years.</p><div class="re-hero-actions"><a class="re-button" href="#local">Explore the circle ↓</a><a class="re-text-link" href="#lab">Change the assumptions ↗</a></div><p class="re-caption">PRIMARY SOURCES · ORIGINAL CARTOGRAPHY · HYPOTHETICAL MATH</p></div><figure class="re-map re-hero-map"><svg viewBox="0 0 760 760" aria-labelledby="re-map-title re-map-desc"><title id="re-map-title">A 25-mile study circle centered on El Segundo City Hall</title><desc id="re-map-desc">A great-circle radius with 18 numbered representative study anchors. Ocean, coastline, buildings and transit strokes are schematic. Select the numbered buttons below for the same information.</desc><defs><clipPath id="re-radius"><polygon points={boundary}/></clipPath><pattern id="re-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="#fff" stroke-opacity=".16"/></pattern></defs><circle cx="380" cy="380" r="301" fill="#264f66"/><g clip-path="url(#re-radius)"><polygon points={pts([[34.4,-118.7],[34.1,-118.57],[34.035,-118.52],[33.98,-118.47],[33.90,-118.44],[33.83,-118.40],[33.75,-118.42],[33.71,-118.34],[33.74,-118.27],[33.77,-118.20],[33.74,-118.1],[33.50,-117.8],[34.5,-117.7]])} fill="#d6bfa1"/><rect x="0" y="0" width="760" height="760" fill="url(#re-grid)"/>
<g fill="none" stroke="#f4ebda" stroke-width="5" opacity=".7"><polyline points={pts([[33.95,-118.44],[33.93,-118.38],[33.916,-118.36],[33.892,-118.353],[33.87,-118.34],[33.84,-118.33]])}/><polyline points={pts([[33.916,-118.36],[33.916,-118.27],[33.916,-118.20],[33.916,-118.12]])}/><polyline points={pts([[34.049,-118.48],[34.03,-118.39],[34.017,-118.29],[34.049,-118.25]])}/><polyline points={pts([[33.77,-118.19],[33.84,-118.20],[33.93,-118.22],[34.049,-118.25]])}/></g>
<g fill="#aa7d5c" opacity=".55">{Array.from({length:33},(_,i)=><rect x={420+(i%6)*31} y={195+Math.floor(i/6)*36} width={13+(i%3)*4} height={20+(i%4)*3} transform={`rotate(-12 ${420+(i%6)*31} ${195+Math.floor(i/6)*36})`}/>)}</g><g fill="#efc563" opacity=".8"><rect x="363" y="336" width="88" height="13"/><rect x="393" y="296" width="12" height="68"/></g></g>
<polygon points={boundary} fill="none" stroke="#252820" stroke-width="2"/><circle cx="380" cy="380" r="150" fill="none" stroke="#fff" stroke-opacity=".4" stroke-dasharray="3 7"/><path d="M380 78V682M78 380H682" stroke="#fff" stroke-opacity=".13"/>
<text x="100" y="427" class="re-ocean">PACIFIC</text><text x="100" y="450" class="re-ocean">OCEAN</text><text x="380" y="43" text-anchor="middle">N ↑</text><text x="380" y="719" text-anchor="middle">25 MILES / GEODESIC RADIUS</text>
{localMarkets.map((m,i)=>{const p=project(m.lat,m.lon);return <g data-map-market={m.id} aria-pressed={i===0} role="button" tabindex="0" aria-label={`Explore ${m.name}, ${m.distanceMiles.toFixed(1)} miles from the center`} class={i===0?'selected':''}><circle cx={p.x} cy={p.y} r="14"/><text x={p.x} y={p.y+4} text-anchor="middle">{String(i+1).padStart(2,'0')}</text><title>{m.name} · {m.distanceMiles.toFixed(1)} mi</title></g>})}<text x="300" y="411" class="re-center-label">EL SEGUNDO / START HERE</text></svg><figcaption>18 research anchors. A measured circle; schematic coast and routes.<br/>No parcels, listings or implied municipal coverage. <a href="#method">Read the map method ↗</a></figcaption></figure></section>
<aside class="re-scope"><strong>AN EDUCATIONAL V1, BUILT TO GROW</strong><p>Representative places and primary evidence. Invented portfolio assumptions. No current listings or observed yield rankings. IndustryNext and University of El Segundo are proposed educational context; no partnership or participation is claimed. The earlier intern program is historical and closed.</p></aside>
<section class="re-section" id="local"><div class="re-section-heading"><p class="re-kicker">01 / THE LOCAL SUPERSTUDY · FIRST LAYER</p><h2>One circle.<br/><em>Many different economies.</em></h2><p>Beach-town housing, aerospace campuses, rail-adjacent apartments and port logistics share a region. They do not share the same underwriting.</p></div><div class="re-controls"><label>Find a study anchor<input type="search" data-local-search placeholder="Try: industrial, Torrance, rail…" maxlength="120"/></label><label>Property lens<select data-type><option value="all">All property types</option>{propertyTypes.map(t=><option value={t}>{t}</option>)}</select></label><p data-local-count role="status">{localMarkets.length} anchors</p></div><div class="re-local-layout"><div class="re-anchor-grid" aria-label="Representative study anchors">{localMarkets.map((m,i)=><button data-market={m.id} class={i===0?'selected':''} aria-pressed={i===0} data-search={JSON.stringify(m).toLowerCase()} data-types={m.propertyTypes.join('|')}><span class="re-anchor-number">{String(i+1).padStart(2,'0')}</span><span><strong>{m.name}</strong><small>{m.propertyTypes.slice(0,2).join(' / ')}</small></span><span class="re-distance">{m.distanceMiles.toFixed(1)}<small>mi</small></span></button>)}</div><article class="re-anchor-detail" aria-live="polite"><p class="re-kicker" data-detail="distance">{first.distanceMiles.toFixed(1)} MI / REPRESENTATIVE CENTER</p><h3 data-detail="name">{first.name}</h3><p data-detail="character">{first.character}</p><h4>Property lens</h4><p data-detail="types">{first.propertyTypes.join(' · ')}</p><h4>Planning questions</h4><ul data-detail="planning">{first.planning.map(s=><li>{s}</li>)}</ul><h4>Movement & access</h4><ul data-detail="transit">{first.transit.map(s=><li>{s}</li>)}</ul><h4>Diligence before a thesis</h4><ul data-detail="risks">{first.risks.map(s=><li>{s}</li>)}</ul><div class="re-inline-sources" data-detail="sources">{sourceLinks(first.sourceIds).map(s=><a href={`#${s.id}`}>{s.publisher||s.title} ↗</a>)}</div></article></div><p class="re-note">Distances use anchor coordinates, not municipality boundaries or driving routes. Zoning allows or constrains a proposal; it does not approve a specific project. Follow each source through to the current ordinance, parcel and authority.</p></section>
<section class="re-section re-world" id="global"><div class="re-section-heading"><p class="re-kicker">02 / A WORLD LENS · EIGHT REPRESENTATIVE MARKETS</p><h2>The rent is local.<br/><em>The capital travels.</em></h2><p>A city’s appeal is only the beginning. Who can own, how rent is regulated, how debt is priced and how money leaves can matter more than a headline yield.</p></div><div class="re-controls"><label>Search the world lens<input type="search" data-global-search placeholder="Try: JPY, foreign, tenant…" maxlength="120"/></label><label>Region<select data-global-region><option value="all">All regions</option>{[...new Set(study.globalMarkets.map(m=>m.region))].map(r=><option value={r}>{r}</option>)}</select></label><p data-global-count role="status">{study.globalMarkets.length} markets</p></div><div class="re-global-grid">{study.globalMarkets.map((m,i)=><article data-global-market data-search={JSON.stringify(m).toLowerCase()} data-region={m.region}><p class="re-kicker">{String(i+1).padStart(2,'0')} / {m.country} / {m.currency}</p><h3>{m.name}</h3><p class="re-thesis">{m.thesis}</p><dl><dt>Ownership & access</dt><dd>{m.access}</dd><dt>Tax & friction</dt><dd>{m.tax}</dd><dt>Debt & currency</dt><dd>{m.financing}</dd><dt>Operating reality</dt><dd>{m.operating}</dd></dl><details><summary>Risks and source trail ↓</summary><ul>{m.risks.map(r=><li>{r}</li>)}</ul><div class="re-inline-sources">{sourceLinks(m.sourceIds).map(s=><a href={`#${s.id}`}>{s.publisher} ↗</a>)}</div></details></article>)}</div><p class="re-note">Selected comparisons, not a global opportunity ranking. Laws and tax depend on buyer status, asset, location and date. Local counsel, tax advice, financing and permissioned comps are unresolved inputs.</p></section>
<section class="re-section" id="foundations"><div class="re-section-heading"><p class="re-kicker">03 / THE FIELD GUIDE</p><h2>A building is a business.<br/><em>Read its moving parts.</em></h2><p>Yield begins with an income line and becomes useful only after the costs, debt, reserves and exit are visible.</p></div><div class="re-cash-waterfall" aria-label="Cash flow sequence"><span>Scheduled rent</span><b>−</b><span>Vacancy / loss</span><b>−</b><span>Operating costs</span><b>=</b><span class="re-highlight">NOI</span><b>−</b><span>Debt + capex</span><b>=</b><span class="re-highlight">Cash flow</span></div><div class="re-glossary">{study.glossary.map(g=><details><summary>{g.term} <span>+</span></summary><p>{g.definition}</p><code>{g.formula}</code><p class="re-note">{g.caution}</p><div class="re-inline-sources">{sourceLinks(g.sourceIds).map(s=><a href={`#${s.id}`}>Source ↗</a>)}</div></details>)}</div><div class="re-mini-heading"><h3>Choose a strategy.<br/>Accept its workload.</h3><p>These are mechanisms to study, each with a different operational burden and failure mode.</p></div><div class="re-strategies">{study.strategies.map((s,i)=><article><p class="re-kicker">STRATEGY / {String(i+1).padStart(2,'0')}</p><h4>{s.name}</h4><p>{s.mechanism}</p><p class="re-note">{s.tradeoff}</p></article>)}</div><div class="re-reit"><div><p class="re-kicker">A DIFFERENT OWNERSHIP LAYER</p><h3>A REIT share<br/>is company equity.</h3><p>It does not give you title to one building or control over a tenant. A listed equity REIT owns or operates property; a mortgage REIT holds financing assets. Share prices, leverage, management and distributions bring their own risks.</p><p>Listed shares can trade on an exchange; a building takes time and money to sell. Non-traded REITs can be illiquid and carry fees. Liquidity is not a promise of a stable price.</p><a href="https://www.investor.gov/introduction-investing/investing-basics/investment-products/real-estate-investment-trusts-reits">SEC Investor.gov REIT guide ↗</a></div><div><p class="re-kicker">TWO DIFFERENT NUMERATORS</p><p class="re-big-formula">Property cap rate<br/><span>NOI ÷ property value</span></p><p class="re-big-formula">Share dividend yield<br/><span>Annual dividend ÷ share price</span></p><p class="re-note">They are not interchangeable. Neither captures total return, a future dividend cut, capital losses, tax or exit costs.</p></div></div><div class="re-mini-heading"><h3>Tiers of capital and workload.</h3><p>A useful tier describes what a team must know and operate. These are not market quality grades or return rankings.</p></div><div class="re-tiers">{study.propertyTiers.map(t=><article><h4>{t.name}</h4><p class="re-note">{Array.isArray(t.propertyTypes)?t.propertyTypes.join(" · "):t.propertyTypes}</p><dl><dt>Capital</dt><dd>{t.capital}</dd><dt>Operations</dt><dd>{t.operations}</dd><dt>Risk to study</dt><dd>{t.risk}</dd></dl><div class="re-inline-sources">{sourceLinks(t.sourceIds).map(s=><a href={`#${s.id}`}>Source ↗</a>)}</div></article>)}</div><div class="re-mini-heading"><h3>Meet the system.</h3><p>Understand the roles before following a famous name. This is a learning roster, not an endorsement.</p></div><div class="re-players">{study.players.map(p=><article><h4>{p.name}</h4><p>{p.role}</p><p class="re-note">{Array.isArray(p.examples)?p.examples.join(' · '):p.examples}</p><div class="re-inline-sources">{sourceLinks(p.sourceIds).map(s=><a href={`#${s.id}`}>Source ↗</a>)}</div></article>)}</div><details class="re-history"><summary>Open the long view: six turning points ↓</summary><div>{study.history.map(h=><article><strong>{h.year}</strong><h4>{h.title}</h4><p>{h.detail}</p><div class="re-inline-sources">{sourceLinks(h.sourceIds).map(s=><a href={`#${s.id}`}>Source ↗</a>)}</div></article>)}</div></details></section>
<section class="re-section re-lab" id="lab"><div class="re-section-heading"><p class="re-kicker">04 / THE FIVE-YEAR PORTFOLIO LAB</p><h2>What could a team<br/><em>build from here?</em></h2><p>Change an invented capital pool, one example property and the operating assumptions. The model buys at most once per year when cash and the chosen DSCR screen pass. No actual people or commitments are assigned.</p></div><p class="re-model-warning">HYPOTHETICAL USD MODEL · NOT A LISTING, FORECAST, FINANCING APPROVAL OR INVESTMENT RECOMMENDATION</p><div class="re-lab-layout"><form data-assumptions><div class="re-form-primary">{INPUT_FIELDS.filter(f=>['capital','annualContribution','purchasePrice','monthlyRent'].includes(f.key)).map(f=><label>{f.label}<span class="re-input-wrap"><input name={f.key} type="number" value={DEFAULT_INPUTS[f.key]} min={f.min} max={f.max} step="any" required aria-describedby={`help-${f.key}`}/><span>{f.unit}</span></span><small id={`help-${f.key}`}>{f.description}</small></label>)}</div><details class="re-full-inputs"><summary>Edit financing, costs, growth & exit ↓</summary>{groups.filter(g=>g!=='Capital').map(group=><fieldset><legend>{group}</legend>{INPUT_FIELDS.filter(f=>f.group===group&&!['purchasePrice','monthlyRent'].includes(f.key)).map(f=><label>{f.label}<span class="re-input-wrap"><input name={f.key} type="number" value={DEFAULT_INPUTS[f.key]} min={f.min} max={f.max} step="any" required/><span>{f.unit}</span></span><small>{f.description}</small></label>)}</fieldset>)}</details><div class="re-form-actions"><button class="re-button" type="submit">Calculate five years ↗</button><button type="button" data-reset>Reset example</button></div><p data-model-status role="status" aria-live="polite">The example is loaded. Values are invented.</p><div class="re-share-actions"><button type="button" data-share>Copy assumptions link</button><button type="button" data-download>Download results JSON ↓</button></div><p class="re-note">Assumptions live in this page’s URL when you calculate or share. Share only values you want others to read. Nothing is sent to a broker, lender or account.</p></form><div class="re-model-output"><div class="re-scenario-tabs" aria-label="Scenario selection">{SCENARIOS.map(s=><button type="button" data-case={s.id} aria-pressed={s.id==='base'}>{s.label}</button>)}</div><div class="re-outcome-grid"><article><span>Ending model equity</span><strong data-output="equity">{money(base.final.equity)}</strong><small>Includes liquid cash, reserves and estimated asset equity</small></article><article><span>Hypothetical after-cost exit</span><strong data-output="exit">{money(base.final.netLiquidation)}</strong><small>Sale costs deducted · tax excluded</small></article><article><span>Properties / funding gap</span><strong data-output="count">{base.final.propertyCount} / {money(base.final.unfundedShortfall)}</strong><small>At most one acquisition per year</small></article></div><figure class="re-equity-chart"><svg viewBox="0 0 800 320" role="img" aria-labelledby="re-chart-title re-chart-desc"><title id="re-chart-title">Illustrative model equity over five years</title><desc id="re-chart-desc">Adverse, base and upside paths from invented assumptions. Exact yearly figures are in the table below.</desc><g data-chart-grid></g><g data-chart-paths></g><g data-chart-labels></g></svg><figcaption>MODEL EQUITY / NOMINAL USD / THREE SENSITIVITIES<br/>Capital contributions are included. Paths are calculations, not forecasts.</figcaption><div class="re-chart-key"><span class="adverse">Adverse</span><span class="base">Base</span><span class="upside">Upside</span></div></figure><p data-output="scenario" class="re-note"></p><div class="re-first-metrics"><p><span>Example gross yield</span><strong data-output="gross">{base.initialMetrics.grossYieldPct.toFixed(2)}%</strong></p><p><span>Example cap rate</span><strong data-output="cap">{base.initialMetrics.capRatePct.toFixed(2)}%</strong></p><p><span>Acquisition DSCR</span><strong data-output="dscr">{base.initialMetrics.dscr?.toFixed(2)??'Debt free'}</strong></p><p><span>After capex & debt</span><strong data-output="cashflow">{money(base.initialMetrics.cashflow)}/yr</strong></p></div><p class="re-note">First property at year-1 terms. NOI excludes capex. Model DSCR = NOI/debt service; actual lenders can deduct replacement reserves or use other tests. Cash-on-cash uses acquisition cash including initial liquidity reserve.</p></div></div><div class="re-table-wrap" tabindex="0" aria-label="Yearly model table; scroll horizontally on small screens"><table><caption data-table-caption>Base scenario · five hypothetical years, USD. Contribution arrives at each year’s start. Asset values cannot fund a down payment.</caption><thead><tr><th scope="col">Year</th><th scope="col">Held / bought</th><th scope="col">Cash flow</th><th scope="col">Liquid cash</th><th scope="col">Reserves</th><th scope="col">Asset value</th><th scope="col">Debt</th><th scope="col">Equity / gap</th><th scope="col">Acquisition gate</th></tr></thead><tbody data-model-years>{base.years.map(y=><tr><th scope="row">{y.year}</th><td>{y.propertyCount} / +{y.acquiredCount}</td><td>{money(y.cashflow)}</td><td>{money(y.liquidCash)}</td><td>{money(y.reserves)}</td><td>{money(y.propertyValue)}</td><td>{money(y.debtBalance)}</td><td>{money(y.equity)}{y.unfundedShortfall>0&&<small>Unfunded: {money(y.unfundedShortfall)}</small>}</td><td>{y.acquisitionEligibility.eligible?"Model gate passed · 1 acquired":y.acquisitionEligibility.reasons.join(" ")}</td></tr>)}</tbody></table></div><details class="re-formulas"><summary>Read the equations, timing and exclusions ↓</summary><ul>{base.methodology.map(m=><li>{m}</li>)}</ul><p>{methodology.model.exclusions}</p><a href="/real-estate/methodology.json" download>Download methodology JSON ↓</a></details><div class="re-acquisition-plan"><article><p class="re-kicker">BEFORE YEAR ONE</p><h3>Build the evidence room.</h3><p>Define the team’s actual goals and governance. Verify permissioned rent comps, title, zoning, tax, inspection, insurance and debt terms. Replace every invented input before treating the model as a candidate plan.</p></article><article><p class="re-kicker">EACH YEAR</p><h3>Use a gate, not a calendar promise.</h3><p>The model reports cash and DSCR eligibility. A failed gate means wait or change assumptions; it does not imply a cheaper deal exists. Keep operating reserves and review downside costs before expanding.</p></article><article><p class="re-kicker">A SEPARATE LIQUID SLEEVE</p><h3>Study REITs separately.</h3><p>This engine models direct property only. A future diversified team plan can compare cash, listed REIT equity and property with separate drawdown, fee, tax and liquidity assumptions. No REIT return is invented here.</p></article></div></section>
<section class="re-section" id="feeds"><div class="re-section-heading"><p class="re-kicker">05 / THE EVIDENCE DESK</p><h2>Fresh is a timestamp.<br/><em>Useful is a distinction.</em></h2><p>A request made now can return an old observation. The desk shows what is accessible, how often it publishes and what it cannot tell you.</p></div><div class="re-evidence-grid"><article class="re-hpi"><p class="re-kicker">FHFA / QUARTERLY / DELAYED</p><h3>LA metro<br/>house-price index</h3><strong data-feed="hpi-value">{fhfa.latest.index.toFixed(2)}</strong><p data-feed="hpi-period">{fhfa.observationPeriod} · all-transactions · NSA</p><p data-feed="hpi-change">{fhfa.quarterChangePct.toFixed(2)}% quarter / +{fhfa.yearChangePct.toFixed(2)}% year</p><figure><svg viewBox="0 0 500 180" role="img" aria-label="Sixteen quarterly LA metro FHFA house-price-index observations"><polyline data-feed="hpi-path" fill="none" stroke="currentColor" stroke-width="3"/><g data-feed="hpi-labels"></g></svg><figcaption>1995 Q1 = 100. Revisions possible. The metro division extends beyond the study circle.</figcaption></figure><p data-feed="hpi-date" class="re-note">Stored snapshot retrieved {fhfa.retrievedAt}</p><button type="button" data-refresh="fhfa">Fetch official publication ↗</button><p data-feed="hpi-status" role="status">Dated bundled snapshot. No automatic refresh.</p></article><article class="re-quakes"><p class="re-kicker">USGS / MINUTE PUBLICATION / HAZARD CONTEXT</p><h3>Recent epicenters<br/>inside the circle</h3><strong data-feed="quake-count">{study.snapshots.usgs.events.length}</strong><p>In the publisher’s rolling past-week feed</p><ul data-feed="quakes"></ul><p data-feed="quake-date" class="re-note">Generated {study.snapshots.usgs.generatedAt}</p><button type="button" data-refresh="usgs">Refresh public event context ↗</button><p data-feed="quake-status" role="status">Dated bundled snapshot. No automatic refresh.</p><p class="re-note">Epicenters are not hazard ratings. Zero events would not establish safety. Use official seismic, flood, fire and parcel evidence for diligence; this is not an alert service.</p></article></div><div class="re-feed-ledger">{study.feeds.map(f=><details><summary><span>{f.name}</span><span>{f.status} ↓</span></summary><dl><dt>Cadence</dt><dd>{f.cadence}</dd><dt>Access</dt><dd>{f.access}</dd><dt>CORS / transport</dt><dd>{f.cors}</dd><dt>Reuse / limits</dt><dd>{f.licensing} {f.limits}</dd>{f.meaning&&<><dt>Interpretation</dt><dd>{f.meaning}</dd></>}</dl></details>)}</div><div class="re-api"><div><p class="re-kicker">PUBLIC / READ ONLY / NO NEW KEYS</p><h3>A study that agents<br/>can read and calculate.</h3><p>Versioned research, bounded query parameters and a pure scenario engine. The existing PointCast MCP exposes three scoped read-only tools; no transaction or application action is added.</p></div><div><a href="/real-estate.json">Study + sources JSON ↗</a><a href="/real-estate/openapi.json">OpenAPI 3.1 ↗</a><a href="/api/real-estate/query?region=local">Local query ↗</a><a href="/api/real-estate/scenario?capital=250000">Illustrative scenario API ↗</a><code>MCP /api/mcp-v2<br/>real_estate_study<br/>real_estate_scenario<br/>real_estate_feed</code><p class="re-note">Preview server shows static research and browser calculations. Pages Function routes need the Pages runtime; the feed buttons can use the supported USGS browser source there. The deployed API is pending approval and publication.</p></div></div><aside class="re-connected"><h3>The business signals next door.</h3><p>Interest rates and currency affect financing and cross-border cash flow. Read the separate <a href="/business-feels/">Business Feels dashboard</a> and its <a href="/business-feels.json">dated machine snapshot</a>. These are benchmarks, not executable mortgage offers; this portfolio engine uses your explicitly entered USD assumptions.</p></aside></section>
<section class="re-section re-method" id="method"><div class="re-section-heading"><p class="re-kicker">06 / FOUNDATIONS TO BUILD ON</p><h2>A useful first layer.<br/><em>An open project brief.</em></h2><p>{methodology.researchBrief.context}</p></div><div class="re-method-grid"><article><h3>Map method</h3><p>{methodology.geography.formula}</p><p>{methodology.geography.limits}</p><p class="re-note">Center: {STUDY_CENTER.lat.toFixed(6)}, {STUDY_CENTER.lon.toFixed(6)}. Address: 350 Main Street, El Segundo. Geocoder precision is not a survey.</p></article><article><h3>Evidence standard</h3><p>{methodology.evidence}</p><p>{methodology.refresh}</p><a href="/real-estate/methodology.json" download>Download complete methods ↓</a></article><article><h3>Educational project cards</h3><ol>{methodology.researchBrief.projects.map(p=><li>{p}</li>)}</ol><p class="re-note">{methodology.researchBrief.acceptance}</p></article><article><h3>The next edition needs</h3><ul>{methodology.future.map(p=><li>{p}</li>)}</ul></article></div></section>
<section class="re-section re-sources" id="sources"><div class="re-section-heading"><p class="re-kicker">07 / THE SOURCE LEDGER</p><h2>Every claim needs<br/><em>a place to stand.</em></h2><p>Primary public sources checked 3 October 2026. Each entry’s access note describes what was verified, not a promise that a future request will succeed.</p></div><ol>{sources.map(s=><li id={s.id}><a href={s.url}>{s.title} ↗</a><p>{s.publisher} · checked {s.checkedAt} · {s.cadence||'Reference source'}</p>{(s.note||s.access)&&<p class="re-note">{s.access} {s.note}</p>}</li>)}</ol></section>
