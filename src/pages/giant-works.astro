---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FUNDING_PRINCIPLES, GIANT_WORKS, GW_META, GW_NOTES, REFERENCES, SCALING_PRINCIPLES, TIER_D_DEFINITION } from '../lib/giantWorks';
const title = `${GW_META.title} — ${GW_META.subtitle}`;
const description = GW_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/giant-works', name: GW_META.title, description, url: 'https://pointcast.xyz/giant-works', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const elementColor: Record<string, string> = { earth: '#8a6a3d', water: '#3d6a8a', fire: '#b85a3a', air: '#a8a39a', synthesis: '#5b3d7a' };
const elementSymbol: Record<string, string> = { earth: '⏚', water: '≋', fire: '✺', air: '⚘', synthesis: '✶' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/giant-works.json', title: 'Giant Works (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/strand-corridor">strand-corridor</a><span aria-hidden="true">/</span><span>giant-works</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{GW_META.paperNumber} · TIER D · 50-YEAR BUILD QUEUE · 8 PROSPECTIVE WORKS</p>
      <h1>GIANT / WORKS.</h1>
      <p class="subtitle">{GW_META.subtitle}</p>
      <p class="thesis">{GW_META.thesis}</p>
      <p class="audience"><strong>Audience:</strong> {GW_META.audience}</p>
    </header>

    <section class="tier"><p class="kicker">TIER D · DEFINITION</p><h2>What separates Tier D from Common Forms.</h2>
      <dl class="td-dl">
        <div><dt>Cost floor</dt><dd>{TIER_D_DEFINITION.costFloor}</dd></div>
        <div><dt>Typical range</dt><dd>{TIER_D_DEFINITION.typicalRange}</dd></div>
        <div><dt>Funding horizon</dt><dd>{TIER_D_DEFINITION.fundingHorizon}</dd></div>
        <div><dt>Funding mix</dt><dd>{TIER_D_DEFINITION.fundingMix}</dd></div>
        <div><dt>Governance</dt><dd>{TIER_D_DEFINITION.governance}</dd></div>
        <div><dt>Design language</dt><dd>{TIER_D_DEFINITION.designLanguage}</dd></div>
        <div><dt>Durability</dt><dd>{TIER_D_DEFINITION.durability}</dd></div>
        <div><dt>Publicness</dt><dd>{TIER_D_DEFINITION.publicness}</dd></div>
      </dl>
    </section>

    <section class="overview"><p class="kicker">THE EIGHT WORKS · BY ELEMENT</p><h2>The catalog at a glance.</h2>
      <ol class="ov-list">{GIANT_WORKS.map((w, i) => (
        <li class={`ov ov--${w.element}`} style={`--el-color: ${elementColor[w.element]};`}>
          <a href={`#gw-${w.id}`}>
            <span class="ov__num">{String(i+1).padStart(2,'0')}</span>
            <span class="ov__el" aria-hidden="true">{elementSymbol[w.element]}</span>
            <div class="ov__body">
              <h3>{w.title}</h3>
              <p class="ov__tag">{w.tagline}</p>
              <p class="ov__meta">{w.element.toUpperCase()} · {w.costBand}</p>
            </div>
          </a>
        </li>
      ))}</ol>
    </section>

    {GIANT_WORKS.map((w, i) => (
      <article id={`gw-${w.id}`} class={`work work--${w.element}`} style={`--el-color: ${elementColor[w.element]};`}>
        <p class="kicker">PROJECT {String(i+1).padStart(2,'0')} · {w.element.toUpperCase()} · {w.costBand}</p>
        <h2>{w.title}</h2>
        <p class="work__tag">{w.tagline}</p>

        <h3 class="wh">Program</h3>
        <p class="wp">{w.programDescription}</p>

        <h3 class="wh">Site candidates · {w.siteCandidates.length}</h3>
        <ol class="sc-list">{w.siteCandidates.map((s) => (
          <li>
            <h4>{s.city} <span class="sc__site">— {s.site}</span></h4>
            <p>{s.rationale}</p>
          </li>
        ))}</ol>

        <h3 class="wh">Inspirations</h3>
        <ul class="ins-list">{w.inspirations.map((ins) => (<li>{ins}</li>))}</ul>

        <h3 class="wh">Trigger conditions · {w.triggerConditions.length}</h3>
        <ol class="tg-list">{w.triggerConditions.map((t) => (<li>{t}</li>))}</ol>

        <h3 class="wh">Funding path</h3>
        <p class="wp">{w.fundingPath}</p>

        <h3 class="wh">Governance</h3>
        <p class="wp">{w.governance}</p>

        <h3 class="wh">Horizons</h3>
        <ol class="hz-list">{w.horizons.map((h) => (
          <li><span class="hz__y">{h.year}</span><span>{h.milestone}</span></li>
        ))}</ol>

        <h3 class="wh">Parallel to the cases</h3>
        <p class="parallel">{w.precedentToCases}</p>
      </article>
    ))}

    <section class="fund"><p class="kicker">FUNDING PRINCIPLES · 5</p><h2>How giant works are paid for.</h2>
      <ol class="fp-list">{FUNDING_PRINCIPLES.map((p, i) => (
        <li><span class="fp__n">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="scale"><p class="kicker">SCALING PRINCIPLES · 5</p><h2>How giant works are sequenced.</h2>
      <ol class="sp-list">{SCALING_PRINCIPLES.map((p, i) => (
        <li><span class="sp__n">{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COUNCIL CONVENERS · ARCHITECTS · STEWARDS</p>
      <p>{GW_NOTES.uesNote}</p>
      <p class="invite-cta">{GW_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/forkable-radius">The Forkable Radius · framework</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/common-forms">Common Forms · Tier A/B/C</a>
      <a href="/manhattan-beach">Manhattan Beach</a>
      <a href="/hermosa-beach">Hermosa Beach</a>
      <a href="/redondo-beach">Redondo Beach</a>
      <a href="/giant-works.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --gw-ink:#1a1a1a; --gw-paper:#fdf9ee; --gw-mustard:#d4a534; --gw-rust:#b85a3a; --gw-sage:#2d6a3d; --gw-strand:#5b8aa8; --gw-violet:#5b3d7a; --gw-fog:#d8d2c4; --gw-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--gw-paper); color: var(--gw-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--gw-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--gw-violet); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--gw-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--gw-violet); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 110px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0 0 12px; }
  .audience { font-size: 13.5px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--gw-violet); max-width: 72ch; }
  .audience strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--gw-violet); margin-right: 4px; }

  section, article { padding: 28px; border-top: 4px solid var(--gw-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 28px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .tier { background: linear-gradient(135deg, #fff, var(--gw-paper)); }
  .td-dl { margin: 0; display: grid; gap: 6px; }
  .td-dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--gw-ink); border-left: 5px solid var(--gw-violet); }
  .td-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--gw-violet); padding-top: 2px; }
  .td-dl dd { margin: 0; font-size: 13.5px; line-height: 1.55; }

  .ov-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .ov a { display: grid; grid-template-columns: 50px 50px 1fr; gap: 12px; padding: 14px; background: #fff; border: 2px solid var(--gw-ink); border-left: 8px solid var(--el-color, var(--gw-violet)); text-decoration: none; color: var(--gw-ink); align-items: start; }
  .ov a:hover { background: var(--gw-paper); }
  .ov__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--el-color); }
  .ov__el { font-size: 30px; line-height: 1; color: var(--el-color); }
  .ov__body h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 4px; font-weight: 700; }
  .ov__tag { font-size: 12.5px; line-height: 1.45; margin: 0 0 6px; }
  .ov__meta { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; color: var(--gw-slate); margin: 0; }

  .work { background: linear-gradient(180deg, var(--gw-paper), #fff); border-top-color: var(--el-color, var(--gw-violet)); }
  .work .kicker { background: var(--el-color); }
  .work__tag { font-size: 16px; line-height: 1.5; font-weight: 500; max-width: 70ch; margin: 0 0 18px; padding: 12px 14px; background: #fff; border-left: 5px solid var(--el-color); }
  .wh { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--el-color); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--el-color); }
  .wp { font-size: 13.5px; line-height: 1.6; margin: 0 0 12px; max-width: 72ch; }
  .parallel { font-size: 13.5px; line-height: 1.6; padding: 12px 14px; background: var(--gw-paper); border-left: 4px solid var(--el-color); margin: 0; max-width: 72ch; }

  .sc-list, .tg-list, .hz-list, .ins-list { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; }
  .ins-list { padding-left: 22px; list-style: square; gap: 4px; }
  .ins-list li { font-size: 13px; line-height: 1.5; }
  .sc-list li { padding: 10px 12px; background: #fff; border: 2px solid var(--gw-ink); border-left: 5px solid var(--el-color); }
  .sc-list h4 { font-family: var(--pc-font-mono); font-size: 12.5px; margin: 0 0 4px; font-weight: 700; }
  .sc__site { color: var(--el-color); font-weight: 500; }
  .sc-list p { margin: 0; font-size: 12.5px; line-height: 1.5; }
  .tg-list { list-style: decimal; padding-left: 22px; }
  .tg-list li { font-size: 13px; line-height: 1.5; padding: 4px 0; }
  .hz-list li { display: grid; grid-template-columns: 100px 1fr; gap: 12px; padding: 8px 10px; background: #fff; border-left: 4px solid var(--el-color); align-items: baseline; font-size: 13px; }
  .hz__y { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--el-color); letter-spacing: .1em; }

  .fund, .scale { background: var(--gw-paper); }
  .fp-list, .sp-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .fp-list li, .sp-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--gw-ink); border-left: 6px solid var(--gw-mustard); align-items: baseline; }
  .fp__n, .sp__n { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--gw-violet); }
  .fp-list p, .sp-list p { margin: 0; font-size: 13.5px; line-height: 1.55; }

  .invitation { background: var(--gw-violet); color: var(--gw-paper); border-top-color: var(--gw-violet); }
  .invitation .kicker { background: var(--gw-mustard); color: var(--gw-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--gw-mustard); color: var(--gw-ink); border-left: 4px solid var(--gw-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--gw-violet); color: var(--gw-paper); text-decoration: none; }
  .links a:hover { background: var(--gw-rust); }

  @media (max-width: 800px) { h1 { font-size: 72px; } .ov-list { grid-template-columns: 1fr; } .td-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 50px; } .hz-list li { grid-template-columns: 1fr; } .fp-list li, .sp-list li { grid-template-columns: 1fr; } }
</style>
