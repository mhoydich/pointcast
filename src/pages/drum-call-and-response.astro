---
/**
 * /drum-call-and-response — the back-and-forth in one URL.
 *
 * Mike's Thursday brief asked for "inventive companion · channel back
 * forth". /drum-bottle handles one-way sends; this surface handles
 * the explicit conversational structure. Two 4-bar phrases in a single
 * URL — a CALL and a RESPONSE — that loop together as one back-and-forth.
 *
 * Three modes determined by URL state:
 *   1. Compose-call (no ?p=). You make the call, copy the URL,
 *      send to a friend. They get mode 2.
 *   2. Received-call (?p= with response-half all zero). You see
 *      their call, hear it loop, and add YOUR response in the
 *      second grid. Copy URL with both halves → mode 3.
 *   3. Conversation (?p= with both halves filled). Both phrases
 *      lit in their grids; play loops CALL → RESPONSE → CALL → ...
 *      "Send another call" wipes back to mode 1.
 *
 * Encoding (extends /drum-bottle's 9-byte format):
 *   call pattern   8 bytes  (4 voices × 16 cells × 1 bit, row-major)
 *   response       8 bytes  (same shape; all-zero = empty)
 *   bpm            1 byte   (offset from 40; 0..180 → 40..220)
 *   flags          1 byte   (reserved for future, currently 0)
 *   total         18 bytes  →  24 base64url chars
 *
 * `?from=<caller>-<responder>` shows the chain. If only one
 * segment, response phase. If two segments, conversation.
 *
 * Visual: stacked grids with playhead sweeping through both as one
 * 32-step loop. The boundary between rows is the moment of "the
 * other person speaks", which lets the back-and-forth read as
 * a conversation rather than two pasted-together phrases.
 *
 * Shipped 2026-05-14. Third async-drum surface (after /drum-bottle
 * and /drum-shelf). — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Drum Call & Response — the back-and-forth in one URL"
  description="Record a call, send the link. They hear it, record their answer, send it back. The whole conversation lives in one URL — two 4-bar phrases that loop together as one back-and-forth. No accounts, no server, just paste and play."
  image="/images/og-drum.png"
>
  <main class="dcr" id="dcr" data-built={built}>
    <header class="dcr__hero">
      <p class="dcr__kicker">DRUM · CALL &amp; RESPONSE · two phrases · one URL</p>
      <h1 class="dcr__title" id="dcr-title">Record a call. They answer.</h1>
      <p class="dcr__sub" id="dcr-sub">A back-and-forth conversation in a single link. You record a 4-bar call. They open it, hear it loop, and add their response in the second grid. The final URL plays both phrases as one back-and-forth — a tiny musical exchange that lives only in the link.</p>
    </header>

    <section class="dcr__stage">

      <!-- Banner: shows mode-specific context -->
      <div class="dcr__banner" id="dcr-banner" hidden>
        <span class="dcr__banner-icon" id="dcr-banner-icon">📯</span>
        <span class="dcr__banner-body">
          <span class="dcr__banner-from" id="dcr-banner-from">someone</span>
          <span class="dcr__banner-meta" id="dcr-banner-meta">4 + 4 bars · 100 BPM</span>
        </span>
        <button class="dcr__banner-action" id="dcr-banner-action" type="button">▶ play</button>
      </div>

      <!-- Grid A: the call -->
      <div class="dcr__half" id="dcr-half-call">
        <div class="dcr__half-label">
          <span class="dcr__half-tag">CALL</span>
          <span class="dcr__half-meta" id="dcr-call-meta">by you · 4 bars</span>
        </div>
        <div class="dcr__grid-wrap">
          <div class="dcr__grid" id="dcr-grid-call" role="grid" aria-label="Call pattern"></div>
          <div class="dcr__voice-labels">
            <span class="dcr__voice dcr__voice--low">▬ LOW</span>
            <span class="dcr__voice dcr__voice--mid">◆ MID</span>
            <span class="dcr__voice dcr__voice--high">▲ HIGH</span>
            <span class="dcr__voice dcr__voice--bell">✦ BELL</span>
          </div>
        </div>
      </div>

      <!-- Bridge: shows the "other person speaks" boundary -->
      <div class="dcr__bridge" id="dcr-bridge" aria-hidden="true">
        <span class="dcr__bridge-line"></span>
        <span class="dcr__bridge-arrow">↓ they answer ↓</span>
        <span class="dcr__bridge-line"></span>
      </div>

      <!-- Grid B: the response -->
      <div class="dcr__half" id="dcr-half-response">
        <div class="dcr__half-label">
          <span class="dcr__half-tag dcr__half-tag--response">RESPONSE</span>
          <span class="dcr__half-meta" id="dcr-resp-meta">— · 4 bars</span>
        </div>
        <div class="dcr__grid-wrap">
          <div class="dcr__grid" id="dcr-grid-response" role="grid" aria-label="Response pattern"></div>
          <div class="dcr__voice-labels">
            <span class="dcr__voice dcr__voice--low">▬ LOW</span>
            <span class="dcr__voice dcr__voice--mid">◆ MID</span>
            <span class="dcr__voice dcr__voice--high">▲ HIGH</span>
            <span class="dcr__voice dcr__voice--bell">✦ BELL</span>
          </div>
        </div>
      </div>

      <!-- Transport -->
      <div class="dcr__transport">
        <button class="dcr__btn dcr__btn--play" id="dcr-play" type="button">▶ play</button>
        <button class="dcr__btn dcr__btn--stop" id="dcr-stop" type="button" hidden>⏹ stop</button>
        <div class="dcr__bpm-wrap">
          <label class="dcr__bpm-label" for="dcr-bpm">BPM</label>
          <input class="dcr__bpm" id="dcr-bpm" type="range" min="60" max="180" step="2" value="100" />
          <span class="dcr__bpm-readout" id="dcr-bpm-readout">100</span>
        </div>
      </div>

      <!-- Compose-call actions -->
      <div class="dcr__actions" id="dcr-actions-call" hidden>
        <button class="dcr__action dcr__action--primary" id="dcr-send-call" type="button">↗ send the call</button>
        <a class="dcr__action" id="dcr-sms-call" href="#">↗ via iMessage</a>
        <button class="dcr__action dcr__action--ghost" id="dcr-clear-call" type="button">clear</button>
      </div>

      <!-- Respond actions -->
      <div class="dcr__actions" id="dcr-actions-respond" hidden>
        <button class="dcr__action dcr__action--primary" id="dcr-send-resp" type="button">↗ send the answer</button>
        <a class="dcr__action" id="dcr-sms-resp" href="#">↗ via iMessage</a>
        <button class="dcr__action dcr__action--ghost" id="dcr-clear-resp" type="button">clear response</button>
      </div>

      <!-- Conversation actions -->
      <div class="dcr__actions" id="dcr-actions-convo" hidden>
        <button class="dcr__action dcr__action--primary" id="dcr-new-call" type="button">✍ send another call</button>
        <button class="dcr__action" id="dcr-copy-convo" type="button">↗ copy this link</button>
        <a class="dcr__action" href="/drum-bottle">↗ /drum-bottle</a>
      </div>

    </section>

    <section class="dcr__notes">
      <h2 class="dcr__notes-h">How a call &amp; response works</h2>
      <p>The whole conversation is 18 bytes of URL: 8 bytes for your call, 8 bytes for their answer, 1 byte for BPM, 1 reserved. That's <code>?p=</code> in 24 base64url characters. Add a <code>?from=abcd-efgh</code> chain so each side knows who's speaking, and the link is complete.</p>
      <p>Three modes, decided by what's in the URL:</p>
      <ul>
        <li><strong>Empty</strong> → record your call. Copy the link, paste in iMessage.</li>
        <li><strong>Call only</strong> (response half is all zeros) → you see their call, hear it loop, add your answer in the second grid. Send back.</li>
        <li><strong>Conversation</strong> (both halves filled) → play loops <em>call → response → call → response</em> as one back-and-forth phrase.</li>
      </ul>
      <p>The <code>↓ they answer ↓</code> bridge between the grids isn't just decoration — it's the audible boundary in playback, the moment where the "voice" switches. That space is what makes the two phrases read as a conversation rather than 8 random bars.</p>
      <p>Sister surfaces: <a href="/drum-bottle">/drum-bottle</a> (single-phrase send), <a href="/drum-shelf">/drum-shelf</a> (your local history), <a href="/drum-live-bus">/drum-live-bus</a> (5 synchronous-drum surfaces).</p>
    </section>

    <div class="dcr__toast" id="dcr-toast" aria-live="polite"></div>
  </main>

  <style is:global>
    :root {
      --dcr-ink: #0a1230;
      --dcr-mid: #14193a;
      --dcr-flame: #f6c15e;
      --dcr-coral: #ff6b8a;
      --dcr-mint: #8aeac0;
      --dcr-sky: #7ac8ed;
      --dcr-mauve: #c9a8ef;
      --dcr-cream: #f4e7c8;
      --dcr-cream-dim: #b8aa84;
    }

    body:has(.dcr) {
      background:
        radial-gradient(circle at 15% 5%, #1a1e58 0%, transparent 50%),
        radial-gradient(circle at 85% 95%, #2a1640 0%, transparent 55%),
        var(--dcr-ink);
      color: var(--dcr-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dcr { max-width: 780px; margin: 0 auto; padding: 36px 24px 64px; }

    /* HERO */
    .dcr__hero { margin-bottom: 32px; }
    .dcr__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dcr-coral);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .dcr__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: clamp(32px, 5.5vw, 52px);
      letter-spacing: -0.025em;
      line-height: 1.04;
      margin: 0 0 16px;
    }
    .dcr__sub {
      font-size: 15px;
      line-height: 1.55;
      color: var(--dcr-cream-dim);
      margin: 0;
    }
    .dcr__sub a { color: var(--dcr-flame); }

    /* STAGE */
    .dcr__stage {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 18px;
      padding: 22px;
      margin-bottom: 36px;
    }

    /* BANNER */
    .dcr__banner {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      margin: 0 0 18px;
      background: rgba(122, 200, 237, 0.10);
      border: 1px solid rgba(122, 200, 237, 0.30);
      border-radius: 10px;
    }
    .dcr__banner-icon { font-size: 22px; }
    .dcr__banner-body { flex: 1; display: flex; flex-direction: column; }
    .dcr__banner-from {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: var(--dcr-sky);
    }
    .dcr__banner-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--dcr-cream-dim);
      margin-top: 2px;
    }
    .dcr__banner-action {
      border: 1px solid rgba(122, 200, 237, 0.6);
      background: rgba(122, 200, 237, 0.15);
      color: var(--dcr-sky);
      padding: 8px 14px;
      border-radius: 6px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .dcr__banner-action:hover { background: rgba(122, 200, 237, 0.25); }

    /* HALF (each grid + its label) */
    .dcr__half {
      margin-bottom: 8px;
    }
    .dcr__half-label {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 8px;
      padding-left: 4px;
    }
    .dcr__half-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dcr-flame);
      font-weight: 700;
      padding: 2px 8px;
      background: rgba(246, 193, 94, 0.15);
      border-radius: 4px;
    }
    .dcr__half-tag--response {
      color: var(--dcr-sky);
      background: rgba(122, 200, 237, 0.15);
    }
    .dcr__half-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--dcr-cream-dim);
    }
    .dcr__half--locked .dcr__grid {
      opacity: 0.5;
    }
    .dcr__half--locked .dcr__cell {
      cursor: not-allowed;
    }
    .dcr__half--locked .dcr__cell:hover {
      background: rgba(244,231,200,0.06);
    }
    .dcr__half--locked .dcr__cell--on:hover {
      background: var(--cell-color);
    }

    /* BRIDGE between grids */
    .dcr__bridge {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 4px 0;
      padding: 0 4px;
    }
    .dcr__bridge-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(244, 231, 200, 0.18), transparent);
    }
    .dcr__bridge-arrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.18em;
      color: var(--dcr-cream-dim);
      text-transform: uppercase;
    }

    /* GRID — copied & adapted from /drum-bottle */
    .dcr__grid-wrap {
      display: grid;
      grid-template-columns: 1fr 60px;
      gap: 12px;
    }
    @media (max-width: 560px) {
      .dcr__grid-wrap { grid-template-columns: 1fr 48px; gap: 8px; }
    }
    .dcr__grid {
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      grid-template-rows: repeat(4, 1fr);
      gap: 4px;
      aspect-ratio: 16 / 4;
      background: rgba(0,0,0,0.30);
      border-radius: 8px;
      padding: 6px;
    }
    .dcr__cell {
      background: rgba(244,231,200,0.06);
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 3px;
      cursor: pointer;
      transition: background 80ms ease, transform 60ms ease;
      min-width: 0;
      min-height: 0;
      padding: 0;
    }
    .dcr__cell:hover { background: rgba(244,231,200,0.16); }
    .dcr__cell--on  { background: var(--cell-color); border-color: var(--cell-color); }
    .dcr__cell--low.dcr__cell--on  { --cell-color: #f6c15e; }
    .dcr__cell--mid.dcr__cell--on  { --cell-color: #ff8a70; }
    .dcr__cell--high.dcr__cell--on { --cell-color: #c9a8ef; }
    .dcr__cell--bell.dcr__cell--on { --cell-color: #8aeac0; }
    .dcr__cell--play {
      box-shadow: 0 0 0 2px var(--dcr-cream);
      transform: scale(0.95);
    }
    .dcr__cell:nth-child(16n + 5),
    .dcr__cell:nth-child(16n + 9),
    .dcr__cell:nth-child(16n + 13) {
      margin-left: 2px;
    }

    .dcr__voice-labels {
      display: grid;
      grid-template-rows: repeat(4, 1fr);
      gap: 4px;
      padding: 6px 0;
    }
    .dcr__voice {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.12em;
      color: var(--dcr-cream-dim);
    }
    .dcr__voice--low  { color: #f6c15e; }
    .dcr__voice--mid  { color: #ff8a70; }
    .dcr__voice--high { color: #c9a8ef; }
    .dcr__voice--bell { color: #8aeac0; }

    /* TRANSPORT */
    .dcr__transport {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin: 18px 0;
    }
    .dcr__btn {
      border: 1px solid rgba(244,231,200,0.25);
      background: rgba(244,231,200,0.08);
      color: var(--dcr-cream);
      padding: 10px 18px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.02em;
    }
    .dcr__btn:hover { background: rgba(244,231,200,0.16); }
    .dcr__btn--play {
      background: rgba(246,193,94,0.15);
      border-color: rgba(246,193,94,0.45);
      color: var(--dcr-flame);
    }
    .dcr__btn--play:hover { background: rgba(246,193,94,0.25); }
    .dcr__bpm-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 220px;
    }
    .dcr__bpm-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--dcr-cream-dim);
    }
    .dcr__bpm {
      flex: 1;
      accent-color: var(--dcr-flame);
      cursor: pointer;
    }
    .dcr__bpm-readout {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      color: var(--dcr-flame);
      min-width: 32px;
      text-align: right;
    }

    /* ACTIONS */
    .dcr__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .dcr__action {
      flex: 0 0 auto;
      border: 1px solid rgba(244,231,200,0.18);
      background: rgba(244,231,200,0.06);
      color: var(--dcr-cream);
      padding: 10px 16px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
    }
    .dcr__action:hover {
      background: rgba(244,231,200,0.14);
      border-color: rgba(244,231,200,0.35);
    }
    .dcr__action--primary {
      background: rgba(255,107,138,0.15);
      border-color: rgba(255,107,138,0.45);
      color: var(--dcr-coral);
    }
    .dcr__action--primary:hover { background: rgba(255,107,138,0.25); }
    .dcr__action--ghost {
      color: var(--dcr-cream-dim);
      background: transparent;
      border-color: rgba(244,231,200,0.10);
    }

    /* NOTES */
    .dcr__notes { max-width: 700px; }
    .dcr__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dcr-cream);
      margin: 0 0 12px;
    }
    .dcr__notes p, .dcr__notes li {
      font-size: 14px;
      line-height: 1.6;
      color: var(--dcr-cream-dim);
      margin: 0 0 12px;
    }
    .dcr__notes ul { list-style: none; padding-left: 0; margin: 0 0 12px; }
    .dcr__notes li { padding-left: 18px; position: relative; margin-bottom: 6px; }
    .dcr__notes li::before { content: '·'; position: absolute; left: 6px; color: var(--dcr-flame); }
    .dcr__notes em { color: var(--dcr-flame); font-style: italic; }
    .dcr__notes strong { color: var(--dcr-cream); font-weight: 600; }
    .dcr__notes code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--dcr-mint);
    }
    .dcr__notes a {
      color: var(--dcr-coral);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* TOAST */
    .dcr__toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: rgba(0,0,0,0.85);
      color: var(--dcr-flame);
      padding: 10px 18px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.04em;
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease, transform 240ms ease;
      z-index: 50;
      border: 1px solid rgba(246,193,94,0.4);
    }
    .dcr__toast--show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const ROWS = 4;
    const STEPS = 16;
    const TOTAL_STEPS = STEPS * 2;  // call + response = 32 step loop
    const VOICE_NAMES = ['low', 'mid', 'high', 'bell'] as const;
    type Voice = typeof VOICE_NAMES[number];
    type Half = 'call' | 'response';

    // ---- state ----
    let callPattern: boolean[][] = blank();
    let respPattern: boolean[][] = blank();
    let bpm = 100;
    let mode: 'compose-call' | 'received-call' | 'conversation' = 'compose-call';
    let callerPid = '';
    let responderPid = '';
    let myPid = '';

    let isPlaying = false;
    let playStep = 0;  // 0..31
    let playTimer: number | null = null;

    function blank(): boolean[][] {
      return Array.from({ length: ROWS }, () => Array(STEPS).fill(false));
    }
    function patternEmpty(p: boolean[][]): boolean {
      for (let r = 0; r < ROWS; r++) for (let c = 0; c < STEPS; c++) if (p[r][c]) return false;
      return true;
    }

    // ---- URL codec ----
    // 18 bytes: 8 call + 8 response + 1 bpm + 1 flags = 24 base64url chars
    function encodeFull(a: boolean[][], b: boolean[][], bp: number): string {
      const bytes = new Uint8Array(18);
      // a: bytes 0..7
      for (let r = 0; r < ROWS; r++) for (let c = 0; c < STEPS; c++) {
        if (a[r][c]) { const i = r * STEPS + c; bytes[i >> 3] |= (1 << (i & 7)); }
      }
      // b: bytes 8..15
      for (let r = 0; r < ROWS; r++) for (let c = 0; c < STEPS; c++) {
        if (b[r][c]) { const i = r * STEPS + c; bytes[8 + (i >> 3)] |= (1 << (i & 7)); }
      }
      bytes[16] = Math.max(0, Math.min(180, bp - 40));
      bytes[17] = 0;  // flags reserved
      let bin = '';
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }
    function decodeFull(code: string): { call: boolean[][]; resp: boolean[][]; bpm: number } | null {
      if (!code) return null;
      const b64 = code.replace(/-/g, '+').replace(/_/g, '/');
      const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
      let bin: string;
      try { bin = atob(padded); } catch { return null; }
      if (bin.length < 17) return null;  // accept 17 or 18 (legacy / future)
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const a = blank();
      const b = blank();
      for (let r = 0; r < ROWS; r++) for (let c = 0; c < STEPS; c++) {
        const i = r * STEPS + c;
        a[r][c] = !!(bytes[i >> 3] & (1 << (i & 7)));
        b[r][c] = !!(bytes[8 + (i >> 3)] & (1 << (i & 7)));
      }
      const bp = 40 + bytes[16];
      if (bp < 40 || bp > 220) return null;
      return { call: a, resp: b, bpm: bp };
    }

    // ---- grid render ----
    function renderHalf(half: Half) {
      const id = half === 'call' ? 'dcr-grid-call' : 'dcr-grid-response';
      const wrap = document.getElementById(id)!;
      const pattern = half === 'call' ? callPattern : respPattern;
      wrap.innerHTML = '';
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < STEPS; c++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = `dcr__cell dcr__cell--${VOICE_NAMES[r]}` + (pattern[r][c] ? ' dcr__cell--on' : '');
          cell.dataset.half = half;
          cell.dataset.row = String(r);
          cell.dataset.col = String(c);
          cell.setAttribute('role', 'gridcell');
          cell.addEventListener('click', (e) => {
            e.preventDefault();
            toggle(half, r, c);
          });
          wrap.appendChild(cell);
        }
      }
    }

    function toggle(half: Half, r: number, c: number) {
      // Mode-aware: only allow edits to the half the user owns right now
      if (mode === 'compose-call' && half !== 'call') return;
      if (mode === 'received-call' && half !== 'response') return;
      if (mode === 'conversation') return;  // read-only
      const p = half === 'call' ? callPattern : respPattern;
      p[r][c] = !p[r][c];
      const sel = `.dcr__cell[data-half="${half}"][data-row="${r}"][data-col="${c}"]`;
      const cell = document.querySelector(sel)!;
      cell.classList.toggle('dcr__cell--on', p[r][c]);
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    const VOICE_CFG: Record<Voice, { freq: number; bell: boolean }> = {
      low:  { freq:  70, bell: false },
      mid:  { freq: 120, bell: false },
      high: { freq: 200, bell: false },
      bell: { freq: 600, bell: true  },
    };
    function playVoice(voice: Voice) {
      ensureCtx();
      if (!ctx || !scheduler || !masterGain) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const cfg = VOICE_CFG[voice];
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = cfg.bell ? 'sine' : 'triangle';
      osc.frequency.value = cfg.freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.5, t + 0.004);
      const tail = cfg.bell ? 1.0 : 0.35;
      g.gain.exponentialRampToValueAtTime(0.0001, t + tail);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + tail + 0.05);
      if (cfg.bell) {
        for (const mult of [2, 3]) {
          const o = ctx.createOscillator();
          const gg = ctx.createGain();
          o.type = 'sine';
          o.frequency.value = cfg.freq * mult;
          gg.gain.setValueAtTime(0.0001, t);
          gg.gain.exponentialRampToValueAtTime(0.14 / mult, t + 0.008);
          gg.gain.exponentialRampToValueAtTime(0.0001, t + 0.7 / mult);
          o.connect(gg).connect(masterGain);
          scheduler.trackSource(o);
          o.start(t);
          o.stop(t + 0.75);
        }
      }
    }

    // ---- transport ----
    function stepDurationMs() {
      return (60_000 / bpm) / 4;
    }
    function tick() {
      // Clear prior playhead
      document.querySelectorAll('.dcr__cell--play').forEach((el) => el.classList.remove('dcr__cell--play'));
      const half: Half = playStep < STEPS ? 'call' : 'response';
      const localStep = playStep < STEPS ? playStep : playStep - STEPS;
      const p = half === 'call' ? callPattern : respPattern;
      const gridId = half === 'call' ? 'dcr-grid-call' : 'dcr-grid-response';
      const grid = document.getElementById(gridId)!;
      for (let r = 0; r < ROWS; r++) {
        const cell = grid.children[r * STEPS + localStep] as HTMLElement;
        if (cell) cell.classList.add('dcr__cell--play');
        if (p[r][localStep]) playVoice(VOICE_NAMES[r]);
      }
      playStep = (playStep + 1) % TOTAL_STEPS;
    }
    function startPlay() {
      if (isPlaying) return;
      ensureCtx();
      isPlaying = true;
      playStep = 0;
      document.getElementById('dcr-play')!.hidden = true;
      document.getElementById('dcr-stop')!.hidden = false;
      tick();
      const loop = () => {
        if (!isPlaying) return;
        tick();
        playTimer = window.setTimeout(loop, stepDurationMs());
      };
      playTimer = window.setTimeout(loop, stepDurationMs());
    }
    function stopPlay() {
      isPlaying = false;
      if (playTimer != null) { clearTimeout(playTimer); playTimer = null; }
      document.querySelectorAll('.dcr__cell--play').forEach((el) => el.classList.remove('dcr__cell--play'));
      document.getElementById('dcr-play')!.hidden = false;
      document.getElementById('dcr-stop')!.hidden = true;
    }

    // ---- share link ----
    function shareUrl(): string {
      const code = encodeFull(callPattern, respPattern, bpm);
      const base = `${location.origin}/drum-call-and-response?p=${code}`;
      let from = '';
      if (mode === 'compose-call') from = myPid.slice(0, 4);
      else if (mode === 'received-call') from = `${callerPid}-${myPid.slice(0, 4)}`;
      else from = callerPid + (responderPid ? `-${responderPid}` : '');
      return from ? `${base}&from=${from}` : base;
    }
    function smsHref(): string {
      return `sms:&body=${encodeURIComponent('🥁 ' + shareUrl())}`;
    }

    async function copyText(text: string, successMsg: string) {
      const blob = navigator.clipboard;
      try {
        if (blob && blob.writeText) {
          await blob.writeText(text);
          showToast(successMsg);
        } else {
          throw new Error('no clipboard');
        }
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); showToast(successMsg); }
        catch { showToast(text); }
        finally { ta.remove(); }
      }
    }

    function showToast(msg: string) {
      const el = document.getElementById('dcr-toast')!;
      el.textContent = msg;
      el.classList.add('dcr__toast--show');
      setTimeout(() => el.classList.remove('dcr__toast--show'), 2400);
    }

    // ---- session/pid ----
    async function sha256Hex(input: string): Promise<string> {
      const buf = new TextEncoder().encode(input);
      const hash = await crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(hash))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }
    function getOrCreateSession(): string {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }

    // ---- mode plumbing ----
    function setMode(m: typeof mode) {
      mode = m;
      const halfCall = document.getElementById('dcr-half-call')!;
      const halfResp = document.getElementById('dcr-half-response')!;
      const banner = document.getElementById('dcr-banner')!;
      const actCall  = document.getElementById('dcr-actions-call')!;
      const actResp  = document.getElementById('dcr-actions-respond')!;
      const actConvo = document.getElementById('dcr-actions-convo')!;
      const callMeta = document.getElementById('dcr-call-meta')!;
      const respMeta = document.getElementById('dcr-resp-meta')!;
      const title = document.getElementById('dcr-title')!;
      const sub   = document.getElementById('dcr-sub')!;
      const bannerFrom = document.getElementById('dcr-banner-from')!;
      const bannerMeta = document.getElementById('dcr-banner-meta')!;
      const bannerIcon = document.getElementById('dcr-banner-icon')!;
      const bpmInput = document.getElementById('dcr-bpm') as HTMLInputElement;

      // Reset visibility
      banner.hidden = true;
      actCall.hidden = true;
      actResp.hidden = true;
      actConvo.hidden = true;
      halfCall.classList.remove('dcr__half--locked');
      halfResp.classList.remove('dcr__half--locked');

      if (m === 'compose-call') {
        title.textContent = 'Record a call. They answer.';
        sub.innerHTML = 'A back-and-forth conversation in a single link. Toggle cells in <strong>CALL</strong> to compose. Press the copy button. Send the link.';
        halfResp.classList.add('dcr__half--locked');
        actCall.hidden = false;
        callMeta.textContent = 'by you · 4 bars';
        respMeta.textContent = '— waiting for the answer —';
        bpmInput.disabled = false;
        updateSmsLink('dcr-sms-call');
      } else if (m === 'received-call') {
        title.textContent = 'You received a call.';
        sub.innerHTML = 'Hear it loop. Add your answer in <strong>RESPONSE</strong>. Send the full conversation back.';
        halfCall.classList.add('dcr__half--locked');
        banner.hidden = false;
        bannerIcon.textContent = '📯';
        bannerFrom.textContent = callerPid ? `call from ${callerPid}` : 'call from someone';
        bannerMeta.textContent = `4 bars · ${bpm} BPM · awaiting your answer`;
        actResp.hidden = false;
        callMeta.textContent = `from ${callerPid || 'someone'} · 4 bars`;
        respMeta.textContent = 'by you · 4 bars';
        bpmInput.value = String(bpm);
        document.getElementById('dcr-bpm-readout')!.textContent = String(bpm);
        bpmInput.disabled = true;
        updateSmsLink('dcr-sms-resp');
      } else {
        title.textContent = 'A drum conversation.';
        sub.innerHTML = `<strong>${callerPid || 'someone'}</strong> called. <strong>${responderPid || 'someone'}</strong> answered. Press play to hear them loop.`;
        halfCall.classList.add('dcr__half--locked');
        halfResp.classList.add('dcr__half--locked');
        banner.hidden = false;
        bannerIcon.textContent = '🔁';
        bannerFrom.textContent = `${callerPid || '?'} → ${responderPid || '?'}`;
        bannerMeta.textContent = `4 + 4 bars · ${bpm} BPM · loops`;
        actConvo.hidden = false;
        callMeta.textContent = `from ${callerPid || '?'} · 4 bars`;
        respMeta.textContent = `from ${responderPid || '?'} · 4 bars`;
        bpmInput.value = String(bpm);
        document.getElementById('dcr-bpm-readout')!.textContent = String(bpm);
        bpmInput.disabled = true;
      }

      renderHalf('call');
      renderHalf('response');
    }

    function updateSmsLink(id: string) {
      const a = document.getElementById(id) as HTMLAnchorElement | null;
      if (a) a.href = smsHref();
    }

    // ---- init ----
    async function init() {
      const sessionId = getOrCreateSession();
      myPid = (await sha256Hex(sessionId)).slice(0, 10);

      const params = new URLSearchParams(location.search);
      const code = params.get('p') || '';
      const fromChain = (params.get('from') || '').replace(/[^a-z0-9-]/gi, '');
      const fromParts = fromChain.split('-').filter(Boolean);
      callerPid = fromParts[0] ? fromParts[0].slice(0, 4) : '';
      responderPid = fromParts[1] ? fromParts[1].slice(0, 4) : '';

      if (code) {
        const decoded = decodeFull(code);
        if (decoded) {
          callPattern = decoded.call;
          respPattern = decoded.resp;
          bpm = decoded.bpm;
          if (patternEmpty(respPattern)) {
            setMode('received-call');
          } else {
            setMode('conversation');
          }
        } else {
          setMode('compose-call');
          showToast('couldn\'t decode that conversation');
        }
      } else {
        setMode('compose-call');
      }

      // Transport
      document.getElementById('dcr-play')!.addEventListener('click', () => startPlay());
      document.getElementById('dcr-stop')!.addEventListener('click', () => stopPlay());
      document.getElementById('dcr-banner-action')!.addEventListener('click', () => {
        if (isPlaying) stopPlay(); else startPlay();
      });

      // BPM
      const bpmInput = document.getElementById('dcr-bpm') as HTMLInputElement;
      bpmInput.addEventListener('input', () => {
        if (mode !== 'compose-call') return;
        bpm = parseInt(bpmInput.value, 10) || 100;
        document.getElementById('dcr-bpm-readout')!.textContent = String(bpm);
        updateSmsLink('dcr-sms-call');
      });

      // Compose-call actions
      document.getElementById('dcr-send-call')!.addEventListener('click', () => {
        copyText(shareUrl(), `copied · 24 chars`);
      });
      document.getElementById('dcr-clear-call')!.addEventListener('click', () => {
        callPattern = blank();
        renderHalf('call');
      });

      // Respond actions
      document.getElementById('dcr-send-resp')!.addEventListener('click', () => {
        if (patternEmpty(respPattern)) {
          showToast('add some cells to your response first');
          return;
        }
        copyText(shareUrl(), `copied · the conversation is complete`);
      });
      document.getElementById('dcr-clear-resp')!.addEventListener('click', () => {
        respPattern = blank();
        renderHalf('response');
      });

      // Conversation actions
      document.getElementById('dcr-new-call')!.addEventListener('click', () => {
        stopPlay();
        callPattern = blank();
        respPattern = blank();
        bpm = 100;
        callerPid = '';
        responderPid = '';
        try {
          const u = new URL(location.href);
          u.searchParams.delete('p');
          u.searchParams.delete('from');
          history.replaceState({}, '', u.toString());
        } catch { /* ignore */ }
        setMode('compose-call');
        showToast('blank slate · make a new call');
      });
      document.getElementById('dcr-copy-convo')!.addEventListener('click', () => {
        copyText(location.href, 'copied this conversation\'s link');
      });

      // Keyboard
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (isPlaying) stopPlay(); else startPlay();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
