---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import exhibition from '../data/other-worlds.json';
import { formatOtherWorldsDeadline } from '../lib/other-worlds-deadline';

const canonical = 'https://pointcast.xyz/other-worlds';
const description = 'Nine metaphysical Los Angeles poster works by Michael Hoydich. 27 editions of each. Choose one free artwork; Pointcast covers the Tezos transaction fees.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: exhibition.title,
  description,
  url: canonical,
  creator: { '@type': 'Person', name: exhibition.artist },
  publisher: { '@type': 'Organization', name: exhibition.publisher, url: 'https://pointcast.xyz' },
  hasPart: exhibition.artworks.map((art) => ({
    '@type': 'VisualArtwork', name: art.title, description: art.description,
    artform: 'Digital poster', artMedium: 'Still image', artworkSurface: 'Digital',
    image: `https://pointcast.xyz${art.image}`, url: `${canonical}#${art.slug}`,
    creator: { '@type': 'Person', name: exhibition.artist },
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe8" />
    <meta name="author" content="Michael Hoydich" />
    <title>LOS ANGELES / OTHER WORLDS — Nine Transmissions by Michael Hoydich</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/json" href="/collectibles/other-worlds/manifest.json" title="Exhibition provenance" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={exhibition.title} />
    <meta property="og:description" content="Nine Transmissions by Michael Hoydich. SAME CITY. OTHER WORLDS." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://pointcast.xyz${exhibition.artworks[0].image}`} />
    <meta property="og:image:alt" content={exhibition.artworks[0].alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#transmissions">Skip to the artworks</a>
    <main data-other-worlds data-closes-at={exhibition.closesAt}>
      <div class="atmosphere" aria-hidden="true"><span></span><span></span></div>
      <nav class="exhibition-nav shell" aria-label="Exhibition navigation">
        <a class="publisher" href="/" aria-label="Pointcast home">pointcast<span>EXHIBITIONS</span></a>
        <a class="nav-link" href="#about">ABOUT THE EDITION <span aria-hidden="true">↗</span></a>
      </nav>

      <header class="masthead shell">
        <div class="masthead-top mono"><p>AN EXHIBITION IN NINE TRANSMISSIONS</p><p>34.0522° N &nbsp; 118.2437° W</p></div>
        <h1><span>LOS ANGELES <b aria-hidden="true">/</b></span><span class="other-worlds">OTHER WORLDS</span></h1>
        <div class="masthead-bottom">
          <div><p class="artist-credit">BY MICHAEL HOYDICH</p><p class="collection-line">SAME CITY. OTHER WORLDS.</p></div>
          <p class="intro">The city you know.<br />A frequency you haven’t found.</p>
          <a class="enter-link mono" href="#transmissions">EXPLORE THE NINE <span aria-hidden="true">↓</span></a>
        </div>
      </header>

      <section class="exhibition-status shell" aria-label="Claim availability">
        <p class="status-label mono"><span class="status-dot" aria-hidden="true"></span><span data-drop-status>EXHIBITION PREVIEW</span></p>
        <p class="edition-summary"><strong>9 works</strong><span aria-hidden="true">/</span>27 editions each<span aria-hidden="true">/</span>One free claim per wallet</p>
        <p class="closing-note">Claims close <time datetime={exhibition.closesAt}>{formatOtherWorldsDeadline(exhibition.closesAt, true)}</time></p>
      </section>

      <section id="transmissions" class="gallery shell" aria-labelledby="gallery-title">
        <div class="gallery-heading"><h2 id="gallery-title">Nine Transmissions <span>by Michael Hoydich</span></h2><span class="mono">01 — 09</span></div>
        <ol class="art-grid">
          {exhibition.artworks.map((art, i) => (
            <li class="art-card" id={art.slug} data-artwork-id={art.id}>
              <a class="art-image-link" href={art.image} data-open-artwork={art.id} aria-label={`View ${art.title}, transmission ${art.number} of 9`}>
                <div class="art-mat">
                  <img src={art.preview} alt={art.alt} width="1024" height="1536" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
                  <span class="view-art mono">VIEW TRANSMISSION <span aria-hidden="true">↗</span></span>
                </div>
              </a>
              <div class="art-caption"><span class="art-number mono">{String(art.number).padStart(2, '0')}</span><div><h3><a href={art.image} data-open-artwork={art.id}>{art.title}</a></h3><p class="art-editions" data-edition-count={art.id}>27 editions</p></div><button class="art-select" type="button" data-open-artwork={art.id} aria-label={`Choose ${art.title}`}><span aria-hidden="true">↗</span></button></div>
              <p class="art-description">{art.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="about" class="about shell" aria-labelledby="about-title">
        <div class="about-art"><div class="orbital" aria-hidden="true"><span></span><i></i></div><p class="mono">A DIFFERENT FREQUENCY.<br />THE SAME PLACE.</p></div>
        <div class="about-copy"><p class="eyebrow mono">LOS ANGELES / OTHER WORLDS</p><h2 id="about-title">A city. Nine ways<br />to leave the ordinary.</h2><p>Water holds another sky. Freeways forget where they’re going. An arch opens onto the ocean. Nine still images find a little strangeness in the familiar geometry of Los Angeles.</p><p>Each work is an edition of 27. Choose the transmission that stays with you.</p><div class="claim-facts"><div><span class="mono">YOUR COST</span><strong>0 ꜩ</strong><p>Pointcast pays the Tezos transaction fees.</p></div><div><span class="mono">YOUR EDITION</span><strong>One of 27</strong><p>One free artwork per wallet, across all nine works.</p></div></div></div>
      </section>

      <section class="notes shell" aria-label="Collecting and provenance">
        <div><p class="mono">01 / CHOOSE</p><h3>Find your transmission.</h3><p>Open any artwork to see it in full and choose your edition. There are 243 editions in the exhibition.</p></div>
        <div><p class="mono">02 / SIGN</p><h3>Your wallet. Your signature.</h3><p>Connect Kukai or another Tezos wallet. Approve a free message signature to confirm wallet control. Your wallet does not pay or submit a transaction.</p></div>
        <div><p class="mono">03 / KEEP</p><h3>A still image, on Tezos.</h3><p>Pointcast delivers the artwork and covers the network fee. A claim is confirmed only when its delivery is verified on Tezos.</p></div>
      </section>

      <footer class="exhibition-footer shell"><div><p class="footer-line">SAME CITY. OTHER WORLDS.</p><p class="mono">BY MICHAEL HOYDICH &nbsp; · &nbsp; LOS ANGELES, 2026</p></div><div class="footer-links"><a href="/collectibles/other-worlds/manifest.json">Metadata &amp; provenance ↗</a><a href="/collectibles/other-worlds/SHA256SUMS">SHA-256 checksums ↗</a><a href="/">Published by Pointcast ↗</a></div></footer>
      <noscript><p class="noscript-note shell">The complete exhibition is available without JavaScript. Enable JavaScript to connect a wallet and claim an artwork.</p></noscript>
      <dialog class="art-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-description" data-art-dialog>
        <button class="dialog-close" type="button" data-close-dialog aria-label="Close artwork">×</button>
        <div class="dialog-image"><img data-dialog-image src={exhibition.artworks[0].preview} alt={exhibition.artworks[0].alt} width="1024" height="1536" /></div>
        <div class="dialog-details"><p class="eyebrow mono" data-dialog-number>TRANSMISSION 01 / 09</p><h2 id="dialog-title" data-dialog-title>{exhibition.artworks[0].title}</h2><p class="dialog-credit mono">BY MICHAEL HOYDICH</p><p id="dialog-description" data-dialog-description>{exhibition.artworks[0].description}</p><p class="dialog-edition" data-dialog-editions>Edition of 27</p>
          <div class="claim-desk"><div class="claim-cost"><span>Your cost</span><strong>0 ꜩ</strong></div><p class="fee-note">Pointcast covers the transaction fee.<br />One free claim per wallet.</p><p class="wallet-address mono" data-wallet-address hidden></p><button class="claim-button" type="button" data-claim-button disabled>Checking availability…</button><p class="claim-message" role="status" aria-live="polite" aria-atomic="true" data-claim-message>Checking the exhibition’s claim desk.</p><a class="receipt-link" data-receipt-link hidden target="_blank" rel="noopener noreferrer">View delivery on Tezos ↗</a><button class="retry-button" data-retry-button type="button" hidden>Check delivery again</button></div>
          <div class="dialog-links"><a data-original-link href={exhibition.artworks[0].image} target="_blank" rel="noopener noreferrer">Open full-size image ↗</a><a data-metadata-link href={exhibition.artworks[0].metadata} target="_blank" rel="noopener noreferrer">Artwork metadata ↗</a></div>
          <p class="dialog-deadline">Claims close <time datetime={exhibition.closesAt}>{formatOtherWorldsDeadline(exhibition.closesAt)}</time>.</p>
          <nav class="dialog-navigation" aria-label="Browse artworks"><button type="button" data-previous-artwork aria-label="Previous artwork">← Previous</button><button type="button" data-next-artwork aria-label="Next artwork">Next →</button></nav>
        </div>
      </dialog>
    </main>
    <script>
      import exhibition from '../data/other-worlds.json';
      import { mountOtherWorlds } from '../lib/other-worlds-client';
      const root = document.querySelector<HTMLElement>('[data-other-worlds]');
      if (root) mountOtherWorlds(root, exhibition.artworks);
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; --ow-paper:#f2efe8; --ow-ink:#27251f; --ow-muted:#706e64; --ow-line:#cecbc0; --ow-accent:#a44f35; --ow-sans:'Inter Variable',Arial,sans-serif; --ow-mono:'JetBrains Mono Variable',monospace; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; scroll-padding-top:30px; }
  body { margin:0; background:var(--ow-paper); color:var(--ow-ink); font:400 15px/1.6 var(--ow-sans); -webkit-font-smoothing:antialiased; }
  button,a { -webkit-tap-highlight-color:transparent; }
  a { color:inherit; text-decoration:none; }
  button { font:inherit; }
  button,a { touch-action:manipulation; }
  button { cursor:pointer; }
  button:disabled { cursor:default; }
  button:focus-visible,a:focus-visible { outline:2px solid var(--ow-accent); outline-offset:5px; }
  [hidden] { display:none !important; }
  p,h1,h2,h3,figure { margin:0; }
  .shell { width:min(1440px,calc(100% - 112px)); margin-inline:auto; }
  .mono { font:400 10px/1.6 var(--ow-mono); letter-spacing:.08em; }
  .skip-link { position:fixed; z-index:9; top:-80px; left:16px; background:var(--ow-ink); color:white; padding:12px 20px; }
  .skip-link:focus { top:16px; }
  main { position:relative; isolation:isolate; overflow:hidden; }
  .atmosphere { position:absolute; z-index:-1; inset:0 0 auto; height:820px; overflow:hidden; pointer-events:none; }
  .atmosphere span { position:absolute; border-radius:50%; filter:blur(68px); opacity:.35; width:480px; height:420px; background:#e2ceb4; top:-270px; left:45%; animation:atmosphere 24s ease-in-out infinite alternate; }
  .atmosphere span+span { background:#cccbd6; top:150px; left:75%; width:310px; height:360px; opacity:.2; animation-delay:-12s; }
  @keyframes atmosphere { to { transform:translate(-70px,55px); opacity:.48; } }
  .exhibition-nav { display:flex; justify-content:space-between; align-items:center; height:104px; border-bottom:1px solid var(--ow-line); }
  .publisher { font-size:20px; letter-spacing:-.06em; font-weight:570; display:flex; align-items:center; gap:23px; }
  .publisher span { font:400 9px var(--ow-mono); letter-spacing:.14em; color:var(--ow-muted); padding-left:23px; border-left:1px solid var(--ow-line); }
  .nav-link { font:400 9px var(--ow-mono); letter-spacing:.07em; }
  .nav-link span { margin-left:19px; font-size:16px; }
  .masthead { padding:43px 0 45px; }
  .masthead-top { display:flex; justify-content:space-between; color:var(--ow-muted); margin-bottom:30px; }
  h1 { font-size:clamp(60px,8.4vw,128px); letter-spacing:-.077em; font-weight:400; line-height:.94; }
  h1 span { display:block; }
  h1 b { font-weight:260; margin-left:.025em; color:#aca08b; }
  h1 .other-worlds { font:italic 400 1.13em/.94 Georgia,'Times New Roman',serif; letter-spacing:-.065em; color:var(--ow-accent); margin-top:3px; padding-right:.1em; }
  .masthead-bottom { display:grid; grid-template-columns:1fr 1fr auto; align-items:end; gap:30px; padding-top:37px; }
  .artist-credit { font-size:12px; letter-spacing:.09em; font-weight:540; }
  .collection-line { color:var(--ow-muted); font:400 10px/1.6 var(--ow-mono); letter-spacing:.04em; margin-top:8px; }
  .intro { justify-self:center; color:var(--ow-muted); font-size:14px; line-height:1.6; }
  .enter-link { padding-bottom:5px; border-bottom:1px solid var(--ow-ink); display:flex; gap:26px; }
  .enter-link span { font-size:18px; line-height:1; }
  .exhibition-status { border-block:1px solid var(--ow-line); display:flex; gap:20px; align-items:center; justify-content:space-between; min-height:70px; }
  .status-label { display:flex; align-items:center; gap:9px; min-width:190px; }
  .status-dot { width:6px; height:6px; border-radius:50%; background:#9c7e59; box-shadow:0 0 0 4px #9c7e5914; }
  [data-phase="open"] .status-dot { background:#5b775b; box-shadow:0 0 0 4px #5b775b17; }
  .edition-summary { display:flex; gap:10px; align-items:center; color:var(--ow-muted); font-size:11px; }
  .edition-summary strong { color:var(--ow-ink); font-weight:500; }
  .edition-summary > span { color:#b6b2a7; }
  .closing-note { color:var(--ow-muted); font-size:10px; }
  .closing-note time { color:var(--ow-ink); }
  .gallery { padding:43px 0 96px; }
  .gallery-heading { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:27px; }
  .gallery-heading h2 { font-size:15px; font-weight:480; letter-spacing:-.02em; }
  .gallery-heading h2 span { font-size:11px; color:var(--ow-muted); font-weight:400; margin-left:8px; }
  .gallery-heading >span { color:var(--ow-muted); }
  .art-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:33px; row-gap:51px; padding:0; margin:0; list-style:none; }
  .art-image-link { display:block; }
  .art-mat { background:#e5e1d8; padding:15px; position:relative; aspect-ratio:2/3; overflow:hidden; }
  .art-mat img { width:100%; height:100%; display:block; object-fit:contain; box-shadow:0 3px 12px #2c253a12; }
  .view-art { position:absolute; bottom:26px; left:26px; right:26px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center; background:#f6f2e9f0; opacity:0; transform:translateY(4px); transition:opacity .2s,transform .2s; }
  .art-image-link:hover .view-art,.art-image-link:focus-visible .view-art { opacity:1; transform:translateY(0); }
  .art-caption { display:flex; align-items:start; gap:12px; margin-top:18px; }
  .art-number { color:var(--ow-accent); padding-top:3px; }
  .art-caption h3 { font-weight:450; font-size:15px; letter-spacing:-.025em; line-height:1.4; }
  .art-editions { color:var(--ow-muted); font-size:10px; margin-top:4px; }
  .art-select { margin-left:auto; border:1px solid var(--ow-line); border-radius:50%; width:29px; height:29px; padding:0; background:transparent; flex-shrink:0; color:var(--ow-muted); transition:background .15s,color .15s; }
  .art-select:hover { background:var(--ow-ink); color:var(--ow-paper); }
  .art-description { color:var(--ow-muted); font-size:11px; line-height:1.6; margin:12px 0 0 26px; max-width:35ch; }
  .about { padding:65px 0 68px; border-top:1px solid var(--ow-line); border-bottom:1px solid var(--ow-line); display:grid; grid-template-columns:1fr 1.08fr; gap:10%; }
  .about-art { display:flex; align-items:center; justify-content:center; flex-direction:column; gap:25px; }
  .about-art p { color:var(--ow-muted); text-align:center; font-size:9px; }
  .orbital { position:relative; width:225px; height:225px; border:1px solid #b1a387; border-radius:50%; }
  .orbital:before,.orbital:after { content:''; position:absolute; inset:25px; border:1px solid #c0b59f; border-radius:50%; }
  .orbital:after { inset:50px; }
  .orbital span { position:absolute; width:45px; height:45px; background:radial-gradient(circle at 40% 35%,#c6875d,#a55435); top:50%; left:50%; transform:translate(-50%,-50%); border-radius:50%; }
  .orbital i { position:absolute; inset:0; animation:orbit 110s linear infinite; }
  .orbital i:after { content:''; position:absolute; width:9px; height:9px; background:var(--ow-accent); border-radius:50%; top:29px; left:29px; }
  @keyframes orbit { to { transform:rotate(360deg); } }
  .eyebrow { color:var(--ow-muted); }
  .about-copy h2 { font:400 42px/1.07 Georgia,'Times New Roman',serif; letter-spacing:-.04em; margin:18px 0 22px; }
  .about-copy >p:not(.eyebrow) { font-size:13px; color:var(--ow-muted); max-width:48ch; margin-bottom:14px; }
  .claim-facts { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:30px; padding-top:24px; border-top:1px solid var(--ow-line); }
  .claim-facts strong { display:block; font-size:24px; font-weight:400; letter-spacing:-.04em; margin:7px 0; }
  .claim-facts .mono { color:var(--ow-muted); font-size:9px; }
  .claim-facts p { color:var(--ow-muted); font-size:11px; max-width:23ch; }
  .notes { display:grid; grid-template-columns:repeat(3,1fr); gap:65px; padding:47px 0 63px; }
  .notes .mono { color:var(--ow-accent); font-size:9px; }
  .notes h3 { font-weight:500; font-size:13px; margin:12px 0 8px; }
  .notes div>p:last-child { color:var(--ow-muted); font-size:11px; line-height:1.8; max-width:38ch; }
  .exhibition-footer { padding:35px 0 43px; border-top:1px solid var(--ow-ink); display:flex; justify-content:space-between; gap:35px; }
  .footer-line { font:italic 400 25px Georgia,'Times New Roman',serif; letter-spacing:-.035em; margin-bottom:14px; }
  .exhibition-footer .mono { color:var(--ow-muted); font-size:9px; }
  .footer-links { display:flex; flex-direction:column; align-items:end; gap:6px; font-size:10px; color:var(--ow-muted); }
  .footer-links a:hover,.dialog-links a:hover { text-decoration:underline; }
  .noscript-note { padding-bottom:32px; font-size:12px; }
  .art-dialog { position:fixed; padding:0; border:0; width:min(1080px,calc(100% - 64px)); max-height:calc(100dvh - 64px); overflow:auto; background:var(--ow-paper); color:var(--ow-ink); box-shadow:0 20px 100px #1d1a2160; }
  .art-dialog[open] { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(320px,1fr); }
  .art-dialog::backdrop { background:#242129b8; backdrop-filter:blur(8px); }
  .dialog-close { position:absolute; z-index:2; right:16px; top:14px; border:1px solid var(--ow-line); background:var(--ow-paper); color:var(--ow-ink); border-radius:50%; width:34px; height:34px; font-size:24px; line-height:1; }
  .dialog-image { padding:30px; background:#e2dfd6; display:flex; align-items:center; justify-content:center; min-width:0; }
  .dialog-image img { display:block; width:100%; height:auto; max-height:calc(100dvh - 124px); object-fit:contain; box-shadow:0 4px 22px #33253e14; }
  .dialog-details { padding:58px 40px 30px; }
  .dialog-details h2 { font:400 39px/1.02 Georgia,'Times New Roman',serif; letter-spacing:-.045em; margin:20px 0 17px; }
  .dialog-credit { font-size:9px; }
  #dialog-description { margin-top:22px; font-size:13px; color:var(--ow-muted); }
  .dialog-edition { font:400 10px var(--ow-mono); margin-top:14px; color:var(--ow-muted); }
  .claim-desk { margin-top:25px; padding-top:22px; border-top:1px solid var(--ow-line); }
  .claim-cost { display:flex; align-items:center; justify-content:space-between; }
  .claim-cost span { font-size:12px; }
  .claim-cost strong { font-size:25px; font-weight:400; }
  .fee-note { color:var(--ow-muted); font-size:11px; line-height:1.6; margin-top:6px; }
  .wallet-address { font-size:9px; margin-top:13px; overflow-wrap:anywhere; }
  .claim-button { background:var(--ow-ink); border:1px solid var(--ow-ink); width:100%; color:var(--ow-paper); padding:14px 16px; margin-top:17px; font-size:12px; transition:background .15s; }
  .claim-button:hover:not(:disabled) { background:var(--ow-accent); border-color:var(--ow-accent); }
  .claim-button:disabled { background:#e2ded4; border-color:#d8d3c7; color:#716c60; }
  .claim-message { color:var(--ow-muted); font-size:11px; line-height:1.6; margin-top:12px; min-height:36px; }
  .claim-message[data-tone="error"] { color:#8f322b; }
  .claim-message[data-tone="success"] { color:#426247; }
  .receipt-link { display:block; font-size:11px; color:#426247; text-decoration:underline; margin-top:9px; }
  .retry-button { border:0; padding:5px 0; background:transparent; font-size:11px; text-decoration:underline; color:var(--ow-ink); margin-top:7px; }
  .dialog-links { display:flex; flex-wrap:wrap; gap:14px; margin-top:22px; font-size:10px; }
  .dialog-deadline { font-size:9px; color:var(--ow-muted); margin-top:15px; }
  .dialog-navigation { display:flex; justify-content:space-between; border-top:1px solid var(--ow-line); margin-top:25px; padding-top:15px; }
  .dialog-navigation button { border:0; padding:4px 0; background:transparent; color:var(--ow-ink); font-size:11px; }
  @media (min-width:1600px) { .art-mat { padding:20px; } }
  @media (max-width:1100px) { .shell { width:calc(100% - 64px); } .exhibition-status { flex-wrap:wrap; gap:4px 18px; padding:15px 0; } .status-label { min-width:0; } .closing-note { width:100%; } .art-grid { gap:42px 23px; } .art-mat { padding:11px; } .art-caption h3 { font-size:13px; } .art-description { font-size:10px; } .notes { gap:30px; } }
