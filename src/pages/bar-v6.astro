---
/**
 * /bar-v6 — preview of FooterBarV6 (the Walking Bar).
 *
 * Side-by-side preview so Mike can see + react to v6 without affecting
 * any other route. The bar replaces the v5 dock on this page only.
 *
 * If approved, BlockLayout swaps FooterBar → FooterBarV6 in a follow-up.
 *
 * Page intentionally minimal — the BAR is the thing being demoed.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import FooterBarV6 from '../components/FooterBarV6.astro';

const title = 'Bar v6 preview · The Walking Bar';
const description = 'Preview of FooterBarV6 — bottom dock as a horizontal slice of a pixel-art town. Your noun walks past 5 buildings (KETTLE / STUDIO / DRUM / WINDOW / DESK).';
---

<BlockLayout title={title} description={description}>
  <main class="barv6-preview">
    <header class="preview__head">
      <p class="preview__crumb"><a href="/">home</a> · <a href="/me">me</a> · <span>bar v6</span></p>
      <p class="preview__kicker">FOOTER v6 PREVIEW · THE WALKING BAR</p>
      <h1 class="preview__title">The bar is a place.</h1>
      <p class="preview__dek">
        The current dock (v5) is a tool: omnibox, kit, mode pill. v6 reframes
        the bar as a <em>place</em> — a horizontal slice of a pixel-art town
        with five buildings (KETTLE / STUDIO / DRUM / WINDOW / DESK) and your
        Noun walking left-to-right along the ground. Hover a building →
        nameplate. Click → navigate. Right edge keeps ON AIR + a chevron
        that links to <a href="/me">/me</a> for now.
      </p>
    </header>

    <section class="preview__band">
      <p class="preview__eyebrow mono">v6.0 — SHIPPED IN THIS PR</p>
      <ul class="preview__list">
        <li>Sky band with time-of-day gradient (morning/midday/evening/night) + sun + clouds + stars</li>
        <li>5 hand-placed buildings as pixel-art silhouettes with lit windows</li>
        <li>Hover-up nameplates with route hint</li>
        <li>Your Noun walks left-to-right in a 60s loop, bobs slightly, flips at the edges</li>
        <li>Pulls noun seed from <code>pc:currentNoun</code> (synced by <a href="/me">/me</a>'s SURPRISE button)</li>
        <li>Slower walk at night (sleepy mode)</li>
        <li>ON AIR pulse + ⌘K-style chevron stays at the right edge</li>
      </ul>
    </section>

    <section class="preview__band">
      <p class="preview__eyebrow mono">v6.1 — COMPANIONS (SHIPPED)</p>
      <ul class="preview__list">
        <li><code>+pet / +cat / +pup / +penguin</code> and 9 more spell casts spawn IN the bar instead of the global overlay</li>
        <li>Walk alongside your noun with staggered phase, fade after their <code>durationMs</code></li>
        <li>13 companion kinds, capped at 3 simultaneous</li>
      </ul>
    </section>

    <section class="preview__band preview__cta">
      <p class="preview__eyebrow mono">v6.2 — PETS + CROSS-VISITOR (SHIPPED IN THIS PR)</p>
      <ul class="preview__list">
        <li><strong>Right-click any companion</strong> to adopt it as your pet — saved to <code>pc:pet:v1</code></li>
        <li>Pet has an auto-generated name (Pebble / Cricket / Biscuit / Mochi / …), bornAt date, kind, mood</li>
        <li>Pet walks alongside your noun forever — never auto-fades; hover for nameplate</li>
        <li>Right-click your pet to release (with confirm); adopting a new one swaps in</li>
        <li><strong>Other visitors' nouns walk in YOUR bar as ghost-translucent</strong> via the existing PresenceRoom DO</li>
        <li>Cross-page room: WebSocket joins <code>/api/room?url=/__bar__</code>, so the bar is GLOBAL — visitors on /me, /studio, /coffee all share one walking-bar room</li>
        <li>Up to 4 peers visible at once; each walks the same 60s loop on a randomized phase (no per-frame position sync)</li>
        <li>Soft reconnect on close (4–8s backoff). Cheap, robust, and there's no animation thrash.</li>
      </ul>
    </section>

    <section class="preview__band">
      <p class="preview__eyebrow mono">v6.3 — INTERACTION (NEXT)</p>
      <ul class="preview__list">
        <li>Pass-by emotes when nouns get within ~40px (👋 quiet hello)</li>
        <li>Pets sniff each other when they meet</li>
        <li>Spell casts shared across the room — your <code>+confetti</code> shows in their bar too</li>
        <li>If two visitors stop near the same building, both their nouns face it (shared interest signal)</li>
        <li>Rename your pet · pet mood reflects your <code>pc:mood</code></li>
      </ul>
    </section>

    <section class="preview__band preview__cta">
      <p class="preview__cta-h">Try it</p>
      <p>
        Bar at the bottom is the v6 walking bar. Hover buildings to see nameplates,
        click to navigate. Your noun walks. Cast a companion spell (e.g. <code>+cat</code> in the
        v5 bar omnibox) and watch it walk in — then <strong>right-click</strong> to adopt
        it as your pet. Open another browser/incognito tab on /bar-v6 too — you'll see
        the other visitor's noun walking ghost-translucent in your bar.
      </p>
      <p class="preview__cta-back"><a href="/">← back to home (v5 bar)</a></p>
    </section>
  </main>
</BlockLayout>

{/* Mount the v6 bar — overrides the v5 dock on this page only because
    it's positioned fixed at z-index 60 (one above v5's 50). The v5 bar
    stays mounted by BlockLayout but is visually masked here. */}
<FooterBarV6 />

<style>
  .barv6-preview { max-width: 820px; margin: 0 auto; padding: 36px 24px 200px; font-family: var(--font-body); }
  .preview__crumb { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--color-ink-soft); text-transform: uppercase; margin: 0 0 14px; }
  .preview__crumb a { color: var(--color-ink-soft); text-decoration: none; }
  .preview__crumb a:hover { color: #1f1b15; }
  .preview__kicker { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; color: #c4952e; text-transform: uppercase; margin: 0 0 12px; }
  .preview__title { font-family: var(--font-heading); font-size: clamp(36px, 5vw, 60px); line-height: 1.05; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 14px; color: #1f1b15; }
  .preview__dek { font-family: var(--font-serif); font-size: 17px; line-height: 1.5; color: #6a6154; margin: 0 0 28px; }
  .preview__dek a { color: #c4952e; }
  .preview__band { padding: 18px 22px; margin: 0 0 18px; border: 1.5px solid #d8cdb8; background: #fbf7ee; border-radius: 3px; }
  .preview__eyebrow { font-size: 10px; letter-spacing: 0.18em; color: #c4952e; text-transform: uppercase; margin: 0 0 10px; }
  .preview__list { margin: 0; padding-left: 20px; line-height: 1.6; font-size: 14px; color: #1f1b15; }
  .preview__list li { margin: 0 0 4px; }
  .preview__list code { background: rgba(0,0,0,0.06); padding: 1px 4px; border-radius: 2px; font-size: 12px; }
  .preview__cta { background: #fff; border-color: #c4952e; }
  .preview__cta-h { font-family: var(--font-heading); font-size: 22px; margin: 0 0 6px; color: #1f1b15; font-weight: 600; }
  .preview__cta-back { font-family: var(--font-mono); font-size: 11px; color: #6a6154; margin: 14px 0 0; }
  .preview__cta-back a { color: #6a6154; text-decoration: none; }
  .preview__cta-back a:hover { color: #1f1b15; }
</style>
