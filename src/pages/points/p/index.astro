---
/**
 * /points/p/?id=<profile> — anyone's public Network Points card: points,
 * Nouns Money Series 1 notes, profile marks, drum count and a playable drum.
 * Other network sites link here, or read /api/points?profile=<id> directly.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import ProfileLedgerCard from '../../../components/ProfileLedgerCard.astro';
import '../../../styles/currency-builder.css';
---
<BlockLayout title="Profile card · Network Points" description="A public Network Points card: points, Nouns Money Series 1 notes, drum count and a drum to play. No cash value." image="/currency-builder/series-1/notes/front/reserve.svg" imageAlt="The Nouns Reserve note" themeColor="#f6f1e6" immersive hideAds showNetworkStrip={false} jsonLd={null}>
  <div class="cb">
    <div class="cb-wrap">
      <p class="cb-kicker" style="margin-top:24px"><a href="/points/">Network Points</a> · profile card</p>
      <ProfileLedgerCard mode="public" app="profile-card" />
    </div>
  </div>
</BlockLayout>
