  }
  async function resume() {
    if (!ctx || !sched) { play(); return; }
    await sched.resume(); // resumes ctx + re-arms parked timers
    playing = true; setPlayIcon(true);
    document.getElementById('cmp-bar')?.classList.add('cmp__bar--playing');
    runProgress();
  }

  function stopAll() {
    if (sched) sched.stopAll(); // stops every scheduled source + cancels timers
    cancelAnimationFrame(rafId);
  }

  function advance(crossfade: boolean) {
    stopAll();
    if (repeatMode === 'one') { play(); return; }
    if (qIdx < queue.length - 1) qIdx++;
    else if (repeatMode === 'all') qIdx = 0;
    else { playing = false; setPlayIcon(false); return; }
    play();
  }

  function prev() {
    stopAll();
    const c = ac();
    const elapsed = c.currentTime - trackStartCtxTime;
    if (elapsed > 3 || qIdx === 0) { play(); return; }
    qIdx = Math.max(0, qIdx - 1);
    play();
  }

  function setPlayIcon(on: boolean) {
    const svg = document.getElementById('cmp-play-svg');
    if (svg) svg.innerHTML = on
      ? '<path d="M10 8h4v16h-4z M18 8h4v16h-4z" fill="currentColor"/>'
