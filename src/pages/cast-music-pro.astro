---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="CAST · pro · the consumer-ready cut" description="Same drum hub, polish layer on. Real typography, animated art, smooth crossfades, lyric tickers, page transitions.">
  <main class="cmp" id="cmp" data-built={built}>
    <!-- Ambient blurred backdrop, swaps with current track color -->
    <div class="cmp__ambient" id="cmp-ambient" aria-hidden="true"></div>

    <!-- Onboarding modal: first-visit only -->
    <div class="cmp__onboard" id="cmp-onboard" hidden>
      <div class="cmp__onboard-card" id="cmp-onboard-card">
        <button class="cmp__onboard-x" id="cmp-onboard-x" type="button" aria-label="Close">×</button>
        <div class="cmp__onboard-marks">
          <img src="https://noun.pics/313.svg" alt="Noun #313" class="cmp__onboard-noun"/>
          <img src="https://noun.pics/612.svg" alt="Noun #612" class="cmp__onboard-noun cmp__onboard-noun--mid"/>
          <img src="https://noun.pics/287.svg" alt="Noun #287" class="cmp__onboard-noun"/>
        </div>
        <p class="cmp__onboard-kicker">CAST · PRO</p>
        <h2 class="cmp__onboard-title">A music app made of Nouns.</h2>
        <p class="cmp__onboard-body">Eighteen tracks built from the drum hub itself. Eight Noun artists. Daily mixes that change at midnight. Your saves and listening history live on this device.</p>
        <button class="cmp__onboard-cta" id="cmp-onboard-cta" type="button">
          <span class="cmp__onboard-cta-icon">▶</span>
          <span>Listen now</span>
        </button>
        <button class="cmp__onboard-skip" id="cmp-onboard-skip" type="button">browse first · or press esc</button>
      </div>
    </div>

    <!-- Toast stack -->
    <div class="cmp__toasts" id="cmp-toasts" aria-live="polite"></div>

    <!-- App shell -->
    <div class="cmp__shell">
      <!-- LEFT SIDEBAR -->
      <aside class="cmp__side">
        <header class="cmp__brand">
          <div class="cmp__brand-mark" aria-hidden="true">
            <img src="https://noun.pics/313.svg" alt="" loading="lazy"/>
          </div>
          <div>
            <p class="cmp__brand-name">CAST</p>
            <p class="cmp__brand-tag">pro · pointcast.xyz</p>
          </div>
        </header>

        <nav class="cmp__nav" role="navigation">
          <button class="cmp__nav-btn cmp__nav-btn--active" data-view="home" type="button">
            <span class="cmp__nav-icon">⌂</span><span>Home</span>
          </button>
          <button class="cmp__nav-btn" data-view="search" type="button">
            <span class="cmp__nav-icon">⌕</span><span>Search</span>
          </button>
          <button class="cmp__nav-btn" data-view="library" type="button">
            <span class="cmp__nav-icon">▤</span><span>Library</span>
          </button>
          <button class="cmp__nav-btn" data-view="wrapped" type="button">
            <span class="cmp__nav-icon">★</span><span>Wrapped</span>
          </button>
        </nav>

        <div class="cmp__side-section">
          <p class="cmp__side-label">DAILY MIXES</p>
          <ul class="cmp__playlists">
            <li class="cmp__playlist" data-view="playlist" data-pid="mix-chill"><span class="cmp__playlist-mark" style="--p: linear-gradient(135deg, #9ed6f0, #1a0820);">🌿</span><span>Chill Mix</span></li>
            <li class="cmp__playlist" data-view="playlist" data-pid="mix-drive"><span class="cmp__playlist-mark" style="--p: linear-gradient(135deg, #a8ff3a, #1a0820);">🚗</span><span>Driving Mix</span></li>
            <li class="cmp__playlist" data-view="playlist" data-pid="mix-cinema"><span class="cmp__playlist-mark" style="--p: linear-gradient(135deg, #ffd400, #1a0820);">🎬</span><span>Cinema Mix</span></li>
            <li class="cmp__playlist" data-view="playlist" data-pid="mix-rush"><span class="cmp__playlist-mark" style="--p: linear-gradient(135deg, #ff5f7a, #1a0820);">⚡</span><span>Race Mix</span></li>
          </ul>
        </div>

        <div class="cmp__side-section" id="cmp-user-playlists-wrap">
          <p class="cmp__side-label">YOUR PLAYLISTS</p>
          <ul class="cmp__playlists" id="cmp-user-playlists"></ul>
          <button class="cmp__side-add" id="cmp-add-playlist" type="button">+ new playlist</button>
        </div>

        <footer class="cmp__side-foot">
          <p>Built {built.slice(0,10)}</p>
          <p>From the drum hub.<br/><a href="/" class="cmp__side-link">← back to PointCast</a></p>
        </footer>
      </aside>

      <!-- MAIN VIEW -->
      <section class="cmp__main">
        <header class="cmp__main-head">
          <div class="cmp__nav-arrows">
            <button class="cmp__nav-arrow" id="cmp-back" type="button" aria-label="Back">‹</button>
            <button class="cmp__nav-arrow" id="cmp-fwd" type="button" aria-label="Forward">›</button>
          </div>
          <div class="cmp__search-bar" id="cmp-search-bar" hidden>
            <span class="cmp__search-icon">⌕</span>
            <input type="text" class="cmp__search-input" id="cmp-search-input" placeholder="Search tracks · artists · genres"/>
          </div>
          <div class="cmp__main-head-r">
            <a href="/" class="cmp__chip">⌂ pointcast</a>
          </div>
        </header>

        <div class="cmp__view" id="cmp-view"></div>
      </section>

      <!-- RIGHT QUEUE -->
      <aside class="cmp__queue" id="cmp-queue">
        <header class="cmp__queue-head">
          <h3 class="cmp__queue-title">QUEUE</h3>
          <button class="cmp__queue-clear" id="cmp-queue-clear" type="button">clear</button>
        </header>
        <div class="cmp__queue-list" id="cmp-queue-list"></div>
      </aside>
    </div>

    <!-- NOW PLAYING BAR -->
    <footer class="cmp__bar" id="cmp-bar">
      <div class="cmp__bar-l">
        <div class="cmp__bar-art" id="cmp-bar-art-wrap">
          <div class="cmp__bar-art-frame">
            <img src="" alt="" id="cmp-bar-art" hidden/>
          </div>
        </div>
        <div class="cmp__bar-meta">
          <p class="cmp__bar-name" id="cmp-bar-name">— select a track</p>
          <p class="cmp__bar-artist" id="cmp-bar-artist">drum hub on pause</p>
        </div>
        <button class="cmp__bar-heart" id="cmp-bar-heart" type="button" aria-label="Save">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 21s-7.5-4.6-7.5-10.5C4.5 7 7 4.5 10 4.5c1.4 0 2.5.6 3 1.5.5-.9 1.6-1.5 3-1.5 3 0 5.5 2.5 5.5 6 0 5.9-7.5 10.5-7.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
      </div>
      <div class="cmp__bar-c">
        <div class="cmp__bar-controls">
          <button class="cmp__bar-btn" id="cmp-shuffle" type="button" aria-label="Shuffle">⇄</button>
          <button class="cmp__bar-btn" id="cmp-prev" type="button" aria-label="Previous">⏮</button>
          <button class="cmp__bar-play" id="cmp-play" type="button" aria-label="Play">
            <svg viewBox="0 0 32 32" width="22" height="22" id="cmp-play-svg">
              <path d="M11 8l13 8-13 8z" fill="currentColor"/>
            </svg>
          </button>
          <button class="cmp__bar-btn" id="cmp-next" type="button" aria-label="Next">⏭</button>
          <button class="cmp__bar-btn" id="cmp-repeat" type="button" aria-label="Repeat">⟳</button>
        </div>
        <div class="cmp__bar-prog">
          <span class="cmp__bar-time" id="cmp-time-cur">0:00</span>
          <div class="cmp__bar-prog-track" id="cmp-prog-track">
            <div class="cmp__bar-prog-fill" id="cmp-prog-fill"></div>
            <div class="cmp__bar-prog-thumb" id="cmp-prog-thumb"></div>
          </div>
          <span class="cmp__bar-time" id="cmp-time-tot">0:00</span>
        </div>
      </div>
      <div class="cmp__bar-r">
        <button class="cmp__bar-btn" id="cmp-lyric-toggle" type="button" aria-label="Lyrics">≡</button>
        <button class="cmp__bar-btn" id="cmp-queue-toggle" type="button" aria-label="Queue">☰</button>
        <div class="cmp__bar-vol">
          <span class="cmp__bar-vol-icon">♪</span>
          <input type="range" class="cmp__bar-vol-slider" id="cmp-vol" min="0" max="100" value="68"/>
        </div>
      </div>

      <!-- Lyric ticker (slides up from bar) -->
      <div class="cmp__lyric" id="cmp-lyric" hidden>
        <p class="cmp__lyric-line" id="cmp-lyric-line">—</p>
      </div>
    </footer>

    <!-- Hidden heart-burst overlay -->
    <div class="cmp__heart-burst" id="cmp-heart-burst" aria-hidden="true"></div>
  </main>
</Layout>

<style is:global>
  /* ============================================================
     CAST PRO — typography & feel layer
     Inter Display for hero · Inter for body · JetBrains Mono ONLY for metadata.
     OKLCH-style brass/walnut palette, but tightened.
     ============================================================ */

  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cmp-bg: #0d0610;
    --cmp-bg-2: #1a0a14;
    --cmp-walnut: #5a3422;
    --cmp-walnut-2: #4a2a1a;
    --cmp-brass: #d4a437;
    --cmp-flame: #f6c15e;
    --cmp-cream: #f4e7c8;
    --cmp-velvet: #1a0820;
    --cmp-glass: rgba(244, 231, 200, 0.04);
    --cmp-glass-hi: rgba(244, 231, 200, 0.08);
    --cmp-line: rgba(244, 231, 200, 0.10);
    --cmp-text: #f4e7c8;
    --cmp-text-mute: rgba(244, 231, 200, 0.62);
    --cmp-text-quiet: rgba(244, 231, 200, 0.38);
    --cmp-display: 'Inter Tight', 'Inter Display', system-ui, sans-serif;
    --cmp-body: 'Inter', system-ui, sans-serif;
    --cmp-mono: 'JetBrains Mono', ui-monospace, monospace;
    --cmp-shadow-sm: 0 2px 8px rgba(0,0,0,0.30);
    --cmp-shadow-md: 0 8px 24px rgba(0,0,0,0.42);
    --cmp-shadow-lg: 0 24px 60px rgba(0,0,0,0.55);
  }

  body { background: var(--cmp-bg); color: var(--cmp-text); font-family: var(--cmp-body); }

  /* App layout */
  .cmp { position: relative; min-height: 100vh; padding-bottom: 92px; overflow: hidden; isolation: isolate; }

  /* Ambient backdrop — full-bleed blurred radial that morphs with track color */
  .cmp__ambient {
    position: fixed; inset: 0; z-index: -1;
    background:
      radial-gradient(80% 60% at 20% 30%, var(--ambient-c1, #5a3422) 0%, transparent 60%),
      radial-gradient(60% 50% at 80% 80%, var(--ambient-c2, #1a0820) 0%, transparent 60%),
      linear-gradient(180deg, #0d0610 0%, #1a0a14 100%);
    filter: blur(40px) saturate(1.1);
    transform: scale(1.05);
    transition: --ambient-c1 1.6s ease, --ambient-c2 1.6s ease;
  }

  .cmp__shell {
    display: grid;
    grid-template-columns: 268px 1fr 312px;
    gap: 8px;
    padding: 8px 8px 0 8px;
    height: calc(100vh - 92px);
    min-height: 600px;
  }

  @media (max-width: 1180px) {
    .cmp__shell { grid-template-columns: 240px 1fr; }
    .cmp__queue { display: none; }
  }
  @media (max-width: 720px) {
    .cmp__shell { grid-template-columns: 1fr; }
    .cmp__side { display: none; }
  }

  /* SIDEBAR ================================================== */
  .cmp__side {
    background: linear-gradient(180deg, rgba(26,8,32,0.96) 0%, rgba(13,6,16,0.96) 100%);
    border: 1px solid var(--cmp-line);
    border-radius: 14px;
    padding: 18px 14px;
    overflow-y: auto;
    backdrop-filter: blur(12px);
  }
  .cmp__side::-webkit-scrollbar { width: 6px; }
  .cmp__side::-webkit-scrollbar-thumb { background: rgba(244,231,200,0.10); border-radius: 3px; }

  .cmp__brand { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; padding: 0 4px; }
  .cmp__brand-mark { width: 40px; height: 40px; background: var(--cmp-velvet); border-radius: 8px; display: grid; place-items: center; box-shadow: var(--cmp-shadow-sm); overflow: hidden; }
  .cmp__brand-mark img { width: 100%; height: 100%; image-rendering: pixelated; }
  .cmp__brand-name { font-family: var(--cmp-display); font-weight: 800; font-size: 19px; letter-spacing: 0.5px; line-height: 1; margin: 0 0 3px 0; }
  .cmp__brand-tag { font-family: var(--cmp-mono); font-size: 9.5px; color: var(--cmp-text-quiet); letter-spacing: 0.4px; margin: 0; text-transform: uppercase; }

  .cmp__nav { display: flex; flex-direction: column; gap: 2px; margin-bottom: 22px; }
  .cmp__nav-btn {
    display: flex; align-items: center; gap: 14px;
    background: transparent; border: 0; padding: 11px 12px;
    color: var(--cmp-text-mute); font-family: var(--cmp-body); font-weight: 600; font-size: 13.5px;
    border-radius: 8px; cursor: pointer; text-align: left;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .cmp__nav-btn:hover { background: var(--cmp-glass); color: var(--cmp-text); transform: translateX(2px); }
  .cmp__nav-btn--active { background: var(--cmp-glass-hi); color: var(--cmp-flame); }
  .cmp__nav-icon { font-size: 16px; width: 20px; display: inline-block; text-align: center; }

  .cmp__side-section { margin-bottom: 18px; padding: 0 4px; }
  .cmp__side-label { font-family: var(--cmp-mono); font-size: 10px; letter-spacing: 0.6px; color: var(--cmp-text-quiet); margin: 0 0 8px 0; text-transform: uppercase; }
  .cmp__playlists { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .cmp__playlist {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 10px; cursor: pointer; border-radius: 6px;
    color: var(--cmp-text-mute); font-size: 13px; font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .cmp__playlist:hover { background: var(--cmp-glass); color: var(--cmp-text); }
  .cmp__playlist-mark {
    width: 26px; height: 26px; border-radius: 5px;
    background: var(--p, var(--cmp-walnut));
    display: grid; place-items: center;
    font-size: 13px; flex-shrink: 0;
    box-shadow: 0 1px 4px rgba(0,0,0,0.30);
  }
  .cmp__side-add {
    background: transparent; border: 1px dashed var(--cmp-line);
    color: var(--cmp-text-quiet); font-family: var(--cmp-mono); font-size: 11px;
    padding: 8px 10px; border-radius: 6px; cursor: pointer;
    width: 100%; margin-top: 6px;
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .cmp__side-add:hover { border-color: var(--cmp-flame); color: var(--cmp-flame); }

  .cmp__side-foot { margin-top: 24px; padding: 12px 4px 4px 4px; border-top: 1px solid var(--cmp-line); font-family: var(--cmp-mono); font-size: 10px; color: var(--cmp-text-quiet); line-height: 1.6; }
  .cmp__side-link { color: var(--cmp-flame); text-decoration: none; }
  .cmp__side-link:hover { text-decoration: underline; }

  /* MAIN ===================================================== */
  .cmp__main {
    background: linear-gradient(180deg, rgba(26,8,32,0.92) 0%, rgba(13,6,16,0.92) 70%);
    border: 1px solid var(--cmp-line);
    border-radius: 14px;
    overflow: hidden;
    display: flex; flex-direction: column;
    backdrop-filter: blur(12px);
  }

  .cmp__main-head {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--cmp-line);
    background: rgba(13,6,16,0.40);
    backdrop-filter: blur(8px);
  }
  .cmp__nav-arrows { display: flex; gap: 4px; }
  .cmp__nav-arrow {
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(0,0,0,0.40); border: 0; color: var(--cmp-text);
    font-size: 18px; cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .cmp__nav-arrow:hover { background: rgba(0,0,0,0.65); transform: scale(1.06); }
  .cmp__main-head-r { margin-left: auto; }
  .cmp__chip {
    background: rgba(244,231,200,0.08); border: 1px solid var(--cmp-line);
    color: var(--cmp-text); padding: 6px 14px; border-radius: 999px;
    font-family: var(--cmp-mono); font-size: 11px; text-decoration: none;
    transition: background 0.18s ease;
  }
  .cmp__chip:hover { background: rgba(244,231,200,0.14); }

  .cmp__search-bar {
    flex: 1; max-width: 380px;
    display: flex; align-items: center; gap: 8px;
    background: rgba(0,0,0,0.36); border: 1px solid var(--cmp-line);
    padding: 8px 14px; border-radius: 999px;
    transition: border-color 0.18s ease;
  }
  .cmp__search-bar:focus-within { border-color: var(--cmp-flame); }
  .cmp__search-icon { color: var(--cmp-text-mute); font-size: 14px; }
  .cmp__search-input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--cmp-text); font-family: var(--cmp-body); font-size: 13.5px;
  }
  .cmp__search-input::placeholder { color: var(--cmp-text-quiet); }

  .cmp__view {
    flex: 1; overflow-y: auto;
    padding: 0;
    animation: cmp-view-in 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cmp__view::-webkit-scrollbar { width: 8px; }
  .cmp__view::-webkit-scrollbar-thumb { background: rgba(244,231,200,0.12); border-radius: 4px; }

  @keyframes cmp-view-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* HOME hero ================================================ */
  .cmp__hero {
    padding: 36px 32px 28px 32px;
    background: linear-gradient(180deg, var(--hero-c, #5a3422) 0%, transparent 100%);
    position: relative;
  }
  .cmp__hero-kicker {
    font-family: var(--cmp-mono); font-size: 11px; letter-spacing: 0.6px;
    color: rgba(255,255,255,0.78); margin: 0 0 8px 0; text-transform: uppercase;
  }
  .cmp__hero-title {
    font-family: var(--cmp-display); font-weight: 800;
    font-size: clamp(40px, 6vw, 76px); line-height: 0.96; letter-spacing: -0.02em;
    margin: 0 0 14px 0; color: #fff;
  }
  .cmp__hero-sub {
    font-family: var(--cmp-body); font-size: 15px; color: rgba(255,255,255,0.84);
    max-width: 620px; line-height: 1.55; margin: 0 0 18px 0;
  }
  .cmp__hero-actions { display: flex; gap: 10px; align-items: center; }
  .cmp__hero-cta {
    background: var(--cmp-flame); border: 0; color: var(--cmp-velvet);
    padding: 12px 26px; border-radius: 999px; cursor: pointer;
    font-family: var(--cmp-display); font-weight: 700; font-size: 14px;
    display: inline-flex; align-items: center; gap: 8px;
    box-shadow: var(--cmp-shadow-md);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cmp__hero-cta:hover { transform: scale(1.04); box-shadow: var(--cmp-shadow-lg); }

  /* Section wrappers */
  .cmp__section { padding: 28px 32px; }
  .cmp__section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  .cmp__section-title {
    font-family: var(--cmp-display); font-weight: 700; font-size: 22px;
    letter-spacing: -0.01em; margin: 0;
  }
  .cmp__section-link { color: var(--cmp-text-mute); font-family: var(--cmp-mono); font-size: 11px; text-decoration: none; cursor: pointer; }
  .cmp__section-link:hover { color: var(--cmp-text); }

  /* Card grid (album-art style) ============================== */
  .cmp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(184px, 1fr));
    gap: 22px;
  }
  .cmp__card {
    cursor: pointer; padding: 14px; border-radius: 10px;
    background: rgba(244,231,200,0.04);
    transition: background 0.22s ease, transform 0.22s ease;
    position: relative;
  }
  .cmp__card:hover { background: rgba(244,231,200,0.10); transform: translateY(-3px); }

  /* Animated album art — Noun in a generative gradient frame */
  .cmp__card-art {
    aspect-ratio: 1; border-radius: 8px; overflow: hidden; position: relative;
    background: linear-gradient(135deg, var(--art-c1, var(--cmp-walnut)) 0%, var(--art-c2, var(--cmp-velvet)) 100%);
    box-shadow: var(--cmp-shadow-md);
    margin-bottom: 12px;
    display: grid; place-items: center;
  }
  .cmp__card-art::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.18) 0%, transparent 50%);
    opacity: 0.7; pointer-events: none;
  }
  .cmp__card-art::after {
    content: ''; position: absolute; inset: -2px;
    background: conic-gradient(from var(--card-spin, 0deg), transparent 0%, var(--art-c1, var(--cmp-flame)) 50%, transparent 100%);
    filter: blur(20px); opacity: 0; transition: opacity 0.4s ease;
    z-index: -1;
  }
  .cmp__card:hover .cmp__card-art::after { opacity: 0.4; animation: cmp-spin 6s linear infinite; }

  @keyframes cmp-spin {
    from { --card-spin: 0deg; transform: rotate(0deg); }
    to   { --card-spin: 360deg; transform: rotate(360deg); }
  }

  .cmp__card-art img { width: 76%; height: auto; image-rendering: pixelated; filter: drop-shadow(0 6px 12px rgba(0,0,0,0.5)); position: relative; z-index: 1; }
  .cmp__card-art-emoji { font-size: 56px; }

  /* Hover play button */
  .cmp__card-play {
    position: absolute; bottom: 14px; right: 12px;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--cmp-flame); color: var(--cmp-velvet);
    display: grid; place-items: center; cursor: pointer;
    font-size: 16px; padding-left: 2px;
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.22s ease, transform 0.22s ease, background 0.18s ease;
    box-shadow: var(--cmp-shadow-md);
    z-index: 3;
  }
  .cmp__card:hover .cmp__card-play { opacity: 1; transform: translateY(0); }
  .cmp__card-play:hover { background: #fff; transform: scale(1.06); }

  .cmp__card-title {
    font-family: var(--cmp-body); font-weight: 600; font-size: 14.5px;
    margin: 0 0 4px 0; color: var(--cmp-text);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .cmp__card-sub {
    font-family: var(--cmp-body); font-weight: 400; font-size: 12.5px;
    color: var(--cmp-text-mute); margin: 0; line-height: 1.4;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Artist grid (round portraits) ============================ */
  .cmp__artist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: 22px;
  }
  .cmp__artist-card { cursor: pointer; padding: 14px; border-radius: 10px; background: rgba(244,231,200,0.04); transition: background 0.22s ease, transform 0.22s ease; text-align: center; }
  .cmp__artist-card:hover { background: rgba(244,231,200,0.10); transform: translateY(-3px); }
  .cmp__artist-portrait {
    aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: linear-gradient(135deg, var(--art-c1, var(--cmp-walnut)) 0%, var(--cmp-velvet) 100%);
    margin-bottom: 12px; display: grid; place-items: center;
    box-shadow: var(--cmp-shadow-md);
  }
  .cmp__artist-portrait img { width: 80%; height: auto; image-rendering: pixelated; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4)); }
  .cmp__artist-name { font-family: var(--cmp-body); font-weight: 600; font-size: 14.5px; margin: 0 0 4px 0; color: var(--cmp-text); }
  .cmp__artist-meta { font-family: var(--cmp-mono); font-size: 10.5px; color: var(--cmp-text-quiet); margin: 0; letter-spacing: 0.4px; }

  /* Track list ================================================ */
  .cmp__tracks { width: 100%; border-collapse: separate; border-spacing: 0; font-family: var(--cmp-body); font-size: 13.5px; }
  .cmp__tracks thead th {
    text-align: left; padding: 8px 10px;
    font-family: var(--cmp-mono); font-size: 10px; letter-spacing: 0.6px;
    color: var(--cmp-text-quiet); font-weight: 500; text-transform: uppercase;
    border-bottom: 1px solid var(--cmp-line);
  }
  .cmp__tracks tbody tr {
    border-radius: 6px; cursor: pointer;
    transition: background 0.15s ease;
  }
  .cmp__tracks-row td {
    padding: 9px 10px;
    border-bottom: 1px solid rgba(244,231,200,0.04);
  }
  .cmp__tracks-row:hover td { background: rgba(244,231,200,0.06); }
  .cmp__tracks-row:hover .cmp__tracks-num span { display: none; }
  .cmp__tracks-row:hover .cmp__tracks-num::after { content: '▶'; color: var(--cmp-flame); }
  .cmp__tracks-row--playing td { background: rgba(246,193,94,0.10); }
  .cmp__tracks-row--playing .cmp__tracks-num { position: relative; }
  .cmp__tracks-row--playing .cmp__tracks-num span {
    display: inline-block;
    width: 14px; height: 14px;
    background:
      linear-gradient(to top, var(--cmp-flame) 0%, var(--cmp-flame) 50%, transparent 50%);
    background-size: 4px 100%;
    background-repeat: repeat-x;
    background-position: 0 0;
    animation: cmp-eq 0.7s linear infinite alternate;
  }
  @keyframes cmp-eq {
    0% { background-size: 4px 100%, 4px 60%, 4px 80%; }
    100% { background-size: 4px 40%, 4px 100%, 4px 50%; }
  }

  .cmp__tracks-num { width: 38px; color: var(--cmp-text-quiet); font-family: var(--cmp-mono); font-size: 11.5px; }
  .cmp__tracks-art { width: 40px; }
  .cmp__tracks-art-frame {
    width: 36px; height: 36px; border-radius: 5px;
    background: linear-gradient(135deg, var(--art-c1, var(--cmp-walnut)) 0%, var(--cmp-velvet) 100%);
    display: grid; place-items: center; box-shadow: var(--cmp-shadow-sm);
  }
  .cmp__tracks-art-frame img { width: 78%; height: auto; image-rendering: pixelated; }
  .cmp__tracks-name { color: var(--cmp-text); font-weight: 500; }
  .cmp__tracks-row--playing .cmp__tracks-name { color: var(--cmp-flame); font-weight: 600; }
  .cmp__tracks-artist a { color: var(--cmp-text-mute); text-decoration: none; }
  .cmp__tracks-artist a:hover { color: var(--cmp-text); text-decoration: underline; }
  .cmp__tracks-genre { color: var(--cmp-text-quiet); font-family: var(--cmp-mono); font-size: 11px; }
  .cmp__tracks-bpm { color: var(--cmp-text-quiet); font-family: var(--cmp-mono); font-size: 11.5px; }
  .cmp__tracks-actions { width: 60px; text-align: right; }
  .cmp__tracks-heart {
    background: transparent; border: 0; cursor: pointer;
    color: var(--cmp-text-quiet); font-size: 16px; padding: 4px 8px;
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .cmp__tracks-heart:hover { color: var(--cmp-text); transform: scale(1.18); }
  .cmp__tracks-heart--saved { color: #ff5f7a; }
  .cmp__tracks-heart--saved:hover { color: #ff8aa0; }

  /* Artist hero =============================================== */
  .cmp__artist-hero {
    display: flex; align-items: flex-end; gap: 28px;
    padding: 60px 32px 32px 32px;
    background: linear-gradient(180deg, var(--artist-c, #5a3422) 0%, transparent 100%);
    min-height: 320px;
  }
  .cmp__artist-hero-portrait {
    width: 200px; height: 200px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.16) 0%, rgba(0,0,0,0.30) 100%);
    display: grid; place-items: center; box-shadow: var(--cmp-shadow-lg);
  }
  .cmp__artist-hero-portrait img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 8px 14px rgba(0,0,0,0.6)); }
  .cmp__artist-hero-meta { flex: 1; min-width: 0; }
  .cmp__artist-hero-kicker { font-family: var(--cmp-mono); font-size: 11px; color: rgba(255,255,255,0.78); margin: 0 0 6px 0; letter-spacing: 0.5px; text-transform: uppercase; }
  .cmp__artist-hero-name { font-family: var(--cmp-display); font-weight: 800; font-size: clamp(48px, 7vw, 88px); letter-spacing: -0.02em; line-height: 0.94; margin: 0 0 14px 0; color: #fff; }
  .cmp__artist-hero-bio { font-family: var(--cmp-body); font-size: 14px; color: rgba(255,255,255,0.82); max-width: 580px; line-height: 1.55; margin: 0; }

  /* QUEUE ===================================================== */
  .cmp__queue {
    background: linear-gradient(180deg, rgba(26,8,32,0.96) 0%, rgba(13,6,16,0.96) 100%);
    border: 1px solid var(--cmp-line); border-radius: 14px;
    padding: 18px 14px; overflow-y: auto;
    backdrop-filter: blur(12px);
  }
  .cmp__queue::-webkit-scrollbar { width: 6px; }
  .cmp__queue::-webkit-scrollbar-thumb { background: rgba(244,231,200,0.10); border-radius: 3px; }
  .cmp__queue-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4px 12px 4px; border-bottom: 1px solid var(--cmp-line); margin-bottom: 12px; }
  .cmp__queue-title { font-family: var(--cmp-mono); font-size: 11px; letter-spacing: 0.5px; color: var(--cmp-text-quiet); margin: 0; }
  .cmp__queue-clear { background: transparent; border: 0; color: var(--cmp-text-quiet); font-family: var(--cmp-mono); font-size: 10.5px; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
  .cmp__queue-clear:hover { color: var(--cmp-text); background: var(--cmp-glass); }
  .cmp__queue-list { display: flex; flex-direction: column; gap: 1px; }
  .cmp__queue-item {
    display: flex; align-items: center; gap: 10px;
    padding: 8px; border-radius: 6px; cursor: pointer;
    transition: background 0.15s ease;
  }
  .cmp__queue-item:hover { background: var(--cmp-glass); }
  .cmp__queue-item--current { background: rgba(246,193,94,0.10); }
  .cmp__queue-item-art {
    width: 36px; height: 36px; border-radius: 5px; flex-shrink: 0;
    background: linear-gradient(135deg, var(--art-c1, var(--cmp-walnut)) 0%, var(--cmp-velvet) 100%);
    display: grid; place-items: center; box-shadow: var(--cmp-shadow-sm);
  }
  .cmp__queue-item-art img { width: 78%; image-rendering: pixelated; }
  .cmp__queue-item-meta { flex: 1; min-width: 0; }
  .cmp__queue-item-name { font-family: var(--cmp-body); font-weight: 500; font-size: 12.5px; color: var(--cmp-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
  .cmp__queue-item--current .cmp__queue-item-name { color: var(--cmp-flame); }
  .cmp__queue-item-artist { font-family: var(--cmp-body); font-size: 11.5px; color: var(--cmp-text-mute); margin: 2px 0 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* NOW PLAYING BAR =========================================== */
  .cmp__bar {
    position: fixed; bottom: 0; left: 0; right: 0;
    height: 92px;
    background: linear-gradient(180deg, rgba(13,6,16,0.96) 0%, rgba(6,2,10,0.99) 100%);
    border-top: 1px solid var(--cmp-line);
    display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: center;
    padding: 0 18px; gap: 16px;
    z-index: 90;
    backdrop-filter: blur(20px);
  }
  .cmp__bar-l { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .cmp__bar-art {
    width: 60px; height: 60px; flex-shrink: 0;
    perspective: 600px;
  }
  .cmp__bar-art-frame {
    width: 100%; height: 100%; border-radius: 6px; overflow: hidden;
    background: linear-gradient(135deg, var(--art-c1, var(--cmp-walnut)) 0%, var(--cmp-velvet) 100%);
    display: grid; place-items: center;
    box-shadow: var(--cmp-shadow-md);
    transition: transform 0.5s ease;
  }
  .cmp__bar.cmp__bar--playing .cmp__bar-art-frame {
    animation: cmp-bar-art-breathe calc(var(--bpm-period, 600ms) * 4) ease-in-out infinite;
  }
  @keyframes cmp-bar-art-breathe {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.03) rotate(-0.6deg); }
  }
  .cmp__bar-art-frame img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); }
  .cmp__bar-meta { min-width: 0; flex: 1; }
  .cmp__bar-name { font-family: var(--cmp-body); font-weight: 600; font-size: 13.5px; color: var(--cmp-text); margin: 0 0 3px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmp__bar-artist { font-family: var(--cmp-body); font-size: 11.5px; color: var(--cmp-text-mute); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmp__bar-heart { background: transparent; border: 0; color: var(--cmp-text-mute); cursor: pointer; padding: 6px; transition: color 0.18s ease, transform 0.18s ease; flex-shrink: 0; }
  .cmp__bar-heart:hover { color: var(--cmp-text); transform: scale(1.16); }
  .cmp__bar-heart--saved { color: #ff5f7a; }
  .cmp__bar-heart--saved:hover { color: #ff8aa0; }

  .cmp__bar-c { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .cmp__bar-controls { display: flex; align-items: center; gap: 16px; }
  .cmp__bar-btn { background: transparent; border: 0; color: var(--cmp-text-mute); cursor: pointer; font-size: 18px; transition: color 0.15s ease, transform 0.15s ease; padding: 4px; }
  .cmp__bar-btn:hover { color: var(--cmp-text); transform: scale(1.10); }
  .cmp__bar-btn--active { color: var(--cmp-flame); }
  .cmp__bar-play {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--cmp-text); color: var(--cmp-velvet);
    border: 0; cursor: pointer;
    display: grid; place-items: center;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .cmp__bar-play:hover { transform: scale(1.10); background: #fff; }

  .cmp__bar-prog { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 540px; }
  .cmp__bar-time { font-family: var(--cmp-mono); font-size: 10.5px; color: var(--cmp-text-quiet); width: 36px; text-align: center; }
  .cmp__bar-prog-track {
    flex: 1; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; cursor: pointer; position: relative;
    transition: height 0.18s ease;
  }
  .cmp__bar-prog-track:hover { height: 6px; }
  .cmp__bar-prog-fill { height: 100%; background: var(--cmp-text); border-radius: 2px; width: 0%; transition: background 0.18s ease; pointer-events: none; }
  .cmp__bar-prog-track:hover .cmp__bar-prog-fill { background: var(--cmp-flame); }
  .cmp__bar-prog-thumb { position: absolute; top: 50%; left: 0%; width: 12px; height: 12px; background: #fff; border-radius: 50%; transform: translate(-50%, -50%) scale(0); transition: transform 0.18s ease; pointer-events: none; }
  .cmp__bar-prog-track:hover .cmp__bar-prog-thumb { transform: translate(-50%, -50%) scale(1); }

  .cmp__bar-r { display: flex; align-items: center; gap: 12px; justify-content: flex-end; }
  .cmp__bar-vol { display: flex; align-items: center; gap: 8px; }
  .cmp__bar-vol-icon { font-size: 14px; color: var(--cmp-text-mute); }
  .cmp__bar-vol-slider { width: 96px; -webkit-appearance: none; appearance: none; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer; }
  .cmp__bar-vol-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 12px; border-radius: 50%; background: var(--cmp-text); cursor: pointer; }
  .cmp__bar-vol-slider:hover::-webkit-slider-thumb { background: var(--cmp-flame); }

  /* Lyric ticker (floats above bar) */
  .cmp__lyric {
    position: absolute; left: 0; right: 0; bottom: 92px;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.85) 100%);
    padding: 32px 24px 16px 24px;
    text-align: center;
    pointer-events: none;
    animation: cmp-lyric-in 0.32s ease;
  }
  @keyframes cmp-lyric-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .cmp__lyric-line {
    font-family: var(--cmp-display); font-weight: 600; font-size: clamp(20px, 2.4vw, 30px);
    letter-spacing: -0.01em; color: rgba(255,255,255,0.92); margin: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  /* Heart burst overlay */
  .cmp__heart-burst {
    position: fixed; pointer-events: none; z-index: 200;
    width: 80px; height: 80px;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  .cmp__heart-burst.cmp__heart-burst--fire { animation: cmp-heart-burst 0.78s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes cmp-heart-burst {
    0%   { transform: translate(-50%, -50%) scale(0); opacity: 0; }
    20%  { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
    60%  { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; }
  }
  .cmp__heart-burst svg { width: 100%; height: 100%; filter: drop-shadow(0 0 20px #ff5f7a); }

  /* Toast stack */
  .cmp__toasts {
    position: fixed; top: 22px; right: 22px; z-index: 250;
    display: flex; flex-direction: column; gap: 8px;
    pointer-events: none;
  }
  .cmp__toast {
    background: rgba(13,6,16,0.96); border: 1px solid var(--cmp-line);
    color: var(--cmp-text); padding: 12px 18px; border-radius: 10px;
    font-family: var(--cmp-body); font-size: 13.5px; font-weight: 500;
    box-shadow: var(--cmp-shadow-lg); backdrop-filter: blur(12px);
    animation: cmp-toast-in 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: auto;
    display: flex; align-items: center; gap: 10px;
  }
  .cmp__toast.cmp__toast--out { animation: cmp-toast-out 0.28s ease forwards; }
  @keyframes cmp-toast-in {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes cmp-toast-out {
    to { opacity: 0; transform: translateX(40px); }
  }
  .cmp__toast-mark { color: var(--cmp-flame); font-size: 16px; }

  /* Onboarding modal */
  .cmp__onboard {
    position: fixed; inset: 0; z-index: 99999;
    background: rgba(0,0,0,0.78); backdrop-filter: blur(20px);
    display: grid; place-items: center; padding: 22px;
    animation: cmp-fade-in 0.42s ease;
    cursor: pointer;
  }
  @keyframes cmp-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .cmp__onboard-card {
    background: linear-gradient(180deg, #1a0a14 0%, #0d0610 100%);
    border: 1px solid var(--cmp-line);
    border-radius: 18px; padding: 44px 36px;
    max-width: 480px; width: 100%; text-align: center;
    box-shadow: var(--cmp-shadow-lg);
    animation: cmp-onboard-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: default;
    position: relative;
  }
  @keyframes cmp-onboard-in { from { opacity: 0; transform: translateY(28px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .cmp__onboard-x {
    position: absolute; top: 14px; right: 14px;
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(244,231,200,0.06); border: 0;
    color: var(--cmp-text-mute); font-size: 22px; line-height: 28px;
    cursor: pointer; padding: 0;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .cmp__onboard-x:hover { background: rgba(244,231,200,0.14); color: var(--cmp-text); transform: scale(1.06); }
  .cmp__onboard-marks {
    display: flex; gap: 10px; justify-content: center; align-items: flex-end;
    margin-bottom: 18px; padding: 18px 14px 12px 14px;
    background: rgba(244,231,200,0.04); border-radius: 14px;
  }
  .cmp__onboard-noun {
    width: 64px; height: 64px; image-rendering: pixelated;
    background: linear-gradient(135deg, var(--cmp-walnut) 0%, var(--cmp-velvet) 100%);
    border-radius: 8px; padding: 4px;
    box-shadow: var(--cmp-shadow-sm);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cmp__onboard-noun--mid { width: 80px; height: 80px; transform: translateY(-6px); box-shadow: var(--cmp-shadow-md); }
  .cmp__onboard-card:hover .cmp__onboard-noun:nth-child(1) { transform: rotate(-6deg) translateX(-4px); }
  .cmp__onboard-card:hover .cmp__onboard-noun--mid { transform: translateY(-10px) scale(1.04); }
  .cmp__onboard-card:hover .cmp__onboard-noun:nth-child(3) { transform: rotate(6deg) translateX(4px); }
  .cmp__onboard-kicker { font-family: var(--cmp-mono); font-size: 11px; color: var(--cmp-flame); letter-spacing: 0.6px; margin: 0 0 6px 0; text-transform: uppercase; }
  .cmp__onboard-title { font-family: var(--cmp-display); font-weight: 800; font-size: 30px; letter-spacing: -0.015em; line-height: 1.08; margin: 0 0 12px 0; color: var(--cmp-text); }
  .cmp__onboard-body { font-family: var(--cmp-body); font-size: 14.5px; line-height: 1.55; color: var(--cmp-text-mute); margin: 0 0 24px 0; }
  .cmp__onboard-cta {
    background: var(--cmp-flame); color: var(--cmp-velvet);
    border: 0; padding: 13px 28px; border-radius: 999px;
    font-family: var(--cmp-display); font-weight: 700; font-size: 14.5px;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    box-shadow: var(--cmp-shadow-md);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cmp__onboard-cta:hover { transform: scale(1.04); box-shadow: var(--cmp-shadow-lg); }
  .cmp__onboard-cta-icon { padding-left: 1px; }
  .cmp__onboard-skip {
    background: transparent; border: 0; color: var(--cmp-text-quiet);
    font-family: var(--cmp-mono); font-size: 11px; cursor: pointer;
    margin-top: 14px; padding: 6px;
  }
  .cmp__onboard-skip:hover { color: var(--cmp-text); }

  /* Wrapped page */
  .cmp__wrapped { padding: 36px 32px; }
  .cmp__wrapped-card {
    background: linear-gradient(135deg, #5a3422 0%, #1a0820 80%, #0d0610 100%);
    border-radius: 18px;
    padding: 44px 36px;
    margin-bottom: 18px;
    box-shadow: var(--cmp-shadow-lg);
    position: relative;
    overflow: hidden;
  }
  .cmp__wrapped-card::before {
    content: ''; position: absolute; top: -100px; right: -100px;
    width: 280px; height: 280px; border-radius: 50%;
    background: radial-gradient(circle, rgba(246,193,94,0.18) 0%, transparent 70%);
  }
  .cmp__wrapped-kicker { font-family: var(--cmp-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--cmp-flame); margin: 0 0 10px 0; text-transform: uppercase; }
  .cmp__wrapped-title { font-family: var(--cmp-display); font-weight: 800; font-size: clamp(36px, 5vw, 60px); letter-spacing: -0.02em; line-height: 1; margin: 0 0 24px 0; color: #fff; position: relative; }
  .cmp__wrapped-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; position: relative; }
  .cmp__wrapped-stat {
    background: rgba(0,0,0,0.30);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 18px;
  }
  .cmp__wrapped-stat-label { font-family: var(--cmp-mono); font-size: 10.5px; color: rgba(255,255,255,0.62); margin: 0 0 8px 0; letter-spacing: 0.5px; text-transform: uppercase; }
  .cmp__wrapped-stat-val { font-family: var(--cmp-display); font-weight: 700; font-size: 30px; letter-spacing: -0.01em; color: #fff; margin: 0 0 4px 0; line-height: 1; }
  .cmp__wrapped-stat-sub { font-family: var(--cmp-body); font-size: 12px; color: rgba(255,255,255,0.65); margin: 0; }

  /* Misc utility */
  .cmp__empty { padding: 60px 22px; text-align: center; color: var(--cmp-text-mute); }
  .cmp__empty-icon { font-size: 36px; margin-bottom: 10px; opacity: 0.6; }
  .cmp__empty p { font-family: var(--cmp-body); font-size: 14px; margin: 4px 0; }
</style>

<script>
  type Inst = 'kick' | 'snare' | 'bell' | 'lead' | 'pad';
  type Genre = 'drum' | 'ambient' | 'cinema' | 'race' | 'orchestral' | 'electronic' | 'jazz';
  type Mood = 'chill' | 'driving' | 'rush' | 'meditative' | 'cinema' | 'playful';
  interface Track { id: string; name: string; artistId: number; artist: string; bpm: number; genre: Genre; mood: Mood; color: string; pattern: Record<Inst, number[]>; lyric?: string[]; }
