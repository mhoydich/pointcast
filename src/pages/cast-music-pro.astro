        </div>
      </section>

      <section class="cmp__section">
        <header class="cmp__section-head">
          <h2 class="cmp__section-title">Top Noun artists</h2>
          <a class="cmp__section-link" data-view-link="artists">view all →</a>
        </header>
        <div class="cmp__artist-grid">
          ${topNouns.map(a => `
            <div class="cmp__artist-card" data-artist="${a.id}" style="--art-c1: ${a.color};">
              <div class="cmp__artist-portrait"><img src="https://noun.pics/${a.id}.svg" alt="" loading="lazy"/></div>
              <p class="cmp__artist-name">${escape(a.name)}</p>
              <p class="cmp__artist-meta">${TRACKS.filter(t => t.artistId === a.id).length} tracks · NOUN #${a.id}</p>
