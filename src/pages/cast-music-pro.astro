        </div>
        <div class="cmp__artist-hero-meta">
          <p class="cmp__artist-hero-kicker">ARTIST · NOUN #${a.id}</p>
          <h1 class="cmp__artist-hero-name">${escape(a.name)}</h1>
          <p class="cmp__artist-hero-bio">${escape(a.bio)}</p>
        </div>
      </section>
      <section class="cmp__section"><header class="cmp__section-head"><h2 class="cmp__section-title">Tracks · ${tracks.length}</h2><a class="cmp__section-link" data-play-artist="${a.id}">▶ play all</a></header>${tracksTable(tracks)}</section>
      <section class="cmp__section"><header class="cmp__section-head"><h2 class="cmp__section-title">Related artists</h2></header>
        <div class="cmp__artist-grid">
          ${related.map(r => `<div class="cmp__artist-card" data-artist="${r.id}" style="--art-c1: ${r.color};"><div class="cmp__artist-portrait"><img src="https://noun.pics/${r.id}.svg" alt=""/></div><p class="cmp__artist-name">${escape(r.name)}</p><p class="cmp__artist-meta">${TRACKS.filter(t => t.artistId === r.id).length} tracks</p></div>`).join('')}
        </div>
      </section>
    `;
