  function tracksTable(tracks: Track[]): string {
    return `
      <table class="cmp__tracks">
        <thead><tr><th class="cmp__tracks-num">#</th><th></th><th>Title</th><th>Artist</th><th>Genre</th><th>BPM</th><th></th></tr></thead>
        <tbody>
          ${tracks.map((t, i) => {
            const isCur = queue[qIdx]?.id === t.id;
            return `<tr class="cmp__tracks-row ${isCur ? 'cmp__tracks-row--playing' : ''}" data-tid="${t.id}">
              <td class="cmp__tracks-num"><span>${isCur && playing ? '' : (i + 1)}</span></td>
              <td class="cmp__tracks-art"><div class="cmp__tracks-art-frame" style="--art-c1: ${t.color};"><img src="https://noun.pics/${t.artistId}.svg" alt="" loading="lazy"/></div></td>
              <td class="cmp__tracks-name">${escape(t.name)}</td>
              <td class="cmp__tracks-artist"><a href="#" data-artist="${t.artistId}">${escape(t.artist)}</a></td>
              <td class="cmp__tracks-genre">${t.genre}</td>
              <td class="cmp__tracks-bpm">${t.bpm}</td>
              <td class="cmp__tracks-actions"><button class="cmp__tracks-heart ${saved.includes(t.id) ? 'cmp__tracks-heart--saved' : ''}" data-heart="${t.id}" type="button">${saved.includes(t.id) ? '♥' : '♡'}</button></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  function bindView(view: HTMLDivElement) {
    // Track row → play this single track
    view.querySelectorAll<HTMLTableRowElement>('.cmp__tracks-row').forEach(row => {
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button, a')) return;
        const tid = row.dataset.tid!; const t = TRACKS.find(x => x.id === tid); if (t) {
          // Find sibling rows for queue context
          const all = Array.from(row.parentElement!.querySelectorAll<HTMLTableRowElement>('.cmp__tracks-row'));
          const tracks = all.map(r => TRACKS.find(x => x.id === r.dataset.tid)).filter((x): x is Track => !!x);
          const startIdx = tracks.findIndex(x => x.id === tid);
          loadQueue(tracks, Math.max(0, startIdx));
        }
      });
    });
    // Hearts
    view.querySelectorAll<HTMLButtonElement>('.cmp__tracks-heart, [data-heart]').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); toggleSave(btn.dataset.heart!, btn); });
    });
    // Card-with-tid
    view.querySelectorAll<HTMLElement>('.cmp__card[data-tid]').forEach(el => {
      el.addEventListener('click', () => { const t = TRACKS.find(x => x.id === el.dataset.tid); if (t) loadQueue([t]); });
    });
    view.querySelectorAll<HTMLElement>('button[data-tid]').forEach(b => {
      b.addEventListener('click', (e) => { e.stopPropagation(); const t = TRACKS.find(x => x.id === b.dataset.tid); if (t) loadQueue([t]); });
    });
    // Card-with-pid → playlist play
    view.querySelectorAll<HTMLElement>('.cmp__card[data-pid]').forEach(el => {
      el.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button[data-pid]')) return; // play button below
        pushView({ kind: 'playlist', pid: el.dataset.pid! });
      });
    });
    view.querySelectorAll<HTMLElement>('button[data-pid]').forEach(b => {
      b.addEventListener('click', (e) => { e.stopPropagation(); const pid = b.dataset.pid!; const tracks = pid in MIXES ? MIXES[pid].tracks : userPlaylists.find(p => p.id === pid)?.tracks.map(tid => TRACKS.find(t => t.id === tid)).filter((x): x is Track => !!x) || []; loadQueue(tracks); });
    });
    // Cards-with-search
    view.querySelectorAll<HTMLElement>('[data-search]').forEach(el => {
      el.addEventListener('click', () => { const q = el.dataset.search!; pushView({ kind: 'search', q }); const inp = $('cmp-search-input') as HTMLInputElement; if (inp) inp.value = q; });
    });
    // Library tabs
    view.querySelectorAll<HTMLElement>('[data-lib-tab]').forEach(el => {
      el.addEventListener('click', () => { const v = getView(); if (v.kind === 'library') { v.tab = el.dataset.libTab as any; render(); } });
    });
    // Artist links
    view.querySelectorAll<HTMLElement>('[data-artist]').forEach(el => {
      el.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); const id = Number(el.dataset.artist); if (id) pushView({ kind: 'artist', id }); });
    });
    // Play-all artist
    view.querySelectorAll<HTMLElement>('[data-play-artist]').forEach(el => {
      el.addEventListener('click', () => { const id = Number(el.dataset.playArtist); const ts = TRACKS.filter(t => t.artistId === id); loadQueue(ts); });
    });
    // Section view-all link
    view.querySelectorAll<HTMLElement>('[data-view-link="artists"]').forEach(el => {
      el.addEventListener('click', () => { pushView({ kind: 'search' }); });
    });
  }

  function renderUserPlaylists() {
    const list = $('cmp-user-playlists') as HTMLUListElement; if (!list) return;
    list.innerHTML = userPlaylists.map(p => `<li class="cmp__playlist" data-view="playlist" data-pid="${p.id}"><span class="cmp__playlist-mark" style="--p: linear-gradient(135deg, var(--cmp-walnut), var(--cmp-velvet));">▤</span><span>${escape(p.name)}</span></li>`).join('');
    list.querySelectorAll<HTMLLIElement>('.cmp__playlist').forEach(li => li.addEventListener('click', () => pushView({ kind: 'playlist', pid: li.dataset.pid! })));
  }

  function renderQueue() {
    const list = $('cmp-queue-list') as HTMLDivElement; if (!list) return;
    if (queue.length === 0) { list.innerHTML = `<div class="cmp__empty" style="padding: 30px 8px;"><div class="cmp__empty-icon">♪</div><p style="font-size: 12px;">Queue is empty.</p><p style="font-size: 11px;">Play any track to start.</p></div>`; return; }
    list.innerHTML = queue.map((t, i) => `<div class="cmp__queue-item ${i === qIdx ? 'cmp__queue-item--current' : ''}" data-q-idx="${i}">
      <div class="cmp__queue-item-art" style="--art-c1: ${t.color};"><img src="https://noun.pics/${t.artistId}.svg" alt=""/></div>
      <div class="cmp__queue-item-meta"><p class="cmp__queue-item-name">${escape(t.name)}</p><p class="cmp__queue-item-artist">${escape(t.artist)} · ${t.bpm} bpm</p></div>
    </div>`).join('');
    list.querySelectorAll<HTMLDivElement>('.cmp__queue-item').forEach(el => el.addEventListener('click', () => { qIdx = Number(el.dataset.qIdx); stopAll(); play(); renderQueue(); render(); }));
  }

  function updateBar() {
    const t = queue[qIdx];
    const name = $('cmp-bar-name') as HTMLParagraphElement; const artist = $('cmp-bar-artist') as HTMLParagraphElement;
    const art = $('cmp-bar-art') as HTMLImageElement;
    const heart = $('cmp-bar-heart') as HTMLButtonElement;
    if (!t) { if (name) name.textContent = '— select a track'; if (artist) artist.textContent = 'drum hub on pause'; if (art) art.hidden = true; return; }
    if (name) name.textContent = t.name;
    if (artist) artist.textContent = `${t.artist} · ${t.genre} · ${t.bpm} bpm`;
    if (art) { art.src = `https://noun.pics/${t.artistId}.svg`; art.hidden = false; }
    if (heart) heart.classList.toggle('cmp__bar-heart--saved', saved.includes(t.id));
    const frame = document.querySelector<HTMLDivElement>('.cmp__bar-art-frame');
    if (frame) {
      frame.style.setProperty('--art-c1', t.color);
      // Sync breathing animation to BPM
      const period = (60 / t.bpm * 1000);
      frame.style.setProperty('--bpm-period', period + 'ms');
    }
  }

  function heartBurst(originEl: HTMLElement) {
    const burst = $('cmp-heart-burst') as HTMLDivElement; if (!burst) return;
    const r = originEl.getBoundingClientRect();
    burst.style.left = (r.left + r.width / 2) + 'px';
    burst.style.top = (r.top + r.height / 2) + 'px';
    burst.innerHTML = `<svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-7.5-10.5C4.5 7 7 4.5 10 4.5c1.4 0 2.5.6 3 1.5.5-.9 1.6-1.5 3-1.5 3 0 5.5 2.5 5.5 6 0 5.9-7.5 10.5-7.5 10.5z" fill="#ff5f7a"/></svg>`;
    burst.classList.remove('cmp__heart-burst--fire'); void burst.offsetWidth;
    burst.classList.add('cmp__heart-burst--fire');
  }

  function toast(msg: string, kind: 'heart' | 'plus' | 'check' = 'check') {
    const wrap = $('cmp-toasts') as HTMLDivElement; if (!wrap) return;
    const mark = kind === 'heart' ? '♥' : kind === 'plus' ? '+' : '✓';
    const el = document.createElement('div'); el.className = 'cmp__toast';
    el.innerHTML = `<span class="cmp__toast-mark">${mark}</span><span>${escape(msg)}</span>`;
    wrap.appendChild(el);
    setTimeout(() => { el.classList.add('cmp__toast--out'); setTimeout(() => el.remove(), 320); }, 2200);
  }

  // ---------- Onboarding ----------
  function dismissOnboard(startPlaying = false) {
    const ob = $('cmp-onboard') as HTMLDivElement; if (!ob) return;
    lsSet(KEY.onboard, true);
    ob.hidden = true;
    if (startPlaying) {
      const t = TRACKS[today % TRACKS.length];
      loadQueue([t]);
    }
  }
  function maybeOnboard() {
    // ALWAYS bind handlers — even if the modal won't show this visit, this
    // makes the buttons work if anything else opens the modal later.
    const ob = $('cmp-onboard') as HTMLDivElement;
    const card = $('cmp-onboard-card') as HTMLDivElement;
    const cta = $('cmp-onboard-cta') as HTMLButtonElement;
    const skip = $('cmp-onboard-skip') as HTMLButtonElement;
    const x = $('cmp-onboard-x') as HTMLButtonElement;
    if (cta) cta.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); dismissOnboard(true); });
    if (skip) skip.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); dismissOnboard(false); });
    if (x) x.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); dismissOnboard(false); });
    if (card) card.addEventListener('click', (e) => e.stopPropagation());
    if (ob) ob.addEventListener('click', () => dismissOnboard(false)); // backdrop click
    document.addEventListener('keydown', (e) => {
      if (ob && !ob.hidden && (e.key === 'Escape' || e.key === 'Esc')) { dismissOnboard(false); }
    });
    const seen = lsGet(KEY.onboard, false);
    if (seen) return;
    if (!ob) return;
    ob.hidden = false;
  }

  // ---------- Bind global controls ----------
  function bindGlobal() {
    document.querySelectorAll<HTMLButtonElement>('.cmp__nav-btn').forEach(b => b.addEventListener('click', () => pushView({ kind: b.dataset.view as any })));
    document.querySelectorAll<HTMLLIElement>('.cmp__playlist').forEach(li => li.addEventListener('click', () => pushView({ kind: 'playlist', pid: li.dataset.pid! })));
    $('cmp-back')!.addEventListener('click', navBack);
    $('cmp-fwd')!.addEventListener('click', navFwd);
    // Audit fixes (2026-05-10):
    //   #1 — after queue exhausts with repeat=off, sched has no parked timers;
    //        resume() is a no-op. Fall through to play() instead.
    //   #5 — pause()/resume() now await sched. Debounce clicks within 100ms so
    //        a rapid double-tap can't interleave suspend/resume on iOS Safari.
    let cmpLastPlayToggle = 0;
    $('cmp-play')!.addEventListener('click', async () => {
      const now = Date.now(); if (now - cmpLastPlayToggle < 100) return; cmpLastPlayToggle = now;
      if (queue.length === 0) { const t = TRACKS[today % TRACKS.length]; loadQueue([t]); return; }
      if (playing) await pause();
      else if (sched && sched.timerCount > 0) await resume();
      else play();
    });
    // Audit fix #9: rapid prev/next mashing caused UI flash. Debounce to 120ms
    // so a panicked tap-tap-tap collapses into a single advance.
    let lastNav = 0;
    const navDebounced = (fn: () => void) => () => {
      const now = Date.now(); if (now - lastNav < 120) return; lastNav = now; fn();
    };
    $('cmp-prev')!.addEventListener('click', navDebounced(prev));
    $('cmp-next')!.addEventListener('click', navDebounced(() => advance(false)));
    $('cmp-shuffle')!.addEventListener('click', () => { shuffleMode = !shuffleMode; lsSet(KEY.shuffle, shuffleMode); $('cmp-shuffle')!.classList.toggle('cmp__bar-btn--active', shuffleMode); if (shuffleMode && queue.length > 1) { const cur = queue[qIdx]; const rest = queue.filter((_, i) => i !== qIdx); for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random()*(i+1)); [rest[i], rest[j]] = [rest[j], rest[i]]; } queue = [cur, ...rest]; qIdx = 0; renderQueue(); } toast(shuffleMode ? 'Shuffle on' : 'Shuffle off', 'check'); });
    $('cmp-repeat')!.addEventListener('click', () => { repeatMode = repeatMode === 'off' ? 'all' : repeatMode === 'all' ? 'one' : 'off'; lsSet(KEY.repeat, repeatMode); const el = $('cmp-repeat')!; el.classList.toggle('cmp__bar-btn--active', repeatMode !== 'off'); el.textContent = repeatMode === 'one' ? '⟳·1' : '⟳'; toast(`Repeat ${repeatMode}`, 'check'); });
    $('cmp-bar-heart')!.addEventListener('click', (e) => { const t = queue[qIdx]; if (t) toggleSave(t.id, e.currentTarget as HTMLElement); });
    $('cmp-vol')!.addEventListener('input', (e) => { volume = Number((e.target as HTMLInputElement).value); lsSet(KEY.vol, volume); if (masterGain) masterGain.gain.setTargetAtTime(volume / 100, ac().currentTime, 0.05); });
    ($('cmp-vol') as HTMLInputElement).value = String(volume);

    $('cmp-prog-track')!.addEventListener('click', () => {
      // Web Audio osc graphs aren't seekable. Just restart the track from the
      // top — kills the leftover-schedule bug Codex caught.
      const t = queue[qIdx]; if (!t) return;
      stopAll(); play();
    });

    $('cmp-search-input')!.addEventListener('input', (e) => { const q = (e.target as HTMLInputElement).value; const v = getView(); if (v.kind === 'search') { v.q = q; render(); } else pushView({ kind: 'search', q }); });
    $('cmp-add-playlist')!.addEventListener('click', () => {
      const name = prompt('Playlist name?'); if (!name) return;
      const trimmed = name.trim(); if (!trimmed) return;
      // Cap total playlists at 50 — keeps localStorage bounded (Codex review).
      if (userPlaylists.length >= 50) { toast('Playlist limit reached (50)', 'check'); return; }
      const p = { id: 'user-'+Date.now(), name: trimmed.slice(0, 40), tracks: [], created: Date.now() };
      userPlaylists.unshift(p); lsSet(KEY.userPlaylists, userPlaylists); renderUserPlaylists();
      toast(`Created "${p.name}"`, 'plus');
    });

    $('cmp-queue-clear')!.addEventListener('click', () => { stopAll(); queue = []; qIdx = 0; renderQueue(); updateBar(); document.getElementById('cmp-bar')?.classList.remove('cmp__bar--playing'); setPlayIcon(false); });

    $('cmp-lyric-toggle')!.addEventListener('click', () => { const ly = $('cmp-lyric')!; ly.hidden = !ly.hidden; });
    $('cmp-queue-toggle')!.addEventListener('click', () => { const q = $('cmp-queue')!; q.style.display = q.style.display === 'none' ? '' : 'none'; });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); if (playing) pause(); else resume(); }
      if (e.key === 'ArrowRight' && e.metaKey) { e.preventDefault(); advance(false); }
      if (e.key === 'ArrowLeft' && e.metaKey) { e.preventDefault(); prev(); }
      if (e.key === '/') { e.preventDefault(); pushView({ kind: 'search' }); ($('cmp-search-input') as HTMLInputElement)?.focus(); }
    });

    // Hash routing
    window.addEventListener('hashchange', () => {
      const v = readUrlView(); if (v) { viewStack[viewIdx] = v; render(); }
    });
    const initial = readUrlView(); if (initial && initial.kind !== 'home') { viewStack[viewIdx] = initial; }

    // Restore toggle states
    if (shuffleMode) $('cmp-shuffle')!.classList.add('cmp__bar-btn--active');
    if (repeatMode !== 'off') { $('cmp-repeat')!.classList.add('cmp__bar-btn--active'); $('cmp-repeat')!.textContent = repeatMode === 'one' ? '⟳·1' : '⟳'; }
  }

  // ---------- Init ----------
  document.addEventListener('DOMContentLoaded', () => {
    bindGlobal();
    render();
    renderQueue();
    updateBar();
    maybeOnboard();
  });
</script>
</BlockLayout>