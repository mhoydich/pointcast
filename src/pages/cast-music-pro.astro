  function play() {
    if (queue.length === 0) return;
    const t = queue[qIdx];
    if (!t) return;
    const c = ac(); if (c.state === 'suspended') c.resume();
    const start = c.currentTime + 0.03;
    trackStartCtxTime = start;
    const dur = scheduleTrack(t, start);
    playing = true;
    bumpRecent(t.id); incrementPlay(t.id);
    updateBar(); document.getElementById('cmp-bar')?.classList.add('cmp__bar--playing');
    setPlayIcon(true);
    setAmbient(t.color);
    render(); // refresh playing-row
    runProgress();
    // Auto-advance scheduled in AudioContext-time so it pauses with the audio.
    sched!.schedule(() => advance(true), start + dur - crossfadeMs / 1000);
