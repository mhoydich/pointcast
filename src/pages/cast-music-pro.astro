        if (lyricEl.textContent !== newLine) {
          lyricEl.style.opacity = '0';
          setTimeout(() => { lyricEl.textContent = newLine; lyricEl.style.opacity = '1'; }, 240);
        }
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }
  function fmtTime(sec: number) { sec = Math.max(0, sec); const m = Math.floor(sec/60); const s = Math.floor(sec%60); return `${m}:${String(s).padStart(2,'0')}`; }

  function bumpRecent(id: string) { recentlyPlayed = [id, ...recentlyPlayed.filter(x => x !== id)].slice(0, 24); lsSet(KEY.recent, recentlyPlayed); }
  function incrementPlay(id: string) {
    plays[id] = (plays[id] || 0) + 1;
    // Audit fix #10: cap plays dict at 200 keys. If we exceed, drop the
    // 50 lowest-count entries so we keep room for fresh listens. Currently
    // bounded by TRACKS.length (~30) but defends against dynamic catalogs.
    const keys = Object.keys(plays);
    if (keys.length > 200) {
      const sorted = keys.sort((a, b) => plays[a] - plays[b]);
      for (let i = 0; i < 50; i++) delete plays[sorted[i]];
    }
    lsSet(KEY.plays, plays);
  }

  function toggleSave(id: string, originEl?: HTMLElement) {
    const i = saved.indexOf(id);
    if (i === -1) {
      saved.unshift(id); lsSet(KEY.saved, saved);
      toast('Saved', 'heart');
      if (originEl) heartBurst(originEl);
    } else {
      saved.splice(i, 1); lsSet(KEY.saved, saved);
      toast('Removed from saved', 'heart');
    }
    updateBar(); render();
  }

  // ---------- UI render ----------
  function render() {
    const v = getView();
    document.querySelectorAll<HTMLElement>('.cmp__nav-btn').forEach(b => b.classList.toggle('cmp__nav-btn--active', b.dataset.view === v.kind));
    const view = $('cmp-view') as HTMLDivElement;
    if (!view) return;
    const sb = $('cmp-search-bar') as HTMLDivElement;
    if (sb) sb.hidden = (v.kind !== 'search');
    let html = '';
    if (v.kind === 'home') html = renderHome();
    else if (v.kind === 'search') html = renderSearch(v.q || '');
    else if (v.kind === 'library') html = renderLibrary(v.tab || 'saved');
    else if (v.kind === 'wrapped') html = renderWrapped();
    else if (v.kind === 'playlist') html = renderPlaylist(v.pid);
    else if (v.kind === 'artist') html = renderArtist(v.id);
    view.innerHTML = html;
    bindView(view);
    renderUserPlaylists();
  }

