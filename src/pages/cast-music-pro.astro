      </section>
      <section class="cmp__section">${tracks.length ? tracksTable(tracks) : `<div class="cmp__empty"><div class="cmp__empty-icon">+</div><p>This playlist is empty.</p><p>Open any track and it goes here.</p></div>`}</section>
