  // ---------- Playback engine ----------
  let queue: Track[] = []; let qIdx = 0;
  let playing = false; let rafId = 0;
  let trackStartCtxTime = 0;
  let crossfadeMs = 1200;

  function trackDuration(t: Track): number { const beat = 60 / t.bpm; return beat * 16; /* 1 bar of 16 steps */ }

  function scheduleTrack(t: Track, startTime: number) {
    const beat = 60 / t.bpm; const step = beat / 4;
    const dur = trackDuration(t);
    for (let i = 0; i < 16; i++) {
      const tm = startTime + i * step;
      if (t.pattern.kick[i])  playKick(tm);
      if (t.pattern.snare[i]) playSnare(tm);
      if (t.pattern.bell[i])  playBell(tm);
      if (t.pattern.lead[i])  playLead(tm, PENT[(i + (t.bpm % 5)) % PENT.length]);
      if (t.pattern.pad[i])   playPad(tm);
