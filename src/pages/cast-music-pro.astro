    const related = ARTISTS.filter(x => x.id !== a.id).slice(0, 4);
    return `
      <section class="cmp__artist-hero" style="--artist-c: ${a.color}aa;">
        <div class="cmp__artist-hero-portrait" style="background: linear-gradient(135deg, ${a.color}66 0%, rgba(0,0,0,0.40) 100%);">
