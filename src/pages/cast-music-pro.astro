  function runProgress() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!ctx || !playing) return;
      const t = queue[qIdx]; if (!t) return;
      const elapsed = ctx.currentTime - trackStartCtxTime;
      const dur = trackDuration(t);
      const pct = Math.max(0, Math.min(1, elapsed / dur));
      const fill = document.getElementById('cmp-prog-fill') as HTMLDivElement;
      const thumb = document.getElementById('cmp-prog-thumb') as HTMLDivElement;
      if (fill) fill.style.width = (pct * 100) + '%';
      if (thumb) thumb.style.left = (pct * 100) + '%';
      const cur = $('cmp-time-cur') as HTMLSpanElement; const tot = $('cmp-time-tot') as HTMLSpanElement;
      if (cur) cur.textContent = fmtTime(elapsed);
      if (tot) tot.textContent = fmtTime(dur);

