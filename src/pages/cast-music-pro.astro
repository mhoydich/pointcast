  function setAmbient(color: string) {
    const root = document.documentElement;
    const ambient = document.getElementById('cmp-ambient'); if (!ambient) return;
    const c = parseHex(color);
    ambient.style.setProperty('--ambient-c1', `rgba(${c.r},${c.g},${c.b},0.55)`);
    ambient.style.setProperty('--ambient-c2', `rgba(${Math.max(c.r-60,0)},${Math.max(c.g-60,0)},${Math.max(c.b-60,0)},0.85)`);
