  function renderSearch(q: string): string {
    if (!q) {
      const genres: Genre[] = ['drum', 'ambient', 'cinema', 'race', 'orchestral', 'electronic', 'jazz'];
      return `
        <section class="cmp__section">
          <header class="cmp__section-head"><h2 class="cmp__section-title">Browse by genre</h2></header>
          <div class="cmp__grid">
            ${genres.map((g, i) => {
              const colors = ['#5a3422','#9ed6f0','#6f59c0','#ff5f7a','#f6c15e','#a8ff3a','#e8b3c0'];
              return `
              <div class="cmp__card" data-search="${g}" style="--art-c1: ${colors[i] || '#5a3422'}; --art-c2: var(--cmp-velvet);">
                <div class="cmp__card-art"><span class="cmp__card-art-emoji">🎵</span></div>
                <p class="cmp__card-title">${g.charAt(0).toUpperCase()+g.slice(1)}</p>
                <p class="cmp__card-sub">${TRACKS.filter(t => t.genre === g).length} tracks</p>
              </div>
              `;
            }).join('')}
          </div>
        </section>`;
    }
    const ql = q.toLowerCase();
    const matches = TRACKS.filter(t => t.name.toLowerCase().includes(ql) || t.artist.toLowerCase().includes(ql) || t.genre.includes(ql) || t.mood.includes(ql));
    const aMatches = ARTISTS.filter(a => a.name.toLowerCase().includes(ql));
    if (matches.length === 0 && aMatches.length === 0) return `<div class="cmp__empty"><div class="cmp__empty-icon">⌕</div><p>No results for "${escape(q)}"</p><p>try a different word — drum, ambient, cinema</p></div>`;
    return `
      ${aMatches.length ? `<section class="cmp__section"><header class="cmp__section-head"><h2 class="cmp__section-title">Artists</h2></header>
        <div class="cmp__artist-grid">
          ${aMatches.map(a => `
            <div class="cmp__artist-card" data-artist="${a.id}" style="--art-c1: ${a.color};">
