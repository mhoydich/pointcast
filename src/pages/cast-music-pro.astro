      ${matches.length ? `<section class="cmp__section"><header class="cmp__section-head"><h2 class="cmp__section-title">Tracks · ${matches.length}</h2></header>${tracksTable(matches)}</section>` : ''}
    `;
  }

  function renderLibrary(tab: 'saved'|'recent'|'playlists'): string {
    const tabsHtml = `
      <div style="padding: 28px 32px 0 32px;">
        <h1 style="font-family: var(--cmp-display); font-weight: 800; font-size: 34px; letter-spacing: -0.015em; margin: 0 0 18px 0;">Your Library</h1>
        <div style="display: flex; gap: 6px; border-bottom: 1px solid var(--cmp-line);">
          ${(['saved','recent','playlists'] as const).map(t => `<button class="cmp__chip" style="${tab===t ? 'background: var(--cmp-flame); color: var(--cmp-velvet);' : ''} margin-bottom: -1px;" data-lib-tab="${t}">${t.charAt(0).toUpperCase()+t.slice(1)}</button>`).join('')}
        </div>
      </div>
    `;
    let body = '';
    if (tab === 'saved') {
      const tracks = saved.map(id => TRACKS.find(t => t.id === id)).filter((t): t is Track => !!t);
      body = tracks.length === 0 ? `<div class="cmp__empty"><div class="cmp__empty-icon">♡</div><p>You have no saved tracks yet.</p><p>Tap the heart on any track to save it here.</p></div>` : tracksTable(tracks);
    } else if (tab === 'recent') {
      const tracks = recentlyPlayed.map(id => TRACKS.find(t => t.id === id)).filter((t): t is Track => !!t);
      body = tracks.length === 0 ? `<div class="cmp__empty"><div class="cmp__empty-icon">⏱</div><p>Nothing played yet.</p><p>Play a track and it shows up here.</p></div>` : tracksTable(tracks);
    } else {
      body = userPlaylists.length === 0 ? `<div class="cmp__empty"><div class="cmp__empty-icon">▤</div><p>No playlists yet.</p><p>Tap "+ new playlist" in the sidebar.</p></div>`
        : `<div class="cmp__grid">${userPlaylists.map(p => `<div class="cmp__card" data-pid="${p.id}" style="--art-c1: var(--cmp-walnut); --art-c2: var(--cmp-velvet);"><div class="cmp__card-art"><span class="cmp__card-art-emoji">▤</span></div><p class="cmp__card-title">${escape(p.name)}</p><p class="cmp__card-sub">${p.tracks.length} tracks</p></div>`).join('')}</div>`;
    }
    return tabsHtml + `<section class="cmp__section">${body}</section>`;
  }

  function renderWrapped(): string {
    const totalPlays = Object.values(plays).reduce((a, b) => a + b, 0);
    const minutes = TRACKS.reduce((acc, t) => acc + (plays[t.id] || 0) * (trackDuration(t) / 60), 0);
    const topTracks = Object.entries(plays).sort((a,b) => b[1]-a[1]).slice(0, 5).map(([id, n]) => ({ track: TRACKS.find(t => t.id === id), plays: n })).filter(x => x.track);
    const artistPlays: Record<number, number> = {};
    Object.entries(plays).forEach(([id, n]) => { const t = TRACKS.find(x => x.id === id); if (t) artistPlays[t.artistId] = (artistPlays[t.artistId] || 0) + n; });
    const topArtist = Object.entries(artistPlays).sort((a,b) => b[1]-a[1])[0];
    const topArtistObj = topArtist ? ARTISTS.find(a => a.id === Number(topArtist[0])) : null;
    if (totalPlays < 3) {
      return `<div class="cmp__wrapped"><div class="cmp__wrapped-card"><p class="cmp__wrapped-kicker">Wrapped · live</p><h1 class="cmp__wrapped-title">Listen a few more.</h1><p style="color: rgba(255,255,255,0.78); font-family: var(--cmp-body); font-size: 14.5px; line-height: 1.55; max-width: 520px; position: relative;">Wrapped unlocks at 3 plays. You're at ${totalPlays}. Hit play on anything — your stats appear here, the moment you do.</p></div></div>`;
    }
    return `
      <div class="cmp__wrapped">
        <div class="cmp__wrapped-card">
          <p class="cmp__wrapped-kicker">Your wrapped · ${new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>
          <h1 class="cmp__wrapped-title">${totalPlays} ${totalPlays === 1 ? 'play' : 'plays'}<br/>${Math.round(minutes)} minutes total.</h1>
          <div class="cmp__wrapped-grid">
            ${topArtistObj ? `<div class="cmp__wrapped-stat"><p class="cmp__wrapped-stat-label">Top artist</p><p class="cmp__wrapped-stat-val">${escape(topArtistObj.name)}</p><p class="cmp__wrapped-stat-sub">Noun #${topArtistObj.id} · ${topArtist![1]} plays</p></div>` : ''}
            <div class="cmp__wrapped-stat"><p class="cmp__wrapped-stat-label">Tracks heard</p><p class="cmp__wrapped-stat-val">${Object.keys(plays).length}<span style="opacity:0.5;font-size:18px;"> / ${TRACKS.length}</span></p><p class="cmp__wrapped-stat-sub">unique songs played</p></div>
            <div class="cmp__wrapped-stat"><p class="cmp__wrapped-stat-label">Saved</p><p class="cmp__wrapped-stat-val">${saved.length}</p><p class="cmp__wrapped-stat-sub">hearts on tracks</p></div>
          </div>
        </div>

        ${topTracks.length ? `<section class="cmp__section" style="padding-top: 8px;"><header class="cmp__section-head"><h2 class="cmp__section-title">Your top ${topTracks.length}</h2></header>
          <table class="cmp__tracks">
            <thead><tr><th class="cmp__tracks-num">#</th><th></th><th>Title</th><th>Artist</th><th>Plays</th></tr></thead>
            <tbody>
              ${topTracks.map((x, i) => `<tr class="cmp__tracks-row" data-tid="${x.track!.id}">
                <td class="cmp__tracks-num"><span>${i+1}</span></td>
                <td class="cmp__tracks-art"><div class="cmp__tracks-art-frame" style="--art-c1: ${x.track!.color};"><img src="https://noun.pics/${x.track!.artistId}.svg" alt=""/></div></td>
                <td class="cmp__tracks-name">${escape(x.track!.name)}</td>
                <td class="cmp__tracks-artist"><a href="#" data-artist="${x.track!.artistId}">${escape(x.track!.artist)}</a></td>
                <td class="cmp__tracks-bpm">${x.plays}</td>
              </tr>`).join('')}
            </tbody>
          </table>
        </section>` : ''}
      </div>
    `;
  }

  function renderPlaylist(pid: string): string {
    if (pid in MIXES) {
      const m = MIXES[pid];
      return `
        <section class="cmp__hero" style="--hero-c: ${m.color}aa;">
          <p class="cmp__hero-kicker">Playlist · daily mix</p>
          <h1 class="cmp__hero-title">${escape(m.name)}</h1>
          <p class="cmp__hero-sub">${m.tracks.length} tracks. Reshuffles at midnight. Your queue · your tonight.</p>
          <div class="cmp__hero-actions">
            <button class="cmp__hero-cta" data-pid="${pid}"><span>▶</span> play playlist</button>
          </div>
        </section>
        <section class="cmp__section">${tracksTable(m.tracks)}</section>
      `;
    }
    const p = userPlaylists.find(x => x.id === pid);
    if (!p) return `<div class="cmp__empty"><div class="cmp__empty-icon">?</div><p>Playlist not found</p></div>`;
    const tracks = p.tracks.map(tid => TRACKS.find(t => t.id === tid)).filter((t): t is Track => !!t);
    return `
      <section class="cmp__hero" style="--hero-c: var(--cmp-walnut);">
