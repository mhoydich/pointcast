---
import BlockLayout from '../layouts/BlockLayout.astro';
import MicroAppShell from '../components/MicroAppShell.astro';
import { MORNING_OCEAN_TOKENS } from '../data/morning-ocean';
import { ZEN_CAT_GENESIS_COLLECTIBLES } from '../data/zen-cat-collectibles';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('signal-garden')!;
const title = app.name;
const description = app.description;

const sourceData = [
  {
    id: 'mint',
    label: 'Mint Receipts',
    key: 'pc:mint-studio:receipts',
    href: '/mint-studio',
    type: 'sprout',
    color: '#bf6f54',
    empty: 'Draft a first mint receipt.',
  },
  {
    id: 'harbor',
    label: 'Harbor Watch',
    key: 'pc:harbor-log:watchlist',
    href: '/harbor-log',
    type: 'sprout',
    color: '#3f7681',
    empty: 'Watch one morning vessel.',
  },
  {
    id: 'passport',
    label: 'Cat Passport',
    key: 'pc:cat-passport:stamps',
    href: '/cat-passport',
    type: 'leaf',
    color: '#b84f55',
    empty: 'Stamp one cat route.',
  },
  {
    id: 'gallery',
    label: 'Gallery Shows',
    key: 'pc:gallery-wall:shows',
    href: '/gallery-wall',
    type: 'flower',
    color: '#875c9e',
    empty: 'Curate one wall.',
  },
  {
    id: 'ritual',
    label: 'Ritual Marks',
    key: 'pc:ritual-clock:marks',
    href: '/ritual-clock',
    type: 'flower',
    color: '#c38b35',
    empty: 'Mark the day.',
  },
  {
    id: 'exchange',
    label: 'Exchange Notes',
    key: 'pc:exchange-table:wishes',
    href: '/exchange-table',
    type: 'leaf',
    color: '#7b8b53',
    empty: 'Write one private intent.',
  },
  {
    id: 'provenance',
    label: 'Provenance Proofs',
    key: 'pc:provenance-ledger:exports',
    href: '/provenance-ledger',
    type: 'stone',
    color: '#586c8c',
    empty: 'Scan the cabinet.',
  },
  {
    id: 'atlas',
    label: 'World Atlas',
    key: 'pc:world-atlas:stamps',
    href: '/world-atlas',
    type: 'vine',
    color: '#267f78',
    empty: 'Stamp a world route.',
  },
  {
    id: 'sats',
    label: 'Sats Path',
    key: 'pc:sats-path:checks',
    href: '/sats-path',
    type: 'stone',
    color: '#c39b39',
    empty: 'Mark one checkpoint.',
  },
  {
    id: 'ocean',
    label: 'Morning Ocean',
    key: 'pc:morning-ocean:collection',
    href: '/morning-ocean',
    type: 'sprout',
    color: '#6b8e99',
    empty: 'Collect one ocean card.',
  },
  {
    id: 'cats',
    label: 'Zen Cats',
    key: 'pc:zen-cats:collection',
    href: '/zen-cats',
    type: 'flower',
    color: '#d28c7a',
    empty: 'Collect a daily cat.',
  },
  {
    id: 'manual',
    label: 'Garden Plants',
    key: 'pc:signal-garden:plants',
    href: '/signal-garden',
    type: 'flower',
    color: '#2f8f5f',
    empty: 'Plant today.',
  },
];

const heroImages = [
  ZEN_CAT_GENESIS_COLLECTIBLES[7],
  ZEN_CAT_GENESIS_COLLECTIBLES[1],
  MORNING_OCEAN_TOKENS[6],
  ZEN_CAT_GENESIS_COLLECTIBLES[4],
  MORNING_OCEAN_TOKENS[10],
  ZEN_CAT_GENESIS_COLLECTIBLES[12],
].map((item) => ({
  src: item.imageUrl,
  alt: `${item.title} collectible signal`,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/signal-garden',
  name: app.name,
  description,
  url: app.url,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <MicroAppShell
    app={app}
    headline="Let the collection grow into a garden."
    dek="Signal Garden reads your local PointCast activity and turns it into an ambient planting bed. Receipts become sprouts, rituals bloom, atlas stamps trail into vines, and proof sheets settle as stones."
    images={heroImages}
    stats={[
      { label: 'Sources', value: sourceData.length },
      { label: 'Storage', value: 'local' },
      { label: 'Garden', value: 'live' },
      { label: 'Sync', value: 'none' },
    ]}
    links={[
      { href: '/cabinet', label: 'Cabinet' },
      { href: '/observatory', label: 'Sky' },
      { href: '/apps', label: 'Apps' },
    ]}
  >
    <section class="app-section signal-garden" data-signal-garden>
      <div class="garden-layout">
        <section class="garden-bed" aria-label="Local signal garden">
          <div class="garden-bed__top">
            <div>
              <p class="mono-note">Local Growth</p>
              <h2 data-garden-title>Quiet seed bed</h2>
            </div>
            <div class="growth-meter">
              <span>Signals</span>
              <strong data-garden-total>0</strong>
            </div>
          </div>
          <svg class="garden-canvas" viewBox="0 0 1000 600" role="img" aria-labelledby="garden-title garden-desc">
            <title id="garden-title">Signal Garden generated from local PointCast receipts</title>
            <desc id="garden-desc">A local-only garden where saved PointCast activity appears as sprouts, flowers, vines, leaves, and stones.</desc>
            <defs>
              <linearGradient id="garden-ground" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="#f8f3e6" />
                <stop offset="58%" stop-color="#dbe7d9" />
                <stop offset="100%" stop-color="#a9c1ae" />
              </linearGradient>
              <filter id="garden-soften">
                <feGaussianBlur stdDeviation="0.6" />
              </filter>
            </defs>
            <rect width="1000" height="600" fill="url(#garden-ground)" />
            <path d="M40 472 C210 410 336 454 506 428 C680 400 764 338 958 380" fill="none" stroke="#345b45" stroke-width="2" opacity="0.16" />
            <path d="M88 516 C244 458 420 506 596 470 C748 438 848 448 950 490" fill="none" stroke="#8a6a38" stroke-width="2" opacity="0.18" />
            <g data-empty-seeds>
              <circle cx="312" cy="390" r="16" fill="#2f8f5f" opacity="0.28" />
              <circle cx="492" cy="350" r="16" fill="#c38b35" opacity="0.28" />
              <circle cx="672" cy="398" r="16" fill="#586c8c" opacity="0.28" />
            </g>
            <g data-garden-layer></g>
          </svg>
        </section>

        <aside class="tool-panel tool-panel--ink garden-reading">
          <p class="mono-note">Garden Reading</p>
          <h2 data-reading-title>Nothing planted yet.</h2>
          <p data-reading-copy>Open a source app or plant today. The garden stays in this browser.</p>
          <div class="garden-actions">
            <button type="button" data-refresh-garden>Refresh garden</button>
            <button type="button" data-plant-today>Plant today</button>
            <button type="button" data-clear-garden>Clear garden plants</button>
          </div>
          <ol class="suggestion-list" data-garden-suggestions>
            <li><a href="/mint-studio">Draft a mint receipt</a></li>
            <li><a href="/ritual-clock">Mark the day</a></li>
            <li><a href="/world-atlas">Stamp a route</a></li>
          </ol>
        </aside>
      </div>

      <section class="source-grid" aria-label="Signal Garden source counts">
        {sourceData.map((source) => (
          <article style={`--source-color:${source.color}`} data-source-card={source.id}>
            <span class="source-dot" aria-hidden="true"></span>
            <div>
              <p class="mono-note">{source.label}</p>
              <strong data-source-count={source.id}>0</strong>
              <small>{source.type}</small>
            </div>
            <a href={source.href}>{source.empty}</a>
          </article>
        ))}
      </section>
    </section>
  </MicroAppShell>
  <script id="signal-sources" type="application/json" is:inline set:html={JSON.stringify(sourceData)}></script>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-signal-garden]');
    const dataEl = document.querySelector('#signal-sources');
    if (!root || !dataEl) return;

    const sources = JSON.parse(dataEl.textContent || '[]');
    const plantKey = 'pc:signal-garden:plants';
    const NS = 'http://www.w3.org/2000/svg';
    const layer = root.querySelector('[data-garden-layer]');
    const emptySeeds = root.querySelector('[data-empty-seeds]');

    const readArray = (key) => {
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || '[]');
        if (Array.isArray(parsed)) return parsed;
        if (parsed && typeof parsed === 'object') return Object.values(parsed);
      } catch {}
      return [];
    };
    const savePlants = (items) => localStorage.setItem(plantKey, JSON.stringify(items.slice(-80)));
    const plantLabel = (item, fallback) => {
      if (!item || typeof item !== 'object') return fallback;
      return item.title || item.name || item.alias || item.subject || item.label || item.id || fallback;
    };
    const seedFor = (text) => {
      let seed = 0;
      for (let i = 0; i < text.length; i++) seed = (seed * 33 + text.charCodeAt(i)) >>> 0;
      return seed || 1;
    };
    const rand = (seed) => {
      let next = seed >>> 0;
      return () => {
        next = (next * 1664525 + 1013904223) >>> 0;
        return next / 4294967296;
      };
    };
    const svgEl = (tag, attrs = {}) => {
      const el = document.createElementNS(NS, tag);
      Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
      return el;
    };
    const drawPlant = (plant) => {
      const group = svgEl('g', { transform: `translate(${plant.x} ${plant.y})`, opacity: 0.92 });
      const height = 34 + plant.growth * 10;
      if (plant.type === 'stone') {
        group.appendChild(svgEl('ellipse', { cx: 0, cy: 0, rx: 18 + plant.growth * 3, ry: 10 + plant.growth, fill: plant.color, opacity: 0.7 }));
        group.appendChild(svgEl('ellipse', { cx: -5, cy: -3, rx: 5, ry: 2.5, fill: '#fffaf0', opacity: 0.44 }));
      } else if (plant.type === 'vine') {
        group.appendChild(svgEl('path', { d: `M-28 0 C-10 -${height}, 12 -${height * 0.4}, 28 -${height}`, fill: 'none', stroke: plant.color, 'stroke-width': 4, 'stroke-linecap': 'round' }));
        group.appendChild(svgEl('ellipse', { cx: -10, cy: -height * 0.62, rx: 9, ry: 5, fill: plant.color, transform: 'rotate(-28)' }));
        group.appendChild(svgEl('ellipse', { cx: 12, cy: -height * 0.48, rx: 9, ry: 5, fill: plant.color, transform: 'rotate(24)' }));
      } else {
        group.appendChild(svgEl('path', { d: `M0 0 C-4 -${height * 0.36}, 2 -${height * 0.7}, 0 -${height}`, fill: 'none', stroke: '#345b45', 'stroke-width': 4, 'stroke-linecap': 'round' }));
        group.appendChild(svgEl('ellipse', { cx: -11, cy: -height * 0.46, rx: 13, ry: 6, fill: plant.color, opacity: 0.82, transform: 'rotate(-24)' }));
        group.appendChild(svgEl('ellipse', { cx: 12, cy: -height * 0.62, rx: 12, ry: 6, fill: plant.color, opacity: 0.74, transform: 'rotate(26)' }));
        if (plant.type === 'flower') {
          for (let i = 0; i < 6; i++) {
            const angle = (Math.PI * 2 * i) / 6;
            group.appendChild(svgEl('ellipse', {
              cx: Math.cos(angle) * 10,
              cy: -height + Math.sin(angle) * 10,
              rx: 6,
              ry: 10,
              fill: plant.color,
              opacity: 0.78,
              transform: `rotate(${i * 60} ${Math.cos(angle) * 10} ${-height + Math.sin(angle) * 10})`,
            }));
          }
          group.appendChild(svgEl('circle', { cx: 0, cy: -height, r: 5, fill: '#fff1b8' }));
        }
      }
      return group;
    };
    const gardenItems = () => {
      const items = [];
      sources.forEach((source) => {
        const receipts = readArray(source.key);
        root.querySelector(`[data-source-count="${source.id}"]`).textContent = String(receipts.length);
        receipts.slice(-10).forEach((receipt, index) => {
          const random = rand(seedFor(`${source.id}:${index}:${plantLabel(receipt, source.label)}`));
          items.push({
            id: `${source.id}-${index}`,
            source: source.id,
            label: plantLabel(receipt, source.label),
            type: source.type,
            color: source.color,
            growth: Math.min(6, Math.max(1, Math.ceil(receipts.length / 2))),
            x: 90 + random() * 820,
            y: 270 + random() * 230,
          });
        });
      });
      return items;
    };
    const render = () => {
      const plants = gardenItems();
      const total = plants.length;
      layer.replaceChildren(...plants.map(drawPlant));
      emptySeeds.style.display = total ? 'none' : '';
      root.querySelector('[data-garden-total]').textContent = String(total);
      root.querySelector('[data-garden-title]').textContent = total ? 'Signals taking root' : 'Quiet seed bed';
      root.querySelector('[data-reading-title]').textContent = total ? `${total} signal${total === 1 ? '' : 's'} growing` : 'Nothing planted yet.';
      root.querySelector('[data-reading-copy]').textContent = total
        ? 'Your local activity is visible as an ambient garden. Nothing leaves this browser.'
        : 'Open a source app or plant today. The garden stays in this browser.';
    };
    root.querySelector('[data-refresh-garden]')?.addEventListener('click', render);
    root.querySelector('[data-plant-today]')?.addEventListener('click', () => {
      const plants = readArray(plantKey);
      plants.push({
        id: `plant-${Date.now()}`,
        source: 'manual',
        label: 'Manual garden plant',
        plantedAt: new Date().toISOString(),
        color: '#2f8f5f',
        growth: 1,
      });
      savePlants(plants);
      render();
    });
    root.querySelector('[data-clear-garden]')?.addEventListener('click', () => {
      localStorage.removeItem(plantKey);
      render();
    });
    render();
  })();
</script>

<style>
  .garden-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
    gap: 12px;
  }
  .garden-bed {
    min-width: 0;
    border: 1px solid var(--pc-rule-soft);
    background: #f8f3e6;
    overflow: hidden;
  }
  .garden-bed__top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    border-bottom: 1px solid rgba(18, 17, 14, 0.12);
    background: rgba(255, 250, 240, 0.72);
  }
  .growth-meter {
    min-width: 110px;
    text-align: right;
  }
  .growth-meter span {
    display: block;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .growth-meter strong {
    display: block;
    margin-top: 5px;
    font-size: 34px;
    line-height: 1;
    font-weight: 500;
  }
  .garden-canvas {
    display: block;
    width: 100%;
    height: auto;
    min-height: 430px;
  }
  .garden-reading {
    display: flex;
    flex-direction: column;
  }
  .garden-actions {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }
  .suggestion-list {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .suggestion-list a {
    display: block;
    border: 1px solid rgba(246, 241, 228, 0.18);
    color: #f6f1e4;
    padding: 10px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .source-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }
  .source-grid article {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 10px;
    min-width: 0;
  }
  .source-dot {
    width: 12px;
    height: 12px;
    margin-top: 2px;
    background: var(--source-color);
    border-radius: 999px;
  }
  .source-grid strong {
    display: block;
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
  }
  .source-grid small {
    color: var(--pc-ink-muted);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .source-grid a {
    grid-column: 1 / -1;
    color: var(--pc-ink);
    font-size: 13px;
    line-height: 1.35;
  }
  @media (max-width: 920px) {
    .garden-layout,
    .source-grid {
      grid-template-columns: 1fr;
    }
    .garden-canvas {
      min-height: 320px;
    }
  }
</style>
