---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import CommunicationsLab from '../../../components/CommunicationsLab.astro';
import source from '../../../data/communications-lab.json';
import {normalizeLab} from '../../../lib/communications-lab-normalize.mjs';
import '../../../styles/communications-lab.css';
const lab = normalizeLab(source);
export function getStaticPaths() { return normalizeLab(source).projects.map(project => ({ params:{slug:project.slug},props:{project} })); }
const {project} = Astro.props;
---
<BlockLayout title={project.title + " · Communications Lab"} description={project.question} image="/communications-lab/assets/social-card.png" isolated={true} hideAds={true} showNetworkStrip={false} alternates={[{type:'application/json',href:'/communications-lab/briefs.json',title:'Communications Lab project briefs'}]}><CommunicationsLab lab={lab} project={project} /></BlockLayout>
