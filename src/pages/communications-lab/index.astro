---
import BlockLayout from '../../layouts/BlockLayout.astro';
import CommunicationsLab from '../../components/CommunicationsLab.astro';
import source from '../../data/communications-lab.json';
import {normalizeLab} from '../../lib/communications-lab-normalize.mjs';
import '../../styles/communications-lab.css';
const lab = normalizeLab(source);

---
<BlockLayout title={"Communications Lab · Make the signal useful"} description={lab.intro} image="/communications-lab/assets/social-card.png" isolated={true} hideAds={true} showNetworkStrip={false} alternates={[{type:'application/json',href:'/communications-lab/briefs.json',title:'Communications Lab project briefs'}]}><CommunicationsLab lab={lab}  /></BlockLayout>
