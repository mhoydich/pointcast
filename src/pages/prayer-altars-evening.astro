---
/**
 * /prayer-altars-evening — The Evening Hours.
 *
 * Per Mike 2026-07-18, after the morning chamber shipped:
 *   "yah 5 more prayer alters same aprroach thank you"
 *
 * Five more prayer stations carrying the canonical hours past noon —
 * NONE, VESPERS, LUCERNARIUM, COMPLINE, VIGIL — tracing a Southern
 * California evening: the long golden light, the sunset, the lighting
 * of the lamps, the laying-down of the day, the watch through the
 * dark.
 *
 * Same approach as /prayer-altars: six pieces per station from the
 * same Midjourney session of 2026-07-18 ("morning ocean, southern
 * california summer, block glitch" — the session runs later than its
 * name), 30 more images, slow crossfade, one synthesized tone per
 * hour, PRAY button, perpetual counts on the shared /api/prayer.
 *
 * Sibling of /prayer-altars (the morning chamber). Same shrine
 * grammar, moved from pre-dawn indigo to ember plum.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import RoomPresenceChip from '../components/RoomPresenceChip.astro';

const title = 'Prayer Altars · The Evening Hours · PointCast';
const description =
  'Five more prayer stations for a Southern California evening — none, vespers, lucernarium, compline, vigil. Thirty more Midjourney pieces on slow rotation. Tap PRAY, leave a prayer.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Prayer Altars — The Evening Hours',
  url: 'https://pointcast.xyz/prayer-altars-evening',
  description,
  applicationCategory: 'MultimediaApplication',
};

interface Station {
  key: string;
  hour: string;
  glyph: string;
  time: string;
  devotion: string;
  line: string;
  tone: string;
  accent: string;
  alts: string[];
}

const STATIONS: Station[] = [
  {
    key: 'none',
    hour: 'NONE',
    glyph: '◐',
    time: 'the long light',
    devotion: 'the patience',
    line: 'for the slow hours that still count',
    tone: 'slant chord',
    accent: '#e0a83c',
    alts: [
      'Golden modern house standing on a sea rock in honey light',
      'Orange sun disk over a collaged afternoon sea',
      'Warm striped panels over slanting afternoon water',
      'Gold-leaf panels breaking over an afternoon rock',
      'Small sun hanging over glittering late water',
      'Amber grid holding rocks in the long light',
    ],
  },
  {
    key: 'vespers',
    hour: 'VESPERS',
    glyph: '✹',
    time: 'at sundown',
    devotion: 'the thanksgiving',
    line: 'for the day as it sets',
    tone: 'setting bells',
    accent: '#ff7a59',
    alts: [
      'Shoreline dissolving into warm evening static',
      'Brown rocks holding the last warm panels',
      'Coral bands laid across an evening tide',
      'Pink and orange cliff blazing at sundown',
      'Orange and teal geometry folding into dusk',
      'Fire-colored surf breaking under the last light',
    ],
  },
  {
    key: 'lucernarium',
    hour: 'LUCERNARIUM',
    glyph: '✧',
    time: 'the lamplighting',
    devotion: 'the kindling',
    line: 'for the small lights we keep',
    tone: 'lamp flicker',
    accent: '#ffd98e',
    alts: [
      'House on the dark cliff with one pale window lit',
      'Lime panel glowing in an evening color grid',
      'Mirror-ball moon rising lit over a dark sea',
      'White house kept bright above blackening rocks',
      'Pale moon disk set in a violet grid',
      'Glass rooms shining over the night surf',
    ],
  },
  {
    key: 'compline',
    hour: 'COMPLINE',
    glyph: '☽',
    time: 'nightfall',
    devotion: 'the release',
    line: 'for laying the day down',
    tone: 'night bowl',
    accent: '#8a63c9',
    alts: [
      'Violet panels folding over a quieting sea',
      'Teal and magenta cliff glitching into night',
      'Gold and violet blocks settling on evening rocks',
      'Lavender grid dimming toward the dark',
      'Dark house on the rocks, rainbow static in the windows',
      'Storm block resting on a nightfall sea',
    ],
  },
  {
    key: 'vigil',
    hour: 'VIGIL',
    glyph: '✶',
    time: 'through the dark',
    devotion: 'the watch',
    line: 'for those awake while others sleep',
    tone: 'watch drone',
    accent: '#4a6bb5',
    alts: [
      'Low-lit rocks holding through the dark',
      'Black-green sea stacks under no moon',
      'Night surf breaking deep blue on deep blue',
      'Dark channel rocks under a fading grid',
      'Mist and rock keeping watch together',
      'Klein-blue night sea, nothing else awake',
    ],
  },
];

const IMAGES_PER_STATION = 6;
const IMG = (key: string, n: number) => `/images/prayer-altars/${key}-${n}.jpg`;
---

<BlockLayout title={title} description={description} image="/images/og-prayer-altars-evening.png" jsonLd={jsonLd}>
  <main class="pe" id="pe-main">
    <RoomPresenceChip surface="evening" />

    <header class="pe__header">
      <div class="pe__chrome">
        <span class="pe__chrome-label">THE EVENING HOURS</span>
        <span class="pe__sep">·</span>
        <span class="pe__chrome-label">PRAYERS</span>
        <span class="pe__total" id="pe-total">—</span>
      </div>
      <h1 class="pe__title">PRAYER ALTARS</h1>
      <p class="pe__tagline">
        five stations for a southern california evening · thirty more pieces on
        slow rotation · the morning chamber is at
        <a href="/prayer-altars">/prayer-altars</a>
      </p>
    </header>

    <section class="pe__altars" id="pe-altars">
      {STATIONS.map((s, i) => (
        <article class="pe__altar" data-station={s.key} data-idx={i} style={`--pe-accent:${s.accent}`}>
          <div class="pe__pediment" aria-hidden="true">{s.glyph}</div>
          <div class="pe__frame">
            <div class="pe__frame-inner" data-slideshow>
              {Array.from({ length: IMAGES_PER_STATION }, (_, n) => (
                <img
                  class:list={['pe__slide', { 'pe__slide--on': n === 0 }]}
                  src={IMG(s.key, n + 1)}
                  alt={s.alts[n]}
                  loading={i < 2 && n === 0 ? 'eager' : 'lazy'}
                  data-slide={n}
                />
              ))}
            </div>
          </div>
          <div class="pe__nameplate">
            <span class="pe__hour">{s.hour}</span>
            <span class="pe__time">{s.time}</span>
          </div>
          <div class="pe__devotion">
            <span class="pe__devotion-name">{s.devotion}</span>
            <span class="pe__devotion-line">{s.line}</span>
          </div>
          <div class="pe__count" data-count="0">
            <span class="pe__count-num" data-count-text>—</span>
            <span class="pe__count-label">prayers offered</span>
          </div>
          <button class="pe__pray" type="button" data-pray aria-label={`Pray at ${s.hour}`}>PRAY</button>
          <div class="pe__tone-tag">{s.tone}</div>
          <div class="pe__candle" aria-hidden="true">
            <div class="pe__flame"></div>
            <div class="pe__wax"></div>
          </div>
        </article>
      ))}
    </section>

    <section class="pe__feed">
      <header class="pe__feed-header">
        <span class="pe__feed-title">RECENT PRAYERS</span>
        <span class="pe__feed-sub">live · last 8 · both chambers</span>
      </header>
      <ol class="pe__feed-list" id="pe-feed">
        <li class="pe__feed-empty">— waiting for the first prayer —</li>
      </ol>
    </section>

    <section class="pe__how">
      <h2>HOW THIS WORKS</h2>
      <ol class="pe__how-list">
        <li>
          Five stations carry the canonical hours past noon — <em>none</em> in
          the long light, <em>vespers</em> at sundown, <em>lucernarium</em> at
          the lamplighting, <em>compline</em> at nightfall, <em>vigil</em>
          through the dark.
        </li>
        <li>
          Each station holds six more pieces from Mike's Midjourney session of
          July 18, 2026 — thirty images, none shared with the morning chamber,
          turning on a slow crossfade.
        </li>
        <li>
          Tap <span class="pe__kbd">PRAY</span> to offer a prayer. The
          station's tone sounds, the candle flares, the image turns, the count
          rises for everyone watching. One prayer per station per 5 seconds.
        </li>
        <li>
          Counts are perpetual and the feed is shared with the morning chamber
          at <a href="/prayer-altars">/prayer-altars</a>. The whole session
          hangs at <a href="/gallery">/gallery</a>.
        </li>
      </ol>
      <p class="pe__blessing">peace be with you</p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  /* Ember-plum shrine — evening sibling to /prayer-altars' indigo. */
  body:has(#pe-main) {
    background: #180b1e;
  }

  .pe {
    --pe-plum: #180b1e;
    --pe-plum-deep: #0a0509;
    --pe-plum-mid: #2e1430;
    --pe-brass: #d4a437;
    --pe-brass-soft: #b8862c;
    --pe-brass-deep: #6b4d12;
    --pe-flame: #f6c15e;
    --pe-flame-tip: #ff6b3a;
    --pe-ink-light: #eee4d4;
    --pe-ink-mid: #baa98e;
    --pe-ink-dim: #7a6c55;
    --pe-rule-soft: rgba(212, 164, 55, 0.18);
    --pe-glow: rgba(255, 122, 89, 0.07);

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 32px 80px;
    color: var(--pe-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 122, 89, 0.10), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(74, 107, 181, 0.08), transparent 70%),
      linear-gradient(180deg, var(--pe-plum) 0%, var(--pe-plum-deep) 100%);
  }

  /* Ember-mote overlay — tiny points, very low opacity */
  .pe::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18px 26px, var(--pe-glow) 1px, transparent 1.5px),
      radial-gradient(circle at 64px 58px, var(--pe-glow) 1px, transparent 1.5px);
    background-size: 84px 84px;
    opacity: 0.6;
    z-index: -1;
  }

  /* ── Header ───────────────────────────────────────────── */
  .pe__header {
    text-align: center;
    padding: 36px 16px 28px;
    border-bottom: 1px solid var(--pe-rule-soft);
    margin-bottom: 36px;
  }

  .pe__chrome {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border: 1.5px solid var(--pe-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pe-ink-mid);
    background: rgba(0, 0, 0, 0.3);
  }
  .pe__chrome-label { color: var(--pe-ink-dim); }
  .pe__total { color: var(--pe-brass); font-weight: 700; }
  .pe__sep { color: var(--pe-brass-deep); }

  .pe__title {
    margin: 14px 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--pe-brass);
    text-shadow:
      0 0 24px rgba(212, 164, 55, 0.35),
      0 2px 0 var(--pe-plum-deep);
  }

  .pe__tagline {
    margin: 0 auto;
    max-width: 680px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--pe-ink-mid);
  }
  .pe__tagline a { color: var(--pe-brass); }

  /* ── Altars row ───────────────────────────────────────── */
  .pe__altars {
    display: grid;
    grid-template-columns: repeat(5, minmax(180px, 1fr));
    gap: 16px;
    padding: 0 8px;
  }
  @media (max-width: 980px) {
    .pe__altars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .pe__altars { grid-template-columns: 1fr; max-width: 340px; margin-inline: auto; }
  }

  .pe__altar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 12px 20px;
    background: linear-gradient(180deg, rgba(46, 20, 48, 0.65), rgba(10, 5, 9, 0.85));
    border: 1.5px solid var(--pe-brass-deep);
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.25),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5),
      0 6px 20px rgba(0, 0, 0, 0.55);
    position: relative;
  }

  .pe__pediment {
    font-size: 22px;
    color: var(--pe-accent, var(--pe-brass));
    line-height: 1;
    margin-bottom: 8px;
    text-shadow: 0 0 12px var(--pe-accent, var(--pe-brass));
  }

  .pe__frame {
    width: 100%;
    max-width: 176px;
    aspect-ratio: 1;
    padding: 6px;
    background:
      linear-gradient(135deg, var(--pe-brass) 0%, var(--pe-brass-soft) 50%, var(--pe-brass-deep) 100%);
    box-shadow:
      0 0 0 2px var(--pe-plum-deep),
      0 0 0 4px var(--pe-brass-deep),
      0 4px 12px rgba(0, 0, 0, 0.6);
    margin-bottom: 12px;
  }
  .pe__frame-inner {
    width: 100%;
    height: 100%;
    background: var(--pe-plum-deep);
    overflow: hidden;
    position: relative;
  }
  .pe__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 1600ms ease-in-out;
  }
  .pe__slide--on { opacity: 1; }

  .pe__nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 6px;
  }
  .pe__hour {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 18px;
    letter-spacing: 0.12em;
    color: var(--pe-ink-light);
  }
  .pe__time {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pe-ink-dim);
    margin-top: 2px;
  }

  .pe__devotion {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 10px;
  }
  .pe__devotion-name {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--pe-accent, var(--pe-flame));
  }
  .pe__devotion-line {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 11px;
    color: var(--pe-ink-dim);
  }

  .pe__count {
    text-align: center;
    margin-bottom: 12px;
  }
  .pe__count-num {
    display: block;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 28px;
    font-weight: 800;
    color: var(--pe-flame);
    letter-spacing: 0.06em;
    line-height: 1.05;
    text-shadow: 0 0 8px rgba(246, 193, 94, 0.35);
  }
  .pe__count-label {
    display: block;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--pe-ink-dim);
    margin-top: 2px;
  }

  .pe__pray {
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 12px 26px;
    margin-bottom: 8px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: var(--pe-plum-deep);
    background: linear-gradient(180deg, var(--pe-brass) 0%, var(--pe-brass-soft) 100%);
    border-radius: 0;
    box-shadow:
      0 0 0 2px var(--pe-plum-deep),
      0 4px 0 0 var(--pe-brass-deep),
      0 4px 12px rgba(212, 164, 55, 0.25);
    transition: transform 80ms, box-shadow 80ms, background 120ms;
  }
  .pe__pray:hover {
    background: linear-gradient(180deg, #efbb46 0%, var(--pe-brass) 100%);
  }
  .pe__pray:active,
  .pe__pray.pe__pray--praying {
    transform: translateY(3px);
    box-shadow:
      0 0 0 2px var(--pe-plum-deep),
      0 1px 0 0 var(--pe-brass-deep),
      0 0 16px rgba(246, 193, 94, 0.6);
  }
  .pe__pray:disabled {
    cursor: wait;
    opacity: 0.5;
    transform: translateY(2px);
  }

  .pe__tone-tag {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pe-ink-dim);
    margin-bottom: 10px;
  }

  /* Candle */
  .pe__candle {
    width: 14px;
    height: 36px;
    position: relative;
    margin-top: 2px;
  }
  .pe__wax {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 14px;
    height: 24px;
    background: linear-gradient(180deg, #eee4d4 0%, #baa98e 100%);
    box-shadow:
      inset -1px 0 0 rgba(0,0,0,0.25),
      inset 1px 0 0 rgba(255,255,255,0.4);
  }
  .pe__wax::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 4px;
    background: #2a1a08;
  }
  .pe__flame {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 14px;
    background: radial-gradient(ellipse 4px 8px at 50% 70%, var(--pe-flame-tip) 0%, var(--pe-flame) 50%, transparent 75%);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.4px);
    animation: pe-flicker 1.6s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .pe__altar.pe__altar--lit .pe__flame {
    animation: pe-flare 0.9s ease-out;
  }
  @keyframes pe-flicker {
    0%,100% { transform: translateX(-50%) scale(1, 1) rotate(0deg); opacity: 0.85; }
    25%     { transform: translateX(-50%) scale(0.96, 1.06) rotate(-2deg); opacity: 1; }
    50%     { transform: translateX(-50%) scale(1.04, 0.94) rotate(1deg); opacity: 0.9; }
    75%     { transform: translateX(-50%) scale(0.98, 1.02) rotate(-1deg); opacity: 1; }
  }
  @keyframes pe-flare {
    0%   { transform: translateX(-50%) scale(1, 1); filter: blur(0.4px) brightness(1); }
    20%  { transform: translateX(-50%) scale(1.5, 1.8); filter: blur(0.8px) brightness(1.6); }
    100% { transform: translateX(-50%) scale(1, 1); filter: blur(0.4px) brightness(1); }
  }

  .pe__altar::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 8px;
    background: radial-gradient(ellipse at center, rgba(246, 193, 94, 0.20), transparent 60%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease-out;
  }
  .pe__altar.pe__altar--lit::after { opacity: 1; }

  /* ── Recent feed ──────────────────────────────────────── */
  .pe__feed {
    margin-top: 48px;
    padding: 24px 16px;
    border-top: 1px solid var(--pe-rule-soft);
    border-bottom: 1px solid var(--pe-rule-soft);
  }
  .pe__feed-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .pe__feed-title {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.30em;
    color: var(--pe-brass);
    text-transform: uppercase;
  }
  .pe__feed-sub {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 12px;
    color: var(--pe-ink-dim);
  }
  .pe__feed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pe__feed-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px;
    color: var(--pe-ink-mid);
    border-left: 2px solid transparent;
    transition: border-color 200ms, background 200ms;
  }
  .pe__feed-list li.pe__feed-fresh {
    border-left-color: var(--pe-flame);
    background: rgba(246, 193, 94, 0.05);
  }
  .pe__feed-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px currentColor;
  }
  .pe__feed-empty {
    color: var(--pe-ink-dim) !important;
    font-style: italic;
    font-family: 'Lora', Georgia, serif !important;
    border-left: 0 !important;
  }

  /* ── How ──────────────────────────────────────────────── */
  .pe__how {
    margin-top: 48px;
    padding: 24px 16px;
    max-width: 820px;
    margin-inline: auto;
  }
  .pe__how h2 {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: 24px;
    color: var(--pe-brass);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }
  .pe__how-list {
    list-style: decimal;
    padding-left: 22px;
    margin: 0;
  }
  .pe__how-list li {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--pe-ink-mid);
    margin-bottom: 10px;
  }
  .pe__how-list em {
    color: var(--pe-flame);
    font-style: italic;
    font-weight: 500;
  }
  .pe__how-list a {
    color: var(--pe-brass);
  }
  .pe__kbd {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    color: var(--pe-plum-deep);
    background: var(--pe-brass);
    border-radius: 2px;
    letter-spacing: 0.18em;
    font-weight: 700;
  }
  .pe__blessing {
    margin-top: 28px;
    text-align: center;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 15px;
    color: var(--pe-ink-dim);
    letter-spacing: 0.08em;
  }
</style>

<script>
  // ── Identity ─────────────────────────────────────────────
  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) {
        sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(SID_KEY, sid);
      }
      return sid;
    } catch {
      return 'sid-anon-' + Date.now();
    }
  }
  const SID = ensureSid();

  // Both chambers' accents — the shared feed can carry morning prayers too.
  const STATION_ACCENTS: Record<string, string> = {
    matins: '#9b7bff',
    lauds: '#f6c15e',
    prime: '#9db8a1',
    terce: '#e0603a',
    sext: '#3a7bd5',
    none: '#e0a83c',
    vespers: '#ff7a59',
    lucernarium: '#ffd98e',
    compline: '#8a63c9',
    vigil: '#4a6bb5',
  };

  // ── Audio — five evening tones ───────────────────────────
  let actx: AudioContext | null = null;
  function ctx(): AudioContext {
    if (!actx) {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  function noiseBuffer(a: AudioContext, seconds: number): AudioBuffer {
    const buf = a.createBuffer(1, a.sampleRate * seconds, a.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    return buf;
  }

  // NONE — slant chord: warm major third with a lazy tremolo
  function playNone() {
    const a = ctx(); const t = a.currentTime;
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = 196.0; // G3
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 246.94; // B3
    const trem = a.createOscillator(); trem.type = 'sine'; trem.frequency.value = 3.2;
    const tremGain = a.createGain(); tremGain.gain.value = 0.06;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.22, t + 0.35);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 2.6);
    trem.connect(tremGain).connect(g.gain);
    o1.connect(g); o2.connect(g); g.connect(a.destination);
    o1.start(t); o2.start(t); trem.start(t);
    o1.stop(t + 2.7); o2.stop(t + 2.7); trem.stop(t + 2.7);
  }
  // VESPERS — setting bells: descending arpeggio, mirror of lauds
  function playVespers() {
    const a = ctx(); const base = a.currentTime;
    const notes = [523.25, 392.0, 329.63, 261.63]; // C5 G4 E4 C4 — down
    notes.forEach((f, i) => {
      const t = base + i * 0.13;
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.76;
      const g = a.createGain(); const g2 = a.createGain();
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.20, t + 0.006); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
      g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.04, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
      o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
      o.start(t); o.stop(t + 1.7); o2.start(t); o2.stop(t + 1.0);
    });
  }
  // LUCERNARIUM — lamp flicker: three quick grains, then the lamp holds
  function playLucernarium() {
    const a = ctx(); const base = a.currentTime;
    [0, 0.07, 0.15].forEach((dt) => {
      const t = base + dt;
      const o = a.createOscillator(); o.type = 'triangle'; o.frequency.value = 784.0; // G5
      const g = a.createGain();
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.10, t + 0.004); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.1);
    });
    const t = base + 0.24;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 392.0; // G4 — the lamp
    const vib = a.createOscillator(); vib.type = 'sine'; vib.frequency.value = 5.2;
    const vibGain = a.createGain(); vibGain.gain.value = 2.4;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.20, t + 0.18);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 2.2);
    vib.connect(vibGain).connect(o.frequency);
    o.connect(g).connect(a.destination);
    o.start(t); vib.start(t); o.stop(t + 2.3); vib.stop(t + 2.3);
  }
  // COMPLINE — night bowl: low minor dyad, long soft decay
  function playCompline() {
    const a = ctx(); const t = a.currentTime;
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = 110.0;  // A2
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 130.81; // C3 — minor third
    const o3 = a.createOscillator(); o3.type = 'sine'; o3.frequency.value = 220.0;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 700;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.30, t + 0.05);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 3.4);
    o1.connect(filt); o2.connect(filt); o3.connect(filt); filt.connect(g).connect(a.destination);
    o1.start(t); o2.start(t); o3.start(t);
    o1.stop(t + 3.5); o2.stop(t + 3.5); o3.stop(t + 3.5);
  }
  // VIGIL — watch drone: sub fifth with slow beating, quietest and longest
  function playVigil() {
    const a = ctx(); const t = a.currentTime;
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = 55.0;   // A1
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 82.9;   // ~E2, slightly wide — slow beat
    const o3 = a.createOscillator(); o3.type = 'sine'; o3.frequency.value = 220.0;  // faint shimmer
    const g = a.createGain(); const g3 = a.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.24, t + 0.6);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 4.2);
    g3.gain.setValueAtTime(0.0001, t);
    g3.gain.linearRampToValueAtTime(0.03, t + 1.2);
    g3.gain.exponentialRampToValueAtTime(0.0001, t + 3.8);
    o1.connect(g); o2.connect(g); g.connect(a.destination);
    o3.connect(g3).connect(a.destination);
    o1.start(t); o2.start(t); o3.start(t);
    o1.stop(t + 4.3); o2.stop(t + 4.3); o3.stop(t + 4.3);
  }

  const TONES: Record<string, () => void> = {
    none: playNone,
    vespers: playVespers,
    lucernarium: playLucernarium,
    compline: playCompline,
    vigil: playVigil,
  };

  // ── Slideshows — slow crossfade, staggered starts ────────
  const SLIDE_MS = 7000;
  const slideState = new Map<Element, number>();

  function advanceSlide(altarEl: Element) {
    const slides = altarEl.querySelectorAll('.pe__slide');
    if (!slides.length) return;
    const cur = slideState.get(altarEl) ?? 0;
    const next = (cur + 1) % slides.length;
    slides[cur]?.classList.remove('pe__slide--on');
    slides[next]?.classList.add('pe__slide--on');
    slideState.set(altarEl, next);
  }

  document.querySelectorAll('.pe__altar').forEach((altarEl, i) => {
    slideState.set(altarEl, 0);
    setTimeout(() => {
      advanceSlide(altarEl);
      setInterval(() => advanceSlide(altarEl), SLIDE_MS);
    }, SLIDE_MS + i * 1400);
    altarEl.querySelector('[data-slideshow]')?.addEventListener('click', () => advanceSlide(altarEl));
  });

  // ── State ─────────────────────────────────────────────────
  function fmtCount(n: number) { return n > 9999 ? (n / 1000).toFixed(1) + 'k' : String(n); }

  function paintAltars(state: any) {
    document.querySelectorAll('.pe__altar').forEach((el) => {
      const station = (el as HTMLElement).dataset.station ?? '';
      const count = state.counts?.[station] ?? 0;
      const num = el.querySelector('[data-count-text]');
      if (num) num.textContent = fmtCount(count);
      (el as HTMLElement).dataset.count = String(count);
    });
  }

  function paintFeed(state: any) {
    const list = document.getElementById('pe-feed');
    if (!list) return;
    const recent = state.recent ?? [];
    if (!recent.length) {
      list.innerHTML = '<li class="pe__feed-empty">— waiting for the first prayer —</li>';
      return;
    }
    list.innerHTML = '';
    const now = Date.now();
    recent.forEach((r: any, idx: number) => {
      const li = document.createElement('li');
      const isFresh = (now - r.t) < 8000 && idx === 0;
      if (isFresh) li.classList.add('pe__feed-fresh');
      const ago = Math.max(0, Math.floor((now - r.t) / 1000));
      const agoStr = ago < 5 ? 'just now' : ago < 60 ? `${ago}s ago` : ago < 3600 ? `${Math.floor(ago/60)}m ago` : `${Math.floor(ago/3600)}h ago`;
      const dot = document.createElement('span');
      dot.className = 'pe__feed-dot';
      dot.style.background = STATION_ACCENTS[r.station] ?? '#d4a437';
      dot.style.color = STATION_ACCENTS[r.station] ?? '#d4a437';
      const txt = document.createElement('span');
      txt.textContent = `${String(r.station).toUpperCase()} · ${r.pid.slice(0, 6)}… · ${agoStr}`;
      li.appendChild(dot); li.appendChild(txt);
      list.appendChild(li);
    });
  }

  function paintHeader(state: any) {
    const totEl = document.getElementById('pe-total');
    if (totEl) totEl.textContent = fmtCount(state.total ?? 0);
  }

  // ── Network ───────────────────────────────────────────────
  async function fetchState() {
    try {
      const r = await fetch('/api/prayer', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) {
        paintHeader(j); paintAltars(j); paintFeed(j);
      }
    } catch {
      /* offline — keep current state */
    }
  }

  async function postPrayer(station: string) {
    try {
      const r = await fetch('/api/prayer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: SID, station }),
      });
      return await r.json();
    } catch {
      return { ok: false, reason: 'network' };
    }
  }

  // ── Wire up prayers ───────────────────────────────────────
  function lightAltar(altarEl: Element) {
    altarEl.classList.add('pe__altar--lit');
    setTimeout(() => altarEl.classList.remove('pe__altar--lit'), 900);
  }

  document.querySelectorAll('.pe__altar').forEach((altarEl) => {
    const btn = altarEl.querySelector('[data-pray]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const station = (altarEl as HTMLElement).dataset.station ?? 'vigil';
      try { TONES[station]?.(); } catch {}
      lightAltar(altarEl);
      advanceSlide(altarEl);
      btn.classList.add('pe__pray--praying');
      btn.disabled = true;
      const j = await postPrayer(station);
      btn.disabled = false;
      btn.classList.remove('pe__pray--praying');
      if (j?.ok) {
        const num = altarEl.querySelector('[data-count-text]');
        if (num) num.textContent = fmtCount(j.count);
        (altarEl as HTMLElement).dataset.count = String(j.count);
        const totEl = document.getElementById('pe-total');
        if (totEl) totEl.textContent = fmtCount(j.total);
      } else if (j?.reason === 'rate-limited') {
        btn.disabled = true;
        setTimeout(() => { btn.disabled = false; }, (j.retryAfterSec ?? 5) * 1000);
      }
    });
  });

  // ── Polling ───────────────────────────────────────────────
  fetchState();
  setInterval(fetchState, 2200);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) fetchState();
  });
</script>
