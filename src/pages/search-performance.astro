---
import BlockLayout from '../layouts/BlockLayout.astro';
import snapshot from '../data/search-performance.json';
import { rankPages } from '../lib/search-performance.mjs';

const title = 'Search performance';
const description = 'What brings people to PointCast: a dated Google Search milestone, observed search results, and page rankings when measured data is available.';
const pages = rankPages(snapshot);
const period = snapshot.period as { start: string; end: string } | null;
const observed = [...snapshot.observedPages].sort((a, b) => a.title.localeCompare(b.title));
const shortDate = (date: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T12:00:00Z`));
const sourceUrl = 'https://search.google.com/search-console';
---

<BlockLayout title={title} description={description} showNetworkStrip={false} hideAds={true}
  alternates={[{ type: 'application/json', href: '/search-performance.json', title: 'Search performance data' }]}>
  <div class="sp">
    <nav class="sp-crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span aria-hidden="true">/</span><span>Search performance</span></nav>
    <header class="sp-header">
      <p class="sp-kicker">Discovery desk · Updated {shortDate(snapshot.updatedAt)}</p>
      <h1>How people find<br /><em>PointCast.</em></h1>
      <p class="sp-dek">Search is another front door. Here is what we can measure, what we have seen, and what is still waiting for data.</p>
      <nav class="sp-links" aria-label="Search tools"><a href="/search">Search the town ↗</a><a href="/discovery">Technical discovery audit ↗</a><a href="/search-performance.json">Public data ↗</a></nav>
    </header>

    <section class="sp-overview" aria-label="Search evidence summary">
      <article class="sp-milestone"><p class="sp-kicker">A first search milestone</p><strong>{snapshot.milestone.value}<span>clicks</span></strong><h2>People are finding a way in.</h2><p>Google reported a five-click milestone for the preceding {snapshot.milestone.windowDays} days on <time datetime={snapshot.milestone.reachedOn}>{shortDate(snapshot.milestone.reachedOn)}</time>.</p><small>{snapshot.milestone.source}. A historical milestone; the current total may differ.</small></article>
      <article class="sp-status"><p class="sp-kicker">Page-level performance</p><strong>{pages.length ? pages.length : '—'}<span>{pages.length ? 'measured pages' : 'Awaiting data'}</span></strong><h2>Which pages rank highest?</h2><p>{pages.length ? 'These pages have measured clicks, impressions, and average position for the stated period.' : 'We cannot name the highest-ranking pages yet. The available milestone does not identify individual pages, search terms, or average positions.'}</p><small>Clicks, impressions, and position need the same reporting period and filters before they can be compared.</small></article>
    </section>

    <section class="sp-section" aria-labelledby="sp-ranking-title">
      <div class="sp-section-head"><div><p class="sp-kicker">01 / Measured performance</p><h2 id="sp-ranking-title">Top pages from Google Search</h2></div><span class="sp-badge">{pages.length ? 'Measured snapshot' : 'No ranking data loaded'}</span></div>
      {pages.length ? <>
        <p>Sorted by search clicks. Average position summarizes positions across impressions; it is not a permanent rank. Period: {period?.start}–{period?.end} · Country: {snapshot.scope.country} · Device: {snapshot.scope.device}.</p>
        <div class="sp-table-wrap"><table><thead><tr><th scope="col">Page</th><th scope="col">Clicks</th><th scope="col">Impressions</th><th scope="col">Avg. position</th></tr></thead><tbody>{pages.map(row => <tr><th scope="row"><a href={row.url}>{row.title}</a></th><td>{row.clicks.toLocaleString('en-US')}</td><td>{row.impressions.toLocaleString('en-US')}</td><td>{row.position.toFixed(1)}</td></tr>)}</tbody></table></div>
      </> : <div class="sp-empty"><span aria-hidden="true">↗</span><div><h3>A place for the real leaders.</h3><p>A Google Search Console Pages export will populate this table with clicks, impressions, and average position. Missing values stay unmeasured rather than becoming zero.</p></div><a href={sourceUrl}>Open Search Console ↗<small>Property access required</small></a></div>}
      <p class="sp-note">Clicks measure visits from search results; impressions measure appearances. Average position summarizes where a page appeared. <a href="https://support.google.com/webmasters/answer/7042828?hl=en">Google’s metric definitions ↗</a></p>
    </section>

    <section class="sp-section" aria-labelledby="sp-observed-title">
      <div class="sp-section-head"><div><p class="sp-kicker">02 / Seen in public search</p><h2 id="sp-observed-title">A few visible doors.</h2></div><span class="sp-badge">Observed {shortDate(snapshot.observation.observedOn)}</span></div>
      <p class="sp-note">These pages appeared in one public search for <code>{snapshot.observation.query}</code> with a 30-day recency filter. Alphabetical order. This sample does not establish Google rank, traffic, or complete index coverage.</p>
      <ul class="sp-pages">{observed.map(page => <li><a href={page.url}><span class="sp-page-copy"><strong>{page.title}</strong><small>{page.topic}</small></span><span aria-hidden="true">↗</span></a></li>)}</ul>
    </section>

    <section class="sp-section sp-next" aria-labelledby="sp-next-title">
      <div><p class="sp-kicker">03 / Where we go next</p><h2 id="sp-next-title">Turn discovery into direction.</h2></div>
      <ol><li><strong>Measure the same window.</strong><p>Export the last 28 complete days from Search Console, including Pages and Queries, with clicks, impressions, and average position.</p></li><li><strong>Give useful pages a clear route home.</strong><p>Connect the pages people find to related projects, local reports, and things they can try. The homepage search is the next step.</p></li><li><strong>Fix access before adding more noise.</strong><p>Use the technical audit for broken paths, canonical URLs, and structured data. Search Console can identify the affected URLs.</p></li></ol>
      <a class="sp-return" href="/#pointcast-now">Back to PointCast now ↗</a>
    </section>
  </div>
</BlockLayout>

<style>
  .sp { --ink:#172337; --blue:#185fa5; --muted:#536377; --line:#c8cdd1; max-width:1120px; margin:auto; padding:24px 20px 100px; color:var(--ink); }
  .sp a { color:inherit; text-underline-offset:4px; }.sp a:focus-visible { outline:3px solid #c46c17; outline-offset:4px; }
  .sp-crumb { display:flex; gap:10px; font:400 11px/1.5 var(--pc-font-mono); margin-bottom:36px; }
  .sp-header { padding-bottom:28px; border-bottom:2px solid var(--ink); }
  .sp-kicker { margin:0 0 12px; color:var(--muted); text-transform:uppercase; letter-spacing:.1em; font:500 10px/1.6 var(--pc-font-mono); }
  .sp h1 { margin:0; font-size:clamp(38px,7vw,76px); line-height:1.02; font-weight:500; letter-spacing:-.06em; }.sp h1 em { color:var(--blue); font-style:normal; }
  .sp-dek { max-width:580px; margin:22px 0; font-size:17px; line-height:1.65; }
  .sp-links { display:flex; flex-wrap:wrap; gap:12px 26px; font-size:12px; }.sp-links a { min-height:30px; }
  .sp-overview { display:grid; grid-template-columns:1fr 1fr; border:1px solid var(--line); border-top:0; }
  .sp-overview article { padding:24px; }.sp-milestone { background:#eaf0f5; border-right:1px solid var(--line); }.sp-status { background:#fffdf7; }
  .sp-overview strong { display:flex; flex-wrap:wrap; align-items:baseline; gap:12px; font:500 54px/1.2 var(--pc-font-mono); letter-spacing:-.05em; }.sp-overview strong span { font:400 14px var(--pc-font-sans); letter-spacing:0; }
  .sp-overview h2 { margin:20px 0 9px; font-size:21px; font-weight:500; letter-spacing:-.03em; }.sp-overview p:not(.sp-kicker) { font-size:14px; line-height:1.65; margin:0 0 12px; }.sp-overview small { display:block; color:var(--muted); font-size:11px; line-height:1.6; }
  .sp-section { padding:34px 0; border-bottom:1px solid var(--line); }.sp-section-head { display:flex; justify-content:space-between; align-items:end; gap:12px; margin-bottom:18px; }.sp h2 { margin:0; font-weight:500; font-size:clamp(24px,3vw,32px); letter-spacing:-.04em; }.sp-badge { display:inline-block; padding:6px 9px; border:1px solid var(--line); font:400 10px/1.5 var(--pc-font-mono); }
  .sp-empty { display:flex; align-items:center; gap:24px; padding:26px; background:#fffdf7; border:1px dashed #9ba7b3; }.sp-empty>span { color:var(--blue); font-size:42px; }.sp-empty h3 { font-weight:500; margin:0 0 8px; font-size:18px; }.sp-empty p { margin:0; max-width:580px; font-size:14px; line-height:1.65; color:var(--muted); }.sp-empty>a { flex-shrink:0; font-size:12px; }.sp-empty>a small { display:block; margin-top:6px; font-size:10px; color:var(--muted); text-decoration:none; }
  .sp-note { max-width:820px; font-size:13px; line-height:1.65; color:var(--muted); }.sp-note code { font-family:var(--pc-font-mono); font-size:11px; }
  .sp-pages { display:grid; grid-template-columns:1fr 1fr; margin:20px 0 0; padding:0; list-style:none; border-top:1px solid var(--line); border-left:1px solid var(--line); }.sp-pages li { min-width:0; }.sp-pages a { display:flex; justify-content:space-between; align-items:center; gap:14px; height:100%; padding:19px; border-bottom:1px solid var(--line); border-right:1px solid var(--line); text-decoration:none; }.sp-pages a:hover { background:#edf3fa; }.sp-pages strong { display:block; font-size:15px; font-weight:500; }.sp-pages small { display:block; margin-top:7px; color:var(--muted); font-size:12px; line-height:1.5; }
  .sp-next ol { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; padding:0; margin:26px 0; list-style-position:inside; }.sp-next li { font-size:14px; }.sp-next strong { font-weight:500; }.sp-next p { font-size:13px; line-height:1.7; color:var(--muted); }.sp-return { display:inline-block; background:var(--ink); padding:13px 18px; color:white!important; font-size:12px; text-decoration:none; }
  .sp-table-wrap { overflow:auto; }.sp table { width:100%; border-collapse:collapse; font-size:13px; }.sp td,.sp th { padding:14px; border-bottom:1px solid var(--line); text-align:right; }.sp th:first-child { text-align:left; }.sp thead { background:#eaf0f5; }
  @media(max-width:700px) { .sp { padding:20px 16px 90px; }.sp-overview { grid-template-columns:1fr; }.sp-milestone { border-right:0; border-bottom:1px solid var(--line); }.sp-section-head { align-items:start; flex-direction:column; }.sp-empty { flex-wrap:wrap; gap:12px; padding:20px; }.sp-empty>span { display:none; }.sp-pages { grid-template-columns:1fr; }.sp-next ol { grid-template-columns:1fr; gap:10px; }.sp-overview article { padding:22px; }.sp-crumb { margin-bottom:24px; } }
</style>
