---
import BlockLayout from '../layouts/BlockLayout.astro';
import MicroAppShell from '../components/MicroAppShell.astro';
import {
  LIVE_FEED_NFT_LANES,
  LIVE_FEED_NFT_RULES,
  buildLiveFeedMetadata,
} from '../data/live-feed-nfts';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('live-feed-nfts')!;
const title = app.name;
const description = app.description;
const images = LIVE_FEED_NFT_LANES.map((lane) => ({
  src: lane.imageUrl,
  alt: `${lane.title} source artwork`,
}));

const firstLane = LIVE_FEED_NFT_LANES[0];
const firstMetadata = buildLiveFeedMetadata(firstLane);
const lanesJson = JSON.stringify(LIVE_FEED_NFT_LANES);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/live-feed-nfts',
  name: title,
  description,
  url: app.url,
  applicationCategory: 'DesignApplication',
};
---

<BlockLayout
  title={title}
  description={description}
  image="/images/morning-ocean/series-contact-sheet.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/live-feed-nfts.json', title: 'Live Feed NFTs (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/morning-ocean/series-contact-sheet.png',
    buttons: [
      { label: 'Open Desk', action: 'link', target: 'https://pointcast.xyz/live-feed-nfts' },
      { label: 'JSON', action: 'link', target: 'https://pointcast.xyz/live-feed-nfts.json' },
    ],
  }}
>
  <MicroAppShell
    app={app}
    headline="Live Feed NFTs"
    dek="A mint-prep desk for data-driven PointCast cards: weather, sea state, competition, and composite feed packets."
    images={images}
    stats={[
      { label: 'Lanes', value: LIVE_FEED_NFT_LANES.length },
      { label: 'Modes', value: 'single + multi' },
      { label: 'Status', value: 'preview' },
      { label: 'Chain', value: 'Tezos-ready' },
    ]}
    links={[
      { href: '/live-feed-nfts.json', label: 'JSON' },
      { href: '/editions', label: 'Editions' },
      { href: '/mint-studio', label: 'Studio' },
    ]}
  >
    <section class="app-section live-feed" data-live-feed-nfts>
      <div class="feed-workbench">
        <aside class="tool-panel feed-controls">
          <p class="mono-note">Feed lanes</p>
          <div class="lane-buttons" role="tablist" aria-label="Live feed NFT lanes">
            {LIVE_FEED_NFT_LANES.map((lane, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-lane-button={lane.id}
                style={`--lane-accent: ${lane.accent};`}
              >
                {lane.shortLabel}
              </button>
            ))}
          </div>

          <label>
            Edition Mode
            <select data-edition-mode>
              <option value="single-data">Single Data NFT</option>
              <option value="multi-data">Multi Data NFT</option>
            </select>
          </label>

          <label>
            Rarity Pressure
            <input data-rarity-pressure type="range" min="0" max="100" value="42" />
          </label>

          <div class="button-row">
            <button type="button" data-refresh-feeds>Refresh feeds</button>
            <button type="button" data-save-snapshot>Save snapshot</button>
          </div>

          <dl class="status-list">
            <div>
              <dt>Weather</dt>
              <dd data-weather-status>pending</dd>
            </div>
            <div>
              <dt>Sea</dt>
              <dd data-sea-status>pending</dd>
            </div>
            <div>
              <dt>Competition</dt>
              <dd data-competition-status>pending</dd>
            </div>
          </dl>
        </aside>

        <section class="preview-stage" aria-label="Live feed NFT preview">
          <article class="nft-card" data-nft-card data-lane={firstLane.id} style={`--active-accent: ${firstLane.accent}; --rarity: 42%;`}>
            <div class="nft-card__media">
              <img data-card-image src={firstLane.imageUrl} alt="" width="1024" height="1024" loading="eager" decoding="async" />
              <div class="signal-lines" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>
            </div>
            <div class="nft-card__body">
              <p class="mono-note" data-card-kicker>{firstLane.source}</p>
              <h2 data-card-title>{firstLane.title}</h2>
              <p data-card-hook>{firstLane.nftHook}</p>
              <dl class="trait-grid" data-trait-grid>
                <div><dt>Status</dt><dd>{firstLane.status}</dd></div>
                <div><dt>Cadence</dt><dd>{firstLane.cadence}</dd></div>
                <div><dt>Mode</dt><dd>{firstLane.tokenMode}</dd></div>
                <div><dt>Updated</dt><dd>pending</dd></div>
              </dl>
            </div>
          </article>
        </section>
      </div>

      <div class="lower-grid">
        <section class="tool-panel">
          <h2>Competition</h2>
          <div class="rank-board" data-rank-board>
            <article>
              <span>leader</span>
              <strong>weather</strong>
              <i><b style="width: 52%;"></b></i>
            </article>
            <article>
              <span>challenger</span>
              <strong>sea</strong>
              <i><b style="width: 34%;"></b></i>
            </article>
            <article>
              <span>spread</span>
              <strong>18</strong>
              <i><b style="width: 18%;"></b></i>
            </article>
          </div>
        </section>

        <section class="tool-panel tool-panel--ink">
          <h2>Metadata</h2>
          <pre data-metadata-json>{JSON.stringify(firstMetadata, null, 2)}</pre>
        </section>
      </div>

      <section class="lane-table" aria-label="Live feed NFT adapter map">
        {LIVE_FEED_NFT_LANES.map((lane) => (
          <article id={lane.id} style={`--lane-accent: ${lane.accent};`}>
            <img src={lane.imageUrl} alt="" width="1024" height="1024" loading="lazy" decoding="async" />
            <div>
              <p class="mono-note">{lane.status} / {lane.tokenMode}</p>
              <h2>{lane.title}</h2>
              <p>{lane.nftHook}</p>
              <ul>
                {lane.fields.map((field) => <li>{field}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <section class="rules-strip" aria-label="Mint rules">
        {LIVE_FEED_NFT_RULES.map((rule) => (
          <article>
            <span>{rule.label}</span>
            <p>{rule.value}</p>
          </article>
        ))}
      </section>

      <script is:inline type="application/json" id="live-feed-lanes" set:html={lanesJson} />
    </section>
  </MicroAppShell>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-live-feed-nfts]');
    if (!root) return;

    const lanes = JSON.parse(document.getElementById('live-feed-lanes')?.textContent || '[]');
    const byId = Object.fromEntries(lanes.map((lane) => [lane.id, lane]));
    const storageKey = 'pc:live-feed-nfts:snapshots';
    let activeId = lanes[0]?.id || 'weather';
    const state = {
      weather: null,
      sea: null,
      wire: null,
      competition: null,
      updatedAt: null,
    };

    const weatherCode = {
      0: 'clear',
      1: 'mostly clear',
      2: 'partly cloudy',
      3: 'overcast',
      45: 'fog',
      48: 'fog',
      51: 'drizzle',
      53: 'drizzle',
      55: 'drizzle',
      61: 'rain',
      63: 'rain',
      65: 'rain',
      80: 'showers',
      81: 'showers',
      82: 'showers',
      95: 'storm',
    };

    const q = (selector) => root.querySelector(selector);
    const qa = (selector) => Array.from(root.querySelectorAll(selector));
    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const round = (value, places = 1) => {
      const n = Number(value);
      if (!Number.isFinite(n)) return '--';
      return n.toFixed(places).replace(/\.0$/, '');
    };
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));

    const hashString = (input) => {
      let h = 2166136261;
      for (let i = 0; i < input.length; i += 1) {
        h ^= input.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return (h >>> 0).toString(16).padStart(8, '0');
    };

    const fetchJson = async (url) => {
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`${res.status}`);
      return res.json();
    };

    async function fetchWeather() {
      try {
        const data = await fetchJson('/api/weather?lat=33.9192&lng=-118.4165&label=El%20Segundo');
        return {
          ok: true,
          source: 'pointcast-weather',
          name: data.name || 'El Segundo',
          tempF: data.tempF,
          condition: data.condition,
          sunset: data.sunset,
          updatedAt: data.updatedAt,
        };
      } catch {
        const direct = await fetchJson('https://api.open-meteo.com/v1/forecast?latitude=33.92&longitude=-118.42&current=temperature_2m,weather_code&daily=sunset&temperature_unit=fahrenheit&timezone=America%2FLos_Angeles&forecast_days=1');
        return {
          ok: true,
          source: 'open-meteo',
          name: 'El Segundo',
          tempF: Math.round(direct?.current?.temperature_2m ?? 0),
          condition: weatherCode[direct?.current?.weather_code] || 'unknown',
          sunset: direct?.daily?.sunset?.[0] || null,
          updatedAt: direct?.current?.time || new Date().toISOString(),
        };
      }
    }

    async function fetchSea() {
      const data = await fetchJson('https://marine-api.open-meteo.com/v1/marine?latitude=33.92&longitude=-118.42&current=wave_height,swell_wave_height,wave_period,wave_direction&timezone=America%2FLos_Angeles');
      const current = data.current || {};
      return {
        ok: true,
        source: 'open-meteo-marine',
        waveHeight: current.wave_height,
        swellHeight: current.swell_wave_height,
        wavePeriod: current.wave_period,
        waveDirection: current.wave_direction,
        updatedAt: current.time || new Date().toISOString(),
      };
    }

    async function fetchWire() {
      try {
        const data = await fetchJson('/api/wire-events?limit=8');
        return {
          ok: true,
          source: 'wire-events',
          events: Array.isArray(data.events) ? data.events : [],
          updatedAt: data.source?.generatedAt || new Date().toISOString(),
        };
      } catch {
        const snap = await fetchJson('/wire.json');
        return {
          ok: true,
          source: 'wire-json',
          events: Array.isArray(snap.events) ? snap.events.slice(0, 8) : [],
          updatedAt: snap.generatedAt || new Date().toISOString(),
        };
      }
    }

    function computeCompetition() {
      const temp = Number(state.weather?.tempF || 0);
      const wave = Number(state.sea?.waveHeight || 0);
      const events = state.wire?.events?.length || 0;
      const scores = [
        { id: 'weather', label: 'Weather', score: clamp(Math.round((temp - 45) * 1.7), 10, 98) },
        { id: 'sea', label: 'Sea', score: clamp(Math.round(wave * 24 + Number(state.sea?.swellHeight || 0) * 18), 8, 96) },
        { id: 'wire', label: 'Wire', score: clamp(events * 11 + 14, 12, 94) },
      ].sort((a, b) => b.score - a.score);
      return {
        leader: scores[0],
        challenger: scores[1],
        spread: Math.max(0, scores[0].score - scores[1].score),
        scores,
        eventCount: events,
      };
    }

    function feedValues(lane) {
      const updated = state.updatedAt ? new Date(state.updatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'pending';
      if (lane.id === 'weather') {
        return [
          ['Temp', `${round(state.weather?.tempF, 0)} F`],
          ['Condition', state.weather?.condition || 'pending'],
          ['Sunset', state.weather?.sunset ? new Date(state.weather.sunset).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '--'],
          ['Updated', updated],
        ];
      }
      if (lane.id === 'sea') {
        return [
          ['Wave', `${round(state.sea?.waveHeight)} m`],
          ['Swell', `${round(state.sea?.swellHeight)} m`],
          ['Period', `${round(state.sea?.wavePeriod)} s`],
          ['Direction', `${round(state.sea?.waveDirection, 0)} deg`],
        ];
      }
      if (lane.id === 'competition') {
        return [
          ['Leader', state.competition?.leader?.label || 'pending'],
          ['Challenger', state.competition?.challenger?.label || 'pending'],
          ['Spread', state.competition?.spread ?? '--'],
          ['Events', state.competition?.eventCount ?? '--'],
        ];
      }
      const packet = snapshotPacket();
      return [
        ['Weather', `${round(packet.weather.tempF, 0)} F`],
        ['Sea', `${round(packet.sea.waveHeight)} m`],
        ['Leader', packet.competition.leader || 'pending'],
        ['Hash', packet.editionHash],
      ];
    }

    function snapshotPacket() {
      const packet = {
        weather: {
          tempF: state.weather?.tempF ?? null,
          condition: state.weather?.condition ?? null,
        },
        sea: {
          waveHeight: state.sea?.waveHeight ?? null,
          swellHeight: state.sea?.swellHeight ?? null,
        },
        competition: {
          leader: state.competition?.leader?.label ?? null,
          spread: state.competition?.spread ?? null,
        },
        capturedAt: state.updatedAt || new Date().toISOString(),
      };
      return {
        ...packet,
        editionHash: hashString(JSON.stringify(packet)).slice(0, 10),
      };
    }

    function metadataFor(lane) {
      const mode = q('[data-edition-mode]')?.value || lane.tokenMode;
      const pressure = Number(q('[data-rarity-pressure]')?.value || 42);
      return {
        name: `PointCast Live Feed NFT - ${lane.shortLabel}`,
        symbol: 'PCLIVE',
        decimals: 0,
        description: `${lane.title}. ${lane.nftHook}`,
        displayUri: `https://pointcast.xyz${lane.imageUrl}`,
        artifactUri: `https://pointcast.xyz${lane.imageUrl}`,
        externalUri: `https://pointcast.xyz/live-feed-nfts#${lane.id}`,
        tags: ['pointcast', 'live-feed', 'nft', 'tezos', lane.id, mode],
        attributes: [
          { name: 'Feed Lane', value: lane.shortLabel },
          { name: 'Source', value: lane.source },
          { name: 'Cadence', value: lane.cadence },
          { name: 'Token Mode', value: mode },
          { name: 'Rarity Pressure', value: String(pressure) },
          { name: 'Edition Hash', value: snapshotPacket().editionHash },
        ],
        snapshot: lane.id === 'multi' || mode === 'multi-data' ? snapshotPacket() : Object.fromEntries(feedValues(lane)),
        previewOnly: true,
      };
    }

    function paintRankBoard() {
      const board = q('[data-rank-board]');
      if (!board) return;
      const ranks = state.competition?.scores || [];
      board.innerHTML = ranks.map((rank, index) => `
        <article>
          <span>${index === 0 ? 'leader' : index === 1 ? 'challenger' : 'third'}</span>
          <strong>${esc(rank.label)}</strong>
          <i><b style="width: ${clamp(rank.score, 3, 100)}%;"></b></i>
        </article>
      `).join('');
    }

    function paint() {
      const lane = byId[activeId] || lanes[0];
      const pressure = Number(q('[data-rarity-pressure]')?.value || 42);
      const mode = q('[data-edition-mode]')?.value || lane.tokenMode;
      const values = feedValues(mode === 'multi-data' ? byId.multi : lane);
      const card = q('[data-nft-card]');
      if (card) {
        card.dataset.lane = mode === 'multi-data' ? 'multi' : lane.id;
        card.style.setProperty('--active-accent', lane.accent);
        card.style.setProperty('--rarity', `${pressure}%`);
      }
      q('[data-card-image]')?.setAttribute('src', mode === 'multi-data' ? byId.multi.imageUrl : lane.imageUrl);
      q('[data-card-title]').textContent = mode === 'multi-data' ? byId.multi.title : lane.title;
      q('[data-card-kicker]').textContent = `${lane.source} | ${lane.cadence}`;
      q('[data-card-hook]').textContent = lane.nftHook;
      q('[data-trait-grid]').innerHTML = values.map(([label, value]) => `
        <div><dt>${esc(label)}</dt><dd>${esc(value)}</dd></div>
      `).join('');
      q('[data-metadata-json]').textContent = JSON.stringify(metadataFor(mode === 'multi-data' ? byId.multi : lane), null, 2);
      qa('[data-lane-button]').forEach((button) => {
        const selected = button.getAttribute('data-lane-button') === activeId;
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
        button.classList.toggle('is-active', selected);
      });
      paintRankBoard();
    }

    function setStatus(key, value) {
      const el = q(`[data-${key}-status]`);
      if (el) el.textContent = value;
    }

    async function refreshFeeds() {
      setStatus('weather', 'loading');
      setStatus('sea', 'loading');
      setStatus('competition', 'loading');
      const [weather, sea, wire] = await Promise.allSettled([fetchWeather(), fetchSea(), fetchWire()]);
      if (weather.status === 'fulfilled') {
        state.weather = weather.value;
        setStatus('weather', `${weather.value.source}`);
      } else {
        state.weather = { tempF: null, condition: 'offline', updatedAt: new Date().toISOString() };
        setStatus('weather', 'offline');
      }
      if (sea.status === 'fulfilled') {
        state.sea = sea.value;
        setStatus('sea', `${sea.value.source}`);
      } else {
        state.sea = { waveHeight: null, swellHeight: null, wavePeriod: null, waveDirection: null, updatedAt: new Date().toISOString() };
        setStatus('sea', 'offline');
      }
      if (wire.status === 'fulfilled') {
        state.wire = wire.value;
        setStatus('competition', `${wire.value.source}`);
      } else {
        state.wire = { events: [], updatedAt: new Date().toISOString() };
        setStatus('competition', 'fallback');
      }
      state.updatedAt = new Date().toISOString();
      state.competition = computeCompetition();
      paint();
    }

    qa('[data-lane-button]').forEach((button) => {
      button.addEventListener('click', () => {
        activeId = button.getAttribute('data-lane-button') || activeId;
        const lane = byId[activeId] || lanes[0];
        const mode = q('[data-edition-mode]');
        if (mode && lane.tokenMode === 'single-data') mode.value = 'single-data';
        paint();
      });
    });
    q('[data-edition-mode]')?.addEventListener('change', paint);
    q('[data-rarity-pressure]')?.addEventListener('input', paint);
    q('[data-refresh-feeds]')?.addEventListener('click', refreshFeeds);
    q('[data-save-snapshot]')?.addEventListener('click', () => {
      const lane = byId[activeId] || lanes[0];
      const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
      saved.push({
        id: `live-feed-${Date.now()}`,
        lane: lane.id,
        metadata: metadataFor(lane),
        savedAt: new Date().toISOString(),
      });
      localStorage.setItem(storageKey, JSON.stringify(saved.slice(-24)));
      q('[data-save-snapshot]').textContent = 'Saved';
      setTimeout(() => { q('[data-save-snapshot]').textContent = 'Save snapshot'; }, 1000);
    });

    paint();
    refreshFeeds().catch(() => paint());
  })();
</script>

<style>
  .feed-workbench,
  .lower-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.42fr) minmax(0, 1fr);
    gap: 12px;
  }
  .feed-controls {
    display: grid;
    align-content: start;
    gap: 14px;
  }
  .lane-buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .lane-buttons button {
    border-color: color-mix(in srgb, var(--lane-accent) 70%, #12110e);
  }
  .lane-buttons button.is-active,
  .lane-buttons button[aria-selected="true"] {
    background: var(--lane-accent);
    color: #fff;
  }
  .status-list {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  .status-list div,
  .trait-grid div {
    min-width: 0;
    border: 1px solid rgba(18, 17, 14, 0.12);
    background: rgba(255, 255, 255, 0.72);
    padding: 9px;
  }
  .status-list dt,
  .trait-grid dt,
  .rank-board span,
  .rules-strip span {
    display: block;
    margin-bottom: 5px;
    color: var(--pc-ink-muted);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .status-list dd,
  .trait-grid dd {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--pc-ink);
    font-size: 14px;
  }
  .preview-stage {
    min-width: 0;
    border: 1px solid var(--pc-rule-soft);
    background: #f6f4ee;
    padding: 12px;
  }
  .nft-card {
    min-height: 560px;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
    overflow: hidden;
    border: 1.5px solid #12110e;
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--active-accent) 18%, #fff) 0%, transparent var(--rarity)),
      #fff;
    box-shadow: 6px 6px 0 #12110e;
  }
  .nft-card__media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background: #0f1518;
  }
  .nft-card__media img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05);
  }
  .nft-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 0 58%, rgba(0, 0, 0, 0.34)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 24px);
    mix-blend-mode: screen;
    opacity: 0.58;
  }
  .nft-card[data-lane="weather"] .nft-card__media::after {
    background:
      radial-gradient(circle at 78% 20%, rgba(255, 228, 150, 0.82), transparent 18%),
      linear-gradient(180deg, rgba(79, 147, 184, 0.16), rgba(255,255,255,0.02) 48%, rgba(11, 48, 71, 0.38));
  }
  .nft-card[data-lane="sea"] .nft-card__media::after {
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.18) 0 2px, transparent 2px 28px),
      linear-gradient(180deg, transparent, rgba(22, 75, 79, 0.5));
  }
  .nft-card[data-lane="competition"] .nft-card__media::after {
    background:
      linear-gradient(135deg, rgba(163, 69, 53, 0.42), transparent 52%),
      repeating-linear-gradient(45deg, rgba(255,255,255,0.18) 0 2px, transparent 2px 18px);
  }
  .nft-card[data-lane="multi"] .nft-card__media::after {
    background:
      radial-gradient(circle at 24% 32%, rgba(49, 127, 115, 0.44), transparent 22%),
      radial-gradient(circle at 74% 28%, rgba(163, 69, 53, 0.32), transparent 24%),
      linear-gradient(135deg, rgba(123, 90, 158, 0.36), rgba(27, 111, 168, 0.22));
  }
  .signal-lines {
    position: absolute;
