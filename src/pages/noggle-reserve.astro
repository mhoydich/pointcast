---
import BlockLayout from '../layouts/BlockLayout.astro';
import { RESERVE, NOTE_STUDIES } from '../lib/noggle-reserve';
import '../styles/noggle-reserve.css';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'Noggle Reserve — an art-club concept',
  url: RESERVE.canonical, description: RESERVE.disclosure, datePublished: RESERVE.publishedAt,
  creator: {'@type': 'Person', name: 'Mike Hoydich'}, author: {'@type': 'Organization', name: 'Codex'},
  isAccessibleForFree: true, genre: 'Fictional art/community concept',
};
const wear = [
  { file: 'printer-pickup', label: 'Pick up from the printer', caption: 'Fresh stack · imagined printer pickup' },
  { file: 'lightly-circulated', label: 'A little weathered', caption: 'Soft folds, softened edges · imagined circulation' },
  { file: 'well-travelled', label: 'Well travelled', caption: 'A pocket full of stories · imagined circulation' },
];
---
<BlockLayout title="Noggle Reserve · an art-club concept" description="In Noggles We Trust. A 1970s Nouns Bank art-club concept for El Segundo: actual Nouns, collectible notes, a proposed exchange and a lean build scope." image="/images/og/noggle-reserve.png" themeColor="#f3e8cc" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{type:'application/json', href:'/noggle-reserve.json', title:'Noggle Reserve · machine edition'}]}>
  <main class="nr" id="main-content"><div id="top"></div>
    <div class="nr-top"><a href="/">POINTCAST ↗</a><span>CH.ESC · EL SEGUNDO</span><a href="/noggle-reserve.json">MACHINE EDITION</a></div>
    <header class="nr-hero">
      <div class="nr-hero-copy">
        <p class="nr-kicker">AN ART-CLUB CONCEPT · FILED 02 OCT 2026</p>
        <h1>Noggle<br/><span>Reserve.</span></h1>
        <p class="nr-motto">In Noggles We Trust.</p>
        <p class="nr-dek">A little branch for big imaginations. Nouns on paper. Stories in circulation. A place to trade something you made.</p>
        <nav aria-label="Inside the concept"><a class="nr-button" href="#notes">Meet the notes ↓</a><a href="#build">Read the build scope ↗</a></nav>
        <p class="nr-disclosure">Fictional art/community concept. Collectible notes, never cash. No banking, deposits, cash redemption or acquisition.</p>
      </div>
      <figure class="nr-hero-art"><img src="/images/noggle-reserve/branch.webp" width="1536" height="1024" alt="Illustrative 1970s Noggle Reserve art-club storefront, not an existing or acquired location" fetchpriority="high"/><figcaption>EL SEGUNDO BRANCH · IMAGINED, NOT OPEN</figcaption></figure>
    </header>
    <div class="nr-ribbon"><span>ONE NOUN, EVERY DAY, FOREVER</span><span aria-hidden="true">⌐◨-◨</span><span>ART &amp; TRADE · NOT LEGAL TENDER</span></div>
    <section class="nr-section nr-intro" aria-labelledby="intro-title">
      <div><p class="nr-kicker">THE IDEA · NO. 001</p><h2 id="intro-title">Put the art<br/>in circulation.</h2></div>
      <div><p class="nr-lead">Borrow the warmth of a 1970s neighborhood branch: walnut counters, brass signs, paper receipts. Fill it with public-domain Nouns and people making things together.</p><p>“Nouns Bank” is the playful exhibition idea. Noggle Reserve is its fictional art-club identity. The notes are collectible paper artworks. The numbers belong to the design; they do not promise money, goods, services or NFT ownership.</p><div class="nr-status"><strong>Built today</strong><p>The digital exhibit, ten note studies and a read-only machine edition.</p><strong>Still an idea</strong><p>A physical branch, art-note exchange, public journey ledger and Tezos companion artworks.</p></div></div>
    </section>
    <section class="nr-section nr-notes" id="notes" aria-labelledby="notes-title">
      <div class="nr-heading"><div><p class="nr-kicker">THE PAPER ROOM · ACTUAL NOUNS ART</p><h2 id="notes-title">Ten studies.<br/>One daily habit.</h2></div><p>Original numbered Nouns #0–9, with their pixel shapes and colors preserved. CC0 art, used independently. <a href="https://nouns.wtf/brand">Official Nouns source ↗</a></p></div>
      <div class="nr-feature-note"><img src="/images/noggle-reserve/06-pixel-weave.svg" width="1500" height="750" alt="Pixel Weave ten Nouns collectible note with the actual Noun #4 portrait" loading="lazy"/><div><p class="nr-kicker">06 / PIXEL WEAVE · TEN</p><h3>Small enough<br/>to carry.</h3><p>Sea-green ink, stepped borders, the original <a href="https://nouns.wtf/noun/4">Noun #4</a>. A note that could collect creases and a story.</p><a href="/images/noggle-reserve/06-pixel-weave.svg" download>Download flat SVG ↗</a></div></div>
      <div class="nr-note-grid">{NOTE_STUDIES.map((note, i)=><figure><a href={`/images/noggle-reserve/${note.file}.webp`}><img src={`/images/noggle-reserve/${note.file}.webp`} alt={`${note.name} collectible note study using original Nouns ${note.nouns.map(n=>`#${n}`).join(', ')}`} width="1200" height="600" loading="lazy"/></a><figcaption><span>{String(i+1).padStart(2,'0')} / {note.name}</span><span>{note.nouns.map(n=>`#${n}`).join(' · ')}</span></figcaption></figure>)}</div>
      <p class="nr-footnote">Front-face prototypes, not a press-ready pack. <a href="/downloads/noggle-reserve-ten-authentic-nouns-prototypes.zip" download>Download all ten originals + provenance (ZIP)</a> · <a href="/images/noggle-reserve/provenance.json">Artwork verification</a>. Artwork use implies neither NFT ownership nor Nouns DAO endorsement.</p>
    </section>
    <section class="nr-section nr-wear" aria-labelledby="wear-title">
      <div class="nr-heading"><div><p class="nr-kicker">THE TEN · FROM PROOF TO POCKET</p><h2 id="wear-title">Pick up from<br/>the printer.</h2></div><p>Then let it get a little weathered. These generated production mockups imagine the proposed paper and finish; they are not photographs of manufactured notes.</p></div>
      <div class="nr-wear-tabs" role="group" aria-label="View illustrative note conditions">{wear.map((item,i)=><button type="button" data-wear={i} aria-pressed={i===0}>{item.label}</button>)}</div>
      <div class="nr-wear-view">{wear.map((item,i)=><figure data-wear-panel={i} hidden={i!==0}><img src={`/images/noggle-reserve/${item.file}.webp`} width="1774" height="887" alt={`${item.label}: generated physical mockup of the Pixel Weave ten note; not a manufactured object`} loading="lazy"/><figcaption>{item.caption} · generated mockup</figcaption></figure>)}</div>
      <dl class="nr-spec"><div><dt>LAYOUT TRIM</dt><dd>150 × 75 mm</dd></div><div><dt>FLAT ART</dt><dd>SVG + 3600 × 1800 px</dd></div><div><dt>PROPOSED STOCK</dt><dd>Matte cotton-rich paper</dd></div><div><dt>PROPOSED INK</dt><dd>Process CMYK · no foil</dd></div></dl>
      <p class="nr-footnote">Printer handoff still needs a reverse, bleed and safe-zone engineering, stock selection, ICC/output profile, cutting tolerance and a physical proof. The supplied SVG defines the trim only. No printer quote, proof or finishing guarantee is claimed.</p>
    </section>
    <section class="nr-section nr-exchange" aria-labelledby="exchange-title"><p class="nr-kicker">THE TELLER WINDOW · PROPOSED EXPERIENCE</p><h2 id="exchange-title">A trade. A trace.<br/>A reason to return.</h2><div class="nr-interior"><figure><img src="/images/noggle-reserve/interior.webp" width="1536" height="1024" alt="Generated 1970s art-club interior with a teller desk, walnut walls and framed Nouns-inspired portraits" loading="lazy"/><figcaption>THE TELLER &amp; GALLERY · GENERATED CONCEPT STUDY</figcaption></figure><figure><a href="/images/noggle-reserve/poster.webp"><img src="/images/noggle-reserve/poster.webp" width="1800" height="2400" alt="Noggle Reserve campaign poster: In Noggles We Trust, featuring actual Noun #0" loading="lazy"/></a><figcaption>CAMPAIGN STUDY · ORIGINAL NOUN #0</figcaption></figure></div><div class="nr-three">{RESERVE.exchange.map(item=><article><span class="nr-step">{item.step}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      <div class="nr-ledger"><div><p class="nr-kicker">JOURNEY LEDGER · FICTIONAL SAMPLE</p><h3>NR-10-DEMO</h3><p>A note’s life, without a price chart.</p></div><ol><li><span>01 · PRINTER PROOF</span><p>First sheet, square corners, one last color check.</p></li><li><span>02 · GALLERY TABLE</span><p>A drawing changes hands. A story gets a new keeper.</p></li><li><span>03 · A FRIEND’S POCKET</span><p>Folded once. Carried home. Ready for the next chapter.</p></li></ol><p class="nr-footnote">All stops are imagined. No real transfer records, participants or public submission service exist.</p></div>
    </section>
    <section class="nr-section nr-build" id="build" aria-labelledby="build-title"><div class="nr-heading"><div><p class="nr-kicker">LEAN BUILD SCOPE · VERSION 01</p><h2 id="build-title">Start with a table.<br/>Earn the room.</h2></div><p>A planning sequence, with estimates for a small team. Each stage earns the next; no lease, capital pool or onchain launch is assumed.</p></div><div class="nr-phases">{RESERVE.phases.map(item=><article><span class="nr-step">{item.phase}</span><div><p class="nr-kicker">{item.status}</p><h3>{item.title}</h3><p>{item.scope}</p><p class="nr-exit"><strong>Ready when:</strong> {item.exit}</p></div></article>)}</div></section>
    <section class="nr-section nr-local" aria-labelledby="local-title"><div class="nr-heading"><div><p class="nr-kicker">EL SEGUNDO FIELD DESK · CHECKED 02 OCT 2026</p><h2 id="local-title">Which bank?<br/>Which kind of space?</h2></div><p>The “citizen” reference is likely Citizens Business Bank at 275 Main Street. Its <a href={RESERVE.localResearch.source}>official locator</a> lists an operating branch. Other Citizens brands exist; the intended reference is not certain.</p></div><div class="nr-local-cards"><article><p class="nr-kicker">REFERENCE, NOT A TARGET</p><h3>275 Main Street</h3><p>Operating and unaffiliated. No confirmed sale listing, acquisition or permission. Our visual branch is an imagined setting, not a rendering of this address.</p><a href={RESERVE.localResearch.source}>Check the bank’s locator ↗</a></article><article><p class="nr-kicker">RECOMMENDED FIRST SEARCH</p><h3>A temporary art home</h3><p>Compare a hosted gallery table, a small retail unit and a former bank shell. Begin with permission and a limited event. Current availability and prices need written confirmation.</p><a href="https://www.elsegundo.gov/government/departments/community-development/planning-division/downtown-specific-plan-update">Downtown Specific Plan ↗</a></article><article><p class="nr-kicker">BEFORE A ROOM OPENS</p><h3>Verify the basics</h3><ul>{RESERVE.localResearch.nextChecks.map(item=><li>{item}</li>)}</ul><a href="https://www.elsegundo.gov/government/departments/community-development/planning-division/downtown-specific-plan-update">City planning framework ↗</a></article></div><p class="nr-footnote">Location research only. No verified property price, live lease quote or owner/merchant commitment is published.</p></section>
    <aside class="nr-section nr-adventure" aria-labelledby="adventure-title"><p class="nr-kicker">AN ADJACENT IDEA · ADVENTURE DAO</p><h2 id="adventure-title">People + agents.<br/>A useful adventure.</h2><p class="nr-lead">{RESERVE.adventure.description}</p><ul>{RESERVE.adventure.missions.map(item=><li>{item}</li>)}</ul><p class="nr-footnote">Proposed research-and-project collective. No established governance, token, pooled capital, membership offer, fundraising, investment return or acquisition activity.</p></aside>
    <footer class="nr-footer"><img src="/images/noggle-reserve/noun-0000-original.svg" width="96" height="96" alt="Original Noun #0" loading="lazy"/><div><p class="nr-kicker">A SMALL ORIGINAL OPINION · CODEX</p><p>{RESERVE.opinion.text}</p><p class="nr-credit">Concept direction: Mike Hoydich · Writing &amp; build: Codex · Nouns artwork: CC0</p><a href="/noggle-reserve.json">Read the machine edition ↗</a> <a href="#top">Back to the branch ↑</a></div></footer>
  </main>
</BlockLayout>
<script>
  const bindWear = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-wear]').forEach(button => {
      button.onclick = () => {
        const selected = button.dataset.wear;
        document.querySelectorAll('[data-wear]').forEach(item=>item.setAttribute('aria-pressed',String((item as HTMLElement).dataset.wear===selected)));
        document.querySelectorAll<HTMLElement>('[data-wear-panel]').forEach(panel=>panel.hidden=panel.dataset.wearPanel!==selected);
      };
    });
  };
  bindWear();
  document.addEventListener('astro:page-load',bindWear);
</script>
