---
const canonical = 'https://pointcast.xyz/garden-signal/open-heart';
const spotifyUrl = 'https://open.spotify.com/track/4SncUHZJK8aqEfsmPB1VF5';
const spotifyEmbed = 'https://open.spotify.com/embed/track/4SncUHZJK8aqEfsmPB1VF5?utm_source=pointcast&theme=0';
const ogImage = 'https://pointcast.xyz/images/og/garden-signal-open-heart.jpg';
const frames = [
  {
    src: '/garden-signal/open-heart/assets/door-01.jpg',
    alt: 'A chrome door opens from a dense pink and white garden toward a pale horizon',
    line: 'The invitation',
  },
  {
    src: '/garden-signal/open-heart/assets/door-02.jpg',
    alt: 'A mirrored door stands inside a saturated wall of scarlet, pink, and white flowers',
    line: 'The voltage',
  },
  {
    src: '/garden-signal/open-heart/assets/door-03.jpg',
    alt: 'A bright chrome doorway rises from a lush California garden under a hard blue sky',
    line: 'The opening',
  },
  {
    src: '/garden-signal/open-heart/assets/door-04.jpg',
    alt: 'A silver garden door reveals a narrow green path through abundant summer flowers',
    line: 'The other side',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${canonical}#work`,
  name: 'OPEN HEART — Garden Signal 002',
  description:
    'A four-frame Midjourney visual ode and original browser-native sound garden in conversation with Pete Townshend’s Let My Love Open The Door — E. Cola Mix.',
  url: canonical,
  image: ogImage,
  datePublished: '2026-07-27T20:13:23-07:00',
  creator: {
    '@type': 'Person',
    name: 'Michael Hoydich',
    url: 'https://www.midjourney.com/@mhoydich?tab=archive',
  },
  isBasedOn: {
    '@type': 'MusicRecording',
    name: 'Let My Love Open The Door — E. Cola Mix',
    byArtist: {
      '@type': 'MusicGroup',
      name: 'Pete Townshend',
    },
    url: spotifyUrl,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  mainEntityOfPage: `${canonical}.json`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f02752" />
    <meta
      name="description"
      content="OPEN HEART — a glossy four-frame Garden Signal with an original playable sound garden, made in conversation with Pete Townshend’s E. Cola Mix."
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/garden-signal/open-heart.json" title="Open Heart JSON" />
    <link rel="preload" as="image" href={frames[2].src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="OPEN HEART — Garden Signal 002" />
    <meta
      property="og:description"
      content="Four chrome garden doors. Five original tones. One official Spotify doorway."
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OPEN HEART — Garden Signal 002" />
    <meta name="twitter:description" content="Touch the chrome door. Grow an original sound pattern. Open the official mix on Spotify." />
    <meta name="twitter:image" content={ogImage} />
    <title>OPEN HEART — Garden Signal 002 | PointCast</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip" href="#instrument">Skip to the sound garden</a>

    <main class="heart" data-open-heart data-frame="2" data-open="false" data-audio="locked" data-voice="0">
      <div class="noise" aria-hidden="true"></div>
      <div class="bloom-field" data-bloom-field aria-hidden="true"></div>

      <header class="masthead">
        <a class="brand" href="/" aria-label="PointCast home">POINTCAST</a>
        <span>GARDEN SIGNAL / 002</span>
        <nav aria-label="Open Heart utilities">
          <a href="/garden-signal/open-heart.json">JSON</a>
          <a href="/b/0520">BLOCK 0520</a>
        </nav>
      </header>

      <section class="cover" aria-labelledby="cover-title">
        <div class="cover-media" data-cover-media>
          {frames.map((frame, index) => (
            <figure class="frame" data-frame-index={index} aria-hidden={index === 2 ? 'false' : 'true'}>
              <img
                src={frame.src}
                alt={frame.alt}
                width="1456"
                height="816"
                loading={index === 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption><span>0{index + 1}</span>{frame.line}</figcaption>
            </figure>
          ))}
          <div class="chrome-flare" aria-hidden="true"></div>
        </div>

        <div class="cover-copy">
          <p class="eyebrow">THE SUMMER LOVE ISSUE · EL SEGUNDO · 2026</p>
          <h1 id="cover-title">
            <span>OPEN</span>
            <span>HEART</span>
          </h1>
          <p class="standfirst">
            A door does not persuade the room behind it.<br />
            It only opens.
          </p>
          <button class="open-button" type="button" data-open-door aria-pressed="false">
            <span>Open the door</span>
            <span aria-hidden="true">↗</span>
          </button>
        </div>

        <aside class="cover-lines" aria-label="Issue contents">
          <p><strong>4</strong> CHROME GARDEN EXPOSURES</p>
          <p><strong>5</strong> ORIGINAL TOUCH TONES</p>
          <p><strong>12</strong> STEPS IN THE LOVE MACHINE</p>
          <p><strong>0</strong> SAMPLES FROM THE RECORDING</p>
        </aside>

        <div class="frame-nav" aria-label="Choose a garden exposure">
          {frames.map((frame, index) => (
            <button
              type="button"
              data-frame-select={index}
              aria-label={`Show exposure ${index + 1}: ${frame.line}`}
              aria-pressed={index === 2 ? 'true' : 'false'}
            >
              <span>0{index + 1}</span>
            </button>
          ))}
          <button type="button" data-drift aria-pressed="true"><span>DRIFT ON</span></button>
        </div>
      </section>

      <section class="track-desk" aria-labelledby="track-title">
        <div class="track-copy">
          <p class="section-kicker">THE MUSICAL DOORWAY / OFFICIAL SPOTIFY PLAYER</p>
          <h2 id="track-title">LET MY LOVE<br />OPEN THE DOOR</h2>
          <p>
            Pete Townshend’s <em>E. Cola Mix</em> is the source spark. PointCast does not
            copy, sample, proxy, restream, or synchronize the recording. Press play in
            Spotify; touch the independent garden instrument beside it.
          </p>
          <a class="track-link" href={spotifyUrl} target="_blank" rel="noopener noreferrer">
            Open the track on Spotify ↗
          </a>
        </div>
        <div class="spotify-shell">
          <span class="shell-label">PLAY THE RECORD</span>
          <iframe
            title="Spotify player: Let My Love Open The Door — E. Cola Mix by Pete Townshend"
            src={spotifyEmbed}
            width="100%"
            height="352"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>
          <p>Provider audio stays inside the official Spotify embed.</p>
        </div>
      </section>

      <section class="instrument" id="instrument" aria-labelledby="instrument-title">
        <header class="instrument-head">
          <div>
            <p class="section-kicker">THE POINTCAST REMIX / ORIGINAL WEB AUDIO</p>
            <h2 id="instrument-title">GROW A<br />SECOND SONG.</h2>
          </div>
          <p>
            Not a cover. Not a transcription. A neighboring garden tuned to
            196 / 220.5 / 261.33 / 294 / 343 Hz. Tap freely, or let the
            twelve-step pattern find its own opening.
          </p>
        </header>

        <div class="tone-grid" role="group" aria-label="Five original garden tones">
          <button type="button" class="tone tone--door" data-tone data-tone-label="Door pulse">
            <span>01</span><strong>DOOR</strong><small>196 Hz · warm pulse</small>
          </button>
          <button type="button" class="tone tone--petal" data-tone data-tone-label="Petal bell">
            <span>02</span><strong>PETAL</strong><small>220.5 Hz · brass bloom</small>
          </button>
          <button type="button" class="tone tone--chrome" data-tone data-tone-label="Chrome chime">
            <span>03</span><strong>CHROME</strong><small>261.33 Hz · glass triad</small>
          </button>
          <button type="button" class="tone tone--breeze" data-tone data-tone-label="Garden breeze">
            <span>04</span><strong>BREEZE</strong><small>294 Hz · filtered air</small>
          </button>
          <button type="button" class="tone tone--open" data-tone data-tone-label="Open voltage">
            <span>05</span><strong>OPEN</strong><small>343 Hz · rising voltage</small>
          </button>
        </div>

        <div class="sequencer">
          <div class="steps" aria-hidden="true">
            {Array.from({ length: 12 }).map((_, index) => (
              <i data-step data-active="false"><span>{String(index + 1).padStart(2, '0')}</span></i>
            ))}
          </div>
          <div class="transport">
            <button type="button" data-loop-toggle aria-pressed="false">Start garden loop</button>
            <label>
              <span>Garden volume</span>
              <input data-volume type="range" min="0" max="0.82" step="0.01" value="0.62" />
            </label>
            <p data-audio-status aria-live="polite">Sound begins with your first gesture.</p>
          </div>
        </div>
      </section>

      <section class="ode" aria-labelledby="ode-title">
        <p class="section-kicker">AN ODE / AFTER THE TITLE</p>
        <h2 id="ode-title">LOVE AS<br />ARCHITECTURE.</h2>
        <div class="ode-copy">
          <p>
            The heart is usually drawn as a room with no hinges. This felt wrong.
            A heart is less like a vault and more like a garden door: exposed to
            weather, held by small hardware, made useful by opening.
          </p>
          <p>
            So the flowers arrive with chrome. The chrome arrives with fingerprints.
            The song stays where it belongs—in the official player—and a second,
            quieter machine grows beside it from oscillators, air, delay, and touch.
          </p>
          <p>
            An ode does not need to imitate what it loves. It can build a place where
            the feeling has somewhere new to stand.
          </p>
        </div>
        <p class="pullquote">“A door is a promise with hardware.”</p>
      </section>

      <section class="contact-sheet" aria-labelledby="sheet-title">
        <div class="contact-sheet__head">
          <p class="section-kicker">MIDJOURNEY CONTACT SHEET / JOB 36013043</p>
          <h2 id="sheet-title">FOUR WAYS IN.</h2>
        </div>
        <div class="contact-sheet__grid">
          {frames.map((frame, index) => (
            <button type="button" data-jump-frame={index} aria-label={`Return to exposure ${index + 1}`}>
              <img src={frame.src} alt={frame.alt} width="1456" height="816" loading="lazy" />
              <span>0{index + 1} / {frame.line}</span>
            </button>
          ))}
        </div>
      </section>

      <footer class="credits">
        <div>
          <strong>OPEN HEART</strong>
          <span>GARDEN SIGNAL 002</span>
        </div>
        <p>
          Direction and curation: Michael Hoydich · Midjourney generation:
          Michael Hoydich account · Interactive edition and original Web Audio:
          PointCast / Codex · Musical source: Pete Townshend via Spotify.
          Independent companion artwork; not affiliated with or endorsed by
          Pete Townshend or Spotify. No interaction telemetry is added.
        </p>
        <nav aria-label="Credits and source links">
          <a href="https://www.midjourney.com/jobs/36013043-3e87-41ab-b9b4-c9d1c6e43085?index=2">Midjourney source ↗</a>
          <a href={spotifyUrl}>Spotify track ↗</a>
          <a href="/garden-signal/open-heart.json">Structured credits ↗</a>
          <a href="/">PointCast home ↗</a>
        </nav>
      </footer>
    </main>

    <script>
      import { mountOpenHeartAudio } from '../../lib/open-heart-audio';

      const root = document.querySelector<HTMLElement>('[data-open-heart]');
      if (root) {
        const audio = mountOpenHeartAudio(root);
        const frameNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-frame-index]'));
        const selectors = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-frame-select]'));
        const jumpers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-jump-frame]'));
        const drift = root.querySelector<HTMLButtonElement>('[data-drift]');
        const openDoor = root.querySelector<HTMLButtonElement>('[data-open-door]');
        const bloomField = root.querySelector<HTMLElement>('[data-bloom-field]');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let activeFrame = 2;
        let driftOn = !reducedMotion.matches;
        let driftTimer = 0;

        const showFrame = (next: number, scroll = false) => {
          activeFrame = Math.max(0, Math.min(frameNodes.length - 1, next));
          root.dataset.frame = String(activeFrame);
          frameNodes.forEach((frame, index) => {
            frame.setAttribute('aria-hidden', index === activeFrame ? 'false' : 'true');
          });
          selectors.forEach((selector, index) => {
            selector.setAttribute('aria-pressed', index === activeFrame ? 'true' : 'false');
          });
          if (scroll) root.querySelector('[data-cover-media]')?.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth' });
        };

        const setDrift = (next: boolean) => {
          driftOn = next && !reducedMotion.matches;
          window.clearInterval(driftTimer);
          if (drift) {
            drift.setAttribute('aria-pressed', driftOn ? 'true' : 'false');
            drift.querySelector('span')!.textContent = driftOn ? 'DRIFT ON' : 'DRIFT OFF';
          }
          if (driftOn) {
            driftTimer = window.setInterval(() => showFrame((activeFrame + 1) % frameNodes.length), 9600);
          }
        };

        selectors.forEach((selector, index) => {
          selector.addEventListener('click', () => {
            showFrame(index);
            setDrift(false);
          });
        });

        jumpers.forEach((jumper, index) => {
          jumper.addEventListener('click', () => {
            showFrame(index, true);
            setDrift(false);
          });
        });

        drift?.addEventListener('click', () => setDrift(!driftOn));

        openDoor?.addEventListener('click', () => {
          const isOpen = root.dataset.open !== 'true';
          root.dataset.open = isOpen ? 'true' : 'false';
          openDoor.setAttribute('aria-pressed', isOpen ? 'true' : 'false');
          openDoor.querySelector('span')!.textContent = isOpen ? 'Door open' : 'Open the door';
          if (isOpen) void audio.strike(4, openDoor);
        });

        root.addEventListener('openheart:bloom', (event) => {
          if (!bloomField || reducedMotion.matches) return;
          const custom = event as CustomEvent<{ voice: number; x: number; y: number }>;
          const bloom = document.createElement('i');
          bloom.style.setProperty('--x', `${custom.detail.x}px`);
          bloom.style.setProperty('--y', `${custom.detail.y}px`);
          bloom.style.setProperty('--voice', String(custom.detail.voice));
          bloomField.append(bloom);
          window.setTimeout(() => bloom.remove(), 1300);
        });

        reducedMotion.addEventListener('change', () => setDrift(driftOn));
        setDrift(driftOn);
      }
    </script>
  </body>
</html>

<style>
  @font-face {
    font-family: OpenHeartGrotesk;
    src: local("Arial Black");
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --red: #f02752;
    --acid: #dfff3f;
    --cream: #f6efdc;
    --ink: #0b090a;
    --silver: #c8c8c3;
    --line: rgba(246, 239, 220, 0.28);
    --gutter: clamp(16px, 3vw, 48px);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--ink);
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background: var(--ink);
    color: var(--cream);
  }

  button,
  input,
  a {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button {
    color: inherit;
  }

  img {
    display: block;
    width: 100%;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 4px;
  }

  ::selection {
    background: var(--acid);
    color: var(--ink);
  }

  .skip {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    padding: 12px 16px;
    background: var(--acid);
    color: var(--ink);
    font-weight: 900;
    transform: translateY(-150%);
  }

  .skip:focus {
    transform: translateY(0);
  }

  .heart {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 18%, rgba(240, 39, 82, 0.14), transparent 25rem),
      var(--ink);
  }

  .noise {
    position: fixed;
    z-index: 50;
    inset: 0;
    pointer-events: none;
    opacity: 0.11;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.38'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .bloom-field {
    position: fixed;
    z-index: 40;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bloom-field :global(i) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 38px;
    height: 38px;
    border: 4px solid var(--acid);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
    animation: bloom 1.3s cubic-bezier(.2,.7,.1,1) forwards;
  }

  .bloom-field :global(i:nth-child(2n)) {
    border-color: var(--red);
    border-radius: 18% 82% 20% 80%;
  }

  @keyframes bloom {
    12% { opacity: 0.96; }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(11) rotate(34deg); }
  }

  .masthead {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    min-height: 60px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid rgba(255, 255, 255, 0.48);
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }

  .masthead .brand {
    font-size: 15px;
    text-decoration: none;
  }

  .masthead nav {
    display: flex;
    justify-content: flex-end;
    gap: 18px;
  }

  .cover {
    position: relative;
    min-height: max(780px, 100svh);
    background: #25392f;
  }

  .cover-media,
  .frame {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .frame {
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.25s ease, transform 3s cubic-bezier(.2,.7,.2,1);
    transform: scale(1.045);
  }

  .frame[aria-hidden="false"] {
    z-index: 2;
    opacity: 1;
    transform: scale(1);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.02);
  }

  .frame figcaption {
    position: absolute;
    right: var(--gutter);
    bottom: 26px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .frame figcaption span {
    font-size: 32px;
    letter-spacing: -0.06em;
  }

  .cover::after {
    position: absolute;
    z-index: 4;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(7, 6, 7, 0.82) 0%, rgba(7, 6, 7, 0.22) 45%, transparent 68%),
      linear-gradient(0deg, rgba(7, 6, 7, 0.34), transparent 34%);
  }

  .chrome-flare {
    position: absolute;
    z-index: 3;
    left: 53%;
    top: 50%;
    width: min(27vw, 420px);
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.35);
    background: radial-gradient(circle, rgba(255,255,255,0.95), rgba(223,255,63,0.5) 16%, rgba(240,39,82,0.16) 48%, transparent 69%);
    mix-blend-mode: screen;
    transition: opacity 1.2s ease, transform 2.4s ease;
  }

  .heart[data-open="true"] .chrome-flare {
    opacity: 0.94;
    transform: translate(-50%, -50%) scale(2.8);
  }

  .heart[data-open="true"] .frame[aria-hidden="false"] {
    transform: scale(1.08);
  }

  .cover-copy {
    position: absolute;
    z-index: 6;
    left: var(--gutter);
    top: 16%;
    width: min(670px, 62vw);
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .cover h1,
  .track-desk h2,
  .instrument h2,
  .ode h2,
  .contact-sheet h2 {
    margin: 0;
    font-family: OpenHeartGrotesk, Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-weight: 950;
    letter-spacing: -0.075em;
    line-height: 0.75;
    text-transform: uppercase;
  }

  .cover h1 {
    font-size: clamp(100px, 18vw, 265px);
  }

  .cover h1 span {
    display: block;
  }

  .cover h1 span:last-child {
    color: var(--red);
    -webkit-text-stroke: 2px rgba(255,255,255,0.25);
  }

  .standfirst {
    max-width: 540px;
    margin: 34px 0 26px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(21px, 2.2vw, 34px);
    font-style: italic;
    line-height: 1.08;
  }

  .open-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    min-width: min(100%, 330px);
    min-height: 58px;
    padding: 12px 18px;
    border: 2px solid var(--cream);
    background: var(--red);
    color: #fff;
    box-shadow: 8px 8px 0 var(--acid);
    cursor: pointer;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .open-button:hover {
    transform: translate(3px, 3px);
    box-shadow: 5px 5px 0 var(--acid);
  }

