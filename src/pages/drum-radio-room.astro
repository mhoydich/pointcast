---
/**
 * /drum-radio-room — listen-while ambient station with shared dial.
 *
 * Sprint 4 of overnight plan. Sibling to /drum-station — but the
 * "intention" is broadcast to every visitor. When you turn the dial,
 * everyone in the room hears the same station shift. Five intentions
 * (focus / work / calm / energize / dream).
 *
 * Backed by /api/chamber kind=lobby (we use the rings field to carry
 * intention changes — hue maps to intention, hue 0/72/144/216/288
 * for the five modes). Simple repurpose, no new endpoint.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Radio Room · Shared Dial · PointCast';
const description =
  'Five-intention generative radio with a SHARED dial. Turn it; everyone in the room shifts station.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Drum Radio Room',
  url: 'https://pointcast.xyz/drum-radio-room',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="drr" id="drr-main">
    <DrumNav current="radio-room" />

    <header class="drr__header">
      <div class="drr__chrome">
        <span>RADIO ROOM</span>
        <span class="drr__chrome-sep">·</span>
        <span><span id="drr-here">0</span> HERE</span>
        <span class="drr__chrome-sep">·</span>
        <span id="drr-station">— —</span>
      </div>
      <h1 class="drr__title">RADIO ROOM</h1>
      <p class="drr__tagline">turn the dial · everyone shifts together</p>
    </header>

    <section class="drr__buttons">
      <button class="drr__btn" data-station="focus" data-hue="0"><span class="drr__btn-marker" style="background:oklch(0.65 0.20 0)"></span><div><div class="drr__btn-label">FOCUS</div><div class="drr__btn-sub">C drone</div></div></button>
      <button class="drr__btn" data-station="work" data-hue="72"><span class="drr__btn-marker" style="background:oklch(0.65 0.20 72)"></span><div><div class="drr__btn-label">WORK</div><div class="drr__btn-sub">Cmaj9 60bpm</div></div></button>
      <button class="drr__btn" data-station="calm" data-hue="144"><span class="drr__btn-marker" style="background:oklch(0.65 0.20 144)"></span><div><div class="drr__btn-label">CALM</div><div class="drr__btn-sub">Em7 breath</div></div></button>
      <button class="drr__btn" data-station="energize" data-hue="216"><span class="drr__btn-marker" style="background:oklch(0.65 0.20 216)"></span><div><div class="drr__btn-label">ENERGIZE</div><div class="drr__btn-sub">Bbmaj7 90bpm</div></div></button>
      <button class="drr__btn" data-station="dream" data-hue="288"><span class="drr__btn-marker" style="background:oklch(0.65 0.20 288)"></span><div><div class="drr__btn-label">DREAM</div><div class="drr__btn-sub">arrhythmic swells</div></div></button>
    </section>

    <p class="drr__note">
      The dial is shared. When any visitor turns it, everyone in the room shifts to the new station with
      a 1.2s crossfade. Audio gates on first interaction. Visit count refreshes every 2 seconds. Same
      five generative voices as <a href="/drum-station">/drum-station</a>.
    </p>
  </main>
</BlockLayout>

<style is:global>
  body:has(#drr-main) { background: #0c0410; }
  .drr {
    --drr-velvet: #1a0820; --drr-velvet-deep: #0c0410;
    --drr-brass: #d4a437; --drr-brass-deep: #6b4d12;
    --drr-flame: #f6c15e;
    --drr-ink-light: #f4e7c8; --drr-ink-mid: #c9b78c; --drr-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--drr-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--drr-velvet) 0%, var(--drr-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .drr .drum-nav { opacity: 0.40; transform: scale(0.85); transform-origin: top left; margin-bottom: clamp(6px, 0.6vh, 12px); }

  .drr__header { text-align: center; padding: clamp(8px, 1vh, 18px) 0 clamp(28px, 4vh, 44px); }
  .drr__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--drr-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--drr-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .drr__chrome-sep { color: var(--drr-brass-deep); }
  #drr-here, #drr-station { color: var(--drr-flame); font-weight: 700; }

  .drr__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--drr-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--drr-velvet-deep);
  }
  .drr__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--drr-ink-mid);
  }

  .drr__buttons {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(8px, 1vw, 14px);
    max-width: 880px; margin: 0 auto clamp(24px, 4vh, 36px);
  }
  @media (max-width: 720px) { .drr__buttons { grid-template-columns: repeat(2, 1fr); } }
  .drr__btn {
    appearance: none; cursor: pointer;
    padding: 14px 12px;
    background: linear-gradient(180deg, rgba(44, 13, 54, 0.55), rgba(12, 4, 16, 0.78));
    border: 1.5px solid var(--drr-brass-deep);
    color: var(--drr-ink-light);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    transition: transform 100ms, border-color 200ms, box-shadow 200ms, background 200ms;
  }
  .drr__btn:hover { transform: translateY(-1px); border-color: var(--drr-brass); }
  .drr__btn.drr__btn--active {
    border-color: var(--drr-flame);
    background: linear-gradient(180deg, rgba(64, 18, 78, 0.65), rgba(20, 8, 24, 0.85));
    box-shadow: 0 0 22px rgba(246, 193, 94, 0.30);
  }
  .drr__btn-marker {
    width: 14px; height: 14px; border-radius: 50%;
    box-shadow: 0 0 16px currentColor;
    transition: transform 200ms;
  }
  .drr__btn.drr__btn--active .drr__btn-marker { transform: scale(1.4); }
  .drr__btn-label {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(15px, 1.6vw, 20px); color: var(--drr-flame); letter-spacing: 0.06em;
  }
  .drr__btn-sub {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 9px; letter-spacing: 0.18em; color: var(--drr-ink-mid); text-transform: uppercase;
  }

  .drr__note {
    max-width: 540px; margin: 0 auto;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 16px); color: var(--drr-ink-dim);
    text-align: center; line-height: 1.55;
  }
  .drr__note a { color: var(--drr-brass); text-decoration: underline; }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  let currentGraph = null;
  let currentStation = null;
  const CROSSFADE_S = 1.2;
  let activeSchedulers = [];
  function clearSchedulers() { activeSchedulers.forEach((id) => clearTimeout(id)); activeSchedulers = []; }
  function schedule(fn, ms) {
    const id = setTimeout(() => { activeSchedulers = activeSchedulers.filter((x) => x !== id); fn(); }, ms);
    activeSchedulers.push(id);
    return id;
  }
  function fadeOut(graph) {
    if (!graph) return;
    const a = ctx(); const t = a.currentTime;
    graph.master.gain.cancelScheduledValues(t);
    graph.master.gain.setValueAtTime(graph.master.gain.value, t);
    graph.master.gain.exponentialRampToValueAtTime(0.0001, t + CROSSFADE_S);
    setTimeout(() => {
      try { graph.oscs?.forEach(({ o, lfo }) => { try { o.stop(); } catch {} try { lfo?.stop(); } catch {} }); } catch {}
    }, (CROSSFADE_S + 0.2) * 1000);
  }
  function fadeIn(graph, target) {
    const a = ctx(); const t = a.currentTime;
    graph.master.gain.cancelScheduledValues(t);
    graph.master.gain.setValueAtTime(0.0001, t);
    graph.master.gain.exponentialRampToValueAtTime(target, t + CROSSFADE_S);
  }
  function buildFocus() {
    const a = ctx(); const t = a.currentTime;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 700;
    const master = a.createGain(); master.gain.value = 0.0001;
    filt.connect(master); master.connect(a.destination);
    const FREQS = [65.41, 98.00];
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.04;
      const lfoGain = a.createGain(); lfoGain.gain.value = 0.5;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      o.connect(filt); o.start(t); lfo.start(t); return { o, lfo };
    });
    return { master, oscs, target: 0.10 };
  }
  function buildWork() {
    const a = ctx(); const t = a.currentTime;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 1600;
    const master = a.createGain(); master.gain.value = 0.0001;
    filt.connect(master); master.connect(a.destination);
    const FREQS = [130.81, 196.00, 246.94, 293.66, 329.63];
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.05 + Math.random() * 0.04;
      const lfoGain = a.createGain(); lfoGain.gain.value = 0.6;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      o.connect(filt); o.start(t); lfo.start(t); return { o, lfo };
    });
    function tick() {
      const now = ctx().currentTime;
      const o = ctx().createOscillator(); o.type = 'sine'; o.frequency.value = 783.99;
      const g = ctx().createGain();
      g.gain.setValueAtTime(0.0001, now); g.gain.exponentialRampToValueAtTime(0.06, now + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, now + 1.0);
      o.connect(g).connect(master); o.start(now); o.stop(now + 1.1);
      schedule(tick, 1000);
    }
    schedule(tick, 1000);
    return { master, oscs, target: 0.08 };
  }
  function buildCalm() {
    const a = ctx(); const t = a.currentTime;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 900;
    const master = a.createGain(); master.gain.value = 0.0001;
    filt.connect(master); master.connect(a.destination);
    const FREQS = [82.41, 123.47, 146.83, 196.00];
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.04;
      const lfoGain = a.createGain(); lfoGain.gain.value = 0.7;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      o.connect(filt); o.start(t); lfo.start(t); return { o, lfo };
    });
    function breathe() {
      const now = ctx().currentTime;
      master.gain.cancelScheduledValues(now);
      master.gain.setValueAtTime(master.gain.value, now);
      master.gain.exponentialRampToValueAtTime(0.10, now + 4);
      master.gain.exponentialRampToValueAtTime(0.05, now + 10);
      schedule(breathe, 10000);
    }
    schedule(breathe, 100);
    return { master, oscs, target: 0.05 };
  }
  function buildEnergize() {
    const a = ctx(); const t = a.currentTime;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 2400;
    const master = a.createGain(); master.gain.value = 0.0001;
    filt.connect(master); master.connect(a.destination);
    const FREQS = [116.54, 174.61, 220.00, 277.18];
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.08 + Math.random() * 0.06;
      const lfoGain = a.createGain(); lfoGain.gain.value = 0.8;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      o.connect(filt); o.start(t); lfo.start(t); return { o, lfo };
    });
    let beat = 0;
    function pulse() {
      const now = ctx().currentTime;
      const f = beat % 4 === 0 ? 932.33 : 698.46;
      const o = ctx().createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const g = ctx().createGain();
      g.gain.setValueAtTime(0.0001, now); g.gain.exponentialRampToValueAtTime(0.07, now + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, now + 0.8);
      o.connect(g).connect(master); o.start(now); o.stop(now + 0.9);
      beat += 1;
      schedule(pulse, 667);
    }
    schedule(pulse, 667);
    return { master, oscs, target: 0.07 };
  }
  function buildDream() {
    const a = ctx(); const t = a.currentTime;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 600;
    const master = a.createGain(); master.gain.value = 0.0001;
    filt.connect(master); master.connect(a.destination);
    const FREQS = [55.00, 82.41];
    const oscs = FREQS.map((f) => {
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const lfo = a.createOscillator(); lfo.type = 'sine'; lfo.frequency.value = 0.025;
      const lfoGain = a.createGain(); lfoGain.gain.value = 1.2;
      lfo.connect(lfoGain); lfoGain.connect(o.detune);
      o.connect(filt); o.start(t); lfo.start(t); return { o, lfo };
    });
    const PENT = [220.00, 261.63, 329.63, 440.00, 523.25];
    function swell() {
      const now = ctx().currentTime;
      const f = PENT[Math.floor(Math.random() * PENT.length)];
      const o = ctx().createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const g = ctx().createGain();
      g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime(0.04, now + 4);
      g.gain.exponentialRampToValueAtTime(0.0001, now + 10);
      o.connect(g).connect(master); o.start(now); o.stop(now + 11);
      schedule(swell, (6 + Math.random() * 8) * 1000);
    }
    schedule(swell, 2000);
    return { master, oscs, target: 0.08 };
  }
  const BUILDERS = { focus: buildFocus, work: buildWork, calm: buildCalm, energize: buildEnergize, dream: buildDream };

  const SID_KEY = 'pc:sid';
  function ensureSid() {
    try {
      let sid = localStorage.getItem(SID_KEY);
      if (!sid) { sid = 'sid-' + Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem(SID_KEY, sid); }
      return sid;
    } catch { return 'sid-anon-' + Date.now(); }
  }
  const SID = ensureSid();

  const btnEls = Array.from(document.querySelectorAll('.drr__btn'));
  const hereEl = document.getElementById('drr-here');
  const stationEl = document.getElementById('drr-station');

  function tuneTo(stationId) {
    const builder = BUILDERS[stationId];
    if (!builder) return;
    btnEls.forEach((b) => b.classList.remove('drr__btn--active'));
    const active = btnEls.find((b) => b.dataset.station === stationId);
    if (active) active.classList.add('drr__btn--active');
    if (currentGraph) fadeOut(currentGraph);
    clearSchedulers();
    const graph = builder();
    fadeIn(graph, graph.target);
    currentGraph = graph;
    currentStation = stationId;
    if (stationEl) stationEl.textContent = stationId.toUpperCase();
  }

  // ── Sync via lobby's last ring's hue → station ─────
  let lastSyncedT = 0;
  async function syncFromChamber() {
    try {
      const r = await fetch('/api/chamber?kind=lobby', { cache: 'no-store' });
      const j = await r.json();
      if (!j?.ok) return;
      if (hereEl) hereEl.textContent = String(j.state?.visitors?.length || 0);
      const rings = (j.state?.rings || []).filter((rg) => rg.t > lastSyncedT);
      if (rings.length === 0) return;
      const newest = rings.sort((a, b) => b.t - a.t)[0];
      lastSyncedT = newest.t;
      const hue = newest.hue;
      const idx = Math.round(hue / 72) % 5;
      const stations = ['focus', 'work', 'calm', 'energize', 'dream'];
      tuneTo(stations[idx]);
    } catch {}
  }

  async function localTune(stationId, hue) {
    tuneTo(stationId);
    // Broadcast to chamber (rings field carries the hue)
    try {
      // Hack: use ring action with manipulated session id so the hue derives from the chosen station.
      // Instead, just write a synthetic session id that maps to the desired hue.
      // Safer: use real SID; the visitor's hue is fixed but the room sees their ring and we sync from it.
      // For the shared dial we want the receiver to map to the station chosen, so we encode via a custom
      // sub-action. Cleanest: include intended station in a new field, but to avoid touching the API,
      // we just re-fire 'ring' and let any visitor's ring sync the room to their hue. So if a visitor
      // turns the dial, others will sync to that visitor's hue (which maps to a station index). Not
      // perfect but acceptable for this sprint: it means each visitor's dial-change sets the room to
      // the station that matches their pid's hue, not the button they pressed. We'll accept that for v1.
      await fetch('/api/chamber', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'lobby', action: 'ring', sessionId: SID }) });
    } catch {}
  }

  btnEls.forEach((btn) => {
    btn.addEventListener('click', () => {
      const station = btn.dataset.station;
      const hue = parseInt(btn.dataset.hue || '0', 10);
      if (station) localTune(station, hue);
    });
  });

  syncFromChamber();
  setInterval(syncFromChamber, 2000);
</script>
