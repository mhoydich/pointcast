---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  DIGITAL_PETS_DECISION_GATES,
  DIGITAL_PETS_LAUNCH_EVIDENCE,
  DIGITAL_PETS_MEASUREMENT_RULES,
  DIGITAL_PETS_NEXT_ACTIONS,
  DIGITAL_PETS_OFFICE_META,
  DIGITAL_PETS_READ_LOOP,
  DIGITAL_PETS_ROLES,
  DIGITAL_PETS_SCORECARD,
  DIGITAL_PETS_WEEKS,
} from '../../lib/digital-pets-operations';
import '../../styles/digital-pets-office.css';

const absolute = (path: string) => new URL(path, 'https://pointcast.xyz').href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Project',
  '@id': 'https://pointcast.xyz/digital-pets/office#test',
  name: DIGITAL_PETS_OFFICE_META.title,
  description: DIGITAL_PETS_OFFICE_META.description,
  url: absolute(DIGITAL_PETS_OFFICE_META.route),
  startDate: DIGITAL_PETS_OFFICE_META.startsOn,
  endDate: DIGITAL_PETS_OFFICE_META.endsOn,
  status: 'Active',
  isPartOf: {
    '@type': 'Book',
    '@id': 'https://pointcast.xyz/digital-pets#book',
    name: 'The Animal After the Internet',
  },
  creator: [
    { '@type': 'Person', name: 'Michael Hoydich' },
    { '@type': 'Organization', name: 'Codex / OpenAI' },
  ],
};
---

<BaseLayout
  title="Six-Week Office · The Animal After the Internet"
  description={DIGITAL_PETS_OFFICE_META.description}
  image="/images/og/b/0514.png"
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="pet-office">
    <header class="office-masthead">
      <a href="/">PointCast</a>
      <span>Future Book 001 · Operating Office</span>
      <nav aria-label="Office utilities">
        <a href="/digital-pets">Book</a>
        <a href="/digital-pets/share">Campaign</a>
        <a href="/digital-pets/office.json">JSON</a>
      </nav>
    </header>

    <section class="office-hero" aria-labelledby="office-title">
      <div class="office-hero__copy">
        <p class="office-kicker">LAUNCHED · NOW RUN THE TEST</p>
        <h1 id="office-title">The launch is <em>not</em> the test. The loop is.</h1>
        <p class="office-hero__lede">
          Twelve positions are now a six-week operating practice: Michael
          originates and reacts; the system produces and measures; two unread
          dispatches stop the machine.
        </p>
        <div class="office-launch">
          <span class="office-status">LIVE</span>
          <div>
            <strong>{DIGITAL_PETS_LAUNCH_EVIDENCE.posts}-post X thread</strong>
            <a href={DIGITAL_PETS_LAUNCH_EVIDENCE.url} target="_blank" rel="noopener noreferrer">
              View verified launch ↗
            </a>
          </div>
        </div>
      </div>
      <div class="office-hero__numbers" aria-label="Test duration and cadence">
        <article>
          <strong>12</strong>
          <span>dispatches</span>
        </article>
        <article>
          <strong>6</strong>
          <span>weeks</span>
        </article>
        <article>
          <strong>2×</strong>
          <span>Tue + Thu</span>
        </article>
        <article>
          <strong>1</strong>
          <span>editorial voice</span>
        </article>
      </div>
      <figure class="office-hero__art">
        <img
          src="/images/digital-pets/plate-06-editions.webp"
          alt="Several editions of one authored digital creature arranged like a publishing sequence"
          width="1024"
          height="1536"
          loading="eager"
        />
        <figcaption>PLATE 06 · THE ROADMAP IS A PUBLISHING SCHEDULE</figcaption>
      </figure>
    </section>

    <section class="office-section office-section--now" aria-labelledby="now-title">
      <header class="office-section__head">
        <p class="office-kicker">NEXT 96 HOURS</p>
        <h2 id="now-title">One completed move. Four moves with owners.</h2>
      </header>
      <ol class="office-now-list">
        {DIGITAL_PETS_NEXT_ACTIONS.map((action, index) => (
          <li class:list={[`is-${action.status}`]}>
            <span class="office-now-list__number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p>{action.due} · {action.owner}</p>
              <h3>{action.action}</h3>
              <a
                href={action.evidence}
                target={action.evidence.startsWith('http') ? '_blank' : undefined}
                rel={action.evidence.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {action.status === 'complete' ? 'Launch evidence' : 'Open working surface'}
              </a>
            </div>
            <span class="office-now-list__status">{action.status}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="office-section office-section--roles" aria-labelledby="roles-title">
      <header class="office-section__head">
        <p class="office-kicker">DECISION RIGHTS</p>
        <h2 id="roles-title">The organization is small enough to name every responsibility.</h2>
      </header>
      <div class="office-role-grid">
        {DIGITAL_PETS_ROLES.map((role, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{role.role}</p>
            <h3>{role.name}</h3>
            <ul>
              {role.owns.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="office-section office-section--calendar" aria-labelledby="calendar-title">
      <header class="office-section__head office-section__head--split">
        <div>
          <p class="office-kicker">THE SIX-WEEK SPINE</p>
          <h2 id="calendar-title">Tuesday is the position. Thursday is the complication.</h2>
        </div>
        <p>
          Every week adds one thing the internet cannot supply: Michael’s
          concrete specification, scene, or refusal.
        </p>
      </header>
      <div class="office-week-list">
        {DIGITAL_PETS_WEEKS.map((week) => (
          <article>
            <header>
              <span>WEEK {week.week}</span>
              <div>
                <h3>{week.focus}</h3>
                <p>{week.review}</p>
              </div>
            </header>
            <div class="office-dispatches">
              {week.dispatches.map((dispatch) => (
                <a href={dispatch.path}>
                  <span>{dispatch.date} · #{dispatch.number}</span>
                  <strong>{dispatch.title}</strong>
                  <p>{dispatch.claim}</p>
                </a>
              ))}
            </div>
            <footer>
              <strong>Origination required</strong>
              <p>{week.origination}</p>
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="office-section office-section--loop" aria-labelledby="loop-title">
      <div class="office-loop__claim">
        <p class="office-kicker">NON-NEGOTIABLE</p>
        <h2 id="loop-title">Two unread dispatches stop production.</h2>
        <p>{DIGITAL_PETS_READ_LOOP.stopRule}</p>
      </div>
      <ol>
        <li>
          <span>01</span>
          <div>
            <h3>Before</h3>
            <p>{DIGITAL_PETS_READ_LOOP.before}</p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>Publish</h3>
            <p>{DIGITAL_PETS_READ_LOOP.publish}</p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>After</h3>
            <p>{DIGITAL_PETS_READ_LOOP.after}</p>
          </div>
        </li>
        <li>
          <span>04</span>
          <div>
            <h3>Resume</h3>
            <p>{DIGITAL_PETS_READ_LOOP.resumeRule}</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="office-section office-section--scorecard" id="scorecard" aria-labelledby="scorecard-title">
      <header class="office-section__head office-section__head--split">
        <div>
          <p class="office-kicker">RUNNING SCORECARD</p>
          <h2 id="scorecard-title">Empty cells are honest cells.</h2>
        </div>
        <p>
          Reactions and external signals stay blank until Michael reports
          them. The office measures evidence, not vibes.
        </p>
      </header>
      <div class="office-scorecard" role="table" aria-label="Twelve-piece editorial scorecard">
        <div class="office-scorecard__head" role="row">
          <span role="columnheader">Dispatch</span>
          <span role="columnheader">Michael reaction</span>
          <span role="columnheader">External signal</span>
          <span role="columnheader">Editorial read</span>
        </div>
        {DIGITAL_PETS_SCORECARD.map((row) => (
          <div class="office-scorecard__row" role="row">
            <a href={row.url} role="cell">
              <small>W{row.week} · {row.date}</small>
              <strong>#{row.piece} {row.title}</strong>
            </a>
            <span role="cell">{row.michaelReaction ?? 'Awaiting read'}</span>
            <span role="cell">{row.externalSignal ?? 'Not reported'}</span>
            <span role="cell">{row.editorialRead ?? 'Not written'}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="office-section office-section--gates" aria-labelledby="gates-title">
      <header class="office-section__head">
        <p class="office-kicker">TWO DECISIONS, NOT TWELVE CELEBRATIONS</p>
        <h2 id="gates-title">The test ends in choices.</h2>
      </header>
      <div class="office-gate-grid">
        {DIGITAL_PETS_DECISION_GATES.map((gate) => (
          <article>
            <p>{gate.when}</p>
            <h3>{gate.name}</h3>
            <strong>{gate.decision}</strong>
            <ul>
              {gate.questions.map((question) => <li>{question}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="office-section office-section--rules" aria-labelledby="rules-title">
      <div>
        <p class="office-kicker">MEASUREMENT RULES</p>
        <h2 id="rules-title">Attention with receipts.</h2>
      </div>
      <ul>
        {DIGITAL_PETS_MEASUREMENT_RULES.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>

    <footer class="office-footer">
      <div>
        <strong>FUTURE BOOK OFFICE 001</strong>
        <p>
          Michael Hoydich owns the originating judgment. Codex / OpenAI runs
          production and instrumentation. Sol / ChatGPT is credited for the
          initial arc and read-loop framing. Readers provide signal, not voice.
        </p>
      </div>
      <nav aria-label="Office end matter">
        <a href="/digital-pets">Read the book</a>
        <a href="/digital-pets/share">Campaign desk</a>
        <a href="/digital-pets/office.json">Office JSON</a>
        <a href={DIGITAL_PETS_LAUNCH_EVIDENCE.url} target="_blank" rel="noopener noreferrer">
          Live X thread
        </a>
      </nav>
    </footer>
  </main>
</BaseLayout>
