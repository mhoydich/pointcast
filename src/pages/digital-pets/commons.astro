---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  CREATURE_COMMONS_ARTICLE,
  CREATURE_COMMONS_BOUNDARY,
  CREATURE_COMMONS_COMPANIONS,
  CREATURE_COMMONS_DECISIONS,
  CREATURE_COMMONS_GATES,
  CREATURE_COMMONS_META,
  CREATURE_COMMONS_PILOT,
  CREATURE_COMMONS_ROOMS,
  CREATURE_COMMONS_SOURCES,
  CREATURE_COMMONS_SUPPLY_LADDER,
  sourceForCommons,
} from '../../lib/digital-pets-commons';
import '../../styles/digital-pets-commons.css';

const absolute = (path: string) => new URL(path, 'https://pointcast.xyz').href;
const articleSources = CREATURE_COMMONS_ARTICLE.sourceIds
  .map((id) => sourceForCommons(id))
  .filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'Project'],
  '@id': 'https://pointcast.xyz/digital-pets/commons#proposal',
  headline: CREATURE_COMMONS_META.title,
  name: CREATURE_COMMONS_META.shortTitle,
  description: CREATURE_COMMONS_META.description,
  url: absolute(CREATURE_COMMONS_META.route),
  image: absolute('/images/digital-pets/plate-07-commons.webp'),
  datePublished: CREATURE_COMMONS_META.publishedAt,
  dateModified: CREATURE_COMMONS_META.updatedAt,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'Book',
    '@id': 'https://pointcast.xyz/digital-pets#book',
    name: 'The Animal After the Internet',
  },
  creator: [
    { '@type': 'Person', name: 'Michael Hoydich' },
    { '@type': 'Organization', name: 'Codex / OpenAI' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  spatialCoverage: CREATURE_COMMONS_META.geography,
  citation: articleSources.map((source) => source?.url),
};
---

<BaseLayout
  title={`${CREATURE_COMMONS_META.title} · PointCast`}
  description={CREATURE_COMMONS_META.description}
  image="/images/digital-pets/plate-07-commons.webp"
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="creature-commons">
    <header class="commons-masthead">
      <a href="/">PointCast</a>
      <span>Future Book 001 · Companion 01</span>
      <nav aria-label="Creature Commons utilities">
        <a href="/digital-pets">Book</a>
        <a href="/digital-pets/legacy">Fiction</a>
        <a href="/digital-pets/office">Office</a>
        <a href="/digital-pets/commons.json">JSON</a>
      </nav>
    </header>

    <section class="commons-hero" aria-labelledby="commons-title">
      <div class="commons-hero__copy">
        <p class="commons-kicker">WORKING PROPOSAL · SOUTH BAY → GREATER LOS ANGELES</p>
        <h1 id="commons-title">A Digital Pet Needs <em>a Commons</em></h1>
        <p class="commons-hero__dek">{CREATURE_COMMONS_ARTICLE.claim}</p>
        <div class="commons-status" role="note" aria-label="Project status">
          <strong>PRE-INSTITUTION</strong>
          <span>{CREATURE_COMMONS_META.boundary}</span>
        </div>
      </div>
      <figure class="commons-hero__art">
        <img
          src="/images/digital-pets/plate-07-commons.webp"
          alt="Adult hands repair and assemble several small digital creatures around a cobalt work table"
          width="1024"
          height="1536"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>PLATE 07 / THE COMMONS BEGINS AT THE BENCH</span>
          <span>OpenAI image generation · PointCast direction</span>
        </figcaption>
      </figure>
    </section>

    <section class="commons-decisions" aria-label="Chef's choice decisions">
      {CREATURE_COMMONS_DECISIONS.map((decision, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')} · {decision.label}</span>
          <h2>{decision.value}</h2>
          <p>{decision.detail}</p>
        </article>
      ))}
    </section>

    <article class="commons-essay" aria-labelledby="essay-title">
      <header>
        <p class="commons-kicker">COMPANION ESSAY · 790 WORDS</p>
        <h2 id="essay-title">The institution under the animal.</h2>
      </header>
      <div class="commons-essay__body">
        {CREATURE_COMMONS_ARTICLE.paragraphs.map((paragraph, index) => (
          <>
            <p>{paragraph}</p>
            {index === 3 && (
              <blockquote>{CREATURE_COMMONS_ARTICLE.pullQuote}</blockquote>
            )}
          </>
        ))}
      </div>
      <footer>
        <span>Evidence used in this companion</span>
        <div>
          {articleSources.map((source) => source && (
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              {source.publisher} ↗
            </a>
          ))}
        </div>
      </footer>
    </article>

    <section class="commons-boundary" aria-labelledby="boundary-title">
      <header>
        <p class="commons-kicker">THE BRIGHT LINE</p>
        <h2 id="boundary-title">Common infrastructure. Authored creatures.</h2>
        <p>
          The point is not to make every character communal property. It is to
          prevent survival, memory, and repair from becoming private leverage.
        </p>
      </header>
      <div>
        {CREATURE_COMMONS_BOUNDARY.map((side) => (
          <article>
            <h3>{side.side}</h3>
            <ul>
              {side.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="commons-rooms" aria-labelledby="rooms-title">
      <header>
        <p class="commons-kicker">FIVE ROOMS · ZERO LEASES YET</p>
        <h2 id="rooms-title">An institution can begin as a rhythm.</h2>
      </header>
      <div class="commons-room-grid">
        {CREATURE_COMMONS_ROOMS.map((room) => (
          <article>
            <span>{room.number}</span>
            <h3>{room.name}</h3>
            <p>{room.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="commons-pilot" aria-labelledby="pilot-title">
      <header>
        <div>
          <p class="commons-kicker">THE FIRST NINETY DAYS</p>
          <h2 id="pilot-title">Program before corporation.</h2>
        </div>
        <p>{CREATURE_COMMONS_META.pilotProof}</p>
      </header>
      <ol>
        {CREATURE_COMMONS_PILOT.map((phase, index) => (
          <li>
            <div class="commons-pilot__marker">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="commons-pilot__copy">
              <p>{phase.range}</p>
              <h3>{phase.name}</h3>
              <strong>{phase.proof}</strong>
              <ul>
                {phase.actions.map((action) => <li>{action}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="commons-supply" aria-labelledby="supply-title">
      <header>
        <div>
          <p class="commons-kicker">LOCAL SOURCING · RESEARCH LIST, NOT ENDORSEMENTS</p>
          <h2 id="supply-title">The first hundred should teach the neighborhood.</h2>
        </div>
        <p>
          No commitment or quote is claimed. The first action is a request for
          information and a real manufacturability conversation.
        </p>
      </header>
      <div class="commons-supply-grid">
        {CREATURE_COMMONS_SUPPLY_LADDER.map((supplier, index) => {
          const source = sourceForCommons(supplier.sourceId);
          return (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{supplier.layer}</p>
              <h3>{supplier.organization}</h3>
              <small>{supplier.location}</small>
              <p>{supplier.capability}</p>
              {source && (
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  Verify stated capability ↗
                </a>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <section class="commons-gates" aria-labelledby="gates-title">
      <header>
        <p class="commons-kicker">FOUNDING GATES</p>
        <h2 id="gates-title">Community is not an exemption from responsibility.</h2>
      </header>
      <div>
        {CREATURE_COMMONS_GATES.map((gate) => (
          <article>
            <h3>{gate.name}</h3>
            <p>{gate.rule}</p>
            <div>
              {gate.sourceIds.map((sourceId) => {
                const source = sourceForCommons(sourceId);
                return source && (
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.publisher} ↗
                  </a>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="commons-next" aria-labelledby="next-title">
      <div>
        <p class="commons-kicker">THE COMPANION SERIES CONTINUES</p>
        <h2 id="next-title">Five more doors into the commons.</h2>
      </div>
      <ol>
        {CREATURE_COMMONS_COMPANIONS.map((title, index) => (
          <li>
            <span>{String(index + 2).padStart(2, '0')}</span>
            <strong>{title}</strong>
          </li>
        ))}
      </ol>
    </section>

    <section class="commons-invite" aria-labelledby="invite-title">
      <div>
        <p class="commons-kicker">FOUNDING CIRCLE · LISTEN FIRST</p>
        <h2 id="invite-title">Know how to build, mend, govern, archive, or care for this?</h2>
      </div>
      <div>
        <p>
          Send one concrete correction, capability, or constraint. PointCast is
          looking for embedded hardware, soft-goods, repair, privacy,
          compliance, community education, and archive experience—not applause
          for an organization that does not exist yet.
        </p>
        <a href="mailto:hello@pointcast.xyz?subject=Creature%20Commons%20LA%20%E2%80%94%20one%20concrete%20note">
          Send one concrete note ↗
        </a>
      </div>
    </section>

    <footer class="commons-colophon">
      <div>
        <a href="/">PointCast</a>
        <span>Creature Commons LA · Working proposal 001</span>
      </div>
      <p>
        Michael Hoydich originated the digital-pets ownership thesis and chose
        an open “chef’s choice” brief. Codex / OpenAI selected the adult-first,
        paired-organization pilot, developed the reported companion essay,
        generated Plate 07, structured the working charter, and implemented
        this publication. Vendor descriptions come from linked first-party
        materials and remain unverified for project fit. Legal and compliance
        notes are issue-spotting, not legal advice.
      </p>
      <nav aria-label="Companion footer">
        <a href="/digital-pets">Read the book</a>
        <a href="/digital-pets/legacy">Read The Amber Seed</a>
        <a href="/digital-pets/office">Open the six-week office</a>
        <a href="/digital-pets/commons.json">Read the JSON twin</a>
        <a href="#commons-title">Back to top</a>
      </nav>
    </footer>
  </main>
</BaseLayout>
