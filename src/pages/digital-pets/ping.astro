---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { PING_LOCAL_PET } from '../../lib/ping-local-pet';
import '../../styles/digital-pets-ping.css';

const ping = PING_LOCAL_PET;
const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': 'https://pointcast.xyz/digital-pets/ping#product',
      name: ping.name,
      description: ping.description,
      category: 'Local-first communication device concept',
      image: `https://pointcast.xyz${ping.conceptImage}`,
      brand: {
        '@type': 'Brand',
        name: ping.family,
      },
      manufacturer: {
        '@type': 'Organization',
        name: 'Not selected',
      },
      releaseDate: null,
    },
    {
      '@type': 'Project',
      '@id': 'https://pointcast.xyz/digital-pets/ping#build',
      name: `${ping.name} open production room`,
      description: ping.description,
      url: 'https://pointcast.xyz/digital-pets/ping',
      status: 'Alpha 0 planning',
      location: {
        '@type': 'Place',
        name: ping.center,
      },
      creator: [
        { '@type': 'Person', name: 'Michael Hoydich' },
        { '@type': 'Organization', name: 'Codex / OpenAI' },
      ],
      isPartOf: {
        '@type': 'Book',
        name: 'The Animal After the Internet',
        url: 'https://pointcast.xyz/digital-pets',
      },
    },
  ],
};
---

<BlockLayout
  title="PING / Local Pet 01 — Open Production Room"
  description={ping.description}
  image={ping.conceptImage}
  imageWidth={1536}
  imageHeight={1024}
  themeColor="#0d1110"
  jsonLd={jsonLd}
  alternates={[
    {
      type: 'application/json',
      href: ping.jsonRoute,
      title: 'PING / Local Pet 01 production manifest',
    },
  ]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="ping-room" data-ping-room data-signal="HOME" data-mode="HOME">
    <header class="ping-mast">
      <a class="ping-mast__brand" href="/">POINTCAST</a>
      <span class="ping-mast__edition">FUTURE BOOK 001 · PHYSICAL COMPANION 04</span>
      <nav aria-label="PING navigation">
        <a href="/digital-pets">Book</a>
        <a href="/local-star-commons">LOCAL STAR</a>
        <a href="/network-el-segundo/mesh-commons">Mesh plan</a>
        <a href={ping.jsonRoute}>JSON ↗</a>
      </nav>
    </header>

    <section class="ping-hero" aria-labelledby="ping-title">
      <div class="ping-hero__copy">
        <p class="ping-kicker">LOCAL STAR / ALPHA 0 / EL SEGUNDO</p>
        <h1 id="ping-title">
          ONE LITTLE
          <span>SIGNAL</span>
          IS ENOUGH.
        </h1>
        <p class="ping-hero__dek">{ping.positioning}</p>
        <div class="ping-hero__actions">
          <a href="#rehearsal">Try the five signals ↓</a>
          <a href="#build">Open the build truth ↓</a>
        </div>
        <p class="ping-hero__boundary">
          Five finite meanings. Visible route state. No microphone, camera,
          GPS, required cloud, open-ended chat, or subscription ransom.
        </p>
      </div>

      <figure class="ping-hero__image">
        <img
          src={ping.conceptImage}
          alt={ping.conceptImageAlt}
          width="1536"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>CONCEPT IMAGE / NOT MANUFACTURED HARDWARE</span>
          <p>{ping.conceptImageDisclosure}</p>
        </figcaption>
      </figure>

      <div class="ping-hero__truth" aria-label="Current PING release truth">
        <article>
          <strong>{ping.truth.physicalUnitsBuilt}</strong>
          <span>physical units</span>
        </article>
        <article>
          <strong>{ping.truth.hostTestsPassed}/26</strong>
          <span>host tests</span>
        </article>
        <article>
          <strong>{ping.truth.wireEnvelopeBytes}B</strong>
          <span>wire envelope</span>
        </article>
        <article>
          <strong>{money.format(ping.alpha.revisedPlanningBomUsd)}</strong>
          <span>planning BOM</span>
        </article>
      </div>
    </section>

    <div class="ping-ticker" aria-label="Production status">
      <span>G0 · FREEZE + FUND</span>
      <span>NO PREORDER</span>
      <span>NO APPLICATION SUBMITTED</span>
      <span>NO VENDOR ENGAGED</span>
      <span>ESP32 TARGET LINKED / NO BOARD FLASHED</span>
      <span>BUILD EVIDENCE BEFORE RANGE CLAIMS</span>
    </div>

    <section class="ping-rehearsal" id="rehearsal" aria-labelledby="rehearsal-title">
      <header class="ping-section-head ping-section-head--split">
        <div>
          <p class="ping-kicker">BROWSER REHEARSAL · NOTHING TRANSMITTED</p>
          <h2 id="rehearsal-title">Five ways to be present.</h2>
        </div>
        <p>
          This is the V1 vocabulary, not a chatbot. Select a signal and a route
          posture to rehearse the visible state a physical pair must earn.
        </p>
      </header>

      <div class="ping-instrument">
        <div class="ping-instrument__pet" aria-hidden="true">
          <div class="ping-pet">
            <i class="ping-pet__ear"></i>
            <i class="ping-pet__eye ping-pet__eye--left"></i>
            <i class="ping-pet__eye ping-pet__eye--right"></i>
            <span class="ping-pet__screen" data-pet-glyph>{ping.signals[0].glyph}</span>
            <b class="ping-pet__dial"></b>
            <span class="ping-pet__wave ping-pet__wave--one"></span>
            <span class="ping-pet__wave ping-pet__wave--two"></span>
            <span class="ping-pet__wave ping-pet__wave--three"></span>
          </div>
          <div class="ping-instrument__state">
            <span data-pet-code>{ping.signals[0].code}</span>
            <strong data-pet-meaning>{ping.signals[0].meaning}</strong>
            <p data-pet-expression>{ping.signals[0].expression}</p>
          </div>
        </div>

        <div class="ping-instrument__controls">
          <fieldset class="ping-signal-field">
            <legend>01 / Choose one signal</legend>
            {ping.signals.map((signal, index) => (
              <button
                type="button"
                data-signal-button={signal.code}
                data-meaning={signal.meaning}
                data-expression={signal.expression}
                data-glyph={signal.glyph}
                aria-pressed={index === 0 ? 'true' : 'false'}
                style={`--signal:${signal.color}`}
              >
                <span>{signal.glyph}</span>
                <strong>{signal.code}</strong>
                <small>{signal.meaning}</small>
              </button>
            ))}
          </fieldset>

          <fieldset class="ping-mode-field">
            <legend>02 / Choose the physical switch</legend>
            {ping.modes.map((mode, index) => (
              <button
                type="button"
                data-mode-button={mode.code}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <strong>{mode.code}</strong>
                <small>{mode.meaning}</small>
              </button>
            ))}
          </fieldset>

          <div class="ping-terminal" aria-live="polite">
            <div class="ping-terminal__bar">
              <span>LOCAL PET / REHEARSAL LOG</span>
              <span data-terminal-mode>MODE HOME</span>
            </div>
            <ol data-terminal-log>
              <li><time>LOCAL</time> HOME composed</li>
              <li><time>ROUTE</time> waiting for physical evidence</li>
              <li><time>STATE</time> no network write</li>
            </ol>
          </div>
        </div>
      </div>

      <p class="ping-rehearsal__note">
        A real PING may show <strong>DELIVERED</strong> only after an
        authenticated acknowledgement. This browser never shows one.
      </p>
    </section>

    <section class="ping-proof" id="build" aria-labelledby="proof-title">
      <header class="ping-section-head">
        <p class="ping-kicker">THE GLASS FACTORY / 30 JULY 2026</p>
        <h2 id="proof-title">Working software is not working hardware.</h2>
      </header>

      <div class="ping-proof__grid">
        <div class="ping-proof__yes">
          <p class="ping-proof__label">PROVED IN SOFTWARE</p>
          {ping.currentProof.map((proof) => (
            <article>
              <span>{proof.label}</span>
              <strong>{proof.value}</strong>
              <p>{proof.detail}</p>
            </article>
          ))}
        </div>
        <div class="ping-proof__no">
          <p class="ping-proof__label">NOT PROVED YET</p>
          <ol>
            {ping.notYetProof.map((gap, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{gap}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="ping-alpha" aria-labelledby="alpha-title">
      <header class="ping-section-head ping-section-head--split">
        <div>
          <p class="ping-kicker">ALPHA 0 / 10 WORKING + 2 SPARES</p>
          <h2 id="alpha-title">The basket has a price.<br />It does not have permission.</h2>
        </div>
        <p>
          The exact compute board now has visible distributor stock, but the
          display fell to seven units and radio availability remains unwritten.
          Nothing has been ordered and no listed price is a delivered quote.
        </p>
      </header>

      <div class="ping-alpha__numbers">
        <article>
          <span>Revised planning BOM</span>
          <strong>{money.format(ping.alpha.revisedPlanningBomUsd)}</strong>
          <p>Direct Alpha components plus 25% contingency.</p>
        </article>
        <article>
          <span>Parts ceiling</span>
          <strong>{money.format(ping.alpha.partsCeilingUsd)}</strong>
          <p>Requires Michael Hoydich’s purchase approval.</p>
        </article>
        <article>
          <span>Proof-pair wave</span>
          <strong>{money.format(ping.alpha.proofPairPartsCeilingUsd)}</strong>
          <p>Two complete pets plus high-risk spares before the remaining order.</p>
        </article>
        <article>
          <span>Complete Alpha sprint</span>
          <strong>{money.format(ping.alpha.totalCeilingUsd)}</strong>
          <p>Parts, specialists, fabrication, test, admin, contingency.</p>
        </article>
      </div>

      <div class="ping-alpha__blockers">
        <p>WHY THE BASKET CANNOT SHIP AS WRITTEN</p>
        <ol>
          {ping.alpha.blockers.map((blocker, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{blocker}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ping-capital" aria-labelledby="capital-title">
      <div class="ping-capital__lead">
        <p class="ping-kicker">CAPITAL / FIRST RELEASE ROUTE</p>
        <h2 id="capital-title">{money.format(ping.capital.immediateRoute.amountUsd)} can start the build.</h2>
        <p>
          The immediate target is the live Boost VC Fellowship path. Its
          current form describes an equity investment at a
          {` ${money.format(ping.capital.immediateRoute.publishedCapUsd)} cap`}.
          The release packet is prepared; it has not been submitted.
        </p>
        <div class="ping-capital__links">
          <a href={ping.capital.immediateRoute.faqUrl} target="_blank" rel="noopener">
            Inspect Boost FAQ ↗
          </a>
          <a href={ping.capital.immediateRoute.formUrl} target="_blank" rel="noopener">
            Inspect live application ↗
          </a>
        </div>
        <p>
          A late Fall 2026 YC application is the optional full-bridge route.
          Its published standard deal is {money.format(ping.capital.secondaryRoute.amountUsd)};
          the application, interview path, in-person batch, and economics still
          require a founder decision.
        </p>
        <div class="ping-capital__links">
          <a href={ping.capital.secondaryRoute.applyUrl} target="_blank" rel="noopener">
            Inspect YC application ↗
          </a>
          <a href={ping.capital.secondaryRoute.dealUrl} target="_blank" rel="noopener">
            Inspect YC deal ↗
          </a>
        </div>
      </div>

      <div class="ping-capital__facts">
        <article>
          <span>Prepared</span>
          <strong>{ping.truth.applicationsPrepared}</strong>
          <p>Complete application field map and founder-video script.</p>
        </article>
        <article>
          <span>Submitted</span>
          <strong>{ping.truth.applicationsSubmitted}</strong>
          <p>No form data or founder representation has been transmitted.</p>
        </article>
        <article>
          <span>Committed</span>
          <strong>{money.format(ping.truth.capitalCommittedUsd)}</strong>
          <p>No cash, SAFE, grant, purchase order, or bank receipt exists.</p>
        </article>
        <article class="ping-capital__missing">
          <span>Founder release gate</span>
          <p>{ping.capital.immediateRoute.missing}</p>
        </article>
        <article class="ping-capital__missing">
          <span>Instrument boundary</span>
          <p>{ping.capital.immediateRoute.termsBoundary}</p>
        </article>
      </div>
    </section>

    <section class="ping-ring" aria-labelledby="ring-title">
      <header class="ping-section-head ping-section-head--split">
        <div>
          <p class="ping-kicker">25-MILE PRODUCTION RING</p>
          <h2 id="ring-title">Build close enough to carry the failure across town.</h2>
        </div>
        <p>
          Aerospace discipline is useful here: configuration control, antenna
          rigor, traceable test, and acceptance evidence. PING remains a
          civilian social object—not a defense or surveillance product.
        </p>
      </header>

      <div class="ping-ring__orbit">
        <div class="ping-ring__center">
          <span>0 MI</span>
          <strong>EL<br />SEGUNDO</strong>
          <small>BUILD TABLE</small>
        </div>
        <div class="ping-ring__partners">
          {ping.productionRing.map((partner, index) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener"
              style={`--index:${index}`}
            >
              <span>{partner.place} / {partner.need}</span>
              <strong>{partner.candidate}</strong>
              <p>{partner.fit}</p>
              <small>{partner.status} ↗</small>
            </a>
          ))}
        </div>
      </div>

      <aside class="ping-ring__gap">
        <strong>RADIUS GAP / FORMAL CONSUMER COMPLIANCE</strong>
        <p>{ping.complianceGap}</p>
      </aside>
    </section>

    <section class="ping-gates" aria-labelledby="gates-title">
      <header class="ping-section-head">
        <p class="ping-kicker">THE ONLY ROADMAP THAT COUNTS</p>
        <h2 id="gates-title">Each claim waits behind its proof.</h2>
      </header>
      <ol>
        {ping.buildSequence.map((step) => (
          <li class:list={{ 'is-now': step.status === 'now' }}>
            <span>{step.gate}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.proof}</p>
            </div>
            <b>{step.status === 'now' ? 'NOW' : 'LOCKED'}</b>
          </li>
        ))}
      </ol>
    </section>

    <section class="ping-gtm" aria-labelledby="gtm-title">
      <header class="ping-section-head ping-section-head--split">
        <div>
          <p class="ping-kicker">GTM V1 / BUILD, THEN BEHAVIOR</p>
          <h2 id="gtm-title">No interview theater.</h2>
        </div>
        <p>{ping.goToMarket.launchRule}</p>
      </header>

      <div class="ping-gtm__grid">
        <article>
          <span>FIRST CUSTOMERS</span>
          <ul>
            {ping.goToMarket.firstCustomers.map((customer) => <li>{customer}</li>)}
          </ul>
        </article>
        <article>
          <span>THE OFFER LADDER</span>
          <ul>
            {ping.goToMarket.offer.map((offer) => <li>{offer}</li>)}
          </ul>
        </article>
        <article class="ping-gtm__episodes">
          <span>THE FIRST EIGHT PUBLIC EPISODES</span>
          <ol>
            {ping.goToMarket.firstEpisodes.map((episode, index) => (
              <li>
                <small>{String(index + 1).padStart(2, '0')}</small>
                <p>{episode}</p>
              </li>
            ))}
          </ol>
        </article>
      </div>
    </section>

    <section class="ping-rights" aria-labelledby="rights-title">
      <div>
        <p class="ping-kicker">TRANSPARENCY IS A CONTROL SYSTEM</p>
        <h2 id="rights-title">Who can make what real?</h2>
      </div>
      <article>
        <span>CODEX / PRODUCTION LEAD</span>
        <p>{ping.decisionRights.codex}</p>
      </article>
      <article>
        <span>MICHAEL HOYDICH / SPONSOR</span>
        <p>{ping.decisionRights.michael}</p>
      </article>
    </section>

    <section class="ping-boundaries" aria-labelledby="boundaries-title">
      <header>
        <p class="ping-kicker">READ BEFORE REPEATING</p>
        <h2 id="boundaries-title">Boundaries are part of the product.</h2>
      </header>
      <ol>
        {ping.boundaries.map((boundary, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{boundary}</p>
          </li>
        ))}
      </ol>
    </section>

    <footer class="ping-footer">
      <div>
        <p>POINTCAST / PING / LOCAL PET 01</p>
        <strong>BUILD THE LITTLE THING.<br />PUBLISH THE TRUTH.</strong>
      </div>
      <nav aria-label="PING closing links">
        <a href={`/b/${ping.blockId}`}>Block {ping.blockId}</a>
        <a href={ping.jsonRoute}>Machine manifest</a>
        <a href="/digital-pets">The future book</a>
        <a href="/digital-pets/commons">Creature Commons</a>
        <a href="/local-star-commons">LOCAL STAR COMMONS</a>
      </nav>
      <p>
        PointCast · El Segundo, California · Public production ledger dated
        30 July 2026.
      </p>
    </footer>

    <script is:inline>
      (() => {
        const root = document.querySelector('[data-ping-room]');
        if (!(root instanceof HTMLElement)) return;

        const signalButtons = Array.from(root.querySelectorAll('[data-signal-button]'));
        const modeButtons = Array.from(root.querySelectorAll('[data-mode-button]'));
        const code = root.querySelector('[data-pet-code]');
        const meaning = root.querySelector('[data-pet-meaning]');
        const expression = root.querySelector('[data-pet-expression]');
        const glyph = root.querySelector('[data-pet-glyph]');
        const terminalMode = root.querySelector('[data-terminal-mode]');
        const terminalLog = root.querySelector('[data-terminal-log]');
        let selectedSignal = 'HOME';
        let selectedMode = 'HOME';

        const writeLog = () => {
          if (!(terminalLog instanceof HTMLOListElement)) return;
          const messages = [
            ['LOCAL', `${selectedSignal} composed`],
            ['MODE', `${selectedMode} selected`],
            ['ROUTE', 'waiting for physical evidence'],
            ['STATE', 'no network write'],
          ];
          terminalLog.replaceChildren(
            ...messages.map(([label, value]) => {
              const item = document.createElement('li');
              const time = document.createElement('time');
              time.textContent = label;
              item.append(time, ` ${value}`);
              return item;
            }),
          );
        };

        signalButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', () => {
            selectedSignal = button.dataset.signalButton || 'HOME';
            root.dataset.signal = selectedSignal;
            signalButtons.forEach((candidate) => {
              candidate.setAttribute(
                'aria-pressed',
                candidate === button ? 'true' : 'false',
              );
            });
            if (code) code.textContent = selectedSignal;
            if (meaning) meaning.textContent = button.dataset.meaning || '';
            if (expression) expression.textContent = button.dataset.expression || '';
            if (glyph) glyph.textContent = button.dataset.glyph || '';
            writeLog();
          });
        });

        modeButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', () => {
            selectedMode = button.dataset.modeButton || 'HOME';
            root.dataset.mode = selectedMode;
            modeButtons.forEach((candidate) => {
              candidate.setAttribute(
                'aria-pressed',
                candidate === button ? 'true' : 'false',
              );
            });
            if (terminalMode) terminalMode.textContent = `MODE ${selectedMode}`;
            writeLog();
          });
        });
      })();
    </script>
  </main>
</BlockLayout>
