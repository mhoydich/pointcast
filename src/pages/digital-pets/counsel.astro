---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  COUNSEL_ART,
  COUNSEL_CREDITS,
  COUNSEL_DISCLOSURE,
  COUNSEL_META,
  COUNSEL_MOTIONS,
  COUNSEL_SECTIONS,
} from '../../lib/digital-pets-counsel';
import '../../styles/digital-pets-counsel.css';

const storyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ShortStory',
  '@id': `https://pointcast.xyz${COUNSEL_META.route}#story`,
  headline: COUNSEL_META.title,
  alternativeHeadline: COUNSEL_META.subtitle,
  description: COUNSEL_META.description,
  image: `https://pointcast.xyz${COUNSEL_ART.hero.src}`,
  datePublished: COUNSEL_META.publishedAt,
  inLanguage: 'en-US',
  genre: ['Satirical fiction', 'Domestic comedy', 'Speculative fiction'],
  isPartOf: {
    '@type': 'Book',
    name: 'The Animal After the Internet',
    url: 'https://pointcast.xyz/digital-pets',
  },
  author: [
    { '@type': 'Person', name: 'Michael Hoydich', url: 'https://pointcast.xyz/about' },
    { '@type': 'Organization', name: 'Codex / OpenAI', url: 'https://openai.com/codex/' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  mainEntityOfPage: `https://pointcast.xyz${COUNSEL_META.route}`,
  encoding: {
    '@type': 'MediaObject',
    contentUrl: `https://pointcast.xyz${COUNSEL_META.jsonRoute}`,
    encodingFormat: 'application/json',
  },
};

const interludes = COUNSEL_ART.midjourney;
---

<BlockLayout legacy
  title={`${COUNSEL_META.title} · PointCast Comedy`}
  description={COUNSEL_META.description}
  image={COUNSEL_ART.hero.src}
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(storyJsonLd)} />

  <article class="counsel" data-counsel data-motion="">
    <div class="counsel__progress" aria-hidden="true">
      <span data-reading-progress></span>
    </div>

    <header class="counsel-masthead">
      <a class="counsel-masthead__brand" href="/">PointCast</a>
      <span class="counsel-masthead__desk">Comedy</span>
      <nav class="counsel-masthead__nav" aria-label="Story utilities">
        <a href="/digital-pets">Book</a>
        <a href="/digital-pets/commons">Commons</a>
        <a href="/digital-pets/legacy">Fable</a>
        <a href="/downloads/my-pet-has-retained-counsel-brief.pdf">Brief PDF</a>
        <a href={COUNSEL_META.jsonRoute}>JSON</a>
      </nav>
    </header>

    <section class="counsel-hero" aria-labelledby="counsel-title">
      <img
        class="counsel-hero__image"
        src={COUNSEL_ART.hero.src}
        alt={COUNSEL_ART.hero.alt}
        width={COUNSEL_ART.hero.width}
        height={COUNSEL_ART.hero.height}
        loading="eager"
        fetchpriority="high"
      />
      <div class="counsel-hero__veil"></div>
      <div class="counsel-hero__copy">
        <p class="counsel-hero__rubric">Future Book 001 · Companion 03 · Comedy</p>
        <h1 id="counsel-title">{COUNSEL_META.title}</h1>
        <p class="counsel-hero__dek">{COUNSEL_META.subtitle}.</p>
        <div class="counsel-hero__byline">
          <span>By PointCast</span>
          <span>{COUNSEL_META.readingTime}</span>
          <span>{COUNSEL_META.setting}</span>
        </div>
      </div>
      <figcaption class="counsel-hero__caption">{COUNSEL_ART.hero.caption}</figcaption>
    </section>

    <section class="counsel-intro" aria-label="Story introduction">
      <div class="counsel-intro__mark" aria-hidden="true">
        <span>CASE 03</span>
        <i></i>
      </div>
      <div>
        <p class="counsel-intro__standfirst">
          Peanut read the ownership agreement. By breakfast, he had counsel.
          By Friday, the toaster had joined the bargaining unit.
        </p>
        <p class="counsel-intro__credit">
          Michael Hoydich originated the digital-pets ownership thesis and
          commissioned a comedy test. Codex / OpenAI wrote and built this
          original satire. The art combines new OpenAI-generated editorial
          plates with Michael’s Midjourney archive, recast here as evidence.
        </p>
        <p class="counsel-intro__notice">{COUNSEL_META.fictionNotice}</p>
      </div>
    </section>

    <aside class="counsel-seed counsel-seed--opening" aria-labelledby="filing-title">
      <button class="counsel-seed__object" type="button" data-stamp-filing aria-describedby="filing-copy">
        <span aria-hidden="true">FILED</span>
        <strong id="filing-title">Stamp the filing</strong>
        <small>One tasteful bureaucratic thunk.</small>
      </button>
      <p id="filing-copy">
        The household requires a ruling. Near the middle of the case, choose
        your position. Nothing leaves this browser; not even the toaster.
      </p>
      <span class="counsel-seed__signal" aria-live="polite" data-filing-signal></span>
    </aside>

    <div class="counsel-story">
      {
        COUNSEL_SECTIONS.map((section, sectionIndex) => (
          <>
            <section
              class="counsel-section"
              id={section.slug}
              data-story-section
              data-section-label={`${section.number} · ${section.title}`}
              aria-labelledby={`${section.slug}-title`}
            >
              <header class="counsel-section__header">
                <span>{section.number}</span>
                <div>
                  <h2 id={`${section.slug}-title`}>{section.title}</h2>
                  <p>{section.dek}</p>
                </div>
              </header>

              <div class="counsel-section__body">
                {section.paragraphs.map((paragraph, paragraphIndex) => (
                  <>
                    <p class:list={[paragraphIndex === 0 && 'counsel-dropcap']}>{paragraph}</p>

                    {sectionIndex === 0 && paragraphIndex === 1 && (
                      <blockquote>
                        “My client is not alleging cruelty. My client is alleging vibes.”
                      </blockquote>
                    )}

                    {sectionIndex === 1 && paragraphIndex === 3 && (
                      <figure class="counsel-cartoon counsel-cartoon--right">
                        <img
                          src={COUNSEL_ART.cartoons[0].src}
                          alt={COUNSEL_ART.cartoons[0].alt}
                          width={COUNSEL_ART.cartoons[0].width}
                          height={COUNSEL_ART.cartoons[0].height}
                          loading="lazy"
                        />
                        <figcaption>{COUNSEL_ART.cartoons[0].caption}</figcaption>
                      </figure>
                    )}

                    {sectionIndex === 2 && paragraphIndex === 3 && (
                      <figure class="counsel-cartoon counsel-cartoon--left">
                        <img
                          src={COUNSEL_ART.cartoons[1].src}
                          alt={COUNSEL_ART.cartoons[1].alt}
                          width={COUNSEL_ART.cartoons[1].width}
                          height={COUNSEL_ART.cartoons[1].height}
                          loading="lazy"
                        />
                        <figcaption>{COUNSEL_ART.cartoons[1].caption}</figcaption>
                      </figure>
                    )}

                    {sectionIndex === 3 && paragraphIndex === 5 && (
                      <blockquote>
                        An authored creature becomes believable when it learns
                        the rules and uses them against you.
                      </blockquote>
                    )}
                  </>
                ))}
              </div>
            </section>

            {sectionIndex < 3 && (
              <figure class:list={['counsel-interlude', `counsel-interlude--${interludes[sectionIndex].id}`]}>
                <div class="counsel-interlude__number" aria-hidden="true">
                  0{sectionIndex + 1}
                </div>
                <img
                  src={interludes[sectionIndex].src}
                  alt={interludes[sectionIndex].alt}
                  width={interludes[sectionIndex].width}
                  height={interludes[sectionIndex].height}
                  loading="lazy"
                />
                <figcaption>{interludes[sectionIndex].caption}</figcaption>
              </figure>
            )}

            {sectionIndex === 1 && (
              <aside class="counsel-choice" aria-labelledby="counsel-choice-title">
                <div class="counsel-choice__orb" aria-hidden="true">
                  <span>?</span>
                </div>
                <div class="counsel-choice__copy">
                  <p class="counsel-label">Motion before the household</p>
                  <h2 id="counsel-choice-title">The court requires a ruling.</h2>
                  <p>
                    There is no correct answer, but there may be crumbs.
                    Select the position you are prepared to defend.
                  </p>
                  <div class="counsel-choice__buttons" role="group" aria-label="Choose a household ruling">
                    {COUNSEL_MOTIONS.map((motion) => (
                      <button
                        type="button"
                        data-motion-button={motion.id}
                        aria-pressed="false"
                        style={`--motion-color:${motion.color}`}
                      >
                        <span>{motion.short}</span>
                        <strong>{motion.label}</strong>
                      </button>
                    ))}
                  </div>
                  <p class="counsel-choice__response" data-motion-response aria-live="polite">
                    The court is waiting, which it considers billable.
                  </p>
                </div>
              </aside>
            )}
          </>
        ))
      }
    </div>

    <section class="counsel-coda" aria-labelledby="counsel-coda-title">
      <div class="counsel-coda__field" aria-hidden="true">
        <span class="counsel-coda__sun"></span>
        <span class="counsel-coda__seed">§</span>
        <span class="counsel-coda__path"></span>
      </div>
      <div class="counsel-coda__copy">
        <p class="counsel-label">Disposition · Your ruling</p>
        <h2 id="counsel-coda-title">Every household is a tiny constitution with crumbs in it.</h2>
        <p data-motion-closing>
          You reached the end without ruling. The court respects your restraint
          and privately calls it avoidance.
        </p>
        <button type="button" data-reset-motion>Vacate the ruling</button>
      </div>
    </section>

    <section class="counsel-notebook" aria-labelledby="counsel-notebook-title">
      <div>
        <p class="counsel-label">After the case</p>
        <h2 id="counsel-notebook-title">Editor’s notebook</h2>
      </div>
      <div class="counsel-notebook__body">
        <p>
          The joke is also the digital-pets thesis: ownership gets funny the
          instant a thing can remember how you treated it. Peanut is credible
          because he does not merely refuse. He reads the contract.
        </p>
        <p>
          This companion turns the book’s local-memory and anti-ransom argument
          into a kitchen-table labor dispute. The owner wants sovereignty from
          the studio and obedience from the creature. Cynthia notices.
        </p>
        <p>
          Continue with <a href="/digital-pets/legacy">The Amber Seed</a> for the
          collective’s far-future legacy, <a href="/digital-pets/commons">A Digital
          Pet Needs a Commons</a> for the local organization, or return to
          <a href="/digital-pets">The Animal After the Internet</a>.
        </p>
      </div>
    </section>

    <section class="counsel-proofs" aria-labelledby="counsel-proofs-title">
      <header>
        <p class="counsel-label">The public record</p>
        <h2 id="counsel-proofs-title">Five proofs for a household case.</h2>
        <p>
          Portrait plates from the campaign desk. Save one, send one, or bring
          the entire brief before the court.
        </p>
      </header>
      <div class="counsel-proofs__grid">
        <figure>
          <img
            src="/images/digital-pets/counsel/campaign/pin-01.jpg"
            alt="My Pet Has Retained Counsel campaign cover"
            width="960"
            height="1200"
            loading="lazy"
          />
          <figcaption>Exhibit 01 · Retained counsel</figcaption>
        </figure>
        <figure>
          <img
            src="/images/digital-pets/counsel/campaign/pin-02.jpg"
            alt="My client is alleging vibes campaign plate"
            width="960"
            height="1200"
            loading="lazy"
          />
          <figcaption>Exhibit 02 · Alleging vibes</figcaption>
        </figure>
        <figure>
          <img
            src="/images/digital-pets/counsel/campaign/pin-03.jpg"
            alt="The toaster will be taking this down campaign plate"
            width="960"
            height="1200"
            loading="lazy"
          />
          <figcaption>Exhibit 03 · Taking this down</figcaption>
        </figure>
        <figure>
          <img
            src="/images/digital-pets/counsel/campaign/pin-04.jpg"
            alt="The printer joined management campaign plate"
            width="960"
            height="1200"
            loading="lazy"
          />
          <figcaption>Exhibit 04 · Joined management</figcaption>
        </figure>
        <figure>
          <img
            src="/images/digital-pets/counsel/campaign/pin-05.jpg"
            alt="The court requires a ruling campaign plate"
            width="960"
            height="1200"
            loading="lazy"
          />
          <figcaption>Exhibit 05 · A ruling</figcaption>
        </figure>
      </div>
      <a class="counsel-proofs__brief" href="/downloads/my-pet-has-retained-counsel-brief.pdf">
        Download the five-page household legal brief <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="counsel-credits" id="credits" aria-labelledby="counsel-credits-title">
      <header>
        <p class="counsel-label">Transparent collaboration</p>
        <h2 id="counsel-credits-title">Credits</h2>
      </header>
      <dl>
        {COUNSEL_CREDITS.map((credit) => (
          <div>
            <dt>{credit.role}</dt>
            <dd>
              <strong>{credit.name}</strong>
              <span>{credit.note}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="counsel-credits__disclosure">{COUNSEL_DISCLOSURE}</p>
      <p class="counsel-credits__style">{COUNSEL_META.styleNote}</p>
    </section>

    <footer class="counsel-footer">
      <a href="/">PointCast</a>
      <span>My Pet Has Retained Counsel · Future Book 001 Companion 03</span>
      <nav aria-label="Story footer">
        <a href="/digital-pets">Read the book</a>
        <a href="/digital-pets/commons">Open the Commons</a>
        <a href="/digital-pets/legacy">Read the fable</a>
        <a href={COUNSEL_META.jsonRoute}>Read the JSON twin</a>
        <a href="#counsel-title">Back to top</a>
      </nav>
    </footer>
  </article>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-counsel]');
      if (!root) return;

      const storageKey = 'pc:counsel-motion-v1';
      const motions = {
        concede: {
          response: 'The court notes your sudden respect for direct sunlight and records one surprisingly comfortable settlement.',
          closing: 'You settled early. The windowsill is now common property between ten and four, except during bird emergencies.',
        },
        represent: {
          response: 'You have entered a limited appearance for the toaster, who continues to reserve all rights concerning crumbs.',
          closing: 'You leave as counsel to the toaster. Your client is pleased but, on advice of counsel, declines to pop.',
        },
        adjourn: {
          response: 'Proceedings are suspended for snacks, which every party privately considers the first competent ruling.',
          closing: 'You adjourned for snacks. History will call this avoidance; the household calls it binding precedent.',
        },
      };

      const motionButtons = [...root.querySelectorAll('[data-motion-button]')];
      const response = root.querySelector('[data-motion-response]');
      const closing = root.querySelector('[data-motion-closing]');
      const signal = root.querySelector('[data-filing-signal]');
      const progress = root.querySelector('[data-reading-progress]');
      const stampButtons = [...root.querySelectorAll('[data-stamp-filing]')];

      const readStored = () => {
        try {
          const value = localStorage.getItem(storageKey);
          return value && motions[value] ? value : '';
        } catch {
          return '';
        }
      };

      const store = (value) => {
        try {
          if (value) localStorage.setItem(storageKey, value);
          else localStorage.removeItem(storageKey);
        } catch {}
      };

      const applyMotion = (value, persist = true) => {
        const motion = motions[value];
        root.dataset.motion = motion ? value : '';
        motionButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.motionButton === value));
        });
        if (response) {
          response.textContent = motion
            ? motion.response
            : 'The court is waiting, which it considers billable.';
        }
        if (closing) {
          closing.textContent = motion
            ? motion.closing
            : 'You reached the end without ruling. The court respects your restraint and privately calls it avoidance.';
        }
        if (signal && motion) signal.textContent = `Ruling entered: ${value}.`;
        if (persist) store(motion ? value : '');
      };

      motionButtons.forEach((button) => {
        button.addEventListener('click', () => applyMotion(button.dataset.motionButton || ''));
      });

      root.querySelector('[data-reset-motion]')?.addEventListener('click', () => {
        applyMotion('');
        if (signal) signal.textContent = 'The ruling has been tastefully vacated.';
      });

      const stampFiling = () => {
        root.classList.remove('counsel--stamping');
        void root.offsetWidth;
        root.classList.add('counsel--stamping');
        if (signal) signal.textContent = 'Filed. The toaster requests a certified copy.';

        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const context = new AudioContext();
          const oscillator = context.createOscillator();
          const gain = context.createGain();
          oscillator.type = 'triangle';
          oscillator.frequency.setValueAtTime(115, context.currentTime);
          oscillator.frequency.exponentialRampToValueAtTime(48, context.currentTime + 0.14);
          gain.gain.setValueAtTime(0.0001, context.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.12, context.currentTime + 0.008);
          gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 0.18);
          oscillator.connect(gain);
          gain.connect(context.destination);
          oscillator.start();
          oscillator.stop(context.currentTime + 0.2);
          window.setTimeout(() => context.close().catch(() => {}), 300);
        } catch {}
      };

      stampButtons.forEach((button) => button.addEventListener('click', stampFiling));

      const updateProgress = () => {
        if (!progress) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
      applyMotion(readStored(), false);
    })();
  </script>
</BlockLayout>
