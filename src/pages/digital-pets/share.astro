---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  DIGITAL_PETS_LAUNCH_SEQUENCE,
  DIGITAL_PETS_OUTREACH_NOTES,
  DIGITAL_PETS_PROMO_ANGLES,
  DIGITAL_PETS_PROMO_ASSETS,
  DIGITAL_PETS_PROMO_MEASURES,
  DIGITAL_PETS_PROMO_META,
  DIGITAL_PETS_SINGLE_POSTS,
  DIGITAL_PETS_X_THREAD,
} from '../../lib/digital-pets-promo';
import '../../styles/digital-pets-promo.css';

const absolute = (path: string) => new URL(path, 'https://pointcast.xyz').href;
const firstPost = DIGITAL_PETS_X_THREAD[0].text;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://pointcast.xyz/digital-pets/share#campaign',
  name: DIGITAL_PETS_PROMO_META.title,
  description: DIGITAL_PETS_PROMO_META.description,
  url: absolute(DIGITAL_PETS_PROMO_META.route),
  dateModified: DIGITAL_PETS_PROMO_META.updatedAt,
  isPartOf: {
    '@type': 'Book',
    '@id': 'https://pointcast.xyz/digital-pets#book',
    name: 'The Animal After the Internet',
  },
  about: [
    'digital pets',
    'AI ownership',
    'local-first software',
    'portable memory',
    'repairable hardware',
  ],
  creator: [
    { '@type': 'Person', name: 'Michael Hoydich' },
    { '@type': 'Organization', name: 'Codex / OpenAI' },
  ],
};
---

<BaseLayout
  title="Campaign Desk · The Animal After the Internet"
  description={DIGITAL_PETS_PROMO_META.description}
  image="/images/og/b/0514.png"
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="pet-promo">
    <header class="promo-masthead">
      <a href="/">PointCast</a>
      <span>Future Book 001 · Campaign Desk</span>
      <nav aria-label="Campaign utilities">
        <a href="/digital-pets">Read</a>
        <a href="/digital-pets/commons">Commons</a>
        <a href="/digital-pets/office">Office</a>
        <a href="/digital-pets/share.json">JSON</a>
        <a href="#copy">Copy</a>
      </nav>
    </header>

    <section class="promo-hero" aria-labelledby="promo-title">
      <div class="promo-hero__copy">
        <p class="promo-kicker">PROMOTE THE ARGUMENT · NOT THE CATEGORY</p>
        <h1 id="promo-title">Give people <em>one sentence</em> worth carrying.</h1>
        <p class="promo-hero__lede">
          The book is twelve positions. The campaign is three: personality
          survives Wi‑Fi, memory belongs in custody, and no subscription gets
          to decide whether the creature wakes up.
        </p>
        <div class="promo-actions">
          <a class="promo-button promo-button--dark" href={DIGITAL_PETS_PROMO_META.launchUrl} target="_blank" rel="noopener noreferrer">
            View live X thread
          </a>
          <button type="button" class="promo-button" data-copy={firstPost}>Copy first post</button>
          <button
            type="button"
            class="promo-button"
            data-native-share
            data-share-title="The Animal After the Internet"
            data-share-url={absolute('/digital-pets')}
          >
            Share book
          </button>
        </div>
        <p class="promo-hero__note">
          The seven-post thread is live. No paid media. No bulk blast. The
          six-week office now tracks narrow readers and manual signals.
        </p>
      </div>
      <figure class="promo-hero__art">
        <img
          src="/images/digital-pets/plate-03-memory.webp"
          alt="A soft digital creature surrounded by translucent memory vessels in a cobalt room"
          width="1024"
          height="1536"
          loading="eager"
        />
        <figcaption>
          <span>PLATE 03 / MEMORY CARRIES THE RELATIONSHIP</span>
          <span>OpenAI image generation · PointCast direction</span>
        </figcaption>
      </figure>
    </section>

    <section class="promo-section promo-section--angles" aria-labelledby="angles-title">
      <header class="promo-section__head">
        <p class="promo-kicker">THE THREE LINES</p>
        <h2 id="angles-title">A campaign people can repeat from memory.</h2>
      </header>
      <div class="promo-angle-grid">
        {DIGITAL_PETS_PROMO_ANGLES.map((angle, index) => (
          <article class="promo-angle">
            <div class="promo-angle__art">
              <img src={angle.image} alt={angle.alt} width="1024" height="1536" loading="lazy" />
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="promo-angle__copy">
              <p>{angle.label}</p>
              <h3>{angle.headline}</h3>
              <p>{angle.copy}</p>
              <div>
                <a href={angle.path}>Read chapter {angle.chapter}</a>
                <button type="button" data-copy={`${angle.headline}\n\n${angle.copy}\n\n${absolute(angle.path)}`}>
                  Copy angle
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="promo-section promo-section--thread" id="copy" aria-labelledby="thread-title">
      <header class="promo-section__head promo-section__head--split">
        <div>
          <p class="promo-kicker">LAUNCH THREAD · 7 POSTS</p>
          <h2 id="thread-title">The full argument, compressed without flattening it.</h2>
        </div>
        <button
          type="button"
          class="promo-button"
          data-copy={DIGITAL_PETS_X_THREAD.map((post) => `${post.number}/7\n${post.text}`).join('\n\n')}
        >
          Copy full thread
        </button>
      </header>
      <ol class="promo-thread">
        {DIGITAL_PETS_X_THREAD.map((post) => (
          <li>
            <div class="promo-thread__number">{post.number}/7</div>
            <p>{post.text}</p>
            <div class="promo-thread__foot">
              <span>{post.text.length} characters</span>
              <button type="button" data-copy={post.text}>Copy post</button>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="promo-section promo-section--singles" aria-labelledby="singles-title">
      <header class="promo-section__head">
        <p class="promo-kicker">STANDALONE SIGNALS</p>
        <h2 id="singles-title">Five posts for the days after launch.</h2>
      </header>
      <div class="promo-single-grid">
        {DIGITAL_PETS_SINGLE_POSTS.map((post) => (
          <article>
            <p class="promo-single__label">{post.label}</p>
            <p>{post.text}</p>
            <footer>
              <span>{post.text.length} characters</span>
              <button type="button" data-copy={post.text}>Copy</button>
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="promo-section promo-section--assets" aria-labelledby="assets-title">
      <header class="promo-section__head promo-section__head--split">
        <div>
          <p class="promo-kicker">ARTWORK</p>
          <h2 id="assets-title">Use one creature. Let repetition make it real.</h2>
        </div>
        <p>
          The campaign stays inside the book’s visual world. No disposable
          “launch aesthetic.”
        </p>
      </header>
      <div class="promo-asset-grid">
        {DIGITAL_PETS_PROMO_ASSETS.map((asset) => (
          <article>
            <img src={asset.path} alt="" loading="lazy" />
            <div>
              <p>{asset.kind}</p>
              <h3>{asset.label}</h3>
              <a href={asset.path} download>Download asset</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="promo-section promo-section--outreach" aria-labelledby="outreach-title">
      <header class="promo-section__head">
        <p class="promo-kicker">FIVE PEOPLE BEFORE FIVE THOUSAND</p>
        <h2 id="outreach-title">Send the chapter that matches the reader.</h2>
      </header>
      <div class="promo-outreach-list">
        {DIGITAL_PETS_OUTREACH_NOTES.map((note) => (
          <article>
            <p>{note.audience}</p>
            <h3>{note.subject}</h3>
            <blockquote>{note.note}</blockquote>
            <div>
              <a href={note.path}>Open chapter</a>
              <button
                type="button"
                data-copy={`Subject: ${note.subject}\n\n${note.note}\n\n${absolute(note.path)}`}
              >
                Copy note
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="promo-section promo-section--sequence" aria-labelledby="sequence-title">
      <div>
        <p class="promo-kicker">72-HOUR SHAPE</p>
        <h2 id="sequence-title">Launch once. Learn in public for four days.</h2>
        <ol>
          {DIGITAL_PETS_LAUNCH_SEQUENCE.map((step) => (
            <li class:list={[`is-${step.status}`]}>
              <span>{step.when}</span>
              <div>
                <h3>{step.move}</h3>
                <p>{step.reason}</p>
              </div>
              <small>{step.status}</small>
            </li>
          ))}
        </ol>
      </div>
      <aside>
        <p class="promo-kicker">COUNT THESE</p>
        <h2>Attention with evidence.</h2>
        <ul>
          {DIGITAL_PETS_PROMO_MEASURES.map((measure) => <li>{measure}</li>)}
        </ul>
        <p>
          The campaign does not claim attribution machinery it does not have.
          Michael reports saves, DMs, and replies; PointCast watches chapter
          entry paths and turns reactions into the next edit.
        </p>
      </aside>
    </section>

    <footer class="promo-footer">
      <div>
        <span>THE ANIMAL AFTER THE INTERNET</span>
        <p>
          Originated + edited by Michael Hoydich · manuscript, campaign system,
          and implementation by Codex / OpenAI · visual credits inside the book.
        </p>
      </div>
      <nav aria-label="Campaign end matter">
        <a href="/digital-pets">Read the book</a>
        <a href="/digital-pets/office">Run the six-week office</a>
        <a href="/digital-pets/share.json">Campaign JSON</a>
        <a href="/b/0514">Block 0514</a>
        <a href="/share">PointCast Share Kit</a>
      </nav>
    </footer>
  </main>

  <script is:inline>
    (function () {
      function mark(button, text) {
        var original = button.textContent;
        button.textContent = text;
        button.setAttribute('data-copied', 'true');
        window.setTimeout(function () {
          button.textContent = original;
          button.removeAttribute('data-copied');
        }, 1400);
      }

      function fallbackCopy(text) {
        var area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.top = '-9999px';
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        document.body.removeChild(area);
      }

      document.querySelectorAll('[data-copy]').forEach(function (button) {
        button.addEventListener('click', function () {
          var text = button.getAttribute('data-copy') || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () { mark(button, 'Copied'); },
              function () { fallbackCopy(text); mark(button, 'Copied'); },
            );
          } else {
            fallbackCopy(text);
            mark(button, 'Copied');
          }
        });
      });

      document.querySelectorAll('[data-native-share]').forEach(function (button) {
        if (!navigator.share) {
          button.textContent = 'Copy book URL';
        }
        button.addEventListener('click', function () {
          var title = button.getAttribute('data-share-title') || document.title;
          var url = button.getAttribute('data-share-url') || window.location.href;
          if (navigator.share) {
            navigator.share({ title: title, url: url }).catch(function () {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () { mark(button, 'Copied'); });
          } else {
            fallbackCopy(url);
            mark(button, 'Copied');
          }
        });
      });
    })();
  </script>
</BaseLayout>
