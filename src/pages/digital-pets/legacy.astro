---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  LEGACY_ART,
  LEGACY_CREDITS,
  LEGACY_DISCLOSURE,
  LEGACY_META,
  LEGACY_SECTIONS,
  LEGACY_VOWS,
} from '../../lib/digital-pets-legacy';
import '../../styles/digital-pets-legacy.css';

const storyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ShortStory',
  '@id': `https://pointcast.xyz${LEGACY_META.route}#story`,
  headline: LEGACY_META.title,
  alternativeHeadline: LEGACY_META.subtitle,
  description: LEGACY_META.description,
  image: `https://pointcast.xyz${LEGACY_ART.hero.src}`,
  datePublished: LEGACY_META.publishedAt,
  inLanguage: 'en-US',
  genre: ['Literary fiction', 'Philosophical fable', 'Speculative fiction'],
  isPartOf: {
    '@type': 'Book',
    name: 'The Animal After the Internet',
    url: 'https://pointcast.xyz/digital-pets',
  },
  author: [
    { '@type': 'Person', name: 'Michael Hoydich', url: 'https://pointcast.xyz/about' },
    { '@type': 'Organization', name: 'Codex / OpenAI', url: 'https://openai.com/codex/' },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  mainEntityOfPage: `https://pointcast.xyz${LEGACY_META.route}`,
  encoding: {
    '@type': 'MediaObject',
    contentUrl: `https://pointcast.xyz${LEGACY_META.jsonRoute}`,
    encodingFormat: 'application/json',
  },
};

const interludes = [
  LEGACY_ART.midjourney[0],
  LEGACY_ART.midjourney[1],
  LEGACY_ART.midjourney[2],
];
---

<BaseLayout
  title={`${LEGACY_META.title} · PointCast Fiction`}
  description={LEGACY_META.description}
  image={LEGACY_ART.hero.src}
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(storyJsonLd)} />

  <article class="legacy" data-legacy data-vow="">
    <div class="legacy__progress" aria-hidden="true">
      <span data-reading-progress></span>
    </div>

    <header class="legacy-masthead">
      <a class="legacy-masthead__brand" href="/">PointCast</a>
      <span class="legacy-masthead__desk">Fiction</span>
      <nav class="legacy-masthead__nav" aria-label="Story utilities">
        <a href="/digital-pets">The Book</a>
        <a href="/digital-pets/commons">The Commons</a>
        <a href={LEGACY_META.jsonRoute}>JSON</a>
      </nav>
    </header>

    <section class="legacy-hero" aria-labelledby="legacy-title">
      <img
        class="legacy-hero__image"
        src={LEGACY_ART.hero.src}
        alt={LEGACY_ART.hero.alt}
        width={LEGACY_ART.hero.width}
        height={LEGACY_ART.hero.height}
        loading="eager"
        fetchpriority="high"
      />
      <div class="legacy-hero__veil"></div>
      <div class="legacy-hero__copy">
        <p class="legacy-hero__rubric">Future Book 001 · Companion 02 · Fiction</p>
        <h1 id="legacy-title">{LEGACY_META.title}</h1>
        <p class="legacy-hero__dek">{LEGACY_META.subtitle}.</p>
        <div class="legacy-hero__byline">
          <span>By PointCast</span>
          <span>{LEGACY_META.readingTime}</span>
          <span>{LEGACY_META.setting}</span>
        </div>
      </div>
      <figcaption class="legacy-hero__caption">{LEGACY_ART.hero.caption}</figcaption>
    </section>

    <section class="legacy-intro" aria-label="Story introduction">
      <div class="legacy-intro__mark" aria-hidden="true">
        <span>PC</span>
        <i></i>
      </div>
      <div>
        <p class="legacy-intro__standfirst">
          In 2098, an archivist carries a dead animal to a house without a sign.
          What waits inside is not resurrection, but the stranger inheritance of
          a collective that learned how to disappear.
        </p>
        <p class="legacy-intro__credit">
          Michael Hoydich originated the Creature Commons world. Codex / OpenAI
          wrote and built this original philosophical fable. The artwork combines
          new OpenAI-generated editorial plates with Michael’s Midjourney archive.
        </p>
        <p class="legacy-intro__notice">{LEGACY_META.fictionNotice}</p>
      </div>
    </section>

    <aside class="legacy-seed legacy-seed--opening" aria-labelledby="seed-opening-title">
      <button class="legacy-seed__object" type="button" data-ring-seed aria-describedby="seed-opening-copy">
        <span aria-hidden="true"></span>
        <strong id="seed-opening-title">Ring the amber seed</strong>
        <small>Sound begins only when you ask.</small>
      </button>
      <p id="seed-opening-copy">
        The seed travels with the reader. Near the middle of the story, you will decide
        what kind of legacy it should carry. Your choice stays in this browser.
      </p>
      <span class="legacy-seed__signal" aria-live="polite" data-seed-signal></span>
    </aside>

    <div class="legacy-story">
      {
        LEGACY_SECTIONS.map((section, sectionIndex) => (
          <>
            <section
              class="legacy-section"
              id={section.slug}
              data-story-section
              data-section-label={`${section.number} · ${section.title}`}
              aria-labelledby={`${section.slug}-title`}
            >
              <header class="legacy-section__header">
                <span>{section.number}</span>
                <div>
                  <h2 id={`${section.slug}-title`}>{section.title}</h2>
                  <p>{section.dek}</p>
                </div>
              </header>

              <div class="legacy-section__body">
                {section.paragraphs.map((paragraph, paragraphIndex) => (
                  <>
                    <p class:list={[paragraphIndex === 0 && 'legacy-dropcap']}>{paragraph}</p>

                    {sectionIndex === 0 && paragraphIndex === 4 && (
                      <blockquote>
                        “We repair the promise before we repair the object.”
                      </blockquote>
                    )}

                    {sectionIndex === 1 && paragraphIndex === 3 && (
                      <figure class="legacy-cartoon legacy-cartoon--right">
                        <img
                          src={LEGACY_ART.cartoons[0].src}
                          alt={LEGACY_ART.cartoons[0].alt}
                          width={LEGACY_ART.cartoons[0].width}
                          height={LEGACY_ART.cartoons[0].height}
                          loading="lazy"
                        />
                        <figcaption>{LEGACY_ART.cartoons[0].caption}</figcaption>
                      </figure>
                    )}

                    {sectionIndex === 2 && paragraphIndex === 6 && (
                      <blockquote>
                        “If you demand that a seed preserve the exact shape of the parent,
                        you do not want a seed. You want a monument.”
                      </blockquote>
                    )}

                    {sectionIndex === 2 && paragraphIndex === 7 && (
                      <figure class="legacy-cartoon legacy-cartoon--left">
                        <img
                          src={LEGACY_ART.cartoons[1].src}
                          alt={LEGACY_ART.cartoons[1].alt}
                          width={LEGACY_ART.cartoons[1].width}
                          height={LEGACY_ART.cartoons[1].height}
                          loading="lazy"
                        />
                        <figcaption>{LEGACY_ART.cartoons[1].caption}</figcaption>
                      </figure>
                    )}

                    {sectionIndex === 3 && paragraphIndex === 7 && (
                      <blockquote>
                        The legacy lived without announcing itself: in open screws,
                        carried memory, visible seams, a body given another season,
                        a body allowed to rest.
                      </blockquote>
                    )}
                  </>
                ))}
              </div>
            </section>

            {sectionIndex < 3 && (
              <figure class:list={['legacy-interlude', `legacy-interlude--${interludes[sectionIndex].id}`]}>
                <div class="legacy-interlude__number" aria-hidden="true">
                  0{sectionIndex + 1}
                </div>
                <img
                  src={interludes[sectionIndex].src}
                  alt={interludes[sectionIndex].alt}
                  width={interludes[sectionIndex].width}
                  height={interludes[sectionIndex].height}
                  loading="lazy"
                />
                <figcaption>{interludes[sectionIndex].caption}</figcaption>
              </figure>
            )}

            {sectionIndex === 1 && (
              <aside class="legacy-choice" aria-labelledby="legacy-choice-title">
                <div class="legacy-choice__orb" aria-hidden="true"><span></span></div>
                <div class="legacy-choice__copy">
                  <p class="legacy-label">A small decision for the reader</p>
                  <h2 id="legacy-choice-title">What should the seed carry forward?</h2>
                  <p>
                    No answer is treated as a score. Choose the promise you would
                    defend when continuation, memory, and mercy point in different directions.
                  </p>
                  <div class="legacy-choice__buttons" role="group" aria-label="Choose a legacy promise">
                    {LEGACY_VOWS.map((vow) => (
                      <button
                        type="button"
                        data-vow-button={vow.id}
                        aria-pressed="false"
                        style={`--vow-color:${vow.color}`}
                      >
                        <span>{vow.short}</span>
                        <strong>{vow.label}</strong>
                      </button>
                    ))}
                  </div>
                  <p class="legacy-choice__response" data-vow-response aria-live="polite">
                    The seed is still uncommitted.
                  </p>
                </div>
              </aside>
            )}
          </>
        ))
      }
    </div>

    <section class="legacy-coda" aria-labelledby="legacy-coda-title">
      <div class="legacy-coda__field" aria-hidden="true">
        <span class="legacy-coda__sun"></span>
        <span class="legacy-coda__seed"></span>
        <span class="legacy-coda__path"></span>
      </div>
      <div class="legacy-coda__copy">
        <p class="legacy-label">Coda · The seed you carried</p>
        <h2 id="legacy-coda-title">A legacy is a promise that survives its container.</h2>
        <p data-vow-closing>
          You carried an uncommitted seed to the end. It remains open for the next keeper.
        </p>
        <button type="button" data-reset-vow>Return the seed</button>
      </div>
    </section>

    <section class="legacy-notebook" aria-labelledby="legacy-notebook-title">
      <div>
        <p class="legacy-label">After the story</p>
        <h2 id="legacy-notebook-title">Editor’s notebook</h2>
      </div>
      <div class="legacy-notebook__body">
        <p>
          This story imagines the best possible legacy for Creature Commons:
          not permanent institutional grandeur, but promises that become so
          normal they no longer require the original name.
        </p>
        <p>
          The collective’s five proposed rooms become the story’s civic customs:
          the Bench repairs, the Library carries memory, the Clinic keeps bodies
          in use, the Press preserves disagreement, and the Graveyard makes endings
          deliberate.
        </p>
        <p>
          The story is not a forecast or organizational claim. It is a pressure test:
          if the Commons succeeded completely, what would remain after the organization
          itself was gone?
        </p>
      </div>
    </section>

    <section class="legacy-credits" id="credits" aria-labelledby="legacy-credits-title">
      <header>
        <p class="legacy-label">Transparent collaboration</p>
        <h2 id="legacy-credits-title">Credits</h2>
      </header>
      <dl>
        {LEGACY_CREDITS.map((credit) => (
          <div>
            <dt>{credit.role}</dt>
            <dd>
              <strong>{credit.name}</strong>
              <span>{credit.note}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="legacy-credits__disclosure">{LEGACY_DISCLOSURE}</p>
      <p class="legacy-credits__style">{LEGACY_META.styleNote}</p>
    </section>

    <footer class="legacy-footer">
      <a href="/">PointCast</a>
      <span>The Amber Seed · Future Book 001 Companion 02</span>
      <nav aria-label="Story footer">
        <a href="/digital-pets">Read the book</a>
        <a href="/digital-pets/commons">Open the Commons</a>
        <a href={LEGACY_META.jsonRoute}>Read the JSON twin</a>
        <a href="#legacy-title">Back to top</a>
      </nav>
    </footer>
  </article>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-legacy]');
      if (!root) return;

      const storageKey = 'pc:amber-seed-v1';
      const vows = {
        mend: {
          response: 'You chose the bench: continuity through repair, visible seams, and another useful season.',
          closing: 'You carry the seed as a repairer: not to erase the break, but to give the break a future.',
        },
        carry: {
          response: 'You chose the library: continuity through portable memory, shared knowledge, and second keepers.',
          closing: 'You carry the seed as an archivist: lightly enough that another hand can carry it after you.',
        },
        release: {
          response: 'You chose the graveyard: continuity through dignified endings, recovered parts, and permission to stop.',
          closing: 'You carry the seed as a witness: knowing that care is not proved by making everything last forever.',
        },
      };

      const vowButtons = [...root.querySelectorAll('[data-vow-button]')];
      const response = root.querySelector('[data-vow-response]');
      const closing = root.querySelector('[data-vow-closing]');
      const signal = root.querySelector('[data-seed-signal]');
      const progress = root.querySelector('[data-reading-progress]');
      const ringButtons = [...root.querySelectorAll('[data-ring-seed]')];

      const readStored = () => {
        try {
          const value = localStorage.getItem(storageKey);
          return value && vows[value] ? value : '';
        } catch {
          return '';
        }
      };

      const store = (value) => {
        try {
          if (value) localStorage.setItem(storageKey, value);
          else localStorage.removeItem(storageKey);
        } catch {}
      };

      const applyVow = (value, persist = true) => {
        const vow = vows[value];
        root.dataset.vow = vow ? value : '';
        vowButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.vowButton === value));
        });
        if (response) {
          response.textContent = vow ? vow.response : 'The seed is still uncommitted.';
        }
        if (closing) {
          closing.textContent = vow
            ? vow.closing
            : 'You carried an uncommitted seed to the end. It remains open for the next keeper.';
        }
        if (signal && vow) signal.textContent = `The seed now carries: ${value}.`;
        if (persist) store(vow ? value : '');
      };

      vowButtons.forEach((button) => {
        button.addEventListener('click', () => applyVow(button.dataset.vowButton || ''));
      });

      root.querySelector('[data-reset-vow]')?.addEventListener('click', () => {
        applyVow('');
        if (signal) signal.textContent = 'The seed is open again.';
      });

      const ringSeed = () => {
        root.classList.remove('legacy--ringing');
        void root.offsetWidth;
        root.classList.add('legacy--ringing');
        if (signal) signal.textContent = 'The seed answers with three quiet tones.';

        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const context = new AudioContext();
          const gain = context.createGain();
          gain.gain.setValueAtTime(0.0001, context.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.065, context.currentTime + 0.03);
          gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 1.35);
          gain.connect(context.destination);
          [523.25, 659.25, 783.99].forEach((frequency, index) => {
            const oscillator = context.createOscillator();
            oscillator.type = 'sine';
            oscillator.frequency.value = frequency;
            oscillator.connect(gain);
            oscillator.start(context.currentTime + index * 0.16);
            oscillator.stop(context.currentTime + 0.85 + index * 0.16);
          });
          window.setTimeout(() => context.close().catch(() => {}), 1700);
        } catch {}
      };

      ringButtons.forEach((button) => button.addEventListener('click', ringSeed));

      const updateProgress = () => {
        if (!progress) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
      applyVow(readStored(), false);
    })();
  </script>
</BaseLayout>
