---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COUNSEL_META } from '../../../lib/digital-pets-counsel';
import '../../../styles/digital-pets-counsel-proofs.css';

const proofs = [
  {
    src: '/images/digital-pets/counsel/campaign/pin-01.jpg',
    number: '01',
    title: 'Retained counsel',
    alt: 'My Pet Has Retained Counsel campaign cover',
  },
  {
    src: '/images/digital-pets/counsel/campaign/pin-02.jpg',
    number: '02',
    title: 'Alleging vibes',
    alt: 'My client is alleging vibes campaign plate',
  },
  {
    src: '/images/digital-pets/counsel/campaign/pin-03.jpg',
    number: '03',
    title: 'Taking this down',
    alt: 'The toaster will be taking this down campaign plate',
  },
  {
    src: '/images/digital-pets/counsel/campaign/pin-04.jpg',
    number: '04',
    title: 'Joined management',
    alt: 'The printer joined management campaign plate',
  },
  {
    src: '/images/digital-pets/counsel/campaign/pin-05.jpg',
    number: '05',
    title: 'A ruling',
    alt: 'The court requires a ruling campaign plate',
  },
];

const galleryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'My Pet Has Retained Counsel — The Public Record',
  description: 'Five portrait campaign plates from the PointCast domestic comedy.',
  url: 'https://pointcast.xyz/digital-pets/counsel/proofs/',
  isPartOf: {
    '@type': 'ShortStory',
    name: COUNSEL_META.title,
    url: `https://pointcast.xyz${COUNSEL_META.route}`,
  },
  image: proofs.map((proof) => `https://pointcast.xyz${proof.src}`),
  author: {
    '@type': 'Person',
    name: 'Michael Hoydich',
  },
};
---

<BaseLayout
  title="The Public Record · My Pet Has Retained Counsel"
  description="Five portrait campaign plates from the PointCast domestic comedy."
  image={proofs[0].src}
  hideNav={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(galleryJsonLd)} />

  <main class="proof-desk">
    <header class="proof-desk__masthead">
      <a href="/">PointCast</a>
      <span>Public Record · Comedy Desk</span>
      <nav aria-label="Public record utilities">
        <a href={COUNSEL_META.route}>Read the case</a>
        <a href="/downloads/my-pet-has-retained-counsel-brief.pdf">Brief PDF</a>
      </nav>
    </header>

    <section class="proof-desk__intro" aria-labelledby="proof-desk-title">
      <p>Future Book 001 · Companion 03 · Campaign proofs</p>
      <h1 id="proof-desk-title">Five exhibits.<br />One household case.</h1>
      <div>
        <p>
          Portrait plates from <em>My Pet Has Retained Counsel</em>. Save one,
          send one, or bring the complete brief before the court.
        </p>
        <p>Michael Hoydich × Codex / OpenAI · PointCast, El Segundo.</p>
      </div>
    </section>

    <section class="proof-desk__grid" aria-label="Campaign proof plates">
      {proofs.map((proof) => (
        <figure>
          <img
            src={proof.src}
            alt={proof.alt}
            width="960"
            height="1200"
          />
          <figcaption>
            <span>Exhibit {proof.number}</span>
            <strong>{proof.title}</strong>
          </figcaption>
        </figure>
      ))}
    </section>

    <footer class="proof-desk__footer">
      <p>Filed for public circulation · no neutral appliance</p>
      <a href={COUNSEL_META.route}>Enter the household case <span aria-hidden="true">→</span></a>
    </footer>
  </main>
</BaseLayout>
