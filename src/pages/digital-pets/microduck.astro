  <script is:inline>
    function mountMicroduckFeature() {
      const page = document.querySelector('[data-microduck-page]');
      if (!page || page.dataset.microduckMounted === 'true') return;
      page.dataset.microduckMounted = 'true';

      const shellNames = ['cream', 'graphite', 'lavender', 'sky'];
      const shellButtons = Array.from(page.querySelectorAll('[data-shell]'));
      shellButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const shell = button.dataset.shell;
          shellNames.forEach((name) => page.classList.remove(`shell-${name}`));
          page.classList.add(`shell-${shell}`);
          shellButtons.forEach((candidate) => {
            candidate.setAttribute('aria-pressed', candidate === button ? 'true' : 'false');
          });
        });
      });

      const missionButtons = Array.from(page.querySelectorAll('[data-mission]'));
      const goal = page.querySelector('[data-mission-goal]');
      const verbs = page.querySelector('[data-mission-verbs]');
      const build = page.querySelector('[data-mission-build]');
      const reward = page.querySelector('[data-mission-reward]');
      const gate = page.querySelector('[data-mission-gate]');

      missionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          missionButtons.forEach((candidate) => {
            candidate.setAttribute('aria-selected', candidate === button ? 'true' : 'false');
          });
          if (goal) goal.textContent = `“${button.dataset.goal}”`;
          if (build) build.textContent = button.dataset.build || '';
          if (reward) reward.textContent = button.dataset.reward || '';
          if (gate) gate.textContent = button.dataset.gate || '';
          if (verbs) {
            const values = JSON.parse(button.dataset.verbs || '[]');
            verbs.replaceChildren(...values.map((value) => {
              const code = document.createElement('code');
              code.textContent = value;
              return code;
            }));
          }
        });
      });
    }

    document.addEventListener('astro:page-load', mountMicroduckFeature);
    mountMicroduckFeature();
  </script>
</BaseLayout>
