---
/**
 * /check-in/ — PointCast's check-in. The card is the shared one from the El Segundo
 * network, mounted inline here; every check-in leaves a coarse postmark and shows in
 * the merged network feed. No followers: you subscribe to a stream.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
const feed = 'https://elsegundo.xyz/api/v1/stamps';
---
<BlockLayout title="Check in · PointCast" description="Answer today's call from wherever you are. A coarse postmark, a public tally, and feeds to subscribe. No account." noindex={true}>
  <main class="pc-checkin">
    <p class="pc-checkin__eyebrow">PointCast · check-in</p>
    <h1>Check in from anywhere.</h1>
    <p>Answer today's call, or check in from somewhere else with a town or ZIP and a line about what you're up to. It leaves a postmark with the local time, the weather, the tide when there's one nearby, and sunset.</p>
    <div data-geostamp></div>
    <h2>Subscribe</h2>
    <ul>
      <li><a href={feed + '/feed.json?site=pointcast'}>PointCast check-ins, JSON Feed</a></li>
      <li><a href={feed + '/feed.xml?site=pointcast'}>PointCast check-ins, Atom</a></li>
      <li><a href={feed + '/feed.json'}>The whole network</a></li>
      <li>MCP: <code>read_checkins</code> on <code>https://elsegundo.xyz/mcp</code></li>
      <li><a href="https://elsegundo.xyz/checkins/">The live feed</a> · <a href="/check-in/format/">The Here format</a></li>
    </ul>
    <p class="pc-checkin__note">Places are towns or ZIPs, never streets or GPS. Names and status lines show only if you choose. No IP, cookie or email is stored. Skip it any time.</p>
  </main>
</BlockLayout>
<style>
  .pc-checkin { max-width: 40rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .pc-checkin h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: .2rem 0 1rem; }
  .pc-checkin h2 { margin-top: 2.5rem; font-size: 1.1rem; }
  .pc-checkin__eyebrow { font-family: 'JetBrains Mono Variable', monospace; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .pc-checkin__note { margin-top: 2rem; font-size: .85rem; opacity: .75; }
  .pc-checkin [data-geostamp] { margin: 1.5rem 0; }
</style>
