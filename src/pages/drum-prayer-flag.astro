---
/**
 * /drum-prayer-flag — nine flags on a wire.
 *
 * Mike: "ok keep going" after the shrine + rosary + koan trio. Adds
 * a saturated-color visual to the velvet wing. Nine triangular pixel
 * flags strung horizontally, each carrying a Noun head, swaying with
 * a gentle CSS wind animation. Click any flag to raise it (lift +
 * brief brass glow + a single bell pitch unique to that flag's slot).
 *
 * Flags rotate daily in lock-step with /drum-shrine (UTC day-of-year
 * mix), so today's row is shared globally — the same nine Nouns for
 * every visitor today. Tomorrow's are different.
 *
 * Pure static, no API.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Prayer Flags · Nine in the Wind · PointCast';
const description =
  'Nine pixel-art prayer flags strung on a wire, each with a Noun. Swaying in the wind. Click a flag to raise it.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Prayer Flags',
  url: 'https://pointcast.xyz/drum-prayer-flag',
  description,
  applicationCategory: 'MultimediaApplication',
};

// Nine flag color slots — saturated, in order of a stylized rainbow
// + black, white, gold (so all nine feel distinct).
const FLAG_COLORS = [
  { fill: '#c4351c', name: 'crimson' },
  { fill: '#d4a437', name: 'gold'    },
  { fill: '#c9982a', name: 'amber'   },
  { fill: '#0d8c5e', name: 'green'   },
  { fill: '#0c5da8', name: 'cobalt'  },
  { fill: '#5a2e8e', name: 'violet'  },
  { fill: '#d6346a', name: 'magenta' },
  { fill: '#3aa9c4', name: 'cyan'    },
  { fill: '#f4e7c8', name: 'cream'   },
];

// Placeholder seeds for SSR (overwritten by JS on hydrate)
const SSR_SEEDS = [42, 156, 411, 678, 805, 96, 234, 1100, 808];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dpf" id="dpf-main">
    <DrumNav current="prayer-flag" />

    <header class="dpf__header">
      <div class="dpf__chrome">
        <span>NINE FLAGS</span>
        <span class="dpf__chrome-sep">·</span>
        <span id="dpf-day">DAY ---</span>
        <span class="dpf__chrome-sep">·</span>
        <span id="dpf-raises">0 RAISES</span>
      </div>
      <h1 class="dpf__title">PRAYER FLAGS</h1>
      <p class="dpf__tagline">nine on a wire — the wind blows the Nouns</p>
    </header>

    <section class="dpf__sky" aria-label="Click a flag to raise it">
      <!-- Wire across the top -->
      <div class="dpf__wire"></div>
      <div class="dpf__row">
        {FLAG_COLORS.map((c, i) => (
          <button class="dpf__flag" type="button" data-idx={i} aria-label={`Flag ${i + 1}, ${c.name}`}>
            <div class="dpf__flag-tie"></div>
            <svg class="dpf__flag-svg" viewBox="0 0 60 80" shape-rendering="crispEdges" aria-hidden="true">
              <!-- Triangular flag silhouette -->
              <path d="M 0 4 L 60 4 L 60 60 L 30 80 L 0 60 Z" fill={c.fill}/>
              <!-- subtle inner border -->
              <path d="M 4 8 L 56 8 L 56 58 L 30 75 L 4 58 Z" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1"/>
              <!-- Noun image lives in the flag's belly via overlaid <img> outside SVG so it can be inlined dynamically -->
            </svg>
            <img class="dpf__flag-noun" src={`https://noun.pics/${SSR_SEEDS[i]}.svg`} alt="" data-seed-slot={i} />
          </button>
        ))}
      </div>
    </section>

    <footer class="dpf__readout">
      <p class="dpf__caption">click a flag · each color holds a different bell tone · raises persist this session</p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dpf-main) {
    background: #0c0410;
  }

  .dpf {
    --dpf-velvet: #1a0820;
    --dpf-velvet-deep: #0c0410;
    --dpf-brass: #d4a437;
    --dpf-brass-soft: #b8862c;
    --dpf-brass-deep: #6b4d12;
    --dpf-flame: #f6c15e;
    --dpf-ink-light: #f4e7c8;
    --dpf-ink-mid: #c9b78c;
    --dpf-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dpf-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--dpf-velvet) 0%, var(--dpf-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .dpf::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 30px 30px, rgba(212, 164, 55, 0.08) 1.5px, transparent 2px);
    background-size: 130px 130px;
    opacity: 0.4;
    z-index: -1;
  }
  .dpf .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .dpf__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(16px, 2vh, 28px);
  }
  .dpf__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px;
    border: 1.5px solid var(--dpf-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dpf-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .dpf__chrome-sep { color: var(--dpf-brass-deep); }
  #dpf-day, #dpf-raises { color: var(--dpf-flame); font-weight: 700; }
  .dpf__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 76px);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--dpf-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--dpf-velvet-deep);
  }
  .dpf__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--dpf-ink-mid);
  }

  /* Sky — the field */
  .dpf__sky {
    position: relative;
    width: 100%;
    min-height: clamp(280px, 42vh, 480px);
    margin: clamp(20px, 3vh, 36px) 0 clamp(20px, 3vh, 36px);
    padding: 30px 16px 40px;
    background: linear-gradient(180deg, rgba(26, 8, 32, 0.6) 0%, rgba(12, 4, 16, 0.95) 100%);
    border-top: 1px solid rgba(212, 164, 55, 0.18);
    border-bottom: 1px solid rgba(212, 164, 55, 0.18);
    overflow: hidden;
  }
  .dpf__wire {
    position: absolute;
    top: 50px;
    left: 6%;
    right: 6%;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--dpf-brass-deep) 8%, var(--dpf-brass-deep) 92%, transparent 100%);
  }

  .dpf__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(4px, 1vw, 16px);
    padding: 50px clamp(2%, 6vw, 5%) 0;
    flex-wrap: nowrap;
  }

  .dpf__flag {
    position: relative;
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    width: clamp(50px, 9vw, 84px);
    aspect-ratio: 60 / 90;
    transform-origin: 50% 0%;
    animation: dpf-sway var(--sway-dur, 4s) ease-in-out var(--sway-delay, 0s) infinite;
    transition: filter 220ms;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.45));
  }
  /* Each flag gets a slightly different sway timing so the row doesn't move in lock-step */
  .dpf__flag:nth-child(1) { --sway-dur: 3.6s; --sway-delay: 0.0s; }
  .dpf__flag:nth-child(2) { --sway-dur: 4.2s; --sway-delay: 0.3s; }
  .dpf__flag:nth-child(3) { --sway-dur: 3.8s; --sway-delay: 0.6s; }
  .dpf__flag:nth-child(4) { --sway-dur: 4.4s; --sway-delay: 0.1s; }
  .dpf__flag:nth-child(5) { --sway-dur: 3.4s; --sway-delay: 0.4s; }
  .dpf__flag:nth-child(6) { --sway-dur: 4.0s; --sway-delay: 0.2s; }
  .dpf__flag:nth-child(7) { --sway-dur: 3.7s; --sway-delay: 0.5s; }
  .dpf__flag:nth-child(8) { --sway-dur: 4.3s; --sway-delay: 0.0s; }
  .dpf__flag:nth-child(9) { --sway-dur: 3.5s; --sway-delay: 0.3s; }

  @keyframes dpf-sway {
    0%, 100% { transform: rotate(-3deg) translateY(0); }
    25%      { transform: rotate(2deg)  translateY(-2px); }
    50%      { transform: rotate(4deg)  translateY(0); }
    75%      { transform: rotate(-1deg) translateY(-3px); }
  }

  .dpf__flag:hover {
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 16px rgba(246, 193, 94, 0.35));
  }
  .dpf__flag.dpf__flag--raised {
    animation: dpf-raise 0.9s ease-out 1, dpf-sway var(--sway-dur, 4s) ease-in-out 0.9s infinite;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 24px rgba(246, 193, 94, 0.65));
  }
  @keyframes dpf-raise {
    0%   { transform: rotate(-3deg) translateY(0); }
    30%  { transform: rotate(0deg) translateY(-22px) scale(1.1); }
    100% { transform: rotate(-3deg) translateY(0) scale(1); }
  }

  /* Tie — small line connecting flag to wire */
  .dpf__flag-tie {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 16px;
    background: var(--dpf-brass-deep);
  }

  .dpf__flag-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .dpf__flag-noun {
    position: absolute;
    top: 16%;
    left: 24%;
    width: 52%;
    aspect-ratio: 1;
    image-rendering: pixelated;
    pointer-events: none;
    transition: opacity 220ms;
  }

  /* Readout */
  .dpf__readout {
    text-align: center;
    padding: clamp(6px, 1vh, 14px) 0;
  }
  .dpf__caption {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: var(--dpf-ink-dim);
  }
</style>

<script>
  // ── Audio ────────────────────────────────────────────
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  // 9 pentatonic + extra notes per flag, ascending
  const NOTES = [392.00, 440.00, 523.25, 587.33, 659.25, 783.99, 880.00, 1046.50, 1318.51];

  function playFlagBell(idx) {
    const a = ctx(); const t = a.currentTime;
    const f = NOTES[idx] ?? NOTES[0];
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.24, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.08, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 1.0);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.7); o2.start(t); o2.stop(t + 1.1);
  }

  // ── Day-of-year deterministic Nouns ─────────────────
  function dayOfYearUTC() {
    const now = new Date();
    const start = Date.UTC(now.getUTCFullYear(), 0, 0);
    const diff = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - start;
    return Math.floor(diff / 86400000);
  }
  function todaysFlagSeeds() {
    const yr = new Date().getUTCFullYear();
    const doy = dayOfYearUTC();
    // Mix per-slot — 9 distinct seeds based on yr + doy + slot index
    const seeds = [];
    for (let i = 0; i < 9; i++) {
      const s = (yr * 7 + doy * 13 + i * 97) % 1200;
      seeds.push(s);
    }
    return seeds;
  }

  // ── State ────────────────────────────────────────────
  let raises = 0;

  const flagEls = Array.from(document.querySelectorAll('.dpf__flag'));
  const dayEl = document.getElementById('dpf-day');
  const raisesEl = document.getElementById('dpf-raises');

  function paintCounters() {
    if (raisesEl) raisesEl.textContent = `${raises} RAISES`;
  }

  function bootstrap() {
    const doy = dayOfYearUTC();
    if (dayEl) dayEl.textContent = `DAY ${doy}`;
    const seeds = todaysFlagSeeds();
    flagEls.forEach((flag, i) => {
      const img = flag.querySelector('.dpf__flag-noun');
      if (img) img.src = `https://noun.pics/${seeds[i]}.svg`;
    });
    paintCounters();
  }

  flagEls.forEach((flag, i) => {
    flag.addEventListener('click', () => {
      try { playFlagBell(i); } catch {}
      flag.classList.remove('dpf__flag--raised');
      void flag.offsetWidth;
      flag.classList.add('dpf__flag--raised');
      setTimeout(() => flag.classList.remove('dpf__flag--raised'), 900);
      raises += 1;
      paintCounters();
    });
  });

  bootstrap();
</script>
