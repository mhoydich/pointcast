      ctx.beginPath(); ctx.moveTo(W / 3, HUD); ctx.lineTo(W / 3, H); ctx.moveTo((2 * W) / 3, HUD); ctx.lineTo((2 * W) / 3, H); ctx.moveTo(W / 3, HUD + (H - HUD) * 0.5); ctx.lineTo((2 * W) / 3, HUD + (H - HUD) * 0.5); ctx.stroke();
      ctx.setLineDash([]);
      const mid = HUD + (H - HUD) / 2;
      if (COARSE) {
        text('TURN', W / 6, mid - 12, 2, lite(), 'center'); text('LEFT', W / 6, mid + 2, 2, lite(), 'center');
        text('TURN', (5 * W) / 6, mid - 12, 2, lite(), 'center'); text('RIGHT', (5 * W) / 6, mid + 2, 2, lite(), 'center');
        text('TAP TO FIRE', W / 2, HUD + 30, 2, m.paddle, 'center');
        text('HOLD TO PUSH', W / 2, H - 40, 2, m.paddle, 'center');
      } else {
        text('ARROWS OR WASD', W / 2, HUD + 30, 2, lite(), 'center');
        text('TURN AND PUSH', W / 2, HUD + 44, 2, lite(), 'center');
        text('SPACE FIRES', W / 2, H - 40, 2, m.paddle, 'center');
      }
      ctx.globalAlpha = 1;
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawTitle() {
      const m = M();
      drawAttract(0.35);
      // The name in the machine's own light blue, outlined pixel by pixel.
      text('DRIFTWOOD', W / 2, 92, 6, m.text, 'center');
      text('ASTEROIDS ON THE WATER', W / 2, 150, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 170, 2, m.bright, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 186, 2, m.bright, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY' : 'TAP OR PRESS SPACE', W / 2, 250, 2, m.paddle, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, 280, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 26, 2, m.dim, 'center');
    }
    function drawOver() {
      const m = M();
      const sim = G.sim;
      drawAttract(0.3);
      text('GAME OVER', W / 2, 118, 5, m.bright, 'center');
      text(`SCORE ${String(sim.score).padStart(6, '0')}`, W / 2, 172, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 188, 2, m.bands.yellow, 'center');
      text(`FIELDS ${sim.fieldIndex + 1}  PEAK ${mood.peak}`, W / 2, 204, 2, lite(), 'center');
      text(`LOGS ${sim.hits}  SPLITS ${sim.splits}`, W / 2, 220, 2, lite(), 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY AGAIN' : 'TAP OR SPACE TO PLAY AGAIN', W / 2, 262, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawWater();
      if (G.phase === 'title') { drawTitle(); return; }
      if (G.phase === 'over') { drawHud(); drawOver(); return; }
      drawHud();
      if (G.sim) drawField(1);
      drawHints();
      const m = M();
      if (G.phase === 'paused') { text('PAUSED', W / 2, 200, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 232, 2, m.paddle, 'center'); }
      if (G.msgT > 0 && G.msg) text(G.msg, W / 2, 196, G.msgScale, m.bright, 'center');
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) {
        G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0;
        // The RUSH glow is the one expensive draw. Three slow readings in a row while it is on turn it off for the session.
        if (G.phase === 'play' && response.label === 'RUSH' && !G.noGlow) { G.slowFrames = G.fps < 45 ? G.slowFrames + 1 : 0; if (G.slowFrames >= 3) G.noGlow = true; }
      }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const playing = G.phase === 'play' || G.phase === 'paused';
        const s = G.sim ? simSummary(G.sim) : null;
        readout.mood.textContent = `${playing ? response.label : 'ATTRACT'} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${playing ? response.tempo : 96} BPM ${playing ? response.scale.toUpperCase() : 'MAJOR'}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.vec.textContent = s && playing ? `V ${Math.round(G.sim.boat.vx)},${Math.round(G.sim.boat.vy)} LOGS ${s.logs}` : 'V 0,0';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return true; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return true; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); return true; }
      return false;
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      if (action()) return;
      if (G.phase !== 'play') return;
      const p = pointerToField(e);
      const zone = zoneOf(clamp(p.x, 0, W), clamp(p.y, HUD, H));
      G.touches.set(e.pointerId, zone);
      // A tap in the fire zone fires at once; held, it keeps firing at the limited rate.
      if (zone === 'fire') G.fireTap = 0.05;
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!G.touches.has(e.pointerId) || G.phase !== 'play') return;
      const p = pointerToField(e);
      G.touches.set(e.pointerId, zoneOf(clamp(p.x, 0, W), clamp(p.y, HUD, H)));
    });
    const release = (e) => { G.touches.delete(e.pointerId); };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('lostpointercapture', release);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; arrows and letters still steer from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (k === 'ArrowLeft' || k === 'ArrowRight' || k === 'ArrowUp' || k === 'ArrowDown' || k === 'KeyA' || k === 'KeyD' || k === 'KeyW' || k === 'KeyS') { G.keys[k] = true; e.preventDefault(); audio.unlock(); return; }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); if (!action() && k === 'Space' && !e.repeat) { G.keys.Space = true; G.fireTap = 0.05; } return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function clearHeld() { G.keys = {}; G.touches.clear(); G.fireTap = 0; audio.thrust(false); }
    function togglePause() {
      if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; clearHeld(); audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearHeld();
        if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', clearHeld);
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      if (G.sim && !G.over) {
        // CALM mid-game lifts the boat count; leaving CALM gives three boats to go on with.
        if (DIALS[next].unlimitedBalls) G.sim.lives = Infinity;
        else if (!Number.isFinite(G.sim.lives) || G.sim.lives <= 0) G.sim.lives = 3;
      }
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${DIALS[next].blurb}`);
      showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space fires again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
    // ?debug exposes the state for the headless smoke check and for QA; it changes nothing on its own.
    if (new URLSearchParams(location.search).has('debug')) {
      window.__driftwood = { G, mood, action, cycleDial, setMachine, force: (input) => { G.forced = input; }, response: () => response, dial: () => mood.dial };
    }
  }
</script>
