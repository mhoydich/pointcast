---
/**
 * /driftwood — Asteroids on the water.
 *
 * Brief by Michael Hoydich, 2026-10-22: 80s innocence, the joy of the compute
 * and flow, mood-state symbiosis, mobile and full screen, audio-visual
 * multimedia, Atari and Commodore inspired, rendered modern. Thread 5 of the
 * five sibling games that followed Breakwater.
 *
 * A small boat in the middle of a dark field, driftwood logs instead of rocks
 * that split big to medium to small, wrap at every edge, inertia with no
 * friction, a limited rate of flare shots, a tide bird for bonus points.
 * Drawn vector style: stroked polygons in the machine's text color. Every
 * sound is synthesized. Pure logic lives in src/lib/driftwood (field, sim),
 * the mood model and the pixel font are shared with Breakwater, and
 * tests/driftwood.test.mjs plays a whole field headless.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';

const description = 'Asteroids on the water: a small boat on a dark field, driftwood logs that split big to medium to small, screen wrap, no friction, a limited flare rate and a tide bird for bonus points. Atari 800XL or Commodore 64 colors, synthesized sound, and a mood the game and you keep together.';
const canonical = 'https://pointcast.xyz/driftwood';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Driftwood',
      alternateName: 'Driftwood: Asteroids on the water',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/driftwood/og.png',
      gamePlatform: 'Web browser',
      genre: 'Multidirectional shooter',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Driftwood', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Driftwood"
  description={description}
  image="/images/driftwood/og.png"
  imageAlt="A dark blue field with jagged outlined driftwood logs, a small outlined boat and flare dots beside the words Driftwood, Asteroids on the water."
  themeColor="#0e1a40"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/driftwood.json', title: 'Driftwood rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/driftwood/og.png',
    buttons: [
      { label: 'Play Driftwood', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="dw" data-dw data-machine="xl" data-crt="on">
    <div class="dw-stage" data-stage>
      <header class="dw-bar">
        <a class="dw-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="dw-name" aria-hidden="true">DRIFTWOOD</span>
        <div class="dw-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="dw-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Driftwood field. Turn the boat, push, and fire flares at the logs. Tap or press space to start."></canvas>
        <div class="dw-scan" aria-hidden="true"></div>
        <noscript><p class="dw-noscript">Driftwood needs JavaScript to draw the water and make its sounds. The rules and moods are readable at <a href="/driftwood.json">/driftwood.json</a>.</p></noscript>
      </div>
      <footer class="dw-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-wave>FIELD 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-vec>V 0,0</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="dw-notes">
      <p class="dw-eyebrow">PointCast / Games / Driftwood</p>
      <h1>Asteroids on the water.</h1>
      <p class="dw-lede">A small boat in the middle of a dark field. Logs drift in from every side, split when a flare hits them, and come back around the edge you watched them leave by. Nothing slows down unless you make it.</p>

      <div class="dw-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Hits raise its <strong>energy</strong>. A collision lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="dw-moods">
            <li><b>DAWN</b> warming up. Cool colors, the heartbeat slow, four logs.</li>
            <li><b>FLOW</b> a long run of hits. Brighter lines, the heartbeat opens up.</li>
            <li><b>RUSH</b> glow on every line, a faster heartbeat, more logs on the next field, and the tide bird comes often.</li>
            <li><b>DRIFT</b> after a loss. The logs slow, the shield lasts longer, flares come faster, the sound thins out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.id === 'calm' ? 'no game over; a collision resets you with a shield' : d.id === 'play' ? 'three boats, an extra boat every 2000 points' : 'starts hot, leans into the bird and the extra logs'}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave after a game, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'Lines in the Graphics 0 light blue on a night version of its blue field, a black border. Raw square and noise voices, in the POKEY spirit. A blue READY and a RUN before the water.' : 'Lines in the C64 light blue on a night version of its blue field, inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The pixel font, the log outlines, the heartbeat and the palettes were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-driftwood-notes.md">research note on Asteroids and its home ports</a>, play <a href="/breakwater">Breakwater</a>, the first game in this row, or visit the <a href="/atari-bbs">Death Star BBS</a>, Mike's own Atari 8-bit history.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>A big log is 20, a medium 50, a small 100, the tide bird 200, the arcade's own numbers. Big splits into two medium, medium into two small, small is gone. Clear the field for 100 and the next one brings a log more. Up to five flares in the air, four shots a second at most. Three boats; an extra boat every 2000 points; no game over on CALM.</p>
          <h2>Controls</h2>
          <ul>
            <li>Touch: the left third of the water turns the boat left, the right third turns it right, the lower middle pushes, and a tap in the upper middle fires. The field names the zones the first time you play.</li>
            <li>Keys: ← → or A D turn, ↑ or W pushes, Space fires, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="dw-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026, thread 5 of 5. Original code, art and synthesized sound; no ROMs, no recordings. Machine names are tributes.</p>
        <p><a href="/driftwood.json">driftwood.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .dw { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .dw[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .dw-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .dw-stage:fullscreen { height: 100%; min-height: 0; }
  .dw-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .dw-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .dw-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .dw-home:hover { color: #fff; }
  .dw-name { color: #fff; font-weight: 700; margin-right: auto; }
  .dw-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .dw-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .dw-controls button:hover { background: #1f2456; }
  .dw-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .dw-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .dw-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .dw-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .dw-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .dw[data-crt='off'] .dw-scan { display: none; }
  .dw-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .dw-noscript a { color: var(--paddle); }
  .dw-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .dw-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .dw-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .dw-readout a:hover { color: #fff; }
  .dw-stage:fullscreen .dw-readout a { display: none; }
  .dw-stage:-webkit-full-screen .dw-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .dw-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .dw-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .dw-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .dw-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .dw-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .dw-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .dw-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .dw-grid h2 + h2, .dw-grid p + h2, .dw-grid ul + h2 { margin-top: 22px; }
  .dw-grid p { margin: 0 0 12px; }
  .dw-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .dw-grid li { margin-bottom: 6px; }
  .dw-moods { list-style: none; padding: 0; }
  .dw-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .dw-notes a { color: #a9b9f5; }
  .dw-notes a:hover { color: #fff; }
  .dw-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .dw-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .dw-stage { min-height: 0; }
    .dw-bar { gap: 8px; padding: 6px 10px; }
    .dw-name { display: none; }
    .dw-controls { gap: 4px; }
    .dw-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .dw-readout { gap: 10px; font-size: 9px; height: 26px; }
    .dw-readout [data-r-vec], .dw-readout [data-r-fps] { display: none; }
    .dw-grid { grid-template-columns: 1fr; gap: 20px; }
    .dw-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .dw-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { FIELD_W, FIELD_TOP, FIELD_H_MIN, FIELD_H_MAX, BOAT_POLY, worldPoly, makeRng, buildField, makeBoat, integrate, wrap, images } from '../lib/driftwood/field.mjs';
  import { createSim, stepSim, resizeSim, simSummary } from '../lib/driftwood/sim.mjs';

  const root = document.querySelector('[data-dw]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = FIELD_W, H_MIN = FIELD_H_MIN, H_MAX = FIELD_H_MAX, HUD = FIELD_TOP, WALL = 8;
    let H = H_MIN;
    const STORE = 'driftwood:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      wave: root.querySelector('[data-r-wave]'),
      fps: root.querySelector('[data-r-fps]'),
      vec: root.querySelector('[data-r-vec]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) ? settings.best : 0;
    let hintsSeen = Number.isFinite(settings.hints) ? settings.hints : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, hints: hintsSeen, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const night = () => mix(M().field, '#000000', 0.66);
    // Secondary in-field text: the machine's light blue lifted toward white so it clears AA on the night field.
    const lite = () => mix(M().text, '#ffffff', 0.4);
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music, thrustGain = null, thrustSrc = null, birdOsc = null, birdGain = null;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextBeat = 0, beat = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // The two-note heartbeat: a low thump and a lower one. The interval is the mood tempo in half notes.
      const BEATS = { major: [45, 40], bright: [47, 42], minor: [44, 38], soft: [43, 40] };
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.4; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      let noiseBuf = null;
      function noiseBuffer() {
        if (noiseBuf) return noiseBuf;
        const len = ac.sampleRate;
        noiseBuf = ac.createBuffer(1, len, ac.sampleRate);
        const d = noiseBuf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = Math.random() * 2 - 1;
        return noiseBuf;
      }
      function noise(t, dur = 0.05, vol = 0.12, { freq = 2400, q = 0.8, type = 'bandpass', slide = 0, dest = sfx } = {}) {
        if (!ac) return;
        const s = ac.createBufferSource(); s.buffer = noiseBuffer(); s.loop = true;
        const f = ac.createBiquadFilter(); f.type = type; f.frequency.setValueAtTime(freq, t); f.Q.value = q;
        if (slide) f.frequency.exponentialRampToValueAtTime(Math.max(40, freq * slide), t + dur);
        const g = ac.createGain();
        g.gain.setValueAtTime(vol, t);
        g.gain.linearRampToValueAtTime(0.0001, t + dur);
        s.connect(f); f.connect(g); g.connect(dest); s.start(t); s.stop(t + dur + 0.02);
      }
      function playBeat(k, t) {
        const notes = BEATS[scale] || BEATS.major;
        const n = notes[k % 2];
        const vol = scale === 'soft' ? 0.16 : 0.22 + 0.1 * density;
        voice({ freq: midi(n), type: machineId === 'c64' ? 'triangle' : 'square', t, dur: 0.11, vol, slide: 0.7, dest: music, r: 0.06 });
        if (machineId === 'xl') noise(t, 0.03, 0.04, { freq: 180, q: 1.2, type: 'lowpass', dest: music });
      }
      function schedule() {
        if (!ac || !musicOn) return;
        // A throttled interval (hidden tab) must not replay every missed beat as one burst.
        if (nextBeat < ac.currentTime - 0.1) { nextBeat = ac.currentTime + 0.05; beat += 1; }
        while (nextBeat < ac.currentTime + 0.14) {
          playBeat(beat, nextBeat);
          nextBeat += (60 / tempo) * 2;
          beat += 1;
        }
      }
      function setMusic(on) {
        wantMusic = on;
        if (!ac) return;
        if (on && !musicOn) { musicOn = true; nextBeat = ac.currentTime + 0.05; beat = 0; clearInterval(timer); timer = setInterval(schedule, 30); }
        else if (!on && musicOn) { musicOn = false; clearInterval(timer); }
        if (!on) { thrust(false); bird(false); }
      }
      function thrust(on) {
