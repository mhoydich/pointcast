          ctx.globalAlpha = 1;
        } else if (kind === 'median') {
          for (let i = 0; i < 3; i += 1) drawSprite('palm', 24 + i * 96 + 8, spriteTop(r), 3, pal);
        } else if (kind === 'sand' && r === 1) {
          ctx.fillStyle = m.bright; ctx.globalAlpha = 0.18;
          for (let x = 10; x < W; x += 37) ctx.fillRect(x, y + Math.round(h / 2) - 6 + (x % 3) * 6, 2, 2);
          ctx.globalAlpha = 1;
        }
      }
      // Lifeguard towers in the water row.
      for (let i = 0; i < TOWER_COLS.length; i += 1) {
        const x = TOWER_COLS[i] * CELL, y = spriteTop(0);
        drawSprite(G.run && G.run.towers[i] ? 'towerHome' : 'tower', x, y, 3, pal);
      }
      if (G.flash > 0) { ctx.globalAlpha = Math.min(REDUCED ? 0.12 : 0.5, G.flash); ctx.fillStyle = m.bright; ctx.fillRect(0, 0, W, H); ctx.globalAlpha = 1; }
    }
    function drawLanes(pal, alpha = 1) {
      if (!G.run) return;
      ctx.globalAlpha = alpha;
      for (const lane of G.run.lanes) {
        const top = spriteTop(lane.row);
        for (const v of lane.vehicles) {
          if (!v.active || !onScreen(v)) continue;
          const x = screenX(v);
          const flip = lane.dir < 0;
          if (v.kind === 'bus') drawSprite('bus', Math.round(x), top + 2, 3, pal, { flip }, v.variant);
          else if (v.kind === 'car') drawSprite('car', Math.round(x), top + 2, 3, pal, { flip }, v.variant);
          else if (v.kind === 'bike') drawSprite('bike', Math.round(x - 2), top, 3, pal, { flip }, v.variant);
          else drawSprite('skate', Math.round(x - 3), top, 3, pal, { flip }, v.variant);
        }
      }
      ctx.globalAlpha = 1;
    }
    function drawPlayer(pal, alpha = 1) {
      if (!G.run) return;
      const run = G.run, p = run.player;
      ctx.globalAlpha = alpha;
      if (run.ball) drawSprite('ball', run.ball.col * CELL, spriteTop(1), 3, pal);
      const c = playerCenter();
      const x = Math.round(c.x - 12), y = Math.round(c.y - 12);
      if (G.hitAt && G.hitAt.kind === 'hit') { drawSprite('splat', x, y, 3, pal); ctx.globalAlpha = 1; return; }
      if (G.hitAt && G.hitAt.kind === 'splash') { ctx.globalAlpha = alpha * (G.t < 0.4 ? 0.6 : 0.2); drawSprite('walker', x, y + 6, 3, pal, { rot: 2 }); ctx.globalAlpha = 1; return; }
      if (p.row === 0 && !run.alive) { ctx.globalAlpha = 1; return; }
      const rot = p.facing === 'right' ? 1 : p.facing === 'down' ? 2 : p.facing === 'left' ? 3 : 0;
      drawSprite(p.hopT > 0 ? 'walkerHop' : 'walker', x, y, 3, pal, { rot });
      if (run.carrying) drawSprite('ball', x + (p.facing === 'left' ? -10 : 10), y - 8, 2, pal);
      for (const q of G.particles) {
        ctx.globalAlpha = alpha * (1 - q.t / q.life);
        ctx.fillStyle = q.color;
        ctx.fillRect(Math.round(q.x), Math.round(q.y), 2, 2);
      }
      ctx.globalAlpha = 1;
    }
    function drawHud(pal) {
      const m = M();
      const run = G.run;
      text(String(run ? run.score : 0).padStart(6, '0'), 10, 8, 3, m.bright);
      const label = G.attract ? 'ATTRACT' : response.label;
      const col = G.attract ? m.dim : label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : label === 'DRIFT' ? m.text : m.bands.green;
      text(label, W / 2 + 10, 11, 2, col, 'center');
      if (!G.attract && run) {
        if (run.lives === Infinity) text('CALM', W - 10, 11, 2, m.text, 'right');
        else { for (let i = 0; i < Math.min(run.lives, 6); i += 1) { ctx.fillStyle = m.bands.red; ctx.fillRect(W - 10 - (i + 1) * 8, 10, 4, 3); ctx.fillStyle = m.paddle; ctx.fillRect(W - 10 - (i + 1) * 8, 13, 4, 3); } }
      }
      // mood tape along the top edge
      if (!G.attract && mood.tape.length) {
        const n = Math.min(60, mood.tape.length), start = mood.tape.length - n;
        for (let i = 0; i < n; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(8 + i * 3, HUD - 6, 2, 2);
        }
      }
      // the crossing clock
      ctx.fillStyle = m.border === '#000000' ? '#0b0d1a' : mix(m.border, '#000000', 0.6);
      ctx.fillRect(0, TIMER_Y, W, TIMER_H);
      if (run && !G.attract) {
        const frac = clamp(run.timer / Math.max(1, run.timerMax), 0, 1);
        const barW = W - 20 - 44;
        ctx.fillStyle = m.dim; ctx.fillRect(10, TIMER_Y + 12, barW, 8);
        ctx.fillStyle = run.timer <= 5 ? m.bands.red : frac > 0.5 ? m.bands.green : m.bands.yellow;
        ctx.fillRect(10, TIMER_Y + 12, Math.round(barW * frac), 8);
        text('TIME', W - 10, TIMER_Y + 11, 2, m.text, 'right');
      } else {
        if (G.attract) text('2026 HOYDICH / POINTCAST', W / 2, TIMER_Y + 11, 2, m.text, 'center');
      }
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawTitle(pal) {
      const m = M();
      drawLanes(pal, 0.35); drawPlayer(pal, 0.35);
      ctx.fillStyle = m.field; ctx.globalAlpha = 0.55; ctx.fillRect(0, 70, W, 150); ctx.globalAlpha = 1;
      rainbowText('CROSSWALK', W / 2, 86, 6, [m.bands.red, m.bands.orange, m.bands.yellow, m.bands.green]);
      text('FIVE LANES TO THE SAND', W / 2, 142, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 162, 2, m.bright, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 178, 2, m.bright, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY' : 'TAP OR PRESS SPACE', W / 2, 200, 2, m.paddle, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, 260, 2, m.bright, 'center');
    }
    function drawOver(pal) {
      const m = M();
      drawLanes(pal, 0.35); drawPlayer(pal, 0.35);
      ctx.fillStyle = m.field; ctx.globalAlpha = 0.6; ctx.fillRect(0, 100, W, 180); ctx.globalAlpha = 1;
      text('GAME OVER', W / 2, 118, 5, m.bright, 'center');
      text(`SCORE ${String(G.run.score).padStart(6, '0')}`, W / 2, 172, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 188, 2, m.bands.yellow, 'center');
      text(`TOWERS ${G.run.crossings}  STAGE ${G.run.stage + 1}  PEAK ${mood.peak}`, W / 2, 204, 2, m.text, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY AGAIN' : 'TAP OR SPACE TO PLAY AGAIN', W / 2, 256, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      const pal = palette();
      // Vehicles enter and leave at the edges and the water drifts, so everything is clipped to the field.
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, W, H); ctx.clip();
      drawField(pal);
      if (G.phase === 'title') { drawHud(pal); drawTitle(pal); ctx.restore(); return; }
      if (G.phase === 'over') { drawHud(pal); drawOver(pal); ctx.restore(); return; }
      drawLanes(pal, 1); drawPlayer(pal, 1); drawHud(pal);
      ctx.restore();
      const m = M();
      if (G.phase === 'play' && G.t < 2 && G.run.hops === 0 && G.run.crossings === 0 && G.run.stage === 0 && Math.floor(G.t * 2) % 2 === 0 && G.msgT <= 0) text(COARSE ? 'SWIPE OR TAP TO HOP' : 'ARROWS TO HOP', W / 2, rowY(4) + 10, 2, m.bright, 'center');
      if (G.phase === 'paused') { text('PAUSED', W / 2, 180, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 212, 2, m.paddle, 'center'); }
      if (G.msgT > 0 && G.msg) text(G.msg, W / 2, 196, G.msgScale, m.bright, 'center');
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        readout.mood.textContent = `${G.attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${G.attract ? 104 : response.tempo} BPM ${G.attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.fps.textContent = `${G.fps} FPS`;
        if (G.run && !G.attract) readout.lane.textContent = `${laneName(G.run.player.row)} T${Math.ceil(G.run.timer)}`;
        else readout.lane.textContent = 'SIDEWALK';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return true; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return true; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); return true; }
      return false;
    }
    /** A tap hops toward the side of the beach-goer it landed on; a swipe hops its way. */
    function gestureDir(down, up) {
      const dx = up.cx - down.cx, dy = up.cy - down.cy;
      if (Math.hypot(dx, dy) >= 18) return Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : dy > 0 ? 'down' : 'up';
      const p = pointerToField(up);
      const c = playerCenter();
      const ox = p.x - c.x, oy = p.y - c.y;
      return Math.abs(oy) > Math.abs(ox) ? (oy > 0 ? 'down' : 'up') : ox > 0 ? 'right' : 'left';
    }
    let down = null;
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      down = { id: e.pointerId, cx: e.clientX, cy: e.clientY, clientX: e.clientX, clientY: e.clientY };
      if (action()) down = null;
    });
    canvas.addEventListener('pointerup', (e) => {
      if (!down || down.id !== e.pointerId) return;
      const start = down, up = { cx: e.clientX, cy: e.clientY, clientX: e.clientX, clientY: e.clientY };
      down = null;
      if (G.phase !== 'play') return;
      audio.unlock();
      tryHop(gestureDir(start, up));
    });
    canvas.addEventListener('pointercancel', () => { down = null; });
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    const HOP_KEYS = { ArrowUp: 'up', KeyW: 'up', ArrowDown: 'down', KeyS: 'down', ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right' };
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; arrows and letters still hop from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (HOP_KEYS[k]) {
        e.preventDefault(); audio.unlock();
        if (!e.repeat) { G.keys[k] = true; if (G.phase === 'play') { tryHop(HOP_KEYS[k]); G.keys.held = false; setTimeout(() => { if (G.keys[k]) G.keys.held = true; }, 220); } else if (G.phase === 'title' || G.phase === 'over' || G.phase === 'boot') action(); }
        return;
      }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); action(); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; if (!Object.keys(HOP_KEYS).some((k) => G.keys[k])) G.keys.held = false; });
    function togglePause() {
      if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        G.keys = {}; down = null;
        if (G.phase === 'play') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', () => { G.keys = {}; });
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      if (G.run && !G.attract) {
        if (response.unlimitedBalls) G.run.lives = Infinity;
        else if (G.run.lives === Infinity) G.run.lives = 3;
        traffic = trafficFromResponse(response, G.run.pace);
      }
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${DIAL_NOTES[next]}`);
      showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space starts again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
