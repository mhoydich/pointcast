---
/**
 * /crosswalk — a Frogger for the El Segundo strand.
 *
 * Brief by Michael Hoydich, 2026-10-22: 80s innocence, the joy of the compute
 * and flow, mood-state symbiosis, mobile and full screen, audio-visual
 * multimedia, Atari and Commodore inspired, rendered modern. Thread 4 of 5.
 *
 * A beach-goer starts on the sidewalk, crosses five lanes of traffic, rests on
 * the median, crosses the bike path and the sand, and reaches the water at one
 * of four lifeguard towers. Everything is chunky 8x8 sprites from rects in the
 * machine palette, drawn on a canvas with the shared 3x5 font; every sound is
 * synthesized. Pure logic lives in src/lib/crosswalk (field, rules, sprites)
 * and is covered by tests/crosswalk.test.mjs. The mood model, font and
 * palettes are imported from src/lib/breakwater unchanged.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { DIAL_NOTES, SCORE } from '../lib/crosswalk/rules.mjs';

const description = 'A Frogger for the El Segundo strand: sidewalk, five lanes of cars, a bus, skateboards and bikes, the median, the bike path, the sand, and four lifeguard towers to reach. Atari 800XL or Commodore 64 palette, synthesized chip sound, and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/crosswalk';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Crosswalk',
      alternateName: 'Crosswalk: five lanes to the sand',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/crosswalk/og.png',
      gamePlatform: 'Web browser',
      genre: 'Lane crossing',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Crosswalk', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Crosswalk"
  description={description}
  image="/images/crosswalk/og.png"
  imageAlt="A blue playfield of lanes with chunky cars, a bus and bikes, a beach-goer on the sidewalk and four red lifeguard towers at the water, beside the words Crosswalk, five lanes to the sand."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/crosswalk.json', title: 'Crosswalk rules, lanes, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/crosswalk/og.png',
    buttons: [
      { label: 'Play Crosswalk', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="cw" data-cw data-machine="xl" data-crt="on">
    <div class="cw-stage" data-stage>
      <header class="cw-bar">
        <a class="cw-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="cw-name" aria-hidden="true">CROSSWALK</span>
        <div class="cw-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="cw-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Crosswalk playfield. Hop with the arrow keys or swipe; reach a lifeguard tower before the clock runs out."></canvas>
        <div class="cw-scan" aria-hidden="true"></div>
        <noscript><p class="cw-noscript">Crosswalk needs JavaScript to run the lanes and make its sounds. The rules and moods are readable at <a href="/crosswalk.json">/crosswalk.json</a>.</p></noscript>
      </div>
      <footer class="cw-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-stage>STAGE 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-lane>SIDEWALK</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="cw-notes">
      <p class="cw-eyebrow">PointCast / Games / Crosswalk</p>
      <h1>Five lanes to the sand.</h1>
      <p class="cw-lede">Sidewalk, street, median, bike path, sand, water. Four lifeguard towers to reach before the clock runs out, and a street that answers how you cross it. Pick the blue you grew up with.</p>

      <div class="cw-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Every safe hop forward and every lane cleared raise its <strong>energy</strong>. A hit or a timeout lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="cw-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major arpeggio, an ordinary street.</li>
            <li><b>FLOW</b> a long run of safe hops. Bright colors, the music opens up.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, faster lanes, tighter gaps, and a beach ball on the sand worth {SCORE.ball} at a tower.</li>
            <li><b>DRIFT</b> after hits. The traffic thins, the gaps widen, the clock gives you longer, the notes thin out.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({DIAL_NOTES[d.id].toLowerCase().replace(/\.$/, '')}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue text. Raw square waves with a noise bite, in the POKEY spirit. A blue READY and a RUN before the street.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The sprites are rects in the machine palette, the pixel font is the one Breakwater drew, and the music and sound were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-crosswalk-notes.md">research note on Frogger and its home ports</a>, or play <a href="/breakwater">Breakwater</a>, the first cabinet in this row.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>{SCORE.hop} points for every new row reached. A tower pays {SCORE.tower} plus {SCORE.perSecond} for each second left on the clock. Fill all four towers for {SCORE.stage} and the next stage: every lane a little faster, the clock a little shorter, every direction reversed. Thirty seconds a crossing to start. Three beach-goers, one more every {SCORE.extraEvery} points; no game over on CALM. Water between the towers is a splash.</p>
          <h2>Controls</h2>
          <ul>
            <li>Swipe anywhere on the field to hop, or tap above, below, left or right of the beach-goer.</li>
            <li>Keys: arrows or W A S D hop, Space starts, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="cw-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026, thread 4 of 5. Original code, art and synthesized sound; no ROMs, no recordings, no copied sprites. Frogger is Konami's 1981 game, published in arcades by Sega/Gremlin; this is a tribute to its shape, set on a street in El Segundo.</p>
        <p><a href="/crosswalk.json">crosswalk.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .cw { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .cw[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .cw-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .cw-stage:fullscreen { height: 100%; min-height: 0; }
  .cw-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .cw-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .cw-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .cw-home:hover { color: #fff; }
  .cw-name { color: #fff; font-weight: 700; margin-right: auto; }
  .cw-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .cw-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .cw-controls button:hover { background: #1f2456; }
  .cw-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .cw-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .cw-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .cw-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .cw-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .cw[data-crt='off'] .cw-scan { display: none; }
  .cw-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .cw-noscript a { color: var(--paddle); }
  .cw-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .cw-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .cw-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .cw-readout a:hover { color: #fff; }
  .cw-stage:fullscreen .cw-readout a { display: none; }
  .cw-stage:-webkit-full-screen .cw-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cw-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .cw-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .cw-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .cw-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .cw-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .cw-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .cw-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .cw-grid h2 + h2, .cw-grid p + h2, .cw-grid ul + h2 { margin-top: 22px; }
  .cw-grid p { margin: 0 0 12px; }
  .cw-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .cw-grid li { margin-bottom: 6px; }
  .cw-moods { list-style: none; padding: 0; }
  .cw-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .cw-notes a { color: #a9b9f5; }
  .cw-notes a:hover { color: #fff; }
  .cw-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .cw-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .cw-stage { min-height: 0; }
    .cw-bar { gap: 8px; padding: 6px 10px; }
    .cw-name { display: none; }
    .cw-controls { gap: 4px; }
    .cw-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .cw-readout { gap: 10px; font-size: 9px; height: 26px; }
    .cw-readout [data-r-lane], .cw-readout [data-r-fps] { display: none; }
    .cw-grid { grid-template-columns: 1fr; gap: 20px; }
    .cw-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .cw-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { W, H as H_BASE, COLS, CELL, ROWS, ROW_KINDS, HUD, TIMER_H, TOWER_COLS, VEHICLES, layoutFor, screenX, onScreen, laneAt } from '../lib/crosswalk/field.mjs';
  import { SCORE, DIAL_NOTES, HOP_TIME, trafficFromResponse, createRun, resetCrossing, placeBall, hop, stepRun, loseLife, checkExtraLife, nextStage, cellSafeIn, cellIsSafe } from '../lib/crosswalk/rules.mjs';
  import { eachSpriteCell } from '../lib/crosswalk/sprites.mjs';

  const root = document.querySelector('[data-cw]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const STORE = 'crosswalk:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;
    // A tall phone gets taller lanes (layoutFor); the rules only ever see row indexes.
    let L = layoutFor(H_BASE), H = L.H, TIMER_Y = L.timerY;
    const rowY = (r) => L.rowY(r);
    const rowHeight = (r) => L.rowHeight(r);
    /** Top of a 24 px sprite centered in row `r`. */
    const spriteTop = (r) => rowY(r) + Math.round((rowHeight(r) - 24) / 2);

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      stage: root.querySelector('[data-r-stage]'),
      fps: root.querySelector('[data-r-fps]'),
      lane: root.querySelector('[data-r-lane]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) ? settings.best : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    let traffic = trafficFromResponse(response);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    // Hex out, so a mixed color can be mixed again (the mood tones the row colors a second time).
    const rgb = (c) => `#${c.map((v) => clamp(Math.round(v), 0, 255).toString(16).padStart(2, '0')).join('')}`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // A walking bass and a skipping lead: the tune of crossing a street on a sunny day.
      const PROG = {
        major: [[60, 64, 67, 69], [65, 69, 72, 74], [67, 71, 74, 76], [60, 64, 67, 72]],
        bright: [[62, 66, 69, 73], [64, 68, 71, 76], [67, 71, 74, 78], [62, 66, 69, 74]],
        minor: [[57, 60, 64, 67], [53, 57, 60, 64], [55, 58, 62, 65], [52, 55, 59, 64]],
        soft: [[60, 67, 72, 74], [57, 64, 69, 71], [53, 60, 65, 67], [55, 62, 67, 69]],
      };
      const ARP = [0, 2, 1, 3, 0, 3, 2, 1];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, freq = 2400) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const lead = () => 'square';
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        if (idx % 4 === 0) voice({ freq: midi(chord[(idx / 4) % 2 === 0 ? 0 : 2] - 24), type: bass(), t, dur: 0.18, vol: 0.17, dest: music, r: 0.06 });
        const gate = scale === 'soft' ? 0.3 : 0.5 + density * 0.5;
        if (idx % 2 === 0 && Math.random() < gate) {
