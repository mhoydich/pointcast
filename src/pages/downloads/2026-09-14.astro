---
import BlockLayout from '../../layouts/BlockLayout.astro';
import collection from '../../data/coastal-camps.json';

const title = 'Coastal Camps — September 14 downloads';
const description = 'Four seaside camps and one hummingbird. Download five original 1024 × 1024 PNGs, individually or as a complete set.';
const megabytes = (bytes: number) => `${(bytes / 1_000_000).toFixed(1)} MB`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: title,
  description,
  url: collection.canonical,
  associatedMedia: collection.images.map((art) => ({
    '@type': 'ImageObject',
    name: `${title} — ${art.title}`,
    description: art.alt,
    contentUrl: `https://pointcast.xyz${art.download}`,
    thumbnailUrl: `https://pointcast.xyz${art.preview}`,
    encodingFormat: 'image/png',
    width: art.width,
    height: art.height,
    contentSize: String(art.bytes),
    creditText: collection.credit,
  })),
};
---

<BlockLayout title={title} description={description} image="/images/og/b/0588.png" imageWidth={1200} imageHeight={630} jsonLd={jsonLd} hideAds={true} alternates={[{ type: 'application/json', href: '/downloads/2026-09-14.json', title: 'Coastal Camps image catalog' }]}>
  <div class="gardens">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">PointCast</a><span aria-hidden="true">/</span><span>Art downloads</span></nav>
    <header class="intro">
      <div>
        <p class="eyebrow">TODAY’S DOWNLOADS · 14 SEPTEMBER 2026</p>
        <h1>Coastal Camps</h1>
        <p class="dek">Four seaside camps and one hummingbird.</p>
        <p class="details">Five original PNGs. 1024 × 1024 pixels each. Free to download.</p>
      </div>
      <a class="download set-download" href={collection.archive.url} download="coastal-camps.zip" data-astro-reload>
        <span>Download all five <span aria-hidden="true">↓</span></span>
        <small>ZIP · {megabytes(collection.archive.bytes)}</small>
      </a>
    </header>

    <section class="gallery" aria-label="Coastal Camps artwork">
      {collection.images.map((art, index) => (
        <figure>
          <img src={art.preview} alt={art.alt} width="1024" height="1024" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          <figcaption>
            <div class="caption"><span class="number">0{art.number}</span><h2>{art.title}</h2></div>
            <p class="file-details">Original PNG · 1024 × 1024 · {megabytes(art.bytes)}</p>
            <a class="download single-download" href={art.download} download={art.filename} data-astro-reload aria-label={`Download ${art.title} as an original PNG`}>Download PNG <span aria-hidden="true">↓</span></a>
          </figcaption>
        </figure>
      ))}
    </section>
    <footer class="colophon"><p>{collection.credit}</p><a href="/spaceship-gardens/">Yesterday: Spaceship Gardens <span aria-hidden="true">↗</span></a><a href="/b/0588">PointCast № 0588 <span aria-hidden="true">↗</span></a></footer>
  </div>
</BlockLayout>

<style>
  .gardens { width: min(1440px, 100%); margin: 0 auto; padding: 32px clamp(20px, 4vw, 64px) 72px; color: #18291e; }
  .crumb { display: flex; gap: 12px; align-items: center; font-size: 13px; margin-bottom: 48px; }
  .crumb a { color: inherit; }
  .intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; border-bottom: 1px solid #cbd8c5; padding-bottom: 32px; }
  .eyebrow, .number, .file-details, .colophon { font-family: var(--font-mono, monospace); }
  .eyebrow { font-size: 10px; letter-spacing: .09em; margin: 0 0 16px; line-height: 1.7; }
  h1 { font-size: clamp(36px, 5.2vw, 72px); font-weight: 500; line-height: 1.02; letter-spacing: -.055em; margin: 0 0 20px; }
  .dek { font-size: clamp(18px, 2vw, 23px); margin: 0 0 12px; }
  .details { color: #596354; font-size: 13px; line-height: 1.7; margin: 0; }
  a.download { display: flex; color: #18291e; text-decoration: none; border: 1px solid #18291e; font-size: 14px; min-height: 48px; transition: background .15s; }
  a.download:hover { background: #e6edcf; text-decoration: none; }
  a.download:focus-visible, a:focus-visible { outline: 3px solid #5063cf; outline-offset: 4px; }
  a.set-download { flex: 0 0 236px; flex-direction: column; gap: 9px; padding: 18px 20px; background: #d9eea7; }
  .set-download > span { display: flex; justify-content: space-between; gap: 24px; }
  .set-download small { font-size: 11px; color: #485339; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding: 32px 0 40px; }
  figure { min-width: 0; margin: 0; }
  figure > img { display: block; width: 100%; height: auto; aspect-ratio: 1; background: #d9eea7; }
  figcaption { padding: 19px 0 0; }
  .caption { display: flex; align-items: baseline; gap: 12px; }
  .number { font-size: 11px; color: #66755d; }
  h2 { font-size: 20px; font-weight: 500; letter-spacing: -.03em; margin: 0; }
  .file-details { font-size: 10px; color: #596354; margin: 10px 0 18px; line-height: 1.7; }
  a.single-download { align-items: center; justify-content: space-between; padding: 12px 16px; }
  .colophon { border-top: 1px solid #cbd8c5; padding-top: 20px; display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; font-size: 11px; line-height: 1.7; color: #596354; }
  .colophon p { margin: 0; }
  .colophon a { color: inherit; }
  @media (max-width: 760px) { .intro { display: block; } a.set-download { margin-top: 24px; max-width: 300px; } .gallery { grid-template-columns: 1fr; gap: 40px; } .crumb { margin-bottom: 32px; } }
</style>
