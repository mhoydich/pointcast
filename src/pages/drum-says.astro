---
/**
 * /drum-says — Noun Says. A Noun calls a growing pattern on four pads;
 * you echo it back. One wrong pad and the run is over. Streak on the
 * marquee, best streak in your pocket (localStorage).
 *
 * Solo memory game — the classic, missing from the drum hub until now.
 * Taps still broadcast on the /api/sounds bus so the cast surfaces flash.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Drum Says · echo the Noun';
const description = 'A Noun calls a pattern on four drums. Echo it back. Every round adds one more hit. How long can you hold the thread?';
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Drum Says', url: 'https://pointcast.xyz/drum-says', description, gamePlatform: 'Web browser', playMode: 'SinglePlayer' };
---
<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="ds" id="ds">
    <header class="ds__top">
      <div class="ds__caller">
        <img class="ds__noun" id="ds-noun" src="https://noun.pics/385.svg" alt="The calling Noun" width="120" height="120" />
        <div class="ds__speech" id="ds-speech" role="status" aria-live="polite">tap START and listen close</div>
      </div>
      <div class="ds__score">
        <span class="ds__streak"><strong id="ds-streak">0</strong><em>streak</em></span>
        <span class="ds__best"><strong id="ds-best">0</strong><em>best</em></span>
      </div>
    </header>

    <section class="ds__pads" id="ds-pads">
      <button class="ds__pad ds__pad--0" data-pad="0" type="button" aria-label="Red drum (key 1)"><span>1</span></button>
      <button class="ds__pad ds__pad--1" data-pad="1" type="button" aria-label="Gold drum (key 2)"><span>2</span></button>
      <button class="ds__pad ds__pad--2" data-pad="2" type="button" aria-label="Mint drum (key 3)"><span>3</span></button>
      <button class="ds__pad ds__pad--3" data-pad="3" type="button" aria-label="Sky drum (key 4)"><span>4</span></button>
    </section>

    <section class="ds__controls">
      <button class="ds__start" id="ds-start" type="button">▶ START</button>
      <span class="ds__hint">keys 1–4 work too</span>
    </section>

    <nav class="ds__siblings">
      <a href="/drum-games">all five</a>
      <a href="/drum-quickdraw">quick draw</a>
      <a href="/drum-fill">fill</a>
      <a href="/drum-runner">runner</a>
      <a href="/drum-steady">steady</a>
      <a href="/drum">/drum</a>
    </nav>
  </div>

  <style is:global>
    html, body { background: #0a0d1a; margin: 0; }
    body:has(.ds) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }
    .ds {
      max-width: 640px;
      margin: 0 auto;
      padding: 28px 16px 60px;
      display: flex;
      flex-direction: column;
      gap: 22px;
      min-height: 92vh;
    }

    /* HEADER — caller + scoreboard */
    .ds__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .ds__caller { display: flex; align-items: center; gap: 14px; }
    .ds__noun {
      width: 96px; height: 96px;
      image-rendering: pixelated;
      filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5));
      transition: transform 120ms ease;
    }
    .ds--calling .ds__noun { animation: dsBob 0.42s ease-in-out infinite; }
    @keyframes dsBob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    .ds__speech {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      color: #f4e7c8;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(244,231,200,0.18);
      border-radius: 4px 14px 14px 14px;
      padding: 9px 13px;
      max-width: 220px;
      line-height: 1.5;
    }
    .ds__score { display: flex; gap: 18px; }
    .ds__streak, .ds__best {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
    }
    .ds__score strong {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 40px;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .ds__streak strong { color: #f6c15e; }
    .ds__best strong { color: #8a8a9a; }
    .ds__score em {
      font-style: normal;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8a8a9a;
    }

    /* PADS */
    .ds__pads {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      flex: 1;
      min-height: 320px;
    }
    .ds__pad {
      border: 0;
      border-radius: 22px;
      cursor: pointer;
      position: relative;
      transition: transform 70ms ease, filter 140ms ease;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      filter: brightness(0.55) saturate(0.8);
      min-height: 140px;
    }
    .ds__pad span {
      position: absolute;
      bottom: 10px; right: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      color: rgba(0,0,0,0.45);
    }
    .ds__pad--0 { background: radial-gradient(circle at 38% 32%, #ff8aa0, #c22646); }
    .ds__pad--1 { background: radial-gradient(circle at 38% 32%, #ffd98a, #d08a1a); }
    .ds__pad--2 { background: radial-gradient(circle at 38% 32%, #a0f0cc, #1f9a68); }
    .ds__pad--3 { background: radial-gradient(circle at 38% 32%, #9ad4f4, #2270b0); }
    .ds__pad--lit { filter: brightness(1.25) saturate(1.15); transform: scale(1.03); }
    .ds__pad:active { transform: scale(0.97); }
    .ds--your-turn .ds__pad { filter: brightness(0.9) saturate(1); }
    .ds--your-turn .ds__pad--lit { filter: brightness(1.3) saturate(1.2); }

    /* CONTROLS */
    .ds__controls { display: flex; align-items: center; gap: 14px; justify-content: center; }
    .ds__start {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #0a0d1a;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 13px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .ds__start:hover { transform: translateY(-1px); background: #ffd98a; }
    .ds__start:disabled { opacity: 0.35; cursor: default; transform: none; }
    .ds__hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #8a8a9a;
    }

    .ds__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .ds__siblings a { color: #d4a437; text-decoration: none; }
    .ds__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .ds__pads { min-height: 260px; }
      .ds__score strong { font-size: 32px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ds *, .ds *::before, .ds *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>

  <script>
    // Pads → C major pentatonic-ish four notes, one per pad
    const PAD_FREQS = [220.0, 293.66, 392.0, 523.25]; // A3 D4 G4 C5
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];

    const CALL_LINES = [
      'listen close…',
      'again, plus one.',
      'the pattern grows.',
      'still with me?',
      'good. deeper now.',
      'few make it this far.',
      'the drum remembers you.',
    ];
    const WIN_LINES = ['yes.', 'clean echo.', 'you have it.', 'the room heard that.'];
    const LOSE_LINES = [
      'ah — it was pad %s. the thread snapped at %n.',
      'so close. pad %s was next. streak of %n stands.',
      'the pattern wanted pad %s. %n echoes deep — not bad.',
    ];

    let SESSION_ID = '';
    let sequence: number[] = [];
    let inputIdx = 0;
    let phase: 'idle' | 'calling' | 'echo' | 'over' = 'idle';
    let best = 0;

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function playPad(pad: number, vel = 1) {
      const a = ctx();
      const t = a.currentTime + 0.005;
      const f = PAD_FREQS[pad];
      // Drum body — sine with quick pitch dip
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = 'triangle';
      o.frequency.setValueAtTime(f, t);
      o.frequency.exponentialRampToValueAtTime(f * 0.985, t + 0.18);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.38 * vel, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.5);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 0.55);
      // Attack click
      const buf = a.createBuffer(1, a.sampleRate * 0.03, a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource();
      n.buffer = buf;
      const ng = a.createGain();
      ng.gain.value = 0.12 * vel;
      n.connect(ng).connect(a.destination);
      n.start(t);
    }
    function playBuzz() {
      const a = ctx();
      const t = a.currentTime + 0.005;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(90, t);
      o.frequency.exponentialRampToValueAtTime(55, t + 0.4);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.22, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.55);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 0.6);
    }

    // ---- shared bus (best effort) ----
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(pad: number) {
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: pad, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- dom ----
    const root = document.getElementById('ds')!;
    const pads = Array.from(document.querySelectorAll('.ds__pad')) as HTMLButtonElement[];
    const startBtn = document.getElementById('ds-start') as HTMLButtonElement;
    const speech = document.getElementById('ds-speech')!;
    const streakEl = document.getElementById('ds-streak')!;
    const bestEl = document.getElementById('ds-best')!;
    const nounImg = document.getElementById('ds-noun') as HTMLImageElement;

    function say(line: string) { speech.textContent = line; }
    function lightPad(pad: number, ms = 320) {
      const el = pads[pad];
      el.classList.add('ds__pad--lit');
      setTimeout(() => el.classList.remove('ds__pad--lit'), ms);
    }
    function setStreak(n: number) {
      streakEl.textContent = String(n);
      if (n > best) {
        best = n;
        bestEl.textContent = String(best);
        try { localStorage.setItem('pc-drum-says-best', String(best)); } catch {}
      }
    }
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function callSequence() {
      phase = 'calling';
      root.classList.add('ds--calling');
      root.classList.remove('ds--your-turn');
      startBtn.disabled = true;
      say(CALL_LINES[Math.min(Math.floor(sequence.length / 3), CALL_LINES.length - 1)]);
      await sleep(650);
      // Pace quickens as the run grows
      const gap = Math.max(240, 560 - sequence.length * 18);
      for (const pad of sequence) {
        playPad(pad, 0.85);
        lightPad(pad, Math.min(gap * 0.8, 300));
        await sleep(gap);
      }
      root.classList.remove('ds--calling');
      root.classList.add('ds--your-turn');
      phase = 'echo';
      inputIdx = 0;
      say('your turn.');
    }

    function extendAndCall() {
      sequence.push(Math.floor(Math.random() * 4));
      callSequence();
    }

    async function handleInput(pad: number) {
      if (phase !== 'echo') {
        // free play when idle — still makes sound, still broadcasts
        if (phase === 'idle' || phase === 'over') { playPad(pad); lightPad(pad, 180); broadcast(pad); }
        return;
      }
      playPad(pad);
      lightPad(pad, 180);
      broadcast(pad);
      if (pad !== sequence[inputIdx]) {
        // wrong — run over
        phase = 'over';
        root.classList.remove('ds--your-turn');
        playBuzz();
        const streak = sequence.length - 1;
        const line = LOSE_LINES[Math.floor(Math.random() * LOSE_LINES.length)]
          .replace('%s', String(sequence[inputIdx] + 1))
          .replace('%n', String(streak));
        say(line);
        startBtn.textContent = '▶ AGAIN';
        startBtn.disabled = false;
        startBtn.focus({ preventScroll: true });
        return;
      }
      inputIdx++;
      if (inputIdx >= sequence.length) {
        setStreak(sequence.length);
        phase = 'calling';
        root.classList.remove('ds--your-turn');
        say(WIN_LINES[Math.floor(Math.random() * WIN_LINES.length)]);
        await sleep(700);
        extendAndCall();
      }
    }

    function startRun() {
      sequence = [];
      inputIdx = 0;
      setStreakDisplayOnly(0);
      nounImg.src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;
      extendAndCall();
    }
    function setStreakDisplayOnly(n: number) { streakEl.textContent = String(n); }

    pads.forEach((el) => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        handleInput(Number(el.dataset.pad));
      });
      el.addEventListener('click', (e) => {
        // Pointer input is handled on contact for tight timing; native
        // keyboard and assistive-tech activation arrives as detail 0.
        if (e.detail === 0) handleInput(Number(el.dataset.pad));
      });
    });
    startBtn.addEventListener('click', () => { ctx(); startRun(); });
    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      const k = Number(e.key);
      if (k >= 1 && k <= 4) { e.preventDefault(); handleInput(k - 1); }
    });

    // init
    SESSION_ID = getOrCreateSession();
    try { best = Number(localStorage.getItem('pc-drum-says-best') || 0) || 0; } catch {}
    bestEl.textContent = String(best);
  </script>
</BlockLayout>
