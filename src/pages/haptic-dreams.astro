---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  HAPTIC_DREAMS,
  HAPTIC_DREAMS_PLAYS,
  HAPTIC_DREAMS_SOURCES,
  HAPTIC_PATTERNS,
} from '../lib/pointcast-haptic-dreams';

const cityTiers = Array.from({ length: 9 }, (_, index) => ({
  tier: Math.min(5, Math.floor(index / 2) + 1),
  height: 52 + ((index * 31) % 105),
  windows: 2 + (index % 4),
}));
const soldiers = Array.from({ length: 7 });
const motors = Array.from({ length: 8 });
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      name: HAPTIC_DREAMS.title,
      description: HAPTIC_DREAMS.description,
      url: HAPTIC_DREAMS.canonical,
      image: HAPTIC_DREAMS.socialImage,
      datePublished: HAPTIC_DREAMS.publishedAt,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      publisher: { '@type': 'Organization', name: 'PointCast' },
      gamePlatform: 'Web browser',
      applicationCategory: 'Interactive sports artwork',
      isAccessibleForFree: true,
    },
    {
      '@type': 'Dataset',
      name: 'Haptic Dreams selected event translation',
      description: 'Selected public play-by-play events translated into haptic and illustrated-world states.',
      url: HAPTIC_DREAMS.machine,
      temporalCoverage: HAPTIC_DREAMS.game.date,
      creator: { '@type': 'Organization', name: 'PointCast' },
      citation: HAPTIC_DREAMS_SOURCES.map((source) => source.url),
    },
  ],
};
---

<BlockLayout
  title={HAPTIC_DREAMS.title}
  description={HAPTIC_DREAMS.description}
  image={HAPTIC_DREAMS.socialImage}
  themeColor="#111827"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/haptic-dreams.json', title: 'Haptic Dreams machine edition' }]}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="dreams">
    <header class="mast">
      <a href="/" aria-label="PointCast home">POINTCAST</a>
      <span>COLLEGE FOOTBALL · EXPERIMENT 001</span>
      <nav aria-label="Haptic Dreams navigation">
        <a href="/25/magazine">MAGAZINE</a>
        <a href="/haptic-dreams.json">JSON ↗</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="dream-title">
      <div class="hero__grid" aria-hidden="true"></div>
      <img class="hero__train" src="/images/pointcast-haptic-dreams/jon-snow-train.webp" alt="" width="2200" height="619" />
      <img class="hero__lion" src="/images/pointcast-haptic-dreams/jon-snow-lion.webp" alt="" width="960" height="1139" />
      <div class="hero__copy">
        <p>HAPTIC DREAMS / SATURDAY PROTOCOL 01</p>
        <h1 id="dream-title">THE GAME,<br /><em>RE-FELT.</em></h1>
        <p class="hero__dek">One real football game translated into touch, movement, and a world that remembers.</p>
        <a href="/haptic-dreams/play">Play Signal Run →</a>
        <a class="hero__secondary-action" href="#instrument">Enter the exhibition ↓</a>
      </div>
      <div class="hero__ledger">
        <span>MICHIGAN 13</span><i></i><span>OHIO STATE 10</span><i></i><span>NOV 30 · 2024</span>
      </div>
      <p class="hero__credit">ART DECO LION + TRAIN · JON SNOW FOR KANSASDAO · USED WITH CREDIT</p>
    </section>

    <section class="thesis" aria-labelledby="thesis-title">
      <p class="section-label">00 / A LIVE FEED BECOMES A CULTURAL OBJECT</p>
      <h2 id="thesis-title">The score should not merely update.<br /><em>It should change the world.</em></h2>
      <div>
        <p class="lead">Haptic Dreams began with a simple proposition: a game has a language, and that language can be shared without a screen.</p>
        <p>Here, each play enters one event grammar. The grammar can travel into an eight-zone sleeve, an illustrated kingdom, a quiet sound, a room of lights, or another interface that has not been invented yet. The translation remains legible: possession has direction, yardage has distance, consequence has intensity, and the final whistle has weight.</p>
      </div>
    </section>

    <section class="instrument" id="instrument" aria-labelledby="instrument-title">
      <header class="instrument__header">
        <div>
          <p class="section-label">01 / THE SHARED INSTRUMENT</p>
          <h2 id="instrument-title">SATURDAY<br />KINGDOM</h2>
        </div>
        <p>Play the selected sequence. Switch outputs without changing the underlying event. Open another tab and the replay follows locally through the same shared channel.</p>
      </header>

      <div class="instrument__tabs" role="tablist" aria-label="Translation output">
        <button class="view-tab active" role="tab" aria-selected="true" data-view="world">01 / WORLD</button>
        <button class="view-tab" role="tab" aria-selected="false" data-view="sleeve">02 / SLEEVE</button>
        <button class="view-tab" role="tab" aria-selected="false" data-view="translation">03 / TRANSLATION</button>
      </div>

      <div class="scoreline" aria-label="Current game state">
        <div><span>MICH</span><strong id="michigan-score">0</strong></div>
        <p><span id="period">Q1</span><b id="clock">15:00</b><small id="shared-state">SHARED LOCALLY</small></p>
        <div><strong id="ohio-score">0</strong><span>OSU</span></div>
      </div>

      <section class="output active" id="world-output" role="tabpanel" aria-label="Living illustrated game world">
        <div class="world" id="world" data-sky="dawn" data-effect="wake" data-team="MICH">
          <div class="world__weather" aria-hidden="true"></div>
          <div class="world__sun" aria-hidden="true"></div>
          <div class="world__horizon world__horizon--far" aria-hidden="true"></div>
          <div class="world__horizon world__horizon--near" aria-hidden="true"></div>
          <p class="world__level" id="world-level">LEVEL 1 · THE GATES OPEN</p>

          <div class="city city--michigan" data-city="MICH" aria-label="Maize Keep construction level">
            <div class="city__name"><span>MAIZE KEEP</span><strong id="michigan-level">I</strong></div>
            <div class="city__buildings">
              {cityTiers.map((building, index) => (
                <i data-tier={building.tier} style={`--h:${building.height}px;--x:${index};--windows:${building.windows}`}></i>
              ))}
            </div>
            <div class="city__wall"></div>
            <div class="army" aria-hidden="true">
              {soldiers.map((_, index) => <i style={`--i:${index}`}></i>)}
            </div>
          </div>

          <svg class="trajectory" id="trajectory" viewBox="0 0 1000 430" preserveAspectRatio="none" aria-hidden="true">
            <path id="trajectory-path" d="M 130 350 Q 500 20 870 350"></path>
            <circle id="trajectory-ball" cx="870" cy="350" r="7"></circle>
          </svg>

          <img class="world__sigil" src="/images/pointcast-haptic-dreams/jon-snow-lion.webp" alt="KansasDAO Art Deco Lion by Jon Snow" width="960" height="1139" />
          <img class="world__train" id="world-train" src="/images/pointcast-haptic-dreams/jon-snow-train.webp" alt="KansasDAO Art Deco Train by Jon Snow carrying possession across the game world" width="2200" height="619" />

          <div class="event-flare" id="event-flare" aria-live="polite">
            <span id="event-kind">KICKOFF</span>
            <strong id="event-title">The rivalry wakes</strong>
          </div>
          <div class="fireworks" aria-hidden="true">{Array.from({ length: 8 }, (_, index) => <i style={`--i:${index}`}></i>)}</div>

          <div class="city city--ohio" data-city="OSU" aria-label="Scarlet Hold construction level">
            <div class="city__name"><span>SCARLET HOLD</span><strong id="ohio-level">I</strong></div>
            <div class="city__buildings">
              {cityTiers.map((building, index) => (
                <i data-tier={building.tier} style={`--h:${building.height}px;--x:${index};--windows:${building.windows}`}></i>
              ))}
            </div>
            <div class="city__wall"></div>
            <div class="army" aria-hidden="true">
              {soldiers.map((_, index) => <i style={`--i:${index}`}></i>)}
            </div>
          </div>
        </div>
        <p class="world__caption" id="world-caption">“The gates open. Two old kingdoms enter the field.”</p>
      </section>

      <section class="output" id="sleeve-output" role="tabpanel" aria-label="Eight-zone haptic sleeve">
        <div class="sleeve-copy">
          <p class="section-label">SCREENLESS BROADCAST</p>
          <h3>Recognize the game<br />through your skin.</h3>
          <p>Eight zones form a small vocabulary. Runs climb. Passes sweep. Turnovers reverse. Scores ring the whole arm.</p>
          <div class="pattern-readout"><span id="pattern-label">KICKOFF</span><strong id="pattern-phrase">FULL WAKE</strong><p id="pattern-meaning">The shared field opens.</p></div>
          <button id="feel-play">FEEL THIS PLAY</button>
          <small>Visual simulation always works. Supported devices also vibrate.</small>
        </div>
        <div class="sleeve-stage">
          <div class="arm" aria-label="Eight haptic zones from shoulder to wrist">
            <span class="arm__label arm__label--shoulder">SHOULDER</span>
            <div class="motors">{motors.map((_, index) => <i data-motor={index}><span>{String(index + 1).padStart(2, '0')}</span></i>)}</div>
            <span class="arm__label arm__label--wrist">WRIST</span>
          </div>
        </div>
      </section>

      <section class="output" id="translation-output" role="tabpanel" aria-label="Event translation record">
        <div class="translation-card">
          <p>LIVE EVENT</p>
          <strong id="translation-play">Michigan receives the opening kick in Columbus.</strong>
          <span id="translation-meta">Q1 · 15:00 · KICKOFF</span>
        </div>
        <div class="translation-arrow" aria-hidden="true">→</div>
        <div class="translation-card translation-card--haptic">
          <p>HAPTIC PHRASE</p>
          <strong id="translation-haptic">FULL WAKE</strong>
          <span id="translation-haptic-note">The shared field opens.</span>
        </div>
        <div class="translation-arrow" aria-hidden="true">→</div>
        <div class="translation-card translation-card--myth">
          <p>WORLD EVENT</p>
          <strong id="translation-world">The gates open. Two old kingdoms enter the field.</strong>
          <span id="translation-world-note">LEVEL 1 · WAKE · INTENSITY 1/5</span>
        </div>
      </section>

      <div class="transport" aria-label="Replay controls">
        <button id="previous" aria-label="Previous play">←</button>
        <button id="play" class="transport__play">PLAY THE GAME</button>
        <button id="next" aria-label="Next play">→</button>
        <input id="timeline" type="range" min="0" max={HAPTIC_DREAMS_PLAYS.length - 1} value="0" aria-label="Game timeline" />
        <button id="sound" aria-pressed="false">SOUND OFF</button>
        <div class="transport__readout">
          <span id="readout-number">PLAY 01 / {String(HAPTIC_DREAMS_PLAYS.length).padStart(2, '0')}</span>
          <strong id="readout-title">The rivalry wakes</strong>
          <p id="readout-detail">Michigan receives the opening kick in Columbus.</p>
        </div>
      </div>
    </section>

    <section class="grammar" aria-labelledby="grammar-title">
      <header>
        <p class="section-label">02 / THE REUSABLE PART</p>
        <h2 id="grammar-title">ONE STREAM.<br /><em>MANY BODIES.</em></h2>
      </header>
      <div class="grammar__flow">
        <article><span>INPUT</span><strong>PLAY-BY-PLAY</strong><p>team · clock · possession · yards · result · score</p></article>
        <b aria-hidden="true">→</b>
        <article><span>TRANSLATOR</span><strong>EVENT GRAMMAR</strong><p>direction · distance · duration · intensity · consequence</p></article>
        <b aria-hidden="true">→</b>
        <article><span>OUTPUT</span><strong>SHARED DREAM</strong><p>sleeve · phone · room · animation · light · sound</p></article>
      </div>
      <div class="grammar__patterns">
        {HAPTIC_PATTERNS.map((pattern, index) => (
          <button data-pattern={pattern.id}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{pattern.label}</strong>
            <em>{pattern.phrase}</em>
          </button>
        ))}
      </div>
    </section>

    <section class="origin" aria-labelledby="origin-title">
      <div>
        <p class="section-label">03 / RECOVERED IDEA, WORKING FORM</p>
        <h2 id="origin-title">A language,<br />not an effect.</h2>
      </div>
      <div class="origin__copy">
        <p class="lead">The early Haptic Dreams conversations framed the wearable as a language shared by everyone consuming the same event. That distinction remains the project’s center.</p>
        <p>This edition is deliberately a replay, not a claim of live infrastructure. The selected public events are frozen, sourced, and translated through one visible protocol. The next hardware test is recognition: can someone identify run, pass, turnover, score, and miss without seeing the screen?</p>
        <p class="boundary">{HAPTIC_DREAMS.boundary}</p>
      </div>
      <aside>
        <span>VISUAL SYSTEM</span>
        <img src="/images/pointcast-haptic-dreams/jon-snow-lion.webp" alt="Art Deco Lion created by Jon Snow for KansasDAO" width="960" height="1139" loading="lazy" />
        <strong>JON SNOW<br />FOR KANSASDAO</strong>
        <p>Original Art Deco Lion and Train. Their heraldic frontality and lateral motion form the world’s shared visual grammar.</p>
      </aside>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <header><p class="section-label">SOURCE ROOM / OPEN RECEIPTS</p><h2 id="sources-title">REAL GAME.<br />VISIBLE TRANSLATION.</h2></header>
      <ol>
        {HAPTIC_DREAMS_SOURCES.map((source, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{source.label}</strong><p>{source.role}</p></div><a href={source.url} rel="noreferrer">OPEN ↗</a></li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <a href="/">POINTCAST</a>
      <p>CONCEPT · MICHAEL HOYDICH / HAPTIC DREAMS<br />ART · JON SNOW / KANSASDAO<br />INTERACTION TRANSLATION · CODEX / OPENAI FOR POINTCAST</p>
      <nav><a href="/haptic-dreams.json">MACHINE EDITION ↗</a><a href="/25/magazine">COLLEGE FOOTBALL ↗</a></nav>
    </footer>
  </main>

  <script id="haptic-data" type="application/json" set:html={JSON.stringify({ plays: HAPTIC_DREAMS_PLAYS, patterns: HAPTIC_PATTERNS })}></script>
</BlockLayout>

<script>
  const dataNode = document.querySelector('#haptic-data');
  const data = JSON.parse(dataNode?.textContent || '{"plays":[],"patterns":[]}');
  const plays = data.plays;
  const patterns = Object.fromEntries(data.patterns.map((pattern) => [pattern.id, pattern]));
  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => [...document.querySelectorAll(selector)];
  let playIndex = 0;
  let playback = null;
  let soundEnabled = false;
  let audioContext = null;
  const channel = 'BroadcastChannel' in window ? new BroadcastChannel('pointcast-haptic-dreams') : null;

  const roman = ['0', 'I', 'II', 'III', 'IV', 'V'];

  function playTone(pattern, team) {
    if (!soundEnabled) return;
    audioContext ??= new AudioContext();
    const now = audioContext.currentTime;
    const root = team === 'MICH' ? 196 : 220;
    pattern.zones.forEach((zones, index) => {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.value = root * (1 + (zones[0] ?? 0) / 14);
      gain.gain.setValueAtTime(0, now + index * 0.13);
      gain.gain.linearRampToValueAtTime(0.045, now + index * 0.13 + 0.025);
      gain.gain.exponentialRampToValueAtTime(0.001, now + index * 0.13 + 0.19);
      oscillator.connect(gain).connect(audioContext.destination);
      oscillator.start(now + index * 0.13);
      oscillator.stop(now + index * 0.13 + 0.21);
    });
  }

  function feel(patternId, team = plays[playIndex].team) {
    const pattern = patterns[patternId] || patterns.kickoff;
    const motors = $$('.motors i');
    motors.forEach((motor) => motor.classList.remove('pulse'));
    pattern.zones.forEach((zones, step) => {
      window.setTimeout(() => {
        motors.forEach((motor) => motor.classList.remove('pulse'));
        zones.forEach((zone) => motors[zone]?.classList.add('pulse'));
      }, step * 165);
    });
    window.setTimeout(() => motors.forEach((motor) => motor.classList.remove('pulse')), pattern.zones.length * 165 + 220);
    if ('vibrate' in navigator) navigator.vibrate(pattern.vibration);
    playTone(pattern, team);
  }

  function animateWorld() {
    const world = $('#world');
    const flare = $('#event-flare');
    const trajectory = $('#trajectory');
    if (!world || !flare || !trajectory) return;
    flare.classList.remove('show');
    trajectory.classList.remove('play');
    void flare.getBoundingClientRect();
    flare.classList.add('show');
    trajectory.classList.add('play');
  }

  function render(options = {}) {
    const play = plays[playIndex];
    const pattern = patterns[play.haptic] || patterns.kickoff;
    const world = $('#world');
    const position = ((play.world.possession + 1) / 2) * 100;
    world.dataset.sky = play.world.sky;
    world.dataset.effect = play.world.effect;
    world.dataset.team = play.team;
    world.style.setProperty('--possession', `${position}%`);
    world.style.setProperty('--intensity', String(play.world.intensity));
    $$('.city--michigan [data-tier]').forEach((building) => building.classList.toggle('built', Number(building.dataset.tier) <= play.world.michiganLevel));
    $$('.city--ohio [data-tier]').forEach((building) => building.classList.toggle('built', Number(building.dataset.tier) <= play.world.ohioStateLevel));
    $('#michigan-level').textContent = roman[play.world.michiganLevel];
    $('#ohio-level').textContent = roman[play.world.ohioStateLevel];
    $('#world-level').textContent = `LEVEL ${Math.max(play.world.michiganLevel, play.world.ohioStateLevel)} · ${play.title.toUpperCase()}`;
    $('#michigan-score').textContent = play.michigan;
    $('#ohio-score').textContent = play.ohioState;
    $('#period').textContent = play.type === 'final' ? 'FINAL' : `Q${play.quarter}`;
    $('#clock').textContent = play.clock;
    $('#event-kind').textContent = play.type.toUpperCase();
    $('#event-title').textContent = play.title;
    $('#world-caption').textContent = `“${play.myth}”`;
    $('#pattern-label').textContent = pattern.label.toUpperCase();
    $('#pattern-phrase').textContent = pattern.phrase.toUpperCase();
    $('#pattern-meaning').textContent = pattern.meaning;
    $('#translation-play').textContent = play.detail;
    $('#translation-meta').textContent = `${play.type === 'final' ? 'FINAL' : `Q${play.quarter}`} · ${play.clock} · ${play.type.toUpperCase()}`;
    $('#translation-haptic').textContent = pattern.phrase.toUpperCase();
    $('#translation-haptic-note').textContent = pattern.meaning;
    $('#translation-world').textContent = play.myth;
    $('#translation-world-note').textContent = `LEVEL ${Math.max(play.world.michiganLevel, play.world.ohioStateLevel)} · ${play.world.effect.toUpperCase()} · INTENSITY ${play.world.intensity}/5`;
    $('#timeline').value = String(playIndex);
    $('#readout-number').textContent = `PLAY ${String(playIndex + 1).padStart(2, '0')} / ${String(plays.length).padStart(2, '0')}`;
    $('#readout-title').textContent = play.title;
    $('#readout-detail').textContent = play.detail;
    $('#trajectory').classList.toggle('visible', ['arc', 'advance', 'miss', 'breach'].includes(play.world.effect));
    $('#trajectory').classList.toggle('reverse', play.team === 'OSU');
    if (options.animate !== false) {
      animateWorld();
      feel(play.haptic, play.team);
    }
    if (options.broadcast !== false) channel?.postMessage({ type: 'play', index: playIndex });
  }

  function setPlay(next, options = {}) {
    playIndex = Math.max(0, Math.min(plays.length - 1, next));
    render(options);
  }

  function stopPlayback() {
    if (playback) window.clearInterval(playback);
    playback = null;
    $('#play').textContent = 'PLAY THE GAME';
  }

  function togglePlayback() {
    if (playback) return stopPlayback();
    if (playIndex === plays.length - 1) setPlay(0);
    $('#play').textContent = 'PAUSE';
    playback = window.setInterval(() => {
      if (playIndex >= plays.length - 1) return stopPlayback();
      setPlay(playIndex + 1);
    }, 3100);
  }

  $$('.view-tab').forEach((button) => button.addEventListener('click', () => {
    $$('.view-tab').forEach((tab) => {
      tab.classList.toggle('active', tab === button);
      tab.setAttribute('aria-selected', String(tab === button));
    });
    $$('.output').forEach((output) => output.classList.toggle('active', output.id === `${button.dataset.view}-output`));
  }));
  $('#previous')?.addEventListener('click', () => setPlay(playIndex - 1));
  $('#next')?.addEventListener('click', () => setPlay(playIndex + 1));
  $('#play')?.addEventListener('click', togglePlayback);
  $('#timeline')?.addEventListener('input', (event) => setPlay(Number(event.target.value)));
  $('#feel-play')?.addEventListener('click', () => feel(plays[playIndex].haptic));
  $('#sound')?.addEventListener('click', (event) => {
    soundEnabled = !soundEnabled;
    event.currentTarget.textContent = soundEnabled ? 'SOUND ON' : 'SOUND OFF';
    event.currentTarget.setAttribute('aria-pressed', String(soundEnabled));
    if (soundEnabled) feel(plays[playIndex].haptic);
  });
  $$('.grammar__patterns button').forEach((button) => button.addEventListener('click', () => feel(button.dataset.pattern)));
  window.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLInputElement) return;
    if (event.key === 'ArrowLeft') setPlay(playIndex - 1);
    if (event.key === 'ArrowRight') setPlay(playIndex + 1);
    if (event.key === ' ') { event.preventDefault(); togglePlayback(); }
  });
  channel?.addEventListener('message', (event) => {
    if (event.data?.type === 'play' && Number.isInteger(event.data.index)) setPlay(event.data.index, { broadcast: false });
  });
  render({ animate: false });
</script>

<style>
  :global(*) { box-sizing:border-box; }
  :global(body) { margin:0; background:#101522; color:#eee5ce; }
  :global(a) { color:inherit; }
  :global(button), :global(input) { font:inherit; }
  .dreams { --ink:#101522; --ink-2:#171e2d; --paper:#eee5ce; --gold:#c9a35d; --maize:#ffcb05; --blue:#204a75; --scarlet:#ba0c2f; --mist:#aeb5c1; overflow:hidden; background:var(--ink); color:var(--paper); font-family:Arial,Helvetica,sans-serif; }
  .mast { min-height:58px; padding:0 3vw; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; border-bottom:1px solid #3d4352; background:#0c111c; font:800 10px/1 Arial,sans-serif; letter-spacing:.15em; position:relative; z-index:8; }
  .mast>a { text-decoration:none; font-size:15px; letter-spacing:-.02em; }
  .mast nav { display:flex; justify-content:flex-end; gap:22px; }
  .mast nav a { text-decoration:none; }
  .hero { min-height:calc(100svh - 58px); position:relative; display:flex; align-items:center; overflow:hidden; background:radial-gradient(circle at 78% 23%,#353d52,transparent 31%),linear-gradient(145deg,#0b101a,#1b2234 62%,#111620); }
  .hero__grid { position:absolute; inset:0; opacity:.2; background:repeating-linear-gradient(90deg,transparent 0 9vw,var(--gold) 9vw calc(9vw + 1px)),repeating-linear-gradient(0deg,transparent 0 10vh,#fff 10vh calc(10vh + 1px)); }
