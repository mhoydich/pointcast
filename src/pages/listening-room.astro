---
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  DEFAULT_PLAYLIST_ID,
  parseSpotifyPlaylistUrl,
  playlistRoomKey,
  playlistRoomUrl,
  spotifyEmbedUrl,
  spotifyOpenUrl,
  NOTE_PROMPTS,
} from '../lib/playlist-room';

const plParam = Astro.url.searchParams.get('pl');
const playlistId = (plParam && parseSpotifyPlaylistUrl(`https://open.spotify.com/playlist/${plParam}`))
  || DEFAULT_PLAYLIST_ID;
const roomKey = playlistRoomKey(playlistId);
const isDefault = playlistId === DEFAULT_PLAYLIST_ID;

const title = isDefault
  ? 'PointCast Listening Room'
  : `Listening Room — ${playlistId.slice(0, 8)}`;
const description = 'Drop a Spotify playlist into the room. Annotate the sequence. Share the receipt. Built for people who make playlists and argue lovingly about track 4.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/listening-room',
  name: 'PointCast Listening Room',
  description,
  url: playlistRoomUrl(playlistId),
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image="/images/listening-room/pointcast-listening-room-space.png"
  jsonLd={jsonLd}
  showNetworkStrip={false}
  alternates={[
    { type: 'application/json', href: '/listening-room.json', title: 'Listening room manifest (JSON)' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/listening-room/pointcast-listening-room-space.png',
    buttons: [
      { label: 'Open room', action: 'link', target: playlistRoomUrl(playlistId) },
      { label: 'Open in Spotify', action: 'link', target: spotifyOpenUrl(playlistId) },
    ],
  }}
>
  <div class="lr" data-lr data-playlist-id={playlistId}>
    <nav class="lr-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>listening room</span>
    </nav>

    <header class="lr-head">
      <div class="lr-head__left">
        <span class="lr-tag mono">CH.SPN · LISTENING ROOM</span>
        <h1 class="lr-title">The Listening Room</h1>
        <p class="lr-dek">
          Drop a Spotify playlist. Annotate the sequence. Share the receipt.
          Built for people who make playlists and argue lovingly about track 4.
        </p>
      </div>
      <div class="lr-head__right">
        <div class="lr-input-wrap">
          <label class="lr-input-label mono" for="lr-url-input">Spotify playlist URL</label>
          <div class="lr-input-row">
            <input
              type="text"
              id="lr-url-input"
              class="lr-url-input"
              placeholder="https://open.spotify.com/playlist/…"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="lr-url-help"
            />
            <button type="button" class="lr-btn lr-btn--primary" data-action="load-playlist" aria-label="Load this playlist">
              Load
            </button>
          </div>
          <p class="lr-input-help" id="lr-url-help">
            Paste a Spotify playlist link. Tracking parameters are stripped. Only playlists accepted.
          </p>
          <p class="lr-input-error" data-lr-error role="alert" aria-live="polite"></p>
        </div>
        <div class="lr-drop-zone" data-lr-dropzone aria-label="Drop a Spotify playlist URL here">
          <span class="mono">Drop playlist URL here</span>
        </div>
      </div>
    </header>

    <div class="lr-desk">
      <section class="lr-embed" aria-label="Spotify player">
        <div class="lr-embed__frame">
          <div id="spotify-playlist-embed" data-lr-embed-host>
            <iframe
              data-lr-iframe
              src={spotifyEmbedUrl(playlistId)}
              width="100%"
              height="352"
              frameborder="0"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              title="Spotify playlist player"
            ></iframe>
          </div>
        </div>
        <div class="lr-embed__bar">
          <a
            class="lr-open-spotify mono"
            href={spotifyOpenUrl(playlistId)}
            target="_blank"
            rel="noopener"
            data-lr-open-spotify
          >
            Open in Spotify ↗
          </a>
          <button type="button" class="lr-btn lr-btn--ghost" data-action="try-another" aria-label="Try another playlist">
            Try another
          </button>
          <span class="lr-room-key mono" data-lr-room-key title="Room key for presence and chat">
            {roomKey}
          </span>
        </div>
        <div class="lr-playback mono" data-lr-playback aria-live="polite">
          Spotify controls playback · room notes stay local
        </div>
        <div class="lr-status" data-lr-status role="status" aria-live="polite"></div>
      </section>

      <aside class="lr-sequence" aria-label="Sequence table">
        <h2 class="lr-section-title mono">Side A — Sequence</h2>
        <p class="lr-section-note">
          Track positions labeled by their role in the sequence. The hinge is where the room changes temperature.
          Metadata links open on Spotify.
        </p>
        <ol class="lr-seq-list" data-lr-seq-list>
          <li class="lr-seq-empty mono">Load a playlist to see the sequence.</li>
        </ol>
      </aside>
    </div>

    <div class="lr-notes-row">
      <section class="lr-notes" aria-label="Listening notes">
        <h2 class="lr-section-title mono">Listening Notes</h2>
        <p class="lr-section-note">
          Browser-local. Never sent to any server or AI system.
        </p>
        <div class="lr-prompts" data-lr-prompts>
          {NOTE_PROMPTS.map((prompt) => (
            <div class="lr-prompt">
              <label class="lr-prompt-label" data-lr-prompt-text>{prompt}</label>
              <textarea
                class="lr-prompt-input"
                data-lr-note-input
                data-prompt={prompt}
                rows="2"
                maxlength="500"
                placeholder="Your note…"
                aria-label={prompt}
              ></textarea>
            </div>
          ))}
        </div>
      </section>

      <section class="lr-gestures" aria-label="Room gestures">
        <h2 class="lr-section-title mono">Room Gestures</h2>
        <p class="lr-section-note">
          Quick signals for the room. Posts to the shared listening log.
        </p>
        <div class="lr-gesture-grid">
          <button type="button" class="lr-gesture" data-gesture="keep this" aria-label="Signal: keep this">
            <span class="lr-gesture-label mono">Keep This</span>
            <span class="lr-gesture-desc">Bookmark this moment</span>
          </button>
          <button type="button" class="lr-gesture" data-gesture="hinge" aria-label="Signal: hinge">
            <span class="lr-gesture-label mono">Hinge</span>
            <span class="lr-gesture-desc">The room turns here</span>
          </button>
          <button type="button" class="lr-gesture" data-gesture="lift" aria-label="Signal: lift">
            <span class="lr-gesture-label mono">Lift</span>
            <span class="lr-gesture-desc">Energy goes up</span>
          </button>
          <button type="button" class="lr-gesture" data-gesture="closer" aria-label="Signal: closer">
            <span class="lr-gesture-label mono">Closer</span>
            <span class="lr-gesture-desc">This is the ending</span>
          </button>
          <button type="button" class="lr-gesture" data-gesture="rewind" aria-label="Signal: rewind">
            <span class="lr-gesture-label mono">Rewind</span>
            <span class="lr-gesture-desc">Play that again</span>
          </button>
        </div>
      </section>
    </div>

    <section class="lr-receipt" aria-label="Room receipt">
      <div class="lr-receipt__left">
        <h2 class="lr-section-title mono">Room Receipt</h2>
        <p class="lr-section-note">
          A portable record of this listening session. Includes your notes and marked moments.
          Clearly labeled as browser-local data.
        </p>
      </div>
      <div class="lr-receipt__actions">
        <button type="button" class="lr-btn lr-btn--primary" data-action="receipt-json" aria-label="Download receipt as JSON">
          Download JSON
        </button>
        <button type="button" class="lr-btn" data-action="receipt-md" aria-label="Download receipt as Markdown">
          Download Markdown
        </button>
        <button type="button" class="lr-btn lr-btn--ghost" data-action="receipt-copy" aria-label="Copy room URL to clipboard">
          Copy Room URL
        </button>
      </div>
    </section>

    <section class="lr-activity" aria-label="Room activity">
      <h2 class="lr-section-title mono">Listening Log</h2>
      <div class="lr-activity-strip" data-lr-activity>
        <p class="lr-activity-empty mono">No activity yet. Gestures and chat from the room will appear here.</p>
      </div>
    </section>

    <noscript>
      <div class="lr-noscript">
        <p>
          The default playlist is embedded above. For the full interactive experience
          — pasting playlists, annotating, gestures, and receipts — JavaScript is required.
        </p>
        <p>
          <a href={spotifyOpenUrl(playlistId)} target="_blank" rel="noopener">
            Open this playlist in Spotify ↗
          </a>
        </p>
      </div>
    </noscript>

    <footer class="lr-foot mono">
      <span>PointCast Listening Room</span>
      <span>·</span>
      <a href="/listening-room.json">Manifest JSON</a>
      <span>·</span>
      <a href="/b/0339">Block 0339</a>
      <span>·</span>
      <span>Notes are browser-local</span>
    </footer>
  </div>

  <script is:inline>
    (function () {
      'use strict';

      var ROOT = document.querySelector('[data-lr]');
      if (!ROOT) return;

      var PLAYLIST_ID_RE = /^[A-Za-z0-9]{22}$/;
      var DEFAULT_ID = ROOT.getAttribute('data-playlist-id') || '35WC68tu9rrBoRrW3N2n0M';

      var $iframe     = ROOT.querySelector('[data-lr-iframe]');
      var $embedHost  = ROOT.querySelector('[data-lr-embed-host]');
      var $input      = ROOT.querySelector('#lr-url-input');
      var $loadBtn    = ROOT.querySelector('[data-action="load-playlist"]');
      var $error      = ROOT.querySelector('[data-lr-error]');
      var $status     = ROOT.querySelector('[data-lr-status]');
      var $openSp     = ROOT.querySelector('[data-lr-open-spotify]');
      var $roomKey    = ROOT.querySelector('[data-lr-room-key]');
      var $seqList    = ROOT.querySelector('[data-lr-seq-list]');
      var $dropZone   = ROOT.querySelector('[data-lr-dropzone]');
      var $activity   = ROOT.querySelector('[data-lr-activity]');
      var $tryAnother = ROOT.querySelector('[data-action="try-another"]');
      var $playback   = ROOT.querySelector('[data-lr-playback]');

      var currentId = DEFAULT_ID;
      var currentTracks = [];
      var currentPlayback = {
        playingUri: null,
        isPaused: true,
        isBuffering: false,
        positionMs: 0,
        durationMs: 0,
      };
      var spotifyController = null;

      // ─── URL parsing (mirrors server-side logic) ─────────────────
      function parsePlaylistUrl(raw) {
        if (!raw || typeof raw !== 'string') return null;
        var trimmed = raw.trim();
        var uriMatch = trimmed.match(/^spotify:playlist:([A-Za-z0-9]{22})$/);
        if (uriMatch) return uriMatch[1];
        try {
          var u = new URL(trimmed);
          if (!/(^|\.)spotify\.com$/i.test(u.hostname)) return null;
          var parts = u.pathname.split('/').filter(Boolean);
          var idx = -1;
          for (var i = 0; i < parts.length; i++) {
            if (parts[i] === 'playlist' || /^intl-/.test(parts[i])) {
              if (parts[i] === 'playlist') { idx = i; break; }
              if (parts[i + 1] === 'playlist') { idx = i + 1; break; }
            }
          }
          if (idx < 0 || !parts[idx + 1]) return null;
          return PLAYLIST_ID_RE.test(parts[idx + 1]) ? parts[idx + 1] : null;
        } catch (e) { return null; }
      }

      function showError(msg) {
        if ($error) { $error.textContent = msg; $error.hidden = false; }
      }
      function clearError() {
        if ($error) { $error.textContent = ''; $error.hidden = true; }
      }
      function setStatus(msg) {
        if ($status) { $status.textContent = msg; }
      }

      // ─── Sequence table ──────────────────────────────────────────
      function sequenceLabel(pos, len) {
        if (len <= 0 || pos <= 0 || pos > len) return '';
        if (len === 1) return 'opener · closer';
        if (pos === 1) return 'opener';
        if (pos === len) return 'closer';
        if (len === 2) return 'run';
        if (len === 3) return pos === 2 ? 'hinge' : 'run';
        var hingeAt = Math.ceil(len * 0.618);
        if (pos === 2) return 'early run';
        if (pos === hingeAt) return 'hinge';
        if (pos > hingeAt && pos < len) return 'late turn';
        return 'run';
      }

      function renderSequencePlaceholder() {
        currentTracks = [];
        if ($seqList) $seqList.innerHTML = '<li class="lr-seq-empty mono">Sequence appears when metadata is available.</li>';
      }

      function renderSequence(tracks) {
        if (!$seqList) return;
        if (!tracks || !tracks.length) { renderSequencePlaceholder(); return; }
        currentTracks = tracks.slice();
        $seqList.innerHTML = '';
        var len = tracks.length;
        tracks.forEach(function (t, i) {
          var pos = i + 1;
          var label = sequenceLabel(pos, len);
          var li = document.createElement('li');
          li.className = 'lr-seq-item';
          li.setAttribute('data-position', pos);
          var num = document.createElement('span');
          num.className = 'lr-seq-num mono';
          num.textContent = String(pos).padStart(2, '0');
          var name = document.createElement(t.spotifyUrl ? 'a' : 'span');
          name.className = 'lr-seq-name';
          name.textContent = t.name || ('Track ' + pos);
          if (t.spotifyUrl) {
            name.href = t.spotifyUrl;
            name.target = '_blank';
            name.rel = 'noopener';
            name.setAttribute('aria-label', (t.name || ('Track ' + pos)) + ' on Spotify');
          }
          var artist = document.createElement('span');
          artist.className = 'lr-seq-artist';
          artist.textContent = Array.isArray(t.artists) ? t.artists.join(', ') : '';
          var lbl = document.createElement('span');
          lbl.className = 'lr-seq-label mono';
          lbl.textContent = label;
          li.appendChild(num);
          li.appendChild(name);
          li.appendChild(artist);
          li.appendChild(lbl);
          $seqList.appendChild(li);
        });
      }

      function roomKeyFor(id) {
        return '/listening-room/playlist/' + id;
      }

      function formatClock(milliseconds) {
        var seconds = Math.max(0, Math.floor((Number(milliseconds) || 0) / 1000));
        return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0');
      }

      function playbackTrackLabel(playingUri) {
        var spotifyId = String(playingUri || '').split(':').pop();
        if (!spotifyId) return '';
        for (var i = 0; i < currentTracks.length; i++) {
          var trackUrl = String(currentTracks[i].spotifyUrl || '');
          if (trackUrl.indexOf('/track/' + spotifyId) !== -1) {
            var artists = Array.isArray(currentTracks[i].artists)
              ? currentTracks[i].artists.join(', ')
              : '';
            return String(i + 1).padStart(2, '0') + ' · ' +
              (currentTracks[i].name || 'Track') + (artists ? ' — ' + artists : '');
          }
        }
        return '';
      }

      function renderPlayback() {
        if (!$playback) return;
        var stateLabel = currentPlayback.isBuffering
          ? 'Buffering'
          : (currentPlayback.isPaused ? 'Paused' : 'Playing');
        var trackLabel = playbackTrackLabel(currentPlayback.playingUri);
        var clock = currentPlayback.durationMs
          ? formatClock(currentPlayback.positionMs) + ' / ' + formatClock(currentPlayback.durationMs)
          : '';
        $playback.textContent = [
          stateLabel,
          trackLabel,
          clock,
        ].filter(Boolean).join(' · ') || 'Spotify controls playback · room notes stay local';
      }

      function installSpotifyIframeApi() {
        if (!$embedHost) return;
        window.onSpotifyIframeApiReady = function (IFrameAPI) {
          IFrameAPI.createController($embedHost, {
            uri: 'spotify:playlist:' + currentId,
            width: '100%',
            height: 352,
          }, function (controller) {
            spotifyController = controller;
            controller.addListener('ready', function () {
              if ($playback) $playback.textContent = 'Spotify player ready · press play when you are';
            });
            controller.addListener('playback_started', function (event) {
              currentPlayback.playingUri = event && event.data && event.data.playingURI || null;
              currentPlayback.isPaused = false;
              renderPlayback();
            });
            controller.addListener('playback_update', function (event) {
              var data = event && event.data || {};
              currentPlayback.playingUri = data.playingURI || currentPlayback.playingUri;
              currentPlayback.isPaused = !!data.isPaused;
              currentPlayback.isBuffering = !!data.isBuffering;
              currentPlayback.positionMs = Number(data.position) || 0;
              currentPlayback.durationMs = Number(data.duration) || 0;
              renderPlayback();
            });
          });
        };
        var apiScript = document.createElement('script');
        apiScript.src = 'https://open.spotify.com/embed/iframe-api/v1';
        apiScript.async = true;
        document.body.appendChild(apiScript);
      }

      // ─── Load playlist ───────────────────────────────────────────
      function loadPlaylist(id) {
        if (!PLAYLIST_ID_RE.test(id)) {
          showError('Invalid playlist ID.');
          return;
        }
        currentId = id;
        clearError();
        setStatus('Loading playlist…');

        if (spotifyController) {
          spotifyController.loadEntity('spotify:playlist:' + id);
        } else if ($iframe) {
          $iframe.src = 'https://open.spotify.com/embed/playlist/' + id + '?utm_source=generator';
        }
        if ($openSp) {
          $openSp.href = 'https://open.spotify.com/playlist/' + id;
        }
        if ($roomKey) {
          $roomKey.textContent = roomKeyFor(id);
        }
        window.dispatchEvent(new CustomEvent('pc:room:key', {
          detail: { key: roomKeyFor(id) },
        }));

        // Update URL without full navigation
        var newUrl = '/listening-room?pl=' + encodeURIComponent(id);
        try {
          history.replaceState(null, '', newUrl);
        } catch (e) {}

        ROOT.setAttribute('data-playlist-id', id);
        loadNotes(id);
        loadMarkedMoments(id);
        currentTracks = [];
        currentPlayback = {
          playingUri: null,
          isPaused: true,
          isBuffering: false,
          positionMs: 0,
          durationMs: 0,
        };
        renderPlayback();
        fetchMetadata(id);
        setStatus('');
      }

      function handleLoadInput() {
        clearError();
        var raw = $input ? $input.value : '';
        var id = parsePlaylistUrl(raw);
        if (!id) {
          showError('That doesn\'t look like a Spotify playlist URL. Paste a link from Spotify > Share > Copy link.');
          return;
        }
        loadPlaylist(id);
      }

      // ─── Metadata fetch (enhancement, not precondition) ──────────
      function fetchMetadata(id) {
        fetch('/api/spotify-playlist?id=' + encodeURIComponent(id))
          .then(function (res) {
            if (!res.ok) throw new Error('metadata_unavailable');
            return res.json();
          })
          .then(function (data) {
            if (data && Array.isArray(data.tracks)) {
              renderSequence(data.tracks);
            } else {
              renderSequencePlaceholder();
            }
          })
          .catch(function () {
            renderSequencePlaceholder();
          });
      }

      // ─── Notes (browser-local) ───────────────────────────────────
      var notesData = {};

      function notesKey(id) { return 'pc:playlist-notes:' + id; }

      function loadNotes(id) {
        notesData = {};
        try {
          var raw = localStorage.getItem(notesKey(id));
          if (raw) notesData = JSON.parse(raw) || {};
        } catch (e) {}
        var inputs = ROOT.querySelectorAll('[data-lr-note-input]');
        for (var i = 0; i < inputs.length; i++) {
          var prompt = inputs[i].getAttribute('data-prompt') || '';
          inputs[i].value = notesData[prompt] || '';
        }
      }

      function saveNotes() {
        try {
          localStorage.setItem(notesKey(currentId), JSON.stringify(notesData));
        } catch (e) {}
      }

      ROOT.addEventListener('input', function (e) {
        var target = e.target;
        if (target && target.hasAttribute && target.hasAttribute('data-lr-note-input')) {
          var prompt = target.getAttribute('data-prompt') || '';
          notesData[prompt] = target.value;
          saveNotes();
        }
      });

      // ─── Room gestures ───────────────────────────────────────────
      ROOT.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-gesture]');
        if (!btn) return;
        var gesture = btn.getAttribute('data-gesture') || '';
        if (!gesture) return;
        // Post to the existing room chat event bus
        window.dispatchEvent(new CustomEvent('pc:room:chat', { detail: { msg: gesture } }));
        setStatus('Signal sent: ' + gesture);
        setTimeout(function () { setStatus(''); }, 2000);
        // Record as a marked moment
        markedMoments.push({
          gesture: gesture,
          at: new Date().toISOString(),
          playlistId: currentId,
          playingUri: currentPlayback.playingUri,
          positionMs: currentPlayback.positionMs,
        });
        saveMarkedMoments();
      });

      // ─── Marked moments ──────────────────────────────────────────
      var markedMoments = [];
      function momentsKey(id) { return 'pc:playlist-moments:' + id; }
      function loadMarkedMoments(id) {
        markedMoments = [];
        try {
          var raw = localStorage.getItem(momentsKey(id));
          if (raw) markedMoments = JSON.parse(raw) || [];
        } catch (e) {}
      }
      function saveMarkedMoments() {
        try {
          localStorage.setItem(momentsKey(currentId), JSON.stringify(markedMoments));
        } catch (e) {}
      }

      // ─── Receipt ─────────────────────────────────────────────────
      function buildReceipt() {
        return {
          schema: 'pointcast-playlist-receipt/v1',
          playlistId: currentId,
          playlistUrl: 'https://open.spotify.com/playlist/' + currentId,
          roomUrl: location.origin + '/listening-room?pl=' + encodeURIComponent(currentId),
          createdAt: new Date().toISOString(),
          notes: Object.assign({}, notesData),
          markedMoments: markedMoments.slice(),
          privateDataNotice: 'This receipt contains browser-local data. Notes were written by the listener and never sent to any server or AI system.',
        };
      }

      function downloadFile(content, filename, mimeType) {
        var blob = new Blob([content], { type: mimeType });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () {
          document.body.removeChild(a);
          URL.revokeObjectURL(a.href);
        }, 100);
      }

      function receiptToMarkdown(r) {
        var lines = ['# PointCast Playlist Receipt', ''];
        lines.push('- **Playlist:** ' + r.playlistUrl);
        lines.push('- **Room:** ' + r.roomUrl);
        lines.push('- **Created:** ' + r.createdAt);
        lines.push('- **Schema:** ' + r.schema);
        lines.push('');
        lines.push('## Notes');
        lines.push('');
        var hasNotes = false;
        for (var prompt in r.notes) {
          if (r.notes[prompt] && r.notes[prompt].trim()) {
            hasNotes = true;
            lines.push('### ' + prompt);
            lines.push('');
            lines.push(r.notes[prompt]);
            lines.push('');
          }
        }
        if (!hasNotes) { lines.push('_No notes recorded._'); lines.push(''); }
        if (r.markedMoments.length > 0) {
          lines.push('## Marked Moments');
          lines.push('');
          r.markedMoments.forEach(function (m) {
            lines.push('- ' + m.gesture + ' — ' + m.at);
          });
          lines.push('');
        }
        lines.push('---');
        lines.push('');
        lines.push('> ' + r.privateDataNotice);
        lines.push('');
        return lines.join('\n');
      }

      ROOT.addEventListener('click', function (e) {
        var action = e.target.closest('[data-action]');
        if (!action) return;
        var act = action.getAttribute('data-action');

        if (act === 'load-playlist') { handleLoadInput(); return; }
        if (act === 'try-another') {
          if ($input) { $input.value = ''; $input.focus(); }
          clearError();
          return;
        }
        if (act === 'receipt-json') {
          var r = buildReceipt();
          downloadFile(JSON.stringify(r, null, 2), 'pointcast-receipt-' + currentId + '.json', 'application/json');
          return;
        }
        if (act === 'receipt-md') {
          var r2 = buildReceipt();
          downloadFile(receiptToMarkdown(r2), 'pointcast-receipt-' + currentId + '.md', 'text/markdown');
          return;
        }
        if (act === 'receipt-copy') {
          var url = location.origin + '/listening-room?pl=' + encodeURIComponent(currentId);
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              setStatus('Room URL copied.');
              setTimeout(function () { setStatus(''); }, 2000);
            });
          }
          return;
        }
      });

      // Enter key in input triggers load
      if ($input) {
        $input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); handleLoadInput(); }
        });
      }

      // ─── Drag and drop ───────────────────────────────────────────
      if ($dropZone) {
        $dropZone.addEventListener('dragover', function (e) {
          e.preventDefault();
          $dropZone.classList.add('lr-drop-zone--active');
        });
        $dropZone.addEventListener('dragleave', function () {
          $dropZone.classList.remove('lr-drop-zone--active');
        });
        $dropZone.addEventListener('drop', function (e) {
          e.preventDefault();
          $dropZone.classList.remove('lr-drop-zone--active');
          var text = e.dataTransfer && e.dataTransfer.getData('text/plain');
          if (text) {
            if ($input) $input.value = text;
            handleLoadInput();
          }
        });
      }

      // ─── Activity strip (from existing room log) ─────────────────
      window.addEventListener('pc:room:log-update', function (e) {
        if (!$activity) return;
        var log = e && e.detail && e.detail.log;
        if (!Array.isArray(log) || log.length === 0) return;
        $activity.innerHTML = '';
        var recent = log.slice(-8);
        recent.forEach(function (entry) {
          var div = document.createElement('div');
          div.className = 'lr-activity-line';
          var who = document.createElement('span');
          who.className = 'lr-activity-who mono';
          who.textContent = entry.who || 'visitor';
          var msg = document.createElement('span');
          msg.className = 'lr-activity-msg';
          msg.textContent = entry.msg;
          div.appendChild(who);
          div.appendChild(msg);
          $activity.appendChild(div);
        });
      });

      // ─── Init ────────────────────────────────────────────────────
      loadNotes(currentId);
      loadMarkedMoments(currentId);
      installSpotifyIframeApi();

      // Static Astro output renders the default; hydrate a shared ?pl= room
      // in the browser so the embed, notes, receipt, and presence key all agree.
      var urlParams = new URLSearchParams(location.search);
      var initialPl = urlParams.get('pl');
      if (initialPl && PLAYLIST_ID_RE.test(initialPl)) {
        loadPlaylist(initialPl);
      } else {
        fetchMetadata(currentId);
      }
    })();
  </script>
</BlockLayout>

<style>
  /* ─── Tokens ───────────────────────────────────────────────────── */
  .lr {
