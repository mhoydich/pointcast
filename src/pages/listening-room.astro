    margin-bottom: 14px;
  }

  .lr-tag {
    display: inline-block;
    color: var(--lr-coral);
    margin-bottom: 8px;
  }

  .lr-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.05;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
