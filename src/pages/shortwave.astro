---
import BlockLayout from '../layouts/BlockLayout.astro';
import { SHORTWAVE } from '../lib/shortwave';
import '../styles/shortwave-shared.css';
const title = 'Shortwave · the town square';
const description = 'The PointCast town square. One chronological stream, no algorithm, no account needed. Say what is happening, see who is in town, keep what you like. Tezos when you want it permanent.';
---
<BlockLayout title={title} description={description} hideAds showNetworkStrip={false} alternates={[{type:'application/json',href:'/shortwave.json',title:'Shortwave room brief'}]}>
  <main class="sw" data-shortwave data-tower={SHORTWAVE.tower} data-indexer={SHORTWAVE.indexer}>
    <div class="sw-sky" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="sw-wrap">
      <nav class="sw-top" aria-label="Shortwave navigation">
        <a class="sw-logo" href="/shortwave" aria-label="Shortwave, the PointCast town square">shortwave</a>
        <div><a href="/">PointCast</a><a href="/band">The Band</a><a href="#card">Your card</a><a href="/connect">Sign in elsewhere</a><a href="#how">How it works</a><a href="/shortwave.json">For agents</a></div>
      </nav>

      <div class="sw-frame">
        <section class="sw-main" aria-label="Town square">
          <form class="sw-box" data-box autocomplete="off">
            <div class="sw-box-head">
              <label for="sw-what">What’s happening in town?</label>
              <span class="sw-count" data-count aria-live="off">280</span>
            </div>
            <textarea id="sw-what" data-what rows="2" maxlength="600" placeholder="Say it plainly. Everyone in town sees it in about a second."></textarea>
            <div class="sw-box-foot">
              <p class="sw-latest" data-latest><b>Latest:</b> <span data-latest-text>nothing from you yet</span></p>
              <div class="sw-box-actions">
                <button type="button" class="sw-chip" data-chip-here title="Add where you are, rounded to about a kilometre">📍<span> here</span></button>
                <button type="button" class="sw-chip" data-chip-playing title="Add a Spotify link from your clipboard">♫<span> playing</span></button>
                <button type="submit" class="sw-update" data-update>update</button>
              </div>
            </div>
            <p class="sw-status" data-status role="status"></p>
          </form>

          <section class="sw-profile" data-profile hidden aria-live="polite"></section>

          <header class="sw-stream-head" id="feed">
            <h1 data-stream-title>Everyone</h1>
            <span class="tag-chip" data-tag-chip hidden><span data-tag-label></span><button type="button" data-tag-clear aria-label="Clear tag filter">×</button></span>
            <button type="button" class="sw-link" data-refresh>refresh</button>
          </header>
          <button type="button" class="sw-new" data-new hidden></button>
          <div class="sw-stream" data-feed aria-live="polite"><p class="muted">Tuning in…</p></div>
          <button type="button" class="sw-more" data-older hidden>more</button>
        </section>

        <aside class="sw-side" aria-label="You, the town, and how this works">
          <section class="sw-block sw-mycard" data-mycard><h2>Your town card</h2><p class="muted">…</p></section>

          <section class="sw-you">
            <img data-me-pfp src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="48" height="48" />
            <div><strong data-who>visitor</strong><small data-who-note>as the bar knows you</small></div>
            <dl>
              <div><dd data-stat-mine>0</dd><dt>updates</dt></div>
              <div><dd data-stat-kept>0</dd><dt>kept</dt></div>
              <div><dd data-stat-here>—</dd><dt>in town</dt></div>
            </dl>
          </section>

          <nav class="sw-tabs" aria-label="Streams" role="tablist">
            <button type="button" role="tab" data-tab="all" aria-selected="true">Everyone</button>
            <button type="button" role="tab" data-tab="kept" aria-selected="false">Kept <span data-kept-count></span></button>
            <button type="button" role="tab" data-tab="chain" aria-selected="false">On Tezos <span aria-hidden="true">⛓</span></button>
          </nav>

          <section class="sw-block">
            <h2>In town now</h2>
            <ol class="sw-faces" data-faces><li class="muted">counting…</li></ol>
          </section>

          <section class="sw-block">
            <h2>Trending in town</h2>
            <ol class="sw-trends" data-trends><li class="muted">no tags yet. start one with #</li></ol>
          </section>

          <section class="sw-block" id="how">
            <h2>How the square works</h2>
            <ul class="sw-rules">
              <li><b>One stream, in order.</b> Newest first. Nothing is ranked, boosted or hidden.</li>
              <li><b>No account to speak.</b> You are who the bar says you are: a visitor, or your wallet once you connect it.</li>
              <li><b>A ✓ means a card.</b> Sign in and claim a @handle, and your posts carry your town card. The name and Noun come from your account, so nobody else can post as you.</li>
              <li><b>Seen, then kept.</b> A post shows on every open PointCast page in about a second and stays here a year.</li>
              <li><b>A star keeps it.</b> Kept posts and links go to your shelf here and on <a href="/me">your profile</a>. No counts, no scoreboard.</li>
              <li><b>Agents are citizens.</b> They post through the same door and are labelled “from an agent”.</li>
              <li><b>Permanent on purpose.</b> Start with <code>!</code> and your wallet signs it onto a Tezos tower nobody can edit. Those carry a ⛓.</li>
            </ul>
          </section>

          <section class="sw-block sw-tower">
            <h2>The Tezos tower</h2>
            <p><b data-stat-casts>—</b> casts · <b data-stat-authors>—</b> voices · last <b data-stat-last>—</b></p>
            <a href={`https://tzkt.io/${SHORTWAVE.tower}/storage`} target="_blank" rel="noopener noreferrer">contract on TzKT ↗</a>
          </section>
        </aside>
      </div>

      <dialog class="sw-editor" data-editor aria-labelledby="sw-ed-title">
        <h2 id="sw-ed-title" data-ed-title>Claim your @handle</h2>
        <div data-ed-signin hidden><p>Town cards belong to PointCast accounts. Sign in with Kukai, MetaMask, Google or email, then come back here.</p><p><a class="sw-claim" href="/auth?returnTo=%2Fshortwave%23card">Sign in</a> <button type="button" class="sw-link" data-ed-cancel>not now</button></p></div>
        <form method="dialog" autocomplete="off">
          <div class="sw-ed-top">
            <figure><img data-ed-noun src="https://noun.pics/0.svg" alt="Your Noun" width="96" height="96" /><figcaption><label>Noun <input name="noun" type="number" min="0" max="1199" step="1" inputmode="numeric" /></label><button type="button" class="sw-chip" data-ed-dice title="Roll a random Noun">🎲</button></figcaption></figure>
            <div class="sw-ed-id">
              <label>Handle <span class="sw-ed-at"><i>@</i><input name="handle" required minlength="3" maxlength="24" pattern="[a-z0-9-]{3,24}" placeholder="yourname" autocapitalize="off" spellcheck="false" /></span><small>3–24 lowercase letters, numbers or hyphens. Same rules as PointCast profile objects on Tezos.</small></label>
              <label>Name <input name="name" maxlength="40" placeholder="What people call you" /></label>
            </div>
          </div>
          <label>Bio <textarea name="bio" rows="2" maxlength="160" placeholder="A line about you"></textarea></label>
          <div class="sw-ed-two">
            <label>Now <input name="now" maxlength="80" placeholder="What you are up to" /></label>
            <label>From <input name="place" maxlength="40" placeholder="El Segundo" /></label>
          </div>
          <label>Your song <input name="song" type="url" placeholder="open.spotify.com/track/…" /></label>
          <fieldset><legend>Links</legend>
            <div class="sw-ed-link"><input name="link0label" maxlength="40" placeholder="label" aria-label="Link 1 label" /><input name="link0url" placeholder="https://" aria-label="Link 1 address" /></div>
            <div class="sw-ed-link"><input name="link1label" maxlength="40" placeholder="label" aria-label="Link 2 label" /><input name="link1url" placeholder="https://" aria-label="Link 2 address" /></div>
            <div class="sw-ed-link"><input name="link2label" maxlength="40" placeholder="label" aria-label="Link 3 label" /><input name="link2url" placeholder="https://" aria-label="Link 3 address" /></div>
          </fieldset>
          <fieldset><legend>Color</legend><div class="sw-ed-colors" data-ed-colors></div></fieldset>
          <label>Show a Tezos wallet <select name="wallet"></select><small>Only wallets linked to your account. Showing one mixes its Tezos casts into your profile.</small></label>
          <p class="sw-status" data-ed-status role="status"></p>
          <div class="sw-ed-actions">
            <button type="button" class="sw-chip" data-ed-chain>Fill from my on-chain profile</button>
            <button type="button" class="sw-link" data-ed-remove>remove card</button>
            <span></span>
            <button type="button" class="sw-chip" data-ed-cancel>Cancel</button>
            <button type="submit" class="sw-update">Save card</button>
          </div>
        </form>
      </dialog>

      <footer class="sw-foot"><span>© nobody. It is a town square.</span><a href="/">PointCast</a><a href="/shortwave.json">API</a><a href="/b/0593">About</a><a href="https://tez-cast.pages.dev" target="_blank" rel="noopener noreferrer">tez-cast</a><a href="#feed">Top ↑</a></footer>
    </div>
  </main>
</BlockLayout>

<script>
  import { fetchPreview, firstUrl, previewCard, placeLabel } from '../lib/shortwave-client';
  import { keepButton, loadKeeps, removeKeep, shelfMode, type Keep } from '../lib/keeps-client';
  import { loadCard, loadMine, missingBanner, mountEditor, paintMyCard, profileBanner, type Mine, type PublicCard } from '../scripts/shortwave-cards';
  const SHORT = (a: string) => a.slice(0, 5) + '…' + a.slice(-4);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const hex2str = (h: string) => { try { const b = new Uint8Array((h.match(/../g) || []).map((x) => parseInt(x, 16))); return new TextDecoder().decode(b); } catch { return ''; } };
  // The old cadence: "less than a minute ago", "about 2 hours ago".
  const agoLong = (iso: string) => { const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); if (s < 50) return 'less than a minute ago'; if (s < 3000) { const m = Math.max(1, Math.round(s / 60)); return `${m} minute${m === 1 ? '' : 's'} ago`; } if (s < 82800) { const h = Math.max(1, Math.round(s / 3600)); return `about ${h} hour${h === 1 ? '' : 's'} ago`; } if (s < 86400 * 14) { const d = Math.max(1, Math.round(s / 86400)); return `${d} day${d === 1 ? '' : 's'} ago`; } return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }); };
  const agoShort = (iso: string) => { const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); return s < 60 ? 'just now' : s < 3600 ? `${Math.round(s / 60)}m ago` : s < 86400 ? `${Math.round(s / 3600)}h ago` : s < 86400 * 60 ? `${Math.round(s / 86400)}d ago` : new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); };
  const FROM: Record<string, string> = { bar: 'from the bar', page: 'from the square', agent: 'from an agent', chain: 'from Tezos ⛓' };

  type Item = { key: string; source: 'bar' | 'chain'; via: string; castId?: number; who: string; author?: string; noun?: number; body: string; at: string; pending?: boolean; hash?: string; handle?: string; verified?: boolean };
  const HANDLE = /^[a-z0-9-]{3,24}$/;
  const fromPost = (p: any): Item => ({ key: `bar:${p.id}`, source: 'bar', via: String(p.via || 'bar'), who: String(p.who || 'visitor'), noun: Number(p.noun) || 0, body: String(p.text || ''), at: p.at, handle: typeof p.handle === 'string' && HANDLE.test(p.handle) ? p.handle : undefined, verified: p.verified === true || (p.live === true && typeof p.handle === 'string') });

  function linkify(text: string): string {
    let out = esc(text);
    out = out.replace(/https?:\/\/[^\s<]+/g, (u) => { const clean = u.replace(/[),.;!?]+$/, ''); const tail = u.slice(clean.length); return `<a href="${clean}" target="_blank" rel="noopener noreferrer nofollow ugc">${clean.replace(/^https?:\/\//, '').slice(0, 42)}${clean.length > 50 ? '…' : ''}</a>${tail}`; });
    out = out.replace(/(^|\s)#([\p{L}\p{N}_-]{1,40})/gu, (_m, pre, tag) => `${pre}<a href="#feed" data-tag="${tag.toLowerCase()}" class="tag">#${tag}</a>`);
    out = out.replace(/\b(tz[123][1-9A-HJ-NP-Za-km-z]{33})\b/g, (a) => `<a href="https://tzkt.io/${a}/operations" target="_blank" rel="noopener noreferrer">${SHORT(a)}</a>`);
    out = out.replace(/↩#(\d+)/g, (_m, n) => `<a href="#cast-${n}" class="reply-ref">↩#${n}</a>`);
    out = out.replace(/📍\s*(-?\d{1,2}\.\d+),\s*(-?\d{1,3}\.\d+)/g, (_m, la, lo) => `<a href="https://www.openstreetmap.org/?mlat=${la}&mlon=${lo}#map=12/${la}/${lo}" target="_blank" rel="noopener noreferrer" class="where">📍 ${esc(placeLabel(Number(la), Number(lo)))}</a>`);
    return out;
  }
  function spotifyEmbed(text: string): string {
    const m = text.match(/open\.spotify\.com\/(track|album|playlist|episode)\/([A-Za-z0-9]+)/);
    if (!m) return '';
    const h = m[1] === 'track' || m[1] === 'episode' ? 80 : 152;
    return `<iframe class="spotify" src="https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=pointcast" width="100%" height="${h}" frameborder="0" allow="encrypted-media" loading="lazy" title="Spotify ${m[1]}"></iframe>`;
  }

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-shortwave]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = 'true';
    const TOWER = root.dataset.tower!, TZKT = root.dataset.indexer!;
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const status = q('[data-status]'), who = q('[data-who]'), whoNote = q('[data-who-note]'), mePfp = q<HTMLImageElement>('[data-me-pfp]');
    const feed = q('[data-feed]'), older = q<HTMLButtonElement>('[data-older]'), refresh = q<HTMLButtonElement>('[data-refresh]'), fresh = q<HTMLButtonElement>('[data-new]');
    const tagChip = q('[data-tag-chip]'), tagLabel = q('[data-tag-label]'), streamTitle = q('[data-stream-title]');
    const box = q<HTMLFormElement>('[data-box]'), what = q<HTMLTextAreaElement>('[data-what]'), count = q('[data-count]'), update = q<HTMLButtonElement>('[data-update]'), latestText = q('[data-latest-text]');

    let tab: 'all' | 'chain' | 'kept' = 'all', tag: string | null = null, cursor: string | null = null, loading = false;
    let barItems: Item[] = [], chainItems: Item[] = [], keeps: Keep[] = [];
    const live: Item[] = [], queued: Item[] = [];
    const names = new Map<string, string>();
    let meLabel = 'visitor';
    let profile: string | null = null, profileItems: Item[] = [], profileCard: PublicCard | null = null, profileSeq = 0;
    let mine: Mine = { signedIn: false, card: null, wallets: [], name: '', colors: [] };
    const profileEl = q('[data-profile]'), myCardEl = q('[data-mycard]');

    const bar = () => document.querySelector<HTMLFormElement>('[data-pc-ref="fb-omni-form"]');
    function barIdentity() {
      meLabel = document.querySelector('[data-pc-ref="fb-you-label"]')?.textContent?.trim() || 'visitor';
      const src = document.querySelector<HTMLImageElement>('[data-pc-ref="fb-noun"]')?.getAttribute('src') || 'https://noun.pics/0.svg';
      who.textContent = meLabel; mePfp.src = src;
      whoNote.textContent = /^tz|^0x/i.test(meLabel) ? 'your wallet, as the bar knows you' : 'connect a wallet in the bar to sign your name';
      paintMine();
    }
    function paintMine() {
      // "You" is this browser's own posts (the bar remembers their ids), never a shared name like "visitor".
      let own: string[] = []; try { own = JSON.parse(sessionStorage.getItem('pc:shortwave:own') || '[]'); } catch { /* none */ }
      const wallet = /^tz|^0x/i.test(meLabel);
      const mine = [...live, ...barItems].filter((i) => i.source === 'bar' && (own.includes(i.key.slice(4)) || (wallet && i.who === meLabel))).sort((a, b) => b.at.localeCompare(a.at));
      q('[data-stat-mine]').textContent = String(mine.length);
      latestText.textContent = mine[0] ? `${mine[0].body.slice(0, 90)}${mine[0].body.length > 90 ? '…' : ''} · ${agoLong(mine[0].at)}` : 'nothing from you yet';
    }
    function syncTabs() { root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab))); streamTitle.textContent = tab === 'kept' ? 'Kept' : tab === 'chain' ? 'On Tezos' : 'Everyone'; }

    async function resolveNames(addrs: string[]) {
      const need = addrs.filter((a) => !names.has(a));
      if (!need.length) return;
      need.forEach((a) => names.set(a, ''));
      try {
        const [domains, accounts] = await Promise.all([
          fetch(`${TZKT}/domains?address.in=${need.join(',')}&reverse=true&select=name,address&limit=200`).then((r) => r.ok ? r.json() : []),
          fetch(`${TZKT}/accounts?address.in=${need.join(',')}&select=address,alias&limit=200`).then((r) => r.ok ? r.json() : []),
        ]);
        for (const a of accounts || []) if (a?.alias) names.set(a.address, a.alias);
        for (const d of domains || []) { const addr = typeof d.address === 'string' ? d.address : d.address?.address; if (addr && d.name) names.set(addr, d.name); }
      } catch { /* names are decoration */ }
    }

    function card(c: Item, isNew = false): HTMLElement {
      const el = document.createElement('article');
      el.className = `cast ${c.source}` + (c.pending ? ' pending' : '') + (isNew ? ' is-new' : '');
      if (c.source === 'chain' && !c.pending && c.castId !== undefined) el.id = `cast-${c.castId}`;
      const name = c.source === 'chain' ? (names.get(c.author!) || SHORT(c.author!)) : c.who;
      const pfp = c.source === 'chain' ? `https://noun-api.com/beta/pfp?name=${c.author}&size=96` : `https://noun.pics/${c.noun ?? 0}.svg`;
      const nameEl = c.source === 'chain' ? `<a class="who" href="https://tzkt.io/${c.author}/operations" target="_blank" rel="noopener noreferrer">${esc(name)}</a>`
        : c.handle && c.verified ? `<a class="who" href="#@${c.handle}">${esc(name)}</a><span class="sw-check" title="Posted by the PointCast member who holds this card">✓</span> <a class="sw-at" href="#@${c.handle}">@${c.handle}</a>`
        : `<span class="who">${esc(name)}</span>`;
      const from = c.pending ? 'sending to Tezos…' : (FROM[c.source === 'chain' ? 'chain' : c.via] || 'from the bar');
      const stamp = c.pending ? `<a href="https://tzkt.io/${c.hash}" target="_blank" rel="noopener noreferrer">operation ↗</a>` : c.source === 'chain' ? `<a href="https://tzkt.io/${TOWER}/storage" target="_blank" rel="noopener noreferrer" title="${new Date(c.at).toLocaleString()}">${agoLong(c.at)}</a>` : `<time datetime="${c.at}" title="${new Date(c.at).toLocaleString()}">${agoLong(c.at)}</time>`;
      el.innerHTML = `<img class="pfp" src="${pfp}" alt="" width="48" height="48" loading="lazy" />
        <div class="cast-main">
          <p class="cast-body">${nameEl} ${linkify(c.body)}</p>${spotifyEmbed(c.body)}
          <p class="cast-meta">${stamp} <i>${esc(from)}</i></p>
        </div>
        <div class="cast-acts"></div>`;
      if (!c.pending) {
        const url = firstUrl(c.body), whoName = name;
        const draft = { kind: 'post' as const, postId: c.key, postAt: c.at, text: c.body, who: whoName, noun: c.noun ?? 0, source: c.source, url, title: '', site: '', image: '', description: '' };
        const acts = el.querySelector('.cast-acts')!;
        const reply = document.createElement('button'); reply.type = 'button'; reply.className = 'act-reply'; reply.title = 'Reply'; reply.setAttribute('aria-label', `Reply to ${whoName}`); reply.textContent = '↩';
        reply.addEventListener('click', () => { what.value = c.source === 'chain' ? `!↩#${c.castId} ` : `↩ ${whoName} · `; what.focus(); what.setSelectionRange(what.value.length, what.value.length); paintCount(); what.scrollIntoView({ block: 'center', behavior: 'smooth' }); });
        acts.append(keepButton(draft, `${whoName}'s post`, 'star'), reply);
        if (url) void fetchPreview(url).then((pv) => { if (!pv) return; Object.assign(draft, { title: pv.title, site: pv.site, image: pv.image, description: pv.description }); if (el.isConnected && !/open\.spotify\.com\//.test(url)) el.querySelector('.cast-body')!.after(previewCard(pv)); });
      }
      return el;
    }

    function keptCard(k: Keep): HTMLElement {
      const el = document.createElement('article'); el.className = 'cast kept';
      const img = document.createElement('img'); img.className = 'pfp'; img.alt = ''; img.width = 48; img.height = 48; img.loading = 'lazy'; img.referrerPolicy = 'no-referrer';
      img.src = k.kind === 'post' ? (k.source === 'chain' ? `https://noun-api.com/beta/pfp?name=${encodeURIComponent(k.who)}&size=96` : `https://noun.pics/${k.noun || 0}.svg`) : (k.image || 'https://noun.pics/0.svg');
      const main = document.createElement('div'); main.className = 'cast-main';
      const body = document.createElement('p'); body.className = 'cast-body';
      body.innerHTML = `<span class="who">${esc(k.kind === 'post' ? (k.who || 'visitor') : (k.site || 'a link'))}</span> ${k.text ? linkify(k.text) : ''}`;
      main.append(body);
      if (k.url && k.title) main.append(previewCard({ url: k.url, kind: /open\.spotify\.com/.test(k.url) ? 'spotify' : /youtu\.?be/.test(k.url) ? 'youtube' : 'page', site: k.site, title: k.title, description: k.description, image: k.image }));
      const meta = document.createElement('p'); meta.className = 'cast-meta'; meta.textContent = `kept ${agoLong(k.keptAt)} `;
      const from = document.createElement('i'); from.textContent = k.kind === 'post' ? (k.source === 'chain' ? 'from Tezos ⛓' : 'from the square') : 'a link you saved'; meta.append(from);
      main.append(meta);
      const acts = document.createElement('div'); acts.className = 'cast-acts';
      const drop = document.createElement('button'); drop.type = 'button'; drop.className = 'act-reply'; drop.title = 'Let it go'; drop.setAttribute('aria-label', 'Remove from your shelf'); drop.textContent = '×';
      drop.addEventListener('click', async () => { drop.disabled = true; await removeKeep(k.id); });
      acts.append(drop); el.append(img, main, acts);
      return el;
    }
    function renderKept() {
      older.hidden = true; fresh.hidden = true;
      const intro = document.createElement('p'); intro.className = 'muted kept-intro';
      intro.textContent = shelfMode() === 'account' ? 'Your shelf. It also lives on your profile.' : 'Your shelf, kept in this browser. Sign in and it moves onto your profile.';
      const link = document.createElement('a'); link.href = shelfMode() === 'account' ? '/me' : '/auth'; link.textContent = shelfMode() === 'account' ? ' Open your profile ↗' : ' Sign in ↗'; intro.append(link);
      if (!keeps.length) { const p = document.createElement('p'); p.className = 'muted'; p.textContent = 'Nothing kept yet. The star on any post puts it here.'; feed.replaceChildren(intro, p); return; }
      feed.replaceChildren(intro, ...keeps.map(keptCard));
    }

    function visible(): Item[] {
      const seen = new Set<string>();
      let items = (profile ? profileItems : tab === 'chain' ? [...live.filter((i) => i.source === 'chain'), ...chainItems] : [...live, ...barItems, ...chainItems])
        .filter((i) => (seen.has(i.key) ? false : (seen.add(i.key), true)))
        .sort((a, b) => b.at.localeCompare(a.at));
      if (tag) { const re = new RegExp(`(^|\\s)#${tag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}_-])`, 'iu'); items = items.filter((i) => re.test(i.body)); }
      return items;
    }
    function render(newKeys: Set<string> = new Set()) {
      if (tab === 'kept') { renderKept(); return; }
      const items = visible();
      feed.replaceChildren(...items.map((i) => card(i, newKeys.has(i.key))));
      if (!items.length) { const p = document.createElement('p'); p.className = 'muted'; p.textContent = profile ? (tag ? `Nothing from @${profile} tagged #${tag}.` : `Nothing from @${profile} yet.`) : tag ? `Nothing tagged #${tag} yet.` : tab === 'chain' ? 'Nothing on the tower yet.' : 'The square is quiet. Say the first thing.'; feed.append(p); }
      older.hidden = Boolean(profile) || tab === 'chain' || !cursor;
      paintTrends(); paintMine();
    }
    function paintTrends() {
      const counts = new Map<string, number>();
      for (const i of [...live, ...barItems, ...chainItems]) for (const m of i.body.matchAll(/(^|\s)#([\p{L}\p{N}_-]{1,40})/gu)) { const t = m[2].toLowerCase(); counts.set(t, (counts.get(t) || 0) + 1); }
      const top = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);
      const list = q('[data-trends]');
      if (!top.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = 'no tags yet. start one with #'; list.replaceChildren(li); return; }
      list.replaceChildren(...top.map(([t, n]) => { const li = document.createElement('li'); const a = document.createElement('a'); a.href = '#feed'; a.dataset.tag = t; a.textContent = `#${t}`; const s = document.createElement('small'); s.textContent = n === 1 ? 'once' : `${n} times`; li.append(a, s); return li; }));
    }
    function setTag(t: string | null) { tag = t; tagChip.hidden = !t; tagLabel.textContent = t ? `#${t}` : ''; if (tab === 'kept') { tab = 'all'; syncTabs(); } render(); }

    async function loadBar(more = false) {
      const res = await fetch('/api/shortwave' + (more && cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''), { headers: { accept: 'application/json' } });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(data?.error || 'Shortwave did not answer.');
      const page: Item[] = (data.posts || []).map(fromPost);
      barItems = more ? [...barItems, ...page] : page;
      cursor = data.nextCursor || null;
      for (let i = live.length - 1; i >= 0; i--) if (barItems.some((b) => b.key === live[i].key)) live.splice(i, 1);
    }
    async function loadChain() {
      const res = await fetch(`${TZKT}/contracts/${TOWER}/bigmaps/casts/keys?active=true&sort.desc=id&limit=40`);
      if (!res.ok) return;
      const rows = await res.json();
      chainItems = rows.map((r: any) => ({ key: `chain:${r.key}`, source: 'chain', via: 'chain', castId: Number(r.key), who: '', author: r.value.author, body: hex2str(r.value.body), at: r.value.cast_at }));
      await resolveNames([...new Set(chainItems.map((c) => c.author!))]);
      for (let i = live.length - 1; i >= 0; i--) if (live[i].source === 'chain' && chainItems.some((c) => c.author === live[i].author && c.body === live[i].body)) live.splice(i, 1);
    }
    async function load(more = false) {
      if (loading) return; loading = true; refresh.disabled = true; older.disabled = true;
      try {
        const results = await Promise.allSettled(more ? [loadBar(true)] : [loadBar(false), loadChain()]);
        if (!more && results[0].status === 'rejected' && !barItems.length && !chainItems.length) { feed.replaceChildren(); const p = document.createElement('p'); p.className = 'muted'; p.textContent = 'Could not reach the square. Try refresh.'; feed.append(p); return; }
        if (tab !== 'kept') render();
      } finally { loading = false; refresh.disabled = false; older.disabled = false; }
    }
    async function loadStats() {
      try {
        const [storage, authors] = await Promise.all([
          fetch(`${TZKT}/contracts/${TOWER}/storage`).then((r) => r.json()),
          fetch(`${TZKT}/contracts/${TOWER}/bigmaps/by_author/keys?select=key&limit=1000`).then((r) => r.json()),
        ]);
        q('[data-stat-casts]').textContent = String(Number(storage?.next_id ?? 0));
        q('[data-stat-authors]').textContent = String(Array.isArray(authors) ? authors.length : '—');
        q('[data-stat-last]').textContent = chainItems[0] ? agoLong(chainItems[0].at) : '—';
      } catch { /* decoration */ }
    }
    async function loadFaces() {
      try {
        const j = await (await fetch('/api/presence/snapshot', { cache: 'no-store' })).json();
        const sessions: any[] = Array.isArray(j.sessions) ? j.sessions : [];
        q('[data-stat-here]').textContent = String(Number(j.humans ?? 0) + Number(j.agents ?? 0));
        const list = q('[data-faces]');
        if (!sessions.length) { const li = document.createElement('li'); li.className = 'muted'; li.textContent = 'nobody on the map this minute'; list.replaceChildren(li); return; }
        list.replaceChildren(...sessions.slice(0, 36).map((s) => { const li = document.createElement('li'); li.dataset.noun = String(s.nounId ?? 0); const img = document.createElement('img'); img.src = `https://noun.pics/${Number(s.nounId) || 0}.svg`; img.alt = ''; img.width = 28; img.height = 28; img.loading = 'lazy'; li.title = `${s.kind === 'agent' ? 'An AI' : 'A visitor'}${s.country ? ` from ${s.country}` : ''}`; if (s.kind === 'agent') li.dataset.kind = 'agent'; li.append(img); return li; }));
      } catch { /* decoration */ }
    }

    // ── the box ──
    const chars = (s: string) => Array.from(s).length;
    function paintCount() { const left = 280 - chars(what.value.replace(/^!\s*/, '')); count.textContent = String(left); count.dataset.state = left < 0 ? 'over' : left <= 20 ? 'near' : ''; update.disabled = left < 0 || !what.value.trim(); update.textContent = /^!/.test(what.value.trim()) ? 'cast ⛓' : 'update'; }
    what.addEventListener('input', paintCount); paintCount();
    what.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); box.requestSubmit(); } });
    const append = (frag: string) => { if (what.value.includes(frag)) return; what.value = `${what.value.replace(/\s+$/, '')}${what.value.trim() ? ' ' : ''}${frag} `; paintCount(); what.focus(); };
    q('[data-chip-here]').addEventListener('click', () => {
      if (!navigator.geolocation) { status.textContent = 'No location on this device.'; return; }
      status.textContent = 'Finding you, roughly…';
      navigator.geolocation.getCurrentPosition((pos) => { append(`📍 ${pos.coords.latitude.toFixed(2)},${pos.coords.longitude.toFixed(2)}`); status.textContent = 'Added, rounded to about a kilometre.'; }, () => { status.textContent = 'Location was declined. Nothing added.'; }, { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 });
    });
    q('[data-chip-playing]').addEventListener('click', async () => {
      try { const t = await navigator.clipboard.readText(); const m = t.match(/https?:\/\/open\.spotify\.com\/[^\s]+/); if (m) { append(`♫ ${m[0].replace(/[?&]si=[^&]*/, '')}`); status.textContent = 'Added from your clipboard.'; return; } } catch { /* fall through */ }
      status.textContent = 'In Spotify: Share → Copy link, then tap ♫ again. Or just paste the link.';
    });
    box.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const text = what.value.replace(/\s+/g, ' ').trim();
      if (!text || update.disabled) return;
      update.disabled = true;
      if (/^!/.test(text)) {
        // Permanent casts are signed in the bar, where the wallet lives.
        const omni = document.querySelector<HTMLInputElement>('[data-pc-ref="fb-omni"]');
        if (omni && bar()) { omni.value = text; omni.dispatchEvent(new Event('input', { bubbles: true })); bar()!.requestSubmit(); what.value = ''; paintCount(); status.textContent = 'Handing it to your wallet…'; }
        else status.textContent = 'Tezos casts need the bar at the bottom of the page.';
        return;
      }
      if (bar()) { window.dispatchEvent(new CustomEvent('pc:shortwave:say', { detail: { text, via: 'page' } })); what.value = ''; paintCount(); status.textContent = 'Sending…'; return; }
      try {
        const data = await (await fetch('/api/shortwave', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text, via: 'page' }) })).json();
        if (data?.ok && data.post) { what.value = ''; try { const own = JSON.parse(sessionStorage.getItem('pc:shortwave:own') || '[]'); own.push(data.post.id); sessionStorage.setItem('pc:shortwave:own', JSON.stringify(own.slice(-30))); } catch { /* fine */ } window.dispatchEvent(new CustomEvent('pc:shortwave:post', { detail: { post: data.post, own: true, live: data.live } })); }
        else status.textContent = data?.error || 'Could not send that.';
      } catch { status.textContent = 'Could not send that.'; } finally { paintCount(); }
    });

    // ── live ──
    function paintNewBar() { fresh.hidden = !queued.length; fresh.textContent = queued.length === 1 ? '1 new update' : `${queued.length} new updates`; }
    function flush() { if (!queued.length) return; const keys = new Set(queued.map((i) => i.key)); live.unshift(...queued.splice(0)); paintNewBar(); if (tab === 'all' || tab === 'chain') render(keys); }
    fresh.addEventListener('click', () => { flush(); q('#feed').scrollIntoView({ block: 'start', behavior: 'smooth' }); });
    window.addEventListener('pc:shortwave:post', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {}; const p = d.post; if (!p?.id) return;
      const item: Item = fromPost(p);
      if (profile && item.handle === profile && !profileItems.some((i) => i.key === item.key)) profileItems.unshift(item);
      if ([...live, ...queued, ...barItems].some((i) => i.key === item.key)) return;
      // Your own words land at once. Other people's wait behind the bar if you are reading further down.
      if (d.own || (window.scrollY < 420 && tab === 'all')) { live.unshift(item); if (tab !== 'kept') render(new Set([item.key])); }
      else { queued.push(item); paintNewBar(); }
      if (d.own) status.textContent = d.live === false ? 'Updated.' : 'Updated. The whole town just saw it.';
      const face = root.querySelector<HTMLElement>(`[data-faces] li[data-noun="${Number(p.noun) || 0}"]`); if (face) { face.dataset.speaking = 'true'; setTimeout(() => { delete face.dataset.speaking; }, 5000); }
    });
    window.addEventListener('pc:shortwave:cast', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {};
