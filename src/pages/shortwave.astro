      else if (d.phase === 'confirmed') { status.textContent = 'Confirmed. It is on Tezos now, for good.'; void load(false).then(loadStats); }
      else if (d.phase === 'failed') { status.textContent = d.error ? `Could not cast: ${d.error}` : 'Cast cancelled.'; paintCount(); }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { if (profile) { closeProfile(false); history.replaceState(history.state, '', location.pathname + location.search); } tab = b.dataset.tab as typeof tab; if (tab === 'kept') { tag = null; tagChip.hidden = true; } syncTabs(); flush(); render(); q('#feed').scrollIntoView({ block: 'start' }); }));
    refresh.addEventListener('click', () => { flush(); void load(false).then(loadStats); void loadFaces(); });
    older.addEventListener('click', () => void load(true));
    q('[data-tag-clear]').addEventListener('click', () => setTag(null));
    root.addEventListener('click', (ev) => { const el = (ev.target as HTMLElement).closest<HTMLElement>('[data-tag]'); if (el) { ev.preventDefault(); setTag(el.dataset.tag!); q('#feed').scrollIntoView({ block: 'start' }); } });

    window.addEventListener('pc:keeps:change', (ev: Event) => { keeps = (ev as CustomEvent).detail?.keeps || []; q('[data-kept-count]').textContent = keeps.length ? String(keeps.length) : ''; q('[data-stat-kept]').textContent = String(keeps.length); if (tab === 'kept') render(); });
    void loadKeeps().then(() => { if (location.hash === '#kept') { tab = 'kept'; syncTabs(); render(); } });

    // ── town cards: your card, the editor, and /shortwave#@handle ──
    const editor = mountEditor(q<HTMLDialogElement>('[data-editor]'), () => mine, (card) => {
      mine = { ...mine, card }; paintMyCard(myCardEl, mine);
      if (card && profile === card.handle) void openProfile(card.handle);
      else if (card) location.hash = `@${card.handle}`;
    });
    const placeOf = (body: string) => { const m = body.match(/📍\s*(-?\d{1,2}\.\d+),\s*(-?\d{1,3}\.\d+)/); return m ? placeLabel(Number(m[1]), Number(m[2])) : ''; };
    function closeProfile(rerender = true) { profile = null; profileItems = []; profileCard = null; profileEl.hidden = true; profileEl.replaceChildren(); streamTitle.textContent = tab === 'kept' ? 'Kept' : tab === 'chain' ? 'On Tezos' : 'Everyone'; if (rerender) render(); }
    async function openProfile(handle: string) {
      const seq = ++profileSeq;
      profile = handle; profileItems = []; tag = null; tagChip.hidden = true;
      if (tab === 'kept') { tab = 'all'; syncTabs(); }
      streamTitle.textContent = `@${handle}`; profileEl.hidden = false;
      const wait = document.createElement('p'); wait.className = 'muted'; wait.textContent = `Tuning to @${handle}…`; profileEl.replaceChildren(wait);
      feed.replaceChildren(); older.hidden = true;
      let card: PublicCard | null = null;
      try { card = await loadCard(handle); } catch { if (seq === profileSeq) { wait.textContent = 'Could not load that card. Try refresh.'; } return; }
      if (seq !== profileSeq) return;
      profileCard = card;
      if (!card) { profileEl.replaceChildren(missingBanner(handle, mine)); render(); return; }
      const [posts, casts] = await Promise.all([
        fetch(`/api/shortwave?handle=${encodeURIComponent(handle)}`).then((r) => r.ok ? r.json() : null).catch(() => null),
        card.wallet ? fetch(`${TZKT}/contracts/${TOWER}/bigmaps/casts/keys?active=true&sort.desc=id&limit=40&value.author=${card.wallet}`).then((r) => r.ok ? r.json() : null).catch(() => null) : Promise.resolve(null),
      ]);
      if (seq !== profileSeq) return;
      const barPosts: Item[] = (posts?.posts || []).map(fromPost);
      const chainPosts: Item[] = Array.isArray(casts) ? casts.map((r: any) => ({ key: `chain:${r.key}`, source: 'chain', via: 'chain', castId: Number(r.key), who: '', author: r.value.author, body: hex2str(r.value.body), at: r.value.cast_at })) : [];
      if (card.wallet) names.set(card.wallet, card.name);
      profileItems = [...barPosts, ...chainPosts].sort((a, b) => b.at.localeCompare(a.at));
      const tags = new Map<string, number>();
      for (const i of profileItems) for (const m of i.body.matchAll(/(^|\s)#([\p{L}\p{N}_-]{1,40})/gu)) { const t = m[2].toLowerCase(); tags.set(t, (tags.get(t) || 0) + 1); }
      const places = [...new Set(profileItems.map((i) => placeOf(i.body)).filter(Boolean))];
      const stats = { updates: barPosts.length, more: Boolean(posts?.nextCursor), casts: card.wallet ? chainPosts.length : null, places, tags: [...tags.entries()].sort((a, b) => b[1] - a[1]), last: profileItems[0] ? agoShort(profileItems[0].at) : null };
      const banner = profileBanner(card, stats, mine.card?.handle === card.handle, (t) => setTag(t));
      const back = document.createElement('a'); back.href = '#feed'; back.className = 'sw-link sw-pro-back'; back.textContent = '← everyone';
      back.addEventListener('click', (ev) => { ev.preventDefault(); history.replaceState(history.state, '', location.pathname + location.search); closeProfile(); });
      profileEl.replaceChildren(back, banner);
      render();
      profileEl.scrollIntoView({ block: 'start' });
    }
    function route() {
      const hash = decodeURIComponent(location.hash.slice(1));
      if (hash === 'card') { editor(''); return; }
      const m = hash.match(/^@([a-z0-9-]{3,24})$/i);
      if (m) { void openProfile(m[1].toLowerCase()); return; }
      if (profile && !hash) closeProfile();
    }
    window.addEventListener('hashchange', route);
    root.addEventListener('click', (ev) => { const a = (ev.target as HTMLElement).closest<HTMLElement>('[data-claim]'); if (a) { ev.preventDefault(); editor(a.dataset.claim); } });
    void loadMine().then((m) => { mine = m; paintMyCard(myCardEl, mine); route(); });
    window.addEventListener('pc:auth-change', () => void loadMine().then((m) => { mine = m; paintMyCard(myCardEl, mine); }));
    window.addEventListener('pc:wallet-change', () => setTimeout(barIdentity, 300));
    setTimeout(barIdentity, 600);
    void load(false).then(loadStats); void loadFaces();
    const timers = [
      setInterval(() => { if (document.visibilityState === 'visible' && window.scrollY < 420 && !queued.length) void load(false); }, 60000),
      setInterval(() => { if (document.visibilityState === 'visible') void loadFaces(); }, 30000),
      setInterval(() => root.querySelectorAll<HTMLTimeElement>('.cast-meta time').forEach((t) => { t.textContent = agoLong(t.dateTime); }), 30000),
    ];
    document.addEventListener('astro:before-swap', () => timers.forEach(clearInterval), { once: true });
  }
  mount();
  document.addEventListener('astro:page-load', mount);
</script>

<style is:global>
  /* The town square, in the manner of the 2009 web: a sky, one white column, a
