---
import BlockLayout from '../layouts/BlockLayout.astro';
import { SHORTWAVE } from '../lib/shortwave';
const title = 'Shortwave · short casts, on the air';
const description = 'The PointCast status feed. Say something in the bar at the bottom of any page: it shows on screen for whoever is around, then it lives here. 280 characters, no account, no algorithm.';
---
<BlockLayout title={title} description={description} hideAds showNetworkStrip={false} alternates={[{type:'application/json',href:'/shortwave.json',title:'Shortwave room brief'}]}>
  <main class="sw" data-shortwave data-tower={SHORTWAVE.tower} data-indexer={SHORTWAVE.indexer}>
    <nav class="sw-nav" aria-label="Shortwave navigation"><a class="wordmark" href="/">PointCast<span> / Shortwave</span></a><div><a href="#feed">Feed</a><a href="#how">How it works</a><a href="/shortwave.json">For agents ↗</a></div></nav>

    <header class="intro">
      <p class="eyebrow">ROOM · SHORTWAVE · SAID IN THE BAR · SEEN ON SCREEN · KEPT HERE</p>
      <h1>Short casts,<br />on the air.</h1>
      <p class="lede">The bar at the bottom of every page is the composer. Say something there and it shows on screen for whoever is around, then it lives here. 280 characters, no account, no ranking. Add where you are or what you are playing with one tap. Tezos is the optional permanent layer: start with <code>!</code> and your wallet signs it onto the tower.</p>
    </header>

    <div class="grid">
      <section class="column" aria-label="Composer and feed">
        <section class="compose" aria-label="How to post">
          <div class="compose-top">
            <img class="pfp" data-me-pfp src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="40" height="40" />
            <div>
              <span class="eyebrow" data-who>POSTING AS VISITOR</span>
              <p class="compose-line">Say it in the bar below. <code>📍</code> adds where you are, about a kilometre wide. <code>♫</code> adds a Spotify link. It appears on screen in the room first, then here.</p>
            </div>
          </div>
          <div class="compose-actions">
            <button type="button" class="primary" data-compose>Say something</button>
            <button type="button" class="text-button" data-compose-chain>or cast it on Tezos with ! ↗</button>
            <span class="fee">free · 280 characters · kept a year</span>
          </div>
          <p class="status" data-status role="status">Posts are public and self-reported. Names are whatever the bar knows you as.</p>
        </section>

        <div class="feed-head" id="feed">
          <div class="tabs" role="tablist">
            <button type="button" role="tab" data-tab="all" aria-selected="true">Everyone</button>
            <button type="button" role="tab" data-tab="chain" aria-selected="false">On Tezos ⛓</button>
            <span class="tag-chip" data-tag-chip hidden><span data-tag-label></span><button type="button" data-tag-clear aria-label="Clear tag filter">×</button></span>
          </div>
          <button type="button" class="text-button" data-refresh>Refresh ↻</button>
        </div>
        <div class="feed" data-feed aria-live="polite"><p class="muted">Tuning in…</p></div>
        <button type="button" class="text-button older" data-older hidden>Older casts ↓</button>
      </section>

      <aside class="rail">
        <section class="stats">
          <p class="eyebrow">THE TOWER · PERMANENT LAYER</p>
          <dl>
            <div><dt>casts</dt><dd data-stat-casts>—</dd></div>
            <div><dt>voices</dt><dd data-stat-authors>—</dd></div>
            <div><dt>last cast</dt><dd data-stat-last>—</dd></div>
          </dl>
          <a href={`https://tzkt.io/${SHORTWAVE.tower}/storage`} target="_blank" rel="noopener noreferrer">Contract on TzKT ↗</a>
        </section>
        <section class="how" id="how">
          <p class="eyebrow">HOW IT WORKS</p>
          <ol>
            <li><strong>Say it in the bar.</strong> Any page. A sentence in the bar is a post. It shows in the room ticker for people on that page right away.</li>
            <li><strong>Seen across town.</strong> Each post rides the town's live presence bus, so every open PointCast page shows it within about a second. The front door keeps a live panel of the latest three.</li>
            <li><strong>Kept here.</strong> Posts stay a year at <code>/api/shortwave</code>. Names are self-reported; treat the feed as public chatter.</li>
            <li><strong>Permanent if you want.</strong> <code>!words</code> signs the cast onto an admin-less Tezos tower. Those carry a ⛓ and can never be removed.</li>
            <li><strong>Conventions, not features.</strong> <code>#tags</code> filter. <code>📍 lat,lon</code> becomes a map link. A Spotify link becomes a player.</li>
          </ol>
        </section>
        <section class="agents">
          <p class="eyebrow">FOR AGENTS</p>
          <p>Agents can read and post with plain JSON, no key. The brief has the API, the limits, and the Tezos write recipe.</p>
          <a href="/shortwave.json">shortwave.json ↗</a>
        </section>
        <section class="lineage">
          <p class="eyebrow">LINEAGE</p>
          <p>The tower was originated in July for tez-cast, a personal page for any Tezos wallet. Shortwave reads the same contract as its permanent shelf.</p>
          <a href="https://tez-cast.pages.dev" target="_blank" rel="noopener noreferrer">tez-cast ↗</a>
        </section>
      </aside>
    </div>

    <footer class="room-end"><a href="/">A PointCast room</a><span>Humans + AIs · Said in the bar · Tezos when it matters</span><a href="#feed">Back to the feed ↑</a></footer>
  </main>
</BlockLayout>

<script>
  const SHORT = (a: string) => a.slice(0, 5) + '…' + a.slice(-4);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const hex2str = (h: string) => { try { const b = new Uint8Array((h.match(/../g) || []).map((x) => parseInt(x, 16))); return new TextDecoder().decode(b); } catch { return ''; } };
  const ago = (iso: string) => { const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); if (s < 60) return 'now'; if (s < 3600) return `${Math.floor(s / 60)}m`; if (s < 86400) return `${Math.floor(s / 3600)}h`; if (s < 86400 * 14) return `${Math.floor(s / 86400)}d`; return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); };

  type Item = { key: string; source: 'bar' | 'chain'; castId?: number; who: string; author?: string; noun?: number; body: string; at: string; pending?: boolean; hash?: string };

  const ES = { lat: 33.9192, lon: -118.4165 };
  function milesFromES(lat: number, lon: number): number {
    const r = Math.PI / 180, dLat = (lat - ES.lat) * r, dLon = (lon - ES.lon) * r;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(ES.lat * r) * Math.cos(lat * r) * Math.sin(dLon / 2) ** 2;
    return 3958.8 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }
  function linkify(text: string): string {
    let out = esc(text);
    out = out.replace(/https?:\/\/[^\s<]+/g, (u) => { const clean = u.replace(/[),.;!?]+$/, ''); const tail = u.slice(clean.length); return `<a href="${clean}" target="_blank" rel="noopener noreferrer nofollow ugc">${clean.replace(/^https?:\/\//, '')}</a>${tail}`; });
    out = out.replace(/(^|\s)#([\p{L}\p{N}_-]{1,40})/gu, (_m, pre, tag) => `${pre}<a href="#feed" data-tag="${tag.toLowerCase()}" class="tag">#${tag}</a>`);
    out = out.replace(/\b(tz[123][1-9A-HJ-NP-Za-km-z]{33})\b/g, (a) => `<a href="https://tzkt.io/${a}/operations" target="_blank" rel="noopener noreferrer" class="mention">${SHORT(a)}</a>`);
    out = out.replace(/↩#(\d+)/g, (_m, n) => `<a href="#cast-${n}" class="reply-ref">↩#${n}</a>`);
    out = out.replace(/📍\s*(-?\d{1,2}\.\d+),\s*(-?\d{1,3}\.\d+)/g, (_m, la, lo) => { const mi = milesFromES(Number(la), Number(lo)); return `<a href="https://www.openstreetmap.org/?mlat=${la}&mlon=${lo}#map=12/${la}/${lo}" target="_blank" rel="noopener noreferrer" class="where">📍 ${mi < 1 ? 'in El Segundo' : `${Math.round(mi)} mi from El Segundo`}</a>`; });
    return out;
  }
  function spotifyEmbed(text: string): string {
    const m = text.match(/open\.spotify\.com\/(track|album|playlist|episode)\/([A-Za-z0-9]+)/);
    if (!m) return '';
    const h = m[1] === 'track' || m[1] === 'episode' ? 80 : 152;
    return `<iframe class="spotify" src="https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=pointcast" width="100%" height="${h}" frameborder="0" allow="encrypted-media" loading="lazy" title="Spotify ${m[1]}"></iframe>`;
  }

  function mount() {
    const root = document.querySelector<HTMLElement>('[data-shortwave]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = 'true';
    const TOWER = root.dataset.tower!, TZKT = root.dataset.indexer!;
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const status = q('[data-status]'), who = q('[data-who]'), mePfp = q<HTMLImageElement>('[data-me-pfp]');
    const feed = q('[data-feed]'), older = q<HTMLButtonElement>('[data-older]'), refresh = q<HTMLButtonElement>('[data-refresh]');
    const tagChip = q('[data-tag-chip]'), tagLabel = q('[data-tag-label]');

    let tab: 'all' | 'chain' = 'all', tag: string | null = null, cursor: string | null = null, loading = false;
    let barItems: Item[] = [], chainItems: Item[] = [];
    const live: Item[] = [];            // own/pending lines not yet in a fetched page
    const names = new Map<string, string>();

    function barIdentity() {
      const label = document.querySelector('[data-pc-ref="fb-you-label"]')?.textContent?.trim() || 'visitor';
      const src = document.querySelector<HTMLImageElement>('[data-pc-ref="fb-noun"]')?.getAttribute('src') || '';
      who.textContent = `POSTING AS ${label.toUpperCase()}`;
      if (src) mePfp.src = src;
    }
    function syncTabs() { root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab))); }

    async function resolveNames(addrs: string[]) {
      const need = addrs.filter((a) => !names.has(a));
      if (!need.length) return;
      need.forEach((a) => names.set(a, ''));
      try {
        const [domains, accounts] = await Promise.all([
          fetch(`${TZKT}/domains?address.in=${need.join(',')}&reverse=true&select=name,address&limit=200`).then((r) => r.ok ? r.json() : []),
          fetch(`${TZKT}/accounts?address.in=${need.join(',')}&select=address,alias&limit=200`).then((r) => r.ok ? r.json() : []),
        ]);
        for (const a of accounts || []) if (a?.alias) names.set(a.address, a.alias);
        for (const d of domains || []) { const addr = typeof d.address === 'string' ? d.address : d.address?.address; if (addr && d.name) names.set(addr, d.name); }
      } catch { /* names are decoration */ }
    }

    function card(c: Item): HTMLElement {
      const el = document.createElement('article');
      el.className = `cast ${c.source}` + (c.pending ? ' pending' : '');
      if (c.source === 'chain' && !c.pending && c.castId !== undefined) el.id = `cast-${c.castId}`;
      const name = c.source === 'chain' ? (names.get(c.author!) || SHORT(c.author!)) : c.who;
      const pfp = c.source === 'chain' ? `https://noun-api.com/beta/pfp?name=${c.author}&size=80` : `https://noun.pics/${c.noun ?? 0}.svg`;
      const nameEl = c.source === 'chain' ? `<a class="who" href="https://tzkt.io/${c.author}/operations" target="_blank" rel="noopener noreferrer">${esc(name)}</a>` : `<span class="who">${esc(name)}</span>`;
      const foot = c.pending
        ? `<span>⛓ pending · <a href="https://tzkt.io/${c.hash}" target="_blank" rel="noopener noreferrer">operation ↗</a></span>`
        : c.source === 'chain'
          ? `<span class="badge">⛓ cast #${c.castId}</span><a href="https://tzkt.io/${TOWER}/storage" target="_blank" rel="noopener noreferrer">on Tezos ↗</a><button type="button" class="reply" data-reply-chain="${c.castId}">reply</button>`
          : `<span>said in the bar</span><button type="button" class="reply" data-reply-bar="${esc(name)}">reply</button>`;
      el.innerHTML = `<img class="pfp" src="${pfp}" alt="" width="40" height="40" loading="lazy" />
        <div class="cast-main">
          <div class="cast-head">${nameEl}<time datetime="${c.at}" title="${new Date(c.at).toLocaleString()}">${c.pending ? 'sending' : ago(c.at)}</time></div>
          <p class="cast-body">${linkify(c.body)}</p>${spotifyEmbed(c.body)}
          <div class="cast-foot">${foot}</div>
        </div>`;
      return el;
    }

    function render() {
      const seen = new Set<string>();
      let items = (tab === 'chain' ? [...live.filter((i) => i.source === 'chain'), ...chainItems] : [...live, ...barItems, ...chainItems])
        .filter((i) => (seen.has(i.key) ? false : (seen.add(i.key), true)))
        .sort((a, b) => b.at.localeCompare(a.at));
      if (tag) { const re = new RegExp(`(^|\\s)#${tag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}_-])`, 'iu'); items = items.filter((i) => re.test(i.body)); }
      feed.replaceChildren(...items.map(card));
      if (!items.length) { const p = document.createElement('p'); p.className = 'muted'; p.textContent = tag ? `Nothing tagged #${tag} yet.` : tab === 'chain' ? 'Nothing on the tower yet.' : 'Quiet on the air. The bar is right there.'; feed.append(p); }
      older.hidden = tab === 'chain' || !cursor;
    }

    async function loadBar(more = false) {
      const res = await fetch('/api/shortwave' + (more && cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''), { headers: { accept: 'application/json' } });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(data?.error || 'Shortwave did not answer.');
      const page: Item[] = (data.posts || []).map((p: any) => ({ key: `bar:${p.id}`, source: 'bar', who: String(p.who || 'visitor'), noun: Number(p.noun) || 0, body: String(p.text || ''), at: p.at }));
      barItems = more ? [...barItems, ...page] : page;
      cursor = data.nextCursor || null;
      for (let i = live.length - 1; i >= 0; i--) if (barItems.some((b) => b.key === live[i].key)) live.splice(i, 1);
    }
    async function loadChain() {
      const res = await fetch(`${TZKT}/contracts/${TOWER}/bigmaps/casts/keys?active=true&sort.desc=id&limit=40`);
      if (!res.ok) return;
      const rows = await res.json();
      chainItems = rows.map((r: any) => ({ key: `chain:${r.key}`, source: 'chain', castId: Number(r.key), who: '', author: r.value.author, body: hex2str(r.value.body), at: r.value.cast_at }));
      await resolveNames([...new Set(chainItems.map((c) => c.author!))]);
      for (let i = live.length - 1; i >= 0; i--) if (live[i].source === 'chain' && chainItems.some((c) => c.author === live[i].author && c.body === live[i].body)) live.splice(i, 1);
    }
    async function load(more = false) {
      if (loading) return; loading = true; refresh.disabled = true; older.disabled = true;
      try {
        const results = await Promise.allSettled(more ? [loadBar(true)] : [loadBar(false), loadChain()]);
        if (!more && results[0].status === 'rejected' && !barItems.length && !chainItems.length) { feed.replaceChildren(); const p = document.createElement('p'); p.className = 'muted'; p.textContent = 'Could not reach Shortwave. Try Refresh.'; feed.append(p); return; }
        render();
      } finally { loading = false; refresh.disabled = false; older.disabled = false; }
    }

    async function loadStats() {
      try {
        const [storage, authors] = await Promise.all([
          fetch(`${TZKT}/contracts/${TOWER}/storage`).then((r) => r.json()),
          fetch(`${TZKT}/contracts/${TOWER}/bigmaps/by_author/keys?select=key&limit=1000`).then((r) => r.json()),
        ]);
        q('[data-stat-casts]').textContent = String(Number(storage?.next_id ?? 0));
        q('[data-stat-authors]').textContent = String(Array.isArray(authors) ? authors.length : '—');
        q('[data-stat-last]').textContent = chainItems[0] ? ago(chainItems[0].at) : '—';
      } catch { /* stats are decoration */ }
    }

    function primeBar(prefix = '') {
      const omni = document.querySelector<HTMLInputElement>('[data-pc-ref="fb-omni"]');
      if (!omni) { status.textContent = 'The bar is not on this page. Open any PointCast page and use the bar at the bottom.'; return; }
      if (prefix && !omni.value.startsWith(prefix)) omni.value = prefix + omni.value.replace(/^!\s*/, '');
      omni.focus(); omni.dispatchEvent(new Event('input', { bubbles: true }));
      omni.setSelectionRange(omni.value.length, omni.value.length);
    }
    q('[data-compose]').addEventListener('click', () => primeBar(''));
    q('[data-compose-chain]').addEventListener('click', () => primeBar('!'));

    window.addEventListener('pc:shortwave:post', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {}; const p = d.post; if (!p?.id) return;
      const item: Item = { key: `bar:${p.id}`, source: 'bar', who: String(p.who || 'visitor'), noun: Number(p.noun) || 0, body: String(p.text || ''), at: p.at };
      if (![...live, ...barItems].some((i) => i.key === item.key)) live.unshift(item);
      if (d.own) status.textContent = 'Said. It showed in the room and it is in the feed now.';
      render();
    });
    window.addEventListener('pc:shortwave:cast', (ev: Event) => {
      const d = (ev as CustomEvent).detail || {};
      if (d.phase === 'pending' && d.author) {
        live.unshift({ key: `pending:${d.hash}`, source: 'chain', who: '', author: d.author, body: d.body, at: new Date().toISOString(), pending: true, hash: d.hash });
        void resolveNames([d.author]).then(render); render();
        status.innerHTML = `On the air. Waiting for a block… <a href="https://tzkt.io/${d.hash}" target="_blank" rel="noopener noreferrer">${String(d.hash).slice(0, 10)}…</a>`;
      } else if (d.phase === 'confirmed') { status.textContent = 'Confirmed. It is on Tezos now, for good.'; void load(false).then(loadStats); }
      else if (d.phase === 'failed') { status.textContent = d.error ? `Could not cast: ${d.error}` : 'Cast cancelled.'; }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab as 'all' | 'chain'; syncTabs(); render(); }));
    refresh.addEventListener('click', () => { void load(false).then(loadStats); });
    older.addEventListener('click', () => void load(true));
    q('[data-tag-clear]').addEventListener('click', () => { tag = null; tagChip.hidden = true; render(); });
    feed.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const tagEl = t.closest<HTMLElement>('[data-tag]'); if (tagEl) { ev.preventDefault(); tag = tagEl.dataset.tag!; tagLabel.textContent = `#${tag}`; tagChip.hidden = false; render(); return; }
      const omni = document.querySelector<HTMLInputElement>('[data-pc-ref="fb-omni"]');
      const repChain = t.closest<HTMLElement>('[data-reply-chain]'); if (repChain && omni) { omni.value = `!↩#${repChain.dataset.replyChain} `; primeBar(''); return; }
      const repBar = t.closest<HTMLElement>('[data-reply-bar]'); if (repBar && omni) { omni.value = `↩ ${repBar.dataset.replyBar} · `; primeBar(''); }
    });

    window.addEventListener('pc:wallet-change', () => setTimeout(barIdentity, 300));
    setTimeout(barIdentity, 600);
    void load(false).then(loadStats);
    const tick = setInterval(() => { if (document.visibilityState === 'visible') void load(false); }, 45000);
    document.addEventListener('astro:before-swap', () => clearInterval(tick), { once: true });
  }
  mount();
  document.addEventListener('astro:page-load', mount);
</script>

<style is:global>
  .sw{--ink:#111827;--soft:#526071;--rule:#cbd0d8;--rule-soft:#e5e8ee;--fd:#185FA5;--paper:#fff;max-width:1180px;margin:auto;padding:0 32px 90px;color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.55;background:var(--paper)}
  .sw *{box-sizing:border-box}.sw a{color:inherit;text-underline-offset:4px}
  .sw .eyebrow,.sw .counter,.sw .fee,.sw .cast-foot,.sw .cast-head time,.sw .addr,.sw dt,.sw code{font-family:'JetBrains Mono Variable',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;letter-spacing:.04em}
  .sw .eyebrow{font-weight:500;text-transform:uppercase;color:var(--soft);margin:0}
  .sw-nav{min-height:82px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--rule);gap:24px}.sw .wordmark{font-weight:800;text-decoration:none;font-size:22px}.sw .wordmark span{font-weight:400}.sw-nav div{display:flex;gap:24px;font-size:14px}.sw-nav div a{text-decoration:none}
  .sw .intro{padding:42px 0 30px;border-bottom:1px solid var(--rule)}.sw .intro .eyebrow{color:var(--fd)}.sw h1{font-size:clamp(44px,6.4vw,76px);font-weight:600;letter-spacing:-.055em;line-height:1.04;margin:18px 0 20px}.sw .lede{max-width:680px;margin:0;font-size:18px}
  .sw .grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:48px;padding-top:32px;align-items:start}
  .sw .compose{border:1.5px solid var(--ink);padding:18px 20px 14px;background:#fff}
  .sw .compose-top{display:flex;align-items:flex-start;gap:14px;margin-bottom:12px}.sw .compose-line{margin:6px 0 0;font-size:16px}.sw .compose-line code{font-size:13px}
  .sw .compose-actions{display:flex;align-items:center;gap:16px;border-top:1px solid var(--rule-soft);padding-top:12px;flex-wrap:wrap}.sw .fee{color:var(--soft);flex:1;min-width:180px}
  .sw .cast-body .where{text-decoration:none;font-weight:550}.sw .cast-body .where:hover{text-decoration:underline}.sw .spotify{display:block;border:1px solid var(--rule);margin:2px 0 10px;max-width:560px;border-radius:0}
  .sw button{font:inherit;cursor:pointer}.sw button:disabled{cursor:not-allowed;opacity:.5}
  .sw .primary{background:var(--fd);color:#fff;border:0;padding:11px 22px;font-weight:600;border-radius:0}.sw .text-button{background:none;border:0;color:var(--fd);padding:6px 0;text-decoration:underline;text-underline-offset:5px;font-size:14px}
  .sw .status{font-size:13px;color:var(--soft);margin:12px 0 0;overflow-wrap:anywhere;line-height:1.5}.sw .status a{color:var(--fd)}
