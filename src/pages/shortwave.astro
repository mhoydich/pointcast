    --sw-ink: var(--ink); --sw-accent: var(--link); --sw-rule: var(--rule); --sw-soft: var(--soft); --sw-shadow: #dbe9f0; --sw-card-bg: var(--page);
    position: relative; isolation: isolate; width: 100vw; margin-inline: calc(50% - 50vw); min-height: 100vh; padding: 0 16px 120px; color: var(--ink); font: 15px/1.5 'Lucida Grande', 'Lucida Sans Unicode', 'Helvetica Neue', Helvetica, Arial, sans-serif; background: linear-gradient(var(--sky-1) 0, var(--sky-2) 320px, var(--sky-3) 760px); }
