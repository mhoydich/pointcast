---
/**
 * /faucet/fishclub — one FISHCLUB for five quiet minutes.
 *
 * Lighter than the HELLO desk on purpose. FISHCLUB has no daily button: the
 * token is the ending of something you did on Tone Bloom, so the page explains
 * the run, hands you the desk, and gets out of the way.
 *
 * This is also the landing page a Tone Bloom receipt comes back to, at
 * /faucet/fishclub#receipt=…. FaucetDesk reads the fragment once and strips it
 * before anything else runs; no third-party embed or script loads here.
 * Referrer-Policy is no-referrer for this route (public/_headers) and the meta
 * below carries it for anything that ignores the header.
 *
 * FISHCLUB is a greeting with no promised value, and no price or trading
 * surface anywhere. Sending stays closed for every faucet for now.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import FaucetDesk from '../../components/FaucetDesk.astro';
import { FAUCET_DEFAULT_DAILY_CAP, explorerTokenUrl, getFaucet, shortAddress } from '../../lib/faucet';
import { getRewardProgram } from '../../lib/rewards';

const faucet = getFaucet('fishclub')!;
const program = getRewardProgram('fishclub-tonebloom')!;
const startHref = `/rewards/start?program=${program.id}`;
const title = 'The Faucet · one FISHCLUB for five quiet minutes';
const description = 'Listen for five minutes on Tone Bloom and keep one FISHCLUB on PointCast. No wallet, nothing to sign, and no reason to hurry.';
const poster = '/images/faucet/hello-poster-fish.webp';
const canonical = 'https://pointcast.xyz/faucet/fishclub';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  name: title,
  description,
  image: `https://pointcast.xyz${poster}`,
  about: {
    '@type': 'Thing',
    name: faucet.name,
    identifier: faucet.contract,
    url: explorerTokenUrl(faucet),
  },
};
const steps = [
  {
    n: 1,
    title: 'Listen five minutes',
    body: 'Start the Fish Club room on Tone Bloom. One slow mix, one still picture. Pause if you need to; the run waits two hours.',
  },
  {
    n: 2,
    title: 'Keep the fish here',
    body: 'Tone Bloom sends you back with a signed finish. One click on this desk writes one line: this account is owed one FISHCLUB.',
  },
  {
    n: 3,
    title: 'Send it anywhere later',
    body: 'It sits in the ledger until you want it somewhere. Sending is closed for every token right now, and the desk says so rather than pretending.',
  },
];
---

<BlockLayout title={title} description={description} image="/images/faucet/hello-og-fish.png" imageWidth={1200} imageHeight={630} themeColor={faucet.color} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/faucet/fishclub.json', title: 'Faucet JSON' }]}>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main class="faucet" data-faucet-page style={`--spigot:${faucet.color}`}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/faucet">The Faucet</a><span>/</span><span>FISHCLUB</span><a href="/faucet/fishclub.json">JSON</a>
    </nav>

    <header class="mast">
      <p class="kicker">The Faucet · Ethereum mainnet · earned, not dripped · resets midnight Pacific</p>
      <h1>Five quiet minutes.<br /><em>A fish to keep.</em></h1>
      <p>{faucet.greeting} Mike deployed FISHCLUB in {faucet.deployedYear}, it has no value, and it never will. Listening is free and always will be; the fish is just what the ending leaves you with.</p>
    </header>

    <section class="hero" aria-labelledby="today-title">
      <figure class="hero__plate">
        <img src={poster} alt="A monochrome screen-print poster with one flat cut-paper fish swimming through the open right third, four figures resting at the edge of a pool below." width="1024" height="1536" fetchpriority="high" />
        <figcaption>FISHCLUB · {shortAddress(faucet.contract)} · deployed {faucet.deployedYear} · <a href={explorerTokenUrl(faucet)} target="_blank" rel="noopener">etherscan ↗</a></figcaption>
      </figure>
      <div class="hero__desk">
        <p class="kicker">Today · <span data-faucet-day>America/Los_Angeles</span></p>
        <h2 id="today-title">Keep it.</h2>
        <p class="hero__sub">{faucet.dailyAmount} {faucet.ticker} per account per day · {FAUCET_DEFAULT_DAILY_CAP} a day for the whole town</p>
        <div class="hero__claim">
          <FaucetDesk faucet={faucet} returnTo="/faucet/fishclub" />
        </div>
        <p class="hero__aside">Not started yet? <a href={startHref}>Begin the five minutes on Tone Bloom.</a></p>
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <div class="steps__head">
        <div><p class="kicker">What actually happens</p><h2 id="steps-title">Three steps, <em>zero signatures.</em></h2></div>
        <a href="/faucet/hello">The HELLO spigot →</a>
      </div>
      <ol class="steps__grid">
        {steps.map((step) => (
          <li>
            <span class="steps__n">{String(step.n).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="steps__foot">
        Tone Bloom counts the time on its own server and signs the finish; PointCast checks that signature, checks it is your run, and writes one line. Nothing about that is proof that anyone listened, and it is not meant to be. It is a capped greeting with a five minute door on it.
      </p>
    </section>

    <section class="why" aria-labelledby="why-title">
      <div class="why__copy">
        <p class="kicker">Why five minutes</p>
        <h2 id="why-title">The room stays open <em>either way.</em></h2>
        <p>You can listen for as long as you like without an account, and nothing asks you for one. The rewarded route takes a short trip through PointCast first so the finish belongs to you rather than to whoever holds the link. One fish per account per day, {FAUCET_DEFAULT_DAILY_CAP} a day for the town, and repeat listening earns nothing extra on purpose.</p>
        <p class="why__links"><a href={startHref}>Start the run</a> · <a href="/faucet/hello">HELLO</a> · <a href="/eth-legacy">The 2019 tokens</a></p>
      </div>
    </section>
  </main>
</BlockLayout>

<script>
  function mount(): void {
    const node = document.querySelector<HTMLElement>('[data-faucet-day]');
    if (!node) return;
    // The desk owns every number on this page; the date is the one thing worth
    // saying before any fetch resolves.
    node.textContent = `${new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date())} · America/Los_Angeles`;
  }
  mount();
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .faucet { width: min(1180px, calc(100vw - 28px)); margin: 0 auto; padding: 22px 0 90px; }
  .crumb, .kicker, figcaption, .hero__aside, .steps__n, .why__links { font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; color: var(--pc-ink-muted); }
  .crumb a:last-child { margin-left: auto; }
  .mast { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .55fr); gap: 24px; align-items: end; border-top: 2px solid var(--pc-ink); padding: 20px 0 26px; }
  .kicker { margin: 0 0 10px; color: var(--spigot); }
  h1, h2 { margin: 0; font-weight: 400; letter-spacing: -.055em; line-height: .88; }
  h1 { grid-column: 1; font-size: clamp(40px, 6.6vw, 84px); }
  h1 em, h2 em { color: var(--spigot); font-style: normal; }
  .mast > p:last-child { grid-column: 2; margin: 0; color: var(--pc-ink-soft); font-size: 16px; line-height: 1.5; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(330px, .95fr); border: 1.5px solid var(--pc-ink); }
  .hero__plate { position: relative; min-height: 520px; margin: 0; background: #f3ecdc; }
  .hero__plate img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__plate figcaption { position: absolute; left: 12px; bottom: 12px; padding: 6px 8px; background: rgba(255,255,255,.88); color: var(--pc-ink); }
  .hero__plate figcaption a { color: inherit; }
  .hero__desk { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(24px, 5vw, 60px); border-left: 1.5px solid var(--pc-ink); background: var(--spigot); color: #fff; }
  .hero__desk .kicker { color: rgba(255,255,255,.72); }
  .hero__desk h2 { font-size: clamp(48px, 7vw, 88px); }
  .hero__sub { margin: 14px 0 0; font-size: 15px; line-height: 1.4; color: rgba(255,255,255,.88); }
  .hero__claim { margin-top: 28px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.36); }
  .hero__aside { margin: 18px 0 0; color: rgba(255,255,255,.72); text-transform: none; letter-spacing: 0; font-size: 12px; }
  .hero__aside a { color: #fff; }
  .steps, .why { margin-top: 46px; }
  .steps__head { display: flex; justify-content: space-between; align-items: end; gap: 16px; padding-bottom: 16px; border-bottom: 2px solid var(--pc-ink); }
  .steps__head a { font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--pc-ink); white-space: nowrap; }
  h2 { font-size: clamp(34px, 5vw, 60px); }
  .steps__grid { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--pc-ink); }
  .steps__grid li { padding: 18px 16px 22px; border-right: 1px solid var(--pc-ink); border-bottom: 1px solid var(--pc-ink); background: #fff; }
  .steps__n { display: block; color: var(--spigot); }
  .steps__grid h3 { margin: 14px 0 8px; font-size: 22px; font-weight: 400; letter-spacing: -.03em; line-height: 1; }
  .steps__grid p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--pc-ink-soft); }
  .steps__foot { max-width: 760px; margin: 18px 0 0; font-size: 15px; line-height: 1.55; color: var(--pc-ink-soft); }
  .why__copy { max-width: 760px; }
  .why__copy p { margin: 16px 0 0; font-size: 16px; line-height: 1.55; color: var(--pc-ink-soft); }
  .why__links { margin-top: 20px; color: var(--pc-ink-muted); }
  .why__links a { color: var(--pc-ink); }
  @media (max-width: 900px) { .steps__grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .faucet { width: min(100% - 20px, 1180px); }
    .mast { grid-template-columns: 1fr; }
    .mast > p:last-child { grid-column: 1; }
    .hero { grid-template-columns: 1fr; }
    .hero__plate { min-height: 0; }
    .hero__desk { border-left: 0; border-top: 1.5px solid var(--pc-ink); }
  }
</style>
