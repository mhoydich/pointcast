---
import BlockLayout from "../../layouts/BlockLayout.astro";
import {
  NOUN_BATTLER_ANNUAL_CAMPAIGN,
  NOUN_BATTLER_PROMO_DISPATCHES,
  NOUN_BATTLER_PROMO_LINKS,
} from "../../lib/noun-battler-annual-promotion";

const description =
  "Three copy-ready sports-desk dispatches, original editorial plates, proof links, and a native share control for The Battle Record.";
---

<BlockLayout
  title="The Battle Record · Promotion Desk"
  description={description}
  image="/noun-battler-annual/plates/02-thirty-against-thirty.jpg"
  imageWidth={1536}
  imageHeight={1024}
  alternates={[
    {
      type: "application/json",
      href: "/noun-battler-annual/share.json",
      title: "The Battle Record promotion packet",
    },
  ]}
>
  <main class="nbp" data-noun-battler-promotion>
    <header class="nbp__masthead">
      <div class="nbp__flag">
        <a href="/">POINTCAST</a>
        <span>CH.BTL / PROMOTION DESK</span>
        <a href="/noun-battler-annual/share.json">JSON ↗</a>
      </div>
      <div class="nbp__lead">
        <div>
          <p>OPENING WEEK · HOUSE CAMPAIGN · NO PAID MEDIA</p>
          <h1>MAKE<br />THE SPORT<br /><em>TRAVEL.</em></h1>
        </div>
        <figure>
          <img
            src="/noun-battler-annual/plates/02-thirty-against-thirty.jpg"
            alt="Thirty Against Thirty, the stadium editorial plate from The Battle Record."
            width="1536"
            height="1024"
            fetchpriority="high"
          />
          <figcaption>PLATE 02 / THIRTY AGAINST THIRTY</figcaption>
        </figure>
      </div>
      <div class="nbp__scoreline" aria-label="Campaign facts">
        <span>3 DISPATCHES</span>
        <span>3 EDITORIAL PLATES</span>
        <span>1 PLAYABLE HISTORY</span>
        <span>0 ODDS / 0 WAGERS</span>
      </div>
    </header>

    <section class="nbp__brief" aria-labelledby="nbp-brief-title">
      <p>THE ASSIGNMENT</p>
      <h2 id="nbp-brief-title">Do not explain the whole league. Open one irresistible door.</h2>
      <div>
        <p>
          The strongest promotion is not “we published a long article.” It is the stranger
          fact that a three-button browser duel accumulated gangs, weather, broadcasters,
          agents, archives, a Bowl, and the bureaucratic dignity of a real sport.
        </p>
        <p>
          Use one dispatch at a time. The cover story sells the history, the league dispatch
          sells the spectacle, and the press-box challenge asks people to touch the issue.
          Every route points back to the same canonical annual.
        </p>
      </div>
    </section>

    <section class="nbp__dispatches" aria-labelledby="nbp-dispatches-title">
      <div class="nbp__section-head">
        <p>COPY DESK / READY TO RUN</p>
        <h2 id="nbp-dispatches-title">Three dispatches from the imaginary sports page.</h2>
      </div>
      <ol>
        {NOUN_BATTLER_PROMO_DISPATCHES.map((dispatch, index) => (
          <li>
            <article class="nbp__dispatch">
              <a class="nbp__dispatch-art" href={dispatch.href}>
                <img
                  src={dispatch.image}
                  alt={dispatch.alt}
                  width="1536"
                  height="1024"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <span>{String(index + 1).padStart(2, "0")} / 03</span>
              </a>
              <div class="nbp__dispatch-copy">
                <p>{dispatch.label} · {dispatch.id}</p>
                <h3>{dispatch.headline}</h3>
                <p>{dispatch.copy}</p>
                <blockquote>{dispatch.shareCopy}</blockquote>
                <div class="nbp__dispatch-actions">
                  <button type="button" data-copy-dispatch={index}>COPY DISPATCH</button>
                  <a href={dispatch.href}>{dispatch.cta.toUpperCase()} ↗</a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ol>
      <p class="nbp__status" data-share-status aria-live="polite">Copy desk ready.</p>
    </section>

    <section class="nbp__proof" aria-labelledby="nbp-proof-title">
      <div>
        <p>PUBLIC RECEIPTS</p>
        <h2 id="nbp-proof-title">The campaign keeps its own box score.</h2>
      </div>
      <dl>
        <div><dt>CAMPAIGN</dt><dd>{NOUN_BATTLER_ANNUAL_CAMPAIGN.id}</dd></div>
        <div><dt>PLACEMENT</dt><dd>{NOUN_BATTLER_ANNUAL_CAMPAIGN.placement}</dd></div>
        <div><dt>MEASUREMENT</dt><dd>{NOUN_BATTLER_ANNUAL_CAMPAIGN.tracking}</dd></div>
        <div><dt>BOUNDARY</dt><dd>Context, never visitor behavior</dd></div>
      </dl>
      <nav aria-label="Campaign proof links">
        <a href={NOUN_BATTLER_PROMO_LINKS.canonical}>ANNUAL</a>
        <a href={NOUN_BATTLER_PROMO_LINKS.machineEdition}>MACHINE EDITION</a>
        <a href={NOUN_BATTLER_PROMO_LINKS.pressFiling}>PRESS FILING</a>
        <a href={NOUN_BATTLER_PROMO_LINKS.campaignReceipt}>CAMPAIGN RECEIPT</a>
        <a href={NOUN_BATTLER_PROMO_LINKS.campaignReport}>LIVE COUNTS</a>
      </nav>
      <button class="nbp__native-share" type="button" data-native-share>
        SEND THE COVER STORY ↗
      </button>
    </section>
  </main>

  <script id="noun-battler-promo-dispatches" type="application/json" set:html={JSON.stringify(NOUN_BATTLER_PROMO_DISPATCHES)} />
  <script>
    const root = document.querySelector("[data-noun-battler-promotion]");
    const payload = document.querySelector("#noun-battler-promo-dispatches");
    const status = root?.querySelector("[data-share-status]");
    let dispatches: Array<{ shareCopy: string; headline: string }> = [];

    try {
      dispatches = JSON.parse(payload?.textContent || "[]");
    } catch {
      dispatches = [];
    }

    async function copyText(text: string) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const area = document.createElement("textarea");
      area.value = text;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.append(area);
      area.select();
      document.execCommand("copy");
      area.remove();
    }

    root?.querySelectorAll<HTMLButtonElement>("[data-copy-dispatch]").forEach((button) => {
      button.addEventListener("click", async () => {
        const index = Number(button.dataset.copyDispatch);
        const dispatch = dispatches[index];
        if (!dispatch) return;
        try {
          await copyText(dispatch.shareCopy);
          if (status) status.textContent = `${dispatch.headline} copied to the clipboard.`;
          button.textContent = "COPIED";
          window.setTimeout(() => {
            button.textContent = "COPY DISPATCH";
          }, 1800);
        } catch {
          if (status) status.textContent = "Copy was blocked. Select the dispatch text directly.";
        }
      });
    });

    root?.querySelector<HTMLButtonElement>("[data-native-share]")?.addEventListener("click", async () => {
      const first = dispatches[0];
      if (!first) return;
      if (navigator.share) {
        try {
          await navigator.share({
            title: "The Battle Record",
            text: first.headline,
            url: "https://pointcast.xyz/noun-battler-annual",
          });
          if (status) status.textContent = "The cover story left the desk.";
          return;
        } catch {
          // A dismissed native sheet falls through to a useful clipboard copy.
        }
      }
      try {
        await copyText(first.shareCopy);
        if (status) status.textContent = "Cover-story dispatch copied to the clipboard.";
      } catch {
        if (status) status.textContent = "Share was blocked. Use the canonical annual link.";
      }
    });
  </script>
</BlockLayout>

<style>
  :global(body:has(.nbp)) {
    background: #d8b956;
  }

  .nbp,
  .nbp * {
    box-sizing: border-box;
  }

  .nbp {
    --paper: #e9d58b;
    --ink: #19140d;
    --red: #9f271e;
    --blue: #173d65;
    --cream: #f5e8bd;
    min-height: 100vh;
    color: var(--ink);
    background:
      repeating-linear-gradient(0deg, rgba(32, 21, 8, 0.025) 0 1px, transparent 1px 4px),
      var(--paper);
    font-family: Georgia, "Times New Roman", serif;
  }

  .nbp a {
    color: inherit;
  }

  .nbp__masthead {
    padding: 20px clamp(18px, 4vw, 58px) 0;
    color: var(--cream);
    background: var(--blue);
  }

  .nbp__flag,
  .nbp__scoreline,
  .nbp__section-head > p,
  .nbp__brief > p,
  .nbp__dispatch-copy > p:first-child,
  .nbp__dispatch-actions,
  .nbp__proof > div > p,
  .nbp__proof dt,
  .nbp__proof nav,
  .nbp__native-share,
  .nbp__status {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .nbp__flag {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid currentColor;
  }

  .nbp__flag a {
    text-decoration: none;
  }

  .nbp__flag a:last-child {
    text-align: right;
  }

  .nbp__lead {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(520px, 1.18fr);
    gap: clamp(26px, 5vw, 76px);
    align-items: end;
    min-height: 68vh;
    padding: clamp(34px, 6vw, 86px) 0;
  }

  .nbp__lead p {
    margin: 0 0 24px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .nbp__lead h1 {
    margin: 0;
    font-family: "Arial Narrow", Impact, sans-serif;
    font-size: clamp(78px, 10.5vw, 166px);
    font-stretch: condensed;
    font-weight: 950;
    letter-spacing: -0.075em;
    line-height: 0.69;
  }

  .nbp__lead h1 em {
    color: #f0643c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.78em;
    font-weight: 700;
  }

  .nbp__lead figure {
    margin: 0;
    border: 1px solid var(--cream);
    background: var(--ink);
  }

  .nbp__lead img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.05);
  }

  .nbp__lead figcaption {
    padding: 9px 12px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.13em;
  }

  .nbp__scoreline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 calc(clamp(18px, 4vw, 58px) * -1);
    color: var(--ink);
    background: #f0643c;
  }

  .nbp__scoreline span {
    padding: 14px;
    border-right: 1px solid var(--ink);
    text-align: center;
  }

  .nbp__scoreline span:last-child {
    border-right: 0;
  }

  .nbp__brief,
  .nbp__dispatches,
  .nbp__proof {
    padding: clamp(42px, 7vw, 108px) clamp(18px, 5vw, 76px);
  }

  .nbp__brief {
    display: grid;
    grid-template-columns: 0.3fr 1.25fr 1fr;
    gap: clamp(22px, 4vw, 60px);
    border-bottom: 2px solid var(--ink);
  }

  .nbp__brief h2,
  .nbp__section-head h2,
  .nbp__proof h2 {
    margin: 0;
    font-size: clamp(42px, 6vw, 88px);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .nbp__brief > div {
    columns: 2;
    column-gap: 30px;
    font-size: 17px;
    line-height: 1.55;
  }

  .nbp__brief > div p {
    margin: 0 0 1em;
  }

  .nbp__section-head {
    display: grid;
    grid-template-columns: 0.3fr 1.7fr;
    gap: 30px;
    margin-bottom: 44px;
  }

  .nbp__dispatches > ol {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nbp__dispatch {
    display: grid;
    grid-template-columns: minmax(320px, 0.85fr) minmax(360px, 1.15fr);
    border: 2px solid var(--ink);
    background: var(--cream);
  }

  .nbp__dispatch-art {
    position: relative;
    display: block;
    border-right: 2px solid var(--ink);
    overflow: hidden;
  }

  .nbp__dispatch-art img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 430px;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.08);
    transition: transform 280ms ease, filter 280ms ease;
  }

  .nbp__dispatch:hover .nbp__dispatch-art img {
    transform: scale(1.018);
    filter: saturate(0.95) contrast(1.04);
  }

  .nbp__dispatch-art > span {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 9px;
    color: var(--cream);
    background: var(--red);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 800;
  }

  .nbp__dispatch-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 4vw, 58px);
  }

  .nbp__dispatch-copy > p:first-child {
    margin: 0;
    color: var(--red);
  }

  .nbp__dispatch-copy h3 {
    max-width: 13ch;
    margin: 28px 0 18px;
    font-size: clamp(42px, 5.2vw, 76px);
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .nbp__dispatch-copy > p:not(:first-child) {
    max-width: 54ch;
    margin: 0;
    font-size: 18px;
    line-height: 1.45;
  }

  .nbp__dispatch-copy blockquote {
    margin: 30px 0;
    padding: 20px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    white-space: pre-line;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    line-height: 1.55;
  }

  .nbp__dispatch-actions {
    display: flex;
    gap: 9px;
    margin-top: auto;
  }

  .nbp__dispatch-actions button,
  .nbp__dispatch-actions a,
  .nbp__native-share {
    padding: 13px 15px;
    border: 1px solid var(--ink);
    color: var(--cream);
    background: var(--blue);
    cursor: pointer;
    text-decoration: none;
  }

  .nbp__dispatch-actions a {
    color: var(--ink);
    background: transparent;
  }

  .nbp__dispatch-actions button:hover,
  .nbp__dispatch-actions button:focus-visible,
  .nbp__native-share:hover,
  .nbp__native-share:focus-visible {
    background: var(--red);
  }

  .nbp__status {
    margin: 22px 0 0;
  }

  .nbp__proof {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(380px, 1.1fr);
    gap: clamp(34px, 6vw, 90px);
    color: var(--cream);
    background: var(--red);
  }

  .nbp__proof > div > p {
    margin: 0 0 20px;
  }

  .nbp__proof dl {
    margin: 0;
    border-top: 1px solid currentColor;
  }

  .nbp__proof dl div {
    display: grid;
    grid-template-columns: 0.42fr 1fr;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid currentColor;
  }

  .nbp__proof dt,
  .nbp__proof dd {
    margin: 0;
  }

  .nbp__proof dd {
    font-size: 16px;
  }

  .nbp__proof nav {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nbp__proof nav a {
    padding: 10px 12px;
    border: 1px solid currentColor;
    text-decoration: none;
  }

  .nbp__native-share {
    grid-column: 1 / -1;
    justify-self: start;
    color: var(--ink);
    background: var(--paper);
  }

  @media (max-width: 820px) {
    .nbp__flag {
      grid-template-columns: 1fr auto;
    }

    .nbp__flag span {
      display: none;
    }

    .nbp__lead,
    .nbp__brief,
    .nbp__section-head,
    .nbp__dispatch,
    .nbp__proof {
      grid-template-columns: 1fr;
    }

    .nbp__lead {
      min-height: auto;
    }

    .nbp__lead h1 {
      font-size: clamp(68px, 22vw, 112px);
    }

    .nbp__scoreline {
      grid-template-columns: repeat(2, 1fr);
    }

    .nbp__scoreline span:nth-child(2) {
      border-right: 0;
    }

    .nbp__scoreline span:nth-child(-n + 2) {
      border-bottom: 1px solid var(--ink);
    }

    .nbp__brief > div {
      columns: 1;
    }

    .nbp__dispatch-art {
      border-right: 0;
      border-bottom: 2px solid var(--ink);
    }

    .nbp__dispatch-art img {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }

    .nbp__dispatch-copy h3 {
      font-size: clamp(42px, 13vw, 64px);
    }

    .nbp__dispatch-actions {
      flex-direction: column;
    }

    .nbp__dispatch-actions button,
    .nbp__dispatch-actions a {
      width: 100%;
      text-align: center;
    }

    .nbp__proof nav,
    .nbp__native-share {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nbp__dispatch-art img {
      transition: none;
    }
  }
</style>
