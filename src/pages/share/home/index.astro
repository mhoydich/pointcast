---
/**
 * /share/home — the six fixed home share-card editions on one page.
 * Added 2026-10-08: /share/home/{edition} shipped with no parent door.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import HomeShareEditions from '../../../components/HomeShareEditions.astro';
import { HOME_SHARE_DESCRIPTION } from '../../../lib/home-share-editions.mjs';
---

<BlockLayout title="Home share cards" description={HOME_SHARE_DESCRIPTION}>
  <main style="max-width: 960px; margin: 0 auto; padding: 18px 20px 88px;">
    <nav style="font-family: var(--pc-font-mono); font-size: 12px; color: var(--pc-ink-muted);"><a href="/" style="color: inherit;">Home</a> / share / home</nav>
    <HomeShareEditions />
  </main>
</BlockLayout>
