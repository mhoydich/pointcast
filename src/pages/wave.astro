---
import BlockLayout from '../layouts/BlockLayout.astro';
import { WAVE } from '../lib/nounswave';
const title = 'Nouns Wave · the shelf';
const description = 'Every Noun minted into the Nouns Wave on Tezos, live from objkt. Original CC0 art, whole Nouns, priced by the artists who make them.';
---
<BlockLayout title={title} description={description} hideAds showNetworkStrip={false} alternates={[{ type: 'application/json', href: '/wave.json', title: 'Nouns Wave brief for agents' }]}>
  <main class="nw" data-wave data-tag={WAVE.tag} data-endpoint={WAVE.objktGraphql} data-names={JSON.stringify(WAVE.names)}>
    <header class="nw-head">
      <p class="nw-kicker">⌐◨-◨ nouns wave · tezos</p>
      <h1>The shelf</h1>
      <p class="nw-lead">Every Noun minted into the wave, read live from objkt. Original CC0 art, whole Nouns, priced by the artists who make them.</p>
      <dl class="nw-stats" aria-live="polite">
        <div><dd data-stat="artists">…</dd><dt>artists</dt></div>
        <div><dd data-stat="pieces">…</dd><dt>pieces</dt></div>
        <div><dd data-stat="collectors">…</dd><dt>collectors</dt></div>
      </dl>
    </header>

    <section class="nw-join" aria-labelledby="nw-join-h">
      <h2 id="nw-join-h">Join the wave</h2>
      <ol>
        {WAVE.steps.map((s) => <li><b>{s.title}</b> {s.body}</li>)}
      </ol>
      <p class="nw-links">
        <a href={WAVE.guideUrl}>Prompting guide</a>
        <a href={WAVE.loomUrl}>#nounswave on the Loom</a>
        <a href="/wave.json">For agents</a>
      </p>
    </section>

    <section class="nw-artists" aria-labelledby="nw-artists-h">
      <h2 id="nw-artists-h">Artists</h2>
      <div class="nw-chips" data-artists role="group" aria-label="Filter by artist">
        <button type="button" class="nw-chip is-on" data-artist="">everyone</button>
      </div>
    </section>

    <section aria-label="Wave pieces">
      <p class="nw-status" data-status role="status">Reading the shelf…</p>
      <div class="nw-grid" data-grid></div>
    </section>

    <footer class="nw-foot">
      <p>Not on the shelf? Add the tag <code>{WAVE.tag}</code> to your token on objkt or Teia. The shelf reads the tag, so nothing else is needed.</p>
    </footer>
  </main>

  <style>
    .nw { --ink:#141414; --paper:#f7f4ee; --line:#d9d3c7; --muted:#6b655b; --accent:#d63c3c; --card:#fffdf8;
      background:var(--paper); color:var(--ink); min-height:100vh; padding:32px 16px 64px; font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif; }
    @media (prefers-color-scheme: dark) {
      .nw { --ink:#f1ede6; --paper:#141312; --line:#33302b; --muted:#a49d92; --accent:#ff6b5e; --card:#1c1b19; }
    }
    .nw > * { max-width:1080px; margin-inline:auto; }
    .nw-kicker { font:600 13px/1 ui-monospace,monospace; letter-spacing:.04em; color:var(--accent); margin:0 0 12px; }
    .nw h1 { font-size:clamp(36px,7vw,64px); line-height:1; margin:0 0 12px; letter-spacing:-.02em; }
    .nw h2 { font-size:15px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin:0 0 12px; }
    .nw-lead { font-size:18px; line-height:1.45; max-width:60ch; margin:0 0 24px; }
    .nw-stats { display:flex; gap:32px; margin:0 0 40px; padding:0; }
    .nw-stats div { display:flex; flex-direction:column-reverse; }
    .nw-stats dd { margin:0; font:700 40px/1 ui-monospace,monospace; font-variant-numeric:tabular-nums; }
    .nw-stats dt { font-size:13px; color:var(--muted); }
    .nw-join { border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:20px 0; margin-bottom:32px; }
    .nw-join ol { margin:0 0 12px; padding-left:20px; display:grid; gap:6px; line-height:1.45; }
    .nw-links { display:flex; flex-wrap:wrap; gap:16px; margin:0; }
    .nw a { color:inherit; text-decoration-color:var(--accent); text-underline-offset:3px; }
    .nw-artists { margin-bottom:20px; }
    .nw-chips { display:flex; flex-wrap:wrap; gap:8px; }
    /* Chips and cards are created by the browser script, so they carry no Astro scope attribute: target them with :global under .nw. */
    .nw :global(.nw-chip) { font:inherit; font-size:14px; padding:6px 12px; border-radius:999px; border:1px solid var(--line); background:transparent; color:var(--ink); cursor:pointer; }
    .nw :global(.nw-chip.is-on) { background:var(--ink); color:var(--paper); border-color:var(--ink); }
    .nw :global(.nw-chip small) { color:inherit; opacity:.6; margin-left:4px; }
    .nw-status { color:var(--muted); font-size:14px; min-height:1.4em; }
    .nw-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:20px; }
    .nw :global(.nw-card) { background:var(--card); border:1px solid var(--line); border-radius:6px; overflow:hidden; display:flex; flex-direction:column; text-decoration:none; color:inherit; }
    .nw :global(.nw-card:hover) { border-color:var(--ink); }
    .nw :global(.nw-card img) { width:100%; aspect-ratio:1; object-fit:cover; image-rendering:pixelated; background:var(--line); display:block; }
    .nw :global(.nw-card-body) { padding:10px 12px 12px; display:grid; gap:2px; }
    .nw :global(.nw-card-name) { font-weight:600; font-size:15px; line-height:1.3; }
    .nw :global(.nw-card-meta) { font-size:13px; color:var(--muted); display:flex; justify-content:space-between; gap:8px; }
    .nw-foot { margin-top:40px; color:var(--muted); font-size:14px; }
    .nw code { font:13px ui-monospace,monospace; background:var(--card); border:1px solid var(--line); padding:1px 5px; border-radius:4px; }
    @media (max-width:520px) { .nw-stats { gap:20px; } .nw-stats dd { font-size:30px; } .nw-grid { grid-template-columns:repeat(2,1fr); gap:12px; } .nw :global(.nw-card-meta) { flex-direction:column; gap:0; } }
  </style>

  <script>
    const root = document.querySelector<HTMLElement>('[data-wave]');
    if (root) {
      const tag = root.dataset.tag || 'nounswave';
      const endpoint = root.dataset.endpoint || 'https://data.objkt.com/v3/graphql';
      const grid = root.querySelector<HTMLElement>('[data-grid]')!;
      const status = root.querySelector<HTMLElement>('[data-status]')!;
      const chips = root.querySelector<HTMLElement>('[data-artists]')!;
      const stat = (k: string, v: number | string) => { const el = root.querySelector(`[data-stat="${k}"]`); if (el) el.textContent = String(v); };

      type Holder = { alias: string | null; tzdomain: string | null };
      type Token = {
        token_id: string; name: string | null; fa_contract: string; timestamp: string; supply: number;
        thumbnail_uri: string | null; display_uri: string | null;
        creators: { creator_address: string; holder: Holder | null }[];
        listings_active: { price: number; seller_address: string; currency: { symbol: string } | null }[];
        holders: { holder_address: string }[];
      };

      const query = `{ token(where:{tags:{tag:{name:{_eq:${JSON.stringify(tag)}}}}}, order_by:{timestamp:desc}, limit:500){
        token_id name fa_contract timestamp supply thumbnail_uri display_uri
        creators{ creator_address holder{ alias tzdomain } }
        listings_active(order_by:{price:asc}){ price seller_address currency{ symbol } }
        holders(where:{quantity:{_gt:"0"}}){ holder_address } } }`;

      const short = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
      let names: Record<string, string> = {};
      try { names = JSON.parse(root.dataset.names || '{}'); } catch { names = {}; }
      const artistName = (c: Token['creators'][number]) => c.holder?.tzdomain || c.holder?.alias || names[c.creator_address] || short(c.creator_address);
      const gateway = (uri: string | null) => (uri && uri.startsWith('ipfs://')) ? `https://gateway.pinata.cloud/ipfs/${uri.slice(7)}` : (uri || '');
      // The artist's own XTZ listing is the price; a cheaper or only listing from anyone else is shown as resale.
      const price = (t: Token) => {
        const makers = new Set(t.creators.map((c) => c.creator_address));
        const xtz = t.listings_active.filter((l) => (l.currency?.symbol ?? 'XTZ') === 'XTZ');
        const tez = (mutez: number) => { const v = Number(mutez) / 1e6; return v === 0 ? 'free' : `${v} tez`; };
        const own = xtz.find((l) => makers.has(l.seller_address));
        if (own) return tez(own.price);
        if (xtz.length) return `resale ${tez(xtz[0].price)}`;
        return 'not listed';
      };

      let tokens: Token[] = [];
      let current = '';

      const render = () => {
        grid.replaceChildren();
        const list = current ? tokens.filter((t) => t.creators[0]?.creator_address === current) : tokens;
        for (const t of list) {
          const a = document.createElement('a');
          a.className = 'nw-card';
          a.href = `https://objkt.com/tokens/${t.fa_contract}/${t.token_id}`;
          a.target = '_blank'; a.rel = 'noopener';
          const img = document.createElement('img');
          img.loading = 'lazy'; img.alt = t.name || 'Wave piece';
          img.src = `https://assets.objkt.media/file/assets-003/${t.fa_contract}/${t.token_id}/thumb400`;
          img.addEventListener('error', () => { const g = gateway(t.thumbnail_uri || t.display_uri); if (g && img.src !== g) img.src = g; }, { once: true });
          const body = document.createElement('div'); body.className = 'nw-card-body';
          const name = document.createElement('span'); name.className = 'nw-card-name'; name.textContent = t.name || `#${t.token_id}`;
          const meta = document.createElement('span'); meta.className = 'nw-card-meta';
          const who = document.createElement('span'); who.textContent = t.creators[0] ? artistName(t.creators[0]) : 'unknown';
          const p = document.createElement('span'); p.textContent = `${t.supply} ed · ${price(t)}`;
          meta.append(who, p); body.append(name, meta); a.append(img, body); grid.append(a);
        }
        status.textContent = list.length ? '' : 'Nothing here yet.';
      };

      const buildChips = () => {
        const counts = new Map<string, { name: string; n: number }>();
        for (const t of tokens) {
          const c = t.creators[0]; if (!c) continue;
          const e = counts.get(c.creator_address) || { name: artistName(c), n: 0 };
          e.n++; counts.set(c.creator_address, e);
        }
        const sorted = [...counts.entries()].sort((x, y) => y[1].n - x[1].n);
        for (const [addr, { name, n }] of sorted) {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'nw-chip'; b.dataset.artist = addr;
          b.textContent = name;
          const s = document.createElement('small'); s.textContent = String(n); b.append(s);
          chips.append(b);
        }
        chips.addEventListener('click', (ev) => {
          const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-artist]');
          if (!b) return;
          current = b.dataset.artist || '';
          chips.querySelectorAll('button').forEach((x) => x.classList.toggle('is-on', x === b));
          render();
        });
        return counts;
      };

      (async () => {
        try {
          // text/plain keeps this a simple CORS request; objkt's endpoint accepts it.
          const res = await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'text/plain' }, body: JSON.stringify({ query }) });
          const json = await res.json();
          if (!json?.data?.token) throw new Error(json?.errors?.[0]?.message || 'no data');
          tokens = json.data.token as Token[];
          const artists = buildChips();
          // A collector holds a piece they didn't make. Artists who collect each other count;
          // contract holders (KT1…, e.g. a marketplace escrow) are not people and are left out.
          const collectors = new Set<string>();
          for (const token of tokens) {
            const creatorAddresses = new Set(token.creators.map(({ creator_address }) => creator_address));
            for (const holder of token.holders) {
              if (holder.holder_address.startsWith('KT1')) continue;
              if (!creatorAddresses.has(holder.holder_address)) collectors.add(holder.holder_address);
            }
          }
          stat('artists', artists.size); stat('pieces', tokens.length); stat('collectors', collectors.size);
          render();
        } catch (err) {
          status.textContent = 'Could not reach objkt just now. Try again in a minute, or browse the tag on objkt.';
          stat('artists', '—'); stat('pieces', '—'); stat('collectors', '—');
          console.warn('[wave]', err);
        }
      })();
    }
  </script>
</BlockLayout>
