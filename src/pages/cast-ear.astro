---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Ear — interval ear training in the browser" description="Hear two notes. Name the interval. Three levels: starter (6 intervals), intermediate (9), all (12). Streak tracker, score history, and ascending/descending/both modes. No app, browser only.">
  <main class="ce" id="ce" data-built={built}>
    <header class="ce__hero">
      <p class="ce__kicker">CAST · EAR · interval training · sine + warm timbre</p>
      <h1 class="ce__title">Ear.</h1>
      <p class="ce__sub">Hear two notes. Name the interval between them. Three levels of difficulty, ascending or descending or both. Streak tracker so you can come back tomorrow and see if you've gotten better.</p>
    </header>

    <section class="ce__settings">
      <div class="ce__set">
        <p class="ce__set-label">LEVEL</p>
        <div class="ce__pills" id="ce-level-pills">
          <button class="ce__pill ce__pill--active" data-level="starter">starter · 6</button>
          <button class="ce__pill" data-level="mid">mid · 9</button>
          <button class="ce__pill" data-level="all">all · 12</button>
        </div>
      </div>
      <div class="ce__set">
        <p class="ce__set-label">DIRECTION</p>
        <div class="ce__pills" id="ce-dir-pills">
          <button class="ce__pill ce__pill--active" data-dir="asc">ascending</button>
          <button class="ce__pill" data-dir="desc">descending</button>
          <button class="ce__pill" data-dir="both">both</button>
        </div>
      </div>
      <div class="ce__set">
        <p class="ce__set-label">TIMBRE</p>
        <div class="ce__pills" id="ce-timbre-pills">
          <button class="ce__pill ce__pill--active" data-timbre="warm">warm</button>
          <button class="ce__pill" data-timbre="sine">pure sine</button>
          <button class="ce__pill" data-timbre="organ">organ</button>
        </div>
      </div>
    </section>

    <section class="ce__stage">
      <button class="ce__big" id="ce-big" type="button" aria-label="Play interval">
        <span class="ce__big-icon" id="ce-big-icon">▶</span>
        <span class="ce__big-label" id="ce-big-label">PLAY INTERVAL</span>
      </button>
      <div class="ce__notes-row" id="ce-notes-row" aria-hidden="true"></div>
      <div class="ce__answers" id="ce-answers"></div>
      <div class="ce__verdict" id="ce-verdict"></div>
      <button class="ce__repeat" id="ce-repeat" type="button" disabled>REPEAT</button>
    </section>

    <section class="ce__scoreboard">
      <div class="ce__score">
        <span class="ce__score-label">STREAK</span>
        <span class="ce__score-val" id="ce-streak">0</span>
      </div>
      <div class="ce__score">
        <span class="ce__score-label">BEST STREAK</span>
        <span class="ce__score-val" id="ce-best">0</span>
      </div>
      <div class="ce__score">
        <span class="ce__score-label">TOTAL</span>
        <span class="ce__score-val ce__score-val--small" id="ce-total">0 / 0</span>
        <span class="ce__score-sub">correct / asked</span>
      </div>
      <div class="ce__score">
        <span class="ce__score-label">% CORRECT</span>
        <span class="ce__score-val" id="ce-pct">—</span>
      </div>
    </section>

    <section class="ce__guide">
      <h2 class="ce__guide-h">How it's made</h2>
      <p>Each interval plays as two notes: 0.9 seconds for the first, 0.1 second gap, 1.4 seconds for the second with a soft release. Root pitch is randomized between C3 and C5 each round so you can't get used to a single starting note.</p>
      <p>The "warm" timbre is a fundamental sine plus two detuned partials at +7 and −5 cents at lower gain — same trick a chorus pedal uses. "Pure sine" is one sine wave. "Organ" stacks an octave + a fifth above the fundamental at lower gains for a Hammond-ish flavor without leslie modulation.</p>
      <p>Levels are cumulative: starter is six (m2, M2, M3, P4, P5, P8) — the most recognizable. Mid adds m3, M6, m7. All adds m6, tritone, M7.</p>
      <p>Pair with <a href="/cast-tone">/cast-tone</a> for a reference drone, <a href="/cast-wheel">/cast-wheel</a> for the geometry, <a href="/cast-mirror">/cast-mirror</a> to check yourself singing back.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --ce-ink: #0e0a18;
      --ce-walnut: #4a2a1a;
      --ce-flame: #f6c15e;
      --ce-flame-deep: #d68f2c;
      --ce-cream: #f4e7c8;
      --ce-cream-dim: #c8b48a;
      --ce-cream-dimmer: #8b7a5a;
      --ce-mint: #9bd7b8;
      --ce-rose: #e6788c;
      --ce-mauve: #b39ddb;
    }

    body:has(.ce) {
      background: radial-gradient(circle at 50% -10%, #2a1530 0%, var(--ce-ink) 60%);
      color: var(--ce-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .ce { max-width: 920px; margin: 0 auto; padding: 48px 24px 80px; }

    .ce__hero { text-align: center; margin-bottom: 32px; }
    .ce__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--ce-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .ce__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 132px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--ce-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.45);
    }
    .ce__sub {
      max-width: 640px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--ce-cream-dim);
    }

    /* SETTINGS */
    .ce__settings {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 28px;
    }
    @media (max-width: 700px) { .ce__settings { grid-template-columns: 1fr; } }
    .ce__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .ce__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--ce-cream-dimmer);
      margin: 0 0 8px;
    }
    .ce__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .ce__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--ce-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .ce__pill:hover { background: rgba(246,193,94,0.10); }
    .ce__pill--active {
      background: var(--ce-flame);
      color: var(--ce-walnut);
      border-color: var(--ce-flame);
    }

    /* STAGE */
    .ce__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 20px;
      padding: 32px 24px;
      margin-bottom: 28px;
    }
    .ce__big {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .ce__big-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: var(--ce-flame);
      color: var(--ce-walnut);
      font-size: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 28px rgba(246,193,94,0.32);
      transition: transform 80ms ease;
    }
    .ce__big:hover .ce__big-icon { transform: scale(1.04); }
    .ce__big:active .ce__big-icon { transform: scale(0.96); }
    .ce__big-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.18em;
      color: var(--ce-cream-dim);
    }
    .ce__notes-row {
      display: flex;
      gap: 24px;
      align-items: center;
      min-height: 32px;
    }
    .ce__note {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(244,231,200,0.16);
      border: 2px solid rgba(244,231,200,0.3);
      transition: background 60ms ease, transform 60ms ease;
    }
    .ce__note--lit {
      background: var(--ce-flame);
      border-color: var(--ce-flame);
      transform: scale(1.3);
    }
    .ce__answers {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      max-width: 580px;
    }
    .ce__answer {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 14px;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--ce-cream);
      cursor: pointer;
      transition: background 100ms ease, transform 60ms ease;
    }
    .ce__answer:hover:not(:disabled) { background: rgba(246,193,94,0.12); }
    .ce__answer:active { transform: scale(0.97); }
    .ce__answer--correct {
      background: var(--ce-mint);
      color: var(--ce-walnut);
      border-color: var(--ce-mint);
    }
    .ce__answer--wrong {
      background: var(--ce-rose);
      color: var(--ce-walnut);
      border-color: var(--ce-rose);
    }
    .ce__answer:disabled { cursor: not-allowed; }
    .ce__verdict {
      min-height: 28px;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 18px;
    }
    .ce__verdict--ok { color: var(--ce-mint); }
    .ce__verdict--no { color: var(--ce-rose); }
    .ce__repeat {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      padding: 8px 16px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--ce-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .ce__repeat:hover:not(:disabled) { background: rgba(246,193,94,0.12); }
    .ce__repeat:disabled { opacity: 0.4; cursor: not-allowed; }

    /* SCOREBOARD */
    .ce__scoreboard {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }
    @media (max-width: 700px) { .ce__scoreboard { grid-template-columns: 1fr 1fr; } }
    .ce__score {
      background: rgba(0,0,0,0.26);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .ce__score-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--ce-cream-dimmer);
    }
    .ce__score-val {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 28px;
      color: var(--ce-flame);
      line-height: 1;
    }
    .ce__score-val--small { font-size: 18px; }
    .ce__score-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--ce-cream-dimmer);
    }

    /* GUIDE */
    .ce__guide {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .ce__guide-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--ce-cream);
      margin: 0 0 12px;
    }
    .ce__guide p {
      font-size: 15px; line-height: 1.6;
      color: var(--ce-cream-dim);
      margin: 0 0 12px;
    }
    .ce__guide a { color: var(--ce-flame); text-decoration: none; }
    .ce__guide a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- intervals ----
    // semitone distance, label, short name, level cohort
    type Interval = { semi: number; label: string; short: string; cohort: 'starter' | 'mid' | 'all' };
    const INTERVALS: Interval[] = [
      { semi: 1,  label: 'Minor 2nd',       short: 'm2',   cohort: 'starter' },
      { semi: 2,  label: 'Major 2nd',       short: 'M2',   cohort: 'starter' },
      { semi: 3,  label: 'Minor 3rd',       short: 'm3',   cohort: 'mid'     },
      { semi: 4,  label: 'Major 3rd',       short: 'M3',   cohort: 'starter' },
      { semi: 5,  label: 'Perfect 4th',     short: 'P4',   cohort: 'starter' },
      { semi: 6,  label: 'Tritone',         short: 'TT',   cohort: 'all'     },
      { semi: 7,  label: 'Perfect 5th',     short: 'P5',   cohort: 'starter' },
      { semi: 8,  label: 'Minor 6th',       short: 'm6',   cohort: 'all'     },
      { semi: 9,  label: 'Major 6th',       short: 'M6',   cohort: 'mid'     },
      { semi: 10, label: 'Minor 7th',       short: 'm7',   cohort: 'mid'     },
      { semi: 11, label: 'Major 7th',       short: 'M7',   cohort: 'all'     },
      { semi: 12, label: 'Octave',          short: 'P8',   cohort: 'starter' },
    ];

    type Level = 'starter' | 'mid' | 'all';
    type Direction = 'asc' | 'desc' | 'both';
    type Timbre = 'warm' | 'sine' | 'organ';

    let level: Level = 'starter';
    let direction: Direction = 'asc';
    let timbre: Timbre = 'warm';
    let streak = 0;
    let bestStreak = 0;
    let correctCount = 0;
    let askedCount = 0;
    let answered = false;
    let currentInterval: Interval | null = null;
    let currentRootHz = 220;
    let currentDirIsAsc = true;

    const STORAGE_KEY = 'pc-ce-state-v1';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;

    function activeIntervals(): Interval[] {
      if (level === 'starter') return INTERVALS.filter(i => i.cohort === 'starter');
      if (level === 'mid') return INTERVALS.filter(i => i.cohort === 'starter' || i.cohort === 'mid');
      return INTERVALS;
    }

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }

    function playNote(hz: number, startCtxTime: number, duration: number) {
      if (!ctx || !scheduler || !masterGain) return;
      const t = startCtxTime;
      const stack: { freq: number; gain: number; detune?: number }[] =
        timbre === 'sine' ? [{ freq: hz, gain: 0.42 }] :
        timbre === 'organ' ? [
          { freq: hz, gain: 0.30 },
          { freq: hz * 2, gain: 0.18 },
          { freq: hz * 3, gain: 0.12 },
        ] :
        // warm
        [
          { freq: hz, gain: 0.32 },
          { freq: hz, gain: 0.18, detune: 7 },
          { freq: hz, gain: 0.18, detune: -5 },
        ];
      for (const v of stack) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = timbre === 'organ' ? 'sine' : 'sine';
        osc.frequency.value = v.freq;
        if (v.detune) osc.detune.value = v.detune;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(v.gain, t + 0.04);
        g.gain.setValueAtTime(v.gain, t + duration - 0.18);
        g.gain.exponentialRampToValueAtTime(0.0001, t + duration);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + duration + 0.05);
      }
    }

    function flashNote(idx: 0 | 1, durationMs: number) {
      const dots = [...document.querySelectorAll('.ce__notes-row .ce__note')] as HTMLElement[];
      const el = dots[idx];
      if (!el) return;
      el.classList.add('ce__note--lit');
      setTimeout(() => el.classList.remove('ce__note--lit'), durationMs);
    }

    function rollRound() {
      ensureCtx();
      if (!ctx) return;
      // pick interval
      const pool = activeIntervals();
      currentInterval = pool[Math.floor(Math.random() * pool.length)];
      // pick root between C3 (~131Hz) and C5 (~523Hz), reserve top for octaves
      const maxSemiUp = currentInterval.semi;
      const maxRootHz = 523.25 / Math.pow(2, maxSemiUp / 12);
      const minRootHz = 130.81;
      currentRootHz = minRootHz + Math.random() * (Math.min(maxRootHz, 523.25) - minRootHz);
      // direction
      if (direction === 'both') currentDirIsAsc = Math.random() < 0.5;
      else currentDirIsAsc = direction === 'asc';

      answered = false;
      document.getElementById('ce-verdict')!.textContent = '';
      document.getElementById('ce-verdict')!.className = 'ce__verdict';
      renderAnswers();
      (document.getElementById('ce-repeat') as HTMLButtonElement).disabled = false;
      askedCount++;
      persistState();
      refreshScoreboard();

      playCurrent();
    }

    function playCurrent() {
      if (!ctx || !currentInterval) return;
      if (ctx.state === 'suspended') ctx.resume();
      const root = currentRootHz;
      const top = root * Math.pow(2, currentInterval.semi / 12);
      const firstHz = currentDirIsAsc ? root : top;
      const secondHz = currentDirIsAsc ? top : root;
      const t0 = ctx.currentTime + 0.06;
      const noteLen1 = 0.9;
      const gap = 0.1;
      const noteLen2 = 1.4;
      playNote(firstHz, t0, noteLen1);
      playNote(secondHz, t0 + noteLen1 + gap, noteLen2);
      // visual flashes
      const flashOffsetMs = (t0 - ctx.currentTime) * 1000;
      setTimeout(() => flashNote(0, noteLen1 * 1000), flashOffsetMs);
      setTimeout(() => flashNote(1, noteLen2 * 1000), flashOffsetMs + (noteLen1 + gap) * 1000);
    }

    function renderAnswers() {
      const wrap = document.getElementById('ce-answers')!;
      const pool = activeIntervals();
      // Build candidate set: correct + up to 5 distractors from same pool
      const distractors = pool.filter(p => p !== currentInterval);
      // Shuffle
      const shuf = [...distractors].sort(() => Math.random() - 0.5);
      const slots = 4;
      const candidates: Interval[] = [currentInterval as Interval, ...shuf.slice(0, slots - 1)];
      // include extra for "all" mode
      const buttons = candidates.sort(() => Math.random() - 0.5);
      wrap.innerHTML = buttons.map(b =>
        `<button class="ce__answer" data-semi="${b.semi}">${b.label}</button>`
      ).join('');
    }

    function answer(semi: number) {
      if (!currentInterval || answered) return;
      answered = true;
      const isRight = semi === currentInterval.semi;
      const buttons = [...document.querySelectorAll('.ce__answer')] as HTMLButtonElement[];
      const verdict = document.getElementById('ce-verdict')!;
      for (const btn of buttons) {
        btn.disabled = true;
        const s = parseInt(btn.getAttribute('data-semi')!);
        if (s === currentInterval.semi) btn.classList.add('ce__answer--correct');
        else if (s === semi && !isRight) btn.classList.add('ce__answer--wrong');
      }
      if (isRight) {
        correctCount++;
        streak++;
        if (streak > bestStreak) bestStreak = streak;
        verdict.textContent = `✓ ${currentInterval.label} ${currentDirIsAsc ? '↑' : '↓'}`;
        verdict.className = 'ce__verdict ce__verdict--ok';
      } else {
        streak = 0;
        verdict.textContent = `✗ was ${currentInterval.label} ${currentDirIsAsc ? '↑' : '↓'}`;
        verdict.className = 'ce__verdict ce__verdict--no';
      }
      persistState();
      refreshScoreboard();
      // auto-advance after a beat
      setTimeout(() => {
        if (answered) rollRound();
      }, 1800);
    }

    function refreshScoreboard() {
      document.getElementById('ce-streak')!.textContent = String(streak);
      document.getElementById('ce-best')!.textContent = String(bestStreak);
      document.getElementById('ce-total')!.textContent = `${correctCount} / ${askedCount}`;
      document.getElementById('ce-pct')!.textContent = askedCount === 0 ? '—' : `${Math.round((correctCount / askedCount) * 100)}%`;
    }

    function persistState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ level, direction, timbre, bestStreak, correctCount, askedCount }));
      } catch {}
    }
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const s = JSON.parse(raw);
        if (s.level === 'starter' || s.level === 'mid' || s.level === 'all') level = s.level;
        if (s.direction === 'asc' || s.direction === 'desc' || s.direction === 'both') direction = s.direction;
        if (s.timbre === 'warm' || s.timbre === 'sine' || s.timbre === 'organ') timbre = s.timbre;
        if (typeof s.bestStreak === 'number') bestStreak = s.bestStreak;
        if (typeof s.correctCount === 'number') correctCount = s.correctCount;
        if (typeof s.askedCount === 'number') askedCount = s.askedCount;
      } catch {}
    }

    function renderNotesRow() {
      const row = document.getElementById('ce-notes-row')!;
      row.innerHTML = `<div class="ce__note"></div><div class="ce__note"></div>`;
    }

    function syncSettingChips() {
      document.querySelectorAll('#ce-level-pills .ce__pill').forEach(el =>
        el.classList.toggle('ce__pill--active', el.getAttribute('data-level') === level));
      document.querySelectorAll('#ce-dir-pills .ce__pill').forEach(el =>
        el.classList.toggle('ce__pill--active', el.getAttribute('data-dir') === direction));
      document.querySelectorAll('#ce-timbre-pills .ce__pill').forEach(el =>
        el.classList.toggle('ce__pill--active', el.getAttribute('data-timbre') === timbre));
    }

    function init() {
      loadState();
      syncSettingChips();
      renderNotesRow();
      refreshScoreboard();

      document.getElementById('ce-big')!.addEventListener('click', () => {
        if (!currentInterval) rollRound();
        else if (answered) rollRound();
        else playCurrent();
      });

      document.getElementById('ce-repeat')!.addEventListener('click', () => {
        if (!answered) playCurrent();
      });

      document.getElementById('ce-answers')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-semi]');
        if (!btn) return;
        if (answered) return;
        answer(parseInt(btn.getAttribute('data-semi')!));
      });

      document.getElementById('ce-level-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-level]');
        if (!btn) return;
        level = btn.getAttribute('data-level') as Level;
        syncSettingChips();
        persistState();
      });
      document.getElementById('ce-dir-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-dir]');
        if (!btn) return;
        direction = btn.getAttribute('data-dir') as Direction;
        syncSettingChips();
        persistState();
      });
      document.getElementById('ce-timbre-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-timbre]');
        if (!btn) return;
        timbre = btn.getAttribute('data-timbre') as Timbre;
        syncSettingChips();
        persistState();
      });

      window.addEventListener('keydown', e => {
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (!currentInterval || answered) rollRound();
          else playCurrent();
        } else if (e.code === 'KeyR' && currentInterval && !answered) {
          e.preventDefault();
          playCurrent();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden) ctx.suspend().catch(() => {});
        else ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
