---
import { ads, deckUrl, rackPath, sourceUrl } from '../../../lib/ad-department/registry';
export function getStaticPaths() {
  return ads.map((ad, index) => ({ params: { slug: ad.slug }, props: { ad, index } }));
}
const { ad, index } = Astro.props;
const { Poster } = ad;
const canonical = 'https://pointcast.xyz' + rackPath + ad.slug + '/';
const shareImage = canonical + 'share.png';
const title = ad.title + ' · The Ad Department';
const previous = ads[index - 1];
const next = ads[index + 1];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={ad.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} /><meta property="og:description" content={ad.description} />
    <meta property="og:url" content={canonical} /><meta property="og:type" content="article" />
    <meta property="og:image" content={shareImage} /><meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    <main>
      <nav aria-label="Magazine navigation">
        <a class="back" href={rackPath + '#' + ad.slug}>← The Ad Department</a>
        <span class="folio">Ad {index + 1} / {ads.length}</span>
      </nav>
      <h1 class="sr-only">{ad.title}</h1>
      <div class="reader">
        <label class="view"><input type="checkbox" /> Print layout</label>
        <div class="sheet"><Poster /></div>
      </div>
      <nav aria-label="Browse more ads">
        {previous && <a href={rackPath + previous.slug + '/'} rel="prev">← Previous ad</a>}
        {next && <a class="next" href={rackPath + next.slug + '/'} rel="next">Next ad →</a>}
      </nav>
      <footer><a href={deckUrl}>Office Skate Team decks</a><div class="credit">Posters by Michael Hoydich. Noun characters and glasses are CC0.<br /><a href={sourceUrl}>Source · Brutalist Motor Art</a></div></footer>
    </main>
  </body>
</html>
<style>
  :global(html) { color-scheme: light; background: #f2efe7; }
  body { margin: 0; color: #28251f; font: 1rem/1.45 system-ui, sans-serif; }
  main { max-width: 54rem; margin: auto; padding: 0 clamp(12px, 4vw, 30px) 2rem; }
  a { color: inherit; text-underline-offset: .22em; }
  nav, footer { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  nav { min-height: 52px; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; }
  .next, .folio { margin-left: auto; }
  .folio, footer { font-size: .8rem; }
  footer { margin-top: .65rem; padding-top: 1rem; justify-content: space-between; border-top: 1px solid #847a68; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .view { display: none; }
  .sheet { margin: 0 7px 10px 0; }
  .credit { max-width: 38ch; font-size: .8rem; }
  a:focus-visible, input:focus-visible { outline: 3px solid #82432b; outline-offset: 2px; }
  @media (max-width: 780px) {
    .view { display: flex; align-items: center; min-height: 44px; gap: .4rem; width: fit-content; font-size: .84rem; }
    .reader:not(:has(:checked)) .sheet :global(.campaign-ad:not(:has(.ad-plate))) { aspect-ratio: auto; }
    .reader:not(:has(:checked)) .sheet :global(.ad-inner:not(.ad-plate)) { position: relative; }
    .reader:not(:has(:checked)) .sheet :global(.ad-inner:not(.ad-plate) .ad-visual) { flex: none; aspect-ratio: 1.4; }
    .reader:not(:has(:checked)) .sheet :global(.ad-copy) { column-count: 1; font-size: 1rem; text-align: left; hyphens: none; }
    .reader:not(:has(:checked)) .sheet :global(.ad-copy li::before) { font-size: 1rem; }
    .reader:not(:has(:checked)) .sheet :global(.ad-caption), .reader:not(:has(:checked)) .sheet :global(.ad-signoff) { font-size: .83rem; }
    .reader:not(:has(:checked)) .sheet :global(.ad-headline) { font-size: clamp(1.6rem, 6cqw, 2.6rem); }
    .reader:has(:global(.ad-plate)) .view { display: none; }
  }
</style>
