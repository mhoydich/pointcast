---
/**
 * /attic/v1 — the v1 wing. A museum exhibit, not a resurrection.
 *
 * PointCast v1 (2025 → April 2026) was the markdown-doc era: one warm
 * 34rem column, serif bylines, a unified feed river, the original drum
 * room, Noun Bells, the visit log. Retired at commit 7fea01c
 * ("v1 snapshot — pre blocks-rebuild pivot", 2026-04-17) when the
 * Blocks pivot landed. BLOCKS.md kept the content and retired the
 * wallpaper.
 *
 * This page restores the top of the v1 front door as a static replica
 * under glass — masthead, byline card, the actual last feed items from
 * the snapshot — plus specimen labels for the retired machinery. All
 * text and structure are lifted from `git show 7fea01c:...`; the CSS is
 * an honest approximation of the Tailwind-era look, plaqued as such.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';

const title = 'The v1 Wing';
const description =
  'PointCast v1 under glass: the markdown-doc era front door, restored from commit 7fea01c as a museum exhibit. The content came forward; the wallpaper stayed here.';

// The last feed items in the snapshot, verbatim from src/content/posts.
const FEED = [
  {
    date: '2026-04-16',
    type: 'essay',
    title: 'Pairing · On Call IPA × Cold Creek Kush',
    dek: "El Segundo Brewing's fresh West Coast IPA meets 710 Labs' MK Ultra × Chem 91. Hops and Kush share the same plant family — this pairing was coded in.",
  },
  {
    date: '2026-04-15',
    type: 'newsletter',
    title: 'Seeing the Future №0159 · Pickleball',
    dek: 'The foam is quiet but the transition zone is screaming. Sacramento Open mid-tourney, Gen 4 ships today, and the split step decides everything.',
  },
  {
    date: '2026-04-14',
    type: 'newsletter',
    title: 'Seeing the Future №0205 · AI / Front Door',
    dek: 'The front door is moving — and the hinges are agentic. Atlas, Comet, Dia, Claude-in-Chrome — the entry point is no longer a URL. It is a cursor that reads.',
  },
  {
    date: '2026-04-14',
    type: 'article',
    title: 'NYC Mesh — The People’s Internet',
    dek: 'How a volunteer-run mesh network became the blueprint for community-owned infrastructure. 2,000+ nodes, zero corporate gatekeepers.',
  },
];

const SPECIMENS = [
  ['VisitLog', 'the original guest book — every visit a noun head'],
  ['NounBells', 'a carillon you could ring by clicking nouns'],
  ['DrumModule', 'the first drum, before the Drum Press had imprints'],
  ['TheWire', 'anonymous live chat — built, deployed, never mounted'],
  ['PulseAlert', 'midcentury alert card that slid in when something happened'],
  ['Jackpot', 'full-screen celebration for FULL HOUSE / CENTURY moments'],
  ['SpinningBox', 'the listening-room turntable, spinning in the sidebar'],
  ['WeatherBox', 'El Segundo Now — live weather, future mint-the-moment hook'],
];
---

<BlockLayout title={title} description={description}>
  <main class="wing">
    <nav class="crumb"><a href="/">Home</a><span>/</span><a href="/attic">attic</a><span>/</span><span>v1</span></nav>

    <header class="top">
      <p class="kicker">THE ATTIC · PERMANENT COLLECTION</p>
      <h1>The v1 Wing</h1>
      <p class="dek">
        Before blocks, PointCast was one warm column: serif bylines, a unified feed, the coffee
        already on. Retired April 17, 2026 at commit <code>7fea01c</code> when the town rebuilt
        around the Block. Restored here under glass — text verbatim from the snapshot, wallpaper
        honestly approximated.
      </p>
    </header>

    <section class="case">
      <p class="plaque">
        EXHIBIT A · THE FRONT DOOR, AS IT STOOD · restored from <code>git show 7fea01c</code>
      </p>
      <div class="glass">
        <div class="v1">
          <div class="v1-masthead">
            <div class="v1-mast-left">
              <span class="v1-logo">POINTCAST</span>
              <span class="v1-navlink">COLLECT →</span>
              <span class="v1-navlink">DRUM →</span>
            </div>
            <div class="v1-mast-right">
              <span class="v1-pill"><span class="v1-dot"></span>LIVE</span>
              <img src="https://noun.pics/137.svg" alt="PointCast Noun 137" width="32" height="32" class="v1-noun" loading="lazy" />
            </div>
          </div>

          <div class="v1-byline">
            <h3>Michael Hoydich</h3>
            <p class="v1-role">COO AT GOOD FEELS · EL SEGUNDO, CA</p>
            <p class="v1-bio">Builder, creative technologist. PointCast is published with Claude.</p>
          </div>

          <div class="v1-feed">
            {FEED.map((f) => (
              <article class="v1-item">
                <p class="v1-meta">{f.date} · {f.type.toUpperCase()}</p>
                <h4>{f.title}</h4>
                <p class="v1-dek">{f.dek}</p>
              </article>
            ))}
          </div>

          <p class="v1-signoff">— broadcast from El Segundo · the coffee pot, already on</p>
        </div>
      </div>
      <p class="caption">
        The last four feed items in the snapshot, verbatim. Two of them — Seeing the Future №0159
        and №0205 — came forward into the block archive and still answer at
        <a href="/b/0159"><code>/b/0159</code></a> and <a href="/b/0205"><code>/b/0205</code></a>.
      </p>
    </section>

    <section class="specimens">
      <h2>Exhibit B · Retired machinery</h2>
      <p class="note">Component names from the v1 front door, with what they did. All preserved in git.</p>
      <ul>
        {SPECIMENS.map(([name, blurb]) => (
          <li><code>{name}</code><span>{blurb}</span></li>
        ))}
      </ul>
    </section>

    <footer class="foot">
      <p>
        The whole snapshot: <code>git show 7fea01c</code> · back to <a href="/attic"><code>/attic</code></a> ·
        what replaced this: <a href="/BLOCKS.md"><code>/BLOCKS.md</code></a>
      </p>
    </footer>
  </main>
</BlockLayout>

<style>
  .wing { max-width: 860px; margin: 0 auto; padding: 24px 20px 80px; }
  .crumb { font-family: var(--pc-font-mono); font-size: 12px; display: flex; gap: 8px; color: var(--pc-ink-muted); margin-bottom: 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--pc-accent); margin: 0 0 6px; }
  h1 { font-size: clamp(28px, 5vw, 42px); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 10px; }
  .dek { max-width: 62ch; color: var(--pc-ink-soft); line-height: 1.55; margin: 0; }
  .dek code, .foot code, .caption code { font-family: var(--pc-font-mono); font-size: 0.92em; }

  .case { margin-top: 32px; }
  .plaque {
    font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em;
    color: var(--pc-ink-soft); background: #f0eee9; border: 1.5px solid var(--pc-ink);
    border-bottom: 0; margin: 0; padding: 8px 14px;
  }
  .glass { border: 1.5px solid var(--pc-ink); padding: 26px 18px; background: #efece6; }
  .caption { font-size: 12.5px; color: var(--pc-ink-muted); line-height: 1.55; margin: 8px 0 0; }

  /* ── The replica. Honest approximation of the Tailwind-era look:
     warm paper, one 34rem column, mono smallcaps chrome, serif feed. ── */
  .v1 { max-width: 34rem; margin: 0 auto; background: #faf7f1; color: #2a2724; padding: 22px 18px 26px; box-shadow: 0 2px 14px rgba(30, 25, 18, 0.18); }
  .v1-masthead { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid #d8d2c6; border-bottom: 1px solid #d8d2c6; padding: 9px 2px; }
  .v1-mast-left { display: flex; align-items: baseline; gap: 14px; }
  .v1-logo { font-family: var(--pc-font-mono); font-weight: 700; font-size: 20px; letter-spacing: 0.22em; }
  .v1-navlink { font-family: var(--pc-font-mono); font-size: 8.5px; letter-spacing: 0.22em; color: #8b8375; }
  .v1-mast-right { display: flex; align-items: center; gap: 10px; }
  .v1-pill { display: inline-flex; align-items: center; gap: 5px; font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: 0.14em; border: 1px solid #c9c2b2; border-radius: 999px; padding: 2px 8px; color: #6b6355; }
  .v1-dot { width: 6px; height: 6px; border-radius: 50%; background: #3f9e57; }
  .v1-noun { border-radius: 6px; image-rendering: pixelated; box-shadow: 0 0 0 1px #c9885f66; }

  .v1-byline { padding: 16px 2px 4px; }
  .v1-byline h3 { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 500; font-size: 17px; margin: 0 0 3px; }
  .v1-role { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: 0.14em; color: #8b8375; margin: 0 0 6px; }
  .v1-bio { font-size: 13.5px; color: #504a41; line-height: 1.55; margin: 0; }

  .v1-feed { margin-top: 14px; }
  .v1-item { border-top: 1px solid #e2dccf; padding: 12px 2px; }
  .v1-meta { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: 0.14em; color: #8b8375; margin: 0 0 4px; }
  .v1-item h4 { font-family: Georgia, 'Times New Roman', serif; font-size: 16.5px; font-weight: 600; margin: 0 0 4px; color: #2a2724; }
  .v1-dek { font-size: 13px; color: #575043; line-height: 1.5; margin: 0; }

  .v1-signoff { border-top: 1px solid #e2dccf; margin: 8px 0 0; padding: 12px 2px 0; font-family: Georgia, serif; font-style: italic; font-size: 13px; color: #6b6355; }

  .specimens { margin-top: 38px; border-top: 1.5px solid var(--pc-ink); padding-top: 14px; }
  .specimens h2 { font-size: 17px; font-weight: 700; margin: 0 0 4px; }
  .note { color: var(--pc-ink-muted); font-size: 13px; margin: 0 0 12px; }
  .specimens ul { list-style: none; margin: 0; padding: 0; max-width: 70ch; }
  .specimens li { display: flex; gap: 14px; align-items: baseline; padding: 5px 0; border-bottom: 1px solid var(--pc-rule-soft); font-size: 13.5px; }
  .specimens code { font-family: var(--pc-font-mono); font-size: 12.5px; font-weight: 700; min-width: 110px; }
  .specimens span { color: var(--pc-ink-soft); }

  .foot { margin-top: 44px; border-top: 1.5px solid var(--pc-ink); padding-top: 12px; font-size: 13px; color: var(--pc-ink-muted); }
</style>
