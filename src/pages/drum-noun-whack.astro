---
/**
 * /drum-noun-whack — Whack-a-Noun. Nine burrows in the dark yard behind
 * the drum house. Real Nouns pop up on the beat of a synthesized 104 BPM
 * groove — bonk them before they duck. Q W E / A S D / Z X C map to the
 * grid, or just tap the burrow. Fast bonks pay more, combos stack, and
 * about one pop in nine comes up GOLDEN and pays triple.
 *
 * Sixty seconds, grade S–D by bonk rate, best score in your pocket
 * (localStorage). Bonks broadcast on the /api/sounds bus so the cast
 * surfaces flash — seed is the burrow you hit.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Whack-a-Noun · nine burrows, sixty seconds';
const description = 'Nouns pop out of nine burrows on a 104 BPM groove. Bonk them before they duck — fast hands pay, combos stack, and the golden ones pay triple.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Whack-a-Noun', url: 'https://pointcast.xyz/drum-noun-whack', description, gamePlatform: 'Web browser', playMode: 'SinglePlayer' };
---
<BlockLayout title={title} description={description} image="/images/og-drum.png" jsonLd={jsonLd}>
  <div class="dnw" id="dnw">
    <header class="dnw__hud">
      <div class="dnw__hud-cell dnw__hud-cell--left">
        <strong class="dnw__combo" id="dnw-combo">x0</strong>
        <em>combo</em>
      </div>
      <div class="dnw__hud-cell dnw__hud-cell--mid">
        <strong class="dnw__score" id="dnw-score">0</strong>
        <em>score</em>
      </div>
      <div class="dnw__hud-cell dnw__hud-cell--right">
        <strong class="dnw__time" id="dnw-time">60</strong>
        <em>seconds</em>
      </div>
    </header>

    <section class="dnw__yard">
      <div class="dnw__grid" id="dnw-grid">
        <button class="dnw__burrow" data-idx="0" type="button" aria-label="Burrow 1 (key Q)">
          <img class="dnw__noun" src="https://noun.pics/7.svg" alt="" width="96" height="96" />
          <span class="dnw__key">Q</span>
        </button>
        <button class="dnw__burrow" data-idx="1" type="button" aria-label="Burrow 2 (key W)">
          <img class="dnw__noun" src="https://noun.pics/40.svg" alt="" width="96" height="96" />
          <span class="dnw__key">W</span>
        </button>
        <button class="dnw__burrow" data-idx="2" type="button" aria-label="Burrow 3 (key E)">
          <img class="dnw__noun" src="https://noun.pics/116.svg" alt="" width="96" height="96" />
          <span class="dnw__key">E</span>
        </button>
        <button class="dnw__burrow" data-idx="3" type="button" aria-label="Burrow 4 (key A)">
          <img class="dnw__noun" src="https://noun.pics/205.svg" alt="" width="96" height="96" />
          <span class="dnw__key">A</span>
        </button>
        <button class="dnw__burrow" data-idx="4" type="button" aria-label="Burrow 5 (key S)">
          <img class="dnw__noun" src="https://noun.pics/372.svg" alt="" width="96" height="96" />
          <span class="dnw__key">S</span>
        </button>
        <button class="dnw__burrow" data-idx="5" type="button" aria-label="Burrow 6 (key D)">
          <img class="dnw__noun" src="https://noun.pics/558.svg" alt="" width="96" height="96" />
          <span class="dnw__key">D</span>
        </button>
        <button class="dnw__burrow" data-idx="6" type="button" aria-label="Burrow 7 (key Z)">
          <img class="dnw__noun" src="https://noun.pics/690.svg" alt="" width="96" height="96" />
          <span class="dnw__key">Z</span>
        </button>
        <button class="dnw__burrow" data-idx="7" type="button" aria-label="Burrow 8 (key X)">
          <img class="dnw__noun" src="https://noun.pics/903.svg" alt="" width="96" height="96" />
          <span class="dnw__key">X</span>
        </button>
        <button class="dnw__burrow" data-idx="8" type="button" aria-label="Burrow 9 (key C)">
          <img class="dnw__noun" src="https://noun.pics/1120.svg" alt="" width="96" height="96" />
          <span class="dnw__key">C</span>
        </button>
      </div>

      <div class="dnw__overlay" id="dnw-overlay">
        <h1 class="dnw__title" id="dnw-title">WHACK-A-NOUN</h1>
        <p class="dnw__sub" id="dnw-sub">nine burrows · sixty seconds · Q W E / A S D / Z X C or tap</p>
        <p class="dnw__stats" id="dnw-stats"></p>
        <p class="dnw__best-line" id="dnw-best-line">best — · grade —</p>
        <button class="dnw__go" id="dnw-go" type="button">▶ OPEN THE YARD</button>
      </div>
    </section>

    <nav class="dnw__siblings">
      <a href="/drum-noun-crossing">noun crossing</a>
      <a href="/drum-says">drum says</a>
      <a href="/drum-quickdraw">quickdraw</a>
      <a href="/drum">/drum</a>
    </nav>
  </div>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dnw) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dnw {
      max-width: 560px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 94vh;
    }

    /* HUD — combo · score · time */
    .dnw__hud {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 2px 6px;
      min-height: 48px;
    }
    .dnw__hud-cell {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 84px;
    }
    .dnw__hud-cell--left { align-items: flex-start; }
    .dnw__hud-cell--mid { align-items: center; }
    .dnw__hud-cell--right { align-items: flex-end; }
    .dnw__hud strong {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .dnw__hud em {
      font-style: normal;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8a8a9a;
    }
    .dnw__combo {
      font-size: 34px;
      color: #f6c15e;
      text-shadow: 0 0 14px rgba(246,193,94,0.35);
    }
    .dnw__combo--pop { animation: dnwComboPop 160ms ease; }
    @keyframes dnwComboPop {
      0% { transform: scale(1); }
      40% { transform: scale(1.18); }
      100% { transform: scale(1); }
    }
    .dnw__combo--broken { color: #ff6b8a; text-shadow: 0 0 14px rgba(255,107,138,0.4); }
    .dnw__score { font-size: 30px; color: #f4e7c8; }
    .dnw__time { font-size: 30px; color: #7ac8ed; }
    .dnw__time--low { color: #ff6b8a; }

    /* YARD */
    .dnw__yard {
      position: relative;
      border-radius: 16px;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 80%, #1c0e2e 100%);
      padding: 14px;
    }
    .dnw__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    /* BURROW — round-topped mound, overflow hidden so the Noun rises out */
    .dnw__burrow {
      position: relative;
      aspect-ratio: 1;
      border: 1px solid rgba(244,231,200,0.10);
      border-radius: 46% 46% 14px 14px;
      overflow: hidden;
      cursor: pointer;
      padding: 0;
      background:
        radial-gradient(120% 70% at 50% 108%, #04030a 0%, #0d0a1c 46%, #171029 100%);
      box-shadow: inset 0 -10px 18px rgba(0,0,0,0.55);
      transition: box-shadow 160ms ease, filter 160ms ease;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .dnw__burrow:active { filter: brightness(1.12); }
    .dnw__burrow--gold {
      box-shadow:
        inset 0 -10px 18px rgba(0,0,0,0.55),
        0 0 0 2px rgba(246,193,94,0.75),
        0 0 26px rgba(246,193,94,0.4);
    }
    .dnw__burrow--whiff { box-shadow: inset 0 -10px 18px rgba(0,0,0,0.55), 0 0 0 2px rgba(255,107,138,0.55); }

    .dnw__noun {
      position: absolute;
      left: 50%;
      bottom: 4%;
      width: 74%;
      height: auto;
      image-rendering: pixelated;
      transform: translate(-50%, 120%);
      transform-origin: 50% 100%;
      transition: transform 150ms cubic-bezier(0.2, 0.9, 0.3, 1.2), filter 120ms ease;
      pointer-events: none;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }
    .dnw__noun--up { transform: translate(-50%, 0%); }
    .dnw__noun--bonked {
      transform: translate(-50%, 34%) scaleY(0.42);
      transition-duration: 80ms;
    }
    .dnw__noun--duck { transition-duration: 240ms; transition-timing-function: ease-in; }
    .dnw__burrow--gold .dnw__noun {
      filter:
        drop-shadow(0 0 10px rgba(246,193,94,0.9))
        drop-shadow(0 0 22px rgba(246,193,94,0.5))
        brightness(1.12) saturate(1.15);
    }

    .dnw__key {
      position: absolute;
      bottom: 6px;
      right: 9px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      color: rgba(244,231,200,0.28);
      pointer-events: none;
    }

    /* OVERLAY — start / game over. Toggled by CLASS, never [hidden]. */
    .dnw__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(7,5,15,0.84);
      backdrop-filter: blur(3px);
      border-radius: 16px;
      z-index: 4;
      text-align: center;
      padding: 20px;
    }
    .dnw__overlay--hidden { display: none; }
    .dnw__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(26px, 7.5vw, 44px);
      letter-spacing: 0.18em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dnw__sub, .dnw__stats, .dnw__best-line {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
      max-width: 380px;
      line-height: 1.7;
    }
    .dnw__stats { color: #f4e7c8; }
    .dnw__best-line { color: #d4a437; }
    .dnw__go {
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dnw__go:hover { transform: translateY(-1px); background: #ffd98a; }

    .dnw__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dnw__siblings a { color: #d4a437; text-decoration: none; }
    .dnw__siblings a:hover { text-decoration: underline; }

    @media (max-width: 400px) {
      .dnw__grid { gap: 8px; }
      .dnw__combo { font-size: 28px; }
      .dnw__score, .dnw__time { font-size: 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .dnw *, .dnw *::before, .dnw *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>

  <script>
    // Nine real Nouns take turns in the burrows (none from the concert's cast).
    const NOUN_POOL = [7, 40, 116, 205, 372, 558, 690, 903, 1120];
    const RUN_MS = 60_000;
    const BPM = 104;
    const STEP_SEC = 60 / BPM / 2;      // eighth notes
    const LOOKAHEAD_SEC = 0.14;
    const TICK_MS = 25;
    const UP_MS_START = 950;            // how long a Noun stays up, early game
    const UP_MS_END = 550;              // ...shrinking to this by the final bell
    const GOLD_CHANCE = 1 / 9;
    const DOUBLE_AFTER_MS = 30_000;     // past the half, sometimes two at once
    const DOUBLE_CHANCE = 0.35;
    const COOLDOWN_MS = 300;            // a bonked burrow settles before re-popping

    // one pentatonic voice per burrow, so even the misses stay musical
    const BLIP_FREQS = [392.0, 440.0, 523.25, 587.33, 659.25, 783.99, 880.0, 1046.5, 1174.66];

    type Phase = 'idle' | 'playing' | 'over';
    type Burrow = {
      up: boolean;
      pending: boolean;       // pop already scheduled by the groove, not visible yet
      golden: boolean;
      poppedAt: number;       // performance.now() at pop
      cooldownUntil: number;
      duckTimer: number;
      dropTimer: number;
    };

    let SESSION_ID = '';
    let phase: Phase = 'idle';
    let runId = 0;
    let runStart = 0;
    let score = 0;
    let combo = 0;
    let bestCombo = 0;
    let pops = 0;
    let bonks = 0;
    let goldenBonks = 0;
    let whiffs = 0;
    let best = 0;

    let schedTimer = 0;
    let hudTimer = 0;
    let endTimer = 0;
    let nextStepTime = 0;   // audio-clock seconds
    let stepCount = 0;
    const popTimers: number[] = [];

    const burrows: Burrow[] = Array.from({ length: 9 }, () => ({
      up: false, pending: false, golden: false, poppedAt: 0, cooldownUntil: 0, duckTimer: 0, dropTimer: 0,
    }));

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx();
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(150, t);
      o.frequency.exponentialRampToValueAtTime(48, t + 0.14);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.3, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.26);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.3);
    }
    function pHat(t: number, open = false) {
      const a = ctx();
      const dur = open ? 0.16 : 0.05;
      const buf = a.createBuffer(1, Math.ceil(a.sampleRate * dur), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7200;
      const g = a.createGain();
      g.gain.setValueAtTime(open ? 0.10 : 0.07, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    // tiny pop blip — one note per burrow, gold pops sparkle an octave up
    function pBlip(t: number, idx: number, golden: boolean) {
      const a = ctx();
      const f = BLIP_FREQS[idx];
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'triangle';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(golden ? 0.11 : 0.08, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.16);
      if (golden) {
        const o2 = a.createOscillator(); const g2 = a.createGain();
        o2.type = 'sine'; o2.frequency.setValueAtTime(f * 2, t + 0.03);
        g2.gain.setValueAtTime(0.0001, t + 0.03);
        g2.gain.exponentialRampToValueAtTime(0.06, t + 0.035);
        g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
        o2.connect(g2).connect(a.destination); o2.start(t + 0.03); o2.stop(t + 0.18);
      }
    }
    // the bonk — pitch-dropping sine thump + a tiny square squeak
    function pBonk() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(190, t);
      o.frequency.exponentialRampToValueAtTime(55, t + 0.16);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.38, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.34);
      const s = a.createOscillator(); const sg = a.createGain();
      s.type = 'square';
      s.frequency.setValueAtTime(1450, t + 0.01);
      s.frequency.exponentialRampToValueAtTime(880, t + 0.07);
      sg.gain.setValueAtTime(0.0001, t + 0.01);
      sg.gain.exponentialRampToValueAtTime(0.05, t + 0.014);
      sg.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
      s.connect(sg).connect(a.destination); s.start(t + 0.01); s.stop(t + 0.1);
    }
    // golden bonk — the thump plus a bright little arpeggio
    function pGoldenBonk() {
      pBonk();
      const a = ctx(); const base = a.currentTime + 0.03;
      [659.25, 830.61, 987.77, 1318.5].forEach((f, i) => {
        const t = base + i * 0.045;
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.16, t + 0.006);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.2);
        o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.24);
      });
    }
    // a Noun ducks un-bonked — soft descending whistle
    function pDuck() {
      const a = ctx(); const t = a.currentTime + 0.005;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(720, t);
      o.frequency.exponentialRampToValueAtTime(320, t + 0.32);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.07, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.38);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.42);
    }
    // whacking an empty burrow — a dull whiff thud
    function pWhiff() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(95, t);
      o.frequency.exponentialRampToValueAtTime(58, t + 0.1);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.2, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.2);
      const buf = a.createBuffer(1, Math.ceil(a.sampleRate * 0.05), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const lp = a.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 340;
      const ng = a.createGain(); ng.gain.value = 0.18;
      n.connect(lp).connect(ng).connect(a.destination); n.start(t);
    }
    function pFanfare(good: boolean) {
      const a = ctx(); const base = a.currentTime + 0.02;
      const notes = good ? [523.25, 659.25, 783.99, 1046.5] : [392.0, 329.63, 261.63];
      notes.forEach((f, i) => {
        const t = base + i * 0.11;
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.24, t + 0.01);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
        o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.34);
      });
    }

    // ---- shared drum bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(seed: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // never flood the bus
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- dom (all server-rendered; we only toggle classes and swap src) ----
    const burrowEls = Array.from(document.querySelectorAll('.dnw__burrow')) as HTMLButtonElement[];
    const nounImgs = burrowEls.map((b) => b.querySelector('.dnw__noun') as HTMLImageElement);
    const overlay = document.getElementById('dnw-overlay')!;
    const goBtn = document.getElementById('dnw-go') as HTMLButtonElement;
    const titleEl = document.getElementById('dnw-title')!;
    const subEl = document.getElementById('dnw-sub')!;
    const statsEl = document.getElementById('dnw-stats')!;
    const bestLine = document.getElementById('dnw-best-line')!;
    const comboEl = document.getElementById('dnw-combo')!;
    const scoreEl = document.getElementById('dnw-score')!;
    const timeEl = document.getElementById('dnw-time')!;

    // ---- hud ----
    function setScore(n: number) { scoreEl.textContent = String(n); }
    function setCombo(n: number, broken = false) {
      comboEl.textContent = `x${n}`;
      comboEl.classList.toggle('dnw__combo--broken', broken);
      if (!broken) {
        comboEl.classList.remove('dnw__combo--pop');
        void comboEl.offsetWidth; // retrigger the pop
        comboEl.classList.add('dnw__combo--pop');
      }
    }
    function breakCombo() {
      if (combo > 0) setCombo(0, true);
      combo = 0;
    }
    function updateClock() {
      const left = Math.max(0, RUN_MS - (performance.now() - runStart));
      const s = Math.ceil(left / 1000);
      timeEl.textContent = String(s);
      timeEl.classList.toggle('dnw__time--low', s <= 10);
    }

    // ---- groove + pop scheduling (lookahead, drum-hero style) ----
    function elapsedMs() { return performance.now() - runStart; }
    function upMsNow() {
      const k = Math.min(1, elapsedMs() / RUN_MS);
      return UP_MS_START - (UP_MS_START - UP_MS_END) * k;
    }
    function popChanceNow() {
      const k = Math.min(1, elapsedMs() / RUN_MS);
      return 0.5 + 0.35 * k;
    }
    function upOrPendingCount() {
      let n = 0;
      for (const b of burrows) if (b.up || b.pending) n++;
      return n;
    }
    function pickDownBurrow(): number {
      const now = performance.now();
      const free: number[] = [];
      for (let i = 0; i < 9; i++) {
        const b = burrows[i];
        if (!b.up && !b.pending && now >= b.cooldownUntil) free.push(i);
      }
      if (!free.length) return -1;
      return free[Math.floor(Math.random() * free.length)];
    }
    function schedulePop(eventTime: number) {
      const idx = pickDownBurrow();
      if (idx < 0) return;
      const b = burrows[idx];
      b.pending = true;
      const golden = Math.random() < GOLD_CHANCE;
      pBlip(eventTime, idx, golden);
      const delay = Math.max(0, (eventTime - ctx().currentTime) * 1000);
      const rid = runId;
      popTimers.push(window.setTimeout(() => {
        if (rid !== runId || phase !== 'playing') { b.pending = false; return; }
        popNoun(idx, golden);
      }, delay));
    }
    function scheduleAhead() {
      if (phase !== 'playing' || !actx || actx.state !== 'running') return;
      const a = actx;
      while (nextStepTime < a.currentTime + LOOKAHEAD_SEC) {
        const t = Math.max(nextStepTime, a.currentTime + 0.005);
        const stepInBar = stepCount % 8;
        // four-on-the-floor kick, offbeat hats, open hat closing the bar
        if (stepInBar % 2 === 0) pKick(t);
        else pHat(t, stepInBar === 7);
        // pops ride the same clock, so the yard moves with the groove
        if (elapsedMs() + (nextStepTime - a.currentTime) * 1000 < RUN_MS - 700) {
          if (Math.random() < popChanceNow()) {
            const cap = elapsedMs() > DOUBLE_AFTER_MS && Math.random() < DOUBLE_CHANCE ? 2 : 1;
            if (upOrPendingCount() < cap) {
              schedulePop(t);
              if (cap === 2 && upOrPendingCount() < 2 && Math.random() < 0.5) schedulePop(t);
            }
          }
        }
        nextStepTime += STEP_SEC;
        stepCount++;
      }
    }

    // ---- burrow lifecycle ----
    function popNoun(idx: number, golden: boolean) {
      const b = burrows[idx];
      b.pending = false;
      b.up = true;
      b.golden = golden;
      b.poppedAt = performance.now();
      pops++;
      nounImgs[idx].src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;
      nounImgs[idx].classList.remove('dnw__noun--bonked', 'dnw__noun--duck');
      nounImgs[idx].classList.add('dnw__noun--up');
      burrowEls[idx].classList.toggle('dnw__burrow--gold', golden);
      clearTimeout(b.duckTimer);
      const rid = runId;
      b.duckTimer = window.setTimeout(() => {
        if (rid !== runId) return;
        duckNoun(idx);
      }, upMsNow());
    }
    function duckNoun(idx: number) {
      const b = burrows[idx];
      if (!b.up) return;
      b.up = false;
      b.cooldownUntil = performance.now() + COOLDOWN_MS;
      const img = nounImgs[idx];
      img.classList.add('dnw__noun--duck');
      img.classList.remove('dnw__noun--up');
      burrowEls[idx].classList.remove('dnw__burrow--gold');
      clearTimeout(b.dropTimer);
      const rid = runId;
      b.dropTimer = window.setTimeout(() => {
        if (rid !== runId) return;
        img.classList.remove('dnw__noun--duck');
      }, 260);
      if (phase === 'playing') {
        pDuck();
        breakCombo();
      }
    }
    function bonkNoun(idx: number) {
      const b = burrows[idx];
      b.up = false;
      b.cooldownUntil = performance.now() + COOLDOWN_MS;
      clearTimeout(b.duckTimer);
      const reaction = performance.now() - b.poppedAt;
      const speedBonus = Math.round(Math.max(0, 1 - reaction / upMsNow()) * 100);
      combo++;
      if (combo > bestCombo) bestCombo = combo;
      const points = (100 + speedBonus + combo * 10) * (b.golden ? 3 : 1);
      score += points;
      bonks++;
      if (b.golden) { goldenBonks++; pGoldenBonk(); } else { pBonk(); }
      setScore(score);
      setCombo(combo);
      broadcast(idx);
      // squash, then drop back into the burrow
      const img = nounImgs[idx];
      img.classList.remove('dnw__noun--up', 'dnw__noun--duck');
      img.classList.add('dnw__noun--bonked');
      clearTimeout(b.dropTimer);
      const rid = runId;
      b.dropTimer = window.setTimeout(() => {
        if (rid !== runId) return;
        img.classList.remove('dnw__noun--bonked');
        burrowEls[idx].classList.remove('dnw__burrow--gold');
      }, 130);
    }
    function whiff(idx: number) {
      whiffs++;
      pWhiff();
      breakCombo();
      const el = burrowEls[idx];
      el.classList.add('dnw__burrow--whiff');
      const rid = runId;
      window.setTimeout(() => {
        if (rid !== runId) return;
        el.classList.remove('dnw__burrow--whiff');
      }, 220);
    }
    function hit(idx: number) {
      if (phase !== 'playing') return;
      if (burrows[idx].up) bonkNoun(idx);
      else whiff(idx);
    }

    // ---- run machine ----
    function clearRunTimers() {
      clearInterval(schedTimer);
      clearInterval(hudTimer);
      clearTimeout(endTimer);
      while (popTimers.length) clearTimeout(popTimers.pop());
      for (const b of burrows) { clearTimeout(b.duckTimer); clearTimeout(b.dropTimer); }
    }
    function resetBurrows() {
      for (let i = 0; i < 9; i++) {
        const b = burrows[i];
        b.up = false; b.pending = false; b.golden = false; b.cooldownUntil = 0;
        nounImgs[i].classList.remove('dnw__noun--up', 'dnw__noun--bonked', 'dnw__noun--duck');
        burrowEls[i].classList.remove('dnw__burrow--gold', 'dnw__burrow--whiff');
      }
    }
    function startRun() {
      const a = ctx();
      runId++;
      clearRunTimers();
      resetBurrows();
      phase = 'playing';
      score = 0; combo = 0; bestCombo = 0;
      pops = 0; bonks = 0; goldenBonks = 0; whiffs = 0;
      setScore(0);
      setCombo(0);
      comboEl.classList.remove('dnw__combo--broken');
      runStart = performance.now();
      updateClock();
      nextStepTime = a.currentTime + 0.1;
      stepCount = 0;
      overlay.classList.add('dnw__overlay--hidden');
      schedTimer = window.setInterval(scheduleAhead, TICK_MS);
      scheduleAhead();
      hudTimer = window.setInterval(updateClock, 100);
      endTimer = window.setTimeout(endRun, RUN_MS);
    }
    function gradeOf(rate: number) {
      if (rate >= 0.9) return 'S';
      if (rate >= 0.75) return 'A';
      if (rate >= 0.6) return 'B';
      if (rate >= 0.4) return 'C';
      return 'D';
    }
    function endRun() {
      phase = 'over';
      clearRunTimers();
      // anything still up slips home quietly — no whistle, no combo penalty
      for (let i = 0; i < 9; i++) {
        burrows[i].up = false;
        burrows[i].pending = false;
        nounImgs[i].classList.remove('dnw__noun--up', 'dnw__noun--bonked', 'dnw__noun--duck');
        burrowEls[i].classList.remove('dnw__burrow--gold', 'dnw__burrow--whiff');
      }
      timeEl.textContent = '0';
      const rate = pops > 0 ? bonks / pops : 0;
      const grade = gradeOf(rate);
      titleEl.textContent = `GRADE ${grade}`;
      subEl.textContent = `${score} points · sixty seconds in the yard`;
      statsEl.textContent =
        `${bonks} / ${pops} bonked · best combo x${bestCombo}` +
        `${goldenBonks ? ` · ${goldenBonks} golden` : ''}` +
        `${whiffs ? ` · ${whiffs} whiff${whiffs > 1 ? 's' : ''}` : ''}`;
      goBtn.textContent = '▶ RUN IT BACK';
      pFanfare(grade === 'S' || grade === 'A' || grade === 'B');
      try {
        const prev = Number(localStorage.getItem('pc-drum-noun-whack-best') || 0);
        const better = score > prev;
        if (better) {
          localStorage.setItem('pc-drum-noun-whack-best', String(score));
          localStorage.setItem('pc-drum-noun-whack-grade', grade);
        }
        const shown = better ? score : prev;
        const sg = better ? grade : (localStorage.getItem('pc-drum-noun-whack-grade') || grade);
        best = shown;
        bestLine.textContent = `best ${shown} · grade ${sg}`;
      } catch {
        bestLine.textContent = `best ${score} · grade ${grade}`;
      }
      overlay.classList.remove('dnw__overlay--hidden');
      goBtn.focus({ preventScroll: true });
    }

    // ---- input ----
    burrowEls.forEach((el) => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        hit(Number(el.dataset.idx));
      });
      el.addEventListener('click', (e) => {
        // pointer input lands on contact; keyboard/AT activation arrives as detail 0
        if (e.detail === 0) hit(Number(el.dataset.idx));
      });
    });
    goBtn.addEventListener('click', () => { ctx(); startRun(); });
    const KEY_MAP: Record<string, number> = {
      KeyQ: 0, KeyW: 1, KeyE: 2,
      KeyA: 3, KeyS: 4, KeyD: 5,
      KeyZ: 6, KeyX: 7, KeyC: 8,
    };
    window.addEventListener('keydown', (e) => {
      if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
      const idx = KEY_MAP[e.code];
      if (idx === undefined) return;
      e.preventDefault();
      hit(idx);
    });

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    try {
      best = Number(localStorage.getItem('pc-drum-noun-whack-best') || 0) || 0;
      const bg = localStorage.getItem('pc-drum-noun-whack-grade');
      if (best > 0) bestLine.textContent = `best ${best} · grade ${bg || '—'}`;
    } catch {}
  </script>
</BlockLayout>
