---
/**
 * /posts — index of every long-form post in src/content/posts.
 * Added 2026-10-08: /posts/{slug} pages shipped with no parent door.
 */
import { getCollection } from 'astro:content';
import BlockLayout from '../../layouts/BlockLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const title = 'Posts';
const description = `Every long-form PointCast post, newest first — ${posts.length} so far.`;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BlockLayout title={title} description={description}>
  <main class="ix">
    <nav class="ix-crumb mono"><a href="/">Home</a> / posts</nav>
    <header class="ix-head">
      <p class="ix-kicker mono">POSTS · {posts.length}</p>
      <h1>Posts</h1>
      <p class="ix-deck">Long-form writing: essays, case studies, newsletters. Newest first.</p>
    </header>
    <ol class="ix-list">
      {posts.map((p) => (
        <li>
          <a href={`/posts/${p.id}`}>
            <span class="ix-meta mono">{fmt(p.data.date)} · {p.data.type}</span>
            <span class="ix-t">{p.data.title}</span>
            <span class="ix-d">{p.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BlockLayout>

<style>
  .ix { max-width: 760px; margin: 0 auto; padding: 0 20px 88px; color: var(--pc-ink); }
  .mono { font-family: var(--pc-font-mono); }
  .ix-crumb { font-size: 12px; margin: 18px 0 0; color: var(--pc-ink-muted); }
  .ix-crumb a { color: inherit; }
  .ix-head { border: 1.5px solid var(--pc-accent); border-left-width: 6px; border-radius: 2px; padding: 22px 24px 20px; margin: 14px 0 0; }
  .ix-kicker { font-size: 11px; letter-spacing: 0.1em; color: var(--pc-accent); margin: 0 0 12px; }
  .ix-head h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 500; margin: 0 0 10px; }
  .ix-deck { font-size: 15px; line-height: 1.5; color: var(--pc-ink-soft); margin: 0; }
  .ix-list { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1.5px solid var(--pc-ink); }
  .ix-list li { border-bottom: 1px solid var(--pc-rule-soft); }
  .ix-list a { display: grid; gap: 4px; padding: 14px 6px; text-decoration: none; color: inherit; }
  .ix-list a:hover { background: var(--pc-rule-soft); }
  .ix-meta { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pc-ink-muted); }
  .ix-t { font-size: 17px; font-weight: 500; }
  .ix-d { font-size: 14px; line-height: 1.45; color: var(--pc-ink-soft); }
</style>
