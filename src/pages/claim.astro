---
/**
 * /claim — optional one-time page. Not a sign-in, and not required to post
 * on the Loom or to reply on X. No external assets.
 */
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Claim a note</title>
    <meta name="description" content="Optional one-time link for a Nouns Money art note. A short code for an X reply, or a .tez name. No cash value. Never priced." />
    <meta name="robots" content="noindex" />
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      html { scroll-behavior: auto; }
      body {
        margin: 0;
        background: #f3efe6;
        color: #1a1714;
        font: 17px/1.45 "Iowan Old Style", Palatino, Georgia, serif;
      }
      main {
        width: min(100%, 390px);
        margin: 0 auto;
        padding: 22px 18px 48px;
      }
      p, h1, h2, ol { margin: 0; }
      a { color: #1f4f45; }
      .kicker {
        font: 600 12px/1.2 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #5c564c;
      }
      h1 { margin-top: 8px; font-size: 1.85rem; font-weight: 600; letter-spacing: -0.02em; }
      .lead, .honest, .path, form, .result { margin-top: 16px; }
      .honest {
        padding: 10px 12px;
        border-left: 3px solid #1f4f45;
        background: #e7f0ec;
      }
      ol { padding-left: 1.2rem; }
      li + li { margin-top: 12px; }
      h2 { font-size: 1.05rem; }
      label {
        display: block;
        margin: 12px 0 6px;
        font: 600 12px/1.2 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      input {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #cfc6b8;
        border-radius: 8px;
        background: #fffdf8;
        color: inherit;
        font: 16px/1.3 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      }
      button {
        width: 100%;
        min-height: 44px;
        margin-top: 10px;
        border: 0;
        border-radius: 8px;
        background: #1f4f45;
        color: #f3efe6;
        font: 600 16px/1 ui-sans-serif, system-ui, sans-serif;
      }
      button.quiet { background: transparent; color: #1f4f45; border: 1px solid #1f4f45; }
      .result {
        min-height: 1.2em;
        padding-top: 8px;
        overflow-wrap: anywhere;
      }
      .code {
        font: 700 28px/1.2 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        letter-spacing: 0.08em;
      }
      pre {
        white-space: pre-wrap;
        font: 13px/1.4 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      }
      .foot { margin-top: 28px; font-size: 0.95rem; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="kicker">Optional</p>
      <h1>Claim a note</h1>
      <p class="lead">You can post on the Loom and reply on X without opening this page. It is not a sign-in and it is not a gate.</p>
      <p class="honest">These are art notes. No cash value. Never priced.</p>
      <ol>
        <li>
          <h2>One-time claim link</h2>
          <p class="path">Come here once if you want a short code instead of a raw wallet address in a public reply. A Beacon wallet signs a read-only check on your own device. This desk never asks for a secret and it never submits a transaction.</p>
        </li>
        <li>
          <h2>Short X reply</h2>
          <p class="path">The reply you post is a short code shaped NM-XXXXXX. Leave the raw wallet address out of that reply.</p>
        </li>
        <li>
          <h2>.tez name</h2>
          <p class="path">If a public .tez name points at the wallet, look it up here. We ask "is this you?" from the public directory. You can reply with the name.</p>
        </li>
      </ol>
      <form method="get" action="/claim">
        <label for="who">Public address or .tez name</label>
        <input id="who" name="who" autocomplete="off" spellcheck="false" maxlength="80" />
        <label for="note">Note id, if you have one</label>
        <input id="note" name="note" autocomplete="off" spellcheck="false" maxlength="80" />
        <button type="button" id="make">Make a short code</button>
        <button type="button" id="look" class="quiet">Look up a .tez name</button>
        <label for="pk">Public key, if you want the check</label>
        <input id="pk" name="pk" autocomplete="off" spellcheck="false" maxlength="80" />
        <label for="sig">Signature, if you want the check</label>
        <input id="sig" name="sig" autocomplete="off" spellcheck="false" maxlength="200" />
        <button type="button" id="check" class="quiet">Check a signature</button>
      </form>
      <div class="result" id="out" aria-live="polite"></div>
      <p class="foot"><a href="/loom">The Loom does not require a claim.</a></p>
    </main>
    <noscript>The explanation above stands without scripts. The buttons call the read-only desk.</noscript>
    <script is:inline>
      const out = document.getElementById('out');
      const say = (text) => { out.textContent = text; };
      const ERRORS = {
        'not-found': 'This desk is closed. The Loom is still open, and an X reply does not need this page.',
        'secret-refused': 'This desk does not take secret material.',
        'lookup-unavailable': 'The public directory did not answer. Nothing was stored.',
        'bad-signature': 'That signature did not match this check.',
        'expired': 'That check has lapsed. Make another code.',
        'ed25519-only': 'This check reads a tz1 public key. A .tez name can still be the reply.',
        'bad-address': 'That does not look like a public address.',
        'bad-name': 'Use a public .tez name, such as ada.tez.',
        'unknown-action': 'This desk did not understand that.',
        'unavailable': 'The public directory did not answer. Nothing was stored.',
      };
      let last = null;
      async function post(payload) {
        const res = await fetch('/api/claim', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(ERRORS[data.error] || ERRORS['not-found']);
        return data;
      }
      function show(data) {
        const lines = [];
        if (data.prompt) lines.push(data.prompt);
        if (data.domain) lines.push(data.domain);
        if (data.reply) lines.push(data.reply);
        if (data.walletBook) lines.push(data.walletBook);
        if (Array.isArray(data.notes) && data.notes.length) {
          lines.push(data.notes.map((note) => note.name || note.tokenId).join(', '));
        }
        lines.push('Nothing was stored.');
        say(lines.join('\n'));
      }
      document.getElementById('make').addEventListener('click', async () => {
        try {
          const who = document.getElementById('who').value.trim();
          const noteId = document.getElementById('note').value.trim();
          if (who.toLowerCase().endsWith('.tez')) {
            const looked = await post({ action: 'lookup', domain: who });
            if (!looked.address) { show(looked); return; }
            const made = await post({ action: 'challenge', address: looked.address, noteId });
            last = made;
            show({ ...looked, reply: made.reply, walletBook: made.walletBook });
            return;
          }
          const made = await post({ action: 'challenge', address: who, noteId });
          last = made;
          show(made);
        } catch (error) { say(error.message); }
      });
      document.getElementById('look').addEventListener('click', async () => {
        try {
          const who = document.getElementById('who').value.trim();
          const looked = who.toLowerCase().endsWith('.tez')
            ? await post({ action: 'lookup', domain: who })
            : await post({ action: 'lookup', address: who });
          show(looked);
        } catch (error) { say(error.message); }
      });
      document.getElementById('check').addEventListener('click', async () => {
        try {
          if (!last?.challenge) { say('Make a short code first.'); return; }
          const checked = await post({
            action: 'verify',
            challenge: last.challenge,
            publicKey: document.getElementById('pk').value.trim(),
            signature: document.getElementById('sig').value.trim(),
          });
          show(checked);
        } catch (error) { say(error.message); }
      });
    </script>
  </body>
</html>
