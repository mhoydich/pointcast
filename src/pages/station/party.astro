---
/**
 * /station/party — a prototype, not a product. What does the town look like with
 * ten people in it, all with music on? Everything on this page is SCRIPTED: the
 * cast, what they play, the tempos (approximate, for the demo), what the agents
 * say. No real visitor, no real listening data, no network calls. It exists to find
 * out what becomes interesting for a group, so the real thing can be built toward it.
 *
 * The one real idea it carries is the privacy ladder already shipped in town: how
 * much the room knows about your music depends on what you chose to share
 * (Spotify connected · a pasted link · the wall listening · a tapped tempo · nothing).
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
const title = 'Ten listeners · a station prototype';
const description = 'A scripted simulation of ten visitors with music on at once: the floor, the room tempo, the moments a room notices, the polyrhythm wall, the feed, and two agents reading along.';
---
<BlockLayout title={title} description={description} hideAds showNetworkStrip={false} noindex>
  <main class="pty" data-party>
    <header class="pty-head">
      <p class="pty-kicker"><a href="/station">← Mike Hoydich Radio</a> · prototype · everything below is simulated</p>
      <h1>Ten people, <em>ten players.</em></h1>
      <p class="pty-dek">One person with music on is a companion. Ten is a room with a pulse. This is a scripted demo of that room: a cast of ten listeners and two agents, tracks changing on a fast clock, and the town noticing what only a group can show.</p>
      <div class="pty-ctl" role="group" aria-label="Simulation controls">
        <button type="button" data-ctl="pause" aria-pressed="false">Pause</button>
        <span class="pty-ctl__speed" role="group" aria-label="Speed"><button type="button" data-speed="1">1×</button><button type="button" data-speed="4" aria-pressed="true">4×</button><button type="button" data-speed="12">12×</button></span>
        <button type="button" data-ctl="restart">Restart</button>
        <span class="pty-clock" data-clock>0:00</span>
        <span class="pty-sim">SIMULATION · no real listeners</span>
      </div>
    </header>

    <div class="pty-top">
      <section class="pty-floor" aria-labelledby="pty-floor-title">
        <h2 id="pty-floor-title" class="pty-sr">The floor</h2>
        <div class="pty-stage" data-stage><canvas data-floor aria-hidden="true"></canvas><div class="pty-people" data-people></div>
          <div class="pty-pulse" data-pulse><b data-room-bpm>—</b><span>room tempo</span></div>
        </div>
        <p class="pty-legend"><span><i class="l-artist"></i>same artist</span><span><i class="l-lock"></i>tempos locked</span><span><i class="l-era"></i>same decade</span><span><i class="l-agent"></i>agent</span></p>
      </section>

      <section class="pty-now" aria-labelledby="pty-now-title">
        <h2 id="pty-now-title">The room right now</h2>
        <dl class="pty-stats" data-stats></dl>
        <h3>Era mix</h3>
        <div class="pty-era" data-era></div>
        <h3>Moments</h3>
        <ol class="pty-moments" data-moments aria-live="polite"><li class="pty-empty">The room is filling up…</li></ol>
      </section>
    </div>

    <section class="pty-panel" aria-labelledby="pty-wall-title">
      <h2 id="pty-wall-title">The polyrhythm wall</h2>
      <p class="pty-sub">One column per listener, each beating at its own tempo. Columns that fall into a simple ratio (1:1, 2:1, 3:2) light the same colour: that is the moment to start a drum circle.</p>
      <canvas class="pty-wall" data-wall aria-hidden="true"></canvas>
      <div class="pty-wall-names" data-wall-names></div>
    </section>

    <div class="pty-cols">
      <section class="pty-panel" aria-labelledby="pty-cast-title">
        <h2 id="pty-cast-title">Who the room can hear</h2>
        <p class="pty-sub">The room only knows what each person chose to share. Five rungs, from a connected Spotify down to nothing at all.</p>
        <ul class="pty-cast" data-cast></ul>
      </section>
      <section class="pty-panel" aria-labelledby="pty-feed-title">
        <h2 id="pty-feed-title">The feed</h2>
        <p class="pty-sub">Track changes, waves, drum hits, requests, and two agents reading along.</p>
        <ol class="pty-feed" data-feed aria-live="off"></ol>
      </section>
    </div>

    <section class="pty-panel" aria-labelledby="pty-tape-title">
      <h2 id="pty-tape-title">The room’s tape</h2>
      <p class="pty-sub">Everything the room has played this session, in order. In the real thing this saves as a playlist: what the town sounded like tonight.</p>
      <ol class="pty-tape" data-tape></ol>
    </section>

    <section class="pty-panel pty-learn" aria-labelledby="pty-learn-title">
      <h2 id="pty-learn-title">What the demo says to build</h2>
      <ol>
        <li><b>Overlap is the product.</b> Two strangers on the same artist is the single most useful thing a room can tell you. It should produce one action: a wave with the artist’s name on it.</li>
        <li><b>Tempo is a meeting place.</b> You do not need the same song, just the same pocket. Three people within a few BPM is an invitation to drum, and the wall shows it before anyone says it.</li>
        <li><b>Rooms drift together.</b> When people can see each other’s music they start borrowing it. The tape of that drift is worth keeping, and worth signing.</li>
        <li><b>Agents are better as readers than as DJs.</b> The useful agent moves are bridges between two listeners, liner notes on request, and filing the room’s favourite to the station’s request line. Not picking the music.</li>
        <li><b>The ladder has to stay visible.</b> People share more when they can see exactly which rung they are on and step down in one tap.</li>
      </ol>
      <p class="pty-sub">Built from what already runs in town: presence carries a <code>listening</code> label, the <a href="/#music-on">Music on shelf</a> taps and hears tempo, the <a href="/station#requests">request line</a> takes tracks from people and agents, and <a href="/station#notes">liner notes</a> are sourced. What is missing is this page with real people in it.</p>
    </section>
  </main>
</BlockLayout>

<script>
  // ── the script for the play ──────────────────────────────────────
  // Tempos are approximate and only here to drive the demo's pulses.
  type Track = { t: string; a: string; y: number; bpm: number; c: string };
  const CATALOG: Track[] = [
    { t: 'Roygbiv', a: 'Boards of Canada', y: 1998, bpm: 84, c: 'A' }, { t: 'Dayvan Cowboy', a: 'Boards of Canada', y: 2005, bpm: 100, c: 'A' },
    { t: 'Xtal', a: 'Aphex Twin', y: 1992, bpm: 115, c: 'A' }, { t: 'Teardrop', a: 'Massive Attack', y: 1998, bpm: 77, c: 'A' },
    { t: 'Glory Box', a: 'Portishead', y: 1994, bpm: 60, c: 'A' }, { t: 'Around the World', a: 'Daft Punk', y: 1997, bpm: 121, c: 'A' },
    { t: 'French Disko', a: 'Stereolab', y: 1993, bpm: 150, c: 'A' }, { t: 'Hyperballad', a: 'Björk', y: 1995, bpm: 120, c: 'A' },
    { t: 'Born Slippy (Nuxx)', a: 'Underworld', y: 1996, bpm: 140, c: 'A' }, { t: 'Windowlicker', a: 'Aphex Twin', y: 1999, bpm: 123, c: 'A' },
    { t: 'Dreams', a: 'Fleetwood Mac', y: 1977, bpm: 120, c: 'B' }, { t: 'Superstition', a: 'Stevie Wonder', y: 1972, bpm: 100, c: 'B' },
    { t: 'Psycho Killer', a: 'Talking Heads', y: 1977, bpm: 123, c: 'B' }, { t: 'Water No Get Enemy', a: 'Fela Kuti', y: 1975, bpm: 100, c: 'B' },
    { t: 'Old Man', a: 'Neil Young', y: 1972, bpm: 77, c: 'B' }, { t: 'Peg', a: 'Steely Dan', y: 1977, bpm: 117, c: 'B' },
    { t: 'Lovely Day', a: 'Bill Withers', y: 1977, bpm: 98, c: 'B' }, { t: 'Watcher of the Skies', a: 'Genesis', y: 1972, bpm: 118, c: 'B' },
    { t: 'Once in a Lifetime', a: 'Talking Heads', y: 1980, bpm: 117, c: 'B' }, { t: 'Solsbury Hill', a: 'Peter Gabriel', y: 1977, bpm: 102, c: 'B' },
    { t: 'Let It Happen', a: 'Tame Impala', y: 2015, bpm: 125, c: 'C' }, { t: 'Pink + White', a: 'Frank Ocean', y: 2016, bpm: 80, c: 'C' },
    { t: 'Evan Finds the Third Room', a: 'Khruangbin', y: 2018, bpm: 118, c: 'C' }, { t: 'Alright', a: 'Kendrick Lamar', y: 2015, bpm: 110, c: 'C' },
    { t: 'Can’t Do Without You', a: 'Caribou', y: 2014, bpm: 124, c: 'C' }, { t: 'Malamente', a: 'Rosalía', y: 2018, bpm: 98, c: 'C' },
    { t: 'Silhouettes (I, II & III)', a: 'Floating Points', y: 2015, bpm: 112, c: 'C' }, { t: 'Maria También', a: 'Khruangbin', y: 2018, bpm: 104, c: 'C' },
    { t: 'So What', a: 'Miles Davis', y: 1959, bpm: 136, c: 'D' }, { t: 'Journey in Satchidananda', a: 'Alice Coltrane', y: 1971, bpm: 92, c: 'D' },
    { t: 'An Ending (Ascent)', a: 'Brian Eno', y: 1983, bpm: 68, c: 'D' }, { t: 'Naima', a: 'John Coltrane', y: 1960, bpm: 62, c: 'D' },
    { t: 'Promises, Movement 1', a: 'Floating Points', y: 2021, bpm: 70, c: 'D' },
    { t: 'Brown Paper Bag', a: 'Roni Size', y: 1997, bpm: 174, c: 'E' }, { t: 'Inner City Life', a: 'Goldie', y: 1994, bpm: 170, c: 'E' },
  ];
  type Tier = 'spotify' | 'pasted' | 'mic' | 'tapped' | 'silent' | 'agent';
  const TIERS: Record<Tier, { label: string; knows: string }> = {
    spotify: { label: 'Spotify connected', knows: 'track, artist, changes live' }, pasted: { label: 'Pasted a link', knows: 'one track, for an hour' },
    mic: { label: 'The wall is listening', knows: 'tempo only, no title' }, tapped: { label: 'Tapped a tempo', knows: 'tempo only' },
    silent: { label: 'Sharing nothing', knows: 'that they are here' }, agent: { label: 'Agent · reading along', knows: 'no music; reads the room over MCP' },
  };
  type Person = { id: string; noun: number; tier: Tier; taste: string; joinAt: number; first?: string; track?: Track; ends: number; bpm: number; phase: number; here: boolean; hit: number };
  const CAST: Omit<Person, 'ends' | 'bpm' | 'phase' | 'here' | 'hit'>[] = [
    { id: 'mike', noun: 131, tier: 'spotify', taste: 'BBA', joinAt: 0, first: 'Watcher of the Skies' },
    { id: 'lowtide', noun: 412, tier: 'spotify', taste: 'AAD', joinAt: 3, first: 'Roygbiv' },
    { id: 'juniper', noun: 88, tier: 'spotify', taste: 'AAC', joinAt: 7, first: 'Dayvan Cowboy' },
    { id: 'marlo', noun: 703, tier: 'spotify', taste: 'BBC', joinAt: 12, first: 'Dreams' },
    { id: 'sable', noun: 27, tier: 'pasted', taste: 'A', joinAt: 16, first: 'Around the World' },
    { id: 'wren', noun: 960, tier: 'spotify', taste: 'CCB', joinAt: 21, first: 'Can’t Do Without You' },
    { id: 'ox', noun: 555, tier: 'mic', taste: 'B', joinAt: 26, first: 'Psycho Killer' },
    { id: 'tamsin', noun: 319, tier: 'tapped', taste: 'D', joinAt: 33, first: 'Journey in Satchidananda' },
    { id: 'pico', noun: 1044, tier: 'spotify', taste: 'EEA', joinAt: 48, first: 'Brown Paper Bag' },
    { id: 'dell', noun: 640, tier: 'silent', taste: '', joinAt: 40 },
    { id: 'frog', noun: 779, tier: 'agent', taste: '', joinAt: 10 },
    { id: 'sol', noun: 1199, tier: 'agent', taste: '', joinAt: 30 },
  ];

  function mountParty() {
    const root = document.querySelector<HTMLElement>('[data-party]'); if (!root || root.dataset.mounted) return; root.dataset.mounted = 'true';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    let seed = 20260921; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const byTitle = (t: string) => CATALOG.find((x) => x.t === t)!;
    const hears = (p: Person) => p.here && !!p.track && p.tier !== 'silent' && p.tier !== 'agent';
    const named = (p: Person) => p.tier === 'spotify' || p.tier === 'pasted';
    const ratio = (a: number, b: number) => { const r = Math.max(a, b) / Math.min(a, b); return [1, 2, 1.5].find((k) => Math.abs(r - k) / k < 0.028) ?? 0; };
    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    let people: Person[] = [], now = 0, speed = 4, paused = false, tape: { who: string; tr: Track; at: number }[] = [], seenMoments = new Set<string>(), lastAgent = 0;
    const feed = $('[data-feed]'), moments = $('[data-moments]');

    function say(kind: string, who: Person | null, text: string) {
      const li = el('li'); li.dataset.kind = kind;
      if (who) { const i = el('img'); i.src = `https://noun.pics/${who.noun}.svg`; i.alt = ''; i.width = 24; i.height = 24; li.append(i); } else li.append(el('i', 'pty-feed__dot'));
      const b = el('p'); if (who) { b.append(el('b', '', who.id)); if (who.tier === 'agent') b.append(el('em', '', 'AI')); b.append(' '); } b.append(text); li.append(b, el('time', '', clock(now)));
      feed.prepend(li); while (feed.children.length > 60) feed.lastElementChild!.remove();
    }
    function moment(key: string, title: string, body: string, action: string) {
      if (seenMoments.has(key)) return; seenMoments.add(key);
      moments.querySelector('.pty-empty')?.remove();
      const li = el('li'); li.append(el('b', '', title), el('p', '', body)); const btn = el('button', '', action); btn.type = 'button';
      btn.addEventListener('click', () => { btn.disabled = true; btn.textContent = 'done · in the demo'; say('wave', null, `${action.replace(/ →$/, '')}.`); }); li.append(btn, el('time', '', clock(now)));
      moments.prepend(li); while (moments.children.length > 7) moments.lastElementChild!.remove();
    }

    function pick(p: Person): Track {
      // A quarter of the time, borrow an artist someone else has on: rooms drift together.
      const others = people.filter((o) => o !== p && hears(o) && named(o));
      if (others.length && rnd() < 0.22) { const o = others[Math.floor(rnd() * others.length)], same = CATALOG.filter((x) => x.a === o.track!.a && x.t !== p.track?.t && x.t !== o.track!.t); if (same.length) { /* a different record by their artist, never a copy of what they have on */ const tr = same[Math.floor(rnd() * same.length)]; if (named(p)) say('drift', p, `borrowed ${o.id}’s artist: ${tr.a}.`); return tr; } }
      const c = p.taste[Math.floor(rnd() * p.taste.length)] || 'A', pool = CATALOG.filter((x) => x.c === c && x.t !== p.track?.t);
      return pool[Math.floor(rnd() * pool.length)];
    }
    function play(p: Person, tr: Track) {
      p.track = tr; p.bpm = tr.bpm; p.phase = now; p.ends = now + 55 + Math.floor(rnd() * 70);
      if (p.tier === 'pasted') p.ends = now + 260; // a pasted link just sits there
      if (named(p)) { tape.push({ who: p.id, tr, at: now }); say('track', p, `♫ ${tr.t} — ${tr.a} (${tr.y})`); paintTape(); }
      else if (p.tier === 'mic') say('track', p, `the wall hears about ${tr.bpm} BPM. No title: the mic only knows tempo.`);
      else if (p.tier === 'tapped') say('track', p, `tapped ${tr.bpm} BPM.`);
    }

    function reset() {
      seed = 20260921; now = 0; tape = []; seenMoments = new Set(); lastAgent = 0; feed.replaceChildren(); moments.replaceChildren(el('li', 'pty-empty', 'The room is filling up…'));
      people = CAST.map((c) => ({ ...c, ends: 0, bpm: 0, phase: 0, here: false, hit: 0 })); paintCast(); paintTape(); placePeople(); paintStats();
    }

    // ── one simulated second ──
    function tick() {
      now += 1;
      for (const p of people) {
        if (!p.here && now >= p.joinAt) { p.here = true; say('join', p, p.tier === 'agent' ? 'arrived over MCP and is reading the room.' : `walked in. ${TIERS[p.tier].label}.`); if (p.first) play(p, byTitle(p.first)); placePeople(); }
        else if (p.here && p.track && now >= p.ends && p.tier !== 'agent') play(p, pick(p));
        if (p.here && p.tier !== 'agent' && rnd() < 0.012) { p.hit = now; say('drum', p, ['hit Root.', 'hit Bloom twice.', 'is on the pads.', 'hit Thorn on the off-beat.'][Math.floor(rnd() * 4)]); }
      }
      if (now === 58) { const a = people.find((p) => p.id === 'juniper')!, b = people.find((p) => p.id === 'wren')!; if (a.here && b.here) { play(a, byTitle('Let It Happen')); now += 0; play(b, byTitle('Let It Happen')); } }
      notice(); agents(); paintStats(); paintCast();
      $('[data-clock]').textContent = clock(now);
    }

    // ── what a room can notice that one listener cannot ──
    function notice() {
      const L = people.filter(hears), N = L.filter(named);
      for (let i = 0; i < N.length; i++) for (let j = i + 1; j < N.length; j++) {
        const a = N[i], b = N[j];
        if (a.track!.t === b.track!.t) moment(`same:${a.track!.t}`, 'Same song, two players', `${a.id} and ${b.id} are both on “${a.track!.t}”, started seconds apart. Neither of them knows.`, 'Tell them both →');
        else if (a.track!.a === b.track!.a) moment(`artist:${a.track!.a}:${Math.floor(now / 120)}`, `Two people on ${a.track!.a}`, `${a.id} has “${a.track!.t}”, ${b.id} has “${b.track!.t}”. Same artist, different rooms of it.`, `Wave them together →`);
      }
      const pocket = L.filter((p) => Math.abs(p.bpm - 122) <= 3);
      if (pocket.length >= 3) moment(`pocket:${pocket.length >= 5 ? 'big' : 'small'}:${Math.floor(now / 150)}`, `${pocket.length} people in the same pocket`, `${pocket.map((p) => p.id).join(', ')} are all within 3 BPM of 122, on ${new Set(pocket.map((p) => p.track!.a)).size} different artists. Nobody needs the same song to drum together.`, 'Start a drum circle at 122 →');
      if (L.length >= 6) {
        const dec = new Map<number, number>(); L.forEach((p) => dec.set(Math.floor(p.track!.y / 10) * 10, (dec.get(Math.floor(p.track!.y / 10) * 10) ?? 0) + 1));
        const [d, n] = [...dec.entries()].sort((x, y) => y[1] - x[1])[0]; if (n / L.length >= 0.5) moment(`era:${d}:${n}`, `The room is in the ${d}s`, `${n} of ${L.length} players are on records from the ${d}s right now.`, `Pin “${d}s hour” to the door →`);
        const fast = L.filter((p) => p.bpm >= 160), rest = L.filter((p) => p.bpm < 130);
        if (fast.length === 1 && rest.length >= 5) moment(`outlier:${fast[0].id}`, 'One person is somewhere else entirely', `Everyone is under 130 BPM except ${fast[0].id} at ${fast[0].bpm}. Half-time, it lands right on ${Math.round(fast[0].bpm / 2)}: inside the room after all.`, 'Show them the half-time lock →');
      }
    }

    // ── the two agents: readers, not DJs ──
    function agents() {
      if (now - lastAgent < 22) return; const frog = people.find((p) => p.id === 'frog')!, sol = people.find((p) => p.id === 'sol')!; const N = people.filter((p) => hears(p) && named(p));
      if (frog.here && N.length >= 2 && rnd() < 0.5) {
        const a = N[Math.floor(rnd() * N.length)], rest = N.filter((x) => x !== a && x.track!.a !== a.track!.a), b = rest.sort((x, y) => Math.abs(y.bpm - a.bpm) - Math.abs(x.bpm - a.bpm))[Math.floor(rnd() * Math.min(3, rest.length))]; if (!b) return; /* bridge the people furthest apart */
        const ya = a.track!.y, yb = b.track!.y, bridge = CATALOG.filter((x) => x.a !== a.track!.a && x.a !== b.track!.a).sort((x, y) => Math.abs(x.bpm - (a.bpm + b.bpm) / 2) + Math.abs(x.y - (ya + yb) / 2) / 3 - (Math.abs(y.bpm - (a.bpm + b.bpm) / 2) + Math.abs(y.y - (ya + yb) / 2) / 3))[0];
        const bk = `bridge:${[a.id, b.id].sort().join('+')}:${bridge.t}`; if (seenMoments.has(bk)) return; seenMoments.add(bk);
        say('agent', frog, `bridge between ${a.id} (${a.track!.a}, ${a.bpm}) and ${b.id} (${b.track!.a}, ${b.bpm}): “${bridge.t}” by ${bridge.a}. It sits between them in tempo (${bridge.bpm}) and in years (${bridge.y}).`); lastAgent = now; return;
      }
      if (sol.here && tape.length >= 6) {
        const count = new Map<string, number>(); tape.forEach((x) => count.set(x.tr.a, (count.get(x.tr.a) ?? 0) + 1)); const [artist, n] = [...count.entries()].sort((x, y) => y[1] - x[1])[0];
        if (n >= 2 && !seenMoments.has(`req:${artist}`)) { seenMoments.add(`req:${artist}`); const tr = CATALOG.find((x) => x.a === artist)!; say('agent', sol, `filed “${tr.t}” on the station’s request line: ${artist} has come up ${n} times in this room tonight, from ${new Set(tape.filter((x) => x.tr.a === artist).map((x) => x.who)).size} different people.`); lastAgent = now; }
      }
    }

    // ── painting ──
    const stage = $('[data-stage]'), peopleBox = $('[data-people]'), floor = $<HTMLCanvasElement>('[data-floor]'), wall = $<HTMLCanvasElement>('[data-wall]');
    const pos = new Map<string, { x: number; y: number }>();
    function placePeople() {
      const here = people.filter((p) => p.here), w = stage.clientWidth || 600, h = stage.clientHeight || 420, R = Math.min(w, h) * 0.38;
      here.forEach((p, i) => { const a = (i / Math.max(1, here.length)) * Math.PI * 2 - Math.PI / 2; pos.set(p.id, { x: w / 2 + Math.cos(a) * R * (w > h ? 1.25 : 1), y: h / 2 + Math.sin(a) * R }); });
      peopleBox.replaceChildren(...here.map((p) => {
        const d = el('div', 'pty-person'); d.dataset.id = p.id; d.dataset.tier = p.tier; const at = pos.get(p.id)!; d.style.left = `${at.x}px`; d.style.top = `${at.y}px`;
        const i = el('img'); i.src = `https://noun.pics/${p.noun}.svg`; i.alt = ''; i.width = 46; i.height = 46; d.append(i, el('b', '', p.id), el('small', '', '')); return d;
      }));
    }
    function paintStats() {
      const L = people.filter(hears), here = people.filter((p) => p.here), bpms = L.map((p) => p.bpm).sort((a, b) => a - b), med = bpms.length ? bpms[Math.floor(bpms.length / 2)] : 0;
      $('[data-room-bpm]').textContent = med ? String(med) : '—'; stage.style.setProperty('--beat', med ? `${(60 / med).toFixed(3)}s` : '0s');
      const artists = new Map<string, number>(); L.filter(named).forEach((p) => artists.set(p.track!.a, (artists.get(p.track!.a) ?? 0) + 1)); const shared = [...artists.entries()].filter((x) => x[1] > 1).sort((x, y) => y[1] - x[1])[0];
      let locks = 0; for (let i = 0; i < L.length; i++) for (let j = i + 1; j < L.length; j++) if (ratio(L[i].bpm, L[j].bpm)) locks++;
