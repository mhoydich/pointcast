---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Clap — call and response rhythm trainer" description="The computer claps a pattern. You clap it back. See how close you got. Sixteen hand-built patterns at three difficulty levels plus generated patterns, all in the browser, no signup.">
  <main class="cl" id="cl" data-built={built}>
    <header class="cl__hero">
      <p class="cl__kicker">CAST · CLAP · call · response · rhythm trainer</p>
      <h1 class="cl__title">Clap.</h1>
      <p class="cl__sub">Computer plays a pattern. You clap it back. The page measures how close you got — overall, and beat-by-beat — and shows you which hits were early, late, or right on.</p>
    </header>

    <section class="cl__panel">
      <div class="cl__panel-block">
        <p class="cl__panel-label">DIFFICULTY</p>
        <div class="cl__pills" id="cl-diff-pills">
          <button class="cl__pill cl__pill--active" data-diff="easy">easy · 4 hits</button>
          <button class="cl__pill" data-diff="med">medium · 6 hits</button>
          <button class="cl__pill" data-diff="hard">hard · 8 hits</button>
          <button class="cl__pill" data-diff="gen">generate</button>
        </div>
      </div>
      <div class="cl__panel-block">
        <p class="cl__panel-label">TEMPO <span class="cl__panel-val" id="cl-tempo-val">100</span> BPM</p>
        <input type="range" class="cl__tempo-slider" id="cl-tempo" min="60" max="160" value="100"/>
      </div>
    </section>

    <section class="cl__stage" data-phase="idle" id="cl-stage">
      <div class="cl__phase-ring">
        <div class="cl__phase" id="cl-phase">READY</div>
        <div class="cl__phase-sub" id="cl-phase-sub">Press Play to hear the pattern.</div>
      </div>

      <div class="cl__pattern-row" id="cl-pattern-row"></div>

      <div class="cl__big-tap-wrap">
        <button class="cl__big-tap" id="cl-tap" aria-label="Tap to match">
          <span id="cl-tap-icon">●</span>
        </button>
        <p class="cl__tap-hint">Tap the circle, click anywhere, or press <kbd>Space</kbd>. Your hits appear below.</p>
      </div>

      <div class="cl__user-row" id="cl-user-row"></div>
    </section>

    <section class="cl__transport">
      <button class="cl__play" id="cl-play" type="button">
        <span class="cl__play-icon" id="cl-play-icon">▶</span>
        <span class="cl__play-label" id="cl-play-label">PLAY PATTERN</span>
      </button>
      <button class="cl__next" id="cl-next" type="button">NEXT PATTERN</button>
      <button class="cl__retry" id="cl-retry" type="button" disabled>RETRY</button>
    </section>

    <section class="cl__scoreboard">
      <div class="cl__score">
        <span class="cl__score-label">LAST</span>
        <span class="cl__score-val" id="cl-score-last">—</span>
      </div>
      <div class="cl__score">
        <span class="cl__score-label">BEST</span>
        <span class="cl__score-val" id="cl-score-best">—</span>
      </div>
      <div class="cl__score">
        <span class="cl__score-label">STREAK</span>
        <span class="cl__score-val" id="cl-score-streak">0</span>
        <span class="cl__score-sub">≥80 in a row</span>
      </div>
    </section>

    <section class="cl__notes">
      <h2 class="cl__notes-h">How scoring works</h2>
      <p>Each pattern is a list of hits expressed in beats (a beat = a quarter note at the chosen tempo). The computer plays a 1-beat count-in, then the pattern.</p>
      <p>When it's your turn, every tap is timestamped. We line your hits up against the expected hits in order. The score is <strong>100 − (mean error in beats × 100)</strong>, clamped to 0. A 100 means every tap was within 1% of a beat of the expected time. Hits you miss entirely subtract 15 points each.</p>
      <p>The dots below show beat-by-beat accuracy: <span class="cl__legend cl__legend--ok">●</span> within ±5% · <span class="cl__legend cl__legend--early">●</span> early · <span class="cl__legend cl__legend--late">●</span> late · <span class="cl__legend cl__legend--miss">●</span> missing entirely.</p>
      <p>Pair with <a href="/cast-metronome">/cast-metronome</a> for steady time, <a href="/cast-along">/cast-along</a> for free-time tap-along, <a href="/cast-pulse">/cast-pulse</a> to compose your own patterns, <a href="/cast-bell">/cast-bell</a> for the strike sound.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cl-ink: #0c0816;
      --cl-walnut: #4a2a1a;
      --cl-flame: #f6c15e;
      --cl-flame-deep: #d68f2c;
      --cl-cream: #f4e7c8;
      --cl-cream-dim: #c8b48a;
      --cl-cream-dimmer: #8b7a5a;
      --cl-mint: #9bd7b8;
      --cl-rose: #e6788c;
      --cl-mauve: #b39ddb;
    }

    body:has(.cl) {
      background: radial-gradient(circle at 50% 0%, #281530 0%, var(--cl-ink) 60%);
      color: var(--cl-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cl { max-width: 900px; margin: 0 auto; padding: 48px 24px 80px; }

    .cl__hero { text-align: center; margin-bottom: 32px; }
    .cl__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cl-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cl__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 132px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cl-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .cl__sub {
      max-width: 640px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cl-cream-dim);
    }

    /* PANEL */
    .cl__panel {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 14px;
      margin-bottom: 24px;
    }
    @media (max-width: 700px) { .cl__panel { grid-template-columns: 1fr; } }
    .cl__panel-block {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 14px;
      padding: 14px 18px;
    }
    .cl__panel-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; letter-spacing: 0.16em;
      color: var(--cl-cream-dimmer);
      margin: 0 0 10px;
    }
    .cl__panel-val {
      color: var(--cl-flame);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 18px;
      margin-left: 6px;
    }
    .cl__pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .cl__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cl-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cl__pill:hover { background: rgba(246,193,94,0.10); }
    .cl__pill--active {
      background: var(--cl-flame);
      color: var(--cl-walnut);
      border-color: var(--cl-flame);
    }
    .cl__tempo-slider { width: 100%; accent-color: var(--cl-flame); }

    /* STAGE */
    .cl__stage {
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 20px;
      padding: 28px 24px;
      margin-bottom: 22px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .cl__phase-ring {
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .cl__phase {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: 32px;
      letter-spacing: -0.01em;
      color: var(--cl-flame);
    }
    .cl__phase-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--cl-cream-dim);
    }
    .cl__stage[data-phase="playing"] .cl__phase { color: var(--cl-mauve); }
    .cl__stage[data-phase="repeat"] .cl__phase { color: var(--cl-flame); animation: clPulse 0.6s ease-in-out infinite alternate; }
    .cl__stage[data-phase="done"] .cl__phase { color: var(--cl-mint); }
    @keyframes clPulse {
      from { opacity: 0.55; }
      to { opacity: 1; }
    }

    .cl__pattern-row, .cl__user-row {
      display: flex;
      gap: 6px;
      flex-wrap: nowrap;
      justify-content: center;
      min-height: 24px;
      align-items: center;
    }
    .cl__dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(244,231,200,0.14);
      border: 2px solid rgba(244,231,200,0.22);
      transition: background 80ms ease, transform 100ms ease, border 100ms ease;
    }
    .cl__dot--playing {
      background: var(--cl-flame);
      border-color: var(--cl-flame);
      transform: scale(1.25);
    }
    .cl__dot--expected {
      background: rgba(179,157,219,0.3);
      border-color: rgba(179,157,219,0.5);
    }
    .cl__dot--ok    { background: var(--cl-mint); border-color: var(--cl-mint); }
    .cl__dot--early { background: var(--cl-mauve); border-color: var(--cl-mauve); }
    .cl__dot--late  { background: var(--cl-rose); border-color: var(--cl-rose); }
    .cl__dot--miss  { background: rgba(230,120,140,0.18); border-color: var(--cl-rose); }

    .cl__big-tap-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: 8px 0;
    }
    .cl__big-tap {
      width: clamp(120px, 26vw, 180px);
      height: clamp(120px, 26vw, 180px);
      border-radius: 50%;
      border: 0;
      background: var(--cl-flame);
      color: var(--cl-walnut);
      font-size: 40px;
      cursor: pointer;
      box-shadow: 0 8px 28px rgba(246,193,94,0.28);
      transition: transform 60ms ease;
    }
    .cl__big-tap:hover { transform: scale(1.03); }
    .cl__big-tap:active { transform: scale(0.94); }
    .cl__big-tap:disabled {
      background: rgba(246,193,94,0.18);
      color: rgba(244,231,200,0.4);
      box-shadow: none;
      cursor: not-allowed;
    }
    .cl__big-tap--flash {
      transform: scale(0.92);
      box-shadow: 0 0 60px rgba(246,193,94,0.6);
    }
    .cl__tap-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cl-cream-dimmer);
      margin: 0;
      text-align: center;
    }
    .cl__tap-hint kbd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 2px 5px;
      border-radius: 3px;
      border: 1px solid rgba(244,231,200,0.3);
      background: rgba(244,231,200,0.06);
    }

    /* TRANSPORT */
    .cl__transport {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 22px;
    }
    .cl__play {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 22px;
      border-radius: 12px;
      border: 0;
      background: var(--cl-flame);
      color: var(--cl-walnut);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      box-shadow: 0 4px 14px rgba(246,193,94,0.32);
    }
    .cl__play:hover { background: var(--cl-flame-deep); }
    .cl__play:disabled { opacity: 0.5; cursor: not-allowed; }
    .cl__play-icon { font-size: 12px; }
    .cl__next, .cl__retry {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--cl-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cl__next:hover, .cl__retry:hover:not(:disabled) { background: rgba(246,193,94,0.12); }
    .cl__retry:disabled { opacity: 0.4; cursor: not-allowed; }

    /* SCOREBOARD */
    .cl__scoreboard {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 28px;
    }
    @media (max-width: 600px) { .cl__scoreboard { grid-template-columns: 1fr; } }
    .cl__score {
      background: rgba(0,0,0,0.26);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 14px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .cl__score-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--cl-cream-dimmer);
    }
    .cl__score-val {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 30px;
      color: var(--cl-flame);
      line-height: 1;
    }
    .cl__score-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--cl-cream-dimmer);
    }

    /* NOTES */
    .cl__notes {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cl__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cl-cream);
      margin: 0 0 12px;
    }
    .cl__notes p {
      font-size: 15px; line-height: 1.6;
      color: var(--cl-cream-dim);
      margin: 0 0 12px;
    }
    .cl__notes strong { color: var(--cl-cream); }
    .cl__notes a { color: var(--cl-flame); text-decoration: none; }
    .cl__notes a:hover { text-decoration: underline; }
    .cl__legend {
      display: inline-block;
      font-size: 14px;
      vertical-align: middle;
      line-height: 1;
    }
    .cl__legend--ok    { color: var(--cl-mint); }
    .cl__legend--early { color: var(--cl-mauve); }
    .cl__legend--late  { color: var(--cl-rose); }
    .cl__legend--miss  { color: rgba(230,120,140,0.5); }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Difficulty = 'easy' | 'med' | 'hard' | 'gen';

    // Patterns expressed as gap-from-previous in beats. Length = number of hits.
    // Onset times derived by cumulative sum. Total duration = sum + final note tail.
    // Total beat span typically 4 (one bar of 4/4) for easy/med, up to 6 for hard.
    const EASY: number[][] = [
      [0, 1, 1, 1],            // quarters on 1,2,3,4
      [0, 1, 0.5, 1.5],        // syncopated
      [0, 0.75, 0.75, 1.5],    // delayed downbeats
      [0, 1.5, 0.5, 1],        // half + eighth + quarter
      [0, 2, 1, 1],            // half rest first, then 2,3,4
    ];
    const MED: number[][] = [
      [0, 0.5, 0.5, 1, 0.5, 1.5],         // bossa-like
      [0, 1, 0.5, 0.5, 1, 1],             // straight + 8ths
      [0, 0.75, 0.75, 0.5, 1, 1],          // displaced
      [0, 0.5, 1.5, 0.5, 0.5, 1],          // syncopated open
      [0, 1, 1, 0.5, 0.5, 1],             // long-short-short
      [0, 0.25, 0.75, 1, 1, 1],            // grace + straight
    ];
    const HARD: number[][] = [
      [0, 0.5, 0.5, 0.25, 0.25, 0.5, 1, 1],
      [0, 0.75, 0.25, 0.5, 0.5, 1, 0.5, 1.5],
      [0, 0.25, 0.5, 0.75, 0.5, 0.5, 1.5, 1],
      [0, 1, 0.5, 0.25, 0.25, 0.5, 1, 1.5],
      [0, 0.5, 0.5, 0.5, 1.5, 0.5, 0.5, 1],
    ];

    let currentBank: number[][] = EASY;
    let difficulty: Difficulty = 'easy';
    let patternIndex = 0;
    let pattern: number[] = EASY[0];
    let tempo = 100;
    let lastScore: number | null = null;
    let bestScore: number | null = null;
    let streak = 0;

    let phase: 'idle' | 'count' | 'playing' | 'repeat' | 'done' = 'idle';
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let userHits: number[] = [];          // beats from "your turn" start
    let userTurnStartMs = 0;
    let playStartMs = 0;
    let timers: number[] = [];

    const STORAGE_BEST = 'pc-cl-best-v1';
    const STORAGE_STREAK = 'pc-cl-streak-v1';

    // ---- audio ----
    function beatSec() { return 60 / tempo; }

    function clickSound(t: number, accent = false) {
      if (!ctx || !scheduler) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'square';
      osc.frequency.value = accent ? 2400 : 1500;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(accent ? 0.38 : 0.24, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      osc.connect(g).connect(ctx.destination);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.08);
    }

    function patternHit(t: number) {
      if (!ctx || !scheduler) return;
      // a softer wood-tap-ish hit so it's distinguishable from the count-in
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, t);
      osc.frequency.exponentialRampToValueAtTime(400, t + 0.04);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.32, t + 0.003);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
      osc.connect(g).connect(ctx.destination);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.1);
    }

    // ---- pattern generation (for "gen" mode) ----
    function generatePattern(beats: number, hits: number): number[] {
      // distribute `hits` events across `beats` beats. First gap is 0 (downbeat).
      const points = new Set<number>([0]);
      const grid = beats * 4; // 16th-note grid
      const maxAttempts = 50;
      let attempts = 0;
      while (points.size < hits && attempts < maxAttempts) {
        const slot = Math.floor(Math.random() * (grid - 1)) + 1;
        const t = slot / 4;
        if (![...points].some(p => Math.abs(p - t) < 0.2)) {
          points.add(t);
        }
        attempts++;
      }
      const sorted = [...points].sort((a, b) => a - b);
      // Convert absolute times to inter-onset gaps
      const gaps: number[] = [];
      let prev = 0;
      for (const t of sorted) {
        gaps.push(t - prev);
        prev = t;
      }
      return gaps;
    }

    function loadPattern() {
      if (difficulty === 'gen') {
        const hits = 4 + Math.floor(Math.random() * 4); // 4-7 hits
        pattern = generatePattern(4, hits);
        return;
      }
      const bank = currentBank;
      patternIndex = (patternIndex + 1) % bank.length;
      pattern = bank[patternIndex];
    }

    // ---- transport ----
    function clearTimers() {
      for (const id of timers) clearTimeout(id);
      timers = [];
    }

    function renderPatternRow(asPlaybackTarget = false) {
      const row = document.getElementById('cl-pattern-row')!;
      row.innerHTML = pattern.map((_, i) =>
        `<div class="cl__dot${asPlaybackTarget ? ' cl__dot--expected' : ''}" data-i="${i}"></div>`
      ).join('');
    }

    function renderUserRow() {
      const row = document.getElementById('cl-user-row')!;
      // we render dots equal to pattern length initially; mark them as miss until filled
      row.innerHTML = pattern.map((_, i) =>
        `<div class="cl__dot cl__dot--miss" data-i="${i}"></div>`
      ).join('');
    }

    function setPhase(p: typeof phase, mainText: string, subText: string) {
      phase = p;
      document.getElementById('cl-stage')!.setAttribute('data-phase', p);
      document.getElementById('cl-phase')!.textContent = mainText;
      document.getElementById('cl-phase-sub')!.textContent = subText;
    }

    function startRound() {
      if (!ctx) {
        ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
        scheduler = createAudioScheduler(ctx);
      }
      if (ctx.state === 'suspended') ctx.resume();

      clearTimers();
      userHits = [];
      renderPatternRow();
      // user row reset to misses
      renderUserRow();

      setPhase('count', 'COUNT IN', '1 · 2 · 3 · 4');
      (document.getElementById('cl-play') as HTMLButtonElement).disabled = true;
      (document.getElementById('cl-retry') as HTMLButtonElement).disabled = true;
      (document.getElementById('cl-tap') as HTMLButtonElement).disabled = true;

      // Schedule count-in (4 beats), then play pattern, then user turn.
      const bs = beatSec();
      const t0 = ctx.currentTime + 0.3;
      for (let i = 0; i < 4; i++) {
        clickSound(t0 + i * bs, i === 0);
        timers.push(window.setTimeout(() => {
          document.getElementById('cl-phase-sub')!.textContent = `${i+1} · ${i+2 <= 4 ? i+2 : '...'}`;
        }, (t0 + i * bs - ctx.currentTime) * 1000));
      }

      // Play pattern starting at beat 4 (one bar after count-in start)
      const patternStartCtx = t0 + 4 * bs;
      let cum = 0;
      const dots = [...document.querySelectorAll('.cl__pattern-row .cl__dot')] as HTMLElement[];
      pattern.forEach((gap, i) => {
        cum += gap;
        const hitAt = patternStartCtx + cum * bs;
        patternHit(hitAt);
        timers.push(window.setTimeout(() => {
          dots[i]?.classList.add('cl__dot--playing');
          setTimeout(() => dots[i]?.classList.remove('cl__dot--playing'), 200);
        }, (hitAt - ctx!.currentTime) * 1000));
      });

      // Phase transition to "playing"
      timers.push(window.setTimeout(() => {
        setPhase('playing', 'LISTEN', `pattern at ${tempo} BPM`);
      }, (patternStartCtx - ctx.currentTime) * 1000));

      // After pattern ends + 0.5 beat buffer, switch to "repeat"
      const patternEndCtx = patternStartCtx + cum * bs;
      const repeatStartCtx = patternEndCtx + bs * 0.8;
      timers.push(window.setTimeout(() => {
        beginUserTurn();
      }, (repeatStartCtx - ctx!.currentTime) * 1000));
    }

    function beginUserTurn() {
      if (!ctx) return;
      setPhase('repeat', 'YOUR TURN', 'Clap the pattern back. The count-in plays again.');
      (document.getElementById('cl-tap') as HTMLButtonElement).disabled = false;
      // play a count-in for user
      const bs = beatSec();
      const t0 = ctx.currentTime + 0.05;
      for (let i = 0; i < 4; i++) {
        clickSound(t0 + i * bs, i === 0);
      }
      userTurnStartMs = (t0 + 4 * bs - ctx.currentTime) * 1000 + performance.now();

      // total expected duration of user pattern + tail
      const cum = pattern.reduce((a, b) => a + b, 0);
      const tailBeats = 1.5; // wait this long after expected last hit before scoring
      const endMs = userTurnStartMs + (cum + tailBeats) * bs * 1000;
      timers.push(window.setTimeout(() => endUserTurn(), endMs - performance.now()));
    }

    function recordUserTap() {
      if (phase !== 'repeat' || !ctx) return;
      const now = performance.now();
      const beats = (now - userTurnStartMs) / (beatSec() * 1000);
      if (beats < -0.3) return; // before count-in finishes
      userHits.push(beats);
      // flash the tap button
      const btn = document.getElementById('cl-tap')!;
      btn.classList.add('cl__big-tap--flash');
      setTimeout(() => btn.classList.remove('cl__big-tap--flash'), 100);
      // play a quick echo so the user hears their hit
      patternHit(ctx.currentTime + 0.005);
    }

    function endUserTurn() {
      (document.getElementById('cl-tap') as HTMLButtonElement).disabled = true;
      // Score
      const expected: number[] = [];
      let cum = 0;
      for (const gap of pattern) { cum += gap; expected.push(cum); }

      // align user hits to expected hits one-to-one (greedy nearest-neighbor)
      const remaining = [...userHits];
      const assignments: ({ user: number; err: number } | null)[] = expected.map(() => null);
      for (let i = 0; i < expected.length; i++) {
        if (remaining.length === 0) break;
        // pick the closest remaining hit to expected[i]
        let bestIdx = -1;
        let bestErr = Infinity;
        for (let j = 0; j < remaining.length; j++) {
          const err = Math.abs(remaining[j] - expected[i]);
          if (err < bestErr) { bestErr = err; bestIdx = j; }
        }
        if (bestErr < 0.6) {  // generous window: within 0.6 of a beat
          assignments[i] = { user: remaining[bestIdx], err: remaining[bestIdx] - expected[i] };
          remaining.splice(bestIdx, 1);
        }
      }

      let totalErr = 0;
      let missed = 0;
      const dots = [...document.querySelectorAll('.cl__user-row .cl__dot')] as HTMLElement[];
      assignments.forEach((a, i) => {
        const dot = dots[i];
        if (!dot) return;
        dot.classList.remove('cl__dot--ok','cl__dot--early','cl__dot--late','cl__dot--miss');
        if (a == null) {
          dot.classList.add('cl__dot--miss');
          missed++;
        } else {
          const absErr = Math.abs(a.err);
          totalErr += absErr;
          if (absErr < 0.05) dot.classList.add('cl__dot--ok');
          else if (a.err < 0) dot.classList.add('cl__dot--early');
          else dot.classList.add('cl__dot--late');
        }
      });

      const meanErr = assignments.length ? totalErr / assignments.length : 0;
      const baseScore = 100 - meanErr * 100;
      const score = Math.max(0, Math.round(baseScore - missed * 15));
      lastScore = score;
      if (bestScore == null || score > bestScore) bestScore = score;
      if (score >= 80) streak++;
      else streak = 0;

      try {
        localStorage.setItem(STORAGE_BEST, String(bestScore));
        localStorage.setItem(STORAGE_STREAK, String(streak));
      } catch {}

      document.getElementById('cl-score-last')!.textContent = String(score);
      document.getElementById('cl-score-best')!.textContent = bestScore == null ? '—' : String(bestScore);
      document.getElementById('cl-score-streak')!.textContent = String(streak);

      setPhase('done', `${score}`, score >= 95 ? 'tight' : score >= 80 ? 'solid' : score >= 60 ? 'close' : 'try again');
      (document.getElementById('cl-play') as HTMLButtonElement).disabled = false;
      (document.getElementById('cl-retry') as HTMLButtonElement).disabled = false;
    }

    function init() {
      // restore best + streak
      try {
        const b = parseInt(localStorage.getItem(STORAGE_BEST) || '');
        if (!Number.isNaN(b)) bestScore = b;
        const s = parseInt(localStorage.getItem(STORAGE_STREAK) || '');
        if (!Number.isNaN(s)) streak = s;
      } catch {}
      document.getElementById('cl-score-best')!.textContent = bestScore == null ? '—' : String(bestScore);
      document.getElementById('cl-score-streak')!.textContent = String(streak);

      // initial pattern row
      patternIndex = -1;
      loadPattern();
      renderPatternRow();
      renderUserRow();

      // difficulty pills
      document.getElementById('cl-diff-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-diff]');
        if (!btn) return;
        difficulty = btn.getAttribute('data-diff') as Difficulty;
        document.querySelectorAll('.cl__pills .cl__pill').forEach(el => el.classList.toggle('cl__pill--active', el === btn));
        currentBank = difficulty === 'easy' ? EASY : difficulty === 'med' ? MED : difficulty === 'hard' ? HARD : EASY;
        patternIndex = -1;
        loadPattern();
        renderPatternRow();
        renderUserRow();
        setPhase('idle', 'READY', 'Press Play to hear the pattern.');
      });

      // tempo
      const tempoSlider = document.getElementById('cl-tempo') as HTMLInputElement;
      tempoSlider.addEventListener('input', () => {
        tempo = parseInt(tempoSlider.value);
        document.getElementById('cl-tempo-val')!.textContent = String(tempo);
      });

      // tap input — circle, page-wide, spacebar
      const tapBtn = document.getElementById('cl-tap')!;
      tapBtn.addEventListener('pointerdown', e => { e.preventDefault(); recordUserTap(); });
      document.addEventListener('pointerdown', e => {
        const t = e.target as HTMLElement;
        if (t.closest('button')) return;
        if (t.closest('input')) return;
        if (t.closest('a')) return;
        recordUserTap();
      });
      window.addEventListener('keydown', e => {
        if (e.code !== 'Space') return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        e.preventDefault();
        recordUserTap();
      });

      document.getElementById('cl-play')!.addEventListener('click', () => startRound());
      document.getElementById('cl-next')!.addEventListener('click', () => {
        loadPattern();
        renderPatternRow();
        renderUserRow();
        setPhase('idle', 'READY', 'Press Play to hear the new pattern.');
      });
      document.getElementById('cl-retry')!.addEventListener('click', () => startRound());

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          clearTimers();
          setPhase('idle', 'READY', 'Tab returned. Press Play to start.');
          (document.getElementById('cl-play') as HTMLButtonElement).disabled = false;
          (document.getElementById('cl-tap') as HTMLButtonElement).disabled = true;
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
