---
/**
 * /drum-catch — Beat Catcher. Coffee-bean notes rain down four columns,
 * spawned in time with a synthesized kick/hat groove. Slide your Noun
 * catcher left and right to gather them. A plain bean is +1; a gold
 * downbeat bean caught on the beat is +2 and the catcher glows. Miss a
 * bean and it hits the floor — three drops on the floor ends the run,
 * and a sixty-second clock ends it too. BPM and drop-rate ramp the
 * longer you last. Best score in localStorage, catches on the bus.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Beat Catcher · catch on the downbeat · PointCast';
const description = 'Coffee-bean notes rain down four columns in time with the beat. Slide your Noun to catch them — nail the downbeat for double. Three lives, sixty seconds, one best score.';
---
<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dct" id="dct">
    <header class="dct__hud">
      <div class="dct__hud-left">
        <img class="dct__noun" id="dct-noun" src="https://noun.pics/385.svg" alt="The conducting Noun" width="46" height="46" />
        <div class="dct__lives" id="dct-lives" aria-label="lives">
          <span class="dct__life"></span>
          <span class="dct__life"></span>
          <span class="dct__life"></span>
        </div>
      </div>
      <div class="dct__hud-mid">
        <span class="dct__judge" id="dct-judge"></span>
      </div>
      <div class="dct__hud-right">
        <span class="dct__points" id="dct-points">0</span>
        <span class="dct__meta"><span id="dct-time">60.0</span>s · <span id="dct-combo">0</span>×</span>
      </div>
    </header>

    <section class="dct__stage" id="dct-stage">
      <canvas class="dct__canvas" id="dct-canvas"></canvas>
      <div class="dct__overlay" id="dct-overlay">
        <img class="dct__overlay-noun" id="dct-overlay-noun" src="https://noun.pics/92.svg" alt="" width="88" height="88" />
        <h1 class="dct__title">BEAT CATCHER</h1>
        <p class="dct__sub">catch on the downbeat · ← → or A D · drag on touch</p>
        <p class="dct__best" id="dct-best-line">best — · gold beans score double</p>
        <button class="dct__go" id="dct-go" type="button">▶ DROP THE BEANS</button>
      </div>
    </section>

    <nav class="dct__siblings">
      <a href="/drum-hero">/drum-hero</a>
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-lockstep">/drum-lockstep</a>
      <a href="/drum">/drum</a>
    </nav>
  </main>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dct) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dct {
      max-width: 560px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 94vh;
    }

    /* HUD */
    .dct__hud {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      padding: 2px 6px;
      min-height: 48px;
      gap: 10px;
    }
    .dct__hud-left { display: flex; align-items: center; gap: 10px; }
    .dct__noun {
      width: 42px; height: 42px;
      image-rendering: pixelated;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }
    .dct--bob .dct__noun { animation: dctBob 0.2s ease; }
    @keyframes dctBob {
      0% { transform: translateY(0); }
      45% { transform: translateY(-5px) scale(1.04); }
      100% { transform: translateY(0); }
    }
    .dct__lives { display: flex; gap: 5px; }
    .dct__life {
      width: 13px; height: 13px;
      border-radius: 3px;
      background: #ff6b8a;
      box-shadow: 0 0 8px rgba(255,107,138,0.55);
      transition: background 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }
    .dct__life--lost { background: rgba(120,120,140,0.28); box-shadow: none; transform: scale(0.8); }

    .dct__judge {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .dct__judge--onbeat { color: #8aeac0; text-shadow: 0 0 12px rgba(138,234,192,0.7); }
    .dct__judge--catch { color: #7ac8ed; }
    .dct__judge--miss { color: #ff6b8a; }

    .dct__hud-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0; }
    .dct__points {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 26px;
      line-height: 1;
      color: #f6c15e;
      font-variant-numeric: tabular-nums;
    }
    .dct__meta { font-size: 11px; color: #8a8a9a; font-variant-numeric: tabular-nums; }

    /* STAGE */
    .dct__stage {
      position: relative;
      flex: 1;
      min-height: 440px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 78%, #1c0e2e 100%);
      touch-action: none;
      -webkit-tap-highlight-color: transparent;
    }
    .dct__stage--hurt { box-shadow: inset 0 0 0 3px rgba(255,107,138,0.65); }
    .dct__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    .dct__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(7,5,15,0.84);
      backdrop-filter: blur(3px);
      z-index: 3;
      text-align: center;
      padding: 20px;
    }
    .dct__overlay--hidden { display: none; }
    .dct__overlay-noun {
      width: 84px; height: 84px;
      image-rendering: pixelated;
      margin-bottom: 4px;
      filter: drop-shadow(0 8px 18px rgba(0,0,0,0.6));
    }
    .dct__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(28px, 7.5vw, 48px);
      letter-spacing: 0.18em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dct__sub, .dct__best {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
      max-width: 340px;
      line-height: 1.6;
    }
    .dct__best { color: #d4a437; }
    .dct__go {
      margin-top: 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dct__go:hover { transform: translateY(-1px); background: #ffd98a; }

    .dct__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dct__siblings a { color: #d4a437; text-decoration: none; }
    .dct__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .dct__stage { min-height: 400px; }
      .dct__points { font-size: 22px; }
    }
  </style>

  <script>
    // Four columns → G3 C4 E4 A4, one pluck per column. Gold "downbeat"
    // beans spawn on the quarter-beat; plain beans on the off-beat "and".
    const COLS = 4;
    const COL_COLORS = ['#ff6b8a', '#f6c15e', '#8aeac0', '#7ac8ed'];
    const COL_FREQS = [196.0, 261.63, 329.63, 440.0]; // G3 C4 E4 A4
    const RUN_MS = 60_000;
    const START_LIVES = 3;
    const FALL_EIGHTHS = 6;      // a bean falls for six eighth-notes
    const BPM_START = 96;
    const BPM_END = 152;
    const CATCH_Y_FRAC = 0.82;
    const PADDLE_SPEED = 940;    // px/sec for keyboard steering
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];

    type Bean = { col: number; spawnT: number; fallMs: number; onBeat: boolean; resolved: boolean };
    type Burst = { x: number; y: number; born: number; color: string; ring: number };

    let beans: Bean[] = [];
    let bursts: Burst[] = [];
    let running = false;
    let startAt = 0;
    let lastFrame = 0;
    let score = 0;
    let combo = 0;
    let maxCombo = 0;
    let lives = START_LIVES;
    let caught = 0;
    let onBeatCatches = 0;
    let rafId = 0;
    let SESSION_ID = '';

    let songEighth = 0;
    let lastEighth = -1;
    let beatPulse = 0;
    let glowUntil = 0;

    let paddleX = 0;
    let paddleTargetX = 0;
    let leftHeld = false;
    let rightHeld = false;

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(115, t);
      o.frequency.exponentialRampToValueAtTime(42, t + 0.16);
      g.gain.setValueAtTime(0.4, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.25);
    }
    function pHat(t: number, open = false) {
      const a = ctx();
      const dur = open ? 0.16 : 0.05;
      const buf = a.createBuffer(1, a.sampleRate * dur, a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7000;
      const g = a.createGain(); g.gain.value = open ? 0.09 : 0.06;
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    function pCatch(col: number, onBeat: boolean) {
      const a = ctx(); const t = a.currentTime + 0.003;
      const f = COL_FREQS[col];
      const o = a.createOscillator(); const g = a.createGain();
      o.type = onBeat ? 'triangle' : 'sine';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(onBeat ? 0.34 : 0.22, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.45);
      // attack click
      const buf = a.createBuffer(1, a.sampleRate * 0.02, a.sampleRate);
      const cd = buf.getChannelData(0);
      for (let i = 0; i < cd.length; i++) cd[i] = (Math.random() * 2 - 1) * (1 - i / cd.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const ng = a.createGain(); ng.gain.value = 0.08;
      n.connect(ng).connect(a.destination); n.start(t);
      if (onBeat) {
        const o2 = a.createOscillator(); const g2 = a.createGain();
        o2.type = 'sine'; o2.frequency.setValueAtTime(f * 2, t);
        g2.gain.setValueAtTime(0.0001, t);
        g2.gain.exponentialRampToValueAtTime(0.1, t + 0.005);
        g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.24);
        o2.connect(g2).connect(a.destination); o2.start(t); o2.stop(t + 0.28);
      }
    }
    function pMiss() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(92, t);
      o.frequency.exponentialRampToValueAtTime(48, t + 0.3);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.2, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.34);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.36);
    }

    // ---- ramps ----
    function curBpm(elapsed: number) {
      const p = Math.min(1, elapsed / RUN_MS);
      return BPM_START + (BPM_END - BPM_START) * p;
    }
    function spawnChance(elapsed: number) {
      const p = Math.min(1, elapsed / RUN_MS);
      return 0.30 + 0.55 * p;
    }

    // ---- canvas ----
    const canvas = document.getElementById('dct-canvas') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    let W = 0, H = 0, DPR = 1;
    let laneW = 0, catchY = 0, paddleHalfW = 0, beanR = 0;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = W * DPR; canvas.height = H * DPR;
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
      laneW = W / COLS;
      catchY = H * CATCH_Y_FRAC;
      paddleHalfW = Math.min(laneW * 0.56, 64);
      beanR = Math.min(laneW * 0.24, 18);
      if (paddleX === 0) { paddleX = W / 2; paddleTargetX = W / 2; }
      clampTarget();
    }
    window.addEventListener('resize', resize);

    // Noun catcher sprite — real Nouns art, drawn onto the canvas. Never
    // read back, so no crossOrigin needed (a tainted canvas draws fine).
    const nounPaddle = new Image();
    let nounReady = false;
    nounPaddle.onload = () => { nounReady = true; };

    function rr(x: number, y: number, w: number, h: number, r: number) {
      const rad = Math.min(r, w / 2, h / 2);
      cx.beginPath();
      cx.moveTo(x + rad, y);
      cx.arcTo(x + w, y, x + w, y + h, rad);
      cx.arcTo(x + w, y + h, x, y + h, rad);
      cx.arcTo(x, y + h, x, y, rad);
      cx.arcTo(x, y, x + w, y, rad);
      cx.closePath();
    }

    function drawNoggle(x: number, y: number, s: number) {
      // Fallback catcher — a noggle: two cream lenses, dark pupils, a bridge.
      const lens = s * 0.4;
      const gap = s * 0.14;
      cx.fillStyle = '#f4e7c8';
      rr(x - gap - lens, y - lens / 2, lens, lens, 3); cx.fill();
      rr(x + gap, y - lens / 2, lens, lens, 3); cx.fill();
      cx.fillStyle = '#ff6b8a';
      cx.fillRect(x - gap, y - lens * 0.16, gap * 2, lens * 0.32);
      cx.fillStyle = '#07050f';
      cx.fillRect(x - gap - lens * 0.42, y - lens * 0.28, lens * 0.42, lens * 0.56);
      cx.fillRect(x + gap + lens * 0.16, y - lens * 0.28, lens * 0.42, lens * 0.56);
    }

    function drawPaddle(now: number) {
      const glow = now < glowUntil;
      const size = Math.min(laneW * 1.12, 96);
      const topY = catchY - size * 0.86;
      if (glow) {
        cx.save();
        cx.globalAlpha = 0.45;
        cx.fillStyle = '#8aeac0';
        cx.beginPath();
        cx.ellipse(paddleX, catchY - size * 0.42, size * 0.72, size * 0.56, 0, 0, Math.PI * 2);
        cx.fill();
        cx.restore();
      }
      if (nounReady && nounPaddle.naturalWidth > 0) {
        cx.drawImage(nounPaddle, paddleX - size / 2, topY, size, size);
      } else {
        drawNoggle(paddleX, catchY - size * 0.42, size * 0.9);
      }
      // catcher tray
      cx.fillStyle = glow ? '#8aeac0' : '#f6c15e';
      rr(paddleX - paddleHalfW, catchY, paddleHalfW * 2, 8, 4); cx.fill();
    }

    function drawBean(b: Bean, now: number) {
      const prog = (now - b.spawnT) / b.fallMs;
      const y = -beanR + prog * (catchY + beanR);
      if (y < -beanR || y > catchY + beanR) return;
      const x = (b.col + 0.5) * laneW;
      if (b.onBeat) {
        cx.save();
        cx.shadowColor = '#f6c15e';
        cx.shadowBlur = 12;
        cx.fillStyle = '#f6c15e';
        cx.beginPath(); cx.arc(x, y, beanR, 0, Math.PI * 2); cx.fill();
        cx.restore();
        cx.strokeStyle = '#8aeac0';
        cx.lineWidth = 2;
        cx.beginPath(); cx.arc(x, y, beanR + 3, 0, Math.PI * 2); cx.stroke();
        cx.strokeStyle = 'rgba(7,5,15,0.5)';
        cx.lineWidth = 2;
        cx.beginPath(); cx.arc(x, y, beanR * 0.5, Math.PI * 0.25, Math.PI * 1.15); cx.stroke();
      } else {
        cx.fillStyle = COL_COLORS[b.col];
        cx.beginPath(); cx.ellipse(x, y, beanR * 0.82, beanR * 0.98, 0, 0, Math.PI * 2); cx.fill();
        cx.strokeStyle = 'rgba(7,5,15,0.4)';
        cx.lineWidth = 1.5;
        cx.beginPath(); cx.arc(x, y, beanR * 0.55, Math.PI * 0.2, Math.PI * 1.1); cx.stroke();
        cx.fillStyle = 'rgba(255,255,255,0.24)';
        cx.beginPath(); cx.arc(x - beanR * 0.25, y - beanR * 0.35, beanR * 0.28, 0, Math.PI * 2); cx.fill();
      }
    }

    function draw(now: number) {
      cx.clearRect(0, 0, W, H);
      // column dividers
      cx.strokeStyle = 'rgba(244,231,200,0.06)';
      cx.lineWidth = 1;
      for (let i = 1; i < COLS; i++) {
        cx.beginPath(); cx.moveTo(i * laneW, 0); cx.lineTo(i * laneW, H); cx.stroke();
      }
      // catch line — pulses on every kick
      const pulse = Math.max(0, 1 - (now - beatPulse) / 220);
      cx.strokeStyle = `rgba(246,193,94,${0.45 + 0.45 * pulse})`;
      cx.lineWidth = 2 + 2 * pulse;
      cx.beginPath(); cx.moveTo(8, catchY); cx.lineTo(W - 8, catchY); cx.stroke();
      // beans
      for (const b of beans) if (!b.resolved) drawBean(b, now);
      // catcher
      drawPaddle(now);
      // bursts
      bursts = bursts.filter((b) => now - b.born < 340);
      for (const b of bursts) {
        const age = (now - b.born) / 340;
        cx.strokeStyle = b.color;
        cx.globalAlpha = 1 - age;
        cx.lineWidth = 3;
        cx.beginPath(); cx.arc(b.x, b.y, 12 + age * b.ring, 0, Math.PI * 2); cx.stroke();
        cx.globalAlpha = 1;
      }
    }

    // ---- hud ----
    const root = document.getElementById('dct')!;
    const judgeEl = document.getElementById('dct-judge')!;
    const pointsEl = document.getElementById('dct-points')!;
    const comboEl = document.getElementById('dct-combo')!;
    const timeEl = document.getElementById('dct-time')!;
    const nounEl = document.getElementById('dct-noun') as HTMLImageElement;
    const overlayNoun = document.getElementById('dct-overlay-noun') as HTMLImageElement;
    const lifeEls = Array.from(document.querySelectorAll('.dct__life')) as HTMLElement[];
    let judgeTimer = 0;

    function showJudge(kind: 'onbeat' | 'catch' | 'miss') {
      if (kind === 'onbeat') judgeEl.textContent = combo >= 4 ? `ON BEAT · ${combo}×` : 'ON BEAT +2';
      else if (kind === 'catch') judgeEl.textContent = combo >= 4 ? `+1 · ${combo}×` : '+1';
      else judgeEl.textContent = 'MISS';
      judgeEl.className = `dct__judge dct__judge--${kind}`;
      clearTimeout(judgeTimer);
      judgeTimer = window.setTimeout(() => { judgeEl.textContent = ''; }, 520);
    }
    function updateHud() {
      pointsEl.textContent = String(score);
      comboEl.textContent = String(combo);
      lifeEls.forEach((el, i) => el.classList.toggle('dct__life--lost', i >= lives));
    }
    function bobNoun() {
      root.classList.remove('dct--bob');
      void root.offsetWidth;
      root.classList.add('dct--bob');
    }
    function flashMiss() {
      stage.classList.add('dct__stage--hurt');
      setTimeout(() => stage.classList.remove('dct__stage--hurt'), 160);
    }

    // ---- musical clock + spawns ----
    function onEighthTick(e: number, elapsed: number) {
      const a = ctx();
      const at = a.currentTime + 0.02;
      if (e % 2 === 0) { pKick(at); beatPulse = performance.now(); bobNoun(); }
      else pHat(at, false);
      if (e % 8 === 7) pHat(at, true);
      if (elapsed < RUN_MS - 1300 && Math.random() < spawnChance(elapsed)) {
        const bpm = curBpm(elapsed);
        const eighthMs = (60_000 / bpm) / 2;
        beans.push({
          col: Math.floor(Math.random() * COLS),
          spawnT: performance.now(),
          fallMs: FALL_EIGHTHS * eighthMs,
          onBeat: e % 2 === 0,
          resolved: false,
        });
      }
    }

    function catchBean(b: Bean, bx: number) {
      caught++;
      combo++;
      maxCombo = Math.max(maxCombo, combo);
      score += b.onBeat ? 2 : 1;
      pCatch(b.col, b.onBeat);
      bursts.push({ x: bx, y: catchY, born: performance.now(), color: b.onBeat ? '#8aeac0' : COL_COLORS[b.col], ring: b.onBeat ? 46 : 32 });
      if (b.onBeat) {
        onBeatCatches++;
        glowUntil = performance.now() + 260;
        showJudge('onbeat');
        broadcast(b.col);
      } else {
        showJudge('catch');
      }
      updateHud();
    }
    function missBean(bx: number) {
      lives--;
      combo = 0;
      pMiss();
      bursts.push({ x: bx, y: catchY, born: performance.now(), color: '#ff6b8a', ring: 30 });
      showJudge('miss');
      flashMiss();
      updateHud();
    }

    function updateBeans(now: number) {
      for (const b of beans) {
        if (b.resolved) continue;
        const prog = (now - b.spawnT) / b.fallMs;
        const y = -beanR + prog * (catchY + beanR);
        if (y >= catchY) {
          b.resolved = true;
          const bx = (b.col + 0.5) * laneW;
          if (Math.abs(bx - paddleX) <= paddleHalfW + beanR) catchBean(b, bx);
          else missBean(bx);
        }
      }
      beans = beans.filter((b) => !b.resolved);
    }

    // ---- run loop ----
    const stage = document.getElementById('dct-stage') as HTMLElement;
    function frame(now: number) {
      if (!running) return;
      const dt = Math.min(50, now - lastFrame);
      lastFrame = now;
      const elapsed = now - startAt;
      // steer
      if (leftHeld) paddleTargetX -= PADDLE_SPEED * dt / 1000;
      if (rightHeld) paddleTargetX += PADDLE_SPEED * dt / 1000;
      clampTarget();
      paddleX += (paddleTargetX - paddleX) * Math.min(1, dt * 0.022);
      // advance the beat grid (BPM ramps, so eighthMs is recomputed live)
      const eighthMs = (60_000 / curBpm(elapsed)) / 2;
      songEighth += dt / eighthMs;
      while (Math.floor(songEighth) > lastEighth && lives > 0) {
        lastEighth++;
        onEighthTick(lastEighth, elapsed);
      }
      updateBeans(now);
      draw(now);
      const left = Math.max(0, RUN_MS - elapsed);
      timeEl.textContent = (left / 1000).toFixed(1);
      if (elapsed >= RUN_MS || lives <= 0) { endRun(elapsed >= RUN_MS ? 'time' : 'lives'); return; }
      rafId = requestAnimationFrame(frame);
    }

    // ---- overlay + lifecycle ----
    const overlay = document.getElementById('dct-overlay')!;
    const goBtn = document.getElementById('dct-go') as HTMLButtonElement;
    const bestLine = document.getElementById('dct-best-line')!;
    const titleEl = overlay.querySelector('.dct__title') as HTMLElement;
    const subEl = overlay.querySelector('.dct__sub') as HTMLElement;

    function clampTarget() {
      const min = paddleHalfW;
      const max = W - paddleHalfW;
      if (paddleTargetX < min) paddleTargetX = min;
      if (paddleTargetX > max) paddleTargetX = max;
    }

    function endRun(reason: 'time' | 'lives') {
      running = false;
      cancelAnimationFrame(rafId);
      beans = [];
      titleEl.textContent = reason === 'time' ? 'TIME!' : 'FLOORED';
      subEl.textContent = `${score} pts · ${caught} caught · ${onBeatCatches} on beat · ${maxCombo}× best combo`;
      goBtn.textContent = '▶ RUN IT BACK';
      try {
        const prev = Number(localStorage.getItem('pc-drum-catch-best') || 0);
        if (score > prev) localStorage.setItem('pc-drum-catch-best', String(score));
        const b = Math.max(score, prev);
        bestLine.textContent = `best ${b} · this run ${score}`;
      } catch {
        bestLine.textContent = `this run ${score}`;
      }
      overlay.classList.remove('dct__overlay--hidden');
    }

    function startRun() {
      ctx();
      resize();
      beans = [];
      bursts = [];
      score = 0; combo = 0; maxCombo = 0;
      lives = START_LIVES; caught = 0; onBeatCatches = 0;
      songEighth = 0; lastEighth = -1;
      beatPulse = 0; glowUntil = 0;
      leftHeld = false; rightHeld = false;
      paddleX = W / 2; paddleTargetX = W / 2;
      const pick = NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)];
      nounReady = false;
      nounPaddle.src = `https://noun.pics/${pick}.svg`;
      nounEl.src = `https://noun.pics/${pick}.svg`;
      updateHud();
      overlay.classList.add('dct__overlay--hidden');
      running = true;
      startAt = performance.now();
      lastFrame = startAt;
      rafId = requestAnimationFrame(frame);
    }

    // ---- input ----
    function pointerToTarget(e: PointerEvent) {
      const r = stage.getBoundingClientRect();
      paddleTargetX = e.clientX - r.left;
      clampTarget();
    }
    stage.addEventListener('pointerdown', (e) => {
      if (!running) return;
      e.preventDefault();
      try { stage.setPointerCapture(e.pointerId); } catch {}
      pointerToTarget(e);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!running) return;
      // mouse follows freely; touch/pen only while pressed
      if (e.pointerType !== 'mouse' && e.buttons === 0) return;
      pointerToTarget(e);
    });

    const LEFT_KEYS = new Set(['arrowleft', 'a']);
    const RIGHT_KEYS = new Set(['arrowright', 'd']);
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      const k = e.key.toLowerCase();
      if (LEFT_KEYS.has(k)) { e.preventDefault(); leftHeld = true; }
      else if (RIGHT_KEYS.has(k)) { e.preventDefault(); rightHeld = true; }
      else if ((k === ' ' || k === 'enter') && !running) { e.preventDefault(); startRun(); }
    });
    window.addEventListener('keyup', (e) => {
      const k = e.key.toLowerCase();
      if (LEFT_KEYS.has(k)) leftHeld = false;
      if (RIGHT_KEYS.has(k)) rightHeld = false;
    });
    goBtn.addEventListener('click', startRun);

    // ---- shared bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(col: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // keep the bus calm at high drop rates
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: col, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    const seed = NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)];
    nounEl.src = `https://noun.pics/${seed}.svg`;
    overlayNoun.src = `https://noun.pics/${seed}.svg`;
    resize();
    try {
      const b = Number(localStorage.getItem('pc-drum-catch-best') || 0);
      if (b > 0) bestLine.textContent = `best ${b} · gold beans score double`;
    } catch {}
  </script>
</BlockLayout>
