---
/** /meter-oracle — Door 4 of the Ten Doors (2026-11-02). A Main Street parking meter that reads the next fifteen minutes. */
import TenDoorsFrame from '../components/TenDoorsFrame.astro';
import { meterFortune } from '../lib/ten-doors/daily.mjs';

const buildFortune = meterFortune(new Date());
---

<TenDoorsFrame slug="meter-oracle">
  <div class="mo">
    <svg class="mo-meter" viewBox="0 0 220 360" role="img" aria-labelledby="mo-title">
      <title id="mo-title">A parking meter with a dial and a coin slot</title>
      <rect x="100" y="230" width="20" height="130" fill="#4b5751" />
      <rect x="40" y="20" width="140" height="220" rx="60" fill="#7a8a80" stroke="#24302a" stroke-width="6" />
      <rect x="62" y="56" width="96" height="70" rx="12" fill="#f4f1e4" stroke="#24302a" stroke-width="4" />
      <path d="M72 116 A38 38 0 0 1 148 116" fill="none" stroke="#24302a" stroke-width="3" />
      <g id="mo-needle" style="transform-origin:110px 116px;transform:rotate(-70deg);transition:transform 1.4s cubic-bezier(.3,1.6,.5,1)">
        <line x1="110" y1="116" x2="110" y2="76" stroke="#c0392b" stroke-width="4" stroke-linecap="round" />
      </g>
      <circle cx="110" cy="116" r="5" fill="#24302a" />
      <text x="110" y="148" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="#24302a">15 MIN ORACLE</text>
      <rect id="mo-slot" x="96" y="170" width="28" height="8" rx="3" fill="#24302a" />
      <text x="110" y="200" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" fill="#24302a">TAP THE SLOT</text>
    </svg>
    <div class="mo-paper" id="mo-paper" aria-live="polite">
      <p class="mo-label">This window's fortune</p>
      <p class="mo-fortune" id="mo-fortune">{buildFortune.fortune}</p>
      <p class="mo-when" id="mo-when">Feed the meter to see your fortune for now.</p>
    </div>
  </div>
  <div class="td-row">
    <button class="td-btn" id="mo-coin">Drop a pretend coin</button>
  </div>
</TenDoorsFrame>

<style>
  .mo { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 1.5rem; align-items: center; }
  .mo-meter { width: 100%; height: auto; cursor: pointer; }
  .mo-paper { background: #fffdf3; color: #24302a; border-radius: 6px; padding: 1.2rem 1.4rem; box-shadow: 0 6px 16px rgb(0 0 0 / 0.15); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; transform-origin: top; }
  .mo-paper.is-printing { animation: mo-print 0.9s steps(8) both; }
  @keyframes mo-print { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) {
    .mo-paper.is-printing { animation: none; }
    #mo-needle { transition: none !important; }
  }
  .mo-label { text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.1em; margin: 0 0 0.6rem; opacity: 0.7; }
  .mo-fortune { font-size: 1.25rem; line-height: 1.45; margin: 0 0 0.8rem; }
  .mo-when { font-size: 0.8rem; margin: 0; opacity: 0.75; }
  @media (max-width: 600px) { .mo { grid-template-columns: 1fr; } .mo-meter { max-width: 180px; margin: 0 auto; } }
</style>

<script>
  import { meterFortune, pacificClock } from '../lib/ten-doors/daily.mjs';
  import { tone, noise, audio } from '../lib/ten-doors/audio.mjs';

  const needle = document.getElementById('mo-needle');
  const paper = document.getElementById('mo-paper');
  const fortuneEl = document.getElementById('mo-fortune');
  const whenEl = document.getElementById('mo-when');

  function feed() {
    audio();
    tone(1800, { type: 'triangle', length: 0.02, release: 0.15, gain: 0.2 });
    tone(1320, { type: 'triangle', length: 0.02, release: 0.3, gain: 0.15, when: 0.09 });
    noise({ length: 0.5, gain: 0.08, freq: 2500, when: 0.2 });
    const f = meterFortune(new Date());
    const left = (Date.parse(f.end) - Date.now()) / 900000;
    needle.style.transform = `rotate(${-70 + 140 * left}deg)`;
    paper.classList.remove('is-printing'); void paper.offsetWidth; paper.classList.add('is-printing');
    fortuneEl.textContent = f.fortune;
    whenEl.textContent = `Fortune No. ${f.number}, good from ${pacificClock(new Date(f.start))} to ${pacificClock(new Date(f.end))} Pacific. Same for everyone asking now.`;
  }
  document.getElementById('mo-coin').addEventListener('click', feed);
  document.querySelector('.mo-meter').addEventListener('click', feed);
  window.addEventListener('keydown', (e) => { if (e.key === ' ' && e.target === document.body) { e.preventDefault(); feed(); } });
  // The printed fortune on load is from the build; refresh it to the live window without the sound.
  const live = meterFortune(new Date());
  fortuneEl.textContent = live.fortune;
</script>
