---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Breathe — a Noun breathes with you" description="Pick a breath pattern. A Noun scales up on inhale, holds, and falls on exhale. A soft pad drone rises and falls with the breath. Box breathing, 4-7-8, coherent breathing.">
  <main class="cb" id="cb" data-built={built}>
    <header class="cb__hero">
      <p class="cb__kicker">CAST · BREATHE · breath work with a Noun</p>
      <h1 class="cb__title">Breathe with me.</h1>
      <p class="cb__sub">A Noun scales up on the inhale, holds, and falls on the exhale. A soft pad drone rises and falls along with it. Pick a pattern. Hit start. Match the rhythm.</p>
    </header>

    <section class="cb__patterns">
      <p class="cb__section-label">PICK A PATTERN</p>
      <div class="cb__pattern-row" id="cb-patterns"></div>
    </section>

    <section class="cb__stage" id="cb-stage" data-state="idle">
      <div class="cb__noun-wrap">
        <div class="cb__noun-bg" id="cb-noun-bg"></div>
        <img class="cb__noun" id="cb-noun" src="https://noun.pics/928.svg" alt="A Noun, breathing"/>
        <p class="cb__phase-label" id="cb-phase-label">ready</p>
        <p class="cb__phase-counter" id="cb-phase-counter">—</p>
      </div>
      <button class="cb__start" id="cb-start" type="button" aria-label="Start / stop">
        <span id="cb-start-label">begin</span>
      </button>
    </section>

    <section class="cb__progress">
      <p class="cb__progress-label">
        <span id="cb-progress-text">12 cycles available · 0 completed</span>
      </p>
      <div class="cb__progress-track">
        <div class="cb__progress-fill" id="cb-progress-fill"></div>
      </div>
    </section>

    <section class="cb__tips">
      <h2 class="cb__tips-title">What's happening</h2>
      <ul class="cb__tips-list">
        <li><strong>Box (4-4-4-4)</strong> — equal inhale, hold, exhale, hold. The Navy SEAL pattern. Default. Builds focus.</li>
        <li><strong>4-7-8</strong> — inhale 4, hold 7, exhale 8. The "relaxing breath." Drops the nervous system fast.</li>
        <li><strong>Coherent (5.5-5.5)</strong> — slow even rhythm. Maximizes heart-rate variability. Used clinically.</li>
        <li><strong>Triangle (4-7-4)</strong> — in, hold, out. No hold at the bottom. Energizing.</li>
      </ul>
      <p class="cb__tips-note">If the audio drone gets in your way, hit the speaker to silence it. The Noun keeps breathing.</p>
    </section>

    <footer class="cb__foot">
      <p>Built {built.slice(0,10)} · No CDN. Just oscillators, lungs, a Noun.</p>
      <p>← <a href="/cast-on">/cast-on</a> · <a href="/town-music">/town-music</a> · <a href="/quiet-hours">/quiet-hours</a> · <a href="/">PointCast home</a></p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cb-bg: #050a08;
    --cb-walnut: #5a3422;
    --cb-flame: #f6c15e;
    --cb-cream: #f4e7c8;
    --cb-velvet: #0d1c18;
    --cb-line: rgba(244,231,200,0.10);
    --cb-text: #f4e7c8;
    --cb-text-mute: rgba(244,231,200,0.62);
    --cb-text-quiet: rgba(244,231,200,0.38);
    --cb-display: 'Inter Tight', system-ui, sans-serif;
    --cb-body: 'Inter', system-ui, sans-serif;
    --cb-mono: 'JetBrains Mono', ui-monospace, monospace;
    --cb-breath-c: #7d9a7c;
  }

  body { background: var(--cb-bg); color: var(--cb-text); font-family: var(--cb-body); }

  .cb {
    max-width: 720px; margin: 0 auto; padding: 36px 22px 48px 22px;
    display: flex; flex-direction: column; gap: 30px;
    position: relative; isolation: isolate;
    min-height: 100vh;
  }

  /* Ambient backdrop — slow gradient that pulses with the breath cycle */
  .cb::before {
    content: ''; position: fixed; inset: 0; z-index: -1;
    background:
      radial-gradient(70% 60% at 50% 35%, var(--cb-breath-c) 0%, transparent 60%),
      radial-gradient(60% 50% at 50% 90%, color-mix(in srgb, var(--cb-breath-c) 30%, #000) 0%, transparent 60%),
      linear-gradient(180deg, var(--cb-bg) 0%, color-mix(in srgb, var(--cb-breath-c) 12%, var(--cb-bg)) 100%);
    filter: blur(60px) saturate(0.7);
    opacity: 0.28;
    transform: scale(1.05);
    transition: opacity 1.2s ease;
  }
  .cb[data-state="active"]::before, .cb__stage[data-state="active"] ~ * { /* no-op selector for safety */ }

  /* HERO */
  .cb__kicker { font-family: var(--cb-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--cb-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .cb__title {
    font-family: var(--cb-display); font-weight: 900;
    font-size: clamp(40px, 7vw, 60px); line-height: 0.96; letter-spacing: -0.025em;
    margin: 0 0 14px 0;
    background: linear-gradient(180deg, var(--cb-cream), var(--cb-breath-c));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .cb__sub {
    font-family: var(--cb-body); font-size: 15px; line-height: 1.6;
    color: var(--cb-text-mute); max-width: 600px; margin: 0;
  }

  /* PATTERN PICKER */
  .cb__section-label { font-family: var(--cb-mono); font-size: 10px; letter-spacing: 0.7px; color: var(--cb-text-quiet); text-transform: uppercase; margin: 0 0 12px 0; }
  .cb__pattern-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  @media (max-width: 560px) { .cb__pattern-row { grid-template-columns: repeat(2, 1fr); } }
  .cb__pattern {
    padding: 12px 10px; border-radius: 8px;
    background: rgba(244,231,200,0.04);
    border: 2px solid transparent;
    cursor: pointer; text-align: left;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .cb__pattern:hover { background: rgba(244,231,200,0.10); }
  .cb__pattern--active { border-color: var(--cb-breath-c); background: rgba(125,154,124,0.10); }
  .cb__pattern-name { font-family: var(--cb-display); font-weight: 700; font-size: 14px; margin: 0; color: var(--cb-text); letter-spacing: -0.01em; }
  .cb__pattern-pattern { font-family: var(--cb-mono); font-size: 11px; color: var(--cb-breath-c); margin: 4px 0 2px 0; letter-spacing: 0.4px; }
  .cb__pattern-tag { font-family: var(--cb-body); font-size: 11px; color: var(--cb-text-quiet); margin: 0; font-style: italic; }

  /* STAGE */
  .cb__stage {
    display: flex; flex-direction: column; align-items: center; gap: 28px;
    padding: 32px 0;
  }
  .cb__noun-wrap {
    position: relative;
    width: 260px; height: 260px;
    display: grid; place-items: center;
  }
  .cb__noun-bg {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--cb-breath-c) 50%, transparent) 0%, transparent 70%);
    transform: scale(0.5);
    transition: transform 1s ease;
    pointer-events: none;
  }
  .cb__stage[data-phase="inhale"] .cb__noun-bg { transform: scale(1.4); transition-duration: var(--phase-sec, 4s); transition-timing-function: cubic-bezier(0.4, 0, 0.4, 1); }
  .cb__stage[data-phase="hold-in"] .cb__noun-bg { transform: scale(1.4); transition-duration: 0.2s; }
  .cb__stage[data-phase="exhale"] .cb__noun-bg { transform: scale(0.5); transition-duration: var(--phase-sec, 4s); transition-timing-function: cubic-bezier(0.4, 0, 0.4, 1); }
  .cb__stage[data-phase="hold-out"] .cb__noun-bg { transform: scale(0.5); transition-duration: 0.2s; }

  .cb__noun {
    width: 140px; height: 140px;
    image-rendering: pixelated;
    filter: drop-shadow(0 6px 18px rgba(0,0,0,0.5));
    transform: scale(0.78);
    transition: transform 1s ease;
    position: relative;
    z-index: 1;
  }
  .cb__stage[data-phase="inhale"] .cb__noun { transform: scale(1.10); transition-duration: var(--phase-sec, 4s); transition-timing-function: cubic-bezier(0.4, 0, 0.4, 1); }
  .cb__stage[data-phase="hold-in"] .cb__noun { transform: scale(1.10); transition-duration: 0.2s; }
  .cb__stage[data-phase="exhale"] .cb__noun { transform: scale(0.78); transition-duration: var(--phase-sec, 4s); transition-timing-function: cubic-bezier(0.4, 0, 0.4, 1); }
  .cb__stage[data-phase="hold-out"] .cb__noun { transform: scale(0.78); transition-duration: 0.2s; }

  .cb__phase-label {
    position: absolute; bottom: -36px; left: 50%; transform: translateX(-50%);
    font-family: var(--cb-display); font-weight: 700;
    font-size: 22px; letter-spacing: -0.01em;
    color: var(--cb-text); margin: 0;
    text-transform: lowercase;
  }
  .cb__phase-counter {
    position: absolute; bottom: -64px; left: 50%; transform: translateX(-50%);
    font-family: var(--cb-mono); font-size: 36px; font-weight: 500;
    color: var(--cb-breath-c); margin: 0;
    letter-spacing: -0.02em;
  }

  /* START BUTTON */
  .cb__start {
    margin-top: 64px;
    background: rgba(125,154,124,0.10);
    border: 2px solid var(--cb-breath-c);
    color: var(--cb-text); font-family: var(--cb-display);
    font-weight: 600; font-size: 14px;
    padding: 12px 28px; border-radius: 999px;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: background 0.18s ease, transform 0.15s ease;
  }
  .cb__start:hover { background: rgba(125,154,124,0.20); transform: scale(1.04); }
  .cb__start:focus-visible { outline: 3px solid var(--cb-flame); outline-offset: 4px; }
  .cb__start--on { background: rgba(246,193,94,0.16); border-color: var(--cb-flame); color: var(--cb-flame); }

  /* PROGRESS */
  .cb__progress { display: flex; flex-direction: column; gap: 8px; }
  .cb__progress-label { font-family: var(--cb-mono); font-size: 11px; color: var(--cb-text-mute); margin: 0; text-align: center; letter-spacing: 0.3px; }
  .cb__progress-track { height: 3px; background: rgba(244,231,200,0.10); border-radius: 2px; overflow: hidden; max-width: 480px; width: 100%; margin: 0 auto; }
  .cb__progress-fill { height: 100%; background: var(--cb-breath-c); width: 0%; transition: width 0.6s ease; }

  /* TIPS */
  .cb__tips { padding: 22px 24px; background: rgba(244,231,200,0.03); border: 1px solid var(--cb-line); border-radius: 12px; }
  .cb__tips-title { font-family: var(--cb-display); font-weight: 700; font-size: 18px; margin: 0 0 12px 0; }
  .cb__tips-list { list-style: none; padding: 0; margin: 0 0 14px 0; display: flex; flex-direction: column; gap: 10px; }
  .cb__tips-list li { font-family: var(--cb-body); font-size: 13.5px; line-height: 1.5; color: var(--cb-text-mute); }
  .cb__tips-list strong { color: var(--cb-breath-c); font-weight: 600; }
  .cb__tips-note { font-family: var(--cb-body); font-size: 12.5px; color: var(--cb-text-quiet); margin: 0; font-style: italic; line-height: 1.5; }

  /* FOOT */
  .cb__foot {
    margin-top: auto; padding-top: 24px; border-top: 1px solid var(--cb-line);
    font-family: var(--cb-mono); font-size: 11px; color: var(--cb-text-quiet);
    line-height: 1.7; text-align: center;
  }
  .cb__foot a { color: var(--cb-breath-c); text-decoration: none; }
  .cb__foot a:hover { text-decoration: underline; }
</style>

<script>
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';

  // ============================================================
  //  CAST · BREATHE — a Noun breathes with you
  //  Visual + audio breath companion. Four patterns. The Noun scales,
  //  the drone fades, the counter ticks.
  // ============================================================

  interface Pattern {
    id: string;
    name: string;
    pattern: string; // display
    tag: string;
    // phase durations in seconds: inhale, hold-in, exhale, hold-out
    inhale: number; holdIn: number; exhale: number; holdOut: number;
    cycles: number;
    // base drone frequency (lower = deeper)
    rootHz: number;
  }

  const PATTERNS: Pattern[] = [
    { id: 'box', name: 'Box', pattern: '4 · 4 · 4 · 4', tag: 'focus · default', inhale: 4, holdIn: 4, exhale: 4, holdOut: 4, cycles: 8, rootHz: 110.00 }, // A
    { id: '478', name: '4-7-8', pattern: '4 · 7 · 8 · 0', tag: 'relax · sleep', inhale: 4, holdIn: 7, exhale: 8, holdOut: 0, cycles: 6, rootHz: 98.00 }, // G
    { id: 'coherent', name: 'Coherent', pattern: '5.5 · 0 · 5.5 · 0', tag: 'HRV · clinical', inhale: 5.5, holdIn: 0, exhale: 5.5, holdOut: 0, cycles: 10, rootHz: 130.81 }, // C
    { id: 'triangle', name: 'Triangle', pattern: '4 · 7 · 4 · 0', tag: 'energy', inhale: 4, holdIn: 7, exhale: 4, holdOut: 0, cycles: 8, rootHz: 146.83 }, // D
  ];

  // Soothing Noun choices — Marine Layer + Aurora Slow + Night Broadcast.
  // Rotate the Noun per pattern so visiting at different intervals refreshes.
  const NOUNS = [928, 313, 1189];

  // ---------- Audio ----------
  let ctx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let sched: AudioScheduler | null = null;
  let droneOsc1: OscillatorNode | null = null;
  let droneOsc2: OscillatorNode | null = null;
  let droneOsc3: OscillatorNode | null = null;
  let droneGain: GainNode | null = null;
  let droneLP: BiquadFilterNode | null = null;
  let audioOn = true;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterGain = ctx.createGain(); masterGain.gain.value = 0.5;
    masterGain.connect(ctx.destination);
    sched = createAudioScheduler(ctx);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running' && running) {
        sched?.resume();
      }
    });
    return ctx;
  }

  function startDrone(rootHz: number) {
    const c = ac();
    droneGain = c.createGain(); droneGain.gain.value = 0.001;
    droneLP = c.createBiquadFilter(); droneLP.type = 'lowpass'; droneLP.frequency.value = 800; droneLP.Q.value = 0.7;
    droneOsc1 = c.createOscillator(); droneOsc1.type = 'sine'; droneOsc1.frequency.value = rootHz;
    droneOsc2 = c.createOscillator(); droneOsc2.type = 'sine'; droneOsc2.frequency.value = rootHz * 1.5; // fifth
    droneOsc3 = c.createOscillator(); droneOsc3.type = 'sine'; droneOsc3.frequency.value = rootHz * 2.0; // octave
    droneOsc1.connect(droneLP); droneOsc2.connect(droneLP); droneOsc3.connect(droneLP);
    droneLP.connect(droneGain); droneGain.connect(masterGain!);
    sched!.trackSource(droneOsc1); droneOsc1.start();
    sched!.trackSource(droneOsc2); droneOsc2.start();
    sched!.trackSource(droneOsc3); droneOsc3.start();
  }
  function stopDrone() {
    if (sched) sched.stopAll();
    try { droneGain?.disconnect(); droneLP?.disconnect(); } catch {}
    droneOsc1 = droneOsc2 = droneOsc3 = null;
    droneGain = null; droneLP = null;
  }

  function setDroneEnvelope(phase: 'inhale' | 'hold-in' | 'exhale' | 'hold-out', durationSec: number) {
    if (!droneGain || !droneLP || !audioOn || !ctx) return;
    const c = ctx;
    const t = c.currentTime;
    droneGain.gain.cancelScheduledValues(t);
    droneLP.frequency.cancelScheduledValues(t);
    const peakG = 0.16;
    const dipG = 0.02;
    const peakF = 1800;
    const dipF = 600;
    if (phase === 'inhale') {
      droneGain.gain.linearRampToValueAtTime(peakG, t + durationSec);
      droneLP.frequency.linearRampToValueAtTime(peakF, t + durationSec);
    } else if (phase === 'hold-in') {
      // sustain at peak (a tiny lift in the filter helps the held breath feel alive)
      droneGain.gain.linearRampToValueAtTime(peakG, t + durationSec);
      droneLP.frequency.linearRampToValueAtTime(peakF * 0.92, t + durationSec);
    } else if (phase === 'exhale') {
      droneGain.gain.linearRampToValueAtTime(dipG, t + durationSec);
      droneLP.frequency.linearRampToValueAtTime(dipF, t + durationSec);
    } else if (phase === 'hold-out') {
      droneGain.gain.linearRampToValueAtTime(dipG, t + durationSec);
      droneLP.frequency.linearRampToValueAtTime(dipF * 0.85, t + durationSec);
    }
  }

  // ---------- Breath state machine ----------
  let currentPatternId = 'box';
  let running = false;
  let cyclesDone = 0;
  let curPhase: 'inhale' | 'hold-in' | 'exhale' | 'hold-out' = 'inhale';
  let phaseTimerId: number | null = null;
  let counterTimerId: number | null = null;

  function getPattern(): Pattern { return PATTERNS.find(p => p.id === currentPatternId) || PATTERNS[0]; }
  function getNounId(): number {
    const idx = PATTERNS.findIndex(p => p.id === currentPatternId);
    return NOUNS[idx % NOUNS.length];
  }

  function start() {
    const p = getPattern();
    if (!ctx) ac();
    if (audioOn) startDrone(p.rootHz);
    running = true;
    cyclesDone = 0;
    curPhase = 'inhale';
    advancePhase();
    updateStartBtn();
    updateProgress();
  }
  function stop() {
    running = false;
    if (phaseTimerId) { clearTimeout(phaseTimerId); phaseTimerId = null; }
    if (counterTimerId) { clearInterval(counterTimerId); counterTimerId = null; }
    stopDrone();
    const stage = document.getElementById('cb-stage') as HTMLDivElement;
    stage.dataset.phase = 'idle';
    document.getElementById('cb-phase-label')!.textContent = 'ready';
    document.getElementById('cb-phase-counter')!.textContent = '—';
    updateStartBtn();
  }

  function advancePhase() {
    if (!running) return;
    const p = getPattern();
    const stage = document.getElementById('cb-stage') as HTMLDivElement;
    let dur = 0;
    if (curPhase === 'inhale') dur = p.inhale;
    else if (curPhase === 'hold-in') dur = p.holdIn;
    else if (curPhase === 'exhale') dur = p.exhale;
    else dur = p.holdOut;
    if (dur <= 0) {
      // Skip to next phase
      stepPhaseLabel();
      advancePhase();
      return;
    }
    stage.dataset.phase = curPhase;
    stage.style.setProperty('--phase-sec', `${dur}s`);
    document.getElementById('cb-phase-label')!.textContent =
      curPhase === 'inhale' ? 'inhale' :
      curPhase === 'hold-in' ? 'hold' :
      curPhase === 'exhale' ? 'exhale' : 'rest';
    // Audio envelope
    setDroneEnvelope(curPhase, dur);
    // Counter from `dur` down to 1
    startCounter(dur);
    // Schedule next phase
    phaseTimerId = window.setTimeout(() => { stepPhaseLabel(); advancePhase(); }, dur * 1000);
  }

  function stepPhaseLabel() {
    if (curPhase === 'inhale') curPhase = 'hold-in';
    else if (curPhase === 'hold-in') curPhase = 'exhale';
    else if (curPhase === 'exhale') curPhase = 'hold-out';
    else if (curPhase === 'hold-out') {
      // cycle done
      cyclesDone++;
      curPhase = 'inhale';
      updateProgress();
      const p = getPattern();
      if (cyclesDone >= p.cycles) {
        // Finish
        finish();
      }
    }
  }

  function startCounter(dur: number) {
    if (counterTimerId) clearInterval(counterTimerId);
    let remain = Math.ceil(dur);
    document.getElementById('cb-phase-counter')!.textContent = String(remain);
    counterTimerId = window.setInterval(() => {
      remain--;
      if (remain >= 1) document.getElementById('cb-phase-counter')!.textContent = String(remain);
      else { if (counterTimerId) clearInterval(counterTimerId); counterTimerId = null; }
    }, 1000);
  }

  function finish() {
    running = false;
    if (phaseTimerId) { clearTimeout(phaseTimerId); phaseTimerId = null; }
    if (counterTimerId) { clearInterval(counterTimerId); counterTimerId = null; }
    // Long fade out on the drone, then full stop
    if (droneGain && ctx) {
      droneGain.gain.cancelScheduledValues(ctx.currentTime);
      droneGain.gain.linearRampToValueAtTime(0.001, ctx.currentTime + 3.0);
      setTimeout(() => stopDrone(), 3200);
    } else { stopDrone(); }
    const stage = document.getElementById('cb-stage') as HTMLDivElement;
    stage.dataset.phase = 'idle';
    document.getElementById('cb-phase-label')!.textContent = 'complete';
    document.getElementById('cb-phase-counter')!.textContent = '✓';
    updateStartBtn();
  }

  function updateStartBtn() {
    const btn = document.getElementById('cb-start')!;
    const lbl = document.getElementById('cb-start-label')!;
    btn.classList.toggle('cb__start--on', running);
    lbl.textContent = running ? 'stop' : 'begin';
  }
  function updateProgress() {
    const p = getPattern();
    document.getElementById('cb-progress-text')!.textContent = `${p.cycles} cycles available · ${cyclesDone} completed`;
    const fill = document.getElementById('cb-progress-fill') as HTMLDivElement;
    fill.style.width = `${(cyclesDone / p.cycles) * 100}%`;
  }

  // ---------- Render ----------
  function renderPatterns() {
    const wrap = document.getElementById('cb-patterns')!;
    wrap.innerHTML = PATTERNS.map(p => `
      <button class="cb__pattern ${currentPatternId === p.id ? 'cb__pattern--active' : ''}" data-pattern="${p.id}" type="button">
        <p class="cb__pattern-name">${p.name}</p>
        <p class="cb__pattern-pattern">${p.pattern}</p>
        <p class="cb__pattern-tag">${p.tag}</p>
      </button>
    `).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-pattern]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (running) stop();
        currentPatternId = btn.dataset.pattern!;
        renderPatterns();
        renderNoun();
        updateProgress();
        // Update the ambient color from the new pattern's drone family
        const p = getPattern();
        const colors: Record<string, string> = { 'box': '#7d9a7c', '478': '#6f59c0', 'coherent': '#9ed6f0', 'triangle': '#f6c15e' };
        document.documentElement.style.setProperty('--cb-breath-c', colors[p.id] || '#7d9a7c');
      });
    });
  }

  function renderNoun() {
    const img = document.getElementById('cb-noun') as HTMLImageElement;
    img.src = `https://noun.pics/${getNounId()}.svg`;
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderPatterns();
    renderNoun();
    updateProgress();
    document.getElementById('cb-start')?.addEventListener('click', () => {
      if (running) stop(); else start();
    });
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') {
        e.preventDefault();
        if (running) stop(); else start();
      }
    });
  });
</script>
</BlockLayout>
