---
import BlockLayout from '../layouts/BlockLayout.astro';
import { COHORT_OFFERINGS, COMMON_DISRUPTORS, ENVIRONMENT_AND_RITUAL, FRAMING_POSITION, HONEST_CAUTIONS, NINETY_DAY_PROTOCOL, PAPER_META, PAPER_NOTES, REFERENCES, SEVEN_SLEEP_PRINCIPLES, SLEEP_ARCHITECTURE } from '../lib/sleepPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/sleep', name: PAPER_META.title, description, url: 'https://pointcast.xyz/sleep', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const stageColor: Record<string, string> = { 'N1 (NREM stage 1) — transition': '#a8a39a', 'N2 (NREM stage 2) — light sleep': '#5b8aa8', 'N3 (NREM stage 3) — slow-wave / deep sleep': '#3a4a8a', 'REM (Rapid Eye Movement) — paradoxical sleep': '#5b3d7a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/sleep.json', title: 'Sleep (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/time">time</a><span aria-hidden="true">/</span><span>sleep</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY · WALKER / STANFORD / TRADITIONAL-REST LINEAGE</p>
      <h1>SLEEP.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="frame"><p class="kicker">FRAMING POSITION</p><h2>How the corridor holds sleep.</h2>
      <p class="oneliner">{FRAMING_POSITION.oneSentence}</p>
      <p class="block"><strong>Why not productivity cult:</strong> {FRAMING_POSITION.whyNotProductivityCult}</p>
      <p class="block"><strong>Why not optimization tracker:</strong> {FRAMING_POSITION.whyNotOptimizationTracker}</p>
      <p class="block"><strong>Why the boring consensus:</strong> {FRAMING_POSITION.whyTheBoringConsensus}</p>
      <p class="block"><strong>Why cohort:</strong> {FRAMING_POSITION.whyCohort}</p>
      <p class="block"><strong>Why the corridor:</strong> {FRAMING_POSITION.whyTheCorridor}</p>
    </section>

    <section class="arch"><p class="kicker">SLEEP ARCHITECTURE · 4 STAGES, 5 CYCLES</p><h2>What an 8-hour night actually contains.</h2>
      <p class="lede">{SLEEP_ARCHITECTURE.description}</p>
      <ol class="st-list">{SLEEP_ARCHITECTURE.stages.map((s) => (
        <li style={`--st-color: ${stageColor[s.stage]};`}>
          <h3>{s.stage}</h3>
          <p class="st__meta"><strong>Per cycle:</strong> {s.durationPerCycle} · <strong>% of night:</strong> {s.percentOfNight}</p>
          <p class="st__row"><strong>What happens:</strong> {s.whatHappens}</p>
          <p class="st__row st__why"><strong>Why it matters:</strong> {s.whyItMatters}</p>
        </li>
      ))}</ol>
      <p class="block"><strong>Cycle summary:</strong> {SLEEP_ARCHITECTURE.cycleSummary}</p>
    </section>

    <section class="princ"><p class="kicker">SEVEN SLEEP PRINCIPLES</p><h2>What we orient by.</h2>
      <ol class="pr-list">{SEVEN_SLEEP_PRINCIPLES.map((p, i) => (
        <li>
          <div class="pr__head"><span class="pr__num">{String(i+1).padStart(2,'0')}</span><h3>{p.principle}</h3></div>
          <p>{p.detail}</p>
        </li>
      ))}</ol>
    </section>

    <section class="dis"><p class="kicker">COMMON DISRUPTORS · 9</p><h2>What undermines sleep, and what to do about it.</h2>
      <ol class="dis-list">{COMMON_DISRUPTORS.map((d) => (
        <li>
          <h3>{d.disruptor}</h3>
          <p class="dis__mech"><strong>Mechanism:</strong> {d.mechanism}</p>
          <p class="dis__fix"><strong>Fix:</strong> {d.fix}</p>
        </li>
      ))}</ol>
    </section>

    <section class="env"><p class="kicker">ENVIRONMENT · 8 ELEMENTS</p><h2>The bedroom as practice substrate.</h2>
      <ol class="env-list">{ENVIRONMENT_AND_RITUAL.bedroomEnvironment.map((e) => (
        <li>
          <h4>{e.element}</h4>
          <p>{e.recommendation}</p>
        </li>
      ))}</ol>
    </section>

    <section class="rit"><p class="kicker">PRE-SLEEP RITUAL · 6 STEPS · 90 MINUTES</p><h2>The path from waking to lights-out.</h2>
      <ol class="rit-list">{ENVIRONMENT_AND_RITUAL.preSleepRitual.map((r) => (
        <li>
          <span class="rit__when">{r.time}</span>
          <p>{r.practice}</p>
        </li>
      ))}</ol>
    </section>

    <section class="proto"><p class="kicker">90-DAY PROTOCOL · ONE SHIFT PER FORTNIGHT</p><h2>{NINETY_DAY_PROTOCOL.description}</h2>
      <ol class="fn-list">{NINETY_DAY_PROTOCOL.fortnightShifts.map((f) => (
        <li>
          <div class="fn__head"><span class="fn__n">{f.weeks}</span><h3>Fortnight {f.fortnight}</h3></div>
          <p>{f.shift}</p>
        </li>
      ))}</ol>
    </section>

    <section class="co"><p class="kicker">COHORT OFFERINGS · {COHORT_OFFERINGS.length}</p><h2>How to sleep with cohort support.</h2>
      <ol class="co-list">{COHORT_OFFERINGS.map((c) => (
        <li>
          <h3>{c.offering}</h3>
          <p class="co__row"><strong>Format:</strong> {c.format}</p>
          <p class="co__row"><strong>Who leads:</strong> {c.whoLeads}</p>
        </li>
      ))}</ol>
    </section>

    <section class="cau"><p class="kicker">HONEST CAUTIONS · 7 AREAS</p><h2>When the federation defers to clinicians.</h2>
      <p class="block warn"><strong>When to see a clinician:</strong> {HONEST_CAUTIONS.whenToSeeAClinican}</p>
      <p class="block warn"><strong>Sleep apnea:</strong> {HONEST_CAUTIONS.sleepApnea}</p>
      <p class="block warn"><strong>Insomnia treatment (CBT-I):</strong> {HONEST_CAUTIONS.insomniaTreatment}</p>
      <p class="block warn"><strong>Sleep medications:</strong> {HONEST_CAUTIONS.sleepMedications}</p>
      <p class="block warn"><strong>Shift work:</strong> {HONEST_CAUTIONS.shiftWork}</p>
      <p class="block warn"><strong>Pregnancy:</strong> {HONEST_CAUTIONS.pregnancy}</p>
      <p class="block warn"><strong>Children:</strong> {HONEST_CAUTIONS.children}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COHORT · CLINICIANS · COACHES</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/time">Time · UES-WP-2026-16</a>
      <a href="/marine-layer">Marine Layer · UES-WP-2026-01</a>
      <a href="/food">Food · UES-WP-2026-22</a>
      <a href="/plant">Plant · UES-WP-2026-21</a>
      <a href="/practice">Practice · UES-WP-2026-20</a>
      <a href="/sabbatical">Sabbatical · UES-Federation-07</a>
      <a href="/sleep.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --sl-ink:#1a1a1a; --sl-paper:#fdf9ee; --sl-mustard:#d4a534; --sl-rust:#b85a3a; --sl-sage:#2d6a3d; --sl-tide:#3d6a8a; --sl-navy:#3a4a8a; --sl-violet:#5b3d7a; --sl-fog:#d8d2c4; --sl-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--sl-paper); color: var(--sl-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--sl-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--sl-navy); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--sl-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--sl-navy); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 184px; line-height: .9; font-weight: 700; letter-spacing: -.04em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--sl-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--sl-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h4 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 6px; font-weight: 700; }

  .lede { font-size: 15px; line-height: 1.65; margin: 0 0 16px; max-width: 72ch; font-family: Georgia, serif; }
  .oneliner { font-size: 19px; line-height: 1.55; font-style: italic; margin: 0 0 16px; padding: 14px 16px; background: #fff; border-left: 6px solid var(--sl-navy); max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--sl-navy); max-width: 72ch; font-family: Georgia, serif; }
  .block.warn { border-left-color: var(--sl-rust); border-left-width: 6px; background: linear-gradient(90deg, #fff5f0, #fff); }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--sl-navy); margin-right: 6px; }
  .block.warn strong { color: var(--sl-rust); }

  /* Architecture stages */
  .st-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .st-list li { padding: 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 10px solid var(--st-color); }
  .st-list h3 { font-family: var(--pc-font-mono); font-size: 15px; margin: 0 0 8px; padding-bottom: 6px; border-bottom: 2px solid var(--st-color); }
  .st__meta { font-family: var(--pc-font-mono); font-size: 11px; margin: 0 0 8px; color: var(--sl-slate); letter-spacing: .08em; }
  .st__row { padding: 7px 10px; background: var(--sl-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--sl-fog); }
  .st__why { border-left-color: var(--st-color); }
  .st-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--st-color); margin-right: 4px; }

  /* Principles */
  .pr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .pr-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 6px solid var(--sl-navy); }
  .pr__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--sl-navy); }
  .pr__num { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--sl-navy); }
  .pr__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .pr-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Disruptors */
  .dis-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .dis-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 6px solid var(--sl-rust); }
  .dis-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--sl-rust); }
  .dis__mech, .dis__fix { padding: 6px 10px; background: var(--sl-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--sl-rust); }
  .dis__fix { border-left-color: var(--sl-sage); }
  .dis-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--sl-rust); margin-right: 4px; }
  .dis__fix strong { color: var(--sl-sage); }

  /* Environment */
  .env-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .env-list li { padding: 10px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 5px solid var(--sl-navy); }
  .env-list p { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }

  /* Ritual */
  .rit-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .rit-list li { display: grid; grid-template-columns: 160px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 5px solid var(--sl-violet); align-items: baseline; }
  .rit__when { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--sl-violet); letter-spacing: .08em; }
  .rit-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Protocol */
  .fn-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .fn-list li { padding: 10px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 5px solid var(--sl-sage); }
  .fn__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--sl-sage); }
  .fn__n { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--sl-rust); padding: 2px 8px; background: var(--sl-paper); letter-spacing: .12em; }
  .fn__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .fn-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Cohort offerings */
  .co-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .co-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sl-ink); border-left: 6px solid var(--sl-tide); }
  .co-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--sl-tide); }
  .co__row { padding: 6px 10px; background: var(--sl-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--sl-mustard); }
  .co__row strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--sl-tide); margin-right: 4px; }

  .invitation { background: var(--sl-navy); color: var(--sl-paper); border-top-color: var(--sl-navy); }
  .invitation .kicker { background: var(--sl-mustard); color: var(--sl-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--sl-mustard); color: var(--sl-ink); border-left: 4px solid var(--sl-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .9; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 4px solid var(--sl-mustard); line-height: 1.5; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--sl-navy); color: var(--sl-paper); text-decoration: none; }
  .links a:hover { background: var(--sl-rust); }

  @media (max-width: 800px) { h1 { font-size: 130px; } .rit-list li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 90px; } }
</style>
