---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FAQ, PREREQUISITES, REFERENCES, TEMPLATE_META, TEMPLATE_NOTES, TEN_STEP_FORK, WHAT_NOT_TO_FORK, WHAT_TO_CUSTOMIZE, WHAT_TO_KEEP } from '../lib/forkableTemplate';
const title = `${TEMPLATE_META.title} — ${TEMPLATE_META.subtitle}`;
const description = TEMPLATE_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'TechArticle', '@id': 'https://pointcast.xyz/forkable-template', name: TEMPLATE_META.title, description, url: 'https://pointcast.xyz/forkable-template', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/forkable-template.json', title: 'Forkable Template (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/forkable-radius">forkable-radius</a><span aria-hidden="true">/</span><span>forkable-template</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{TEMPLATE_META.paperNumber} · DEVELOPER GUIDE · 10 STEPS · ONE WEEKEND</p>
      <h1>FORK / THIS.</h1>
      <p class="subtitle">{TEMPLATE_META.subtitle}</p>
      <p class="thesis">{TEMPLATE_META.thesis}</p>
      <p class="audience"><strong>Audience:</strong> {TEMPLATE_META.audience}</p>
    </header>

    <section class="prereqs"><p class="kicker">PREREQUISITES · 5</p><h2>Before you fork.</h2>
      <ol class="pq-list">{PREREQUISITES.map((p) => (
        <li><h3>{p.item}</h3><p>{p.detail}</p></li>
      ))}</ol>
    </section>

    <section class="steps"><p class="kicker">THE 10-STEP FORK</p><h2>One weekend, end to end.</h2>
      <ol class="st-list">{TEN_STEP_FORK.map((s) => (
        <li>
          <span class="st__num">{s.step}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
          </div>
        </li>
      ))}</ol>
    </section>

    <section class="keep"><p class="kicker">WHAT TO KEEP · 7</p><h2>Inherited by reference.</h2>
      <ul class="kp-list">{WHAT_TO_KEEP.map((k) => (<li>{k}</li>))}</ul>
    </section>

    <section class="custom"><p class="kicker">WHAT TO CUSTOMIZE · 7</p><h2>Make it yours.</h2>
      <ul class="cu-list">{WHAT_TO_CUSTOMIZE.map((c) => (<li>{c}</li>))}</ul>
    </section>

    <section class="dont"><p class="kicker">WHAT NOT TO FORK · 5</p><h2>Hands off.</h2>
      <ul class="dn-list">{WHAT_NOT_TO_FORK.map((d) => (<li>{d}</li>))}</ul>
    </section>

    <section class="faq"><p class="kicker">FAQ · 7</p><h2>Common questions.</h2>
      <dl class="faq-dl">{FAQ.map((f) => (
        <div class="faq-row"><dt>{f.q}</dt><dd>{f.a}</dd></div>
      ))}</dl>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · SHIP YOUR FORK</p>
      <p>{TEMPLATE_NOTES.uesNote}</p>
      <p class="invite-cta">{TEMPLATE_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/forkable-radius">The Forkable Radius · framework</a>
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/manhattan-beach">Manhattan Beach · UES-Fork-MB-01</a>
      <a href="/hermosa-beach">Hermosa Beach · UES-Fork-HB-02</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/forkable-template.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --ft-ink:#1a1a1a; --ft-paper:#fdf9ee; --ft-mustard:#d4a534; --ft-rust:#b85a3a; --ft-sage:#2d6a3d; --ft-strand:#5b8aa8; --ft-mauve:#a06478; --ft-fog:#d8d2c4; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--ft-paper); color: var(--ft-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--ft-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--ft-mauve); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ft-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--ft-mauve); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0 0 12px; }
  .audience { font-size: 13.5px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--ft-mauve); max-width: 72ch; }
  .audience strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ft-mauve); margin-right: 4px; }

  section { padding: 28px; border-top: 4px solid var(--ft-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }

  .pq-list, .st-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .pq-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--ft-ink); border-left: 8px solid var(--ft-mustard); }
  .pq-list h3, .st-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 6px; font-weight: 700; }
  .pq-list p, .st-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .st-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--ft-ink); border-left: 8px solid var(--ft-mauve); align-items: baseline; }
  .st__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--ft-mauve); }

  .kp-list, .cu-list, .dn-list { list-style: square; padding-left: 22px; margin: 0; font-size: 14px; line-height: 1.6; }
  .kp-list li { color: var(--ft-sage); }
  .kp-list li::marker { color: var(--ft-sage); }
  .cu-list li { color: var(--ft-mustard); }
  .cu-list li::marker { color: var(--ft-mustard); }
  .dn-list li { color: var(--ft-rust); }
  .dn-list li::marker { color: var(--ft-rust); }
  .kp-list li, .cu-list li, .dn-list li { padding: 4px 0; }
  .keep { background: linear-gradient(180deg, var(--ft-paper), #fff); }
  .custom { background: linear-gradient(180deg, #fff, var(--ft-paper)); }
  .dont { background: var(--ft-paper); }
  .kp-list li, .cu-list li, .dn-list li { color: var(--ft-ink); }

  .faq-dl { margin: 0; display: grid; gap: 8px; }
  .faq-row { padding: 12px 14px; background: #fff; border: 2px solid var(--ft-ink); border-left: 6px solid var(--ft-mauve); }
  .faq-row dt { font-family: var(--pc-font-mono); font-size: 13px; font-weight: 700; margin: 0 0 6px; }
  .faq-row dd { margin: 0; font-size: 13.5px; line-height: 1.55; }

  .invitation { background: var(--ft-mauve); color: var(--ft-paper); border-top-color: var(--ft-mauve); }
  .invitation .kicker { background: var(--ft-mustard); color: var(--ft-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--ft-mustard); color: var(--ft-ink); border-left: 4px solid var(--ft-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--ft-mauve); color: var(--ft-paper); text-decoration: none; }
  .links a:hover { background: var(--ft-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .st-list li { grid-template-columns: 1fr; } }
</style>
