---
import BlockLayout from '../layouts/BlockLayout.astro';
import { POINTCAST_CONNECTORS } from '../lib/pointcast-connectors';
import {
  FIRECRAWL_SETUP,
  POINTCAST_CLIENT_SETUPS,
  POINTCAST_CONTEXT_URL,
  POINTCAST_START_PROMPT,
} from '../lib/pointcast-agent-kit';

const title = 'PointCast agent kit';
const description =
  'A sixty-second setup for reading PointCast with ChatGPT, Codex, Claude, Firecrawl, and any MCP-aware client.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/connectors',
  name: 'PointCast Agent Kit',
  description,
  url: 'https://pointcast.xyz/connectors',
  hasPart: POINTCAST_CONNECTORS.map((connector) => ({
    '@type': 'SoftwareApplication',
    name: connector.name,
    description: connector.description,
    url: connector.endpoint,
    applicationCategory: 'DeveloperApplication',
  })),
};

const alternates = [
  { type: 'application/json', href: '/connectors.json', title: 'PointCast connector links' },
  { type: 'text/markdown', href: '/agent-kit.md', title: 'PointCast agent kit' },
];
---

<BlockLayout title={title} description={description} jsonLd={jsonLd} alternates={alternates}>
  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/apps">apps</a>
      <span aria-hidden="true">/</span>
      <span>connectors</span>
    </nav>

    <header class="head">
      <p class="kicker">PointCast agent kit · open doors, clean receipts</p>
      <h1>Give your AI<br />a door into town.</h1>
      <p class="dek">
        PointCast already publishes the good stuff twice: a page for people
        and a clean route for machines. Start with one prompt. Add the MCP
        connector when you want tools. Bring Firecrawl when the open web gets
        messy.
      </p>
    </header>

    <section class="starter" aria-labelledby="starter-title">
      <div class="starter__number" aria-hidden="true">01</div>
      <div class="starter__body">
        <p class="label">Works in ChatGPT, Claude, Codex, and most web-enabled assistants</p>
        <h2 id="starter-title">Start with one sentence.</h2>
        <pre><code>{POINTCAST_START_PROMPT}</code></pre>
        <div class="starter__actions">
          <button type="button" class="copybtn" data-copy={POINTCAST_START_PROMPT}>Copy starter prompt</button>
          <a class="textlink" href={POINTCAST_CONTEXT_URL}>Open the agent kit →</a>
        </div>
      </div>
    </section>

    <section class="client-section" aria-labelledby="client-title">
      <header class="section-head">
        <p class="label">02 · Pick your door</p>
        <h2 id="client-title">Four clients. The same town.</h2>
        <p>Read-only exploration first. Tools that tap, post, claim, or participate stay human-approved.</p>
      </header>

      <div class="client-grid">
        {POINTCAST_CLIENT_SETUPS.map((client, index) => (
          <article class={`client-card client-card--${client.slug}`}>
            <p class="client-card__index">0{index + 1} / {client.eyebrow}</p>
            <h3>{client.name}</h3>
            <p>{client.setup}</p>
            {client.command && (
              <div class="command">
                <code>{client.command}</code>
                <button type="button" data-copy={client.command}>Copy</button>
              </div>
            )}
            <p class="verify"><strong>Test it:</strong> {client.verify}</p>
            <p class="client-card__note">{client.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="firecrawl" aria-labelledby="firecrawl-title">
      <div class="firecrawl__mark" aria-hidden="true">FC</div>
      <div class="firecrawl__copy">
        <p class="label">03 · The open-source web scraper</p>
        <h2 id="firecrawl-title">It’s Firecrawl.</h2>
        <p class="firecrawl__lede">
          {FIRECRAWL_SETUP.role} For PointCast, native JSON and MCP stay first;
          Firecrawl is the flexible reader for rendered pages and outside sources.
        </p>
        <p class="license">{FIRECRAWL_SETUP.license}</p>

        <div class="firecrawl__commands">
          <section>
            <p>Install CLI + agent skills</p>
            <div class="command command--fire">
              <code>{FIRECRAWL_SETUP.install}</code>
              <button type="button" data-copy={FIRECRAWL_SETUP.install}>Copy</button>
            </div>
          </section>
          <section>
            <p>Smoke-test PointCast — keyless</p>
            <div class="command command--fire">
              <code>{FIRECRAWL_SETUP.smoke}</code>
              <button type="button" data-copy={FIRECRAWL_SETUP.smoke}>Copy</button>
            </div>
          </section>
        </div>

        <div class="firecrawl__links">
          <a href={FIRECRAWL_SETUP.repository} target="_blank" rel="noopener">Open-source repo ↗</a>
          <a href={FIRECRAWL_SETUP.docs} target="_blank" rel="noopener">Official setup docs ↗</a>
          <button type="button" class="link-button" data-copy={FIRECRAWL_SETUP.mcpEndpoint}>Copy Firecrawl MCP URL</button>
        </div>
      </div>
    </section>

    <section class="route-order" aria-labelledby="route-title">
      <div>
        <p class="label">04 · Don’t scrape a clean door</p>
        <h2 id="route-title">PointCast retrieval order</h2>
      </div>
      <ol>
        <li><strong>Orient</strong><span>/agent-kit.md · /agents.json · /llms.txt</span></li>
        <li><strong>Read evidence</strong><span>the adjacent .json twin or /b/&#123;id&#125;.json</span></li>
        <li><strong>Search and navigate</strong><span>/api/mcp-v2 · /blocks.json · /feed.json</span></li>
        <li><strong>Crawl last</strong><span>rendered pages or outside sites with Firecrawl</span></li>
      </ol>
    </section>

    <section class="quick" aria-label="Priority connector">
      <div>
        <p class="quick__label">Priority link</p>
        <h2>{POINTCAST_CONNECTORS[0].name}</h2>
      </div>
      <label class="copyline">
        <span>Connector URL</span>
        <input readonly value={POINTCAST_CONNECTORS[0].endpoint} />
      </label>
      <button type="button" class="copybtn" data-copy={POINTCAST_CONNECTORS[0].endpoint}>
        Copy URL
      </button>
    </section>

    <section class="connectors" aria-label="Connector links">
      {POINTCAST_CONNECTORS.map((connector) => (
        <article class="connector">
          <div class="connector__top">
            <p class="connector__meta">{connector.status} · {connector.category} · priority {connector.priority}</p>
            <h2>{connector.name}</h2>
            <p>{connector.description}</p>
          </div>

          <label class="copyline copyline--card">
            <span>MCP endpoint</span>
            <input readonly value={connector.endpoint} />
          </label>

          <div class="connector__actions">
            <button type="button" class="copybtn copybtn--small" data-copy={connector.endpoint}>
              Copy URL
            </button>
            <a href={connector.endpoint}>Open discovery</a>
          </div>

          <div class="client-list">
            {connector.clients.map((client) => (
              <section class="client">
                <h3>{client.name}</h3>
                <p>{client.label}</p>
                <small>{client.note}</small>
              </section>
            ))}
          </div>

          <p class="tool-label">Client-visible tools</p>
          <ul class="tools">
            {connector.tools.slice(0, 9).map((tool) => <li>{tool}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <aside class="machine">
      <p>Machine-readable</p>
      <a href="/agent-kit.md">/agent-kit.md</a>
      <a href="/connectors.json">/connectors.json</a>
      <a href="/apps.json">/apps.json</a>
      {POINTCAST_CONNECTORS.map((connector) => (
        <a href={connector.endpoint.replace('https://pointcast.xyz', '')}>
          {connector.endpoint.replace('https://pointcast.xyz', '')}
        </a>
      ))}
    </aside>
  </main>
</BlockLayout>

<script is:inline>
  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var value = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(value);
        var old = btn.textContent;
        btn.textContent = 'Copied';
        window.setTimeout(function () { btn.textContent = old || 'Copy URL'; }, 1200);
      } catch {
        window.prompt('Copy connector URL', value);
      }
    });
  });
</script>

<style>
  .page { max-width: 1080px; margin: 0 auto; padding: 22px 18px 86px; }
  .crumb, .kicker, .label, .quick__label, .connector__meta, .copyline span, .tool-label, .machine,
  .client-card__index, .license {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .crumb {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 10px;
    color: var(--pc-ink-muted);
  }
  .crumb a { color: #8A2432; }
  .head {
    border-top: 1.5px solid var(--pc-ink);
    border-bottom: 1px solid var(--pc-rule-soft);
    padding: 24px 0 26px;
    margin-bottom: 18px;
  }
  .kicker { margin: 0 0 10px; font-size: 10px; color: #8A2432; }
  h1 { margin: 0; max-width: 920px; font-size: clamp(52px, 9vw, 104px); line-height: 0.86; font-weight: 500; letter-spacing: -0.055em; }
  .dek { max-width: 760px; margin: 14px 0 0; font-size: 18px; line-height: 1.5; color: var(--pc-ink-soft); }

  .label { margin: 0; font-size: 10px; color: #8A2432; }
  .starter {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 18px;
    padding: 24px;
    border: 1px solid #12110e;
    background: #fffaf0;
    box-shadow: 6px 6px 0 #12110e;
    margin: 26px 6px 40px 0;
  }
  .starter__number {
    font: 72px/0.86 Georgia, serif;
    font-style: italic;
    color: #d8a338;
  }
  .starter h2, .section-head h2, .firecrawl h2, .route-order h2 {
    margin: 6px 0 0;
    font-size: clamp(32px, 5vw, 58px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .starter pre {
    margin: 18px 0 14px;
    padding: 18px;
    border-left: 5px solid #d8a338;
    background: #12110e;
    color: #fffdf5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .starter pre code { font: 14px/1.65 var(--pc-font-mono); }
  .starter__actions, .firecrawl__links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .textlink { font: 12px/1 var(--pc-font-mono); color: #8A2432; }

  .client-section { margin: 0 0 40px; }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
    gap: 12px 36px;
    align-items: end;
    padding: 0 0 16px;
    border-bottom: 2px solid #12110e;
  }
  .section-head .label { grid-column: 1 / -1; }
  .section-head p:last-child { margin: 0; max-width: 440px; color: var(--pc-ink-soft); line-height: 1.5; }
  .client-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-left: 1px solid var(--pc-rule-soft);
  }
  .client-card {
    min-width: 0;
    padding: 20px;
    border-right: 1px solid var(--pc-rule-soft);
    border-bottom: 1px solid var(--pc-rule-soft);
    background: #fff;
  }
  .client-card:nth-child(1) { background: #f1f4eb; }
  .client-card:nth-child(2) { background: #eef4f9; }
  .client-card:nth-child(3) { background: #f6efe9; }
  .client-card:nth-child(4) { background: #f4eef6; }
  .client-card__index { margin: 0 0 18px; font-size: 9px; color: var(--pc-ink-muted); }
  .client-card h3 { margin: 0 0 10px; font-size: 30px; line-height: 1; font-weight: 500; }
  .client-card > p:not(.client-card__index) { line-height: 1.5; color: var(--pc-ink-soft); }
  .client-card__note { margin-top: 16px; padding-top: 12px; border-top: 1px solid rgba(18,17,14,.16); font-size: 12px; }
  .verify { font-size: 13px; }
  .command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    margin: 14px 0;
    border: 1px solid #12110e;
    background: #fff;
  }
  .command code {
    min-width: 0;
    padding: 11px 12px;
    font: 12px/1.5 var(--pc-font-mono);
    overflow-wrap: anywhere;
  }
  .command button, .link-button {
    border: 0;
    border-left: 1px solid #12110e;
    background: #12110e;
    color: #fff;
    padding: 9px 12px;
    font: 10px/1 var(--pc-font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .command button:hover, .link-button:hover { background: #185FA5; }

  .firecrawl {
    display: grid;
    grid-template-columns: minmax(150px, .55fr) minmax(0, 1.45fr);
    gap: 26px;
    padding: 28px;
    margin: 0 0 40px;
    background: #f06b3f;
    color: #12110e;
    border: 1px solid #12110e;
  }
  .firecrawl__mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    align-self: start;
    border: 2px solid #12110e;
    border-radius: 50%;
    background: #fff3ca;
    font: 72px/1 Georgia, serif;
    font-style: italic;
    box-shadow: 8px 8px 0 rgba(18,17,14,.9);
  }
  .firecrawl .label { color: #35160d; }
  .firecrawl__lede { max-width: 720px; margin: 14px 0 8px; font-size: 18px; line-height: 1.55; }
  .license { margin: 0 0 22px; font-size: 9px; }
  .firecrawl__commands { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .firecrawl__commands section { min-width: 0; }
  .firecrawl__commands p { margin: 0 0 6px; font: 10px/1.2 var(--pc-font-mono); text-transform: uppercase; letter-spacing: .1em; }
  .command--fire { margin: 0; background: #fff8e5; }
  .firecrawl__links { margin-top: 18px; }
  .firecrawl__links a, .link-button {
    border: 1px solid #12110e;
    background: #fff8e5;
    color: #12110e;
    padding: 10px 12px;
    font: 10px/1 var(--pc-font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .firecrawl__links a:hover { background: #12110e; color: #fff; }
  .firecrawl__links .link-button { border-left: 1px solid #12110e; background: #12110e; color: #fff; }

  .route-order {
    display: grid;
    grid-template-columns: minmax(220px, .7fr) minmax(0, 1.3fr);
    gap: 24px;
    padding: 24px 0 30px;
    border-top: 2px solid #12110e;
    margin-bottom: 20px;
  }
  .route-order ol { margin: 0; padding: 0; list-style: none; counter-reset: route; }
  .route-order li {
    counter-increment: route;
    display: grid;
    grid-template-columns: 34px minmax(130px, .6fr) minmax(0, 1.4fr);
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid var(--pc-rule-soft);
  }
  .route-order li::before { content: '0' counter(route); font: 10px/1.5 var(--pc-font-mono); color: #8A2432; }
  .route-order li strong { font-size: 15px; }
  .route-order li span { font: 12px/1.5 var(--pc-font-mono); color: var(--pc-ink-soft); overflow-wrap: anywhere; }

  .quick {
    display: grid;
    grid-template-columns: minmax(170px, 0.7fr) minmax(260px, 1.6fr) auto;
    gap: 12px;
    align-items: end;
    padding: 14px;
    border: 1px solid #12110e;
    background: #fffaf0;
    box-shadow: 4px 4px 0 #12110e;
    margin-bottom: 16px;
  }
  .quick__label { margin: 0 0 6px; font-size: 10px; color: #185FA5; }
  .quick h2 { margin: 0; font-size: 28px; line-height: 1; font-weight: 500; }

  .copyline { display: grid; gap: 6px; min-width: 0; }
  .copyline span { font-size: 10px; color: var(--pc-ink-muted); }
  .copyline input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border: 1px solid var(--pc-ink);
    background: #fff;
    padding: 10px 12px;
    font: 13px/1.2 var(--pc-font-mono);
    color: var(--pc-ink);
  }
  .copybtn, .connector__actions a {
    min-height: 40px;
    border: 1px solid var(--pc-ink);
    background: var(--pc-ink);
    color: #fff;
    padding: 10px 13px;
    font: 11px/1 var(--pc-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  .copybtn:hover, .connector__actions a:hover { background: #185FA5; color: #fff; text-decoration: none; }

  .connectors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .connector {
    display: grid;
    align-content: start;
    gap: 13px;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 16px;
  }
  .connector__meta { margin: 0 0 8px; font-size: 10px; color: #6B2139; }
  .connector h2 { margin: 0; font-size: 30px; line-height: 1; font-weight: 500; }
  .connector p { line-height: 1.5; color: var(--pc-ink-soft); }
  .connector__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .copybtn--small { min-height: 34px; padding: 8px 10px; }
  .connector__actions a { display: inline-grid; place-items: center; min-height: 34px; padding: 8px 10px; }

  .client-list { display: grid; gap: 8px; }
  .client {
    border-left: 3px solid #d8a338;
    background: #fbf7ea;
    padding: 10px;
  }
  .client h3 { margin: 0 0 4px; font-size: 16px; }
  .client p { margin: 0; font-size: 14px; }
  .client small { display: block; margin-top: 4px; color: var(--pc-ink-muted); line-height: 1.4; }

  .tool-label { margin: 0; font-size: 10px; color: var(--pc-ink-muted); }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: -4px 0 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    border: 1px solid rgba(18, 17, 14, 0.18);
    padding: 5px 7px;
    font: 11px/1 var(--pc-font-mono);
    background: #f8f7f2;
  }
  .machine {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--pc-rule-soft);
    font-size: 10px;
  }
  .machine p { margin: 0; color: var(--pc-ink-muted); }
  .machine a { color: #8A2432; }

  @media (max-width: 820px) {
    h1 { font-size: clamp(48px, 15vw, 76px); }
    .starter { grid-template-columns: 1fr; padding: 18px; }
    .starter__number { font-size: 48px; }
    .section-head, .firecrawl, .route-order { grid-template-columns: 1fr; }
    .client-grid, .firecrawl__commands { grid-template-columns: 1fr; }
    .firecrawl__mark { width: 132px; font-size: 50px; }
    .route-order li { grid-template-columns: 28px 1fr; }
    .route-order li span { grid-column: 2; }
    .quick { grid-template-columns: 1fr; }
    .connectors { grid-template-columns: 1fr; }
    .dek { font-size: 16px; }
  }

  @media (max-width: 520px) {
    .page { padding-inline: 14px; }
    .head { padding-top: 18px; }
    .starter pre { padding: 14px; }
    .starter pre code { font-size: 12px; }
    .client-card { padding: 16px; }
    .firecrawl { padding: 18px; }
    .command { grid-template-columns: 1fr; }
    .command button { border-left: 0; border-top: 1px solid #12110e; min-height: 38px; }
  }
</style>
