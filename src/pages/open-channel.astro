---
import OpenChannelModes from '../components/OpenChannelModes.astro';
import { RECORDINGS_READY } from '../../public/open-channel/narration-catalog.mjs';
const title = 'Open Channel — PointCast';
const description = RECORDINGS_READY
  ? 'Characters, Pitch Room, and Story Booth: authored scenes and guided exercises with prerecorded ElevenLabs narration and optional device voices. Dessa is not connected.'
  : 'Characters, Pitch Room, and Story Booth: authored scenes, guided practice, and editable outlines with optional device voices. Dessa is not connected.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#151c20" />
  <link rel="canonical" href="https://pointcast.xyz/open-channel/" />
  <link rel="alternate" type="application/json" href="/open-channel.json" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:url" content="https://pointcast.xyz/open-channel/" />
  <meta property="og:image" content="https://pointcast.xyz/open-channel/cover.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="stylesheet" href="/open-channel/style.css" />
</head>
<body>
  <a class="skip" href="#console">Skip to the conversation</a>
  <div class="page">
    <header class="masthead"><a class="pointcast" href="/">POINTCAST</a><span class="mast-note">EXPERIMENTS IN GOOD COMPANY</span><a href="/apps/">All apps <span aria-hidden="true">↗</span></a></header>
    <main>
      <section class="intro" aria-labelledby="title">
        <div><p class="eyebrow">A VOICE PLAYGROUND / VOL. {RECORDINGS_READY ? '03' : '02'}</p><h1 id="title">Open Channel<span class="title-dot">.</span></h1><p class="lede">Step into a scene. Practice a pitch.<br />Find the shape of your next story.</p></div>
        <div class="edition"><span class="edition-circle" aria-hidden="true">↗</span><p>CHARACTERS · PITCH ROOM<br />STORY BOOTH</p></div>
      </section>
      <OpenChannelModes active="characters" />
      <div class="mode-note"><span class="dot" aria-hidden="true"></span><strong>Scripted voice demo</strong><span>{RECORDINGS_READY ? 'ElevenLabs narration · Dessa not connected' : 'Device voices · Dessa not connected'}</span><a href="#about">About this experiment ↗</a></div>
      <section class="workspace" aria-label="Open Channel player">
        <aside class="channels"><div class="section-label"><span>01 / PICK A CHANNEL</span><span>3</span></div><div id="channel-list"></div><p class="aside-note">Original characters.<br />A little company from elsewhere.</p></aside>
        <section class="console" id="console" tabindex="-1" aria-label="Conversation player">
          <div class="console-top"><span id="frequency">CH. 01</span><span class="signal-state"><i aria-hidden="true"></i><span id="status" role="status">READY TO TUNE IN</span></span></div>
          <div class="dial" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="dial-core"><span id="character-initial">M</span></div><span class="dial-cross cross-one">+</span><span class="dial-cross cross-two">+</span><div class="wave" id="wave"></div></div>
          <div class="character"><p class="eyebrow" id="character-role"></p><h2 id="character-name"></h2><p id="scene-description"></p></div>
          <div class="conversation" id="conversation" hidden><p class="line-label" id="line-label"></p><p id="line" tabindex="-1"></p><p class="ending" id="ending" hidden></p><div class="choices" id="choices"></div></div>
          <div class="start-panel" id="start-panel"><button class="primary" id="start" type="button">Tune in <span aria-hidden="true">↗</span></button><p>Choose replies by tapping. Sound is optional.</p></div>
          <div class="transport"><button id="narration" type="button" aria-pressed="false"><span aria-hidden="true">◖))</span> Voice off</button><button id="replay" type="button" disabled>↺ Hear line</button><button id="interrupt" type="button" disabled>■ Stop voice</button><button id="restart" type="button" disabled>↻ Restart scene</button></div>
          <details class="narration-settings"><summary>Voice settings</summary><div class="voice-preferences"><label for="voice-mode" hidden={!RECORDINGS_READY}>Narration</label><select id="voice-mode" hidden={!RECORDINGS_READY}>{RECORDINGS_READY && <option value="recording" selected>Recorded voices · ElevenLabs</option>}<option value="browser" selected={!RECORDINGS_READY}>Device voice</option></select><div id="browser-voice-row" hidden={RECORDINGS_READY}><label for="browser-voice">Voice on this device</label><select id="browser-voice"><option value="">Browser default</option></select></div><p id="voice-description">{RECORDINGS_READY ? 'AI narration recorded with ElevenLabs. Your answers are not sent to ElevenLabs.' : 'Choose an English voice available on this device. Voice quality varies by browser. Playback uses the voice’s natural pitch and pace.'}</p></div></details>
          <details class="voice-tools"><summary>Try voice choices</summary><p id="mic-help">Tap the microphone, then say “one” or “two.” Your browser may send audio to its speech service. PointCast does not record it. This is a voice command demo, not an AI conversation.</p><button id="mic" type="button" aria-describedby="mic-help" disabled>Start microphone</button><p id="mic-status" role="status">Tune in to choose a reply.</p></details>
        </section>
        <aside class="notebook"><div class="section-label"><span>02 / YOUR SESSION</span><span class="notebook-mark" aria-hidden="true">↗</span></div><p class="notebook-title">Keep the<br /><em>good bits.</em></p><p class="notebook-copy">A conversation leaves a trail.<br />Yours will appear here.</p><ol id="transcript" aria-label="Session transcript"></ol><p id="empty-transcript">No signal yet.</p><label for="note">A NOTE TO TAKE WITH YOU</label><textarea id="note" rows="3" maxlength="1000" placeholder="What stayed with you?"></textarea><button id="save" type="button" disabled>Save transcript <span aria-hidden="true">↓</span></button><p class="privacy-note">Kept in this tab until you leave.<br />Download to keep a copy.</p></aside>
      </section>
      <section class="about" id="about"><div><p class="eyebrow">THE EXPERIMENT</p><h2>A world on the<br />other end of a voice.</h2></div><div><p>Open Channel explores a simple idea: a voice can make a tiny fictional world feel inhabited. Pick a reply, interrupt the narration, and discover another ending.</p><p>{RECORDINGS_READY ? 'This edition pairs authored branching scenes with prerecorded AI narration from ElevenLabs. Open Voice settings to switch to a device voice. Your notes and answers are not sent to ElevenLabs.' : 'This edition uses authored branching scenes and your browser’s available voices. Open Voice settings to choose a voice; narration keeps its natural pitch and pace.'} It does not generate answers or recognize emotion. Voice commands, where supported, select numbered replies.</p><p>It was inspired by <a href="https://block.xyz/dessa" target="_blank" rel="noopener noreferrer">Block’s Dessa research preview ↗</a>. As checked October 25, 2026, we could not verify a public model download or developer API. Connecting Dessa remains a future experiment, dependent on access and its supported features. This is an independent PointCast project.</p></div></section>
    </main>
    <footer><a class="pointcast" href="/">POINTCAST</a><span>SMALL WORLDS. OPEN FREQUENCIES.</span><a href="/open-channel.json">Project details ↗</a></footer>
  </div>
  <noscript><p class="noscript">Open Channel needs JavaScript to play. These are scripted stories with optional narration; no Dessa connection is available.</p></noscript>
  <script type="module" src="/open-channel/app.mjs" is:inline></script>
</body>
</html>
