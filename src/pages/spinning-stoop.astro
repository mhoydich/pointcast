---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Spinning Stoop · the porch where the records spin';
const description =
  'A pixel-art porch on the Spinning channel. Sixteen fresh Visit Nouns sit on the steps. Click any one for a one-line listening memory. The PointCast Listening Room playlist hums in the background.';

const STOOP = [
  { seed: 348, line: 'rented a movie at Hollywood Video and the case still smelled like buttered popcorn.' },
  { seed: 459, line: 'burned a CD in the carport at midnight, sharpie label, no tracklist.' },
  { seed: 477, line: 'discman skipped on every speed bump on Imperial Highway.' },
  { seed: 499, line: 'a Best Buy gift card was the best birthday card you could get.' },
  { seed: 510, line: 'wired the iPod into the Civic with a cassette adapter that hissed.' },
  { seed: 567, line: 'kept a tape labeled MIX FOR T in the glovebox for nine years.' },
  { seed: 633, line: 'first heard the College Dropout intro through a screen door.' },
  { seed: 675, line: 'ran the laps at El Segundo High while the Walkman ran out.' },
  { seed: 699, line: 'fell asleep on KCRW twice a week without changing the dial.' },
  { seed: 763, line: 'the radio rotation at the dentist had not changed since 2004.' },
  { seed: 824, line: 'a kid choir on a hook is the only kind of optimism that lasts.' },
  { seed: 876, line: 'recorded the radio onto a tape so the DJ said your name on the loop.' },
  { seed: 901, line: 'lent a CD, never got it back, can still hum the whole tracklist.' },
  { seed: 945, line: 'fixed the tape with a pencil, six turns by hand, played it twice more.' },
  { seed: 1003, line: 'stood at the back of the show and felt the bass in the floor.' },
  { seed: 1099, line: 'small house. coffee pot always on. one record on the table.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://pointcast.xyz/spinning-stoop',
  name: title,
  description,
  url: 'https://pointcast.xyz/spinning-stoop',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title={title}
  description={description}
  image="https://noun.pics/348.svg"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/b/0454.json', title: 'Block 0454 (JSON)' },
  ]}
  frame={{
    image: 'https://noun.pics/348.svg',
    buttons: [
      { label: 'Spinning Stoop', action: 'link', target: 'https://pointcast.xyz/spinning-stoop' },
      { label: "We Don't Care · room", action: 'link', target: 'https://pointcast.xyz/we-dont-care' },
      { label: 'Listening Room', action: 'link', target: 'https://pointcast.xyz/listening-room' },
      { label: '/c/spinning', action: 'link', target: 'https://pointcast.xyz/c/spinning' },
    ],
  }}
>
  <div class="stoop">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/c/spinning">spinning</a>
      <span aria-hidden="true">/</span>
      <span>stoop</span>
    </nav>

    <header class="hero">
      <p class="kicker">CH.SPN · BLOCK 0454 · STOOP</p>
      <h1>The <em>Stoop</em>.</h1>
      <p class="dek">
        Sixteen fresh Visit Nouns on the porch steps. Click one for a one-line
        listening memory. The Listening Room playlist hums underneath.
      </p>
    </header>

    <section class="porch">
      <div class="porch__sky" aria-hidden="true">
        <span class="porch__sun"></span>
      </div>
      <div class="porch__house" aria-hidden="true">
        <div class="porch__roof"></div>
        <div class="porch__wall">
          <div class="porch__window"></div>
          <div class="porch__door"></div>
          <div class="porch__window"></div>
        </div>
      </div>
      <ol class="porch__steps" data-seats>
        {STOOP.map(({ seed, line }, i) => (
          <li class="seat" style={`--row: ${Math.floor(i / 4)}; --col: ${i % 4};`}>
            <button
              type="button"
              class="seat__btn"
              data-line={line}
              data-seed={seed}
              aria-label={`Visit Noun #${seed}`}
            >
              <img
                src={`https://noun.pics/${seed}.svg`}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
              />
              <span class="seat__tag">#{seed}</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="memory" data-memory aria-live="polite">
      <span class="memory__mark">“</span>
      <p class="memory__line" data-memory-line>
        click any noun on the steps. they each remember one thing.
      </p>
      <p class="memory__attr" data-memory-attr>— the stoop, in waiting</p>
    </section>

    <section class="player">
      <h2 class="bar">PLAYLIST · LISTENING ROOM</h2>
      <div class="player__embed">
        <iframe
          src="https://open.spotify.com/embed/playlist/35WC68tu9rrBoRrW3N2n0M?utm_source=pointcast"
          width="100%"
          height="232"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="PointCast Listening Room playlist"
        ></iframe>
      </div>
      <p class="player__note">
        Same playlist that runs the <a href="/listening-room">Listening Room</a>
        — sponsored by Nouns Cola × <a href="https://getgoodfeels.net" rel="noopener">getgoodfeels.net</a>.
      </p>
    </section>

    <section class="links">
      <h2 class="bar">NEARBY ROOMS</h2>
      <ul>
        <li><a href="/we-dont-care">/we-dont-care · tap-on-beat</a></li>
        <li><a href="/listening-room">/listening-room · space sparkle</a></li>
        <li><a href="/c/spinning">/c/spinning · channel index</a></li>
        <li><a href="/b/0454">/b/0454 · this block (JSON)</a></li>
      </ul>
    </section>

    <footer class="foot">
      <p>
        a small porch on a small internet town · <a href="/">pointcast</a> ·
        <a href="/c/spinning">/c/spinning</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      const seats = document.querySelectorAll('[data-seats] .seat__btn');
      const lineEl = document.querySelector('[data-memory-line]');
      const attrEl = document.querySelector('[data-memory-attr]');
      if (!seats.length || !lineEl) return;

      seats.forEach((btn) => {
        btn.addEventListener('click', () => {
          const line = btn.getAttribute('data-line') || '';
          const seed = btn.getAttribute('data-seed') || '?';
          lineEl.textContent = line;
          attrEl.textContent = '— Visit Noun #' + seed;
          seats.forEach((b) => b.classList.remove('is-on'));
          btn.classList.add('is-on');
          btn.classList.remove('is-pop');
          void btn.offsetWidth;
          btn.classList.add('is-pop');
        });
      });
    })();
  </script>

  <style>
    .stoop {
      --paper: #fff5e8;
      --ink: #1a1410;
      --coral: #993c1d;
      --gold: #e6a92b;
      --teal: #0f6e56;
      --sky: #f7c34c;
      --wood: #8a4a1d;
      --plank: #b56b34;

      max-width: 1040px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
      background: var(--paper);
      color: var(--ink);
      font-family: 'Georgia', 'Times New Roman', serif;
    }

    .crumb {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.7);
      margin-bottom: 1.5rem;
    }
    .crumb a { color: var(--coral); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb span[aria-hidden] { margin: 0 0.4rem; opacity: 0.5; }

    .hero {
      border: 3px double var(--ink);
      background: repeating-linear-gradient(
        135deg,
        #fff5e8 0 14px,
        #fae6c9 14px 28px
      );
      padding: 2rem;
      margin-bottom: 1.25rem;
    }
    .kicker {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      color: var(--coral);
      margin: 0 0 0.5rem;
    }
    .hero h1 {
      font-family: 'Georgia', serif;
      font-weight: 900;
      font-size: clamp(2.6rem, 8vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.02em;
      margin: 0 0 0.85rem;
    }
    .hero h1 em { color: var(--coral); }
    .hero .dek { max-width: 56ch; font-size: 1.05rem; line-height: 1.5; margin: 0; }

    .bar {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--paper);
      background: var(--ink);
      padding: 0.4rem 0.75rem;
      margin: 0 0 0.85rem;
      display: inline-block;
    }

    /* The porch — pixel-art-y house and steps */
    .porch {
      position: relative;
      border: 4px solid var(--ink);
      background: var(--sky);
      padding: 1.25rem;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .porch__sky {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 20% 25%, rgba(255,255,255,0.8) 0 8px, transparent 9px),
        radial-gradient(circle at 70% 18%, rgba(255,255,255,0.7) 0 6px, transparent 7px),
        radial-gradient(circle at 88% 32%, rgba(255,255,255,0.6) 0 5px, transparent 6px),
        linear-gradient(180deg, var(--sky) 0%, #ffd56b 60%, #ffe9a8 100%);
      pointer-events: none;
    }
    .porch__sun {
      position: absolute;
      top: 12%;
      left: 8%;
      width: 36px;
      height: 36px;
      background: #fff5b6;
      border: 3px solid var(--ink);
      border-radius: 50%;
      box-shadow: 0 0 0 6px rgba(255, 245, 182, 0.55);
    }
    .porch__house {
      position: relative;
      z-index: 1;
      width: min(360px, 60%);
      margin: 0 auto 0.75rem;
    }
    .porch__roof {
      width: 0;
      height: 0;
      margin: 0 auto;
      border-left: 180px solid transparent;
      border-right: 180px solid transparent;
      border-bottom: 56px solid var(--coral);
    }
    .porch__wall {
      background: var(--plank);
      border: 3px solid var(--ink);
      padding: 14px;
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr;
      gap: 12px;
      align-items: end;
    }
    .porch__window {
      aspect-ratio: 1 / 1;
      background:
        linear-gradient(135deg, #fff5b6 0 50%, #f7c34c 50% 100%);
      border: 3px solid var(--ink);
      box-shadow: inset 0 0 0 4px var(--paper);
    }
    .porch__door {
      aspect-ratio: 2 / 3;
      background: var(--wood);
      border: 3px solid var(--ink);
      position: relative;
    }
    .porch__door::after {
      content: '';
      position: absolute;
      right: 14%;
      top: 50%;
      width: 8px;
      height: 8px;
      background: var(--gold);
      border: 2px solid var(--ink);
      border-radius: 50%;
    }

    .porch__steps {
      list-style: none;
      margin: 0;
      padding: 0;
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.4rem;
      background:
        repeating-linear-gradient(180deg, var(--plank) 0 30px, var(--wood) 30px 31px);
      border: 3px solid var(--ink);
      padding: 0.85rem;
    }
    .seat { display: flex; justify-content: center; }
    .seat__btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.35rem;
      border: 2px solid var(--ink);
      background: var(--paper);
      cursor: pointer;
      transition: transform 0.12s ease;
      font-family: inherit;
      width: 100%;
      max-width: 110px;
    }
    .seat__btn:hover { transform: translateY(-2px); background: #fffaf0; }
    .seat__btn.is-on { background: var(--gold); }
    .seat__btn img {
      width: 100%;
      max-width: 64px;
      aspect-ratio: 1 / 1;
      image-rendering: pixelated;
      background: var(--paper);
      border: 2px solid var(--ink);
    }
    .seat__btn.is-on img { background: #fffbe5; }
    .seat__btn.is-pop { animation: seatPop 320ms ease-out; }
    .seat__tag {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: rgba(26, 20, 16, 0.65);
    }
    @keyframes seatPop {
      0% { transform: scale(1); }
      40% { transform: translateY(-6px) scale(1.08); }
      100% { transform: scale(1); }
    }

    .memory {
      position: relative;
      border: 3px solid var(--ink);
      background: var(--paper);
      padding: 1.5rem 1.5rem 1.5rem 3.5rem;
      margin-bottom: 1.25rem;
      min-height: 110px;
    }
    .memory__mark {
      position: absolute;
      top: 0.3rem;
      left: 0.7rem;
      font-family: 'Georgia', serif;
      font-style: italic;
      font-size: 5rem;
      line-height: 1;
      color: var(--coral);
    }
    .memory__line {
      font-family: 'Georgia', serif;
      font-size: clamp(1.05rem, 2.2vw, 1.35rem);
      line-height: 1.4;
      margin: 0 0 0.5rem;
    }
    .memory__attr {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.55);
      margin: 0;
    }

    .player { margin-bottom: 1.25rem; }
    .player__embed { border: 3px solid var(--ink); background: #000; }
    .player__embed iframe { display: block; border: 0; }
    .player__note { font-size: 0.92rem; color: rgba(26, 20, 16, 0.78); margin: 0.6rem 0 0; }
    .player__note a { color: var(--coral); }

    .links { margin-bottom: 1.25rem; }
    .links ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
    .links a { color: var(--coral); font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.85rem; }

    .foot {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(26, 20, 16, 0.55);
      text-align: center;
      padding-top: 1rem;
      border-top: 1px solid rgba(26, 20, 16, 0.2);
    }
    .foot a { color: var(--coral); margin: 0 0.25rem; }

    @media (max-width: 720px) {
      .porch__steps { grid-template-columns: repeat(3, 1fr); }
      .porch__house { width: 80%; }
      .porch__roof { border-left-width: 140px; border-right-width: 140px; border-bottom-width: 44px; }
    }
    @media (max-width: 480px) {
      .porch__steps { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</BlockLayout>
