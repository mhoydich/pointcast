---
import projects from '../data/home-latest-projects.json';
import progress from '../data/project-progress.json';
import { getPublishedProjects } from '../lib/home-published-projects.mjs';

// The published catalog is the source of the initial snapshot. Board lanes are
// personal planning choices, not assertions about the projects' real status.
const latest = getPublishedProjects(projects)
  .slice(0, 10)
  .map((project) => ({
    id: `project:${project.id}`,
    title: project.title,
    note: project.dek,
    url: project.href,
    publishedAt: project.publishedAt,
    lane: 'inbox',
  }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f4f0e7" />
  <meta name="description" content="A checked snapshot of PointCast projects, plus a device-local planning board." />
  <link rel="alternate" type="application/json" href="/project-kanban.json" title="Project progress snapshot" />
  <title>Project board · PointCast</title>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#242820;background:#f4f0e7;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#205d55}button,input,textarea,select{font:inherit}button,select{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #d56640;outline-offset:3px}.shell{max-width:1500px;margin:auto;padding:24px clamp(16px,3vw,42px) 60px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.brand{text-transform:uppercase;letter-spacing:.16em;font-weight:800;text-decoration:none;font-size:.76rem}.eyebrow{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:#6c7566;font-weight:800;margin:48px 0 10px}h1{font-family:Georgia,serif;font-size:clamp(2.8rem,7vw,5.3rem);font-weight:400;letter-spacing:-.055em;line-height:.95;margin:0}.intro{max-width:760px;font-size:1rem;line-height:1.55;color:#505a4d;margin:18px 0 0}.notice{margin:20px 0 0;border-left:3px solid #e48b54;padding:8px 14px;color:#4d5549;font-size:.88rem;line-height:1.5;background:#ebe6d9}.controls{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:14px;margin:32px 0 16px}.controls h2{font-size:1.15rem;margin:0}.controls p{margin:4px 0 0;color:#687163;font-size:.82rem}.actions{display:flex;gap:8px;flex-wrap:wrap}button,.button{border:1px solid #263b32;background:#263b32;color:white;border-radius:5px;padding:10px 14px;min-height:44px;font-weight:700}.secondary{background:transparent;color:#263b32}.board{display:grid;grid-template-columns:repeat(4,minmax(240px,1fr));gap:12px;align-items:start}.lane{background:#e8e3d8;border:1px solid #d9d1c2;border-radius:9px;padding:12px;min-height:190px}.lane-head{display:flex;align-items:center;justify-content:space-between;padding:4px 3px 14px}.lane h3{margin:0;font-size:.92rem}.count{font-size:.74rem;background:#d7d0c2;border-radius:50px;padding:4px 8px}.cards{display:grid;gap:10px}.card{background:#fffdf9;border:1px solid #ded8ca;border-radius:7px;padding:15px;box-shadow:0 2px 0 #d9d1c2}.card h4{font-family:Georgia,serif;font-size:1.18rem;font-weight:400;line-height:1.2;margin:0 0 8px}.card p{font-size:.84rem;line-height:1.5;color:#626a5e;margin:0 0 12px;white-space:pre-wrap;overflow-wrap:anywhere}.meta{font-size:.7rem!important;text-transform:uppercase;letter-spacing:.06em;color:#788072!important}.card a{display:inline-block;margin:0 0 14px;font-size:.82rem;font-weight:700}.card label,.edit label,.add-form label{display:block;font-size:.75rem;font-weight:700;margin:0 0 5px}.card select,input,textarea{width:100%;border:1px solid #b6bbae;border-radius:4px;background:#fff;color:#243129;padding:10px;min-height:44px}.card select{margin-bottom:10px}.card-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.card-actions button{background:none;border:0;color:#526257;padding:7px 0;min-height:44px;font-size:.8rem;text-decoration:underline;font-weight:600}.card-actions .delete{color:#a24331}.empty{font-size:.82rem;color:#758071;line-height:1.5;padding:10px 4px}.add-panel{margin:16px 0;background:#fffdf9;border:1px solid #d9d1c2;padding:16px;border-radius:7px}.add-panel[hidden]{display:none}.add-form{display:grid;gap:12px;max-width:600px}.add-form textarea,.edit textarea{resize:vertical;min-height:80px}.form-actions{display:flex;gap:8px;flex-wrap:wrap}.edit{border-top:1px solid #ebe5d9;margin-top:10px;padding-top:12px;display:grid;gap:8px}.edit[hidden]{display:none}.status{font-size:.8rem;color:#586655;min-height:1.3em}.footer{margin-top:26px;font-size:.8rem;color:#6b7367;line-height:1.5}@media(max-width:900px){.board{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.shell{padding-top:18px}.eyebrow{margin-top:36px}.board{grid-template-columns:1fr}.lane{min-height:0}.controls{align-items:start}.actions{width:100%}.actions button{flex:1}.card{padding:16px}.intro{font-size:.95rem}}
    .progress-intro{max-width:760px;color:#505a4d;line-height:1.6}.snapshot-bar{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin:30px 0 18px;padding:16px 0;border-top:1px solid #b7bcae;border-bottom:1px solid #b7bcae}.snapshot-bar p{margin:0;line-height:1.5;font-size:.85rem}.snapshot-filter label{font-weight:700;font-size:.8rem;display:block;margin-bottom:5px}.snapshot-filter select{min-width:190px;min-height:44px;border:1px solid #b6bbae;border-radius:4px;background:#fff;color:#243129;padding:10px}.progress-section-title{font-size:1rem;margin:0 0 14px}.progress-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;align-items:start}.progress-lane{min-width:0;border-top:4px solid #315f52;background:#e8e3d8;border-radius:4px 4px 9px 9px;padding:12px}.progress-lane:nth-child(2){border-color:#c87442}.progress-lane:nth-child(3){border-color:#6d6594}.progress-lane:nth-child(4){border-color:#a64b42}.progress-lane:nth-child(5){border-color:#8b8064}.progress-heading{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin:3px 0 15px}.progress-heading h3{font-size:.9rem;margin:0}.progress-heading span{font-size:.75rem;color:#586655}.progress-card{background:#fffdf9;border:1px solid #ded8ca;border-radius:6px;padding:15px;margin-bottom:10px;overflow-wrap:anywhere}.progress-card h4{font:400 1.25rem/1.15 Georgia,serif;margin:7px 0 10px}.progress-card p{font-size:.82rem;line-height:1.5;margin:0 0 11px;color:#424d42}.progress-card .progress-kind{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#536b5c}.progress-card dl{margin:12px 0;font-size:.78rem;line-height:1.45}.progress-card dt{font-weight:800;margin-top:9px}.progress-card dd{margin:2px 0 0;color:#4e5a4c}.progress-card ul{list-style:none;padding:0;margin:12px 0}.progress-card li{margin-top:8px}.progress-card a{font-size:.8rem;font-weight:700}.progress-card time{font-size:.71rem;color:#596557}.personal-board{border-top:1px solid #b7bcae;margin-top:65px;padding-top:10px}.progress-empty{font-size:.8rem;color:#667264}.progress-lane[hidden],.progress-card[hidden]{display:none}@media(max-width:1100px){.progress-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.progress-grid{grid-template-columns:1fr}.snapshot-filter,.snapshot-filter select{width:100%}}
  </style>
</head>
<body>
  <main class="shell">
    <div class="top"><a href="/" class="brand">⌐◨-◨ PointCast</a><a href="/latest/">Explore projects ↗</a></div>
    <p class="eyebrow">PointCast / work in the open</p>
    <h1>What we’re<br />making.</h1>
    <p class="progress-intro">A clear view of what’s open, taking shape, and waiting for its next step. Each card is a checked snapshot, with the evidence close at hand.</p>
    <div class="snapshot-bar"><p><strong>Last checked</strong> · <time datetime={progress.checkedAt}>{new Date(progress.checkedAt).toISOString().replace('T', ' ').slice(0, 16)} UTC</time><br />Manually maintained; not a live activity feed. <a href="/project-kanban.json">View versioned JSON ↗</a></p><div class="snapshot-filter"><label for="progress-filter">Filter by status</label><select id="progress-filter"><option value="all">All statuses</option>{progress.statuses.map((status) => <option value={status}>{status}</option>)}</select></div></div>
    <h2 class="progress-section-title">Public project progress</h2>
    <div class="progress-grid" aria-label="Public project progress">
      {progress.statuses.map((status) => {
        const items = progress.projects.filter((project) => project.status === status);
        return <section class="progress-lane" data-progress-lane={status} aria-label={status}>
          <div class="progress-heading"><h3>{status}</h3><span>{items.length} {items.length === 1 ? 'project' : 'projects'}</span></div>
          {items.length === 0 && <p class="progress-empty">Nothing checked into this lane yet.</p>}
          {items.map((project) => <article class="progress-card" data-project-id={project.id}>
            <p class="progress-kind">{project.kind}</p><h4>{project.title}</h4><p>{project.summary}</p>
            <dl><dt>Next action</dt><dd>{project.nextAction}</dd><dt>Blocker</dt><dd>{project.blocker || 'None noted'}</dd></dl>
            {project.links.length > 0 ? <ul aria-label={`Evidence for ${project.title}`}>{project.links.map((link) => <li><a href={link.url}>{link.label} ↗</a></li>)}</ul> : <p><strong>Evidence:</strong> {project.sourceNote}</p>}
            <time datetime={project.checkedAt}>Checked {new Date(project.checkedAt).toISOString().replace('T', ' ').slice(0, 16)} UTC</time>
          </article>)}
        </section>;
      })}
    </div>
    <section class="personal-board" aria-labelledby="personal-board-title">
    <p class="eyebrow">A little room to plan</p>
    <h2 id="personal-board-title">Your personal board.</h2>
    <p class="intro">Ten recent projects, ready for you to organize. Keep notes, add your own cards and move things at your own pace.</p>
    <p class="notice"><strong>A starting snapshot, not a live status report.</strong> The first ten cards come from PointCast’s verified publication catalog at build time. The lanes reflect your own planning choices; moving a card does not change the project. Your board is saved only in this browser.</p>
    <div class="controls"><div><h2>Your board</h2><p>Use the move menu on each card — it works on touch and keyboard.</p></div><div class="actions"><button type="button" id="add-toggle" aria-expanded="false" aria-controls="add-panel">+ Add a card</button><button type="button" id="reset" class="secondary">Reset board</button></div></div>
    <section class="add-panel" id="add-panel" hidden aria-label="Add a card"><form class="add-form" id="add-form"><div><label for="new-title">Title</label><input id="new-title" maxlength="120" required /></div><div><label for="new-note">Note <span>(optional)</span></label><textarea id="new-note" maxlength="1000"></textarea></div><div class="form-actions"><button type="submit">Add card</button><button type="button" id="add-cancel" class="secondary">Cancel</button></div></form></section>
    <p class="status" id="status" role="status" aria-live="polite"></p>
    <div class="board" id="board" aria-label="Project planning board"></div>
    <p class="footer">Changes stay on this device and are not synced. Clearing browser data removes the board. Reset restores the latest snapshot included in this version of the page.</p>
    <noscript><p>The personal board needs JavaScript to organize and save cards. The public snapshot above remains available.</p></noscript>
    </section>
  </main>
  <script is:inline define:vars={{ latest }}>
    (() => {
      const progressFilter = document.getElementById('progress-filter');
      progressFilter.addEventListener('change', () => {
        document.querySelectorAll('[data-progress-lane]').forEach((lane) => { lane.hidden = progressFilter.value !== 'all' && lane.dataset.progressLane !== progressFilter.value; });
      });
      const key = 'pointcast:project-kanban:v1';
      const lanes = [{id:'inbox',name:'Unsorted'}, {id:'next',name:'Next'}, {id:'doing',name:'Doing'}, {id:'done',name:'Done'}];
      const board = document.getElementById('board');
      const status = document.getElementById('status');
      const addPanel = document.getElementById('add-panel');
      const addToggle = document.getElementById('add-toggle');
      const addForm = document.getElementById('add-form');
      let cards;
      let storageAvailable = true;
      const snapshot = () => latest.map((card) => ({...card}));
      function valid(card) {
        return card && typeof card.id === 'string' && typeof card.title === 'string' && typeof card.note === 'string' && lanes.some((lane) => lane.id === card.lane) && (card.url == null || (typeof card.url === 'string' && card.url.startsWith('/') && !card.url.startsWith('//'))) && (card.publishedAt == null || typeof card.publishedAt === 'string');
      }
      let saved = null;
      try { saved = localStorage.getItem(key); } catch { storageAvailable = false; }
      try {
        const parsed = saved ? JSON.parse(saved) : null;
        cards = Array.isArray(parsed) && parsed.every(valid) ? parsed : snapshot();
      } catch { cards = snapshot(); }
      function save(message) {
        try { localStorage.setItem(key, JSON.stringify(cards)); storageAvailable = true; }
        catch { storageAvailable = false; }
        status.textContent = storageAvailable ? message : 'Storage is unavailable. Changes will last only while this page is open.';
      }
      function el(tag, text, className) { const item = document.createElement(tag); if (text != null) item.textContent = text; if (className) item.className = className; return item; }
      function button(text, className) { const item = el('button', text, className); item.type = 'button'; return item; }
      function render(focusId, focusTarget = 'select') {
        board.replaceChildren();
        for (const lane of lanes) {
          const section = el('section', null, 'lane');
          const heading = el('div', null, 'lane-head');
          const title = el('h3', lane.name); const count = el('span', String(cards.filter((card) => card.lane === lane.id).length), 'count');
          heading.append(title, count); section.append(heading);
          const list = el('div', null, 'cards');
          const laneCards = cards.filter((card) => card.lane === lane.id);
          if (!laneCards.length) list.append(el('p', 'Nothing here yet.', 'empty'));
          for (const card of laneCards) {
            const article = el('article', null, 'card');
            article.dataset.cardId = card.id;
            article.append(el('h4', card.title));
            if (card.publishedAt) { const date = new Date(card.publishedAt); if (!Number.isNaN(date.valueOf())) article.append(el('p', `Catalog publication · ${new Intl.DateTimeFormat('en', { dateStyle:'medium', timeZone:'UTC' }).format(date)}`, 'meta')); }
            if (card.note) article.append(el('p', card.note));
            if (card.url) { const link = el('a', 'Open project ↗'); link.href = card.url; article.append(link, document.createElement('br')); }
            const label = el('label', `Move ${card.title} to`); const select = el('select');
            select.setAttribute('aria-label', `Move ${card.title} to`);
            for (const option of lanes) { const item = el('option', option.name); item.value = option.id; item.selected = option.id === card.lane; select.append(item); }
            label.append(select); article.append(label);
            select.addEventListener('change', () => { card.lane = select.value; save(`${card.title} moved to ${lanes.find((item) => item.id === card.lane).name}.`); render(card.id); });
            const actions = el('div', null, 'card-actions'); const editButton = button('Edit'); const deleteButton = button('Remove', 'delete');
            editButton.setAttribute('aria-label', `Edit ${card.title}`); deleteButton.setAttribute('aria-label', `Remove ${card.title}`);
            const edit = el('form', null, 'edit'); edit.hidden = true;
            const titleLabel = el('label', 'Title'); const titleInput = el('input'); titleInput.value = card.title; titleInput.required = true; titleInput.maxLength = 120; titleLabel.append(titleInput);
            const noteLabel = el('label', 'Note'); const noteInput = el('textarea'); noteInput.value = card.note; noteInput.maxLength = 1000; noteLabel.append(noteInput);
            const editActions = el('div', null, 'form-actions'); const submit = el('button', 'Save'); submit.type = 'submit'; const cancel = button('Cancel', 'secondary'); editActions.append(submit,cancel); edit.append(titleLabel,noteLabel,editActions);
            editButton.addEventListener('click', () => { edit.hidden = false; editButton.setAttribute('aria-expanded','true'); titleInput.focus(); });
            cancel.addEventListener('click', () => { edit.hidden = true; editButton.setAttribute('aria-expanded','false'); editButton.focus(); });
            edit.addEventListener('submit', (event) => { event.preventDefault(); const value = titleInput.value.trim(); if (!value) { titleInput.setCustomValidity('Please enter a title.'); titleInput.reportValidity(); return; } card.title = value; card.note = noteInput.value.trim(); save('Card updated.'); render(card.id, 'button'); });
            titleInput.addEventListener('input', () => titleInput.setCustomValidity(''));
            deleteButton.addEventListener('click', () => { if (!confirm(`Remove “${card.title}” from this board?`)) return; cards = cards.filter((item) => item.id !== card.id); save('Card removed.'); render(); });
            actions.append(editButton,deleteButton); article.append(actions,edit); list.append(article);
          }
          section.append(list); board.append(section);
        }
        if (focusId) {
          const focusedCard = Array.from(board.querySelectorAll('.card')).find((card) => card.dataset.cardId === focusId);
          focusedCard?.querySelector(focusTarget)?.focus();
        }
      }
      function toggleAdd(show) { addPanel.hidden = !show; addToggle.setAttribute('aria-expanded', String(show)); if (show) document.getElementById('new-title').focus(); else addToggle.focus(); }
      addToggle.addEventListener('click', () => toggleAdd(addPanel.hidden));
      document.getElementById('add-cancel').addEventListener('click', () => toggleAdd(false));
      addForm.addEventListener('submit', (event) => { event.preventDefault(); const titleInput = document.getElementById('new-title'); const title = titleInput.value.trim(); if (!title) { titleInput.setCustomValidity('Please enter a title.'); titleInput.reportValidity(); return; } cards.push({id:`custom:${globalThis.crypto?.randomUUID ? globalThis.crypto.randomUUID() : `${Date.now()}-${Math.random()}`}`, title, note:document.getElementById('new-note').value.trim(), url:null, publishedAt:null, lane:'inbox'}); addForm.reset(); toggleAdd(false); save('Card added to Unsorted.'); render(); });
      document.getElementById('new-title').addEventListener('input', (event) => event.target.setCustomValidity(''));
      document.getElementById('reset').addEventListener('click', () => { if (!confirm('Reset the board? Your local cards and changes will be removed.')) return; cards = snapshot(); save('Board reset to the project snapshot.'); render(); });
      if (!storageAvailable) status.textContent = 'Storage is unavailable. Changes will last only while this page is open.';
      render();
    })();
  </script>
</body>
</html>
