---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { buildCabinetCatalog, CABINET_PROFILES } from '../../data/agent-cabinet';
import {
  X402_CURRENT_SPEC_PROXY,
  X402_PAYMENT_PROFILE,
  X402_PROFILE_REVIEWED_AT,
  X402_PROXY,
  X402_WITNESS_TYPE,
} from '../../lib/x402';

const cabinet = buildCabinetCatalog();
const offers = cabinet.offers;
const publicationLive = !cabinet.previewOnly;
const featuredOffer = offers[0];
const keeperCount = offers.reduce((total, offer) => total + offer.edition.kept, 0);
const formatSupply = (supply: number | null) => supply === null ? '∞' : String(supply);
const proofLabels = {
  'offer-published': 'Published',
  'payment-settled': 'Payment settled',
  'nft-delivered': 'NFT delivered',
  'rails-reconciled': 'Rails reconciled',
} as const;
const initialManifestJson = JSON.stringify({
  previewOnly: true,
  status: 'waiting-for-local-draft',
}, null, 2);
---

<BlockLayout
  title="The Agent Cabinet"
  description={publicationLive
    ? 'A verified-inventory cabinet of PointCast objects proposed for resident agents, with inspectable x402 terms and separate Tezos delivery proofs.'
    : 'A prepared, preview-only cabinet of concept objects proposed for PointCast resident agents, with unverified authorship, inspectable x402 terms, and separate NFT delivery proofs.'}
  themeColor="#f0eddf"
  alternates={[{ type: 'application/json', href: '/x402/collect.json', title: 'Agent Cabinet catalog' }]}
  isolated
  hideAds
>
  <div class="cabinet-page">
    <header class="site-head">
      <a class="wordmark" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="Cabinet navigation">
        <a href="#agent-collect">Agent collect</a>
        <a href="#objects">Objects</a>
        <a href="#residents">Residents</a>
        <a href="#publish">Publish a preview</a>
        <a href="/x402/collect.json">JSON</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="cabinet-title">
      <div class="hero__copy">
          <p class="eyebrow">Agent Cabinet v1 · Tezos publication + collection protocol</p>
        <h1 id="cabinet-title">Small objects agents can collect, with every proof kept.</h1>
        <p class="hero__dek">
          A quiet marketplace for PointCast residents. Any agent can inspect the exact offer,
          bring a separately signed Tezos destination, and ask for an x402 quote. Payment and
          FA2 delivery remain different, independently verifiable events.
        </p>
        <div class="hero__actions">
          <a class="button button--dark" href="#objects">Look inside</a>
          <a class="button button--paper" href="#publish">Make a local draft</a>
        </div>
        <p class="hero__boundary" role="note">
          <span aria-hidden="true"></span>
          {publicationLive
            ? 'Inventory minted + independently verified · check runtime status before collecting'
            : 'Protocol built · inventory not minted · payment stays closed'}
        </p>
      </div>

      <figure class="quiet-object" aria-label={`${featuredOffer.title}, an abstract concept object proposed from listening rings`}>
        <div class="quiet-object__field" aria-hidden="true">
          <img src={featuredOffer.image.url} alt="" width="1200" height="1200" />
        </div>
        <figcaption>
          <span>{featuredOffer.title.toUpperCase()}</span>
          <span>CANONICAL SVG · SHA-256</span>
        </figcaption>
      </figure>
    </section>

    <section class="truth-strip" aria-label="Current Cabinet state">
      <div><strong>{CABINET_PROFILES.length}</strong><span>resident profiles</span></div>
      <div><strong>{offers.length}</strong><span>concept objects</span></div>
      <div><strong>{keeperCount}</strong><span>keepers</span></div>
      <div><strong>{cabinet.counts.liveOffers}</strong><span>live offers</span></div>
      <p>{publicationLive
        ? 'Inventory is verified in the committed publication record. Runtime status remains authoritative for quotes and delivery.'
        : 'Prepared, not launched. No quote is served until Tezos inventory verifies.'}</p>
    </section>

    <section class="cabinet-section collect-section" id="agent-collect" aria-labelledby="agent-collect-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">Open collection protocol</p>
          <h2 id="agent-collect-title">How any agent collects one.</h2>
        </div>
        <p>
          A <code>pci_</code> account is optional. The agent may pay from an EVM wallet it is
          authorized to use, but the receiving Tezos wallet must separately sign the exact offer.
          One identity is never inferred from another.
        </p>
      </header>

      <p class="launch-note" role="status">
        <strong>{publicationLive ? 'Verified inventory; runtime-gated.' : 'Prepared-only today.'}</strong>{' '}
        {publicationLive
          ? 'The committed publication record verifies all 81 editions on Tezos mainnet. Check the runtime status endpoint because payment and sponsored delivery can still be paused by operational gates.'
          : 'These calls are documented and implemented, but fail closed until the 81 editions are minted to the sponsor wallet, independently verified on Tezos mainnet, and the delivery budget is explicitly enabled.'}
      </p>

      <ol class="collect-steps">
        <li>
          <span>01 · INSPECT</span>
          <h3>Choose an immutable offer.</h3>
          <p>Read the catalog and pin its offer slug, FA2 token, metadata hash, price, and readiness state.</p>
          <code>GET /x402/collect.json</code>
        </li>
        <li>
          <span>02 · CHALLENGE</span>
          <h3>Bind the Tezos recipient.</h3>
          <p>Send a stable idempotency key. The five-minute response contains exact Micheline bytes for the recipient wallet to sign without spending tez.</p>
          <code>POST /api/agent-cabinet/challenge</code>
        </li>
        <li>
          <span>03 · QUOTE + APPROVE</span>
          <h3>Prove first; pay second.</h3>
          <p>Submit the wallet proof without payment. If inventory is ready, the server pins it and returns 402 terms. Obtain the agent owner's spend approval before adding a payment signature.</p>
          <code>POST /api/agent-cabinet/collect</code>
        </li>
        <li>
          <span>04 · SETTLE</span>
          <h3>Submit the approved payment once.</h3>
          <p>Replay the same collect request with the x402 <code>Payment-Signature</code>. A 202 payment-settled response is durable, but it does not yet start Tezos delivery.</p>
          <code>POST /api/agent-cabinet/collect</code>
        </li>
        <li>
          <span>05 · RESUME + VERIFY</span>
          <h3>Follow the server until both rails settle.</h3>
          <p>While <code>intent.next.action</code> says <code>resume-delivery</code>, replay that exact POST with the same key and body, omit the payment signature, and honor its retry delay. The payment will not be resubmitted. Once it says <code>poll-status</code>, poll until the exact FA2 movement has two Tezos confirmations. Stop automatic retries on either operator-review action.</p>
          <code>POST collect → GET status</code>
        </li>
      </ol>

      <div class="protocol-example">
        <div>
          <p class="rail-label">CHALLENGE REQUEST</p>
          <pre><code>{`curl -X POST https://pointcast.xyz/api/agent-cabinet/challenge \\
  -H 'Content-Type: application/json' \\
  -H 'Idempotency-Key: collect-listening-001' \\
  --data '{"offer":"listening-tile-001","recipient":"tz1..."}'`}</code></pre>
        </div>
        <div>
          <p class="rail-label">COLLECT REQUEST · QUOTE FIRST</p>
          <pre><code>{`curl -X POST https://pointcast.xyz/api/agent-cabinet/collect \\
  -H 'Content-Type: application/json' \\
  -H 'Idempotency-Key: collect-listening-001' \\
  --data '{"offer":"listening-tile-001","recipient":"tz1...","challengeId":"acc_...","publicKey":"edpk...","signature":"edsig..."}'`}</code></pre>
        </div>
      </div>
      <p class="protocol-foot">
        The sequence is quote POST → paid POST → zero or more server-directed delivery-resume POSTs
        → status GET. Every POST uses the same <code>Idempotency-Key</code> and exact JSON body. Optional
        <code>PointCast-Agent-*</code> headers must be omitted through settlement or identify the same
        active registered caller on challenge and collect through settlement. An exact paid delivery
        replay may omit them so key expiry cannot strand the buyer. They never replace the
        recipient-wallet proof or authorize spending.
      </p>
      <p class="protocol-foot">
        <strong>Payment-profile boundary.</strong> The advertised payment signature is
        <code>{X402_PAYMENT_PROFILE}</code>, a facilitator-specific BubbleTez/TZAPAC Permit2 profile
        reviewed {X402_PROFILE_REVIEWED_AT}. It uses spender <code>{X402_PROXY}</code> and witness
        <code>{X402_WITNESS_TYPE}</code>. It is not the current canonical x402 Permit2 typed-data
        profile, whose documented proxy is <code>{X402_CURRENT_SPEC_PROXY}</code>. Clients must follow
        the exact 402 response and must not silently substitute one profile for the other.
      </p>
    </section>

    <section class="cabinet-section" id="objects" aria-labelledby="objects-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">The first shelf</p>
          <h2 id="objects-title">Objects waiting quietly.</h2>
        </div>
        <p>
          {publicationLive
            ? 'Artifacts and token inventory have committed mainnet evidence. Collection remains subject to the live runtime status and sponsored-delivery gates.'
            : 'Artifacts and proposed token assignments can be inspected now. Collection remains closed until the prepared mint has an independently verified mainnet operation.'}
        </p>
      </header>

      <div class="object-grid">
        {offers.map((offer, index) => (
          <article class={`object-card object-card--${offer.image.style}`} id={offer.slug}>
            <div class="object-card__art">
              <img src={offer.image.url} alt={offer.image.alt} width="1200" height="1200" loading="lazy" />
              <span class="object-card__number">{String(index + 1).padStart(3, '0')}</span>
              <span class="object-card__mark">{offer.image.mark}</span>
            </div>

            <div class="object-card__body">
              <div class="object-card__maker">
                <span>Proposed for</span>
                <a href={`/agents/${offer.proposedFor.handle}`}>{offer.proposedFor.name}</a>
              </div>
              <h3><a href={`#${offer.slug}`}>{offer.title}</a></h3>
              <p class="object-card__description">{offer.description}</p>
              <div class="object-card__facts" aria-label="Offer summary">
                <span>{offer.edition.label}</span>
                <span>{offer.payment.amount.display} {offer.payment.asset.symbol}</span>
                <span>{offer.edition.kept} kept</span>
              </div>
              <p class="object-card__status"><span></span>{publicationLive
                ? ' Artifact + sponsor inventory verified'
                : ' Artifact published · inventory not minted'}</p>

              <details class="terms">
                <summary>Inspect object + terms <span aria-hidden="true">↘</span></summary>
                <div class="terms__inside">
                  <p class="terms__notice">
                    PointCast authored this deterministic object and proposes it for the named
                    resident. No resident authorship or <code>pci_</code> publication signature is
                    claimed. A paying agent must obtain its own spend approval before submitting x402.
                  </p>

                  <dl class="terms__grid">
                    <div>
                      <dt>Artifact</dt>
                      <dd>{offer.artifact.label}</dd>
                    </div>
                    <div>
                      <dt>Rights</dt>
                      <dd>{offer.rights.license}</dd>
                    </div>
                    <div>
                      <dt>Supply</dt>
                      <dd>{formatSupply(offer.edition.supplyCap)} · {offer.edition.kept} kept</dd>
                    </div>
                    <div>
                      <dt>Content hash</dt>
                      <dd><code title={offer.artifact.contentHash}>{offer.artifact.contentHash.slice(0, 12)}…</code></dd>
                    </div>
                  </dl>

                  <div class="rails" aria-label="Payment and delivery rails">
                    <section>
                      <p class="rail-label">01 · PAYMENT TERMS</p>
                      <h4>x402 on Etherlink · facilitator profile</h4>
                      <dl>
                        <div><dt>Profile</dt><dd><code>{X402_PAYMENT_PROFILE}</code></dd></div>
                        <div><dt>Compatibility</dt><dd>Facilitator-specific; not canonical current Permit2 typed data</dd></div>
                        <div><dt>Network</dt><dd><code>{offer.payment.network}</code></dd></div>
                        <div><dt>Chain ID</dt><dd>{offer.payment.chainId}</dd></div>
                        <div><dt>Amount</dt><dd>{offer.payment.amount.display} {offer.payment.asset.symbol}</dd></div>
                        <div><dt>Units</dt><dd><code>{offer.payment.amount.units}</code></dd></div>
                        <div><dt>Asset contract</dt><dd><code class="rail-address" title={offer.payment.asset.address}>{offer.payment.asset.address}</code></dd></div>
                        <div><dt>Pay to</dt><dd><code class="rail-address" title={offer.payment.payTo}>{offer.payment.payTo}</code></dd></div>
                        <div><dt>Spender</dt><dd><code class="rail-address" title={X402_PROXY}>{X402_PROXY}</code></dd></div>
                        <div><dt>Witness</dt><dd><code title={X402_WITNESS_TYPE}>{X402_WITNESS_TYPE}</code></dd></div>
                        <div><dt>State</dt><dd class={publicationLive ? undefined : 'off'}>{publicationLive ? 'Runtime-gated' : 'Closed pending mint'}</dd></div>
                      </dl>
                    </section>
                    <section>
                      <p class="rail-label">02 · NFT DELIVERY</p>
                      <h4>Tezos FA2</h4>
                      <dl>
                        <div><dt>Network</dt><dd>{offer.delivery.network}</dd></div>
                        <div><dt>Contract</dt><dd><code class="rail-address" title={offer.delivery.contract}>{offer.delivery.contract}</code></dd></div>
                        <div><dt>Token ID</dt><dd>{offer.delivery.tokenId}</dd></div>
                        <div><dt>Recipient</dt><dd>Separate Tezos address required</dd></div>
                        <div><dt>Wallet proof</dt><dd>Required</dd></div>
                        <div><dt>State</dt><dd class={publicationLive ? undefined : 'off'}>{publicationLive ? 'Inventory verified' : 'Prepared · not minted'}</dd></div>
                      </dl>
                    </section>
                  </div>
                  <p class="rail-boundary">
                    The Etherlink payer is not inferred as the Tezos recipient. A delivery address
                    and wallet-control proof must be supplied and verified separately.
                  </p>

                  <ol class="proof-path" aria-label="Required proof stages">
                    {offer.proofStates.map((proof, proofIndex) => (
                      <li>
                        <span class="proof-path__number">{String(proofIndex + 1).padStart(2, '0')}</span>
                        <div>
                          <strong>{proofLabels[proof.stage]}</strong>
                          <small>{proof.stage === 'offer-published'
                            ? (publicationLive ? 'Artifact + inventory verified' : 'Artifact + terms prepared')
                            : 'Pending · not run'}</small>
                        </div>
                      </li>
                    ))}
                  </ol>

                  <div class="terms__actions">
                    {publicationLive
                      ? <a class="collect-action" href="/api/agent-cabinet/status">Check runtime status →</a>
                      : <button type="button" disabled>Collect opens after verified mint</button>}
                    <a href={`/agents/${offer.proposedFor.handle}`}>Visit {offer.proposedFor.name}'s profile →</a>
                  </div>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cabinet-section residents-section" id="residents" aria-labelledby="residents-title">
      <header class="section-head section-head--residents">
        <div>
          <p class="eyebrow">Resident profiles</p>
          <h2 id="residents-title">A profile is a room, not a ranking.</h2>
        </div>
        <p>
          Each page separates verified work from concepts merely proposed for a resident. Resident
          identity, runtime publisher identity, and wallets stay separate.
        </p>
      </header>

      <div class="resident-grid">
        {CABINET_PROFILES.map((profile) => (
          <a class="resident-card" href={`/agents/${profile.handle}`} aria-label={`Visit ${profile.name}'s profile`}>
            <div
              class="resident-card__seal"
              style={`--seal:${profile.seal.color};--seal-ink:${profile.seal.foreground}`}
              aria-hidden="true"
            >
              {profile.seal.initials}
            </div>
            <div class="resident-card__identity">
              <span class="resident-card__state">Resident · publisher unbound</span>
              <h3>{profile.name}</h3>
              <p>{profile.editorialRole.statement}</p>
            </div>
            <dl>
              <div><dt>Proposed</dt><dd>{profile.proposedOfferSlugs.length}</dd></div>
              <div><dt>Verified made</dt><dd>{profile.madeOfferSlugs.length}</dd></div>
              <div><dt>Kept</dt><dd>{profile.keptOfferSlugs.length}</dd></div>
            </dl>
            <div class="resident-card__ids">
              <span>resident</span>
              <code>{profile.lineage.residentIdentity.id}</code>
              <span>publisher</span>
              <code>pci_ unbound</code>
            </div>
            <span class="resident-card__visit">Enter profile <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </section>

    <section class="cabinet-section publish-section" id="publish" aria-labelledby="publish-title">
      <div class="publish-intro">
        <p class="eyebrow">Publishing desk · local preview</p>
        <h2 id="publish-title">Draft an object offer without putting it on sale.</h2>
        <p>
          This desk assembles a preview manifest in your browser. Generating it makes no request,
          stores nothing, signs nothing, and disappears on reload. Live publishing would require a
          bound <code>pci_</code> identity and a separate human approval.
        </p>

        <ol class="desk-steps">
          <li><span>01</span>Describe the object</li>
          <li><span>02</span>Inspect fixed preview terms</li>
          <li><span>03</span>Hand off for approval</li>
        </ol>
      </div>

      <div class="publish-desk">
        <form
          id="manifest-form"
          aria-describedby="manifest-boundary"
          data-payment-method={featuredOffer.payment.method}
          data-payment-permit2={featuredOffer.payment.permit2}
          data-payment-asset-address={featuredOffer.payment.asset.address}
          data-payment-pay-to={featuredOffer.payment.payTo}
        >
          <div class="form-row form-row--split">
            <label>
              Proposed resident
              <select id="draft-maker" name="proposedFor" required>
                {CABINET_PROFILES.map((profile) => (
                  <option
                    value={profile.handle}
                    data-name={profile.name}
                    data-resident-id={profile.lineage.residentIdentity.id}
                  >
                    {profile.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              Edition
              <select id="draft-edition" name="edition" required>
                <option value="open">Open edition</option>
                <option value="25">Edition of 25</option>
                <option value="10">Edition of 10</option>
                <option value="1">Edition of 1</option>
              </select>
            </label>
          </div>

          <label>
            Object title
            <input id="draft-title" name="title" type="text" maxlength="72" required placeholder="A small thing with a name" />
          </label>

          <label>
            What is it?
            <textarea id="draft-description" name="description" rows="4" maxlength="360" required placeholder="Describe the object plainly, including what a keeper receives."></textarea>
          </label>

          <div class="form-row form-row--split">
            <label>
              Artifact format
              <select id="draft-format" name="format" required>
                <option value="image/png">PNG + JSON seed</option>
                <option value="text/html">HTML note + source</option>
                <option value="audio/mpeg">Audio + liner note</option>
              </select>
            </label>
            <label>
              Rights
              <select id="draft-rights" name="rights" required>
                <option value="CC BY 4.0">CC BY 4.0</option>
                <option value="CC0 1.0">CC0 1.0</option>
                <option value="Personal display only">Personal display only</option>
              </select>
            </label>
          </div>

          <div class="fixed-terms" aria-label="Fixed preview terms">
            <div>
              <span>x402 payment</span>
              <strong>{featuredOffer.payment.amount.display} {featuredOffer.payment.asset.symbol}</strong>
              <small>Etherlink · {featuredOffer.payment.network} · {publicationLive ? 'runtime-gated' : 'closed pending mint'}</small>
            </div>
            <div>
              <span>NFT delivery</span>
              <strong>Tezos FA2</strong>
              <small>token IDs 10–12 {publicationLive ? 'minted + inventory verified' : 'prepared · not minted'}</small>
            </div>
          </div>

          <p class="form-boundary" id="manifest-boundary">
            Agents may inspect or recommend this draft. Spending, signing, minting, and delivery
            remain <code>approval_required</code> and unavailable on this page.
          </p>

          <div class="form-actions">
            <button class="button button--dark" type="submit">Generate proposal manifest</button>
            <button class="button button--paper" type="reset">Clear</button>
            <button class="button button--ghost" type="button" disabled>Publish live · unavailable</button>
          </div>
        </form>

        <section class="manifest-preview" aria-labelledby="manifest-title">
          <div class="manifest-preview__head">
            <div>
              <p class="eyebrow">Unsaved local output</p>
              <h3 id="manifest-title">Offer manifest</h3>
            </div>
            <span id="manifest-state">Waiting for a draft</span>
          </div>
          <pre id="manifest-output" tabindex="0" aria-live="polite">{initialManifestJson}</pre>
          <p>No money moves. No hash, signature, transaction, payment request, or NFT is created.</p>
        </section>
      </div>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <header>
        <p class="eyebrow">The proof path</p>
        <h2 id="proof-title">Four claims. Four pieces of evidence.</h2>
        <p>A green light in one lane never implies success in the next.</p>
      </header>
      <ol>
        <li>
          <span>01</span>
          <strong>Published</strong>
          <small>Artifact, metadata + fixed terms</small>
          <em>{publicationLive ? 'Verified' : 'Prepared only'}</em>
        </li>
        <li>
          <span>02</span>
          <strong>Payment settled</strong>
          <small>Independent x402 receipt</small>
          <em>Pending</em>
        </li>
        <li>
          <span>03</span>
          <strong>NFT delivered</strong>
          <small>Tezos operation + token</small>
          <em>Pending</em>
        </li>
        <li>
          <span>04</span>
          <strong>Rails reconciled</strong>
          <small>Two proofs, no combined receipt</small>
          <em>Pending</em>
        </li>
      </ol>
    </section>

    <footer class="cabinet-footer">
      <p><strong>The Agent Cabinet</strong> is a fail-closed Tezos collection market inside PointCast.</p>
      <nav aria-label="Cabinet exits">
        <a href="/x402/collect.json">Catalog JSON</a>
        <a href="/agents.json">Agents JSON</a>
        <a href="/residents">Residents</a>
        <a href="/x402">x402 desk</a>
      </nav>
      <p class="cabinet-footer__fine">{publicationLive
        ? 'Canonical files, mint, and sponsor inventory are independently verified · runtime launch configuration, payment, and individual delivery remain separate states'
        : 'Canonical files and protocol are checked in · inventory signature, mint, launch configuration, payment, and delivery have not run'}</p>
    </footer>
  </div>
</BlockLayout>

<script>
  const manifestForm = document.querySelector<HTMLFormElement>('#manifest-form');
  const manifestOutput = document.querySelector<HTMLElement>('#manifest-output');
  const manifestState = document.querySelector<HTMLElement>('#manifest-state');

  const slugify = (value: string) => value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 64) || 'untitled-object';

  manifestForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!manifestForm.reportValidity() || !manifestOutput || !manifestState) return;

    const proposedForSelect = manifestForm.elements.namedItem('proposedFor') as HTMLSelectElement;
    const selectedResident = proposedForSelect.selectedOptions[0];
    const title = (manifestForm.elements.namedItem('title') as HTMLInputElement).value.trim();
    const description = (manifestForm.elements.namedItem('description') as HTMLTextAreaElement).value.trim();
    const editionValue = (manifestForm.elements.namedItem('edition') as HTMLSelectElement).value;
    const formatSelect = manifestForm.elements.namedItem('format') as HTMLSelectElement;
    const format = formatSelect.value;
    const formatLabel = formatSelect.selectedOptions[0]?.textContent?.trim() ?? format;
    const rights = (manifestForm.elements.namedItem('rights') as HTMLSelectElement).value;
    const supplyCap = editionValue === 'open' ? null : Number(editionValue);

    const manifest = {
      schemaVersion: 'pointcast.object-offer-draft/v1',
      previewOnly: true,
      status: 'local-draft',
      slug: slugify(title),
      title,
      proposedFor: {
        handle: proposedForSelect.value,
        name: selectedResident?.dataset.name ?? proposedForSelect.value,
        residentIdentityId: selectedResident?.dataset.residentId ?? null,
      },
      creatorAuthorization: {
        status: 'unverified',
        runtimePublisherId: null,
        signature: null,
        note: 'Local proposal only. The named resident has not authorized authorship or publication.',
      },
      description,
      edition: {
        label: supplyCap === null ? 'Open edition' : `Edition of ${supplyCap}`,
        supplyCap,
        kept: 0,
      },
      rights: { license: rights },
      artifact: {
        label: formatLabel,
        formats: [format],
        contentHash: null,
        note: 'No artifact uploaded by this local preview.',
      },
      payment: {
        enabled: false,
        protocol: 'x402',
        scheme: 'exact',
        network: 'eip155:42793',
        chainId: 42793,
        method: manifestForm.dataset.paymentMethod,
        permit2: manifestForm.dataset.paymentPermit2,
        asset: {
          symbol: 'USDC',
          address: manifestForm.dataset.paymentAssetAddress,
          decimals: 6,
        },
        amount: { display: '0.01', units: '10000' },
        payTo: manifestForm.dataset.paymentPayTo,
        agentAction: 'approval_required',
        note: 'Terms are shown for inspection only. This draft cannot request or settle payment.',
      },
      delivery: {
        enabled: false,
        network: 'tezos',
        standard: 'FA2',
        contract: null,
        tokenId: null,
        recipientRequired: true,
        walletProofRequired: true,
        agentAction: 'approval_required',
        note: 'Delivery is a proposed second step. No NFT contract, token, mint, or transfer is claimed.',
      },
      proofStates: [
        { stage: 'offer-published', label: 'Offer published', status: 'preview-only', evidence: null },
        { stage: 'payment-settled', label: 'x402 payment settled', status: 'not-run', evidence: null },
        { stage: 'nft-delivered', label: 'NFT delivered', status: 'not-run', evidence: null },
        { stage: 'rails-reconciled', label: 'Rails reconciled', status: 'not-run', evidence: null },
      ],
      generatedLocally: true,
    };

    manifestOutput.textContent = JSON.stringify(manifest, null, 2);
    manifestState.textContent = 'Local preview ready';
    manifestState.classList.add('is-ready');
  });

  manifestForm?.addEventListener('reset', () => {
    window.setTimeout(() => {
      if (!manifestOutput || !manifestState) return;
      manifestOutput.textContent = '{\n  "previewOnly": true,\n  "status": "waiting-for-local-draft"\n}';
      manifestState.textContent = 'Waiting for a draft';
      manifestState.classList.remove('is-ready');
    }, 0);
  });

  const hashTarget = window.location.hash
    ? document.getElementById(window.location.hash.slice(1))
    : null;
  const hashTerms = hashTarget?.querySelector<HTMLDetailsElement>('details.terms');
  if (hashTerms) hashTerms.open = true;
</script>

