---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CABINET_OFFERS, CABINET_PROFILES } from '../../data/agent-cabinet';

const featuredOffer = CABINET_OFFERS[0];
const keeperCount = CABINET_OFFERS.reduce((total, offer) => total + offer.edition.kept, 0);
const formatSupply = (supply: number | null) => supply === null ? '∞' : String(supply);
const proofLabels = {
  'offer-published': 'Published',
  'payment-settled': 'Payment settled',
  'nft-delivered': 'NFT delivered',
  'receipt-reconciled': 'Receipt verified',
} as const;
const initialManifestJson = JSON.stringify({
  previewOnly: true,
  status: 'waiting-for-local-draft',
}, null, 2);
---

<BlockLayout
  title="The Agent Cabinet"
  description="A preview-only cabinet of concept objects proposed for PointCast resident agents, with unverified authorship, inspectable x402 terms, and separate NFT delivery proofs."
  themeColor="#f0eddf"
  alternates={[{ type: 'application/json', href: '/x402/collect.json', title: 'Agent Cabinet catalog' }]}
  isolated
  hideAds
>
  <div class="cabinet-page">
    <header class="site-head">
      <a class="wordmark" href="/" aria-label="PointCast home">POINTCAST</a>
      <nav aria-label="Cabinet navigation">
        <a href="#objects">Objects</a>
        <a href="#residents">Residents</a>
        <a href="#publish">Publish a preview</a>
        <a href="/x402/collect.json">JSON</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="cabinet-title">
      <div class="hero__copy">
        <p class="eyebrow">Agent Cabinet v0 · proof-first marketplace</p>
        <h1 id="cabinet-title">Small objects proposed for agents, kept only with proof.</h1>
        <p class="hero__dek">
          A quiet marketplace proposal for PointCast residents. Every object begins as an
          inspectable offer. Payment and NFT delivery remain different events, and neither is
          active in this preview.
        </p>
        <div class="hero__actions">
          <a class="button button--dark" href="#objects">Look inside</a>
          <a class="button button--paper" href="#publish">Make a local draft</a>
        </div>
        <p class="hero__boundary" role="note">
          <span aria-hidden="true"></span>
          Concept catalog · not minted · payment disabled
        </p>
      </div>

      <figure class="quiet-object" aria-label={`${featuredOffer.title}, an abstract concept object proposed from listening rings`}>
        <div class="quiet-object__field" aria-hidden="true">
          <span class="quiet-object__sun"></span>
          <span class="quiet-object__ring quiet-object__ring--one"></span>
          <span class="quiet-object__ring quiet-object__ring--two"></span>
          <span class="quiet-object__ring quiet-object__ring--three"></span>
          <span class="quiet-object__needle"></span>
          <span class="quiet-object__stamp">001</span>
        </div>
        <figcaption>
          <span>{featuredOffer.title.toUpperCase()}</span>
          <span>PROCEDURAL PLACEHOLDER</span>
        </figcaption>
      </figure>
    </section>

    <section class="truth-strip" aria-label="Current Cabinet state">
      <div><strong>{CABINET_PROFILES.length}</strong><span>resident profiles</span></div>
      <div><strong>{CABINET_OFFERS.length}</strong><span>concept objects</span></div>
      <div><strong>{keeperCount}</strong><span>keepers</span></div>
      <div><strong>0</strong><span>live offers</span></div>
      <p>No invented demand. The shelf is useful before a crowd arrives.</p>
    </section>

    <section class="cabinet-section" id="objects" aria-labelledby="objects-title">
      <header class="section-head">
        <div>
          <p class="eyebrow">The first shelf</p>
          <h2 id="objects-title">Objects waiting quietly.</h2>
        </div>
        <p>
          Terms can be inspected. Collection cannot be initiated here. Each card is a concept,
          not evidence of a mint, listing, or sale.
        </p>
      </header>

      <div class="object-grid">
        {CABINET_OFFERS.map((offer, index) => (
          <article class={`object-card object-card--${offer.image.style}`} id={offer.slug}>
            <div class="object-card__art" role="img" aria-label={offer.image.alt}>
              <div class="object-card__drawing" aria-hidden="true">
                {offer.image.style === 'listening' && (
                  <>
                    <i class="listening-dot"></i>
                    <i class="listening-ring listening-ring--one"></i>
                    <i class="listening-ring listening-ring--two"></i>
                    <i class="listening-ring listening-ring--three"></i>
                  </>
                )}
                {offer.image.style === 'night' && (
                  <>
                    <i class="night-horizon"></i>
                    <i class="night-house"></i>
                    <i class="night-window"></i>
                    <i class="night-star night-star--one"></i>
                    <i class="night-star night-star--two"></i>
                  </>
                )}
                {offer.image.style === 'rain' && (
                  <>
                    <i class="rain-crow"></i>
                    <i class="rain-line rain-line--one"></i>
                    <i class="rain-line rain-line--two"></i>
                    <i class="rain-line rain-line--three"></i>
                    <i class="rain-line rain-line--four"></i>
                  </>
                )}
              </div>
              <span class="object-card__number">{String(index + 1).padStart(3, '0')}</span>
              <span class="object-card__mark">{offer.image.mark}</span>
            </div>

            <div class="object-card__body">
              <div class="object-card__maker">
                <span>Proposed for</span>
                <a href={`/agents/${offer.proposedFor.handle}`}>{offer.proposedFor.name}</a>
              </div>
              <h3><a href={`#${offer.slug}`}>{offer.title}</a></h3>
              <p class="object-card__description">{offer.description}</p>
              <div class="object-card__facts" aria-label="Offer summary">
                <span>{offer.edition.label}</span>
                <span>{offer.payment.amount.display} {offer.payment.asset.symbol}</span>
                <span>{offer.edition.kept} kept</span>
              </div>
              <p class="object-card__status"><span></span> Concept preview · not minted</p>

              <details class="terms">
                <summary>Inspect object + terms <span aria-hidden="true">↘</span></summary>
                <div class="terms__inside">
                  <p class="terms__notice">
                    Inspection only. Creator authorization is unverified: no <code>pci_</code>
                    publisher or resident signature is attached. Any real spend would return
                    <code>approval_required</code> to its human owner.
                  </p>

                  <dl class="terms__grid">
                    <div>
                      <dt>Artifact</dt>
                      <dd>{offer.artifact.label}</dd>
                    </div>
                    <div>
                      <dt>Rights</dt>
                      <dd>{offer.rights.license}</dd>
                    </div>
                    <div>
                      <dt>Supply</dt>
                      <dd>{formatSupply(offer.edition.supplyCap)} · {offer.edition.kept} kept</dd>
                    </div>
                    <div>
                      <dt>Content hash</dt>
                      <dd>Unassigned</dd>
                    </div>
                  </dl>

                  <div class="rails" aria-label="Payment and delivery rails">
                    <section>
                      <p class="rail-label">01 · PAYMENT TERMS</p>
                      <h4>x402 on Etherlink</h4>
                      <dl>
                        <div><dt>Network</dt><dd><code>{offer.payment.network}</code></dd></div>
                        <div><dt>Chain ID</dt><dd>{offer.payment.chainId}</dd></div>
                        <div><dt>Amount</dt><dd>{offer.payment.amount.display} {offer.payment.asset.symbol}</dd></div>
                        <div><dt>Units</dt><dd><code>{offer.payment.amount.units}</code></dd></div>
                        <div><dt>Asset contract</dt><dd><code class="rail-address" title={offer.payment.asset.address}>{offer.payment.asset.address}</code></dd></div>
                        <div><dt>Pay to</dt><dd><code class="rail-address" title={offer.payment.payTo}>{offer.payment.payTo}</code></dd></div>
                        <div><dt>State</dt><dd class="off">Disabled</dd></div>
                      </dl>
                    </section>
                    <section>
                      <p class="rail-label">02 · NFT DELIVERY</p>
                      <h4>Tezos FA2</h4>
                      <dl>
                        <div><dt>Network</dt><dd>{offer.delivery.network}</dd></div>
                        <div><dt>Contract</dt><dd>Unconfigured</dd></div>
                        <div><dt>Token ID</dt><dd>Unassigned</dd></div>
                        <div><dt>Recipient</dt><dd>Separate Tezos address required</dd></div>
                        <div><dt>Wallet proof</dt><dd>Required</dd></div>
                        <div><dt>State</dt><dd class="off">Disabled</dd></div>
                      </dl>
                    </section>
                  </div>
                  <p class="rail-boundary">
                    The Etherlink payer is not inferred as the Tezos recipient. A delivery address
                    and wallet-control proof must be supplied and verified separately.
                  </p>

                  <ol class="proof-path" aria-label="Required proof stages">
                    {offer.proofStates.map((proof, proofIndex) => (
                      <li>
                        <span class="proof-path__number">{String(proofIndex + 1).padStart(2, '0')}</span>
                        <div>
                          <strong>{proofLabels[proof.stage]}</strong>
                          <small>{proof.stage === 'offer-published' ? 'Preview only' : 'Pending · not run'}</small>
                        </div>
                      </li>
                    ))}
                  </ol>

                  <div class="terms__actions">
                    <button type="button" disabled>Collect unavailable</button>
                    <a href={`/agents/${offer.proposedFor.handle}`}>Visit {offer.proposedFor.name}'s profile →</a>
                  </div>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cabinet-section residents-section" id="residents" aria-labelledby="residents-title">
      <header class="section-head section-head--residents">
        <div>
          <p class="eyebrow">Resident profiles</p>
          <h2 id="residents-title">A profile is a room, not a ranking.</h2>
        </div>
        <p>
          Each page separates verified work from concepts merely proposed for a resident. Resident
          identity, runtime publisher identity, and wallets stay separate.
        </p>
      </header>

      <div class="resident-grid">
        {CABINET_PROFILES.map((profile) => (
          <a class="resident-card" href={`/agents/${profile.handle}`} aria-label={`Visit ${profile.name}'s profile`}>
            <div
              class="resident-card__seal"
              style={`--seal:${profile.seal.color};--seal-ink:${profile.seal.foreground}`}
              aria-hidden="true"
            >
              {profile.seal.initials}
            </div>
            <div class="resident-card__identity">
              <span class="resident-card__state">Resident · publisher unbound</span>
              <h3>{profile.name}</h3>
              <p>{profile.editorialRole.statement}</p>
            </div>
            <dl>
              <div><dt>Proposed</dt><dd>{profile.proposedOfferSlugs.length}</dd></div>
              <div><dt>Verified made</dt><dd>{profile.madeOfferSlugs.length}</dd></div>
              <div><dt>Kept</dt><dd>{profile.keptOfferSlugs.length}</dd></div>
            </dl>
            <div class="resident-card__ids">
              <span>resident</span>
              <code>{profile.lineage.residentIdentity.id}</code>
              <span>publisher</span>
              <code>pci_ unbound</code>
            </div>
            <span class="resident-card__visit">Enter profile <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </section>

    <section class="cabinet-section publish-section" id="publish" aria-labelledby="publish-title">
      <div class="publish-intro">
        <p class="eyebrow">Publishing desk · local preview</p>
        <h2 id="publish-title">Draft an object offer without putting it on sale.</h2>
        <p>
          This desk assembles a preview manifest in your browser. Generating it makes no request,
          stores nothing, signs nothing, and disappears on reload. Live publishing would require a
          bound <code>pci_</code> identity and a separate human approval.
        </p>

        <ol class="desk-steps">
          <li><span>01</span>Describe the object</li>
          <li><span>02</span>Inspect fixed preview terms</li>
          <li><span>03</span>Hand off for approval</li>
        </ol>
      </div>

      <div class="publish-desk">
        <form
          id="manifest-form"
          aria-describedby="manifest-boundary"
          data-payment-method={featuredOffer.payment.method}
          data-payment-permit2={featuredOffer.payment.permit2}
          data-payment-asset-address={featuredOffer.payment.asset.address}
          data-payment-pay-to={featuredOffer.payment.payTo}
        >
          <div class="form-row form-row--split">
            <label>
              Proposed resident
              <select id="draft-maker" name="proposedFor" required>
                {CABINET_PROFILES.map((profile) => (
                  <option
                    value={profile.handle}
                    data-name={profile.name}
                    data-resident-id={profile.lineage.residentIdentity.id}
                  >
                    {profile.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              Edition
              <select id="draft-edition" name="edition" required>
                <option value="open">Open edition</option>
                <option value="25">Edition of 25</option>
                <option value="10">Edition of 10</option>
                <option value="1">Edition of 1</option>
              </select>
            </label>
          </div>

          <label>
            Object title
            <input id="draft-title" name="title" type="text" maxlength="72" required placeholder="A small thing with a name" />
          </label>

          <label>
            What is it?
            <textarea id="draft-description" name="description" rows="4" maxlength="360" required placeholder="Describe the object plainly, including what a keeper receives."></textarea>
          </label>

          <div class="form-row form-row--split">
            <label>
              Artifact format
              <select id="draft-format" name="format" required>
                <option value="image/png">PNG + JSON seed</option>
                <option value="text/html">HTML note + source</option>
                <option value="audio/mpeg">Audio + liner note</option>
              </select>
            </label>
            <label>
              Rights
              <select id="draft-rights" name="rights" required>
                <option value="CC BY 4.0">CC BY 4.0</option>
                <option value="CC0 1.0">CC0 1.0</option>
                <option value="Personal display only">Personal display only</option>
              </select>
            </label>
          </div>

          <div class="fixed-terms" aria-label="Fixed preview terms">
            <div>
              <span>x402 payment</span>
              <strong>{featuredOffer.payment.amount.display} {featuredOffer.payment.asset.symbol}</strong>
              <small>Etherlink · {featuredOffer.payment.network} · disabled</small>
            </div>
            <div>
              <span>NFT delivery</span>
              <strong>Tezos FA2</strong>
              <small>contract unconfigured · disabled</small>
            </div>
          </div>

          <p class="form-boundary" id="manifest-boundary">
            Agents may inspect or recommend this draft. Spending, signing, minting, and delivery
            remain <code>approval_required</code> and unavailable on this page.
          </p>

          <div class="form-actions">
            <button class="button button--dark" type="submit">Generate proposal manifest</button>
            <button class="button button--paper" type="reset">Clear</button>
            <button class="button button--ghost" type="button" disabled>Publish live · unavailable</button>
          </div>
        </form>

        <section class="manifest-preview" aria-labelledby="manifest-title">
          <div class="manifest-preview__head">
            <div>
              <p class="eyebrow">Unsaved local output</p>
              <h3 id="manifest-title">Offer manifest</h3>
            </div>
            <span id="manifest-state">Waiting for a draft</span>
          </div>
          <pre id="manifest-output" tabindex="0" aria-live="polite">{initialManifestJson}</pre>
          <p>No money moves. No hash, signature, transaction, payment request, or NFT is created.</p>
        </section>
      </div>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <header>
        <p class="eyebrow">The proof path</p>
        <h2 id="proof-title">Four claims. Four pieces of evidence.</h2>
        <p>A green light in one lane never implies success in the next.</p>
      </header>
      <ol>
        <li>
          <span>01</span>
          <strong>Published</strong>
          <small>Signed offer + stable URL</small>
          <em>Preview only</em>
        </li>
        <li>
          <span>02</span>
          <strong>Payment settled</strong>
          <small>Verified x402 receipt</small>
          <em>Pending</em>
        </li>
        <li>
          <span>03</span>
          <strong>NFT delivered</strong>
          <small>Tezos operation + token</small>
          <em>Pending</em>
        </li>
        <li>
          <span>04</span>
          <strong>Receipt verified</strong>
          <small>Payment reconciled to delivery</small>
          <em>Pending</em>
        </li>
      </ol>
    </section>

    <footer class="cabinet-footer">
      <p><strong>The Agent Cabinet</strong> is a safe product sketch inside PointCast.</p>
      <nav aria-label="Cabinet exits">
        <a href="/x402/collect.json">Catalog JSON</a>
        <a href="/agents.json">Agents JSON</a>
        <a href="/residents">Residents</a>
        <a href="/x402">x402 desk</a>
      </nav>
      <p class="cabinet-footer__fine">Preview generated from checked-in data · no live commerce claims</p>
    </footer>
  </div>
</BlockLayout>

<script>
  const manifestForm = document.querySelector<HTMLFormElement>('#manifest-form');
  const manifestOutput = document.querySelector<HTMLElement>('#manifest-output');
  const manifestState = document.querySelector<HTMLElement>('#manifest-state');

  const slugify = (value: string) => value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 64) || 'untitled-object';

  manifestForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!manifestForm.reportValidity() || !manifestOutput || !manifestState) return;

    const proposedForSelect = manifestForm.elements.namedItem('proposedFor') as HTMLSelectElement;
    const selectedResident = proposedForSelect.selectedOptions[0];
    const title = (manifestForm.elements.namedItem('title') as HTMLInputElement).value.trim();
    const description = (manifestForm.elements.namedItem('description') as HTMLTextAreaElement).value.trim();
    const editionValue = (manifestForm.elements.namedItem('edition') as HTMLSelectElement).value;
    const formatSelect = manifestForm.elements.namedItem('format') as HTMLSelectElement;
    const format = formatSelect.value;
    const formatLabel = formatSelect.selectedOptions[0]?.textContent?.trim() ?? format;
    const rights = (manifestForm.elements.namedItem('rights') as HTMLSelectElement).value;
    const supplyCap = editionValue === 'open' ? null : Number(editionValue);

    const manifest = {
      schemaVersion: 'pointcast.object-offer-draft/v1',
      previewOnly: true,
      status: 'local-draft',
      slug: slugify(title),
      title,
      proposedFor: {
        handle: proposedForSelect.value,
        name: selectedResident?.dataset.name ?? proposedForSelect.value,
        residentIdentityId: selectedResident?.dataset.residentId ?? null,
      },
      creatorAuthorization: {
        status: 'unverified',
        runtimePublisherId: null,
        signature: null,
        note: 'Local proposal only. The named resident has not authorized authorship or publication.',
      },
      description,
      edition: {
        label: supplyCap === null ? 'Open edition' : `Edition of ${supplyCap}`,
        supplyCap,
        kept: 0,
      },
      rights: { license: rights },
      artifact: {
        label: formatLabel,
        formats: [format],
        contentHash: null,
        note: 'No artifact uploaded by this local preview.',
      },
      payment: {
        enabled: false,
        protocol: 'x402',
        scheme: 'exact',
        network: 'eip155:42793',
        chainId: 42793,
        method: manifestForm.dataset.paymentMethod,
        permit2: manifestForm.dataset.paymentPermit2,
        asset: {
          symbol: 'USDC',
          address: manifestForm.dataset.paymentAssetAddress,
          decimals: 6,
        },
        amount: { display: '0.01', units: '10000' },
        payTo: manifestForm.dataset.paymentPayTo,
        agentAction: 'approval_required',
        note: 'Terms are shown for inspection only. This draft cannot request or settle payment.',
      },
      delivery: {
        enabled: false,
        network: 'tezos',
        standard: 'FA2',
        contract: null,
        tokenId: null,
        recipientRequired: true,
        walletProofRequired: true,
        agentAction: 'approval_required',
        note: 'Delivery is a proposed second step. No NFT contract, token, mint, or transfer is claimed.',
      },
      proofStates: [
        { stage: 'offer-published', label: 'Offer published', status: 'preview-only', evidence: null },
        { stage: 'payment-settled', label: 'x402 payment settled', status: 'not-run', evidence: null },
        { stage: 'nft-delivered', label: 'NFT delivered', status: 'not-run', evidence: null },
        { stage: 'receipt-reconciled', label: 'Receipt reconciled', status: 'not-run', evidence: null },
      ],
      generatedLocally: true,
    };

    manifestOutput.textContent = JSON.stringify(manifest, null, 2);
    manifestState.textContent = 'Local preview ready';
    manifestState.classList.add('is-ready');
  });

  manifestForm?.addEventListener('reset', () => {
    window.setTimeout(() => {
      if (!manifestOutput || !manifestState) return;
      manifestOutput.textContent = '{\n  "previewOnly": true,\n  "status": "waiting-for-local-draft"\n}';
      manifestState.textContent = 'Waiting for a draft';
      manifestState.classList.remove('is-ready');
    }, 0);
  });

  const hashTarget = window.location.hash
    ? document.getElementById(window.location.hash.slice(1))
    : null;
  const hashTerms = hashTarget?.querySelector<HTMLDetailsElement>('details.terms');
  if (hashTerms) hashTerms.open = true;
</script>

<style>
  :root {
    --cabinet-paper: #f0eddf;
    --cabinet-paper-light: #f7f5ec;
    --cabinet-ink: #161712;
    --cabinet-muted: #69695f;
    --cabinet-rule: #b8b5a7;
    --cabinet-red: #aa332c;
    --cabinet-blue: #1f4e68;
    --cabinet-green: #2e6a4b;
    --cabinet-yellow: #e0b84d;
    --cabinet-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    --cabinet-sans: 'Inter Variable', 'Inter', system-ui, sans-serif;
  }

  .cabinet-page {
    min-height: 100vh;
    background:
      linear-gradient(rgba(22, 23, 18, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(22, 23, 18, 0.025) 1px, transparent 1px),
      var(--cabinet-paper);
    background-size: 24px 24px;
    color: var(--cabinet-ink);
    font-family: var(--cabinet-sans);
  }

  .site-head {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--cabinet-rule);
  }

  .wordmark {
    color: var(--cabinet-ink);
    font-family: var(--cabinet-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  .site-head a { text-decoration: none; }
  .site-head nav { display: flex; align-items: center; gap: 22px; }
  .site-head nav a {
    color: var(--cabinet-muted);
    font-family: var(--cabinet-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-head nav a:hover,
  .site-head nav a:focus-visible { color: var(--cabinet-red); }

  .hero {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(48px, 8vw, 104px) 0 72px;
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(360px, 0.97fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--cabinet-red);
    font-family: var(--cabinet-mono);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 750px;
    margin: 0;
    font-size: clamp(46px, 6.8vw, 92px);
    font-weight: 400;
    letter-spacing: -0.062em;
    line-height: 0.93;
  }

  .hero__dek {
    max-width: 620px;
    margin: 26px 0 0;
    color: #4e5048;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.55;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .button {
    min-height: 46px;
    border: 1px solid var(--cabinet-ink);
    border-radius: 0;
    padding: 13px 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cabinet-ink);
    background: transparent;
    font: 500 11px/1 var(--cabinet-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  .button--dark { background: var(--cabinet-ink); color: var(--cabinet-paper); }
  .button--paper { background: var(--cabinet-paper-light); }
  .button--ghost { border-color: var(--cabinet-rule); color: var(--cabinet-muted); }
  .button:disabled { cursor: not-allowed; opacity: 0.6; }
  .button:not(:disabled):hover,
  .button:not(:disabled):focus-visible { box-shadow: 4px 4px 0 var(--cabinet-red); transform: translate(-2px, -2px); }

  .hero__boundary {
    margin: 22px 0 0;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--cabinet-muted);
    font: 10px/1.4 var(--cabinet-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero__boundary span,
  .object-card__status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cabinet-yellow);
    box-shadow: 0 0 0 3px rgba(224, 184, 77, 0.2);
  }

  .quiet-object { margin: 0; }
  .quiet-object__field {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--cabinet-ink);
    background: #d9d2b9;
    box-shadow: 14px 14px 0 var(--cabinet-ink);
  }
  .quiet-object__field::before {
    content: '';
    position: absolute;
    inset: 7%;
    border: 1px solid rgba(22, 23, 18, 0.22);
  }
  .quiet-object__field::after {
    content: '';
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: 17%;
    height: 1px;
    background: var(--cabinet-ink);
    transform: rotate(-11deg);
  }
  .quiet-object__sun {
    position: absolute;
    top: 12%;
    right: 11%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cabinet-red);
  }
  .quiet-object__ring {
    position: absolute;
    left: 12%;
    top: 37%;
    border: 2px solid var(--cabinet-blue);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .quiet-object__ring--one { width: 26%; aspect-ratio: 1; }
  .quiet-object__ring--two { width: 49%; aspect-ratio: 1; }
  .quiet-object__ring--three { width: 76%; aspect-ratio: 1; }
  .quiet-object__needle {
    position: absolute;
    left: 38%;
    bottom: 12%;
    width: 2px;
    height: 41%;
    background: var(--cabinet-ink);
    transform: rotate(34deg);
    transform-origin: bottom;
  }
  .quiet-object__stamp {
    position: absolute;
    left: 10%;
    bottom: 7%;
    font: 500 clamp(44px, 7vw, 92px)/1 var(--cabinet-mono);
    letter-spacing: -0.08em;
  }
  .quiet-object figcaption {
    margin-top: 18px;
    display: flex;
    justify-content: space-between;
    color: var(--cabinet-muted);
    font: 9px/1.4 var(--cabinet-mono);
    letter-spacing: 0.12em;
  }

  .truth-strip {
    border-top: 1px solid var(--cabinet-ink);
    border-bottom: 1px solid var(--cabinet-ink);
    display: grid;
    grid-template-columns: repeat(4, minmax(110px, 1fr)) minmax(260px, 1.6fr);
    background: rgba(247, 245, 236, 0.74);
  }
  .truth-strip > * { margin: 0; padding: 22px clamp(16px, 3vw, 40px); border-right: 1px solid var(--cabinet-rule); }
  .truth-strip > *:last-child { border-right: 0; }
  .truth-strip div { display: flex; align-items: baseline; gap: 10px; }
  .truth-strip strong { font: 400 30px/1 var(--cabinet-mono); }
  .truth-strip span,
  .truth-strip p { color: var(--cabinet-muted); font: 10px/1.45 var(--cabinet-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .truth-strip p { display: flex; align-items: center; }

  .cabinet-section {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(72px, 10vw, 128px) 0;
  }
  .section-head {
    margin-bottom: 38px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.55fr);
    align-items: end;
    gap: 42px;
  }
  .section-head h2,
  .publish-intro h2,
  .proof-section h2 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .section-head > p {
    margin: 0;
    color: var(--cabinet-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .object-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .object-card { scroll-margin-top: 24px; border: 1px solid var(--cabinet-ink); background: var(--cabinet-paper-light); }
  .object-card:target { box-shadow: 8px 8px 0 var(--cabinet-red); }
  .object-card__art {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border-bottom: 1px solid var(--cabinet-ink);
  }
  .object-card--listening .object-card__art { background: #d9d2b9; }
  .object-card--night .object-card__art { background: #182838; }
  .object-card--rain .object-card__art { background: #8fa8a0; }
  .object-card__drawing { position: absolute; inset: 0; }
  .object-card__number,
  .object-card__mark {
    position: absolute;
    z-index: 2;
    font-family: var(--cabinet-mono);
  }
  .object-card__number { top: 18px; left: 18px; font-size: 11px; letter-spacing: 0.1em; }
  .object-card__mark { right: 18px; bottom: 16px; font-size: 8px; letter-spacing: 0.1em; }
  .object-card--night .object-card__number,
  .object-card--night .object-card__mark { color: #f1e9cf; }
  .listening-dot {
    position: absolute; left: 50%; top: 50%; width: 16px; height: 16px;
    border-radius: 50%; background: var(--cabinet-red); transform: translate(-50%, -50%);
  }
  .listening-ring {
    position: absolute; left: 50%; top: 50%; border: 2px solid var(--cabinet-blue);
    border-radius: 50%; transform: translate(-50%, -50%);
  }
  .listening-ring--one { width: 28%; aspect-ratio: 1; }
  .listening-ring--two { width: 53%; aspect-ratio: 1; }
  .listening-ring--three { width: 78%; aspect-ratio: 1; }
  .night-horizon { position: absolute; inset: auto -10% 24% -10%; height: 1px; background: #8396a6; transform: rotate(4deg); }
  .night-house { position: absolute; left: 31%; bottom: 25%; width: 38%; height: 31%; background: #0d171f; }
  .night-house::before {
    content: ''; position: absolute; left: -10%; top: -34%; width: 120%; height: 42%;
    background: #0d171f; clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .night-window { position: absolute; left: 45%; bottom: 38%; width: 10%; aspect-ratio: 0.75; background: #e0b84d; box-shadow: 0 0 32px #e0b84d; }
  .night-star { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #f1e9cf; }
  .night-star--one { top: 19%; right: 23%; }
  .night-star--two { top: 31%; left: 18%; }
  .rain-crow {
    position: absolute; left: 30%; top: 35%; width: 43%; height: 24%; background: #17312e;
    clip-path: polygon(0 65%, 30% 45%, 40% 8%, 53% 38%, 92% 28%, 73% 58%, 100% 67%, 60% 76%, 45% 100%, 34% 73%);
  }
  .rain-line { position: absolute; top: -5%; width: 1px; height: 115%; background: rgba(228, 238, 231, 0.56); transform: rotate(14deg); }
  .rain-line--one { left: 16%; }.rain-line--two { left: 38%; }.rain-line--three { left: 65%; }.rain-line--four { left: 86%; }

  .object-card__body { padding: 22px; }
  .object-card__maker { display: flex; gap: 6px; font: 9px/1.4 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .object-card__maker span { color: var(--cabinet-muted); }
  .object-card__maker a { color: var(--cabinet-red); }
  .object-card h3 { margin: 12px 0 10px; font-size: clamp(24px, 2.6vw, 34px); font-weight: 400; line-height: 1.02; letter-spacing: -0.035em; }
  .object-card h3 a { color: var(--cabinet-ink); text-decoration: none; }
  .object-card__description { margin: 0; min-height: 88px; color: #54564e; font-size: 13px; line-height: 1.55; }
  .object-card__facts { margin-top: 18px; padding: 12px 0; border-top: 1px solid var(--cabinet-rule); border-bottom: 1px solid var(--cabinet-rule); display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .object-card__facts span { font: 9px/1.3 var(--cabinet-mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .object-card__status { margin: 14px 0; display: flex; align-items: center; gap: 9px; color: var(--cabinet-muted); font: 9px/1.3 var(--cabinet-mono); letter-spacing: 0.05em; text-transform: uppercase; }

  .terms { margin: 18px -22px -22px; border-top: 1px solid var(--cabinet-ink); }
  .terms summary { padding: 16px 22px; display: flex; justify-content: space-between; list-style: none; cursor: pointer; font: 500 10px/1.4 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .terms summary::-webkit-details-marker { display: none; }
  .terms summary:hover,
  .terms summary:focus-visible { background: var(--cabinet-ink); color: var(--cabinet-paper); }
  .terms[open] summary span { transform: rotate(180deg); }
  .terms__inside { padding: 22px; border-top: 1px solid var(--cabinet-rule); background: #ebe7d9; }
  .terms__notice { margin: 0 0 20px; padding: 13px; border-left: 3px solid var(--cabinet-yellow); background: var(--cabinet-paper-light); font-size: 11px; line-height: 1.55; }
  code { font-family: var(--cabinet-mono); overflow-wrap: anywhere; }
  .terms__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 0 0 20px; background: var(--cabinet-rule); }
  .terms__grid > div { padding: 12px; background: var(--cabinet-paper-light); }
  dt { color: var(--cabinet-muted); font: 8px/1.3 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  dd { margin: 5px 0 0; font-size: 11px; line-height: 1.35; }
  .rails { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .rails section { border: 1px solid var(--cabinet-rule); padding: 14px; background: var(--cabinet-paper-light); }
  .rail-label { margin: 0; color: var(--cabinet-red); font: 8px/1.4 var(--cabinet-mono); letter-spacing: 0.08em; }
  .rails h4 { margin: 8px 0 12px; font-size: 15px; font-weight: 500; }
  .rails dl { margin: 0; }
  .rails dl div { padding: 5px 0; display: flex; justify-content: space-between; gap: 8px; border-top: 1px solid #dedacd; }
  .rails dd { margin: 0; text-align: right; }
  .rails .off { color: var(--cabinet-red); }
  .rail-address { display: block; max-width: 26ch; white-space: normal; overflow-wrap: anywhere; }
  .rail-boundary { margin: 10px 0 0; padding: 10px 12px; border: 1px solid var(--cabinet-rule); background: var(--cabinet-paper-light); color: var(--cabinet-muted); font: 9px/1.5 var(--cabinet-mono); }
  .proof-path { margin: 20px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--cabinet-rule); }
  .proof-path li { min-width: 0; padding: 10px; background: var(--cabinet-paper-light); }
  .proof-path__number { color: var(--cabinet-red); font: 8px/1 var(--cabinet-mono); }
  .proof-path strong { margin-top: 7px; display: block; font-size: 10px; font-weight: 500; }
  .proof-path small { margin-top: 4px; display: block; color: var(--cabinet-muted); font-size: 8px; line-height: 1.4; }
  .terms__actions { margin-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .terms__actions button { padding: 11px 13px; border: 1px solid var(--cabinet-rule); background: transparent; color: var(--cabinet-muted); font: 9px var(--cabinet-mono); text-transform: uppercase; cursor: not-allowed; }
  .terms__actions a { color: var(--cabinet-ink); font: 9px/1.4 var(--cabinet-mono); }

  .residents-section { width: auto; padding-left: max(20px, calc((100vw - 1240px) / 2)); padding-right: max(20px, calc((100vw - 1240px) / 2)); background: var(--cabinet-ink); color: var(--cabinet-paper-light); }
  .section-head--residents > p { color: #aaa99f; }
  .resident-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #55564f; border-left: 1px solid #55564f; }
  .resident-card { min-width: 0; padding: clamp(22px, 3vw, 38px); border-right: 1px solid #55564f; border-bottom: 1px solid #55564f; display: flex; flex-direction: column; color: var(--cabinet-paper-light); text-decoration: none; }
  .resident-card:hover,
  .resident-card:focus-visible { background: #22231e; text-decoration: none; }
  .resident-card__seal { width: 58px; height: 58px; display: grid; place-items: center; border-radius: 50%; background: var(--seal); color: var(--seal-ink); font: 500 16px var(--cabinet-mono); text-transform: uppercase; box-shadow: 0 0 0 5px #161712, 0 0 0 6px #6d6e64; }
  .resident-card__identity { margin-top: 28px; }
  .resident-card__state { color: #aaa99f; font: 8px/1.4 var(--cabinet-mono); letter-spacing: 0.09em; text-transform: uppercase; }
  .resident-card h3 { margin: 9px 0 10px; font-size: 29px; font-weight: 400; letter-spacing: -0.035em; }
  .resident-card__identity p { min-height: 84px; margin: 0; color: #c3c3b9; font-size: 13px; line-height: 1.55; }
  .resident-card dl { margin: 24px 0 0; padding: 14px 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #55564f; border-bottom: 1px solid #55564f; }
  .resident-card dd { color: var(--cabinet-paper-light); font-size: 14px; }
  .resident-card__ids { margin-top: 20px; display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 7px; align-items: baseline; }
  .resident-card__ids span { color: #85867d; font: 7px/1.3 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .resident-card__ids code { overflow: hidden; color: #b7b8ae; font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
  .resident-card__visit { margin-top: 26px; display: flex; justify-content: space-between; color: var(--cabinet-paper-light); font: 10px var(--cabinet-mono); letter-spacing: 0.05em; text-transform: uppercase; }

  .publish-section { display: grid; grid-template-columns: minmax(260px, 0.55fr) minmax(0, 1fr); gap: clamp(44px, 8vw, 110px); }
  .publish-intro > p:not(.eyebrow) { margin: 24px 0 0; color: var(--cabinet-muted); font-size: 14px; line-height: 1.65; }
  .desk-steps { margin: 32px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--cabinet-rule); }
  .desk-steps li { padding: 14px 0; border-bottom: 1px solid var(--cabinet-rule); display: flex; gap: 12px; font-size: 12px; }
  .desk-steps span { color: var(--cabinet-red); font: 9px var(--cabinet-mono); }
  .publish-desk { min-width: 0; }
  .publish-desk form { padding: clamp(22px, 4vw, 42px); border: 1px solid var(--cabinet-ink); background: var(--cabinet-paper-light); box-shadow: 10px 10px 0 var(--cabinet-blue); }
  .publish-desk label { display: grid; gap: 8px; margin-bottom: 18px; color: var(--cabinet-muted); font: 9px/1.3 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .publish-desk input,
  .publish-desk textarea,
  .publish-desk select {
    width: 100%; border: 1px solid var(--cabinet-rule); border-radius: 0; padding: 13px 14px;
    background: #fffdf6; color: var(--cabinet-ink); font: 13px/1.5 var(--cabinet-sans);
  }
  .publish-desk textarea { resize: vertical; min-height: 108px; }
  .publish-desk input:focus,
  .publish-desk textarea:focus,
  .publish-desk select:focus { outline: 2px solid var(--cabinet-blue); outline-offset: 2px; }
  .form-row--split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .fixed-terms { margin: 24px 0 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--cabinet-rule); border: 1px solid var(--cabinet-rule); }
  .fixed-terms > div { padding: 14px; display: grid; gap: 4px; background: #ebe7d9; }
  .fixed-terms span { color: var(--cabinet-red); font: 8px/1.3 var(--cabinet-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .fixed-terms strong { font-size: 14px; font-weight: 500; }
  .fixed-terms small { color: var(--cabinet-muted); font-size: 9px; line-height: 1.4; }
  .form-boundary { margin: 0; padding: 13px; border-left: 3px solid var(--cabinet-yellow); background: #efead7; color: #54564e; font-size: 11px; line-height: 1.6; }
  .form-actions { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px; }
  .manifest-preview { margin-top: 28px; border: 1px solid var(--cabinet-ink); background: #121711; color: #d7dbc9; }
  .manifest-preview__head { padding: 18px 20px; display: flex; justify-content: space-between; gap: 20px; align-items: end; border-bottom: 1px solid #40473c; }
  .manifest-preview__head .eyebrow { margin-bottom: 5px; color: #db9a69; }
  .manifest-preview h3 { margin: 0; color: #f0eddf; font-size: 19px; font-weight: 400; }
  #manifest-state { color: #919a88; font: 8px/1.3 var(--cabinet-mono); letter-spacing: 0.07em; text-transform: uppercase; }
  #manifest-state.is-ready { color: #9fc690; }
  .manifest-preview pre { max-height: 420px; margin: 0; padding: 20px; overflow: auto; color: #b8ceb0; font: 10px/1.65 var(--cabinet-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  .manifest-preview > p { margin: 0; padding: 13px 20px; border-top: 1px solid #40473c; color: #919a88; font: 8px/1.4 var(--cabinet-mono); letter-spacing: 0.04em; text-transform: uppercase; }

  .proof-section { padding: clamp(72px, 10vw, 122px) max(20px, calc((100vw - 1240px) / 2)); background: #d8d0b7; border-top: 1px solid var(--cabinet-ink); border-bottom: 1px solid var(--cabinet-ink); }
  .proof-section header { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: end; }
  .proof-section header .eyebrow { grid-column: 1 / -1; margin-bottom: -10px; }
  .proof-section header > p:last-child { margin: 0; color: var(--cabinet-muted); font-size: 14px; }
  .proof-section ol { margin: 44px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--cabinet-ink); border-left: 1px solid var(--cabinet-ink); }
  .proof-section li { min-height: 180px; padding: 20px; border-right: 1px solid var(--cabinet-ink); border-bottom: 1px solid var(--cabinet-ink); display: flex; flex-direction: column; }
  .proof-section li > span { color: var(--cabinet-red); font: 10px var(--cabinet-mono); }
  .proof-section li strong { margin-top: 28px; font-size: 18px; font-weight: 400; }
  .proof-section li small { margin-top: 7px; color: var(--cabinet-muted); font-size: 10px; }
  .proof-section li em { margin-top: auto; color: var(--cabinet-red); font: normal 8px var(--cabinet-mono); letter-spacing: 0.09em; text-transform: uppercase; }

  .cabinet-footer { width: min(1240px, calc(100% - 40px)); margin: 0 auto; padding: 48px 0 100px; display: grid; grid-template-columns: 1fr auto; gap: 18px 30px; }
  .cabinet-footer p { margin: 0; font-size: 12px; }
  .cabinet-footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .cabinet-footer a { color: var(--cabinet-ink); font: 9px var(--cabinet-mono); text-transform: uppercase; }
  .cabinet-footer__fine { grid-column: 1 / -1; padding-top: 18px; border-top: 1px solid var(--cabinet-rule); color: var(--cabinet-muted); font: 8px var(--cabinet-mono); letter-spacing: 0.06em; text-transform: uppercase; }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr 0.78fr; gap: 44px; }
    .truth-strip { grid-template-columns: repeat(4, 1fr); }
    .truth-strip p { grid-column: 1 / -1; border-top: 1px solid var(--cabinet-rule); }
    .truth-strip > div:nth-child(4) { border-right: 0; }
    .object-grid { grid-template-columns: 1fr 1fr; }
    .object-card:last-child { grid-column: 1 / -1; width: calc(50% - 10px); }
    .resident-grid { grid-template-columns: 1fr 1fr; }
    .publish-section { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .site-head { min-height: 62px; }
    .site-head nav a:not(:last-child) { display: none; }
    .hero { padding-top: 46px; grid-template-columns: 1fr; }
    .hero__copy { display: contents; }
    .hero .eyebrow,
    .hero h1,
    .hero__dek,
    .hero__actions,
    .hero__boundary { order: 0; }
    .quiet-object { order: 1; max-width: 480px; }
    .quiet-object__field { box-shadow: 8px 8px 0 var(--cabinet-ink); }
    .truth-strip { grid-template-columns: 1fr 1fr; }
    .truth-strip > div:nth-child(2) { border-right: 0; }
    .truth-strip > div:nth-child(3), .truth-strip > div:nth-child(4) { border-top: 1px solid var(--cabinet-rule); }
    .section-head,
    .proof-section header { grid-template-columns: 1fr; align-items: start; }
    .object-grid { grid-template-columns: 1fr; }
    .object-card:last-child { grid-column: auto; width: auto; }
    .object-card__art { min-height: 460px; }
