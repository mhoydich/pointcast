---
/**
 * /sit-v2 — Stay Still Drum.
 *
 * A quieter sibling of /sit and /drum: the visitor does less, and the room
 * plays more. Stillness becomes the instrument. Pointer, keyboard, scroll,
 * and optional device-motion signals agitate the surface; quiet time settles
 * it. A soft drum sounds on the slow breath cycle once the visitor starts.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Stay Still Drum v2';
const description =
  'A quiet PointCast room where stillness becomes the drum. Start the room, sit with the breath cycle, and let local-only stillness receipts accumulate in this browser.';
const heroImage = '/images/sit/stay-still-drum-v2-bg.png';
const spotifyTrack = 'https://open.spotify.com/track/5dFoWIiJ2814hRwMYDcFiU?si=c027f9300eaf41c3';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/sit-v2',
  name: 'PointCast · Stay Still Drum v2',
  description,
  url: 'https://pointcast.xyz/sit-v2',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  featureList: [
    'Local-only sitting session',
    'Soft breath-cycle drum',
    'Stillness meter from local interaction signals',
    'Optional device-motion listening on supported mobile browsers',
    'Browser-local receipts under pc:sit-v2:sessions',
  ],
};
---

<BlockLayout
  title={title}
  description={description}
  image={heroImage}
  jsonLd={jsonLd}
>
  <main class="ss" id="ss-root" data-mode="coast" data-pattern="afterglow" data-running="false">
    <section class="ss__sky" aria-label="Stay Still Drum v2">
      <div class="ss__grain" aria-hidden="true"></div>
      <div class="ss__horizon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <header class="ss__head">
        <nav class="ss__crumb mono" aria-label="Drum room links">
          <a href="/">home</a>
          <span>/</span>
          <a href="/sit">sit</a>
          <span>/</span>
          <a href="/drum">drum</a>
        </nav>
        <p class="ss__kicker mono">CH.VST · STILLNESS DRUM · LOCAL ONLY</p>
        <h1>Stay Still Drum.</h1>
        <p>
          Start the room, settle the cursor, and let the drum arrive on its own.
          Movement clouds the tone. Stillness opens it. Tonight it has a late
          soft-rock ache and a hand-drum pulse.
        </p>
      </header>

      <section class="ss__instrument" aria-label="Stillness instrument">
        <div class="ss__orb" aria-hidden="true">
          <div class="ss__orb-ring ss__orb-ring--a"></div>
          <div class="ss__orb-ring ss__orb-ring--b"></div>
          <div class="ss__orb-core">
            <span id="ss-phase">ready</span>
          </div>
        </div>

        <div class="ss__readout" aria-live="polite">
          <p class="mono">Stillness</p>
          <strong id="ss-stillness">100</strong>
          <span id="ss-reading">quiet room</span>
        </div>
      </section>

      <section class="ss__controls" aria-label="Stay Still Drum controls">
        <button type="button" id="ss-start">Begin</button>
        <button type="button" id="ss-strike">Soft strike</button>
        <button type="button" id="ss-mark">Mark sit</button>
        <label class="ss__select mono">
          mode
          <select id="ss-mode">
            <option value="coast">coast</option>
            <option value="zazen">zazen</option>
            <option value="night">night</option>
            <option value="lounge">lounge</option>
          </select>
        </label>
        <label class="ss__select mono">
          pattern
          <select id="ss-pattern">
            <option value="afterglow">afterglow</option>
            <option value="heartbreak">heartbreak</option>
            <option value="floorlamp">floorlamp</option>
          </select>
        </label>
      </section>

      <aside class="ss__track" aria-label="Music reference">
        <p class="mono">NOW LISTENING</p>
        <h2>She&apos;s Gone</h2>
        <span>Daryl Hall &amp; John Oates</span>
        <small id="ss-pattern-note">brushes on the two, room tone on the four</small>
        <a href={spotifyTrack} target="_blank" rel="noreferrer">Open track</a>
      </aside>

      <section class="ss__ledger" aria-label="Local stillness ledger">
        <article>
          <span class="mono">this sit</span>
          <strong id="ss-elapsed">00:00</strong>
        </article>
        <article>
          <span class="mono">best quiet</span>
          <strong id="ss-best">0s</strong>
        </article>
        <article>
          <span class="mono">local marks</span>
          <strong id="ss-count">0</strong>
        </article>
      </section>

      <footer class="ss__foot">
        <p>
          No login, no wallet, no server claim. Receipts stay in
          <code>pc:sit-v2:sessions</code> until you clear this browser.
        </p>
      </footer>
    </section>
  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';

    const root = document.getElementById('ss-root');
    const startBtn = document.getElementById('ss-start');
    const strikeBtn = document.getElementById('ss-strike');
    const markBtn = document.getElementById('ss-mark');
    const modeSelect = document.getElementById('ss-mode');
    const patternSelect = document.getElementById('ss-pattern');
    const patternNoteEl = document.getElementById('ss-pattern-note');
    const stillnessEl = document.getElementById('ss-stillness');
    const readingEl = document.getElementById('ss-reading');
    const elapsedEl = document.getElementById('ss-elapsed');
    const bestEl = document.getElementById('ss-best');
    const countEl = document.getElementById('ss-count');
    const phaseEl = document.getElementById('ss-phase');
    if (!root || !startBtn || !stillnessEl || !elapsedEl || !phaseEl) return;

    const SESSION_KEY = 'pc:sit-v2:sessions';
    const MODE_KEY = 'pc:sit-v2:mode';
    const PATTERN_KEY = 'pc:sit-v2:pattern';
    const cycle = [
      { name: 'inhale', seconds: 4, tone: 0 },
      { name: 'hold', seconds: 2, tone: 1 },
      { name: 'exhale', seconds: 6, tone: 2 },
      { name: 'rest', seconds: 2, tone: 3 },
    ];
    const modePalettes = {
      coast: { root: 88, label: 'coastline breath' },
      zazen: { root: 73, label: 'low cushion' },
      night: { root: 55, label: 'blue hour' },
      lounge: { root: 62, label: 'late lounge' },
    };
    const patterns = {
      afterglow: {
        label: 'brushes on the two, room tone on the four',
        hits: [
          { at: 0, weight: 0.8, decay: 0.95 },
          { at: 360, weight: 0.36, decay: 0.7 },
          { at: 920, weight: 0.52, decay: 0.82 },
        ],
      },
      heartbreak: {
        label: 'one soft answer, one low reply',
        hits: [
          { at: 0, weight: 1, decay: 1.1 },
          { at: 620, weight: 0.42, decay: 0.9 },
        ],
      },
      floorlamp: {
        label: 'small table taps under a warm lamp',
        hits: [
          { at: 0, weight: 0.5, decay: 0.58 },
          { at: 220, weight: 0.28, decay: 0.42 },
          { at: 440, weight: 0.34, decay: 0.5 },
          { at: 880, weight: 0.44, decay: 0.66 },
        ],
      },
    };

    let ctx = null;
    let running = false;
    let startedAt = 0;
    let lastSecond = 0;
    let phaseIndex = 0;
    let phaseStartedAt = 0;
    let agitation = 0;
    let bestQuiet = 0;
    let currentQuiet = 0;
    let animationId = 0;
    let lastPointer = null;

    function sessions() {
      try {
        const parsed = JSON.parse(localStorage.getItem(SESSION_KEY) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function saveSessions(next) {
      try {
        localStorage.setItem(SESSION_KEY, JSON.stringify(next.slice(-60)));
      } catch {}
    }

    function fmtTime(ms) {
      const total = Math.max(0, Math.floor(ms / 1000));
      const m = String(Math.floor(total / 60)).padStart(2, '0');
      const s = String(total % 60).padStart(2, '0');
      return `${m}:${s}`;
    }

    function setMode(mode) {
      const safe = modePalettes[mode] ? mode : 'coast';
      root.dataset.mode = safe;
      if (modeSelect) modeSelect.value = safe;
      try { localStorage.setItem(MODE_KEY, safe); } catch {}
      if (readingEl && !running) readingEl.textContent = modePalettes[safe].label;
    }

    function setPattern(pattern) {
      const safe = patterns[pattern] ? pattern : 'afterglow';
      root.dataset.pattern = safe;
      if (patternSelect) patternSelect.value = safe;
      if (patternNoteEl) patternNoteEl.textContent = patterns[safe].label;
      try { localStorage.setItem(PATTERN_KEY, safe); } catch {}
    }

    function ensureAudio() {
      if (ctx) return ctx;
      const AC = window.AudioContext || window.webkitAudioContext;
      ctx = new AC();
      return ctx;
    }

    function hit(amount) {
      agitation = Math.min(100, agitation + amount);
    }

    function softDrum(weight, decayScale) {
      if (!ctx) return;
      const now = ctx.currentTime;
      const mode = root.dataset.mode || 'coast';
      const base = modePalettes[mode]?.root || 88;
      const calm = Math.max(0.08, (100 - agitation) / 100);
      const ratio = typeof weight === 'number'
        ? Math.max(0.35, Math.min(1.65, weight))
        : 1;
      const freq = base * ratio;
      const decay = Math.max(0.32, decayScale || 1);

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const filter = ctx.createBiquadFilter();
      osc.type = 'sine';
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(260 + calm * 900, now);
      osc.frequency.setValueAtTime(freq, now);
      osc.frequency.exponentialRampToValueAtTime(Math.max(32, freq * 0.42), now + 0.62 * decay);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.12 + calm * 0.22, now + 0.025);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.1 * decay);
      osc.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 1.15 * decay);
    }

    function playPattern(strength) {
      const pattern = patterns[root.dataset.pattern || 'afterglow'] || patterns.afterglow;
      pattern.hits.forEach(function (hitDef) {
        window.setTimeout(function () {
          softDrum((strength || 1) * hitDef.weight, hitDef.decay);
        }, hitDef.at);
      });
    }

    function markSession(reason) {
      const now = Date.now();
      const elapsed = startedAt ? now - startedAt : 0;
      const record = {
        id: `SS-${now.toString(36).toUpperCase()}`,
        mode: root.dataset.mode || 'coast',
        pattern: root.dataset.pattern || 'afterglow',
        reason,
        elapsedSeconds: Math.floor(elapsed / 1000),
        bestQuietSeconds: bestQuiet,
        stillness: Math.round(100 - agitation),
        plantedAt: new Date(now).toISOString(),
      };
      const next = sessions().concat(record);
      saveSessions(next);
      renderCount();
      if (readingEl) readingEl.textContent = 'local receipt marked';
    }

    function renderCount() {
      const list = sessions();
      if (countEl) countEl.textContent = String(list.length);
      const best = list.reduce((max, item) => Math.max(max, Number(item.bestQuietSeconds || 0)), bestQuiet);
      if (bestEl) bestEl.textContent = `${Math.floor(best)}s`;
    }

    function tick(now) {
      if (!running) return;
      animationId = requestAnimationFrame(tick);

      agitation = Math.max(0, agitation - 0.028);
      const stillness = Math.round(100 - agitation);
      stillnessEl.textContent = String(stillness);
      root.style.setProperty('--stillness', String(stillness / 100));

      const elapsed = now - startedAt;
      elapsedEl.textContent = fmtTime(elapsed);

      const second = Math.floor(elapsed / 1000);
      if (second !== lastSecond) {
        lastSecond = second;
        if (stillness > 82) currentQuiet += 1;
        else currentQuiet = 0;
        bestQuiet = Math.max(bestQuiet, currentQuiet);
        if (bestEl) bestEl.textContent = `${Math.floor(bestQuiet)}s`;
      }

      const phase = cycle[phaseIndex];
      const phaseElapsed = (now - phaseStartedAt) / 1000;
      if (phaseElapsed >= phase.seconds) {
        phaseIndex = (phaseIndex + 1) % cycle.length;
        phaseStartedAt = now;
        const nextPhase = cycle[phaseIndex];
        phaseEl.textContent = nextPhase.name;
        if (root.dataset.pattern === 'heartbreak' && nextPhase.name === 'exhale') playPattern(0.42);
        else softDrum(nextPhase.tone);
      }

      if (readingEl) {
        if (stillness > 92) readingEl.textContent = 'the room is opening';
        else if (stillness > 78) readingEl.textContent = 'soft enough';
        else if (stillness > 55) readingEl.textContent = 'settling';
        else readingEl.textContent = 'let the surface calm';
      }
    }

    async function start() {
      if (running) {
        running = false;
        root.dataset.running = 'false';
        startBtn.textContent = 'Begin';
        cancelAnimationFrame(animationId);
        markSession('ended');
        return;
      }
      ensureAudio();
      if (ctx.state === 'suspended') await ctx.resume();
      running = true;
      root.dataset.running = 'true';
      startedAt = performance.now();
      phaseStartedAt = startedAt;
      lastSecond = 0;
      phaseIndex = 0;
      currentQuiet = 0;
      bestQuiet = 0;
      agitation = Math.min(agitation, 22);
      startBtn.textContent = 'End sit';
      phaseEl.textContent = cycle[0].name;
      playPattern(0.8);
      animationId = requestAnimationFrame(tick);
    }

    window.addEventListener('pointermove', function (event) {
      if (!running) return;
      if (!lastPointer) {
        lastPointer = { x: event.clientX, y: event.clientY };
        return;
      }
      const dx = event.clientX - lastPointer.x;
      const dy = event.clientY - lastPointer.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist > 4) hit(Math.min(12, dist / 22));
      lastPointer = { x: event.clientX, y: event.clientY };
    }, { passive: true });

    window.addEventListener('keydown', function () { if (running) hit(7); });
    window.addEventListener('wheel', function () { if (running) hit(9); }, { passive: true });
    window.addEventListener('touchmove', function () { if (running) hit(8); }, { passive: true });
    window.addEventListener('devicemotion', function (event) {
      if (!running) return;
      const a = event.accelerationIncludingGravity || {};
      const magnitude = Math.abs(a.x || 0) + Math.abs(a.y || 0) + Math.abs(a.z || 0);
      if (magnitude > 13) hit(Math.min(8, (magnitude - 13) * 0.8));
    });

    startBtn.addEventListener('click', start);
    strikeBtn?.addEventListener('click', function () {
      ensureAudio();
      if (ctx.state === 'suspended') ctx.resume();
      hit(4);
      playPattern(1);
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', note: 'sit-v2', seed: Math.round(100 - agitation) }),
          keepalive: true,
        }).catch(function () {});
      } catch {}
    });
    markBtn?.addEventListener('click', function () { markSession('manual'); });
    modeSelect?.addEventListener('change', function () { setMode(modeSelect.value); });
    patternSelect?.addEventListener('change', function () { setPattern(patternSelect.value); });

    setMode(localStorage.getItem(MODE_KEY) || 'coast');
    setPattern(localStorage.getItem(PATTERN_KEY) || 'afterglow');
    renderCount();
  })();
</script>

<style>
  :global(body) {
    margin: 0;
    background: #0b1012;
  }

  .ss {
    --stillness: 1;
    min-height: 100vh;
    color: #f7f1df;
    background:
      linear-gradient(90deg, rgba(5, 7, 8, 0.8) 0%, rgba(5, 7, 8, 0.42) 42%, rgba(5, 7, 8, 0.7) 100%),
      radial-gradient(circle at 68% 38%, rgba(118, 18, 30, calc(0.24 * var(--stillness))), transparent 26rem),
      url('/images/sit/stay-still-drum-v2-bg.png') center / cover no-repeat,
      radial-gradient(circle at 50% 34%, rgba(255, 232, 178, calc(0.18 * var(--stillness))), transparent 26rem),
      linear-gradient(180deg, #0c1722 0%, #203344 42%, #d5a36d 43%, #eee0bd 46%, #10231f 47%, #09100e 100%);
    overflow: hidden;
  }

  .ss[data-mode='zazen'] {
    background:
      linear-gradient(90deg, rgba(9, 8, 7, 0.84) 0%, rgba(9, 8, 7, 0.48) 42%, rgba(9, 8, 7, 0.74) 100%),
      radial-gradient(circle at 64% 42%, rgba(180, 135, 81, calc(0.2 * var(--stillness))), transparent 25rem),
      url('/images/sit/stay-still-drum-v2-bg.png') center / cover no-repeat,
      radial-gradient(circle at 50% 34%, rgba(229, 212, 176, calc(0.14 * var(--stillness))), transparent 24rem),
      linear-gradient(180deg, #161513 0%, #2d2a21 42%, #b48751 43%, #ded0af 46%, #151a13 47%, #070806 100%);
  }

  .ss[data-mode='night'] {
    background:
      linear-gradient(90deg, rgba(3, 4, 14, 0.82) 0%, rgba(3, 4, 14, 0.42) 45%, rgba(3, 4, 14, 0.72) 100%),
      radial-gradient(circle at 70% 34%, rgba(50, 78, 140, calc(0.26 * var(--stillness))), transparent 28rem),
      url('/images/sit/stay-still-drum-v2-bg.png') center / cover no-repeat,
      radial-gradient(circle at 50% 32%, rgba(169, 204, 255, calc(0.2 * var(--stillness))), transparent 25rem),
      linear-gradient(180deg, #050816 0%, #101d3a 42%, #596d9c 43%, #d5dde8 46%, #08111f 47%, #03050b 100%);
  }

  .ss[data-mode='lounge'] {
    background:
      linear-gradient(90deg, rgba(15, 3, 8, 0.78) 0%, rgba(15, 3, 8, 0.34) 44%, rgba(15, 3, 8, 0.66) 100%),
      radial-gradient(circle at 72% 38%, rgba(180, 34, 42, calc(0.28 * var(--stillness))), transparent 31rem),
      url('/images/sit/stay-still-drum-v2-bg.png') center / cover no-repeat,
      radial-gradient(circle at 50% 34%, rgba(255, 222, 190, calc(0.1 * var(--stillness))), transparent 24rem),
      linear-gradient(180deg, #18070a 0%, #2a1016 48%, #080607 100%);
  }

  .ss[data-running='true'] {
    animation: ss-room-drift 38s ease-in-out infinite alternate;
  }

  .ss__sky {
    position: relative;
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 1.2rem;
    padding: clamp(1rem, 3vw, 2rem);
    isolation: isolate;
  }

  .ss__grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: calc(0.16 + (1 - var(--stillness)) * 0.24);
    mix-blend-mode: soft-light;
    background-image:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.08) 0 1px, transparent 1px 5px);
    z-index: -1;
  }

  .ss__horizon {
    position: fixed;
    inset: auto 0 33vh;
    height: 18vh;
    pointer-events: none;
    z-index: -1;
  }

  .ss__horizon span {
    position: absolute;
    left: -5vw;
    right: -5vw;
    height: 1px;
    background: rgba(247, 241, 223, 0.36);
    transform-origin: center;
  }

  .ss__horizon span:nth-child(1) { top: 20%; transform: rotate(-1.2deg); }
  .ss__horizon span:nth-child(2) { top: 48%; transform: rotate(0.4deg); opacity: 0.48; }
  .ss__horizon span:nth-child(3) { top: 78%; transform: rotate(1.1deg); opacity: 0.28; }

  .ss__head {
    max-width: 58rem;
    text-shadow: 0 1px 1.6rem rgba(0, 0, 0, 0.48);
  }

  .ss__crumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .ss__crumb a {
    color: inherit;
    text-underline-offset: 0.25em;
  }

  .ss__kicker,
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  .ss__kicker {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
  }

  .ss__head h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.8rem, 12vw, 10rem);
    line-height: 0.86;
    letter-spacing: 0;
    font-weight: 500;
  }

  .ss__head p:not(.ss__kicker) {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.45;
    color: rgba(247, 241, 223, 0.76);
  }

  .ss__instrument {
    display: grid;
    place-items: center;
    align-self: center;
    gap: 1.2rem;
  }

  .ss__orb {
    width: min(54vw, 28rem);
    aspect-ratio: 1;
    position: relative;
    display: grid;
    place-items: center;
  }

  .ss__orb-ring,
  .ss__orb-core {
    position: absolute;
    border-radius: 50%;
  }

  .ss__orb-ring {
    inset: 0;
    border: 1px solid rgba(247, 241, 223, calc(0.22 + var(--stillness) * 0.28));
    transform: scale(calc(0.84 + var(--stillness) * 0.1));
    transition: border-color 400ms ease, transform 400ms ease;
  }

  .ss[data-running='true'] .ss__orb-ring--a {
    animation: ss-breathe 14s linear infinite;
  }

  .ss__orb-ring--b {
    inset: 14%;
    opacity: 0.64;
    animation-delay: -7s;
  }

  .ss[data-running='true'] .ss__orb-ring--b {
    animation: ss-breathe 14s linear infinite reverse;
  }

  .ss__orb-core {
    width: 42%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: rgba(7, 10, 9, calc(0.54 + (1 - var(--stillness)) * 0.18));
    border: 1px solid rgba(247, 241, 223, 0.44);
    box-shadow:
      0 0 calc(1rem + var(--stillness) * 5rem) rgba(247, 219, 155, calc(0.12 + var(--stillness) * 0.22)),
      inset 0 0 3rem rgba(247, 241, 223, 0.06);
  }

  .ss__orb-core span {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: clamp(0.72rem, 1.4vw, 1rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .ss__readout {
    text-align: center;
  }

  .ss__readout p,
  .ss__readout span {
    margin: 0;
    color: rgba(247, 241, 223, 0.68);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.7rem;
  }

  .ss__readout strong {
    display: block;
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    line-height: 0.9;
    font-weight: 500;
  }

  .ss__controls,
  .ss__ledger {
    width: min(100%, 58rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .ss__track {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
