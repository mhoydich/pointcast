---
/**
 * /still-hour — The Still Hour, the Thursday sitting for September 24, 2026.
 *
 * The full-room version of the front-door panel: same sit (2, 5 or 10
 * minutes, one bell in, one bell out, a 4-2-6-2 breath ring, the same
 * twenty quiet lines for everyone today), with more air around it and a
 * time-of-day wash that follows El Segundo's clock.
 *
 * Presence and the day's totals come from /api/still-hour. Only a finished
 * sit is counted. Nothing plays until Begin is pressed.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import StillHourSitting from '../components/StillHourSitting.astro';

const title = 'The Still Hour · Thursday sitting';
const description =
  'A short sitting for Thursday, September 24, 2026, the first Thursday of autumn. Pick 2, 5 or 10 minutes. One bell to begin, a slow breath, a few quiet lines, one bell to finish. No login, no streak, no score.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/still-hour',
  name: 'PointCast · The Still Hour',
  description,
  url: 'https://pointcast.xyz/still-hour',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Web Audio API (optional)',
  isAccessibleForFree: true,
  datePublished: '2026-09-24',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  featureList: [
    'Timed sit: 2, 5 or 10 minutes',
    'Struck-bell start and finish, synthesized inline',
    'Breath ring: 4 in, 2 hold, 6 out, 2 rest',
    'Twenty quiet lines, the same for everyone that day',
    'Sitting-now presence and daily totals, no names',
    'Live El Segundo weather line and time-of-day wash',
  ],
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="still-page">
    <StillHourSitting variant="room" />
    <section class="still-page__notes">
      <h2>How the sit works</h2>
      <p>
        Pick a length. Press Begin. A bell rings, a low ocean bed comes up under it, and the ring on the right
        starts to breathe: four counts in, two held, six out, two of rest. Follow it or ignore it. Every half
        minute a short line appears. The lines are the same for everyone who sits today, in the same order,
        so two strangers on the page at the same minute are reading the same words.
      </p>
      <p>
        When the timer runs out the bell rings again. That sit is counted: one more sit, that many more
        minutes, on the ledger at the left. No names, no streaks, no score. If you stand up early, nothing is
        counted and nothing is lost.
      </p>
      <p>
        The room follows El Segundo's clock. The paper cools toward blue after sunset and warms again in the
        morning. Today the sun was up at 6:43 and down at 6:47, two days after the equinox, which is why the
        light and the dark are about even.
      </p>
      <p class="still-page__kin">
        Kin: <a href="/sit">sit</a>, the ambient room with the Pacific horizon · <a href="/meditate">ocean meditation</a>
        · <a href="/drum-meditate">drum meditate</a> · <a href="/grey-hour">the Grey Hour</a> · <a href="/b/0614">block 0614</a>
      </p>
    </section>
  </main>
</BlockLayout>

<style>
  .still-page { padding: 18px 12px 48px; }
  .still-page__notes { max-width: 68ch; margin: 34px auto 0; padding: 0 4px; }
  .still-page__notes h2 { margin: 0 0 12px; font: 650 22px/1.1 var(--pc-font-sans); letter-spacing: -.03em; }
  .still-page__notes p { margin: 0 0 14px; font-size: 15px; line-height: 1.65; }
  .still-page__kin { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .02em; }
  .still-page__kin a { text-underline-offset: 3px; }
</style>
