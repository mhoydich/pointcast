---
import BlockLayout from '../layouts/BlockLayout.astro';
import GhostTownSkyward from '../components/GhostTownSkyward.astro';

const title = 'Ghost Town · Skyward';
const description = 'The Ghost Town edit by JonJeffJon Edits, with a little ghost to guide through three skies while you listen.';
const videoTitle = 'Kanye West - Ghost Town but it will make you ascend to the fourth dimension';
---

<BlockLayout title={title} description={description}
  image="/images/ghost-town/video.jpg" imageWidth={480} imageHeight={360}
  themeColor="#171726" immersive={true} isolated={true} showNetworkStrip={false}
  alternates={[{ type: 'application/json', href: '/ghost-town.json', title: 'Ghost Town structured edition' }]}>
  <div class="ghost-room">
    <nav class="room-nav" aria-label="Room navigation"><a href="/">← PointCast</a><a href="/#morning-listening">Morning listening ↗</a></nav>
    <header class="room-head">
      <div><p class="eyebrow">A listening room / a little lift</p><h1>Ghost Town<span aria-hidden="true">.</span></h1></div>
      <p>Press play. Let the song fill the room.<br />There’s a little ghost here if you feel like flying.</p>
    </header>
    <div class="room-stage">
      <section class="film" aria-label="Ghost Town video">
        <div class="film__label"><span>01 / THE SOUNDTRACK</span><span>JONJEFFJON EDITS</span></div>
        <div class="film__screen">
          <iframe src="https://www.youtube.com/embed/dQAsaY0pKhI?playsinline=1&rel=0"
            title={videoTitle} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <p class="film__credit">Kanye West · Ghost Town <span>— edit by <a href="https://www.youtube.com/@JonJeffJon_Edits" target="_blank" rel="noopener noreferrer">JonJeffJon Edits ↗</a></span></p>
        <a class="film__source" href="https://www.youtube.com/watch?v=dQAsaY0pKhI" target="_blank" rel="noopener noreferrer">Watch the original on YouTube ↗</a>
      </section>
      <GhostTownSkyward />
    </div>
    <footer class="room-foot"><span>A song, a sky, nowhere else to be.</span><a href="/b/0609">About this pick ↗</a><a href="/ghost-town.json">JSON ↗</a></footer>
  </div>
</BlockLayout>

<style>
  :global(html[data-pc-layout='block'] body.pc-block-shell) { --pc-bg: #171726; --pc-ink: #f2efff; --pc-accent: #d4c3f5; margin: 0; background: #171726; color: #f2efff; }
  .ghost-room { max-width: 1350px; margin: 0 auto; padding: 24px clamp(14px, 3vw, 42px) 30px; color: #f2efff; font-family: var(--pc-font-sans); }
  a { color: inherit; text-underline-offset: 4px; }
  a:focus-visible { outline: 3px solid #d8caff; outline-offset: 4px; }
  .room-nav { display: flex; justify-content: space-between; gap: 18px; color: #d2cde5; font: 600 11px/1.5 var(--pc-font-mono); }
  .room-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 38px 0 26px; }
  .eyebrow { margin: 0 0 10px; text-transform: uppercase; letter-spacing: .13em; font: 550 10px/1.5 var(--pc-font-mono); color: #bcb1d6; }
  h1 { margin: 0; color: #f2efff; font-size: clamp(40px, 6vw, 76px); line-height: .95; letter-spacing: -.055em; font-weight: 760; }
  h1 span { color: #cbb7ef; }
  .room-head > p { margin: 0; color: #c6bfd7; font-size: 13px; line-height: 1.7; }
  .room-stage { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .film { min-width: 0; background: #10101c; border: 1px solid #5d5672; padding-bottom: 16px; }
  .film__label { display: flex; justify-content: space-between; gap: 12px; padding: 13px 15px; color: #c6bfd7; font: 550 9px/1.5 var(--pc-font-mono); letter-spacing: .07em; }
  .film__screen { aspect-ratio: 4 / 3; background: #080810; }
  .film__screen iframe { display: block; width: 100%; height: 100%; border: 0; }
  .film__credit { padding: 0 15px; margin: 15px 0 7px; color: #ded8ef; font-size: 11px; line-height: 1.6; }
  .film__credit span { color: #b9b1cb; }
  .film__source { display: inline-block; margin: 0 15px; font-size: 11px; color: #d4c3f5; }
  .room-foot { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 25px; color: #b8adc9; font: 500 10px/1.6 var(--pc-font-mono); }
  .room-foot span { margin-right: auto; }
  @media (max-width: 760px) {
    .ghost-room { padding-top: 16px; }
    .room-head { padding: 24px 0 20px; display: block; }
    .room-head > p { margin-top: 14px; font-size: 12px; }
    .room-stage { display: block; }
    .film { position: sticky; top: 0; z-index: 3; margin-bottom: 14px; padding-bottom: 8px; box-shadow: 0 8px 15px #17172688; }
    .film__screen { aspect-ratio: 16 / 9; min-height: 200px; }
    .film__screen iframe { min-height: 200px; }
    .film__label { padding: 7px 10px; font-size: 8px; }
    .film__credit { margin: 6px 0 2px; padding: 0 10px; font-size: 9px; }
    .film__source { margin: 0 10px; font-size: 10px; }
  }
  @media (max-width: 760px) and (max-height: 600px) {
    .film { position: static; }
  }
</style>
