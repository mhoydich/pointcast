---
import { sampleSwitchboard, switchboardHtml } from '../../../lib/loom/switchboard.mjs';

const boot = sampleSwitchboard(new Date('2026-11-27T16:15:00.000Z'));
const bootJson = JSON.stringify(boot).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Loom Switchboard · PointCast</title>
    <meta name="description" content="A read-only cord-board drawing of who posted where on the PointCast Loom. Lamps follow post time. This page does not post." />
    <meta name="theme-color" content="#241c16" />
    <link rel="canonical" href="https://pointcast.xyz/sketches/switchboard/" />
  </head>
  <body>
    <div id="app" set:html={switchboardHtml(boot)}></div>
    <script type="application/json" id="sb-boot" is:inline set:html={bootJson}></script>
    <script>
      import { mountSwitchboard } from '../../../lib/loom/switchboard.mjs';
      const boot = JSON.parse(document.getElementById('sb-boot').textContent || '{}');
      mountSwitchboard(document, boot);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bakelite: #241c16;
    --panel: #2c231c;
    --inset: #1a1410;
    --brass: #e6d3a3;
    --brass-dim: #a48346;
    --cream: #f4efe4;
    --muted: #cbbfa8;
    --emerald: #1f8a4c;
    --emerald-core: #c8f5d4;
    --amber: #e39b2b;
    --amber-core: #ffe1a8;
    --idle: #8a8175;
    --wait: #fff6df;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; max-width: 100%; }
  body {
    min-width: 0;
    min-height: 100svh;
    color: var(--cream);
    background:
      radial-gradient(900px 420px at 50% -10%, #3c2e24 0%, transparent 60%),
      var(--bakelite);
    font-family: "Iowan Old Style", Palatino, "Palatino Linotype", Georgia, serif;
  }
  a { color: var(--brass); }
  a:hover { color: var(--cream); }
  button, summary { font: inherit; }
  #app { width: min(100%, 880px); margin: 0 auto; padding: 18px 12px 36px; }
  .kicker { margin: 0 0 6px; color: var(--brass); font: 12px/1.4 ui-monospace, Menlo, Consolas, monospace; letter-spacing: .04em; }
  h1 { margin: 0; font-size: clamp(26px, 7vw, 40px); font-weight: 600; letter-spacing: .01em; }
  .deck, .coverage, footer p, #relay-note, #status { color: var(--muted); font-size: 14px; line-height: 1.45; }
  .deck { margin: 10px 0; }
  .banner { margin: 10px 0; padding: 10px 12px; border: 1px solid var(--brass-dim); background: var(--inset); line-height: 1.4; }
  .banner[data-sample="true"] { border-color: var(--amber); color: var(--amber-core); background: #3a2a16; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; margin: 12px 0; }
  .controls button, .jack {
    min-height: 44px;
    border: 1px solid var(--brass-dim);
    background: linear-gradient(180deg, #3a3028, #241c16);
    color: var(--brass);
    border-radius: 4px;
    padding: 8px 12px;
    cursor: pointer;
  }
  #relay[aria-pressed="true"] { color: var(--wait); border-color: var(--amber); }
  #relay-note, #status { flex: 1 1 100%; margin: 0; }
  .legend { display: flex; flex-direction: column; gap: 6px; margin: 0 0 14px; padding: 0; list-style: none; font: 12px/1.35 ui-monospace, Menlo, Consolas, monospace; color: var(--muted); }
  .legend li { display: flex; gap: 8px; align-items: center; }
  .panel {
    background:
      linear-gradient(180deg, rgba(230, 211, 163, .06), transparent 28%),
      var(--panel);
    border: 1px solid var(--brass-dim);
    box-shadow: inset 0 1px 0 rgba(230, 211, 163, .28), 0 14px 28px rgba(0, 0, 0, .35);
    padding: 10px 8px 12px;
  }
  .board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr);
    position: relative;
    align-items: start;
    min-height: 220px;
  }
  .gutter { min-height: 100%; background: linear-gradient(90deg, transparent, rgba(164, 131, 70, .35), transparent); }
  .col { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .jack {
    display: grid;
    grid-template-columns: 14px 18px minmax(0, 1fr);
    column-gap: 6px;
    align-items: center;
    text-align: left;
    padding: 7px 6px;
  }
  .jack.is-hot { outline: 1px solid var(--brass); background: #3d3126; }
  .jack-name, .jack-meta { display: block; overflow-wrap: anywhere; }
  .jack-name { font: 12px/1.25 ui-monospace, Menlo, Consolas, monospace; color: var(--brass); text-transform: uppercase; letter-spacing: .03em; }
  .jack-meta { font: 10px/1.3 ui-monospace, Menlo, Consolas, monospace; color: var(--muted); }
  .bezel {
    width: 16px; height: 16px; border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #5c4a32, #1a140f 70%);
    box-shadow: inset 0 0 0 1px #e6d3a3, 0 1px 0 #000;
  }
  .lamp { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.45); justify-self: center; }
  .lamp-live { background: radial-gradient(circle at 35% 35%, var(--emerald-core), var(--emerald) 62%); box-shadow: 0 0 8px rgba(31, 138, 76, .85); animation: glow 2.8s ease-in-out infinite; }
  .lamp-warm { background: radial-gradient(circle at 35% 35%, var(--amber-core), var(--amber) 62%); }
  .lamp-idle { background: radial-gradient(circle at 35% 35%, #d9d0c1, var(--idle) 70%); opacity: .7; }
  .lamp-waiting { background: radial-gradient(circle at 35% 35%, #fff, var(--wait) 55%, var(--amber) 100%); box-shadow: 0 0 8px rgba(227, 155, 43, .9); animation: glow 1.6s ease-in-out infinite; }
  .cords { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .cords path { pointer-events: stroke; cursor: pointer; }
  .cords path.is-dim { opacity: .16; }
  .cords path.is-hot { filter: drop-shadow(0 0 3px rgba(230, 211, 163, .85)); }
  #inspect { margin-top: 14px; padding: 12px; background: var(--inset); border: 1px solid var(--brass-dim); }
  #inspect h2 { margin: 0 0 6px; font-size: 20px; }
  .inspect-kicker, .inspect-meta, .inspect-empty { margin: 0 0 6px; color: var(--muted); font: 12px/1.4 ui-monospace, Menlo, Consolas, monospace; }
  #inspect blockquote { margin: 8px 0; color: var(--cream); font-size: 16px; line-height: 1.4; }
  .circuits { margin-top: 14px; }
  .circuits summary { cursor: pointer; color: var(--brass); min-height: 44px; display: flex; align-items: center; }
  .circuits ol { margin: 0; padding-left: 18px; }
  .circuits li { margin: 0 0 8px; }
  .circuits span { display: block; color: var(--muted); font-size: 13px; }
  .empty-col { margin: 0; color: var(--muted); font-size: 13px; }
  footer p { margin: 16px 0 0; }
  code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .92em; }
  @keyframes glow { 50% { filter: brightness(1.25); } }
  @media (min-width: 720px) {
    #app { padding: 28px 20px 48px; }
    .board { grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); }
    .legend { flex-direction: row; flex-wrap: wrap; gap: 8px 16px; }
    .jack-name { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
