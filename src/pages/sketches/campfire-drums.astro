---
/**
 * Campfire Drum Circle. Phone-first at 390px.
 * Sound and haptics are off on every visit and are not remembered.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Campfire drum circle · PointCast</title>
    <meta name="description" content="Five drums around a small fire. Sound and haptics stay off until you turn them on." />
    <meta name="theme-color" content="#14110F" />
    <link rel="canonical" href="https://pointcast.xyz/sketches/campfire-drums/" />
  </head>
  <body>
    <main data-spec="pointcast.sensory.mcp/v1" data-sound="off" data-haptics="off">
      <header>
        <p class="eyebrow">Campfire · 390px</p>
        <h1>Drum circle</h1>
        <p class="dek" id="safety">Sound and haptics stay off until you turn them on. Nothing leaves this phone.</p>
      </header>
      <div class="toggles">
        <button type="button" id="sound" aria-pressed="false" aria-describedby="safety">
          Sound <span class="state">Off</span>
        </button>
        <button type="button" id="haptics" aria-pressed="false" aria-describedby="safety">
          Haptics <span class="state">Off</span>
        </button>
      </div>
      <div class="circle" role="group" aria-label="Five drums around the fire">
        <button type="button" class="drum north" data-drum="shaker" aria-keyshortcuts="3 d" aria-label="Shaker, key 3 or D">
          <span class="hint">Across</span>
          <span class="name">Shaker</span>
          <kbd>3</kbd>
        </button>
        <button type="button" class="drum west" data-drum="frame" aria-keyshortcuts="2 s" aria-label="Frame drum, key 2 or S">
          <span class="hint">Left</span>
          <span class="name">Frame</span>
          <kbd>2</kbd>
        </button>
        <button type="button" class="drum center" data-drum="ember" aria-keyshortcuts="5 g" aria-label="Ember, key 5 or G">
          <svg class="flame" viewBox="0 0 64 80" aria-hidden="true">
            <path d="M32 6c8 14 6 22 2 28 10-4 16 6 16 16a18 18 0 1 1-36 0c0-8 6-14 12-18-2 8 2 12 6 12-6-10-4-22 0-38z" />
          </svg>
          <span class="name">Ember</span>
          <kbd>5</kbd>
        </button>
        <button type="button" class="drum east" data-drum="log" aria-keyshortcuts="4 f" aria-label="Log drum, key 4 or F">
          <span class="hint">Right</span>
          <span class="name">Log</span>
          <kbd>4</kbd>
        </button>
        <button type="button" class="drum south" data-drum="hand" aria-keyshortcuts="1 a" aria-label="Hand drum, key 1 or A">
          <span class="hint">You</span>
          <span class="name">Hand</span>
          <kbd>1</kbd>
        </button>
      </div>
      <p class="keys">Keys 1–5 or A S D F G. Enter or tap a drum.</p>
      <p id="status" role="status" aria-live="polite">Sound off. Haptics off.</p>
      <noscript><p class="dek">Five drums around a fire. Turn on JavaScript to play them. Sound and haptics stay off until you turn them on.</p></noscript>
    </main>
    <script>
      import { mountCampfirePage } from '../../lib/mcp/sensory-mcp.mjs';
      mountCampfirePage(document, window);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ground: #14110f;
    --ember: #e8572a;
    --flame: #ff9f1c;
    --core: #f4ede4;
    --muted: #cfc6bb;
    --line: #786553;
    --phone: 390px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100svh;
    background: var(--ground);
    color: var(--core);
    font-family: system-ui, sans-serif;
  }
  main {
    width: min(100%, var(--phone));
    margin: 0 auto;
    padding: 28px 16px 32px;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--flame);
    font: 12px/1.4 ui-monospace, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 { margin: 0; font-size: 1.75rem; font-weight: 500; letter-spacing: -0.02em; }
  .dek, .keys { margin: 10px 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
  .toggles { display: flex; gap: 10px; margin: 22px 0 18px; }
  button {
    font: 600 15px/1.2 system-ui, sans-serif;
    color: var(--core);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .toggles button {
    flex: 1;
    min-height: 48px;
    padding: 12px 10px;
  }
  .toggles button[aria-pressed="true"] {
    background: var(--flame);
    color: var(--ground);
    border-color: var(--flame);
  }
  .state { font-weight: 500; }
  .circle {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    grid-template-areas:
      ". shaker ."
      "frame ember log"
      ". hand .";
    gap: 10px;
    width: 100%;
  }
  .north { grid-area: shaker; }
  .west { grid-area: frame; }
  .center { grid-area: ember; }
  .east { grid-area: log; }
  .south { grid-area: hand; }
  .drum {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 72px;
    min-width: 0;
    padding: 8px 4px;
  }
  .center { min-height: 112px; background: #1e1915; }
  .hint { color: var(--muted); font-size: 11px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
  .name { font-size: 15px; }
  kbd {
    color: var(--flame);
    font: 12px/1 ui-monospace, monospace;
  }
  .flame { width: 36px; height: 44px; fill: var(--ember); }
  .drum.is-hit {
    border-color: var(--flame);
    background: #2a2118;
  }
  .center.is-hit { background: #3a2414; }
  .center.is-hit .flame { fill: var(--flame); }
  .keys { text-align: center; }
  #status { min-height: 1.4em; margin: 14px 0 0; text-align: center; font-size: 0.95rem; }
  :focus-visible { outline: 2px solid var(--flame); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .flame { animation: campfire-flicker 1.2s ease-in-out infinite; transform-origin: center bottom; }
    .drum.is-hit { animation: campfire-tap 180ms ease-out; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flame, .drum, .drum.is-hit { animation: none; transition: none; }
  }
  @keyframes campfire-flicker {
    0%, 100% { transform: scale(1); opacity: 0.88; }
    50% { transform: scale(1.06, 0.96); opacity: 1; }
  }
  @keyframes campfire-tap {
    0% { transform: scale(0.98); }
    100% { transform: scale(1); }
  }
</style>
