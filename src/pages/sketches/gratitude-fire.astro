---
import { flameSvg } from '../../lib/loom/hearth.mjs';
import { DEFAULT_LINE } from '../../lib/gratitude-fire.mjs';
---
<!doctype html>
<!-- Original Hearth pixel art by the PointCast contributors. Sharing pattern: PR #1901. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A gratitude fire · PointCast</title>
    <meta name="description" content="One little fire and a line of thanks. Write yours, then share a link or save a picture." />
    <meta name="theme-color" content="#14110F" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="A gratitude fire" />
    <meta property="og:description" content="One little fire and a line of thanks." />
    <link rel="canonical" href="https://pointcast.xyz/sketches/gratitude-fire/" />
  </head>
  <body>
    <main>
      <header>
        <p class="occasion">Thanksgiving · November 26</p>
        <h1>A gratitude fire</h1>
      </header>
      <figure aria-label="A Hearth pixel flame and a line of thanks">
        <Fragment set:html={flameSvg(64, 'warm', { still: true })} />
        <figcaption id="line" dir="auto">{DEFAULT_LINE}</figcaption>
      </figure>
      <form id="maker" hidden>
        <div class="field-heading">
          <label for="words">Your line</label>
          <span id="count" aria-hidden="true"></span>
        </div>
        <textarea id="words" rows="2" maxlength="280" dir="auto" aria-describedby="hint">{DEFAULT_LINE}</textarea>
        <p id="hint" class="hint">Start with “thankful for…” · up to 140 characters.</p>
        <div class="actions">
          <button type="submit" class="primary">Copy link</button>
          <button type="button" id="save">Save picture</button>
        </div>
        <p class="hint privacy">Your words travel with the link. Anyone with it can read them.</p>
        <p id="status" role="status" aria-live="polite"></p>
        <div id="fallback" hidden>
          <label for="link">Select and copy your link</label>
          <input id="link" type="url" readonly />
        </div>
      </form>
      <noscript><p class="hint">A little fire to share. Turn on JavaScript to write your line, copy a link, or save a picture.</p></noscript>
    </main>
    <script>
      import { mountGratitudeFire } from '../../lib/gratitude-fire.mjs';
      mountGratitudeFire(document, window);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --hearth-ground: #14110F;
    --hearth-ember: #E8572A;
    --hearth-flame: #FF9F1C;
    --hearth-core: #F4EDE4;
    color: #F4EDE4;
    background: var(--hearth-ground);
    font-family: system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; min-width: 0; min-height: 100svh; }
  main { width: min(100%, 640px); margin: auto; padding: 36px 24px 40px; }
  header { text-align: center; }
  .occasion { margin: 0 0 10px; color: #FF9F1C; font: 12px/1.5 ui-monospace, monospace; }
  h1 { margin: 0; font-size: 17px; font-weight: 500; }
  figure { margin: 48px 0 40px; text-align: center; }
  .hearth-flame { display: block; width: 96px; height: 144px; margin: 0 auto 32px; }
  figcaption { max-width: 24ch; margin: auto; font: clamp(28px, 5.5vw, 38px)/1.24 Georgia, serif; overflow-wrap: anywhere; }
  form { max-width: 460px; margin: auto; }
  .field-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 9px; }
  label { font-size: 14px; }
  #count, .hint { color: #CFC6BB; font-size: 12px; line-height: 1.6; }
  #count { font-variant-numeric: tabular-nums; }
  textarea, input { width: 100%; min-width: 0; border: 1px solid #786553; border-radius: 6px; padding: 12px; background: #1E1915; color: #F4EDE4; font: 16px/1.5 system-ui, sans-serif; }
  textarea { display: block; min-height: 80px; resize: vertical; }
  .hint { margin: 8px 0 0; }
  .actions { display: flex; gap: 10px; margin-top: 22px; }
  button { flex: 1; min-width: 0; min-height: 48px; padding: 12px 8px; border: 1px solid #786553; border-radius: 6px; background: transparent; color: #F4EDE4; font: 500 15px/1.3 system-ui, sans-serif; cursor: pointer; touch-action: manipulation; }
  .primary { background: #FF9F1C; color: #14110F; border-color: #FF9F1C; }
  button:hover { border-color: #FF9F1C; }
  button:disabled { cursor: wait; opacity: .65; }
  :focus-visible { outline: 2px solid #FF9F1C; outline-offset: 4px; }
  .privacy { margin-top: 16px; }
  #status { font-size: 14px; line-height: 1.5; }
  #status:empty { margin: 0; }
  #fallback label { display: block; margin: 16px 0 8px; }
  noscript { text-align: center; }
  /* This small fire is still for everyone, including reduced-motion readers. */
  @media (prefers-reduced-motion: reduce) { .hearth-flame { animation: none; transition: none; } }
  @media (max-width: 420px) { main { padding: 28px 20px 32px; } figure { margin-top: 38px; } }
</style>
