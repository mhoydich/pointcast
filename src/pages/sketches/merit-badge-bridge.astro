---
/**
 * Camp Merit Badge bridge sketch. The proof library lives in
 * src/lib/loom/merit-badge-bridge.mjs. This page only draws it.
 * Samples, a local SHA-256 check, and an unsigned CC0 ticket preview.
 * Draws samples only. No wallet and no mint.
 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Camp Merit Badge bridge · PointCast</title>
    <meta name="description" content="Sample Camp Merit Badges with Block Yard SHA-256 pins, checked in the browser, plus an unsigned free CC0 ticket preview for #mint-queue." />
    <meta name="theme-color" content="#f3efe4" />
    <link rel="canonical" href="https://pointcast.xyz/sketches/merit-badge-bridge/" />
  </head>
  <body>
    <main id="bridge"></main>
    <noscript>
      <p>Turn on JavaScript to inspect the sample badges, verify their SHA-256 pins in this browser, and read the unsigned CC0 ticket. Nothing is minted either way.</p>
    </noscript>
    <script>
      import { mountMeritBadgeBridge } from '../../lib/loom/merit-badge-bridge.mjs';
      mountMeritBadgeBridge(document.querySelector('#bridge'));
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --pc-bg: #f3efe4;
    --pc-panel: #fffdf6;
    --pc-ink: #14161c;
    --pc-dim: #5d6170;
    --pc-rule: #d8d1bf;
    --pc-title: #0b2a8a;
    --pc-title-ink: #ffffff;
    --ok: #0a8a3a;
    --ok-bg: #e5f6ea;
    --bad: #9d1024;
    --bad-bg: #fde8ea;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --sans: Verdana, Tahoma, system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --pc-bg: #0d0f14;
      --pc-panel: #151821;
      --pc-ink: #e9ecf3;
      --pc-dim: #9298a8;
      --pc-rule: #2a2f3c;
      --pc-title: #1b3fd1;
      --pc-title-ink: #ffffff;
      --ok: #b6f5cb;
      --ok-bg: #102818;
      --bad: #ffb4c0;
      --bad-bg: #3a1218;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: #ebe5d3;
    color: var(--pc-ink);
    font: 16px/1.45 var(--sans);
  }
  #bridge {
    width: min(100%, 390px);
    margin: 0 auto;
    min-height: 100svh;
    padding: 0 0 28px;
    background: var(--pc-bg);
    color: var(--pc-ink);
  }
  a { color: var(--pc-title); }
  .top { padding: 18px 16px 8px; }
  .kicker {
    margin: 0 0 8px;
    color: var(--pc-title);
    font: 600 12px/1.4 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 { margin: 0 0 8px; font-size: 22px; line-height: 1.25; font-weight: 700; }
  h2 { margin: 0 0 6px; font-size: 17px; line-height: 1.3; font-weight: 700; }
  .dek, .line { margin: 0; color: var(--pc-dim); font-size: 14px; line-height: 1.5; }
  .picker { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; }
  button {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--pc-rule);
    border-radius: 8px;
    background: var(--pc-panel);
    color: var(--pc-ink);
    font: 600 15px/1.3 var(--sans);
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
  }
  button span {
    display: block;
    margin-top: 2px;
    color: var(--pc-dim);
    font: 12px/1.4 var(--mono);
    font-weight: 400;
  }
  button[aria-pressed="true"] {
    border-color: var(--pc-title);
    box-shadow: inset 3px 0 0 var(--pc-title);
  }
  .actions { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
  .actions button:first-child {
    background: var(--pc-title);
    border-color: var(--pc-title);
    color: var(--pc-title-ink);
    text-align: center;
  }
  .panel {
    margin: 0 16px 12px;
    padding: 14px;
    background: var(--pc-panel);
    border: 1px solid var(--pc-rule);
    border-radius: 10px;
  }
  dl {
    display: grid;
    grid-template-columns: 7.6rem 1fr;
    gap: 8px 10px;
    margin: 12px 0 0;
  }
  dt { color: var(--pc-dim); font: 12px/1.4 var(--mono); }
  dd { margin: 0; font: 12px/1.45 var(--mono); overflow-wrap: anywhere; }
  .status {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.45;
  }
  .status[data-ok="true"] { background: var(--ok-bg); color: var(--ok); }
  .status[data-ok="false"] { background: var(--bad-bg); color: var(--bad); }
  details { margin-top: 12px; }
  summary { cursor: pointer; font-size: 14px; min-height: 44px; display: flex; align-items: center; }
  pre {
    margin: 8px 0 0;
    padding: 10px;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: var(--pc-bg);
    border-radius: 8px;
    font: 12px/1.45 var(--mono);
  }
  .flags { margin: 8px 0 0; font: 12px/1.45 var(--mono); }
  noscript p { width: min(100%, 390px); margin: 16px auto; padding: 0 16px; }
  :focus-visible { outline: 2px solid var(--pc-title); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
