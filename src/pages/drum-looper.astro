---
/**
 * /drum-looper — overdub recorder. Recovered ship.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Noun Looper · build a loop one layer at a time · PointCast';
const description = '16-step × 5-lane drum looper. Tap cells, build a loop, share via URL hash.';
const LANES = [
  { inst: 'kick',  label: 'KICK',  color: '#ff8a4a' },
  { inst: 'snare', label: 'SNARE', color: '#cfc6df' },
  { inst: 'bell',  label: 'BELL',  color: '#f6c15e' },
  { inst: 'lead',  label: 'LEAD',  color: '#ffd400' },
  { inst: 'pad',   label: 'PAD',   color: '#a8ff3a' },
];
---
<BlockLayout title={title} description={description}>
  <main class="dl">
    <header class="dl__header">
      <h1 class="dl__title">NOUN LOOPER</h1>
      <p class="dl__tag">build a loop · 16 steps × 5 lanes · share the URL</p>
    </header>
    <section class="dl__noun-row">
      <img class="dl__noun" id="dl-noun" src="https://noun.pics/523.svg" alt="Noun keeping the seat" width="86" height="86" />
      <div class="dl__noun-meta">
        <span class="dl__noun-name">Noun #523 · Block Runner</span>
        <span class="dl__noun-role" id="dl-role">— idle —</span>
      </div>
    </section>
    <section class="dl__panel">
      <div class="dl__panel-row">
        <button class="dl__btn dl__btn--big" id="dl-toggle" type="button">▶ START</button>
        <button class="dl__btn" id="dl-clear" type="button">✕ CLEAR</button>
        <button class="dl__btn" id="dl-share" type="button">↗ SHARE</button>
        <label class="dl__tempo">
          <span class="dl__tempo-label">TEMPO</span>
          <input type="range" id="dl-tempo" min="60" max="140" step="2" value="90"/>
          <span id="dl-tempo-readout">90 bpm</span>
        </label>
      </div>
      <span class="dl__share-status" id="dl-share-status" aria-live="polite"></span>
    </section>
    <section class="dl__grid" id="dl-grid">
      {LANES.map(lane => (
        <div class="dl__lane" data-inst={lane.inst} style={`--lane-color: ${lane.color};`}>
          <span class="dl__lane-label">{lane.label}</span>
          <span class="dl__cells">
            {Array.from({length: 16}).map((_, i) => (
              <button class={`dl__cell ${i % 4 === 0 ? 'dl__cell--beat' : ''}`} data-inst={lane.inst} data-step={i} aria-pressed="false" type="button"></button>
            ))}
          </span>
        </div>
      ))}
    </section>
    <section class="dl__siblings">
      <a href="/drum-noun-radio">/drum-noun-radio</a>
      <a href="/drum-jukebox">/drum-jukebox</a>
      <a href="/drum-beat-battle">/drum-beat-battle</a>
      <a href="/drum-audiophile">/drum-audiophile</a>
    </section>
  </main>
</BlockLayout>
<style>
  .dl { max-width: 1080px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #1a0820; background: #fffaf0; min-height: 100vh; }
  .dl__header { text-align: center; margin: 18px 0 18px; }
  .dl__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 72px); letter-spacing: 0.16em; margin: 0; text-shadow: 2px 2px 0 rgba(212, 164, 55, 0.40); }
  .dl__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #5a3422; opacity: 0.85; margin: 6px 0 0; }
  .dl__noun-row { display: flex; align-items: center; gap: 16px; padding: 12px 18px; border: 2px solid #1a0820; background: #f4e7c8; box-shadow: 4px 4px 0 0 #1a0820; margin: 12px 0 18px; }
  .dl__noun { width: 86px; height: 86px; image-rendering: pixelated; filter: drop-shadow(2px 4px 0 rgba(0, 0, 0, 0.20)); transition: transform 80ms; }
  .dl__noun.dl__noun--hit { transform: translateY(-4px) scale(1.04); }
  .dl__noun-meta { display: flex; flex-direction: column; gap: 4px; font-family: 'JetBrains Mono Variable', monospace; }
  .dl__noun-name { font-size: 13px; font-weight: 800; letter-spacing: 0.10em; }
  .dl__noun-role { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #5a3422; }
  .dl__panel { padding: 14px 16px; border: 2px solid #1a0820; background: #f4e7c8; box-shadow: 4px 4px 0 0 #1a0820; margin-bottom: 18px; }
  .dl__panel-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .dl__btn { padding: 10px 18px; border: 2px solid #1a0820; background: #fffaf0; color: #1a0820; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; font-weight: 800; letter-spacing: 0.18em; cursor: pointer; transition: transform 100ms, box-shadow 100ms; box-shadow: 3px 3px 0 0 #1a0820; }
  .dl__btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 0 #1a0820; }
  .dl__btn--big { padding: 12px 22px; background: #d4a437; }
  .dl__tempo { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .dl__tempo input[type='range'] { width: 160px; }
  .dl__share-status { display: inline-block; margin-top: 6px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; color: #b8431a; letter-spacing: 0.10em; }
  .dl__grid { display: flex; flex-direction: column; gap: 8px; padding: 14px; border: 2px solid #1a0820; background: #fffaf0; box-shadow: 4px 4px 0 0 #1a0820; }
  .dl__lane { display: grid; grid-template-columns: 80px 1fr; align-items: center; gap: 12px; }
  .dl__lane-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; color: var(--lane-color, #1a0820); text-shadow: 1px 1px 0 rgba(0,0,0,0.15); }
  .dl__cells { display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 4px; }
  .dl__cell { height: 28px; border: 1px solid #1a0820; background: #fffaf0; cursor: pointer; transition: background 80ms, transform 80ms; padding: 0; }
  .dl__cell:hover { background: #f4e7c8; }
  .dl__cell--beat { border-width: 2px; }
  .dl__cell[aria-pressed='true'] { background: var(--lane-color, #d4a437); }
  .dl__cell[data-active='true'] { box-shadow: 0 0 0 2px #1a0820; transform: translateY(-1px); }
  .dl__cell[aria-pressed='true'][data-active='true'] { background: var(--lane-color, #f6c15e); box-shadow: 0 0 0 2px #1a0820, 0 0 12px var(--lane-color, #f6c15e); }
  .dl__siblings { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .dl__siblings a { color: #5a3422; text-decoration: none; }
  @media (max-width: 720px) { .dl__lane { grid-template-columns: 1fr; gap: 4px; } .dl__cell { height: 22px; } }
</style>
<script>
  const LANES = ['kick','snare','bell','lead','pad'];
  let actx: AudioContext | null = null;
  function ctx() { if (!actx) { const AC = (window as any).AudioContext || (window as any).webkitAudioContext; actx = new AC(); } if (actx && actx.state === 'suspended') actx.resume(); return actx!; }
  function pK(t:number){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(120,t);o.frequency.exponentialRampToValueAtTime(40,t+0.18);g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.25);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.3);}
  function pSn(t:number){const a=ctx(),buf=a.createBuffer(1,a.sampleRate*0.12,a.sampleRate),d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;const n=a.createBufferSource();n.buffer=buf;const bp=a.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1800;bp.Q.value=1.2;const g=a.createGain();g.gain.setValueAtTime(0.32,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.18);n.connect(bp).connect(g).connect(a.destination);n.start(t);n.stop(t+0.2);}
  function pB(t:number){const a=ctx();[1320,2640,3960].forEach((f,i)=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime([0.13,0.07,0.04][i],t);g.gain.exponentialRampToValueAtTime(0.0001,t+1.0);o.connect(g).connect(a.destination);o.start(t);o.stop(t+1.1);});}
  function pL(t:number){const a=ctx();const D=[0,4,7,12,14],deg=D[Math.floor(Math.random()*D.length)],f=264*Math.pow(2,deg/12);const o=a.createOscillator(),g=a.createGain(),lp=a.createBiquadFilter();o.type='sawtooth';o.frequency.setValueAtTime(f,t);lp.type='lowpass';lp.frequency.setValueAtTime(2200,t);lp.frequency.exponentialRampToValueAtTime(800,t+0.4);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.13,t+0.005);g.gain.exponentialRampToValueAtTime(0.0001,t+0.4);o.connect(lp).connect(g).connect(a.destination);o.start(t);o.stop(t+0.45);}
  function pP(t:number){const a=ctx();[132,198].forEach(f=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.09,t+0.18);g.gain.linearRampToValueAtTime(0.09,t+0.4);g.gain.exponentialRampToValueAtTime(0.0001,t+0.65);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.7);});}
  const PLAY: any = { kick: pK, snare: pSn, bell: pB, lead: pL, pad: pP };
  const pattern: Record<string, boolean[]> = {};
  LANES.forEach(l => pattern[l] = Array(16).fill(false));
  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('.dl__cell'));
  const noun = document.getElementById('dl-noun'); const role = document.getElementById('dl-role');
  const toggleBtn = document.getElementById('dl-toggle') as HTMLButtonElement | null;
  const tempoEl = document.getElementById('dl-tempo') as HTMLInputElement | null;
  const tempoReadout = document.getElementById('dl-tempo-readout');
  const shareStatus = document.getElementById('dl-share-status');
  let timer: number | null = null, step = 0, bpm = 90, playing = false;
  function paint() { cells.forEach(c => { const inst = c.dataset.inst!; const s = Number(c.dataset.step); c.setAttribute('aria-pressed', String(pattern[inst][s])); c.dataset.active = String(s === step && playing); }); }
  function tick() { const at = ctx().currentTime + 0.02; let firedInst: string | null = null; LANES.forEach(inst => { if (pattern[inst][step]) { try { PLAY[inst](at); } catch {} firedInst = firedInst || inst; } }); if (firedInst && noun) { noun.classList.add('dl__noun--hit'); setTimeout(() => noun.classList.remove('dl__noun--hit'), 90); if (role) role.textContent = `${firedInst} fired · step ${step + 1}`; } step = (step + 1) % 16; paint(); }
  function setTempo(b: number) { bpm = Math.max(60, Math.min(140, b)); if (tempoReadout) tempoReadout.textContent = `${bpm} bpm`; if (playing) { if (timer != null) clearInterval(timer); timer = window.setInterval(tick, (60 / bpm / 4) * 1000); } }
  function start() { if (playing) return; ctx(); playing = true; step = 0; if (toggleBtn) toggleBtn.textContent = '■ STOP'; tick(); timer = window.setInterval(tick, (60 / bpm / 4) * 1000); }
  function stop() { if (!playing) return; playing = false; if (timer != null) { clearInterval(timer); timer = null; } if (toggleBtn) toggleBtn.textContent = '▶ START'; if (role) role.textContent = '— idle —'; paint(); }
  function clearAll() { LANES.forEach(l => pattern[l] = Array(16).fill(false)); paint(); }
  function encodePattern(): string { const bytes = new Uint8Array(10); let bit = 0; LANES.forEach(inst => { pattern[inst].forEach(v => { if (v) bytes[Math.floor(bit / 8)] |= 1 << (bit % 8); bit++; }); }); let bin = ''; for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]); return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); }
  function decodePattern(str: string) { try { const bin = atob(str.replace(/-/g, '+').replace(/_/g, '/')); const bytes = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i); let bit = 0; LANES.forEach(inst => { pattern[inst] = Array(16).fill(false).map(() => { const v = !!(bytes[Math.floor(bit / 8)] & (1 << (bit % 8))); bit++; return v; }); }); paint(); } catch {} }
  cells.forEach(c => c.addEventListener('click', () => { const inst = c.dataset.inst!; const s = Number(c.dataset.step); pattern[inst][s] = !pattern[inst][s]; paint(); }));
  if (toggleBtn) toggleBtn.addEventListener('click', () => { playing ? stop() : start(); });
  if (tempoEl) tempoEl.addEventListener('input', e => setTempo(Number((e.target as HTMLInputElement).value)));
  document.getElementById('dl-clear')?.addEventListener('click', clearAll);
  document.getElementById('dl-share')?.addEventListener('click', async () => {
    const code = encodePattern();
    const url = `${location.origin}/drum-looper#${code}-${bpm}`;
    try { await navigator.clipboard.writeText(url); if (shareStatus) shareStatus.textContent = '✓ url copied to clipboard'; }
    catch { if (shareStatus) shareStatus.textContent = `share url: ${url}`; }
    setTimeout(() => { if (shareStatus) shareStatus.textContent = ''; }, 4000);
  });
  if (location.hash.length > 1) {
    const parts = location.hash.slice(1).split('-');
    if (parts[0]) decodePattern(parts[0]);
    if (parts[1] && Number(parts[1])) { const b = Math.max(60, Math.min(140, Number(parts[1]))); bpm = b; if (tempoEl) tempoEl.value = String(b); if (tempoReadout) tempoReadout.textContent = `${b} bpm`; }
  } else {
    pattern.kick  = [true,false,false,false, true,false,false,true, true,false,false,false, true,false,true,false];
    pattern.snare = [false,false,false,false, true,false,false,false, false,false,false,false, true,false,false,true];
    pattern.bell  = [false,false,true,false, false,false,false,false, true,false,false,false, false,false,true,false];
    pattern.lead  = Array(16).fill(false);
    pattern.pad   = [true,false,false,false, false,false,false,false, true,false,false,false, false,false,false,false];
    paint();
  }
  paint();
</script>
