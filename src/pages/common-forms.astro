---
import BlockLayout from '../layouts/BlockLayout.astro';
import { COMMISSIONS, FORM_VOCABULARY, INFLUENCES, PLAN_META, PRINCIPLES, SEQUENCE, STEWARDSHIP_NOTES } from '../lib/commonForms';

const title = `${PLAN_META.title} — ${PLAN_META.subtitle}`;
const description = PLAN_META.thesis;

const totalLow = COMMISSIONS.reduce((s, c) => s + c.costLow, 0);
const totalHigh = COMMISSIONS.reduce((s, c) => s + c.costHigh, 0);

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  '@id': 'https://pointcast.xyz/common-forms',
  name: PLAN_META.title,
  alternateName: PLAN_META.subtitle,
  description,
  url: 'https://pointcast.xyz/common-forms',
  isPartOf: { '@type': 'Periodical', name: PLAN_META.publication },
  datePublished: PLAN_META.date,
  author: PLAN_META.authors.map((a) => ({ '@type': 'Person', name: a.name, affiliation: { '@type': 'Organization', name: a.dept } })),
  publisher: { '@type': 'EducationalOrganization', name: PLAN_META.affiliation, url: 'https://pointcast.xyz/university-of-el-segundo' },
};

const tierColor = { A: '#7a8c4f', B: '#c97b56', C: '#2a3550' };
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/common-forms.json', title: 'Common Forms (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span>
      <span>common-forms</span>
    </nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">UES-WP-2026-11 · CIVIC ARCHITECTURE · 12 COMMISSIONS · 25-MILE RADIUS</p>
      <h1>COMMON / FORMS.</h1>
      <p class="subtitle">{PLAN_META.subtitle}</p>
      <p class="tagline">{PLAN_META.tagline}</p>
      <p class="thesis">{PLAN_META.thesis}</p>
      <div class="meta">
        <span><strong>{COMMISSIONS.length}</strong> commissions</span>
        <span><strong>3</strong> tiers</span>
        <span><strong>${totalLow.toLocaleString()}–${totalHigh.toLocaleString()}</strong> total cost band</span>
        <span><strong>50</strong>-year design life</span>
      </div>
    </header>

    <section class="principles">
      <p class="kicker">PRINCIPLES</p>
      <h2>Seven rules before any concrete is poured.</h2>
      <ol class="rules">{PRINCIPLES.map((p, i) => (
        <li><span>{String(i+1).padStart(2,'0')}</span><p>{p}</p></li>
      ))}</ol>
    </section>

    <section class="vocab">
      <p class="kicker">FORM VOCABULARY</p>
      <h2>Six materials. No others.</h2>
      <ol class="materials">{FORM_VOCABULARY.map((m) => (
        <li>
          <h3>{m.material}</h3>
          <p class="materials__use">{m.use}</p>
          <p class="materials__source"><strong>Source:</strong> {m.source}</p>
        </li>
      ))}</ol>
    </section>

    <section class="commissions">
      <p class="kicker">THE COMMISSIONS · 12 IN 3 TIERS</p>
      <h2>From bench to pavilion.</h2>
      <ol class="comm-list">{COMMISSIONS.map((c) => (
        <li class={`comm comm--tier-${c.tier}`}>
          <div class="comm__head">
            <span class="comm__num">{c.number}</span>
            <span class="comm__tier" style={`background: ${tierColor[c.tier]};`}>{c.tierLabel}</span>
            <span class="comm__phase">Commons {c.commonsPhase}</span>
          </div>
          <h3>{c.name}</h3>
          <div class="comm__schematic" aria-hidden="true">
            {c.schematic === 'bench' && (<svg viewBox="0 0 200 100"><rect x="20" y="50" width="160" height="6" fill="#1a1a1a" /><rect x="20" y="50" width="160" height="6" fill="#6b4a1f" /><rect x="30" y="56" width="6" height="30" fill="#1a1a1a" /><rect x="164" y="56" width="6" height="30" fill="#1a1a1a" /></svg>)}
            {c.schematic === 'plaque' && (<svg viewBox="0 0 200 100"><rect x="50" y="20" width="100" height="60" fill="#7a4f1a" stroke="#1a1a1a" stroke-width="2" /><line x1="60" y1="40" x2="140" y2="40" stroke="#1a1a1a" stroke-width="0.5" /><line x1="60" y1="50" x2="140" y2="50" stroke="#1a1a1a" stroke-width="0.5" /><line x1="60" y1="60" x2="120" y2="60" stroke="#1a1a1a" stroke-width="0.5" /></svg>)}
            {c.schematic === 'bollard' && (<svg viewBox="0 0 200 100"><rect x="60" y="40" width="20" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1.5" /><rect x="100" y="40" width="20" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1.5" /><rect x="140" y="40" width="20" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1.5" /><rect x="60" y="38" width="20" height="3" fill="#7a4f1a" /><rect x="100" y="38" width="20" height="3" fill="#7a4f1a" /><rect x="140" y="38" width="20" height="3" fill="#7a4f1a" /><line x1="0" y1="90" x2="200" y2="90" stroke="#1a1a1a" stroke-width="2" /></svg>)}
            {c.schematic === 'inlay' && (<svg viewBox="0 0 200 100"><rect x="0" y="40" width="200" height="40" fill="#c8c4b3" /><line x1="0" y1="40" x2="200" y2="40" stroke="#1a1a1a" stroke-width="1" /><line x1="0" y1="80" x2="200" y2="80" stroke="#1a1a1a" stroke-width="1" /><line x1="40" y1="35" x2="160" y2="85" stroke="#7a4f1a" stroke-width="3" /></svg>)}
            {c.schematic === 'deck' && (<svg viewBox="0 0 200 100"><rect x="20" y="50" width="120" height="14" fill="#a8a39a" stroke="#1a1a1a" stroke-width="2" /><line x1="20" y1="50" x2="20" y2="20" stroke="#7a4f1a" stroke-width="3" /><line x1="60" y1="50" x2="60" y2="20" stroke="#7a4f1a" stroke-width="3" /><polygon points="140,50 200,90 200,100 140,100" fill="#7a8c4f" /></svg>)}
            {c.schematic === 'court' && (<svg viewBox="0 0 200 100"><rect x="20" y="20" width="160" height="60" fill="#5a8a8a" stroke="#1a1a1a" stroke-width="2" /><rect x="40" y="30" width="120" height="40" fill="#7a8898" /><line x1="100" y1="20" x2="100" y2="80" stroke="#fdf9ee" stroke-width="1.5" /><line x1="40" y1="50" x2="160" y2="50" stroke="#fdf9ee" stroke-width="1.5" /></svg>)}
            {c.schematic === 'pavilion' && (<svg viewBox="0 0 200 100"><rect x="40" y="30" width="120" height="6" fill="#7a4f1a" stroke="#1a1a1a" stroke-width="1" /><rect x="50" y="36" width="8" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1" /><rect x="142" y="36" width="8" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1" /><rect x="90" y="36" width="8" height="50" fill="#a8a39a" stroke="#1a1a1a" stroke-width="1" /><line x1="0" y1="86" x2="200" y2="86" stroke="#1a1a1a" stroke-width="2" /></svg>)}
            {c.schematic === 'storefront' && (<svg viewBox="0 0 200 100"><rect x="20" y="20" width="160" height="60" fill="#fff" stroke="#1a1a1a" stroke-width="2" /><line x1="100" y1="20" x2="100" y2="80" stroke="#1a1a1a" stroke-width="1" /><rect x="20" y="60" width="160" height="20" fill="#7a4f1a" /><rect x="92" y="50" width="16" height="30" fill="#a8a39a" stroke="#1a1a1a" stroke-width="0.5" /></svg>)}
            {c.schematic === 'garden' && (<svg viewBox="0 0 200 100"><rect x="0" y="60" width="200" height="40" fill="#7a8c4f" /><line x1="0" y1="60" x2="200" y2="60" stroke="#1a1a1a" stroke-width="2" /><circle cx="40" cy="50" r="6" fill="#c97b56" /><circle cx="80" cy="48" r="5" fill="#d4a534" /><circle cx="120" cy="50" r="6" fill="#7a4f1a" /><circle cx="160" cy="48" r="5" fill="#a06478" /></svg>)}
          </div>
          <p class="comm__site"><strong>Site:</strong> {c.site}</p>
          <p class="comm__form"><strong>Form:</strong> <span set:html={c.form} /></p>
          <p class="comm__materials"><strong>Materials:</strong> {c.materials.join(', ')}.</p>
          <p class="comm__cost"><strong>Cost:</strong> {c.cost}</p>
          <p class="comm__steward"><strong>Stewardship:</strong> {c.stewardship}</p>
          <p class="comm__trigger"><strong>Trigger:</strong> {c.triggerCondition}</p>
          <p class="comm__program"><strong>Lights up:</strong> {c.uesProgram}</p>
          <p class="comm__desc"><em>{c.description}</em></p>
        </li>
      ))}</ol>
    </section>

    <section class="sequence">
      <p class="kicker">BUILD SEQUENCE · 6 YEARS</p>
      <h2>What gets built when.</h2>
      <ol class="seq-list">{SEQUENCE.map((s) => (
        <li class="seq">
          <div class="seq__head"><span class="seq__phase">{s.phase}</span><span class="seq__cost">{s.totalCost}</span></div>
          <ul class="seq__commissions">{s.commissions.map((c) => (<li>{c}</li>))}</ul>
          <p class="seq__narr">{s.narrative}</p>
        </li>
      ))}</ol>
    </section>

    <section class="influences">
      <p class="kicker">INFLUENCES</p>
      <h2>What the plan inherits.</h2>
      <ol class="inf-list">{INFLUENCES.map((i) => (
        <li class="inf">
          <h3>{i.name}</h3>
          <p class="inf__meta">{i.architect} · {i.year} · {i.locality}</p>
          <p class="inf__lesson">{i.lesson}</p>
        </li>
      ))}</ol>
    </section>

    <section class="open-questions">
      <p class="kicker">OPEN QUESTIONS · MIKE APPROVAL</p>
      <h2>Four decisions before construction.</h2>
      <ol class="oq">{STEWARDSHIP_NOTES.openQuestions.map((q) => (
        <li>{q}</li>
      ))}</ol>
    </section>

    <section class="acks">
      <p class="kicker">ACKNOWLEDGMENTS · COLOPHON</p>
      <p>{STEWARDSHIP_NOTES.acknowledgments}</p>
      <p class="colophon"><em>{STEWARDSHIP_NOTES.uesNote}</em> Set in JetBrains Mono and Inter. Schematics are SVG, deliberately small. The plan is a tribute to the form. Comments to <a href="mailto:mh@pointcast.xyz">mh@pointcast.xyz</a>.</p>
    </section>

    <section class="links">
      <a href="/commons">PointCast Commons</a>
      <a href="/sponsor-a-bench">Sponsor a Bench</a>
      <a href="/marine-layer">Marine Layer</a>
      <a href="/civic-layer">Civic Layer</a>
      <a href="/geology">Geology</a>
      <a href="/labs">Labs series</a>
      <a href="/common-forms.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root {
    --cf-ink: #1a1a1a;
    --cf-paper: #f4ecd9;
    --cf-concrete: #c8c4b3;
    --cf-rust: #b85a3a;
    --cf-mustard: #d4a534;
    --cf-fir: #6b4a1f;
    --cf-sage: #7a8c4f;
    --cf-navy: #2a3550;
    --cf-mauve: #a06478;
  }
  .page { max-width: 1200px; margin: 0 auto; padding: 0 0 88px; background: var(--cf-paper); color: var(--cf-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--cf-ink); text-decoration: underline; text-underline-offset: 3px; }

  .hero { padding: 18px 28px 44px; }
  .hero__bar { height: 14px; background: var(--cf-ink); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cf-ink); margin: 0 0 10px; padding: 4px 8px; background: var(--cf-mustard); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-family: Inter, sans-serif; font-size: 24px; font-weight: 500; margin: 0 0 8px; max-width: 30ch; }
  .tagline { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; margin: 0 0 18px; }
  .thesis { font-size: 17px; line-height: 1.55; max-width: 64ch; margin: 0 0 18px; }
  .meta { display: flex; flex-wrap: wrap; gap: 22px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .meta strong { color: var(--cf-ink); font-size: 14px; }

  section { padding: 36px 28px; border-top: 4px solid var(--cf-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 32px; line-height: 1; font-weight: 700; letter-spacing: -.01em; margin: 0 0 18px; text-transform: uppercase; }

  .rules { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .rules li { display: grid; grid-template-columns: 56px 1fr; align-items: baseline; gap: 14px; padding: 12px 14px; background: #fff; border: 2px solid var(--cf-ink); }
  .rules span { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--cf-rust); }
  .rules p { margin: 0; font-size: 15px; line-height: 1.5; }

  .materials { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .materials li { padding: 14px 16px; background: #fff; border: 2px solid var(--cf-ink); }
  .materials h3 { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 6px; font-weight: 700; }
  .materials__use { margin: 0 0 8px; font-size: 14px; line-height: 1.5; }
  .materials__source { margin: 0; font-size: 12px; color: #5a5450; }
  .materials strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }

  .comm-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .comm { padding: 16px 18px; background: #fff; border: 2px solid var(--cf-ink); position: relative; }
  .comm--tier-A { border-left: 12px solid var(--cf-sage); }
  .comm--tier-B { border-left: 12px solid var(--cf-rust); }
  .comm--tier-C { border-left: 12px solid var(--cf-navy); }
  .comm__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 6px; }
  .comm__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--cf-ink); }
  .comm__tier { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #fff; padding: 4px 8px; }
  .comm__phase { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; margin-left: auto; }
  .comm h3 { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; line-height: 1.1; margin: 4px 0 12px; letter-spacing: -.005em; }
  .comm__schematic { width: 200px; height: 100px; background: var(--cf-paper); border: 1px solid var(--cf-ink); margin-bottom: 12px; }
  .comm__schematic svg { width: 100%; height: 100%; display: block; }
  .comm p { margin: 0 0 6px; font-size: 14px; line-height: 1.55; }
  .comm strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; margin-right: 4px; }
  .comm__desc { margin: 12px 0 0 !important; padding-top: 10px; border-top: 1px solid var(--cf-concrete); font-size: 13.5px; color: #2a2a2a; }
  .comm__desc em { font-style: italic; }

  .seq-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .seq { padding: 14px 16px; background: #fff; border: 2px solid var(--cf-ink); }
  .seq__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 6px; flex-wrap: wrap; }
  .seq__phase { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; font-weight: 700; }
  .seq__cost { font-family: var(--pc-font-mono); font-size: 14px; color: var(--cf-rust); font-weight: 700; }
  .seq__commissions { list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px; }
  .seq__commissions li { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .04em; padding: 3px 7px; background: var(--cf-paper); border: 1px solid var(--cf-ink); }
  .seq__narr { margin: 0; font-size: 14px; line-height: 1.5; font-style: italic; color: #2a2a2a; }

  .inf-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .inf { padding: 12px 14px; background: #fff; border: 1.5px solid var(--cf-ink); }
  .inf h3 { font-family: var(--pc-font-mono); font-size: 14px; font-weight: 700; margin: 0 0 4px; }
  .inf__meta { margin: 0 0 6px; font-size: 12px; color: #5a5450; font-style: italic; }
  .inf__lesson { margin: 0; font-size: 13px; line-height: 1.5; }

  .open-questions ol.oq { list-style: decimal; padding-left: 22px; margin: 0; font-size: 14px; line-height: 1.55; }
  .open-questions ol.oq li { margin-bottom: 8px; }

  .acks p { font-size: 14px; line-height: 1.55; margin: 0 0 8px; max-width: 70ch; }
  .acks .colophon { font-size: 13px; color: #2a2a2a; }
  .acks a { color: var(--cf-ink); text-decoration: underline; text-underline-offset: 3px; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 14px; background: var(--cf-ink); color: var(--cf-paper); text-decoration: none; }
  .links a:hover { background: var(--cf-rust); }

  @media (max-width: 800px) {
    h1 { font-size: 64px; }
    .materials { grid-template-columns: 1fr; }
    .inf-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    h1 { font-size: 44px; }
    .subtitle { font-size: 18px; }
  }
</style>
