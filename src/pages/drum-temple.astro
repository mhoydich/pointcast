---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Temple — taiko ceremony, ten minutes, no buttons" description="A green pavilion looking onto a temple courtyard at dusk. Two large taiko drums, a stone lantern, a plum branch. The ceremony begins with single hits and builds to a peak of rolling taiko and gong, then settles. Set it and listen.">
  <main class="dt" id="dt" data-built={built}>
    <header class="dt__hero">
      <p class="dt__kicker">DRUM · TEMPLE · taiko · gong · stone lantern</p>
      <h1 class="dt__title">A ceremony in a quiet courtyard.</h1>
      <p class="dt__sub">A green pavilion looking onto a temple courtyard at dusk. Two large taiko drums, a stone lantern, a plum branch in the foreground. The ceremony begins with single hits and builds — rolls of taiko, gong washes, the bell — and then settles back to single hits and silence. Ten minutes.</p>
    </header>

    <section class="dt__stage" id="dt-stage" data-state="idle">
      <div class="dt__pavilion" aria-hidden="true">
        <div class="dt__rail dt__rail--top"></div>
        <div class="dt__rail dt__rail--bottom"></div>
        <div class="dt__post dt__post--left"></div>
        <div class="dt__post dt__post--right"></div>
        <svg class="dt__scene" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="dtSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#e7d4b0"/>
              <stop offset="55%" stop-color="#d8a87a"/>
              <stop offset="100%" stop-color="#bd7a52"/>
            </linearGradient>
            <linearGradient id="dtFloor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#7a6a52"/>
              <stop offset="100%" stop-color="#3a2e22"/>
            </linearGradient>
            <linearGradient id="dtTaikoSkin" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f0e0c0"/>
              <stop offset="100%" stop-color="#c8a878"/>
            </linearGradient>
            <linearGradient id="dtTaikoShell" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#7a3220"/>
              <stop offset="50%" stop-color="#5a2418"/>
              <stop offset="100%" stop-color="#2a1208"/>
            </linearGradient>
            <radialGradient id="dtGong" cx="50%" cy="40%" r="60%">
              <stop offset="0%" stop-color="#e8c878"/>
              <stop offset="55%" stop-color="#a08038"/>
              <stop offset="100%" stop-color="#503820"/>
            </radialGradient>
            <radialGradient id="dtLantern" cx="50%" cy="50%" r="60%">
              <stop offset="0%" stop-color="#9a9088"/>
              <stop offset="100%" stop-color="#605850"/>
            </radialGradient>
          </defs>

          <!-- Sky / back wall — dusk gradient -->
          <rect x="0" y="0" width="1200" height="420" fill="url(#dtSky)"/>
          <!-- Distant mountain silhouette -->
          <path d="M 0 420 L 0 350 L 180 280 L 360 320 L 540 260 L 720 310 L 900 270 L 1080 305 L 1200 290 L 1200 420 Z" fill="#7a5238" opacity="0.55"/>
          <!-- Floor: stone tiles in perspective -->
          <rect x="0" y="400" width="1200" height="300" fill="url(#dtFloor)"/>
          <!-- Tile grid -->
          <g stroke="rgba(0,0,0,0.22)" stroke-width="0.6" fill="none">
            <line x1="0" y1="440" x2="1200" y2="440"/>
            <line x1="0" y1="490" x2="1200" y2="490"/>
            <line x1="0" y1="550" x2="1200" y2="550"/>
            <line x1="0" y1="620" x2="1200" y2="620"/>
          </g>
          <!-- Vertical perspective lines converging toward a vanishing point center -->
          <g stroke="rgba(0,0,0,0.18)" stroke-width="0.5" fill="none">
            <line x1="0"    y1="400" x2="480"  y2="700"/>
            <line x1="150"  y1="400" x2="540"  y2="700"/>
            <line x1="300"  y1="400" x2="610"  y2="700"/>
            <line x1="450"  y1="400" x2="640"  y2="700"/>
            <line x1="600"  y1="400" x2="600"  y2="700"/>
            <line x1="750"  y1="400" x2="560"  y2="700"/>
            <line x1="900"  y1="400" x2="500"  y2="700"/>
            <line x1="1050" y1="400" x2="420"  y2="700"/>
            <line x1="1200" y1="400" x2="720"  y2="700"/>
          </g>

          <!-- Stone lantern, back-left -->
          <g transform="translate(220, 320)">
            <rect x="-22" y="60" width="44" height="14" fill="url(#dtLantern)" stroke="rgba(0,0,0,0.35)"/>
            <polygon points="-18,60 18,60 14,38 -14,38" fill="url(#dtLantern)" stroke="rgba(0,0,0,0.35)"/>
            <rect x="-14" y="0" width="28" height="38" fill="#3a3530" stroke="rgba(0,0,0,0.4)"/>
            <!-- Light glow from lantern interior -->
            <rect x="-9" y="6" width="18" height="14" fill="#f6c15e" opacity="0.6"/>
            <rect x="-9" y="6" width="18" height="14" fill="none" stroke="rgba(0,0,0,0.5)"/>
            <polygon points="-22,0 22,0 18,-12 -18,-12" fill="url(#dtLantern)" stroke="rgba(0,0,0,0.4)"/>
            <rect x="-3" y="-12" width="6" height="6" fill="url(#dtLantern)"/>
            <circle cx="0" cy="-14" r="3" fill="url(#dtLantern)"/>
            <!-- Soft glow on ground -->
            <ellipse cx="0" cy="86" rx="80" ry="10" fill="#f6c15e" opacity="0.18"/>
          </g>

          <!-- Plum branch, hanging from top-left -->
          <g class="dt__branch">
            <path d="M 0 0 Q 50 80 130 110 Q 220 130 310 120" fill="none" stroke="#3a2418" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M 130 110 Q 150 140 175 165" fill="none" stroke="#3a2418" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M 220 124 Q 245 145 268 160" fill="none" stroke="#3a2418" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M 310 120 Q 340 135 365 145" fill="none" stroke="#3a2418" stroke-width="2" stroke-linecap="round"/>
            <!-- Plum blossoms (pink) -->
            <g fill="#f5d2d8">
              <circle cx="175" cy="165" r="6"/>
              <circle cx="270" cy="160" r="5.5"/>
              <circle cx="360" cy="145" r="6"/>
              <circle cx="60" cy="40" r="4"/>
              <circle cx="105" cy="80" r="4.5"/>
              <circle cx="200" cy="125" r="4.5"/>
            </g>
            <g fill="#e8a8b6">
              <circle cx="175" cy="165" r="3.5"/>
              <circle cx="270" cy="160" r="3"/>
              <circle cx="360" cy="145" r="3.5"/>
              <circle cx="60" cy="40" r="2"/>
              <circle cx="105" cy="80" r="2.5"/>
              <circle cx="200" cy="125" r="2.5"/>
            </g>
          </g>

          <!-- Big taiko (left), on wooden cradle -->
          <g class="dt__drum dt__drum--big" data-voice="big">
            <!-- Shadow -->
            <ellipse cx="540" cy="640" rx="140" ry="22" fill="rgba(0,0,0,0.28)"/>
            <!-- Cradle legs -->
            <path d="M 430 540 L 410 640 L 430 640 L 450 540 Z" fill="#3a2418"/>
            <path d="M 650 540 L 670 640 L 650 640 L 630 540 Z" fill="#3a2418"/>
            <!-- Drum body -->
            <ellipse cx="540" cy="610" rx="140" ry="22" fill="#2a1208"/>
            <rect x="400" y="430" width="280" height="180" rx="14" fill="url(#dtTaikoShell)" stroke="#1a0c04" stroke-width="1.2"/>
            <!-- Top skin -->
            <ellipse cx="540" cy="430" rx="140" ry="22" fill="url(#dtTaikoSkin)" stroke="#8a5c30" stroke-width="1.2"/>
            <ellipse cx="540" cy="430" rx="130" ry="18" fill="none" stroke="rgba(0,0,0,0.1)"/>
            <!-- Rope tacks around perimeter -->
            <g fill="#2a1208">
              <circle cx="416" cy="430" r="3"/>
              <circle cx="448" cy="424" r="3"/>
              <circle cx="486" cy="420" r="3"/>
              <circle cx="540" cy="418" r="3"/>
              <circle cx="594" cy="420" r="3"/>
              <circle cx="632" cy="424" r="3"/>
              <circle cx="664" cy="430" r="3"/>
            </g>
            <!-- Decorative center mark -->
            <circle cx="540" cy="430" r="10" fill="#5a2418" opacity="0.5"/>
            <!-- Pulse ring -->
            <ellipse class="dt__drum-ring" cx="540" cy="430" rx="156" ry="28" fill="none" stroke="#f6c15e" stroke-width="2.5" opacity="0"/>
          </g>

          <!-- Small taiko (right) -->
          <g class="dt__drum dt__drum--small" data-voice="small">
            <ellipse cx="860" cy="620" rx="78" ry="14" fill="rgba(0,0,0,0.25)"/>
            <path d="M 800 540 L 790 620 L 805 620 L 820 540 Z" fill="#3a2418"/>
            <path d="M 920 540 L 930 620 L 915 620 L 900 540 Z" fill="#3a2418"/>
            <ellipse cx="860" cy="595" rx="78" ry="14" fill="#2a1208"/>
            <rect x="782" y="465" width="156" height="130" rx="10" fill="url(#dtTaikoShell)" stroke="#1a0c04" stroke-width="1"/>
            <ellipse cx="860" cy="465" rx="78" ry="14" fill="url(#dtTaikoSkin)" stroke="#8a5c30" stroke-width="1"/>
            <ellipse cx="860" cy="465" rx="72" ry="11" fill="none" stroke="rgba(0,0,0,0.1)"/>
            <g fill="#2a1208">
              <circle cx="792" cy="465" r="2.4"/>
              <circle cx="820" cy="460" r="2.4"/>
              <circle cx="858" cy="457" r="2.4"/>
              <circle cx="898" cy="460" r="2.4"/>
              <circle cx="928" cy="465" r="2.4"/>
            </g>
            <circle cx="860" cy="465" r="6" fill="#5a2418" opacity="0.5"/>
            <ellipse class="dt__drum-ring" cx="860" cy="465" rx="92" ry="20" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>

          <!-- Gong (back, hanging from frame) -->
          <g class="dt__drum dt__drum--gong" data-voice="gong">
            <line x1="1010" y1="160" x2="1010" y2="220" stroke="#3a2418" stroke-width="2"/>
            <line x1="1110" y1="160" x2="1110" y2="220" stroke="#3a2418" stroke-width="2"/>
            <line x1="1010" y1="160" x2="1110" y2="160" stroke="#3a2418" stroke-width="2.5"/>
            <line x1="1060" y1="160" x2="1060" y2="232" stroke="#3a2418" stroke-width="1"/>
            <!-- Gong disc -->
            <circle cx="1060" cy="290" r="62" fill="url(#dtGong)" stroke="#3a2410" stroke-width="1.5"/>
            <circle cx="1060" cy="290" r="44" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="0.8"/>
            <circle cx="1060" cy="290" r="26" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="0.8"/>
            <circle cx="1060" cy="290" r="12" fill="#7a5828"/>
            <!-- Pulse ring -->
            <circle class="dt__drum-ring" cx="1060" cy="290" r="76" fill="none" stroke="#f6c15e" stroke-width="2.5" opacity="0"/>
          </g>

          <!-- Wood block (small, on the right of small taiko) -->
          <g class="dt__drum dt__drum--block" data-voice="block">
            <ellipse cx="990" cy="540" rx="22" ry="4" fill="rgba(0,0,0,0.25)"/>
            <rect x="970" y="510" width="40" height="26" rx="3" fill="#5a3a22" stroke="#2a1808" stroke-width="0.8"/>
            <rect x="975" y="516" width="30" height="3" fill="rgba(0,0,0,0.3)"/>
            <ellipse class="dt__drum-ring" cx="990" cy="523" rx="32" ry="14" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>

          <!-- Bell on a stand (small, far right of frame) -->
          <g class="dt__drum dt__drum--bell" data-voice="bell">
            <line x1="170" y1="510" x2="170" y2="580" stroke="#3a2418" stroke-width="2"/>
            <path d="M 145 510 Q 145 470 170 470 Q 195 470 195 510 Z" fill="#a08038" stroke="#3a2418" stroke-width="1"/>
            <ellipse cx="170" cy="510" rx="25" ry="6" fill="#7a5828" stroke="#3a2418" stroke-width="0.8"/>
            <circle cx="170" cy="490" r="3" fill="#3a2418"/>
            <circle class="dt__drum-ring" cx="170" cy="490" r="34" fill="none" stroke="#f6c15e" stroke-width="2" opacity="0"/>
          </g>

          <!-- Subtle floor shadow under the entire arrangement -->
          <ellipse cx="700" cy="660" rx="380" ry="14" fill="rgba(0,0,0,0.16)"/>
        </svg>
      </div>

      <div class="dt__overlay" id="dt-overlay">
        <button class="dt__play" id="dt-play" type="button" aria-label="Begin">
          <span class="dt__play-icon" id="dt-play-icon">▶</span>
          <span class="dt__play-label" id="dt-play-label">Begin</span>
        </button>
        <p class="dt__overlay-hint">ten minutes · headphones recommended · no buttons after this</p>
      </div>

      <div class="dt__status" id="dt-status" hidden>
        <span class="dt__status-time" id="dt-status-time">00:00</span>
        <span class="dt__status-sep">of</span>
        <span class="dt__status-total">10:00</span>
        <span class="dt__status-section" id="dt-status-section">approach</span>
        <button class="dt__end" id="dt-end" type="button">end early</button>
      </div>
    </section>

    <section class="dt__about">
      <h2 class="dt__about-h">The ceremony</h2>
      <p>Taiko drumming is built on contrast: long silences punctuated by single decisive strikes, with bursts of rolling intensity that build and resolve. This page is shaped like a small ceremony in ten parts — <em>approach, settle, offering, gathering, ascent, peak, descent, release, fade, leave</em>. Hits per slot stay low for most of the arc and only briefly climb at the peak.</p>
      <p>Five synth voices: big taiko (80→40 Hz sine drop + filtered noise body, 0.6 s decay), small taiko (140→80 Hz, 0.4 s), wood block (800 Hz square pulse, 25 ms), gong (band-passed noise + sub partials, 5 s decay), bell (six sine partials, longest decay 4 s). Tempo is slow — 44 BPM — and most slots stay silent.</p>
      <p>The peak section is where the rolls happen: brief eighth-note bursts on the big taiko. The gong fires once at the peak and once on the release, separated by a long held silence.</p>
      <p>Sister surfaces: <a href="/drum-garden">/drum-garden</a> (a small kit in a zen garden) · <a href="/drum-rain">/drum-rain</a> (a storm of drum hits on a tile floor). Together they cover the meditative-drum register from three angles — quiet kit, weather, ceremony.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --dt-frame: #1f5e3a;
      --dt-cream: #f4f1e5;
      --dt-text: #2a3326;
      --dt-text-dim: #5a6356;
      --dt-text-dimmer: #8a9285;
      --dt-flame: #d68f2c;
    }

    body:has(.dt) {
      background: radial-gradient(circle at 50% 20%, #f8f6ec 0%, #ece8d8 70%);
      color: var(--dt-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dt { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }

    .dt__hero { text-align: left; max-width: 760px; margin: 0 auto 36px; }
    .dt__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--dt-frame);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .dt__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--dt-text);
    }
    .dt__sub {
      font-size: 17px; line-height: 1.55;
      color: var(--dt-text-dim);
      margin: 0;
    }

    .dt__stage { position: relative; margin-bottom: 36px; }
    .dt__pavilion {
      position: relative;
      aspect-ratio: 12 / 7;
      max-height: 75vh;
      background: var(--dt-cream);
      border: 14px solid var(--dt-frame);
      border-radius: 4px;
      box-shadow: 0 24px 60px rgba(31,94,58,0.18), inset 0 0 0 3px rgba(255,255,255,0.4);
      overflow: hidden;
    }
    .dt__rail { position: absolute; left: 0; right: 0; height: 16px; background: var(--dt-frame); z-index: 2; }
    .dt__rail--top { top: 0; }
    .dt__rail--bottom { bottom: 0; }
    .dt__post { position: absolute; top: 0; bottom: 0; width: 14px; background: var(--dt-frame); z-index: 2; }
    .dt__post--left  { left: 33%; }
    .dt__post--right { right: 33%; }

    .dt__scene { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }

    @keyframes dtPulse {
      0%   { opacity: 0.9; transform: scale(1); }
      100% { opacity: 0;   transform: scale(1.22); }
    }
    .dt__drum-ring.dt__drum-ring--pulse {
      animation: dtPulse 1.8s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .dt__drum--struck { animation: dtStrike 0.4s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes dtStrike {
      0%   { transform: translateY(0); }
      25%  { transform: translateY(3px) scale(0.98); }
      100% { transform: translateY(0); }
    }
    .dt__branch {
      transform: translate(40px, 80px);
      transform-origin: 0 0;
      animation: dtSway 14s ease-in-out infinite alternate;
    }
    @keyframes dtSway {
      from { transform: translate(40px, 80px) rotate(-1deg); }
      to   { transform: translate(40px, 80px) rotate(1deg); }
    }

    .dt__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(244,241,229,0.35) 0%, rgba(244,241,229,0.08) 60%, transparent 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .dt__stage[data-state="playing"] .dt__overlay,
    .dt__stage[data-state="ended"] .dt__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .dt__stage[data-state="ended"] .dt__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .dt__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0; border: 0; background: transparent; cursor: pointer;
    }
    .dt__play-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: var(--dt-frame);
      color: #fff;
      font-size: 32px;
      display: flex; align-items: center; justify-content: center;
      box-shadow:
        0 14px 36px rgba(31,94,58,0.32),
        inset 0 -4px 8px rgba(0,0,0,0.12),
        inset 0 4px 6px rgba(255,255,255,0.18);
      transition: transform 100ms ease;
    }
    .dt__play:hover .dt__play-icon { transform: scale(1.04); }
    .dt__play:active .dt__play-icon { transform: scale(0.96); }
    .dt__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: var(--dt-text);
      letter-spacing: 0.04em;
    }
    .dt__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--dt-text-dimmer);
      text-transform: lowercase;
      margin: 0;
    }

    .dt__status {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(244,241,229,0.85);
      border: 1px solid rgba(31,94,58,0.18);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--dt-text-dim);
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .dt__stage[data-state="playing"] .dt__status,
    .dt__stage[data-state="ended"] .dt__status { opacity: 1; }
    .dt__stage[data-state="ended"] .dt__status { opacity: 0.7; }
    .dt__status-time { font-weight: 600; color: var(--dt-text); font-variant-numeric: tabular-nums; }
    .dt__status-sep { color: var(--dt-text-dimmer); }
    .dt__status-total { color: var(--dt-text); }
    .dt__status-section { margin-left: 12px; color: var(--dt-frame); text-transform: uppercase; }
    .dt__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(31,94,58,0.32);
      border-radius: 8px;
      color: var(--dt-frame);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .dt__end:hover { background: rgba(31,94,58,0.08); }

    .dt__about { max-width: 720px; margin: 0 auto; padding: 12px 0 0; }
    .dt__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dt-text);
      margin: 0 0 14px;
    }
    .dt__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--dt-text-dim);
      margin: 0 0 14px;
    }
    .dt__about em { color: var(--dt-frame); font-style: italic; }
    .dt__about a {
      color: var(--dt-frame);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    @media (max-width: 640px) {
      .dt__pavilion { border-width: 10px; }
      .dt__post { width: 10px; }
      .dt__rail { height: 12px; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Voice = 'big' | 'small' | 'block' | 'gong' | 'bell';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.55;
      masterGain.connect(ctx.destination);
    }
    function noise(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 3;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }

    // Big taiko: deep sine drop + filtered noise body
    function playBigTaiko(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // Sub drop
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(85, t);
      osc.frequency.exponentialRampToValueAtTime(38, t + 0.22);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.78 * vel, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.66);
      // Body noise (low-passed)
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 350;
      lp.Q.value = 0.7;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.20 * vel, t + 0.005);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      src.connect(lp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.45);
      flashDrum('big');
    }

    function playSmallTaiko(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(160, t);
      osc.frequency.exponentialRampToValueAtTime(80, t + 0.16);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.46 * vel, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.44);
      // small noise transient
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1200;
      bp.Q.value = 1.5;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.003);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      src.connect(bp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.08);
      flashDrum('small');
    }

    function playBlock(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(820, t);
      osc.frequency.exponentialRampToValueAtTime(640, t + 0.02);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.18 * vel, t + 0.001);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.06);
      flashDrum('block');
    }

    function playGong(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      // Slow-attack bandpassed noise
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1800;
      bp.Q.value = 0.4;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.linearRampToValueAtTime(0.20 * vel, t + 0.12);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 5.5);
      src.connect(bp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 5.7);
      // Underlying tonal partials (sine stack)
      const partials = [
        { freq: 280, gain: 0.22, decay: 5.0 },
        { freq: 460, gain: 0.14, decay: 4.0 },
        { freq: 690, gain: 0.10, decay: 3.0 },
        { freq: 1120, gain: 0.06, decay: 2.2 },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.06);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      flashDrum('gong');
    }

    function playBell(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const partials = [
        { freq: 700, gain: 0.22, decay: 4.0 },
        { freq: 1400, gain: 0.16, decay: 3.0 },
        { freq: 1680, gain: 0.10, decay: 1.8 },
        { freq: 2100, gain: 0.06, decay: 1.2 },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.006);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      flashDrum('bell');
    }

    function flashDrum(voice: Voice) {
      const group = document.querySelector(`.dt__drum--${voice}`);
      if (!group) return;
      group.classList.remove('dt__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('dt__drum--struck');
      setTimeout(() => group.classList.remove('dt__drum--struck'), 420);
      const ring = group.querySelector('.dt__drum-ring');
      if (ring) {
        ring.classList.remove('dt__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('dt__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('dt__drum-ring--pulse'), 1900);
      }
    }

    // ---- arc ----
    type Section = {
      name: string;
      sparsity: number;
      weights: Partial<Record<Voice, number>>;
      gongOnEntry?: boolean;
      bellOnEntry?: boolean;
      rollChance?: number;       // probability of triggering a short eighth-note roll
    };
    const SECTIONS: Section[] = [
      { name: 'approach',  sparsity: 0.06, weights: { bell: 1, block: 0.6 },                              bellOnEntry: true },
      { name: 'settle',    sparsity: 0.12, weights: { big: 2, small: 1, block: 0.8, bell: 0.5 } },
      { name: 'offering',  sparsity: 0.18, weights: { big: 3, small: 1.5, block: 0.6, bell: 0.4 } },
      { name: 'gathering', sparsity: 0.26, weights: { big: 4, small: 2, block: 0.4, bell: 0.3 } },
      { name: 'ascent',    sparsity: 0.38, weights: { big: 5, small: 3, block: 0.5, bell: 0.3 } },
      { name: 'peak',      sparsity: 0.55, weights: { big: 5, small: 4, block: 0.4, bell: 0.2 }, gongOnEntry: true, rollChance: 0.25 },
      { name: 'descent',   sparsity: 0.30, weights: { big: 4, small: 2, block: 0.4, bell: 0.3 } },
      { name: 'release',   sparsity: 0.16, weights: { big: 2, small: 1, block: 0.6, bell: 0.5 },          gongOnEntry: true },
      { name: 'fade',      sparsity: 0.08, weights: { big: 1, small: 0.5, block: 0.6, bell: 0.7 } },
      { name: 'leave',     sparsity: 0.04, weights: { bell: 1, block: 0.5 },                              bellOnEntry: true },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 44;
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 2;
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let lastGongSection = -1;
    let lastBellSection = -1;
    let schedulingComplete = false;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) { r -= w; if (r <= 0) return v; }
      return entries[0][0];
    }

    function fireVoice(voice: Voice, t: number, vel: number) {
      switch (voice) {
        case 'big':   playBigTaiko(t, vel); break;
        case 'small': playSmallTaiko(t, vel); break;
        case 'block': playBlock(t, vel); break;
        case 'gong':  playGong(t, vel); break;
        case 'bell':  playBell(t, vel); break;
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.6;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        if (elapsed >= TOTAL_SEC) { schedulingComplete = true; break; }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(Math.max(0, elapsed) / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        // Gong on section entry
        if (section.gongOnEntry && sectionIdx !== lastGongSection) {
          const sectionStartSec = sectionIdx * SECTION_LEN_SEC;
          if (Math.abs(elapsed - sectionStartSec) < SLOT_SEC * 0.6) {
            playGong(nextSlotTime, 0.85);
            lastGongSection = sectionIdx;
          }
        }
        if (section.bellOnEntry && sectionIdx !== lastBellSection) {
          const sectionStartSec = sectionIdx * SECTION_LEN_SEC;
          if (Math.abs(elapsed - sectionStartSec) < SLOT_SEC * 0.6) {
            playBell(nextSlotTime, 0.7);
            lastBellSection = sectionIdx;
          }
        }

        const slotInBar = slotIdx % 8;
        const isDownbeat = slotInBar === 0;
        const isBackbeat = slotInBar === 4;
        let p = section.sparsity;
        if (isDownbeat) p = Math.min(1, p * 2.6);
        else if (isBackbeat) p = Math.min(1, p * 1.6);

        if (Math.random() < p) {
          let voice = pickWeighted(section.weights);
          if (isDownbeat && Math.random() < 0.7 && section.weights.big) voice = 'big';
          if (voice) {
            const vel = isDownbeat ? 1.0 : (isBackbeat ? 0.85 : 0.55 + Math.random() * 0.3);
            fireVoice(voice, nextSlotTime, vel);
          }
        }

        // Optional roll: at peak, 25% chance of a 4-hit eighth-note roll on big taiko
        if (section.rollChance && isDownbeat && Math.random() < section.rollChance) {
          const rollHits = 4;
          for (let r = 1; r <= rollHits; r++) {
            playBigTaiko(nextSlotTime + r * SLOT_SEC * 0.5, 0.6 + Math.random() * 0.3);
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 80);
    }

    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('dt-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('dt-status-section')!.textContent = SECTIONS[si].name;
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      lastGongSection = -1;
      lastBellSection = -1;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('dt-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('dt-status')!.removeAttribute('hidden');
      scheduleAhead();
      tickUi();
    }
    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('dt-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('dt-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('dt-play')!.addEventListener('click', () => startPlaying());
      document.getElementById('dt-end')!.addEventListener('click', () => stopPlaying(false));
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
