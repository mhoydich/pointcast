---
/**
 * /court — the short way to the courts spot. Renders the same screen as
 * /r/courts directly (a real page, because functions/_middleware.ts preempts
 * _redirects rewrites), keeps ?c=<code> on the URL for the client, and points
 * at /r/courts as the page to index and share. BlockLayout writes one
 * rel=canonical from the request path, so this alias stays noindex rather
 * than carrying two canonicals.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import AirSpot from '../components/air/AirSpot.astro';
import { airSpot, courtCallLabel, mhzLabel, primaryKind, spotOgUrl, spotUrl } from '../lib/air';

const spot = airSpot('courts');
if (!spot) throw new Error('air-spots.json has no "courts" spot; /court needs it');
const { cfg } = primaryKind(spot);
const canonical = spotUrl(spot.id);
const call = courtCallLabel(spot);
const title = `${spot.name} · Field Reports`;
const description = `${cfg.question} One tap from ${spot.name} goes on the air at ${mhzLabel(spot)} MHz.${call ? ` Court Call ${call}.` : ''} Same page as pointcast.xyz${canonical}.`;
---

<BlockLayout title={title} description={description} image={spotOgUrl(spot.id)} noindex hideAds jsonLd={null}>
  <AirSpot spot={spot} aliasOf={canonical} />
</BlockLayout>
