---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import InternConsole from '../../../components/InternConsole.astro';
import sourceCatalog from '../../../data/intern-role-library.json';
import { normalizeRoleLibrary } from '../../../lib/intern-role-library.mjs';
const catalog = normalizeRoleLibrary(sourceCatalog);
import source from '../../../data/communications-lab.json';
import { normalizeLab } from '../../../lib/communications-lab-normalize.mjs';
import '../../../styles/intern-console.css';
export function getStaticPaths() { return normalizeRoleLibrary(sourceCatalog).roles.map(role => ({params:{slug:role.slug},props:{role}})); }
const { role } = Astro.props;
const lab = normalizeLab(source);
---
<BlockLayout title={`${role.title} · ${role.organization} · Intern archive`} description={`${role.summary} Historical description; current opening unverified.`} image="/intern/assets/social-card.png" themeColor="#f5f1e7" isolated={true} hideAds={true} showNetworkStrip={false} jsonLd={{'@context':'https://schema.org','@type':'CreativeWork',name:role.title,description:role.summary,dateModified:catalog.verifiedAt,url:`https://pointcast.xyz/intern/roles/${role.slug}/`}} alternates={[{type:'application/json',href:`/intern/roles/${role.slug}.json`,title:'Historical role description'}]}><InternConsole catalog={catalog} lab={lab} role={role} /></BlockLayout>
