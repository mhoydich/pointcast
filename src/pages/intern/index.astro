---
import BlockLayout from '../../layouts/BlockLayout.astro';
import InternConsole from '../../components/InternConsole.astro';
import sourceCatalog from '../../data/intern-role-library.json';
import { normalizeRoleLibrary } from '../../lib/intern-role-library.mjs';
const catalog = normalizeRoleLibrary(sourceCatalog);
import source from '../../data/communications-lab.json';
import { normalizeLab } from '../../lib/communications-lab-normalize.mjs';
import '../../styles/intern-console.css';
const lab = normalizeLab(source);
---
<BlockLayout title="Intern · A place to begin" description="A source-dated internship role library and twelve Communications Lab learning briefs. Historical openings are unverified; educational applications remain closed." image="/intern/assets/social-card.png" themeColor="#f5f1e7" isolated={true} hideAds={true} showNetworkStrip={false} jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:'PointCast Intern role library',url:'https://pointcast.xyz/intern/',dateModified:catalog.verifiedAt}} alternates={[{type:'application/json',href:'/intern.json',title:'Intern role library'},{type:'application/json',href:'/communications-lab/briefs.json',title:'Communications Lab project briefs'}]}><InternConsole catalog={catalog} lab={lab} /></BlockLayout>
