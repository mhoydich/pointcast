---
import BlockLayout from '../../layouts/BlockLayout.astro';
import CommunicationsLab from '../../components/CommunicationsLab.astro';
import source from '../../data/communications-lab.json';
import {normalizeLab} from '../../lib/communications-lab-normalize.mjs';
import '../../styles/communications-lab.css';
const lab = normalizeLab(source);
const internPage = true;
---
<BlockLayout title={"Communications Lab · Make the signal useful"} description={lab.intro} image="/communications-lab/assets/social-card.png" isolated={true} hideAds={true} showNetworkStrip={false} alternates={[{type:'application/json',href:'/communications-lab/briefs.json',title:'Communications Lab project briefs'}]}><aside aria-label="Music AI case study" style="padding:24px;margin:24px;border:1px solid"><p>CASE STUDY · OCTOBER 5, 2026</p><h2>Music AI before ChatGPT</h2><p><a href="/intern/music-ai-case-study">Read the historical learn-build-ship case study →</a></p><p>A full article, 19 dated milestones and five proposed studio exercises. Research, reported exploration and proposed products are distinguished throughout.</p></aside><CommunicationsLab lab={lab} intern={true} /></BlockLayout>
