---
import BlockLayout from '../layouts/BlockLayout.astro';
import report from '../data/town-inspector-report.json';

const title = 'The Town Inspector';
const description =
  'PointCast walks every door its manifest advertises and re-verifies every claim it makes. The report is public — drift becomes a filing, not a surprise.';
const alternates = [{ type: 'application/json', href: '/health.json', title: 'Town Inspector report JSON' }];

const inspected = new Date(report.inspectedAt);
const inspectedLabel = inspected.toISOString().slice(0, 16).replace('T', ' · ') + ' UTC';
const clean = report.verdict === 'clean';
const passCount = report.claims.filter((c) => c.ok).length;
---

<BlockLayout title={title} description={description} alternates={alternates}>
  <main class="hlth">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/for-agents">agents</a>
      <span aria-hidden="true">/</span>
      <span>health</span>
    </nav>

    <header class="hero">
      <p class="kicker">Town Inspector · {inspectedLabel}</p>
      <h1>A manifest is a promise. This office checks it.</h1>
      <p>
        The inspector reads <a href="/agents.json">/agents.json</a>, walks every advertised door on
        production, and re-verifies each claim the manifest makes — the agent-mode header, open CORS,
        the well-known aliases, citation-grade block JSON, honest freshness, a living MCP endpoint.
        Whatever it finds is published here, first.
      </p>
      <p class:list={['verdict', clean ? 'verdict--clean' : 'verdict--drift']}>
        {clean ? 'CLEAN' : 'DRIFT'} — {report.doors.open}/{report.doors.checked} doors open ·
        {passCount}/{report.claims.length} claims verified
      </p>
    </header>

    <section aria-label="Claims">
      <h2>Claims</h2>
      <ul class="claims">
        {report.claims.map((c) => (
          <li class:list={['claim', c.ok ? 'claim--ok' : 'claim--fail']}>
            <span class="claim__mark" aria-hidden="true">{c.ok ? 'OK' : 'FAIL'}</span>
            <span class="claim__label">{c.label}</span>
            <span class="claim__note">{c.note}</span>
          </li>
        ))}
      </ul>
    </section>

    {report.doors.broken.length > 0 && (
      <section aria-label="Broken doors">
        <h2>Broken doors</h2>
        <ul class="doors">
          {report.doors.broken.map((d) => (
            <li>
              <code>{d.status || 'ERR'}</code>
              <span>{d.url.replace('https://pointcast.xyz', '')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {report.notes.length > 0 && (
      <section aria-label="Notes">
        <h2>Notes</h2>
        <ul class="notes">
          {report.notes.map((n) => <li>{n}</li>)}
        </ul>
      </section>
    )}

    <section aria-label="How it works">
      <h2>How it works</h2>
      <p>
        <code>npm run inspect:town</code> runs the walk from any machine; <code>--write</code> commits
        the findings to the repo, and this page serves them. An inspection is a deploy-time act, not a
        per-request one — <code>inspectedAt</code> is the truth timestamp. Agents: fetch
        <a href="/health.json">/health.json</a> before trusting stale corners of the manifest.
      </p>
    </section>
  </main>
</BlockLayout>

<style>
  .hlth {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: 'Inter Variable', system-ui, sans-serif;
  }
  .crumb {
    display: flex;
    gap: 0.5rem;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.75rem;
    text-transform: lowercase;
    margin-bottom: 2rem;
  }
  .crumb a { color: inherit; }
  .kicker {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
  }
  .hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0.5rem 0 1rem;
  }
  .hero p { max-width: 44rem; line-height: 1.55; }
  .verdict {
    display: inline-block;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.85rem;
    border: 1px solid currentColor;
    padding: 0.4rem 0.75rem;
    margin-top: 0.75rem;
  }
  .verdict--clean { color: #1d6b3c; }
  .verdict--drift { color: #8a2b1d; }
  h2 {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.35rem;
    margin: 2.25rem 0 0.9rem;
  }
  .claims { list-style: none; padding: 0; margin: 0; }
  .claim {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.15rem 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid #eee;
  }
  .claim__mark {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.75rem;
    padding-top: 0.1rem;
  }
  .claim--ok .claim__mark { color: #1d6b3c; }
  .claim--fail .claim__mark { color: #8a2b1d; font-weight: 700; }
  .claim__label { font-weight: 600; }
  .claim__note {
    grid-column: 2;
    font-size: 0.85rem;
    color: #555;
    font-family: 'JetBrains Mono Variable', monospace;
  }
  .doors { list-style: none; padding: 0; margin: 0; }
  .doors li {
    display: flex;
    gap: 0.75rem;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.85rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid #f0f0f0;
  }
  .doors code { color: #8a2b1d; }
  .notes li { line-height: 1.5; font-size: 0.9rem; color: #444; }
  section p { line-height: 1.55; max-width: 44rem; }
  code {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.85em;
    background: #f5f5f5;
    padding: 0.1em 0.35em;
  }
</style>
