---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { AFTERLIGHT_DESCRIPTION, AFTERLIGHT_ROUTES, AFTERLIGHT_TITLE } from '../../lib/crystal-ball-pass-v2';
import '../../styles/crystal-ball-pass-v2.css';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': 'https://pointcast.xyz/crystal-ball-pass/v2#game',
  name: AFTERLIGHT_TITLE,
  description: AFTERLIGHT_DESCRIPTION,
  url: 'https://pointcast.xyz/crystal-ball-pass/v2',
  image: 'https://pointcast.xyz/images/crystal-ball-pass/og.png',
  gamePlatform: 'Web browser',
  applicationCategory: 'GameApplication',
  playMode: 'SinglePlayer',
  isPartOf: { '@id': 'https://pointcast.xyz/crystal-ball-pass#world' },
  author: { '@type': 'Organization', name: 'PointCast × Codex', url: 'https://pointcast.xyz' },
};
---

<BlockLayout legacy
  title={`${AFTERLIGHT_TITLE} — A night signal expedition`}
  description={AFTERLIGHT_DESCRIPTION}
  image="/images/crystal-ball-pass/og.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/crystal-ball-pass.json', title: 'Crystal Ball Pass world manifest' }]}
>
  <main id="afterlight" class="afterlight" style="--route-hue:#d9c9ff;--scene-hue:#b9d5ff">
    <div class="afterlight__world" aria-hidden="true">
      <div class="afterlight__aurora"></div>
      <div class="afterlight__stars"></div>
      <div class="afterlight__ridge afterlight__ridge--far"></div>
      <div class="afterlight__ridge afterlight__ridge--near"></div>
      <div class="afterlight__signal"><i></i><i></i><i></i><b></b></div>
      <div class="afterlight__trees">{Array.from({ length: 18 }).map(() => <i></i>)}</div>
      <div class="afterlight__grain"></div>
    </div>

    <header class="afterlight__topbar">
      <a href="/crystal-ball-pass"><b>◇</b> CRYSTAL BALL PASS</a>
      <span>V2 / AFTERLIGHT</span>
      <div><button type="button" data-sound>SIGNAL ON</button><a href="/crystal-ball-pass/play">V1 ↗</a></div>
    </header>

    <section class="afterlight__intro" data-intro>
      <div class="afterlight__intro-copy">
        <span class="afterlight__eyebrow">A SECOND PASSAGE · AFTER DARK</span>
        <h1>THE PASS WAS<br />ONLY THE BEGINNING.</h1>
        <p>Three signals arrived after sunset. Codex Micro can follow one before the batteries—or the moon—give out.</p>
        <small>CHOOSE A ROUTE · 4–6 MINUTES · SOUND ARRIVES AFTER YOUR FIRST TAP</small>
      </div>
      <div class="afterlight__routes" aria-label="Choose an Afterlight route">
        {AFTERLIGHT_ROUTES.map((route) => (
          <button type="button" class={`afterlight__route afterlight__route--${route.id}`} data-route={route.id} style={`--card-hue:${route.hue}`}>
            <span>{route.number} / {route.callSign}</span>
            <strong>{route.name}</strong>
            <p>{route.promise}</p>
            <small>PACKED: {route.kit}</small>
            <b>FOLLOW SIGNAL →</b>
          </button>
        ))}
      </div>
    </section>

    <section class="afterlight__game" data-game hidden>
      <aside class="afterlight__route-desk">
        <span>ROUTE</span>
        <strong data-route-name>Moon Relay</strong>
        <small data-call-sign>LUNAR / 91.7</small>
        <div class="afterlight__route-line"><i data-route-progress></i><b>◇</b></div>
        <dl>
          <div><dt>WARMTH</dt><dd><span data-warmth>64</span>%</dd></div>
          <div><dt>SIGNAL</dt><dd><span data-signal>18</span>%</dd></div>
          <div><dt>WONDER</dt><dd data-wonder>20</dd></div>
        </dl>
        <button type="button" data-change-route>← CHANGE ROUTE</button>
      </aside>

      <article class="afterlight__story" data-story-view>
        <div class="afterlight__station"><span data-place>Glass Fern Basin</span><span data-time>9:14 P.M.</span></div>
        <div class="afterlight__weather" data-weather>CLEAR · 36°</div>
        <h2 data-title>Every fern is holding a small moon.</h2>
        <p data-story>The trail has become a field of mirrored leaves.</p>
        <div class="afterlight__choices" data-choices></div>
      </article>

      <article class="afterlight__ending" data-ending hidden>
        <span class="afterlight__eyebrow">SIGNAL CARRIED HOME</span>
        <h2 data-ending-title>The valley answers in porch lights.</h2>
        <p data-ending-copy></p>
        <div class="afterlight__score"><span>AFTERLIGHT SIGNAL</span><strong data-score>0</strong></div>
        <div class="afterlight__ending-actions">
          <button type="button" data-restart>WALK ANOTHER ROUTE ↻</button>
          <a href="/crystal-ball-pass">RETURN TO TRAILHEAD ↗</a>
        </div>
      </article>

      <aside class="afterlight__micro">
        <div class="afterlight__micro-head"><span>CODEX MICRO / NIGHT MODE</span><i></i></div>
        <div class="afterlight__micro-screen">
          <div class="afterlight__face"><i></i><i></i><b></b></div>
          <p data-micro>OPTICAL GREETING DETECTED. ETIQUETTE DATABASE: INSUFFICIENT.</p>
        </div>
        <div class="afterlight__frequency"><span>FREQUENCY</span><b data-frequency>91.7</b><small>MHz-ish</small></div>
        <ol data-log><li>Afterlight channel opened.</li></ol>
      </aside>
    </section>

    <footer class="afterlight__footer">
      <span>LOCAL-ONLY PASSAGE · NO SAVE · NO ACCOUNT · NO TELEMETRY</span>
      <span><a href="https://accounts.spotify.com/" target="_blank" rel="noopener noreferrer">SPOTIFY HANDOFF ↗</a> · <a href="https://account.meethue.com/" target="_blank" rel="noopener noreferrer">HUE HANDOFF ↗</a></span>
    </footer>
  </main>

  <script>
    import { AFTERLIGHT_ROUTES } from '../../lib/crystal-ball-pass-v2';
    import type { AfterlightChoice, AfterlightRoute, AfterlightStats } from '../../lib/crystal-ball-pass-v2';

    const app = document.querySelector<HTMLElement>('#afterlight');
    if (!app) throw new Error('Afterlight app shell was not found.');

    const query = <T extends Element>(selector: string) => {
      const element = app.querySelector<T>(selector);
      if (!element) throw new Error(`Afterlight control missing: ${selector}`);
      return element;
    };

    let route: AfterlightRoute = AFTERLIGHT_ROUTES[0];
    let sceneIndex = 0;
    let stats: AfterlightStats = { warmth: 64, signal: 18, wonder: 20 };
    let log: string[] = ['Afterlight channel opened.'];
    let soundOn = true;
    let audioContext: AudioContext | null = null;

    const clamp = (value: number, minimum = 0, maximum = 100) => Math.min(maximum, Math.max(minimum, value));

    const playTone = (frequency: number) => {
      if (!soundOn) return;
      const AudioCtor = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioCtor) return;
      audioContext ??= new AudioCtor();
      const now = audioContext.currentTime;
      [1, 1.5, 2.01].forEach((ratio, index) => {
        const oscillator = audioContext!.createOscillator();
        const gain = audioContext!.createGain();
        oscillator.type = index === 0 ? 'sine' : 'triangle';
        oscillator.frequency.setValueAtTime(frequency * ratio, now + index * 0.07);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.045 / (index + 1), now + 0.05 + index * 0.07);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);
        oscillator.connect(gain);
        gain.connect(audioContext!.destination);
        oscillator.start(now + index * 0.07);
        oscillator.stop(now + 1.85);
      });
    };

    const updateStats = () => {
      query<HTMLElement>('[data-warmth]').textContent = String(stats.warmth);
      query<HTMLElement>('[data-signal]').textContent = String(stats.signal);
      query<HTMLElement>('[data-wonder]').textContent = String(stats.wonder);
    };

    const updateLog = () => {
      query<HTMLOListElement>('[data-log]').replaceChildren(...log.slice(0, 3).map((entry) => {
        const item = document.createElement('li');
        item.textContent = entry;
        return item;
      }));
    };

    const finish = () => {
      query<HTMLElement>('[data-story-view]').hidden = true;
      query<HTMLElement>('[data-ending]').hidden = false;
      const score = clamp(stats.signal + Math.round(stats.wonder * 0.6) + Math.round(stats.warmth * 0.25), 0, 180);
      query<HTMLElement>('[data-score]').textContent = String(score);
      query<HTMLElement>('[data-ending-title]').textContent = route.id === 'moon'
        ? 'The moon keeps your frequency.'
        : route.id === 'river'
          ? 'The valley answers downstream.'
          : 'Tomorrow wakes up warm.';
      query<HTMLElement>('[data-ending-copy]').textContent = `You return from ${route.name} with ${stats.signal}% signal, ${stats.warmth}% warmth, and one forest transmission that did not exist before tonight.`;
      query<HTMLElement>('[data-route-progress]').style.width = '100%';
      playTone(880);
    };

    const choose = (choice: AfterlightChoice) => {
      playTone(choice.tone);
      stats = {
        warmth: clamp(stats.warmth + (choice.delta.warmth ?? 0)),
        signal: clamp(stats.signal + (choice.delta.signal ?? 0)),
        wonder: clamp(stats.wonder + (choice.delta.wonder ?? 0), 0, 140),
      };
      log = [choice.result, ...log].slice(0, 4);
      updateStats();
      updateLog();
      if (sceneIndex === route.scenes.length - 1) return finish();
      sceneIndex += 1;
      renderScene();
    };

    const renderChoices = () => {
      const choices = query<HTMLElement>('[data-choices]');
      choices.replaceChildren(...route.scenes[sceneIndex].choices.map((choice, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        const number = document.createElement('span');
        number.textContent = `0${index + 1}`;
        const copy = document.createElement('span');
        const title = document.createElement('strong');
        title.textContent = choice.label;
        const detail = document.createElement('small');
        detail.textContent = choice.detail;
        copy.append(title, detail);
        const arrow = document.createElement('b');
        arrow.textContent = '↗';
        button.append(number, copy, arrow);
        button.addEventListener('click', () => choose(choice));
        return button;
      }));
    };

    const renderScene = () => {
      const scene = route.scenes[sceneIndex];
      app.style.setProperty('--scene-hue', scene.hue);
      query<HTMLElement>('[data-place]').textContent = scene.place;
      query<HTMLElement>('[data-time]').textContent = scene.time;
      query<HTMLElement>('[data-weather]').textContent = scene.weather;
      query<HTMLElement>('[data-title]').textContent = scene.title;
      query<HTMLElement>('[data-story]').textContent = scene.story;
      query<HTMLElement>('[data-micro]').textContent = scene.micro;
      query<HTMLElement>('[data-route-progress]').style.width = `${(sceneIndex / route.scenes.length) * 100}%`;
      renderChoices();
    };

    const beginRoute = (routeId: string) => {
      route = AFTERLIGHT_ROUTES.find((candidate) => candidate.id === routeId) ?? AFTERLIGHT_ROUTES[0];
      sceneIndex = 0;
      stats = { warmth: 64, signal: 18, wonder: 20 };
      log = [`${route.callSign} channel opened.`];
      app.dataset.route = route.id;
      app.style.setProperty('--route-hue', route.hue);
      query<HTMLElement>('[data-route-name]').textContent = route.name;
      query<HTMLElement>('[data-call-sign]').textContent = route.callSign;
      query<HTMLElement>('[data-frequency]').textContent = route.callSign.split('/')[1].trim();
      query<HTMLElement>('[data-intro]').hidden = true;
      query<HTMLElement>('[data-game]').hidden = false;
      query<HTMLElement>('[data-story-view]').hidden = false;
      query<HTMLElement>('[data-ending]').hidden = true;
      updateStats();
      updateLog();
      renderScene();
      playTone(route.id === 'moon' ? 523 : route.id === 'river' ? 392 : 659);
    };

    app.querySelectorAll<HTMLButtonElement>('[data-route]').forEach((button) => {
      button.addEventListener('click', () => beginRoute(button.dataset.route ?? 'moon'));
    });

    const returnToRoutes = () => {
      query<HTMLElement>('[data-game]').hidden = true;
      query<HTMLElement>('[data-intro]').hidden = false;
    };

    query<HTMLButtonElement>('[data-change-route]').addEventListener('click', returnToRoutes);
    query<HTMLButtonElement>('[data-restart]').addEventListener('click', returnToRoutes);
    query<HTMLButtonElement>('[data-sound]').addEventListener('click', (event) => {
      soundOn = !soundOn;
      (event.currentTarget as HTMLButtonElement).textContent = soundOn ? 'SIGNAL ON' : 'SIGNAL OFF';
      if (soundOn) playTone(523);
    });
  </script>
</BlockLayout>
