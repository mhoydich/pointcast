---
/**
 * /shrine-water — the first shrine. A pool. Drop a stone.
 *
 * First surface in the new "shrine" register on pointcast.xyz —
 * contemplative, image-first, sophisticated. Apple-like UI: full-bleed
 * background, generous frosted-glass card, spring entrance, premium
 * typography, soft ambient audio with rich envelope and reverb.
 *
 * Distinct from the /drum-pavilion meditative register: pavilions are
 * audio-first screensavers; shrines are image-first contemplative
 * spaces with a single minimal interaction (drop a stone, light a
 * candle, ring a bell). Each shrine is one element, one image, one
 * sound, one act.
 *
 * Background: CSS gradient placeholder until Manus delivers
 * /public/images/shrines/shrine-water.png (see docs/briefs/2026-05-16-
 * manus-shrine-altar-backgrounds.md). Swap is one CSS line away.
 *
 * Audio:
 *   • Ambient drips every 8-12 seconds (sine, low ~120Hz, ADSR-soft)
 *   • On stone drop: a deeper "plink" (sine 80Hz + harmonic) with
 *     long exponential decay — feels like a stone hitting still water
 *
 * State (localStorage 'pc:shrine-water:v1'):
 *   { stonesDropped, firstVisit, lastVisit }
 *
 * Shipped 2026-05-16. First shrine. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Shrine of Water — a quiet pool"
  description="The first shrine on pointcast.xyz. A still reflective pool. Drop a stone and listen. Local-only; nothing leaves your browser. Contemplative, slow, intentionally undemanding."
  image="/images/og-drum.png"
>
  <main class="shw" id="shw" data-built={built}>
    <!-- Backdrop: image when present, gradient placeholder otherwise -->
    <div class="shw__backdrop" id="shw-backdrop" aria-hidden="true"></div>

    <!-- The frosted-glass card -->
    <article class="shw__card" id="shw-card">
      <header class="shw__head">
        <p class="shw__kicker">SHRINE · WATER · DROP A STONE</p>
        <h1 class="shw__title">A quiet pool.</h1>
        <p class="shw__sub">A small, still place. Drop a stone when you arrive — only you will hear it. There's nothing to do, no one to send it to, no record beyond your own.</p>
      </header>

      <!-- The pool — visual interaction zone -->
      <div class="shw__pool" id="shw-pool" role="button" tabindex="0" aria-label="Drop a stone into the pool">
        <div class="shw__pool-surface" aria-hidden="true">
          <div class="shw__ripples" id="shw-ripples" aria-hidden="true"></div>
        </div>
        <span class="shw__pool-hint" id="shw-pool-hint">tap to drop a stone</span>
      </div>

      <!-- Visit / count line, quiet -->
      <footer class="shw__foot">
        <p class="shw__count" id="shw-count">your first visit</p>
        <p class="shw__links">
          <a href="/shrine">↗ /shrine</a>
          <span class="shw__dot">·</span>
          <a href="/music-hub">↗ /music-hub</a>
        </p>
      </footer>
    </article>
  </main>

  <style is:global>
    :root {
      --shw-ink: #050810;
      --shw-deep: #0a1530;
      --shw-water-1: #1a4870;
      --shw-water-2: #2a6890;
      --shw-mist: #aeccd8;
      --shw-cream: #f4ede0;
      --shw-cream-dim: rgba(244, 237, 224, 0.62);
      --shw-cream-dimmer: rgba(244, 237, 224, 0.34);
      --shw-accent: #d8c89b;
      --shw-card-bg: rgba(8, 14, 28, 0.40);
      --shw-card-border: rgba(244, 237, 224, 0.12);
    }

    html, body {
      background: var(--shw-ink);
      margin: 0;
      padding: 0;
      height: 100%;
    }
    body:has(.shw) {
      color: var(--shw-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .shw {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* BACKDROP — full-bleed image or gradient placeholder */
    .shw__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      /* Painterly placeholder until /public/images/shrines/shrine-water.png lands */
      background:
        radial-gradient(ellipse at 30% 25%, rgba(174, 204, 216, 0.20) 0%, transparent 55%),
        radial-gradient(ellipse at 70% 80%, rgba(42, 104, 144, 0.40) 0%, transparent 60%),
        linear-gradient(180deg, #0a1530 0%, #1a3050 40%, #2a4868 100%);
      animation: shwBackdrop 28s ease-in-out infinite alternate;
    }
    @keyframes shwBackdrop {
      0%   { background-position: 0% 0%, 0% 0%, 0% 0%; filter: brightness(1.0); }
      100% { background-position: 4% 2%, -2% 1%, 0% 0%; filter: brightness(0.92); }
    }
    /* When the real image lands, the below class can be added/swapped */
    .shw__backdrop--image {
      background-image: url('/images/shrines/shrine-water.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    /* Subtle vignette to keep the card area readable */
    .shw__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(5, 8, 16, 0.55) 95%);
      pointer-events: none;
    }

    /* CARD — the Apple-y centerpiece */
    .shw__card {
      position: relative;
      z-index: 1;
      max-width: 480px;
      width: 100%;
      padding: 36px 32px 28px;
      background: var(--shw-card-bg);
      border: 1px solid var(--shw-card-border);
      border-radius: 28px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.45),
        0 8px 24px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: shwCardEnter 1.6s cubic-bezier(0.16, 0.84, 0.30, 1.00) both;
      transform-origin: 50% 50%;
    }
    @keyframes shwCardEnter {
      0%   { opacity: 0; transform: translateY(28px) scale(0.96); filter: blur(8px); }
      50%  { opacity: 0.9; filter: blur(2px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* HEAD */
    .shw__head { margin-bottom: 28px; }
    .shw__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--shw-cream-dim);
      text-transform: uppercase;
      margin: 0 0 16px;
      font-weight: 500;
    }
    .shw__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: clamp(34px, 5vw, 44px);
      letter-spacing: -0.022em;
      line-height: 1.08;
      margin: 0 0 14px;
      color: var(--shw-cream);
    }
    .shw__sub {
      font-size: 15px;
      line-height: 1.55;
      color: var(--shw-cream-dim);
      margin: 0;
      letter-spacing: 0.005em;
      font-weight: 400;
    }

    /* POOL — interactive surface */
    .shw__pool {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin: 0 0 22px;
      border-radius: 18px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1);
      outline: none;
    }
    .shw__pool:hover { transform: scale(1.005); }
    .shw__pool:focus-visible {
      box-shadow: 0 0 0 3px rgba(216, 200, 155, 0.6);
    }
    .shw__pool:active {
      transform: scale(0.992);
      transition-duration: 80ms;
    }
    .shw__pool-surface {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 50% 35%, rgba(174, 204, 216, 0.30) 0%, transparent 60%),
        linear-gradient(180deg, var(--shw-water-1) 0%, var(--shw-water-2) 100%);
      box-shadow:
        inset 0 4px 18px rgba(255, 255, 255, 0.08),
        inset 0 -10px 30px rgba(0, 0, 0, 0.35);
      animation: shwPoolBreathe 8s ease-in-out infinite alternate;
    }
    @keyframes shwPoolBreathe {
      0%   { filter: brightness(1.00); }
      100% { filter: brightness(1.06); }
    }
    .shw__ripples {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .shw__ripple {
      position: absolute;
      left: 50%; top: 50%;
      width: 24px; height: 24px;
      border: 1.5px solid rgba(244, 237, 224, 0.65);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      animation: shwRipple 2.6s cubic-bezier(0.25, 0.6, 0.30, 1) forwards;
      pointer-events: none;
    }
    @keyframes shwRipple {
      0%   { transform: translate(-50%, -50%) scale(0); opacity: 0.85; border-width: 2px; }
      80%  { transform: translate(-50%, -50%) scale(8); opacity: 0.2; border-width: 1px; }
      100% { transform: translate(-50%, -50%) scale(11); opacity: 0; border-width: 0.5px; }
    }
    .shw__pool-hint {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: rgba(244, 237, 224, 0.40);
      transition: opacity 360ms ease;
      pointer-events: none;
    }
    .shw__pool--touched .shw__pool-hint { opacity: 0; }

    /* FOOTER */
    .shw__foot {
      text-align: center;
    }
    .shw__count {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 14px;
      color: var(--shw-cream-dim);
      margin: 0 0 10px;
      letter-spacing: 0.01em;
      min-height: 1.4em;
    }
    .shw__count strong {
      color: var(--shw-accent);
      font-weight: 600;
      font-style: normal;
    }
    .shw__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--shw-cream-dimmer);
      margin: 0;
    }
    .shw__links a {
      color: var(--shw-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .shw__links a:hover { color: var(--shw-cream); }
    .shw__dot {
      display: inline-block;
      margin: 0 8px;
      opacity: 0.4;
    }

    @media (max-width: 480px) {
      .shw__card { padding: 28px 22px 22px; border-radius: 22px; }
      .shw__head { margin-bottom: 22px; }
      .shw__pool { aspect-ratio: 3 / 2; }
    }

    @media (prefers-reduced-motion: reduce) {
      .shw__card { animation: none; }
      .shw__backdrop { animation: none; }
      .shw__pool-surface { animation: none; }
      .shw__ripple { animation-duration: 1.4s; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const STORAGE_KEY = 'pc:shrine-water:v1';
    interface ShrineState {
      stonesDropped: number;
      firstVisit: number;
      lastVisit: number;
    }

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let ambientTimer: number | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.40;
      masterGain.connect(ctx.destination);

      // Tiny algorithmic reverb (impulse response synthesized in-browser)
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 2.2);  // 2.2s tail
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          // Exponential decay with light noise
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.4);
        }
      }
      convolver.buffer = ir;

      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.7;
      wetGain.gain.value = 0.45;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }

    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    // Soft ambient drip — a low sine pluck every 8-12s
    function playDrip() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      // Slight detune per drip so they don't sound identical
      osc.frequency.value = 110 + Math.random() * 30;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.20, t + 0.012);
      g.gain.exponentialRampToValueAtTime(0.08, t + 0.10);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
      osc.connect(g);
      connectVoice(g);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 1.0);
    }

    // A heavier "plink" when a stone is dropped
    function playPlink() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      // Fundamental
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(180, t);
      osc.frequency.exponentialRampToValueAtTime(85, t + 0.18);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.55, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.12, t + 0.18);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
      osc.connect(g);
      connectVoice(g);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 1.9);
      // Soft harmonic shimmer
      const o2 = ctx.createOscillator();
      const g2 = ctx.createGain();
      o2.type = 'sine';
      o2.frequency.value = 360;
      g2.gain.setValueAtTime(0.0001, t);
      g2.gain.exponentialRampToValueAtTime(0.06, t + 0.010);
      g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.50);
      o2.connect(g2);
      connectVoice(g2);
      scheduler.trackSource(o2);
      o2.start(t);
      o2.stop(t + 0.6);
    }

    function startAmbient() {
      if (ambientTimer != null) return;
      const tick = () => {
        playDrip();
        ambientTimer = window.setTimeout(tick, 8000 + Math.random() * 4000);
      };
      // First drip after a beat so it doesn't fire immediately on load
      ambientTimer = window.setTimeout(tick, 2400 + Math.random() * 2000);
    }
    function stopAmbient() {
      if (ambientTimer != null) { clearTimeout(ambientTimer); ambientTimer = null; }
    }

    // ---- state ----
    function loadState(): ShrineState {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed.stonesDropped === 'number') return parsed;
        }
      } catch { /* ignore */ }
      return { stonesDropped: 0, firstVisit: Date.now(), lastVisit: Date.now() };
    }
    function saveState(s: ShrineState) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch { /* ignore */ }
    }

    function timeAgo(t: number): string {
      const diff = Math.max(0, Date.now() - t);
      const s = Math.floor(diff / 1000);
      if (s < 60)   return 'just now';
      const m = Math.floor(s / 60);
      if (m < 60)   return `${m} minute${m === 1 ? '' : 's'} ago`;
      const h = Math.floor(m / 60);
      if (h < 24)   return `${h} hour${h === 1 ? '' : 's'} ago`;
      const d = Math.floor(h / 24);
      if (d < 30)   return `${d} day${d === 1 ? '' : 's'} ago`;
      const mo = Math.floor(d / 30);
      return `${mo} month${mo === 1 ? '' : 's'} ago`;
    }

    function refreshCount(state: ShrineState) {
      const el = document.getElementById('shw-count')!;
      const n = state.stonesDropped;
      const isFirst = state.firstVisit === state.lastVisit && n === 0;
      if (isFirst) {
        el.innerHTML = 'your first visit';
      } else if (n === 0) {
        el.innerHTML = `you've been here before · last visit ${timeAgo(state.lastVisit)}`;
      } else if (n === 1) {
        el.innerHTML = `you've dropped <strong>1</strong> stone here`;
      } else {
        el.innerHTML = `you've dropped <strong>${n}</strong> stones here`;
      }
    }

    function spawnRipple() {
      const wrap = document.getElementById('shw-ripples')!;
      // Two staggered ripples for depth
      for (let i = 0; i < 2; i++) {
        const r = document.createElement('span');
        r.className = 'shw__ripple';
        r.style.animationDelay = `${i * 220}ms`;
        wrap.appendChild(r);
        r.addEventListener('animationend', () => r.remove(), { once: true });
      }
    }

    function dropStone(state: ShrineState) {
      ensureCtx();
      const pool = document.getElementById('shw-pool')!;
      pool.classList.add('shw__pool--touched');
      spawnRipple();
      playPlink();
      state.stonesDropped += 1;
      state.lastVisit = Date.now();
      saveState(state);
      refreshCount(state);
    }

    function init() {
      const state = loadState();
      // Bump lastVisit on each load
      state.lastVisit = Date.now();
      saveState(state);
      refreshCount(state);

      const pool = document.getElementById('shw-pool')!;
      // Pointer
      pool.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        dropStone(state);
      });
      // Keyboard accessibility
      pool.addEventListener('keydown', (e) => {
        if (e.code === 'Space' || e.code === 'Enter') {
          e.preventDefault();
          dropStone(state);
        }
      });

      // Audio gating: ambient drips begin on first interaction (browsers
      // block AudioContext until user gesture). Also begin after any click
      // anywhere on the document so the shrine wakes naturally.
      const wake = () => {
        ensureCtx();
        startAmbient();
        document.removeEventListener('pointerdown', wake);
        document.removeEventListener('keydown', wake);
      };
      document.addEventListener('pointerdown', wake);
      document.addEventListener('keydown', wake);

      // Pause ambient when tab hidden
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAmbient();
        else if (ctx) startAmbient();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
