---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Noggle Lights Out';
const description = 'Classic Lights Out with chunky noggle tiles, mobile taps, and local best-move tracking.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/noggle-lights-out', name: title, description, url: 'https://pointcast.xyz/noggle-lights-out' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-lights>
    <section class="window" aria-labelledby="lights-title">
      <header class="titlebar"><span>Noggle Lights Out</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Noggle Lights Out menu">
        <button type="button" data-new>Game</button>
        <a href="/nouns-wordsearch">Words</a>
        <a href="/pixel-pipes">Pipes</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">TAP · TOGGLE · CLEAR</p><h1 id="lights-title">Turn them off.</h1><p>Each tap flips one tile and its neighbors. Clear every lit noggle.</p></div>
        <div class="meters"><span>Moves <strong data-moves>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="play">
        <div class="boardwrap">
          <div class="grid" data-grid aria-label="Noggle Lights Out grid"></div>
          <div class="overlay" data-overlay hidden>
            <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="lights-dialog-title">
              <header class="dlgbar"><span id="lights-dialog-title" data-dialog-title>Cleared</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
              <div class="dlgbody"><p data-dialog-message>All lights out.</p><button type="button" data-restart>New Game</button></div>
            </div>
          </div>
        </div>
        <aside class="nouncard">
          <img src="https://noun.pics/329.svg" alt="" width="120" height="120" loading="lazy" />
          <span>LOCAL PUZZLE</span>
        </aside>
      </div>
      <footer class="status" data-status aria-live="polite">Tap tiles until the board is dark.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-lights]');
  if (root) {
    const gridEl = root.querySelector<HTMLElement>('[data-grid]');
    const movesEl = root.querySelector<HTMLElement>('[data-moves]');
    const bestEl = root.querySelector<HTMLElement>('[data-best]');
    const statusEl = root.querySelector<HTMLElement>('[data-status]');
    const overlay = root.querySelector<HTMLElement>('[data-overlay]');
    const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
    const slug = 'noggle-lights-out';
    const statsKey = 'pc:arcade:' + slug;
    const profileKey = 'pc:arcade:profile';
    const gameName = 'Lights';
    const badge = 'lights-out-clear';
    const size = 5;
    let board: boolean[] = [];
    let moves = 0;
    let won = false;
    let cells: HTMLButtonElement[] = [];
    let raf = 0;
    let pulse = 0;
    let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestMoves: 0 }).bestMoves || 0);

    function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
    function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
    function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
    function idx(r: number, c: number) { return r * size + c; }
    function recordPlay(clear: boolean) {
      const stats = readJson(statsKey, { plays: 0, clears: 0, bestMoves: 0 });
      if (!clear) stats.plays = Number(stats.plays || 0) + 1;
      if (clear) {
        stats.clears = Number(stats.clears || 0) + 1;
        stats.bestMoves = Number(stats.bestMoves || 0) ? Math.min(Number(stats.bestMoves), moves) : moves;
      }
      writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestMoves: Number(stats.bestMoves || 0) });
      const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
      profile.lastPlayed = gameName;
      if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
      if (clear) {
        profile.clears = Number(profile.clears || 0) + 1;
        profile.clearStreak = Number(profile.clearStreak || 0) + 1;
        profile.lastCleared = gameName;
        const earned = ['first-win', badge];
        if (profile.clearStreak >= 3) earned.push('three-game-streak');
        profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
      }
      writeJson(profileKey, profile);
      best = Number(stats.bestMoves || best || 0);
    }
    function renderMeters() {
      if (movesEl) movesEl.textContent = String(moves);
      if (bestEl) bestEl.textContent = best ? String(best) : '--';
    }
    function toggleAt(r: number, c: number) {
      [[0, 0], [1, 0], [-1, 0], [0, 1], [0, -1]].forEach(([dr, dc]) => {
        const rr = r + dr;
        const cc = c + dc;
        if (rr >= 0 && rr < size && cc >= 0 && cc < size) board[idx(rr, cc)] = !board[idx(rr, cc)];
      });
    }
    function build() {
      if (!gridEl) return;
      gridEl.innerHTML = '';
      cells = [];
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'tile';
          button.dataset.r = String(r);
          button.dataset.c = String(c);
          button.innerHTML = '<span>[]</span>';
          button.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            button.setPointerCapture(event.pointerId);
            tap(r, c);
          });
          gridEl.appendChild(button);
          cells.push(button);
        }
      }
    }
    function render() {
      cells.forEach((cell, i) => {
        cell.classList.toggle('is-on', board[i]);
        cell.classList.toggle('is-off', !board[i]);
      });
      renderMeters();
    }
    function makePuzzle() {
      board = Array(size * size).fill(false);
      const taps = 8 + Math.floor(Math.random() * 5);
      for (let i = 0; i < taps; i++) toggleAt(Math.floor(Math.random() * size), Math.floor(Math.random() * size));
      if (!board.some(Boolean)) toggleAt(2, 2);
    }
    function tap(r: number, c: number) {
      if (won) return;
      toggleAt(r, c);
      moves++;
      render();
      if (!board.some(Boolean)) win();
      else setStatus('Move ' + moves + '. Lit tiles left: ' + board.filter(Boolean).length + '.');
    }
    function win() {
      if (won) return;
      won = true;
      recordPlay(true);
      renderMeters();
      setStatus('All lights out in ' + moves + ' moves.');
      if (dialogMessage) dialogMessage.textContent = 'All lights out in ' + moves + ' moves.';
      if (overlay) overlay.hidden = false;
    }
    function newGame() {
      won = false;
      moves = 0;
      if (overlay) overlay.hidden = true;
      makePuzzle();
      build();
      recordPlay(false);
      render();
      setStatus('Tap a tile to flip its row-neighborhood.');
    }
    function loop(now: number) {
      pulse = (Math.sin(now / 220) + 1) / 2;
      if (gridEl) gridEl.style.setProperty('--pulse', String(pulse));
      raf = requestAnimationFrame(loop);
    }
    root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
    root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(loop);
    });
    newGame();
    raf = requestAnimationFrame(loop);
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,820px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:44ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; gap:6px; }
  .meters span { min-width:72px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 20px/1 "Courier New",monospace; color:#000080; }
  .play { display:grid; grid-template-columns:auto 150px; gap:10px; align-items:start; justify-content:center; padding:0 10px 10px; }
  .boardwrap { position:relative; width:min(calc(100vw - 36px),316px); }
  .grid { display:grid; grid-template-columns:repeat(5,56px); gap:6px; padding:6px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#9a9c8f; touch-action:none; user-select:none; -webkit-user-select:none; }
  .tile { width:56px; height:56px; display:grid; place-items:center; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; color:#101018; font:700 18px/1 "Courier New",monospace; padding:0; }
  .tile.is-on { background:#f7c325; color:#000080; box-shadow:inset 0 0 calc(4px + 8px * var(--pulse)) #ffff00; }
  .tile.is-off { border-color:#404040 #fff #fff #404040; background:#606060; color:#202020; }
  .tile:active { border-color:#404040 #fff #fff #404040; }
  .nouncard { display:grid; justify-items:center; gap:8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:10px; font:700 11px/1 "Courier New",monospace; color:#000080; }
  .nouncard img { width:110px; height:110px; image-rendering:pixelated; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 10px 10px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
  @media (max-width:620px) {
    .play { grid-template-columns:1fr; justify-items:center; }
    .nouncard { width:min(calc(100vw - 36px),316px); grid-template-columns:auto 1fr; align-items:center; }
    .nouncard img { width:64px; height:64px; }
  }
</style>
