---
/**
 * /send — the one-sheets hub.
 *
 * Mike, 2026-09-01: "utilities i can send, say ai tools, how to mcp, ways
 * to make capital with ai contributions, etc." Three short pages made to
 * be texted to a person, each with a JSON twin and a plain-text twin.
 * Data lives in src/lib/send-sheets.ts.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import SendSheet from '../components/SendSheet.astro';
import '../styles/home-shelf.css';
import { SEND_HUB, SEND_SHEET_LIST, renderSheetText, sheetUrl } from '../lib/send-sheets';

const title = 'Things you can send someone';
const description =
  'Three one-sheets made to be texted: how to add an MCP, the AI tools on the desk, and ways to make capital with AI contributions. Each has a JSON twin and a plain-text twin.';
const text = renderSheetText(SEND_HUB);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/send',
  name: 'Things you can send someone.',
  description,
  url: 'https://pointcast.xyz/send',
  isPartOf: { '@id': 'https://pointcast.xyz/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: SEND_SHEET_LIST.length,
    itemListElement: SEND_SHEET_LIST.map((sheet, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: sheetUrl(sheet),
      name: sheet.title,
    })),
  },
};

const alternates = [
  { type: 'application/json', href: '/send.json', title: 'One-sheets (JSON)' },
  { type: 'text/plain', href: '/send.txt', title: 'One-sheets (plain text)' },
];
---

<BlockLayout title={title} description={description} immersive={false} jsonLd={jsonLd} alternates={alternates}>
  <main class="home send">
    <nav class="send__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>send</span>
    </nav>
    <SendSheet sheet={SEND_HUB} text={text} />
    <p class="send__machine">
      Machine twins: <a href="/send.json">/send.json</a> · <a href="/send.txt">/send.txt</a>
      {SEND_SHEET_LIST.map((sheet) => (
        <> · <a href={`${sheet.href}.json`}>{sheet.href}.json</a></>
      ))}
    </p>
  </main>
</BlockLayout>

<style>
  .send { max-width: 960px; padding-top: 14px; }
  .send__crumb {
    display: flex;
    gap: 8px;
    margin: 0 0 6px;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .send__crumb a { color: var(--pc-accent); }
  .send__machine {
    margin: 18px 0 0;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    overflow-wrap: anywhere;
  }
  .send__machine a { color: var(--pc-ink); }
</style>
