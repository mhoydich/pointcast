---
import BaseLayout from '../layouts/BaseLayout.astro';
import KennelTodayLive from '../components/KennelTodayLive.astro';
import { collectSitting, kennelGrid } from '../lib/collect-desk';

const today = collectSitting();
const grid = kennelGrid();
const title = 'Collect · A dog a day';
const description = 'Collect one free Kennel Club dog each day in September. Email is the easy way in; a PointCast session holds the claim until a wallet is ready.';
---

<BaseLayout title={title} description={description} image={today.image.png} hideAds>
  <main class="desk" data-collect-desk data-today-token={today.tokenId} data-kennel-today="attr" data-kennel-attr="data-today-token" data-kennel-value="{tokenId}">
    <nav class="desk__nav" aria-label="Collecting desk">
      <a href="/">PointCast</a><span>/</span><strong>Collect</strong>
      <a href="/collect.json">JSON</a><a href="/collect/shelf">Objkt shelf</a>
    </nav>

    <section class="hero" aria-labelledby="collect-title">
      <figure><img src={today.image.webp} alt={today.alt} width="1024" height="1280" fetchpriority="high" data-kennel-today="image" /></figure>
      <div class="hero__copy">
        <p class="eyebrow" data-kennel-today="text" data-kennel-text="Sitting {day} · {name} · free today">Sitting {String(today.day).padStart(2, '0')} · {today.name} · free today</p>
        <h1 id="collect-title">Collect a dog a day. <em>Free.</em></h1>
        <p class="hero__dek">Today’s plate arrives here at midnight Pacific. Confirm one email, stay signed in, and we’ll hold each claim until your Tezos wallet is ready.</p>

        <form class="promise" data-subscribe-form>
          <label for="collect-email">We’ll email you when tomorrow’s dog is ready</label>
          <div><input id="collect-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required /><button type="submit">Email me tomorrow’s dog</button></div>
          <p data-subscribe-status aria-live="polite">Double opt-in. One dog note a day. Unsubscribe in every email.</p>
        </form>

        <div class="signin" aria-label="Other sign-in options">
          <button type="button" data-auth="google">Continue with Google</button>
          <button type="button" data-auth="passkey">Use a passkey</button>
          <span data-auth-status aria-live="polite"></span>
        </div>

        <button class="claim" type="button" data-claim-today hidden data-kennel-today="text" data-kennel-text="Claim {name} — free">Claim {today.name} — free</button>
        <p class="claim__status" data-claim-status aria-live="polite"></p>
      </div>
    </section>

    <section class="collector" data-collector-panel aria-labelledby="collection-title">
      <header>
        <div><p class="eyebrow">Your September</p><h2 id="collection-title">Thirty sittings. One honest grid.</h2></div>
        <p data-collector-state>Sign in to reveal the plates you hold.</p>
      </header>
      <div class="stats" data-collect-stats hidden>
        <a data-handle href="/me"><span>Handle</span><strong>Claim yours</strong></a>
        <div><span>Streak</span><strong data-streak>0 days</strong></div>
        <div><span>Seals</span><strong data-seals>0 earned</strong><small data-next-seal>next at 7</small></div>
        <div><span>Mugs / Nouns</span><strong data-objects>0 / 0</strong></div>
      </div>
      <ol class="tiles" aria-label="The thirty September sittings">
        {grid.map((sitting) => (
          <li class="tile" data-day={sitting.day} data-token-id={sitting.tokenId} data-kennel-today="cell" data-kennel-day={sitting.day} data-sitting-status={sitting.day === today.day ? 'today' : sitting.day < today.day ? 'past' : 'future'}>
            <a href={sitting.href} aria-label={`Sitting ${sitting.day}: ${sitting.name}`}>
              <span class="tile__missing">{String(sitting.day).padStart(2, '0')}</span>
              <img src={sitting.image} alt={sitting.name} width="1024" height="1280" loading="lazy" />
              <small>{sitting.name}</small>
            </a>
          </li>
        ))}
      </ol>
      <footer><strong data-completion>0 / 30</strong><span>Complete September to earn the September Sitting seal.</span></footer>
    </section>
    <script id="collect-calendar" type="application/json" set:html={JSON.stringify(grid)} />
  </main>
  <KennelTodayLive />
</BaseLayout>

<script>
  import { getSession, loginWithGoogle, loginWithPasskey } from '../lib/auth/client';
  import { claimKennelClubSitting } from '../lib/collect-client';

  type CollectPayload = {
    signedIn: boolean;
    subscription: { status: string };
    claimedDays: number[];
    streak: number;
    nextSealAt: 7 | 30 | null;
    completion: { claimed: number; total: number; promise: string };
    handle: { status: string; handle?: string; label?: string; href: string };
    objects: { sealsEarned: number; mugsHeld: number; nounsHeld: number };
    today: { tokenId: number; name: string };
  };

  const root = document.querySelector<HTMLElement>('[data-collect-desk]');
  const subscribeForm = root?.querySelector<HTMLFormElement>('[data-subscribe-form]');
  const subscribeStatus = root?.querySelector<HTMLElement>('[data-subscribe-status]');
  const authStatus = root?.querySelector<HTMLElement>('[data-auth-status]');
  const claimButton = root?.querySelector<HTMLButtonElement>('[data-claim-today]');
  const claimStatus = root?.querySelector<HTMLElement>('[data-claim-status]');
  let collectionPayload: CollectPayload | null = null;

  function message(target: HTMLElement | null | undefined, value: string) {
    if (target) target.textContent = value;
  }

  function showCollection(payload: CollectPayload) {
    if (!root) return;
    collectionPayload = payload;
    const claimed = new Set(payload.claimedDays);
    root.querySelectorAll<HTMLElement>('[data-day]').forEach((tile) => {
      tile.classList.toggle('tile--claimed', claimed.has(Number(tile.dataset.day)));
    });
    const state = root.querySelector<HTMLElement>('[data-collector-state]');
    message(state, payload.claimedDays.length ? `${payload.claimedDays.length} plates held across your linked wallets.` : 'Signed in. Your first claim can be held before a wallet is linked.');
    const stats = root.querySelector<HTMLElement>('[data-collect-stats]');
    stats?.removeAttribute('hidden');
    const handle = root.querySelector<HTMLAnchorElement>('[data-handle]');
    if (handle) {
      handle.href = payload.handle.href;
      message(handle.querySelector('strong'), payload.handle.handle ? `@${payload.handle.handle}` : payload.handle.label || 'Claim yours');
    }
    message(root.querySelector('[data-streak]'), `${payload.streak} day${payload.streak === 1 ? '' : 's'}`);
    message(root.querySelector('[data-seals]'), `${payload.objects.sealsEarned} earned`);
    message(root.querySelector('[data-next-seal]'), payload.nextSealAt === null ? 'all milestones complete' : `next at ${payload.nextSealAt}`);
    message(root.querySelector('[data-objects]'), `${payload.objects.mugsHeld} / ${payload.objects.nounsHeld}`);
    message(root.querySelector('[data-completion]'), `${payload.completion.claimed} / ${payload.completion.total}`);
    if (payload.subscription.status === 'confirmed') message(subscribeStatus, 'Dog-a-day delivery confirmed. Tomorrow is automatic.');
    if (!payload.claimedDays.includes(payload.today.tokenId + 1)) {
      if (claimButton) claimButton.textContent = `Claim ${payload.today.name} — free`;
      claimButton?.removeAttribute('hidden');
    } else if (claimButton) {
      claimButton.hidden = true;
      message(claimStatus, `${payload.today.name} is already on your shelf.`);
    }
  }

  async function loadCollection(): Promise<CollectPayload | null> {
    const response = await fetch('/api/collect/me', { credentials: 'include', cache: 'no-store' });
    if (response.status === 401) return null;
    const payload = await response.json() as CollectPayload & { reason?: string };
    if (!response.ok) throw new Error(payload.reason || `collect-${response.status}`);
    showCollection(payload);
    return payload;
  }

  async function claimToday(payload?: CollectPayload | null) {
    const tokenId = payload?.today.tokenId ?? Number(root?.dataset.todayToken || 0);
    if (!claimButton || claimButton.disabled) return;
    claimButton.disabled = true;
    message(claimStatus, 'Claiming today’s sitting…');
    try {
      const result = await claimKennelClubSitting(tokenId);
      message(claimStatus, result.heldUntilWallet ? 'Claim held. Link a Tezos wallet whenever you’re ready.' : 'Claim accepted. Today’s dog is yours.');
      claimButton.hidden = true;
      await loadCollection();
    } catch (error) {
      message(claimStatus, error instanceof Error ? error.message : 'Claim unavailable. Try again.');
      claimButton.disabled = false;
    }
  }

  subscribeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(subscribeForm);
    const email = String(data.get('email') || '');
    const button = subscribeForm.querySelector<HTMLButtonElement>('button');
    if (button) button.disabled = true;
    message(subscribeStatus, 'Sending your confirmation link…');
    try {
      const response = await fetch('/api/collect/subscribe', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, tz: Intl.DateTimeFormat().resolvedOptions().timeZone }),
      });
      const result = await response.json() as { message?: string; reason?: string };
      if (!response.ok) throw new Error(result.reason || `subscribe-${response.status}`);
      subscribeForm.reset();
      message(subscribeStatus, result.message || 'Check your email to confirm.');
    } catch (error) {
      message(subscribeStatus, error instanceof Error ? error.message : 'Could not send confirmation.');
    } finally {
      if (button) button.disabled = false;
    }
  });

  root?.querySelectorAll<HTMLButtonElement>('[data-auth]').forEach((button) => {
    button.addEventListener('click', async () => {
      button.disabled = true;
      message(authStatus, button.dataset.auth === 'google' ? 'Opening Google…' : 'Checking this device…');
      try {
        const user = button.dataset.auth === 'google' ? await loginWithGoogle() : await loginWithPasskey();
        if (user) {
          message(authStatus, 'Signed in. Your desk is ready.');
          await loadCollection();
        }
      } catch (error) {
        message(authStatus, error instanceof Error ? error.message : 'Sign-in did not finish.');
      } finally {
        button.disabled = false;
      }
    });
  });

  claimButton?.addEventListener('click', () => void claimToday(collectionPayload));

  async function initialize() {
    try {
      const user = await getSession();
      if (!user) return;
      const payload = await loadCollection();
      const params = new URLSearchParams(window.location.search);
      if (params.get('confirmed') === '1') message(subscribeStatus, 'Confirmed. You are signed in and tomorrow is automatic.');
      if (params.get('claim') === '1') {
        params.delete('claim');
        params.delete('t');
        history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
        await claimToday(payload);
      }
    } catch (error) {
      message(authStatus, error instanceof Error ? error.message : 'Your desk could not load.');
    }
  }
  void initialize();
</script>

<style>
  .desk { --club:#8a2432; --paper:#f6efe5; width:min(1180px,calc(100vw - 24px)); margin:0 auto; padding:18px 0 90px; color:#171717; }
  .desk__nav,.eyebrow,.promise label,.promise p,.signin,.claim,.collector header>p,.stats span,.tiles small,.collector footer { font-family:var(--pc-font-mono); letter-spacing:.09em; text-transform:uppercase; }
  .desk__nav { display:flex; gap:8px; align-items:center; padding:10px 0; border-bottom:2px solid #171717; font-size:10px; }
  .desk__nav a:nth-last-child(2) { margin-left:auto; }
  .hero { display:grid; grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr); border:1.5px solid #171717; border-top:0; background:#fff; }
  .hero figure { margin:0; min-height:620px; background:var(--club); overflow:hidden; }
  .hero figure img { width:100%; height:100%; object-fit:cover; }
  .hero__copy { display:flex; flex-direction:column; padding:clamp(26px,5vw,68px); border-left:1.5px solid #171717; }
  .eyebrow { margin:0 0 14px; color:var(--club); font-size:10px; }
  h1,h2 { margin:0; font-weight:500; letter-spacing:-.06em; line-height:.88; }
  h1 { max-width:690px; font-size:clamp(58px,8vw,112px); } h1 em { color:var(--club); font-style:normal; }
  .hero__dek { max-width:620px; margin:24px 0 30px; color:#53504c; font-size:17px; line-height:1.5; }
  .promise { margin-top:auto; padding-top:20px; border-top:2px solid #171717; }
  .promise label { display:block; margin-bottom:9px; font-size:9px; }
  .promise>div { display:grid; grid-template-columns:1fr auto; }
  .promise input,.promise button,.signin button,.claim { min-height:48px; border:1px solid #171717; border-radius:0; font:500 12px var(--pc-font-mono); }
  .promise input { min-width:0; padding:0 13px; background:#fff; }
  .promise button,.claim { padding:0 16px; background:var(--club); color:#fff; cursor:pointer; }
  button:disabled { cursor:wait; opacity:.58; }
  .promise p { margin:9px 0 0; color:#6c6862; font-size:8px; line-height:1.5; }
  .signin { display:flex; flex-wrap:wrap; align-items:center; gap:7px; margin-top:10px; font-size:8px; }
  .signin button { min-height:36px; padding:0 11px; background:var(--paper); cursor:pointer; }
  .signin span { flex-basis:100%; min-height:1em; color:#67625d; }
  .claim { margin-top:18px; min-height:50px; }
  .claim__status { min-height:1.4em; margin:8px 0 0; color:var(--club); font-size:13px; }
  .collector { margin-top:34px; border:1.5px solid #171717; background:#fff; }
  .collector>header { display:grid; grid-template-columns:1.2fr .8fr; gap:24px; align-items:end; padding:24px; border-bottom:1.5px solid #171717; }
  h2 { font-size:clamp(38px,6vw,76px); }
  .collector header>p { margin:0; color:#666; font-size:9px; text-align:right; }
  .stats { display:grid; grid-template-columns:repeat(4,1fr); border-bottom:1.5px solid #171717; }
  .stats>* { display:grid; gap:7px; padding:13px; border-right:1px solid #171717; text-decoration:none; }
  .stats>*:last-child { border-right:0; } .stats span { color:#777; font-size:8px; } .stats strong { font-size:16px; font-weight:500; } .stats small { color:var(--club); font:500 8px/1.2 var(--pc-font-mono); text-transform:uppercase; }
  .tiles { display:grid; grid-template-columns:repeat(6,1fr); margin:0; padding:0; list-style:none; }
  .tile { position:relative; min-height:184px; border-right:1px solid #171717; border-bottom:1px solid #171717; background:var(--paper); }
  .tile:nth-child(6n) { border-right:0; }
  .tile a { display:grid; width:100%; height:100%; min-height:184px; place-items:center; color:#171717; text-decoration:none; overflow:hidden; }
  .tile__missing { font-size:36px; font-weight:500; letter-spacing:-.05em; }
  .tile img,.tile small { display:none; }
  .tile--claimed img { display:block; width:100%; height:184px; object-fit:cover; }
  .tile--claimed .tile__missing { display:none; }
  .tile--claimed small { position:absolute; right:5px; bottom:5px; left:5px; display:block; padding:5px; background:rgba(255,255,255,.92); font-size:7px; }
  .tile[data-sitting-status="today"] { box-shadow:inset 0 0 0 5px var(--club); z-index:1; }
  .tile[data-sitting-status="today"]::after { content:'today'; position:absolute; top:7px; left:7px; padding:4px 6px; background:var(--club); color:#fff; font:500 8px var(--pc-font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .collector footer { display:flex; justify-content:space-between; gap:16px; padding:14px; color:#5f5a55; font-size:9px; }
  .collector footer strong { color:var(--club); }
  [hidden] { display:none!important; }
  @media(max-width:760px){ .hero { grid-template-columns:1fr; } .hero figure { min-height:min(122vw,620px); } .hero__copy { border-left:0; border-top:1.5px solid #171717; } .collector>header { grid-template-columns:1fr; } .collector header>p { text-align:left; } .stats { grid-template-columns:1fr 1fr; } .stats>*:nth-child(2){border-right:0}.stats>*:nth-child(-n+2){border-bottom:1px solid #171717}.tiles{grid-template-columns:repeat(3,1fr)}.tile:nth-child(6n){border-right:1px solid #171717}.tile:nth-child(3n){border-right:0}.tile,.tile a{min-height:150px}.tile--claimed img{height:150px} }
  @media(max-width:520px){ .desk{width:min(100% - 16px,1180px)} .promise>div{grid-template-columns:1fr}.promise button{min-height:44px}.collector footer{flex-direction:column}.desk__nav{flex-wrap:wrap}.desk__nav a:nth-last-child(2){margin-left:0} }
</style>
