      if (key === palKey) return palCache;
      const base = paletteFor(machineId);
      const m = M();
      const p = { ...base };
      if (label === 'DAWN') { p.lawn = mix(base.lawn, base.field, 0.18); p.road = mix(base.road, m.raster[0], 0.06); }
