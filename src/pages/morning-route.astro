        porch() { if (!ac) return; const t = now(); voice({ freq: 120, type: 'triangle', t, dur: 0.08, vol: 0.24, slide: 0.6, r: 0.03 }); voice({ freq: midi(76), type: 'square', t: t + 0.05, dur: 0.1, vol: 0.14, r: 0.06 }); },
        mailbox() { if (!ac) return; const t = now(); [88, 91].forEach((n, i) => voice({ freq: midi(n), type: 'triangle', t: t + i * 0.09, dur: 0.18, vol: 0.2, r: 0.12 })); if (machineId === 'xl') noise(t, 0.03, 0.06, 5000); },
        miss() { if (ac) voice({ freq: 220, type: 'square', dur: 0.16, vol: 0.12, slide: 0.7, r: 0.04 }); },
        thud() { if (ac) voice({ freq: 90, type: 'triangle', dur: 0.06, vol: 0.14, slide: 0.7, r: 0.03 }); },
