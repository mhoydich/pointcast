      ctx.fillStyle = p.road; ctx.fillRect(ROAD.l, 0, ROAD.r - ROAD.l, H);
      ctx.fillStyle = p.curb; ctx.fillRect(CURB.l, 0, CURB.r - CURB.l, H);
