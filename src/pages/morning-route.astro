        ctx.fillStyle = p.lit; ctx.fillRect(porch.x1 - 4, py, 3, 3);
        const mb = mailboxRect(h);
        sprite(mailboxSprite(h.delivered === 'mailbox'), mb.x0, yOf(run, mb.s1) - 2, p);
        if (h.delivered === 'porch') sprite(PAPER_SPRITE, porch.x0 + 5, yOf(run, h.b + 67) - 2, p);
      }
    }
    function drawThings(run) {
      const p = pal();
      for (const th of run.things) {
        const y = yOf(run, th.s);
        if (y < -40 || y > H + 40) continue;
        if (th.kind === 'bundle') sprite(BUNDLE_SPRITE, th.x - 6, y - 4, p);
        else if (th.kind === 'ramp') sprite(RAMP_SPRITE, th.x - 12, y - 8, p);
        else if (th.kind === 'star') text('*', th.x, y - 5, 2, run.airT > 0 ? p.bright : p.yellow, 'center');
        else if (th.kind === 'bin') sprite(BIN_SPRITE, th.x - 4, y - 5, p);
        else if (th.kind === 'dog') sprite(DOG_SPRITES[REDUCED ? 0 : Math.floor(run.t * 4 + (th.wag || 0)) % 2], th.x - 7, y - 6, p);
        else if (th.kind === 'skater') sprite(SKATER_SPRITE, th.x - 4, y - 7, p);
        else if (th.kind === 'car') sprite(CAR_SPRITE, th.x - 13, y - 7, p);
        else if (th.kind === 'sprinkler') {
          sprite(SPRINKLER_SPRITE, th.x - 2, y - 2, p);
          if (sprinklerOn(th, run.t)) {
            // A fan of drops toward the walk; it sweeps unless motion is reduced.
            ctx.fillStyle = p.water;
            const sweep = REDUCED ? 0 : Math.sin((run.t + th.phase) * 5) * 3;
            for (let i = 1; i <= 6; i += 1) for (const dy of [-3, 0, 3]) ctx.fillRect(th.x - i * 4 + 2, y + Math.round(dy * (i / 6) + sweep * (i / 6)) - 1, 2, 2);
          }
        }
      }
    }
    function drawPapers(run) {
      const p = pal();
      for (const q of run.papersOut) {
        const y = yOf(run, q.s);
        const lift = Math.round(Math.sin(Math.PI * Math.min(1, (q.x - q.x0) / PAPER_RANGE)) * 8);
        ctx.globalAlpha = 0.35; ctx.fillStyle = p.ink; ctx.fillRect(Math.round(q.x) - 3, y, 6, 2); ctx.globalAlpha = 1;
        sprite(PAPER_SPRITE, q.x - 3, y - 2 - lift, p);
      }
    }
    function drawRider(run, alpha = 1) {
      const p = pal();
      let x = run.x - RIDER_SPRITE.w / 2, y = RY - RIDER_SPRITE.h / 2;
      if (run.crashT > 0) {
        // a tumble: the bike wobbles and three stars circle overhead
        x += REDUCED ? 2 : Math.round(Math.sin(run.t * 24) * 2);
        ctx.globalAlpha = alpha;
        sprite(RIDER_SPRITE, x, y + 2, p);
        for (let i = 0; i < 3; i += 1) { const a = (REDUCED ? 0 : run.t * 5) + i * 2.1; text('*', Math.round(run.x + Math.cos(a) * 8), Math.round(y - 6 + Math.sin(a) * 3), 1, p.yellow, 'center'); }
        ctx.globalAlpha = 1;
        return;
      }
      const lift = run.airT > 0 ? Math.round(Math.sin(Math.PI * (run.airT / AIR_TIME)) * 8) : 0;
      if (lift) { ctx.globalAlpha = 0.35 * alpha; ctx.fillStyle = p.ink; ctx.fillRect(Math.round(run.x) - 4, RY + 6, 8, 3); }
      ctx.globalAlpha = alpha * (run.invuln > 0 ? (REDUCED ? 0.6 : Math.floor(run.t * 10) % 2 ? 0.35 : 1) : 1);
      sprite(RIDER_SPRITE, x, y - lift, p);
      ctx.globalAlpha = 1;
    }
    function drawEffects(run) {
      for (const q of G.particles) {
        ctx.globalAlpha = 1 - q.t / q.life;
        ctx.fillStyle = q.color;
        ctx.fillRect(Math.round(q.x), yOf(run, q.s), 2, 2);
      }
      ctx.globalAlpha = 1;
      for (const f of G.floats) { ctx.globalAlpha = Math.min(1, 2 * (1 - f.t / 0.9)); text(f.text, Math.round(f.x), yOf(run, f.s), 2, f.color, 'center'); }
      ctx.globalAlpha = 1;
    }
    function drawHud(run) {
      const m = M(), p = pal();
      ctx.fillStyle = p.panel; ctx.fillRect(0, 0, W, HUD);
      ctx.fillStyle = m.text; ctx.globalAlpha = 0.5; ctx.fillRect(0, HUD - 1, W, 1); ctx.globalAlpha = 1;
      text(String(run.score).padStart(6, '0'), 6, 4, 2, m.bright);
      const label = response.label;
      const col = label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : label === 'DRIFT' ? m.bright : m.bands.green;
      text(label, W / 2 + 6, 4, 2, col, 'center');
      if (isCalm()) text('CALM', W - 6, 4, 2, m.bright, 'right');
      else { ctx.fillStyle = m.paddle; for (let i = 0; i < Math.min(run.riders, 6); i += 1) ctx.fillRect(W - 10 - i * 8, 5, 5, 8); }
      const house = clamp(Math.floor((run.s - START_RUN) / LOT) + 1, 0, HOUSES_PER_DAY);
      text(`${dayName(run.day).slice(0, 3)} ${house}/${HOUSES_PER_DAY}`, 6, 17, 2, m.bright);
      sprite(PAPER_SPRITE, W - 52, 19, p);
      text(`${run.papers}`.padStart(2, '0'), W - 6, 17, 2, run.papers > 2 ? m.bright : m.bands.yellow, 'right');
      text(`${deliveredCount(run)}/${subscriberCount(run)}`, W / 2 + 6, 17, 2, m.bright, 'center');
      // the mood tape along the HUD's lower edge
      if (mood.tape.length) {
        const n = Math.min(90, mood.tape.length), start = mood.tape.length - n;
        for (let i = 0; i < n; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(3 + i * 3, HUD - 3, 2, 2);
        }
      }
    }
    function panel(x, y, w, h) {
      const m = M(), p = pal();
      ctx.fillStyle = p.panel; ctx.fillRect(x, y, w, h);
      ctx.fillStyle = m.text; ctx.fillRect(x, y, w, 1); ctx.fillRect(x, y + h - 1, w, 1); ctx.fillRect(x, y, 1, h); ctx.fillRect(x + w - 1, y, 1, h);
    }
    const blink = () => REDUCED || Math.floor(G.t * 2) % 2 === 0;
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawTitle() {
      const m = M(), p = pal();
      const a = G.attractRun;
      drawStreet(a); drawThings(a); drawPapers(a); drawRider(a);
      ctx.globalAlpha = 0.55; ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H); ctx.globalAlpha = 1;
      panel(12, 54, W - 24, 226);
      rainbowText('MORNING', W / 2, 70, 5, [m.bands.red, m.bands.orange, m.bands.yellow, m.bands.green]);
      rainbowText('ROUTE', W / 2, 104, 5, [m.bands.yellow, m.bands.green, m.bands.red, m.bands.orange]);
      text('DELIVER THE MORNING EDITION', W / 2, 140, 2, m.bright, 'center');
      text('6:45 AM  EL SEGUNDO', W / 2, 156, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 180, 2, m.bright, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 196, 2, m.bright, 'center');
      if (blink()) text(COARSE ? 'TAP TO RIDE' : 'TAP OR PRESS SPACE', W / 2, 224, 2, p.prompt, 'center');
      if (best > 0) text(`BEST ${String(best).padStart(6, '0')}`, W / 2, 252, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 24, 2, m.bright, 'center');
    }
    function drawReady(run) {
      const m = M(), p = pal();
      const first = run.day === 0;
      const h = first ? 176 : 120;
      const y = Math.round(HUD + (RY - HUD - 30 - h) / 2);
      panel(16, y, W - 32, h);
      text(dayName(run.day), W / 2, y + 12, 4, m.bright, 'center');
      text(`${subscriberCount(run)} PAPERS TO DELIVER`, W / 2, y + 40, 2, m.bright, 'center');
      text(`${HOUSES_PER_DAY} HOUSES  ${run.papers} IN THE BAG`, W / 2, y + 56, 2, m.bright, 'center');
      let ly = y + 74;
      if (first) {
        text('LIT PORCHES TAKE THE PAPER', W / 2, ly, 2, m.bright, 'center'); ly += 16;
        text(COARSE ? 'DRAG TO STEER' : 'ARROWS STEER', W / 2, ly, 2, m.bright, 'center'); ly += 16;
        text(COARSE ? 'SWIPE UP OR DOWN: SPEED' : 'UP AND DOWN: SPEED', W / 2, ly, 2, m.bright, 'center'); ly += 16;
        text(COARSE ? 'TAP RIGHT HALF TO THROW' : 'SPACE THROWS', W / 2, ly, 2, m.bright, 'center'); ly += 22;
      } else ly += 10;
      if (blink()) text(COARSE ? 'TAP TO RIDE' : 'TAP OR SPACE TO RIDE', W / 2, ly, 2, p.prompt, 'center');
    }
    function drawReportCard(r, y, title) {
      const m = M(), p = pal();
      const lines = reportLines(r);
      const h = 34 + lines.length * 12 + 34;
      panel(16, y, W - 32, h);
      text(title || lines[0], W / 2, y + 10, 2, p.prompt, 'center');
      lines.slice(1).forEach((line, i) => text(line, 36, y + 28 + i * 12, 2, i === lines.length - 2 ? m.bands.yellow : m.bright));
      return y + h;
    }
    function drawReport() {
      const m = M(), p = pal();
      const r = G.report;
      const end = drawReportCard(r, HUD + 14, `${r.day} REPORT CARD`);
      if (G.extra) text('PERFECT DAY: EXTRA RIDER', W / 2, end - 44, 2, m.bands.yellow, 'center');
      else if (r.perfect) text('PERFECT DAY', W / 2, end - 44, 2, m.bands.yellow, 'center');
      if (G.t > 0.8 && blink()) text(COARSE ? 'TAP FOR TOMORROW' : 'TAP OR SPACE: TOMORROW', W / 2, end - 22, 2, p.prompt, 'center');
    }
    function drawOver() {
      const m = M(), p = pal();
      const run = G.run;
      const y = HUD + 18;
      panel(16, y, W - 32, 196);
      text('ROUTE OVER', W / 2, y + 14, 4, m.bright, 'center');
      text(`SCORE ${String(G.score).padStart(6, '0')}`, W / 2, y + 50, 2, m.bright, 'center');
      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, y + 66, 2, m.bands.yellow, 'center');
      text(`${dayName(run.day)}  HOUSE ${clamp(Math.floor((run.s - START_RUN) / LOT) + 1, 0, HOUSES_PER_DAY)}`, W / 2, y + 90, 2, m.bright, 'center');
      text(`DELIVERED ${deliveredCount(run)}/${subscriberCount(run)} TODAY`, W / 2, y + 106, 2, m.bright, 'center');
      text(`PEAK MOOD ${mood.peak}`, W / 2, y + 122, 2, m.bright, 'center');
      if (G.t > 1 && blink()) text(COARSE ? 'TAP TO RIDE AGAIN' : 'TAP OR SPACE TO RIDE AGAIN', W / 2, y + 160, 2, p.prompt, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, W, H); ctx.clip();
      if (G.phase === 'boot') drawBoot();
      else if (G.phase === 'title') drawTitle();
      else {
        const run = G.run, m = M();
        drawStreet(run); drawThings(run); drawPapers(run);
        drawRider(run); drawEffects(run);
        if (G.flash > 0) { ctx.globalAlpha = Math.min(REDUCED ? 0.12 : 0.4, G.flash); ctx.fillStyle = m.bright; ctx.fillRect(0, 0, W, H); ctx.globalAlpha = 1; }
        drawHud(run);
        if (G.phase === 'ready') drawReady(run);
        if (G.phase === 'report') drawReport();
        if (G.phase === 'over') drawOver();
        if (G.phase === 'paused') {
          panel(40, 150, W - 80, 70);
          text('PAUSED', W / 2, 164, 4, m.bright, 'center');
          text(COARSE ? 'TAP TO RESUME' : 'P OR SPACE TO RESUME', W / 2, 198, 2, pal().prompt, 'center');
        }
        if (G.phase === 'play' && G.msgT > 0 && G.msg) {
          const w = textWidth(G.msg, G.msgScale) + 20, hh = 5 * G.msgScale + 16;
          panel(Math.round(W / 2 - w / 2), 120, w, hh);
          text(G.msg, W / 2, 128, G.msgScale, m.bright, 'center');
        }
      }
      ctx.restore();
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const attract = G.phase === 'title' || G.phase === 'boot';
        const run = attract ? null : G.run;
        readout.mood.textContent = `${attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${attract ? 104 : response.tempo} BPM ${attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.day.textContent = run ? `${dayName(run.day).slice(0, 3)} ${clamp(Math.floor((run.s - START_RUN) / LOT) + 1, 0, HOUSES_PER_DAY)}/${HOUSES_PER_DAY}` : 'MON 0/16';
        readout.papers.textContent = run ? `PAPERS ${run.papers}` : 'PAPERS 10';
        readout.fps.textContent = `${G.fps} FPS`;
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    /** Everything a tap or Space does outside of riding. True when it was used. */
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return true; }
      if (G.phase === 'title') { newGame(); return true; }
      // The last fall usually comes mid-tap; let the score show before a new route starts.
      if (G.phase === 'over') { if (G.t > 1) newGame(); return true; }
      if (G.phase === 'ready') { G.phase = 'play'; G.t = 0; announce('Ride.'); return true; }
      if (G.phase === 'report') { if (G.t > 0.8) startDay(G.day + 1); return true; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; G.resume = null; audio.setMusic(true); return true; }
      return false;
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      const p = pointerToField(e);
      if (G.phase !== 'play') { action(); return; }
      audio.unlock();
      pointers.set(e.pointerId, { x: p.x, y: p.y });
      if (p.x >= W / 2) G.input.throw = true;
    });
    canvas.addEventListener('pointermove', (e) => {
      const q = pointers.get(e.pointerId);
      if (!q) return;
      const p = pointerToField(e);
      // Drag steers one to one; dragging up pedals faster, down eases off.
      G.input.dx += p.x - q.x;
      G.input.dThrottle += -(p.y - q.y) * 0.012;
      q.x = p.x; q.y = p.y;
    });
    const release = (e) => { pointers.delete(e.pointerId); };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('lostpointercapture', release);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    const RIDE_KEYS = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'KeyA', 'KeyD', 'KeyW', 'KeyS']);
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; arrows and letters still ride from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (RIDE_KEYS.has(k)) { G.keys[k] = true; e.preventDefault(); audio.unlock(); return; }
      if (k === 'Space' || k === 'Enter') {
        e.preventDefault();
        if (G.phase === 'play') { audio.unlock(); if (!e.repeat) G.input.throw = true; } else if (!e.repeat) action();
        return;
      }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function togglePause() {
      if (G.phase === 'play') { G.resume = 'play'; G.phase = 'paused'; audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; G.resume = null; audio.setMusic(true); }
    }
    const releaseAll = () => { G.keys = {}; pointers.clear(); G.input = { dx: 0, dThrottle: 0, throw: false }; };
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        releaseAll();
        // A ride in progress, a tumble included, pauses and resumes into that moment.
        if (G.phase === 'play') { G.resume = 'play'; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', releaseAll);
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      // Riders are never counted down on CALM, so leaving it keeps the count you had; a last fall already
      // counting down to the end stays final.
      setDial(mood, next); response = moodResponse(mood);
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}.`);
      if (G.phase === 'play') showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space throws again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
