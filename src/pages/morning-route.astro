---
/**
 * /morning-route — deliver the Morning Edition.
 *
 * A Paperboy-style route (after Atari Games' 1985 arcade game) on an El
 * Segundo street at 6:45 AM, when PointCast's Morning Edition comes out.
 * Directed by Michael Hoydich (brief 2026-10-22: 80s innocence, joy of the
 * compute and flow, mood-state symbiosis, mobile and full screen,
 * audio-visual multimedia, Atari and Commodore inspired, rendered modern).
 * A wave-two cabinet on Cabinet Row.
 *
 * Everything in the playfield is plain rects and the 3x5 pixel font on a
 * canvas; every sound is synthesized in the browser. The street, the ride and
 * the report card live in src/lib/morning-route (tests/morning-route.test.mjs);
 * the font, palettes and mood are Breakwater's shared modules.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { HOUSES_PER_DAY, PAPERS_START, SCORE } from '../lib/morning-route/route.mjs';

const description = 'A paper-route arcade game with 1980s innocence: ride an El Segundo street at 6:45 AM, throw the Morning Edition onto lit porches and into mailboxes, and weave past sprinklers, a sitting dog and a car backing out. Atari 800XL or Commodore 64 colors, synthesized chip sound, a mood you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/morning-route';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Morning Route',
      alternateName: 'Morning Route: deliver the Morning Edition',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/morning-route/og.png',
      gamePlatform: 'Web browser',
      genre: 'Arcade',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Morning Route', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
const DIAL_NOTES = { calm: 'crashes never end the route', play: 'three riders, an extra rider for a perfect day', rush: 'starts hot; the street goes faster and a ramp lane appears' };
---

<BlockLayout
  title="Morning Route"
  description={description}
  image="/images/morning-route/og.png"
  imageAlt="A blue pixel street at dawn with lit porches, a mailbox, a sitting dog and a rider on a bike beside the words Morning Route, deliver the Morning Edition."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/morning-route.json', title: 'Morning Route rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/morning-route/og.png',
    buttons: [
      { label: 'Play Morning Route', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="mr" data-mr data-machine="xl" data-crt="on">
    <div class="mr-stage" data-stage>
      <header class="mr-bar">
        <a class="mr-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="mr-name" aria-hidden="true">MORNING ROUTE</span>
        <div class="mr-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="mr-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Morning Route playfield. Steer the rider up the street and throw the paper to the right, onto lit porches and into mailboxes."></canvas>
        <div class="mr-scan" aria-hidden="true"></div>
        <noscript><p class="mr-noscript">Morning Route needs JavaScript to draw the street and make its sounds. The rules and moods are readable at <a href="/morning-route.json">/morning-route.json</a>.</p></noscript>
      </div>
      <footer class="mr-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>104 BPM</span>
        <span data-r-day>MON 0/{HOUSES_PER_DAY}</span>
        <span data-r-papers>PAPERS {PAPERS_START}</span>
        <span data-r-fps>-- FPS</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="mr-notes">
      <p class="mr-eyebrow">PointCast / Games / Morning Route</p>
      <h1>Deliver the Morning Edition.</h1>
      <p class="mr-lede">It is 6:45 AM in El Segundo and the Morning Edition is out. Ride up the street, throw a paper onto every lit porch, and get it in the mailbox when you can. The street answers how you ride.</p>

      <div class="mr-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Deliveries raise its <strong>energy</strong>; a crash lowers its <strong>calm</strong>; time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="mr-moods">
            <li><b>DAWN</b> warming up. Dewy lawns, a bouncy major tune, porches and mailboxes a little easier to hit.</li>
            <li><b>FLOW</b> five porches in a row without a fall. Bright lawns, the music opens up.</li>
            <li><b>RUSH</b> the street speeds up, the border runs raster bars, the targets tighten, and a short ramp lane with stars to catch in the air appears on the left.</li>
            <li><b>DRIFT</b> after a crash. The street slows, the gaps between obstacles widen, bundles come sooner and the targets grow.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({DIAL_NOTES[d.id]}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape stays in this browser, and when you leave after a ride, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>The route</h2>
          <p>{HOUSES_PER_DAY} houses a day, Monday to Sunday, then the week starts again a little faster. Lit porches take the paper; dark houses do not. A paper on a lit porch scores {SCORE.porch}, in its mailbox {SCORE.mailbox}; a paper on a dark house is a miss. You start each day with {PAPERS_START} papers and pick up bundles from the road. Every subscriber served is a perfect day: a bonus and, on PLAY or RUSH, an extra rider. The day ends with a report card.</p>
          <p>The street is gentle: sprinklers that come and go, trash bins, a friendly dog that just sits there, a car backing out of its driveway, skateboarders rolling down the road. Bump one and you fall off; three falls end the route, never on CALM.</p>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border; raw square waves with a noise bite, in the POKEY spirit. A READY prompt and a RUN before the street.' : 'The blue field inside a light-blue border; a resonant filter sweep on every voice, in the SID spirit. The BASIC banner, then LOAD, then RUN.'}</p>
          ))}
        </article>
        <article>
          <h2>Controls</h2>
          <ul>
            <li>Phone: drag anywhere to steer; drag up to pedal faster, down to ease off; tap the right half of the field to throw. Two thumbs work: one steers, one throws.</li>
            <li>Keys: ← → or A D steer, ↑ ↓ or W S speed up and slow down, Space throws, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>The paper flies to the right and keeps your pace, so throw a moment before the porch reaches you.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
          <h2>After Paperboy</h2>
          <p>Paperboy (Atari Games, 1985) put a newspaper route on an arcade cabinet with handlebars. Morning Route borrows the idea, a week of days, subscribers and non-subscribers, a bag of papers that runs out, and turns the trouble down to a friendly street. Nothing is copied: the sprites are plain rectangles drawn for this page, and the music is generated as you ride. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-morning-route-notes.md">research note</a>.</p>
        </article>
      </div>

      <footer class="mr-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026. Original code, art and synthesized sound; no ROMs, no recordings, no characters from any other game. Machine names are tributes.</p>
        <p><a href="/cabinet-row">Cabinet Row</a> · <a href="/morning-route.json">morning-route.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .mr { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .mr[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .mr-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .mr-stage:fullscreen { height: 100%; min-height: 0; }
  .mr-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .mr-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .mr-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .mr-home:hover { color: #fff; }
  .mr-name { color: #fff; font-weight: 700; margin-right: auto; }
  .mr-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .mr-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .mr-controls button:hover { background: #1f2456; }
  .mr-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .mr-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .mr-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .mr-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .mr-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .mr[data-crt='off'] .mr-scan { display: none; }
  .mr-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .mr-noscript a { color: var(--paddle); }
  .mr-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .mr-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .mr-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .mr-readout a:hover { color: #fff; }
  .mr-stage:fullscreen .mr-readout a { display: none; }
  .mr-stage:-webkit-full-screen .mr-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mr-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .mr-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .mr-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .mr-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .mr-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .mr-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .mr-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .mr-grid p + h2, .mr-grid ul + h2 { margin-top: 22px; }
  .mr-grid p { margin: 0 0 12px; }
  .mr-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .mr-grid li { margin-bottom: 6px; }
  .mr-moods { list-style: none; padding: 0 !important; }
  .mr-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .mr-notes a { color: #a9b9f5; }
  .mr-notes a:hover { color: #fff; }
  .mr-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .mr-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .mr-stage { min-height: 0; }
    .mr-bar { gap: 8px; padding: 6px 10px; }
    .mr-name { display: none; }
    .mr-controls { gap: 4px; }
    .mr-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .mr-readout { gap: 10px; font-size: 9px; height: 26px; }
    .mr-readout [data-r-fps], .mr-readout [data-r-tempo] { display: none; }
    .mr-grid { grid-template-columns: 1fr; gap: 20px; }
    .mr-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .mr-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import {
    W, ROAD, CURB, WALK, LAWN, HOUSE, LOT, START_RUN, DAY_LENGTH, HOUSES_PER_DAY, PAPER_RANGE, RIDERS_START, AIR_TIME,
    MOOD_FOR_EVENT, createRun, stepRun, autopilot, dayName, subscriberCount, deliveredCount, sprinklerOn, reportLines, houseRect, porchRect, mailboxRect, drivewayRect, pathRect,
  } from '../lib/morning-route/route.mjs';
  import { paletteFor, mix, eachRect, RIDER_SPRITE, PAPER_SPRITE, BUNDLE_SPRITE, BIN_SPRITE, DOG_SPRITES, SPRINKLER_SPRITE, SKATER_SPRITE, CAR_SPRITE, RAMP_SPRITE, mailboxSprite } from '../lib/morning-route/sprites.mjs';

  const root = document.querySelector('[data-mr]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const H_MIN = 384, H_MAX = 480, HUD = 32;
    let H = H_MIN;
    let RY = H - 84;
    const STORE = 'morning-route:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;
    const ATTRACT = Object.freeze({ label: 'DAWN', speed: 1, paddle: 1.1, density: 0.4 });

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      day: root.querySelector('[data-r-day]'),
      papers: root.querySelector('[data-r-papers]'),
      fps: root.querySelector('[data-r-fps]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) && settings.best > 0 ? Math.floor(settings.best) : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a route that was actually ridden, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    const isCalm = () => !!DIALS[mood.dial].unlimitedBalls;

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 104, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // A four-bar loop per scale; each chord is root, third, fifth, top.
      const PROG = {
        major: [[60, 64, 67, 72], [65, 69, 72, 77], [57, 60, 64, 69], [55, 59, 62, 67]],
        bright: [[60, 64, 67, 71], [62, 66, 69, 74], [64, 67, 71, 76], [62, 66, 69, 74]],
        minor: [[57, 60, 64, 69], [55, 59, 62, 67], [53, 57, 60, 65], [52, 56, 59, 64]],
        soft: [[60, 67, 72, 76], [57, 64, 69, 72], [53, 60, 65, 69], [55, 62, 67, 71]],
      };
      // Melody: chord-tone indexes per 16th, -1 rests; two phrases alternate by bar.
      const TUNE = [
        [2, -1, 3, -1, 2, -1, 1, -1, 0, -1, 1, 2, -1, -1, 1, -1],
        [3, -1, 2, 1, 2, -1, 3, -1, 2, -1, 1, -1, 0, -1, -1, -1],
      ];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, freq = 2400, dest = sfx) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(dest); s.start(t);
      }
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const bar = Math.floor(s / 16);
        const chord = chords[bar % chords.length];
        const idx = s % 16;
        // Oom-pah bass: root on the beat, fifth on the off-beat.
