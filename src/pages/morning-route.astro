      rect({ ...body, x0: body.x0 + 8 }, roofs[h.style]);
      rect({ x0: body.x0 + 8 + Math.round((body.x1 - body.x0 - 8) / 2) - 1, x1: body.x0 + 8 + Math.round((body.x1 - body.x0 - 8) / 2) + 1, s0: body.s0, s1: body.s1 }, p.ink);
