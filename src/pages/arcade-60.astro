---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Arcade 60';
const description = 'Fifty one-minute games and ten CC0 Noun presses, broadcast into PointCast from El Segundo.';
const cabinets = [
  ['01', 'Beach Ball Panic', 'reaction'], ['07', 'Court Sequence', 'memory'],
  ['13', 'Sunset Stop', 'timing'], ['19', 'Palm Alignment', 'tuning'],
  ['25', 'Strange Sock', 'odd one'], ['28', 'Rain on Glass', 'speed'],
  ['32', 'Noun Number', 'guessing'], ['36', 'Ink Argument', 'color'],
  ['43', 'Pocket Anagram', 'letters'], ['49', 'Night Walk', 'path'],
  ['51–60', 'Ten Noun Presses', 'mint drafts'], ['ALL', 'Full Arcade', '60 things'],
];
---
<BaseLayout title={title} description={description} image="/images/og-drum-altars.png">
  <main class="pc60">
    <header class="pc60__head">
      <a href="/" class="pc60__back">POINTCAST / CH.PLAY</a>
      <span>EL SEGUNDO · 2026</span>
      <h1>ARCADE<br/><i>60</i></h1>
      <p>Fifty quick games. Ten small Noun presses. No account, no season pass, no silent mint.</p>
      <a class="pc60__enter" href="https://arcade-60.mhoydich.chatgpt.site" target="_blank" rel="noreferrer">ENTER THE FULL ARCADE ↗</a>
    </header>
    <section class="pc60__cabinets" aria-label="Featured Arcade 60 cabinets">
      {cabinets.map(([no,name,kind],index)=><a href="https://arcade-60.mhoydich.chatgpt.site" target="_blank" rel="noreferrer" style={`--cab:${['#ff5d36','#39b8ff','#c8ef43','#ffca37','#be8aff','#ff8cc6'][index%6]}`}><span>{no}</span><strong>{name}</strong><em>{kind}</em><b>PLAY ↗</b></a>)}
    </section>
    <section class="pc60__broadcast">
      <div><span>LIVE SATELLITE</span><h2>Play it here.</h2><p>The complete standalone arcade is embedded below. Open it directly when you want the whole screen.</p></div>
      <iframe title="Arcade 60 — fifty mini games and ten Noun presses" src="https://arcade-60.mhoydich.chatgpt.site" loading="lazy"></iframe>
    </section>
  </main>
</BaseLayout>
<style>
  .pc60{--ink:#151b17;--paper:#f3eed8;margin:0 -32px;background:var(--paper);color:var(--ink);font-family:var(--pc-font-sans,Arial,sans-serif)}
  .pc60__head{min-height:720px;padding:40px 5vw 70px;background:var(--ink);color:var(--paper);position:relative;overflow:hidden}
  .pc60__head:after{content:'60';position:absolute;right:-3vw;bottom:-8vw;font-size:32vw;font-weight:900;line-height:.7;color:#ff5d36;opacity:.85;letter-spacing:-.12em}
  .pc60__back,.pc60__head>span{position:relative;z-index:2;font:700 10px var(--pc-font-mono,monospace);letter-spacing:.16em;text-decoration:none}.pc60__head>span{float:right}
  .pc60 h1{position:relative;z-index:2;font-size:clamp(90px,17vw,230px);line-height:.64;letter-spacing:-.09em;margin:110px 0 45px;max-width:900px}.pc60 h1 i{font-family:Georgia,serif;color:#c8ef43;font-weight:400}
  .pc60__head p{position:relative;z-index:2;font:22px/1.35 Georgia,serif;max-width:560px}.pc60__enter{position:relative;z-index:2;display:inline-block;margin-top:30px;padding:16px 20px;background:#39b8ff;color:var(--ink);font:900 10px var(--pc-font-mono,monospace);letter-spacing:.14em;text-decoration:none}
  .pc60__cabinets{display:grid;grid-template-columns:repeat(4,1fr);border-top:3px solid var(--ink);border-left:3px solid var(--ink)}
  .pc60__cabinets a{min-height:230px;padding:20px;border-right:3px solid var(--ink);border-bottom:3px solid var(--ink);display:flex;flex-direction:column;text-decoration:none;background:var(--paper);transition:.15s}.pc60__cabinets a:hover{background:var(--cab);transform:translate(-4px,-4px);box-shadow:7px 7px 0 var(--ink);z-index:2}
  .pc60__cabinets span,.pc60__cabinets em,.pc60__cabinets b{font:900 9px var(--pc-font-mono,monospace);text-transform:uppercase;letter-spacing:.14em}.pc60__cabinets strong{font-size:28px;line-height:.9;letter-spacing:-.04em;margin:auto 0}.pc60__cabinets em{font-style:normal}.pc60__cabinets b{margin-top:10px}
  .pc60__broadcast{padding:90px 5vw;background:#282f2b;color:var(--paper)}.pc60__broadcast>div{display:grid;grid-template-columns:140px 1fr 1fr;gap:30px;align-items:end;margin-bottom:40px}.pc60__broadcast span{font:900 9px var(--pc-font-mono,monospace);letter-spacing:.15em}.pc60__broadcast h2{font-size:70px;letter-spacing:-.06em;margin:0}.pc60__broadcast p{font:17px/1.45 Georgia,serif}.pc60__broadcast iframe{width:100%;height:80vh;border:3px solid var(--paper);background:var(--paper)}
  @media(max-width:760px){.pc60{margin:0 -16px}.pc60__head{min-height:650px}.pc60__cabinets{grid-template-columns:repeat(2,1fr)}.pc60__cabinets a{min-height:180px}.pc60__broadcast>div{display:block}.pc60__broadcast h2{font-size:55px;margin:25px 0}.pc60__broadcast iframe{height:72vh}}
</style>
