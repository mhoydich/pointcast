<style is:inline>
[hidden]{display:none!important}
:root{
  --bg:#FFF3DF; --bg2:#FFE6BF; --card:#FFFDF8; --cell:#F4E3C8; --cell2:#EAD3AE;
  --ink:#1D1426; --ink2:#6A5A70; --line:#1D1426; --shadow:#1D1426;
  --red:#E8452C; --yellow:#FFC93C; --blue:#2F7CF6; --pink:#FF6FA8; --mint:#1FB985; --grape:#8C5CF0; --orange:#FF8A3D;
  --kick:var(--red); --snare:var(--yellow); --hat:var(--blue); --clap:var(--pink); --perc:var(--mint); --bass:var(--grape); --bell:var(--orange);
  --noun-bg:#D5D7E1;
  --r:14px; --tabh:58px;
  --font: ui-rounded, "SF Pro Rounded", "Nunito", "Varela Round", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1A1222; --bg2:#251A30; --card:#2B2037; --cell:#352943; --cell2:#403250;
    --ink:#FFF3DF; --ink2:#C4B3CE; --line:#07040A; --shadow:#07040A; --noun-bg:#C9CBD6; color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1A1222; --bg2:#251A30; --card:#2B2037; --cell:#352943; --cell2:#403250;
  --ink:#FFF3DF; --ink2:#C4B3CE; --line:#07040A; --shadow:#07040A; --noun-bg:#C9CBD6; color-scheme: dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;overflow:hidden;overscroll-behavior:none}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.3;
  -webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;
  -webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-text-size-adjust:100%}
input,textarea{-webkit-user-select:text;user-select:text;font:inherit;color:inherit}
button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
svg{display:block}
.app{position:fixed;inset:0;display:grid;grid-template-rows:auto 1fr auto;background:var(--bg);overflow:hidden}

/* ---------- header ---------- */
.top{display:flex;align-items:center;gap:10px;padding:calc(env(safe-area-inset-top) + 6px) max(12px,env(safe-area-inset-right)) 6px max(12px,env(safe-area-inset-left));min-height:52px}
.me-chip{border:0;background:none;padding:0;border-radius:12px;flex:none}
.top-title{display:flex;flex-direction:column;line-height:1;flex:1;min-width:0}
.brand{font-weight:900;font-size:20px;letter-spacing:-.02em}
.brand b{color:var(--red);margin-left:2px}
.sub{font-size:11px;font-weight:800;color:var(--ink2);text-transform:uppercase;letter-spacing:.12em;margin-top:3px}
.top-actions{display:flex;gap:8px;align-items:center}
.top-actions [data-for]{display:none}
.app[data-tab="make"] .top-actions [data-for~="make"],.app[data-tab="rooms"] .top-actions [data-for~="rooms"],.app[data-tab="me"] .top-actions [data-for~="me"],
.app[data-tab="daily"] .top-actions [data-for~="daily"],.app[data-tab="share"] .top-actions [data-for~="share"],.app[data-tab="wall"] .top-actions [data-for~="wall"]{display:flex;align-items:center;justify-content:center}
.town-pill{align-items:center;gap:6px;font-weight:900;font-variant-numeric:tabular-nums;background:var(--card);border:2.5px solid var(--line);border-radius:999px;padding:5px 10px 5px 8px;box-shadow:0 3px 0 var(--shadow);font-size:14px}
.town-pill svg{width:18px;height:18px;fill:var(--red);stroke:var(--line);stroke-width:2}
.town-pill.bump{animation:bump .25s}
@keyframes bump{50%{transform:scale(1.08)}}

/* ---------- buttons ---------- */
.btn,.icon-btn,.chip,.slot,.play,.bpm{border:2.5px solid var(--line);background:var(--card);border-radius:var(--r);box-shadow:0 3px 0 var(--shadow);font-weight:800;transition:transform .05s,box-shadow .05s}
.btn:active,.icon-btn:active,.chip:active,.slot:active,.play:active,.bpm:active,.btn.press{transform:translateY(2px);box-shadow:0 1px 0 var(--shadow)}
.btn{padding:11px 14px;font-size:15px}
.btn.sm{padding:7px 10px;font-size:13px;border-radius:11px}
.btn.big{padding:15px 18px;font-size:18px;border-radius:18px}
.btn.primary{background:var(--red);color:#fff}
.btn.ghost{background:transparent;box-shadow:none;border-style:dashed}
.btn.wide{width:100%;margin-top:14px}
.btn:disabled{opacity:.45;pointer-events:none}
.icon-btn{width:40px;height:40px;display:grid;place-items:center;padding:0;border-radius:12px}
.icon-btn svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.icon-btn[aria-pressed="true"]{background:var(--yellow);color:#1D1426}
#moreBtn svg{fill:currentColor;stroke:none}
#padsBtn svg{fill:currentColor;stroke:none}
.rec-dot{display:block;width:16px;height:16px;border-radius:50%;background:var(--red);border:2px solid var(--line)}
#recBtn.on{background:var(--red)}
#recBtn.on .rec-dot{background:#fff;border-radius:3px;animation:pulse 1s infinite}
@keyframes pulse{50%{opacity:.4}}
.chip{padding:7px 11px;font-size:13px;border-radius:999px;box-shadow:0 2px 0 var(--shadow)}
.chip.on{background:var(--yellow);color:#1D1426}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.row2,.row3{display:grid;gap:10px;margin-top:12px}
.row2{grid-template-columns:1fr 1fr}
.row3{grid-template-columns:1fr 1fr 1fr}
.card{background:var(--card);border:2.5px solid var(--line);border-radius:20px;box-shadow:0 4px 0 var(--shadow)}
.lbl{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--ink2)}
.muted{color:var(--ink2);font-weight:600;font-size:12px}
.fine{font-size:12px;color:var(--ink2);text-align:center;margin:14px 8px 4px}
.hint{font-size:13px;color:var(--ink2);text-align:center;margin:8px 0 0}

/* ---------- noun avatar ---------- */
.nv{position:relative;display:block;aspect-ratio:1;background:var(--noun-bg);border-radius:10px;overflow:hidden;border:2.5px solid var(--line);flex:none}
.nv img{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;display:block;-webkit-user-drag:none;pointer-events:none}
.nv .lid{position:absolute;top:37.5%;height:12.5%;width:12.5%;opacity:0;pointer-events:none;
  background:linear-gradient(to bottom,#fff 0 55%,#000 55% 80%,#fff 80%)}
.nv .lid.l{left:34.375%}.nv .lid.r{left:56.25%}
.nv.blink .lid{opacity:1}
.nv.sm{width:40px;border-radius:11px}
.nv.lg{width:88px;border-radius:16px}
.nv.xl{width:min(56vw,220px);border-radius:26px;border-width:3px}

/* ---------- views ---------- */
.views{position:relative;min-height:0}
.view{position:absolute;inset:0;padding:6px max(12px,env(safe-area-inset-left)) 12px max(12px,env(safe-area-inset-right))}
.view.scroll{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.view.enter{animation:enter .16s ease-out}
@keyframes enter{from{opacity:0;transform:translateY(6px)}}

/* ---------- tabs ---------- */
.tabs{display:grid;grid-template-columns:repeat(6,1fr);gap:2px;padding:6px max(8px,env(safe-area-inset-right)) calc(6px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left));border-top:2.5px solid var(--line);background:var(--bg2)}
.tab{border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:2px;padding:5px 0 3px;border-radius:14px;font-size:10.5px;min-width:0;font-weight:900;color:var(--ink2);letter-spacing:.02em}
.tab svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.tab svg .f{fill:currentColor}
.tab[aria-selected="true"]{color:var(--ink);background:var(--yellow);box-shadow:inset 0 0 0 2.5px var(--line)}
.tab[aria-selected="true"]{color:#1D1426}
.tab:active svg{transform:scale(.9)}

/* ---------- make ---------- */
.make{display:flex;flex-direction:column;gap:8px;padding-top:2px}
.band,.grid{display:grid;grid-template-columns:16px repeat(7,minmax(0,1fr));column-gap:5px}
.band::before{content:""}
.drummer{border:0;background:none;padding:0;display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0}
.drummer .nv{width:100%;max-width:52px;background:var(--c);transform-origin:50% 90%}
.drummer .tl{font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.04em;color:#fff;background:var(--c);border:2px solid var(--line);border-radius:7px;padding:1px 4px;line-height:1.1;text-shadow:0 1px 0 rgba(0,0,0,.25);max-width:100%;overflow:hidden}
.drummer.muted .nv{filter:grayscale(1) brightness(.85);opacity:.6}
.drummer.muted .tl::after{content:" zz"}
.t0{--c:var(--kick)}.t1{--c:var(--snare)}.t2{--c:var(--hat)}.t3{--c:var(--clap)}.t4{--c:var(--perc)}.t5{--c:var(--bass)}.t6{--c:var(--bell)}.t7{--c:var(--hat)}.t8{--c:var(--red)}
.stage{position:relative;flex:1;min-height:0}
.grid{position:absolute;inset:0;grid-template-rows:repeat(16,minmax(0,1fr));row-gap:3px;touch-action:none}
.grid .sn{font-size:9px;font-weight:900;color:var(--ink2);display:grid;place-items:center;opacity:.55}
.grid .sn.beat{opacity:1;color:var(--ink)}
.cell{position:relative;border-radius:7px;background:var(--cell);border:0;padding:0;min-height:0}
.cell.beat{background:var(--cell2)}
.cell.on{background:var(--c);box-shadow:inset 0 0 0 2.5px var(--line),inset 0 -4px 0 rgba(0,0,0,.18)}
.cell.m.on::before{content:"";position:absolute;left:4px;right:4px;bottom:4px;height:calc((100% - 8px) * var(--h,.5));background:rgba(255,255,255,.45);border-radius:3px}
.cell.m.on::after{content:attr(data-d);position:absolute;inset:0;display:grid;place-items:center;font-size:10px;font-weight:900;color:#fff;text-shadow:0 1px 0 rgba(0,0,0,.4)}
.cell.now{filter:brightness(1.12)}
.cell.on.now{transform:scale(1.08)}
.playhead{position:absolute;left:0;right:0;height:calc((100% - 45px)/16);border-radius:8px;box-shadow:0 0 0 2.5px var(--ink);pointer-events:none;opacity:0;will-change:transform;z-index:2}
.grid.live .playhead{opacity:.7}
.cell.chaincur{outline:2px dashed var(--ink2)}
.room-banner{position:absolute;left:10%;right:10%;top:40%;padding:10px 12px;text-align:center;background:var(--card);border:2.5px solid var(--line);border-radius:14px;box-shadow:0 3px 0 var(--shadow);font-weight:800;font-size:13px;z-index:3}

.pads{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:repeat(4,1fr);gap:10px;touch-action:none}
.pad{position:relative;border:3px solid var(--line);border-radius:22px;background:var(--c);box-shadow:0 5px 0 var(--shadow),inset 0 -8px 0 rgba(0,0,0,.14);display:flex;align-items:flex-end;justify-content:flex-end;padding:10px 12px;font-weight:900;font-size:20px;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.25);touch-action:none}
.pad .nv{position:absolute;left:10px;top:10px;width:44px;background:rgba(255,255,255,.35)}
.pad.down{transform:translateY(3px);box-shadow:0 2px 0 var(--shadow),inset 0 -4px 0 rgba(0,0,0,.14);filter:brightness(1.15)}

.transport{display:flex;align-items:center;gap:6px;padding-bottom:2px}
.play{width:54px;height:54px;border-radius:18px;background:var(--red);color:#fff;display:grid;place-items:center;padding:0;flex:none}
.play svg{width:26px;height:26px;fill:#fff}
.play .i-stop{display:none}
.playing .play .i-play{display:none}.playing .play .i-stop{display:block}
.idle-hint .play{animation:hintpulse 1.6s ease-in-out infinite}
@keyframes hintpulse{50%{box-shadow:0 3px 0 var(--shadow),0 0 0 7px rgba(232,69,44,.25)}}
.bpm{height:54px;min-width:56px;padding:0 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;flex:none}
.bpm b{font-size:19px;font-variant-numeric:tabular-nums}
.bpm span{font-size:10px;text-transform:uppercase;color:var(--ink2);letter-spacing:.08em}
.slots{display:flex;gap:5px;flex:1;min-width:0}
.slot{flex:1;height:44px;min-width:0;padding:0;font-size:16px;position:relative}
.slot.cur{background:var(--ink);color:var(--bg)}
.slot.used::after{content:"";position:absolute;top:4px;right:5px;width:6px;height:6px;border-radius:50%;background:var(--red)}
.slot.live{box-shadow:0 3px 0 var(--shadow),0 0 0 3px var(--yellow)}
.chaining .slot{background:var(--yellow);color:#1D1426}
.chainbar{display:flex;align-items:center;gap:8px;font-weight:800;font-size:13px;background:var(--card);border:2.5px dashed var(--line);border-radius:14px;padding:6px 8px 6px 12px}
.chainbar span{flex:1;font-variant-numeric:tabular-nums;letter-spacing:.04em}

/* ---------- sheet ---------- */
.scrim{position:fixed;inset:0;background:rgba(20,10,25,.35);z-index:20}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;max-height:82%;display:flex;flex-direction:column;background:var(--card);border:2.5px solid var(--line);border-bottom:0;border-radius:24px 24px 0 0;box-shadow:0 -4px 0 var(--shadow);animation:up .2s ease-out}
@keyframes up{from{transform:translateY(40%);opacity:.3}}
.grab{width:44px;height:5px;border-radius:3px;background:var(--ink2);opacity:.5;margin:9px auto 2px;flex:none}
.sheet-body{overflow-y:auto;overscroll-behavior:contain;padding:4px 16px calc(16px + env(safe-area-inset-bottom));touch-action:pan-y}
.sheet h3{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin:16px 0 8px}
.sheet h3 b{color:var(--red);font-size:15px}
input[type=range]{width:100%;height:36px;accent-color:var(--red);touch-action:pan-x}
.keys .chip{min-width:44px}
.takes{display:flex;flex-direction:column;gap:8px}
.take{display:flex;align-items:center;gap:8px;padding:8px;border:2px solid var(--line);border-radius:12px}
.take audio{flex:1;min-width:0;height:34px}

/* ---------- me ---------- */
.me-hero{position:relative;padding:16px 12px 14px;text-align:center;margin-top:4px}
.me-stage{display:grid;place-items:center;touch-action:pan-y;padding:6px 0}
.me-ring{padding:8px;border-radius:34px;background:conic-gradient(var(--red),var(--yellow),var(--mint),var(--blue),var(--grape),var(--pink),var(--red))}
.me-ring .nv{border-width:3px}
.nav-arrow{position:absolute;top:38%;width:44px;height:44px;border-radius:50%;border:2.5px solid var(--line);background:var(--card);box-shadow:0 3px 0 var(--shadow);font-size:28px;font-weight:900;line-height:1;padding:0 0 4px}
.nav-arrow.l{left:10px}.nav-arrow.r{right:10px}
.me-id{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px}
.noun-no{font-weight:900;font-size:18px;display:flex;align-items:center;gap:6px}
.noun-no input{width:92px;font-weight:900;font-size:20px;padding:6px 8px;border:2.5px solid var(--line);border-radius:12px;background:var(--bg);text-align:center}
.field{display:flex;flex-direction:column;gap:6px;padding:12px 14px;margin-top:12px}
.field span{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--ink2)}
.field input{border:2.5px solid var(--line);border-radius:12px;padding:10px 12px;font-size:17px;font-weight:800;background:var(--bg)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.stat{background:var(--card);border:2.5px solid var(--line);border-radius:16px;box-shadow:0 3px 0 var(--shadow);padding:10px 12px;display:flex;flex-direction:column;gap:2px}
.stat b{font-size:24px;font-weight:900;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.stat span{font-size:11px;font-weight:700;color:var(--ink2)}
.stat:nth-child(1) b{color:var(--red)}.stat:nth-child(3) b{color:var(--orange)}
.install{padding:14px;margin-top:12px;text-align:center}
.install p{margin:6px 0 10px;color:var(--ink2);font-size:13px}

/* ---------- rooms ---------- */
.lobby-hero{padding:18px 16px;text-align:center;margin-top:4px}
.lobby-hero h2{margin:10px 0 4px;font-size:26px;letter-spacing:-.02em}
.lobby-hero p{margin:0 0 14px;color:var(--ink2);font-size:14px}
.lobby-hero .btn.big{width:100%}
.lobby-nouns{display:flex;justify-content:center;gap:6px}
.lobby-nouns .nv{width:48px}
.lobby-nouns .nv:nth-child(2){transform:translateY(-6px)}
.join{display:flex;gap:8px;margin:12px 0}
.join input{flex:1;min-width:0;text-transform:uppercase;letter-spacing:.35em;text-align:center;font-weight:900;font-size:22px;border:2.5px solid var(--line);border-radius:14px;padding:8px;background:var(--bg)}
.lobby-hero .btn.ghost{width:100%}
.offline-note{color:var(--red)!important;font-weight:800;margin:12px 0 0!important}
.townbig{margin-top:12px;padding:14px;text-align:center;display:flex;flex-direction:column;gap:4px}
.townbig b{font-size:36px;font-weight:900;font-variant-numeric:tabular-nums;letter-spacing:-.03em}
.room{display:flex;flex-direction:column;gap:8px;min-height:100%}
.room-head{display:flex;align-items:center;gap:8px}
.code-chip{font-weight:900;font-size:20px;letter-spacing:.2em;background:var(--yellow);color:#1D1426;border:2.5px solid var(--line);border-radius:12px;padding:4px 10px;box-shadow:0 3px 0 var(--shadow)}
.room-status{flex:1;font-size:12px;font-weight:800;color:var(--ink2);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.room-status.offline{color:var(--red)}
.circle{position:relative;width:min(100%,calc(100dvh - 452px),360px);min-width:200px;aspect-ratio:1;margin:0 auto;flex:none}
.bigdrum{position:absolute;left:24%;top:24%;width:52%;height:52%;border-radius:50%;border:3.5px solid var(--line);background:radial-gradient(circle at 50% 42%,#FFF6E6 0 48%,#F1DDBB 49% 58%,var(--red) 59% 100%);box-shadow:0 7px 0 var(--shadow),inset 0 -8px 0 rgba(0,0,0,.15);display:grid;place-items:center;padding:0;touch-action:none}
.bigdrum .skin{position:absolute;inset:14%;border-radius:50%}
.bigdrum .drum-count{position:relative;font-weight:900;font-size:22px;color:#1D1426;font-variant-numeric:tabular-nums}
.bigdrum.down{transform:translateY(4px) scale(.97);box-shadow:0 3px 0 var(--shadow),inset 0 -4px 0 rgba(0,0,0,.15)}
.seat{position:absolute;width:21%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:2px;transition:left .4s,top .4s}
.seat .nv{width:100%;transform-origin:50% 90%}
.seat .tag{font-size:10px;font-weight:900;background:var(--card);border:2px solid var(--line);border-radius:8px;padding:1px 5px;white-space:nowrap;max-width:120%;overflow:hidden;text-overflow:ellipsis}
.seat.host .tag::before{content:"\2605 ";color:var(--orange)}
.seat.bot .tag{border-style:dashed}
.seat.me .nv{box-shadow:0 0 0 3px var(--yellow)}
.seat.enter{animation:pop .35s}
@keyframes pop{from{transform:translate(-50%,-50%) scale(.3);opacity:0}}
.room-loop{display:flex;align-items:center;gap:10px;justify-content:center;font-size:13px;font-weight:800;color:var(--ink2)}
.minipads{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;flex:1;min-height:112px;max-height:190px;touch-action:none}
.minipads .pad{font-size:14px;border-radius:16px;padding:6px 8px;box-shadow:0 4px 0 var(--shadow),inset 0 -5px 0 rgba(0,0,0,.14)}
.minipads .pad .nv{display:none}
.room-foot{display:flex;justify-content:space-between;font-size:12px;font-weight:800;color:var(--ink2);font-variant-numeric:tabular-nums}

/* ---------- daily ---------- */
.daily-head{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;margin-top:4px;gap:8px}
.daily-head h2{margin:2px 0 0;font-size:20px;letter-spacing:-.02em}
.streak{font-weight:900;font-size:20px;background:var(--orange);color:#fff;border:2.5px solid var(--line);border-radius:999px;padding:4px 12px;box-shadow:0 3px 0 var(--shadow)}
.streak::after{content:" day streak";font-size:11px}
.daily-how{font-size:12px;color:var(--ink2);margin:8px 4px;text-align:center;line-height:1.25}
.daily-band{display:grid;grid-template-columns:16px repeat(4,1fr);column-gap:6px;margin-bottom:6px}
.daily-band::before{content:""}
.daily-band .drummer .nv{max-width:38px}
.grid.mini4{position:relative;grid-template-columns:16px repeat(4,minmax(0,1fr));height:clamp(290px,calc(100dvh - 366px),520px);inset:auto}
.daily-groove{display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:6px}
.beat-dots{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;width:100%}
.beat-dots i{height:12px;border-radius:6px;background:var(--cell);border:2px solid var(--line)}
.beat-dots i.p{background:var(--mint)}.beat-dots i.g{background:var(--yellow)}.beat-dots i.m{background:var(--red)}.beat-dots i.now{transform:scaleY(1.5)}
.bigdrum.groove{position:relative;left:auto;top:auto;width:min(64vw,250px);height:min(64vw,250px)}
.bigdrum.groove .drum-count{font-size:30px}
.result{padding:16px;margin-top:10px}
.res-top{display:flex;align-items:center;gap:14px}
.res-score{display:block;font-size:52px;font-weight:900;letter-spacing:-.04em;line-height:1}
.res-grade{display:inline-block;margin-top:4px;font-weight:900;font-size:16px;background:var(--yellow);color:#1D1426;border:2.5px solid var(--line);border-radius:10px;padding:1px 10px}
.result p{font-weight:700;font-size:14px}

/* ---------- share ---------- */
.share-preview{padding:10px;display:grid;place-items:center;margin-top:4px}
.share-preview canvas{width:min(100%,38vh,330px);height:auto;border-radius:12px;display:block}
.share-link{padding:8px;margin-top:12px}
.share-link input{width:100%;border:0;background:transparent;font-size:12px;font-weight:700;color:var(--ink2);text-overflow:ellipsis}

/* ---------- overlay (incoming share) ---------- */
.overlay{position:fixed;inset:0;z-index:30;background:rgba(20,10,25,.55);display:grid;place-items:center;padding:16px;padding-top:calc(16px + env(safe-area-inset-top))}
.sc{position:relative;width:min(100%,420px);padding:18px 16px 16px;text-align:center;animation:up .25s ease-out}
.sc h2{margin:6px 0 12px;font-size:22px;letter-spacing:-.02em}
.x{position:absolute;right:10px;top:8px;border:0;background:none;font-size:30px;font-weight:900;line-height:1;padding:4px 8px}
.sc-band{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.sc-band .nv{width:100%}
.sc-grid{display:grid;grid-template-columns:repeat(16,1fr);gap:2px;margin:12px 0 8px}
.sc-grid i{aspect-ratio:1;border-radius:2px;background:var(--cell)}
.sc-grid i.on{background:var(--c)}
.sc-meta{font-size:12px;font-weight:800;color:var(--ink2);margin:6px 0 0}

.toast{position:fixed;left:50%;bottom:calc(var(--tabh) + 22px + env(safe-area-inset-bottom));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);font-weight:800;font-size:14px;padding:10px 16px;border-radius:14px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:40;max-width:90vw;text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast button{margin-left:10px;border:0;background:var(--yellow);color:#1D1426;border-radius:8px;padding:3px 8px;font-weight:900;pointer-events:auto}

/* ---------- v2 · the Floor ---------- */
.floor-head{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;margin:4px 2px 10px}
.floor-head h2,.wall-head h2{margin:0;font-size:26px;letter-spacing:-.03em;line-height:1}
.floor-live{font-weight:900;font-size:12px;background:var(--mint);color:#fff;border:2.5px solid var(--line);border-radius:999px;padding:3px 9px;box-shadow:0 2px 0 var(--shadow);white-space:nowrap}
.floor-off{margin:0 4px 10px!important;font-size:13px}
.floor-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.froom{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;min-height:128px;padding:10px 10px 9px;border:2.5px solid var(--line);border-radius:18px;box-shadow:0 4px 0 var(--shadow);color:#fff;overflow:hidden;
  background:radial-gradient(120% 90% at 100% 0%,var(--rb) 0 38%,transparent 62%),linear-gradient(160deg,var(--ra),color-mix(in srgb,var(--ra) 70%,#000))}
.froom:active{transform:translateY(2px);box-shadow:0 2px 0 var(--shadow)}
.froom .nv{width:46px;border-radius:12px;background:rgba(255,255,255,.3);transform-origin:50% 90%}
.froom b{font-size:15px;font-weight:900;line-height:1.05;letter-spacing:-.01em;text-shadow:0 2px 0 rgba(0,0,0,.25)}
.froom .vibe{font-size:11px;font-weight:700;opacity:.9;line-height:1.15}
.froom .meta{margin-top:auto;display:flex;align-items:center;gap:6px;width:100%;font-size:11px;font-weight:900;font-variant-numeric:tabular-nums}
.froom .here{background:rgba(0,0,0,.35);border-radius:999px;padding:2px 7px;white-space:nowrap}
.froom .here.live{background:#fff;color:#1D1426}
.froom .here.live::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--mint);margin-right:4px;vertical-align:1px;animation:pulse 1.2s infinite}
.froom .eq{position:absolute;right:10px;top:12px;display:flex;gap:2px;align-items:flex-end;height:18px}
.froom .eq i{width:4px;background:#fff;border-radius:2px;opacity:.85;animation:eq 1s ease-in-out infinite;height:40%}
.froom .eq i:nth-child(2){animation-delay:-.3s}.froom .eq i:nth-child(3){animation-delay:-.6s}.froom .eq i:nth-child(4){animation-delay:-.15s}
@keyframes eq{50%{height:100%}}
.froom.cur{outline:3px solid var(--yellow);outline-offset:2px}
.lobby-hero h2{font-size:22px}
.room.pub .circle::before{content:"";position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--rb) 45%,transparent) 0 45%,color-mix(in srgb,var(--ra) 35%,transparent) 46% 70%,transparent 71%);opacity:.9}
.code-chip.pub{letter-spacing:0;font-size:16px;padding:5px 9px;max-width:42vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:var(--ra);color:#fff}
.room-host .nv{width:34px;border-radius:10px}
.groove{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:900;color:var(--ink2);height:22px}
.g-lbl{text-transform:uppercase;letter-spacing:.1em}
.g-bar{flex:1;height:14px;border:2.5px solid var(--line);border-radius:999px;background:var(--cell);overflow:hidden;position:relative}
.g-bar i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:999px;background:linear-gradient(90deg,var(--mint),var(--yellow),var(--red));transition:width .25s ease-out}
.g-k{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:46%}
.groove.peak .g-bar{box-shadow:0 0 0 3px var(--yellow),0 0 18px var(--yellow)}
.groove.peak .g-bar i{background:repeating-linear-gradient(90deg,#FFD86B 0 12px,#FFF3C4 12px 24px);animation:shine .6s linear infinite}
.groove.peak .g-k{color:var(--red)}
@keyframes shine{to{background-position:24px 0}}

/* ---------- v2 · the Beat Wall ---------- */
.wall-head{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;margin:4px 2px 10px}
.seg{display:flex;gap:6px}
.wall-list{display:flex;flex-direction:column;gap:10px}
.bcard{background:var(--card);border:2.5px solid var(--line);border-radius:18px;box-shadow:0 4px 0 var(--shadow);padding:10px;display:grid;grid-template-columns:1fr;gap:8px}
.bcard.playing{box-shadow:0 4px 0 var(--shadow),0 0 0 3px var(--yellow)}
.bc-band{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.bc-band .nv{width:100%;border-radius:8px;border-width:2px;transform-origin:50% 90%}
.bc-thumb{width:100%;height:auto;aspect-ratio:320/84;border-radius:8px;display:block;background:var(--cell)}
.bc-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.bc-meta{flex:1 1 190px;min-width:0;display:flex;flex-direction:column}
.bc-meta b{font-size:16px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.01em}
.bc-meta span{font-size:11px;font-weight:800;color:var(--ink2)}
.bc-act{display:flex;gap:6px;margin-left:auto}
.bc-act .btn{padding:7px 10px;font-size:13px;border-radius:11px}
.bc-act .nod[aria-pressed="true"]{background:var(--mint);color:#fff}
.bc-act .play-b{min-width:54px}
.wall-empty{padding:18px;text-align:center;font-weight:800;color:var(--ink2)}
.btn.pub{background:var(--yellow);color:#1D1426}
.pubform{display:flex;flex-direction:column;gap:2px;text-align:left}
.pubform h2{text-align:center}
.pubform .lbl{text-align:center}
.pub-thumb{width:100%;height:auto;border-radius:10px;border:2.5px solid var(--line);background:var(--cell)}
.pubform .field{border:0;box-shadow:none;padding:6px 0 0;margin:0;background:none}
.pub-row{display:flex;align-items:flex-end;gap:12px}
.pub-row .field{flex:1}
.pub-row .field input{text-transform:uppercase;letter-spacing:.3em;font-weight:900;text-align:center}
.pub-noun .nv{width:58px}
.pub-err{min-height:18px;margin:6px 0 0;color:var(--red);font-weight:800;font-size:13px;text-align:center}

/* ---------- v2 · Moments ---------- */
.moments-head{display:flex;align-items:baseline;justify-content:space-between;margin:18px 4px 8px}
.moments-head h3{margin:0;font-size:20px;letter-spacing:-.02em}
.moments{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.mcard{--rx:0deg;--ry:0deg;--mx:50%;--my:50%;position:relative;display:block;width:100%;aspect-ratio:4/5;border-radius:18px;border:3px solid var(--line);box-shadow:0 5px 0 var(--shadow);overflow:hidden;padding:0;color:#1D1426;text-align:left;
  transform:perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));transition:transform .15s ease-out;background:var(--mc-bg);isolation:isolate}
.mcard.common{--mc-bg:linear-gradient(150deg,#F4F6FA,#C9CED9 45%,#EEF1F6 60%,#AEB5C2);--mc-ink:#3C4252;--mc-band:#7D8597}
.mcard.rare{--mc-bg:linear-gradient(150deg,#BFE3FF,#8C5CF0 40%,#2F7CF6 62%,#7FF0D8);--mc-ink:#fff;--mc-band:#1D1426}
.mcard.legendary{--mc-bg:linear-gradient(150deg,#FFF3C4,#E0A100 34%,#FFD86B 52%,#8A5A00 78%,#FFE9A3);--mc-ink:#3A2500;--mc-band:#1D1426}
.mcard::before{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;mix-blend-mode:color-dodge;opacity:.55;
  background:repeating-linear-gradient(115deg,transparent 0 6%,rgba(255,80,180,.45) 9%,rgba(80,200,255,.45) 13%,rgba(255,240,120,.45) 17%,transparent 21%),
  radial-gradient(farthest-corner at var(--mx) var(--my),rgba(255,255,255,.75),transparent 55%);background-size:220% 220%,100% 100%;animation:foil 7s linear infinite}
.mcard.common::before{opacity:.28}
.mcard.legendary::before{opacity:.7}
.mcard::after{content:"";position:absolute;inset:7px;border-radius:12px;border:2px solid rgba(255,255,255,.55);z-index:2;pointer-events:none}
@keyframes foil{to{background-position:220% 220%,0 0}}
.mc-top{position:absolute;left:10px;right:10px;top:9px;display:flex;justify-content:space-between;align-items:center;z-index:2;font-weight:900;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--mc-ink)}
.mc-rar{background:var(--mc-band);color:#fff;border-radius:999px;padding:2px 7px}
.mcard.legendary .mc-rar{background:linear-gradient(90deg,#8A5A00,#E0A100);border:1.5px solid #3A2500}
.mc-nv{position:absolute;left:22%;right:22%;top:14%;aspect-ratio:1;z-index:1}
.mc-nv .nv{width:100%;border-radius:16px;border-width:3px;box-shadow:0 4px 0 rgba(0,0,0,.25)}
.mc-name{position:absolute;left:10px;right:10px;bottom:30px;z-index:2;color:var(--mc-ink)}
.mc-name b{display:block;font-size:17px;font-weight:900;letter-spacing:-.02em;line-height:1;text-shadow:0 1px 0 rgba(255,255,255,.3)}
.mc-name span{display:block;font-size:10px;font-weight:800;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mc-grid{position:absolute;left:10px;right:10px;bottom:9px;height:16px;z-index:2;display:grid;grid-template-columns:repeat(16,1fr);gap:1.5px}
.mc-grid i{border-radius:2px;background:rgba(0,0,0,.18)}
.mc-grid i.on{background:var(--mc-band)}
.mcard.locked{--mc-bg:repeating-linear-gradient(135deg,var(--cell) 0 10px,var(--cell2) 10px 20px);box-shadow:none;border-style:dashed;opacity:.8}
.mcard.locked::before,.mcard.locked::after{display:none}
.mcard.locked .mc-name{color:var(--ink2)}
.mcard.locked .mc-nv .nv{filter:grayscale(1) brightness(.4) contrast(1.4);opacity:.35}
.mcard.big{width:min(78vw,330px);border-radius:24px;box-shadow:0 8px 0 var(--shadow)}
.mcard.big .mc-top{font-size:12px;left:16px;right:16px;top:14px}
.mcard.big .mc-name{left:16px;right:16px;bottom:44px}
.mcard.big .mc-name b{font-size:26px}
.mcard.big .mc-name span{font-size:12px;white-space:normal}
.mcard.big .mc-nv{left:18%;right:18%;top:13%}
.mcard.big .mc-grid{left:16px;right:16px;bottom:14px;height:24px}
.mcard.playing .mc-nv{animation:bob .42s ease-in-out infinite alternate}
@keyframes bob{to{transform:translateY(-4px) rotate(2deg)}}
.moment-ov{background:rgba(20,10,25,.72);align-content:center}
.mo-wrap{display:flex;flex-direction:column;align-items:center;gap:14px;width:min(100%,380px)}
.mo-kicker{font-weight:900;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:#FFD86B;text-shadow:0 2px 0 #000}
.moment-ov.reveal .mo-card{animation:slideup .7s cubic-bezier(.2,1.2,.3,1)}
@keyframes slideup{from{transform:translateY(70vh) rotate(-8deg) scale(.7);opacity:0}}
.mo-actions{width:100%;margin-top:0}
.mpeek{position:fixed;left:50%;top:calc(env(safe-area-inset-top) + 15vh);width:min(48vw,200px);z-index:45;pointer-events:none;display:flex;flex-direction:column;align-items:center;gap:8px;
  transform:translate(-50%,85vh) rotate(-6deg) scale(.8);opacity:0;transition:transform .6s cubic-bezier(.2,1.25,.3,1),opacity .35s}
.mpeek.show{transform:translate(-50%,0) rotate(0) scale(1);opacity:1}
.mpeek .mp-k{font-weight:900;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#FFD86B;background:#1D1426;border:2px solid #FFD86B;border-radius:999px;padding:4px 11px;white-space:nowrap}
.mpeek .mcard{box-shadow:0 14px 30px rgba(0,0,0,.35),0 5px 0 var(--shadow)}
.mpeek.legendary .mcard{box-shadow:0 0 44px 10px rgba(255,200,60,.75),0 5px 0 var(--shadow)}
.mpeek.rare .mcard{box-shadow:0 0 36px 6px rgba(120,140,255,.6),0 5px 0 var(--shadow)}
.me-chip,.tab{position:relative}
.me-chip.dot::after,.tab.dot::after{content:"";position:absolute;top:0;right:2px;width:11px;height:11px;border-radius:50%;background:#FFD86B;border:2px solid var(--line);box-shadow:0 0 0 2px var(--bg2)}
.tab.dot::after{right:calc(50% - 18px)}

@media (min-height:760px){ .band .drummer .nv{max-width:56px} .transport .play{width:60px;height:60px} }
@media (min-width:600px){ .app{max-width:520px;margin:0 auto;border-left:2.5px solid var(--line);border-right:2.5px solid var(--line)} body{background:var(--bg2)} }
@media (prefers-reduced-motion:reduce){ *{animation-duration:.01s!important;transition:none!important} }

</style>
</head>
<body>
<div id="app" class="app" data-tab="make">
  <header class="top">
    <button class="me-chip" id="meChip" type="button" aria-label="Your Noun — open Me">
      <span class="nv sm" data-me-noun></span>
    </button>
    <div class="top-title"><span class="brand">Noun<b>Beats</b></span><span class="sub" id="topSub">make</span></div>
    <div class="top-actions" id="topActions">
      <button class="icon-btn" id="recBtn" type="button" aria-label="Record a take" data-for="make"><span class="rec-dot"></span></button>
      <button class="icon-btn seg" id="padsBtn" type="button" aria-label="Pads mode" aria-pressed="false" data-for="make">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>
      </button>
      <span class="town-pill" id="townPill" data-for="rooms wall me daily share" title="PointCast town drum — every tap on every drum">
        <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="7" rx="8" ry="3"/><path d="M4 7v9c0 1.7 3.6 3 8 3s8-1.3 8-3V7"/></svg><span id="townCount">—</span>
      </span>
    </div>
  </header>

  <main class="views">
    <!-- ===== ME ===== -->
    <section class="view scroll" id="v-me" data-view="me" hidden>
      <div class="me-hero card">
        <button class="nav-arrow l" id="nounPrev" type="button" aria-label="Previous Noun">&#8249;</button>
        <div class="me-stage" id="meStage">
          <div class="me-ring"><span class="nv xl" id="meBig" data-me-noun></span></div>
        </div>
        <button class="nav-arrow r" id="nounNext" type="button" aria-label="Next Noun">&#8250;</button>
        <div class="me-id">
          <label class="noun-no">Noun <input id="nounInput" type="number" inputmode="numeric" min="0" max="1199" aria-label="Noun number"></label>
          <button class="btn sm" id="nounShuffle" type="button">Shuffle</button>
        </div>
        <p class="hint">Swipe to pick your Noun. It drums for you everywhere in the app.</p>
      </div>
      <label class="field card">
        <span>Your name on shared beats</span>
        <input id="nameInput" type="text" maxlength="16" autocomplete="nickname" placeholder="e.g. MHO" enterkeyhint="done">
      </label>
      <div class="stats" id="stats">
        <div class="stat"><b id="stTaps">0</b><span>taps sent to the town drum</span></div>
        <div class="stat"><b id="stBeats">0</b><span>beats made</span></div>
        <div class="stat"><b id="stStreak">0</b><span>day streak · best <i id="stBest">0</i></span></div>
        <div class="stat"><b id="stYour">—</b><span>your drum total on PointCast</span></div>
        <div class="stat"><b id="stRank">—</b><span id="stRankLabel">top-10 drummer rank</span></div>
        <div class="stat"><b id="stLeague">—</b><span id="stLeagueLabel">Noun Beats in the Drum League</span></div>
      </div>
      <div class="moments-head"><h3>Moments</h3><span class="lbl" id="momentCount">0 earned</span></div>
      <div class="moments" id="moments"></div>
      <p class="fine">Moments are earned by playing, never bought. They live on this phone.</p>
      <div class="card install" id="installCard">
        <b id="installTitle">Put Noun Beats on your home screen</b>
        <p id="installText">It opens full-screen and plays offline.</p>
        <button class="btn primary" id="installBtn" type="button" hidden>Install app</button>
      </div>
      <p class="fine">Nouns art is CC0 (public domain), drawn by noun.pics. Your taps land on the one PointCast drum.</p>
    </section>

    <!-- ===== MAKE ===== -->
