---
import BlockLayout from '../layouts/BlockLayout.astro';
import { RAILROAD_ERAS, RAILROAD_TIME } from '../lib/railroad-history';

const defaultEra = RAILROAD_ERAS.find((era) => era.id === RAILROAD_TIME.defaultEra) ?? RAILROAD_ERAS[2];
const clientEras = Object.fromEntries(RAILROAD_ERAS.map((era) => [era.id, era]));
const mapStops: Record<string, string> = {
  '1825': 'translate(70 145)',
  '1869': 'translate(350 162)',
  '1883': 'translate(615 91)',
  '1964': 'translate(930 125)',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: `${RAILROAD_TIME.title}: ${RAILROAD_TIME.subtitle}`,
      description: RAILROAD_TIME.description,
      url: RAILROAD_TIME.canonical,
      image: RAILROAD_TIME.social.image,
      datePublished: RAILROAD_TIME.publishedAt,
      dateModified: RAILROAD_TIME.updatedAt,
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      educationalUse: 'Interactive history',
      about: ['railroad history', 'railway history', 'standard time', 'Chinese railroad workers', 'Shinkansen'],
      citation: RAILROAD_ERAS.map((era) => era.source.url),
    },
    {
      '@type': 'ItemList',
      name: 'Railroad Time stations',
      numberOfItems: RAILROAD_ERAS.length,
      itemListElement: RAILROAD_ERAS.map((era, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${era.year}: ${era.title}`,
        description: era.answer,
        url: `${RAILROAD_TIME.canonical}#era-${era.id}`,
      })),
    },
  ],
};
---

<BlockLayout
  title={`${RAILROAD_TIME.title}: ${RAILROAD_TIME.subtitle}`}
  description={RAILROAD_TIME.description}
  image={RAILROAD_TIME.social.image}
  imageWidth={RAILROAD_TIME.social.imageWidth}
  imageHeight={RAILROAD_TIME.social.imageHeight}
  themeColor="#171711"
  jsonLd={jsonLd}
  alternates={[{
    type: 'application/json',
    href: '/railroads.json',
    title: 'Railroad Time structured edition',
  }]}
  frame={{
    image: RAILROAD_TIME.social.image,
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Ride the line', action: 'link', target: RAILROAD_TIME.canonical },
      { label: 'Open the JSON', action: 'link', target: RAILROAD_TIME.machineEdition },
    ],
  }}
  immersive={true}
  isolated={true}
  showNetworkStrip={false}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/railroads/room.css" />
    <script is:inline src="/railroads/room.js" defer></script>
  </Fragment>

  <div class="railroad-room" data-railroad-room data-era={defaultEra.id}>
    <script
      id="railroad-era-data"
      type="application/json"
      is:inline
      set:html={JSON.stringify(clientEras).replace(/</g, '\\u003c')}
    />

    <header class="mast">
      <a class="mast__mark" href="/" aria-label="PointCast home">POINTCAST</a>
      <p>RAILROAD TIME · A SPEAKABLE HISTORY</p>
      <span>PUBLISHED · 2026</span>
    </header>

    <section class="stage" aria-labelledby="page-title">
      <div class="scene-stack">
        {RAILROAD_ERAS.map((era) => (
          <figure
            class:list={['scene', { 'is-active': era.id === defaultEra.id }]}
            data-scene={era.id}
            aria-hidden={era.id === defaultEra.id ? 'false' : 'true'}
          >
            <img
              src={era.image}
              alt={era.imageAlt}
              width={era.imageWidth}
              height={era.imageHeight}
              fetchpriority={era.id === defaultEra.id ? 'high' : undefined}
            />
          </figure>
        ))}
        <div class="scene-wash" aria-hidden="true"></div>
        <div class="steam steam--one" aria-hidden="true"></div>
        <div class="steam steam--two" aria-hidden="true"></div>
      </div>

      <div class="stage__topline">
        <span data-location>{defaultEra.location}</span>
        <span>PLATE <b data-plate>{defaultEra.plate}</b> / 04</span>
      </div>

      <div class="stage__copy">
        <p class="eyebrow">THE LIVING LINE · CHAPTER ONE</p>
        <h1 id="page-title">The line<br />that made <em>time.</em></h1>
        <p class="dek">Ask a question out loud. The station listens once, moves you to an era, and changes the world around the answer.</p>
      </div>

      <div class="stage__stamp" aria-label="Generated image disclosure">
        <span>ORIGINAL POINTCAST PLATE</span>
        <strong>OPENAI-GENERATED HISTORICAL INTERPRETATION</strong>
        <small>Not a documentary photograph</small>
      </div>

      <div class="route-signal" aria-hidden="true">
        <span class="route-signal__lamp"></span>
        <span class="route-signal__post"></span>
      </div>

      <div class="hero-train" aria-hidden="true">
        <svg viewBox="0 0 420 130" focusable="false">
          <g fill="currentColor">
            <rect x="92" y="50" width="110" height="49" rx="4" />
            <rect x="116" y="23" width="52" height="31" rx="3" />
            <path d="M201 61h54l43 38h-97z" />
            <rect x="285" y="45" width="107" height="54" rx="4" />
            <rect x="62" y="76" width="38" height="23" />
            <path d="M55 71h22l10-27H65z" />
            <rect x="28" y="96" width="380" height="8" rx="4" />
          </g>
          <g fill="#171711" stroke="currentColor" stroke-width="8">
            <circle class="train-wheel" cx="113" cy="105" r="18" /><circle class="train-wheel" cx="190" cy="105" r="18" />
            <circle class="train-wheel" cx="318" cy="105" r="18" /><circle class="train-wheel" cx="372" cy="105" r="18" />
          </g>
          <g fill="#f8f2e4">
            <circle class="train-smoke" cx="68" cy="28" r="13" />
            <circle class="train-smoke train-smoke--two" cx="47" cy="18" r="10" />
            <circle class="train-smoke train-smoke--three" cx="27" cy="10" r="7" />
          </g>
        </svg>
      </div>
    </section>

    <nav class="era-rail" aria-label="Railroad history eras">
      {RAILROAD_ERAS.map((era) => (
        <button
          id={`era-${era.id}`}
          class:list={{ 'is-active': era.id === defaultEra.id }}
          type="button"
          data-stop={era.id}
          aria-current={era.id === defaultEra.id ? 'step' : undefined}
        >
          <span>{String(era.index + 1).padStart(2, '0')}</span><b>{era.year}</b><small>{era.topic.toUpperCase()}</small>
        </button>
      ))}
    </nav>

    <section class="journey-grid">
      <div class="conductor" id="conductor">
        <div class="conductor__heading">
          <div><p class="section-label">ASK THE LINE</p><h2>Where should we go?</h2></div>
          <div class="listening-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        </div>

        <label for="question">Your question</label>
        <textarea id="question" rows="3" maxlength="500" spellcheck="true" placeholder="Try: Why do we have time zones?"></textarea>

        <div class="conductor__actions">
          <button class="button button--signal" type="button" data-speak><span aria-hidden="true">●</span> Tap to speak</button>
          <button class="button" type="button" data-travel>Travel with this question</button>
          <button class="button button--quiet" type="button" data-hear>Hear the answer</button>
          <button class="button button--quiet" type="button" data-stop-voice>Stop voice</button>
        </div>

        <output class="voice-status" data-voice-status aria-live="polite">Microphone is off. You can also type or choose a station.</output>
        <p class="privacy-note">One tap, one utterance. PointCast does not receive or store microphone audio or transcripts. Your browser or device may use its speech service; type instead whenever you prefer.</p>

        <div class="say-this" aria-label="Suggested questions">
          <p>TRY SAYING</p>
          <button type="button" data-example="Where did the public railway begin?">Where did it begin?</button>
          <button type="button" data-example="Who built the transcontinental railroad?">Who built it?</button>
          <button type="button" data-example="Why do we have time zones?">Why time zones?</button>
          <button type="button" data-example="When did trains become truly fast?">When did speed change?</button>
        </div>
      </div>

      <article class="story" aria-labelledby="story-title">
        <header class="story__head">
          <p class="story__year" data-year>{defaultEra.year}</p>
          <div><p class="section-label" data-kicker>{defaultEra.kicker}</p><h2 id="story-title" data-title>{defaultEra.title}</h2></div>
        </header>
        <p class="story__answer" data-answer>{defaultEra.answer}</p>
        <div class="story__ledger">
          <div><span>WHAT MOVED</span><strong data-gain>{defaultEra.gain}</strong></div>
          <div><span>WHAT SHIFTED</span><strong data-cost>{defaultEra.cost}</strong></div>
        </div>
        <blockquote data-question>“{defaultEra.question}”</blockquote>
        <a class="receipt" data-source href={defaultEra.source.url} target="_blank" rel="noopener noreferrer">SOURCE RECEIPT · {defaultEra.source.label.toUpperCase()} ↗</a>
      </article>
    </section>

    <section class="map-section" aria-labelledby="map-title">
      <div class="map-section__intro">
        <p class="section-label">YOUR ROUTE</p>
        <h2 id="map-title">History is not a straight line.</h2>
        <p>Every stop adds a mark to this visit. The facts stay fixed; your route through them changes with the questions you ask.</p>
      </div>
      <div class="line-map" data-line-map>
        <svg viewBox="0 0 1000 250" role="img" aria-labelledby="line-map-title line-map-desc">
          <title id="line-map-title">Your railroad history route</title>
          <desc id="line-map-desc">Four stations from 1825 through 1964. Visited stations illuminate as the journey changes.</desc>
          <path class="map-track map-track--shadow" d="M70 145 C220 60 315 220 470 130 S730 55 930 125" />
          <path class="map-track" d="M70 145 C220 60 315 220 470 130 S730 55 930 125" />
          <path class="map-progress" data-map-progress d="M70 145 C220 60 315 220 470 130 S730 55 930 125" pathLength="100" />
          {RAILROAD_ERAS.map((era) => (
            <g class:list={['map-stop', { 'is-visited': era.id === defaultEra.id, 'is-current': era.id === defaultEra.id }]} data-map-stop={era.id} transform={mapStops[era.id]}>
              <circle r="18" /><text y="42">{era.id}</text>
            </g>
          ))}
          <g class="map-engine" data-map-engine transform={mapStops[defaultEra.id]}>
            <rect x="-22" y="-13" width="31" height="20" rx="2" />
            <rect x="-13" y="-27" width="14" height="15" />
            <path d="M9 -8h11l8 15H9z" />
            <circle cx="-13" cy="11" r="6" /><circle cx="16" cy="11" r="6" />
          </g>
        </svg>
        <div class="route-count"><span><b data-visited-count>1</b> / 4 STATIONS VISITED</span><button type="button" data-reset-route>Begin again</button></div>
      </div>
    </section>

    <aside class="release-note" aria-labelledby="method-title">
      <p class="section-label" id="method-title">HOW THIS LINE WORKS</p>
      <div>
        <p><strong>Fixed history:</strong> four curated answers and four direct receipts. Questions choose a station; they do not generate new historical claims.</p>
        <p><strong>Local interaction:</strong> typed routing, visited stops, the moving train, and optional browser speech. No account and no PointCast network write.</p>
      </div>
    </aside>

    <section class="sources-ledger" id="sources" aria-labelledby="sources-title">
      <div><p class="section-label">SOURCE LEDGER</p><h2 id="sources-title">Four stops. Four receipts.</h2></div>
      <ol>
        {RAILROAD_ERAS.map((era) => (
          <li><span>{era.year}</span><a href={era.source.url} target="_blank" rel="noopener noreferrer">{era.source.label} ↗</a></li>
        ))}
      </ol>
    </section>

    <footer>
      <p>POINTCAST RAILROAD TIME · BUILT WITH OPENAI IMAGE GENERATION · SEPTEMBER 2026</p>
      <nav aria-label="Railroad Time resources"><a href="/railroads.json">JSON EDITION</a><a href="#sources">SOURCE LEDGER</a><a href="/">POINTCAST HOME</a></nav>
    </footer>
  </div>
</BlockLayout>
