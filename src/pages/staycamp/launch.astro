---
import StaycampLayout from '../../layouts/StaycampLayout.astro';

const title = 'Launch kit · Staycamp';
const description = 'Campaign lines, poster concepts, pouch labels, a welcome email sequence and an FAQ for Staycamp, the home camping kit brand concept.';

const posters = [
  { line: 'The best campsite in town has a fridge.', sub: 'The Weekender. A living-room campout, ready in the hall closet.', bg: '#2F4A3A', fg: '#F3ECDF', accent: '#E9B84C' },
  { line: 'Two weeks. One room. Everyone’s favourite.', sub: 'The Den heats one room well instead of the whole house badly.', bg: '#27324B', fg: '#F3ECDF', accent: '#D7643A' },
  { line: 'Headlamps for everyone. Shadow puppets included.', sub: 'The Lantern Shelf. Two free hands, and no candles.', bg: '#E9B84C', fg: '#27324B', accent: '#2F4A3A' },
  { line: 'Small bills. Big comfort.', sub: 'The Biscuit Tin. Because nobody can make change in the dark.', bg: '#F3ECDF', fg: '#2F4A3A', accent: '#D7643A' },
  { line: 'Every flame ships with an alarm.', sub: 'A carbon-monoxide alarm in every Den. Every time.', bg: '#D7643A', fg: '#F3ECDF', accent: '#27324B' },
  { line: 'The best gear on the trip lives next door.', sub: 'Porch Cards in every Fortnight. Say hello on day one.', bg: '#2F4A3A', fg: '#F3ECDF', accent: '#D7643A' },
];

const labels = [
  { name: 'The Canteen', front: 'Water for the long trip.', back: 'A gallon a person a day. Fill these on day one while the taps run. Your hot-water tank holds 30 to 50 gallons more: drain tap, cool, disinfect if in doubt. Dose card inside.' },
  { name: 'The Den', front: 'One warm room.', back: 'Pitch the tent on a rug in the room with the fewest windows. Close the other doors. The CO alarm goes up first, before anything with a flame comes in.' },
  { name: 'The Little House', front: 'The camp loo, done properly.', back: 'Bucket, seat, divider, liners and shavings. A scoop of shavings each time. Swap the liner at half full. The wash station sits right beside it.' },
  { name: 'The Pocket', front: 'Your routine, on paper.', back: 'Prescription copies, a written medication list and a fortnight’s buffer. The question sheet is for your clinician; they know your household, we don’t.' },
  { name: 'Lantern Shelf', front: 'Light, hands free.', back: 'One headlamp each, LED lanterns for the table. We left candles out on purpose: a candle knocked over in a dark house is a real fire.' },
  { name: 'The Biscuit Tin', front: 'For when the till is a tin.', back: 'Keep small bills in here, and keep them small. Card readers, cash machines and banks all share the same network.' },
];

const emails = [
  {
    when: 'Day 0',
    subject: 'Your camp has arrived',
    body: [
      'The box is heavy, we know. Put it in the hall closet, then do one thing this weekend: pitch the Den in the living room and sleep in it.',
      'A campout now means that when you need the kit, everyone already knows where the headlamps live and which way the tent door faces.',
      'While you’re at it, stick the Field Book card inside the lid and put the CO alarm up. It works on ordinary days too.',
    ],
  },
  {
    when: 'Month 1',
    subject: 'Eat the oldest tin',
    body: [
      'A pantry that never gets eaten turns into archaeology. Once a month, cook one supper from the back of the shelf and put a fresh tin at the front.',
      'This month’s suggestion is from the Camp Days deck: red lentil dal. Twenty minutes, one pot.',
    ],
  },
  {
    when: 'Month 6',
    subject: 'Time for the Refill',
    body: [
      'Bleach loses strength as it ages, batteries quietly drain and stove fuel gets borrowed for barbecues. The Refill box replaces all of it.',
      'Check the date on the bleach in your Canteen. If it’s more than six months old, swap it out, and tip the old one into the laundry.',
    ],
  },
];

const faq = [
  { q: 'Is this a survival kit?', a: 'It covers the same ground, but we don’t call it that. A long outage happens in a house you already know, so the kit is built like camping: water, warmth, a loo, light, supper and something to do.' },
  { q: 'Why don’t you sell generators or fuel?', a: 'Because the safest version of that advice is long and specific to each household. Power Notes explains what to know if you already own one, and the one rule that never bends: generators run outdoors, never in a garage.' },
  { q: 'Can I use the camp stove indoors?', a: 'Follow the stove’s own instructions, and only use it where they allow, with ventilation. When in doubt, cook outdoors. A charcoal grill is outdoors only.' },
  { q: 'Is the water in my hot-water tank really drinkable?', a: 'Usually, yes. Draw it from the drain tap, let it cool, and disinfect it if there’s any doubt. The dose card in the Canteen shows how.' },
  { q: 'What about medicine and medical devices?', a: 'The Pocket keeps paper copies, a medication list and a fortnight of buffer. For insulin, powered devices or anything else specific, ask your clinician. We never stand in for one.' },
  { q: 'I live in a flat. Does this still work?', a: 'Yes, and the hot-weather Den matters more: flats can get very hot when cross-ventilation is theoretical. The Little House is also why many flat-dwellers buy the Fortnight.' },
  { q: 'Isn’t two weeks a bit much?', a: 'Most outages are short. Planning for the whole trip is still what makes the short ones easy, and people who expect a fortnight have a calmer week than people who keep waiting for the lights.' },
  { q: 'What do I do with it the rest of the year?', a: 'Use it. Living-room campouts, garden sleepovers, a power cut that lasts an evening. A kit that gets used gets checked.' },
];

const social = [
  'Pitched the tent in the living room. The dog has opinions. #CampIn',
  'Day 1 rule: freezer feast. Whatever thawed gets cooked first and eaten first.',
  'Green card in the window means all well. Amber means please knock. That’s the whole system.',
  'Five gallons of water weighs about forty pounds. Ask the neighbour who lifts things.',
  'Our least dramatic product is a biscuit tin. It might be our most useful.',
];
---
<StaycampLayout title={title} description={description} path="/staycamp/launch">
  <section class="wrap section launch-head">
    <p class="eyebrow">Launch kit</p>
    <h1>Camp in.</h1>
    <p class="intro">The campaign sells the ordinary weekend first and lets the long outage be the second reason. No sirens, no empty streets, no countdowns. Kettles, kids in sleeping bags, and neighbours.</p>
  </section>

  <section class="wrap">
    <div class="heading"><p class="eyebrow">01 · Posters</p><h2>Six lines for the first season.</h2></div>
    <div class="posters">
      {posters.map((p) => (
        <figure class="poster" style={`--bg:${p.bg};--fg:${p.fg};--ac:${p.accent}`}>
          <svg viewBox="0 0 40 32" width="30" height="24" aria-hidden="true"><path d="M20 3 37 29H3Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M20 15 26 29H14Z" fill="var(--ac)"/></svg>
          <blockquote>{p.line}</blockquote>
          <figcaption>{p.sub}<span>staycamp</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="heading"><p class="eyebrow">02 · Pouch labels</p><h2>Front says what it is. Back says what to do.</h2></div>
      <div class="labels">
        {labels.map((l) => (
          <article class="label">
            <div class="label-front"><p class="tag">Staycamp</p><h3>{l.name}</h3><p>{l.front}</p></div>
            <div class="label-back"><p>{l.back}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="heading"><p class="eyebrow">03 · Welcome emails</p><h2>Three emails across the first six months.</h2><p>Every email asks for one small action. None of them mentions a disaster.</p></div>
    <div class="grid three">
      {emails.map((e) => (
        <article class="email">
          <p class="tag">{e.when}</p>
          <h3>{e.subject}</h3>
          {e.body.map((p) => <p>{p}</p>)}
        </article>
      ))}
    </div>
  </section>

  <section class="section dusk">
    <div class="wrap">
      <div class="heading"><p class="eyebrow">04 · FAQ</p><h2>Questions people ask in the shop.</h2></div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid three">
      <article>
        <p class="eyebrow">05 · Social</p>
        <h3>Captions</h3>
        <ul class="captions">{social.map((s) => <li>{s}</li>)}</ul>
      </article>
      <article>
        <p class="eyebrow">06 · In store</p>
        <h3>Shelve it with the tents</h3>
        <p>Staycamp lives in the camping aisle, not the hardware aisle. The display is a pitched Den with a lantern inside and the Fortnight crate open beside it. Staff are briefed to ask “How many people at home?” and never “Are you prepared?”</p>
      </article>
      <article>
        <p class="eyebrow">07 · Partners</p>
        <h3>Who we would like to stand next to</h3>
        <p>Local libraries for Camp Days reading lists, community groups for Porch Card evenings, and pharmacists who can hand out the Pocket question sheet. Never with anyone whose pitch is fear.</p>
      </article>
    </div>
  </section>
</StaycampLayout>

<style>
  .launch-head h1{font-size:clamp(3rem,8vw,6rem);margin-bottom:1rem}
  .launch-head{padding-bottom:1rem}
  .posters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .poster{margin:0;background:var(--bg);color:var(--fg);border-radius:16px;padding:26px;aspect-ratio:4/5;display:flex;flex-direction:column;justify-content:space-between;border:1px solid rgba(47,74,58,.18)}
  .poster blockquote{margin:0;font-family:"Iowan Old Style",Georgia,serif;font-weight:700;font-size:clamp(1.6rem,2.6vw,2.2rem);line-height:1.08}
  .poster figcaption{font-size:.85rem;display:flex;flex-direction:column;gap:.8rem}
  .poster figcaption span{font-family:"Iowan Old Style",Georgia,serif;font-weight:700;font-size:1.2rem;color:var(--ac)}
  .labels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .label{display:grid;grid-template-rows:auto 1fr;border-radius:14px;overflow:hidden;border:1px solid var(--line)}
  .label-front{background:var(--pine);color:var(--canvas);padding:18px}
  .label-front .tag{color:var(--lantern)}
  .label-front p:last-child{margin:0;font-style:italic}
  .label-back{background:#FBF7F0;padding:18px;font-size:.88rem}
  .label-back p{margin:0}
  .email{background:#FBF7F0;border:1px solid var(--line);border-radius:14px;padding:22px}
  .email p:not(.tag){font-size:.92rem}
  .faq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 28px}
  .faq details{border-top:1px solid rgba(243,236,223,.3);padding:14px 0}
  .faq summary{cursor:pointer;font-weight:700;font-size:1.05rem}
  .faq p{margin:.7rem 0 0;font-size:.92rem}
  .captions{padding-left:1.1em;margin:0;font-size:.92rem}.captions li{margin-bottom:.6em}
  @media(max-width:980px){.posters,.labels{grid-template-columns:repeat(2,minmax(0,1fr))}.faq{grid-template-columns:1fr}}
  @media(max-width:600px){.posters,.labels{grid-template-columns:1fr}.poster{aspect-ratio:auto;min-height:300px}}
</style>
