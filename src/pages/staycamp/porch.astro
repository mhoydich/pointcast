---
import StaycampLayout from '../../layouts/StaycampLayout.astro';

const title = 'Porch Card · Staycamp';
const description = 'A printable neighbour card and two window signs from the Staycamp concept: who is on the street, what they can help with, and a calm way to say all is well.';

const canHelp = ['Spare safe water or jugs', 'Tools', 'First-aid training', 'Food for a few extra', 'Watching kids by arrangement', 'Charging (with a safe backup plan)', 'A lift', 'A radio and local updates'];
const mightNeed = ['A daily knock', 'Help carrying water', 'Keeping a medicine cool', 'Power for a medical device', 'A lift somewhere', 'Someone to check on a pet'];
---
<StaycampLayout title={title} description={description} path="/staycamp/porch">
  <section class="wrap section intro-block no-print">
    <p class="eyebrow">Porch Cards · ten in every Fortnight</p>
    <h1>Know the street before you need it.</h1>
    <p class="intro">Neighbours can help with everyday tasks during an outage. A Porch Card makes the first knock easy. Share only details you are comfortable giving to a trusted neighbour; medical and urgent needs still require qualified help.</p>
    <p><button type="button" class="button" id="print">Print the card and signs</button></p>
  </section>

  <section class="wrap sheet" aria-label="Printable Porch Card">
    <article class="porch-card">
      <header>
        <svg viewBox="0 0 40 32" width="28" height="22" aria-hidden="true"><path d="M20 3 37 29H3Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M20 15 26 29H14Z" fill="#D7643A"/></svg>
        <h2>Hello from next door</h2>
      </header>
      <div class="fields">
        <p><span>Name(s)</span><i></i></p>
        <p><span>House / flat</span><i></i></p>
        <p><span>Phone</span><i></i></p>
        <p><span>Best way to reach us if phones are down</span><i></i></p>
      </div>
      <div class="cols">
        <div>
          <h3>We can help with</h3>
          <ul>{canHelp.map((x) => <li><b aria-hidden="true"></b>{x}</li>)}</ul>
        </div>
        <div>
          <h3>We might need</h3>
          <ul>{mightNeed.map((x) => <li><b aria-hidden="true"></b>{x}</li>)}</ul>
        </div>
      </div>
      <p class="small">Share privately with a trusted neighbour. Nothing on this card is an obligation. For an emergency, call 911 or your local emergency number; this card is not an alert service. Medical-device power and medicine storage need a plan with your clinician and supplier.</p>
    </article>

    <div class="signs">
      <article class="sign green">
        <p class="sign-word">All well</p>
        <p>We checked in today. Thanks for looking out for us.</p>
      </article>
      <article class="sign amber">
        <p class="sign-word">Please knock</p>
        <p>We could use a hand today.</p>
        <p class="small">For an emergency, call 911 or your local emergency number. Do not wait for someone to see this sign.</p>
      </article>
    </div>
  </section>

  <section class="wrap section no-print">
    <div class="grid three">
      <article><h3>How the signs work</h3><p>Agree a check-in time with your neighbours. Green reports a recent check-in; it does not guarantee everyone is safe now. Amber asks for a knock. Check directly if you are concerned, even when a green sign is up.</p></article>
      <article><h3>For everyday help</h3><p>Amber is a request between neighbours, not an emergency signal. Call 911 or your local emergency number for urgent help. If communications fail, use your local emergency plan to reach responders; do not wait for a sign to be noticed.</p></article>
      <article><h3>The first afternoon</h3><p>Hand out the cards on the first day, when everyone is still curious and nobody is tired. It is far easier than knocking for the first time on day six.</p></article>
    </div>
  </section>
</StaycampLayout>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .intro-block h1{font-size:clamp(2.4rem,5.6vw,4.2rem);margin-bottom:1rem}
  .intro-block .button{border:0;font:inherit;cursor:pointer}
  .sheet{display:grid;grid-template-columns:1.4fr 1fr;gap:24px;align-items:start;padding-bottom:20px}
  .porch-card{background:#FBF7F0;border:2px solid var(--pine);border-radius:16px;padding:26px}
  .porch-card header{display:flex;align-items:center;gap:10px;margin-bottom:1.2rem}
  .porch-card h2{font-size:1.8rem}
  .fields p{display:flex;gap:10px;align-items:flex-end;margin:0 0 .9rem;font-size:.85rem}
  .fields span{white-space:nowrap}
  .fields i{flex:1;border-bottom:1px solid var(--pine);min-height:1.2em}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:1.2rem}
  .cols h3{font-size:1.05rem}
  .cols ul{list-style:none;padding:0;margin:0;font-size:.85rem}
  .cols li{display:flex;gap:8px;align-items:center;margin-bottom:.45em}
  .cols b{width:13px;height:13px;border:1.5px solid var(--pine);border-radius:3px;flex:none}
  .small{font-size:.75rem;margin:1rem 0 0;opacity:.8}
  .signs{display:grid;gap:24px}
  .sign{border-radius:16px;padding:30px 26px;min-height:200px;display:flex;flex-direction:column;justify-content:center;text-align:center}
  .sign p{margin:0}
  .sign-word{font-family:"Iowan Old Style",Georgia,serif;font-size:clamp(2.2rem,5vw,3.2rem);font-weight:700;line-height:1;margin-bottom:.6rem!important}
  .green{background:#4F7A5A;color:#F3ECDF}
  .amber{background:#E9B84C;color:#27324B}
  @media(max-width:860px){.sheet{grid-template-columns:1fr}}
  @media(max-width:520px){.cols{grid-template-columns:1fr}.fields p{flex-wrap:wrap}.fields span{white-space:normal}}
  @media print{.sheet{grid-template-columns:1fr;gap:0}.sign{break-before:page;min-height:90vh;-webkit-print-color-adjust:exact;print-color-adjust:exact}.porch-card{break-inside:avoid}}
</style>
