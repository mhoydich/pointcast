---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ANTI_PATTERNS, COVERAGE_PROTOCOL, ELIGIBLE_ROLES, FIRST_THREE_INSTANCES, FUNDING_DESIGN, PURPOSE, REFERENCES, RETURN_PROTOCOL, SABBATICAL_META, SABBATICAL_NOTES } from '../lib/sabbatical';
const title = `${SABBATICAL_META.title} — ${SABBATICAL_META.subtitle}`;
const description = SABBATICAL_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'TechArticle', '@id': 'https://pointcast.xyz/sabbatical', name: SABBATICAL_META.title, description, url: 'https://pointcast.xyz/sabbatical', datePublished: SABBATICAL_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/sabbatical.json', title: 'Sabbatical Infrastructure (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/time">time</a><span aria-hidden="true">/</span><span>sabbatical</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{SABBATICAL_META.paperNumber} · {SABBATICAL_META.status}</p>
      <h1>SABBATICAL.</h1>
      <p class="subtitle">{SABBATICAL_META.subtitle}</p>
      <p class="thesis">{SABBATICAL_META.thesis}</p>
    </header>

    <section class="purpose"><p class="kicker">PURPOSE</p><h2>Why sabbatical, why mandatory.</h2>
      <p class="block"><strong>Why:</strong> {PURPOSE.why}</p>
      <p class="block"><strong>Why not PTO:</strong> {PURPOSE.whyNotPto}</p>
      <p class="block"><strong>Why mandatory by default:</strong> {PURPOSE.whyMandatoryByDefault}</p>
    </section>

    <section class="elig"><p class="kicker">ELIGIBLE ROLES · 5 CLASSES</p><h2>Who, when, how long, who pays.</h2>
      <ol class="er-list">{ELIGIBLE_ROLES.map((r) => (
        <li>
          <h3>{r.roleClass}</h3>
          <dl class="er-dl">
            <div><dt>Trigger pattern</dt><dd>{r.triggerPattern}</dd></div>
            <div><dt>Duration default</dt><dd>{r.durationDefault}</dd></div>
            <div><dt>Funding source</dt><dd>{r.fundingSource}</dd></div>
            <div><dt>Coverage during gap</dt><dd>{r.coverageDuringGap}</dd></div>
            <div><dt>Return protocol</dt><dd>{r.returnProtocol}</dd></div>
          </dl>
        </li>
      ))}</ol>
    </section>

    <section class="fund"><p class="kicker">FUNDING DESIGN</p><h2>Sabbatical follows the role, not the participant.</h2>
      <p class="block"><strong>Philosophy:</strong> {FUNDING_DESIGN.philosophy}</p>
      <p class="block"><strong>Endowment rule:</strong> {FUNDING_DESIGN.endowmentRule}</p>
      <p class="block"><strong>Future Works Fund:</strong> {FUNDING_DESIGN.futureWorksFund}</p>
      <p class="block"><strong>NOT from operating revenue:</strong> {FUNDING_DESIGN.noProjectFundsFromOperatingRevenue}</p>
    </section>

    <section class="cov"><p class="kicker">COVERAGE PROTOCOL</p><h2>How the building runs while the principal rests.</h2>
      <dl class="dl">
        <div><dt>Identification</dt><dd>{COVERAGE_PROTOCOL.identification}</dd></div>
        <div><dt>Training obligation</dt><dd>{COVERAGE_PROTOCOL.trainingObligation}</dd></div>
        <div><dt>Decision authority</dt><dd>{COVERAGE_PROTOCOL.decisionAuthority}</dd></div>
        <div><dt>Emergency break-in</dt><dd>{COVERAGE_PROTOCOL.emergencyBreakIn}</dd></div>
        <div><dt>Post-sabbatical debrief</dt><dd>{COVERAGE_PROTOCOL.postSabbaticalDebrief}</dd></div>
      </dl>
    </section>

    <section class="ret"><p class="kicker">RETURN PROTOCOL</p><h2>How the participant comes back.</h2>
      <dl class="dl">
        <div><dt>Reentry pace</dt><dd>{RETURN_PROTOCOL.reentryPace}</dd></div>
        <div><dt>No backlog contract</dt><dd>{RETURN_PROTOCOL.noBacklogContract}</dd></div>
        <div><dt>One new commitment limit</dt><dd>{RETURN_PROTOCOL.oneNewCommitmentLimit}</dd></div>
        <div><dt>Reflection document</dt><dd>{RETURN_PROTOCOL.reflectionDocument}</dd></div>
        <div><dt>Promotion to teacher</dt><dd>{RETURN_PROTOCOL.promotionToTeacher}</dd></div>
      </dl>
    </section>

    <section class="anti"><p class="kicker">ANTI-PATTERNS · 7</p><h2>What sabbatical must not become.</h2>
      <ol class="ap-list">{ANTI_PATTERNS.map((a) => (
        <li>
          <h3>{a.pattern}</h3>
          <p>{a.why}</p>
        </li>
      ))}</ol>
    </section>

    <section class="first"><p class="kicker">FIRST THREE CONCRETE INSTANCES</p><h2>The infrastructure ships in stages.</h2>
      <ol class="fst-list">{FIRST_THREE_INSTANCES.map((f) => (
        <li>
          <h3>{f.role}</h3>
          <p class="fst__when"><strong>When:</strong> {f.when}</p>
          <p>{f.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · ENDOWMENT DESIGNERS · ROLE ARCHITECTS</p>
      <p>{SABBATICAL_NOTES.uesNote}</p>
      <p class="invite-cta">{SABBATICAL_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/time">Time · UES-WP-2026-16</a>
      <a href="/bath-house">Bath House · first instance</a>
      <a href="/concert-hall">Concert Hall · second instance</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/sabbatical.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --sb-ink:#1a1a1a; --sb-paper:#fdf9ee; --sb-mustard:#d4a534; --sb-rust:#b85a3a; --sb-sage:#2d6a3d; --sb-tide:#3d6a8a; --sb-fog:#d8d2c4; --sb-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--sb-paper); color: var(--sb-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--sb-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--sb-sage); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--sb-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--sb-sage); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 110px; line-height: .9; font-weight: 700; letter-spacing: -.03em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--sb-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }

  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--sb-sage); max-width: 72ch; font-family: Georgia, serif; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--sb-sage); margin-right: 6px; }

  .er-list, .ap-list, .fst-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .er-list li { padding: 14px; background: #fff; border: 2px solid var(--sb-ink); border-left: 8px solid var(--sb-sage); }
  .er-list h3 { padding-bottom: 6px; border-bottom: 2px solid var(--sb-sage); margin-bottom: 8px; }
  .er-dl { display: grid; gap: 4px; margin: 0; }
  .er-dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 12px; padding: 8px 10px; background: var(--sb-paper); border-left: 3px solid var(--sb-fog); }
  .er-dl dt { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--sb-sage); padding-top: 2px; }
  .er-dl dd { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }

  .dl { margin: 0 0 12px; display: grid; gap: 6px; }
  .dl > div { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--sb-ink); border-left: 5px solid var(--sb-sage); }
  .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--sb-sage); padding-top: 2px; }
  .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .ap-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sb-ink); border-left: 6px solid var(--sb-rust); }
  .ap-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  .fst-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--sb-ink); border-left: 6px solid var(--sb-mustard); }
  .fst-list p { margin: 0 0 4px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .fst__when { padding: 6px 10px; background: var(--sb-paper); border-left: 3px solid var(--sb-mustard); font-size: 12.5px !important; }
  .fst__when strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--sb-sage); margin-right: 4px; }

  .invitation { background: var(--sb-sage); color: var(--sb-paper); border-top-color: var(--sb-sage); }
  .invitation .kicker { background: var(--sb-mustard); color: var(--sb-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--sb-mustard); color: var(--sb-ink); border-left: 4px solid var(--sb-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--sb-sage); color: var(--sb-paper); text-decoration: none; }
  .links a:hover { background: var(--sb-rust); }

  @media (max-width: 800px) { h1 { font-size: 72px; } .er-dl > div, .dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 50px; } }
</style>
