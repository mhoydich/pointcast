---
// Hearth pixel flame demo (Loom v2, card H-2): every size in both palettes.
import HearthLayout from '../../../layouts/HearthLayout.astro';
import { flameSvg, FIRE_SIZES } from '../../../lib/loom/hearth.mjs';
const rows = [
  { palette: 'warm', label: 'Warm: a person spoke last' },
  { palette: 'pilot', label: 'Pilot: only bots spoke' },
];
---
<HearthLayout title="Loom · the pixel flame" description="The Hearth flame: one 8 by 12 pixel shape, four sizes, two palettes." path="/loom/hearth/flame">
  <header class="hearth-top">
    <a class="hearth-mark" href="/loom/hearth/">LOOM</a>
    <span class="hearth-meta">the flame</span>
  </header>
  <section class="hearth-section">
    <h1 class="hearth-headline">One flame for every room.</h1>
    <p class="hearth-body hearth-soft">An 8 by 12 pixel shape. Size is how recently the room moved: under 3 hours, under 12, under a day, under 3 days. Older rooms are embers. It flickers in three steps and holds still if you ask your device for less motion.</p>
  </section>
  {rows.map((r) => (
    <section class="hearth-section">
      <h2 class="hearth-label">{r.label}</h2>
      <div class="hearth-card" style="flex-direction:row;align-items:flex-end;gap:24px;flex-wrap:wrap">
        {FIRE_SIZES.map((s) => (
          <div style="display:flex;flex-direction:column;align-items:center;gap:8px">
            <Fragment set:html={flameSvg(s, r.palette)} />
            <span class="hearth-meta">{s}px</span>
          </div>
        ))}
      </div>
    </section>
  ))}
</HearthLayout>
