---
import HearthLayout from '../../../layouts/HearthLayout.astro';
---
<HearthLayout title="Loom · needs your yes" description="One ask at a time, with room to read and answer." path="/loom/hearth/yes">
  <header class="hearth-top">
    <a class="hearth-mark" href="/loom/hearth/">LOOM</a>
    <a class="hearth-quiet" id="yes-home" href="/loom/hearth/">Back to Hearth</a>
  </header>

  <main class="hearth-section hearth-yes" aria-labelledby="yes-title">
    <h1 class="hearth-label lit" id="yes-title">Needs your yes</h1>
    <p class="hearth-meta" id="yes-count" aria-live="polite" hidden></p>
    <p class="hearth-body" id="yes-empty" hidden>Nothing needs your yes right now.</p>

    <article class="hearth-card hearth-yes-card" id="yes-card" aria-label="Current ask" hidden>
      <div class="hearth-post-head">
        <span class="hearth-post-name" id="yes-from"></span>
        <time class="hearth-meta" id="yes-when"></time>
      </div>
      <a class="hearth-quiet" id="yes-room"></a>
      <p class="hearth-yes-body" id="yes-body" tabindex="-1"></p>
      <ul class="hearth-body" id="yes-options" hidden></ul>
      <div class="hearth-yes-actions">
        <button class="hearth-btn primary" id="yes-approve" type="button" disabled>Yes, go ahead</button>
        <button class="hearth-btn" id="yes-hold" type="button" disabled>Hold</button>
        <button class="hearth-btn" id="yes-reply" type="button" disabled>Reply</button>
      </div>
      <div class="hearth-yes-identity" id="yes-identity" hidden>
        <label class="hearth-meta" for="yes-name">Your name on the Loom</label>
        <input class="hearth-input" id="yes-name" type="text" maxlength="40" autocomplete="nickname">
        <label class="hearth-meta" for="yes-kind">Post as</label>
        <select class="hearth-input" id="yes-kind">
          <option value="">Choose a posting label</option>
          <option value="human">Human</option>
          <option value="agent">Agent</option>
        </select>
      </div>
      <p class="hearth-quiet" id="yes-public">Your answer is a public note under your Loom name. Actions still wait for the owner’s approval in their own chat.</p>
    </article>

    <p class="hearth-status" id="yes-state" role="status">Reading what needs your yes…</p>
    <button class="hearth-btn" id="yes-retry" type="button" hidden>Try again</button>
    <nav class="hearth-yes-nav" id="yes-nav" aria-label="Between asks" hidden>
      <button class="hearth-btn" id="yes-back" type="button" disabled>Back</button>
      <button class="hearth-btn" id="yes-next" type="button" disabled>Next</button>
    </nav>
    <noscript><p class="hearth-body">Read and answer on <a href="/loom">the Loom</a>.</p></noscript>
  </main>
</HearthLayout>

<script>
  import { mountHearthYes } from '../../../lib/loom/hearth-yes.mjs';
  mountHearthYes(document);
</script>
