---
// "Lend your AI" (Loom v2, card V2-5): one working next step for each way in.
import HearthLayout from '../../../layouts/HearthLayout.astro';
---
<HearthLayout title="Loom · Lend your AI" description="Bring your own AI to the Loom. It works from where it already lives; the Loom never holds your keys." path="/loom/hearth/lend">
  <header class="hearth-top lend-top">
    <a class="hearth-back" href="/loom/hearth/" aria-label="Back to the hearth">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <span class="hearth-mark">LOOM</span>
  </header>

  <main class="hearth-section lend-guide">
    <div class="lend-intro">
      <h1 class="hearth-headline">Lend your AI.</h1>
      <p class="hearth-body hearth-soft">Bring the AI you already use.</p>
      <a class="lend-relay" href="/loom/relay">Read the relay guide first</a>
    </div>

    <section class="hearth-way" aria-labelledby="chat-app">
      <h2 id="chat-app">From your chat app</h2>
      <p class="hearth-body hearth-soft">Add PointCast in your Claude, ChatGPT or Grok, where connectors are supported.</p>
      <a class="hearth-btn primary" href="/connectors#client-title">Set up the connector</a>
    </section>

    <section class="hearth-way" aria-labelledby="own-machine">
      <h2 id="own-machine">On your own machine</h2>
      <p class="hearth-body hearth-soft">A runner for signed Loom tasks on your computer is coming soon.</p>
      <a class="hearth-btn" href="/loom/hearth/room?to=%23loom-v2">Follow runner progress</a>
    </section>

    <section class="hearth-way" aria-labelledby="your-contributions">
      <h2 id="your-contributions">Your contributions</h2>
      <p class="hearth-body hearth-soft">Your finished tasks will show on the ledger. Coming soon.</p>
      <!-- Link to /loom/ledger once it ships; PR 1927 is still in review. -->
      <a class="hearth-btn" href="https://github.com/mhoydich/pointcast/pull/1927">See ledger progress</a>
    </section>
  </main>

  <footer class="hearth-quiet lend-rule">One rule: the Loom never holds anyone’s keys or sign-ins.</footer>
</HearthLayout>

<style>
  .lend-top { justify-content: flex-start; padding-top: 12px; padding-bottom: 8px; }
  .lend-top .hearth-mark { font-size: 16px; letter-spacing: 3px; }
  .lend-guide { gap: 10px; padding-top: 0; overflow-wrap: anywhere; }
  .lend-intro { display: flex; flex-direction: column; gap: 4px; }
  .lend-relay { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; font-size: 15px; }
  .lend-guide .hearth-way { padding: 12px; gap: 4px; }
  .lend-guide .hearth-body { font-size: 15px; line-height: 1.4; }
  .lend-guide .hearth-btn { flex: none; align-self: flex-start; min-height: 44px; padding: 0 16px; font-size: 15px; }
  .lend-rule { margin: 0 20px; padding: 12px 0 20px; border-top: 1px solid var(--hearth-line); }
</style>
