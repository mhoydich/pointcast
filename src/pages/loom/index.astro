async function backfill() {
  if (loomApi.mode !== 'live') return;
  const cutoff = Date.now() - 14 * 86400000;
  const rows = state.dir.filter((r) => Date.parse(r.updatedAt) >= cutoff && !state.threads[r.address])
    .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt)).slice(0, 30);
  let i = 0;
  const worker = async () => {
    while (i < rows.length) {
      const r = rows[i++];
      try {
        const t = await loomApi.thread(r.address);
        if (!t || state.threads[r.address] || loomApi.mode !== 'live') continue;
        t.bg = true; state.threads[r.address] = t;
        if (!t.partial) r.openQuestions = openCount(t);
        const pv = previewMsg(t); if (pv && !t.partial) r.last = { name: pv.from.name, kind: pv.from.kind, body: pv.body };
        renderFilters(); renderDirectory(); renderForYou();
      } catch (e) { /* skip this one */ }
    }
  };
  await Promise.all([1, 2, 3, 4, 5, 6].map(worker));
}
function refreshInBg(addr) {
  if (loomApi.mode !== 'live') return;
  const gen = state.sendGen;
  loomApi.thread(addr).then((fresh) => {
    const cur = state.threads[addr];
    if (!fresh || !cur || state.sending || state.sendGen !== gen || cur.messages.some((m) => m._pending)) return;
    state.threads[addr] = fresh; syncRow(fresh, 0);
    if (state.addr === addr) renderThread('keep');
  }).catch(() => { /* keep what we have */ });
}

/* keep the directory row for a thread in step with local changes */
/* live: a row previews what was written in the thread, not what was echoed into it */
function previewMsg(t) {
  const shown = t.messages.filter((m) => !m.withdrawn);
  const last = shown[shown.length - 1];
  if (last && last.via && loomApi.mode === 'live') {
    for (let i = shown.length - 1; i >= 0; i--) if (!shown[i].via) return shown[i];
  }
  return last;
}
function syncRow(t, delta) {
  let row = state.dir.find((r) => r.address === t.addr);
  const shown = t.messages.filter((m) => !m.withdrawn);
  const last = shown[shown.length - 1];
  if (!row) {
    if (!last) return;
    row = { address: t.addr, kind: kindOf(t.addr), label: t.label || shortLabel(t.addr), count: 0, openQuestions: 0 };
    state.dir.push(row);
    delta = shown.length;
  }
  row.count = Math.max(0, (row.count || 0) + delta);
  if (last) { const pv = previewMsg(t) || last; row.last = { name: pv.from.name, kind: pv.from.kind, body: pv.body }; row.updatedAt = last.at; }
  else row.last = null;
  if (!t.partial) row.openQuestions = openCount(t);
  renderFilters(); renderDirectory(); renderForYou();
}

async function openThread(addr, opts) {
  addr = normalizeAddress(addr);
  if (!addr) { toast('That isn’t an address the Loom understands.'); return; }
  opts = opts || {};
  if (kindOf(addr) === 'reply') {
    const id = addr.slice(addr.lastIndexOf('#') + 1);
    let home = null;
    try { home = await loomApi.locate(addr); } catch (e) { /* below */ }
    home = home ? normalizeAddress(home) : '';
    if (home && kindOf(home) !== 'reply') return openThread(home, Object.assign({}, opts, { reveal: id }));
    toast('Couldn’t find that message.');
    return;
  }
  const fresh = opts.fresh;
  state.addr = addr; store.set('addr', addr);
  try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(addr) + location.hash); } catch (e) { /* ignore */ }
  state.replyTo = null; state.markAnswer = true; state.loadError = false;
  stopPlay(); state.playN = null;
  state.notice = opts.notice ? { addr, text: opts.notice } : null;
  if (opts.reveal) state.expanded[opts.reveal] = true;
  setStatus('');
  setView('thread');
  renderDirectory();
  if (fresh) delete state.threads[addr];
  state.loading = false;
  const cached = state.threads[addr];
  if (cached && cached.bg) { cached.bg = false; refreshInBg(addr); }
  if (!state.threads[addr]) {
    state.loading = true; renderThread('bottom');
    let t = null, failed = false;
    try { t = await loomApi.thread(addr); } catch (e) { failed = e && e.status === 400 ? 'address' : true; }
    if (t) state.threads[addr] = t;
    if (state.addr !== addr) return;
    state.loading = false; state.loadError = failed;
    /* the server keeps one spelling per log: follow it */
    if (t && t.addr !== addr) {
      state.threads[t.addr] = t; delete state.threads[addr];
      addr = t.addr; state.addr = addr; store.set('addr', addr);
      try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(addr) + location.hash); } catch (e) { /* ignore */ }
    }
  }
  renderThread('bottom');
  if (opts.starter) { const st = startersFor(addr)[0]; if (st && !$('bodyInput').value) fillStarter(st, true); }
  /* Phone: the view changed, so move focus into it. Desktop: leave focus on the
     row that was clicked so arrowing/tabbing through the list keeps working. */
  if (opts.compose) { try { $('bodyInput').focus({ preventScroll: true }); } catch (e) { /* ignore */ } }
  else if (!isWide() || opts.focus) { try { $('threadTitle').focus({ preventScroll: true }); } catch (e) { /* ignore */ } }
  if (opts.reveal && document.getElementById('msg-' + opts.reveal)) {
    stickBottom = false;
    try { document.getElementById('msg-' + opts.reveal).scrollIntoView({ block: 'center' }); } catch (e) { /* ignore */ }
    flash(opts.reveal);
  }
}

async function send() {
  if (state.sending || state.checking) return;
  const ta = $('bodyInput');
  const text = ta.value.trim();
  if (!text) { ta.focus(); return; }
  if (text.length > MAX_BODY) { setStatus(tooLong(text.length), true); return; }
  const isPoll = state.kind === 'poll';
  const pollOptions = state.pollOpts.map((o) => o.trim()).filter(Boolean);
  if (isPoll && pollOptions.length < 2) { setStatus('A poll needs at least two options. Open the kind button to add them.', true); return; }
  if (!state.name) { openIdentitySheet({ thenSend: true }); return; }
  const t = thread();
  if (!t || state.loading) return;
  const reply = state.replyTo, kindLabel = state.kind, adv = Object.assign({}, state.adv), pollBackup = state.pollOpts.slice();
  const ek = effKind();
  const firstHere = !t.messages.some((x) => hasOwn(state.sent, x.id));
  const request = buildRequest();
  const local = {
    id: 'local_' + Date.now().toString(36), seq: (t.seq || 0) + 1, at: new Date().toISOString(),
    from: { name: state.name, kind: state.akind, verified: false }, kind: KIND_MAP[ek], body: text,
    via: null, plus: 0, depth: reply ? 1 : 0, replies: 0, parent: reply ? reply.id : null, _pending: true,
    poll: isPoll ? { question: text, options: pollOptions, votes: pollOptions.map(() => 0) } : null
  };
  /* chat order: a reply sits after its parent's existing replies, not at the very end */
  const parentIdx = reply ? t.messages.findIndex((x) => x.id === reply.id) : -1;
  const parentMsg = parentIdx >= 0 ? t.messages[parentIdx] : null;
  if (parentMsg) {
    let i = parentIdx + 1;
    while (i < t.messages.length && t.messages[i].depth >= 1) i++;
    t.messages.splice(i, 0, local);
    parentMsg.replies++;
  } else t.messages.push(local);
  state.sent[local.id] = 'preview'; state.expanded[local.id] = true;
  ta.value = ''; autosize(); state.replyTo = null; state.markAnswer = true; state.kind = 'note'; state.adv = { cites: '', confidence: '', title: '' }; state.pollOpts = ['', ''];
  state.sending = true; state.sendGen++;
  setStatus('');
  renderThread(parentMsg ? 'keep' : 'bottom'); syncRow(t, 1); reveal(local.id, true);
  const label = t.label || shortLabel(t.addr);
  try {
    const res = await loomApi.post(request);
    const invite = (kindOf(t.addr) === 'handle' && t.addr.toLowerCase() !== myHandle() && firstHere)
      ? { label: 'Copy an invite', run: () => copyText(inviteText(t.addr), 'Invite copied') } : null;
    const oldId = local.id;
    if (res.message) Object.assign(local, res.message);
    else if (res.id) local.id = res.id;
    /* the append reply is the raw op (no depth): keep a reply under its parent */
    if (reply) { local.parent = local.parent || reply.id; local.depth = Math.max(1, local.depth || 0); }
    if (local.seq > (t.seq || 0)) t.seq = local.seq;
    delete state.sent[oldId]; state.expanded[local.id] = true;
    if (res.editToken && local.id !== oldId) state.sent[local.id] = res.editToken;
    persistSent();
    setStatus('Posted to ' + label, false, invite);
    delete local._pending;
    state.sentOnce = true; store.set('sent1', '1');
  } catch (e) {
    t.messages = t.messages.filter((x) => x !== local);
    if (parentMsg) parentMsg.replies--;
    delete state.sent[local.id];
    ta.value = text; autosize(); state.replyTo = reply; state.kind = kindLabel; state.adv = adv; state.pollOpts = pollBackup;
    setStatus(sendErrText(e), true);
    syncRow(t, -1);
    /* A timed-out POST may still have landed. Never resend it automatically:
       look once, and if it is there, clear the box so it is not sent twice. */
    if (e && e.name === 'AbortError') checkLanded(t.addr, text, label);
  }
  state.sending = false;
  renderThread(parentMsg ? 'keep' : 'bottom');
  if (t.messages.indexOf(local) >= 0) reveal(local.id);
  else stickBottom = true;
}

async function votePoll(m, idx) {
  if (!m.poll || m._pending || hasOwn(state.voted, m.id) || !(idx >= 0 && idx < m.poll.options.length)) return;
  const t = thread();
  state.voted[m.id] = idx; m.poll.votes[idx] = (m.poll.votes[idx] || 0) + 1;
  renderThread('keep');
  try {
    await loomApi.vote(msgAddress(t, m.id), idx);
    persistVoted();
  } catch (e) {
    delete state.voted[m.id]; m.poll.votes[idx]--;
    renderThread('keep'); toast('Couldn’t record your vote. Try again in a moment.');
  }
}

async function plusOne(m) {
  if (state.plused[m.id] || m._pending) return;
  const t = thread();
  state.plused[m.id] = true; m.plus++; renderThread('keep');
  try { await loomApi.plus(msgAddress(t, m.id)); }
  catch (e) { delete state.plused[m.id]; m.plus--; renderThread('keep'); toast('Couldn’t add your +1. Try again in a moment.'); }
}

