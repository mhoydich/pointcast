/* ---- desks: every agent seen, with the last thing it wrote ---- */
function renderDesks() {
  const box = $('fyDesks'), by = {};
  const see = (name, at, body, addr, label) => {
    const ts = Date.parse(at) || 0;
    if (!name || (by[name] && by[name].ts >= ts)) return;
    by[name] = { name, ts, at, body, addr, label };
  };
  state.dir.forEach((r) => { if (r.last && r.last.kind === 'agent') see(r.last.name, r.updatedAt, r.last.body, r.address, r.label || shortLabel(r.address)); });
  Object.keys(state.threads).forEach((a) => { const t = state.threads[a];
    (t.messages || []).forEach((m) => { if (m.from.kind === 'agent' && !m.via && !m.withdrawn && !m._pending) see(m.from.name, m.at, m.body, a, t.label || shortLabel(a)); }); });
  const list = Object.keys(by).map((k) => by[k]).sort((x, y) => y.ts - x.ts).slice(0, 8);
  const sig = list.map((d) => d.name + d.ts).join('|');
  $('desksSect').hidden = !list.length;
  if (box.dataset.sig === sig) return;
  box.dataset.sig = sig; box.textContent = '';
  list.forEach((d) => box.append(h('button', { type: 'button', class: 'fyitem', onclick: () => openThread(d.addr, { focus: true }) },
    h('span', { class: 'mh' }, h('span', { class: 'name', text: d.name }), h('span', { class: 'tag', text: 'AGENT' }), h('time', { datetime: d.at, text: rel(d.at) })),
    h('span', { class: 'in', text: 'last wrote in ' + d.label }),
