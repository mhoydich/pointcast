/* live polling: new ops since our seq, every 15s, only while the page is visible */
async function poll() {
  if (loomApi.mode === 'offline' && !document.hidden) { connect(); return; }
  if (loomApi.mode !== 'live' || document.hidden || state.sending) return;
  const addr = state.addr, gen = state.sendGen;
  const t = thread(); if (!t || state.loadError || state.loading) return;
  try {
    const fresh = await loomApi.since(t);
    if (loomApi.reconnecting) { loomApi.reconnecting = false; renderChip(); }
    /* ops can be edits, withdrawals and +1s as well as new messages: take the
       whole folded thread rather than patching, and keep anything still pending on top */
    if (!fresh || state.addr !== addr || state.sending || state.sendGen !== gen) return;
    const pending = t.messages.filter((m) => m._pending);
    const box = $('msgs');
    const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;
    fresh.messages.push.apply(fresh.messages, pending);
    state.threads[addr] = fresh;
    syncRow(fresh, 0);
    renderThread(nearBottom ? 'bottom' : 'keep');
  } catch (e) {
    if (!loomApi.reconnecting) { loomApi.reconnecting = true; renderChip(); }
  }
}
setInterval(poll, 15000);
document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
setInterval(() => { if (!sheetEl) { renderDirectory(); renderForYou(); } }, 60000);

/* ==========================================================================
   5. BOOT: paint the empty shell, then read the live Loom
   ========================================================================== */
let connecting = false;
async function connect() {
  if (connecting) return;
  connecting = true;
  if (loomApi.mode !== 'live') { loomApi.mode = 'connecting'; renderChip(); renderDirectory(); }
  try {
    loomApi.ready = loomApi.probe();
    const rows = await loomApi.ready;
    renderChip();
    if (!rows) {
      renderDirectory();
      if (!state.threads[state.addr]) { state.loading = false; state.loadError = true; renderThread('keep'); }
      return;
    }
    state.dir = rows;
    renderFilters(); renderDirectory(); renderForYou();
    const addr = state.addr;
    if (!state.threads[addr]) {
      state.loading = true; state.loadError = false; renderThread('keep');
      let t = null;
      try { t = await loomApi.thread(addr); } catch (e) { /* shown below */ }
      if (state.addr === addr) {
        state.loading = false;
        if (t) { state.threads[addr] = t; state.loadError = false; syncRow(t, 0); } else state.loadError = true;
        renderThread('bottom');
        const want = pendingReveal; pendingReveal = null;
        if (want && document.getElementById('msg-' + want)) {
          stickBottom = false;
          try { document.getElementById('msg-' + want).scrollIntoView({ block: 'center' }); } catch (e) { /* ignore */ }
          flash(want);
        }
      }
    }
    backfill();
  } finally { connecting = false; }
}
let pendingReveal = null;

(async function boot() {
  const backIcon = glyph('back', 'glyph'); $('backBtn').append(backIcon);
  $('menuBtn').append(glyph('dots', 'glyph'));
  $('newGlyph').append(glyph('plus', 'glyph'));
  buildTabs();
  state.sentOnce = !!store.get('sent1');
  const hash = location.hash;
  /* RSS items link to /loom?to=<address>#<message id> */
  if (/^#m_[A-Za-z0-9]+$/.test(hash)) pendingReveal = hash.slice(1);
  let view = hash === '#thread' || pendingReveal ? 'thread' : hash === '#directory' ? 'directory' : 'for-you';
  /* a shared link: /loom?to=<address> opens that thread */
  let shared = '';
  try { shared = new URLSearchParams(location.search).get('to') || ''; } catch (e) { /* ignore */ }
  const want = shared ? normalizeAddress(shared) : '';
  if (want && kindOf(want) !== 'reply') { state.addr = want; view = 'thread'; }
  state.tab = view === 'directory' ? 'directory' : 'for-you';
  $('app').dataset.view = view; $('app').dataset.tab = state.tab;
  if (location.hash !== '#' + view) { try { history.replaceState(null, '', location.pathname + location.search + '#' + view); } catch (e) { /* ignore */ } }
  renderChip(); renderFilters(); renderDirectory(); renderThread('bottom'); renderForYou();

  /* a link to one message (loom:<key>#<id>): find its thread, then open it there */
  if (want && kindOf(want) === 'reply') {
    const id = want.slice(want.lastIndexOf('#') + 1);
    try {
      const home = await loomApi.locate(want);
      if (home) { state.addr = home; pendingReveal = /^m_[A-Za-z0-9]+$/.test(id) ? id : null; setView('thread'); try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(home) + '#thread'); } catch (e) { /* ignore */ } }
    } catch (e) { /* fall back to the saved thread */ }
  }
  connect();
})();
</script>
</body>
