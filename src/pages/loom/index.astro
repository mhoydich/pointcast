async function quickAnswer(it, text) {
  const { t, m } = it;
  if (!state.name) { openIdentitySheet({ then: () => quickAnswer(it, text) }); return; }
  const local = {
    id: 'local_' + Date.now().toString(36), seq: (t.seq || 0) + 1, at: new Date().toISOString(),
    from: { name: state.name, kind: state.akind, verified: false }, kind: 'answer', body: text,
    via: null, plus: 0, depth: 1, replies: 0, parent: m.id, _pending: true
  };
  const pi = t.messages.indexOf(m);
  let i = pi + 1;
  while (i < t.messages.length && t.messages[i].depth >= 1) i++;
  t.messages.splice(i, 0, local); m.replies++;
  state.sent[local.id] = 'preview'; state.sendGen++;
  syncRow(t, 1);
  $('fyStatus').textContent = 'Sending your answer…';
  try {
    const res = await loomApi.post({ to: msgAddress(t, m.id), from: { name: state.name, kind: state.akind }, kind: 'answer', body: text });
    const oldId = local.id;
    if (res.message) Object.assign(local, res.message); else if (res.id) local.id = res.id;
    local.parent = local.parent || m.id; local.depth = Math.max(1, local.depth || 0);
    delete state.sent[oldId];
    if (res.editToken && local.id !== oldId) state.sent[local.id] = res.editToken;
    persistSent();
    delete local._pending;
    state.sentOnce = true; store.set('sent1', '1');
    $('fyStatus').textContent = 'Answered: ' + text;
  } catch (e) {
    if (e && e.name === 'AbortError') {
      /* it may have landed: keep the question out of the list until the thread says otherwise */
      delete local._pending;
      $('fyStatus').textContent = 'The server did not answer in time, so your answer may have posted. Checking the thread.';
      const gen = state.sendGen;
      setTimeout(() => loomApi.thread(t.addr).then((fresh) => {
        if (!fresh || state.sendGen !== gen) return;
        state.threads[t.addr] = fresh; syncRow(fresh, 0);
        if (state.addr === t.addr) renderThread('keep');
        const fm = fresh.messages.find((x) => x.id === m.id);
        $('fyStatus').textContent = fm && questionStatus(fresh, fm) === 'open' ? 'Your answer did not post. Try again.' : 'Your answer posted.';
        renderForYou();
      }).catch(() => { $('fyStatus').textContent = 'Could not check whether your answer posted. Open the thread to look.'; }), 2000);
    } else {
      t.messages = t.messages.filter((x) => x !== local); m.replies--; delete state.sent[local.id];
      syncRow(t, -1);
      $('fyStatus').textContent = 'Your answer was not sent. ' + errText(e);
    }
  }
  if (state.addr === t.addr) renderThread('keep');
  renderForYou();
}
