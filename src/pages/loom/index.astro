  margin: 8px 0 0; padding: 10px 12px; background: var(--paper); border: 1px solid var(--rule); max-height: 50%;
  overflow: auto; font: 400 12px/1.5 var(--f-mono); white-space: pre-wrap; overflow-wrap: anywhere;
}
