      } else {
        const lat = Number(vals.lat.trim()), lon = Number(vals.lon.trim());
        if (!vals.lat.trim() || !vals.lon.trim() || !isFinite(lat) || !isFinite(lon) || Math.abs(lat) > 90 || Math.abs(lon) > 180)
          return fail('Use decimals: latitude from -90 to 90 and longitude from -180 to 180, like 34.005 and -118.42.', !vals.lat.trim() || !isFinite(lat) || Math.abs(lat) > 90 ? 'new-lat' : 'new-lon');
        const fx = (n) => n.toFixed(3).replace(/^-(0\.0+)$/, '$1');
        addr = 'geo:' + fx(lat) + ',' + fx(lon);
      }
      const low = addr.toLowerCase();
      const exists = state.dir.some((r) => String(r.address).toLowerCase() === low) || !!(state.threads[addr] && state.threads[addr].messages.length);
      closeSheet(true);
      openThread(addr, { compose: true, notice: exists ? 'This thread already exists. You are joining it.' : null });
    };
    const keyGo = (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } };
