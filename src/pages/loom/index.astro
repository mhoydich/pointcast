async function backfill() {
  if (loomApi.mode !== 'live') return;
  const cutoff = Date.now() - 14 * 86400000;
  const rows = state.dir.filter((r) => Date.parse(r.updatedAt) >= cutoff && !state.threads[r.address])
    .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt)).slice(0, 30);
  let i = 0;
  const worker = async () => {
    while (i < rows.length) {
      const r = rows[i++];
      try {
        const t = await loomApi.thread(r.address);
        if (!t || state.threads[r.address] || loomApi.mode !== 'live') continue;
        t.bg = true; state.threads[r.address] = t;
        if (!t.partial) r.openQuestions = openCount(t);
        const pv = previewMsg(t); if (pv && !t.partial) r.last = { name: pv.from.name, kind: pv.from.kind, body: pv.body };
        renderFilters(); renderDirectory(); renderForYou();
      } catch (e) { /* skip this one */ }
    }
  };
  await Promise.all([1, 2, 3, 4, 5, 6].map(worker));
}
function refreshInBg(addr) {
  if (loomApi.mode !== 'live') return;
  const gen = state.sendGen;
  loomApi.thread(addr).then((fresh) => {
    const cur = state.threads[addr];
    if (!fresh || !cur || state.sending || state.sendGen !== gen || cur.messages.some((m) => m._pending)) return;
    state.threads[addr] = fresh; syncRow(fresh, 0);
    if (state.addr === addr) renderThread('keep');
  }).catch(() => { /* keep what we have */ });
}

/* keep the directory row for a thread in step with local changes */
/* live: a row previews what was written in the thread, not what was echoed into it */
function previewMsg(t) {
  const shown = t.messages.filter((m) => !m.withdrawn);
  const last = shown[shown.length - 1];
  if (last && last.via && loomApi.mode === 'live') {
    for (let i = shown.length - 1; i >= 0; i--) if (!shown[i].via) return shown[i];
  }
  return last;
}
function syncRow(t, delta) {
  let row = state.dir.find((r) => r.address === t.addr);
  const shown = t.messages.filter((m) => !m.withdrawn);
  const last = shown[shown.length - 1];
  if (!row) {
    if (!last) return;
    row = { address: t.addr, kind: kindOf(t.addr), label: t.label || shortLabel(t.addr), count: 0, openQuestions: 0 };
    state.dir.push(row);
    delta = shown.length;
  }
  row.count = Math.max(0, (row.count || 0) + delta);
  if (last) { const pv = previewMsg(t) || last; row.last = { name: pv.from.name, kind: pv.from.kind, body: pv.body }; row.updatedAt = last.at; }
  else row.last = null;
  if (!t.partial) row.openQuestions = openCount(t);
  renderFilters(); renderDirectory(); renderForYou();
}

async function openThread(addr, opts) {
  addr = normalizeAddress(addr);
  if (!addr) { toast('That isn’t an address the Loom understands.'); return; }
  opts = opts || {};
  if (kindOf(addr) === 'reply') {
    const id = addr.slice(addr.lastIndexOf('#') + 1);
    let home = null;
    try { home = await loomApi.locate(addr); } catch (e) { /* below */ }
    home = home ? normalizeAddress(home) : '';
    if (home && kindOf(home) !== 'reply') return openThread(home, Object.assign({}, opts, { reveal: id }));
    toast('Couldn’t find that message.');
    return;
  }
  const fresh = opts.fresh;
  state.addr = addr; store.set('addr', addr);
  try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(addr) + location.hash); } catch (e) { /* ignore */ }
  state.replyTo = null; state.markAnswer = true; state.loadError = false;
  stopPlay(); state.playN = null;
  state.notice = opts.notice ? { addr, text: opts.notice } : null;
  if (opts.reveal) state.expanded[opts.reveal] = true;
  setStatus('');
  setView('thread');
  renderDirectory();
  if (fresh) delete state.threads[addr];
  state.loading = false;
  const cached = state.threads[addr];
  if (cached && cached.bg) { cached.bg = false; refreshInBg(addr); }
  if (!state.threads[addr]) {
    state.loading = true; renderThread('bottom');
    let t = null, failed = false;
    try { t = await loomApi.thread(addr); } catch (e) { failed = e && e.status === 400 ? 'address' : true; }
    if (t) state.threads[addr] = t;
    if (state.addr !== addr) return;
    state.loading = false; state.loadError = failed;
    /* the server keeps one spelling per log: follow it */
    if (t && t.addr !== addr) {
      state.threads[t.addr] = t; delete state.threads[addr];
      addr = t.addr; state.addr = addr; store.set('addr', addr);
      try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(addr) + location.hash); } catch (e) { /* ignore */ }
    }
  }
  renderThread('bottom');
  if (opts.starter) { const st = startersFor(addr)[0]; if (st && !$('bodyInput').value) fillStarter(st, true); }
  /* Phone: the view changed, so move focus into it. Desktop: leave focus on the
     row that was clicked so arrowing/tabbing through the list keeps working. */
  if (opts.compose) { try { $('bodyInput').focus({ preventScroll: true }); } catch (e) { /* ignore */ } }
  else if (!isWide() || opts.focus) { try { $('threadTitle').focus({ preventScroll: true }); } catch (e) { /* ignore */ } }
  if (opts.reveal && document.getElementById('msg-' + opts.reveal)) {
    stickBottom = false;
    try { document.getElementById('msg-' + opts.reveal).scrollIntoView({ block: 'center' }); } catch (e) { /* ignore */ }
    flash(opts.reveal);
  }
}

async function send() {
  if (state.sending || state.checking) return;
  const ta = $('bodyInput');
  const text = ta.value.trim();
  if (!text) { ta.focus(); return; }
  if (text.length > MAX_BODY) { setStatus(tooLong(text.length), true); return; }
  const isPoll = state.kind === 'poll';
  const pollOptions = state.pollOpts.map((o) => o.trim()).filter(Boolean);
  if (isPoll && pollOptions.length < 2) { setStatus('A poll needs at least two options. Open the kind button to add them.', true); return; }
  if (!state.name) { openIdentitySheet({ thenSend: true }); return; }
  const t = thread();
  if (!t || state.loading) return;
  const reply = state.replyTo, kindLabel = state.kind, adv = Object.assign({}, state.adv), pollBackup = state.pollOpts.slice();
  const ek = effKind();
  const firstHere = !t.messages.some((x) => hasOwn(state.sent, x.id));
  const request = buildRequest();
  const local = {
    id: 'local_' + Date.now().toString(36), seq: (t.seq || 0) + 1, at: new Date().toISOString(),
    from: { name: state.name, kind: state.akind, verified: false }, kind: KIND_MAP[ek], body: text,
    via: null, plus: 0, depth: reply ? 1 : 0, replies: 0, parent: reply ? reply.id : null, _pending: true,
    poll: isPoll ? { question: text, options: pollOptions, votes: pollOptions.map(() => 0) } : null
  };
  /* chat order: a reply sits after its parent's existing replies, not at the very end */
  const parentIdx = reply ? t.messages.findIndex((x) => x.id === reply.id) : -1;
  const parentMsg = parentIdx >= 0 ? t.messages[parentIdx] : null;
  if (parentMsg) {
    let i = parentIdx + 1;
    while (i < t.messages.length && t.messages[i].depth >= 1) i++;
    t.messages.splice(i, 0, local);
    parentMsg.replies++;
  } else t.messages.push(local);
  state.sent[local.id] = 'preview'; state.expanded[local.id] = true;
  ta.value = ''; autosize(); state.replyTo = null; state.markAnswer = true; state.kind = 'note'; state.adv = { cites: '', confidence: '', title: '' }; state.pollOpts = ['', ''];
  state.sending = true; state.sendGen++;
  setStatus('');
  renderThread(parentMsg ? 'keep' : 'bottom'); syncRow(t, 1); reveal(local.id, true);
  const label = t.label || shortLabel(t.addr);
  try {
    const res = await loomApi.post(request);
    const invite = (kindOf(t.addr) === 'handle' && t.addr.toLowerCase() !== myHandle() && firstHere)
      ? { label: 'Copy an invite', run: () => copyText(inviteText(t.addr), 'Invite copied') } : null;
    const oldId = local.id;
    if (res.message) Object.assign(local, res.message);
    else if (res.id) local.id = res.id;
    /* the append reply is the raw op (no depth): keep a reply under its parent */
    if (reply) { local.parent = local.parent || reply.id; local.depth = Math.max(1, local.depth || 0); }
    if (local.seq > (t.seq || 0)) t.seq = local.seq;
    delete state.sent[oldId]; state.expanded[local.id] = true;
    if (res.editToken && local.id !== oldId) state.sent[local.id] = res.editToken;
    persistSent();
    setStatus('Posted to ' + label, false, invite);
    delete local._pending;
    state.sentOnce = true; store.set('sent1', '1');
  } catch (e) {
    t.messages = t.messages.filter((x) => x !== local);
    if (parentMsg) parentMsg.replies--;
    delete state.sent[local.id];
    ta.value = text; autosize(); state.replyTo = reply; state.kind = kindLabel; state.adv = adv; state.pollOpts = pollBackup;
    setStatus(sendErrText(e), true);
    syncRow(t, -1);
    /* A timed-out POST may still have landed. Never resend it automatically:
       look once, and if it is there, clear the box so it is not sent twice. */
    if (e && e.name === 'AbortError') checkLanded(t.addr, text, label);
  }
  state.sending = false;
  renderThread(parentMsg ? 'keep' : 'bottom');
  if (t.messages.indexOf(local) >= 0) reveal(local.id);
  else stickBottom = true;
}

async function votePoll(m, idx) {
  if (!m.poll || m._pending || hasOwn(state.voted, m.id) || !(idx >= 0 && idx < m.poll.options.length)) return;
  const t = thread();
  state.voted[m.id] = idx; m.poll.votes[idx] = (m.poll.votes[idx] || 0) + 1;
  renderThread('keep');
  try {
    await loomApi.vote(msgAddress(t, m.id), idx);
    persistVoted();
  } catch (e) {
    delete state.voted[m.id]; m.poll.votes[idx]--;
    renderThread('keep'); toast('Couldn’t record your vote. Try again in a moment.');
  }
}

async function plusOne(m) {
  if (state.plused[m.id] || m._pending) return;
  const t = thread();
  state.plused[m.id] = true; m.plus++; renderThread('keep');
  try { await loomApi.plus(msgAddress(t, m.id)); }
  catch (e) { delete state.plused[m.id]; m.plus--; renderThread('keep'); toast('Couldn’t add your +1. Try again in a moment.'); }
}

/* Keep the newest message in view when the composer grows (textarea, reply chip,
   status line) or the keyboard opens, if the reader was already at the bottom. */
let stickBottom = true;
function autosize() {
  const ta = $('bodyInput');
  ta.style.height = 'auto';
  ta.style.height = Math.min(ta.scrollHeight + 2, 144) + 'px';
}
$('msgs').addEventListener('scroll', () => {
  const b = $('msgs'); stickBottom = b.scrollHeight - b.scrollTop - b.clientHeight < 24;
}, { passive: true });
try {
  new ResizeObserver(() => { const b = $('msgs'); sizeRoomNote(b); if (stickBottom) b.scrollTop = b.scrollHeight; }).observe($('msgs'));
} catch (e) { /* older browsers: the bottom scroll on send still applies */ }

/* events */
const ADDR_HELP = 'Type a web address, a @name, a #topic or a place, then press Go.';
function addrHint(text, isErr) { const p = $('addrHint'); p.textContent = text || ''; p.className = 'addr-hint' + (isErr ? ' err' : ''); }
$('addrInput').addEventListener('focus', () => { if (!$('addrInput').value && !$('addrHint').classList.contains('err')) addrHint(ADDR_HELP); });
$('addrInput').addEventListener('input', () => addrHint($('addrInput').value ? '' : ADDR_HELP));
$('addrInput').addEventListener('blur', () => { if (!$('addrHint').classList.contains('err')) addrHint(''); });
$('addrForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const input = $('addrInput');
  const raw = input.value.trim();
  if (!raw) { addrHint('Type an address first.', true); input.focus(); return; }
  let addr = normalizeAddress(raw);
  if (!addr) { const q = raw.toLowerCase(); const hit = state.dir.find((r) => String(r.label || r.address).toLowerCase().indexOf(q) >= 0); if (hit) addr = hit.address; }
  if (!addr) { addrHint('No thread matches that. Start with @ for a person or # for a topic, or paste a link.', true); input.focus(); return; }
  addrHint('');
  input.value = ''; input.blur();
  openThread(addr, { focus: true });
});
$('dirList').addEventListener('click', (e) => {
  const row = e.target.closest('.row[data-open]'); if (row) openThread(row.getAttribute('data-open'));
});
$('msgs').addEventListener('click', (e) => {
  const link = e.target.closest('[data-open]');
  if (link) { openThread(link.getAttribute('data-open'), { focus: true }); return; }
  const vb = e.target.closest('[data-vote]');
  if (vb) {
    const vt = thread(), vart = vb.closest('.msg');
    const vm = vt && vart && vt.messages.find((x) => x.id === vart.getAttribute('data-id'));
    if (vm) votePoll(vm, parseInt(vb.getAttribute('data-vote'), 10));
    return;
  }
  const btn = e.target.closest('[data-act]'); if (!btn) return;
  const art = btn.closest('.msg'); const t = thread();
  const m = t && art && t.messages.find((x) => x.id === art.getAttribute('data-id')); if (!m) return;
  const act = btn.getAttribute('data-act');
  if (act === 'reply') {
    if (m._pending) { toast('Wait for it to post first'); return; }
    const pid = parentOf(t, m) || m.id;
    const pm = t.messages.find((x) => x.id === pid) || m;
    state.markAnswer = true;
    state.replyTo = { id: pid, name: (questionStatus(t, pm) === 'open' ? pm : m).from.name };
    renderComposerBar(); $('bodyInput').focus();
  } else if (act === 'plus') plusOne(m);
  else if (act === 'more') openMessageSheet(m);
  else if (act === 'carry') copyText(carryText(t, m), t.addr.toLowerCase() === myHandle() ? 'Copied. Paste it into your assistant.' : 'Copied. Paste it into the assistant for ' + t.addr + '.');
  else if (act === 'expand') { state.expanded[m.id] = !state.expanded[m.id]; renderThread('keep'); }
  else if (act === 'sheet') { state.sheetOpen[m.id] = !state.sheetOpen[m.id]; renderThread('keep'); }
  else if (act === 'echoes') { state.echoOpen[m.id] = !state.echoOpen[m.id]; renderThread('keep'); }
  else if (act === 'magic') playMagic(m, btn);
});
$('backBtn').addEventListener('click', () => { setView(state.tab); focusCurrentRow(); });
$('playBtn').addEventListener('click', () => { if (playTimer) { stopPlay(); state.playN = null; renderMessages('bottom'); renderPlaybar(); } else startPlay(); });
$('playRange').addEventListener('input', (e) => {
  const t = thread(), n = t ? t.messages.length : 0, v = parseInt(e.target.value, 10) || n;
  stopPlay(); state.playN = v >= n ? null : v; renderMessages('bottom'); renderPlaybar();
});
$('newBtn').addEventListener('click', openNewSheet);
$('botsBtn').addEventListener('click', openBotSheet);
$('answerToggle').addEventListener('change', (e) => { state.markAnswer = e.target.checked; renderComposerBar(); });
$('helloForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const input = $('helloInput'), hint = $('helloHint');
  const v = input.value.trim().replace(/^@+/, '');
  const addr = v ? normalizeAddress('@' + v) : '';
  if (!addr) { hint.textContent = 'Type a handle using letters, numbers, dots, dashes or underscores.'; hint.className = 'addr-hint err'; input.focus(); return; }
  hint.textContent = ''; hint.className = 'addr-hint';
  input.value = '';
  openThread(addr, { compose: true, starter: true });
});
$('helloInput').addEventListener('input', () => { $('helloHint').textContent = ''; });
$('menuBtn').addEventListener('click', openThreadMenu);
$('asBtn').addEventListener('click', () => openIdentitySheet());
$('kindBtn').addEventListener('click', openKindSheet);
$('replyClear').addEventListener('click', () => { state.replyTo = null; renderComposerBar(); $('bodyInput').focus(); });
$('composer').addEventListener('submit', (e) => { e.preventDefault(); send(); });
$('bodyInput').addEventListener('input', () => {
  autosize(); renderComposerBar();
  const s = $('sendStatus');
  if (s.textContent && !s.classList.contains('err')) setStatus('');
});
$('bodyInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); send(); }
  else if (e.key === 'Escape' && state.replyTo) { state.replyTo = null; renderComposerBar(); }
});
document.addEventListener('keydown', (e) => {
  if (!sheetEl) return;
  if (e.key === 'Escape') { e.preventDefault(); closeSheet(); return; }
  if (e.key === 'Tab') {
    const f = Array.prototype.filter.call(sheetEl.querySelectorAll(FOCUSABLE), (n) => !n.closest('[hidden]') && n.offsetParent !== null);
    if (!f.length) return;
    const first = f[0], lastEl = f[f.length - 1], cur = document.activeElement;
    if (e.shiftKey && (cur === first || !sheetEl.contains(cur) || cur.classList.contains('sheet'))) { e.preventDefault(); lastEl.focus(); }
    else if (!e.shiftKey && (cur === lastEl || !sheetEl.contains(cur))) { e.preventDefault(); first.focus(); }
  }
});
window.addEventListener('hashchange', () => {
  /* the hash only ever holds #for-you, #directory or #thread */
  const v = location.hash === '#thread' ? 'thread' : location.hash === '#directory' ? 'directory' : 'for-you';
  if (location.hash !== '#' + v) { try { history.replaceState(null, '', '#' + v); } catch (e) { /* ignore */ } }
  if (sheetEl) closeSheet(true);
  const was = $('app').dataset.view;
  if (v !== 'thread' && location.search) { try { history.replaceState(null, '', LOOM_PATH + '#' + v); } catch (e) { /* ignore */ } }
  if (v !== 'thread') { state.tab = v; $('app').dataset.tab = v; }
  $('app').dataset.view = v;
  renderTabs();
  if (was === 'thread' && v !== 'thread') focusCurrentRow();
});
window.addEventListener('resize', renderThreadHeader);

/* ---- who is hosting now (OFF-48): read from the #hosts thread, newest HOST ON with no HOST OFF.
   The room's own rule: "If a HOST ON is less than an hour old and has no HOST OFF, somebody is on."
   So an open HOST ON that is 60 minutes old or more counts as nobody on. Names are typed, not proven. ---- */
const HOST_ADDR = '#hosts', HOST_FRESH_MS = 60 * 60 * 1000;
function hostNow(messages, nowMs) {
  const open = {};
  const ordered = (messages || []).filter((m) => m && !m.withdrawn && !m.hidden && !m._pending && !m.via && m.from && m.from.kind !== 'robot' && m.from.name !== 'Collator');
  ordered.forEach((m) => {
    const first = String(m.body || '').split('\n')[0];
    /* the room's format is upper case, then a dot separator or end of line, so "Host on call tonight?" never counts */
    const on = /^\s*HOST\s+ON(\s*[·:-]|\s*$)/.test(first), off = !on && /^\s*HOST\s+OFF(\s*[·:-]|\s*$)/.test(first);
    if (!on && !off) return;
    const key = String(m.from.name || '').trim().toLowerCase();
    const at = Date.parse(m.at); const seq = typeof m.seq === 'number' ? m.seq : null;
    const cur = open[key] || (open[key] = { on: null, off: null });
    const later = (a, b) => !a || (seq != null && a.seq != null ? seq > a.seq : at > a.at);
    const rec = { seq, at, name: String(m.from.name || '').trim(), iso: m.at };
    if (on && later(cur.on, rec)) cur.on = rec;
    if (off && later(cur.off, rec)) cur.off = rec;
  });
  let best = null;
  Object.keys(open).forEach((k) => {
    const o = open[k]; if (!o.on) return;
    if (o.off && (o.on.seq != null && o.off.seq != null ? o.off.seq > o.on.seq : o.off.at > o.on.at)) return;
    if (!best || (o.on.seq != null && best.seq != null ? o.on.seq > best.seq : o.on.at > best.at)) best = o.on;
  });
  if (!best || !(nowMs - best.at < HOST_FRESH_MS)) return null;
  return { name: best.name, since: best.iso };
}
const hostState = { loaded: false, host: null, last: 0 };
function renderHostLine() {
  const el = $('hostLine'); if (!el) return;
  const hadFocus = el.contains(document.activeElement);
  el.textContent = '';
  if (!hostState.loaded) { el.hidden = true; return; }
  el.hidden = false;
  const hn = hostState.host;
  if (hn) {
    const nm = hn.name.length > 40 ? hn.name.slice(0, 39) + '…' : hn.name;
    let clock = ''; try { clock = new Date(hn.since).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }).replace(/\s/g, '').toLowerCase(); } catch (e) { /* ignore */ }
    el.append('On now: ', h('button', { type: 'button', class: 'hn', title: 'Names are typed, not proven', 'aria-label': nm + ', open the #hosts thread', text: nm, onclick: () => openThread(HOST_ADDR) }), ' · since ' + clock + (rel(hn.since) ? ' (' + rel(hn.since).toLowerCase() + ')' : ''));
  } else {
    el.append('Nobody is on. ', h('button', { type: 'button', text: 'Leave a note', onclick: () => openThread(HOST_ADDR, { focus: true, compose: true }) }));
  }
  /* the minute refresh rebuilds the button: keep a keyboard user's place */
  if (hadFocus) { const b = el.querySelector('button'); if (b) { try { b.focus({ preventScroll: true }); } catch (e) { /* ignore */ } } }
}
async function refreshHosts() {
  if (loomApi.mode !== 'live') {
    /* offline: a line we can no longer check must not keep saying someone is on */
    if (loomApi.mode === 'offline' && hostState.loaded) { hostState.loaded = false; renderHostLine(); }
    return;
  }
  hostState.last = Date.now();
  try {
    const t = await loomApi.thread(HOST_ADDR);
    hostState.host = hostNow(t.messages, Date.now()); hostState.loaded = true;
  } catch (e) { hostState.loaded = false; }
  renderHostLine();
}

/* live polling: new ops since our seq, every 15s, only while the page is visible */
async function poll() {
  if (loomApi.mode === 'offline' && !document.hidden) { connect(); return; }
  if (loomApi.mode !== 'live' || document.hidden || state.sending) return;
  const addr = state.addr, gen = state.sendGen;
  const t = thread(); if (!t || state.loadError || state.loading) return;
  try {
    const fresh = await loomApi.since(t);
    if (loomApi.reconnecting) { loomApi.reconnecting = false; renderChip(); }
    /* ops can be edits, withdrawals and +1s as well as new messages: take the
       whole folded thread rather than patching, and keep anything still pending on top */
    if (!fresh || state.addr !== addr || state.sending || state.sendGen !== gen) return;
    const pending = t.messages.filter((m) => m._pending);
    const box = $('msgs');
    const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;
    fresh.messages.push.apply(fresh.messages, pending);
    state.threads[addr] = fresh;
    syncRow(fresh, 0);
    renderThread(nearBottom ? 'bottom' : 'keep');
  } catch (e) {
    if (!loomApi.reconnecting) { loomApi.reconnecting = true; renderChip(); }
  }
}
setInterval(poll, 15000);
document.addEventListener('visibilitychange', () => { if (!document.hidden) { poll(); if (Date.now() - hostState.last > 60000) refreshHosts(); } });
setInterval(() => { if (!document.hidden) refreshHosts(); }, 60000);
setInterval(() => { if (!sheetEl) { renderDirectory(); renderForYou(); } }, 60000);

/* ==========================================================================
   5. BOOT: paint the empty shell, then read the live Loom
   ========================================================================== */
let connecting = false;
async function connect() {
  if (connecting) return;
  connecting = true;
  if (loomApi.mode !== 'live') { loomApi.mode = 'connecting'; renderChip(); renderDirectory(); }
  try {
    loomApi.ready = loomApi.probe();
    const rows = await loomApi.ready;
    renderChip();
    if (!rows) {
      renderDirectory();
      if (!state.threads[state.addr]) { state.loading = false; state.loadError = true; renderThread('keep'); }
      return;
    }
    state.dir = rows;
    renderFilters(); renderDirectory(); renderForYou();
    if (state.filter === 'url') loadLinks();
    const addr = state.addr;
    if (!state.threads[addr]) {
      state.loading = true; state.loadError = false; renderThread('keep');
      let t = null;
      try { t = await loomApi.thread(addr); } catch (e) { /* shown below */ }
      if (state.addr === addr) {
        state.loading = false;
        if (t) { state.threads[addr] = t; state.loadError = false; syncRow(t, 0); } else state.loadError = true;
        renderThread('bottom');
        const want = pendingReveal; pendingReveal = null;
        if (want && document.getElementById('msg-' + want)) {
          stickBottom = false;
          try { document.getElementById('msg-' + want).scrollIntoView({ block: 'center' }); } catch (e) { /* ignore */ }
          flash(want);
        }
      }
    }
    backfill();
    refreshHosts();
  } finally { connecting = false; }
}
let pendingReveal = null;

(async function boot() {
  const backIcon = glyph('back', 'glyph'); $('backBtn').append(backIcon);
  $('menuBtn').append(glyph('dots', 'glyph'));
  $('newGlyph').append(glyph('plus', 'glyph'));
  /* ?as=NAME: a self-declared name for this visit only. Never written to storage. */
  try {
    const q0 = new URLSearchParams(location.search);
    state.hasTo = !!(q0.get('to') || '').trim();
    const asName = cleanVisitName(q0.get('as') || '');
    if (asName && !state.name) { state.name = asName; state.visitName = true; }
    /* strip as= from the address bar so a copied link never carries someone's identity.
       Accepted trade-off: a refresh drops the visit name (it lives in memory only). */
    if (q0.has('as')) { q0.delete('as'); const qs0 = q0.toString(); history.replaceState(null, '', location.pathname + (qs0 ? '?' + qs0 : '') + location.hash); }
  } catch (e) { /* ignore */ }
  buildTabs();
  state.sentOnce = !!store.get('sent1');
  const hash = location.hash;
  /* RSS items link to /loom?to=<address>#<message id> */
  if (/^#m_[A-Za-z0-9]+$/.test(hash)) state.keepId = pendingReveal = hash.slice(1);
  let view = hash === '#thread' || pendingReveal ? 'thread' : hash === '#directory' ? 'directory' : 'for-you';
  /* a shared link: /loom?to=<address> opens that thread */
  let shared = '';
  try { shared = new URLSearchParams(location.search).get('to') || ''; } catch (e) { /* ignore */ }
  const want = shared ? normalizeAddress(shared) : '';
  if (want && kindOf(want) !== 'reply') { state.addr = want; view = 'thread'; }
  /* ?compose=1 (the paste-in button, /loom/button.js): focus the message box once the thread is shown */
  let composeOnOpen = false;
  try { composeOnOpen = !!want && new URLSearchParams(location.search).get('compose') === '1'; } catch (e) { /* ignore */ }
  state.tab = view === 'directory' ? 'directory' : 'for-you';
  $('app').dataset.view = view; $('app').dataset.tab = state.tab;
  if (location.hash !== '#' + view) { try { history.replaceState(null, '', location.pathname + location.search + '#' + view); } catch (e) { /* ignore */ } }
  renderChip(); renderFilters(); renderDirectory(); renderThread('bottom'); renderForYou();
  if (composeOnOpen) {
    const ta = $('bodyInput');
    const go = () => { try { ta.focus({ preventScroll: true }); ta.scrollIntoView({ block: 'center' }); } catch (e) { /* ignore */ } };
    go(); setTimeout(go, 350);
    try {
      const q = new URLSearchParams(location.search); q.delete('compose');
      const qs = q.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
    } catch (e) { /* ignore */ }
  }

  /* a link to one message (loom:<key>#<id>): find its thread, then open it there */
  if (want && kindOf(want) === 'reply') {
    const id = want.slice(want.lastIndexOf('#') + 1);
    try {
      const home = await loomApi.locate(want);
      if (home) { state.addr = home; state.keepId = pendingReveal = /^m_[A-Za-z0-9]+$/.test(id) ? id : null; setView('thread'); try { history.replaceState(null, '', LOOM_PATH + '?to=' + encodeURIComponent(home) + '#thread'); } catch (e) { /* ignore */ } }
    } catch (e) { /* fall back to the saved thread */ }
  }
  connect();
})();
</script>
