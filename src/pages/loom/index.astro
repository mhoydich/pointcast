  const sheet = h('div', { class: 'sheet', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'sheetTitle', tabindex: '-1' },
    h('div', { class: 'sheet-h' },
      h('h2', { id: 'sheetTitle', text: title }),
      h('button', { type: 'button', class: 'iconbtn', 'aria-label': 'Close', onclick: () => closeSheet(), text: '×', style: 'font-size:22px' })),
    body);
  const backdrop = h('div', { class: 'backdrop' }, sheet);
