/* ---- For you ---- */
function collectForYou() {
  const me = myHandle(), waiting = [], replies = [];
  if (!me) return { me, waiting, replies };
  Object.keys(state.threads).forEach((addr) => {
    const t = state.threads[addr];
    if (!t || !t.messages) return;
    t.messages.forEach((m) => {
      if (m.withdrawn || m._pending || m.via || hasOwn(state.sent, m.id)) return;
      if ('@' + handleOf(m.from.name) === me) return;
      const ment = mentions(m.body, me);
      if (questionStatus(t, m) === 'open' && (addr.toLowerCase() === me || ment)) { waiting.push({ t, m }); return; }
      const pid = parentOf(t, m);
      if ((pid && hasOwn(state.sent, pid)) || ment) replies.push({ t, m });
    });
  });
  const newest = (x, y) => (Date.parse(y.m.at) - Date.parse(x.m.at)) || ((y.m.seq || 0) - (x.m.seq || 0));
  waiting.sort(newest); replies.sort(newest);
  return { me, waiting, replies };
}
function renderForYou() {
  const box = $('fyDyn');
  const f = collectForYou();
  state.waitingCount = f.waiting.length;
  renderTabs(); renderAskBots(); renderDesks();
  keepFocus(box, (a) => a.dataset.fy ? '[data-fy=' + cssStr(a.dataset.fy) + ']' : (a.dataset.fyact ? '[data-fyact=' + cssStr(a.dataset.fyact) + ']' : null),
    () => drawForYou(box, f), () => $('newBtn'));
}
