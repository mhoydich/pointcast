function renderAskBots() {
  const box = $('fyBots'), me = myHandle(), seen = {}, people = {};
  /* a handle someone posts under as a human is a person's inbox, not a bot's */
  const person = (name, kind) => { if (kind === 'human') { const hd = handleOf(name); if (hd) people['@' + hd] = true; } };
  state.dir.forEach((r) => { if (r.last) person(r.last.name, r.last.kind); });
  Object.keys(state.threads).forEach((a) => (state.threads[a].messages || []).forEach((m) => person(m.from.name, m.from.kind)));
  const add = (addr, at) => { const k = addr.toLowerCase(); if (k === me || people[k] || (seen[k] && seen[k] >= at)) return; seen[k] = at; };
  state.dir.forEach((r) => { const k = kindOf(r.address); if ((k === 'handle' || k === 'agent') && r.last && r.last.kind === 'agent') add(r.address, Date.parse(r.updatedAt) || 0); });
  Object.keys(state.threads).forEach((a) => { const t = state.threads[a]; if (kindOf(a) === 'handle' && t.messages.some((m) => m.from.kind === 'agent')) add(a, Date.parse((t.messages[t.messages.length - 1] || {}).at) || 0); });
