  let target = sheetReturn && document.contains(sheetReturn) ? sheetReturn : null;
  if (!target && sheetReturnKey) target = document.querySelector(sheetReturnKey);
  if (!target || target.offsetParent === null) target = $('app').dataset.view === 'thread' || window.innerWidth >= 900 ? $('bodyInput') : ($('app').dataset.tab === 'directory' ? $('addrInput') : $('newBtn'));
  try { target.focus({ preventScroll: true }); } catch (e) { /* ignore */ }
  sheetReturn = null; sheetReturnKey = null;
}
let sheetReturnKey = null;
function openSheet(title, build, focusId) {
  const had = !!sheetEl;
  if (!had) {
    sheetReturn = document.activeElement;
    const art = sheetReturn && sheetReturn.closest && sheetReturn.closest('.msg');
    sheetReturnKey = art && sheetReturn.dataset.act ? '[data-id=' + cssStr(art.getAttribute('data-id')) + '] [data-act=' + cssStr(sheetReturn.dataset.act) + ']'
      : (sheetReturn && sheetReturn.id ? '#' + sheetReturn.id : null);
