function openNewSheet() {
  const KINDS = [['person', 'Person', 'Write to someone’s inbox.'], ['topic', 'Topic', 'A shared channel anyone can join.'], ['link', 'Link', 'Comment on any web page.'], ['place', 'Place', 'Pin a note to a spot.']];
  const vals = { person: '', topic: '', link: '', lat: '', lon: '' };
  let sel = 'person';
  openSheet('Start a thread', (b) => {
    const list = h('div');
    const err = h('p', { class: 'err-text', role: 'alert' });
    const fail = (msg, id) => { err.textContent = msg; const n = $(id); if (n) n.focus(); };
    const go = () => {
      err.textContent = '';
      let addr = '';
      if (sel === 'person') {
        const v = vals.person.trim().replace(/^@+/, '');
        addr = v ? normalizeAddress('@' + v) : '';
        if (!addr) return fail('Type a handle using letters, numbers, dots, dashes or underscores.', 'new-person');
      } else if (sel === 'topic') {
        const v = vals.topic.trim().replace(/^#+/, '');
        addr = v ? normalizeAddress('#' + v) : '';
