  if (state.kind === 'poll') {
    const opts = state.pollOpts.map((o) => o.trim()).filter(Boolean);
    req.poll = { question: req.body, options: opts };
  }
  const cites = state.adv.cites.split(/[\s,]+/).filter(Boolean);
  if (cites.length) req.cites = cites;
  const conf = parseFloat(state.adv.confidence);
  if (isFinite(conf)) req.confidence = Math.min(1, Math.max(0, conf));
  if (state.adv.title.trim()) req.title = state.adv.title.trim();
  return req;
}
