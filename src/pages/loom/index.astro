      h('div', { style: 'position:relative' }, prefix ? h('span', { class: 'pre-prefix', 'aria-hidden': 'true', text: prefix }) : null,
        h('input', Object.assign({ id, type: 'text', value: vals[key], autocomplete: 'off', autocapitalize: 'none', autocorrect: 'off', spellcheck: 'false',
          style: prefix ? 'padding-left:28px' : null, oninput: (e) => { vals[key] = e.target.value; }, onkeydown: keyGo }, attrs))));
    const boxFor = (k) => {
      const wrap = h('div', { class: 'newbox' });
      if (k === 'person') wrap.append(pfield('new-person', '@', 'person', 'Handle', { placeholder: 'name' }));
      else if (k === 'topic') wrap.append(pfield('new-topic', '#', 'topic', 'Topic', { placeholder: 'topic' }));
      else if (k === 'link') wrap.append(pfield('new-link', null, 'link', 'Web address', { placeholder: 'https://', inputmode: 'url' }));
      else {
        wrap.append(pfield('new-lat', null, 'lat', 'Latitude', { placeholder: '34.005', inputmode: 'decimal' }),
          pfield('new-lon', null, 'lon', 'Longitude', { placeholder: '-118.420', inputmode: 'decimal' }),
          h('p', { class: 'hint', text: 'About 100 metres wide.' }));
      }
      wrap.append(h('div', { class: 'btnrow' }, h('button', { type: 'button', class: 'btn', text: 'Open thread', onclick: go })));
      return wrap;
    };
    const draw = () => {
      list.textContent = '';
      KINDS.forEach(([k, label, sub]) => {
        list.append(h('button', { type: 'button', class: 'newopt', id: 'newopt-' + k, 'aria-expanded': String(sel === k),
          onclick: () => { sel = k; err.textContent = ''; draw(); const f = list.querySelector('input'); if (f) f.focus(); } },
          h('span', { class: 't', text: label }), h('small', { text: sub })));
        if (sel === k) list.append(boxFor(k));
