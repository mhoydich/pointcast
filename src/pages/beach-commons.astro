---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

import {
  BEACH_COMMONS_EDITIONS,
  BEACH_COMMONS_PATHS,
  BEACH_COMMONS_SERIES,
  beachCommonsEditionUrl,
} from '../lib/beach-commons-series';

const currentEdition =
  BEACH_COMMONS_EDITIONS.find((edition) => edition.current) ??
  BEACH_COMMONS_EDITIONS[BEACH_COMMONS_EDITIONS.length - 1];
const pathMap = new Map(BEACH_COMMONS_PATHS.map((path) => [path.id, path]));
const socialImage = 'https://pointcast.xyz/images/og/b/0548.png';
const editionCount = BEACH_COMMONS_EDITIONS.length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  '@id': `${BEACH_COMMONS_SERIES.url}#series`,
  name: BEACH_COMMONS_SERIES.title,
  alternativeHeadline: BEACH_COMMONS_SERIES.subtitle,
  description: BEACH_COMMONS_SERIES.dek,
  url: BEACH_COMMONS_SERIES.url,
  image: socialImage,
  datePublished: BEACH_COMMONS_SERIES.publishedAt,
  dateModified: BEACH_COMMONS_SERIES.updatedAt,
  creator: BEACH_COMMONS_SERIES.creators.map((creator) => ({
    '@type': creator.name === 'Michael Hoydich' ? 'Person' : 'Organization',
    name: creator.name,
  })),
  hasPart: BEACH_COMMONS_EDITIONS.map((edition) => ({
    '@type': 'CreativeWork',
    position: edition.edition,
    name: edition.title,
    description: edition.subtitle,
    url: beachCommonsEditionUrl(edition),
    image: new URL(edition.image, BEACH_COMMONS_SERIES.url).href,
  })),
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={BEACH_COMMONS_SERIES.dek} />
    <meta name="theme-color" content="#102936" />
    <link rel="canonical" href={BEACH_COMMONS_SERIES.url} />
    <link
      rel="alternate"
      type="application/json"
      href={BEACH_COMMONS_SERIES.jsonUrl}
      title="Beach Commons series index"
    />
    <link
      rel="preload"
      as="image"
      href={currentEdition.image}
      fetchpriority="high"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content="Beach Commons — The Complete Field Series" />
    <meta property="og:description" content={BEACH_COMMONS_SERIES.dek} />
    <meta property="og:url" content={BEACH_COMMONS_SERIES.url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Beach Commons — The Complete Field Series" />
    <meta name="twitter:description" content={BEACH_COMMONS_SERIES.dek} />
    <meta name="twitter:image" content={socialImage} />
    <title>Beach Commons — The Complete Field Series · PointCast</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: dark;
        --navy: #102936;
        --navy-deep: #081b25;
        --navy-soft: #183c4b;
        --paper: #f4efdf;
        --paper-deep: #e5ddc8;
        --ink: #14282f;
        --orange: #f06a3a;
        --yellow: #efc75e;
        --blue: #7bb8cf;
        --green: #92b6a6;
        --white: #fffdf5;
        --line-dark: rgba(255, 253, 245, 0.2);
        --line-light: rgba(20, 40, 47, 0.2);
        --gutter: clamp(18px, 4vw, 64px);
        --sans: "Inter Variable", Inter, "Helvetica Neue", Arial, sans-serif;
        --mono: "JetBrains Mono Variable", "SFMono-Regular", Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 320px;
        scroll-behavior: smooth;
        background: var(--navy-deep);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        color: inherit;
        font: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      [hidden] {
        display: none !important;
      }

      :focus-visible {
        outline: 3px solid var(--yellow);
        outline-offset: 4px;
      }

      ::selection {
        background: var(--yellow);
        color: var(--navy-deep);
      }

      .skip {
        position: fixed;
        z-index: 200;
        top: 10px;
        left: 10px;
        padding: 11px 14px;
        background: var(--yellow);
        color: var(--navy-deep);
        font: 750 11px/1 var(--mono);
        text-decoration: none;
        text-transform: uppercase;
        transform: translateY(-180%);
      }

      .skip:focus {
        transform: translateY(0);
      }

      .site-head {
        position: sticky;
        z-index: 100;
        top: 0;
        display: grid;
        min-height: 58px;
        grid-template-columns: minmax(0, 1fr) auto auto auto;
        border-bottom: 1px solid var(--line-dark);
        background: color-mix(in srgb, var(--navy-deep) 92%, transparent);
        color: var(--white);
        backdrop-filter: blur(16px);
      }

      .site-head a,
      .site-head__label {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 0 clamp(14px, 2.2vw, 30px);
        border-left: 1px solid var(--line-dark);
        font: 720 10px/1 var(--mono);
        letter-spacing: 0.1em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .site-head .brand {
        border-left: 0;
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 850;
        letter-spacing: 0.18em;
      }

      .site-head a:hover {
        background: var(--paper);
        color: var(--navy-deep);
      }

      .hero {
        position: relative;
        display: grid;
        min-height: calc(100svh - 58px);
        grid-template-columns: minmax(0, 0.94fr) minmax(420px, 1.06fr);
        overflow: hidden;
        background: var(--navy);
        color: var(--white);
      }

      .hero__copy {
        position: relative;
        z-index: 2;
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(34px, 6vw, 94px) var(--gutter) clamp(30px, 5vw, 72px);
      }

      .kicker,
      .section-kicker {
        margin: 0;
        font: 720 10px/1.35 var(--mono);
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .hero h1 {
        max-width: 7ch;
        margin: 0.22em 0 0;
        font-size: clamp(68px, 9.2vw, 150px);
        font-weight: 900;
        letter-spacing: -0.085em;
        line-height: 0.76;
        text-transform: uppercase;
      }

      .hero h1 span {
        display: block;
        color: var(--yellow);
      }

      .hero__dek {
        max-width: 30ch;
        margin: clamp(28px, 5vw, 64px) 0 0;
        font-size: clamp(20px, 2.1vw, 31px);
        font-weight: 520;
        letter-spacing: -0.035em;
        line-height: 1.08;
      }

      .hero__stats {
        display: grid;
        margin: clamp(34px, 6vw, 76px) 0 0;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--line-dark);
        border-bottom: 1px solid var(--line-dark);
      }

      .hero__stats div {
        padding: 16px 12px 15px 0;
        border-right: 1px solid var(--line-dark);
      }

      .hero__stats div + div {
        padding-left: 16px;
      }

      .hero__stats div:last-child {
        border-right: 0;
      }

      .hero__stats strong,
      .hero__stats span {
        display: block;
      }

      .hero__stats strong {
        font-size: clamp(28px, 3.2vw, 48px);
        font-weight: 850;
        letter-spacing: -0.06em;
        line-height: 1;
      }

      .hero__stats span {
        margin-top: 7px;
        color: rgba(255, 253, 245, 0.7);
        font: 650 9px/1.25 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero__visual {
        position: relative;
        min-height: 700px;
        overflow: hidden;
        border-left: 1px solid var(--line-dark);
        background: var(--navy-deep);
      }

      .hero__visual::after {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(8, 27, 37, 0.08), rgba(8, 27, 37, 0.68)),
          linear-gradient(90deg, rgba(8, 27, 37, 0.16), transparent 55%);
        content: "";
        pointer-events: none;
      }

      .hero__visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero__current {
        position: absolute;
        z-index: 2;
        right: clamp(18px, 4vw, 54px);
        bottom: clamp(18px, 4vw, 54px);
        left: clamp(18px, 4vw, 54px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 253, 245, 0.6);
      }

      .hero__current p {
        margin: 0;
      }

      .hero__current .edition-label {
        margin-bottom: 9px;
        font: 720 10px/1 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hero__current h2 {
        margin: 0;
        font-size: clamp(32px, 4.4vw, 68px);
        font-weight: 850;
        letter-spacing: -0.065em;
        line-height: 0.92;
        text-transform: uppercase;
      }

      .hero__current .current-dek {
        max-width: 40ch;
        margin-top: 12px;
        color: rgba(255, 253, 245, 0.82);
        font-size: 14px;
        line-height: 1.4;
      }

      .arrow-link {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        background: var(--orange);
        color: var(--navy-deep);
        font: 780 10px/1 var(--mono);
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .arrow-link:hover {
        background: var(--yellow);
      }

      .marquee {
        display: flex;
        min-height: 46px;
        align-items: center;
        overflow: hidden;
        border-top: 1px solid var(--line-dark);
        border-bottom: 1px solid var(--line-dark);
        background: var(--navy-deep);
        color: var(--white);
      }

      .marquee__track {
        display: flex;
        width: max-content;
        gap: 30px;
        padding: 0 16px;
        font: 700 10px/1 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
        animation: crawl 32s linear infinite;
      }

      .marquee__track span::after {
        margin-left: 30px;
        color: var(--orange);
        content: "●";
      }

      @keyframes crawl {
        to {
          transform: translateX(-50%);
        }
      }

      .paths {
        padding: clamp(72px, 10vw, 150px) var(--gutter);
        background: var(--paper);
      }

      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
        gap: clamp(32px, 6vw, 100px);
        align-items: end;
        margin-bottom: clamp(42px, 6vw, 80px);
      }

      .section-head h2 {
        max-width: 9ch;
        margin: 12px 0 0;
        font-size: clamp(52px, 8vw, 120px);
        font-weight: 880;
        letter-spacing: -0.08em;
        line-height: 0.8;
        text-transform: uppercase;
      }

      .section-head__copy {
        max-width: 46ch;
        margin: 0;
        font-size: clamp(18px, 2.1vw, 28px);
        font-weight: 510;
        letter-spacing: -0.025em;
        line-height: 1.18;
      }

      .path-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border-top: 1px solid var(--line-light);
        border-left: 1px solid var(--line-light);
      }

      .path {
        --path-color: var(--orange);
        min-height: 290px;
        padding: clamp(22px, 3vw, 38px);
        border: 0;
        border-right: 1px solid var(--line-light);
        border-bottom: 1px solid var(--line-light);
        background: transparent;
        text-align: left;
        cursor: pointer;
      }

      .path:hover,
      .path[aria-pressed="true"] {
        background: var(--path-color);
      }

      .path__number,
      .path__count {
        font: 700 10px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .path h3 {
        max-width: 8ch;
        margin: 58px 0 18px;
        font-size: clamp(28px, 3vw, 44px);
        font-weight: 850;
        letter-spacing: -0.06em;
        line-height: 0.9;
        text-transform: uppercase;
      }

      .path p {
        margin: 0;
        font-size: 14px;
        line-height: 1.45;
      }

      .path__count {
        display: block;
        margin-top: 24px;
      }

      .filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 20px;
      }

      .filter-actions button {
        min-height: 44px;
        padding: 0 16px;
        border: 1px solid var(--line-light);
        background: transparent;
        font: 720 10px/1 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .filter-actions button:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .filter-status {
        margin: 0 0 0 auto;
        color: rgba(20, 40, 47, 0.7);
        font: 650 10px/1.35 var(--mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .handoff {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: clamp(34px, 7vw, 110px);
        padding: 0 var(--gutter) clamp(72px, 9vw, 130px);
        background: var(--paper);
      }

      .handoff__title h2 {
        max-width: 8ch;
        margin: 12px 0 0;
        font-size: clamp(46px, 6.2vw, 92px);
        font-weight: 880;
        letter-spacing: -0.075em;
        line-height: 0.84;
        text-transform: uppercase;
      }

      .handoff__line {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--line-light);
        border-left: 1px solid var(--line-light);
      }

      .handoff__line a {
        min-height: 270px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(20px, 2.5vw, 34px);
        border-right: 1px solid var(--line-light);
        border-bottom: 1px solid var(--line-light);
        text-decoration: none;
      }

      .handoff__line a:hover,
      .handoff__line a:focus-visible {
        background: var(--yellow);
      }

      .handoff__line span {
        color: var(--orange);
        font: 800 10px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .handoff__line strong {
        display: block;
        margin-bottom: 10px;
        font-size: clamp(23px, 2.4vw, 38px);
        letter-spacing: -0.055em;
        line-height: 0.9;
        text-transform: uppercase;
      }

      .handoff__line p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
      }

      .editions {
        padding: 0 var(--gutter) clamp(88px, 12vw, 180px);
        background: var(--paper);
      }

      .edition-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: clamp(12px, 1.5vw, 24px);
      }

      .edition-card {
        --path-color: var(--orange);
        position: relative;
        grid-column: span 4;
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--line-light);
        background: var(--white);
        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
      }

      .edition-card.current {
        grid-column: span 8;
      }

      .edition-card:hover {
        z-index: 2;
        box-shadow: 12px 14px 0 var(--path-color);
        transform: translate(-4px, -5px);
      }

      .edition-card a {
        display: flex;
        height: 100%;
        flex-direction: column;
        text-decoration: none;
      }

      .edition-card__media {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--navy-soft);
      }

      .edition-card.current .edition-card__media {
        aspect-ratio: 16 / 9;
      }

      .edition-card__media::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 55%, rgba(8, 27, 37, 0.5));
        content: "";
        pointer-events: none;
      }

      .edition-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms ease;
      }

      .edition-card:hover img {
        transform: scale(1.035);
      }

      .edition-card__badge {
        position: absolute;
        z-index: 1;
        top: 14px;
        left: 14px;
        padding: 8px 10px;
        background: var(--path-color);
        color: var(--navy-deep);
        font: 800 9px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .edition-card__body {
        display: flex;
        min-height: 270px;
        flex: 1;
        flex-direction: column;
        padding: clamp(20px, 2.5vw, 34px);
      }

      .edition-card__meta {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        font: 700 9px/1.25 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .edition-card h3 {
        max-width: 11ch;
        margin: 26px 0 14px;
        font-size: clamp(28px, 3vw, 46px);
        font-weight: 850;
        letter-spacing: -0.065em;
        line-height: 0.92;
        text-transform: uppercase;
      }

      .edition-card.current h3 {
        font-size: clamp(42px, 5vw, 76px);
      }

      .edition-card__subtitle {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
        line-height: 1.35;
      }

      .edition-card__invitation {
        margin: 18px 0 0;
        color: rgba(20, 40, 47, 0.7);
        font-size: 13px;
        line-height: 1.45;
      }

      .edition-card__enter {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: auto;
        padding-top: 28px;
        color: var(--ink);
        font: 760 10px/1 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .spine {
        padding: clamp(56px, 7vw, 100px) var(--gutter);
        border-top: 1px solid var(--line-dark);
        border-bottom: 1px solid var(--line-dark);
        background: var(--navy);
        color: var(--white);
      }

      .spine__top {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: end;
        margin-bottom: 34px;
      }

      .spine h2 {
        margin: 10px 0 0;
        font-size: clamp(38px, 5.6vw, 82px);
        font-weight: 860;
        letter-spacing: -0.07em;
        line-height: 0.9;
        text-transform: uppercase;
      }

      .spine__rail {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        border-top: 1px solid var(--line-dark);
        border-left: 1px solid var(--line-dark);
      }

      .spine__rail a {
        display: flex;
        min-height: 76px;
        align-items: center;
        justify-content: center;
        border-right: 1px solid var(--line-dark);
        border-bottom: 1px solid var(--line-dark);
        font: 760 11px/1 var(--mono);
        text-decoration: none;
      }

      .spine__rail a:hover,
      .spine__rail a[aria-current="page"] {
        background: var(--yellow);
        color: var(--navy-deep);
      }

      .manifesto {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        background: var(--paper-deep);
      }

      .manifesto__panel {
        min-height: 560px;
        padding: clamp(58px, 8vw, 124px) var(--gutter);
        border-right: 1px solid var(--line-light);
      }

      .manifesto__panel:last-child {
        border-right: 0;
      }

      .manifesto h2 {
        max-width: 10ch;
        margin: 14px 0 34px;
        font-size: clamp(42px, 6vw, 90px);
        font-weight: 860;
        letter-spacing: -0.075em;
        line-height: 0.84;
        text-transform: uppercase;
      }

      .manifesto p {
        max-width: 48ch;
        margin: 0;
        font-size: clamp(17px, 1.6vw, 23px);
        letter-spacing: -0.015em;
        line-height: 1.45;
      }

      .manifesto p + p {
        margin-top: 20px;
      }

      .manifesto__panel--dark {
        background: var(--navy-deep);
        color: var(--white);
      }

      .manifesto__panel--dark p {
        color: rgba(255, 253, 245, 0.78);
      }

      .closing-links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        background: var(--orange);
        color: var(--navy-deep);
      }

      .closing-links a {
        display: flex;
        min-height: 150px;
        flex-direction: column;
        justify-content: space-between;
        padding: 28px var(--gutter);
        border-right: 1px solid rgba(8, 27, 37, 0.3);
        text-decoration: none;
      }

      .closing-links a:last-child {
        border-right: 0;
      }

      .closing-links span {
        font: 760 10px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .closing-links strong {
        max-width: 12ch;
        font-size: clamp(22px, 2.5vw, 36px);
        letter-spacing: -0.055em;
        line-height: 0.95;
        text-transform: uppercase;
      }

      .closing-links a:hover {
        background: var(--yellow);
      }

      footer {
        display: flex;
        min-height: 64px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px var(--gutter);
        background: var(--navy-deep);
        color: rgba(255, 253, 245, 0.74);
        font: 650 9px/1.35 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      footer a {
        text-decoration: none;
      }

      footer a:hover {
        color: var(--yellow);
      }

      @media (max-width: 980px) {
        .hero {
          min-height: auto;
          grid-template-columns: 1fr;
        }

        .hero__copy {
          min-height: 680px;
        }

        .hero__visual {
          min-height: 640px;
          border-top: 1px solid var(--line-dark);
          border-left: 0;
        }

        .path-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .handoff {
          grid-template-columns: 1fr;
        }

        .edition-card,
        .edition-card.current {
          grid-column: span 6;
        }

        .spine__rail {
          grid-template-columns: repeat(6, minmax(0, 1fr));
        }
      }

      @media (max-width: 680px) {
        .site-head {
          grid-template-columns: minmax(0, 1fr) auto;
        }

        .site-head__label,
        .site-head .archive-link {
          display: none;
        }

        .hero__copy {
          min-height: 620px;
        }

        .hero h1 {
          font-size: clamp(58px, 18vw, 104px);
        }

        .hero__stats strong {
          font-size: 27px;
        }

        .hero__visual {
          min-height: 570px;
        }

        .hero__current {
          grid-template-columns: 1fr;
        }

        .section-head {
          grid-template-columns: 1fr;
        }

        .path-grid {
          grid-template-columns: 1fr;
        }

        .handoff__line {
          grid-template-columns: 1fr;
        }

        .handoff__line a {
          min-height: 210px;
        }

        .path {
          min-height: 230px;
        }

        .path h3 {
          margin-top: 38px;
        }

        .filter-status {
          width: 100%;
          margin: 8px 0 0;
        }

        .edition-grid {
          grid-template-columns: 1fr;
        }

        .edition-card,
        .edition-card.current {
          grid-column: auto;
        }

        .edition-card.current .edition-card__media {
          aspect-ratio: 4 / 3;
        }

        .edition-card__body {
          min-height: 250px;
        }

        .spine__top {
          display: block;
        }

        .spine__top .arrow-link {
          margin-top: 24px;
        }

        .spine__rail {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .manifesto {
          grid-template-columns: 1fr;
        }

        .manifesto__panel {
          min-height: 0;
          border-right: 0;
          border-bottom: 1px solid var(--line-light);
        }

        .closing-links {
          grid-template-columns: 1fr;
        }

        .closing-links a {
          min-height: 120px;
          border-right: 0;
          border-bottom: 1px solid rgba(8, 27, 37, 0.3);
        }

        footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .marquee__track {
          animation: none;
        }

        .edition-card,
        .edition-card__media img {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#editions">Skip to the editions</a>

    <header class="site-head">
      <a class="brand" href="/">PointCast</a>
      <span class="site-head__label">Beach Commons · {editionCount} editions</span>
      <a class="archive-link" href="#paths">Choose a path</a>
      <a href={BEACH_COMMONS_SERIES.jsonUrl}>JSON ↗</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="series-title">
        <div class="hero__copy">
          <div>
            <p class="kicker">PointCast field series · El Segundo coast and beyond</p>
            <h1 id="series-title">Beach <span>Commons</span></h1>
            <p class="hero__dek">{BEACH_COMMONS_SERIES.subtitle}</p>
          </div>
          <div class="hero__stats" aria-label="Series at a glance">
            <div><strong>{editionCount}</strong><span>Field editions</span></div>
            <div><strong>5</strong><span>Ways inside</span></div>
            <div><strong>1</strong><span>Evolving commons</span></div>
          </div>
        </div>

        <div class="hero__visual">
          <img
            src={currentEdition.image}
            alt={currentEdition.alt}
            width="1024"
            height="1536"
            fetchpriority="high"
          />
          <div class="hero__current">
            <div>
              <p class="edition-label">Current field study · V{currentEdition.edition.toString().padStart(2, '0')}</p>
              <h2>{currentEdition.title}</h2>
              <p class="current-dek">{currentEdition.subtitle}</p>
            </div>
            <a class="arrow-link" href={beachCommonsEditionUrl(currentEdition)}>
              Enter V{currentEdition.edition.toString().padStart(2, '0')} →
            </a>
          </div>
        </div>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
          {BEACH_COMMONS_EDITIONS.map((edition) => <span>V{edition.edition.toString().padStart(2, '0')} · {edition.title}</span>)}
          {BEACH_COMMONS_EDITIONS.map((edition) => <span>V{edition.edition.toString().padStart(2, '0')} · {edition.title}</span>)}
        </div>
      </div>

      <section class="paths" id="paths" aria-labelledby="paths-title">
        <div class="section-head">
          <div>
            <p class="section-kicker">Do not start with chronology</p>
            <h2 id="paths-title">Choose your way in.</h2>
          </div>
          <p class="section-head__copy">
            Beach Commons began as a shelter question and kept widening. Pick the
            kind of day you want: build it, make with the weather, bring the
            useful kit, read the coast, or connect the larger regional ring.
          </p>
        </div>

        <div class="path-grid" aria-label="Filter editions by path">
          {BEACH_COMMONS_PATHS.map((path) => (
            <button
              class="path"
              type="button"
              data-filter={path.id}
              aria-pressed="false"
              style={`--path-color:${path.color}`}
            >
              <span class="path__number">{path.number}</span>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <span class="path__count">
                {BEACH_COMMONS_EDITIONS.filter((edition) => edition.path === path.id).length} editions ↘
              </span>
            </button>
          ))}
        </div>

        <div class="filter-actions">
          <button type="button" data-filter="all" aria-pressed="true">Show all {editionCount}</button>
          <button type="button" id="random-edition">Surprise me ↗</button>
          <p class="filter-status" id="filter-status" aria-live="polite">Showing all {editionCount} editions.</p>
        </div>
      </section>

      <section class="handoff" aria-labelledby="handoff-title">
        <div class="handoff__title">
          <p class="section-kicker">The current handoff</p>
          <h2 id="handoff-title">Foundation → room → proof → radius.</h2>
        </div>
        <div class="handoff__line">
          <a href="/beach-commons/v1">
            <span>V01 · The premise</span>
            <div><strong>Hardpoint + Softkit</strong><p>One storm-tough center and rooms people can carry.</p></div>
          </a>
          <a href="/beach-commons/v14">
            <span>V14 · The architecture</span>
            <div><strong>The Hardpoint League</strong><p>Six temporary material houses compete from one common chassis.</p></div>
          </a>
          <a href="/beach-commons/v15">
            <span>V15 · The equipment</span>
            <div><strong>The Good Gear</strong><p>Fifteen objects prove what deserves to move between the rooms.</p></div>
          </a>
          <a href="/beach-commons/v18">
            <span>V18 · The regional field</span>
            <div><strong>Radius 25</strong><p>Eight existing strengths become twelve working pairs and forty ways to start.</p></div>
          </a>
        </div>
      </section>

      <section class="editions" id="editions" aria-label="Beach Commons editions">
        <div class="edition-grid" id="edition-grid">
          {[...BEACH_COMMONS_EDITIONS].reverse().map((edition) => {
            const path = pathMap.get(edition.path);
            return (
              <article
                class:list={['edition-card', { current: edition.current }]}
                data-path={edition.path}
                data-edition-url={beachCommonsEditionUrl(edition)}
                style={`--path-color:${path?.color ?? '#f06a3a'}`}
              >
                <a href={beachCommonsEditionUrl(edition)}>
                  <div class="edition-card__media">
                    <img
                      src={edition.image}
                      alt={edition.alt}
                      width="1536"
                      height="1024"
                      loading={edition.current ? 'eager' : 'lazy'}
                    />
                    {edition.current && <span class="edition-card__badge">Current</span>}
                  </div>
                  <div class="edition-card__body">
                    <div class="edition-card__meta">
                      <span>V{edition.edition.toString().padStart(2, '0')} · {path?.shortTitle}</span>
                      <span>{edition.measure}</span>
                    </div>
                    <h3>{edition.title}</h3>
                    <p class="edition-card__subtitle">{edition.subtitle}</p>
                    <p class="edition-card__invitation">{edition.invitation}</p>
                    <span class="edition-card__enter">
                      <span>Enter field study</span>
                      <span aria-hidden="true">↗</span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>

      <section class="spine" aria-labelledby="spine-title">
        <div class="spine__top">
          <div>
            <p class="section-kicker">The complete line</p>
            <h2 id="spine-title">V01 → V{currentEdition.edition.toString().padStart(2, '0')}</h2>
          </div>
          <a class="arrow-link" href="/beach-commons/v1">Begin at Hardpoint + Softkit →</a>
        </div>
        <nav class="spine__rail" aria-label="All Beach Commons editions in order">
          {BEACH_COMMONS_EDITIONS.map((edition) => (
            <a
              href={beachCommonsEditionUrl(edition)}
              aria-current={edition.current ? 'page' : undefined}
              title={edition.title}
            >
              {edition.edition.toString().padStart(2, '0')}
            </a>
          ))}
        </nav>
      </section>

      <section class="manifesto" aria-label="Beach Commons editorial position">
        <article class="manifesto__panel">
          <p class="section-kicker">What this is</p>
          <h2>Public life as a design material.</h2>
          <p>
            Every edition asks how people might shelter, play, make, listen,
            repair, notice, or pass something hand to hand near the water.
            Buildings matter, but coordination is the real superstructure.
          </p>
          <p>
            The pages are meant to be entered: open the plates, sort a boat,
            score a shoreline, rehearse a relay, compute a group kit, or simply
            choose one good idea for a future conversation.
          </p>
        </article>
        <article class="manifesto__panel manifesto__panel--dark">
          <p class="section-kicker">The honest edge</p>
          <h2>Imagine fully. Claim carefully.</h2>
          <p>{BEACH_COMMONS_SERIES.status}</p>
          <p>
            Edition-specific pages carry the real boundaries: public access,
            habitat, fire, food, radio, water, ownership, engineering,
            accessibility, product, and restoration limits travel with the idea.
          </p>
        </article>
      </section>

      <nav class="closing-links" aria-label="Beach Commons closing links">
        <a href={beachCommonsEditionUrl(currentEdition)}>
          <span>Current edition · V{currentEdition.edition.toString().padStart(2, '0')}</span>
          <strong>Enter {currentEdition.title} ↗</strong>
        </a>
        <a href="/beach-commons/v1">
          <span>Original field study · V01</span>
          <strong>Begin with the shelter ↗</strong>
        </a>
        <a href={BEACH_COMMONS_SERIES.jsonUrl}>
          <span>Machine-readable series</span>
          <strong>Open the complete index ↗</strong>
        </a>
      </nav>
    </main>

    <footer>
      <span>Michael Hoydich + Codex / OpenAI · PointCast · 2026</span>
      <nav aria-label="Footer links">
        <a href="/">PointCast home</a>
        <a href="/c/garden">Garden channel</a>
        <a href="/beach-commons.json">JSON</a>
      </nav>
    </footer>

    <script is:inline>
      const filterButtons = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-path]')];
      const status = document.querySelector('#filter-status');
      const randomButton = document.querySelector('#random-edition');
      const labels = {
        build: 'Build Together',
        make: 'Make Weather',
        kit: 'Bring a Kit',
        coast: 'Read the Coast',
      };

      const applyFilter = (filter) => {
        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
        });
        let visible = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.path === filter;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (status) {
          status.textContent =
            filter === 'all'
              ? 'Showing all fifteen editions.'
              : `Showing ${visible} ${labels[filter] ?? ''} editions.`;
        }
        document.querySelector('#editions')?.scrollIntoView({ block: 'start' });
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
      });

      randomButton?.addEventListener('click', () => {
        const choices = cards.filter((card) => !card.hidden);
        const choice = choices[Math.floor(Math.random() * choices.length)];
        const url = choice?.dataset.editionUrl;
        if (url) window.location.assign(url);
      });
    </script>
  </body>
</html>
