---
import BlockLayout from '../layouts/BlockLayout.astro';
import { QUIET_HOUR_ROOMS, QUIET_HOURS_RELEASE, pickPromptForDate } from '../lib/quietHours';

const title = 'Quiet Hours';
const description = 'Five painted rooms across the day. Your local hour opens the room: stand, walk, watch, write, or rest.';
const canonical = 'https://pointcast.xyz/quiet-hours';

const roomColors = (room: (typeof QUIET_HOUR_ROOMS)[number]) => {
  const colors = Object.values(room.accent);
  return {
    a: colors[0] ?? '#b9c0c8',
    b: colors[1] ?? '#9ddc67',
    c: colors[2] ?? '#d7a777',
    d: colors[3] ?? '#fff5e1',
  };
};

const roomStyle = (room: (typeof QUIET_HOUR_ROOMS)[number]) => {
  const colors = roomColors(room);
  return `--accent-a: ${colors.a}; --accent-b: ${colors.b}; --accent-c: ${colors.c}; --accent-d: ${colors.d};`;
};

const clientPayload = {
  release: QUIET_HOURS_RELEASE,
  rooms: QUIET_HOUR_ROOMS,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  name: 'Quiet Hours',
  description,
  url: canonical,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://pointcast.xyz/#website',
    name: 'PointCast',
  },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Quiet Hours rooms',
    itemListElement: QUIET_HOUR_ROOMS.map((room, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        '@id': `${canonical}#${room.id}`,
        name: `${room.name} · ${room.subtitle}`,
        image: `https://pointcast.xyz${room.image}`,
        description: room.practice,
        temporalCoverage: room.hourBand,
        keywords: [room.postureVerb, room.practice, 'quiet hours', 'painted room'],
      },
    })),
  },
};
---

<BlockLayout
  title={title}
  description={description}
  image="/quiet-hours/03-conservatory.png"
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/quiet-hours.json', title: 'Quiet Hours (JSON)' }]}
>
  <main class="qh" id="quiet-hours-app" data-mode="now" data-room="tower" style={roomStyle(QUIET_HOUR_ROOMS[0])}>
    <nav class="qh__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>quiet-hours</span>
    </nav>

    <header class="qh__top">
      <div class="qh__title-lockup">
        <p class="qh__kicker mono">QUIET HOURS · FIVE PAINTED ROOMS</p>
        <h1>Quiet Hours</h1>
      </div>
      <div class="qh__status" aria-label="Local time">
        <span id="qh-clock">--:--</span>
        <span id="qh-zone">local time</span>
      </div>
    </header>

    <div class="qh__tabs" role="tablist" aria-label="Quiet Hours views">
      <button type="button" class="qh__tab is-active" role="tab" aria-selected="true" data-mode-tab="now">Now</button>
      <button type="button" class="qh__tab" role="tab" aria-selected="false" data-mode-tab="browse">Browse</button>
      <button type="button" class="qh__tab" role="tab" aria-selected="false" data-mode-tab="spread">Spread</button>
      <button type="button" class="qh__ambient" id="qh-audio-toggle">Ambient off</button>
      <button type="button" class="qh__share" id="qh-share-hour">Copy hour</button>
    </div>

    <section class="qh__now view view--now" data-view="now" aria-labelledby="qh-room-title">
      <figure class="qh__painting-shell" id="qh-painting-shell">
        <img id="qh-painting" src={QUIET_HOUR_ROOMS[0].image} alt={`${QUIET_HOUR_ROOMS[0].name} painting`} decoding="async" fetchpriority="high" />
        <div class="qh__grain" aria-hidden="true"></div>
        <div class="qh__vignette" aria-hidden="true"></div>
        <figcaption class="qh__plaque">
          <span id="qh-plaque-roman">{QUIET_HOUR_ROOMS[0].romanNumeral}</span>
          <strong id="qh-plaque-name">{QUIET_HOUR_ROOMS[0].name}</strong>
          <span id="qh-plaque-band">{QUIET_HOUR_ROOMS[0].hourBand}</span>
        </figcaption>
      </figure>

      <article class="qh__room">
        <div class="qh__room-head">
          <div>
            <p class="qh__eyebrow mono" id="qh-hour-label">Morning room</p>
            <h2 id="qh-room-title">{QUIET_HOUR_ROOMS[0].name}</h2>
          </div>
          <p class="qh__posture" id="qh-posture">{QUIET_HOUR_ROOMS[0].postureVerb}</p>
        </div>

        <p class="qh__lead" id="qh-lead">{QUIET_HOUR_ROOMS[0].lead}</p>

        <blockquote class="qh__prompt">
          <span class="mono">TODAY'S PROMPT</span>
          <p id="qh-prompt">{pickPromptForDate(QUIET_HOUR_ROOMS[0])}</p>
        </blockquote>

        <div class="qh__progress" aria-label="Hour progress">
          <div class="qh__progress-head">
            <span class="mono" id="qh-progress-label">0:00 into the hour-band</span>
            <span class="mono" id="qh-next-room">Next room --</span>
          </div>
          <div class="qh__progress-track"><span id="qh-progress-fill"></span></div>
        </div>

        <div class="qh__timer" aria-label="Sit timer">
          <div class="qh__timer-display" id="qh-timer-display">05:00</div>
          <div class="qh__durations" role="group" aria-label="Timer duration">
            {[5, 10, 20, 45].map((duration) => (
              <button type="button" class:list={['qh__duration', { 'is-active': duration === 5 }]} data-duration={duration}>
                {duration}
              </button>
            ))}
          </div>
          <div class="qh__timer-actions">
            <button type="button" id="qh-timer-toggle">Start sit</button>
            <button type="button" id="qh-timer-reset">Reset</button>
          </div>
        </div>

        <div class="qh__counters" aria-live="polite">
          <span id="qh-week-room">0 minutes sat here this week</span>
          <span id="qh-streak">0 day streak · 0 total sits</span>
          <span id="qh-seen">1 of 5 rooms visited</span>
        </div>

        <div class="qh__tools" aria-label="Room tools">
          <a id="qh-cross-link" href={QUIET_HOUR_ROOMS[0].crossLink.href}>{QUIET_HOUR_ROOMS[0].crossLink.label}</a>
          <button type="button" id="qh-copy-link">Copy room link</button>
        </div>

        <div class="qh__palette" id="qh-palette" aria-label="Accent palette">
          {Object.entries(QUIET_HOUR_ROOMS[0].accent).map(([name, color]) => (
            <span style={`--swatch: ${color};`} title={name}></span>
          ))}
        </div>
      </article>
    </section>

    <section class="qh__browse view view--browse" data-view="browse" aria-label="Browse the day-line">
      <div class="qh__section-head">
        <p class="qh__kicker mono">DAY-LINE</p>
        <h2>Five rooms, one day.</h2>
      </div>
      <div class="qh__dayline" role="list">
        {QUIET_HOUR_ROOMS.map((room) => (
          <button type="button" class="qh__dayline-room" role="listitem" data-room-action={room.id} style={roomStyle(room)}>
            <span class="qh__thumb"><img src={room.image} alt="" loading="lazy" decoding="async" /></span>
            <span class="qh__dayline-meta">
              <span class="mono">{room.romanNumeral} · {room.hourBand}</span>
              <strong>{room.name}</strong>
              <em>{room.postureVerb}</em>
            </span>
          </button>
        ))}
      </div>
      <aside class="qh__next-card" id="qh-next-card" style={roomStyle(QUIET_HOUR_ROOMS[1])}>
        <span class="mono">COMING NEXT</span>
        <strong>{QUIET_HOUR_ROOMS[1].name} · {QUIET_HOUR_ROOMS[1].subtitle}</strong>
        <p>{QUIET_HOUR_ROOMS[1].practice}</p>
      </aside>
    </section>

    <section class="qh__spread view view--spread" data-view="spread" aria-label="Quiet Hours spread">
      <div class="qh__section-head">
        <p class="qh__kicker mono">SPREAD</p>
        <h2>The whole day at once.</h2>
      </div>
      <div class="qh__spread-grid">
        {QUIET_HOUR_ROOMS.map((room) => (
          <article class="qh__spread-card" id={room.id} style={roomStyle(room)}>
            <button type="button" data-room-action={room.id} aria-label={`Enter ${room.name}`}>
              <span class="qh__corner qh__corner--tl">{room.romanNumeral}</span>
              <span class="qh__corner qh__corner--br">{room.romanNumeral}</span>
              <img src={room.image} alt={`${room.name} painting`} loading="lazy" decoding="async" />
              <span class="qh__spread-copy">
                <span class="mono">{room.hourBand} · {room.postureVerb}</span>
                <strong>{room.name}</strong>
                <em>{room.practice}</em>
              </span>
            </button>
            <a class="qh__spread-link" href={room.crossLink.href}>{room.crossLink.label}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="qh__daily" aria-label="Today's spread">
      <div>
        <p class="qh__kicker mono">TODAY'S SPREAD</p>
        <h2 id="qh-focus-room">Five rooms are open.</h2>
      </div>
      <ol id="qh-daily-prompts">
        {QUIET_HOUR_ROOMS.map((room) => (
          <li>
            <span class="mono">{room.romanNumeral}</span>
            <p>{pickPromptForDate(room)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="qh__journal" aria-label="Quiet Hours journal">
      <div class="qh__scratch">
        <label for="qh-note" class="mono">ROOM NOTE</label>
        <textarea id="qh-note" rows="4" maxlength="600" placeholder="One line from this room."></textarea>
        <p id="qh-note-status" class="mono">saved locally</p>
      </div>
      <div class="qh__receipts">
        <p class="mono">RECENT SITS</p>
        <ol id="qh-receipts">
          <li>No sits logged on this device yet.</li>
        </ol>
      </div>
    </section>

    <script type="application/json" id="quiet-hours-data" is:inline set:html={JSON.stringify(clientPayload)}></script>
  </main>
</BlockLayout>

<script is:inline>
  (function () {
    'use strict';

    var dataNode = document.getElementById('quiet-hours-data');
    if (!dataNode) return;
    var data = JSON.parse(dataNode.textContent || '{}');
    var rooms = data.rooms || [];
    var release = data.release || {};
    var roomById = {};
    rooms.forEach(function (room) { roomById[room.id] = room; });

    var JOURNAL_KEY = release.journalKey || 'pointcast.quiet-hours.journal.v1';
    var VISITED_KEY = release.visitedKey || 'pointcast.quiet-hours.visited.v1';
    var NOTE_KEY = 'pointcast.quiet-hours.notes.v1';
    var MODE_KEY = 'pointcast.quiet-hours.mode.v1';

    var state = {
      mode: 'now',
      roomId: rooms[0] && rooms[0].id,
      realRoomId: rooms[0] && rooms[0].id,
      lockToNow: true,
      durationMin: 5,
      remainingMs: 5 * 60 * 1000,
      timerRunning: false,
      timerStartedAt: 0,
      timerInterval: 0,
      audioOn: false,
      audio: null,
      latestPrompt: '',
    };

    var els = {
      app: document.getElementById('quiet-hours-app'),
      clock: document.getElementById('qh-clock'),
      zone: document.getElementById('qh-zone'),
      tabs: Array.prototype.slice.call(document.querySelectorAll('[data-mode-tab]')),
      views: Array.prototype.slice.call(document.querySelectorAll('[data-view]')),
      paintingShell: document.getElementById('qh-painting-shell'),
      painting: document.getElementById('qh-painting'),
      plaqueRoman: document.getElementById('qh-plaque-roman'),
      plaqueName: document.getElementById('qh-plaque-name'),
      plaqueBand: document.getElementById('qh-plaque-band'),
      hourLabel: document.getElementById('qh-hour-label'),
      roomTitle: document.getElementById('qh-room-title'),
      posture: document.getElementById('qh-posture'),
      lead: document.getElementById('qh-lead'),
      prompt: document.getElementById('qh-prompt'),
      progressLabel: document.getElementById('qh-progress-label'),
      progressFill: document.getElementById('qh-progress-fill'),
      nextRoom: document.getElementById('qh-next-room'),
      timerDisplay: document.getElementById('qh-timer-display'),
      timerToggle: document.getElementById('qh-timer-toggle'),
      timerReset: document.getElementById('qh-timer-reset'),
      durations: Array.prototype.slice.call(document.querySelectorAll('[data-duration]')),
      weekRoom: document.getElementById('qh-week-room'),
      streak: document.getElementById('qh-streak'),
      seen: document.getElementById('qh-seen'),
      crossLink: document.getElementById('qh-cross-link'),
      palette: document.getElementById('qh-palette'),
      audioToggle: document.getElementById('qh-audio-toggle'),
      shareHour: document.getElementById('qh-share-hour'),
      copyLink: document.getElementById('qh-copy-link'),
      nextCard: document.getElementById('qh-next-card'),
      focusRoom: document.getElementById('qh-focus-room'),
      dailyPrompts: document.getElementById('qh-daily-prompts'),
      note: document.getElementById('qh-note'),
      noteStatus: document.getElementById('qh-note-status'),
      receipts: document.getElementById('qh-receipts'),
    };

    function hash32(str) {
      var h = 2166136261;
      for (var i = 0; i < str.length; i += 1) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }

    function localDateKey(date) {
      var y = date.getFullYear();
      var m = String(date.getMonth() + 1).padStart(2, '0');
      var d = String(date.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + d;
    }

    function promptFor(room, date) {
      var index = hash32(localDateKey(date) + ':' + room.id) % room.prompts.length;
      return room.prompts[index];
    }

    function isHourInRoom(hour, room) {
      var h = ((Math.floor(hour) % 24) + 24) % 24;
      if (room.startHour < room.endHour) return h >= room.startHour && h < room.endHour;
      return h >= room.startHour || h < room.endHour;
    }

    function pickRoom(date) {
      var hour = date.getHours();
      return rooms.find(function (room) { return isHourInRoom(hour, room); }) || rooms[0];
    }

    function nextRoom(room) {
      var index = rooms.findIndex(function (item) { return item.id === room.id; });
      return rooms[(index + 1 + rooms.length) % rooms.length] || rooms[0];
    }

    function previousRoom(room) {
      var index = rooms.findIndex(function (item) { return item.id === room.id; });
      return rooms[(index - 1 + rooms.length) % rooms.length] || rooms[0];
    }

    function colorList(room) {
      return Object.keys(room.accent).map(function (key) {
        return { name: key, value: room.accent[key] };
      });
    }

    function applyRoomVars(room, target) {
      var colors = colorList(room);
      var node = target || els.app;
      if (!node) return;
      node.style.setProperty('--accent-a', (colors[0] && colors[0].value) || '#b9c0c8');
      node.style.setProperty('--accent-b', (colors[1] && colors[1].value) || '#9ddc67');
      node.style.setProperty('--accent-c', (colors[2] && colors[2].value) || '#d7a777');
      node.style.setProperty('--accent-d', (colors[3] && colors[3].value) || '#fff5e1');
    }

    function formatClock(date) {
      return new Intl.DateTimeFormat([], { hour: 'numeric', minute: '2-digit' }).format(date);
    }

    function formatBandStart(hour) {
      var d = new Date();
      d.setHours(hour, 0, 0, 0);
      return new Intl.DateTimeFormat([], { hour: 'numeric' }).format(d);
    }

    function roomBandDates(room, now) {
      var start = new Date(now);
      start.setHours(room.startHour, 0, 0, 0);
      var end = new Date(now);
      end.setHours(room.endHour, 0, 0, 0);
      if (room.startHour >= room.endHour) {
        if (now.getHours() < room.endHour) start.setDate(start.getDate() - 1);
        else end.setDate(end.getDate() + 1);
      }
      return { start: start, end: end };
    }

    function formatElapsed(ms) {
      var totalMin = Math.max(0, Math.floor(ms / 60000));
      var hours = Math.floor(totalMin / 60);
      var min = totalMin % 60;
      return hours + ':' + String(min).padStart(2, '0');
    }

    function formatTimer(ms) {
      var total = Math.max(0, Math.ceil(ms / 1000));
      var min = Math.floor(total / 60);
      var sec = total % 60;
      return String(min).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    }

    function safeJsonLoad(key, fallback) {
      try {
        var raw = localStorage.getItem(key);
        if (!raw) return fallback;
        return JSON.parse(raw);
      } catch (e) {
        return fallback;
      }
    }

    function safeJsonSave(key, value) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {}
    }

    function setMode(mode) {
      state.mode = mode;
      try { localStorage.setItem(MODE_KEY, mode); } catch (e) {}
      if (els.app) els.app.dataset.mode = mode;
      els.tabs.forEach(function (tab) {
        var active = tab.dataset.modeTab === mode;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      els.views.forEach(function (view) {
        view.hidden = view.dataset.view !== mode;
      });
      updateUrl();
    }

    function updateUrl() {
      if (!history.replaceState) return;
      var params = new URLSearchParams();
      if (state.mode !== 'now') params.set('mode', state.mode);
      if (!state.lockToNow && state.roomId) params.set('room', state.roomId);
      var query = params.toString();
      var next = window.location.pathname + (query ? '?' + query : '');
      history.replaceState(null, '', next);
    }

    function markVisited(roomId) {
      var visited = safeJsonLoad(VISITED_KEY, {});
      visited[roomId] = new Date().toISOString();
      safeJsonSave(VISITED_KEY, visited);
    }

    function enterRoom(roomId, lockToNow) {
      var room = roomById[roomId] || rooms[0];
      var prior = state.roomId;
      state.roomId = room.id;
      state.lockToNow = !!lockToNow;
      state.latestPrompt = promptFor(room, new Date());
      markVisited(room.id);
      if (els.app) els.app.dataset.room = room.id;
      if (prior !== room.id && els.paintingShell) {
        els.paintingShell.classList.remove('is-crossfading');
        void els.paintingShell.offsetWidth;
        els.paintingShell.classList.add('is-crossfading');
      }
      renderRoom();
      renderStats();
      renderNotes();
      if (state.audioOn && state.audio) state.audio.setRoom(room.id);
      updateUrl();
    }

    function renderRoom() {
      var room = roomById[state.roomId] || rooms[0];
      var next = nextRoom(room);
      applyRoomVars(room);
      if (els.painting) {
        els.painting.src = room.image;
        els.painting.alt = room.name + ' painting';
      }
      if (els.plaqueRoman) els.plaqueRoman.textContent = room.romanNumeral;
      if (els.plaqueName) els.plaqueName.textContent = room.name;
      if (els.plaqueBand) els.plaqueBand.textContent = room.hourBand;
      if (els.hourLabel) els.hourLabel.textContent = formatClock(new Date()) + ' · ' + room.name + ' hour';
      if (els.roomTitle) els.roomTitle.textContent = room.name + ' · ' + room.subtitle;
      if (els.posture) els.posture.textContent = room.postureVerb;
      if (els.lead) els.lead.textContent = room.lead;
      if (els.prompt) els.prompt.textContent = state.latestPrompt;
      if (els.crossLink) {
        els.crossLink.href = room.crossLink.href;
        els.crossLink.textContent = room.crossLink.label;
      }
      if (els.palette) {
        els.palette.innerHTML = colorList(room).map(function (color) {
          return '<span style="--swatch:' + color.value + ';" title="' + color.name + '"></span>';
        }).join('');
      }
      if (els.nextRoom) {
        els.nextRoom.textContent = 'Coming at ' + formatBandStart(next.startHour) + ': ' + next.name;
      }
      if (els.nextCard) {
        applyRoomVars(next, els.nextCard);
        els.nextCard.innerHTML = '<span class="mono">COMING NEXT</span><strong>' + formatBandStart(next.startHour) + ': ' + next.name + ' · ' + next.subtitle + '</strong><p>' + next.practice + '</p>';
      }
      document.querySelectorAll('[data-room-action]').forEach(function (node) {
        node.classList.toggle('is-selected', node.dataset.roomAction === room.id);
        node.classList.toggle('is-current', node.dataset.roomAction === state.realRoomId);
      });
    }

    function renderClock() {
      var now = new Date();
      var real = pickRoom(now);
      var priorReal = state.realRoomId;
      state.realRoomId = real.id;
      if (els.clock) els.clock.textContent = formatClock(now);
      if (els.zone) {
        var zone = 'local time';
        try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || zone; } catch (e) {}
        els.zone.textContent = zone;
      }
      if (els.hourLabel) {
        var room = roomById[state.roomId] || real;
        els.hourLabel.textContent = formatClock(now) + ' · ' + room.name + ' hour';
      }
      if (state.lockToNow && priorReal && priorReal !== real.id) {
        enterRoom(real.id, true);
      }
      renderProgress(now);
      document.querySelectorAll('[data-room-action]').forEach(function (node) {
        node.classList.toggle('is-current', node.dataset.roomAction === state.realRoomId);
      });
    }

    function renderProgress(now) {
      var room = roomById[state.roomId] || pickRoom(now);
      var band = roomBandDates(room, now);
      var elapsed = Math.max(0, now.getTime() - band.start.getTime());
      var total = Math.max(1, band.end.getTime() - band.start.getTime());
      var ratio = Math.max(0, Math.min(1, elapsed / total));
      if (els.progressFill) els.progressFill.style.width = Math.round(ratio * 100) + '%';
      if (els.progressLabel) {
        els.progressLabel.textContent = formatElapsed(elapsed) + ' of ' + formatElapsed(total) + ' hours into the ' + room.name;
      }
    }

    function journal() {
      var entries = safeJsonLoad(JOURNAL_KEY, []);
      return Array.isArray(entries) ? entries : [];
    }

    function localDayFromIso(iso) {
      var d = new Date(iso);
      return localDateKey(d);
    }

    function computeStreak(entries) {
      var days = {};
      entries.forEach(function (entry) { days[localDayFromIso(entry.date)] = true; });
      var count = 0;
      var cursor = new Date();
      while (days[localDateKey(cursor)]) {
        count += 1;
        cursor.setDate(cursor.getDate() - 1);
      }
      return count;
    }

    function renderStats() {
      var entries = journal();
      var now = Date.now();
      var weekStart = now - 7 * 24 * 60 * 60 * 1000;
      var room = roomById[state.roomId] || rooms[0];
      var roomWeekMin = entries.reduce(function (total, entry) {
        if (entry.room === room.id && new Date(entry.date).getTime() >= weekStart) return total + Number(entry.durationMin || 0);
        return total;
      }, 0);
      var roomWeekHours = roomWeekMin >= 60 ? (roomWeekMin / 60).toFixed(roomWeekMin % 60 === 0 ? 0 : 1) + ' hours' : roomWeekMin + ' minutes';
      if (els.weekRoom) els.weekRoom.textContent = roomWeekHours + ' sat in the ' + room.name + ' this week';
      if (els.streak) els.streak.textContent = computeStreak(entries) + ' day streak · ' + entries.length + ' total sits';
      var visited = safeJsonLoad(VISITED_KEY, {});
      var seenCount = rooms.filter(function (item) { return visited[item.id]; }).length;
      if (els.seen) els.seen.textContent = seenCount + ' of ' + rooms.length + ' rooms visited';
      renderReceipts(entries);
    }

    function renderReceipts(entries) {
      if (!els.receipts) return;
      if (!entries.length) {
        els.receipts.innerHTML = '<li>No sits logged on this device yet.</li>';
        return;
      }
      els.receipts.innerHTML = entries.slice(-6).reverse().map(function (entry) {
        var room = roomById[entry.room] || { name: entry.room };
        var when = new Intl.DateTimeFormat([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(entry.date));
        return '<li><span class="mono">' + when + '</span><strong>' + room.name + '</strong><em>' + entry.durationMin + ' min · ' + entry.postureVerb + '</em></li>';
      }).join('');
    }

    function renderDailySpread() {
      var today = new Date();
      var focus = rooms[hash32(localDateKey(today) + ':focus') % rooms.length];
      if (els.focusRoom) els.focusRoom.textContent = 'Today leans toward ' + focus.name + '.';
      if (!els.dailyPrompts) return;
      els.dailyPrompts.innerHTML = rooms.map(function (room) {
        var active = room.id === focus.id ? ' class="is-focus"' : '';
        return '<li' + active + '><span class="mono">' + room.romanNumeral + '</span><p>' + promptFor(room, today) + '</p></li>';
      }).join('');
    }

    function renderNotes() {
      if (!els.note) return;
      var notes = safeJsonLoad(NOTE_KEY, {});
      var key = localDateKey(new Date()) + ':' + state.roomId;
      els.note.value = notes[key] || '';
      if (els.noteStatus) els.noteStatus.textContent = 'saved locally';
    }

    function saveNote() {
      if (!els.note) return;
      var notes = safeJsonLoad(NOTE_KEY, {});
      var key = localDateKey(new Date()) + ':' + state.roomId;
      notes[key] = els.note.value;
      safeJsonSave(NOTE_KEY, notes);
      if (els.noteStatus) {
        els.noteStatus.textContent = 'saved ' + formatClock(new Date());
      }
    }

    function setDuration(min) {
      state.durationMin = min;
      state.remainingMs = min * 60 * 1000;
      state.timerRunning = false;
      clearInterval(state.timerInterval);
      state.timerInterval = 0;
      els.durations.forEach(function (btn) {
        btn.classList.toggle('is-active', Number(btn.dataset.duration) === min);
      });
      renderTimer();
    }

    function renderTimer() {
      if (els.timerDisplay) els.timerDisplay.textContent = formatTimer(state.remainingMs);
      if (els.timerToggle) els.timerToggle.textContent = state.timerRunning ? 'Pause sit' : (state.remainingMs < state.durationMin * 60 * 1000 ? 'Resume sit' : 'Start sit');
    }

    function tickTimer() {
      if (!state.timerRunning) return;
      var elapsed = Date.now() - state.timerStartedAt;
      state.timerStartedAt = Date.now();
      state.remainingMs = Math.max(0, state.remainingMs - elapsed);
      renderTimer();
      if (state.remainingMs <= 0) completeSit();
    }

    function toggleTimer() {
      if (state.timerRunning) {
        state.timerRunning = false;
        clearInterval(state.timerInterval);
        state.timerInterval = 0;
        renderTimer();
        return;
      }
      state.timerRunning = true;
      state.timerStartedAt = Date.now();
      clearInterval(state.timerInterval);
      state.timerInterval = window.setInterval(tickTimer, 250);
      renderTimer();
    }

    function resetTimer() {
      state.timerRunning = false;
      clearInterval(state.timerInterval);
      state.timerInterval = 0;
      state.remainingMs = state.durationMin * 60 * 1000;
      renderTimer();
    }

    function completeSit() {
      state.timerRunning = false;
      clearInterval(state.timerInterval);
      state.timerInterval = 0;
      var room = roomById[state.roomId] || rooms[0];
      var entries = journal();
      entries.push({
        date: new Date().toISOString(),
        room: room.id,
        durationMin: state.durationMin,
        postureVerb: room.postureVerb,
        promptShown: state.latestPrompt,
      });
      safeJsonSave(JOURNAL_KEY, entries.slice(-500));
      state.remainingMs = state.durationMin * 60 * 1000;
      renderTimer();
      renderStats();
    }

    function shareText() {
      var room = roomById[state.roomId] || rooms[0];
      return 'Quiet Hours: ' + room.name + ' · ' + room.postureVerb.toUpperCase() + '. ' + state.latestPrompt + ' https://pointcast.xyz/quiet-hours?room=' + room.id;
    }

    function copyText(text, button, doneLabel) {
      var restore = button ? button.textContent : '';
      function done() {
        if (!button) return;
        button.textContent = doneLabel || 'Copied';
        window.setTimeout(function () { button.textContent = restore; }, 1300);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        done();
      }
    }

    function QuietAudio() {
      this.ctx = null;
      this.master = null;
      this.roomId = state.roomId;
      this.timeout = 0;
      this.running = false;
    }

    QuietAudio.prototype.start = function () {
      var AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return;
      if (!this.ctx) {
        this.ctx = new AudioContext();
        this.master = this.ctx.createGain();
        this.master.gain.value = 0.05;
        this.master.connect(this.ctx.destination);
      }
      var self = this;
      this.ctx.resume().then(function () {
        self.running = true;
        self.schedule(120);
      });
    };

    QuietAudio.prototype.stop = function () {
      this.running = false;
      window.clearTimeout(this.timeout);
      if (this.master && this.ctx) {
        this.master.gain.cancelScheduledValues(this.ctx.currentTime);
        this.master.gain.setTargetAtTime(0.0001, this.ctx.currentTime, 0.08);
      }
    };

    QuietAudio.prototype.setRoom = function (roomId) {
      this.roomId = roomId;
      if (this.master && this.ctx && this.running) {
        this.master.gain.cancelScheduledValues(this.ctx.currentTime);
        this.master.gain.setTargetAtTime(0.05, this.ctx.currentTime, 0.16);
      }
    };

    QuietAudio.prototype.noiseBuffer = function (seconds) {
      var length = Math.max(1, Math.floor(this.ctx.sampleRate * seconds));
      var buffer = this.ctx.createBuffer(1, length, this.ctx.sampleRate);
      var data = buffer.getChannelData(0);
      for (var i = 0; i < length; i += 1) data[i] = Math.random() * 2 - 1;
      return buffer;
    };

    QuietAudio.prototype.burst = function (duration, filterType, freq, q, gainValue) {
      if (!this.ctx || !this.master) return;
      var t = this.ctx.currentTime;
      var source = this.ctx.createBufferSource();
      var filter = this.ctx.createBiquadFilter();
      var gain = this.ctx.createGain();
      source.buffer = this.noiseBuffer(duration);
      filter.type = filterType;
      filter.frequency.value = freq;
      filter.Q.value = q;
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(gainValue, t + 0.03);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
      source.connect(filter);
      filter.connect(gain);
      gain.connect(this.master);
      source.start(t);
      source.stop(t + duration + 0.02);
    };

    QuietAudio.prototype.tone = function (duration, type, freq, gainValue) {
      if (!this.ctx || !this.master) return;
      var t = this.ctx.currentTime;
      var osc = this.ctx.createOscillator();
      var gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, t);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(gainValue, t + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
      osc.connect(gain);
      gain.connect(this.master);
      osc.start(t);
      osc.stop(t + duration + 0.02);
    };

    QuietAudio.prototype.playRoom = function () {
      var roomId = this.roomId;
      if (roomId === 'tower') this.burst(1.4, 'bandpass', 900 + Math.random() * 500, 0.8, 0.035);
      else if (roomId === 'library') this.burst(0.18, 'bandpass', 1700 + Math.random() * 900, 1.2, 0.028);
      else if (roomId === 'conservatory') this.tone(0.08, 'triangle', 4200 + Math.random() * 1200, 0.012);
      else if (roomId === 'study') this.burst(0.22, 'highpass', 1900 + Math.random() * 800, 0.6, 0.02);
      else this.burst(0.12, 'lowpass', 420 + Math.random() * 280, 0.7, 0.025);
    };

    QuietAudio.prototype.schedule = function (delay) {
      var self = this;
      if (!this.running) return;
      window.clearTimeout(this.timeout);
      this.timeout = window.setTimeout(function () {
        if (!self.running) return;
        self.playRoom();
        var roomId = self.roomId;
        var nextDelay = 2400 + Math.random() * 3600;
        if (roomId === 'tower') nextDelay = 5200 + Math.random() * 7600;
        if (roomId === 'library') nextDelay = 1100 + Math.random() * 2400;
        if (roomId === 'conservatory') nextDelay = 1800 + Math.random() * 4200;
        if (roomId === 'study') nextDelay = 2000 + Math.random() * 5000;
        if (roomId === 'hearth') nextDelay = 3200 + Math.random() * 5200;
        self.schedule(nextDelay);
      }, delay);
    };

    function toggleAudio() {
      if (!state.audio) state.audio = new QuietAudio();
      state.audioOn = !state.audioOn;
      if (state.audioOn) {
        state.audio.setRoom(state.roomId);
        state.audio.start();
        if (els.audioToggle) els.audioToggle.textContent = 'Ambient on';
      } else {
        state.audio.stop();
        if (els.audioToggle) els.audioToggle.textContent = 'Ambient off';
      }
    }

    function cycleRoom(direction) {
      var room = roomById[state.roomId] || rooms[0];
      var target = direction > 0 ? nextRoom(room) : previousRoom(room);
      setMode('now');
      enterRoom(target.id, false);
    }

    function initFromUrl() {
      var params = new URLSearchParams(window.location.search);
      var requestedRoom = params.get('room') || (window.location.hash || '').replace('#', '');
      var requestedMode = params.get('mode') || '';
      var real = pickRoom(new Date());
      state.realRoomId = real.id;
      var validRoom = requestedRoom && roomById[requestedRoom] ? requestedRoom : real.id;
      var mode = ['now', 'browse', 'spread'].indexOf(requestedMode) >= 0 ? requestedMode : 'now';
      state.lockToNow = !requestedRoom || !roomById[requestedRoom];
      setMode(mode);
      enterRoom(validRoom, state.lockToNow);
    }

    els.tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        setMode(tab.dataset.modeTab || 'now');
      });
    });

    document.querySelectorAll('[data-room-action]').forEach(function (node) {
      node.addEventListener('click', function () {
        setMode('now');
        enterRoom(node.dataset.roomAction, false);
      });
    });

    els.durations.forEach(function (btn) {
      btn.addEventListener('click', function () { setDuration(Number(btn.dataset.duration || 5)); });
    });
    if (els.timerToggle) els.timerToggle.addEventListener('click', toggleTimer);
    if (els.timerReset) els.timerReset.addEventListener('click', resetTimer);
    if (els.audioToggle) els.audioToggle.addEventListener('click', toggleAudio);
    if (els.shareHour) els.shareHour.addEventListener('click', function () { copyText(shareText(), els.shareHour, 'Copied hour'); });
    if (els.copyLink) {
      els.copyLink.addEventListener('click', function () {
        copyText('https://pointcast.xyz/quiet-hours?room=' + state.roomId, els.copyLink, 'Copied link');
      });
    }
    if (els.note) els.note.addEventListener('input', saveNote);

    document.addEventListener('keydown', function (event) {
      var tag = event.target && event.target.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        cycleRoom(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        cycleRoom(-1);
      } else if (event.key === ' ') {
        event.preventDefault();
        toggleTimer();
      }
    });

    initFromUrl();
    renderDailySpread();
    renderTimer();
    renderClock();
    renderStats();
    window.setInterval(renderClock, 1000);
  })();
</script>

