---
/**
 * /drum-altars-tv — TV cast variant of /drum-altars.
 *
 * Built behind the CF stall on 2026-05-02 morning while #313 (the
 * altar 1101 hotfix) was still queued. Reads only — polls the
 * existing /api/altar GET endpoint at 1.5s, so it works as soon as
 * the stall clears AND it doesn't compound the function-tier
 * deploy queue.
 *
 * For visit-day projection. clamp()-sized so it works on a 720px
 * laptop screen all the way up to a 4K 60" TV. No interaction —
 * the chamber rings itself when humans / agents POST tributes from
 * /drum-altars or `drum_altar_ring` MCP. When a count ticks up
 * between polls, the altar flares + a synthesized chime fires from
 * the TV speakers.
 *
 * Aesthetic: same velvet shrine as /drum-altars, sized up. Pixel-
 * art geocities-cathedral, not Sketchfab-cathedral.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Noun Altar TV · Tribute Chamber Cast · PointCast';
const description =
  'Projection cast of the five-altar tribute chamber. Watch tributes land in real time. Bell, bowl, chime, gong, drone — five timbres in a velvet shrine, sized for a TV.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Noun Altar TV',
  url: 'https://pointcast.xyz/drum-altars-tv',
  description,
  applicationCategory: 'MultimediaApplication',
};

// Lane labels match the page-side convention in /drum-altars
const ALTAR_META = [
  { idx: 0, instrument: 'bell',  glyph: '✦', subtitle: 'long brass'  },
  { idx: 1, instrument: 'bowl',  glyph: '◉', subtitle: 'singing'     },
  { idx: 2, instrument: 'chime', glyph: '✧', subtitle: 'three-note'  },
  { idx: 3, instrument: 'gong',  glyph: '◈', subtitle: 'low strike'  },
  { idx: 4, instrument: 'drone', glyph: '✦', subtitle: 'sustained'   },
];

// SSR placeholders — page hydrates with real seeds from /api/altar
const SSR_SEEDS = [42, 156, 411, 678, 805];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dat" id="dat-main">
    <DrumNav current="altars-tv" />

    <header class="dat__header">
      <div class="dat__chrome-row">
        <div class="dat__chrome">
          <span class="dat__chrome-label">WEEK</span>
          <span class="dat__chrome-val" id="dat-week">—</span>
        </div>
        <div class="dat__chrome">
          <span class="dat__chrome-label">TRIBUTES</span>
          <span class="dat__chrome-val" id="dat-total">—</span>
        </div>
        <div class="dat__chrome">
          <span class="dat__chrome-label">LIVE</span>
          <span class="dat__chrome-val" id="dat-live"><span class="dat__pulse"></span> ON AIR</span>
        </div>
      </div>
      <h1 class="dat__title">NOUN ALTAR</h1>
      <p class="dat__tagline">tribute chamber · cast view · sized for a sixty-inch screen</p>
    </header>

    <section class="dat__altars" id="dat-altars">
      {ALTAR_META.map((m, i) => (
        <article class="dat__altar" data-altar-idx={m.idx} data-seed={SSR_SEEDS[i]}>
          <div class="dat__pediment" aria-hidden="true">{m.glyph}</div>
          <div class="dat__frame">
            <div class="dat__frame-inner">
              <img class="dat__noun" src={`https://noun.pics/${SSR_SEEDS[i]}.svg`} alt={`Noun #${SSR_SEEDS[i]}`} loading="lazy" />
            </div>
          </div>
          <div class="dat__nameplate">
            NOUN <span class="dat__nameplate-num" data-seed-text>{String(SSR_SEEDS[i]).padStart(4, '0')}</span>
          </div>
          <div class="dat__instrument">
            <span class="dat__inst-name">{m.instrument.toUpperCase()}</span>
            <span class="dat__inst-sub">{m.subtitle}</span>
          </div>
          <div class="dat__count">
            <span class="dat__count-num" data-count-text>—</span>
            <span class="dat__count-label">tributes</span>
          </div>
          <div class="dat__candle" aria-hidden="true">
            <div class="dat__flame"></div>
            <div class="dat__wax"></div>
          </div>
        </article>
      ))}
    </section>

    <footer class="dat__feed">
      <div class="dat__feed-label">LATEST</div>
      <div class="dat__feed-marquee">
        <div class="dat__feed-track" id="dat-feed-track">
          <span class="dat__feed-empty">— waiting for the first ring —</span>
        </div>
      </div>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dat-main) {
    background: #0c0410;
  }

  .dat {
    --dat-velvet: #1a0820;
    --dat-velvet-deep: #0c0410;
    --dat-velvet-mid: #2c0d36;
    --dat-brass: #d4a437;
    --dat-brass-soft: #b8862c;
    --dat-brass-deep: #6b4d12;
    --dat-flame: #f6c15e;
    --dat-flame-tip: #ff6b3a;
    --dat-ink-light: #f4e7c8;
    --dat-ink-mid: #c9b78c;
    --dat-ink-dim: #8a7a55;
    --dat-rule-soft: rgba(212, 164, 55, 0.18);
    --dat-velvet-glow: rgba(212, 164, 55, 0.10);

    /* Bleed past BlockLayout's content gutter for the cast */
    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) clamp(24px, 3vh, 56px);
    color: var(--dat-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% -10%, rgba(212, 164, 55, 0.16), transparent 55%),
      radial-gradient(ellipse at 50% 110%, rgba(180, 60, 80, 0.10), transparent 70%),
      linear-gradient(180deg, var(--dat-velvet) 0%, var(--dat-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }

  /* Damask dot grid */
  .dat::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 24px 24px, var(--dat-velvet-glow) 1.5px, transparent 2px),
      radial-gradient(circle at 80px 80px, var(--dat-velvet-glow) 1.5px, transparent 2px);
    background-size: 110px 110px;
    opacity: 0.4;
    z-index: -1;
  }

  /* DrumNav: shrink + tuck for cast — visitors mostly want the room itself */
  .dat .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(8px, 1vh, 18px);
  }

  /* ── Header ─────────────────────────────────────────── */
  .dat__header {
    text-align: center;
    padding: clamp(10px, 1.5vh, 28px) 0 clamp(14px, 2vh, 32px);
  }
  .dat__chrome-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(10px, 1.4vw, 28px);
    margin-bottom: clamp(8px, 1.2vh, 18px);
    flex-wrap: wrap;
  }
  .dat__chrome {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 18px;
    border: 1.5px solid var(--dat-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(11px, 1vw, 16px);
    letter-spacing: 0.20em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.35);
  }
  .dat__chrome-label { color: var(--dat-ink-dim); }
  .dat__chrome-val { color: var(--dat-brass); font-weight: 700; }
  .dat__pulse {
    display: inline-block;
    width: 8px; height: 8px;
    background: #ff6b3a;
    border-radius: 50%;
    margin-right: 6px;
    box-shadow: 0 0 8px rgba(255, 107, 58, 0.7);
    animation: dat-pulse 1.5s ease-in-out infinite;
  }
  @keyframes dat-pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: 0.4; transform: scale(0.85); }
  }

  .dat__title {
    margin: 0 0 clamp(4px, 0.6vh, 10px);
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7.5vw, 124px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--dat-brass);
    text-shadow:
      0 0 36px rgba(212, 164, 55, 0.45),
      0 2px 0 var(--dat-velvet-deep);
  }
  .dat__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.6vw, 24px);
    color: var(--dat-ink-mid);
  }

  /* ── Altars row — sized big ────────────────────────── */
  .dat__altars {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(8px, 1vw, 28px);
    padding: 0;
  }
  @media (max-width: 980px) {
    .dat__altars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .dat__altars { grid-template-columns: 1fr; max-width: 360px; margin-inline: auto; }
  }

  .dat__altar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(10px, 1.4vh, 28px) clamp(8px, 1vw, 24px) clamp(14px, 1.6vh, 30px);
    background: linear-gradient(180deg, rgba(44, 13, 54, 0.7), rgba(12, 4, 16, 0.85));
    border: 1.5px solid var(--dat-brass-deep);
    border-radius: 6px;
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.30),
      inset 0 -1px 0 rgba(0, 0, 0, 0.6),
      0 8px 24px rgba(0, 0, 0, 0.6);
    position: relative;
    transition: transform 280ms ease-out, box-shadow 280ms ease-out;
  }
  .dat__altar.dat__altar--lit {
    transform: translateY(-4px) scale(1.02);
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.5),
      inset 0 -1px 0 rgba(0, 0, 0, 0.6),
      0 12px 36px rgba(212, 164, 55, 0.35),
      0 0 60px rgba(246, 193, 94, 0.4);
  }

  .dat__pediment {
    font-size: clamp(20px, 1.8vw, 36px);
    color: var(--dat-brass);
    line-height: 1;
    margin-bottom: clamp(6px, 0.8vh, 14px);
    text-shadow: 0 0 16px rgba(212, 164, 55, 0.55);
  }

  /* Brass frame around the Noun — sized big for TV */
  .dat__frame {
    width: clamp(132px, 14vw, 280px);
    aspect-ratio: 1 / 1;
    padding: clamp(5px, 0.6vw, 10px);
    background: linear-gradient(135deg, var(--dat-brass) 0%, var(--dat-brass-soft) 50%, var(--dat-brass-deep) 100%);
    box-shadow:
      0 0 0 2px var(--dat-velvet-deep),
      0 0 0 5px var(--dat-brass-deep),
      0 6px 18px rgba(0, 0, 0, 0.7);
    margin-bottom: clamp(8px, 1vh, 18px);
  }
  .dat__frame-inner {
    width: 100%;
    height: 100%;
    background: var(--dat-velvet-deep);
    overflow: hidden;
    position: relative;
  }
  .dat__noun {
    width: 100%; height: 100%;
    image-rendering: pixelated;
    display: block;
  }

  .dat__nameplate {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(11px, 1vw, 18px);
    letter-spacing: 0.22em;
    color: var(--dat-ink-mid);
    margin-bottom: clamp(2px, 0.3vh, 6px);
  }
  .dat__nameplate-num { color: var(--dat-brass); font-weight: 700; }

  .dat__instrument {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }
  .dat__inst-name {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(18px, 2vw, 36px);
    color: var(--dat-ink-light);
    letter-spacing: 0.08em;
    line-height: 1.05;
  }
  .dat__inst-sub {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(11px, 0.9vw, 16px);
    color: var(--dat-ink-dim);
  }

  .dat__count {
    text-align: center;
    margin-bottom: clamp(8px, 1vh, 16px);
  }
  .dat__count-num {
    display: block;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(34px, 4vw, 88px);
    font-weight: 800;
    color: var(--dat-flame);
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 0 18px rgba(246, 193, 94, 0.5);
    transition: transform 240ms;
  }
  .dat__altar.dat__altar--lit .dat__count-num {
    transform: scale(1.18);
  }
  .dat__count-label {
    display: block;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(9px, 0.8vw, 14px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dat-ink-dim);
    margin-top: 4px;
  }

  /* Candle — bigger for TV */
  .dat__candle {
    width: clamp(16px, 1.4vw, 28px);
    height: clamp(44px, 4vw, 72px);
    position: relative;
    margin-top: clamp(2px, 0.4vh, 8px);
  }
  .dat__wax {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(16px, 1.4vw, 28px);
    height: clamp(28px, 2.6vw, 46px);
    background: linear-gradient(180deg, #f4e7c8 0%, #c9b78c 100%);
    box-shadow:
      inset -1px 0 0 rgba(0,0,0,0.3),
      inset 1px 0 0 rgba(255,255,255,0.4);
  }
  .dat__wax::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 5px;
    background: #2a1a08;
  }
  .dat__flame {
    position: absolute;
    bottom: clamp(26px, 2.4vw, 42px);
    left: 50%;
    transform: translateX(-50%);
    width: clamp(10px, 1vw, 18px);
    height: clamp(18px, 1.8vw, 30px);
    background: radial-gradient(ellipse 50% 70% at 50% 70%, var(--dat-flame-tip) 0%, var(--dat-flame) 50%, transparent 75%);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.6px);
    animation: dat-flicker 1.6s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .dat__altar.dat__altar--lit .dat__flame {
    animation: dat-flare 0.95s ease-out;
  }
  @keyframes dat-flicker {
    0%,100% { transform: translateX(-50%) scale(1, 1); opacity: 0.9; }
    25%     { transform: translateX(-50%) scale(0.96, 1.06); opacity: 1; }
    50%     { transform: translateX(-50%) scale(1.04, 0.94); opacity: 0.92; }
    75%     { transform: translateX(-50%) scale(0.98, 1.02); opacity: 1; }
  }
  @keyframes dat-flare {
    0%   { transform: translateX(-50%) scale(1, 1); filter: blur(0.6px) brightness(1); }
    20%  { transform: translateX(-50%) scale(1.7, 2.0); filter: blur(1.2px) brightness(1.8); }
    100% { transform: translateX(-50%) scale(1, 1); filter: blur(0.6px) brightness(1); }
  }

  /* ── Recent ticker at bottom ───────────────────────── */
  .dat__feed {
    margin-top: clamp(14px, 1.8vh, 28px);
    padding: clamp(10px, 1.2vh, 18px) 0 0;
    border-top: 1px solid var(--dat-rule-soft);
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.2vw, 24px);
  }
  .dat__feed-label {
    flex-shrink: 0;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(11px, 0.95vw, 16px);
    letter-spacing: 0.30em;
    color: var(--dat-brass);
    text-transform: uppercase;
  }
  .dat__feed-marquee {
    flex: 1;
    overflow: hidden;
    position: relative;
    height: clamp(20px, 2vh, 32px);
  }
  .dat__feed-track {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: clamp(20px, 2vw, 40px);
    white-space: nowrap;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(12px, 1vw, 18px);
    color: var(--dat-ink-mid);
    animation: dat-scroll 38s linear infinite;
  }
  .dat__feed-track > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dat__feed-track .dat__feed-thumb {
    width: clamp(18px, 1.4vw, 26px);
    height: clamp(18px, 1.4vw, 26px);
    background: var(--dat-velvet-deep);
    border: 1px solid var(--dat-brass-deep);
    image-rendering: pixelated;
  }
  .dat__feed-track .dat__feed-thumb img {
    width: 100%; height: 100%; display: block; image-rendering: pixelated;
  }
  .dat__feed-empty {
    color: var(--dat-ink-dim);
    font-style: italic;
    font-family: 'Lora', Georgia, serif;
  }
  @keyframes dat-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<script>
  // ── Audio: same five timbres as /drum-altars but voiced for cast use
  let actx = null;
  function ctx() {
    if (!actx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      actx = new AC();
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  function playBell() {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 880;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 880 * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.32, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.10, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.9); o2.start(t); o2.stop(t + 1.5);
  }
  function playBowl() {
    const a = ctx(); const t = a.currentTime;
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = 220;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 220 * 1.5946;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.30, t + 0.04); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.6);
    o1.connect(g); o2.connect(g); g.connect(a.destination);
    o1.start(t); o1.stop(t + 2.7); o2.start(t); o2.stop(t + 2.7);
  }
  function playChime() {
    const a = ctx(); const base = a.currentTime;
    [523.25, 659.25, 783.99].forEach((f, i) => {
      const t = base + i * 0.085;
      const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
      const g = a.createGain();
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.22, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.2);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 1.3);
    });
  }
  function playGong() {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = 110;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 55;
    const o3 = a.createOscillator(); o3.type = 'triangle'; o3.frequency.value = 220;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.45, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + 3.0);
    o.connect(g); o2.connect(g); o3.connect(g); g.connect(a.destination);
    o.start(t); o2.start(t); o3.start(t);
    o.stop(t + 3.1); o2.stop(t + 3.1); o3.stop(t + 3.1);
  }
  function playDrone() {
    const a = ctx(); const t = a.currentTime;
    const o1 = a.createOscillator(); o1.type = 'sine'; o1.frequency.value = 440;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = 660;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 1400;
    const g = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.18, t + 0.30); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.5);
    o1.connect(filt); o2.connect(filt); filt.connect(g); g.connect(a.destination);
    o1.start(t); o2.start(t); o1.stop(t + 1.6); o2.stop(t + 1.6);
  }
  const TONES = [playBell, playBowl, playChime, playGong, playDrone];

  // ── State + diff detection ─────────────────────────
  let lastCounts = {}; // seed → count, last seen
  let lastSeeds = [];

  function fmt(n) { return String(n).padStart(4, '0'); }
  function fmtCount(n) { return n > 9999 ? (n / 1000).toFixed(1) + 'k' : String(n); }

  function setNounImage(altarEl, seed) {
    const img = altarEl.querySelector('.dat__noun');
    if (img && img.dataset.currentSeed !== String(seed)) {
      img.src = `https://noun.pics/${seed}.svg`;
      img.alt = `Noun #${seed}`;
      img.dataset.currentSeed = String(seed);
    }
    const txt = altarEl.querySelector('[data-seed-text]');
    if (txt) txt.textContent = fmt(seed);
    altarEl.dataset.seed = String(seed);
  }

  function flareAltar(altarEl, idx) {
    altarEl.classList.add('dat__altar--lit');
    setTimeout(() => altarEl.classList.remove('dat__altar--lit'), 950);
    try { TONES[idx]?.(); } catch {}
  }

  function paintAltars(state) {
    const altars = document.querySelectorAll('.dat__altar');
    altars.forEach((el, i) => {
      const seed = state.seeds?.[i];
      if (typeof seed === 'number') setNounImage(el, seed);
      const count = state.counts?.[String(seed)] ?? 0;
      const num = el.querySelector('[data-count-text]');
      if (num) num.textContent = fmtCount(count);
      // Diff: did this seed's count tick up since last poll?
      const prev = lastCounts[String(seed)] ?? null;
      if (prev !== null && count > prev) {
        flareAltar(el, i);
      }
    });
    lastCounts = { ...(state.counts || {}) };
    lastSeeds = state.seeds || [];
  }

  function paintHeader(state) {
    const wkEl = document.getElementById('dat-week');
    if (wkEl) wkEl.textContent = String(state.week ?? '—');
    const totEl = document.getElementById('dat-total');
    if (totEl) totEl.textContent = fmtCount(state.totalThisWeek ?? 0);
  }

  function paintFeed(state) {
    const track = document.getElementById('dat-feed-track');
    if (!track) return;
    const recent = state.recent ?? [];
    if (!recent.length) {
      track.innerHTML = '<span class="dat__feed-empty">— waiting for the first ring —</span>';
      return;
    }
    // Build a long enough track to scroll seamlessly: duplicate the list
    const items = recent.concat(recent).map((r) => {
      const ago = Math.max(0, Math.floor((Date.now() - r.t) / 1000));
      const agoStr = ago < 5 ? 'just now' : ago < 60 ? `${ago}s ago` : `${Math.floor(ago/60)}m ago`;
      return `<span><span class="dat__feed-thumb"><img src="https://noun.pics/${r.seed}.svg" alt=""></span> noun ${fmt(r.seed)} · ${r.pid.slice(0,6)}… · ${agoStr}</span>`;
    });
    track.innerHTML = items.join('<span style="opacity:0.4">·</span>');
  }

  // ── Network ────────────────────────────────────────
  async function fetchState() {
    try {
      const r = await fetch('/api/altar', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) {
        paintHeader(j); paintAltars(j); paintFeed(j);
      }
    } catch { /* offline — keep current state */ }
  }

  // First load: no flare even if counts are non-zero — we want the
  // diff-detection to start from the first response, not from zero.
  (async function bootstrap() {
    try {
      const r = await fetch('/api/altar', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok) {
        paintHeader(j);
        // Set lastCounts BEFORE first paintAltars to suppress flares
        lastCounts = { ...(j.counts || {}) };
        paintAltars(j);
        paintFeed(j);
      }
    } catch {}
  })();

  setInterval(fetchState, 1500);

  // Keep the flame flickering even when tab is backgrounded —
  // CSS animations handle that. Refresh on visibility regain.
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) fetchState();
  });
</script>
