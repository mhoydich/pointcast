---
/**
 * /drum-bell-jar — a glass jar full of bells.
 *
 * Mike 2026-05-02 morning, "ok go" — companion to /drum-bell-fall.
 * Where bell-fall is kinetic (click anywhere, bells rain), bell-jar
 * is contained. A single chunky brass jar sits in the middle of
 * the velvet field; click it to shake. Inside, a cluster of small
 * pixel bells jiggle for 1.4s — each bell that's visible jingles
 * a pentatonic note as it bounces. The jar itself rings when the
 * shake settles.
 *
 * Pure static. localStorage tracks lifetime shake count. ~150
 * lines. Pairs with /drum-altars + /drum-altars-tv + /drum-bell-
 * fall as the "fives & bells" wing.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Bell Jar · Shake the Glass · PointCast';
const description =
  'A glass jar full of brass bells. Click the jar to shake; the bells inside jingle in random pentatonic notes. Pure ambient.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bell Jar',
  url: 'https://pointcast.xyz/drum-bell-jar',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="bj" id="bj-main">
    <DrumNav current="bell-jar" />

    <header class="bj__header">
      <div class="bj__chrome">
        <span>SHAKE THE GLASS</span>
        <span class="bj__chrome-sep">·</span>
        <span>PENTATONIC</span>
        <span class="bj__chrome-sep">·</span>
        <span>SEVEN BELLS INSIDE</span>
      </div>
      <h1 class="bj__title">BELL JAR</h1>
      <p class="bj__tagline">a small chamber of bells under glass</p>
    </header>

    <section class="bj__stage" id="bj-stage" aria-label="Bell jar — click to shake">
      <button class="bj__jar" id="bj-jar" type="button" aria-label="Shake the bell jar">
        <!-- Jar SVG: glass body + cork stopper + brass band -->
        <svg class="bj__jar-svg" viewBox="0 0 200 280" aria-hidden="true" shape-rendering="crispEdges">
          <!-- cork -->
          <rect x="80" y="0" width="40" height="14" fill="#5a3a18"/>
          <rect x="78" y="14" width="44" height="6" fill="#7a4a20"/>
          <!-- jar neck -->
          <rect x="74" y="20" width="52" height="22" fill="rgba(212, 164, 55, 0.18)" stroke="#d4a437" stroke-width="2"/>
          <rect x="70" y="42" width="60" height="6" fill="#d4a437"/>
          <!-- jar body (rounded glass) -->
          <path d="M 70 48 Q 30 60 30 130 L 30 240 Q 30 266 60 270 L 140 270 Q 170 266 170 240 L 170 130 Q 170 60 130 48 Z"
                fill="rgba(212, 164, 55, 0.10)" stroke="#d4a437" stroke-width="2.5"/>
          <!-- highlight -->
          <path d="M 50 80 Q 40 110 40 180" fill="none" stroke="#fff5c0" stroke-width="2" opacity="0.5"/>
          <path d="M 60 70 Q 50 100 50 160" fill="none" stroke="#fff5c0" stroke-width="1" opacity="0.3"/>
          <!-- nameplate brass band -->
          <rect x="40" y="200" width="120" height="18" fill="#6b4d12" stroke="#d4a437" stroke-width="1"/>
          <text x="100" y="213" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="3" fill="#f4e7c8">BELL JAR · 7</text>
        </svg>

        <!-- Bells inside the jar (positioned absolutely) -->
        <div class="bj__bells" id="bj-bells">
          <!-- 7 small bells, positioned in jar coordinates -->
          <span class="bj__bell" style="left: 38%; top: 36%; --rot: -8deg;"></span>
          <span class="bj__bell" style="left: 56%; top: 32%; --rot: 12deg;"></span>
          <span class="bj__bell" style="left: 30%; top: 52%; --rot: -16deg;"></span>
          <span class="bj__bell" style="left: 50%; top: 58%; --rot: 4deg;"></span>
          <span class="bj__bell" style="left: 64%; top: 56%; --rot: 18deg;"></span>
          <span class="bj__bell" style="left: 42%; top: 76%; --rot: -10deg;"></span>
          <span class="bj__bell" style="left: 58%; top: 80%; --rot: 8deg;"></span>
        </div>
      </button>

      <div class="bj__caption">click anywhere on the jar — or press <kbd>space</kbd></div>
    </section>

    <footer class="bj__readout">
      <div class="bj__stat">
        <span class="bj__stat-num" id="bj-shakes">0</span>
        <span class="bj__stat-label">shakes</span>
      </div>
      <div class="bj__stat">
        <span class="bj__stat-num" id="bj-rings">0</span>
        <span class="bj__stat-label">rings</span>
      </div>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#bj-main) {
    background: #0c0410;
  }

  .bj {
    --bj-velvet: #1a0820;
    --bj-velvet-deep: #0c0410;
    --bj-velvet-mid: #2c0d36;
    --bj-brass: #d4a437;
    --bj-brass-soft: #b8862c;
    --bj-brass-deep: #6b4d12;
    --bj-flame: #f6c15e;
    --bj-flame-tip: #ff6b3a;
    --bj-ink-light: #f4e7c8;
    --bj-ink-mid: #c9b78c;
    --bj-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 0;
    color: var(--bj-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 30%, rgba(212, 164, 55, 0.12), transparent 55%),
      linear-gradient(180deg, var(--bj-velvet) 0%, var(--bj-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
  }
  .bj::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 24px 24px, rgba(212, 164, 55, 0.10) 1.5px, transparent 2px),
      radial-gradient(circle at 80px 80px, rgba(212, 164, 55, 0.10) 1.5px, transparent 2px);
    background-size: 110px 110px;
    opacity: 0.35;
    z-index: -1;
  }
  .bj .drum-nav {
    opacity: 0.45;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
  }

  .bj__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(12px, 1.5vh, 22px);
  }
  .bj__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 14px;
    border: 1.5px solid var(--bj-brass-deep);
    border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bj-ink-mid);
    background: rgba(0, 0, 0, 0.35);
  }
  .bj__chrome-sep { color: var(--bj-brass-deep); }
  .bj__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 78px);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--bj-brass);
    text-shadow:
      0 0 28px rgba(212, 164, 55, 0.40),
      0 2px 0 var(--bj-velvet-deep);
  }
  .bj__tagline {
    margin: 0;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--bj-ink-mid);
  }

  /* Stage holds the jar + caption */
  .bj__stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2vh, 28px);
    padding: clamp(14px, 2vh, 28px) 0;
  }

  /* Jar — the click target */
  .bj__jar {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    width: clamp(220px, 28vw, 360px);
    aspect-ratio: 200 / 280;
    padding: 0;
    transform-origin: 50% 100%;
    transition: filter 220ms;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.7));
  }
  .bj__jar:hover {
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 24px rgba(212, 164, 55, 0.25));
  }
  .bj__jar:focus-visible {
    outline: 2px solid var(--bj-brass);
    outline-offset: 8px;
    border-radius: 8px;
  }
  .bj__jar.bj__jar--shaking {
    animation: bj-shake 0.62s cubic-bezier(0.36, 0, 0.68, 1) 1;
  }
  @keyframes bj-shake {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    8%       { transform: translate(-3px, -2px) rotate(-2.5deg); }
    18%      { transform: translate(4px, -1px) rotate(3deg); }
    32%      { transform: translate(-3px, -3px) rotate(-2deg); }
    48%      { transform: translate(2px, 0px) rotate(1.5deg); }
    62%      { transform: translate(-2px, -1px) rotate(-1deg); }
    78%      { transform: translate(1px, 0px) rotate(0.5deg); }
  }

  .bj__jar-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Bells inside the jar — overlaid on the SVG */
  .bj__bells {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bj__bell {
    position: absolute;
    width: 18px;
    height: 22px;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 18 22' shape-rendering='crispEdges'><rect x='8' y='0' width='2' height='2' fill='%236b4d12'/><rect x='6' y='2' width='6' height='1' fill='%236b4d12'/><path d='M 4 5 L 14 5 L 15 18 L 3 18 Z' fill='%23d4a437'/><rect x='3' y='18' width='12' height='1.5' fill='%23b8862c'/><rect x='2' y='19.5' width='14' height='1.5' fill='%236b4d12'/><rect x='8' y='21' width='2' height='1' fill='%233a2410'/><rect x='5' y='7' width='1' height='7' fill='%23fff5c0' opacity='0.5'/></svg>");
    background-repeat: no-repeat;
    background-size: contain;
    transition: transform 200ms;
  }
  .bj__jar.bj__jar--shaking .bj__bell {
    animation: bj-bell-jiggle 0.62s ease-in-out 1;
  }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(1) { animation-duration: 0.58s; animation-delay: 0.02s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(2) { animation-duration: 0.66s; animation-delay: 0.04s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(3) { animation-duration: 0.60s; animation-delay: 0.06s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(4) { animation-duration: 0.64s; animation-delay: 0.01s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(5) { animation-duration: 0.62s; animation-delay: 0.03s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(6) { animation-duration: 0.59s; animation-delay: 0.05s; }
  .bj__jar.bj__jar--shaking .bj__bell:nth-child(7) { animation-duration: 0.63s; animation-delay: 0.07s; }
  @keyframes bj-bell-jiggle {
    0%, 100% { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1); }
    20%      { transform: translate(calc(-50% - 4px), calc(-50% - 3px)) rotate(calc(var(--rot, 0deg) - 14deg)) scale(1.08); }
    45%      { transform: translate(calc(-50% + 5px), calc(-50% + 2px)) rotate(calc(var(--rot, 0deg) + 12deg)) scale(0.96); }
    70%      { transform: translate(calc(-50% - 2px), calc(-50% + 3px)) rotate(calc(var(--rot, 0deg) - 6deg)) scale(1.04); }
  }

  .bj__caption {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(11px, 1vw, 14px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bj-ink-dim);
  }
  .bj__caption kbd {
    display: inline-block;
    padding: 1px 6px;
    margin: 0 2px;
    font-family: inherit;
    font-size: inherit;
    color: var(--bj-velvet-deep);
    background: var(--bj-brass);
    border-radius: 2px;
    font-weight: 700;
  }

  /* Footer */
  .bj__readout {
    display: flex;
    justify-content: center;
    gap: clamp(20px, 3vw, 60px);
    padding: clamp(14px, 2vh, 28px) 0;
    flex-shrink: 0;
  }
  .bj__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .bj__stat-num {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 800;
    color: var(--bj-flame);
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 0 12px rgba(246, 193, 94, 0.4);
  }
  .bj__stat-label {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(9px, 0.8vw, 12px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bj-ink-dim);
  }
</style>

<script>
  // ── Audio ─────────────────────────────────────────────
  let actx = null;
  function ctx() {
    if (!actx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      actx = new AC();
    }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  // 7 pentatonic notes (C-D-E-G-A two octaves), shuffled per-shake
  const NOTES = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50, 1174.66];

  function playBell(freq, gain = 0.15, when = 0) {
    const a = ctx(); const t = a.currentTime + when;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.0);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(gain * 0.30, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.1); o2.start(t); o2.stop(t + 0.8);
  }

  function jingle() {
    // Pick 5 random notes from NOTES (without replacement), play them
    // staggered over ~600ms with descending volume so it feels like
    // a tumble, not a chord.
    const pool = NOTES.slice();
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    const picks = pool.slice(0, 5);
    let totalRings = 0;
    picks.forEach((freq, i) => {
      const offset = 0.04 + i * (0.10 + Math.random() * 0.04);
      const gain = 0.16 - i * 0.018;
      playBell(freq, gain, offset);
      totalRings += 1;
    });
    return totalRings;
  }

  // ── Shake ─────────────────────────────────────────────
  const SHAKES_KEY = 'pc:belljar:shakes';
  const RINGS_KEY = 'pc:belljar:rings';
  let shakes = 0;
  let rings = 0;
  try {
    shakes = parseInt(localStorage.getItem(SHAKES_KEY) || '0', 10) || 0;
    rings = parseInt(localStorage.getItem(RINGS_KEY) || '0', 10) || 0;
  } catch {}

  const jarEl = document.getElementById('bj-jar');
  const shakesEl = document.getElementById('bj-shakes');
  const ringsEl = document.getElementById('bj-rings');
  let cooldown = false;

  function fmt(n) { return n > 9999 ? (n / 1000).toFixed(1) + 'k' : String(n); }
  function paint() {
    if (shakesEl) shakesEl.textContent = fmt(shakes);
    if (ringsEl) ringsEl.textContent = fmt(rings);
  }

  function shake() {
    if (cooldown || !jarEl) return;
    cooldown = true;
    jarEl.classList.add('bj__jar--shaking');
    const ringsThis = jingle();
    shakes += 1;
    rings += ringsThis;
    try {
      localStorage.setItem(SHAKES_KEY, String(shakes));
      localStorage.setItem(RINGS_KEY, String(rings));
    } catch {}
    paint();
    setTimeout(() => {
      jarEl.classList.remove('bj__jar--shaking');
      cooldown = false;
    }, 640);
  }

  jarEl?.addEventListener('click', shake);
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && !e.repeat) {
      e.preventDefault();
      shake();
    }
  });

  paint();
</script>
