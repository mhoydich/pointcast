---
import BlockLayout from '../layouts/BlockLayout.astro';

const highlights = [
  {
    number: '01',
    signal: 'PLAY',
    title: 'The drum room became an arcade.',
    copy: 'Five focused games opened the door. Beat Runner then moved through four new editions and arrived at Loop Siege: a rhythm-defense game where the loop you write comes back to fight beside you.',
    href: '/drum-runner',
    link: 'Enter Loop Siege',
    accent: '#ff6c59',
    className: 'pulse',
    note: '5 games · Beat Runner v3–v7',
  },
  {
    number: '02',
    signal: 'SIGNAL',
    title: 'Images learned how to broadcast.',
    copy: 'Halation diaries connected to PointCast, the first signal relay came online, and Afterimage published ten discoverable transmissions—turning image, weather, and sound into a public station.',
    href: '/afterimage',
    link: 'Tune into Afterimage',
    accent: '#79d8ff',
    className: 'signal',
    note: '10 transmissions · 1 live relay',
  },
  {
    number: '03',
    signal: 'LEARN',
    title: 'El Segundo became a campus.',
    copy: 'The school gallery opened, the public funding program followed, and University of El Segundo activated ten self-paced classes with machine-readable receipts and a repaired pocket-size catalog.',
    href: '/ues',
    link: 'Visit the university',
    accent: '#d9f56a',
    className: 'learn',
    note: '10 classes · mobile contained',
  },
  {
    number: '04',
    signal: 'PAUSE',
    title: 'The network made room for ritual.',
    copy: 'Open Road reached edition VII. Morning and evening prayer altars added sixty images. The Angelus became a playable chime garden, and Common Hours opened a shared clock for the day.',
    href: '/common-hours',
    link: 'Open Common Hours',
    accent: '#ffcf61',
    className: 'ritual',
    note: '7 roads · 60 images · 5 daily hours',
  },
  {
    number: '05',
    signal: 'SYSTEM',
    title: 'The edges got stronger.',
    copy: 'Corner Engineering gained a mission layer and a reliable social card. Discovery guides became crawlable. Public assets, mobile widths, receipts, and footer scope all received the unglamorous fixes that make a growing network hold together.',
    href: '/corner',
    link: 'Read the engineering pulse',
    accent: '#bf9cff',
    className: 'system',
    note: '10 fixes · discovery opened',
  },
];

const days = [
  { day: 'SUN 13', count: '14', copy: 'The drum arcade and the new Beat Runner campaign set the tempo.' },
  { day: 'MON 14', count: '04', copy: 'Loop Siege landed; Halation diaries joined the Passport path.' },
  { day: 'TUE 15', count: '05', copy: 'Afterimage became a discoverable signal relay.' },
  { day: 'THU 17', count: '06', copy: 'Arcade 60 and El Segundo School opened their doors.' },
  { day: 'FRI 18', count: '28', copy: 'The release wave: school, shrines, prayer, publishing, and repairs.' },
  { day: 'SAT 19', count: '04', copy: 'Common Hours, Angelus, the elemental shrine, and The Yard.' },
];

const description = 'PointCast development week in review for July 13–19, 2026: 61 main-branch commits across play, publishing, learning, ritual, and system repair.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'PointCast Week in Review — Built This Week',
  description,
  datePublished: '2026-07-19',
  dateModified: '2026-07-19',
  author: { '@type': 'Organization', name: 'PointCast' },
  url: 'https://pointcast.xyz/week-in-review',
};
---

<BlockLayout legacy title="Week in Review" description={description} hideNav={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="review" data-review>
    <div class="scroll-meter" aria-hidden="true"><span data-scroll-meter></span></div>

    <nav class="review-nav" aria-label="Week in review navigation">
      <a class="wordmark" href="/" aria-label="PointCast home">POINT<span>•</span>CAST</a>
      <p>DEV LOG / WEEK 29</p>
      <a class="nav-link" href="#highlights">Highlights ↓</a>
    </nav>

    <header class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <p class="hero-kicker">JUL 13—19 · EL SEGUNDO, CA · BUILD RECEIPT 029</p>
      <h1><span>Built</span><span>This</span><span>Week.</span></h1>
      <div class="hero-bottom">
        <p>
          PointCast moved like a small city this week: games opened, signals
          crossed, a school grew, clocks rang, and the infrastructure caught up.
        </p>
        <a href="#week-shape" class="round-link" aria-label="Start the week in review">
          <span>SCROLL</span><strong>↓</strong>
        </a>
      </div>
    </header>

    <section class="numbers" id="week-shape" aria-labelledby="numbers-title">
      <div class="numbers-intro">
        <p class="eyebrow">THE SHAPE OF THE WEEK</p>
        <h2 id="numbers-title">Not one launch.<br />A living system.</h2>
        <p>
          The visible work spread across five connected modes. The invisible
          work made those modes load, travel, fit, and remain legible.
        </p>
      </div>
      <dl class="scoreboard">
        <div><dt>Main commits</dt><dd>61</dd><small>merged July 13–19</small></div>
        <div><dt>Features</dt><dd>40</dd><small>new rooms + capabilities</small></div>
        <div><dt>Fixes</dt><dd>10</dd><small>mobile, assets, scope, feeds</small></div>
        <div><dt>PR receipts</dt><dd>28</dd><small>referenced on main</small></div>
      </dl>
    </section>

    <section class="turn" aria-label="Transition to highlights">
      <p>Then, in the middle of the scroll—</p>
      <h2>the week comes<br />into focus.</h2>
      <span aria-hidden="true">✦</span>
    </section>

    <section class="highlights" id="highlights" aria-labelledby="highlights-title">
      <header class="highlights-rail">
        <p class="eyebrow">MID-SCROLL HIGHLIGHTS</p>
        <h2 id="highlights-title">Five signals<br />worth holding.</h2>
        <div class="highlight-index" aria-live="polite">
          <span data-highlight-number>01</span>
          <i></i>
          <span>05</span>
        </div>
        <p class="rail-note">Keep scrolling. Each card opens the work it describes.</p>
      </header>

      <div class="highlight-stack">
        {highlights.map((item, index) => (
          <article
            class={`highlight-card highlight-card--${item.className}`}
            style={`--card-accent:${item.accent}; --card-order:${index};`}
            data-highlight={item.number}
          >
            <div class="card-top">
              <span>{item.number} / 05</span>
              <span>{item.signal}</span>
            </div>
            <div class={`card-mark card-mark--${item.className}`} aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="card-foot">
              <span>{item.note}</span>
              <a href={item.href}>{item.link} <b aria-hidden="true">↗</b></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ledger" aria-labelledby="ledger-title">
      <header>
        <p class="eyebrow">THE DEVELOPMENT LEDGER</p>
        <h2 id="ledger-title">Six active days.<br />One continuous line.</h2>
      </header>
      <ol>
        {days.map((item) => (
          <li>
            <time>{item.day}</time>
            <strong>{item.count}</strong>
            <p>{item.copy}</p>
          </li>
        ))}
      </ol>
      <p class="ledger-key"><span></span> Numbers are main-branch commits recorded on each active day.</p>
    </section>

    <section class="closing">
      <p class="eyebrow">NEXT SIGNAL</p>
      <h2>The network is no longer waiting to become itself.</h2>
      <p>
        The next development week is about connection: fewer isolated rooms,
        stronger paths between play, publication, place, and participation.
      </p>
      <div class="closing-actions">
        <a href="/today">Open today <span>↗</span></a>
        <a href="/changelog">Full changelog <span>↗</span></a>
        <a href="/next-sprint">Next sprint <span>↗</span></a>
      </div>
      <footer>
        <a href="/">POINT•CAST</a>
        <span>WEEK 29 / 2026</span>
        <span>MIKE × AGENTS</span>
      </footer>
    </section>
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-review]');
      if (!root) return;

      var meter = root.querySelector('[data-scroll-meter]');
      var number = root.querySelector('[data-highlight-number]');
      var cards = Array.from(root.querySelectorAll('[data-highlight]'));
      var ticking = false;

      function paintScroll() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        if (meter) meter.style.transform = 'scaleX(' + progress.toFixed(4) + ')';
        ticking = false;
      }

      function requestPaint() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(paintScroll);
      }

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          cards.forEach(function (card) { card.classList.remove('is-current'); });
          entry.target.classList.add('is-current');
          if (number) number.textContent = entry.target.getAttribute('data-highlight') || '01';
        });
      }, { rootMargin: '-34% 0px -42% 0px', threshold: 0 });

      cards.forEach(function (card) { observer.observe(card); });
      window.addEventListener('scroll', requestPaint, { passive: true });
      window.addEventListener('resize', requestPaint, { passive: true });
      paintScroll();
    })();
  </script>
</BlockLayout>

<style is:global>
  body:has(.review) {
    margin: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    background: #f2eadc;
    color: #111426;
  }

  body:has(.review) > footer,
  body:has(.review) > #pc-conav,
  body:has(.review) > #pc-freshness,
  body:has(.review) > #pc-first-see,
  body:has(.review) > #pc-peer-cursors,
  body:has(.review) > #pc-cursor-say {
    display: none;
  }
</style>

<style>
  .review {
    --ink: #111426;
    --paper: #f2eadc;
    --warm-white: #fffaf0;
    --red: #ff6c59;
    --blue: #79d8ff;
    --lime: #d9f56a;
    --yellow: #ffcf61;
    --purple: #bf9cff;
    min-height: 100vh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .review *, .review *::before, .review *::after { box-sizing: border-box; }
  .review a { color: inherit; }

  .scroll-meter {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    height: 5px;
    background: rgba(17, 20, 38, .12);
  }
  .scroll-meter span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: linear-gradient(90deg, var(--red), var(--yellow), var(--lime), var(--blue), var(--purple));
    will-change: transform;
  }

  .review-nav {
    position: absolute;
    z-index: 4;
    inset: 5px 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 24px clamp(20px, 4vw, 64px);
    border-bottom: 1px solid rgba(17, 20, 38, .25);
    font: 700 11px/1 'JetBrains Mono', monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .review-nav p { margin: 0; }
  .wordmark, .nav-link { text-decoration: none; }
  .wordmark { font-size: 14px; letter-spacing: -.04em; }
  .wordmark span { color: var(--red); }
  .nav-link { justify-self: end; }
  .nav-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  .hero {
    position: relative;
    min-height: max(720px, 100svh);
    padding: clamp(118px, 15vh, 170px) clamp(20px, 4vw, 64px) clamp(34px, 6vh, 70px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: min(48vw, 690px);
    aspect-ratio: 1;
    top: 7%;
    right: -8%;
    border-radius: 50%;
    background: var(--red);
    filter: saturate(.92);
  }
  .hero::after {
    content: '029';
    position: absolute;
    z-index: -1;
    right: 1vw;
    bottom: -6vw;
    font: 900 min(31vw, 460px)/.7 Inter, sans-serif;
    letter-spacing: -.1em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(17, 20, 38, .15);
  }
  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    opacity: .22;
    background-image: linear-gradient(rgba(17,20,38,.32) 1px, transparent 1px), linear-gradient(90deg, rgba(17,20,38,.32) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black 0 64%, transparent 92%);
  }
  .hero-kicker, .eyebrow {
    margin: 0;
    font: 700 10px/1.4 'JetBrains Mono', monospace;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .hero h1 {
    width: min-content;
    margin: auto 0;
    font: 900 clamp(84px, 15vw, 230px)/.7 Inter, sans-serif;
    letter-spacing: -.095em;
    text-transform: uppercase;
  }
  .hero h1 span { display: block; }
  .hero h1 span:nth-child(2) { margin-left: .42em; color: transparent; -webkit-text-stroke: 2px var(--ink); }
  .hero h1 span:nth-child(3) { margin-left: .08em; }
  .hero-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
  }
  .hero-bottom > p {
    width: min(610px, 74%);
    margin: 0;
    font: 600 clamp(19px, 2vw, 29px)/1.25 Inter, sans-serif;
    letter-spacing: -.025em;
  }
  .round-link {
    width: 88px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    border: 2px solid var(--ink);
    border-radius: 50%;
    display: grid;
    place-content: center;
    gap: 4px;
    text-align: center;
    text-decoration: none;
    font: 700 8px/1 'JetBrains Mono', monospace;
    transition: transform .2s, background .2s, color .2s;
  }
  .round-link strong { font-size: 22px; }
  .round-link:hover { transform: rotate(8deg); background: var(--ink); color: var(--paper); }

  .numbers {
    min-height: 120vh;
    padding: clamp(96px, 14vw, 210px) clamp(20px, 6vw, 96px);
    display: grid;
    grid-template-columns: minmax(280px, .85fr) 1.15fr;
    align-items: center;
    gap: clamp(70px, 10vw, 180px);
    background: var(--ink);
    color: var(--warm-white);
  }
  .numbers .eyebrow { color: var(--yellow); }
  .numbers-intro h2, .ledger h2, .closing h2, .turn h2, .highlights-rail h2 {
    margin: 20px 0 26px;
    font-weight: 850;
    letter-spacing: -.07em;
  }
  .numbers-intro h2 { font-size: clamp(55px, 7vw, 112px); line-height: .88; }
  .numbers-intro > p:last-child { max-width: 520px; margin: 0; color: rgba(255,250,240,.68); font-size: clamp(17px, 1.5vw, 23px); line-height: 1.5; }
  .scoreboard { margin: 0; border-top: 1px solid rgba(255,255,255,.24); }
  .scoreboard div {
    min-height: 150px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: end;
    gap: 0 24px;
    padding: 26px 0;
    border-bottom: 1px solid rgba(255,255,255,.24);
  }
  .scoreboard dt { align-self: end; font: 700 12px/1 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
  .scoreboard dd { grid-row: 1 / 3; grid-column: 2; margin: 0; font: 850 clamp(68px, 9vw, 138px)/.7 Inter, sans-serif; letter-spacing: -.08em; }
  .scoreboard small { color: rgba(255,250,240,.5); font: 500 11px/1.3 'JetBrains Mono', monospace; text-transform: uppercase; }

  .turn {
    position: relative;
    min-height: 95vh;
    padding: 80px 20px;
    display: grid;
    place-content: center;
    overflow: hidden;
    text-align: center;
    background: var(--yellow);
  }
  .turn::before, .turn::after {
    content: '';
    position: absolute;
    width: 34vw;
    aspect-ratio: 1;
    border: 2px solid var(--ink);
    transform: rotate(45deg);
  }
  .turn::before { left: -24vw; top: 8%; }
  .turn::after { right: -22vw; bottom: -7%; border-radius: 50%; }
  .turn p { margin: 0; font: 700 12px/1 'JetBrains Mono', monospace; letter-spacing: .16em; text-transform: uppercase; }
  .turn h2 { margin: 24px 0; font-size: clamp(62px, 11vw, 174px); line-height: .82; text-transform: uppercase; }
  .turn > span { font-size: clamp(32px, 5vw, 70px); }

  .highlights {
    position: relative;
    padding: 0 clamp(20px, 5vw, 80px) 20vh;
    display: grid;
    grid-template-columns: minmax(250px, .72fr) 1.28fr;
    gap: clamp(34px, 7vw, 120px);
    background: var(--warm-white);
  }
  .highlights-rail {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 14vh 0 8vh;
    align-self: start;
    display: flex;
    flex-direction: column;
  }
  .highlights-rail .eyebrow { color: #d84c3b; }
  .highlights-rail h2 { font-size: clamp(46px, 5.5vw, 88px); line-height: .88; }
  .highlight-index { margin-top: auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; font: 800 12px/1 'JetBrains Mono', monospace; }
  .highlight-index i { height: 2px; background: var(--ink); }
  .highlight-index span:first-child { font-size: 34px; }
  .rail-note { margin: 18px 0 0; color: rgba(17,20,38,.55); font: 500 11px/1.45 'JetBrains Mono', monospace; text-transform: uppercase; }

  .highlight-stack { padding-top: 18vh; }
  .highlight-card {
    min-height: min(76vh, 760px);
    margin-bottom: 18vh;
    padding: clamp(24px, 4vw, 58px);
    border: 2px solid var(--ink);
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    background: var(--card-accent);
    box-shadow: 0 0 0 rgba(17,20,38,0);
    transform: translateY(18px) rotate(calc((var(--card-order) - 2) * .16deg));
    transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s;
  }
  .highlight-card.is-current { transform: translateY(0) rotate(0); box-shadow: 14px 16px 0 var(--ink); }
  .card-top, .card-foot { display: flex; justify-content: space-between; gap: 20px; font: 800 10px/1.25 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
  .card-mark {
    width: 100%;
    height: clamp(100px, 13vw, 190px);
    margin: clamp(32px, 7vh, 76px) 0;
    display: flex;
    align-items: end;
    justify-content: center;
    gap: clamp(5px, 1.3vw, 18px);
  }
  .card-mark i { display: block; background: var(--ink); }
  .card-mark--pulse i { width: 8%; border-radius: 99px; }
  .card-mark--pulse i:nth-child(1), .card-mark--pulse i:nth-child(8) { height: 22%; }
  .card-mark--pulse i:nth-child(2), .card-mark--pulse i:nth-child(7) { height: 48%; }
  .card-mark--pulse i:nth-child(3), .card-mark--pulse i:nth-child(6) { height: 76%; }
  .card-mark--pulse i:nth-child(4), .card-mark--pulse i:nth-child(5) { height: 100%; }
  .card-mark--signal { align-items: center; }
  .card-mark--signal i { width: 9%; aspect-ratio: 1; border-radius: 50%; transform: scale(calc(.4 + var(--i, 1))); }
  .card-mark--signal i:nth-child(1), .card-mark--signal i:nth-child(8) { width: 4%; }
  .card-mark--signal i:nth-child(2), .card-mark--signal i:nth-child(7) { width: 7%; }
  .card-mark--signal i:nth-child(3), .card-mark--signal i:nth-child(6) { width: 11%; }
  .card-mark--signal i:nth-child(4), .card-mark--signal i:nth-child(5) { width: 15%; }
  .card-mark--learn { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; align-items: stretch; }
  .card-mark--learn i { border: 2px solid var(--ink); background: transparent; }
  .card-mark--learn i:nth-child(3n) { background: var(--ink); }
  .card-mark--ritual { align-items: center; }
  .card-mark--ritual i { width: clamp(18px, 3vw, 44px); aspect-ratio: 1; border-radius: 50%; }
  .card-mark--ritual i:nth-child(even) { background: transparent; border: 3px solid var(--ink); }
  .card-mark--system { display: grid; grid-template-columns: repeat(8, 1fr); gap: 3px; align-items: stretch; }
  .card-mark--system i { background: repeating-linear-gradient(135deg, var(--ink) 0 5px, transparent 5px 10px); border: 2px solid var(--ink); }
  .highlight-card h3 { max-width: 850px; margin: 0 0 24px; font-size: clamp(42px, 6vw, 92px); line-height: .88; letter-spacing: -.07em; }
  .highlight-card > p { max-width: 720px; margin: 0 0 54px; font-size: clamp(16px, 1.6vw, 24px); line-height: 1.4; }
  .card-foot { margin-top: auto; align-items: end; }
  .card-foot > span { max-width: 48%; }
  .card-foot a { padding: 12px 0 8px; border-bottom: 2px solid var(--ink); text-decoration: none; }
  .card-foot a:hover { background: var(--ink); color: var(--card-accent); }

  .ledger {
    padding: clamp(100px, 13vw, 200px) clamp(20px, 6vw, 96px);
    background: #e6dfd3;
  }
  .ledger header { display: grid; grid-template-columns: .6fr 1.4fr; gap: 50px; align-items: start; margin-bottom: 90px; }
  .ledger h2 { max-width: 900px; margin: 0; font-size: clamp(58px, 8vw, 126px); line-height: .86; }
  .ledger ol { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
  .ledger li { min-height: 130px; display: grid; grid-template-columns: 130px 120px 1fr; align-items: center; gap: 28px; border-bottom: 1px solid rgba(17,20,38,.35); }
  .ledger time { font: 800 11px/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
  .ledger strong { font-size: clamp(50px, 6vw, 82px); line-height: .8; letter-spacing: -.07em; }
  .ledger li p { max-width: 650px; margin: 0; font-size: clamp(16px, 1.5vw, 22px); line-height: 1.35; }
  .ledger-key { display: flex; align-items: center; gap: 10px; margin: 28px 0 0; color: rgba(17,20,38,.6); font: 600 10px/1.4 'JetBrains Mono', monospace; text-transform: uppercase; }
  .ledger-key span { width: 20px; height: 2px; background: var(--red); }

  .closing {
    min-height: 100svh;
    padding: clamp(110px, 15vw, 220px) clamp(20px, 7vw, 112px) 30px;
    display: flex;
    flex-direction: column;
