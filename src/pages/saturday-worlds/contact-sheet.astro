---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import manifest from '../../../public/images/saturday-worlds/2026-10-24/manifest.json';
import '../../styles/saturday-worlds.css';
const labels = {'coastal':'Coastal futures','scene':'South Bay scene','ad-selected':'Selected ad representative','ad-alternate':'Alternate ad variation'};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>All 360 Saturday worlds · PointCast</title><meta name="description" content="The complete October 24, 2026 contact sheet: 100 coastal images, 100 scenes, 40 selected ad representatives and 120 alternate ad variations." /><link rel="canonical" href="https://pointcast.xyz/saturday-worlds/contact-sheet/" /></head><body><main class="contact-sheet"><a href="/saturday-worlds/">← Back to Saturday, slightly elsewhere.</a><p class="eyebrow" style="margin-top:30px">Saturday, October 24, 2026 · Pacific</p><h1>The whole afternoon.<br />All 360 images.</h1><p>100 coastal images, 100 South Bay scenes and 160 ad images representing 40 concepts. Selected ad representatives and alternate variations are labeled individually. These are speculative AI-made places and campaigns, not built projects, real offers or endorsements. Tap a title for the interactive viewer, or open the optimized image directly.</p><p><a href="/saturday-worlds/#all-images">Search and filter the collection ↗</a> · <a href="/images/saturday-worlds/2026-10-24/manifest.json">Image record (JSON)</a></p><div class="worlds-gallery">{manifest.images.map(item => <figure><a href={item.src} target="_blank" rel="noopener" aria-label={`Open optimized image: ${item.title}, variation ${item.variant}`}><img class="worlds-card-image" src={item.thumb} width={item.thumbWidth} height={item.thumbHeight} alt={`${item.title} — speculative AI-generated ${item.brand} artwork, variation ${item.variant} of 4`} loading="lazy" decoding="async" /></a><figcaption><a href={`/saturday-worlds/#image=${item.id}`}>{item.title}</a><span class="group-tag">{labels[item.category]} · {item.variant}/4<br />{item.brand}</span>{item.headline && <p style="margin-top:8px">“{item.headline}”<br />{item.shortCopy}</p>}</figcaption></figure>)}</div><p style="margin-top:40px"><a href="/saturday-worlds/">Take the scenic route again ↑</a></p></main></body></html>
