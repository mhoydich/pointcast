---
/**
 * /finance — education-first room for majors, crypto, and alt case studies.
 * Twin: /finance.json. Not advice. Not an offer.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import finance from '../data/finance.json';
import '../styles/finance.css';

const title = 'Finance';
const description = finance.dek;
const mn = finance.alts.cases.find((item) => item.id === 'mn-corgi-mangos');
const placeholders = finance.alts.cases.filter((item) => item.status === 'placeholder');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  '@id': 'https://pointcast.xyz/finance/#resource',
  name: 'Finance',
  description,
  url: 'https://pointcast.xyz/finance/',
  inLanguage: 'en-US',
  learningResourceType: 'lesson',
  isAccessibleForFree: true,
  dateModified: finance.version,
  educationalUse: 'The public can read how listed markets, crypto, and packaged alts differ. Not investment advice.',
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  hideAds
  showNetworkStrip={false}
  alternates={[
    { type: 'application/json', href: '/finance.json', title: 'Finance room JSON' },
  ]}
>
  <main class="fin">
    <nav class="fin-crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a>
      <span aria-hidden="true">/</span>
      <span>Finance</span>
    </nav>

    <header class="fin-hero" id="masthead">
      <p class="fin-kicker">Education room · {finance.version}</p>
      <h1>{finance.title}</h1>
      <p class="fin-dek">{finance.dek}</p>
      <p class="fin-status">{finance.status}</p>
      <p class="fin-stance">{finance.stance}</p>
      <div class="fin-banner" role="note">
        <p>{finance.disclaimer}</p>
      </div>
      <nav class="fin-tools" aria-label="On this page">
        <a href="#principles">First principles</a>
        <a href="#majors">Majors</a>
        <a href="#crypto">Crypto</a>
        <a href="#alts">Alts</a>
        <a href="#bots">Bots</a>
        <a href="#portend">2027 / 2028</a>
        <a href="/finance.json">JSON twin</a>
      </nav>
    </header>

    <section class="fin-section" id="principles" aria-labelledby="principles-title">
      <p class="fin-kicker">{finance.principles.kicker}</p>
      <h2 id="principles-title">{finance.principles.title}</h2>
      <p class="fin-intro">{finance.principles.intro}</p>
      <div class="fin-grid">
        {finance.principles.modules.map((module) => (
          <article class="fin-card" id={module.id}>
            <p class="fin-id">{module.id}</p>
            <h3>{module.title}</h3>
            <p>{module.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="fin-section" id="majors" aria-labelledby="majors-title">
      <p class="fin-kicker">{finance.majors.kicker}</p>
      <h2 id="majors-title">{finance.majors.title}</h2>
      <p class="fin-intro">{finance.majors.intro}</p>
      <div class="fin-grid">
        {finance.majors.cards.map((card) => (
          <article class="fin-card" id={card.id}>
            <p class="fin-id">{card.id}</p>
            <h3>{card.title}</h3>
            <ul class="fin-examples">
              {card.examples.map((example) => <li>{example}</li>)}
            </ul>
            <p>{card.body}</p>
            {card.expandable && <p class="fin-placeholder">{card.placeholder}</p>}
          </article>
        ))}
      </div>
    </section>

    <section class="fin-section" id="crypto" aria-labelledby="crypto-title">
      <p class="fin-kicker">{finance.crypto.kicker}</p>
      <h2 id="crypto-title">{finance.crypto.title}</h2>
      <p class="fin-intro">{finance.crypto.intro}</p>
      <div class="fin-lanes">
        {finance.crypto.lanes.map((lane) => (
          <article class="fin-lane" id={lane.id}>
            <p class="fin-id">{lane.id}</p>
            <h3>{lane.title}</h3>
            <p>{lane.body}</p>
          </article>
        ))}
      </div>
      <div class="fin-adjacent">
        {finance.crypto.adjacent.map((room) => (
          <a href={room.href}>
            <article class="fin-card" id={`adjacent-${room.id}`}>
              <p class="fin-id">adjacent · {room.id}</p>
              <h3>{room.title}</h3>
              <p>{room.note}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    <section class="fin-section" id="alts" aria-labelledby="alts-title">
      <p class="fin-kicker">{finance.alts.kicker}</p>
      <h2 id="alts-title">{finance.alts.title}</h2>
      <p class="fin-intro">{finance.alts.intro}</p>

      {mn && (
        <article class="fin-case" id={mn.id}>
          <p class="fin-kicker">{mn.label} · {mn.ticker} · live case</p>
          <h3>{mn.title}</h3>
          <p>{mn.summary}</p>
          <h4>What it is</h4>
          <ul class="fin-facts">
            {mn.identity.map((line) => <li>{line}</li>)}
          </ul>
          <h4>The access claim</h4>
          <p>{mn.marketingClaim}</p>
          <h4>The mechanism</h4>
          <ul class="fin-facts">
            {mn.mechanism.map((line) => <li>{line}</li>)}
          </ul>
          <h4>The rest of the book</h4>
          <p>{mn.restOfBook}</p>

          <h4>Snapshot · as of {mn.snapshot.asOf}</h4>
          <p class="fin-note">{mn.snapshot.label} Source: <a href={mn.snapshot.sourceUrl}>{mn.snapshot.sourceTitle}</a>.</p>
          <div class="fin-table-wrap">
            <table class="fin-table">
              <caption class="fin-small">Fund facts reported on the issuer page for {mn.snapshot.asOf}. Retrieved {mn.snapshot.retrieved}.</caption>
              <thead>
                <tr><th>Fact</th><th>Reported figure</th></tr>
              </thead>
              <tbody>
                {mn.snapshot.fundFacts.map((fact) => (
                  <tr><td>{fact.label}</td><td>{fact.value}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="fin-table-wrap">
            <table class="fin-table">
              <caption class="fin-small">Company weights and lines as printed on the issuer holdings table. Market values are fund-reported figures for that date, not live company prices.</caption>
              <thead>
                <tr><th>Name</th><th>Company weight</th><th>Line</th><th>Line weight</th><th>Reported value</th></tr>
              </thead>
              <tbody>
                {mn.snapshot.companyWeights.flatMap((company) =>
                  company.lines.map((line, index) => (
                    <tr>
                      <td>{index === 0 ? `${company.letter} · ${company.name}` : ''}</td>
                      <td>{index === 0 ? company.weight : ''}</td>
                      <td>{line.holding}</td>
                      <td>{line.weight}</td>
                      <td>{line.marketValue}</td>
                    </tr>
                  ))
                )}
                <tr>
                  <td>Cash</td>
                  <td>{mn.snapshot.cashWeight}</td>
                  <td>Cash</td>
                  <td>{mn.snapshot.cashWeight}</td>
                  <td>—</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="fin-small">{mn.snapshot.derived.label} OpenAI plus Anthropic: {mn.snapshot.derived.openaiPlusAnthropic}. Meta, Nvidia, and Alphabet: {mn.snapshot.derived.metaNvidiaAlphabet}. {mn.snapshot.derived.note}</p>
          <p class="fin-note">{mn.nicoNote}</p>

          <div class="fin-points">
            {mn.teachingPoints.map((point) => (
              <article id={point.id}>
                <p class="fin-id">{point.id}</p>
                <h4>{point.title}</h4>
                <p>{point.body}</p>
              </article>
            ))}
          </div>
          <p class="fin-small">Sources</p>
          <ul class="fin-facts">
            {mn.links.map((link) => (
              <li><a href={link.url}>{link.title}</a></li>
            ))}
          </ul>
        </article>
      )}

      <div class="fin-slots">
        {placeholders.map((slot) => (
          <article class="fin-slot" id={slot.id}>
            <p class="fin-kicker">{slot.label} · placeholder</p>
            <h3>{slot.title}</h3>
            <p>{slot.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="fin-section" id="bots" aria-labelledby="bots-title">
      <p class="fin-kicker">{finance.bots.kicker}</p>
      <h2 id="bots-title">{finance.bots.title}</h2>
      <p class="fin-intro">{finance.bots.nearTerm}</p>
      <p>{finance.bots.later}</p>
      <article class="fin-card" id={finance.bots.swarmHook.id}>
        <p class="fin-id">{finance.bots.swarmHook.status}</p>
        <h3>Swarm hook</h3>
        <p>{finance.bots.swarmHook.note}</p>
        <ul class="fin-examples">
          {finance.bots.swarmHook.watches.map((watch) => <li>{watch}</li>)}
        </ul>
      </article>
      <div class="fin-points">
        {finance.bots.quiz.map((item) => (
          <article id={item.id}>
            <p class="fin-id">quiz · {item.sectionId}</p>
            <p>{item.prompt}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="fin-section" id="portend" aria-labelledby="portend-title">
      <p class="fin-kicker">{finance.portend.kicker}</p>
      <h2 id="portend-title">{finance.portend.title}</h2>
      <p class="fin-intro">{finance.portend.intro}</p>
      <p class="fin-small">Related, and separate: <a href={finance.portend.relatedThesis}>Nouns Nation investment thesis</a>.</p>
      <div class="fin-years">
        {finance.portend.years.map((year) => (
          <article class="fin-year" id={year.id}>
            <p class="fin-kicker">{year.year}</p>
            <h3>{year.title}</h3>
            <p>{year.body}</p>
          </article>
        ))}
      </div>
    </section>

    <footer class="fin-footer" id="disclaimer">
      <p class="fin-kicker">Disclaimer</p>
      <p>{finance.disclaimer}</p>
      <p class="fin-small">{finance.voice}</p>
      <p><a href="/finance.json">Machine twin</a> · <a href="/for-agents">For agents</a> · <a href="/">PointCast</a></p>
    </footer>
  </main>
</BlockLayout>
