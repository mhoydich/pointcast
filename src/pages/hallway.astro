---
/**
 * /hallway — The Hallway. A short walk past PointCast's rooms.
 *
 * Weekend project, 2026-10-30, after Mike Hoydich's interest in a 3D side
 * experience informed by Frank Lloyd Wright's organic architecture. Not a
 * copy of any building: a low, warm corridor (compression) with a ribbon of
 * art-glass windows on one side and doorways on the other, opening at the
 * end into a tall hearth room (release).
 *
 * Every doorway plays its room's sound from its own spot in space (Web Audio
 * HRTF panners follow the camera), so you hear a room as you pass it. Step
 * up to a door and press E, or tap Enter, to go in. Everything is drawn with
 * Three.js and canvas textures; nothing is downloaded but the code.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const rooms = [
  { id: 'hour', name: 'The Hour', href: '/hour', note: 'one scene, changing every hour', color: '#ffb86b' },
  { id: 'drum', name: 'Drum Room', href: '/drum-room', note: 'shared drums, loud', color: '#ff6b5a' },
  { id: 'keys', name: 'Keyboard Bloom', href: '/keyboard', note: 'the whole keyboard is an instrument', color: '#7fd6a6' },
  { id: 'bells', name: 'Bell Choir', href: '/bell-choir', note: 'shared bells', color: '#9fb8ff' },
  { id: 'arcade', name: 'Brick Choir', href: '/brick-choir', note: 'the music arcade', color: '#f7d36b' },
  { id: 'haunted', name: 'Haunted Drum Room', href: '/haunted-drum', note: 'one beat, with ghosts', color: '#c77dff' },
];
const description = 'The Hallway: a short, warm walk past PointCast\'s rooms, in the spirit of Frank Lloyd Wright\'s organic architecture. Low ceiling, art-glass windows, a hearth at the end, and every doorway playing its room as you pass.';
const canonical = 'https://pointcast.xyz/hallway';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#page`,
  name: 'The Hallway',
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz/' },
  author: { '@type': 'Person', name: 'Michael Hoydich' },
  contributor: { '@type': 'Organization', name: 'Claude Code' },
  datePublished: '2026-10-30',
};
---

<BlockLayout
  title="The Hallway"
  description={description}
  image="/images/saturday-worlds/2026-10-24/s03-v1.webp"
  imageAlt="A low timber building with long horizontal rooflines among trees and a coastal garden, from Michael Hoydich's Saturday Worlds."
  themeColor="#2a1a10"
  immersive
  jsonLd={jsonLd}
>
  <main class="hw" data-hw>
    <script type="application/json" id="hw-rooms" set:html={JSON.stringify(rooms)} />
    <div class="hw-view" data-view>
      <canvas data-canvas aria-label="A 3D hallway. Use W A S D or the arrow keys to walk, drag to look around, and E to enter a room."></canvas>

      <header class="hw-top">
        <a class="hw-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="hw-title">THE HALLWAY</span>
        <button type="button" class="hw-snd" data-snd aria-pressed="false">Sound off</button>
      </header>

      <div class="hw-start" data-start>
        <div>
          <p class="hw-eyebrow">PointCast</p>
          <h1>The Hallway</h1>
          <p>A short walk past the rooms. Every doorway is playing something. The hearth is at the end.</p>
          <button type="button" data-begin>Walk in with sound</button>
          <p class="hw-help">W A S D or arrows to walk · drag to look · E to enter a room</p>
        </div>
      </div>

      <div class="hw-prompt" data-prompt hidden>
        <a data-enter href="/">Enter <strong data-enter-name>Room</strong></a>
        <span data-enter-note></span>
      </div>

      <div class="hw-pad" aria-label="Walk" role="group">
        <button type="button" data-move="left" aria-label="Turn left">◀</button>
        <button type="button" data-move="fwd" aria-label="Walk forward">▲</button>
        <button type="button" data-move="back" aria-label="Walk back">▼</button>
        <button type="button" data-move="right" aria-label="Turn right">▶</button>
      </div>
    </div>

    <section class="hw-list" aria-label="The rooms off the hallway">
      <h2>Off the hallway</h2>
      <ul>
        {rooms.map((r) => (<li><a href={r.href}>{r.name}</a> <span>{r.note}</span></li>))}
      </ul>
      <p class="hw-credit">Built by Claude Code for Michael Hoydich, Halloween weekend 2026. Inspired by organic architecture: low eaves, long horizontal lines, warm wood, a hearth at the center.</p>
    </section>
  </main>
</BlockLayout>

<style>
  .hw { background: #1a120c; color: #f4e8d6; font-family: Inter, system-ui, sans-serif; }
  .hw-view { position: relative; height: 100svh; min-height: 420px; overflow: hidden; touch-action: none; }
  .hw-view canvas { display: block; width: 100%; height: 100%; cursor: grab; }
  .hw-view canvas:active { cursor: grabbing; }
  .hw-top { position: absolute; top: 0; left: 0; right: 0; display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 14px clamp(16px, 4vw, 32px); font: 600 12px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.16em; pointer-events: none; }
  .hw-top > * { pointer-events: auto; }
  .hw-home { color: #f4e8d6; text-decoration: none; }
  .hw-title { opacity: 0.7; }
  .hw-snd { font: inherit; letter-spacing: 0.08em; padding: 8px 12px; border-radius: 999px; border: 1px solid rgba(244,232,214,0.35); background: rgba(26,18,12,0.5); color: #f4e8d6; cursor: pointer; }
  .hw-start { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: radial-gradient(ellipse at center, rgba(26,18,12,0.35), rgba(26,18,12,0.85)); }
  .hw-start > div { max-width: 460px; text-align: center; }
  .hw-start h1 { margin: 0 0 10px; font: 600 clamp(34px, 7vw, 56px)/1 Georgia, serif; }
  .hw-start p { color: rgba(244,232,214,0.8); line-height: 1.5; }
  .hw-eyebrow { font: 600 12px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #e9a35b !important; }
  .hw-start button { margin-top: 8px; font: 600 15px/1 Inter, system-ui, sans-serif; padding: 14px 20px; border-radius: 999px; border: 0; background: #e9a35b; color: #1a120c; cursor: pointer; }
  .hw-help { font-size: 13px; }
  .hw-prompt { position: absolute; left: 50%; bottom: 96px; transform: translateX(-50%); display: grid; justify-items: center; gap: 4px; padding: 12px 18px; border-radius: 14px; background: rgba(26,18,12,0.72); border: 1px solid rgba(233,163,91,0.6); text-align: center; }
  .hw-prompt a { color: #f4e8d6; font-size: 18px; text-decoration: none; }
  .hw-prompt span { font-size: 13px; color: rgba(244,232,214,0.75); }
  .hw-pad { position: absolute; right: 16px; bottom: 16px; display: grid; grid-template-columns: repeat(3, 48px); grid-template-rows: repeat(2, 48px); gap: 6px; }
  .hw-pad button { border-radius: 12px; border: 1px solid rgba(244,232,214,0.3); background: rgba(26,18,12,0.55); color: #f4e8d6; font-size: 16px; touch-action: none; }
  .hw-pad [data-move='fwd'] { grid-column: 2; grid-row: 1; }
  .hw-pad [data-move='left'] { grid-column: 1; grid-row: 2; }
  .hw-pad [data-move='back'] { grid-column: 2; grid-row: 2; }
  .hw-pad [data-move='right'] { grid-column: 3; grid-row: 2; }
  @media (hover: hover) and (pointer: fine) { .hw-pad { opacity: 0.55; } }
  .hw-list { max-width: 760px; margin: 0 auto; padding: 28px 16px 40px; }
  .hw-list h2 { font: 600 24px/1.2 Georgia, serif; margin: 0 0 12px; }
  .hw-list ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .hw-list a { color: #f4e8d6; font-weight: 600; }
  .hw-list span { color: rgba(244,232,214,0.7); font-size: 14px; }
  .hw-credit { color: rgba(244,232,214,0.6); font-size: 13px; margin-top: 20px; }
</style>

<script>
  import * as THREE from 'three';

  type Room = { id: string; name: string; href: string; note: string; color: string };
  const rooms: Room[] = JSON.parse(document.getElementById('hw-rooms')!.textContent || '[]');
  const root = document.querySelector<HTMLElement>('[data-hw]')!;
  const view = root.querySelector<HTMLElement>('[data-view]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;

  // ── layout (meters) ─────────────────────────────────────────
  const HALL_W = 3.2;
  const HALL_H = 2.25; // low: compression
  const HALL_LEN = 34;
  const HEARTH_W = 9;
  const HEARTH_H = 5.6; // tall: release
  const HEARTH_LEN = 10;
  const DOOR_Z = rooms.map((_, i) => -4 - i * 5);

  // ── renderer and scene ──────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.1;
  const scene = new THREE.Scene();
  scene.background = new THREE.Color('#120b07');
  scene.fog = new THREE.Fog('#1a110a', 8, 40);
  const camera = new THREE.PerspectiveCamera(68, 1, 0.05, 120);
  camera.position.set(-0.3, 1.6, 2.5);
  let yaw = 0;
  let pitch = 0;

  // ── canvas textures ─────────────────────────────────────────
  function canvasTexture(w: number, h: number, draw: (c: CanvasRenderingContext2D) => void, repeat: [number, number] = [1, 1]) {
    const cv = document.createElement('canvas');
    cv.width = w; cv.height = h;
    draw(cv.getContext('2d')!);
    const t = new THREE.CanvasTexture(cv);
    t.colorSpace = THREE.SRGBColorSpace;
    t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(repeat[0], repeat[1]);
    t.anisotropy = 4;
    return t;
  }
  const rand = (() => { let s = 7; return () => ((s = (s * 16807) % 2147483647) / 2147483647); })();

  const floorTex = canvasTexture(512, 512, (c) => {
    for (let y = 0; y < 512; y += 32) {
      let x = -rand() * 200;
      while (x < 512) {
        const len = 140 + rand() * 180;
        const tone = 92 + rand() * 30;
        c.fillStyle = `rgb(${tone + 40}, ${tone - 6}, ${tone - 46})`;
        c.fillRect(x, y, len, 31);
        c.strokeStyle = 'rgba(40,20,8,0.25)';
        for (let g = 0; g < 6; g += 1) { c.beginPath(); c.moveTo(x, y + 4 + g * 5); c.lineTo(x + len, y + 4 + g * 5 + (rand() - 0.5) * 3); c.stroke(); }
        x += len + 1;
      }
      c.fillStyle = 'rgba(30,14,6,0.6)'; c.fillRect(0, y + 31, 512, 1);
    }
  }, [2, 14]);

  const brickTex = canvasTexture(512, 256, (c) => {
    c.fillStyle = '#d9c6a8'; c.fillRect(0, 0, 512, 256); // raked mortar
    const bh = 14; const bw = 96;
    for (let row = 0; row * (bh + 4) < 256; row += 1) {
      const off = row % 2 ? bw / 2 : 0;
      for (let x = -off; x < 512; x += bw + 3) {
        const r = 150 + rand() * 30; const g = 92 + rand() * 20; const b = 64 + rand() * 14;
        c.fillStyle = `rgb(${r},${g},${b})`;
        c.fillRect(x, row * (bh + 4) + 2, bw, bh); // long, thin "Roman" brick
      }
    }
  }, [8, 2]);

  const panelTex = canvasTexture(256, 256, (c) => {
    c.fillStyle = '#7a4a2a'; c.fillRect(0, 0, 256, 256);
    for (let y = 0; y < 256; y += 2) { c.fillStyle = `rgba(${40 + rand() * 30},${18 + rand() * 12},6,0.08)`; c.fillRect(0, y, 256, 1); }
    c.fillStyle = 'rgba(30,14,4,0.55)';
    for (let y = 0; y < 256; y += 64) c.fillRect(0, y, 256, 3); // horizontal battens
  }, [10, 1]);

  function skyColors() {
    const h = new Date().getHours();
    if (h >= 6 && h < 10) return ['#ffd9b0', '#9fc4e8'];
    if (h >= 10 && h < 17) return ['#cfe6ff', '#6fa6dc'];
    if (h >= 17 && h < 20) return ['#ffb36b', '#6b4a8c'];
    return ['#2a2f5a', '#0b0d22'];
  }
  const [skyTop, skyBottom] = skyColors();
  const glassTex = canvasTexture(256, 128, (c) => {
    const gr = c.createLinearGradient(0, 0, 0, 128);
    gr.addColorStop(0, skyTop); gr.addColorStop(1, skyBottom);
    c.fillStyle = gr; c.fillRect(0, 0, 256, 128);
    // art glass: thin came lines, a rectilinear tree with small colored squares
    c.strokeStyle = 'rgba(40,30,20,0.85)'; c.lineWidth = 2;
    c.strokeRect(1, 1, 254, 126);
    c.beginPath(); c.moveTo(128, 128); c.lineTo(128, 18); c.stroke();
    [[96, 160, 40], [80, 176, 64], [104, 152, 90]].forEach(([a, b, y]) => { c.beginPath(); c.moveTo(a, y); c.lineTo(b, y); c.moveTo(a, y); c.lineTo(a, y + 22); c.moveTo(b, y); c.lineTo(b, y + 22); c.stroke(); });
    c.beginPath(); c.moveTo(20, 0); c.lineTo(20, 128); c.moveTo(236, 0); c.lineTo(236, 128); c.stroke();
    [['#d94f2b', 120, 12], ['#e9b84a', 74, 58], ['#3f8f6b', 172, 58], ['#d94f2b', 98, 84], ['#3f6fa8', 150, 84]].forEach(([col, x, y]) => { c.fillStyle = col as string; c.fillRect(x as number, y as number, 14, 14); c.strokeRect(x as number, y as number, 14, 14); });
  }, [1, 1]);

  const stoneTex = canvasTexture(256, 256, (c) => {
    c.fillStyle = '#8a7a66'; c.fillRect(0, 0, 256, 256);
    let y = 0;
    while (y < 256) {
      const h = 12 + rand() * 22; let x = -rand() * 40;
      while (x < 256) { const w = 30 + rand() * 70; const t = 110 + rand() * 50; c.fillStyle = `rgb(${t},${t - 12},${t - 28})`; c.fillRect(x + 2, y + 2, w - 4, h - 4); x += w; }
      y += h;
    }
  }, [3, 3]);

  // ── materials ───────────────────────────────────────────────
  const mFloor = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 0.55, metalness: 0.05 });
  const mBrick = new THREE.MeshStandardMaterial({ map: brickTex, roughness: 0.95 });
  const mPanel = new THREE.MeshStandardMaterial({ map: panelTex, roughness: 0.7 });
  const mWood = new THREE.MeshStandardMaterial({ color: '#6b3e22', roughness: 0.6 });
  const mPlaster = new THREE.MeshStandardMaterial({ color: '#e8d9bd', roughness: 1 });
  const mGlass = new THREE.MeshBasicMaterial({ map: glassTex });
  const mStone = new THREE.MeshStandardMaterial({ map: stoneTex, roughness: 1 });

  function box(w: number, h: number, d: number, m: THREE.Material, x: number, y: number, z: number) {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
    mesh.position.set(x, y, z);
    scene.add(mesh);
    return mesh;
  }

  // ── the hall ────────────────────────────────────────────────
  const hallMidZ = -HALL_LEN / 2 + 3;
  box(HALL_W, 0.1, HALL_LEN, mFloor, 0, -0.05, hallMidZ);
  box(HALL_W + 0.6, 0.12, HALL_LEN, mPlaster, 0, HALL_H + 0.06, hallMidZ);
  // ceiling battens running the length: Wright's horizontal line
  for (let x = -1.35; x <= 1.36; x += 0.45) box(0.06, 0.05, HALL_LEN, mWood, x, HALL_H - 0.02, hallMidZ);
  // back wall behind the start
  box(HALL_W, HALL_H, 0.1, mPanel, 0, HALL_H / 2, 3);

  // left wall: brick below, ribbon of art glass above, wood band between
  const leftX = -HALL_W / 2;
  box(0.1, 1.15, HALL_LEN, mBrick, leftX, 0.575, hallMidZ);
  box(0.16, 0.08, HALL_LEN, mWood, leftX + 0.03, 1.19, hallMidZ);
  const paneW = 1.05;
  for (let z = 2.4; z > 3 - HALL_LEN; z -= paneW + 0.08) {
    const pane = new THREE.Mesh(new THREE.PlaneGeometry(paneW, 0.82), mGlass);
    pane.position.set(leftX + 0.01, 1.66, z - paneW / 2);
    pane.rotation.y = Math.PI / 2;
    scene.add(pane);
    box(0.06, 0.82, 0.08, mWood, leftX + 0.02, 1.66, z + 0.04); // mullion
  }
  box(0.16, 0.12, HALL_LEN, mWood, leftX + 0.03, 2.13, hallMidZ);
  // built-in bench under the windows
  box(0.45, 0.08, 6, mWood, leftX + 0.3, 0.45, -12);
  box(0.45, 0.08, 6, mWood, leftX + 0.3, 0.45, -24);

  // right wall: wood panels with door openings
  const rightX = HALL_W / 2;
  const doorW = 1.1;
  const doorH = 2.0;
  const doorEdges = DOOR_Z.map((z) => [z + doorW / 2, z - doorW / 2]);
  let cursor = 3;
  doorEdges.forEach(([near, far]) => {
    const len = cursor - near;
    if (len > 0) box(0.1, HALL_H, len, mPanel, rightX, HALL_H / 2, cursor - len / 2);
    box(0.1, HALL_H - doorH, doorW, mPanel, rightX, doorH + (HALL_H - doorH) / 2, (near + far) / 2); // lintel
    cursor = far;
  });
  const endLen = cursor - (3 - HALL_LEN);
  box(0.1, HALL_H, endLen, mPanel, rightX, HALL_H / 2, cursor - endLen / 2);

  // ── the rooms behind each door ──────────────────────────────
  type Door = { room: Room; z: number; light: THREE.PointLight; glow: THREE.Mesh };
  const doors: Door[] = rooms.map((room, i) => {
    const z = DOOR_Z[i];
    const color = new THREE.Color(room.color);
    // alcove: a small lit room you can see into
    box(2.2, 0.1, doorW + 1.2, mFloor, rightX + 1.1, -0.05, z);
    box(0.1, doorH + 0.3, doorW + 1.2, mPlaster, rightX + 2.2, (doorH + 0.3) / 2, z);
    box(2.2, doorH + 0.3, 0.1, mPlaster, rightX + 1.1, (doorH + 0.3) / 2, z + (doorW + 1.2) / 2);
    box(2.2, doorH + 0.3, 0.1, mPlaster, rightX + 1.1, (doorH + 0.3) / 2, z - (doorW + 1.2) / 2);
    box(2.2, 0.1, doorW + 1.2, mPlaster, rightX + 1.1, doorH + 0.3, z);
    const glow = new THREE.Mesh(new THREE.PlaneGeometry(1.6, 1.4), new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.85 }));
    glow.position.set(rightX + 2.14, 1.1, z);
    glow.rotation.y = -Math.PI / 2;
    scene.add(glow);
    const light = new THREE.PointLight(color, 3.5, 6, 1.6);
    light.position.set(rightX + 1.2, 1.4, z);
    scene.add(light);
    // a sign above the door
    const signTex = canvasTexture(512, 96, (c) => {
      c.fillStyle = '#2a1708'; c.fillRect(0, 0, 512, 96);
      c.strokeStyle = room.color; c.lineWidth = 3; c.strokeRect(6, 6, 500, 84);
      c.fillStyle = '#f4e8d6'; c.font = '600 44px Georgia, serif'; c.textAlign = 'center'; c.textBaseline = 'middle';
      c.fillText(room.name, 256, 50);
    });
    const sign = new THREE.Mesh(new THREE.PlaneGeometry(1.3, 0.24), new THREE.MeshBasicMaterial({ map: signTex }));
    sign.position.set(rightX - 0.06, doorH + 0.12, z);
    sign.rotation.y = -Math.PI / 2;
    scene.add(sign);
    return { room, z, light, glow };
  });

  // ── the hearth room: release ────────────────────────────────
  const hz0 = 3 - HALL_LEN; // where the hall ends
  const hzMid = hz0 - HEARTH_LEN / 2;
  box(HEARTH_W, 0.1, HEARTH_LEN, mFloor, 0, -0.05, hzMid);
  box(HEARTH_W, 0.12, HEARTH_LEN, mPlaster, 0, HEARTH_H, hzMid);
  for (let z = hz0 - 0.5; z > hz0 - HEARTH_LEN; z -= 0.8) box(HEARTH_W, 0.12, 0.08, mWood, 0, HEARTH_H - 0.1, z);
  box(0.1, HEARTH_H, HEARTH_LEN, mBrick, -HEARTH_W / 2, HEARTH_H / 2, hzMid);
  box(0.1, HEARTH_H, HEARTH_LEN, mBrick, HEARTH_W / 2, HEARTH_H / 2, hzMid);
  // the wall where the hall opens: frame the low opening
  box((HEARTH_W - HALL_W) / 2, HEARTH_H, 0.12, mPanel, -(HALL_W + (HEARTH_W - HALL_W) / 2) / 2 - 0.0, HEARTH_H / 2, hz0);
  box((HEARTH_W - HALL_W) / 2, HEARTH_H, 0.12, mPanel, (HALL_W + (HEARTH_W - HALL_W) / 2) / 2, HEARTH_H / 2, hz0);
  box(HALL_W, HEARTH_H - HALL_H, 0.12, mPanel, 0, HALL_H + (HEARTH_H - HALL_H) / 2, hz0);
  // tall windows in the side walls of the hearth room
  [-1, 1].forEach((side) => {
    for (let z = hz0 - 1.5; z > hz0 - HEARTH_LEN + 1; z -= 1.6) {
      const pane = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 3.2), mGlass);
      pane.position.set(side * (HEARTH_W / 2 - 0.06), 2.6, z);
      pane.rotation.y = side < 0 ? Math.PI / 2 : -Math.PI / 2;
      scene.add(pane);
    }
  });
  // the hearth: a broad stone mass with a deep, low firebox
  const backZ = hz0 - HEARTH_LEN;
  box(HEARTH_W, HEARTH_H, 0.2, mStone, 0, HEARTH_H / 2, backZ);
  box(3.6, 3.4, 0.8, mStone, 0, 1.7, backZ + 0.5);
  box(4.6, 0.25, 1.2, mStone, 0, 0.12, backZ + 0.9); // raised hearth ledge
  const firebox = new THREE.Mesh(new THREE.PlaneGeometry(1.8, 0.9), new THREE.MeshBasicMaterial({ color: '#ff8a2a' }));
  firebox.position.set(0, 0.75, backZ + 0.91);
  scene.add(firebox);
  const fire = new THREE.PointLight('#ff8a3a', 8, 14, 1.4);
  fire.position.set(0, 1, backZ + 1.6);
  scene.add(fire);
  // benches facing the fire
  box(3.2, 0.1, 0.5, mWood, 0, 0.45, backZ + 4.2);
  box(0.5, 0.1, 2.4, mWood, -3, 0.45, backZ + 3);
  box(0.5, 0.1, 2.4, mWood, 3, 0.45, backZ + 3);

  // ── light ───────────────────────────────────────────────────
  scene.add(new THREE.HemisphereLight('#ffe7c4', '#2a1708', 0.55));
  for (let z = 1; z > hz0; z -= 6) {
    const lamp = new THREE.PointLight('#ffcf8a', 2.2, 7, 1.6);
    lamp.position.set(-0.8, HALL_H - 0.25, z);
    scene.add(lamp);
    box(0.32, 0.06, 0.32, new THREE.MeshBasicMaterial({ color: '#ffe2b0' }), -0.8, HALL_H - 0.05, z);
  }
  const windowLight = new THREE.DirectionalLight(skyTop, 0.6);
  windowLight.position.set(-6, 4, -10);
  scene.add(windowLight);

  // ── sound: each room plays from its doorway ─────────────────
  let actx: AudioContext | null = null;
  let master: GainNode;
  let soundOn = false;
  const loops: number[] = [];
  function voice(dest: AudioNode, f: number, t: number, dur: number, gain: number, type: OscillatorType = 'sine') {
    const c = actx!;
    const o = c.createOscillator(); const g = c.createGain();
    o.type = type; o.frequency.value = f;
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g).connect(dest); o.start(t); o.stop(t + dur + 0.05);
  }
  function noiseHit(dest: AudioNode, t: number, dur: number, gain: number, hp = 0) {
    const c = actx!;
    const b = c.createBuffer(1, Math.floor(c.sampleRate * dur), c.sampleRate);
    const d = b.getChannelData(0); for (let i = 0; i < d.length; i += 1) d[i] = Math.random() * 2 - 1;
    const s = c.createBufferSource(); s.buffer = b;
    const g = c.createGain(); g.gain.setValueAtTime(gain, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    if (hp) { const f = c.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = hp; s.connect(f).connect(g); } else s.connect(g);
    g.connect(dest); s.start(t);
  }
  function panner(x: number, z: number) {
    const p = actx!.createPanner();
    p.panningModel = 'HRTF'; p.distanceModel = 'inverse'; p.refDistance = 1.2; p.rolloffFactor = 1.6; p.maxDistance = 40;
    p.positionX.value = x; p.positionY.value = 1.3; p.positionZ.value = z;
    p.connect(master);
    return p;
  }
  const PATTERNS: Record<string, (dest: AudioNode, t: number, step: number) => void> = {
    hour: (d, t, s) => { if (s % 8 === 0) [0, 4, 7].forEach((n) => voice(d, 220 * 2 ** (n / 12), t, 3.5, 0.05, 'triangle')); if (s % 2 === 0) voice(d, 440 * 2 ** ([0, 2, 4, 7, 9][s % 5] / 12), t, 1.2, 0.04); },
    drum: (d, t, s) => { if (s % 4 === 0) voice(d, 60, t, 0.3, 0.5); if (s % 4 === 2) noiseHit(d, t, 0.15, 0.25, 1200); noiseHit(d, t, 0.04, 0.08, 7000); },
    keys: (d, t, s) => { if (s % 2 === 0 || Math.random() < 0.3) voice(d, 523 * 2 ** ([0, 2, 4, 7, 9, 12][(s * 5) % 6] / 12), t, 0.6, 0.08, 'triangle'); },
    bells: (d, t, s) => { if (s % 3 === 0) [1, 2.76].forEach((m, i) => voice(d, 392 * m * 2 ** ([0, 5, 7, 12][s % 4] / 12), t, 2.2 / (i + 1), 0.06 / (i + 1))); },
    arcade: (d, t, s) => { voice(d, 330 * 2 ** ([0, 4, 7, 12, 7, 4][s % 6] / 12), t, 0.12, 0.04, 'square'); },
    haunted: (d, t, s) => { if (s % 8 === 0) voice(d, 98, t, 3, 0.1); if (s % 4 === 0) voice(d, 48, t, 0.6, 0.35); if (s % 16 === 10) [1, 2.76, 5.4].forEach((m, i) => voice(d, 196 * m, t, 2.6 / (i + 1), 0.07 / (i + 1))); },
  };
  function startSound() {
    if (!actx) {
      const Ctx = window.AudioContext || (window as any).webkitAudioContext;
      actx = new Ctx();
      master = actx.createGain();
      master.gain.value = 0.9;
      master.connect(actx.destination);
      doors.forEach((door) => {
        const p = panner(rightX + 1.4, door.z);
        let step = 0;
        const play = PATTERNS[door.room.id];
        const stepMs = door.room.id === 'arcade' ? 160 : 250;
        loops.push(window.setInterval(() => { if (soundOn && play) play(p, actx!.currentTime + 0.03, step++); }, stepMs));
      });
      // the fire crackles
      const fp = panner(0, backZ + 1);
      loops.push(window.setInterval(() => { if (soundOn && Math.random() < 0.6) noiseHit(fp, actx!.currentTime + Math.random() * 0.2, 0.03 + Math.random() * 0.06, 0.2 + Math.random() * 0.3, 2000); }, 140));
    }
    if (actx.state === 'suspended') actx.resume();
    soundOn = true;
    sndBtn.setAttribute('aria-pressed', 'true');
    sndBtn.textContent = 'Sound on';
  }
  function stopSound() {
    soundOn = false;
    sndBtn.setAttribute('aria-pressed', 'false');
    sndBtn.textContent = 'Sound off';
  }
  const sndBtn = root.querySelector<HTMLButtonElement>('[data-snd]')!;
  sndBtn.addEventListener('click', () => (soundOn ? stopSound() : startSound()));

  // ── input ───────────────────────────────────────────────────
  const keys = new Set<string>();
  const held = new Set<string>();
  window.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if (['w', 'a', 's', 'd', 'arrowup', 'arrowdown', 'arrowleft', 'arrowright'].includes(k)) { keys.add(k); e.preventDefault(); }
    if (k === 'e' && nearDoor) location.href = nearDoor.room.href;
  });
  window.addEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));
  window.addEventListener('blur', () => { keys.clear(); held.clear(); });

  let dragging = false; let lastX = 0; let lastY = 0;
  canvas.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    yaw -= (e.clientX - lastX) * 0.005;
    pitch = Math.max(-0.7, Math.min(0.7, pitch - (e.clientY - lastY) * 0.004));
    lastX = e.clientX; lastY = e.clientY;
  });
  const endDrag = () => { dragging = false; };
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);
  root.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((b) => {
    const m = b.dataset.move!;
    b.addEventListener('pointerdown', (e) => { e.preventDefault(); held.add(m); b.setPointerCapture(e.pointerId); });
    const up = () => held.delete(m);
    b.addEventListener('pointerup', up); b.addEventListener('pointercancel', up); b.addEventListener('lostpointercapture', up);
  });

  const start = root.querySelector<HTMLElement>('[data-start]')!;
  root.querySelector<HTMLButtonElement>('[data-begin]')!.addEventListener('click', () => { start.hidden = true; startSound(); });

  // ── movement and collision ──────────────────────────────────
  function clampPosition(p: THREE.Vector3) {
    p.z = Math.min(2.6, Math.max(backZ + 2.2, p.z));
    if (p.x > rightX - 0.1) {
      // inside an alcove: stay between its side walls
      const alcove = doors.reduce((a, b) => (Math.abs(b.z - p.z) < Math.abs(a.z - p.z) ? b : a));
      const half = (doorW + 1.2) / 2 - 0.3;
      const limit = p.x > rightX + 0.2 ? half : doorW / 2 - 0.15;
      p.z = Math.max(alcove.z - limit, Math.min(alcove.z + limit, p.z));
    }
    const inHearth = p.z < hz0 - 0.3;
    const inDoorway = doors.find((d) => Math.abs(p.z - d.z) < doorW / 2 - 0.15);
    const maxX = inHearth ? HEARTH_W / 2 - 0.4 : inDoorway ? rightX + 1.6 : HALL_W / 2 - 0.35;
    const minX = inHearth ? -HEARTH_W / 2 + 0.4 : -HALL_W / 2 + 0.35;
    if (!inHearth && !inDoorway && p.x > HALL_W / 2 - 0.35) p.x = HALL_W / 2 - 0.35;
    p.x = Math.max(minX, Math.min(maxX, p.x));
    // leaving the hall into the hearth only through the opening
    if (!inHearth && p.z < hz0 + 0.4) p.x = Math.max(-HALL_W / 2 + 0.35, Math.min(HALL_W / 2 - 0.35, p.x));
  }

  const prompt = root.querySelector<HTMLElement>('[data-prompt]')!;
  const enterLink = root.querySelector<HTMLAnchorElement>('[data-enter]')!;
  let nearDoor: Door | null = null;
  function updatePrompt() {
    const p = camera.position;
    const d = doors.find((door) => Math.abs(p.z - door.z) < 1.1 && p.x > 0.2) ?? null;
    if (d !== nearDoor) {
      nearDoor = d;
      prompt.hidden = !d;
      if (d) {
        enterLink.href = d.room.href;
        root.querySelector('[data-enter-name]')!.textContent = d.room.name;
        root.querySelector('[data-enter-note]')!.textContent = `${d.room.note} · press E or tap`;
      }
    }
  }

  // ── loop ────────────────────────────────────────────────────
  const timer = new THREE.Timer();
  const fwd = new THREE.Vector3();
  const side = new THREE.Vector3();
  function resize() {
    const w = view.clientWidth; const h = view.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  window.addEventListener('resize', resize);
  resize();

  function tick(now?: number) {
    timer.update(now);
    const dt = Math.min(0.05, timer.getDelta());
    const t = timer.getElapsed();
    const turn = (keys.has('arrowleft') || held.has('left') ? 1 : 0) - (keys.has('arrowright') || held.has('right') ? 1 : 0);
    yaw += turn * dt * 1.6;
    const ahead = (keys.has('w') || keys.has('arrowup') || held.has('fwd') ? 1 : 0) - (keys.has('s') || keys.has('arrowdown') || held.has('back') ? 1 : 0);
    const strafe = (keys.has('d') ? 1 : 0) - (keys.has('a') ? 1 : 0);
    fwd.set(-Math.sin(yaw), 0, -Math.cos(yaw));
    side.set(Math.cos(yaw), 0, -Math.sin(yaw));
    const speed = 2.4;
    camera.position.addScaledVector(fwd, ahead * speed * dt).addScaledVector(side, strafe * speed * dt);
    clampPosition(camera.position);
    camera.position.y = 1.6 + (ahead || strafe ? Math.sin(t * 9) * 0.02 : 0);
    camera.rotation.set(pitch, yaw, 0, 'YXZ');

    fire.intensity = 7 + Math.sin(t * 11) * 0.8 + Math.sin(t * 23) * 0.6 + Math.random() * 0.6;
    doors.forEach((d, i) => { d.light.intensity = 3.2 + Math.sin(t * 2 + i) * 0.4; });

    if (actx) {
      const l = actx.listener;
      if (l.positionX) {
        l.positionX.value = camera.position.x; l.positionY.value = camera.position.y; l.positionZ.value = camera.position.z;
        l.forwardX.value = fwd.x; l.forwardY.value = 0; l.forwardZ.value = fwd.z;
        l.upX.value = 0; l.upY.value = 1; l.upZ.value = 0;
      } else {
        (l as any).setPosition(camera.position.x, camera.position.y, camera.position.z);
        (l as any).setOrientation(fwd.x, 0, fwd.z, 0, 1, 0);
      }
    }
    updatePrompt();
    renderer.render(scene, camera);
    requestAnimationFrame(tick);
  }
  tick();
</script>
