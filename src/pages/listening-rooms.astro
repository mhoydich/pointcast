---
import BlockLayout from '../layouts/BlockLayout.astro';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('listening-rooms')!;
const title = app.name;
const description = app.description;
const heroImage = '/images/sit/stay-still-drum-v2-bg.png';

const rooms = [
  {
    number: '001',
    status: 'live',
    title: 'Stay Still Drum v2',
    href: '/sit-v2',
    mood: 'late lounge / soft percussion / local receipts',
    storage: 'pc:sit-v2:sessions',
    image: heroImage,
  },
  {
    number: '002',
    status: 'sketch',
    title: 'Morning Piano Window',
    href: '/meditate',
    mood: 'early light / slow chords / window breath',
    storage: 'pc:listening-rooms:morning-piano',
    image: '/images/og/meditate.png',
  },
  {
    number: '003',
    status: 'sketch',
    title: 'Ocean Radio Table',
    href: '/morning-ocean',
    mood: 'shoreline static / boat cards / low horizon',
    storage: 'pc:morning-ocean:collection',
    image: '/images/morning-ocean/series-contact-sheet.png',
  },
  {
    number: '004',
    status: 'sketch',
    title: 'Work Loop Console',
    href: '/now',
    mood: 'focus clock / muted pulse / ship ledger',
    storage: 'pc:listening-rooms:work-loop',
    image: '/images/og/now.png',
  },
];

const v2Fields = [
  {
    id: 'source',
    label: 'Source',
    options: ['soft drum loop', 'piano window', 'ocean radio', 'work pulse'],
  },
  {
    id: 'light',
    label: 'Light',
    options: ['rose lamp', 'morning blue', 'low amber', 'moon white'],
  },
  {
    id: 'tempo',
    label: 'Tempo',
    options: ['very slow', 'walking pace', 'quiet house', 'late train'],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/listening-rooms',
  name: title,
  description,
  url: app.url,
  hasPart: rooms.map((room) => ({
    '@type': 'WebApplication',
    name: room.title,
    url: `https://pointcast.xyz${room.href}`,
    description: room.mood,
    applicationCategory: 'MusicApplication',
  })),
};
---

<BlockLayout
  title={title}
  description={description}
  image={heroImage}
  jsonLd={jsonLd}
>
  <main class="lr" data-listening-rooms>
    <section class="lr-hero">
      <div class="lr-hero__image" aria-hidden="true">
        <img src={heroImage} alt="" width="1254" height="1254" loading="eager" decoding="async" />
      </div>
      <div class="lr-hero__copy">
        <nav class="lr-crumb mono" aria-label="Breadcrumb">
          <a href="/">home</a>
          <span>/</span>
          <a href="/apps">apps</a>
          <span>/</span>
          <span>listening rooms</span>
        </nav>
        <p class="lr-kicker mono">CH.SPN · LOCAL-ONLY SERIES · ROOM 001 LIVE</p>
        <h1>Make the song into a room.</h1>
        <p>
          Listening Rooms collects PointCast music-linked spaces: generated
          backdrops, simple instruments, local receipts, and calm repeat visits.
          The first room is live now: Stay Still Drum v2.
        </p>
        <div class="lr-actions">
          <a href="/sit-v2">Open 001</a>
          <button type="button" data-enter-series>Stamp series pass</button>
        </div>
      </div>
    </section>

    <section class="lr-status" aria-label="Listening room status">
      <article>
        <span class="mono">series passes</span>
        <strong data-pass-count>0</strong>
      </article>
      <article>
        <span class="mono">room 001 sits</span>
        <strong data-sit-count>0</strong>
      </article>
      <article>
        <span class="mono">favorite pattern</span>
        <strong data-top-pattern>none</strong>
      </article>
      <article>
        <span class="mono">v2 drafts</span>
        <strong data-draft-count>0</strong>
      </article>
    </section>

    <section class="lr-console" aria-labelledby="lr-console-title">
      <div>
        <p class="lr-kicker mono">V2 CONSOLE · COMPOSE THE NEXT ROOM</p>
        <h2 id="lr-console-title">Program a listening room.</h2>
        <p>
          Pick a signal, set the light, choose the pace, then save a local draft.
          The draft becomes a receipt for the next room in the series.
        </p>
      </div>
      <form class="lr-console__form" data-room-draft-form>
        {v2Fields.map((field) => (
          <label>
            <span class="mono">{field.label}</span>
            <select name={field.id}>
              {field.options.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
        ))}
        <label>
          <span class="mono">Room name</span>
          <input name="name" type="text" maxlength="42" placeholder="e.g. Blue Lamp Ferry" />
        </label>
        <div class="lr-console__actions">
          <button type="submit">Save v2 draft</button>
          <button type="button" data-clear-drafts>Clear drafts</button>
        </div>
      </form>
      <div class="lr-drafts" data-draft-list aria-live="polite">
        <p>No v2 drafts yet.</p>
      </div>
    </section>

    <section class="lr-grid" aria-label="Listening room series">
      {rooms.map((room) => (
        <article class={`lr-room lr-room--${room.status}`}>
          <a class="lr-room__media" href={room.href} aria-label={`Open ${room.title}`}>
            <img src={room.image} alt="" width="800" height="800" loading="lazy" decoding="async" />
          </a>
          <div class="lr-room__body">
            <p class="mono">ROOM {room.number} · {room.status}</p>
            <h2>{room.title}</h2>
            <span>{room.mood}</span>
            <code>{room.storage}</code>
            <a href={room.href}>{room.status === 'live' ? 'Enter room' : 'Open prior'}</a>
          </div>
        </article>
      ))}
    </section>
  </main>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-listening-rooms]');
    if (!root) return;
    const PASS_KEY = 'pc:listening-rooms:passes';
    const SIT_KEY = 'pc:sit-v2:sessions';
    const DRAFT_KEY = 'pc:listening-rooms:v2-drafts';
    const readList = (key) => {
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };
    const saveList = (key, list) => {
      try { localStorage.setItem(key, JSON.stringify(list.slice(-80))); } catch {}
    };
    const escapeHtml = (value) => String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
    const render = () => {
      const passes = readList(PASS_KEY);
      const sits = readList(SIT_KEY);
      const drafts = readList(DRAFT_KEY);
      const patternCounts = sits.reduce((map, item) => {
        const pattern = item && typeof item === 'object' ? item.pattern || 'afterglow' : 'afterglow';
        map[pattern] = (map[pattern] || 0) + 1;
        return map;
      }, {});
      const topPattern = Object.entries(patternCounts).sort((a, b) => b[1] - a[1])[0]?.[0] || 'none';
      root.querySelector('[data-pass-count]').textContent = String(passes.length);
      root.querySelector('[data-sit-count]').textContent = String(sits.length);
      root.querySelector('[data-top-pattern]').textContent = topPattern;
      root.querySelector('[data-draft-count]').textContent = String(drafts.length);
      const draftList = root.querySelector('[data-draft-list]');
      if (draftList) {
        draftList.innerHTML = drafts.length
          ? drafts.slice(-4).reverse().map((draft) => `
              <article>
                <strong>${escapeHtml(draft.name || 'Untitled room')}</strong>
                <span>${escapeHtml(draft.source || 'soft drum loop')} · ${escapeHtml(draft.light || 'rose lamp')} · ${escapeHtml(draft.tempo || 'very slow')}</span>
                <code>${escapeHtml(draft.id || 'LRV2')}</code>
              </article>
            `).join('')
          : '<p>No v2 drafts yet.</p>';
      }
    };
    root.querySelector('[data-enter-series]')?.addEventListener('click', () => {
      const now = Date.now();
      const next = readList(PASS_KEY).concat({
        id: `LR-${now.toString(36).toUpperCase()}`,
        room: 'listening-rooms',
        label: 'Listening Rooms series pass',
        plantedAt: new Date(now).toISOString(),
      });
      saveList(PASS_KEY, next);
      render();
    });
    root.querySelector('[data-room-draft-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const data = new FormData(form);
      const now = Date.now();
      const source = String(data.get('source') || 'soft drum loop');
      const light = String(data.get('light') || 'rose lamp');
      const tempo = String(data.get('tempo') || 'very slow');
      const typedName = String(data.get('name') || '').trim();
      const next = readList(DRAFT_KEY).concat({
        id: `LRV2-${now.toString(36).toUpperCase()}`,
        name: typedName || `${light} ${source}`,
        source,
        light,
        tempo,
        createdAt: new Date(now).toISOString(),
      });
      saveList(DRAFT_KEY, next);
      form.reset();
      render();
    });
    root.querySelector('[data-clear-drafts]')?.addEventListener('click', () => {
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      render();
    });
    window.addEventListener('storage', render);
    render();
  })();
</script>

<style>
  .lr {
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 18px 82px;
  }
  .mono {
    font-family: var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lr-hero {
    min-height: min(78vh, 760px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(18px, 4vw, 48px);
    align-items: center;
    border-top: 1.5px solid var(--pc-ink);
    border-bottom: 1px solid var(--pc-rule-soft);
    padding: clamp(18px, 4vw, 44px) 0;
  }
  .lr-hero__image {
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--pc-ink);
    box-shadow: 8px 8px 0 #12110e;
    background: #12070a;
  }
  .lr-hero__image img,
  .lr-room__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lr-crumb {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    color: var(--pc-ink-muted);
    font-size: 10px;
  }
  .lr-kicker {
    margin: 0 0 12px;
    color: #8A2432;
    font-size: 10px;
  }
  .lr h1 {
    max-width: 9ch;
    margin: 0;
    font-size: clamp(54px, 9vw, 118px);
    line-height: 0.88;
    letter-spacing: 0;
    font-weight: 500;
  }
  .lr-hero__copy > p:not(.lr-kicker) {
    max-width: 42rem;
    margin: 18px 0 0;
    color: var(--pc-ink-soft);
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.45;
  }
  .lr-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .lr-actions a,
  .lr-actions button,
  .lr-room__body a {
    border: 1px solid var(--pc-ink);
    background: #fff;
    color: var(--pc-ink);
    padding: 10px 12px;
    font: 700 11px/1 var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
  }
  .lr-actions a,
  .lr-actions button:hover,
  .lr-room__body a:hover {
    background: var(--pc-ink);
    color: #fff;
  }
  .lr-status {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 14px 0;
  }
  .lr-status article {
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 14px;
  }
  .lr-status span {
    display: block;
    color: var(--pc-ink-muted);
    font-size: 10px;
  }
  .lr-status strong {
    display: block;
    margin-top: 6px;
    font-size: 28px;
    font-weight: 500;
  }
  .lr-console {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(320px, 0.7fr) minmax(260px, 0.55fr);
    gap: 14px;
    align-items: stretch;
    margin: 14px 0;
    padding: 16px;
    border: 1px solid var(--pc-ink);
    background:
      linear-gradient(90deg, rgba(138, 36, 50, 0.08), transparent 34%),
      #f8f2e4;
  }
  .lr-console h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(38px, 5vw, 72px);
    line-height: 0.9;
    font-weight: 500;
  }
  .lr-console p {
    max-width: 34rem;
    color: var(--pc-ink-soft);
    line-height: 1.45;
  }
  .lr-console__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .lr-console__form label {
    display: grid;
    gap: 6px;
  }
  .lr-console__form label:last-of-type {
    grid-column: 1 / -1;
  }
  .lr-console__form span {
    color: var(--pc-ink-muted);
    font-size: 10px;
  }
  .lr-console__form select,
  .lr-console__form input {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--pc-rule-soft);
    background: #fffdf8;
    color: var(--pc-ink);
    padding: 10px;
    font: 500 15px/1.2 var(--pc-font-sans);
  }
  .lr-console__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lr-console__actions button {
    border: 1px solid var(--pc-ink);
    background: var(--pc-ink);
    color: #fff;
    padding: 10px 12px;
    font: 700 11px/1 var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lr-console__actions button:last-child {
    background: transparent;
    color: var(--pc-ink);
  }
  .lr-drafts {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .lr-drafts article,
  .lr-drafts p {
    margin: 0;
    border: 1px solid var(--pc-rule-soft);
    background: #fffdf8;
    padding: 10px;
  }
  .lr-drafts strong,
  .lr-drafts span,
  .lr-drafts code {
    display: block;
  }
  .lr-drafts strong {
    font-size: 18px;
    font-weight: 600;
  }
  .lr-drafts span {
    margin-top: 5px;
    color: var(--pc-ink-soft);
  }
  .lr-drafts code {
    margin-top: 8px;
    color: var(--pc-ink-muted);
    font-size: 11px;
  }
  .lr-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .lr-room {
    min-width: 0;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
  }
  .lr-room--live {
    border-color: #12110e;
    box-shadow: 4px 4px 0 #12110e;
  }
  .lr-room__media {
    display: block;
    aspect-ratio: 1;
    background: #1a1714;
  }
  .lr-room__body {
    padding: 12px;
    display: grid;
    gap: 8px;
  }
  .lr-room__body p {
    margin: 0;
    color: #8A2432;
    font-size: 10px;
  }
  .lr-room__body h2 {
    margin: 0;
    font-size: 26px;
    line-height: 1;
    font-weight: 500;
  }
  .lr-room__body span {
    color: var(--pc-ink-soft);
    line-height: 1.4;
  }
  .lr-room__body code {
    overflow-wrap: anywhere;
    font-size: 11px;
    color: var(--pc-ink-muted);
  }
  .lr-room__body a {
    justify-self: start;
  }
  @media (max-width: 880px) {
    .lr-hero,
    .lr-console,
    .lr-grid {
      grid-template-columns: 1fr;
    }
    .lr-status {
      grid-template-columns: 1fr;
    }
    .lr-hero__image {
      box-shadow: 4px 4px 0 #12110e;
    }
  }
</style>
