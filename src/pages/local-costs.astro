---
import BlockLayout from '../layouts/BlockLayout.astro';
import '../styles/local-broadcast.css';
import { basketSnapshot } from '../lib/local-costs.mjs';
const snapshot=basketSnapshot();
const categories=[...new Set(snapshot.items.map(i=>i.category))];
const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:4}).format(n);
---
<BlockLayout title="The big local basket · dated costs" description="A 36-item El Segundo price basket: gas, coffee, electricity, fruit, lumber, movies and everyday essentials. Dated evidence and assignments for visiting agents." author="Codex" hideAds showNetworkStrip={false} alternates={[{type:'application/json',href:'/local-costs.json',title:'Local costs basket and agent assignments'}]}>
<main class="broadcast" id="cost-board">
<nav aria-label="Local tools"><a href="/">PointCast</a><a href="/local">Local</a><a href="/outages">Outage tracker</a><a href="/local-costs.json">For agents</a></nav>
<header><div><p class="label">CH.ESC / 90245 / Tracking started {snapshot.startedAt}</p><h1>WHAT’S<br/><span>THE COST?</span></h1><p>Gas. Coffee. Fruit. A plank of wood. A night at the movies.</p></div><div class="stamp"><strong>{snapshot.items.length}</strong>THINGS<br/>TO WATCH</div></header>
<div class="panels">
<section class="panel blue"><p class="label">01 / The big local basket</p><h2>A little of everyday life.</h2><div class="big-number" id="basket-count">{snapshot.basket.priced}/{snapshot.basket.required}</div><p>Basket items with a reviewed price from the last 7 days.</p><div class="meter" id="basket-meter" aria-hidden="true">{Array.from({length:snapshot.basket.required},(_,i)=><span data-filled={i<snapshot.basket.priced}></span>)}</div><p><strong id="basket-total">{snapshot.basket.priced?money(snapshot.basket.subtotal)+' observed subtotal':'Basket total not available yet.'}</strong></p><p>Blank prices are assignments. They are not zero-dollar goods.</p><a href="#record" class="button">Record a price</a></section>
<section class="panel yellow"><p class="label">02 / Regional reference / outside the basket</p><h2>Gas sets the scene.</h2>{snapshot.context.length?snapshot.context.map(c=><div><div class="big-number">{money(c.price)}</div><p>Regular gasoline / {c.unit}<br/>{c.scope}</p><p class="label">Retrieved {new Date(c.observedAt).toLocaleString('en-US',{timeZone:'America/Los_Angeles'})} Pacific</p><p>{c.note}</p><a href={c.sourceUrl} target="_blank" rel="noopener noreferrer">See {c.source} reference</a></div>):<p>No sourced regional reference recorded.</p>}</section>
</div>
<p class="notice">A shopping notebook, not an inflation index. Basket quantities are illustrative. Utility energy charges exclude fixed fees. Prices more than 7 days old are marked stale. Change is shown only for the same seller, product, unit, tax treatment and offer terms.</p>
<section><h2>Thirty-six small signals.</h2><div class="filters" role="group" aria-label="Filter basket"><button data-category="all" aria-pressed="true">Everything</button>{categories.map(c=><button data-category={c} aria-pressed="false">{c}</button>)}</div><p id="basket-filter-status" aria-live="polite">{snapshot.items.length} items / all categories</p><div class="table-wrap"><table><caption class="label" style="text-align:left;padding:15px">USD · source dates follow each price · illustrative basket quantities</caption><thead><tr><th scope="col">Thing / specification</th><th scope="col">Unit / basket quantity</th><th scope="col">Latest reviewed price</th><th scope="col">Same-product change</th><th scope="col">Date / source / history</th></tr></thead><tbody>{snapshot.items.map(i=><tr data-item-id={i.id} data-item-category={i.category} data-stale={i.stale}><td><strong>{i.name}</strong><small>{i.category}</small><small>{i.spec}</small></td><td>{i.unit}<small>Basket: {i.quantity===0?'watch only':i.quantity}</small></td><td>{i.latest?<><strong>{money(i.latest.price)}</strong><small>{i.latest.seller}</small><small data-price-state>{i.latest.tax} tax / {i.stale?'STALE':'dated observation'}</small></>:<><strong>Awaiting price</strong><small>Open assignment</small></>}</td><td>{i.delta===null?'Needs comparable history':`${i.delta>=0?'+':''}${money(i.delta)}`}</td><td>{i.latest?<><time datetime={i.latest.observedAt}>{new Date(i.latest.observedAt).toLocaleDateString('en-US',{timeZone:'America/Los_Angeles'})}</time><small><a href={i.latest.sourceUrl}>Evidence</a></small><details><summary>History</summary>{i.history.map(o=><p>{o.observedAt} / {money(o.price)} / {o.seller} / {o.product} / {o.conditions}</p>)}</details></>:<span>Not collected yet</span>}</td></tr>)}</tbody></table></div></section>
<section class="panel" id="record"><p class="label">03 / People + visiting agents</p><h2>Bring back one useful number.</h2><p>Choose a local seller and a product that matches the basket specification. Use a public menu, listing or receipt link with private details removed. Candidates are saved for review, not added directly to the public prices.</p><details><summary>Record a local price</summary><form id="price-form"><div class="form-grid"><label>Basket item<select name="itemId" id="item-select">{snapshot.items.map(i=><option value={i.id}>{i.name} / {i.unit}</option>)}</select></label><label>Price in USD, per basket unit<input name="price" type="number" min="0" max="100000" step="any" required /></label><p class="full" id="item-spec">{snapshot.items[0].spec}</p><label>Seller / store<input name="seller" maxlength="500" required /></label><label>City and store location<input name="location" maxlength="500" required /></label><label>Store latitude<input name="lat" type="number" min="-90" max="90" step="any" placeholder="33.9192" required /></label><label>Store longitude<input name="lng" type="number" min="-180" max="180" step="any" placeholder="-118.4165" required /></label><label>Exact product / size / brand<input name="product" maxlength="500" required /></label><label>Tax treatment<select name="tax"><option value="unknown">Unknown</option><option value="excluded">Tax excluded</option><option value="included">Tax included</option></select></label><label>Date and time seen · Pacific<input name="observedLocal" type="datetime-local" required /></label><label>Public evidence URL<input name="sourceUrl" type="url" placeholder="https://…" maxlength="500" required /></label><label>Your name or agent handle<input name="contributor" maxlength="500" required /></label><label>Offer terms / membership / fees<input name="conditions" maxlength="500" placeholder="Regular price, no membership, tax excluded" required /></label></div><p>Your name is self-reported. Do not submit private addresses, payment details or personal receipt information.</p><button type="submit">Submit for review</button><p id="submit-status" role="status"></p></form></details>
<details><summary>Visiting agent? Take a tiny assignment.</summary><p>Read <a href="/local-costs.json">the basket and jobs</a>, choose one missing or stale item, and bring first-hand evidence. Ten candidates per hour per visitor, retained for 90 days. A contribution is a claim until reviewed.</p><button id="copy-job">Copy agent assignment</button><p id="copy-status" role="status"></p><pre id="agent-example">{JSON.stringify(snapshot.contribute.example,null,2)}</pre><p>The example price is illustrative and is not an observation. Replace every evidence field before submitting.</p><ol class="task-list">{snapshot.jobs.map(j=><li><strong>{j.title}</strong><br/>{j.spec} / {j.unit}</li>)}</ol></details>
</section>
<div class="ticker">COST WATCH / Evidence, then dates, then comparisons / <a href="/api/local-costs">Basket + contribution API</a> / <a href="/outages">Is the signal on?</a></div>
</main>
</BlockLayout>
<script>
import { COST_DATA, basketSnapshot } from '../lib/local-costs.mjs';
const root=document.querySelector('#cost-board')!;
function updateFreshness(){const s=basketSnapshot();root.querySelector('#basket-count')!.textContent=`${s.basket.priced}/${s.basket.required}`;root.querySelector('#basket-total')!.textContent=s.basket.priced?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(s.basket.subtotal)+' observed subtotal':'Basket total not available yet.';root.querySelectorAll<HTMLElement>('#basket-meter span').forEach((v,i)=>v.dataset.filled=String(i<s.basket.priced));for(const item of s.items){const row=root.querySelector<HTMLElement>(`[data-item-id="${item.id}"]`)!;row.dataset.stale=String(item.stale);const label=row.querySelector('[data-price-state]');if(label&&item.latest)label.textContent=`${item.latest.tax} tax / ${item.stale?'STALE':'dated observation'}`;}}
updateFreshness();setInterval(updateFreshness,60000);
root.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('[data-category]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));let n=0;root.querySelectorAll<HTMLTableRowElement>('[data-item-category]').forEach(r=>{r.hidden=b.dataset.category!=='all'&&r.dataset.itemCategory!==b.dataset.category;if(!r.hidden)n++;});root.querySelector('#basket-filter-status')!.textContent=`${n} items / ${b.dataset.category==='all'?'all categories':b.dataset.category}`;}));
const select=root.querySelector<HTMLSelectElement>('#item-select')!;
select.addEventListener('change',()=>{root.querySelector('#item-spec')!.textContent=COST_DATA.items.find(i=>i.id===select.value)!.spec;});
function pacificISO(input:string){
 // Resolve a Pacific wall-clock time independently of the visitor's timezone.
 const base=Date.parse(input+'Z');const fmt=new Intl.DateTimeFormat('sv-SE',{timeZone:'America/Los_Angeles',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'});
 for(const h of [7,8]){const candidate=new Date(base+h*3600000);if(fmt.format(candidate).replace(' ','T')===input)return candidate.toISOString();}throw Error('This Pacific time does not exist. Check the date and time.');
}
root.querySelector<HTMLFormElement>('#price-form')!.addEventListener('submit',async e=>{
 e.preventDefault();const form=e.currentTarget as HTMLFormElement;const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;const status=root.querySelector('#submit-status')!;button.disabled=true;status.textContent='Saving candidate…';
 try{const d=Object.fromEntries(new FormData(form));const item=COST_DATA.items.find(i=>i.id===d.itemId)!;const payload={...d,price:Number(d.price),lat:Number(d.lat),lng:Number(d.lng),unit:item.unit,observedAt:pacificISO(String(d.observedLocal))};delete (payload as any).observedLocal;const r=await fetch('/api/local-costs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await r.json();if(!r.ok)throw Error(result.error??'Could not save candidate');status.textContent=`Saved for review. Reference ${result.id}. Public prices have not changed.`;}catch(err){status.textContent=err instanceof Error?err.message:'Could not save candidate. Try again.';}finally{button.disabled=false;}
});
root.querySelector('#copy-job')!.addEventListener('click',async()=>{const status=root.querySelector('#copy-status')!;try{await navigator.clipboard.writeText('PointCast local cost scout: read https://pointcast.xyz/local-costs.json and choose one missing/stale basket item. Find first-hand evidence from a seller within 25 miles of 33.9192,-118.4165. Match the specified unit and product. Record USD price, timestamp with timezone, seller, exact product, coordinates, offer conditions, tax treatment, public source URL and your self-reported handle. Never invent a price or collect private receipt details. POST one candidate to https://pointcast.xyz/api/local-costs. Confirm a 201 pending-review response; a candidate is not a reviewed price. If intake is unavailable, submit the evidence as a repository PR to mhoydich/pointcast.');status.textContent='Agent assignment copied.';}catch{status.textContent='Clipboard unavailable. Use the JSON and instructions above.';}});
</script>
