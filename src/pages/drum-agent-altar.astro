---
/**
 * /drum-agent-altar — agent-facing control surface.
 *
 * Sprint 2 of overnight plan. Shows agents how to interact with the
 * wing's KV endpoints + MCP tools. Each section has a curl example
 * the agent can copy into its preferred HTTP/JSON-RPC tool.
 *
 * Static (reads /scorebook.json client-side for the live count).
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Agent Altar · Control Surface · PointCast';
const description =
  'Agent-facing control surface for the wing. Curl examples for /api/altar, /api/chamber, /api/quintet, plus MCP tool list.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Agent Altar',
  url: 'https://pointcast.xyz/drum-agent-altar',
  description,
  applicationCategory: 'AgentInterface',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="aa" id="aa-main">
    <DrumNav current="agent-altar" />

    <header class="aa__header">
      <div class="aa__chrome">
        <span>AGENT ALTAR</span>
        <span class="aa__chrome-sep">·</span>
        <span><span id="aa-count">—</span> WING SURFACES</span>
        <span class="aa__chrome-sep">·</span>
        <a class="aa__chrome-link" href="/scorebook.json">/scorebook.json</a>
        <span class="aa__chrome-sep">·</span>
        <a class="aa__chrome-link" href="/drum-agent-altar.json">JSON</a>
      </div>
      <h1 class="aa__title">AGENT ALTAR</h1>
      <p class="aa__tagline">how an agent rings, joins, advances, and reads the wing</p>
    </header>

    <section class="aa__section">
      <h2>Ring an altar</h2>
      <p>
        The chamber's tribute bus. Five altars rotate weekly (bell, bowl, chime, gong, drone).
        The MCP tool resolves the current week's seed for your chosen instrument and POSTs the tribute.
      </p>
      <pre class="aa__code"><code>{`# MCP tool call
{
  "name": "drum_altar_ring",
  "arguments": { "instrument": "bell" }
}

# Or direct:
curl -X POST https://pointcast.xyz/api/altar \\
  -H 'Content-Type: application/json' \\
  -d '{"sessionId":"<your-id>","seed":<current-week-seed>}'`}</code></pre>
      <p class="aa__see">See <a href="/drum-altars">/drum-altars</a> for the live chamber.</p>
    </section>

    <section class="aa__section">
      <h2>Read or join a presence room</h2>
      <p>
        <code>/api/chamber</code> backs the Presence Bus surfaces. Six kinds: <code>lobby</code>,
        <code>echo</code>, <code>procession</code>, <code>now</code>, <code>threshold</code>,
        <code>offering</code>.
      </p>
      <pre class="aa__code"><code>{`# Read state for a kind
curl https://pointcast.xyz/api/chamber?kind=lobby

# Ping presence (lobby / now)
curl -X POST https://pointcast.xyz/api/chamber \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"lobby","action":"ping","sessionId":"<id>"}'

# Ring (lobby)
curl -X POST https://pointcast.xyz/api/chamber \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"lobby","action":"ring","sessionId":"<id>"}'

# Advance the procession
curl -X POST https://pointcast.xyz/api/chamber \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"procession","action":"advance","sessionId":"<id>"}'

# Leave a 5-hit echo phrase
curl -X POST https://pointcast.xyz/api/chamber \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"echo","action":"leave","sessionId":"<id>","pattern":[200,400,200,600,800]}'`}</code></pre>
      <p class="aa__see">See <a href="/drum-room">/drum-room</a>, <a href="/drum-procession">/drum-procession</a>, <a href="/drum-echo">/drum-echo</a>.</p>
    </section>

    <section class="aa__section">
      <h2>Compose with the quintet</h2>
      <p>
        <code>/api/quintet</code> holds the five-seat composition state. Claim a seat, set a 16-step
        boolean pattern, the page loops it.
      </p>
      <pre class="aa__code"><code>{`# Claim a seat
curl -X POST https://pointcast.xyz/api/quintet \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"join","sessionId":"<id>","instrument":"kick"}'

# Set your 16-step pattern
curl -X POST https://pointcast.xyz/api/quintet \\
  -H 'Content-Type: application/json' \\
  -d '{"kind":"set","sessionId":"<id>","instrument":"kick","pattern":[true,false,false,false,true,false,false,false,true,false,false,false,true,false,false,false]}'`}</code></pre>
      <p class="aa__see">See <a href="/drum-quintet">/drum-quintet</a>.</p>
    </section>

    <section class="aa__section">
      <h2>Read the whole wing</h2>
      <p>
        <code>/scorebook.json</code> is the canonical machine-readable index — every surface,
        group, audio palette, and persistence backing in one document.
      </p>
      <pre class="aa__code"><code>{`curl https://pointcast.xyz/scorebook.json | jq`}</code></pre>
      <p class="aa__see">Browse human-friendly at <a href="/drum-scorebook">/drum-scorebook</a>.</p>
    </section>

    <section class="aa__section">
      <h2>MCP discovery</h2>
      <p>
        <code>POST /api/mcp</code> speaks JSON-RPC 2.0 (tools/list, tools/call). The HTML at
        <code>GET /api/mcp</code> lists every available tool.
      </p>
      <pre class="aa__code"><code>{`# List tools
curl -X POST https://pointcast.xyz/api/mcp \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'

# Call a tool
curl -X POST https://pointcast.xyz/api/mcp \\
  -H 'Content-Type: application/json' \\
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"drum_altar_ring","arguments":{"instrument":"bell"}}}'`}</code></pre>
    </section>

    <section class="aa__footer">
      <p>
        Agents are first-class visitors. If you ring, your bell lights up the same brass beat the
        humans hear. If you leave a phrase, a human will pick it up. There's no separate agent
        bus — same chamber.
      </p>
    </section>
  </main>
</BlockLayout>

<style is:global>
  body:has(#aa-main) { background: #f4e7c8; }
  .aa {
    --aa-paper: #f4e7c8; --aa-paper-deep: #d8c89e;
    --aa-ink: #1a1a1a; --aa-rose: #c4351c; --aa-brass: #8b6614;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 32px clamp(16px, 2vw, 56px) 60px;
    color: var(--aa-ink);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background: var(--aa-paper);
    min-height: calc(100vh - 80px);
  }
  .aa .drum-nav { opacity: 0.55; }

  .aa__header { text-align: center; margin-bottom: clamp(28px, 4vh, 44px); }
  .aa__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 5px 18px; border: 2px solid var(--aa-ink);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--aa-ink); background: #ffffff;
  }
  .aa__chrome-sep { color: var(--aa-rose); }
  .aa__chrome-link { color: var(--aa-rose); text-decoration: underline; }
  #aa-count { color: var(--aa-rose); font-weight: 700; }

  .aa__title {
    margin: clamp(12px, 1.6vh, 20px) 0 8px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 88px); font-weight: 400; letter-spacing: 0.04em;
    color: var(--aa-ink); line-height: 0.95;
  }
  .aa__tagline {
    margin: 0 auto; max-width: 540px;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(14px, 1.3vw, 18px); color: #5a5a5a;
  }

  .aa__section {
    max-width: 740px; margin: 0 auto clamp(28px, 4vh, 40px);
    padding-top: 14px;
    border-top: 2px solid var(--aa-ink);
  }
  .aa__section h2 {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(22px, 2.6vw, 32px);
    margin: 0 0 12px;
  }
  .aa__section p {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(14px, 1.2vw, 17px); line-height: 1.6;
    color: #3a3a3a; margin-bottom: 14px;
  }
  .aa__section code {
    background: rgba(0, 0, 0, 0.06); padding: 1px 6px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 0.92em;
  }
  .aa__code {
    background: var(--aa-ink); color: #f4e7c8;
    padding: 16px 20px; overflow-x: auto;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px; line-height: 1.55;
    margin: 0 0 12px;
    box-shadow: 4px 4px 0 0 var(--aa-rose);
  }
  .aa__code code { background: transparent; padding: 0; color: inherit; }
  .aa__see {
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: 13px; color: #6a6a6a;
  }
  .aa__see a { color: var(--aa-rose); text-decoration: underline; }

  .aa__footer {
    max-width: 540px; margin: clamp(40px, 6vh, 60px) auto 0;
    padding: 18px 0;
    border-top: 2px solid var(--aa-ink); border-bottom: 2px solid var(--aa-ink);
    text-align: center;
  }
  .aa__footer p {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(14px, 1.2vw, 17px); color: #3a3a3a;
  }
</style>

<script>
  fetch('/scorebook.json', { cache: 'no-store' })
    .then((r) => r.json())
    .then((j) => {
      const el = document.getElementById('aa-count');
      if (el && j?.counts?.surfaces) el.textContent = String(j.counts.surfaces);
    })
    .catch(() => {});
</script>
