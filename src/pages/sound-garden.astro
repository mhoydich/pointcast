---
import BlockLayout from '../layouts/BlockLayout.astro';
import { getPointcastApp } from '../lib/pointcast-apps';
import soundGardenCard from '../assets/sound-garden/og.png';

const app = getPointcastApp('sound-garden')!;
const title = app.name;
const description = app.description;

const dimensions = [
  { number: '01', name: 'Warmth', range: 'dark → luminous', note: 'Opens the harmonic body and the upper air.' },
  { number: '02', name: 'Roughness', range: 'pure → weathered', note: 'Introduces detuning, texture, and audible friction.' },
  { number: '03', name: 'Motion', range: 'still → orbiting', note: 'Moves the organism through stereo space and time.' },
  { number: '04', name: 'Surprise', range: 'familiar → uncanny', note: 'Increases the reach and frequency of mutation.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/sound-garden',
  name: title,
  description,
  url: app.url,
  sameAs: 'https://pointcast.xyz/sound-garden',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Web Audio API',
  isAccessibleForFree: true,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/sound-garden.json', title: 'Sound Garden discovery packet' }]}
  frame={{
    image: 'https://sound-garden-001.mhoydich.chatgpt.site/og.png',
    buttons: [
      { label: 'Open instrument', action: 'link', target: app.url },
      { label: 'Sound Garden JSON', action: 'link', target: 'https://pointcast.xyz/sound-garden.json' },
    ],
  }}
>
  <main class="sound-page">
    <nav class="crumb mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a>
      <span aria-hidden="true">/</span>
      <a href="/apps">Apps</a>
      <span aria-hidden="true">/</span>
      <span>Sound Garden 001</span>
    </nav>

    <section class="hero" aria-labelledby="sound-garden-title">
      <div class="hero__copy">
        <p class="kicker mono">CH.SPN · GENERATIVE SOUND STUDY · 001</p>
        <h1 id="sound-garden-title">Grow a sound.</h1>
        <p class="dek">
          Begin with something gentle. Add motion, friction, and just enough uncertainty to make it feel alive.
        </p>
        <div class="hero__actions">
          <a class="launch" href={app.url} target="_blank" rel="noopener">OPEN SOUND GARDEN <span aria-hidden="true">↗</span></a>
          <a class="secondary mono" href="/sound-garden.json">DISCOVERY JSON</a>
        </div>
        <p class="headphone-note mono">HEADPHONES RECOMMENDED · AUDIO BEGINS ONLY AFTER YOU PRESS BEGIN</p>
      </div>
      <a class="hero__image" href={app.url} target="_blank" rel="noopener" aria-label="Open Sound Garden 001">
        <img src={soundGardenCard.src} alt="Sound Garden orbit diagram with a glowing coral center" width={soundGardenCard.width} height={soundGardenCard.height} />
        <span class="image-label mono">LIVE INSTRUMENT · OPEN DIRECT ↗</span>
      </a>
    </section>

    <section class="principle" aria-labelledby="principle-title">
      <p class="section-number mono">THE PRINCIPLE</p>
      <div>
        <h2 id="principle-title">Stable core.<br />Controlled mutation.</h2>
        <p>
          Sound Garden keeps pitch, envelope, rhythm, and space understandable while letting timbre wander. The useful territory sits between predictable enough to hold and strange enough to notice.
        </p>
      </div>
    </section>

    <section class="dimensions" aria-labelledby="dimensions-title">
      <header>
        <p class="section-number mono">THE FOUR DIMENSIONS</p>
        <h2 id="dimensions-title">Shape the organism.</h2>
      </header>
      <ol>
        {dimensions.map((dimension) => (
          <li>
            <span class="dimension-number mono">{dimension.number}</span>
            <strong>{dimension.name}</strong>
            <span class="dimension-range mono">{dimension.range}</span>
            <p>{dimension.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="try-it" aria-labelledby="try-title">
      <div>
        <p class="section-number mono">A THREE-MINUTE STUDY</p>
        <h2 id="try-title">Listen for the good accident.</h2>
      </div>
      <ol>
        <li><span class="mono">01</span> Choose a seed organism and press Begin.</li>
        <li><span class="mono">02</span> Move warmth and surprise slowly, one at a time.</li>
        <li><span class="mono">03</span> Introduce a mutation, then capture anything worth keeping.</li>
      </ol>
      <a class="launch launch--dark" href={app.url} target="_blank" rel="noopener">BEGIN THE STUDY <span aria-hidden="true">↗</span></a>
    </section>

    <aside class="boundary" aria-label="Sound Garden technical boundary">
      <strong class="mono">WHAT THIS VERSION IS</strong>
      <p>The sound is synthesized live in your browser. It does not listen through your microphone, upload source audio, or call a paid music model. Recordings remain in the browser until you download them.</p>
    </aside>

    <footer class="end mono">
      <span>POINTCAST SATELLITE · SOUND GARDEN 001</span>
      <a href="/apps">BACK TO APPS +</a>
    </footer>
  </main>
</BlockLayout>

<style>
  .sound-page {
    --sg-paper: #eeeade;
    --sg-ink: #181914;
    --sg-coral: #ff6f45;
    --sg-lime: #d4ed2b;
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px 18px 70px;
    color: var(--sg-ink);
  }
  .mono { font-family: var(--pc-font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .crumb { display: flex; gap: 8px; margin: 0 0 18px; font-size: 10px; color: var(--pc-ink-muted); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.15fr);
    min-height: 590px;
    border: 1px solid var(--sg-ink);
    background: var(--sg-paper);
  }
  .hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 5vw, 72px); border-right: 1px solid var(--sg-ink); }
  .kicker, .section-number { margin: 0 0 18px; color: #7b3424; font-size: 10px; font-weight: 700; }
  h1 { max-width: 560px; margin: 0; font-size: clamp(62px, 9vw, 132px); font-weight: 520; letter-spacing: -0.075em; line-height: 0.79; }
  .dek { max-width: 520px; margin: 32px 0 0; font-size: clamp(18px, 2vw, 25px); line-height: 1.25; }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 38px; }
  .launch { display: inline-flex; justify-content: space-between; gap: 28px; padding: 14px 18px; border: 1px solid var(--sg-ink); background: var(--sg-coral); color: var(--sg-ink); font: 700 11px/1 var(--pc-font-mono); letter-spacing: 0.1em; text-decoration: none; }
  .launch:hover { background: var(--sg-lime); text-decoration: none; }
  .secondary { color: var(--sg-ink); font-size: 10px; text-underline-offset: 4px; }
  .headphone-note { margin: 22px 0 0; color: rgba(24, 25, 20, 0.58); font-size: 8px; line-height: 1.5; }
  .hero__image { position: relative; display: flex; align-items: center; min-width: 0; padding: 24px; overflow: hidden; background: #e5dfd1; color: var(--sg-ink); }
  .hero__image img { width: 100%; height: auto; border: 1px solid var(--sg-ink); box-shadow: 10px 10px 0 rgba(24,25,20,.12); }
  .image-label { position: absolute; right: 34px; bottom: 34px; padding: 9px 11px; border: 1px solid var(--sg-ink); background: var(--sg-paper); font-size: 8px; }
  .principle { display: grid; grid-template-columns: 0.36fr 1fr; gap: 40px; padding: 72px 0; border-bottom: 1px solid var(--sg-ink); }
  .principle > div { display: grid; grid-template-columns: 1fr 0.72fr; gap: 38px; align-items: end; }
  .principle h2, .dimensions h2, .try-it h2 { margin: 0; font-size: clamp(42px, 6vw, 82px); font-weight: 520; letter-spacing: -0.055em; line-height: 0.93; }
  .principle p:not(.section-number) { margin: 0; font-size: 18px; line-height: 1.55; }
  .dimensions { padding: 54px 0 70px; }
  .dimensions header { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 28px; }
  .dimensions ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; border-top: 1px solid var(--sg-ink); border-bottom: 1px solid var(--sg-ink); list-style: none; }
  .dimensions li { min-height: 250px; display: flex; flex-direction: column; padding: 17px; border-right: 1px solid var(--sg-ink); }
  .dimensions li:last-child { border-right: 0; }
  .dimension-number, .dimension-range { font-size: 9px; }
  .dimensions strong { margin-top: 62px; font-size: 26px; font-weight: 540; letter-spacing: -0.04em; }
  .dimension-range { margin-top: 7px; color: #7b3424; }
  .dimensions li p { margin: auto 0 0; color: rgba(24,25,20,.68); font-size: 13px; line-height: 1.45; }
  .try-it { display: grid; grid-template-columns: 1fr 0.92fr; gap: 55px; align-items: end; padding: clamp(30px, 5vw, 65px); background: var(--sg-coral); border: 1px solid var(--sg-ink); }
  .try-it ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--sg-ink); }
  .try-it li { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding: 15px 0; border-bottom: 1px solid rgba(24,25,20,.4); font-size: 15px; line-height: 1.4; }
  .try-it li span { font-size: 9px; }
  .launch--dark { grid-column: 2; justify-self: start; background: var(--sg-ink); color: var(--sg-paper); }
  .boundary { display: grid; grid-template-columns: .36fr 1fr; gap: 40px; padding: 30px 0; border-bottom: 1px solid var(--sg-ink); }
  .boundary strong { font-size: 9px; }
  .boundary p { max-width: 760px; margin: 0; font-size: 14px; line-height: 1.55; }
  .end { display: flex; justify-content: space-between; gap: 20px; padding-top: 20px; font-size: 9px; }
  .end a { color: var(--sg-ink); }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; }
    .hero__copy { border-right: 0; border-bottom: 1px solid var(--sg-ink); }
    .hero__image { min-height: 400px; }
    .principle, .boundary { grid-template-columns: 1fr; gap: 18px; }
    .principle > div { grid-template-columns: 1fr; }
    .dimensions ol { grid-template-columns: repeat(2, 1fr); }
    .dimensions li:nth-child(2) { border-right: 0; }
    .dimensions li:nth-child(-n+2) { border-bottom: 1px solid var(--sg-ink); }
    .try-it { grid-template-columns: 1fr; }
    .launch--dark { grid-column: 1; }
  }
  @media (max-width: 560px) {
    .sound-page { padding-inline: 10px; }
    .hero { min-height: 0; }
    .hero__copy { padding: 34px 22px; }
    .hero__image { min-height: 290px; padding: 14px; }
    .image-label { right: 20px; bottom: 20px; }
    .dimensions header { display: block; }
    .dimensions h2 { margin-top: 10px; }
    .dimensions ol { grid-template-columns: 1fr; }
    .dimensions li { min-height: 210px; border-right: 0; border-bottom: 1px solid var(--sg-ink); }
    .dimensions li:last-child { border-bottom: 0; }
    .dimensions strong { margin-top: 38px; }
    .try-it { padding: 30px 22px; }
    .end { flex-direction: column; }
  }
</style>
