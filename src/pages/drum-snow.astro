---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Snow — the same garden, snowed in, ten minutes" description="The pavilion looks onto the same garden — this time covered in snow. Every drum hit is dampened, as if the sound is passing through three feet of fresh fall. Snowflakes drift past the green frame. There is no peak. Set it and listen.">
  <main class="ds" id="ds" data-built={built}>
    <header class="ds__hero">
      <p class="ds__kicker">DRUM · SNOW · everything dampened · ten minutes</p>
      <h1 class="ds__title">The same garden, snowed in.</h1>
      <p class="ds__sub">Same green pavilion, same arrangement of rocks and bonsai and small kit — only now everything is buried in fresh fall. Snowflakes drift past the frame. Every drum hit passes through a low-pass filter, as if the sound has to travel through three feet of snow to reach you. There is no peak. The page is the quietest of the four pavilions.</p>
    </header>

    <section class="ds__stage" id="ds-stage" data-state="idle">
      <div class="ds__pavilion" aria-hidden="true">
        <div class="ds__rail ds__rail--top"></div>
        <div class="ds__rail ds__rail--bottom"></div>
        <div class="ds__post ds__post--left"></div>
        <div class="ds__post ds__post--right"></div>
        <svg class="ds__scene" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="dsSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#e8ecf0"/>
              <stop offset="60%" stop-color="#d6dde4"/>
              <stop offset="100%" stop-color="#c0c8d2"/>
            </linearGradient>
            <linearGradient id="dsSand" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#eef1f4"/>
              <stop offset="100%" stop-color="#c4cad2"/>
            </linearGradient>
            <radialGradient id="dsRockBig" cx="40%" cy="35%" r="65%">
              <stop offset="0%" stop-color="#9aa3ad"/>
              <stop offset="60%" stop-color="#6e7782"/>
              <stop offset="100%" stop-color="#3e454f"/>
            </radialGradient>
            <radialGradient id="dsRockMid" cx="50%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#888f98"/>
              <stop offset="100%" stop-color="#525861"/>
            </radialGradient>
            <linearGradient id="dsDrumShell" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#7d6244"/>
              <stop offset="55%" stop-color="#5a4530"/>
              <stop offset="100%" stop-color="#332518"/>
            </linearGradient>
            <linearGradient id="dsDrumHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f4f6f8"/>
              <stop offset="100%" stop-color="#d8dde2"/>
            </linearGradient>
            <radialGradient id="dsCymbal" cx="50%" cy="35%" r="70%">
              <stop offset="0%" stop-color="#b6a878"/>
              <stop offset="65%" stop-color="#80724a"/>
              <stop offset="100%" stop-color="#4a4028"/>
            </radialGradient>
          </defs>

          <!-- Pale winter sky -->
          <rect x="0" y="0" width="1200" height="320" fill="url(#dsSky)"/>
          <!-- Distant ridge silhouette -->
          <path d="M 0 320 L 0 280 L 180 250 L 360 270 L 540 240 L 720 265 L 900 245 L 1080 260 L 1200 250 L 1200 320 Z" fill="#b8c2cc" opacity="0.55"/>

          <!-- Snow on ground -->
          <rect x="0" y="300" width="1200" height="300" fill="url(#dsSand)"/>
          <!-- Faint snow drifts -->
          <g fill="rgba(255,255,255,0.4)">
            <ellipse cx="240" cy="510" rx="200" ry="14"/>
            <ellipse cx="600" cy="550" rx="280" ry="18"/>
            <ellipse cx="980" cy="520" rx="180" ry="12"/>
          </g>

          <!-- Big rock with snow cap -->
          <g transform="translate(380, 380)">
            <path d="M -150 30 Q -160 -50 -110 -85 Q -50 -110 30 -100 Q 110 -90 145 -50 Q 165 0 140 38 Q 110 60 60 60 Q 0 65 -60 55 Q -130 50 -150 30 Z"
                  fill="url(#dsRockBig)" stroke="rgba(40,50,62,0.4)" stroke-width="1"/>
            <!-- Snow cap on top -->
            <path d="M -120 -75 Q -110 -98 -50 -105 Q 20 -110 80 -98 Q 120 -90 140 -75 Q 110 -82 60 -86 Q 0 -88 -60 -85 Q -110 -82 -120 -75 Z"
                  fill="#ffffff" opacity="0.95"/>
            <path d="M -120 -75 Q -90 -68 -50 -70 Q 0 -72 50 -70 Q 100 -68 140 -75"
                  fill="none" stroke="rgba(180,190,200,0.4)" stroke-width="1"/>
          </g>
          <!-- Small rocks with snow caps -->
          <g transform="translate(1010, 410)">
            <path d="M -55 18 Q -60 -22 -32 -38 Q 0 -50 35 -42 Q 60 -32 60 -8 Q 55 18 28 26 Q -10 32 -55 18 Z"
                  fill="url(#dsRockMid)" stroke="rgba(40,50,62,0.4)" stroke-width="0.8"/>
            <path d="M -45 -28 Q -25 -42 0 -45 Q 30 -42 50 -32 Q 30 -36 0 -37 Q -25 -36 -45 -28 Z"
                  fill="#ffffff" opacity="0.95"/>
          </g>
          <g transform="translate(620, 430)">
            <path d="M -38 12 Q -42 -18 -22 -28 Q 0 -36 24 -28 Q 42 -16 40 4 Q 32 22 8 24 Q -22 22 -38 12 Z"
                  fill="url(#dsRockMid)" stroke="rgba(40,50,62,0.4)" stroke-width="0.6"/>
            <path d="M -32 -20 Q -18 -30 0 -32 Q 18 -30 32 -22 Q 18 -26 0 -27 Q -18 -26 -32 -20 Z"
                  fill="#ffffff" opacity="0.95"/>
          </g>

          <!-- Bonsai pine with snow on needles -->
          <g class="ds__bonsai">
            <path d="M 1085 295 Q 1080 250 1095 215 Q 1110 195 1115 170 Q 1112 150 1118 140"
                  fill="none" stroke="#2a1e16" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M 1100 240 Q 1115 230 1132 220"
                  fill="none" stroke="#2a1e16" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M 1108 195 Q 1095 188 1080 192"
                  fill="none" stroke="#2a1e16" stroke-width="2" stroke-linecap="round"/>
            <g class="ds__bonsai-needles">
              <ellipse cx="1090" cy="195" rx="42" ry="22" fill="#3a5a4a" opacity="0.85"/>
              <ellipse cx="1132" cy="218" rx="26" ry="14" fill="#3a5a4a" opacity="0.85"/>
              <ellipse cx="1118" cy="138" rx="34" ry="20" fill="#3a5a4a" opacity="0.85"/>
              <ellipse cx="1080" cy="245" rx="20" ry="11" fill="#3a5a4a" opacity="0.85"/>
              <!-- Snow caps on each cluster -->
              <ellipse cx="1090" cy="180" rx="40" ry="9" fill="#ffffff" opacity="0.92"/>
              <ellipse cx="1132" cy="208" rx="24" ry="6" fill="#ffffff" opacity="0.92"/>
              <ellipse cx="1118" cy="124" rx="32" ry="8" fill="#ffffff" opacity="0.92"/>
              <ellipse cx="1080" cy="237" rx="18" ry="5" fill="#ffffff" opacity="0.92"/>
            </g>
          </g>

          <!-- Drum kit with snow pillowed on top -->
          <!-- Floor tom -->
          <g class="ds__drum ds__drum--floor" data-voice="floor">
            <ellipse cx="710" cy="450" rx="48" ry="14" fill="rgba(0,0,0,0.18)"/>
            <rect x="662" y="380" width="96" height="80" rx="6" fill="url(#dsDrumShell)" stroke="#1a1208" stroke-width="0.6"/>
            <ellipse cx="710" cy="380" rx="48" ry="14" fill="url(#dsDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <!-- Snow pillow on top -->
            <path d="M 668 372 Q 680 360 710 358 Q 740 360 752 372 Q 740 375 710 376 Q 680 375 668 372 Z" fill="#ffffff" opacity="0.95"/>
            <ellipse class="ds__drum-ring" cx="710" cy="380" rx="56" ry="18" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>
          <!-- Kick -->
          <g class="ds__drum ds__drum--kick" data-voice="kick">
            <ellipse cx="830" cy="490" rx="78" ry="20" fill="rgba(0,0,0,0.20)"/>
            <ellipse cx="830" cy="455" rx="80" ry="68" fill="url(#dsDrumShell)" stroke="#1a1208" stroke-width="0.8"/>
            <ellipse cx="830" cy="455" rx="62" ry="55" fill="url(#dsDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <!-- Snow on top of kick -->
            <path d="M 760 405 Q 790 388 830 386 Q 870 388 900 405 Q 870 410 830 411 Q 790 410 760 405 Z" fill="#ffffff" opacity="0.95"/>
            <circle cx="830" cy="455" r="9" fill="#332518" opacity="0.85"/>
            <ellipse class="ds__drum-ring" cx="830" cy="455" rx="88" ry="74" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>
          <!-- Snare -->
          <g class="ds__drum ds__drum--snare" data-voice="snare">
            <ellipse cx="940" cy="465" rx="40" ry="11" fill="rgba(0,0,0,0.18)"/>
            <rect x="903" y="416" width="74" height="56" rx="5" fill="url(#dsDrumShell)" stroke="#1a1208" stroke-width="0.6"/>
            <ellipse cx="940" cy="416" rx="37" ry="11" fill="url(#dsDrumHead)" stroke="#7c5532" stroke-width="0.8"/>
            <path d="M 908 410 Q 920 401 940 400 Q 960 401 972 410 Q 960 413 940 414 Q 920 413 908 410 Z" fill="#ffffff" opacity="0.95"/>
            <ellipse class="ds__drum-ring" cx="940" cy="416" rx="44" ry="14" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>
          <!-- Rack tom -->
          <g class="ds__drum ds__drum--tom" data-voice="tom">
            <ellipse cx="855" cy="378" rx="36" ry="10" fill="rgba(0,0,0,0.16)"/>
            <rect x="819" y="338" width="72" height="48" rx="5" fill="url(#dsDrumShell)" stroke="#1a1208" stroke-width="0.5"/>
            <ellipse cx="855" cy="338" rx="36" ry="10" fill="url(#dsDrumHead)" stroke="#7c5532" stroke-width="0.7"/>
            <path d="M 822 332 Q 836 324 855 323 Q 874 324 888 332 Q 874 336 855 337 Q 836 336 822 332 Z" fill="#ffffff" opacity="0.95"/>
            <ellipse class="ds__drum-ring" cx="855" cy="338" rx="42" ry="13" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>
          <!-- Ride (snow drifted on top) -->
          <g class="ds__drum ds__drum--ride" data-voice="ride">
            <line x1="990" y1="340" x2="990" y2="430" stroke="#3a3a3a" stroke-width="2"/>
            <ellipse cx="990" cy="338" rx="60" ry="11" fill="url(#dsCymbal)" stroke="#5a4220" stroke-width="0.5"/>
            <path d="M 942 333 Q 960 326 990 325 Q 1020 326 1038 333 Q 1020 336 990 337 Q 960 336 942 333 Z" fill="#ffffff" opacity="0.95"/>
            <ellipse cx="990" cy="338" rx="6" ry="2" fill="#5a4220"/>
            <ellipse class="ds__drum-ring" cx="990" cy="338" rx="68" ry="14" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>
          <!-- Hi-hat -->
          <g class="ds__drum ds__drum--hat" data-voice="hat">
            <line x1="780" y1="360" x2="780" y2="450" stroke="#3a3a3a" stroke-width="2"/>
            <ellipse cx="780" cy="358" rx="40" ry="7" fill="url(#dsCymbal)" stroke="#5a4220" stroke-width="0.4"/>
            <path d="M 744 354 Q 760 348 780 347 Q 800 348 816 354 Q 800 357 780 358 Q 760 357 744 354 Z" fill="#ffffff" opacity="0.92"/>
            <ellipse cx="780" cy="365" rx="40" ry="7" fill="url(#dsCymbal)" stroke="#5a4220" stroke-width="0.4" opacity="0.85"/>
            <ellipse class="ds__drum-ring" cx="780" cy="362" rx="46" ry="11" fill="none" stroke="#a8b8c8" stroke-width="2" opacity="0"/>
          </g>

          <!-- Falling snowflakes (animated via CSS on a parent group) -->
          <g class="ds__snow">
            <circle class="ds__flake" cx="120" cy="-10" r="1.6" fill="#ffffff" opacity="0.85"/>
            <circle class="ds__flake" cx="280" cy="-10" r="1.2" fill="#ffffff" opacity="0.75"/>
            <circle class="ds__flake" cx="430" cy="-10" r="2.0" fill="#ffffff" opacity="0.9"/>
            <circle class="ds__flake" cx="600" cy="-10" r="1.4" fill="#ffffff" opacity="0.8"/>
            <circle class="ds__flake" cx="780" cy="-10" r="1.8" fill="#ffffff" opacity="0.85"/>
            <circle class="ds__flake" cx="940" cy="-10" r="1.2" fill="#ffffff" opacity="0.75"/>
            <circle class="ds__flake" cx="1080" cy="-10" r="1.6" fill="#ffffff" opacity="0.85"/>
            <circle class="ds__flake" cx="200" cy="-10" r="1.0" fill="#ffffff" opacity="0.7"/>
            <circle class="ds__flake" cx="510" cy="-10" r="1.4" fill="#ffffff" opacity="0.8"/>
            <circle class="ds__flake" cx="860" cy="-10" r="1.2" fill="#ffffff" opacity="0.75"/>
            <circle class="ds__flake" cx="1020" cy="-10" r="2.0" fill="#ffffff" opacity="0.9"/>
            <circle class="ds__flake" cx="350" cy="-10" r="1.6" fill="#ffffff" opacity="0.85"/>
          </g>

          <!-- Soft floor shadow -->
          <ellipse cx="820" cy="540" rx="220" ry="10" fill="rgba(0,0,0,0.06)"/>
        </svg>
      </div>

      <div class="ds__overlay" id="ds-overlay">
        <button class="ds__play" id="ds-play" type="button" aria-label="Begin">
          <span class="ds__play-icon" id="ds-play-icon">▶</span>
          <span class="ds__play-label" id="ds-play-label">Begin</span>
        </button>
        <p class="ds__overlay-hint">ten minutes · headphones recommended · no buttons after this</p>
      </div>

      <div class="ds__status" id="ds-status" hidden>
        <span class="ds__status-time" id="ds-status-time">00:00</span>
        <span class="ds__status-sep">of</span>
        <span class="ds__status-total">10:00</span>
        <span class="ds__status-section" id="ds-status-section">first flake</span>
        <button class="ds__end" id="ds-end" type="button">end early</button>
      </div>
    </section>

    <section class="ds__about">
      <h2 class="ds__about-h">Everything dampened</h2>
      <p>The same garden as Drum Garden and Drum Moon, but in winter. Every audible voice passes through a master 2.4 kHz low-pass filter — modeling what three feet of fresh snow would do to the sound on its way to you. The hats are quieter than the kick because that's what snow does to high frequencies.</p>
      <p>No peak. The arc moves between sparsity levels of 0.04 and 0.18 across ten sections: <em>first flake, flurry, steady, drift, quiet between, second drift, settling, still, blue hour, last flake</em>. Snow doesn't have weather drama — it has accumulation.</p>
      <p>Snare here is not the brushed-noise snare from Drum Garden. It's a softer mallet hit — a 280 Hz triangle with a quick decay and only a tiny noise component. The bell is gone. The kick is rounder. The hi-hat is mostly muffled subharmonic with very little brightness.</p>
      <p>Snowflakes drift down across the frame at varying speeds and slight horizontal sway. The drum kit has small snow pillows on each head and cymbal edge.</p>
      <p>Sister surfaces: <a href="/drum-garden">/drum-garden</a> · <a href="/drum-rain">/drum-rain</a> · <a href="/drum-temple">/drum-temple</a> · <a href="/drum-moon">/drum-moon</a> · <a href="/drum-pavilion">/drum-pavilion</a> (gallery).</p>
    </section>
  </main>

  <style is:global>
    :root {
      --ds-frame: #1f5e3a;
      --ds-cream: #e8ecf0;
      --ds-text: #2a3326;
      --ds-text-dim: #5a6356;
      --ds-text-dimmer: #8a9285;
    }

    body:has(.ds) {
      background: radial-gradient(circle at 50% 20%, #f8f6ec 0%, #ece8d8 70%);
      color: var(--ds-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .ds { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }

    .ds__hero { text-align: left; max-width: 760px; margin: 0 auto 36px; }
    .ds__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--ds-frame);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .ds__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--ds-text);
    }
    .ds__sub {
      font-size: 17px; line-height: 1.55;
      color: var(--ds-text-dim);
      margin: 0;
    }

    .ds__stage { position: relative; margin-bottom: 36px; }
    .ds__pavilion {
      position: relative;
      aspect-ratio: 2 / 1;
      max-height: 70vh;
      background: var(--ds-cream);
      border: 14px solid var(--ds-frame);
      border-radius: 4px;
      box-shadow: 0 24px 60px rgba(31,94,58,0.18), inset 0 0 0 3px rgba(255,255,255,0.4);
      overflow: hidden;
    }
    .ds__rail { position: absolute; left: 0; right: 0; height: 16px; background: var(--ds-frame); z-index: 2; }
    .ds__rail--top { top: 0; }
    .ds__rail--bottom { bottom: 0; }
    .ds__post { position: absolute; top: 0; bottom: 0; width: 14px; background: var(--ds-frame); z-index: 2; }
    .ds__post--left  { left: 33%; }
    .ds__post--right { right: 33%; }
    .ds__scene { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }

    @keyframes dsPulse {
      0%   { opacity: 0.6; transform: scale(1); }
      100% { opacity: 0;   transform: scale(1.16); }
    }
    .ds__drum-ring.ds__drum-ring--pulse {
      animation: dsPulse 1.8s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .ds__drum--struck { animation: dsStrike 0.4s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes dsStrike {
      0% { transform: translateY(0); }
      30% { transform: translateY(1.5px) scale(0.99); }
      100% { transform: translateY(0); }
    }
    .ds__bonsai-needles {
      transform-origin: 1100px 240px;
      animation: dsSway 19s ease-in-out infinite alternate;
    }
    @keyframes dsSway {
      from { transform: rotate(-0.6deg); }
      to   { transform: rotate(0.6deg); }
    }

    /* Snowflake fall animation */
    .ds__flake {
      animation: dsFall 12s linear infinite;
      transform-origin: 0 0;
    }
    .ds__flake:nth-of-type(1)  { animation-duration: 11s; animation-delay: 0s; }
    .ds__flake:nth-of-type(2)  { animation-duration: 14s; animation-delay: 2.5s; }
    .ds__flake:nth-of-type(3)  { animation-duration: 9s;  animation-delay: 4s; }
    .ds__flake:nth-of-type(4)  { animation-duration: 13s; animation-delay: 1s; }
    .ds__flake:nth-of-type(5)  { animation-duration: 10s; animation-delay: 6s; }
    .ds__flake:nth-of-type(6)  { animation-duration: 12s; animation-delay: 3s; }
    .ds__flake:nth-of-type(7)  { animation-duration: 14s; animation-delay: 5s; }
    .ds__flake:nth-of-type(8)  { animation-duration: 11s; animation-delay: 7s; }
    .ds__flake:nth-of-type(9)  { animation-duration: 13s; animation-delay: 8s; }
    .ds__flake:nth-of-type(10) { animation-duration: 10s; animation-delay: 2s; }
    .ds__flake:nth-of-type(11) { animation-duration: 12s; animation-delay: 9s; }
    .ds__flake:nth-of-type(12) { animation-duration: 11s; animation-delay: 4s; }
    @keyframes dsFall {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(20px, 620px); }
    }

    .ds__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(244,241,229,0.35) 0%, rgba(244,241,229,0.08) 60%, transparent 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .ds__stage[data-state="playing"] .ds__overlay,
    .ds__stage[data-state="ended"] .ds__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .ds__stage[data-state="ended"] .ds__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .ds__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .ds__play-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: var(--ds-frame);
      color: #fff;
      font-size: 32px;
      display: flex; align-items: center; justify-content: center;
      box-shadow:
        0 14px 36px rgba(31,94,58,0.32),
        inset 0 -4px 8px rgba(0,0,0,0.12),
        inset 0 4px 6px rgba(255,255,255,0.18);
      transition: transform 100ms ease;
    }
    .ds__play:hover .ds__play-icon { transform: scale(1.04); }
    .ds__play:active .ds__play-icon { transform: scale(0.96); }
    .ds__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: var(--ds-text);
      letter-spacing: 0.04em;
    }
    .ds__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--ds-text-dimmer);
      text-transform: lowercase;
      margin: 0;
    }

    .ds__status {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(244,241,229,0.92);
      border: 1px solid rgba(31,94,58,0.18);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--ds-text-dim);
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .ds__stage[data-state="playing"] .ds__status,
    .ds__stage[data-state="ended"] .ds__status { opacity: 1; }
    .ds__stage[data-state="ended"] .ds__status { opacity: 0.7; }
    .ds__status-time { font-weight: 600; color: var(--ds-text); font-variant-numeric: tabular-nums; }
    .ds__status-sep { color: var(--ds-text-dimmer); }
    .ds__status-total { color: var(--ds-text); }
    .ds__status-section { margin-left: 12px; color: var(--ds-frame); text-transform: uppercase; }
    .ds__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(31,94,58,0.32);
      border-radius: 8px;
      color: var(--ds-frame);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .ds__end:hover { background: rgba(31,94,58,0.08); }

    .ds__about { max-width: 720px; margin: 0 auto; padding: 12px 0 0; }
    .ds__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--ds-text);
      margin: 0 0 14px;
    }
    .ds__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--ds-text-dim);
      margin: 0 0 14px;
    }
    .ds__about em { color: var(--ds-frame); font-style: italic; }
    .ds__about a {
      color: var(--ds-frame);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    @media (max-width: 640px) {
      .ds__pavilion { border-width: 10px; }
      .ds__post { width: 10px; }
      .ds__rail { height: 12px; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Voice = 'kick' | 'snare' | 'tom' | 'floor' | 'hat' | 'ride';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let masterFilter: BiquadFilterNode | null = null;  // the snow filter — global LP
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterFilter = ctx.createBiquadFilter();
      masterFilter.type = 'lowpass';
      masterFilter.frequency.value = 2400;  // snow muffle
      masterFilter.Q.value = 0.6;
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterFilter.connect(masterGain);
      masterGain.connect(ctx.destination);
    }
    function noise(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 3;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }
    // Route all instruments through masterFilter (which then goes to masterGain → destination)
    function bus(): AudioNode { return masterFilter!; }

    function playKick(t: number, vel = 1) {
      if (!ctx || !scheduler) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(64, t);
      osc.frequency.exponentialRampToValueAtTime(28, t + 0.18);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.5 * vel, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.45);
      osc.connect(g).connect(bus());
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.48);
      flashDrum('kick');
    }

    // Snare here is mallet-style: tone-dominant, low noise component
    function playSnare(t: number, vel = 1) {
      if (!ctx || !scheduler) return;
      const tone = ctx.createOscillator();
      const tg = ctx.createGain();
      tone.type = 'triangle';
      tone.frequency.setValueAtTime(290, t);
      tone.frequency.exponentialRampToValueAtTime(180, t + 0.18);
      tg.gain.setValueAtTime(0.0001, t);
      tg.gain.exponentialRampToValueAtTime(0.26 * vel, t + 0.004);
      tg.gain.exponentialRampToValueAtTime(0.0001, t + 0.24);
      tone.connect(tg).connect(bus());
      scheduler.trackSource(tone);
      tone.start(t);
      tone.stop(t + 0.28);
      // Tiny noise — much less than dry snare
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1600;
      bp.Q.value = 0.6;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.08 * vel, t + 0.003);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
      src.connect(bp).connect(ng).connect(bus());
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.14);
      flashDrum('snare');
    }

    function playTom(t: number, fund = 200, vel = 1, voiceVisual: Voice = 'tom') {
      if (!ctx || !scheduler) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(fund, t);
      osc.frequency.exponentialRampToValueAtTime(fund * 0.55, t + 0.32);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.26 * vel, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.52);
      osc.connect(g).connect(bus());
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.56);
      flashDrum(voiceVisual);
    }
    function playFloor(t: number, vel = 1) { playTom(t, 110, vel, 'floor'); }

    // Hi-hat: very quiet, mostly subharmonic — the snow eats it
    function playHat(t: number, vel = 1) {
      if (!ctx || !scheduler) return;
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = 4200;  // lower than normal because the snow filter will eat above this anyway
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      src.connect(hp).connect(g).connect(bus());
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.08);
      flashDrum('hat');
    }

    function playRide(t: number, vel = 1) {
      if (!ctx || !scheduler) return;
      // Very soft, long-tail noise
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 3200;
      bp.Q.value = 0.4;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.10 * vel, t + 0.06);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
      src.connect(bp).connect(g).connect(bus());
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 1.65);
      flashDrum('ride');
    }

    function flashDrum(voice: Voice) {
      const group = document.querySelector(`.ds__drum--${voice}`);
      if (!group) return;
      group.classList.remove('ds__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('ds__drum--struck');
      setTimeout(() => group.classList.remove('ds__drum--struck'), 420);
      const ring = group.querySelector('.ds__drum-ring');
      if (ring) {
        ring.classList.remove('ds__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('ds__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('ds__drum-ring--pulse'), 1900);
      }
    }

    // ---- arc ----
    type Section = {
      name: string;
      sparsity: number;
      weights: Partial<Record<Voice, number>>;
    };
    const SECTIONS: Section[] = [
      { name: 'first flake',  sparsity: 0.04, weights: { hat: 5, ride: 0.3 } },
      { name: 'flurry',       sparsity: 0.10, weights: { hat: 5, snare: 1, ride: 0.4 } },
      { name: 'steady',       sparsity: 0.14, weights: { hat: 5, snare: 2, kick: 0.6, ride: 0.5 } },
      { name: 'drift',        sparsity: 0.16, weights: { hat: 5, snare: 2, kick: 0.8, tom: 0.4, ride: 0.5 } },
      { name: 'quiet between',sparsity: 0.06, weights: { hat: 5, ride: 0.3 } },
      { name: 'second drift', sparsity: 0.18, weights: { hat: 4, snare: 2.5, kick: 1, tom: 0.5, floor: 0.3, ride: 0.5 } },
      { name: 'settling',     sparsity: 0.12, weights: { hat: 5, snare: 1.5, kick: 0.5, ride: 0.4 } },
      { name: 'still',        sparsity: 0.05, weights: { hat: 4, ride: 0.4 } },
      { name: 'blue hour',    sparsity: 0.08, weights: { hat: 4, snare: 1, kick: 0.3, ride: 0.5 } },
      { name: 'last flake',   sparsity: 0.03, weights: { hat: 4, ride: 0.3 } },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 36;  // slowest in the suite
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 2;
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let schedulingComplete = false;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) { r -= w; if (r <= 0) return v; }
      return entries[0][0];
    }

    function fireVoice(voice: Voice, t: number, vel: number) {
      switch (voice) {
        case 'kick':  playKick(t, vel); break;
        case 'snare': playSnare(t, vel); break;
        case 'tom':   playTom(t, 200, vel); break;
        case 'floor': playFloor(t, vel); break;
        case 'hat':   playHat(t, vel); break;
        case 'ride':  playRide(t, vel); break;
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.6;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        if (elapsed >= TOTAL_SEC) { schedulingComplete = true; break; }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(Math.max(0, elapsed) / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        const slotInBar = slotIdx % 8;
        const isDownbeat = slotInBar === 0;
        const isBackbeat = slotInBar === 4;
        let p = section.sparsity;
        if (isDownbeat) p = Math.min(1, p * 2);
        else if (isBackbeat) p = Math.min(1, p * 1.4);

        if (Math.random() < p) {
          let voice = pickWeighted(section.weights);
          if (isDownbeat && Math.random() < 0.45 && section.weights.kick) voice = 'kick';
          if (voice) {
            const vel = isDownbeat ? 0.95 : (isBackbeat ? 0.8 : 0.5 + Math.random() * 0.3);
            fireVoice(voice, nextSlotTime, vel);
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 90);
    }

    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('ds-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('ds-status-section')!.textContent = SECTIONS[si].name;
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('ds-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('ds-status')!.removeAttribute('hidden');
      scheduleAhead();
      tickUi();
    }
    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('ds-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('ds-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('ds-play')!.addEventListener('click', () => startPlaying());
      document.getElementById('ds-end')!.addEventListener('click', () => stopPlaying(false));
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
