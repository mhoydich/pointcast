---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CARTOGRAPHY_BUSINESS, cartographyJsonLd } from '../lib/cartography-business';
import { CARTOGRAPHY_NEXT_SPRINT } from '../lib/cartography-sprint';

const title = 'Cartography - $5M 2026 product board';
const description =
  'PointCast Cartography turns scattered creator and builder identity into brand-ready opportunity maps, paid pilots, and contribution receipts.';

const totalRevenue = CARTOGRAPHY_BUSINESS.revenueModel.reduce((sum, item) => sum + item.totalUsd, 0);

function money(value: number): string {
  if (value >= 1000000) return `$${(value / 1000000).toFixed(value % 1000000 === 0 ? 0 : 1)}M`;
  if (value >= 1000) return `$${Math.round(value / 1000)}k`;
  return `$${value}`;
}

const alternates = [
  { type: 'application/json', href: '/cartography.json', title: 'PointCast Cartography JSON' },
  { type: 'application/json', href: '/cartography/pilot.json', title: 'Cartography pilot JSON' },
  { type: 'application/json', href: '/cartography/sprint.json', title: 'Cartography sprint JSON' },
  { type: 'application/json', href: '/cartography/demo.json', title: 'Cartography demo JSON' },
];
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={cartographyJsonLd}
  alternates={alternates}
  image="/images/og/b/0442.png"
>
  <main class="cartography">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/join">Join</a>
      <span>/</span>
      <span>Cartography</span>
    </nav>

    <header class="hero">
      <section class="hero__copy">
        <p class="kicker">CARTOGRAPHY · SERVICE-TO-SAAS · 2026</p>
        <h1>Identity maps that turn creative networks into brand-ready opportunities.</h1>
        <p class="dek">{CARTOGRAPHY_BUSINESS.summary}</p>
        <div class="actions" aria-label="Cartography actions">
          <a class="button button--primary" href="/cartography/pilot">Open $50k pilot</a>
          <a class="button" href="/cartography/sprint">Sprint board</a>
          <a class="button" href="/cartography/demo">Demo map</a>
          <a class="button" href="/ping?intent=cartography">Request pilot</a>
        </div>
      </section>

      <aside class="map-visual" aria-label="Cartography sample map">
        <div class="map-visual__top">
          <span>PROFILE MAP</span>
          <strong>permissioned demo</strong>
        </div>
        <div class="map-visual__canvas">
          <img src="https://noun.pics/442.svg" alt="" loading="lazy" />
          <span class="node node--a">source links</span>
          <span class="node node--b">identity signals</span>
          <span class="node node--c">brand need</span>
          <span class="node node--d">opportunity route</span>
          <span class="node node--e">receipt</span>
        </div>
      </aside>
    </header>

    <section class="scoreboard" aria-label="Revenue target">
      <article>
        <span>2026 target</span>
        <strong>{CARTOGRAPHY_BUSINESS.goal.targetLabel}</strong>
        <p>{CARTOGRAPHY_BUSINESS.goal.metric} by {CARTOGRAPHY_BUSINESS.goal.targetBy}</p>
      </article>
      <article>
        <span>Model total</span>
        <strong>{money(totalRevenue)}</strong>
        <p>{CARTOGRAPHY_BUSINESS.revenueModel.length} revenue lanes, brands first</p>
      </article>
      <article>
        <span>Weekly demand test</span>
        <strong>{CARTOGRAPHY_BUSINESS.salesMotion.weeklyCallTarget}</strong>
        <p>founder-led sales calls per week</p>
      </article>
    </section>

    <section class="section next-sprint" id="next-sprint">
      <div class="section__head">
        <p class="kicker">LIVE SPRINT · BLOCK 0443</p>
        <h2>{CARTOGRAPHY_NEXT_SPRINT.title}</h2>
        <p>{CARTOGRAPHY_NEXT_SPRINT.goal.target}</p>
      </div>
      <div class="next-sprint__panel" aria-label="Cartography sprint target">
        <article>
          <span>Paid pilots</span>
          <strong>{CARTOGRAPHY_NEXT_SPRINT.goal.targetPilotCount}</strong>
          <p>target by {CARTOGRAPHY_NEXT_SPRINT.endDate}</p>
        </article>
        <article>
          <span>Contracted</span>
          <strong>{money(CARTOGRAPHY_NEXT_SPRINT.goal.targetContractedUsd)}</strong>
          <p>first close sprint target</p>
        </article>
        <article>
          <span>Calls</span>
          <strong>{CARTOGRAPHY_NEXT_SPRINT.goal.targetFounderCalls}</strong>
          <p>founder-led this week</p>
        </article>
        <div class="next-sprint__links">
          <a href="/cartography/sprint">Open sprint board</a>
          <a href="/cartography/pilot">Open pilot offer</a>
          <a href="/cartography/sprint.json">Sprint JSON</a>
        </div>
      </div>
    </section>

    <section class="section" id="revenue">
      <div class="section__head">
        <p class="kicker">REVENUE MODEL</p>
        <h2>Sell the expensive proof first.</h2>
        <p>
          The fastest path to $5M in 2026 is not self-serve first. It is paid
          atlases, pilots, and sprints that become the product spec.
        </p>
      </div>
      <div class="revenue-grid">
        {CARTOGRAPHY_BUSINESS.revenueModel.map((line) => (
          <article class="revenue-card">
            <div class="revenue-card__top">
              <span>{line.units} x {money(line.averageUsd)}</span>
              <strong>{money(line.totalUsd)}</strong>
            </div>
            <h3>{line.label}</h3>
            <p>{line.proof}</p>
            <small>{line.buyer}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="products">
      <div class="section__head">
        <p class="kicker">PRODUCTS</p>
        <h2>Four things to sell before the SaaS hardens.</h2>
      </div>
      <div class="package-list">
        {CARTOGRAPHY_BUSINESS.packages.map((pkg) => (
          <article class="package">
            <div>
              <p class="package__meta">{pkg.billing} · {pkg.stripeSurface}</p>
              <h3>{pkg.name}</h3>
              <p>{pkg.targetBuyer}</p>
            </div>
            <strong>{money(pkg.priceUsd)}</strong>
            <ul>
              {pkg.deliverables.map((item) => <li>{item}</li>)}
            </ul>
            <a href={pkg.fallbackUrl}>Request via PointCast</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section split" id="payments">
      <div class="section__head">
        <p class="kicker">PAYMENT RAILS</p>
        <h2>Stripe hosts the money surface.</h2>
        <p>{CARTOGRAPHY_BUSINESS.paymentRails.staticSitePolicy}</p>
      </div>
      <div class="rail">
        <p><strong>Implementation:</strong> {CARTOGRAPHY_BUSINESS.paymentRails.implementation}</p>
        <p><strong>Secret policy:</strong> {CARTOGRAPHY_BUSINESS.paymentRails.secretHandling}</p>
        <p class="rail__note">
          Public package CTAs are wired to PointCast intake until live Stripe
          Payment Links or invoices are configured in the Stripe dashboard.
        </p>
      </div>
    </section>

    <section class="section ladder" id="ladder">
      <div class="section__head">
        <p class="kicker">PRODUCT LADDER</p>
        <h2>Manual maps become software only after customers pay.</h2>
      </div>
      <ol class="ladder__list">
        {CARTOGRAPHY_BUSINESS.productLadder.map((step) => (
          <li>
            <span>{step.period}</span>
            <h3>{step.name}</h3>
            <p>{step.outcome}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="yield">
      <div class="section__head">
        <p class="kicker">YIELDING PRODUCTS</p>
        <h2>Yield means visible commercial output.</h2>
        <p>{CARTOGRAPHY_BUSINESS.positioning.yieldDefinition}</p>
      </div>
      <div class="yield-grid">
        {CARTOGRAPHY_BUSINESS.yieldProducts.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <p>{item.measure}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split" id="demo">
      <div class="section__head">
        <p class="kicker">DEMO + SCHEMAS</p>
        <h2>The product is already inspectable.</h2>
        <p>
          The demo uses fictional permissioned identity data. The machine
          mirror exposes profile maps, opportunity routes, and contribution
          receipts without private notes.
        </p>
      </div>
      <div class="demo-links">
        <a href="/cartography/demo">Human demo</a>
        <a href="/cartography/demo.json">Demo JSON</a>
        <a href="/cartography/pilot">Pilot offer</a>
        <a href="/cartography/sprint">Sprint board</a>
        <a href="/cartography.json">Business JSON</a>
        <a href="/join#tasks">Claim tasks</a>
      </div>
    </section>

    <section class="section" id="milestones">
      <div class="section__head">
        <p class="kicker">MILESTONES</p>
        <h2>The calendar is the operating system.</h2>
      </div>
      <ol class="milestones">
        {CARTOGRAPHY_BUSINESS.milestones.map((milestone) => (
          <li>
            <time datetime={milestone.by}>{milestone.by}</time>
            <span>{milestone.target}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="guardrails" aria-label="Cartography guardrails">
      <p class="kicker">GUARDRAILS</p>
      <ul>
        {CARTOGRAPHY_BUSINESS.guardrails.map((guardrail) => <li>{guardrail}</li>)}
      </ul>
    </section>
  </main>

  <style>
    .cartography {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 18px 88px;
      color: #12110e;
    }

    .crumb,
    .kicker,
    .scoreboard span,
    .next-sprint__panel span,
    .revenue-card__top span,
    .package__meta,
    .map-visual__top,
    .ladder__list span,
    .milestones time {
      font-family: var(--pc-font-mono);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .crumb {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      color: #65625a;
      font-size: 11px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
      gap: 22px;
      align-items: stretch;
      padding-bottom: 24px;
      border-bottom: 1px solid #d8d4ca;
    }

    .hero__copy {
      display: flex;
      min-height: 420px;
      flex-direction: column;
      justify-content: center;
    }

    .kicker {
      margin: 0 0 10px;
      color: #185fa5;
      font-size: 11px;
      font-weight: 500;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      letter-spacing: 0;
      font-family: var(--pc-font-sans);
    }

    h1 {
      max-width: 760px;
      font-size: 54px;
      line-height: 0.98;
    }

    .dek {
      max-width: 720px;
      margin: 16px 0 0;
      color: #38373a;
      font-size: 18px;
      line-height: 1.5;
    }

    .actions,
    .demo-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 22px;
    }

    .button,
    .demo-links a,
    .package a,
    .next-sprint__links a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 14px;
      border: 1px solid #12110e;
      color: #12110e;
      text-decoration: none;
      font-family: var(--pc-font-mono);
      font-size: 12px;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .button--primary {
      background: #12110e;
      color: #fffdf5;
    }

    .map-visual {
      display: grid;
      grid-template-rows: auto 1fr;
      min-height: 420px;
      border: 1px solid #12110e;
      background: #f7f8f2;
    }

    .map-visual__top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 12px;
      border-bottom: 1px solid #12110e;
      color: #4a4740;
      font-size: 11px;
    }

    .map-visual__canvas {
      position: relative;
      min-height: 340px;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(18,17,14,0.08) 1px, transparent 1px),
        linear-gradient(180deg, rgba(18,17,14,0.06) 1px, transparent 1px),
        #fffdf5;
      background-size: 34px 34px;
    }

    .map-visual__canvas::before,
    .map-visual__canvas::after {
      content: "";
      position: absolute;
      left: 20%;
      right: 16%;
      top: 50%;
      border-top: 2px solid #185fa5;
      transform: rotate(-18deg);
      transform-origin: center;
    }

    .map-visual__canvas::after {
      border-top-color: #8a2432;
      transform: rotate(23deg);
    }

    .map-visual img {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      width: 124px;
      transform: translate(-50%, -50%);
      filter: drop-shadow(0 10px 24px rgba(18,17,14,0.18));
    }

    .node {
      position: absolute;
      z-index: 3;
      max-width: 150px;
      padding: 8px 10px;
      border: 1px solid #12110e;
      background: #ffffff;
      font-size: 12px;
      line-height: 1.25;
    }

    .node--a { left: 8%; top: 12%; border-left: 5px solid #185fa5; }
    .node--b { right: 7%; top: 18%; border-left: 5px solid #0f6e56; }
    .node--c { left: 10%; bottom: 16%; border-left: 5px solid #ba7517; }
    .node--d { right: 10%; bottom: 20%; border-left: 5px solid #8a2432; }
    .node--e { left: 44%; bottom: 7%; border-left: 5px solid #5f3dc4; }

    .scoreboard {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 22px 0 10px;
    }

    .scoreboard article,
    .next-sprint__panel,
    .next-sprint__panel article,
    .revenue-card,
    .package,
    .yield-grid article,
    .rail,
    .guardrails {
      border: 1px solid #d8d4ca;
      background: #fff;
    }

    .scoreboard article {
      padding: 16px;
    }

    .scoreboard span {
      display: block;
      margin-bottom: 8px;
      color: #65625a;
      font-size: 11px;
    }

    .scoreboard strong {
      display: block;
      font-size: 38px;
      line-height: 1;
    }

    .scoreboard p {
      margin: 8px 0 0;
      color: #4f4c45;
      font-size: 13px;
      line-height: 1.45;
    }

    .section {
      margin-top: 34px;
    }

    .section__head {
      margin-bottom: 14px;
    }

    .section__head h2 {
      max-width: 760px;
      font-size: 30px;
      line-height: 1.08;
    }

    .section__head p:not(.kicker) {
      max-width: 740px;
      margin: 10px 0 0;
      color: #4f4c45;
      font-size: 15px;
      line-height: 1.55;
    }

    .next-sprint {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
      gap: 18px;
      align-items: start;
      padding: 18px 0;
      border-top: 1px solid #12110e;
      border-bottom: 1px solid #12110e;
    }

    .next-sprint__panel {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      padding: 12px;
      background: #eef4fa;
    }

    .next-sprint__panel article {
      padding: 12px;
      background: #fffdf5;
    }

    .next-sprint__panel span {
      display: block;
      margin-bottom: 8px;
      color: #65625a;
      font-size: 10px;
    }

    .next-sprint__panel strong {
      display: block;
      font-size: 34px;
      line-height: 1;
    }

    .next-sprint__panel p {
      margin: 8px 0 0;
      color: #4f4c45;
      font-size: 12px;
      line-height: 1.4;
    }

    .next-sprint__links {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .revenue-grid,
    .yield-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .revenue-card,
    .yield-grid article {
      padding: 15px;
    }

    .revenue-card__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .revenue-card__top span,
    .package__meta,
    .ladder__list span,
    .milestones time {
      color: #65625a;
      font-size: 10px;
    }

    .revenue-card__top strong {
      font-size: 24px;
      line-height: 1;
    }

    .revenue-card h3,
    .package h3,
    .yield-grid h3 {
      font-size: 18px;
      line-height: 1.16;
    }

    .revenue-card p,
    .revenue-card small,
    .package p,
    .package li,
    .yield-grid p,
    .rail p {
      color: #4f4c45;
      font-size: 13px;
      line-height: 1.45;
    }

    .revenue-card small {
      display: block;
      margin-top: 10px;
    }

    .package-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .package {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      padding: 16px;
    }

    .package strong {
      font-size: 28px;
      line-height: 1;
    }

    .package ul {
      grid-column: 1 / -1;
      margin: 0;
      padding-left: 18px;
    }

    .package a {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 2px;
    }

    .split {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(280px, 1fr);
      gap: 18px;
      align-items: start;
    }

    .rail {
      padding: 16px;
      border-left: 5px solid #185fa5;
    }

    .rail__note {
      padding-top: 10px;
      border-top: 1px dashed #d8d4ca;
    }

    .ladder__list,
    .milestones {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ladder__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .ladder__list li {
      min-height: 190px;
      padding: 16px;
      border: 1px solid #12110e;
      background: #f7f8f2;
    }

    .ladder__list h3 {
      margin-top: 12px;
      font-size: 20px;
    }

    .ladder__list p {
      margin: 10px 0 0;
      color: #4f4c45;
      font-size: 13px;
      line-height: 1.45;
    }

    .yield-grid article {
      border-left: 5px solid #0f6e56;
    }

    .demo-links {
      margin-top: 0;
    }

    .milestones {
      display: grid;
      gap: 8px;
    }

    .milestones li {
      display: grid;
      grid-template-columns: 130px minmax(0, 1fr);
      gap: 14px;
      padding: 12px 0;
      border-bottom: 1px solid #d8d4ca;
    }

    .milestones span {
      color: #38373a;
      line-height: 1.45;
    }

    .guardrails {
      margin-top: 34px;
      padding: 16px;
      border-left: 5px solid #8a2432;
      background: #fff8f6;
    }

    .guardrails ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px 18px;
      margin: 0;
      padding-left: 18px;
      color: #38373a;
      font-size: 13px;
      line-height: 1.45;
    }

    @media (max-width: 880px) {
      .hero,
      .scoreboard,
      .next-sprint,
      .next-sprint__panel,
      .revenue-grid,
      .package-list,
      .split,
      .ladder__list,
      .yield-grid,
      .guardrails ul {
        grid-template-columns: 1fr;
      }

      .hero__copy,
      .map-visual {
        min-height: auto;
      }

      h1 {
        font-size: 38px;
      }

      .map-visual__canvas {
        min-height: 320px;
      }

      .milestones li {
        grid-template-columns: 1fr;
        gap: 4px;
      }
    }
  </style>
</BlockLayout>
