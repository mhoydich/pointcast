---
import BlockLayout from '../layouts/BlockLayout.astro';
import { cartographyJsonLd } from '../lib/cartography-business';

const title = 'Cartography Archive';
const description = 'An archived PointCast exploration of permissioned identity maps and public/private data boundaries.';
const alternates = [
  { type: 'application/json', href: '/cartography.json', title: 'Cartography archive JSON' },
  { type: 'application/json', href: '/cartography/demo.json', title: 'Cartography demo JSON' },
  { type: 'application/json', href: '/cartography/home.json', title: 'Home Cartography concept JSON' },
];
---

<BlockLayout title={title} description={description} jsonLd={cartographyJsonLd} alternates={alternates} image="/images/og/b/0442.png">
  <main class="cartography">
    <nav><a href="/">Home</a><span>/</span><span>Cartography</span></nav>
    <header>
      <p>ARCHIVE · POINTCAST</p>
      <h1>{title}</h1>
      <p class="dek">A May 2026 exploration of permissioned identity maps. The commercial plan has been retired.</p>
    </header>
    <section>
      <h2>Explore the archive</h2>
      <ul>
        <li><a href="/cartography/demo">The fictional profile-map demo</a>, with public and private fields clearly separated.</li>
        <li>The current <a href="/cartography/home">Home Cartography</a> household-index concept.</li>
      </ul>
    </section>
    <section>
      <h2>Archive links</h2>
      <p><a href="/cartography/demo">View the fictional demo</a> · <a href="/cartography/demo.json">Demo JSON</a> · <a href="/cartography.json">Archive JSON</a></p>
    </section>
  </main>
  <style>
    .cartography { max-width: 760px; margin: 0 auto; padding: 32px 18px 88px; color: #12110e; }
    nav { display: flex; gap: 8px; color: #65625a; font: 11px var(--pc-font-mono); text-transform: uppercase; }
    header { padding: 56px 0 36px; border-bottom: 1px solid #d8d4ca; } header > p:first-child { color: #185fa5; font: 11px var(--pc-font-mono); }
    h1 { margin: 0; font-size: clamp(42px, 9vw, 76px); line-height: .95; } h2 { margin: 0 0 12px; font-size: 24px; }
    .dek { font-size: 22px; line-height: 1.35; } section { padding: 28px 0; border-bottom: 1px solid #d8d4ca; } li { margin: 8px 0; line-height: 1.5; } a { color: #185fa5; }
  </style>
</BlockLayout>
