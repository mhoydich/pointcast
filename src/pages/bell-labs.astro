---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ABSTRACT, PAPER_META, PAPER_NOTES, PLATES, REFERENCES, SECTIONS } from '../lib/bellLabsPaper';

const title = `${PAPER_META.title} — UES Working Paper`;
const description = `Second entry in 'The Lab and the Radius' UES Working Papers series. ${PAPER_META.publication}.`;

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  '@id': 'https://pointcast.xyz/bell-labs',
  headline: PAPER_META.title,
  name: PAPER_META.title,
  abstract: ABSTRACT,
  url: 'https://pointcast.xyz/bell-labs',
  isPartOf: { '@type': 'Periodical', name: PAPER_META.publication },
  datePublished: PAPER_META.date,
  identifier: PAPER_META.doi,
  keywords: PAPER_META.keywords.join(', '),
  author: PAPER_META.authors.map((a) => ({ '@type': 'Person', name: a.name, affiliation: { '@type': 'Organization', name: a.dept } })),
  publisher: { '@type': 'EducationalOrganization', name: PAPER_META.affiliation, url: 'https://pointcast.xyz/university-of-el-segundo' },
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/bell-labs.json', title: 'Working paper (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/labs">labs</a><span aria-hidden="true">/</span>
      <span>bell-labs</span>
    </nav>

    <header class="masthead">
      <div class="masthead__rule"></div>
      <p class="masthead__pub">{PAPER_META.publication}</p>
      <p class="masthead__no">{PAPER_META.paperNumber} · Series: <a href={PAPER_META.series.hub}>{PAPER_META.series.name}</a> · Position {PAPER_META.series.position}</p>
    </header>

    <article class="article">
      <h1>{PAPER_META.title}</h1>

      <ol class="byline">{PAPER_META.authors.map((a) => (
        <li><strong>{a.name}</strong> · {a.dept} · {PAPER_META.affiliation} · <a href={`mailto:${a.email}`}>{a.email}</a></li>
      ))}</ol>

      <p class="meta">{PAPER_META.date} · DOI {PAPER_META.doi} · Keywords: {PAPER_META.keywords.join(', ')}.</p>

      <section class="abstract">
        <h2>Abstract</h2>
        <p>{ABSTRACT}</p>
      </section>

      <div class="body">
        {SECTIONS.map((s) => (
          <section class="sec" id={`s-${s.number}`}>
            <h2><span class="sec__no">{s.number}</span> {s.title}</h2>
            {s.body.map((p) => (<p set:html={p} />))}
            {s.footnotes && s.footnotes.length > 0 && (
              <ol class="footnotes">{s.footnotes.map((f) => (
                <li id={`fn-${s.number}-${f.mark}`}><sup>{f.mark}</sup> <span set:html={f.text} /></li>
              ))}</ol>
            )}
          </section>
        ))}

        <section class="sec plates" id="plates">
          <h2><span class="sec__no">A</span> Appendix: Specimen Plates</h2>
          <p>The plates below are reconstructions, not photographs.</p>
          <ol class="plate-list">{PLATES.map((p) => (
            <li class={`plate plate--${p.era}`}>
              <figure>
                {p.era === 'hallway-plan' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#f4ecd9" />
                    <rect x="20" y="100" width="280" height="80" fill="#fff" stroke="#1a1a1a" stroke-width="2" />
                    <rect x="20" y="130" width="280" height="20" fill="#e8e4d8" />
                    {Array.from({length:14}).map((_, i) => (
                      <g key={i}>
                        <rect x={28 + i*20} y={104} width="14" height="22" fill="#fff" stroke="#1a1a1a" stroke-width="0.5" />
                        <rect x={28 + i*20} y={154} width="14" height="22" fill="#fff" stroke="#1a1a1a" stroke-width="0.5" />
                      </g>
                    ))}
                    <text x="160" y="146" font-family="monospace" font-size="9" text-anchor="middle" fill="#5a5450" letter-spacing="2">— 720 FT —</text>
                    <text x="160" y="80" font-family="serif" font-size="11" text-anchor="middle" fill="#1a1a1a" font-style="italic">Murray Hill · Building 1 · 1942</text>
                    <text x="160" y="220" font-family="serif" font-size="10" text-anchor="middle" fill="#5a5450" font-style="italic">"no researcher walks from his office to his laboratory</text>
                    <text x="160" y="234" font-family="serif" font-size="10" text-anchor="middle" fill="#5a5450" font-style="italic">without passing the doors of three colleagues</text>
                    <text x="160" y="248" font-family="serif" font-size="10" text-anchor="middle" fill="#5a5450" font-style="italic">from a different field"   — M. J. Kelly</text>
                  </svg>
                )}
                {p.era === 'transistor-1947' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#e8e4d8" />
                    <rect x="80" y="170" width="160" height="40" fill="#7a8898" stroke="#1a1a1a" stroke-width="2" />
                    <text x="160" y="195" font-family="monospace" font-size="10" text-anchor="middle" fill="#fdf9ee" letter-spacing="1">GERMANIUM · n-type</text>
                    <line x1="120" y1="170" x2="120" y2="100" stroke="#d4a534" stroke-width="3" />
                    <line x1="200" y1="170" x2="200" y2="100" stroke="#d4a534" stroke-width="3" />
                    <circle cx="120" cy="170" r="4" fill="#d4a534" stroke="#1a1a1a" stroke-width="1" />
                    <circle cx="200" cy="170" r="4" fill="#d4a534" stroke="#1a1a1a" stroke-width="1" />
                    <text x="120" y="92" font-family="monospace" font-size="9" text-anchor="middle" fill="#1a1a1a">EMITTER</text>
                    <text x="200" y="92" font-family="monospace" font-size="9" text-anchor="middle" fill="#1a1a1a">COLLECTOR</text>
                    <line x1="80" y1="210" x2="240" y2="210" stroke="#1a1a1a" stroke-width="3" />
                    <text x="160" y="230" font-family="monospace" font-size="9" text-anchor="middle" fill="#1a1a1a">BASE (Al)</text>
                    <text x="160" y="50" font-family="serif" font-size="11" text-anchor="middle" fill="#1a1a1a" font-style="italic">Point-contact transistor</text>
                    <text x="160" y="64" font-family="serif" font-size="10" text-anchor="middle" fill="#5a5450" font-style="italic">Bardeen, Brattain · Dec 16, 1947</text>
                    <text x="160" y="262" font-family="monospace" font-size="9" text-anchor="middle" fill="#5a5450" letter-spacing="1">FIRST AMPLIFICATION ≈ 100×</text>
                  </svg>
                )}
                {p.era === 'horn-antenna' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#e8e4d8" />
                    <polygon points="40,100 280,40 280,160 40,180" fill="#a8a39a" stroke="#1a1a1a" stroke-width="2" />
                    <polygon points="280,40 280,160 290,150 290,50" fill="#7a7570" stroke="#1a1a1a" stroke-width="1" />
                    <line x1="40" y1="100" x2="40" y2="180" stroke="#1a1a1a" stroke-width="2" />
                    <rect x="32" y="180" width="16" height="40" fill="#5a5450" stroke="#1a1a1a" stroke-width="1.5" />
                    <rect x="20" y="220" width="40" height="20" fill="#5a5450" stroke="#1a1a1a" stroke-width="1.5" />
                    <line x1="280" y1="100" x2="320" y2="100" stroke="#2a5a8a" stroke-width="1" stroke-dasharray="3 3" />
                    <text x="160" y="60" font-family="serif" font-size="11" text-anchor="middle" fill="#1a1a1a" font-style="italic">Holmdel Horn Antenna</text>
                    <text x="160" y="76" font-family="serif" font-size="10" text-anchor="middle" fill="#5a5450" font-style="italic">50 ft aperture · 20 ft × 20 ft mouth</text>
                    <text x="160" y="262" font-family="monospace" font-size="9" text-anchor="middle" fill="#5a5450" letter-spacing="1">CMB · 4.2 K · PENZIAS &amp; WILSON · 1964</text>
                  </svg>
                )}
                {p.era === 'campus-aerial' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#7a8c5a" />
                    <rect x="0" y="0" width="320" height="280" fill="#a8b58c" opacity="0.4" />
                    <g fill="#a8b58c">
                      {Array.from({length:30}).map((_, i) => (<circle key={i} cx={(i*47)%320} cy={(i*53)%280} r="6" />))}
                    </g>
                    <rect x="40" y="120" width="160" height="32" fill="#fdf9ee" stroke="#1a1a1a" stroke-width="2" />
                    <rect x="44" y="124" width="152" height="6" fill="#5a5450" />
                    <rect x="60" y="158" width="60" height="38" fill="#fdf9ee" stroke="#1a1a1a" stroke-width="1.5" />
                    <rect x="130" y="158" width="50" height="32" fill="#fdf9ee" stroke="#1a1a1a" stroke-width="1.5" />
                    <rect x="200" y="100" width="80" height="50" fill="#fdf9ee" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="120" y="142" font-family="monospace" font-size="8" text-anchor="middle" fill="#1a1a1a">BUILDING 1 · 720 FT</text>
                    <line x1="0" y1="225" x2="320" y2="225" stroke="#4a4a4a" stroke-width="3" />
                    <line x1="0" y1="234" x2="320" y2="234" stroke="#4a4a4a" stroke-width="3" />
                    <text x="160" y="252" font-family="monospace" font-size="9" text-anchor="middle" fill="#fdf9ee" letter-spacing="1">DL&amp;W RR · TO MANHATTAN ↗ 25 MI</text>
                    <text x="160" y="270" font-family="serif" font-size="10" text-anchor="middle" fill="#1a1a1a" font-style="italic">Murray Hill, NJ · 213 acres · c. 1962</text>
                  </svg>
                )}
                <figcaption><strong>{p.figure}.</strong> {p.caption}</figcaption>
              </figure>
            </li>
          ))}</ol>
        </section>

        <section class="sec acks">
          <h2><span class="sec__no">B</span> Acknowledgments</h2>
          <p>{PAPER_NOTES.acknowledgments}</p>
        </section>

        <section class="sec series-note">
          <h2><span class="sec__no">S</span> Series Note</h2>
          <p>{PAPER_NOTES.seriesNote}</p>
        </section>

        <section class="sec refs" id="references">
          <h2><span class="sec__no">R</span> References</h2>
          <ol>{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
        </section>

        <section class="sec colophon">
          <h2><span class="sec__no">C</span> Colophon</h2>
          <p><em>{PAPER_NOTES.uesNote}</em> Set in JetBrains Mono and Georgia. Specimen plates are SVG reconstructions, not photographs of recovered objects. The text is a tribute. The voice is scholarly; the affection is sincere.</p>
          <p class="ref-back"><a href="/labs">← The Lab and the Radius (series hub)</a> · <a href="/menlo-park">UES-WP-2026-06 Menlo Park</a> · <a href="/trapper-keeper">UES-WP-2026-04 Trapper Keeper</a> · <a href="/walkman">UES-WP-2026-05 Walkman</a> · <a href="/bell-labs.json">JSON</a></p>
        </section>
      </div>
    </article>
  </div>
</BlockLayout>

<style>
  .paper { max-width: 760px; margin: 0 auto; padding: 0 24px 88px; background: #fdf9ee; color: #1a1a1a; font-family: Georgia, "Times New Roman", serif; }
  .crumb { padding: 18px 0 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }
  .masthead { padding: 14px 0 18px; }
  .masthead__rule { height: 6px; background: #1a1a1a; margin: 0 0 8px; }
  .masthead__pub { margin: 0; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }
  .masthead__no { margin: 4px 0 0; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .masthead__no a { color: #1a1a1a; }
  .article h1 { font-family: Georgia, serif; font-size: 36px; line-height: 1.18; font-weight: 700; margin: 24px 0 14px; max-width: 30ch; }
  .byline { list-style: none; padding: 0; margin: 0 0 8px; font-size: 14px; font-style: italic; }
  .byline li { margin-bottom: 4px; }
  .byline a { color: inherit; }
  .meta { margin: 0 0 28px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .04em; color: #5a5450; }
  .abstract { padding: 14px 18px; margin: 0 0 28px; background: #f4ecd9; border-left: 4px solid #1a1a1a; border-right: 4px solid #1a1a1a; }
  .abstract h2 { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin: 0 0 8px; }
  .abstract p { margin: 0; font-size: 14px; line-height: 1.6; font-style: italic; }
  .body { font-size: 16px; line-height: 1.65; }
  .sec { margin: 0 0 28px; }
  .sec h2 { font-size: 19px; line-height: 1.25; font-weight: 700; margin: 24px 0 10px; padding-top: 10px; border-top: 1px solid #1a1a1a; display: flex; gap: 10px; align-items: baseline; }
  .sec__no { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .08em; color: #2a5a8a; min-width: 24px; }
  .sec p { margin: 0 0 12px; }
  .sec p em { font-style: italic; }
  .sec p strong { font-weight: 700; }
  .sec p sup { font-size: .75em; }
  .footnotes { list-style: none; padding: 12px 0 0; margin: 16px 0 0; border-top: 1px solid #c8c4b3; font-size: 13px; line-height: 1.55; color: #2a2a2a; }
  .footnotes li { margin-bottom: 6px; padding-left: 16px; position: relative; }
  .footnotes li sup { position: absolute; left: 0; top: 0; font-family: var(--pc-font-mono); font-size: 11px; color: #2a5a8a; }
  .plate-list { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 18px; grid-template-columns: 1fr 1fr; }
  .plate-list li { background: #fff; border: 1px solid #1a1a1a; padding: 10px; }
  .plate-art { width: 100%; height: auto; display: block; aspect-ratio: 320 / 280; }
  figcaption { margin-top: 10px; font-size: 12px; line-height: 1.5; color: #2a2a2a; }
  figcaption strong { font-weight: 700; }
  .acks p,.series-note p { font-style: italic; }
  .refs ol { padding-left: 20px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 8px; }
  .refs li em { font-style: italic; }
  .colophon p { font-size: 13px; }
  .colophon a { color: inherit; }
  .ref-back { margin-top: 14px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; }
  @media (max-width: 620px) {
    .article h1 { font-size: 26px; }
    .plate-list { grid-template-columns: 1fr; }
    .paper { padding-inline: 18px; }
  }
</style>
