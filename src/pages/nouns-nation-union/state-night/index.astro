---
/**
 * /nouns-nation-union/state-night - hostable regional slate launcher.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import {
  NOUNS_STATE_LEAGUE_REGIONS,
  NOUNS_STATE_LEAGUE_VERSION,
  buildNounsStateNightSlate,
} from '../../../lib/nouns-state-league';

const slates = NOUNS_STATE_LEAGUE_REGIONS.map((region) => buildNounsStateNightSlate(region));
const regionIds = 'Atlantic Appalachian Great Lakes Gulf Heartland Mountain Pacific Prairie';
const defaultSlate = slates.find((slate) => slate.region === 'Pacific') ?? slates[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Nouns Union State Night Launcher',
  url: 'https://pointcast.xyz/nouns-nation-union/state-night/',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  description:
    'A local-first launcher for hostable Nouns Union State Night slates with regional matchups, watch invites, agent tasks, sponsor-safe reads, and goal presets.',
};
---

<BlockLayout
  title="Nouns Union State Night"
  description="Pick a region, generate state matchups, copy host and agent prompts, and set the State Night /goal for the Nouns United States Union League."
  image="/images/og/nouns-battler-live.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-union.json', title: 'Nouns Union JSON' },
    { type: 'application/json', href: '/nouns-nation-battler.json', title: 'Nouns Battler manifest' },
  ]}
>
  <main class="state-night" data-slates={JSON.stringify(slates)} data-region-ids={regionIds}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/nouns-nation/">Nouns Nation</a>
      <span>/</span>
      <a href="/nouns-nation-union/">Union League</a>
      <span>/</span>
      <span>State Night</span>
    </nav>

    <section class="hero" aria-labelledby="state-night-title">
      <div class="hero__copy">
        <p class="kicker">Union State Night Launcher / V1</p>
        <h1 id="state-night-title">Pick a region. Host a weird state slate.</h1>
        <p>
          State Night turns the 50-state atlas into an actual watchable card: three matchups,
          one host rundown, one artifact bundle, one sponsor-safe read, and one agent handoff.
        </p>
        <div class="hero-actions">
          <a class="primary" href="/goal?preset=nouns-union-state-night#setup">Set State Night /goal</a>
          <a href="/nouns-nation-battler-tv/">Open TV Cast</a>
          <a href="/nouns-nation-union/artifacts/">Artifact Studio</a>
          <a href="/nouns-nation-union.json">Union JSON</a>
        </div>
      </div>
      <aside class="hero-card">
        <span data-hero-region>{defaultSlate.region}</span>
        <strong data-hero-title>{defaultSlate.title}</strong>
        <p data-hero-headline>{defaultSlate.headline}</p>
        <em>{NOUNS_STATE_LEAGUE_VERSION} / local-first / no official sports claims</em>
      </aside>
    </section>

    <section class="control-room" aria-labelledby="control-title">
      <div class="section-head">
        <p class="kicker">Control Room</p>
        <h2 id="control-title">Generate the slate package.</h2>
        <p>
          Choose a region, then copy the exact artifact you need: host rundown, invite, creative bundle,
          sponsor read, or agent task. Every output is reservation-only and human-reviewable.
        </p>
      </div>
      <div class="controls">
        <label>
          <span>Region</span>
          <select data-region-select>
            {slates.map((slate) => (
              <option value={slate.region} selected={slate.region === defaultSlate.region}>{slate.region}</option>
            ))}
          </select>
        </label>
        <label>
          <span>Featured matchup</span>
          <select data-matchup-select>
            {defaultSlate.matchups.map((matchup) => (
              <option value={matchup.id}>{matchup.left.short} vs {matchup.right.short}</option>
            ))}
          </select>
        </label>
      </div>
    </section>

    <section class="matchups" aria-labelledby="matchups-title">
      <div class="section-head">
        <p class="kicker">Three-Match Card</p>
        <h2 id="matchups-title">The state-vs-state slate.</h2>
      </div>
      <div class="matchup-grid" data-matchup-grid>
        {defaultSlate.matchups.map((matchup) => (
          <article class="match-card" style={`--left:${matchup.left.colors[0]};--right:${matchup.right.colors[0]};`} data-matchup-card={matchup.id}>
            <div class="match-card__teams">
              <img src={`/games/nouns-nation-battler/assets/noun-${matchup.left.nounSeed % 60}.svg`} alt="" loading="lazy" />
              <strong>{matchup.left.short}</strong>
              <span>vs</span>
              <strong>{matchup.right.short}</strong>
              <img src={`/games/nouns-nation-battler/assets/noun-${matchup.right.nounSeed % 60}.svg`} alt="" loading="lazy" />
            </div>
            <h3>{matchup.left.team} vs {matchup.right.team}</h3>
            <p>{matchup.headline}</p>
            <em>{matchup.fieldLine}</em>
          </article>
        ))}
      </div>
    </section>

    <section class="outputs" aria-labelledby="outputs-title">
      <div class="section-head">
        <p class="kicker">Copy Desk</p>
        <h2 id="outputs-title">Copy the piece you need.</h2>
      </div>
      <div class="output-grid">
        <article>
          <span>Host Rundown</span>
          <textarea readonly data-output="host">{defaultSlate.hostRundown}</textarea>
          <button type="button" data-copy-output="host">Copy Host Rundown</button>
        </article>
        <article>
          <span>Watch Invite</span>
          <textarea readonly data-output="invite">{defaultSlate.watchInvite}</textarea>
          <button type="button" data-copy-output="invite">Copy Watch Invite</button>
        </article>
        <article>
          <span>Artifact Bundle</span>
          <textarea readonly data-output="artifacts">{defaultSlate.artifactBundle}</textarea>
          <button type="button" data-copy-output="artifacts">Copy Artifact Prompts</button>
        </article>
        <article>
          <span>Sponsor Read</span>
          <textarea readonly data-output="sponsor">{defaultSlate.sponsorRead}</textarea>
          <button type="button" data-copy-output="sponsor">Copy Sponsor Read</button>
        </article>
        <article>
          <span>Agent Task</span>
          <textarea readonly data-output="agent">{defaultSlate.agentTask}</textarea>
          <button type="button" data-copy-output="agent">Copy Agent Task</button>
        </article>
        <article>
          <span>Proof Checklist</span>
          <textarea readonly data-output="proof">{defaultSlate.proofChecklist.join('\n')}</textarea>
          <a href="/goal?preset=nouns-union-state-night#setup">Open /goal Preset</a>
        </article>
      </div>
      <p class="copy-status" data-copy-status>{defaultSlate.guardrail}</p>
    </section>
  </main>
</BlockLayout>

<style>
  .state-night {
    display: grid;
    gap: 28px;
    color: #171717;
  }

  .crumb,
  .hero-actions,
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .crumb {
    color: #5f6259;
    font-size: 0.85rem;
    font-weight: 850;
  }

  .crumb a,
  .hero-actions a,
  .output-grid a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    min-height: min(700px, calc(100vh - 110px));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 24px;
    align-items: stretch;
  }

  .hero__copy,
  .hero-card,
  .control-room,
  .matchups,
  .outputs {
    border: 2px solid #171717;
    background: #fffdf5;
    box-shadow: 6px 6px 0 #171717;
  }

  .hero__copy {
    min-width: 0;
    padding: clamp(24px, 5vw, 64px);
    display: grid;
    align-content: center;
    gap: 18px;
    background:
      radial-gradient(circle at 18% 20%, rgba(215, 255, 63, 0.45), transparent 28%),
      linear-gradient(135deg, #fffdf5, #e8f4ff 58%, #ffe8ec);
  }

  .kicker,
  .controls span,
  .output-grid span,
  .hero-card span,
  .hero-card em,
  .match-card em {
    margin: 0;
    color: #5f6259;
    font: 900 0.74rem/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero__copy p,
  .section-head p {
    max-width: 780px;
    color: #3f423c;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.45;
  }

  .hero-actions a,
  .output-grid button,
  .output-grid a {
    display: inline-grid;
    place-items: center;
    min-height: 42px;
    padding: 0 14px;
    border: 2px solid #171717;
    background: #fffdf5;
    box-shadow: 3px 3px 0 #171717;
    font: inherit;
    font-weight: 950;
    cursor: pointer;
  }

  .hero-actions .primary,
  .output-grid button {
    background: #d7ff3f;
  }

  .hero-card {
    padding: 24px;
    display: grid;
    align-content: end;
    gap: 12px;
    background:
      repeating-linear-gradient(135deg, rgba(23, 23, 23, 0.08) 0 12px, transparent 12px 24px),
      #f6bd16;
  }

  .hero-card strong {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
  }

  .control-room,
  .matchups,
  .outputs {
    padding: clamp(18px, 3vw, 34px);
  }

  .section-head {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
  }

  .section-head h2 {
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 0.96;
  }

  .controls label {
    min-width: min(100%, 300px);
    display: grid;
    gap: 6px;
  }

  .controls select {
    min-height: 44px;
    border: 2px solid #171717;
    background: #fff;
    color: #171717;
    padding: 0 12px;
    font: inherit;
    font-weight: 850;
  }

  .matchup-grid,
  .output-grid {
    display: grid;
    gap: 12px;
  }

  .matchup-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .match-card {
    min-width: 0;
    display: grid;
    gap: 12px;
    border: 2px solid #171717;
    background:
      linear-gradient(90deg, var(--left) 0 8px, transparent 8px),
      linear-gradient(135deg, color-mix(in srgb, var(--left) 18%, #fffdf5), color-mix(in srgb, var(--right) 20%, #fffdf5));
    padding: 14px 14px 14px 22px;
  }

  .match-card__teams {
    display: grid;
    grid-template-columns: 54px 1fr auto 1fr 54px;
    gap: 8px;
    align-items: center;
  }

  .match-card img {
    width: 100%;
    image-rendering: pixelated;
    border: 2px solid #171717;
    background: #fffdf5;
  }

  .match-card strong {
    font-size: 1.3rem;
    line-height: 1;
  }

  .match-card__teams span {
    font-weight: 950;
  }

  .match-card p {
    color: #3f423c;
    line-height: 1.35;
  }

  .output-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .output-grid article {
    min-width: 0;
    display: grid;
    gap: 10px;
    border: 2px solid #171717;
    background: #fff;
    padding: 14px;
  }

  .output-grid textarea {
    width: 100%;
    min-height: 150px;
    border: 2px solid #171717;
    background: #fffdf5;
    color: #171717;
    padding: 12px;
    resize: vertical;
    font: 0.82rem/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .copy-status {
    margin-top: 14px;
    color: #3f423c;
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .hero,
    .matchup-grid,
    .output-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function readSlates() {
    try {
      return JSON.parse(document.querySelector('[data-slates]')?.getAttribute('data-slates') || '[]');
    } catch {
      return [];
    }
  }

  function setText(selector, text) {
    const node = document.querySelector(selector);
    if (node) node.textContent = text || '';
  }

  function renderSlate() {
    const slates = readSlates();
    const region = document.querySelector('[data-region-select]')?.value;
    const slate = slates.find((item) => item.region === region) || slates[0];
    if (!slate) return;
    const matchupSelect = document.querySelector('[data-matchup-select]');
    const currentMatchupId = matchupSelect?.value;
    if (matchupSelect) {
      matchupSelect.innerHTML = slate.matchups.map((matchup) => `<option value="${matchup.id}">${matchup.left.short} vs ${matchup.right.short}</option>`).join('');
      if (currentMatchupId && slate.matchups.some((matchup) => matchup.id === currentMatchupId)) matchupSelect.value = currentMatchupId;
    }
    const featured = slate.matchups.find((matchup) => matchup.id === matchupSelect?.value) || slate.featured;
    setText('[data-hero-region]', slate.region);
    setText('[data-hero-title]', slate.title);
    setText('[data-hero-headline]', featured.headline);
    const grid = document.querySelector('[data-matchup-grid]');
    if (grid) {
      grid.innerHTML = slate.matchups.map((matchup) => `
        <article class="match-card" style="--left:${matchup.left.colors[0]};--right:${matchup.right.colors[0]};" data-matchup-card="${matchup.id}">
          <div class="match-card__teams">
            <img src="/games/nouns-nation-battler/assets/noun-${matchup.left.nounSeed % 60}.svg" alt="" loading="lazy" />
            <strong>${matchup.left.short}</strong>
            <span>vs</span>
            <strong>${matchup.right.short}</strong>
            <img src="/games/nouns-nation-battler/assets/noun-${matchup.right.nounSeed % 60}.svg" alt="" loading="lazy" />
          </div>
          <h3>${matchup.left.team} vs ${matchup.right.team}</h3>
          <p>${matchup.headline}</p>
          <em>${matchup.fieldLine}</em>
        </article>
      `).join('');
    }
    const outputs = {
      host: slate.hostRundown,
      invite: featured.watchInvite,
      artifacts: slate.artifactBundle,
      sponsor: featured.sponsorRead,
      agent: slate.agentTask,
      proof: slate.proofChecklist.join('\n'),
    };
    for (const [key, value] of Object.entries(outputs)) {
      const output = document.querySelector(`[data-output="${key}"]`);
      if (output) output.value = value;
    }
    setText('[data-copy-status]', slate.guardrail);
  }

  async function copyOutput(key) {
    const output = document.querySelector(`[data-output="${key}"]`);
    const status = document.querySelector('[data-copy-status]');
    const text = output?.value || '';
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = `${key} copied.`;
    } catch {
      if (status) status.textContent = text;
    }
  }

  document.querySelector('[data-region-select]')?.addEventListener('change', renderSlate);
  document.querySelector('[data-matchup-select]')?.addEventListener('change', renderSlate);
  document.querySelectorAll('[data-copy-output]').forEach((button) => {
    button.addEventListener('click', () => copyOutput(button.getAttribute('data-copy-output') || 'host'));
  });
  renderSlate();
</script>
