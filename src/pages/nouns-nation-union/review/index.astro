---
/**
 * /nouns-nation-union/review - Creative Director review desk for Agency 50.
 */
import BlockLayout from '../../../layouts/BlockLayout.astro';
import {
  buildNounsStateAgencyPosterRun,
  buildNounsStateAgencyReviewDesk,
} from '../../../lib/nouns-state-league';

const agencyRun = buildNounsStateAgencyPosterRun();
const reviewDesk = buildNounsStateAgencyReviewDesk();
const reviewData = JSON.stringify({
  posters: agencyRun.posters,
  reviewLanes: agencyRun.reviewLanes,
  approvalChecklist: agencyRun.approvalChecklist,
  reviewDesk,
});
---

<BlockLayout
  title="Nouns Union Creative Director Review"
  description="Score Agency 50 state posters against actual Noun fidelity, state specificity, campaign system, broadcast utility, and sponsor-safe guardrails."
  image="/images/og/nouns-battler-live.png"
  alternates={[
    { type: 'application/json', href: '/nouns-nation-union.json', title: 'Nouns Union JSON' },
    { type: 'application/json', href: '/nouns-nation-battler-agents.json', title: 'Nouns Battler Agent Bench JSON' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Review Desk', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/review/' },
      { label: 'Artifact Studio', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/artifacts/' },
      { label: 'State Night', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/state-night/' },
      { label: 'JSON', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union.json' },
    ],
  }}
>
  <main class="review-desk" data-review-desk={reviewData}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-union/">Union League</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-union/artifacts/">Artifact Studio</a>
      <span aria-hidden="true">/</span>
      <span>Review Desk</span>
    </nav>

    <section class="hero" aria-labelledby="review-title">
      <div>
        <p class="kicker">AGENCY 50 / CREATIVE DIRECTOR REVIEW</p>
        <h1 id="review-title">Approve the actual Nouns before the campaign goes public.</h1>
        <p>
          Pick a state poster, score the five professional lanes, paste a generated-image reference,
          and copy an accept, remix, or reject receipt. The bar is simple: preserve the assigned actual
          Noun first, then make the state campaign feel undeniable.
        </p>
        <div class="hero-actions">
          <a class="primary" href="#scorecard">Start review</a>
          <a href="/nouns-nation-union/artifacts/#agency-50">Agency 50 prompts</a>
          <a href="/nouns-nation-union/state-night/">State Night</a>
          <a href="/nouns-nation-union.json">Union JSON</a>
        </div>
      </div>
      <aside class="hero-card">
        <span>Decision rule</span>
        <strong>{reviewDesk.scoreScale}</strong>
        <p>{reviewDesk.purpose}</p>
      </aside>
    </section>

    <section id="scorecard" class="scorecard" aria-labelledby="scorecard-title">
      <div class="panel control-panel">
        <p class="kicker">Scorecard</p>
        <h2 id="scorecard-title">Creative Director Desk</h2>
        <label>
          State poster
          <select data-review-select>
            {agencyRun.posters.map((poster) => (
              <option value={poster.id}>{poster.code} - {poster.posterTitle}</option>
            ))}
          </select>
        </label>
        <div class="selected-poster" data-selected-poster></div>
        <label>
          Generated image or file reference
          <input data-image-ref type="text" value="local review pending" />
        </label>
        <label>
          Reviewer note
          <textarea data-review-note>Actual Noun is present; needs final human visual check before routing.</textarea>
        </label>
        <label class="safety-check">
          <input data-safety-fail type="checkbox" />
          Legal or sponsor-safety failure found
        </label>
      </div>

      <div class="panel lane-panel">
        <p class="kicker">Five-lane review</p>
        <h2>Score the artifact</h2>
        <div class="lanes" data-review-lanes>
          {agencyRun.reviewLanes.map((lane, index) => (
            <article class="lane">
              <header>
                <strong>{lane.label}</strong>
                <output data-lane-output={index}>4</output>
              </header>
              <input data-lane-score={index} type="range" min="1" max="5" value="4" />
              <p>{lane.standard}</p>
              <em>Reject if: {lane.rejectIf}</em>
            </article>
          ))}
        </div>
      </div>

      <aside class="panel receipt-panel">
        <p class="kicker">Review receipt</p>
        <h2 data-decision-title>Remix Recommended</h2>
        <div class="meter" aria-label="Score">
          <span data-score-total>20</span>
          <small>/25</small>
        </div>
        <p data-routing-copy>{reviewDesk.defaultRouting.remix}</p>
        <textarea readonly data-review-receipt></textarea>
        <div class="receipt-actions">
          <button type="button" data-copy-receipt>Copy Review Receipt</button>
          <button type="button" data-copy-remix>Copy Remix Prompt</button>
        </div>
      </aside>
    </section>

    <section class="standards" aria-labelledby="standards-title">
      <div class="section-head">
        <p class="kicker">Professional standards</p>
        <h2 id="standards-title">What must be true before anything ships.</h2>
      </div>
      <div class="standard-grid">
        {reviewDesk.requiredEvidence.map((item) => (
          <article>
            <span>Evidence</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
      <div class="routing-grid">
        {reviewDesk.decisions.map((decision) => (
          <article>
            <strong>{decision}</strong>
            <p>{reviewDesk.defaultRouting[decision]}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    const root = document.querySelector('[data-review-desk]');
    const data = root ? JSON.parse(root.dataset.reviewDesk || '{}') : {};
    const posters = data.posters || [];
    const lanes = data.reviewLanes || [];
    const desk = data.reviewDesk || {};
    const select = document.querySelector('[data-review-select]');
    const selectedPoster = document.querySelector('[data-selected-poster]');
    const imageRef = document.querySelector('[data-image-ref]');
    const reviewNote = document.querySelector('[data-review-note]');
    const safetyFail = document.querySelector('[data-safety-fail]');
    const decisionTitle = document.querySelector('[data-decision-title]');
    const scoreTotal = document.querySelector('[data-score-total]');
    const routingCopy = document.querySelector('[data-routing-copy]');
    const receipt = document.querySelector('[data-review-receipt]');
    const copyReceipt = document.querySelector('[data-copy-receipt]');
    const copyRemix = document.querySelector('[data-copy-remix]');

    function getPoster() {
      return posters.find((poster) => poster.id === select?.value) || posters[0];
    }

    function getScores() {
      return lanes.map((lane, index) => {
        const input = document.querySelector(`[data-lane-score="${index}"]`);
        return {
          label: lane.label,
          score: Number(input?.value || 1),
        };
      });
    }

    function getDecision(total, hasSafetyFail) {
      if (hasSafetyFail || total < 15) {
        return 'reject';
      }
      if (total >= 22) {
        return 'accept';
      }
      return 'remix';
    }

    function titleForDecision(decision) {
      if (decision === 'accept') return 'Accept Recommended';
      if (decision === 'reject') return 'Reject Recommended';
      return 'Remix Recommended';
    }

    function renderSelectedPoster(poster) {
      if (!selectedPoster || !poster) return;
      selectedPoster.innerHTML = `
        <img src="/games/nouns-nation-battler/assets/noun-${poster.nounId % 60}.svg" alt="" />
        <div>
          <strong>${poster.team}</strong>
          <span>${poster.state} / ${poster.code} / Actual Noun #${poster.nounId}</span>
          <p>${poster.headline}</p>
        </div>
      `;
    }

    function buildReceipt(poster, scores, decision) {
      const total = scores.reduce((sum, lane) => sum + lane.score, 0);
      const weakest = [...scores].sort((a, b) => a.score - b.score)[0];
      return [
        'NOUNS UNION AGENCY 50 REVIEW RECEIPT',
        `Decision: ${decision.toUpperCase()}`,
        `Score: ${total}/25`,
        `State: ${poster.state} (${poster.code})`,
        `Team: ${poster.team}`,
        `Actual Noun: #${poster.nounId}`,
        `Generated image: ${imageRef?.value || 'not provided'}`,
        `Lane scores: ${scores.map((lane) => `${lane.label} ${lane.score}/5`).join(' / ')}`,
        `Weakest lane: ${weakest.label} ${weakest.score}/5`,
        `Reviewer note: ${reviewNote?.value || 'No note provided.'}`,
        `Routing: ${desk.defaultRouting?.[decision] || ''}`,
        'Guardrail: fictional Nouns sports creative only; no official sports marks, betting claims, checkout, payout, or implied official relationship.',
      ].join('\n');
    }

    function buildRemixPrompt(poster, scores) {
      const weakest = [...scores].sort((a, b) => a.score - b.score)[0];
      const lane = lanes.find((item) => item.label === weakest.label);
      return [
        `Remix the ${poster.posterTitle} for ${poster.team}.`,
        `Keep actual Noun #${poster.nounId} from ${poster.nounReference}`,
        `Fix weakest review lane: ${weakest.label}. Standard: ${lane?.standard || 'Improve professional quality.'}`,
        `State motif to strengthen: ${poster.prompt.match(/State identity: ([^.]+)\./)?.[1] || poster.state}.`,
        'Preserve the campaign line "Fifty States. Fifty Nouns. One Union Night."',
        'No official sports marks, school marks, betting language, checkout language, payout language, or official relationship claims.',
      ].join(' ');
    }

    function update() {
      const poster = getPoster();
      const scores = getScores();
      const total = scores.reduce((sum, lane) => sum + lane.score, 0);
      const decision = getDecision(total, Boolean(safetyFail?.checked));
      scores.forEach((lane, index) => {
        const output = document.querySelector(`[data-lane-output="${index}"]`);
        if (output) output.textContent = String(lane.score);
      });
      renderSelectedPoster(poster);
      if (decisionTitle) decisionTitle.textContent = titleForDecision(decision);
      if (scoreTotal) scoreTotal.textContent = String(total);
      if (routingCopy) routingCopy.textContent = desk.defaultRouting?.[decision] || '';
      if (receipt) receipt.value = buildReceipt(poster, scores, decision);
    }

    document.querySelectorAll('[data-lane-score], [data-review-select], [data-image-ref], [data-review-note], [data-safety-fail]').forEach((element) => {
      element.addEventListener('input', update);
      element.addEventListener('change', update);
    });
    copyReceipt?.addEventListener('click', () => navigator.clipboard?.writeText(receipt?.value || ''));
    copyRemix?.addEventListener('click', () => navigator.clipboard?.writeText(buildRemixPrompt(getPoster(), getScores())));
    update();
  </script>
</BlockLayout>

<style>
  .review-desk {
    background: #f7f4ee;
    color: #161514;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-height: 100vh;
    padding: 24px;
  }

  .crumb,
  .hero-actions,
  .receipt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .crumb {
    font-size: 0.8rem;
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  a,
  button {
    color: inherit;
  }

  .hero,
  .scorecard,
  .standards {
    margin: 0 auto;
    max-width: 1180px;
  }

  .hero {
    align-items: stretch;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.8fr);
    margin-bottom: 22px;
  }

  .hero > div,
  .hero-card,
  .panel,
  .standards {
    background: #fffdf8;
    border: 1px solid #24211d;
    box-shadow: 6px 6px 0 #24211d;
  }

  .hero > div,
  .hero-card,
  .panel,
  .standards {
    padding: 22px;
  }

  .kicker,
  .hero-card span,
  .standard-grid span {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    letter-spacing: 0;
    line-height: 1;
    margin: 8px 0 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 6rem);
    max-width: 860px;
  }

  .hero p,
  .panel p,
  .standards p {
    color: #4c4740;
    line-height: 1.5;
  }

  .hero-actions a,
  .receipt-actions button,
  .manus-console__actions button {
    border: 1px solid #24211d;
    padding: 10px 12px;
    text-decoration: none;
  }

  .hero-actions .primary,
  button {
    background: #24211d;
    color: #fffdf8;
  }

  .scorecard {
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(260px, 0.85fr) minmax(320px, 1.35fr) minmax(280px, 0.8fr);
    margin-bottom: 24px;
  }

  label {
    display: grid;
    font-size: 0.78rem;
    font-weight: 800;
    gap: 8px;
    margin-top: 14px;
    text-transform: uppercase;
  }

  input,
  select,
  textarea {
    background: #f7f4ee;
    border: 1px solid #24211d;
    color: #161514;
    font: inherit;
    padding: 10px;
  }

  textarea {
    min-height: 110px;
    resize: vertical;
  }

  .selected-poster {
    align-items: center;
    background: #f0e7d8;
    border: 1px solid #24211d;
    display: grid;
    gap: 12px;
    grid-template-columns: 72px 1fr;
    margin-top: 14px;
    padding: 12px;
  }

  .selected-poster img {
    image-rendering: pixelated;
    width: 72px;
  }

  .selected-poster span {
    display: block;
    font-size: 0.82rem;
    margin-top: 4px;
  }

  .safety-check {
    align-items: center;
    display: flex;
    gap: 10px;
  }

  .lane {
    border-top: 1px solid #24211d;
    padding: 14px 0;
  }

  .lane header {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .lane output {
    background: #24211d;
    color: #fffdf8;
    min-width: 34px;
    padding: 5px 8px;
    text-align: center;
  }

  .lane input {
    width: 100%;
  }

  .lane em {
    color: #7c2d12;
    display: block;
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .meter {
    align-items: baseline;
    border-bottom: 1px solid #24211d;
    border-top: 1px solid #24211d;
    display: flex;
    gap: 8px;
    margin: 12px 0;
    padding: 14px 0;
  }

  .meter span {
    font-size: 4rem;
    font-weight: 900;
    line-height: 0.9;
  }

  .receipt-panel textarea {
    min-height: 310px;
    width: 100%;
  }

  .standards {
    margin-bottom: 24px;
  }

  .standard-grid,
  .routing-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 16px;
  }

  .standard-grid article,
  .routing-grid article {
    background: #f7f4ee;
    border: 1px solid #24211d;
    padding: 14px;
  }

  .routing-grid strong {
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .hero,
    .scorecard,
    .standard-grid,
    .routing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .review-desk {
      padding: 14px;
    }

    h1 {
      font-size: 2.7rem;
    }

    .hero > div,
    .hero-card,
    .panel,
    .standards {
      box-shadow: 4px 4px 0 #24211d;
      padding: 16px;
    }
  }
</style>
