---
/**
 * /nouns-nation-union/artifacts - generated-artifact prompt desk for Union League teams.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  NOUNS_STATE_ARTIFACT_KINDS,
  NOUNS_STATE_FOUNDING_DROPS,
  NOUNS_STATE_LEAGUE_TEAMS,
  buildNounsStateCampaignPack,
  buildNounsStateDropGallery,
  buildNounsStateAgencyPosterRun,
  buildNounsStateManusArtifactRun,
  buildNounsStateArtifactPack,
  buildNounsStateArtifactPrompt,
} from '../../lib/nouns-state-league';

const featuredCodes = ['CA', 'NY', 'TX', 'LA', 'AK', 'WV', 'FL', 'WA'];
const featuredTeams = featuredCodes
  .map((code) => NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === code))
  .filter((team) => Boolean(team));
const defaultTeam = NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'CA') ?? NOUNS_STATE_LEAGUE_TEAMS[0];
const defaultPrompt = buildNounsStateArtifactPrompt(defaultTeam, 'hero-poster');
const promptPacks = NOUNS_STATE_LEAGUE_TEAMS.map((team) => buildNounsStateArtifactPack(team));
const promptPackJson = JSON.stringify(promptPacks);
const manusRun = buildNounsStateManusArtifactRun();
const agencyRun = buildNounsStateAgencyPosterRun();
const foundingDropCards = NOUNS_STATE_FOUNDING_DROPS.map((drop) => {
  const team = NOUNS_STATE_LEAGUE_TEAMS.find((item) => item.code === drop.code) ?? defaultTeam;
  return {
    ...drop,
    team,
    campaignPack: buildNounsStateCampaignPack(team, drop),
    gallery: buildNounsStateDropGallery(team, drop),
    posterPrompt: buildNounsStateArtifactPrompt(team, 'hero-poster'),
    productPrompt: buildNounsStateArtifactPrompt(team, 'product-drop'),
  };
});
---

<BlockLayout
  title="Nouns Nation Union Artifact Studio"
  description="Copy-ready ChatGPT image-generation prompts for every state team in the Nouns Nation Union League: posters, ads, product drops, broadcast cards, fan ritual art, and agent briefs."
  image="/images/og/nouns-battler-live.png"
  alternates={[
    { type: 'application/json', href: '/nouns-nation-union.json', title: 'Nouns Nation Union League JSON' },
    { type: 'application/json', href: '/nouns-nation-battler-agents.json', title: 'Nouns Battler Agent Bench JSON' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Artifact Studio', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/artifacts/' },
      { label: 'Union League', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/' },
      { label: 'Agent Bench', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-agents/' },
      { label: 'JSON', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union.json' },
    ],
  }}
>
  <main class="studio" data-prompt-packs={promptPackJson}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-union/">Union League</a>
      <span aria-hidden="true">/</span>
      <span>Artifact Studio</span>
    </nav>

    <section class="hero" aria-labelledby="studio-title">
      <div class="hero__copy">
        <p class="kicker">IMAGE DESK / UNION ARTIFACT STUDIO</p>
        <h1 id="studio-title">Generate state-team artifacts with ChatGPT image prompts.</h1>
        <p>
          Pick a state, pick an output, and copy a prompt built from its Nouns team kit. The studio is made for
          posters, watch ads, product concepts, broadcast cards, ritual art, and agent task briefs.
        </p>
        <div class="hero-actions">
          <a class="primary" href="#builder">Build a prompt</a>
          <a href="#founding-drop">Founding drop</a>
          <a href="#drop-gallery">Drop gallery</a>
          <a href="#manus-50">Manus 50</a>
          <a href="#agency-50">Agency 50</a>
          <a href="/nouns-nation-union/">Union atlas</a>
          <a href="/nouns-nation-battler-agents/">Agent bench</a>
        </div>
      </div>
      <aside class="hero-card">
        <span>Default card</span>
        <strong>{defaultTeam.team}</strong>
        <p>{defaultPrompt}</p>
      </aside>
    </section>

    <section id="founding-drop" class="drop" aria-labelledby="drop-title">
      <div class="section-head">
        <p class="kicker">Founding Artifact Drop</p>
        <h2 id="drop-title">Eight state campaigns ready for image generation.</h2>
        <p>
          These are launch-ready creative packs for the first Union League artifact wave. Each card has a
          campaign receipt, poster prompt, product direction, sponsor read, watch hook, and agent task.
        </p>
      </div>
      <div class="drop-grid">
        {foundingDropCards.map((card, index) => (
          <article class="drop-card" style={`--team-a:${card.team.colors[0]};--team-b:${card.team.colors[1]};`}>
            <div class="mini-poster" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <img src={`/games/nouns-nation-battler/assets/noun-${card.team.nounSeed % 60}.svg`} alt="" loading="lazy" />
              <strong>{card.team.short}</strong>
            </div>
            <div class="drop-card__copy">
              <span>{card.team.state} / {card.team.team}</span>
              <h3>{card.dropName}</h3>
              <p>{card.capsule}</p>
              <dl>
                <div><dt>Headline</dt><dd>{card.headline}</dd></div>
                <div><dt>Products</dt><dd>{card.products.join(' / ')}</dd></div>
                <div><dt>Watch</dt><dd>{card.watchHook}</dd></div>
              </dl>
              <textarea readonly>{card.campaignPack}</textarea>
              <button type="button" data-copy-text={card.campaignPack}>Copy Campaign Pack</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="drop-gallery" class="gallery" aria-labelledby="gallery-title">
      <div class="section-head">
        <p class="kicker">Drop Gallery / Review Room</p>
        <h2 id="gallery-title">Turn the founding packs into reviewed artifacts.</h2>
        <p>
          Each campaign now has a small production board: one asset to generate, one sponsor candidate, one
          broadcast still to ship, and one remix lane for agents or humans to improve before publishing.
        </p>
      </div>
      <div class="gallery-grid">
        {foundingDropCards.map((card) => (
          <article class="gallery-card" style={`--team-a:${card.team.colors[0]};--team-b:${card.team.colors[1]};`}>
            <header>
              <span>{card.team.state} / {card.team.short}</span>
              <h3>{card.dropName}</h3>
              <p>{card.headline}</p>
            </header>
            <div class="slot-grid">
              {card.gallery.slots.map((slot) => (
                <div class={`slot slot--${slot.status}`}>
                  <span>{slot.status.replaceAll('-', ' ')}</span>
                  <strong>{slot.label}</strong>
                  <small>{slot.format}</small>
                  <p>{slot.nextAction}</p>
                  <em>Proof: {slot.proof}</em>
                </div>
              ))}
            </div>
            <button type="button" data-copy-text={card.gallery.receipt}>Copy Gallery Receipt</button>
          </article>
        ))}
      </div>
    </section>

    <section id="agency-50" class="agency" aria-labelledby="agency-title">
      <div class="section-head">
        <p class="kicker">Agency 50 / Poster Campaign</p>
        <h2 id="agency-title">Fifty state posters with top LA/NY agency energy.</h2>
        <p>
          A full advertising campaign brief for Manus, ChatGPT image generation, Nano Banana, or another top
          image model: one premium poster per state team, all under one campaign line.
        </p>
      </div>
      <div class="manus-console agency-console">
        <div>
          <span>Campaign line</span>
          <strong>{agencyRun.campaignLine}</strong>
          <p>{agencyRun.modelLane}</p>
        </div>
        <textarea readonly>{agencyRun.receipt}</textarea>
        <div class="manus-console__actions">
          <button type="button" data-copy-text={agencyRun.receipt}>Copy Agency 50 Batch</button>
          <button type="button" data-copy-text={agencyRun.productionBrief}>Copy CD Brief</button>
          <a href="/nouns-nation-union/state-night/">Launch State Night</a>
        </div>
      </div>
      <div class="director-board" aria-label="Creative Director Review Board">
        <article class="director-brief">
          <span>Creative Director Board</span>
          <h3>Professional acceptance starts here.</h3>
          <p>
            Run the first review pass like a real campaign desk: actual Noun fidelity first, state specificity second,
            then campaign system, broadcast utility, and legal/sponsor safety.
          </p>
          <textarea readonly>{agencyRun.productionBrief}</textarea>
          <button type="button" data-copy-text={agencyRun.productionBrief}>Copy Review Brief</button>
        </article>
        <article class="review-lanes">
          <span>Acceptance Criteria</span>
          <div class="review-lane-grid">
            {agencyRun.reviewLanes.map((lane) => (
              <section>
                <h4>{lane.label}</h4>
                <p>{lane.standard}</p>
                <em>Reject if: {lane.rejectIf}</em>
              </section>
            ))}
          </div>
        </article>
        <article class="priority-run">
          <span>Priority Review Set</span>
          <h3>Approve these twelve first.</h3>
          <div class="priority-strip">
            {agencyRun.priorityPosters.map((poster) => (
              <div class="priority-chip">
                <img src={`/games/nouns-nation-battler/assets/noun-${poster.nounId % 60}.svg`} alt="" loading="lazy" />
                <strong>{poster.code}</strong>
                <small>Noun #{poster.nounId}</small>
              </div>
            ))}
          </div>
        </article>
        <article class="approval-card">
          <span>Approval Checklist</span>
          <ul>
            {agencyRun.approvalChecklist.map((item) => <li>{item}</li>)}
          </ul>
          <button type="button" data-copy-text={agencyRun.approvalChecklist.join('\n')}>Copy Approval Checklist</button>
        </article>
      </div>
      <div class="artifact-run-grid agency-grid">
        {agencyRun.posters.map((poster, index) => (
          <article class="run-card agency-card" style={`--team-a:${NOUNS_STATE_LEAGUE_TEAMS[index].colors[0]};--team-b:${NOUNS_STATE_LEAGUE_TEAMS[index].colors[1]};`}>
            <div class="run-card__badge">
              <img src={`/games/nouns-nation-battler/assets/noun-${NOUNS_STATE_LEAGUE_TEAMS[index].nounSeed % 60}.svg`} alt="" loading="lazy" />
              <span>{poster.code}</span>
            </div>
            <div class="run-card__body">
              <span>{poster.agencyLane}</span>
              <h3>{poster.posterTitle}</h3>
              <p>{poster.headline}</p>
              <p class="noun-ref">Actual Noun #{poster.nounId}</p>
              <dl>
                <div><dt>Format</dt><dd>{poster.format}</dd></div>
                <div><dt>Media</dt><dd>{poster.mediaPlan.join(', ')}</dd></div>
                <div><dt>Proof</dt><dd>{poster.proof}</dd></div>
              </dl>
              <textarea readonly>{poster.prompt}</textarea>
              <button type="button" data-copy-text={poster.prompt}>Copy Poster Prompt</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="manus-50" class="manus" aria-labelledby="manus-title">
      <div class="section-head">
        <p class="kicker">Manus 50 / Model Relay</p>
        <h2 id="manus-title">One artifact brief for every state team.</h2>
        <p>
          A coordinated run for Manus, ChatGPT, Nano Banana, or any top image model: generate one strong artifact
          per state, review it, remix the weak ones, then publish only accepted work with proof.
        </p>
      </div>
      <div class="manus-console">
        <div>
          <span>Batch size</span>
          <strong>{manusRun.count} state artifacts</strong>
          <p>{manusRun.modelLane}</p>
        </div>
        <textarea readonly>{manusRun.receipt}</textarea>
        <div class="manus-console__actions">
          <button type="button" data-copy-text={manusRun.receipt}>Copy Manus 50 Batch</button>
          <a href="/goal?preset=nouns-union-manus-50#setup">Set Manus 50 /goal</a>
        </div>
      </div>
      <div class="artifact-run-grid">
        {manusRun.artifacts.map((artifact, index) => (
          <article class="run-card" style={`--team-a:${NOUNS_STATE_LEAGUE_TEAMS[index].colors[0]};--team-b:${NOUNS_STATE_LEAGUE_TEAMS[index].colors[1]};`}>
            <div class="run-card__badge">
              <img src={`/games/nouns-nation-battler/assets/noun-${NOUNS_STATE_LEAGUE_TEAMS[index].nounSeed % 60}.svg`} alt="" loading="lazy" />
              <span>{artifact.code}</span>
            </div>
            <div class="run-card__body">
              <span>{artifact.state} / {artifact.short}</span>
              <h3>{artifact.title}</h3>
              <p>{artifact.team}</p>
              <dl>
                <div><dt>Format</dt><dd>{artifact.format}</dd></div>
                <div><dt>Review</dt><dd>{artifact.review}</dd></div>
                <div><dt>Proof</dt><dd>{artifact.proof}</dd></div>
              </dl>
              <textarea readonly>{artifact.prompt}</textarea>
              <button type="button" data-copy-text={artifact.prompt}>Copy Model Prompt</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="builder" class="builder" aria-labelledby="builder-title">
      <div class="section-head">
        <p class="kicker">Prompt Builder</p>
        <h2 id="builder-title">Copy one state-team artifact brief.</h2>
      </div>
      <div class="control-row">
        <label>
          <span>State team</span>
          <select data-team-select>
            {NOUNS_STATE_LEAGUE_TEAMS.map((team) => (
              <option value={team.code} selected={team.code === defaultTeam.code}>
                {team.state} / {team.team}
              </option>
            ))}
          </select>
        </label>
        <label>
          <span>Artifact</span>
          <select data-kind-select>
            {NOUNS_STATE_ARTIFACT_KINDS.map((kind) => (
              <option value={kind.id}>{kind.label}</option>
            ))}
          </select>
        </label>
      </div>
      <article class="prompt-card" style={`--team-a:${defaultTeam.colors[0]};--team-b:${defaultTeam.colors[1]};`}>
        <div class="prompt-card__top">
          <img data-preview-noun src={`/games/nouns-nation-battler/assets/noun-${defaultTeam.nounSeed % 60}.svg`} alt="" loading="eager" />
          <div>
            <span data-preview-meta>{defaultTeam.state} / {defaultTeam.short}</span>
            <strong data-preview-team>{defaultTeam.team}</strong>
            <em data-preview-field>{defaultTeam.field} · {defaultTeam.signatureMove}</em>
          </div>
        </div>
        <textarea data-prompt-output readonly>{defaultPrompt}</textarea>
        <div class="prompt-actions">
          <button type="button" data-copy-prompt>Copy Image Prompt</button>
          <button type="button" data-copy-pack>Copy Full State Pack</button>
        </div>
        <p class="guardrail" data-copy-status>
          Use original Nouns-style art direction. Do not use official team marks, real league logos, or imply an official sports relationship.
        </p>
      </article>
    </section>

    <section class="kinds" aria-labelledby="kinds-title">
      <div class="section-head">
        <p class="kicker">Artifact Menu</p>
        <h2 id="kinds-title">Six useful outputs per state.</h2>
      </div>
      <div class="kind-grid">
        {NOUNS_STATE_ARTIFACT_KINDS.map((kind) => (
          <article>
            <span>{kind.label}</span>
            <strong>{kind.format}</strong>
            <p>{kind.use}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="featured" aria-labelledby="featured-art-title">
      <div class="section-head">
        <p class="kicker">Featured Packs</p>
        <h2 id="featured-art-title">Fast starts for the loudest state kits.</h2>
      </div>
      <div class="featured-grid">
        {featuredTeams.map((team) => (
          <article style={`--team-a:${team.colors[0]};--team-b:${team.colors[1]};`}>
            <img src={`/games/nouns-nation-battler/assets/noun-${team.nounSeed % 60}.svg`} alt="" loading="lazy" />
            <div>
              <span>{team.state} / {team.short}</span>
              <strong>{team.team}</strong>
              <p>{team.motif}</p>
              <code>{team.signatureMove}</code>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    const root = document.querySelector('.studio');
    const packs = JSON.parse(root?.getAttribute('data-prompt-packs') || '[]');
    const teamSelect = document.querySelector('[data-team-select]');
    const kindSelect = document.querySelector('[data-kind-select]');
    const promptOutput = document.querySelector('[data-prompt-output]');
    const promptCard = document.querySelector('.prompt-card');
    const previewNoun = document.querySelector('[data-preview-noun]');
    const previewMeta = document.querySelector('[data-preview-meta]');
    const previewTeam = document.querySelector('[data-preview-team]');
    const previewField = document.querySelector('[data-preview-field]');
    const copyStatus = document.querySelector('[data-copy-status]');

    function activePack() {
      return packs.find((pack) => pack.code === teamSelect?.value) || packs[0];
    }

    function activePrompt() {
      const pack = activePack();
      return pack.prompts.find((prompt) => prompt.id === kindSelect?.value) || pack.prompts[0];
    }

    function renderPrompt() {
      const pack = activePack();
      const prompt = activePrompt();
      if (!pack || !prompt) return;
      promptCard?.style.setProperty('--team-a', pack.colors[0]);
      promptCard?.style.setProperty('--team-b', pack.colors[1]);
      if (previewNoun) previewNoun.src = `/games/nouns-nation-battler/assets/noun-${pack.nounSeed % 60}.svg`;
      if (previewMeta) previewMeta.textContent = `${pack.state} / ${pack.short}`;
      if (previewTeam) previewTeam.textContent = pack.team;
      if (previewField) previewField.textContent = `${pack.field} · ${pack.signatureMove}`;
      if (promptOutput) promptOutput.value = prompt.prompt;
      if (copyStatus) copyStatus.textContent = 'Use original Nouns-style art direction. Do not use official team marks, real league logos, or imply an official sports relationship.';
    }

    async function copyText(text, label) {
      await navigator.clipboard.writeText(text);
      if (copyStatus) copyStatus.textContent = `${label} copied.`;
    }

    teamSelect?.addEventListener('change', renderPrompt);
    kindSelect?.addEventListener('change', renderPrompt);
    document.querySelector('[data-copy-prompt]')?.addEventListener('click', () => copyText(promptOutput?.value || '', 'Image prompt'));
    document.querySelector('[data-copy-pack]')?.addEventListener('click', () => copyText(JSON.stringify(activePack(), null, 2), 'State artifact pack'));
    document.querySelectorAll('[data-copy-text]').forEach((button) => {
      button.addEventListener('click', () => copyText(button.getAttribute('data-copy-text') || '', 'Campaign pack'));
    });
  </script>

  <style>
    .studio {
      display: grid;
      gap: 28px;
      color: #161616;
    }

    .crumb,
    .hero-actions,
    .prompt-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .crumb {
      color: #61645c;
      font-size: 0.85rem;
      font-weight: 800;
    }

    a {
      color: inherit;
    }

    .hero {
      min-height: min(680px, calc(100vh - 120px));
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
      gap: 24px;
      align-items: stretch;
    }

    .hero__copy,
    .hero-card,
    .builder,
    .drop,
    .gallery,
    .manus,
    .kinds,
    .featured {
      border: 2px solid #171717;
      background: #fffdf5;
      box-shadow: 6px 6px 0 #171717;
    }

    .hero__copy {
      padding: clamp(24px, 5vw, 64px);
      display: grid;
      align-content: center;
      gap: 18px;
      background:
        linear-gradient(135deg, rgba(246, 189, 22, 0.22), transparent 34%),
        linear-gradient(315deg, rgba(0, 166, 166, 0.18), transparent 38%),
        #fffdf5;
    }

    .kicker {
      margin: 0;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 900;
    }

    h1,
    h2,
    p {
      margin: 0;
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(3.2rem, 8vw, 7.2rem);
      line-height: 0.9;
      letter-spacing: 0;
    }

    h2 {
      font-size: clamp(1.8rem, 4vw, 3.5rem);
      line-height: 0.95;
      letter-spacing: 0;
    }

    .hero p,
    .section-head p,
    .hero-card p,
    .kind-grid p,
    .featured-grid p,
    .guardrail {
      color: #4f5149;
      line-height: 1.55;
      font-weight: 700;
    }

    .hero-actions a,
    .prompt-actions button {
      min-height: 44px;
      border: 2px solid #171717;
      background: #ffffff;
      padding: 10px 14px;
      font: inherit;
      font-weight: 900;
      text-decoration: none;
      box-shadow: 3px 3px 0 #171717;
      cursor: pointer;
    }

    .hero-actions .primary,
    .prompt-actions button:first-child {
      color: #fff;
      background: #171717;
    }

    .hero-card {
      padding: 24px;
      display: grid;
      align-content: end;
      gap: 14px;
      background:
        linear-gradient(135deg, #171717, #242424 55%, #fffdf5 55%);
      color: #fff;
    }

    .hero-card span,
    .hero-card strong {
      display: block;
    }

    .hero-card strong {
      max-width: 12ch;
      font-size: clamp(2rem, 5vw, 4.4rem);
      line-height: 0.92;
    }

    .hero-card p {
      color: #171717;
      background: #fffdf5;
      border: 2px solid #171717;
      padding: 14px;
      font-size: 0.95rem;
    }

    .builder,
    .drop,
    .gallery,
    .manus,
    .kinds,
    .featured {
      padding: clamp(20px, 4vw, 40px);
      display: grid;
      gap: 20px;
    }

    .section-head {
      display: grid;
      gap: 8px;
      max-width: 760px;
    }

    .control-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    label {
      display: grid;
      gap: 6px;
      font-weight: 900;
    }

    select {
      width: 100%;
      min-height: 48px;
      border: 2px solid #171717;
      background: #fff;
      padding: 0 12px;
      font: inherit;
      font-weight: 800;
    }

    .prompt-card {
      display: grid;
      gap: 16px;
      border: 2px solid #171717;
      padding: 18px;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--team-a), #fff 72%), transparent),
        linear-gradient(135deg, transparent 0 54%, color-mix(in srgb, var(--team-b), #fff 52%) 54%),
        #fff;
    }

    .prompt-card__top,
    .featured-grid article {
      display: flex;
      gap: 14px;
      align-items: center;
      min-width: 0;
    }

    .prompt-card__top img,
    .featured-grid img {
      width: 82px;
      height: 82px;
      object-fit: contain;
      border: 2px solid #171717;
      background: #fffdf5;
      flex: 0 0 auto;
    }

    .prompt-card__top div,
    .featured-grid div {
      min-width: 0;
