---
const releaseUrl = 'https://local-objects-tezos.mhoydich.chatgpt.site/commons';
const canonicalUrl = 'https://pointcast.xyz/local-star-commons';
const jsonUrl = 'https://pointcast.xyz/local-star-commons.json';
const pingUrl = 'https://pointcast.xyz/digital-pets/ping';
const title = 'LOCAL STAR COMMONS — Useful Things, Governed in Common';
const description =
  'Six local-first quality-of-life objects, five working circles, and three founding proposals for a contribution-governed El Segundo commons.';
const shareImage = 'https://local-objects-tezos.mhoydich.chatgpt.site/commons-og.png';
const shareCopy =
  `LOCAL STAR COMMONS: six useful local-first objects, governed in common. A 25-mile El Segundo founding prototype with no token or treasury. ${canonicalUrl}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href={jsonUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <style is:global>
      :root {
        --ink: #10100f;
        --paper: #f0eadc;
        --acid: #d8ff4f;
        --blue: #6da8ff;
        --orange: #ff6f3c;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; overflow: hidden; background: var(--ink); color: var(--paper); }
      body { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .commons-frame { height: 100svh; display: grid; grid-template-rows: auto auto minmax(0, 1fr); overflow: hidden; }
      .commons-rail {
        min-height: 3.5rem;
        padding: .55rem .8rem;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid rgba(240, 234, 220, .48);
        background: var(--ink);
        font-size: .62rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .commons-rail a { color: inherit; font-weight: 900; text-underline-offset: 3px; }
      .commons-rail__mark { display: flex; align-items: center; gap: .52rem; min-width: 0; }
      .commons-rail__star {
        display: grid;
        width: 1.05rem;
        height: 1.05rem;
        place-items: center;
        flex: 0 0 auto;
        background: var(--acid);
        color: var(--ink);
        font: 900 .72rem/1 Arial, sans-serif;
        transform: rotate(10deg);
      }
      .commons-rail__json { color: var(--blue) !important; }
      .commons-rail__direct {
        padding: .42rem .58rem;
        border: 1px solid var(--acid);
        background: var(--acid);
        color: var(--ink) !important;
        text-decoration: none;
      }
      .commons-status {
        padding: .62rem .8rem;
        display: grid;
        grid-template-columns: auto minmax(14rem, 1fr) auto;
        align-items: center;
        gap: .7rem 1rem;
        border-bottom: 1px solid var(--ink);
        background: var(--orange);
        color: var(--ink);
      }
      .commons-status strong { font: 900 1.45rem/1 Arial, sans-serif; letter-spacing: -.05em; }
      .commons-status p { margin: 0; font-size: .62rem; line-height: 1.4; }
      .commons-status__actions { display: flex; gap: .35rem; }
      .commons-status__actions a,
      .commons-status__actions button {
        appearance: none;
        padding: .43rem .55rem;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: var(--ink);
        color: var(--paper);
        cursor: pointer;
        font: 900 .58rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        text-decoration: none;
        text-transform: uppercase;
      }
      .commons-stage { position: relative; min-height: 0; background: var(--ink); }
      .commons-stage iframe { display: block; width: 100%; height: 100%; min-height: 0; border: 0; background: var(--ink); }
      .commons-stage__fallback {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: .55rem .65rem;
        border: 1px solid var(--acid);
        background: var(--ink);
        color: var(--acid);
        font-size: .6rem;
      }
      @media (max-width: 46rem) {
        .commons-rail { grid-template-columns: 1fr auto; }
        .commons-rail__json { display: none; }
        .commons-status { grid-template-columns: 1fr; }
        .commons-status__actions a, .commons-status__actions button { flex: 1; }
        .commons-stage { min-height: 0; }
        .commons-stage iframe { height: 100%; min-height: 0; }
        .commons-stage__fallback { display: none; }
      }
    </style>
  </head>
  <body>
    <main class="commons-frame">
      <nav class="commons-rail" aria-label="PointCast LOCAL STAR COMMONS navigation">
        <span class="commons-rail__mark"><span class="commons-rail__star" aria-hidden="true">✦</span><a href="/">PointCast</a> / LOCAL STAR COMMONS / Founding release</span>
        <a class="commons-rail__json" href="/local-star-commons.json">Machine release</a>
        <a class="commons-rail__direct" href={releaseUrl} target="_blank" rel="noopener">Open regular site ↗</a>
      </nav>
      <aside class="commons-status" aria-label="LOCAL STAR COMMONS release facts">
        <strong>6 OBJECTS · 5 CIRCLES · 3 PROPOSALS</strong>
        <p>Founding governance prototype. Off-chain coordination only: no token, treasury, fundraising, binding shared vote, or Mainnet action. Site signals remain on this device.</p>
        <div class="commons-status__actions">
          <button type="button" data-share-commons>Transmit</button>
          <a href={pingUrl}>Build PING</a>
          <a href="/b/0490">Read Block 0490</a>
        </div>
      </aside>
      <section class="commons-stage" aria-label="LOCAL STAR COMMONS interactive site">
        <iframe
          src={releaseUrl}
          title="LOCAL STAR COMMONS — six products and a contribution-governed founding movement"
          allow="clipboard-write; web-share"
          loading="eager"
        ></iframe>
        <a class="commons-stage__fallback" href={releaseUrl} target="_blank" rel="noopener">Open the regular site ↗</a>
      </section>
    </main>
    <script define:vars={{ shareCopy, canonicalUrl }}>
      document.querySelector('[data-share-commons]')?.addEventListener('click', () => {
        if (typeof navigator.share === 'function') {
          void navigator.share({ title: 'LOCAL STAR COMMONS', text: shareCopy, url: canonicalUrl }).catch(() => {});
          return;
        }
        void navigator.clipboard.writeText(shareCopy);
      });
    </script>
  </body>
</html>
