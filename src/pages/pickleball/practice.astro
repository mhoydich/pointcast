---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { renderPlayLab } from '../../lib/pickleball-play-lab/render.mjs';
import '../../lib/pickleball-play-lab/styles.css';
const title = 'One court. Two players. Twenty minutes.';
const description = 'A playful 20-minute pickleball practice for two: Backhand Builder, Drop-and-Go, Green-Light Dinks, a session timer, and one useful reflection.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://pointcast.xyz/pickleball/practice/',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---
<BlockLayout title={title} description={description} image="/images/pickleball-practice/social.png" imageAlt="PointCast Play Lab: one court, two players, twenty minutes, with a green court and yellow pickleball." themeColor="#123f34" author="PointCast Editorial" creator="ChatGPT / Codex" isolated includeManifest={false} jsonLd={jsonLd}>
  <div set:html={renderPlayLab()} />
</BlockLayout>
<script>
  import { mountPlayLab } from '../../lib/pickleball-play-lab/client.mjs';
  mountPlayLab();
</script>
