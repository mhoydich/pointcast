---
import BlockLayout from '../../layouts/BlockLayout.astro';
import league from '../../data/squeeze-league.json';

const title = 'The Squeeze · PTL Mixed 4.0';
const description = league.dek;
const ours = league.team.name;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': league.url,
  name: title,
  description,
  url: league.url,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  about: {
    '@type': 'SportsTeam',
    name: ours,
    sport: 'Pickleball',
    member: league.roster.map((player) => ({
      '@type': 'Person',
      name: player.name,
    })),
  },
};
---

<BlockLayout
  title={title}
  description={description}
  themeColor="#3B6D11"
  hideAds
  showNetworkStrip={false}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/pickleball/the-squeeze.json', title: 'The Squeeze league desk (JSON)' }]}
>
  <article class="sq">
    <nav class="sq-nav" aria-label="Room">
      <a href="/">← PointCast</a>
      <span>
        <a href="/pickleball">Pickleball Board</a>
        <a href="/pickleball/home">Pickleball Home</a>
        <a href="/c/court">Court</a>
        <a href={`/b/${league.block}`}>№{league.block}</a>
        <a href="/pickleball/the-squeeze.json">JSON</a>
      </span>
    </nav>

    <header class="sq-hero">
      <p class="sq-kicker">El Segundo · {league.league.code} · {league.league.division} · {league.league.season}</p>
      <div class="sq-hero-row">
        <div>
          <h1>{league.team.name}</h1>
          <p class="sq-court">{league.homeCourt}</p>
          <p class="sq-dek">{description}</p>
        </div>
        <dl class="sq-marks">
          <div>
            <dt>Team ranking</dt>
            <dd>{league.team.rankDisplay}</dd>
          </div>
          <div>
            <dt>Team DUPR</dt>
            <dd>{league.team.duprDisplay}</dd>
          </div>
          <div>
            <dt>Matchups played</dt>
            <dd>{league.team.matchupsPlayed}</dd>
          </div>
        </dl>
      </div>
    </header>

    <p class="sq-banner">
      Transcribed from {league.league.name} ({league.league.code}) screenshots dated about October 6, 2026.
      This is a PointCast desk, not an official PTL page. PTL is the source. No affiliate links. Nothing here is for sale.
    </p>

    <section class="sq-block" aria-labelledby="sq-roster">
      <div class="sq-head">
        <h2 id="sq-roster">Roster</h2>
        <p>{league.rosterNote}</p>
      </div>
      <ul class="sq-roster">
        {league.roster.map((player) => (
          <li>
            <strong>{player.name}</strong>
            <span>{player.role}{'relation' in player && player.relation ? ` · ${player.relation}` : ''}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sq-block" aria-labelledby="sq-stats">
      <div class="sq-head">
        <h2 id="sq-stats">Season stats</h2>
        <p>{league.stats.season}. Printed from the transcription. Not recomputed on this page.</p>
      </div>
      <div class="sq-stats">
        <div class="sq-stat sq-stat-wide">
          <p class="sq-stat-kicker">Points</p>
          <p class="sq-stat-big">{league.stats.points.earned}</p>
          <dl>
            <div><dt>Earned</dt><dd>{league.stats.points.earned}</dd></div>
            <div><dt>Allowed</dt><dd>{league.stats.points.allowed}</dd></div>
            <div><dt>Diff</dt><dd>{league.stats.points.diffDisplay}</dd></div>
            <div><dt>PD%</dt><dd>{league.stats.points.pdPercentDisplay}</dd></div>
          </dl>
        </div>
        <div class="sq-stat">
          <p class="sq-stat-kicker">Matchups</p>
          <p class="sq-stat-line">{league.stats.matchups.wins.total}–{league.stats.matchups.losses.total}</p>
          <p>Wins {league.stats.matchups.wins.regular} regular, {league.stats.matchups.wins.tiebreak} tiebreak.</p>
          <p>Losses {league.stats.matchups.losses.regular} regular, {league.stats.matchups.losses.tiebreak} tiebreak.</p>
        </div>
        <div class="sq-stat">
          <p class="sq-stat-kicker">Matches</p>
          <p class="sq-stat-line">{league.stats.matches.wins}W–{league.stats.matches.losses}L</p>
          <p>Diff {league.stats.matches.diff}</p>
        </div>
        <div class="sq-stat">
          <p class="sq-stat-kicker">Games</p>
          <p class="sq-stat-line">{league.stats.games.wins}W–{league.stats.games.losses}L</p>
          <p>Diff {league.stats.games.diff}</p>
        </div>
      </div>
      <ul class="sq-rates">
        <li><span>Matchup win %</span><strong>{league.stats.matchupWinPercent}</strong></li>
        <li><span>Match win %</span><strong>{league.stats.matchWinPercent}</strong></li>
        <li><span>Game win %</span><strong>{league.stats.gameWinPercent}</strong></li>
        <li><span>Points earned %</span><strong>{league.stats.pointsEarnedPercent}</strong></li>
        <li><span>Avg opponent team rating</span><strong>{league.stats.avgOpponentTeamRatingDisplay}</strong></li>
      </ul>
    </section>

    <section class="sq-block" aria-labelledby="sq-results">
      <div class="sq-head">
        <h2 id="sq-results">Last matchups</h2>
        <p>Team points only. The screenshots do not show the games inside each matchup.</p>
      </div>
      <div class="sq-results">
        {league.results.map((match) => (
          <article class="sq-match">
            <p class="sq-match-date">{match.dateDisplay}</p>
            <div class="sq-match-board">
              <div class:list={['sq-side', { 'sq-side-win': match.winner === match.away.name, 'sq-side-us': match.away.name === ours }]}>
                <p class="sq-side-name">{match.away.name}</p>
                <p class="sq-side-meta">{match.away.rankDisplay} · {match.away.side}</p>
                <p class="sq-side-meta">PD% {match.away.pdPercentDisplay}</p>
                {match.winner === match.away.name && <p class="sq-won">Won</p>}
              </div>
              <div class="sq-score" aria-label={`Team points ${match.away.teamPoints} to ${match.home.teamPoints}`}>
                <span class:list={{ 'sq-score-win': match.winner === match.away.name }}>{match.away.teamPoints}</span>
                <span class="sq-vs">vs</span>
                <span class:list={{ 'sq-score-win': match.winner === match.home.name }}>{match.home.teamPoints}</span>
                <small>Team points</small>
              </div>
              <div class:list={['sq-side', 'sq-side-home', { 'sq-side-win': match.winner === match.home.name, 'sq-side-us': match.home.name === ours }]}>
                <p class="sq-side-name">{match.home.name}</p>
                <p class="sq-side-meta">{match.home.rankDisplay} · {match.home.side}</p>
                <p class="sq-side-meta">PD% {match.home.pdPercentDisplay}</p>
                {match.winner === match.home.name && <p class="sq-won">Won</p>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="sq-block" aria-labelledby="sq-upcoming">
      <div class="sq-head">
        <h2 id="sq-upcoming">Upcoming schedule</h2>
        <p>Scheduled on the transcribed board. No result is recorded for these dates.</p>
      </div>
      <ol class="sq-upcoming">
        {league.upcoming.map((game, index) => (
          <li>
            <p class="sq-when">
              <time datetime={game.date}>{game.dateDisplay}</time>
              <span>{game.time}</span>
              {index === 0 && <span class="sq-next">Next</span>}
            </p>
            <p class="sq-pairing">
              <span class:list={{ 'sq-us': game.away.name === ours }}>{game.away.name}</span>
              <span class="sq-rank">{game.away.rankDisplay} {game.away.side}</span>
              <span class="sq-vs-inline">vs</span>
              <span class:list={{ 'sq-us': game.home.name === ours }}>{game.home.name}</span>
              <span class="sq-rank">{game.home.rankDisplay} {game.home.side}</span>
            </p>
            <p class="sq-where">{game.court}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sq-block" aria-labelledby="sq-table">
      <div class="sq-head">
        <h2 id="sq-table">Standings</h2>
        <p>{league.standings.division}. The screenshot ends at points per matchup, so the cropped last-match column is not on this table.</p>
      </div>
      <div class="sq-table-wrap">
        <table>
          <caption>{league.standings.division}, transcribed about October 6, 2026</caption>
          <thead>
            <tr>
              <th scope="col">Rank</th>
              <th scope="col">Team</th>
              <th scope="col">Pts</th>
              <th scope="col">MU</th>
              <th scope="col">W reg</th>
              <th scope="col">W TB</th>
              <th scope="col">W</th>
              <th scope="col">L</th>
              <th scope="col">T</th>
              <th scope="col">Pts / MU</th>
            </tr>
          </thead>
          <tbody>
            {league.standings.rows.map((row) => (
              <tr class:list={{ 'sq-row-us': row.team === ours }}>
                <td>{row.rank}</td>
                <th scope="row">{row.team}</th>
                <td>{row.points}</td>
                <td>{row.matchupsPlayed}</td>
                <td>{row.winsRegular}</td>
                <td>{row.winsTiebreak}</td>
                <td>{row.winsTotal}</td>
                <td>{row.losses}</td>
                <td>{row.ties}</td>
                <td>{row.pointsPerMatchup}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sq-block sq-source" aria-labelledby="sq-source">
      <h2 id="sq-source">Source</h2>
      <p>{league.source}</p>
      <ul>
        {league.omitted.map((line) => <li>{line}</li>)}
      </ul>
      <p>
        <a href="/pickleball/the-squeeze.json">JSON twin</a>
        <span aria-hidden="true"> · </span>
        <a href={`/b/${league.block}`}>Block {league.block}</a>
        <span aria-hidden="true"> · </span>
        <a href="/pickleball">Where to play</a>
      </p>
    </section>
  </article>
</BlockLayout>

<style>
  .sq {
    --sq-ink: #12110e;
    --sq-muted: #5c584f;
    --sq-line: #d9d3c5;
    --sq-paper: #f7f4ec;
    --sq-card: #fffdf8;
    --sq-green: #3b6d11;
    --sq-green-ink: #24460a;
    --sq-wash: #f0f5e9;
    --sq-peach: #f8e6d4;
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 20px 72px;
    color: var(--sq-ink);
  }

  .sq-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 18px;
    margin-bottom: 28px;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .sq-nav span {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .sq-nav a { color: var(--sq-green-ink); }

  .sq-kicker,
  .sq-stat-kicker,
  .sq-match-date,
  .sq-when,
  .sq-head p {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
  }

  .sq-kicker {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sq-green-ink);
  }

  .sq-hero h1 {
    margin: 0;
    font-size: clamp(48px, 8vw, 84px);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .sq-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.8fr);
    gap: 28px;
    align-items: end;
  }

  .sq-court {
    margin: 10px 0 0;
    font-size: 18px;
  }
  .sq-dek {
    margin: 12px 0 0;
    max-width: 42rem;
    color: var(--sq-muted);
    line-height: 1.45;
  }

  .sq-marks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    background: var(--sq-ink);
    color: #f7f4ec;
  }
  .sq-marks div { padding: 14px 12px 12px; }
  .sq-marks div + div { border-left: 1px solid #3a3832; }
  .sq-marks dt {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c8c2b4;
  }
  .sq-marks dd {
    margin: 6px 0 0;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .sq-banner {
    margin: 22px 0 0;
    padding: 12px 14px;
    background: var(--sq-wash);
    border-left: 4px solid var(--sq-green);
    color: var(--sq-green-ink);
    line-height: 1.45;
  }

  .sq-block { margin-top: 36px; }
  .sq-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    align-items: baseline;
    margin-bottom: 14px;
  }
  .sq-head h2, .sq-source h2 {
    margin: 0;
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  .sq-head p, .sq-source p, .sq-source li {
    margin: 0;
    color: var(--sq-muted);
    line-height: 1.45;
  }
  .sq-head p { max-width: 36rem; font-size: 13px; }

  .sq-roster {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sq-roster li {
    padding: 16px 16px 14px;
    background: var(--sq-card);
    border: 1px solid var(--sq-line);
  }
  .sq-roster strong { display: block; font-size: 22px; letter-spacing: -0.02em; }
  .sq-roster span {
    display: block;
    margin-top: 4px;
    color: var(--sq-muted);
  }

  .sq-stats {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.8fr 0.8fr;
    gap: 12px;
  }
  .sq-stat {
    padding: 14px;
    background: var(--sq-card);
    border: 1px solid var(--sq-line);
  }
  .sq-stat-kicker {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  .sq-stat-big, .sq-stat-line {
    margin: 6px 0;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .sq-stat p { margin: 4px 0 0; color: var(--sq-muted); }
  .sq-stat dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 8px 0 0;
  }
  .sq-stat dt {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  .sq-stat dd { margin: 2px 0 0; font-size: 18px; }

  .sq-rates {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .sq-rates li {
    padding: 12px;
    background: var(--sq-paper);
    border: 1px solid var(--sq-line);
  }
  .sq-rates span {
    display: block;
    font-size: 12px;
    color: var(--sq-muted);
  }
  .sq-rates strong {
    display: block;
    margin-top: 4px;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .sq-results { display: grid; gap: 12px; }
  .sq-match {
    padding: 14px;
    background: var(--sq-card);
    border: 1px solid var(--sq-line);
  }
  .sq-match-date {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  .sq-match-board {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: center;
  }
  .sq-side-home { text-align: right; }
  .sq-side-name {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .sq-side-us .sq-side-name { color: var(--sq-green-ink); }
  .sq-side-meta, .sq-won { margin: 2px 0 0; color: var(--sq-muted); }
  .sq-won {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sq-green-ink);
  }
  .sq-score {
    display: grid;
    grid-template-columns: auto auto auto;
    gap: 8px 10px;
    justify-items: center;
    align-items: center;
    min-width: 148px;
    padding: 8px 12px;
    background: var(--sq-paper);
    border: 1px solid var(--sq-line);
    font-size: 32px;
    line-height: 1;
  }
  .sq-score small {
    grid-column: 1 / -1;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  .sq-vs, .sq-vs-inline {
    font-size: 14px;
    color: var(--sq-muted);
  }
  .sq-score-win { color: var(--sq-green-ink); }

  .sq-upcoming {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sq-line);
  }
  .sq-upcoming li {
    padding: 14px 0;
    border-bottom: 1px solid var(--sq-line);
  }
  .sq-when {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  .sq-next {
    padding: 1px 6px;
    background: var(--sq-green);
    color: #f7f4ec;
    letter-spacing: 0.08em;
  }
  .sq-pairing {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: baseline;
    margin: 6px 0 0;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .sq-us { color: var(--sq-green-ink); font-weight: 700; }
  .sq-rank {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 12px;
    color: var(--sq-muted);
  }
  .sq-where { margin: 4px 0 0; color: var(--sq-muted); }

  .sq-table-wrap { overflow-x: auto; border: 1px solid var(--sq-line); }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    background: var(--sq-card);
  }
  caption {
    padding: 10px 12px;
    text-align: left;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sq-muted);
  }
  th, td {
    padding: 10px 12px;
    text-align: right;
    border-top: 1px solid var(--sq-line);
    white-space: nowrap;
  }
  thead th {
    background: var(--sq-ink);
    color: #f7f4ec;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  tbody th[scope="row"] {
    text-align: left;
    font-weight: 650;
  }
  td:first-child, thead th:first-child { text-align: left; }
  .sq-row-us { background: var(--sq-wash); }
  .sq-row-us th { color: var(--sq-green-ink); }

  .sq-source {
    padding-top: 8px;
  }
  .sq-source ul {
    margin: 12px 0;
    padding-left: 18px;
  }
  .sq-source li { margin: 6px 0; }
  .sq-source a { color: var(--sq-green-ink); }

  @media (max-width: 800px) {
    .sq-hero-row, .sq-stats, .sq-rates, .sq-roster { grid-template-columns: 1fr; }
    .sq-stat dl { grid-template-columns: repeat(2, 1fr); }
    .sq-match-board { grid-template-columns: 1fr; }
    .sq-side-home { text-align: left; }
    .sq-score { justify-self: start; }
  }
</style>
