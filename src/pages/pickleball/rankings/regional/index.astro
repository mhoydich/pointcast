---
import RankShell from '../../../../components/pickleball-rankings/RankShell.astro';
import { TIERS, BASE, coverage, fmtDate } from '../../../../lib/pickleball-rankings/data.mjs';
---
<RankShell title="Regional pickleball ladders" description="PointCast regional pickleball ladders: named radius ladders that roll up into the national and global tiers." active="regional">
  <h1>Regional ladders</h1>
  <p class="pr-dek">A regional ladder is a named center with a radius. One player can sit on several ladders. Every ladder rolls up into national (US venues) and global.</p>
  <div class="pr-cards">
    {TIERS.regional.map((t: any) => { const c = coverage(t); const f = t.feeds[0]; return (
      <div class="pr-card">
        <h3><a href={`${BASE}regional/${f.feed_id}/`}>{t.label}</a></h3>
        <span class="n">{c.players}</span>
        <p>players · {c.events} events · as of {fmtDate(f.as_of)}. Source ladder: <a href={f.upstream.directory}>elsegundo.xyz</a>.</p>
      </div>
    ); })}
    <div class="pr-card"><h3>Next ladders</h3><span class="n">—</span><p>None yet. Each new ladder needs Mike's okay. See the <a href={`${BASE}method/#tiers`}>tier plan</a>.</p></div>
  </div>
</RankShell>
