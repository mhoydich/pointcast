---
import RankShell from '../../../../components/pickleball-rankings/RankShell.astro';
import { TIERS, BASE, LEVEL_BANDS, byLevel } from '../../../../lib/pickleball-rankings/data.mjs';
const t = TIERS.national;
---
<RankShell title="Pickleball rankings by level" description="PointCast pickleball rankings filtered by level, in half-step bands from 2.0 to 8.0." active="level">
  <h1>By level</h1>
  <p class="pr-dek">Level is the Court Rating rounded to the nearest half step, 2.0 to 8.0. A level view is a filter over a tier, in the same order. These pages filter the US rollup. A band with no player says unavailable, never zero.</p>
  <div class="pr-cards">
    {LEVEL_BANDS.map((b) => { const n = byLevel(t.players, b).length; return (
      <div class="pr-card"><h3>{n ? <a href={`${BASE}level/${b}/`}>Level {b}</a> : `Level ${b}`}</h3><span class="n">{n || 'unavailable'}</span><p>{n ? 'players in the US rollup' : 'no counted results yet'}</p></div>
    ); })}
  </div>
</RankShell>
