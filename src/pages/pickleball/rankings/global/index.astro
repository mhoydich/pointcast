---
import RankShell from '../../../../components/pickleball-rankings/RankShell.astro';
import { TIERS, SOURCES, BASE, tierStatus, fmtDate } from '../../../../lib/pickleball-rankings/data.mjs';
import RankTable from '../../../../components/pickleball-rankings/RankTable.astro';

const st = tierStatus('global');
const global = (SOURCES.link_only || []).filter((s: any) => s.scale === 'global');
const unclear = (SOURCES.unclear || []).filter((s: any) => s.scale === 'global');
---
<RankShell title="Global pickleball rankings" description="A preview of PointCast's global pickleball rankings tier, which opens once a second national ladder exists." active="global">
  <h1>Global rankings</h1>
  <p class="pr-dek">National ladders roll up into global. Same recipe, same rows.</p>
  <div class={`pr-status${st.available ? ' ok' : ''}`}><strong>{st.available ? 'Available' : 'Unavailable'}</strong>{st.available ? '' : st.reason}</div>
  {st.available ? <RankTable players={TIERS.global.players} caption={`Global, as of ${fmtDate(TIERS.as_of)}.`} /> : <p>Until then, see the <a href={`${BASE}national/`}>US rollup</a>.</p>}
  <h2>Global sources checked</h2>
  {global.length || unclear.length ? (
    <ul class="pr-list">
      {global.map((s: any) => <li><a href={s.link} rel="noopener nofollow">{s.name}</a> · link only: {s.why}</li>)}
      {unclear.map((s: any) => <li><a href={s.link} rel="noopener nofollow">{s.name}</a> · unclear: {s.why}</li>)}
    </ul>
  ) : <p>See the <a href={`${BASE}method/#sources`}>source survey</a>.</p>}
</RankShell>
