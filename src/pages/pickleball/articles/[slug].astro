---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import { articles, buildArticleJsonLd } from '../../../lib/pickleball-v2/articles.js';
import { renderPickleballArticle } from '../../../lib/pickleball-v2/article-render.js';
import '../../../lib/pickleball-v2/articles.css';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
---

<BlockLayout
  title={`${article.title} · Pickleball`}
  description={article.dek}
  image={article.socialImage}
  imageWidth={article.imageWidth}
  imageHeight={article.imageHeight}
  themeColor="#074b35"
  author="PointCast Editorial"
  creator="PointCast Editorial"
  immersive
  hideAds
  showNetworkStrip={false}
  jsonLd={buildArticleJsonLd(article)}
  alternates={[{ type: 'application/json', href: `${article.url}.json`, title: `${article.shortTitle} editorial data` }]}
>
  <div set:html={renderPickleballArticle(article)} />
</BlockLayout>
