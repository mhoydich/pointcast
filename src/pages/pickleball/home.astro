---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { renderPointCastPickleballHome } from '../../lib/pickleball-v2/render.js';
import '../../lib/pickleball-home/styles.css';
import '../../lib/pickleball-v2/styles.css';

const title = 'Pickleball Home · RALLY × PointCast';
const description = 'Build a pickleball practice for your goal, time, space, and partner. Keep a browser-local practice scorecard, read illustrated coaching notes, find sourced South Bay courts, and explore paddle research.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://pointcast.xyz/pickleball/home',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  relatedLink: ['https://tez-rally.pages.dev/', 'https://pointcast.xyz/pickleball', 'https://pointcast.xyz/paddles'],
};
---
<BlockLayout title={title} description={description} image="/images/pickleball-home/social.webp" themeColor="#0955cf" author="PointCast Editorial" creator="PointCast Editorial" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{type:'application/json',href:'/pickleball/home.json',title:'Pickleball learning and verified courts'}]}>
  <div set:html={renderPointCastPickleballHome()} />
</BlockLayout>
<script>
  import { mountPickleballHome } from '../../lib/pickleball-home/client.js';
  import { mountPickleballV2 } from '../../lib/pickleball-v2/client.js';
  mountPickleballHome();
  mountPickleballV2();
</script>
