---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { renderPickleballHome } from '../../lib/pickleball-home/render.js';
import '../../lib/pickleball-home/styles.css';

const title = 'Pickleball Home · RALLY × PointCast';
const description = 'Learn pickleball from your first serve to better doubles. Find sourced South Bay courts, build a practice, explore paddles, and play with the RALLY crew.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://pointcast.xyz/pickleball/home',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
  relatedLink: ['https://tez-rally.pages.dev/', 'https://pointcast.xyz/pickleball', 'https://pointcast.xyz/paddles'],
};
---
<BlockLayout title={title} description={description} image="/images/pickleball-home/social.webp" themeColor="#0955cf" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{type:'application/json',href:'/pickleball/home.json',title:'Pickleball learning and verified courts'}]}>
  <div set:html={renderPickleballHome({ brand: 'pointcast', assetBase: '/images/pickleball-home', rallyUrl: 'https://tez-rally.pages.dev', pointcastUrl: 'https://pointcast.xyz' })} />
</BlockLayout>
<script>
  import { mountPickleballHome } from '../../lib/pickleball-home/client.js';
  mountPickleballHome();
</script>
