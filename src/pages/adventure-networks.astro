---
import BlockLayout from '../layouts/BlockLayout.astro';
import { getPointcastApp } from '../lib/pointcast-apps';
import adventureNetworksCard from '../assets/adventure-networks/og.png';

const app = getPointcastApp('adventure-networks')!;
const title = app.name;
const description = app.description;

const features = [
  { number: '01', name: 'Compose', note: 'Choose terrain, group size, time, and intent to generate a deterministic field route.' },
  { number: '02', name: 'Carry', note: 'Turn the generated kit into a live pack check before anyone leaves the threshold.' },
  { number: '03', name: 'Return', note: 'Stamp session notes, share the route, and download the complete dispatch as Markdown.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/adventure-networks',
  name: title,
  description,
  url: app.url,
  sameAs: 'https://pointcast.xyz/adventure-networks',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/adventure-networks.json', title: 'Adventure Networks discovery packet' }]}
  frame={{
    image: 'https://adventure-networks-field-guide.mhoydich.chatgpt.site/og.png',
    buttons: [
      { label: 'Open field guide', action: 'link', target: app.url },
      { label: 'Adventure Networks JSON', action: 'link', target: 'https://pointcast.xyz/adventure-networks.json' },
    ],
  }}
>
  <main class="field-page">
    <nav class="crumb mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a>
      <span aria-hidden="true">/</span>
      <a href="/apps">Apps</a>
      <span aria-hidden="true">/</span>
      <span>Adventure Networks</span>
    </nav>

    <section class="hero" aria-labelledby="adventure-networks-title">
      <div class="hero__copy">
        <p class="kicker mono">CH.GDN · FIELD GUIDE · BUILT WITH QWEN</p>
        <h1 id="adventure-networks-title">Go somewhere on purpose.</h1>
        <p class="dek">Compose a route. Check the pack. Catch the signal while it is alive. Return with something the next person can use.</p>
        <div class="hero__actions">
          <a class="launch" href={app.url} target="_blank" rel="noopener">OPEN FIELD GUIDE <span aria-hidden="true">↗</span></a>
          <a class="secondary mono" href="/adventure-networks.json">DISCOVERY JSON</a>
        </div>
        <p class="boundary-note mono">NO ACCOUNT · NO LOCATION TRACKING · NOTES STAY IN THE OPEN SESSION</p>
      </div>
      <a class="hero__image" href={app.url} target="_blank" rel="noopener" aria-label="Open Adventure Networks Field Guide">
        <img src={adventureNetworksCard.src} alt="Adventure Networks Field Guide with a five-node field map" width={adventureNetworksCard.width} height={adventureNetworksCard.height} />
        <span class="image-label mono">PUBLIC RESOURCE · OPEN DIRECT ↗</span>
      </a>
    </section>

    <section class="method" aria-labelledby="method-title">
      <div>
        <p class="section-number mono">THE METHOD</p>
        <h2 id="method-title">Seed.<br />Traverse.<br />Return.</h2>
      </div>
      <p>A small adventure network is not a tour product. It is a living agreement between people, places, signals, skills, and missions—made useful by the quality of its return.</p>
    </section>

    <section class="features" aria-labelledby="features-title">
      <header>
        <p class="section-number mono">THE POCKET CONSOLE</p>
        <h2 id="features-title">One route, three movements.</h2>
      </header>
      <ol>
        {features.map((feature) => (
          <li>
            <span class="feature-number mono">{feature.number}</span>
            <strong>{feature.name}</strong>
            <p>{feature.note}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="protocols" aria-labelledby="protocols-title">
      <div>
        <p class="section-number mono">SIX FIELD PROTOCOLS</p>
        <h2 id="protocols-title">Use what the moment asks for.</h2>
      </div>
      <ul>
        <li>Signal Fire</li>
        <li>Local Oracle</li>
        <li>Moving Camp</li>
        <li>Skill Swap</li>
        <li>Threshold Walk</li>
        <li>Return Gift</li>
      </ul>
    </section>

    <aside class="boundary" aria-label="Adventure Networks privacy boundary">
      <strong class="mono">WHAT THIS VERSION KEEPS</strong>
      <p>The route composer runs in the browser. Field notes remain in the current session unless the visitor downloads a dispatch. There is no account, map tracking, or external runtime API behind the guide.</p>
    </aside>

    <footer class="end mono">
      <span>POINTCAST SATELLITE · ADVENTURE NETWORKS</span>
      <a href="/apps">BACK TO APPS +</a>
    </footer>
  </main>
</BlockLayout>

<style>
  .field-page {
    --an-paper: #f4ede0;
    --an-ink: #101820;
    --an-orange: #e85d2f;
    --an-moss: #4a5d3a;
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px 18px 70px;
    color: var(--an-ink);
  }
  .mono { font-family: var(--pc-font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .crumb { display: flex; gap: 8px; margin: 0 0 18px; font-size: 10px; color: var(--pc-ink-muted); }
  .hero { display: grid; grid-template-columns: minmax(0, .82fr) minmax(440px, 1.18fr); min-height: 580px; border: 2px solid var(--an-ink); background: var(--an-paper); }
  .hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 5vw, 70px); border-right: 2px solid var(--an-ink); }
  .kicker, .section-number { margin: 0 0 18px; color: var(--an-moss); font-size: 10px; font-weight: 700; }
  h1 { max-width: 560px; margin: 0; font-size: clamp(58px, 8vw, 116px); font-weight: 520; letter-spacing: -.07em; line-height: .82; }
  .dek { max-width: 520px; margin: 30px 0 0; font-size: clamp(18px, 2vw, 24px); line-height: 1.25; }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 36px; }
  .launch { display: inline-flex; justify-content: space-between; gap: 28px; padding: 14px 18px; border: 2px solid var(--an-ink); background: var(--an-orange); color: var(--an-ink); font: 700 11px/1 var(--pc-font-mono); letter-spacing: .1em; text-decoration: none; }
  .launch:hover { background: var(--an-moss); color: var(--an-paper); text-decoration: none; }
  .secondary { color: var(--an-ink); font-size: 10px; text-underline-offset: 4px; }
  .boundary-note { margin: 22px 0 0; color: rgba(16,24,32,.58); font-size: 8px; line-height: 1.5; }
  .hero__image { position: relative; display: flex; align-items: center; min-width: 0; padding: 24px; overflow: hidden; background: #e7ddca; color: var(--an-ink); }
  .hero__image img { width: 100%; height: auto; border: 2px solid var(--an-ink); box-shadow: 10px 10px 0 rgba(16,24,32,.14); }
  .image-label { position: absolute; right: 34px; bottom: 34px; padding: 9px 11px; border: 2px solid var(--an-ink); background: var(--an-paper); font-size: 8px; }
  .method { display: grid; grid-template-columns: .7fr 1fr; gap: 70px; align-items: end; padding: 72px 0; border-bottom: 2px solid var(--an-ink); }
  .method h2, .features h2, .protocols h2 { margin: 0; font-size: clamp(42px, 6vw, 78px); font-weight: 520; letter-spacing: -.055em; line-height: .92; }
  .method > p { margin: 0; font-size: 20px; line-height: 1.55; }
  .features { padding: 58px 0 70px; }
  .features header { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 28px; }
  .features ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; border: 2px solid var(--an-ink); list-style: none; }
  .features li { min-height: 260px; display: flex; flex-direction: column; padding: 20px; border-right: 2px solid var(--an-ink); background: var(--an-paper); }
  .features li:last-child { border-right: 0; }
  .feature-number { color: var(--an-orange); font-size: 10px; }
  .features strong { margin-top: 64px; font-size: 32px; font-weight: 540; letter-spacing: -.04em; }
  .features li p { margin: auto 0 0; color: rgba(16,24,32,.72); font-size: 14px; line-height: 1.45; }
  .protocols { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: end; padding: clamp(30px, 5vw, 62px); border: 2px solid var(--an-ink); background: var(--an-orange); }
  .protocols ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 0; padding: 0; border-top: 2px solid var(--an-ink); list-style: none; }
  .protocols li { padding: 14px 0; border-bottom: 1px solid rgba(16,24,32,.5); font: 700 12px/1.3 var(--pc-font-mono); text-transform: uppercase; }
  .boundary { display: grid; grid-template-columns: .36fr 1fr; gap: 40px; padding: 30px 0; border-bottom: 2px solid var(--an-ink); }
  .boundary strong { font-size: 9px; }
  .boundary p { max-width: 760px; margin: 0; font-size: 14px; line-height: 1.55; }
  .end { display: flex; justify-content: space-between; gap: 20px; padding-top: 20px; font-size: 9px; }
  .end a { color: var(--an-ink); }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; }
    .hero__copy { border-right: 0; border-bottom: 2px solid var(--an-ink); }
    .hero__image { min-height: 360px; }
    .method, .protocols, .boundary { grid-template-columns: 1fr; gap: 22px; }
    .features ol { grid-template-columns: 1fr; }
    .features li { min-height: 200px; border-right: 0; border-bottom: 2px solid var(--an-ink); }
    .features li:last-child { border-bottom: 0; }
    .features strong { margin-top: 38px; }
  }
  @media (max-width: 560px) {
    .field-page { padding-inline: 10px; }
    .hero { min-height: 0; }
    .hero__copy { padding: 34px 22px; }
    .hero__image { min-height: 260px; padding: 14px; }
    .image-label { right: 20px; bottom: 20px; }
    .features header { display: block; }
    .protocols { padding: 30px 22px; }
    .protocols ul { grid-template-columns: 1fr; }
    .end { flex-direction: column; }
  }
</style>
