  .bd-album{max-width:1180px;margin:28px auto 0;padding:30px clamp(16px,3vw,40px) 36px;background:#f3e6c8 url(/images/band/qsl.jpg) center/cover;background-blend-mode:multiply;color:#2a2118;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(90,60,20,.25),inset 0 0 80px rgba(120,80,30,.25),0 20px 50px rgba(0,0,0,.45);position:relative}
