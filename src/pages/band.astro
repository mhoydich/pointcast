  .bd-slot.is-gold button{background:linear-gradient(145deg,#fff6d8,#f1dc9c 45%,#fff3cf 60%,#e7c877);box-shadow:0 0 0 2px #c9a14a,0 8px 18px rgba(120,80,10,.35)}
