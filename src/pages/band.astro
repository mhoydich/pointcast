  .bd-qsl__note input{flex:1 1 220px;min-width:0;height:38px;padding:0 10px;border-radius:6px;border:1px solid var(--bd-line);background:#0f0d0b;color:#bcd0f5;font:22px Caveat,cursive}

  @media (max-width:640px){
    .bd-hero{min-height:520px}
    .bd-hero::after{background:linear-gradient(0deg,rgba(26,23,19,.97) 40%,rgba(26,23,19,.35))}
    .bd-freq{margin-left:0;order:-1;width:100%}
    .bd-counts{margin-left:auto}
    .bd-vol{margin-left:0}
    .bd-card--fox{grid-template-columns:72px 1fr}
    .bd-card--fox img{width:72px;height:72px}
  }
  @media (prefers-reduced-motion:reduce){.bd-head{transition:none}.bd-head.is-ping{animation:none}}
</style>

<script>
  import {
    BAND, NET, SEASON, GOLD_STAMP, advanceCopy, callSign, clarity, clampStep, daysBetween, foxNumber, foxOf, formatMhz,
    formatWait, hash32, isGold, morseSchedule, netIcs, netState, packSeq, pad3, parseFreq, proximity, signalClarity,
    stampFor, towerLine, townDate, unpackStep,
  } from '../lib/band';

  type Listener = { id: string; avatar: number; hue: number; step: number | null; at: number; live: boolean };
  type Kind = 'fox' | 'signal' | 'net';
  type Card = {
    key: string; kind: Kind; date: string; mhz: string; message: string; call: string; avatar?: number;
    with: { call: string; avatar: number }[]; at: number; no?: number; stamp?: number; gold?: boolean; note?: string; tx?: string; from?: string;
  };
  type Signal = { id: string; step: number; text: string; call: string; avatar: number; at: string; heard: number; mine: boolean };
  type Day = { signals: Signal[]; fox: { copies: number; recent: { call: string; at: string }[] }; net: { checkins: number; roll: { call: string; avatar: number; at: string }[] } };

  const root = document.querySelector<HTMLElement>('[data-band]');
  if (root) boot(root);

  function boot(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const els = {
      air: $<HTMLButtonElement>('[data-air]'), goto: $<HTMLButtonElement>('[data-goto]'), invite: $<HTMLButtonElement>('[data-invite]'),
      note: $('[data-note]'), meNoun: $<HTMLImageElement>('[data-me-noun]'), meCall: $('[data-me-call]'), link: $('[data-link]'),
      freq: $('[data-freq]'), on: $('[data-count-on]'), near: $('[data-count-near]'), fall: $<HTMLCanvasElement>('[data-fall]'),
      heads: $('[data-heads]'), dial: $('[data-dial]'), needle: $('[data-needle]'), smeter: $('[data-smeter]'), sread: $('[data-sread]'),
      clear: $('[data-clear]'), helpers: $('[data-helpers]'), vol: $<HTMLInputElement>('[data-vol]'), lamp: $('[data-lamp]'),
      tape: $('[data-tape]'), tapeNote: $('[data-tape-note]'), tapeBox: $('.bd-tape'), people: $('[data-people]'),
      foxStatus: $('[data-fox-status]'), foxCount: $('[data-fox-count]'), finds: $('[data-finds]'),
      net: $('[data-net]'), netText: $('[data-net-text]'), netTune: $<HTMLButtonElement>('[data-net-tune]'),
      netCheckin: $<HTMLButtonElement>('[data-net-checkin]'), netCal: $<HTMLButtonElement>('[data-net-cal]'),
      sigForm: $<HTMLFormElement>('[data-sig-form]'), sigText: $<HTMLInputElement>('[data-sig-text]'), sigFreq: $('[data-sig-freq]'),
      sigStatus: $('[data-sig-status]'), signals: $('[data-signals]'),
      albumCount: $('[data-album-count]'), albumFoxes: $('[data-album-foxes]'), albumContacts: $('[data-album-contacts]'),
      qsl: $<HTMLDialogElement>('[data-qsl]'), qslTitle: $('[data-qsl-title]'), qslCanvas: $<HTMLCanvasElement>('[data-qsl-canvas]'),
      qslNote: $<HTMLInputElement>('[data-qsl-note]'), qslStatus: $('[data-qsl-status]'),
      qslSave: $<HTMLButtonElement>('[data-qsl-save]'), qslShareFile: $<HTMLButtonElement>('[data-qsl-share-file]'),
      qslShare: $<HTMLButtonElement>('[data-qsl-share]'), qslChain: $<HTMLButtonElement>('[data-qsl-chain]'), qslClose: $<HTMLButtonElement>('[data-qsl-close]'),
    };

    const store = {
      get<T>(key: string, fallback: T): T { try { const v = localStorage.getItem(key); return v ? JSON.parse(v) as T : fallback; } catch { return fallback; } },
      set(key: string, value: unknown) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* private window */ } },
    };

    // ---------- identity + state ----------
    let sid = store.get<string>('pc-band-sid', '');
    if (!sid) { sid = crypto.randomUUID?.() ?? String(Math.random()).slice(2); store.set('pc-band-sid', sid); }

    const params = new URLSearchParams(location.search);
    let step = clampStep(parseFreq(params.get('f')) ?? store.get<number>('pc-band-step', NET.step));

    let me = { id: '', avatar: 0, hue: 30, call: 'PC?-···' };
    const people = new Map<string, Listener>();
    let fox = foxOf(townDate());

    // v1 logbooks had no kind/key; they were all fox cards.
    let cards: Card[] = store.get<any[]>('pc-band-log', []).map((c) => ({ kind: 'fox', key: `fox:${c.date}`, ...c, no: c.no ?? foxNumber(c.date), stamp: c.stamp ?? stampFor(c.date, !!c.gold) }));
    const saveCards = () => store.set('pc-band-log', cards.slice(-400));
    const hasCard = (key: string) => cards.some((c) => c.key === key);
    let foundToday = hasCard(`fox:${fox.date}`);
    let revealed = foundToday ? fox.message.length : 0;
    const sigRevealed = new Map<string, number>();
    const finds: { call: string; at: number }[] = [];
    let heardPresence = false;
    let day: Day = { signals: [], fox: { copies: 0, recent: [] }, net: { checkins: 0, roll: [] } };
    let net = netState();

    // ---------- the slow memory (/api/band) ----------
    async function fetchDay() {
      try {
        const res = await fetch('/api/band', { headers: { Accept: 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        if (data?.ok) { day = { signals: data.signals || [], fox: data.fox || day.fox, net: data.net || day.net }; renderSignals(); renderFinds(); }
      } catch { /* the live band still works */ }
    }
    async function api(body: Record<string, unknown>): Promise<{ ok: boolean; error?: string }> {
      try {
        const res = await fetch('/api/band', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ call: me.call, avatar: me.avatar, ...body }) });
        const data = await res.json().catch(() => ({}));
        if (data?.ok) { day = { signals: data.signals || day.signals, fox: data.fox || day.fox, net: data.net || day.net }; renderSignals(); renderFinds(); }
        return { ok: !!data?.ok, error: data?.error };
      } catch { return { ok: false, error: 'Could not reach the band. Try again.' }; }
    }
    setInterval(() => { if (document.visibilityState === 'visible') fetchDay(); }, 45000);

    // ---------- transport (DrumRoomV2, legacy pads) ----------
    let ws: WebSocket | null = null;
    let wsOpen = false;
    let retry = 0;
    let counter = Math.floor(Math.random() * 1000);
    let lastSent = 0;
    let pendingTune: number | null = null;

    function connect() {
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      try {
        ws = new WebSocket(`${proto}//${location.host}/api/drum/room?room=${BAND.room}&sid=${encodeURIComponent(sid)}`);
      } catch { scheduleReconnect(); return; }
      ws.addEventListener('open', () => { wsOpen = true; retry = 0; });
      ws.addEventListener('message', (e) => { try { onMessage(JSON.parse(String(e.data))); } catch { /* ignore */ } });
      ws.addEventListener('close', () => { wsOpen = false; els.link.textContent = 'reconnecting to the band…'; scheduleReconnect(); });
      ws.addEventListener('error', () => { /* close follows */ });
    }
    function scheduleReconnect() {
      retry += 1;
      if (retry > 6) { els.link.textContent = 'band is quiet · tuning solo'; return; }
      setTimeout(connect, Math.min(15000, 800 * 2 ** retry));
    }
    function send(pad: 'kick' | 'hat' | 'bell', at: number) {
      if (!ws || !wsOpen) return;
      counter += 1;
      try { ws.send(JSON.stringify({ v: 1, type: 'hit', pad, velocity: 0.6, seq: packSeq(counter, at), clientAt: Date.now() })); } catch { /* close follows */ }
    }
    function sendReaction(emoji: string) {
      if (ws && wsOpen) { try { ws.send(JSON.stringify({ v: 1, type: 'reaction', emoji })); } catch { /* close follows */ } }
    }
    function sendTune() {
      const now = Date.now();
      if (now - lastSent < 260) { pendingTune = step; return; }
      lastSent = now; pendingTune = null;
      send('kick', step);
    }
    setInterval(() => { if (pendingTune !== null && Date.now() - lastSent >= 260) sendTune(); }, 120);
    setInterval(() => { if (document.visibilityState === 'visible') send('hat', step); }, 30000);

    // A client id is `<hash of room:sid>-<per-connection suffix>`. Key people by the stable
    // half so a reconnect (or a second tab) is the same person, never a ghost of them.
    const who = (clientId: string) => String(clientId || '').split('-')[0];
    const isMe = (clientId: string) => !!me.id && who(clientId) === who(me.id);

    function upsert(rawId: string, avatar: number, hue: number, patch: Partial<Listener>) {
      const id = who(rawId);
      const cur = people.get(id) ?? { id, avatar, hue, step: null, at: 0, live: false };
      people.set(id, { ...cur, avatar, hue, ...patch });
    }

    function onMessage(msg: any) {
      if (!msg || msg.v !== 1) return;
      if (msg.type === 'welcome') {
        me = { id: msg.you.clientId, avatar: msg.you.avatar, hue: msg.you.hue, call: callSign(who(msg.you.clientId)) };
        people.delete(who(me.id));
        els.meNoun.src = `https://noun.pics/${me.avatar % 1200}.svg`;
        els.meCall.textContent = me.call;
        els.link.textContent = 'on the band';
        const cutoff = Date.now() - 6 * 3600_000;
        for (const hit of msg.recentHits || []) {
          if (hit.pad === 'bell') { if (hit.serverAt > Date.now() - 24 * 3600_000) finds.unshift({ call: isMe(hit.clientId) ? me.call : callSign(who(hit.clientId)), at: hit.serverAt }); continue; }
          if (isMe(hit.clientId)) continue;
          if ((hit.pad === 'kick' || hit.pad === 'hat') && hit.serverAt > cutoff) upsert(hit.clientId, hit.avatar, hit.hue, { step: unpackStep(hit.seq), at: hit.serverAt });
        }
        send('hat', step);
        renderFinds();
        return;
      }
      if (msg.type === 'presence') {
        const live = new Set<string>();
        for (const p of msg.people || []) {
          if (isMe(p.id)) continue;
          live.add(who(p.id));
          const wasLive = people.get(who(p.id))?.live;
          upsert(p.id, p.avatar, p.hue, { live: true });
          if (!wasLive && heardPresence) toast(`${callSign(who(p.id))} joined the band`);
        }
        for (const l of people.values()) if (!live.has(l.id)) l.live = false;
        heardPresence = true;
        return;
      }
      if (msg.type === 'reaction') {
        if (isMe(msg.clientId)) return;
        const id = who(msg.clientId);
        floatAt(id, msg.emoji);
        const p = people.get(id);
        if (p && p.step !== null && Math.abs(p.step - step) <= 40) blip(p.step - step);
        return;
      }
      if (msg.type === 'hit') {
        if (isMe(msg.clientId)) return;
        const at = unpackStep(msg.seq);
        if (msg.pad === 'bell') {
          finds.unshift({ call: callSign(who(msg.clientId)), at: msg.serverAt });
          renderFinds();
          toast(`${callSign(who(msg.clientId))} copied the fox`);
          ping(who(msg.clientId));
          return;
        }
        upsert(msg.clientId, msg.avatar, msg.hue, { step: at, at: msg.serverAt, live: true });
        if (msg.pad === 'kick' && Math.abs(at - step) <= BAND.nearSteps) ping(who(msg.clientId));
      }
    }

    // ---------- tuning ----------
    function tune(next: number, announce = true) {
      const s = clampStep(next);
      if (s === step && announce) return;
      step = s;
      store.set('pc-band-step', step);
      const url = new URL(location.href);
      url.searchParams.set('f', formatMhz(step));
      history.replaceState(null, '', url);
      if (announce) sendTune();
    }
    function stepFromX(clientX: number) {
      const r = els.dial.getBoundingClientRect();
      return Math.round(((clientX - r.left) / Math.max(1, r.width)) * BAND.steps);
    }
    let dragging = false;
    els.dial.addEventListener('pointerdown', (e) => { dragging = true; els.dial.setPointerCapture(e.pointerId); tune(stepFromX(e.clientX)); });
    els.dial.addEventListener('pointermove', (e) => { if (dragging) tune(stepFromX(e.clientX)); });
    const endDrag = () => { if (dragging) { dragging = false; pendingTune = step; } };
    els.dial.addEventListener('pointerup', endDrag);
    els.dial.addEventListener('pointercancel', endDrag);
    els.dial.addEventListener('keydown', (e) => {
      const big = e.shiftKey ? 10 : 1;
      const map: Record<string, number> = { ArrowLeft: -big, ArrowDown: -big, ArrowRight: big, ArrowUp: big, PageDown: -40, PageUp: 40 };
      if (e.key in map) { e.preventDefault(); tune(step + map[e.key]); }
      else if (e.key === 'Home') { e.preventDefault(); tune(0); }
      else if (e.key === 'End') { e.preventDefault(); tune(BAND.steps); }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-nudge]').forEach((b) => b.addEventListener('click', () => tune(step + Number(b.dataset.nudge))));
    els.dial.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey) { e.preventDefault(); tune(step + Math.sign(e.deltaX || e.deltaY)); } }, { passive: false });

    els.goto.addEventListener('click', () => {
      const live = [...people.values()].filter((p) => p.live && p.step !== null).sort((a, b) => b.at - a.at);
      const pick = live[0] ?? [...people.values()].filter((p) => p.step !== null).sort((a, b) => b.at - a.at)[0];
      if (!pick || pick.step === null) {
        const sig = day.signals.find((s) => !s.mine);
        if (sig) { tune(sig.step); note(`Nobody live right now. Tuned to ${sig.call}’s signal instead.`); return; }
        note('Nobody else is tuned in yet. Copy the invite and bring someone.');
        return;
      }
      tune(pick.step + (pick.step >= BAND.steps ? -1 : 1));
      note(`Parked next to ${callSign(pick.id)}${pick.live ? '' : ' (tuned in earlier)'}.`);
    });
    els.invite.addEventListener('click', async () => {
      const link = `${location.origin}/band?f=${formatMhz(step)}`;
      try { await navigator.clipboard.writeText(link); note(`Copied. Anyone who opens it lands on ${formatMhz(step)} MHz.`); }
      catch { note(link); }
    });

    let noteTimer = 0;
    function note(text: string) { els.note.textContent = text; clearTimeout(noteTimer); noteTimer = window.setTimeout(() => { els.note.textContent = ''; }, 6000); }
    function toast(text: string) { note(text); }

    // ---------- derived ----------
    const liveOthers = () => [...people.values()].filter((p) => p.live && p.step !== null);
    const nearStep = (s: number) => liveOthers().filter((p) => Math.abs((p.step as number) - s) <= BAND.nearSteps);

    // ---------- audio ----------
    let ctx: AudioContext | null = null;
    let master: GainNode, staticGain: GainNode, foxKey: GainNode, foxLevel: GainNode, myGain: GainNode, sigKey: GainNode, sigLevel: GainNode;
    const peerVoices = new Map<string, { osc: OscillatorNode; gain: GainNode }>();
    let foxScheduledUntil = 0;
    const UNIT = 0.075;
    let sched = morseSchedule(fox.message);
    const loopUnits = () => sched.units + 16;
    let sigSched: { id: string; marks: [number, number][]; units: number } | null = null;

    function startAudio() {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      ctx = new AC();
      master = ctx.createGain(); master.gain.value = Number(els.vol.value) * 0.8; master.connect(ctx.destination);
      const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
      const noise = ctx.createBufferSource(); noise.buffer = buf; noise.loop = true;
      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1500; bp.Q.value = 0.6;
      staticGain = ctx.createGain(); staticGain.gain.value = 0.08;
      noise.connect(bp).connect(staticGain).connect(master); noise.start();
      const mine = ctx.createOscillator(); mine.type = 'sine'; mine.frequency.value = 196;
      myGain = ctx.createGain(); myGain.gain.value = 0.03;
      mine.connect(myGain).connect(master); mine.start();
      const fo = ctx.createOscillator(); fo.type = 'sine'; fo.frequency.value = 700;
      foxKey = ctx.createGain(); foxKey.gain.value = 0;
      foxLevel = ctx.createGain(); foxLevel.gain.value = 0;
      fo.connect(foxKey).connect(foxLevel).connect(master); fo.start();
      const so = ctx.createOscillator(); so.type = 'sine'; so.frequency.value = 560;
      sigKey = ctx.createGain(); sigKey.gain.value = 0;
      sigLevel = ctx.createGain(); sigLevel.gain.value = 0;
      so.connect(sigKey).connect(sigLevel).connect(master); so.start();
      foxScheduledUntil = 0;
    }
    function setAir(on: boolean) {
      if (on && !ctx) startAudio();
      if (!ctx) return;
      if (on) ctx.resume(); else ctx.suspend();
      els.air.setAttribute('aria-pressed', String(on));
      note(on ? 'On air. Drag the dial. Listen for other carriers and a keyed tone.' : 'Off air. The dial still works.');
    }
    els.air.addEventListener('click', () => setAir(els.air.getAttribute('aria-pressed') !== 'true'));
    els.vol.addEventListener('input', () => { if (ctx) master.gain.setTargetAtTime(Number(els.vol.value) * 0.8, ctx.currentTime, 0.05); });

    // Keyed on a wall-clock loop, so everyone hears the same letter at the same moment.
    function loopStartMs(nowMs: number, units: number) { const L = units * UNIT * 1000; return Math.floor(nowMs / L) * L; }
    function keyedIn(marks: [number, number][], units: number, nowMs: number) {
      const u = (nowMs - loopStartMs(nowMs, units)) / (UNIT * 1000);
      for (const [s, len] of marks) if (u >= s && u < s + len) return true;
      return false;
    }
    const keyedAt = (nowMs: number) => keyedIn(sched.marks, loopUnits(), nowMs);
    function scheduleFox() {
      if (!ctx || ctx.state !== 'running') return;
      const nowMs = Date.now();
      const offset = ctx.currentTime - nowMs / 1000;
      const L = loopUnits() * UNIT * 1000;
      let start = Math.max(loopStartMs(nowMs, loopUnits()), foxScheduledUntil);
      while (start < nowMs + 1500) {
        for (const [s, len] of sched.marks) {
          const t0 = (start + s * UNIT * 1000) / 1000 + offset;
          if (t0 < ctx.currentTime) continue;
          foxKey.gain.setTargetAtTime(1, t0, 0.004);
          foxKey.gain.setTargetAtTime(0, t0 + len * UNIT, 0.004);
        }
        start += L;
      }
      foxScheduledUntil = start;
    }
    function updateAudio(foxProx: number, clr: number, near: number, sigLvl: number, sigOn: boolean) {
      if (!ctx || ctx.state !== 'running') return;
      const t = ctx.currentTime;
      staticGain.gain.setTargetAtTime((0.03 + 0.1 * (1 - Math.max(clr, sigLvl))) / (1 + 0.35 * near), t, 0.1);
      foxLevel.gain.setTargetAtTime(0.09 * foxProx * foxProx * (0.5 + clr * 0.5), t, 0.08);
      sigLevel.gain.setTargetAtTime(0.07 * sigLvl, t, 0.08);
      sigKey.gain.setTargetAtTime(sigOn ? 1 : 0, t, 0.004);
      const seen = new Set<string>();
      for (const p of liveOthers()) {
        const d = (p.step as number) - step;
        if (Math.abs(d) > 40) continue;
        seen.add(p.id);
        let v = peerVoices.get(p.id);
        if (!v) {
          if (peerVoices.size >= 6) continue;
          const osc = ctx.createOscillator(); osc.type = 'triangle';
          const gain = ctx.createGain(); gain.gain.value = 0;
          osc.connect(gain).connect(master); osc.start();
          v = { osc, gain }; peerVoices.set(p.id, v);
        }
        v.osc.frequency.setTargetAtTime(196 + d * 3, t, 0.08);
        v.gain.gain.setTargetAtTime(0.028 * (1 - Math.abs(d) / 41), t, 0.1);
      }
      for (const [id, v] of peerVoices) if (!seen.has(id)) { v.gain.gain.setTargetAtTime(0, t, 0.1); v.osc.stop(t + 0.5); peerVoices.delete(id); }
    }

    // ---------- waterfall ----------
    const g = els.fall.getContext('2d')!;
    const W = els.fall.width, H = els.fall.height;
    g.fillStyle = '#0f0d0b'; g.fillRect(0, 0, W, H);
    const row = g.createImageData(W, 1);
    function drawRow(foxProx: number) {
      const sources: { x: number; amp: number; col: [number, number, number] }[] = [];
      const xOf = (s: number) => (s / BAND.steps) * (W - 1);
      for (const sg of day.signals) sources.push({ x: xOf(sg.step), amp: 0.35, col: [160, 190, 230] });
      for (const p of people.values()) if (p.step !== null) sources.push({ x: xOf(p.step), amp: p.live ? 0.9 : 0.25, col: [232, 176, 74] });
      sources.push({ x: xOf(step), amp: 1, col: [229, 72, 77] });
      if (foxProx > 0 || net.live) sources.push({ x: xOf(fox.step), amp: Math.max(foxProx, net.live ? 0.6 : 0) * (keyedAt(Date.now()) ? 1 : 0.35), col: [111, 191, 142] });
      const d = row.data;
      for (let x = 0; x < W; x++) {
        const n = Math.random() * 26 + 8;
        let r = n * 0.9, gg = n * 0.75, b = n * 0.5;
        for (const s of sources) {
          const dx = x - s.x;
          const e = Math.exp(-(dx * dx) / 18) * s.amp;
          if (e > 0.01) { r += s.col[0] * e; gg += s.col[1] * e; b += s.col[2] * e; }
        }
        const i = x * 4; d[i] = Math.min(255, r); d[i + 1] = Math.min(255, gg); d[i + 2] = Math.min(255, b); d[i + 3] = 255;
      }
      g.drawImage(els.fall, 0, 0, W, H - 1, 0, 1, W, H - 1);
      g.putImageData(row, 0, 0);
    }

    // ---------- heads ----------
    const headEls = new Map<string, HTMLElement>();
    function headFor(id: string, avatar: number, hue: number) {
      let el = headEls.get(id);
      if (!el) {
        el = document.createElement('div'); el.className = 'bd-head';
        const img = document.createElement('img'); img.alt = ''; img.src = `https://noun.pics/${avatar % 1200}.svg`;
        const tag = document.createElement('b');
        el.append(img, tag); els.heads.append(el); headEls.set(id, el);
      }
      el.style.setProperty('--h', String(hue));
      return el;
    }
    function ping(id: string) { const el = headEls.get(id); if (!el) return; el.classList.remove('is-ping'); void el.offsetWidth; el.classList.add('is-ping'); }

    function renderHeads() {
      const all: { id: string; avatar: number; hue: number; step: number; ghost: boolean; mine: boolean; call: string }[] = [];
      for (const p of people.values()) if (p.step !== null) all.push({ id: p.id, avatar: p.avatar, hue: p.hue, step: p.step, ghost: !p.live, mine: false, call: callSign(p.id) });
      all.push({ id: 'me', avatar: me.avatar, hue: me.hue, step, ghost: false, mine: true, call: 'YOU' });
      all.sort((a, b) => a.step - b.step);
      const keep = new Set<string>();
      const stack: number[] = [];
      for (const p of all) {
        keep.add(p.id);
        const el = headFor(p.id, p.avatar, p.hue);
        if (p.mine && me.avatar) (el.firstChild as HTMLImageElement).src = `https://noun.pics/${me.avatar % 1200}.svg`;
        let lane = 0;
        while (stack[lane] !== undefined && p.step - stack[lane] < 9) lane++;
        stack[lane] = p.step;
        el.style.left = `${(p.step / BAND.steps) * 100}%`;
        el.style.bottom = `${6 + Math.min(lane, 2) * 46}px`;
        el.classList.toggle('is-ghost', p.ghost);
        el.classList.toggle('is-me', p.mine);
        (el.lastChild as HTMLElement).textContent = p.call;
        (el.lastChild as HTMLElement).hidden = !(p.mine || Math.abs(p.step - step) <= BAND.nearSteps);
      }
      for (const [id, el] of headEls) if (!keep.has(id)) { el.remove(); headEls.delete(id); }
    }

    // ---------- lists ----------
    function ago(t: number) {
      const s = Math.max(1, Math.round((Date.now() - t) / 1000));
      if (s < 60) return 'just now';
      const m = Math.round(s / 60); if (m < 60) return `${m} min ago`;
      const h = Math.round(m / 60); return `${h} hr ago`;
    }

    let peopleSig = '';
    function renderPeople() {
      const rows = [...people.values()].filter((p) => p.step !== null).sort((a, b) => Number(b.live) - Number(a.live) || b.at - a.at).slice(0, 14);
      const sig = rows.map((p) => `${p.id}:${p.step}:${p.live}`).join('|') + `|me:${step}:${me.id}`;
      if (sig === peopleSig) return;
      peopleSig = sig;
      els.people.replaceChildren();
      const mk = (p: { id: string; avatar: number; hue: number; step: number; live: boolean }, mine: boolean) => {
        const li = document.createElement('li');
        li.classList.toggle('is-ghost', !p.live); li.classList.toggle('is-me', mine);
        const btn = document.createElement('button'); btn.type = 'button';
        btn.style.setProperty('--h', String(p.hue));
        const img = document.createElement('img'); img.alt = ''; img.src = `https://noun.pics/${p.avatar % 1200}.svg`; img.width = 28; img.height = 28;
        const w = document.createElement('span');
        const b = document.createElement('b'); b.textContent = mine ? `${me.call} (you)` : callSign(p.id);
        const small = document.createElement('small'); small.textContent = mine ? 'here' : p.live ? (Math.abs(p.step - step) <= BAND.nearSteps ? 'next to you' : 'on the band now') : `tuned in ${ago(people.get(p.id)?.at ?? Date.now())}`;
        w.append(b, small);
        const code = document.createElement('code'); code.textContent = formatMhz(p.step);
        btn.append(img, w, code);
        if (!mine) btn.addEventListener('click', () => { tune(p.step + (p.step >= BAND.steps ? -1 : 1)); note(`Parked next to ${callSign(p.id)}.`); });
        li.append(btn); return li;
      };
      if (me.id) els.people.append(mk({ id: me.id, avatar: me.avatar, hue: me.hue, step, live: true }, true));
      for (const p of rows) els.people.append(mk({ ...p, step: p.step as number }, false));
      if (!rows.length) { const li = document.createElement('li'); li.className = 'bd-muted'; li.textContent = 'Just you right now. Leave a signal, copy the invite, or come back for the Net at 9.'; els.people.append(li); }
    }

    function renderFinds() {
      const copies = Math.max(day.fox.copies, 0);
      els.foxCount.textContent = `Fox No. ${pad3(foxNumber(fox.date))} · ${SEASON.name}${copies ? ` · copied by ${copies} today` : ''}`;
      const recent = [
        ...finds.filter((f) => f.at > Date.now() - 24 * 3600_000).map((f) => ({ call: f.call, at: f.at })),
        ...day.fox.recent.map((r) => ({ call: r.call, at: Date.parse(r.at) })),
      ];
      const seen = new Set<string>();
      const list = recent.sort((a, b) => b.at - a.at).filter((r) => (seen.has(r.call) ? false : (seen.add(r.call), true))).slice(0, 5);
      els.finds.replaceChildren(...list.map((f) => { const li = document.createElement('li'); li.textContent = `✦ ${f.call} copied the fox · ${ago(f.at)}`; return li; }));
      els.foxStatus.textContent = foundToday ? 'You copied today’s fox. It moves at midnight in El Segundo.' : list.length ? 'Others copied it today. Follow the crowd, or wait for the Net.' : 'Not found by you yet today.';
    }

    let signalsSig = '';
    function renderSignals() {
      els.sigFreq.textContent = formatMhz(step);
      const sig = day.signals.map((s) => `${s.id}:${s.step}:${s.heard}`).join('|');
      if (sig === signalsSig) return;
      signalsSig = sig;
      const mine = day.signals.find((s) => s.mine);
      if (mine) els.sigStatus.textContent = `Your signal “${mine.text}” is keying on ${formatMhz(mine.step)} MHz · heard by ${mine.heard}. Key again to move it.`;
      const rows = [...day.signals].sort((a, b) => a.step - b.step).slice(0, 12);
      els.signals.replaceChildren(...rows.map((s) => {
        const li = document.createElement('li');
        const b = document.createElement('button'); b.type = 'button';
        const l = document.createElement('span'); l.textContent = s.mine ? `${s.call} (you)` : s.call; if (s.mine) l.className = 'is-mine';
        const copied = hasCard(`signal:${s.id}`);
        const r = document.createElement('code'); r.textContent = `${formatMhz(s.step)}${copied ? ' ✓' : ''}`;
        b.append(l, r);
        b.title = s.mine ? 'Your signal' : copied ? `Copied: ${s.text}` : 'Tune to this signal';
        b.addEventListener('click', () => { tune(s.step); note(s.mine ? 'Your own station.' : `Tuned to ${s.call}’s signal. Hold steady to copy it.`); });
        li.append(b); return li;
      }));
      if (!rows.length) { const li = document.createElement('li'); li.className = 'bd-muted'; li.textContent = 'No signals on the air yet today. Be the first station.'; els.signals.append(li); }
    }

    els.sigForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = els.sigText.value.toUpperCase().replace(/[^A-Z0-9 ]/g, '').replace(/\s+/g, ' ').trim().slice(0, 24);
      if (!text) { els.sigStatus.textContent = 'Type a few words first. Letters, numbers and spaces.'; return; }
      els.sigStatus.textContent = 'Keying…';
      const res = await api({ action: 'signal', step, text });
      if (res.ok) { els.sigText.value = ''; signalsSig = ''; renderSignals(); floatAt('me', '✦'); sendReaction('✦'); note(`Your signal is on the air at ${formatMhz(step)} MHz until midnight.`); }
      else els.sigStatus.textContent = res.error || 'Could not key that. Try again.';
    });
    els.sigText.addEventListener('input', () => { const v = els.sigText.value.toUpperCase().replace(/[^A-Z0-9 ]/g, ''); if (v !== els.sigText.value) els.sigText.value = v; });

    // ---------- the Nightly Net ----------
    els.netTune.addEventListener('click', () => { tune(NET.step); note('Parked on 7.200, the Net frequency.'); });
    els.netCal.addEventListener('click', () => {
      const blob = new Blob([netIcs()], { type: 'text/calendar' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'the-nightly-net.ics'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    });
    els.netCheckin.addEventListener('click', () => {
      if (!net.live || hasCard(`net:${fox.date}`)) return;
      const withList = nearStep(NET.step).map((p) => ({ call: callSign(p.id), avatar: p.avatar }));
      const card: Card = {
        key: `net:${fox.date}`, kind: 'net', date: fox.date, mhz: formatMhz(NET.step), message: `ROLL CALL ${withList.length + 1} ON THE NET`,
        call: me.call, avatar: me.avatar, with: withList, at: Date.now(), stamp: GOLD_STAMP, gold: true,
      };
      cards.push(card); saveCards();
      api({ action: 'net' });
      sendReaction('✦'); floatAt('me', '✦');
      renderAlbum(); openCard(card);
    });
    function renderNet() {
      net = netState();
      els.net.classList.toggle('is-live', net.live);
      const onNet = Math.abs(step - NET.step) <= BAND.nearSteps;
      const checked = hasCard(`net:${fox.date}`);
      if (net.live) {
        els.netText.textContent = `ON AIR · ${formatWait(net.minutesLeft)} left · net control: tonight’s fox is on ${fox.mhz} MHz · ${Math.max(day.net.checkins, checked ? 1 : 0)} checked in`;
        els.netCheckin.hidden = false;
        els.netCheckin.disabled = checked || !onNet;
        els.netCheckin.textContent = checked ? 'Checked in ✓' : onNet ? 'Check in' : 'Tune to 7.200 to check in';
      } else {
        els.netText.textContent = `9:00 PM in El Segundo on 7.200 MHz · in ${formatWait(net.minutesUntil)} · net control calls the fox, everyone copies it together, every card is gold`;
        els.netCheckin.hidden = true;
      }
    }

    // ---------- waves ----------
    let lastWave = 0;
    function floatAt(id: string, emoji: string) {
      const el = headEls.get(id);
      if (!el) return;
      const f = document.createElement('span');
      f.className = 'bd-float';
      f.textContent = emoji;
      f.style.left = el.style.left;
      f.style.bottom = `${parseFloat(el.style.bottom || '6') + 30}px`;
      els.heads.append(f);
      setTimeout(() => f.remove(), 1900);
    }
    function blip(offset: number) {
      if (!ctx || ctx.state !== 'running') return;
      const o = ctx.createOscillator(); const gn = ctx.createGain(); const t = ctx.currentTime;
      o.type = 'sine'; o.frequency.value = 880 + offset * 6;
      gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(0.05, t + 0.01); gn.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
      o.connect(gn).connect(master); o.start(t); o.stop(t + 0.4);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-react]').forEach((b) => b.addEventListener('click', () => {
      const now = Date.now();
      if (now - lastWave < 350) return;
      lastWave = now;
      const emoji = b.dataset.react || '♥';
      floatAt('me', emoji);
      blip(0);
      sendReaction(emoji);
    }));

    // ---------- the tape ----------
    function renderTape(mode: 'fox' | 'signal' | 'none', text: string, shown: number, clr: number, foxProx: number, helpers: number, from = '') {
      const msg = mode === 'none' ? fox.message : text;
      const n = mode === 'none' ? (foundToday ? msg.length : 0) : Math.floor(shown);
      const frag = document.createDocumentFragment();
      if (mode === 'signal') { const s = document.createElement('span'); s.className = 'dim'; s.textContent = `${from} ▸ `; frag.append(s); }
      for (let i = 0; i < msg.length; i++) {
        const ch = msg[i];
        if (i < n) frag.append(ch === ' ' ? ' ' : ch);
        else { const s = document.createElement('span'); s.className = 'dim'; s.textContent = ch === ' ' ? ' ' : '·'; frag.append(s); }
      }
      els.tape.replaceChildren(frag);
      els.tapeBox.classList.toggle('is-found', mode === 'fox' ? foundToday : mode === 'signal' ? n >= msg.length : foundToday);
      if (mode === 'signal') els.tapeNote.textContent = n >= msg.length ? `Copied ${from}’s signal. The contact card is in your album.` : `A listener’s signal from ${from}. Hold steady to copy it.`;
      else if (foundToday) els.tapeNote.textContent = 'Copied. Your card is in the album. Stick around: the next person here copies faster with you parked on it.';
      else if (clr >= 0.5) els.tapeNote.textContent = helpers ? `Copying: ${helpers} other${helpers === 1 ? '' : 's'} next to the fox clear the static.` : 'Copying. Hold steady. Company would clear it faster.';
      else if (foxProx > 0.6) els.tapeNote.textContent = 'Very close. Fine-tune one step at a time.';
      else if (foxProx > 0) els.tapeNote.textContent = 'Warmer. The FOX meter is picking it up.';
      else els.tapeNote.textContent = net.live ? `The Net is on. Net control says the fox is on ${fox.mhz} MHz.` : 'Sweep the dial. The FOX meter wakes up within a megahertz. Blue traces are listener signals.';
    }

    // ---------- keepsakes ----------
    function foundFox() {
      foundToday = true;
      const withList = nearStep(fox.step).map((p) => ({ call: callSign(p.id), avatar: p.avatar }));
      const gold = isGold(withList.length, net.live);
      const card: Card = {
        key: `fox:${fox.date}`, kind: 'fox', date: fox.date, mhz: fox.mhz, message: fox.message, call: me.call, avatar: me.avatar,
        with: withList, at: Date.now(), no: foxNumber(fox.date), stamp: stampFor(fox.date, gold), gold,
      };
      cards = [...cards.filter((c) => c.key !== card.key), card];
      saveCards();
      send('bell', step);
      api({ action: 'fox', with: withList.length });
      renderAlbum(); renderFinds();
      if (ctx && ctx.state === 'running') chime();
      openCard(card);
    }
    function copiedSignal(sg: Signal) {
      const card: Card = {
        key: `signal:${sg.id}`, kind: 'signal', date: fox.date, mhz: formatMhz(sg.step), message: sg.text, call: me.call, avatar: me.avatar,
        with: [{ call: sg.call, avatar: sg.avatar }], at: Date.now(), stamp: 1 + (hash32(sg.call) % 9), from: sg.call,
      };
      cards.push(card); saveCards();
      api({ action: 'heard', id: sg.id });
      signalsSig = ''; renderSignals(); renderAlbum();
      if (ctx && ctx.state === 'running') chime();
      toast(`Contact: you copied ${sg.call}. The card is in your album.`);
    }
    function chime() {
      if (!ctx) return;
      [659.25, 783.99, 987.77, 1318.5].forEach((f, i) => {
        const o = ctx!.createOscillator(); const gn = ctx!.createGain(); const t = ctx!.currentTime + i * 0.12;
        o.frequency.value = f; gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(0.08, t + 0.01); gn.gain.exponentialRampToValueAtTime(0.0001, t + 1.2);
        o.connect(gn).connect(master); o.start(t); o.stop(t + 1.3);
      });
    }

    const stampSrc = (n: number) => `/images/band/stamps/stamp-${String(n).padStart(2, '0')}.jpg`;
    const imgCache = new Map<string, Promise<HTMLImageElement | null>>();
    function loadImg(src: string, cors = false) {
      if (!imgCache.has(src)) imgCache.set(src, new Promise((res) => {
        const img = new Image(); if (cors) img.crossOrigin = 'anonymous';
        img.onload = () => res(img); img.onerror = () => res(null); img.src = src;
      }));
      return imgCache.get(src)!;
    }
    const kindLabel = (c: Card) => c.kind === 'net' ? 'NET CHECK-IN' : c.kind === 'signal' ? 'SIGNAL QSL' : `FOX No. ${pad3(c.no ?? foxNumber(c.date))}`;
    const prettyDate = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();

    async function drawCard(c: Card) {
      const cv = els.qslCanvas, q = cv.getContext('2d')!;
      const w = cv.width, h = cv.height;
      try { await Promise.all([document.fonts.load('40px "Special Elite"'), document.fonts.load('40px Caveat')]); } catch { /* system fonts */ }
      const [bg, stamp] = await Promise.all([loadImg('/images/band/qsl.jpg'), loadImg(stampSrc(c.stamp ?? stampFor(c.date, !!c.gold)))]);
      q.fillStyle = '#fbeed2'; q.fillRect(0, 0, w, h);
      if (bg) q.drawImage(bg, 0, 0, w, h);
      const ink = '#1d1610', amber = '#9a5d16', type = '"Special Elite", "Courier New", monospace';
      const x = 600;
      if (c.gold) {
        const grad = q.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#b8892c'); grad.addColorStop(0.35, '#f6dc8a'); grad.addColorStop(0.55, '#b8892c'); grad.addColorStop(1, '#f1d27a');
        q.strokeStyle = grad; q.lineWidth = 18; q.strokeRect(22, 22, w - 44, h - 44);
        q.fillStyle = grad; q.font = `700 22px ${type}`; q.fillText(c.kind === 'net' ? '✦ NET EDITION ✦' : '✦ GATHERING EDITION ✦', x + 4, 78);
      }
      // stamp, slightly crooked, then the postmark over its corner
      if (stamp) {
        q.save(); q.translate(1332, 190); q.rotate(0.05);
        q.shadowColor = 'rgba(60,40,10,.25)'; q.shadowBlur = 8; q.shadowOffsetY = 3;
        q.drawImage(stamp, -115, -115, 230, 230); q.restore();
      }
      postmark(q, 1170, 240, c);
      q.fillStyle = ink; q.textBaseline = 'alphabetic';
      q.font = '700 150px Georgia, "Times New Roman", serif'; q.fillText('QSL', x, 230);
      q.fillStyle = amber; q.font = `24px ${type}`; q.fillText(`${kindLabel(c)} · ${SEASON.name.toUpperCase()} · THE BAND`, x + 4, 276);
      q.fillStyle = ink; q.font = `30px ${type}`;
      q.fillText(`FROM ${c.call}`, x + 4, 336);
      q.fillText(c.kind === 'signal' ? `TO   ${c.from ?? 'A LISTENER'} ON ${c.mhz} MHz` : `TO   EVERYONE ON ${c.mhz} MHz`, x + 4, 378);
      const cells: [string, string][] = [['DATE', c.date], ['TIME PT', new Date(c.at).toLocaleTimeString('en-US', { timeZone: 'America/Los_Angeles', hour: 'numeric', minute: '2-digit' })], ['MHz', c.mhz], ['MODE', 'CW']];
      const gy = 410, cw = 212, ch = 88;
      q.strokeStyle = ink; q.lineWidth = 2;
      cells.forEach(([k, v], i) => {
        q.strokeRect(x + i * cw, gy, cw, ch);
        q.fillStyle = amber; q.font = `18px ${type}`; q.fillText(k, x + i * cw + 14, gy + 30);
        q.fillStyle = ink; q.font = `28px ${type}`; q.fillText(v, x + i * cw + 14, gy + 70);
      });
      q.fillStyle = amber; q.font = `20px ${type}`; q.fillText(c.kind === 'signal' ? 'SIGNAL COPIED' : c.kind === 'net' ? 'ON THE NET' : 'FOX COPIED', x + 4, 560);
      q.fillStyle = ink; q.font = `44px ${type}`;
      wrap(q, `“${c.message}”`, x + 4, 612, 860, 52);
      q.fillStyle = amber; q.font = `20px ${type}`;
      q.fillText(c.kind === 'signal' ? 'A CONTACT BETWEEN' : c.with.length ? `HEARD WITH ${c.with.length}` : 'HEARD SOLO', x + 4, 736);
      const heads = [{ call: c.call, avatar: c.avatar ?? me.avatar }, ...c.with].slice(0, 8);
      const imgs = await Promise.all(heads.map((p) => loadImg(`https://noun.pics/${p.avatar % 1200}.svg`, true)));
      heads.forEach((p, i) => {
        const hx = x + 4 + i * 106, hy = 752, img = imgs[i];
        q.save(); q.beginPath(); q.arc(hx + 42, hy + 42, 42, 0, Math.PI * 2); q.closePath(); q.fillStyle = '#e9dcc0'; q.fill(); q.clip();
        if (img) q.drawImage(img, hx, hy, 84, 84);
        q.restore();
        q.fillStyle = ink; q.font = `14px ${type}`; q.fillText(p.call, hx + 2, hy + 104);
      });
      if (c.note) {
        q.save(); q.translate(x + 4, 928); q.rotate(-0.02);
        q.fillStyle = '#2f4f86'; q.font = '46px Caveat, "Bradley Hand", cursive'; q.fillText(c.note, 0, 0); q.restore();
      }
      q.fillStyle = ink; q.font = `20px ${type}`; q.fillText(c.tx ? `73 · KEPT ON TEZOS · ${c.tx.slice(0, 12)}…` : '73 · POINTCAST.XYZ/BAND', x + 4, 975);
    }
    function postmark(q: CanvasRenderingContext2D, cx: number, cy: number, c: Card) {
      q.save(); q.translate(cx, cy); q.rotate(-0.18);
      q.strokeStyle = 'rgba(40,30,60,.55)'; q.fillStyle = 'rgba(40,30,60,.6)'; q.lineWidth = 3;
      q.beginPath(); q.arc(0, 0, 92, 0, Math.PI * 2); q.stroke();
      q.beginPath(); q.arc(0, 0, 70, 0, Math.PI * 2); q.stroke();
      q.font = '17px "Special Elite", monospace'; q.textAlign = 'center';
      const ring = 'EL SEGUNDO · THE BAND · ';
      for (let i = 0; i < ring.length * 2; i++) {
        const a = (i / (ring.length * 2)) * Math.PI * 2;
        q.save(); q.rotate(a); q.fillText(ring[i % ring.length], 0, -76); q.restore();
      }
      q.font = '19px "Special Elite", monospace';
      const [mon, dd, yyyy] = prettyDate(c.date).replace(',', '').split(' ');
      q.fillText(`${mon} ${dd}`, 0, -6); q.fillText(yyyy, 0, 18);
      q.fillText(`${c.mhz}`, 0, 42);
      for (let i = 0; i < 5; i++) {
        q.beginPath();
        for (let xx = 100; xx < 330; xx += 6) q.lineTo(xx, -40 + i * 20 + Math.sin(xx / 14) * 5);
        q.stroke();
      }
      q.restore();
    }
    function wrap(q: CanvasRenderingContext2D, text: string, x: number, y: number, max: number, lh: number) {
      let line = ''; let yy = y;
      for (const word of text.split(' ')) {
        const test = line ? `${line} ${word}` : word;
        if (q.measureText(test).width > max && line) { q.fillText(line, x, yy); line = word; yy += lh; } else line = test;
      }
      q.fillText(line, x, yy);
    }

    let current: Card | null = null;
    async function openCard(c: Card) {
      current = c;
      els.qslTitle.textContent = c.kind === 'net' ? 'Net check-in — you were there' : c.kind === 'signal' ? 'Contact — you copied a listener' : `QSL — Fox No. ${pad3(c.no ?? foxNumber(c.date))} copied`;
      els.qslNote.value = c.note || '';
      els.qslStatus.textContent = c.tx ? `Kept on Tezos · ${c.tx}` : c.gold ? 'A gold card. Those only come from the Net or a gathering of five.' : '';
      els.qslChain.disabled = !!c.tx;
      els.qslChain.textContent = c.tx ? 'Kept on Tezos ✓' : 'Keep forever on Tezos';
      els.qslShare.disabled = false;
      await drawCard(c);
      if (!els.qsl.open) els.qsl.showModal();
    }
    let noteTimerQ = 0;
    els.qslNote.addEventListener('input', () => {
      if (!current) return;
      current.note = els.qslNote.value.slice(0, 60);
      clearTimeout(noteTimerQ);
      noteTimerQ = window.setTimeout(() => { saveCards(); drawCard(current!); renderAlbum(); }, 250);
    });
    els.qslClose.addEventListener('click', () => els.qsl.close());
    const cardBlob = () => new Promise<Blob | null>((res) => els.qslCanvas.toBlob(res, 'image/png'));
    const cardName = (c: Card) => `qsl-${c.kind}-${c.date}-${c.mhz}.png`;
    els.qslSave.addEventListener('click', async () => {
      const blob = await cardBlob(); if (!blob || !current) return;
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = cardName(current); a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    });
    els.qslShareFile.addEventListener('click', async () => {
      const blob = await cardBlob(); if (!blob || !current) return;
      const file = new File([blob], cardName(current), { type: 'image/png' });
      const data: ShareData = { files: [file], title: 'The Band · QSL', text: `${kindLabel(current)} · ${current.mhz} MHz · pointcast.xyz/band` };
      if (navigator.canShare?.(data)) { try { await navigator.share(data); } catch { /* dismissed */ } }
      else els.qslSave.click();
    });
    els.qslShare.addEventListener('click', () => {
      if (!current) return;
      const n = current.with.length;
      const text = current.kind === 'net'
        ? `Checked in to the Nightly Net on The Band with ${n} other${n === 1 ? '' : 's'}. Every night at 9 PT on 7.200. pointcast.xyz/band #band`
        : current.kind === 'signal'
          ? `Made contact with ${current.from} on The Band. Leave a signal of your own: pointcast.xyz/band #band`
          : `Copied Fox No. ${pad3(current.no ?? 1)} on The Band${n ? ` with ${n} other${n === 1 ? '' : 's'} on the dial` : ''}. pointcast.xyz/band #band`;
      window.dispatchEvent(new CustomEvent('pc:shortwave:say', { detail: { text, via: 'page' } }));
      els.qslStatus.textContent = 'Sent to Shortwave.';
      els.qslShare.disabled = true;
    });
    els.qslChain.addEventListener('click', async () => {
      if (!current || current.tx) return;
      const card = current;
      els.qslChain.disabled = true;
      els.qslStatus.textContent = 'Opening your Tezos wallet…';
      try {
        const tz = await import('../lib/tezos');
        const { SHORTWAVE } = await import('../lib/shortwave');
        await tz.connectKukai();
        els.qslStatus.textContent = 'Approve the cast in your wallet. It writes this card’s line on the Shortwave tower, for good.';
        const tezos = await tz.tezosClient();
        const contract = await tezos.wallet.at(SHORTWAVE.tower);
        const op = await contract.methodsObject.default({ kind: 0, body: tz.utf8ToHex(towerLine(card)) }).send();
        card.tx = op.opHash;
        saveCards(); renderAlbum();
        els.qslStatus.textContent = `Sent · ${op.opHash.slice(0, 12)}… waiting for a block.`;
        await op.confirmation(1);
        els.qslStatus.textContent = `Kept on Tezos, for good · ${op.opHash}`;
        els.qslChain.textContent = 'Kept on Tezos ✓';
        if (current === card) drawCard(card);
      } catch (e) {
        const m = String((e as Error)?.message || e || '');
        els.qslStatus.textContent = /abort|reject|cancel/i.test(m) ? 'Cancelled in the wallet. The card is still in your album.' : /balance/i.test(m) ? 'Not enough tez for the network fee.' : `Could not keep it on Tezos: ${m.slice(0, 90)}`;
        els.qslChain.disabled = false;
      }
    });

    // ---------- the album ----------
    function slotFor(c: Card, i: number) {
      const li = document.createElement('li');
      li.className = 'bd-slot'; li.style.setProperty('--tilt', `${((hash32(c.key) % 7) - 3) * 0.7}deg`);
      li.classList.toggle('is-gold', !!c.gold); li.classList.toggle('is-chain', !!c.tx);
      const b = document.createElement('button'); b.type = 'button';
      b.setAttribute('aria-label', `${kindLabel(c)}, ${c.date}, ${c.message}`);
      const img = document.createElement('img'); img.alt = ''; img.loading = 'lazy'; img.src = stampSrc(c.stamp ?? stampFor(c.date, !!c.gold));
      const t = document.createElement('b'); t.textContent = kindLabel(c);
      const s = document.createElement('small'); s.textContent = `${prettyDate(c.date)} · ${c.mhz}${c.with.length ? ` · +${c.with.length}` : ''}`;
      const n = document.createElement('em'); n.textContent = c.note || (c.kind === 'signal' ? `from ${c.from}` : c.message.toLowerCase());
      b.append(img, t, s, n);
      b.addEventListener('click', () => openCard(c));
      li.append(b);
      return li;
    }
    function streak(): number {
      const days = new Set(cards.filter((c) => c.kind === 'fox').map((c) => c.date));
      let n = 0;
      const d = new Date();
      if (!days.has(townDate(d))) d.setTime(d.getTime() - 86_400_000);
      while (days.has(townDate(d))) { n++; d.setTime(d.getTime() - 86_400_000); }
      return n;
    }
    function renderAlbum() {
      const today = townDate();
      const total = Math.max(1, daysBetween(SEASON.start, today) + 1);
      const foxCards = new Map(cards.filter((c) => c.kind === 'fox' && c.date >= SEASON.start).map((c) => [c.date, c]));
      // Oldest first, like pages in an album; a few blank pages ahead for the foxes to come.
      const first = Math.max(1, total - 29);
      const lastNo = Math.max(total + 2, first + 7);
      const slots: HTMLElement[] = [];
      for (let no = first; no <= lastNo; no++) {
        const date = new Date(Date.parse(`${SEASON.start}T12:00:00Z`) + (no - 1) * 86_400_000).toISOString().slice(0, 10);
        const c = foxCards.get(date);
        if (c) { slots.push(slotFor(c, no)); continue; }
        const li = document.createElement('li'); li.className = 'bd-slot is-empty';
        li.classList.toggle('is-today', date === today);
        li.textContent = no > total ? `No. ${pad3(no)} · still to come` : date === today ? `No. ${pad3(no)} · today · still on the air` : `No. ${pad3(no)} · ${prettyDate(date)} · the one that got away`;
        slots.push(li);
      }
      els.albumFoxes.replaceChildren(...slots);
      const contacts = cards.filter((c) => c.kind !== 'fox').sort((a, b) => b.at - a.at).slice(0, 60);
      if (contacts.length) els.albumContacts.replaceChildren(...contacts.map(slotFor));
      else { const li = document.createElement('li'); li.className = 'bd-album__empty'; li.textContent = 'Copy someone’s signal or check in to the Net, and the card lands here.'; els.albumContacts.replaceChildren(li); }
      const got = foxCards.size;
      const run = streak();
      const golds = cards.filter((c) => c.gold).length;
      els.albumCount.textContent = `${got} of ${total} fox${total === 1 ? '' : 'es'} collected · ${contacts.length} contact${contacts.length === 1 ? '' : 's'}${golds ? ` · ${golds} gold` : ''}${run > 1 ? ` · ${run}-day streak` : ''}`;
    }

    // ---------- loop ----------
    let last = performance.now();
    let frame = 0;
    function tick(now: number) {
      const dt = Math.min(0.25, (now - last) / 1000); last = now; frame++;
      const today = townDate();
      if (today !== fox.date) { fox = foxOf(today); sched = morseSchedule(fox.message); foundToday = hasCard(`fox:${fox.date}`); revealed = foundToday ? fox.message.length : 0; foxScheduledUntil = 0; fetchDay(); renderAlbum(); }
      const dist = step - fox.step;
      const foxProx = proximity(dist);
      const helpers = nearStep(fox.step).length;
      const clr = clarity(dist, helpers + (net.live ? 1 : 0));
      const nearMe = nearStep(step).length;
      if (!foundToday) { revealed = advanceCopy(revealed, clr, dt, fox.message.length); if (revealed >= fox.message.length) foundFox(); }

      // Nearest listener signal within reach (the fox wins when both are close).
      let sig: Signal | null = null; let sigLvl = 0;
      if (foxProx <= 0) {
        for (const s of day.signals) {
          if (s.mine) continue;
          const lvl = signalClarity(s.step - step);
          if (lvl > sigLvl) { sigLvl = lvl; sig = s; }
        }
      }
      let sigOn = false;
      if (sig) {
        if (!sigSched || sigSched.id !== sig.id) { const m = morseSchedule(sig.text); sigSched = { id: sig.id, marks: m.marks, units: m.units + 16 }; }
        sigOn = keyedIn(sigSched.marks, sigSched.units, Date.now());
        if (!hasCard(`signal:${sig.id}`)) {
          const r = advanceCopy(sigRevealed.get(sig.id) || 0, sigLvl, dt, sig.text.length);
          sigRevealed.set(sig.id, r);
          if (r >= sig.text.length) copiedSignal(sig);
        } else sigRevealed.set(sig.id, sig.text.length);
      }

      els.freq.textContent = formatMhz(step);
      els.needle.style.left = `${(step / BAND.steps) * 100}%`;
      els.dial.setAttribute('aria-valuenow', String(formatMhz(step)));
      els.dial.setAttribute('aria-valuetext', `${formatMhz(step)} megahertz`);
      els.smeter.style.width = `${Math.round(foxProx * 100)}%`;
      els.sread.textContent = `S${Math.round(foxProx * 9)}`;
      els.clear.style.width = `${Math.round(Math.max(clr, sigLvl) * 100)}%`;
      els.helpers.textContent = helpers ? `+${helpers}` : 'solo';
      els.lamp.classList.toggle('on', (foxProx > 0 && keyedAt(Date.now())) || sigOn);
      els.on.textContent = String(liveOthers().length + 1);
      els.near.textContent = String(nearMe);

      if (!document.hidden) drawRow(foxProx);
      if (frame % 3 === 0) {
        renderHeads();
        if (sig && foxProx <= 0) renderTape('signal', sig.text, sigRevealed.get(sig.id) || 0, clr, foxProx, helpers, sig.call);
        else renderTape(foxProx > 0 || foundToday ? 'fox' : 'none', fox.message, revealed, clr, foxProx, helpers);
      }
      if (frame % 30 === 0) { renderPeople(); renderNet(); els.sigFreq.textContent = formatMhz(step); }
      if (frame % 6 === 0) { scheduleFox(); updateAudio(foxProx, clr, nearMe, sigLvl, sigOn); }
      requestAnimationFrame(tick);
    }

    renderAlbum(); renderFinds(); renderPeople(); renderSignals(); renderNet();
    fetchDay();
    connect();
    requestAnimationFrame(tick);
    setInterval(() => { if (document.hidden) renderNet(); }, 30000);
    addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.closest?.('input,textarea,[contenteditable]')) return;
      if (e.key === ' ' && e.target === document.body) { e.preventDefault(); setAir(els.air.getAttribute('aria-pressed') !== 'true'); }
    });
  }
</script>
