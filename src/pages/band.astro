---
import BlockLayout from '../layouts/BlockLayout.astro';
import { BAND } from '../lib/band';

const title = 'The Band · tune in together · PointCast';
const description =
  'A shortwave dial everyone shares. Park next to someone and your carriers hum together. Somewhere on the band today a fox is keying a message in Morse — alone you barely hear it, together the static clears. Find it and everyone near gets a QSL card.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'The Band',
  url: 'https://pointcast.xyz/band',
  description,
  applicationCategory: 'GameApplication',
  isAccessibleForFree: true,
};

const labels = [3, 4.5, 6, 7.5, 9, 10.5, 12];
---
<BlockLayout title={title} description={description} image="/images/band/og.png" jsonLd={jsonLd} hideAds showNetworkStrip={false}>
  <main class="bd" data-band data-room={BAND.room}>
    <section class="bd-hero">
      <img class="bd-hero__art" src="/images/band/hero.jpg" alt="" width="1536" height="1024" />
      <div class="bd-hero__copy">
        <p class="bd-kicker">THE BAND <span>·</span> A SHORTWAVE HANGOUT</p>
        <h1>Tune in together.</h1>
        <p class="bd-lede">Everyone on this page is somewhere on the dial. Park next to someone and your carriers hum together. Somewhere on the band today a fox is keying a message in Morse. Alone you can barely copy it. Together the static clears.</p>
        <div class="bd-hero__actions">
          <button type="button" class="bd-btn bd-btn--air" data-air aria-pressed="false"><i></i> ON AIR</button>
          <button type="button" class="bd-btn" data-goto>Go to someone</button>
          <button type="button" class="bd-btn" data-invite>Copy invite</button>
        </div>
        <p class="bd-note" data-note role="status">Sound starts with ON AIR. The dial works silently too.</p>
      </div>
    </section>

    <section class="bd-rx" aria-label="Receiver">
      <header class="bd-rx__head">
        <div class="bd-rx__id">
          <img data-me-noun src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="40" height="40" />
          <div><b data-me-call>PC?-···</b><small data-link>tuning in…</small></div>
        </div>
        <div class="bd-freq" aria-live="off"><span data-freq>7.200</span><small>MHz</small></div>
        <dl class="bd-counts">
          <div><dd data-count-on>—</dd><dt>on the band</dt></div>
          <div><dd data-count-near>0</dd><dt>next to you</dt></div>
        </dl>
      </header>

      <div class="bd-scope">
        <canvas class="bd-fall" data-fall width="1440" height="150" aria-hidden="true"></canvas>
        <div class="bd-heads" data-heads aria-hidden="true"></div>
      </div>

      <div class="bd-dial" data-dial role="slider" tabindex="0" aria-label="Frequency" aria-valuemin={BAND.minMhz} aria-valuemax={BAND.maxMhz} aria-valuenow="7.2" aria-valuetext="7.200 megahertz">
        <div class="bd-dial__glass"></div>
        <div class="bd-dial__needle" data-needle></div>
      </div>
      <div class="bd-scale" aria-hidden="true">{labels.map((l) => <span style={`left:${((l - BAND.minMhz) / (BAND.maxMhz - BAND.minMhz)) * 100}%`}>{l}</span>)}</div>

      <div class="bd-controls">
        <div class="bd-fine" role="group" aria-label="Fine tune">
          <button type="button" data-nudge="-40" aria-label="Down one megahertz">◀◀</button>
          <button type="button" data-nudge="-1" aria-label="Down 25 kilohertz">◀</button>
          <button type="button" data-nudge="1" aria-label="Up 25 kilohertz">▶</button>
          <button type="button" data-nudge="40" aria-label="Up one megahertz">▶▶</button>
        </div>
        <div class="bd-meter" aria-label="Fox signal">
          <span>FOX</span>
          <div class="bd-meter__bar"><i data-smeter></i></div>
          <b data-sread>S0</b>
        </div>
        <div class="bd-meter" aria-label="Clarity">
          <span>CLEAR</span>
          <div class="bd-meter__bar bd-meter__bar--clear"><i data-clear></i></div>
          <b data-helpers>solo</b>
        </div>
        <div class="bd-waves" role="group" aria-label="Wave at the band">
          <span>WAVE</span>
          <button type="button" data-react="♥" aria-label="Send a heart">♥</button>
          <button type="button" data-react="☻" aria-label="Send a smile">☻</button>
          <button type="button" data-react="✦" aria-label="Send a sparkle">✦</button>
          <button type="button" data-react="🔥" aria-label="Send a fire">🔥</button>
        </div>
        <label class="bd-vol">VOL <input type="range" min="0" max="1" step="0.01" value="0.7" data-vol /></label>
      </div>

      <div class="bd-tape" aria-label="Copied from the fox">
        <span class="bd-lamp" data-lamp aria-hidden="true"></span>
        <code data-tape>· · · · · · · · · · · ·</code>
        <small data-tape-note>Sweep the dial. The FOX meter wakes up within a megahertz.</small>
      </div>
    </section>

    <div class="bd-grid">
      <section class="bd-card" aria-labelledby="bd-who">
        <h2 id="bd-who">On the band</h2>
        <ol class="bd-people" data-people><li class="bd-muted">listening for listeners…</li></ol>
        <p class="bd-small">Faded rows tuned in earlier. Tap a row to park next to them.</p>
      </section>

      <section class="bd-card bd-card--fox" aria-labelledby="bd-fox">
        <img src="/images/band/fox.jpg" alt="A small fox in headphones on a rooftop beside an antenna" width="1254" height="1254" loading="lazy" />
        <div>
          <h2 id="bd-fox">Today’s fox</h2>
          <p>Somewhere between 3 and 12 MHz. It moves at midnight in El Segundo and keys the same greeting for everyone, all day.</p>
          <p class="bd-small" data-fox-status>Not found by you yet today.</p>
          <ol class="bd-finds" data-finds></ol>
        </div>
      </section>

      <section class="bd-card" aria-labelledby="bd-log">
        <h2 id="bd-log">Your logbook <span class="bd-streak" data-streak></span></h2>
        <ol class="bd-logbook" data-logbook><li class="bd-muted">No QSL cards yet. Find a fox.</li></ol>
      </section>

      <section class="bd-card" aria-labelledby="bd-how">
        <h2 id="bd-how">How the band works</h2>
        <ul class="bd-rules">
          <li><b>The dial is a place.</b> Where you park is where you are. Everyone here sees your Noun on the band.</li>
          <li><b>Company hums.</b> Other listeners within a megahertz sound as carriers. Same frequency, one note. Close, a slow beat.</li>
          <li><b>Company clears static.</b> Alone you must be dead on the fox to copy it. Each listener parked near it widens the window.</li>
          <li><b>A QSL for everyone there.</b> Copy the whole message and the card lists every Noun who was next to the fox with you.</li>
          <li><b>Wave, don’t type.</b> Hearts and sparkles float up from your Noun for everyone on the band. Hanging out needs no words.</li>
          <li><b>No account.</b> Your call sign belongs to this browser. The band remembers only where people tuned, not who they are.</li>
        </ul>
        <p class="bd-small">Want the town square instead? <a href="/shortwave">Shortwave</a>. Want the band on another page? Press <kbd>L</kbd> for Layers.</p>
      </section>
    </div>

    <dialog class="bd-qsl" data-qsl aria-labelledby="bd-qsl-title">
      <h2 id="bd-qsl-title">QSL — contact confirmed</h2>
      <canvas data-qsl-canvas width="1536" height="1024"></canvas>
      <div class="bd-qsl__actions">
        <button type="button" class="bd-btn bd-btn--air" data-qsl-save>Save card</button>
        <button type="button" class="bd-btn" data-qsl-share>Say it on Shortwave</button>
        <button type="button" class="bd-btn" data-qsl-close>Keep listening</button>
      </div>
    </dialog>
  </main>
</BlockLayout>

<style is:global>
  .bd{--bd-ink:#1a1713;--bd-ink2:#221e19;--bd-line:#3a342b;--bd-cream:#fdf2d6;--bd-dim:#a79d8c;--bd-amber:#e8b04a;--bd-green:#6fbf8e;--bd-red:#e5484d;
    background:var(--bd-ink);color:var(--bd-cream);font:15px/1.5 "Inter Variable",Inter,system-ui,sans-serif;padding-bottom:64px;min-height:100vh}
  .bd *{box-sizing:border-box}
  .bd a{color:var(--bd-amber)}
  .bd-hero{position:relative;overflow:hidden;min-height:440px;display:flex;align-items:flex-end;border-bottom:1px solid var(--bd-line)}
  .bd-hero__art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 40%}
  .bd-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(26,23,19,.94) 0%,rgba(26,23,19,.78) 38%,rgba(26,23,19,.05) 72%),linear-gradient(0deg,rgba(26,23,19,.9),transparent 45%)}
  .bd-hero__copy{position:relative;z-index:1;max-width:560px;padding:56px 24px 40px clamp(16px,5vw,64px)}
  .bd-kicker{font:700 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.2em;color:var(--bd-amber);margin:0 0 14px}
  .bd-kicker span{color:var(--bd-dim)}
  .bd-hero h1{font:600 clamp(40px,6vw,64px)/1 "Inter Variable",Inter,system-ui,sans-serif;letter-spacing:-.02em;margin:0 0 16px}
  .bd-lede{font-size:17px;color:#e9dcc0;margin:0 0 22px;max-width:48ch}
  .bd-hero__actions{display:flex;flex-wrap:wrap;gap:10px}
  .bd-note{font-size:13px;color:var(--bd-dim);margin:14px 0 0;min-height:1.5em}
  .bd-btn{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:1px solid rgba(253,242,214,.3);border-radius:6px;font:700 12px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;color:var(--bd-cream);background:rgba(26,23,19,.6)}
  .bd-btn:hover{background:rgba(253,242,214,.12)}
  .bd-btn:focus-visible,.bd-dial:focus-visible,.bd-fine button:focus-visible,.bd-people button:focus-visible{outline:2px solid var(--bd-amber);outline-offset:2px}
  .bd-btn--air{border-color:var(--bd-amber);color:var(--bd-amber)}
  .bd-btn--air i{width:8px;height:8px;border-radius:50%;background:#6b645a}
  .bd-btn--air[aria-pressed=true]{background:var(--bd-amber);color:var(--bd-ink)}
  .bd-btn--air[aria-pressed=true] i{background:var(--bd-red);box-shadow:0 0 8px var(--bd-red)}

  .bd-rx{max-width:1180px;margin:-28px auto 0;position:relative;z-index:2;background:linear-gradient(#26211b,#1d1915);border:1px solid var(--bd-line);border-radius:10px;box-shadow:0 24px 60px rgba(0,0,0,.5);padding:18px clamp(12px,2.4vw,24px) 20px;margin-inline:clamp(12px,3vw,auto)}
  @media (min-width:1228px){.bd-rx{margin-inline:auto}}
  .bd-rx__head{display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px;margin-bottom:14px}
  .bd-rx__id{display:flex;align-items:center;gap:10px}
  .bd-rx__id img{width:40px;height:40px;border-radius:50%;background:var(--bd-ink2);border:2px solid var(--bd-amber)}
  .bd-rx__id b{display:block;font:700 14px/1.2 ui-monospace,Menlo,monospace;letter-spacing:.08em}
  .bd-rx__id small{color:var(--bd-dim);font-size:12px}
  .bd-freq{margin-left:auto;font:600 clamp(30px,4.4vw,44px)/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--bd-amber);text-shadow:0 0 18px rgba(232,176,74,.45);font-variant-numeric:tabular-nums}
  .bd-freq small{font-size:12px;color:var(--bd-dim);letter-spacing:.16em;margin-left:6px;text-shadow:none}
  .bd-counts{display:flex;gap:18px;margin:0}
  .bd-counts div{text-align:right}
  .bd-counts dd{margin:0;font:600 22px/1 ui-monospace,Menlo,monospace}
  .bd-counts dt{font-size:11px;color:var(--bd-dim);letter-spacing:.06em}

  .bd-scope{position:relative;height:150px;border-radius:6px 6px 0 0;overflow:visible;background:#0f0d0b}
  .bd-fall{display:block;width:100%;height:150px;border-radius:6px 6px 0 0;image-rendering:pixelated}
  .bd-heads{position:absolute;inset:0;pointer-events:none}
  .bd-head{position:absolute;bottom:6px;width:30px;height:30px;margin-left:-15px;border-radius:50%;background:#2b2620;border:2px solid hsl(var(--h,40) 70% 60%);box-shadow:0 0 0 3px rgba(15,13,11,.7);transition:left .35s ease,bottom .35s ease,opacity .4s}
  .bd-head img{width:100%;height:100%;border-radius:50%;display:block}
  .bd-head.is-ghost{opacity:.32;filter:grayscale(.7)}
  .bd-head.is-me{border-color:var(--bd-red);z-index:2}
  .bd-head b{position:absolute;left:50%;top:-18px;transform:translateX(-50%);font:700 9px/1 ui-monospace,Menlo,monospace;letter-spacing:.08em;color:var(--bd-cream);background:rgba(15,13,11,.8);padding:2px 4px;border-radius:3px;white-space:nowrap}
  .bd-head.is-ping{animation:bd-ping .9s ease-out}
  @keyframes bd-ping{0%{box-shadow:0 0 0 0 rgba(232,176,74,.8)}100%{box-shadow:0 0 0 18px rgba(232,176,74,0)}}

  .bd-dial{position:relative;height:56px;cursor:ew-resize;touch-action:none;border-radius:0 0 6px 6px;overflow:hidden;background:url(/images/band/dial.jpg) center/cover,#2a2016}
  .bd-dial__glass{position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(26,23,19,.85) 0 1px,transparent 1px calc(100%/90)),repeating-linear-gradient(90deg,rgba(26,23,19,.95) 0 2px,transparent 2px calc(100%/18)),linear-gradient(rgba(26,23,19,.35),rgba(26,23,19,.1) 50%,rgba(26,23,19,.5));pointer-events:none}
  .bd-dial__needle{position:absolute;top:0;bottom:0;width:3px;margin-left:-1.5px;background:var(--bd-red);box-shadow:0 0 12px var(--bd-red);pointer-events:none}
  .bd-scale{position:relative;height:22px;font:12px/22px ui-monospace,Menlo,monospace;color:var(--bd-dim)}
  .bd-scale span{position:absolute;transform:translateX(-50%)}
  .bd-scale span:first-child{transform:none}
  .bd-scale span:last-child{transform:translateX(-100%)}

  .bd-controls{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;margin-top:10px}
  .bd-fine{display:flex;gap:6px}
  .bd-fine button{all:unset;cursor:pointer;min-width:40px;height:36px;display:grid;place-items:center;border:1px solid var(--bd-line);border-radius:5px;font:700 12px ui-monospace,Menlo,monospace;color:var(--bd-cream);background:var(--bd-ink2)}
  .bd-fine button:hover{border-color:var(--bd-amber)}
  .bd-meter{display:flex;align-items:center;gap:8px;font:700 11px ui-monospace,Menlo,monospace;letter-spacing:.14em;color:var(--bd-dim)}
  .bd-meter__bar{width:clamp(90px,14vw,160px);height:10px;border-radius:5px;background:#0f0d0b;border:1px solid var(--bd-line);overflow:hidden}
  .bd-meter__bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--bd-green),var(--bd-amber) 70%,var(--bd-red));transition:width .15s}
  .bd-meter__bar--clear i{background:linear-gradient(90deg,#4d6b5a,var(--bd-green))}
  .bd-meter b{color:var(--bd-cream);min-width:5ch}
  .bd-waves{display:flex;align-items:center;gap:6px;font:700 11px ui-monospace,Menlo,monospace;letter-spacing:.14em;color:var(--bd-dim)}
  .bd-waves button{all:unset;cursor:pointer;width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--bd-line);border-radius:50%;font-size:16px;color:var(--bd-amber);background:var(--bd-ink2);transition:transform .12s}
  .bd-waves button:hover{border-color:var(--bd-amber);transform:translateY(-2px)}
  .bd-waves button:active{transform:scale(.9)}
  .bd-waves button:focus-visible{outline:2px solid var(--bd-amber);outline-offset:2px}
  .bd-float{position:absolute;margin-left:-10px;font-size:20px;line-height:1;color:var(--bd-amber);pointer-events:none;animation:bd-float 1.8s ease-out forwards;text-shadow:0 0 10px rgba(232,176,74,.6)}
  @keyframes bd-float{0%{transform:translateY(0) scale(.6);opacity:0}15%{opacity:1;transform:translateY(-10px) scale(1.1)}100%{transform:translateY(-70px) scale(1);opacity:0}}
  .bd-streak{color:var(--bd-green);margin-left:6px}
  .bd-vol{margin-left:auto;display:flex;align-items:center;gap:8px;font:700 11px ui-monospace,Menlo,monospace;letter-spacing:.14em;color:var(--bd-dim)}
  .bd-vol input{accent-color:var(--bd-amber);width:110px}

  .bd-tape{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin-top:14px;padding:12px 14px;border-radius:6px;background:#0f0d0b;border:1px dashed var(--bd-line)}
  .bd-lamp{width:14px;height:14px;border-radius:50%;background:#3a2a1a;flex:none}
  .bd-lamp.on{background:var(--bd-amber);box-shadow:0 0 14px var(--bd-amber)}
  .bd-tape code{font:600 clamp(15px,2.2vw,22px)/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.18em;color:var(--bd-amber);word-break:break-word}
  .bd-tape code .dim{color:#5b5245}
  .bd-tape small{flex-basis:100%;color:var(--bd-dim);font-size:12px}
  .bd-tape.is-found{border-style:solid;border-color:var(--bd-green)}

  .bd-grid{max-width:1180px;margin:24px auto 0;padding:0 clamp(12px,3vw,0px);display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
  @media (max-width:1228px){.bd-grid{padding:0 clamp(12px,3vw,24px)}}
  .bd-card{background:var(--bd-ink2);border:1px solid var(--bd-line);border-radius:10px;padding:16px 18px}
  .bd-card h2{font:700 12px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--bd-amber);margin:0 0 12px}
  .bd-card--fox{display:grid;grid-template-columns:112px 1fr;gap:14px;align-items:start}
  .bd-card--fox img{width:112px;height:112px;border-radius:8px;object-fit:cover}
  .bd-card p{margin:0 0 8px}
  .bd-small{font-size:12px;color:var(--bd-dim)}
  .bd-muted{color:var(--bd-dim);font-size:13px}
  .bd-people,.bd-finds,.bd-logbook{list-style:none;margin:0;padding:0;display:grid;gap:6px}
  .bd-people button{all:unset;box-sizing:border-box;cursor:pointer;width:100%;display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:10px;padding:6px 8px;border-radius:6px}
  .bd-people button:hover{background:rgba(253,242,214,.06)}
  .bd-people img{width:28px;height:28px;border-radius:50%;background:#2b2620;border:2px solid hsl(var(--h,40) 70% 60%)}
  .bd-people b{font:700 12px ui-monospace,Menlo,monospace;letter-spacing:.06em}
  .bd-people small{display:block;color:var(--bd-dim);font-size:11px}
  .bd-people code{font:600 13px ui-monospace,Menlo,monospace;color:var(--bd-amber)}
  .bd-people li.is-ghost{opacity:.45}
  .bd-people li.is-me code{color:var(--bd-red)}
  .bd-finds li{font-size:12px;color:#d7c9ad}
  .bd-logbook li{display:flex;justify-content:space-between;gap:8px;font-size:13px;border-bottom:1px solid var(--bd-line);padding-bottom:6px}
  .bd-logbook button{all:unset;cursor:pointer;color:var(--bd-amber);font:700 11px ui-monospace,Menlo,monospace;letter-spacing:.1em}
  .bd-rules{margin:0 0 10px;padding-left:18px;display:grid;gap:6px;font-size:14px;color:#e2d5ba}
  .bd kbd{font:12px ui-monospace,Menlo,monospace;border:1px solid var(--bd-line);border-radius:3px;padding:0 4px}

  .bd-qsl{border:1px solid var(--bd-line);border-radius:12px;background:var(--bd-ink);color:var(--bd-cream);padding:18px;width:min(900px,calc(100vw - 32px))}
  .bd-qsl::backdrop{background:rgba(10,8,6,.75)}
  .bd-qsl h2{font:700 12px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;color:var(--bd-green);margin:0 0 12px;text-transform:uppercase}
  .bd-qsl canvas{width:100%;height:auto;border-radius:6px;display:block}
  .bd-qsl__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}

  @media (max-width:640px){
    .bd-hero{min-height:520px}
    .bd-hero::after{background:linear-gradient(0deg,rgba(26,23,19,.97) 40%,rgba(26,23,19,.35))}
    .bd-freq{margin-left:0;order:-1;width:100%}
    .bd-counts{margin-left:auto}
    .bd-vol{margin-left:0}
    .bd-card--fox{grid-template-columns:72px 1fr}
    .bd-card--fox img{width:72px;height:72px}
  }
  @media (prefers-reduced-motion:reduce){.bd-head{transition:none}.bd-head.is-ping{animation:none}}
</style>

<script>
  import {
    BAND, advanceCopy, callSign, clarity, clampStep, foxOf, formatMhz, morseSchedule, packSeq,
    parseFreq, proximity, townDate, unpackStep,
  } from '../lib/band';

  type Listener = { id: string; avatar: number; hue: number; step: number | null; at: number; live: boolean };

  const root = document.querySelector<HTMLElement>('[data-band]');
  if (root) boot(root);

  function boot(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const els = {
      air: $<HTMLButtonElement>('[data-air]'), goto: $<HTMLButtonElement>('[data-goto]'), invite: $<HTMLButtonElement>('[data-invite]'),
      note: $('[data-note]'), meNoun: $<HTMLImageElement>('[data-me-noun]'), meCall: $('[data-me-call]'), link: $('[data-link]'),
      freq: $('[data-freq]'), on: $('[data-count-on]'), near: $('[data-count-near]'), fall: $<HTMLCanvasElement>('[data-fall]'),
      heads: $('[data-heads]'), dial: $('[data-dial]'), needle: $('[data-needle]'), smeter: $('[data-smeter]'), sread: $('[data-sread]'),
      clear: $('[data-clear]'), helpers: $('[data-helpers]'), vol: $<HTMLInputElement>('[data-vol]'), lamp: $('[data-lamp]'),
      tape: $('[data-tape]'), tapeNote: $('[data-tape-note]'), tapeBox: $('.bd-tape'), people: $('[data-people]'),
      foxStatus: $('[data-fox-status]'), streak: $('[data-streak]'), finds: $('[data-finds]'), logbook: $('[data-logbook]'),
      qsl: $<HTMLDialogElement>('[data-qsl]'), qslCanvas: $<HTMLCanvasElement>('[data-qsl-canvas]'),
      qslSave: $<HTMLButtonElement>('[data-qsl-save]'), qslShare: $<HTMLButtonElement>('[data-qsl-share]'), qslClose: $<HTMLButtonElement>('[data-qsl-close]'),
    };

    const store = {
      get<T>(key: string, fallback: T): T { try { const v = localStorage.getItem(key); return v ? JSON.parse(v) as T : fallback; } catch { return fallback; } },
      set(key: string, value: unknown) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* private window */ } },
    };

    // ---------- identity + state ----------
    let sid = store.get<string>('pc-band-sid', '');
    if (!sid) { sid = crypto.randomUUID?.() ?? String(Math.random()).slice(2); store.set('pc-band-sid', sid); }

    const params = new URLSearchParams(location.search);
    let step = parseFreq(params.get('f')) ?? store.get<number>('pc-band-step', 168);
    step = clampStep(step);

    let me = { id: '', avatar: 0, hue: 30, call: 'PC?-···' };
    const people = new Map<string, Listener>();
    let fox = foxOf(townDate());
    type LogEntry = { date: string; mhz: string; message: string; call: string; avatar?: number; with: { call: string; avatar: number }[]; at: number };
    let logbook = store.get<LogEntry[]>('pc-band-log', []);
    let revealed = 0;
    let foundToday = logbook.some((e) => e.date === fox.date);
    if (foundToday) revealed = fox.message.length;
    const finds: { call: string; at: number }[] = [];
    let heardPresence = false;

    // ---------- transport (DrumRoomV2, legacy pads) ----------
    let ws: WebSocket | null = null;
    let wsOpen = false;
    let retry = 0;
    let counter = Math.floor(Math.random() * 1000);
    let lastSent = 0;
    let pendingTune: number | null = null;

    function connect() {
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      try {
        ws = new WebSocket(`${proto}//${location.host}/api/drum/room?room=${BAND.room}&sid=${encodeURIComponent(sid)}`);
      } catch { scheduleReconnect(); return; }
      ws.addEventListener('open', () => { wsOpen = true; retry = 0; });
      ws.addEventListener('message', (e) => { try { onMessage(JSON.parse(String(e.data))); } catch { /* ignore */ } });
      ws.addEventListener('close', () => { wsOpen = false; els.link.textContent = 'reconnecting to the band…'; scheduleReconnect(); });
      ws.addEventListener('error', () => { /* close follows */ });
    }
    function scheduleReconnect() {
      retry += 1;
      if (retry > 6) { els.link.textContent = 'band is quiet · tuning solo'; return; }
      setTimeout(connect, Math.min(15000, 800 * 2 ** retry));
    }
    function send(pad: 'kick' | 'hat' | 'bell', at: number) {
      if (!ws || !wsOpen) return;
      counter += 1;
      try { ws.send(JSON.stringify({ v: 1, type: 'hit', pad, velocity: 0.6, seq: packSeq(counter, at), clientAt: Date.now() })); } catch { /* close follows */ }
    }
    function sendTune() {
      const now = Date.now();
      if (now - lastSent < 260) { pendingTune = step; return; }
      lastSent = now; pendingTune = null;
      send('kick', step);
    }
    setInterval(() => { if (pendingTune !== null && Date.now() - lastSent >= 260) sendTune(); }, 120);
    setInterval(() => { if (document.visibilityState === 'visible') send('hat', step); }, 30000);

    // A client id is `<hash of room:sid>-<per-connection suffix>`. Key people by the stable
    // half so a reconnect (or a second tab) is the same person, never a ghost of them.
    const who = (clientId: string) => String(clientId || '').split('-')[0];
    const isMe = (clientId: string) => !!me.id && who(clientId) === who(me.id);

    function upsert(rawId: string, avatar: number, hue: number, patch: Partial<Listener>) {
      const id = who(rawId);
      const cur = people.get(id) ?? { id, avatar, hue, step: null, at: 0, live: false };
      people.set(id, { ...cur, avatar, hue, ...patch });
    }

    function onMessage(msg: any) {
      if (!msg || msg.v !== 1) return;
      if (msg.type === 'welcome') {
        me = { id: msg.you.clientId, avatar: msg.you.avatar, hue: msg.you.hue, call: callSign(who(msg.you.clientId)) };
        people.delete(who(me.id));
        els.meNoun.src = `https://noun.pics/${me.avatar % 1200}.svg`;
        els.meCall.textContent = me.call;
        els.link.textContent = 'on the band';
        const cutoff = Date.now() - 6 * 3600_000;
        for (const hit of msg.recentHits || []) {
          if (hit.pad === 'bell') { if (hit.serverAt > Date.now() - 24 * 3600_000) finds.unshift({ call: isMe(hit.clientId) ? me.call : callSign(who(hit.clientId)), at: hit.serverAt }); continue; }
          if (isMe(hit.clientId)) continue;
          if ((hit.pad === 'kick' || hit.pad === 'hat') && hit.serverAt > cutoff) upsert(hit.clientId, hit.avatar, hit.hue, { step: unpackStep(hit.seq), at: hit.serverAt });
        }
        send('hat', step);
        renderFinds();
        return;
      }
      if (msg.type === 'presence') {
        const live = new Set<string>();
        for (const p of msg.people || []) {
          if (isMe(p.id)) continue;
          live.add(who(p.id));
          const wasLive = people.get(who(p.id))?.live;
          upsert(p.id, p.avatar, p.hue, { live: true });
          if (!wasLive && heardPresence) toast(`${callSign(who(p.id))} joined the band`);
        }
        for (const l of people.values()) if (!live.has(l.id)) l.live = false;
        heardPresence = true;
        return;
      }
      if (msg.type === 'reaction') {
        if (isMe(msg.clientId)) return;
        const id = who(msg.clientId);
        floatAt(id, msg.emoji);
        const p = people.get(id);
        if (p && p.step !== null && Math.abs(p.step - step) <= 40) blip(p.step - step);
        return;
      }
      if (msg.type === 'hit') {
        if (isMe(msg.clientId)) return;
        const at = unpackStep(msg.seq);
        if (msg.pad === 'bell') {
          finds.unshift({ call: callSign(who(msg.clientId)), at: msg.serverAt });
          renderFinds();
          toast(`${callSign(who(msg.clientId))} copied the fox`);
          ping(who(msg.clientId));
          return;
        }
        upsert(msg.clientId, msg.avatar, msg.hue, { step: at, at: msg.serverAt, live: true });
        if (msg.pad === 'kick' && Math.abs(at - step) <= BAND.nearSteps) ping(who(msg.clientId));
      }
    }

    // ---------- tuning ----------
    function tune(next: number, announce = true) {
      const s = clampStep(next);
      if (s === step && announce) return;
      step = s;
      store.set('pc-band-step', step);
      const url = new URL(location.href);
      url.searchParams.set('f', formatMhz(step));
      history.replaceState(null, '', url);
      if (announce) sendTune();
    }
    function stepFromX(clientX: number) {
      const r = els.dial.getBoundingClientRect();
      return Math.round(((clientX - r.left) / Math.max(1, r.width)) * BAND.steps);
    }
    let dragging = false;
    els.dial.addEventListener('pointerdown', (e) => { dragging = true; els.dial.setPointerCapture(e.pointerId); tune(stepFromX(e.clientX)); });
    els.dial.addEventListener('pointermove', (e) => { if (dragging) tune(stepFromX(e.clientX)); });
    const endDrag = () => { if (dragging) { dragging = false; pendingTune = step; } };
    els.dial.addEventListener('pointerup', endDrag);
    els.dial.addEventListener('pointercancel', endDrag);
    els.dial.addEventListener('keydown', (e) => {
      const big = e.shiftKey ? 10 : 1;
      const map: Record<string, number> = { ArrowLeft: -big, ArrowDown: -big, ArrowRight: big, ArrowUp: big, PageDown: -40, PageUp: 40 };
      if (e.key in map) { e.preventDefault(); tune(step + map[e.key]); }
      else if (e.key === 'Home') { e.preventDefault(); tune(0); }
      else if (e.key === 'End') { e.preventDefault(); tune(BAND.steps); }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-nudge]').forEach((b) => b.addEventListener('click', () => tune(step + Number(b.dataset.nudge))));
    els.dial.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey) { e.preventDefault(); tune(step + Math.sign(e.deltaX || e.deltaY)); } }, { passive: false });

    els.goto.addEventListener('click', () => {
      const live = [...people.values()].filter((p) => p.live && p.step !== null).sort((a, b) => b.at - a.at);
      const pick = live[0] ?? [...people.values()].filter((p) => p.step !== null).sort((a, b) => b.at - a.at)[0];
      if (!pick || pick.step === null) { note('Nobody else is tuned in yet. Copy the invite and bring someone.'); return; }
      tune(pick.step + (pick.step >= BAND.steps ? -1 : 1));
      note(`Parked next to ${callSign(pick.id)}${pick.live ? '' : ' (tuned in earlier)'}.`);
    });
    els.invite.addEventListener('click', async () => {
      const link = `${location.origin}/band?f=${formatMhz(step)}`;
      try { await navigator.clipboard.writeText(link); note(`Copied. Anyone who opens it lands on ${formatMhz(step)} MHz.`); }
      catch { note(link); }
    });

    let noteTimer = 0;
    function note(text: string) { els.note.textContent = text; clearTimeout(noteTimer); noteTimer = window.setTimeout(() => { els.note.textContent = ''; }, 6000); }
    function toast(text: string) { note(text); }

    // ---------- derived ----------
    const liveOthers = () => [...people.values()].filter((p) => p.live && p.step !== null);
    const nearFox = () => liveOthers().filter((p) => Math.abs((p.step as number) - fox.step) <= BAND.nearSteps);

    // ---------- audio ----------
    let ctx: AudioContext | null = null;
    let master: GainNode, staticGain: GainNode, foxKey: GainNode, foxLevel: GainNode, myGain: GainNode;
    const peerVoices = new Map<string, { osc: OscillatorNode; gain: GainNode }>();
    let foxScheduledUntil = 0;
    const UNIT = 0.075;
    let sched = morseSchedule(fox.message);
    const loopUnits = () => sched.units + 16;

    function startAudio() {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      ctx = new AC();
      master = ctx.createGain(); master.gain.value = Number(els.vol.value) * 0.8; master.connect(ctx.destination);
      const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
      const noise = ctx.createBufferSource(); noise.buffer = buf; noise.loop = true;
      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1500; bp.Q.value = 0.6;
      staticGain = ctx.createGain(); staticGain.gain.value = 0.08;
      noise.connect(bp).connect(staticGain).connect(master); noise.start();
      const mine = ctx.createOscillator(); mine.type = 'sine'; mine.frequency.value = 196;
      myGain = ctx.createGain(); myGain.gain.value = 0.03;
      mine.connect(myGain).connect(master); mine.start();
      const fo = ctx.createOscillator(); fo.type = 'sine'; fo.frequency.value = 700;
      foxKey = ctx.createGain(); foxKey.gain.value = 0;
      foxLevel = ctx.createGain(); foxLevel.gain.value = 0;
      fo.connect(foxKey).connect(foxLevel).connect(master); fo.start();
      foxScheduledUntil = 0;
    }
    function setAir(on: boolean) {
      if (on && !ctx) startAudio();
      if (!ctx) return;
      if (on) ctx.resume(); else ctx.suspend();
      els.air.setAttribute('aria-pressed', String(on));
      note(on ? 'On air. Drag the dial. Listen for other carriers and a keyed tone.' : 'Off air. The dial still works.');
    }
    els.air.addEventListener('click', () => setAir(els.air.getAttribute('aria-pressed') !== 'true'));
    els.vol.addEventListener('input', () => { if (ctx) master.gain.setTargetAtTime(Number(els.vol.value) * 0.8, ctx.currentTime, 0.05); });

    // The fox keys on a wall-clock loop, so everyone hears the same letter at the same moment.
    function loopStartMs(nowMs: number) { const L = loopUnits() * UNIT * 1000; return Math.floor(nowMs / L) * L; }
    function keyedAt(nowMs: number) {
      const u = (nowMs - loopStartMs(nowMs)) / (UNIT * 1000);
      for (const [s, len] of sched.marks) if (u >= s && u < s + len) return true;
      return false;
    }
    function scheduleFox() {
      if (!ctx || ctx.state !== 'running') return;
      const nowMs = Date.now();
      const offset = ctx.currentTime - nowMs / 1000;
      const L = loopUnits() * UNIT * 1000;
      let start = Math.max(loopStartMs(nowMs), foxScheduledUntil);
      while (start < nowMs + 1500) {
        for (const [s, len] of sched.marks) {
          const t0 = (start + s * UNIT * 1000) / 1000 + offset;
          if (t0 < ctx.currentTime) continue;
          foxKey.gain.setTargetAtTime(1, t0, 0.004);
          foxKey.gain.setTargetAtTime(0, t0 + len * UNIT, 0.004);
        }
        start += L;
      }
      foxScheduledUntil = start;
    }
    function updateAudio(foxProx: number, clr: number, near: number) {
      if (!ctx || ctx.state !== 'running') return;
      const t = ctx.currentTime;
      staticGain.gain.setTargetAtTime((0.03 + 0.1 * (1 - clr)) / (1 + 0.35 * near), t, 0.1);
      foxLevel.gain.setTargetAtTime(0.09 * foxProx * foxProx * (0.5 + clr * 0.5), t, 0.08);
      const seen = new Set<string>();
      for (const p of liveOthers()) {
        const d = (p.step as number) - step;
        if (Math.abs(d) > 40) continue;
        seen.add(p.id);
        let v = peerVoices.get(p.id);
        if (!v) {
          if (peerVoices.size >= 6) continue;
          const osc = ctx.createOscillator(); osc.type = 'triangle';
          const gain = ctx.createGain(); gain.gain.value = 0;
          osc.connect(gain).connect(master); osc.start();
          v = { osc, gain }; peerVoices.set(p.id, v);
        }
        v.osc.frequency.setTargetAtTime(196 + d * 3, t, 0.08);
        v.gain.gain.setTargetAtTime(0.028 * (1 - Math.abs(d) / 41), t, 0.1);
      }
      for (const [id, v] of peerVoices) if (!seen.has(id)) { v.gain.gain.setTargetAtTime(0, t, 0.1); v.osc.stop(t + 0.5); peerVoices.delete(id); }
    }

    // ---------- waterfall ----------
    const g = els.fall.getContext('2d')!;
    const W = els.fall.width, H = els.fall.height;
    g.fillStyle = '#0f0d0b'; g.fillRect(0, 0, W, H);
    const row = g.createImageData(W, 1);
    function drawRow(foxProx: number) {
      const sources: { x: number; amp: number; col: [number, number, number] }[] = [];
      const xOf = (s: number) => (s / BAND.steps) * (W - 1);
      for (const p of people.values()) if (p.step !== null) sources.push({ x: xOf(p.step), amp: p.live ? 0.9 : 0.25, col: [232, 176, 74] });
      sources.push({ x: xOf(step), amp: 1, col: [229, 72, 77] });
      if (foxProx > 0) sources.push({ x: xOf(fox.step), amp: foxProx * (keyedAt(Date.now()) ? 1 : 0.35), col: [111, 191, 142] });
      const d = row.data;
      for (let x = 0; x < W; x++) {
        const n = Math.random() * 26 + 8;
        let r = n * 0.9, gg = n * 0.75, b = n * 0.5;
        for (const s of sources) {
          const dx = x - s.x;
          const e = Math.exp(-(dx * dx) / 18) * s.amp;
          if (e > 0.01) { r += s.col[0] * e; gg += s.col[1] * e; b += s.col[2] * e; }
        }
        const i = x * 4; d[i] = Math.min(255, r); d[i + 1] = Math.min(255, gg); d[i + 2] = Math.min(255, b); d[i + 3] = 255;
      }
      g.drawImage(els.fall, 0, 0, W, H - 1, 0, 1, W, H - 1);
      g.putImageData(row, 0, 0);
    }

    // ---------- render ----------
    const headEls = new Map<string, HTMLElement>();
    function headFor(id: string, avatar: number, hue: number) {
      let el = headEls.get(id);
      if (!el) {
        el = document.createElement('div'); el.className = 'bd-head';
        const img = document.createElement('img'); img.alt = ''; img.src = `https://noun.pics/${avatar % 1200}.svg`;
        const tag = document.createElement('b');
        el.append(img, tag); els.heads.append(el); headEls.set(id, el);
      }
      el.style.setProperty('--h', String(hue));
      return el;
    }
    function ping(id: string) { const el = headEls.get(id); if (!el) return; el.classList.remove('is-ping'); void el.offsetWidth; el.classList.add('is-ping'); }

    function renderHeads() {
      const all: { id: string; avatar: number; hue: number; step: number; ghost: boolean; mine: boolean; call: string }[] = [];
      for (const p of people.values()) if (p.step !== null) all.push({ id: p.id, avatar: p.avatar, hue: p.hue, step: p.step, ghost: !p.live, mine: false, call: callSign(p.id) });
      all.push({ id: 'me', avatar: me.avatar, hue: me.hue, step, ghost: false, mine: true, call: 'YOU' });
      all.sort((a, b) => a.step - b.step);
      const keep = new Set<string>();
      const stack: number[] = [];
      for (const p of all) {
        keep.add(p.id);
        const el = headFor(p.id, p.avatar, p.hue);
        if (p.mine && me.avatar) (el.firstChild as HTMLImageElement).src = `https://noun.pics/${me.avatar % 1200}.svg`;
        let lane = 0;
        while (stack[lane] !== undefined && p.step - stack[lane] < 9) lane++;
        stack[lane] = p.step;
        el.style.left = `${(p.step / BAND.steps) * 100}%`;
        el.style.bottom = `${6 + Math.min(lane, 2) * 46}px`;
        el.classList.toggle('is-ghost', p.ghost);
        el.classList.toggle('is-me', p.mine);
        (el.lastChild as HTMLElement).textContent = p.call;
        (el.lastChild as HTMLElement).hidden = !(p.mine || Math.abs(p.step - step) <= BAND.nearSteps);
      }
      for (const [id, el] of headEls) if (!keep.has(id)) { el.remove(); headEls.delete(id); }
    }

    let peopleSig = '';
    function renderPeople() {
      const rows = [...people.values()].filter((p) => p.step !== null).sort((a, b) => Number(b.live) - Number(a.live) || b.at - a.at).slice(0, 14);
      const sig = rows.map((p) => `${p.id}:${p.step}:${p.live}`).join('|') + `|me:${step}:${me.id}`;
      if (sig === peopleSig) return;
      peopleSig = sig;
      els.people.replaceChildren();
      const mk = (p: { id: string; avatar: number; hue: number; step: number; live: boolean }, mine: boolean) => {
        const li = document.createElement('li');
        li.classList.toggle('is-ghost', !p.live); li.classList.toggle('is-me', mine);
        const btn = document.createElement('button'); btn.type = 'button';
        btn.style.setProperty('--h', String(p.hue));
        const img = document.createElement('img'); img.alt = ''; img.src = `https://noun.pics/${p.avatar % 1200}.svg`; img.width = 28; img.height = 28;
        const who = document.createElement('span');
        const b = document.createElement('b'); b.textContent = mine ? `${me.call} (you)` : callSign(p.id);
        const small = document.createElement('small'); small.textContent = mine ? 'here' : p.live ? (Math.abs(p.step - step) <= BAND.nearSteps ? 'next to you' : 'on the band now') : `tuned in ${ago(people.get(p.id)?.at ?? Date.now())}`;
        who.append(b, small);
        const code = document.createElement('code'); code.textContent = formatMhz(p.step);
        btn.append(img, who, code);
        if (!mine) btn.addEventListener('click', () => { tune(p.step + (p.step >= BAND.steps ? -1 : 1)); note(`Parked next to ${callSign(p.id)}.`); });
        li.append(btn); return li;
      };
      if (me.id) els.people.append(mk({ id: me.id, avatar: me.avatar, hue: me.hue, step, live: true }, true));
      for (const p of rows) els.people.append(mk({ ...p, step: p.step as number }, false));
      if (!rows.length) { const li = document.createElement('li'); li.className = 'bd-muted'; li.textContent = 'Just you right now. Copy the invite. The fox is easier with company.'; els.people.append(li); }
    }

    function renderFinds() {
      const today = finds.filter((f) => f.at > Date.now() - 24 * 3600_000).slice(0, 5);
      els.finds.replaceChildren(...today.map((f) => { const li = document.createElement('li'); li.textContent = `✦ ${f.call} copied the fox · ${ago(f.at)}`; return li; }));
      els.foxStatus.textContent = foundToday ? `You copied today’s fox. It moves at midnight in El Segundo.` : today.length ? `${today.length} copied it recently. Follow the crowd.` : 'Not found by you yet today.';
    }

    function renderLog() {
      const run = streak();
      els.streak.textContent = run > 1 ? `· ${run}-day streak` : '';
      els.logbook.replaceChildren();
      if (!logbook.length) { const li = document.createElement('li'); li.className = 'bd-muted'; li.textContent = 'No QSL cards yet. Find a fox.'; els.logbook.append(li); return; }
      for (const entry of [...logbook].reverse().slice(0, 12)) {
        const li = document.createElement('li');
        const span = document.createElement('span'); span.textContent = `${entry.date} · ${entry.mhz} MHz · with ${entry.with.length}`;
        const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = 'VIEW';
        btn.addEventListener('click', () => openQsl(entry));
        li.append(span, btn); els.logbook.append(li);
      }
    }

    function ago(t: number) {
      const s = Math.max(1, Math.round((Date.now() - t) / 1000));
      if (s < 60) return 'just now';
      const m = Math.round(s / 60); if (m < 60) return `${m} min ago`;
      const h = Math.round(m / 60); return `${h} hr ago`;
    }

    function renderTape(clr: number, foxProx: number, helpers: number) {
      const msg = fox.message;
      const n = Math.floor(revealed);
      const frag = document.createDocumentFragment();
      for (let i = 0; i < msg.length; i++) {
        const ch = msg[i];
        if (i < n) frag.append(ch === ' ' ? ' ' : ch);
        else { const s = document.createElement('span'); s.className = 'dim'; s.textContent = ch === ' ' ? ' ' : '·'; frag.append(s); }
      }
      els.tape.replaceChildren(frag);
      els.tapeBox.classList.toggle('is-found', foundToday);
      if (foundToday) els.tapeNote.textContent = 'Copied. Your QSL card is in the logbook. Stick around — the next person here gets it faster with you parked on it.';
      else if (clr >= 0.5) els.tapeNote.textContent = helpers ? `Copying — ${helpers} other${helpers === 1 ? '' : 's'} next to the fox clear the static.` : 'Copying. Hold steady. Company would clear it faster.';
      else if (foxProx > 0.6) els.tapeNote.textContent = 'Very close. Fine-tune one step at a time.';
      else if (foxProx > 0) els.tapeNote.textContent = 'Warmer. The FOX meter is picking it up.';
      else els.tapeNote.textContent = 'Sweep the dial. The FOX meter wakes up within a megahertz.';
    }

    // ---------- waves ----------
    let lastWave = 0;
    function floatAt(id: string, emoji: string) {
      const el = headEls.get(id);
      if (!el) return;
      const f = document.createElement('span');
      f.className = 'bd-float';
      f.textContent = emoji;
      f.style.left = el.style.left;
      f.style.bottom = `${parseFloat(el.style.bottom || '6') + 30}px`;
      els.heads.append(f);
      setTimeout(() => f.remove(), 1900);
    }
    function blip(offset: number) {
      if (!ctx || ctx.state !== 'running') return;
      const o = ctx.createOscillator(); const gn = ctx.createGain(); const t = ctx.currentTime;
      o.type = 'sine'; o.frequency.value = 880 + offset * 6;
      gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(0.05, t + 0.01); gn.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
      o.connect(gn).connect(master); o.start(t); o.stop(t + 0.4);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-react]').forEach((b) => b.addEventListener('click', () => {
      const now = Date.now();
      if (now - lastWave < 350) return;
      lastWave = now;
      const emoji = b.dataset.react || '♥';
      floatAt('me', emoji);
      blip(0);
      if (ws && wsOpen) { try { ws.send(JSON.stringify({ v: 1, type: 'reaction', emoji })); } catch { /* close follows */ } }
    }));

    function streak(): number {
      const days = new Set(logbook.map((e) => e.date));
      let n = 0;
      const d = new Date();
      if (!days.has(townDate(d))) d.setTime(d.getTime() - 86_400_000);
      while (days.has(townDate(d))) { n++; d.setTime(d.getTime() - 86_400_000); }
      return n;
    }

    // ---------- the find ----------
    function foundFox() {
      foundToday = true;
      const withList = nearFox().map((p) => ({ call: callSign(p.id), avatar: p.avatar }));
      const entry: LogEntry = { date: fox.date, mhz: fox.mhz, message: fox.message, call: me.call, avatar: me.avatar, with: withList, at: Date.now() };
      logbook = [...logbook.filter((e) => e.date !== fox.date), entry].slice(-60);
      store.set('pc-band-log', logbook);
      send('bell', step);
      renderLog(); renderFinds();
      if (ctx && ctx.state === 'running') chime();
      openQsl(entry);
    }
    function chime() {
      if (!ctx) return;
      [659.25, 783.99, 987.77, 1318.5].forEach((f, i) => {
        const o = ctx!.createOscillator(); const gn = ctx!.createGain(); const t = ctx!.currentTime + i * 0.12;
        o.frequency.value = f; gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(0.08, t + 0.01); gn.gain.exponentialRampToValueAtTime(0.0001, t + 1.2);
        o.connect(gn).connect(master); o.start(t); o.stop(t + 1.3);
      });
    }

    const qslBg = new Image(); qslBg.src = '/images/band/qsl.jpg';
    let currentQsl: LogEntry | null = null;
    async function drawQsl(entry: LogEntry) {
      const c = els.qslCanvas, q = c.getContext('2d')!;
      const w = c.width, h = c.height;
      if (!qslBg.complete) await new Promise((r) => { qslBg.onload = r; qslBg.onerror = r; });
      q.fillStyle = '#fbeed2'; q.fillRect(0, 0, w, h);
      if (qslBg.naturalWidth) q.drawImage(qslBg, 0, 0, w, h);
      const x = 600, ink = '#1a1713', amber = '#b9761c';
      q.fillStyle = ink; q.textBaseline = 'alphabetic';
      q.font = '700 150px Georgia, "Times New Roman", serif'; q.fillText('QSL', x, 210);
      q.fillStyle = amber; q.font = '700 26px ui-monospace, Menlo, monospace'; q.fillText('CONFIRMING OUR CONTACT ON THE BAND', x + 4, 256);
      q.fillStyle = ink; q.font = '600 30px ui-monospace, Menlo, monospace';
      q.fillText(`FROM ${entry.call}`, x + 4, 318);
      q.fillText(`TO   EVERYONE ON ${entry.mhz} MHz`, x + 4, 360);
      // grid
      const cells: [string, string][] = [['DATE', entry.date], ['TIME PT', new Date(entry.at).toLocaleTimeString('en-US', { timeZone: 'America/Los_Angeles', hour: 'numeric', minute: '2-digit' })], ['MHz', entry.mhz], ['MODE', 'CW']];
      const gx = x, gy = 400, cw = 212, ch = 92;
      q.strokeStyle = ink; q.lineWidth = 2;
      cells.forEach(([k, v], i) => {
        q.strokeRect(gx + i * cw, gy, cw, ch);
        q.fillStyle = amber; q.font = '700 18px ui-monospace, Menlo, monospace'; q.fillText(k, gx + i * cw + 14, gy + 30);
        q.fillStyle = ink; q.font = '600 28px ui-monospace, Menlo, monospace'; q.fillText(v, gx + i * cw + 14, gy + 72);
      });
      q.fillStyle = amber; q.font = '700 20px ui-monospace, Menlo, monospace'; q.fillText('FOX COPIED', x + 4, 560);
      q.fillStyle = ink; q.font = '700 44px ui-monospace, Menlo, monospace';
      wrap(q, `“${entry.message}”`, x + 4, 614, 860, 54);
      q.fillStyle = amber; q.font = '700 20px ui-monospace, Menlo, monospace';
      q.fillText(entry.with.length ? `HEARD WITH ${entry.with.length}` : 'HEARD SOLO — BRING COMPANY NEXT TIME', x + 4, 752);
      const heads = [{ call: entry.call, avatar: entry.avatar ?? me.avatar }, ...entry.with].slice(0, 8);
      await Promise.all(heads.map((p, i) => new Promise<void>((res) => {
        const img = new Image(); img.crossOrigin = 'anonymous';
        img.onload = () => {
          const hx = x + 4 + i * 108, hy = 772;
          q.save(); q.beginPath(); q.arc(hx + 44, hy + 44, 44, 0, Math.PI * 2); q.closePath(); q.fillStyle = '#e9dcc0'; q.fill(); q.clip();
          q.drawImage(img, hx, hy, 88, 88); q.restore();
          q.fillStyle = ink; q.font = '700 14px ui-monospace, Menlo, monospace'; q.fillText(p.call, hx + 2, hy + 108);
          res();
        };
        img.onerror = () => res();
        img.src = `https://noun.pics/${p.avatar % 1200}.svg`;
      })));
      q.fillStyle = ink; q.font = '700 22px ui-monospace, Menlo, monospace'; q.fillText('73 · POINTCAST.XYZ/BAND', x + 4, 948);
    }
    function wrap(q: CanvasRenderingContext2D, text: string, x: number, y: number, max: number, lh: number) {
      let line = ''; let yy = y;
      for (const word of text.split(' ')) {
        const test = line ? `${line} ${word}` : word;
        if (q.measureText(test).width > max && line) { q.fillText(line, x, yy); line = word; yy += lh; } else line = test;
      }
      q.fillText(line, x, yy);
    }
    async function openQsl(entry: LogEntry) {
      currentQsl = entry;
      await drawQsl(entry);
      if (!els.qsl.open) els.qsl.showModal();
    }
    els.qslClose.addEventListener('click', () => els.qsl.close());
    els.qslSave.addEventListener('click', () => {
      els.qslCanvas.toBlob((blob) => {
        if (!blob || !currentQsl) return;
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
        a.download = `qsl-${currentQsl.date}-${currentQsl.mhz}.png`; a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      }, 'image/png');
    });
    els.qslShare.addEventListener('click', () => {
      if (!currentQsl) return;
      const n = currentQsl.with.length;
      const text = `Copied today's fox on The Band${n ? ` with ${n} other${n === 1 ? '' : 's'} on the dial` : ''}. QSL logged. pointcast.xyz/band #band`;
      window.dispatchEvent(new CustomEvent('pc:shortwave:say', { detail: { text, via: 'page' } }));
      note('Sent to Shortwave.');
      els.qslShare.disabled = true;
    });

    // ---------- loop ----------
    let last = performance.now();
    let frame = 0;
    function tick(now: number) {
      const dt = Math.min(0.25, (now - last) / 1000); last = now; frame++;
      const today = townDate();
      if (today !== fox.date) { fox = foxOf(today); sched = morseSchedule(fox.message); foundToday = logbook.some((e) => e.date === fox.date); revealed = foundToday ? fox.message.length : 0; foxScheduledUntil = 0; }
      const dist = step - fox.step;
      const foxProx = proximity(dist);
      const helpers = nearFox().length;
      const clr = clarity(dist, helpers);
      const nearMe = liveOthers().filter((p) => Math.abs((p.step as number) - step) <= BAND.nearSteps).length;
      if (!foundToday) { revealed = advanceCopy(revealed, clr, dt, fox.message.length); if (revealed >= fox.message.length) foundFox(); }

      els.freq.textContent = formatMhz(step);
      els.needle.style.left = `${(step / BAND.steps) * 100}%`;
      els.dial.setAttribute('aria-valuenow', String(formatMhz(step)));
      els.dial.setAttribute('aria-valuetext', `${formatMhz(step)} megahertz`);
      els.smeter.style.width = `${Math.round(foxProx * 100)}%`;
      els.sread.textContent = `S${Math.round(foxProx * 9)}`;
      els.clear.style.width = `${Math.round(clr * 100)}%`;
      els.helpers.textContent = helpers ? `+${helpers}` : 'solo';
      els.lamp.classList.toggle('on', foxProx > 0 && keyedAt(Date.now()));
      els.on.textContent = String(liveOthers().length + 1);
      els.near.textContent = String(nearMe);

      if (!document.hidden) drawRow(foxProx);
      if (frame % 3 === 0) { renderHeads(); renderTape(clr, foxProx, helpers); }
      if (frame % 30 === 0) renderPeople();
      if (frame % 6 === 0) { scheduleFox(); updateAudio(foxProx, clr, nearMe); }
      requestAnimationFrame(tick);
    }

    renderLog(); renderFinds(); renderPeople();
    connect();
    requestAnimationFrame(tick);
    addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.closest?.('input,textarea,[contenteditable]')) return;
      if (e.key === ' ' && e.target === document.body) { e.preventDefault(); setAir(els.air.getAttribute('aria-pressed') !== 'true'); }
    });
  }
</script>
