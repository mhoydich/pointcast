---
/**
 * /bell-walk — a meandering walk through nine bells.
 *
 * Mike 2026-05-09: "create a bell walk for pointcast.xyz, these to those,
 * those to the others, options for next, this path or that, enjoy."
 *
 * Reuses the gold-dome bell + halo-pulse interaction from /404, but instead
 * of one bell that ends at /lobby, you walk a small DAG of nine bells.
 * Each bell has a target tap count (varies — some are quick, some take
 * five), a characteristic chime pitch, and two next-bell choices. Branches
 * merge mid-walk so the same bell can be reached from two different paths.
 * Three terminal bells exit to a real PointCast room: /booth, /window,
 * /lobby. Walking back to the gate restarts the loop.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const CH = {
  c50:  '#FAF4E8',
  c600: '#A26B2C',
  c800: '#5C3D17',
};

const BELLS = [
  {
    id: 'gate',
    title: 'GATE BELL',
    blurb: 'the broadcast hears you. step in.',
    taps: 3,
    semitone: 0,
    next: [
      { to: 'alcove', headline: 'this path', sub: 'into the alcove · short and bright' },
      { to: 'garden', headline: 'that path', sub: 'around to the garden · slow and green' },
    ],
  },
  {
    id: 'alcove',
    title: 'ALCOVE BELL',
    blurb: 'a small one tucked in the wall. it answers fast.',
    taps: 2,
    semitone: 4,
    next: [
      { to: 'coffee', headline: 'this path', sub: 'toward the coffee pot' },
      { to: 'kettle', headline: 'that path', sub: 'toward the kettle' },
    ],
  },
  {
    id: 'garden',
    title: 'GARDEN BELL',
    blurb: 'hung in the herb garden. wait for it to settle.',
    taps: 4,
    semitone: 7,
    next: [
      { to: 'kettle', headline: 'this path', sub: 'inside to the kettle' },
      { to: 'tide',   headline: 'that path', sub: 'down the slope to the tide' },
    ],
  },
  {
    id: 'coffee',
    title: 'COFFEE BELL',
    blurb: 'espresso brass. five taps and the milk has steamed.',
    taps: 5,
    semitone: 9,
    next: [
      { to: 'bookshelf', headline: 'this path', sub: 'past the bookshelf' },
      { to: '/booth',    headline: 'leave the walk', sub: '→ /booth · what residents are listening to', exit: true, label: '/booth' },
    ],
  },
  {
    id: 'kettle',
    title: 'KETTLE BELL',
    blurb: 'a high whistle, almost a song.',
    taps: 3,
    semitone: 11,
    next: [
      { to: 'bookshelf', headline: 'this path', sub: 'into the bookshelf' },
      { to: 'tide',      headline: 'that path', sub: 'out to the tide' },
    ],
  },
  {
    id: 'tide',
    title: 'TIDE BELL',
    blurb: 'low and far, the swell answers.',
    taps: 4,
    semitone: -5,
    next: [
      { to: 'window', headline: 'this path', sub: 'back up to the window' },
      { to: 'dusk',   headline: 'that path', sub: 'on toward dusk' },
    ],
  },
  {
    id: 'bookshelf',
    title: 'BOOKSHELF BELL',
    blurb: 'two quiet taps. the room listens for them.',
    taps: 2,
    semitone: 2,
    next: [
      { to: 'window', headline: 'this path', sub: 'to the window' },
      { to: 'dusk',   headline: 'that path', sub: 'to dusk' },
    ],
  },
  {
    id: 'window',
    title: 'WINDOW BELL',
    blurb: 'the el segundo bell. you can hear weather through it.',
    taps: 3,
    semitone: 5,
    next: [
      { to: '/window', headline: 'leave the walk', sub: '→ /window · live el segundo weather', exit: true, label: '/window' },
      { to: 'dusk',    headline: 'one more bell',  sub: 'on to dusk' },
    ],
  },
  {
    id: 'dusk',
    title: 'DUSK BELL',
    blurb: 'the deepest bell. the broadcast lowers the lights.',
    taps: 5,
    semitone: -7,
    next: [
      { to: '/lobby', headline: 'leave the walk', sub: '→ /lobby · sit a minute', exit: true, label: '/lobby' },
      { to: 'gate',   headline: 'walk again',     sub: 'back to the gate' },
    ],
  },
];

const SEMI_BY_ID = Object.fromEntries(BELLS.map((b) => [b.id, b.semitone]));
const TAPS_BY_ID = Object.fromEntries(BELLS.map((b) => [b.id, b.taps]));
---

<BlockLayout
  title="bell walk · pointcast"
  description="walk a path of nine bells. tap to ring, choose this path or that, exit when a bell carries you to a real room."
>
  <div class="page" style={`--ch-50:${CH.c50};--ch-600:${CH.c600};--ch-800:${CH.c800};`}>
    <header class="head">
      <p class="code">CH.WALK · NINE BELLS</p>
      <h1>The bell walk.</h1>
      <p class="dek">
        Tap the bell its full count and a path opens. <em>This path or that.</em>
        Three of the bells will carry you out into a real room of PointCast —
        the rest send you on to another bell. Take whichever you like.
      </p>
    </header>

    <nav class="trail" id="trail" aria-label="Bells you have rung">
      <span class="trail__label">walked:</span>
      <ol class="trail__list" id="trail-list"><li class="trail__seed">—</li></ol>
      <button type="button" class="trail__restart is-closed" id="restart">↺ restart</button>
    </nav>

    {BELLS.map((b, i) => (
      <section class={`station${i === 0 ? '' : ' is-closed'}`} data-station={b.id} aria-label={b.title}>
        <div class="bell-pad">
          <div class="bell-pad__inner">
            <button class="bell" type="button" data-bell={b.id} aria-label={`Tap the ${b.title}`}>
              <span class="bell__dome" aria-hidden="true"></span>
              <span class="bell__halo" aria-hidden="true"></span>
            </button>
            <div class="bell-pad__caption">
              <div class="bell-pad__hed">{b.title}</div>
              <div class="bell-pad__sub" data-sub={b.id}>{b.blurb}</div>
              <div class="bell-pad__count">
                <span class="bell-pad__count-num" data-count={b.id}>0</span>
                <span class="bell-pad__count-label">/ {b.taps}</span>
              </div>
            </div>
          </div>

          <div class="choices is-closed" data-choices={b.id}>
            {b.next.map((n, j) => (
              <button
                type="button"
                class={`choice${n.exit ? ' choice--exit' : ''}`}
                data-go={n.to}
                data-side={j === 0 ? 'this' : 'that'}
                data-exit={n.exit ? 'true' : 'false'}
              >
                <span class="choice__hed">{n.headline}</span>
                <span class="choice__sub">{n.sub}</span>
              </button>
            ))}
          </div>
        </div>
      </section>
    ))}

    <footer class="foot">
      <a href="/lobby">/lobby</a>
      <a href="/booth">/booth</a>
      <a href="/window">/window</a>
      <a href="/town">/town</a>
      <a href="/">all blocks</a>
    </footer>
  </div>
</BlockLayout>

<script is:inline define:vars={{ SEMI: SEMI_BY_ID, TAPS: TAPS_BY_ID }}>
  (function () {
    const stations = document.querySelectorAll('[data-station]');
    const trailList = document.getElementById('trail-list');
    const trailSeed = trailList?.querySelector('.trail__seed');
    const restartBtn = document.getElementById('restart');
    const startId = stations[0]?.getAttribute('data-station');
    const tapState = Object.create(null);
    let ctx = null;

    function chime(semitone, step) {
      try {
        ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
        const t = ctx.currentTime;
        const base = 523.25; // C5
        const freq = base * Math.pow(2, (semitone + step * 0.6) / 12);
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.22, t + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.7);
        osc.connect(gain).connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.75);
      } catch (e) { /* audio is decorative */ }
    }

    function showStation(id) {
      stations.forEach((s) => {
        const match = s.getAttribute('data-station') === id;
        s.classList.toggle('is-closed', !match);
      });
      const target = document.querySelector(`[data-station="${id}"]`);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function pushTrail(id) {
      if (!trailList) return;
      if (trailSeed && trailSeed.parentNode === trailList) {
        trailList.removeChild(trailSeed);
      }
      const li = document.createElement('li');
      li.className = 'trail__step';
      const hasPrior = trailList.querySelector('.trail__step') !== null;
      li.textContent = (hasPrior ? '→ ' : '') + id;
      trailList.appendChild(li);
      if (restartBtn) restartBtn.classList.remove('is-closed');
    }

    function resetWalk() {
      if (trailList) {
        trailList.innerHTML = '';
        if (trailSeed) {
          trailList.appendChild(trailSeed);
        } else {
          const seed = document.createElement('li');
          seed.className = 'trail__seed';
          seed.textContent = '—';
          trailList.appendChild(seed);
        }
      }
      if (restartBtn) restartBtn.classList.add('is-closed');

      Object.keys(tapState).forEach((k) => delete tapState[k]);
      document.querySelectorAll('[data-count]').forEach((el) => { el.textContent = '0'; });
      document.querySelectorAll('[data-sub]').forEach((el) => {
        const original = el.getAttribute('data-original');
        if (original) el.textContent = original;
      });
      document.querySelectorAll('[data-choices]').forEach((el) => { el.classList.add('is-closed'); });

      if (startId) showStation(startId);
    }

    document.querySelectorAll('[data-sub]').forEach((el) => {
      el.setAttribute('data-original', el.textContent || '');
    });

    document.querySelectorAll('.bell').forEach((bell) => {
      const id = bell.getAttribute('data-bell');
      if (!id) return;
      const station = bell.closest('[data-station]');
      const countEl = station?.querySelector(`[data-count="${id}"]`);
      const subEl = station?.querySelector(`[data-sub="${id}"]`);
      const choicesEl = station?.querySelector(`[data-choices="${id}"]`);
      const total = TAPS[id] || 5;
      const semitone = SEMI[id] || 0;

      bell.addEventListener('click', () => {
        const taken = tapState[id] || 0;
        if (taken >= total) return;
        const next = taken + 1;
        tapState[id] = next;
        chime(semitone, next - 1);
        if (countEl) countEl.textContent = String(next);
        bell.classList.remove('bell--ring');
        void bell.offsetWidth;
        bell.classList.add('bell--ring');
        if (next === total) {
          if (subEl) subEl.textContent = 'rung — choose your next bell.';
          if (choicesEl) choicesEl.classList.remove('is-closed');
        } else if (subEl) {
          subEl.textContent = (total - next) + ' more · keep tapping';
        }
      });
    });

    document.querySelectorAll('.choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        const go = btn.getAttribute('data-go');
        const isExit = btn.getAttribute('data-exit') === 'true';
        if (!go) return;
        const station = btn.closest('[data-station]');
        const fromId = station?.getAttribute('data-station');
        if (fromId) pushTrail(fromId);
        if (isExit) {
          window.location.href = go;
          return;
        }
        showStation(go);
      });
    });

    restartBtn?.addEventListener('click', resetWalk);
  })();
</script>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 64px 20px 80px; }

  .station.is-closed { display: none; }

  /* Header */
  .code {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ch-800);
    margin: 0 0 10px;
  }
  .head h1 {
    font-family: var(--pc-font-sans, 'Inter Variable', system-ui, sans-serif);
    font-size: 36px;
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 14px;
  }
  .dek {
    font-size: 15px;
    color: var(--pc-ink-soft, #5F5E5A);
    margin: 0 0 28px;
    line-height: 1.55;
  }
  .dek em { font-style: italic; color: var(--ch-800); }

  /* Trail */
  .trail {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 12px;
    padding: 10px 14px;
    margin: 0 0 24px;
    border: 1px dashed var(--pc-rule, #d8d8d8);
    border-radius: 3px;
    background: #fff;
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-soft, #5F5E5A);
  }
  .trail__label { color: var(--pc-ink-soft, #8a8275); }
  .trail__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 10px; }
  .trail__seed { color: #c8c0b0; }
  .trail__step { color: var(--ch-800); }
  .trail__restart {
    margin-left: auto;
    border: 1px solid var(--pc-rule, #d8d8d8);
    background: #fff;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--pc-ink-soft, #5F5E5A);
    padding: 4px 8px;
    border-radius: 2px;
    cursor: pointer;
  }
  .trail__restart:hover { border-color: var(--ch-600); color: var(--ch-800); }
  .trail__restart.is-closed { display: none; }

  /* Bell pad — same gold dome as /404 */
  .bell-pad {
    display: flex; flex-direction: column; align-items: stretch;
    gap: 14px;
    padding: 22px;
    margin: 0 0 28px;
    border: 1.5px solid var(--ch-600);
    border-radius: 4px;
    background:
      radial-gradient(120% 80% at 50% 0%, var(--ch-50), transparent 60%),
      #fff;
  }
  .bell-pad__inner { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .bell {
    position: relative;
    width: 64px; height: 64px;
    border: none; padding: 0; background: none; cursor: pointer;
    flex: 0 0 auto;
  }
  .bell__dome {
    position: absolute; inset: 6px;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 30%, #f6c15e, #b8821a 60%, #6b4d12 100%);
    box-shadow: inset 0 -3px 6px rgba(0,0,0,0.3), 0 2px 6px rgba(0,0,0,0.18);
  }
  .bell__halo {
    position: absolute; inset: 0;
    border-radius: 999px;
    border: 1.5px solid var(--ch-600);
    opacity: 0.35;
    transform: scale(1);
    transition: transform 0.4s ease-out, opacity 0.4s ease-out;
  }
  .bell:hover .bell__halo { opacity: 0.6; }
  .bell--ring .bell__halo { animation: bell-pulse 0.6s ease-out; }
  .bell--ring .bell__dome { animation: bell-shake 0.4s ease-out; }
  @keyframes bell-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    100% { transform: scale(1.9); opacity: 0;   }
  }
  @keyframes bell-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px) rotate(-3deg); }
    75% { transform: translateX(2px)  rotate(3deg);  }
  }
  .bell-pad__caption { flex: 1 1 200px; min-width: 0; }
  .bell-pad__hed {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ch-800);
  }
  .bell-pad__sub {
    font-size: 13px;
    color: var(--pc-ink-soft, #5F5E5A);
    margin-top: 4px;
    line-height: 1.4;
  }
  .bell-pad__count { margin-top: 8px; font-family: var(--pc-font-mono, ui-monospace, monospace); }
  .bell-pad__count-num { font-size: 20px; color: var(--ch-800); font-weight: 600; }
  .bell-pad__count-label { font-size: 12px; color: var(--pc-ink-soft, #5F5E5A); margin-left: 4px; }

  /* Choices — two cards side by side */
  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 4px;
    animation: choices-rise 0.35s ease-out;
  }
  .choices.is-closed { display: none; }
  @keyframes choices-rise {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .choice {
    display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
    text-align: left;
    padding: 12px 14px;
    border: 1.5px solid var(--ch-600);
    background: #fff;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s, transform 0.12s;
  }
  .choice:hover { background: var(--ch-600); color: #fff; transform: translateY(-1px); }
  .choice:hover .choice__sub { color: rgba(255,255,255,0.85); }
  .choice__hed {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ch-800);
  }
  .choice:hover .choice__hed { color: #fff; }
  .choice__sub { font-size: 12.5px; color: var(--pc-ink-soft, #5F5E5A); line-height: 1.4; }
  .choice--exit { border-style: dashed; }

  @media (max-width: 480px) {
    .head h1 { font-size: 28px; }
    .page { padding: 40px 16px 60px; }
    .choices { grid-template-columns: 1fr; }
    .trail__restart { margin-left: 0; }
  }

  /* Footer doors */
  .foot {
    display: flex; flex-wrap: wrap; gap: 16px;
    padding-top: 18px; margin-top: 16px;
    border-top: 1px solid var(--pc-rule, #e6e6e6);
  }
  .foot a {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-soft, #5F5E5A);
    text-decoration: none;
  }
  .foot a:hover { color: var(--ch-800); }
</style>
