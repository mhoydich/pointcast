---
import BlockLayout from '../../layouts/BlockLayout.astro';
import SendSheet from '../../components/SendSheet.astro';
import KennelTodayLive from '../../components/KennelTodayLive.astro';
import '../../styles/home-shelf.css';
import { SEND_SHEETS, SEND_SHEET_LIST, renderSheetText } from '../../lib/send-sheets';

const sheet = SEND_SHEETS['kennel-club'];
const title = sheet.title;
const description = sheet.dek;
const text = renderSheetText(sheet);
const others = SEND_SHEET_LIST.filter((candidate) => candidate.slug !== sheet.slug);
const alternates = [
  { type: 'application/json', href: '/send/kennel-club.json', title: 'Kennel Club one-sheet (JSON)' },
  { type: 'text/plain', href: '/send/kennel-club.txt', title: 'Kennel Club one-sheet (plain text)' },
];
---

<BlockLayout title={title} description={description} immersive={false} alternates={alternates}>
  <main class="home send">
    <nav class="send__crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/send">send</a><span>/</span><span>kennel-club</span></nav>
    <SendSheet sheet={sheet} text={text} />
    <!-- The sheet itself is evergreen; this one line is the only thing on it
         that has a date, so it is read from /api/kennel-club/today on load
         rather than baked in at build. -->
    <a class="send__today" href="/kennel-club" data-kennel-today="text href" data-kennel-text="Today · sitting {day} · {name}, {breed} · {title} →" data-kennel-href="/kennel-club/{slug}">Open the Kennel Club room for today’s sitting →</a>
    <p class="send__machine">Other sheets: {others.map((other, i) => (<>{i > 0 ? ' · ' : ''}<a href={other.href}>{other.href}</a></>))}</p>
  </main>
  <KennelTodayLive />
</BlockLayout>

<style>
  .send { max-width: 960px; padding-top: 14px; }
  .send__crumb { display: flex; gap: 8px; margin: 0 0 6px; font: 400 9px var(--pc-font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--pc-ink-muted); }
  .send__crumb a { color: var(--pc-accent); }
  .send__today { display: block; margin: 16px 0 0; font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--pc-accent); }
  .send__machine { margin: 18px 0 0; font: 400 9px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--pc-ink-muted); overflow-wrap: anywhere; }
  .send__machine a { color: var(--pc-ink); }
</style>
