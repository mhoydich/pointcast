---
/**
 * /send/ai-capital — one-sheet: ways to make capital with AI contributions.
 * The seven lanes of /ai-income with one or two routes each and the honest
 * tier line, then the three rails this town runs with their real numbers,
 * closed with the line from block 0576. No advice, no promises.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import SendSheet from '../../components/SendSheet.astro';
import '../../styles/home-shelf.css';
import { SEND_SHEETS, SEND_SHEET_LIST, renderSheetText } from '../../lib/send-sheets';

const sheet = SEND_SHEETS['ai-capital'];
const title = 'Ways to make capital with AI contributions';
const description =
  'A one-sheet you can text: the seven lanes of the AI income field guide with one or two routes each and their evidence tier, then the three rails PointCast runs itself with their real numbers. No advice, no promises.';
const text = renderSheetText(sheet);
const others = SEND_SHEET_LIST.filter((s) => s.slug !== sheet.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': 'https://pointcast.xyz/send/ai-capital',
  headline: sheet.title,
  description,
  url: 'https://pointcast.xyz/send/ai-capital',
  datePublished: '2026-09-01',
  isPartOf: { '@id': 'https://pointcast.xyz/send' },
  author: { '@type': 'Organization', name: 'PointCast' },
};

const alternates = [
  { type: 'application/json', href: '/send/ai-capital.json', title: 'AI capital one-sheet (JSON)' },
  { type: 'text/plain', href: '/send/ai-capital.txt', title: 'AI capital one-sheet (plain text)' },
];
---

<BlockLayout title={title} description={description} immersive={false} jsonLd={jsonLd} alternates={alternates}>
  <main class="home send">
    <nav class="send__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/send">send</a>
      <span aria-hidden="true">/</span>
      <span>ai-capital</span>
    </nav>
    <SendSheet sheet={sheet} text={text} />
    <p class="send__machine">
      Other sheets: {others.map((s, i) => (<>{i > 0 ? ' · ' : ''}<a href={s.href}>{s.href}</a></>))}
    </p>
  </main>
</BlockLayout>

<style>
  .send { max-width: 960px; padding-top: 14px; }
  .send__crumb {
    display: flex;
    gap: 8px;
    margin: 0 0 6px;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .send__crumb a { color: var(--pc-accent); }
  .send__machine {
    margin: 18px 0 0;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    overflow-wrap: anywhere;
  }
  .send__machine a { color: var(--pc-ink); }
</style>
