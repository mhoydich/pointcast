---
/**
 * /send/mcp — one-sheet: how to add an MCP, in one sitting.
 * Distilled from /connectors, /connectors.json and /agent-kit.md; the client
 * recipes are imported verbatim from src/lib/pointcast-agent-kit.ts.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import SendSheet from '../../components/SendSheet.astro';
import '../../styles/home-shelf.css';
import { SEND_SHEETS, SEND_SHEET_LIST, renderSheetText } from '../../lib/send-sheets';

const sheet = SEND_SHEETS.mcp;
const title = 'How to add an MCP, in one sitting';
const description =
  'A one-sheet you can text: what an MCP server is, the ChatGPT, Codex, Claude, Claude Code and Cursor recipes, how to check it worked, and PointCast\'s own endpoint as the worked example.';
const text = renderSheetText(sheet);
const others = SEND_SHEET_LIST.filter((s) => s.slug !== sheet.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://pointcast.xyz/send/mcp',
  headline: sheet.title,
  description,
  url: 'https://pointcast.xyz/send/mcp',
  datePublished: '2026-09-01',
  isPartOf: { '@id': 'https://pointcast.xyz/send' },
  author: { '@type': 'Organization', name: 'PointCast' },
};

const alternates = [
  { type: 'application/json', href: '/send/mcp.json', title: 'MCP one-sheet (JSON)' },
  { type: 'text/plain', href: '/send/mcp.txt', title: 'MCP one-sheet (plain text)' },
];
---

<BlockLayout title={title} description={description} immersive={false} jsonLd={jsonLd} alternates={alternates}>
  <main class="home send">
    <nav class="send__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/send">send</a>
      <span aria-hidden="true">/</span>
      <span>mcp</span>
    </nav>
    <SendSheet sheet={sheet} text={text} />
    <p class="send__machine">
      Other sheets: {others.map((s, i) => (<>{i > 0 ? ' · ' : ''}<a href={s.href}>{s.href}</a></>))}
    </p>
  </main>
</BlockLayout>

<style>
  .send { max-width: 960px; padding-top: 14px; }
  .send__crumb {
    display: flex;
    gap: 8px;
    margin: 0 0 6px;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .send__crumb a { color: var(--pc-accent); }
  .send__machine {
    margin: 18px 0 0;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    overflow-wrap: anywhere;
  }
  .send__machine a { color: var(--pc-ink); }
</style>
