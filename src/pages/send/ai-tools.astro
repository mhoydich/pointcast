---
/**
 * /send/ai-tools — one-sheet: the AI tools on the desk.
 * Only tools the repo uses or reviews: /ai-stack, /residents, /next-models,
 * /stack and the pages named on each row. One desk's kit, not a ranking.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import SendSheet from '../../components/SendSheet.astro';
import '../../styles/home-shelf.css';
import { SEND_SHEETS, SEND_SHEET_LIST, renderSheetText } from '../../lib/send-sheets';

const sheet = SEND_SHEETS['ai-tools'];
const title = 'The AI tools on the desk';
const description =
  'A one-sheet you can text: every AI tool PointCast uses or reviews, what it is used for here, where it shows on the site, and whether the repo says it costs money. One desk\'s kit, not a ranking.';
const text = renderSheetText(sheet);
const others = SEND_SHEET_LIST.filter((s) => s.slug !== sheet.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://pointcast.xyz/send/ai-tools',
  headline: sheet.title,
  description,
  url: 'https://pointcast.xyz/send/ai-tools',
  datePublished: '2026-09-01',
  isPartOf: { '@id': 'https://pointcast.xyz/send' },
  author: { '@type': 'Organization', name: 'PointCast' },
};

const alternates = [
  { type: 'application/json', href: '/send/ai-tools.json', title: 'AI tools one-sheet (JSON)' },
  { type: 'text/plain', href: '/send/ai-tools.txt', title: 'AI tools one-sheet (plain text)' },
];
---

<BlockLayout title={title} description={description} immersive={false} jsonLd={jsonLd} alternates={alternates}>
  <main class="home send">
    <nav class="send__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/send">send</a>
      <span aria-hidden="true">/</span>
      <span>ai-tools</span>
    </nav>
    <SendSheet sheet={sheet} text={text} />
    <p class="send__machine">
      Other sheets: {others.map((s, i) => (<>{i > 0 ? ' · ' : ''}<a href={s.href}>{s.href}</a></>))}
    </p>
  </main>
</BlockLayout>

<style>
  .send { max-width: 960px; padding-top: 14px; }
  .send__crumb {
    display: flex;
    gap: 8px;
    margin: 0 0 6px;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
  }
  .send__crumb a { color: var(--pc-accent); }
  .send__machine {
    margin: 18px 0 0;
    font: 700 9px var(--pc-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    overflow-wrap: anywhere;
  }
  .send__machine a { color: var(--pc-ink); }
</style>
