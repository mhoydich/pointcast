---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ABSTRACT, PAPER_META, PAPER_NOTES, PLATES, REFERENCES, SECTIONS } from '../lib/menloParkPaper';

const title = `${PAPER_META.title} — UES Working Paper`;
const description = `First entry in 'The Lab and the Radius' UES Working Papers series. ${PAPER_META.publication}.`;

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  '@id': 'https://pointcast.xyz/menlo-park',
  headline: PAPER_META.title,
  name: PAPER_META.title,
  abstract: ABSTRACT,
  url: 'https://pointcast.xyz/menlo-park',
  isPartOf: { '@type': 'Periodical', name: PAPER_META.publication },
  datePublished: PAPER_META.date,
  identifier: PAPER_META.doi,
  keywords: PAPER_META.keywords.join(', '),
  author: PAPER_META.authors.map((a) => ({ '@type': 'Person', name: a.name, affiliation: { '@type': 'Organization', name: a.dept } })),
  publisher: { '@type': 'EducationalOrganization', name: PAPER_META.affiliation, url: 'https://pointcast.xyz/university-of-el-segundo' },
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/menlo-park.json', title: 'Working paper (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/labs">labs</a><span aria-hidden="true">/</span>
      <span>menlo-park</span>
    </nav>

    <header class="masthead">
      <div class="masthead__rule"></div>
      <p class="masthead__pub">{PAPER_META.publication}</p>
      <p class="masthead__no">{PAPER_META.paperNumber} · Series: <a href={PAPER_META.series.hub}>{PAPER_META.series.name}</a> · Position {PAPER_META.series.position}</p>
    </header>

    <article class="article">
      <h1>{PAPER_META.title}</h1>

      <ol class="byline">{PAPER_META.authors.map((a) => (
        <li><strong>{a.name}</strong> · {a.dept} · {PAPER_META.affiliation} · <a href={`mailto:${a.email}`}>{a.email}</a></li>
      ))}</ol>

      <p class="meta">{PAPER_META.date} · DOI {PAPER_META.doi} · Keywords: {PAPER_META.keywords.join(', ')}.</p>

      <section class="abstract">
        <h2>Abstract</h2>
        <p>{ABSTRACT}</p>
      </section>

      <div class="body">
        {SECTIONS.map((s) => (
          <section class="sec" id={`s-${s.number}`}>
            <h2><span class="sec__no">{s.number}</span> {s.title}</h2>
            {s.body.map((p) => (<p set:html={p} />))}
            {s.footnotes && s.footnotes.length > 0 && (
              <ol class="footnotes">{s.footnotes.map((f) => (
                <li id={`fn-${s.number}-${f.mark}`}><sup>{f.mark}</sup> <span set:html={f.text} /></li>
              ))}</ol>
            )}
          </section>
        ))}

        <section class="sec plates" id="plates">
          <h2><span class="sec__no">A</span> Appendix: Specimen Plates</h2>
          <p>The plates below are reconstructions, not photographs.</p>
          <ol class="plate-list">{PLATES.map((p) => (
            <li class={`plate plate--${p.era}`}>
              <figure>
                {p.era === 'campus-1880' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#f4ecd9" />
                    <rect x="10" y="10" width="300" height="260" fill="none" stroke="#1a1a1a" stroke-width="1" stroke-dasharray="4 3" />
                    <rect x="100" y="100" width="120" height="60" fill="#fff" stroke="#1a1a1a" stroke-width="2" />
                    <text x="160" y="124" font-family="serif" font-size="9" text-anchor="middle" fill="#1a1a1a" font-style="italic">Main Lab</text>
                    <text x="160" y="138" font-family="monospace" font-size="8" text-anchor="middle" fill="#5a5450">2 stories · 80×25 ft</text>
                    <rect x="240" y="105" width="50" height="40" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="265" y="128" font-family="serif" font-size="8" text-anchor="middle" fill="#1a1a1a" font-style="italic">Machine</text>
                    <rect x="40" y="105" width="50" height="40" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="65" y="128" font-family="serif" font-size="8" text-anchor="middle" fill="#1a1a1a" font-style="italic">Carbon</text>
                    <rect x="80" y="180" width="50" height="35" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="105" y="201" font-family="serif" font-size="8" text-anchor="middle" fill="#1a1a1a" font-style="italic">Glass</text>
                    <rect x="180" y="180" width="50" height="35" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="205" y="201" font-family="serif" font-size="8" text-anchor="middle" fill="#1a1a1a" font-style="italic">Office</text>
                    <rect x="140" y="50" width="40" height="30" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="160" y="69" font-family="serif" font-size="8" text-anchor="middle" fill="#1a1a1a" font-style="italic">Library</text>
                    <line x1="0" y1="245" x2="320" y2="245" stroke="#1a1a1a" stroke-width="2" />
                    <line x1="0" y1="252" x2="320" y2="252" stroke="#1a1a1a" stroke-width="2" />
                    <text x="160" y="265" font-family="monospace" font-size="9" text-anchor="middle" fill="#5a5450" letter-spacing="1">PENNSYLVANIA RR · TO MANHATTAN ↗ 25 MI</text>
                  </svg>
                )}
                {p.era === 'notebook' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#5a5450" />
                    <rect x="20" y="20" width="280" height="240" fill="#f4ecd9" />
                    {Array.from({length:18}).map((_, i) => (<line x1="40" x2="300" y1={50 + i*12} y2={50 + i*12} stroke="#a8a08c" stroke-width="0.5" />))}
                    <text x="40" y="44" font-family="serif" font-size="11" fill="#1a1a1a" font-style="italic">Oct 21, 1879 — Bulb test #</text>
                    <line x1="40" y1="100" x2="160" y2="100" stroke="#1a1a1a" stroke-width="1" />
                    <circle cx="100" cy="80" r="14" fill="none" stroke="#1a1a1a" stroke-width="1.5" />
                    <line x1="100" y1="80" x2="100" y2="100" stroke="#1a1a1a" stroke-width="1" />
                    <line x1="86" y1="80" x2="114" y2="80" stroke="#1a1a1a" stroke-width="0.6" stroke-dasharray="2 2" />
                    <text x="40" y="124" font-family="serif" font-size="9" fill="#1a1a1a" font-style="italic">Carbonized cotton thread.</text>
                    <text x="40" y="138" font-family="serif" font-size="9" fill="#1a1a1a" font-style="italic">~13 hours continuous light.</text>
                    <text x="40" y="152" font-family="serif" font-size="9" fill="#1a1a1a" font-style="italic">Try platinum tomorrow.</text>
                    <text x="40" y="232" font-family="serif" font-size="9" fill="#1a1a1a" font-style="italic">— T.A. Edison</text>
                    <text x="160" y="232" font-family="serif" font-size="9" fill="#1a1a1a" font-style="italic">— Chas. Batchelor</text>
                    <line x1="35" y1="240" x2="100" y2="240" stroke="#1a1a1a" stroke-width="0.7" />
                    <line x1="155" y1="240" x2="240" y2="240" stroke="#1a1a1a" stroke-width="0.7" />
                  </svg>
                )}
                {p.era === 'team-1879' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#e8e4d8" />
                    <rect x="0" y="200" width="320" height="80" fill="#3a3a3a" />
                    <rect x="20" y="180" width="280" height="20" fill="#5a5450" />
                    <g fill="#1a1a1a">
                      {[40,60,80,100,120,140,160,180,200,220,240,260,280].map((x, i) => {
                        const tall = i % 4 === 0;
                        const head = tall ? 130 : 140;
                        const body = tall ? 170 : 175;
                        return (<g><circle cx={x} cy={head} r="6" /><rect x={x-7} y={head+6} width="14" height={body-head-6} /></g>);
                      })}
                    </g>
                    <circle cx="160" cy="118" r="8" fill="#1a1a1a" />
                    <rect x="151" y="126" width="18" height="48" fill="#1a1a1a" />
                    <text x="160" y="118" font-family="monospace" font-size="6" text-anchor="middle" fill="#fdf9ee" font-weight="700">E</text>
                    <text x="160" y="262" font-family="serif" font-size="11" text-anchor="middle" fill="#fdf9ee" font-style="italic">~40 muckers · Menlo Park · c. 1879</text>
                  </svg>
                )}
                {p.era === 'cadence-chart' && (
                  <svg viewBox="0 0 320 280" class="plate-art" aria-hidden="true">
                    <rect width="320" height="280" fill="#fdf9ee" />
                    <line x1="30" y1="240" x2="300" y2="240" stroke="#1a1a1a" stroke-width="1.5" />
                    <line x1="30" y1="40" x2="30" y2="240" stroke="#1a1a1a" stroke-width="1.5" />
                    <text x="30" y="30" font-family="monospace" font-size="9" fill="#1a1a1a" letter-spacing="1">MINOR INVENTIONS · PER 10-DAY WINDOW</text>
                    <text x="320" y="260" font-family="monospace" font-size="9" text-anchor="end" fill="#1a1a1a" letter-spacing="1">1876 → 1886</text>
                    {[2,3,2,4,3,5,7,8,6,7,9,11,12,9,8,7,6,5,4,5,6,8,9,10,7,6,5,4,3,4,3].map((h, i) => (
                      <rect x={30 + i*9} y={240 - h*10} width="6" height={h*10} fill="#1a1a1a" />
                    ))}
                    <line x1="135" y1="40" x2="135" y2="240" stroke="#2a5a8a" stroke-width="0.7" stroke-dasharray="3 3" />
                    <text x="138" y="55" font-family="monospace" font-size="8" fill="#2a5a8a">BULB · 1879</text>
                    <line x1="180" y1="40" x2="180" y2="240" stroke="#2a5a8a" stroke-width="0.7" stroke-dasharray="3 3" />
                    <text x="183" y="55" font-family="monospace" font-size="8" fill="#2a5a8a">PEARL ST · 1880</text>
                  </svg>
                )}
                <figcaption><strong>{p.figure}.</strong> {p.caption}</figcaption>
              </figure>
            </li>
          ))}</ol>
        </section>

        <section class="sec acks">
          <h2><span class="sec__no">B</span> Acknowledgments</h2>
          <p>{PAPER_NOTES.acknowledgments}</p>
        </section>

        <section class="sec series-note">
          <h2><span class="sec__no">S</span> Series Note</h2>
          <p>{PAPER_NOTES.seriesNote}</p>
        </section>

        <section class="sec refs" id="references">
          <h2><span class="sec__no">R</span> References</h2>
          <ol>{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
        </section>

        <section class="sec colophon">
          <h2><span class="sec__no">C</span> Colophon</h2>
          <p><em>{PAPER_NOTES.uesNote}</em> Set in JetBrains Mono and Georgia. Specimen plates are SVG reconstructions, not photographs of recovered objects. The text is a tribute. The voice is scholarly; the affection is sincere.</p>
          <p class="ref-back"><a href="/labs">← The Lab and the Radius (series hub)</a> · <a href="/trapper-keeper">UES-WP-2026-04 Trapper Keeper</a> · <a href="/walkman">UES-WP-2026-05 Walkman</a> · <a href="/menlo-park.json">JSON</a></p>
        </section>
      </div>
    </article>
  </div>
</BlockLayout>

<style>
  .paper { max-width: 760px; margin: 0 auto; padding: 0 24px 88px; background: #fdf9ee; color: #1a1a1a; font-family: Georgia, "Times New Roman", serif; }
  .crumb { padding: 18px 0 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }
  .masthead { padding: 14px 0 18px; }
  .masthead__rule { height: 6px; background: #1a1a1a; margin: 0 0 8px; }
  .masthead__pub { margin: 0; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }
  .masthead__no { margin: 4px 0 0; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .masthead__no a { color: #1a1a1a; }
  .article h1 { font-family: Georgia, serif; font-size: 36px; line-height: 1.18; font-weight: 700; margin: 24px 0 14px; max-width: 30ch; }
  .byline { list-style: none; padding: 0; margin: 0 0 8px; font-size: 14px; font-style: italic; }
  .byline li { margin-bottom: 4px; }
  .byline a { color: inherit; }
  .meta { margin: 0 0 28px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .04em; color: #5a5450; }
  .abstract { padding: 14px 18px; margin: 0 0 28px; background: #f4ecd9; border-left: 4px solid #1a1a1a; border-right: 4px solid #1a1a1a; }
  .abstract h2 { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin: 0 0 8px; }
  .abstract p { margin: 0; font-size: 14px; line-height: 1.6; font-style: italic; }
  .body { font-size: 16px; line-height: 1.65; }
  .sec { margin: 0 0 28px; }
  .sec h2 { font-size: 19px; line-height: 1.25; font-weight: 700; margin: 24px 0 10px; padding-top: 10px; border-top: 1px solid #1a1a1a; display: flex; gap: 10px; align-items: baseline; }
  .sec__no { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .08em; color: #2a5a8a; min-width: 24px; }
  .sec p { margin: 0 0 12px; }
  .sec p em { font-style: italic; }
  .sec p strong { font-weight: 700; }
  .sec p sup { font-size: .75em; }
  .footnotes { list-style: none; padding: 12px 0 0; margin: 16px 0 0; border-top: 1px solid #c8c4b3; font-size: 13px; line-height: 1.55; color: #2a2a2a; }
  .footnotes li { margin-bottom: 6px; padding-left: 16px; position: relative; }
  .footnotes li sup { position: absolute; left: 0; top: 0; font-family: var(--pc-font-mono); font-size: 11px; color: #2a5a8a; }
  .plate-list { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 18px; grid-template-columns: 1fr 1fr; }
  .plate-list li { background: #fff; border: 1px solid #1a1a1a; padding: 10px; }
  .plate-art { width: 100%; height: auto; display: block; aspect-ratio: 320 / 280; }
  figcaption { margin-top: 10px; font-size: 12px; line-height: 1.5; color: #2a2a2a; }
  figcaption strong { font-weight: 700; }
  .acks p,.series-note p { font-style: italic; }
  .refs ol { padding-left: 20px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 8px; }
  .refs li em { font-style: italic; }
  .colophon p { font-size: 13px; }
  .colophon a { color: inherit; }
  .ref-back { margin-top: 14px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; }
  @media (max-width: 620px) {
    .article h1 { font-size: 26px; }
    .plate-list { grid-template-columns: 1fr; }
    .paper { padding-inline: 18px; }
  }
</style>
