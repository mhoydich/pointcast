---
import BlockLayout from '../layouts/BlockLayout.astro';
import { MONEY, NOTE_DESIGNS, NORDIC_STUDIES } from '../lib/nouns-money';
import '../styles/nouns-money.css';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: 'Nouns Money — collectible art',
  url: MONEY.canonical, description: MONEY.disclosure, datePublished: MONEY.publishedAt,
  creator: {'@type': 'Person', name: 'Mike Hoydich'}, author: {'@type': 'Organization', name: 'Codex'},
  isAccessibleForFree: true, genre: 'Independent collectible art concept',
};
---
<BlockLayout title="Nouns Money · collect a little, pass a story" description="Collect Nouns Money: ten joyful paper-art designs using actual CC0 Nouns, a saved design set, serial stories and a small physical-edition build scope. Collectible art, never cash." image="/images/og/nouns-money.png" themeColor="#f6edcd" immersive hideAds showNetworkStrip={false} jsonLd={jsonLd} alternates={[{type:'application/json', href:'/nouns-money.json', title:'Nouns Money · machine edition'}]}>
  <main class="nm" id="main-content" data-nouns-money>
    <div id="top"></div>
    <div class="nm-top"><a href="/">POINTCAST ↗</a><span>CH.ESC · ART IN CIRCULATION</span><a href="/nouns-money.json">MACHINE EDITION</a></div>
    <header class="nm-hero">
      <div class="nm-hero-copy">
        <p class="nm-kicker">COLLECTIBLE ART CONCEPT · FIRST SET / 2026</p>
        <h1>Nouns<br/><em>Money.</em></h1>
        <p class="nm-motto">Collect a little.<br/>Pass a story.</p>
        <p class="nm-dek">Ten new ways to hold a Noun. Find your favorite, build a set, imagine where it goes next.</p>
        <nav aria-label="Inside Nouns Money"><a class="nm-button" href="#collection">Let’s collect ↓</a><a href="#nordic-2027">2027 studies ↗</a><a href="#journeys">Follow a serial ↗</a></nav>
        <p class="nm-disclosure">Collectible paper art, never cash. Independent concept. No banking, deposits, cash redemption or financial offer.</p>
      </div>
      <div class="nm-hero-art" aria-label="A stack of Nouns Money collectible designs">
        <span class="nm-roundel">TEN<br/>DESIGNS<br/><i>one first set</i></span>
        <img class="nm-stack nm-stack-back" src="/images/nouns-money/10-golden-cosmos.webp" width="1500" height="750" alt="Nouns Money Golden Cosmos design, using original numbered Nouns artwork"/>
        <img class="nm-stack nm-stack-mid" src="/images/nouns-money/01-acid-assembly.webp" width="1500" height="750" alt="Nouns Money Acid Assembly design, using original numbered Nouns artwork"/>
        <img class="nm-stack nm-stack-front" src="/images/nouns-money/03-ultra-ten.webp" width="1500" height="750" alt="Nouns Money Ultra Ten design, using original numbered Nouns artwork" fetchpriority="high"/>
        <p class="nm-hero-caption">LET’S COLLECT NOUNS MONEY.<br/>THE GOOD PART IS WHAT HAPPENS NEXT.</p>
      </div>
    </header>
    <div class="nm-ribbon"><span>ACTUAL NOUNS · CC0 ART</span><span>⌐◨-◨</span><span>COLLECT · ART-TRADE · TELL A STORY</span></div>
    <section class="nm-section nm-intro" aria-labelledby="idea-title">
      <div><p class="nm-kicker">LET’S MAKE A GREAT SET</p><h2 id="idea-title">A favorite.<br/>A few friends.<br/><em>A whole set.</em></h2></div>
      <div><p class="nm-lead">The joy of a trading card. The character of an old concert ticket. Actual Nouns, remade as little paper worlds.</p><p>“Money” is the art idea. These designs are collectibles for voluntary art trades. Their numbers and serials carry no monetary value, redemption promise, NFT rights or ownership claim.</p><div class="nm-status"><strong>Here today</strong><p>Ten designs, original-art downloads, a saved design set in this browser and a read-only machine edition.</p><strong>Up ahead</strong><p>A physical print edition, hosted art table, moderated serial stories and possible Tezos companions.</p></div></div>
    </section>
    <section class="nm-section nm-collection" id="collection" aria-labelledby="collection-title">
      <div class="nm-heading"><div><p class="nm-kicker">NOUNS MONEY · FIRST SET</p><h2 id="collection-title">Which one<br/><em>is yours?</em></h2></div><p>Save the designs you love. This is a personal design list in this browser, not proof of owning a paper note or an NFT. No account needed. <a href="https://nouns.wtf/brand">About the CC0 Nouns art ↗</a></p></div>
      <div class="nm-set-bar"><div><span class="nm-kicker">MY SAVED DESIGNS</span><p data-set-count aria-live="polite" aria-atomic="true">0 / 10 saved</p></div><div class="nm-set-actions"><button type="button" data-set-export>Export my set ↗</button><a href={MONEY.download} download>Download all ten originals ↓</a></div></div>
      <p class="nm-storage" data-set-storage role="status">Saved on this device only. Clearing browser data removes the saved list; export a copy to keep it.</p>
      <noscript><p class="nm-storage">The gallery and downloads work without JavaScript. Enable JavaScript to save a design set in this browser.</p></noscript>
      <div class="nm-note-grid">{NOTE_DESIGNS.map((note, i)=><article class="nm-note" data-note-card={note.id}>
        <a class="nm-note-art" href={`/images/nouns-money/${note.file}.svg`} aria-label={`Open ${note.name} original SVG`}><img src={`/images/nouns-money/${note.file}.webp`} alt={`${note.name}: Nouns Money collectible art design using actual Nouns ${note.nouns.map(n=>`#${n}`).join(', ')}`} width="1500" height="750" loading="lazy"/></a>
        <div class="nm-note-caption"><div><p class="nm-kicker">{String(i+1).padStart(2,'0')} / {note.series}</p><h3>{note.name}</h3><p class="nm-note-nouns">{note.nouns.map(n=>`NOUN #${n}`).join(' · ')} · {note.specimenId}</p></div><button type="button" data-save-design={note.id} aria-pressed="false" aria-label={`Save ${note.name}`}>Save design +</button></div>
        <a class="nm-flat-link" href={`/images/nouns-money/${note.file}.svg`} download>Flat original SVG ↗</a>
      </article>)}</div>
      <p class="nm-footnote"><a href="/images/nouns-money/provenance.json">Read the artwork provenance</a>. Original Noun pixels and colors are preserved in the flat designs. NM-A identifiers label designs; they are not unique issued-note serials. Independent CC0 art use implies neither ownership of the source NFTs nor Nouns DAO endorsement. These are design prototypes; no physical edition has been manufactured or verified.</p>
    </section>
    <section class="nm-section nm-nordic" id="nordic-2027" aria-labelledby="nordic-title">
      <div class="nm-heading"><div><p class="nm-kicker">TEN NEW VISUAL STUDIES · NORDIC / 2027</p><h2 id="nordic-title">Nordic notes.<br/><em>A 2027 daydream.</em></h2></div><p>A Swedish-inspired currency direction: generous numerals, quiet color, fine lines and translucent-window effects. Generated from authentic Nouns references; these are visual interpretations, not the exact-source print masters above.</p></div>
      <div class="nm-nordic-grid">{NORDIC_STUDIES.map((note,i)=><figure><a href={`/images/nouns-money/nordic-2027/${note.file}.webp`}><img src={`/images/nouns-money/nordic-2027/${note.file}.webp`} width="1400" height="700" loading="lazy" alt={`${note.name}, a generated Nordic 2027 Nouns Money currency-inspired concept using a reference to Noun #${note.referenceNoun}; visual effects only`}/></a><figcaption><span>{String(i+1).padStart(2,'0')} / {note.name}</span><span>GENERATED STUDY</span></figcaption></figure>)}</div>
      <p class="nm-footnote">Concept art, never legal tender. The engraved, iridescent and translucent details are proposed visual effects; no material, authentication or security functionality has been made or tested. Printed numbers and serial-like marks are fictional design elements. Use Collection 01’s original SVG/PNG files for exact-source artwork; these images are not production-ready files.</p>
    </section>
    <section class="nm-section nm-print" id="paper" aria-labelledby="paper-title">
      <div class="nm-heading"><div><p class="nm-kicker">FROM SCREEN TO A SMALL STACK · PROPOSED</p><h2 id="paper-title">Pick up from<br/><em>the printer.</em></h2></div><p>Then a soft fold. A pocket. A good afternoon. A physical edition could gain character as it travels. This photographic mockup imagines a physical collection; it is not a pixel-exact print source or evidence of production. The downloadable flat artwork is authoritative.</p></div>
      <div class="nm-paper-story"><figure><img src="/images/nouns-money/physical-collection.webp" width="1536" height="1024" alt="Generated photographic mockup of four Nouns Money designs, a matte-paper stack and an archival sleeve; not evidence of physical production" loading="lazy"/><figcaption>GENERATED PHOTOGRAPHIC MOCKUP · PHYSICAL EDITION PROPOSED</figcaption></figure><div><ol><li><span>01 / PRINTER PICKUP</span><p>Check the proof. Square corners, clear pixels, the paper that feels right.</p></li><li><span>02 / A LITTLE WEATHERED</span><p>A soft fold and a worn edge. Character belongs to the object, never a price chart.</p></li><li><span>03 / WELL TRAVELLED</span><p>Someone adds a story. Someone else gets curious. The next chapter begins.</p></li></ol></div></div>
      <dl class="nm-spec"><div><dt>DESIGN TRIM</dt><dd>{MONEY.noteSpec.trimMm.join(' × ')} mm</dd></div><div><dt>ARTWORK</dt><dd>Actual numbered Nouns</dd></div><div><dt>EDITION</dt><dd>Front-face prototypes</dd></div><div><dt>PHYSICAL PROOF</dt><dd>Still to be made</dd></div></dl>
      <p class="nm-footnote">{MONEY.noteSpec.printerHandoff} RGB previews, outlined lettering and 3600 × 1800 px originals. No calibrated CMYK, bleed, crop marks, duplex backs or paper proof. No printer order or finishing guarantee is claimed.</p>
    </section>
    <section class="nm-section nm-journeys" id="journeys" aria-labelledby="journey-title">
      <div class="nm-heading"><div><p class="nm-kicker">SERIALS &amp; STORIES · THE NEXT IDEA</p><h2 id="journey-title">Every little note.<br/><em>A little life.</em></h2></div><p>A proposed art-trade ritual: choose a note, share something creative, leave an optional trace. Participation would always be voluntary.</p></div>
      <div class="nm-three">{MONEY.exchange.map(item=><article><span class="nm-step">{item.step}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      <div class="nm-ledger"><div><p class="nm-kicker">FICTIONAL SERIAL EXAMPLE</p><h3>NM-001-DEMO</h3><p>Three imagined stops. One story in the making.</p></div><ol><li><span>01 · FIRST PROOF</span><p>One last color check. A blank reverse waiting for a story.</p></li><li><span>02 · ART TABLE</span><p>A drawing changes hands. Someone chooses their favorite.</p></li><li><span>03 · A FRIEND’S POCKET</span><p>Folded once. Carried home. Ready for a new chapter.</p></li></ol><p class="nm-footnote">All stops are imagined. No real participants, transfer records or public submission service exist. Saved designs above are a local list, separate from this proposed serial service.</p></div>
    </section>
    <section class="nm-section nm-build" id="build" aria-labelledby="build-title"><div class="nm-heading"><div><p class="nm-kicker">LEAN BUILD SCOPE · COLLECTING FIRST</p><h2 id="build-title">A set today.<br/><em>A table next.</em></h2></div><p>A proposed sequence for a small team. Timing is an estimate. Each step starts with a useful object and a clear reason to make the next one.</p></div><div class="nm-phases">{MONEY.phases.map(item=><article><span class="nm-step">{item.phase}</span><div><p class="nm-kicker">{item.status}</p><h3>{item.title}</h3><p>{item.scope}</p><p class="nm-exit"><strong>Ready when:</strong> {item.exit}</p></div></article>)}</div></section>
    <section class="nm-section nm-context" aria-labelledby="context-title"><p class="nm-kicker">FUTURE ADVENTURES · SECONDARY CONCEPT CONTEXT</p><h2 id="context-title">Somewhere<br/><em>to get together.</em></h2><div class="nm-context-grid"><details><summary>El Segundo · a possible art afternoon</summary><p>Start with a hosted table or temporary gallery. An operating Citizens Business Bank at 275 Main Street is a likely reference to Mike’s “citizen,” but the intended bank is uncertain. It is unaffiliated, and no sale, acquisition, partnership or owner permission is established.</p><p>Any venue needs verified availability, permitted use, accessibility, insurance and written host or owner permission.</p><a href={MONEY.localResearch.source}>Official bank locator ↗</a><a href={MONEY.localResearch.planningSource}>City planning framework ↗</a><p class="nm-footnote">Location research checked 2 October 2026. No property price, live lease quote or merchant commitment.</p></details><details><summary>Adventure DAO · people + agents</summary><p>{MONEY.adventure.description}</p><ul>{MONEY.adventure.missions.map(item=><li>{item}</li>)}</ul><p class="nm-footnote">{MONEY.adventure.disclosure}</p></details></div></section>
    <footer class="nm-footer"><img src="/images/nouns-money/noun-0000-original.svg" width="96" height="96" alt="Actual original Noun #0" loading="lazy"/><div><p class="nm-kicker">A SMALL ORIGINAL OPINION · CODEX</p><p>{MONEY.opinion.text}</p><p class="nm-credit">Direction: Mike Hoydich · Writing &amp; build: Codex · Nouns artwork: CC0</p><a href="/nouns-money.json">Read the machine edition ↗</a><a href="#top">Back to the collection ↑</a></div></footer>
    <script type="application/json" id="nouns-money-catalog" set:html={JSON.stringify(NOTE_DESIGNS).replaceAll('<','\\u003c')}/>
  </main>
</BlockLayout>
<script>
  import { initNounsMoney } from '../scripts/nouns-money-client.mjs';
  initNounsMoney();
  document.addEventListener('astro:page-load',initNounsMoney);
</script>
