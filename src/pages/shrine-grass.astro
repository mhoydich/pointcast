---
/**
 * /shrine-grass — sit with the breath, watch the grass sway.
 *
 * Fourth elemental shrine, third interaction shape. Where /shrine-water
 * is single-event, /shrine-flame is toggle-grid, /shrine-stone is
 * accumulate, /shrine-grass is *timed*. The page runs a slow breath
 * cycle (4 inhale · 2 hold · 6 exhale = 12 second cycle); the central
 * orb expands and contracts with the breath, the grass behind it leans
 * in the wind that is your breath. Counter quietly increments after
 * each completed cycle.
 *
 * Audio:
 *   • Inhale: rising filtered-noise wash (lowpass center 200→800Hz)
 *   • Hold:   silence
 *   • Exhale: falling filtered-noise wash (800→200Hz)
 *   • Through the shared 2.2s convolution reverb used by every shrine
 *     in this family — same sonic room as water, flame, stone.
 *
 * State (localStorage 'pc:shrine-grass:v1'):
 *   { cyclesCompleted, lifetime, longestSession, firstVisit, lastVisit }
 *   cyclesCompleted resets on tab close; lifetime accumulates;
 *   longestSession tracks the longest unbroken sit you've ever done.
 *
 * The breath rhythm is the existing PointCast PR #654 "next wave
 * breathing" pace but distilled into a single contemplative page.
 *
 * Shipped 2026-05-16. Fifth new shrine. Wind / breath element.
 * — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Shrine of Grass — sit with the breath"
  description="A slow breath cycle and a field of tall grass. The orb expands as you inhale, holds, contracts as you exhale. Sit for one cycle or fifty. Local-only — no accounts, no telemetry, no streak shaming."
  image="/images/og-drum.png"
>
  <main class="shg" id="shg" data-built={built}>
    <!-- Backdrop: golden-hour grass placeholder -->
    <div class="shg__backdrop" id="shg-backdrop" aria-hidden="true"></div>

    <!-- Grass blades — rendered as SVG inline-blocks for crisp swaying -->
    <div class="shg__grass" id="shg-grass" aria-hidden="true"></div>

    <!-- The card -->
    <article class="shg__card" id="shg-card">
      <header class="shg__head">
        <p class="shg__kicker">SHRINE · GRASS · SIT WITH THE BREATH</p>
        <h1 class="shg__title">Breathe with the field.</h1>
        <p class="shg__sub">A 12-second cycle: <em>in</em> for four, <em>hold</em> for two, <em>out</em> for six. The orb shows the breath; the grass leans with it. Stay one cycle or fifty.</p>
      </header>

      <!-- Breath orb + phase label -->
      <div class="shg__breath" id="shg-breath" role="img" aria-label="Breath cycle">
        <div class="shg__orb" id="shg-orb">
          <div class="shg__orb-inner" id="shg-orb-inner"></div>
        </div>
        <p class="shg__phase" id="shg-phase">begin</p>
        <p class="shg__cycle-label" id="shg-cycle-label">cycle 0</p>
      </div>

      <!-- Controls -->
      <div class="shg__controls">
        <button class="shg__btn shg__btn--play" id="shg-toggle" type="button">▶ begin</button>
      </div>

      <!-- Foot -->
      <footer class="shg__foot">
        <p class="shg__count" id="shg-count">your first visit</p>
        <p class="shg__links">
          <a href="/shrine-water">↗ /shrine-water</a>
          <span class="shg__dot">·</span>
          <a href="/shrine-flame">↗ /shrine-flame</a>
          <span class="shg__dot">·</span>
          <a href="/shrine-stone">↗ /shrine-stone</a>
          <span class="shg__dot">·</span>
          <a href="/shrine-bird">↗ /shrine-bird</a>
          <span class="shg__dot">·</span>
          <a href="/aviary">↗ /aviary</a>
        </p>
      </footer>
    </article>
  </main>

  <style is:global>
    :root {
      --shg-ink: #050a06;
      --shg-deep: #0c1810;
      --shg-grass-1: #4a6a3a;
      --shg-grass-2: #5e7d4a;
      --shg-grass-3: #7a9460;
      --shg-grass-4: #98ad7c;
      --shg-golden: #f6d29a;
      --shg-mist: #d8e0b8;
      --shg-cream: #f4ede0;
      --shg-cream-dim: rgba(244, 237, 224, 0.62);
      --shg-cream-dimmer: rgba(244, 237, 224, 0.34);
      --shg-accent: #d8c89b;
      --shg-card-bg: rgba(8, 16, 10, 0.42);
      --shg-card-border: rgba(244, 237, 224, 0.12);
      /* Breath phase: 0..1, animated by JS. Used by grass + orb. */
      --breath: 0;
    }

    html, body { background: var(--shg-ink); margin: 0; padding: 0; height: 100%; }
    body:has(.shg) {
      color: var(--shg-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .shg {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* BACKDROP — golden-hour field placeholder */
    .shg__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 50% 18%, rgba(246, 210, 154, 0.22) 0%, transparent 50%),
        radial-gradient(ellipse at 30% 80%, rgba(74, 106, 58, 0.55) 0%, transparent 60%),
        linear-gradient(180deg, #0c1810 0%, #1a2a18 50%, #2a3a22 100%);
      animation: shgBackdrop 36s ease-in-out infinite alternate;
    }
    @keyframes shgBackdrop {
      0%   { filter: brightness(1.0); }
      100% { filter: brightness(1.06); }
    }
    .shg__backdrop--image {
      background-image: url('/images/shrines/shrine-grass.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    .shg__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(5, 10, 6, 0.50) 95%);
      pointer-events: none;
    }

    /* GRASS — SVG blades along the bottom, lean with the breath */
    .shg__grass {
      position: absolute;
      left: 0; right: 0;
      bottom: 0;
      height: 38vh;
      max-height: 320px;
      z-index: 1;
      pointer-events: none;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding: 0 2vw;
    }
    .shg__blade {
      flex: 1;
      max-width: 14px;
      transform-origin: 50% 100%;
      /* Each blade leans based on breath phase; per-blade offset via CSS var */
      transform: rotate(calc((var(--breath) - 0.5) * var(--blade-tilt, 16deg)
                             + var(--blade-base, 0deg)));
      transition: transform 50ms linear;
      opacity: var(--blade-opacity, 0.85);
    }
    .shg__blade svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .shg__blade-shape {
      fill: var(--blade-color, var(--shg-grass-2));
    }

    /* CARD */
    .shg__card {
      position: relative;
      z-index: 2;
      max-width: 480px;
      width: 100%;
      padding: 36px 32px 24px;
      background: var(--shg-card-bg);
      border: 1px solid var(--shg-card-border);
      border-radius: 28px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.50),
        0 8px 24px rgba(0, 0, 0, 0.30),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: shgCardEnter 1.6s cubic-bezier(0.16, 0.84, 0.30, 1.00) both;
    }
    @keyframes shgCardEnter {
      0%   { opacity: 0; transform: translateY(28px) scale(0.96); filter: blur(8px); }
      50%  { opacity: 0.9; filter: blur(2px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* HEAD */
    .shg__head { margin-bottom: 22px; }
    .shg__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--shg-cream-dim);
      text-transform: uppercase;
      margin: 0 0 14px;
      font-weight: 500;
    }
    .shg__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: clamp(28px, 4vw, 36px);
      letter-spacing: -0.020em;
      line-height: 1.12;
      margin: 0 0 12px;
      color: var(--shg-cream);
    }
    .shg__sub {
      font-size: 14px;
      line-height: 1.55;
      color: var(--shg-cream-dim);
      margin: 0;
    }
    .shg__sub em {
      color: var(--shg-accent);
      font-style: normal;
      font-weight: 500;
    }

    /* BREATH ORB */
    .shg__breath {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: 0 0 18px;
    }
    .shg__orb {
      position: relative;
      width: 168px;
      height: 168px;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(calc(0.55 + var(--breath) * 0.45));
      transition: transform 50ms linear;
    }
    .shg__orb-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background:
        radial-gradient(circle at 40% 35%,
          rgba(246, 210, 154, calc(0.30 + var(--breath) * 0.30)) 0%,
          rgba(216, 200, 155, calc(0.20 + var(--breath) * 0.20)) 40%,
          rgba(120, 140, 90, 0.12) 80%,
          transparent 100%);
      box-shadow:
        0 0 calc(20px + var(--breath) * 60px) rgba(246, 210, 154, calc(0.18 + var(--breath) * 0.30)),
        inset 0 0 30px rgba(216, 200, 155, 0.18);
      transition: box-shadow 100ms linear, background 100ms linear;
    }
    .shg__phase {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 18px;
      color: var(--shg-cream);
      margin: 4px 0 0;
      letter-spacing: 0.01em;
      min-height: 1.2em;
      transition: color 400ms ease;
    }
    .shg__cycle-label {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.18em;
      color: var(--shg-cream-dimmer);
      text-transform: uppercase;
      margin: 0;
    }

    /* CONTROLS */
    .shg__controls {
      display: flex;
      justify-content: center;
      margin-bottom: 18px;
    }
    .shg__btn {
      border: 1px solid rgba(216, 200, 155, 0.32);
      background: rgba(216, 200, 155, 0.10);
      color: var(--shg-accent);
      padding: 10px 22px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background 200ms ease, border-color 200ms ease, transform 80ms ease;
    }
    .shg__btn:hover {
      background: rgba(216, 200, 155, 0.18);
      border-color: rgba(216, 200, 155, 0.55);
    }
    .shg__btn:active { transform: scale(0.97); }
    .shg__btn--running {
      background: rgba(244, 237, 224, 0.04);
      border-color: rgba(244, 237, 224, 0.18);
      color: var(--shg-cream-dim);
    }

    /* FOOTER */
    .shg__foot { text-align: center; }
    .shg__count {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 14px;
      color: var(--shg-cream-dim);
      margin: 0 0 10px;
      letter-spacing: 0.01em;
      min-height: 1.4em;
    }
    .shg__count strong { color: var(--shg-accent); font-weight: 600; font-style: normal; }
    .shg__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--shg-cream-dimmer);
      margin: 0;
    }
    .shg__links a {
      color: var(--shg-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .shg__links a:hover { color: var(--shg-cream); }
    .shg__dot { display: inline-block; margin: 0 4px; opacity: 0.4; }

    @media (max-width: 480px) {
      .shg__card { padding: 28px 22px 20px; border-radius: 22px; }
      .shg__orb { width: 140px; height: 140px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .shg__card, .shg__backdrop { animation: none; }
      .shg__orb, .shg__orb-inner, .shg__blade { transition: none; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ─── Breath cycle: 4s inhale · 2s hold · 6s exhale · 0s rest = 12s ────
    const INHALE_MS = 4000;
    const HOLD_MS   = 2000;
    const EXHALE_MS = 6000;
    const REST_MS   = 0;
    const CYCLE_MS  = INHALE_MS + HOLD_MS + EXHALE_MS + REST_MS;

    type Phase = 'idle' | 'inhale' | 'hold' | 'exhale' | 'rest';

    // ─── State ─────────────────────────────────────────────────────────────
    const STORAGE_KEY = 'pc:shrine-grass:v1';
    interface GrassState {
      lifetime: number;
      longestSession: number;
      firstVisit: number;
      lastVisit: number;
    }
    function freshState(): GrassState {
      return { lifetime: 0, longestSession: 0, firstVisit: Date.now(), lastVisit: Date.now() };
    }
    function loadState(): GrassState {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          if (p && typeof p.lifetime === 'number') {
            return {
              lifetime: p.lifetime,
              longestSession: typeof p.longestSession === 'number' ? p.longestSession : 0,
              firstVisit: p.firstVisit || Date.now(),
              lastVisit: p.lastVisit || Date.now(),
            };
          }
        }
      } catch { /* ignore */ }
      return freshState();
    }
    function saveState(s: GrassState) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch { /* ignore */ }
    }

    // ─── Grass blades ──────────────────────────────────────────────────────
    const BLADE_COUNT = 40;
    function fract(n: number) { return n - Math.floor(n); }

    function renderGrass() {
      const wrap = document.getElementById('shg-grass')!;
      wrap.innerHTML = '';
      // Each blade gets a deterministic tilt-amount, base-angle, color shade,
      // height, and opacity derived from its index. Some blades sway more
      // than others, like a real field.
      for (let i = 0; i < BLADE_COUNT; i++) {
        const tilt = 8 + fract(i * 1.6180339) * 14;   // 8..22 deg of sway
        const base = (fract(i * 0.7548776) - 0.5) * 8; // ±4 deg resting tilt
        const height = 80 + fract(i * 2.7182818) * 130; // 80..210 px tall
        const opacity = 0.55 + fract(i * 1.4142135) * 0.45; // 0.55..1.00
        // Color: pick from 4 grass shades, biased lighter toward the back
        const colors = [
          'var(--shg-grass-1)',
          'var(--shg-grass-2)',
          'var(--shg-grass-3)',
          'var(--shg-grass-4)',
        ];
        const colorIdx = Math.floor(fract(i * 3.1415926) * colors.length);
        const color = colors[colorIdx];
        // Wider, shorter blades in front; thinner, taller in back
        const width = 5 + fract(i * 0.5772156) * 9; // 5..14 px wide at base
        // Asymmetric svg blade shape: pointed teardrop curving slightly
        const lean = fract(i * 2.2360679) - 0.5; // -0.5..0.5 — blade curve direction
        const path = `M ${width / 2} ${height} ` +
                     `Q ${width / 2 + lean * width * 0.6} ${height * 0.5} ` +
                     `${width / 2 + lean * width * 0.3} 0 ` +
                     `Q ${width / 2 - lean * width * 0.4} ${height * 0.5} ` +
                     `${width / 2} ${height} Z`;
        const blade = document.createElement('span');
        blade.className = 'shg__blade';
        blade.style.setProperty('--blade-tilt', `${tilt}deg`);
        blade.style.setProperty('--blade-base', `${base}deg`);
        blade.style.setProperty('--blade-opacity', String(opacity));
        blade.style.setProperty('--blade-color', color);
        blade.style.maxWidth = `${width}px`;
        blade.innerHTML = `<svg viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg">` +
                          `<path class="shg__blade-shape" d="${path}" /></svg>`;
        wrap.appendChild(blade);
      }
    }

    // ─── Audio ─────────────────────────────────────────────────────────────
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let activeBreathSrc: AudioBufferSourceNode | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.30;
      masterGain.connect(ctx.destination);
      // Same 2.2s reverb as the other shrines — same sonic room.
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 2.2);
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.4);
        }
      }
      convolver.buffer = ir;
      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.55;
      wetGain.gain.value = 0.35;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }
    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    // A breath sound: filtered noise that sweeps lowpass-center across the
    // breath duration. `rising` controls direction (inhale vs exhale).
    function playBreath(durMs: number, rising: boolean) {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const durSec = durMs / 1000;
      // Generate pink-ish noise buffer
      const bufLen = Math.floor(ctx.sampleRate * durSec);
      const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      let last = 0;
      for (let i = 0; i < bufLen; i++) {
        // Pinkish via low-pass via running average
        const sample = (Math.random() * 2 - 1) * 0.6 + last * 0.4;
        data[i] = sample;
        last = sample;
      }
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.Q.value = 1.2;
      // Sweep lowpass center
      if (rising) {
        filter.frequency.setValueAtTime(180, t);
        filter.frequency.exponentialRampToValueAtTime(820, t + durSec * 0.95);
      } else {
        filter.frequency.setValueAtTime(820, t);
        filter.frequency.exponentialRampToValueAtTime(180, t + durSec * 0.95);
      }
      const g = ctx.createGain();
      // Soft attack and release, gentle middle
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.10, t + durSec * 0.15);
      g.gain.exponentialRampToValueAtTime(0.06, t + durSec * 0.85);
      g.gain.exponentialRampToValueAtTime(0.0001, t + durSec);
      src.connect(filter).connect(g);
      connectVoice(g);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + durSec + 0.05);
      activeBreathSrc = src;
    }

    // ─── Breath engine ─────────────────────────────────────────────────────
    let isRunning = false;
    let phase: Phase = 'idle';
    let cycleCount = 0;           // this session
    let cycleStartedAt = 0;       // ms timestamp of current cycle's start
    let rafHandle: number | null = null;
    let phaseTimerHandle: number | null = null;
    let currentState: GrassState = freshState();

    function setBreathVar(v: number) {
      // Clamp + write to :root so grass blades + orb both react
      const clamped = Math.max(0, Math.min(1, v));
      document.documentElement.style.setProperty('--breath', String(clamped));
    }

    function setPhaseLabel(label: string) {
      document.getElementById('shg-phase')!.textContent = label;
    }

    function updateOrbLoop(timestamp: number) {
      if (!isRunning) return;
      const elapsed = timestamp - cycleStartedAt;
      // Determine phase + breath value
      if (elapsed < INHALE_MS) {
        phase = 'inhale';
        setBreathVar(elapsed / INHALE_MS);  // 0→1
      } else if (elapsed < INHALE_MS + HOLD_MS) {
        phase = 'hold';
        setBreathVar(1);
      } else if (elapsed < INHALE_MS + HOLD_MS + EXHALE_MS) {
        phase = 'exhale';
        const ex = (elapsed - INHALE_MS - HOLD_MS) / EXHALE_MS;
        setBreathVar(1 - ex);  // 1→0
      } else {
        // Cycle complete — increment + restart
        cycleCount += 1;
        currentState.lifetime += 1;
        if (cycleCount > currentState.longestSession) currentState.longestSession = cycleCount;
        currentState.lastVisit = Date.now();
        saveState(currentState);
        refreshFooter();
        document.getElementById('shg-cycle-label')!.textContent = `cycle ${cycleCount}`;
        cycleStartedAt = timestamp;
      }
      rafHandle = requestAnimationFrame(updateOrbLoop);
    }

    // Phase-label scheduler — runs alongside the rAF so the label changes
    // exactly at phase boundaries (rAF can lag on slow tabs)
    function schedulePhaseLabels() {
      function fire(label: string, atMs: number, rising: boolean | null, durMs: number) {
        phaseTimerHandle = window.setTimeout(() => {
          if (!isRunning) return;
          setPhaseLabel(label);
          if (rising === true) playBreath(durMs, true);
          else if (rising === false) playBreath(durMs, false);
          // Schedule the next phase
          if (label === 'breathe in') {
            fire('hold', 0, null, 0);
            phaseTimerHandle = window.setTimeout(() => {
              if (!isRunning) return;
              setPhaseLabel('hold');
              phaseTimerHandle = window.setTimeout(() => {
                if (!isRunning) return;
                setPhaseLabel('breathe out');
                playBreath(EXHALE_MS, false);
                phaseTimerHandle = window.setTimeout(() => {
                  if (!isRunning) return;
                  setPhaseLabel('breathe in');
                  playBreath(INHALE_MS, true);
                  // Restart the cycle
                  schedulePhaseLabels();
                }, EXHALE_MS);
              }, HOLD_MS);
            }, INHALE_MS);
          }
        }, atMs);
      }
      // Kick the cycle: inhale starts immediately
      setPhaseLabel('breathe in');
      playBreath(INHALE_MS, true);
      phaseTimerHandle = window.setTimeout(() => {
        if (!isRunning) return;
        setPhaseLabel('hold');
        phaseTimerHandle = window.setTimeout(() => {
          if (!isRunning) return;
          setPhaseLabel('breathe out');
          playBreath(EXHALE_MS, false);
          phaseTimerHandle = window.setTimeout(() => {
            if (!isRunning) return;
            schedulePhaseLabels();  // recurse for next cycle
          }, EXHALE_MS);
        }, HOLD_MS);
      }, INHALE_MS);
    }

    function startBreathing() {
      if (isRunning) return;
      ensureCtx();
      isRunning = true;
      cycleStartedAt = performance.now();
      const btn = document.getElementById('shg-toggle')! as HTMLButtonElement;
      btn.textContent = '⏸ pause';
      btn.classList.add('shg__btn--running');
      document.getElementById('shg-cycle-label')!.textContent = `cycle ${cycleCount}`;
      schedulePhaseLabels();
      rafHandle = requestAnimationFrame(updateOrbLoop);
    }

    function stopBreathing() {
      isRunning = false;
      if (rafHandle != null) { cancelAnimationFrame(rafHandle); rafHandle = null; }
      if (phaseTimerHandle != null) { clearTimeout(phaseTimerHandle); phaseTimerHandle = null; }
      setBreathVar(0);
      setPhaseLabel('paused');
      const btn = document.getElementById('shg-toggle')! as HTMLButtonElement;
      btn.textContent = '▶ resume';
      btn.classList.remove('shg__btn--running');
    }

    function refreshFooter() {
      const el = document.getElementById('shg-count')!;
      const session = cycleCount;
      const lifetime = currentState.lifetime;
      const longest = currentState.longestSession;
      if (lifetime === 0) {
        el.innerHTML = 'your first visit';
      } else if (session === 0) {
        el.innerHTML = `you've sat for <strong>${lifetime}</strong> cycle${lifetime === 1 ? '' : 's'} altogether · longest <strong>${longest}</strong>`;
      } else if (session === 1) {
        el.innerHTML = `this session: <strong>1</strong> cycle · lifetime <strong>${lifetime}</strong>`;
      } else {
        el.innerHTML = `this session: <strong>${session}</strong> cycles · lifetime <strong>${lifetime}</strong>`;
      }
    }

    function init() {
      renderGrass();
      currentState = loadState();
      currentState.lastVisit = Date.now();
      saveState(currentState);
      refreshFooter();

      document.getElementById('shg-toggle')!.addEventListener('click', () => {
        if (isRunning) stopBreathing();
        else startBreathing();
      });

      // Visibility — pause when tab hidden, resume when shown
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && isRunning) stopBreathing();
      });

      // Keyboard: Space toggles
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space') {
          e.preventDefault();
          if (isRunning) stopBreathing();
          else startBreathing();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
