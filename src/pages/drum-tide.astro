---
/**
 * /drum-tide — slow ocean ambient.
 *
 * Mike: "go 5 more." Second of five. A long pink-noise tide piece.
 * Two channels of bandpass-filtered noise pan slowly between left
 * and right (the wave's direction). A subtle low rumble underneath.
 * Pixel-art waves roll across the bottom of the page.
 *
 * Designed for sitting with for ten minutes or thirty. Pure static.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Tide · Slow Ocean Ambient · PointCast';
const description =
  'A pink-noise tide piece. Two slow channels pan left and right; pixel waves roll across the screen.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tide',
  url: 'https://pointcast.xyz/drum-tide',
  description,
  applicationCategory: 'MultimediaApplication',
};
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dt" id="dt-main">
    <DrumNav current="tide" />

    <header class="dt__header">
      <div class="dt__chrome">
        <span>TIDE</span>
        <span class="dt__chrome-sep">·</span>
        <span id="dt-state">OFF</span>
        <span class="dt__chrome-sep">·</span>
        <span id="dt-elapsed">--:--</span>
      </div>
      <h1 class="dt__title">TIDE</h1>
      <p class="dt__tagline">two channels of pink-noise water · pan slowly · listen long</p>
    </header>

    <section class="dt__sky" id="dt-sky">
      <!-- Distant moon -->
      <div class="dt__moon"></div>
      <!-- Star dots -->
      <div class="dt__stars"></div>
    </section>

    <section class="dt__beach" id="dt-beach">
      <!-- Three pixel waves rolling at different speeds -->
      <div class="dt__wave dt__wave--far"></div>
      <div class="dt__wave dt__wave--mid"></div>
      <div class="dt__wave dt__wave--near"></div>
      <div class="dt__sand"></div>
    </section>

    <footer class="dt__controls">
      <button class="dt__btn dt__btn--primary" id="dt-toggle" type="button">START</button>
      <p class="dt__instructions">
        Click START to begin. Volume rises slowly over 30 seconds. Open the page, leave it open, listen.
      </p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dt-main) { background: #050d18; overflow: hidden; }

  .dt {
    --dt-night: #050d18;
    --dt-sky: #0c1a30;
    --dt-sky-mid: #18305a;
    --dt-water: #1d4368;
    --dt-water-deep: #0e2440;
    --dt-foam: rgba(244, 231, 200, 0.5);
    --dt-sand: #c4a874;
    --dt-sand-deep: #8e7244;
    --dt-moon: #f6e5b8;
    --dt-brass: #d4a437;
    --dt-brass-deep: #6b4d12;
    --dt-flame: #f6c15e;
    --dt-ink-light: #f4e7c8;
    --dt-ink-mid: #c9b78c;
    --dt-ink-dim: #8a7a55;

    position: relative;
    isolation: isolate;
    margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dt-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background: linear-gradient(180deg, var(--dt-sky) 0%, var(--dt-sky-mid) 60%, var(--dt-water-deep) 100%);
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
  }
  .dt .drum-nav {
    opacity: 0.40;
    transform: scale(0.9);
    transform-origin: top left;
    margin-bottom: clamp(6px, 0.8vh, 14px);
    position: relative;
    z-index: 4;
  }

  .dt__header {
    text-align: center;
    padding: clamp(8px, 1vh, 18px) 0 clamp(8px, 1vh, 14px);
    flex-shrink: 0;
    position: relative;
    z-index: 4;
  }
  .dt__chrome {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px;
    border: 1.5px solid var(--dt-brass-deep);
    border-radius: 999px;
    backdrop-filter: blur(10px);
    background: rgba(0, 0, 0, 0.30);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dt-ink-mid);
  }
  .dt__chrome-sep { color: var(--dt-brass-deep); }
  #dt-state { color: var(--dt-ink-dim); font-weight: 700; }
  #dt-state[data-on='1'] { color: var(--dt-flame); }
  #dt-elapsed { color: var(--dt-flame); font-weight: 700; }

  .dt__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--dt-foam);
    text-shadow: 0 0 28px rgba(244, 231, 200, 0.25);
  }
  .dt__tagline {
    margin: 0 auto;
    max-width: 540px;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px);
    color: var(--dt-ink-mid);
  }

  /* Sky — top half */
  .dt__sky {
    position: absolute;
    inset: 0 0 40% 0;
    pointer-events: none;
    z-index: 1;
  }
  .dt__moon {
    position: absolute;
    top: 18%;
    right: 10%;
    width: clamp(60px, 8vw, 110px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--dt-moon) 0%, oklch(0.85 0.06 80) 70%, oklch(0.70 0.05 80) 100%);
    box-shadow: 0 0 80px 30px rgba(246, 229, 184, 0.25);
  }
  .dt__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(244, 231, 200, 0.6) 1px, transparent 1.5px),
      radial-gradient(circle at 87% 32%, rgba(244, 231, 200, 0.4) 1px, transparent 1.5px),
      radial-gradient(circle at 23% 48%, rgba(244, 231, 200, 0.5) 1px, transparent 1.5px),
      radial-gradient(circle at 71% 12%, rgba(244, 231, 200, 0.6) 1px, transparent 1.5px),
      radial-gradient(circle at 45% 62%, rgba(244, 231, 200, 0.45) 1px, transparent 1.5px),
      radial-gradient(circle at 92% 78%, rgba(244, 231, 200, 0.4) 1px, transparent 1.5px),
      radial-gradient(circle at 8% 88%, rgba(244, 231, 200, 0.45) 1px, transparent 1.5px),
      radial-gradient(circle at 58% 41%, rgba(244, 231, 200, 0.5) 1px, transparent 1.5px);
    opacity: 0.7;
  }

  /* Beach — bottom half */
  .dt__beach {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }
  .dt__sand {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 22%;
    background: linear-gradient(180deg, var(--dt-sand) 0%, var(--dt-sand-deep) 100%);
    box-shadow: inset 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  .dt__sand::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background:
      radial-gradient(circle at 4% 50%, rgba(255, 255, 255, 0.4) 1px, transparent 2px),
      radial-gradient(circle at 18% 30%, rgba(255, 255, 255, 0.5) 1px, transparent 2px),
      radial-gradient(circle at 32% 70%, rgba(255, 255, 255, 0.3) 1px, transparent 2px),
      radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.4) 1px, transparent 2px),
      radial-gradient(circle at 68% 60%, rgba(255, 255, 255, 0.5) 1px, transparent 2px),
      radial-gradient(circle at 82% 30%, rgba(255, 255, 255, 0.3) 1px, transparent 2px),
      radial-gradient(circle at 96% 50%, rgba(255, 255, 255, 0.4) 1px, transparent 2px);
    background-size: 100px 4px;
  }

  /* Pixel waves */
  .dt__wave {
    position: absolute;
    left: -50%;
    width: 200%;
    height: 12%;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0px,
        transparent 28px,
        var(--dt-foam) 28px,
        var(--dt-foam) 32px
      );
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    will-change: transform;
  }
  .dt__wave--far {
    bottom: 32%;
    background-color: rgba(29, 67, 104, 0.7);
    height: 10%;
    animation: dt-wave-roll 18s linear infinite;
    opacity: 0.7;
  }
  .dt__wave--mid {
    bottom: 26%;
    background-color: rgba(40, 90, 140, 0.85);
    height: 12%;
    animation: dt-wave-roll 12s linear infinite reverse;
  }
  .dt__wave--near {
    bottom: 20%;
    background-color: rgba(50, 110, 170, 1);
    height: 14%;
    animation: dt-wave-roll 9s linear infinite;
  }
  @keyframes dt-wave-roll {
    from { transform: translateX(0); }
    to   { transform: translateX(-128px); }
  }

  /* Controls */
  .dt__controls {
    position: relative;
    z-index: 4;
    margin-top: auto;
    padding-top: clamp(20px, 3vh, 40px);
    text-align: center;
  }
  .dt__btn {
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 14px 36px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.24em;
  }
  .dt__btn--primary {
    color: var(--dt-night);
    background: linear-gradient(180deg, var(--dt-foam) 0%, oklch(0.75 0.08 80) 100%);
    box-shadow:
      0 0 0 2px var(--dt-night),
      0 4px 0 0 rgba(0, 0, 0, 0.4),
      0 4px 16px rgba(244, 231, 200, 0.30);
    transition: transform 80ms, box-shadow 80ms, background 120ms;
  }
  .dt__btn--primary:hover { background: linear-gradient(180deg, #fff 0%, var(--dt-foam) 100%); }
  .dt__btn--primary:active {
    transform: translateY(3px);
    box-shadow:
      0 0 0 2px var(--dt-night),
      0 1px 0 0 rgba(0, 0, 0, 0.4),
      0 0 20px rgba(244, 231, 200, 0.55);
  }
  .dt__instructions {
    margin: 16px auto 0;
    max-width: 540px;
    font-family: 'Lora', Georgia, serif;
    font-size: 13px;
    color: var(--dt-ink-dim);
    font-style: italic;
  }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }

  // Pink noise via filtered white noise — generate a buffer
  function makeNoiseBuffer(durationSec) {
    const a = ctx();
    const len = a.sampleRate * durationSec;
    const buf = a.createBuffer(1, len, a.sampleRate);
    const data = buf.getChannelData(0);
    // Approximate pink-ish noise: low-pass random walk
    let lastValue = 0;
    for (let i = 0; i < len; i++) {
      const white = Math.random() * 2 - 1;
      lastValue = (lastValue + (0.02 * white)) / 1.02;
      data[i] = lastValue * 3.5;
    }
    return buf;
  }

  let nodes = null;
  function startTide() {
    if (nodes) return;
    const a = ctx(); const t = a.currentTime;
    // Two channels of looped noise, each panned slowly
    const buf = makeNoiseBuffer(8);
    const n1 = a.createBufferSource(); n1.buffer = buf; n1.loop = true;
    const n2 = a.createBufferSource(); n2.buffer = buf; n2.loop = true;
    n2.playbackRate.value = 0.92; // detuned
    const filt1 = a.createBiquadFilter(); filt1.type = 'bandpass';
    filt1.frequency.value = 700; filt1.Q.value = 0.5;
    const filt2 = a.createBiquadFilter(); filt2.type = 'lowpass';
    filt2.frequency.value = 1200;
    const pan1 = a.createStereoPanner(); pan1.pan.value = 0;
    const pan2 = a.createStereoPanner(); pan2.pan.value = 0;
    const master = a.createGain(); master.gain.value = 0.0001;
    master.gain.exponentialRampToValueAtTime(0.30, t + 30); // 30s ramp-in
    n1.connect(filt1).connect(pan1).connect(master);
    n2.connect(filt2).connect(pan2).connect(master);
    master.connect(a.destination);
    n1.start(t); n2.start(t);

    // Slow LFO panners — wave sweeping
    function panSweep() {
      const now = ctx().currentTime;
      pan1.pan.setTargetAtTime(-0.6, now, 6);
      pan2.pan.setTargetAtTime(0.6, now, 6);
      setTimeout(() => {
        const now2 = ctx().currentTime;
        pan1.pan.setTargetAtTime(0.6, now2, 6);
        pan2.pan.setTargetAtTime(-0.6, now2, 6);
      }, 8000);
      setTimeout(panSweep, 16000);
    }
    panSweep();

    // Filter sweep — wave brightness rises and falls
    function brightenSweep() {
      const now = ctx().currentTime;
      filt1.frequency.setTargetAtTime(900 + Math.random() * 600, now, 4);
      filt2.frequency.setTargetAtTime(1000 + Math.random() * 800, now, 4);
      setTimeout(brightenSweep, 5000);
    }
    brightenSweep();

    nodes = { n1, n2, filt1, filt2, pan1, pan2, master };
  }

  function stopTide() {
    if (!nodes) return;
    const a = ctx(); const t = a.currentTime;
    nodes.master.gain.cancelScheduledValues(t);
    nodes.master.gain.setValueAtTime(nodes.master.gain.value, t);
    nodes.master.gain.exponentialRampToValueAtTime(0.0001, t + 2);
    setTimeout(() => {
      try { nodes.n1.stop(); nodes.n2.stop(); } catch {}
      nodes = null;
    }, 2200);
  }

  const toggleBtn = document.getElementById('dt-toggle');
  const stateEl = document.getElementById('dt-state');
  const elapsedEl = document.getElementById('dt-elapsed');
  let startedAt = 0;
  let on = false;

  function pad(n) { return String(n).padStart(2, '0'); }
  function paint() {
    if (!on) {
      if (elapsedEl) elapsedEl.textContent = '--:--';
      return;
    }
    const sec = Math.floor((Date.now() - startedAt) / 1000);
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    if (elapsedEl) elapsedEl.textContent = `${pad(m)}:${pad(s)}`;
  }
  setInterval(paint, 1000);

  toggleBtn?.addEventListener('click', () => {
    if (on) {
      stopTide();
      on = false;
      startedAt = 0;
      if (stateEl) { stateEl.textContent = 'OFF'; stateEl.dataset.on = '0'; }
      if (toggleBtn) toggleBtn.textContent = 'START';
    } else {
      startTide();
      on = true;
      startedAt = Date.now();
      if (stateEl) { stateEl.textContent = 'TIDE'; stateEl.dataset.on = '1'; }
      if (toggleBtn) toggleBtn.textContent = 'STOP';
    }
    paint();
  });
</script>
