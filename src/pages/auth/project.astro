---
import AuthMenu from '../../components/AuthMenu.astro';
import TezosSessionBridge from '../../components/TezosSessionBridge.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Continue with PointCast</title>
    <style>
      :root { color-scheme: dark; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background:#07172c; color:#f8f2df; }
      body { margin:0; min-height:100vh; display:grid; place-items:center; background:radial-gradient(circle at 75% 20%,#284b78 0,transparent 35%),#07172c; }
      main { width:min(42rem,calc(100% - 2rem)); border:1px solid #e9c98d; padding:clamp(1.5rem,5vw,4rem); box-sizing:border-box; }
      p { line-height:1.6; color:#cad7df; } h1 { font:700 clamp(2.2rem,8vw,5rem)/.9 Arial,sans-serif; letter-spacing:-.07em; margin:.25em 0; }
      .eyebrow { color:#e9c98d; text-transform:uppercase; letter-spacing:.16em; font-size:.75rem; }
      .project-context { max-width:54ch; }
      .project-context strong { color:#f8f2df; }
      .auth-shell { margin-top:2rem; display:flex; align-items:center; gap:1rem; }
      [data-project-status] { min-height:1.5em; color:#e9c98d; }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">PointCast identity bridge · Tezos Mainnet</p>
      <h1>One wallet.<br />Every project.</h1>
      <p class="project-context" data-project-context>
        Your existing PointCast session can authorize this project with a short-lived, one-use code.
        If you are not signed in yet, use Kukai once here; no transaction is requested.
      </p>
      <div class="auth-shell"><AuthMenu autoOpen={true} /></div>
      <p data-project-status role="status">Checking your PointCast session…</p>
    </main>
    <TezosSessionBridge />
    <script>
      const status = document.querySelector('[data-project-status]');
      const params = new URLSearchParams(window.location.search);
      const target = params.get('target') || '';
      const returnTo = params.get('return_to') || '';
      const context = document.querySelector('[data-project-context]');
      let issuing = false;

      async function renderProjectContext() {
        if (target !== 'network-el-segundo' || !context) return;
        let nextLight = 2;
        try {
          const response = await fetch('/api/network-el-segundo/participants', {
            headers: { accept: 'application/json' },
            cache: 'no-store',
          });
          if (response.ok) {
            const result = await response.json();
            if (Number.isInteger(result.count) && Number.isInteger(result.target)) {
              nextLight = Math.min(result.target, result.count + 1);
            }
          }
        } catch {
          // The invitation still works if the public counter is unavailable.
        }
        context.textContent = `Light ${nextLight} is open in Network El Segundo's First 100 Signal. Your PointCast Kukai session follows you into the project. If this is your first visit, choose Kukai below and sign one free wallet-control message. Zero tez; no transaction.`;
      }

      async function continueToProject() {
        if (issuing) return;
        issuing = true;
        if (status) status.textContent = 'Authorizing this project…';
        try {
          let address = '';
          try { address = localStorage.getItem('pc:wallet-active') || ''; } catch { /* ignore */ }
          const response = await fetch('/api/auth/project-ticket', {
            method: 'POST', credentials: 'include',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ target, returnTo, address }),
          });
          const result = await response.json();
          if (response.status === 401) {
            issuing = false;
            if (status) status.textContent = 'Choose Kukai below to sign once. No transaction will be requested.';
            window.dispatchEvent(new CustomEvent('pc:open-auth-menu'));
            return;
          }
          if (!response.ok || !result.destination) throw new Error(result.reason || 'project-ticket-failed');
          window.location.replace(result.destination);
        } catch (error) {
          issuing = false;
          if (status) status.textContent = error instanceof Error ? error.message : 'Project authorization failed.';
        }
      }

      window.addEventListener('pc:auth-change', (event) => {
        if (event.detail?.user) void continueToProject();
      });
      void renderProjectContext();
      void continueToProject();
    </script>
  </body>
</html>
