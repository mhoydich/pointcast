---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import BlockLayout from '../../layouts/BlockLayout.astro';

const dir = join(process.cwd(), 'src/data/first-pour');
const dates = existsSync(dir)
  ? readdirSync(dir).filter((name) => /^\d{4}-\d{2}-\d{2}\.json$/.test(name)).map((name) => name.replace('.json', '')).sort().reverse()
  : [];
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Los_Angeles',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());
---

<BlockLayout title="First Pour" description="Archive of daily First Pour blocks.">
  <main class="pour-list">
    <nav class="crumb"><a href="/">Home</a><span>/</span><span>first-pour</span></nav>
    <header>
      <p class="kicker">FIRST POUR</p>
      <h1>Morning receipts.</h1>
      <p>Markets pulse, Good Feels gut, PointCast delta, and a chamber draw. Generated at 6:30am PT.</p>
    </header>
    <ol>
      {dates.map((date) => <li><a href={`/first-pour/${date}`}>{date}</a></li>)}
      {dates.length === 0 && <li>Run <code>npm run first-pour</code> to make the first one.</li>}
    </ol>
  </main>
</BlockLayout>

<script is:inline define:vars={{ today }}>
  if (window.location.pathname === '/first-pour') {
    window.location.replace(`/first-pour/${today}`);
  }
</script>

<style>
  .pour-list {
    max-width: 840px;
    margin: 0 auto;
    padding: 24px 18px 80px;
  }

  .crumb,
  .kicker {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    gap: 8px;
    color: #6d665d;
    font-size: 11px;
    margin-bottom: 20px;
  }

  a {
    color: #8b2b25;
    text-decoration: none;
  }

  header {
    border-bottom: 2px solid #1f1b18;
    padding-bottom: 20px;
    margin-bottom: 18px;
  }

  .kicker {
    color: #8b2b25;
    font-size: 12px;
  }

  h1 {
    margin: 8px 0 10px;
    font-size: clamp(42px, 8vw, 86px);
    line-height: .92;
  }

  header p:last-child {
    color: #4c453e;
    font-size: 18px;
  }

  ol {
    padding-left: 22px;
    font-size: 22px;
    line-height: 1.9;
  }
</style>
