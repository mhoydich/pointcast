---
import BlockLayout from '../../layouts/BlockLayout.astro';
import data from '../../data/thus-camp.json';
import { buildKit, THUS_CAMP_CANONICAL } from '../../lib/thus-camp.mjs';
import '../../styles/thus-camp.css';

const first = data.situations[0];
const kit = buildKit(data, first.slug);
const title = 'Thus Camp · how to modern-utility any situation';
const description = 'A PointCast field guide to the next three hours: Friday night football as a parent, a 98 degree day, the pickleball courts as a player or a watcher, and more. Kits, timelines and a pack-list builder.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': THUS_CAMP_CANONICAL,
  name: title,
  description,
  url: THUS_CAMP_CANONICAL,
  hasPart: data.situations.map((s) => ({ '@type': 'HowTo', name: s.title, description: s.call, url: `${THUS_CAMP_CANONICAL}${s.slug}/` })),
};
---

<BlockLayout title={title} description={description} themeColor="#e8590c" isolated={true} hideAds={true} showNetworkStrip={false} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/thus-camp.json', title: 'Thus Camp JSON' }]}>
  <main class="tc">
    <nav class="tc-crumb" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><span>Thus Camp</span><a class="tc-crumb__json" href="/thus-camp.json">JSON</a>
    </nav>

    <header class="tc-hero">
      <div>
        <p class="tc-kicker">PointCast field guide · Thus Camp</p>
        <h1>Camp is anywhere you're about to spend <em>three hours.</em></h1>
      </div>
      <div>
        <p class="tc-hero__dek">{data.premise}</p>
        <p class="tc-hero__tag">{data.tagline}</p>
      </div>
    </header>

    <section class="tc-section" aria-labelledby="thus-title">
      <div class="tc-section__head">
        <div><p class="tc-kicker">The method</p><h2 id="thus-title">Four questions. <em>T·H·U·S.</em></h2></div>
        <p>Ask these before any outing and the kit mostly packs itself.</p>
      </div>
      <ol class="tc-thus">
        {data.thus.map((q) => <li><b>{q.letter}</b><span>{q.word}</span><p>{q.question}</p></li>)}
      </ol>
    </section>

    <section class="tc-section" id="situations" aria-labelledby="situations-title">
      <div class="tc-section__head">
        <div><p class="tc-kicker">The camps</p><h2 id="situations-title">{data.situations.length} situations, <em>one kit each.</em></h2></div>
        <p>Each one has a loadout, a timeline, the moves that make it easier, and what to watch for.</p>
      </div>
      <ul class="tc-grid">
        {data.situations.map((s) => (
          <li>
            <article class="tc-card" style={`--card-accent:${s.accent}`}>
              <span class="tc-meta"><span>{s.code}</span><span>{s.hours} hrs · {s.surface}</span></span>
              <h3><a href={`/thus-camp/${s.slug}/`}>{s.title}</a></h3>
              <p>{s.kicker}</p>
              <p class="tc-card__call">{s.call}</p>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <section class="tc-section" id="pack" aria-labelledby="pack-title">
      <div class="tc-section__head">
        <div><p class="tc-kicker">Pack list</p><h2 id="pack-title">Build the kit, <em>check it off.</em></h2></div>
        <p>Pick a camp, who you are there, and the conditions. Checks are saved in this browser. Copy the list into your notes or the team chat.</p>
      </div>
      <div class="tc-pack" data-tc-pack>
        <form class="tc-panel tc-panel--controls" data-tc-form aria-label="Pack list options">
          <label class="tc-label" for="tc-situation">Situation</label>
          <select id="tc-situation" name="s" data-tc-situation>
            {data.situations.map((s) => <option value={s.slug}>{s.code} · {s.title}</option>)}
          </select>
          <fieldset class="tc-field" style="margin-top:16px">
            <legend class="tc-label">You are</legend>
            <div class="tc-options" data-tc-roles>
              <label class="tc-chip"><input type="radio" name="r" value="" checked /><span>Anyone</span></label>
              {first.roles.map((r) => <label class="tc-chip"><input type="radio" name="r" value={r.id} /><span>{r.label}</span></label>)}
            </div>
          </fieldset>
          <fieldset class="tc-field">
            <legend class="tc-label">Conditions</legend>
            <div class="tc-options">
              {data.modifiers.map((m) => <label class="tc-chip"><input type="checkbox" name="m" value={m.id} /><span>{m.label}</span></label>)}
            </div>
          </fieldset>
          <fieldset class="tc-field">
            <legend class="tc-label">Base layer</legend>
            <div class="tc-options">
              <label class="tc-chip"><input type="checkbox" name="t" value="1" /><span>Add the trunk kit</span></label>
            </div>
          </fieldset>
          <noscript><p class="tc-status">Without JavaScript the list shows the {first.title.toLowerCase()} kit. Every camp page has its full loadout.</p></noscript>
        </form>

        <div class="tc-panel" aria-live="polite">
          <div class="tc-out__head">
            <div>
              <h3 data-tc-title>{kit.title}</h3>
              <p data-tc-call>{kit.call}</p>
            </div>
            <span class="tc-mono tc-out__count" data-tc-count>{kit.items.length} items</span>
          </div>
          <ul class="tc-list" data-tc-list>
            {kit.items.map((i) => (
              <li>
                <input type="checkbox" id={`tc-i-${i.id}`} data-item={i.id} />
                <label for={`tc-i-${i.id}`}>{i.name}{i.tier === 'nice' && <span class="tc-tag">nice to have</span>}</label>
                <p class="tc-why">{i.why}</p>
              </li>
            ))}
          </ul>
          <div class="tc-actions">
            <button type="button" class="tc-btn" data-tc-copy>Copy list</button>
            <button type="button" class="tc-btn tc-btn--ghost" data-tc-share>Copy link</button>
            <button type="button" class="tc-btn tc-btn--ghost" data-tc-reset>Clear checks</button>
            <a class="tc-btn tc-btn--ghost" href={`/thus-camp/${first.slug}/`} data-tc-guide>Full guide →</a>
          </div>
          <p class="tc-status" data-tc-status role="status"></p>
        </div>
      </div>
    </section>

    <section class="tc-section" id="trunk" aria-labelledby="trunk-title">
      <div class="tc-section__head">
        <div><p class="tc-kicker">Base camp</p><h2 id="trunk-title">{data.trunkKit.title}</h2></div>
        <p>{data.trunkKit.note}</p>
      </div>
      <ul class="tc-list tc-twocol">
        {data.trunkKit.items.map((i) => (
          <li><span class="tc-bullet" aria-hidden="true"></span><strong>{i.name}</strong><p class="tc-why">{i.why}</p></li>
        ))}
      </ul>
    </section>

    <p class="tc-fine">{data.disclaimer} Written by Claude Code for PointCast. Machine-readable at <a href="/thus-camp.json">/thus-camp.json</a>.</p>
    <script id="tc-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
  </main>
</BlockLayout>


<script>
  import { buildKit, kitText, readKitParams, kitParams, findSituation } from '../../lib/thus-camp.mjs';

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  function store(key: string, value?: string[]): string[] {
    try {
      if (value) { localStorage.setItem(key, JSON.stringify(value)); return value; }
      const raw = JSON.parse(localStorage.getItem(key) ?? '[]');
      return Array.isArray(raw) ? raw : [];
    } catch { return []; }
  }

  function initPack(): void {
    const root = document.querySelector<HTMLElement>('[data-tc-pack]');
    const dataEl = document.getElementById('tc-data');
    if (!root || !dataEl || root.dataset.ready) return;
    root.dataset.ready = '1';
    const data = JSON.parse(dataEl.textContent ?? '{}');
    const form = root.querySelector<HTMLFormElement>('[data-tc-form]')!;
    const select = root.querySelector<HTMLSelectElement>('[data-tc-situation]')!;
    const rolesBox = root.querySelector<HTMLElement>('[data-tc-roles]')!;
    const list = root.querySelector<HTMLElement>('[data-tc-list]')!;
    const status = root.querySelector<HTMLElement>('[data-tc-status]')!;
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;

    let state = readKitParams(data, new URLSearchParams(location.search));
    let kit = buildKit(data, state.slug, state);
    const checkKey = () => `thus-camp:checked:${state.slug}`;

    function renderRoles(): void {
      const s = findSituation(data, state.slug);
      const opts = [{ id: '', label: 'Anyone' }, ...s.roles];
      rolesBox.innerHTML = opts.map((r: { id: string; label: string }) =>
        `<label class="tc-chip"><input type="radio" name="r" value="${esc(r.id)}"${r.id === state.role ? ' checked' : ''} /><span>${esc(r.label)}</span></label>`).join('');
    }

    function syncControls(): void {
      select.value = state.slug;
      form.querySelectorAll<HTMLInputElement>('input[name="m"]').forEach((i) => { i.checked = state.modifiers.includes(i.value); });
      form.querySelector<HTMLInputElement>('input[name="t"]')!.checked = state.trunk;
      renderRoles();
    }

    function render(): void {
      kit = buildKit(data, state.slug, state);
      const checked = new Set(store(checkKey()));
      $('[data-tc-title]').textContent = kit.title;
      $('[data-tc-call]').textContent = kit.call;
      root.querySelector<HTMLAnchorElement>('[data-tc-guide]')!.href = `/thus-camp/${kit.slug}/`;
      list.innerHTML = kit.items.map((i: { id: string; name: string; why: string; tier: string; group: string }) => {
        const id = `tc-i-${esc(i.id)}`;
        const tag = i.group === 'trunk' ? 'trunk kit' : i.tier === 'nice' ? 'nice to have' : i.group !== 'loadout' ? 'conditions' : '';
        return `<li class="${checked.has(i.id) ? 'is-done' : ''}"><input type="checkbox" id="${id}" data-item="${esc(i.id)}"${checked.has(i.id) ? ' checked' : ''} /><label for="${id}">${esc(i.name)}${tag ? `<span class="tc-tag">${tag}</span>` : ''}</label><p class="tc-why">${esc(i.why)}</p></li>`;
      }).join('');
      updateCount(checked);
    }

    function updateCount(checked: Set<string>): void {
      const done = kit.items.filter((i: { id: string }) => checked.has(i.id)).length;
      $('[data-tc-count]').textContent = done ? `${done} / ${kit.items.length} packed` : `${kit.items.length} items`;
    }

    function pushUrl(): void {
      const url = `${location.pathname}?${kitParams(state).toString()}#pack`;
      history.replaceState(null, '', url);
    }

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t === select) { state = { ...state, slug: select.value, role: '' }; renderRoles(); }
      else if (t.name === 'r') state = { ...state, role: t.value };
      else if (t.name === 'm') state = { ...state, modifiers: [...form.querySelectorAll<HTMLInputElement>('input[name="m"]:checked')].map((i) => i.value) };
      else if (t.name === 't') state = { ...state, trunk: t.checked };
      render();
      pushUrl();
    });

    list.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.dataset.item) return;
      const checked = new Set(store(checkKey()));
      if (t.checked) checked.add(t.dataset.item); else checked.delete(t.dataset.item);
      store(checkKey(), [...checked]);
      t.closest('li')?.classList.toggle('is-done', t.checked);
      updateCount(checked);
    });

    async function copy(text: string, ok: string): Promise<void> {
      try { await navigator.clipboard.writeText(text); status.textContent = ok; }
      catch { status.textContent = 'Copy is blocked here. Select the list and copy it by hand.'; }
    }
    $('[data-tc-copy]').addEventListener('click', () => copy(kitText(data, kit, new Set(store(checkKey()))), 'Pack list copied.'));
    $('[data-tc-share]').addEventListener('click', () => copy(`${location.origin}/thus-camp/?${kitParams(state).toString()}#pack`, 'Link copied. It carries the camp and conditions, not your checks.'));
    $('[data-tc-reset]').addEventListener('click', () => { store(checkKey(), []); render(); status.textContent = 'Checks cleared for this camp.'; });

    syncControls();
    render();
  }

  initPack();
  document.addEventListener('astro:page-load', initPack);
</script>
