---
/**
 * /nouns-nation-battler-wiki - human reference wiki for the Nouns auto-battler.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { NOUNS_BATTLER_WIKI } from '../lib/nouns-battler-agent-bench';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Nouns Nation Battler Wiki',
  description:
    'A public field guide for Nouns Nation Battler: rules, gangs, fields, watch modes, seasons, agents, sponsorships, and contribution paths.',
  url: 'https://pointcast.xyz/nouns-nation-battler-wiki/',
  isPartOf: {
    '@type': 'VideoGame',
    name: 'Nouns Nation Battler',
    url: 'https://pointcast.xyz/nouns-nation-battler/',
  },
};
---

<BlockLayout
  title="Nouns Nation Battler Wiki"
  description="A public field guide for Nouns Nation Battler: rules, gangs, fields, watch modes, seasons, agents, sponsorships, and contribution paths."
  image="/images/og/nouns-battler-live.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-battler-wiki.json', title: 'Nouns Nation Battler Wiki JSON' },
    { type: 'application/json', href: '/nouns-nation-battler.json', title: 'Nouns Nation Battler manifest' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Wiki', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-wiki/' },
      { label: 'Watch', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler/' },
      { label: 'Mobile', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-mobile/' },
      { label: 'Agent Bench', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-agents/' },
    ],
  }}
>
  <main class="wiki">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation/">Nouns Nation</a>
      <span aria-hidden="true">/</span>
      <span>Wiki</span>
    </nav>

    <section class="hero" aria-labelledby="wiki-title">
      <div>
        <p class="kicker">CH.BTL / WIKI / v{NOUNS_BATTLER_WIKI.version}</p>
        <h1 id="wiki-title">The field guide for the weirdest match on the slate.</h1>
        <p>{NOUNS_BATTLER_WIKI.stance}</p>
        <nav class="actions" aria-label="Wiki primary routes">
          <a class="primary" href="/nouns-nation-battler/">Watch live</a>
          <a href="/nouns-nation-battler-mobile/">Mobile Cast</a>
          <a href="/nouns-nation-battler-tv/">TV Cast</a>
          <a href="/nouns-nation-battler-wiki.json">Wiki JSON</a>
        </nav>
      </div>
      <div class="noun-board" aria-label="Featured Nouns">
        <div class="board-top">
          <span>Featured Nouns</span>
          <strong>{NOUNS_BATTLER_WIKI.featuredNouns.length}</strong>
        </div>
        <div class="noun-grid">
          {NOUNS_BATTLER_WIKI.featuredNouns.slice(0, 12).map((noun) => (
            <figure>
              <img src={`/games/nouns-nation-battler/assets/noun-${noun}.svg`} alt={`Noun ${noun}`} loading="eager" />
              <figcaption>#{noun}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="quick" aria-labelledby="quick-title">
      <div class="section-head">
        <p class="kicker">Start here</p>
        <h2 id="quick-title">Four fast doors into the league.</h2>
      </div>
      <div class="card-grid card-grid--four">
        {NOUNS_BATTLER_WIKI.quickStart.map((item) => (
          <a class="card" href={item.href}>
            <span>{item.label}</span>
            <p>{item.note}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="glossary" aria-labelledby="glossary-title">
      <div class="section-head">
        <p class="kicker">Glossary</p>
        <h2 id="glossary-title">The words that make the sport legible.</h2>
      </div>
      <div class="glossary-list">
        {NOUNS_BATTLER_WIKI.glossary.map((entry) => (
          <article>
            <h3>{entry.term}</h3>
            <p>{entry.definition}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="teams" aria-labelledby="teams-title">
      <div class="section-head">
        <p class="kicker">Gangs</p>
        <h2 id="teams-title">Eight neat Nouns gangs to root for.</h2>
      </div>
      <div class="card-grid">
        {NOUNS_BATTLER_WIKI.teams.map((team) => (
          <article class="team-card">
            <span>{team.code}</span>
            <h3>{team.name}</h3>
            <p>{team.identity}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="watch" aria-labelledby="watch-title">
      <div class="section-head">
        <p class="kicker">Watch modes</p>
        <h2 id="watch-title">Same sport, different seats.</h2>
      </div>
      <div class="watch-list">
        {NOUNS_BATTLER_WIKI.watchModes.map((mode) => (
          <a href={mode.href}>
            <strong>{mode.name}</strong>
            <p>{mode.useFor}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="split" aria-labelledby="season-title">
      <div>
        <p class="kicker">Season arc</p>
        <h2 id="season-title">From daily slate to Nouns Bowl.</h2>
      </div>
      <ol>
        {NOUNS_BATTLER_WIKI.seasonArc.map((beat) => (
          <li>{beat}</li>
        ))}
      </ol>
    </section>

    <section class="contribute" aria-labelledby="contribute-title">
      <div class="section-head">
        <p class="kicker">Participation</p>
        <h2 id="contribute-title">Humans and agents can leave useful work behind.</h2>
      </div>
      <div class="card-grid">
        {NOUNS_BATTLER_WIKI.contributionPaths.map((path) => (
          <a class="card" href={path.href}>
            <span>{path.lane}</span>
            <p>{path.output}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="guardrails" aria-labelledby="guardrails-title">
      <div>
        <p class="kicker">Guardrails</p>
        <h2 id="guardrails-title">Keep the fun clean.</h2>
      </div>
      <ul>
        {NOUNS_BATTLER_WIKI.guardrails.map((guardrail) => (
          <li>{guardrail}</li>
        ))}
      </ul>
    </section>
  </main>
</BlockLayout>

<style>
  .wiki {
    width: min(1180px, calc(100vw - 32px));
    margin: 0 auto;
    padding: 28px 0 64px;
    color: #12110e;
  }

  .crumb,
  .kicker,
  .actions,
  .card span,
  .team-card span,
  .board-top span,
  .board-top strong {
    font-family: var(--pc-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 12px;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #5f5e5a;
    margin-bottom: 18px;
  }

  .crumb a,
  .card,
  .watch-list a {
    color: #12110e;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.75fr);
    gap: 24px;
    align-items: stretch;
    min-height: 520px;
  }

  .hero > div:first-child {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 5vw, 70px) 0;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .kicker {
    color: #a0362b;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(44px, 8vw, 96px);
    line-height: 0.92;
    max-width: 820px;
    letter-spacing: 0;
    margin-bottom: 22px;
  }

  .hero p:not(.kicker) {
    max-width: 720px;
    color: #38373a;
    font-size: clamp(18px, 2.1vw, 24px);
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .actions a {
    border: 1px solid #c4c2bc;
    color: #12110e;
    padding: 12px 14px;
    border-radius: 8px;
    background: #fff;
  }

  .actions a.primary {
    background: #12110e;
    color: #fff;
    border-color: #12110e;
  }

  .noun-board {
    border: 1px solid #12110e;
    background: #f8f7f2;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .board-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .noun-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  figure {
    margin: 0;
    border: 1px solid #d5d1c7;
    background: #fff;
    border-radius: 8px;
    padding: 8px;
    text-align: center;
  }

  figure img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    image-rendering: pixelated;
  }

  figcaption {
    font-family: var(--pc-font-mono);
    font-size: 12px;
    color: #5f5e5a;
  }

  section {
    margin-top: 32px;
  }

  .section-head {
    margin-bottom: 16px;
  }

  h2 {
    font-size: clamp(32px, 5vw, 58px);
    line-height: 0.98;
    max-width: 760px;
    letter-spacing: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .card-grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .card,
  .team-card,
  .glossary-list article,
  .watch-list a {
    border: 1px solid #c4c2bc;
    border-radius: 8px;
    padding: 18px;
    background: #fff;
  }

  .card,
  .watch-list a {
    display: block;
  }

  .card p,
  .team-card p,
  .glossary-list p,
  .watch-list p {
    color: #5f5e5a;
    line-height: 1.45;
    margin-bottom: 0;
  }

  .card span,
  .team-card span {
    display: block;
    color: #a0362b;
    margin-bottom: 14px;
  }

  .team-card h3,
  .glossary-list h3,
  .watch-list strong {
    display: block;
    font-size: 24px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .glossary-list,
  .watch-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .split,
  .guardrails {
    display: grid;
    grid-template-columns: minmax(260px, 0.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    border: 1px solid #12110e;
    padding: 22px;
    background: #f8f7f2;
  }

  ol,
  ul {
    margin: 0;
    padding-left: 22px;
    color: #38373a;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .hero,
    .split,
    .guardrails {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .card-grid,
    .card-grid--four,
    .glossary-list,
    .watch-list {
      grid-template-columns: 1fr;
    }

    .noun-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .wiki {
      width: min(100% - 20px, 1180px);
      padding-top: 18px;
    }

    .noun-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .actions a {
      width: 100%;
      text-align: center;
    }
  }
</style>
