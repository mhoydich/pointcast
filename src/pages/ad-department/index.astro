---
import { ads, deckUrl, rackPath, sourceUrl } from '../../lib/ad-department/registry';
const title = 'The Ad Department · PointCast';
const description = 'Print ads for El Segundo Auto Repair. Browse the magazine rack and open an ad to read it.';
const canonical = 'https://pointcast.xyz' + rackPath;
const shareImage = canonical + ads[0].slug + '/share.png';
const folio = (index: number) => String(index + 1).padStart(2, '0');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    <main>
      <header>
        <a class="back" href="/ads">← PointCast Ads</a>
        <h1>The Ad Department</h1>
        <p>Print ads for El Segundo Auto Repair</p>
      </header>
      <nav class="pages" aria-label="Choose a print ad">
        {ads.map((ad, i) => <a href={'#' + ad.slug} aria-label={`Ad ${i + 1}: ${ad.title}`}>{folio(i)}</a>)}
      </nav>
      <ol class="rack" aria-label="Magazine rack">
        {ads.map(({ Poster, slug, title }, i) => (
          <li id={slug}>
            <div class="paper" inert aria-hidden="true"><Poster /></div>
            <a class="cover" href={rackPath + slug + '/'} aria-label={'Read ' + title}>
              <span class="folio">{folio(i)}</span><span class="caption">{title}</span><span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <footer><a class="decks" href={deckUrl}>Office Skate Team decks</a><div class="credit">Posters by Michael Hoydich. Noun characters and glasses are CC0.<br /><a href={sourceUrl}>Source · Brutalist Motor Art</a></div></footer>
    </main>
  </body>
</html>
<style>
  :global(html) { color-scheme: light; background: #f2efe7; }
  body { margin: 0; color: #28251f; font: 1rem/1.45 system-ui, sans-serif; }
  main { --gutter: clamp(16px, 4vw, 68px); max-width: 1500px; margin: auto; }
  header, footer { margin-inline: var(--gutter); }
  header { border-bottom: 2px solid; padding: clamp(14px, 3vw, 40px) 0 14px; }
  a { color: inherit; text-underline-offset: .22em; }
  .credit { max-width: 38ch; font-size: .8rem; }
  a:focus-visible { outline: 3px solid #82432b; outline-offset: 2px; }
  .back, footer { font-size: .85rem; }
  h1 { font: 500 clamp(2.65rem, 7.5vw, 7.5rem)/1 'Bodoni Moda', Didot, Georgia, serif; letter-spacing: -.065em; margin: .35em 0 .15em; }
  header p { margin: 0; }
  .pages { margin: 0 var(--gutter); display: flex; flex-wrap: wrap; padding: 3px 0; }
  .pages a { min-width: 44px; min-height: 44px; display: grid; place-items: center; font: .82rem 'Space Mono', monospace; }
  .rack { display: flex; gap: var(--gutter); margin: 0; padding: 4px var(--gutter) 12px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); list-style: none; }
  .rack li { position: relative; flex: 0 0 100%; min-width: 0; scroll-snap-align: start; }
  .paper { pointer-events: none; }
  .cover { display: flex; align-items: baseline; gap: .7rem; min-height: 44px; padding: 13px 0 0; text-decoration: none; }
  .cover::before { content: ''; position: absolute; inset: 0; }
  .cover:focus-visible { outline: none; }
  .cover:focus-visible::before { outline: 3px solid #82432b; outline-offset: 2px; }
  .cover:hover .caption { text-decoration: underline; }
  .caption { flex: 1; font: 600 .98rem/1.3 Georgia, serif; }
  .folio { font: .75rem 'Space Mono', monospace; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; border-top: 1px solid #847a68; padding: 18px 0 28px; }
  .decks { display: inline-flex; align-items: center; min-height: 44px; padding: 0 13px; border: 1px solid; text-decoration: none; }
  @media (min-width: 760px) {
    .pages { display: none; }
    .rack { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; gap: 1.65rem clamp(1.8rem, 3vw, 3rem); padding-block: 2rem; }
  }
  @media (min-width: 1080px) { .rack { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
