---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();

type Surface = {
  url: string;
  name: string;
  time: string;
  one_line: string;
  arc_shape: string;
  sigil: 'garden' | 'rain' | 'temple' | 'moon';
  hero_color: string;
  sky_top: string;
  sky_bottom: string;
};

const surfaces: Surface[] = [
  {
    url: '/drum-garden',
    name: 'Drum Garden',
    time: 'mid-morning',
    one_line: 'a small kit in a zen garden',
    arc_shape: 'builds toward noon-energy, resolves',
    sigil: 'garden',
    hero_color: '#d68f2c',
    sky_top: '#f4f3ed',
    sky_bottom: '#e3e0d3',
  },
  {
    url: '/drum-rain',
    name: 'Drum Rain',
    time: 'a summer afternoon',
    one_line: 'a storm of drum hits on wet tile',
    arc_shape: 'drizzle to downpour and back',
    sigil: 'rain',
    hero_color: '#9ed6f0',
    sky_top: '#2a3d3a',
    sky_bottom: '#162424',
  },
  {
    url: '/drum-temple',
    name: 'Drum Temple',
    time: 'dusk',
    one_line: 'a taiko ceremony in a temple courtyard',
    arc_shape: 'approach, peak, two gongs, leave',
    sigil: 'temple',
    hero_color: '#bd7a52',
    sky_top: '#e7d4b0',
    sky_bottom: '#bd7a52',
  },
  {
    url: '/drum-moon',
    name: 'Drum Moon',
    time: 'late night',
    one_line: 'bells in moonlight, no peak',
    arc_shape: 'refuses to climb — silence between bells is the song',
    sigil: 'moon',
    hero_color: '#e8d8a0',
    sky_top: '#0a1228',
    sky_bottom: '#1e2842',
  },
];
---
<BlockLayout title="Drum Pavilion — four meditative drum screensavers" description="Four ten-minute drum meditations, each shaped like a different time of day. Same green pavilion frame, four different rooms inside. Press play, set the tab aside, listen.">
  <main class="dp" id="dp" data-built={built}>
    <header class="dp__hero">
      <p class="dp__kicker">DRUM · PAVILION · four screensavers · ten minutes each</p>
      <h1 class="dp__title">Four rooms with drums in them.</h1>
      <p class="dp__sub">Each of these is a small pavilion looking onto a different time of day. Press Begin and the room plays itself for ten minutes — no buttons, no menus, no scrubbing. Set the tab on a second monitor, leave the room, come back. Or just sit there with it.</p>
      <p class="dp__sub">All audio is browser-generated — no samples, no streams. Synth kicks, brushed-noise snares, sine-stack bells, inharmonic gongs, the occasional far thunder. Each room is shaped by a different musical principle: a daytime arc that peaks and resolves, a weather system, a small ceremony, or a refusal to climb at all.</p>
    </header>

    <section class="dp__grid">
      {surfaces.map((s) => (
        <a class={`dp__card dp__card--${s.sigil}`} href={s.url} style={`--card-hero: ${s.hero_color}; --card-sky-top: ${s.sky_top}; --card-sky-bot: ${s.sky_bottom};`}>
          <div class="dp__pavilion-mini" aria-hidden="true">
            <div class="dp__pavilion-frame">
              <div class="dp__pavilion-rail dp__pavilion-rail--top"></div>
              <div class="dp__pavilion-rail dp__pavilion-rail--bot"></div>
              <div class="dp__pavilion-post dp__pavilion-post--l"></div>
              <div class="dp__pavilion-post dp__pavilion-post--r"></div>
              <div class="dp__pavilion-scene">
                {s.sigil === 'garden' && (
                  <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="dp__sigil-svg">
                    <rect x="0" y="0" width="200" height="60" fill={s.sky_top}/>
                    <rect x="0" y="55" width="200" height="65" fill={s.sky_bottom}/>
                    <ellipse cx="60" cy="80" rx="32" ry="12" fill="#7d7570"/>
                    <ellipse cx="135" cy="68" rx="8" ry="3" fill="#d4c8af"/>
                    <rect x="127" y="68" width="16" height="14" fill="#5a3422"/>
                    <ellipse cx="160" cy="74" rx="6" ry="2.5" fill="#d4c8af"/>
                    <rect x="154" y="74" width="12" height="10" fill="#5a3422"/>
                    <ellipse cx="180" cy="50" rx="10" ry="5" fill="#2f5236"/>
                    <line x1="178" y1="55" x2="178" y2="70" stroke="#3a2a1c" stroke-width="1"/>
                  </svg>
                )}
                {s.sigil === 'rain' && (
                  <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="dp__sigil-svg">
                    <defs>
                      <linearGradient id="dpRainBg" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color={s.sky_top}/>
                        <stop offset="100%" stop-color={s.sky_bottom}/>
                      </linearGradient>
                    </defs>
                    <rect x="0" y="0" width="200" height="120" fill="url(#dpRainBg)"/>
                    <g stroke="rgba(255,255,255,0.06)" stroke-width="0.6" fill="none">
                      <line x1="0" y1="40" x2="200" y2="40"/>
                      <line x1="0" y1="70" x2="200" y2="70"/>
                      <line x1="0" y1="100" x2="200" y2="100"/>
                      <line x1="45" y1="20" x2="45" y2="120"/>
                      <line x1="105" y1="20" x2="105" y2="120"/>
                      <line x1="155" y1="20" x2="155" y2="120"/>
                    </g>
                    <g fill="none" stroke="rgba(246,193,94,0.55)" stroke-width="1.2">
                      <circle cx="60" cy="40" r="14"/>
                      <circle cx="60" cy="40" r="22"/>
                    </g>
                    <g fill="none" stroke="rgba(220,200,160,0.55)" stroke-width="1">
                      <circle cx="120" cy="70" r="9"/>
                      <circle cx="120" cy="70" r="14"/>
                    </g>
                    <g fill="none" stroke="rgba(200,220,230,0.5)" stroke-width="0.8">
                      <circle cx="160" cy="30" r="5"/>
                      <circle cx="170" cy="95" r="4"/>
                      <circle cx="30" cy="90" r="6"/>
                    </g>
                  </svg>
                )}
                {s.sigil === 'temple' && (
                  <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="dp__sigil-svg">
                    <rect x="0" y="0" width="200" height="70" fill={s.sky_top}/>
                    <rect x="0" y="60" width="200" height="60" fill={s.sky_bottom}/>
                    <path d="M 0 70 L 0 50 L 60 32 L 120 42 L 200 36 L 200 70 Z" fill="#7a5238" opacity="0.55"/>
                    <ellipse cx="80" cy="100" rx="28" ry="5" fill="rgba(0,0,0,0.3)"/>
                    <rect x="56" y="68" width="48" height="32" rx="3" fill="#5a2418" stroke="#1a0c04"/>
                    <ellipse cx="80" cy="68" rx="24" ry="5" fill="#c8a878" stroke="#8a5c30" stroke-width="0.4"/>
                    <line x1="160" y1="36" x2="160" y2="50" stroke="#3a2418" stroke-width="0.7"/>
                    <line x1="178" y1="36" x2="178" y2="50" stroke="#3a2418" stroke-width="0.7"/>
                    <line x1="160" y1="36" x2="178" y2="36" stroke="#3a2418" stroke-width="1"/>
                    <circle cx="169" cy="62" r="10" fill="#a08038" stroke="#3a2410" stroke-width="0.5"/>
                    <rect x="22" y="76" width="10" height="8" fill="#7a7068"/>
                    <rect x="24" y="78" width="6" height="4" fill="#f6c15e" opacity="0.7"/>
                  </svg>
                )}
                {s.sigil === 'moon' && (
                  <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="dp__sigil-svg">
                    <defs>
                      <linearGradient id="dpMoonBg" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color={s.sky_top}/>
                        <stop offset="100%" stop-color={s.sky_bottom}/>
                      </linearGradient>
                      <radialGradient id="dpMoonGlow" cx="50%" cy="50%" r="60%">
                        <stop offset="0%" stop-color="rgba(255,247,216,0.5)"/>
                        <stop offset="100%" stop-color="rgba(255,247,216,0)"/>
                      </radialGradient>
                    </defs>
                    <rect x="0" y="0" width="200" height="120" fill="url(#dpMoonBg)"/>
                    <g fill="rgba(255,255,255,0.7)">
                      <circle cx="30" cy="20" r="0.8"/>
                      <circle cx="75" cy="14" r="0.7"/>
                      <circle cx="140" cy="22" r="0.9"/>
                      <circle cx="170" cy="40" r="0.6"/>
                      <circle cx="55" cy="35" r="0.7"/>
                      <circle cx="100" cy="42" r="0.8"/>
                    </g>
                    <circle cx="48" cy="44" r="36" fill="url(#dpMoonGlow)"/>
                    <circle cx="48" cy="44" r="14" fill="#e8d8a0"/>
                    <circle cx="44" cy="42" r="2" fill="#bba670"/>
                    <path d="M 0 78 L 0 72 L 50 64 L 100 70 L 150 60 L 200 66 L 200 78 Z" fill="#0e1426"/>
                    <line x1="130" y1="80" x2="130" y2="98" stroke="#2a1e16" stroke-width="0.6"/>
                    <path d="M 122 80 Q 118 70 130 66 Q 142 70 138 80 Z" fill="#a89460" stroke="#3a2a18" stroke-width="0.3"/>
                    <circle cx="155" cy="84" r="1.5" fill="#9ed68a"/>
                    <circle cx="100" cy="100" r="1.2" fill="#9ed68a"/>
                    <g stroke="#a89460" stroke-width="0.8">
                      <line x1="166" y1="78" x2="166" y2="92"/>
                      <line x1="170" y1="78" x2="170" y2="96"/>
                      <line x1="174" y1="78" x2="174" y2="88"/>
                    </g>
                  </svg>
                )}
              </div>
            </div>
          </div>
          <div class="dp__card-body">
            <div class="dp__card-meta">
              <span class="dp__card-name">{s.name}</span>
              <span class="dp__card-time">{s.time}</span>
            </div>
            <p class="dp__card-line">{s.one_line}</p>
            <p class="dp__card-arc">{s.arc_shape}</p>
            <span class="dp__card-cta">Begin →</span>
          </div>
        </a>
      ))}
    </section>

    <section class="dp__notes">
      <h2 class="dp__notes-h">What links them</h2>
      <p>Each surface lives in the same green pavilion frame — the architectural vocabulary borrowed from the Anthropic vitrine renders that started this register. Inside the frame the rooms differ: a zen garden in mid-morning, a wet tile floor in afternoon rain, a temple courtyard at dusk, the same garden again under moonlight.</p>
      <p>Audio in all four is browser-generated. No samples, no streams. The synth voices stay consistent across the rooms — sine-drop kicks, band-passed noise snares, sine-stack bells — but the weights and the arc shapes change. <em>Drum Garden</em> peaks at noon-energy. <em>Drum Rain</em> peaks at the downpour. <em>Drum Temple</em> peaks at the gong-framed ceremony. <em>Drum Moon</em> refuses to peak — its loudest section is still quieter than Drum Garden's quietest.</p>
      <p>There is intentionally no master volume, no tempo dial, no skip button. The brief was a screensaver for a real attention. The point isn't to control anything; it's to let a small room exist for ten minutes.</p>
      <p>These four sit inside the larger <code>/drum-*</code> family on pointcast.xyz — there are dozens of other drum surfaces, from cookie-clicker classics to bell-fall to vespers. This page is the meditative-pavilion subset.</p>
      <p>For the interactive side of the music suite, see <a href="/cast-table">/cast-table</a> — thirty-two surfaces grouped by what you're trying to do with whatever's playing.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --dp-frame: #1f5e3a;
      --dp-text: #2a3326;
      --dp-text-dim: #5a6356;
      --dp-text-dimmer: #8a9285;
    }

    body:has(.dp) {
      background: radial-gradient(circle at 50% 20%, #f8f6ec 0%, #ece8d8 70%);
      color: var(--dp-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .dp {
      max-width: 1180px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    .dp__hero {
      max-width: 760px;
      margin: 0 auto 48px;
    }
    .dp__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--dp-frame);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .dp__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 18px;
      color: var(--dp-text);
    }
    .dp__sub {
      font-size: 17px;
      line-height: 1.55;
      color: var(--dp-text-dim);
      margin: 0 0 16px;
    }
    .dp__sub:last-child { margin-bottom: 0; }

    .dp__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 56px;
    }
    @media (max-width: 760px) {
      .dp__grid { grid-template-columns: 1fr; }
    }

    .dp__card {
      display: flex;
      flex-direction: column;
      background: rgba(255,255,255,0.6);
      border: 1px solid rgba(31,94,58,0.16);
      border-radius: 18px;
      padding: 18px;
      text-decoration: none;
      color: inherit;
      transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
      overflow: hidden;
    }
    .dp__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(31,94,58,0.16);
      border-color: var(--card-hero);
    }

    .dp__pavilion-mini { margin-bottom: 18px; }
    .dp__pavilion-frame {
      position: relative;
      aspect-ratio: 5 / 3;
      border: 8px solid var(--dp-frame);
      border-radius: 3px;
      overflow: hidden;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.3);
    }
    .dp__pavilion-rail {
      position: absolute;
      left: 0; right: 0;
      height: 8px;
      background: var(--dp-frame);
      z-index: 2;
    }
    .dp__pavilion-rail--top { top: 0; }
    .dp__pavilion-rail--bot { bottom: 0; }
    .dp__pavilion-post {
      position: absolute;
      top: 0; bottom: 0;
      width: 7px;
      background: var(--dp-frame);
      z-index: 2;
    }
    .dp__pavilion-post--l { left: 33%; }
    .dp__pavilion-post--r { right: 33%; }
    .dp__pavilion-scene { position: absolute; inset: 0; z-index: 1; }
    .dp__sigil-svg { width: 100%; height: 100%; display: block; }

    .dp__card-body { display: flex; flex-direction: column; gap: 8px; }
    .dp__card-meta {
      display: flex;
      align-items: baseline;
      gap: 12px;
      flex-wrap: wrap;
    }
    .dp__card-name {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dp-text);
    }
    .dp__card-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--card-hero);
      text-transform: uppercase;
    }
    .dp__card-line {
      font-size: 15px; line-height: 1.5;
      color: var(--dp-text);
      margin: 0;
    }
    .dp__card-arc {
      font-size: 13px; line-height: 1.5;
      color: var(--dp-text-dim);
      font-style: italic;
      margin: 0;
    }
    .dp__card-cta {
      margin-top: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      color: var(--dp-frame);
      text-transform: uppercase;
    }

    .dp__notes {
      max-width: 720px;
      margin: 0 auto;
      padding-top: 36px;
      border-top: 1px solid rgba(31,94,58,0.14);
    }
    .dp__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--dp-text);
      margin: 0 0 14px;
    }
    .dp__notes p {
      font-size: 15px; line-height: 1.6;
      color: var(--dp-text-dim);
      margin: 0 0 14px;
    }
    .dp__notes em {
      color: var(--dp-frame);
      font-style: normal;
      font-weight: 600;
    }
    .dp__notes code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(31,94,58,0.08);
      color: var(--dp-frame);
    }
    .dp__notes a {
      color: var(--dp-frame);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    @media (max-width: 640px) {
      .dp__pavilion-frame { border-width: 6px; }
      .dp__pavilion-rail { height: 6px; }
      .dp__pavilion-post { width: 5px; }
    }
  </style>
</BlockLayout>
