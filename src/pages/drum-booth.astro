---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Drum Booth — late-night jazz meditation in a plant-filled diner" description="A different room. A booth in a warm mid-century corner — globe lamps, floral upholstery, framed art, plants spilling in. A small kit on the bench. Brushes, ride bell, the kick that walks. Ten minutes. Set and listen.">
  <main class="db" id="db" data-built={built}>
    <header class="db__hero">
      <p class="db__kicker">DRUM · BOOTH · brushed jazz · ten minutes · set and listen</p>
      <h1 class="db__title">A booth in a warm corner.</h1>
      <p class="db__sub">A different room than the pavilions. A booth in the back of a place with hanging globe lamps, floral upholstery, framed art on a textured wall, plants leaning into the frame. A small kit sits on the bench beside you. Brushes on the snare, the ride bell, the kick that walks. Ten minutes of late-night jazz that doesn't ask for anything.</p>
    </header>

    <section class="db__stage" id="db-stage" data-state="idle">
      <div class="db__room" aria-hidden="true">
        <svg class="db__scene" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid meet">
          <defs>
            <!-- Walls / ambient -->
            <linearGradient id="dbWall" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a07050"/>
              <stop offset="50%" stop-color="#7a5236"/>
              <stop offset="100%" stop-color="#4e3220"/>
            </linearGradient>
            <linearGradient id="dbCeiling" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a2515"/>
              <stop offset="100%" stop-color="#6a4220"/>
            </linearGradient>
            <radialGradient id="dbLamp" cx="50%" cy="40%" r="45%">
              <stop offset="0%" stop-color="#fff8c8"/>
              <stop offset="55%" stop-color="#f5d480"/>
              <stop offset="100%" stop-color="#c08838"/>
            </radialGradient>
            <radialGradient id="dbLampGlow" cx="50%" cy="50%" r="58%">
              <stop offset="0%" stop-color="rgba(255,232,160,0.55)"/>
              <stop offset="55%" stop-color="rgba(246,193,94,0.16)"/>
              <stop offset="100%" stop-color="rgba(246,193,94,0)"/>
            </radialGradient>
            <linearGradient id="dbTile" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#a87856"/>
              <stop offset="100%" stop-color="#5e3818"/>
            </linearGradient>
            <pattern id="dbUphol" x="0" y="0" width="120" height="80" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="120" height="80" fill="#a3593e"/>
              <!-- Big floral spots in jewel tones -->
              <circle cx="20" cy="22" r="14" fill="#f4c150" opacity="0.78"/>
              <circle cx="14" cy="18" r="6" fill="#e85e6b" opacity="0.8"/>
              <circle cx="78" cy="34" r="16" fill="#3c6e8a" opacity="0.78"/>
              <circle cx="84" cy="40" r="6" fill="#9bd28a" opacity="0.8"/>
              <circle cx="42" cy="56" r="12" fill="#d23e58" opacity="0.78"/>
              <circle cx="38" cy="62" r="5" fill="#f4c150" opacity="0.85"/>
              <circle cx="98" cy="64" r="10" fill="#5c8a4a" opacity="0.78"/>
              <ellipse cx="60" cy="14" rx="9" ry="5" fill="#7a3c5a" opacity="0.7"/>
              <ellipse cx="108" cy="14" rx="6" ry="3" fill="#9bd28a" opacity="0.8"/>
              <ellipse cx="6" cy="74" rx="6" ry="3" fill="#3c6e8a" opacity="0.7"/>
            </pattern>
            <linearGradient id="dbDrumShell" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#a86838"/>
              <stop offset="55%" stop-color="#7a4520"/>
              <stop offset="100%" stop-color="#3a1c08"/>
            </linearGradient>
            <linearGradient id="dbDrumHead" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f0e0c0"/>
              <stop offset="100%" stop-color="#c8a878"/>
            </linearGradient>
            <radialGradient id="dbCymbal" cx="50%" cy="35%" r="70%">
              <stop offset="0%" stop-color="#e8c878"/>
              <stop offset="65%" stop-color="#a8853a"/>
              <stop offset="100%" stop-color="#5a4218"/>
            </radialGradient>
            <radialGradient id="dbLeaf" cx="50%" cy="40%" r="60%">
              <stop offset="0%" stop-color="#7ba868"/>
              <stop offset="100%" stop-color="#2c4a28"/>
            </radialGradient>
          </defs>

          <!-- Ceiling band -->
          <rect x="0" y="0" width="1400" height="100" fill="url(#dbCeiling)"/>
          <!-- Wall -->
          <rect x="0" y="100" width="1400" height="540" fill="url(#dbWall)"/>
          <!-- Wood paneling lines -->
          <g stroke="rgba(58,32,16,0.42)" stroke-width="1">
            <line x1="0" y1="200" x2="1400" y2="200"/>
            <line x1="0" y1="320" x2="1400" y2="200" stroke-dasharray="0"/>
            <line x1="0" y1="440" x2="1400" y2="440"/>
          </g>
          <g stroke="rgba(58,32,16,0.3)" stroke-width="0.6">
            <line x1="180" y1="100" x2="180" y2="640"/>
            <line x1="380" y1="100" x2="380" y2="640"/>
            <line x1="600" y1="100" x2="600" y2="640"/>
            <line x1="820" y1="100" x2="820" y2="640"/>
            <line x1="1020" y1="100" x2="1020" y2="640"/>
            <line x1="1220" y1="100" x2="1220" y2="640"/>
          </g>

          <!-- Lamp glow circle (behind everything in upper-mid) -->
          <circle cx="450" cy="180" r="260" fill="url(#dbLampGlow)"/>
          <circle cx="950" cy="180" r="260" fill="url(#dbLampGlow)"/>

          <!-- Framed art on the wall -->
          <!-- Painting 1: abstract teal/coral -->
          <g transform="translate(180, 200)">
            <rect x="-50" y="-50" width="100" height="120" fill="#5a3422" stroke="#1a0c04" stroke-width="2"/>
            <rect x="-44" y="-44" width="88" height="108" fill="#f0d8b0"/>
            <path d="M -36 -20 Q -20 -36 0 -28 Q 24 -16 36 -36 L 36 50 L -36 50 Z" fill="#3c6e8a"/>
            <path d="M -30 10 Q -10 0 12 18 Q 28 28 40 12 L 40 50 L -36 50 Z" fill="#e85e6b" opacity="0.85"/>
          </g>
          <!-- Painting 2: abstract orange -->
          <g transform="translate(360, 220)">
            <rect x="-40" y="-30" width="80" height="60" fill="#5a3422" stroke="#1a0c04" stroke-width="2"/>
            <rect x="-35" y="-25" width="70" height="50" fill="#f0e0b8"/>
            <circle cx="-15" cy="0" r="18" fill="#f08038"/>
            <path d="M -8 12 Q 6 -8 28 -6 L 35 -25 L 35 25 L -35 25 Z" fill="#d23e58" opacity="0.8"/>
          </g>
          <!-- Painting 3: small purple -->
          <g transform="translate(530, 180)">
            <rect x="-25" y="-30" width="50" height="60" fill="#5a3422" stroke="#1a0c04" stroke-width="1.5"/>
            <rect x="-21" y="-26" width="42" height="52" fill="#3c2840"/>
            <circle cx="0" cy="-5" r="14" fill="#7a3c5a"/>
            <circle cx="6" cy="0" r="6" fill="#e85e6b" opacity="0.85"/>
          </g>
          <!-- Painting 4: green/yellow square -->
          <g transform="translate(680, 230)">
            <rect x="-35" y="-35" width="70" height="70" fill="#5a3422" stroke="#1a0c04" stroke-width="2"/>
            <rect x="-30" y="-30" width="60" height="60" fill="#f0e0b8"/>
            <rect x="-22" y="-22" width="44" height="44" fill="#5c8a4a"/>
            <rect x="-12" y="-12" width="24" height="24" fill="#f4c150"/>
          </g>
          <!-- Painting 5: tall narrow purple -->
          <g transform="translate(850, 200)">
            <rect x="-22" y="-50" width="44" height="100" fill="#5a3422" stroke="#1a0c04" stroke-width="2"/>
            <rect x="-18" y="-46" width="36" height="92" fill="#2a1c2e"/>
            <circle cx="0" cy="-26" r="10" fill="#9bd28a"/>
            <circle cx="-2" cy="0" r="8" fill="#f4c150"/>
            <circle cx="2" cy="24" r="6" fill="#e85e6b"/>
          </g>
          <!-- Painting 6: small abstract -->
          <g transform="translate(1010, 250)">
            <rect x="-30" y="-22" width="60" height="44" fill="#5a3422" stroke="#1a0c04" stroke-width="1.5"/>
            <rect x="-26" y="-18" width="52" height="36" fill="#e8d4a8"/>
            <path d="M -22 -8 L 5 -14 L 22 -2 L 22 14 L -22 14 Z" fill="#9bd28a"/>
            <circle cx="-8" cy="-2" r="6" fill="#e85e6b"/>
          </g>

          <!-- Hanging globe lamps -->
          <!-- Lamp 1 -->
          <g>
            <line x1="450" y1="0" x2="450" y2="160" stroke="#3a2515" stroke-width="2"/>
            <circle cx="450" cy="180" r="32" fill="url(#dbLamp)" stroke="#7a5230" stroke-width="0.5"/>
            <ellipse cx="446" cy="170" rx="10" ry="6" fill="#fff8e0" opacity="0.7"/>
          </g>
          <!-- Lamp 2 -->
          <g>
            <line x1="950" y1="0" x2="950" y2="160" stroke="#3a2515" stroke-width="2"/>
            <circle cx="950" cy="180" r="32" fill="url(#dbLamp)" stroke="#7a5230" stroke-width="0.5"/>
            <ellipse cx="946" cy="170" rx="10" ry="6" fill="#fff8e0" opacity="0.7"/>
          </g>

          <!-- Plants spilling from above and side -->
          <!-- Hanging plant top-left -->
          <g transform="translate(60, 0)">
            <rect x="-32" y="60" width="64" height="22" fill="#7a4220" stroke="#3a1c08"/>
            <ellipse cx="0" cy="60" rx="34" ry="6" fill="#3a1c08"/>
            <!-- Vines hanging down -->
            <g fill="url(#dbLeaf)">
              <ellipse cx="-26" cy="100" rx="8" ry="14"/>
              <ellipse cx="-16" cy="130" rx="7" ry="12"/>
              <ellipse cx="-8" cy="160" rx="6" ry="10"/>
              <ellipse cx="0" cy="190" rx="5" ry="9"/>
              <ellipse cx="22" cy="110" rx="9" ry="15"/>
              <ellipse cx="32" cy="142" rx="7" ry="11"/>
              <ellipse cx="14" cy="120" rx="8" ry="13"/>
              <ellipse cx="-4" cy="100" rx="9" ry="14"/>
              <ellipse cx="6" cy="80" rx="10" ry="12"/>
            </g>
          </g>
          <!-- Big monstera-like plant on the right -->
          <g transform="translate(1240, 180)">
            <rect x="-32" y="180" width="64" height="44" fill="#7a4220" stroke="#3a1c08"/>
            <g fill="url(#dbLeaf)">
              <!-- Large fronds -->
              <path d="M 0 180 Q -90 100 -110 -20 Q -100 -80 -50 -50 Q -10 -20 0 50 Z"/>
              <path d="M 0 180 Q 100 60 130 -40 Q 120 -100 60 -80 Q 20 -50 0 30 Z"/>
              <path d="M -10 170 Q -60 80 -40 30 Q 0 50 10 130 Z" opacity="0.85"/>
              <path d="M 10 170 Q 70 90 50 30 Q 0 60 -10 130 Z" opacity="0.85"/>
            </g>
            <!-- Subtle frond highlights -->
            <path d="M -50 -50 Q -30 0 0 30" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
            <path d="M 60 -80 Q 30 -10 0 30" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
          </g>
          <!-- Small fern on the floor right of booth -->
          <g transform="translate(1280, 580)">
            <rect x="-14" y="14" width="28" height="20" fill="#a87856" stroke="#5a3818"/>
            <g fill="url(#dbLeaf)">
              <ellipse cx="-12" cy="0" rx="6" ry="14" transform="rotate(-15 -12 0)"/>
              <ellipse cx="0" cy="-6" rx="6" ry="16"/>
              <ellipse cx="12" cy="0" rx="6" ry="14" transform="rotate(15 12 0)"/>
              <ellipse cx="-6" cy="-2" rx="5" ry="11" transform="rotate(-8 -6 -2)"/>
              <ellipse cx="6" cy="-2" rx="5" ry="11" transform="rotate(8 6 -2)"/>
            </g>
          </g>

          <!-- Booth back (across the room) -->
          <rect x="120" y="500" width="900" height="140" fill="url(#dbUphol)" stroke="#3a1c08" stroke-width="2"/>
          <!-- Booth top edge highlight -->
          <rect x="120" y="498" width="900" height="6" fill="#5a3422"/>
          <!-- Booth shadow below -->
          <rect x="120" y="640" width="900" height="14" fill="#2a1a0a"/>

          <!-- Tile floor in foreground -->
          <rect x="0" y="640" width="1400" height="160" fill="url(#dbTile)"/>
          <!-- Tile grid (mid-century pattern: 3-color blocks) -->
          <g>
            {Array.from({ length: 20 }, (_, i) => {
              const x = i * 80;
              const colors = ['#7a4528', '#a87856', '#e0b878', '#7a4528', '#a87856'];
              return colors.map((c, j) => (
                <rect x={x} y={640 + j * 24} width="80" height="24" fill={c} opacity={0.65 + (j * 0.05)} stroke="#3a1c08" stroke-width="0.4"/>
              ));
            })}
          </g>

          <!-- Small drum kit on a little corner stage (left of booth) -->
          <!-- Stage box -->
          <rect x="80" y="540" width="240" height="100" fill="#5a3818" stroke="#1a0c04" stroke-width="1.5"/>
          <rect x="78" y="538" width="244" height="4" fill="#7a5232"/>

          <!-- Kick -->
          <g class="db__drum db__drum--kick" data-voice="kick">
            <ellipse cx="200" cy="630" rx="54" ry="10" fill="rgba(0,0,0,0.4)"/>
            <ellipse cx="200" cy="595" rx="55" ry="44" fill="url(#dbDrumShell)" stroke="#1a0c04" stroke-width="0.8"/>
            <ellipse cx="200" cy="595" rx="42" ry="33" fill="url(#dbDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <circle cx="200" cy="595" r="6" fill="#3a1c08" opacity="0.85"/>
            <ellipse class="db__drum-ring" cx="200" cy="595" rx="62" ry="50" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Snare on a stand to the right of kick -->
          <g class="db__drum db__drum--snare" data-voice="snare">
            <line x1="280" y1="585" x2="280" y2="630" stroke="#3a2a1c" stroke-width="2"/>
            <ellipse cx="280" cy="630" rx="14" ry="3" fill="rgba(0,0,0,0.3)"/>
            <rect x="252" y="555" width="56" height="32" rx="3" fill="url(#dbDrumShell)" stroke="#1a0c04" stroke-width="0.5"/>
            <ellipse cx="280" cy="555" rx="28" ry="7" fill="url(#dbDrumHead)" stroke="#7c5532" stroke-width="0.5"/>
            <ellipse class="db__drum-ring" cx="280" cy="555" rx="34" ry="11" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>
          <!-- Ride cymbal on a stand to the left of kick -->
          <g class="db__drum db__drum--ride" data-voice="ride">
            <line x1="130" y1="555" x2="130" y2="620" stroke="#3a2a1c" stroke-width="2"/>
            <ellipse cx="130" cy="553" rx="42" ry="8" fill="url(#dbCymbal)" stroke="#5a4218" stroke-width="0.5"/>
            <ellipse cx="130" cy="553" rx="4" ry="2" fill="#5a4218"/>
            <ellipse class="db__drum-ring" cx="130" cy="553" rx="50" ry="12" fill="none" stroke="#f4c150" stroke-width="2" opacity="0"/>
          </g>

          <!-- Booth seat foreground (right side, like sitting on it) -->
          <rect x="900" y="660" width="500" height="100" fill="url(#dbUphol)" stroke="#3a1c08" stroke-width="2"/>
          <rect x="900" y="658" width="500" height="6" fill="#5a3422"/>

          <!-- Table edge between booths (just a sliver visible in mid-bottom) -->
          <rect x="600" y="700" width="280" height="14" fill="#5a3818" stroke="#1a0c04"/>
          <!-- Small salt + pepper on the table -->
          <rect x="700" y="678" width="10" height="22" fill="#e0d8b8" stroke="#7a5232" stroke-width="0.5"/>
          <rect x="730" y="678" width="10" height="22" fill="#3a2515" stroke="#7a5232" stroke-width="0.5"/>

          <!-- Subtle floor reflection of lamp -->
          <ellipse cx="450" cy="800" rx="300" ry="14" fill="rgba(246,193,94,0.08)"/>
          <ellipse cx="950" cy="800" rx="300" ry="14" fill="rgba(246,193,94,0.08)"/>
        </svg>
      </div>

      <div class="db__overlay" id="db-overlay">
        <button class="db__play" id="db-play" type="button" aria-label="Begin">
          <span class="db__play-icon" id="db-play-icon">▶</span>
          <span class="db__play-label" id="db-play-label">Begin</span>
        </button>
        <p class="db__overlay-hint">ten minutes · brushes and ride bell · no buttons after this</p>
      </div>

      <div class="db__status" id="db-status" hidden>
        <span class="db__status-time" id="db-status-time">00:00</span>
        <span class="db__status-sep">of</span>
        <span class="db__status-total">10:00</span>
        <span class="db__status-section" id="db-status-section">warming up</span>
        <button class="db__end" id="db-end" type="button">end early</button>
      </div>
    </section>

    <section class="db__about">
      <h2 class="db__about-h">Different room</h2>
      <p>The other meditative-drum surfaces sit inside a green pavilion. This one is a different vocabulary entirely — borrowed from a warm mid-century plant-filled diner booth, the first reference image Mike sketched alongside the zen-vitrine renders. Hanging globe lamps. Floral upholstery. Six framed paintings on a wood-paneled wall. A monstera leaning in from the right.</p>
      <p>Audio leans late-night jazz. The kick walks softly. The ride bell is the timekeeper, sustained and warm. The snare is brushed — band-passed noise with a long sweep, no triangle tone. There's a soft sub-octave that hints at an upright bass. The arc is one short jazz set: <em>warming up, the regulars arrive, first solo, groove, second solo, settling, after the set, last drink, the lights, closing</em>.</p>
      <p>Voices: 65→32 Hz sine kick with a longer decay than the pavilion kicks; brushed-noise snare (2 kHz band-passed) with a 320 ms sweep that mimics the brush; ride bell (1.2 kHz triangle + 600 Hz fifth) with a 1.6 s ring; cross-stick (high mallet at 700 Hz, very short). 68 BPM. No bell, no gong, no kit-wide low-pass filter — those belong to other rooms.</p>
      <p>Sister surfaces: <a href="/drum-pavilion">/drum-pavilion</a> for the five-pavilion register, or jump direct: <a href="/drum-garden">garden</a> · <a href="/drum-rain">rain</a> · <a href="/drum-temple">temple</a> · <a href="/drum-moon">moon</a> · <a href="/drum-snow">snow</a>.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --db-text: #2a3326;
      --db-text-dim: #5a6356;
      --db-text-dimmer: #8a9285;
      --db-amber: #d68f2c;
      --db-amber-deep: #a36b1c;
    }

    body:has(.db) {
      background: radial-gradient(circle at 50% 20%, #f8efd6 0%, #e0c898 70%);
      color: var(--db-text);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .db { max-width: 1400px; margin: 0 auto; padding: 48px 24px 80px; }

    .db__hero { text-align: left; max-width: 760px; margin: 0 auto 36px; }
    .db__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--db-amber-deep);
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .db__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 64px);
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 16px;
      color: var(--db-text);
    }
    .db__sub {
      font-size: 17px; line-height: 1.55;
      color: var(--db-text-dim);
      margin: 0;
    }

    .db__stage { position: relative; margin-bottom: 36px; }

    .db__room {
      position: relative;
      aspect-ratio: 7 / 4;
      max-height: 80vh;
      background: #2a1a0a;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0,0,0,0.4), inset 0 0 0 3px rgba(0,0,0,0.4);
    }
    .db__scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    @keyframes dbPulse {
      0%   { opacity: 0.85; transform: scale(1); }
      100% { opacity: 0;    transform: scale(1.18); }
    }
    .db__drum-ring.db__drum-ring--pulse {
      animation: dbPulse 1.6s ease-out;
      transform-origin: center;
      transform-box: fill-box;
    }
    .db__drum--struck { animation: dbStrike 0.4s ease-out; transform-origin: center; transform-box: fill-box; }
    @keyframes dbStrike {
      0% { transform: translateY(0); }
      28% { transform: translateY(2px) scale(0.985); }
      100% { transform: translateY(0); }
    }

    .db__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      z-index: 5;
      background: radial-gradient(circle at center, rgba(20,10,0,0.35) 0%, rgba(20,10,0,0.65) 100%);
      backdrop-filter: blur(2px);
      transition: opacity 600ms ease, visibility 600ms;
    }
    .db__stage[data-state="playing"] .db__overlay,
    .db__stage[data-state="ended"] .db__overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .db__stage[data-state="ended"] .db__overlay {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition-delay: 0.8s;
    }
    .db__play {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }
    .db__play-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: #f4c150;
      color: #3a1c08;
      font-size: 32px;
      display: flex; align-items: center; justify-content: center;
      box-shadow:
        0 14px 36px rgba(244,193,80,0.45),
        inset 0 -4px 8px rgba(0,0,0,0.18),
        inset 0 4px 6px rgba(255,255,255,0.4);
      transition: transform 100ms ease;
    }
    .db__play:hover .db__play-icon { transform: scale(1.04); }
    .db__play:active .db__play-icon { transform: scale(0.96); }
    .db__play-label {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 17px;
      color: #f4e0a8;
      letter-spacing: 0.04em;
    }
    .db__overlay-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: rgba(244,224,168,0.7);
      text-transform: lowercase;
      margin: 0;
    }

    .db__status {
      position: absolute;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: baseline;
      gap: 8px;
      z-index: 5;
      padding: 8px 16px;
      background: rgba(30,18,8,0.78);
      border: 1px solid rgba(244,193,80,0.3);
      border-radius: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: #d8c89c;
      opacity: 0;
      transition: opacity 0.6s ease 0.6s;
    }
    .db__stage[data-state="playing"] .db__status,
    .db__stage[data-state="ended"] .db__status { opacity: 1; }
    .db__stage[data-state="ended"] .db__status { opacity: 0.7; }
    .db__status-time { font-weight: 600; color: #f4e0a8; font-variant-numeric: tabular-nums; }
    .db__status-sep { color: rgba(216,200,156,0.6); }
    .db__status-total { color: #f4e0a8; }
    .db__status-section { margin-left: 12px; color: #f4c150; text-transform: uppercase; }
    .db__end {
      margin-left: 12px;
      padding: 2px 10px;
      background: transparent;
      border: 1px solid rgba(244,193,80,0.4);
      border-radius: 8px;
      color: #f4c150;
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .db__end:hover { background: rgba(244,193,80,0.15); }

    .db__about { max-width: 720px; margin: 0 auto; padding: 12px 0 0; }
    .db__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--db-text);
      margin: 0 0 14px;
    }
    .db__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--db-text-dim);
      margin: 0 0 14px;
    }
    .db__about em { color: var(--db-amber-deep); font-style: italic; }
    .db__about a {
      color: var(--db-amber-deep);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type Voice = 'kick' | 'snare' | 'ride' | 'stick' | 'sub';

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let noiseBuf: AudioBuffer | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.55;
      masterGain.connect(ctx.destination);
    }
    function noise(ac: AudioContext): AudioBuffer {
      if (noiseBuf) return noiseBuf;
      const len = ac.sampleRate * 3;
      const b = ac.createBuffer(1, len, ac.sampleRate);
      const d = b.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      noiseBuf = b;
      return b;
    }

    // Walking kick: 65→32Hz sine, longer decay
    function playKick(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(65, t);
      osc.frequency.exponentialRampToValueAtTime(32, t + 0.22);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.42 * vel, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.55);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.6);
      flashDrum('kick');
    }

    // Brushed snare: sweep band-passed noise (not a hit, a sweep)
    function playSnare(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.setValueAtTime(1600, t);
      bp.frequency.linearRampToValueAtTime(2400, t + 0.28);
      bp.Q.value = 0.6;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.16 * vel, t + 0.04);
      g.gain.setValueAtTime(g.gain.value, t + 0.18);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.36);
      src.connect(bp).connect(g).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 0.4);
      flashDrum('snare');
    }

    // Ride bell: triangle + perfect-fifth partial, long warm ring
    function playRide(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const partials = [
        { freq: 1200, gain: 0.16, decay: 1.8, type: 'triangle' as OscillatorType },
        { freq: 1800, gain: 0.08, decay: 1.2, type: 'triangle' as OscillatorType },
        { freq: 600,  gain: 0.06, decay: 1.4, type: 'sine'     as OscillatorType },
      ];
      for (const p of partials) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = p.type;
        osc.frequency.value = p.freq;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(p.gain * vel, t + 0.005);
        g.gain.exponentialRampToValueAtTime(0.0001, t + p.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(t);
        osc.stop(t + p.decay + 0.1);
      }
      // Add the noise sheen typical of a ride
      const src = ctx.createBufferSource();
      src.buffer = noise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 4800;
      bp.Q.value = 0.5;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.0001, t);
      ng.gain.exponentialRampToValueAtTime(0.06 * vel, t + 0.03);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 1.2);
      src.connect(bp).connect(ng).connect(masterGain);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + 1.3);
      flashDrum('ride');
    }

    // Cross-stick: short high mallet
    function playStick(t: number, vel = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(720, t);
      osc.frequency.exponentialRampToValueAtTime(540, t + 0.04);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.16 * vel, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.08);
      flashDrum('snare');
    }

    // Sub bass hint (upright-bass-ish): a brief sine note 110-160Hz
    function playSub(t: number, vel = 1, freq = 110) {
      if (!ctx || !scheduler || !masterGain) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, t);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.9, t + 0.5);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.16 * vel, t + 0.04);
      g.gain.setValueAtTime(0.16 * vel, t + 0.4);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.85);
      osc.connect(g).connect(masterGain);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.9);
    }

    function flashDrum(voice: Voice) {
      const sel = voice === 'stick' ? 'snare' : voice;
      const group = document.querySelector(`.db__drum--${sel}`);
      if (!group) return;
      group.classList.remove('db__drum--struck');
      (group as any).offsetHeight;
      group.classList.add('db__drum--struck');
      setTimeout(() => group.classList.remove('db__drum--struck'), 420);
      const ring = group.querySelector('.db__drum-ring');
      if (ring) {
        ring.classList.remove('db__drum-ring--pulse');
        (ring as any).getBoundingClientRect();
        ring.classList.add('db__drum-ring--pulse');
        setTimeout(() => ring.classList.remove('db__drum-ring--pulse'), 1700);
      }
    }

    // ---- arc ----
    type Section = {
      name: string;
      sparsity: number;
      weights: Partial<Record<Voice, number>>;
      // Walking-bass pulse on certain sections: bass plays on quarter notes
      walkingBass?: boolean;
      bassNotes?: number[];  // Hz cycle for the walking line
    };
    const SECTIONS: Section[] = [
      { name: 'warming up',        sparsity: 0.10, weights: { ride: 5, stick: 1 } },
      { name: 'the regulars',      sparsity: 0.22, weights: { ride: 5, stick: 1.5, kick: 1, snare: 0.5 }, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'first solo',        sparsity: 0.34, weights: { ride: 5, snare: 2.5, kick: 1.5, stick: 1.2 }, walkingBass: true, bassNotes: [110, 110, 146.83, 130.81] },
      { name: 'groove',            sparsity: 0.45, weights: { ride: 5, snare: 3, kick: 2, stick: 1 }, walkingBass: true, bassNotes: [110, 130.81, 146.83, 130.81] },
      { name: 'second solo',       sparsity: 0.55, weights: { ride: 5, snare: 4, kick: 2, stick: 1.5 }, walkingBass: true, bassNotes: [110, 110, 164.81, 146.83] },
      { name: 'a long ride',       sparsity: 0.42, weights: { ride: 6, snare: 2, kick: 1.5, stick: 1 }, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'settling',          sparsity: 0.28, weights: { ride: 5, snare: 1.5, kick: 1.5, stick: 1 }, walkingBass: true, bassNotes: [110, 110, 130.81, 110] },
      { name: 'after the set',     sparsity: 0.14, weights: { ride: 5, snare: 1, stick: 1 } },
      { name: 'last drink',        sparsity: 0.08, weights: { ride: 5, stick: 1 } },
      { name: 'the lights',        sparsity: 0.04, weights: { ride: 4, stick: 1 } },
    ];

    const SECTION_LEN_SEC = 60;
    const BPM = 68;
    const BEAT_SEC = 60 / BPM;
    const SUBDIVISION = 4;
    const SLOT_SEC = BEAT_SEC / SUBDIVISION;
    const TOTAL_SEC = SECTIONS.length * SECTION_LEN_SEC;

    let playing = false;
    let startCtxTime = 0;
    let nextSlotTime = 0;
    let slotIdx = 0;
    let scheduleTimer: number | null = null;
    let uiTimer: number | null = null;
    let schedulingComplete = false;
    let lastWalkBeat = -1;

    function pickWeighted(weights: Partial<Record<Voice, number>>): Voice | null {
      const entries = Object.entries(weights) as [Voice, number][];
      let total = 0;
      for (const [, w] of entries) total += w;
      if (total <= 0) return null;
      let r = Math.random() * total;
      for (const [v, w] of entries) { r -= w; if (r <= 0) return v; }
      return entries[0][0];
    }

    function fireVoice(voice: Voice, t: number, vel: number) {
      switch (voice) {
        case 'kick':  playKick(t, vel); break;
        case 'snare': playSnare(t, vel); break;
        case 'ride':  playRide(t, vel); break;
        case 'stick': playStick(t, vel); break;
        case 'sub':   playSub(t, vel); break;
      }
    }

    function scheduleAhead() {
      if (!playing || !ctx) return;
      const horizon = ctx.currentTime + 0.6;
      while (nextSlotTime < horizon) {
        const elapsed = nextSlotTime - startCtxTime;
        if (elapsed >= TOTAL_SEC) { schedulingComplete = true; break; }
        const sectionIdx = Math.min(SECTIONS.length - 1, Math.floor(Math.max(0, elapsed) / SECTION_LEN_SEC));
        const section = SECTIONS[sectionIdx];

        const slotInBar = slotIdx % 16;  // 4 beats × 4 subs
        const beatInBar = Math.floor(slotInBar / SUBDIVISION);  // 0..3
        const isQuarter = (slotInBar % SUBDIVISION) === 0;
        const isDownbeat = slotInBar === 0;
        const isBackbeat = slotInBar === 8;  // beat 3 of a 4-beat bar
        const isOffbeat = !isQuarter;  // 8th and 16th notes between quarters

        // Walking bass on quarter notes if section enabled
        if (section.walkingBass && section.bassNotes && isQuarter) {
          const bassFreq = section.bassNotes[beatInBar % section.bassNotes.length];
          if (lastWalkBeat !== slotIdx) {
            playSub(nextSlotTime, 0.85, bassFreq);
            lastWalkBeat = slotIdx;
          }
        }

        // Ride bell strong on quarter notes (jazz feel)
        let p = section.sparsity;
        if (isQuarter) p = Math.min(1, p * 1.6);
        else if (isOffbeat) p = p * 0.7;

        if (Math.random() < p) {
          let voice = pickWeighted(section.weights);
          // On a quarter note, bias toward ride bell (the jazz timekeeper)
          if (isQuarter && Math.random() < 0.55 && section.weights.ride) voice = 'ride';
          // On backbeat (beat 3), bias snare brush
          if (isBackbeat && Math.random() < 0.5 && section.weights.snare) voice = 'snare';
          if (voice) {
            const vel = isDownbeat ? 0.95 : (isBackbeat ? 0.85 : 0.55 + Math.random() * 0.3);
            fireVoice(voice, nextSlotTime, vel);
          }
        }

        nextSlotTime += SLOT_SEC;
        slotIdx++;
      }
      if (playing) scheduleTimer = window.setTimeout(scheduleAhead, 70);
    }

    function tickUi() {
      if (!ctx) return;
      const elapsed = playing ? ctx.currentTime - startCtxTime : 0;
      const clamped = Math.min(TOTAL_SEC, elapsed);
      const mm = Math.floor(clamped / 60);
      const ss = Math.floor(clamped % 60);
      document.getElementById('db-status-time')!.textContent =
        `${String(mm).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
      const si = Math.min(SECTIONS.length - 1, Math.floor(clamped / SECTION_LEN_SEC));
      document.getElementById('db-status-section')!.textContent = SECTIONS[si].name;
      if (playing && clamped >= TOTAL_SEC && schedulingComplete) {
        stopPlaying(true);
      }
      if (playing) uiTimer = window.setTimeout(tickUi, 250);
    }

    function startPlaying() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      playing = true;
      schedulingComplete = false;
      slotIdx = 0;
      lastWalkBeat = -1;
      startCtxTime = ctx.currentTime + 0.3;
      nextSlotTime = startCtxTime;
      document.getElementById('db-stage')!.setAttribute('data-state', 'playing');
      document.getElementById('db-status')!.removeAttribute('hidden');
      scheduleAhead();
      tickUi();
    }
    function stopPlaying(natural = false) {
      playing = false;
      if (scheduleTimer != null) { clearTimeout(scheduleTimer); scheduleTimer = null; }
      if (uiTimer != null) { clearTimeout(uiTimer); uiTimer = null; }
      if (!natural && scheduler) scheduler.stopAll();
      document.getElementById('db-stage')!.setAttribute('data-state', natural ? 'ended' : 'idle');
      document.getElementById('db-play-label')!.textContent = natural ? 'Again' : 'Begin';
    }

    function init() {
      document.getElementById('db-play')!.addEventListener('click', () => startPlaying());
      document.getElementById('db-end')!.addEventListener('click', () => stopPlaying(false));
      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden && playing) ctx.suspend().catch(() => {});
        else if (!document.hidden && playing) ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
