---
/** /drum-round — Door 5 of the Ten Doors (2026-11-02). One bar of drums passed around a table of six. */
import TenDoorsFrame from '../components/TenDoorsFrame.astro';
---

<TenDoorsFrame slug="drum-round">
  <canvas class="td-canvas" id="dr-ring" width="640" height="640" aria-label="A ring of sixteen steps around a table of six seats. On your turn, tap a step to add a hit."></canvas>
  <div class="td-row" role="group" aria-label="Your drum">
    <button class="td-btn is-on" data-voice="0" aria-pressed="true">Kick</button>
    <button class="td-btn" data-voice="1" aria-pressed="false">Clap</button>
    <button class="td-btn" data-voice="2" aria-pressed="false">Hat</button>
    <button class="td-btn" data-voice="3" aria-pressed="false">Tom</button>
    <button class="td-btn" data-voice="4" aria-pressed="false">Rim</button>
  </div>
  <div class="td-row">
    <button class="td-btn" id="dr-reset">Start over</button>
    <button class="td-btn" id="dr-keep" hidden>Keep this bar</button>
  </div>
  <p class="td-readout" id="dr-read" aria-live="polite">Your seat first. Pick a drum, tap a step on the ring.</p>
  <ol class="dr-kept" id="dr-kept" aria-label="Bars you kept"></ol>
</TenDoorsFrame>

<style>
  .dr-kept { font: 0.85rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0.8rem auto 0; max-width: 32rem; }
</style>

<script>
  import { tone, hz, kick, noise, fitCanvas, pointerXY, load, save, audio } from '../lib/ten-doors/audio.mjs';

  const W = 640, H = 640, CX = W / 2, CY = H / 2, R = 220, STEPS = 16, LAPS = 6;
  const VOICES = ['kick', 'clap', 'hat', 'tom', 'rim'];
  const COLORS = ['#f2c14e', '#ff6b6b', '#7fd1ff', '#c792ff', '#9be38f'];
  const SEATS = [
    { name: 'You', rule: 'any step, any drum' },
    { name: 'Sky', rule: 'a hat on an empty off-beat' },
    { name: 'Tides', rule: 'a kick on a downbeat' },
    { name: 'Swell', rule: 'a tom right after a hit, a little roll' },
    { name: 'Sun', rule: 'a clap on the backbeat' },
    { name: 'Air', rule: 'a rim in the emptiest gap, or takes a hit away when the bar is crowded' },
  ];
  const canvas = document.getElementById('dr-ring');
  const g = fitCanvas(canvas, W, H);
  const read = document.getElementById('dr-read');
  const keptEl = document.getElementById('dr-kept');
  let bar, lap, seat, voice = 0, playing = false, step = 0, nextAt = 0, started = false;
  const fresh = () => VOICES.map(() => new Array(STEPS).fill(false));
  function reset() { bar = fresh(); lap = 1; seat = 0; document.getElementById('dr-keep').hidden = true; read.textContent = 'Your seat first. Pick a drum, tap a step on the ring.'; }
  reset();

  const hits = () => bar.reduce((n, row) => n + row.filter(Boolean).length, 0);
  const emptyAt = (s) => bar.every((row) => !row[s]);
  const pickFrom = (list) => list[Math.floor(Math.random() * list.length)];

  function agentMove(i) {
    const S = [...Array(STEPS).keys()];
    if (i === 1) { const s = pickFrom(S.filter((s) => s % 4 === 2 && !bar[2][s])) ?? pickFrom(S.filter((s) => s % 2 === 1)); bar[2][s] = true; return `Sky put a hat on step ${s + 1}.`; }
    if (i === 2) { const s = pickFrom(S.filter((s) => s % 4 === 0 && !bar[0][s])) ?? pickFrom(S.filter((s) => s % 2 === 0)); bar[0][s] = true; return `Tides dropped a kick on step ${s + 1}.`; }
    if (i === 3) { const after = S.filter((s) => !emptyAt(s) && emptyAt((s + 1) % STEPS)).map((s) => (s + 1) % STEPS); const s = pickFrom(after) ?? pickFrom(S); bar[3][s] = true; return `Swell rolled a tom into step ${s + 1}.`; }
    if (i === 4) { const s = pickFrom([4, 12].filter((s) => !bar[1][s])) ?? pickFrom(S.filter((s) => s % 8 === 4 || s % 8 === 7)); bar[1][s] = true; return `Sun clapped on step ${s + 1}.`; }
    if (hits() > 11) {
      const all = []; bar.forEach((row, v) => row.forEach((on, s) => on && v !== 0 && all.push([v, s])));
      const [v, s] = pickFrom(all); bar[v][s] = false; return `Air took the ${VOICES[v]} off step ${s + 1}. Room to breathe.`;
    }
    let bestS = 0, bestGap = -1;
    for (const s of S) { if (!emptyAt(s)) continue; let gap = 0; while (gap < STEPS && emptyAt((s + gap) % STEPS)) gap += 1; if (gap > bestGap) { bestGap = gap; bestS = (s + Math.floor(gap / 2)) % STEPS; } }
    bar[4][bestS] = true; return `Air tapped a rim into the gap at step ${bestS + 1}.`;
  }

  function passAround() {
    let delay = 0;
    for (let i = 1; i < SEATS.length; i += 1) {
      delay += 700;
      setTimeout(() => {
        seat = i; read.textContent = agentMove(i);
        if (i === SEATS.length - 1) setTimeout(() => {
          seat = 0;
          if (lap >= LAPS) { read.textContent = `Six laps. The bar is finished with ${hits()} hits. Keep it or start over.`; document.getElementById('dr-keep').hidden = false; seat = -1; }
          else { lap += 1; read.textContent = `Lap ${lap} of ${LAPS}. Your seat again.`; }
        }, 600);
      }, delay);
    }
  }

  function play(v, when) {
    if (v === 0) kick(when, 0.6);
    else if (v === 1) noise({ length: 0.12, gain: 0.35, freq: 1500, q: 0.7, when });
    else if (v === 2) noise({ length: 0.035, gain: 0.16, freq: 9000, type: 'highpass', when });
    else if (v === 3) tone(hz(45), { type: 'sine', length: 0.12, release: 0.2, gain: 0.35, when });
    else tone(1700, { type: 'square', length: 0.01, release: 0.05, gain: 0.08, when });
  }

  const stepXY = (s, r = R) => { const a = (s / STEPS) * Math.PI * 2 - Math.PI / 2; return { x: CX + Math.cos(a) * r, y: CY + Math.sin(a) * r }; };
  canvas.addEventListener('pointerdown', (e) => {
    audio(); started = true; playing = true;
    if (seat !== 0) return;
    const { x, y } = pointerXY(canvas, e, W, H);
    for (let s = 0; s < STEPS; s += 1) {
      const p = stepXY(s);
      if (Math.hypot(x - p.x, y - p.y) < 34) { bar[voice][s] = true; play(voice, 0); read.textContent = `You put a ${VOICES[voice]} on step ${s + 1}. Passing the bar.`; seat = 1; passAround(); return; }
    }
  });
  document.querySelectorAll('[data-voice]').forEach((b) => b.addEventListener('click', () => {
    voice = Number(b.dataset.voice); audio(); started = true; playing = true; play(voice, 0);
    document.querySelectorAll('[data-voice]').forEach((o) => { o.classList.toggle('is-on', o === b); o.setAttribute('aria-pressed', String(o === b)); });
  }));
  document.getElementById('dr-reset').addEventListener('click', reset);
  const kept = load('drum-round:kept', []);
  const renderKept = () => { keptEl.innerHTML = ''; kept.slice(-5).forEach((k) => { const li = document.createElement('li'); li.textContent = `${k.name}: ${k.code}`; keptEl.append(li); }); };
  renderKept();
  document.getElementById('dr-keep').addEventListener('click', () => {
    const name = (window.prompt('Name this bar', `Round ${kept.length + 1}`) || `Round ${kept.length + 1}`).slice(0, 40);
    const code = bar.map((row) => row.map((on) => (on ? '1' : '0')).join('')).join('|');
    kept.push({ name, code }); save('drum-round:kept', kept.slice(-20)); renderKept();
    read.textContent = `Kept "${name}". Start over for a new round.`;
  });

  setInterval(() => {
    if (!playing || !started) return;
    const now = performance.now(); if (now < nextAt) return;
    nextAt = now + 60000 / 104 / 4; step = (step + 1) % STEPS;
    bar.forEach((row, v) => row[step] && play(v, 0.01));
  }, 8);

  function draw(ts) {
    g.fillStyle = '#1d1410'; g.fillRect(0, 0, W, H);
    g.fillStyle = '#3b2a1e'; g.beginPath(); g.arc(CX, CY, 150, 0, Math.PI * 2); g.fill();
    g.strokeStyle = '#5b4330'; g.lineWidth = 2; g.beginPath(); g.arc(CX, CY, R, 0, Math.PI * 2); g.stroke();
    for (let s = 0; s < STEPS; s += 1) {
      const p = stepXY(s);
      g.fillStyle = s === step && playing ? '#4d3a2a' : '#2a1d15'; g.beginPath(); g.arc(p.x, p.y, 26, 0, Math.PI * 2); g.fill();
      g.strokeStyle = s % 4 === 0 ? '#f2c14e' : '#6b5040'; g.lineWidth = s % 4 === 0 ? 2 : 1; g.stroke();
      bar.forEach((row, v) => { if (!row[s]) return; const q = stepXY(s, R - 18 + v * 9); g.fillStyle = COLORS[v]; g.beginPath(); g.arc(q.x, q.y, s === step ? 7 : 5, 0, Math.PI * 2); g.fill(); });
    }
    SEATS.forEach((st, i) => {
      const a = (i / SEATS.length) * Math.PI * 2 - Math.PI / 2;
      const x = CX + Math.cos(a) * 105, y = CY + Math.sin(a) * 105;
      g.fillStyle = i === seat ? '#f2c14e' : '#2a1d15'; g.beginPath(); g.arc(x, y, 26, 0, Math.PI * 2); g.fill();
      g.fillStyle = i === seat ? '#1d1410' : '#f2c14e'; g.font = '600 13px ui-monospace, monospace'; g.textAlign = 'center'; g.fillText(st.name, x, y + 4);
    });
    g.fillStyle = '#f2c14e'; g.font = '600 15px ui-monospace, monospace'; g.textAlign = 'center';
    g.fillText(seat === -1 ? 'finished' : `lap ${lap} / ${LAPS}`, CX, CY + 4);
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
</script>
