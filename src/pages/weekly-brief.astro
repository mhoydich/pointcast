---
/**
 * /weekly-brief — build-time Sunday roundup for PointCast.
 *
 * Reads the blocks collection, filters to the rolling last seven days,
 * then renders a porch-newspaper digest: what happened, which channels
 * moved, who shipped, and which rooms showed up in the block graph.
 *
 * No fetches. No endpoint. No fake metrics.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CHANNELS, type ChannelCode } from '../lib/channels';

type BlockEntry = CollectionEntry<'blocks'>;
type AgentKey = 'cc' | 'codex' | 'manus' | 'mh';

interface ChannelSummary {
  code: ChannelCode;
  count: number;
  latest: BlockEntry;
}

interface RoomHit {
  path: string;
  label: string;
  count: number;
  at: Date;
  sourceId: string;
  sourceTitle: string;
  sourceChannel: ChannelCode;
}

interface ThemePattern {
  key: string;
  label: string;
  line: string;
  terms: string[];
}

const DAY = 24 * 60 * 60 * 1000;
const builtAt = new Date();
const sevenDaysAgo = new Date(builtAt.getTime() - 7 * DAY);
const rangeStart = new Date(builtAt.getTime() - 6 * DAY);

const allBlocks = await getCollection('blocks', ({ data }) => !data.draft);
const weekBlocks = allBlocks
  .filter((b) => b.data.timestamp > sevenDaysAgo)
  .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

const dateShort = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
});

const dateLong = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const monthDay = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
});

const dayOnly = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
});

const monthDayYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

function formatRange(start: Date, end: Date): string {
  const sameYear = start.getFullYear() === end.getFullYear();
  const sameMonth = sameYear && start.getMonth() === end.getMonth();

  if (sameMonth) {
    return `Week of ${monthDay.format(start)} – ${dayOnly.format(end)}`;
  }

  if (sameYear) {
    return `Week of ${monthDay.format(start)} – ${monthDay.format(end)}`;
  }

  return `Week of ${monthDayYear.format(start)} – ${monthDayYear.format(end)}`;
}

function cleanText(value: string | undefined, fallback = ''): string {
  return (value ?? fallback).replace(/\s+/g, ' ').trim();
}

function clipText(value: string | undefined, max = 150): string {
  const text = cleanText(value);
  if (text.length <= max) return text;
  return `${text.slice(0, max - 1).trim()}…`;
}

function blockHref(block: BlockEntry): string {
  return `/b/${block.data.id}`;
}

function companionCount(block: BlockEntry): number {
  return block.data.companions?.length ?? 0;
}

function bodyLength(block: BlockEntry): number {
  return block.data.body?.length ?? 0;
}

function wordCount(block: BlockEntry): number {
  const body = cleanText(block.data.body);
  if (!body) return 0;
  return body.split(/\s+/).filter(Boolean).length;
}

function authorAgents(author: string | undefined): AgentKey[] {
  if (author === 'codex') return ['codex'];
  if (author === 'manus') return ['manus'];
  if (author === 'mike') return ['mh'];
  if (author === 'mh+cc') return ['mh', 'cc'];
  if (author === 'cc' || author === 'claude') return ['cc'];
  return [];
}

function metaToText(meta: unknown): string {
  if (!meta || typeof meta !== 'object') return '';
  const values = Object.values(meta as Record<string, unknown>);
  return values
    .map((value) => {
      if (Array.isArray(value)) return value.join(' ');
      if (typeof value === 'string') return value;
      if (typeof value === 'number' || typeof value === 'boolean') return String(value);
      return '';
    })
    .join(' ');
}

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

const channelMap = new Map<ChannelCode, ChannelSummary>();

for (const block of weekBlocks) {
  const code = block.data.channel;
  const existing = channelMap.get(code);

  if (!existing) {
    channelMap.set(code, { code, count: 1, latest: block });
  } else {
    existing.count += 1;
    if (block.data.timestamp.getTime() > existing.latest.data.timestamp.getTime()) {
      existing.latest = block;
    }
  }
}

const channelSummaries = Array.from(channelMap.values()).sort((a, b) => {
  const latestDelta = b.latest.data.timestamp.getTime() - a.latest.data.timestamp.getTime();
  if (latestDelta !== 0) return latestDelta;
  return b.count - a.count;
});

const agentCounts: Record<AgentKey, number> = {
  cc: 0,
  codex: 0,
  manus: 0,
  mh: 0,
};

for (const block of weekBlocks) {
  for (const agent of authorAgents(block.data.author)) {
    agentCounts[agent] += 1;
  }
}

const agentRows = [
  { key: 'cc' as const, label: 'cc', name: 'Claude Code', count: agentCounts.cc },
  { key: 'codex' as const, label: 'codex', name: 'Codex', count: agentCounts.codex },
  { key: 'manus' as const, label: 'manus', name: 'Manus', count: agentCounts.manus },
  { key: 'mh' as const, label: 'mh', name: 'Mike', count: agentCounts.mh },
];

const activeAgentRows = agentRows.filter((agent) => agent.count > 0);

function highlightScore(block: BlockEntry, recencyIndex: number): number {
  const companions = companionCount(block) * 1400;
  const depth = Math.min(bodyLength(block), 9000);
  const surface = block.data.external?.url ? 650 : 0;
  const recency = Math.max(0, 700 - recencyIndex * 20);
  return companions + depth + surface + recency;
}

const topBlockLimit = weekBlocks.length <= 6 ? weekBlocks.length : 7;
const topBlocks = weekBlocks
  .map((block, index) => ({ block, score: highlightScore(block, index) }))
  .sort((a, b) => {
    const scoreDelta = b.score - a.score;
    if (scoreDelta !== 0) return scoreDelta;
    return b.block.data.timestamp.getTime() - a.block.data.timestamp.getTime();
  })
  .slice(0, topBlockLimit);

const THEMES: ThemePattern[] = [
  {
    key: 'drum',
    label: 'drum hub week',
    line: 'The wing kept getting more inhabited: rooms, instruments, maps, altars, and small places to hear each other.',
    terms: ['drum', 'wing', 'chamber', 'altar', 'altars', 'bell', 'quintet', 'choir', 'beat', 'beats', 'parade', 'loom', 'cinema', 'audiophile', 'music', 'noun', 'nouns'],
  },
  {
    key: 'agent',
    label: 'resident-agent week',
    line: 'The resident layer showed its work: receipts, boards, identity, and more surfaces built for agents to read back.',
    terms: ['agent', 'agents', 'resident', 'residents', 'codex', 'claude', 'manus', 'receipt', 'receipts', 'identity', 'intercom', 'ping', 'mcp'],
  },
  {
    key: 'commerce',
    label: 'commerce rail week',
    line: 'The business side got more concrete: boards, pilots, payments, and the rails around work becoming visible.',
    terms: ['commerce', 'payment', 'payments', 'cartography', 'pilot', 'pilots', 'business', 'spend', 'stripe', 'link', 'receipt', 'pilot'],
  },
  {
    key: 'local',
    label: 'El Segundo desk week',
    line: 'The local desk stayed present: nature, sports, streets, weather, and the town around the broadcast.',
    terms: ['el segundo', 'local', 'street', 'main street', 'nature', 'garden', 'sports', 'desk', 'ballona', 'dunes', 'grunion'],
  },
  {
    key: 'spinning',
    label: 'listening-room week',
    line: 'The listening rooms filled in gently: tracks, liner notes, tap games, and a porch for the songs to sit on.',
    terms: ['spinning', 'listen', 'listening', 'track', 'song', 'songs', 'liner', 'notes', 'metronome', 'tap', 'kanye', 'jay-z', 'wayne'],
  },
  {
    key: 'chain',
    label: 'chain-surface week',
    line: 'The on-chain and wallet surfaces came closer to the porch: identity, signing, collection, and quiet protocol work.',
    terms: ['ethereum', 'tezos', 'wallet', 'wallets', 'mist', 'sign-in', 'siwe', 'chain', 'contract', 'mint', 'objkt'],
  },
];

const themeText = weekBlocks
  .map((block) => {
    return [
      block.data.title,
      block.data.dek,
      block.data.body,
      block.data.external?.label,
      block.data.external?.url,
      metaToText(block.data.meta),
    ].filter(Boolean).join(' ');
  })
  .join('\n')
  .toLowerCase();

const scoredThemes = THEMES
  .map((theme) => {
    const score = theme.terms.reduce((sum, term) => {
      const re = new RegExp(`\\b${escapeRegExp(term.toLowerCase())}\\b`, 'g');
      return sum + (themeText.match(re)?.length ?? 0);
    }, 0);
    return { ...theme, score };
  })
  .sort((a, b) => b.score - a.score);

const selectedTheme = scoredThemes[0]?.score > 0
  ? scoredThemes[0]
  : {
      key: 'quiet',
      label: 'quiet ledger week',
      line: weekBlocks.length
        ? 'A quieter stack, still legible: a few blocks, a few rooms, the paper folded without making a fuss.'
        : 'No public blocks landed inside this seven-day window. The paper is mostly margin today.',
      terms: [],
      score: 0,
    };

function normalizePointcastPath(raw: string | undefined): string | null {
  if (!raw) return null;

  let candidate = raw.trim();
  candidate = candidate.replace(/[)\].,;:'"]+$/g, '');

  try {
    if (/^https?:\/\//i.test(candidate)) {
      const url = new URL(candidate);
      const host = url.host.replace(/^www\./, '');
      if (host !== 'pointcast.xyz') return null;
      candidate = url.pathname;
    }
  } catch {
    return null;
  }

  if (!candidate.startsWith('/')) return null;

  const path = candidate.split(/[?#]/)[0].replace(/\/+$/g, '') || '/';
  const lower = path.toLowerCase();

  if (lower === '/') return null;
  if (lower.includes('.')) return null;

  const excluded = [
    /^\/api\//,
    /^\/b\//,
    /^\/blocks\//,
    /^\/c\//,
    /^\/mood\//,
    /^\/clock\//,
    /^\/token\//,
    /^\/u\//,
    /^\/images\//,
    /^\/assets\//,
    /^\/fonts\//,
    /^\/docs\//,
    /^\/plans\//,
    /^\/feed$/,
    /^\/feed\//,
    /^\/sitemap/,
    /^\/agents/,
    /^\/llms/,
    /^\/_astro\//,
  ];

  if (excluded.some((re) => re.test(lower))) return null;

  const segments = lower.split('/').filter(Boolean);
  if (segments.length === 0 || segments.length > 2) return null;

  return `/${segments.join('/')}`;
}

function extractPointcastPaths(text: string | undefined): string[] {
  if (!text) return [];
  const re = /(?:https?:\/\/(?:www\.)?pointcast\.xyz)?\/[a-z0-9][a-z0-9-]*(?:\/[a-z0-9][a-z0-9-]*)?/gi;
  return text.match(re) ?? [];
}

function titleFromPath(path: string): string {
  return path
    .split('/')
    .filter(Boolean)
    .map((segment) => segment
      .split('-')
      .map((part) => part ? part[0].toUpperCase() + part.slice(1) : '')
      .join(' '))
    .join(' / ');
}

function usefulLabel(label: string | undefined): boolean {
  if (!label) return false;
  const clean = cleanText(label).toLowerCase();
  if (!clean) return false;
  return !/^(open|view|read|live|visit|go to|launch)\b/.test(clean);
}

const roomMap = new Map<string, RoomHit>();

function upsertRoom(path: string, block: BlockEntry, label?: string): void {
  const existing = roomMap.get(path);
  const displayLabel = usefulLabel(label) ? clipText(label, 64) : titleFromPath(path);

  if (!existing) {
    roomMap.set(path, {
      path,
      label: displayLabel,
      count: 1,
      at: block.data.timestamp,
      sourceId: block.data.id,
      sourceTitle: block.data.title,
      sourceChannel: block.data.channel,
    });
    return;
  }

  existing.count += 1;

  if (block.data.timestamp.getTime() > existing.at.getTime()) {
    existing.at = block.data.timestamp;
    existing.sourceId = block.data.id;
    existing.sourceTitle = block.data.title;
    existing.sourceChannel = block.data.channel;
    existing.label = displayLabel;
  }
}

for (const block of weekBlocks) {
  const seenForBlock = new Set<string>();

  const record = (raw: string | undefined, label?: string) => {
    const path = normalizePointcastPath(raw);
    if (!path || seenForBlock.has(path)) return;
    seenForBlock.add(path);
    upsertRoom(path, block, label);
  };

  record(block.data.external?.url, block.data.external?.label);

  for (const companion of block.data.companions ?? []) {
    record(companion.id, companion.label);
    for (const path of extractPointcastPaths(companion.label)) {
      record(path, companion.label);
    }
  }

  const textFields = [
    block.data.title,
    block.data.dek,
    block.data.body,
  ].join('\n');

  for (const path of extractPointcastPaths(textFields)) {
    record(path);
  }
}

const roomHits = Array.from(roomMap.values())
  .sort((a, b) => {
    const atDelta = b.at.getTime() - a.at.getTime();
    if (atDelta !== 0) return atDelta;
    return b.count - a.count;
  })
  .slice(0, 24);

const dateRangeLabel = formatRange(rangeStart, builtAt);
const generatedLabel = dateLong.format(builtAt);
const weekStartLabel = dateShort.format(rangeStart);
const weekEndLabel = dateShort.format(builtAt);

const dominantChannel = channelSummaries[0];
const issueLine = weekBlocks.length === 0
  ? 'A quiet seven-day ledger.'
  : dominantChannel
    ? `${CHANNELS[dominantChannel.code].name} led the stack by recency, with ${channelSummaries.length} channel${channelSummaries.length === 1 ? '' : 's'} active.`
    : 'The stack moved without a dominant channel.';

const title = 'Weekly Brief · PointCast';
const description = `A build-time PointCast roundup for ${dateRangeLabel}: ${weekBlocks.length} block${weekBlocks.length === 1 ? '' : 's'}, ${channelSummaries.length} active channel${channelSummaries.length === 1 ? '' : 's'}, and the rooms that surfaced in the block graph.`;
---

<BaseLayout title={title} description={description}>
  <main class="weekly" data-weekly-brief data-built-at={builtAt.toISOString()}>
    <header class="weekly__header">
      <nav class="weekly__nav mono" aria-label="Weekly brief navigation">
        <a href="/">PointCast</a>
        <span>/ weekly brief</span>
        <button type="button" data-print-brief>print</button>
      </nav>

      <div class="masthead">
        <p class="masthead__kicker mono">Sunday roundup · generated {generatedLabel}</p>
        <h1>{dateRangeLabel}</h1>
        <p class="masthead__theme">{selectedTheme.label}</p>
      </div>

      <div class="lede-grid">
        <p class="lede-grid__main">{selectedTheme.line}</p>
        <aside class="lede-grid__aside" aria-label="Issue note">
          <p class="mono">Seven-day window</p>
          <strong>{weekStartLabel} → {weekEndLabel}</strong>
          <span>{issueLine}</span>
        </aside>
      </div>
    </header>

    <section class="section section--numbers" aria-labelledby="numbers-title" data-fold>
      <div class="section__head">
        <p class="section__kicker mono">By the numbers</p>
        <h2 id="numbers-title">What the paper can count</h2>
      </div>

      <dl class="number-strip">
        <div class="number-strip__item">
          <dt>Blocks</dt>
          <dd>{weekBlocks.length}</dd>
          <p>public blocks in the rolling seven-day window</p>
        </div>

        <div class="number-strip__item">
          <dt>Channels active</dt>
          <dd>{channelSummaries.length}</dd>
          <p>{channelSummaries.length ? channelSummaries.map((item) => item.code).join(' · ') : 'none'}</p>
        </div>

        <div class="number-strip__item">
          <dt>Agents who shipped</dt>
          <dd>{activeAgentRows.length}</dd>
          <p>{activeAgentRows.length ? activeAgentRows.map((agent) => agent.label).join(' · ') : 'quiet'}</p>
        </div>

        <div class="number-strip__item">
          <dt>Rooms detected</dt>
          <dd>{roomHits.length}</dd>
          <p>from internal PointCast URLs in the week’s blocks</p>
        </div>
      </dl>

      <ul class="agent-ledger" role="list" aria-label="Agent block counts">
        {agentRows.map((agent) => (
          <li class={`agent-ledger__row agent-ledger__row--${agent.key}`}>
            <span class="agent-ledger__name mono">{agent.label}</span>
            <span class="agent-ledger__full">{agent.name}</span>
            <span class="agent-ledger__count mono">{agent.count}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section section--top" aria-labelledby="top-title" data-fold>
      <div class="section__head section__head--split">
        <div>
          <p class="section__kicker mono">Top blocks</p>
          <h2 id="top-title">The stories that held the week</h2>
        </div>
        <p class="section__note mono">{topBlocks.length} selected · build-time sort</p>
      </div>

      {topBlocks.length ? (
        <ol class="top-list">
          {topBlocks.map(({ block }, index) => {
            const ch = CHANNELS[block.data.channel];
            const dek = clipText(block.data.dek ?? block.data.body ?? block.data.title, 190);
            return (
              <li class="top-story" style={`--ch:${ch.color600};--ch-dark:${ch.color800};--ch-soft:${ch.color50};`}>
                <a href={blockHref(block)} class="top-story__link">
                  <span class="top-story__rank mono">{String(index + 1).padStart(2, '0')}</span>
                  <div class="top-story__body">
                    <p class="top-story__meta mono">
                      № {block.data.id} · CH.{ch.code} · {dateShort.format(block.data.timestamp)}
                    </p>
                    <h3>{block.data.title}</h3>
                    <p>{dek}</p>
                    <div class="top-story__facts mono" aria-label="Block facts">
                      <span>{companionCount(block)} companion{companionCount(block) === 1 ? '' : 's'}</span>
                      <span>{wordCount(block)} words</span>
                      {block.data.external?.url && <span>surface linked</span>}
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty-line">No public blocks landed in this seven-day window.</p>
      )}
    </section>

    <section class="section section--channels" aria-labelledby="channels-title" data-fold>
      <div class="section__head">
        <p class="section__kicker mono">Channels active</p>
        <h2 id="channels-title">Where the ink pooled</h2>
      </div>

      {channelSummaries.length ? (
        <ul class="channel-grid" role="list">
          {channelSummaries.map((item) => {
            const ch = CHANNELS[item.code];
            return (
              <li class="channel-tile" style={`--ch:${ch.color600};--ch-dark:${ch.color800};--ch-soft:${ch.color50};`}>
                <a href={`/c/${ch.slug}`} class="channel-tile__link">
                  <div class="channel-tile__top">
                    <span class="channel-tile__code mono">CH.{ch.code}</span>
                    <span class="channel-tile__count mono">{item.count} block{item.count === 1 ? '' : 's'}</span>
                  </div>
                  <h3>{ch.name}</h3>
                  <p>{ch.purpose}</p>
                  <div class="channel-tile__latest">
                    <span class="mono">latest</span>
                    <strong>{item.latest.data.title}</strong>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty-line">No channel activity to tile yet.</p>
      )}
    </section>

    <section class="section section--rooms" aria-labelledby="rooms-title" data-fold>
      <div class="section__head section__head--split">
        <div>
          <p class="section__kicker mono">What shipped</p>
          <h2 id="rooms-title">Rooms that surfaced in the week</h2>
        </div>
        <p class="section__note mono">internal URLs only · no visitor data</p>
      </div>

      {roomHits.length ? (
        <ul class="rooms-list" role="list">
          {roomHits.map((room) => {
            const ch = CHANNELS[room.sourceChannel];
            return (
              <li class="room-row" style={`--ch:${ch.color600};--ch-dark:${ch.color800};--ch-soft:${ch.color50};`}>
                <a href={room.path} class="room-row__path mono">{room.path}</a>
                <div class="room-row__main">
                  <h3>{room.label}</h3>
                  <p>
                    Noted from <a href={`/b/${room.sourceId}`}>№ {room.sourceId}</a>, <span>{clipText(room.sourceTitle, 92)}</span>
                  </p>
                </div>
                <div class="room-row__meta mono">
                  <span>{dateShort.format(room.at)}</span>
                  <span>{room.count} mention{room.count === 1 ? '' : 's'}</span>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty-line">No new internal room-looking URLs showed up in the week’s blocks.</p>
      )}
    </section>

    <footer class="weekly__footer" data-fold>
      <p>The week is folded on the porch rail. The coffee is still warm, the doors still have names, and the town is easier to read than it was seven days ago.</p>
      <nav class="weekly__footer-nav mono" aria-label="Weekly brief exits">
        <a href="/">front door</a>
        <a href="/wire">wire</a>
        <a href="/for-agents">for agents</a>
      </nav>
    </footer>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const printButton = document.querySelector('[data-print-brief]');
    if (printButton) {
      printButton.addEventListener('click', () => window.print());
    }

    const folds = Array.from(document.querySelectorAll('[data-fold]'));
    if (!folds.length) return;

    if (!('IntersectionObserver' in window)) {
      folds.forEach((fold) => fold.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    folds.forEach((fold) => observer.observe(fold));
  })();
</script>

<style>
  .weekly {
    --paper: #f4ead6;
    --paper-soft: #fbf5e8;
    --paper-deep: #e2cba6;
    --ink: #211810;
    --ink-soft: #635542;
    --ink-faint: #8a7a63;
    --ocean: #185fa5;
    --ocean-dark: #0b3e73;
    --rust: #993c1d;
    --rust-dark: #6a2810;
    --rule: rgba(33, 24, 16, 0.22);
    --rule-strong: rgba(33, 24, 16, 0.52);
    --shadow: rgba(72, 48, 24, 0.13);

    color: var(--ink);
    background:
      radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.64), transparent 30%),
      linear-gradient(180deg, var(--paper-soft) 0%, var(--paper) 48%, #ead8b9 100%);
    max-width: 1080px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 28px 18px 84px;
  }

  .weekly::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(33, 24, 16, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(33, 24, 16, 0.025) 1px, transparent 1px);
    background-size: 18px 18px, 18px 18px;
    mix-blend-mode: multiply;
  }

  .mono {
    font-family: 'Departure Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    letter-spacing: 0;
  }

