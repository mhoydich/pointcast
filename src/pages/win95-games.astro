---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ACHIEVEMENTS, ARCADE_ASSETS, RETRO_ARCADE_GAMES } from '../lib/retro-arcade';

const title = 'Windows 95 Games';
const description = 'PointCast Retro Arcade: a Windows 95 worthy Nouns game shelf with Solitaire, Memory, Pyramid, Mines, local stats, and achievements.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/win95-games',
  name: 'PointCast Retro Arcade',
  description,
  url: 'https://pointcast.xyz/win95-games',
  hasPart: RETRO_ARCADE_GAMES.map((game) => ({
    '@type': 'Game',
    name: game.name,
    description: game.description,
    url: `https://pointcast.xyz${game.path}`,
  })),
};
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.desktop} jsonLd={jsonLd} alternates={[{ type: 'application/json', href: '/win95-games.json', title: 'PointCast Retro Arcade JSON' }]}>
  <main class="desk" data-arcade-hub style={`--arcade-desktop:url('${ARCADE_ASSETS.desktop}'); --arcade-table:url('${ARCADE_ASSETS.table}'); --arcade-card-backs:url('${ARCADE_ASSETS.cardBacks}');`}>
    <section class="window" aria-labelledby="games-title">
      <header class="titlebar">
        <span>PointCast Retro Arcade</span>
        <span aria-hidden="true">_ □ x</span>
      </header>

      <nav class="menubar" aria-label="Arcade menu">
        <a href="/">Home</a>
        <a href="/app">App</a>
        <a href="/apps">Apps</a>
        <a href="/win95-games.json">JSON</a>
      </nav>

      <section class="hero">
        <p>WINDOWS 95 · NOUNS · LOCAL ARCADE</p>
        <h1 id="games-title">A little desktop of card things.</h1>
        <span>Shared table art, saved local progress, achievements, and small games that feel like they belong together.</span>
      </section>

      <section class="profile" aria-label="Local arcade profile">
        <div>
          <span>Total plays</span>
          <strong data-total-plays>0</strong>
        </div>
        <div>
          <span>Cleared games</span>
          <strong data-clears>0</strong>
        </div>
        <div>
          <span>Favorite</span>
          <strong data-favorite>--</strong>
        </div>
        <div>
          <span>Last played</span>
          <strong data-last-played>--</strong>
        </div>
      </section>

      <section class="grid" aria-label="Arcade games">
        {RETRO_ARCADE_GAMES.map((game) => (
          <a class={`game game--${game.category}`} href={game.path} data-game-card={game.slug}>
            <span>{game.kicker}</span>
            <strong>{game.name}</strong>
            <em>{game.description}</em>
            <small data-game-stat={game.slug}>No local plays yet</small>
          </a>
        ))}
      </section>

      <section class="achievements" aria-labelledby="achievements-title">
        <div>
          <p>ACHIEVEMENTS</p>
          <h2 id="achievements-title">Local badges, no account required.</h2>
        </div>
        <ul>
          {ARCADE_ACHIEVEMENTS.map((achievement) => (
            <li data-achievement={achievement.id}>
              <strong>{achievement.name}</strong>
              <span>{achievement.description}</span>
            </li>
          ))}
        </ul>
      </section>
    </section>
  </main>
</BlockLayout>

<script>
  const games = [
    { slug: 'solitaire-v2', name: 'Solitaire' },
    { slug: 'nouns-memory-v2', name: 'Memory' },
    { slug: 'nouns-pyramid-v2', name: 'Pyramid' },
    { slug: 'nouns-mines-v2', name: 'Mines' },
  ];
  const profileKey = 'pc:arcade:profile';

  function readJson(key, fallback) {
    try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
  }

  function render() {
    const profile = readJson(profileKey, {});
    const totals = games.map((game) => {
      const stats = readJson(`pc:arcade:${game.slug}`, {});
      const plays = Number(stats.plays || 0);
      const clears = Number(stats.clears || 0);
      const stat = document.querySelector(`[data-game-stat="${game.slug}"]`);
      if (stat) stat.textContent = plays ? `${plays} plays · ${clears} clears` : 'No local plays yet';
      return { ...game, plays, clears };
    });
    const totalPlays = totals.reduce((sum, game) => sum + game.plays, 0);
    const clears = totals.reduce((sum, game) => sum + game.clears, 0);
    const favorite = totals.slice().sort((a, b) => b.plays - a.plays)[0];
    document.querySelector('[data-total-plays]').textContent = String(totalPlays);
    document.querySelector('[data-clears]').textContent = String(clears);
    document.querySelector('[data-favorite]').textContent = favorite?.plays ? favorite.name : '--';
    document.querySelector('[data-last-played]').textContent = profile.lastPlayed || '--';
    const achievements = new Set(profile.achievements || []);
    document.querySelectorAll('[data-achievement]').forEach((node) => {
      node.classList.toggle('is-earned', achievements.has(node.dataset.achievement));
    });
  }

  render();
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:18px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; }
  .window { max-width:1120px; margin:0 auto; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; box-shadow:2px 2px 0 #000; }
  .titlebar { display:flex; justify-content:space-between; min-height:28px; padding:4px 7px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .menubar { display:flex; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar a { color:#000; padding:4px 8px; text-decoration:none; }
  .menubar a:hover { background:#000080; color:#fff; }
  .hero { padding:28px; border-top:1px solid #fff; border-bottom:1px solid #808080; background:linear-gradient(rgba(0,40,46,.2),rgba(0,34,39,.54)),var(--arcade-desktop) center/cover; color:#fff; text-shadow:1px 1px 0 #000; }
  .hero p,.game span,.achievements p,.profile span { margin:0 0 10px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; text-transform:uppercase; }
  h1 { max-width:820px; margin:0; font-size:clamp(44px,8vw,96px); line-height:.9; }
  .hero > span { display:block; max-width:720px; margin-top:12px; font-size:18px; line-height:1.35; }
  .profile { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; padding:4px; }
  .profile div,.achievements { border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:10px; }
  .profile strong { display:block; overflow-wrap:anywhere; font:700 20px/1 "Courier New",monospace; }
  .grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; padding:14px; }
  .game { min-height:220px; display:grid; align-content:start; gap:10px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#fff; color:#000; padding:14px; text-decoration:none; }
  .game:hover { background:#000080; color:#fff; text-decoration:none; }
  .game strong { font-size:30px; line-height:1; }
  .game em,.game small { color:inherit; font-style:normal; line-height:1.4; }
  .game small { align-self:end; border-top:1px solid currentColor; padding-top:8px; font-family:"Courier New",monospace; }
  .achievements { margin:0 14px 14px; }
  .achievements h2 { margin:0; font-size:28px; line-height:1; }
  .achievements ul { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin:12px 0 0; padding:0; list-style:none; }
  .achievements li { min-height:88px; border:1px solid #808080; background:#efefef; padding:10px; opacity:.62; }
  .achievements li.is-earned { opacity:1; background:#ffffcc; box-shadow:inset 0 0 0 2px #ffff00; }
  .achievements strong,.achievements span { display:block; }
  .achievements span { margin-top:5px; line-height:1.35; }
  @media (max-width:860px) { .grid,.profile,.achievements ul{grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media (max-width:560px) { .desk{padding:8px}.grid,.profile,.achievements ul{grid-template-columns:1fr}.hero{padding:18px}.game{min-height:150px} }
</style>
