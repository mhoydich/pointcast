---
import BlockLayout from '../layouts/BlockLayout.astro';
import { COHORT_OFFERINGS, FOUR_FOODWAYS, FRAMING_POSITION, HONEST_CAUTIONS, NINETY_DAY_FOOD_PROTOCOL, PAPER_META, PAPER_NOTES, REFERENCES, SEASONAL_CYCLE, SEVEN_CORRIDOR_FOOD_PRINCIPLES, SOURCING, THE_COHORT_TABLE, THE_PLATE } from '../lib/foodPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/food', name: PAPER_META.title, description, url: 'https://pointcast.xyz/food', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/food.json', title: 'Food (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/plant">plant</a><span aria-hidden="true">/</span><span>food</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY · INTEGRATIVE-NUTRITION LINEAGE</p>
      <h1>FOOD.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="frame"><p class="kicker">FRAMING · THE INTEGRATIVE-NUTRITION POSITION</p><h2>How the corridor eats.</h2>
      <p class="oneliner">{FRAMING_POSITION.oneSentence}</p>
      <p class="block"><strong>Why not industrial food:</strong> {FRAMING_POSITION.whyNotIndustrialFood}</p>
      <p class="block"><strong>Why not optimization diet:</strong> {FRAMING_POSITION.whyNotOptimizationDiet}</p>
      <p class="block"><strong>Why Mediterranean-Asian baseline:</strong> {FRAMING_POSITION.whyMediterraneanAsianBaseline}</p>
      <p class="block"><strong>Why the table:</strong> {FRAMING_POSITION.whyTheTable}</p>
      <p class="block"><strong>Why cohort:</strong> {FRAMING_POSITION.whyCohort}</p>
      <p class="block"><strong>Honest uncertainty:</strong> {FRAMING_POSITION.honestUncertainty}</p>
    </section>

    <section class="princ"><p class="kicker">SEVEN CORRIDOR FOOD PRINCIPLES</p><h2>What we orient by.</h2>
      <ol class="pr-list">{SEVEN_CORRIDOR_FOOD_PRINCIPLES.map((p, i) => (
        <li>
          <div class="pr__head"><span class="pr__num">{String(i+1).padStart(2,'0')}</span><h3>{p.principle}</h3></div>
          <p>{p.detail}</p>
        </li>
      ))}</ol>
    </section>

    <section class="seasons"><p class="kicker">SEASONAL CYCLE · COASTAL CALIFORNIA</p><h2>{SEASONAL_CYCLE.description}</h2>
      <ol class="ssn-list">
        <li class="ssn ssn--winter">
          <h3>Winter <span class="ssn__months">{SEASONAL_CYCLE.winter.months}</span></h3>
          <p class="ssn__row"><strong>In season:</strong> {SEASONAL_CYCLE.winter.inSeason}</p>
          <p class="ssn__row"><strong>Cooking mode:</strong> {SEASONAL_CYCLE.winter.cookingMode}</p>
          <p class="ssn__row pr__coastal"><strong>Coastal note:</strong> {SEASONAL_CYCLE.winter.coastalNote}</p>
        </li>
        <li class="ssn ssn--spring">
          <h3>Spring <span class="ssn__months">{SEASONAL_CYCLE.spring.months}</span></h3>
          <p class="ssn__row"><strong>In season:</strong> {SEASONAL_CYCLE.spring.inSeason}</p>
          <p class="ssn__row"><strong>Cooking mode:</strong> {SEASONAL_CYCLE.spring.cookingMode}</p>
          <p class="ssn__row pr__coastal"><strong>Coastal note:</strong> {SEASONAL_CYCLE.spring.coastalNote}</p>
        </li>
        <li class="ssn ssn--summer">
          <h3>Summer <span class="ssn__months">{SEASONAL_CYCLE.summer.months}</span></h3>
          <p class="ssn__row"><strong>In season:</strong> {SEASONAL_CYCLE.summer.inSeason}</p>
          <p class="ssn__row"><strong>Cooking mode:</strong> {SEASONAL_CYCLE.summer.cookingMode}</p>
          <p class="ssn__row pr__coastal"><strong>Coastal note:</strong> {SEASONAL_CYCLE.summer.coastalNote}</p>
        </li>
        <li class="ssn ssn--fall">
          <h3>Fall <span class="ssn__months">{SEASONAL_CYCLE.fall.months}</span></h3>
          <p class="ssn__row"><strong>In season:</strong> {SEASONAL_CYCLE.fall.inSeason}</p>
          <p class="ssn__row"><strong>Cooking mode:</strong> {SEASONAL_CYCLE.fall.cookingMode}</p>
          <p class="ssn__row pr__coastal"><strong>Coastal note:</strong> {SEASONAL_CYCLE.fall.coastalNote}</p>
        </li>
      </ol>
    </section>

    <section class="ways"><p class="kicker">FOUR FOODWAYS · MEDITERRANEAN · JAPANESE · MEXICAN · KOREAN</p><h2>The traditional cuisines the corridor honors.</h2>
      <ol class="fw-list">{FOUR_FOODWAYS.map((f) => (
        <li>
          <div class="fw__head">
            <h3>{f.name}</h3>
            <span class="fw__geo">{f.geography}</span>
          </div>
          <p class="fw__row"><strong>Core foods:</strong> {f.coreFoods}</p>
          <p class="fw__row"><strong>Key preparations:</strong> {f.keyPreparations}</p>
          <p class="fw__row pr__research"><strong>Research base:</strong> {f.researchBase}</p>
          <p class="fw__row pr__corridor"><strong>Corridor access:</strong> {f.corridorAccess}</p>
        </li>
      ))}</ol>
    </section>

    <section class="plate"><p class="kicker">THE PLATE · DEFAULT MEAL PROPORTIONS</p><h2>{THE_PLATE.description}</h2>
      <ol class="plate-list">{THE_PLATE.proportions.map((p) => (
        <li>
          <div class="plate__head"><span class="plate__pct">{p.portion}</span></div>
          <p class="plate__row"><strong>What:</strong> {p.what}</p>
          <p class="plate__row pr__examples"><strong>Examples:</strong> {p.examples}</p>
        </li>
      ))}</ol>
      <p class="block"><strong>Beverage:</strong> {THE_PLATE.beverage}</p>
      <p class="block"><strong>Dessert:</strong> {THE_PLATE.dessert}</p>
    </section>

    <section class="table"><p class="kicker">THE COHORT TABLE · WEEKLY PRACTICE</p><h2>The cohort sit, scaled to mealtimes.</h2>
      <p class="block"><strong>Description:</strong> {THE_COHORT_TABLE.description}</p>
      <p class="block"><strong>Format:</strong> {THE_COHORT_TABLE.format}</p>
      <h3 class="sh">Ritual elements · {THE_COHORT_TABLE.ritualElements.length}</h3>
      <ul class="dt-list">{THE_COHORT_TABLE.ritualElements.map((r) => (<li>{r}</li>))}</ul>
      <p class="block"><strong>What it does:</strong> {THE_COHORT_TABLE.whatItDoes}</p>
    </section>

    <section class="src"><p class="kicker">SOURCING · CORRIDOR-SPECIFIC</p><h2>{SOURCING.description}</h2>
      <p class="block"><strong>CSA:</strong> {SOURCING.csa}</p>
      <p class="block"><strong>Farmers markets:</strong> {SOURCING.farmersMarkets}</p>
      <p class="block"><strong>Fish:</strong> {SOURCING.fish}</p>
      <p class="block"><strong>Olive oil:</strong> {SOURCING.oliveOil}</p>
      <p class="block"><strong>Grains and legumes:</strong> {SOURCING.grainsAndLegumes}</p>
      <p class="block"><strong>Pantry:</strong> {SOURCING.pantry}</p>
      <p class="block pr__avoid"><strong>What to avoid:</strong> {SOURCING.whatToAvoid}</p>
    </section>

    <section class="proto"><p class="kicker">90-DAY FOOD PROTOCOL · ONE SHIFT PER FORTNIGHT</p><h2>{NINETY_DAY_FOOD_PROTOCOL.description}</h2>
      <ol class="fn-list">{NINETY_DAY_FOOD_PROTOCOL.fortnightShifts.map((f) => (
        <li>
          <div class="fn__head"><span class="fn__n">{f.weeks}</span><h3>Fortnight {f.fortnight}</h3></div>
          <p>{f.shift}</p>
        </li>
      ))}</ol>
    </section>

    <section class="co"><p class="kicker">COHORT OFFERINGS · {COHORT_OFFERINGS.length}</p><h2>How to eat with others.</h2>
      <ol class="co-list">{COHORT_OFFERINGS.map((c) => (
        <li>
          <h3>{c.offering}</h3>
          <p class="co__row"><strong>Format:</strong> {c.format}</p>
          <p class="co__row"><strong>Who leads:</strong> {c.whoLeads}</p>
        </li>
      ))}</ol>
    </section>

    <section class="cau"><p class="kicker">HONEST CAUTIONS · 6 AREAS</p><h2>What the federation flags loudly.</h2>
      <p class="block warn"><strong>Eating disorders:</strong> {HONEST_CAUTIONS.eatingDisorders}</p>
      <p class="block warn"><strong>Diagnosed conditions:</strong> {HONEST_CAUTIONS.diagnosedConditions}</p>
      <p class="block warn"><strong>Pregnancy:</strong> {HONEST_CAUTIONS.pregnancy}</p>
      <p class="block warn"><strong>Cost:</strong> {HONEST_CAUTIONS.cost}</p>
      <p class="block warn"><strong>Vegan / vegetarian:</strong> {HONEST_CAUTIONS.veganVegetarian}</p>
      <p class="block warn"><strong>Supplement substitution:</strong> {HONEST_CAUTIONS.supplementSubstitution}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COHORT · COOKS · FARMERS · NUTRITIONISTS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/plant">Plant · UES-WP-2026-21</a>
      <a href="/practice">Practice · UES-WP-2026-20</a>
      <a href="/living-body">Living Body · UES-WP-2026-18</a>
      <a href="/time">Time · UES-WP-2026-16</a>
      <a href="/marine-layer">Marine Layer · UES-WP-2026-01</a>
      <a href="/food.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --fd-ink:#1a1a1a; --fd-paper:#fdf9ee; --fd-mustard:#d4a534; --fd-rust:#b85a3a; --fd-sage:#2d6a3d; --fd-tide:#3d6a8a; --fd-earth:#8a6a3d; --fd-mauve:#a06478; --fd-fog:#d8d2c4; --fd-slate:#5a5450; --fd-winter:#5b8aa8; --fd-spring:#2d6a3d; --fd-summer:#d4a534; --fd-fall:#b85a3a; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--fd-paper); color: var(--fd-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--fd-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--fd-earth); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--fd-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--fd-earth); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 156px; line-height: .9; font-weight: 700; letter-spacing: -.04em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--fd-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-earth); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--fd-earth); }

  .oneliner { font-size: 19px; line-height: 1.55; font-style: italic; margin: 0 0 16px; padding: 14px 16px; background: #fff; border-left: 6px solid var(--fd-earth); max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--fd-earth); max-width: 72ch; font-family: Georgia, serif; }
  .block.warn { border-left-color: var(--fd-rust); border-left-width: 6px; background: linear-gradient(90deg, #fff5f0, #fff); }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-earth); margin-right: 6px; }
  .block.warn strong { color: var(--fd-rust); }

  /* Principles */
  .pr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .pr-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 6px solid var(--fd-earth); }
  .pr__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--fd-earth); }
  .pr__num { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--fd-earth); }
  .pr__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .pr-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Seasons */
  .ssn-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .ssn { padding: 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 10px solid var(--fd-earth); }
  .ssn--winter { border-left-color: var(--fd-winter); }
  .ssn--spring { border-left-color: var(--fd-spring); }
  .ssn--summer { border-left-color: var(--fd-summer); }
  .ssn--fall { border-left-color: var(--fd-fall); }
  .ssn h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 2px solid currentColor; }
  .ssn--winter h3 { color: var(--fd-winter); }
  .ssn--spring h3 { color: var(--fd-spring); }
  .ssn--summer h3 { color: var(--fd-summer); }
  .ssn--fall h3 { color: var(--fd-fall); }
  .ssn__months { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; padding: 3px 8px; background: currentColor; color: #fff; margin-left: 8px; }
  .ssn__row { padding: 7px 10px; background: var(--fd-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--fd-fog); }
  .ssn__row strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-earth); margin-right: 4px; }

  /* Foodways */
  .fw-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .fw-list li { padding: 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 8px solid var(--fd-earth); }
  .fw__head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 2px solid var(--fd-earth); margin-bottom: 8px; }
  .fw__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .fw__geo { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .12em; padding: 3px 8px; background: var(--fd-earth); color: #fff; }
  .fw__row { padding: 7px 10px; background: var(--fd-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--fd-fog); }
  .pr__research { border-left-color: var(--fd-sage); }
  .pr__corridor { border-left-color: var(--fd-mustard); }
  .fw-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-earth); margin-right: 4px; }

  /* Plate */
  .plate-list { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 8px; }
  .plate-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 6px solid var(--fd-sage); }
  .plate__pct { font-family: var(--pc-font-mono); font-size: 13px; font-weight: 700; color: var(--fd-sage); letter-spacing: .1em; }
  .plate__row { padding: 6px 10px; background: var(--fd-paper); margin: 6px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--fd-fog); }
  .pr__examples { border-left-color: var(--fd-mustard); }

  /* Cohort table + ritual */
  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }

  /* Sourcing */
  .pr__coastal { border-left-color: var(--fd-tide); }
  .pr__avoid { border-left-color: var(--fd-rust); }

  /* Protocol */
  .fn-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .fn-list li { padding: 10px 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 5px solid var(--fd-sage); }
  .fn__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--fd-sage); }
  .fn__n { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--fd-rust); padding: 2px 8px; background: var(--fd-paper); letter-spacing: .12em; }
  .fn__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .fn-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Cohort offerings */
  .co-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .co-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--fd-ink); border-left: 6px solid var(--fd-mauve); }
  .co-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--fd-mauve); }
  .co__row { padding: 6px 10px; background: var(--fd-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--fd-mustard); }
  .co__row strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--fd-mauve); margin-right: 4px; }

  .invitation { background: var(--fd-earth); color: var(--fd-paper); border-top-color: var(--fd-earth); }
  .invitation .kicker { background: var(--fd-mustard); color: var(--fd-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--fd-mustard); color: var(--fd-ink); border-left: 4px solid var(--fd-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .9; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 4px solid var(--fd-mustard); line-height: 1.5; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--fd-earth); color: var(--fd-paper); text-decoration: none; }
  .links a:hover { background: var(--fd-rust); }

  @media (max-width: 800px) { h1 { font-size: 110px; } .fw__head { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 520px) { h1 { font-size: 78px; } }
</style>
