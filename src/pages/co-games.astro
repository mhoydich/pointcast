---
import BlockLayout from '../layouts/BlockLayout.astro';
const description = 'You bring the spells. Your AI brings the backup. Fresh Nouns crews, four rival encounters, and spell-pair combos in a tiny co-op battle. Bring your AI or play with a practice buddy.';
---
<BlockLayout title="Co-games — Two against the rift" description={description} image="/images/co-games/rift-garden.webp" immersive={true} jsonLd={{ '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Co-games: Two against the rift', description, url: 'https://pointcast.xyz/co-games', playMode: 'CoOp', isAccessibleForFree: true }} alternates={[{type:'application/json',href:'/co-games.json',title:'Co-games rules and AI move contract'}]}>
<article class="co-games-page">
<div id="pointcast-co-games" aria-label="Two against the rift co-op game">
  <header class="cg-top">
    <a href="/" class="cg-brand" aria-label="PointCast home">PointCast<span> / CO-GAMES</span></a>
    <div class="cg-tools"><label class="cg-sr" for="cg-mode">Play with</label><select id="cg-mode" data-mode><option value="practice">Practice buddy</option><option value="native">My AI</option></select><button type="button" class="cg-tool" data-dialog="cg-settings" aria-label="Partner settings">⚙</button><button type="button" class="cg-tool cg-sound" data-sound aria-label="Mute game sounds" aria-pressed="true" title="Sound on">♪</button><button type="button" class="cg-tool" data-dialog="cg-help" aria-label="How to play">?</button></div>
  </header>
  <div class="cg-game">
    <section class="cg-stage" aria-label="Battle arena">
      <img class="cg-landscape" src="/images/co-games/rift-garden.webp" alt="" fetchpriority="high" />
      <div class="cg-vitals">
        <div class="cg-vital cg-team-vital"><div class="cg-vital-label"><span>♥ TEAM</span><strong data-health>14 / 14</strong></div><div class="cg-health" role="progressbar" aria-label="Team health" aria-valuemin="0" aria-valuemax="14" aria-valuenow="14"><div class="cg-health-fill"></div></div><span class="cg-sr" data-team-name>You + practice partner</span></div>
        <div class="cg-round-wrap"><span data-round>ROUND 1 / 4</span><span class="cg-incoming">Incoming <strong data-current-threat>4</strong> <span aria-hidden="true">↙</span></span></div>
        <div class="cg-vital cg-rift-vital"><div class="cg-vital-label"><span>✦ RIVALS</span><strong><span data-enemy>18</span><small> / <span data-enemy-max>18</span></small></strong></div><span class="cg-armor" data-armor-indicator hidden>◇ Armor <b data-current-armor>0</b></span><div class="cg-rift-track" aria-hidden="true"><div data-rift-fill></div></div></div>
      </div>
      <div class="cg-scene-title"><span>BATTLE <b data-match-number>1</b> <i>·</i> WINS <b data-wins>0</b></span><h1 data-encounter-name>Garden gang</h1><p data-encounter-tip>They get bolder every turn.</p></div><div class="cg-enemy-plan" aria-label="Rivals attack plan"><span>THEIR NEXT MOVES</span><div><b data-threat="0">3</b><b data-threat="1">4</b><b data-threat="2">5</b><b data-threat="3">6</b></div><p class="cg-sr" data-battle-intent>Incoming 3</p></div>
      <div class="cg-party"><button type="button" class="cg-actor cg-you" data-dialog="cg-roster" aria-label="Choose your Noun"><img data-noun-slot="0" src="/images/co-games/roster/dog.svg" alt="" width="320" height="320"/><span>YOU <i>↻</i></span></button><div class="cg-actor cg-buddy" aria-hidden="true"><img data-noun-slot="1" src="/images/co-games/roster/milk.svg" alt="" width="320" height="320"/><span>BUDDY</span></div></div>
      <div class="cg-party cg-rival-party" aria-hidden="true"><div class="cg-actor cg-rival-one"><img data-noun-slot="2" src="/images/co-games/roster/flower.svg" alt="" width="320" height="320"/><span data-noun-name="2">FLOWER</span></div><div class="cg-actor cg-rival-two"><img data-noun-slot="3" src="/images/co-games/roster/chameleon.svg" alt="" width="320" height="320"/><span data-noun-name="3">CHAMELEON</span></div></div><div class="cg-counter-projectile" aria-hidden="true">✧</div><div class="cg-projectile" aria-hidden="true">✦</div><span class="cg-damage cg-damage-rift" data-damage-rift aria-hidden="true"></span><span class="cg-damage cg-damage-team" data-damage-team aria-hidden="true"></span><div class="cg-rift-flash" aria-hidden="true"></div><div class="cg-combo-flash" aria-hidden="true"><strong data-combo-name></strong><span data-combo-detail></span></div>
      <div class="cg-outcome" data-outcome role="status">Beat the rival crew. Keep your team alive.</div>
    </section>
    <div class="cg-console">
      <section class="cg-partner-panel" aria-label="Your buddy's play"><img data-noun-slot="1" src="/images/co-games/roster/milk.svg" width="48" height="48" alt=""/><div class="cg-partner-copy"><div class="cg-partner-heading"><strong data-partner-name>Practice partner</strong><span class="cg-support-pill" data-partner-choice>Echo</span><span class="cg-actual-model" data-actual-model></span><span class="cg-combo-preview" data-combo-preview></span></div><p data-partner>I’ll add support when you play.</p><p class="cg-runtime-status" data-runtime-status aria-live="polite"></p></div></section>
      <div class="cg-controls" data-play>
        <div class="cg-label-row"><strong>Pick your spell</strong><span data-focus-status>Choose one card</span><button type="button" class="cg-hint" data-hint>Help me choose ↗</button></div>
        <div class="cg-hand" aria-label="Choose your spell">
          <button type="button" class="cg-card" data-card="ember" aria-pressed="true"><span class="cg-card-head"><span class="cg-card-mark" aria-hidden="true">✦</span><strong>Ember</strong><kbd>1</kbd></span><span class="cg-card-effect" data-effect="ember">Deal 4 damage.</span><span class="cg-uses" data-uses="ember">3 casts left</span></button>
          <button type="button" class="cg-card" data-card="root" aria-pressed="false"><span class="cg-card-head"><span class="cg-card-mark" aria-hidden="true">♧</span><strong>Root</strong><kbd>2</kbd></span><span class="cg-card-effect" data-effect="root">Deal 2. Block 3.</span><span class="cg-uses">Unlimited</span></button>
          <button type="button" class="cg-card" data-card="focus" aria-pressed="false"><span class="cg-card-head"><span class="cg-card-mark" aria-hidden="true">◈</span><strong>Focus</strong><kbd>3</kbd></span><span class="cg-card-effect">Next attack ×2.</span><span class="cg-uses" data-uses="focus">1 cast left</span></button>
        </div>
        <div class="cg-actions"><div class="cg-tip"><span data-quick-tip>Pick a card. Your partner adds support.</span><span class="cg-sr" data-turn-state>Pick a card · play a turn</span></div><button type="button" class="cg-cast" data-cast>Play turn</button><div class="cg-native-actions" data-native-actions hidden><button type="button" class="cg-cast" data-request>Play with AI</button><button type="button" class="cg-cancel" data-cancel hidden>Cancel</button></div></div>
      </div>
      <div class="cg-result" data-result hidden aria-live="polite"><div><span class="cg-result-mark" aria-hidden="true">✦</span><h2 data-result-title></h2><p data-result-copy></p></div><button type="button" class="cg-cast" data-replay>Play again ↻</button></div>
      <footer class="cg-footer"><span class="cg-practice-label" title="Free play"><span class="cg-simulation">SIMULATED BUDDY</span><span class="cg-real-ai">MY AI MODE</span></span><div class="cg-footer-tools"><button type="button" class="cg-text-button" data-dialog="cg-roster">Nouns ↻</button><button type="button" class="cg-text-button" data-new-battle title="Start a fresh encounter">New battle ↗</button><button type="button" class="cg-text-button" data-dialog="cg-moves">Moves ↗</button></div></footer>
    </div>
  </div>
  <dialog id="cg-help" class="cg-dialog" aria-labelledby="cg-help-title"><form method="dialog"><button class="cg-dialog-close" aria-label="Close instructions">×</button></form><span class="cg-eyebrow">A FOUR-TURN ADVENTURE</span><h2 id="cg-help-title">Two crews.<br/>One little battle.</h2><ol class="cg-how"><li><strong>Pick a spell.</strong> Ember attacks, Root protects, Focus doubles your next attack.</li><li><strong>Press Play.</strong> Your buddy adds damage, protection, or healing. The whole turn resolves together.</li><li><strong>Beat the rival crew.</strong> Each crew has its own health and attack pattern. Get them to 0 within four turns while keeping your team alive. Win to meet the next crew.</li></ol><div class="cg-combo-guide"><strong>Try a combo</strong><p>✦ Ember + Echo = <b>Fireworks</b>. Deal 2 extra damage.</p><p>♧ Root + Ward = <b>Safe haven</b>. Heal 2 as you block.</p><p>◈ Focus + Mend = <b>Second wind</b>. Heal up to 5 and charge your next attack.</p></div><p>Stuck? <strong>Help me choose</strong> selects a good spell for you. On a keyboard, use 1 / 2 / 3 to choose, then Space to play.</p><details><summary>The small print</summary><p>Healing happens first, up to 14 health. Both sides attack together. Block lasts one turn. Focus doubles your next spell’s damage, including Root, but does not double block or your buddy’s damage. If both sides fall, you lose.</p><p>Your buddy has Echo (2 damage, two uses), Ward (3 block, two uses), and Mend (3 healing, one use). The attack plan is visible above the rivals. Shell club absorbs 2 damage in its first two turns. Progress and your win count reset on reload. No prizes or purchases.</p></details><nav><a href="/spellframe">The Spellframe world ↗</a><a href="/play">More to play ↗</a><a href="https://nouns.wtf/traits" target="_blank" rel="noreferrer">Nouns artwork · CC0 ↗</a><a href="/co-games.json">Rules for agents ↗</a></nav></dialog>
  <dialog id="cg-settings" class="cg-dialog" aria-labelledby="cg-settings-title"><form method="dialog"><button class="cg-dialog-close" aria-label="Close partner settings">×</button></form><span class="cg-eyebrow">BETTER TOGETHER</span><h2 id="cg-settings-title">Bring your buddy.</h2><p>The practice buddy is simulated and ready to play. Choose <strong>My AI</strong> in the top bar to play with your connected Codex or Claude.</p><div data-native-controls hidden><label for="cg-runtime">Your connected AI</label><select id="cg-runtime" data-runtime></select><button type="button" class="cg-text-button" data-refresh>Check connection ↻</button><p>Your computer must be awake with the companion running. Each Play uses one task from your existing subscription.</p><details><summary>What your AI receives</summary><pre data-prompt-preview></pre></details></div><a class="cg-settings-link" href="/me#my-ai">Open My AI ↗</a><p class="cg-small">Only your game state and chosen spell are shared. Each click plays one turn; your AI waits for your next click.</p></dialog>
  <dialog id="cg-moves" class="cg-dialog" aria-labelledby="cg-moves-title"><form method="dialog"><button class="cg-dialog-close" aria-label="Close move history">×</button></form><span class="cg-eyebrow">YOUR SHARED ADVENTURE</span><h2 id="cg-moves-title">Our moves.</h2><p data-last>Close the rift within four rounds and keep your team alive.</p><details data-log hidden open><summary>Turn history · <span data-count>0</span></summary><ol data-log-items></ol></details><div class="cg-forecast" data-forecast></div><p data-stock></p></dialog>
  <dialog id="cg-roster" class="cg-dialog" aria-labelledby="cg-roster-title"><form method="dialog"><button class="cg-dialog-close" aria-label="Close Nouns roster">×</button></form><span class="cg-eyebrow">FRESH FACES · SAME SPELLS</span><h2 id="cg-roster-title">Pick your Noun.</h2><p>Pick a face to keep as you play, or shuffle the whole crew.</p><div class="cg-roster-grid" data-noun-roster></div><button type="button" class="cg-cast cg-shuffle" data-shuffle-nouns>Shuffle all Nouns ↻</button><p class="cg-small">These are original Nouns traits. Your choice changes your look, not your strength.</p></dialog>
  <button type="button" data-another class="cg-internals" tabindex="-1" aria-hidden="true">Try another support</button>
</div>
</article>
</BlockLayout>
<script>
import { mountCoGames } from '../lib/co-games-ui';
import { mountCoGamesAudio } from '../lib/co-games-audio';
import { mountCoGamesHud } from '../lib/co-games-hud';
let cleanup: (() => void) | undefined;
function setup() {
  cleanup?.();
  const root = document.getElementById('pointcast-co-games');
  if (!root) return;
  const stopAudio = mountCoGamesAudio(root);
  const stopHud = mountCoGamesHud(root);
  const stopGame = mountCoGames(root);
  cleanup = () => { stopAudio(); stopHud(); stopGame(); };
}
setup();
document.addEventListener('astro:page-load', setup);
document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>
<style is:global>
body:has(.co-games-page){margin:0;background:#101e22!important;color:#fbf5df;overflow:hidden}
body:has(.co-games-page) main{padding:0!important;margin:0!important;max-width:none!important}
.co-games-page{height:100vh;height:100dvh;margin:0 auto;padding:14px 24px;max-width:1500px;box-sizing:border-box}
#pointcast-co-games{--cg-cream:#fff5dc;--cg-lime:#d9f798;--cg-muted:#b1c1be;--cg-line:#40534f;--cg-panel:#1c302f;height:100%;display:flex;flex-direction:column;font:14px/1.4 Arial,Helvetica,sans-serif;color:var(--cg-cream);isolation:isolate;color-scheme:dark}
#pointcast-co-games *{box-sizing:border-box}
#pointcast-co-games [hidden],#pointcast-co-games .cg-internals{display:none!important}
#pointcast-co-games button,#pointcast-co-games select{font:inherit}
#pointcast-co-games button{cursor:pointer}
#pointcast-co-games button:disabled{cursor:default;opacity:.42}
#pointcast-co-games button:focus-visible,#pointcast-co-games select:focus-visible,#pointcast-co-games a:focus-visible{outline:3px solid #ffd891;outline-offset:3px}
#pointcast-co-games p{margin:0}
#pointcast-co-games .cg-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex:none;height:48px;margin-bottom:10px}
#pointcast-co-games .cg-brand{font-size:23px;font-weight:800;letter-spacing:-1px;text-decoration:none;color:var(--cg-cream);white-space:nowrap}
#pointcast-co-games .cg-brand span{font:10px ui-monospace,monospace;letter-spacing:1.5px;color:var(--cg-muted);margin-left:15px}
#pointcast-co-games .cg-tools{display:flex;align-items:center;gap:8px}
#pointcast-co-games .cg-tool,#pointcast-co-games select{color:var(--cg-cream);background:#20312f;border:1px solid #4e6159;border-radius:8px;min-height:44px;padding:0 12px}
#pointcast-co-games .cg-sound[aria-pressed=false]{opacity:.55;text-decoration:line-through}
#pointcast-co-games .cg-tool{width:44px;padding:0}
#pointcast-co-games .cg-tool:last-child{width:44px;padding:0;font-size:18px}
#pointcast-co-games .cg-game{display:flex;flex-direction:column;min-height:0;flex:1;border:1px solid #4f6457;border-radius:16px;overflow:hidden;box-shadow:0 12px 50px #0003}
#pointcast-co-games .cg-stage{position:relative;flex:1;min-height:180px;background:#badbc6;overflow:hidden;isolation:isolate}
#pointcast-co-games .cg-landscape{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%;image-rendering:pixelated;z-index:-2}
#pointcast-co-games .cg-stage:after{content:'';position:absolute;inset:0;background:linear-gradient(#163e2922,transparent 38%,#0d242840);z-index:-1;pointer-events:none}
#pointcast-co-games .cg-vitals{display:grid;grid-template-columns:minmax(130px,230px) auto minmax(130px,230px);align-items:start;justify-content:space-between;gap:18px;padding:20px;position:relative;z-index:4}
#pointcast-co-games .cg-vital{background:#172f2ded;border:1px solid #e9f2c950;border-radius:9px;padding:10px 12px;box-shadow:0 4px 0 #172f2d30}
#pointcast-co-games .cg-vital-label{display:flex;align-items:center;justify-content:space-between;gap:16px;font:11px ui-monospace,monospace;letter-spacing:1px}
#pointcast-co-games .cg-vital strong{font:700 17px Arial,sans-serif;letter-spacing:0;white-space:nowrap}
#pointcast-co-games .cg-vital small{font-size:12px;font-weight:400;color:#c0cdc0}
#pointcast-co-games .cg-health,#pointcast-co-games .cg-rift-track{height:7px;border-radius:2px;background:#ffffff24;margin-top:8px;overflow:hidden}
#pointcast-co-games .cg-health-fill{height:100%;width:100%;background:#d9f798;transition:width .45s ease}
#pointcast-co-games [data-rift-fill]{height:100%;width:100%;background:#f8a4ca;transition:width .45s ease}
#pointcast-co-games .cg-round-wrap{display:flex;flex-direction:column;align-items:center;gap:5px;padding-top:6px;color:#203b37;font:700 11px ui-monospace,monospace;text-shadow:0 1px #fff8}
#pointcast-co-games .cg-incoming{background:#fff4ddea;padding:6px 10px;border-radius:6px;font:12px Arial,sans-serif;white-space:nowrap;box-shadow:0 3px 0 #203c2920}
#pointcast-co-games .cg-incoming strong{font-size:16px;margin-left:3px}
#pointcast-co-games .cg-scene-title{position:absolute;left:4%;top:24%;color:#1d4444;text-shadow:0 2px #ffefc8aa}
#pointcast-co-games .cg-scene-title>span{font:10px ui-monospace,monospace;letter-spacing:2px}
#pointcast-co-games h1{font-size:clamp(24px,3vw,46px);line-height:.96;letter-spacing:-2.5px;margin:10px 0;font-weight:850}
#pointcast-co-games .cg-party{position:absolute;bottom:12%;left:29%;display:flex;align-items:end;gap:8px;width:18%;max-width:230px;min-width:128px;transform:translateX(-50%)}
#pointcast-co-games .cg-rival-party{left:76%}
#pointcast-co-games .cg-rival-party .cg-actor span{background:#513c54e8;color:#ffd5e4}
#pointcast-co-games .cg-actor{width:50%;position:relative;text-align:center;filter:drop-shadow(0 6px 0 #092f3f45)}
#pointcast-co-games .cg-actor img{width:100%;height:auto;display:block;image-rendering:pixelated}
#pointcast-co-games .cg-actor span{font:700 10px ui-monospace,monospace;letter-spacing:2px;background:#153535e8;color:#e3fac3;padding:5px 10px;border-radius:4px;display:inline-block}
#pointcast-co-games .cg-outcome{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);padding:8px 16px;max-width:95%;width:max-content;text-align:center;background:#123332e8;color:#fff5dc;border:1px solid #edfac54a;border-radius:7px;font-size:12px;box-shadow:0 3px 0 #0d252740}
#pointcast-co-games .cg-console{background:#192c2c;flex:none;position:relative;padding:14px 22px 0}
#pointcast-co-games .cg-partner-panel{display:flex;align-items:center;gap:12px;min-height:64px;padding-bottom:10px;border-bottom:1px solid var(--cg-line)}
#pointcast-co-games .cg-partner-panel>img{background:#305252;border-radius:8px;image-rendering:pixelated;flex:none}
#pointcast-co-games .cg-partner-copy{min-width:0;flex:1}
#pointcast-co-games .cg-partner-heading{display:flex;align-items:center;gap:9px;line-height:18px;margin-bottom:4px}
#pointcast-co-games .cg-partner-heading strong{font-size:12px;color:#d9f798}
#pointcast-co-games .cg-actual-model{font:9px ui-monospace,monospace;color:#bfcfb9;overflow-wrap:anywhere}
#pointcast-co-games .cg-support-pill{font:10px ui-monospace,monospace;background:#ffffff13;padding:2px 6px;border-radius:3px;color:#dfe9d5}
#pointcast-co-games [data-partner]{font-size:13px;line-height:18px;max-height:54px;overflow:auto;overflow-wrap:anywhere;scrollbar-width:thin}
#pointcast-co-games .cg-runtime-status{font-size:11px;line-height:15px;color:#c9d7c6;margin-top:2px;max-height:45px;overflow:auto}
#pointcast-co-games .cg-runtime-status:empty{display:none}
#pointcast-co-games .cg-label-row{display:flex;align-items:center;gap:15px;height:38px;font-size:12px}
#pointcast-co-games .cg-label-row>span{font-size:11px;color:var(--cg-muted)}
#pointcast-co-games .cg-hint{margin-left:auto;border:0;color:#d9f798;background:none;min-height:36px;padding:4px;font-size:12px}
#pointcast-co-games .cg-hand{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
#pointcast-co-games .cg-card{--spell:#f7b778;position:relative;display:flex;flex-direction:column;gap:5px;align-items:stretch;text-align:left;min-width:0;height:101px;padding:11px 14px;background:#263b39;color:#fff5dc;border:2px solid #425a50;border-radius:9px;transition:background .12s,border-color .12s,transform .12s}
#pointcast-co-games .cg-card[data-card=root]{--spell:#c2ea91}
#pointcast-co-games .cg-card[data-card=focus]{--spell:#dac5ff}
#pointcast-co-games .cg-card:hover:not(:disabled){background:#344e43;border-color:var(--spell)}
#pointcast-co-games .cg-card[aria-pressed=true],#pointcast-co-games .cg-card[aria-pressed=true]:hover{background:#ecf6d5;color:#20372d;border-color:#d9f798;box-shadow:0 0 0 2px #d9f79820}
#pointcast-co-games .cg-card-head{display:flex;align-items:center;gap:8px;font-size:16px;line-height:20px}
#pointcast-co-games .cg-card-mark{font-size:23px;color:var(--spell)}
#pointcast-co-games .cg-card[aria-pressed=true] .cg-card-mark{color:#58713d}
#pointcast-co-games kbd{margin-left:auto;font:10px ui-monospace,monospace;opacity:.55;border:1px solid currentColor;border-radius:3px;padding:0 4px}
#pointcast-co-games .cg-card-effect{font-size:12px;line-height:16px}
#pointcast-co-games .cg-uses{font:10px/14px ui-monospace,monospace;opacity:.7;margin-top:auto}
#pointcast-co-games .cg-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:70px}
#pointcast-co-games .cg-tip{font-size:12px;color:#c4d1c6;max-width:65%;line-height:17px}
#pointcast-co-games .cg-cast{min-height:46px;min-width:200px;border:1px solid #d9f798;background:#d9f798;color:#223b2f;border-radius:8px;font-size:15px;font-weight:750;padding:10px 24px;box-shadow:0 3px 0 #657d50}
#pointcast-co-games .cg-cast:hover:not(:disabled){background:#edffce;transform:translateY(-1px)}
#pointcast-co-games .cg-native-actions{display:flex;align-items:center;gap:10px}
#pointcast-co-games .cg-cancel{color:#f4dbbd;background:none;border:1px solid #637463;border-radius:6px;min-height:44px;padding:6px 12px}
#pointcast-co-games .cg-footer{display:flex;justify-content:space-between;align-items:center;height:31px;border-top:1px solid var(--cg-line)}
#pointcast-co-games .cg-practice-label{font:9px ui-monospace,monospace;letter-spacing:1.2px;color:#a3b6ac}
#pointcast-co-games .cg-practice-label i{font-style:normal;margin:0 8px}
#pointcast-co-games .cg-real-ai,#pointcast-co-games[data-mode=native] .cg-simulation{display:none}
#pointcast-co-games[data-mode=native] .cg-real-ai{display:inline}
#pointcast-co-games .cg-text-button{border:0;background:none;color:#d7e9ce;text-decoration:underline;text-underline-offset:3px;font-size:11px;min-height:30px;padding:5px 0}
#pointcast-co-games .cg-result{height:209px;display:flex;align-items:center;justify-content:space-between;gap:20px}
#pointcast-co-games .cg-result h2{font-size:32px;line-height:1.1;letter-spacing:-1px;margin:4px 0 10px}
#pointcast-co-games .cg-result p{font-size:14px;color:#c0d1c0}
