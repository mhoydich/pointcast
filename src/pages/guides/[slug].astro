---
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/guides.css';
import { CATEGORIES, GUIDES, assignmentsForGuide, guideBySlug } from '../../data/guides';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }));
}

const guide = guideBySlug(String(Astro.params.slug))!;
const category = CATEGORIES.find((c) => c.id === guide.category)!;
const assignments = assignmentsForGuide(guide.slug);
const siblings = GUIDES.filter((g) => g.category === guide.category && g.slug !== guide.slug);
const url = `https://pointcast.xyz/guides/${guide.slug}`;
---

<BlockLayout
  title={`${guide.title} — PointCast Guides`}
  description={guide.dek}
  author="PointCast Guides"
  alternates={[{ type: 'application/json', href: `/guides/${guide.slug}.json`, title: guide.title }]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: guide.title,
    description: guide.dek,
    url,
    totalTime: `PT${guide.minutes}M`,
    step: guide.checklist.map((c) => ({ '@type': 'HowToStep', name: c.label, text: c.detail })),
  }}
>
  <div class="gd">
    <div class="gd-wrap">
      <header class="gd-mast">
        <a class="logo" href="/guides">PointCast <b>Guides</b></a>
        <nav>
          <a href={`/guides#${category.id}`}>{category.label}</a>
          <a href="/guides#participate">Participate</a>
          <a href="/guides#interns">Intern assignments</a>
          <a href={`/guides/${guide.slug}.json`}>JSON</a>
        </nav>
      </header>

      <p class="gd-kicker">{category.label} · {guide.minutes} min read</p>
      <h1>{guide.title}</h1>
      <p class="lede">{guide.dek}</p>
      <p class="gd-meta">For {guide.audience}.</p>

      <div class="gd-article">
        <div>
          {guide.sections.map((s) => (
            <section>
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))}

          <h2>Checklist</h2>
          <ul class="gd-check">
            {guide.checklist.map((c) => <li><strong>{c.label}.</strong> {c.detail}</li>)}
          </ul>

          <section id="from-contributors" data-guide={guide.slug}>
            <h2>From contributors</h2>
            <p class="gd-meta" data-gi-status>Loading reviewed material.</p>
            <div class="gi-list" data-gi-list></div>
            <p><a href={`/guides/intake?guide=${guide.slug}`}>Send material for this guide</a>. Every item is read by a human, who writes back.</p>
          </section>
        </div>

        <aside class="gd-side">
          <div class="gd-card">
            <h3>Guide seat: {guide.seat.replace('-', ' ')}</h3>
            <p>This topic does not have a human Guide yet. Send a month of useful corrections and additions and the seat can be yours.</p>
            <p><a href="/guides#participate">How the seat works</a></p>
          </div>
          <div class="gd-card">
            <h3>Wanted from contributors</h3>
            <ul class="tight">{guide.wanted.map((w) => <li>{w}</li>)}</ul>
          </div>
          {assignments.length > 0 && (
            <div class="gd-card">
              <h3>Intern assignments</h3>
              <ul class="tight">
                {assignments.map((a) => <li><a href={`/guides#${a.id}`}>{a.id}</a> {a.title}</li>)}
              </ul>
            </div>
          )}
          <div class="gd-card">
            <h3>Related</h3>
            <ul class="tight">{guide.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
          </div>
          {siblings.length > 0 && (
            <div class="gd-card">
              <h3>More in {category.label}</h3>
              <ul class="tight">{siblings.map((g) => <li><a href={`/guides/${g.slug}`}>{g.title}</a></li>)}</ul>
            </div>
          )}
        </aside>
      </div>

      <footer class="gd-foot">
        Drafted with AI collaborators (Claude) as a starting point for a human Guide. It describes practices, not
        facts about specific people, clubs or venues; check local rules where they apply. Tags: {guide.tags.join(', ')}.
      </footer>
    </div>
  </div>
</BlockLayout>

<style is:global>
  .gi-list { display: grid; gap: 12px; margin: 12px 0; }
  .gi-item { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--green); border-radius: 8px; padding: 12px 14px; }
  .gi-item h3 { margin: 0 0 4px; }
  .gi-item .gi-body { white-space: pre-line; margin: 6px 0; max-width: 68ch; }
  .gi-item .gi-note { font-size: .88rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 6px; margin: 8px 0 0; }
  .gi-item ul { margin: 4px 0; padding-left: 1.2em; font-size: .88rem; overflow-wrap: anywhere; }
</style>

<script>
  // Accepted intake material for this guide (pending and declined items are never public).
  function el(tag: string, cls?: string | null, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text) n.textContent = text;
    return n;
  }
  function render() {
    const root = document.getElementById('from-contributors');
    if (!root) return;
    const slug = root.dataset.guide ?? '';
    const status = root.querySelector('[data-gi-status]') as HTMLElement;
    const list = root.querySelector('[data-gi-list]') as HTMLElement;
    fetch(`/api/guides/intake?guide=${encodeURIComponent(slug)}`)
      .then((r) => r.json())
      .then((data) => {
        if (!data?.ok) throw new Error('unavailable');
        const counts = data.counts?.byGuide?.[slug] ?? { accepted: 0, pending: 0 };
        const items = data.accepted ?? [];
        status.textContent = items.length
          ? `${items.length} accepted${counts.pending ? ` · ${counts.pending} waiting for review` : ''}.`
          : counts.pending
            ? `Nothing accepted yet · ${counts.pending} waiting for review.`
            : 'Nothing accepted yet. Be the first to send something useful.';
        list.textContent = '';
        for (const it of items) {
          const card = el('article', 'gi-item');
          card.append(el('h3', null, it.title));
          const who = it.contributor ? `${it.contributor.name} (${it.contributor.kind})` : 'contributor';
          const reviewed = it.updatedAt ? ` · reviewed ${String(it.updatedAt).slice(0, 10)}` : '';
          card.append(el('p', 'gd-meta', `${it.kind}${it.assignment ? ` · ${it.assignment}` : ''} · from ${who}${reviewed}`));
          card.append(el('p', 'gi-body', it.body));
          const urls = (it.sourceUrls ?? []).filter((u: string) => /^https:\/\//.test(u));
          if (urls.length) {
            const ul = el('ul');
            for (const u of urls) {
              const li = el('li');
              const a = el('a', null, u) as HTMLAnchorElement;
              a.href = u; a.rel = 'nofollow noopener'; a.target = '_blank';
              li.append(a); ul.append(li);
            }
            card.append(ul);
          }
          const note = it.feedback?.[it.feedback.length - 1]?.note;
          if (note) card.append(el('p', 'gi-note', `Reviewer: ${note}`));
          list.append(card);
        }
      })
      .catch(() => { status.textContent = 'Contributor material is unavailable right now.'; });
  }
  render();
</script>
