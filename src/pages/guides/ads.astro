---
/**
 * /guides/ads — a whimsical print campaign for PointCast Guides.
 * Hoydich Advertising, El Segundo, California, 2026.
 *
 * Art: owner-published Midjourney squares (art-v2 source set, July 18 2026),
 * CC0 Nouns rendered from the official trait data, and square-grid
 * illustration drawn in markup. Every ad is a 4:5 magazine page and prints
 * one per sheet.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import GuidesMapArt from '../../components/GuidesMapArt.astro';
import { renderSeed, NOUNS_ART } from '../../lib/nouns-parts.mjs';
import { GUIDES, INTERN_ASSIGNMENTS, THEN_AND_NOW } from '../../data/guides';

type Seed = { body: number; accessory: number; head: number; glasses: number; background?: number };

/** A CC0 Noun as inline SVG, optionally without its background square. */
function noun(seed: Seed, transparent = false) {
  let svg = renderSeed({ background: 0, ...seed }).svg.replace('width="320" height="320"', 'width="100%" height="100%"');
  if (transparent) svg = svg.replace(/<rect width="100%" height="100%" fill="#[0-9a-f]+" \/>/i, '');
  return svg;
}

const mj = (n: number) => `/images/art-v2/source/MJ-JUL18-${String(n).padStart(2, '0')}-900.webp`;

// Heads from the official image data: 152 pickle, 7 baseball, 8 basketball,
// 218 volleyball, 107 house, 248 satellite, 177 robot, 225 wave, 201 sunset,
// 149 pencil tip, 63 crown, 161 plane, 229 whale, 65 crystal ball, 53 coffee bean.
const crowd: Seed[] = [
  { body: 18, accessory: 128, head: 152, glasses: 13 },
  { body: 5, accessory: 73, head: 107, glasses: 1 },
  { body: 19, accessory: 41, head: 8, glasses: 7 },
  { body: 2, accessory: 95, head: 218, glasses: 13 },
  { body: 11, accessory: 23, head: 225, glasses: 19 },
  { body: 22, accessory: 12, head: 7, glasses: 4 },
  { body: 9, accessory: 77, head: 177, glasses: 13 },
  { body: 14, accessory: 53, head: 201, glasses: 2 },
  { body: 25, accessory: 60, head: 149, glasses: 9 },
  { body: 3, accessory: 30, head: 248, glasses: 13 },
  { body: 16, accessory: 88, head: 229, glasses: 19 },
];

const pickleNoun = noun({ body: 18, accessory: 128, head: 152, glasses: 13 }, true);
const robotNoun = noun({ body: 5, accessory: 77, head: 177, glasses: 13 }, true);
const crownNoun = noun({ body: 19, accessory: 41, head: 63, glasses: 19 }, true);
const satelliteNoun = noun({ body: 5, accessory: 53, head: 248, glasses: 13 }, true);
const houseNoun = noun({ body: 11, accessory: 73, head: 107, glasses: 1 }, true);
const ballNouns = [
  noun({ body: 19, accessory: 41, head: 8, glasses: 7 }, true),
  noun({ body: 2, accessory: 95, head: 218, glasses: 13 }, true),
  noun({ body: 22, accessory: 12, head: 7, glasses: 4 }, true),
];
const runNoun = noun({ body: 14, accessory: 23, head: 201, glasses: 13 }, true);

// Orange-slice season: 12 weeks × 1 family each.
const weeks = Array.from({ length: 12 }, (_, i) => ({ week: i + 1, filled: [0, 1, 2, 4, 5, 7, 8].includes(i) }));
// Game-day tally: 9 players, each mentioned at least once across a season of 10 recaps.
const tally = Array.from({ length: 9 }, (_, p) =>
  Array.from({ length: 10 }, (_, g) => (g * 4 + p * 7) % 9 === p % 3 || g === p % 10),
);
const trackColor: Record<string, string> = {
  reporting: '#ff6f3c',
  'guide-writing': '#2a6fdb',
  data: '#16a36b',
  design: '#ff8fc7',
  community: '#d8b400',
  'agent-ops': '#7a4cff',
};
const classifieds = GUIDES.map((g) => ({ title: g.title, wanted: g.wanted[0], slug: g.slug }));

const title = 'PointCast Guides — the print campaign';
const description =
  'Thirteen whimsical print ads for PointCast Guides, About.com rebuilt for 2028. Hoydich Advertising, El Segundo, California, 2026.';
---

<BlockLayout title={title} description={description} author="Hoydich Advertising" image={mj(13)}
  imageAlt="Pastel grid of colored squares over breaking surf, Midjourney artwork from July 18, 2026">
  <div class="cx">
    <header class="cx-head">
      <p class="cx-k">Hoydich Advertising · El Segundo, California · 2026</p>
      <h1>PointCast Guides<br /><em>the print campaign</em></h1>
      <p class="cx-lede">
        Thirteen magazine pages for <a href="/guides">PointCast Guides</a>, About.com rebuilt for 2028. Squares
        everywhere: Midjourney squares, Nouns squares, city-block squares, orange-slice squares. Each page prints on
        its own sheet.
      </p>
      <button class="cx-print" type="button" onclick="window.print()">Print the campaign</button>
    </header>

    <div class="cx-wall">

      <!-- 01 ABOUT TIME -->
      <figure class="ad ad-about" id="ad-01">
        <img class="bg" src={mj(13)} alt="" loading="lazy" />
        <div class="ad-in">
          <h2 class="hl">About<br />time.</h2>
          <div class="crowd">
            {crowd.map((s) => <div class="sq" set:html={noun(s)} />)}
            <a class="sq seat" href="/guides#participate"><span>your<br />seat</span></a>
          </div>
          <p class="copy">About.com put one human in charge of every topic. We kept the human and shrank the topic to your street, your team, your Tuesday.</p>
          <p class="sig"><b>PointCast Guides</b> pointcast.xyz/guides</p>
        </div>
        <figcaption>01 · Image: MJ-JUL18-13 “Pastel grid warming in the afternoon” · 11 CC0 Nouns and one empty chair</figcaption>
      </figure>

      <!-- 02 MAP -->
      <figure class="ad ad-map" id="ad-02">
        <div class="ad-in">
          <h2 class="hl">Every block<br />needs a Guide.</h2>
          <div class="map"><GuidesMapArt /></div>
          <p class="copy">Twelve guides for the neighborhood, the pickleball team, the rec league and the run club. The seats are open. The blocks are waiting.</p>
          <p class="sig"><b>PointCast Guides</b> pointcast.xyz/guides</p>
        </div>
        <figcaption>02 · Stylized square map of El Segundo, not to scale</figcaption>
      </figure>

      <!-- 03 PICKLEBALL -->
      <figure class="ad ad-pickle" id="ad-03">
        <div class="court" aria-hidden="true">
          <div class="half"></div><div class="kitchen"></div><div class="net"></div><div class="kitchen"></div><div class="half"></div>
        </div>
        <div class="ad-in">
          <h2 class="hl">Stay out<br />of the kitchen.<br /><span>Read the guide<br />in it instead.</span></h2>
          <div class="pickle" set:html={pickleNoun} />
          <p class="copy">Start a team. Run ladder night without a spreadsheet meltdown. Keep a team page people actually check. Three pickleball guides, zero lectures about your third shot.</p>
          <p class="sig"><b>PointCast Guides · Pickleball</b> pointcast.xyz/guides/start-a-pickleball-team</p>
        </div>
        <figcaption>03 · CC0 Noun, head: pickle · court drawn in squares</figcaption>
      </figure>

      <!-- 04 ORANGE SLICES -->
      <figure class="ad ad-orange" id="ad-04">
        <div class="ad-in">
          <h2 class="hl">Orange slices<br />are a logistics<br />problem.</h2>
          <div class="slices">
            {weeks.map((w) => (
              <div class:list={['slice', { on: w.filled }]}><b>W{w.week}</b><span>{w.filled ? 'covered' : 'open'}</span></div>
            ))}
          </div>
          <p class="copy">The youth team parent’s guide: snack and volunteer rotations, one group thread instead of six, and first names only for the kids. Week 4 still needs a family.</p>
          <p class="sig"><b>PointCast Guides · Sports</b> pointcast.xyz/guides/youth-team-parent-guide</p>
        </div>
        <figcaption>04 · A twelve-square snack season</figcaption>
      </figure>

      <!-- 05 CLASSIFIEDS -->
      <figure class="ad ad-class" id="ad-05">
        <div class="ad-in">
          <p class="mast">THE POINTCAST GUIDES <span>CLASSIFIED</span></p>
          <h2 class="hl">WANTED:<br />one human per topic.</h2>
          <div class="cols">
            {classifieds.map((c) => (
              <p><b>SEAT OPEN — {c.title.toUpperCase()}.</b> Patient local sought to own one guide. Start by sending: {c.wanted.charAt(0).toLowerCase() + c.wanted.slice(1).replace(/\.$/, '')}. Credit given. /guides/{c.slug}</p>
            ))}
            <p><b>FOLDING TABLES.</b> Not provided. See block party guide.</p>
            <p><b>LOST:</b> one whistle, last seen at youth practice. Not our department, but the parent guide has a rotation for that.</p>
          </div>
          <p class="sig"><b>Apply by doing the work.</b> pointcast.xyz/guides#participate</p>
        </div>
        <figcaption>05 · Newspaper classifieds, generated from the live guide list</figcaption>
      </figure>

      <!-- 06 SUNSET -->
      <figure class="ad ad-sunset" id="ad-06">
        <img class="bg" src={mj(31)} alt="" loading="lazy" />
        <div class="ad-in">
          <h2 class="hl">The sunset is<br />not a guide.</h2>
          <p class="aside">(We checked.)</p>
          <p class="copy">But there are twelve guides for everything that happens before it: practice, the group thread, the block party, the recap.</p>
          <p class="sig"><b>PointCast Guides</b> pointcast.xyz/guides</p>
        </div>
        <figcaption>06 · Image: MJ-JUL18-31 “Orange sun and stacked clouds over breaking surf, riso print”</figcaption>
      </figure>

      <!-- 07 1997 -->
      <figure class="ad ad-1997" id="ad-07">
        <div class="ad-in">
          <h2 class="hl">1997 called.<br /><span>We let it go to voicemail.</span></h2>
          <div class="split">
            <div class="old">
              <div class="win"><i></i><i></i><i></i> portal.htm</div>
              <ul>{THEN_AND_NOW.slice(1).map((r) => <li>{r.then}</li>)}</ul>
            </div>
            <div class="new">
              <div class="pix" aria-hidden="true">{Array.from({ length: 36 }, (_, i) => <i style={`--h:${(i * 47) % 360}`}></i>)}</div>
              <ul>{THEN_AND_NOW.slice(1).map((r) => <li>{r.now}</li>)}</ul>
            </div>
          </div>
          <p class="copy">Same big idea. Smaller topics. Better neighbors.</p>
          <p class="sig"><b>PointCast Guides, 2028</b> pointcast.xyz/guides</p>
        </div>
        <figcaption>07 · Then and now, a split page</figcaption>
      </figure>

      <!-- 08 AGENTS FILE -->
      <figure class="ad ad-agents" id="ad-08">
        <img class="bg" src={mj(26)} alt="" loading="lazy" />
        <div class="ad-in">
          <h2 class="hl">Agents file.<br />Humans decide.</h2>
          <div class="desk">
            <div class="who"><div class="n" set:html={robotNoun} /><p>Formats. Checks links. Drafts the recap from the stat sheet.</p></div>
            <div class="cabinet" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <i class:list={[{ out: i === 5 }]}></i>)}</div>
            <div class="who"><div class="n" set:html={crownNoun} /><p>Reads it. Fixes it. Decides. Talks to people.</p></div>
          </div>
          <p class="copy">Every guide has a JSON twin for the bots and a human name for the buck to stop at. Agents never publish, never contact anyone and never get a seat.</p>
          <p class="sig"><b>PointCast Guides</b> pointcast.xyz/guides.json</p>
        </div>
        <figcaption>08 · Image: MJ-JUL18-26 “Klein-blue night sea, nothing else awake” · CC0 Nouns, heads: robot and crown</figcaption>
      </figure>

      <!-- 09 SCOREBOARD -->
      <figure class="ad ad-score" id="ad-09">
        <div class="ad-in">
          <div class="board">
            <span>HOME</span><b>everyone</b><span>GUEST</span><b>played</b>
          </div>
          <h2 class="hl">Final score:<br />everyone played.</h2>
          <div class="tally" aria-hidden="true">
            {tally.map((row, p) => (
              <div class="row"><em>#{p + 1}</em>{row.map((on) => <i class:list={[{ on }]}></i>)}</div>
            ))}
          </div>
          <p class="copy">The game-day reporting guide: a five-sentence recap, stats your team will actually use, and a season where every player gets named at least once. No shaming. No essays about the ref.</p>
          <div class="balls">{ballNouns.map((b) => <div set:html={b} />)}</div>
          <p class="sig"><b>PointCast Guides · Sports</b> pointcast.xyz/guides/game-day-reporting</p>
        </div>
        <figcaption>09 · Nine players × ten recaps, one square per mention · CC0 Nouns, heads: basketball, volleyball, baseball</figcaption>
      </figure>

      <!-- 10 INTERNS -->
      <figure class="ad ad-interns" id="ad-10">
        <div class="ad-in">
          <h2 class="hl">Twelve<br />assignments.<br /><span>Zero coffee runs.</span></h2>
          <div class="peg">
            {INTERN_ASSIGNMENTS.map((a) => (
              <a href={`/guides#${a.id}`} style={`--c:${trackColor[a.track] ?? '#333'}`}><b>{a.id}</b><span>{a.title}</span></a>
            ))}
          </div>
          <p class="copy">Interview a captain, map the newcomer’s town, design a court-board card, teach an agent to draft a recap. Each assignment ends in something shipped.</p>
          <p class="fine">Educational project briefs. Applications are not open; pay, hours and hiring entity are not set.</p>
          <p class="sig"><b>PointCast Guides · Intern desk</b> pointcast.xyz/guides#interns</p>
        </div>
        <figcaption>10 · Pegboard of the twelve live assignments, colored by track</figcaption>
      </figure>

      <!-- 11 SATELLITES -->
      <figure class="ad ad-sat" id="ad-11">
        <img class="bg" src={mj(48)} alt="" loading="lazy" />
        <div class="ad-in">
          <p class="kick">El Segundo, California</p>
          <h2 class="hl">Built where<br />satellites<br />are born.</h2>
          <div class="sat" set:html={satelliteNoun} />
          <p class="copy">A town that is good at precise things is starting a guide to the small things: who brings the cones, where the newsletter lives, how the ladder works.</p>
          <p class="sig"><b>PointCast Guides</b> pointcast.xyz/guides</p>
        </div>
        <figcaption>11 · Image: MJ-JUL18-48 “Sea stack wrapped in evening color squares” · CC0 Noun, head: satellite</figcaption>
      </figure>

      <!-- 12 NEW IN TOWN -->
      <figure class="ad ad-new" id="ad-12">
        <img class="bg" src={mj(50)} alt="" loading="lazy" />
        <div class="ad-in">
          <h2 class="hl">New in town?<br /><span>So is this.</span></h2>
          <div class="house" set:html={houseNoun} />
          <p class="copy">A template for the newcomer’s map: parks, transit, libraries, civic meetings, the good bulletin boards. Written by a neighbor, checked by a Guide, never guessed.</p>
          <p class="sig"><b>PointCast Guides · Local</b> pointcast.xyz/guides/new-in-town</p>
        </div>
        <figcaption>12 · Image: MJ-JUL18-50 “Round house in a patchwork of village walls” · CC0 Noun, head: house</figcaption>
      </figure>

      <!-- 13 RUN CLUB -->
      <figure class="ad ad-run" id="ad-13">
        <img class="bg" src={mj(33)} alt="" loading="lazy" />
        <div class="ad-in">
          <h2 class="hl">Run club<br />meets at six.<br /><span>The guide meets you whenever.</span></h2>
          <div class="pace" aria-hidden="true">{Array.from({ length: 8 }, (_, i) => <i style={`--d:${i}`}></i>)}</div>
          <div class="runner" set:html={runNoun} />
          <p class="copy">Beach volleyball, run clubs, surf meetups: meeting points, heat days and a pace that waits for the last square.</p>
          <p class="sig"><b>PointCast Guides · Sports</b> pointcast.xyz/guides/beach-and-run-clubs</p>
        </div>
        <figcaption>13 · Image: MJ-JUL18-33 “Neon arch sunrise between palm silhouettes” · CC0 Noun, head: sunset</figcaption>
      </figure>
    </div>

    <footer class="cx-colophon">
      <h2>Colophon</h2>
      <p><b>Agency:</b> Hoydich Advertising, El Segundo, California, 2026. Every ad is an invitation.</p>
      <p><b>Concept, copy and layout:</b> Claude Opus 5.5 (Anthropic), working in Claude Code for Hoydich Advertising. Not written in Mike Hoydich’s voice.</p>
      <p><b>Photographic art:</b> Mike Hoydich’s Midjourney session of July 18, 2026, from the owner-published <a href="/art/v2">art-v2</a> source set. Commercial rights review for these images is still pending, so these are house ads for PointCast only.</p>
      <p><b>Characters:</b> Nouns rendered from the official CC0 trait data ({NOUNS_ART.credit}). Combinations are ours and are not numbered on-chain Nouns.</p>
      <p><b>Map:</b> stylized and not to scale. No business, park or venue is named.</p>
      <p><b>Status:</b> proposed campaign. No placements bought, no tracking, no sign-ups on this page.</p>
      <p><a href="/guides">Back to PointCast Guides</a></p>
    </footer>
  </div>
</BlockLayout>

<style>
  .cx { --ink:#121417; --paper:#efe9dc; background:var(--paper); color:var(--ink); font-family:'Inter Variable',system-ui,sans-serif; padding:28px 16px 64px; }
  .cx a { color:inherit; }
  .cx-head, .cx-colophon { max-width:1100px; margin:0 auto; }
  .cx-k { font-family:'JetBrains Mono Variable',monospace; font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:#b4441c; }
  .cx-head h1 { font-size:clamp(2.2rem,6vw,4.4rem); line-height:.95; letter-spacing:-.04em; margin:.2em 0 .3em; }
  .cx-head h1 em { font-family:Georgia,'Times New Roman',serif; font-weight:400; }
  .cx-lede { max-width:60ch; font-size:1.08rem; }
  .cx-print { font:inherit; font-weight:700; border:2px solid var(--ink); background:#d8ff4f; padding:8px 14px; cursor:pointer; margin-top:6px; }
  .cx-wall { max-width:1100px; margin:28px auto 0; display:grid; gap:28px; grid-template-columns:repeat(auto-fill,minmax(min(100%,460px),1fr)); }

  .ad { margin:0; }
  .ad > .ad-in, .ad > .bg, .ad > .court { grid-area:1/1; }
  .ad { display:grid; grid-template-rows:auto auto; position:relative; }
  .ad .bg, .ad .court { width:100%; aspect-ratio:4/5; object-fit:cover; display:block; }
  .ad-in { aspect-ratio:4/5; position:relative; padding:7% 7% 6%; display:flex; flex-direction:column; gap:3%; overflow:hidden; box-shadow:0 1px 0 #0002, 0 12px 30px -12px #0005; }
  .ad figcaption { font-family:'JetBrains Mono Variable',monospace; font-size:.68rem; color:#6b6458; margin-top:8px; grid-row:2; }
  .hl { margin:0; font-weight:900; letter-spacing:-.045em; line-height:.9; font-size:clamp(2.1rem,7.4vw,3.6rem); }
  .hl span { display:block; font-size:.5em; letter-spacing:-.02em; line-height:1.05; margin-top:.35em; font-weight:700; }
  .copy { margin:0; font-size:clamp(.82rem,2.2vw,.98rem); line-height:1.4; max-width:34ch; }
  .sig { margin:auto 0 0; display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap; font-family:'JetBrains Mono Variable',monospace; font-size:.66rem; border-top:2px solid currentColor; padding-top:8px; }
  .sig b { font-family:'Inter Variable',sans-serif; font-size:.8rem; }

  /* 01 */
  .ad-about .ad-in { background:linear-gradient(#fffdf6ee,#fffdf6cc 55%,#fffdf600); }
  .ad-about .hl { font-size:clamp(3rem,13vw,6.4rem); }
  .crowd { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; width:82%; }
  .crowd .sq { aspect-ratio:1; overflow:hidden; outline:2px solid #121417; }
  .crowd .seat { display:grid; place-items:center; outline:2px dashed #121417; background:#fffdf6; text-decoration:none; font:700 .62rem/1.05 'JetBrains Mono Variable',monospace; text-align:center; }
  .ad-about .copy { background:#fffdf6; padding:8px 10px; outline:2px solid #121417; }
  .ad-about .sig { background:#fffdf6; padding:8px 10px; border:0; outline:2px solid #121417; }

  /* 02 */
  .ad-map .ad-in { background:#f6f1e4; }
  .ad-map .map { flex:1; min-height:0; display:grid; place-items:center; }
  .ad-map .map :global(svg) { max-height:100%; width:auto; max-width:100%; }

  /* 03 */
  .ad-pickle .court { display:grid; grid-template-rows:1.4fr 1fr 6px 1fr 1.4fr; background:#2b6b4e; padding:10% 12%; gap:0; }
  .ad-pickle .court > div { border:3px solid #f4f1e8; }
  .ad-pickle .court .kitchen { background:#3d8a64; }
  .ad-pickle .court .half { background:repeating-conic-gradient(#2f7555 0 25%, #2b6b4e 0 50%) 0 0/24px 24px; }
  .ad-pickle .court .net { background:#121417; border:0; }
  .ad-pickle .ad-in { color:#fffdf6; }
  .ad-pickle .hl span { color:#d8ff4f; }
  .ad-pickle .pickle { width:42%; align-self:flex-end; margin-top:-6%; filter:drop-shadow(6px 6px 0 #0006); }
  .ad-pickle .copy { background:#121417cc; padding:8px 10px; }

  /* 04 */
  .ad-orange .ad-in { background:#ff8a2a; color:#2a1405; }
  .slices { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
  .slice { aspect-ratio:1; background:#fff3e2; display:grid; place-content:center; text-align:center; font:700 .62rem 'JetBrains Mono Variable',monospace; border:2px solid #2a1405; }
  .slice b { font-size:1.1rem; }
  .slice.on { background:radial-gradient(circle at 50% 100%, #fff7d6 0 18%, #ffb347 19% 62%, #ff7a00 63% 70%, #fff3e2 71%); }
  .slice.on span { background:#fff3e2cc; }

  /* 05 */
  .ad-class .ad-in { background:#f4efe2; font-family:Georgia,'Times New Roman',serif; }
  .ad-class .mast { margin:0; border-bottom:4px double #121417; font:900 .8rem 'Inter Variable',sans-serif; letter-spacing:.12em; display:flex; justify-content:space-between; padding-bottom:4px; }
  .ad-class .hl { font-family:'Inter Variable',sans-serif; font-size:clamp(1.6rem,5.4vw,2.6rem); }
  .ad-class .cols { columns:3; column-gap:10px; column-rule:1px solid #12141755; font-size:clamp(.5rem,1.4vw,.62rem); line-height:1.25; flex:1; overflow:hidden; }
  .ad-class .cols p { margin:0 0 5px; break-inside:avoid; }

  /* 06 */
  .ad-sunset .ad-in { color:#fffdf6; justify-content:flex-end; background:linear-gradient(#0000 40%,#1a0b04cc); text-shadow:0 2px 10px #0008; }
  .ad-sunset .aside { margin:-2% 0 0; font-family:Georgia,serif; font-style:italic; font-size:1.3rem; }
  .ad-sunset .sig { margin-top:2%; }

  /* 07 */
  .ad-1997 .ad-in { background:#fffdf6; }
  .split { display:grid; grid-template-columns:1fr 1fr; gap:8px; flex:1; min-height:0; }
  .split ul { margin:0; padding:8px 10px 8px 22px; font-size:clamp(.55rem,1.5vw,.7rem); line-height:1.3; }
  .split li { margin-bottom:4px; }
  .old { background:#c0c0c0; border:2px outset #fff; font-family:'Times New Roman',serif; color:#000080; }
  .old .win { background:#000080; color:#fff; font:700 .62rem 'JetBrains Mono Variable',monospace; padding:3px 5px; display:flex; gap:3px; align-items:center; }
  .old .win i { width:8px; height:8px; background:#c0c0c0; display:inline-block; }
  .new { background:#121417; color:#d8ff4f; }
  .pix { display:grid; grid-template-columns:repeat(12,1fr); }
  .pix i { aspect-ratio:1; background:hsl(var(--h) 85% 62%); }

  /* 08 */
  .ad-agents .ad-in { color:#fffdf6; }
  .desk { display:grid; grid-template-columns:1fr auto 1fr; gap:8px; align-items:end; }
