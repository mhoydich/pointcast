---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { KENNEL_CLUB, imageUrl, sittingJsonUrl, sittingUrl } from '../../lib/kennel-club';
import KennelClubMint from '../../components/KennelClubMint.astro';
import KennelTodayLive from '../../components/KennelTodayLive.astro';

export function getStaticPaths() {
  return KENNEL_CLUB.sittings.map((sitting) => ({ params: { slug: sitting.slug }, props: { sitting } }));
}

const { sitting } = Astro.props as { sitting: (typeof KENNEL_CLUB.sittings)[number] };
const previous = KENNEL_CLUB.sittings[sitting.day - 2];
const next = KENNEL_CLUB.sittings[sitting.day];
const canonical = sittingUrl(sitting);
const description = `${sitting.name}, a ${sitting.breed}: ${sitting.title}. Sitting ${String(sitting.day).padStart(2, '0')} of Kennel Club's September 2026 daily portrait series.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'VisualArtwork', '@id': canonical, name: sitting.tokenMetadata.name, description, image: imageUrl(sitting, 'png'), url: canonical, artMedium: 'Digital painted portrait', additionalProperty: sitting.tokenMetadata.attributes.map((attribute) => ({ '@type': 'PropertyValue', name: attribute.name, value: attribute.value })) };
---

<BlockLayout title={`${sitting.name} · Kennel Club`} description={description} image={sitting.image.png} imageWidth={1024} imageHeight={1280} themeColor="#8A2432" jsonLd={jsonLd} alternates={[{ type: 'application/json', href: `/kennel-club/${sitting.slug}.json`, title: `${sitting.name} TZIP-21-style metadata` }]}>
  <main class="plate">
    <nav aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/kennel-club">Kennel Club</a><span>/</span><span>{sitting.slug}</span><a href={`/kennel-club/${sitting.slug}.json`}>JSON</a></nav>
    <article>
      <figure><img src={sitting.image.webp} alt={sitting.alt} width="1024" height="1280" /><figcaption>Sitting {String(sitting.day).padStart(2, '0')} · {sitting.mintDate} · original portrait plate</figcaption><p class="plate__ring" data-kennel-today="badge" data-kennel-day={sitting.day} hidden>Sitting of the day</p></figure>
      <div class="copy"><p class="kicker">Kennel Club · The September Sitting · token {sitting.tokenId}</p><h1>{sitting.name}</h1><p class="breed">{sitting.breed}</p><h2>{sitting.title}</h2><p class="wardrobe">{sitting.wardrobe}</p><p class="scene">{sitting.scene}</p><div class="mint"><span>Tezos mint · 1 ꜩ · open edition</span><KennelClubMint tokenId={sitting.tokenId} /></div></div>
    </article>
    <section class="metadata" aria-labelledby="metadata-title"><div><p class="kicker">TZIP-21-style metadata</p><h2 id="metadata-title">The registry, <em>on this plate.</em></h2></div><dl>{sitting.tokenMetadata.attributes.map((attribute) => <><dt>{attribute.name}</dt><dd>{attribute.value}</dd></>)}</dl></section>
    <footer>{previous ? <a href={`/kennel-club/${previous.slug}`}>← Sitting {String(previous.day).padStart(2, '0')} · {previous.name}</a> : <span>First sitting</span>}<a href="/kennel-club">All 30 sittings</a>{next ? <a href={`/kennel-club/${next.slug}`}>Sitting {String(next.day).padStart(2, '0')} · {next.name} →</a> : <span>Final sitting</span>}</footer>
  </main>
  <KennelTodayLive />
</BlockLayout>

<style>
  .plate { width: min(1120px, calc(100vw - 28px)); margin: 0 auto; padding: 22px 0 90px; --club: #8A2432; }
  nav, .kicker, figcaption, .mint, footer, .plate__ring { font: 400 10px var(--pc-font-mono); letter-spacing: .1em; text-transform: uppercase; }
  nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; color: var(--pc-ink-muted); } nav a:last-child { margin-left: auto; }
  article { display: grid; grid-template-columns: minmax(0, .92fr) minmax(320px, 1fr); border-top: 2px solid var(--pc-ink); border-bottom: 1px solid var(--pc-ink); }
  figure { position: relative; margin: 0; background: var(--club); } figure img { width: 100%; height: 100%; object-fit: cover; } figcaption { position: absolute; right: 8px; bottom: 8px; left: 8px; background: rgba(255,255,255,.93); padding: 7px; color: var(--pc-ink); }
  .plate__ring { position: absolute; top: 8px; left: 8px; margin: 0; padding: 6px 8px; background: var(--club); color: #fff; }
  .copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(24px, 5vw, 68px); border-left: 1px solid var(--pc-ink); } .kicker { margin: 0 0 12px; color: var(--club); } h1, h2 { margin: 0; font-weight: 400; letter-spacing: -.05em; line-height: .88; } h1 { font-size: clamp(52px, 8vw, 104px); } .breed { margin: 16px 0 0; font-size: 19px; font-weight: 500; } .copy h2 { margin-top: 28px; color: var(--club); font-size: clamp(28px, 4vw, 50px); } .wardrobe { margin: 14px 0 0; font-size: 16px; line-height: 1.45; } .scene { color: var(--pc-ink-soft); font-size: 14px; line-height: 1.5; } .mint { display: grid; gap: 7px; margin-top: 25px; padding-top: 13px; border-top: 1px solid var(--pc-ink); } .mint span { color: var(--club); } .mint b { font-weight: 500; letter-spacing: normal; text-transform: none; }
  .metadata { display: grid; grid-template-columns: minmax(220px, .8fr) minmax(0, 1.2fr); gap: 28px; padding: 28px 0; border-bottom: 1px solid var(--pc-ink); } .metadata h2 { font-size: clamp(34px, 5vw, 66px); } .metadata h2 em { color: var(--club); font-style: normal; } dl { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border-top: 1px solid var(--pc-ink); border-left: 1px solid var(--pc-ink); } dt, dd { margin: 0; padding: 10px; border-right: 1px solid var(--pc-ink); border-bottom: 1px solid var(--pc-ink); } dt { font: 400 9px var(--pc-font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--pc-ink-muted); } dd { font-size: 13px; }
  footer { display: flex; justify-content: space-between; gap: 10px; padding-top: 14px; } footer a { color: var(--club); } footer a:nth-child(2) { color: var(--pc-ink); text-align: center; }
  @media (max-width: 760px) { article, .metadata { grid-template-columns: 1fr; } .copy { border-top: 1px solid var(--pc-ink); border-left: 0; } .metadata { gap: 22px; } footer { flex-direction: column; } footer a:nth-child(2) { text-align: left; } }
</style>
