---
const releaseUrl = 'https://network-el-segundo.mhoydich.chatgpt.site';
const title = 'Network El Segundo — PointCast';
const description =
  'Buy the art. Join the roster. A living poster network where each recorded sale reserves half of proceeds for participating wallets.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2ff47" />
    <link rel="canonical" href="https://pointcast.xyz/network-el-segundo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://pointcast.xyz/network-el-segundo" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${releaseUrl}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${releaseUrl}/og.png`} />
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: #070707; }
      body { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
      .pointcast-frame { min-height: 100vh; display: grid; grid-template-rows: auto 1fr; }
      .pointcast-rail {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .55rem .75rem;
        color: #070707;
        background: #f2ff47;
        border-bottom: 2px solid #070707;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .pointcast-rail a { color: inherit; font-weight: 900; text-decoration-thickness: 2px; text-underline-offset: 3px; }
      .pointcast-rail__signal { display: flex; align-items: center; gap: .55rem; white-space: nowrap; }
      .pointcast-rail__dot { width: .65rem; height: .65rem; border-radius: 50%; background: #ff4f9f; box-shadow: 0 0 0 2px #070707; }
      .network-stage { position: relative; min-height: calc(100vh - 2.4rem); }
      .network-stage iframe { display: block; width: 100%; height: calc(100vh - 2.4rem); border: 0; background: #f7f2e8; }
      .network-stage__fallback {
        position: absolute;
        inset: auto 1rem 1rem auto;
        padding: .65rem .8rem;
        color: white;
        background: #070707;
        border: 1px solid white;
        font-size: .7rem;
      }
      @media (max-width: 46rem) {
        .pointcast-rail { align-items: flex-start; font-size: .58rem; }
        .pointcast-rail__copy { max-width: 15rem; text-align: right; }
      }
    </style>
  </head>
  <body>
    <main class="pointcast-frame">
      <nav class="pointcast-rail" aria-label="PointCast release navigation">
        <span class="pointcast-rail__signal"><span class="pointcast-rail__dot" aria-hidden="true"></span><a href="/">PointCast</a> / Network El Segundo</span>
        <span class="pointcast-rail__copy">Buy art → enter roster → reserve 50% for participants</span>
      </nav>
      <section class="network-stage" aria-label="Network El Segundo release">
        <iframe
          src={releaseUrl}
          title="Network El Segundo — buy the art and join the wallet roster"
          allow="clipboard-write"
          loading="eager"
        ></iframe>
        <a class="network-stage__fallback" href={releaseUrl} target="_blank" rel="noopener">Open the release ↗</a>
      </section>
    </main>
  </body>
</html>
