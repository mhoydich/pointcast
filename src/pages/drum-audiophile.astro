---
/**
 * /drum-audiophile — listening room for the audiophile crowd.
 *
 * Mike 2026-05-08: "create a drum area for audiophiles."
 *
 * Same 5-voice family as the rest of the wing, but rendered with
 * audiophile-grade attention: longer release tails, richer harmonic
 * stacks, procedural convolution reverb, dynamic compression, and a
 * proper master bus → AnalyserNode → spectrum + VU meters in real time.
 *
 * A/B switch flips between STANDARD (vanilla wing voices, no reverb)
 * and HI-FI (extended envelopes + 4-second sine-decay IR + 2:1 comp).
 *
 * Aesthetic: dark walnut + brass + candlelight. Vintage VU meter with
 * an animated needle. 64-bin spectrum analyzer in warm gradient. Two
 * Nouns sitting in listening chairs (#1189 Night Broadcast on the
 * left, #287 on the right) — they bob to the kicks.
 *
 * 16-step pattern, tempo 60-140 BPM. Pattern editor shows below.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Drum Audiophile · listening room · PointCast';
const description = 'Listening room with hi-fi drum voices, spectrum analyzer, VU meters, and A/B compare. Tube-amp aesthetic.';
---

<BlockLayout title={title} description={description}>
  <main class="da" id="da-main">
    <header class="da__header">
      <h1 class="da__title">DRUM AUDIOPHILE</h1>
      <p class="da__tag">listening room · 5-voice hi-fi · spectrum &amp; VU · A/B compare</p>
    </header>

    <section class="da__room" id="da-room">
      {/* Listening chairs with Nouns */}
      <div class="da__chair da__chair--left">
        <div class="da__chair-back" aria-hidden="true"></div>
        <div class="da__noun" id="da-noun-l"><img src="/images/audiophile-nouns/headphones.svg" alt="Headphones Noun — left listener" width="84" height="84" loading="lazy"/></div>
        <span class="da__chair-label">L · headphones</span>
      </div>

      {/* Center stack: VU + spectrum + amp */}
      <div class="da__stack">
        <div class="da__amp" aria-hidden="true">
          <div class="da__vu">
            <span class="da__vu-label">L</span>
            <canvas class="da__vu-canvas" id="da-vu-l" width="180" height="80"></canvas>
          </div>
          <div class="da__vu">
            <span class="da__vu-label">R</span>
            <canvas class="da__vu-canvas" id="da-vu-r" width="180" height="80"></canvas>
          </div>
        </div>
        <div class="da__spectrum">
          <canvas class="da__spectrum-canvas" id="da-spectrum" width="600" height="120"></canvas>
        </div>
        <div class="da__readout" id="da-readout">— idle · ready —</div>
      </div>

      <div class="da__chair da__chair--right">
        <div class="da__chair-back" aria-hidden="true"></div>
        <div class="da__noun" id="da-noun-r"><img src="/images/audiophile-nouns/vu-meter.svg" alt="VU-Meter Noun — right listener" width="84" height="84" loading="lazy"/></div>
        <span class="da__chair-label">R · vu-meter</span>
      </div>

      <div class="da__candles" aria-hidden="true">
        <span class="da__candle"></span>
        <span class="da__candle"></span>
        <span class="da__candle"></span>
      </div>
    </section>

    <section class="da__panel">
      <button class="da__btn da__btn--big" id="da-toggle" type="button">▶ DROP THE NEEDLE</button>
      <button class="da__btn" id="da-ab" type="button" data-mode="hifi">A/B · HI-FI</button>
      <label class="da__tempo">
        <span class="da__tempo-label">TEMPO</span>
        <input type="range" id="da-tempo" min="60" max="140" step="2" value="84"/>
        <span id="da-tempo-readout">84 bpm</span>
      </label>
      <span class="da__mode" id="da-mode">mode: HI-FI · IR=4s sine-decay · comp 2:1 · master -3dB</span>
    </section>

    <section class="da__pattern">
      {['kick', 'snare', 'bell', 'lead', 'pad'].map((inst) => (
        <div class="da__lane" data-inst={inst}>
          <span class="da__lane-label">{inst.toUpperCase()}</span>
          <span class="da__cells">
            {Array.from({ length: 16 }).map((_, i) => (
              <button class={`da__cell ${i % 4 === 0 ? 'da__cell--beat' : ''}`} data-inst={inst} data-step={i} aria-pressed="false" type="button"></button>
            ))}
          </span>
        </div>
      ))}
    </section>

    <section class="da__bench" aria-label="Audiophile Nouns family">
      <p class="da__bench-kicker">CUSTOM AUDIOPHILE NOUNS · the family</p>
      <div class="da__bench-grid">
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/headphones.svg" alt="" width="64" height="64" loading="lazy"/><figcaption>headphones</figcaption></figure>
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/vinyl.svg"      alt="" width="64" height="64" loading="lazy"/><figcaption>vinyl</figcaption></figure>
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/cassette.svg"   alt="" width="64" height="64" loading="lazy"/><figcaption>cassette</figcaption></figure>
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/vu-meter.svg"   alt="" width="64" height="64" loading="lazy"/><figcaption>vu-meter</figcaption></figure>
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/speaker.svg"    alt="" width="64" height="64" loading="lazy"/><figcaption>speaker</figcaption></figure>
        <figure class="da__bench-card"><img src="/images/audiophile-nouns/tube-amp.svg"   alt="" width="64" height="64" loading="lazy"/><figcaption>tube-amp</figcaption></figure>
      </div>
      <p class="da__bench-note">Hand-drawn pixel-art SVGs · 32×32 viewBox · CC0 · crispEdges rendering</p>
    </section>

    <section class="da__siblings">
      <a href="/drum-quintet">/drum-quintet</a>
      <a href="/drum-noun-radio">/drum-noun-radio</a>
      <a href="/drum-jukebox">/drum-jukebox</a>
      <a href="/drum-looper">/drum-looper</a>
      <a href="/drum-map">/drum-map</a>
    </section>
  </main>
</BlockLayout>

<style>
  .da { max-width: 1100px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #f4e7c8; background: linear-gradient(180deg, #1a0a06 0%, #0c0408 100%); min-height: 100vh; }
  .da__header { text-align: center; margin: 18px 0 18px; }
  .da__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 64px); letter-spacing: 0.18em; margin: 0; color: #f6c15e; text-shadow: 0 0 24px rgba(246, 193, 94, 0.40); }
  .da__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #d4a437; opacity: 0.85; margin: 6px 0 0; }

  .da__room { position: relative; display: grid; grid-template-columns: 140px 1fr 140px; gap: 18px; align-items: center; padding: 28px 22px; border: 3px solid #5a3422; background: linear-gradient(180deg, #2a1810 0%, #3a2418 50%, #1a0a06 100%); box-shadow: 6px 6px 0 0 #050310, inset 0 0 60px rgba(0, 0, 0, 0.55); }

  .da__chair { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; padding: 14px 4px; }
  .da__chair-back { width: 110px; height: 130px; border: 2px solid #5a3422; background: linear-gradient(180deg, #5a3422 0%, #3a2410 100%); border-radius: 10px 10px 4px 4px; box-shadow: inset 0 -10px 0 #2a1408; position: absolute; top: 0; z-index: 0; }
  .da__noun { width: 84px; height: 84px; image-rendering: pixelated; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.6)); position: relative; z-index: 1; transition: transform 80ms; }
  .da__noun img { width: 100%; height: 100%; image-rendering: pixelated; }
  .da__noun.da__noun--bob { transform: translateY(-4px) scale(1.03); }
  .da__chair-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.20em; color: #d4a437; opacity: 0.85; position: relative; z-index: 1; margin-top: 14px; }

  .da__stack { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .da__amp { display: flex; gap: 14px; padding: 10px 14px; border: 2px solid #6b4d12; background: linear-gradient(180deg, #2a1408 0%, #5a3422 100%); border-radius: 6px; box-shadow: inset 0 0 0 1px #d4a437, 4px 4px 0 0 #050310; }
  .da__vu { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .da__vu-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.30em; color: #d4a437; }
  .da__vu-canvas { background: #1a0a06; border: 1px solid #5a3422; border-radius: 4px; }

  .da__spectrum { width: 100%; max-width: 600px; padding: 6px; border: 2px solid #5a3422; background: #050310; border-radius: 4px; box-shadow: 4px 4px 0 0 #050310; }
  .da__spectrum-canvas { width: 100%; height: 120px; display: block; }
  .da__readout { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.16em; color: #d4a437; opacity: 0.75; padding: 2px 8px; }

  .da__candles { position: absolute; inset: 0; pointer-events: none; }
  .da__candle { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #f6c15e; box-shadow: 0 0 16px 6px rgba(246, 193, 94, 0.40); animation: da-flicker 1.6s ease-in-out infinite; }
  .da__candle:nth-child(1) { top: 20px; left: 30px; }
  .da__candle:nth-child(2) { top: 30px; right: 30px; animation-duration: 2.0s; }
  .da__candle:nth-child(3) { bottom: 30px; left: 50%; animation-duration: 1.4s; }
  @keyframes da-flicker { 0%, 100% { opacity: 0.85; transform: scale(1); } 50% { opacity: 1; transform: scale(1.15); } }

  .da__panel { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; padding: 12px 14px; border: 2px solid #5a3422; background: rgba(26, 8, 6, 0.65); margin: 14px 0; }
  .da__btn { padding: 9px 16px; border: 2px solid #d4a437; background: linear-gradient(180deg, #2a1408 0%, #1a0a06 100%); color: #f6c15e; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; cursor: pointer; box-shadow: 2px 2px 0 0 #050310; transition: transform 100ms, border-color 200ms; }
  .da__btn:hover { transform: translate(-1px, -1px); border-color: #f6c15e; }
  .da__btn--big { padding: 11px 22px; font-size: 12px; }
  .da__tempo { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #d4a437; }
  .da__tempo input[type='range'] { width: 160px; }
  .da__mode { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.10em; color: #cfc6df; opacity: 0.75; margin-left: auto; }

  .da__pattern { display: flex; flex-direction: column; gap: 6px; padding: 12px; border: 2px solid #5a3422; background: rgba(26, 8, 6, 0.55); }
  .da__lane { display: grid; grid-template-columns: 70px 1fr; align-items: center; gap: 10px; }
  .da__lane-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; font-weight: 800; letter-spacing: 0.18em; color: #d4a437; }
  .da__cells { display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 3px; }
  .da__cell { height: 22px; border: 1px solid #5a3422; background: rgba(212, 164, 55, 0.05); cursor: pointer; transition: background 80ms, transform 80ms, box-shadow 80ms; padding: 0; }
  .da__cell:hover { background: rgba(212, 164, 55, 0.18); }
  .da__cell--beat { border-color: #6b4d12; }
  .da__cell[aria-pressed='true'] { background: #d4a437; }
  .da__cell[data-active='true'] { box-shadow: 0 0 0 2px #f6c15e; transform: translateY(-1px); }

  .da__bench { padding: 14px; border: 2px solid #5a3422; background: rgba(212, 164, 55, 0.05); margin: 14px 0; }
  .da__bench-kicker { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #d4a437; margin: 0 0 12px; text-align: center; }
  .da__bench-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .da__bench-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px; border: 1.5px solid #5a3422; background: linear-gradient(180deg, rgba(212, 164, 55, 0.10) 0%, rgba(26, 8, 6, 0.30) 100%); margin: 0; transition: transform 100ms, border-color 200ms; }
  .da__bench-card:hover { transform: translateY(-2px); border-color: #d4a437; }
  .da__bench-card img { width: 64px; height: 64px; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4)); }
  .da__bench-card figcaption { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: #f4e7c8; }
  .da__bench-note { font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.10em; color: #cfc6df; opacity: 0.65; text-align: center; margin: 12px 0 0; }
  @media (max-width: 720px) { .da__bench-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .da__siblings { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .da__siblings a { color: #d4a437; text-decoration: none; }
  .da__siblings a:hover { color: #f6c15e; text-decoration: underline; }

  @media (max-width: 720px) { .da__room { grid-template-columns: 1fr; } .da__chair { display: none; } .da__title { font-size: 32px; } .da__lane { grid-template-columns: 1fr; gap: 4px; } }
  @media (prefers-reduced-motion: reduce) { .da__candle, .da__noun { animation: none !important; transition: none !important; } }
</style>

<script>
  const LANES = ['kick', 'snare', 'bell', 'lead', 'pad'] as const;
  type Inst = typeof LANES[number];

  // ─── Audio context + master bus ──────────────────────────────
  let actx: AudioContext | null = null;
  let master: GainNode | null = null;
  let comp: DynamicsCompressorNode | null = null;
  let analyser: AnalyserNode | null = null;
  let convolver: ConvolverNode | null = null;
  let dryGain: GainNode | null = null;
  let wetGain: GainNode | null = null;

  function ctx() {
    if (!actx) {
      const AC = (window as any).AudioContext || (window as any).webkitAudioContext;
      actx = new AC();
    }
    if (actx && actx.state === 'suspended') actx.resume();
    return actx!;
  }

  function ensureBus() {
    if (master) return;
    const a = ctx();
    master = a.createGain();
    master.gain.value = 0.85;

    comp = a.createDynamicsCompressor();
    comp.threshold.value = -18;
    comp.ratio.value = 2;
    comp.knee.value = 6;
    comp.attack.value = 0.005;
    comp.release.value = 0.18;

    analyser = a.createAnalyser();
    analyser.fftSize = 1024;
    analyser.smoothingTimeConstant = 0.78;

    // Procedural convolution IR — 4s sine-decay (warm, no metallic ring)
    convolver = a.createConvolver();
    const sr = a.sampleRate;
    const len = Math.floor(sr * 4.0);
    const ir = a.createBuffer(2, len, sr);
    for (let ch = 0; ch < 2; ch++) {
      const d = ir.getChannelData(ch);
      for (let i = 0; i < len; i++) {
        const t = i / sr;
        const decay = Math.exp(-t * 1.6);
        const noise = (Math.random() * 2 - 1) * 0.6;
        const tone = Math.sin(2 * Math.PI * (40 + ch * 12) * t) * 0.4;
        d[i] = (noise + tone) * decay;
      }
    }
    convolver.buffer = ir;

    dryGain = a.createGain();
    wetGain = a.createGain();
    dryGain.gain.value = 0.85;
    wetGain.gain.value = 0.30;

    // Routing: voices → master → split (dry → comp → out, wet → conv → comp → out) → analyser
    master.connect(dryGain);
    master.connect(convolver);
    convolver.connect(wetGain);
    dryGain.connect(comp);
    wetGain.connect(comp);
    comp.connect(analyser);
    analyser.connect(a.destination);
  }

  // ─── Voices ──────────────────────────────────────────────────
  // STANDARD versions (matches rest of wing)
  function pK_std(t: number, dest: AudioNode) {
    const a = ctx();
    const o = a.createOscillator(), g = a.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(120, t);
    o.frequency.exponentialRampToValueAtTime(40, t + 0.18);
    g.gain.setValueAtTime(0.55, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.25);
    o.connect(g).connect(dest);
    o.start(t); o.stop(t + 0.3);
  }
  function pSn_std(t: number, dest: AudioNode) {
    const a = ctx();
    const buf = a.createBuffer(1, a.sampleRate * 0.12, a.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
    const noise = a.createBufferSource(); noise.buffer = buf;
    const bp = a.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1800; bp.Q.value = 1.2;
    const g = a.createGain();
    g.gain.setValueAtTime(0.36, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
    noise.connect(bp).connect(g).connect(dest);
    noise.start(t); noise.stop(t + 0.2);
  }
  function pB_std(t: number, dest: AudioNode) {
    const a = ctx();
    [1320, 2640, 3960].forEach((f, i) => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime([0.16, 0.09, 0.05][i], t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.0);
      o.connect(g).connect(dest);
      o.start(t); o.stop(t + 1.1);
    });
  }
  function pL_std(t: number, dest: AudioNode) {
    const a = ctx();
    const D = [0, 4, 7, 12, 14], deg = D[Math.floor(Math.random() * D.length)];
    const f = 264 * Math.pow(2, deg / 12);
    const o = a.createOscillator(), g = a.createGain(), lpf = a.createBiquadFilter();
    o.type = 'sawtooth';
    o.frequency.setValueAtTime(f, t);
    lpf.type = 'lowpass';
    lpf.frequency.setValueAtTime(2200, t);
    lpf.frequency.exponentialRampToValueAtTime(800, t + 0.4);
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(0.13, t + 0.005);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
    o.connect(lpf).connect(g).connect(dest);
    o.start(t); o.stop(t + 0.45);
  }
  function pP_std(t: number, dest: AudioNode) {
    const a = ctx();
    [132, 198].forEach(f => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.09, t + 0.18);
      g.gain.linearRampToValueAtTime(0.09, t + 0.4);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.65);
      o.connect(g).connect(dest);
      o.start(t); o.stop(t + 0.7);
    });
  }

  // HI-FI versions — extended envelopes, more partials, gentler curves
  function pK_hifi(t: number, dest: AudioNode) {
    const a = ctx();
    // Subharmonic body
    const sub = a.createOscillator(), subG = a.createGain();
    sub.type = 'sine';
    sub.frequency.setValueAtTime(60, t);
    sub.frequency.exponentialRampToValueAtTime(35, t + 0.24);
    subG.gain.setValueAtTime(0.40, t);
    subG.gain.exponentialRampToValueAtTime(0.0001, t + 0.55);
    sub.connect(subG).connect(dest);
    sub.start(t); sub.stop(t + 0.6);
    // Click attack
    const o = a.createOscillator(), g = a.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(140, t);
    o.frequency.exponentialRampToValueAtTime(48, t + 0.20);
    g.gain.setValueAtTime(0.50, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.30);
    o.connect(g).connect(dest);
    o.start(t); o.stop(t + 0.32);
  }
  function pSn_hifi(t: number, dest: AudioNode) {
    const a = ctx();
    // Pink noise (rough but cheap)
    const len = Math.floor(a.sampleRate * 0.30);
    const buf = a.createBuffer(1, len, a.sampleRate);
    const d = buf.getChannelData(0);
    let b0 = 0, b1 = 0, b2 = 0;
    for (let i = 0; i < len; i++) {
      const w = Math.random() * 2 - 1;
      b0 = 0.99765 * b0 + w * 0.0990460;
      b1 = 0.96300 * b1 + w * 0.2965164;
      b2 = 0.57000 * b2 + w * 1.0526913;
      d[i] = (b0 + b1 + b2 + w * 0.1848) * 0.6;
    }
    const noise = a.createBufferSource(); noise.buffer = buf;
    const bp1 = a.createBiquadFilter(); bp1.type = 'bandpass'; bp1.frequency.value = 1800; bp1.Q.value = 0.9;
    const bp2 = a.createBiquadFilter(); bp2.type = 'peaking'; bp2.frequency.value = 5500; bp2.Q.value = 1.4; bp2.gain.value = 6;
    const g = a.createGain();
    g.gain.setValueAtTime(0.32, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.28);
    noise.connect(bp1).connect(bp2).connect(g).connect(dest);
    noise.start(t); noise.stop(t + 0.30);
    // Tonal body
    const o = a.createOscillator(), gg = a.createGain();
    o.type = 'triangle';
    o.frequency.setValueAtTime(220, t);
    o.frequency.exponentialRampToValueAtTime(180, t + 0.10);
    gg.gain.setValueAtTime(0.16, t);
    gg.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
    o.connect(gg).connect(dest);
    o.start(t); o.stop(t + 0.18);
  }
  function pB_hifi(t: number, dest: AudioNode) {
    const a = ctx();
    // 5 partials with stretched harmonic series + per-partial decay
    const partials = [
      { f: 1320, g: 0.13, d: 2.4 },
      { f: 2640, g: 0.08, d: 2.0 },
      { f: 3300, g: 0.05, d: 1.6 },
      { f: 3960, g: 0.04, d: 1.2 },
      { f: 5280, g: 0.03, d: 0.9 },
    ];
    partials.forEach(p => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(p.f, t);
      g.gain.setValueAtTime(p.g, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + p.d);
      o.connect(g).connect(dest);
      o.start(t); o.stop(t + p.d + 0.1);
    });
  }
  function pL_hifi(t: number, dest: AudioNode) {
    const a = ctx();
    const D = [0, 4, 7, 12, 14], deg = D[Math.floor(Math.random() * D.length)];
    const f = 264 * Math.pow(2, deg / 12);
    const o = a.createOscillator(), g = a.createGain(), lpf = a.createBiquadFilter();
    o.type = 'triangle'; // softer than saw
    o.frequency.setValueAtTime(f, t);
    lpf.type = 'lowpass';
    lpf.frequency.setValueAtTime(3200, t);
    lpf.frequency.exponentialRampToValueAtTime(900, t + 0.7);
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(0.16, t + 0.012);
    g.gain.linearRampToValueAtTime(0.13, t + 0.30);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.85);
    o.connect(lpf).connect(g).connect(dest);
    o.start(t); o.stop(t + 0.90);
  }
  function pP_hifi(t: number, dest: AudioNode) {
    const a = ctx();
    // C major triad fundamental + fifth + octave + tenth, slow attack, long sustain
    [132, 165, 198, 264].forEach((f, i) => {
      const o = a.createOscillator(), g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      const peak = [0.10, 0.06, 0.05, 0.04][i];
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(peak, t + 0.6);
      g.gain.linearRampToValueAtTime(peak * 0.85, t + 1.5);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 2.4);
      o.connect(g).connect(dest);
      o.start(t); o.stop(t + 2.5);
    });
  }

  const VOICES_STD: Record<Inst, (t: number, dest: AudioNode) => void> = { kick: pK_std, snare: pSn_std, bell: pB_std, lead: pL_std, pad: pP_std };
  const VOICES_HIFI: Record<Inst, (t: number, dest: AudioNode) => void> = { kick: pK_hifi, snare: pSn_hifi, bell: pB_hifi, lead: pL_hifi, pad: pP_hifi };

  // ─── State ──────────────────────────────────────────────────
  const pattern: Record<Inst, boolean[]> = { kick: [], snare: [], bell: [], lead: [], pad: [] };
  // Default seed — mellow listening pattern
  pattern.kick  = [true, false, false, false, true, false, false, false, true, false, false, false, true, false, false, false];
  pattern.snare = [false, false, false, false, true, false, false, false, false, false, false, false, true, false, false, true];
  pattern.bell  = [false, false, true, false, false, false, false, false, false, false, true, false, false, false, false, false];
  pattern.lead  = [false, false, false, false, false, false, true, false, false, false, false, false, false, false, true, false];
  pattern.pad   = [true, false, false, false, false, false, false, false, true, false, false, false, false, false, false, false];

  let mode: 'standard' | 'hifi' = 'hifi';
  let bpm = 84;
  let step = 0;
  let stepTimer: number | null = null;
  let drawHandle: number | null = null;
  let playing = false;

  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('.da__cell'));
  const toggleBtn = document.getElementById('da-toggle') as HTMLButtonElement;
  const abBtn = document.getElementById('da-ab') as HTMLButtonElement;
  const tempoEl = document.getElementById('da-tempo') as HTMLInputElement;
  const tempoReadout = document.getElementById('da-tempo-readout');
  const modeEl = document.getElementById('da-mode');
  const readoutEl = document.getElementById('da-readout');
  const nounLEl = document.getElementById('da-noun-l');
  const nounREl = document.getElementById('da-noun-r');
  const spectrumCanvas = document.getElementById('da-spectrum') as HTMLCanvasElement | null;
  const vuLCanvas = document.getElementById('da-vu-l') as HTMLCanvasElement | null;
  const vuRCanvas = document.getElementById('da-vu-r') as HTMLCanvasElement | null;

  function setMode(m: 'standard' | 'hifi') {
    mode = m;
    if (abBtn) {
      abBtn.dataset.mode = m;
      abBtn.textContent = m === 'hifi' ? 'A/B · HI-FI' : 'A/B · STANDARD';
    }
    if (modeEl) modeEl.textContent = m === 'hifi'
      ? 'mode: HI-FI · IR=4s sine-decay · comp 2:1 · master -3dB'
      : 'mode: STANDARD · no reverb · no comp · master 0dB';
    if (master && convolver && dryGain && wetGain && comp) {
      // In standard mode, mute wet (no reverb) and bypass comp routing visually
      wetGain.gain.value = m === 'hifi' ? 0.30 : 0;
      dryGain.gain.value = 0.85;
    }
  }

  function paintActive(s: number) {
    cells.forEach(c => c.dataset.active = String(Number(c.dataset.step) === s));
  }
  function bobNoun(noun: HTMLElement | null) {
    if (!noun) return;
    noun.classList.add('da__noun--bob');
    setTimeout(() => noun.classList.remove('da__noun--bob'), 90);
  }
  function tick() {
    ensureBus();
    if (!master) return;
    const a = ctx();
    const at = a.currentTime + 0.02;
    const voices = mode === 'hifi' ? VOICES_HIFI : VOICES_STD;
    let didKick = false;
    LANES.forEach(inst => {
      if (pattern[inst][step]) {
        try { voices[inst](at, master!); } catch {}
        if (inst === 'kick') didKick = true;
      }
    });
    if (didKick) { bobNoun(nounLEl); bobNoun(nounREl); }
    paintActive(step);
    if (readoutEl) readoutEl.textContent = `step ${step + 1} / 16 · ${bpm} bpm · ${mode}`;
    step = (step + 1) % 16;
  }

  function start() {
    if (playing) return;
    ensureBus();
    playing = true;
    step = 0;
    if (toggleBtn) toggleBtn.textContent = '■ LIFT THE NEEDLE';
    tick();
    stepTimer = window.setInterval(tick, (60 / bpm / 4) * 1000);
    if (!drawHandle) drawLoop();
  }
  function stop() {
    if (!playing) return;
    playing = false;
    if (stepTimer) { clearInterval(stepTimer); stepTimer = null; }
    if (toggleBtn) toggleBtn.textContent = '▶ DROP THE NEEDLE';
    if (readoutEl) readoutEl.textContent = '— idle · ready —';
    paintActive(-1);
  }

  // ─── Visual loop: spectrum + VU ─────────────────────────────
  const freqData = new Uint8Array(512);
  const timeData = new Uint8Array(2048);
  function drawLoop() {
    drawHandle = window.requestAnimationFrame(drawLoop);
    if (!analyser || !spectrumCanvas) return;
    analyser.getByteFrequencyData(freqData);
    analyser.getByteTimeDomainData(timeData);

    // Spectrum
    const sctx = spectrumCanvas.getContext('2d');
    if (sctx) {
      const w = spectrumCanvas.width, h = spectrumCanvas.height;
      sctx.clearRect(0, 0, w, h);
      const bins = 64;
      const binW = w / bins;
      for (let i = 0; i < bins; i++) {
        const v = freqData[i * 4] / 255;
        const bh = v * h * 0.92;
        const grad = sctx.createLinearGradient(0, h, 0, h - bh);
        grad.addColorStop(0, '#5a3422');
        grad.addColorStop(0.5, '#d4a437');
        grad.addColorStop(1, '#f6c15e');
        sctx.fillStyle = grad;
        sctx.fillRect(i * binW + 1, h - bh, binW - 2, bh);
      }
      // Floor line
      sctx.strokeStyle = 'rgba(212, 164, 55, 0.30)';
      sctx.beginPath(); sctx.moveTo(0, h - 1); sctx.lineTo(w, h - 1); sctx.stroke();
    }

    // VU — rough RMS over time-domain data
    let sum = 0;
    for (let i = 0; i < timeData.length; i++) { const v = (timeData[i] - 128) / 128; sum += v * v; }
    const rms = Math.sqrt(sum / timeData.length);
    const level = Math.min(1, rms * 4);
    drawVU(vuLCanvas, level * (0.92 + Math.random() * 0.08));
    drawVU(vuRCanvas, level * (0.96 + Math.random() * 0.08));
  }
  function drawVU(c: HTMLCanvasElement | null, level: number) {
    if (!c) return;
    const x = c.getContext('2d'); if (!x) return;
    const w = c.width, h = c.height;
    x.clearRect(0, 0, w, h);
    // Cream face
    x.fillStyle = '#f4e7c8';
    x.fillRect(0, 0, w, h);
    // Arc tick marks
    const cx = w / 2, cy = h + 20;
    x.strokeStyle = '#5a3422'; x.lineWidth = 1;
    for (let i = 0; i <= 10; i++) {
      const a = Math.PI * (1.0 - i / 10 * 0.7) - Math.PI * 0.15;
      const r1 = h * 0.85, r2 = h * 0.95;
      const x1 = cx + Math.cos(a) * r1, y1 = cy - Math.sin(a) * r1;
      const x2 = cx + Math.cos(a) * r2, y2 = cy - Math.sin(a) * r2;
      x.beginPath(); x.moveTo(x1, y1); x.lineTo(x2, y2); x.stroke();
    }
    // Red zone
    x.strokeStyle = '#b8431a'; x.lineWidth = 3;
    x.beginPath();
    for (let i = 7; i <= 10; i++) {
      const a = Math.PI * (1.0 - i / 10 * 0.7) - Math.PI * 0.15;
      const r = h * 0.92;
      const xx = cx + Math.cos(a) * r, yy = cy - Math.sin(a) * r;
      if (i === 7) x.moveTo(xx, yy); else x.lineTo(xx, yy);
    }
    x.stroke();
    // Needle
    const ang = Math.PI * (1.0 - level * 0.7) - Math.PI * 0.15;
    const r = h * 0.98;
    x.strokeStyle = '#1a0a06'; x.lineWidth = 2;
    x.beginPath(); x.moveTo(cx, cy); x.lineTo(cx + Math.cos(ang) * r, cy - Math.sin(ang) * r); x.stroke();
    // Pivot
    x.fillStyle = '#5a3422'; x.beginPath(); x.arc(cx, cy, 4, 0, Math.PI * 2); x.fill();
    // Label
    x.fillStyle = '#5a3422'; x.font = '8px JetBrains Mono Variable, monospace';
    x.fillText('VU', cx - 6, h - 2);
  }

  // ─── Wire up ────────────────────────────────────────────────
  function paintCells() {
    cells.forEach(c => c.setAttribute('aria-pressed', String(pattern[c.dataset.inst as Inst][Number(c.dataset.step)])));
  }
  cells.forEach(c => c.addEventListener('click', () => {
    const inst = c.dataset.inst as Inst;
    const s = Number(c.dataset.step);
    pattern[inst][s] = !pattern[inst][s];
    c.setAttribute('aria-pressed', String(pattern[inst][s]));
  }));
  toggleBtn?.addEventListener('click', () => { playing ? stop() : start(); });
  abBtn?.addEventListener('click', () => setMode(mode === 'hifi' ? 'standard' : 'hifi'));
  tempoEl?.addEventListener('input', () => {
    bpm = Math.max(60, Math.min(140, Number(tempoEl.value)));
    if (tempoReadout) tempoReadout.textContent = `${bpm} bpm`;
    if (playing) {
      if (stepTimer) clearInterval(stepTimer);
      stepTimer = window.setInterval(tick, (60 / bpm / 4) * 1000);
    }
  });

  paintCells();
  setMode('hifi');
  drawLoop(); // Start the visual loop even before audio plays — shows idle floor.
</script>
