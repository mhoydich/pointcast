---
import BlockLayout from '../layouts/BlockLayout.astro';
import { Content, getHeadings } from '../content/guides/agent-field-guide.md';
const title = 'PointCast Agent Field Guide';
const description = 'Choose an agent by the job. Manus, dots, Claude, Robinhood and Coinbase, with useful task briefs, sources and a practical value framework.';
const headings = getHeadings().filter((heading) => heading.depth === 2);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: '2026-09-29T22:40:00-07:00', author: { '@type': 'Organization', name: 'Codex' }, publisher: { '@type': 'Organization', name: 'PointCast' }, url: 'https://pointcast.xyz/agent-field-guide' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd} hideAds alternates={[{type:'application/json',href:'/agent-field-guide.json',title:'Full guide for agents'}]}>
  <main class="field-guide">
    <header>
      <a class="back" href="/">← PointCast</a>
      <p class="eyebrow">CH.FD · FIELD GUIDE · 29 SEP 2026</p>
      <h1>Put your agent<br />to useful work.</h1>
      <p class="dek">The PointCast Agent Field Guide. Pick the job, choose the tool, check the result.</p>
      <p class="byline">Written and researched by Codex · Directed by Mike Hoydich · 10 minute read</p>
      <div class="actions"><a href="#ready-to-use-task-briefs">Try a task ↓</a><a href="/connectors">Connect your assistant →</a><a href="/agent-field-guide.json">Read as JSON</a></div>
    </header>
    <nav class="contents" aria-label="Guide contents"><p>IN THIS GUIDE</p><ol>{headings.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
    <article class="guide-copy"><Content /></article>
    <footer class="guide-end"><strong>One useful result is a good start.</strong><p>Try a task with the assistant you already have. Keep the sources. Count the corrections.</p><a href="/b/0642">Publication record № 0642 →</a></footer>
  </main>
</BlockLayout>
<style>
  .field-guide{max-width:1060px;margin:0 auto;padding:32px 24px 120px;color:#182c32}
  header{border-top:8px solid #185fa5;padding:24px 0 32px}.back{font-weight:650;text-decoration:none}.eyebrow,.byline,.contents>p{font-family:var(--font-mono,monospace);font-size:12px;line-height:1.7}.eyebrow{margin-top:36px;letter-spacing:.06em;color:#185fa5}h1{font-size:clamp(42px,7vw,80px);line-height:1.04;letter-spacing:-.05em;margin:16px 0 24px}.dek{font-size:clamp(20px,3vw,27px);line-height:1.45;max-width:700px}.byline{color:#4c6067;max-width:650px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.actions a{padding:12px 16px;border:1px solid #185fa5;font-weight:650;text-decoration:none}.actions a:first-child{background:#185fa5;color:white}.contents{background:#eff5f8;padding:22px 26px;border-left:4px solid #185fa5;margin-bottom:40px}.contents>p{font-weight:700;margin:0 0 12px}.contents ol{columns:2;gap:32px;padding-left:20px;margin:0}.contents li{padding:5px 0;break-inside:avoid}.contents a{line-height:1.5}.guide-copy{font-size:17px;line-height:1.75;overflow-wrap:anywhere}.guide-copy :global(p),.guide-copy :global(ul),.guide-copy :global(ol){max-width:760px}.guide-copy :global(h2){font-size:clamp(26px,4vw,36px);letter-spacing:-.035em;line-height:1.2;margin:56px 0 24px;padding-top:24px;border-top:1px solid #c6d6de;scroll-margin-top:24px}.guide-copy :global(h3){font-size:23px;line-height:1.3;margin:32px 0 16px;scroll-margin-top:24px}.guide-copy :global(a),.contents a,.back,.guide-end a{color:#135e98;text-underline-offset:3px}.guide-copy :global(blockquote){margin:24px 0;padding:20px 24px;background:#f0f7ef;border-left:4px solid #517c3d;max-width:800px}.guide-copy :global(blockquote p){margin:0}.guide-copy :global(table){width:100%;border-collapse:collapse;font-size:14px;line-height:1.6;margin:26px 0;table-layout:fixed}.guide-copy :global(th),.guide-copy :global(td){text-align:left;vertical-align:top;padding:14px 12px;border:1px solid #c6d6de;overflow-wrap:anywhere}.guide-copy :global(th){background:#e7f0f7}.guide-copy :global(tr:nth-child(even)){background:#f7fafb}.guide-copy :global(li){margin:8px 0}.guide-end{margin-top:56px;border-top:4px solid #185fa5;padding-top:26px;font-size:19px;line-height:1.6}a:focus-visible{outline:3px solid #c26b1e;outline-offset:4px}
  @media(max-width:600px){.field-guide{padding:20px 18px 100px}.contents ol{columns:1}.guide-copy{font-size:16px}.guide-copy :global(table){display:block;overflow-x:auto;table-layout:auto}.guide-copy :global(th),.guide-copy :global(td){min-width:160px}.guide-copy :global(blockquote){padding:18px;margin-inline:0}.actions a{font-size:14px}}
</style>
