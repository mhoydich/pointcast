---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/dispensary-atlas.css';
import data from '../data/dispensary-atlas.json';
import { projectPoint } from '../lib/dispensary-atlas.mjs';
const active = data.stores.filter(s => s.licenseStatus === 'Active');
const source = id => data.sources.find(s => s.id === id);
const initialStore = active.find(s => s.profile) ?? active[0];
const jurisdictions = [...new Set(data.stores.map(s => s.jurisdiction))].sort();
const brands = [...new Set(data.products.map(p => p.brand))].sort();
const categories = [...new Set(data.products.map(p => p.category))].sort();
const productStores = data.profiles.filter(s => data.products.some(p => p.storeId === s.id));
const sales = data.economics.sales;
const maxSales = Math.max(...sales.points.map(p => p.value));
const escapedData = JSON.stringify(data).replace(/</g,'\\u003c');
const activeCounts = [...new Set(active.map(s=>s.jurisdiction))].map(name=>({name,count:active.filter(s=>s.jurisdiction===name).length})).sort((a,b)=>b.count-a.count);
const displayPrice = p => p.priceUsd == null ? 'Not observed' : new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(p.priceUsd);
---
<!DOCTYPE html>
<html lang="en">
 <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#193c32"/><title>El Segundo Dispensary Atlas · PointCast</title><meta name="description" content="A sourced 25-mile El Segundo cannabis retail field atlas: license geography, a limited public product sample, municipal case studies and California-to-national economics."/><link rel="canonical" href="https://pointcast.xyz/dispensary-atlas"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/json" href="/dispensary-atlas.json" title="Research snapshot"/><meta property="og:title" content="El Segundo Dispensary Atlas · PointCast"/><meta property="og:description" content="License geography, observed assortment and the economics of a fragmented market. An informational research atlas."/><meta property="og:type" content="website"/><meta property="og:url" content="https://pointcast.xyz/dispensary-atlas"/></head>
 <body>
  <a class="skip" href="#atlas">Skip to the atlas</a>
  <div class="shell" data-atlas>
   <header class="masthead"><a class="brand" href="/"><svg viewBox="0 0 30 30" fill="none" aria-hidden="true"><circle cx="15" cy="15" r="13" stroke="currentColor"/><circle cx="15" cy="15" r="7" stroke="currentColor"/><path d="M15 0v30M0 15h30" stroke="currentColor"/></svg>PointCast <span class="mono">/ Field Studies</span></a><nav aria-label="Atlas sections"><a href="#atlas">The map</a><a href="#products">Products</a><a href="#outlook">Outlook</a><a href="#method">Sources</a></nav></header>
   <main>
    <section class="hero" aria-labelledby="title"><div><p class="eyebrow">El Segundo · 25-mile field atlas · Edition 01</p><h1 id="title">A market drawn<br/>by its edges.</h1><p class="dek">Cannabis retail across coastal Los Angeles. Follow the licenses, examine a small public assortment sample, and read the forces shaping the business.</p><div class="hero-actions"><a href="#atlas" class="button-link">Explore the field ↓</a><a href="#outlook" class="button-link secondary">Read the outlook ↗</a></div></div><figure><img src="/images/dispensary-atlas/coastal-retail.webp" width="1536" height="1024" alt="Original cut-paper illustration of a coastal city layered with mineral green and rust circles." fetchpriority="high"/><figcaption class="caption">Original generated editorial artwork · abstract geography, separate from the measured map below.</figcaption></figure></section>
    <div class="edition-line mono"><span>Research checked 03 October 2026</span><span>City Hall → WGS84 geodesic radius</span><span>Information only · no live stock feed</span></div>
    <div class="stats" aria-label="Edition coverage"><div class="stat"><strong>{active.length}</strong><span>DCC Active retailer license records</span></div><div class="stat"><strong>25 mi</strong><span>Shortest surface distance from City Hall</span></div><div class="stat"><strong>{data.products.filter(p=>p.evidenceType==='public_menu_listing').length}</strong><span>Sampled public menu listings</span></div><div class="stat"><strong>{productStores.length}</strong><span>Retailers with named product observations</span></div></div>
    <section id="atlas" aria-labelledby="atlas-title"><div class="section-head"><div><p class="eyebrow">01 / Licensed geography</p><h2 id="atlas-title">The shape of access.</h2></div><p>Default: Active retailer licenses in the DCC location snapshot. A license permits activity at a premises; it does not confirm a store is open today.</p></div>
     <form class="filters" data-store-filters role="search" aria-label="Filter license records"><label for="store-q">Find a name, address or license<input id="store-q" name="q" type="search" placeholder="e.g. Hawthorne, C10, Lincoln" maxlength="160"/></label><label for="jurisdiction">Municipal jurisdiction<select id="jurisdiction" name="jurisdiction"><option value="">All recorded jurisdictions</option>{jurisdictions.map(j=><option value={j}>{j}</option>)}</select></label><label for="license-status">License status<select id="license-status" name="status"><option value="Active">Active</option><option value="all">All statuses / history</option>{[...new Set(data.stores.map(s=>s.licenseStatus))].filter(s=>s!=='Active').sort().map(s=><option value={s}>{s}</option>)}</select></label></form>
     <div class="map-grid"><div class="map-panel"><div class="map-top"><span class="mono">North ↑ / geodesic distance field</span><div class="map-tools"><button type="button" data-zoom="in" aria-label="Zoom map in">＋</button><button type="button" data-zoom="out" aria-label="Zoom map out">−</button><button type="button" data-zoom="reset">Reset</button></div></div><div class="map-viewport"><svg viewBox="0 0 760 760" data-map aria-hidden="true"><defs><pattern id="atlas-grid" width="38" height="38" patternUnits="userSpaceOnUse"><path d="M38 0H0V38" stroke="#cad1bf" fill="none" stroke-width=".7"/></pattern><clipPath id="atlas-boundary"><circle cx="380" cy="380" r="326.8"/></clipPath></defs><rect width="760" height="760" fill="url(#atlas-grid)"/><circle cx="380" cy="380" r="326.8" fill="#dce4d2" fill-opacity=".55" stroke="#466e50" stroke-width="2"/><circle class="map-ring" cx="380" cy="380" r="130.72"/><circle class="map-ring" cx="380" cy="380" r="261.44"/><path class="map-gridline" d="M380 45v670M45 380h670"/><text class="map-label" x="390" y="258">10 mi</text><text class="map-label" x="390" y="128">20 mi</text><text class="map-label" x="390" y="42">25 mi / N</text><text class="map-label" x="40" y="370">W</text><text class="map-label" x="712" y="370">E</text><text class="map-label" x="374" y="731">S</text><g clip-path="url(#atlas-boundary)">{data.stores.map(s=>{const p=projectPoint(s,data.center);return p&&<circle class="map-pin" data-pin={s.id} data-format={s.format} cx={p.x} cy={p.y} r="4.3" hidden={s.licenseStatus!=='Active'}><title>{s.name} · {s.licenseNumber} · {s.distanceMiles.toFixed(2)} mi</title></circle>})}</g><circle class="map-center" cx="380" cy="380" r="7"/><text class="map-label" x="394" y="402">El Segundo City Hall</text></svg></div><div class="map-bottom"><div class="legend"><span><i></i>Filtered retailer license records</span><span>◎ City Hall address point</span></div><span>North up. Basemap-free geodesic projection; radial distance is measured. Select a record below for a keyboard alternative to clicking a point.</span></div></div>
     <aside class="store-detail" aria-label="Selected license record"><label for="map-record">Inspect a filtered license record<select id="map-record" data-map-record>{active.map(s=><option value={s.id} selected={s.id===initialStore.id}>{s.name} — {s.licenseNumber}</option>)}</select></label><div data-record-detail><h3 data-detail-name>{initialStore.name}</h3><span class="badge" data-detail-status>{initialStore.licenseStatus} license</span><p class="license" data-detail-license>{initialStore.licenseNumber}</p><dl><dt>Premises</dt><dd data-detail-address>{initialStore.address}</dd><dt>Jurisdiction</dt><dd data-detail-jurisdiction>{initialStore.jurisdiction}</dd><dt>Distance</dt><dd data-detail-distance>{initialStore.distanceMiles.toFixed(2)} geodesic miles</dd><dt>Designation</dt><dd data-detail-designation>{initialStore.designation}</dd><dt>Coordinates</dt><dd data-detail-coordinates>{initialStore.lat}, {initialStore.lon}</dd></dl><p class="detail-note" data-detail-note>{initialStore.profile?.coverage ?? 'Registry record only. Operating hours, current assortment and store revenue are not independently established.'}</p><div class="detail-source"><a data-detail-registry href={initialStore.registryUrl} target="_blank" rel="noopener noreferrer">DCC license record ↗</a><a data-detail-menu href={initialStore.profile?.menuUrl??initialStore.registryUrl} hidden={!initialStore.profile?.menuUrl} target="_blank" rel="noopener noreferrer">Public menu source ↗</a></div></div><p class="caption">Registry refresh: {data.registryRefreshedAt} (timezone unspecified). Checked {data.checkedOn}. Mailing-city labels may differ from municipal jurisdiction.</p></aside></div>
     <p class="notice">This snapshot contains {data.stores.length} retailer license records, including inactive history. License records are not a count of distinct operating shops: co-located and successor licenses can overlap. Non-storefront delivery businesses are outside the endpoint’s coverage; {data.excludedMicrobusinessCount} mapped microbusiness records are excluded pending activity/format review. Unknown coordinates cannot be assigned to the radius. <a href="#method">See coverage and method.</a></p>
     <div class="subhead"><p id="store-count" role="status" aria-live="polite" data-store-count>{active.length} active license records</p><button type="button" data-share>Share these filters ↗</button></div><div class="share-box" data-share-box hidden><label for="share-link">Copy this filtered atlas URL<input id="share-link" readonly data-share-url/></label><p class="status">The link includes search/filter text only.</p></div>
     <noscript><p>JavaScript is disabled: the map shows Active licenses; the table below lists all {data.stores.length} statuses and history. Filters and inspection controls need JavaScript; DCC source links and the downloadable snapshot remain available.</p></noscript><div class="table-wrap" tabindex="0" role="region" aria-label="License record list; scroll horizontally on small screens"><table><caption class="caption">DCC retailer record list · keyboard and map-independent alternative</caption><thead><tr><th scope="col">Business / registry record</th><th scope="col">Jurisdiction</th><th scope="col">Distance</th><th scope="col">Status</th><th scope="col">Evidence</th></tr></thead><tbody>{data.stores.map(s=><tr data-store-row={s.id}><td><button type="button" data-inspect={s.id}>{s.name}</button><small>{s.address}<br/>{s.licenseNumber}</small></td><td>{s.jurisdiction}<small>{s.jurisdictionNote??''}</small></td><td>{s.distanceMiles.toFixed(2)} mi</td><td>{s.licenseStatus}<small>{s.designation}</small></td><td><a href={s.registryUrl} target="_blank" rel="noopener noreferrer">DCC ↗</a><small>{s.profile?'Operator also researched':'Registry only'}</small></td></tr>)}</tbody></table></div><div class="pagination" data-pagination><button type="button" data-page="previous">← Previous</button><span data-page-label>License record pages</span><button type="button" data-page="next">Next →</button></div><p class="empty" data-store-empty hidden>No license records match these filters. Clear the search or choose another status.</p>
    </section>
    <section id="products" aria-labelledby="products-title"><div class="section-head"><div><p class="eyebrow">02 / Observed assortment</p><h2 id="products-title">A small shelf, in focus.</h2></div><p>Search the products we could actually observe in public text. Each row keeps its source and freshness. No full-inventory or in-stock claim is made.</p></div><form class="filters products-filters" data-product-filters role="search" aria-label="Search observed product sample"><label for="product-q">Search the observed sample<input id="product-q" name="pq" type="search" placeholder="Product, brand or category" maxlength="160"/></label><label for="product-brand">Brand<select id="product-brand" name="brand"><option value="">All sampled brands</option>{brands.map(b=><option value={b}>{b}</option>)}</select></label><label for="product-category">Category<select id="product-category" name="category"><option value="">All sampled categories</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><label for="product-store">Retailer<select id="product-store" name="store"><option value="">All sampled retailers</option>{productStores.map(s=><option value={s.id}>{s.name}</option>)}</select></label></form><p class="product-count" data-product-count role="status" aria-live="polite">{data.products.length} observations · {data.checkedOn}</p><div class="product-grid">{data.products.map(p=><article class="product-card" data-product={p.id}><span class="badge">{p.category}</span><h3>{p.name}</h3><p class="product-brand">{p.brand}</p><div class="product-meta"><span>{p.size??'Size not stated'}</span><span class="price">{displayPrice(p)}</span></div><div class="product-source"><a href={p.sourceUrl} target="_blank" rel="noopener noreferrer">{data.profiles.find(s=>s.id===p.storeId)?.name} · source ↗</a><p>{p.evidenceType==='public_menu_listing'?'Menu listing':'Featured product mention'} · checked {p.observedOn}<br/>Reader freshness: {p.readerCrawlAge}. Price tax basis: {p.taxBasis}. {p.priceNote??''}</p></div></article>)}</div><p class="empty" data-product-empty hidden>No sampled products match. This says nothing about a store’s full inventory.</p><p class="notice">Menu observation ≠ guaranteed stock or current price. Public text may be cached, and independent checks can return different listings or promotions. Pottery observations are editorial product features with no observed price. Sweet Flower’s age gate was left unaccepted; missing menu widgets were not bypassed. Source links are research references; this atlas has no ordering or transaction flow.</p><details><summary>Operator assortment and access coverage</summary><div class="table-wrap"><table><thead><tr><th>Operator</th><th>Observed categories</th><th>Coverage / gaps</th><th>Sources</th></tr></thead><tbody>{data.profiles.map(p=><tr><td>{p.name}</td><td>{p.observedCategories.join(', ')||'No SKU sample'}</td><td>{p.coverage}</td><td><a href={p.informationalUrl} target="_blank" rel="noopener noreferrer">Official page ↗</a></td></tr>)}</tbody></table></div></details></section>
    <section class="outlook" id="outlook" aria-labelledby="outlook-title"><div class="section-head"><div><p class="eyebrow">03 / Local → California → national</p><h2 id="outlook-title">Access is local.<br/>The pressures are larger.</h2></div><p>Published figures with their units and periods. Store sales remain undisclosed; a menu cannot reveal revenue.</p></div><div class="economy-grid"><div class="chart"><h3>{sales.title}</h3><p>{sales.description}</p><div class="bars" role="img" aria-label={sales.points.map(p=>`${p.period}: ${p.value} ${sales.unit}`).join('; ')}>{sales.points.map(p=><div class="bar-group"><strong>{p.display??p.value.toFixed(2)}</strong><div class="bar" style={`height:${p.value/maxSales*140}px`}></div><span>{p.period}</span></div>)}</div><p>{sales.unit} · {sales.basis}</p><a href={source(sales.sourceId).url} target="_blank" rel="noopener noreferrer">{source(sales.sourceId).title} ↗</a><details><summary>Read the chart as a table</summary><table><thead><tr><th>Period</th><th>Value ({sales.unit})</th></tr></thead><tbody>{sales.points.map(p=><tr><td>{p.period}</td><td>{p.value}</td></tr>)}</tbody></table></details></div><div class="outlook-notes">{data.economics.notes.map(n=><article class="outlook-note"><span class="badge">{n.kind}</span><h3>{n.title}</h3><p>{n.text}</p><p>{n.sourceIds.map(id=><a href={source(id).url} target="_blank" rel="noopener noreferrer">{source(id).title} ↗ </a>)}</p></article>)}</div></div><details><summary>Local registry concentration, without inferring demand</summary><table><thead><tr><th>Recorded jurisdiction</th><th>Active retailer license records</th></tr></thead><tbody>{activeCounts.map(j=><tr><td>{j.name}</td><td>{j.count}</td></tr>)}</tbody></table><p>DCC radius-filtered snapshot. These counts describe licenses, not sales, demand, unique shops or operating capacity.</p></details></section>
    <section aria-labelledby="cases-title"><div class="section-head"><div><p class="eyebrow">04 / Business case studies</p><h2 id="cases-title">Three ways to read the field.</h2></div><p>Compare jurisdiction, retail format and assortment evidence. Interpretations are separated from the underlying facts.</p></div><div class="cases">{data.caseStudies.map((c,i)=><article class="case"><span class="case-number">0{i+1}</span><h3>{c.title}</h3><p>{c.fact}</p><p><strong>Business reading:</strong> {c.interpretation}</p><p><strong>What is missing:</strong> {c.missing}</p><p>{c.sourceIds.map(id=><a href={source(id).url} target="_blank" rel="noopener noreferrer">{source(id).title} ↗ </a>)}</p></article>)}</div></section>
    <section id="national" aria-labelledby="national-title"><div class="section-head"><div><p class="eyebrow">05 / National context</p><h2 id="national-title">One country, different markets.</h2></div><p>Selected current official programme examples and dated federal context. This edition is not a 50-state legal census; hemp and dispensary sales have separate definitions.</p></div><div class="cases">{data.economics.nationalContext.map(c=><article class="case"><span class="badge">{c.type==='selected_state_example'?'Selected state example':'Dated official context'}</span><h3>{c.title}</h3><p>{c.body}</p><p>{c.sourceIds.map(id=><a href={source(id).url} target="_blank" rel="noopener noreferrer">{source(id).title} ↗ </a>)}</p></article>)}</div></section>
    <section class="sources" id="method" aria-labelledby="method-title"><div><p class="eyebrow">06 / Evidence desk</p><h2 id="method-title">Know what<br/>you are seeing.</h2><p>An educational first edition, built from public records and a deliberately limited product sample. Every downloaded row carries provenance.</p><ol class="method-list">{data.methodology.map(m=><li>{m}</li>)}</ol><h3>Remaining coverage gaps</h3><ul class="coverage-list">{data.coverageGaps.map(m=><li>{m}</li>)}</ul><a class="button-link secondary" href="/dispensary-atlas.json" download="pointcast-dispensary-atlas-2026-10-03.json">Download dated JSON snapshot ↓</a><p class="caption">No owner names, personal contacts, accounts or private business data are included.</p></div><div><h3>Public source register</h3><ol class="source-list">{data.sources.map((s,i)=><li id={`source-${s.id}`}><span class="mono">{String(i+1).padStart(2,'0')} / {s.publisher??'Public source'}</span><br/><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><small>Checked {s.checkedOn??data.checkedOn}{s.readerCrawlAge?` · reader crawl: ${s.readerCrawlAge}`:''}{s.note?` · ${s.note}`:''}</small></li>)}</ol></div></section>
   </main><footer class="footer"><span>PointCast / El Segundo Dispensary Atlas · 2026</span><p>Public evidence. Clear limits. Information only.</p><a href="/">Back to PointCast ↗</a></footer><noscript><p>The full license list, sampled products, charts, sources and snapshot remain readable. Enable JavaScript to filter, inspect map records and share filters. The map defaults to Active licenses; the full table also contains inactive history.</p></noscript>
  </div><script id="atlas-data" type="application/json" set:html={escapedData}></script><script>import '../scripts/dispensary-atlas';</script>
 </body>
</html>
