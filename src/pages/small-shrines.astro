---
import BlockLayout from '../layouts/BlockLayout.astro';
import { SHRINES } from '../data/small-shrines';
import '../styles/small-shrines.css';
const description = 'Four small places to pause. Original artwork, Michael Hoydich’s Midjourney studies, one-minute meditations, and optional quiet sound.';
---
<BlockLayout title="Small Shrines · Four places to pause" description={description} author="Codex · directed by Michael Hoydich" creator="PointCast" image="/images/small-shrines/ocean.webp" imageAlt={SHRINES[0].alt} imageWidth={1536} imageHeight={1024} themeColor="#eeece3" immersive alternates={[{ type: 'application/json', href: '/small-shrines.json', title: 'Small Shrines: meditations and artwork sources' }]} jsonLd={{'@context':'https://schema.org','@type':'WebApplication',name:'Small Shrines',url:'https://pointcast.xyz/small-shrines/',description,applicationCategory:'LifestyleApplication',isAccessibleForFree:true}}>
  <div class="ss" id="small-shrines">
    <nav class="ss-top" aria-label="Return navigation"><a href="/">← PointCast</a><span>Collection 01 / Four small places</span><a href="/shrines">All shrines ↗</a></nav>
    <header class="ss-header"><div><p class="ss-eyebrow">A minute, freely given</p><h1>Small <em>Shrines.</em></h1></div><p>Somewhere to rest your attention.<br />Nothing to achieve. Nothing to keep up with.</p></header>
    <nav class="ss-doors" aria-label="Choose a shrine">
      {SHRINES.map(room => <a href={`#${room.id}`} data-door={room.id}><img src={room.image} alt="" width="80" height="64" loading="lazy"/><span><small>{room.number} / Enter</small><strong>{room.title}</strong></span><span aria-hidden="true">↗</span></a>)}
    </nav>
    <div class="ss-gallery">
      {SHRINES.map((room,index) => <section class="ss-room" id={room.id} data-room={room.id} aria-labelledby={`${room.id}-title`}>
        <figure class:list={['ss-art', {'ss-art--square': room.id === 'garden' || room.id === 'memory'}]} style={`--room-color:${room.color}`}>
          <img src={room.image} alt={room.alt} width="1536" height="1024" loading={index ? 'lazy' : 'eager'} fetchpriority={index ? 'auto' : 'high'} decoding="async"/>
          <figcaption><span>{room.credit}</span>{room.sourceUrl && <a href={room.sourceUrl} target="_blank" rel="noopener noreferrer">View source ↗</a>}</figcaption>
        </figure>
        <div class="ss-reading">
          <p class="ss-eyebrow">{room.number} / {room.kicker}</p><h2 id={`${room.id}-title`} tabindex="-1">{room.title}</h2>
          <p class="ss-invitation">{room.invitation}</p><p class="ss-focus"><span>Look here</span>{room.focus}</p>
          <div class="ss-cue" role="status" aria-live="polite" aria-atomic="true"><span class="ss-phase">{room.phases[0].label}</span><p>{room.phases[0].text}</p></div>
          <details class="ss-transcript"><summary>Read the whole meditation</summary>{room.phases.map(phase=><p><strong>{phase.label}.</strong> {phase.text}</p>)}</details>
        </div>
      </section>)}
    </div>
    <section class="ss-practice" aria-label="Meditation and sound controls">
      <div class="ss-minute"><div class="ss-minute-top"><span class="ss-eyebrow">Stay for a minute</span><output id="ss-time" role="timer" aria-live="off" aria-label="Time remaining">1:00</output></div><progress id="ss-progress" max="60" value="0" aria-label="Meditation progress"></progress><div class="ss-actions"><button id="ss-begin" class="ss-primary" disabled>Begin a minute <span aria-hidden="true">→</span></button><button id="ss-end" disabled>End pause</button></div><p id="ss-timer-status" role="status">Eyes open is welcome. Breathe in your own way. Leave whenever you like.</p></div>
      <div class="ss-sound"><div class="ss-minute-top"><label class="ss-eyebrow" for="ss-sound-mode">A little atmosphere</label><span class="ss-sound-dot" aria-hidden="true"></span></div><div class="ss-sound-row"><select id="ss-sound-mode" disabled><option value="tide">Tide · soft water</option><option value="drone">Warm drone · held notes</option><option value="bowl">Bowl · slow chimes</option><option value="pulse">Soft pulse · quiet drum</option></select><button id="ss-listen" disabled>Listen</button><button id="ss-stop" disabled>Stop</button></div><div class="ss-volume-row"><label for="ss-volume">Volume</label><input id="ss-volume" type="range" min="0" max="100" value="25" disabled/><button id="ss-mute" aria-pressed="false" disabled>Mute</button></div><p id="ss-audio-status" role="status">Sound is off. Listening is optional.</p></div>
    </section>
    <noscript><p class="ss-noscript">All four meditations are available above. Interactive timing and optional sound need JavaScript; you can read at your own pace.</p></noscript>
    <footer class="ss-footer"><p>A secular collection of small pauses. Original meditations by Codex, directed by Michael Hoydich. Ocean and Night were generated for this collection; Garden and Memory come from Michael’s existing Midjourney profile. Shrine names are editorial labels.</p><p>Sound is synthesized in your browser. No recording, account, or autoplay. <a href="/small-shrines.json">Sources &amp; full text ↗</a></p><div><a href="/">Return to PointCast →</a><a href="/elemental-shrine">Visit Elemental Shrine ↗</a></div></footer>
  </div>
</BlockLayout>
<script>
  import { initializeSmallShrines } from '../lib/small-shrines-client';
  initializeSmallShrines();
  document.addEventListener('astro:page-load', initializeSmallShrines);
</script>
