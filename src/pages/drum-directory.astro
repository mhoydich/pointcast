---
import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';
import {
  DRUM_DIRECTORY_CHAPTERS,
  DRUM_DIRECTORY_COUNTS,
  DRUM_DIRECTORY_ENTRIES,
  DRUM_DIRECTORY_META,
  DRUM_RUNNER_EDITIONS,
  entriesForChapter,
  type DrumDirectoryChapter,
} from "../lib/drum-directory";

const description = DRUM_DIRECTORY_META.description;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${DRUM_DIRECTORY_META.canonical}#article`,
      headline: DRUM_DIRECTORY_META.title,
      alternativeHeadline: DRUM_DIRECTORY_META.issue,
      description,
      url: DRUM_DIRECTORY_META.canonical,
      datePublished: DRUM_DIRECTORY_META.publishedAt,
      dateModified: DRUM_DIRECTORY_META.publishedAt,
      image: `https://pointcast.xyz${DRUM_DIRECTORY_META.generatedPlates[0].path}`,
      author: [
        { "@type": "Person", name: "Michael Hoydich" },
        { "@type": "Organization", name: "PointCast" },
      ],
      publisher: { "@type": "Organization", name: "PointCast", url: "https://pointcast.xyz" },
      mainEntity: { "@id": `${DRUM_DIRECTORY_META.canonical}#directory` },
    },
    {
      "@type": "ItemList",
      "@id": `${DRUM_DIRECTORY_META.canonical}#directory`,
      name: "PointCast drum games, rooms, and playable oddities",
      numberOfItems: DRUM_DIRECTORY_ENTRIES.length,
      itemListElement: DRUM_DIRECTORY_ENTRIES.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "VideoGame",
          name: entry.name,
          description: entry.description,
          url: `https://pointcast.xyz${entry.path}`,
          gamePlatform: "Web browser",
        },
      })),
    },
  ],
};
---

<BlockLayout
  title={`${DRUM_DIRECTORY_META.title} · ${DRUM_DIRECTORY_META.issue}`}
  description={description}
  image={DRUM_DIRECTORY_META.generatedPlates[0].path}
  imageWidth={1536}
  imageHeight={1024}
  jsonLd={jsonLd}
  alternates={[
    {
      type: "application/json",
      href: "/drum-directory.json",
      title: "PointCast Drum Directory JSON",
    },
  ]}
>
  <article class="pdd" data-drum-directory>
    <div class="pdd__utility">
      <div class="pdd__utility-inner">
        <DrumNav current="directory" />
        <div class="pdd__issue-line">
          <span>POINTCAST SPECIAL ISSUE</span>
          <span>{DRUM_DIRECTORY_META.publishedAt}</span>
          <span>{DRUM_DIRECTORY_COUNTS.described} DESCRIBED</span>
          <a href="/drum-directory.json">JSON EDITION ↗</a>
        </div>
      </div>
      <span class="pdd__progress" data-progress aria-hidden="true"></span>
    </div>

    <header class="pdd__cover">
      <img
        src={DRUM_DIRECTORY_META.generatedPlates[0].path}
        alt={DRUM_DIRECTORY_META.generatedPlates[0].alt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="pdd__cover-shade" aria-hidden="true"></div>
      <div class="pdd__cover-topline">
        <span>THE BIG BEAT ISSUE</span>
        <span>VOL. 01 / EL SEGUNDO</span>
      </div>
      <div class="pdd__cover-copy">
        <p class="pdd__cover-kicker">GAMES · ROOMS · RACES · BELLS · NOUNS</p>
        <h1><span>THE POINTCAST</span> DRUM DIRECTORY</h1>
        <p class="pdd__cover-dek">
          A field guide to the little browser arcade that turned into a music house, a civic hall,
          a television league, and one very long loop.
        </p>
        <div class="pdd__cover-actions">
          <a href="#the-five">Enter the issue</a>
          <button type="button" data-surprise>Surprise me</button>
        </div>
      </div>
      <p class="pdd__cover-credit">Original generator-made PointCast plate · “The House Kit”</p>
    </header>

    <div class="pdd__paper">
      <section class="pdd__standfirst">
        <div class="pdd__standfirst-lead">
          <p class="pdd__folio">EDITOR'S NOTE / 001</p>
          <p class="pdd__big-lede">
            It began with a single drum button. Then the button acquired neighbors, memory,
            a score, a room, a television schedule, a few Nouns, and something suspiciously like civic life.
          </p>
        </div>
        <div class="pdd__intro-copy">
          <p>
            <span class="pdd__dropcap">P</span>ointCast has too many drum pages for a normal menu.
            That is not a complaint. It is the whole character of the place. New ideas arrive as
            playable rooms instead of product requirements: a relay where strangers leave three taps,
            a cake the room lights together, a race controlled by every instrument in town.
          </p>
          <p>
            The formal arcade contains five clean games. Around it sits a larger house of hybrids:
            score games, social instruments, television sports, Nouns leagues, birthday rituals,
            and objects that become interesting the moment somebody touches them. This directory
            describes all of those things on their own terms.
          </p>
          <p>
            The visual plates are original generator-made editorial art. The play images are captured
            from the real browser games. Every title links to the actual surface; no install, wallet,
            or account is required for the core set.
          </p>
        </div>
        <aside class="pdd__contents" aria-label="Issue contents">
          <p class="pdd__folio">IN THIS ISSUE</p>
          <ol>
            {DRUM_DIRECTORY_CHAPTERS.map((chapter) => (
              <li>
                <a href={`#${chapter.id}`}>
                  <span>{chapter.number}</span>
                  <strong>{chapter.kicker}</strong>
                </a>
              </li>
            ))}
            <li>
              <a href="#runner-history">
                <span>+7</span>
                <strong>BEAT RUNNER ARCHIVE</strong>
              </a>
            </li>
          </ol>
          <div class="pdd__contents-noun" aria-hidden="true">
            <img src="https://noun.pics/137.svg" alt="" width="118" height="118" />
          </div>
        </aside>
      </section>

      <section class="pdd__thesis" aria-labelledby="thesis-title">
        <div>
          <p class="pdd__folio">THE MAGAZINE TEST</p>
          <h2 id="thesis-title">What counts as a game in a town made of buttons?</h2>
        </div>
        <div class="pdd__thesis-columns">
          <p>
            A strict answer would keep only the five house tests: each has a beginning, a rule,
            a score, and a clean replay. A useful answer is wider. If a page gives your body a
            rule and the next thirty seconds feel different because of it, PointCast calls that play.
          </p>
          <p>
            That is why a pendulum belongs beside a tap race. The race asks how fast you can act.
            The pendulum asks whether you can resist acting again. One produces a winner; the other
            produces a room in which thirty seconds of decay suddenly matter.
          </p>
          <p>
            The connecting material is the drum bus: a shared event stream that lets a tiny bell
            on one page count as forward motion in a race on another. The architecture does not
            separate game, instrument, audience, and scoreboard as neatly as a platform store would.
            It lets them leak into one another.
          </p>
        </div>
        <dl class="pdd__numbers">
          <div><dt>Formal house tests</dt><dd>5</dd></div>
          <div><dt>Runner editions</dt><dd>{DRUM_DIRECTORY_COUNTS.runnerEditions}</dd></div>
          <div><dt>Nouns chapter</dt><dd>{DRUM_DIRECTORY_COUNTS.nounGames}</dd></div>
          <div><dt>Shared + TV</dt><dd>{DRUM_DIRECTORY_COUNTS.sharedGames}</dd></div>
          <div><dt>Account required</dt><dd>0</dd></div>
        </dl>
      </section>

      {DRUM_DIRECTORY_CHAPTERS.map((chapter, chapterIndex) => {
        const entries = entriesForChapter(chapter.id as DrumDirectoryChapter);
        return (
          <section
            class:list={[
              "pdd__chapter",
              `pdd__chapter--${chapter.id}`,
              { "pdd__chapter--first": chapterIndex === 0 },
            ]}
            id={chapter.id}
            aria-labelledby={`${chapter.id}-title`}
          >
            {chapter.id === "nouns" && (
              <figure class="pdd__plate pdd__plate--wide">
                <img
                  src={DRUM_DIRECTORY_META.generatedPlates[1].path}
                  alt={DRUM_DIRECTORY_META.generatedPlates[1].alt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
                <figcaption>
                  <span>PLATE 02</span>
                  <strong>Nouns on the Night Shift</strong>
                  <em>Original generator-made PointCast editorial art.</em>
                </figcaption>
              </figure>
            )}

            <header class="pdd__chapter-head">
              <span class="pdd__chapter-number">{chapter.number}</span>
              <div>
                <p>{chapter.kicker}</p>
                <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
                <div class="pdd__chapter-rule"></div>
                <p class="pdd__chapter-dek">{chapter.description}</p>
              </div>
              <aside>
                <span>FIELD COUNT</span>
                <strong>{String(entries.length).padStart(2, "0")}</strong>
              </aside>
            </header>

            <div class="pdd__entry-list">
              {entries.map((entry, entryIndex) => (
                <article
                  class:list={[
                    "pdd__entry",
                    { "pdd__entry--feature": chapter.id === "the-five" },
                    { "pdd__entry--reverse": entryIndex % 2 === 1 },
                  ]}
                  id={entry.slug}
                  data-game-card
                  style={`--entry-accent:${entry.accent}`}
                >
                  <div class="pdd__entry-visual">
                    {entry.screenshot ? (
                      <a href={entry.path} class="pdd__shot">
                        <img
                          src={entry.screenshot}
                          alt={`${entry.name} browser game screen on PointCast.`}
                          width="1440"
                          height="960"
                          loading={chapter.id === "the-five" && entryIndex === 0 ? "eager" : "lazy"}
                        />
                        <span>OPEN GAME ↗</span>
                      </a>
                    ) : (
                      <a href={entry.path} class="pdd__noun-field" aria-label={`Open ${entry.name}`}>
                        {entry.nounId && (
                          <img
                            src={`https://noun.pics/${entry.nounId}.svg`}
                            alt=""
                            width="220"
                            height="220"
                            loading="lazy"
                          />
                        )}
                        <span class="pdd__noun-orbit" aria-hidden="true"></span>
                        <b>PLAY ↗</b>
                      </a>
                    )}
                  </div>

                  <div class="pdd__entry-copy">
                    <div class="pdd__entry-top">
                      <span>{String(entryIndex + 1).padStart(2, "0")}</span>
                      <p>{entry.eyebrow}</p>
                    </div>
                    <h3>{entry.name}</h3>
                    <p class="pdd__entry-description">{entry.description}</p>
                    <p class="pdd__entry-note">{entry.fieldNote}</p>
                    <dl class="pdd__entry-specs">
                      <div><dt>Players</dt><dd>{entry.players}</dd></div>
                      <div><dt>Time</dt><dd>{entry.duration}</dd></div>
                      <div><dt>Hands</dt><dd>{entry.controls}</dd></div>
                    </dl>
                    <div class="pdd__entry-foot">
                      <div class="pdd__tags">
                        {entry.tags.map((tag) => <span>{tag}</span>)}
                      </div>
                      <a href={entry.path}>PLAY {entry.name.toUpperCase()} <span>→</span></a>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            {chapter.id === "the-five" && (
              <section class="pdd__runner" id="runner-history" aria-labelledby="runner-title">
                <figure class="pdd__plate">
                  <img
                    src={DRUM_DIRECTORY_META.generatedPlates[2].path}
                    alt={DRUM_DIRECTORY_META.generatedPlates[2].alt}
                    width="1536"
                    height="1024"
                    loading="lazy"
                  />
                  <figcaption>
                    <span>CENTER SPREAD</span>
                    <strong>The Long Loop</strong>
                    <em>Seven Beat Runners in one original generator-made plate.</em>
                  </figcaption>
                </figure>
                <header class="pdd__runner-head">
                  <div>
                    <p class="pdd__folio">SEVEN EDITIONS / ONE RESTLESS IDEA</p>
                    <h2 id="runner-title">The road kept changing its mind.</h2>
                  </div>
                  <p>
                    Beat Runner is the clearest record of how PointCast designs in public. Each version
                    preserves a question the next version decided to answer differently.
                  </p>
                </header>
                <ol class="pdd__runner-list">
                  {DRUM_RUNNER_EDITIONS.map((edition) => (
                    <li style={`--runner-accent:${edition.accent}`}>
                      <a href={edition.path}>
                        <span class="pdd__runner-version">{edition.version}</span>
                        <div class="pdd__runner-title">
                          <strong>{edition.name}</strong>
                          <span>{edition.year}</span>
                        </div>
                        <p>{edition.premise}</p>
                        <p class="pdd__runner-note">{edition.fieldNote}</p>
                        <span class="pdd__runner-tempo">{edition.tempo}</span>
                        <span class="pdd__runner-arrow">↗</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </section>
        );
      })}

      <section class="pdd__closer" aria-labelledby="closer-title">
        <div class="pdd__closer-copy">
          <p class="pdd__folio">LAST PAGE / HOUSE RULE</p>
          <h2 id="closer-title">The best first move is still one tap.</h2>
          <p>
            Start with Drum Says if you want a proper game. Start with Drum Party V2 if you want
            the whole room at once. Start with Pendulum if you would rather listen to one decision
            finish happening.
          </p>
          <div>
            <a href="/drum-says">PLAY DRUM SAYS</a>
            <a href="/drum-room-v2">ENTER THE PARTY</a>
            <button type="button" data-surprise>SURPRISE ME</button>
          </div>
        </div>
        <div class="pdd__closer-noun" aria-hidden="true">
          <img src="https://noun.pics/385.svg" alt="" width="320" height="320" loading="lazy" />
          <span>⌐◨-◨</span>
        </div>
      </section>

      <footer class="pdd__footer">
        <div>
          <strong>THE POINTCAST DRUM DIRECTORY</strong>
          <span>{DRUM_DIRECTORY_META.issue} · {DRUM_DIRECTORY_META.publishedAt}</span>
        </div>
        <p>
          Direction and originating universe: Michael Hoydich. Editorial, implementation, generated
          plates, and browser captures: Codex / OpenAI. Nouns are CC0. PointCast is its own thing.
        </p>
        <nav aria-label="More PointCast play">
          <a href="/drum">Drum house</a>
          <a href="/drum-games">Five-game arcade</a>
          <a href="/win95-games">Windows 95 games</a>
          <a href="/play">Play layer</a>
          <a href="/drum-directory.json">JSON</a>
        </nav>
      </footer>
    </div>
  </article>
</BlockLayout>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-game-card]"));

  function surprise(): void {
    const card = cards[Math.floor(Math.random() * cards.length)];
    if (!card) return;
    card.scrollIntoView({ behavior: "smooth", block: "center" });
    card.classList.remove("is-picked");
    requestAnimationFrame(() => card.classList.add("is-picked"));
  }

  document.querySelectorAll<HTMLButtonElement>("[data-surprise]").forEach((button) => {
    button.addEventListener("click", surprise);
  });

  const progress = document.querySelector<HTMLElement>("[data-progress]");
  function updateProgress(): void {
    if (!progress) return;
    const height = document.documentElement.scrollHeight - window.innerHeight;
    const amount = height > 0 ? Math.min(1, Math.max(0, window.scrollY / height)) : 0;
    progress.style.transform = `scaleX(${amount})`;
  }
  updateProgress();
  window.addEventListener("scroll", updateProgress, { passive: true });
</script>

<style>
  :global(body:has(.pdd)) {
    margin: 0;
    background: #17130f;
    color: #17130f;
  }
  :global(body:has(.pdd) > footer) { display: none; }
  .pdd {
    --paper: #eee4d0;
    --paper-deep: #dfd0b6;
    --ink: #17130f;
    --red: #c83a2d;
    --gold: #d9a52e;
    --blue: #286d8c;
    --rule: rgba(23, 19, 15, .28);
    min-height: 100vh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .pdd a { color: inherit; }
  .pdd__utility {
    position: sticky;
    z-index: 50;
    top: 0;
    min-height: 52px;
    background: rgba(19, 16, 12, .96);
    color: #f4ead6;
    backdrop-filter: blur(14px);
  }
  .pdd__utility-inner {
    max-width: 1480px;
    min-height: 52px;
    margin: 0 auto;
    padding: 8px clamp(14px, 2.6vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }
  .pdd__utility :global(.drum-nav) { margin: 0; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
  .pdd__utility :global(.drum-nav__item) {
    flex: 0 0 auto;
    padding: 5px 8px;
    border-color: #4b4439;
    background: transparent;
    color: #aaa08f;
  }
  .pdd__utility :global(.drum-nav__item.is-active) { background: #f0e4cf; border-color: #f0e4cf; color: #17130f; }
  .pdd__issue-line {
    display: flex;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
    color: #b9ad99;
    font: 700 9px/1.2 "Courier New", monospace;
    letter-spacing: .13em;
  }
  .pdd__issue-line a { color: #f0c84f; text-decoration: none; }
  .pdd__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .pdd__cover {
    position: relative;
    min-height: min(900px, calc(100svh - 52px));
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    background: #261b12;
    color: #fff7e6;
  }
  .pdd__cover > img {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .pdd__cover-shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 9, 6, .93) 0%, rgba(13, 9, 6, .7) 38%, rgba(13, 9, 6, .05) 74%),
      linear-gradient(0deg, rgba(13, 9, 6, .78) 0%, transparent 55%);
  }
  .pdd__cover::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    opacity: .18;
    mix-blend-mode: multiply;
    background-image:
      repeating-linear-gradient(0deg, rgba(18, 12, 7, .2) 0 1px, transparent 1px 3px),
      radial-gradient(circle at center, transparent 50%, #130d08 130%);
  }
  .pdd__cover-topline {
    position: absolute;
    z-index: 3;
    top: 24px;
    left: clamp(18px, 4vw, 70px);
    right: clamp(18px, 4vw, 70px);
    display: flex;
    justify-content: space-between;
    padding-bottom: 11px;
    border-bottom: 1px solid rgba(255, 247, 230, .5);
    font: 700 10px/1.2 "Courier New", monospace;
    letter-spacing: .22em;
  }
  .pdd__cover-copy {
    position: relative;
    z-index: 3;
    min-width: 0;
    width: min(980px, 88vw);
    padding: 80px clamp(18px, 4vw, 70px) clamp(60px, 9vw, 120px);
  }
  .pdd__cover-kicker {
    margin: 0 0 16px;
    color: #f4cb54;
    font: 700 clamp(9px, 1.1vw, 13px)/1.2 "Courier New", monospace;
    letter-spacing: .22em;
  }
  .pdd__cover h1 {
    max-width: 1050px;
    margin: 0;
    font-size: clamp(64px, 10.7vw, 176px);
    line-height: .76;
    letter-spacing: -.085em;
    font-weight: 900;
    text-transform: uppercase;
    text-shadow: 0 4px 28px rgba(0, 0, 0, .28);
  }
  .pdd__cover h1 span {
    display: block;
    margin-bottom: .09em;
    color: #f4cb54;
    font: 700 clamp(17px, 2.35vw, 36px)/1 "Courier New", monospace;
    letter-spacing: .14em;
  }
  .pdd__cover-dek {
    max-width: 690px;
    margin: 30px 0 0;
    color: #f4ead9;
    font: 700 clamp(18px, 2.3vw, 30px)/1.24 Georgia, serif;
  }
  .pdd__cover-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 30px; }
  .pdd__cover-actions a,
  .pdd__cover-actions button {
    min-height: 43px;
    padding: 10px 16px;
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 0;
    background: transparent;
    color: #fff7e6;
    cursor: pointer;
    font: 700 10px/1 "Courier New", monospace;
    letter-spacing: .13em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .pdd__cover-actions a { background: #f4cb54; border-color: #f4cb54; color: #17130f; }
  .pdd__cover-actions button:hover { background: #fff7e6; color: #17130f; }
  .pdd__cover-credit {
    position: absolute;
    z-index: 3;
    right: clamp(18px, 3vw, 48px);
    bottom: 17px;
    margin: 0;
    color: rgba(255,255,255,.72);
    font: 700 8px/1.3 "Courier New", monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .pdd__paper {
    position: relative;
    background:
      linear-gradient(90deg, transparent 0 49.9%, rgba(105, 78, 44, .035) 50%, transparent 50.1%),
      radial-gradient(circle at 12% 14%, rgba(133, 86, 37, .07), transparent 23%),
      var(--paper);
  }
  .pdd__paper::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .17;
    background-image: repeating-linear-gradient(0deg, rgba(37, 28, 18, .09) 0 1px, transparent 1px 4px);
    mix-blend-mode: multiply;
  }
  .pdd__standfirst,
  .pdd__thesis,
  .pdd__chapter,
  .pdd__closer,
  .pdd__footer {
    position: relative;
    z-index: 1;
  }
  .pdd__standfirst {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(72px, 10vw, 140px) clamp(18px, 3.8vw, 58px);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, .8fr) minmax(220px, .55fr);
    gap: clamp(30px, 5vw, 78px);
    border-bottom: 1px solid var(--rule);
  }
  .pdd__folio {
    margin: 0 0 18px;
    color: var(--red);
    font: 700 10px/1.2 "Courier New", monospace;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .pdd__big-lede {
    margin: 0;
    font: 700 clamp(32px, 4.7vw, 70px)/.98 Georgia, serif;
    letter-spacing: -.045em;
  }
  .pdd__intro-copy {
    padding-top: 30px;
    font: 17px/1.68 Georgia, serif;
  }
  .pdd__intro-copy p { margin: 0 0 1.25em; }
  .pdd__dropcap {
    float: left;
    margin: .04em .1em -.08em 0;
    color: var(--red);
