---
/**
 * /drum-steady — Steady Hands. A test of your internal clock.
 *
 * A target tempo (90–120 BPM) is chosen at run start. Four audible
 * count-in clicks set the pulse — then the room goes silent and you
 * keep tapping SPACE (or the pad) for 32 beats by feel alone. Every
 * tap is scored on how far its inter-tap interval drifts from the
 * target: a pocket meter needle leans RUSH (right) or DRAG (left),
 * and a running "in the pocket %" tracks how many landed tight.
 * Final score is your average drift in ms — LOWER is better — with a
 * pocket percentage. Best (lowest) drift lives in localStorage. Flip
 * the click on to practice with the guide; practice runs never touch
 * your best.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Steady Hands · hold the tempo by feel · PointCast';
const description = 'Four clicks set the pulse, then silence. Keep the tempo by feel for 32 beats. Lowest average drift wins — how steady are your hands?';
---
<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dsy" id="dsy">
    <header class="dsy__top">
      <div class="dsy__caller">
        <img class="dsy__noun" id="dsy-noun" src="https://noun.pics/523.svg" alt="The pocket-keeping Noun" width="120" height="120" />
        <div class="dsy__speech" id="dsy-speech">tap START, then catch the pulse</div>
      </div>
      <div class="dsy__score">
        <span class="dsy__stat"><strong id="dsy-best">—</strong><em>best ms</em></span>
        <span class="dsy__stat"><strong id="dsy-bpm">—</strong><em>bpm</em></span>
      </div>
    </header>

    <section class="dsy__stage" id="dsy-stage">
      <div class="dsy__meter-wrap">
        <canvas class="dsy__meter" id="dsy-meter"></canvas>
      </div>

      <div class="dsy__dots" id="dsy-dots" aria-hidden="true">
        <span class="dsy__dot"></span>
        <span class="dsy__dot"></span>
        <span class="dsy__dot"></span>
        <span class="dsy__dot"></span>
      </div>

      <div class="dsy__hud">
        <div class="dsy__hud-cell">
          <span class="dsy__hud-val" id="dsy-beat">0 / 32</span>
          <span class="dsy__hud-label">beat</span>
        </div>
        <div class="dsy__hud-cell">
          <span class="dsy__hud-val" id="dsy-pocket">—</span>
          <span class="dsy__hud-label">in pocket</span>
        </div>
        <div class="dsy__hud-cell">
          <span class="dsy__last" id="dsy-last">—</span>
          <span class="dsy__hud-label">last tap</span>
        </div>
      </div>

      <button class="dsy__pad" id="dsy-pad" type="button" aria-label="Tap the tempo (space bar)">
        <span class="dsy__pad-ring"></span>
        <span class="dsy__pad-beat" id="dsy-pad-beat">TAP</span>
        <span class="dsy__pad-hint">space / tap</span>
      </button>

      <div class="dsy__overlay" id="dsy-overlay">
        <h1 class="dsy__title" id="dsy-title">STEADY HANDS</h1>
        <p class="dsy__sub" id="dsy-sub">hold the tempo by feel · 4-beat count-in, then silence</p>
        <p class="dsy__best-line" id="dsy-best-line">best — · pocket —</p>
        <button class="dsy__go" id="dsy-go" type="button">▶ FEEL THE PULSE</button>
      </div>
    </section>

    <section class="dsy__controls">
      <button class="dsy__toggle" id="dsy-toggle" type="button" aria-pressed="false">click: off</button>
      <span class="dsy__hint" id="dsy-note">space or tap to keep time</span>
    </section>

    <nav class="dsy__siblings">
      <a href="/drum-hero">/drum-hero</a>
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-lockstep">/drum-lockstep</a>
      <a href="/drum">/drum</a>
    </nav>
  </main>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dsy) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dsy {
      max-width: 560px; margin: 0 auto; padding: 22px 14px 48px;
      display: flex; flex-direction: column; gap: 18px; min-height: 94vh;
    }

    /* HEADER — conductor Noun + scoreboard */
    .dsy__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .dsy__caller { display: flex; align-items: center; gap: 14px; }
    .dsy__noun {
      width: 88px; height: 88px;
      image-rendering: pixelated;
      filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5));
      transition: transform 120ms ease;
    }
    .dsy--countin .dsy__noun { animation: dsyBob 0.5s ease-in-out infinite; }
    @keyframes dsyBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
    .dsy__speech {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; letter-spacing: 0.06em; color: #f4e7c8;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(244,231,200,0.18);
      border-radius: 4px 14px 14px 14px;
      padding: 9px 13px; max-width: 210px; line-height: 1.5;
    }
    .dsy__score { display: flex; gap: 18px; }
    .dsy__stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .dsy__score strong {
      font-family: 'Inter Tight', sans-serif; font-weight: 800;
      font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums;
    }
    .dsy__stat:first-child strong { color: #8aeac0; }
    .dsy__stat:last-child strong { color: #f6c15e; }
    .dsy__score em {
      font-style: normal; font-family: 'JetBrains Mono', monospace;
      font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: #8a8a9a;
    }

    /* STAGE */
    .dsy__stage {
      position: relative; flex: 1; min-height: 440px;
      display: flex; flex-direction: column; gap: 14px;
      padding: 18px 16px 22px; border-radius: 16px; overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 78%, #1c0e2e 100%);
    }
    .dsy__meter-wrap {
      position: relative; height: 120px; border-radius: 12px;
      background: rgba(7,5,15,0.45); border: 1px solid rgba(244,231,200,0.08);
    }
    .dsy__meter { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    /* count-in dots */
    .dsy__dots { display: flex; justify-content: center; gap: 12px; transition: opacity 200ms ease; }
    .dsy--playing .dsy__dots { opacity: 0.22; }
    .dsy__dot {
      width: 12px; height: 12px; border-radius: 50%;
      background: rgba(244,231,200,0.14); border: 1px solid rgba(244,231,200,0.2);
      transition: background 60ms ease, transform 60ms ease, box-shadow 120ms ease;
    }
    .dsy__dot--lit { background: #f6c15e; transform: scale(1.35); box-shadow: 0 0 14px rgba(246,193,94,0.7); }

    /* HUD row */
    .dsy__hud { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; font-family: 'JetBrains Mono', monospace; }
    .dsy__hud-cell { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 6px 4px; }
    .dsy__hud-val {
      font-family: 'Inter Tight', sans-serif; font-weight: 800;
      font-size: 20px; font-variant-numeric: tabular-nums; color: #f4e7c8;
    }
    .dsy__last {
      font-family: 'Inter Tight', sans-serif; font-weight: 800;
      font-size: 15px; color: #8a8a9a; min-height: 20px;
    }
    .dsy__last--pocket { color: #8aeac0; text-shadow: 0 0 12px rgba(138,234,192,0.6); }
    .dsy__last--rush { color: #7ac8ed; }
    .dsy__last--drag { color: #ff6b8a; }
    .dsy__hud-label { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; }

    /* TAP PAD */
    .dsy__pad {
      position: relative; flex: 1; min-height: 150px;
      border: 0; border-radius: 18px; cursor: pointer;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
      background: radial-gradient(circle at 50% 42%, #241236, #130a20 70%);
      box-shadow: inset 0 0 0 1px rgba(246,193,94,0.14);
      -webkit-tap-highlight-color: transparent; touch-action: manipulation;
      transition: transform 70ms ease, box-shadow 140ms ease, background 140ms ease;
    }
    .dsy__pad:active { transform: scale(0.985); }
    .dsy__pad--lit {
      background: radial-gradient(circle at 50% 42%, #3a1d55, #1a0e2b 70%);
      box-shadow: inset 0 0 0 1px rgba(246,193,94,0.5), 0 0 28px rgba(246,193,94,0.22);
    }
    .dsy__pad--good { box-shadow: inset 0 0 0 1px rgba(138,234,192,0.7), 0 0 32px rgba(138,234,192,0.3); }
    .dsy__pad-ring {
      position: absolute; width: 108px; height: 108px; border-radius: 50%;
      border: 2px solid rgba(244,231,200,0.12); pointer-events: none;
    }
    .dsy--playing .dsy__pad-ring { border-color: rgba(246,193,94,0.3); }
    .dsy__pad-beat {
      font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 40px;
      color: #f6c15e; font-variant-numeric: tabular-nums; line-height: 1; z-index: 1;
    }
    .dsy__pad-hint {
      font-family: 'JetBrains Mono', monospace; font-size: 10px;
      letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; z-index: 1;
    }

    /* OVERLAY */
    .dsy__overlay {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
      background: rgba(7,5,15,0.86); backdrop-filter: blur(3px);
      z-index: 4; text-align: center; padding: 20px;
    }
    .dsy__overlay.dsy__overlay--hidden { display: none; }
    .dsy__title {
      font-family: 'JetBrains Mono', monospace; font-size: clamp(28px, 8vw, 50px);
      letter-spacing: 0.14em; margin: 0; color: #f6c15e; text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dsy__sub, .dsy__best-line {
      font-family: 'JetBrains Mono', monospace; font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase; color: #8a8a9a;
      margin: 0; max-width: 340px; line-height: 1.6;
    }
    .dsy__best-line { color: #d4a437; }
    .dsy__go {
      margin-top: 10px; font-family: 'JetBrains Mono', monospace;
      font-size: 14px; font-weight: 800; letter-spacing: 0.2em;
      color: #07050f; background: #f6c15e; border: 0; border-radius: 14px;
      padding: 14px 30px; cursor: pointer; transition: transform 100ms ease, background 160ms ease;
    }
    .dsy__go:hover { transform: translateY(-1px); background: #ffd98a; }

    /* CONTROLS */
    .dsy__controls { display: flex; align-items: center; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .dsy__toggle {
      font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: #f4e7c8;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(244,231,200,0.2);
      border-radius: 12px; padding: 10px 18px; cursor: pointer;
      transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
    }
    .dsy__toggle[aria-pressed="true"] { color: #8aeac0; border-color: rgba(138,234,192,0.5); background: rgba(138,234,192,0.08); }
    .dsy__toggle:disabled { opacity: 0.35; cursor: default; }
    .dsy__hint {
      font-family: 'JetBrains Mono', monospace; font-size: 10px;
      letter-spacing: 0.14em; text-transform: uppercase; color: #8a8a9a;
    }

    .dsy__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dsy__siblings a { color: #d4a437; text-decoration: none; }
    .dsy__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .dsy__stage { min-height: 400px; }
      .dsy__score strong { font-size: 28px; }
      .dsy__noun { width: 72px; height: 72px; }
    }
  </style>

  <script>
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];
    const COUNT_IN = 4;       // audible count-in beats
    const BEATS = 32;         // silent beats the player must hold
    const POCKET_MS = 40;     // tight window that counts as "in the pocket"
    const MAX_VIS_MS = 130;   // meter full-scale drift, ms → edge of needle track
    const LEAD_MS = 550;      // breath before the first count-in click

    type Phase = 'idle' | 'countin' | 'playing' | 'over';
    type Mark = { t: number; off: number; pocket: boolean };

    let phase: Phase = 'idle';
    let targetBPM = 0;
    let targetInterval = 0;   // ms per beat
    let tapCount = 0;
    let sumAbs = 0;
    let pocketCount = 0;
    let lastTapTime = 0;
    let signedErrors: number[] = [];
    let timers: number[] = [];
    let practice = false;     // captured at run start: guide on ⇒ best not saved
    let clickOn = false;      // toggle state
    let SESSION_ID = '';

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    // Metronome tick — bright and short. Accent the count-in downbeat.
    function pClick(accent: boolean) {
      const a = ctx();
      const t = a.currentTime + 0.002;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = 'square';
      o.frequency.setValueAtTime(accent ? 1760 : 1040, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(accent ? 0.17 : 0.11, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 0.06);
      const buf = a.createBuffer(1, Math.floor(a.sampleRate * 0.012), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 3000;
      const ng = a.createGain(); ng.gain.value = accent ? 0.12 : 0.08;
      n.connect(hp).connect(ng).connect(a.destination); n.start(t);
    }
    // Player's own drum — a warm woodblock. Constant timbre: no accuracy is
    // leaked into the sound, so the tempo really is held by feel.
    function pTap(vel = 1) {
      const a = ctx();
      const t = a.currentTime + 0.004;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = 'triangle';
      o.frequency.setValueAtTime(320, t);
      o.frequency.exponentialRampToValueAtTime(178, t + 0.09);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.3 * vel, t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination);
      o.start(t); o.stop(t + 0.26);
      const buf = a.createBuffer(1, Math.floor(a.sampleRate * 0.02), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const ng = a.createGain(); ng.gain.value = 0.1 * vel;
      n.connect(ng).connect(a.destination); n.start(t);
    }
    function pDone(good: boolean) {
      const a = ctx();
      const base = a.currentTime + 0.01;
      const notes = good ? [523.25, 659.25, 783.99] : [392.0, 329.63];
      notes.forEach((f, i) => {
        const t = base + i * 0.13;
        const o = a.createOscillator();
        const g = a.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.2, t + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.42);
        o.connect(g).connect(a.destination);
        o.start(t); o.stop(t + 0.46);
      });
    }

    // ---- dom ----
    const root = document.getElementById('dsy')!;
    const speech = document.getElementById('dsy-speech')!;
    const bestEl = document.getElementById('dsy-best')!;
    const bpmEl = document.getElementById('dsy-bpm')!;
    const beatEl = document.getElementById('dsy-beat')!;
    const pocketEl = document.getElementById('dsy-pocket')!;
    const lastEl = document.getElementById('dsy-last')!;
    const padBeat = document.getElementById('dsy-pad-beat')!;
    const pad = document.getElementById('dsy-pad') as HTMLButtonElement;
    const nounImg = document.getElementById('dsy-noun') as HTMLImageElement;
    const dots = Array.from(document.querySelectorAll('.dsy__dot')) as HTMLElement[];
    const overlay = document.getElementById('dsy-overlay')!;
    const goBtn = document.getElementById('dsy-go') as HTMLButtonElement;
    const toggleBtn = document.getElementById('dsy-toggle') as HTMLButtonElement;
    const note = document.getElementById('dsy-note')!;
    const titleEl = document.getElementById('dsy-title')!;
    const subEl = document.getElementById('dsy-sub')!;
    const bestLine = document.getElementById('dsy-best-line')!;

    function say(line: string) { speech.textContent = line; }
    function lightDot(i: number) {
      const el = dots[i];
      if (!el) return;
      el.classList.add('dsy__dot--lit');
      window.setTimeout(() => el.classList.remove('dsy__dot--lit'), Math.min(targetInterval * 0.8, 260));
    }
    function resetDots() { dots.forEach((d) => d.classList.remove('dsy__dot--lit')); }
    function pulsePad(good = false) {
      pad.classList.add('dsy__pad--lit');
      if (good) pad.classList.add('dsy__pad--good');
      window.setTimeout(() => pad.classList.remove('dsy__pad--lit', 'dsy__pad--good'), 130);
    }

    // ---- meter (canvas) ----
    const canvas = document.getElementById('dsy-meter') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.max(1, Math.floor(W * DPR));
      canvas.height = Math.max(1, Math.floor(H * DPR));
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    window.addEventListener('resize', resize);

    let history: Mark[] = [];
    let needleTarget = 0;   // normalized -1..1 (rush = +, right)
    let needleCur = 0;
    let lastPocket = true;
    let flash = 0;

    function setNeedle(err: number, pocket: boolean) {
      const off = Math.max(-1, Math.min(1, -err / MAX_VIS_MS)); // rush (short) ⇒ right
      needleTarget = off;
      lastPocket = pocket;
      flash = 1;
      history.push({ t: performance.now(), off, pocket });
      if (history.length > 40) history.shift();
    }

    function drawMeter() {
      cx.clearRect(0, 0, W, H);
      const midY = H * 0.5;
      const cxx = W / 2;
      const halfW = W * 0.42;

      // baseline track
      cx.strokeStyle = 'rgba(244,231,200,0.12)';
      cx.lineWidth = 2;
      cx.beginPath(); cx.moveTo(cxx - halfW, midY); cx.lineTo(cxx + halfW, midY); cx.stroke();

      // pocket band around dead-centre
      const pocketPx = (POCKET_MS / MAX_VIS_MS) * halfW;
      cx.fillStyle = 'rgba(138,234,192,0.14)';
      cx.fillRect(cxx - pocketPx, midY - 17, pocketPx * 2, 34);
      cx.strokeStyle = 'rgba(138,234,192,0.5)';
      cx.lineWidth = 1;
      cx.strokeRect(cxx - pocketPx, midY - 17, pocketPx * 2, 34);

      // centre tick (perfect)
      cx.strokeStyle = 'rgba(246,193,94,0.85)';
      cx.lineWidth = 2;
      cx.beginPath(); cx.moveTo(cxx, midY - 26); cx.lineTo(cxx, midY + 26); cx.stroke();

      // fading history of recent taps — a tight cluster means steady hands
      const now = performance.now();
      history = history.filter((h) => now - h.t < 4200);
      for (const h of history) {
        const age = (now - h.t) / 4200;
        const x = cxx + h.off * halfW;
        cx.globalAlpha = (1 - age) * 0.6;
        cx.fillStyle = h.pocket ? '#8aeac0' : '#d4a437';
        cx.beginPath(); cx.arc(x, midY, 4, 0, Math.PI * 2); cx.fill();
      }
      cx.globalAlpha = 1;

      // eased needle for the last tap
      needleCur += (needleTarget - needleCur) * 0.22;
      flash *= 0.9;
      const nx = cxx + needleCur * halfW;
      const col = lastPocket ? '#8aeac0' : '#ff6b8a';
      cx.strokeStyle = col;
      cx.fillStyle = col;
      cx.shadowColor = col;
      cx.shadowBlur = 8 + flash * 22;
      cx.lineWidth = 3;
      cx.beginPath(); cx.moveTo(nx, midY - 30); cx.lineTo(nx, midY + 30); cx.stroke();
      cx.beginPath();
      cx.moveTo(nx, midY - 30); cx.lineTo(nx - 6, midY - 40); cx.lineTo(nx + 6, midY - 40);
      cx.closePath(); cx.fill();
      cx.shadowBlur = 0;

      // labels
      cx.fillStyle = 'rgba(138,138,154,0.85)';
      cx.font = '10px "JetBrains Mono", monospace';
      cx.textBaseline = 'middle';
      cx.textAlign = 'left';
      cx.fillText('◀ DRAG', 8, midY + H * 0.34);
      cx.textAlign = 'right';
      cx.fillText('RUSH ▶', W - 8, midY + H * 0.34);
      cx.textAlign = 'center';
      cx.fillText('POCKET', cxx, midY - H * 0.34);
    }

    let rafId = 0;
    function frame() {
      drawMeter();
      rafId = requestAnimationFrame(frame);
    }

    // ---- scoring / hud ----
    function updateHud() {
      beatEl.textContent = `${tapCount} / ${BEATS}`;
      pocketEl.textContent = tapCount ? `${Math.round((pocketCount / tapCount) * 100)}%` : '—';
      if (signedErrors.length === 0) {
        lastEl.textContent = '—';
        lastEl.className = 'dsy__last';
        return;
      }
      const e = signedErrors[signedErrors.length - 1];
      const abs = Math.abs(Math.round(e));
      if (abs <= POCKET_MS) {
        lastEl.textContent = 'in the pocket';
        lastEl.className = 'dsy__last dsy__last--pocket';
      } else if (e < 0) {
        lastEl.textContent = `${abs}ms rushing`;
        lastEl.className = 'dsy__last dsy__last--rush';
      } else {
        lastEl.textContent = `${abs}ms dragging`;
        lastEl.className = 'dsy__last dsy__last--drag';
      }
    }

    function onTap() {
      // Free play when there's no run going — still drums, still broadcasts.
      if (phase === 'idle' || phase === 'over') {
        pTap(); pulsePad(); broadcast(); return;
      }
      if (phase === 'countin') {
        // Feedback only — pre-count taps are not measured.
        pTap(0.7); pulsePad(); return;
      }
      if (phase !== 'playing') return;

      const now = performance.now();
      const interval = now - lastTapTime;
      lastTapTime = now;
      const err = interval - targetInterval;   // signed: <0 rush, >0 drag
      const abs = Math.abs(err);
      const inPocket = abs <= POCKET_MS;

      tapCount++;
      sumAbs += abs;
      if (inPocket) pocketCount++;
      signedErrors.push(err);

      pTap();
      pulsePad(inPocket);
      setNeedle(err, inPocket);
      padBeat.textContent = String(tapCount);
      updateHud();
      broadcast();

      if (tapCount >= BEATS) endRun();
    }

    // ---- count-in scheduling ----
    function onBeat(i: number) {
      if (i < COUNT_IN) {
        pClick(i === 0);
        lightDot(i);
        padBeat.textContent = String(i + 1);
        if (i === COUNT_IN - 1) {
          // hand-off: the last click is the anchor for the player's first tap
          phase = 'playing';
          lastTapTime = performance.now();
          root.classList.remove('dsy--countin');
          root.classList.add('dsy--playing');
          padBeat.textContent = 'GO';
          say('now — hold it by feel.');
        } else {
          say(`count-in… ${i + 1}`);
        }
      } else if (clickOn) {
        // practice guide keeps ticking through the silent beats
        pClick(i % 4 === 0);
      }
    }

    function scheduleBeats() {
      clearTimers();
      const total = COUNT_IN + (clickOn ? BEATS : 0);
      for (let i = 0; i < total; i++) {
        timers.push(window.setTimeout(() => onBeat(i), LEAD_MS + i * targetInterval));
      }
    }
    function clearTimers() {
      timers.forEach((t) => clearTimeout(t));
      timers = [];
    }

    // ---- run lifecycle ----
    function flavor(avg: number): string {
      if (avg < 15) return 'surgical.';
      if (avg < 30) return 'steady hands.';
      if (avg < 50) return 'a solid pocket.';
      if (avg < 80) return 'wobbly, but there.';
      return 'the clock got away.';
    }

    function endRun() {
      phase = 'over';
      clearTimers();
      root.classList.remove('dsy--playing', 'dsy--countin');
      toggleBtn.disabled = false;

      const avg = tapCount ? sumAbs / tapCount : 0;
      const avgR = Math.round(avg);
      const pocketPct = tapCount ? Math.round((pocketCount / tapCount) * 100) : 0;
      pDone(avg < 45);

      titleEl.textContent = `±${avgR} ms`;
      subEl.textContent = `${pocketPct}% in the pocket · ${targetBPM} BPM · ${flavor(avg)}`;
      goBtn.textContent = '▶ RUN IT BACK';

      // Persist best (LOWER drift wins) — never on practice runs.
      let savedBest = avgR;
      let savedPocket = pocketPct;
      try {
        const prev = Number(localStorage.getItem('pc-drum-steady-best') || 0);
        const prevPocket = Number(localStorage.getItem('pc-drum-steady-pocket') || 0);
        if (!practice && (prev === 0 || avgR < prev)) {
          localStorage.setItem('pc-drum-steady-best', String(avgR));
          localStorage.setItem('pc-drum-steady-pocket', String(pocketPct));
        } else if (prev > 0) {
          savedBest = prev;
          savedPocket = prevPocket;
        }
      } catch { /* ignore */ }

      bestEl.textContent = `±${savedBest}`;
      bestLine.textContent = practice
        ? `practice — best not saved · this run ±${avgR} ms`
        : `best ±${savedBest} ms · ${savedPocket}% pocket`;

      overlay.classList.remove('dsy__overlay--hidden');
    }

    function startRun() {
      ctx();
      resize();
      practice = clickOn;
      targetBPM = 90 + Math.floor(Math.random() * 31); // 90..120
      targetInterval = 60000 / targetBPM;

      tapCount = 0;
      sumAbs = 0;
      pocketCount = 0;
      signedErrors = [];
      lastTapTime = 0;
      history = [];
      needleTarget = 0;

      bpmEl.textContent = String(targetBPM);
      beatEl.textContent = `0 / ${BEATS}`;
      pocketEl.textContent = '—';
      lastEl.textContent = '—';
      lastEl.className = 'dsy__last';
      padBeat.textContent = '…';
      resetDots();

      nounImg.src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;

      phase = 'countin';
      root.classList.add('dsy--countin');
      root.classList.remove('dsy--playing');
      toggleBtn.disabled = true;
      overlay.classList.add('dsy__overlay--hidden');
      say(practice ? 'practice — guide is on.' : 'get ready…');
      scheduleBeats();
    }

    // ---- input ----
    pad.addEventListener('pointerdown', (e) => { e.preventDefault(); onTap(); });
    goBtn.addEventListener('click', () => { ctx(); startRun(); });
    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      clickOn = !clickOn;
      toggleBtn.textContent = clickOn ? 'click: on' : 'click: off';
      toggleBtn.setAttribute('aria-pressed', String(clickOn));
      note.textContent = clickOn ? 'guide on — practice, best not saved' : 'space or tap to keep time';
    });
    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      if (e.code === 'Space' || e.key === ' ') {
        const t = e.target as HTMLElement | null;
        if (t && t.tagName === 'BUTTON') return; // let focused start/toggle button handle it
        e.preventDefault();
        onTap();
      }
    });

    // ---- shared drum bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast() {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // never flood the bus
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed: 0, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    resize();
    rafId = requestAnimationFrame(frame);
    try {
      const b = Number(localStorage.getItem('pc-drum-steady-best') || 0);
      const p = Number(localStorage.getItem('pc-drum-steady-pocket') || 0);
      if (b > 0) {
        bestEl.textContent = `±${b}`;
        bestLine.textContent = `best ±${b} ms · ${p}% pocket`;
      }
    } catch { /* ignore */ }
  </script>
</BlockLayout>
