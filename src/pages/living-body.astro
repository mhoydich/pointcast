---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ACUPUNCTURE_PRINCIPAL_POINTS, CORRIDOR_PRACTICE, FRAMING_POSITION, PAPER_META, PAPER_NOTES, REFERENCES, SCIENTIFIC_HONESTY_FRAMEWORK, SEVEN_CHAKRAS, THREE_TRADITIONS, TWELVE_MERIDIANS } from '../lib/livingBodyPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/living-body', name: PAPER_META.title, description, url: 'https://pointcast.xyz/living-body', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const elementColor: Record<string, string> = { wood: '#2d6a3d', fire: '#b85a3a', earth: '#8a6a3d', metal: '#a8a39a', water: '#3d6a8a', air: '#a06478', ether: '#5b3d7a', light: '#d4a534' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/living-body.json', title: 'The Living Body (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/university-of-el-segundo">UES</a><span aria-hidden="true">/</span><span>living-body</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY</p>
      <h1>THE / LIVING / BODY.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="frame"><p class="kicker">FRAMING POSITION</p><h2>How the federation holds these traditions.</h2>
      <p class="block"><strong>Positive belief:</strong> {FRAMING_POSITION.positiveBelief}</p>
      <p class="block"><strong>Not proselytizing:</strong> {FRAMING_POSITION.notProselytizing}</p>
      <p class="block"><strong>Not dismissive:</strong> {FRAMING_POSITION.notDismissive}</p>
      <p class="block"><strong>Scientific honesty:</strong> {FRAMING_POSITION.scientificHonesty}</p>
      <p class="block"><strong>Why the corridor and not just someone:</strong> {FRAMING_POSITION.whyTheCorridorAndNotJustSomeone}</p>
    </section>

    <section class="trad"><p class="kicker">THREE TRADITIONS · 2,300 → 2,500 → 50 YEARS</p><h2>The body-energy lineages documented here.</h2>
      <ol class="tr-list">{THREE_TRADITIONS.map((t, i) => (
        <li>
          <div class="tr__head"><span class="tr__num">{String(i+1).padStart(2,'0')}</span><h3>{t.name}</h3></div>
          <dl class="tr-dl">
            <div><dt>Origin</dt><dd>{t.origin}</dd></div>
            <div><dt>Age</dt><dd>{t.age}</dd></div>
            <div><dt>Foundational texts</dt><dd>{t.foundationalTexts}</dd></div>
            <div><dt>Core claim</dt><dd>{t.coreClaim}</dd></div>
            <div><dt>Major branches</dt><dd>{t.majorBranches}</dd></div>
            <div><dt>Contemporary reach</dt><dd>{t.contemporaryReach}</dd></div>
          </dl>
          <p class="tr__science"><strong>What modern research says:</strong> {t.whatModernResearchSays}</p>
        </li>
      ))}</ol>
    </section>

    <section class="meridians"><p class="kicker">12 MERIDIANS · TCM PRIMARY CHANNELS</p><h2>The atlas.</h2>
      <ol class="md-list">{TWELVE_MERIDIANS.map((m) => (
        <li style={`--el-color: ${elementColor[m.element]};`}>
          <div class="md__head">
            <span class="md__num">{String(m.number).padStart(2,'0')}</span>
            <h3>{m.name}</h3>
            <span class="md__el">{m.element}</span>
          </div>
          <p class="md__row"><strong>Path:</strong> {m.startsEnds} · {m.principalPoints} principal points</p>
          <p class="md__row"><strong>Time of day:</strong> {m.timeOfDay}</p>
          <p class="md__row"><strong>Notes:</strong> {m.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="chakras"><p class="kicker">SEVEN CHAKRAS · YOGIC SUBTLE BODY</p><h2>The atlas.</h2>
      <ol class="ch-list">{SEVEN_CHAKRAS.map((c) => (
        <li style={`--el-color: ${elementColor[c.element.split(' ')[0]] || '#5b3d7a'};`}>
          <div class="ch__head">
            <span class="ch__num">{String(c.number).padStart(2,'0')}</span>
            <h3>{c.sanskrit} · {c.english}</h3>
            <span class="ch__bija">{c.bijaMantra}</span>
          </div>
          <p class="ch__row"><strong>Location:</strong> {c.location}</p>
          <p class="ch__row"><strong>Element:</strong> {c.element} · {c.petalCount} petals</p>
          <p class="ch__row"><strong>Governs:</strong> {c.governing}</p>
          <p class="ch__row"><strong>Common practices:</strong> {c.commonPractices}</p>
        </li>
      ))}</ol>
    </section>

    <section class="points"><p class="kicker">10 PRINCIPAL ACUPUNCTURE POINTS · STARTING REFERENCE</p><h2>The points most-used in clinical practice.</h2>
      <ol class="pt-list">{ACUPUNCTURE_PRINCIPAL_POINTS.map((p) => (
        <li>
          <div class="pt__head"><span class="pt__code">{p.code}</span><h3>{p.name}</h3></div>
          <p class="pt__row"><strong>Location:</strong> {p.location}</p>
          <p class="pt__row"><strong>Traditional use:</strong> {p.traditionalUse}</p>
          <p class="pt__row"><strong>Cautions:</strong> {p.cautions}</p>
        </li>
      ))}</ol>
    </section>

    <section class="cp"><p class="kicker">CORRIDOR PRACTICE · INTEGRATION</p><h2>How UES integrates the three traditions.</h2>
      <p class="lede">{CORRIDOR_PRACTICE.description}</p>
      <h3 class="sh">Cohort offerings · {CORRIDOR_PRACTICE.cohortOfferings.length}</h3>
      <ol class="co-list">{CORRIDOR_PRACTICE.cohortOfferings.map((o) => (
        <li>
          <h4>{o.offering}</h4>
          <p class="co__row"><strong>Format:</strong> {o.format}</p>
          <p class="co__row co__not"><strong>What it is not:</strong> {o.whatItIsNot}</p>
        </li>
      ))}</ol>
      <h3 class="sh">Practitioner network</h3>
      <p class="block">{CORRIDOR_PRACTICE.practitionerNetwork.description}</p>
      <p class="block"><strong>Vetting criteria:</strong></p>
      <ul class="dt-list">{CORRIDOR_PRACTICE.practitionerNetwork.vettingCriteria.map((v) => (<li>{v}</li>))}</ul>
      <p class="block"><strong>Referral protocol:</strong> {CORRIDOR_PRACTICE.practitionerNetwork.referralProtocol}</p>
      <p class="block"><strong>First-session discount:</strong> {CORRIDOR_PRACTICE.practitionerNetwork.firstSessionDiscount}</p>
      <h3 class="sh">Future giant work</h3>
      <p class="block">{CORRIDOR_PRACTICE.futureGiantWork}</p>
    </section>

    <section class="sci"><p class="kicker">SCIENTIFIC HONESTY · WHAT IS / IS NOT KNOWN</p><h2>An honest reading of the contemporary evidence.</h2>
      <h3 class="sh sh--good">What the evidence supports · {SCIENTIFIC_HONESTY_FRAMEWORK.whatTheEvidenceSupports.length}</h3>
      <ul class="dt-list dt-list--good">{SCIENTIFIC_HONESTY_FRAMEWORK.whatTheEvidenceSupports.map((s) => (<li>{s}</li>))}</ul>
      <h3 class="sh sh--mid">What remains contested · {SCIENTIFIC_HONESTY_FRAMEWORK.whatRemainsContested.length}</h3>
      <ul class="dt-list dt-list--mid">{SCIENTIFIC_HONESTY_FRAMEWORK.whatRemainsContested.map((s) => (<li>{s}</li>))}</ul>
      <h3 class="sh sh--unknown">What is genuinely unknown · {SCIENTIFIC_HONESTY_FRAMEWORK.whatIsGenuinelyUnknown.length}</h3>
      <ul class="dt-list dt-list--unknown">{SCIENTIFIC_HONESTY_FRAMEWORK.whatIsGenuinelyUnknown.map((s) => (<li>{s}</li>))}</ul>
      <h3 class="sh sh--no">What the federation does NOT claim · {SCIENTIFIC_HONESTY_FRAMEWORK.whatTheFederationDoesNotClaim.length}</h3>
      <ul class="dt-list dt-list--no">{SCIENTIFIC_HONESTY_FRAMEWORK.whatTheFederationDoesNotClaim.map((s) => (<li>{s}</li>))}</ul>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · PRACTITIONERS · COHORT · RESEARCHERS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/marine-layer">Marine Layer · breath practice</a>
      <a href="/bath-house">Bath House · water and heat practice</a>
      <a href="/time">Time · time-fluency practice</a>
      <a href="/sabbatical">Sabbatical infrastructure</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/living-body.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --lb-ink:#1a1a1a; --lb-paper:#fdf9ee; --lb-mustard:#d4a534; --lb-rust:#b85a3a; --lb-sage:#2d6a3d; --lb-violet:#5b3d7a; --lb-mauve:#a06478; --lb-fog:#d8d2c4; --lb-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--lb-paper); color: var(--lb-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--lb-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--lb-mauve); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--lb-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--lb-mauve); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 88px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--lb-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-mauve); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--lb-mauve); }
  h3.sh--good { color: var(--lb-sage); border-bottom-color: var(--lb-sage); }
  h3.sh--mid { color: var(--lb-mustard); border-bottom-color: var(--lb-mustard); }
  h3.sh--unknown { color: var(--lb-fog); border-bottom-color: var(--lb-fog); }
  h3.sh--no { color: var(--lb-rust); border-bottom-color: var(--lb-rust); }
  h4 { font-family: var(--pc-font-mono); font-size: 13.5px; margin: 0 0 6px; font-weight: 700; }

  .lede { font-size: 15.5px; line-height: 1.65; margin: 0 0 16px; max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--lb-mauve); max-width: 72ch; font-family: Georgia, serif; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-mauve); margin-right: 6px; }

  .tr-list, .md-list, .ch-list, .pt-list, .co-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .tr-list li { padding: 14px; background: #fff; border: 2px solid var(--lb-ink); border-left: 8px solid var(--lb-mauve); }
  .tr__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 2px solid var(--lb-mauve); }
  .tr__num { font-family: var(--pc-font-mono); font-size: 22px; font-weight: 700; color: var(--lb-mauve); }
  .tr__head h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0; flex: 1; }
  .tr-dl { display: grid; gap: 4px; margin: 0 0 10px; }
  .tr-dl > div { display: grid; grid-template-columns: 180px 1fr; gap: 12px; padding: 8px 10px; background: var(--lb-paper); border-left: 3px solid var(--lb-fog); }
  .tr-dl dt { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-mauve); padding-top: 2px; }
  .tr-dl dd { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .tr__science { padding: 10px 12px; background: var(--lb-paper); border-left: 4px solid var(--lb-sage); font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; margin: 0; }
  .tr__science strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-sage); margin-right: 4px; }

  .md-list li, .ch-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--lb-ink); border-left: 8px solid var(--el-color, var(--lb-mauve)); }
  .md__head, .ch__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 1px solid var(--el-color); }
  .md__num, .ch__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--el-color); }
  .md h3, .ch h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; font-weight: 700; flex: 1; }
  .md__el, .ch__bija { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; padding: 2px 6px; background: var(--el-color); color: #fff; text-transform: uppercase; }
  .md__row, .ch__row, .pt__row { padding: 5px 10px; background: var(--lb-paper); border-left: 3px solid var(--lb-fog); margin: 4px 0 !important; font-size: 12.5px; line-height: 1.55; font-family: Georgia, serif; }
  .md__row strong, .ch__row strong, .pt__row strong, .co__row strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-mauve); margin-right: 4px; }

  .pt-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--lb-ink); border-left: 6px solid var(--lb-rust); }
  .pt__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 2px solid var(--lb-rust); }
  .pt__code { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--lb-rust); padding: 2px 8px; background: var(--lb-paper); }
  .pt h3 { font-family: var(--pc-font-mono); font-size: 13.5px; margin: 0; flex: 1; }

  .co-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--lb-ink); border-left: 6px solid var(--lb-mauve); }
  .co__row { padding: 6px 10px; background: var(--lb-paper); margin: 6px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--lb-mustard); }
  .co__not { border-left-color: var(--lb-rust); }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }
  .dt-list--good li::marker { color: var(--lb-sage); }
  .dt-list--mid li::marker { color: var(--lb-mustard); }
  .dt-list--unknown li::marker { color: var(--lb-slate); }
  .dt-list--no li::marker { color: var(--lb-rust); }

  .invitation { background: var(--lb-mauve); color: var(--lb-paper); border-top-color: var(--lb-mauve); }
  .invitation .kicker { background: var(--lb-mustard); color: var(--lb-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--lb-mustard); color: var(--lb-ink); border-left: 4px solid var(--lb-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .85; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--lb-mauve); color: var(--lb-paper); text-decoration: none; }
  .links a:hover { background: var(--lb-rust); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .tr-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } }
</style>
