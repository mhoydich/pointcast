---
/**
 * /shrine-stone — stack a cairn at the edge of the path.
 *
 * Third elemental shrine. Where /shrine-water is a still pool and
 * /shrine-flame is twelve candles, /shrine-stone is a flat place to
 * balance stones. Tap and a stone settles onto the cairn — each one
 * offset by a deterministic but irregular amount so the tower looks
 * stacked by a real hand. The cairn grows tall but stays simple.
 *
 * Visual: each stone is a CSS-only asymmetric rounded shape, colored
 * from a soft moss-gray palette, with a faint cast shadow beneath.
 * Stone positions deterministic per index (hash of i → x offset, rotation,
 * shade variant) so the tower looks the same whether you stack 5 or 50.
 *
 * Audio:
 *   • Stone-set: short "tock" — pink-ish noise burst through a resonant
 *     lowpass at 220-340Hz, plus a tiny pitched click (sine ~180Hz).
 *     Through the same 2.2s convolution reverb as /shrine-water and
 *     /shrine-flame — third shrine in the same sonic room.
 *   • Ambient: occasional very distant wind — a 4-second filtered-noise
 *     swell every 30-60 seconds. Quieter than the bird chirps over at
 *     /shrine-bird.
 *
 * State (localStorage 'pc:shrine-stone:v1'):
 *   { currentCairn: number, lifetime: number, firstVisit, lastVisit }
 *   currentCairn persists across reloads — your tower stays standing.
 *
 * Distinct from existing /drum-altars (Noun tribute) — this is the
 * gallery-aesthetic earth element specifically. Same Apple-quality
 * framework as the other new shrines (frosted glass, New York serif,
 * spring entrance).
 *
 * Shipped 2026-05-16. Fifth shrine. Earth element. — drum-claude
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout
  title="Shrine of Stone — stack a cairn"
  description="A flat place at the edge of the path. Tap to balance another stone onto the cairn. They stay where you put them. Local-only; nothing leaves your browser. Slow, deliberate, contemplative."
  image="/images/og-drum.png"
>
  <main class="shs" id="shs" data-built={built}>
    <!-- Backdrop: dusk-mossy ground placeholder -->
    <div class="shs__backdrop" id="shs-backdrop" aria-hidden="true"></div>

    <!-- The card -->
    <article class="shs__card" id="shs-card">
      <header class="shs__head">
        <p class="shs__kicker">SHRINE · STONE · STACK A CAIRN</p>
        <h1 class="shs__title">A flat place at the edge of the path.</h1>
        <p class="shs__sub">Balance stones on the cairn — they stay where you put them, even after you close the tab. Each one is a little intention. There's no goal.</p>
      </header>

      <!-- The cairn — stones stack inside this -->
      <div class="shs__field">
        <div class="shs__horizon" aria-hidden="true"></div>
        <button
          class="shs__cairn"
          id="shs-cairn"
          type="button"
          aria-label="Add a stone to the cairn"
        >
          <div class="shs__cairn-stack" id="shs-stack" aria-hidden="true"></div>
          <span class="shs__cairn-hint" id="shs-cairn-hint">tap to set a stone</span>
        </button>
      </div>

      <!-- Foot -->
      <footer class="shs__foot">
        <p class="shs__count" id="shs-count">your first visit</p>
        <div class="shs__actions">
          <button class="shs__btn" id="shs-topple" type="button" disabled>↻ topple the cairn</button>
          <button class="shs__btn shs__btn--primary" id="shs-add" type="button">+ set a stone</button>
        </div>
        <p class="shs__links">
          <a href="/shrine-water">↗ /shrine-water</a>
          <span class="shs__dot">·</span>
          <a href="/shrine-flame">↗ /shrine-flame</a>
          <span class="shs__dot">·</span>
          <a href="/shrine-bird">↗ /shrine-bird</a>
          <span class="shs__dot">·</span>
          <a href="/aviary">↗ /aviary</a>
        </p>
      </footer>
    </article>
  </main>

  <style is:global>
    :root {
      --shs-ink: #060a0a;
      --shs-deep: #14181a;
      --shs-moss-1: #2a4034;
      --shs-moss-2: #3c5a48;
      --shs-stone-1: #9c9b8e;
      --shs-stone-2: #7d8076;
      --shs-stone-3: #8b8e7e;
      --shs-stone-4: #6a6c62;
      --shs-stone-5: #9b8e84;
      --shs-stone-shadow: #2a2a26;
      --shs-cream: #f4ede0;
      --shs-cream-dim: rgba(244, 237, 224, 0.62);
      --shs-cream-dimmer: rgba(244, 237, 224, 0.34);
      --shs-accent: #b8b4a0;
      --shs-card-bg: rgba(10, 14, 16, 0.42);
      --shs-card-border: rgba(244, 237, 224, 0.12);
    }

    html, body { background: var(--shs-ink); margin: 0; padding: 0; height: 100%; }
    body:has(.shs) {
      color: var(--shs-cream);
      font-family: -apple-system, 'SF Pro Display', BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
    }

    .shs {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    /* BACKDROP — mossy ground placeholder */
    .shs__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 40% 30%, rgba(184, 180, 160, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 70% 75%, rgba(42, 64, 52, 0.55) 0%, transparent 60%),
        linear-gradient(180deg, #14181a 0%, #1f2a24 55%, #2a3a30 100%);
      animation: shsBackdrop 38s ease-in-out infinite alternate;
    }
    @keyframes shsBackdrop {
      0%   { filter: brightness(1.0); }
      100% { filter: brightness(0.96); }
    }
    .shs__backdrop--image {
      background-image: url('/images/shrines/shrine-stone.png');
      background-size: cover;
      background-position: center;
      animation: none;
    }
    .shs__backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(6, 10, 10, 0.50) 95%);
      pointer-events: none;
    }

    /* CARD */
    .shs__card {
      position: relative;
      z-index: 1;
      max-width: 480px;
      width: 100%;
      padding: 36px 32px 24px;
      background: var(--shs-card-bg);
      border: 1px solid var(--shs-card-border);
      border-radius: 28px;
      backdrop-filter: blur(28px) saturate(130%);
      -webkit-backdrop-filter: blur(28px) saturate(130%);
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.50),
        0 8px 24px rgba(0, 0, 0, 0.30),
        inset 0 1px 0 rgba(244, 237, 224, 0.08);
      animation: shsCardEnter 1.6s cubic-bezier(0.16, 0.84, 0.30, 1.00) both;
    }
    @keyframes shsCardEnter {
      0%   { opacity: 0; transform: translateY(28px) scale(0.96); filter: blur(8px); }
      50%  { opacity: 0.9; filter: blur(2px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    /* HEAD */
    .shs__head { margin-bottom: 22px; }
    .shs__kicker {
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--shs-cream-dim);
      text-transform: uppercase;
      margin: 0 0 14px;
      font-weight: 500;
    }
    .shs__title {
      font-family: 'New York', 'Charter', 'Iowan Old Style', Georgia, serif;
      font-weight: 500;
      font-size: clamp(28px, 4vw, 36px);
      letter-spacing: -0.020em;
      line-height: 1.12;
      margin: 0 0 12px;
      color: var(--shs-cream);
    }
    .shs__sub {
      font-size: 14px;
      line-height: 1.55;
      color: var(--shs-cream-dim);
      margin: 0;
    }

    /* FIELD — where the cairn lives */
    .shs__field {
      position: relative;
      height: 280px;
      margin: 0 -8px 22px;
      border-radius: 16px;
      overflow: hidden;
      background:
        linear-gradient(180deg,
          rgba(20, 24, 26, 0.30) 0%,
          rgba(20, 24, 26, 0.05) 60%,
          rgba(42, 64, 52, 0.20) 100%);
      box-shadow:
        inset 0 1px 0 rgba(244, 237, 224, 0.05),
        inset 0 -10px 24px rgba(0, 0, 0, 0.30);
    }
    .shs__horizon {
      position: absolute;
      left: 0; right: 0;
      bottom: 18px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(184, 180, 160, 0.18), transparent);
    }

    .shs__cairn {
      position: absolute;
      inset: 0;
      background: transparent;
      border: 0;
      cursor: pointer;
      outline: none;
      padding: 0;
    }
    .shs__cairn:focus-visible {
      box-shadow: inset 0 0 0 2px rgba(184, 180, 160, 0.5);
    }
    .shs__cairn-stack {
      position: absolute;
      left: 50%;
      bottom: 22px;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }
    .shs__cairn-hint {
      position: absolute;
      bottom: 6px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: rgba(184, 180, 160, 0.40);
      transition: opacity 360ms ease;
      pointer-events: none;
    }
    .shs__cairn--touched .shs__cairn-hint { opacity: 0; }

    /* STONES — each placed absolutely relative to the stack base */
    .shs__stone {
      position: absolute;
      left: 50%;
      bottom: 0;
      transform-origin: 50% 100%;
      pointer-events: none;
      animation: shsStoneDrop 0.55s cubic-bezier(0.30, 0.20, 0.20, 1.05) both;
    }
    @keyframes shsStoneDrop {
      0%   { opacity: 0; transform: translate(var(--stone-tx), -28px) rotate(var(--stone-rot)); }
      40%  { opacity: 0.95; }
      80%  { transform: translate(var(--stone-tx), 4px) rotate(var(--stone-rot)); }
      100% { opacity: 1; transform: translate(var(--stone-tx), 0) rotate(var(--stone-rot)); }
    }
    .shs__stone-shape {
      position: relative;
      display: block;
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.10),
        inset -1px -1px 0 rgba(0, 0, 0, 0.18),
        0 3px 6px rgba(0, 0, 0, 0.4);
    }
    /* 5 stone color variants */
    .shs__stone--c1 .shs__stone-shape { background: var(--shs-stone-1); }
    .shs__stone--c2 .shs__stone-shape { background: var(--shs-stone-2); }
    .shs__stone--c3 .shs__stone-shape { background: var(--shs-stone-3); }
    .shs__stone--c4 .shs__stone-shape { background: var(--shs-stone-4); }
    .shs__stone--c5 .shs__stone-shape { background: var(--shs-stone-5); }
    /* Slight shadow at base of each stone — looks like contact */
    .shs__stone::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -3px;
      width: 90%;
      height: 4px;
      transform: translateX(-50%);
      background: radial-gradient(ellipse at 50% 0%, rgba(0, 0, 0, 0.30) 0%, transparent 70%);
      pointer-events: none;
    }

    /* When the cairn is tall, gently nudge it sideways — adds character */
    .shs__cairn-stack--tall { animation: shsCairnSway 8s ease-in-out infinite alternate; }
    @keyframes shsCairnSway {
      0%   { transform: rotate(-0.6deg); }
      100% { transform: rotate(0.6deg); }
    }

    /* Toppling animation — stones cascade outward */
    .shs__stone--toppling {
      animation: shsToppling 1.1s cubic-bezier(0.40, 0.10, 0.55, 1.20) forwards;
    }
    @keyframes shsToppling {
      0%   { opacity: 1; }
      100% {
        opacity: 0;
        transform: translate(var(--topple-tx), 120px) rotate(var(--topple-rot));
      }
    }

    /* FOOTER */
    .shs__foot { text-align: center; }
    .shs__count {
      font-family: 'New York', Georgia, serif;
      font-style: italic;
      font-size: 14px;
      color: var(--shs-cream-dim);
      margin: 0 0 14px;
      letter-spacing: 0.01em;
      min-height: 1.4em;
    }
    .shs__count strong {
      color: var(--shs-accent);
      font-weight: 600;
      font-style: normal;
    }
    .shs__actions {
      display: inline-flex;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .shs__btn {
      border: 1px solid rgba(244, 237, 224, 0.16);
      background: rgba(244, 237, 224, 0.04);
      color: var(--shs-cream-dim);
      padding: 7px 14px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .shs__btn:hover:not(:disabled) {
      background: rgba(244, 237, 224, 0.10);
      color: var(--shs-cream);
      border-color: rgba(244, 237, 224, 0.30);
    }
    .shs__btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .shs__btn--primary {
      background: rgba(184, 180, 160, 0.10);
      border-color: rgba(184, 180, 160, 0.32);
      color: var(--shs-accent);
    }
    .shs__btn--primary:hover:not(:disabled) {
      background: rgba(184, 180, 160, 0.18);
      border-color: rgba(184, 180, 160, 0.55);
    }
    .shs__links {
      font-family: 'SF Mono', 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--shs-cream-dimmer);
      margin: 0;
    }
    .shs__links a {
      color: var(--shs-cream-dim);
      text-decoration: none;
      transition: color 200ms ease;
    }
    .shs__links a:hover { color: var(--shs-cream); }
    .shs__dot { display: inline-block; margin: 0 6px; opacity: 0.4; }

    @media (max-width: 480px) {
      .shs__card { padding: 28px 22px 20px; border-radius: 22px; }
      .shs__field { height: 240px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .shs__card, .shs__backdrop, .shs__cairn-stack--tall { animation: none; }
      .shs__stone { animation-duration: 0.2s; }
    }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    const STORAGE_KEY = 'pc:shrine-stone:v1';
    const MAX_VISIBLE_STONES = 32;  // beyond this, oldest stones fade out

    interface StoneState {
      currentCairn: number;
      lifetime: number;
      firstVisit: number;
      lastVisit: number;
    }
    function freshState(): StoneState {
      return { currentCairn: 0, lifetime: 0, firstVisit: Date.now(), lastVisit: Date.now() };
    }
    function loadState(): StoneState {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          if (p && typeof p.currentCairn === 'number') {
            return {
              currentCairn: p.currentCairn,
              lifetime: typeof p.lifetime === 'number' ? p.lifetime : 0,
              firstVisit: p.firstVisit || Date.now(),
              lastVisit: p.lastVisit || Date.now(),
            };
          }
        }
      } catch { /* ignore */ }
      return freshState();
    }
    function saveState(s: StoneState) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch { /* ignore */ }
    }

    // ---- deterministic per-stone variation ----
    // Each stone index produces a deterministic (x-offset, rotation, width, height,
    // color variant) so the cairn looks the same across reloads.
    const STONE_VARIANTS = 5;  // CSS classes c1..c5
    interface StoneSpec {
      width: number;     // px
      height: number;    // px
      tx: number;        // x translate from center, in px
      rot: number;       // rotation degrees
      variant: 1 | 2 | 3 | 4 | 5;
      radius: string;    // border-radius for irregular shape
    }
    // Pseudo-random per index — small LCG-like derivation
    function fract(n: number) { return n - Math.floor(n); }
    function specForIdx(i: number): StoneSpec {
      // Base width: alternating taper from wide bottom to narrow top
      const baseW = 56 - (i * 1.6);  // gets narrower as you go up
      const w = Math.max(22, baseW + (fract((i * 1.6180339) * 7) - 0.5) * 10);
      const h = Math.max(10, 16 - i * 0.10 + (fract((i * 2.71828) * 5) - 0.5) * 4);
      const tx = (fract((i * 0.7548776) * 13) - 0.5) * Math.min(14, 2 + i * 0.4);
      const rot = (fract((i * 0.3819660) * 11) - 0.5) * 6;
      const variant = ((Math.floor(fract((i * 1.4142135) * 17) * STONE_VARIANTS)) + 1) as 1 | 2 | 3 | 4 | 5;
      // Irregular pebble shape — 4 different radius percentages
      const r1 = 38 + Math.floor(fract((i * 1.4142135) * 23) * 22);
      const r2 = 38 + Math.floor(fract((i * 2.2360679) * 19) * 22);
      const r3 = 38 + Math.floor(fract((i * 1.7320508) * 29) * 22);
      const r4 = 38 + Math.floor(fract((i * 2.6457513) * 31) * 22);
      const radius = `${r1}% ${r2}% ${r3}% ${r4}% / 60% 60% 40% 40%`;
      return { width: w, height: h, tx, rot, variant, radius };
    }

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let convolver: ConvolverNode | null = null;
    let dryGain: GainNode | null = null;
    let wetGain: GainNode | null = null;
    let ambientTimer: number | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.35;
      masterGain.connect(ctx.destination);
      convolver = ctx.createConvolver();
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 2.2);
      const ir = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const ch = ir.getChannelData(c);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          ch[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 3.4);
        }
      }
      convolver.buffer = ir;
      dryGain = ctx.createGain();
      wetGain = ctx.createGain();
      dryGain.gain.value = 0.72;
      wetGain.gain.value = 0.35;
      dryGain.connect(masterGain);
      convolver.connect(wetGain).connect(masterGain);
    }
    function connectVoice(node: AudioNode) {
      if (!dryGain || !convolver) return;
      node.connect(dryGain);
      node.connect(convolver);
    }

    // Stone-set "tock" — pink-ish noise burst through a resonant lowpass
    // + a tiny pitched click overlaid
    function playTock() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      // Noise burst
      const dur = 0.07 + Math.random() * 0.05;
      const bufLen = Math.floor(ctx.sampleRate * dur);
      const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufLen; i++) {
        data[i] = (Math.random() * 2 - 1) * (1 - i / bufLen);
      }
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 220 + Math.random() * 120;  // 220..340Hz
      filter.Q.value = 3.5;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.35, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      src.connect(filter).connect(g);
      connectVoice(g);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + dur + 0.05);
      // Pitched click — gives the tock a "stone" sound, not just a thud
      const osc = ctx.createOscillator();
      const og = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(180 + Math.random() * 40, t);
      osc.frequency.exponentialRampToValueAtTime(90, t + 0.08);
      og.gain.setValueAtTime(0.0001, t);
      og.gain.exponentialRampToValueAtTime(0.18, t + 0.006);
      og.gain.exponentialRampToValueAtTime(0.0001, t + 0.20);
      osc.connect(og);
      connectVoice(og);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.22);
    }

    // Distant wind ambient — a slow swell of filtered noise
    function playWind() {
      ensureCtx();
      if (!ctx || !scheduler) return;
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime + 0.005;
      const dur = 3.5 + Math.random() * 1.5;
      const bufLen = Math.floor(ctx.sampleRate * dur);
      const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      let last = 0;
      for (let i = 0; i < bufLen; i++) {
        // Lowpass-ish noise via running average
        const sample = (Math.random() * 2 - 1) * 0.5 + last * 0.5;
        data[i] = sample;
        last = sample;
      }
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = 240;
      filter.Q.value = 0.8;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.04, t + dur * 0.40);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      src.connect(filter).connect(g);
      connectVoice(g);
      scheduler.trackSource(src);
      src.start(t);
      src.stop(t + dur + 0.10);
    }

    function startAmbient() {
      if (ambientTimer != null) return;
      const tick = () => {
        playWind();
        ambientTimer = window.setTimeout(tick, 30000 + Math.random() * 30000);
      };
      // First wind ~10-25s after wake so the page starts quiet
      ambientTimer = window.setTimeout(tick, 10000 + Math.random() * 15000);
    }
    function stopAmbient() {
      if (ambientTimer != null) { clearTimeout(ambientTimer); ambientTimer = null; }
    }

    // ---- render ----
    let currentState = freshState();

    function renderStack() {
      const stack = document.getElementById('shs-stack')!;
      stack.innerHTML = '';
      const n = currentState.currentCairn;
      stack.classList.toggle('shs__cairn-stack--tall', n >= 8);

      // Render up to MAX_VISIBLE_STONES — older ones fade with opacity
      const visibleCount = Math.min(n, MAX_VISIBLE_STONES);
      const startIdx = Math.max(0, n - MAX_VISIBLE_STONES);

      let cumulativeY = 0;
      for (let i = startIdx; i < n; i++) {
        const spec = specForIdx(i);
        const stone = document.createElement('div');
        stone.className = `shs__stone shs__stone--c${spec.variant}`;
        stone.style.setProperty('--stone-tx', `calc(-50% + ${spec.tx}px)`);
        stone.style.setProperty('--stone-rot', `${spec.rot}deg`);
        // Position above all previously-rendered stones
        stone.style.bottom = `${cumulativeY}px`;
        // Make the most-recent stone NOT animated (it just got dropped, animate)
        // — actually let's animate the LATEST one, render older ones in final state
        if (i < n - 1) {
          stone.style.animation = 'none';
          stone.style.opacity = (i < startIdx + 3) ? '0.85' : '1';
        }

        const shape = document.createElement('span');
        shape.className = 'shs__stone-shape';
        shape.style.width = `${spec.width}px`;
        shape.style.height = `${spec.height}px`;
        shape.style.borderRadius = spec.radius;
        // Subtle width-centering: shape is positioned at center of stone div
        shape.style.position = 'absolute';
        shape.style.left = '50%';
        shape.style.bottom = '0';
        shape.style.transform = 'translateX(-50%)';
        stone.appendChild(shape);

        stack.appendChild(stone);
        // Gap between stones — slightly less than the height for nesting
        cumulativeY += Math.max(7, spec.height - 4);
      }
    }

    function refreshFooter() {
      const el = document.getElementById('shs-count')!;
      const c = currentState.currentCairn;
      const total = currentState.lifetime;
      const toppleBtn = document.getElementById('shs-topple')! as HTMLButtonElement;
      toppleBtn.disabled = c === 0;
      if (total === 0) {
        el.innerHTML = 'your first visit';
      } else if (c === 0) {
        el.innerHTML = `you've stacked <strong>${total}</strong> stone${total === 1 ? '' : 's'} here altogether`;
      } else if (c === 1) {
        el.innerHTML = `<strong>1</strong> stone standing · <strong>${total}</strong> lifetime`;
      } else {
        el.innerHTML = `<strong>${c}</strong> stones standing · <strong>${total}</strong> lifetime`;
      }
    }

    function setStone() {
      currentState.currentCairn += 1;
      currentState.lifetime += 1;
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderStack();
      refreshFooter();
      playTock();
      const cairn = document.getElementById('shs-cairn')!;
      cairn.classList.add('shs__cairn--touched');
    }

    function toppleCairn() {
      const stack = document.getElementById('shs-stack')!;
      // Animate existing stones tumbling outward, then clear state
      const stones = Array.from(stack.children) as HTMLElement[];
      stones.forEach((s, idx) => {
        const dir = idx % 2 === 0 ? -1 : 1;
        const tx = (40 + idx * 4) * dir + (Math.random() * 30 - 15);
        const rot = (90 + idx * 12) * dir + (Math.random() * 60 - 30);
        s.style.setProperty('--topple-tx', `calc(-50% + ${tx}px)`);
        s.style.setProperty('--topple-rot', `${rot}deg`);
        s.classList.add('shs__stone--toppling');
      });
      // Soft cascade of tocks
      const tockCount = Math.min(4, currentState.currentCairn);
      for (let i = 0; i < tockCount; i++) {
        setTimeout(playTock, i * 90);
      }
      // After animation, clear state
      setTimeout(() => {
        currentState.currentCairn = 0;
        currentState.lastVisit = Date.now();
        saveState(currentState);
        renderStack();
        refreshFooter();
      }, 1100);
    }

    function init() {
      currentState = loadState();
      currentState.lastVisit = Date.now();
      saveState(currentState);
      renderStack();
      refreshFooter();

      // Tap the cairn area to add a stone
      const cairn = document.getElementById('shs-cairn')!;
      cairn.addEventListener('click', (e) => {
        e.preventDefault();
        setStone();
        ensureCtx();
        startAmbient();
      });
      // Explicit "+ set a stone" button (footer)
      document.getElementById('shs-add')!.addEventListener('click', () => {
        setStone();
        ensureCtx();
        startAmbient();
      });
      // Topple
      document.getElementById('shs-topple')!.addEventListener('click', toppleCairn);

      // Wake audio + ambient on first interaction anywhere
      const wake = () => {
        ensureCtx();
        startAmbient();
        document.removeEventListener('pointerdown', wake);
        document.removeEventListener('keydown', wake);
      };
      document.addEventListener('pointerdown', wake);
      document.addEventListener('keydown', wake);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAmbient();
        else if (ctx) startAmbient();
      });

      // Keyboard: Space/Enter sets a stone, Esc topples
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        if (e.code === 'Space' || e.code === 'Enter') {
          e.preventDefault();
          setStone();
          ensureCtx();
          startAmbient();
        } else if (e.key === 'Escape' && currentState.currentCairn > 0) {
          e.preventDefault();
          toppleCairn();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
