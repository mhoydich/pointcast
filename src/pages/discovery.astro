---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import rawAudit from '../../public/audits/discovery-2026-10-03.json';
import { CATEGORIES, STATUS_LABELS, SEVERITY_LABELS, sortFindings, isBotRequest, botHttpLabel, isActionable } from '../lib/discovery-dashboard.mjs';

// This page renders the saved public report. It does not initiate an audit.
const audit = rawAudit as any;
const findings = sortFindings(audit.findings || []);
const routes = audit.routes || [];
const uniqueRouteCount = new Set(routes.map((route) => route.url)).size;
const bots = audit.botChecks || [];
const botRequestCount = bots.filter(isBotRequest).length;
const policyOnlyCount = bots.length - botRequestCount;
const coverage = audit.coverage || [];
const actionable = findings.filter(isActionable);
const highPriority = actionable.filter((finding) => finding.severity === 'high');
const completedAt = audit.completedAt || audit.startedAt;
const validDate = Number.isFinite(Date.parse(completedAt));
const checkedDate = validDate ? new Intl.DateTimeFormat('en', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(completedAt)) : 'Date unavailable';
const checkedTime = validDate ? new Intl.DateTimeFormat('en', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' }).format(new Date(completedAt)) : '';
const canonical = 'https://pointcast.xyz/discovery/';
const reportPath = '/audits/discovery-2026-10-03.json';
const title = 'Discovery audit — PointCast';
const description = 'An evidence-backed PointCast audit of technical SEO, agent discovery, bot access and AI-search readiness. Explore a dated snapshot and download the report.';
const label = (status) => STATUS_LABELS[status] || String(status || 'Unmeasured');
const categoryLabel = (category) => CATEGORIES.find((item) => item.id === category)?.short || category;
const searchText = (record) => JSON.stringify(record);
const ratio = (item) => typeof item.total === 'number' && item.total > 0 ? Math.min(100, Math.max(0, item.checked / item.total * 100)) : 0;
const referenceUrl = (reference) => reference.url || reference.href;
const ruleText = (rule) => typeof rule === 'object' && rule ? `${rule.directive || ''}: ${rule.pattern || ''}` : String(rule || 'No matching rule');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical,
  url: canonical, name: title, description, inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', '@id': 'https://pointcast.xyz/#website', name: 'PointCast', url: 'https://pointcast.xyz/' },
  associatedMedia: { '@type': 'DigitalDocument', name: 'PointCast public discovery audit snapshot', url: `https://pointcast.xyz${reportPath}`, encodingFormat: 'application/json' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2449e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://pointcast.xyz/images/og/og-home-v5.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pointcast.xyz/images/og/og-home-v5.png" />
    <link rel="alternate" type="application/json" title="Public discovery audit report" href={reportPath} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
  </head>
  <body class="dc" data-completed-at={completedAt} data-report-path={reportPath}>
    <a class="dc-skip" href="#main">Skip to audit</a>
    <header class="dc-header">
      <a class="dc-brand" href="/" aria-label="PointCast home"><span class="dc-brand-mark" aria-hidden="true">⌐◨-◨</span>pointcast<span class="dc-brand-dot">.</span></a>
      <span class="dc-desk">Discovery desk <span>/ 01</span></span>
      <nav aria-label="Audit navigation"><a href="#findings">Findings</a><a href="#routes">Routes</a><a href="#method">Method</a><a class="dc-header-download" href={reportPath} download>Report <span aria-hidden="true">↓</span></a></nav>
    </header>

    <main id="main">
      <section class="dc-hero dc-shell" aria-labelledby="audit-title">
        <div class="dc-hero-copy">
          <p class="dc-eyebrow"><span class="dc-square" aria-hidden="true"></span> Search · software · signals</p>
          <h1 id="audit-title">Can the web<br />read <span>PointCast?</span></h1>
          <p class="dc-dek">An evidence-backed look at how PointCast meets search engines, AI assistants and the agents that move between them.</p>
          <div class="dc-hero-actions"><a class="dc-button dc-button-blue" href="#findings">Inspect the findings <span aria-hidden="true">↗</span></a><a class="dc-text-link" href={reportPath} download>Download JSON <span aria-hidden="true">↓</span></a></div>
          <p class="dc-boundary">One public-site snapshot. Readiness is measured here; real search rankings and AI citations are not.</p>
        </div>
        <aside class="dc-instrument" aria-label="Four areas of the audit">
          <div class="dc-instrument-top"><span>POINTCAST.XYZ</span><span>PUBLIC SIGNAL</span></div>
          <div class="dc-radar" aria-hidden="true">
            <svg viewBox="0 0 440 250" fill="none">
              <path d="M0 125H440M220 0V250" stroke="currentColor" opacity=".2" />
              <ellipse cx="220" cy="125" rx="152" ry="108" stroke="currentColor" opacity=".22" />
              <ellipse cx="220" cy="125" rx="99" ry="70" stroke="currentColor" opacity=".3" />
              <ellipse cx="220" cy="125" rx="45" ry="32" stroke="currentColor" opacity=".4" />
              <path d="M71 68 220 125 359 178M117 192 220 125 330 45" stroke="currentColor" opacity=".45" />
              <circle cx="71" cy="68" r="9" fill="#c2f4d6"/><circle cx="330" cy="45" r="9" fill="#e8e4ff"/><circle cx="359" cy="178" r="9" fill="#ffcd79"/><circle cx="117" cy="192" r="9" fill="#f7f3e9"/>
              <rect x="184" y="105" width="72" height="40" rx="3" fill="#f7f3e9"/>
              <path d="M195 115H213V133H195ZM227 115H245V133H227ZM213 122H227M190 115H195" stroke="#2449e8" stroke-width="3"/>
              <text x="87" y="63" fill="currentColor" font-size="10" letter-spacing="1.5">SEO</text><text x="343" y="40" fill="currentColor" font-size="10" letter-spacing="1.5">AGENTS</text><text x="373" y="193" fill="currentColor" font-size="10" letter-spacing="1.5">BOTS</text><text x="61" y="212" fill="currentColor" font-size="10" letter-spacing="1.5">AI SEARCH</text>
            </svg>
            <span class="dc-radar-caption">DISCOVER → FETCH → READ → UNDERSTAND</span>
          </div>
          <div class="dc-instrument-bottom"><p>A map of access.<br /><strong>Not a visibility score.</strong></p><span aria-hidden="true">↗</span></div>
        </aside>
      </section>

      <div class="dc-snapshot" role="note">
        <div class="dc-shell dc-snapshot-inner"><p><span class="dc-snapshot-symbol" aria-hidden="true">◷</span><strong>Frozen snapshot</strong> <time datetime={completedAt}>{checkedDate} · {checkedTime} UTC</time></p><p><span id="snapshot-age">Age calculated when opened</span><span id="snapshot-stale" hidden> · Recheck recommended</span></p><span>No live monitoring</span></div>
      </div>

      <section class="dc-summary dc-shell" aria-label="Audit summary">
        <div class="dc-stat"><p>Actionable findings</p><strong>{actionable.length}<span class="dc-stat-dot dc-dot-amber" aria-hidden="true"></span></strong><span>{highPriority.length} high priority · issues + reviews</span></div>
        <div class="dc-stat"><p>Public URLs sampled</p><strong>{uniqueRouteCount}<span class="dc-stat-slash" aria-hidden="true">/</span></strong><span>{routes.length} HTTP + document check records</span></div>
        <div class="dc-stat"><p>Bot requests sampled</p><strong>{botRequestCount}<span class="dc-stat-dot dc-dot-mint" aria-hidden="true"></span></strong><span>Synthetic requests · {policyOnlyCount} additional policy tokens</span></div>
        <div class="dc-stat dc-stat-unmeasured"><p>Actual search visibility</p><strong>—<span>Unmeasured</span></strong><span>No traffic, ranking or citation claim</span></div>
      </section>

      <section class="dc-section dc-shell" id="coverage" aria-labelledby="coverage-title">
        <div class="dc-section-heading"><div><p class="dc-eyebrow">01 / What was checked</p><h2 id="coverage-title">Coverage, in context.</h2></div><p>Counts describe the saved audit’s scope. A sampled route is not the entire site, and a passing request does not prove indexing.</p></div>
        <div class="dc-category-grid">{CATEGORIES.map((category) => {
          const items = findings.filter((finding) => finding.category === category.id);
          const issues = items.filter(isActionable).length;
          return <article class="dc-category-card"><div class="dc-category-top"><span>{category.short}</span><span aria-hidden="true">↗</span></div><h3>{category.label}</h3><p>{category.description}</p><div class="dc-category-count"><strong>{items.length}</strong><span>recorded findings<br />{issues} actionable</span></div></article>;
        })}</div>
        <div class="dc-coverage-list">{coverage.map((item) => <div class="dc-coverage-row"><div><strong>{item.label}</strong><p>{item.note}</p></div><div class="dc-coverage-numbers"><strong>{item.checked}</strong><span> / {item.total ?? 'unknown'} {item.unit || 'checks'}</span><div class="dc-track" role="img" aria-label={`${item.checked} of ${item.total ?? 'unknown'} ${item.unit || 'checks'} checked`}><span style={`width:${ratio(item)}%`}></span></div></div></div>)}</div>
      </section>

      <section class="dc-section dc-shell" id="findings" aria-labelledby="findings-title">
        <div class="dc-section-heading"><div><p class="dc-eyebrow">02 / Evidence → action</p><h2 id="findings-title">Make the signal clearer.</h2></div><p>Findings are ordered by priority. Open a card for the observation, its impact and the next useful action.</p></div>
        <form class="dc-filter-panel" id="audit-filters" aria-label="Filter audit evidence">
          <div class="dc-category-filters" role="group" aria-label="Audit category"><button type="button" data-category-filter="all" aria-pressed="true" data-enhancement disabled>All areas</button>{CATEGORIES.map((category) => <button type="button" data-category-filter={category.id} aria-pressed="false" data-enhancement disabled>{category.short}</button>)}</div>
          <div class="dc-filter-fields"><div class="dc-search-field"><label for="route-search">Search routes or findings</label><div><span aria-hidden="true">⌕</span><input id="route-search" name="query" type="search" autocomplete="off" placeholder="Try /for-agents or canonical" data-enhancement disabled /></div></div><div><label for="status-filter">Result status</label><select id="status-filter" name="status" data-enhancement disabled><option value="all">All statuses</option>{Object.entries(STATUS_LABELS).map(([value, name]) => <option value={value}>{name}</option>)}</select></div><label class="dc-actionable-toggle"><input id="actionable-filter" name="actionable" type="checkbox" data-enhancement disabled /> Actionable only</label><button class="dc-reset" type="reset" data-enhancement disabled>Reset filters <span aria-hidden="true">↺</span></button></div>
          <div class="dc-filter-footer"><p id="filter-result" role="status" aria-live="polite">Showing all {findings.length} findings, {routes.length} route records and {bots.length} bot records</p><button type="button" id="csv-download" data-enhancement disabled>Download filtered CSV <span aria-hidden="true">↓</span></button></div>
        </form>
        <noscript><p class="dc-noscript">All saved evidence is available below. Interactive filters and CSV export need JavaScript; the full JSON report can be downloaded without it.</p></noscript>
        <div class="dc-legend" aria-label="Result meanings"><span><i class="dc-dot-mint" aria-hidden="true"></i>Pass: check satisfied</span><span><i class="dc-dot-red" aria-hidden="true"></i>Issue: observed defect</span><span><i class="dc-dot-amber" aria-hidden="true"></i>Review: needs attention</span><span><i class="dc-dot-gray" aria-hidden="true"></i>Expected: deliberate behavior</span><span><i class="dc-dot-purple" aria-hidden="true"></i>Unmeasured: no evidence collected</span></div>
        <div class="dc-findings">{findings.map((finding, index) => <article class={`dc-finding dc-state-${finding.status}`} data-audit-record="finding" data-category={finding.category} data-status={finding.status} data-severity={finding.severity} data-search={searchText(finding)} id={`finding-${finding.id}`}><div class="dc-finding-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><div class="dc-finding-main"><div class="dc-finding-tags"><span class={`dc-badge dc-badge-${finding.status}`}>{label(finding.status)}</span><span>{categoryLabel(finding.category)}</span><span>{SEVERITY_LABELS[finding.severity] || 'Observation'}</span><span class="dc-finding-id">{finding.id}</span></div><h3>{finding.title}</h3><p>{finding.summary}</p><details><summary>Evidence &amp; next action <span aria-hidden="true">+</span></summary><div class="dc-finding-detail"><div><h4>Why it matters</h4><p>{finding.impact || 'See the observed evidence for the scope of this check.'}</p><h4>Recommended action</h4><p>{finding.recommendation || 'Retain this behavior and recheck when the surface changes.'}</p></div><div class="dc-evidence"><h4>Observed evidence</h4><ul>{(finding.evidence || []).map((evidence) => <li><a href={evidence.url}>{evidence.url}<span aria-hidden="true"> ↗</span></a><p>{evidence.observed}</p></li>)}</ul></div></div></details></div></article>)}</div>
        <p class="dc-empty" id="findings-empty" hidden>No findings match these filters. Try another area, status or route.</p>
      </section>

      <section class="dc-geo-section" aria-labelledby="geo-title"><div class="dc-shell dc-geo-grid"><div><p class="dc-eyebrow">A boundary worth keeping visible</p><h2 id="geo-title">Readable ≠ recommended.</h2></div><div><p>GEO here means generative-engine optimization: how well the site offers accessible, clear and attributable material for AI search to use.</p><p>These checks cannot tell us whether an assistant actually cites PointCast. Search Console indexing, search rankings, referral traffic and controlled AI citation tests require separate measurements.</p><span class="dc-badge dc-badge-unmeasured">Real visibility: unmeasured</span></div></div></section>

      <section class="dc-section dc-shell" id="routes" aria-labelledby="routes-title">
        <div class="dc-section-heading"><div><p class="dc-eyebrow">03 / Open the document</p><h2 id="routes-title">Route inspection.</h2></div><p><span id="route-count">{routes.length}</span> check records across {uniqueRouteCount} unique sampled URLs. HTTP status and audit result are separate: an intentional gate or redirect can be expected behavior.</p></div>
        <div class="dc-route-header" aria-hidden="true"><span>Route / surface</span><span>Kind</span><span>HTTP</span><span>Audit result</span></div>
        <div class="dc-route-list">{routes.map((route) => <details class="dc-route" data-audit-record="route" data-category={route.category} data-status={route.status} data-search={searchText(route)}><summary><span class="dc-route-path"><span aria-hidden="true">+</span><span>{route.path}</span></span><span class="dc-route-kind">{route.kind}</span><span class="dc-http"><span class="dc-mobile-label">HTTP </span>{route.httpStatus ?? '—'}</span><span class={`dc-badge dc-badge-${route.status}`}>{label(route.status)}</span></summary><div class="dc-route-detail"><div class="dc-route-detail-top"><a href={route.url}>Open source <span aria-hidden="true">↗</span></a><span>Checked <time datetime={route.checkedAt}>{route.checkedAt || completedAt}</time></span></div>{typeof route.summary === 'string' ? <p class="dc-route-summary">{route.summary}</p> : route.summary && <details class="dc-response-summary"><summary>Saved response summary <span aria-hidden="true">+</span></summary><pre>{JSON.stringify(route.summary, null, 2)}</pre></details>}<dl class="dc-route-metadata"><div><dt>Final URL</dt><dd>{route.finalUrl || route.url}</dd></div><div><dt>Content type</dt><dd>{route.contentType || 'Not recorded'}</dd></div>{route.metadata && <><div><dt>Title</dt><dd>{route.metadata.title || 'Not observed'}</dd></div><div><dt>Description</dt><dd>{route.metadata.description || 'Not observed'}</dd></div><div><dt>Canonical</dt><dd>{route.metadata.canonical || 'Not observed'}</dd></div><div><dt>Document signals</dt><dd>{route.metadata.h1Count ?? '—'} H1 · {route.metadata.jsonLdCount ?? '—'} JSON-LD · {route.metadata.textWordCount ?? '—'} text words · {route.metadata.internalLinkCount ?? '—'} internal links<br />{route.metadata.noindex ? 'Noindex observed' : 'Noindex not observed'}</dd></div></>}</dl>{(route.checks || []).length > 0 && <ul class="dc-route-checks">{route.checks.map((check) => <li><span class={`dc-badge dc-badge-${check.status}`}>{label(check.status)}</span><div><strong>{check.label}</strong><p>{check.observed}</p></div></li>)}</ul>}{(route.evidence || []).length > 0 && <ul class="dc-route-evidence">{route.evidence.map((item) => <li><a href={item.url}>{item.url}</a><p>{item.observed}</p></li>)}</ul>}</div></details>)}</div>
        <p class="dc-empty" id="routes-empty" hidden>No sampled routes match these filters.</p>
      </section>

      <section class="dc-section dc-shell" id="bots" aria-labelledby="bots-title">
        <div class="dc-section-heading"><div><p class="dc-eyebrow">04 / The access layer</p><h2 id="bots-title">Rules meet requests.</h2></div><p><span id="bot-count">{bots.length}</span> bot policy / probe records. A user-agent label in a test request is not proof of a verified crawler visit, indexing or edge treatment for the real bot.</p></div>
        <div class="dc-table-wrap" tabindex="0" role="region" aria-label="Bot request results. Scroll horizontally if needed."><table class="dc-bot-table"><caption class="dc-sr">Synthetic bot request and declared robots policy observations</caption><thead><tr><th scope="col">Crawler / purpose</th><th scope="col">Declared robots</th><th scope="col">HTTP / route</th><th scope="col">Observation</th></tr></thead><tbody>{bots.map((bot) => <tr data-audit-record="bot" data-category="bots" data-status={bot.status} data-search={searchText({ ...bot, category: 'bots' })}><th scope="row"><strong>{bot.name}</strong><code>{bot.userAgent}</code>{bot.purpose && <p>{bot.purpose}</p>}</th><td>{typeof bot.robots?.allowed === 'boolean' ? <span class={`dc-policy ${bot.robots.allowed ? 'dc-policy-allowed' : 'dc-policy-blocked'}`}>{bot.robots.allowed ? 'Allowed' : 'Disallowed'}</span> : 'Not evaluated'}{bot.robots?.group && <small>Group: {Array.isArray(bot.robots.group) ? bot.robots.group.join(', ') : bot.robots.group}</small>}{bot.robots?.matchedRule && <small>Matched: {ruleText(bot.robots.matchedRule)}</small>}{Array.isArray(bot.robots?.rules) && bot.robots.rules.length > 0 && <details class="dc-bot-rules"><summary>All {bot.robots.rules.length} group rules <span aria-hidden="true">+</span></summary><ul>{bot.robots.rules.map((rule) => <li>{ruleText(rule)}</li>)}</ul></details>}</td><td><strong>{botHttpLabel(bot)}</strong><code>{bot.path}</code><span class={`dc-badge dc-badge-${bot.status}`}>{label(bot.status)}</span></td><td><p>{bot.observed}</p>{bot.note && <small>{bot.note}</small>}<time datetime={bot.checkedAt}>{bot.checkedAt}</time></td></tr>)}</tbody></table></div>
        <p class="dc-empty" id="bots-empty" hidden>No bot policy / probe records match these filters.</p>
      </section>

      <section class="dc-section dc-shell" id="method" aria-labelledby="method-title">
        <div class="dc-section-heading"><div><p class="dc-eyebrow">05 / Show the working</p><h2 id="method-title">An audit you can inspect.</h2></div><p>The report keeps dates, evidence and coverage alongside each result. These are observed checks and recommendations, with no invented SEO score.</p></div>
        <div class="dc-method-grid"><div class="dc-method-note"><h3>What this snapshot can say</h3><p>It records public responses, document signals and machine-readable discovery surfaces. Findings distinguish observed defects, review items, expected gates and unmeasured outcomes.</p><h3>Where it stops</h3><ul>{(audit.limitations || []).map((limitation) => <li>{typeof limitation === 'string' ? limitation : limitation.description || limitation.note || limitation.title}</li>)}</ul><p class="dc-staleness-note">The age label changes in your browser. After seven days, this page recommends a recheck; the underlying observations stay frozen until a new report is published.</p></div><div class="dc-method-report"><p class="dc-eyebrow">Take the evidence with you</p><h3>The full public report.</h3><p>Every saved finding, route record, bot policy / probe record, coverage denominator and reference in a portable JSON snapshot.</p><dl><div><dt>Checked</dt><dd>{checkedDate} · {checkedTime} UTC</dd></div><div><dt>Report format</dt><dd>JSON · schema {audit.schemaVersion}</dd></div><div><dt>Site</dt><dd><a href="https://pointcast.xyz/">pointcast.xyz</a></dd></div></dl><a class="dc-button dc-button-blue" href={reportPath} download>Download full JSON <span aria-hidden="true">↓</span></a><a class="dc-text-link" href={reportPath}>Read the raw report <span aria-hidden="true">↗</span></a><p class="dc-small">CSV export above follows your selected filters. JSON always contains the full saved report.</p></div></div>
        <details class="dc-references"><summary>Official standards &amp; crawler documentation <span>{(audit.references || []).length} references <b aria-hidden="true">+</b></span></summary><ul>{(audit.references || []).map((reference) => <li><a href={referenceUrl(reference)}>{reference.title || reference.name || referenceUrl(reference)} <span aria-hidden="true">↗</span></a>{(reference.note || reference.summary || reference.relevance) && <p>{reference.note || reference.summary || reference.relevance}</p>}</li>)}</ul></details>
      </section>
    </main>

    <footer class="dc-footer dc-shell"><a class="dc-brand" href="/">pointcast<span class="dc-brand-dot">.</span></a><p>Readable by people.<br />Inspectable by software.</p><nav aria-label="PointCast discovery links"><a href="/for-agents">For agents ↗</a><a href="/llms.txt">llms.txt ↗</a><a href="/robots.txt">robots.txt ↗</a><a href="#audit-title">Back to top ↑</a></nav></footer>

    <script>
      import { matchesFilters, snapshotAge, filteredCsv } from '../lib/discovery-dashboard.mjs';

      const body = document.querySelector<HTMLBodyElement>('.dc');
      const form = document.querySelector<HTMLFormElement>('#audit-filters');
      const query = document.querySelector<HTMLInputElement>('#route-search');
      const status = document.querySelector<HTMLSelectElement>('#status-filter');
      const actionable = document.querySelector<HTMLInputElement>('#actionable-filter');
      const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
      const records = [...document.querySelectorAll<HTMLElement>('[data-audit-record]')];
      let category = 'all';
      const currentFilters = () => ({ category, status: status.value, query: query.value, actionable: actionable.checked });
      const applyFilters = () => {
        const counts = { finding: 0, route: 0, bot: 0 };
        const filters = currentFilters();
        for (const element of records) {
          const visible = matchesFilters({ category: element.dataset.category, status: element.dataset.status, severity: element.dataset.severity, search: element.dataset.search }, filters);
          element.hidden = !visible;
          if (visible) counts[element.dataset.auditRecord] += 1;
        }
        document.getElementById('filter-result').textContent = `Showing ${counts.finding} of ${records.filter((element) => element.dataset.auditRecord === 'finding').length} findings, ${counts.route} of ${records.filter((element) => element.dataset.auditRecord === 'route').length} route records and ${counts.bot} of ${records.filter((element) => element.dataset.auditRecord === 'bot').length} bot records`;
        document.getElementById('route-count').textContent = String(counts.route);
        document.getElementById('bot-count').textContent = String(counts.bot);
        for (const [kind, id] of [['finding', 'findings-empty'], ['route', 'routes-empty'], ['bot', 'bots-empty']]) document.getElementById(id).hidden = counts[kind] > 0;
      };
      for (const button of categoryButtons) button.addEventListener('click', () => {
        category = button.dataset.categoryFilter;
        for (const item of categoryButtons) item.setAttribute('aria-pressed', String(item === button));
        applyFilters();
      });
      form.addEventListener('submit', (event) => event.preventDefault());
      query.addEventListener('input', applyFilters);
      status.addEventListener('change', applyFilters);
      actionable.addEventListener('change', applyFilters);
      form.addEventListener('reset', () => {
        category = 'all';
        query.value = '';
        status.value = 'all';
        actionable.checked = false;
        for (const button of categoryButtons) button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === 'all'));
        applyFilters();
      });
      const age = snapshotAge(body.dataset.completedAt);
      document.getElementById('snapshot-age').textContent = age.label;
      document.getElementById('snapshot-stale').hidden = !age.stale;
      body.classList.toggle('dc-stale', age.stale);
      document.querySelectorAll<HTMLInputElement | HTMLButtonElement | HTMLSelectElement>('[data-enhancement]').forEach((element) => { element.disabled = false; });
      document.getElementById('csv-download').addEventListener('click', async (event) => {
