---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'The Listening Grove';
const description =
  'The PointCast edition of a 617-work audiovisual Midjourney archive with generative bells, gongs, swipe navigation, variable pacing, and optional haptics.';
const standaloneUrl = 'https://the-listening-grove.mhoydich.chatgpt.site';
---

<BaseLayout
  title={title}
  description={description}
  image="/images/listening-grove-review/listening-grove-review-og.jpg"
  hideNav={true}
>
  <div class="listening-shell">
    <header>
      <a class="brand" href="/">POINTCAST</a>
      <div class="title">
        <strong>THE LISTENING GROVE</strong>
        <span>617 WORKS · AUDIOVISUAL SCORE · TEZOS PREVIEW</span>
      </div>
      <a href="/reviews/the-listening-grove">READ REVIEW</a>
      <a href={standaloneUrl}>STANDALONE ↗</a>
    </header>
    <iframe
      src={standaloneUrl}
      title="The Listening Grove interactive audiovisual art experience"
      allow="autoplay; fullscreen"
      allowfullscreen
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <noscript>
      <p><a href={standaloneUrl}>Open The Listening Grove standalone experience.</a></p>
    </noscript>
  </div>

  <style is:global>
    body:has(.listening-shell) { overflow: hidden; padding: 0 !important; background: #10120f !important; }
    body:has(.listening-shell) > :not(main) { display: none !important; }
    body:has(.listening-shell) main { min-height: 100svh; }
    .listening-shell { height: 100svh; display: grid; grid-template-rows: 48px 1fr; background: #10120f; }
    .listening-shell header {
      min-width: 0; display: flex; align-items: center; gap: 18px; padding: 0 16px;
      background: #10120f; color: white; border-bottom: 1px solid rgba(255,255,255,.16);
      font: 700 10px/1 'JetBrains Mono', monospace; letter-spacing: .07em;
    }
    .listening-shell header a { color: inherit; text-decoration: none; white-space: nowrap; }
    .listening-shell .brand { color: #e5dd61; font-size: 13px; }
    .listening-shell .title { min-width: 0; margin-right: auto; display: flex; align-items: center; gap: 12px; }
    .listening-shell .title strong, .listening-shell .title span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .listening-shell .title span { color: rgba(255,255,255,.58); font-size: 8px; }
    .listening-shell iframe { width: 100%; height: 100%; border: 0; background: #e8e5d8; }
    @media (max-width: 700px) {
      .listening-shell { grid-template-rows: 54px 1fr; }
      .listening-shell header { gap: 11px; padding-inline: 12px; }
      .listening-shell .title { display: none; }
      .listening-shell .brand { margin-right: auto; }
      .listening-shell header a { font-size: 8px; }
    }
  </style>
</BaseLayout>
