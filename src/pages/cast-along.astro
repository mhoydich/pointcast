---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Along — tap with whatever you're hearing" description="A tap-along surface. Tap with the music you're hearing — in your head, on Spotify in another tab, from a car going by. See your BPM, your drift, your steadiest run. Spotify has no verbs. This is one.">
  <main class="ca" id="ca" data-built={built}>
    <header class="ca__hero">
      <p class="ca__kicker">CAST · ALONG · tap with whatever is playing</p>
      <h1 class="ca__title">Tap along.</h1>
      <p class="ca__sub">Whatever you're hearing — Spotify in another tab, a car going by, music in your head — tap with the beat. Space, click, or touch. You'll see your BPM, your drift, and how long you can hold a steady run.</p>
    </header>

    <section class="ca__stage">
      <button class="ca__tap" id="ca-tap" type="button" aria-label="Tap for a beat">
        <div class="ca__tap-ring" id="ca-tap-ring"></div>
        <div class="ca__tap-core">
          <span class="ca__tap-bpm" id="ca-tap-bpm">—</span>
          <span class="ca__tap-bpm-unit" id="ca-tap-bpm-unit">listening…</span>
        </div>
      </button>
      <p class="ca__hint" id="ca-hint">Tap the circle, press <kbd>Space</kbd>, or click anywhere on this page. Eight taps in and we'll lock onto your tempo.</p>
    </section>

    <section class="ca__stats">
      <div class="ca__stat">
        <span class="ca__stat-label">TAPS</span>
        <span class="ca__stat-val" id="ca-stat-taps">0</span>
      </div>
      <div class="ca__stat">
        <span class="ca__stat-label">DRIFT</span>
        <span class="ca__stat-val" id="ca-stat-drift">—</span>
        <span class="ca__stat-sub" id="ca-stat-drift-sub">ms variance</span>
      </div>
      <div class="ca__stat">
        <span class="ca__stat-label">STEADIEST</span>
        <span class="ca__stat-val" id="ca-stat-streak">0</span>
        <span class="ca__stat-sub">in a row</span>
      </div>
      <div class="ca__stat">
        <span class="ca__stat-label">FEEL</span>
        <span class="ca__stat-val ca__stat-val--small" id="ca-stat-feel">—</span>
      </div>
    </section>

    <section class="ca__trace-wrap">
      <p class="ca__trace-label">TEMPO over last 64 taps</p>
      <svg class="ca__trace" id="ca-trace" viewBox="0 0 640 120" preserveAspectRatio="none">
        <line x1="0" y1="30" x2="640" y2="30" stroke="rgba(244,231,200,0.08)" stroke-dasharray="4 4"/>
        <line x1="0" y1="60" x2="640" y2="60" stroke="rgba(244,231,200,0.12)"/>
        <line x1="0" y1="90" x2="640" y2="90" stroke="rgba(244,231,200,0.08)" stroke-dasharray="4 4"/>
        <text x="6" y="12" class="ca__trace-axis-label">fast</text>
        <text x="6" y="115" class="ca__trace-axis-label">slow</text>
        <polyline id="ca-trace-line" fill="none" stroke="#f6c15e" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points=""/>
      </svg>
      <p class="ca__trace-hint" id="ca-trace-hint">Your tempo line will start drawing once you've tapped ~8 times.</p>
    </section>

    <section class="ca__controls">
      <button class="ca__ctl-btn ca__ctl-btn--primary" id="ca-click-toggle" type="button" aria-pressed="false">
        <span class="ca__ctl-icon">●</span>
        <span class="ca__ctl-label">Click on the grid</span>
      </button>
      <button class="ca__ctl-btn" id="ca-reset" type="button">
        <span class="ca__ctl-icon">↺</span>
        <span class="ca__ctl-label">Reset</span>
      </button>
      <div class="ca__ctl-info" id="ca-ctl-info">A soft click on your inferred grid helps you hear where you've landed. Toggle on once you've locked a tempo.</div>
    </section>

    <section class="ca__band">
      <p class="ca__band-label">YOUR LAST 12 INTER-TAP GAPS</p>
      <div class="ca__band-row" id="ca-band-row"></div>
    </section>

    <section class="ca__notes">
      <h2 class="ca__notes-h">What this is for</h2>
      <p>Spotify and Apple Music have a billion verbs you can do <em>to</em> a track — like, queue, save, share. They have <em>zero</em> verbs that ride <em>with</em> a track while it's playing. /cast-along is one verb: <strong>tap</strong>.</p>
      <p>Tap with whatever you're hearing. The page doesn't know what you're listening to, doesn't need to — it just measures the gaps between your taps and tells you what tempo you settled at, how much you drifted, how long you held it.</p>
      <p>Pair with <a href="/cast-jam">/cast-jam</a> for keys-locked melody play-along, <a href="/cast-loop">/cast-loop</a> for layered loops, <a href="/cast-metronome">/cast-metronome</a> for hard time, <a href="/cast-pulse">/cast-pulse</a> for grid composition, <a href="/cast-wander">/cast-wander</a> for generative ambient, <a href="/cast-wheel">/cast-wheel</a> for harmonic geography, <a href="/cast-tone">/cast-tone</a> for tuning drones.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --ca-ink: #1a0820;
      --ca-walnut: #5a3422;
      --ca-walnut-dark: #2f1a0e;
      --ca-flame: #f6c15e;
      --ca-flame-deep: #d68f2c;
      --ca-cream: #f4e7c8;
      --ca-cream-dim: #d9c89e;
      --ca-mint: #9bd7b8;
      --ca-rose: #e6788c;
    }

    body:has(.ca) {
      background: radial-gradient(circle at 50% -10%, #2c1410 0%, var(--ca-ink) 65%);
      color: var(--ca-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .ca {
      max-width: 920px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    .ca__hero { text-align: center; margin-bottom: 32px; }
    .ca__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--ca-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .ca__title {
      font-family: 'Inter Tight', 'Inter', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 140px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--ca-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.45);
    }
    .ca__sub {
      max-width: 640px;
      margin: 0 auto;
      font-size: 17px;
      line-height: 1.5;
      color: var(--ca-cream-dim);
    }

    /* STAGE */
    .ca__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      margin: 40px 0 32px;
    }
    .ca__tap {
      position: relative;
      width: clamp(220px, 56vw, 340px);
      height: clamp(220px, 56vw, 340px);
      border: 0;
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
      padding: 0;
    }
    .ca__tap-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid var(--ca-flame);
      box-shadow: 0 0 60px rgba(246,193,94,0.18);
      transition: transform 60ms ease, box-shadow 60ms ease, border-color 80ms ease;
    }
    .ca__tap:hover .ca__tap-ring {
      box-shadow: 0 0 80px rgba(246,193,94,0.32);
    }
    .ca__tap--flash .ca__tap-ring {
      transform: scale(0.92);
      border-color: var(--ca-cream);
      box-shadow: 0 0 110px rgba(246,193,94,0.6);
    }
    .ca__tap--pulse .ca__tap-ring {
      animation: caPulse 1s ease-out;
    }
    @keyframes caPulse {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1.18); opacity: 0; }
    }
    .ca__tap-core {
      position: absolute;
      inset: 18%;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, rgba(246,193,94,0.28), rgba(246,193,94,0.02) 70%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      pointer-events: none;
    }
    .ca__tap-bpm {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(40px, 10vw, 72px);
      color: var(--ca-flame);
      line-height: 1;
    }
    .ca__tap-bpm-unit {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--ca-cream-dim);
      text-transform: uppercase;
    }
    .ca__hint {
      max-width: 480px;
      text-align: center;
      font-size: 14px;
      color: var(--ca-cream-dim);
      line-height: 1.55;
      margin: 0;
    }
    .ca__hint kbd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 4px;
      border: 1px solid rgba(244,231,200,0.3);
      background: rgba(244,231,200,0.06);
    }

    /* STATS */
    .ca__stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }
    @media (max-width: 600px) { .ca__stats { grid-template-columns: 1fr 1fr; } }
    .ca__stat {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .ca__stat-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--ca-cream-dim);
    }
    .ca__stat-val {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 26px;
      color: var(--ca-flame);
      line-height: 1;
    }
    .ca__stat-val--small {
      font-size: 18px;
      color: var(--ca-cream);
    }
    .ca__stat-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--ca-cream-dim);
    }

    /* TRACE */
    .ca__trace-wrap {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 18px;
      padding: 18px 20px;
      margin-bottom: 28px;
    }
    .ca__trace-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--ca-cream-dim);
      margin: 0 0 10px;
    }
    .ca__trace {
      width: 100%;
      height: 120px;
      border-radius: 10px;
      background: rgba(0,0,0,0.2);
      display: block;
    }
    .ca__trace-axis-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px;
      letter-spacing: 0.12em;
      fill: var(--ca-cream-dim);
    }
    .ca__trace-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--ca-cream-dim);
      margin: 8px 0 0;
    }

    /* CONTROLS */
    .ca__controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }
    .ca__ctl-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--ca-cream);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 14px;
      transition: background 100ms ease;
    }
    .ca__ctl-btn:hover { background: rgba(246,193,94,0.12); }
    .ca__ctl-btn--primary[aria-pressed="true"] {
      background: var(--ca-flame);
      color: var(--ca-walnut-dark);
      border-color: var(--ca-flame);
    }
    .ca__ctl-icon { font-size: 13px; }
    .ca__ctl-info {
      flex: 1;
      min-width: 200px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--ca-cream-dim);
      line-height: 1.5;
    }

    /* BAND */
    .ca__band {
      background: rgba(0,0,0,0.22);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 18px;
      padding: 16px 20px 18px;
      margin-bottom: 28px;
    }
    .ca__band-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--ca-cream-dim);
      margin: 0 0 10px;
    }
    .ca__band-row {
      display: flex;
      gap: 4px;
      align-items: end;
      height: 60px;
    }
    .ca__band-bar {
      flex: 1;
      min-width: 6px;
      background: var(--ca-flame);
      border-radius: 3px 3px 0 0;
      transition: height 80ms ease, background 100ms ease;
    }
    .ca__band-bar--off-grid { background: var(--ca-rose); }
    .ca__band-bar--steady { background: var(--ca-mint); }
    .ca__band-row:empty::before {
      content: 'tap to start';
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--ca-cream-dim);
      align-self: center;
      margin: 0 auto;
    }

    /* NOTES */
    .ca__notes {
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
      max-width: 720px;
      margin: 0 auto;
    }
    .ca__notes-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--ca-cream);
      margin: 0 0 14px;
    }
    .ca__notes p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--ca-cream-dim);
      margin: 0 0 12px;
    }
    .ca__notes strong { color: var(--ca-cream); }
    .ca__notes em { color: var(--ca-flame); font-style: normal; }
    .ca__notes a {
      color: var(--ca-flame);
      text-decoration: none;
    }
    .ca__notes a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- state ----
    const taps: number[] = [];                 // performance.now() timestamps
    const gaps: number[] = [];                 // inter-tap gaps in ms
    const tempoHistory: number[] = [];         // BPM over time
    let lastTap = 0;
    let bestStreak = 0;
    let currentStreak = 0;
    let clickOn = false;
    let clickTimer: number | null = null;
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;

    const MAX_GAPS = 12;
    const MAX_HISTORY = 64;
    const MAX_TAPS = 256;
    const RESET_THRESHOLD_MS = 3000;  // 3s pause resets the streak

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
    }

    function playClick(t: number, accent = false) {
      if (!ctx || !scheduler) return;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'square';
      osc.frequency.value = accent ? 1800 : 1200;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(accent ? 0.32 : 0.18, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.04);
      osc.connect(g).connect(ctx.destination);
      scheduler.trackSource(osc);
      osc.start(t);
      osc.stop(t + 0.06);
    }

    function flashTap() {
      const tap = document.getElementById('ca-tap')!;
      tap.classList.add('ca__tap--flash');
      tap.classList.add('ca__tap--pulse');
      setTimeout(() => tap.classList.remove('ca__tap--flash'), 100);
      setTimeout(() => tap.classList.remove('ca__tap--pulse'), 1000);
    }

    function median(arr: number[]): number {
      if (arr.length === 0) return 0;
      const s = [...arr].sort((a, b) => a - b);
      return s[Math.floor(s.length / 2)];
    }

    function inferBPM(): number | null {
      // Use median of last 8 gaps if we have them
      if (gaps.length < 4) return null;
      const recent = gaps.slice(-8);
      const med = median(recent);
      if (med <= 0) return null;
      const bpm = Math.round(60000 / med);
      // Clamp to musical range; if outside, return null
      if (bpm < 30 || bpm > 280) return null;
      return bpm;
    }

    function driftMs(): number | null {
      if (gaps.length < 4) return null;
      const recent = gaps.slice(-8);
      const med = median(recent);
      if (med <= 0) return null;
      const variance = recent.reduce((acc, g) => acc + Math.abs(g - med), 0) / recent.length;
      return Math.round(variance);
    }

    function feel(): string {
      const d = driftMs();
      const bpm = inferBPM();
      if (d == null || bpm == null) return '—';
      if (d < 25) return 'locked in';
      if (d < 55) return 'steady';
      if (d < 100) return 'searching';
      return 'free-time';
    }

    function refreshStats() {
      document.getElementById('ca-stat-taps')!.textContent = String(taps.length);
      const bpm = inferBPM();
      const bpmEl = document.getElementById('ca-tap-bpm')!;
      const bpmUnitEl = document.getElementById('ca-tap-bpm-unit')!;
      if (bpm == null) {
        bpmEl.textContent = '—';
        bpmUnitEl.textContent = taps.length === 0 ? 'listening…' : `${taps.length}/8 taps`;
      } else {
        bpmEl.textContent = String(bpm);
        bpmUnitEl.textContent = 'BPM';
      }
      const d = driftMs();
      document.getElementById('ca-stat-drift')!.textContent = d == null ? '—' : `±${d}`;
      document.getElementById('ca-stat-drift-sub')!.textContent = d == null ? 'ms variance' : 'ms variance';
      document.getElementById('ca-stat-streak')!.textContent = String(bestStreak);
      document.getElementById('ca-stat-feel')!.textContent = feel();
    }

    function refreshBand() {
      const row = document.getElementById('ca-band-row')!;
      const recent = gaps.slice(-MAX_GAPS);
      if (recent.length === 0) { row.innerHTML = ''; return; }
      const med = median(recent);
      // Visual heights: longer gap = taller bar (normalized to 0..1 by max)
      const maxGap = Math.max(...recent, med * 2);
      row.innerHTML = recent.map(g => {
        const h = Math.max(8, Math.min(56, (g / maxGap) * 56));
        const offBy = Math.abs(g - med);
        const cls = offBy < med * 0.06 ? 'ca__band-bar ca__band-bar--steady'
                  : offBy > med * 0.18 ? 'ca__band-bar ca__band-bar--off-grid'
                  : 'ca__band-bar';
        return `<div class="${cls}" style="height: ${h}px" title="${Math.round(g)}ms"></div>`;
      }).join('');
    }

    function refreshTrace() {
      const line = document.getElementById('ca-trace-line')!;
      const hint = document.getElementById('ca-trace-hint')!;
      if (tempoHistory.length < 2) {
        line.setAttribute('points', '');
        return;
      }
      hint.textContent = `${tempoHistory.length} data points · ${Math.min(...tempoHistory)} – ${Math.max(...tempoHistory)} BPM range`;
      const minBpm = Math.max(40, Math.min(...tempoHistory) - 10);
      const maxBpm = Math.min(220, Math.max(...tempoHistory) + 10);
      const range = maxBpm - minBpm;
      const points = tempoHistory.map((bpm, i) => {
        const x = (i / (MAX_HISTORY - 1)) * 640;
        const y = 110 - ((bpm - minBpm) / range) * 100;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
      line.setAttribute('points', points);
    }

    function tap() {
      const now = performance.now();
      ensureCtx();
      flashTap();
      if (lastTap > 0) {
        const g = now - lastTap;
        if (g > RESET_THRESHOLD_MS) {
          // long pause → reset streak but keep history
          currentStreak = 0;
        } else if (g >= 100 && g <= 3000) {
          gaps.push(g);
          if (gaps.length > MAX_HISTORY) gaps.shift();
          // streak: count taps where drift from local median < 12% of median
          const recent = gaps.slice(-6);
          if (recent.length >= 4) {
            const med = median(recent);
            const offBy = Math.abs(g - med);
            if (offBy < med * 0.12) {
              currentStreak++;
              if (currentStreak > bestStreak) bestStreak = currentStreak;
            } else {
              currentStreak = 0;
            }
          }
          // record bpm in history once we have stable inference
          const bpm = inferBPM();
          if (bpm != null) {
            tempoHistory.push(bpm);
            if (tempoHistory.length > MAX_HISTORY) tempoHistory.shift();
          }
        }
      }
      lastTap = now;
      taps.push(now);
      if (taps.length > MAX_TAPS) taps.shift();
      refreshStats();
      refreshBand();
      refreshTrace();
      // if click-on-grid is enabled and we're locked, schedule next click
      if (clickOn) scheduleNextGridClick();
    }

    function scheduleNextGridClick() {
      if (clickTimer != null) { clearTimeout(clickTimer); clickTimer = null; }
      const bpm = inferBPM();
      if (bpm == null) return;
      const intervalMs = 60000 / bpm;
      // Click on the next inferred grid time after last tap
      const elapsed = performance.now() - lastTap;
      const phase = elapsed % intervalMs;
      const nextInMs = intervalMs - phase;
      clickTimer = window.setTimeout(() => {
        if (!clickOn || !ctx) return;
        playClick(ctx.currentTime + 0.005, false);
        clickTimer = null;
        scheduleNextGridClick();  // keep walking the grid
      }, nextInMs);
    }

    function reset() {
      taps.length = 0;
      gaps.length = 0;
      tempoHistory.length = 0;
      lastTap = 0;
      bestStreak = 0;
      currentStreak = 0;
      if (clickTimer != null) { clearTimeout(clickTimer); clickTimer = null; }
      refreshStats();
      refreshBand();
      refreshTrace();
      document.getElementById('ca-trace-hint')!.textContent = `Your tempo line will start drawing once you've tapped ~8 times.`;
    }

    function init() {
      // primary tap button
      const tapBtn = document.getElementById('ca-tap')!;
      tapBtn.addEventListener('pointerdown', e => { e.preventDefault(); tap(); });

      // page-wide click (anywhere except buttons that have their own handlers)
      document.addEventListener('pointerdown', e => {
        const target = e.target as HTMLElement;
        if (target.closest('.ca__tap')) return;       // already handled
        if (target.closest('button')) return;          // other controls
        if (target.closest('a')) return;
        if (target.closest('input')) return;
        // tap from anywhere else on the page
        tap();
      });

      // spacebar
      window.addEventListener('keydown', e => {
        if (e.code !== 'Space') return;
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        e.preventDefault();
        tap();
      });

      // click on grid toggle
      const clickBtn = document.getElementById('ca-click-toggle')!;
      clickBtn.addEventListener('click', e => {
        e.stopPropagation();
        clickOn = !clickOn;
        clickBtn.setAttribute('aria-pressed', String(clickOn));
        const label = clickBtn.querySelector('.ca__ctl-label')!;
        label.textContent = clickOn ? 'Click is on' : 'Click on the grid';
        if (clickOn) {
          ensureCtx();
          scheduleNextGridClick();
        } else if (clickTimer != null) {
          clearTimeout(clickTimer);
          clickTimer = null;
        }
      });

      // reset
      document.getElementById('ca-reset')!.addEventListener('click', e => {
        e.stopPropagation();
        reset();
      });

      refreshStats();
      refreshBand();
      refreshTrace();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
