---
import BlockLayout from '../../layouts/BlockLayout.astro';
const description = 'A new Death Star BBS reconstruction in the real Atari character set. Explore museum bulletins, ATASCII art, and a five-arrow archery door game.';
---

<BlockLayout title="Death Star BBS · ATASCII terminal" description={description} image="/images/atari-bbs/og-atari-bbs.png" themeColor="#11181c" immersive isolated hideAds>
  <main class="bbs-room" data-death-star data-palette="blue">
    <header class="room-header">
      <a class="museum-link" href="/atari-bbs/" aria-label="Back to the Atari BBS museum"><span aria-hidden="true">←</span> POINTCAST / MUSEUM</a>
      <h1>DEATH STAR <span>BBS</span></h1>
      <span class="edition"><i aria-hidden="true"></i> NEW RECONSTRUCTION</span>
    </header>

    <section class="machine" aria-label="Playable Death Star BBS reconstruction">
      <div class="machine-top"><span><b>ATARI</b> 130XE / CHARACTER TERMINAL</span><span>40 × 24</span></div>
      <div class="screen-frame">
        <div class="screen-stage" data-stage tabindex="0" aria-label="Death Star BBS keyboard controls" aria-describedby="keyboard-hint" aria-busy="false">
          <canvas width="640" height="384" aria-hidden="true"></canvas>
          <div class="screen-sheen" aria-hidden="true"></div>
        </div>
      </div>
      <div class="machine-bottom"><span data-render-note>ATASCII / ORIGINAL CHARACTER BITMAPS</span><span class="power"><i aria-hidden="true"></i> LOCAL SESSION</span></div>
    </section>

    <div class="control-desk">
      <p class="keyboard-hint" id="keyboard-hint">Click the screen and use the keys, or tap below. <kbd>ESC</kbd> returns to the menu.</p>
      <nav class="command-controls" data-controls aria-label="BBS actions"></nav>
      <form class="handle-form" data-handle-form hidden>
        <label for="death-star-handle">Choose your local handle <span>16 characters · this browser only</span></label>
        <div><input id="death-star-handle" name="handle" type="text" maxlength="16" autocomplete="off" spellcheck="false" placeholder="VISITOR" pattern="[A-Za-z0-9 _\-]*"/><button type="submit">USE HANDLE <span aria-hidden="true">↵</span></button></div>
      </form>
      <div class="display-controls">
        <label class="phosphor">SCREEN <select data-palette aria-label="Screen phosphor"><option value="blue">Atari blue</option><option value="green">Green phosphor</option><option value="amber">Amber phosphor</option></select></label>
        <label class="reveal"><input type="checkbox" data-slow /> 300-baud reveal</label>
        <button class="skip" type="button" data-skip hidden>Show screen now</button>
        <a class="club-link" href="/atari-bbs/club/">The club <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-bbs-status></p>
    <details class="text-view" data-text-view>
      <summary>Read the screen <span>Accessible text view</span></summary>
      <div><h2 data-screen-title>Death Star BBS</h2><p data-screen-text>A local museum reconstruction with keyboard and touch controls. JavaScript activates the screen.</p></div>
    </details>
    <noscript><p class="no-script">This playable terminal needs JavaScript. <a href="/atari-bbs/">Visit the museum</a> to read the history, view the photographs, and follow the source trail.</p></noscript>
    <footer class="room-footer">
      <p>New art, new museum notes, new game. <strong>No recovered board or archived messages.</strong> Your handle and best score stay in this browser.</p>
      <p>Characters: <a href="https://commons.wikimedia.org/wiki/File:Atascii-character-set-00toFF-2x.gif">Kim Slawson · corrections by Dpla-fr</a>, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>. Recolored for this display. <a href="/atari-bbs/#sources">History &amp; sources ↗</a></p>
    </footer>
  </main>
</BlockLayout>
<script>
  import '../../scripts/death-star-bbs';
</script>
<style>
  :global(html[data-pc-layout='block']) { --pc-bg:#11181c; --pc-ink:#d9dcd0; --pc-accent:#d5e591; }
  :global(body.pc-block-shell) { margin:0; padding:0; background:#11181c; color:#d9dcd0; }
  .bbs-room { --edge:#3d4b4f; --muted:#9eaaa7; --accent:#d5e591; --screen:#183985; max-width:1040px; padding:0 32px 28px; margin:auto; font-family:'JetBrains Mono Variable',monospace; }
  .bbs-room[data-palette='green'] { --screen:#0f2519; }.bbs-room[data-palette='amber'] { --screen:#2a2012; }
  .bbs-room * { box-sizing:border-box; } .bbs-room [hidden] { display:none!important; }
  .bbs-room a { color:inherit; } .bbs-room button,.bbs-room input,.bbs-room select { font:inherit; }
  .bbs-room button { cursor:pointer; } .bbs-room :is(a,button,input,select,summary,[tabindex]):focus-visible { outline:3px solid var(--accent); outline-offset:4px; }
  .room-header { display:flex; align-items:center; gap:24px; justify-content:space-between; min-height:79px; }
  .museum-link { font-size:9px; letter-spacing:.04em; text-decoration:none; }.museum-link span { font-size:16px; margin-right:6px; }
  h1 { margin:0; font-size:17px; letter-spacing:-.05em; font-weight:650; }h1 span { color:var(--accent); }
  .edition { display:flex; align-items:center; gap:8px; color:var(--muted); font-size:8px; letter-spacing:.04em; }.edition i { width:5px; height:5px; background:var(--accent); }
  .machine { border:1px solid #5b6464; background:linear-gradient(#3d484a,#242e31); border-radius:13px; box-shadow:0 12px 0 #070e11,0 18px 50px #0005; padding:0 19px; }
  .machine-top,.machine-bottom { display:flex; justify-content:space-between; align-items:center; gap:15px; color:#abb5b1; font-size:8px; letter-spacing:.06em; }.machine-top { height:42px; }.machine-top b { font-weight:650; font-size:13px; letter-spacing:.14em; color:#e7e7d8; margin-right:12px; }.machine-top>span:last-child { color:var(--accent); }.machine-bottom { height:39px; font-size:7px; }
  .screen-frame { padding:9px; border:1px solid #071013; border-radius:8px; background:#070e12; box-shadow:inset 0 2px 6px #000b,0 1px 0 #7b838755; }
  .screen-stage { position:relative; background:var(--screen); min-width:0; overflow:hidden; border-radius:3px; }.screen-stage:focus-visible { outline-offset:9px; }.screen-stage canvas { width:100%; height:auto; aspect-ratio:5/3; display:block; image-rendering:pixelated; }
  .screen-sheen { position:absolute; inset:0; pointer-events:none; background:linear-gradient(125deg,#ffffff06,transparent 50%); box-shadow:inset 0 0 38px #0002; }.power { display:flex; align-items:center; gap:7px; white-space:nowrap; }.power i { width:5px;height:5px;background:#bddd81;box-shadow:0 0 7px #aee65c55; }
  .control-desk { padding-top:31px; }.keyboard-hint { color:var(--muted); font-size:9px; line-height:1.6; margin:0 0 15px; }.keyboard-hint kbd { color:#dce3d5; }
  .command-controls { display:flex; flex-wrap:wrap; gap:8px; min-height:48px; }.command-controls :global(button) { flex:1 1 112px; display:flex; gap:12px; justify-content:center; align-items:center; border:1px solid #5a6768; background:#202c30; color:#e6eada; min-height:49px; padding:12px; font-size:11px; box-shadow:0 3px 0 #071014; }.command-controls :global(button:hover) { background:#2f4145; border-color:#9aa7a1; }.command-controls :global(button:active) { transform:translateY(2px); box-shadow:0 1px 0 #071014; }.command-controls :global(button.action-primary) { background:var(--accent); border-color:var(--accent); color:#202c1d; }.command-controls :global(kbd) { font:10px 'JetBrains Mono Variable',monospace; opacity:.8; }.command-controls :global(button:focus-visible) { outline:3px solid var(--accent); outline-offset:4px; }
  .display-controls { display:flex; align-items:center; gap:20px; flex-wrap:wrap; padding:22px 0 18px; font-size:9px; color:var(--muted); }.phosphor { display:flex; align-items:center; gap:9px; font-size:8px; letter-spacing:.08em; }.phosphor select { background:#1b272b; border:1px solid var(--edge); color:#dde5d5; border-radius:0; padding:9px; font-size:10px; letter-spacing:0; min-height:36px; }.reveal { display:flex; align-items:center; gap:7px; min-height:36px; cursor:pointer; }.reveal input { accent-color:var(--accent); }.reveal:has(input:disabled) { opacity:.55; cursor:default; }.skip { background:none; border:0; color:var(--accent); text-decoration:underline; font-size:9px; min-height:36px; }.club-link { margin-left:auto; font-size:10px; text-underline-offset:4px; min-height:36px; display:flex; align-items:center; gap:12px; }
  .handle-form { border:1px solid var(--edge); padding:20px; margin:16px 0 0; background:#182328; }.handle-form label { display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; font-size:12px; margin-bottom:12px; }.handle-form label span { color:var(--muted); font-size:9px; }.handle-form>div { display:flex; gap:10px; }.handle-form input { background:#0e1a20; border:1px solid #607276; color:#f0f0d9; text-transform:uppercase; min-width:0; width:100%; padding:13px; border-radius:0; font-size:14px; }.handle-form button { flex-shrink:0; border:0; background:var(--accent); color:#202c1d; padding:12px 16px; font-size:10px; }.handle-form button span { margin-left:12px; }
  .text-view { border-top:1px solid var(--edge); border-bottom:1px solid var(--edge); }.text-view summary { cursor:pointer; min-height:45px; padding:15px 0; font-size:10px; color:#c4cec5; }.text-view summary span { color:var(--muted); margin-left:15px; font-size:8px; }.text-view>div { padding:0 0 20px; max-width:780px; }.text-view h2 { font-size:14px; margin:6px 0 12px; }.text-view p { font-size:12px; line-height:1.9; white-space:pre-wrap; color:#c4cec5; }.no-script { padding:20px; border:1px solid var(--edge); font-size:13px;line-height:1.8; }
  .room-footer { display:grid;grid-template-columns:1fr 1fr;gap:28px;padding-top:18px; }.room-footer p { margin:0;font-size:8px;line-height:1.8;color:#9caaa6; }.room-footer strong { font-weight:500;color:#d0d6c7; }.room-footer a { text-underline-offset:3px; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:680px) { .bbs-room { padding:0 12px 23px; }.room-header { min-height:82px; gap:7px 14px;flex-wrap:wrap;padding:17px 2px; }.museum-link { font-size:8px; }.edition { font-size:7px; flex-basis:100%; justify-content:flex-end; margin-top:1px; }h1 { font-size:15px; }.machine { padding:0 7px;border-radius:9px; }.machine-top { height:33px;font-size:6px;letter-spacing:.025em; }.machine-top b { font-size:10px;margin-right:6px; }.machine-bottom { height:29px;font-size:5px;letter-spacing:.02em; }.screen-frame { padding:4px;border-radius:5px; }.screen-stage { border-radius:1px; }.screen-sheen { box-shadow:inset 0 0 15px #0002; }.power { gap:4px; }.power i { width:4px;height:4px; }.control-desk { padding-top:26px; }.keyboard-hint { font-size:8px;margin-bottom:13px; }.command-controls { gap:8px; }.command-controls :global(button) { flex-basis:calc(50% - 8px);font-size:10px;min-height:48px;padding:12px 8px;gap:8px; }.display-controls { gap:8px 16px;padding:18px 0 15px; }.phosphor select { max-width:155px;font-size:9px; }.reveal { font-size:8px; }.club-link { margin-left:0; }.room-footer { grid-template-columns:1fr;gap:12px; }.room-footer p { font-size:8px; }.handle-form { padding:15px; }.handle-form>div { flex-wrap:wrap; }.handle-form button { min-height:44px;flex:1; }.handle-form input { font-size:16px; }.text-view summary span { font-size:7px; } }
  @media(prefers-reduced-motion:reduce) { .command-controls :global(button:active) { transform:none; } }
</style>
