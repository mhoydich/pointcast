---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { CLUB_BADGES } from '../../lib/atari-club';
import { clubArt } from '../../data/atari-club-art';
const authUrl = '/auth?returnTo=%2Fatari-bbs%2Fclub%2F';
---
<BlockLayout title="Death Star Computer Club" description="A new computer club around Atari memories, tiny builds, and the next transmission. Join the real message board, earn badges, and take home original club art." image="/images/atari-bbs/og-atari-bbs.png" themeColor="#eeeade" immersive isolated hideAds>
  <main class="club" data-atari-club>
    <header class="club-nav"><a class="wordmark" href="/">POINTCAST<span> / COMPUTER CLUB</span></a><nav aria-label="Atari wing"><a href="/atari-bbs/">Museum</a><a href="/atari-bbs/death-star/">ATASCII BBS</a><a href="/atari-bbs/club/" aria-current="page">Club</a></nav></header>
    <section class="club-hero" aria-labelledby="club-title">
      <div class="hero-copy"><p class="eyebrow"><span class="dot" aria-hidden="true"></span> DEATH STAR COMPUTER CLUB · EST. NOW</p><h1 id="club-title">Old machines.<br/>New <em>connections.</em></h1><p class="hero-dek">For the people who remember the dial tone.<br/>And the people who wish they did.</p><p class="hero-note">An open room for Atari stories, tiny experiments, and things made from a few good pixels. Read the board. Pick a handle. Send something back.</p><div class="hero-actions"><a class="button forest" href="#membership">Find your seat <span aria-hidden="true">↗</span></a><a class="plain-link" href="#board">Read the board ↓</a></div></div>
      <div class="hero-art"><div class="art-ticket"><span>DSCC / 001</span><span>ALL CURIOSITY WELCOME</span></div><img class="hero-logo" src="/images/atari-bbs/club/signal-club.webp" width="1024" height="1024" alt="Signal Club: new Death Star Computer Club artwork inspired by Michael Hoydich’s image archive." fetchpriority="high"/><div class="hero-stamp"><span>ON THE AIR</span><strong>HELLO,<br/>AGAIN.</strong><span>A NEW CLUB / A SHARED BOARD</span></div></div>
    </section>
    <div class="club-strip"><p><span class="dot" aria-hidden="true"></span><strong data-member-count>—</strong> members</p><p><strong data-post-count>—</strong> board messages</p><p>One room. Plenty of room.</p><a href="/atari-bbs/death-star/">Try the 40-column terminal ↗</a></div>

    <div class="club-notice" data-notice-wrap hidden><p data-notice role="status" aria-live="polite" aria-atomic="true"></p><button type="button" data-retry>Refresh the board</button></div>
    <div class="club-workspace">
      <aside class="membership" id="membership" aria-labelledby="membership-title">
        <div class="membership-head"><p class="eyebrow">YOUR PLACE IN THE CLUB</p><h2 id="membership-title">A handle.<br/>A little history.</h2></div>
        <div data-access-loading><p class="access-copy">Checking the club connection…</p></div>
        <div data-access-unavailable hidden><p class="access-copy">Membership is unavailable while the board is disconnected. The museum, terminal, and art collection are still open.</p><button class="button forest" type="button" data-refresh>Try the connection again</button></div>
        <div data-visitor hidden><p class="access-copy">Everyone can read. Sign in to choose a public club handle, join the conversation, and start your badge locker.</p><a class="button forest" href={authUrl}>Sign in to join <span aria-hidden="true">↗</span></a><p class="tiny">Your PointCast account gets you through the door. Your club handle is the name people see.</p></div>
        <form class="join-form" data-join hidden><label for="club-handle">Your public handle</label><input id="club-handle" name="handle" maxlength="20" minlength="3" pattern="[A-Za-z][A-Za-z0-9_\-]{2,19}" placeholder="SpaceAce" autocomplete="off" spellcheck="false" required aria-describedby="handle-help"/><p id="handle-help" class="tiny">3–20 letters, numbers, dashes, or underscores. Start with a letter. Choose a name you will keep.</p><label class="consent"><input name="consent" type="checkbox" required/><span>I understand that my club handle and board messages will be public.</span></label><button class="button forest" type="submit" data-mutate>Join the club <span aria-hidden="true">↗</span></button></form>
        <div data-member hidden><p class="member-kicker">YOUR CALL SIGN</p><p class="member-handle" data-self-handle></p><p class="tiny" data-joined></p><div class="checkin-card"><span class="eyebrow">KEEP THE LINE WARM</span><p><strong data-checkin-days>—</strong> different days here</p><button class="button lime" type="button" data-checkin data-mutate>Check in today</button><p class="tiny">One check-in per Los Angeles calendar day. Three days earns Night Shift.</p></div></div>
        <div class="paused-member" data-suspended hidden><p class="member-kicker">MEMBERSHIP PAUSED</p><p class="member-handle" data-paused-handle></p><p class="access-copy">Your membership is paused. You can read the board and explore the club. Posting, reporting, and check-ins are unavailable.</p></div>
        <div class="locker" aria-labelledby="locker-title"><div class="locker-heading"><h3 id="locker-title">Your badge locker</h3><span data-badge-count>— / 4</span></div><div class="badge-grid">{CLUB_BADGES.map(badge => <article class="badge" data-badge={badge.id}><img src={`/images/atari-bbs/club/${badge.id}.webp`} width="512" height="512" loading="lazy" alt=""/><div><h4>{badge.name}</h4><p>{badge.description}</p><span data-earned>Checking status</span></div></article>)}</div><p class="tiny">Earned by real club activity. Downloading badge artwork does not earn the badge.</p></div>
      </aside>

      <section class="board" id="board" aria-labelledby="board-title">
        <div class="board-heading"><div><p class="eyebrow">THE SHARED MESSAGE BOARD</p><h2 id="board-title">What’s your signal?</h2></div><button class="refresh-button" type="button" data-refresh aria-label="Refresh the club board">Refresh ↻</button></div>
        <p class="board-dek">A memory worth keeping. Something you made. A question for the room.</p>
        <form class="post-form" data-compose hidden><div class="compose-top"><label for="post-channel">Send to <select id="post-channel" name="channel"><option value="general">General</option><option value="memories">Memories</option><option value="workshop">Workshop</option></select></label><span data-post-as></span></div><label for="club-message" class="sr-only">Your public board message</label><textarea id="club-message" name="body" rows="4" maxlength="1000" required placeholder="What brought you to the club?" aria-describedby="post-rules"></textarea><div class="compose-bottom"><p id="post-rules">Public, plain text. 1,000 characters / 16 lines.<br/>Keep personal contact details out of your post.</p><span data-character-count>0 / 1000</span><button class="button forest" type="submit" data-mutate>Send transmission <span aria-hidden="true">↗</span></button></div></form>
        <div class="board-tabs" role="group" aria-label="Filter board messages"><button type="button" data-channel="all" aria-pressed="true">All signals</button><button type="button" data-channel="general" aria-pressed="false">General</button><button type="button" data-channel="memories" aria-pressed="false">Memories</button><button type="button" data-channel="workshop" aria-pressed="false">Workshop</button></div>
        <div class="board-stream" data-posts aria-busy="true"><div class="board-loading"><span aria-hidden="true">▧</span><h3>Tuning in…</h3><p>Reading the current club board.</p></div></div>
        <noscript><p class="tiny">The shared board and membership controls need JavaScript. The museum, terminal source notes, and art downloads remain available.</p></noscript>
        <p class="board-foot" data-board-foot>Public board · newest messages first</p>
      </section>
    </div>

    <section class="moderation" data-moderation hidden aria-labelledby="moderation-title"><details><summary id="moderation-title">Director’s moderation desk <span data-report-count></span></summary><div class="moderation-body"><p class="tiny">Review member reports, remove a message, or pause a membership. Suspended members’ messages are hidden from the public board.</p><p data-moderation-status role="status" aria-live="polite"></p><button type="button" class="refresh-button" data-refresh-reports>Refresh reports ↻</button><div data-reports></div><form data-member-action><label for="moderate-handle">Member handle</label><input id="moderate-handle" name="handle" required maxlength="20" autocomplete="off"/><label class="sr-only" for="moderate-action">Membership action</label><select id="moderate-action" name="action"><option value="restore">Restore membership</option><option value="suspend">Pause membership</option></select><button class="button forest" type="submit" data-mutate>Apply action</button></form></div></details></section>

    <section class="club-art" id="art" aria-labelledby="art-title"><div class="art-heading"><div><p class="eyebrow">THE CLUB COLLECTION / {clubArt.length} NEW DESIGNS</p><h2 id="art-title">Take a little<br/><em>signal</em> with you.</h2></div><div><p>Badges, marks, cards, and things we might make. New artwork by Codex, using Michael Hoydich’s Midjourney archive as the reference shelf.</p><p class="tiny">Free PNG art downloads. Gear is a design concept; no physical stock or purchase. Cards are digital artwork; no token has been minted.</p></div></div><div class="art-grid">{clubArt.map((art, i) => <article class="art-card"><a class="art-image" href={art.download} download><img src={art.image} width="1024" height="1024" loading="lazy" alt={`${art.title} — ${art.description}`}/><span aria-hidden="true">↗</span></a><div class="art-card-copy"><p class="art-number">{String(i + 1).padStart(2, '0')} / {art.kind}</p><h3>{art.title}</h3><p>{art.description}</p>{'criterion' in art && art.criterion && <p class="art-criterion">Earned badge: {art.criterion}</p>}<a class="download-link" href={art.download} download>Download PNG <span aria-hidden="true">↓</span></a><a class="reference-link" href={art.sourceUrl}>Source gallery ↗</a>{art.referenceImage && <a class="reference-link" href={art.referenceImage}>View inspiration ↗</a>}</div></article>)}</div></section>
    <section class="next-door"><div><p class="eyebrow">THE BOARD BEHIND THE CLUB</p><h2>Forty columns.<br/>A whole other world.</h2><p>Take the ATASCII terminal for a spin. New art, museum notes, and five arrows to make your mark.</p></div><a class="button lime" href="/atari-bbs/death-star/">Dial into Death Star <span aria-hidden="true">↗</span></a></section>
    <footer class="club-footer"><a class="wordmark" href="/atari-bbs/">DEATH STAR<span> / COMPUTER CLUB</span></a><p>A new PointCast community inspired by Mike Hoydich’s Atari story.<br/>The museum keeps the history. This board starts a new conversation.</p><a href="/atari-bbs/#sources">History &amp; sources ↗</a></footer>
  </main>
</BlockLayout>
<script>import '../../scripts/atari-club';</script>
<style>
  :global(html[data-pc-layout='block']) { --pc-bg:#eeeade;--pc-ink:#25392b;--pc-accent:#294a35; }
  :global(body.pc-block-shell) { margin:0;padding:0;background:#eeeade;color:#25392b; }.club { --ink:#25392b;--forest:#294a35;--paper:#eeeade;--line:#c5cbb8;--muted:#5e6a59;--lime:#d8ed8d;--lavender:#ded5ee;--mono:'JetBrains Mono Variable',monospace;max-width:1480px;margin:auto;padding:0 56px;font-family:'Inter Variable',sans-serif; }.club * { box-sizing:border-box; }.club [hidden] { display:none!important; }.club a { color:inherit; }.club button,.club input,.club textarea,.club select { font:inherit; }.club button { cursor:pointer; }.club :is(a,button,input,textarea,select,summary):focus-visible { outline:3px solid #9863b4;outline-offset:4px; }.club button:disabled { cursor:default;opacity:.55; }
  .club-nav { display:flex;justify-content:space-between;align-items:center;gap:24px;padding:27px 0;border-bottom:1px solid var(--ink); }.wordmark { text-decoration:none;font-size:20px;font-weight:800;letter-spacing:-.04em; }.wordmark span { font:10px var(--mono);letter-spacing:.05em;margin-left:9px; }.club-nav nav { display:flex;gap:27px;font-size:12px; }.club-nav nav a { text-decoration:none; }.club-nav nav a[aria-current] { text-decoration:underline;text-underline-offset:7px; }.club-hero { display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:60px;padding:58px 0 54px; }.eyebrow { font:10px/1.6 var(--mono);letter-spacing:.07em;margin:0 0 18px;text-transform:uppercase; }.dot { display:inline-block;width:7px;height:7px;border-radius:50%;background:#b77742;margin-right:8px; }h1 { font-size:clamp(48px,5.8vw,82px);line-height:1.01;letter-spacing:-.067em;margin:0 0 25px;font-weight:720; }h1 em,h2 em { font-style:normal;color:#688344; }.hero-dek { font-size:20px;line-height:1.45;letter-spacing:-.035em;margin:0 0 18px; }.hero-note { max-width:455px;font-size:14px;line-height:1.8;color:var(--muted);margin:0 0 25px; }.hero-actions { display:flex;gap:25px;align-items:center;flex-wrap:wrap; }.button { display:inline-flex;align-items:center;justify-content:space-between;gap:24px;text-decoration:none;border:1px solid transparent;border-radius:0;min-height:46px;padding:13px 17px;font-size:12px;font-weight:550; }.club .forest { background:var(--forest);color:#f6f3e3; }.club .lime { background:var(--lime);color:var(--ink);border-color:#a8bc6f; }.plain-link { font-size:12px;text-underline-offset:5px; }.hero-art { position:relative;max-width:485px;justify-self:end;width:100%;padding-bottom:20px; }.art-ticket { display:flex;justify-content:space-between;font:9px var(--mono);margin-bottom:12px;border-top:1px solid var(--ink);padding-top:12px; }.hero-logo { display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;border:1px solid var(--line); }.hero-stamp { position:absolute;right:-16px;bottom:0;transform:rotate(5deg);background:var(--lime);border:1px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:17px 20px;display:grid;gap:8px; }.hero-stamp span { font:7px var(--mono); }.hero-stamp strong { font-size:27px;line-height:.95;letter-spacing:-.06em; }.club-strip { display:flex;align-items:center;gap:35px;flex-wrap:wrap;padding:21px 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);font:10px var(--mono); }.club-strip p { margin:0; }.club-strip strong { font-size:20px;letter-spacing:-.05em;margin-right:5px; }.club-strip>p:nth-child(3) { color:var(--muted); }.club-strip>a { margin-left:auto;text-underline-offset:4px; }
  .club-notice { display:flex;gap:20px;align-items:center;justify-content:space-between;border:1px solid #8a9b69;background:#e0e7cf;padding:15px 18px;margin-top:25px;font-size:13px;line-height:1.6; }.club-notice[data-tone='error'] { background:#f0dfd2;border-color:#ba9279; }.club-notice p { margin:0; }.club-notice button,.refresh-button { background:none;border:0;color:inherit;text-decoration:underline;text-underline-offset:4px;min-height:40px;font:10px var(--mono);padding:8px;flex-shrink:0; }.club-workspace { display:grid;grid-template-columns:330px minmax(0,1fr);gap:55px;padding:53px 0 60px; }.membership { border-right:1px solid var(--line);padding-right:30px;scroll-margin-top:24px; }.membership h2 { font-size:32px;letter-spacing:-.045em;line-height:1.1;margin:0 0 20px; }.access-copy { font-size:13px;line-height:1.8;margin:0 0 20px; }.tiny { font:9px/1.75 var(--mono);color:var(--muted); }.membership .button { width:100%; }.join-form>label:first-child { font-size:12px;font-weight:550; }.join-form>input { width:100%;margin-top:9px;background:#faf8ef;border:1px solid #9da890;padding:12px;font:15px var(--mono);border-radius:0; }.consent { display:flex;gap:10px;align-items:flex-start;font-size:11px;line-height:1.6;margin:17px 0; }.consent input { margin:4px 0 0;accent-color:var(--forest); }.member-kicker { font:9px var(--mono);margin:0 0 9px; }.member-handle { overflow-wrap:anywhere;font:25px var(--mono);letter-spacing:-.04em;margin:0 0 8px; }.checkin-card { margin:22px 0;background:var(--lavender);padding:17px;border:1px solid #b9afce; }.checkin-card .eyebrow { font-size:8px;margin-bottom:10px; }.checkin-card>p:not(.tiny) { font-size:12px;margin:0 0 17px; }.checkin-card strong { font-size:26px;margin-right:5px; }.checkin-card .tiny { margin-bottom:0; }.paused-member { border-left:3px solid #a85e3d;padding-left:15px; }.locker { margin-top:35px;border-top:1px solid var(--line);padding-top:22px; }.locker-heading { display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:16px; }.locker h3 { font-size:15px;margin:0;letter-spacing:-.025em; }.locker-heading>span { font:9px var(--mono); }.badge-grid { display:grid;gap:13px; }.badge { display:flex;gap:12px;align-items:center;background:#f6f3e9;border:1px solid var(--line);padding:9px; }.badge img { width:68px;height:68px;object-fit:cover;flex:none;filter:saturate(.35);opacity:.65; }.badge[data-earned-state='earned'] { background:#e4eacd;border-color:#a9b98a; }.badge[data-earned-state='earned'] img { filter:none;opacity:1; }.badge h4 { font-size:11px;margin:0 0 5px; }.badge p { font-size:9px;line-height:1.5;margin:0 0 5px;color:var(--muted); }.badge [data-earned] { font:8px var(--mono); }
  .board { min-width:0;scroll-margin-top:24px; }.board-heading { display:flex;align-items:center;justify-content:space-between;gap:20px; }.board-heading .eyebrow { margin-bottom:12px; }.board h2 { font-size:36px;letter-spacing:-.045em;line-height:1.1;margin:0; }.board-dek { font-size:13px;line-height:1.8;color:var(--muted);margin:15px 0 24px; }.post-form { border:1px solid #a9b49a;background:#f8f6eb;padding:16px;margin-bottom:25px; }.compose-top { display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px;font:9px var(--mono); }.compose-top label { display:flex;align-items:center;gap:10px; }.compose-top select { padding:8px;background:var(--paper);border:1px solid var(--line);font:10px var(--mono);border-radius:0; }.compose-top>span { overflow-wrap:anywhere; }.post-form textarea { width:100%;resize:vertical;min-height:115px;max-height:400px;padding:12px;border:1px solid #b3bba6;border-radius:0;background:#fffef7;color:var(--ink);font-size:14px;line-height:1.7; }.compose-bottom { display:flex;gap:15px;flex-wrap:wrap;align-items:center;margin-top:12px; }.compose-bottom p { margin:0;font:8px/1.7 var(--mono);color:var(--muted); }.compose-bottom>span { font:8px var(--mono);margin-left:auto; }.compose-bottom .button { font-size:10px;min-height:40px;padding:10px 12px; }.board-tabs { display:flex;gap:5px;border-bottom:1px solid var(--ink);padding-bottom:10px;overflow-x:auto; }.board-tabs button { border:1px solid transparent;border-radius:0;background:none;padding:10px 12px;font:10px var(--mono);color:var(--ink);white-space:nowrap; }.board-tabs button[aria-pressed='true'] { background:var(--forest);color:#f5f5dd; }.board-stream { min-height:230px; }.board-loading,.board-stream :global(.empty-board) { padding:45px 25px;background:#e5e7d8;margin-top:15px;border:1px dashed #a8b49a; }.board-loading>span,.board-stream :global(.empty-mark) { font-size:38px;line-height:1; }.board-loading h3,.board-stream :global(.empty-board h3) { font-size:23px;letter-spacing:-.04em;margin:16px 0 12px; }.board-loading p,.board-stream :global(.empty-board p) { font-size:13px;line-height:1.8;max-width:455px; }.board-stream :global(.empty-note) { font:9px/1.6 var(--mono);color:var(--muted); }.board-stream :global(.board-post) { padding:23px 0;border-bottom:1px solid var(--line); }.board-stream :global(.post-meta) { display:flex;align-items:center;gap:10px;flex-wrap:wrap;font:9px var(--mono); }.board-stream :global(.post-handle) { font-weight:600;font-size:12px;overflow-wrap:anywhere; }.board-stream :global(.post-channel) { background:var(--lavender);padding:5px 7px;font-size:8px;text-transform:uppercase; }.board-stream :global(time) { margin-left:auto;color:var(--muted);font-size:8px; }.board-stream :global(.post-body) { white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;line-height:1.85;margin:16px 0; }.board-stream :global(.post-tools) { display:flex;gap:16px;flex-wrap:wrap;font:9px var(--mono); }.board-stream :global(.post-tools summary) { cursor:pointer;min-height:28px; }.board-stream :global(.post-tools button),.board-stream :global(.post-tools select) { font:9px var(--mono);padding:7px 10px;min-height:34px;background:#f7f5eb;color:var(--ink);border:1px solid var(--line);border-radius:0; }.board-stream :global(.inline-tools) { display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:9px 0; }.board-stream :global(.inline-tools p) { font-size:10px;margin:0; }.board-foot { font:8px/1.7 var(--mono);color:var(--muted);margin-top:18px; }
  .moderation { margin-bottom:45px;border:1px solid #aaa1b9;background:#e8e0ee; }.moderation summary { cursor:pointer;padding:20px;font:12px var(--mono); }.moderation summary span { margin-left:15px;font-size:10px; }.moderation-body { padding:0 22px 22px; }.moderation :global(.report-item) { border-top:1px solid #b9afc2;padding:18px 0; }.moderation :global(.report-meta) { font:10px var(--mono); }.moderation :global(.report-body) { white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.7; }.moderation :global(.report-actions) { display:flex;flex-wrap:wrap;gap:8px; }.moderation :global(.report-actions button) { border:1px solid #aaa1b9;background:#f4eef6;color:var(--ink);padding:10px;min-height:40px;font:10px var(--mono); }.moderation form { display:flex;gap:10px;align-items:center;flex-wrap:wrap;border-top:1px solid #b9afc2;padding-top:22px;margin-top:15px; }.moderation form label { font-size:11px; }.moderation form input,.moderation form select { min-width:0;padding:10px;background:#f8f4fa;border:1px solid #aaa1b9;font:11px var(--mono);border-radius:0; }.moderation [data-moderation-status] { font-size:12px;line-height:1.7; }
