---
import BlockLayout from '../../layouts/BlockLayout.astro';
import catalog from '../../data/siddhartha.json';
import '../../styles/siddhartha.css';
const description = 'A quiet Siddhartha bookshop and reader’s companion: compare translations, find new and used editions, borrow, and follow Hermann Hesse’s novel toward the river.';
const filters = [{id:'all',label:'All routes'},{id:'new',label:'Buy new'},{id:'used',label:'Find used'},{id:'borrow',label:'Borrow'},{id:'digital',label:'Read online'}];
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:'Siddhartha · The river shelf',url:'https://pointcast.xyz/siddhartha/',description,about:{'@type':'Book',name:'Siddhartha',author:{'@type':'Person',name:'Hermann Hesse'},datePublished:'1922',inLanguage:'de'},hasPart:catalog.editions.map(e=>({'@type':'Book',name:'Siddhartha',isbn:e.isbn,bookFormat:'https://schema.org/Paperback',inLanguage:e.language,...(e.translator?{translator:{'@type':'Person',name:e.translator}}:{}),publisher:{'@type':'Organization',name:e.publisher},url:e.source}))};
---
<BlockLayout title="Siddhartha · The river shelf" description={description} image="/images/siddhartha/river-horizon.webp" imageWidth={1536} imageHeight={1024} isolated={true} showNetworkStrip={false} themeColor="#133d66" jsonLd={jsonLd} alternates={[{type:'application/json',href:'/siddhartha.json',title:'Siddhartha editions and sources'}]}>
  <div class="river-shelf">
    <header class="river-header">
      <a href="/" class="river-wordmark">POINTCAST <span>/ the river shelf</span></a>
      <nav aria-label="Siddhartha resource"><a href="/books/">Bookshop</a><a href="#editions">Find a copy</a><a href="#about">The book</a><a href="#reading">Read slowly</a><a href="#sources">Sources</a></nav>
    </header>
    <section class="river-opening" aria-labelledby="river-title">
      <p class="river-kicker">Hermann Hesse · a novel · 1922</p>
      <h1 id="river-title">Siddhartha<span aria-hidden="true">.</span></h1>
      <div class="river-opening-bottom"><p>A life in search of itself.<br/>A river that asks us to listen.</p><a class="river-button" href="#editions">Find your edition</a></div>
    </section>
    <figure class="river-landscape"><img src="/images/siddhartha/river-horizon.webp" alt="Original pigment-print interpretation of a broad ultramarine river beneath a pale sky and distant amber banks" width="1536" height="1024" fetchpriority="high" decoding="async"/><figcaption><span>01 / The far bank</span><span>Original AI-generated artwork for PointCast</span></figcaption></figure>
    <section id="editions" class="river-section" aria-labelledby="editions-title">
      <header class="river-section-head"><div><p class="river-kicker">The bookshop</p><h2 id="editions-title">One book.<br/>Several ways in.</h2></div><p>Choose a translation, then a way to read. A borrowed copy is a good beginning. A used one brings a little history with it.</p></header>
      <p class="river-shop-note">An independent discovery shelf. Links lead to publishers, booksellers and libraries. PointCast holds no stock and takes no orders. Prices, condition and availability belong to the destination.</p>
      <div class="river-filters" role="group" aria-label="Choose how to obtain Siddhartha" hidden>{filters.map(f=><button type="button" data-route-filter={f.id} aria-pressed={f.id==='all'?'true':'false'}>{f.label}</button>)}</div>
      <p id="river-results" class="river-result-note" role="status" aria-live="polite">Four print editions and two digital reading routes. Sources checked {catalog.checkedAt}.</p>
      <div class="river-editions">
        {catalog.editions.map((edition,i)=><article class="river-edition" id={edition.id} data-river-entry data-routes="new used borrow">
          <div class="river-edition-number"><span>0{i+1}</span><span>{edition.language==='de'?'Original German':'English translation'}</span></div>
          <h3>{edition.label}</h3><p class="river-translator">{edition.language==='de'?'By Hermann Hesse':`Translated by ${edition.translator}`}</p>
          <p class="river-edition-why">{edition.why}</p>
          <dl><dt>Edition</dt><dd>{edition.publisher} · {edition.format}</dd><dt>Inside</dt><dd>{edition.extras}</dd><dt>ISBN</dt><dd>{edition.isbn}</dd></dl>
          <div class="river-edition-links"><a href={edition.new} data-access-route="new">Buy new <span class="river-link-host">/ {edition.newLabel}</span></a><a href={edition.used} data-access-route="used">Find used <span class="river-link-host">/ ISBN search</span></a><a href={edition.borrow} data-access-route="borrow">Borrow route <span class="river-link-host">/ {edition.borrowLabel}</span></a></div>
          <p class="river-borrow-note">{edition.borrowNote}</p><a class="river-edition-source" href={edition.source}>Publisher’s edition record</a>
        </article>)}
        {catalog.digital.map((route,i)=><article class="river-edition river-digital" data-river-entry data-routes="digital"><div class="river-edition-number"><span>0{i+5}</span><span>Digital reading</span></div><h3>{route.label}</h3><p class="river-translator">{route.translation}</p><p class="river-edition-why">{route.description}</p><p class="river-territory">{route.rights}</p><div class="river-edition-links"><a href={route.url} data-access-route="digital">Read at Project Gutenberg</a></div></article>)}
      </div>
      <details class="river-small-detail"><summary>Buying used or borrowing: a few useful checks</summary><div><p>Search by ISBN to target the edition above. Before buying, confirm the translator on the title page, binding, notes, condition, shipping and total price. Listings can combine different editions. These are verified search routes, not promises of a particular copy.</p><p>Search your local library’s catalog with the title and author, then check the translator or ISBN in its record. Ask about interlibrary loan, or check its ebook service. The Bernofsky card links to a Libby ebook with a different ISBN (9780307423696); the other cards link to a local catalog entry point, with exact holdings unconfirmed. <a href="https://www.elsegundolibrary.gov/">El Segundo Public Library</a> is a local starting point. A library card and local lending rules may apply.</p><p>The 1922 German publication date does not make every English translation free. Project Gutenberg identifies the linked files as public domain in the United States. Check the rules where you are before downloading; modern translations and introductions can have separate rights.</p></div></details>
    </section>
    <section id="about" class="river-about river-section" aria-labelledby="about-title">
      <div class="river-about-title"><p class="river-kicker">Before the first page / no ending revealed</p><h2 id="about-title">A journey.<br/>Not a doctrine.</h2><span class="river-year">1922</span></div>
      <div class="river-prose"><p class="river-lead">A young man leaves the life expected of him and goes looking for a wisdom he can experience for himself.</p><p>Hesse follows that search through asceticism, encounter, desire and ordinary life. The novel’s language is spare; its questions are spacious. What can another person teach us? What must we discover by living? And what changes when we stop trying to master the world?</p><p>Siddhartha is Hesse’s fictional seeker. Gotama, the Buddha, is a separate figure in the story. This is a literary novel set in an imagined ancient India, not a biography of the historical Buddha or a reliable survey of Indian religions.</p><p>First published in German in 1922, <i>Siddhartha</i> brings Hindu and Buddhist ideas into Hesse’s own European literary and spiritual concerns. Read its beauty with curiosity, and its cultural distance with attention. <a href={catalog.contextSources.novel}>Publisher’s novel record</a>.</p></div>
    </section>
    <section class="river-author river-section" aria-labelledby="author-title"><header><p class="river-kicker">About the author</p><h2 id="author-title">Hermann Hesse.<br/>Words & watercolor.</h2></header><div class="river-prose"><p>Hesse (1877–1962) was a German-born writer who lived in Switzerland. He received the Nobel Prize in Literature in 1946. His novels return to inward life, self-discovery and the uneasy relationship between an individual and society.</p><p>He also painted. The <a href={catalog.contextSources.painting}>Hesse portal’s painting archive</a> follows his watercolor practice, including the landscapes of Ticino. This shelf’s river prints are new interpretations made for PointCast; they are not Hesse’s paintings or historical documents.</p><p>His <a href="https://www.hermann-hesse.de/leben-und-werk/biografie/indienreise/">1911 journey</a>, often called an India journey, took him through Southeast Asia and Ceylon rather than mainland India. The novel’s imagined setting is therefore a place to explore critically, rather than an eyewitness account.</p><p>For the person behind the novel, begin with the <a href={catalog.contextSources.biography}>Nobel facts</a>, then explore the <a href={catalog.contextSources.archive}>Hermann Hesse portal</a>. For a second Hesse novel, follow the portal’s work records for <i>Demian</i> or <i>The Glass Bead Game</i>; each opens a different part of his world.</p></div></section>
    <figure class="river-reflections"><img src="/images/siddhartha/river-reflections.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="Original blue and amber pigment-print study of a river eddy and broken reflected light"/><figcaption><span>02 / A little closer</span><span>Original AI-generated artwork for PointCast</span></figcaption></figure>
    <section id="reading" class="river-section river-reading" aria-labelledby="reading-title"><header class="river-section-head"><div><p class="river-kicker">A reader’s companion</p><h2 id="reading-title">Take the<br/>long way.</h2></div><p>There is no correct pace. These are invitations to notice, not instructions for reaching enlightenment.</p></header>
      <ol class="river-pathways"><li><span class="river-kicker">First reading</span><h3>Let the story arrive.</h3><p>Choose the translation you enjoy reading. Read the novel before an introduction that may discuss its ending. After each sitting, note one image and one question. Leave explanations for later.</p></li><li><span class="river-kicker">Second reading</span><h3>Listen for the pattern.</h3><p>Follow a recurring image: water, a smile, a voice, a crossing. Notice where it returns and whether its meaning has changed. Compare your beginning and ending notes.</p></li><li><span class="river-kicker">Two translations</span><h3>Hear another voice.</h3><p>Compare the same short passage in two lawful copies. Attend to sentence rhythm, repeated words and religious terms. A translator’s decisions shape the voice; no edition here is declared the definitive one.</p></li></ol>
      <details class="river-deeper" id="discussion"><summary><span><span class="river-kicker">Optional / contains plot spoilers</span><strong>After the river: themes & discussion</strong></span><span class="river-detail-symbol" aria-hidden="true">+</span></summary><div class="river-deeper-content"><p class="river-shop-note">Open this after finishing the novel. These are PointCast’s reading interpretations, not claims about a single intended meaning.</p><div class="river-discussion-grid"><article><h3>Experience & teaching</h3><p>Siddhartha respects Gotama but cannot take over another person’s path. Does the novel reject teaching, or distinguish a teaching from the experience that gives it meaning?</p></article><article><h3>The cost of discovery</h3><p>His life with Kamala and Kamaswami complicates a neat opposition between spiritual and worldly life. What does this period make possible, and what does it cost?</p></article><article><h3>Learning to listen</h3><p>Vasudeva’s attention offers a different model of guidance. What is the difference between solving someone’s problem and making room for them to hear it?</p></article><article><h3>Time & the river</h3><p>The river holds change and continuity together. How do repeated images of water alter the story’s sense of time? Does unity erase pain, or make it possible to hold more than one truth?</p></article><article><h3>Love & attachment</h3><p>Siddhartha’s relationship with his son tests his own desire to direct another life. Where does love become possession? How does this change your reading of his earlier departures?</p></article><article><h3>A final encounter</h3><p>At the end, Govinda’s encounter with Siddhartha brings knowledge, language and recognition into tension. What can the closing image do that an argument cannot?</p></article></div><p class="river-reading-close">For a reading group: let each person begin with an image, allow disagreement, then return to the words in your own edition. If you quote, record the translator and page; pagination differs.</p></div></details>
    </section>
    <section id="sources" class="river-section river-sources" aria-labelledby="sources-title"><header><p class="river-kicker">The source shelf</p><h2 id="sources-title">Follow the<br/>original trail.</h2><p>Checked {catalog.checkedAt}. Publisher records establish edition details; catalogs establish discovery routes. Editorial suggestions are our own.</p></header><ol>{catalog.sources.map(source=><li><a href={source.url}>{source.title}</a><p>{source.use}</p></li>)}</ol></section>
    <footer class="river-footer"><div><span class="river-footer-title">Siddhartha.</span><p>A bookshop & reader’s companion<br/>PointCast / October 2026</p></div><div><p>Original text by PointCast. No excerpts from modern translations are reproduced. River artwork generated with OpenAI’s built-in image generator; <a href="/images/siddhartha/provenance.json">prompts & provenance</a>. No publisher cover art is reproduced. No paid or affiliate links on this shelf.</p><nav aria-label="More from PointCast"><a href="/siddhartha.json">Editions & sources JSON</a><a href="/shop">PointCast Shop</a><a href="/">Back to PointCast</a></nav></div></footer>
  </div>
</BlockLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.river-filters');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-river-entry]')];
  const status = document.querySelector('#river-results');
  if (filters && entries.length && status) {
    filters.hidden = false;
    filters.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-route-filter]');
      if (!button || !filters.contains(button)) return;
      const route = button.dataset.routeFilter!;
      filters.querySelectorAll<HTMLButtonElement>('button').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      let visible = 0;
      for (const entry of entries) {
        entry.hidden = route !== 'all' && !entry.dataset.routes?.split(' ').includes(route);
        if (!entry.hidden) visible++;
        entry.querySelectorAll<HTMLElement>('[data-access-route]').forEach(link => { link.hidden = route !== 'all' && link.dataset.accessRoute !== route; });
      }
      status.textContent = route === 'all' ? 'Four print editions and two digital reading routes.' : `${visible} ${route === 'digital' ? 'digital reading routes' : 'editions'} · ${button.textContent}.`;
    });
  }
</script>
