---
import BlockLayout from '../layouts/BlockLayout.astro';
import MicroAppShell from '../components/MicroAppShell.astro';
import { MORNING_OCEAN_TOKENS } from '../data/morning-ocean';
import { ZEN_CAT_GENESIS_COLLECTIBLES } from '../data/zen-cat-collectibles';
import { getPointcastApp } from '../lib/pointcast-apps';

const app = getPointcastApp('cabinet')!;
const title = app.name;
const description = app.description;
const images = [
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[0].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[0].title} Zen Cat collectible` },
  { src: MORNING_OCEAN_TOKENS[7].imageUrl, alt: `${MORNING_OCEAN_TOKENS[7].title} Morning Ocean collectible` },
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[4].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[4].title} Zen Cat collectible` },
  { src: MORNING_OCEAN_TOKENS[22].imageUrl, alt: `${MORNING_OCEAN_TOKENS[22].title} Morning Ocean collectible` },
  { src: ZEN_CAT_GENESIS_COLLECTIBLES[10].imageUrl, alt: `${ZEN_CAT_GENESIS_COLLECTIBLES[10].title} Zen Cat collectible` },
  { src: MORNING_OCEAN_TOKENS[16].imageUrl, alt: `${MORNING_OCEAN_TOKENS[16].title} Morning Ocean collectible` },
];

const shelves = [
  {
    id: 'mint',
    label: 'Mint Receipts',
    key: 'pc:mint-studio:receipts',
    href: '/mint-studio',
    action: 'Draft one collectible brief',
    empty: 'No mint receipts yet.',
  },
  {
    id: 'harbor',
    label: 'Harbor Watchlist',
    key: 'pc:harbor-log:watchlist',
    href: '/harbor-log',
    action: 'Draw a morning vessel',
    empty: 'No ocean vessels watched yet.',
  },
  {
    id: 'passport',
    label: 'Cat Passport',
    key: 'pc:cat-passport:stamps',
    href: '/cat-passport',
    action: 'Stamp one world cat route',
    empty: 'No passport stamps yet.',
  },
  {
    id: 'gallery',
    label: 'Gallery Shows',
    key: 'pc:gallery-wall:shows',
    href: '/gallery-wall',
    action: 'Curate one wall',
    empty: 'No curated walls yet.',
  },
  {
    id: 'signal',
    label: 'Signal Garden',
    key: 'pc:signal-garden:plants',
    href: '/signal-garden',
    action: 'Plant today',
    empty: 'No garden plants yet.',
  },
  {
    id: 'ritual',
    label: 'Ritual Clock',
    key: 'pc:ritual-clock:marks',
    href: '/ritual-clock',
    action: 'Mark today',
    empty: 'No daily ritual marks yet.',
  },
  {
    id: 'exchange',
    label: 'Exchange Table',
    key: 'pc:exchange-table:wishes',
    href: '/exchange-table',
    action: 'Add one intent note',
    empty: 'No exchange notes yet.',
  },
  {
    id: 'provenance',
    label: 'Provenance Ledger',
    key: 'pc:provenance-ledger:exports',
    href: '/provenance-ledger',
    action: 'Generate proof sheet',
    empty: 'No proof sheets yet.',
  },
  {
    id: 'atlas',
    label: 'World Atlas',
    key: 'pc:world-atlas:stamps',
    href: '/world-atlas',
    action: 'Stamp one atlas stop',
    empty: 'No atlas stamps yet.',
  },
  {
    id: 'referrals',
    label: 'Invite Ledger',
    key: 'pc:referral-garden:invites',
    href: '/referral-garden',
    action: 'Record one disclosed invite',
    empty: 'No invite receipts yet.',
  },
  {
    id: 'sats',
    label: 'Sats Path',
    key: 'pc:sats-path:checks',
    href: '/sats-path',
    action: 'Mark one learning checkpoint',
    empty: 'No readiness checkpoints yet.',
  },
  {
    id: 'ocean',
    label: 'Morning Ocean',
    key: 'pc:morning-ocean:collection',
    href: '/morning-ocean',
    action: 'Collect one ocean card locally',
    empty: 'No Morning Ocean cards yet.',
  },
  {
    id: 'cats',
    label: 'Zen Cats',
    key: 'pc:zen-cats:collection',
    href: '/zen-cats',
    action: "Complete today's cat ritual",
    empty: 'No daily cats collected yet.',
  },
  {
    id: 'journey',
    label: 'Journey Prints',
    key: 'pc:zen-cats:journey',
    href: '/zen-cats#journey',
    action: 'Unlock one journey print',
    empty: 'No journey prints yet.',
  },
];

const featured = [
  {
    href: '/zen-cats',
    eyebrow: 'Cats',
    title: 'Daily calm, world routes, and gem cards.',
    image: ZEN_CAT_GENESIS_COLLECTIBLES[1].imageUrl,
  },
  {
    href: '/morning-ocean',
    eyebrow: 'Ocean',
    title: 'Boats, dawn water, and mintable maritime cards.',
    image: MORNING_OCEAN_TOKENS[5].imageUrl,
  },
  {
    href: '/mint-studio',
    eyebrow: 'Mint',
    title: 'Draft the provenance before the chain.',
    image: MORNING_OCEAN_TOKENS[19].imageUrl,
  },
  {
    href: '/world-atlas',
    eyebrow: 'Path',
    title: 'Landmarks, gemstones, and the route map.',
    image: ZEN_CAT_GENESIS_COLLECTIBLES[8].imageUrl,
  },
  {
    href: '/gallery-wall',
    eyebrow: 'Gallery',
    title: 'Arrange the collection into quiet rooms.',
    image: ZEN_CAT_GENESIS_COLLECTIBLES[12].imageUrl,
  },
  {
    href: '/signal-garden',
    eyebrow: 'Garden',
    title: 'Let local signals grow in place.',
    image: ZEN_CAT_GENESIS_COLLECTIBLES[7].imageUrl,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://pointcast.xyz/cabinet',
  name: app.name,
  description,
  url: app.url,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Web',
};
---

<BlockLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  frame={{
    image: 'https://pointcast.xyz/images/morning-ocean/series-contact-sheet.png',
    buttons: [
      { label: 'Open Cabinet', action: 'link', target: 'https://pointcast.xyz/cabinet' },
      { label: 'Zen Cats', action: 'link', target: 'https://pointcast.xyz/zen-cats' },
      { label: 'Morning Ocean', action: 'link', target: 'https://pointcast.xyz/morning-ocean' },
    ],
  }}
>
  <MicroAppShell
    app={app}
    headline="Everything you picked up gets a place to live."
    dek="The Cabinet is a local-only shelf for PointCast collectibles, receipts, stamps, invites, and learning checkpoints. It reads your browser's existing app state and turns it into a calm collector dashboard."
    images={images}
    stats={[
      { label: 'Shelves', value: shelves.length },
      { label: 'Storage', value: 'local' },
      { label: 'Sharing', value: 'manual' },
      { label: 'Custody', value: 'yours' },
    ]}
    links={[
      { href: '/zen-cats', label: 'Cats' },
      { href: '/morning-ocean', label: 'Ocean' },
      { href: '/apps', label: 'Apps' },
    ]}
  >
    <section class="app-section cabinet" data-cabinet>
      <div class="cabinet-status">
        <article class="cabinet-score">
          <p class="mono-note">Cabinet Score</p>
          <strong data-cabinet-score>0</strong>
          <span data-cabinet-status>Open a source app to start filling the shelf.</span>
        </article>
        <article class="cabinet-next">
          <p class="mono-note">Next Best Move</p>
          <strong data-cabinet-next-title>Start with a receipt</strong>
          <span data-cabinet-next-copy>Mint Studio is the fastest way to add a first object.</span>
          <a class="app-button" data-cabinet-next-link href="/mint-studio">Open source</a>
        </article>
      </div>

      <section class="shelf-grid" aria-label="Cabinet shelves">
        {shelves.map((shelf) => (
          <article class="shelf-card" data-shelf={shelf.id}>
            <div>
              <p class="mono-note">{shelf.label}</p>
              <strong data-shelf-count={shelf.id}>0</strong>
              <span data-shelf-preview={shelf.id}>{shelf.empty}</span>
            </div>
            <a href={shelf.href}>{shelf.action}</a>
          </article>
        ))}
      </section>

      <section class="tool-grid tray" aria-label="Featured source apps">
        <div class="tool-panel">
          <h2>Featured Tray</h2>
          <p>Four doors into the collection loop. Each one adds a different kind of object to the Cabinet.</p>
          <div class="feature-grid">
            {featured.map((item) => (
              <a class="feature-card" href={item.href}>
                <img src={item.image} alt="" width="1024" height="1024" loading="lazy" decoding="async" />
                <span>{item.eyebrow}</span>
                <strong>{item.title}</strong>
              </a>
            ))}
          </div>
        </div>

        <aside class="tool-panel tool-panel--ink">
          <p class="mono-note">Latest Objects</p>
          <h2 data-latest-title>Nothing on the velvet yet.</h2>
          <p data-latest-copy>As you collect locally, your newest receipts appear here without leaving your browser.</p>
          <ol class="cabinet-ledger" data-cabinet-ledger></ol>
          <div class="button-row">
            <button type="button" data-refresh-cabinet>Refresh cabinet</button>
            <a class="app-button" href="/apps">Open app index</a>
          </div>
        </aside>
      </section>
    </section>
  </MicroAppShell>
  <script id="cabinet-shelves" type="application/json" is:inline set:html={JSON.stringify(shelves)}></script>
</BlockLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-cabinet]');
    const dataEl = document.querySelector('#cabinet-shelves');
    if (!root || !dataEl) return;
    const shelves = JSON.parse(dataEl.textContent || '[]');
    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));
    const readItems = (key) => {
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || '[]');
        if (Array.isArray(parsed)) return parsed;
        if (parsed && typeof parsed === 'object') return Object.values(parsed);
      } catch {}
      return [];
    };
    const itemLabel = (item) => {
      if (item == null) return 'receipt';
      if (typeof item === 'string' || typeof item === 'number') return String(item);
      return item.title || item.name || item.alias || item.id || item.tokenId || item.code || 'receipt';
    };
    const itemDetail = (item) => {
      if (!item || typeof item !== 'object') return '';
      return [
        item.collection,
        item.city && item.country ? `${item.city}, ${item.country}` : item.country,
        item.vessel,
        item.gem,
        item.rarity,
        item.savedAt || item.date || item.stampedAt,
      ].filter(Boolean).slice(0, 3).join(' - ');
    };
    const render = () => {
      const shelfStates = shelves.map((shelf) => {
        const items = readItems(shelf.key);
        const count = items.length;
        const latest = items[count - 1];
        const countEl = root.querySelector(`[data-shelf-count="${shelf.id}"]`);
        const previewEl = root.querySelector(`[data-shelf-preview="${shelf.id}"]`);
        const cardEl = root.querySelector(`[data-shelf="${shelf.id}"]`);
        if (countEl) countEl.textContent = String(count);
        if (previewEl) {
          previewEl.textContent = count ? itemLabel(latest) : shelf.empty;
        }
        if (cardEl) cardEl.toggleAttribute('data-filled', count > 0);
        return { ...shelf, items, count, latest };
      });
      const total = shelfStates.reduce((sum, shelf) => sum + shelf.count, 0);
      const filled = shelfStates.filter((shelf) => shelf.count > 0).length;
      const scoreEl = root.querySelector('[data-cabinet-score]');
      const statusEl = root.querySelector('[data-cabinet-status]');
      const nextTitleEl = root.querySelector('[data-cabinet-next-title]');
      const nextCopyEl = root.querySelector('[data-cabinet-next-copy]');
      const nextLinkEl = root.querySelector('[data-cabinet-next-link]');
      const latestTitleEl = root.querySelector('[data-latest-title]');
      const latestCopyEl = root.querySelector('[data-latest-copy]');
      const ledgerEl = root.querySelector('[data-cabinet-ledger]');
      if (scoreEl) scoreEl.textContent = String(total);
      if (statusEl) {
        statusEl.textContent = total
          ? `${filled} of ${shelves.length} shelves have something on them.`
          : 'Open a source app to start filling the shelf.';
      }
      const next = shelfStates.find((shelf) => shelf.count === 0) || shelfStates.sort((a, b) => a.count - b.count)[0];
      if (nextTitleEl && next) nextTitleEl.textContent = next.count ? `Balance ${next.label}` : next.label;
      if (nextCopyEl && next) nextCopyEl.textContent = next.count ? next.action : next.empty;
      if (nextLinkEl && next) nextLinkEl.href = next.href;
      const latestItems = shelfStates
        .flatMap((shelf) => shelf.items.slice(-3).map((item, index) => ({ shelf, item, index })))
        .slice(-8)
        .reverse();
      if (latestTitleEl) latestTitleEl.textContent = latestItems.length ? 'Fresh on the shelf.' : 'Nothing on the velvet yet.';
      if (latestCopyEl) {
        latestCopyEl.textContent = latestItems.length
          ? 'Newest local objects from the connected PointCast apps.'
          : 'As you collect locally, your newest receipts appear here without leaving your browser.';
      }
      if (ledgerEl) {
        ledgerEl.innerHTML = latestItems.map(({ shelf, item }) => {
          const detail = itemDetail(item);
          return `<li><span>${escapeHtml(shelf.label)}</span><strong>${escapeHtml(itemLabel(item))}</strong>${detail ? `<small>${escapeHtml(detail)}</small>` : ''}</li>`;
        }).join('');
      }
    };
    root.querySelector('[data-refresh-cabinet]')?.addEventListener('click', render);
    window.addEventListener('storage', render);
    render();
  })();
</script>

<style>
  .cabinet-status {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
    margin-bottom: 12px;
  }
  .cabinet-score,
  .cabinet-next {
    min-width: 0;
    border: 1px solid var(--pc-rule-soft);
    background:
      linear-gradient(135deg, rgba(214, 177, 74, 0.08), transparent 46%),
      #fff;
    padding: 14px;
  }
  .cabinet-score strong {
    display: block;
    font-size: clamp(54px, 12vw, 132px);
    line-height: 0.86;
    font-weight: 500;
  }
  .cabinet-score span,
  .cabinet-next span {
    display: block;
    margin-top: 10px;
    color: var(--pc-ink-soft);
    line-height: 1.45;
  }
  .cabinet-next {
    display: grid;
    align-content: start;
    gap: 10px;
    background:
      linear-gradient(90deg, rgba(24, 95, 165, 0.08), transparent),
      #f8f7f2;
  }
  .cabinet-next strong {
    display: block;
    font-size: clamp(28px, 5vw, 56px);
    line-height: 0.96;
    font-weight: 500;
  }
  .cabinet-next .app-button {
    justify-self: start;
  }
  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .shelf-card {
    min-height: 172px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--pc-rule-soft);
    background: #fff;
    padding: 12px;
  }
  .shelf-card[data-filled] {
    border-color: #2d8a59;
    background:
      radial-gradient(circle at 90% 12%, rgba(45, 138, 89, 0.16), transparent 34%),
      #fff;
  }
  .shelf-card strong {
    display: block;
    font-size: 42px;
    line-height: 0.95;
    font-weight: 500;
  }
  .shelf-card span {
    display: block;
    margin-top: 8px;
    min-height: 38px;
    color: var(--pc-ink-soft);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .shelf-card a {
    color: var(--pc-ink);
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .tray {
    margin-top: 14px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }
  .feature-card {
    color: var(--pc-ink);
    border: 1px solid var(--pc-rule-soft);
    background: #f8f7f2;
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 8px;
    text-decoration: none;
  }
  .feature-card:hover {
    border-color: var(--pc-ink);
    text-decoration: none;
  }
  .feature-card img {
    width: 92px;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid rgba(18, 17, 14, 0.12);
  }
  .feature-card span {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8A2432;
  }
  .feature-card strong {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 500;
  }
  .cabinet-ledger {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .cabinet-ledger li {
    border: 1px solid rgba(246, 241, 228, 0.18);
    background: rgba(255, 255, 255, 0.06);
    padding: 10px;
  }
  .cabinet-ledger span,
  .cabinet-ledger small {
    display: block;
    color: rgba(246, 241, 228, 0.66);
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cabinet-ledger strong {
    display: block;
    margin: 5px 0;
    font-size: 16px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (max-width: 960px) {
    .cabinet-status,
    .shelf-grid,
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .cabinet-status,
    .shelf-grid,
    .feature-grid,
    .feature-card {
      grid-template-columns: 1fr;
    }
    .feature-card img {
      width: 100%;
      max-height: 220px;
    }
  }
</style>
