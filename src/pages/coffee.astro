---
import PantryHub from '../components/PantryHub.astro';
import guide from '../data/pantry/coffee.json';
---
<PantryHub guide={guide} />
<script is:inline>
// Preserve the original room's fragment entrances and carry query context.
const roomIds = new Set(['shelf-title','coffee-greeting','coffee-pour','coffee-tally','coffee-cups-num','coffee-tally-note','coffee-global','coffee-global-num','coffee-shelf','coffee-shelf-heading','coffee-shelf-list','coffee-shelf-note','coffee-history-title','coffee-history-stat','coffee-history-total','coffee-history-rail','coffee-shelf-title','coffee-shelf-count','coffee-shelf-count-s','coffee-mint-title','coffee-mint-wallet-hint','coffee-mint-total','coffee-mint-feed-wrap','coffee-mint-feed-title','coffee-mint-feed','coffee-noun','coffee-noun-img']);
if(roomIds.has(location.hash.slice(1)) || new URLSearchParams(location.search).get('room')==='1') location.replace('/coffee/room/'+location.search+location.hash);
document.querySelectorAll('a[href="/coffee/room/"]').forEach(a=>a.href='/coffee/room/'+location.search);
</script>
