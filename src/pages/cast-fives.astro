---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Fives — record five seconds, loop it forever" description="Press the button. Five seconds of mic gets recorded. The page loops it forever. Pitch shift, reverse, layer with itself. No upload — the audio stays in your tab. The OP-1 record-loop trick, in a browser.">
  <main class="cf" id="cf" data-built={built}>
    <header class="cf__hero">
      <p class="cf__kicker">CAST · FIVES · 5-second mic loop · in the browser</p>
      <h1 class="cf__title">Fives.</h1>
      <p class="cf__sub">Press record. Five seconds of microphone get captured. The page loops it forever. Pitch up, pitch down, reverse it, layer two takes against each other. The OP-1 record-and-loop trick, no hardware required.</p>
    </header>

    <section class="cf__gate" id="cf-gate">
      <button class="cf__enable" id="cf-enable" type="button">
        <span class="cf__enable-icon">●</span>
        <span class="cf__enable-text">
          <span class="cf__enable-main">Enable microphone</span>
          <span class="cf__enable-sub">Browser asks permission. Audio stays in this tab — nothing uploaded.</span>
        </span>
      </button>
    </section>

    <section class="cf__main" id="cf-main" hidden>
      <div class="cf__lights">
        <div class="cf__slot" id="cf-slot-A">
          <div class="cf__slot-head">
            <span class="cf__slot-letter">A</span>
            <span class="cf__slot-state" id="cf-slot-A-state">empty</span>
          </div>
          <canvas class="cf__wave" id="cf-wave-A" width="600" height="80"></canvas>
          <div class="cf__slot-controls">
            <button class="cf__rec" data-slot="A" type="button">REC</button>
            <button class="cf__loop" data-slot="A" type="button" aria-pressed="false">LOOP</button>
            <div class="cf__pitch">
              <span class="cf__pitch-label">pitch</span>
              <input type="range" class="cf__pitch-range" data-slot="A" min="0.5" max="2" step="0.01" value="1"/>
              <span class="cf__pitch-val" id="cf-pitch-A">1.00×</span>
            </div>
            <button class="cf__rev" data-slot="A" type="button" aria-pressed="false">REV</button>
            <input type="range" class="cf__vol" data-slot="A" min="0" max="100" value="70"/>
          </div>
        </div>

        <div class="cf__slot" id="cf-slot-B">
          <div class="cf__slot-head">
            <span class="cf__slot-letter">B</span>
            <span class="cf__slot-state" id="cf-slot-B-state">empty</span>
          </div>
          <canvas class="cf__wave" id="cf-wave-B" width="600" height="80"></canvas>
          <div class="cf__slot-controls">
            <button class="cf__rec" data-slot="B" type="button">REC</button>
            <button class="cf__loop" data-slot="B" type="button" aria-pressed="false">LOOP</button>
            <div class="cf__pitch">
              <span class="cf__pitch-label">pitch</span>
              <input type="range" class="cf__pitch-range" data-slot="B" min="0.5" max="2" step="0.01" value="1"/>
              <span class="cf__pitch-val" id="cf-pitch-B">1.00×</span>
            </div>
            <button class="cf__rev" data-slot="B" type="button" aria-pressed="false">REV</button>
            <input type="range" class="cf__vol" data-slot="B" min="0" max="100" value="70"/>
          </div>
        </div>
      </div>

      <div class="cf__countdown" id="cf-countdown" hidden>
        <span class="cf__countdown-num" id="cf-countdown-num">5</span>
        <span class="cf__countdown-sub">recording…</span>
      </div>
    </section>

    <section class="cf__about">
      <h2 class="cf__about-h">How it works</h2>
      <p>Recording uses <code>MediaRecorder</code> at the browser's chosen audio codec (typically Opus inside WebM). When the 5 seconds end, the page passes the Blob to <code>AudioContext.decodeAudioData</code>, which returns an <code>AudioBuffer</code>. Looping playback is one <code>AudioBufferSourceNode</code> with <code>loop = true</code>, per slot, routed through a per-slot gain.</p>
      <p>Pitch is <code>playbackRate</code> on the source node (0.5 = octave down, 2.0 = octave up). It changes pitch and speed together, like a tape deck — no granular pitch-shifting.</p>
      <p>Reverse swaps for a second AudioBuffer built by reading the original buffer's float32 samples backwards. Toggling reverse re-starts the loop with the new buffer.</p>
      <p>Two slots (A and B) so you can layer two takes against each other — clap on A, hum on B, both loop forever. Different pitches on each create polyrhythmic illusion since the loops drift.</p>
      <p>Audio never leaves the page. The MediaRecorder Blob is held only in memory, not uploaded. Closing the tab destroys everything.</p>
      <p>Pair with <a href="/cast-mirror">/cast-mirror</a> (pitch tracking), <a href="/cast-loop">/cast-loop</a> (synth-only loops), <a href="/cast-pulse">/cast-pulse</a> (synth drums).</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cf-ink: #0a0810;
      --cf-walnut: #4a2a1a;
      --cf-flame: #f6c15e;
      --cf-flame-deep: #d68f2c;
      --cf-cream: #f4e7c8;
      --cf-cream-dim: #c8b48a;
      --cf-cream-dimmer: #8b7a5a;
      --cf-rose: #e6788c;
      --cf-mint: #9bd7b8;
      --cf-mauve: #b39ddb;
    }

    body:has(.cf) {
      background: radial-gradient(circle at 50% 0%, #2a1428 0%, var(--cf-ink) 60%);
      color: var(--cf-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cf { max-width: 920px; margin: 0 auto; padding: 48px 24px 80px; }

    .cf__hero { text-align: center; margin-bottom: 32px; }
    .cf__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cf-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cf__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 138px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cf-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .cf__sub {
      max-width: 640px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cf-cream-dim);
    }

    /* GATE */
    .cf__gate {
      display: flex;
      justify-content: center;
      margin: 36px 0;
    }
    .cf__enable {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 26px;
      border-radius: 16px;
      border: 2px solid var(--cf-flame);
      background: rgba(246,193,94,0.08);
      color: var(--cf-cream);
      cursor: pointer;
      transition: background 100ms ease, transform 60ms ease;
    }
    .cf__enable:hover { background: rgba(246,193,94,0.16); transform: translateY(-1px); }
    .cf__enable-icon {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--cf-rose);
      box-shadow: 0 0 14px rgba(230,120,140,0.6);
    }
    .cf__enable-text { display: flex; flex-direction: column; gap: 4px; text-align: left; }
    .cf__enable-main {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 17px;
      color: var(--cf-flame);
    }
    .cf__enable-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cf-cream-dim);
    }

    /* SLOTS */
    .cf__lights {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 32px;
    }
    .cf__slot {
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 18px;
      padding: 18px 20px;
      transition: border-color 100ms ease, box-shadow 200ms ease;
    }
    .cf__slot--recording {
      border-color: var(--cf-rose);
      box-shadow: 0 0 30px rgba(230,120,140,0.32);
    }
    .cf__slot--looping {
      border-color: var(--cf-mint);
    }
    .cf__slot-head {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 12px;
    }
    .cf__slot-letter {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: 32px;
      color: var(--cf-flame);
      letter-spacing: -0.02em;
    }
    .cf__slot-state {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      color: var(--cf-cream-dimmer);
      text-transform: uppercase;
    }
    .cf__wave {
      width: 100%;
      height: 80px;
      background: rgba(0,0,0,0.3);
      border-radius: 10px;
      display: block;
      margin-bottom: 14px;
    }
    .cf__slot-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .cf__rec, .cf__loop, .cf__rev {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 12px;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--cf-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cf__rec:hover, .cf__loop:hover:not(:disabled), .cf__rev:hover:not(:disabled) {
      background: rgba(246,193,94,0.12);
    }
    .cf__rec--active {
      background: var(--cf-rose);
      color: var(--cf-walnut);
      border-color: var(--cf-rose);
    }
    .cf__loop[aria-pressed="true"], .cf__rev[aria-pressed="true"] {
      background: var(--cf-flame);
      color: var(--cf-walnut);
      border-color: var(--cf-flame);
    }
    .cf__loop:disabled, .cf__rev:disabled { opacity: 0.4; cursor: not-allowed; }
    .cf__pitch {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .cf__pitch-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--cf-cream-dimmer);
    }
    .cf__pitch-range {
      width: 100px;
      accent-color: var(--cf-flame);
    }
    .cf__pitch-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--cf-flame);
      min-width: 38px;
    }
    .cf__vol {
      width: 80px;
      accent-color: var(--cf-flame);
      margin-left: auto;
    }

    /* COUNTDOWN */
    .cf__countdown {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(0,0,0,0.7);
      border: 2px solid var(--cf-rose);
      border-radius: 20px;
      padding: 32px 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      box-shadow: 0 0 60px rgba(230,120,140,0.4);
      z-index: 50;
    }
    .cf__countdown-num {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: 96px;
      color: var(--cf-rose);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .cf__countdown-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.14em;
      color: var(--cf-cream-dim);
      text-transform: uppercase;
    }

    /* ABOUT */
    .cf__about {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cf__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cf-cream);
      margin: 0 0 12px;
    }
    .cf__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--cf-cream-dim);
      margin: 0 0 12px;
    }
    .cf__about code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(244,231,200,0.08);
      color: var(--cf-flame);
    }
    .cf__about a { color: var(--cf-flame); text-decoration: none; }
    .cf__about a:hover { text-decoration: underline; }
  </style>

  <script>
    // ---- types & state ----
    type SlotKey = 'A' | 'B';
    type SlotState = {
      buffer: AudioBuffer | null;
      reversedBuffer: AudioBuffer | null;
      sourceNode: AudioBufferSourceNode | null;
      gain: GainNode | null;
      looping: boolean;
      reversed: boolean;
      pitch: number;
      volume: number;
      recorder: MediaRecorder | null;
    };

    const slots: Record<SlotKey, SlotState> = {
      A: { buffer: null, reversedBuffer: null, sourceNode: null, gain: null, looping: false, reversed: false, pitch: 1, volume: 0.7, recorder: null },
      B: { buffer: null, reversedBuffer: null, sourceNode: null, gain: null, looping: false, reversed: false, pitch: 1, volume: 0.7, recorder: null },
    };

    let ctx: AudioContext | null = null;
    let mediaStream: MediaStream | null = null;
    const RECORD_SECONDS = 5;

    // ---- enable mic ----
    async function enable() {
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
          video: false,
        });
      } catch (e) {
        document.getElementById('cf-gate')!.innerHTML = `<p style="color: var(--cf-rose); font-family: 'JetBrains Mono', monospace; font-size: 14px;">Microphone permission denied. Refresh and re-enable to try again.</p>`;
        return;
      }
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      // init per-slot gain
      for (const key of ['A', 'B'] as SlotKey[]) {
        const g = ctx.createGain();
        g.gain.value = slots[key].volume;
        g.connect(ctx.destination);
        slots[key].gain = g;
      }
      document.getElementById('cf-gate')!.style.display = 'none';
      document.getElementById('cf-main')!.removeAttribute('hidden');
    }

    // ---- recording ----
    function startRecord(key: SlotKey) {
      if (!ctx || !mediaStream) return;
      if (ctx.state === 'suspended') ctx.resume();
      // Stop existing loop if any
      stopLoop(key);
      // Cleanup any prior recorder
      if (slots[key].recorder) {
        try { slots[key].recorder!.stop(); } catch {}
        slots[key].recorder = null;
      }
      const recorder = new MediaRecorder(mediaStream);
      slots[key].recorder = recorder;
      const chunks: Blob[] = [];
      recorder.ondataavailable = (e) => { if (e.data && e.data.size > 0) chunks.push(e.data); };
      recorder.onstop = async () => {
        const blob = new Blob(chunks, { type: chunks[0]?.type || 'audio/webm' });
        try {
          const arrayBuffer = await blob.arrayBuffer();
          const audioBuf = await ctx!.decodeAudioData(arrayBuffer);
          slots[key].buffer = audioBuf;
          slots[key].reversedBuffer = null;  // recompute when needed
          renderWave(key, audioBuf);
          updateSlotState(key, 'ready');
          // auto-start the loop
          startLoop(key);
          // toggle the LOOP button visually
          const loopBtn = document.querySelector(`.cf__loop[data-slot="${key}"]`) as HTMLButtonElement;
          loopBtn.setAttribute('aria-pressed', 'true');
        } catch (err) {
          updateSlotState(key, 'decode error');
          console.error('decode failed', err);
        }
        // Stop UI
        document.getElementById('cf-countdown')!.setAttribute('hidden', '');
        document.getElementById(`cf-slot-${key}`)!.classList.remove('cf__slot--recording');
        const recBtn = document.querySelector(`.cf__rec[data-slot="${key}"]`) as HTMLButtonElement;
        recBtn.classList.remove('cf__rec--active');
        recBtn.textContent = 'REC';
      };
      recorder.start();

      // UI
      document.getElementById(`cf-slot-${key}`)!.classList.add('cf__slot--recording');
      const recBtn = document.querySelector(`.cf__rec[data-slot="${key}"]`) as HTMLButtonElement;
      recBtn.classList.add('cf__rec--active');
      recBtn.textContent = 'STOP';
      updateSlotState(key, 'recording…');
      // Countdown
      document.getElementById('cf-countdown')!.removeAttribute('hidden');
      let secondsLeft = RECORD_SECONDS;
      document.getElementById('cf-countdown-num')!.textContent = String(secondsLeft);
      const tick = window.setInterval(() => {
        secondsLeft--;
        if (secondsLeft <= 0) {
          clearInterval(tick);
          try { recorder.stop(); } catch {}
        } else {
          document.getElementById('cf-countdown-num')!.textContent = String(secondsLeft);
        }
      }, 1000);
    }

    function stopRecord(key: SlotKey) {
      if (slots[key].recorder && slots[key].recorder!.state === 'recording') {
        try { slots[key].recorder!.stop(); } catch {}
      }
    }

    // ---- playback ----
    function reverseBuffer(buf: AudioBuffer): AudioBuffer {
      const reversed = ctx!.createBuffer(buf.numberOfChannels, buf.length, buf.sampleRate);
      for (let ch = 0; ch < buf.numberOfChannels; ch++) {
        const src = buf.getChannelData(ch);
        const dst = reversed.getChannelData(ch);
        for (let i = 0; i < src.length; i++) {
          dst[i] = src[src.length - 1 - i];
        }
      }
      return reversed;
    }

    function startLoop(key: SlotKey) {
      const s = slots[key];
      if (!ctx || !s.gain) return;
      stopLoop(key);
      let buf = s.buffer;
      if (!buf) return;
      if (s.reversed) {
        if (!s.reversedBuffer) s.reversedBuffer = reverseBuffer(buf);
        buf = s.reversedBuffer;
      }
      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.loop = true;
      src.playbackRate.value = s.pitch;
      src.connect(s.gain);
      src.start();
      s.sourceNode = src;
      s.looping = true;
      document.getElementById(`cf-slot-${key}`)!.classList.add('cf__slot--looping');
      updateSlotState(key, `looping · ${s.pitch.toFixed(2)}×${s.reversed ? ' rev' : ''}`);
    }

    function stopLoop(key: SlotKey) {
      const s = slots[key];
      if (s.sourceNode) {
        try { s.sourceNode.stop(); } catch {}
        try { s.sourceNode.disconnect(); } catch {}
        s.sourceNode = null;
      }
      s.looping = false;
      document.getElementById(`cf-slot-${key}`)!.classList.remove('cf__slot--looping');
      if (s.buffer) updateSlotState(key, 'ready');
    }

    function updateSlotState(key: SlotKey, txt: string) {
      const el = document.getElementById(`cf-slot-${key}-state`)!;
      el.textContent = txt;
    }

    // ---- waveform rendering ----
    function renderWave(key: SlotKey, buf: AudioBuffer) {
      const canvas = document.getElementById(`cf-wave-${key}`) as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      const W = canvas.width, H = canvas.height;
      c2.clearRect(0, 0, W, H);
      // Get mono mix
      const ch0 = buf.getChannelData(0);
      const len = ch0.length;
      // Downsample to W columns; min/max per bucket
      c2.strokeStyle = '#f6c15e';
      c2.lineWidth = 1.5;
      c2.beginPath();
      const samplesPerCol = Math.max(1, Math.floor(len / W));
      for (let x = 0; x < W; x++) {
        let min = 1, max = -1;
        const start = x * samplesPerCol;
        const end = Math.min(len, start + samplesPerCol);
        for (let i = start; i < end; i++) {
          if (ch0[i] < min) min = ch0[i];
          if (ch0[i] > max) max = ch0[i];
        }
        const yMin = H / 2 - min * (H / 2);
        const yMax = H / 2 - max * (H / 2);
        c2.moveTo(x, yMin);
        c2.lineTo(x, yMax);
      }
      c2.stroke();
      // center line
      c2.strokeStyle = 'rgba(244,231,200,0.14)';
      c2.lineWidth = 1;
      c2.beginPath();
      c2.moveTo(0, H / 2);
      c2.lineTo(W, H / 2);
      c2.stroke();
    }

    // ---- wiring ----
    function init() {
      document.getElementById('cf-enable')!.addEventListener('click', enable);

      // REC buttons
      document.querySelectorAll('.cf__rec').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-slot') as SlotKey;
          const s = slots[key];
          if (s.recorder && s.recorder.state === 'recording') {
            stopRecord(key);
          } else {
            startRecord(key);
          }
        });
      });

      // LOOP toggle
      document.querySelectorAll('.cf__loop').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-slot') as SlotKey;
          const s = slots[key];
          if (!s.buffer) return;
          const pressed = btn.getAttribute('aria-pressed') === 'true';
          if (pressed) {
            stopLoop(key);
            btn.setAttribute('aria-pressed', 'false');
          } else {
            startLoop(key);
            btn.setAttribute('aria-pressed', 'true');
          }
        });
      });

      // REV toggle
      document.querySelectorAll('.cf__rev').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-slot') as SlotKey;
          const s = slots[key];
          if (!s.buffer) return;
          s.reversed = !s.reversed;
          btn.setAttribute('aria-pressed', String(s.reversed));
          if (s.looping) startLoop(key);  // restart with new buffer
        });
      });

      // Pitch range
      document.querySelectorAll<HTMLInputElement>('.cf__pitch-range').forEach(slider => {
        slider.addEventListener('input', () => {
          const key = slider.getAttribute('data-slot') as SlotKey;
          const s = slots[key];
          s.pitch = parseFloat(slider.value);
          document.getElementById(`cf-pitch-${key}`)!.textContent = `${s.pitch.toFixed(2)}×`;
          if (s.sourceNode) s.sourceNode.playbackRate.setTargetAtTime(s.pitch, ctx!.currentTime, 0.02);
        });
      });

      // Volume range
      document.querySelectorAll<HTMLInputElement>('.cf__vol').forEach(slider => {
        slider.addEventListener('input', () => {
          const key = slider.getAttribute('data-slot') as SlotKey;
          const s = slots[key];
          s.volume = parseInt(slider.value) / 100;
          if (s.gain && ctx) s.gain.gain.setTargetAtTime(s.volume, ctx.currentTime, 0.02);
        });
      });

      document.addEventListener('visibilitychange', () => {
        if (!ctx) return;
        if (document.hidden) ctx.suspend().catch(() => {});
        else ctx.resume().catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
