---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ANTI_PATTERNS, ARCHITECTURE, CACHE_META, CACHE_NOTES, PERMISSION_DESIGN, QUERY_PATTERNS, REFERENCES, ROADMAP, WHATS_IN } from '../lib/commonKnowledgeCache';
const title = `${CACHE_META.title} — ${CACHE_META.subtitle}`;
const description = CACHE_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'TechArticle', '@id': 'https://pointcast.xyz/common-knowledge-cache', name: CACHE_META.title, description, url: 'https://pointcast.xyz/common-knowledge-cache', datePublished: CACHE_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/common-knowledge-cache.json', title: 'Common-Knowledge Cache (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/p2p-ai">p2p-ai</a><span aria-hidden="true">/</span><span>common-knowledge-cache</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{CACHE_META.paperNumber} · {CACHE_META.status}</p>
      <h1>COMMON / CACHE.</h1>
      <p class="subtitle">{CACHE_META.subtitle}</p>
      <p class="thesis">{CACHE_META.thesis}</p>
    </header>

    <section class="arch"><p class="kicker">ARCHITECTURE</p><h2>How it works.</h2>
      <dl class="dl">
        <div><dt>Corpus</dt><dd>{ARCHITECTURE.corpus}</dd></div>
        <div><dt>Indexing</dt><dd>{ARCHITECTURE.indexing}</dd></div>
        <div><dt>Storage</dt><dd>{ARCHITECTURE.storage}</dd></div>
        <div><dt>Refresh cadence</dt><dd>{ARCHITECTURE.refreshCadence}</dd></div>
        <div><dt>API exposure</dt><dd>{ARCHITECTURE.apiExposure}</dd></div>
        <div><dt>Permission model</dt><dd>{ARCHITECTURE.permissionModel}</dd></div>
      </dl>
    </section>

    <section class="contents"><p class="kicker">WHAT'S IN · 7 CATEGORIES</p><h2>The corpus inventory.</h2>
      <ol class="cn-list">{WHATS_IN.map((c) => (
        <li>
          <h3>{c.category} <span class="cn__count">— {c.count}</span></h3>
          <p class="cn__ex"><strong>Examples:</strong> {c.examples}</p>
          <p class="cn__notes">{c.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="patterns"><p class="kicker">QUERY PATTERNS · 6</p><h2>What the cache is good at.</h2>
      <ol class="qp-list">{QUERY_PATTERNS.map((q) => (
        <li>
          <h3>{q.pattern}</h3>
          <p class="qp__ex"><strong>Example:</strong> {q.example}</p>
          <p class="qp__use"><strong>Use case:</strong> {q.useCase}</p>
        </li>
      ))}</ol>
    </section>

    <section class="perm"><p class="kicker">PERMISSION DESIGN</p><h2>The level field.</h2>
      <dl class="dl">
        <div><dt>Outbound</dt><dd>{PERMISSION_DESIGN.outbound}</dd></div>
        <div><dt>Inbound</dt><dd>{PERMISSION_DESIGN.inbound}</dd></div>
        <div><dt>No training</dt><dd>{PERMISSION_DESIGN.noTraining}</dd></div>
        <div><dt>Vendor parity</dt><dd>{PERMISSION_DESIGN.vendorParity}</dd></div>
        <div><dt>Participant data exclusion</dt><dd>{PERMISSION_DESIGN.participantDataExclusion}</dd></div>
        <div><dt>Appeal process</dt><dd>{PERMISSION_DESIGN.appealProcess}</dd></div>
      </dl>
    </section>

    <section class="anti"><p class="kicker">ANTI-PATTERNS · 6</p><h2>What the cache will not become.</h2>
      <ol class="ap-list">{ANTI_PATTERNS.map((a) => (
        <li>
          <h3>{a.antiPattern}</h3>
          <p>{a.why}</p>
        </li>
      ))}</ol>
    </section>

    <section class="rd"><p class="kicker">ROADMAP · 2026 Q3 → 2027 Q4+</p><h2>Construction calendar.</h2>
      <ol class="rd-list">{ROADMAP.map((r) => (
        <li>
          <span class="rd__q">{r.quarter}</span>
          <p>{r.milestone}</p>
        </li>
      ))}</ol>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · ENGINEERS · DOGFOODERS</p>
      <p>{CACHE_NOTES.uesNote}</p>
      <p class="invite-cta">{CACHE_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/p2p-ai">P2P AI · Working Paper</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/pointcast-connectors">PointCast Connectors</a>
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/agents.json">/agents.json</a>
      <a href="/common-knowledge-cache.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --ck-ink:#1a1a1a; --ck-paper:#fdf9ee; --ck-mustard:#d4a534; --ck-rust:#b85a3a; --ck-sage:#2d6a3d; --ck-violet:#5b3d7a; --ck-fog:#d8d2c4; --ck-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--ck-paper); color: var(--ck-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--ck-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--ck-violet); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ck-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--ck-violet); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--ck-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }

  .dl { margin: 0 0 12px; display: grid; gap: 6px; }
  .dl > div { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--ck-ink); border-left: 5px solid var(--ck-violet); }
  .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ck-violet); padding-top: 2px; }
  .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .cn-list, .qp-list, .ap-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .cn-list li, .qp-list li, .ap-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--ck-ink); border-left: 6px solid var(--ck-violet); }
  .cn__count { font-family: var(--pc-font-mono); font-size: 10.5px; letter-spacing: .1em; color: var(--ck-rust); margin-left: 6px; font-weight: 500; }
  .cn__ex, .qp__ex, .qp__use { padding: 6px 10px; background: var(--ck-paper); border-left: 3px solid var(--ck-mustard); margin: 6px 0 !important; font-size: 12.5px !important; line-height: 1.55; }
  .cn__notes, .ap-list p, .qp-list p { margin: 0 0 4px; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ck-violet); margin-right: 4px; }

  .rd-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .rd-list li { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--ck-ink); border-left: 5px solid var(--ck-violet); align-items: baseline; }
  .rd__q { font-family: var(--pc-font-mono); font-size: 11.5px; font-weight: 700; color: var(--ck-violet); letter-spacing: .1em; }
  .rd-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .invitation { background: var(--ck-violet); color: var(--ck-paper); border-top-color: var(--ck-violet); }
  .invitation .kicker { background: var(--ck-mustard); color: var(--ck-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--ck-mustard); color: var(--ck-ink); border-left: 4px solid var(--ck-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--ck-violet); color: var(--ck-paper); text-decoration: none; }
  .links a:hover { background: var(--ck-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .rd-list li { grid-template-columns: 1fr; } }
</style>
