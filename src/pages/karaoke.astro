---
import SONGS from '../data/bell-choir-songs.json';
import CATALOGUE from '../data/karaoke-catalogue.json';
import '../styles/karaoke.css';
import '../styles/karaoke-nouns.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Shwa Karaoke · Sing with the room · PointCast</title>
  <meta name="description" content="A seven-song karaoke starter set, Noun avatars, three original bell songs, and private pitch practice. Sing solo or with friends around one screen." />
  <link rel="canonical" href="https://pointcast.xyz/karaoke/" />
  <meta property="og:title" content="Shwa Karaoke · Sing with the room" />
  <meta property="og:description" content="Come as you are. The bells carry the tune; you bring your voice." />
  <meta property="og:image" content="https://pointcast.xyz/images/bell-choir/bloom-1a.jpg" />
  <meta name="theme-color" content="#f4f0df" />
</head>
<body>
<main class="shell" id="karaoke">
  <header class="topbar"><a href="/">POINTCAST</a><a href="/bell-choir">BELL CHOIR ↗</a><span id="presence">SOLO PRACTICE</span></header>
  <section class="intro"><div><p class="eyebrow">A little room for your voice.</p><h1>Sing with<br /><em>the room.</em></h1></div><p>Songs you know. A face for every voice. <br />Bring a friend, take a turn, <br />give the chorus its flowers.</p></section>
  <nav class="room-strip" aria-label="Singing mode">
    <button class="mode" data-mode="solo" aria-pressed="true">Solo practice</button>
    <button class="mode" data-mode="group" aria-pressed="false">Sing together</button>
    <span class="pill">NO RECORDING</span><button class="pill share" id="share">Share this song ↗</button>
  </nav>
  <p id="mode-note" class="mode-note">A private practice on this screen. Hum first; the words will be waiting.</p>
  <section class="stage">
    <article class="performance" aria-label="Karaoke player">
      <div class="stage-head"><span id="song-label">CHOOSE YOUR SONG</span><span id="status" role="status">READY WHEN YOU ARE</span></div>
      <div class="singers"><span class="singer" id="singer-label">YOUR VOICE · YOUR PACE</span><label id="group-size-wrap" hidden>Singers <select id="group-size" aria-label="Number of singers at this screen">{[2,3,4,5,6,7,8].map(n => <option value={n}>{n}</option>)}</select></label></div>
      <section id="noun-companions" aria-label="Your Noun avatars"></section>
      <section id="video-stage" class="video-stage" hidden aria-label="Publisher karaoke player">
        <p class="eyebrow" id="video-artist"></p><h2 id="video-title"></h2>
        <div id="video-container" class="video-container"></div>
        <div class="video-actions"><button id="video-load" class="primary">Load YouTube player</button><button id="video-close" class="secondary" hidden>Close player</button></div>
        <p id="video-status" class="small" role="status">Load the player, then press its play button.</p>
        <p class="fine" id="video-credit"></p><p class="fine" id="video-note"></p>
        <p class="fine">Loading connects to YouTube. Playback, ads, lyrics, and availability are controlled by the publisher and YouTube. No track or lyric files are stored here.</p>
        <a id="video-source" target="_blank" rel="noopener noreferrer">Open on YouTube ↗</a>
      </section>
      <div id="bell-stage">
      <div class="lyric-wrap"><div><div class="lyrics" id="lyrics"></div><p class="next" id="next"></p></div></div>
      <p class="sr-only" id="line-announcement" aria-live="polite" aria-atomic="true"></p>
      <progress id="progress" value="0" max="1" aria-label="Song progress"></progress>
      <div class="transport"><button class="primary" id="start">Sing with the bells</button><button class="secondary" id="stop" disabled>Stop</button><button class="secondary" id="restart">Start over</button></div>
      <div class="sound-controls"><label>Pace <select id="pace"><option value="0.8">Gentle</option><option value="1" selected>Original</option><option value="1.15">Lively</option></select></label><span id="bpm"></span><label>Volume <input id="volume" type="range" min="0" max="1" step="0.05" value="0.45" /></label></div>
      <p class="player-note" id="player-note">Four beats to breathe, then follow the underlined word.</p>
      </div>
    </article>
    <aside class="side">
      <details class="card shwa"><summary>SHWA · YOUR SONG GUIDE ✦</summary><p id="shwa-line">“A hum counts. You don’t have to earn your place in the chorus.”</p><small>Prepared encouragement · no live AI call</small></details>
      <section class="card starter-set"><div class="card-heading"><h2>THE STARTER SET</h2><span class="tiny">VOL. 01</span></div><p class="small">Seven songs to begin. A bigger catalogue, one good source at a time.</p><label class="song-search">Find a song or artist<input id="song-search" type="search" placeholder="Try Weezer…" autocomplete="off" /></label><div class="songs" id="catalogue">{CATALOGUE.map((song,i)=><button class="song catalogue-song" data-catalogue={i} aria-pressed="false"><span class="song-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span><strong>{song.title}</strong><small>{song.artist} · {song.mood}</small></span></button>)}</div><p id="search-empty" class="small" hidden>No match in this starter set. Try another artist or clear your search.</p></section>
      <section class="card"><h2>THREE ORIGINAL SONGS</h2><div class="songs" id="songs">{SONGS.map((song, i) => <button class="song" data-song={i} aria-pressed={i===0?'true':'false'}><img src={song.image} alt="" width="48" height="48" /><span><strong>{song.title}</strong><small>{song.tag}</small></span></button>)}</div></section>
      <section class="card practice"><div class="card-heading"><h2>FIND YOUR NOTE</h2><span class="tiny">PRIVATE</span></div><p class="small">Try one steady hum. See the nearest note and how far above or below it you are.</p><div class="pitch-readout"><strong id="pitch-note">—</strong><span id="pitch-detail">Microphone off</span></div><meter id="pitch-meter" min="-50" max="50" optimum="0" value="0" aria-label="Cents above or below nearest note" hidden></meter><p class="sr-only" id="pitch-announcement" aria-live="polite" aria-atomic="true"></p><button class="secondary" id="mic" aria-pressed="false">Enable private pitch practice</button><p class="small" id="mic-status" role="status">Mic audio stays in this tab. No recording, upload, or saved pitch history.</p><p class="fine">One voice at a time, without accompaniment. Starting practice closes the video and stops the bells. This does not score your singing.</p></section>
    </aside>
  </section>
  <section class="after-song" id="after-song" hidden aria-labelledby="rating-title">
    <div><p class="eyebrow">A little reflection, if you like.</p><h2 id="rating-title">How did that feel?</h2><p id="rating-note">These are your impressions, not a measurement of your voice.</p><div id="ratings" class="ratings"></div><button id="save-rating" class="primary" disabled>Keep these flowers on this screen</button><p id="rating-result" role="status">Choose flowers for each feeling, or simply sing again.</p></div>
    <div class="flowers-card"><h3>Give a little applause</h3><p>Reactions from taps on this screen.</p><div class="reactions">{[['👏','Applause'],['❤️','Love'],['✨','Sparkle'],['🌼','Flowers']].map(([emoji,label]) => <button class="reaction" data-label={label} aria-label={`${label}: 0`}><span aria-hidden="true">{emoji}</span><b>0</b></button>)}</div><p class="award" id="award" hidden></p></div>
  </section>
  <details class="songbook" id="bell-songbook"><summary>Keep the full lyrics close</summary><div id="songbook"></div></details>
  <footer><p>Solo or together around one screen. Reactions and reflections stay here and reset with the next song. Shared links open the song; they do not connect microphones or synchronize devices.</p><a href="/bell-choir/sing/">The quiet sing-along ↗</a></footer>
  <noscript><p>Enable JavaScript for bell playback, synchronized lyrics, and pitch practice. <a href="/bell-choir/sing/">Visit Bell Choir</a>.</p></noscript>
</main><p id="toast" class="toast" role="status"></p>
<script>import '../scripts/karaoke.mjs';</script>
</body></html>
