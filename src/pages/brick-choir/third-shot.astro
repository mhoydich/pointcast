  .big small{font:600 10px var(--mono);letter-spacing:.14em;color:rgba(20,15,40,.65);display:block;margin-top:3px;text-transform:uppercase;} .big.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.14);box-shadow:none;} .big.ghost small{color:rgba(244,240,255,.5);}
