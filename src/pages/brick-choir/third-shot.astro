/* ================= avatars: sensible positioning that respects the depth you chose ================= */
const zOf=(depth,side)=>side*(depth==='kitchen'?KZ+C.KITCHEN_LINE:depth==='trans'?13.5:21.2);
function setDepth(seat,d){ av[seat].depth=d; }
function tierSpeed(){ return {park:12.5,club:15,pro:17.5}[match.tier]||15; }
function positionAll(dt,T){
  const live=state==='play'&&ball.live; const rt=live&&ball.hitTeam>=0?1-ball.hitTeam:-1;
  av.forEach(a=>{ const s=SEATS[a.seat]; const S=s.side; const d=(a.seat===0&&a.depthPref)?a.depthPref:a.depth; let tz=zOf(d,S), tx=a.homeX;
    if(live&&s.team===rt){ const des=designated[rt]===a.seat;
      if(des&&intercept.valid){ tx=clamp(intercept.x,-HW-1.5,HW+1.5); if(a.erne){ tx=Math.sign(intercept.x)*(HW+1.3); tz=S*Math.min(Math.abs(intercept.z),KZ-0.5); } else { const iz=Math.abs(intercept.z); if(intercept.bounced||iz>Math.abs(tz)){ tz=S*clamp(iz,d==='kitchen'?KZ+0.15:KZ+0.5,HL+2.5); } else if(iz<Math.abs(tz)-0.2&&!intercept.bounced&&d==='kitchen'){ tz=S*Math.max(KZ+0.15,iz); } } }
      else { const other=TEAMS[rt].seats.find(x=>x!==a.seat); const ballOnMine=intercept.valid?Math.sign(intercept.x)===Math.sign(a.homeX):false; tx=Math.sign(a.homeX)*(ballOnMine?5.5:(intercept.valid&&Math.abs(intercept.x)<3?2.2:3.4)); if(d==='kitchen'&&av[other].depth!=='kitchen'&&!av[other].depthPref) tz=S*(KZ+C.KITCHEN_LINE); } }
    else if(live){ const ht=ball.hitTeam; if(s.team===ht){ tx=Math.sign(a.homeX)*(Math.abs(a.homeX)<3?a.homeX:4.5); } }
    if(a.pin!==undefined) tz=a.pin; a.tx=clamp(tx,-HW-3.5,HW+3.5); a.tz=tz;
    const sp=(players[a.seat].human?16:tierSpeed())*(state==='play'?1:0.75)*dt; const dx=a.tx-a.x, dz=a.tz-a.z, dist=Math.hypot(dx,dz);
    if(dist>0.01){ const k=Math.min(1,sp/dist); a.x+=dx*k; a.z+=dz*k; a.moving=dist>0.35; a.face=Math.atan2(dx,dz); } else a.moving=false; });
}
/* the designated hitter: nearest to the ball with the middle to the forehand; a "mine"/"yours" call or a poach overrides */
function assignHitter(){ const rt=1-ball.hitTeam; if(rt<0||rt>1) return; const seats=TEAMS[rt].seats; if(!intercept.valid){ designated[rt]=seats[0]; return; }
  let pick; if(rt===0&&(calls.mine>now()||(match.tutorial&&!autopilot))) pick=0; else if(rt===0&&calls.yours>now()) pick=1;
  else { const ix=intercept.x; const mid=Math.abs(ix)<1.6; if(mid){ pick=seats.find(x=>av[x].homeX*SEATS[x].side<0); } else pick=seats.reduce((b,x)=>Math.abs(av[x].x-ix)<Math.abs(av[b].x-ix)?x:b,seats[0]);
    // the poach: an AI partner takes a slow, high ball drifting toward the middle
    const T=C.TIERS[match.tier]; const part=seats.find(x=>x!==pick&&!players[x].human); if(part!==undefined&&intercept.floater&&Math.abs(ix-av[part].x)<5.5&&rnd()<T.attack*0.35){ pick=part; av[part].call='MINE!'; av[part].callT=now(); } }
  designated[rt]=pick; }
/* where and when will the receiving side meet this ball? — the first legal contact within reach of the designated Buddy's zone */
function predict(){ intercept.valid=false; if(!ball.live||ball.hitTeam<0) return; const rt=1-ball.hitTeam; const S=TEAMS[rt].side; const b=Object.assign(TS.mkBall(),ball,{hist:null}); const dt=1/90; let t=0, first=null, apex=null, low=null, bestVol=null, landZ=null; const seat=designated[rt]>=0?designated[rt]:TEAMS[rt].seats[0]; const a=av[seat]; const myZ=a.pin!==undefined?Math.abs(a.pin):Math.abs(zOf((seat===0&&a.depthPref)||a.depth,S)); const atLine=myZ<KZ+2;
  for(let i=0;i<260;i++){ const ev=TS.stepBall(b,dt,true); t+=dt; if(ev==='net') break; if(!b.live) break; if(sideOf(b.z)!==S) continue; if(b.bounces>=2) break; if(ev==='bounce'&&landZ===null) landZ=Math.abs(b.z);
    const okRule=TS.mayHit(b,{side:S}).ok; if(!okRule) continue; const zb=Math.abs(b.z); const inNVZ=zb<KZ&&Math.abs(b.x)<=HW+0.3; const pinned=a.pin!==undefined&&Math.abs(a.pin)<KZ+0.7; const wideV=(Math.abs(b.x)>HW-2.5&&b.vx*Math.sign(b.x)>2)||Math.abs(b.x)>HW-1.0;
    if(b.bounces===0){ if(inNVZ&&!pinned&&!(wideV&&atLine)) continue; // no volleys from inside the kitchen (unless it's an Erne wide of the line)
      if(b.y>0.8&&b.y<7.5){ const near=Math.abs(zb-myZ); if(atLine&&zb>=(wideV||pinned?1.2:KZ-1.2)&&zb<=myZ+2.5&&(bestVol===null||b.y>bestVol.y+0.05)) bestVol={x:b.x,y:b.y,z:b.z,t,bounced:false,near}; /* take it out of the air as high as you can reach */ if(!atLine&&near<1.8&&(!first||b.y>first.y)) first={x:b.x,y:b.y,z:b.z,t,bounced:false}; } }
