/* ================= the hit window, slow-mo, the auto lunge ================= */
function updateWindow(T){ const a=av[0]; const mine=state==='play'&&ball.live&&ball.hitTeam===1&&designated[0]===0&&intercept.valid&&intercept.team===0; const left=mine?intercept.arrive-T:1e9;
  const open=mine&&left<C.HIT_EARLY*1.3&&left>-C.HIT_LATE*3&&a.hitDone!==ball.shot+1; if(mine&&intercept.wide&&!intercept.bounced&&Math.abs(a.z)<KZ+2.5&&!a.erne){ a.erne=true; hint('ERNE — jump it!'); } const was=myWindow.open; myWindow={open,arrive:intercept.arrive,left,y:intercept.y,x:intercept.x,attackable:mine&&TS.attackable(intercept.y,intercept.x),shot:ball.shot+1,bounced:intercept.bounced,zone:TS.zone(a.z)};
  if(open&&!was&&!autopilot){ if(myWindow.attackable){ coach('ATTACKABLE — jab to put it away','good'); buzz(8); } else if(myWindow.zone==='kitchen'&&intercept.y<TS.netH(intercept.x)) coach('Below the net: dink it','info'); else if(myWindow.shot===3&&myWindow.zone!=='kitchen') coach('Third shot: a short soft flick drops it in','info'); if(match.tutorial) tutorialWindow(); }
  const want=(mine&&left<700&&left>-150)?C.SLOWMO:1; slowmo=lerp(slowmo,want===1?0:1,0.25); timeScale=lerp(1,C.SLOWMO,slowmo);
  if(TESTMODE&&window.__freeze){ if(mine&&!pending&&a.hitDone!==ball.shot+1&&(frozen||(left<140&&left>-60))){ frozen=true; timeScale=0.0001; } else frozen=false; } else frozen=false; }
function applyPending(T){ if(!pending) return; if(state!=='play'||ball.hitTeam===0){ pending=null; return; } const a=av[0]; if(T>pending.until){ pending=null; return; } const d=Math.hypot(ball.x-a.x,ball.z-a.z); if(TS.mayHit(ball,{side:1}).ok&&d<=REACH+0.6&&ball.y<8) hitHuman(pending.shot); }
function lungeCheck(T){ if(autopilot) return; if(state!=='play'||!ball.live||ball.hitTeam!==1||designated[0]!==0||!intercept.valid) return; const a=av[0]; if(a.hitDone===ball.shot+1) return; const left=intercept.arrive-T; const d=Math.hypot(ball.x-a.x,ball.z-a.z);
  const passed=(ball.z-a.z)>1.6||(left<-C.HIT_LATE*1.6&&d<=REACH+1.2); if(passed&&TS.mayHit(ball,{side:1}).ok&&d<=REACH+1.5&&ball.y<7.5&&!pending){ // no swipe: the Buddy gets a paddle on it — a weak block, easy to attack
    const shot={kind:'block',aim:0,pace:0.25}; hitHuman(shot); hint('swipe to choose your shot'); if(!lastHuman||!lastHuman.lunge) coach('Swipe when the ring closes — a lunge just floats it','info'); if(lastHuman) lastHuman.lunge=true; } }

/* ================= tick: fixed 120 Hz substeps × the slow-mo scale ================= */
let lastT=now(), acc=0; const STEP=1/120;
function tick(T){ if(paused||tutHold){ lastT=T; return; } acc+=Math.min(0.5,(T-lastT)/1000); lastT=T; let n=0; while(acc>=STEP&&n<60&&!paused&&!tutHold){ acc-=STEP; n++; substep(STEP*timeScale,T); } if(paused||tutHold) acc=0; camKick*=Math.pow(0.05,n*STEP); flare*=Math.pow(0.05,n*STEP); }
function substep(dt,T){
  if(stateNext&&T>=stateNext.at){ const s=stateNext.s; stateNext=null; ({afterPoint,gameOver,drillNext})[s](); }
  if(state==='serve'){ const sv=score.server; if((!players[sv].human||autopilot)&&T>=autoServeT){ serve(sv,TS.aiDecide({shot:1,rnd,tier:match.tier,style:match.style,side:SEATS[sv].side})); } else if(players[sv].human&&T>=autoServeT){ hint('auto serve'); serve(sv,{kind:'serve',aim:0,pace:0.7,depth:0.8}); } }
  positionAll(frozen?STEP*C.SLOWMO:dt,T); if(state!=='play') return;
  if(ball.live){ predict(); const rt=1-ball.hitTeam; if(designated[rt]<0) assignHitter(); updateWindow(T); applyPending(T); lungeCheck(T);
    // the AI hitter
    const seat=designated[rt]; if(seat>=0&&(!players[seat].human||autopilot)){ const a=av[seat]; if(!a.decided&&intercept.valid&&a.hitDone!==ball.shot+1) a.decided=aiThink(seat); if(a.decided&&a.hitDone!==ball.shot+1){ const d=Math.hypot(ball.x-a.x,ball.z-a.z); const okRule=TS.mayHit(ball,{side:SEATS[seat].side}).ok; const arrived=intercept.valid&&T>=intercept.arrive-30; const late=(ball.z-a.z)*SEATS[seat].side>1.2; if(okRule&&((d<=REACH*0.75&&(arrived||ball.bounces>0))||(late&&d<=REACH+0.8))&&ball.y<8){ if(a.miss===undefined){ const T2=C.TIERS[match.tier]; const atkIn=TS.ATTACKS.has(ball.kind)&&ball.pace>0.55; const lowIn=clamp(1-(intercept.y-1)/3,0,1); const hard=atkIn?(1-T2.block)*lowIn*(ball.kind==='putaway'?1.9:1.1)*(0.6+ball.pace*0.5):0; a.miss=rnd()<(T2.skill<0.6?0.05:0.02)+(intercept.wide?0.1:0)+hard; } if(a.miss){ a.hitDone=ball.shot+1; a.swingT=T; a.miss=undefined; } else { a.miss=undefined; aiHit(seat); } } } }
    const ev=TS.stepBall(ball,dt,false,rnd); ball.hist.push([T,ball.x,ball.y,ball.z]); if(ball.hist.length>40) ball.hist.shift();
    if(ball.atp&&!ball.atpTagged){ ball.atpTagged=true; if(lastShot&&lastShot.seat===0) S.atp++; word('AROUND THE POST!',toScreen(ball.x,3,ball.z),{color:'#fff3c4',huge:true}); highlight={tag:'atp',t:now()}; crowdRoar(false); lastPoint.tag='atp'; }
    if(ev==='bounce') onBounce(); else if(ev==='net'){ drum('rim',{vel:0.5}); tone(degOf(0,48),{kind:'bass',len:0.25,vel:0.5}); if(ball.hitTeam===0&&lastShot&&lastShot.seat===0){ if(lastShot.attackLow||(TS.ATTACKS.has(lastShot.kind)&&!lastShot.attackable&&lastShot.zone==='kitchen')) {} } } else if(ev==='cord'){ cordSfx(); word('net cord!',[50,48],{color:'#fff3c4'}); }
    if(ball.netted&&ball.y<=0.02&&Math.abs(ball.vy)<1.5){ pointOver(1-ball.hitTeam,'net'); if(ball.hitTeam===0&&lastShot&&lastShot.seat===0&&lastShot.kind==='drop') coach('Drop found the net — a touch more arc','warn'); }
    if(!ball.live&&state==='play'){ pointOver(sideOf(ball.z)>0?1:0,'dead'); }
    if(ball.live&&ball.bounces>=1&&Math.abs(ball.z)>HL+12) { pointOver(sideOf(ball.z)>0?1:0,'double'); } }
}

/* ================= a match, the daily, the drills, the tutorial ================= */
function startMatch(o={}){ clearTimeout(reportT); match.mode=o.mode||'match'; match.drill=null; match.tutorial=!!o.tutorial; match.daily=o.daily||null; match.tier=o.tier||settings.tier; match.scoring=o.scoring||settings.scoring; match.to=match.scoring==='rally'?7:11; match.style=o.style||rnd.pick(['banger','dinker','lobber','allcourt']);
  if(o.seed!==undefined){ rnd=TS.rng(o.seed); } else rnd=RND; castOpponents(); if(o.style) match.style=o.style;
  S=stats(); lastHuman=null; pointsPlayed=0; longest=0; highlight=null; score=TS.Score({to:match.to,mode:match.scoring,first:o.first!==undefined?o.first:(rnd()<0.5?0:1)}); if(o.score){ score.score=o.score.slice(); }
  render_rebuild(); $('oppTier').textContent=C.TIERS[match.tier].name; $('oppStyle').textContent=match.style==='allcourt'?'all-court':match.style+'s'; $('drill').hidden=true;
  showScreen(null); beginPoint(); }
/* the daily: a seeded scenario, one attempt a day, a streak */
const DAILY=[{t:'Down 7–9, receiving',line:'beat the bangers from behind',score:[7,9],first:1,tier:'club',style:'banger'},{t:'Dink war at 9–9',line:'the pros never pop up… until they do',score:[9,9],first:0,tier:'pro',style:'dinker'},{t:'Serving at 3–8',line:'lobbers at the park — stay patient',score:[3,8],first:0,tier:'park',style:'lobber'},{t:'0–0 vs the pros',line:'a full game, every third shot a drop',score:[0,0],first:1,tier:'pro',style:'allcourt'},{t:'10–10, your serve',line:'one point at a time against the bangers',score:[10,10],first:0,tier:'club',style:'banger'},{t:'Receiving at 5–10',line:'five side-outs from the finish',score:[5,10],first:1,tier:'club',style:'dinker'},{t:'Up 8–4, hold on',line:'close it out against the lobbers',score:[8,4],first:0,tier:'pro',style:'lobber'}];
const isoDay=()=>new Date().toISOString().slice(0,10);
function dailyInfo(){ const day=isoDay(); const seed=TS.seedOfDay(day); const sc=DAILY[seed%DAILY.length]; const d=store.get('bc3:daily',{}); const y=new Date(Date.now()-86400000).toISOString().slice(0,10); const streak=(d.last===day||d.last===y)?(d.streak|0):0; return {day,seed,sc,played:d.last===day,won:d.last===day&&d.won,streak}; }
function startDaily(){ const di=dailyInfo(); if(di.played&&!TESTMODE) return; startMatch({mode:'daily',daily:di,seed:di.seed,tier:di.sc.tier,style:di.sc.style,score:di.sc.score,first:di.sc.first,scoring:'trad'}); }
function dailyResult(won){ const di=dailyInfo(); const d=store.get('bc3:daily',{}); const y=new Date(Date.now()-86400000).toISOString().slice(0,10); const prev=(d.last===y)?(d.streak|0):(d.last===di.day?(d.streak|0):0); const streak=won?(d.last===di.day?prev:prev+1):0; store.set('bc3:daily',{last:di.day,won,streak:won?streak:0,best:Math.max(d.best|0,streak)}); }
/* drills: a feed machine on the far side, a counter, a target */
const DRILLS={
  drop:{title:'THIRD-SHOT DROP',label:'IN THE KITCHEN',goal:10,line:'Return comes deep. Flick it soft into the kitchen.',setup(){ av[0].depth='base'; av[1].depth='base'; av[2].depth='kitchen'; av[3].depth='kitchen'; av[0].homeX=5; av[1].homeX=-5; av[2].homeX=-5; av[3].homeX=5; },feed(){ feedBall({x:-4,y:2.4,z:-20},{tx:av[0].homeX*0.9+rnd.range(-2,2),tz:17+rnd.range(0,4),clear:2.0,kind:'ret'}); },bounce(landedOn){ if(landedOn===1&&lastShot&&lastShot.seat===0){ const inK=TS.inKitchen(ball.x,ball.z); if(inK){ drillScore(1,'IN!'); } else drillScore(0,'long'); } },aiOverride(d,seat){ return {kind:'dink',aim:0,pace:0.4,catch:true}; },pressure:0},
  dink:{title:'DINK BATTLE',label:'DINKS IN A ROW',goal:0,lives:3,line:'Stay soft. Attack only the ball that glows.',setup(){ av[0].depth='kitchen'; av[1].depth='kitchen'; av[2].depth='kitchen'; av[3].depth='kitchen'; },feed(){ feedBall({x:-4,y:1.6,z:-8},{tx:av[0].homeX+rnd.range(-1.5,1.5),tz:4.5,clear:0.9,kind:'dink'}); },bounce(){},pressure:0.02},
  reset:{title:'TRANSITION RESET',label:'RESETS IN',goal:8,line:'You’re mid-court, they volley at your feet. A reverse flick absorbs it.',setup(){ av[0].depth='trans'; av[1].depth='trans'; av[2].depth='kitchen'; av[3].depth='kitchen'; },feed(){ feedBall({x:-3,y:3.6,z:-8},{tx:av[0].homeX+rnd.range(-1.5,1.5),tz:12.5+rnd.range(-1.5,1.5),kind:'drive',pace:0.62}); },bounce(landedOn){ if(landedOn===1&&lastShot&&lastShot.seat===0){ if(TS.inKitchen(ball.x,ball.z)) drillScore(1,'RESET!'); else drillScore(0,'too deep'); } },aiOverride(d){ return {kind:'dink',aim:0,pace:0.4}; },pressure:0},
  putaway:{title:'PUT-AWAY',label:'WINNERS',goal:10,line:'They pop it up. When it glows, jab.',setup(){ av[0].depth='kitchen'; av[1].depth='kitchen'; av[2].depth='kitchen'; av[3].depth='kitchen'; },feed(){ feedBall({x:-3,y:1.6,z:-8},{tx:av[0].homeX+rnd.range(-2,2),tz:11+rnd.range(0,2.5),clear:2.4+rnd.range(0,0.8),kind:'dink'}); },bounce(){},pressure:0} };
function feedBall(from,o){ resetBall(); const S1=-1; let v; if(o.kind==='drive'){ v=TS.solvePace(from,o.tx,o.tz,lerp(34,58,o.pace||0.6),0.5); } else v=TS.solveArc(from,o.tx,o.tz,o.clear||1.5); Object.assign(ball,{x:from.x,y:from.y,z:from.z,vx:v.vx,vy:v.vy,vz:v.vz,live:true,bounces:0,shot:o.kind==='ret'?2:4,hitter:2,hitTeam:1,kind:o.kind,pace:o.pace||0.4,apex:from.y,crossY:-1,hist:[]}); av[2].swingT=now(); av[2].swingKind=o.kind; pop(o.kind,o.pace||0.4,0.5); designated=[-1,-1]; predict(); designated[0]=0; predict(); rallyLen=o.kind==='ret'?2:4; dinkRun=o.kind==='dink'?3:0; pending=null; av[0].hitDone=-1; myWindow={open:false}; frozen=false; }
let drill=null;
/* scenarios: a specific situation fed to you (the tutorial and the harness use these) */
function scenario(name){ if(state==='menu'||!score) startMatch({tier:match.tier,style:match.style,first:0}); stateNext=null; frozen=false; timeScale=1; slowmo=0; resetBall(); pending=null; shotsThisPoint=[]; lastHuman=null; calls={mine:0,yours:0}; highlight=null; av.forEach(a=>{ a.decided=null; a.hitDone=-1; a.erne=false; a.depthPref=null; a.pin=undefined; a.call=''; });
  av[0].homeX=5; av[1].homeX=-5; av[2].homeX=-5; av[3].homeX=5; const place=(...ds)=>ds.forEach((d,i)=>{ av[i].depth=d; av[i].x=av[i].homeX; av[i].z=zOf(d,SEATS[i].side); av[i].tx=av[i].x; av[i].tz=av[i].z; }); setState('play');
  switch(name){
    case 'third': place('base','base','kitchen','kitchen'); feedBall({x:-5,y:2.2,z:-21},{tx:4.5,tz:18.5,clear:2.4,kind:'ret'}); break;
    case 'dinkLow': place('kitchen','kitchen','kitchen','kitchen'); feedBall({x:-4,y:1.5,z:-8},{tx:4,tz:4.2,clear:0.8,kind:'dink'}); break;
    case 'dinkHigh': place('kitchen','kitchen','kitchen','kitchen'); feedBall({x:-4,y:1.6,z:-8},{tx:4.5,tz:12,clear:2.6,kind:'dink'}); break;
    case 'transition': place('trans','trans','kitchen','kitchen'); feedBall({x:-3,y:3.4,z:-8},{tx:5,tz:12.5,kind:'drive',pace:0.6}); break;
    case 'kitchenVolley': place('kitchen','kitchen','kitchen','kitchen'); av[0].pin=4.5; av[0].z=4.5; av[0].tz=4.5; feedBall({x:-4,y:2.6,z:-8},{tx:4.8,tz:11,clear:2.8,kind:'dink'}); break;
    case 'momentum': place('kitchen','kitchen','kitchen','kitchen'); av[0].pin=KZ+0.2; av[0].z=KZ+0.2; feedBall({x:-4,y:2.4,z:-8},{tx:4.8,tz:12,clear:3.2,kind:'dink'}); break;
    case 'erne': place('kitchen','kitchen','kitchen','kitchen'); feedBall({x:-6,y:1.5,z:-8},{tx:9.7,tz:4.5,clear:2.2,kind:'dink'}); break;
    case 'lob': place('kitchen','kitchen','kitchen','kitchen'); feedBall({x:-4,y:1.6,z:-8},{tx:3,tz:19,clear:9,kind:'lob'}); break;
    case 'atp': place('kitchen','kitchen','kitchen','kitchen'); feedBall({x:-6,y:1.4,z:-8},{tx:9.6,tz:4.0,clear:0.2,kind:'dink'}); break; } }
function startDrill(id){ clearTimeout(reportT); const D=DRILLS[id]; match.mode='drill'; match.drill=Object.assign({id},D); match.tutorial=false; match.daily=null; match.tier='club'; match.style='dinker'; rnd=RND; castOpponents(); S=stats(); score=TS.Score({to:99,mode:'rally',first:1}); drill={id,n:0,tries:0,best:0,run:0,lives:D.lives||0,done:false,t0:now()}; render_rebuild(); showScreen(null);
  $('oppTier').textContent='DRILL'; $('oppStyle').textContent=D.title.toLowerCase(); $('drill').hidden=false; $('drillL').textContent=D.label; $('drillN').textContent='0'; D.setup(); av.forEach(a=>{ a.x=a.homeX; a.z=zOf(a.depth,SEATS[a.seat].side); a.tx=a.x; a.tz=a.z; a.depthPref=null; }); setState('play'); word(D.title,[50,40],{color:'#e9ff7a',huge:true}); setTimeout(()=>coach(D.line,'info',true),300); stateNext={s:'drillNext',at:now()+1800}; }
function drillNext(){ if(!match.drill||drill.done) return; resetBall(); pending=null; shotsThisPoint=[]; av.forEach(a=>{ a.decided=null; a.hitDone=-1; a.erne=false; }); av[0].depthPref=null; setState('play'); match.drill.feed(); if(drill.id==='dink') drill.run=0; }
function drillScore(ok,txt){ if(!drill||drill.done) return; drill.tries++; if(ok){ drill.n++; word(txt,avScreen(0,2),{color:'#e9ff7a',big:true}); buzz(20); } else word(txt,avScreen(0,2),{color:'#ff8fb1'}); $('drillN').textContent=drill.n; const D=match.drill; if(D.goal&&drill.n>=D.goal){ drillDone(true); } }
function drillPoint(win,why,tag){ const D=match.drill; if(!drill||drill.done) return; if(drill.id==='dink'){ if(win===0){ drill.run=Math.max(drill.run,dinkRun); word('POINT',avScreen(0,2),{color:'#e9ff7a',big:true}); } else { drill.lives--; coach(lastHuman&&lastHuman.attackLow?'You attacked a low ball':'Keep it low and cross-court','warn',true); } drill.best=Math.max(drill.best,S.curDink||0); drill.n=drill.best; $('drillN').textContent=drill.n; if(drill.lives<=0){ drillDone(true); return; } }
  else if(drill.id==='putaway'){ if(win===0&&tag==='putaway') drillScore(1,'PUT-AWAY!'); else if(win===1&&lastHuman&&lastHuman.attackLow) drillScore(0,'below the net'); else if(win===1) drillScore(0,'missed'); }
  else if((drill.id==='drop'||drill.id==='reset')&&win===1&&why!=='double'&&lastShot&&lastShot.seat===0){ drillScore(0,why==='net'?'net':'miss'); }
  if(drill.done) return; setState('point'); stateNext={s:'drillNext',at:now()+1300}; if(drill.tries>=(D.goal?D.goal*3:999)) drillDone(false); }
let reportT=0; function drillDone(){ if(!drill||drill.done) return; drill.done=true; stateNext=null; setState('over'); resetBall(); const secs=Math.round((now()-drill.t0)/1000); drill.secs=secs; const won=drill.id==='dink'?drill.n>=6:drill.n>=match.drill.goal; if(won){ crowdRoar(true); render_win(); } clearTimeout(reportT); reportT=setTimeout(()=>showReport(),1400); }
/* the tutorial: three cards, each at the moment it matters */
