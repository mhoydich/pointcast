let frozen=false; let designated=[-1,-1]; let intercept={valid:false}; let myWindow={open:false,arrive:0,t0:0,y:0,attackable:false,shot:0}; let pending=null; let calls={mine:0,yours:0}; let timeScale=1, slowmo=0;
let autoServeT=0, lastPoint={team:-1,why:'',tag:''}, pointsPlayed=0, camKick=0, flare=0, highlight=null; let paused=false, tutHold=false;
const stats=()=>({thirdDrops:0,thirdDropsIn:0,thirdDrives:0,dinks:0,dinkRuns:[],attacksLow:0,attacksHigh:0,attackLowErrors:0,attacksHighWon:0,kitchenPointsWon:0,pointsWon:0,pointsLost:0,unforced:0,transitionCaught:0,resets:0,resetsIn:0,erne:0,atp:0,putaways:0,longest:0,hits:0,lobs:0,serves:0,serveFaults:0});
