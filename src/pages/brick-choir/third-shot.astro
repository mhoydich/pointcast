<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --lime:#e9ff7a; --peach:#ffb38a; --lav:#b9a8ff;
