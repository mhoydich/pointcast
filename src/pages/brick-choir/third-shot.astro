const mtof=m=>440*Math.pow(2,(m-69)/12);
function tone(m,{t,kind='bell',vel=0.8,len=0.15,pan=0,bus}={}){
  if(!ctx||muted) return; try{
  t=Math.max(t||0,ctx.currentTime); const f=mtof(m); const g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=Math.max(-0.9,Math.min(0.9,pan));
  const nodes=[]; let pk=0.2, rel=0.5, atk=0.004;
