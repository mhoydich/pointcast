  #splash.off{opacity:0;pointer-events:none;}
  #splash .in{text-align:center;} #splash .ball{width:54px;height:54px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#f4ff9a,#c9d84a 60%,#8a9a2a);margin:0 auto 16px;box-shadow:0 10px 30px rgba(233,255,122,.35);animation:bounce 1s cubic-bezier(.3,0,.7,1) infinite alternate;position:relative;}
  #splash .ball::after{content:"";position:absolute;inset:14px;border-radius:50%;background:radial-gradient(circle,rgba(0,0,0,.25) 2px,transparent 3px) 0 0/9px 9px;}
  @keyframes bounce{from{transform:translateY(-18px) scale(1);}to{transform:translateY(0) scale(1.06,.94);}}
  #splash small{display:block;font:600 11px var(--mono);letter-spacing:.3em;color:var(--gold);margin-top:10px;}
  .logo{display:flex;justify-content:center;font:800 clamp(34px,11vw,48px)/1 var(--display);letter-spacing:-.02em;}
  .logo span{background:linear-gradient(180deg,oklch(92% .1 var(--h)),oklch(74% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;} .logo i{width:.28em;}
  /* ---- screens (menu, maker, report, drills) ---- */
  .screen{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;gap:12px;padding:calc(12px + var(--sat)) calc(16px + var(--sar)) calc(16px + var(--sab)) calc(16px + var(--sal));box-sizing:border-box;background:rgba(11,10,26,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow:hidden;animation:pop .32s cubic-bezier(.2,.9,.3,1.15);}
  .screen.clear{background:linear-gradient(180deg,rgba(11,10,26,.86),rgba(11,10,26,.55) 40%,rgba(11,10,26,.86));}
  .screen .scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;display:flex;flex-direction:column;gap:12px;padding-bottom:calc(var(--bar) - var(--sab));}
  @keyframes pop{from{opacity:0;transform:scale(.98) translateY(8px);}}
