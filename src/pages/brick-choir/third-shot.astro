  .opts{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;flex:none;min-height:72px;align-items:center;padding:2px;touch-action:pan-x;} .opts::-webkit-scrollbar{display:none;}
  .opts button{flex:none;width:64px;height:64px;border-radius:16px;background:rgba(255,255,255,.07);border:2px solid rgba(255,255,255,.1);display:grid;place-items:center;overflow:hidden;position:relative;} .opts button.on{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 16px rgba(255,210,122,.35);}
  .opts button canvas{width:64px;height:64px;display:block;} .opts button .sw{width:38px;height:38px;border-radius:50%;background:var(--s);box-shadow:inset 0 -4px 0 rgba(0,0,0,.18),0 2px 6px rgba(0,0,0,.3);} .opts button small{position:absolute;left:0;right:0;bottom:3px;font:700 8px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.6);text-align:center;text-transform:uppercase;}
