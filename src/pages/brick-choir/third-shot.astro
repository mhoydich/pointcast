  else if(kind==='pluck'){ const o=O('sawtooth',f), o2=O('square',f*1.004), lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.Q.value=4; lp.frequency.setValueAtTime(400+5200*vel,t); lp.frequency.exponentialRampToValueAtTime(260,t+0.22); const g2=ctx.createGain(); g2.gain.value=0.4; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); pk=0.2; rel=0.25; }
  else if(kind==='keys'){ const o=O('sine',f), md=O('sine',f), mg=ctx.createGain(); mg.gain.setValueAtTime(f*1.6*vel,t); mg.gain.exponentialRampToValueAtTime(f*0.08,t+0.35); md.connect(mg); mg.connect(o.frequency); const o2=O('sine',f*2); const g2=ctx.createGain(); g2.gain.setValueAtTime(0.18,t); g2.gain.exponentialRampToValueAtTime(0.01,t+0.3); o.connect(g); o2.connect(g2); g2.connect(g); pk=0.24; rel=0.75; atk=0.003; }
  else if(kind==='marimba'){ const o=O('sine',f), o2=O('sine',f*4), o3=O('triangle',f*0.5); const g2=ctx.createGain(); g2.gain.setValueAtTime(0.35,t); g2.gain.exponentialRampToValueAtTime(0.001,t+0.08); const g3=ctx.createGain(); g3.gain.value=0.15; o.connect(g); o2.connect(g2); g2.connect(g); o3.connect(g3); g3.connect(g); pk=0.3; rel=0.32; atk=0.002; }
  else if(kind==='lead'){ const o=O('triangle',f), o2=O('square',f*2), vib=O('sine',5.5), vg=ctx.createGain(), lp=ctx.createBiquadFilter(); vg.gain.value=f*0.006; vib.connect(vg); vg.connect(o.frequency); lp.type='lowpass'; lp.frequency.value=3200; const g2=ctx.createGain(); g2.gain.value=0.12; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); pk=0.28; rel=0.5; atk=0.01; }
  else if(kind==='bass'){ const o=O('sine',f), o2=O('sawtooth',f), lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.setValueAtTime(900,t); lp.frequency.exponentialRampToValueAtTime(180,t+len); const g2=ctx.createGain(); g2.gain.value=0.25; o.connect(g); o2.connect(g2); g2.connect(lp); lp.connect(g); pk=0.34; rel=0.12; }
