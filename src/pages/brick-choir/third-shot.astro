function tutCard(k,h,p,s,arrow){ $('tutK').textContent=k; $('tutH').textContent=h; $('tutP').innerHTML=p; $('tutS').textContent=s; $('tutArrow').setAttribute('d',arrow); [...document.querySelectorAll('#tut .dots i')].forEach((d,i)=>d.classList.toggle('on',i<tut.step)); $('tut').hidden=false; tutHold=true; }
$('tutGo').onclick=()=>{ $('tut').hidden=true; tutHold=false; lastT=now(); buzz(8); if(tut.step===3){ settings.tutDone=true; saveSettings(); } };
function tutorialStep(where){ if(where==='serve'&&!tut.shown.serve&&score.server===0){ tut.shown.serve=true; tut.step=1; tutCard('FEEL THE SWIPE · 1 OF 3','Serve it underhand','Swipe <b>up</b> from your Buddy. Direction aims, length is depth — into the diagonal box.','one finger · start anywhere in the lower half','M27 46 V14'); } }
function tutorialWindow(){ if(myWindow.shot===3&&!tut.shown.third&&myWindow.zone!=='kitchen'){ tut.shown.third=true; tut.step=2; tutCard('THE HEART OF THE GAME · 2 OF 3','The third-shot drop','They are at the line and you are back. A <b>short, soft flick</b> drops it into their kitchen, then you move up. A long fast swipe drives it — and they volley it at your feet.','short + slow = drop · the preview shows where it lands','M27 40 V22'); return; }
  if(myWindow.zone==='kitchen'&&!tut.shown.line&&dinkRun>=1){ tut.shown.line=true; tut.step=3; tutCard('AT THE LINE · 3 OF 3','Below the net: dink. Above: attack.','Watch the <b>net-height line</b> and the ball’s shadow. Low ball → a soft flick (dink), cross-court is safest. When the ball <b>glows</b>, a quick jab puts it away. Small reverse flick = reset.','tap a zone to move · hold your Buddy to call MINE','M27 42 V18'); } }
function tutorialShot(L){ if(match.tutorial&&tut.step>=3&&L.kind==='putaway'&&!tut.shown.done){ tut.shown.done=true; setTimeout(()=>{ coach('That’s the game. Play a match!','good',true); },800); } }

/* ================= the report, the score post, the share card ================= */
function arcadeScore(){ const iq=TS.strategyIQ(S); const pts=score?score.score[0]:0; const win=score&&score.winner===0; let base=pts*100+iq.score*10+S.longest*15+S.putaways*40+S.erne*150+S.atp*150; if(match.drill){ base=drill.n*120+Math.max(0,300-(drill.secs||0))+(drill.id==='dink'?drill.best*60:0); } const tierMul={park:0.8,club:1,pro:1.3}[match.tier]||1; return Math.round(base*tierMul*(win?2:1)); }
let hiLocal=store.get('bc3:scores',[]), hiGlobal=null, posted=false;
function showReport(){ const iq=TS.strategyIQ(S); const won=match.drill?(drill.id==='dink'?drill.n>=6:drill.n>=match.drill.goal):(score&&score.winner===0); posted=false;
  $('rpTitle').firstChild.textContent=match.drill?(won?'DRILL COMPLETE':'DRILL OVER'):(won?'YOU WON':'THEY TOOK IT'); $('rpSub').textContent=match.drill?`${match.drill.title} · ${drill.n}${match.drill.goal?' / '+match.drill.goal:' IN A ROW'} · ${drill.secs}s`:`${C.TIERS[match.tier].name} ${match.style.toUpperCase()}S · ${score.score[0]}–${score.score[1]}${match.daily?' · DAILY':''}`;
  $('rpGrade').textContent=iq.grade; $('rpTipT').textContent=iq.tip[0]; $('rpTip').textContent=iq.tip[1];
