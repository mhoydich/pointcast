$('rpShare').onclick=()=>{ $('shareImg').src=shareCard().toDataURL('image/png'); showScreen('sShare'); }; $('shDo').onclick=()=>doShare(); $('shBack').onclick=()=>showScreen('sReport');
/* the maker */
const TABS=[['sk','SKIN'],['hs','HAIR'],['hc','HAIR COLOUR'],['ey','EYES'],['br','BROWS'],['gl','GLASSES'],['fh','FACE'],['ht','HAT'],['sh','SHIRT'],['pd','PADDLE'],['bd','BODY'],['sm','SMILE']]; const COLOURS={sk:BK.SKIN,hc:BK.HAIRC,sh:BK.SHIRT,pd:BK.PADDLE}; const LABELS={hs:BK.HAIR,ey:BK.EYES,br:BK.BROWS,gl:BK.GLASSES,fh:BK.FACIAL,ht:BK.HAT,bd:BK.BODY,sm:BK.SMILE};
let tab='sk', mkT=0, mkWave=0, mkLast=0, buddy=null; const mkCv=$('mkCanvas'), mkX=mkCv.getContext('2d');
function mkFrame(ts){ requestAnimationFrame(mkFrame); if($('sMaker').hidden||!buddy) return; const dt=Math.min(0.05,(ts-mkLast)/1000||0); mkLast=ts; mkT+=dt; mkWave=Math.max(0,mkWave-dt/1.6); const W=mkCv.width, H=mkCv.height; mkX.clearRect(0,0,W,H); const wave=mkWave>0?1:(Math.sin(mkT*0.7)>0.85?1:0); BK.draw(mkX,buddy,{cx:W/2,cy:H*0.965,u:H/8.3,t:mkT,wave,bounce:1}); } requestAnimationFrame(mkFrame);
function openMaker(){ buddy=Object.assign({},players[0].b); $('mkName').value=players[0].name==='YOU'?'':players[0].name; mkTabs(); mkOpts(); mkCodeUI(); showScreen('sMaker'); }
function mkTabs(){ const el=$('mkTabs'); if(!el.children.length) el.innerHTML=TABS.map(([k,l])=>`<button data-k="${k}">${l}</button>`).join(''); [...el.children].forEach(b=>{ b.classList.toggle('on',b.dataset.k===tab); b.onclick=()=>{ tab=b.dataset.k; mkTabs(); mkOpts(); buzz(6); }; }); const on=el.querySelector('.on'); if(on) on.scrollIntoView({inline:'center',block:'nearest'}); }
function mkOpts(){ const el=$('mkOpts'); el.innerHTML=''; const n=BK.FIELDS.find(f=>f[0]===tab)[1]; for(let i=0;i<n;i++){ const b=document.createElement('button'); b.type='button'; b.classList.toggle('on',buddy[tab]===i); if(COLOURS[tab]) b.innerHTML=`<span class="sw" style="--s:${COLOURS[tab][i]}"></span>`; else if(i===0&&/^(hs|gl|fh|ht)$/.test(tab)){ b.className+=' none'; b.textContent='—'; } else { const c=document.createElement('canvas'); c.width=c.height=128; const bb=Object.assign({},buddy,{[tab]:i}); const x=c.getContext('2d'); if(tab!=='bd') BK.draw(x,bb,{cx:64,cy:170,u:24,t:0,bounce:0,paddle:false}); else BK.draw(x,bb,{cx:64,cy:122,u:17,t:0,bounce:0}); b.appendChild(c); const s=document.createElement('small'); s.textContent=LABELS[tab][i]; b.appendChild(s); }
    b.onclick=()=>{ buddy[tab]=i; mkOpts(); mkWave=tab==='pd'||tab==='sh'?0:1.4; buzz(8); mkCodeUI(); }; el.appendChild(b); } const on=el.querySelector('.on'); if(on) on.scrollIntoView({inline:'center',block:'nearest'}); }
function mkCodeUI(){ $('mkCode').textContent='BUDDY '+BK.pretty(BK.pack(buddy)); }
$('mkRandom').onclick=()=>{ buddy=BK.random(); mkOpts(); mkCodeUI(); mkWave=1.5; buzz([10,30,10]); }; $('mkBack').onclick=()=>showScreen('sMenu');
$('mkGo').onclick=()=>{ players[0].b=buddy; players[0].code=BK.pack(buddy); players[0].fresh=false; const nm=($('mkName').value||'').toUpperCase().replace(/[^A-Z0-9 ]/g,'').trim().slice(0,8); players[0].name=nm||'YOU'; store.set('bcp:buddy',players[0].code); if(nm) store.set('bcp:name',nm); render_rebuild(); showScreen('sMenu'); buzz(12); };

/* ================= boot ================= */
loadMe(); castOpponents(); render_rebuild(); muted=!settings.sound; av.forEach(a=>{ a.x=a.homeX; a.z=SEATS[a.seat].side*(a.seat%2?KZ+2:19); a.tx=a.x; a.tz=a.z; });
if(TESTMODE) window.__third={TS,BK,get state(){return state;},get score(){return score;},get ball(){return ball;},get av(){return av;},get players(){return players;},get match(){return match;},get stats(){return S;},get lastShot(){return lastShot;},get lastGesture(){return lastGesture;},get lastPoint(){return lastPoint;},get window(){return myWindow;},get intercept(){return intercept;},get designated(){return designated;},get pending(){return pending;},get fps(){return FPS.slice();},get timeScale(){return timeScale;},get rally(){return rallyLen;},get dinkRun(){return dinkRun;},get drill(){return drill;},get chant(){return chantState;},get tut(){return tut;},get settings(){return settings;},get pointsPlayed(){return pointsPlayed;},get shots(){return shotsThisPoint;},get calls(){return calls;},get highlight(){return highlight;},get hiGlobal(){return hiGlobal;},get dpr(){return DPR;},get autopilot(){return autopilot;},set autopilot(v){ autopilot=!!v; },get calls3(){return renderer.info.render.calls;},
  startMatch,startDrill,startDaily,tutorialStart,scenario,drillDone,set paused(v){ paused=v; lastT=now(); },get paused(){ return paused; },showReport,showScreen,humanSwing,serve,feedBall,setState,pointOver,arcadeScore,shareCard,dailyInfo,strategyIQ:()=>TS.strategyIQ(S),
  setFreeze:v=>{ window.__freeze=v; },setRnd:seed=>{ rnd=TS.rng(seed); },forceBall:o=>{ Object.assign(ball,o); ball.live=true; designated=[-1,-1]; av.forEach(a=>{ a.decided=null; a.hitDone=-1; }); predict(); assignHitter(); predict(); },setDepth:(seat,d)=>{ av[seat].depth=d; av[seat].x=av[seat].homeX; av[seat].z=zOf(d,SEATS[seat].side); av[seat].tx=av[seat].x; av[seat].tz=av[seat].z; },
  aiStyle:s=>{ match.style=s; },tier:t=>{ match.tier=t; },get renderer(){return renderer;},camera,scene,toScreen,avScreen,coachSeen,set S(v){ S=v; },beginPoint,resetStats:()=>{ S=stats(); }};
$('splash').classList.add('off'); setTimeout(()=>{ $('splash').remove(); },700); if(ATTRACT){ document.body.classList.add('attract'); showScreen(null); startMatch({tier:'club'}); $('right').hidden=true; } else showScreen('sMenu'); requestAnimationFrame(frame);
</script>
