  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.22*vel,t+0.05); g.gain.setValueAtTime(0.22*vel,t+len-0.06); g.gain.exponentialRampToValueAtTime(0.0001,t+len+0.15); g.connect(sfx); g.connect(wet); }catch(e){} }
let chantState={on:false,until:0,text:''};
function chant(nums){ chantState={on:true,until:now()+nums.length*520+400,text:nums.join('–')}; if(!ctx||muted) return; let t=ctx.currentTime+0.05; const spb=60/COURT.bpm; const contour=[[0,0],[2,1],[4,0],[-3,2]];
