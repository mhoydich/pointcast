  /* ---- the maker (ported from Pickle Park's phone) ---- */
  .maker .top{display:flex;justify-content:space-between;align-items:center;gap:8px;} .maker .top .rnd{margin-left:auto;font:800 12px var(--mono);letter-spacing:.12em;color:#140f28;background:var(--mint);border-radius:999px;padding:9px 12px;}
  .maker .top .back{font:700 12px var(--mono);letter-spacing:.1em;color:var(--sky);padding:9px 0;}
  .maker .stage{position:relative;flex:1;min-height:150px;border-radius:22px;background:radial-gradient(80% 70% at 50% 30%,#8fc7ff,#5c8ddb 45%,#f7b98c 46%,#ffd9a0 70%,#7aa45f 71%,#5f8a48);overflow:hidden;box-shadow:inset 0 -30px 60px rgba(0,0,0,.25);}
  .maker .stage canvas{position:absolute;inset:0;width:100%;height:100%;}
  .maker .stage .code{position:absolute;left:10px;bottom:8px;font:700 10px var(--mono);letter-spacing:.1em;color:rgba(20,15,40,.7);background:rgba(255,255,255,.55);padding:4px 8px;border-radius:999px;}
  .maker .name{display:flex;gap:8px;align-items:center;} .maker .name input{flex:1;font:800 18px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--ink);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:12px 14px;min-width:0;outline:0;-webkit-user-select:text;user-select:text;} .maker .name input:focus{border-color:var(--gold);}
  .tabs{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;flex:none;touch-action:pan-x;} .tabs::-webkit-scrollbar{display:none;}
