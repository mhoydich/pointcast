    --bar:90px; /* the iOS browser bar: nothing important lives in the bottom 90 px */ }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;overscroll-behavior:none;-webkit-text-size-adjust:100%;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;position:fixed;inset:0;}
