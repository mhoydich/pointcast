/* the chant: sung vowels through two formants on a sing-song contour in the key — "four … two … one!" */
const SYL={0:['zee','ro'],1:['one'],2:['two'],3:['three'],4:['four'],5:['five'],6:['six'],7:['sev','en'],8:['eight'],9:['nine'],10:['ten'],11:['e','lev','en'],12:['twelve'],13:['thir','teen'],14:['four','teen'],15:['fif','teen'],16:['six','teen'],17:['sev','en','teen'],18:['eigh','teen'],19:['nine','teen'],20:['twen','ty']};
