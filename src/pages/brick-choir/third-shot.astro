  #coach{position:absolute;left:50%;top:calc(76px + var(--sat));transform:translateX(-50%);max-width:86vw;box-sizing:border-box;font:800 15px/1.2 var(--display);color:#140f28;background:var(--gold);border-radius:14px;padding:10px 14px;box-shadow:0 10px 30px rgba(0,0,0,.35);text-align:center;opacity:0;transition:opacity .25s,transform .25s;}
  #coach.on{opacity:1;transform:translateX(-50%) translateY(0);} #coach.warn{background:var(--pink);} #coach.good{background:var(--mint);} #coach.info{background:var(--sky);}
