  const R=n=>Math.floor(Math.random()*n);
  function random(seed){ // seed: an optional palette index for the shirt (the hub colour)
    const b={}; FIELDS.forEach(([k,n])=>b[k]=R(n));
    b.gl=Math.random()<0.6?0:1+R(4); b.fh=Math.random()<0.7?0:1+R(4); b.ht=Math.random()<0.65?0:1+R(5); b.hs=Math.random()<0.08?0:1+R(9); b.sm=Math.random()<0.7?R(2):2+R(2); b.ey=Math.random()<0.5?R(2):2+R(4);
