  #shot{position:absolute;left:50%;bottom:calc(var(--bar) + 6px + var(--sab));transform:translateX(-50%);font:800 12px var(--mono);letter-spacing:.24em;color:var(--ink);background:rgba(24,18,44,.75);border-radius:999px;padding:7px 14px;opacity:0;transition:opacity .2s;} #shot.on{opacity:1;}
  #words{position:absolute;inset:0;overflow:hidden;} .word{position:absolute;transform:translate(-50%,-50%);font:800 18px var(--display);letter-spacing:.02em;text-shadow:0 2px 12px rgba(0,0,0,.6);white-space:nowrap;pointer-events:none;} .word.big{font-size:26px;} .word.huge{font-size:40px;letter-spacing:-.01em;}
  #names{position:absolute;inset:0;} .nm{position:absolute;transform:translate(-50%,-100%);font:800 11px var(--mono);letter-spacing:.12em;color:#fff;background:rgba(24,18,44,.7);padding:3px 8px;border-radius:999px;white-space:nowrap;border:1px solid var(--c,rgba(255,255,255,.2));} .nm.me{background:var(--gold);color:#140f28;border-color:var(--gold);} .nm.hold{background:var(--pink);color:#140f28;}
  #pulse{position:fixed;inset:0;z-index:5;pointer-events:none;background:rgba(255,255,255,0);transition:background .06s;} #pulse.on{background:rgba(255,255,255,.14);transition:none;}
  #drill{position:absolute;left:50%;top:calc(76px + var(--sat));transform:translateX(-50%);display:flex;gap:8px;align-items:center;}
  #drill b{font:800 26px/1 var(--mono);color:var(--lime);} #drill span{font:700 10px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.6);}
  #hint{position:absolute;left:50%;bottom:calc(var(--bar) + 44px + var(--sab));transform:translateX(-50%);font:600 12px var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.7);text-align:center;white-space:nowrap;opacity:0;transition:opacity .3s;} #hint.on{opacity:1;}
  #zones{position:absolute;inset:0;} #zones i{position:absolute;left:50%;transform:translateX(-50%);font:700 9px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.35);opacity:0;transition:opacity .3s;} #zones.on i{opacity:1;} #zones i.on{color:var(--gold);}
  /* ---- tutorial cards ---- */
  #tut{position:fixed;left:16px;right:16px;bottom:calc(var(--bar) + 16px + var(--sab));z-index:22;background:rgba(24,18,44,.94);border:1px solid rgba(255,255,255,.18);border-radius:22px;padding:16px 16px 14px;box-shadow:0 20px 60px rgba(0,0,0,.5);animation:pop .3s cubic-bezier(.2,.9,.3,1.15);}
  #tut .k{font:800 9px var(--mono);letter-spacing:.3em;color:var(--gold);} #tut h2{margin:4px 0 6px;font:800 22px/1.1 var(--display);letter-spacing:-.01em;} #tut p{margin:0;font:500 14px/1.45 var(--display);color:rgba(244,240,255,.8);} #tut p b{color:var(--lime);}
  #tut .g{display:flex;gap:10px;margin:12px 0 0;align-items:center;} #tut .g svg{flex:none;} #tut .g span{font:600 11px/1.35 var(--mono);color:rgba(244,240,255,.6);letter-spacing:.04em;}
  #tut button{margin-top:12px;width:100%;font:800 14px var(--display);letter-spacing:.06em;color:#140f28;background:var(--gold);border-radius:14px;padding:14px;}
  #tut .dots{position:absolute;right:16px;top:16px;display:flex;gap:5px;} #tut .dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.25);} #tut .dots i.on{background:var(--gold);}
  /* ---- report ---- */
  .report h1{margin:0;text-align:center;font:800 26px/1 var(--display);letter-spacing:-.01em;} .report h1 small{display:block;font:700 10px var(--mono);letter-spacing:.3em;color:var(--gold);margin-top:6px;}
  .grade{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:12px 14px;}
  .grade .g{font:800 54px/1 var(--display);color:var(--gold);min-width:80px;text-align:center;text-shadow:0 0 30px rgba(255,210,122,.4);} .grade .g small{display:block;font:700 9px var(--mono);letter-spacing:.24em;color:rgba(244,240,255,.5);margin-top:4px;}
  .grade .t b{display:block;font:800 15px var(--display);} .grade .t span{display:block;font:500 12.5px/1.35 var(--display);color:rgba(244,240,255,.72);margin-top:3px;}
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;} .stats div{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:10px 12px;} .stats b{display:block;font:800 22px/1 var(--mono);color:var(--ink);} .stats span{display:block;font:600 9px var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.5);margin-top:4px;text-transform:uppercase;} .stats div.hi b{color:var(--mint);} .stats div.lo b{color:var(--pink);}
  .initials{display:flex;gap:8px;align-items:center;} .initials input{flex:1;font:800 24px var(--mono);letter-spacing:.4em;text-transform:uppercase;text-align:center;color:var(--gold);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:12px;min-width:0;outline:0;-webkit-user-select:text;user-select:text;} .initials button{font:800 12px var(--mono);letter-spacing:.14em;color:#140f28;background:var(--gold);border-radius:14px;padding:16px 14px;}
  .board{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;} .board li{display:flex;gap:10px;align-items:center;font:700 12px var(--mono);letter-spacing:.08em;background:rgba(255,255,255,.04);border-radius:10px;padding:7px 10px;} .board li em{font-style:normal;color:rgba(244,240,255,.45);width:28px;} .board li b{color:var(--gold);} .board li span{margin-left:auto;font-variant-numeric:tabular-nums;} .board li.me{outline:1px solid var(--mint);}
  #shareImg{width:100%;border-radius:14px;display:block;box-shadow:0 10px 30px rgba(0,0,0,.4);}
  /* ---- rotate card ---- */
  #rotate{position:fixed;inset:0;z-index:50;display:none;place-items:center;background:var(--bg);text-align:center;padding:24px;box-sizing:border-box;}
  #rotate .ph{width:34px;height:60px;border:3px solid var(--gold);border-radius:8px;margin:0 auto 16px;animation:rot 1.6s ease-in-out infinite alternate;} @keyframes rot{from{transform:rotate(90deg);}to{transform:rotate(0);}}
  #rotate h2{margin:0;font:800 24px var(--display);} #rotate p{font:500 14px var(--display);color:rgba(244,240,255,.7);}
