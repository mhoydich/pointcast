  .daily .fl{font:800 30px/1 var(--mono);color:var(--pink);min-width:44px;text-align:center;} .daily .fl small{display:block;font:700 8px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.5);margin-top:3px;}
