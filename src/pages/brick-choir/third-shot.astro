  .lead{margin:0;text-align:center;font:500 14px/1.4 var(--display);color:rgba(244,240,255,.78);} .lead b{color:var(--ink);}
  .who{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:10px 12px;}
