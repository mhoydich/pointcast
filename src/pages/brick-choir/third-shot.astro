let crowdG=null, crowdLvl=0; function crowdStart(){ if(!ctx||crowdG) return; try{ const n=ctx.createBufferSource(); const len=ctx.sampleRate*3; const b=ctx.createBuffer(2,len,ctx.sampleRate); for(let c=0;c<2;c++){ const d=b.getChannelData(c); let v=0; for(let i=0;i<len;i++){ v=v*0.92+(Math.random()*2-1)*0.08; d[i]=v*(0.7+0.3*Math.sin(i/ctx.sampleRate*0.7+c)); } } n.buffer=b; n.loop=true; const bf=ctx.createBiquadFilter(); bf.type='bandpass'; bf.frequency.value=520; bf.Q.value=0.5; crowdG=ctx.createGain(); crowdG.gain.value=0; n.connect(bf); bf.connect(crowdG); crowdG.connect(sfx); n.start(); }catch(e){} }
