function bots(){
  const T=now(); const spb=60/((lvl&&lvl.bpm)||104); const tg=targets[tIdx];
  players.forEach(p=>{ if(p.human||T<p.botT) return; const s=SEATS[p.seat]; const myTurn=tg&&tg.face===p.seat&&tg.born<=T;
    p.botT=T+spb*1000*(myTurn?1:0.75+Math.random()*1.25);
    const land=balls.find(b=>b.landing&&b.landSeat===p.seat&&T-b.landT>180); if(land&&Math.random()<0.8){ const sl=s.slots.reduce((a,x)=>angDiff(angOf(land.x,land.z),x.ang)<angDiff(angOf(land.x,land.z),a.ang)?x:a); fire(sl.code,{bot:true}); return; }
    const mine=balls.filter(b=>b.owner===p.seat&&!b.landing).length; if(mine>=(myTurn?MAXB:2)) return; if(!myTurn&&Math.random()<0.3) return;
    if(state==='play'&&!myTurn&&Math.random()<0.08){ drumPad(p.seat,['kick','snare','clap','rim'][Math.floor(Math.random()*4)]); return; }
    const outer={}; cells.forEach(c=>{ if(c.hp>0&&c.hp!==Infinity&&c.born<=T&&c.face===p.seat){ if(!outer[c.pos]||c.ring<outer[c.pos].ring) outer[c.pos]=c; } });
    let pool=Object.values(outer); if(!pool.length) pool=cells.filter(c=>c.hp>0&&c.hp!==Infinity&&c.born<=T); if(!pool.length) return;
    let aim=(myTurn&&Math.random()<0.92)?tg:pool[Math.floor(Math.random()*pool.length)];
    const [wx,wz]=toWorld(aim.u,aim.v); const want=lateral(s,wx,wz)/CELL*8/(N-1); const useInner=Math.random()<0.6; const rowSlots=myTurn?s.slots:s.slots.filter(sl=>sl.inner===useInner);
    const sl=rowSlots.reduce((a,x)=>Math.abs(x.aimLat-want)<Math.abs(a.aimLat-want)?x:a);
    fire(sl.code,{bot:true});
  });
  if(state==='attract'&&breakable()===0) loadLevel((lvlI+1)%LEVELS.length,{build:true});
}

