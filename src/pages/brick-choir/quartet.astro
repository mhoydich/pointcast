<script type="module" is:inline>
import * as THREE from 'three';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
window.__quartetBooted=true;

/* ================= the songbook (rounds by the Architects, rebuilt as ziggurats) ================= */
const LEVELS=[
 {id:'terra-01',architect:'Terra',title:'First Ramp',line:'A small opening is enough for the ceiling to begin answering.',scale:'majpent',root:0,bpm:88,speed:0.85,n:9,rings:[1,2,2],chords:3,stone:0},
 {id:'terra-02',architect:'Terra',title:'Span of Rain',line:'Cross the span; leave the open air singing beneath you.',scale:'minpent',root:9,bpm:96,speed:0.93,n:9,rings:[1,2,3],chords:3,stone:0},
 {id:'terra-03',architect:'Terra',title:'Tiled Thunder',line:'Every other note waits for the one that follows.',scale:'hirajoshi',root:2,bpm:104,speed:1.01,n:9,rings:[2,2,3],chords:4,stone:0},
 {id:'sonnet-verse',architect:'Sonnet',title:'Shine',line:'Break the noise until only SHINE remains.',scale:'lydian',root:0,bpm:108,speed:1.0,n:9,rings:[2,3,3],chords:4,stone:0},
 {id:'terra-04',architect:'Terra',title:'V of Light',line:'The two arms meet where a single bright note can turn.',scale:'dorian',root:5,bpm:112,speed:1.1,n:11,rings:[1,2,2,3],chords:5,stone:4},
 {id:'terra-05',architect:'Terra',title:'Stone Organ',line:'Three columns hold their notes until the air learns where to pass.',scale:'lydian',root:7,bpm:124,speed:1.2,n:11,rings:[2,2,3,3],chords:5,stone:8},
 {id:'terra-06',architect:'Terra',title:'Glass Cathedral',line:'Find the narrow panes; the old stones will not yield.',scale:'whole',root:11,bpm:136,speed:1.3,n:11,rings:[2,3,3,3],chords:6,stone:8},
 {id:'astra-spell',architect:'Astra',title:'The Spell',line:'By glass and choir, let stone remember fire.',scale:'hirajoshi',root:2,bpm:104,speed:0.9,n:9,rings:[2,3,3],chords:6,stone:0,phrase:[0,2,3,5,3,0,2,3,4,3,2,3,5,6,5,4,3,2,1,0]},
];
const LINES=["Four sparks drop down through silent air","Each finds the corner where its voice was stacked","A monument of hush stands in the round","Light knocks from every side, and one wall cracks","The balls cross over, corner into corner","Wake low notes first, then higher, brighter tones","The hollow heart is waiting to be rung","Glass turns to chime, and stone gives way to bells","Four hands at once — the quartet sings","Until the whole keyboard hums a single word"];
const MODELS={Terra:'GPT-5.6 Terra',Sonnet:'Claude Sonnet',Astra:'GPT-6 Astra'};
const SCALES={majpent:{steps:[0,2,4,7,9],ro:2},minpent:{steps:[0,3,5,7,10],ro:2},hirajoshi:{steps:[0,2,3,7,8],ro:2},dorian:{steps:[0,2,3,5,7,9,10],ro:3},lydian:{steps:[0,2,4,5,7,9,11],ro:3},whole:{steps:[0,2,4,6,8,10],ro:3}};
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const hue=m=>((m%12)*30+300)%360;
const cssCol=(m,l=78,c=0.13,a=1)=>`oklch(${l}% ${c} ${hue(m)} / ${a})`;
function oklch(L,C,h){ const a=C*Math.cos(h*Math.PI/180), b=C*Math.sin(h*Math.PI/180);
  const l_=L+0.3963377774*a+0.2158037573*b, m_=L-0.1055613458*a-0.0638541728*b, s_=L-0.0894841775*a-1.2914855480*b; const l=l_**3,m=m_**3,s=s_**3;
  return [4.0767416621*l-3.3077115913*m+0.2309699292*s,-1.2684380046*l+2.6097574011*m-0.3413193965*s,-0.0041960863*l-0.7034186147*m+1.7076147010*s].map(v=>Math.max(0,Math.min(1,v))); }
const pitchColor=(m,L=0.8,C=0.14)=>{ const [r,g,b]=oklch(L,C,hue(m)); return new THREE.Color().setRGB(r,g,b); };

/* ================= seats: four corners of one keyboard ================= */
// The keyboard is a map of the screen: upper-left keys are the top-left corner, lower-right keys the bottom-right.
// Four parts of one arrangement: P1 plays BASS, P2 plays KEYS (chords), P3 plays LEAD, P4 plays BELLS.
// The modifier keys around each corner are that seat's drum pads (space, shifts, tab, enter, arrows…).
const SEATS=[
