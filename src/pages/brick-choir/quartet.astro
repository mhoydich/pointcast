<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;}
  canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;display:block;}
  .chrome{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:12px;display:flex;gap:8px;z-index:20;}
  .chrome button,.chrome a{font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(244,240,255,.7);background:rgba(20,18,40,.7);
    border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px 11px;cursor:pointer;text-decoration:none;}
  .chrome button:hover,.chrome a:hover{color:#fff;border-color:rgba(255,255,255,.3);}
  .chrome button:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}

  /* ---- HUD ---- */
  #hud{position:fixed;inset:0;pointer-events:none;z-index:5;will-change:transform;}
  .card{position:absolute;min-width:168px;padding:8px 12px 9px;border-radius:14px;background:rgba(12,10,30,.78);border:1px solid rgba(255,255,255,.1);
    transition:box-shadow .25s,transform .12s;--c:#fff;border-color:color-mix(in oklab,var(--c) 45%,transparent);}
  .card.hit{box-shadow:0 0 22px color-mix(in oklab,var(--c) 55%,transparent);transform:scale(1.03);}
  .card .who{font:700 12px var(--mono);letter-spacing:.1em;color:var(--c);display:flex;justify-content:space-between;gap:10px;}
  .card .who em{font-style:normal;opacity:.55;font-weight:500;}
  .card .sc{font:600 24px/1.1 var(--mono);margin-top:2px;}
  .card .keys{font:500 10px var(--mono);letter-spacing:.08em;opacity:.55;margin-top:2px;}
  .card .cb{font:700 11px var(--mono);color:var(--gold);height:14px;margin-top:1px;} .card .cb i{font-style:normal;color:var(--c);}
  .card.s0{left:14px;bottom:14px;} .card.s1{right:14px;bottom:14px;text-align:right;} .card.s2{right:14px;top:52px;text-align:right;} .card.s3{left:14px;top:52px;}
  .card.s1 .who,.card.s2 .who{flex-direction:row-reverse;}
  .card.bot{opacity:.7;}
  #top{position:absolute;left:50%;top:10px;transform:translateX(-50%);text-align:center;font:700 12px var(--mono);letter-spacing:.12em;color:var(--gold);white-space:nowrap;}
  #top .row{display:flex;gap:26px;justify-content:center;} #top .tl{color:var(--mint);}
  #top .hs{font:600 22px var(--mono);letter-spacing:0;color:var(--ink);}
  .card.called{box-shadow:0 0 0 2px var(--c),0 0 28px color-mix(in oklab,var(--c) 60%,transparent);} .card.called .cb{color:var(--c);}
  .card .who i{font-style:normal;opacity:.85;}
  #top .rd{font:700 11px var(--mono);letter-spacing:.14em;color:var(--mint);margin-top:2px;}
  #hearts{display:inline-flex;gap:4px;margin-left:8px;vertical-align:middle;}
  #hearts i{width:10px;height:10px;background:var(--pink);display:inline-block;clip-path:polygon(50% 100%,0 40%,15% 5%,50% 25%,85% 5%,100% 40%);opacity:.18;} #hearts i.on{opacity:1;}
  #prog{position:absolute;left:50%;top:74px;width:min(520px,60vw);height:4px;transform:translateX(-50%);border-radius:2px;background:rgba(255,255,255,.08);overflow:hidden;}
  #prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--gold),var(--mint));}
  #combo{position:absolute;left:50%;top:86px;transform:translateX(-50%);font:700 13px var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.75);white-space:nowrap;}
  #combo.fever{color:var(--gold);text-shadow:0 0 14px var(--gold);}
  #words{position:fixed;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .word{position:absolute;transform:translate(-50%,-50%);font:800 18px var(--display);white-space:nowrap;text-shadow:0 2px 12px rgba(0,0,0,.6);will-change:transform,opacity;}
  .word.big{font-size:32px;} .word.huge{font-size:52px;letter-spacing:.02em;}

  /* ---- panels ---- */
  #ui{position:fixed;inset:0;pointer-events:none;z-index:8;display:grid;place-items:center;will-change:transform;}
  .panel{background:rgba(12,10,30,.88);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:28px 36px;text-align:center;min-width:min(560px,92vw);max-width:min(720px,92vw);box-sizing:border-box;
    box-shadow:0 30px 80px rgba(0,0,0,.45);animation:pop .35s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(8px);}}
  .panel h1{margin:0;font:800 26px var(--display);color:var(--gold);letter-spacing:-.01em;}
  .panel h2{margin:0;font:800 44px/1.05 var(--display);}
  .panel p{margin:8px 0 0;font:500 16px/1.4 var(--display);color:rgba(244,240,255,.82);}
  .panel .mono{font:600 13px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.6);}
  .panel .tag{display:inline-block;font:700 12px var(--mono);letter-spacing:.14em;color:var(--mint);}
  .blink{animation:blink 1s steps(2,end) infinite;} @keyframes blink{50%{opacity:.25;}}
  .logo{display:flex;justify-content:center;gap:.01em;font:800 clamp(44px,9vw,86px)/1 var(--display);letter-spacing:-.02em;}
  .logo span{display:inline-block;background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bob 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.18s);}
  .logo span.sp{width:.3em;}
  @keyframes bob{50%{transform:translateY(-6px);}}
  .sub{font:800 clamp(22px,4vw,34px) var(--display);letter-spacing:.32em;color:var(--gold);margin-top:6px;text-indent:.32em;}
  .howto{display:grid;grid-template-columns:auto 1fr;gap:10px 16px;align-items:center;margin:18px auto 0;text-align:left;max-width:520px;}
  .howto b{font:700 12px var(--mono);color:#140f28;background:var(--k,#fff);border-radius:999px;padding:6px 12px;text-align:center;white-space:nowrap;}
  .howto span{font:500 16px var(--display);}
  .seats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0 0;}
  .seat{border-radius:16px;padding:12px 14px;border:1px solid color-mix(in oklab,var(--c) 40%,transparent);background:color-mix(in oklab,var(--c) 10%,transparent);text-align:left;transition:transform .2s,background .2s;}
  .seat.human{background:color-mix(in oklab,var(--c) 26%,transparent);transform:scale(1.03);box-shadow:0 0 24px color-mix(in oklab,var(--c) 40%,transparent);}
  .seat b{font:800 16px var(--display);color:var(--c);display:block;} .seat b small,.seat .k small{font:500 11px var(--mono);opacity:.6;letter-spacing:.04em;}
  .arch{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px;} .arch div{display:grid;gap:2px;font:500 13px var(--display);} .arch b{font:800 15px var(--display);} .arch em{font:500 10px var(--mono);font-style:normal;opacity:.5;letter-spacing:.08em;}
  .seat .k{font:600 13px var(--mono);letter-spacing:.14em;margin-top:4px;}
  .seat .st{font:700 11px var(--mono);letter-spacing:.1em;opacity:.7;margin-top:6px;}
  .seat.human .st{opacity:1;color:var(--c);}
  .seat:nth-child(1){grid-area:2/1;} .seat:nth-child(2){grid-area:2/2;} .seat:nth-child(3){grid-area:1/2;} .seat:nth-child(4){grid-area:1/1;}
  table.scores{margin:14px auto 0;border-collapse:collapse;font:600 16px var(--mono);}
  table.scores td{padding:4px 12px;} table.scores tr.me td{color:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .podium{display:grid;gap:8px;margin:16px 0 0;}
  .podium div{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;padding:8px 14px;border-radius:12px;background:rgba(255,255,255,.05);font:600 16px var(--mono);text-align:left;}
  .podium div:first-child{background:color-mix(in oklab,var(--c) 22%,transparent);font-size:19px;}
  .podium b{color:var(--c);} .podium em{font-style:normal;opacity:.55;font-size:12px;letter-spacing:.1em;}
  .initials{display:flex;justify-content:center;gap:18px;margin:16px 0 8px;}
  .initials b{width:68px;height:84px;border-radius:14px;background:rgba(255,255,255,.08);display:grid;place-items:center;font:800 52px var(--mono);position:relative;}
  .initials b.cur::after{content:"";position:absolute;bottom:8px;width:36px;height:4px;background:var(--gold);animation:blink .6s steps(2,end) infinite;}
  #fail{position:fixed;inset:0;display:none;place-items:center;text-align:center;z-index:30;padding:20px;}
  #fail p{font:500 16px var(--display);} #fail a{color:var(--gold);}
  body.attract .chrome,body.attract #hud{display:none!important;} body.attract #ui{zoom:.5;} body.attract #words{zoom:.6;}
  .boards{display:flex;width:max-content;gap:4px;margin:0 auto 10px;padding:3px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);pointer-events:auto;}
  .boards button{font:700 11px var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.6);background:transparent;border:0;border-radius:999px;padding:6px 12px;cursor:pointer;}
  .boards button[aria-pressed="true"]{background:var(--gold);color:#140f28;}
  .panel .acts{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px;pointer-events:auto;}
  .panel .acts button{font:700 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#140f28;background:var(--gold);border:0;border-radius:999px;padding:10px 18px;cursor:pointer;}
  .panel .acts button.ghost{background:rgba(255,255,255,.1);color:var(--ink);border:1px solid rgba(255,255,255,.18);}
  #share{position:fixed;inset:0;z-index:40;display:grid;place-items:center;background:rgba(6,5,16,.72);backdrop-filter:blur(10px);padding:16px;box-sizing:border-box;}
  #share .card2{width:min(640px,100%);background:rgba(16,13,38,.94);border:1px solid rgba(255,255,255,.14);border-radius:24px;padding:18px;box-sizing:border-box;box-shadow:0 30px 80px rgba(0,0,0,.5);animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  #share h2{margin:0 0 10px;font:800 20px var(--display);color:var(--gold);display:flex;justify-content:space-between;align-items:center;}
  #share h2 small{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.55);}
  #share img{display:block;width:100%;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:#0b0a1a;aspect-ratio:1200/630;}
  #share .row2{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center;}
  #share button,#share a.btn{font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#140f28;background:var(--gold);border:0;border-radius:999px;padding:10px 18px;cursor:pointer;text-decoration:none;display:inline-block;}
  #share button.ghost{background:rgba(255,255,255,.1);color:var(--ink);border:1px solid rgba(255,255,255,.18);}
  #share .st{font:600 12px var(--mono);color:var(--mint);margin-left:auto;min-height:1em;} #share .st a{color:var(--mint);}
  @media (max-width:520px){ #share .card2{padding:12px;} #share button,#share a.btn{padding:9px 12px;font-size:11px;} #share .st{margin-left:0;width:100%;} }
  @media (max-width:700px){ .chrome{left:12px;justify-content:flex-end;gap:6px;} .chrome button,.chrome a{padding:5px 8px;font-size:10px;} .chrome a[href="/keyboard"]{display:none;}
    #top{top:46px;} #top .hs{font-size:18px;} #prog{top:104px;} #combo{top:114px;font-size:11px;} .card.s2,.card.s3{top:136px;}
    .card{min-width:0;padding:6px 9px;} .card .sc{font-size:17px;} .card .keys{display:none;} .panel{padding:20px 18px;} .panel h2{font-size:30px;} .howto span{font-size:14px;} .howto{gap:8px 10px;} .seats{grid-template-columns:1fr;} .arch{grid-template-columns:1fr 1fr 1fr;gap:6px;} }
  @media (prefers-reduced-motion:reduce){ .logo span,.blink,table.scores tr.me td,.initials b.cur::after{animation:none;} }
</style>
</head>
<body>
<canvas id="gl" aria-label="Brick Choir: Quartet — press any key to join"></canvas>
<div id="hud" hidden>
  <div id="top"><div class="row"><div><span id="hsl">HIGH SCORE</span><div class="hs" id="hs">000000</div></div><div><span class="tl">TEAM</span><div class="hs" id="team">000000</div></div></div><div class="rd"><span id="rd">ROUND 1</span><span id="hearts"><i class="on"></i><i class="on"></i><i class="on"></i></span></div></div>
  <div id="prog"><i></i></div>
  <div id="combo"></div>
  <div class="card s0" id="c0"></div><div class="card s1" id="c1"></div><div class="card s2" id="c2"></div><div class="card s3" id="c3"></div>
</div>
