    html=`<div class="panel" style="--c:${s.hex}">${LOGO()}<h1 style="margin-top:14px;color:${s.hex}">${s.name} MADE THE CHOIR</h1><p class="mono">${entryFor.score.toLocaleString()} points — type your initials</p><div class="initials">${[0,1,2].map(i=>`<b class="${i===entry.length?'cur':''}" style="color:oklch(88% .12 ${i*80+300})">${esc(entry[i]||'')}</b>`).join('')}</div><p class="mono">enter to confirm · backspace to fix</p></div>`; }
  else if(state==='scores'){ html=`<div class="panel">${scoreRows(myRecs)}<p class="mono" style="margin-top:14px">any key</p></div>`; }
  else if(state==='paused'){ html=`<div class="panel"><h2>PAUSED</h2><p class="mono">esc to resume</p></div>`; }
  if(key!==uiKey||force){ uiKey=key; ui.innerHTML=html; }
  // per-frame text that must not rebuild the panel (and restart its pop)
  const setTxt=(id,v,col)=>{ const el=document.getElementById(id); if(el){ if(el.textContent!==v) el.textContent=v; if(col&&el.style.color!==col) el.style.color=col; } };
  if(state==='lobby') setTxt('lobbyLeft',String(Math.max(0,Math.ceil((lobbyEnd-T)/1000))));
  else if(state==='ready'){ const p=(T-stateT)/2600; setTxt('readyWord',p>0.62?(p<0.9?'READY!':'PLAY!'):'',p<0.9?'#ffd27a':'#ff8fb1'); }
  else if(state==='clear'&&clearBonus){ const q=Math.min(1,(T-stateT)/1600); setTxt('clearLine',`song bonus +${Math.round(clearBonus*q).toLocaleString()} each`); }
  else if(state==='over') setTxt('overCont',T-stateT>900?(published&&published!=='x'&&published!=='…'?'your song is on the wall ✓ · S to share · any other key to continue':'S to share · any other key to continue'):'');
  hud.hidden=!(state==='play'||state==='ready'||state==='clear'||state==='short'||state==='over'||state==='paused'||state==='attract'||state==='lobby');
}
function renderHud(T){
  if(hud.hidden) return;
  const cs=called(), joinable=state==='attract'||state==='lobby'||state==='play';
  players.forEach((p,i)=>{ const s=SEATS[i], el=document.getElementById('c'+i); el.style.setProperty('--c',s.hex); el.classList.toggle('bot',!p.human); el.classList.toggle('called',state==='play'&&cs===s);
    const cue=state==='play'&&cs===s?`♪ ${p.human?'YOUR NOTE':'BOT’S NOTE'}`:(!p.human&&joinable&&(state!=='play'||p.combo<=2)?'<i class="blink">PRESS ANY KEY TO JOIN</i>':(p.combo>2?`${p.combo} combo`:''));
    const html=`<div class="who"><span>${s.up} · ${p.human?'YOU':'BOT'}</span><em>${s.part}</em></div><div class="sc">${String(p.score).padStart(6,'0')}</div><div class="keys">${esc(s.caps[0])} · ${esc(s.caps[1])} · ${esc(s.drums)}</div><div class="cb">${cue}</div>`;
    if(el._h!==html){ el._h=html; el.innerHTML=html; } });
  const hs=String(best()).padStart(6,'0'); const hsEl=document.getElementById('hs'); if(hsEl.textContent!==hs) hsEl.textContent=hs;
  const tm=String(players.reduce((a,p)=>a+p.score,0)).padStart(6,'0'); const tmEl=document.getElementById('team'); if(tmEl.textContent!==tm) tmEl.textContent=tm;
  const rd=lvl?`ROUND ${lvlI+1}${verse?` · VERSE ${verse+1}`:''}`:''; const rdEl=document.getElementById('rd'); if(rdEl.textContent!==rd) rdEl.textContent=rd;
  document.querySelectorAll('#hearts i').forEach((h,i)=>h.classList.toggle('on',i<hearts));
  const pr=document.querySelector('#prog i'); pr.style.width=(state==='play'?Math.max(0,Math.min(1,1-(songEnd-T)/songLen))*100:0)+'%';
  const cb=document.getElementById('combo'); const txt=state==='play'&&combo>1?`${combo} combo · ×${mult()}${fever>T?' · FEVER':''}${targets[tIdx]?` · song ${tIdx}/${targets.length}`:''}`:''; if(cb.textContent!==txt) cb.textContent=txt; cb.classList.toggle('fever',fever>T);
}

/* ================= intermissions (in the stage itself) ================= */
let interOrbs=[];
function interStart(){ balls=[]; const next=LEVELS[lvlI+1]; jingle(INTER_TUNES[interAct].map(x=>x===null?null:x+60+(next.root||0)),0.16,'lead');
  if(interAct===0){ cells.forEach(c=>{ c.hp=0; }); interOrbs=SEATS.map(s=>({x:s.dir[0]*12,z:s.dir[1]*12,col:s.col,seat:s.id})); }
  else if(interAct===1){ lvl=next; verse=0; buildCells(true); refreshBrickColors(); updateCore(); interOrbs=[{x:0,z:0,col:new THREE.Color(0xfff0c0),seat:0}]; }
  else { // the three Architects circle the stage and raise the last monument ring by ring
    lvl=next; verse=0; buildCells(true); const T=now(); cells.forEach(c=>{ if(c.born) c.born=T+1200+(3-c.ring)*1100+(c.face*9+c.pos)*18; }); refreshBrickColors(); updateCore();
    interOrbs=[['#ffb38a',0],['#e3a8ff',1],['#fff3c4',2]].map(([h,k])=>({x:0,z:0,col:new THREE.Color(h),seat:k,trail:[]})); } }
function interUpdate(T,dt){
  const p=(T-stateT)/6500;
  if(interAct===0){ // four orbs spiral in from their corners and meet in a chord
    balls=interOrbs.map((o,i)=>{ const q=Math.min(1,p*1.5); const a=(SEATS[i].ang)*DEG+q*Math.PI*1.6; const r=12*(1-q)+0.6; const x=Math.cos(a)*r, z=-Math.sin(a)*r; o.trail=o.trail||[]; o.trail.push(x,z); if(o.trail.length>36) o.trail.splice(0,2); return {x,z,r:0.4,col:o.col,trail:o.trail,owner:i,inside:q>0.9}; });
    if(p>0.66&&!interUpdate.chord){ interUpdate.chord=true; const t=snapT(); SEATS.forEach((s,k)=>tone(60+(LEVELS[lvlI+1].root||0)+[0,4,7,12][k],{t:t+k*0.03,kind:s.kind,len:0.6,vel:1,pan:s.pan})); flare=1; shake=6; coreFlash=1.4; for(let i=0;i<60;i++) spawnPart(0,0.5,0,SEATS[i%4].col,5,true); word('four voices, one chord',null,{big:true,hold:true}); }
  } else if(interAct===1){ // a big ball tours the hollow core, ringing the bell on every beat
    const a=p*Math.PI*6; const r=Math.max(0.2,coreR-0.5); const o=interOrbs[0]; o.trail=o.trail||[]; const x=Math.cos(a)*r, z=Math.sin(a)*r; o.trail.push(x,z); if(o.trail.length>36) o.trail.splice(0,2);
    balls=[{x,z,r:0.5,col:o.col,trail:o.trail,owner:0,inside:true}];
    const beat=Math.floor(p*12); if(beat!==interUpdate.beat){ interUpdate.beat=beat; coreFlash=1; tone((lvl.root||0)+36+[0,7,12,7][beat%4],{kind:'bigbell',len:0.3,vel:0.7}); ring(0,0,pitchColor(lvl.root,0.9,0.1),1.6); }
    if(p>0.8&&!interUpdate.burst){ interUpdate.burst=true; word('✦ the bell is waiting ✦',null,{big:true,hold:true,color:'#e3a8ff'}); }
  } else { // Act III: three orbs orbit while the spell's monument rises; each ring that lands is an arpeggio
    balls=interOrbs.map((o,i)=>{ const a=i*2.094+p*Math.PI*3, r=8.5-p*3; const x=Math.cos(a)*r, z=Math.sin(a)*r; o.trail.push(x,z); if(o.trail.length>30) o.trail.splice(0,2); return {x,z,r:0.45,col:o.col,trail:o.trail,owner:i,inside:false}; });
    const T=now(); const ring=Math.floor((T-stateT-1200)/1100); if(ring>=0&&ring<=3&&ring!==interUpdate.ring){ interUpdate.ring=ring; const rc=cells.filter(c=>c.ring===3-ring&&c.hp>0&&c.hp!==Infinity); const t0=ctx?ctx.currentTime:0; rc.slice(0,24).forEach((c,k)=>tone(c.midi+12,{t:t0+k*0.045,kind:'bell',len:0.05,vel:0.35,pan:SEATS[c.face].pan})); flare=Math.max(flare,0.5); }
    if(p>0.72&&!interUpdate.burst){ interUpdate.burst=true; word('✦ the spell is waiting ✦',null,{big:true,hold:true,color:'#e3a8ff'}); coreFlash=1.2; }
  }
  if(p>=1){ interUpdate.chord=false; interUpdate.burst=false; interUpdate.beat=-1; interUpdate.ring=-1; balls=[]; beginRound(lvlI+1); }
}

/* ================= main loop ================= */
let last=0;
function frame(){
  if(throttled&&(++frameN%4)){ requestAnimationFrame(frame); return; } // an unfocused lobby cabinet idles at ~15 fps
  const T=now(); const dt=Math.min(TESTMODE?0.4:0.1,(T-(last||T))/1000); if(!last){ attractT=T; stateT=T; } last=T;
  if(state==='play'||state==='attract'||state==='lobby'){ update(dt); scheduler(); bots(); }
  else if(state==='inter') interUpdate(T,dt);
  else { flare=Math.max(0,flare-dt*1.2); shake=Math.max(0,shake-dt*18); coreFlash=Math.max(0,coreFlash-dt*1.1); }
  if(state==='attract'&&T-attractT>(attractPanel===0?10000:7000)){ attractPanel=ATTRACT?(attractPanel?0:3):(attractPanel+1)%4; attractT=T; if(attractPanel===3) loadScores(); } // a cabinet screen only cycles logo ↔ choir
  if(state==='lobby'&&T>=lobbyEnd) startGame();
  if(state==='ready'&&T-stateT>=2600){ setState('play'); songEnd=now()+songLen; seqT=0; }
  if((state==='clear'||state==='short')&&T-stateT>=3200) afterRound();
  if(state==='scores'&&T-stateT>=12000) toAttract();
  try{ renderUI(); renderHud(T); draw(T,dt); }catch(err){ if(!frame.err){ frame.err=true; console.error('quartet frame error',err); } }
  requestAnimationFrame(frame);
}

/* ================= input ================= */
const SP2=()=>now()-stateT;
function codeOf(e){ return ALIAS[e.code]||e.code; }
addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey||e.altKey||ATTRACT) return; const code=codeOf(e); const sl=slots[code]; const dk=DRUMKEYS[code];
  if(shareOpen){ if(code==='Escape') closeShare(); return; }
  if((state==='scores'||(state==='attract'&&attractPanel===3))&&(code==='ArrowLeft'||code==='ArrowRight')){ e.preventDefault(); boardMode=boardMode==='week'?'all':'week'; stateT=now(); attractT=now(); renderUI(true); tone(76,{kind:'lead',len:0.05,vel:0.4}); return; }
  if(state==='attract'){ e.preventDefault(); boot(); claimSeat(sl?sl.seat:dk?dk[0]:0); startLobby(); if(sl){ heldKeys.add(code); fire(code); } else if(dk) drumPad(dk[0],dk[1]); return; }
  if(state==='lobby'){ e.preventDefault(); if(code==='Enter'){ startGame(); return; } if(sl||dk){ boot(); if(claimSeat(sl?sl.seat:dk[0])) lobbyEnd=Math.max(lobbyEnd,now()+6000); if(!e.repeat){ if(sl){ heldKeys.add(code); fire(code); } else drumPad(dk[0],dk[1]); } } return; }
  if(state==='initials'){ e.preventDefault(); if(code==='Backspace'){ entry=entry.slice(0,-1); return; } if(code==='Enter'){ submitScore((entry+'???').slice(0,3).replace(/\?/g,'-'),entryFor); return; } if(/^[A-Za-z0-9]$/.test(e.key)&&entry.length<3){ entry+=e.key.toUpperCase(); tone(64+entry.length*4,{kind:'lead',len:0.08}); } return; }
  if(state==='over'){ e.preventDefault(); if(SP2()<900) return; if(code==='KeyS'||code==='KeyP'){ openShare(); return; } nextEntry(); return; }
  if(state==='scores'){ e.preventDefault(); toAttract(); return; }
  if(state==='inter'){ e.preventDefault(); if(SP2()>1000){ interUpdate.chord=false; interUpdate.burst=false; interUpdate.ring=-1; balls=[]; beginRound(lvlI+1); } return; }
  if(code==='Escape'){ e.preventDefault(); if(state==='play'){ setState('paused'); pausedLeft=songEnd-now(); } else if(state==='paused'){ setState('play'); songEnd=now()+pausedLeft; seqT=0; } return; }
  if(state!=='play') return; if(!sl&&!dk) return; e.preventDefault(); if(e.repeat) return;
  boot(); const seat=sl?sl.seat:dk[0]; if(!players[seat].human){ claimSeat(seat); }
  if(sl){ heldKeys.add(code); fire(code); } else drumPad(dk[0],dk[1]);
});
addEventListener('keyup',e=>heldKeys.delete(codeOf(e)));
addEventListener('blur',()=>{ heldKeys.clear(); if(state==='play'){ setState('paused'); pausedLeft=songEnd-now(); } });
// touch / mouse: each quarter of the screen is a seat — tap to fire the nearest key on that seat's deck
const seatOfPoint=(x,y)=>{ const l=x<innerWidth/2, t=y<innerHeight/2; return t?(l?3:2):(l?0:1); };
cv.addEventListener('pointerdown',e=>{
  if(ATTRACT||shareOpen) return;
  boot(); const seat=seatOfPoint(e.clientX,e.clientY);
  if(state==='attract'){ claimSeat(seat); startLobby(); return; }
  if(state==='lobby'){ if(claimSeat(seat)) lobbyEnd=Math.max(lobbyEnd,now()+6000); else if(now()-stateT>800) startGame(); return; }
  if(state==='over'||state==='scores'||state==='inter'||state==='paused'){ window.dispatchEvent(new KeyboardEvent('keydown',{code:'Space',key:' '})); return; }
  if(state==='initials'){ submitScore((entry+'---').slice(0,3),entryFor); return; }
  if(state!=='play') return;
  let bestSl=null,bd=1e9; SEATS[seat].slots.forEach(sl=>{ const [x,y]=project(sl.x,0.1,sl.z); const d=Math.hypot(x-e.clientX,y-e.clientY); if(d<bd){ bd=d; bestSl=sl; } });
  if(bestSl){ if(!players[seat].human) claimSeat(seat); heldKeys.add(bestSl.code); fire(bestSl.code); setTimeout(()=>heldKeys.delete(bestSl.code),200); }
});
document.getElementById('snd').onclick=e=>{ boot(); muted=!muted; if(out) out.gain.value=muted?0:0.8; e.currentTarget.textContent=muted?'sound off':'sound on'; e.currentTarget.setAttribute('aria-pressed',String(!muted)); e.currentTarget.blur(); };
document.getElementById('fs').onclick=e=>{ e.currentTarget.blur(); if(document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen?.(); };

if(TESTMODE) window.__bq={get state(){return state;},get players(){return players;},get balls(){return balls;},get cells(){return cells;},get targets(){return targets;},get tIdx(){return tIdx;},slots,SEATS,get lvl(){return lvl;},get lvlI(){return lvlI;},get hearts(){return hearts;},
  start:()=>{boot();startGame();},claim:i=>claimSeat(i),lobby:()=>startLobby(),fire:c=>fire(c),setState,go:(s)=>{ if(s==='inter'){ interAct=0; setState('inter'); interStart(); } else if(s==='over'){ gameOver(false); } else if(s==='initials'){ entryFor=players[0]; entry='AB'; setState('initials'); } else setState(s); },
  endSong:()=>{ songEnd=0; }, act3:()=>{ lvlI=6; interAct=2; setState('inter'); interStart(); }, breakable, set attractPanel(v){ attractPanel=v; attractT=now(); }, get attractPanel(){ return attractPanel; }, get quartets(){ return quartets; }, get bells(){ return bells; }, word, get uiKey(){ return uiKey; }, get stateT(){ return stateT; }, get entryFor(){ return entryFor; }, get verse(){ return verse; }, get tunnels(){ return tunnels; },
  get rally(){ return rally; }, get published(){ return published; }, get boardMode(){ return boardMode; }, get boards(){ return {all:hiGlobal,week:hiWeek}; }, openShare, get shareOpen(){ return shareOpen; }};
loadScores(); toAttract(); requestAnimationFrame(frame);
if(ATTRACT) try{ parent.postMessage({bc:'ready',game:'quartet'},'*'); }catch(e){}
</script>
</body>
