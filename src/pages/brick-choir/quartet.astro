// four people at one laptop share one IP, and the choir takes one entry a minute: retry the rest in the background
async function postScore(body,attempt){
  try{ const r=await fetch('/api/brick-scores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) hiGlobal=j.scores; if(Array.isArray(j.weekScores)) hiWeek=j.weekScores; renderUI(true); return; }
    if(r.status===429&&attempt<4) setTimeout(()=>postScore(body,attempt+1),62000*(attempt+1)); }catch(e){}
}
function nextEntry(){ const p=entryQueue.shift(); if(p){ entryFor=p; entry=''; setState('initials'); } else { boardMode='week'; setState('scores'); } }
async function loadScores(){ const get=async q=>{ try{ const r=await fetch('/api/brick-scores'+q); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) return j.scores; } }catch(e){} return null; };
  const [a,w]=await Promise.all([get(''),get('?period=week')]); if(a) hiGlobal=a; if(w) hiWeek=w; renderUI(true); }
function toAttract(){ players.forEach(p=>{ p.human=false; p.name='BOT'; p.score=0; p.combo=0; }); setState('attract'); attractPanel=0; attractT=now(); loadLevel(0,{build:true}); myRecs=[]; seqT=0; setBackdrop(true); boardMode='week'; }

/* ================= the take on the wall + the share card ================= */
function takeBody(){ // /api/keyboard wants key codes: fired notes have theirs, brick hits borrow the nearest key of the seat that played them
  const t0=rally[0][0]; const ev=[]; const near=(m,seat)=>{ const s=SEATS[seat]; return s.slots.reduce((a,x)=>Math.abs(slotMidi(x)-m)<Math.abs(slotMidi(a)-m)?x:a).code; };
  rally.slice(0,5000).forEach(([t,m,seat,code])=>{ const k=t-t0, c=code||near(m,seat); ev.push([k,c,1],[k+120,c,0]); }); ev.sort((a,b)=>a[0]-b[0]);
  const dur=Math.min(180000,ev[ev.length-1][0]+300); const team=players.reduce((a,p)=>a+p.score,0);
  return {title:`Brick Choir: Quartet · ${team.toLocaleString()} points`,song:'',note:`round ${lvlI+1} · ${humans().length||1} player${humans().length>1?'s':''} · ${notesPlayed} notes · ${bells} bells · ${quartets} quartets`,link:null,name:'',dur,settings:{scale:lvl.scale,root:lvl.root,voice:'glass',bpm:Math.min(150,Math.max(70,lvl.bpm||104)),sync:false},events:ev.filter(e=>e[0]<=dur),visibility:'public'};
}
async function publish(){
  if(rally.length<4||published) return published; published='…';
  try{ const r=await fetch('/api/keyboard',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(takeBody())}); const j=await r.json(); published=r.ok?('/keyboard?t='+j.id):'x';
