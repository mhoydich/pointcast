/* ================= flow ================= */
function startGame(){ players.forEach(p=>{ p.score=0; p.combo=0; p.hits=0; p.lastHit=0; }); hearts=3; notesPlayed=0; bells=0; quartets=0; tunnels=0; myRecs=[]; rally=[]; rallyT0=now(); published=null; beginRound(0); }
function beginRound(i){
  loadLevel(i); setState('ready'); seqT=0;
  const t0=ctx?ctx.currentTime:0; let k=0; [...cells].filter(c=>c.hp>0&&c.hp!==Infinity).sort((a,b)=>a.born-b.born).forEach(c=>{ if(ctx&&k<44) tone(c.midi+12,{t:t0+k*0.05,kind:'bell',len:0.04,vel:0.35,pan:SEATS[c.face].pan}); k++; });
  setTimeout(()=>{ if(state==='ready'&&ctx) jingle([0,4,7,12,7,12].map(x=>60+lvl.root+x),0.11); },1600);
}
function verseClear(){
  if(state!=='play'||breakable()>0) return;
  verse++; const bonus=1000*verse*mult(); players.forEach(p=>{ p.score+=bonus; flashCard(p.seat); }); flare=1; shake=5; camKick=1;
  word(`verse ${verse+1}!`,null,{huge:true,hold:true,color:'#ffd27a'}); jingle([0,4,7,12,16,19,24].map(x=>60+lvl.root+x),0.07,'lead');
  buildCells(true); const T=now(); cells.forEach(c=>{ if(c.born) c.born+=500; }); const t0=ctx?ctx.currentTime+0.5:0; let k=0;
  [...cells].filter(c=>c.hp>0&&c.hp!==Infinity).sort((a,b)=>a.born-b.born).forEach(c=>{ if(ctx&&k<36) tone(c.midi+12,{t:t0+k*0.04,kind:'bell',len:0.04,vel:0.3,pan:SEATS[c.face].pan}); k++; });
  refreshBrickColors(); updateCore();
}
function songOver(){
  if(state!=='play') return; const total=totalBreakable(), left=breakable();
  if(verse>0){ clearBonus=verse*500; players.forEach(p=>p.score+=clearBonus); setState('clear'); jingle([0,4,7,12,16,19,24].map(x=>60+lvl.root+x),0.08,'lead'); return; }
  if(left/total>0.34){ hearts--; setState('short'); jingle([67,64,60,55].map(x=>x+lvl.root-7),0.18,'lead'); }
  else { clearBonus=0; setState('clear'); jingle([0,7,12].map(x=>60+lvl.root+x),0.12); }
}
function afterRound(){
  if(hearts<=0){ gameOver(); return; }
  const next=lvlI+1; if(next>=LEVELS.length){ gameOver(true); return; }
  const act=[2,4,7].indexOf(next); if(act>=0){ interAct=act; setState('inter'); interStart(); return; }
  beginRound(next);
}
const INTER_TUNES=[[0,4,7,4,0,4,7,12,null,11,7,4,2,4,0,null],[0,7,12,7,4,7,12,16,19,16,12,7,12,null,null,null],[0,3,7,10,12,10,7,3,0,null,12,15,19,24,null,null]];
const ACTS=['Act I · Four Corners','Act II · The Bell','Act III · The Architects'];
function gameOver(won){
  setState('over'); overWon=!!won; balls=[]; jingle(won?[0,4,7,12,16,19,24,28].map(x=>60+(lvl?lvl.root:0)+x):[12,11,7,4,3,0].map(x=>60+(lvl?lvl.root:0)+x),won?0.1:0.2,'lead');
