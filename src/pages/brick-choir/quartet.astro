}
// you make the choir if you'd land on this week's table or the all-time one (the week's is the friendly one)
function qualifies(score){ if(score<=0) return false; return [hiWeek,(hiGlobal||[]).length?hiGlobal:hiLocal].some(l=>!l||l.length<10||score>Math.min(...l.map(r=>r.score))); }
async function submitScore(initials,p){
  const rec={initials,score:p.score,round:lvlI+1,at:Date.now(),game:'quartet'}; myRecs.push(rec);
  hiLocal=[...hiLocal,rec].sort((a,b)=>b.score-a.score).slice(0,10); store.set('scores',hiLocal);
  postScore({initials,score:p.score,round:lvlI+1,game:'quartet'},0);
