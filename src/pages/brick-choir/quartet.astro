const wordsEl=document.getElementById('words'); const words=[];
function word(text,pos,{color='#fff3c4',big=false,huge=false,hold=false}={}){ const el=document.createElement('div'); el.className='word'+(huge?' huge':big?' big':''); el.textContent=text; el.style.color=color; wordsEl.appendChild(el); words.push({el,pos,t:now(),life:hold?1800:(big||huge?1200:750)}); if(words.length>24){ const w=words.shift(); w.el.remove(); } }
const _v=new THREE.Vector3();
function project(x,y,z){ _v.set(x,y,z).project(camera); return [(_v.x+1)/2*innerWidth,(1-_v.y)/2*innerHeight]; }

/* camera: above the south corner in play, slowly orbiting in attract, swooping in on the big moments */
let camAz=0, camEl=50*DEG, camDist=36; const cam={az:0,el:50*DEG,d:36,init:false};
function fit(){ const w=innerWidth, h=innerHeight; renderer.setSize(w,h,false); composer.setSize(w,h); bloom.setSize(Math.round(w/2),Math.round(h/2)); camera.aspect=w/h; camera.updateProjectionMatrix();
  const rad=16.4, vf=camera.fov*DEG/2, hf=Math.atan(Math.tan(vf)*camera.aspect); camDist=Math.max(rad/Math.sin(vf)*0.8,rad/Math.sin(hf)*0.92)*(w<700?1.15:1);
  scene.fog.near=camDist*0.95; scene.fog.far=camDist*1.7; camera.far=camDist*3; camera.updateProjectionMatrix(); }
addEventListener('resize',fit); fit();
function placeCamera(T,dt){
  const t=T/1000, fv=fever>T; const orbit=state==='attract'||state==='inter'||state==='over'||state==='scores'||state==='initials';
  let az=orbit?(reduce?0.35:t*0.07):0, el=orbit?44*DEG:camEl, d=camDist*(orbit?1.02:1);
  if(state==='inter'&&interAct===1){ const k=Math.min(1,(T-stateT)/3000); d*=1-0.4*k; el+=10*DEG*k; }
  if(state==='lobby'){ el=46*DEG; }
  if(!reduce){ az+=Math.sin(t/11)*3*DEG*(fv?2:1)+(fv?Math.sin(t*0.9)*2.5*DEG:0); el+=Math.sin(t/7)*1.2*DEG; d-=0.5*Math.pow(1-beatPhase(),3)*(state==='play'?1:0);
    d*=1-0.11*camKick; el-=6*DEG*camKick; }
  camKick=Math.max(0,camKick-dt*0.9);
  if(!cam.init){ cam.az=az; cam.el=el; cam.d=d; cam.init=true; }
  const k=Math.min(1,dt*(orbit?1.2:2.4)); let daz=az-cam.az; daz=Math.atan2(Math.sin(daz),Math.cos(daz)); cam.az+=daz*k; cam.el+=(el-cam.el)*k; cam.d+=(d-cam.d)*k;
  const sh=reduce?0:shake; const sx=(Math.random()-0.5)*sh*0.06, sy=(Math.random()-0.5)*sh*0.06;
  camera.position.set(cam.d*Math.cos(cam.el)*Math.sin(cam.az)+sx,cam.d*Math.sin(cam.el)+sy,cam.d*Math.cos(cam.el)*Math.cos(cam.az)); camera.lookAt(0,0.9,-0.6);
}
// key art (optional, may not exist yet): lies under the stage like a tablecloth, fading out with distance, only in attract
const artMat=new THREE.ShaderMaterial({transparent:true,depthWrite:false,uniforms:{map:{value:null},op:{value:0}},
  vertexShader:`varying vec2 vUv; varying vec3 vP; void main(){ vUv=uv; vP=position; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }`,
  fragmentShader:`uniform sampler2D map; uniform float op; varying vec2 vUv; varying vec3 vP; void main(){ float r=length(vP.xy); vec4 c=texture2D(map,vUv); float a=op*smoothstep(36.0,17.0,r)*smoothstep(14.6,15.4,r); gl_FragColor=vec4(c.rgb*a,a); }`});
const artPlane=new THREE.Mesh(new THREE.PlaneGeometry(72,72),artMat); artPlane.rotation.x=-Math.PI/2; artPlane.position.y=-0.2; artPlane.visible=false; scene.add(artPlane);
let artWant=false; new THREE.TextureLoader().load('/brick-choir/key4.webp',tex=>{ tex.colorSpace=THREE.SRGBColorSpace; artMat.uniforms.map.value=tex; artPlane.visible=true; },undefined,()=>{});
function setBackdrop(on){ artWant=on; }

/* per-frame scene update */
const M4=new THREE.Matrix4(), Q0=new THREE.Quaternion(), V3=new THREE.Vector3(), S3=new THREE.Vector3(), QF=new THREE.Quaternion().setFromEuler(new THREE.Euler(-Math.PI/2,0,0)), C0=new THREE.Color();
function draw(T,dt){
  const fv=fever>T, half=(N-1)/2, glow=brickGeo.getAttribute('aGlow'); const tg=targets[tIdx];
  // bricks
  let k=0; const beat=beatPhase();
  cells.forEach(c=>{ const [wx,wz]=toWorld(c.u,c.v); const age=c.born?Math.min(1,Math.max(0,(T-c.born)/300)):1; const alive=c.hp>0&&age>0;
    const isT=c===tg; let g=0.07+c.flash*1.6+(isT?0.7+0.5*Math.sin(T/120):0)+(c.chord?0.25+0.2*Math.sin(T/200+c.i):0)+(fv?0.12+0.1*Math.sin(T/150-c.ring*1.2):0)+(c.max===9?-0.05:0)+(c.core?0:0);
    c.flash=Math.max(0,c.flash-dt*4);
    const hp=c.hp===Infinity?2:c.hp;
    for(let h=0;h<3;h++,k++){ const on=alive&&h<hp; if(!on){ S3.set(0,0,0); V3.set(wx,0,wz); } else { const sc=0.5+0.5*age; S3.set(sc,sc,sc); V3.set(wx,BH/2+h*BH+(1-age)*1.5,wz); } M4.compose(V3,Q0,S3); brickMesh.setMatrixAt(k,M4); glow.setX(k,g); }
    if(alive&&age>=1){ V3.set(wx-0.22*CELL*SQ,hp*BH*0.92+0.012,wz-0.22*CELL*SQ); S3.set(1,1,1); M4.compose(V3,QF,S3); } else { S3.set(0,0,0); M4.compose(V3,QF,S3); } capMesh.setMatrixAt(k/3-1,M4); });
  for(;k<MAXCELL;k++){ S3.set(0,0,0); M4.compose(V3,Q0,S3); brickMesh.setMatrixAt(k,M4); if(k%3===2) capMesh.setMatrixAt((k-2)/3,M4); }
  brickMesh.instanceMatrix.needsUpdate=true; glow.needsUpdate=true; capMesh.instanceMatrix.needsUpdate=true;
  // balls + trails + glows
  let gi=0; for(let i=0;i<MAXBALL;i++){ const b=balls[i]; if(b){ V3.set(b.x,b.r,b.z); S3.set(b.r,b.r,b.r); M4.compose(V3,Q0,S3); ballMesh.setMatrixAt(i,M4); C0.copy(b.col).lerp(WHITE,0.5).multiplyScalar(b.inside?2.2:1.5); ballMesh.setColorAt(i,C0);
      for(let j=0;j<TRAIL;j++){ const idx=b.trail.length-2-j*2; if(idx>=0){ const f=1-j/TRAIL; V3.set(b.trail[idx],b.r*0.8,b.trail[idx+1]); const s=b.r*f*0.9; S3.set(s,s,s); } else S3.set(0,0,0); M4.compose(V3,Q0,S3); trailMesh.setMatrixAt(i*TRAIL+j,M4); C0.copy(b.col).multiplyScalar(b.inside?1.6:0.9); trailMesh.setColorAt(i*TRAIL+j,C0); }
      V3.set(b.x,0.02,b.z); const gs=b.r*4.5*(b.landing?1+((T-b.landT)/900):1); S3.set(gs,gs,1); M4.compose(V3,QF,S3); glowMesh.setMatrixAt(gi,M4); C0.copy(b.col).multiplyScalar(b.landing?0.7:0.35); glowMesh.setColorAt(gi++,C0); }
    else { S3.set(0,0,0); M4.compose(V3,Q0,S3); ballMesh.setMatrixAt(i,M4); for(let j=0;j<TRAIL;j++) trailMesh.setMatrixAt(i*TRAIL+j,M4); } }
  for(let i=rings.length-1;i>=0;i--){ const r=rings[i], q=(T-r.t)/(700+r.size*300); if(q>=1){ rings.splice(i,1); continue; } if(gi>=MAXBALL+40) break; V3.set(r.x,0.03,r.z); const s=(1+q*10)*r.size; S3.set(s,s,1); M4.compose(V3,QF,S3); glowMesh.setMatrixAt(gi,M4); C0.copy(r.col).multiplyScalar((1-q)*0.5); glowMesh.setColorAt(gi++,C0); }
  for(;gi<MAXBALL+40;gi++){ S3.set(0,0,0); M4.compose(V3,QF,S3); glowMesh.setMatrixAt(gi,M4); }
  ballMesh.instanceMatrix.needsUpdate=true; trailMesh.instanceMatrix.needsUpdate=true; glowMesh.instanceMatrix.needsUpdate=true; ballMesh.instanceColor.needsUpdate=true; trailMesh.instanceColor.needsUpdate=true; glowMesh.instanceColor.needsUpdate=true;
  // shards
  partPool.forEach((p,i)=>{ if(p.on){ const q=(T-p.t)/p.life; if(q>=1){ p.on=false; } else { p.x+=p.vx*dt; p.z+=p.vz*dt; if(p.shard){ p.vy-=9*dt; p.y+=p.vy*dt; if(p.y<0.05){ p.y=0.05; p.vy*=-0.35; p.vx*=0.8; p.vz*=0.8; } } else p.y+=p.vy*dt; p.rot+=dt*6;
      V3.set(p.x,p.y,p.z); S3.setScalar(p.s*(1-q*q)); Q0.setFromAxisAngle(V3.set(0.3,1,0.2).normalize(),p.rot); V3.set(p.x,p.y,p.z); M4.compose(V3,Q0,S3); Q0.identity(); partMesh.setMatrixAt(i,M4); C0.copy(p.col).multiplyScalar(1.6); partMesh.setColorAt(i,C0); } }
    if(!p.on){ S3.set(0,0,0); M4.compose(V3,Q0,S3); partMesh.setMatrixAt(i,M4); } });
  partMesh.instanceMatrix.needsUpdate=true; partMesh.instanceColor.needsUpdate=true;
  // decks: lit where pressed, breathing where a ball is coming home, dim otherwise
  slotWant.fill(0); balls.forEach(b=>{ if(b.landing){ SEATS[b.landSeat].slots.forEach(sl=>{ if(angDiff(angOf(b.x,b.z),sl.ang)<SLOT_STEP*1.6) slotWant[sl.gi]=1; }); } else { const d=Math.hypot(b.x,b.z); if(d>9.5&&(b.vx*b.x+b.vz*b.z)>0){ const s=seatAt(b.x,b.z); if(s) s.slots.forEach(sl=>{ if(angDiff(angOf(b.x,b.z),sl.ang)<SLOT_STEP*0.9) slotWant[sl.gi]=Math.max(slotWant[sl.gi],0.6); }); } } });
  const lc=labelGeo.getAttribute('aCol');
  slotList.forEach((sl,k)=>{ slotLit[k]=Math.max(0,slotLit[k]-dt*5); const held=heldKeys.has(sl.code)?1:0; const lit=Math.max(slotLit[k],held); const s=SEATS[sl.seat], p=players[sl.seat]; const w=slotWant[k]*(0.5+0.5*Math.sin(T/90));
    C0.copy(s.col).multiplyScalar(0.22+(p.human?0.2:0.05)+lit*0.9+w*0.6); if(state==='lobby'&&!p.human) C0.multiplyScalar(0.5); slotMesh.setColorAt(k,C0);
    const lb=lit>0.3?0.08:0.85+w; lc.setXYZ(k,lb,lb,lb); });
  slotMesh.instanceColor.needsUpdate=true; lc.needsUpdate=true;
  // arcs, bumpers, core, floor, lights
  const cs=called(); deckArcs.forEach((m,i)=>{ const p=players[i]; const call=state==='play'&&cs===SEATS[i]?0.9+0.9*Math.sin(T/110):0; m.material.color.copy(SEATS[i].col).multiplyScalar((p.human?1.6:0.5)+call); floorKick[i]=Math.max(0,floorKick[i]-dt*3); });
  BUMPERS.forEach(bp=>{ bp.flash=Math.max(0,(bp.flash||0)-dt*3); bp.mesh.material.color.setRGB(0.5+bp.flash*2.5,0.48+bp.flash*2.5,0.7+bp.flash*2.5); });
  coreDisc.material.color=pitchColor(lvl?lvl.root:0,0.6+0.35*Math.min(1,coreFlash)+(fv?0.1:0),0.12); coreDisc.material.color.multiplyScalar(0.35+coreFlash*1.6+(1-beat)*0.15); coreRing.material.color.copy(coreDisc.material.color).multiplyScalar(1.6+coreFlash); coreBeam.material.uniforms.op.value=Math.min(0.5,coreFlash*0.4+(fv?0.12:0)); coreBeam.material.uniforms.col.value=coreDisc.material.color;
  if(tg&&(state==='play'||state==='attract'||state==='lobby')){ const [tx,tz]=toWorld(tg.u,tg.v); targetBeam.visible=true; targetBeam.position.set(tx,3+tg.hp*BH,tz); targetBeam.material.uniforms.col.value=pitchColor(tg.midi,0.85,0.14).lerp(SEATS[tg.face].col,0.5); targetBeam.material.uniforms.op.value=0.7+0.3*Math.sin(T/140); } else targetBeam.visible=false; coreLight.intensity=coreFlash*18+(fv?5:0);
  floorMat.uniforms.t.value=T/1000; floorMat.uniforms.beat.value=beat; floorMat.uniforms.fever.value=fv?1:0; floorMat.uniforms.flare.value=flare; floorMat.uniforms.lit.value=players.map((p,i)=>Math.max(floorKick[i],1-(T-p.lastHit)/400,0)+(state==='play'&&cs===SEATS[i]?0.35+0.3*Math.sin(T/110):0));
  bloom.strength=0.32+flare*0.25+(fv?0.1:0); artWant=state==='attract'||state==='lobby'||state==='over'||state==='initials'||state==='scores'; artMat.uniforms.op.value+=((artWant?(state==='attract'?0.34:0.2):0)-artMat.uniforms.op.value)*Math.min(1,dt*1.5);
  // words
  for(let i=words.length-1;i>=0;i--){ const w=words[i], q=(T-w.t)/w.life; if(q>=1){ w.el.remove(); words.splice(i,1); continue; } let x,y; if(w.pos){ [x,y]=project(w.pos[0],1.2,w.pos[1]); } else { x=innerWidth/2; y=innerHeight*0.36; } w.el.style.transform=`translate(-50%,-50%) translate(${x}px,${y-q*40}px)`; w.el.style.opacity=1-q*q; }
  placeCamera(T,dt); composer.render();
}

