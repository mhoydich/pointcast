const ui=document.getElementById('ui'), hud=document.getElementById('hud');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function flashCard(i){ const el=document.getElementById('c'+i); el.classList.add('hit'); clearTimeout(el._t); el._t=setTimeout(()=>el.classList.remove('hit'),160); }
function scoreRows(highlight){ const week=boardMode==='week'; const src=week?(hiWeek||[]):((hiGlobal&&hiGlobal.length)?hiGlobal:hiLocal); const list=src.map(r=>[r.initials,r.score,r.round]);
  const rows=[...list,...(week?[]:HI_DEFAULT.slice(0,Math.max(0,10-list.length)).map(r=>[r[0],r[1],0]))].sort((a,b)=>b[1]-a[1]).slice(0,10);
  const ord=['1ST','2ND','3RD','4TH','5TH','6TH','7TH','8TH','9TH','10TH'], cols=['#ff8fb1','#ffb38a','#ffd27a','#c8f08f','#9fe3c9','#8fd0ff','#b9a8ff','#e3a8ff','#ffa8d8','#f4f0ff'];
  const toggle=`<div class="boards" role="tablist" aria-label="Which board"><button data-b="week" aria-pressed="${week}">THIS WEEK</button><button data-b="all" aria-pressed="${!week}">ALL TIME</button></div>`;
  const title=`THE CHOIR · ${week?'THIS WEEK':(hiGlobal&&hiGlobal.length?'ALL TIME':'THIS BROWSER')}`;
  const body=rows.length?`<table class="scores">${rows.map((r,i)=>{ const me=highlight&&highlight.some(h=>h.initials===r[0]&&h.score===r[1]); return `<tr class="${me?'me':''}" style="color:${cols[i]}"><td>${ord[i]}</td><td style="text-align:right">${String(r[1]).padStart(7,' ')}</td><td>${esc(r[0]||'???')}</td></tr>`; }).join('')}</table>`:`<p style="margin-top:18px">the week is young — be the first voice</p>`;
  return `${toggle}<div class="tag">${title}</div>${body}`; }
ui.addEventListener('click',e=>{ const b=e.target.closest('button[data-b]'); if(b){ boardMode=b.dataset.b; stateT=now(); attractT=now(); renderUI(true); tone(76,{kind:'lead',len:0.05,vel:0.4}); return; }
  if(e.target.id==='shareBtn'){ openShare(); } else if(e.target.id==='contBtn'&&state==='over'){ nextEntry(); } });
const scaleName=l=>`${NAMES[l.root]} ${l.scale.replace('pent',' pentatonic').replace('maj','major').replace('min','minor')}`;
function seatsHtml(){ return `<div class="seats">${SEATS.map(s=>{ const p=players[s.id]; return `<div class="seat ${p.human?'human':''}" style="--c:${s.hex}"><b>${s.up} · ${s.part} <small>${s.corner==='SW'?'bottom left':s.corner==='SE'?'bottom right':s.corner==='NE'?'top right':'top left'}</small></b><div class="k">${esc(s.caps[0])} &nbsp;/&nbsp; ${esc(s.caps[1])} <small>· ${esc(s.drums)}</small></div><div class="st">${p.human?'YOU — READY':'press any key here · bot for now'}</div></div>`; }).join('')}</div>`; }
