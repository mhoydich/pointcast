  <div class="row2"><button id="shCopy">copy link</button><a class="btn" id="shDl" download="brick-choir-quartet.png">download image</a><button id="shNative" hidden>share…</button><button class="ghost" id="shClose">close</button><span class="st" id="shSt"></span></div>
</div></div>

<script type="importmap" is:inline>
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js", "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/" } }
