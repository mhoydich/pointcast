PAL.forEach((p,i)=>{ p.col=new THREE.Color(p.hex); p.pan=(i%2?1:-1)*(0.2+0.1*(i>>1)); });
const BOTNAMES=['ACE','BEA','CAL','DOT','EDD','FAY','GUS','HAL'];
let players=[]; // {i,name,human,src,pid,seen,motion,frames:[[...]],col,hex,kind,rtt,streak,best,strikes,spares,gutters,skill,auto}
function mkPlayer(name,src,{pid=null,human=true,skill=0.6}={}){ const i=players.length; const pal=PAL[i%PAL.length];
  return {i,name,human,src,pid,seen:now(),motion:false,frames:[],col:pal.col,hex:pal.hex,kind:pal.kind,pan:pal.pan,rtt:0,streak:0,best:0,strikes:0,spares:0,gutters:0,skill,auto:0}; }
