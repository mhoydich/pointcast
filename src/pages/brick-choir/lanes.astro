/* ================= the alley: a key, a tempo ================= */
const PENTA=[0,2,4,7,9,12,14,16,19,21]; // the ten pins, left to right, as a xylophone
const ROOT=60, BPM=100;
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];

/* ================= the groove: under the whole night, deeper with every frame ================= */
let seqT=0, seqS=0, energy=0, crowdOn=0;
function scheduler(){
  const on=(state!=='boot'&&state!=='initials'&&state!=='scores'&&state!=='share');
  if(!ctx||!on){ seqT=0; return; }
  const spb=60/BPM, s16=spb/4; if(!seqT){ seqT=ctx.currentTime+0.06; seqS=0; }
  const soft=(state==='lobby'||state==='ready'||state==='inter'||state==='over'||demo); const e=soft?0:energy; const rootDeg=[0,0,5,7][Math.floor(seqS/16)%4];
  while(seqT<ctx.currentTime+0.12){
    const st=seqS%16, t=seqT;
    if(st%4===0) drum('kick',{t,vel:soft?0.4:0.7,bus:music});
    if(st%4===2&&!soft) drum('shaker',{t,vel:0.35,bus:music,pan:st%8===2?0.3:-0.3});
    if(e>=1&&(st===4||st===12)) drum('clap',{t,vel:0.5,bus:music});
    if(e>=1&&st%8===7) drum('hat',{t,vel:0.3,bus:music});
    if(e>=2&&(st===0||st===3||st===6||st===10)) tone(ROOT-24+rootDeg,{t,kind:'bass',len:s16*2.2,vel:0.85,bus:music});
    if(e>=3){ drum('hat',{t,vel:st%4===2?0.6:0.25,bus:music}); if(st%4===1){ const arp=[0,4,7,9][Math.floor(st/4)%4]; tone(ROOT+12+rootDeg+arp,{t,kind:'keys',len:0.06,vel:0.2,pan:st%8===1?0.4:-0.4,bus:music}); } }
    if(crowdOn>0&&(st===4||st===12)){ [0,0.012,0.03,0.05].forEach((o,i)=>drum('clap',{t:t+o,vel:0.45-i*0.08,bus:music,pan:(i%2?1:-1)*0.6})); }
    seqT+=s16; seqS++;
  }
}
const beatPhase=()=>{ if(!ctx||!seqT) return 0; const spb=60/BPM; return ((ctx.currentTime%spb)/spb); };
function snapT(){ if(!ctx) return 0; const t=ctx.currentTime; if(!seqT) return t; const s16=60/BPM/8; const k=Math.floor((seqT-t)/s16); const c=seqT-k*s16; return (c>=t&&c-t<=0.045)?c:t; }
// the extra voices: a comic trombone slide for the gutter, a crowd that cheers a strike, the ball's rumble on the boards
function slide(f0,f1,len,{t,vel=0.7,pan=0}={}){ if(!ctx||muted) return; try{ t=Math.max(t||0,ctx.currentTime); const g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=pan; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.setValueAtTime(1800,t); lp.frequency.exponentialRampToValueAtTime(500,t+len);
  [0,6,-5].forEach(d=>{ const o=ctx.createOscillator(); o.type='sawtooth'; o.detune.value=d; o.frequency.setValueAtTime(f0,t); o.frequency.exponentialRampToValueAtTime(f1,t+len*0.85); o.connect(lp); o.start(t); o.stop(t+len+0.3); });
  const vib=ctx.createOscillator(); vib.frequency.value=6; const vg=ctx.createGain(); vg.gain.value=0; vg.gain.setValueAtTime(0,t); vg.gain.linearRampToValueAtTime(f1*0.04,t+len*0.7); vib.connect(vg); lp.connect(g); g.connect(p); p.connect(sfx); p.connect(wet); vib.start(t); vib.stop(t+len+0.3);
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.16*vel,t+0.04); g.gain.setValueAtTime(0.16*vel,t+len*0.8); g.gain.exponentialRampToValueAtTime(0.0001,t+len+0.25); }catch(e){} }
function cheer(len=1.6,vel=0.8){ if(!ctx||muted) return; try{ const t=ctx.currentTime; const n=nz(len+0.2); const bf=ctx.createBiquadFilter(); bf.type='bandpass'; bf.frequency.value=1400; bf.Q.value=0.6; const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.22*vel,t+0.12); g.gain.setValueAtTime(0.22*vel,t+len*0.45); g.gain.exponentialRampToValueAtTime(0.0001,t+len); n.connect(bf); bf.connect(g); g.connect(sfx); g.connect(wet); n.start(t); n.stop(t+len+0.2);
  for(let i=0;i<10;i++) drum('clap',{t:t+0.05+i*0.09+rnd(0.03),vel:0.5-i*0.03,pan:rnd(-0.7,0.7)}); }catch(e){} }
let rumble=null; function rumbleOn(){ if(!ctx||muted||rumble) return; try{ const n=nz(4); n.loop=true; const bf=ctx.createBiquadFilter(); bf.type='lowpass'; bf.frequency.value=140; const g=ctx.createGain(); g.gain.value=0; n.connect(bf); bf.connect(g); g.connect(sfx); n.start(); rumble={n,g,bf}; }catch(e){} }
function rumbleSet(v,f){ if(!rumble) return; rumble.g.gain.setTargetAtTime(v,ctx.currentTime,0.05); rumble.bf.frequency.setTargetAtTime(f,ctx.currentTime,0.08); }
function rumbleOff(){ if(!rumble) return; const r=rumble; rumble=null; r.g.gain.setTargetAtTime(0,ctx.currentTime,0.08); setTimeout(()=>{ try{ r.n.stop(); }catch(e){} },400); }

/* ================= state ================= */
let state='boot', stateT=now(), stateNext=null, demo=false;
let FRAMES=store.get('frames',10), BUMPERS=store.get('bumpers',false), GUIDE=true;
let cur=0, frame=0, roll=0, turnN=0, upAtStart=10, lastRes=null, gameWinner=-1, lobbyEnd=0, autoT=0, myRecs=[];
let attractPanel=0, attractT=now(), hiLocal=store.get('scores',[]), hiGlobal=null, hiWeek=null, boardMode='week', entryQueue=[], entry='', entryPos=0, entryFor=null;
let camKick=0, shake=0, flare=0, swoop=0, swoopT=0, swoopKind='';
const HI_DEFAULT=[['ACE',300],['TRK',279],['SPL',256],['PIN',236],['HOK',221],['BUM',204],['LNE',188],['GTR',167],['MHO',150],['YOU',121]];
function setState(s,t){ state=s; stateT=now(); stateNext=t?{s:t.s,at:stateT+t.ms}:null; renderUI(true); PARTY.state(true); }

/* ================= the lane: a 2D rigid-body sketch under the 3D alley ================= */
const W=10.5, HW=W/2, L=72, BR=1.09, PR=0.6, PS=3.05, GUT=1.5, PIT=L+11, HOOK_FROM=0.52;
const PH={scatter:0.9,pinV:0.85,defl:0.22,dom:0.6,domN:0.35,thr:2.6,reach:0.5,spinK:2,botAim:0.6,botBase:0.14,botOff:0.1}; // the tunables of the pin sim
const PINPOS=[[0,0],[-PS/2,1],[PS/2,1],[-PS,2],[0,2],[PS,2],[-PS*1.5,3],[-PS/2,3],[PS/2,3],[PS*1.5,3]].map(([x,r])=>[x,L+r*PS*0.866]);
const XRANK=[6,3,1,7,0,4,2,8,5,9]; // pins by x, left to right: 7 4 2 8 1 5 3 9 6 10
const pins=PINPOS.map(([x,z],i)=>({i,x0:x,z0:z,x,z,vx:0,vz:0,up:true,down:false,downT:0,note:ROOT+PENTA[XRANK.indexOf(i)],ang:0,spin:0,riseT:0}));
const ball={x:0,z:-6,vx:0,vz:0,live:false,spin:0,gutter:false,bumped:0,t0:0,doneT:0,power:0,aim:0,hit:0,rot:0,hooked:false,last:null};
let knocked=[]; // the pins knocked on this roll, in order
// a full rack stands every pin up again; a sweep clears the fallen ones and leaves the rest where they stand
function rack(all){ pins.forEach(p=>{ if(all){ p.x=p.x0; p.z=p.z0; p.vx=p.vz=0; p.up=true; p.down=false; p.ang=0; p.spin=0; p.riseT=now(); } else if(p.down){ p.up=false; p.vx=p.vz=0; } }); }
const standing=()=>pins.filter(p=>p.up&&!p.down);
function launch(power,aim,spin){ power=clamp(power,0.12,1); aim=clamp(aim,-1,1); spin=clamp(spin,-1,1);
  const sp=24+power*20; ball.x=aim*1.6; ball.z=-2; ball.vz=sp; const tx=aim*HW*1.25; ball.vx=(tx-ball.x)/(L/sp); ball.spin=spin; ball.live=true; ball.gutter=false; ball.bumped=0; ball.hit=0; ball.t0=now(); ball.doneT=0; ball.power=power; ball.aim=aim; ball.hooked=false; ball.last=null; knocked=[]; }
// a step of the sim; `sim` runs silently (bots think with it, tests measure with it)
function stepLane(dt,sim){
  if(ball.live){
    if(!ball.gutter){ if(ball.z>L*HOOK_FROM){ ball.vx-=ball.spin*11*dt; if(!ball.hooked){ ball.hooked=true; if(!sim&&Math.abs(ball.spin)>0.25) onHook(); } } ball.vz*=1-0.025*dt; }
    ball.x+=ball.vx*dt; ball.z+=ball.vz*dt;
    if(!ball.gutter&&Math.abs(ball.x)>HW-BR*0.35){ if(BUMPERS&&ball.z<L-2){ ball.x=Math.sign(ball.x)*(HW-BR*0.35); ball.vx=-ball.vx*0.75; ball.bumped++; if(!sim) onBump(); } else if(ball.z<L-2||ball.hit===0){ ball.gutter=true; ball.x=Math.sign(ball.x)*(HW+GUT*0.55); ball.vx=0; if(!sim&&ball.hit===0) onGutter(); } else { ball.x=Math.sign(ball.x)*(HW-BR*0.35); ball.vx=0; } }
    if(!ball.gutter) for(const p of pins){ if(p.down||!p.up) continue; const dx=p.x-ball.x, dz=p.z-ball.z, d=Math.hypot(dx,dz); if(d<BR+PR){ const nx=dx/d, nz=dz/d; const vn=ball.vx*nx+ball.vz*nz; if(vn<=0) continue; p.vx=nx*vn*PH.pinV+rnd(-PH.scatter,PH.scatter)+ball.spin*PH.spinK; p.vz=nz*vn*PH.pinV; p.down=true; p.downT=sim?0:now(); ball.vx-=nx*vn*PH.defl; ball.vz-=nz*vn*0.07; ball.hit++; if(!sim) onKnock(p,vn); else knocked.push(p.i); } }
    if(ball.z>PIT||(ball.z>L+9&&ball.gutter)||Math.hypot(ball.vx,ball.vz)<0.8){ ball.live=false; ball.doneT=sim?1:now(); if(!sim) rumbleOff(); }
  }
  // pins in motion: they slide, they take out their neighbours, they bounce off the kickbacks and vanish into the pit
  for(const p of pins){ if(!p.down||!p.up) continue; const sp=Math.hypot(p.vx,p.vz); if(sp<0.05){ p.vx=p.vz=0; continue; }
    p.x+=p.vx*dt; p.z+=p.vz*dt; p.vx*=1-1.9*dt; p.vz*=1-1.9*dt; p.ang+=sp*dt*0.9;
    if(Math.abs(p.x)>HW+1.1){ p.x=Math.sign(p.x)*(HW+1.1); p.vx=-p.vx*0.55; } if(p.z>L+10.5||p.z<L-4){ p.up=false; continue; }
    if(sp<1.6) continue;
    for(const q of pins){ if(q===p||!q.up) continue; const dx=q.x-p.x, dz=q.z-p.z, d=Math.hypot(dx,dz); const reach=q.down?PR*2:PR*2+PH.reach; if(d>=reach||d<0.001) continue; const nx=dx/d, nz=dz/d; const rel=(p.vx-q.vx)*nx+(p.vz-q.vz)*nz; if(rel<=0) continue;
      if(!q.down){ if(rel>PH.thr){ q.down=true; q.downT=sim?0:now(); q.vx=p.vx*PH.dom+nx*rel*PH.domN+rnd(-0.8,0.8); q.vz=p.vz*PH.dom+nz*rel*PH.domN; p.vx*=0.55; p.vz*=0.55; if(!sim) onKnock(q,rel); else knocked.push(q.i); } else { p.vx-=nx*rel*0.5; p.vz-=nz*rel*0.5; } }
      else { q.vx+=nx*rel*0.5; q.vz+=nz*rel*0.5; p.vx-=nx*rel*0.5; p.vz-=nz*rel*0.5; } }
