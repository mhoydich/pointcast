---
// /brick-choir/lanes — LANES, the second sports cabinet in the Brick Choir party lane. Ten-pin bowling on the living-room
// TV; the phone is the ball. Phones join over the party relay (see /brick-choir/lanes-join): hold the phone like a ball,
// swing back and through — the release is the peak of the forward swing, the swing's strength is the speed, the lean at
// release is the aim, a wrist twist during the swing is the hook. The TV runs the lane, the pins (a small 2D rigid-body
// sim under a 3D alley) and all the sound: the ten pins are a pentatonic xylophone left to right, so the knock order plays
// a run; a strike is the full chord and the crowd; a spare answers with a phrase; a gutter is a trombone slide; a groove
// runs under the whole game and deepens with the frame; three strikes in a row is a turkey — fanfare and a camera swoop.
// One to eight players take turns (phones, keys or gamepads; bots fill a lane for league night), ten frames with a classic
// scoresheet, or five for a party. Bumpers and an aim guide for the kids (and the grandparents). Scores post to
// /api/brick-scores as game "lanes" (the bowling score). three.js 0.170 (jsDelivr). Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lanes · Brick Choir · PointCast</title>
<meta name="description" content="Bowling on the TV where your phone is the ball and every pin is a note. Swing to bowl, tilt to aim, twist for the hook. One to eight players take turns; bots fill a lane.">
<meta property="og:title" content="Lanes · Brick Choir">
<meta property="og:description" content="Your phone is the ball. Every pin is a note. A strike is a chord. Bowling for the living room.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/lanes">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og4.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a1a">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/lanes">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  /* 10-foot UI: sizes in vw (1vw = 19.2px at 1080p); everything sits inside a 4% overscan-safe frame */
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --lime:#e9ff7a; --violet:#b9a8ff; --sx:4vw; --sy:4vh;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;cursor:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;}
  canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;display:block;}

  /* ---- HUD ---- */
  #hud{position:fixed;inset:0;pointer-events:none;z-index:5;}
  /* the scoresheet: the classic grid, top centre — a row per bowler, a column per frame, the running total */
  #sheet{position:absolute;left:50%;top:var(--sy);transform:translateX(-50%);max-width:74vw;border-radius:1.1vw;overflow:hidden;background:rgba(12,10,30,.84);border:.12vw solid rgba(255,255,255,.12);box-shadow:0 1vw 3vw rgba(0,0,0,.45);}
  #sheet table{border-collapse:collapse;font:600 .95vw var(--mono);}
  #sheet th{font:700 .7vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.45);padding:.45vw .3vw .25vw;text-align:center;border-bottom:.1vw solid rgba(255,255,255,.1);} #sheet th.cur{color:var(--gold);}
  #sheet th.nm{text-align:left;padding-left:1vw;} #sheet th.tot{padding-right:1vw;}
  #sheet td{padding:0;border-bottom:.08vw solid rgba(255,255,255,.06);vertical-align:middle;} #sheet tr:last-child td{border-bottom:0;}
  #sheet td.nm{padding:.3vw .9vw .3vw 1vw;color:var(--c);white-space:nowrap;} #sheet td.nm b{font:800 1.05vw var(--display);display:block;line-height:1;} #sheet td.nm small{display:block;font:600 .55vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.45);margin-top:.18vw;}
  #sheet td.fr{width:3.1vw;border-left:.08vw solid rgba(255,255,255,.07);text-align:center;position:relative;} #sheet td.fr .m{display:flex;justify-content:flex-end;gap:.1vw;padding:.15vw .2vw 0;} #sheet td.fr .m i{font-style:normal;width:1.15vw;height:1.15vw;line-height:1.15vw;font-size:.78vw;border:.07vw solid rgba(255,255,255,.14);border-radius:.2vw;color:var(--ink);}
  #sheet td.fr .s{font:700 .95vw var(--mono);height:1.25vw;line-height:1.25vw;color:rgba(244,240,255,.85);font-variant-numeric:tabular-nums;}
  #sheet td.fr.x .m i{background:var(--c);color:#140f28;border-color:var(--c);} #sheet td.fr.sp .m i:last-child,#sheet td.fr.sp .m i:nth-child(2){background:color-mix(in oklab,var(--c) 55%,transparent);border-color:var(--c);}
  #sheet td.fr.hot{background:color-mix(in oklab,var(--c) 22%,transparent);box-shadow:inset 0 0 0 .12vw var(--c);}
  #sheet td.tot{font:800 1.3vw var(--mono);color:var(--c);padding:0 1vw 0 .8vw;text-align:right;font-variant-numeric:tabular-nums;border-left:.1vw solid rgba(255,255,255,.12);}
  #sheet tr.turn td{background:color-mix(in oklab,var(--c) 9%,transparent);} #sheet tr.turn td.nm b{text-shadow:0 0 .8vw color-mix(in oklab,var(--c) 70%,transparent);}
  #sheet tr.bot td.nm{opacity:.75;}
  /* the ten pins in the corner: standing or down, each in its note's colour */
  #pinrow{position:absolute;right:var(--sx);top:var(--sy);width:7vw;height:6vw;border-radius:1vw;background:rgba(12,10,30,.7);border:.12vw solid rgba(255,255,255,.1);}
  #pinrow i{position:absolute;left:calc(50% + var(--x) * 2.6vw);top:calc(1.1vw + (3 - var(--r)) * 1.25vw);width:1vw;height:1vw;margin-left:-.5vw;border-radius:50%;background:var(--c);box-shadow:0 0 .6vw var(--c);transition:opacity .25s,transform .25s;}
  #pinrow i.dn{opacity:.18;transform:scale(.6);box-shadow:none;}
  /* cards */
  .card{position:absolute;width:17vw;padding:.7vw .9vw .8vw;border-radius:1vw;background:rgba(12,10,30,.82);border:.12vw solid rgba(255,255,255,.1);--c:#fff;border-color:color-mix(in oklab,var(--c) 45%,transparent);box-sizing:border-box;transition:box-shadow .25s,opacity .4s;}
  .card .who{font:700 .8vw var(--mono);letter-spacing:.12em;color:var(--c);display:flex;justify-content:space-between;gap:.6vw;} .card .who em{font-style:normal;opacity:.55;font-weight:500;}
  .card .nm{font:800 1.8vw/1.1 var(--display);margin-top:.15vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .card .cb{font:700 .85vw var(--mono);color:var(--gold);min-height:1.1vw;margin-top:.2vw;letter-spacing:.06em;}
  .card .keys{font:500 .72vw var(--mono);letter-spacing:.06em;opacity:.5;margin-top:.3vw;} .card .keys kbd{font:700 .7vw var(--mono);padding:.05vw .35vw;border-radius:.3vw;border:.08vw solid rgba(255,255,255,.3);}
  #bowler{left:var(--sx);bottom:var(--sy);} #bowler.turn{box-shadow:0 0 0 .16vw var(--c),0 0 1.8vw color-mix(in oklab,var(--c) 60%,transparent);} #bowler.off{opacity:0;}
  .dials{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.6vw;margin-top:.6vw;} .dial small{display:block;font:700 .6vw var(--mono);letter-spacing:.16em;color:rgba(244,240,255,.5);margin-bottom:.25vw;}
  .dial .bar{position:relative;height:.6vw;border-radius:.3vw;background:rgba(255,255,255,.08);overflow:hidden;} .dial .bar i{position:absolute;top:0;bottom:0;background:var(--c);box-shadow:0 0 .6vw var(--c);}
  .dial .bar.aim i,.dial .bar.spin i{width:.7vw;margin-left:-.35vw;left:50%;border-radius:.35vw;transition:left .08s;} .dial .bar.pow i{left:0;width:0;transition:width .05s;} .dial .bar::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:.08vw;background:rgba(255,255,255,.25);} .dial .bar.pow::after{display:none;}
  #next{right:var(--sx);bottom:calc(var(--sy) + 8.4vw);width:15vw;} #next .list{margin-top:.4vw;display:grid;gap:.25vw;} #next .list div{display:flex;justify-content:space-between;font:700 .95vw var(--mono);color:var(--c);} #next .list div span{color:rgba(244,240,255,.6);}
  #joincard{right:var(--sx);bottom:var(--sy);width:15vw;} #joincard .qr{display:grid;grid-template-columns:auto 1fr;gap:.7vw;align-items:center;}
  #joincard .qr canvas{width:5.4vw;height:5.4vw;border-radius:.4vw;background:#fff;padding:.26vw;box-sizing:border-box;image-rendering:pixelated;display:block;}
  #joincard .qr .scan{font:800 .95vw/1.15 var(--display);color:var(--gold);} #joincard .qr .scan small{display:block;font:600 .65vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);margin-top:.3vw;text-transform:uppercase;} #joincard .qr .scan em{font-style:normal;color:var(--ink);}
  /* the bowler's name floats over the avatar */
  .tag3{position:absolute;transform:translate(-50%,-100%);font:800 1vw var(--display);color:var(--c);text-shadow:0 .1vw .6vw rgba(0,0,0,.7);white-space:nowrap;letter-spacing:.02em;text-align:center;} .tag3 small{display:block;font:600 .62vw var(--mono);letter-spacing:.14em;opacity:.7;}
  /* the room bar */
  #room{position:fixed;left:50%;bottom:var(--sy);transform:translateX(-50%);z-index:6;display:flex;align-items:center;gap:1.3vw;padding:.6vw 1.5vw .7vw;border-radius:999px;background:rgba(12,10,30,.82);border:.12vw solid rgba(255,255,255,.12);pointer-events:none;white-space:nowrap;}
  #room .lbl{font:700 .8vw var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.55);} #room .lbl b{display:block;font:500 1vw var(--display);letter-spacing:0;color:var(--ink);text-transform:none;margin-top:.15vw;}
  #room .code{font:800 3vw/1 var(--mono);letter-spacing:.22em;color:var(--gold);text-indent:.22em;text-shadow:0 0 1.6vw rgba(255,210,122,.45);}
  #room .st{display:flex;align-items:center;gap:.5vw;font:600 .75vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.55);text-transform:uppercase;}
  #room .st i{width:.65vw;height:.65vw;border-radius:50%;background:#666;box-shadow:0 0 .6vw #666;} #room .st.on i{background:var(--mint);box-shadow:0 0 .8vw var(--mint);} #room .st.connecting i,#room .st.reconnecting i{background:var(--gold);animation:blink 1s steps(2,end) infinite;} #room .st.offline i{background:var(--pink);}
  #room .n{font:700 1vw var(--mono);color:var(--mint);letter-spacing:.06em;}
  #snd{position:fixed;left:50%;bottom:calc(var(--sy) + 5.2vw);transform:translateX(-50%);z-index:7;font:700 1.05vw var(--mono);letter-spacing:.14em;color:#140f28;background:var(--gold);padding:.7vw 1.5vw;border-radius:999px;box-shadow:0 0 2vw rgba(255,210,122,.5);animation:blink 1.4s steps(2,end) infinite;pointer-events:none;}
  #words{position:fixed;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .word{position:absolute;transform:translate(-50%,-50%);font:800 1.6vw var(--display);white-space:nowrap;text-shadow:0 .1vw .8vw rgba(0,0,0,.6);will-change:transform,opacity;}
  .word.big{font-size:2.6vw;} .word.huge{font-size:5vw;letter-spacing:.02em;}

  /* ---- panels & menus ---- */
  #ui{position:fixed;inset:0;pointer-events:none;z-index:8;display:grid;place-items:center;}
  .panel{background:rgba(12,10,30,.88);border:.12vw solid rgba(255,255,255,.12);border-radius:1.6vw;padding:2vw 2.8vw;text-align:center;min-width:40vw;max-width:58vw;box-sizing:border-box;box-shadow:0 2vw 5vw rgba(0,0,0,.45);animation:pop .35s cubic-bezier(.2,.9,.3,1.2);}
  .panel.wide{max-width:72vw;} .panel.clear{background:transparent;border:0;box-shadow:none;}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(.5vw);}}
  .panel h1{margin:0;font:800 2vw var(--display);color:var(--gold);letter-spacing:-.01em;}
  .panel h2{margin:0;font:800 3.3vw/1.05 var(--display);}
  .panel h2.huge{font-size:6vw;letter-spacing:-.02em;}
  .panel p{margin:.6vw 0 0;font:500 1.25vw/1.4 var(--display);color:rgba(244,240,255,.82);}
  .panel .mono{font:600 1vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);}
  .panel .tag{display:inline-block;font:700 .95vw var(--mono);letter-spacing:.16em;color:var(--mint);}
  .blink{animation:blink 1s steps(2,end) infinite;} @keyframes blink{50%{opacity:.25;}}
  .logo{display:flex;justify-content:center;gap:.02em;font:800 7.5vw/1 var(--display);letter-spacing:-.03em;}
  .logo span{display:inline-block;background:linear-gradient(180deg,oklch(92% .12 var(--h)),oklch(72% .19 calc(var(--h) + 50)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bobl 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.22s);}
  @keyframes bobl{50%{transform:translateY(-.4vw) rotate(-2deg);}}
  .sub{font:800 1.5vw var(--display);letter-spacing:.34em;color:var(--gold);margin-top:.5vw;text-indent:.34em;} .sub small{font:700 .95vw var(--mono);letter-spacing:.3em;color:var(--mint);margin-left:1vw;vertical-align:middle;}
  .howto{display:grid;grid-template-columns:auto 1fr;gap:.7vw 1.2vw;align-items:center;margin:1.3vw auto 0;text-align:left;max-width:46vw;}
  .howto b{font:700 .95vw var(--mono);color:#140f28;background:var(--k,#fff);border-radius:999px;padding:.45vw .9vw;text-align:center;white-space:nowrap;}
  .howto span{font:500 1.2vw var(--display);}
  .lanes{display:grid;grid-template-columns:repeat(4,1fr);gap:.7vw;margin:1.2vw 0 0;}
  .lane{border-radius:1vw;padding:.7vw .9vw;border:.12vw solid color-mix(in oklab,var(--c,#fff) 40%,transparent);background:color-mix(in oklab,var(--c,#fff) 10%,transparent);text-align:left;transition:transform .2s,background .2s;--c:#fff;}
  .lane.human{background:color-mix(in oklab,var(--c) 26%,transparent);transform:scale(1.03);box-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 40%,transparent);}
  .lane.open{border-style:dashed;opacity:.6;}
  .lane b{font:700 .75vw var(--mono);letter-spacing:.2em;color:var(--c);display:block;} .lane .k{font:800 1.3vw var(--display);margin-top:.2vw;} .lane .k small{display:block;font:500 .7vw var(--mono);opacity:.6;letter-spacing:.06em;margin-top:.15vw;}
  .lane .st{font:700 .75vw var(--mono);letter-spacing:.12em;opacity:.7;margin-top:.4vw;} .lane.human .st{opacity:1;color:var(--c);}
  table.scores{margin:1vw auto 0;border-collapse:collapse;font:600 1.25vw var(--mono);}
  table.scores td{padding:.3vw .9vw;} table.scores td.dim{opacity:.45;font-size:.85vw;} table.scores tr.me td{color:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .podium{display:grid;gap:.5vw;margin:1.2vw 0 0;grid-template-columns:1fr 1fr;}
  .podium div{display:grid;grid-template-columns:2.6vw 1fr auto;gap:.8vw;align-items:center;padding:.5vw .9vw;border-radius:.9vw;background:rgba(255,255,255,.05);font:600 1.15vw var(--mono);text-align:left;}
  .podium div:first-child{background:color-mix(in oklab,var(--c) 22%,transparent);font-size:1.35vw;grid-column:1/-1;}
  .podium b{color:var(--c);} .podium b small{font:500 .7vw var(--mono);opacity:.55;margin-left:.4vw;} .podium em{font-style:normal;opacity:.55;font-size:.85vw;letter-spacing:.1em;}
  .initials{display:flex;justify-content:center;gap:1.3vw;margin:1.2vw 0 .6vw;}
  .initials b{width:5vw;height:6.2vw;border-radius:1vw;background:rgba(255,255,255,.08);display:grid;place-items:center;font:800 3.9vw var(--mono);position:relative;}
  .initials b.cur::after{content:"";position:absolute;bottom:.6vw;width:2.6vw;height:.3vw;background:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .initials b.cur::before{content:"▲";position:absolute;top:-1.3vw;font:700 .9vw var(--mono);color:var(--gold);}
  .boards{display:flex;width:max-content;gap:.3vw;margin:0 auto .8vw;padding:.25vw;border-radius:999px;background:rgba(255,255,255,.06);border:.12vw solid rgba(255,255,255,.1);}
  .boards button{font:700 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.6);background:transparent;border:0;border-radius:999px;padding:.45vw .9vw;} .boards button[aria-pressed="true"]{background:var(--gold);color:#140f28;}
  .menu{pointer-events:auto;display:flex;gap:.8vw;justify-content:center;flex-wrap:wrap;margin-top:1.4vw;}
  .menu button{font:800 1.05vw var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:rgba(255,255,255,.08);border:.15vw solid rgba(255,255,255,.18);border-radius:999px;padding:.8vw 1.7vw;transition:transform .12s,background .12s;}
  .menu button.focus{background:var(--gold);color:#140f28;border-color:var(--gold);transform:scale(1.06);box-shadow:0 0 1.6vw rgba(255,210,122,.55);}
  .okhint{font:600 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.45);margin-top:.9vw;text-transform:uppercase;}
  .okhint kbd,kbd.k{display:inline-block;font:700 .8vw var(--mono);padding:.15vw .5vw;border-radius:.4vw;border:.1vw solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:var(--ink);margin:0 .15vw;}
  .splash{font:800 7vw/1 var(--display);letter-spacing:-.02em;text-shadow:0 .3vw 2vw rgba(0,0,0,.5);animation:slam .5s cubic-bezier(.2,.9,.3,1.3);} @keyframes slam{from{transform:scale(1.6);opacity:0;}}
  .splash.turkey{animation:slam .5s cubic-bezier(.2,.9,.3,1.3),glow 1s ease-in-out infinite alternate;} @keyframes glow{to{text-shadow:0 0 3vw #ffd27a,0 .3vw 2vw rgba(0,0,0,.5);}}
  .splash small{display:block;font:700 1.4vw var(--mono);letter-spacing:.3em;color:var(--ink);margin-top:.8vw;text-shadow:none;}
  .share{display:grid;grid-template-columns:auto auto;gap:1.6vw;align-items:center;margin-top:1.2vw;text-align:left;}
  .share img{width:30vw;border-radius:.8vw;border:.12vw solid rgba(255,255,255,.14);display:block;} .share canvas{width:8vw;height:8vw;border-radius:.6vw;background:#fff;padding:.4vw;box-sizing:border-box;image-rendering:pixelated;display:block;margin:0 auto .5vw;}
  #fail{position:fixed;inset:0;display:none;place-items:center;text-align:center;z-index:30;padding:2vw;} #fail p{font:500 1.3vw var(--display);} #fail a{color:var(--gold);}
  body.embed #room,body.embed .card,body.embed #snd,body.embed #ui,body.embed #pinrow{display:none!important;} body.embed #sheet{transform:translateX(-50%) scale(1.3);transform-origin:top center;}
  @media (prefers-reduced-motion:reduce){ .logo span,.blink,table.scores tr.me td,.initials b.cur::after,#snd,#room .st i,.splash.turkey{animation:none;} }
</style>
</head>
<body>
<canvas id="gl" aria-label="Lanes: bowling on the TV — scan the card with your phone and it becomes your ball"></canvas>
<div id="hud" hidden>
  <div id="sheet"></div>
  <div id="bowler" class="card"><div class="who"><span id="bwUp">1UP</span><em id="bwSrc"></em></div><div class="nm" id="bwName">—</div><div class="cb" id="bwCue"></div>
    <div class="dials"><div class="dial"><small>AIM</small><div class="bar aim"><i id="dAim"></i></div></div><div class="dial"><small>POWER</small><div class="bar pow"><i id="dPow"></i></div></div><div class="dial"><small>HOOK</small><div class="bar spin"><i id="dSpin"></i></div></div></div>
    <div class="keys" id="bwKeys"></div></div>
  <div id="next" class="card"><div class="who"><span>UP NEXT</span><em id="nxFrame"></em></div><div class="list" id="nxList"></div></div>
  <div id="joincard" class="card"><div class="qr"><canvas width="33" height="33"></canvas><div class="scan">SCAN TO <em>GRAB A LANE</em><small id="joinSub">room ····</small></div></div><div class="keys">or press <kbd>K</kbd> for keys · <kbd>A</kbd> on a gamepad</div></div>
  <div id="pinrow" aria-hidden="true"></div>
  <div id="tags"></div>
</div>
<div id="room"><div class="lbl">BALL UP ON YOUR PHONE<b id="roomUrl">pointcast.xyz/brick-choir/lanes-join</b></div><div class="code" id="roomCode">····</div><div class="st connecting" id="roomSt"><i></i><span id="roomStTxt">connecting</span></div><div class="n" id="roomN"></div></div>
<div id="snd" hidden>PRESS OK ON THE REMOTE TO TURN ON THE SPEAKERS</div>
<div id="words"></div>
<div id="ui"></div>
<div id="fail"><p>Lanes needs WebGL and a working connection to load three.js.<br><a href="/brick-choir">Back to the arcade →</a></p></div>

<script type="importmap" is:inline>
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js", "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/" } }
