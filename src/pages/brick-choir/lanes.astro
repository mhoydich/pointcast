const settled=()=>!ball.live&&pins.every(p=>!p.down||!p.up||Math.hypot(p.vx,p.vz)<0.6);
// a silent roll on a copy of the rack: what would this shot knock down?
function simulate(power,aim,spin){ const save=pins.map(p=>({...p})); const sb={...ball}; const sk=knocked; launch(power,aim,spin); let n=0; while((ball.live||!settled())&&n<600){ stepLane(1/120,true); n++; } const res={down:pins.filter(p=>p.down).length,gutter:ball.gutter,order:knocked.slice()}; pins.forEach((p,i)=>Object.assign(p,save[i])); Object.assign(ball,sb); knocked=sk; return res; }

/* ================= sound of the lane ================= */
function onKnock(p,v){ const t=snapT(); const vel=clamp(0.5+v/30,0.5,1); tone(p.note,{t,kind:'marimba',vel,len:0.12,pan:p.x/HW*0.7}); if(knocked.length===0) drum('tom',{t,vel:0.6,pan:p.x/HW*0.5}); else drum('pop',{t,vel:0.35,pan:p.x/HW*0.5}); knocked.push(p.i); pinFx(p); flare=Math.min(1,flare+0.25); shake=Math.max(shake,0.25); }
function onHook(){ drum('shaker',{vel:0.5,pan:-ball.spin*0.5}); }
function onBump(){ const p=players[cur]; tone(ROOT-12+(ball.bumped%2?7:5),{kind:'pluck',vel:0.6,len:0.08,pan:Math.sign(ball.x)*0.7}); word('bump',toScreen(ball.x,2,ball.z),{color:'#fff3c4'}); }
function onGutter(){ slide(233,98,0.75,{vel:0.8,pan:Math.sign(ball.x)*0.6}); word('gutter…',toScreen(ball.x,3,ball.z),{color:'rgba(244,240,255,.7)',big:true}); players[cur].gutters++; PARTY.ev(cur,'g'); }

/* ================= scoring: the classic sheet ================= */
const isLast=f=>f===FRAMES-1;
function frameDone(fr,f){ const r=fr[f]; if(!r) return false; if(isLast(f)) return r.length===3||(r.length===2&&r[0]+r[1]<10); return r[0]===10||r.length===2; }
function sheetOf(p){ const fr=p.frames, out=[]; let total=0; const rolls=[]; fr.forEach(f=>rolls.push(...f)); let ri=0;
  for(let f=0;f<FRAMES;f++){ if(ri>=rolls.length){ out.push(null); continue; }
    if(isLast(f)){ const fl=fr[f]||[]; if(!frameDone(fr,f)){ out.push(null); continue; } total+=fl.reduce((a,b)=>a+b,0); out.push(total); continue; }
    if(rolls[ri]===10){ if(ri+2<rolls.length){ total+=10+rolls[ri+1]+rolls[ri+2]; out.push(total); } else out.push(null); ri+=1; }
    else if(ri+1<rolls.length&&rolls[ri]+rolls[ri+1]===10){ if(ri+2<rolls.length){ total+=10+rolls[ri+2]; out.push(total); } else out.push(null); ri+=2; }
    else if(ri+1<rolls.length){ total+=rolls[ri]+rolls[ri+1]; out.push(total); ri+=2; }
    else { out.push(null); break; } }
  while(out.length<FRAMES) out.push(null); return out; }
const totalOf=p=>{ const s=sheetOf(p); let t=0; for(const v of s) if(v!==null) t=v; return t; };
// the score if every open roll counted as it stands (for the phone, the podium mid-game): the same thing, plus pending pins
const liveTotal=p=>{ let t=totalOf(p); const s=sheetOf(p); p.frames.forEach((f,i)=>{ if(s[i]===null) t+=f.reduce((a,b)=>a+b,0); }); return t; };
function marks(fr,f){ const r=fr[f]||[]; const m=[]; if(isLast(f)){ r.forEach((v,i)=>{ const sp=(i===1&&r[0]!==10&&r[0]+v===10)||(i===2&&r[0]===10&&r[1]!==10&&r[1]+v===10); m.push(sp?'/':v===10?'X':v===0?'-':String(v)); }); return m; }
  if(r[0]===10) return ['','X']; if(r.length===2) return [r[0]===0?'-':String(r[0]),r[0]+r[1]===10?'/':(r[1]===0?'-':String(r[1]))]; if(r.length===1) return [r[0]===0?'-':String(r[0]),'']; return ['','']; }
const streakName=n=>n>=6?`${['','','','','','','SIX','SEVEN','EIGHT','NINE','TEN','ELEVEN','TWELVE'][n]||n}-BAGGER`:n===5?'FIVE-BAGGER':n===4?'HAMBONE':n===3?'TURKEY':n===2?'DOUBLE':'STRIKE';

/* ================= the night: turns, frames, results ================= */
function startGame(){ players.forEach(p=>{ p.frames=[]; p.streak=0; p.best=0; p.strikes=0; p.spares=0; p.gutters=0; p.auto=0; }); cur=0; frame=0; roll=0; turnN=0; gameWinner=-1; myRecs=[]; seqT=0; energy=0; crowdOn=0;
  if(!demo&&humans().length===1&&players.length===1) addBot(); // league night: nobody bowls alone
  rack(true); setState('ready',{s:'firstTurn',ms:2600}); jingle([0,4,7,12].map(x=>ROOT+x),0.1,'lead'); }
function firstTurn(){ beginTurn(); }
function beginTurn(){ const p=players[cur]; if(!p){ return; } roll=(p.frames[frame]||[]).length; if(roll===0) p.frames[frame]=[];
  const fr=p.frames[frame];
  if(roll===0) rack(true); else if(isLast(frame)&&(fr[roll-1]===10||(roll===2&&fr[0]+fr[1]===10))) rack(true); else rack(false);
  ball.live=false; ball.x=0; ball.z=-6; ball.gutter=false; knocked=[]; pins.forEach(p=>{ p.was=p.up&&!p.down; }); upAtStart=standing().length; energy=clamp(Math.floor(frame/FRAMES*3.99),0,3); crowdOn=0;
  p.plan=null; setState('aim'); autoT=now()+(p.human?(demo?0:26000):rnd(1400,2600)); turnN++;
  if(roll===0){ word(`${p.name}'S UP`,[50,34],{color:p.hex,huge:true}); if(!demo) tone(ROOT+12,{kind:p.kind,vel:0.6,len:0.1,pan:p.pan}); }
  else word(roll===1?'SECOND BALL':'BONUS BALL',[50,36],{color:p.hex,big:true});
  PARTY.ev(cur,'ur'); aimPreview.aim=0; aimPreview.spin=0; aimPreview.on=false; }
function bowl(idx,{power=0.7,aim=0,spin=0,src='key'}={}){ if(state==='roll'&&idx===cur&&src==='phone'&&now()-ball.t0<320&&ball.hit===0&&power>ball.power*1.2){ launch(power,aim,spin); return true; } /* the better swing, a beat later */
  if(state!=='aim'||idx!==cur) return false; const p=players[idx];
  launch(power,aim,spin); setState('roll'); rumbleOn(); drum('kick',{vel:0.6}); tone(ROOT-12,{kind:'bass',len:0.2,vel:0.5}); word(src==='auto'?'auto bowl':power>0.85?'BIG SWING':'', [50,60],{color:p.hex}); PARTY.ev(idx,'rl'); camKick=0.6; return true; }
function endRoll(){ const p=players[cur]; const down=pins.filter(x=>x.was&&x.down).length; const n=clamp(down,0,upAtStart); const fr=p.frames[frame]; const fresh=roll===0||(isLast(frame)&&(roll===1?fr[0]===10:(fr[1]===10||(fr[0]!==10&&fr[0]+fr[1]===10)))); fr.push(n);
  const strike=n===10&&upAtStart===10&&fresh; const spare=!strike&&n===upAtStart&&n>0&&roll>=1; const gutter=n===0&&ball.gutter;
  let kind='open', txt='', sub='';
  if(strike){ p.streak++; p.strikes++; p.best=Math.max(p.best,p.streak); kind=p.streak>=3?'turkey':'strike'; txt=streakName(p.streak); sub=p.streak>1?`${p.streak} in a row`:'all ten'; }
  else { p.streak=0; if(spare){ p.spares++; kind='spare'; txt='SPARE!'; sub='picked it up'; } else if(gutter){ kind='gutter'; txt='GUTTER'; sub='it happens'; } else { txt=n===0?'NOTHING':n===1?'ONE PIN':`${n} PINS`; sub=upAtStart-n>0&&!frameDone(p.frames,frame)?`${upAtStart-n} to go`:''; } }
  lastRes={kind,txt,sub,n,p:cur}; const t=ctx?ctx.currentTime+0.03:0;
  if(kind==='strike'||kind==='turkey'){ [0,4,7,12,16,19,24].forEach((d,i)=>tone(ROOT+d,{t:t+i*0.03,kind:i%2?'bell':p.kind,vel:0.9,len:0.6,pan:p.pan})); drum('crash',{t,vel:0.5}); cheer(kind==='turkey'?2.6:1.6,kind==='turkey'?1:0.8); crowdOn=1; flare=1; camKick=1; shake=0.8; swoop=1; swoopT=now(); swoopKind=kind; PARTY.ev(cur,kind==='turkey'?'tk':'x');
    if(kind==='turkey') setTimeout(()=>{ jingle([ROOT+7,ROOT+7,ROOT+7,ROOT+12,ROOT+16,ROOT+19,ROOT+24],0.11,'lead',p.pan); drum('crash',{vel:0.6}); },500); }
  else if(kind==='spare'){ jingle([ROOT+9,ROOT+7,ROOT+4,ROOT+7,ROOT+12],0.1,p.kind,p.pan); drum('clap',{t,vel:0.6}); drum('clap',{t:t+0.12,vel:0.5}); flare=0.6; PARTY.ev(cur,'sp'); }
  else if(kind==='gutter'){ PARTY.ev(cur,'g'); }
  else { PARTY.ev(cur,'k'+n); if(n>=7) drum('clap',{t,vel:0.4}); }
  setState('result',{s:'nextRoll',ms:kind==='turkey'?3800:kind==='strike'?3000:kind==='spare'?2600:2100}); PARTY.state(true); }
function nextRoll(){ const p=players[cur]; if(frameDone(p.frames,frame)){ cur++; if(cur>=players.length){ cur=0; frame++; if(frame>=FRAMES){ gameOver(); return; } if(FRAMES>=10&&frame===Math.floor(FRAMES/2)&&!demo){ startInter(); return; } } } beginTurn(); }
function startInter(){ setState('inter',{s:'afterInter',ms:7000}); jingle([ROOT+4,ROOT+7,ROOT+12],0.12,'bell'); }
function afterInter(){ beginTurn(); }
function gameOver(){ const ranked=[...players].sort((a,b)=>totalOf(b)-totalOf(a)); gameWinner=ranked[0].i; const W=players[gameWinner]; const t=ctx?ctx.currentTime+0.05:0;
  [0,4,7,12,16,19,24].forEach((d,i)=>tone(ROOT+d,{t:t+i*0.08,kind:i%2?'bell':W.kind,vel:0.9,len:0.4,pan:W.pan})); drum('crash',{t,vel:0.5}); cheer(2.2,0.9); crowdOn=1;
  if(demo){ setState('over',{s:'restartDemo',ms:5000}); return; }
  setState('over'); entryQueue=humans().filter(p=>totalOf(p)>0&&qualifies(totalOf(p))).map(p=>({...p,score:totalOf(p)})); PARTY.results(); focusMenu(); }
function restartDemo(){ toAttract(); }
function qualifies(sc){ if(sc<=0) return false; return [hiWeek,(hiGlobal||[]).length?hiGlobal:hiLocal].some(l=>!l||l.length<10||sc>Math.min(...l.map(r=>r.score))); }
async function submitScore(initials,p){ const rec={initials,score:p.score,round:FRAMES,at:Date.now(),game:'lanes'}; myRecs.push(rec); hiLocal=[...hiLocal,rec].sort((a,b)=>b.score-a.score).slice(0,10); store.set('scores',hiLocal); postScore({initials,score:p.score,round:FRAMES,game:'lanes'},0); nextEntry(); }
async function postScore(body,attempt){ try{ const r=await fetch('/api/brick-scores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) hiGlobal=j.scores; if(Array.isArray(j.weekScores)) hiWeek=j.weekScores; renderUI(true); return; } if(r.status===429&&attempt<4) setTimeout(()=>postScore(body,attempt+1),62000*(attempt+1)); }catch(e){} }
function nextEntry(){ const p=entryQueue.shift(); if(p){ if(p.src==='phone'&&p.name){ submitScore(p.name.slice(0,3),p); return; } entryFor=p; entry=''; entryPos=0; setState('initials'); } else { boardMode='week'; setState('scores'); focusMenu(); } }
async function loadScores(){ const get=async q=>{ try{ const r=await fetch('/api/brick-scores'+q); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) return j.scores; } }catch(e){} return null; };
  const [a,w]=await Promise.all([get('?game=lanes'),get('?period=week&game=lanes')]); if(a) hiGlobal=a; if(w) hiWeek=w; renderUI(true); }

/* ================= lobby & attract ================= */
function startLobby(){ demo=false; players=players.filter(p=>p.human); reindex(); ball.live=false; rack(true); setState('lobby'); lobbyEnd=now()+20000; focusMenu(); PARTY.roster(); }
function addBot(){ if(players.length>=MAXP) return null; const used=new Set(players.map(p=>p.name)); const nm=BOTNAMES.find(n=>!used.has(n))||'BOT'; const b=mkPlayer(nm,'bot',{human:false,skill:rnd(0.15,0.6)}); players.push(b); word(`${nm} the bot grabs a lane`,[50,62],{color:b.hex}); if(state==='lobby') lobbyEnd=Math.max(lobbyEnd,now()+6000); PARTY.roster(); return b; }
function toAttract(){ players=players.filter(p=>p.src==='phone'); reindex(); demo=true; attractPanel=0; attractT=now(); myRecs=[]; seqT=0;
  while(players.length<3) addBot(); players.forEach(p=>{ p.frames=[]; p.streak=0; }); startGame(); PARTY.roster(); }

/* ================= bots: a decent league bowler with an off night now and then ================= */
function botThink(p){ const up=standing(); const righty=p.i%2===0; const power=rnd(0.6,0.9); const full=up.length===10; const spin=full?(righty?1:-1)*rnd(0.3,0.6):rnd(-0.1,0.1);
  // it looks down the lane (a few silent rolls of the sim) and picks the line that takes the most wood; then its skill blurs it
  const cands=[]; if(full){ for(let a=-0.6;a<=0.61;a+=0.1) cands.push(a); } else { const cx=up.reduce((a,q)=>a+q.x,0)/up.length; const c0=clamp(cx/(HW*1.25),-0.8,0.8); for(let a=c0-0.4;a<=c0+0.41;a+=0.08) cands.push(clamp(a,-0.85,0.85)); }
  let best=null; for(const a of cands){ const r=simulate(power,a,spin); const sc=r.down+(r.gutter?-5:0)+rnd(0.4); if(!best||sc>best.sc) best={aim:a,sc}; }
  let aim=best.aim+rnd(-1,1)*((1-p.skill)*PH.botAim+PH.botBase); if(Math.random()<PH.botOff*(1.5-p.skill)) aim+=rnd(-0.6,0.6); // the off ball
  return {power:clamp(power+rnd(-1,1)*(1-p.skill)*0.2,0.3,1),aim:clamp(aim,-1,1),spin}; }
function bots(T){ if(state!=='aim') return; const p=players[cur]; if(!p) return;
  if(!p.human){ if(!p.plan) p.plan=botThink(p); if(T>=autoT){ const s=p.plan; p.plan=null; aimPreview.on=false; bowl(cur,{...s,src:'bot'}); } else if(T>autoT-900&&!aimPreview.on){ aimPreview.aim=p.plan.aim; aimPreview.spin=p.plan.spin; aimPreview.power=p.plan.power; aimPreview.on=true; } }
  else if(T>=autoT){ p.auto++; const s=botThink({...p,skill:0.5}); word('the lane bowls for you',[50,60],{color:'rgba(244,240,255,.6)'}); bowl(cur,{...s,src:'auto'}); } }
const aimPreview={aim:0,spin:0,power:0.7,on:false,at:0}; // what the TV draws down the lane while you line it up
function setAim(idx,aim,spin,power){ if(idx!==cur||state!=='aim') return; aimPreview.aim=clamp(+aim||0,-1,1); aimPreview.spin=clamp(+spin||0,-1,1); if(power!==undefined) aimPreview.power=clamp(+power,0,1); aimPreview.on=true; aimPreview.at=now(); }
// the guide: where the ball would go (the straight part, then the hook) — a forgiving hint, drawn as dots
function guidePath(aim,spin,power=0.7){ const sp=24+power*20; const pts=[]; let x=aim*1.6, z=-2, vx=(aim*HW*1.25-x)/(L/sp), vz=sp; const dt=1/30; for(let i=0;i<90;i++){ if(z>L*HOOK_FROM) vx-=spin*11*dt; vz*=1-0.025*dt; x+=vx*dt; z+=vz*dt; if(Math.abs(x)>HW-BR*0.35){ if(BUMPERS&&z<L-2){ x=Math.sign(x)*(HW-BR*0.35); vx=-vx*0.75; } else { pts.push([Math.sign(x)*(HW+GUT*0.55),z]); break; } } pts.push([x,z]); if(z>L-1) break; } return pts; }

/* ================= tick: fixed 120 Hz substeps ================= */
let lastT=now(), acc=0; const STEP=1/120;
function tick(T){
  if(demo&&T-attractT>9000){ attractT=T; attractPanel=(attractPanel+1)%4; if(attractPanel===3) loadScores(); }
  acc+=Math.min(0.6,(T-lastT)/1000); lastT=T; let n=0;
  while(acc>=STEP&&n<80){ acc-=STEP; n++; const Ts=T-acc*1000; substep(STEP,Ts); }
  flare*=Math.pow(0.08,n*STEP); shake*=Math.pow(0.02,n*STEP); camKick*=Math.pow(0.05,n*STEP); if(crowdOn>0&&state!=='result'&&state!=='over') crowdOn=0;
  scheduler(); PARTY.tick(T);
}
function substep(dt,T){
  if(stateNext&&T>=stateNext.at){ const s=stateNext.s; stateNext=null; ({firstTurn,nextRoll,afterInter,restartDemo})[s](); }
  if(state==='lobby'&&T>=lobbyEnd&&humans().length) startGame();
  bots(T);
  if(state==='roll'||state==='result'||state==='aim'){ stepLane(dt,false);
    if(state==='roll'){ if(ball.live){ rumbleSet(0.10+ball.power*0.12,90+ball.vz*3); ball.rot+=ball.vz*dt/BR; } if(!ball.live&&settled()&&T-ball.doneT>350) endRoll(); else if(!ball.live&&T-ball.doneT>2400) endRoll(); } }
}

/* ================= the room: a code, one QR card, phones as balls ================= */
const ALPHA='ABCDEFGHJKMNPQRSTUVWXYZ';
const ROOM=(()=>{ const q=new URLSearchParams(location.search).get('room'); if(q&&/^[A-Za-z]{4}$/.test(q)) return q.toUpperCase(); const a=new Uint32Array(4); crypto.getRandomValues(a); return Array.from(a,v=>ALPHA[v%ALPHA.length]).join(''); })();
const JOIN_URL=`${location.origin}/brick-choir/lanes-join?room=${ROOM}`;
document.getElementById('roomCode').textContent=ROOM; document.getElementById('roomUrl').textContent=location.host.replace(/^www\./,'')+'/brick-choir/lanes-join'; document.getElementById('joinSub').textContent='room '+ROOM;
function drawQr(cv,text){ const m=qr(text,1), Q=2, S=m.size+Q*2; cv.width=cv.height=S; const g=cv.getContext('2d'); g.fillStyle='#fff'; g.fillRect(0,0,S,S); g.fillStyle='#0b0a1a'; for(let y=0;y<m.size;y++) for(let x=0;x<m.size;x++) if(m.get(x,y)) g.fillRect(x+Q,y+Q,1,1); }
drawQr(document.querySelector('#joincard canvas'),JOIN_URL);
const PARTY=(()=>{
  const X={net:null,status:'off',transport:null,lastSt:'',lastStT:0,evq:[],evT:0,pruneT:0};
  const setStatus=(s,t)=>{ X.status=s; X.transport=t; const el=document.getElementById('roomSt'); el.className='st '+s; document.getElementById('roomStTxt').textContent=s==='on'?(t==='drum'?'live':'live · relay'):s; };
  const seatOf=id=>players.find(p=>p.pid===id)||null;
  function assign(id,name){
    const cur_=seatOf(id); if(cur_){ if(name&&cur_.name!==name) cur_.name=name; return cur_; }
    if(players.length>=MAXP){ const bot=players.find(p=>!p.human&&(state==='lobby'||demo)); if(!bot) return null; players.splice(bot.i,1); reindex(); }
    const p=mkPlayer(name,'phone',{pid:id}); players.push(p);
    if(demo){ /* a phone joining a party-mode game: bench a bot, keep the frames flowing */ }
    jingle([0,4,7,12].map(x=>ROOT+x),0.08,p.kind,p.pan); word(`${name} grabs a lane!`,[50,62],{big:true,color:p.hex});
    if(demo){ startLobby(); } else if(state==='lobby'){ lobbyEnd=Math.max(lobbyEnd,now()+10000); } else if(state!=='over'&&state!=='scores'&&state!=='initials'){ p.frames=[]; for(let f=0;f<frame;f++) p.frames.push(isLast(f)?[0,0]:[0,0]); /* a late joiner starts with open frames */ }
    return p;
  }
  function drop(id){ const p=seatOf(id); if(!p) return; word(`${p.name} leaves the lane`,[50,62],{color:p.hex}); if(state==='lobby'||demo||state==='over'||state==='scores'){ players.splice(p.i,1); reindex(); if(demo) while(players.length<3) addBot(); if(cur>=players.length) cur=0; } else { p.human=false; p.src='bot'; p.pid=null; p.name=p.name+'·'; p.skill=0.5; if(state==='aim'&&cur===p.i) autoT=now()+1500; } X.roster(); }
  function cmd(c){ if(c==='start'){ if(demo) startLobby(); else if(state==='lobby') startGame(); } else if(c==='again'){ if(state==='over') nextEntry(); else if(state==='scores') startLobby(); } else if(c==='party'){ if(state==='scores'||state==='over') toAttract(); } else if(c==='skip'){ if(state==='inter'){ stateNext=null; afterInter(); } } else if(c==='bot'){ if(state==='lobby') addBot(); } }
  X.onFrame=d=>{ if(!d||typeof d!=='object'||d.o==='tv') return; const id=d.p; if(typeof id!=='string'||!id||id.length>12) return; const p=seatOf(id); if(p) p.seen=now();
    switch(d.f){
      case 'hi': X.roster(); X.state(true); if(p) X.ok(p); break;
      case 'j': { const name=String(d.n||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3)||'???'; const q=assign(id,name); if(!q){ X.send({f:'full',p:id}); break; } X.ok(q); X.roster(); X.state(true); break; }
      case 'bw': { if(!p){ X.send({f:'who',p:id}); break; } bowl(p.i,{power:+d.w||0.6,aim:+d.a||0,spin:+d.s||0,src:'phone'}); break; }
      case 'ai': if(p) setAim(p.i,+d.a||0,+d.s||0,d.w===undefined?undefined:+d.w); break;
      case 'arm': if(p){ p.motion=!!d.m; } break;
      case 'l': drop(id); break;
      case 'pp': X.send({f:'pq',p:id,t:d.t}); if(p&&typeof d.r==='number') p.rtt=d.r; break;
      case 'cmd': if(p) cmd(String(d.c||'')); break;
    } };
  X.send=d=>!!(X.net&&X.net.send(d));
  X.ok=p=>X.send({f:'ok',p:p.pid,s:p.i,n:p.name,c:p.hex});
  X.roster=()=>X.send({f:'ro',s:players.map(p=>p.name),k:players.map(p=>p.human?(p.src==='phone'?1:2):0)});
  X.state=force=>{ const s={f:'st',ph:demo?'attract':state,fr:frame,rl:roll,tn:(state==='aim'||state==='roll'||state==='result')?cur:-1,n:players.length,t:players.map(p=>liveTotal(p)),nf:FRAMES};
    const key=JSON.stringify(s), T=now(), minIv=X.transport==='room'?400:100; if(!force){ if(key===X.lastSt&&T-X.lastStT<1000) return; if(T-X.lastStT<minIv) return; } X.lastSt=key; X.lastStT=T; X.send(s); };
  X.ev=(seat,e)=>{ const p=players[seat]; if(!p||!p.human||p.src!=='phone') return; X.evq.push([seat,e]); if(X.evq.length>24) X.evq.splice(0,X.evq.length-24); };
  X.tick=T=>{ const iv=X.transport==='room'?150:50; if(X.evq.length&&T-X.evT>=iv){ X.evT=T; X.send({f:'ev',l:X.evq.splice(0,8)}); } X.state(false);
    if(T-X.pruneT>2000){ X.pruneT=T; players.forEach(p=>{ if(p.src==='phone'&&T-p.seen>45000) drop(p.pid); }); const n=phones().length; const el=document.getElementById('roomN'); const txt=n?`${n} BALL${n>1?'S':''}`:''; if(el.textContent!==txt) el.textContent=txt; } };
  X.results=()=>X.send({f:'res',sc:players.map(p=>totalOf(p)),w:gameWinner,x:players.map(p=>p.strikes)});
  X.start=()=>{ if(ATTRACT_ONLY){ document.body.classList.add('embed'); return; } X.net=makeParty({code:ROOM,pid:'tv',onFrame:X.onFrame,onStatus:setStatus}); };
  X.drop=drop; X.seatOf=seatOf; return X;
})();
const sndEl=document.getElementById('snd'); setInterval(()=>{ sndEl.hidden=!!(ctx&&ctx.state==='running')||state==='boot'; },400);
/* ================= three.js: the alley from behind the bowler ================= */
const cv=document.getElementById('gl');
let renderer; try{ renderer=new THREE.WebGLRenderer({canvas:cv,antialias:false,powerPreference:'high-performance'}); }catch(e){ document.getElementById('fail').style.display='grid'; throw e; }
renderer.setPixelRatio(Math.min(2,devicePixelRatio||1)); renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.05;
const scene=new THREE.Scene(); scene.background=new THREE.Color(0x0b0a1a); scene.fog=new THREE.Fog(0x0b0a1a,90,190);
const camera=new THREE.PerspectiveCamera(38,1,0.5,320);
scene.add(new THREE.HemisphereLight(0x9a90ff,0x1a1030,0.5));
const sun=new THREE.DirectionalLight(0xfff0e0,1.8); sun.position.set(-10,40,20); scene.add(sun);
const rim=new THREE.DirectionalLight(0x8fd0ff,0.7); rim.position.set(20,14,L+40); scene.add(rim);
const deckLight=new THREE.PointLight(0xb9a8ff,1.4,40,2); deckLight.position.set(0,7,L+4); scene.add(deckLight);
const ballLight=new THREE.PointLight(0xffffff,0,16,2); scene.add(ballLight);
try{ const pm=new THREE.PMREMGenerator(renderer); scene.environment=pm.fromScene(new RoomEnvironment(),0.04).texture; pm.dispose(); }catch(e){}
const LITE=/[?&]lite\b/.test(location.search); if(LITE) renderer.setPixelRatio(1);
const composer=new EffectComposer(renderer); composer.addPass(new RenderPass(scene,camera));
const bloom=new UnrealBloomPass(new THREE.Vector2(640,360),0.45,0.4,0.86); if(!LITE) composer.addPass(bloom); composer.addPass(new OutputPass());

// the floor: our lane (boards, arrows, dots, foul line, gutters), the neighbours dimmer, the approach, a beat ring from the pins
const LANE_PITCH=W+GUT*2+1.2;
const floorMat=new THREE.ShaderMaterial({uniforms:{t:{value:0},beat:{value:0},flare:{value:0},bp:{value:new THREE.Vector2(0,-6)},bl:{value:0},col:{value:new THREE.Color('#ffd27a')},bump:{value:0},L:{value:L},W:{value:W},G:{value:GUT},P:{value:LANE_PITCH}},
  vertexShader:`varying vec2 vP; void main(){ vP=vec2(position.x,-position.y); gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }`,
  fragmentShader:`uniform float t,beat,flare,bl,bump,L,W,G,P; uniform vec3 col; uniform vec2 bp; varying vec2 vP;
    float ln(float d,float w){ return smoothstep(w,w*0.3,abs(d)); }
    float tri(vec2 p,float s){ p.y=-p.y; float a=step(abs(p.x)*1.7,p.y)*step(p.y,s); return a; }
    void main(){ vec2 p=vP; float hw=W*0.5; float lane=floor((p.x+P*0.5)/P); float lx=p.x-lane*P; float mine=1.0-min(1.0,abs(lane));
      vec3 c=vec3(0.012,0.011,0.03);
      float onLane=step(abs(lx),hw)*step(-0.5,p.y)*step(p.y,L+10.0); float gut=step(hw,abs(lx))*step(abs(lx),hw+G)*step(-0.5,p.y)*step(p.y,L+10.0);
      float approach=step(abs(lx),hw+G)*step(p.y,-0.5)*step(-30.0,p.y);
      // boards: 39 of them, a soft grain
      float board=fract(lx*(39.0/W)); float seam=ln(board-0.5,0.06)*0.5; float grain=0.5+0.5*sin(lx*40.0+sin(p.y*0.35)*2.0);
      vec3 wood=mix(vec3(0.09,0.075,0.19),vec3(0.15,0.125,0.27),grain*0.5)*(1.0-seam*0.4);
      wood*=mix(0.32,1.0,mine); wood+=mine*vec3(0.03,0.02,0.05);
      c=mix(c,wood,onLane);
      float edge=(ln(abs(lx)-hw,0.12)+ln(abs(lx)-hw-G,0.1)*0.5)*step(-0.5,p.y)*step(p.y,L+10.0); c+=vec3(0.75,0.7,1.0)*edge*(0.35+0.45*mine);
      // the oil: a sheen on the front half of the lane, our lane only
      c+=mine*onLane*vec3(0.07,0.06,0.12)*smoothstep(L*0.6,0.0,p.y)*(0.6+0.4*sin(lx*0.9+t*0.3));
      c=mix(c,vec3(0.03,0.025,0.06),gut); c=mix(c,vec3(0.06,0.05,0.10)*(0.5+0.5*mine),approach);
      // arrows and dots (the range finders), the foul line, the pin deck
      float ar=0.0; for(int i=-3;i<=3;i++){ float ax=float(i)*(W/7.0); float az=15.0+abs(float(i))*1.2; ar+=tri(vec2(lx-ax,p.y-az),1.6); }
      c+=vec3(0.95,0.9,1.0)*ar*0.5*mine*onLane;
