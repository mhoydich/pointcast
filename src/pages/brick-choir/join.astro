---
// /brick-choir/join — the phone controller for Brick Choir: TV. Scan a corner of the TV (or type its four-letter room
// code), pick a three-letter arcade name, take a corner, and your phone becomes that seat: the same ten notes as the
// corner's ten keys, in the seat's colour, plus a drum strip. No audio here — the TV is the speaker; only taps travel.
// Haptics (navigator.vibrate) when it is your note, an edge flash where there is no vibrator (iOS), a wake lock so the
// screen stays on, the same pid across sleeps so the TV gives the seat back. Two phones per seat = a duet, eight in all.
// Transport: the shared party client (drum-room Durable Object relay, presence-room fallback). Built 2026-09-23 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Brick Choir: join the TV · PointCast</title>
<meta name="description" content="Your phone is the controller. Scan a corner of the TV running Brick Choir and take a seat in the Quartet.">
<meta property="og:title" content="Brick Choir: join the TV">
<meta property="og:description" content="Scan a corner, take a seat. Your phone is the controller; the TV is the stage.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/join">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og4.jpg">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0b0a1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/join">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --c:#ffd27a;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;overscroll-behavior:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;}
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;touch-action:manipulation;}
  #app{position:fixed;inset:0;display:flex;flex-direction:column;padding:calc(14px + env(safe-area-inset-top,0px)) 16px calc(14px + env(safe-area-inset-bottom,0px));box-sizing:border-box;}
  .screen{flex:1;display:flex;flex-direction:column;gap:12px;min-height:0;animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.97) translateY(6px);}}
  .logo{display:flex;justify-content:center;font:800 clamp(30px,10vw,44px)/1 var(--display);letter-spacing:-.02em;margin-top:8px;}
  .logo span{background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;} .logo i{width:.3em;}
  .sub{text-align:center;font:800 12px var(--mono);letter-spacing:.3em;color:var(--gold);text-indent:.3em;}
  .lead{margin:6px 0 0;text-align:center;font:500 15px/1.4 var(--display);color:rgba(244,240,255,.75);} .lead b{color:var(--ink);font-weight:700;}
  .lbl{font:700 12px var(--mono);letter-spacing:.2em;color:var(--mint);margin-top:8px;} .lbl small{display:block;font:500 11px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.5);margin-top:3px;text-transform:none;}
  .fine{margin:0;text-align:center;font:500 12px/1.4 var(--display);color:rgba(244,240,255,.5);}
  .top{display:flex;justify-content:space-between;align-items:center;} .top a{font:600 12px var(--mono);letter-spacing:.1em;color:var(--sky);text-decoration:none;}
  .chip{font:700 13px var(--mono);letter-spacing:.16em;color:#140f28;background:var(--gold);border-radius:999px;padding:7px 12px;} .chip.ghost{background:rgba(255,255,255,.1);color:var(--ink);}
  .boxes{display:flex;justify-content:center;gap:10px;}
  .boxes b{width:64px;height:78px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);display:grid;place-items:center;font:800 44px var(--mono);color:var(--gold);position:relative;}
  .boxes b.cur{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 18px rgba(255,210,122,.35);} .boxes b.cur:empty::after{content:"";width:26px;height:4px;background:var(--gold);position:absolute;bottom:12px;animation:blink .7s steps(2,end) infinite;}
  @keyframes blink{50%{opacity:.2;}}
  .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;flex:1;min-height:0;align-content:start;}
  .grid button{aspect-ratio:1.15;min-height:44px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);font:700 22px var(--mono);color:var(--ink);transition:transform .08s,background .08s;}
  .grid button:active,.grid button.on{background:var(--gold);color:#140f28;transform:scale(.94);}
  .grid button.bk{font-size:18px;color:var(--pink);}
  .big{display:block;width:100%;padding:16px 18px;border-radius:999px;background:var(--gold);color:#140f28;font:800 15px var(--mono);letter-spacing:.14em;box-shadow:0 8px 30px rgba(255,210,122,.3);transition:transform .1s,opacity .2s;}
  .big:active{transform:scale(.98);} .big[disabled]{opacity:.35;box-shadow:none;} .big.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.16);box-shadow:none;}
  /* seats: laid out like the TV — 4UP top-left, 3UP top-right, 1UP bottom-left, 2UP bottom-right */
  .seatgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;min-height:0;align-content:start;}
  .seatbtn{--c:#fff;text-align:left;padding:14px 14px 12px;border-radius:18px;background:color-mix(in oklab,var(--c) 10%,transparent);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);min-height:112px;display:flex;flex-direction:column;gap:4px;transition:transform .1s;}
  .seatbtn:active{transform:scale(.97);} .seatbtn.full{opacity:.4;}
  .seatbtn b{font:800 20px var(--display);color:var(--c);} .seatbtn b small{font:600 11px var(--mono);letter-spacing:.08em;opacity:.65;margin-left:6px;}
  .seatbtn .occ{font:600 13px var(--mono);letter-spacing:.06em;color:var(--ink);min-height:1.2em;} .seatbtn .st{margin-top:auto;font:700 11px var(--mono);letter-spacing:.14em;color:color-mix(in oklab,var(--c) 80%,#fff);}
  .seatbtn[data-seat="3"]{order:1;} .seatbtn[data-seat="2"]{order:2;} .seatbtn[data-seat="0"]{order:3;} .seatbtn[data-seat="1"]{order:4;}
  /* the controller */
  .pad{gap:10px;}
  .padhead{display:grid;grid-template-columns:auto 1fr auto auto;gap:10px;align-items:center;}
  .seatbadge{display:flex;flex-direction:column;align-items:center;justify-content:center;width:58px;height:58px;border-radius:16px;background:color-mix(in oklab,var(--c) 22%,transparent);border:1px solid color-mix(in oklab,var(--c) 60%,transparent);}
  .seatbadge b{font:800 20px/1 var(--display);color:var(--c);} .seatbadge span{font:700 9px var(--mono);letter-spacing:.14em;opacity:.8;margin-top:3px;}
  .me b{display:block;font:800 26px/1 var(--display);letter-spacing:.02em;} .me small{display:block;font:600 11px var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.55);margin-top:4px;min-height:1.2em;}
  .score{text-align:right;} .score small{display:block;font:700 9px var(--mono);letter-spacing:.2em;color:var(--mint);} .score b{display:block;font:700 26px/1 var(--mono);font-variant-numeric:tabular-nums;margin-top:3px;}
  .score.bump b{animation:bump .25s ease;} @keyframes bump{40%{transform:scale(1.18);color:var(--gold);}}
  .net{display:flex;align-items:center;gap:5px;font:600 10px var(--mono);color:rgba(244,240,255,.55);} .net i{width:8px;height:8px;border-radius:50%;background:#666;box-shadow:0 0 6px #666;}
  .net.good i{background:var(--mint);box-shadow:0 0 8px var(--mint);} .net.ok i{background:var(--gold);box-shadow:0 0 8px var(--gold);} .net.bad i{background:var(--pink);box-shadow:0 0 8px var(--pink);} .net.off i{animation:blink 1s steps(2,end) infinite;}
  .phase{font:700 11px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.6);text-align:center;}
  .cue{display:grid;place-items:center;text-align:center;border-radius:16px;padding:10px;background:color-mix(in oklab,var(--c) 14%,transparent);border:1px solid color-mix(in oklab,var(--c) 40%,transparent);opacity:.25;transition:opacity .15s,transform .15s;}
  .cue span{font:800 22px/1 var(--display);color:var(--c);} .cue small{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.65);margin-top:4px;}
  .cue.on{opacity:1;animation:cue .5s ease-in-out infinite alternate;} @keyframes cue{to{transform:scale(1.03);box-shadow:0 0 0 2px var(--c),0 0 30px color-mix(in oklab,var(--c) 60%,transparent);}}
  .cue.idle span{color:rgba(244,240,255,.6);}
  .pads{display:grid;grid-template-columns:repeat(5,1fr);grid-auto-rows:1fr;gap:9px;flex:1;min-height:0;}
  .pads button{border-radius:16px;background:color-mix(in oklab,var(--c) 18%,#14122a);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);box-shadow:inset 0 -6px 0 color-mix(in oklab,var(--c) 30%,#000),0 4px 14px rgba(0,0,0,.3);font:800 30px var(--mono);color:var(--c);display:grid;place-items:center;transition:transform .05s,background .05s;position:relative;}
  .pads button small{position:absolute;bottom:7px;font:600 9px var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.45);}
  .pads button.on{background:var(--c);color:#140f28;transform:scale(.94) translateY(3px);box-shadow:inset 0 -2px 0 color-mix(in oklab,var(--c) 30%,#000),0 0 24px color-mix(in oklab,var(--c) 70%,transparent);}
  .pads button.on small{color:#140f28;}
  .drums{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  .drums button{height:56px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);font:800 12px var(--mono);letter-spacing:.12em;color:var(--ink);transition:transform .05s,background .05s;}
  .drums button.on{background:var(--ink);color:#140f28;transform:scale(.94);box-shadow:0 0 20px rgba(255,255,255,.4);}
  .padfoot{display:flex;gap:10px;align-items:center;}
  .act{flex:1;padding:14px;border-radius:999px;background:var(--gold);color:#140f28;font:800 13px var(--mono);letter-spacing:.14em;box-shadow:0 6px 24px rgba(255,210,122,.3);animation:blink 2.4s ease-in-out infinite;}
  .leave{margin-left:auto;font:600 12px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.45);padding:12px;}
  /* results */
  .res{justify-content:center;text-align:center;gap:10px;}
  .rank{font:800 clamp(72px,26vw,120px)/1 var(--display);color:var(--c);text-shadow:0 0 40px color-mix(in oklab,var(--c) 60%,transparent);}
  .resline{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.05);font:600 13px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.6);} .resline b{font:700 20px var(--mono);color:var(--ink);letter-spacing:0;}
  /* feedback: a full-screen flash for the big moments, an edge pulse instead of a buzz where there is no vibrator */
  #flash{position:fixed;inset:0;pointer-events:none;z-index:20;display:grid;place-items:center;opacity:0;background:radial-gradient(60% 50% at 50% 45%,color-mix(in oklab,var(--f,#fff) 40%,transparent),transparent 70%);}
  #flash b{font:800 clamp(34px,11vw,52px) var(--display);color:var(--f,#fff);text-shadow:0 4px 30px rgba(0,0,0,.6);letter-spacing:-.01em;transform:rotate(-4deg);}
  #flash.go{animation:flash .55s ease-out;} @keyframes flash{0%{opacity:1;}100%{opacity:0;}}
  #flash.big.go{animation:flashBig .9s ease-out;} @keyframes flashBig{0%{opacity:1;}60%{opacity:.9;}100%{opacity:0;}}
  #edge{position:fixed;inset:0;pointer-events:none;z-index:19;box-shadow:inset 0 0 0 0 var(--c);opacity:0;} #edge.go{animation:edge .35s ease-out;} @keyframes edge{0%{opacity:1;box-shadow:inset 0 0 0 14px var(--c),inset 0 0 60px var(--c);}100%{opacity:0;box-shadow:inset 0 0 0 0 var(--c);}}
  #edge.hold{opacity:1;animation:edgeHold .5s ease-in-out infinite alternate;} @keyframes edgeHold{from{box-shadow:inset 0 0 0 4px var(--c),inset 0 0 30px color-mix(in oklab,var(--c) 40%,transparent);}to{box-shadow:inset 0 0 0 10px var(--c),inset 0 0 60px color-mix(in oklab,var(--c) 60%,transparent);}}
  @media (max-height:640px){ .boxes b{width:52px;height:62px;font-size:34px;} .grid button{min-height:38px;font-size:18px;} .pads button{font-size:22px;} .drums button{height:46px;} }
  @media (orientation:landscape) and (max-height:500px){ .pad .cue{padding:6px;} .pads button{font-size:20px;} }
  @media (prefers-reduced-motion:reduce){ .cue.on,.act,#edge.hold,.boxes b.cur:empty::after,.net.off i{animation:none;} }
</style>
</head>
<body>
<div id="edge" aria-hidden="true"></div>
<div id="flash" aria-hidden="true"><b id="flashTxt"></b></div>
<main id="app">
  <section id="sCode" class="screen">
    <div class="logo"><span style="--h:0">B</span><span style="--h:28">R</span><span style="--h:56">I</span><span style="--h:84">C</span><span style="--h:112">K</span><i></i><span style="--h:168">C</span><span style="--h:196">H</span><span style="--h:224">O</span><span style="--h:252">I</span><span style="--h:280">R</span></div>
    <div class="sub">PHONE CONTROLLER</div>
    <p class="lead">Put <b>pointcast.xyz/brick-choir/tv</b> on the TV, then type the four letters it shows.</p>
    <div class="lbl">ROOM CODE</div>
    <div class="boxes" id="codeBoxes"><b></b><b></b><b></b><b></b></div>
    <div class="grid" id="codeGrid"></div>
    <button class="big" id="codeGo" disabled>FIND THE TV ▸</button>
    <p class="fine">or scan a corner of the TV — the QR code brings you here with the code filled in</p>
  </section>

  <section id="sName" class="screen" hidden>
    <div class="top"><span class="chip" id="nameRoom">ROOM ····</span><a href="#" id="nameBack">change</a></div>
    <div class="lbl">YOUR NAME <small>three letters, arcade style</small></div>
    <div class="boxes" id="nameBoxes"><b></b><b></b><b></b></div>
    <div class="grid six" id="nameGrid"></div>
    <button class="big" id="nameGo" disabled>PICK A CORNER ▸</button>
  </section>

  <section id="sSeat" class="screen" hidden>
    <div class="top"><span class="chip" id="seatRoom">ROOM ····</span><span class="chip ghost" id="seatName">···</span></div>
    <div class="lbl">PICK YOUR CORNER <small id="seatSub">looking for the TV…</small></div>
    <div class="seatgrid" id="seatGrid"></div>
    <button class="big" id="seatAny">ANY OPEN SEAT ▸</button>
    <p class="fine" id="seatNote">two phones can share a corner — that's a duet</p>
  </section>

  <section id="sPad" class="screen pad" hidden>
    <header class="padhead">
      <div class="seatbadge"><b id="padSeat">P3</b><span id="padPart">LEAD</span></div>
      <div class="me"><b id="padName">ABC</b><small id="padDuet"></small></div>
      <div class="score"><small>SCORE</small><b id="padScore">0</b></div>
      <div class="net" id="padNet"><i></i><span id="padPing">—</span></div>
    </header>
    <div class="phase" id="padPhase">PARTY MODE</div>
    <div class="cue" id="cue"><span>♪ YOUR NOTE!</span><small>hit the glowing brick</small></div>
    <div class="pads" id="pads"></div>
    <div class="drums" id="drums"></div>
    <footer class="padfoot">
      <button class="act" id="padAct" hidden>START A GAME</button>
      <button class="leave" id="padLeave">leave</button>
    </footer>
  </section>

  <section id="sRes" class="screen res" hidden>
    <div class="lbl" id="resTitle">GAME OVER</div>
    <div class="rank" id="resRank">2ND</div>
    <div class="resline"><span>YOUR SEAT</span><b id="resSeat">P3 · LEAD</b></div>
    <div class="resline"><span>YOUR SCORE</span><b id="resScore">0</b></div>
    <div class="resline"><span>TEAM</span><b id="resTeam">0</b></div>
    <div class="resline"><span>ROUND</span><b id="resRound">1</b></div>
    <button class="big" id="resAgain">PLAY AGAIN ▸</button>
    <button class="big ghost" id="resParty">BACK TO THE PARTY</button>
  </section>
</main>
<script is:inline>
/* ================= party transport (shared by /brick-choir/tv and /brick-choir/join) =================
   A tiny relay client. Frames are small JSON objects (≤120 chars) and carry `o` (origin pid).
   1. /api/drum/room?room=bc-<code> — the pointcast-drum Durable Object; its welcome lists "bc-party" when the
      deployed Worker relays opaque party frames (workers/pointcast-drum, migration-free). Immediate fan-out.
   2. /api/room?url=/brick-choir/party/<code> — the presence Durable Object, sharded per URL; a `chat` message is
      broadcast at once to the whole room, so it works as a relay today with no Worker deploy (120-char frames).
   Reconnects with backoff, on visibility and on `online`; the pid stays the same so the TV keeps your seat. */
function makeParty({code,pid,onFrame,onStatus}){
  const P={transport:null,ws:null,status:'off',tries:0,closed:false,seen:new Set(),sent:0,recv:0};
  const room='bc-'+code.toLowerCase(); const proto=location.protocol==='https:'?'wss':'ws';
  const drumUrl=`${proto}://${location.host}/api/drum/room?room=${room}&sid=${pid}`;
  const roomUrl=`${proto}://${location.host}/api/room?url=${encodeURIComponent('/brick-choir/party/'+code.toLowerCase())}&sid=bc-${pid}`;
  const FORCE=(new URLSearchParams(location.search).get('transport')||'').toLowerCase(); // ?transport=room forces the fallback (tests)
  const setStatus=s=>{ if(P.status!==s){ P.status=s; if(onStatus) onStatus(s,P.transport); } };
  let timer=null;
  function open(which){
    if(P.closed) return; if(which==='drum'&&FORCE==='room') which='room'; setStatus('connecting'); let ws; try{ ws=new WebSocket(which==='drum'?drumUrl:roomUrl); }catch(e){ return fail(which); }
    // the guard only gives up on a socket that never opened; an open socket whose welcome is late (a TV's main thread is
    // busy compiling shaders at boot, and queued message events can land after a timer) gets a second, longer wait
    P.ws=ws; let ok=false, guard=setTimeout(()=>{ if(ok) return; if(ws.readyState===1&&which==='drum'){ guard=setTimeout(()=>{ if(!ok){ ws.onclose=null; try{ ws.close(); }catch(e){} open('room'); } },8000); return; } try{ ws.close(); }catch(e){} },4000);
    ws.onmessage=e=>{ let m; try{ m=JSON.parse(e.data); }catch(err){ return; } if(!m||typeof m!=='object') return;
      if(which==='drum'){
        if(m.type==='welcome'){ if((m.features||[]).includes('bc-party')){ ok=true; clearTimeout(guard); ready('drum'); } else { clearTimeout(guard); ws.onclose=null; try{ ws.close(); }catch(err){} open('room'); } return; }
        if(m.type==='party'&&m.d&&typeof m.d==='object'){ P.recv++; onFrame(m.d); } return; }
      // presence room: every broadcast carries the chat ring; what was there when we arrived is history
      if(!ok){ ok=true; clearTimeout(guard); (m.chat||[]).forEach(c=>P.seen.add(c.id)); ready('room'); return; }
      (m.chat||[]).forEach(c=>{ if(P.seen.has(c.id)) return; P.seen.add(c.id); if(P.seen.size>600) P.seen=new Set([...P.seen].slice(-300)); let d; try{ d=JSON.parse(c.msg); }catch(err){ return; } if(d&&typeof d==='object'&&d.o!==pid){ P.recv++; onFrame(d); } });
    };
    ws.onclose=()=>{ clearTimeout(guard); if(P.ws!==ws) return; P.ws=null; if(!ok) fail(which); else { setStatus('reconnecting'); retry(); } };
    ws.onerror=()=>{};
  }
  function ready(t){ P.transport=t; P.tries=0; P.seen.clear(); setStatus('on'); }
  function fail(which){ if(which==='drum'){ open('room'); return; } setStatus('offline'); retry(); }
  function retry(){ clearTimeout(timer); const wait=Math.min(6000,400*Math.pow(2,P.tries++)); timer=setTimeout(()=>open('drum'),wait); }
  P.send=d=>{ const ws=P.ws; if(!ws||ws.readyState!==1||P.status!=='on') return false; d.o=pid; try{ if(P.transport==='drum') ws.send(JSON.stringify({v:1,type:'party',d})); else ws.send(JSON.stringify({type:'chat',msg:JSON.stringify(d).slice(0,120)})); }catch(e){ return false; } P.sent++; return true; };
  P.kick=()=>{ if(P.closed) return; if(!P.ws||P.ws.readyState>1){ clearTimeout(timer); P.tries=0; open('drum'); } };
  P.close=()=>{ P.closed=true; clearTimeout(timer); try{ if(P.ws) P.ws.close(); }catch(e){} };
  document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') P.kick(); });
  addEventListener('online',()=>P.kick()); addEventListener('pageshow',()=>P.kick());
  open('drum'); return P;
}
/* ================= the phone controller ================= */
const SEATS=[{id:0,name:'P1',up:'1UP',part:'BASS',corner:'bottom left',hex:'#ff8fb1',caps:['ASDFG','ZXCVB']},{id:1,name:'P2',up:'2UP',part:'KEYS',corner:'bottom right',hex:'#ffd27a',caps:['HJKL;','NM,./']},{id:2,name:'P3',up:'3UP',part:'LEAD',corner:'top right',hex:'#9fe3c9',caps:['67890','YUIOP']},{id:3,name:'P4',up:'4UP',part:'BELLS',corner:'top left',hex:'#8fd0ff',caps:['12345','QWERT']}];
const DRUMS=['KICK','SNARE','CLAP','RIM'];
const ALPHA='ABCDEFGHJKMNPQRSTUVWXYZ', NAMECH='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
const $=id=>document.getElementById(id); const TESTMODE=/[?&]bot\b/.test(location.search);
const store={get(k,d){try{const v=localStorage.getItem('bcj:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{localStorage.setItem('bcj:'+k,v);}catch(e){}}};
const sess={get(k,d){try{const v=sessionStorage.getItem('bcj:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{sessionStorage.setItem('bcj:'+k,v);}catch(e){}}};
// the pid survives a reload or a sleep inside this tab, so the TV gives the same seat back
const pid=sess.get('pid','')||(()=>{ const a=new Uint8Array(4); crypto.getRandomValues(a); const v=Array.from(a,b=>'abcdefghijklmnopqrstuvwxyz0123456789'[b%36]).join(''); sess.set('pid',v); return v; })();
const q=new URLSearchParams(location.search);
let code=(q.get('room')||sess.get('room','')).toUpperCase().replace(/[^A-Z]/g,'').slice(0,4), name=(store.get('name','')).toUpperCase().slice(0,3), wantSeat=Number(sess.get('seat','-1'));
let seat=-1, net=null, roster=null, rosterAt=0, phase='', cueOn=false, rtt=null, myScore=0, team=0, round=1, joined=false, lastAct='', wake=null;
const show=id=>{ document.querySelectorAll('.screen').forEach(s=>s.hidden=s.id!==id); };
const buzz=p=>{ let did=false; try{ if(navigator.vibrate) did=navigator.vibrate(p); }catch(e){} if(!did) edge(); };
function edge(){ const e=$('edge'); e.classList.remove('go'); void e.offsetWidth; e.classList.add('go'); }
function flash(txt,col,big){ const f=$('flash'); f.style.setProperty('--f',col||'#fff'); $('flashTxt').textContent=txt; f.classList.remove('go','big'); void f.offsetWidth; if(big) f.classList.add('big'); f.classList.add('go'); }
const seatCol=()=>seat>=0?SEATS[seat].hex:'#ffd27a';
function theme(){ document.documentElement.style.setProperty('--c',seatCol()); }

/* ---- code + name entry (a letter grid: no keyboard popping up over the game) ---- */
function drawBoxes(el,val,n){ const cur=Math.min(val.length,n-1); [...el.children].forEach((b,i)=>{ b.textContent=val[i]||''; b.classList.toggle('cur',i===cur); }); }
function grid(el,chars,on){ el.innerHTML=''; chars.split('').forEach(ch=>{ const b=document.createElement('button'); b.textContent=ch; b.type='button'; b.onpointerdown=e=>{ e.preventDefault(); on(ch); b.classList.add('on'); setTimeout(()=>b.classList.remove('on'),120); }; el.appendChild(b); }); const bk=document.createElement('button'); bk.textContent='⌫'; bk.className='bk'; bk.type='button'; bk.onpointerdown=e=>{ e.preventDefault(); on(null); }; el.appendChild(bk); }
function codeUI(){ drawBoxes($('codeBoxes'),code,4); $('codeGo').disabled=code.length!==4; }
grid($('codeGrid'),ALPHA,ch=>{ code=ch===null?code.slice(0,-1):(code+ch).slice(0,4); codeUI(); buzz(8); });
$('codeGo').onclick=()=>{ if(code.length!==4) return; sess.set('room',code); $('nameRoom').textContent='ROOM '+code; nameUI(); show('sName'); };
function nameUI(){ drawBoxes($('nameBoxes'),name,3); $('nameGo').disabled=name.length<1; }
grid($('nameGrid'),NAMECH,ch=>{ name=ch===null?name.slice(0,-1):(name+ch).slice(0,3); nameUI(); buzz(8); });
$('nameBack').onclick=e=>{ e.preventDefault(); show('sCode'); };
$('nameGo').onclick=()=>{ if(!name) return; store.set('name',name); $('seatRoom').textContent='ROOM '+code; $('seatName').textContent=name; show('sSeat'); connect(); seatUI(); };

/* ---- the seat picker (the roster comes from the TV) ---- */
function seatUI(){ const g=$('seatGrid'); const have=!!roster; $('seatSub').textContent=!net||net.status!=='on'?'connecting…':(have?'the TV sees you · tap a corner':'looking for the TV…');
  g.innerHTML=SEATS.map(s=>{ const names=have?roster.s[s.id]:[], k=have?roster.k[s.id]:0; const full=k===2||names.length>=2; const st=!have?'':(k===2?'TAKEN · KEYBOARD':names.length===0?'OPEN':names.length===1?'DUET OK · with '+names[0]:'FULL');
    return `<button class="seatbtn ${full?'full':''}" data-seat="${s.id}" style="--c:${s.hex}" ${full?'disabled':''}><b>${s.up} <small>${s.part}</small></b><div class="occ">${names.length?names.join(' & '):'<span style="opacity:.45">'+s.corner+'</span>'}</div><div class="st">${st}</div></button>`; }).join('');
  g.querySelectorAll('button').forEach(b=>b.onclick=()=>join(Number(b.dataset.seat))); }
$('seatAny').onclick=()=>join(-1);
let noTvT=null;
function join(s){ wantSeat=s; sess.set('seat',String(s)); buzz(12); if(net&&net.status==='on'){ net.send({f:'j',p:pid,n:name,s}); $('seatSub').textContent='asking the TV…'; } else $('seatSub').textContent='still connecting…'; }

/* ---- the controller ---- */
function padUI(){ const s=SEATS[seat]; theme(); $('padSeat').textContent=s.name; $('padPart').textContent=s.part; $('padName').textContent=name;
  const pads=$('pads'); pads.innerHTML=''; for(let r=0;r<2;r++) for(let i=0;i<5;i++){ const b=document.createElement('button'); b.type='button'; b.dataset.k=r*5+i; b.innerHTML=`${s.caps[r][i]}<small>${r===0?'':''}</small>`; pads.appendChild(b); }
  const dr=$('drums'); dr.innerHTML=''; DRUMS.forEach((d,i)=>{ const b=document.createElement('button'); b.type='button'; b.dataset.k=10+i; b.textContent=d; dr.appendChild(b); });
  [...pads.children,...dr.children].forEach(b=>{ b.onpointerdown=e=>{ e.preventDefault(); press(b); }; b.onpointerup=b.onpointercancel=b.onpointerleave=()=>b.classList.remove('on'); b.oncontextmenu=e=>e.preventDefault(); });
  $('resSeat').textContent=`${s.name} · ${s.part}`; }
function press(b){ const k=Number(b.dataset.k); b.classList.add('on'); setTimeout(()=>b.classList.remove('on'),140); buzz(10); if(net) net.send({f:'i',p:pid,k,t:Date.now()%100000}); }
const ACT={attract:['START A GAME','start'],lobby:['START NOW','start'],over:['CONTINUE','again'],scores:['PLAY AGAIN','again'],inter:['SKIP ▸','skip']};
function phaseUI(){ const a=ACT[phase]; const btn=$('padAct'); btn.hidden=!a; if(a){ btn.textContent=a[0]; btn.dataset.c=a[1]; }
  const txt={attract:'PARTY MODE · the monument plays itself',lobby:'LOBBY · taking corners',ready:'GET READY',play:`ROUND ${round}`,clear:'SONG COMPLETE',short:'THE SONG ENDED',inter:'INTERMISSION',over:'GAME OVER',initials:'SIGNING THE CHOIR',scores:'THE CHOIR',paused:'PAUSED'}[phase]||phase.toUpperCase();
  $('padPhase').textContent=txt; $('padScore').textContent=myScore.toLocaleString();
  const cue=$('cue'); cue.classList.toggle('on',cueOn); cue.classList.toggle('idle',!cueOn); cue.querySelector('span').textContent=cueOn?'♪ YOUR NOTE!':(phase==='play'?'listen for your note':'tap anything — every pad is a note'); cue.querySelector('small').textContent=cueOn?'hit the glowing brick on your side':(phase==='play'?'the song passes corner to corner':'no wrong notes');
  $('edge').classList.toggle('hold',cueOn&&!navigator.vibrate); }
$('padAct').onclick=()=>{ const c=$('padAct').dataset.c; if(net) net.send({f:'cmd',p:pid,c}); buzz(15); };
$('padLeave').onclick=()=>{ if(net) net.send({f:'l',p:pid}); seat=-1; joined=false; sess.set('seat','-1'); show('sSeat'); seatUI(); };
$('resAgain').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'again'}); show('sPad'); };
$('resParty').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'party'}); show('sPad'); };
function bump(){ const s=$('padScore').parentElement; s.classList.remove('bump'); void s.offsetWidth; s.classList.add('bump'); }
const EV={n:()=>{ cueOn=true; phaseUI(); buzz([70,40,70]); flash('YOUR NOTE!',seatCol()); },a:()=>{ cueOn=false; phaseUI(); buzz(40); flash('ON CUE!','#ffd27a'); },h:()=>{ buzz(8); },c:()=>{ buzz(25); flash('CATCH!',seatCol()); },b:()=>{ buzz([90,30,140]); flash('THE BELL!','#fff3c4',true); },t:()=>{ buzz(30); flash('THROUGH!','#b9a8ff'); },q:()=>{ buzz([50,30,50,30,120]); flash('QUARTET!','#fff3c4',true); },f:()=>{ buzz([60,40,60,40,60]); flash('FACE CLEAR!',seatCol(),true); }};

/* ---- frames from the TV ---- */
function onFrame(d){
  if(d.p&&d.p!==pid&&d.f!=='ev') return; // addressed to another phone
  switch(d.f){
    case 'ro': roster=d; rosterAt=Date.now(); if(seat<0) seatUI(); else { const mine=(d.s[seat]||[]).filter(n=>n!==name); $('padDuet').textContent=mine.length?'duet with '+mine.join(' & '):''; } break;
    case 'ok': { const was=seat; seat=d.s; joined=true; sess.set('seat',String(seat)); if(was!==seat||$('sPad').hidden){ padUI(); show('sPad'); flash(`${SEATS[seat].name} · ${SEATS[seat].part}`,SEATS[seat].hex,true); buzz([40,30,80]); } $('padDuet').textContent=d.m>1?'duet':''; phaseUI(); wakeLock(); break; }
    case 'full': $('seatSub').textContent='that corner is full — pick another'; buzz([30,30,30]); break;
    case 'who': if(seat>=0||wantSeat>=0) net.send({f:'j',p:pid,n:name,s:seat>=0?seat:wantSeat}); break;
    case 'st': { const s=d.sc||[0,0,0,0]; team=s.reduce((a,b)=>a+b,0); if(seat>=0){ const ns=s[seat]|0; if(ns>myScore) bump(); myScore=ns; } round=d.r||1; const ph=String(d.ph||''); const cue=d.cue===seat&&ph==='play'; if(ph!==phase||cue!==cueOn){ phase=ph; cueOn=cue; phaseUI(); if(!$('sRes').hidden&&!/^(over|initials|scores)$/.test(ph)) show('sPad'); } else { phase=ph; $('padScore').textContent=myScore.toLocaleString(); } break; }
    case 'ev': (d.l||[]).forEach(([s,e])=>{ if(s===seat&&EV[e]) EV[e](); }); break;
    case 'res': { if(seat<0) break; const rk=(d.rk||[])[seat]|0; $('resTitle').textContent=d.w?'THE WHOLE SONGBOOK!':'GAME OVER'; $('resRank').textContent=['1ST','2ND','3RD','4TH'][rk]||'—'; $('resScore').textContent=((d.sc||[])[seat]|0).toLocaleString(); $('resTeam').textContent=(d.sc||[]).reduce((a,b)=>a+b,0).toLocaleString(); $('resRound').textContent=d.rd||1; show('sRes'); buzz(rk===0?[80,40,80,40,160]:60); break; }
    case 'pq': if(typeof d.t==='number'){ rtt=Date.now()-d.t; netUI(); } break;
  }
}
function netUI(){ const el=$('padNet'); const st=net?net.status:'off'; el.className='net '+(st!=='on'?'off':rtt===null?'':rtt<90?'good':rtt<180?'ok':'bad'); $('padPing').textContent=st!=='on'?(st==='connecting'?'…':st):(rtt===null?'live':rtt+' ms'); }
function connect(){ if(net) return; net=makeParty({code,pid,onFrame,onStatus:s=>{ netUI(); if(s==='on'){ net.send({f:'hi',p:pid}); if(seat>=0||wantSeat>=0) net.send({f:'j',p:pid,n:name,s:seat>=0?seat:wantSeat}); } if(seat<0) seatUI(); }});
  setInterval(()=>{ if(!net||net.status!=='on') return; net.send({f:'pp',p:pid,t:Date.now()}); if(seat<0&&(Date.now()-rosterAt>5000)){ net.send({f:'hi',p:pid}); if(rosterAt===0&&$('seatSub')) $('seatSub').textContent=`no TV is showing room ${code} yet — open pointcast.xyz/brick-choir/tv on the TV`; } },3000); }
async function wakeLock(){ try{ if('wakeLock' in navigator&&!wake){ wake=await navigator.wakeLock.request('screen'); wake.addEventListener('release',()=>{ wake=null; }); } }catch(e){} }
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible'){ if(seat>=0) wakeLock(); if(net){ net.kick(); if(net.status==='on') net.send({f:'hi',p:pid}); } } });
addEventListener('pagehide',()=>{ /* keep the seat: the TV holds it while the phone sleeps, and the same pid reclaims it */ });

/* ---- boot: a scanned QR lands with the code filled in ---- */
codeUI(); nameUI(); theme();
if(code.length===4){ $('nameRoom').textContent='ROOM '+code; if(name){ $('nameGo').onclick(); } else show('sName'); } else show('sCode');
if(TESTMODE) window.__bj={get seat(){return seat;},get phase(){return phase;},get cue(){return cueOn;},get score(){return myScore;},get roster(){return roster;},get net(){return net;},get rtt(){return rtt;},get screen(){return [...document.querySelectorAll('.screen')].find(s=>!s.hidden).id;},get flash(){return $('flashTxt').textContent;},pid,setName:n=>{ name=n; nameUI(); },go:()=>$('nameGo').onclick(),join,press:k=>{ const b=document.querySelector(`[data-k="${k}"]`); if(b) press(b); }};
</script>
</body>
</html>
