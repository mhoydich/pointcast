---
// /brick-choir/home — the Living Room Hub: the console menu for the Brick Choir cabinets. The TV shows one room code and
// one QR; phones scan it once (/brick-choir/home-join), give a name, and follow the TV from game to game with no
// rescanning — the Jackbox / Wii Sports model. The hub keeps the roster (names + colours) across games, lets the remote
// or the phones pick a cabinet, runs SPORTS DAY (Rally → Lanes → Quartet with a medal table and a ceremony) and plays an
// attract loop when nobody touches it. Handoff: the hub broadcasts go{g} on the party relay (room bc-CODE), the TV
// navigates to the game with ?room=CODE&hub=1, phones to the game's join page with ?room=CODE&hub=1&name=…&c=…; the
// game's BACK TO HOME broadcasts home{g,r} and everybody comes back here (results ride in sessionStorage on the TV).
// Keyboard cabinets (Choir, 2600) open inside the hub in a frame so the room stays live. Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Brick Choir: Home · PointCast</title>
<meta name="description" content="The living-room menu for Brick Choir. Scan one code with your phone, pick a cabinet on the TV, play Rally, Lanes and Quartet without ever rescanning. Sports Day runs all three with medals.">
<meta property="og:title" content="Brick Choir: Home">
<meta property="og:description" content="One code, every cabinet. Scan once; the TV moves between games and your phone follows.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/home">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og4.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a1a">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/home">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  /* 10-foot UI: sizes in vw (1vw = 19.2px at 1080p); everything sits inside a 4% overscan-safe frame. Same family as the lobby. */
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --lilac:#b9a8ff; --peach:#ffb38a; --lime:#e9ff7a; --sx:4vw; --sy:4vh;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  *{box-sizing:border-box;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;cursor:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;}
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:none;}
  /* ambient light, breathing with the groove */
  .blobs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
  .blobs i{position:absolute;width:64vmax;height:64vmax;border-radius:50%;filter:blur(70px);opacity:.26;mix-blend-mode:screen;animation:drift 28s ease-in-out infinite alternate;transition:opacity .4s;}
  .blobs i:nth-child(1){left:-22vmax;top:-24vmax;background:radial-gradient(circle,oklch(70% .18 300),transparent 60%);}
  .blobs i:nth-child(2){right:-26vmax;top:-12vmax;background:radial-gradient(circle,oklch(72% .16 200),transparent 60%);animation-delay:-9s;}
  .blobs i:nth-child(3){left:22vw;bottom:-38vmax;background:radial-gradient(circle,oklch(75% .16 40),transparent 60%);animation-delay:-17s;}
  body.beat .blobs i{opacity:.34;}
  @keyframes drift{to{transform:translate(6vw,5vh) scale(1.12);}}

  #stage{position:fixed;inset:var(--sy) var(--sx);z-index:1;display:grid;grid-template-rows:auto auto auto auto;align-content:space-between;gap:1.2vw;}
  /* ---- top: wordmark + room card ---- */
  #top{display:flex;justify-content:space-between;align-items:center;gap:2vw;}
  .mark{display:flex;align-items:center;gap:1.2vw;}
  .mark .logo{display:flex;gap:.01em;font:800 2.6vw/1 var(--display);letter-spacing:-.02em;margin:0;}
  .mark .logo span{display:inline-block;background:linear-gradient(180deg,oklch(92% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bob 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.18s);filter:drop-shadow(0 0 .7vw oklch(80% .15 var(--h) / .35));}
  .mark .logo span.sp{width:.28em;}
  @keyframes bob{50%{transform:translateY(-.25vw);}}
  .mark .home{font:800 .95vw var(--mono);letter-spacing:.3em;text-indent:.3em;color:#140f28;background:var(--gold);padding:.45vw .9vw;border-radius:999px;box-shadow:0 0 1.2vw rgba(255,210,122,.35);}
  .mark .tag{font:600 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.5);text-transform:uppercase;}
  #room{display:grid;grid-template-columns:auto auto;gap:1vw;align-items:center;padding:.8vw 1vw;border-radius:1.2vw;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));border:.12vw solid rgba(255,255,255,.14);box-shadow:0 1vw 3vw rgba(0,0,0,.35),inset 0 .08vw 0 rgba(255,255,255,.12);transition:transform .5s cubic-bezier(.2,.8,.2,1);transform-origin:top right;}
  #room canvas{width:6.4vw;height:6.4vw;border-radius:.5vw;background:#fff;padding:.3vw;image-rendering:pixelated;display:block;}
  #room .txt{display:flex;flex-direction:column;gap:.15vw;min-width:13vw;}
  #room .lbl{font:700 .72vw var(--mono);letter-spacing:.2em;color:var(--mint);} #room .lbl b{display:block;font-weight:600;letter-spacing:.06em;color:rgba(244,240,255,.6);margin-top:.15vw;text-transform:none;}
  #room .code{font:800 3vw/1 var(--mono);letter-spacing:.22em;color:var(--gold);text-shadow:0 0 1.4vw rgba(255,210,122,.45);margin-top:.2vw;}
  #room .st{display:flex;align-items:center;gap:.4vw;font:600 .7vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.55);text-transform:uppercase;} #room .st i{width:.5vw;height:.5vw;border-radius:50%;background:#666;box-shadow:0 0 .5vw #666;}
  #room .st.on i{background:var(--mint);box-shadow:0 0 .6vw var(--mint);} #room .st.connecting i,#room .st.reconnecting i{background:var(--gold);animation:blink 1s steps(2,end) infinite;} #room .st.offline i{background:var(--pink);}
  @keyframes blink{50%{opacity:.25;}}
  body.attract #room{transform:scale(1.18);}

  /* ---- the tiles: five cabinets ---- */
  #tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:1.3vw;align-items:stretch;min-height:0;}
  .tile{--c:#ffd27a;position:relative;border-radius:1.4vw;text-align:left;display:flex;flex-direction:column;transform:scale(.95);transition:transform .35s cubic-bezier(.2,.8,.2,1),filter .35s;filter:saturate(.7) brightness(.72);outline:0;min-height:0;}
  .tile.focus{transform:scale(1.02);filter:none;z-index:2;}
  .tile .glow{position:absolute;inset:-8% -10% -12%;border-radius:2.4vw;background:radial-gradient(60% 55% at 50% 40%,color-mix(in oklab,var(--c) 45%,transparent),transparent 70%);opacity:0;transition:opacity .4s;z-index:0;filter:blur(1vw);}
  .tile.focus .glow{opacity:.9;}
  .tile .body{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;border-radius:1.4vw;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035) 60%,rgba(255,255,255,.02));border:.12vw solid rgba(255,255,255,.16);box-shadow:0 1.5vw 3.5vw rgba(0,0,0,.45),inset 0 .08vw 0 rgba(255,255,255,.14);padding:.7vw .7vw .8vw;overflow:hidden;}
  .tile.focus .body{border-color:color-mix(in oklab,var(--c) 60%,rgba(255,255,255,.2));box-shadow:0 1.5vw 3.5vw rgba(0,0,0,.5),0 0 0 .1vw color-mix(in oklab,var(--c) 30%,transparent),0 0 2vw color-mix(in oklab,var(--c) 28%,transparent);}
  .tile .art{position:relative;aspect-ratio:4/3;border-radius:.9vw;overflow:hidden;background:#06050f;border:.08vw solid rgba(255,255,255,.12);box-shadow:inset 0 0 2vw rgba(0,0,0,.8);}
  .tile .art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9;display:block;}
  .tile .art .glass{position:absolute;inset:0;background:linear-gradient(115deg,rgba(255,255,255,.14),transparent 30%,transparent 70%,rgba(255,255,255,.05)),repeating-linear-gradient(0deg,rgba(0,0,0,.14) 0 1px,transparent 1px 3px);mix-blend-mode:screen;}
  .tile .art .kind{position:absolute;left:.6vw;top:.6vw;font:700 .62vw var(--mono);letter-spacing:.18em;color:#140f28;background:var(--c);padding:.25vw .55vw;border-radius:999px;}
  .tile .art .kind.keys{background:rgba(6,5,15,.75);color:rgba(244,240,255,.85);border:.06vw solid rgba(255,255,255,.2);}
  .tile .art .votes{position:absolute;right:.6vw;bottom:.6vw;display:flex;gap:.3vw;} .tile .art .votes i{width:1.1vw;height:1.1vw;border-radius:50%;background:var(--v);box-shadow:0 0 .6vw var(--v),0 0 0 .1vw #06050f;display:grid;place-items:center;font:800 .55vw var(--mono);color:#140f28;}
  .tile .head{display:flex;justify-content:space-between;align-items:baseline;padding:.6vw .2vw .1vw;gap:.5vw;}
  .tile .head b{font:800 1.5vw/1 var(--display);letter-spacing:-.01em;color:var(--c);text-shadow:0 0 1vw color-mix(in oklab,var(--c) 60%,transparent);}
  .tile .head small{font:600 .6vw var(--mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(244,240,255,.5);white-space:nowrap;}
  .tile .line{font:500 .85vw/1.35 var(--display);color:rgba(244,240,255,.72);padding:.25vw .2vw 0;}
  .tile .cp{display:flex;align-items:center;justify-content:space-between;gap:.6vw;margin-top:auto;padding:.5vw .5vw .3vw;border-radius:.7vw;background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,.15));border:.06vw solid rgba(255,255,255,.08);}
  .tile .cp .btns{display:flex;gap:.35vw;align-items:center;} .tile .cp .btns i{width:1vw;height:1vw;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff8,var(--k) 50%,color-mix(in oklab,var(--k) 60%,#000) 100%);box-shadow:0 .15vw 0 rgba(0,0,0,.6),0 0 .5vw color-mix(in oklab,var(--k) 50%,transparent);}
  .tile .cp .play{font:800 .72vw var(--mono);letter-spacing:.16em;color:#140f28;background:var(--c);padding:.4vw .8vw;border-radius:999px;box-shadow:0 0 1vw color-mix(in oklab,var(--c) 50%,transparent);white-space:nowrap;}
  .tile.focus .cp .play{animation:pulse 1.4s ease-in-out infinite;} @keyframes pulse{50%{transform:scale(1.05);box-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 75%,transparent);}}
  body.beat .tile.focus{transform:scale(1.035);} body.beat .tile{filter:saturate(.8) brightness(.8);} body.beat .tile.focus{filter:none;}
  .tile.lit{filter:saturate(.95) brightness(.95);}

  /* ---- sports day + medals ---- */
  #row2{display:grid;grid-template-columns:3fr 2fr;gap:1.3vw;align-items:stretch;}
  #daytile{--c:#ffd27a;position:relative;border-radius:1.4vw;text-align:left;transform:scale(.985);transition:transform .35s cubic-bezier(.2,.8,.2,1),filter .35s;filter:saturate(.75) brightness(.78);outline:0;}
  #daytile.focus{transform:scale(1);filter:none;}
  #daytile .glow{position:absolute;inset:-10% -4%;border-radius:2.4vw;background:radial-gradient(60% 60% at 50% 50%,rgba(255,210,122,.4),transparent 70%);opacity:0;transition:opacity .4s;filter:blur(1vw);} #daytile.focus .glow{opacity:.8;}
  #daytile .body{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:1.4vw;align-items:center;padding:.9vw 1.2vw;border-radius:1.4vw;background:radial-gradient(120% 90% at 0% 0%,rgba(255,143,177,.16),transparent 60%),linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035));border:.12vw solid rgba(255,255,255,.16);box-shadow:0 1.5vw 3.5vw rgba(0,0,0,.45),inset 0 .08vw 0 rgba(255,255,255,.14);}
  #daytile.focus .body{border-color:rgba(255,210,122,.7);box-shadow:0 1.5vw 3.5vw rgba(0,0,0,.5),0 0 2vw rgba(255,210,122,.3);}
  #daytile .disc{width:5.2vw;height:5.2vw;border-radius:50%;background:conic-gradient(from 0deg,#ff8fb1,#ffd27a,#9fe3c9,#8fd0ff,#b9a8ff,#ff8fb1);box-shadow:0 .8vw 2.4vw rgba(255,143,177,.35),inset 0 0 0 .45vw rgba(11,10,26,.9),inset 0 0 0 .5vw rgba(255,255,255,.25);position:relative;animation:spin 14s linear infinite;}
  #daytile .disc::before{content:"";position:absolute;inset:.85vw;border-radius:50%;background:radial-gradient(circle at 40% 35%,#fff6d8,#ffd27a 60%,#ffb38a);box-shadow:0 .4vw 0 rgba(0,0,0,.35),inset 0 -.4vw .8vw rgba(0,0,0,.15);}
  @keyframes spin{to{transform:rotate(360deg);}}
  #daytile h2{margin:0;font:800 2vw/1 var(--display);letter-spacing:-.02em;color:var(--gold);text-shadow:0 0 1vw rgba(255,210,122,.4);}
  #daytile .route{display:flex;align-items:center;gap:.5vw;margin-top:.5vw;font:700 .8vw var(--mono);letter-spacing:.1em;} #daytile .route b{padding:.3vw .6vw;border-radius:999px;background:color-mix(in oklab,var(--k) 22%,transparent);border:.06vw solid color-mix(in oklab,var(--k) 60%,transparent);color:var(--k);} #daytile .route b.done{opacity:.45;text-decoration:line-through;} #daytile .route b.now{box-shadow:0 0 .8vw var(--k);}
  #daytile .route span{color:rgba(244,240,255,.4);}
  #daytile p{margin:.4vw 0 0;font:500 .85vw/1.35 var(--display);color:rgba(244,240,255,.72);max-width:34vw;}
  #daytile .play{font:800 .8vw var(--mono);letter-spacing:.16em;color:#140f28;background:var(--gold);padding:.6vw 1.1vw;border-radius:999px;box-shadow:0 0 1.2vw rgba(255,210,122,.45);white-space:nowrap;} #daytile.focus .play{animation:pulse 1.4s ease-in-out infinite;}
  #medals{border-radius:1.4vw;padding:.9vw 1.2vw;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));border:.12vw solid rgba(255,255,255,.13);box-shadow:0 1.5vw 3.5vw rgba(0,0,0,.35),inset 0 .08vw 0 rgba(255,255,255,.1);display:flex;flex-direction:column;gap:.5vw;min-height:0;}
  #medals .eyebrow{font:700 .72vw var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--mint);display:flex;justify-content:space-between;gap:.5vw;} #medals .eyebrow span:last-child{color:rgba(244,240,255,.45);letter-spacing:.08em;text-transform:none;}
  #medals table{border-collapse:collapse;width:100%;font:600 .95vw var(--mono);} #medals th{font:700 .62vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.45);text-align:right;padding:.1vw .4vw;} #medals th:first-child{text-align:left;}
  #medals td{padding:.22vw .4vw;text-align:right;font-variant-numeric:tabular-nums;border-top:.06vw solid rgba(255,255,255,.07);} #medals td:first-child{text-align:left;color:var(--c);font:800 1vw var(--display);}
  #medals td.g{color:#ffd27a;} #medals td.s{color:#d8d8e6;} #medals td.b{color:#ffb38a;} #medals td.pt{color:var(--gold);font-weight:700;}
  #medals .empty{font:500 .85vw/1.4 var(--display);color:rgba(244,240,255,.5);margin:auto 0;}
  .medal{display:inline-grid;place-items:center;width:1.3vw;height:1.3vw;border-radius:50%;font:800 .6vw var(--mono);color:#140f28;vertical-align:middle;margin-right:.2vw;} .medal.g{background:linear-gradient(135deg,#fff0b3,#ffd27a 60%,#c98e2e);} .medal.s{background:linear-gradient(135deg,#fff,#d8d8e6 60%,#8b8ba3);} .medal.b{background:linear-gradient(135deg,#ffd9b8,#ffb38a 60%,#a35c2e);}

  /* ---- roster + hint ---- */
  #foot{display:flex;justify-content:space-between;align-items:center;gap:2vw;}
  #roster{display:flex;gap:.6vw;flex-wrap:wrap;align-items:center;min-height:2.6vw;}
  #roster .lbl{font:700 .72vw var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.45);margin-right:.4vw;}
  .chip{--c:#ffd27a;display:inline-flex;align-items:center;gap:.5vw;padding:.45vw .9vw .45vw .55vw;border-radius:999px;background:color-mix(in oklab,var(--c) 16%,transparent);border:.1vw solid color-mix(in oklab,var(--c) 55%,transparent);font:800 1.05vw var(--display);color:var(--c);animation:chipin .5s cubic-bezier(.2,.9,.3,1.3);}
  .chip i{width:1.15vw;height:1.15vw;border-radius:50%;background:var(--c);box-shadow:0 0 .7vw var(--c);display:grid;place-items:center;font:800 .55vw var(--mono);color:#140f28;font-style:normal;}
  .chip small{font:600 .6vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.5);} .chip.host small{color:var(--gold);}
  .chip.ghost{border-style:dashed;color:rgba(244,240,255,.5);background:transparent;animation:none;} .chip.ghost i{background:rgba(255,255,255,.15);box-shadow:none;}
  .chip.gone{opacity:.35;filter:grayscale(.6);}
  @keyframes chipin{from{transform:scale(.6);opacity:0;}}
  #hint{font:600 .8vw var(--mono);letter-spacing:.18em;text-transform:uppercase;color:rgba(244,240,255,.45);white-space:nowrap;}
  #hint kbd{display:inline-block;font:700 .72vw var(--mono);padding:.15vw .5vw;border-radius:.4vw;border:.08vw solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:var(--ink);margin:0 .15vw;}

  /* ---- overlays: launch, medals, ceremony, sports-day intro ---- */
  #ui{position:fixed;inset:0;z-index:20;display:grid;place-items:center;pointer-events:none;}
  #ui:empty{display:none;}
  .panel{--c:#ffd27a;pointer-events:auto;min-width:44vw;max-width:70vw;padding:2.2vw 2.8vw 2.4vw;border-radius:1.8vw;background:rgba(12,10,30,.92);border:.14vw solid color-mix(in oklab,var(--c) 45%,rgba(255,255,255,.14));box-shadow:0 2vw 6vw rgba(0,0,0,.6),0 0 3vw color-mix(in oklab,var(--c) 22%,transparent);text-align:center;animation:pop .35s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{transform:scale(.94);opacity:0;}}
  .panel h1{margin:0;font:800 3.6vw/1 var(--display);letter-spacing:-.02em;color:var(--c);text-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 60%,transparent);} .panel h2{margin:0;font:800 2.2vw/1.1 var(--display);letter-spacing:-.02em;}
  .panel .mono{font:600 .95vw var(--mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(244,240,255,.6);margin:.8vw 0 0;} .panel .mono b{color:var(--gold);font-weight:700;}
  .panel .big{font:800 8vw/1 var(--mono);color:var(--c);text-shadow:0 0 2vw color-mix(in oklab,var(--c) 60%,transparent);margin:.6vw 0 .2vw;font-variant-numeric:tabular-nums;}
  .panel .who{display:flex;justify-content:center;gap:.6vw;flex-wrap:wrap;margin-top:1.2vw;}
  .podium{display:grid;grid-template-columns:repeat(auto-fit,minmax(11vw,1fr));gap:.8vw;margin:1.4vw 0 0;}
  .podium div{--c:#fff;padding:.9vw .8vw;border-radius:1vw;background:color-mix(in oklab,var(--c) 12%,transparent);border:.1vw solid color-mix(in oklab,var(--c) 45%,transparent);display:flex;flex-direction:column;gap:.3vw;align-items:center;}
  .podium em{font:700 .7vw var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.55);font-style:normal;} .podium b{font:800 1.6vw/1 var(--display);color:var(--c);} .podium span{font:700 1.1vw var(--mono);color:rgba(244,240,255,.85);font-variant-numeric:tabular-nums;} .podium small{font:600 .6vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.45);}
  .podium div:first-child{transform:scale(1.06);box-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 35%,transparent);}
  .menu{display:flex;justify-content:center;gap:.8vw;margin-top:1.6vw;flex-wrap:wrap;}
  .menu button{font:800 .95vw var(--mono);letter-spacing:.16em;color:rgba(244,240,255,.8);background:rgba(255,255,255,.07);border:.1vw solid rgba(255,255,255,.16);padding:.8vw 1.5vw;border-radius:999px;transition:transform .12s;}
  .menu button.focus{color:#140f28;background:var(--c);border-color:var(--c);box-shadow:0 0 1.4vw color-mix(in oklab,var(--c) 60%,transparent);transform:scale(1.05);}
  .okhint{margin-top:1vw;font:600 .72vw var(--mono);letter-spacing:.16em;text-transform:uppercase;color:rgba(244,240,255,.4);} .okhint kbd{font:700 .7vw var(--mono);padding:.1vw .4vw;border-radius:.3vw;border:.08vw solid rgba(255,255,255,.25);margin:0 .1vw;}
