    <div id="roster"></div>
    <div id="hint"><span class="kb"><kbd>◀</kbd><kbd>▶</kbd><kbd>▲</kbd><kbd>▼</kbd> choose · <kbd>OK</kbd> play</span> · phones: tap a game</div>
  </footer>
</div>
<div id="attractLine"></div>
