<div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
<div id="stage">
  <header id="top">
    <div class="mark">
      <h1 class="logo" aria-label="Brick Choir"><span style="--h:0;--i:0">B</span><span style="--h:28;--i:1">R</span><span style="--h:56;--i:2">I</span><span style="--h:84;--i:3">C</span><span style="--h:112;--i:4">K</span><span class="sp"></span><span style="--h:168;--i:6">C</span><span style="--h:196;--i:7">H</span><span style="--h:224;--i:8">O</span><span style="--h:252;--i:9">I</span><span style="--h:280;--i:10">R</span></h1>
      <span class="home">HOME</span>
      <span class="tag">scan once · play everything</span>
    </div>
    <div id="room"><canvas width="33" height="33" aria-label="QR code to join on your phone"></canvas><div class="txt"><div class="lbl">SCAN ONCE ON YOUR PHONE<b id="roomUrl">pointcast.xyz/brick-choir/home-join</b></div><div class="code" id="roomCode">····</div><div class="st connecting" id="roomSt"><i></i><span id="roomStTxt">connecting</span></div></div></div>
  </header>

  <section id="tiles" aria-label="Choose a cabinet"></section>

