function doNavigate(){ const g=launchG; if(!g) return; PARTY.go(g.id); saveRoster(); saveDay(); setTimeout(()=>{ location.href=`${g.path}?room=${ROOM}&hub=1${PASS?'&'+PASS:''}`; },250); }
function openKeys(g){ keysOpen=true; keysG=g; okSound(); const wrap=$('keys'); const f=document.createElement('iframe'); f.src=g.path+(PASS?'?'+PASS:''); f.title=g.name; f.allow='autoplay'; wrap.insertBefore(f,wrap.firstChild); wrap.hidden=false; setState('keys'); PARTY.go(g.id); setTimeout(()=>{ try{ f.contentWindow.focus(); f.contentWindow.addEventListener('keydown',keyFromFrame); f.contentWindow.addEventListener('keyup',keyFromFrame); }catch(e){} f.focus(); },300); f.addEventListener('load',()=>{ try{ f.contentWindow.focus(); f.contentWindow.addEventListener('keydown',keyFromFrame); f.contentWindow.addEventListener('keyup',keyFromFrame); }catch(e){} }); }
function closeKeys(){ if(!keysOpen) return; keysOpen=false; keysG=null; const wrap=$('keys'); wrap.querySelectorAll('iframe').forEach(f=>f.remove()); wrap.hidden=true; escHeld=0; $('exitBar').style.width='0'; lastInput=now(); setState('menu'); PARTY.go('home'); }
function keyFromFrame(e){ if(e.code!=='Escape'&&e.code!=='Backspace'&&e.code!=='BrowserBack') return; if(e.type==='keydown'){ if(!escHeld) escHeld=now(); } else escHeld=0; }

/* ================= Sports Day ================= */
function startDay(){ day={i:0,log:[]}; medals={}; saveMedals(); saveDay(); renderDay(); renderMedals(); okSound(); cdFrom=now(); setState('dayintro'); if(ctx){ const t=ctx.currentTime+0.05; [0,4,7,12,16,19].forEach((d,i)=>tone(60+d,{t:t+i*0.09,kind:'lead',vel:0.8,len:0.3})); drum('crash',{t,vel:0.4}); } }
function cancelDay(){ day=null; saveDay(); renderDay(); renderMedals(); }

/* ================= overlays ================= */
const MENUS={medals:()=>nextG?[['next',`NEXT: ${DAY_NAMES[nextG.id]} ▸`],['home','STAY HOME']]:[['home','BACK TO THE MENU']],ceremony:()=>[['home','BACK TO THE MENU'],['day','SPORTS DAY AGAIN']],dayintro:()=>[['skip','START RALLY ▸'],['cancel','NOT NOW']],launch:()=>[['cancel','CANCEL']]};
const menuHtml=s=>MENUS[s]?`<div class="menu">${MENUS[s]().map(([a,t])=>`<button data-act="${a}">${t}</button>`).join('')}</div><div class="okhint"><kbd>◀</kbd><kbd>▶</kbd> choose · <kbd>OK</kbd> select</div>`:'';
function applyFocus(){ const bs=document.querySelectorAll('#ui .menu button'); if(!bs.length) return; menuFocus=Math.max(0,Math.min(bs.length-1,menuFocus)); bs.forEach((b,i)=>b.classList.toggle('focus',i===menuFocus)); }
function focusMenu(){ menuFocus=0; applyFocus(); }
function moveMenu(d){ const bs=document.querySelectorAll('#ui .menu button'); if(!bs.length) return false; menuFocus=(menuFocus+d+bs.length)%bs.length; applyFocus(); tick(); return true; }
function activateMenu(){ const b=document.querySelector('#ui .menu button.focus'); if(!b) return false; menuAct(b.dataset.act); return true; }
function menuAct(a){ okSound(); lastInput=now();
  if(a==='next'){ if(nextG){ const g=nextG; nextG=null; launch(g); } }
  else if(a==='home'){ confetti(false); nextG=null; setState('menu'); }
  else if(a==='day'){ confetti(false); startDay(); }
  else if(a==='skip'){ if(state==='dayintro') launch(byId(DAY[0])); }
  else if(a==='cancel'){ if(state==='launch'){ launchG=null; setState('menu'); PARTY.go('home'); } else if(state==='dayintro'){ cancelDay(); setState('menu'); } } }
const podiumHtml=(list,{scores=true}={})=>`<div class="podium">${list.map((h,i)=>{ const r=roster.find(x=>x.n===h.n); const c=r?PAL[r.c%8].hex:'#f4f0ff'; return `<div style="--c:${c}"><em>${h.medal?`<span class="medal ${h.medal}">${h.medal.toUpperCase()}</span>`:''}${ORD[i]||''}</em><b>${esc(h.n)}</b>${scores?`<span>${Number(h.s||0).toLocaleString()}</span>`:''}${h.small?`<small>${esc(h.small)}</small>`:''}</div>`; }).join('')}</div>`;
function renderUI(force){ const ui=$('ui'); let html='', key=state; const T=now();
  if(state==='launch'&&launchG){ const g=launchG; const left=Math.max(0,launchAt-T); key+=Math.ceil(left/1000);
    html=`<div class="panel" style="--c:${g.hex}"><div class="mono">GET YOUR PHONES READY</div><h1>${esc(g.name).toUpperCase()}</h1><div class="ring" style="--c:${g.hex};--p:${(1-left/3400).toFixed(3)}"><b>${Math.ceil(left/1000)}</b></div><div class="who">${phones().map(r=>`<span class="chip" style="--c:${PAL[r.c%8].hex}"><i>${roster.indexOf(r)+1}</i>${esc(r.n)}</span>`).join('')||'<span class="mono">no phones yet — the TV keyboard and gamepads still play</span>'}</div><p class="mono">your phones follow the TV · no rescanning</p>${menuHtml('launch')}</div>`; }
  else if(state==='dayintro'){ const left=Math.max(0,4000-(T-cdFrom)); key+=Math.ceil(left/1000);
    html=`<div class="panel" style="--c:#ffd27a"><div class="mono">THREE GAMES · MEDALS AFTER EACH</div><h1>SPORTS DAY</h1><div class="who" style="margin-top:1.4vw">${DAY.map((id,i)=>`<span class="chip" style="--c:${byId(id).hex}"><i>${i+1}</i>${DAY_NAMES[id]}</span>`).join('')}</div><p class="mono">first up in <b>${Math.ceil(left/1000)}</b></p>${menuHtml('dayintro')}</div>`; }
  else if(state==='medals'&&lastPodium){ const {g,hum,podium}=lastPodium; const cd=nextG?Math.max(0,12000-(T-cdFrom)):0; key+=Math.ceil(cd/1000)+(nextG?nextG.id:'');
    const rows=medalRows().slice(0,4);
    html=`<div class="panel" style="--c:${g.hex}"><div class="mono">${esc(g.name).toUpperCase()} · RESULTS</div><h1>${(g_=>g_.length>1?g_.map(x=>esc(x.n)).join(' & ')+' SHARE GOLD':g_.length?esc(g_[0].n)+' TAKES GOLD':'NO MEDALS THIS TIME')(podium.filter(x=>x.medal==='g'))}</h1>${podiumHtml(podium.length?podium:hum.slice(0,3))}
      ${rows.length?`<div class="mono" style="margin-top:1.4vw">MEDAL TABLE · ${rows.map(r=>`<b>${esc(r.n)}</b> ${r.pt}`).join(' · ')}</div>`:''}
      ${nextG?`<p class="mono">next up: <b>${DAY_NAMES[nextG.id]}</b> in <b>${Math.ceil(cd/1000)}</b></p>`:''}${menuHtml('medals')}</div>`; }
  else if(state==='ceremony'){ const rows=medalRows(); const top=rows.slice(0,3).map((r,i)=>({n:r.n,s:r.pt,medal:['g','s','b'][i],small:`${r.g} gold · ${r.s} silver · ${r.b} bronze`}));
    html=`<div class="panel" style="--c:#ffd27a"><div class="mono">SPORTS DAY · THE CEREMONY</div><h1>${top[0]?esc(top[0].n)+' WINS THE DAY':'SPORTS DAY IS OVER'}</h1>${podiumHtml(top)}<p class="mono">${day?'':'gold 3 · silver 2 · bronze 1'}</p>${menuHtml('ceremony')}</div>`; }
  if(key!==uiKey||force){ uiKey=key; ui.innerHTML=html; applyFocus(); } }
$('ui').addEventListener('click',e=>{ const m=e.target.closest('.menu button[data-act]'); if(m){ bootAudio(); menuAct(m.dataset.act); } });

/* ================= input: remote / keyboard / gamepad / mouse ================= */
function onNav(dir){ lastInput=now(); if(document.body.classList.contains('attract')) leaveAttract(); if(state!=='menu'){ if(dir==='left'||dir==='up') moveMenu(-1); else moveMenu(1); return; }
  if(focus<5){ if(dir==='left') setFocus(focus-1); else if(dir==='right') setFocus(focus+1); else if(dir==='down') setFocus(5); }
  else { if(dir==='up') setFocus(2); else if(dir==='left') setFocus(4); else if(dir==='right') setFocus(0); } }
function onOk(){ lastInput=now(); if(document.body.classList.contains('attract')){ leaveAttract(); return; } if(state==='menu'){ if(focus===5){ if(day) launch(byId(DAY[Math.min(day.i,DAY.length-1)])); else startDay(); } else launch(GAMES[focus]); } else activateMenu(); }
function onBack(){ lastInput=now(); if(state==='launch') menuAct('cancel'); else if(state==='medals'){ if(day){ cancelDay(); } nextG=null; menuAct('home'); } else if(state==='ceremony') menuAct('home'); else if(state==='dayintro') menuAct('cancel'); }
addEventListener('keydown',e=>{ if(e.metaKey||e.ctrlKey||e.altKey) return; if(keysOpen){ keyFromFrame(e); return; } const c=e.code;
  if(c==='ArrowLeft'){ e.preventDefault(); onNav('left'); } else if(c==='ArrowRight'){ e.preventDefault(); onNav('right'); } else if(c==='ArrowUp'){ e.preventDefault(); onNav('up'); } else if(c==='ArrowDown'){ e.preventDefault(); onNav('down'); }
  else if(c==='Enter'||c==='Space'||c==='NumpadEnter'){ e.preventDefault(); onOk(); } else if(c==='Escape'||c==='Backspace'||c==='BrowserBack'){ e.preventDefault(); onBack(); }
  else if(/^Digit[1-5]$/.test(c)){ lastInput=now(); leaveAttract(); if(state==='menu') setFocus(Number(e.key)-1); } else if(c==='KeyS'){ lastInput=now(); leaveAttract(); if(state==='menu') setFocus(5); } });
addEventListener('keyup',e=>{ if(keysOpen) keyFromFrame(e); });
tiles.forEach((t,i)=>{ t.addEventListener('pointerenter',()=>{ if(state==='menu'){ lastInput=now(); leaveAttract(); setFocus(i); } }); t.addEventListener('click',()=>{ lastInput=now(); leaveAttract(); if(state==='menu'){ setFocus(i); launch(GAMES[i]); } }); });
dayTile.addEventListener('pointerenter',()=>{ if(state==='menu'){ lastInput=now(); leaveAttract(); setFocus(5); } }); dayTile.addEventListener('click',()=>{ if(state==='menu'){ setFocus(5); onOk(); } });
const padSt={}; let padAxisT=0;
function pollPads(T){ const pads=navigator.getGamepads?navigator.getGamepads():[]; for(const gp of pads){ if(!gp) continue; const st=padSt[gp.index]||(padSt[gp.index]={b:[],ax:0});
  gp.buttons.forEach((b,i)=>{ const p=b.pressed; if(p&&!st.b[i]){ if(i===0) onOk(); else if(i===1) onBack(); else if(i===12) onNav('up'); else if(i===13) onNav('down'); else if(i===14) onNav('left'); else if(i===15) onNav('right'); else if(i===9) onOk(); } st.b[i]=p; });
  const ax=gp.axes[0]||0, ay=gp.axes[1]||0; if(T-padAxisT>260){ if(ax<-0.55){ onNav('left'); padAxisT=T; } else if(ax>0.55){ onNav('right'); padAxisT=T; } else if(ay<-0.55){ onNav('up'); padAxisT=T; } else if(ay>0.55){ onNav('down'); padAxisT=T; } } } }

/* ================= attract ================= */
function enterAttract(){ if(document.body.classList.contains('attract')) return; document.body.classList.add('attract'); attractI=focus; attractT=now(); }
function leaveAttract(){ if(!document.body.classList.contains('attract')) return; document.body.classList.remove('attract'); $('attractLine').textContent=''; }
function attractTick(T){ if(state!=='menu'||keysOpen) { leaveAttract(); return; } if(!document.body.classList.contains('attract')){ if(T-lastInput>45000&&!phones().length) enterAttract(); return; }
  if(T-attractT>4200){ attractT=T; attractI=(attractI+1)%6; setFocus(attractI,{silent:true}); const g=attractI<5?GAMES[attractI]:null; $('attractLine').innerHTML=g?`<b style="--c:${g.hex}">${esc(g.name)}</b> · ${esc(g.line)}`:`<b style="--c:#ffd27a">Sports Day</b> · three games, one medal table, a ceremony at the end`; }
  if(phones().length) leaveAttract(); }

/* ================= the party relay: phones on the hub ================= */
const PARTY=(()=>{
  const X={net:null,status:'off',transport:null,lastSt:'',lastStT:0,pruneT:0,homeT:0,homeN:0};
  const setStatus=(s,t)=>{ X.status=s; X.transport=t; const el=$('roomSt'); el.className='st '+s; $('roomStTxt').textContent=s==='on'?(t==='drum'?'live':'live · relay'):s; if(s==='on'){ X.roster(); X.state(true); } };
  const seatOf=id=>roster.find(r=>r.p===id)||null;
  function join(id,name,want){ let r=seatOf(id); const fresh=!r; if(r){ if(name&&r.n!==name){ r.n=name; saveRoster(); } } else { if(roster.length>=8){ const gone=roster.find(x=>!x.here); if(!gone) return null; roster.splice(roster.indexOf(gone),1); } const used=new Set(roster.map(x=>x.c)); let c=Number.isInteger(want)&&want>=0&&want<8&&!used.has(want)?want:[0,1,2,3,4,5,6,7].find(i=>!used.has(i)); if(c===undefined) c=roster.length%8; r={p:id,n:name,c,seen:now(),vote:-1,here:false}; roster.push(r); saveRoster(); }
    const arrived=!r.here; r.here=true; r.seen=now(); if(arrived){ joinSound(r); lastInput=now(); leaveAttract(); } renderRoster(); if(fresh&&medals[name]) { medals[name].c=r.c; renderMedals(); } return r; }
  function drop(id){ const r=seatOf(id); if(!r) return; r.here=false; r.vote=-1; renderRoster(); X.roster(); }
  function vote(r,i){ if(state!=='menu'||!Number.isInteger(i)||i<-1||i>5) return; r.vote=i; lastInput=now(); leaveAttract(); renderVotes();
    if(i>=0){ const counts={}; phones().forEach(x=>{ if(x.vote>=0) counts[x.vote]=(counts[x.vote]||0)+1; }); const top=Object.entries(counts).sort((a,b)=>b[1]-a[1])[0]; if(top) setFocus(+top[0]); tone(72+i*2,{kind:PAL[r.c%8].kind,len:0.08,vel:0.4});
      const ph=phones(); if(ph.length&&ph.every(x=>x.vote===i)){ ph.forEach(x=>x.vote=-1); renderVotes(); if(i===5){ if(day) launch(byId(DAY[Math.min(day.i,DAY.length-1)])); else startDay(); } else launch(GAMES[i]); } } X.state(true); }
  function cmd(r,c){ if(c==='go'){ if(roster.indexOf(r)!==0) return; lastInput=now(); leaveAttract(); if(state==='menu') onOk(); else activateMenu(); } else if(c==='day'){ if(roster.indexOf(r)!==0||state!=='menu') return; startDay(); } else if(c==='home'){ if(keysOpen) closeKeys(); else if(state!=='menu') onBack(); } else if(c==='skip'){ if(state==='medals'&&nextG) menuAct('next'); else if(state==='dayintro') menuAct('skip'); } else if(c==='back'){ if(roster.indexOf(r)===0) onBack(); } }
  X.onFrame=d=>{ if(!d||typeof d!=='object'||d.o==='tv') return; const id=d.p; if(typeof id!=='string'||!id||id.length>12) return; const r=seatOf(id); if(r) r.seen=now();
    switch(d.f){
      case 'hhi': if(r&&!r.here) join(id,r.n); X.roster(); X.state(true); if(r) X.ok(r); break;
      case 'hj': { const name=String(d.n||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3)||'???'; const q=join(id,name,Number.isInteger(d.c)?d.c:-1); if(!q){ X.send({f:'full',p:id}); break; } X.ok(q); X.roster(); X.state(true); break; }
      case 'v': if(r) vote(r,d.i|0); else X.send({f:'who',p:id}); break;
      case 'cmd': if(r) cmd(r,String(d.c||'')); else X.send({f:'who',p:id}); break;
      case 'l': drop(id); break;
      case 'pp': X.send({f:'pq',p:id,t:d.t}); break;
    } };
  X.send=d=>!!(X.net&&X.net.send(d));
  X.ok=r=>X.send({f:'hok',p:r.p,s:roster.indexOf(r),n:r.n,c:r.c});
  X.roster=()=>X.send({f:'hr',s:roster.map(r=>r.n),c:roster.map(r=>r.c),h:roster.map(r=>r.here?1:0)});
  X.go=g=>X.send({f:'go',g,r:ROOM});
  X.state=force=>{ const cd=state==='launch'?Math.ceil(Math.max(0,launchAt-now())/1000):state==='medals'&&nextG?Math.ceil(Math.max(0,12000-(now()-cdFrom))/1000):0;
    const s={f:'hs',sc:state,fo:focus,v:roster.map(r=>r.here?r.vote:-1),g:state==='launch'&&launchG?launchG.id:state==='medals'&&nextG?nextG.id:keysOpen&&keysG?keysG.id:'',cd,d:day?1:0};
    const key=JSON.stringify(s), T=now(), minIv=X.transport==='room'?500:150; if(!force){ if(key===X.lastSt&&T-X.lastStT<3000) return; if(T-X.lastStT<minIv) return; } X.lastSt=key; X.lastStT=T; X.send(s); };
  X.tick=T=>{ X.state(false); if(T-X.pruneT>2000){ X.pruneT=T; roster.forEach(r=>{ if(r.here&&T-r.seen>45000) drop(r.p); }); }
    // the first half minute after a boot: keep calling phones that are still on a game's join page home
    if(X.status==='on'&&X.homeN<6&&T-X.homeT>5000&&!keysOpen&&state!=='launch'){ X.homeT=T; X.homeN++; X.go('home'); } };
  X.start=()=>{ X.net=makeParty({code:ROOM,pid:'tv',onFrame:X.onFrame,onStatus:setStatus}); };
  X.seatOf=seatOf; X.join=join; X.drop=drop; return X;
})();

/* ================= the frame ================= */
function frame(){ const T=now(); groove(T); pollPads(T); attractTick(T);
  if(state==='launch'&&launchG&&T>=launchAt){ launchAt=Infinity; doNavigate(); }
  if(state==='dayintro'&&T-cdFrom>4000){ launch(byId(DAY[0])); }
  if(state==='medals'&&nextG&&T-cdFrom>12000){ menuAct('next'); }
  if(state==='medals'&&!nextG&&day&&day.i>=DAY.length&&T-cdFrom>6000){ ceremony(); }
  if(keysOpen){ if(escHeld){ const p=Math.min(1,(T-escHeld)/1200); $('exitBar').style.width=(p*100)+'%'; if(p>=1) closeKeys(); } else if($('exitBar').style.width!=='0px'&&$('exitBar').style.width!=='0') $('exitBar').style.width='0'; }
  if(state!=='menu') renderUI(false);
  requestAnimationFrame(frame); }

/* ================= boot ================= */
renderRoster(); renderDay(); renderMedals(); setFocus(day?5:2,{silent:true});
if(result&&result.g){ showResult(result); } else setState('menu');
PARTY.start(); nextStep=now(); requestAnimationFrame(frame);
if(TESTMODE) window.__hub={get state(){return state;},get focus(){return focus;},get roster(){return roster;},get medals(){return medals;},get day(){return day;},get party(){return PARTY;},get room(){return ROOM;},get launchG(){return launchG;},get nextG(){return nextG;},get keysOpen(){return keysOpen;},get menu(){return [...document.querySelectorAll('#ui .menu button')].map(b=>[b.dataset.act,b.classList.contains('focus')]);},get attract(){return document.body.classList.contains('attract');},
  launch:id=>launch(byId(id)),startDay,setState,showResult,closeKeys,set lastInput(v){ lastInput=v; },set launchAt(v){ launchAt=v; },set cdFrom(v){ cdFrom=v; },menuAct,setFocus,onOk,onBack};
</script>
</body>
</html>
