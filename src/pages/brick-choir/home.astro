function tick(){ tone(72+focus*3,{kind:'marimba',len:0.05,vel:0.35}); }
function okSound(){ tone(79,{kind:'lead',len:0.08,vel:0.5}); }
function grooveStep(t,i){ const bar=i%16, soft=state==='attract'?0.6:1; const e=state==='launch'||state==='dayintro'?1.2:1;
  if(bar===0||bar===8) drum('kick',{t,vel:0.5*soft*e}); if(bar===12) drum('kick',{t,vel:0.3*soft});
  if(bar===4||bar===12) drum('snare',{t,vel:0.18*soft}); if(bar%2===1) drum('hat',{t,vel:0.28*soft}); else drum('shaker',{t,vel:0.16*soft});
  const g=GAMES[Math.min(focus,4)]||GAMES[2]; if(bar===0) tone(36,{t,kind:'bass',len:0.28,vel:0.45*soft}); if(bar===6) tone(43,{t,kind:'bass',len:0.18,vel:0.35*soft});
  if(state==='attract'&&bar%4===2) tone(72+g.deg[(i>>2)%4],{t,kind:PAL[focus%8].kind,len:0.12,vel:0.22}); }
function groove(T){ // the visual pulse runs off the clock; the drums are scheduled a little ahead when the speakers are on
  if(T<nextStep) return; nextStep+=STEP*1000; if(nextStep<T-2000) nextStep=T+STEP*1000; stepI++;
  if(stepI%4===0){ document.body.classList.add('beat'); setTimeout(()=>document.body.classList.remove('beat'),140); const tiles=[...document.querySelectorAll('.tile')]; tiles.forEach(t=>t.classList.remove('lit')); const lit=tiles[((stepI>>2)%tiles.length)]; if(lit&&state==='menu'&&!document.body.classList.contains('attract')) lit.classList.add('lit'); }
