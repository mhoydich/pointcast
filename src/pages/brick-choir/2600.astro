  .tv{position:relative;background:var(--bezel);border-radius:22px;padding:14px;box-shadow:inset 0 2px 0 rgba(255,255,255,.5),inset 0 -3px 0 rgba(0,0,0,.18),0 3px 0 rgba(0,0,0,.25);}
  .screen{position:relative;border-radius:18px/22px;overflow:hidden;background:#0d1211;aspect-ratio:4/3;box-shadow:inset 0 0 40px rgba(0,0,0,.8);}
  canvas#game{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;}
  .glass{position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    background:radial-gradient(ellipse at 30% 18%,rgba(255,255,255,.07),transparent 45%),radial-gradient(ellipse at 50% 50%,transparent 60%,rgba(0,0,0,.45));}
  /* switch bank */
  .switches{display:flex;gap:10px;justify-content:space-between;align-items:flex-end;margin-top:14px;flex-wrap:wrap;}
  .sw{display:flex;flex-direction:column;align-items:center;gap:5px;min-width:78px;}
  .sw button{appearance:none;border:0;cursor:pointer;width:46px;height:26px;border-radius:5px;position:relative;
    background:linear-gradient(180deg,#2b2f2d,#121413);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 2px 0 rgba(0,0,0,.4);}
  .sw button::after{content:"";position:absolute;left:6px;top:5px;width:14px;height:16px;border-radius:3px;background:linear-gradient(180deg,#e9e4d8,#a9a295);transition:left .12s;}
  .sw button[aria-pressed="true"]::after{left:26px;}
  .sw button.push::after{left:16px;}
  .sw button.push:active::after{top:7px;}
  .sw button:focus-visible{outline:2px solid var(--mustard);outline-offset:2px;}
  .sw label{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#f3e7cf;opacity:.85;text-align:center;line-height:1.35;}
  .sw label b{font-weight:600;color:var(--mustard);}
  .cart{flex:1;min-width:200px;align-self:center;display:flex;align-items:center;gap:10px;background:#101211;border-radius:6px;padding:7px 12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.06);}
  .cart .stripes{display:flex;flex-direction:column;gap:2px;}
  .cart .stripes i{display:block;width:26px;height:3px;border-radius:1px;}
  .cart .t{font-weight:600;font-size:14px;letter-spacing:.14em;text-transform:uppercase;}
  .cart .s{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--chrome);}
  /* overlay poster cards */
  .ov{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:4%;box-sizing:border-box;}
  .card{position:relative;background:var(--cream);color:var(--char);border-radius:6px;width:min(100%,560px);max-height:100%;overflow:auto;box-sizing:border-box;
    padding:22px 24px 20px;box-shadow:0 12px 30px rgba(0,0,0,.45);text-align:left;}
  .card .art{float:right;width:38%;margin:0 0 8px 14px;border-radius:3px;aspect-ratio:4/5;object-fit:cover;background:var(--teal);}
  .card .eyebrow{font-size:10.5px;font-weight:600;letter-spacing:.26em;text-transform:uppercase;color:var(--orange);}
  .card h2{font-weight:700;font-size:34px;line-height:1;letter-spacing:.02em;margin:8px 0 10px;text-transform:uppercase;text-wrap:balance;}
  .card h2 em{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:0;color:var(--tomato);}
  .card p{font-size:14px;line-height:1.5;margin:6px 0;color:#3a3f3d;}
  .card .verse{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--char);}
  .card .credit{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#6d6a60;margin-top:6px;}
  .card .bands{display:flex;gap:4px;margin:10px 0 4px;} .card .bands i{flex:1;height:5px;border-radius:1px;}
  .card .how{display:grid;grid-template-columns:auto 1fr;gap:5px 12px;font-size:13px;margin:10px 0;clear:both;}
  .card .how kbd{font-family:var(--mono);font-size:11px;background:var(--char);color:var(--cream);border-radius:3px;padding:2px 6px;justify-self:start;white-space:nowrap;}
  .btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;clear:both;}
  .card button{font-family:var(--jost);font-weight:600;font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;
    background:transparent;color:var(--char);border:2px solid var(--char);border-radius:999px;padding:8px 16px;}
  .card button.primary{background:var(--char);color:var(--cream);}
  .card button:disabled{opacity:.35;cursor:default;}
  .card button:focus-visible{outline:3px solid var(--mustard);outline-offset:2px;}
  .rounds{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:12px;clear:both;}
  .rounds button{border-radius:4px!important;padding:6px 8px!important;font-size:10px!important;letter-spacing:.08em!important;text-align:left;border-width:1.5px!important;line-height:1.3;}
  .rounds button small{display:block;font-weight:500;opacity:.6;}
  .rounds button.done{background:rgba(141,154,60,.18);}
  .rounds button.spell{border-color:var(--tomato)!important;}
  #status{font-size:12px;margin-top:8px;color:var(--teal);min-height:1em;}
  /* touch keys */
  .touch{display:none;margin-top:12px;flex-direction:column;gap:5px;}
  .touch .r{display:flex;gap:4px;}
  .touch button{flex:1;height:46px;border:0;border-radius:6px;font-family:var(--mono);font-size:13px;color:var(--char);background:var(--cream);box-shadow:0 3px 0 rgba(0,0,0,.35);padding:0;}
  .touch button.on{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.35);}
  .touch .r.q button{background:#f0c9a5;} .touch .r.a button{background:#f3dca4;} .touch .r.z button{background:#d9dcaa;}
  footer{margin-top:10px;font-size:11px;letter-spacing:.06em;color:#b5a88f;text-align:center;}
  footer a{color:#e0cfa9;}
  @media (pointer:coarse){ .touch{display:flex;} footer .kbd-only{display:none;} }
  @media (max-width:700px){ .body{padding:12px;} .tv{padding:8px;border-radius:14px;} .card{padding:16px;} .card h2{font-size:26px;} .card .art{display:none;} .rounds{grid-template-columns:repeat(2,1fr);} .sw{min-width:60px;} .cart{order:-1;flex-basis:100%;} body{overflow:auto;justify-content:flex-start;} }
</style>
</head>
