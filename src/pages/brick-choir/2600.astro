const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const DRUMS=['kick','snare','hat','open','clap','rim','tom','high','shaker','crash'];
let ctx=null, master, comp, wet, fb, send, lpf, muted=false, hifi=false, pulseWave=null;
function makeIR(sec,dec){ const n=ctx.sampleRate*sec,b=ctx.createBuffer(2,n,ctx.sampleRate); for(let c=0;c<2;c++){const d=b.getChannelData(c); for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,dec);} return b; }
function boot(){
  if(ctx){ if(ctx.state==='suspended') ctx.resume(); return; }
  try{ ctx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ ctx=null; return; }
  comp=ctx.createDynamicsCompressor(); comp.threshold.value=-12; comp.ratio.value=4;
  lpf=ctx.createBiquadFilter(); lpf.type='lowpass'; lpf.frequency.value=5200;   // the TV speaker
  master=ctx.createGain(); master.gain.value=muted?0:0.62; master.connect(lpf); lpf.connect(comp); comp.connect(ctx.destination);
  const conv=ctx.createConvolver(); conv.buffer=makeIR(1.8,3.2); wet=ctx.createGain(); wet.gain.value=0.16; wet.connect(conv); conv.connect(master);
  const dl=ctx.createDelay(2); fb=ctx.createGain(); fb.gain.value=0.22; const dlf=ctx.createBiquadFilter(); dlf.type='lowpass'; dlf.frequency.value=2400;
  send=ctx.createGain(); send.gain.value=0.14; send.connect(dl); dl.connect(dlf); dlf.connect(fb); fb.connect(dl); dlf.connect(master); dl.delayTime.value=0.3; master._dl=dl;
  // 25% pulse, the 2600's favourite shape
  const n=32, re=new Float32Array(n), im=new Float32Array(n); for(let k=1;k<n;k++){ im[k]=(2/(k*Math.PI))*Math.sin(k*Math.PI*0.25); } pulseWave=ctx.createPeriodicWave(re,im);
}
const mtof=m=>440*Math.pow(2,(m-69)/12);
function voice(midi,{t,vel=0.8,len=0.16,kind='lead',pan=0}={}){
  if(!ctx||muted) return; t=t||ctx.currentTime; const f=mtof(midi);
  const o=ctx.createOscillator(), g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=pan;
  if(hifi){ // soft FM bell
    o.type='triangle'; const m=ctx.createOscillator(), mg=ctx.createGain(); m.frequency.value=f*2; mg.gain.setValueAtTime(f*1.4*vel,t); mg.gain.exponentialRampToValueAtTime(f*0.02,t+0.25); m.connect(mg); mg.connect(o.frequency); m.start(t); m.stop(t+len+1.2);
    o.frequency.value=f;
  } else { o.setPeriodicWave(pulseWave); if(kind==='lead'){ o.frequency.setValueAtTime(f*1.012,t); o.frequency.exponentialRampToValueAtTime(f,t+0.03); } else o.frequency.value=f; }
  const pk=(kind==='lead'?0.34:kind==='brick'?0.16:kind==='bass'?0.26:0.1)*(0.4+0.6*vel)*(hifi?1.15:1);
  const rel=hifi?(kind==='bass'?0.3:0.9):(kind==='pad'?0.4:0.09);
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(pk,t+(kind==='pad'?0.08:0.004)); g.gain.setValueAtTime(pk*0.7,t+len); g.gain.exponentialRampToValueAtTime(0.0001,t+len+rel);
  o.connect(g); g.connect(p); p.connect(master); if(kind!=='bass'){ p.connect(wet); p.connect(send); }
  o.start(t); o.stop(t+len+rel+0.05);
}
function noise(d){ const b=ctx.createBuffer(1,Math.max(1,ctx.sampleRate*d),ctx.sampleRate), x=b.getChannelData(0); for(let i=0;i<x.length;i++) x[i]=Math.random()*2-1; const s=ctx.createBufferSource(); s.buffer=b; return s; }
function env(g,t,pk,dec){ g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(pk,t+0.003); g.gain.exponentialRampToValueAtTime(0.0001,t+dec); }
function perc(kind,{t,vel=0.8}={}){
  if(!ctx||muted) return; t=t||ctx.currentTime; const g=ctx.createGain(); g.connect(master); const v=0.35+0.65*vel;
  const osc=(type,f0,f1,dec,pk)=>{ const o=ctx.createOscillator(); if(type==='pulse') o.setPeriodicWave(pulseWave); else o.type=type; o.frequency.setValueAtTime(f0,t); o.frequency.exponentialRampToValueAtTime(f1,t+dec*0.6); const og=ctx.createGain(); env(og,t,pk,dec); o.connect(og); og.connect(g); o.start(t); o.stop(t+dec+0.05); };
  const hiss=(dec,pk,type,f,q)=>{ const n=noise(dec+0.05), bf=ctx.createBiquadFilter(); bf.type=type; bf.frequency.value=f; bf.Q.value=q||1; const ng=ctx.createGain(); env(ng,t,pk,dec); n.connect(bf); bf.connect(ng); ng.connect(g); n.start(t); n.stop(t+dec+0.05); };
  switch(kind){
    case 'kick': osc(hifi?'sine':'pulse',hifi?140:110,40,0.28,0.55*v); break;
    case 'snare': osc('triangle',220,160,0.1,0.25*v); hiss(0.14,0.3*v,'highpass',1800); break;
    case 'hat': hiss(0.035,0.12*v,'highpass',8000); break;
    case 'open': hiss(0.3,0.16*v,'highpass',6500); break;
    case 'clap': hiss(0.12,0.3*v,'bandpass',1600,1.2); break;
    case 'rim': osc('square',1100,900,0.03,0.16*v); break;
    case 'tom': osc(hifi?'sine':'pulse',150,90,0.26,0.4*v); break;
    case 'high': osc(hifi?'sine':'pulse',230,150,0.22,0.36*v); break;
    case 'shaker': hiss(0.07,0.12*v,'bandpass',9000,2); break;
    case 'crash': hiss(1.1,0.22*v,'highpass',5000); break;
    case 'wall': osc('square',hifi?520:330,hifi?480:300,0.025,0.05); break;
    case 'miss': osc(hifi?'sine':'pulse',180,55,0.5,0.35); break;
  }
}

/* ---- the groove: layers come in as your streak grows ---- */
let seqNext=0, seqStep=0, streak=0, groove=0;
const LAYERS=[{at:2,name:'pulse'},{at:5,name:'hats'},{at:9,name:'bass'},{at:14,name:'arp'},{at:20,name:'choir'}];
function grooveLevel(){ let l=0; LAYERS.forEach((L,i)=>{ if(streak>=L.at) l=i+1; }); return l; }
function scheduler(){
  if(!ctx||!lvl||state!=='play'){ seqNext=0; return; }
  const spb=60/(lvl.bpm||104), s16=spb/4; if(!seqNext) seqNext=ctx.currentTime+0.05;
  while(seqNext<ctx.currentTime+0.12){
    const st=seqStep%16, t=seqNext, gl=groove;
    const sc=SCALES[lvl.scale]||SCALES.minpent, root=36+lvl.root;
    const deg=d=>root+Math.floor(d/sc.steps.length)*12+sc.steps[((d%sc.steps.length)+sc.steps.length)%sc.steps.length];
    if(gl>=1&&st%8===0) perc('kick',{t,vel:0.7});
    if(gl>=1&&st===8&&gl>=3) perc('snare',{t,vel:0.5});
    if(gl>=2&&st%2===0) perc('hat',{t,vel:st%4===2?0.8:0.4});
    if(gl>=3&&st%4===0){ const bassPat=[0,0,sc.steps.length>5?4:3,0]; voice(deg(bassPat[(st/4)|0]),{t,kind:'bass',len:s16*2.5,vel:0.7}); }
    if(gl>=4){ const arp=[0,2,4,7,4,2,5,7]; voice(deg(arp[st%8])+24,{t,kind:'brick',len:s16*0.7,vel:0.35,pan:(st%2?0.3:-0.3)}); }
    if(gl>=5&&st===0){ [0,2,4].forEach(d=>voice(deg(d)+12,{t,kind:'pad',len:spb*3.6,vel:0.4})); }
    seqNext+=s16; seqStep++;
  }
}
function nextStep(){ if(!ctx||!lvl||!seqNext||groove<1) return ctx?ctx.currentTime:0; const s16=60/(lvl.bpm||104)/4, t=ctx.currentTime; const k=Math.floor((seqNext-t)/s16); const cand=seqNext-k*s16; return (cand>=t&&cand-t<=0.06)?cand:t; }
function midiFor(code){ const c=cell[code]; const sc=SCALES[lvl.scale]||SCALES.minpent; const i=ROWS[c.row].codes.indexOf(code); const deg=i+c.rowIdx*sc.rowOff; return 48+lvl.root+Math.floor(deg/sc.steps.length)*12+sc.steps[deg%sc.steps.length]; }

/* ============ state ============ */
const cv=document.getElementById('game'), g=cv.getContext('2d');
const lr=document.createElement('canvas'); lr.width=W; lr.height=H; const L=lr.getContext('2d'); L.imageSmoothingEnabled=false;
const $=id=>document.getElementById(id);
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const store={get(k,d){try{const v=localStorage.getItem('bc2:'+k);return v?JSON.parse(v):d;}catch(e){return d;}},set(k,v){try{localStorage.setItem('bc2:'+k,JSON.stringify(v));}catch(e){}}};
let cleared=new Set(store.get('cleared',[])), lineIdx=store.get('line',0);
let lvl=null, lvlI=0, rule=RULES[0], bricks=new Map(), balls=[], pads=new Map(), caps=[], fx=[], flashes=[], score=0, lives=3, state='title';
let wide=store.get('wide',true), meter=0, sweeps=3, effects={}, rally=[], rallyT0=0, catchNotes=[], tunnelN=0, phraseI=0, runStep=0, shake=0, bgPulse=0, lastT=performance.now();
const now=()=>performance.now();

function loadLevel(i){
  lvlI=i; lvl=LEVELS[i]; rule=RULES[Math.min(i,RULES.length-1)]||RULES[0];
  bricks=new Map(); caps=[]; fx=[]; pads=new Map(); rally=[]; catchNotes=[]; rallyT0=now();
  for(const [code,h] of Object.entries(lvl.bricks||{})){ if(!cell[code]) continue; bricks.set(code,{code,hp:h===9?Infinity:Math.max(1,Math.min(2,h|0)),max:h===9?9:Math.max(1,Math.min(2,h|0)),cap:(lvl.capsules||[]).includes(code),flash:0}); }
  lives=3; streak=0; groove=0; meter=0; sweeps=3; effects={}; tunnelN=0; phraseI=0; runStep=0;
  if(ctx&&master._dl) master._dl.delayTime.setTargetAtTime(60/(lvl.bpm||104)*0.75,ctx.currentTime,0.1);
  serveBalls(); updateCart();
}
function serveBalls(){ balls=[]; for(let k=0;k<(rule.balls||1);k++){ balls.push(newBall(k)); } sweeps=3; }
function newBall(k){ return {x:W/2+(k?40:-0)*(k%2?1:-1),y:CATCH_Y-30-k*26,vx:(k%2?1:-1)*0.35,vy:-0.94,held:true,trail:[],tunnel:false,id:Math.random()}; }
function speed(){ return 118*(rule.speed||1)*(lvl.speed||1)*(effects.glide>now()?0.6:1)*(1+Math.min(0.25,Math.max(0,32-breakable())*0.008)); }
function breakable(){ let n=0; bricks.forEach(b=>{ if(b.hp!==Infinity) n++; }); return n; }
function updateCart(){ $('cartTitle').textContent=lvl?lvl.title:'Brick Choir'; $('cartSub').textContent=lvl?`Round ${lvlI+1} · ${lvl.architect} · ${NAMES[lvl.root]} ${lvl.scale.replace('pent',' pentatonic').replace('maj','major').replace('min','minor')}`:`Game program · ${LEVELS.length} rounds`; }

/* ============ pads: every key is a paddle ============ */
const PAD_MS=230, PAD_HOLD_MAX=420;
function press(code){
  if(state!=='play'){ return; }
  if(code==='Space'){ if(sweeps>0){ sweeps--; pads.set('Space',{code:'Space',x:W/2,w:W-2*SIDE,row:3,t:now(),held:true,sweep:true}); voice(36+lvl.root+12,{kind:'bass',len:0.12}); } return; }
  const c=cell[code]; if(!c) return;
  if(c.row===0&&meter<1){ perc('rim',{vel:0.3}); flash(c.x+c.w/2,MAP_Y,'#c4432f',0.4); return; }
  const lw=c.lane[1]-c.lane[0]; const w=lw*(wide?1.6:1.0)*(effects.wide>now()?1.5:1);
  pads.set(code,{code,x:(c.lane[0]+c.lane[1])/2,w,row:c.row,t:now(),held:true});
  balls.forEach(b=>{ if(b.held){ b.held=false; } });
  // retro-catch: ball just passed the line in the last 50ms
  balls.forEach(b=>{ if(!b.held&&b.vy>0&&b.y>CATCH_Y&&b.y<CATCH_Y+7) tryCatch(b,true); });
}
function release(code){ const p=pads.get(code); if(p) p.held=false; }
function padActive(p){ const age=now()-p.t; return age<PAD_MS || (p.held&&age<PAD_HOLD_MAX); }
function tryCatch(b,late){
  let best=null;
  pads.forEach(p=>{ if(!padActive(p)) return; if(Math.abs(b.x-p.x)<=p.w/2+2){ if(!best||p.t>best.t) best=p; } });
  if(!best) return false;
  const age=now()-best.t, perfect = age<120 && !late;
  const off=Math.max(-1,Math.min(1,(b.x-best.x)/(best.w/2)));
  let dir = Math.abs(off)<0.12 ? Math.sign(b.vx||1) : Math.sign(off);
  const ang = best.sweep ? 0.9 : PADROW[best.row].ang*(0.75+0.35*Math.abs(off));
  b.vx=Math.sin(ang)*dir; b.vy=-Math.cos(ang); b.y=CATCH_Y-3;
  if(best.row===0&&!best.sweep){ b.smash=true; meter=0; }
  streak++; groove=grooveLevel(); if(perfect) meter=Math.min(1,meter+0.2);
  const t=nextStep();
  if(best.sweep){ voice(36+lvl.root+12,{t,kind:'bass',len:0.2}); }
  else if(best.row===0){ perc('crash',{t,vel:0.7}); voice(midiFor('KeyQ')+12,{t,kind:'lead',len:0.3,vel:1}); }
  else { const m=midiFor(best.code); voice(m,{t,kind:'lead',len:perfect?0.24:0.14,vel:perfect?1:0.7,pan:(best.x/W-0.5)*0.6}); if(perfect) voice(m+12,{t,kind:'brick',len:0.12,vel:0.5}); catchNotes.push(best.code); }
  rally.push([Math.round(now()-rallyT0),best.sweep?'Space':best.code]);
  flash(best.x,CATCH_Y,perfect?'#efe3c8':pal.bands[Math.min(3,best.row)],perfect?1:0.6);
  if(perfect) fx.push({kind:'word',x:best.x,y:CATCH_Y-10,text:'perfect',t:now()});
  best.t=-1e9; // one catch per press
  return true;
}

/* ============ bricks ============ */
function hitBrick(code,b,chain){
  const br=bricks.get(code); if(!br) return; const c=cell[code];
  if(br.hp===Infinity){ perc('rim',{vel:0.5}); br.flash=1; return; }
  br.hp--; br.flash=1;
  const t=nextStep(); let m=null;
  if(c.drum){ perc(DRUMS[c.i],{t,vel:0.8}); }
  else if(b&&b.tunnel){
    if(lvl.phrase&&lvl.phrase.length){ const pc=lvl.phrase[phraseI++%lvl.phrase.length]; m=(cell[pc]&&!cell[pc].drum?midiFor(pc):midiFor(code))+12; }
    else { const sc=SCALES[lvl.scale]||SCALES.minpent; const d=5+runStep++; m=48+lvl.root+Math.floor(d/sc.steps.length)*12+sc.steps[d%sc.steps.length]; }
    voice(m,{kind:'lead',len:0.14,vel:0.9,pan:(c.x/W-0.5)});
  } else { m=midiFor(code)+12; voice(m,{t,kind:'brick',len:br.hp>0?0.05:0.12,vel:0.7,pan:(c.x/W-0.5)*0.8}); }
  rally.push([Math.round(now()-rallyT0),code]);
  if(br.hp>0){ score+=5*mult(); return; }
  bricks.delete(code);
  score+=(b&&b.tunnel?25:10)*mult()*(c.row===0?2:1);
  debris(c.x+c.w/2,c.y+KH/2,pal.bands[c.band],b&&b.tunnel?10:6);
  if(br.cap) caps.push({x:c.x+c.w/2,y:c.y+KH,kind:['wide','glide','choir','echo'][Math.floor(Math.random()*4)]});
  if(effects.echo>now()&&m!==null){ const mm=m; setTimeout(()=>voice(mm,{kind:'brick',len:0.08,vel:0.4}),60000/(lvl.bpm||104)); }
  if(b&&b.smash&&!chain){ b.smash=false; ROWS[c.row].codes.forEach((cc,k)=>{ if(cc!==code&&bricks.has(cc)) setTimeout(()=>hitBrick(cc,{tunnel:true},true),Math.abs(k-c.i)*40); }); shake=6; }
  if(breakable()===0) setTimeout(roundClear,400);
}
const mult=()=>1+Math.min(3,Math.floor(streak/6));
function debris(x,y,col,n){ if(reduce) return; for(let i=0;i<n;i++){ fx.push({kind:'px',x,y,vx:(Math.random()-0.5)*90,vy:-Math.random()*70,col,t:now(),life:500+Math.random()*400}); } }
function flash(x,y,col,s){ flashes.push({x,y,col,s,t:now()}); }

/* ============ simulation ============ */
function step(){
  const t=now(), dt=Math.min(0.033,(t-lastT)/1000); lastT=t;
  if(state==='play'){ update(dt); scheduler(); }
  render(); requestAnimationFrame(step);
}
function update(dt){
  const sp=speed();
  let anyTunnel=false;
  for(let bi=balls.length-1;bi>=0;bi--){
    const b=balls[bi];
    if(b.held){ b.y=CATCH_Y-30-(balls.indexOf(b))*26+Math.sin(now()/300+b.id*9)*2; continue; }
    const n=Math.ceil(sp*dt/1.5);
    for(let s=0;s<n;s++){
      b.x+=b.vx*sp*dt/n; b.y+=b.vy*sp*dt/n;
      if(b.x<SIDE+2){ b.x=SIDE+2; b.vx=Math.abs(b.vx); perc('wall'); }
      if(b.x>W-SIDE-2){ b.x=W-SIDE-2; b.vx=-Math.abs(b.vx); perc('wall'); }
      if(b.y<TOPWALL+2){ b.y=TOPWALL+2; b.vy=Math.abs(b.vy); perc('wall'); }
      if(!b.tunnel&&b.y<WALL_TOP-1&&b.vy<0) enterTunnel(b);
      if(b.tunnel&&b.y>WALL_BOTTOM+4){ b.tunnel=false; runStep=0; }
      // bricks: ball is a 2x2 square, 2600-style
      let hit=null;
      for(const code of bricks.keys()){ const c=cell[code]; if(b.x+1>=c.x&&b.x-1<=c.x+c.w&&b.y+1>=c.y&&b.y-1<=c.y+KH){ hit=c; hit.code=code; break; } }
      if(hit){
        const smashing=b.smash&&bricks.get(hit.code).hp!==Infinity;
        if(!smashing){ const px=Math.min(Math.abs(b.x-hit.x),Math.abs(hit.x+hit.w-b.x)), py=Math.min(Math.abs(b.y-hit.y),Math.abs(hit.y+KH-b.y)); if(px<py) b.vx=b.x<hit.x+hit.w/2?-Math.abs(b.vx):Math.abs(b.vx); else b.vy=b.y<hit.y+KH/2?-Math.abs(b.vy):Math.abs(b.vy); }
        hitBrick(hit.code,b); break;
      }
      if(b.vy>0&&b.y>=CATCH_Y-1&&b.y<=CATCH_Y+1.5){ tryCatch(b,false); }
    }
    if(b.tunnel) anyTunnel=true;
    b.trail.push([b.x,b.y]); if(b.trail.length>(b.tunnel?16:6)) b.trail.shift();
    if(b.y>H+4){ balls.splice(bi,1); ballLost(); }
  }
  if(anyTunnel){ bgPulse=Math.min(1,bgPulse+dt*3); if(ctx){ wet.gain.setTargetAtTime(0.5,ctx.currentTime,0.05); fb.gain.setTargetAtTime(0.5,ctx.currentTime,0.05);} }
  else { bgPulse=Math.max(0,bgPulse-dt*1.5); if(ctx){ wet.gain.setTargetAtTime(0.16,ctx.currentTime,0.5); fb.gain.setTargetAtTime(0.22,ctx.currentTime,0.6);} }
  for(let i=caps.length-1;i>=0;i--){ const c=caps[i]; c.y+=48*dt; if(c.y>=CATCH_Y-2&&c.y<=CATCH_Y+4){ let got=false; pads.forEach(p=>{ if(padActive(p)&&Math.abs(c.x-p.x)<p.w/2+4) got=true; }); if(got){ capsule(c.kind); caps.splice(i,1); continue; } } if(c.y>H) caps.splice(i,1); }
  pads.forEach((p,k)=>{ if(!padActive(p)&&now()-p.t>PAD_HOLD_MAX+200) pads.delete(k); });
  bricks.forEach(b=>b.flash=Math.max(0,b.flash-dt*5));
  shake=Math.max(0,shake-dt*20);
}
function ballLost(){
  if(balls.length) { streak=Math.floor(streak/2); groove=grooveLevel(); return; }
  lives--; streak=0; groove=0; perc('miss'); shake=5;
  if(lives<=0){ setTimeout(gameOver,300); } else { setTimeout(()=>{ if(state==='play') serveBalls(); },500); }
}
function enterTunnel(b){
  b.tunnel=true; tunnelN++; runStep=0; score+=100*mult(); shake=3;
  fx.push({kind:'word',x:W/2,y:WALL_BOTTOM+26,text:lvl.phrase?'the spell':'through!',t:now(),big:true});
  const t=ctx?ctx.currentTime:0; [0,4,7,12].forEach((d,k)=>voice(60+lvl.root+d,{t:t+k*0.05,kind:'brick',len:0.1,vel:0.6}));
}
function capsule(k){
  const T=now(); voice(72+lvl.root,{kind:'lead',len:0.12}); voice(79+lvl.root,{t:ctx?ctx.currentTime+0.07:0,kind:'lead',len:0.12});
  if(k==='wide') effects.wide=T+12000; if(k==='glide') effects.glide=T+7000; if(k==='echo') effects.echo=T+12000;
  if(k==='choir'){ const src=balls.find(b=>!b.held); if(src) balls.push({x:src.x,y:src.y,vx:-src.vx,vy:src.vy,held:false,trail:[],tunnel:src.tunnel,id:Math.random()}); }
  fx.push({kind:'word',x:W/2,y:CATCH_Y-24,text:k,t:T});
}

/* ============ rendering ============ */
const FONT={'0':'111101101101111','1':'010110010010111','2':'111001111100111','3':'111001111001111','4':'101101111001001','5':'111100111001111','6':'111100111101111','7':'111001001001001','8':'111101111101111','9':'111101111001111'};
function digits(str,x,y,s,col){ L.fillStyle=col; for(const ch of str){ const f=FONT[ch]; if(f) for(let i=0;i<15;i++) if(f[i]==='1') L.fillRect(x+(i%3)*s,y+Math.floor(i/3)*s,s,s); x+=4*s; } }
function predict(b){ if(b.held||b.vy<=0||b.y<WALL_BOTTOM) return null; let x=b.x,y=b.y,vx=b.vx,vy=b.vy; const dt=0.004*speed(); for(let i=0;i<2000&&y<CATCH_Y;i++){ x+=vx*dt; y+=vy*dt; if(x<SIDE+2){x=SIDE+2;vx=-vx;} if(x>W-SIDE-2){x=W-SIDE-2;vx=-vx;} } return x; }
function render(){
  const P=pal;
  // --- low-res playfield ---
  L.fillStyle=P.bg; L.fillRect(0,0,W,H);
  if(bgPulse>0){ L.globalAlpha=bgPulse*0.35; L.fillStyle=P.tunnel; L.fillRect(SIDE,TOPWALL,W-2*SIDE,WALL_BOTTOM-TOPWALL+6); L.globalAlpha=1; }
  // walls (Breakout grey, warmed)
  L.fillStyle=P.wall; L.fillRect(0,TOPWALL-4,W,4); L.fillRect(0,TOPWALL-4,SIDE,CATCH_Y-TOPWALL+10); L.fillRect(W-SIDE,TOPWALL-4,SIDE,CATCH_Y-TOPWALL+10);
  // score + balls in big 2600 digits
  digits(String(score).padStart(4,'0').slice(-5),SIDE+6,6,3,P.score);
  digits(String(Math.max(0,lives)),W/2-4,6,3,P.score);
  digits(String(lvl?lvlI+1:1),W-SIDE-20,6,3,P.score);
  // bricks: flat bands, the keyboard's own shape
  if(lvl){ for(const [code,c] of Object.entries(cell)){ const b=bricks.get(code); if(!b) continue;
      L.fillStyle = b.hp===Infinity?P.unbreak:(b.flash>0.5?P.ball:P.bands[c.band]); L.fillRect(c.x,c.y,c.w,KH);
      if(b.max===2&&b.hp===2&&b.hp!==Infinity){ L.fillStyle='rgba(0,0,0,.28)'; L.fillRect(c.x+2,c.y+KH-2,c.w-4,1); L.fillRect(c.x+2,c.y+1,c.w-4,1); }
      if(b.cap){ L.fillStyle='rgba(20,27,26,.55)'; L.fillRect(c.x+c.w/2-1,c.y+2,2,3); }
  } }
  // capsules
  caps.forEach(c=>{ L.fillStyle=P.bands[{wide:3,glide:2,choir:1,echo:0}[c.kind]]; L.fillRect(Math.round(c.x-6),Math.round(c.y),12,4); L.fillStyle=P.bg; L.fillRect(Math.round(c.x-1),Math.round(c.y)+1,2,2); });
  // pads
  pads.forEach(p=>{ if(!padActive(p)) return; const age=(now()-p.t)/PAD_MS; L.globalAlpha=Math.max(0.35,1-age*0.5); L.fillStyle=p.sweep?P.ball:P.bands[Math.min(3,p.row)]; L.fillRect(Math.round(p.x-p.w/2),CATCH_Y,Math.round(p.w),3); L.globalAlpha=1; });
  // catch line hint
  L.fillStyle='rgba(239,227,200,.06)'; L.fillRect(SIDE,CATCH_Y+1,W-2*SIDE,1);
  // balls
  balls.forEach(b=>{ b.trail.forEach(([x,y],i)=>{ L.globalAlpha=(i/b.trail.length)*(b.tunnel?0.6:0.3); L.fillStyle=b.tunnel?P.bands[2]:P.ball; L.fillRect(Math.round(x)-1,Math.round(y)-1,2,2); }); L.globalAlpha=1; L.fillStyle=b.smash?P.bands[0]:P.ball; L.fillRect(Math.round(b.x)-1,Math.round(b.y)-1,3,3); });
  // debris
  for(let i=fx.length-1;i>=0;i--){ const f=fx[i]; if(f.kind!=='px') continue; const k=(now()-f.t)/f.life; if(k>=1){ fx.splice(i,1); continue; } const s=(now()-f.t)/1000; L.fillStyle=f.col; L.globalAlpha=1-k; L.fillRect(Math.round(f.x+f.vx*s),Math.round(f.y+f.vy*s+120*s*s),2,2); L.globalAlpha=1; }
  // smash meter (right wall glows gold as it fills)
  if(meter>0){ L.fillStyle=P.bands[2]; const h=Math.round((CATCH_Y-TOPWALL)*meter); L.fillRect(W-SIDE+1,CATCH_Y-h,SIDE-2,h); }
  // sweeps left
  for(let i=0;i<sweeps;i++){ L.fillStyle=P.ball; L.fillRect(SIDE+4+i*6,CATCH_Y+6,3,2); }
  // key map strip: the controller, drawn under the catch line
  const guideX=[]; balls.forEach(b=>{ const x=predict(b); if(x!==null) guideX.push(x); });
  [1,2,3].forEach((ri,k)=>{ ROWS[ri].codes.forEach(code=>{ const c=cell[code]; const y=MAP_Y+k*8; const lit=pads.has(code)&&padActive(pads.get(code));
      const want=rule.guide>0&&guideX.some(x=>Math.abs(x-(c.lane[0]+c.lane[1])/2)<=(c.lane[1]-c.lane[0])*(wide?0.8:0.5));
      L.fillStyle= lit?P.bands[ri]:(want?`rgba(239,227,200,${0.18+0.5*rule.guide})`:P.map); L.fillRect(c.lane[0]+1,y,c.lane[1]-c.lane[0]-2,6); }); });
  // --- scale to the screen ---
  const cw=cv.width, ch=cv.height; g.imageSmoothingEnabled=false;
  const sx=cw/W, sy=ch/H; const ox=(Math.random()-0.5)*shake*sx*0.5, oy=(Math.random()-0.5)*shake*sy*0.5;
  g.fillStyle=P.bg; g.fillRect(0,0,cw,ch);
  g.drawImage(lr,ox,oy,cw,ch);
  // phosphor bloom
  if(!reduce){ g.save(); g.globalCompositeOperation='lighter'; g.globalAlpha=0.28; g.filter=`blur(${Math.max(2,sx*1.6)}px)`; g.drawImage(lr,ox,oy,cw,ch); g.restore(); g.filter='none'; }
  // scanlines
  g.fillStyle='rgba(0,0,0,.22)'; for(let y=0;y<ch;y+=Math.max(2,Math.round(sy))) g.fillRect(0,y,cw,Math.max(1,Math.round(sy*0.35)));
  // crisp overlays: key letters, words, flashes
  g.textAlign='center'; g.textBaseline='middle';
  const fs=Math.max(8,Math.round(sy*5.2)); g.font=`600 ${fs}px "IBM Plex Mono",monospace`;
  [1,2,3].forEach((ri,k)=>ROWS[ri].codes.forEach((code,i)=>{ const c=cell[code]; const y=(MAP_Y+k*8+3)*sy; const lit=pads.has(code)&&padActive(pads.get(code)); g.fillStyle=lit?'#141b1a':'rgba(239,227,200,.55)'; g.fillText(ROWS[ri].caps[i],((c.lane[0]+c.lane[1])/2)*sx,y); }));
  if(lvl){ g.font=`500 ${Math.max(7,Math.round(sy*4))}px "IBM Plex Mono",monospace`; for(const [code,c] of Object.entries(cell)){ if(!bricks.has(code)) continue; g.fillStyle='rgba(20,27,26,.55)'; g.fillText(c.cap,(c.x+c.w/2)*sx,(c.y+KH/2+0.5)*sy); } }
  for(let i=flashes.length-1;i>=0;i--){ const f=flashes[i], k=(now()-f.t)/500; if(k>=1){ flashes.splice(i,1); continue; } g.strokeStyle=f.col; g.globalAlpha=(1-k)*0.8; g.lineWidth=2; g.beginPath(); g.ellipse(f.x*sx,f.y*sy,(6+k*40*f.s)*sx,(2+k*10*f.s)*sy,0,0,Math.PI*2); g.stroke(); g.globalAlpha=1; }
  for(let i=fx.length-1;i>=0;i--){ const f=fx[i]; if(f.kind!=='word') continue; const k=(now()-f.t)/(f.big?1300:700); if(k>=1){ fx.splice(i,1); continue; } g.globalAlpha=1-k; g.fillStyle=f.big?'#e0ae3f':'#efe3c8'; g.font=`${f.big?'italic 400':'600'} ${Math.round(sy*(f.big?16:5))}px ${f.big?'"Instrument Serif",Georgia,serif':'Jost,Futura,sans-serif'}`; g.fillText(f.big?f.text:f.text.toUpperCase(),f.x*sx,(f.y-k*8)*sy); g.globalAlpha=1; }
  if(state==='play'&&balls.some(b=>b.held)){ g.fillStyle='rgba(239,227,200,.7)'; g.font=`600 ${Math.round(sy*5)}px Jost,Futura,sans-serif`; g.fillText('PRESS ANY LETTER TO SERVE',W/2*sx,(CATCH_Y-54)*sy); }
  // streak / groove readout
  if(state==='play'&&streak>1){ g.textAlign='right'; g.fillStyle='rgba(224,174,63,.85)'; g.font=`600 ${Math.round(sy*4.6)}px Jost,Futura,sans-serif`; g.fillText(`${streak} IN A ROW · ×${mult()}${groove?' · '+LAYERS[groove-1].name.toUpperCase():''}`,(W-SIDE-4)*sx,(CATCH_Y+8)*sy); g.textAlign='center'; }
}

/* ============ screens ============ */
const card=$('card'), ov=$('ov');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const bands='<div class="bands"><i style="background:var(--tomato)"></i><i style="background:var(--orange)"></i><i style="background:var(--mustard)"></i><i style="background:var(--olive)"></i><i style="background:var(--teal)"></i></div>';
function show(h){ card.innerHTML=h; ov.hidden=false; const p=card.querySelector('.primary'); if(p) setTimeout(()=>p.focus(),30); }
function hide(){ ov.hidden=true; }
const ART='/brick-choir/poster.webp';
function titleScreen(){
  state='title'; lvl=null; balls=[]; bricks=new Map(); pads.clear(); updateCart();
  const campaign=LEVELS.map((l,i)=>({l,i})).filter(o=>o.l.architect!=='Astra'); const sp=LEVELS.findIndex(l=>l.architect==='Astra');
  const unlocked=campaign.every(o=>cleared.has(o.l.id));
  const next=campaign.find(o=>!cleared.has(o.l.id))||campaign[0];
  show(`<img class="art" src="${ART}" alt="" onerror="this.remove()"><div class="eyebrow">A video computer music game</div><h2>Brick <em>Choir</em></h2>
    <p>Your whole keyboard is the paddle. Every catch plays the note of the key you pressed, every brick answers, and a streak brings the band in.</p>
    ${bands}
    <div class="how"><kbd>Z X C … /</kbd><span>catch low and wide</span><kbd>A S D … '</kbd><span>catch higher</span><kbd>Q W E … ]</kbd><span>shoot straight up</span><kbd>1 – 0</kbd><span>smash, when the gold meter is full</span><kbd>space</kbd><span>sweep the whole floor, 3 per ball</span></div>
    <div class="btns"><button class="primary" id="go">Play round ${next.i+1}</button></div>
    <div class="rounds">${campaign.map(o=>`<button data-i="${o.i}" class="${cleared.has(o.l.id)?'done':''}"><small>${o.i+1} · ${o.l.architect}</small>${esc(o.l.title)}</button>`).join('')}${sp>=0?`<button data-i="${sp}" class="spell" ${unlocked?'':'disabled'}><small>${unlocked?'Astra':'locked'}</small>${unlocked?esc(LEVELS[sp].title):'? ? ?'}</button>`:''}</div>`);
  $('go').onclick=()=>intro(next.i);
  card.querySelectorAll('.rounds button[data-i]').forEach(b=>b.onclick=()=>intro(+b.dataset.i));
}
function intro(i){
  boot(); loadLevel(i); state='intro'; const r=RULES[Math.min(i,RULES.length-1)];
  show(`<div class="eyebrow">Round ${i+1} · designed by ${esc(lvl.architect)} (${MODELS[lvl.architect]||''})</div><h2>${esc(lvl.title)}</h2>${bands}<p>${esc(r.intro)}</p>
    <div class="btns"><button class="primary" id="go">Begin</button><button id="menu">Rounds</button></div>`);
  $('go').onclick=()=>{ hide(); state='play'; seqNext=0; lastT=now(); };
  $('menu').onclick=titleScreen;
}
function roundClear(){
  if(state!=='play') return; state='clear';
  cleared.add(lvl.id); store.set('cleared',[...cleared]);
  const bonus=lives*200*mult(); score+=bonus;
  // the flourish: your catches, played back as the melody they were
  const t0=ctx?ctx.currentTime+0.1:0; catchNotes.slice(-24).forEach((code,k)=>voice(midiFor(code)+12,{t:t0+k*0.11,kind:'lead',len:0.1,vel:0.7}));
  const isSpell=lvl.architect==='Astra'; const verse=isSpell?'':(LINES[lineIdx%Math.max(1,LINES.length)]||''); if(!isSpell){ lineIdx++; store.set('line',lineIdx); }
  const campaign=LEVELS.map((l,i)=>({l,i})).filter(o=>o.l.architect!=='Astra'); const next=campaign.find(o=>!cleared.has(o.l.id)); const sp=LEVELS.findIndex(l=>l.architect==='Astra');
  const unlockNow=!isSpell&&!next&&sp>=0;
  show(`<div class="eyebrow">${isSpell?'Spell complete':'Round clear'} · +${bonus.toLocaleString()}</div><h2>${esc(isSpell?lvl.line:lvl.title)}</h2>${bands}
    ${isSpell?'':`<p class="verse">${esc(verse)}</p><p>${esc(lvl.line)}</p>`}
    <p>${catchNotes.length} notes caught · ${tunnelN} time${tunnelN===1?'':'s'} through the wall · ${score.toLocaleString()} points</p>
    ${unlockNow?'<p style="color:var(--tomato);font-weight:600">Something opened. Astra’s round is waiting.</p>':''}
    <div class="btns">${unlockNow?'<button class="primary" id="nx">Enter the spell</button>':(next&&!isSpell?'<button class="primary" id="nx">Next round</button>':'')}<button id="pub">Publish this rally</button><button id="menu">Rounds</button></div><div id="status"></div>`);
  const nx=$('nx'); if(nx) nx.onclick=()=>intro(unlockNow?sp:next.i);
  $('menu').onclick=titleScreen; $('pub').onclick=publish;
}
function gameOver(){
  state='over';
  show(`<div class="eyebrow">Game over · ${esc(lvl.title)}</div><h2>${score.toLocaleString()}</h2>${bands}<p>${breakable()} bricks left · ${catchNotes.length} notes caught · ${tunnelN?tunnelN+' time'+(tunnelN>1?'s':'')+' through the wall':'no tunnel yet'}.</p>
    <div class="btns"><button class="primary" id="again">Play again</button><button id="pub">Publish this rally</button><button id="menu">Rounds</button></div><div id="status"></div>`);
  $('again').onclick=()=>{ score=0; intro(lvlI); }; $('menu').onclick=titleScreen; $('pub').onclick=publish;
}
function pause(){ if(state==='play'){ state='paused'; show(`<div class="eyebrow">Paused</div><h2>${esc(lvl.title)}</h2><div class="btns"><button class="primary" id="res">Resume</button><button id="menu">Rounds</button></div>`); $('res').onclick=()=>{hide();state='play';seqNext=0;lastT=now();}; $('menu').onclick=titleScreen; } else if(state==='paused'){ hide(); state='play'; seqNext=0; lastT=now(); } }
async function publish(){
  const st=$('status'); if(rally.length<2){ st.textContent='Not enough notes yet.'; return; }
  const t0=rally[0][0]; const ev=[]; rally.slice(0,4000).forEach(([t,code])=>{ const k=t-t0; ev.push([k,code,1],[k+140,code,0]); }); ev.sort((a,b)=>a[0]-b[0]);
  const dur=Math.min(180000,ev[ev.length-1][0]+400);
  let name=''; try{ name=localStorage.getItem('kb:name')||''; }catch(e){}
  const body={title:`Brick Choir · ${lvl.title}`,song:'',note:`${score.toLocaleString()} points · round by ${lvl.architect}`,link:null,name,dur,settings:{scale:lvl.scale,root:lvl.root,voice:lvl.voice||'bloom',bpm:Math.min(150,Math.max(70,lvl.bpm||104)),sync:false},events:ev.filter(e=>e[0]<=dur),visibility:'public'};
  st.textContent='Publishing…';
  try{ const r=await fetch('/api/keyboard',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const j=await r.json(); if(!r.ok) throw new Error(j.error||'failed');
    try{ const m=JSON.parse(localStorage.getItem('kb:mine')||'[]'); m.unshift({...j.summary,secret:j.secret}); localStorage.setItem('kb:mine',JSON.stringify(m.slice(0,100))); }catch(e){}
    st.innerHTML=`On the wall — <a href="/keyboard?t=${j.id}">hear it on the keyboard</a>`; $('pub').disabled=true;
  }catch(e){ st.textContent='Couldn’t publish — '+(e.message||'try again'); }
}

/* ============ console switches ============ */
function setSw(id,on){ $(id).setAttribute('aria-pressed',on?'true':'false'); }
$('swPower').onclick=()=>{ boot(); muted=!muted; if(master) master.gain.value=muted?0:0.62; $('lblPower').textContent=muted?'sound off':'sound on'; };
$('swColor').onclick=()=>{ pal=pal===PAL.color?PAL.bw:PAL.color; setSw('swColor',pal===PAL.bw); $('lblColor').textContent=pal===PAL.bw?'b · w':'color'; };
$('swDiff').onclick=()=>{ wide=!wide; store.set('wide',wide); setSw('swDiff',!wide); $('lblDiff').textContent=wide?'B · wide pads':'A · narrow pads'; };
$('swSound').onclick=()=>{ hifi=!hifi; setSw('swSound',hifi); $('lblSound').textContent=hifi?'Hi-Fi':'TIA'; };
$('swSelect').onclick=()=>{ if(state==='play') return; const i=((lvl?lvlI:-1)+1)%LEVELS.length; if(LEVELS[i].architect==='Astra'&&!LEVELS.filter(l=>l.architect!=='Astra').every(l=>cleared.has(l.id))) { intro(0); return; } intro(i); };
$('swReset').onclick=()=>{ score=0; intro(lvl?lvlI:0); };
setSw('swDiff',!wide); $('lblDiff').textContent=wide?'B · wide pads':'A · narrow pads';

/* ============ input ============ */
const held=new Set();
addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey||e.altKey) return;
  if(e.code==='Escape'){ pause(); e.preventDefault(); return; }
  if(e.code==='Enter'&&!ov.hidden){ const p=card.querySelector('.primary'); if(p){ p.click(); e.preventDefault(); } return; }
  if(state!=='play') return;
  if(e.repeat){ if(cell[e.code]||e.code==='Space') e.preventDefault(); return; }
  if(cell[e.code]||e.code==='Space'){ e.preventDefault(); boot(); held.add(e.code); press(e.code); touchLight(e.code,true); }
});
addEventListener('keyup',e=>{ if(held.has(e.code)){ held.delete(e.code); release(e.code); touchLight(e.code,false); } });
addEventListener('blur',()=>{ held.forEach(c=>release(c)); held.clear(); if(state==='play') pause(); });
// touch keyboard: the same three rows, big
const touch=$('touch');
[['q',1],['a',2],['z',3]].forEach(([cls,ri])=>{ const r=document.createElement('div'); r.className='r '+cls; r.style.paddingLeft=(ri-1)*3+'%';
  ROWS[ri].codes.forEach((code,i)=>{ const b=document.createElement('button'); b.textContent=ROWS[ri].caps[i]; b.dataset.code=code;
    b.addEventListener('pointerdown',ev=>{ ev.preventDefault(); boot(); if(state==='play'){ press(code); b.classList.add('on'); } });
    const up=()=>{ release(code); b.classList.remove('on'); }; b.addEventListener('pointerup',up); b.addEventListener('pointercancel',up); b.addEventListener('pointerleave',up);
    r.appendChild(b); }); touch.appendChild(r); });
const sweepBtn=document.createElement('div'); sweepBtn.className='r'; sweepBtn.innerHTML='<button data-code="Space" style="flex:1;background:#b9ad94">sweep</button>'; touch.appendChild(sweepBtn);
sweepBtn.querySelector('button').addEventListener('pointerdown',ev=>{ ev.preventDefault(); boot(); press('Space'); });
function touchLight(code,on){ const b=touch.querySelector(`[data-code="${code}"]`); if(b) b.classList.toggle('on',on); }
// tapping the key-map strip on the screen works too
cv.addEventListener('pointerdown',e=>{ boot(); if(state!=='play') return; const r=cv.getBoundingClientRect(); const x=(e.clientX-r.left)/r.width*W, y=(e.clientY-r.top)/r.height*H; if(y<MAP_Y-4) return; const ri=Math.max(1,Math.min(3,1+Math.floor((y-MAP_Y)/8))); let best=null,bd=1e9; ROWS[ri].codes.forEach(code=>{ const c=cell[code]; const d=Math.abs(c.x+c.w/2-x); if(d<bd){bd=d;best=code;} }); if(best){ press(best); setTimeout(()=>release(best),160); } });

/* ============ sizing ============ */
function fit(){ const s=$('screen').getBoundingClientRect(); const dpr=Math.min(2,devicePixelRatio||1); cv.width=Math.round(s.width*dpr); cv.height=Math.round(s.height*dpr); }
addEventListener('resize',fit); new ResizeObserver(fit).observe($('screen')); fit();

if(/[?&]bot\b/.test(location.search)) window.__bc={get balls(){return balls;},cell,ROWS,CATCH_Y,get state(){return state;},get score(){return score;},get streak(){return streak;},get bricks(){return bricks.size;}};
if(!LEVELS.length) show('<h2>No rounds yet</h2>'); else titleScreen();
requestAnimationFrame(step);
})();
</script>
</body>
</html>
