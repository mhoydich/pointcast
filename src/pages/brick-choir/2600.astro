itect": "Astra", "title": "The Spell", "line": "By glass and choir, let stone remember fire.", "scale": "hirajoshi", "root": 2, "bpm": 104, "voice": "glass", "speed": 0.9, "bricks": {"Digit3": 2, "Digit4": 1, "Digit5": 1, "Digit7": 1, "Digit8": 1, "Digit9": 2, "KeyW": 2, "KeyE": 1, "KeyR": 1, "KeyT": 1, "KeyU": 1, "KeyI": 1, "KeyO": 1, "KeyP": 2, "KeyS": 2, "KeyD": 1, "KeyF": 1, "KeyJ": 1, "KeyK": 1, "KeyL": 2, "KeyC": 1, "KeyV": 1, "KeyM": 1, "Comma": 1}, "capsules": ["KeyV", "KeyM", "KeyT", "KeyU"], "phrase": ["KeyZ", "KeyC", "KeyV", "KeyN", "KeyV", "KeyZ", "KeyC", "KeyV", "KeyB", "KeyV", "KeyC", "KeyV", "KeyN", "KeyM", "KeyN", "KeyB", "KeyV", "KeyC", "KeyX", "KeyZ"]}];
