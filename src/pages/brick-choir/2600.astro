<style is:inline>
  :root{
    --room:#231d19; --walnut:#5a3a22; --walnut-2:#3f2816; --walnut-3:#7a5334; --black:#141716; --bezel:#e8dcc2;
    --cream:#efe3c8; --char:#1d2322; --mustard:#e0ae3f; --orange:#d9772e; --tomato:#c4432f; --olive:#8d9a3c; --teal:#2f7f79; --chrome:#c9c3b6;
    --jost:"Jost","Futura","Avenir Next","Century Gothic",system-ui,sans-serif;
    --serif:"Instrument Serif",Georgia,serif;
    --mono:"IBM Plex Mono",ui-monospace,monospace;
    color-scheme:dark;
  }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;}
  body{
    background:var(--room);
    background-image:radial-gradient(ellipse at 50% 30%,rgba(224,174,63,.08),transparent 60%),repeating-linear-gradient(90deg,rgba(255,255,255,.012) 0 2px,transparent 2px 38px);
    color:var(--cream);font-family:var(--jost);display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding-inline:16px;padding-block:14px;box-sizing:border-box;overflow:hidden;-webkit-user-select:none;user-select:none;
  }
  .console{width:min(100%, calc((100vh - 60px) * 1.12), 1080px);display:flex;flex-direction:column;border-radius:16px;overflow:hidden;
    box-shadow:0 30px 60px rgba(0,0,0,.45),0 2px 0 rgba(255,255,255,.06) inset;}
  /* ribbed black top */
  .ribs{height:30px;background:repeating-linear-gradient(90deg,#1b1e1d 0 7px,#0f1110 7px 9px);display:flex;align-items:center;justify-content:space-between;padding-inline:18px;}
  .ribs .plate{font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--chrome);background:#0c0e0d;padding:3px 10px;border-radius:3px;}
  .ribs .plate b{color:var(--mustard);font-weight:600;}
  /* woodgrain body with the screen */
  .body{position:relative;padding:18px 22px 16px;
    background:
      repeating-linear-gradient(92deg,rgba(0,0,0,.10) 0 1px,transparent 1px 7px),
      repeating-linear-gradient(88deg,rgba(255,220,170,.05) 0 2px,transparent 2px 13px),
