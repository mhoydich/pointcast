  let last=null, t=0; const dt=1/60;
  for(let i=0;i<180;i++){ const ev=stepBall(b,dt,true); t+=dt; if(ev==='net') break; if(sideOf(b.z)!==S) continue; const side0=(b.shot<=2&&b.bounces<1); if(b.bounces>=2) break;
    const ok=b.bounces>=1?(b.y<8.5):(!side0&&Math.abs(b.z)>=KZ+0.4&&b.y<8.5);
    if(ok){ last={x:b.x,z:b.z,y:b.y,t}; if(b.vy<0&&b.y<=PY+0.4) break; } }
  if(!last) return; intercept={seat:-1,x:clamp(last.x,-HW-3,HW+3),z:clamp(last.z,S>0?1.5:-HL-3,S>0?HL+3:-1.5),t:last.t,arrive:now()+last.t*1000,valid:true,team:tm};
}

/* ================= shots ================= */
function launch(from,tx,tz,T,lift){ // a parabola from `from` that lands at (tx,0,tz) after T seconds
  ball.x=from.x; ball.y=from.y; ball.z=from.z; ball.vx=(tx-from.x)/T; ball.vz=(tz-from.z)/T; ball.vy=(0-from.y+0.5*G*T*T)/T+lift; ball.live=true; ball.bounces=0; ball.netted=false;
}
function clearsNet(from,tx,tz,T,lift){ const vz=(tz-from.z)/T, vy=(0-from.y+0.5*G*T*T)/T+lift; if(Math.sign(vz)===Math.sign(from.z)||vz===0) return true; const t0=(0-from.z)/vz; const y0=from.y+vy*t0-0.5*G*t0*t0; return y0>NET_H+0.5; }
function shoot(seat,{aim=0,lift=0,kind='n',q=0.8,serve=false}){
  const s=SEATS[seat], S=s.side, a=av[seat]; const from=serve?{x:a.x,y:3.2,z:a.z}:{x:ball.x,y:Math.max(1.2,ball.y),z:ball.z};
  const err=1-q; let tx, tz, T, lf=0;
  if(serve){ const sx=Math.sign(a.x)||1; tx=-sx*4.5+aim*3.5; tz=-S*(13.5+lift*2.5); T=1.35; }
  else if(kind==='d'){ tx=aim*5+(Math.random()-0.5)*err*5; tz=-S*(3.5+Math.random()*2.5+err*3); T=1.15; lf=1.5; }
  else if(lift>0.35){ tx=aim*6.5+(Math.random()-0.5)*err*7; tz=-S*(15+lift*3.5+(Math.random()-0.5)*err*8); T=1.9; lf=2; }
  else { const drive=-Math.min(0,lift); tx=aim*7+(Math.random()-0.5)*err*8; tz=-S*(12+4*(1-drive)+(Math.random()-0.5)*err*10); T=1.3-drive*0.25; }
  tx=clamp(tx,-HW-6,HW+6);
  if(q>0.3){ let k=0; while(!clearsNet(from,tx,tz,T,lf)&&k<8){ T+=0.08; lf+=0.5; k++; } }
  launch(from,tx,tz,T,lf);
  ball.shot++; ball.hitter=seat; ball.hitTeam=s.team; ball.hist=[];
  a.swingT=now(); a.swingKind=kind; a.hitT=now(); a.face=Math.atan2(tx-a.x,-(tz-a.z)*S);
  delete pending[seat];
  const sweet=q>=0.62;
  if(serve){ rallyLen=0; rallyNotes=[]; playHit(seat,0,sweet,kind); word(players[seat].human?'SERVE!':'serve',avScreen(seat,2),{color:s.hex}); }
  else { rallyLen++; totalHits++; players[seat].hits++; if(sweet) players[seat].sweets++; playHit(seat,rallyLen,sweet,kind);
    if(sweet){ word(kind==='d'?'SWEET DINK':'SWEET!',avScreen(seat,2),{color:'#fff3c4',big:true}); flare=1; } else if(kind==='d') word('dink',avScreen(seat,2),{color:s.hex}); else if(lift>0.35) word('lob',avScreen(seat,2),{color:s.hex});
    if(rallyLen>longest){ longest=rallyLen; longestNotes=rallyNotes.slice(); } if(rallyLen>bestRallyGame) bestRallyGame=rallyLen;
    energy=rallyLen>=10?3:rallyLen>=7?2:rallyLen>=4?1:0; crowdOn=rallyLen>=12; if(rallyLen===12) word('THE CROWD IS IN',[50,30],{color:'#fff3c4',big:true});
    if(rallyLen>0&&rallyLen%10===0) word(`${rallyLen} RALLY!`,[50,30],{color:'var(--lime)',huge:true}); }
  PARTY.ev(seat,sweet?'sw':'h'); if(kind==='d') PARTY.ev(seat,'dk');
  PARTY.wev(['h',seat,lastHitM,sweet?1:0,serve?3:kind==='d'?1:lift>0.35?2:0,...ballState()]);
  teamFlash[s.team]=1; cardHit(seat); onHitFx(seat,from,sweet);
  return true;
}
let lastHitM=60;
function playHit(seat,n,sweet,kind){ const s=SEATS[seat]; const m=n===0?degOf(0,60):rallyNote(n); lastHitM=m; const vel=sweet?1:0.7; const t=snapT();
  tone(m,{t,kind:s.kind,vel,len:kind==='d'?0.08:0.16,pan:s.pan}); if(sweet){ tone(m+7,{t,kind:s.kind,vel:0.55,len:0.14,pan:-s.pan*0.5}); tone(m+12,{t:t+0.03,kind:'bell',vel:0.35,len:0.08,pan:s.pan}); }
  if(kind==='d') drum('rim',{t,vel:0.5,pan:s.pan}); else drum('pop',{t,vel:0.6,pan:s.pan});
  rallyNotes.push([m,seat,sweet?1:0]); melodyBar(m,seat,sweet); }
function snapT(){ if(!ctx) return 0; const t=ctx.currentTime; if(!seqT) return t; const s16=60/court.bpm/8; const k=Math.floor((seqT-t)/s16); const c=seqT-k*s16; return (c>=t&&c-t<=0.045)?c:t; }

// a swing from a paddle: the ball has to be near that seat's avatar now — or, for a phone, where it was when the swing left the phone
function swing(seat,{aim=0,lift=0,kind='n',lat=0,src='key'}={}){
  aim=clamp(aim,-1,1); lift=clamp(lift,-1,1); const p=players[seat], s=SEATS[seat], a=av[seat]; if(!isActive(seat)) return false;
  if(state==='serve'){ if(seat!==server) { a.swingT=now(); a.swingKind=kind; return false; } setState('play'); shoot(seat,{aim,lift:0,kind:'n',q:0.85,serve:true}); return true; }
  if(state!=='play') return false;
  a.swingT=now(); a.swingKind=kind;
  if(ball.hitTeam===s.team){ PARTY.ev(seat,'no'); return false; } // it's the other side's ball
  if(designated[s.team]!==seat&&mode==='doubles'){ PARTY.ev(seat,'no'); word('partner’s ball',avScreen(seat,2),{color:'rgba(244,240,255,.6)'}); return false; }
  // the ball's recent positions: a phone's swing happened lat ms ago
  const T=now(); const win=Math.min(320,lat+40); let best=Infinity, bx=ball.x, by=ball.y, bz=ball.z;
  const consider=(x,y,z)=>{ const d=Math.hypot(x-a.x,z-a.z)+Math.max(0,y-7)*0.5; if(d<best){ best=d; bx=x; by=y; bz=z; } };
  if(hittable(ball)) consider(ball.x,ball.y,ball.z);
  for(let i=ball.hist.length-1;i>=0;i--){ const h=ball.hist[i]; if(T-h[0]>win) break; if(h[4]) consider(h[1],h[2],h[3]); }
  if(best<=REACH){ const q=clamp(1-best/REACH,0.05,1); ball.x=bx; ball.y=by; ball.z=bz; shoot(seat,{aim,lift,kind,q}); return true; }
  // early: the ball is about to arrive → hold the swing for it (latency and eagerness are both forgiven)
  if(intercept.valid&&intercept.team===s.team&&intercept.arrive-T<340&&intercept.arrive-T>-50){ pending[seat]={aim,lift,kind,until:intercept.arrive+120,q:0.66}; return true; }
  PARTY.ev(seat,'m'); word('whiff',avScreen(seat,2),{color:'rgba(244,240,255,.55)'}); drum('open',{vel:0.25,pan:s.pan}); return false;
}
function applyPending(){ const T=now(); for(const k in pending){ const seat=+k, pd=pending[k], a=av[seat]; if(T>pd.until||state!=='play'||ball.hitTeam===SEATS[seat].team){ delete pending[k]; continue; }
  if(hittable(ball)&&Math.hypot(ball.x-a.x,ball.z-a.z)<=REACH*0.85){ shoot(seat,{aim:pd.aim,lift:pd.lift,kind:pd.kind,q:pd.q}); } } }

/* ================= the point ================= */
function beginPoint(){ resetBall(); av.forEach(a=>{ a.botFor=-1; a.botDone=false; }); Object.keys(pending).forEach(k=>delete pending[k]); rallyLen=0; rallyNotes=[]; energy=0; crowdOn=false; clearMelody();
  const st=TEAMS[server>=0?SEATS[server].team:0]; const tm=SEATS[server].team; const even=score[tm]%2===0; const S=st.side;
  // serve from the right-hand side of your own court on an even score, so the diagonal changes every point
  const sx=(even?1:-1)*S*5; av.forEach(a=>{ const s=SEATS[a.seat]; a.tx=s.homeX; a.tz=s.side*19; }); av[server].tx=sx; av[server].tz=S*21;
  if(mode==='doubles'){ const mate=TEAMS[tm].seats.find(x=>x!==server); av[mate].tx=-sx; av[mate].tz=S*19; }
  const rt=1-tm; const rs=teamSeats(rt); rs.forEach(x=>{ av[x].tz=TEAMS[rt].side*20; }); const rec=rs.length>1?rs.reduce((b,x)=>Math.abs(SEATS[x].homeX+sx)<Math.abs(SEATS[b].homeX+sx)?x:b):rs[0]; av[rec].tx=-sx;
  designated=[-1,-1]; designated[rt]=rec; designated[tm]=server;
  setState('serve'); autoServeT=now()+(players[server].human?5200:rnd(900,1600)); PARTY.ev(server,'sv');
  word(players[server].human?`${players[server].name} TO SERVE`:'bot serves',[50,58],{color:SEATS[server].hex,big:true});
}
function pointOver(win,why){ if(state!=='play'&&state!=='serve') return; const lose=1-win; score[win]++; pointsPlayed++; lastPoint={team:win,why}; energy=0; crowdOn=false; camKick=1; shake=0.6;
  const W=TEAMS[win]; teamSeats(win).forEach(x=>{ players[x].points++; PARTY.ev(x,'w'); }); teamSeats(lose).forEach(x=>PARTY.ev(x,'l'));
  // the winning shot lands on a chord in the winner's colour; a miss is a soft slide down
  const t=ctx?ctx.currentTime+0.02:0; const k=SEATS[W.seats[0]].kind; [0,4,7,12].forEach((d,i)=>tone(degOf(0,60)+d,{t:t+i*0.03,kind:k,vel:0.9,len:0.5,pan:W.pan})); drum('crash',{t,vel:0.35});
  const txt={double:'TWO BOUNCES',out:'OUT!',net:'NET!',kitchen:'KITCHEN!'}[why]||why;
  PARTY.wev(['p',win,why]); setState('point',{s:'afterPoint',ms:demo?1100:1500}); ball.hist=[]; word(txt,toScreen(ball.x,4,ball.z),{color:TEAMS[lose].hex,big:true});
  const d=score[win]-score[lose]; if(demo){ if(score[win]>=TO) score=[0,0]; return; } if(score[win]>=TO&&d>=2) { stateNext={s:'gameOver',at:now()+1500}; }
  else { const sm=Math.max(...score); if(sm===TO-1&&d>=1) word(`GAME POINT · ${W.name}`,[50,64],{color:W.hex,big:true}); }
}
function afterPoint(){ // rally scoring: the winner serves next; inside a team the server alternates
  const tm=lastPoint.team; const ts=teamSeats(tm); server=ts.length>1?ts[score[tm]%2]:ts[0]; beginPoint(); }
function gameOver(){ const win=lastPoint.team; games[win]++; const W=TEAMS[win]; const t=ctx?ctx.currentTime+0.05:0; [0,4,7,12,16,19].forEach((d,i)=>tone(degOf(0,60)+d,{t:t+i*0.07,kind:i%2?'bell':SEATS[W.seats[0]].kind,vel:0.9,len:0.35,pan:W.pan})); drum('crash',{t,vel:0.5});
  const matchOver=games[win]>=GAMES_TO; if(matchOver){ matchWinner=win; setState('game',{s:'matchOver',ms:2800}); } else setState('game',{s:'inter',ms:2600}); }
function startInter(){ setState('inter',{s:'nextGame',ms:6500}); interT=now(); resetBall(); rallyLen=0; clearMelody(); }
function nextGame(){ gameN++; courtI=(courtI+1)%COURTS.length; court=COURTS[courtI]; score=[0,0]; bestRallyGame=0; seqT=0; setState('ready',{s:'firstServe',ms:2600}); jingle([0,4,7,12].map(x=>degOf(0,60)+x),0.1,'lead'); }
function firstServe(){ server=teamSeats(gameN%2===0?0:1)[0]; beginPoint(); }
function matchOver(){ setState('over'); resetBall(); shake=0; entryQueue=humans().filter(p=>p.points>0||true).map(p=>({...p,score:scoreOf(p)})).filter(p=>qualifies(p.score)); PARTY.results(); focusMenu(); }
// arcade score: points × a rally bonus, plus the sweet spots; winning the match doubles it
const scoreOf=p=>{ if(WATCH) return WX.sc[p.seat]|0; const tm=SEATS[p.seat].team; const base=(games[tm]*TO+p.points)*100; const bonus=Math.round(base*Math.min(1.5,longest/12)); return (base+bonus+p.sweets*60+p.hits*12)*(matchWinner===tm?2:1); };
function qualifies(sc){ if(sc<=0) return false; return [hiWeek,(hiGlobal||[]).length?hiGlobal:hiLocal].some(l=>!l||l.length<10||sc>Math.min(...l.map(r=>r.score))); }
async function submitScore(initials,p){ const rec={initials,score:p.score,round:gameN+1,at:Date.now(),game:'rally'}; myRecs.push(rec); hiLocal=[...hiLocal,rec].sort((a,b)=>b.score-a.score).slice(0,10); store.set('scores',hiLocal); postScore({initials,score:p.score,round:gameN+1,game:'rally'},0); nextEntry(); }
async function postScore(body,attempt){ try{ const r=await fetch('/api/brick-scores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) hiGlobal=j.scores; if(Array.isArray(j.weekScores)) hiWeek=j.weekScores; renderUI(true); return; } if(r.status===429&&attempt<4) setTimeout(()=>postScore(body,attempt+1),62000*(attempt+1)); }catch(e){} }
function nextEntry(){ const p=entryQueue.shift(); if(p){ if(p.src==='phone'&&p.name){ submitScore(p.name.slice(0,3),p); return; } entryFor=p; entry=''; entryPos=0; setState('initials'); } else { boardMode='week'; setState('scores'); focusMenu(); } }
async function loadScores(){ const get=async q=>{ try{ const r=await fetch('/api/brick-scores'+q); if(r.ok){ const j=await r.json(); if(Array.isArray(j.scores)) return j.scores; } }catch(e){} return null; };
  const [a,w]=await Promise.all([get('?game=rally'),get('?period=week&game=rally')]); if(a) hiGlobal=a; if(w) hiWeek=w; renderUI(true); }

/* ================= match flow ================= */
function startLobby(){ demo=false; resetBall(); rallyLen=0; clearMelody(); score=[0,0]; games=[0,0]; lobbyMode(); setState('lobby'); lobbyEnd=now()+15000; focusMenu(); }
function lobbyMode(){ mode=humans().length>=3?'doubles':'singles'; av.forEach(a=>{ const s=SEATS[a.seat]; a.tx=s.homeX; a.tz=s.side*19; }); }
function startGame(){ players.forEach(p=>{ p.hits=0; p.sweets=0; p.points=0; }); score=[0,0]; games=[0,0]; gameN=0; courtI=0; court=COURTS[0]; longest=0; longestNotes=[]; bestRallyGame=0; totalHits=0; matchWinner=-1; myRecs=[]; seqT=0;
  const h=humans().length; mode=h>=3?'doubles':'singles'; if(h===2&&humans().every(p=>SEATS[p.seat].team===0)){ /* two on one side: play doubles with bots */ mode='doubles'; }
  if(h===2&&mode==='singles'&&!(players[0].human&&players[2].human)){ mode='doubles'; }
  setState('ready',{s:'firstServe',ms:2600}); jingle([0,4,7,12].map(x=>degOf(0,60)+x),0.1,'lead'); }
function toAttract(){ players.forEach(p=>{ if(p.src==='keys'||!p.human){ p.human=false; p.name='BOT'; p.src=null; } p.hits=0; p.sweets=0; p.points=0; }); score=[0,0]; games=[0,0]; mode='doubles'; matchWinner=-1; myRecs=[]; seqT=0; court=COURTS[0]; courtI=0; longest=0; longestNotes=[];
  demo=true; attractPanel=0; attractT=now(); server=0; beginPoint(); PARTY.roster(); }

/* ================= bots: friendly, a little clumsy — they swing when the ball reaches them, and sometimes just don't ================= */
function bots(T){
  if(state==='serve'){ if(!players[server].human&&T>=autoServeT) swing(server,{aim:rnd(-0.5,0.5),src:'bot'}); return; }
  if(state!=='play'||!ball.live||ball.hitTeam<0) return; const tm=1-ball.hitTeam; const seat=designated[tm]; if(seat<0||players[seat].human) return; const a=av[seat], s=SEATS[seat];
  if(a.botFor!==ball.shot){ a.botFor=ball.shot; a.botDone=false; a.botMiss=Math.random()<(demo?0.03:0.05+rallyLen*0.012+(mode==='singles'&&humans().length===1?0.02:0)); a.botAim=rnd(-0.75,0.75); a.botLate=rnd(0,0.35); a.botKind=Math.random()<0.28?'d':'n'; a.botLift=Math.random()<0.15?0.7:rnd(-0.4,0.2); }
  if(a.botDone) return; const d=Math.hypot(ball.x-a.x,ball.z-a.z); const passed=(ball.z-a.z)*s.side>1.5; // the ball is behind the paddle
  if(hittable(ball)&&(d<=REACH*(0.35+a.botLate)||passed)){ a.botDone=true; if(a.botMiss){ if(Math.random()<0.6){ a.swingT=T; a.swingKind='n'; word('whiff',avScreen(seat,2),{color:'rgba(244,240,255,.5)'}); } return; } swing(seat,{aim:a.botAim,lift:a.botLift,kind:a.botKind,src:'bot'}); }
}

/* ================= avatars: they run to the ball for you; you swing and aim ================= */
function moveAvatars(dt,T){
  predict();
  if(state==='play'&&ball.live&&ball.hitTeam>=0){ const rt=1-ball.hitTeam, R=TEAMS[rt]; const rs=teamSeats(rt);
    if(intercept.valid){ let d=designated[rt]; if(!rs.includes(d)) d=rs[0]; const near=rs.reduce((b,x)=>Math.abs(av[x].x-intercept.x)<Math.abs(av[b].x-intercept.x)?x:b,rs[0]); if(near!==d&&Math.abs(av[near].x-intercept.x)+2.5<Math.abs(av[d].x-intercept.x)) d=near; designated[rt]=d;
      av[d].tx=intercept.x; av[d].tz=intercept.z; rs.forEach(x=>{ if(x!==d){ av[x].tx=SEATS[x].homeX*(SEATS[x].homeX*intercept.x>0?1.4:0.8); av[x].tz=R.side*(ball.bounces||ball.shot>2?9:19); } }); }
    const ht=ball.hitTeam; teamSeats(ht).forEach(x=>{ av[x].tx=lerp(av[x].tx,SEATS[x].homeX,dt*2); av[x].tz=TEAMS[ht].side*(ball.shot>=3?8.5:18); }); }
  av.forEach(a=>{ const sp=(state==='play'?26:14)*dt; const dx=a.tx-a.x, dz=a.tz-a.z, d=Math.hypot(dx,dz); if(d>0.01){ const k=Math.min(1,sp/d); a.x+=dx*k; a.z+=dz*k; } a.x=clamp(a.x,-HW-5,HW+5); a.z=clamp(a.z,-HL-5,HL+5); });
}

/* ================= tick: fixed 120 Hz substeps, so a slow TV (or a software renderer) plays the same game ================= */
let lastT=now(), acc=0; const STEP=1/120;
function tick(T){
  if(demo&&T-attractT>9000){ attractT=T; attractPanel=(attractPanel+1)%4; if(attractPanel===3) loadScores(); }
  acc+=Math.min(0.6,(T-lastT)/1000); lastT=T; let n=0;
  while(acc>=STEP&&n<80){ acc-=STEP; n++; const Ts=T-acc*1000; substep(STEP,Ts); }
  teamFlash[0]*=Math.pow(0.02,n*STEP); teamFlash[1]*=Math.pow(0.02,n*STEP); flare*=Math.pow(0.05,n*STEP); shake*=Math.pow(0.02,n*STEP); camKick*=Math.pow(0.05,n*STEP);
  scheduler(); PARTY.tick(T); if(HUB&&state==='scores'&&T-stateT>25000) goHome();
}
function substep(dt,T){
  if(stateNext&&T>=stateNext.at){ const s=stateNext.s; stateNext=null; ({afterPoint,gameOver,inter:startInter,nextGame,firstServe,matchOver})[s](); }
  if(state==='lobby'&&T>=lobbyEnd) startGame();
  if(state==='serve'&&players[server].human&&T>=autoServeT){ word('auto serve',avScreen(server,2),{color:'rgba(244,240,255,.6)'}); swing(server,{aim:0,src:'auto'}); }
  moveAvatars(dt,T); bots(T); applyPending();
  if(ball.live&&state==='play'){
    const ev=stepBall(ball,dt,false); ball.hist.push([T,ball.x,ball.y,ball.z,hittable(ball)]); if(ball.hist.length>60) ball.hist.shift();
    if(ev==='bounce'){ onBounce(); const S=sideOf(ball.z); const first=ball.bounces===1; const out=Math.abs(ball.x)>HW+0.2||Math.abs(ball.z)>HL+0.2||(ball.shot===1&&Math.abs(ball.z)<KZ&&first);
      if(first&&out){ pointOver(S>0?0:1,Math.abs(ball.z)<KZ&&ball.shot===1?'kitchen':'out'); } else if(ball.bounces>=2){ pointOver(S>0?1:0,'double'); } }
    else if(ev==='net'){ PARTY.wev(['n']); drum('rim',{vel:0.6}); tone(degOf(0,48),{kind:'bass',len:0.25,vel:0.6}); word('net',[50,50],{color:'rgba(244,240,255,.7)'}); }
    else if(ev==='cord'){ PARTY.wev(['c']); word('net cord!',[50,50],{color:'#fff3c4'}); drum('rim',{vel:0.7}); }
    if(ball.netted&&ball.y<=0.01&&Math.abs(ball.vy)<1){ pointOver(sideOf(ball.z)>0?1:0,'net'); }
    if(ball.y<0.01&&ball.bounces>=1&&Math.hypot(ball.vx,ball.vz)<0.5) ball.live=false;
  }
}
function onBounce(){ PARTY.wev(['b',Math.round(ball.x*100)/100,Math.round(ball.z*100)/100,ball.bounces]); const S=sideOf(ball.z); const t=snapT(); drum(ball.bounces===1?'pop':'tom',{t,vel:ball.bounces===1?0.45:0.3,pan:ball.x/HW*0.6}); ripple(ball.x,ball.z,S); }

/* ================= the room: a code, four QR cards, phones as paddles ================= */
const ALPHA='ABCDEFGHJKMNPQRSTUVWXYZ';
const ROOM=(()=>{ if(WATCH) return WATCH; const q=new URLSearchParams(location.search).get('room'); if(q&&/^[A-Za-z]{4}$/.test(q)) return q.toUpperCase(); const a=new Uint32Array(4); crypto.getRandomValues(a); return Array.from(a,v=>ALPHA[v%ALPHA.length]).join(''); })();
const JOIN_URL=`${location.origin}/brick-choir/rally-join?room=${ROOM}`;
