  ball3.rotation.x+=0.2; ball3.rotation.y+=0.13; shadow3.visible=ball3.visible; shadow3.position.set(ball3.position.x,0.03,ball3.position.z); const sh=1/(1+ball3.position.y*0.08); shadow3.scale.set(sh,sh,1); shadow3.material.opacity=0.55*sh;
