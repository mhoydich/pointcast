  const ord=['1ST','2ND','3RD','4TH','5TH','6TH','7TH','8TH','9TH','10TH'], cols=['#ff8fb1','#ffb38a','#ffd27a','#c8f08f','#9fe3c9','#8fd0ff','#b9a8ff','#e3a8ff','#ffa8d8','#f4f0ff'];
