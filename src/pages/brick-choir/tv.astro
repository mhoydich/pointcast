  const X={net:null,status:'off',transport:null,lastSt:'',lastStT:0,evq:[],evT:0,hT:{},lastCue:-1,pruneT:0};
  const DR=['kick','snare','clap','rim'];
  const setStatus=(s,t)=>{ X.status=s; X.transport=t; const el=document.getElementById('roomSt'); el.className='st '+s; document.getElementById('roomStTxt').textContent=s==='on'?(t==='drum'?'live':'live · relay'):s; };
  const seatOf=id=>players.find(p=>p.members.includes(id))||null;
  function assign(id,name,want){
    const cur=seatOf(id); if(cur){ const i=cur.members.indexOf(id); if(name&&cur.names[i]!==name){ cur.names[i]=name; cur.name=cur.names.join('+'); } return cur; }
    const free=x=>x.members.length<2&&(!x.human||x.src==='phone'); let p=null;
    if(want>=0&&want<4&&free(players[want])) p=players[want];
    if(!p) p=players.find(x=>!x.human)||players.find(x=>free(x)&&x.members.length===1)||null;
    if(!p) return null;
    p.members.push(id); p.names.push(name); p.seen[id]=now(); const s=SEATS[p.seat];
    if(!p.human){ p.human=true; p.src='phone'; p.name=name; jingle([0,4,7,12].map(x=>60+x+(lvl?lvl.root:0)),0.08,s.kind,s.pan); word(`${name} takes ${s.name}!`,[s.dir[0]*9,s.dir[1]*9],{big:true,color:s.hex}); }
    else { p.src='phone'; p.name=p.names.join('+'); jingle([7,12].map(x=>60+x+(lvl?lvl.root:0)),0.08,s.kind,s.pan); word(`${name} joins ${s.name} · duet!`,[s.dir[0]*9,s.dir[1]*9],{big:true,color:s.hex}); }
    if(state==='lobby') lobbyEnd=Math.max(lobbyEnd,now()+6000);
    return p;
  }
  function drop(id){ const p=seatOf(id); if(!p) return; const i=p.members.indexOf(id); p.members.splice(i,1); p.names.splice(i,1); delete p.seen[id];
    if(!p.members.length){ p.human=false; p.src=null; p.name='BOT'; word(`${SEATS[p.seat].name} is open`,[SEATS[p.seat].dir[0]*9,SEATS[p.seat].dir[1]*9],{color:SEATS[p.seat].hex}); } else p.name=p.names.join('+'); X.roster(); }
  const playable=()=>state==='play'||state==='attract'||state==='lobby'||state==='ready'||state==='clear'||state==='short';
  function cmd(c,p){
    if(c==='start'){ if(state==='attract') startLobby(); else if(state==='lobby') startGame(); }
    else if(c==='again'){ if(state==='over') nextEntry(); else if(state==='scores'||state==='attract') startLobby(); }
    else if(c==='party'){ if(state==='scores'||state==='over') toAttract(); }
    else if(c==='home'){ if(HUB&&(state==='attract'||state==='over'||state==='scores'||state==='lobby'||state==='initials'||state==='inter')) goHome(); }
    else if(c==='skip'){ if(state==='inter'&&now()-stateT>1000){ interUpdate.chord=false; interUpdate.burst=false; interUpdate.ring=-1; balls=[]; beginRound(lvlI+1); } }
  }
  X.onFrame=d=>{ if(!d||typeof d!=='object'||d.o==='tv') return; const id=d.p; if(typeof id!=='string'||!id||id.length>12) return;
    const p=seatOf(id); if(p) p.seen[id]=now();
    switch(d.f){
      case 'hi': X.roster(); X.state(true); if(p) X.ok(p,id); break;
      case 'j': { const name=String(d.n||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3)||'???'; const q=assign(id,name,Number.isInteger(d.s)?d.s:-1); if(!q){ X.send({f:'full',p:id}); break; } X.ok(q,id); X.roster(); X.state(true); break; }
      case 'i': { if(!p){ X.send({f:'who',p:id}); break; } if(!playable()) break; const k=d.k|0; if(k>=0&&k<10){ const s=SEATS[p.seat]; const code=s.rows[k<5?0:1][k<5?k:k-5]; heldKeys.add(code); fire(code); setTimeout(()=>heldKeys.delete(code),160); } else if(k>=10&&k<14) drumPad(p.seat,DR[k-10]); break; }
      case 'l': drop(id); break;
      case 'pp': X.send({f:'pq',p:id,t:d.t}); break;
      case 'cmd': if(p) cmd(String(d.c||''),p); break;
    }
  };
  X.send=d=>!!(X.net&&X.net.send(d));
  X.ok=(p,id)=>X.send({f:'ok',p:id,s:p.seat,n:p.names[p.members.indexOf(id)]||'',m:p.members.length});
  X.roster=()=>X.send({f:'ro',s:players.map(p=>p.src==='phone'?p.names.slice(0,2):(p.human?[p.src==='pad'?'PAD':'KEY']:[])),k:players.map(p=>p.human?(p.src==='phone'?1:2):0)});
  X.state=force=>{ const cs=state==='play'?called():null; const s={f:'st',ph:state,cue:cs?cs.id:-1,sc:players.map(p=>p.score),r:lvlI+1,h:hearts,tm:state==='play'?Math.max(0,Math.round((songEnd-now())/1000)):0};
    const key=JSON.stringify(s), T=now(), minIv=X.transport==='room'?400:100; if(!force){ if(key===X.lastSt&&T-X.lastStT<1000) return; if(T-X.lastStT<minIv) return; } X.lastSt=key; X.lastStT=T; X.send(s); };
  X.ev=(seat,e)=>{ const p=players[seat]; if(!p||!p.members.length) return; if(e==='h'){ const T=now(); if(T-(X.hT[seat]||0)<90) return; X.hT[seat]=T; } X.evq.push([seat,e]); if(X.evq.length>24) X.evq.splice(0,X.evq.length-24); };
  X.tick=T=>{
    const cs=state==='play'?called():null; const cid=cs?cs.id:-1; if(cid!==X.lastCue){ X.lastCue=cid; if(cid>=0) X.ev(cid,'n'); }
    const iv=X.transport==='room'?150:50; if(X.evq.length&&T-X.evT>=iv){ X.evT=T; X.send({f:'ev',l:X.evq.splice(0,8)}); }
    X.state(false);
    if(T-X.pruneT>2000){ X.pruneT=T; players.forEach(p=>[...p.members].forEach(m=>{ if(T-(p.seen[m]||0)>45000) drop(m); }));
      const n=players.reduce((a,p)=>a+p.members.length,0); const el=document.getElementById('roomN'); const txt=n?`${n} PHONE${n>1?'S':''}`:''; if(el.textContent!==txt) el.textContent=txt; }
  };
  X.results=()=>{ const rank=[...players].sort((a,b)=>b.score-a.score); X.send({f:'res',sc:players.map(p=>p.score),rk:players.map(p=>rank.indexOf(p)),rd:lvlI+1,w:overWon?1:0}); };
  X.start=()=>{ X.net=makeParty({code:ROOM,pid:'tv',onFrame:X.onFrame,onStatus:setStatus}); };
  X.drop=drop; X.seatOf=seatOf;
  return X;
})();
// the speakers: a browser needs one real key press before it will make sound — the remote's OK does it
/* hub mode: BACK TO HOME — results ride in sessionStorage for the hub's medal table, phones get home{g,r} and follow */
function goHome(){ if(!HUB||window.__homeSent) return; window.__homeSent=true; const r=players.flatMap(p=>p.src==='phone'?p.names.map(n=>({n,s:p.score,k:1})):p.human?[{n:p.name,s:p.score,k:2}]:[]); try{ sessionStorage.setItem('bch:result',JSON.stringify({g:'quartet',at:Date.now(),r})); }catch(e){}
  const top=r.filter(x=>x.k).sort((a,b)=>b.s-a.s).slice(0,3).map(x=>[x.n,x.s]); PARTY.send({f:'home',g:'quartet',r:top}); setTimeout(()=>PARTY.send({f:'home',g:'quartet',r:top}),350); setTimeout(()=>{ location.href='/brick-choir/home?room='+ROOM+'&hub=1'+HUB_PASS; },800); }
const sndEl=document.getElementById('snd'); setInterval(()=>{ sndEl.hidden=!!(ctx&&ctx.state==='running'); },400);

/* ================= input: the remote, the keyboard, gamepads ================= */
const SP2=()=>now()-stateT;
function codeOf(e){ return ALIAS[e.code]||e.code; }
const NAV={ArrowLeft:-1,ArrowRight:1,ArrowUp:-1,ArrowDown:1}; const CH='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
const isOK=code=>code==='Enter'||code==='NumpadEnter'||code==='MediaPlayPause'||code==='Select';
const isBack=code=>code==='Escape'||code==='Backspace'||code==='BrowserBack'||code==='GoBack'||code==='Exit';
function initialsKey(code,key){ // d-pad initials: up/down turn the letter, left/right move, OK confirms
  const at=entry[entryPos]||'A';
  if(code==='ArrowUp'||code==='ArrowDown'){ if(entry.length<entryPos+1) entry=(entry+'AAA').slice(0,entryPos+1); const ch=CH[(CH.indexOf(at)+(code==='ArrowUp'?1:CH.length-1))%CH.length]; entry=entry.slice(0,entryPos)+ch+entry.slice(entryPos+1); tone(64+CH.indexOf(ch)%12*2,{kind:'marimba',len:0.06}); return; }
  if(code==='ArrowRight'){ if(entry.length<entryPos+1) entry=(entry+'AAA').slice(0,entryPos+1); entryPos=Math.min(2,entryPos+1); return; }
  if(code==='ArrowLeft'){ entryPos=Math.max(0,entryPos-1); return; }
  if(isBack(code)){ entry=entry.slice(0,-1); entryPos=Math.max(0,Math.min(entryPos,entry.length)); return; }
  if(isOK(code)){ if(entryPos<2&&entry.length<3){ if(entry.length<entryPos+1) entry=(entry+'AAA').slice(0,entryPos+1); entryPos++; return; } submitScore((entry+'---').slice(0,3),entryFor); return; }
  if(key&&/^[A-Za-z0-9]$/.test(key)&&entryPos<3){ entry=entry.slice(0,entryPos)+key.toUpperCase()+entry.slice(entryPos+1); entryPos=Math.min(2,entryPos+1); tone(64+entry.length*4,{kind:'lead',len:0.08}); }
}
function skipInter(){ if(state==='inter'&&SP2()>1000){ interUpdate.chord=false; interUpdate.burst=false; interUpdate.ring=-1; balls=[]; beginRound(lvlI+1); } }
addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey||e.altKey) return; const code=codeOf(e); const sl=slots[code]; const dk=DRUMKEYS[code]; boot();
  const nav=NAV[code], ok=isOK(code), back=isBack(code);
  if(state==='initials'){ e.preventDefault(); initialsKey(code,e.key); return; }
  if(state==='attract'){
    if(ok){ e.preventDefault(); startLobby(); return; }
    if(nav!==undefined){ e.preventDefault(); if(attractPanel===3&&(code==='ArrowUp'||code==='ArrowDown')){ boardMode=boardMode==='week'?'all':'week'; renderUI(true); } else { attractPanel=(attractPanel+nav+4)%4; if(attractPanel===3) loadScores(); } attractT=now(); tone(76,{kind:'lead',len:0.05,vel:0.4}); return; }
    if(sl||dk){ e.preventDefault(); claimSeat(sl?sl.seat:dk[0],{name:'KEYS',src:'keys'}); if(!e.repeat){ if(sl){ heldKeys.add(code); fire(code); } else drumPad(dk[0],dk[1]); } } return; }
  if(state==='lobby'){
    if(ok){ e.preventDefault(); if(!activateFocus()) startGame(); return; } if(nav!==undefined){ e.preventDefault(); moveFocus(nav); return; } if(back){ e.preventDefault(); toAttract(); return; }
    if(sl||dk){ e.preventDefault(); if(claimSeat(sl?sl.seat:dk[0],{name:'KEYS',src:'keys'})) lobbyEnd=Math.max(lobbyEnd,now()+6000); if(!e.repeat){ if(sl){ heldKeys.add(code); fire(code); } else drumPad(dk[0],dk[1]); } } return; }
  if(state==='over'||state==='scores'||state==='paused'){ e.preventDefault();
    if(state==='scores'&&(code==='ArrowUp'||code==='ArrowDown')){ boardMode=boardMode==='week'?'all':'week'; renderUI(true); tone(76,{kind:'lead',len:0.05,vel:0.4}); return; }
    if(nav!==undefined){ moveFocus(nav); return; } if(SP2()<700) return; if(ok){ activateFocus(); return; }
    if(back){ if(state==='paused') menuAct('resume'); else if(state==='scores') toAttract(); } return; }
  if(state==='inter'){ e.preventDefault(); if(ok) skipInter(); return; }
  if(state==='play'&&back){ e.preventDefault(); setState('paused'); pausedLeft=songEnd-now(); focusMenu(); return; }
  if(!sl&&!dk) return; e.preventDefault(); if(e.repeat) return;
  if(state==='play'){ const seat=sl?sl.seat:dk[0]; if(!players[seat].human) claimSeat(seat,{name:'KEYS',src:'keys'}); }
  if(sl){ heldKeys.add(code); fire(code); } else drumPad(dk[0],dk[1]);
});
addEventListener('keyup',e=>heldKeys.delete(codeOf(e)));
addEventListener('blur',()=>heldKeys.clear());
cv.addEventListener('pointerdown',()=>{ boot(); if(state==='attract'&&SP2()>500) startLobby(); else if(state==='lobby'&&SP2()>800) startGame(); else if(state==='inter') skipInter(); });
ui.addEventListener('click',e=>{ const b=e.target.closest('.menu button[data-act]'); if(b){ boot(); menuAct(b.dataset.act); } });
// gamepads: a seat per controller. d-pad = notes 1–4, LB = 5, A B X Y = 6–9, RB = 10, triggers = drums; Start = OK, B = back in menus
const pads={}; const PAD_NOTES={12:0,13:1,14:2,15:3,4:4,0:5,1:6,2:7,3:8,5:9}; const PAD_DRUMS={6:'kick',7:'snare'};
function pollPads(T){ if(!navigator.getGamepads) return; let gps; try{ gps=navigator.getGamepads(); }catch(e){ return; } for(const gp of gps){ if(!gp) continue; const st=pads[gp.index]||(pads[gp.index]={seat:-1,btns:[]}); gp.buttons.forEach((b,i)=>{ const on=b.pressed||b.value>0.5; const was=st.btns[i]; st.btns[i]=on; if(on&&!was) padPress(st,i,gp); }); } }
function padPress(st,i,gp){
  const menu=state==='over'||state==='scores'||state==='paused'||state==='lobby';
  if(state==='initials'){ initialsKey({12:'ArrowUp',13:'ArrowDown',14:'ArrowLeft',15:'ArrowRight',0:'Enter',9:'Enter',1:'Backspace'}[i]||'',''); return; }
  if(i===9){ if(state==='attract') startLobby(); else if(state==='inter') skipInter(); else if(state==='play'){ setState('paused'); pausedLeft=songEnd-now(); focusMenu(); } else if(menu&&!activateFocus()&&state==='lobby') startGame(); return; }
  if(menu&&state!=='lobby'){ if(i===0){ activateFocus(); return; } if(i===1){ if(state==='paused') menuAct('resume'); else if(state==='scores') toAttract(); return; } if(i===14||i===12){ moveFocus(-1); return; } if(i===15||i===13){ moveFocus(1); return; } return; }
  if(state==='inter'){ if(i===0) skipInter(); return; }
  const k=PAD_NOTES[i], d=PAD_DRUMS[i]; if(k===undefined&&!d) return;
  if(st.seat<0||!players[st.seat].human||players[st.seat].src!=='pad'){ const free=players.find(p=>!p.human); if(!free) return; st.seat=free.seat; claimSeat(st.seat,{name:'PAD '+(gp.index+1),src:'pad'}); if(state==='lobby') lobbyEnd=Math.max(lobbyEnd,now()+6000); }
  if(d) drumPad(st.seat,d); else { const s=SEATS[st.seat]; const code=s.rows[k<5?0:1][k<5?k:k-5]; heldKeys.add(code); fire(code); setTimeout(()=>heldKeys.delete(code),160); }
}
addEventListener('gamepaddisconnected',e=>{ const st=pads[e.gamepad.index]; if(st&&st.seat>=0){ const p=players[st.seat]; if(p.src==='pad'){ p.human=false; p.src=null; p.name='BOT'; PARTY.roster(); } st.seat=-1; } });

if(TESTMODE) window.__bq={get party(){return PARTY;},get code(){return ROOM;},inject:d=>PARTY.onFrame(d),get menu(){return [...document.querySelectorAll('#ui .menu button')].map(b=>[b.textContent,b.classList.contains('focus')]);},get state(){return state;},get players(){return players;},get balls(){return balls;},get cells(){return cells;},get targets(){return targets;},get tIdx(){return tIdx;},slots,SEATS,get lvl(){return lvl;},get lvlI(){return lvlI;},get hearts(){return hearts;},
  start:()=>{boot();startGame();},claim:i=>claimSeat(i),lobby:()=>startLobby(),fire:c=>fire(c),setState,go:(s)=>{ if(s==='inter'){ interAct=0; setState('inter'); interStart(); } else if(s==='over'){ gameOver(false); } else if(s==='initials'){ entryFor=players[0]; entry='AB'; setState('initials'); } else setState(s); },
  endSong:()=>{ songEnd=0; }, act3:()=>{ lvlI=6; interAct=2; setState('inter'); interStart(); }, breakable, set attractPanel(v){ attractPanel=v; attractT=now(); }, get attractPanel(){ return attractPanel; }, get quartets(){ return quartets; }, get bells(){ return bells; }, word, get uiKey(){ return uiKey; }, get stateT(){ return stateT; }, get entryFor(){ return entryFor; }, get verse(){ return verse; }, get tunnels(){ return tunnels; },
  get rally(){ return rally; }, get boardMode(){ return boardMode; }, get boards(){ return {all:hiGlobal,week:hiWeek}; }};
loadScores(); toAttract(); PARTY.start(); requestAnimationFrame(frame);
