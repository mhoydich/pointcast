---
// /brick-choir/tv — Brick Choir: Quartet on the living-room TV. The TV is the stage and the only speaker; phones
// are the controllers. Each empty corner shows a QR code for /brick-choir/join?room=CODE; a phone that scans it
// becomes that seat (two phones per seat make a duet, eight in all). PARTY MODE is the ambient state: Quartet plays
// itself as a visualizer, and any phone, keyboard or gamepad can wander in and take a corner. OK on the remote (or a
// phone's START) opens the lobby and the rounds. Input travels over a WebSocket relay (the pointcast-drum Durable
// Object in `bc-` party mode, falling back to the presence room's chat); all audio is synthesized here.
// 10-foot UI: overscan-safe margins, big type, D-pad/OK/Back menus, Gamepad API seats. three.js 0.170 (jsDelivr).
// Same engine as /brick-choir/quartet (2026-09-23); scores post with game:"quartet". Built by Claude (Fable) for Mike.
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Brick Choir: TV · PointCast</title>
<meta name="description" content="Quartet on the big screen. Scan a corner with your phone and it becomes your seat; the TV is the stage and the speaker. Up to eight phones, two per seat.">
<meta property="og:title" content="Brick Choir: TV">
<meta property="og:description" content="Put the glass monument on the TV. Scan a corner with your phone; your phone is the controller.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/tv">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og4.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a1a">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/tv">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  /* 10-foot UI: sizes in vw (1vw = 19.2px at 1080p, 38.4px at 4K); everything sits inside a 4% overscan-safe frame */
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --sx:4vw; --sy:4vh;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;cursor:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;}
  canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;display:block;}

  /* ---- HUD ---- */
  #hud{position:fixed;inset:0;pointer-events:none;z-index:5;will-change:transform;}
  .card{position:absolute;width:17.5vw;min-height:9vw;padding:.7vw .9vw .8vw;border-radius:1.1vw;background:rgba(12,10,30,.8);border:.12vw solid rgba(255,255,255,.1);
    transition:box-shadow .25s,transform .12s;--c:#fff;border-color:color-mix(in oklab,var(--c) 45%,transparent);box-sizing:border-box;}
  .card.hit{box-shadow:0 0 1.4vw color-mix(in oklab,var(--c) 55%,transparent);transform:scale(1.03);}
  .card .who{font:700 .95vw var(--mono);letter-spacing:.12em;color:var(--c);display:flex;justify-content:space-between;gap:.6vw;}
  .card .who em{font-style:normal;opacity:.55;font-weight:500;}
  .card .nm{font:800 1.9vw/1.1 var(--display);margin-top:.15vw;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .card .nm small{font:600 .85vw var(--mono);letter-spacing:.1em;opacity:.55;margin-left:.4vw;vertical-align:middle;}
  .card .sc{font:600 2.2vw/1.1 var(--mono);margin-top:.15vw;font-variant-numeric:tabular-nums;}
  .card .keys{font:500 .78vw var(--mono);letter-spacing:.08em;opacity:.5;margin-top:.2vw;}
  .card .cb{font:700 .95vw var(--mono);color:var(--gold);height:1.3vw;margin-top:.25vw;letter-spacing:.06em;} .card .cb i{font-style:normal;color:var(--c);}
  .card.s0{left:var(--sx);bottom:var(--sy);} .card.s1{right:var(--sx);bottom:var(--sy);text-align:right;} .card.s2{right:var(--sx);top:var(--sy);text-align:right;} .card.s3{left:var(--sx);top:var(--sy);}
  .card.s1 .who,.card.s2 .who{flex-direction:row-reverse;}
  .card.bot .info{opacity:.75;}
  .card.called{box-shadow:0 0 0 .18vw var(--c),0 0 2vw color-mix(in oklab,var(--c) 60%,transparent);} .card.called .cb{color:var(--c);}
  .card .who i{font-style:normal;opacity:.85;}
  .card .away{opacity:.5;}
  /* an empty corner is a door: the QR code is the biggest thing on the card */
  .card .qr{display:none;grid-template-columns:auto 1fr;gap:.8vw;align-items:center;margin-top:.5vw;}
  .card.empty .qr{display:grid;} .card.empty .info .sc,.card.empty .info .cb,.card.empty .info .keys{display:none;}
  .card.s1 .qr,.card.s2 .qr{grid-template-columns:1fr auto;} .card.s1 .qr canvas,.card.s2 .qr canvas{order:2;}
  .card .qr canvas{width:7.4vw;height:7.4vw;border-radius:.5vw;background:#fff;padding:.32vw;box-sizing:border-box;image-rendering:pixelated;display:block;}
  .card .qr .scan{font:800 1.15vw/1.15 var(--display);color:var(--c);} .card .qr .scan small{display:block;font:600 .72vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);margin-top:.35vw;text-transform:uppercase;}
  .card .qr .scan em{font-style:normal;color:var(--ink);}
  #top{position:absolute;left:50%;top:var(--sy);transform:translateX(-50%);text-align:center;font:700 .95vw var(--mono);letter-spacing:.14em;color:var(--gold);white-space:nowrap;}
  #top .row{display:flex;gap:2.6vw;justify-content:center;} #top .tl{color:var(--mint);}
  #top .hs{font:600 2.1vw var(--mono);letter-spacing:0;color:var(--ink);font-variant-numeric:tabular-nums;}
  #top .rd{font:700 .9vw var(--mono);letter-spacing:.16em;color:var(--mint);margin-top:.2vw;}
  #hearts{display:inline-flex;gap:.3vw;margin-left:.6vw;vertical-align:middle;}
  #hearts i{width:.8vw;height:.8vw;background:var(--pink);display:inline-block;clip-path:polygon(50% 100%,0 40%,15% 5%,50% 25%,85% 5%,100% 40%);opacity:.18;} #hearts i.on{opacity:1;}
  #prog{position:absolute;left:50%;top:calc(var(--sy) + 5.6vw);width:34vw;height:.3vw;transform:translateX(-50%);border-radius:.2vw;background:rgba(255,255,255,.08);overflow:hidden;}
  #prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--gold),var(--mint));}
  #combo{position:absolute;left:50%;top:calc(var(--sy) + 6.3vw);transform:translateX(-50%);font:700 1.05vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.75);white-space:nowrap;}
  #combo.fever{color:var(--gold);text-shadow:0 0 1vw var(--gold);}
  /* the room bar: bottom centre, the second-biggest thing on the screen */
  #room{position:fixed;left:50%;bottom:var(--sy);transform:translateX(-50%);z-index:6;display:flex;align-items:center;gap:1.4vw;padding:.7vw 1.6vw .8vw;border-radius:999px;background:rgba(12,10,30,.82);border:.12vw solid rgba(255,255,255,.12);pointer-events:none;white-space:nowrap;}
  #room .lbl{font:700 .85vw var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.55);} #room .lbl b{display:block;font:500 1.05vw var(--display);letter-spacing:0;color:var(--ink);text-transform:none;margin-top:.15vw;}
  #room .code{font:800 3.4vw/1 var(--mono);letter-spacing:.22em;color:var(--gold);text-indent:.22em;text-shadow:0 0 1.6vw rgba(255,210,122,.45);}
  #room .st{display:flex;align-items:center;gap:.5vw;font:600 .8vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.55);text-transform:uppercase;}
  #room .st i{width:.7vw;height:.7vw;border-radius:50%;background:#666;box-shadow:0 0 .6vw #666;} #room .st.on i{background:var(--mint);box-shadow:0 0 .8vw var(--mint);} #room .st.connecting i,#room .st.reconnecting i{background:var(--gold);animation:blink 1s steps(2,end) infinite;} #room .st.offline i{background:var(--pink);}
  #room .n{font:700 1.1vw var(--mono);color:var(--mint);letter-spacing:.06em;}
  #snd{position:fixed;left:50%;top:calc(var(--sy) + 8vw);transform:translateX(-50%);z-index:7;font:700 1.1vw var(--mono);letter-spacing:.14em;color:#140f28;background:var(--gold);padding:.7vw 1.5vw;border-radius:999px;box-shadow:0 0 2vw rgba(255,210,122,.5);animation:blink 1.4s steps(2,end) infinite;pointer-events:none;}
  #words{position:fixed;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .word{position:absolute;transform:translate(-50%,-50%);font:800 1.5vw var(--display);white-space:nowrap;text-shadow:0 .1vw .8vw rgba(0,0,0,.6);will-change:transform,opacity;}
  .word.big{font-size:2.5vw;} .word.huge{font-size:4vw;letter-spacing:.02em;}

  /* ---- panels & menus ---- */
  #ui{position:fixed;inset:0;pointer-events:none;z-index:8;display:grid;place-items:center;will-change:transform;}
  .panel{background:rgba(12,10,30,.88);border:.12vw solid rgba(255,255,255,.12);border-radius:1.6vw;padding:2vw 2.8vw;text-align:center;min-width:40vw;max-width:56vw;box-sizing:border-box;
    box-shadow:0 2vw 5vw rgba(0,0,0,.45);animation:pop .35s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(.5vw);}}
  .panel h1{margin:0;font:800 2vw var(--display);color:var(--gold);letter-spacing:-.01em;}
  .panel h2{margin:0;font:800 3.3vw/1.05 var(--display);}
  .panel p{margin:.6vw 0 0;font:500 1.25vw/1.4 var(--display);color:rgba(244,240,255,.82);}
  .panel .mono{font:600 1vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);}
  .panel .tag{display:inline-block;font:700 .95vw var(--mono);letter-spacing:.16em;color:var(--mint);}
  .blink{animation:blink 1s steps(2,end) infinite;} @keyframes blink{50%{opacity:.25;}}
  .logo{display:flex;justify-content:center;gap:.01em;font:800 5.6vw/1 var(--display);letter-spacing:-.02em;}
  .logo span{display:inline-block;background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bob 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.18s);}
  .logo span.sp{width:.3em;}
  @keyframes bob{50%{transform:translateY(-.3vw);}}
  .sub{font:800 2.2vw var(--display);letter-spacing:.32em;color:var(--gold);margin-top:.4vw;text-indent:.32em;}
  .sub small{font:700 1.1vw var(--mono);letter-spacing:.3em;color:var(--mint);margin-left:1vw;vertical-align:middle;}
  .howto{display:grid;grid-template-columns:auto 1fr;gap:.7vw 1.2vw;align-items:center;margin:1.3vw auto 0;text-align:left;max-width:42vw;}
  .howto b{font:700 .95vw var(--mono);color:#140f28;background:var(--k,#fff);border-radius:999px;padding:.45vw .9vw;text-align:center;white-space:nowrap;}
  .howto span{font:500 1.2vw var(--display);}
  .seats{display:grid;grid-template-columns:1fr 1fr;gap:.8vw;margin:1.2vw 0 0;}
  .seat{border-radius:1.1vw;padding:.8vw 1vw;border:.12vw solid color-mix(in oklab,var(--c) 40%,transparent);background:color-mix(in oklab,var(--c) 10%,transparent);text-align:left;transition:transform .2s,background .2s;}
  .seat.human{background:color-mix(in oklab,var(--c) 26%,transparent);transform:scale(1.03);box-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 40%,transparent);}
  .seat b{font:800 1.25vw var(--display);color:var(--c);display:block;} .seat b small,.seat .k small{font:500 .8vw var(--mono);opacity:.6;letter-spacing:.04em;}
  .seat .k{font:600 1vw var(--mono);letter-spacing:.14em;margin-top:.3vw;}
  .seat .st{font:700 .85vw var(--mono);letter-spacing:.1em;opacity:.7;margin-top:.4vw;} .seat.human .st{opacity:1;color:var(--c);}
  .seat:nth-child(1){grid-area:2/1;} .seat:nth-child(2){grid-area:2/2;} .seat:nth-child(3){grid-area:1/2;} .seat:nth-child(4){grid-area:1/1;}
  .arch{display:grid;grid-template-columns:repeat(3,1fr);gap:.7vw;margin-top:1vw;} .arch div{display:grid;gap:.15vw;font:500 1vw var(--display);} .arch b{font:800 1.15vw var(--display);} .arch em{font:500 .75vw var(--mono);font-style:normal;opacity:.5;letter-spacing:.08em;}
  table.scores{margin:1vw auto 0;border-collapse:collapse;font:600 1.25vw var(--mono);}
  table.scores td{padding:.3vw .9vw;} table.scores tr.me td{color:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .podium{display:grid;gap:.6vw;margin:1.2vw 0 0;}
  .podium div{display:grid;grid-template-columns:3vw 1fr auto;gap:.9vw;align-items:center;padding:.6vw 1vw;border-radius:.9vw;background:rgba(255,255,255,.05);font:600 1.25vw var(--mono);text-align:left;}
  .podium div:first-child{background:color-mix(in oklab,var(--c) 22%,transparent);font-size:1.5vw;}
  .podium b{color:var(--c);} .podium em{font-style:normal;opacity:.55;font-size:.9vw;letter-spacing:.1em;}
  .initials{display:flex;justify-content:center;gap:1.3vw;margin:1.2vw 0 .6vw;}
  .initials b{width:5vw;height:6.2vw;border-radius:1vw;background:rgba(255,255,255,.08);display:grid;place-items:center;font:800 3.9vw var(--mono);position:relative;}
  .initials b.cur::after{content:"";position:absolute;bottom:.6vw;width:2.6vw;height:.3vw;background:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .initials b.cur::before{content:"▲";position:absolute;top:-1.3vw;font:700 .9vw var(--mono);color:var(--gold);}
  #fail{position:fixed;inset:0;display:none;place-items:center;text-align:center;z-index:30;padding:2vw;}
  #fail p{font:500 1.3vw var(--display);} #fail a{color:var(--gold);}
  .boards{display:flex;width:max-content;gap:.3vw;margin:0 auto .8vw;padding:.25vw;border-radius:999px;background:rgba(255,255,255,.06);border:.12vw solid rgba(255,255,255,.1);}
  .boards button{font:700 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.6);background:transparent;border:0;border-radius:999px;padding:.45vw .9vw;}
  .boards button[aria-pressed="true"]{background:var(--gold);color:#140f28;}
  .menu{pointer-events:auto;display:flex;gap:.8vw;justify-content:center;flex-wrap:wrap;margin-top:1.4vw;}
  .menu button{font:800 1.05vw var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:rgba(255,255,255,.08);border:.15vw solid rgba(255,255,255,.18);border-radius:999px;padding:.8vw 1.7vw;transition:transform .12s,background .12s;}
  .menu button.focus{background:var(--gold);color:#140f28;border-color:var(--gold);transform:scale(1.06);box-shadow:0 0 1.6vw rgba(255,210,122,.55);}
  .okhint{font:600 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.45);margin-top:.9vw;text-transform:uppercase;}
  .okhint kbd{display:inline-block;font:700 .8vw var(--mono);padding:.15vw .5vw;border-radius:.4vw;border:.1vw solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:var(--ink);margin:0 .15vw;}
  @media (prefers-reduced-motion:reduce){ .logo span,.blink,table.scores tr.me td,.initials b.cur::after,#snd,#room .st i{animation:none;} }
  body.hub .card .qr{display:none!important;} body.hub #room .lbl{color:var(--gold);}
</style>
</head>
<body>
<canvas id="gl" aria-label="Brick Choir: Quartet on the TV — scan a corner with your phone to sit there"></canvas>
<div id="hud" hidden>
  <div id="top"><div class="row"><div><span id="hsl">HIGH SCORE</span><div class="hs" id="hs">000000</div></div><div><span class="tl">TEAM</span><div class="hs" id="team">000000</div></div></div><div class="rd"><span id="rd">ROUND 1</span><span id="hearts"><i class="on"></i><i class="on"></i><i class="on"></i></span></div></div>
  <div id="prog"><i></i></div>
  <div id="combo"></div>
  <div class="card s0 empty" id="c0"><div class="info"></div><div class="qr"><canvas width="33" height="33"></canvas><div class="scan"></div></div></div>
  <div class="card s1 empty" id="c1"><div class="info"></div><div class="qr"><canvas width="33" height="33"></canvas><div class="scan"></div></div></div>
  <div class="card s2 empty" id="c2"><div class="info"></div><div class="qr"><canvas width="33" height="33"></canvas><div class="scan"></div></div></div>
  <div class="card s3 empty" id="c3"><div class="info"></div><div class="qr"><canvas width="33" height="33"></canvas><div class="scan"></div></div></div>
</div>
<div id="room"><div class="lbl">JOIN ON YOUR PHONE<b id="roomUrl">pointcast.xyz/brick-choir/join</b></div><div class="code" id="roomCode">····</div><div class="st connecting" id="roomSt"><i></i><span id="roomStTxt">connecting</span></div><div class="n" id="roomN"></div></div>
<div id="snd" hidden>PRESS OK ON THE REMOTE TO TURN ON THE SPEAKERS</div>
<div id="words"></div>
<div id="ui"></div>
<div id="fail"><p>Brick Choir TV needs WebGL and a working connection to load three.js.<br><a href="/brick-choir/quartet">Play Quartet on a laptop instead →</a></p></div>

<script type="importmap" is:inline>
{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js", "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/" } }
</script>
<script is:inline>
  setTimeout(function(){ if(!window.__quartetBooted){ document.getElementById('fail').style.display='grid'; } }, 9000);
</script>
<script type="module" is:inline>
import * as THREE from 'three';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
window.__quartetBooted=true;
// tiny QR encoder (byte mode, ECC level M, versions 1–10, best mask) — a compact port of the
// public-domain algorithm in Nayuki's qrcodegen. Returns { size, get(x,y) } for a string.
// Inlined into tv.astro; kept here as a module so it can be verified against a reference encoder.
function qr(text, eccIdx = 1, forceMask = -1) {
  // eccIdx: 0=L 1=M 2=Q 3=H (default M)
  const ECC_CODEWORDS_PER_BLOCK = [[-1,7,10,15,20,26,18,20,24,30,18],[-1,10,16,26,18,24,16,18,22,22,26],[-1,13,22,18,26,18,24,18,22,20,24],[-1,17,28,22,16,22,28,26,26,24,28]]; // L,M,Q,H
  const NUM_ERROR_CORRECTION_BLOCKS = [[-1,1,1,1,1,1,2,2,2,2,4],[-1,1,1,1,2,2,4,4,4,5,5],[-1,1,1,2,2,4,4,6,6,8,8],[-1,1,1,2,4,4,4,5,6,8,8]];
  const ECL = [1,0,3,2]; // format bits for L,M,Q,H
  const lvl = eccIdx;
  const data = new TextEncoder().encode(text);
  const rawCap = v => { let r = (16*v+128)*v+64; if (v >= 2) { const a = Math.floor(v/7)+2; r -= (25*a-10)*a-55; if (v >= 7) r -= 36; } return r; };
  const dataCap = v => Math.floor(rawCap(v)/8) - ECC_CODEWORDS_PER_BLOCK[lvl][v]*NUM_ERROR_CORRECTION_BLOCKS[lvl][v];
  let ver = 1; for (; ver <= 10; ver++) { if (dataCap(ver) >= data.length + 2 + (ver >= 10 ? 1 : 0)) break; }
  if (ver > 10) throw new Error('qr: too long');
  // bit stream: mode 0100, count (8 bits for v<10, 16 for v>=10), data, terminator, pad
  const bits = []; const put = (val, n) => { for (let i = n-1; i >= 0; i--) bits.push((val >>> i) & 1); };
  put(4, 4); put(data.length, ver >= 10 ? 16 : 8); data.forEach(b => put(b, 8));
  const cap = dataCap(ver)*8; put(0, Math.min(4, cap - bits.length)); while (bits.length % 8) bits.push(0);
  for (let pad = 0xEC; bits.length < cap; pad ^= 0xEC ^ 0x11) put(pad, 8);
  const dataCw = []; for (let i = 0; i < bits.length; i += 8) dataCw.push(parseInt(bits.slice(i, i+8).join(''), 2));
  // reed–solomon
  const numBlocks = NUM_ERROR_CORRECTION_BLOCKS[lvl][ver], blockEcc = ECC_CODEWORDS_PER_BLOCK[lvl][ver], rawCw = Math.floor(rawCap(ver)/8);
  const numShort = numBlocks - rawCw % numBlocks, shortLen = Math.floor(rawCw/numBlocks);
  const mul = (x, y) => { let z = 0; for (let i = 7; i >= 0; i--) { z = (z << 1) ^ ((z >>> 7) * 0x11D); z ^= ((y >>> i) & 1) * x; } return z; };
  const rsDiv = [];
  { const d = Array(blockEcc).fill(0); d[blockEcc-1] = 1; let root = 1;
