    const outer={}; cells.forEach(c=>{ if(c.hp>0&&c.hp!==Infinity&&c.born<=T&&c.face===p.seat){ if(!outer[c.pos]||c.ring<outer[c.pos].ring) outer[c.pos]=c; } });
