---
// /brick-choir/home-join — the phone side of the Living Room Hub. Scan the one QR on /brick-choir/home, give a name,
// and your phone is in the room for the night: it shows the same menu as the TV (tap a cabinet to pick it; the host's
// phone has GO), then follows the TV into Rally, Lanes or Quartet (the game's join page opens with the room, your name
// and your colour already filled in — no typing, no rescanning) and comes back here when the TV comes home.
// Frames ride the same party relay as the games (room bc-CODE). Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Brick Choir · Home · your phone</title>
<meta name="description" content="Scan once, play every cabinet. Your phone follows the TV from game to game.">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0b0a1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/home-join">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --violet:#b9a8ff; --c:#ffd27a;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;overscroll-behavior:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;}
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;touch-action:manipulation;text-align:left;}
  #app{position:fixed;inset:0;display:flex;flex-direction:column;padding:calc(14px + env(safe-area-inset-top,0px)) 16px calc(14px + env(safe-area-inset-bottom,0px));box-sizing:border-box;}
  .screen{flex:1;display:flex;flex-direction:column;gap:12px;min-height:0;animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.97) translateY(6px);}}
  .logo{display:flex;justify-content:center;gap:.01em;font:800 clamp(28px,9vw,40px)/1 var(--display);letter-spacing:-.02em;margin-top:8px;}
  .logo span{background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;} .logo span.sp{width:.28em;}
  .sub{text-align:center;font:800 12px var(--mono);letter-spacing:.3em;color:var(--gold);text-indent:.3em;}
  .lead{margin:6px 0 0;text-align:center;font:500 15px/1.4 var(--display);color:rgba(244,240,255,.75);} .lead b{color:var(--ink);font-weight:700;}
  .lbl{font:700 12px var(--mono);letter-spacing:.2em;color:var(--mint);margin-top:8px;} .lbl small{display:block;font:500 11px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.5);margin-top:3px;text-transform:none;}
  .fine{margin:0;text-align:center;font:500 12px/1.4 var(--display);color:rgba(244,240,255,.5);}
  .top{display:flex;justify-content:space-between;align-items:center;gap:8px;} .top a{font:600 12px var(--mono);letter-spacing:.1em;color:var(--sky);text-decoration:none;}
  .chip{font:700 13px var(--mono);letter-spacing:.16em;color:#140f28;background:var(--gold);border-radius:999px;padding:7px 12px;white-space:nowrap;} .chip.ghost{background:rgba(255,255,255,.1);color:var(--ink);} .chip.me{background:var(--c);}
  .boxes{display:flex;justify-content:center;gap:10px;}
  .boxes b{width:64px;height:78px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);display:grid;place-items:center;font:800 44px var(--mono);color:var(--gold);position:relative;}
  .boxes b.cur{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 18px rgba(255,210,122,.35);} .boxes b.cur:empty::after{content:"";width:26px;height:4px;background:var(--gold);position:absolute;bottom:12px;animation:blink .7s steps(2,end) infinite;}
  @keyframes blink{50%{opacity:.2;}}
  .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;flex:1;min-height:0;align-content:start;}
  .grid button{aspect-ratio:1.15;min-height:44px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);font:700 22px var(--mono);color:var(--ink);transition:transform .08s,background .08s;text-align:center;}
  .grid button:active,.grid button.on{background:var(--gold);color:#140f28;transform:scale(.94);}
  .grid button.bk{font-size:18px;color:var(--pink);}
  .big{display:block;width:100%;padding:16px 18px;border-radius:999px;background:var(--gold);color:#140f28;font:800 15px var(--mono);letter-spacing:.14em;box-shadow:0 8px 30px rgba(255,210,122,.3);transition:transform .1s,opacity .2s;text-align:center;}
  .big:active{transform:scale(.98);} .big[disabled]{opacity:.35;box-shadow:none;} .big.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.16);box-shadow:none;} .big.me{background:var(--c);box-shadow:0 8px 30px color-mix(in oklab,var(--c) 40%,transparent);}
  /* the hub screen */
  .status{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);}
  .status .dot{width:10px;height:10px;border-radius:50%;background:#666;box-shadow:0 0 6px #666;flex:none;} .status.on .dot{background:var(--mint);box-shadow:0 0 8px var(--mint);} .status.off .dot{animation:blink 1s steps(2,end) infinite;}
  .status div{min-width:0;} .status b{display:block;font:800 15px/1.15 var(--display);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .status small{display:block;font:500 11px var(--mono);letter-spacing:.04em;color:rgba(244,240,255,.55);margin-top:2px;}
  .tiles{flex:1;min-height:0;overflow:auto;display:grid;gap:8px;align-content:start;}
  .tile{--c:#ffd27a;display:grid;grid-template-columns:52px 1fr auto;gap:12px;align-items:center;padding:10px 12px 10px 10px;border-radius:16px;background:color-mix(in oklab,var(--c) 10%,transparent);border:1px solid color-mix(in oklab,var(--c) 35%,transparent);transition:transform .1s,background .15s;}
  .tile:active{transform:scale(.98);} .tile.mine{background:color-mix(in oklab,var(--c) 26%,transparent);border-color:var(--c);box-shadow:0 0 0 1px var(--c),0 0 18px color-mix(in oklab,var(--c) 40%,transparent);}
  .tile.tv{border-style:solid;border-color:color-mix(in oklab,var(--c) 70%,transparent);}
  .tile .art{width:52px;height:39px;border-radius:8px;background:#06050f center/cover;border:1px solid rgba(255,255,255,.12);position:relative;overflow:hidden;} .tile .art::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,rgba(255,255,255,.14),transparent 40%);}
  .tile b{display:block;font:800 17px/1.1 var(--display);color:var(--c);} .tile small{display:block;font:600 10px var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.55);margin-top:3px;text-transform:uppercase;}
  .tile .v{display:flex;gap:4px;justify-content:flex-end;min-width:30px;} .tile .v i{width:14px;height:14px;border-radius:50%;background:var(--k);box-shadow:0 0 6px var(--k);display:grid;place-items:center;font:800 8px var(--mono);color:#140f28;font-style:normal;}
  .tile .tvtag{font:700 9px var(--mono);letter-spacing:.14em;color:#140f28;background:var(--c);padding:3px 7px;border-radius:999px;}
  .tile.day{grid-template-columns:52px 1fr auto;} .tile.day .art{background:conic-gradient(from 0deg,#ff8fb1,#ffd27a,#9fe3c9,#8fd0ff,#b9a8ff,#ff8fb1);border-radius:50%;width:44px;height:44px;margin:0 4px;}
  .roster{display:flex;gap:6px;flex-wrap:wrap;} .roster span{--c:#fff;font:700 12px var(--mono);letter-spacing:.06em;color:var(--c);padding:5px 9px;border-radius:999px;background:color-mix(in oklab,var(--c) 14%,transparent);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);} .roster span.away{opacity:.4;} .roster span.me{box-shadow:0 0 0 1px var(--c);}
  .hostrow{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;}
  #flash{position:fixed;inset:0;display:grid;place-items:center;pointer-events:none;opacity:0;z-index:20;} #flash b{font:800 clamp(28px,11vw,54px)/1 var(--display);color:var(--f,#fff);text-shadow:0 0 30px var(--f,#fff);text-align:center;padding:0 20px;}
  #flash.go{animation:flash 1.1s ease-out forwards;} @keyframes flash{0%{opacity:0;transform:scale(.8);}12%{opacity:1;transform:scale(1.04);}70%{opacity:1;}100%{opacity:0;transform:scale(1);}}
  /* the wait / launch screens */
  .center{align-items:center;justify-content:center;text-align:center;gap:14px;}
  .ring{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--c) calc(var(--p) * 1turn),rgba(255,255,255,.08) 0);box-shadow:0 0 40px color-mix(in oklab,var(--c) 40%,transparent);} .ring b{width:132px;height:132px;border-radius:50%;background:#0b0a1a;display:grid;place-items:center;font:800 52px var(--mono);color:var(--c);}
  h2{margin:0;font:800 26px/1.1 var(--display);letter-spacing:-.02em;} h2 b{color:var(--c);}
  .medal{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;font:800 10px var(--mono);color:#140f28;vertical-align:middle;margin-right:4px;} .medal.g{background:linear-gradient(135deg,#fff0b3,#ffd27a 60%,#c98e2e);} .medal.s{background:linear-gradient(135deg,#fff,#d8d8e6 60%,#8b8ba3);} .medal.b{background:linear-gradient(135deg,#ffd9b8,#ffb38a 60%,#a35c2e);}
</style>
</head>
<body>
<div id="flash" aria-hidden="true"><b id="flashTxt"></b></div>
<main id="app">
  <section id="sCode" class="screen">
    <div class="logo"><span style="--h:0">B</span><span style="--h:28">R</span><span style="--h:56">I</span><span style="--h:84">C</span><span style="--h:112">K</span><span class="sp"></span><span style="--h:168">C</span><span style="--h:196">H</span><span style="--h:224">O</span><span style="--h:252">I</span><span style="--h:280">R</span></div>
    <div class="sub">HOME · YOUR PHONE</div>
    <p class="lead">Put <b>pointcast.xyz/brick-choir/home</b> on the TV, then type the four letters it shows.</p>
    <div class="lbl">ROOM CODE</div>
    <div class="boxes" id="codeBoxes"><b></b><b></b><b></b><b></b></div>
    <div class="grid" id="codeGrid"></div>
    <button class="big" id="codeGo" disabled>FIND THE TV ▸</button>
    <p class="fine">or scan the code on the TV — it brings you here with the room filled in</p>
  </section>

  <section id="sName" class="screen" hidden>
    <div class="top"><span class="chip" id="nameRoom">ROOM ····</span><a href="#" id="nameBack">change</a></div>
    <div class="lbl">YOUR NAME <small>three letters, scoresheet style — it follows you into every game</small></div>
    <div class="boxes" id="nameBoxes"><b></b><b></b><b></b></div>
    <div class="grid six" id="nameGrid"></div>
    <button class="big" id="nameGo" disabled>JOIN THE ROOM ▸</button>
  </section>

  <section id="sHub" class="screen" hidden>
    <div class="top"><span class="chip" id="hubRoom">ROOM ····</span><span class="chip me" id="hubName">···</span></div>
    <div class="status off" id="status"><i class="dot"></i><div><b id="stTitle">Looking for the TV…</b><small id="stSub">the TV is on pointcast.xyz/brick-choir/home</small></div></div>
    <div class="lbl">PICK A CABINET <small id="pickSub">tap one — when everyone agrees, it starts</small></div>
    <div class="tiles" id="tiles"></div>
    <div class="roster" id="roster"></div>
    <div class="hostrow" id="hostRow" hidden><button class="big me" id="hostGo">GO ▸</button><button class="big ghost" id="hostBack" style="width:auto">BACK</button></div>
  </section>

  <section id="sWait" class="screen center" hidden>
    <div class="sub" id="waitSub">ON THE TV</div>
    <h2 id="waitTitle">Brick Choir is playing on the TV keyboard</h2>
    <p class="lead" id="waitLine">Keyboard cabinets are one player on the TV. Sit back — or bring the TV home.</p>
    <button class="big ghost" id="waitHome">BRING THE TV HOME</button>
  </section>

  <section id="sLaunch" class="screen center" hidden>
    <div class="sub">GET READY</div>
    <div class="ring" id="ring" style="--p:0"><b id="ringN">3</b></div>
    <h2 id="launchTitle">Heading to <b>Lanes</b></h2>
    <p class="lead" id="launchLine">Your phone follows the TV. No typing, no rescanning.</p>
  </section>
</main>
<script is:inline>
/* ================= party transport (shared by /brick-choir/tv and /brick-choir/join) =================
   A tiny relay client. Frames are small JSON objects (≤120 chars) and carry `o` (origin pid).
   1. /api/drum/room?room=bc-<code> — the pointcast-drum Durable Object; its welcome lists "bc-party" when the
      deployed Worker relays opaque party frames (workers/pointcast-drum, migration-free). Immediate fan-out.
   2. /api/room?url=/brick-choir/party/<code> — the presence Durable Object, sharded per URL; a `chat` message is
      broadcast at once to the whole room, so it works as a relay today with no Worker deploy (120-char frames).
   Reconnects with backoff, on visibility and on `online`; the pid stays the same so the TV keeps your seat. */
function makeParty({code,pid,onFrame,onStatus}){
  const P={transport:null,ws:null,status:'off',tries:0,closed:false,seen:new Set(),sent:0,recv:0};
  const room='bc-'+code.toLowerCase(); const proto=location.protocol==='https:'?'wss':'ws';
  const drumUrl=`${proto}://${location.host}/api/drum/room?room=${room}&sid=${pid}`;
  const roomUrl=`${proto}://${location.host}/api/room?url=${encodeURIComponent('/brick-choir/party/'+code.toLowerCase())}&sid=bc-${pid}`;
  const FORCE=(new URLSearchParams(location.search).get('transport')||'').toLowerCase(); // ?transport=room forces the fallback (tests)
  const setStatus=s=>{ if(P.status!==s){ P.status=s; if(onStatus) onStatus(s,P.transport); } };
  let timer=null;
  function open(which){
    if(P.closed) return; if(which==='drum'&&FORCE==='room') which='room'; setStatus('connecting'); let ws; try{ ws=new WebSocket(which==='drum'?drumUrl:roomUrl); }catch(e){ return fail(which); }
    // the guard only gives up on a socket that never opened; an open socket whose welcome is late (a TV's main thread is
    // busy compiling shaders at boot, and queued message events can land after a timer) gets a second, much longer wait:
    // falling back to the presence room while the phones stay on the drum relay would split the party (v9)
    P.ws=ws; let ok=false, guard=setTimeout(()=>{ if(ok) return; if(ws.readyState<=1&&which==='drum'){ guard=setTimeout(()=>{ if(!ok){ ws.onclose=null; try{ ws.close(); }catch(e){} open('room'); } },30000); return; } try{ ws.close(); }catch(e){} },4000);
    ws.onmessage=e=>{ let m; try{ m=JSON.parse(e.data); }catch(err){ return; } if(!m||typeof m!=='object') return;
      if(which==='drum'){
        if(m.type==='welcome'){ if((m.features||[]).includes('bc-party')){ ok=true; clearTimeout(guard); ready('drum'); } else { clearTimeout(guard); ws.onclose=null; try{ ws.close(); }catch(err){} open('room'); } return; }
        if(m.type==='party'&&m.d&&typeof m.d==='object'){ P.recv++; onFrame(m.d); } return; }
      // presence room: every broadcast carries the chat ring; what was there when we arrived is history
      if(!ok){ ok=true; clearTimeout(guard); (m.chat||[]).forEach(c=>P.seen.add(c.id)); ready('room'); return; }
      (m.chat||[]).forEach(c=>{ if(P.seen.has(c.id)) return; P.seen.add(c.id); if(P.seen.size>600) P.seen=new Set([...P.seen].slice(-300)); let d; try{ d=JSON.parse(c.msg); }catch(err){ return; } if(d&&typeof d==='object'&&d.o!==pid){ P.recv++; onFrame(d); } });
    };
    ws.onclose=()=>{ clearTimeout(guard); if(P.ws!==ws) return; P.ws=null; if(!ok) fail(which); else { setStatus('reconnecting'); retry(); } };
    ws.onerror=()=>{};
  }
  function ready(t){ P.transport=t; P.tries=0; P.seen.clear(); setStatus('on'); }
  function fail(which){ if(which==='drum'){ open('room'); return; } setStatus('offline'); retry(); }
  function retry(){ clearTimeout(timer); const wait=Math.min(6000,400*Math.pow(2,P.tries++)); timer=setTimeout(()=>open('drum'),wait); }
  P.send=d=>{ const ws=P.ws; if(!ws||ws.readyState!==1||P.status!=='on') return false; d.o=pid; try{ if(P.transport==='drum') ws.send(JSON.stringify({v:1,type:'party',d})); else ws.send(JSON.stringify({type:'chat',msg:JSON.stringify(d).slice(0,120)})); }catch(e){ return false; } P.sent++; return true; };
  P.kick=()=>{ if(P.closed) return; if(!P.ws||P.ws.readyState>1){ clearTimeout(timer); P.tries=0; open('drum'); } };
  P.close=()=>{ P.closed=true; clearTimeout(timer); try{ if(P.ws) P.ws.close(); }catch(e){} };
  document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') P.kick(); });
  addEventListener('online',()=>P.kick()); addEventListener('pageshow',()=>P.kick());
  open('drum'); return P;
}
/* ================= the phone on the hub ================= */
const PAL=['#ff8fb1','#ffd27a','#9fe3c9','#8fd0ff','#e9ff7a','#b9a8ff','#ffb38a','#e3a8ff'];
const GAMES=[
 {id:'park',name:'Pickle Park',sub:'buddies · doubles · phone paddles',join:'/brick-choir/park-join',kind:'phones',hex:'#ffb38a',art:'/brick-choir/park.webp'},
 {id:'quartet',name:'Quartet',sub:'four corners · phones',join:'/brick-choir/join',kind:'phones',hex:'#9fe3c9',art:'/brick-choir/key4.webp'},
 {id:'rally',name:'Rally',sub:'pickleball · phone paddles',join:'/brick-choir/rally-join',kind:'phones',hex:'#e9ff7a',art:'/brick-choir/rally.webp'},
 {id:'lanes',name:'Lanes',sub:'bowling · phone balls',join:'/brick-choir/lanes-join',kind:'phones',hex:'#b9a8ff',art:'/brick-choir/lanes.webp'},
 {id:'choir',name:'Brick Choir',sub:'the original · TV keyboard',kind:'keys',hex:'#ffd27a',art:'/brick-choir/key3.webp'},
 {id:'2600',name:'2600',sub:'console edition · TV keyboard',kind:'keys',hex:'#ffb38a',art:'/brick-choir/poster.webp'},
 {id:'day',name:'Sports Day',sub:'pickle park → lanes → quartet · medals',kind:'day',hex:'#ffd27a'},
];
const ALPHA='ABCDEFGHJKMNPQRSTUVWXYZ', NAMECH='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
const $=id=>document.getElementById(id); const TESTMODE=/[?&]bot\b/.test(location.search); const Q=new URLSearchParams(location.search);
const PASS=['bot','transport'].filter(k=>Q.has(k)).map(k=>k+(Q.get(k)?'='+encodeURIComponent(Q.get(k)):'')).join('&');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const store={get(k,d){try{const v=localStorage.getItem('bch:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{localStorage.setItem('bch:'+k,v);}catch(e){}}};
const sess={get(k,d){try{const v=sessionStorage.getItem('bch:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{sessionStorage.setItem('bch:'+k,v);}catch(e){}}};
// the pid lives in sessionStorage, which survives the trips into the games and back (same tab, same origin)
const pid=sess.get('pid','')||(()=>{ const a=new Uint8Array(4); crypto.getRandomValues(a); const v=Array.from(a,b=>'abcdefghijklmnopqrstuvwxyz0123456789'[b%36]).join(''); sess.set('pid',v); return v; })();
let code=(Q.get('room')||sess.get('room','')).toUpperCase().replace(/[^A-Z]/g,'').slice(0,4), name=(Q.get('name')||store.get('name','')).toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3);
let wanted=sess.get('joined','0')==='1', seat=-1, ci=Number(sess.get('c','-1')), col='#ffd27a', net=null, roster=null, rosterAt=0, hs=null, rtt=null, myVote=-1, wake=null, going='', goingIv=0;
const show=id=>{ document.querySelectorAll('.screen').forEach(s=>s.hidden=s.id!==id); };
const buzz=p=>{ try{ if(navigator.vibrate) navigator.vibrate(p); }catch(e){} };
function flash(txt,c){ const f=$('flash'); f.style.setProperty('--f',c||'#fff'); $('flashTxt').textContent=txt; f.classList.remove('go'); void f.offsetWidth; f.classList.add('go'); }
function theme(){ col=ci>=0?PAL[ci%8]:'#ffd27a'; document.documentElement.style.setProperty('--c',col); }

/* ---- code + name entry (the QR skips both) ---- */
function drawBoxes(el,val,n){ const cur=Math.min(val.length,n-1); [...el.children].forEach((b,i)=>{ b.textContent=val[i]||''; b.classList.toggle('cur',i===cur); }); }
function grid(el,chars,on){ el.innerHTML=''; chars.split('').forEach(ch=>{ const b=document.createElement('button'); b.textContent=ch; b.type='button'; b.onpointerdown=e=>{ e.preventDefault(); on(ch); b.classList.add('on'); setTimeout(()=>b.classList.remove('on'),120); }; el.appendChild(b); }); const bk=document.createElement('button'); bk.textContent='⌫'; bk.className='bk'; bk.type='button'; bk.onpointerdown=e=>{ e.preventDefault(); on(null); }; el.appendChild(bk); }
function codeUI(){ drawBoxes($('codeBoxes'),code,4); $('codeGo').disabled=code.length!==4; }
grid($('codeGrid'),ALPHA,ch=>{ code=ch===null?code.slice(0,-1):(code+ch).slice(0,4); codeUI(); buzz(8); });
$('codeGo').onclick=()=>{ if(code.length!==4) return; sess.set('room',code); $('nameRoom').textContent='ROOM '+code; nameUI(); show('sName'); };
function nameUI(){ drawBoxes($('nameBoxes'),name,3); $('nameGo').disabled=name.length<1; }
grid($('nameGrid'),NAMECH,ch=>{ name=ch===null?name.slice(0,-1):(name+ch).slice(0,3); nameUI(); buzz(8); });
$('nameBack').onclick=e=>{ e.preventDefault(); show('sCode'); };
$('nameGo').onclick=()=>{ if(!name) return; store.set('name',name); sess.set('room',code); $('hubRoom').textContent='ROOM '+code; $('hubName').textContent=name; wanted=true; sess.set('joined','1'); show('sHub'); if(net&&net.status==='on') net.send({f:'hj',p:pid,n:name,c:ci>=0?ci:undefined}); connect(); hubUI(); };

/* ---- the hub screen ---- */
$('tiles').innerHTML=GAMES.map((g,i)=>`<button class="tile ${g.kind}" data-i="${i}" style="--c:${g.hex}"><span class="art" style="${g.art?`background-image:url(${g.art})`:''}"></span><span><b>${esc(g.name)}</b><small>${esc(g.sub)}</small></span><span class="v" id="v${i}"></span></button>`).join('');
document.querySelectorAll('#tiles .tile').forEach(b=>{ b.onclick=()=>{ const i=+b.dataset.i; if(seat<0){ buzz(30); $('stTitle').textContent='Not in the room yet…'; return; } myVote=myVote===i?-1:i; if(net) net.send({f:'v',p:pid,i:myVote}); buzz(12); hubUI(); }; });
$('hostGo').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'go'}); buzz(20); };
$('hostBack').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'back'}); buzz(10); };
$('waitHome').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'home'}); buzz(20); };
const SC={menu:'Picking a game',launch:'Starting',medals:'Medal ceremony',ceremony:'Sports Day ceremony',dayintro:'Sports Day is starting',keys:'On the TV keyboard',boot:'Warming up'};
function hubUI(){ const on=net&&net.status==='on'; const st=$('status'); st.className='status '+(on?'on':'off');
  const isHost=seat===0; $('hostRow').hidden=!isHost||seat<0;
  if(!on) { $('stTitle').textContent='Connecting…'; $('stSub').textContent='the TV is on pointcast.xyz/brick-choir/home'; }
  else if(!roster) { $('stTitle').textContent='Looking for the TV…'; $('stSub').textContent=`no TV shows room ${code} yet · open pointcast.xyz/brick-choir/home on the TV`; }
  else if(seat<0) { $('stTitle').textContent='Asking the TV for a spot…'; $('stSub').textContent=`${roster.s.length} in the room`; }
  else { const sc=hs?hs.sc:'menu'; const g=hs&&hs.g?GAMES.find(x=>x.id===hs.g):null; const fo=hs?GAMES[hs.fo]:null;
    $('stTitle').textContent=sc==='menu'?`TV: ${fo?fo.name:'the menu'}`:sc==='launch'&&g?`Starting ${g.name} in ${hs.cd}`:sc==='medals'?(g?`Medals · next: ${g.name} in ${hs.cd}`:'Medals'):(SC[sc]||sc);
    $('stSub').textContent=isHost?'you are the host · GO starts what the TV has picked':`${roster.s.length} in the room · ${hs&&hs.d?'Sports Day is on':'tap a game to pick it'}`; }
  $('pickSub').textContent=isHost?'tap one — or press GO for what the TV shows':'tap one — when everyone agrees, it starts';
  GAMES.forEach((g,i)=>{ const b=document.querySelector(`#tiles .tile[data-i="${i}"]`); b.classList.toggle('mine',myVote===i); b.classList.toggle('tv',!!hs&&hs.fo===i&&hs.sc==='menu');
    const v=$('v'+i); const vs=roster&&hs?roster.s.map((n,k)=>({n,c:roster.c[k],v:hs.v[k]})).filter(x=>x.v===i):[]; const html=(hs&&hs.fo===i&&hs.sc==='menu'?`<span class="tvtag">TV</span>`:'')+vs.map(x=>`<i style="--k:${PAL[x.c%8]}">${esc((x.n||'')[0]||'')}</i>`).join(''); if(v.innerHTML!==html) v.innerHTML=html; });
  const ro=$('roster'); const html=roster?roster.s.map((n,k)=>`<span class="${roster.h&&!roster.h[k]?'away':''} ${k===seat?'me':''}" style="--c:${PAL[roster.c[k]%8]}">${k===0?'★ ':''}${esc(n)}</span>`).join(''):''; if(ro.innerHTML!==html) ro.innerHTML=html; }

/* ---- following the TV ---- */
function follow(g){ // the hub said go: the game's join page opens with everything filled in
  const G=GAMES.find(x=>x.id===g); if(!G){ return; } if(G.kind==='keys'){ $('waitTitle').textContent=`${G.name} is playing on the TV keyboard`; show('sWait'); buzz(20); return; } if(G.kind!=='phones'||going===g) return; going=g;
  sess.set('joined','1'); $('launchTitle').innerHTML=`Heading to <b>${esc(G.name)}</b>`; $('ring').style.setProperty('--c',G.hex); show('sLaunch'); flash(G.name.toUpperCase(),G.hex); buzz([30,30,60]);
  const url=`${G.join}?room=${code}&hub=1&name=${encodeURIComponent(name)}&c=${ci>=0?ci:''}${PASS?'&'+PASS:''}`; const t0=Date.now(); const dur=Math.max(600,(hs&&hs.sc==='launch'?hs.cd:2)*1000);
  goingIv=setInterval(()=>{ const p=Math.min(1,(Date.now()-t0)/dur); $('ring').style.setProperty('--p',p.toFixed(3)); $('ringN').textContent=Math.ceil((1-p)*dur/1000); if(p>=1){ clearInterval(goingIv); location.href=url; } },100); }
function unfollow(){ if(!going) return; clearInterval(goingIv); going=''; show('sHub'); flash('CANCELLED','#ffd27a'); }
function onFrame(d){ if(d.p&&d.p!==pid) return;
  switch(d.f){
    case 'hr': roster=d; rosterAt=Date.now(); hubUI(); break;
    case 'hok': { const was=seat; seat=d.s; if(Number.isInteger(d.c)){ ci=d.c; sess.set('c',String(ci)); } theme(); if(was<0){ flash(`${name} · IN`,col); buzz([40,30,80]); } if(!$('sWait').hidden||!$('sLaunch').hidden){ if(!going) show('sHub'); } hubUI(); wakeLock(); break; }
    case 'full': $('stTitle').textContent='The room is full (8 phones)'; $('stSub').textContent='wait for someone to leave'; buzz([30,30,30]); break;
    case 'who': if(wanted) net.send({f:'hj',p:pid,n:name,c:ci>=0?ci:undefined}); break;
    case 'hs': { hs=d; if(d.sc!=='menu') myVote=-1; if(d.sc==='launch'&&d.g) follow(d.g); else if(d.sc==='menu'){ if(going) unfollow(); else if(!$('sWait').hidden) show('sHub'); } hubUI(); break; }
    case 'go': if(d.g==='home'){ going=''; if($('sHub').hidden&&$('sCode').hidden&&$('sName').hidden) show('sHub'); } else follow(d.g); break;
    case 'pq': if(typeof d.t==='number') rtt=Date.now()-d.t; break;
  } }
function connect(){ if(net) return; net=makeParty({code,pid,onFrame,onStatus:s=>{ if(s==='on'){ net.send({f:'hhi',p:pid}); if(wanted) net.send({f:'hj',p:pid,n:name,c:ci>=0?ci:undefined}); } hubUI(); }});
  setInterval(()=>{ if(!net||net.status!=='on') return; net.send({f:'pp',p:pid,t:Date.now()}); if(seat<0&&wanted) net.send({f:'hj',p:pid,n:name,c:ci>=0?ci:undefined}); },3000); }
async function wakeLock(){ try{ if('wakeLock' in navigator&&!wake){ wake=await navigator.wakeLock.request('screen'); wake.addEventListener('release',()=>{ wake=null; }); } }catch(e){} }
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible'){ if(seat>=0) wakeLock(); if(net){ net.kick(); if(net.status==='on') net.send({f:'hhi',p:pid}); } } });

/* ---- boot: the QR lands with the code; a name from the URL or last time skips the keyboard ---- */
codeUI(); nameUI(); theme();
if(code.length===4){ $('nameRoom').textContent='ROOM '+code; if(name){ $('nameGo').onclick(); } else show('sName'); } else show('sCode');
if(TESTMODE) window.__hj={get seat(){return seat;},get c(){return ci;},get name(){return name;},get roster(){return roster;},get hs(){return hs;},get net(){return net;},get vote(){return myVote;},get screen(){return [...document.querySelectorAll('.screen')].find(s=>!s.hidden).id;},pid,
  setName:n=>{ name=n; nameUI(); },go:()=>$('nameGo').onclick(),pick:i=>document.querySelector(`#tiles .tile[data-i="${i}"]`).click(),host:()=>$('hostGo').click(),home:()=>$('waitHome').click()};
</script>
</body>
</html>
