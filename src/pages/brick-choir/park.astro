---
// /brick-choir/park — PICKLE PARK, the living-room pickleball game with Buddies. Phones scan one card, build a Buddy that
// looks like them (/brick-choir/park-join: skin, hair, eyes, brows, glasses, facial hair, hat, shirt, paddle, body, smile,
// a name — twelve numbers packed into a 14-char code) and the Buddy runs out of the clubhouse onto a park court at golden
// hour. The phone is the paddle: a swing is a motion spike, the tilt aims it, a soft push is a dink. Buddies run to the
// ball by themselves; only timing and shot choice matter. Doubles by default, house Buddies fill the court, a kitchen
// whistle for the bots who rush the net, replays of the great points from down low, a bleacher crowd made of everyone who
// has joined, a golden pickle for the winners. Every hit is a note on a steel pan or marimba; a long rally becomes a song.
// Scores post to /api/brick-scores as game "park". Hub mode (?room=CODE&hub=1) hides the card and returns with medals.
// three.js 0.170 (jsDelivr). Built 2026-09-24 by Claude (Fable) for Mike, who plays pickleball.
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pickle Park · Brick Choir · PointCast</title>
<meta name="description" content="Make a Buddy that looks like you on your phone; it walks onto a sunny park court on the TV and plays pickleball doubles. Your phone is the paddle, every hit is a note. One to four players, house Buddies fill the court.">
<meta property="og:title" content="Pickle Park · Brick Choir">
<meta property="og:description" content="Make a Buddy, walk onto the court, swing your phone. Pickleball for the whole living room.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/park">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/park.webp">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#f3c9a4">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/park">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  /* 10-foot UI: sizes in vw (1vw = 19.2px at 1080p); everything sits inside a 4% overscan-safe frame */
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --lime:#e9ff7a; --sx:4vw; --sy:4vh;
    --a:#ff8fb1; --b:#9fe3c9; --peach:#ffb38a; --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:#f3c9a4;overflow:hidden;cursor:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;}
  canvas#gl{position:fixed;inset:0;width:100vw;height:100vh;display:block;}

  /* ---- HUD ---- */
  #hud{position:fixed;inset:0;pointer-events:none;z-index:5;}
  #board{position:absolute;left:50%;top:var(--sy);transform:translateX(-50%);display:grid;grid-template-columns:auto auto auto;align-items:stretch;border-radius:1.1vw;overflow:hidden;background:rgba(24,18,44,.78);border:.12vw solid rgba(255,255,255,.16);box-shadow:0 1vw 3vw rgba(40,20,10,.35);backdrop-filter:blur(.6vw);}
  #board .tm{display:grid;grid-template-columns:auto auto;align-items:center;gap:1vw;padding:.7vw 1.4vw;--c:var(--a);}
  #board .tm.b{--c:var(--b);grid-template-columns:auto auto;direction:rtl;}
  #board .tm .nm{font:800 1.15vw var(--display);color:var(--c);letter-spacing:.02em;line-height:1.1;direction:ltr;text-align:left;} #board .tm.b .nm{text-align:right;}
  #board .tm .nm small{display:block;font:600 .7vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.5);margin-top:.15vw;}
  #board .tm .pt{font:800 3.4vw/1 var(--mono);color:var(--ink);font-variant-numeric:tabular-nums;min-width:2.2ch;text-align:center;direction:ltr;transition:transform .15s;}
  #board .tm.won .pt{color:var(--c);text-shadow:0 0 1.4vw color-mix(in oklab,var(--c) 70%,transparent);}
  #board .tm .srv{font:700 .7vw var(--mono);letter-spacing:.16em;color:var(--gold);height:.9vw;direction:ltr;margin-top:.25vw;} #board .tm.b .srv{text-align:right;}
  #board .mid{display:grid;place-items:center;padding:.5vw 1.2vw;border-left:.12vw solid rgba(255,255,255,.1);border-right:.12vw solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);text-align:center;min-width:8vw;}
  #board .mid .r{font:800 2.2vw/1 var(--mono);color:var(--gold);font-variant-numeric:tabular-nums;text-shadow:0 0 1vw rgba(255,210,122,.4);}
  #board .mid .rl{font:700 .68vw var(--mono);letter-spacing:.24em;color:rgba(244,240,255,.5);margin-top:.25vw;}
  #board .mid.hot .r{color:var(--lime);text-shadow:0 0 1.4vw rgba(233,255,122,.7);animation:pulse .5s ease-in-out infinite;} @keyframes pulse{50%{transform:scale(1.08);}}
  #melody{position:absolute;left:50%;top:calc(var(--sy) + 6.6vw);transform:translateX(-50%);display:flex;align-items:flex-end;gap:.25vw;height:3vw;}
  #melody i{width:.7vw;border-radius:.15vw .15vw 0 0;background:var(--c);box-shadow:0 0 .6vw color-mix(in oklab,var(--c) 70%,transparent);animation:rise .18s ease-out;} #melody i.sw{outline:.12vw solid #fff;}
  @keyframes rise{from{transform:scaleY(.2);opacity:0;}}
  /* the replay bug */
  #replay{position:absolute;left:var(--sx);top:var(--sy);display:flex;align-items:center;gap:.7vw;padding:.6vw 1.2vw;border-radius:.6vw;background:rgba(24,18,44,.8);border:.12vw solid rgba(255,255,255,.16);font:800 1.1vw var(--mono);letter-spacing:.2em;color:var(--ink);}
  #replay i{width:.8vw;height:.8vw;border-radius:50%;background:#ff4d6d;box-shadow:0 0 .8vw #ff4d6d;animation:blink 1s steps(2,end) infinite;} #replay span{color:var(--gold);} #replay small{font:600 .7vw var(--mono);letter-spacing:.12em;opacity:.5;}
  /* seat cards: near side left, far side right, with the Buddy's face */
  .card{position:absolute;width:15.5vw;height:5.6vw;display:grid;grid-template-columns:auto 1fr;gap:.6vw;align-items:center;padding:.5vw .8vw;border-radius:1vw;background:rgba(24,18,44,.78);border:.12vw solid rgba(255,255,255,.12);--c:#fff;border-color:color-mix(in oklab,var(--c) 45%,transparent);box-sizing:border-box;transition:box-shadow .25s,transform .12s,opacity .4s;backdrop-filter:blur(.6vw);}
  .card.hit{box-shadow:0 0 1.4vw color-mix(in oklab,var(--c) 60%,transparent);transform:scale(1.03);}
  .card.turn{box-shadow:0 0 0 .16vw var(--c),0 0 1.8vw color-mix(in oklab,var(--c) 60%,transparent);}
  .card.off{opacity:.35;} .card.bot{opacity:.75;}
  .card .av{width:4.2vw;height:4.2vw;border-radius:.8vw;background:color-mix(in oklab,var(--c) 25%,transparent);display:block;image-rendering:auto;}
  .card .info{min-width:0;}
  .card .who{font:700 .78vw var(--mono);letter-spacing:.12em;color:var(--c);display:flex;justify-content:space-between;gap:.6vw;} .card .who em{font-style:normal;opacity:.55;font-weight:500;}
  .card .nm{font:800 1.5vw/1.1 var(--display);margin-top:.1vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .card .cb{font:600 .8vw var(--mono);color:var(--gold);height:1.1vw;margin-top:.15vw;letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .card .cb i{font-style:normal;color:var(--c);font-weight:700;}
  .card.s0{left:var(--sx);bottom:calc(var(--sy) + 6.4vw);} .card.s1{left:var(--sx);bottom:var(--sy);} .card.s2{right:var(--sx);bottom:calc(var(--sy) + 6.4vw);} .card.s3{right:var(--sx);bottom:var(--sy);}
  .tag3{position:absolute;transform:translate(-50%,-100%);font:800 .95vw var(--display);color:var(--c);text-shadow:0 .1vw .5vw rgba(40,20,10,.7),0 0 .2vw rgba(0,0,0,.5);white-space:nowrap;letter-spacing:.02em;} .tag3 small{display:block;font:600 .62vw var(--mono);letter-spacing:.14em;opacity:.8;text-align:center;}
  .tag3.turn::after{content:"▼";display:block;text-align:center;font-size:.8vw;animation:bob .5s ease-in-out infinite;}
  @keyframes bob{50%{transform:translateY(.25vw);}}
  /* the join card (one QR for the whole court) sits above the far-side cards */
  #joincard{position:fixed;right:var(--sx);bottom:calc(var(--sy) + 13vw);z-index:6;display:grid;grid-template-columns:auto 1fr;gap:.7vw;align-items:center;padding:.6vw .8vw;border-radius:1vw;background:rgba(24,18,44,.82);border:.12vw solid rgba(255,210,122,.45);width:15.5vw;box-sizing:border-box;pointer-events:none;}
  #joincard canvas{width:5.4vw;height:5.4vw;border-radius:.4vw;background:#fff;padding:.26vw;box-sizing:border-box;image-rendering:pixelated;display:block;}
  #joincard .scan{font:800 1vw/1.15 var(--display);color:var(--gold);} #joincard .scan em{font-style:normal;color:var(--ink);display:block;} #joincard .scan small{display:block;font:600 .65vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);margin-top:.3vw;text-transform:uppercase;}
  body.hub #joincard{display:none!important;} body.hub #room .lbl{color:var(--gold);}
  /* the room bar */
  #room{position:fixed;left:50%;bottom:var(--sy);transform:translateX(-50%);z-index:6;display:flex;align-items:center;gap:1.3vw;padding:.6vw 1.5vw .7vw;border-radius:999px;background:rgba(24,18,44,.8);border:.12vw solid rgba(255,255,255,.14);pointer-events:none;white-space:nowrap;backdrop-filter:blur(.6vw);}
  #room .lbl{font:700 .8vw var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.55);} #room .lbl b{display:block;font:500 1vw var(--display);letter-spacing:0;color:var(--ink);text-transform:none;margin-top:.15vw;}
  #room .code{font:800 3vw/1 var(--mono);letter-spacing:.22em;color:var(--gold);text-indent:.22em;text-shadow:0 0 1.6vw rgba(255,210,122,.45);}
  #room .st{display:flex;align-items:center;gap:.5vw;font:600 .75vw var(--mono);letter-spacing:.12em;color:rgba(244,240,255,.55);text-transform:uppercase;}
  #room .st i{width:.65vw;height:.65vw;border-radius:50%;background:#666;box-shadow:0 0 .6vw #666;} #room .st.on i{background:var(--mint);box-shadow:0 0 .8vw var(--mint);} #room .st.connecting i,#room .st.reconnecting i{background:var(--gold);animation:blink 1s steps(2,end) infinite;} #room .st.offline i{background:var(--pink);}
  #room .n{font:700 1vw var(--mono);color:var(--mint);letter-spacing:.06em;}
  #snd{position:fixed;left:50%;bottom:calc(var(--sy) + 5.2vw);transform:translateX(-50%);z-index:7;font:700 1.05vw var(--mono);letter-spacing:.14em;color:#140f28;background:var(--gold);padding:.7vw 1.5vw;border-radius:999px;box-shadow:0 0 2vw rgba(255,210,122,.5);animation:blink 1.4s steps(2,end) infinite;pointer-events:none;}
  #words{position:fixed;inset:0;pointer-events:none;z-index:6;overflow:hidden;}
  .word{position:absolute;transform:translate(-50%,-50%);font:800 1.6vw var(--display);white-space:nowrap;text-shadow:0 .1vw .8vw rgba(40,20,10,.6),0 0 .25vw rgba(0,0,0,.4);will-change:transform,opacity;}
  .word.big{font-size:2.6vw;} .word.huge{font-size:5vw;letter-spacing:.02em;}


  #ui{position:fixed;inset:0;pointer-events:none;z-index:8;display:grid;place-items:center;}
  .panel{background:rgba(24,18,44,.86);backdrop-filter:blur(1vw);border:.12vw solid rgba(255,255,255,.12);border-radius:1.6vw;padding:2vw 2.8vw;text-align:center;min-width:40vw;max-width:58vw;box-sizing:border-box;box-shadow:0 2vw 5vw rgba(0,0,0,.45);animation:pop .35s cubic-bezier(.2,.9,.3,1.2);}
  .panel.clear{background:transparent;border:0;box-shadow:none;backdrop-filter:none;}
  .panel.low{align-self:end;margin-bottom:calc(var(--sy) + 5.5vw);padding:1.2vw 2.2vw;min-width:34vw;max-width:46vw;}
  .panel.low.wide{max-width:56vw;min-width:50vw;padding:1vw 1.8vw;} .lobbyhead h1{font-size:1.5vw;} .lobbyhead p{margin-top:.2vw;}
  .panel.wide .seats{grid-template-columns:repeat(4,1fr);gap:.6vw;margin-top:.8vw;} .panel.wide .seats .th{display:none;} .panel.wide .seat{padding:.5vw .6vw;gap:.5vw;grid-column:auto!important;} .panel.wide .seat img{width:3.6vw;height:3.6vw;} .panel.wide .seat b{font-size:1.05vw;} .panel.wide .seat .k{font-size:.75vw;margin-top:.15vw;} .panel.wide .seat .st{font-size:.7vw;margin-top:.2vw;}
  .panel.wide .menu{margin-top:.9vw;} .panel.wide .menu button{padding:.6vw 1.2vw;font-size:.9vw;} .panel.wide .okhint{margin-top:.5vw;}
  .panel.low .podium{grid-template-columns:repeat(4,1fr);gap:.5vw;} .panel.low .podium div{grid-template-columns:1fr;gap:.1vw;text-align:center;padding:.4vw .6vw;font-size:1vw;} .panel.low .podium div:first-child{font-size:1.1vw;}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(.5vw);}}
  .panel h1{margin:0;font:800 2vw var(--display);color:var(--gold);letter-spacing:-.01em;}
  .panel h2{margin:0;font:800 3.3vw/1.05 var(--display);}
  .panel h2.huge{font-size:6vw;letter-spacing:-.02em;}
  .panel p{margin:.6vw 0 0;font:500 1.25vw/1.4 var(--display);color:rgba(244,240,255,.82);}
  .panel .mono{font:600 1vw var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.6);}
  .panel .tag{display:inline-block;font:700 .95vw var(--mono);letter-spacing:.16em;color:var(--mint);}
  .blink{animation:blink 1s steps(2,end) infinite;} @keyframes blink{50%{opacity:.25;}}
  .logo{display:flex;justify-content:center;gap:.02em;font:800 6.5vw/1 var(--display);letter-spacing:-.03em;} .logo .sp{width:.35em;}
  .logo span{display:inline-block;background:linear-gradient(180deg,oklch(92% .12 var(--h)),oklch(72% .19 calc(var(--h) + 50)));-webkit-background-clip:text;background-clip:text;color:transparent;animation:bobl 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * -.22s);}
  @keyframes bobl{50%{transform:translateY(-.4vw) rotate(-2deg);}}
  .sub{font:800 1.5vw var(--display);letter-spacing:.34em;color:var(--gold);margin-top:.5vw;text-indent:.34em;} .sub small{font:700 .95vw var(--mono);letter-spacing:.3em;color:var(--mint);margin-left:1vw;vertical-align:middle;}
  .howto{display:grid;grid-template-columns:auto 1fr;gap:.7vw 1.2vw;align-items:center;margin:1.3vw auto 0;text-align:left;max-width:44vw;}
  .howto b{font:700 .95vw var(--mono);color:#140f28;background:var(--k,#fff);border-radius:999px;padding:.45vw .9vw;text-align:center;white-space:nowrap;}
  .howto span{font:500 1.2vw var(--display);}
  .seats{display:grid;grid-template-columns:1fr 1fr;gap:.8vw 2vw;margin:1.2vw 0 0;}
  .seats .th{font:800 .9vw var(--mono);letter-spacing:.24em;color:var(--c);text-align:left;}
  .seat{border-radius:1.1vw;padding:.6vw .9vw;border:.12vw solid color-mix(in oklab,var(--c) 40%,transparent);background:color-mix(in oklab,var(--c) 10%,transparent);text-align:left;transition:transform .2s,background .2s;display:grid;grid-template-columns:auto 1fr;gap:.8vw;align-items:center;}
  .seat img{width:5vw;height:5vw;border-radius:.9vw;background:color-mix(in oklab,var(--c) 22%,transparent);display:block;} .seat.off{opacity:.45;}
  .seat.human{background:color-mix(in oklab,var(--c) 26%,transparent);transform:scale(1.03);box-shadow:0 0 1.6vw color-mix(in oklab,var(--c) 40%,transparent);}
  .seat b{font:800 1.25vw var(--display);color:var(--c);display:block;} .seat b small,.seat .k small{font:500 .8vw var(--mono);opacity:.6;letter-spacing:.04em;}
  .seat .k{font:600 1vw var(--mono);letter-spacing:.1em;margin-top:.3vw;}
  .seat .st{font:700 .85vw var(--mono);letter-spacing:.1em;opacity:.7;margin-top:.4vw;} .seat.human .st{opacity:1;color:var(--c);}
  table.scores{margin:1vw auto 0;border-collapse:collapse;font:600 1.25vw var(--mono);}
  table.scores td{padding:.3vw .9vw;} table.scores tr.me td{color:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .podium{display:grid;gap:.6vw;margin:1.2vw 0 0;}
  .podium div{display:grid;grid-template-columns:3vw 1fr auto;gap:.9vw;align-items:center;padding:.6vw 1vw;border-radius:.9vw;background:rgba(255,255,255,.05);font:600 1.25vw var(--mono);text-align:left;}
  .podium div:first-child{background:color-mix(in oklab,var(--c) 22%,transparent);font-size:1.5vw;}
  .podium b{color:var(--c);} .podium em{font-style:normal;opacity:.55;font-size:.9vw;letter-spacing:.1em;}
  .initials{display:flex;justify-content:center;gap:1.3vw;margin:1.2vw 0 .6vw;}
  .initials b{width:5vw;height:6.2vw;border-radius:1vw;background:rgba(255,255,255,.08);display:grid;place-items:center;font:800 3.9vw var(--mono);position:relative;}
  .initials b.cur::after{content:"";position:absolute;bottom:.6vw;width:2.6vw;height:.3vw;background:var(--gold);animation:blink .6s steps(2,end) infinite;}
  .initials b.cur::before{content:"▲";position:absolute;top:-1.3vw;font:700 .9vw var(--mono);color:var(--gold);}
  .boards{display:flex;width:max-content;gap:.3vw;margin:0 auto .8vw;padding:.25vw;border-radius:999px;background:rgba(255,255,255,.06);border:.12vw solid rgba(255,255,255,.1);}
  .boards button{font:700 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.6);background:transparent;border:0;border-radius:999px;padding:.45vw .9vw;} .boards button[aria-pressed="true"]{background:var(--gold);color:#140f28;}
  .menu{pointer-events:auto;display:flex;gap:.8vw;justify-content:center;flex-wrap:wrap;margin-top:1.4vw;}
  .menu button{font:800 1.05vw var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:rgba(255,255,255,.08);border:.15vw solid rgba(255,255,255,.18);border-radius:999px;padding:.8vw 1.7vw;transition:transform .12s,background .12s;}
  .menu button.focus{background:var(--gold);color:#140f28;border-color:var(--gold);transform:scale(1.06);box-shadow:0 0 1.6vw rgba(255,210,122,.55);}
  .okhint{font:600 .85vw var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.45);margin-top:.9vw;text-transform:uppercase;}
  .okhint kbd,kbd.k{display:inline-block;font:700 .8vw var(--mono);padding:.15vw .5vw;border-radius:.4vw;border:.1vw solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:var(--ink);margin:0 .15vw;}
  .splash{font:800 7vw/1 var(--display);letter-spacing:-.02em;text-shadow:0 .3vw 2vw rgba(0,0,0,.5);animation:slam .5s cubic-bezier(.2,.9,.3,1.3);} @keyframes slam{from{transform:scale(1.6);opacity:0;}}
  .splash small{display:block;font:700 1.4vw var(--mono);letter-spacing:.3em;color:var(--ink);margin-top:.8vw;text-shadow:none;}
  .share{display:grid;grid-template-columns:auto auto;gap:1.6vw;align-items:center;margin-top:1.2vw;text-align:left;}
  .share img{width:30vw;border-radius:.8vw;border:.12vw solid rgba(255,255,255,.14);display:block;} .share canvas{width:8vw;height:8vw;border-radius:.6vw;background:#fff;padding:.4vw;box-sizing:border-box;image-rendering:pixelated;display:block;margin:0 auto .5vw;}
  #fail{position:fixed;inset:0;display:none;place-items:center;text-align:center;z-index:30;padding:2vw;} #fail p{font:500 1.3vw var(--display);} #fail a{color:var(--gold);}
  body.embed #room,body.embed .card,body.embed #joincard,body.embed #snd,body.embed #ui{display:none!important;}
  @media (prefers-reduced-motion:reduce){ .logo span,.blink,table.scores tr.me td,.initials b.cur::after,#snd,#room .st i,#board .mid.hot .r{animation:none;} }
</style>
</head>
<body>
<canvas id="gl" aria-label="Pickle Park: pickleball on the TV with Buddies — scan the card with your phone to make yours"></canvas>
<div id="hud" hidden>
  <div id="board">
    <div class="tm a" id="tmA"><div><div class="nm"><span id="nmA">NEAR SIDE</span><small id="subA"></small></div><div class="srv" id="srvA"></div></div><div class="pt" id="ptA">0</div></div>
    <div class="mid" id="mid"><div class="r" id="rallyN">0</div><div class="rl" id="rallyL">RALLY</div></div>
    <div class="tm b" id="tmB"><div><div class="nm"><span id="nmB">FAR SIDE</span><small id="subB"></small></div><div class="srv" id="srvB"></div></div><div class="pt" id="ptB">0</div></div>
  </div>
  <div id="melody"></div>
  <div id="replay" hidden><i></i>REPLAY <span>REPLAY</span><small>OK to skip</small></div>
  <div class="card s0" id="c0"></div>
