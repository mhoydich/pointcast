    poseBuddy(g,{t,moving,swingT,swingKind,swingHand:a.swingHand,waveT:a.waveT,celebT:a.celebT,sadT:a.sadT,T,i,beat:bp,energy,trophy:trophyHold});
    if(ceremony&&ceremony.spots[i]){ g.position.y+=ceremony.spots[i].y+(ceremony.spots[i].trophy?Math.abs(Math.sin(t*3))*0.5:0); if(trophyHold){ const hand=g._parts.arms[0]._hand; hand.getWorldPosition(trophy.position); trophy.position.y+=1.0; trophy.rotation.y=t*1.5; } }
  });
  extras.forEach(e=>{ let g=extraModels.get(e); if(!g){ g=buildBuddy(e.b); scene.add(g); extraModels.set(e,g); } g.position.x=e.x; g.position.z=e.z; g.rotation.y=e.face; poseBuddy(g,{t,moving:true,T,i:3}); });
  for(const [e,g] of extraModels){ if(!extras.includes(e)){ disposeBuddy(g); extraModels.delete(e); } }
  // the sweet ring
  const showRing=state==='play'&&intercept.valid&&turn>=0; sweetOuter.visible=sweetInner.visible=showRing;
  if(showRing){ const a=av[turn]; const tt=clamp((intercept.arrive-T)/900,0,1); const r=1+tt*3.2; sweetOuter.position.set(a.x,0.06,a.z); sweetOuter.scale.setScalar(r/3.75); sweetInner.position.set(a.x,0.07,a.z); const col=SEATS[turn].col; sweetOuter.material.color.copy(col); sweetOuter.material.opacity=0.35+(1-tt)*0.5; sweetInner.material.opacity=0.5+Math.sin(t*10)*0.3*(1-tt); }
  // ripples, sparks, confetti, bulbs
  for(let i=ripples.length-1;i>=0;i--){ const m=ripples[i]; const a=(T-m._t)/500; if(a>=1){ scene.remove(m); m.material.dispose(); ripples.splice(i,1); continue; } m.scale.setScalar(1+a*3); m.material.opacity=(1-a)*0.9; }
  let sc=0; const dt=1/60; for(let i=0;i<SPARKS;i++){ const s=sparkS[i]; if(!s.on) continue; const a=(T-s.t)/s.life; if(a>=1){ s.on=false; continue; } s.vy-=40*dt; s.x+=s.vx*dt; s.y+=s.vy*dt; s.z+=s.vz*dt; if(s.y<0){ s.y=0; s.vy=-s.vy*0.4; } cm.makeTranslation(s.x,s.y,s.z); cm.scale(new THREE.Vector3(1-a,1-a,1-a)); sparks.setMatrixAt(sc,cm); sparks.setColorAt(sc,cc.setHex(s.col)); sc++; } sparks.count=sc; sparks.instanceMatrix.needsUpdate=true; if(sparks.instanceColor) sparks.instanceColor.needsUpdate=true;
  if(ceremony&&confS.length){ confS.forEach((c,i)=>{ c.y+=c.vy*fdt; c.x+=Math.sin(t*2+c.ph)*fdt*2; c.rot+=fdt*3; if(c.y<0.1){ c.y=rnd(14,26); } _e.set(c.rot,c.ph,c.rot*0.7); _q.setFromEuler(_e); _p.set(c.x,c.y,c.z); cm.compose(_p,_q,_s.set(1,1,1)); confetti.setMatrixAt(i,cm); }); confetti.count=CONF; confetti.instanceMatrix.needsUpdate=true; } else confetti.count=0;
  bulbMat.emissiveIntensity=1.6+Math.sin(t*1.3)*0.3+energy*0.25;
  crowdFrame(T,t,bp);
  bloom.strength=0.45+flare*0.3+energy*0.03;
  stepWords(T); renderHud(T); renderUI(false);
  composer.render(); requestAnimationFrame(frame);
}
