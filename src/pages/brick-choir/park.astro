/* ---- extra patches on top of the Quartet engine: steel pan, pizzicato, an in-key whistle, the score chant ---- */
function pan(m,{t,vel=0.8,len=0.2,pan=0}={}){ if(!ctx||muted) return; try{ t=Math.max(t||0,ctx.currentTime); const f=mtof(m); const g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=pan;
  const parts=[[1,1,0.9],[2.0,0.5,0.35],[3.0,0.25,0.18],[4.55,0.1,0.08]]; const nodes=[]; parts.forEach(([r,a,d])=>{ const o=ctx.createOscillator(); o.type='sine'; o.frequency.setValueAtTime(f*r*1.01,t); o.frequency.exponentialRampToValueAtTime(f*r,t+0.04); const og=ctx.createGain(); og.gain.setValueAtTime(0.0001,t); og.gain.exponentialRampToValueAtTime(a*0.3*(0.4+0.6*vel),t+0.003); og.gain.exponentialRampToValueAtTime(0.0001,t+len+d*3); o.connect(og); og.connect(g); nodes.push(o); });
  g.connect(p); p.connect(sfx); p.connect(wet); p.connect(out._send); nodes.forEach(n=>{ n.start(t); n.stop(t+len+3); }); }catch(e){} }
function pizz(m,{t,vel=0.7,pan=0}={}){ if(!ctx||muted) return; try{ t=Math.max(t||0,ctx.currentTime); const f=mtof(m); const o=ctx.createOscillator(); o.type='triangle'; o.frequency.value=f; const o2=ctx.createOscillator(); o2.type='sine'; o2.frequency.value=f*2; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.setValueAtTime(3000,t); lp.frequency.exponentialRampToValueAtTime(300,t+0.12); const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.28*vel,t+0.002); g.gain.exponentialRampToValueAtTime(0.0001,t+0.22); const p=ctx.createStereoPanner(); p.pan.value=pan; const g2=ctx.createGain(); g2.gain.value=0.2; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); g.connect(p); p.connect(sfx); p.connect(wet); o.start(t); o2.start(t); o.stop(t+0.3); o2.stop(t+0.3); }catch(e){} }
function whistle(){ if(!ctx||muted) return; try{ const t=ctx.currentTime+0.01; const f=mtof(degOf(9,84)); [0,0.19].forEach((off,i)=>{ const o=ctx.createOscillator(); o.type='sine'; o.frequency.setValueAtTime(f*0.98,t+off); o.frequency.linearRampToValueAtTime(f*1.02,t+off+0.06); o.frequency.linearRampToValueAtTime(f*0.985,t+off+0.16); const vib=ctx.createOscillator(); vib.frequency.value=38; const vg=ctx.createGain(); vg.gain.value=f*0.02; vib.connect(vg); vg.connect(o.frequency); const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t+off); g.gain.exponentialRampToValueAtTime(0.32,t+off+0.02); g.gain.setValueAtTime(0.32,t+off+(i?0.24:0.14)); g.gain.exponentialRampToValueAtTime(0.0001,t+off+(i?0.34:0.18)); const n=nz(0.4); const bf=ctx.createBiquadFilter(); bf.type='bandpass'; bf.frequency.value=f; bf.Q.value=6; const ng=ctx.createGain(); ng.gain.value=0.5; n.connect(bf); bf.connect(ng); ng.connect(g); o.connect(g); g.connect(sfx); g.connect(wet); o.start(t+off); o.stop(t+off+0.5); vib.start(t+off); vib.stop(t+off+0.5); n.start(t+off); n.stop(t+off+0.5); }); }catch(e){} }
// the chant: each number is a syllable or two on a sung vowel (two detuned saws through two formant filters), on a sing-song contour in the key
const SYL={0:['zee','ro'],1:['one'],2:['two'],3:['three'],4:['four'],5:['five'],6:['six'],7:['sev','en'],8:['eight'],9:['nine'],10:['ten'],11:['e','lev','en'],12:['twelve'],13:['thir','teen'],14:['four','teen'],15:['fif','teen']};
const VOW={a:[800,1150],e:[400,2000],i:[300,2300],o:[450,800],u:[350,650]}; const vowelOf=s=>/ee|i/.test(s)?'i':/o/.test(s)?'o':/e/.test(s)?'e':/u/.test(s)?'u':'a';
function sing(m,vow,t,len,vel){ try{ const f=mtof(m); const g=ctx.createGain(); const [F1,F2]=VOW[vow]||VOW.a; const src=ctx.createGain(); [0,-9,9].forEach(d=>{ const o=ctx.createOscillator(); o.type='sawtooth'; o.frequency.setValueAtTime(f*0.97,t); o.frequency.exponentialRampToValueAtTime(f,t+0.06); o.detune.value=d; const vib=ctx.createOscillator(); vib.frequency.value=5.5; const vg=ctx.createGain(); vg.gain.value=f*0.012; vib.connect(vg); vg.connect(o.frequency); o.connect(src); o.start(t); o.stop(t+len+0.2); vib.start(t); vib.stop(t+len+0.2); });
  [[F1,8,1],[F2,10,0.55],[2900,12,0.22]].forEach(([fc,q,a])=>{ const bf=ctx.createBiquadFilter(); bf.type='bandpass'; bf.frequency.value=fc; bf.Q.value=q; const bg=ctx.createGain(); bg.gain.value=a; src.connect(bf); bf.connect(bg); bg.connect(g); });
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.5*vel,t+0.04); g.gain.setValueAtTime(0.5*vel,t+len-0.05); g.gain.exponentialRampToValueAtTime(0.0001,t+len+0.12); const p=ctx.createStereoPanner(); p.pan.value=0; g.connect(p); p.connect(sfx); p.connect(wet); }catch(e){} }
function chant(nums){ if(!ctx||muted) return; let t=ctx.currentTime+0.05; const spb=60/COURT.bpm; const contour=[[0,0],[2,1],[4,0],[-3,2]]; // a call: "four — two — one!"
  nums.forEach((n,i)=>{ const syl=SYL[Math.min(15,Math.max(0,n|0))]||['x']; const [d,dd]=contour[i%contour.length]; syl.forEach((s,k)=>{ const m=degOf(d+(k?dd:0),67); const len=(syl.length>1?0.16:0.26)*(i===nums.length-1&&k===syl.length-1?1.5:1); sing(m,vowelOf(s),t,len,0.9); t+=len+0.04; }); t+=spb*0.22; }); }

/* ================= groove: always under the rally, deeper the longer it goes ================= */
let seqT=0, seqS=0, energy=0, crowdOn=false;
function scheduler(){
  const on=(state==='play'||state==='serve'||state==='point'||state==='lobby'||state==='ready'||state==='over'||state==='replay');
  if(!ctx||!on){ seqT=0; return; }
  const spb=60/COURT.bpm, s16=spb/4; if(!seqT){ seqT=ctx.currentTime+0.06; seqS=0; }
  const soft=(state!=='play'&&state!=='serve'&&state!=='replay')||(demo&&energy===0); const e=soft?0:energy; const rootDeg=[0,3,4,0][Math.floor(seqS/16)%4];
  while(seqT<ctx.currentTime+0.12){
    const st=seqS%16, t=seqT;
    if(st%4===0) drum('kick',{t,vel:soft?0.35:0.7,bus:music});
    if(!soft&&st%2===1) drum('shaker',{t,vel:0.4,bus:music,pan:st%4===1?0.3:-0.3});
    if(soft&&state==='over'&&st%8===0) tone(degOf(rootDeg,48),{t,kind:'bass',len:s16*3,vel:0.5,bus:music});
    if(e>=1&&(st===4||st===12)) drum('clap',{t,vel:0.55,bus:music});
    if(e>=1&&st%8===2) pan(degOf(rootDeg+[0,2,4,2][Math.floor(seqS/8)%4],72),{t,vel:0.35,len:0.1,pan:0.5});
    if(e>=2&&st%4===0) tone(degOf(rootDeg,36),{t,kind:'bass',len:s16*2.4,vel:0.9,bus:music});
    if(e>=2&&(st===6||st===14)) tone(degOf(rootDeg,36),{t,kind:'bass',len:s16*1.5,vel:0.65,bus:music});
    if(e>=3){ drum('hat',{t,vel:st%4===2?0.7:0.3,bus:music}); if(st%2===0){ const arp=[0,2,4,7,4,2][Math.floor(st/2)%6]; tone(degOf(rootDeg+arp,72),{t,kind:'marimba',len:0.05,vel:0.25,pan:st%4?0.45:-0.45,bus:music}); } }
    if(crowdOn&&!soft&&(st===4||st===12)){ [0,0.012,0.03,0.05].forEach((o,i)=>drum('clap',{t:t+o,vel:0.5-i*0.08,bus:music,pan:(i%2?1:-1)*0.6})); }
    seqT+=s16; seqS++;
  }
}
const beatPhase=()=>{ if(!ctx||!seqT) return 0; const spb=60/COURT.bpm; return ((ctx.currentTime%spb)/spb); };
function crowdRoar(big){ if(!ctx||muted) return; try{ const t=ctx.currentTime; const n=nz(big?2.2:1.2); const bf=ctx.createBiquadFilter(); bf.type='bandpass'; bf.frequency.value=big?900:1200; bf.Q.value=0.6; const g=ctx.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(big?0.5:0.22,t+0.25); g.gain.exponentialRampToValueAtTime(0.0001,t+(big?2.2:1.1)); n.connect(bf); bf.connect(g); g.connect(sfx); g.connect(wet); n.start(t); n.stop(t+2.4); [0,0.05,0.11,0.2].forEach((o,i)=>drum('clap',{t:t+o+0.1,vel:0.5,pan:(i%2?1:-1)*0.6})); }catch(e){} }

