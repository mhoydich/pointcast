/* ================= court & ball (one unit = one foot: 20 × 44, the kitchen is 7 deep, the net 3 high) ================= */
const HW=10, HL=22, KZ=7, NET_H=3, G=30, REACH=4.8, PY=3;
const ball={x:0,y:3,z:0,vx:0,vy:0,vz:0,live:false,bounces:0,shot:0,hitter:-1,hitTeam:-1,hist:[],lastBounce:0,netted:false,atp:false,smash:false,pow:0};
const av=SEATS.map(s=>({seat:s.id,x:s.homeX,z:s.side*19,tx:s.homeX,tz:s.side*19,swingT:-1e9,swingKind:'n',swingHand:1,hitT:-1e9,face:0,mode:'court',enterT:0,path:null,waveT:-1e9,rush:false,celebT:-1e9,sadT:-1e9}));
const extras=[]; // Buddies walking off the court to the bleachers
let designated=[-1,-1]; // per team: which seat is on the ball
let intercept={seat:-1,x:0,z:0,t:0,valid:false,arrive:0};
const pending={}; // seat → an early swing waiting for the ball
const sideOf=z=>z>=0?1:-1;
// a ball is hittable out of the air only outside the kitchen — unless it's wide of the sideline (an Erne) or a bot is rushing (a fault)
const hittable=(b,seat=-1)=>{ if(!b.live) return false; if(b.bounces>=2) return false; if(b.shot<=2&&b.bounces<1) return false; if(b.bounces===0&&Math.abs(b.z)<KZ+0.4){ if(!(Math.abs(b.x)>HW+0.3||(seat>=0&&av[seat].rush))) return false; } return b.y<8.5&&Math.abs(b.x)<HW+4; };
function stepBall(b,dt,sim){
  if(!b.live) return null; b.vy-=G*dt; b.x+=b.vx*dt; b.y+=b.vy*dt; const z0=b.z; b.z+=b.vz*dt; let ev=null;
  if(sideOf(z0)!==sideOf(b.z)){ if(Math.abs(b.x)>HW+0.9){ if(!sim) b.atp=true; } else if(b.y<NET_H+0.1){ // into the net
    if(b.y>NET_H-0.35&&Math.random()<0.35&&!sim){ b.vz*=0.55; b.vy=Math.abs(b.vy)*0.3+4; ev='cord'; } else { b.z=z0; b.vz=-b.vz*0.18; b.vx*=0.4; b.vy=Math.min(b.vy,0)*0.3; b.netted=true; ev='net'; } } }
  if(b.y<=0&&b.vy<0){ b.y=0; b.vy=-b.vy*0.6; b.vx*=0.66; b.vz*=0.66; b.bounces++; ev=ev||'bounce'; b.lastBounce=sim?0:now(); }
  return ev;
}
function resetBall(){ ball.live=false; ball.bounces=0; ball.shot=0; ball.hitter=-1; ball.hitTeam=-1; ball.hist=[]; ball.netted=false; ball.atp=false; ball.smash=false; ball.pow=0; ball.vx=ball.vy=ball.vz=0; }
// simulate ahead: where and when does the receiving side's Buddy meet the ball?
function predict(){
  intercept.valid=false; if(!ball.live) return; const b={...ball,hist:null}; const tm=ball.hitTeam>=0?1-ball.hitTeam:(sideOf(ball.z)>0?0:1); const S=TEAMS[tm].side;
  const rusher=teamSeats(tm).find(x=>av[x].rush)>=0?teamSeats(tm).find(x=>av[x].rush):-1;
  let last=null, t=0; const dt=1/60;
  for(let i=0;i<180;i++){ const ev=stepBall(b,dt,true); t+=dt; if(ev==='net') break; if(sideOf(b.z)!==S) continue; const side0=(b.shot<=2&&b.bounces<1); if(b.bounces>=2) break;
    const volleyOk=Math.abs(b.z)>=KZ+0.4||Math.abs(b.x)>HW+0.3||rusher>=0;
    const ok=b.bounces>=1?(b.y<8.5):(!side0&&volleyOk&&b.y<8.5);
    if(ok){ last={x:b.x,z:b.z,y:b.y,t}; if(b.vy<0&&b.y<=PY+0.4) break; } }
  if(!last) return; intercept={seat:-1,x:clamp(last.x,-HW-3,HW+3),z:clamp(last.z,S>0?1.5:-HL-3,S>0?HL+3:-1.5),t:last.t,arrive:now()+last.t*1000,valid:true,team:tm};
}

/* ================= shots ================= */
function launch(from,tx,tz,T,lift){ ball.x=from.x; ball.y=from.y; ball.z=from.z; ball.vx=(tx-from.x)/T; ball.vz=(tz-from.z)/T; ball.vy=(0-from.y+0.5*G*T*T)/T+lift; ball.live=true; ball.bounces=0; ball.netted=false; ball.atp=false; }
function clearsNet(from,tx,tz,T,lift){ const vz=(tz-from.z)/T, vy=(0-from.y+0.5*G*T*T)/T+lift; if(Math.sign(vz)===Math.sign(from.z)||vz===0) return true; const t0=(0-from.z)/vz; const y0=from.y+vy*t0-0.5*G*t0*t0; return y0>NET_H+0.5; }
// aim assist: nudge the target toward the open court (away from the receiving Buddies)
function openCourt(tm,tx){ const rs=teamSeats(1-tm); if(!rs.length) return tx; const xs=rs.map(x=>av[x].x); const cands=[-6,-3,0,3,6]; let best=tx, bd=-1; cands.forEach(c=>{ const d=Math.min(...xs.map(x=>Math.abs(x-c))); if(d>bd){ bd=d; best=c; } }); return lerp(tx,best,0.35); }
function shoot(seat,{aim=0,lift=0,kind='n',q=0.8,serve=false,pow=0.6,hand=1}){
  const s=SEATS[seat], S=s.side, a=av[seat]; const from=serve?{x:a.x,y:2.6,z:a.z}:{x:ball.x,y:Math.max(1.2,ball.y),z:ball.z};
  const err=1-q; let tx, tz, T, lf=0, smash=false;
  if(serve){ const sx=Math.sign(a.x)||1; tx=-sx*4.5+aim*3.5; tz=-S*(13.5+lift*2.5); T=1.35; }
  else if(kind==='d'){ tx=aim*5+(Math.random()-0.5)*err*5; tz=-S*(3.5+Math.random()*2.5+err*3); T=1.15; lf=1.5; }
  else if(lift>0.35){ tx=aim*6.5+(Math.random()-0.5)*err*7; tz=-S*(15+lift*3.5+(Math.random()-0.5)*err*8); T=1.9; lf=2; }
  else { const drive=clamp(pow,0,1); tx=aim*7+(Math.random()-0.5)*err*8; tz=-S*(11+5*(1-drive*0.6)+(Math.random()-0.5)*err*10); T=1.32-drive*0.32; if(ball.bounces===0&&from.y>4.6&&drive>0.55){ smash=true; T=0.78; tz=-S*(9+Math.random()*5); } }
  if(!serve&&!demo&&kind!=='d') tx=openCourt(s.team,tx);
  tx=clamp(tx,-HW-6,HW+6);
  if(q>0.3&&!smash){ let k=0; while(!clearsNet(from,tx,tz,T,lf)&&k<8){ T+=0.08; lf+=0.5; k++; } }
  // the kitchen: a volley from inside the line is a fault (the Buddies keep humans out of it; a rushing bot gets whistled)
  if(!serve&&ball.bounces===0&&((Math.abs(from.z)<KZ&&Math.abs(from.x)<=HW+0.3)||(a.rush&&Math.abs(a.z)<KZ))){ a.swingT=now(); a.swingKind=kind; a.rush=false; kitchenFault(seat); return false; }
  const erne=!serve&&ball.bounces===0&&Math.abs(a.x)>HW+0.3&&Math.abs(a.z)<KZ;
  launch(from,tx,tz,T,lf);
  ball.shot++; ball.hitter=seat; ball.hitTeam=s.team; ball.hist=[]; ball.smash=smash; ball.pow=pow; lastShot={seat,kind,pow,serve,smash,erne,n:rallyLen+1};
  a.swingT=now(); a.swingKind=kind; a.swingHand=hand; a.hitT=now(); a.face=Math.atan2(tx-a.x,-(tz-a.z)*S);
  delete pending[seat];
  const sweet=q>=0.62;
  if(serve){ rallyLen=0; rallyNotes=[]; playHit(seat,0,sweet,kind); word(players[seat].human?'SERVE!':'serve',avScreen(seat,2),{color:s.hex}); }
  else { rallyLen++; totalHits++; players[seat].hits++; if(sweet) players[seat].sweets++; playHit(seat,rallyLen,sweet,kind);
    if(erne){ word('ERNE!',avScreen(seat,2),{color:'#fff3c4',huge:true}); lastPoint.tag='erne'; flare=1; crowdRoar(false); }
    else if(smash){ word('SMASH!',avScreen(seat,2),{color:'#fff3c4',big:true}); flare=1; }
