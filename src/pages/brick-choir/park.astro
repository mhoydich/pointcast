const SCALES={majpent:[0,2,4,7,9],lydian:[0,2,4,6,7,9,11],mixo:[0,2,4,5,7,9,10]};
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
