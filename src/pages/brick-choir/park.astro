const mkPlayer=(seat)=>({seat,human:false,src:null,name:'BOT',pid:null,seen:0,motion:false,hits:0,sweets:0,points:0,rtt:0,b:null,code:'',house:null,pal:-1});
let players=SEATS.map(s=>mkPlayer(s.id));
let score=[0,0], games=[0,0], gameN=0, TO=11, mode='doubles', server=0, serverNum=2, scoring='rally', pairs=false, pointsPlayed=0;
let lastShot=null, rallyLen=0, rallyNotes=[], longest=0, longestNotes=[], totalHits=0, matchWinner=-1, lastPoint={team:-1,why:'',tag:''};
let attractPanel=0, attractT=now(), lobbyEnd=0, hiLocal=store.get('scores',[]), hiGlobal=null, hiWeek=null, boardMode='week', entryQueue=[], entry='', entryPos=0, entryFor=null, myRecs=[];
