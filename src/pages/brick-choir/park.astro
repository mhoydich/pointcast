function setState(s,t){ state=s; stateT=now(); stateNext=t?{s:t.s,at:stateT+t.ms}:null; renderUI(true); PARTY.state(true); }
const humans=()=>players.filter(p=>p.human);
const activeSeats=()=>mode==='singles'?[0,2]:[0,1,2,3];
const isActive=seat=>activeSeats().includes(seat);
const teamSeats=t=>TEAMS[t].seats.filter(isActive);
