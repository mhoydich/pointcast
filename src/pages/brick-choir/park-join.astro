---
// /brick-choir/park-join — the phone for Pickle Park (the TV is /brick-choir/park). Scan the card on the TV or type the
// room code, pick a three-letter name, then MAKE YOUR BUDDY: skin, hair, colour, eyes, brows, glasses, facial hair, hat,
// shirt, paddle, body, smile — a live canvas preview that waves back, a randomize button, saved in localStorage so it
// comes back next time. WALK ON sends the Buddy to the TV as a 14-char code inside the party join frame; edits after that
// go as bd{b} and the TV rebuilds the Buddy in place. Then the phone is the paddle: a swing is a spike in linear
// acceleration (or angular rate), the lean at that moment aims left/right and lob/drive, the peak sets the power, the sign
// of the twist is forehand/backhand, a soft push (or a wrist flick) is a dink. No sensors, or permission denied, or a
// laptop: tap controls (left · centre · right, hold for a lob, a DINK bar). Hub mode (?room&hub=1&name&c) auto-joins with the
// saved Buddy (shirt in the hub colour when there is none) and follows home{}/go{} frames. Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Pickle Park: make your Buddy · PointCast</title>
<meta name="description" content="The phone for Pickle Park on the TV. Make a Buddy that looks like you, walk onto the court, swing.">
<meta property="og:title" content="Pickle Park: make your Buddy">
<meta property="og:description" content="Make a Buddy, walk on, swing your phone. Every hit is a note.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/park-join">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/park.webp">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0b0a1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/park-join">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --c:#ffd27a;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;overscroll-behavior:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;}
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;touch-action:manipulation;}
  #app{position:fixed;inset:0;display:flex;flex-direction:column;padding:calc(14px + env(safe-area-inset-top,0px)) 16px calc(14px + env(safe-area-inset-bottom,0px));box-sizing:border-box;}
  .screen{flex:1;display:flex;flex-direction:column;gap:12px;min-height:0;animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.97) translateY(6px);}}
  .logo{display:flex;justify-content:center;font:800 clamp(30px,10vw,44px)/1 var(--display);letter-spacing:-.02em;margin-top:8px;}
  .logo span{background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;} .logo i{width:.3em;}
  .sub{text-align:center;font:800 12px var(--mono);letter-spacing:.3em;color:var(--gold);text-indent:.3em;}
  .lead{margin:6px 0 0;text-align:center;font:500 15px/1.4 var(--display);color:rgba(244,240,255,.75);} .lead b{color:var(--ink);font-weight:700;}
  .lbl{font:700 12px var(--mono);letter-spacing:.2em;color:var(--mint);margin-top:8px;} .lbl small{display:block;font:500 11px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.5);margin-top:3px;text-transform:none;}
  .fine{margin:0;text-align:center;font:500 12px/1.4 var(--display);color:rgba(244,240,255,.5);}
  .top{display:flex;justify-content:space-between;align-items:center;} .top a{font:600 12px var(--mono);letter-spacing:.1em;color:var(--sky);text-decoration:none;}
  .chip{font:700 13px var(--mono);letter-spacing:.16em;color:#140f28;background:var(--gold);border-radius:999px;padding:7px 12px;} .chip.ghost{background:rgba(255,255,255,.1);color:var(--ink);}
  .boxes{display:flex;justify-content:center;gap:10px;}
  .boxes b{width:64px;height:78px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);display:grid;place-items:center;font:800 44px var(--mono);color:var(--gold);position:relative;}
  .boxes b.cur{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 18px rgba(255,210,122,.35);} .boxes b.cur:empty::after{content:"";width:26px;height:4px;background:var(--gold);position:absolute;bottom:12px;animation:blink .7s steps(2,end) infinite;}
  @keyframes blink{50%{opacity:.2;}}
  .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;flex:1;min-height:0;align-content:start;}
  .grid button{aspect-ratio:1.15;min-height:44px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);font:700 22px var(--mono);color:var(--ink);transition:transform .08s,background .08s;}
  .grid button:active,.grid button.on{background:var(--gold);color:#140f28;transform:scale(.94);}
  .grid button.bk{font-size:18px;color:var(--pink);}
  .big{display:block;width:100%;padding:16px 18px;border-radius:999px;background:var(--gold);color:#140f28;font:800 15px var(--mono);letter-spacing:.14em;box-shadow:0 8px 30px rgba(255,210,122,.3);transition:transform .1s,opacity .2s;}
  .big:active{transform:scale(.98);} .big[disabled]{opacity:.35;box-shadow:none;} .big.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.16);box-shadow:none;}
  /* seats: laid out like the TV — 4UP top-left, 3UP top-right, 1UP bottom-left, 2UP bottom-right */
  .seatgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;min-height:0;align-content:start;}
  .seatbtn{--c:#fff;text-align:left;padding:14px 14px 12px;border-radius:18px;background:color-mix(in oklab,var(--c) 10%,transparent);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);min-height:112px;display:flex;flex-direction:column;gap:4px;transition:transform .1s;}
  .seatbtn:active{transform:scale(.97);} .seatbtn.full{opacity:.4;}
  .seatbtn b{font:800 20px var(--display);color:var(--c);} .seatbtn b small{font:600 11px var(--mono);letter-spacing:.08em;opacity:.65;margin-left:6px;}
  .seatbtn .occ{font:600 13px var(--mono);letter-spacing:.06em;color:var(--ink);min-height:1.2em;} .seatbtn .st{margin-top:auto;font:700 11px var(--mono);letter-spacing:.14em;color:color-mix(in oklab,var(--c) 80%,#fff);}
  .seatbtn[data-seat="3"]{order:1;} .seatbtn[data-seat="2"]{order:2;} .seatbtn[data-seat="0"]{order:3;} .seatbtn[data-seat="1"]{order:4;}
  /* the paddle */
  .pad{gap:10px;}
  .padhead{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;}
  .seatbadge{display:flex;flex-direction:column;align-items:center;justify-content:center;width:58px;height:58px;border-radius:16px;background:color-mix(in oklab,var(--c) 22%,transparent);border:1px solid color-mix(in oklab,var(--c) 60%,transparent);}
  .seatbadge b{font:800 20px/1 var(--display);color:var(--c);} .seatbadge span{font:700 9px var(--mono);letter-spacing:.14em;opacity:.8;margin-top:3px;}
  .me b{display:block;font:800 24px/1 var(--display);letter-spacing:.02em;} .me small{display:block;font:600 11px var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.55);margin-top:4px;min-height:1.2em;}
  .net{display:flex;align-items:center;gap:5px;font:600 10px var(--mono);color:rgba(244,240,255,.55);justify-content:flex-end;} .net i{width:8px;height:8px;border-radius:50%;background:#666;box-shadow:0 0 6px #666;}
  .net.good i{background:var(--mint);box-shadow:0 0 8px var(--mint);} .net.ok i{background:var(--gold);box-shadow:0 0 8px var(--gold);} .net.bad i{background:var(--pink);box-shadow:0 0 8px var(--pink);} .net.off i{animation:blink 1s steps(2,end) infinite;}
  .scoreline{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);}
  .scoreline .t{font:800 26px/1 var(--mono);font-variant-numeric:tabular-nums;} .scoreline .t small{display:block;font:700 9px var(--mono);letter-spacing:.18em;margin-top:4px;opacity:.7;} .scoreline .t.b{text-align:right;}
  .scoreline .r{text-align:center;font:800 20px/1 var(--mono);color:var(--gold);} .scoreline .r small{display:block;font:700 9px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.5);margin-top:4px;}
  .phase{font:700 11px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.6);text-align:center;}
  .cue{display:grid;place-items:center;text-align:center;border-radius:16px;padding:10px;background:color-mix(in oklab,var(--c) 14%,transparent);border:1px solid color-mix(in oklab,var(--c) 40%,transparent);opacity:.35;transition:opacity .15s,transform .15s;}
  .cue span{font:800 22px/1 var(--display);color:var(--c);} .cue small{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.65);margin-top:4px;}
  .cue.on{opacity:1;animation:cue .5s ease-in-out infinite alternate;} @keyframes cue{to{transform:scale(1.03);box-shadow:0 0 0 2px var(--c),0 0 30px color-mix(in oklab,var(--c) 60%,transparent);}}
  /* the paddle face: a big disc that shows your tilt (the dot) and swings when you do */
  .face{flex:1;min-height:0;display:grid;place-items:center;position:relative;}
  .disc{width:min(72vw,52vh);aspect-ratio:1;border-radius:50%;position:relative;background:radial-gradient(circle at 35% 30%,color-mix(in oklab,var(--c) 55%,#fff),color-mix(in oklab,var(--c) 70%,#14122a) 60%,color-mix(in oklab,var(--c) 40%,#000));box-shadow:0 20px 50px rgba(0,0,0,.5),inset 0 -10px 30px rgba(0,0,0,.35),0 0 0 6px rgba(255,255,255,.06);transition:transform .12s;}
  .disc::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,transparent 0,transparent 4px,rgba(0,0,0,.18) 4px,rgba(0,0,0,.18) 5px,transparent 5px) 0 0/22px 22px;opacity:.7;}
  .disc .cross{position:absolute;inset:14%;border-radius:50%;border:1px dashed rgba(255,255,255,.35);} .disc .cross::before,.disc .cross::after{content:"";position:absolute;background:rgba(255,255,255,.25);} .disc .cross::before{left:50%;top:0;bottom:0;width:1px;} .disc .cross::after{top:50%;left:0;right:0;height:1px;}
  .disc .dot{position:absolute;left:50%;top:50%;width:22px;height:22px;margin:-11px;border-radius:50%;background:#fff;box-shadow:0 0 18px #fff,0 0 0 4px color-mix(in oklab,var(--c) 60%,transparent);transition:transform .08s;z-index:2;}
  .disc .lbl{position:absolute;font:700 9px var(--mono);letter-spacing:.16em;color:rgba(20,15,40,.7);} .disc .lbl.t{top:6%;left:50%;transform:translateX(-50%);} .disc .lbl.b{bottom:6%;left:50%;transform:translateX(-50%);} .disc .lbl.l{left:5%;top:50%;transform:translateY(-50%) rotate(-90deg);} .disc .lbl.r{right:5%;top:50%;transform:translateY(-50%) rotate(90deg);}
  .disc.swing{animation:swingA .28s cubic-bezier(.2,.9,.3,1.3);} @keyframes swingA{30%{transform:rotate(-24deg) scale(1.06);}100%{transform:none;}}
  .disc.hit{box-shadow:0 20px 50px rgba(0,0,0,.5),0 0 0 8px var(--c),0 0 60px var(--c);}
  .handle{width:26px;height:min(12vh,70px);margin:-8px auto 0;border-radius:0 0 12px 12px;background:linear-gradient(180deg,#3a3358,#1a1630);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1);}
  .motionmeter{position:absolute;left:0;right:0;bottom:0;height:4px;border-radius:2px;background:rgba(255,255,255,.08);overflow:hidden;} .motionmeter i{display:block;height:100%;width:0;background:var(--c);transition:width .05s;}
  .kindrow{display:flex;justify-content:center;gap:6px;} .kindrow span{font:700 10px var(--mono);letter-spacing:.14em;padding:5px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.12);color:rgba(244,240,255,.45);} .kindrow span.on{background:var(--c);color:#140f28;border-color:var(--c);}
  /* tap fallback: three zones, hold for a lob, a dink bar */
  .zones{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;flex:1;min-height:120px;}
  .zones button{border-radius:18px;background:color-mix(in oklab,var(--c) 18%,#14122a);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);box-shadow:inset 0 -6px 0 color-mix(in oklab,var(--c) 30%,#000),0 4px 14px rgba(0,0,0,.3);font:800 20px var(--display);color:var(--c);display:grid;place-items:center;align-content:center;gap:4px;transition:transform .05s,background .05s;}
  .zones button small{font:600 9px var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.5);} .zones button.on{background:var(--c);color:#140f28;transform:scale(.95) translateY(3px);} .zones button.on small{color:#140f28;}
  .zones button.hold{background:color-mix(in oklab,var(--c) 45%,#14122a);box-shadow:0 0 24px color-mix(in oklab,var(--c) 60%,transparent);}
  .dinkbar{height:54px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);font:800 12px var(--mono);letter-spacing:.14em;color:var(--ink);width:100%;} .dinkbar.on{background:var(--ink);color:#140f28;}
  .padfoot{display:flex;gap:10px;align-items:center;}
  .act{flex:1;padding:14px;border-radius:999px;background:var(--gold);color:#140f28;font:800 13px var(--mono);letter-spacing:.14em;box-shadow:0 6px 24px rgba(255,210,122,.3);animation:blink 2.4s ease-in-out infinite;}
  .leave,.mode{font:600 11px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.45);padding:12px 6px;white-space:nowrap;} .leave{margin-left:auto;} .act{white-space:nowrap;padding:14px 10px;font-size:12px;}
  /* ---- the Buddy Maker ---- */
  .maker{gap:10px;}
  .maker .top .rnd{margin-left:auto;font:800 12px var(--mono);letter-spacing:.12em;color:#140f28;background:var(--mint);border-radius:999px;padding:8px 12px;}
  .maker .stage{position:relative;flex:1;min-height:150px;border-radius:22px;background:radial-gradient(80% 70% at 50% 30%,#8fc7ff,#5c8ddb 45%,#f7b98c 46%,#ffd9a0 70%,#7aa45f 71%,#5f8a48);overflow:hidden;box-shadow:inset 0 -30px 60px rgba(0,0,0,.25);}
  .maker .stage canvas{position:absolute;inset:0;width:100%;height:100%;}
  .maker .stage .code{position:absolute;left:10px;bottom:8px;font:700 10px var(--mono);letter-spacing:.1em;color:rgba(20,15,40,.7);background:rgba(255,255,255,.55);padding:4px 8px;border-radius:999px;}
  .maker .stage .hint{position:absolute;right:10px;top:8px;font:600 10px var(--mono);letter-spacing:.06em;color:rgba(20,15,40,.75);background:rgba(255,255,255,.5);padding:4px 8px;border-radius:999px;max-width:55%;text-align:right;}
  .tabs{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;flex:none;} .tabs::-webkit-scrollbar{display:none;}
  .tabs button{flex:none;font:700 11px var(--mono);letter-spacing:.1em;padding:9px 12px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:rgba(244,240,255,.75);} .tabs button.on{background:var(--gold);color:#140f28;border-color:var(--gold);}
  .opts{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;flex:none;min-height:72px;align-items:center;padding:2px;} .opts::-webkit-scrollbar{display:none;}
  .opts button{flex:none;width:64px;height:64px;border-radius:16px;background:rgba(255,255,255,.07);border:2px solid rgba(255,255,255,.1);display:grid;place-items:center;overflow:hidden;position:relative;} .opts button.on{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 16px rgba(255,210,122,.35);}
  .opts button canvas{width:64px;height:64px;display:block;} .opts button .sw{width:38px;height:38px;border-radius:50%;background:var(--s);box-shadow:inset 0 -4px 0 rgba(0,0,0,.18),0 2px 6px rgba(0,0,0,.3);} .opts button small{position:absolute;left:0;right:0;bottom:3px;font:700 8px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.6);text-align:center;text-transform:uppercase;}
  .opts button.none{font:800 20px var(--display);color:rgba(244,240,255,.5);}
  .mini{width:58px;height:58px;border-radius:16px;background:linear-gradient(180deg,#8fc7ff,#f7b98c);display:block;} .mini.big{width:120px;height:120px;margin:0 auto;border-radius:28px;}
  .armart{width:min(50vw,200px);height:min(50vw,200px);margin:0 auto;border-radius:50%;background:radial-gradient(circle at 50% 30%,#8fc7ff,#f7b98c 70%);display:block;animation:tilt 1.6s ease-in-out infinite;}
  /* arming */
  .arm{justify-content:center;text-align:center;gap:14px;}
  .arm .paddleart{width:min(60vw,240px);aspect-ratio:1;margin:0 auto;border-radius:50%;background:radial-gradient(circle at 35% 30%,color-mix(in oklab,var(--c) 55%,#fff),color-mix(in oklab,var(--c) 70%,#14122a) 60%,color-mix(in oklab,var(--c) 40%,#000));box-shadow:0 20px 50px rgba(0,0,0,.5);display:grid;place-items:center;font:800 64px var(--display);color:rgba(20,15,40,.6);animation:tilt 2.4s ease-in-out infinite;}
  @keyframes tilt{0%,100%{transform:rotate(-12deg);}50%{transform:rotate(14deg);}}
  .arm h2{margin:0;font:800 26px/1.1 var(--display);} .arm p{margin:0;font:500 14px/1.45 var(--display);color:rgba(244,240,255,.75);}
  .arm .why{font:600 11px/1.5 var(--mono);color:rgba(244,240,255,.45);letter-spacing:.04em;}
  /* results */
  .res{justify-content:center;text-align:center;gap:10px;}
  .rank{font:800 clamp(72px,26vw,120px)/1 var(--display);color:var(--c);text-shadow:0 0 40px color-mix(in oklab,var(--c) 60%,transparent);}
  .resline{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.05);font:600 13px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.6);} .resline b{font:700 20px var(--mono);color:var(--ink);letter-spacing:0;}
  /* feedback: a full-screen flash for the big moments, an edge pulse instead of a buzz where there is no vibrator */
  #flash{position:fixed;inset:0;pointer-events:none;z-index:20;display:grid;place-items:center;opacity:0;background:radial-gradient(60% 50% at 50% 45%,color-mix(in oklab,var(--f,#fff) 40%,transparent),transparent 70%);}
  #flash b{font:800 clamp(34px,11vw,52px) var(--display);color:var(--f,#fff);text-shadow:0 4px 30px rgba(0,0,0,.6);letter-spacing:-.01em;transform:rotate(-4deg);}
  #flash.go{animation:flash .55s ease-out;} @keyframes flash{0%{opacity:1;}100%{opacity:0;}}
  #flash.big.go{animation:flashBig .9s ease-out;} @keyframes flashBig{0%{opacity:1;}60%{opacity:.9;}100%{opacity:0;}}
  #edge{position:fixed;inset:0;pointer-events:none;z-index:19;box-shadow:inset 0 0 0 0 var(--c);opacity:0;} #edge.go{animation:edge .35s ease-out;} @keyframes edge{0%{opacity:1;box-shadow:inset 0 0 0 14px var(--c),inset 0 0 60px var(--c);}100%{opacity:0;box-shadow:inset 0 0 0 0 var(--c);}}
  #edge.hold{opacity:1;animation:edgeHold .5s ease-in-out infinite alternate;} @keyframes edgeHold{from{box-shadow:inset 0 0 0 4px var(--c),inset 0 0 30px color-mix(in oklab,var(--c) 40%,transparent);}to{box-shadow:inset 0 0 0 10px var(--c),inset 0 0 60px color-mix(in oklab,var(--c) 60%,transparent);}}
  @media (max-height:640px){ .boxes b{width:52px;height:62px;font-size:34px;} .grid button{min-height:38px;font-size:18px;} .pads button{font-size:22px;} .drums button{height:46px;} }
  @media (orientation:landscape) and (max-height:500px){ .pad .cue{padding:6px;} .pads button{font-size:20px;} }
  @media (prefers-reduced-motion:reduce){ .cue.on,.act,#edge.hold,.boxes b.cur:empty::after,.net.off i{animation:none;} }
</style>
</head>
<body>
<div id="edge" aria-hidden="true"></div>
<div id="flash" aria-hidden="true"><b id="flashTxt"></b></div>
<main id="app">
  <section id="sCode" class="screen">
    <div class="logo"><span style="--h:20">P</span><span style="--h:48">I</span><span style="--h:76">C</span><span style="--h:104">K</span><span style="--h:132">L</span><span style="--h:160">E</span><i></i><span style="--h:200">P</span><span style="--h:228">A</span><span style="--h:256">R</span><span style="--h:284">K</span></div>
    <div class="sub">MAKE YOUR BUDDY</div>
    <p class="lead">Put <b>pointcast.xyz/brick-choir/park</b> on the TV, then type the four letters it shows.</p>
    <div class="lbl">ROOM CODE</div>
    <div class="boxes" id="codeBoxes"><b></b><b></b><b></b><b></b></div>
    <div class="grid" id="codeGrid"></div>
    <button class="big" id="codeGo" disabled>FIND THE TV ▸</button>
