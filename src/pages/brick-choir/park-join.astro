<script is:inline>
/* ================= party transport (shared by /brick-choir/tv and /brick-choir/join) =================
   A tiny relay client. Frames are small JSON objects (≤120 chars) and carry `o` (origin pid).
   1. /api/drum/room?room=bc-<code> — the pointcast-drum Durable Object; its welcome lists "bc-party" when the
      deployed Worker relays opaque party frames (workers/pointcast-drum, migration-free). Immediate fan-out.
   2. /api/room?url=/brick-choir/party/<code> — the presence Durable Object, sharded per URL; a `chat` message is
      broadcast at once to the whole room, so it works as a relay today with no Worker deploy (120-char frames).
   Reconnects with backoff, on visibility and on `online`; the pid stays the same so the TV keeps your seat. */
function makeParty({code,pid,onFrame,onStatus}){
  const P={transport:null,ws:null,status:'off',tries:0,closed:false,seen:new Set(),sent:0,recv:0};
  const room='bc-'+code.toLowerCase(); const proto=location.protocol==='https:'?'wss':'ws';
  const drumUrl=`${proto}://${location.host}/api/drum/room?room=${room}&sid=${pid}`;
  const roomUrl=`${proto}://${location.host}/api/room?url=${encodeURIComponent('/brick-choir/party/'+code.toLowerCase())}&sid=bc-${pid}`;
  const FORCE=(new URLSearchParams(location.search).get('transport')||'').toLowerCase(); // ?transport=room forces the fallback (tests)
  const setStatus=s=>{ if(P.status!==s){ P.status=s; if(onStatus) onStatus(s,P.transport); } };
  let timer=null;
  function open(which){
    if(P.closed) return; if(which==='drum'&&FORCE==='room') which='room'; setStatus('connecting'); let ws; try{ ws=new WebSocket(which==='drum'?drumUrl:roomUrl); }catch(e){ return fail(which); }
    // the guard only gives up on a socket that never opened; an open socket whose welcome is late (a TV's main thread is
    // busy compiling shaders at boot, and queued message events can land after a timer) gets a second, much longer wait:
    // falling back to the presence room while the phones stay on the drum relay would split the party (v9)
    P.ws=ws; let ok=false, guard=setTimeout(()=>{ if(ok) return; if(ws.readyState<=1&&which==='drum'){ guard=setTimeout(()=>{ if(!ok){ ws.onclose=null; try{ ws.close(); }catch(e){} open('room'); } },30000); return; } try{ ws.close(); }catch(e){} },4000);
    ws.onmessage=e=>{ let m; try{ m=JSON.parse(e.data); }catch(err){ return; } if(!m||typeof m!=='object') return;
      if(which==='drum'){
        if(m.type==='welcome'){ if((m.features||[]).includes('bc-party')){ ok=true; clearTimeout(guard); ready('drum'); } else { clearTimeout(guard); ws.onclose=null; try{ ws.close(); }catch(err){} open('room'); } return; }
        if(m.type==='party'&&m.d&&typeof m.d==='object'){ P.recv++; onFrame(m.d); } return; }
      // presence room: every broadcast carries the chat ring; what was there when we arrived is history
      if(!ok){ ok=true; clearTimeout(guard); (m.chat||[]).forEach(c=>P.seen.add(c.id)); ready('room'); return; }
      (m.chat||[]).forEach(c=>{ if(P.seen.has(c.id)) return; P.seen.add(c.id); if(P.seen.size>600) P.seen=new Set([...P.seen].slice(-300)); let d; try{ d=JSON.parse(c.msg); }catch(err){ return; } if(d&&typeof d==='object'&&d.o!==pid){ P.recv++; onFrame(d); } });
    };
    ws.onclose=()=>{ clearTimeout(guard); if(P.ws!==ws) return; P.ws=null; if(!ok) fail(which); else { setStatus('reconnecting'); retry(); } };
    ws.onerror=()=>{};
  }
  function ready(t){ P.transport=t; P.tries=0; P.seen.clear(); setStatus('on'); }
  function fail(which){ if(which==='drum'){ open('room'); return; } setStatus('offline'); retry(); }
  function retry(){ clearTimeout(timer); const wait=Math.min(6000,400*Math.pow(2,P.tries++)); timer=setTimeout(()=>open('drum'),wait); }
  P.send=d=>{ const ws=P.ws; if(!ws||ws.readyState!==1||P.status!=='on') return false; d.o=pid; try{ if(P.transport==='drum') ws.send(JSON.stringify({v:1,type:'party',d})); else ws.send(JSON.stringify({type:'chat',msg:JSON.stringify(d).slice(0,120)})); }catch(e){ return false; } P.sent++; return true; };
  P.kick=()=>{ if(P.closed) return; if(!P.ws||P.ws.readyState>1){ clearTimeout(timer); P.tries=0; open('drum'); } };
  P.close=()=>{ P.closed=true; clearTimeout(timer); try{ if(P.ws) P.ws.close(); }catch(e){} };
  document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') P.kick(); });
  addEventListener('online',()=>P.kick()); addEventListener('pageshow',()=>P.kick());
  open('drum'); return P;
}
/* ================= Buddies: the shared kit (phone + TV) =================
   A Buddy is twelve small numbers. The code is 'p' + twelve base-36 digits + a check digit (14 chars), so it fits in a
   party frame next to a name and a seat. Order: skin, hair style, hair colour, eyes, brows, glasses, facial hair, hat,
   shirt, paddle, body, smile. The design language is ours: capsule bodies, an oversized round head, dot eyes, arc brows,
   a single-stroke smile, a paddle always in hand, pastel sportswear in the Brick Choir palette. */
const BK=(()=>{
  const SKIN=['#fbe8d8','#f6d9bf','#f0c8a4','#e7b58b','#dca076','#cf8b62','#bd7650','#a56342','#8b5136','#70412c','#563223','#3d241a'];
  const HAIRC=['#1c1a22','#3b2a20','#6b4a30','#8a3f2a','#d2692c','#e9c574','#f3e6c4','#9a9aa5','#f2f0f5','#ff8fb1','#8fd0ff','#9fe3c9'];
  const SHIRT=['#ff8fb1','#ffd27a','#9fe3c9','#8fd0ff','#e9ff7a','#b9a8ff','#ffb38a','#e3a8ff','#f4f0ff','#2a2547'];
  const PADDLE=['#e9ff7a','#ff8fb1','#ffd27a','#9fe3c9','#8fd0ff','#b9a8ff','#ffb38a','#e3a8ff','#f4f0ff','#2a2547'];
  const HAIR=['none','crop','bob','ponytail','curls','spikes','bun','long','big','swoop'];
  const EYES=['dots','wide','happy','sleepy','wink','sparkle'];
  const BROWS=['soft','raised','angled','thick'];
  const GLASSES=['none','round','square','shades','aviator'];
  const FACIAL=['none','moustache','goatee','beard','stubble'];
  const HAT=['none','cap','visor','bucket','headband','beanie'];
  const BODY=['slim','round','tall'];
  const SMILE=['smile','grin','calm','oh'];
  const FIELDS=[['sk',SKIN.length],['hs',HAIR.length],['hc',HAIRC.length],['ey',EYES.length],['br',BROWS.length],['gl',GLASSES.length],['fh',FACIAL.length],['ht',HAT.length],['sh',SHIRT.length],['pd',PADDLE.length],['bd',BODY.length],['sm',SMILE.length]];
  const B36='0123456789abcdefghijklmnopqrstuvwxyz';
  const clampF=(k,v)=>{ const f=FIELDS.find(x=>x[0]===k); v=Number(v)|0; return ((v%f[1])+f[1])%f[1]; };
  function pack(b){ let s='p', sum=0; FIELDS.forEach(([k],i)=>{ const v=clampF(k,b[k]); sum+=v*(i+1); s+=B36[v]; }); return s+B36[sum%36]; }
  function unpack(code){ if(typeof code!=='string'||code.length!==14||code[0]!=='p') return null; const b={}; let sum=0; for(let i=0;i<12;i++){ const v=B36.indexOf(code[i+1]); if(v<0) return null; const [k,n]=FIELDS[i]; if(v>=n) return null; b[k]=v; sum+=v*(i+1); } if(B36[sum%36]!==code[13]) return null; return b; }
  const R=n=>Math.floor(Math.random()*n);
  function random(seed){ // seed: an optional palette index for the shirt (the hub colour)
    const b={}; FIELDS.forEach(([k,n])=>b[k]=R(n));
    b.gl=Math.random()<0.6?0:1+R(4); b.fh=Math.random()<0.7?0:1+R(4); b.ht=Math.random()<0.65?0:1+R(5); b.hs=Math.random()<0.08?0:1+R(9); b.sm=Math.random()<0.7?R(2):2+R(2); b.ey=Math.random()<0.5?R(2):2+R(4);
    if(seed!==undefined&&seed>=0) b.sh=seed%SHIRT.length; if(b.pd===b.sh&&b.sh<8) b.pd=(b.pd+3)%PADDLE.length; return b; }
  const DEFAULT={sk:3,hs:1,hc:1,ey:0,br:0,gl:0,fh:0,ht:0,sh:2,pd:0,bd:0,sm:0};
  const pretty=code=>code?code.slice(0,5).toUpperCase()+'-'+code.slice(5,9).toUpperCase()+'-'+code.slice(9).toUpperCase():'';
  const shade=(hex,k)=>{ const n=parseInt(hex.slice(1),16); const r=n>>16,g=(n>>8)&255,b=n&255; const f=v=>Math.max(0,Math.min(255,Math.round(k>=0?v+(255-v)*k:v*(1+k)))); return '#'+[f(r),f(g),f(b)].map(v=>v.toString(16).padStart(2,'0')).join(''); };
  const dark=hex=>{ const n=parseInt(hex.slice(1),16); return ((n>>16)*0.3+((n>>8)&255)*0.59+(n&255)*0.11)<140; };

  /* ---- 2D: the front view, for the phone's maker, roster chips and the share card. One unit = the head radius. ---- */
  function draw(x,b,{cx,cy,u,t=0,wave=0,swing=0,bounce=1,paddle=true,glow=null}={}){
    b=Object.assign({},DEFAULT,b||{}); const skin=SKIN[b.sk], hair=HAIRC[b.hc], shirt=SHIRT[b.sh], pad=PADDLE[b.pd], ink='#1c1a22';
    const tall=b.bd===2, round=b.bd===1; const bob=Math.sin(t*4.2)*0.06*bounce; const hy=(tall?4.0:3.7)+bob; const bw=round?0.82:tall?0.6:0.62; const by0=0.9, by1=(tall?2.9:2.6)+bob*0.5;
    x.save(); x.translate(cx,cy); x.scale(u,-u); x.lineCap='round'; x.lineJoin='round';
    const circle=(px,py,r,c)=>{ x.fillStyle=c; x.beginPath(); x.arc(px,py,r,0,6.2832); x.fill(); };
    const cap=(x0,y0,x1,y1,w,c)=>{ x.strokeStyle=c; x.lineWidth=w; x.beginPath(); x.moveTo(x0,y0); x.lineTo(x1,y1); x.stroke(); };
    if(glow){ x.fillStyle=glow; x.globalAlpha=0.35; x.beginPath(); x.ellipse(0,0.1,1.9,0.5,0,0,6.2832); x.fill(); x.globalAlpha=1; }
    // shadow
    x.fillStyle='rgba(0,0,0,.18)'; x.beginPath(); x.ellipse(0,0.05,1.5-bob*2,0.32,0,0,6.2832); x.fill();
    // hair behind the head
    const HB={2:()=>{ x.fillStyle=hair; x.beginPath(); x.roundRect(-1.12,hy-1.1,2.24,2.2,[1.1,1.1,0.5,0.5]); x.fill(); },7:()=>{ x.fillStyle=hair; x.beginPath(); x.roundRect(-1.15,hy-2.1,2.3,3.2,[1.15,1.15,0.6,0.6]); x.fill(); },3:()=>{ cap(0.55,hy+0.3,1.05,hy-1.5,0.55,hair); },8:()=>circle(0,hy+0.15,1.42,hair),4:()=>{ [[-1.05,0.25],[1.05,0.25],[-0.85,-0.55],[0.85,-0.55],[-0.5,0.95],[0.5,0.95],[0,1.15]].forEach(([a,c])=>circle(a,hy+c,0.42,hair)); }};
    if(HB[b.hs]) HB[b.hs]();
    // legs + shoes
    cap(-0.36,by0+0.1,-0.36,0.35,0.5,shade(shirt,-0.55)); cap(0.36,by0+0.1,0.36,0.35,0.5,shade(shirt,-0.55));
    x.fillStyle='#f4f0ff'; x.beginPath(); x.ellipse(-0.4,0.22,0.42,0.24,0,0,6.2832); x.fill(); x.beginPath(); x.ellipse(0.4,0.22,0.42,0.24,0,0,6.2832); x.fill();
    // body
    cap(0,by0+bw,0,by1-bw*0.2,bw*2,shirt); x.fillStyle='rgba(255,255,255,.18)'; x.beginPath(); x.ellipse(-bw*0.45,(by0+by1)/2+0.2,bw*0.22,0.55,0,0,6.2832); x.fill();
    // arms: left waves, right holds the paddle and swings
    const sh=by1-0.35, shx=bw+0.1; const wag=Math.sin(t*9)*0.3*wave; const lx=wave>0?-shx-0.75-wag*0.5:-shx-0.45, ly=wave>0?sh+1.0-Math.abs(wag)*0.3:sh-0.95;
    cap(-shx,sh,lx,ly,0.42,skin); circle(lx,ly,0.27,skin);
    const sa=-0.35+swing*1.6; const rx=shx+0.7*Math.cos(sa)+0.3, ry=sh-0.9*Math.sin(Math.PI/2-sa)*0.9-0.1; cap(shx,sh,rx,ry,0.42,skin);
    if(paddle){ x.save(); x.translate(rx,ry); x.rotate(-0.35+swing*1.2); cap(0,-0.3,0,0.6,0.22,'#2a2547'); circle(0,1.15,0.62,pad); x.fillStyle='rgba(255,255,255,.35)'; x.beginPath(); x.arc(-0.18,1.32,0.2,0,6.2832); x.fill(); x.restore(); }
    circle(rx,ry,0.27,skin);
    // head
    circle(0,hy,1,skin); x.fillStyle='rgba(255,255,255,.14)'; x.beginPath(); x.arc(-0.35,hy+0.35,0.42,0,6.2832); x.fill();
    if(b.fh===4){ x.fillStyle='rgba(30,20,20,.18)'; x.beginPath(); x.arc(0,hy,0.98,Math.PI*1.05,Math.PI*1.95); x.fill(); }
    // facial hair
    if(b.fh===3){ x.fillStyle=hair; x.beginPath(); x.arc(0,hy-0.05,0.98,Math.PI*1.02,Math.PI*1.98); x.quadraticCurveTo(0,hy-1.5,-0.97,hy-0.05); x.fill(); }
    if(b.fh===2){ x.fillStyle=hair; x.beginPath(); x.roundRect(-0.22,hy-0.95,0.44,0.36,0.14); x.fill(); }
    // smile
    x.strokeStyle=ink; x.lineWidth=0.11; x.beginPath(); const sy=hy-0.42;
    if(b.sm===0) x.arc(0,sy+0.05,0.36,Math.PI*1.15,Math.PI*1.85); else if(b.sm===1){ x.arc(0,sy+0.1,0.46,Math.PI*1.1,Math.PI*1.9); x.stroke(); x.fillStyle='#fff'; x.beginPath(); x.moveTo(-0.34,sy-0.16); x.lineTo(0.34,sy-0.16); x.lineTo(0,sy-0.36); x.fill(); x.beginPath(); } else if(b.sm===2){ x.moveTo(-0.28,sy-0.15); x.lineTo(0.28,sy-0.15); } else { x.arc(0,sy-0.12,0.16,0,6.2832); }
    x.stroke();
    if(b.fh===1){ x.strokeStyle=hair; x.lineWidth=0.2; x.beginPath(); x.moveTo(-0.5,sy+0.12); x.quadraticCurveTo(-0.25,sy+0.35,0,sy+0.18); x.quadraticCurveTo(0.25,sy+0.35,0.5,sy+0.12); x.stroke(); }
    // eyes
    const ey=hy+0.15, ex=0.38; const eye=(px,wink)=>{ x.fillStyle=ink; if(b.ey===2||wink){ x.strokeStyle=ink; x.lineWidth=0.12; x.beginPath(); x.arc(px,ey-0.08,0.2,Math.PI*0.15,Math.PI*0.85); x.stroke(); return; }
      const r=b.ey===1||b.ey===5?0.2:0.14; x.beginPath(); if(b.ey===3) x.ellipse(px,ey,r+0.03,r*0.5,0,0,6.2832); else x.arc(px,ey,r,0,6.2832); x.fill(); if(b.ey===5||b.ey===1){ x.fillStyle='#fff'; x.beginPath(); x.arc(px-0.06,ey+0.07,0.06,0,6.2832); x.fill(); } };
