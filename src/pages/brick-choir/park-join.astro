      [-ex,ex].forEach(px=>{ x.beginPath(); if(b.gl===2) x.roundRect(px-0.34,ey-0.28,0.68,0.56,0.1); else if(b.gl===4){ x.moveTo(px-0.36,ey+0.28); x.lineTo(px+0.36,ey+0.28); x.lineTo(px+0.3,ey-0.2); x.quadraticCurveTo(px,ey-0.42,px-0.3,ey-0.2); x.closePath(); } else x.arc(px,ey,0.34,0,6.2832); x.fill(); x.stroke(); });
      x.beginPath(); x.moveTo(-ex+0.34,ey+0.05); x.lineTo(ex-0.34,ey+0.05); x.stroke(); }
