function phaseUI(){ const a=ACT[phase]; const btn=$('padAct'); btn.hidden=!a||(spectator&&phase!=='replay'); if(a){ btn.textContent=a[0]; btn.dataset.c=a[1]; }
  const me=seat>=0?SEATS[seat].team:-1; const srv=st.sv===seat&&seat>=0; const txt={attract:'PARTY MODE · the house is rallying',lobby:'LOBBY · Buddies walking on',ready:'GET READY',serve:srv?'YOUR SERVE — SWING!':'THEY SERVE',play:st.md===1?'SINGLES':'DOUBLES',point:'POINT',replay:'REPLAY',game:'GAME!',over:'MATCH OVER',initials:'SIGNING THE BOARD',scores:'THE LEADERS',paused:'PAUSED',share:'SHARING'}[phase]||phase.toUpperCase();
  $('padPhase').textContent=txt; $('slA').firstChild.textContent=st.s[0]; $('slB').firstChild.textContent=st.s[1]; $('slR').firstChild.textContent=st.r; $('slAn').textContent=`NEAR${me===0?' · YOU':''}`; $('slBn').textContent=`FAR${me===1?' · YOU':''}`;
  const cue=$('cue'); const on=turn||srv; cue.classList.toggle('on',on); cue.querySelector('span').textContent=spectator?'cheer!':srv?'SERVE!':turn?'YOUR BALL':(phase==='play'?'watch the ball':'swing to warm up'); cue.querySelector('small').textContent=spectator?'swing the phone and your Buddy jumps in the bleachers':srv?'swing your phone':turn?'swing when the ring closes on the TV':(phase==='play'?'the ring shows whose ball it is':'the TV plays a note for every hit');
  $('edge').classList.toggle('hold',on&&!navigator.vibrate); }
$('padAct').onclick=()=>{ const c=$('padAct').dataset.c; if(net) net.send({f:'cmd',p:pid,c}); buzz(15); };
$('padLeave').onclick=()=>{ if(net) net.send({f:'l',p:pid}); seat=-1; spectator=false; joinedOnce=false; show('sMaker'); $('mkGo').textContent='WALK ON ▸'; };
let resTxt=''; $('resShare').onclick=async()=>{ try{ await navigator.share({title:'Pickle Park · Brick Choir',text:resTxt,url:'https://pointcast.xyz/brick-choir/park'}); }catch(e){} };
$('resAgain').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'again'}); show('sPad'); };
$('resParty').onclick=()=>{ if(HUB){ if(net) net.send({f:'cmd',p:pid,c:'home'}); buzz(20); setTimeout(()=>hubFollow('home'),2500); return; } if(net) net.send({f:'cmd',p:pid,c:'party'}); show('sPad'); };
if(HUB) $('resParty').textContent='BACK TO HOME';
function discHit(){ const d=$('disc'); d.classList.add('hit'); setTimeout(()=>d.classList.remove('hit'),160); }
const EV={ur:()=>{ turn=true; phaseUI(); buzz([30,30,30]); flash('YOURS!',seatCol()); },sv:()=>{ buzz([40,30,40]); flash('SERVE!',seatCol(),true); },h:()=>{ turn=false; phaseUI(); buzz(35); discHit(); },sw:()=>{ turn=false; phaseUI(); buzz([30,20,70]); discHit(); flash('SWEET!','#fff3c4'); },dk:()=>{ flash('dink',seatCol()); },m:()=>{ buzz(80); flash('whiff','rgba(244,240,255,.7)'); },no:()=>{ buzz(15); },w:()=>{ turn=false; phaseUI(); buzz([60,40,60,40,120]); flash('POINT!',seatCol(),true); },l:()=>{ turn=false; phaseUI(); buzz(50); flash('their point','rgba(244,240,255,.6)'); },kf:()=>{ buzz([90,40,90]); flash('KITCHEN!','#ff8fb1',true); }};

/* ---- frames from the TV ---- */
function onFrame(d){ if(d.p&&d.p!==pid&&d.f!=='ev') return;
  switch(d.f){
    case 'ro': roster=d; rosterAt=Date.now(); break;
    case 'ok': { const was=seat; seat=d.s; spectator=false; sess.set('seat',String(seat)); if(was!==seat){ theme(); drawFaces(); if(armed||tapMode){ padUI(); show('sPad'); } else if(!$('sMaker').hidden&&!window.__mkDone){ $('mkGo').textContent='DONE ▸'; $('mkHint').textContent='you’re on the court · edit, then DONE'; } else show('sArm'); flash(`${name} · ${TEAMS[SEATS[seat].team].name}`,seatCol(),true); buzz([40,30,80]); } if(armed) net.send({f:'arm',p:pid,m:1}); break; }
    case 'full': spectator=true; if(!$('sMaker').hidden){ $('mkHint').textContent='the court is full — you’re in the bleachers'; show('sArm'); $('armTitle').textContent='THE COURT IS FULL · YOU CHEER'; } buzz([30,30,30]); break;
    case 'who': if(joinedOnce||HUB) join(); break;
    case 'st': { const ph=String(d.ph||''); st={s:d.s||[0,0],r:d.r|0,sv:d.sv,tn:d.tn,md:d.md||2}; const wasTurn=turn; turn=ph==='play'&&d.tn===seat; if(ph!==phase||wasTurn!==turn){ phase=ph; if(!$('sRes').hidden&&!/^(over|initials|scores|share)$/.test(ph)) show('sPad'); } phase=ph; if(seat>=0||spectator) phaseUI(); break; }
    case 'ev': (d.l||[]).forEach(([s,e])=>{ if(s===seat&&EV[e]) EV[e](); }); break;
    case 'res': { if(seat<0) break; const tm=SEATS[seat].team; const won=d.w===tm; $('resTitle').textContent='MATCH OVER'; $('resRank').textContent=won?'WIN':'LOSS'; $('resRank').style.color=won?seatCol():'rgba(244,240,255,.5)'; $('resGames').textContent=`${(d.s||[0,0])[0]} – ${(d.s||[0,0])[1]}`; $('resRally').textContent=d.lr|0; $('resScore').textContent=((d.sc||[])[seat]|0).toLocaleString(); resTxt=`Pickle Park: my Buddy ${name} ${won?'won':'lost'} ${(d.s||[0,0]).join('–')}, longest rally ${d.lr|0}, ${((d.sc||[])[seat]|0).toLocaleString()} points. Buddy code ${BK.pretty(BK.pack(buddy))}.`; $('resShare').hidden=!navigator.share; drawFaces(); show('sRes'); buzz(won?[80,40,80,40,160]:60); break; }
    case 'pq': if(typeof d.t==='number'){ rtt=Date.now()-d.t; netUI(); } break;
    case 'home': if(HUB){ flash('HOME',seatCol(),true); setTimeout(()=>hubFollow('home'),400); } break;
    case 'go': if(HUB&&d.g&&d.g!=='park') hubFollow(d.g); break;
  }
}
function netUI(){ const el=$('padNet'); const s=net?net.status:'off'; el.className='net '+(s!=='on'?'off':rtt===null?'':rtt<90?'good':rtt<180?'ok':'bad'); $('padPing').textContent=s!=='on'?(s==='connecting'?'…':s):(rtt===null?'live':rtt+' ms'); }
function connect(){ if(net) return; net=makeParty({code,pid,onFrame,onStatus:s=>{ netUI(); if(s==='on'){ net.send({f:'hi',p:pid}); if(joinedOnce||HUB) join(); } }});
  setInterval(()=>{ if(!net||net.status!=='on') return; net.send({f:'pp',p:pid,t:Date.now(),r:rtt===null?undefined:rtt}); if(seat<0&&!spectator&&(joinedOnce||HUB)) join(); if(seat<0&&!spectator&&(Date.now()-rosterAt>5000)){ net.send({f:'hi',p:pid}); if(rosterAt===0&&!$('sMaker').hidden) $('mkHint').textContent=`no TV is showing room ${code} yet`; } },3000); }
async function wakeLock(){ try{ if('wakeLock' in navigator&&!wake){ wake=await navigator.wakeLock.request('screen'); wake.addEventListener('release',()=>{ wake=null; }); } }catch(e){} }
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible'){ if(seat>=0) wakeLock(); if(net){ net.kick(); if(net.status==='on') net.send({f:'hi',p:pid}); } } });

/* ---- boot: a scanned QR lands with the code filled in; the hub lands with the name too ---- */
codeUI(); nameUI(); theme(); drawFaces();
if(code.length===4){ $('nameRoom').textContent='ROOM '+code; if(name){ $('nameGo').onclick(); } else show('sName'); } else show('sCode');
if(HUB){ $('mkGo').textContent=hadBuddy?'PLAY AS THIS BUDDY ▸':'WALK ON ▸'; }
if(TESTMODE) window.__pj={get seat(){return seat;},get phase(){return phase;},get turn(){return turn;},get st(){return st;},get roster(){return roster;},get net(){return net;},get rtt(){return rtt;},get armed(){return armed;},get tapMode(){return tapMode;},get M(){return M;},get buddy(){return buddy;},get code(){return BK.pack(buddy);},get spectator(){return spectator;},get screen(){return [...document.querySelectorAll('.screen')].find(s=>!s.hidden).id;},get flash(){return $('flashTxt').textContent;},pid,swings:[],
  setName:n=>{ name=n; nameUI(); },go:()=>$('nameGo').onclick(),join,arm,useTap,swing:(a,l,k,w,h)=>sendSwing(a,l,k||'n',w,h),random:()=>$('mkRandom').onclick(),set:(k,v)=>{ buddy[k]=BK.clampF(k,v); mkOpts(); mkCodeUI(); },pick:(k,v)=>{ tab=k; mkTabs(); mkOpts(); const b=$('mkOpts').children[v]; if(b) b.onclick(); },done:()=>$('mkGo').onclick(),
  motion:(lin,rot,g)=>{ const ag=g||[0,9.81,0]; const e={accelerationIncludingGravity:{x:ag[0]+lin[0],y:ag[1]+lin[1],z:ag[2]+lin[2]},acceleration:{x:lin[0],y:lin[1],z:lin[2]},rotationRate:{alpha:rot[0],beta:rot[1],gamma:rot[2]}}; onMotion(e); },
  press:(k)=>{ const b=document.querySelector(`[data-a="${k}"]`); if(b){ b.onpointerdown({preventDefault(){}}); b.onpointerup(); } },dink:()=>$('dinkbar').onpointerdown({preventDefault(){}})};
</script>
</body>
</html>
