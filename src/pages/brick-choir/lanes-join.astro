<script is:inline>
/* ================= party transport (shared by /brick-choir/tv and /brick-choir/join) =================
   A tiny relay client. Frames are small JSON objects (≤120 chars) and carry `o` (origin pid).
   1. /api/drum/room?room=bc-<code> — the pointcast-drum Durable Object; its welcome lists "bc-party" when the
      deployed Worker relays opaque party frames (workers/pointcast-drum, migration-free). Immediate fan-out.
   2. /api/room?url=/brick-choir/party/<code> — the presence Durable Object, sharded per URL; a `chat` message is
      broadcast at once to the whole room, so it works as a relay today with no Worker deploy (120-char frames).
   Reconnects with backoff, on visibility and on `online`; the pid stays the same so the TV keeps your seat. */
function makeParty({code,pid,onFrame,onStatus}){
  const P={transport:null,ws:null,status:'off',tries:0,closed:false,seen:new Set(),sent:0,recv:0};
  const room='bc-'+code.toLowerCase(); const proto=location.protocol==='https:'?'wss':'ws';
  const drumUrl=`${proto}://${location.host}/api/drum/room?room=${room}&sid=${pid}`;
  const roomUrl=`${proto}://${location.host}/api/room?url=${encodeURIComponent('/brick-choir/party/'+code.toLowerCase())}&sid=bc-${pid}`;
  const FORCE=(new URLSearchParams(location.search).get('transport')||'').toLowerCase(); // ?transport=room forces the fallback (tests)
  const setStatus=s=>{ if(P.status!==s){ P.status=s; if(onStatus) onStatus(s,P.transport); } };
  let timer=null;
  function open(which){
    if(P.closed) return; if(which==='drum'&&FORCE==='room') which='room'; setStatus('connecting'); let ws; try{ ws=new WebSocket(which==='drum'?drumUrl:roomUrl); }catch(e){ return fail(which); }
    // the guard only gives up on a socket that never opened; an open socket whose welcome is late (a TV's main thread is
    // busy compiling shaders at boot, and queued message events can land after a timer) gets a second, longer wait
    P.ws=ws; let ok=false, guard=setTimeout(()=>{ if(ok) return; if(ws.readyState<=1&&which==='drum'){ guard=setTimeout(()=>{ if(!ok){ ws.onclose=null; try{ ws.close(); }catch(e){} open('room'); } },30000); return; } try{ ws.close(); }catch(e){} },4000);
    ws.onmessage=e=>{ let m; try{ m=JSON.parse(e.data); }catch(err){ return; } if(!m||typeof m!=='object') return;
      if(which==='drum'){
        if(m.type==='welcome'){ if((m.features||[]).includes('bc-party')){ ok=true; clearTimeout(guard); ready('drum'); } else { clearTimeout(guard); ws.onclose=null; try{ ws.close(); }catch(err){} open('room'); } return; }
        if(m.type==='party'&&m.d&&typeof m.d==='object'){ P.recv++; onFrame(m.d); } return; }
      // presence room: every broadcast carries the chat ring; what was there when we arrived is history
      if(!ok){ ok=true; clearTimeout(guard); (m.chat||[]).forEach(c=>P.seen.add(c.id)); ready('room'); return; }
      (m.chat||[]).forEach(c=>{ if(P.seen.has(c.id)) return; P.seen.add(c.id); if(P.seen.size>600) P.seen=new Set([...P.seen].slice(-300)); let d; try{ d=JSON.parse(c.msg); }catch(err){ return; } if(d&&typeof d==='object'&&d.o!==pid){ P.recv++; onFrame(d); } });
    };
    ws.onclose=()=>{ clearTimeout(guard); if(P.ws!==ws) return; P.ws=null; if(!ok) fail(which); else { setStatus('reconnecting'); retry(); } };
    ws.onerror=()=>{};
  }
  function ready(t){ P.transport=t; P.tries=0; P.seen.clear(); setStatus('on'); }
  function fail(which){ if(which==='drum'){ open('room'); return; } setStatus('offline'); retry(); }
  function retry(){ clearTimeout(timer); const wait=Math.min(6000,400*Math.pow(2,P.tries++)); timer=setTimeout(()=>open('drum'),wait); }
  P.send=d=>{ const ws=P.ws; if(!ws||ws.readyState!==1||P.status!=='on') return false; d.o=pid; try{ if(P.transport==='drum') ws.send(JSON.stringify({v:1,type:'party',d})); else ws.send(JSON.stringify({type:'chat',msg:JSON.stringify(d).slice(0,120)})); }catch(e){ return false; } P.sent++; return true; };
  P.kick=()=>{ if(P.closed) return; if(!P.ws||P.ws.readyState>1){ clearTimeout(timer); P.tries=0; open('drum'); } };
  P.close=()=>{ P.closed=true; clearTimeout(timer); try{ if(P.ws) P.ws.close(); }catch(e){} };
  document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') P.kick(); });
  addEventListener('online',()=>P.kick()); addEventListener('pageshow',()=>P.kick());
  open('drum'); return P;
}
/* ================= the phone ball ================= */
const PAL=['#ff8fb1','#ffd27a','#9fe3c9','#8fd0ff','#e9ff7a','#b9a8ff','#ffb38a','#e3a8ff'];
const ALPHA='ABCDEFGHJKMNPQRSTUVWXYZ', NAMECH='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
const $=id=>document.getElementById(id); const TESTMODE=/[?&]bot\b/.test(location.search); const Q=new URLSearchParams(location.search);
const HUB=Q.get('hub')==='1', HUB_C=/^[0-7]$/.test(Q.get('c')||'')?+Q.get('c'):-1, HUB_PASS=['bot','transport'].filter(k=>Q.has(k)).map(k=>'&'+k+(Q.get(k)?'='+encodeURIComponent(Q.get(k)):'')).join('');
const HUB_JOIN={home:'/brick-choir/home-join',quartet:'/brick-choir/join',rally:'/brick-choir/rally-join',lanes:'/brick-choir/lanes-join'};
function hubFollow(g){ if(!HUB||window.__went) return; const path=HUB_JOIN[g]||HUB_JOIN.home; window.__went=true; location.href=path+'?room='+code+(path===HUB_JOIN.home?'':'&hub=1&name='+encodeURIComponent(name)+'&c='+(HUB_C>=0?HUB_C:''))+HUB_PASS; }
const FLIP_AIM=Q.get('flip')==='1'||Q.get('flip')==='aim'?-1:1, FLIP_SPIN=Q.get('flip')==='1'||Q.get('flip')==='spin'?-1:1; // real-phone tuning: ?flip=aim|spin|1
const store={get(k,d){try{const v=localStorage.getItem('bcl:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{localStorage.setItem('bcl:'+k,v);}catch(e){}}};
const sess={get(k,d){try{const v=sessionStorage.getItem('bcl:'+k);return v===null?d:v;}catch(e){return d;}},set(k,v){try{sessionStorage.setItem('bcl:'+k,v);}catch(e){}}};
const pid=sess.get('pid','')||(()=>{ const a=new Uint8Array(4); crypto.getRandomValues(a); const v=Array.from(a,b=>'abcdefghijklmnopqrstuvwxyz0123456789'[b%36]).join(''); sess.set('pid',v); return v; })();
let code=(Q.get('room')||sess.get('room','')).toUpperCase().replace(/[^A-Z]/g,'').slice(0,4), name=((HUB&&Q.get('name'))||store.get('name','')).toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3), wanted=HUB||sess.get('joined','0')==='1';
let seat=-1, col='#ffd27a', net=null, roster=null, rosterAt=0, phase='', turn=false, rtt=null, st={fr:0,rl:0,tn:-1,n:0,t:[],nf:10}, wake=null, armed=false, tapMode=false;
const show=id=>{ document.querySelectorAll('.screen').forEach(s=>s.hidden=s.id!==id); };
const buzz=p=>{ let did=false; try{ if(navigator.vibrate) did=navigator.vibrate(p); }catch(e){} if(!did) edge(); };
function edge(){ const e=$('edge'); e.classList.remove('go'); void e.offsetWidth; e.classList.add('go'); }
function flash(txt,c,big){ const f=$('flash'); f.style.setProperty('--f',c||'#fff'); $('flashTxt').textContent=txt; f.classList.remove('go','big'); void f.offsetWidth; if(big) f.classList.add('big'); f.classList.add('go'); }
function theme(){ document.documentElement.style.setProperty('--c',col); }
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* ---- code + name entry ---- */
function drawBoxes(el,val,n){ const cur=Math.min(val.length,n-1); [...el.children].forEach((b,i)=>{ b.textContent=val[i]||''; b.classList.toggle('cur',i===cur); }); }
function grid(el,chars,on){ el.innerHTML=''; chars.split('').forEach(ch=>{ const b=document.createElement('button'); b.textContent=ch; b.type='button'; b.onpointerdown=e=>{ e.preventDefault(); on(ch); b.classList.add('on'); setTimeout(()=>b.classList.remove('on'),120); }; el.appendChild(b); }); const bk=document.createElement('button'); bk.textContent='⌫'; bk.className='bk'; bk.type='button'; bk.onpointerdown=e=>{ e.preventDefault(); on(null); }; el.appendChild(bk); }
function codeUI(){ drawBoxes($('codeBoxes'),code,4); $('codeGo').disabled=code.length!==4; }
grid($('codeGrid'),ALPHA,ch=>{ code=ch===null?code.slice(0,-1):(code+ch).slice(0,4); codeUI(); buzz(8); });
$('codeGo').onclick=()=>{ if(code.length!==4) return; sess.set('room',code); $('nameRoom').textContent='ROOM '+code; nameUI(); show('sName'); };
function nameUI(){ drawBoxes($('nameBoxes'),name,3); $('nameGo').disabled=name.length<1; }
grid($('nameGrid'),NAMECH,ch=>{ name=ch===null?name.slice(0,-1):(name+ch).slice(0,3); nameUI(); buzz(8); });
$('nameBack').onclick=e=>{ e.preventDefault(); show('sCode'); };
$('nameGo').onclick=()=>{ if(!name) return; store.set('name',name); $('laneRoom').textContent='ROOM '+code; $('laneName').textContent=name; show('sLane'); connect(); laneUI(); };

/* ---- the roster: who's bowling tonight ---- */
function laneUI(){ const g=$('roster'); const have=!!roster; $('laneSub').textContent=!net||net.status!=='on'?'connecting…':(have?`the TV sees you · ${roster.s.length} of 8 lanes taken`:'looking for the TV…');
  const rows=have?roster.s.map((n,i)=>`<div style="--c:${PAL[i%8]}"><b>${n}</b><small>${roster.k[i]===1?'PHONE':roster.k[i]===2?'KEYS':'BOT'}</small></div>`):[]; if(!have||roster.s.length<8) rows.push(`<div class="open"><b>${have?roster.s.length+1:1}UP</b><small>OPEN</small></div>`); g.innerHTML=rows.join('');
  $('laneGo').disabled=have&&roster.s.length>=8&&!roster.k.some(k=>k===0); }
function join(){ wanted=true; sess.set('joined','1'); buzz(12); if(net&&net.status==='on'){ net.send({f:'j',p:pid,n:name,c:HUB_C>=0?HUB_C:undefined}); $('laneSub').textContent='asking the TV…'; } else $('laneSub').textContent='still connecting…'; }
$('laneGo').onclick=join;

/* ---- motion: the release detector ----
   Samples arrive at ~60 Hz. Gravity is a low-pass of accelerationIncludingGravity; the linear part is `acceleration`
   when the browser gives it, else the raw minus gravity. The swing: |linear| climbs past A_ON → we are in the forward
   swing; we ride the peak; the moment |linear| has fallen to 62% of that peak (or SWING_MAX ms have passed) is the
   release. Speed comes from the peak, aim from the lean read TILT_LAG before the swing began, the hook from the wrist's
   twist (rotationRate about the long axis) integrated over the swing. A bigger peak inside BETTER_MS after a release
   re-sends the swing: the TV takes the better one while the ball is still at the foul line. */
const A_ON=9, A_MAX=30, RELEASE_FRAC=0.62, SWING_MAX=700, REFRACT=650, TILT_LAG=180, BETTER_MS=280, TWIST_DEAD=12, TWIST_FULL=120;
const M={ok:false,g:[0,0,0],ref:null,sgn:1,tilt:[],phase:'idle',peak:0,peakT:0,onsetT:0,twist:0,lastRelease:0,lastPeak:0,n:0,lastAt:0,hz:0,src:'',aim:0,spin:0,pow:0};
function onMotion(e){
  const ag=e.accelerationIncludingGravity; if(!ag||ag.x===null) return; const t=performance.now(); const dt=M.lastAt?Math.min(0.05,(t-M.lastAt)/1000):0.016; M.n++; if(M.lastAt) M.hz=M.hz*0.9+0.1*(1000/Math.max(1,t-M.lastAt)); M.lastAt=t; M.ok=true;
  let lx,ly,lz; if(e.acceleration&&e.acceleration.x!==null){ lx=e.acceleration.x; ly=e.acceleration.y; lz=e.acceleration.z; M.src='lin'; } else { lx=ag.x-M.g[0]; ly=ag.y-M.g[1]; lz=ag.z-M.g[2]; M.src='raw'; }
  // gravity: a low-pass that holds still while the phone is being swung (otherwise the swing itself leans the estimate)
  const still=Math.hypot(lx,ly,lz)<3; const k=still?0.14:0.01; M.g[0]+=(ag.x-M.g[0])*k; M.g[1]+=(ag.y-M.g[1])*k; M.g[2]+=(ag.z-M.g[2])*k;
  const a=Math.hypot(lx,ly,lz); const rr=e.rotationRate; const twistRate=rr&&rr.gamma!==null?rr.gamma:0; // gamma: about the phone's long axis
  const gl=Math.hypot(M.g[0],M.g[1],M.g[2])||1; const gx=M.g[0]/gl, gy=M.g[1]/gl, gz=M.g[2]/gl; if(!M.ref) M.ref=[gx,gy,gz];
  const aim=clamp(-(gx-M.ref[0])*M.sgn*2.4*FLIP_AIM,-1,1); // lean right → the right edge drops → the spec's x goes negative
  M.tilt.push([t,aim]); while(M.tilt.length>40) M.tilt.shift(); M.aim=aim;
  meter(Math.max(a/A_MAX,M.phase==='swing'?M.peak/A_MAX:0));
  if(M.phase==='idle'){ if(a>=A_ON&&t-M.lastRelease>REFRACT){ M.phase='swing'; M.onsetT=t; M.peak=a; M.peakT=t; M.twist=0; } else if(t-M.lastRelease>REFRACT) previewAim(aim); return; }
  // in the swing
  M.twist+=twistRate*dt; if(a>M.peak){ M.peak=a; M.peakT=t; }
  const over=(a<=M.peak*RELEASE_FRAC&&t-M.peakT>=25)||(t-M.onsetT>SWING_MAX);
  if(over){ M.phase='idle'; M.lastRelease=t; let past=null; for(const s of M.tilt){ if(s[0]<=M.onsetT-TILT_LAG) past=s; else break; } past=past||M.tilt[0];
    const p=clamp((M.peak-A_ON)/(A_MAX-A_ON),0,1); const power=0.28+0.72*p; const tw=M.twist*FLIP_SPIN; const spin=Math.abs(tw)<TWIST_DEAD?0:clamp((tw-Math.sign(tw)*TWIST_DEAD)/TWIST_FULL,-1,1);
    M.pow=power; M.spin=spin; M.lastPeak=M.peak; sendBowl(power,past?past[1]:aim,spin,{peak:Math.round(M.peak),twist:Math.round(M.twist),ms:Math.round(t-M.onsetT)}); }
}
function onOrient(e){ if(M.ok||e.gamma===null) return; const aim=clamp(e.gamma/35,-1,1); M.tilt.push([performance.now(),aim]); while(M.tilt.length>40) M.tilt.shift(); M.aim=aim; previewAim(aim); }
function meter(v){ $('meter').style.width=Math.min(100,v*100)+'%'; }
let prevT=0, prevSendT=0, prevAim=99;
function previewAim(aim){ const t=performance.now(); if(t-prevT<45) return; prevT=t; dot(aim,M.spin); if(!turn||!net) return; if(t-prevSendT<160||Math.abs(aim-prevAim)<0.04) return; prevSendT=t; prevAim=aim; net.send({f:'ai',p:pid,a:Math.round(aim*100)/100,s:Math.round(M.spin*100)/100}); }
function dot(aim,spin){ $('aimdot').style.left=(50+aim*44)+'%'; $('hookarc').style.transform=`rotate(${-90+spin*-40}deg)`; $('hookarc').style.left=(50+aim*44)+'%'; $('rAim').textContent=aim>0.15?'RIGHT':aim<-0.15?'LEFT':'STRAIGHT'; $('rSpin').textContent=Math.abs(spin)<0.1?'NONE':(spin>0?'◜ ':'◝ ')+Math.round(Math.abs(spin)*100)+'%'; }
function calibrate(){ const gl=Math.hypot(M.g[0],M.g[1],M.g[2])||1; M.ref=[M.g[0]/gl,M.g[1]/gl,M.g[2]/gl]; /* the spec says +g on the axis pointing up; a platform that inverts the axes inverts them all, so the sign of the dominant axis tells us which */ const dom=[Math.abs(M.ref[0]),Math.abs(M.ref[1]),Math.abs(M.ref[2])]; const i=dom.indexOf(Math.max(...dom)); M.sgn=i===0?1:(M.ref[i]>=0?1:-1); }
async function arm(){ let ok=false;
  try{ if(typeof DeviceMotionEvent!=='undefined'&&typeof DeviceMotionEvent.requestPermission==='function'){ const r=await DeviceMotionEvent.requestPermission(); ok=r==='granted'; if(ok&&typeof DeviceOrientationEvent!=='undefined'&&typeof DeviceOrientationEvent.requestPermission==='function'){ try{ await DeviceOrientationEvent.requestPermission(); }catch(e){} } }
    else ok=typeof DeviceMotionEvent!=='undefined'; }catch(e){ ok=false; }
  if(!ok){ $('armWhy').textContent='no motion permission — tap controls it is'; useTap(); return; }
  M.ok=false; M.n=0; addEventListener('devicemotion',onMotion); addEventListener('deviceorientation',onOrient);
  $('armGo').textContent='LISTENING…'; $('armGo').disabled=true;
  await new Promise(r=>setTimeout(r,TESTMODE?150:700));
  if(!M.ok){ $('armWhy').textContent='no motion sensors here — tap controls it is'; $('armGo').textContent='TAP TO ARM YOUR BALL'; $('armGo').disabled=false; useTap(); return; }
  calibrate(); armed=true; tapMode=false; if(net) net.send({f:'arm',p:pid,m:1}); $('armGo').textContent='TAP TO ARM YOUR BALL'; $('armGo').disabled=false;
  show('sBall'); padUI(); flash('ARMED',col,true); buzz([40,30,80]); wakeLock();
}
function useTap(){ tapMode=true; armed=false; if(net) net.send({f:'arm',p:pid,m:0}); show('sBall'); padUI(); flash('TAP MODE',col); buzz(20); wakeLock(); }
$('armGo').onclick=arm; $('armTap').onclick=useTap;

/* ---- the ball screen ---- */
let lastSend=0, lastBowl=null;
function sendBowl(power,aim,spin,dbg){ const t=Date.now(); const better=lastBowl&&t-lastBowl.t<BETTER_MS&&power>lastBowl.w*1.25; if(t-lastSend<REFRACT&&!better) return; lastSend=t; power=Math.round(power*100)/100; aim=Math.round(aim*100)/100; spin=Math.round(spin*100)/100;
  const b=$('ball'); b.classList.remove('swing'); void b.offsetWidth; b.classList.add('swing'); buzz(better?10:[18,20,30]); $('rPow').textContent=Math.round(power*100)+'%'; dot(aim,spin);
  lastBowl={t,w:power}; if(net) net.send({f:'bw',p:pid,w:power,a:aim,s:spin,t:t%100000}); if(TESTMODE) window.__lj.bowls.push({power,aim,spin,better:!!better,...dbg}); }
function padUI(){ theme(); $('padSeat').textContent=seat>=0?`${seat+1}UP`:'—'; $('padName').textContent=name; $('padMode').textContent=tapMode?'tap ball · drag · hold · let go':(M.src==='lin'?'motion ball · swing to bowl':'motion ball · raw');
  $('face').hidden=tapMode; $('readout').hidden=tapMode; $('tap').hidden=!tapMode; $('padSwitch').textContent=tapMode?'try motion':'re-arm'; $('padRelease').hidden=tapMode; phaseUI(); }
// tap mode: drag on the lane (or the ball) to aim, hold the ball to charge (the meter swings), slide sideways for the hook, let go to bowl
const TAP={aim:0,spin:0,hold:0,x0:0,pw:0,raf:0};
function tapDot(){ $('tapDot').style.left=(50+TAP.aim*44)+'%'; $('tapPath').style.left=(50+TAP.aim*44)+'%'; $('tapPath').style.transform=`skewX(${TAP.spin*-22}deg)`; }
function tapPower(){ const e=(performance.now()-TAP.hold)/1000; return 0.5-0.5*Math.cos(e*2.9); }
function tapLoop(){ if(!TAP.hold) return; const p=tapPower(); TAP.pw=p; $('tapPow').style.width=(p*100)+'%'; TAP.raf=requestAnimationFrame(tapLoop); }
const laneEl=$('tapLane'); function aimFrom(e){ const r=laneEl.getBoundingClientRect(); TAP.aim=clamp(((e.clientX-r.left)/r.width-0.5)*2.3,-1,1); tapDot(); sendAi(); }
laneEl.onpointerdown=e=>{ e.preventDefault(); try{ laneEl.setPointerCapture(e.pointerId); }catch(err){} aimFrom(e); }; laneEl.onpointermove=e=>{ if(e.buttons||e.pressure>0) aimFrom(e); };
let aiT=0; function sendAi(){ const t=performance.now(); if(t-aiT<140||!net||!turn) return; aiT=t; net.send({f:'ai',p:pid,a:Math.round(TAP.aim*100)/100,s:Math.round(TAP.spin*100)/100,w:TAP.hold?Math.round(TAP.pw*100)/100:undefined}); }
const tb=$('tapBall');
tb.onpointerdown=e=>{ e.preventDefault(); try{ tb.setPointerCapture(e.pointerId); }catch(err){} tb.classList.add('on'); TAP.hold=performance.now(); TAP.x0=e.clientX; TAP.spin=0; tapDot(); buzz(8); tapLoop(); };
tb.onpointermove=e=>{ if(!TAP.hold) return; TAP.spin=clamp((e.clientX-TAP.x0)/110,-1,1); tapDot(); sendAi(); };
const tapUp=()=>{ if(!TAP.hold) return; cancelAnimationFrame(TAP.raf); const pw=Math.max(0.2,tapPower()); TAP.hold=0; tb.classList.remove('on'); $('tapPow').style.width='0%'; sendBowl(pw,TAP.aim,TAP.spin); };
tb.onpointerup=tapUp; tb.onpointercancel=tapUp; tb.oncontextmenu=e=>e.preventDefault();
$('padRelease').onclick=()=>{ sendBowl(0.7,M.aim,0); };
$('padSwitch').onclick=()=>{ show('sArm'); };
const ACT={attract:['START LEAGUE NIGHT','start'],lobby:['START NOW','start'],over:['CONTINUE','again'],scores:['PLAY AGAIN','again'],inter:['SKIP ▸','skip']};
function phaseUI(){ const a=ACT[phase]; const btn=$('padAct'); btn.hidden=!a; if(a){ btn.textContent=a[0]; btn.dataset.c=a[1]; }
  const txt={attract:'PARTY MODE · the bots are bowling',lobby:'LOBBY · grabbing lanes',ready:'GET READY',aim:turn?'YOUR FRAME':`WAITING · ${st.tn>=0&&roster?roster.s[st.tn]+' is up':'…'}`,roll:'ROLLING',result:'THE PINS',inter:'INTERMISSION',over:'LEAGUE NIGHT IS OVER',initials:'SIGNING THE BOARD',scores:'THE HIGH ROLLERS',paused:'PAUSED',share:'SHARING'}[phase]||phase.toUpperCase();
  $('padPhase').textContent=txt; const mine=seat>=0&&st.t?st.t[seat]|0:0; $('slT').textContent=mine; $('slF').textContent=`${Math.min(st.nf,(st.fr|0)+1)}/${st.nf}`;
  let lead=-1, lv=-1; (st.t||[]).forEach((v,i)=>{ if(v>lv){ lv=v; lead=i; } }); $('slL').textContent=lead>=0?lv:'—'; $('slLn').textContent=lead>=0&&roster&&roster.s[lead]?(lead===seat?'YOU LEAD':roster.s[lead]+' LEADS'):'LEADER';
  const cue=$('cue'); cue.classList.toggle('on',turn); cue.querySelector('span').textContent=turn?(st.rl?'SECOND BALL':"YOU'RE UP"):(phase==='aim'||phase==='roll'||phase==='result'?'watch the lane':'warm up your arm'); cue.querySelector('small').textContent=turn?(tapMode?'drag to aim · hold the ball · let go':'swing back and through · the ball leaves at the top'):(phase==='aim'?'your turn comes round the lanes':'the TV plays a note for every pin');
  $('edge').classList.toggle('hold',turn&&!navigator.vibrate); const b=$('ball'); b.classList.toggle('charge',turn&&!tapMode); }
$('padAct').onclick=()=>{ const c=$('padAct').dataset.c; if(net) net.send({f:'cmd',p:pid,c}); buzz(15); };
$('padLeave').onclick=()=>{ if(net) net.send({f:'l',p:pid}); seat=-1; wanted=false; sess.set('joined','0'); show('sLane'); laneUI(); };
let resTxt=''; $('resShare').onclick=async()=>{ try{ await navigator.share({title:'Lanes · Brick Choir',text:resTxt,url:'https://pointcast.xyz/brick-choir/lanes'}); }catch(e){} };
$('resAgain').onclick=()=>{ if(net) net.send({f:'cmd',p:pid,c:'again'}); show('sBall'); };
$('resParty').onclick=()=>{ if(HUB){ if(net) net.send({f:'cmd',p:pid,c:'home'}); buzz(20); setTimeout(()=>hubFollow('home'),2500); return; } if(net) net.send({f:'cmd',p:pid,c:'party'}); show('sBall'); };
if(HUB) $('resParty').textContent='BACK TO HOME';
function ballHit(){ const b=$('ball'); b.classList.remove('hit'); void b.offsetWidth; b.classList.add('hit'); }
const EV={ur:()=>{ turn=true; phaseUI(); buzz([30,30,30]); flash("YOU'RE UP",col,true); },rl:()=>{ turn=false; phaseUI(); buzz(20); },x:()=>{ ballHit(); buzz([60,40,60,40,160]); flash('STRIKE!',col,true); },tk:()=>{ ballHit(); buzz([80,40,80,40,80,40,240]); flash('TURKEY!','#ffd27a',true); },sp:()=>{ ballHit(); buzz([40,30,90]); flash('SPARE!','#9fe3c9',true); },g:()=>{ buzz(120); flash('gutter…','rgba(244,240,255,.7)'); }};
function onEv(e){ if(EV[e]) EV[e](); else if(/^k\d+$/.test(e)){ const n=+e.slice(1); buzz(n?[20+n*4]:60); flash(n===0?'nothing':n===1?'1 pin':`${n} pins`,col); } }

/* ---- frames from the TV ---- */
function onFrame(d){ if(d.p&&d.p!==pid&&d.f!=='ev') return;
  switch(d.f){
    case 'ro': roster=d; rosterAt=Date.now(); if(seat<0) laneUI(); else phaseUI(); break;
    case 'ok': { const was=seat; seat=d.s; col=d.c||PAL[seat%8]; theme(); if(was!==seat||!$('sLane').hidden){ if(armed||tapMode){ padUI(); show('sBall'); } else show('sArm'); flash(`${seat+1}UP · ${name}`,col,true); buzz([40,30,80]); } if(armed) net.send({f:'arm',p:pid,m:1}); break; }
    case 'full': $('laneSub').textContent='every lane is taken — wait for one to open'; buzz([30,30,30]); break;
    case 'who': if(wanted) net.send({f:'j',p:pid,n:name,c:HUB_C>=0?HUB_C:undefined}); break;
    case 'st': { const ph=String(d.ph||''); st={fr:d.fr|0,rl:d.rl|0,tn:d.tn,n:d.n|0,t:d.t||[],nf:d.nf||10}; const wasTurn=turn; turn=ph==='aim'&&d.tn===seat; if(ph!==phase||wasTurn!==turn){ if(!$('sRes').hidden&&!/^(over|initials|scores|share)$/.test(ph)) show('sBall'); } phase=ph; if(seat>=0) phaseUI(); break; }
    case 'ev': (d.l||[]).forEach(([s,e])=>{ if(s===seat) onEv(e); }); break;
    case 'res': { if(seat<0) break; const sc=d.sc||[]; const mine=sc[seat]|0; const rank=sc.filter(v=>v>mine).length+1; const won=d.w===seat; $('resRank').textContent=['1ST','2ND','3RD','4TH','5TH','6TH','7TH','8TH'][rank-1]||rank+'TH'; $('resRank').style.color=won?col:'rgba(244,240,255,.6)'; $('resScore').textContent=mine; $('resStrikes').textContent=(d.x||[])[seat]|0; $('resWinner').textContent=roster&&roster.s[d.w]?roster.s[d.w]+' · '+(sc[d.w]|0):'—';
      resTxt=`Lanes: I bowled ${mine} (${(d.x||[])[seat]|0} strikes) and came ${$('resRank').textContent.toLowerCase()} of ${sc.length}. My phone was the ball.`; $('resShare').hidden=!navigator.share; show('sRes'); buzz(won?[80,40,80,40,160]:60); break; }
    case 'pq': if(typeof d.t==='number'){ rtt=Date.now()-d.t; netUI(); } break;
    case 'home': if(HUB){ flash('HOME',col,true); setTimeout(()=>hubFollow('home'),400); } break;
    case 'go': if(HUB&&d.g&&d.g!=='lanes') hubFollow(d.g); break;
  }
}
function netUI(){ const el=$('padNet'); const s=net?net.status:'off'; el.className='net '+(s!=='on'?'off':rtt===null?'':rtt<90?'good':rtt<180?'ok':'bad'); $('padPing').textContent=s!=='on'?(s==='connecting'?'…':s):(rtt===null?'live':rtt+' ms'); }
function connect(){ if(net) return; net=makeParty({code,pid,onFrame,onStatus:s=>{ netUI(); if(s==='on'){ net.send({f:'hi',p:pid}); if(wanted) net.send({f:'j',p:pid,n:name,c:HUB_C>=0?HUB_C:undefined}); } if(seat<0) laneUI(); }});
  setInterval(()=>{ if(!net||net.status!=='on') return; net.send({f:'pp',p:pid,t:Date.now(),r:rtt===null?undefined:rtt}); if(HUB&&wanted&&seat<0) net.send({f:'j',p:pid,n:name,c:HUB_C>=0?HUB_C:undefined}); if(seat<0&&(Date.now()-rosterAt>5000)){ net.send({f:'hi',p:pid}); if(rosterAt===0&&$('laneSub')) $('laneSub').textContent=`no TV is showing room ${code} yet — open pointcast.xyz/brick-choir/lanes on the TV`; } },3000); }
async function wakeLock(){ try{ if('wakeLock' in navigator&&!wake){ wake=await navigator.wakeLock.request('screen'); wake.addEventListener('release',()=>{ wake=null; }); } }catch(e){} }
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible'){ if(seat>=0) wakeLock(); if(net){ net.kick(); if(net.status==='on') net.send({f:'hi',p:pid}); } } });

/* ---- boot: a scanned QR lands with the code filled in ---- */
codeUI(); nameUI(); theme(); tapDot();
if(code.length===4){ $('nameRoom').textContent='ROOM '+code; if(name){ $('nameGo').onclick(); } else show('sName'); } else show('sCode');
if(TESTMODE) window.__lj={get seat(){return seat;},get phase(){return phase;},get turn(){return turn;},get st(){return st;},get roster(){return roster;},get net(){return net;},get rtt(){return rtt;},get armed(){return armed;},get tapMode(){return tapMode;},get M(){return M;},get screen(){return [...document.querySelectorAll('.screen')].find(s=>!s.hidden).id;},get flash(){return $('flashTxt').textContent;},pid,bowls:[],
  setName:n=>{ name=n; nameUI(); },go:()=>$('nameGo').onclick(),join,arm,useTap,bowl:(w,a,s)=>sendBowl(w,a,s||0),
  // synthetic motion: feed the detector like a browser would (≈60 Hz). g = gravity in the phone frame, lin = linear accel (m/s²), rot = deg/s [alpha,beta,gamma]
  motion:(lin,rot,g)=>{ const ag=g||[0,0,9.81]; const e={accelerationIncludingGravity:{x:ag[0]+lin[0],y:ag[1]+lin[1],z:ag[2]+lin[2]},acceleration:{x:lin[0],y:lin[1],z:lin[2]},rotationRate:{alpha:rot[0],beta:rot[1],gamma:rot[2]}}; onMotion(e); },
  tap:(aim,spin,holdMs)=>{ TAP.aim=aim; tapDot(); tb.onpointerdown({preventDefault(){},pointerId:1,clientX:100}); tb.onpointermove({clientX:100+spin*110}); setTimeout(tapUp,holdMs||300); }};
</script>
</body>
</html>
