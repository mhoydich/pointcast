---
// /brick-choir/lanes-join — the phone ball for Lanes (the TV is /brick-choir/lanes). Scan the card on the TV or type its
// room code, pick a three-letter name, grab a lane, then ARM the ball: iOS needs DeviceMotionEvent.requestPermission()
// from a tap, so the arming screen is one big button. After that the phone is the ball: hold it like one, swing back and
// through. The release is the peak of the forward swing (the detector watches |linear acceleration| climb past A_ON and
// fires the moment it turns over), the peak's height is the speed, the lean of the phone read TILT_LAG before the swing
// began is the aim (during the swing the accelerometer is all swing, no gravity), and the wrist's twist integrated over
// the swing (rotationRate about the phone's long axis) is the hook. While you line up, the lean streams to the TV as
// an aim preview (the dots on the lane). No motion sensors, or permission denied, or a laptop: TAP MODE — drag the ball
// left or right to aim, hold it to charge (the meter swings), slide sideways while holding for the hook, let go to bowl.
// No audio here — the TV is the speaker; haptics on the release and the strike (navigator.vibrate), an edge flash where
// there is none (iOS). Transport: the shared party client. Built 2026-09-24 by Claude (Fable).
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Lanes: your phone is the ball · PointCast</title>
<meta name="description" content="The phone ball for Lanes on the TV. Scan the TV, arm your ball, swing.">
<meta property="og:title" content="Lanes: your phone is the ball">
<meta property="og:description" content="Scan the TV, arm your ball, swing. Every pin is a note.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/lanes-join">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og4.jpg">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0b0a1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/lanes-join">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --gold:#ffd27a; --pink:#ff8fb1; --mint:#9fe3c9; --sky:#8fd0ff; --violet:#b9a8ff; --c:#ffd27a;
    --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;overscroll-behavior:none;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;}
  button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;touch-action:manipulation;}
  #app{position:fixed;inset:0;display:flex;flex-direction:column;padding:calc(14px + env(safe-area-inset-top,0px)) 16px calc(14px + env(safe-area-inset-bottom,0px));box-sizing:border-box;}
  .screen{flex:1;display:flex;flex-direction:column;gap:12px;min-height:0;animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.97) translateY(6px);}}
  .logo{display:flex;justify-content:center;font:800 clamp(30px,10vw,44px)/1 var(--display);letter-spacing:-.02em;margin-top:8px;}
  .logo span{background:linear-gradient(180deg,oklch(90% .1 var(--h)),oklch(72% .17 calc(var(--h) + 60)));-webkit-background-clip:text;background-clip:text;color:transparent;}
  .sub{text-align:center;font:800 12px var(--mono);letter-spacing:.3em;color:var(--gold);text-indent:.3em;}
  .lead{margin:6px 0 0;text-align:center;font:500 15px/1.4 var(--display);color:rgba(244,240,255,.75);} .lead b{color:var(--ink);font-weight:700;}
  .lbl{font:700 12px var(--mono);letter-spacing:.2em;color:var(--mint);margin-top:8px;} .lbl small{display:block;font:500 11px var(--mono);letter-spacing:.06em;color:rgba(244,240,255,.5);margin-top:3px;text-transform:none;}
  .fine{margin:0;text-align:center;font:500 12px/1.4 var(--display);color:rgba(244,240,255,.5);}
  .top{display:flex;justify-content:space-between;align-items:center;} .top a{font:600 12px var(--mono);letter-spacing:.1em;color:var(--sky);text-decoration:none;}
  .chip{font:700 13px var(--mono);letter-spacing:.16em;color:#140f28;background:var(--gold);border-radius:999px;padding:7px 12px;} .chip.ghost{background:rgba(255,255,255,.1);color:var(--ink);}
  .boxes{display:flex;justify-content:center;gap:10px;}
  .boxes b{width:64px;height:78px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);display:grid;place-items:center;font:800 44px var(--mono);color:var(--gold);position:relative;}
  .boxes b.cur{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold),0 0 18px rgba(255,210,122,.35);} .boxes b.cur:empty::after{content:"";width:26px;height:4px;background:var(--gold);position:absolute;bottom:12px;animation:blink .7s steps(2,end) infinite;}
  @keyframes blink{50%{opacity:.2;}}
  .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;flex:1;min-height:0;align-content:start;}
  .grid button{aspect-ratio:1.15;min-height:44px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);font:700 22px var(--mono);color:var(--ink);transition:transform .08s,background .08s;}
  .grid button:active,.grid button.on{background:var(--gold);color:#140f28;transform:scale(.94);}
  .grid button.bk{font-size:18px;color:var(--pink);}
  .big{display:block;width:100%;padding:16px 18px;border-radius:999px;background:var(--gold);color:#140f28;font:800 15px var(--mono);letter-spacing:.14em;box-shadow:0 8px 30px rgba(255,210,122,.3);transition:transform .1s,opacity .2s;}
  .big:active{transform:scale(.98);} .big[disabled]{opacity:.35;box-shadow:none;} .big.ghost{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.16);box-shadow:none;}
  /* the roster: who is bowling tonight */
  .roster{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start;overflow:auto;}
  .roster div{--c:#fff;padding:10px 12px;border-radius:14px;background:color-mix(in oklab,var(--c) 12%,transparent);border:1px solid color-mix(in oklab,var(--c) 45%,transparent);display:flex;justify-content:space-between;align-items:center;gap:8px;}
  .roster div b{font:800 18px var(--display);color:var(--c);} .roster div small{font:600 10px var(--mono);letter-spacing:.1em;opacity:.6;} .roster div.open{border-style:dashed;opacity:.5;}
  /* the ball screen */
  .pad{gap:10px;}
  .padhead{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;}
  .seatbadge{display:flex;flex-direction:column;align-items:center;justify-content:center;width:58px;height:58px;border-radius:16px;background:color-mix(in oklab,var(--c) 22%,transparent);border:1px solid color-mix(in oklab,var(--c) 60%,transparent);}
  .seatbadge b{font:800 18px/1 var(--display);color:var(--c);} .seatbadge span{font:700 9px var(--mono);letter-spacing:.14em;opacity:.8;margin-top:3px;}
  .me b{display:block;font:800 24px/1 var(--display);letter-spacing:.02em;} .me small{display:block;font:600 11px var(--mono);letter-spacing:.08em;color:rgba(244,240,255,.55);margin-top:4px;min-height:1.2em;}
  .net{display:flex;align-items:center;gap:5px;font:600 10px var(--mono);color:rgba(244,240,255,.55);justify-content:flex-end;} .net i{width:8px;height:8px;border-radius:50%;background:#666;box-shadow:0 0 6px #666;}
  .net.good i{background:var(--mint);box-shadow:0 0 8px var(--mint);} .net.ok i{background:var(--gold);box-shadow:0 0 8px var(--gold);} .net.bad i{background:var(--pink);box-shadow:0 0 8px var(--pink);} .net.off i{animation:blink 1s steps(2,end) infinite;}
  .scoreline{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);}
  .scoreline .t{font:800 26px/1 var(--mono);font-variant-numeric:tabular-nums;} .scoreline .t small{display:block;font:700 9px var(--mono);letter-spacing:.18em;margin-top:4px;opacity:.7;} .scoreline .t.b{text-align:right;} .scoreline .t.a span{color:var(--c);}
  .scoreline .r{text-align:center;font:800 20px/1 var(--mono);color:var(--gold);} .scoreline .r small{display:block;font:700 9px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.5);margin-top:4px;}
  .phase{font:700 11px var(--mono);letter-spacing:.2em;color:rgba(244,240,255,.6);text-align:center;}
  .cue{display:grid;place-items:center;text-align:center;border-radius:16px;padding:10px;background:color-mix(in oklab,var(--c) 14%,transparent);border:1px solid color-mix(in oklab,var(--c) 40%,transparent);opacity:.35;transition:opacity .15s,transform .15s;}
  .cue span{font:800 22px/1 var(--display);color:var(--c);} .cue small{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.65);margin-top:4px;}
  .cue.on{opacity:1;animation:cue .5s ease-in-out infinite alternate;} @keyframes cue{to{transform:scale(1.03);box-shadow:0 0 0 2px var(--c),0 0 30px color-mix(in oklab,var(--c) 60%,transparent);}}
  /* the ball: a big glossy sphere in your colour that swings with you; under it a strip of lane with the aim dot */
  .face{flex:1;min-height:0;display:grid;place-items:center;position:relative;}
  .ballwrap{display:flex;flex-direction:column;align-items:center;gap:14px;width:100%;}
  .ball{width:min(58vw,40vh);aspect-ratio:1;border-radius:50%;position:relative;background:radial-gradient(circle at 32% 28%,color-mix(in oklab,var(--c) 45%,#fff),color-mix(in oklab,var(--c) 75%,#14122a) 55%,color-mix(in oklab,var(--c) 35%,#000));box-shadow:0 24px 50px rgba(0,0,0,.55),inset 0 -14px 34px rgba(0,0,0,.4),0 0 0 6px rgba(255,255,255,.05);transition:transform .1s;}
  .ball i{position:absolute;width:11%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 40% 35%,#2a2547,#07060f 70%);box-shadow:inset 0 2px 4px rgba(0,0,0,.8);} .ball i:nth-child(1){left:36%;top:26%;} .ball i:nth-child(2){left:53%;top:26%;} .ball i:nth-child(3){left:44.5%;top:42%;}
  .ball .ring{position:absolute;inset:-9px;border-radius:50%;border:3px solid var(--c);opacity:0;} .ball.swing{animation:swingB .5s cubic-bezier(.2,.9,.3,1.3);} @keyframes swingB{25%{transform:translateY(-22%) scale(1.08);}100%{transform:none;}}
  .ball.hit .ring{animation:ringOut .5s ease-out;} @keyframes ringOut{from{opacity:1;transform:scale(1);}to{opacity:0;transform:scale(1.5);}}
  .ball.charge{animation:charge .25s ease-in-out infinite alternate;} @keyframes charge{to{transform:scale(1.04);}}
  .lanebar{display:grid;grid-template-columns:14px 1fr 14px;height:46px;width:min(78vw,340px);border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.12);}
  .lanebar .gutter{background:rgba(0,0,0,.4);} .lanebar .boards{position:relative;background:repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 6px,rgba(255,255,255,.02) 6px 12px),#1e1a38;}
  .lanebar .boards::before{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.2);}
  .lanebar .dot{position:absolute;top:50%;left:50%;width:22px;height:22px;margin:-11px;border-radius:50%;background:var(--c);box-shadow:0 0 16px var(--c);transition:left .08s;}
  .lanebar .hookarc{position:absolute;left:50%;top:50%;width:60px;height:2px;margin-top:-1px;transform-origin:left center;background:linear-gradient(90deg,var(--c),transparent);opacity:.7;transition:transform .1s;}
  .readout{display:flex;justify-content:space-around;font:700 10px var(--mono);letter-spacing:.14em;color:rgba(244,240,255,.5);} .readout b{color:var(--c);font-size:13px;margin-left:4px;}
  .motionmeter{position:absolute;left:0;right:0;bottom:0;height:4px;border-radius:2px;background:rgba(255,255,255,.08);overflow:hidden;} .motionmeter i{display:block;height:100%;width:0;background:var(--c);transition:width .05s;}
  /* tap mode: the lane you aim on, the ball you hold */
  .tap{flex:1;min-height:0;display:flex;flex-direction:column;gap:10px;align-items:center;}
  .lanebar.tall{height:min(24vh,190px);width:min(78vw,320px);} .lanebar.tall .boards{background:repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 8px,rgba(255,255,255,.02) 8px 16px),#1e1a38;}
  .pinsrow{position:absolute;top:8px;left:0;right:0;display:flex;justify-content:center;gap:5px;} .pinsrow i{width:9px;height:9px;border-radius:50%;background:rgba(244,240,255,.75);box-shadow:0 0 6px rgba(244,240,255,.6);}
  .lanebar .dot.ball{top:auto;bottom:10px;width:30px;height:30px;margin:-15px;left:50%;transition:none;}
  .lanebar .path{position:absolute;left:50%;bottom:26px;width:2px;height:calc(100% - 54px);background:repeating-linear-gradient(180deg,var(--c) 0 6px,transparent 6px 12px);opacity:.75;transform-origin:bottom center;}
  .power{width:min(78vw,320px);height:26px;border-radius:13px;background:rgba(255,255,255,.08);position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.1);} .power i{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,var(--mint),var(--gold) 60%,var(--pink));} .power span{position:absolute;inset:0;display:grid;place-items:center;font:700 9px var(--mono);letter-spacing:.16em;color:rgba(244,240,255,.75);}
  .tapball{width:min(44vw,180px);aspect-ratio:1;border-radius:50%;position:relative;background:radial-gradient(circle at 32% 28%,color-mix(in oklab,var(--c) 45%,#fff),color-mix(in oklab,var(--c) 75%,#14122a) 55%,color-mix(in oklab,var(--c) 35%,#000));box-shadow:0 18px 40px rgba(0,0,0,.5),inset 0 -12px 30px rgba(0,0,0,.4);display:grid;place-items:center;font:800 16px var(--mono);letter-spacing:.2em;color:rgba(20,15,40,.7);transition:transform .08s;touch-action:none;}
  .tapball i{position:absolute;width:11%;aspect-ratio:1;border-radius:50%;background:#0b0a1a;} .tapball i:nth-child(1){left:36%;top:22%;} .tapball i:nth-child(2){left:53%;top:22%;} .tapball i:nth-child(3){left:44.5%;top:38%;}
  .tapball b{margin-top:30%;} .tapball.on{transform:scale(.94);box-shadow:0 0 0 6px var(--c),0 0 40px var(--c),inset 0 -12px 30px rgba(0,0,0,.4);}
  .padfoot{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
  .act{flex:1;padding:14px;border-radius:999px;background:var(--gold);color:#140f28;font:800 13px var(--mono);letter-spacing:.14em;box-shadow:0 6px 24px rgba(255,210,122,.3);animation:blink 2.4s ease-in-out infinite;}
  .leave,.mode{font:600 12px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.45);padding:12px;} .leave{margin-left:auto;}
  /* arming */
  .arm{justify-content:center;text-align:center;gap:14px;}
  .ballart{width:min(56vw,220px);aspect-ratio:1;margin:0 auto;border-radius:50%;position:relative;background:radial-gradient(circle at 32% 28%,color-mix(in oklab,var(--c) 45%,#fff),color-mix(in oklab,var(--c) 75%,#14122a) 55%,color-mix(in oklab,var(--c) 35%,#000));box-shadow:0 20px 50px rgba(0,0,0,.5);animation:swingArt 2.6s ease-in-out infinite;}
  .ballart i{position:absolute;width:11%;aspect-ratio:1;border-radius:50%;background:#0b0a1a;} .ballart i:nth-child(1){left:36%;top:26%;} .ballart i:nth-child(2){left:53%;top:26%;} .ballart i:nth-child(3){left:44.5%;top:42%;}
  @keyframes swingArt{0%,100%{transform:translateX(-14%) rotate(-16deg);}50%{transform:translateX(14%) rotate(18deg);}}
  .arm h2{margin:0;font:800 26px/1.1 var(--display);} .arm p{margin:0;font:500 14px/1.45 var(--display);color:rgba(244,240,255,.75);}
  .arm .why{font:600 11px/1.5 var(--mono);color:rgba(244,240,255,.45);letter-spacing:.04em;}
  /* results */
  .res{justify-content:center;text-align:center;gap:10px;}
  .rank{font:800 clamp(72px,26vw,120px)/1 var(--display);color:var(--c);text-shadow:0 0 40px color-mix(in oklab,var(--c) 60%,transparent);}
  .resline{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.05);font:600 13px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.6);} .resline b{font:700 20px var(--mono);color:var(--ink);letter-spacing:0;}
  /* feedback: a full-screen flash for the big moments, an edge pulse instead of a buzz where there is no vibrator */
  #flash{position:fixed;inset:0;pointer-events:none;z-index:20;display:grid;place-items:center;opacity:0;background:radial-gradient(60% 50% at 50% 45%,color-mix(in oklab,var(--f,#fff) 40%,transparent),transparent 70%);}
  #flash b{font:800 clamp(34px,11vw,52px) var(--display);color:var(--f,#fff);text-shadow:0 4px 30px rgba(0,0,0,.6);letter-spacing:-.01em;transform:rotate(-4deg);}
  #flash.go{animation:flash .55s ease-out;} @keyframes flash{0%{opacity:1;}100%{opacity:0;}}
  #flash.big.go{animation:flashBig 1.1s ease-out;} @keyframes flashBig{0%{opacity:1;}60%{opacity:.9;}100%{opacity:0;}}
  #edge{position:fixed;inset:0;pointer-events:none;z-index:19;box-shadow:inset 0 0 0 0 var(--c);opacity:0;} #edge.go{animation:edge .35s ease-out;} @keyframes edge{0%{opacity:1;box-shadow:inset 0 0 0 14px var(--c),inset 0 0 60px var(--c);}100%{opacity:0;box-shadow:inset 0 0 0 0 var(--c);}}
  #edge.hold{opacity:1;animation:edgeHold .5s ease-in-out infinite alternate;} @keyframes edgeHold{from{box-shadow:inset 0 0 0 4px var(--c),inset 0 0 30px color-mix(in oklab,var(--c) 40%,transparent);}to{box-shadow:inset 0 0 0 10px var(--c),inset 0 0 60px color-mix(in oklab,var(--c) 60%,transparent);}}
  @media (max-height:640px){ .boxes b{width:52px;height:62px;font-size:34px;} .grid button{min-height:38px;font-size:18px;} .ball{width:min(48vw,30vh);} }
  @media (prefers-reduced-motion:reduce){ .cue.on,.act,#edge.hold,.boxes b.cur:empty::after,.net.off i,.ballart,.ball.charge{animation:none;} }
</style>
</head>
<body>
<div id="edge" aria-hidden="true"></div>
<div id="flash" aria-hidden="true"><b id="flashTxt"></b></div>
<main id="app">
  <section id="sCode" class="screen">
    <div class="logo"><span style="--h:280">L</span><span style="--h:324">A</span><span style="--h:8">N</span><span style="--h:52">E</span><span style="--h:96">S</span></div>
    <div class="sub">PHONE BALL</div>
    <p class="lead">Put <b>pointcast.xyz/brick-choir/lanes</b> on the TV, then type the four letters it shows.</p>
    <div class="lbl">ROOM CODE</div>
    <div class="boxes" id="codeBoxes"><b></b><b></b><b></b><b></b></div>
    <div class="grid" id="codeGrid"></div>
    <button class="big" id="codeGo" disabled>FIND THE TV ▸</button>
    <p class="fine">or scan the card on the TV — the QR code brings you here with the code filled in</p>
  </section>

  <section id="sName" class="screen" hidden>
    <div class="top"><span class="chip" id="nameRoom">ROOM ····</span><a href="#" id="nameBack">change</a></div>
    <div class="lbl">YOUR NAME <small>three letters, scoresheet style</small></div>
    <div class="boxes" id="nameBoxes"><b></b><b></b><b></b></div>
    <div class="grid six" id="nameGrid"></div>
    <button class="big" id="nameGo" disabled>GRAB A LANE ▸</button>
  </section>

  <section id="sLane" class="screen" hidden>
    <div class="top"><span class="chip" id="laneRoom">ROOM ····</span><span class="chip ghost" id="laneName">···</span></div>
    <div class="lbl">TONIGHT'S BOWLERS <small id="laneSub">looking for the TV…</small></div>
    <div class="roster" id="roster"></div>
    <button class="big" id="laneGo">GRAB A LANE ▸</button>
    <p class="fine" id="laneNote">up to eight bowlers take turns · bots fill a lane if it's just you</p>
  </section>

  <section id="sArm" class="screen arm" hidden>
    <div class="ballart" id="armArt"><i></i><i></i><i></i></div>
    <h2 id="armTitle">HOLD YOUR PHONE LIKE A BALL</h2>
    <p>Screen up in your palm, arm by your side. Tap the button — that's your zero. Then swing back and through, like you're bowling: the ball leaves at the top of the swing.</p>
    <button class="big" id="armGo">TAP TO ARM YOUR BALL</button>
    <button class="big ghost" id="armTap">USE TAP CONTROLS INSTEAD</button>
    <p class="why" id="armWhy">iPhones ask permission for motion — that's why this is a button. Keep a good grip!</p>
  </section>

  <section id="sBall" class="screen pad" hidden>
    <header class="padhead">
      <div class="seatbadge"><b id="padSeat">1UP</b><span>LANE</span></div>
      <div class="me"><b id="padName">ABC</b><small id="padMode">motion ball</small></div>
      <div class="net" id="padNet"><i></i><span id="padPing">—</span></div>
    </header>
    <div class="scoreline"><div class="t a"><span id="slT">0</span><small>YOUR SCORE</small></div><div class="r"><span id="slF">1</span><small>FRAME</small></div><div class="t b"><span id="slL">—</span><small id="slLn">LEADER</small></div></div>
    <div class="phase" id="padPhase">PARTY MODE</div>
