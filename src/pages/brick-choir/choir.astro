    for(let i=0;i<3;i++){ const ch=entry[i]||''; const x=W/2-90+i*90; g.fillStyle='rgba(255,255,255,.08)'; rr(x-34,320,68,84,14); g.fill(); if(i===entry.length&&Math.floor(T/300)%2){ g.fillStyle='#ffd27a'; g.fillRect(x-18,392,36,4); } txt(ch,x,364,{size:52,weight:800,font:'mono',color:`oklch(88% 0.12 ${i*80+300})`}); }
    txt('enter to confirm · backspace to fix',W/2,450,{size:13,weight:500,font:'mono',color:'rgba(244,240,255,.5)'});
