const BOARD_LABEL={day:'TODAY',week:'THIS WEEK',all:'ALL TIME'};
function toggleBoard(dir=1){ const i=BOARDS.indexOf(boardMode); boardMode=BOARDS[(i+dir+BOARDS.length)%BOARDS.length]; if(ctx) tone(76,{kind:'lead',len:0.05,vel:0.4}); }
