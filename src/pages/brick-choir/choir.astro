      txt(`${utcDay()} · by ${lvl.architect} · ${NAMES[lvl.root]} ${lvl.scale.replace('pent',' pentatonic').replace('maj','major').replace('min','minor')} · 60 seconds · one run`,W/2,358,{size:13,weight:500,font:'mono',color:'rgba(244,240,255,.6)'});
