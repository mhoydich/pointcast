</div></div>

<script is:inline>
(() => {
'use strict';
const LEVELS = [{"id": "terra-01", "architect": "Terra", "title": "First Ramp", "line": "A small opening is enough for the ceiling to begin answering.", "scale": "majpent", "root": 0, "bpm": 88, "voice": "bloom", "speed": 0.85, "bricks": {"Digit1": 2, "KeyQ": 1, "KeyW": 1, "KeyE": 1, "KeyA": 1, "KeyS": 1, "KeyD": 1, "KeyF": 2, "KeyG": 1, "KeyJ": 1, "KeyK": 1, "KeyL": 1, "Semicolon": 1, "Quote": 1, "KeyZ": 1, "KeyX": 1, "KeyC": 1, "KeyV": 1, "KeyB": 1, "KeyN": 1, "KeyM": 1, "Comma": 1, "Period": 1, "Slash": 1}, "capsules": ["KeyQ", "KeyJ", "KeyN"]}, {"id": "terra-02", "architect": "Terra", "title": "Span of Rain", "line": "Cross the span; leave the open air singing beneath you.", "scale": "minpent", "root": 9, "bpm": 96, "voice": "reed", "speed": 0.93, "bricks": {"Digit4": 1, "Digit5": 1, "KeyQ": 1, "KeyW": 1, "KeyE": 1, "KeyR": 2, "KeyT": 1, "KeyY": 2, "KeyU": 1, "KeyI": 1, "KeyO": 2, "KeyP": 1, "BracketLeft": 1, "BracketRight": 1, "KeyA": 1, "KeyS": 1, "KeyD": 1, "KeyL": 1, "Semicolon": 1, "Quote": 1, "KeyZ": 1, "KeyX": 1, "Period": 1, "Slash": 1}, "capsules": ["Digit5", "KeyY", "KeyD"]}, {"id": "terra-03", "architect": "Terra", "title": "Tiled Thunder", "line": "Every other note waits for the one that follows.", "scale": "hirajoshi", "root": 2, "bpm": 104, "voice": "glass", "speed": 1.01, "bricks": {"Digit1": 1, "Digit3": 1, "Digit5": 2, "Digit7": 1, "Digit9": 2, "KeyW": 1, "KeyR": 2, "KeyY": 2, "KeyI": 1, "KeyP": 1, "BracketRight": 1, "KeyA": 1, "KeyD": 1, "KeyG": 2, "KeyJ": 1, "KeyL": 1, "Quote": 2, "KeyX": 1, "KeyV": 1, "KeyN": 1, "Comma": 1, "Slash": 1}, "capsules": ["Digit3", "KeyI", "KeyJ", "KeyN"]}, {"id": "sonnet-verse", "architect": "Sonnet", "title": "Shine", "line": "Break the noise until only SHINE remains.", "scale": "lydian", "root": 0, "bpm": 108, "voice": "bloom", "speed": 1.0, "bricks": {"Digit1": 1, "Digit2": 1, "Digit3": 1, "Digit4": 1, "Digit5": 1, "Digit6": 1, "Digit7": 1, "Digit8": 1, "Digit9": 1, "Digit0": 1, "KeyS": 2, "KeyH": 2, "KeyI": 2, "KeyN": 2, "KeyE": 2, "BracketLeft": 1, "BracketRight": 1, "Semicolon": 1, "Quote": 1, "Comma": 1}, "capsules": ["KeyS", "KeyH", "KeyN", "Digit1"]}, {"id": "terra-04", "architect": "Terra", "title": "V of Light", "line": "The two arms meet where a single bright note can turn.", "scale": "dorian", "root": 5, "bpm": 112, "voice": "bloom", "speed": 1.1, "bricks": {"Digit1": 1, "Digit2": 2, "Digit3": 1, "Digit8": 1, "Digit9": 2, "Digit0": 1, "KeyW": 1, "KeyE": 2, "KeyR": 1, "KeyO": 1, "KeyP": 2, "BracketLeft": 1, "KeyD": 1, "KeyF": 2, "KeyG": 1, "KeyK": 1, "KeyL": 2, "Semicolon": 1, "KeyV": 2, "KeyB": 1, "KeyN": 1, "KeyM": 2}, "capsules": ["Digit1", "KeyR", "KeyG", "KeyN"]}, {"id": "terra-05", "architect": "Terra", "title": "Stone Organ", "line": "Three columns hold their notes until the air learns where to pass.", "scale": "lydian", "root": 7, "bpm": 124, "voice": "reed", "speed": 1.2, "bricks": {"Digit1": 2, "Digit2": 1, "Digit4": 1, "Digit5": 9, "Digit6": 2, "Digit9": 1, "Digit0": 1, "KeyQ": 1, "KeyW": 2, "KeyT": 1, "KeyY": 2, "KeyU": 1, "KeyP": 1, "BracketLeft": 2, "KeyA": 1, "KeyS": 1, "KeyG": 2, "KeyH": 9, "KeyJ": 1, "Semicolon": 1, "Quote": 2, "KeyZ": 1, "KeyX": 1, "KeyB": 1, "KeyN": 1, "KeyM": 1, "Period": 1, "Slash": 1}, "capsules": ["Digit2", "KeyT", "KeyJ", "KeyN", "Period"]}, {"id": "terra-06", "architect": "Terra", "title": "Glass Cathedral", "line": "Find the narrow panes; the old stones will not yield.", "scale": "whole", "root": 11, "bpm": 136, "voice": "glass", "speed": 1.3, "bricks": {"Digit3": 1, "Digit4": 2, "Digit5": 9, "Digit6": 2, "Digit7": 1, "Digit8": 1, "KeyW": 1, "KeyE": 2, "KeyR": 1, "KeyY": 9, "KeyU": 2, "KeyO": 1, "KeyP": 1, "BracketLeft": 1, "KeyA": 2, "KeyS": 1, "KeyD": 2, "KeyG": 1, "KeyH": 9, "KeyJ": 2, "KeyL": 1, "Semicolon": 1, "Quote": 1, "KeyZ": 1, "KeyX": 2, "KeyC": 1, "KeyV": 2, "KeyB": 9, "KeyN": 1, "KeyM": 1, "Period": 1, "Slash": 1}, "capsules": ["Digit7", "KeyR", "KeyO", "KeyG", "KeyL", "Period"]}, {"id": "astra-spell", "architect": "Astra", "title": "The Spell", "line": "By glass and choir, let stone remember fire.", "scale": "hirajoshi", "root": 2, "bpm": 104, "voice": "glass", "speed": 0.9, "bricks": {"Digit3": 2, "Digit4": 1, "Digit5": 1, "Digit7": 1, "Digit8": 1, "Digit9": 2, "KeyW": 2, "KeyE": 1, "KeyR": 1, "KeyT": 1, "KeyU": 1, "KeyI": 1, "KeyO": 1, "KeyP": 2, "KeyS": 2, "KeyD": 1, "KeyF": 1, "KeyJ": 1, "KeyK": 1, "KeyL": 2, "KeyC": 1, "KeyV": 1, "KeyM": 1, "Comma": 1}, "capsules": ["KeyV", "KeyM", "KeyT", "KeyU"], "phrase": ["KeyZ", "KeyC", "KeyV", "KeyN", "KeyV", "KeyZ", "KeyC", "KeyV", "KeyB", "KeyV", "KeyC", "KeyV", "KeyN", "KeyM", "KeyN", "KeyB", "KeyV", "KeyC", "KeyX", "KeyZ"]}];
const LINES = ["A single spark drops down through silent air", "It finds the wall where every hush is stacked", "Each key a brick of sound asleep in rows", "The light begins to knock, and one wall cracks", "It climbs the keys like rain that runs uphill", "Wakes low notes first, then higher, brighter tones", "The wall of quiet trembles, key by key", "Glass turns to chime, and stone gives way to bells", "Above the ceiling now the spark runs free", "Tunneling through echoes it has made", "Each letter struck becomes a breath of light", "The paddle waits below like open hands", "Until the whole keyboard hums a single word", "And silence learns to sing the song it hid"];
const MODELS={Terra:'GPT-5.6 Terra',Sonnet:'Claude Sonnet',Astra:'GPT-6 Astra'};

/* ================= modes: the lobby's attract screen, and today's song ================= */
const Q=new URLSearchParams(location.search);
const ATTRACT=Q.has('attract');            // silent, input-free demo for a cabinet screen in /brick-choir
const DAILY=Q.has('daily');                // today's song: one 60 s run of a date-picked round, same for everyone
const GAME=DAILY?'daily':'choir';
if(ATTRACT) document.body.classList.add('attract');
function seeded(seed){ let s=seed>>>0||1; return ()=>{ s=(s*1664525+1013904223)>>>0; return s/4294967296; }; }
const utcDay=()=>new Date().toISOString().slice(0,10);
const DAY_IDX=Math.floor(Date.now()/86400000);
// the daily pick: a seeded walk over the songbook so consecutive days never repeat a round
function dailyPick(dayIdx=DAY_IDX){ const n=LEVELS.length; const epoch=Math.floor(dayIdx/n); const r=seeded(epoch*2654435761+7); const perm=LEVELS.map((_,i)=>i); for(let i=n-1;i>0;i--){ const j=Math.floor(r()*(i+1)); [perm[i],perm[j]]=[perm[j],perm[i]]; } return perm[dayIdx%n]; }
const DAILY_LVL=dailyPick();
const dailyStore={get(){ try{ return JSON.parse(localStorage.getItem('bc:daily')||'{}')||{}; }catch(e){ return {}; } },set(v){ try{ localStorage.setItem('bc:daily',JSON.stringify(v)); }catch(e){} }};
/* streak: consecutive UTC days on which today's song was played to the end (not just started) */
function streakNow(){ const d=dailyStore.get(); if(!d.last) return 0; const today=utcDay(), y=new Date(Date.now()-86400000).toISOString().slice(0,10); return (d.last===today||d.last===y)?(d.streak|0):0; }
function markDailyPlayed(score){ const d=dailyStore.get(), today=utcDay(), y=new Date(Date.now()-86400000).toISOString().slice(0,10);
  if(d.last!==today){ d.streak=(d.last===y?(d.streak|0):0)+1; d.last=today; } d.best=d.best||{}; d.best[today]=Math.max(d.best[today]||0,score); d.plays=(d.plays|0)+1; dailyStore.set(d); return d.streak; }

/* ================= world ================= */
const W=1000, H=700;
const ROWS=[
  {codes:['Digit1','Digit2','Digit3','Digit4','Digit5','Digit6','Digit7','Digit8','Digit9','Digit0'],caps:'1234567890',off:0.5,drum:true},
  {codes:['KeyQ','KeyW','KeyE','KeyR','KeyT','KeyY','KeyU','KeyI','KeyO','KeyP','BracketLeft','BracketRight'],caps:'QWERTYUIOP[]',off:1.0,rowIdx:2},
  {codes:['KeyA','KeyS','KeyD','KeyF','KeyG','KeyH','KeyJ','KeyK','KeyL','Semicolon','Quote'],caps:"ASDFGHJKL;'",off:1.3,rowIdx:1},
  {codes:['KeyZ','KeyX','KeyC','KeyV','KeyB','KeyN','KeyM','Comma','Period','Slash'],caps:'ZXCVBNM,./',off:1.8,rowIdx:0},
];
const U=64, KW=58, KH=30, X0=(W-13.3*U)/2, WALL_TOP=118, WGAP=40, DECK_TOP=548, DECK_ROW=36, CEIL=100, SIDE=24;
const cell={};
ROWS.forEach((r,ri)=>r.codes.forEach((c,i)=>{ const x=X0+(r.off+i)*U; cell[c]={row:ri,i,x,cx:x+KW/2,y:WALL_TOP+ri*WGAP,dy:DECK_TOP+8+ri*DECK_ROW,cap:r.caps[i],drum:!!r.drum,rowIdx:r.rowIdx}; }));
const WALL_BOTTOM=WALL_TOP+3*WGAP+KH;
const DRUMS=['kick','snare','hat','open','clap','rim','tom','high','shaker','crash'];
const SCALES={majpent:{steps:[0,2,4,7,9],ro:2},minpent:{steps:[0,3,5,7,10],ro:2},hirajoshi:{steps:[0,2,3,7,8],ro:2},dorian:{steps:[0,2,3,5,7,9,10],ro:3},lydian:{steps:[0,2,4,5,7,9,11],ro:3},whole:{steps:[0,2,4,6,8,10],ro:3}};
const NAMES=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'];
const hue=m=>((m%12)*30+300)%360;             // pastel wheel, pitch → colour
const col=(m,l=78,c=0.13,a=1)=>`oklch(${l}% ${c} ${hue(m)} / ${a})`;

/* ================= audio ================= */
let ctx=null, out, duck, music, sfx, wet, dly, fbk, muted=false;
function ir(sec,dec){ const n=ctx.sampleRate*sec,b=ctx.createBuffer(2,n,ctx.sampleRate); for(let c=0;c<2;c++){const d=b.getChannelData(c); for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,dec);} return b; }
function boot(){
  if(ctx){ if(ctx.state==='suspended') ctx.resume(); return true; }
  try{ ctx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return false; }
  const comp=ctx.createDynamicsCompressor(); comp.threshold.value=-10; comp.ratio.value=4; comp.attack.value=0.003; comp.release.value=0.2;
  out=ctx.createGain(); out.gain.value=muted?0:0.8; out.connect(comp); comp.connect(ctx.destination);
  duck=ctx.createGain(); duck.connect(out); music=ctx.createGain(); music.gain.value=0.9; music.connect(duck); sfx=ctx.createGain(); sfx.connect(out);
  const cv=ctx.createConvolver(); cv.buffer=ir(2.6,3); wet=ctx.createGain(); wet.gain.value=0.22; wet.connect(cv); cv.connect(out);
  dly=ctx.createDelay(2); fbk=ctx.createGain(); fbk.gain.value=0.28; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=3000;
  const snd=ctx.createGain(); snd.gain.value=0.16; snd.connect(dly); dly.connect(lp); lp.connect(fbk); fbk.connect(dly); lp.connect(out); out._send=snd; dly.delayTime.value=0.34;
  return true;
}
const mtof=m=>440*Math.pow(2,(m-69)/12);
function tone(m,{t,kind='bell',vel=0.8,len=0.15,pan=0,bus}={}){
  if(!ctx||muted) return; t=Math.max(t||0,ctx.currentTime); const f=mtof(m); const g=ctx.createGain(), p=ctx.createStereoPanner(); p.pan.value=Math.max(-0.9,Math.min(0.9,pan));
  const nodes=[]; let pk=0.2, rel=0.5, atk=0.004;
  if(kind==='bell'){ const o=ctx.createOscillator(), md=ctx.createOscillator(), mg=ctx.createGain(); o.type='sine'; o.frequency.value=f; md.frequency.value=f*3.5; mg.gain.setValueAtTime(f*2.2*vel,t); mg.gain.exponentialRampToValueAtTime(f*0.01,t+0.4); md.connect(mg); mg.connect(o.frequency); nodes.push(o,md); o.connect(g); pk=0.2; rel=1.1; }
  else if(kind==='pluck'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), lp=ctx.createBiquadFilter(); o.type='sawtooth'; o2.type='square'; o.frequency.value=f; o2.frequency.value=f*1.004; lp.type='lowpass'; lp.Q.value=4; lp.frequency.setValueAtTime(400+5200*vel,t); lp.frequency.exponentialRampToValueAtTime(260,t+0.22); const g2=ctx.createGain(); g2.gain.value=0.4; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2); pk=0.2; rel=0.25; }
  else if(kind==='lead'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), vib=ctx.createOscillator(), vg=ctx.createGain(), lp=ctx.createBiquadFilter(); o.type='triangle'; o2.type='square'; o.frequency.value=f; o2.frequency.value=f*2; vib.frequency.value=5.5; vg.gain.value=f*0.006; vib.connect(vg); vg.connect(o.frequency); lp.type='lowpass'; lp.frequency.value=3200; const g2=ctx.createGain(); g2.gain.value=0.12; o.connect(lp); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2,vib); pk=0.28; rel=0.5; atk=0.01; }
  else if(kind==='bass'){ const o=ctx.createOscillator(), o2=ctx.createOscillator(), lp=ctx.createBiquadFilter(); o.type='sine'; o2.type='sawtooth'; o.frequency.value=f; o2.frequency.value=f; lp.type='lowpass'; lp.frequency.setValueAtTime(900,t); lp.frequency.exponentialRampToValueAtTime(180,t+len); const g2=ctx.createGain(); g2.gain.value=0.25; o.connect(g); o2.connect(g2); g2.connect(lp); lp.connect(g); nodes.push(o,o2); pk=0.34; rel=0.12; }
  else if(kind==='pad'){ [0,-7,7].forEach(d=>{ const o=ctx.createOscillator(); o.type='sawtooth'; o.frequency.value=f; o.detune.value=d; const lp=ctx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=1100; o.connect(lp); lp.connect(g); nodes.push(o); }); pk=0.05; rel=1.4; atk=0.25; }
  pk*=0.4+0.6*vel;
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(pk,t+atk); g.gain.setValueAtTime(pk*(kind==='pad'?1:0.6),t+Math.max(atk,len)); g.gain.exponentialRampToValueAtTime(0.0001,t+Math.max(atk,len)+rel);
  g.connect(p); p.connect(bus||sfx); if(kind!=='bass'){ p.connect(wet); if(kind!=='pad') p.connect(out._send); }
  nodes.forEach(n=>{ n.start(t); n.stop(t+Math.max(atk,len)+rel+0.05); });
}
function nz(d){ const b=ctx.createBuffer(1,Math.max(1,ctx.sampleRate*d),ctx.sampleRate),x=b.getChannelData(0); for(let i=0;i<x.length;i++) x[i]=Math.random()*2-1; const s=ctx.createBufferSource(); s.buffer=b; return s; }
function env(g,t,pk,dec){ g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(pk,t+0.002); g.gain.exponentialRampToValueAtTime(0.0001,t+dec); }
function drum(k,{t,vel=0.8,bus}={}){
