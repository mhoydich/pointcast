      txt(`${dailyStreak}-day streak`,W/2,372,{size:26,weight:800,color:'#9fe3c9'}); txt(dailyStreak>1?'come back tomorrow to keep it going':'come back tomorrow for a new song',W/2,404,{size:13,weight:500,font:'mono',color:'rgba(244,240,255,.6)'}); }
