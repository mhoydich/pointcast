  const land=balls.find(b=>!b.landing&&b.vy>0&&b.y>DECK_TOP-40);
  if(land){ const k=ROWS[1+Math.floor(Math.random()*3)].codes.reduce((a,c)=>Math.abs(cell[c].cx-land.x)<Math.abs(cell[a].cx-land.x)?c:a); fire(k,true); return; }
  if(balls.length<5){ const tg=targets[tIdx]; const pool=tg?[tg]:[...bricks.keys()]; const tc=pool[Math.floor(Math.random()*pool.length)]; if(!tc) return; const x=cell[tc].cx; const k=ROWS[1].codes.reduce((a,c)=>Math.abs(cell[c].cx-x)<Math.abs(cell[a].cx-x)?c:a); fire(k,true); }
  if(breakable()===0) loadLevel(DAILY?DAILY_LVL:(lvlI+1)%LEVELS.length,{build:true});
}

