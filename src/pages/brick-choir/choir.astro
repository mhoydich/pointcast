      txt(ATTRACT?'':'PRESS ANY KEY',W/2,430,{size:22,weight:700,font:'mono',color:'#ffd27a',alpha:fade*((Math.floor(T/500)%2)?1:0.25)}); }
    else if(attractPanel===0){ panel(170,150,660,300); logo(T,250); txt('a keyboard instrument that is also an arcade game',W/2,318,{size:18,weight:500,color:'rgba(244,240,255,.8)'});
      txt('PRESS ANY KEY',W/2,392,{size:22,weight:700,font:'mono',color:'#ffd27a',alpha:fade*((Math.floor(T/500)%2)?1:0.25)}); txt('FREE PLAY  ·  © 2026 POINTCAST',W/2,428,{size:12,weight:500,font:'mono',color:'rgba(244,240,255,.5)'}); }
    else if(attractPanel===1){ panel(150,120,700,360); txt('HOW TO PLAY',W/2,160,{size:26,weight:800,color:'#ffd27a'});
      [['any key','fires a ball of light from its own spot'],['every hit','is a note — you can’t play a wrong one'],['glowing brick','hit it to play the next note of the song'],['behind the wall','the ball plays a run all by itself'],['falling ball','press the lit key under it to send it back'],['1 – 0','drum beams straight up the column']].forEach(([a,b],i)=>{ const y=212+i*42; const c=`oklch(84% 0.13 ${i*55+300})`; g.fillStyle=c; rr(230,y-15,150,30,15); g.fill(); txt(a,305,y+1,{size:14,weight:700,font:'mono',color:'#140f28'}); txt(b,400,y,{size:17,weight:500,align:'left'}); }); }
    else if(attractPanel===2){ panel(170,130,660,340); txt('THE CAST',W/2,170,{size:26,weight:800,color:'#ffd27a'});
      [['TERRA','the builder','GPT-5.6 Terra',150],['SONNET','the poet','Claude Sonnet',300],['ASTRA','the spell','GPT-6 Astra',60],['YOU','the choir','the whole keyboard',200]].forEach(([n,r,m,h],i)=>{ const y=230+i*56; const show=(T-attractT)>i*500; if(!show) return; orb(250,y,11,h,T); txt(n,290,y-6,{size:22,weight:800,align:'left',color:`hsl(${h} 90% 80%)`}); txt(`"${r}"`,450,y-6,{size:18,weight:500,align:'left'}); txt(m,290,y+16,{size:12,weight:500,font:'mono',align:'left',color:'rgba(244,240,255,.5)'}); }); }
    else { panel(230,90,540,440); scoresTable(T,130); }
    g.globalAlpha=1;
  } else if(state==='ready'){
    drawWorld(T); g.setTransform(DPR*S,0,0,DPR*S,DPR*OX,DPR*OY);
    const p=SP(2600); const slide=Math.min(1,p*3);
    txt(DAILY?`TODAY'S SONG · ${utcDay()}`:`ROUND ${lvlI+1}`,W/2-(1-slide)*600,330,{size:20,weight:700,font:'mono',color:'#9fe3c9'});
    txt(lvl.title,W/2+(1-slide)*600,372,{size:46,weight:800});
    txt(`by ${lvl.architect} · ${MODELS[lvl.architect]||''} · ${NAMES[lvl.root]} ${lvl.scale.replace('pent',' pentatonic').replace('maj','major').replace('min','minor')}`,W/2,410,{size:13,weight:500,font:'mono',color:'rgba(244,240,255,.6)',alpha:slide});
    if(p>0.62) txt(p<0.9?'READY!':'PLAY!',W/2,460,{size:34,weight:800,color:p<0.9?'#ffd27a':'#ff8fb1'});
    if(p>=1){ setState('play'); songEnd=now()+songLen; seqT=0; }
  } else if(state==='play'){
    drawWorld(T);
  } else if(state==='clear'||state==='short'){
