function panel(x,y,w,h){ g.fillStyle='rgba(12,10,30,.82)'; rr(x,y,w,h,22); g.fill(); g.strokeStyle='rgba(255,255,255,.12)'; g.stroke(); }
function logo(T,y,scale=1){
