    panel(250,250,500,200);
    if(state==='clear'){ txt(verse?`${verse} VERSE${verse>1?'S':''} SUNG!`:'SONG COMPLETE',W/2,300,{size:36,weight:800,color:'#ffd27a'}); txt(clearBonus?`song bonus  +${Math.round(clearBonus*Math.min(1,p*2)).toLocaleString()}`:`${notesPlayed} notes so far`,W/2,346,{size:18,weight:600,font:'mono'}); txt(LINES[lvlI%Math.max(1,LINES.length)]||lvl.line,W/2,396,{size:17,weight:500,color:'rgba(244,240,255,.8)'}); }
    else { txt('THE SONG ENDED',W/2,300,{size:34,weight:800,color:'#ff8fb1'}); txt(`${breakable()} bricks still singing — one heart lost`,W/2,346,{size:16,weight:600,font:'mono'}); txt(hearts>0?'on to the next one':'',W/2,396,{size:16,weight:500,color:'rgba(244,240,255,.7)'}); }
