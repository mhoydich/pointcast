function toAttract(){ setState('attract'); attractPanel=0; attractT=now(); loadLevel(DAILY?DAILY_LVL:0,{build:true}); myRec=null; published=null; seqT=0; shareBar(false); boardMode=BOARDS[0]; }

/* ================= input ================= */
addEventListener('keydown',e=>{
  if(e.metaKey||e.ctrlKey||e.altKey||ATTRACT) return;
  const code=e.code;
  if(shareOpen){ if(code==='Escape') closeShare(); return; }
  if(state==='attract'){ e.preventDefault(); if(attractPanel===3&&(code==='ArrowLeft'||code==='ArrowRight')){ toggleBoard(code==='ArrowLeft'?-1:1); attractT=now(); return; } boot(); startGame(); return; }
  if(state==='initials'){ e.preventDefault(); if(code==='Backspace'){ entry=entry.slice(0,-1); return; } if(code==='Enter'){ submitScore((entry+'???').slice(0,3).replace(/\?/g,'-')); return; } if(/^[A-Za-z0-9]$/.test(e.key)&&entry.length<3){ entry+=e.key.toUpperCase(); if(ctx) tone(64+entry.length*4,{kind:'lead',len:0.08}); } return; }
  if(state==='over'){ e.preventDefault(); if(SP2()<900) return; if(code==='KeyS'||code==='KeyP'){ openShare(); return; } shareBar(false); if(qualifies()){ entry=''; setState('initials'); } else { setState('scores'); } return; }
  if(state==='scores'){ e.preventDefault(); if(code==='ArrowLeft'||code==='ArrowRight'){ toggleBoard(code==='ArrowLeft'?-1:1); stateT=now(); return; } toAttract(); return; }
  if(state==='inter'){ if(SP2()>1000){ beginRound(lvlI+1); } e.preventDefault(); return; }
  if(code==='Escape'){ e.preventDefault(); if(state==='play'){ setState('paused'); pausedLeft=songEnd-now(); } else if(state==='paused'){ setState('play'); songEnd=now()+pausedLeft; seqT=0; } return; }
  if(state!=='play') return;
  if(e.repeat){ if(cell[code]) e.preventDefault(); return; }
  if(cell[code]){ e.preventDefault(); boot(); heldKeys.add(code); fire(code); }
});
let pausedLeft=0; const SP2=()=>now()-stateT;
addEventListener('keyup',e=>heldKeys.delete(e.code));
addEventListener('blur',()=>{ heldKeys.clear(); if(state==='play'){ setState('paused'); pausedLeft=songEnd-now(); } });
// touch / mouse: tap anywhere in the playfield fires from the nearest key; tap the deck to press that key
cv.addEventListener('pointerdown',e=>{
  if(ATTRACT||shareOpen) return;
  boot(); const x=(e.clientX-OX)/S, y=(e.clientY-OY)/S;
  const onBoardTitle=boardHit&&Math.abs(y-boardHit.y)<22&&Math.abs(x-W/2)<260;
  if(state==='attract'){ if(attractPanel===3&&onBoardTitle){ toggleBoard(x<W/2?-1:1); attractT=now(); return; } startGame(); return; }
  if(state==='scores'&&onBoardTitle){ toggleBoard(x<W/2?-1:1); stateT=now(); return; }
  if(state==='over'||state==='scores'||state==='inter'){ window.dispatchEvent(new KeyboardEvent('keydown',{code:'Space',key:' '})); return; }
  if(state==='initials'){ submitScore((entry+'---').slice(0,3)); return; }
  if(state!=='play') return;
  let best=null,bd=1e9; const rows = y>=DECK_TOP ? [Math.max(0,Math.min(3,Math.floor((y-DECK_TOP-8)/DECK_ROW)))] : [1];
  rows.forEach(ri=>ROWS[ri].codes.forEach(code=>{ const d=Math.abs(cell[code].cx-x)+(y>=DECK_TOP?Math.abs(cell[code].dy+14-y):0); if(d<bd){ bd=d; best=code; } }));
  if(best){ heldKeys.add(best); fire(best); setTimeout(()=>heldKeys.delete(best),200); }
});
document.getElementById('snd').onclick=e=>{ boot(); muted=!muted; if(out) out.gain.value=muted?0:0.8; e.currentTarget.textContent=muted?'sound off':'sound on'; e.currentTarget.setAttribute('aria-pressed',String(!muted)); e.currentTarget.blur(); };
document.getElementById('fs').onclick=e=>{ e.currentTarget.blur(); if(document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen?.(); };

if(Q.has('bot')) window.__bc={get state(){return state;},get score(){return score;},get balls(){return balls;},cell,ROWS,DECK_TOP,get targets(){return targets;},get tIdx(){return tIdx;},get bricks(){return bricks.size;},start:()=>{boot();startGame();},
  endSong:()=>{ songEnd=0; }, over:()=>{ score=score||31337; gameOver(); }, fire, get rally(){return rally;}, get lvlI(){return lvlI;}, get lvl(){return lvl;}, DAILY, DAILY_LVL, dailyPick, get streak(){return streakNow();}, get boardMode(){return boardMode;}, get boards(){return {all:hiGlobal,week:hiWeek,day:hiDay};}, openShare, get published(){return published;}, get songLen(){return songLen;}, get hearts(){return hearts;}, get attractPanel(){return attractPanel;}, set attractPanel(v){attractPanel=v;attractT=now();}};
if(!LEVELS.length){ return; }
loadScores(); toAttract(); requestAnimationFrame(frame);
if(ATTRACT) addEventListener('load',()=>{ try{ parent.postMessage({bc:'ready',game:GAME},'*'); }catch(e){} });
})();
