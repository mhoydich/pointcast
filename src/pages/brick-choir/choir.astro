function fit(){ DPR=Math.min(2,devicePixelRatio||1); cv.width=innerWidth*DPR; cv.height=innerHeight*DPR; const top=innerWidth>700?40:48; S=Math.min(innerWidth/W,(innerHeight-top)/H); OX=(innerWidth-W*S)/2; OY=top+(innerHeight-top-H*S)/2; }
