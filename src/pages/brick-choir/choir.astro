  for(let i=0;i<word.length;i++){ const ch=word[i], w=g.measureText(ch).width; const bob=reduce?0:Math.sin(T/260+i*0.55)*6*scale; const h=(i*28+T*0.04)%360;
    const gr=g.createLinearGradient(x,y-40,x,y+40); gr.addColorStop(0,`oklch(90% 0.1 ${h})`); gr.addColorStop(1,`oklch(72% 0.17 ${(h+60)%360})`);
