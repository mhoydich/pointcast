---
// /brick-choir/choir — Brick Choir 3. An arcade game that is really an instrument: every key fires a ball of light
// from its own spot, every hit is a note, the glowing brick plays the song, and getting behind the wall
// plays a run by itself. Attract mode, round splashes, intermissions, and a high-score table ("the choir").
// Rounds by the Architects: Terra (GPT-5.6 Terra), Sonnet (Claude Sonnet), Astra (GPT-6 Astra).
// The arcade lobby is /brick-choir; the 2600 edition is /brick-choir/2600; Quartet is /brick-choir/quartet.
// Flags: ?daily=1 → today's song (one 60 s run of a date-picked round, streaks, its own board);
//        ?attract → silent, input-free attract mode for the lobby's cabinet screens.
// Built 2026-09-23 by Claude (Cowork) for Mike; lobby/daily/share added 2026-09-24.
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Brick Choir · PointCast</title>
<meta name="description" content="An arcade game that is really an instrument. Every key fires a ball of light, every hit is a note, and the glowing brick plays the song.">
<meta property="og:title" content="Brick Choir">
<meta property="og:description" content="Every key fires a ball of light. Every hit is a note. Press any key to play.">
<meta property="og:url" content="https://pointcast.xyz/brick-choir/choir">
<meta property="og:type" content="website">
<meta property="og:image" content="https://pointcast.xyz/brick-choir/og3.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0a1a">
<link rel="canonical" href="https://pointcast.xyz/brick-choir/choir">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist+Mono:wght@500;600;700&display=swap">
<style is:inline>
  :root{ --ink:#f4f0ff; --bg:#0b0a1a; --display:"Bricolage Grotesque","Avenir Next",system-ui,sans-serif; --mono:"Geist Mono",ui-monospace,monospace; color-scheme:dark; }
  [hidden]{display:none!important;}
  html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;}
  body{font-family:var(--display);color:var(--ink);-webkit-user-select:none;user-select:none;touch-action:none;}
  canvas#game{position:fixed;inset:0;width:100vw;height:100vh;display:block;}
  .chrome{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:12px;display:flex;gap:8px;z-index:2;}
  .chrome button,.chrome a{font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(244,240,255,.7);background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px 11px;cursor:pointer;text-decoration:none;backdrop-filter:blur(6px);}
  .chrome button:hover,.chrome a:hover{color:#fff;border-color:rgba(255,255,255,.3);}
  .chrome button:focus-visible{outline:2px solid #ffd27a;outline-offset:2px;}
  body.attract .chrome{display:none;}
  /* game-over share bar + share card overlay */
  #shareBar{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:3;display:flex;gap:8px;}
  #shareBar button,#share button,#share a.btn{font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#140f28;background:#ffd27a;border:0;border-radius:999px;padding:10px 18px;cursor:pointer;text-decoration:none;display:inline-block;}
  #shareBar button.ghost,#share button.ghost{background:rgba(255,255,255,.1);color:var(--ink);border:1px solid rgba(255,255,255,.18);}
  #shareBar button:hover,#share button:hover,#share a.btn:hover{filter:brightness(1.08);}
  #share{position:fixed;inset:0;z-index:10;display:grid;place-items:center;background:rgba(6,5,16,.72);backdrop-filter:blur(10px);padding:16px;box-sizing:border-box;}
  #share .card{width:min(640px,100%);background:rgba(16,13,38,.92);border:1px solid rgba(255,255,255,.14);border-radius:24px;padding:18px;box-sizing:border-box;box-shadow:0 30px 80px rgba(0,0,0,.5);animation:pop .3s cubic-bezier(.2,.9,.3,1.2);}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(10px);}}
  #share h2{margin:0 0 10px;font:800 20px var(--display);color:#ffd27a;display:flex;justify-content:space-between;align-items:center;}
  #share h2 small{font:600 11px var(--mono);letter-spacing:.1em;color:rgba(244,240,255,.55);}
  #share img{display:block;width:100%;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:#0b0a1a;aspect-ratio:1200/630;}
  #share .row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center;}
  #share .st{font:600 12px var(--mono);color:#9fe3c9;margin-left:auto;min-height:1em;}
  #share .st a{color:#9fe3c9;}
  @media (max-width:520px){ #share .card{padding:12px;} #share .row{gap:6px;} #share button,#share a.btn{padding:9px 12px;font-size:11px;} #share .st{margin-left:0;width:100%;} }
</style>
</head>
<body>
<canvas id="game" aria-label="Brick Choir — press any key to play"></canvas>
