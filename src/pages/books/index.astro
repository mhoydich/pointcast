---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { readingShelf as books, literaryDoors, shelfThemes } from '../../data/reading-shelf';
const description = 'Twenty reading doors and a map of 87 title records. An original art-rich PointCast reading shelf: compare editions, find new or used copies, borrow through a library, and follow a question into the work.';
const themeNames = new Map(shelfThemes.map((theme) => [theme.id, theme.label]));
---
<BlockLayout title="The PointCast reading shelf" description={description} image="/images/siddhartha/river-horizon.webp" imageWidth={1536} imageHeight={1024} isolated={true} showNetworkStrip={false} themeColor="#163e49" jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:'PointCast reading shelf',url:'https://pointcast.xyz/books/',description,hasPart:books.map(book=>({'@type':'WebPage',name:book.title,url:`https://pointcast.xyz${book.href}`}))}}>
  <div class="bookshop-home" data-bookshelf>
    <header class="masthead"><a class="wordmark" href="/">PointCast <span>The reading shelf</span></a><nav aria-label="PointCast bookshop"><a href="/shop">The shop</a><a href="/">Back to town <span aria-hidden="true">↗</span></a></nav></header>
    <section class="intro" aria-labelledby="shelf-heading"><div><p class="label">Books / Twenty open doors</p><h1 id="shelf-heading">A book.<br />Another world.</h1></div><div class="intro-copy"><p>A small shelf that keeps growing.<br />Find a copy. Find a question.<br />Read at your own pace.</p><a href="#shelf">Explore the shelf <span aria-hidden="true">↓</span></a></div></section>
    <figure class="river-banner"><img src="/images/siddhartha/river-horizon.webp" width="1536" height="1024" alt="An original ultramarine river painting with a thin warm horizon." fetchpriority="high" decoding="async" /><figcaption><span>Begin anywhere.</span><span>Original generated artwork / A river between worlds</span></figcaption></figure>
    <section id="shelf" class="shelf" aria-labelledby="browse-title">
      <div class="section-heading"><div><p class="label">01 / The bookshop</p><h2 id="browse-title">Follow your curiosity.</h2></div><p>Nineteen books, one interview and essay room.<br />Original art, useful editions and reading routes.</p></div>
      <div class="browse-controls" data-shelf-controls hidden><div class="search-row"><label for="shelf-search">Find a title, author or idea</label><div class="search-field"><input id="shelf-search" type="search" data-shelf-search placeholder="Try Hesse, power, adventure…" aria-controls="shelf-list" autocomplete="off" /><button type="button" data-shelf-reset disabled>Clear</button></div></div><div class="theme-controls" role="group" aria-label="Browse books by theme">{shelfThemes.map(theme => <button type="button" data-shelf-theme={theme.id} aria-pressed={theme.id === 'all' ? 'true' : 'false'} aria-controls="shelf-list">{theme.label}</button>)}</div></div>
      <p class="browse-status" data-shelf-status role="status" aria-live="polite" aria-atomic="true">All {books.length} reading doors shown.</p>
      <ol id="shelf-list" class="book-grid">{books.map((book,i) => <li class={`book-card tone-${book.tone}`} data-shelf-book={book.id} data-shelf-search={`${book.title} ${book.author} ${book.kind} ${book.note} ${book.themes.map(theme=>`${theme} ${themeNames.get(theme)||''}`).join(' ')}`} data-shelf-themes={book.themes.join(' ')}><a href={book.href}><div class="book-art"><img src={book.image} width="1536" height="1024" alt="" loading="lazy" decoding="async" /><span class="book-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span></div><div class="book-copy"><p class="label">{book.kind} / {book.firstPublished}</p><h3>{book.title}</h3><p class="book-author">{book.author}</p><p class="book-note">{book.note}</p><span class="book-open">Open the companion <span aria-hidden="true">↗</span></span></div></a></li>)}</ol>
      <p class="empty-state" data-shelf-empty hidden>No books match this search and theme. Clear the filters to begin again.</p>
    </section>
    <section class="map-door" aria-labelledby="map-door-title"><div><p class="label">An atlas of reading / 87 title records</p><h2 id="map-door-title">The next book is a connection.</h2><p>Follow a path through imagined worlds, money, memory, language and ideas. A reviewed Goodreads snapshot becomes an editorial map; title records link to their catalog, while selected works open into full companions.</p></div><a href="/books/map/">Explore the reading map <span aria-hidden="true">↗</span></a></section>
    <section class="reading-paths" aria-labelledby="paths-title"><div class="section-heading"><div><p class="label">02 / Across the shelf</p><h2 id="paths-title">Keep a thread.</h2></div><p>Our editorial connections.<br />A route, rather than a ranking.</p></div><div class="path-grid"><article><p class="label">Power / Who gets to decide?</p><h3>What ambition costs.</h3><p>Begin with the real financial worlds of <a href="/books/den-of-thieves/">Den of Thieves</a> and <a href="/books/barbarians-at-the-gate/">Barbarians at the Gate</a>. Then shift into the invented empire of <a href="/books/mistborn-the-final-empire/">Mistborn</a>. Notice how each book makes power visible.</p></article><article><p class="label">Place / What makes a life?</p><h3>Begin with a place.</h3><p>Carry one question from the winter landscape of <a href="/books/ethan-frome/">Ethan Frome</a> into the memories of <a href="/books/the-kite-runner/">The Kite Runner</a> and the river of <a href="/siddhartha/">Siddhartha</a>: how does a place change what a person can imagine?</p></article></div></section>
    <section class="literary-doors" aria-labelledby="doors-title"><div><p class="label">03 / Another kind of room</p><h2 id="doors-title">Stay with the voice.</h2><p>Elsewhere in PointCast: a literary tribute.</p></div>{literaryDoors.map(door => <a class="literary-card" href={door.href}><img src={door.image} width="1536" height="1024" alt="" loading="lazy" decoding="async" /><div><p class="label">{door.label}</p><h3>{door.title}</h3><p>{door.note}</p><span>Enter the room <span aria-hidden="true">↗</span></span></div></a>)}</section>
    <footer><div><p class="label">A reading shelf / An independent resource</p><p>Outside sellers and libraries handle purchases and loans. Confirm edition, condition, price, stock, eligibility and waits with the destination. PointCast holds no inventory, takes no orders and receives no commission from these links.</p></div><div><p>Original generated artwork creates an atmosphere for each book. It is not publisher cover art, an author’s artwork or a photograph of a documented event. Each companion links its edition evidence and explains its reading rights.</p><a href="/books.json">Shelf and source routes as JSON <span aria-hidden="true">↗</span></a></div></footer>
  </div>
</BlockLayout>
<script>
  import { mountBookshelf } from '../../lib/bookshelf-browser.mjs';
  document.querySelectorAll<HTMLElement>('[data-bookshelf]').forEach(mountBookshelf);
</script>
<style is:global>body:has(.bookshop-home){background:#f3f3ed;padding-bottom:0!important}</style>
<style>
  .bookshop-home{--ink:#163e49;--muted:#53686b;--line:#aabbb8;--accent:#8c411e;max-width:1600px;margin:auto;color:var(--ink);background:#f3f3ed;font:400 1rem/1.65 var(--pc-font-sans)}
  .bookshop-home *{box-sizing:border-box}.bookshop-home :global([hidden]){display:none!important}.bookshop-home a{color:inherit;text-underline-offset:.25em}.bookshop-home a:focus-visible,.bookshop-home button:focus-visible,.bookshop-home input:focus-visible{outline:3px solid var(--accent);outline-offset:5px}p,h1,h2,h3,figure{margin:0}.label{font:400 .8125rem/1.6 var(--pc-font-mono);text-transform:uppercase;letter-spacing:.035em}
  .masthead{margin-inline:5%;padding-block:22px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}.wordmark{display:flex;align-items:center;gap:20px;font-size:1.6rem;text-decoration:none;letter-spacing:-.05em;min-height:44px}.wordmark span{font:400 .8125rem var(--pc-font-mono);text-transform:uppercase;letter-spacing:.03em;border-left:1px solid var(--line);padding-left:20px}.masthead nav{display:flex;gap:28px}.masthead nav a{min-height:44px;display:flex;align-items:center;gap:12px;font-size:.875rem;text-decoration:none}
  .intro{padding:58px 5% 44px;display:grid;grid-template-columns:2fr 1fr;gap:48px;align-items:end}.intro h1{font:400 clamp(4rem,7.8vw,8rem)/1 Georgia,serif;letter-spacing:-.055em;margin-top:24px}.intro-copy{padding-bottom:8px}.intro-copy>p{font-size:1.15rem;line-height:1.75}.intro-copy a{display:flex;justify-content:space-between;align-items:center;max-width:300px;min-height:44px;border-bottom:1px solid var(--line);margin-top:25px;text-decoration:none;font-size:.875rem}
  .river-banner{margin:0 5%}.river-banner img{width:100%;height:260px;object-fit:cover;object-position:center 47%;display:block}.river-banner figcaption{display:flex;justify-content:space-between;gap:25px;padding-block:14px;font-size:.8125rem;color:var(--muted)}.river-banner figcaption span:first-child{font:400 1.3rem Georgia,serif;color:var(--ink)}
  .shelf,.reading-paths,.literary-doors{margin:68px 5% 0}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:30px}.section-heading h2,.literary-doors h2{font:400 clamp(2.25rem,4vw,3.65rem)/1.15 Georgia,serif;letter-spacing:-.035em;margin-top:12px}.section-heading>p{font-size:.875rem;color:var(--muted)}
  .browse-controls{padding:25px 0;border-block:1px solid var(--line)}.search-row{display:grid;grid-template-columns:1fr 2fr;align-items:center;gap:24px}.search-row>label{font-size:.9375rem}.search-field{display:flex;gap:14px}.search-field input{font:inherit;min-width:0;width:100%;min-height:48px;padding:10px 15px;color:var(--ink);background:#fffdf4;border:1px solid var(--line);border-radius:0}.search-field button,.theme-controls button{font:inherit;font-size:.875rem;min-height:44px;padding:9px 14px;color:var(--ink);background:transparent;border:1px solid var(--line);cursor:pointer}.search-field button:disabled{opacity:.65;cursor:default}.theme-controls{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.theme-controls button[aria-pressed=true]{color:#f3f3ed;background:var(--ink);border-color:var(--ink)}.theme-controls button:hover{border-color:var(--ink)}.browse-status{font-size:.875rem;color:var(--muted);margin:18px 0}.empty-state{padding:40px 24px;border:1px solid var(--line)}
  .book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:0;margin:0;list-style:none}.book-card{min-width:0}.book-card>a{display:flex;height:100%;flex-direction:column;text-decoration:none;border:1px solid var(--line)}.book-art{aspect-ratio:3/2;position:relative;overflow:hidden}.book-art img{width:100%;height:100%;object-fit:cover;display:block}.book-number{position:absolute;left:14px;bottom:12px;color:#f3f3ed;font:400 1.35rem Georgia,serif;background:#163e49;padding:4px 9px}.book-copy{padding:26px;flex:1;display:flex;flex-direction:column}.book-copy>.label{font-size:.75rem;margin-bottom:19px}.book-copy h3{font:400 clamp(1.9rem,2.5vw,2.7rem)/1.13 Georgia,serif;letter-spacing:-.03em;overflow-wrap:anywhere}.book-author{font-size:.875rem;margin:12px 0 21px}.book-note{margin-bottom:27px;font-size:.9375rem}.book-open{display:flex;justify-content:space-between;align-items:center;min-height:44px;margin-top:auto;border-top:1px solid currentColor;padding-top:13px;font-size:.875rem}.book-card>a:hover .book-open{text-decoration:underline}.tone-midnight{background:#131d27;color:#ede5d5}.tone-parma{background:#fff5e2;color:#8e2d1a}.tone-oxblood{background:#35151c;color:#f6ede2}.tone-sage{background:#e8eee3;color:#25382b}.tone-winter{background:#e5e9ec;color:#25303a}.tone-sea{background:#e6ece5;color:#173e40}.tone-indigo{background:#172544;color:#f7eedf}.tone-ash{background:#23272a;color:#eeeae1}.book-card a:focus-visible{outline-color:#a65a2f}
  .map-door{margin:68px 5% 0;padding:38px;border:1px solid var(--line);background:#e5e9da;display:flex;align-items:end;gap:40px}.map-door>div{max-width:70ch}.map-door h2{font:400 clamp(2rem,3vw,3rem)/1.2 Georgia,serif;margin:12px 0 20px}.map-door>a{display:flex;gap:20px;align-items:center;min-height:44px;flex-shrink:0}.reading-paths{border-top:1px solid var(--line);padding-top:40px}.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}.path-grid article{padding:25px 0;border-top:1px solid var(--line)}.path-grid h3{font:400 2rem/1.2 Georgia,serif;margin:12px 0 20px}.path-grid article>p:last-child{max-width:65ch}
  .literary-doors{display:grid;grid-template-columns:1fr 2fr;gap:40px;align-items:start;border-top:1px solid var(--line);padding-top:40px}.literary-doors>div>p:last-child{margin-top:20px;color:var(--muted);font-size:.875rem}.literary-card{display:grid;grid-template-columns:1fr 1fr;gap:25px;text-decoration:none}.literary-card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.literary-card h3{font:400 2rem/1.15 Georgia,serif;margin:12px 0 15px}.literary-card div>p:not(.label){font-size:.875rem}.literary-card div>span{display:flex;align-items:center;justify-content:space-between;min-height:44px;margin-top:18px;border-bottom:1px solid var(--line);font-size:.875rem}.bookshop-home footer{padding:50px 5%;margin-top:50px;display:grid;grid-template-columns:1fr 1fr;gap:48px;border-top:1px solid var(--line);font-size:.875rem;color:var(--muted)}footer .label{margin-bottom:15px}footer a{display:inline-flex;align-items:center;gap:20px;min-height:44px;margin-top:18px}
  @media(max-width:1050px){.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.book-copy h3{font-size:2.5rem}.literary-doors{grid-template-columns:1fr}.literary-card{max-width:850px}.intro{gap:30px}.intro-copy>p{font-size:1rem}}
  @media(max-width:620px){.map-door{margin-top:42px;padding:23px;display:block}.map-door>a{margin-top:20px;}.masthead{align-items:start;gap:16px}.wordmark{font-size:1.35rem;display:block;line-height:1.5}.wordmark span{display:block;padding:0;border:0;letter-spacing:0;font-size:.6875rem}.masthead nav{gap:14px}.masthead nav a{font-size:.8125rem}.intro{grid-template-columns:1fr;gap:25px;padding-top:36px}.intro h1{font-size:clamp(3.4rem,14vw,5rem)}.intro-copy>p{font-size:1rem}.intro-copy a{max-width:none}.river-banner img{height:190px}.river-banner figcaption{flex-direction:column;gap:6px}.shelf,.reading-paths,.literary-doors{margin-top:42px}.section-heading{display:block}.section-heading>p{margin-top:18px}.search-row{grid-template-columns:1fr;gap:12px}.theme-controls{gap:7px}.theme-controls button{font-size:.8125rem;padding:8px 10px}.book-grid{grid-template-columns:1fr;gap:24px}.book-copy{padding:23px}.book-copy h3{font-size:2.5rem}.path-grid{grid-template-columns:1fr;gap:20px}.literary-card{grid-template-columns:1fr}.literary-card h3{font-size:2.3rem}.bookshop-home footer{grid-template-columns:1fr;gap:25px;margin-top:38px}.section-heading h2,.literary-doors h2{font-size:2.6rem}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
  @media print{.masthead nav,.browse-controls{display:none!important}.book-grid{grid-template-columns:repeat(2,1fr)}.book-card{break-inside:avoid}.bookshop-home{color:#111;background:white}.book-art{max-height:150px}.bookshop-home :global([data-shelf-book][hidden]){display:block!important}}
</style>
