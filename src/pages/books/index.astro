---
import BlockLayout from '../../layouts/BlockLayout.astro';
const books=[{title:'Siddhartha',author:'Hermann Hesse',kind:'A novel / 1922',href:'/siddhartha/',image:'/images/siddhartha/river-horizon.webp',tone:'river',note:'A life in search of itself. Compare translations, follow the river, find a copy.'},{title:'Den of Thieves',author:'James B. Stewart',kind:'Reported nonfiction / 1991',href:'/books/den-of-thieves/',image:'/images/bookshop/den-of-thieves.webp',tone:'midnight',note:'Inside the ambition and financial crime of 1980s Wall Street. Read the record closely.'},{title:'Playing for Pizza',author:'John Grisham',kind:'A novel / 2007',href:'/books/playing-for-pizza/',image:'/images/bookshop/playing-for-pizza.webp',tone:'parma',note:'American football, a second chance and life in Parma. A different sort of Grisham.'}];
const description='Three books, three worlds. An art-rich PointCast reading shelf with verified new, used and library routes and original reader companions.';
---
<BlockLayout title="The PointCast Bookshop" description={description} image="/images/siddhartha/river-horizon.webp" imageWidth={1536} imageHeight={1024} isolated={true} showNetworkStrip={false} themeColor="#133d66" jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:'PointCast Bookshop',url:'https://pointcast.xyz/books/',description,hasPart:books.map(book=>({'@type':'WebPage',name:book.title,url:`https://pointcast.xyz${book.href}`}))}}>
  <div class="bookshop-home"><header><a href="/">POINTCAST</a><nav aria-label="PointCast bookshop"><a href="/shop">The shop</a><a href="/">Back to town</a></nav></header><section class="bookshop-intro"><p>THE READING SHELF / 001</p><h1>A book.<br/>Another world.</h1><div><p>A small shelf for finding a copy and finding your way in.<br/>New, used, borrowed. Read at your own pace.</p><span>Three books / three companions</span></div></section><ol>{books.map((book,i)=><li class={book.tone}><a href={book.href}><div class="bookshop-art"><img src={book.image} width="1536" height="1024" alt="" loading={i===0?'eager':'lazy'} decoding="async"/><span aria-hidden="true">0{i+1}</span></div><div class="bookshop-copy"><p>{book.kind}</p><h2>{book.title}</h2><p class="bookshop-author">{book.author}</p><p>{book.note}</p><span class="bookshop-open">Open the bookshop</span></div></a></li>)}</ol><footer><p>An independent discovery shelf. PointCast holds no stock, takes no orders and makes no availability promises. No paid links on these three shelves. Confirm edition, price, condition and lending eligibility with the destination.</p><p>Original AI-generated artwork accompanies each book; it is not publisher cover art, archival material or a photograph of a documented event. Edition details and sources are linked inside each companion.</p></footer></div>
</BlockLayout>
<style is:global>body:has(.bookshop-home){background:#f7f8f6;padding-bottom:0!important}</style>
<style>
.bookshop-home{max-width:1600px;margin:auto;color:#133d66;background:#f7f8f6;font:400 1rem/1.7 Inter,Arial,sans-serif}.bookshop-home *{box-sizing:border-box}.bookshop-home a{color:inherit;text-underline-offset:4px}.bookshop-home a:focus-visible{outline:3px solid #ab4c13;outline-offset:5px}.bookshop-home header{padding:22px 5%;display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid #bcc8ce}.bookshop-home header>a{font-size:.875rem;font-weight:600;letter-spacing:.07em;text-decoration:none;display:flex;align-items:center}.bookshop-home header nav{display:flex;gap:24px}.bookshop-home nav a{font-size:.875rem;min-height:44px;display:flex;align-items:center}.bookshop-intro{padding:66px 5% 52px}.bookshop-intro>p{font-size:.875rem;letter-spacing:.08em}.bookshop-intro h1{font:400 clamp(3.5rem,7vw,7.5rem)/1.08 Georgia,serif;letter-spacing:-.05em;margin:28px 0}.bookshop-intro>div{display:flex;justify-content:space-between;gap:20px;align-items:end}.bookshop-intro>div>span{font-size:.875rem;color:#485e6c}.bookshop-home ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:0 5%;margin:0;list-style:none}.bookshop-home li{min-width:0}.bookshop-home li>a{display:flex;height:100%;flex-direction:column;text-decoration:none;border:1px solid #bcc8ce}.bookshop-art{height:285px;position:relative;overflow:hidden}.bookshop-art img{width:100%;height:100%;object-fit:cover}.bookshop-art span{position:absolute;left:15px;bottom:12px;color:white;font:400 1.7rem Georgia,serif;background:#133d66;padding:3px 8px}.bookshop-copy{padding:27px;flex:1;display:flex;flex-direction:column}.bookshop-copy>p:first-child{font-size:.875rem;margin:0 0 20px}.bookshop-copy h2{font:400 2.4rem/1.12 Georgia,serif;letter-spacing:-.03em;margin:0}.bookshop-copy .bookshop-author{font-size:.875rem;margin:12px 0 22px}.bookshop-copy>p{margin:0 0 30px}.bookshop-open{font-size:.875rem;text-decoration:underline;text-underline-offset:5px;display:flex;align-items:center;min-height:44px;margin-top:auto}.midnight{background:#131d27;color:#ede5d5}.parma{background:#fff5e2;color:#8e2d1a}.bookshop-home li>a:hover .bookshop-open{text-decoration-thickness:2px}.bookshop-home footer{padding:45px 5%;font-size:.875rem;color:#485e6c;display:grid;grid-template-columns:1fr 1fr;gap:42px}.bookshop-home footer p{margin:0;max-width:600px}@media(max-width:1000px){.bookshop-home ol{grid-template-columns:1fr}.bookshop-home li>a{display:grid;grid-template-columns:1fr 1fr}.bookshop-art{height:100%;min-height:330px}.bookshop-copy h2{font-size:2.5rem}}@media(max-width:620px){.bookshop-home header{align-items:start}.bookshop-home header nav{gap:15px}.bookshop-intro{padding-top:40px}.bookshop-intro>div{flex-direction:column;align-items:start}.bookshop-home li>a{display:flex}.bookshop-art{height:250px;min-height:0}.bookshop-copy{padding:22px}.bookshop-home footer{grid-template-columns:1fr;gap:24px}.bookshop-home ol{gap:24px}.bookshop-home header a{font-size:.8rem}}
</style>
