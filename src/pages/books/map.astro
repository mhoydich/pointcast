---
import BlockLayout from '../../layouts/BlockLayout.astro';
import FullBookshelf from '../../components/FullBookshelf.astro';
const description = 'All 87 verified Goodreads title records as an expandable visual bookshelf, with sourced public reception notes, publication eras and editorial connections.';
---
<BlockLayout title="The PointCast bookshelf & reading map" description={description} isolated={true} showNetworkStrip={false} themeColor="#263f39" alternates={[{type:'application/json',href:'/books/map.json',title:'Full bookshelf metadata and sources'}]} jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:'The PointCast bookshelf & reading map',url:'https://pointcast.xyz/books/map/',description}}>
  <div class="reading-map">
    <header class="map-masthead"><a class="map-wordmark" href="/">PointCast <span>The full bookshelf</span></a><nav aria-label="Bookshelf navigation"><a href="/books/#shelf">Curated companions <span aria-hidden="true">↗</span></a><a href="#beyond-the-shelf">Connections <span aria-hidden="true">↓</span></a></nav></header>
    <section class="map-intro" aria-labelledby="reading-map-title"><p class="eyebrow">A shelf of connections / October 2026</p><h1 id="reading-map-title">Every book.<br />More ways in.</h1><p>A full shelf to open, a question to carry,<br />and a source behind each public signal.</p></section>
    <FullBookshelf />
  </div>
</BlockLayout>
<style is:global>body:has(.reading-map){background:#f4f3eb;padding-bottom:0!important}</style>
<style>
  .reading-map{max-width:1480px;margin:auto;background:#f4f3eb;color:#263f39;font:400 1rem/1.65 var(--pc-font-sans,Arial,sans-serif)}.reading-map *{box-sizing:border-box;min-width:0}.reading-map a{color:inherit;text-underline-offset:.2em}.reading-map a:focus-visible{outline:3px solid #925326;outline-offset:5px}p,h1{margin:0}.map-masthead{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-inline:6%;padding:22px 0;border-bottom:1px solid #b7c4b4}.map-wordmark{display:flex;gap:22px;align-items:center;min-height:44px;font-size:1.6rem;letter-spacing:-.05em;text-decoration:none}.map-wordmark span{border-left:1px solid #b7c4b4;padding-left:22px;font:400 .7rem var(--pc-font-mono,monospace);letter-spacing:.025em;text-transform:uppercase}.map-masthead nav{display:flex;gap:25px}.map-masthead nav a{display:flex;align-items:center;gap:12px;min-height:44px;font-size:.8125rem;text-decoration:none}.map-intro{padding:58px 6% 0}.eyebrow{font:400 .75rem var(--pc-font-mono,monospace);text-transform:uppercase;letter-spacing:.03em}.map-intro h1{font:400 clamp(3.5rem,7vw,7.2rem)/1.04 Georgia,serif;letter-spacing:-.055em;margin:25px 0}.map-intro>p:last-child{font:400 1.25rem/1.5 Georgia,serif;color:#52655b}
  @media(max-width:650px){.map-masthead{align-items:start;margin-inline:5%;gap:15px}.map-wordmark{display:block;font-size:1.4rem;line-height:1.5}.map-wordmark span{display:block;border:0;padding:0;font-size:.6rem}.map-masthead nav{display:block}.map-masthead nav a{gap:8px;font-size:.75rem}.map-intro{padding:36px 5% 0}.map-intro h1{font-size:clamp(3.2rem,12vw,5rem)}.map-intro>p:last-child{font-size:1.1rem}}
</style>
