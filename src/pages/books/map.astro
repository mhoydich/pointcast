---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { readingShelf } from '../../data/reading-shelf';
import { readingMapThemes, readingMapProvenance, readingMapWithCompanions, readingMapPathsFor } from '../../data/reading-map';

const records = readingMapWithCompanions(readingShelf);
const companionCount = records.filter((record) => record.companion).length;
const themes = readingMapThemes.map((theme) => ({ ...theme, count: records.filter((record) => record.theme === theme.id).length }));
const themeNames = new Map(themes.map((theme) => [theme.id, theme.label]));
const paths = readingMapPathsFor(records);
const description = 'A quiet reading map of 87 Goodreads title records, arranged into original editorial connections with a searchable title and author list.';
const glyphs = [
  { path: 'M12 43 53 13 97 34 149 10 M53 13 76 53 97 34', points: [[12,43],[53,13],[97,34],[149,10],[76,53]] },
  { path: 'M12 29 Q56 2 86 30 T150 29 M48 15 63 54 114 46 127 15', points: [[12,29],[48,15],[63,54],[86,30],[114,46],[127,15],[150,29]] },
  { path: 'M10 47 38 34 67 12 95 33 150 24 M67 12 105 53', points: [[10,47],[38,34],[67,12],[95,33],[105,53],[150,24]] },
  { path: 'M13 42 Q54 6 98 36 T150 16 M52 22 67 51 98 36', points: [[13,42],[52,22],[67,51],[98,36],[150,16]] },
  { path: 'M12 36 56 36 91 14 146 31 M56 36 82 55 116 46', points: [[12,36],[56,36],[91,14],[146,31],[82,55],[116,46]] },
  { path: 'M12 29 51 9 102 17 147 45 88 53 45 40 12 29 M51 9 88 53 102 17 M45 40 102 17', points: [[12,29],[51,9],[102,17],[147,45],[88,53],[45,40]] },
  { path: 'M18 38 48 19 M111 42 142 24', points: [[18,38],[48,19],[111,42],[142,24]] },
];
---
<BlockLayout title="The PointCast reading map" description={description} isolated={true} showNetworkStrip={false} themeColor="#243e38" alternates={[{type:'application/json',href:'/books/map.json',title:'Reading map metadata'}]} jsonLd={{'@context':'https://schema.org','@type':'CollectionPage',name:'The PointCast reading map',url:'https://pointcast.xyz/books/map/',description}}>
  <div class="reading-map" data-reading-map>
    <header class="map-masthead"><a class="map-wordmark" href="/">PointCast <span>The reading map</span></a><nav aria-label="Reading map navigation"><a href="/books/">The reading shelf <span aria-hidden="true">↗</span></a><a href="#reading-records">All titles <span aria-hidden="true">↓</span></a></nav></header>
    <section class="map-intro" aria-labelledby="reading-map-title"><div><p class="eyebrow">A shelf of connections / October 2026</p><h1 id="reading-map-title">Every book.<br />A possible thread.</h1></div><div class="opening-copy"><p>Begin with a question.<br />Follow it into another world.</p><p class="map-tally"><strong>{records.length}</strong> title records<br /><strong>{companionCount}</strong> curated companions linked</p></div></section>

    <section class="map-section" aria-labelledby="constellation-title">
      <div class="section-heading"><div><p class="eyebrow">01 / Choose a direction</p><h2 id="constellation-title">Questions, in company.</h2></div><p>Seven ways across the titles.<br />Our editorial connections, rather than a ranking.</p></div>
      <figure class="constellation-figure">
        <svg class="connecting-lines" viewBox="0 0 1200 560" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M155 118 Q390 32 600 128 T1040 112 M172 135 Q142 340 236 369 M601 138 Q475 240 627 381 M1035 121 Q1077 275 1000 367 M223 363 Q451 482 630 382 T1009 364 M627 390 Q610 447 600 505" /><circle cx="379" cy="92" r="3"/><circle cx="814" cy="143" r="3"/><circle cx="433" cy="423" r="3"/><circle cx="847" cy="391" r="3"/></svg>
        <div class="constellations" role="group" aria-label="Choose an editorial reading theme">
          {themes.map((theme, index) => <article class={`constellation cluster-${theme.color}`}>
            <svg class="cluster-glyph" viewBox="0 0 160 64" aria-hidden="true" focusable="false"><path d={glyphs[index].path}/>{glyphs[index].points.map(([cx,cy],node) => <circle cx={cx} cy={cy} r={node === 1 ? 4.5 : 2.5}/>)}</svg>
            <h3><span class="theme-static" data-map-static><span>{theme.label}</span><small>{theme.count} titles</small></span><button class="theme-button" type="button" data-map-theme={theme.id} data-map-label={theme.label} aria-controls="reading-records" aria-pressed="false" hidden><span>{theme.label}</span><small>{theme.count} titles</small></button></h3>
            <p class="theme-question">{theme.question}</p><p class="theme-note">{theme.note}</p>
          </article>)}
        </div>
        <figcaption>A thematic constellation. The lines suggest connections; the counts show title records in each group.</figcaption>
      </figure>
    </section>

    <section class="map-paths" aria-labelledby="map-paths-heading">
      <div class="section-heading"><div><p class="eyebrow">02 / A few possible crossings</p><h2 id="map-paths-heading">Carry a question.</h2></div><p>Three optional editorial reading paths.<br />Follow a connection at your own pace.</p></div>
      <div class="path-grid">{paths.map((path) => <article><p class="eyebrow">{path.label}</p><h3>{path.question}</h3><ol aria-label={`${path.label} reading path`}>{path.records.map((record,index) => <li><span class="path-number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span><div><a href={record.href}>{record.title} <span aria-hidden="true">↗</span></a><p>{record.author}<span class="path-destination">{record.destination === 'companion' ? 'Curated companion' : 'Book catalog record'}</span></p></div></li>)}</ol></article>)}</div>
    </section>

    <section class="title-section" aria-labelledby="title-list-heading">
      <div class="section-heading"><div><p class="eyebrow">03 / The full snapshot</p><h2 id="title-list-heading">Find your next thread.</h2></div><p>Title and author metadata.<br />Companions appear where we have curated a door.</p></div>
      <div class="map-controls" data-map-controls hidden>
        <div class="search-row"><label for="reading-map-search">Find a title or author</label><div class="search-field"><input id="reading-map-search" type="search" data-map-search aria-controls="reading-records" placeholder="Try Hesse, Tolkien, a title…" autocomplete="off"/><button type="button" class="reset-button" data-map-reset disabled>Reset all</button></div></div>
        <div class="filter-summary"><button type="button" class="all-button" data-map-theme="all" data-map-label="All titles" aria-controls="reading-records" aria-pressed="true" hidden>All {records.length} titles</button><p>The theme above and your search work together.</p></div>
      </div>
      <p class="map-status" data-map-status role="status" aria-live="polite" aria-atomic="true">All {records.length} title records shown.</p>
      <noscript><p class="no-script-note">All titles are listed below. Use your browser’s find command to look for a title or author.</p></noscript>
      <ol class="reading-records" id="reading-records">
        {records.map((record) => <li id={`reading-${record.id}`} data-map-record={record.id} data-map-search={`${record.title} ${record.author}`} data-map-group={record.theme}>
          <p class="record-theme">{themeNames.get(record.theme)}</p>
          <h3><a href={record.bookUrl}>{record.title}</a></h3><p class="record-author">{record.author}</p>
          <div class="record-links"><a class="catalog-link" href={record.bookUrl}>Book catalog record <span aria-hidden="true">↗</span></a>{record.companion && <a class="companion-link" href={record.companion.href}>Open companion <span aria-hidden="true">↗</span><span class="visually-hidden"> for {record.title}</span></a>}</div>
        </li>)}
      </ol>
      <p class="map-empty" data-map-empty hidden>No title records match this search and theme. Reset all to see the whole snapshot.</p>
    </section>

    <footer class="map-footer"><div><p class="eyebrow">Where the titles came from</p><p>{readingMapProvenance}</p></div><div><p>Each title links to its Goodreads book catalog record. A companion link opens an independently curated PointCast resource. Groupings are invitations to read across a question; a title can have many other connections.</p><a href="/books/map.json">Map metadata as JSON <span aria-hidden="true">↗</span></a></div></footer>
  </div>
</BlockLayout>
<script>
  import { mountReadingMap } from '../../lib/reading-map-browser.mjs';
  const enhanceMaps = () => document.querySelectorAll<HTMLElement>('[data-reading-map]').forEach(mountReadingMap);
  enhanceMaps();
  document.addEventListener('astro:page-load', enhanceMaps);
</script>
<style is:global>body:has(.reading-map){background:#f4f3eb;padding-bottom:0!important}</style>
<style>
  .reading-map{--ink:#243e38;--muted:#58685f;--line:#b6c2b5;--paper:#f4f3eb;--accent:#805026;max-width:1480px;margin:auto;background:var(--paper);color:var(--ink);font:400 1rem/1.65 var(--pc-font-sans,Arial,sans-serif)}
  .reading-map *{box-sizing:border-box;min-width:0}.reading-map :global([hidden]){display:none!important}p,h1,h2,h3,figure{margin:0}.reading-map a{color:inherit;text-underline-offset:.25em}.reading-map a:focus-visible,.reading-map button:focus-visible,.reading-map input:focus-visible{outline:3px solid var(--accent);outline-offset:5px}.eyebrow{font:400 .8125rem/1.6 var(--pc-font-mono,monospace);letter-spacing:.025em;text-transform:uppercase}
  .map-masthead{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-inline:6%;padding-block:22px;border-bottom:1px solid var(--line)}.map-wordmark{display:flex;align-items:center;gap:22px;min-height:44px;text-decoration:none;font-size:1.6rem;letter-spacing:-.05em}.map-wordmark span{padding-left:22px;border-left:1px solid var(--line);font:400 .75rem var(--pc-font-mono,monospace);text-transform:uppercase;letter-spacing:.035em}.map-masthead nav{display:flex;gap:26px}.map-masthead nav a{display:flex;align-items:center;gap:12px;min-height:44px;text-decoration:none;font-size:.875rem}
  .map-intro{display:grid;grid-template-columns:2fr 1fr;align-items:end;gap:50px;padding:66px 6% 60px}.map-intro h1{margin-top:25px;font:400 clamp(3.5rem,7vw,7.2rem)/1.04 Georgia,serif;letter-spacing:-.055em}.opening-copy{padding-bottom:6px}.opening-copy>p:first-child{font:400 1.5rem/1.5 Georgia,serif;letter-spacing:-.02em}.map-tally{margin-top:28px;font-size:.875rem;color:var(--muted);line-height:1.9}.map-tally strong{color:var(--ink);font-weight:500;font-variant-numeric:tabular-nums}
  .map-section,.title-section{margin-inline:6%}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:36px;margin-bottom:30px}.section-heading h2{font:400 clamp(2.1rem,3.5vw,3.35rem)/1.15 Georgia,serif;letter-spacing:-.035em;margin-top:12px}.section-heading>p{color:var(--muted);font-size:.875rem;max-width:37ch}
  .constellation-figure{position:relative;border:1px solid var(--line);background:#f8f7ef;overflow:hidden}.connecting-lines{position:absolute;inset:18px 2% auto;width:96%;height:calc(100% - 66px);fill:var(--line);stroke:#c2cbbd;stroke-width:1;pointer-events:none}.connecting-lines path{fill:none;stroke-dasharray:3 8}.constellations{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:6%;row-gap:44px;padding:40px 5% 32px}.constellation{--cluster:#65806b;position:relative}.cluster-ochre{--cluster:#9a6b37}.cluster-ink{--cluster:#365953}.cluster-glyph{display:block;width:160px;height:64px;margin-bottom:14px;color:var(--cluster)}.cluster-glyph path{fill:none;stroke:currentColor;stroke-width:1}.cluster-glyph circle{fill:currentColor;stroke:#f8f7ef;stroke-width:1}.constellation h3{font:400 1.6rem/1.25 Georgia,serif;letter-spacing:-.02em}.theme-button,.theme-static{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px 12px;min-height:44px;width:100%;padding:6px 0 9px;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;color:var(--ink);font:inherit;text-align:left}.theme-button{cursor:pointer}.theme-button small,.theme-static small{font:400 .75rem/1.5 var(--pc-font-mono,monospace);color:var(--muted);letter-spacing:0;white-space:nowrap}.theme-button:hover{border-bottom-color:var(--ink)}.theme-button[aria-pressed=true]{border-bottom:3px solid var(--ink);padding-bottom:7px}.theme-button[aria-pressed=true]>span{text-decoration:underline;text-underline-offset:.2em}.theme-question{margin-top:13px;font-size:.9375rem}.theme-note{margin-top:7px;font-size:.8125rem;color:var(--muted);max-width:32ch}.constellation:last-child{grid-column:2;max-width:310px}.constellation:last-child .cluster-glyph{height:42px;margin-bottom:8px}.constellation-figure figcaption{position:relative;padding:17px 5%;border-top:1px solid var(--line);font-size:.8125rem;color:var(--muted)}
  .map-paths{margin:60px 6% 0}.path-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.path-grid article{padding-top:24px;border-top:1px solid var(--line)}.path-grid h3{font:400 1.7rem/1.25 Georgia,serif;letter-spacing:-.025em;margin:13px 0 23px;max-width:22ch}.path-grid ol{list-style:none;padding:0;margin:0}.path-grid li{display:grid;grid-template-columns:25px 1fr;gap:13px;margin-top:17px}.path-number{padding-top:9px;font:400 .75rem/1.5 var(--pc-font-mono,monospace);color:var(--muted)}.path-grid li a{display:inline-block;min-height:44px;padding-block:7px;font:400 1.08rem/1.4 Georgia,serif;text-decoration:none;overflow-wrap:anywhere}.path-grid li a:hover{text-decoration:underline}.path-grid li p{font-size:.8125rem;color:var(--muted);margin-top:3px}.path-destination{display:block;margin-top:4px;font-size:.75rem}.title-section{margin-top:72px}.map-controls{border-block:1px solid var(--line);padding:24px 0}.search-row{display:grid;grid-template-columns:1fr 2fr;align-items:center;gap:24px}.search-row>label{font-size:.9375rem}.search-field{display:flex;gap:12px}.search-field input{width:100%;min-height:48px;padding:10px 14px;font:inherit;border:1px solid var(--line);border-radius:0;background:#fffdf5;color:var(--ink)}.reset-button,.all-button{min-height:44px;padding:9px 14px;border:1px solid var(--line);border-radius:0;background:transparent;color:var(--ink);font:inherit;font-size:.875rem;cursor:pointer;white-space:nowrap}.reset-button:disabled{opacity:.65;cursor:default}.all-button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:#fffdf5}.filter-summary{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:18px}.filter-summary p{font-size:.8125rem;color:var(--muted)}.map-status{margin:20px 0 28px;color:var(--muted);font-size:.875rem}.no-script-note{margin:0 0 24px;font-size:.875rem}
  .reading-records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 8%;padding:0;margin:0;list-style:none;scroll-margin-top:30px}.reading-records>li{padding:26px 0 28px;border-top:1px solid var(--line);break-inside:avoid;overflow-wrap:anywhere}.record-theme{font:400 .75rem/1.5 var(--pc-font-mono,monospace);color:var(--muted);margin-bottom:12px}.reading-records h3{font:400 clamp(1.6rem,2.3vw,2rem)/1.22 Georgia,serif;letter-spacing:-.025em}.reading-records h3>a{text-decoration:none}.reading-records h3>a:hover{text-decoration:underline}.record-author{font-size:.875rem;margin-top:13px;color:var(--muted)}.record-links{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:17px}.record-links a{display:inline-flex;gap:10px;align-items:center;min-height:44px;font-size:.8125rem;text-decoration:none}.catalog-link:hover{text-decoration:underline}.companion-link{border-bottom:1px solid var(--ink)}.companion-link:hover{border-bottom-width:2px}.map-empty{padding:30px;border:1px solid var(--line);font-size:.9375rem}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .map-footer{display:grid;grid-template-columns:1fr 1fr;gap:8%;margin:55px 6% 0;padding:35px 0 50px;border-top:1px solid var(--line);font-size:.875rem;color:var(--muted)}.map-footer .eyebrow{margin-bottom:15px;color:var(--ink)}.map-footer a{display:inline-flex;align-items:center;gap:22px;min-height:44px;margin-top:18px}
  @media(max-width:960px){.map-intro{gap:28px;grid-template-columns:3fr 2fr}.opening-copy>p:first-child{font-size:1.3rem}.constellations{column-gap:5%;row-gap:32px}.constellation h3{font-size:1.35rem}.theme-button,.theme-static{gap:5px 10px}.cluster-glyph{width:135px}.section-heading{gap:25px}.reading-records{gap:0 6%}}
  @media(max-width:700px){.map-masthead{align-items:start}.map-wordmark{display:block;font-size:1.4rem;line-height:1.5}.map-wordmark span{display:block;border:0;padding:0;font-size:.6875rem;letter-spacing:0}.map-masthead nav{gap:14px}.map-masthead nav a{font-size:.8125rem}.map-intro{grid-template-columns:1fr;padding-top:40px;padding-bottom:42px;gap:25px}.map-intro h1{font-size:clamp(3.3rem,10vw,5rem)}.opening-copy{display:flex;justify-content:space-between;gap:25px;align-items:end}.map-tally{margin:0}.section-heading{display:block}.section-heading>p{margin-top:18px}.constellations{grid-template-columns:repeat(2,minmax(0,1fr));padding:28px 5%;gap:30px 7%}.constellation:last-child{grid-column:auto}.connecting-lines{display:none}.theme-note{font-size:.8125rem}.map-paths{margin-top:42px}.path-grid{grid-template-columns:1fr;gap:26px}.path-grid h3{max-width:none}.title-section{margin-top:45px}.search-row{grid-template-columns:1fr;gap:12px}.reading-records{grid-template-columns:1fr}.reading-records h3{font-size:1.8rem}.map-footer{grid-template-columns:1fr;gap:25px;margin-top:35px}.map-footer>div{max-width:65ch}}
  @media(max-width:440px){.map-masthead{gap:12px}.map-masthead nav{display:block}.map-masthead nav a{min-height:32px}.opening-copy{display:block}.opening-copy>p:first-child{font-size:1.25rem}.map-tally{margin-top:18px}.map-intro h1{font-size:3.1rem}.constellations{grid-template-columns:1fr;gap:24px}.constellation{display:grid;grid-template-columns:1fr;max-width:none}.cluster-glyph{height:48px;margin-bottom:6px}.constellation:last-child{max-width:none}.constellation h3{font-size:1.5rem}.theme-note{max-width:none}.search-field{flex-wrap:wrap}.search-field input{flex:1 1 100%}.reset-button{min-width:100px}.section-heading h2{font-size:2.05rem}.map-empty{padding:22px}}
  @media(prefers-reduced-motion:reduce){.reading-map,.reading-map *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
  @media print{.map-masthead nav,.map-controls,.theme-button,.connecting-lines{display:none!important}.reading-map :global([data-map-static][hidden]){display:flex!important}.reading-map :global([data-map-record][hidden]){display:block!important}.reading-map{color:#111;background:white}.constellation-figure{background:white}.reading-records{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
