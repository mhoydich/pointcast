---
import BlockLayout from '../../layouts/BlockLayout.astro';
import {
  GOOD_WORK,
  GOOD_WORK_MOVEMENTS,
  GOOD_WORK_TRACKS,
  WEDNESDAY_PUBLICATION,
  goodWorkTracksForMovement,
} from '../../lib/wednesday-publication';

const issue = GOOD_WORK;
const publication = WEDNESDAY_PUBLICATION;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicPlaylist',
  '@id': `${issue.canonicalUrl}#playlist`,
  name: issue.displayTitle,
  description: issue.description,
  url: issue.canonicalUrl,
  image: `https://pointcast.xyz${issue.cover}`,
  datePublished: issue.publishedAt,
  numTracks: issue.trackCount,
  author: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  isPartOf: {
    '@type': 'Periodical',
    name: publication.title,
    url: publication.canonicalUrl,
  },
  track: GOOD_WORK_TRACKS.map((track) => ({
    '@type': 'MusicRecording',
    position: track.position,
    name: track.title,
    byArtist: { '@type': 'MusicGroup', name: track.artist },
    duration: `PT${track.duration.replace(':', 'M')}S`,
    url: track.spotifyUrl,
  })),
};
---

<BlockLayout
  title={`${issue.displayTitle} — PointCast`}
  description={issue.description}
  image={`https://pointcast.xyz${issue.cover}`}
  themeColor="#d9ed00"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: issue.jsonRoute, title: `${issue.displayTitle} JSON` },
  ]}
  immersive={true}
  showNetworkStrip={false}
  frame={{
    image: `https://pointcast.xyz${issue.cover}`,
    aspectRatio: '1:1',
    buttons: [
      { label: 'Play on Spotify', action: 'link', target: issue.spotifyUrl },
      { label: 'Open publication', action: 'link', target: publication.canonicalUrl },
      { label: 'Inspect JSON', action: 'link', target: `https://pointcast.xyz${issue.jsonRoute}` },
    ],
  }}
>
  <main class="goodwork" id="main-content">
    <nav class="goodwork__crumb mono" aria-label="Breadcrumb">
      <a href="/">PointCast</a><span>/</span><a href={publication.route}>WEDNESDAY 9:34</a><span>/</span><span>002</span>
    </nav>

    <header class="goodwork__hero">
      <figure>
        <img src={issue.cover} alt={issue.coverAlt} width="1536" height="1536" />
        <figcaption class="mono">ORIGINAL POINTCAST COVER / OPENAI IMAGE GENERATION / POSTER-IMAGE-ENGINE</figcaption>
      </figure>

      <div class="goodwork__intro">
        <div class="goodwork__flag mono">
          <span>WEDNESDAY 9:34</span>
          <span>ISSUE 002</span>
          <span>BLOCK {issue.blockId}</span>
        </div>
        <p class="goodwork__time mono">WED / 9:34 PT / THE BOARD IS REAL</p>
        <h1><span>THE GOOD</span><span>WORK</span></h1>
        <p class="goodwork__dek">{issue.description}</p>
        <blockquote>{issue.editorialNote}</blockquote>

        <div class="goodwork__facts mono" aria-label="Playlist facts">
          <span><b>{issue.trackCount}</b> tracks</span>
          <span><b>{issue.durationMinutes}</b> minutes</span>
          <span><b>04</b> movements</span>
        </div>

        <div class="goodwork__actions">
          <a href={issue.spotifyUrl} target="_blank" rel="noopener">PLAY THE GOOD WORK ↗</a>
          <a href={issue.listeningRoomUrl}>OPEN THE LISTENING ROOM</a>
        </div>
      </div>
    </header>

    <section class="goodwork__player" aria-labelledby="goodwork-player-title">
      <div>
        <p class="mono">PLAYBACK / SPOTIFY</p>
        <h2 id="goodwork-player-title">Start with the blank margin.</h2>
        <p>
          The instrumentals are part of the method. Let them clear the surface.
          By track nine, the list is dancing. By track eighteen, the work has
          returned to the life around it.
        </p>
      </div>
      <div class="goodwork__embed">
        <iframe
          title={`${issue.displayTitle} on Spotify`}
          src={`https://open.spotify.com/embed/playlist/${issue.spotifyPlaylistId}?utm_source=generator`}
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <nav class="goodwork__movement-nav" aria-label="Jump to a playlist movement">
      {GOOD_WORK_MOVEMENTS.map((movement, index) => (
        <button
          type="button"
          data-goodwork-tab={movement.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="mono">{movement.number}</span>
          <strong>{movement.title}</strong>
        </button>
      ))}
    </nav>

    <section class="goodwork__sequence" aria-label="The Good Work track sequence">
      {GOOD_WORK_MOVEMENTS.map((movement) => (
        <article id={`movement-${movement.id}`} data-goodwork-movement={movement.id}>
          <header>
            <span class="mono">{movement.number}</span>
            <div>
              <p class="mono">MOVEMENT {movement.number}</p>
              <h2>{movement.title}</h2>
              <p>{movement.deck}</p>
            </div>
          </header>

          <ol start={movement.positions[0]}>
            {goodWorkTracksForMovement(movement.id).map((track) => (
              <li>
                <a href={track.spotifyUrl} target="_blank" rel="noopener">
                  <span class="goodwork__position mono">{String(track.position).padStart(2, '0')}</span>
                  <span class="goodwork__track">
                    <strong>{track.title}</strong>
                    <small>{track.artist}</small>
                  </span>
                  <span class="goodwork__note">{track.note}</span>
                  <span class="goodwork__duration mono">{track.duration}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </section>

    <section class="goodwork__liner" aria-labelledby="goodwork-liner-title">
      <div>
        <p class="mono">LINER NOTE / WHY THIS ORDER</p>
        <h2 id="goodwork-liner-title">Busy work can still belong to a great life.</h2>
      </div>
      <div>
        <p>
          Issue 001 lifted outward: porch, kitchen, open road, porch again.
          Issue 002 keeps the lift inside the room. It begins with attention
          already available and adds only enough color to keep the small things
          moving.
        </p>
        <p>
          “Found a Job” waits until track sixteen because the job is not the
          premise. The premise is a life with texture, a desk with rhythm, and
          a Wednesday that does not need rescuing.
        </p>
      </div>
    </section>

    <section class="goodwork__next" aria-labelledby="goodwork-next-title">
      <div>
        <p class="mono">THE PUBLICATION / NEXT WEDNESDAY 9:34</p>
        <h2 id="goodwork-next-title">This is Issue 002, not a one-off.</h2>
        <p>
          The public calendar is now four Wednesdays deep. Each slot is an
          open brief until the playlist, cover, sequence, Block, and playback
          receipt are real.
        </p>
      </div>
      <div>
        <a href={publication.route}>Open the publication + calendar ↗</a>
        <a href={publication.jsonRoute}>Read the publication JSON ↗</a>
        <a href="/playlists/wednesday-morning-uplift">Return to Issue 001 ↗</a>
      </div>
    </section>

    <footer class="goodwork__footer">
      <p>{issue.participation.note}</p>
      <nav aria-label="Issue 002 participation">
        <a href="/super-follow">Follow on this device</a>
        <a href="/ping">Pitch a Wednesday</a>
        <a href="/auth">Bring a signal passport</a>
        <a href={issue.jsonRoute}>Issue JSON</a>
      </nav>
    </footer>
  </main>
</BlockLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-goodwork-tab]'));
  const movements = Array.from(document.querySelectorAll<HTMLElement>('[data-goodwork-movement]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.goodworkTab;
      const target = movements.find((movement) => movement.dataset.goodworkMovement === id);
      if (!target) return;

      tabs.forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === tab));
      });

      target.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  });
</script>

<style>
  :global(body) { margin: 0; background: #11110e; }

  .goodwork {
    --ink: #11110e;
    --acid: #d9ed00;
    --blue: #1847d1;
    --red: #ef4e29;
    --paper: #f4f0df;
    width: min(1500px, calc(100% - 24px));
    margin: 12px auto 48px;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .goodwork a { color: inherit; }
  .mono { font-family: var(--pc-font-mono); }

  .goodwork__crumb {
    display: flex;
    gap: 8px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .goodwork__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(420px, .97fr);
    border-bottom: 2px solid var(--ink);
  }

  .goodwork__hero figure {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border-right: 2px solid var(--ink);
    background: var(--acid);
  }

  .goodwork__hero figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .goodwork__hero figcaption {
    flex: 1;
    padding: 10px 13px;
    border-top: 2px solid var(--ink);
    background: var(--paper);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1.4;
  }

  .goodwork__intro {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(28px, 4.5vw, 66px);
    background:
      linear-gradient(168deg, transparent 0 76%, rgba(24,71,209,.11) 76.2% 77%, transparent 77.2%),
      var(--acid);
  }

  .goodwork__flag {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .09em;
  }

  .goodwork__time {
    margin: auto 0 10px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .goodwork__intro h1 {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: clamp(68px, 8vw, 126px);
    font-weight: 950;
    letter-spacing: -.09em;
    line-height: .74;
  }

  .goodwork__intro h1 span:last-child { color: var(--blue); transform: translateX(10%); }
  .goodwork__dek { max-width: 36ch; margin: 36px 0 20px; font-size: clamp(19px, 2.2vw, 29px); font-weight: 780; line-height: 1.08; }
  .goodwork__intro blockquote { max-width: 48ch; margin: 0; padding-left: 16px; border-left: 3px solid var(--red); font: italic 17px/1.35 Georgia, serif; }

  .goodwork__facts {
    display: flex;
    gap: 20px;
    margin-top: auto;
    padding-top: 34px;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .goodwork__facts span { display: flex; align-items: baseline; gap: 5px; }
  .goodwork__facts b { font-size: 22px; }
  .goodwork__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .goodwork__actions a { padding: 12px 14px; border: 2px solid var(--ink); background: var(--paper); font: 900 9px/1 var(--pc-font-mono); letter-spacing: .08em; text-decoration: none; }
  .goodwork__actions a:first-child { background: var(--blue); color: white; }

  .goodwork__player {
    display: grid;
    grid-template-columns: minmax(280px, .38fr) minmax(0, .62fr);
    border-bottom: 2px solid var(--ink);
    background: var(--blue);
    color: white;
  }

  .goodwork__player > div { min-width: 0; padding: clamp(28px, 4vw, 56px); }
  .goodwork__player > div:first-child { border-right: 2px solid var(--ink); }
  .goodwork__player p { max-width: 40ch; line-height: 1.45; }
  .goodwork__player > div > .mono { margin: 0; color: var(--acid); font-size: 8px; font-weight: 900; letter-spacing: .12em; }
  .goodwork__player h2 { margin: 15px 0 24px; font-size: clamp(48px, 5vw, 78px); letter-spacing: -.065em; line-height: .84; }
  .goodwork__embed { display: flex; align-items: center; background: linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px); background-size: 34px 100%; }
  .goodwork__embed iframe { min-height: 352px; border: 0; border-radius: 16px; box-shadow: 8px 9px 0 var(--ink); }

  .goodwork__movement-nav { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 2px solid var(--ink); }
  .goodwork__movement-nav button { display: flex; gap: 10px; align-items: center; min-width: 0; min-height: 64px; padding: 12px 14px; border: 0; border-right: 2px solid var(--ink); background: var(--paper); color: var(--ink); text-align: left; cursor: pointer; }
  .goodwork__movement-nav button:last-child { border-right: 0; }
  .goodwork__movement-nav button[aria-pressed='true'] { background: var(--acid); }
  .goodwork__movement-nav button span { font-size: 8px; font-weight: 900; }
  .goodwork__movement-nav button strong { font-size: 13px; }

  .goodwork__sequence article { scroll-margin-top: 12px; border-bottom: 2px solid var(--ink); }
  .goodwork__sequence article > header { display: grid; grid-template-columns: 100px minmax(0, 1fr); }
  .goodwork__sequence article > header > span { display: grid; place-items: center; border-right: 2px solid var(--ink); background: var(--acid); font-size: 26px; font-weight: 900; }
  .goodwork__sequence article > header div { padding: 28px 30px; }
  .goodwork__sequence article > header p { margin: 0; }
  .goodwork__sequence article > header .mono { font-size: 8px; font-weight: 900; letter-spacing: .1em; }
  .goodwork__sequence article > header h2 { margin: 8px 0; font-size: clamp(34px, 4vw, 60px); letter-spacing: -.055em; line-height: .9; }
  .goodwork__sequence ol { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
  .goodwork__sequence li + li { border-top: 1px solid var(--ink); }
  .goodwork__sequence li a { display: grid; grid-template-columns: 52px minmax(180px, .8fr) minmax(220px, 1.2fr) 55px 18px; gap: 16px; align-items: center; padding: 17px 22px; text-decoration: none; }
  .goodwork__sequence li a:hover { background: var(--acid); }
  .goodwork__position { font-size: 10px; font-weight: 900; }
  .goodwork__track { display: flex; flex-direction: column; gap: 3px; }
  .goodwork__track strong { font-size: 16px; }
  .goodwork__track small { font-size: 11px; }
  .goodwork__note { font-size: 13px; line-height: 1.3; }
  .goodwork__duration { font-size: 9px; font-weight: 900; }

  .goodwork__liner,
  .goodwork__next { display: grid; grid-template-columns: .9fr 1.1fr; border-bottom: 2px solid var(--ink); }
  .goodwork__liner > div,
  .goodwork__next > div { padding: clamp(28px, 5vw, 68px); }
  .goodwork__liner > div:first-child,
  .goodwork__next > div:first-child { border-right: 2px solid var(--ink); }
  .goodwork__liner .mono,
  .goodwork__next .mono { margin: 0; font-size: 8px; font-weight: 900; letter-spacing: .11em; }
  .goodwork__liner h2,
  .goodwork__next h2 { margin: 14px 0 0; font-size: clamp(42px, 6vw, 86px); letter-spacing: -.07em; line-height: .84; }
  .goodwork__liner > div:last-child p,
  .goodwork__next > div:first-child > p:last-child { max-width: 48ch; font-size: 18px; line-height: 1.45; }
  .goodwork__liner { background: var(--acid); }
  .goodwork__next { background: var(--ink); color: var(--paper); }
  .goodwork__next > div:last-child { display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .goodwork__next a { padding: 16px; border: 2px solid var(--paper); font: 900 9px/1 var(--pc-font-mono); letter-spacing: .08em; text-decoration: none; }
  .goodwork__next a:first-child { border-color: var(--acid); background: var(--acid); color: var(--ink); }

  .goodwork__footer { display: grid; grid-template-columns: 1fr 1.2fr; gap: 30px; padding: 26px 30px; }
  .goodwork__footer p { margin: 0; font-size: 12px; line-height: 1.4; }
  .goodwork__footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .goodwork__footer a { padding: 9px 11px; border: 2px solid var(--ink); background: var(--acid); font: 900 8px/1 var(--pc-font-mono); letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }

  .goodwork :focus-visible { outline: 3px solid white; outline-offset: 3px; box-shadow: 0 0 0 6px var(--ink); }

  @media (max-width: 900px) {
    .goodwork__hero,
    .goodwork__player,
    .goodwork__liner,
    .goodwork__next,
    .goodwork__footer { grid-template-columns: 1fr; }
    .goodwork__hero figure,
    .goodwork__player > div:first-child,
    .goodwork__liner > div:first-child,
    .goodwork__next > div:first-child { border-right: 0; border-bottom: 2px solid var(--ink); }
    .goodwork__next > div:first-child { border-color: var(--paper); }
    .goodwork__sequence li a { grid-template-columns: 44px minmax(0, 1fr) 48px 16px; }
    .goodwork__note { grid-column: 2 / -1; }
    .goodwork__footer nav { justify-content: flex-start; }
  }

  @media (max-width: 650px) {
    .goodwork { width: calc(100% - 10px); margin-top: 5px; }
    .goodwork__intro { min-height: 670px; padding: 26px 20px; }
    .goodwork__flag { flex-direction: column; }
    .goodwork__movement-nav { grid-template-columns: repeat(2, 1fr); }
    .goodwork__movement-nav button:nth-child(2) { border-right: 0; }
    .goodwork__movement-nav button:nth-child(-n+2) { border-bottom: 2px solid var(--ink); }
    .goodwork__sequence article > header { grid-template-columns: 70px minmax(0, 1fr); }
    .goodwork__sequence article > header div { padding: 22px 20px; }
    .goodwork__sequence li a { gap: 10px; padding: 15px 12px; }
    .goodwork__track strong { font-size: 14px; }
    .goodwork__player > div { padding: 28px 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .goodwork__sequence li a { scroll-behavior: auto; }
  }
</style>
