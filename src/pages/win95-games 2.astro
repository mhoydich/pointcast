---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Windows 95 Games';
const description = 'A small PointCast shelf of Windows 95 worthy Nouns games: Solitaire, Memory, and Pyramid.';
const games = [
  { href: '/solitaire-v2', name: 'Solitaire v2', kicker: 'KLONDIKE · DRAW 1', note: 'The full card-table anchor: stock, waste, tableau, foundations.' },
  { href: '/nouns-memory-v2', name: 'Nouns Memory v2', kicker: 'PAIRS · LOCAL BEST', note: 'Flip Nouns, find twins, clear the desktop tray.' },
  { href: '/nouns-pyramid-v2', name: 'Nouns Pyramid v2', kicker: 'ADD TO 13', note: 'Clear exposed pairs from a pyramid table.' },
];
---

<BlockLayout title={title} description={description} image="/images/games/solitaire-v2-bg.webp">
  <main class="desk">
    <section class="window" aria-labelledby="games-title">
      <header class="titlebar"><span>PointCast Games</span><span aria-hidden="true">_ □ x</span></header>
      <div class="hero">
        <p>WINDOWS 95 · NOUNS · SMALL GAMES</p>
        <h1 id="games-title">A little desktop of card things.</h1>
        <span>Same table, different loops. The good kind of unnecessary.</span>
      </div>
      <div class="grid">
        {games.map((game) => (
          <a class="game" href={game.href}>
            <span>{game.kicker}</span>
            <strong>{game.name}</strong>
            <em>{game.note}</em>
          </a>
        ))}
      </div>
    </section>
  </main>
</BlockLayout>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:18px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; }
  .window { max-width:980px; margin:0 auto; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; box-shadow:2px 2px 0 #000; }
  .titlebar { display:flex; justify-content:space-between; min-height:28px; padding:4px 7px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .hero { padding:24px; border-top:1px solid #fff; border-bottom:1px solid #808080; background:linear-gradient(rgba(0,62,48,.18),rgba(0,52,42,.34)),url('/images/games/solitaire-v2-bg.webp') center/cover; color:#fff; text-shadow:1px 1px 0 #000; }
  .hero p,.game span { margin:0 0 10px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; }
  h1 { max-width:760px; margin:0; font-size:clamp(42px,8vw,92px); line-height:.9; }
  .hero > span { display:block; margin-top:12px; font-size:18px; }
  .grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; padding:14px; }
  .game { min-height:180px; display:grid; align-content:start; gap:10px; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#fff; color:#000; padding:14px; text-decoration:none; }
  .game:hover { background:#000080; color:#fff; text-decoration:none; }
  .game strong { font-size:30px; line-height:1; }
  .game em { color:inherit; font-style:normal; line-height:1.4; }
  @media (max-width:760px) { .desk{padding:8px}.grid{grid-template-columns:1fr} }
</style>
