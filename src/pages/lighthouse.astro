      text(`STEP ${pad2(n)}`, WALL + 2, 11, 2, m.bright);
      const label = G.phase === 'free' ? 'FREE' : response.label;
      const col = label === 'RUSH' ? m.bands.red : label === 'FLOW' ? m.bands.yellow : label === 'DRIFT' ? m.bright : label === 'FREE' ? m.paddle : m.bands.green;
      text(label, W / 2 + 6, 11, 2, col, 'center');
      text(mood.dial === 'calm' ? 'CALM' : `BEST ${pad2(best)}`, W - WALL - 2, 11, 2, m.bright, 'right');
      ctx.fillStyle = m.text; ctx.globalAlpha = 0.5; ctx.fillRect(WALL, HUD - 2, W - 2 * WALL, 1); ctx.globalAlpha = 1;
      if (mood.tape.length) {
        const k = Math.min(60, mood.tape.length), start = mood.tape.length - k;
        for (let i = 0; i < k; i += 1) {
          const v = mood.tape[start + i];
          ctx.fillStyle = v === 2 ? m.bands.red : v === 1 ? m.bands.yellow : v === 3 ? m.text : m.bands.green;
          ctx.fillRect(WALL + i * 3, HUD - 6, 2, 2);
        }
      }
    }
    function drawPrompt() {
      const m = M();
      const y = geo.cy + geo.rOuter + PROMPT_GAP;
      // The lamp that was due outranks any passing message.
      if (G.msgT > 0 && G.msg && G.phase !== 'miss') { text(G.msg, W / 2, y, G.msgScale, m.bright, 'center'); return; }
      if (G.phase === 'show') text('WATCH THE LIGHT', W / 2, y, 2, m.bright, 'center');
      else if (G.phase === 'input') {
        text(COARSE ? 'TAP THE LAMPS' : 'YOUR TURN', W / 2, y, 2, m.paddle, 'center');
        // The response window, as a draining bar: generous in DRIFT, tight in RUSH.
        const left = clamp(1 - G.inputT / tune.window, 0, 1);
        const bw = 120;
        ctx.fillStyle = mix(m.field, '#000000', 0.4); ctx.fillRect(W / 2 - bw / 2, y + 16, bw, 3);
        ctx.fillStyle = left < 0.3 ? m.bands.red : m.paddle; ctx.fillRect(W / 2 - bw / 2, y + 16, Math.round(bw * left), 3);
      } else if (G.phase === 'good') text('GOOD', W / 2, y, 2, m.paddle, 'center');
      else if (G.phase === 'miss') {
        text('MISS', W / 2, y, 3, m.bright, 'center');
        if (G.missLamp >= 0) text(`${LAMPS[G.missLamp].name} WAS DUE`, W / 2, y + 20, 2, m.paddle, 'center');
      } else if (G.phase === 'free') text(COARSE ? 'HOLD OR SLIDE ON THE LAMPS' : 'HOLD A LAMP OR KEYS 1-4', W / 2, y, 2, m.paddle, 'center');
      else if (G.phase === 'paused') { text('PAUSED', W / 2, y, 3, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, y + 20, 2, m.paddle, 'center'); }
    }
    function drawParticles() {
      for (const p of G.particles) {
        ctx.globalAlpha = 1 - p.t / p.life;
        ctx.fillStyle = p.color;
        ctx.fillRect(Math.round(p.x), Math.round(p.y), 2, 2);
      }
      ctx.globalAlpha = 1;
    }
    function drawBoot() {
      const m = M();
      ctx.fillStyle = m.field; ctx.fillRect(0, 0, W, H);
      let left = Math.floor(G.boot.chars);
      let y = 12;
      // Boot text a shade lighter than each machine's own, so it clears 4.5:1 on the field.
      const ink = machineId === 'c64' ? '#bdb6ff' : '#b6c3f7';
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, ink);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = ink; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = ink; ctx.fillRect(10, y, 6, 10); }
    }
    function panel(y0, y1) {
      const m = M();
      ctx.globalAlpha = 0.82; ctx.fillStyle = m.field; ctx.fillRect(WALL + 8, y0, W - 2 * WALL - 16, y1 - y0); ctx.globalAlpha = 1;
    }
    function drawTitle() {
      const m = M();
      drawBeam(); drawLens(0.75);
      const y = geo.cy - 52;
      panel(y - 8, y + 92);
      rainbowText('LIGHTHOUSE', W / 2, y, 5, [m.bands.green, m.bands.red, m.bands.yellow, m.bands.orange]);
      text('FOLLOW THE LIGHT', W / 2, y + 36, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, y + 54, 2, m.bright, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, y + 70, 2, m.paddle, 'center');
      const py = geo.cy + geo.rOuter + PROMPT_GAP;
      if (Math.floor(G.t * 2) % 2 === 0 || REDUCED) text(COARSE ? 'TAP TO PLAY' : 'CLICK OR PRESS SPACE', W / 2, py, 2, m.paddle, 'center');
      if (best > 0) text(`BEST ${pad2(best)} STEPS`, W / 2, py + 16, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 14, 1, m.bright, 'center');
    }
    function drawOver() {
      const m = M();
      drawLens(0.4);
      const y = geo.cy - 50;
      panel(y - 10, y + 96);
      text('LIGHTS OUT', W / 2, y, 4, m.bright, 'center');
      text(`REPEATED ${pad2(G.game.longest)}`, W / 2, y + 34, 2, m.bright, 'center');
      text(`BEST     ${pad2(best)}`, W / 2, y + 52, 2, m.bands.yellow, 'center');
      text(`PEAK ${mood.peak}`, W / 2, y + 70, 2, m.paddle, 'center');
      const py = geo.cy + geo.rOuter + PROMPT_GAP;
      if (G.t > 0.8 && (Math.floor(G.t * 2) % 2 === 0 || REDUCED)) text(COARSE ? 'TAP TO PLAY AGAIN' : 'SPACE TO PLAY AGAIN', W / 2, py, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, offX * dpr, offY * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawField();
      if (G.phase === 'title') { drawTitle(); return; }
      drawHud();
      if (G.phase === 'over') { drawOver(); return; }
      drawBeam(); drawLens(1); drawHub(); drawParticles(); drawPrompt();
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const quiet = attract() || G.phase === 'free';
        readout.mood.textContent = `${G.phase === 'free' ? 'FREE' : quiet ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${quiet ? 100 : response.tempo} BPM ${quiet ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.step.textContent = `STEP ${G.game.sequence.length} BEST ${best}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.win.textContent = `WIN ${tune.window.toFixed(1)}S X${tune.mult.toFixed(2)}`;
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return true; }
      if (G.phase === 'title') { newGame(); return true; }
      if (G.phase === 'over') { if (G.t > 0.8) newGame(); return true; }
      if (G.phase === 'paused') { resume(); return true; }
      return false;
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      // The lamp under the finger is read from this event's own position.
      const p = pointerToField(e);
      if (action()) return;
      const i = lampAt(p.x, p.y, geo);
      if (i >= 0) lampDown(`p${e.pointerId}`, i);
    });
    canvas.addEventListener('pointermove', (e) => {
      // Free play: slide from lamp to lamp for a run. In a game a slide never presses a second lamp.
      if (G.phase !== 'free' || !G.held.has(`p${e.pointerId}`)) return;
      const p = pointerToField(e);
      const i = lampAt(p.x, p.y, geo);
      const id = `p${e.pointerId}`;
      if (i < 0) holdEnd(id);
      else if (G.held.get(id) !== i) holdStart(id, i);
    });
    const up = (e) => holdEnd(`p${e.pointerId}`);
    canvas.addEventListener('pointerup', up);
    canvas.addEventListener('pointercancel', up);
    canvas.addEventListener('lostpointercapture', up);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; lamp keys and letters still play from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      const lamp = lampForKey(k);
      if (lamp >= 0) {
        e.preventDefault();
        audio.unlock();
        if (e.repeat) return;
        if (G.phase === 'paused') { resume(); return; }
        lampDown(`k${k}`, lamp);
        return;
      }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); action(); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'KeyX') { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); return; }
      if (k === 'KeyZ') { audio.unlock(); cycleDial(); return; }
      if (k === 'KeyT') { audio.unlock(); setFree(G.phase !== 'free'); }
    });
    document.addEventListener('keyup', (e) => { holdEnd(`k${e.code}`); });
    function pause() {
      if (!['show', 'input', 'good'].includes(G.phase)) return;
      releaseAll();
      G.resume = G.phase; G.phase = 'paused'; G.t = 0;
      audio.setMusic(false);
      announce('Paused.');
    }
    function resume() {
      if (G.phase !== 'paused') return;
      const back = G.resume || 'show';
      G.resume = null;
      audio.setMusic(true);
      // A paused playback starts over from the first lamp; a paused answer gets a fresh window.
      if (back === 'show' || back === 'good') { if (back === 'good') extend(G.game); startShow(); announce('Watch the light.'); }
      else { G.phase = 'input'; G.t = 0; G.inputT = 0; announce('Your turn.'); }
    }
    function togglePause() { if (G.phase === 'paused') resume(); else pause(); }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        releaseAll();
        pause();
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', () => { releaseAll(); });
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.free.setAttribute('aria-pressed', String(G.phase === 'free'));
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood); tune = tuning(response, mood.dial);
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${next === 'calm' ? 'A miss replays the same sequence.' : next === 'rush' ? 'The light starts hot.' : 'One miss ends the game.'}`);
      if (G.phase !== 'title' && G.phase !== 'boot') showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); if (!soundOn) releaseAll(); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space starts again. Keyboard activation keeps focus.
    const pressBtn = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    pressBtn(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    pressBtn(btn.dial, () => { audio.unlock(); cycleDial(); });
    pressBtn(btn.free, () => { audio.unlock(); if (G.phase === 'boot') enterTitle(); setFree(G.phase !== 'free'); });
    pressBtn(btn.sound, toggleSound);
    pressBtn(btn.crt, toggleCrt);
    pressBtn(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
    // Hooks for the QA drive: read-only state, never used by the page itself.
    root.lighthouse = { state: () => ({ phase: G.phase, sequence: G.game.sequence.slice(), pos: G.game.pos, due: due(G.game), longest: G.game.longest, best, label: mood.label, dial: mood.dial, H, geo: { ...geo }, scale, offX, offY, window: tune.window, mult: tune.mult }) };
  }
</script>
