---
/**
 * /lighthouse — Simon as a lighthouse lens at night.
 *
 * A wave-two game in the Breakwater family (see /cabinet-row), directed by
 * Michael Hoydich: "80s innocence, joy of the compute and flow, mood state
 * symbiosis, mobile and full screen, audio visual multimedia, Atari and
 * Commodore inspired style modern."
 *
 * The light plays a growing sequence on four lamps; the player repeats it.
 * Everything in the playfield is drawn from the shared 3x5 pixel font and
 * plain rects on a canvas; every sound is synthesized in the browser. Pure
 * logic lives in src/lib/lighthouse (lens, game) on top of the shared
 * src/lib/breakwater (font, waves, mood) and is covered by
 * tests/lighthouse.test.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { LAMPS } from '../lib/lighthouse/lens.mjs';

const description = 'Simon as a lighthouse lens at night: four lamps in Atari 800XL or Commodore 64 colors, a growing sequence of light and synthesized tone to repeat, a free-play instrument, and a mood the game and you keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/lighthouse';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Lighthouse',
      alternateName: 'Lighthouse: follow the light',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/lighthouse/og.png',
      gamePlatform: 'Web browser',
      genre: 'Memory game',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Lighthouse', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
const lampLine = LAMPS.map((l) => `${l.name.toLowerCase()} ${l.band} (${l.note})`).join(', ');
---

<BlockLayout
  title="Lighthouse"
  description={description}
  image="/images/lighthouse/og.png"
  imageAlt="A round lighthouse lens of four colored lamps on a night-blue field, a beam crossing it, beside the words Lighthouse, follow the light."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/lighthouse.json', title: 'Lighthouse rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/lighthouse/og.png',
    buttons: [
      { label: 'Play Lighthouse', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="lh" data-lh data-machine="xl" data-crt="on">
    <div class="lh-stage" data-stage>
      <header class="lh-bar">
        <a class="lh-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="lh-name" aria-hidden="true">LIGHTHOUSE</span>
        <div class="lh-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (X)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (Z)">PLAY</button>
          <button type="button" data-free-btn aria-pressed="false" title="Free play: the lens as an instrument (T)">FREE</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="lh-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Lighthouse playfield. A round lens of four lamps: north, east, south and west. Watch the light, then repeat it with taps, the arrow keys or 1 to 4."></canvas>
        <div class="lh-scan" aria-hidden="true"></div>
        <noscript><p class="lh-noscript">Lighthouse needs JavaScript to draw the lens and make its tones. The rules and moods are readable at <a href="/lighthouse.json">/lighthouse.json</a>.</p></noscript>
      </div>
      <footer class="lh-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-step>STEP 0</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-win>WIN 3.0S</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="lh-notes">
      <p class="lh-eyebrow">PointCast / Games / Lighthouse</p>
      <h1>Follow the light.</h1>
      <p class="lh-lede">A lighthouse lens at night with four lamps. The light plays a sequence; you play it back. Each round it adds one more. Simon, 1978, turned a quarter so the lamps face the compass.</p>

      <div class="lh-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Each lamp you get right raises its <strong>energy</strong>, each sequence you finish raises it more, and every eighth step reached lifts both. A miss lowers its <strong>calm</strong>. Time brings both back toward the dial you set.</p>
          <ul class="lh-moods">
            <li><b>DAWN</b> warming up. A little extra time to answer, cool colors, a slow major arpeggio under the lens.</li>
            <li><b>FLOW</b> a clean run. Bright lamps, the music opens up.</li>
            <li><b>RUSH</b> faster playback, the lamps go dark between flashes, raster bars in the border, more sparks.</li>
            <li><b>DRIFT</b> after a miss. The light plays slower and waits longer for you; the notes thin out.</li>
          </ul>
          <p>Your side is the dial: <span><b>CALM</b> (a miss replays the same sequence; there is no game over)</span>; {dials.filter((d) => d.id !== 'calm').map((d, i, a) => <span><b>{d.label}</b> ({d.id === 'play' ? 'one miss ends the game' : 'starts hot, the light plays fast'}){i < a.length - 1 ? '; ' : '.'}</span>)} The mood tape from your session stays in this browser, and when you leave after a game, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border. Lamp tones are raw square waves, in the POKEY spirit. A blue READY and a RUN before the lens lights.' : 'The blue field inside a light-blue border. Lamp tones are triangle waves and the music runs through a resonant filter, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>The lamps take the four colors each machine gives Breakwater's bricks. Nothing is emulated and nothing is copied: the pixel font, the lens, the tones and the music were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-lighthouse-notes.md">research note on Simon</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Four lamps clockwise from the top: {lampLine}. Together they sound an A major chord, after Simon's four bugle-like tones. Playback speeds up after the 5th, 9th and 13th step of a sequence, as Simon's did. A wrong lamp, or waiting too long, sounds a low buzz and shows the lamp that was due. Your best is the longest sequence you repeated.</p>
          <p><b>FREE</b> turns the lens into a four-note instrument: hold a lamp to sound it, slide between lamps to play a run.</p>
          <h2>Controls</h2>
          <ul>
            <li>Tap or click the lamps. Tap anywhere to start.</li>
            <li>Keys: ↑ → ↓ ← or W D S A, or 1 2 3 4 clockwise from the top, play the lamps. Space starts, P pauses, F full screen, M sound, C scanlines, X switches machines, Z turns the dial, T free play.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="lh-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code. October 22, 2026, a wave-two game in the Breakwater family. Original code, art and synthesized sound; no ROMs, no recordings. Simon is a trademark of its owner and is named here as a tribute; machine names are tributes too.</p>
        <p><a href="/cabinet-row">Cabinet Row</a> · <a href="/lighthouse.json">lighthouse.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .lh { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .lh[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .lh-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .lh-stage:fullscreen { height: 100%; min-height: 0; }
  .lh-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .lh-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .lh-home { color: #a9b9f5; text-decoration: none; font-weight: 700; }
  .lh-home:hover { color: #fff; }
  .lh-name { color: #fff; font-weight: 700; margin-right: auto; }
  .lh-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; margin-left: auto; }
  .lh-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .lh-controls button:hover { background: #1f2456; }
  .lh-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .lh-controls button[data-free-btn][aria-pressed='false'] { text-decoration: none; }
  .lh-controls button[data-free-btn][aria-pressed='true'] { color: #0b0d1a; background: var(--paddle); border-color: var(--paddle); }
  .lh-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .lh-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .lh-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: pointer; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .lh-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .lh[data-crt='off'] .lh-scan { display: none; }
  .lh-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .lh-noscript a { color: var(--paddle); }
  .lh-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; flex-shrink: 0; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #8d94c2; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .lh-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .lh-readout a { margin-left: auto; flex-shrink: 0; color: #a9b9f5; text-decoration: none; }
  .lh-readout a:hover { color: #fff; }
  .lh-stage:fullscreen .lh-readout a { display: none; }
  .lh-stage:-webkit-full-screen .lh-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .lh-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .lh-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #8d94c2; margin: 0 0 14px; }
  .lh-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .lh-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .lh-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .lh-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .lh-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .lh-grid p + h2, .lh-grid ul + h2 { margin-top: 22px; }
  .lh-grid p { margin: 0 0 12px; }
  .lh-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .lh-grid li { margin-bottom: 6px; }
  .lh-moods { list-style: none; padding: 0; }
  .lh-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .lh-notes a { color: #a9b9f5; }
  .lh-notes a:hover { color: #fff; }
  .lh-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .lh-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .lh-stage { min-height: 0; }
    .lh-bar { gap: 8px; padding: 6px 10px; }
    .lh-name { display: none; }
    .lh-controls { gap: 4px; }
    .lh-controls button { padding: 7px 6px; min-width: 38px; font-size: 9px; }
    .lh-readout { gap: 10px; font-size: 9px; height: 26px; }
    .lh-readout [data-r-win], .lh-readout [data-r-fps] { display: none; }
    .lh-grid { grid-template-columns: 1fr; gap: 20px; }
    .lh-notes { padding: 40px 16px 56px; }
  }
  @media (max-width: 380px) {
    .lh-home { font-size: 0; }
    .lh-home::before { content: 'PC'; font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .lh-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { LAMPS, BAND_NAMES, midiToHz, lampForKey, lensGeometry, lampAt, lensCells, hubCells } from '../lib/lighthouse/lens.mjs';
  import { playbackPlan, tuning, createGame, extend, due, press, miss } from '../lib/lighthouse/game.mjs';

  const root = document.querySelector('[data-lh]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = 288, H_MIN = 384, H_MAX = 480, WALL = 8, HUD = 32, CELL = 4;
    let H = H_MIN;
    let geo = lensGeometry(W, H, HUD);
    let cells = lensCells(geo, CELL);
    let hub = hubCells(geo, CELL);
    let backing = backingCells(geo);
    const STORE = 'lighthouse:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;
    const PROMPT_GAP = 14;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      free: root.querySelector('[data-free-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      step: root.querySelector('[data-r-step]'),
      fps: root.querySelector('[data-r-fps]'),
      win: root.querySelector('[data-r-win]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isInteger(settings.best) && settings.best > 0 ? settings.best : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    let tune = tuning(response, mood.dial);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title or free play.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const toHex = (c) => `#${c.map((v) => Math.round(clamp(v, 0, 255)).toString(16).padStart(2, '0')).join('')}`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return toHex([0, 1, 2].map((i) => A[i] + (B[i] - A[i]) * t)); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    const pad2 = (n) => String(n).padStart(2, '0');
    const lampWords = (i) => `${BAND_NAMES[LAMPS[i].band]} ${LAMPS[i].id}`;
    function backingCells(g) {
      const out = [], r = g.rOuter + 4;
      for (let y = g.cy - r; y < g.cy + r; y += CELL) for (let x = g.cx - r; x < g.cx + r; x += CELL) if (Math.hypot(x + CELL / 2 - g.cx, y + CELL / 2 - g.cy) <= r) out.push({ x, y });
      return out;
    }
    // Fixed stars, so nothing strobes: they only twinkle slowly, and not at all with reduced motion.
    const STARS = Array.from({ length: 34 }, (_, i) => ({ x: WALL + 4 + ((i * 97) % (W - 2 * WALL - 8)), y: HUD + 6 + ((i * 53) % 300), p: i * 1.7 }));

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 104, scale = 'major', density = 0.5, musicOn = false, wantMusic = false, ducked = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // In A, so the music sits under the lamps' own A major chord.
      const PROG = {
        major: [[57, 61, 64, 69], [54, 57, 61, 66], [50, 54, 57, 62], [52, 56, 59, 64]],
        bright: [[57, 61, 64, 68], [59, 63, 66, 71], [62, 66, 69, 73], [64, 68, 71, 75]],
        minor: [[54, 57, 61, 66], [50, 54, 57, 62], [52, 56, 59, 64], [54, 57, 61, 66]],
        soft: [[57, 64, 69, 73], [50, 57, 62, 66], [54, 61, 66, 69], [52, 59, 64, 68]],
      };
      const ARP = [0, 1, 2, 3, 2, 1, 0, 2];
      const MUSIC_GAIN = 0.26, DUCK_GAIN = 0.07;
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.8; sfx.connect(master);
        music = ac.createGain(); music.gain.value = ducked ? DUCK_GAIN : MUSIC_GAIN; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.55, t + a + dur * 0.25, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      // A lamp tone: square on the 800XL, triangle on the C64, held for as long as it is asked to be.
      function lampTone(i) {
        if (!ac) return () => {};
        const t = ac.currentTime;
        const o = ac.createOscillator();
