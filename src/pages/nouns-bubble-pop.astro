---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ARCADE_ASSETS } from '../lib/retro-arcade';

const title = 'Nouns Bubble Pop';
const description = 'Touch-drag to aim, release to shoot, and clear Nouns-colored bubbles from the Win95 Retro Arcade rack.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Game', '@id': 'https://pointcast.xyz/nouns-bubble-pop', name: title, description, url: 'https://pointcast.xyz/nouns-bubble-pop' };
---

<BlockLayout title={title} description={description} image={ARCADE_ASSETS.table} jsonLd={jsonLd}>
  <main class="desk" data-bubbles>
    <section class="window" aria-labelledby="bubbles-title">
      <header class="titlebar"><span>Nouns Bubble Pop</span><span class="buttons" aria-hidden="true"><i>_</i><i>[]</i><i>x</i></span></header>
      <nav class="menubar" aria-label="Nouns Bubble Pop menu">
        <button type="button" data-new>Game</button>
        <a href="/swipe-golf">Golf</a>
        <a href="/noun-runner">Runner</a>
        <a href="/win95-games">All games</a>
      </nav>
      <div class="hero">
        <div><p class="kicker">DRAG · AIM · POP</p><h1 id="bubbles-title">Clear the rack.</h1><p>Drag to aim the cannon. Release to match three or more bubbles.</p></div>
        <div class="meters"><span>Left <strong data-left>0</strong></span><span>Score <strong data-score>0</strong></span><span>Best <strong data-best>--</strong></span></div>
      </div>
      <div class="stage">
        <canvas data-canvas width="360" height="560" aria-label="Nouns Bubble Pop play field"></canvas>
        <div class="overlay" data-overlay hidden>
          <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="bubbles-dialog-title">
            <header class="dlgbar"><span id="bubbles-dialog-title" data-dialog-title>Cleared</span><span class="buttons" aria-hidden="true"><i>x</i></span></header>
            <div class="dlgbody"><p data-dialog-message>Rack cleared.</p><button type="button" data-restart>New Game</button></div>
          </div>
        </div>
      </div>
      <footer class="status" data-status aria-live="polite">Drag from the cannon to aim.</footer>
    </section>
  </main>
</BlockLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-bubbles]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width;
      const H = canvas.height;
      const ROWS = 8;
      const COLS = 8;
      const R = 17;
      const STEP = 36;
      const X0 = 54;
      const Y0 = 50;
      const shooter = { x: W / 2, y: H - 42 };
      const slug = 'nouns-bubble-pop';
      const statsKey = 'pc:arcade:' + slug;
      const profileKey = 'pc:arcade:profile';
      const gameName = 'Bubbles';
      const badge = 'bubble-clear';
      const leftEl = root.querySelector<HTMLElement>('[data-left]');
      const scoreEl = root.querySelector<HTMLElement>('[data-score]');
      const bestEl = root.querySelector<HTMLElement>('[data-best]');
      const statusEl = root.querySelector<HTMLElement>('[data-status]');
      const overlay = root.querySelector<HTMLElement>('[data-overlay]');
      const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogMessage = root.querySelector<HTMLElement>('[data-dialog-message]');
      const noun = new Image();
      noun.src = 'https://noun.pics/1001.svg';
      const colors = ['#4a9eff', '#2cc5a0', '#f7c325', '#e84d6a', '#d22209'];
      type Bubble = { color: number };
      type Shot = { x: number; y: number; vx: number; vy: number; color: number } | null;
      let grid: (Bubble | null)[][] = [];
      let shot: Shot = null;
      let currentColor = 0;
      let nextColor = 1;
      let score = 0;
      let best = Number(readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 }).bestScore || 0);
      let aiming = false;
      let aim = { x: shooter.x, y: shooter.y - 120 };
      let won = false;
      let over = false;
      let last = 0;
      let raf = 0;

      function readJson(key: string, fallback: any) { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; } }
      function writeJson(key: string, value: any) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* localStorage unavailable */ } }
      function setStatus(text: string) { if (statusEl) statusEl.textContent = text; }
      function recordPlay(clear: boolean) {
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        if (!clear) stats.plays = Number(stats.plays || 0) + 1;
        if (clear) {
          stats.clears = Number(stats.clears || 0) + 1;
          stats.bestScore = Math.max(Number(stats.bestScore || 0), score);
        }
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        const profile = readJson(profileKey, { achievements: [], clearStreak: 0, totalPlays: 0, clears: 0 });
        profile.lastPlayed = gameName;
        if (!clear) profile.totalPlays = Number(profile.totalPlays || 0) + 1;
        if (clear) {
          profile.clears = Number(profile.clears || 0) + 1;
          profile.clearStreak = Number(profile.clearStreak || 0) + 1;
          profile.lastCleared = gameName;
          const earned = ['first-win', badge];
          if (profile.clearStreak >= 3) earned.push('three-game-streak');
          profile.achievements = Array.from(new Set([...(profile.achievements || []), ...earned]));
        }
        writeJson(profileKey, profile);
      }
      function persistBest() {
        best = Math.max(best, score);
        const stats = readJson(statsKey, { plays: 0, clears: 0, bestScore: 0 });
        stats.bestScore = Math.max(Number(stats.bestScore || 0), score);
        writeJson(statsKey, { plays: Number(stats.plays || 0), clears: Number(stats.clears || 0), bestScore: Number(stats.bestScore || 0) });
        renderMeters();
      }
      function countLeft() {
        let total = 0;
        for (const row of grid) for (const bubble of row) if (bubble) total++;
        return total;
      }
      function existingColors() {
        const set = new Set<number>();
        for (const row of grid) for (const bubble of row) if (bubble) set.add(bubble.color);
        return Array.from(set);
      }
      function pickColor() {
        const available = existingColors();
        return available.length ? available[Math.floor(Math.random() * available.length)] : Math.floor(Math.random() * colors.length);
      }
      function renderMeters() {
        if (leftEl) leftEl.textContent = String(countLeft());
        if (scoreEl) scoreEl.textContent = String(score);
        if (bestEl) bestEl.textContent = best ? String(best) : '--';
      }
      function showDialog(title: string, message: string) {
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogMessage) dialogMessage.textContent = message;
        if (overlay) overlay.hidden = false;
      }
      function hideDialog() { if (overlay) overlay.hidden = true; }
      function newGrid() {
        const pattern = [
          [0, 0, 1, 1, 2, 2, 3, 3],
          [0, 0, 1, 1, 2, 2, 3, 3],
          [4, 4, 0, 0, 1, 1, 2, 2],
          [4, 4, 3, 3, 0, 0, 1, 1],
          [2, 2, 4, 4, 3, 3, 0, 0],
        ];
        grid = Array.from({ length: ROWS }, (_, r) => Array.from({ length: COLS }, (_, c) => (
          r < pattern.length ? { color: pattern[r][c] } : null
        )));
      }
      function newGame() {
        cancelAnimationFrame(raf);
        newGrid();
        score = 0;
        shot = null;
        currentColor = pickColor();
        nextColor = pickColor();
        aiming = false;
        won = false;
        over = false;
        last = 0;
        hideDialog();
        recordPlay(false);
        renderMeters();
        setStatus('Drag from the cannon to aim.');
        raf = requestAnimationFrame(frame);
      }
      function center(r: number, c: number) { return { x: X0 + c * STEP, y: Y0 + r * STEP }; }
      function nearestCell(x: number, y: number) {
        let bestCell = { r: 0, c: 0, d: Infinity };
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            if (grid[r][c]) continue;
            const p = center(r, c);
            const d = Math.hypot(x - p.x, y - p.y);
            if (d < bestCell.d) bestCell = { r, c, d };
          }
        }
        return bestCell.d < Infinity ? bestCell : null;
      }
      function neighbors(r: number, c: number) {
        return [[1, 0], [-1, 0], [0, 1], [0, -1], [1, 1], [-1, -1]].map(([dr, dc]) => ({ r: r + dr, c: c + dc })).filter((p) => p.r >= 0 && p.r < ROWS && p.c >= 0 && p.c < COLS);
      }
      function cluster(r: number, c: number, sameColor: boolean) {
        const start = grid[r][c];
        if (!start) return [];
        const out: { r: number; c: number }[] = [];
        const seen = new Set<string>();
        const stack = [{ r, c }];
        while (stack.length) {
          const p = stack.pop();
          if (!p) continue;
          const k = p.r + ',' + p.c;
          if (seen.has(k)) continue;
          const bubble = grid[p.r][p.c];
          if (!bubble) continue;
          if (sameColor && bubble.color !== start.color) continue;
          seen.add(k);
          out.push(p);
          neighbors(p.r, p.c).forEach((n) => stack.push(n));
        }
        return out;
      }
      function dropFloaters() {
        const anchored = new Set<string>();
        const stack: { r: number; c: number }[] = [];
        for (let c = 0; c < COLS; c++) if (grid[0][c]) stack.push({ r: 0, c });
        while (stack.length) {
          const p = stack.pop();
          if (!p) continue;
          const k = p.r + ',' + p.c;
          if (anchored.has(k) || !grid[p.r][p.c]) continue;
          anchored.add(k);
          neighbors(p.r, p.c).forEach((n) => stack.push(n));
        }
        let dropped = 0;
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            if (grid[r][c] && !anchored.has(r + ',' + c)) {
              grid[r][c] = null;
              dropped++;
            }
          }
        }
        return dropped;
      }
      function placeShot(x: number, y: number, color: number) {
        const cell = nearestCell(x, y);
        if (!cell) {
          over = true;
          showDialog('Game Over', 'The rack is full. Try a cleaner lane.');
          return;
        }
        grid[cell.r][cell.c] = { color };
        const group = cluster(cell.r, cell.c, true);
        if (group.length >= 3) {
          group.forEach((p) => { grid[p.r][p.c] = null; });
          const dropped = dropFloaters();
          score += group.length * 100 + dropped * 50;
          setStatus('Popped ' + group.length + (dropped ? ', dropped ' + dropped + '.' : '.'));
        } else {
          setStatus('No match. Aim for a group of two.');
        }
        if (countLeft() === 0) {
          win();
          return;
        }
        currentColor = nextColor;
        nextColor = pickColor();
        persistBest();
        renderMeters();
      }
      function win() {
        if (won) return;
        won = true;
        shot = null;
        recordPlay(true);
        persistBest();
        renderMeters();
        setStatus('Rack cleared. Score ' + score + '.');
        showDialog('Cleared!', 'Rack cleared. Score ' + score + '. Badge logged locally.');
      }
      function fire() {
        if (shot || won || over) return;
        let angle = Math.atan2(aim.y - shooter.y, aim.x - shooter.x);
        const min = -Math.PI + 0.22;
        const max = -0.22;
        if (angle < min) angle = min;
        if (angle > max) angle = max;
        shot = { x: shooter.x, y: shooter.y - 8, vx: Math.cos(angle) * 520, vy: Math.sin(angle) * 520, color: currentColor };
        aiming = false;
        setStatus('Bubble away.');
      }
      function update(dt: number) {
        if (!shot || won || over) return;
        shot.x += shot.vx * dt;
        shot.y += shot.vy * dt;
        if (shot.x < R + 8) { shot.x = R + 8; shot.vx = Math.abs(shot.vx); }
        if (shot.x > W - R - 8) { shot.x = W - R - 8; shot.vx = -Math.abs(shot.vx); }
        if (shot.y < Y0 - R) {
          const landed = shot;
          shot = null;
          placeShot(landed.x, Y0, landed.color);
          return;
        }
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            if (!grid[r][c] || !shot) continue;
            const p = center(r, c);
            if (Math.hypot(shot.x - p.x, shot.y - p.y) < R * 2 - 2) {
              const landed = shot;
              shot = null;
              placeShot(landed.x, landed.y, landed.color);
              return;
            }
          }
        }
        if (shot.y > H - 94) {
          const landed = shot;
          shot = null;
          placeShot(landed.x, landed.y, landed.color);
        }
      }
      function drawBubble(x: number, y: number, color: number, radius = R) {
        ctx.fillStyle = colors[color] || colors[0];
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,.55)';
        ctx.beginPath();
        ctx.arc(x - radius * 0.32, y - radius * 0.36, radius * 0.28, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,.42)';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
      function draw() {
        ctx.fillStyle = '#101018';
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#1c1c38';
        for (let y = 28; y < H; y += 36) ctx.fillRect(0, y, W, 1);
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            const bubble = grid[r][c];
            if (!bubble) continue;
            const p = center(r, c);
            drawBubble(p.x, p.y, bubble.color);
          }
        }
        if (aiming && !shot) {
          ctx.strokeStyle = '#ffff00';
          ctx.setLineDash([8, 6]);
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(shooter.x, shooter.y);
          ctx.lineTo(aim.x, aim.y);
          ctx.stroke();
          ctx.setLineDash([]);
        }
        ctx.fillStyle = '#c0c0c0';
        ctx.fillRect(shooter.x - 32, shooter.y - 18, 64, 34);
        ctx.fillStyle = '#fff';
        ctx.fillRect(shooter.x - 32, shooter.y - 18, 64, 3);
        ctx.fillStyle = '#404040';
        ctx.fillRect(shooter.x - 32, shooter.y + 13, 64, 3);
        if (noun.complete && noun.naturalWidth) ctx.drawImage(noun, shooter.x - 25, shooter.y - 50, 50, 50);
        drawBubble(shooter.x, shooter.y - 16, currentColor, 15);
        drawBubble(W - 34, H - 34, nextColor, 12);
        ctx.fillStyle = '#fff';
        ctx.font = '700 11px Courier New';
        ctx.textAlign = 'right';
        ctx.fillText('NEXT', W - 52, H - 30);
        if (shot) drawBubble(shot.x, shot.y, shot.color);
      }
      function canvasPoint(event: PointerEvent) {
        const rect = canvas.getBoundingClientRect();
        return { x: (event.clientX - rect.left) * (W / rect.width), y: (event.clientY - rect.top) * (H / rect.height) };
      }
      function frame(t: number) {
        const dt = last ? Math.min(0.033, (t - last) / 1000) : 0;
        last = t;
        update(dt);
        draw();
        if (!won && !over) raf = requestAnimationFrame(frame);
      }
      canvas.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        if (shot || won || over) return;
        canvas.setPointerCapture(event.pointerId);
        aiming = true;
        aim = canvasPoint(event);
      });
      canvas.addEventListener('pointermove', (event) => {
        if (!aiming) return;
        event.preventDefault();
        aim = canvasPoint(event);
      });
      canvas.addEventListener('pointerup', (event) => {
        if (!aiming) return;
        event.preventDefault();
        aim = canvasPoint(event);
        fire();
      });
      canvas.addEventListener('pointercancel', () => { aiming = false; });
      root.querySelector<HTMLButtonElement>('[data-new]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('pointerdown', (event) => { event.preventDefault(); newGame(); });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else if (!won && !over) { last = 0; raf = requestAnimationFrame(frame); }
      });
      renderMeters();
      newGame();
    }
  }
</script>

<style>
  :global(body) { background:#008080; }
  .desk { min-height:calc(100vh - 88px); padding:8px; background:#008080; font-family:"MS Sans Serif",Tahoma,system-ui,sans-serif; color:#000; overflow-x:hidden; overscroll-behavior:none; }
  .desk *, .desk *::before, .desk *::after { box-sizing:border-box; }
  .window { width:min(100%,760px); margin:0 auto; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .titlebar,.dlgbar { min-height:26px; display:flex; align-items:center; justify-content:space-between; padding:3px 5px; background:linear-gradient(90deg,#000080,#1084d0); color:#fff; font-weight:700; font-size:13px; }
  .buttons { display:flex; gap:2px; }
  .buttons i { min-width:18px; height:18px; display:grid; place-items:center; border:2px solid; border-color:#fff #404040 #404040 #fff; background:#c0c0c0; color:#000; font-style:normal; font-size:10px; }
  .menubar { display:flex; flex-wrap:wrap; gap:2px; padding:4px 5px; border-bottom:1px solid #808080; }
  .menubar button,.menubar a { min-height:32px; border:0; background:transparent; color:#000; padding:6px 8px; font:inherit; font-size:13px; text-decoration:none; }
  .menubar button:active,.menubar a:active { background:#000080; color:#fff; }
  .hero { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:10px; padding:10px; }
  .kicker { margin:0 0 5px; font:700 10px/1 "Courier New",monospace; letter-spacing:.12em; color:#000080; }
  h1 { margin:0; font-size:clamp(28px,9vw,54px); line-height:.94; }
  .hero p:last-child { max-width:44ch; margin:6px 0 0; font-size:13px; }
  .meters { display:flex; flex-wrap:wrap; gap:6px; }
  .meters span { min-width:70px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:5px 8px; font-size:12px; }
  .meters strong { display:block; font:700 18px/1 "Courier New",monospace; color:#000080; }
  .stage { position:relative; width:min(calc(100vw - 36px),360px); margin:4px auto 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#101018; }
  canvas { display:block; width:100%; height:auto; image-rendering:pixelated; touch-action:none; user-select:none; -webkit-user-select:none; }
  .overlay { position:absolute; inset:0; display:grid; place-items:center; background:rgba(0,0,0,.45); }
  .overlay[hidden] { display:none; }
  .dialog { width:min(300px,86%); background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; box-shadow:2px 2px 0 #000; }
  .dlgbody { padding:14px; text-align:center; }
  .dlgbody p { margin:0 0 12px; font-size:13px; }
  .dlgbody button { min-width:120px; min-height:44px; background:#c0c0c0; border:2px solid; border-color:#fff #404040 #404040 #fff; font:inherit; font-weight:700; }
  .dlgbody button:active { border-color:#404040 #fff #fff #404040; }
  .status { margin:0 8px 8px; border:2px solid; border-color:#808080 #fff #fff #808080; background:#fff; padding:6px 8px; font:12px/1.35 "Courier New",monospace; }
</style>
