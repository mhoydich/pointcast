---
import FilaLayout from '../../layouts/FilaLayout.astro';
import FilaLookbook from '../../components/fila/FilaLookbook.astro';
---
<FilaLayout title="FILA / 2027 independent concept lookbook" description="Twelve independently imagined 2027 outfits: Court, Club and Coast. Swipe, filter, see front/back/detail views, enlarge the images and follow the design references.">
  <div class="lookbook-preface"><a href="/fila/">← The FILA exhibition</a><span>POINTCAST / INDEPENDENT DESIGN STUDY</span></div>
  <FilaLookbook primary />
  <section class="closing-note"><p>From Italian tennis to an imagined coastal wardrobe.</p><p>Original AI-generated concepts created 2 October 2026. No affiliation with FILA. No real products, prices or inventory. Materials and function are proposals, and detail views crop the rendered images.</p><a href="/fila/#genealogy-title">Explore the influence genealogy ↗</a><a href="/fila/#credits">Read all sources and image credits ↗</a></section>
</FilaLayout>
<style>.lookbook-preface{display:flex;justify-content:space-between;gap:20px;padding:24px var(--gutter);font:10px/1.6 'JetBrains Mono Variable',monospace}.lookbook-preface a{text-decoration:none}.closing-note{padding:55px var(--gutter);max-width:850px}.closing-note>p:first-child{font-size:35px;letter-spacing:-.045em;line-height:1.2}.closing-note>p:nth-child(2){font-size:12px;line-height:1.8}.closing-note a{display:block;font:11px/1.8 'JetBrains Mono Variable',monospace;margin-top:15px}@media(max-width:600px){.lookbook-preface{font-size:8px;padding:18px var(--gutter)}.lookbook-preface span{max-width:45%;text-align:right}.closing-note{padding:35px var(--gutter)}.closing-note>p:first-child{font-size:28px}}</style>
