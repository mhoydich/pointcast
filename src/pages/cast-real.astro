  // soundfont-player attaches itself to window as `Soundfont`.
  declare const Soundfont: any;

  // ---------- Note / chord helpers ----------
  // We use note-name strings that soundfont-player understands ('C4', 'F#3', etc.)
  function transpose(note: string, semis: number): string {
    const m = note.match(/^([A-G])(#|b)?(-?\d+)$/); if (!m) return note;
    const NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
    const nameToIdx: Record<string, number> = { 'C':0,'C#':1,'Db':1,'D':2,'D#':3,'Eb':3,'E':4,'F':5,'F#':6,'Gb':6,'G':7,'G#':8,'Ab':8,'A':9,'A#':10,'Bb':10,'B':11 };
    const root = m[1] + (m[2] || '');
    const oct = parseInt(m[3], 10);
    const idx = nameToIdx[root]; if (idx === undefined) return note;
    let total = oct * 12 + idx + semis;
    const newOct = Math.floor(total / 12);
    let newIdx = total - newOct * 12; if (newIdx < 0) newIdx += 12;
    return NAMES[newIdx] + newOct;
  }

  function chordNotes(rootNote: string, type: 'maj'|'min'|'maj7'|'min7'|'7sus'|'5'): string[] {
    const intervals = type === 'maj' ? [0,4,7] : type === 'min' ? [0,3,7] : type === 'maj7' ? [0,4,7,11] : type === 'min7' ? [0,3,7,10] : type === '7sus' ? [0,5,7,10] : [0,7];
    return intervals.map(s => transpose(rootNote, s));
  }

