  // ---------- Audio engine ----------
  // Shared scheduler — see src/lib/audio-scheduler.ts. Codex review fix:
  // pause() actually pauses, stop() stops scheduled drums.
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';
  let ctx: AudioContext | null = null;
  let sched: AudioScheduler | null = null;
  let masterBus: GainNode | null = null;
  let limiter: DynamicsCompressorNode | null = null;
  let reverbConv: ConvolverNode | null = null; let reverbSend: GainNode | null = null; let reverbReturn: GainNode | null = null;
  let outGain: GainNode | null = null;
  let volume = 68;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    sched = createAudioScheduler(ctx);
    masterBus = ctx.createGain(); masterBus.gain.value = 0.85;
    limiter = ctx.createDynamicsCompressor();
    limiter.threshold.value = -2.0; limiter.knee.value = 0.5; limiter.ratio.value = 18; limiter.attack.value = 0.001; limiter.release.value = 0.10;
    outGain = ctx.createGain(); outGain.gain.value = volume / 100;
    masterBus.connect(limiter); limiter.connect(outGain); outGain.connect(ctx.destination);

    reverbConv = ctx.createConvolver();
    const len = ctx.sampleRate * 2.4;
    const ir = ctx.createBuffer(2, len, ctx.sampleRate);
    for (let ch = 0; ch < 2; ch++) {
      const d = ir.getChannelData(ch); const offset = ch === 0 ? 0 : Math.floor(ctx.sampleRate * 0.013);
      for (let i = 0; i < len; i++) d[i] = (i < offset ? 0 : (Math.random()*2-1) * Math.pow(1 - i/len, 2.6));
    }
    reverbConv.buffer = ir;
    reverbSend = ctx.createGain(); reverbSend.gain.value = 1.0; // multiplied by per-voice amounts
    reverbReturn = ctx.createGain(); reverbReturn.gain.value = 0.45;
    reverbSend.connect(reverbConv); reverbConv.connect(reverbReturn); reverbReturn.connect(masterBus);

    // Audit fix #2: iOS Safari auto-suspends AudioContext on tab-switch.
    // When the user returns and we still believe we're playing, re-arm parked
    // timers so audio actually resumes.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running' && playing) {
        sched?.resume();
      }
    });

    return ctx;
  }

  // ---------- Soundfont cache + loader ----------
  // Codex review: CDN can hang, fail silently, or be blocked. Add a 12s
  // timeout per instrument and fail fast with a clear toast so the user
  // isn't trapped under a stuck loading overlay.
  const SOUNDFONT_TIMEOUT_MS = 12000;
  const instrumentCache = new Map<string, any>();
  const inFlight = new Map<string, Promise<any>>();

  function withTimeout<T>(p: Promise<T>, ms: number, label: string): Promise<T> {
    return new Promise<T>((resolve, reject) => {
      const t = window.setTimeout(() => reject(new Error(`Timeout loading ${label}`)), ms);
      p.then(v => { clearTimeout(t); resolve(v); }, e => { clearTimeout(t); reject(e); });
    });
  }

  async function loadInstrument(name: string, dest: AudioNode | null = null): Promise<any> {
    if (instrumentCache.has(name)) return instrumentCache.get(name);
    if (inFlight.has(name)) return inFlight.get(name);
    const c = ac();
    if (!(window as any).Soundfont) {
      // Script tag failed to load (CDN block / SRI / network)
      toast(`Soundfont library failed to load — refresh to retry`);
      return null;
    }
    // Audit fix #4: Soundfont.instrument() can throw synchronously on
    // malformed names or library regressions. Wrap so the throw doesn't
    // escape past the surrounding async wrapper as a single toast-per-call.
    let fetchPromise: Promise<any>;
    try {
      fetchPromise = (window as any).Soundfont.instrument(c, name, {
        soundfont: 'MusyngKite',
        destination: dest || masterBus!,
      });
    } catch (err) {
      console.error('soundfont sync throw', name, err);
      toast('Soundfont library error');
      return null;
    }
    const p = withTimeout<any>(fetchPromise, SOUNDFONT_TIMEOUT_MS, name)
      .then((inst: any) => {
        instrumentCache.set(name, inst);
        inFlight.delete(name);
        return inst;
      })
      .catch((err: any) => {
        console.error('soundfont load failed', name, err);
        inFlight.delete(name);
        toast(`Couldn't load ${name} (${err?.message?.startsWith('Timeout') ? 'timed out' : 'failed'})`);
        return null;
      });
    inFlight.set(name, p);
    return p;
  }

  function instrumentsForKit(kit: ArtistKitId): string[] {
    const k = KIT_INST[kit];
    return Array.from(new Set([k.lead, k.chord, k.bass]));
  }

  async function loadKitForSong(s: Song, onProgress: (name: string, done: boolean) => void): Promise<{ lead: any; chord: any; bass: any } | null> {
    const a = ARTISTS.find(x => x.id === s.artistId)!;
    const k = KIT_INST[a.kit];
    const names = instrumentsForKit(a.kit);
    names.forEach(n => onProgress(n, instrumentCache.has(n)));
    // Track per-instrument success — if ANY instrument failed we bail and
    // tell the caller, instead of silently degrading to drums-only.
    const results = await Promise.all(names.map(async n => {
      const inst = await loadInstrument(n);
      onProgress(n, inst != null);
      return inst != null;
    }));
    if (results.some(ok => !ok)) return null;
    return { lead: instrumentCache.get(k.lead)!, chord: instrumentCache.get(k.chord)!, bass: instrumentCache.get(k.bass)! };
  }

  // ---------- Synth drums (kept from cast-studio) ----------
  function playKick(when: number, kit: ArtistKitId) {
    const c = ac();
    const o = c.createOscillator(); const g = c.createGain();
    const sub = c.createOscillator(); const subG = c.createGain();
    const isBig = kit === 'block' || kit === 'friday';
    const isSoft = kit === 'fog' || kit === 'aurora' || kit === 'street' || kit === 'night';
    const peakHz = isBig ? 130 : isSoft ? 100 : 115;
    const tailHz = isBig ? 36 : isSoft ? 48 : 42;
    const len = isBig ? 0.42 : isSoft ? 0.30 : 0.36;
    o.frequency.setValueAtTime(peakHz, when);
    o.frequency.exponentialRampToValueAtTime(tailHz, when + len * 0.5);
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(isBig ? 1.10 : 0.80, when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    sub.type = 'sine'; sub.frequency.value = 50;
    subG.gain.setValueAtTime(0.001, when);
    subG.gain.exponentialRampToValueAtTime(isBig ? 0.50 : 0.28, when + 0.012);
    subG.gain.exponentialRampToValueAtTime(0.001, when + len * 1.2);
    o.connect(g); g.connect(masterBus!);
    sub.connect(subG); subG.connect(masterBus!);
    sched!.trackSource(o); o.start(when); o.stop(when + len + 0.05);
    sched!.trackSource(sub); sub.start(when); sub.stop(when + len * 1.2 + 0.05);
  }
  function playSnare(when: number, kit: ArtistKitId) {
    const c = ac();
    const isBrush = kit === 'fog' || kit === 'aurora' || kit === 'street' || kit === 'night';
    const len = isBrush ? 0.28 : 0.18;
    const noiseLen = c.sampleRate * len;
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < noiseLen; i++) d[i] = (Math.random()*2-1) * Math.pow(1 - i/noiseLen, isBrush ? 1.0 : 1.6);
    const s = c.createBufferSource(); s.buffer = buf;
    const f = c.createBiquadFilter(); f.type = isBrush ? 'highpass' : 'bandpass'; f.frequency.value = isBrush ? 800 : 2200; f.Q.value = isBrush ? 0.7 : 1.4;
    const g = c.createGain();
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(isBrush ? 0.30 : 0.50, when + 0.005);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    s.connect(f); f.connect(g); g.connect(masterBus!);
    // Send to reverb a bit
    const sg = c.createGain(); sg.gain.value = isBrush ? 0.40 : 0.25; g.connect(sg); sg.connect(reverbSend!);
    sched!.trackSource(s); s.start(when); s.stop(when + len + 0.05);
  }
  function playHat(when: number, type: 'closed' | 'open') {
    const c = ac();
    const len = type === 'open' ? 0.22 : 0.045;
    const noiseLen = c.sampleRate * len;
    const buf = c.createBuffer(1, noiseLen, c.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < noiseLen; i++) d[i] = (Math.random()*2-1) * Math.pow(1 - i/noiseLen, 0.6);
    const s = c.createBufferSource(); s.buffer = buf;
    const f = c.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = 7000;
    const g = c.createGain();
    g.gain.setValueAtTime(0.001, when);
    g.gain.exponentialRampToValueAtTime(type === 'open' ? 0.16 : 0.13, when + 0.002);
    g.gain.exponentialRampToValueAtTime(0.001, when + len);
    s.connect(f); f.connect(g); g.connect(masterBus!);
    sched!.trackSource(s); s.start(when); s.stop(when + len + 0.05);
  }

  type DrumPattern = { kick: number[]; snare: number[]; hatClosed: number[]; hatOpen: number[] };
  function drumPatternFor(name: Song['drumPattern'], bar: number, totalBars: number): DrumPattern {
    const last = bar === totalBars - 1;
    const z = (...steps: number[]) => { const a = Array(16).fill(0); steps.forEach(s => { if (s>=0&&s<16) a[s]=1; }); return a; };
    if (name === 'patient') return { kick: z(0,8), snare: z(4,12), hatClosed: z(2,6,10,14), hatOpen: last ? z(7,15) : z() };
    if (name === 'driving') return { kick: z(0,4,7,10,12,...(last ? [14,15] : [])), snare: z(4,12), hatClosed: z(0,2,4,6,8,10,12,14), hatOpen: z(7,15) };
    if (name === 'half') return { kick: z(0), snare: z(8), hatClosed: z(0,4,8,12), hatOpen: z() };
    if (name === 'broken') return { kick: z(0,6,10), snare: z(4,12), hatClosed: z(2,4,6,10,12,14), hatOpen: z(7) };
    if (name === 'parade') return { kick: z(0,4,8,12), snare: z(4,12), hatClosed: z(0,2,4,6,8,10,12,14), hatOpen: z() };
    return { kick: z(0,3,4,8,10,12,...(last ? [13,14,15] : [])), snare: z(4,12), hatClosed: z(0,2,4,6,8,10,12,14), hatOpen: z(2,6,10,14) };
  }

  // ---------- Lead / bass patterns ----------
  function leadPatternFor(style: Song['leadStyle'], bar: number): { step: number; offset: number; dur: number; vel?: number }[] {
    if (style === 'silent') return [];
    if (style === 'arp') {
      const out: { step: number; offset: number; dur: number; vel?: number }[] = [];
      for (let s = 0; s < 16; s += 2) out.push({ step: s, offset: (s/2) % 4, dur: 0.18, vel: 0.65 });
      return out;
    }
    if (style === 'hold') return [{ step: 0, offset: 0, dur: 1.7, vel: 0.45 }];
    if (style === 'phrase') {
      const phrases = [
        [{ step: 0, offset: 2, dur: 0.42 }, { step: 4, offset: 1, dur: 0.42 }, { step: 8, offset: 0, dur: 0.42 }, { step: 12, offset: 2, dur: 0.42 }],
        [{ step: 2, offset: 3, dur: 0.32 }, { step: 6, offset: 2, dur: 0.32 }, { step: 10, offset: 1, dur: 0.32 }, { step: 14, offset: 0, dur: 0.32 }],
        [{ step: 0, offset: 0, dur: 0.62 }, { step: 6, offset: 2, dur: 0.42 }, { step: 12, offset: 3, dur: 0.42 }],
        [{ step: 0, offset: 2, dur: 0.32 }, { step: 2, offset: 1, dur: 0.32 }, { step: 4, offset: 0, dur: 0.32 }, { step: 8, offset: 2, dur: 0.62 }],
      ];
      return phrases[bar % phrases.length];
    }
    return [{ step: 0, offset: 2, dur: 0.85 }, { step: 8, offset: 0, dur: 0.85 }];
  }
  function bassPatternFor(style: Song['bassStyle']): { step: number; degree: number; dur: number }[] {
    if (style === 'silent') return [];
    if (style === 'root') return [{ step: 0, degree: 0, dur: 0.6 }, { step: 8, degree: 0, dur: 0.6 }];
    if (style === 'walking') return [{ step: 0, degree: 0, dur: 0.40 }, { step: 4, degree: 7, dur: 0.40 }, { step: 8, degree: 4, dur: 0.40 }, { step: 12, degree: 7, dur: 0.40 }];
    return [{ step: 0, degree: 0, dur: 0.30 }, { step: 4, degree: 12, dur: 0.30 }, { step: 8, degree: 0, dur: 0.30 }, { step: 12, degree: 12, dur: 0.30 }];
  }

  // ---------- Sequencer ----------
  // activePlayers tracks soundfont-player handles (separate from sched.trackSource
  // which only knows about Web Audio source nodes — soundfont returns its own
  // handle objects).
  let activePlayers: any[] = [];
  let currentSongIdx = 0; let currentSong: Song | null = null;
  let playStartCtxTime = 0; let playing = false; let rafId = 0;
  let onBarChange: ((bar: number, step: number) => void) | null = null;
  function clearScheduled() {
    if (sched) sched.stopAll(); // stops scheduled drum sources + auto-advance
    activePlayers.forEach(p => { try { p.stop && p.stop(); } catch {} });
    activePlayers = [];
    cancelAnimationFrame(rafId);
  }
  function songDurationSec(s: Song) { return s.bars * (60/s.bpm) * 4; }

  async function playSong(idx: number) {
    if (idx < 0 || idx >= SONGS.length) return;
    const c = ac(); if (c.state === 'suspended') c.resume();
    clearScheduled();
    currentSongIdx = idx; currentSong = SONGS[idx];
    const s = currentSong;
    const a = ARTISTS.find(x => x.id === s.artistId)!;

    // Show loading overlay if any instrument needs to be fetched
    const names = instrumentsForKit(a.kit);
    const needsLoad = names.some(n => !instrumentCache.has(n));
    if (needsLoad) {
      showLoading(s, a, names);
    }
    let kit: { lead: any; chord: any; bass: any } | null;
    try {
      kit = await loadKitForSong(s, (name, done) => updateLoadingItem(name, done));
    } catch (e) {
      hideLoading();
      toast('Could not load samples — check connection');
      return;
    }
    hideLoading();
    if (!kit) {
      // loadKitForSong returned null = at least one instrument failed.
      // Toast was already shown by loadInstrument; bail out instead of
      // silently degrading to drums-only.
      return;
    }
    if (currentSongIdx !== idx) return; // user changed songs while loading

    const beat = 60 / s.bpm; const step = beat / 4;
    const startAt = c.currentTime + 0.05;
    playStartCtxTime = startAt;

    let curBar = 0;
    s.chords.forEach((ch) => {
      for (let b = 0; b < ch.bars; b++, curBar++) {
        const barStart = startAt + curBar * 4 * beat;
        const cn = chordNotes(ch.root, ch.type);
        // Pad: hold all chord notes for the bar
        cn.forEach(note => {
          try {
            const handle = kit.chord.play(note, barStart, { duration: 4 * beat * 0.95, gain: 0.30 });
            if (handle) activePlayers.push(handle);
          } catch (e) { /* ignore */ }
        });
        // Drums
        const dp = drumPatternFor(s.drumPattern, curBar, s.bars);
        for (let i = 0; i < 16; i++) {
          const t = barStart + i * step;
          if (dp.kick[i]) playKick(t, a.kit);
          if (dp.snare[i]) playSnare(t, a.kit);
          if (dp.hatClosed[i]) playHat(t, 'closed');
          if (dp.hatOpen[i]) playHat(t, 'open');
        }
        // Lead
        const leadEvts = leadPatternFor(s.leadStyle, curBar);
        leadEvts.forEach(ev => {
          const note = transpose(cn[ev.offset % cn.length], 12); // octave up
          try {
            const handle = kit.lead.play(note, barStart + ev.step * step, { duration: ev.dur * beat * 0.9, gain: (ev.vel ?? 0.6) * 0.5 });
            if (handle) activePlayers.push(handle);
          } catch (e) {}
        });
        // Bass
        const bassEvts = bassPatternFor(s.bassStyle);
        bassEvts.forEach(ev => {
          const root = transpose(ch.root, -12); // octave down for bass
          const note = transpose(root, ev.degree);
          try {
            const handle = kit.bass.play(note, barStart + ev.step * step, { duration: ev.dur * beat * 0.9, gain: 0.55 });
            if (handle) activePlayers.push(handle);
          } catch (e) {}
        });
      }
    });

    // Auto-advance scheduled in AudioContext-time so it parks on pause.
    const dur = songDurationSec(s);
    const next = (idx + 1) % SONGS.length;
    sched!.schedule(() => playSong(next), startAt + dur - 1.2);

    playing = true; setPlayIcon(true); setBarMeta(s, a); setAmbient(s.color);
    runProgress(); render();
  }

  async function pause() {
    if (!ctx || !sched) return;
    await sched.pause(); // suspends ctx + parks pending timers
    playing = false; setPlayIcon(false); cancelAnimationFrame(rafId);
  }
  async function resume() {
    if (!ctx || !sched) { playSong(currentSongIdx); return; }
    await sched.resume(); // resumes ctx + re-arms parked timers
    playing = true; setPlayIcon(true); runProgress();
  }
  function stop() { clearScheduled(); playing = false; setPlayIcon(false); }

  function setPlayIcon(on: boolean) {
    const svg = document.getElementById('cr-play-svg');
    if (svg) svg.innerHTML = on ? '<path d="M10 8h4v16h-4z M18 8h4v16h-4z" fill="currentColor"/>' : '<path d="M11 8l13 8-13 8z" fill="currentColor"/>';
  }

  function runProgress() {
    cancelAnimationFrame(rafId);
    const tick = () => {
      if (!ctx || !playing || !currentSong) return;
      const elapsed = ctx.currentTime - playStartCtxTime;
      const dur = songDurationSec(currentSong);
      const pct = Math.max(0, Math.min(1, elapsed / dur));
      const fill = document.getElementById('cr-prog-fill') as HTMLDivElement;
      if (fill) fill.style.width = (pct * 100) + '%';
      const cur = document.getElementById('cr-time-cur') as HTMLSpanElement;
      const tot = document.getElementById('cr-time-tot') as HTMLSpanElement;
      if (cur) cur.textContent = fmtTime(elapsed);
      if (tot) tot.textContent = fmtTime(dur);
      if (onBarChange) {
        const beat = 60 / currentSong.bpm; const step = beat / 4;
        const totalSteps = Math.floor(elapsed / step);
        const bar = Math.min(currentSong.bars - 1, Math.floor(totalSteps / 16));
        const inBarStep = totalSteps % 16;
        onBarChange(bar, inBarStep);
      }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }
  function fmtTime(sec: number) { sec = Math.max(0, sec); const m = Math.floor(sec/60); const s = Math.floor(sec%60); return `${m}:${String(s).padStart(2,'0')}`; }

  function setBarMeta(s: Song, a: Artist) {
    const name = document.getElementById('cr-bar-name') as HTMLParagraphElement;
    const artist = document.getElementById('cr-bar-artist') as HTMLParagraphElement;
    const art = document.getElementById('cr-bar-art') as HTMLImageElement;
    if (name) name.textContent = s.name;
    if (artist) artist.textContent = `${a.name} · ${KIT_INST[a.kit].leadHumanName} + ${KIT_INST[a.kit].chordHumanName} + ${KIT_INST[a.kit].bassHumanName}`;
    if (art) { art.src = `https://noun.pics/${a.nounId}.svg`; art.hidden = false; }
    const frame = document.querySelector<HTMLDivElement>('.cr__bar-art-frame'); if (frame) frame.style.setProperty('--art-c1', s.color);
  }

  function setAmbient(color: string) {
    const c = parseHex(color);
    const el = document.getElementById('cr-ambient'); if (!el) return;
    el.style.setProperty('--ambient-c1', `rgba(${c.r},${c.g},${c.b},0.55)`);
    el.style.setProperty('--ambient-c2', `rgba(${Math.max(c.r-60,0)},${Math.max(c.g-60,0)},${Math.max(c.b-60,0)},0.85)`);
  }
  function parseHex(h: string) { const m = h.replace('#',''); return { r: parseInt(m.slice(0,2),16), g: parseInt(m.slice(2,4),16), b: parseInt(m.slice(4,6),16) }; }

  // ---------- Loading overlay ----------
  function showLoading(s: Song, a: Artist, names: string[]) {
    const el = document.getElementById('cr-loading') as HTMLDivElement;
    const title = document.getElementById('cr-loading-title') as HTMLParagraphElement;
    const sub = document.getElementById('cr-loading-sub') as HTMLParagraphElement;
    const list = document.getElementById('cr-loading-list') as HTMLUListElement;
    if (!el) return;
    title.textContent = `Loading ${a.name}'s kit`;
    sub.textContent = `Fetching ~${names.length * 2}MB of recorded samples for "${s.name}"`;
    list.innerHTML = names.map(n => {
      const human = humanNameFor(n);
      return `<li id="cr-load-${escapeId(n)}" class="${instrumentCache.has(n) ? 'cr__loading-li--done' : 'cr__loading-li--pending'}"><span>${human}</span></li>`;
    }).join('');
    el.hidden = false;
  }
  function updateLoadingItem(name: string, done: boolean) {
    const li = document.getElementById(`cr-load-${escapeId(name)}`); if (!li) return;
    li.className = done ? 'cr__loading-li--done' : 'cr__loading-li--pending';
  }
  function hideLoading() { const el = document.getElementById('cr-loading') as HTMLDivElement; if (el) el.hidden = true; }
  function escapeId(s: string) { return s.replace(/[^a-z0-9]/gi, '_'); }
  function humanNameFor(midiName: string) {
    return midiName.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  }

  // ---------- Toast ----------
  function toast(msg: string) {
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;bottom:110px;right:22px;background:rgba(13,6,16,0.96);border:1px solid rgba(244,231,200,0.10);color:#f4e7c8;padding:12px 18px;border-radius:10px;font-family:Inter,system-ui,sans-serif;font-size:13.5px;font-weight:500;box-shadow:0 8px 24px rgba(0,0,0,0.55);backdrop-filter:blur(12px);z-index:9999;';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity 0.3s ease'; setTimeout(() => el.remove(), 320); }, 2400);
  }

  // ---------- UI render ----------
  let view: 'home' | 'kits' | 'about' = 'home';
  function escape(s: string) { return s.replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' } as Record<string,string>)[c]!); }

  function render() {
    document.querySelectorAll<HTMLElement>('.cr__nav-btn').forEach(b => b.classList.toggle('cr__nav-btn--active', b.dataset.view === view));
    const v = document.getElementById('cr-view') as HTMLDivElement;
    if (!v) return;
    let html = '';
    if (view === 'home') html = renderHome();
    else if (view === 'kits') html = renderKits();
    else html = renderAbout();
    v.innerHTML = html;
    bindView(v);

    if (currentSong) {
      onBarChange = (bar, _step) => {
        const cells = v.querySelectorAll<HTMLDivElement>('.cr__chord-cell');
        cells.forEach((c, i) => c.classList.toggle('cr__chord-cell--active', i === bar));
        const lines = v.querySelectorAll<HTMLDivElement>('.cr__lyrics-line');
        const lineIdx = bar % (currentSong!.lyric.length);
        lines.forEach((l, i) => l.classList.toggle('cr__lyrics-line--active', i === lineIdx));
      };
    } else { onBarChange = null; }
  }

  function renderHome(): string {
    const todayIdx = new Date().getDate() % SONGS.length;
    const today = SONGS[todayIdx];
    const todayArtist = ARTISTS.find(a => a.id === today.artistId)!;
    const callout = `<div class="cr__intro-callout"><h3 class="cr__intro-title">Real recorded instruments — for the first time on this site</h3><p class="cr__intro-body">First time you tap a song, the page downloads <strong>real MP3 samples</strong> of the kit's instruments from <code>gleitz.github.io/midi-js-soundfonts</code> (CC0). After that, they're cached. Each Noun artist gets a <strong>different real instrument</strong> — Brass on Main has a real trumpet, Main Street has a real vibraphone, Aurora Slow has a real flute over a real choir pad.</p></div>`;
    const detail = currentSong ? renderDetail(currentSong) : '';
    return `
      <section class="cr__hero" style="--hero-c: ${today.color}aa;">
        <p class="cr__hero-kicker">CAST · real · today's session</p>
        <h1 class="cr__hero-title">${escape(today.name)}</h1>
        <p class="cr__hero-sub">By ${escape(todayArtist.name)} · 8 bars · ${today.bpm} bpm. The lead is ${KIT_INST[todayArtist.kit].leadHumanName}, chords are ${KIT_INST[todayArtist.kit].chordHumanName}, bass is ${KIT_INST[todayArtist.kit].bassHumanName}. Tap to load and play.</p>
      </section>
      ${callout}
      ${detail}
      <section class="cr__section">
        <header class="cr__section-head"><h2 class="cr__section-title">Sessions · ${SONGS.length} songs</h2></header>
        <div class="cr__grid">
          ${SONGS.map((s, i) => {
            const a = ARTISTS.find(x => x.id === s.artistId)!;
            const cur = currentSongIdx === i && playing;
            const k = KIT_INST[a.kit];
            return `<div class="cr__card ${cur ? 'cr__card--playing' : ''}" data-song-idx="${i}" style="--card-c1: ${s.color};">
              <div class="cr__card-art"><img src="https://noun.pics/${a.nounId}.svg" alt="" loading="lazy"/></div>
              <div class="cr__card-meta">
                <p class="cr__card-name">${escape(s.name)}</p>
                <p class="cr__card-artist">${escape(a.name)} · ${s.bpm} bpm</p>
                <div class="cr__card-tags">
                  <span class="cr__card-tag cr__card-tag--instrument">${k.leadHumanName}</span>
                  <span class="cr__card-tag">${s.tag}</span>
                </div>
              </div>
              <button class="cr__card-play" data-song-idx="${i}" type="button">${cur ? '⏸' : '▶'}</button>
            </div>`;
          }).join('')}
        </div>
      </section>
    `;
  }

  function renderDetail(s: Song): string {
    const a = ARTISTS.find(x => x.id === s.artistId)!;
    const k = KIT_INST[a.kit];
    const status = (n: string) => instrumentCache.has(n) ? '<span class="cr__inst-status cr__inst-status--loaded">● loaded</span>' : '<span class="cr__inst-status cr__inst-status--loading">○ on demand</span>';
    return `
      <div class="cr__detail">
        <div class="cr__detail-head">
          <div class="cr__detail-art" style="--detail-c: ${s.color};"><img src="https://noun.pics/${a.nounId}.svg" alt=""/></div>
          <div class="cr__detail-meta">
            <p class="cr__detail-kicker">Now playing</p>
            <h2 class="cr__detail-name">${escape(s.name)}</h2>
            <p class="cr__detail-artist">${escape(a.name)} · ${s.tag} · ${s.bpm} bpm · ${s.bars} bars</p>
          </div>
        </div>

        <div class="cr__inst-row">
          <div class="cr__inst"><p class="cr__inst-label">Lead instrument ${status(k.lead)}</p><p class="cr__inst-name">${k.leadHumanName}</p><p class="cr__inst-sub">${k.lead}</p></div>
          <div class="cr__inst"><p class="cr__inst-label">Chord instrument ${status(k.chord)}</p><p class="cr__inst-name">${k.chordHumanName}</p><p class="cr__inst-sub">${k.chord}</p></div>
          <div class="cr__inst"><p class="cr__inst-label">Bass instrument ${status(k.bass)}</p><p class="cr__inst-name">${k.bassHumanName}</p><p class="cr__inst-sub">${k.bass}</p></div>
        </div>

        <p class="cr__side-label">CHORD PROGRESSION · 1 bar each</p>
        <div class="cr__chord-strip">
          ${s.chords.map((c, i) => `<div class="cr__chord-cell"><span class="cr__chord-num">bar ${i+1}</span>${c.root.replace(/[2-5]/,'')}${c.type === 'maj' ? '' : c.type === 'min' ? 'm' : c.type}</div>`).join('')}
        </div>

        <div class="cr__lyrics-block">
          <p class="cr__side-label">LYRIC · 1 line per bar · highlights with the chord</p>
          ${s.lyric.map(l => `<p class="cr__lyrics-line">${escape(l)}</p>`).join('')}
        </div>
      </div>
    `;
  }

  function renderKits(): string {
    return `<div class="cr__kits-view">
      <h1 class="cr__hero-title" style="font-size:42px;margin:8px 0 4px 0;">Kits</h1>
      <p class="cr__hero-sub" style="margin-bottom:24px;color:var(--cr-text-mute);">Eight Nouns · eight kits. Each one plays the same chord progressions but with different recorded instruments. Tap a preview to hear that kit's lead.</p>
      <div class="cr__kits-grid">
        ${ARTISTS.map(a => {
          const k = KIT_INST[a.kit];
          return `<div class="cr__kit" style="--kit-c: ${a.color};">
            <div class="cr__kit-hd">
              <div class="cr__kit-portrait"><img src="https://noun.pics/${a.nounId}.svg" alt=""/></div>
              <div><p class="cr__kit-name">${escape(a.name)}</p><p class="cr__kit-id">NOUN #${a.nounId} · ${a.kit}</p></div>
            </div>
            <ul class="cr__kit-list">
              <li><b>LEAD</b> ${k.leadHumanName}</li>
              <li><b>CHORD</b> ${k.chordHumanName}</li>
              <li><b>BASS</b> ${k.bassHumanName}</li>
            </ul>
            <div class="cr__kit-preview">
              <button class="cr__kit-preview-btn" data-preview-kit="${a.kit}" data-preview-role="lead" type="button">▶ lead</button>
              <button class="cr__kit-preview-btn" data-preview-kit="${a.kit}" data-preview-role="chord" type="button">▶ chord</button>
              <button class="cr__kit-preview-btn" data-preview-kit="${a.kit}" data-preview-role="bass" type="button">▶ bass</button>
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  }

  function renderAbout(): string {
    return `<div class="cr__about">
      <h1>About CAST · real</h1>
      <p>Earlier music apps on this site (<code>cast-music</code>, <code>cast-music-pro</code>, <code>cast-studio</code>) all use the Web Audio API to <strong>synthesize</strong> sound from oscillators. They sound okay but they don't sound like instruments — they sound like a sequencer.</p>
      <p>This page swaps the synthesized lead, chord, and bass voices for <strong>real recorded instrument samples</strong> via <code>soundfont-player</code> (MIT) loading from <code>gleitz.github.io/midi-js-soundfonts</code> (CC0). Each Noun artist gets a different real instrument.</p>

      <h2>What's recorded vs. synthesized?</h2>
      <p><strong>Recorded:</strong> trumpet, vibraphone, flute, electric piano, choir pad, grand piano, sweep pad, sawtooth lead, charang, synth brass, acoustic bass, tuba, electric bass, synth bass — anything tonal in the kit list.</p>
      <p><strong>Synthesized:</strong> drums (kick, snare, hat) — the General MIDI percussion bank is a different format that adds significant complexity, and the synth drums from <code>cast-studio</code> already sound decent. Future ship: native sample drums via <code>Tone.js</code>.</p>

      <h2>Why does it download samples?</h2>
      <p>Each instrument in the MIDI.js soundfont is a small bank of recorded MP3 samples (one per pitch range). They live on a CDN and are fetched on demand. First play of a kit downloads ~5–15MB; after that, samples are cached in memory and play instantly. Stop the page from working? Refresh — the cache resets but the CDN still has them.</p>

      <h2>Tradeoffs</h2>
      <p><strong>Pro:</strong> instruments actually sound like instruments. Trumpet sounds like trumpet. Vibraphone has bell tones with bloom. Choir pad has actual vowel formants. <strong>Con:</strong> First play of each kit is slow (1–4 seconds depending on connection). External CDN dependency.</p>

      <h2>What's next</h2>
      <p>A Nouns drum audio teacher — interactive lessons on stereo, binaural beats, how instruments are made, AM vs FM modulation, the physics of room reverb. One Noun teacher per topic, all pulled from real Web Audio primitives.</p>
    </div>`;
  }

  function bindView(v: HTMLDivElement) {
    v.querySelectorAll<HTMLElement>('[data-song-idx]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(el.dataset.songIdx);
        if (currentSongIdx === idx && playing) { pause(); return; }
        if (currentSongIdx === idx && !playing && ctx) { resume(); return; }
        playSong(idx);
      });
    });
    v.querySelectorAll<HTMLButtonElement>('.cr__kit-preview-btn').forEach(b => {
      b.addEventListener('click', async () => {
        const kit = b.dataset.previewKit as ArtistKitId; const role = b.dataset.previewRole as 'lead' | 'chord' | 'bass';
        const k = KIT_INST[kit]; const instName = k[role];
        b.textContent = '↓ load';
        const inst = await loadInstrument(instName);
        if (!inst) { b.textContent = '✗ failed'; return; }
        const c = ac(); if (c.state === 'suspended') c.resume();
        b.textContent = '♪ play';
        // Play a short C-major-ish lick
        const notes = role === 'bass' ? ['C2', 'G2', 'C3', 'G2'] : role === 'chord' ? ['C4', 'E4', 'G4', 'B4'] : ['C5', 'E5', 'G5', 'C6'];
        const now = c.currentTime + 0.05;
        notes.forEach((n, i) => { try { inst.play(n, now + i * 0.22, { duration: 0.4, gain: 0.5 }); } catch {} });
        setTimeout(() => { b.textContent = `▶ ${role}`; }, 1200);
      });
    });
  }

  function bindGlobal() {
    document.querySelectorAll<HTMLButtonElement>('.cr__nav-btn').forEach(b => b.addEventListener('click', () => { view = b.dataset.view as any; render(); }));
    // Audit fix #5: await async pause/resume + debounce rapid clicks.
    let crLastPlayToggle = 0;
    document.getElementById('cr-play')!.addEventListener('click', async () => {
      const now = Date.now(); if (now - crLastPlayToggle < 100) return; crLastPlayToggle = now;
      if (!ctx) { playSong(0); return; }
      if (playing) await pause(); else await resume();
    });
    document.getElementById('cr-prev')!.addEventListener('click', () => { stop(); playSong((currentSongIdx - 1 + SONGS.length) % SONGS.length); });
    document.getElementById('cr-next')!.addEventListener('click', () => { stop(); playSong((currentSongIdx + 1) % SONGS.length); });
    document.getElementById('cr-vol')!.addEventListener('input', (e) => { volume = Number((e.target as HTMLInputElement).value); if (outGain) outGain.gain.setTargetAtTime(volume / 100, ac().currentTime, 0.05); });
    (document.getElementById('cr-vol') as HTMLInputElement).value = String(volume);
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); if (playing) pause(); else if (!ctx) playSong(0); else resume(); }
      if (e.key === 'ArrowRight') { stop(); playSong((currentSongIdx + 1) % SONGS.length); }
      if (e.key === 'ArrowLeft') { stop(); playSong((currentSongIdx - 1 + SONGS.length) % SONGS.length); }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    bindGlobal();
    render();
  });
</script>
</BlockLayout>