---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="CAST · real · actual recorded instruments" description="Same songs, real samples. Per-Noun-artist instrument mapping using CC0 GM soundfont samples loaded from CDN — real piano, real trumpet, real choir, real vibraphone, real flute.">
  <main class="cr" id="cr" data-built={built}>
    <div class="cr__ambient" id="cr-ambient" aria-hidden="true"></div>

    <div class="cr__shell">
      <aside class="cr__side">
        <header class="cr__brand">
          <div class="cr__brand-mark"><img src="https://noun.pics/287.svg" alt=""/></div>
          <div>
            <p class="cr__brand-name">CAST · real</p>
            <p class="cr__brand-tag">recorded · not synthesized</p>
          </div>
        </header>

        <nav class="cr__nav">
          <button class="cr__nav-btn cr__nav-btn--active" data-view="home" type="button"><span class="cr__nav-icon">⌂</span><span>Studio</span></button>
          <button class="cr__nav-btn" data-view="kits" type="button"><span class="cr__nav-icon">◉</span><span>Kits</span></button>
          <button class="cr__nav-btn" data-view="about" type="button"><span class="cr__nav-icon">?</span><span>About</span></button>
        </nav>

        <div class="cr__side-section">
          <p class="cr__side-label">WHAT'S NEW</p>
          <p class="cr__side-note">The lead, chord, and bass voices are now <strong>recorded instrument samples</strong> instead of synthesized waves. Each Noun artist gets a different real instrument. Drums stay synth.</p>
        </div>

        <div class="cr__side-section">
          <p class="cr__side-label">SAMPLE SOURCE</p>
          <p class="cr__side-note">MIDI.js soundfonts (CC0) hosted at <code>gleitz.github.io/midi-js-soundfonts</code>. Each instrument is a ~1–3MB MP3 sample bank. First play of a song downloads its kit; subsequent plays are instant.</p>
        </div>

        <div class="cr__side-section">
          <p class="cr__side-label">ALSO TRY</p>
          <ul class="cr__siblings">
            <li><a href="/cast-music-pro">cast-music-pro</a> — the polish layer</li>
            <li><a href="/cast-studio">cast-studio</a> — the synth engine</li>
          </ul>
        </div>

        <footer class="cr__side-foot">
          <p>Built {built.slice(0,10)}</p>
          <p><a href="/" class="cr__side-link">← back to PointCast</a></p>
        </footer>
      </aside>

      <section class="cr__main">
        <div class="cr__view" id="cr-view"></div>
      </section>
    </div>

    <footer class="cr__bar" id="cr-bar">
      <div class="cr__bar-l">
        <div class="cr__bar-art-frame"><img src="" alt="" id="cr-bar-art" hidden/></div>
        <div class="cr__bar-meta">
          <p class="cr__bar-name" id="cr-bar-name">— studio idle</p>
          <p class="cr__bar-artist" id="cr-bar-artist">tap a session to load samples + play</p>
        </div>
      </div>
      <div class="cr__bar-c">
        <div class="cr__bar-controls">
          <button class="cr__bar-btn" id="cr-prev" type="button" aria-label="Previous">⏮</button>
          <button class="cr__bar-play" id="cr-play" type="button" aria-label="Play">
            <svg viewBox="0 0 32 32" width="22" height="22" id="cr-play-svg"><path d="M11 8l13 8-13 8z" fill="currentColor"/></svg>
          </button>
          <button class="cr__bar-btn" id="cr-next" type="button" aria-label="Next">⏭</button>
        </div>
        <div class="cr__bar-prog">
          <span class="cr__bar-time" id="cr-time-cur">0:00</span>
          <div class="cr__bar-prog-track">
            <div class="cr__bar-prog-fill" id="cr-prog-fill"></div>
          </div>
          <span class="cr__bar-time" id="cr-time-tot">0:00</span>
        </div>
      </div>
      <div class="cr__bar-r">
        <div class="cr__bar-vol">
          <span class="cr__bar-vol-icon">♪</span>
          <input type="range" class="cr__bar-vol-slider" id="cr-vol" min="0" max="100" value="68"/>
        </div>
      </div>
    </footer>
  </main>

  <!-- Loading overlay shown when fetching soundfont samples -->
  <div class="cr__loading" id="cr-loading" hidden>
    <div class="cr__loading-card">
      <div class="cr__loading-spinner"></div>
      <p class="cr__loading-title" id="cr-loading-title">Loading instruments…</p>
      <p class="cr__loading-sub" id="cr-loading-sub">First play of this kit downloads samples from CDN</p>
      <ul class="cr__loading-list" id="cr-loading-list"></ul>
    </div>
  </div>
</BlockLayout>

<script src="https://unpkg.com/soundfont-player@0.12.0/dist/soundfont-player.min.js" is:inline></script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --cr-bg: #0c0608; --cr-bg-2: #170a10;
    --cr-walnut: #5a3422; --cr-brass: #d4a437; --cr-flame: #f6c15e;
    --cr-cream: #f4e7c8; --cr-velvet: #1a0820;
    --cr-glass: rgba(244,231,200,0.04); --cr-glass-hi: rgba(244,231,200,0.08);
    --cr-line: rgba(244,231,200,0.10);
    --cr-text: #f4e7c8; --cr-text-mute: rgba(244,231,200,0.62); --cr-text-quiet: rgba(244,231,200,0.38);
    --cr-display: 'Inter Tight', system-ui, sans-serif;
    --cr-body: 'Inter', system-ui, sans-serif;
    --cr-mono: 'JetBrains Mono', ui-monospace, monospace;
    --cr-shadow-md: 0 8px 24px rgba(0,0,0,0.42);
    --cr-shadow-lg: 0 24px 60px rgba(0,0,0,0.55);
  }

  body { background: var(--cr-bg); color: var(--cr-text); font-family: var(--cr-body); }
  .cr { position: relative; min-height: 100vh; padding-bottom: 92px; overflow: hidden; isolation: isolate; }
  .cr__ambient {
    position: fixed; inset: 0; z-index: -1;
    background:
      radial-gradient(80% 60% at 20% 30%, var(--ambient-c1, #5a3422) 0%, transparent 60%),
      radial-gradient(60% 50% at 80% 80%, var(--ambient-c2, #1a0820) 0%, transparent 60%),
      linear-gradient(180deg, #0c0608 0%, #170a10 100%);
    filter: blur(40px) saturate(1.05); transform: scale(1.05);
    transition: --ambient-c1 1.6s ease, --ambient-c2 1.6s ease;
  }

  .cr__shell { display: grid; grid-template-columns: 280px 1fr; gap: 8px; padding: 8px 8px 0 8px; height: calc(100vh - 92px); min-height: 600px; }
  @media (max-width: 800px) { .cr__shell { grid-template-columns: 1fr; } .cr__side { display: none; } }

  .cr__side { background: linear-gradient(180deg, rgba(23,10,16,0.96), rgba(12,6,8,0.96)); border: 1px solid var(--cr-line); border-radius: 14px; padding: 18px 14px; overflow-y: auto; backdrop-filter: blur(12px); }
  .cr__side::-webkit-scrollbar { width: 6px; } .cr__side::-webkit-scrollbar-thumb { background: rgba(244,231,200,0.10); border-radius: 3px; }

  .cr__brand { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; padding: 0 4px; }
  .cr__brand-mark { width: 42px; height: 42px; background: var(--cr-velvet); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.30); }
  .cr__brand-mark img { width: 100%; height: 100%; image-rendering: pixelated; }
  .cr__brand-name { font-family: var(--cr-display); font-weight: 800; font-size: 17px; line-height: 1; margin: 0 0 3px 0; letter-spacing: -0.01em; }
  .cr__brand-tag { font-family: var(--cr-mono); font-size: 9.5px; color: var(--cr-text-quiet); letter-spacing: 0.4px; margin: 0; text-transform: uppercase; }

  .cr__nav { display: flex; flex-direction: column; gap: 2px; margin-bottom: 22px; }
  .cr__nav-btn { display: flex; align-items: center; gap: 14px; background: transparent; border: 0; padding: 11px 12px; color: var(--cr-text-mute); font-family: var(--cr-body); font-weight: 600; font-size: 13.5px; border-radius: 8px; cursor: pointer; text-align: left; transition: all 0.18s ease; }
  .cr__nav-btn:hover { background: var(--cr-glass); color: var(--cr-text); transform: translateX(2px); }
  .cr__nav-btn--active { background: var(--cr-glass-hi); color: var(--cr-flame); }
  .cr__nav-icon { font-size: 16px; width: 20px; display: inline-block; text-align: center; }

  .cr__side-section { margin-bottom: 20px; padding: 0 4px; }
  .cr__side-label { font-family: var(--cr-mono); font-size: 10px; letter-spacing: 0.6px; color: var(--cr-text-quiet); margin: 0 0 10px 0; text-transform: uppercase; }
  .cr__side-note { font-family: var(--cr-body); font-size: 12px; color: var(--cr-text-mute); line-height: 1.55; margin: 0; }
  .cr__side-note code { font-family: var(--cr-mono); font-size: 10.5px; background: var(--cr-velvet); padding: 1px 5px; border-radius: 3px; color: var(--cr-flame); }
  .cr__siblings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .cr__siblings li { font-family: var(--cr-body); font-size: 12.5px; color: var(--cr-text-mute); }
  .cr__siblings a { color: var(--cr-flame); text-decoration: none; }
  .cr__siblings a:hover { text-decoration: underline; }

  .cr__side-foot { margin-top: 24px; padding: 12px 4px 4px 4px; border-top: 1px solid var(--cr-line); font-family: var(--cr-mono); font-size: 10px; color: var(--cr-text-quiet); line-height: 1.6; }
  .cr__side-link { color: var(--cr-flame); text-decoration: none; }
  .cr__side-link:hover { text-decoration: underline; }

  .cr__main { background: linear-gradient(180deg, rgba(23,10,16,0.92), rgba(12,6,8,0.92) 70%); border: 1px solid var(--cr-line); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; backdrop-filter: blur(12px); }
  .cr__view { flex: 1; overflow-y: auto; padding: 0; animation: cr-view-in 0.34s cubic-bezier(0.2,0.8,0.2,1); }
  .cr__view::-webkit-scrollbar { width: 8px; } .cr__view::-webkit-scrollbar-thumb { background: rgba(244,231,200,0.12); border-radius: 4px; }
  @keyframes cr-view-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  /* Hero banner */
  .cr__hero { padding: 44px 32px 28px 32px; background: linear-gradient(180deg, var(--hero-c, #5a3422) 0%, transparent 100%); }
  .cr__hero-kicker { font-family: var(--cr-mono); font-size: 11px; letter-spacing: 0.7px; color: rgba(255,255,255,0.78); margin: 0 0 10px 0; text-transform: uppercase; }
  .cr__hero-title { font-family: var(--cr-display); font-weight: 800; font-size: clamp(40px,6vw,72px); line-height: 0.96; letter-spacing: -0.02em; margin: 0 0 14px 0; color: #fff; }
  .cr__hero-sub { font-family: var(--cr-body); font-size: 15px; color: rgba(255,255,255,0.84); max-width: 640px; line-height: 1.55; margin: 0; }

  .cr__section { padding: 28px 32px; }
  .cr__section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  .cr__section-title { font-family: var(--cr-display); font-weight: 700; font-size: 22px; letter-spacing: -0.01em; margin: 0; }

  /* Track grid */
  .cr__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .cr__card {
    cursor: pointer; padding: 16px;
    background: linear-gradient(135deg, var(--card-c1, var(--cr-walnut)) 0%, var(--cr-velvet) 100%);
    border-radius: 10px;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    box-shadow: var(--cr-shadow-md);
    position: relative; overflow: hidden;
    display: flex; align-items: center; gap: 14px;
  }
  .cr__card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.10) 0%, transparent 50%); pointer-events: none; }
  .cr__card:hover { transform: translateY(-3px); box-shadow: var(--cr-shadow-lg); }
  .cr__card--playing { outline: 2px solid var(--cr-flame); outline-offset: -2px; }
  .cr__card-art { width: 64px; height: 64px; border-radius: 6px; flex-shrink: 0; background: rgba(0,0,0,0.30); display: grid; place-items: center; box-shadow: var(--cr-shadow-md); }
  .cr__card-art img { width: 80%; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); }
  .cr__card-meta { flex: 1; min-width: 0; }
  .cr__card-name { font-family: var(--cr-display); font-weight: 700; font-size: 16px; color: #fff; margin: 0 0 4px 0; line-height: 1.2; }
  .cr__card-artist { font-family: var(--cr-body); font-size: 12.5px; color: rgba(255,255,255,0.78); margin: 0 0 6px 0; }
  .cr__card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .cr__card-tag { font-family: var(--cr-mono); font-size: 9.5px; padding: 2px 7px; background: rgba(0,0,0,0.30); color: rgba(255,255,255,0.72); border-radius: 999px; letter-spacing: 0.3px; text-transform: uppercase; }
  .cr__card-tag--instrument { background: rgba(246,193,94,0.20); color: rgba(246,193,94,0.92); }
  .cr__card-play {
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(0,0,0,0.40); border: 1px solid rgba(255,255,255,0.18); color: #fff;
    cursor: pointer; display: grid; place-items: center; font-size: 14px;
    transition: background 0.18s ease, transform 0.18s ease;
    flex-shrink: 0; padding-left: 2px;
  }
  .cr__card-play:hover { background: var(--cr-flame); color: var(--cr-velvet); transform: scale(1.06); }
  .cr__card--playing .cr__card-play { background: var(--cr-flame); color: var(--cr-velvet); }

  /* Detail panel */
  .cr__detail { padding: 28px 32px; }
  .cr__detail-head { display: flex; gap: 24px; align-items: flex-end; margin-bottom: 24px; }
  .cr__detail-art { width: 200px; height: 200px; border-radius: 14px; background: linear-gradient(135deg, var(--detail-c, var(--cr-walnut)), var(--cr-velvet)); display: grid; place-items: center; box-shadow: var(--cr-shadow-lg); flex-shrink: 0; }
  .cr__detail-art img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 6px 12px rgba(0,0,0,0.5)); }
  .cr__detail-meta { flex: 1; min-width: 0; }
  .cr__detail-kicker { font-family: var(--cr-mono); font-size: 11px; color: var(--cr-text-quiet); letter-spacing: 0.5px; margin: 0 0 8px 0; text-transform: uppercase; }
  .cr__detail-name { font-family: var(--cr-display); font-weight: 800; font-size: clamp(32px,4vw,52px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 10px 0; color: var(--cr-text); }
  .cr__detail-artist { font-family: var(--cr-body); font-size: 15px; color: var(--cr-text-mute); margin: 0; }

  .cr__inst-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 22px; }
  @media (max-width: 720px) { .cr__inst-row { grid-template-columns: 1fr; } }
  .cr__inst {
    background: var(--cr-glass); border: 1px solid var(--cr-line);
    border-radius: 10px; padding: 14px;
  }
  .cr__inst-label { font-family: var(--cr-mono); font-size: 10px; color: var(--cr-text-quiet); letter-spacing: 0.5px; text-transform: uppercase; margin: 0 0 6px 0; }
  .cr__inst-name { font-family: var(--cr-display); font-weight: 700; font-size: 17px; margin: 0 0 4px 0; color: var(--cr-text); letter-spacing: -0.01em; }
  .cr__inst-sub { font-family: var(--cr-mono); font-size: 10.5px; color: var(--cr-text-mute); margin: 0; }
  .cr__inst-status { display: inline-flex; align-items: center; gap: 6px; font-family: var(--cr-mono); font-size: 10px; padding: 2px 7px; border-radius: 999px; margin-left: 6px; vertical-align: middle; }
  .cr__inst-status--loaded { background: rgba(168,255,58,0.18); color: #a8ff3a; }
  .cr__inst-status--loading { background: rgba(246,193,94,0.18); color: var(--cr-flame); }

  /* Chord strip */
  .cr__chord-strip { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; margin-bottom: 18px; }
  .cr__chord-cell { padding: 14px 6px; background: var(--cr-glass); border: 1px solid var(--cr-line); border-radius: 6px; text-align: center; font-family: var(--cr-display); font-weight: 700; font-size: 14px; color: var(--cr-text); transition: background 0.2s ease; }
  .cr__chord-cell--active { background: var(--cr-flame); color: var(--cr-velvet); border-color: var(--cr-flame); }
  .cr__chord-num { font-family: var(--cr-mono); font-size: 9px; color: var(--cr-text-quiet); display: block; margin-bottom: 4px; font-weight: 500; letter-spacing: 0.5px; }
  .cr__chord-cell--active .cr__chord-num { color: rgba(26,8,32,0.65); }

  /* Lyrics block */
  .cr__lyrics-block { background: linear-gradient(180deg, var(--cr-glass), transparent); border-radius: 10px; padding: 22px; margin-top: 22px; }
  .cr__lyrics-line { font-family: var(--cr-display); font-weight: 600; font-size: 18px; line-height: 1.45; margin: 0 0 6px 0; color: var(--cr-text-quiet); transition: color 0.4s ease, transform 0.4s ease; }
  .cr__lyrics-line--active { color: var(--cr-text); transform: translateX(4px); }

  /* Kits view */
  .cr__kits-view { padding: 28px 32px; }
  .cr__kits-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 16px; margin-top: 18px; }
  .cr__kit { background: linear-gradient(135deg, var(--kit-c, var(--cr-walnut)) 0%, var(--cr-velvet) 100%); border-radius: 12px; padding: 18px; box-shadow: var(--cr-shadow-md); transition: transform 0.22s ease; }
  .cr__kit:hover { transform: translateY(-3px); }
  .cr__kit-hd { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .cr__kit-portrait { width: 60px; height: 60px; border-radius: 50%; background: rgba(0,0,0,0.30); display: grid; place-items: center; }
  .cr__kit-portrait img { width: 80%; image-rendering: pixelated; }
  .cr__kit-name { font-family: var(--cr-display); font-weight: 700; font-size: 17px; color: #fff; margin: 0 0 2px 0; }
  .cr__kit-id { font-family: var(--cr-mono); font-size: 10px; color: rgba(255,255,255,0.62); margin: 0; letter-spacing: 0.4px; }
  .cr__kit-list { list-style: none; margin: 0; padding: 12px 0 0 0; border-top: 1px solid rgba(255,255,255,0.12); display: flex; flex-direction: column; gap: 6px; }
  .cr__kit-list li { font-family: var(--cr-mono); font-size: 11px; color: rgba(255,255,255,0.78); }
  .cr__kit-list li b { color: rgba(246,193,94,0.92); margin-right: 6px; font-weight: 500; }
  .cr__kit-preview { margin-top: 12px; display: flex; gap: 6px; }
  .cr__kit-preview-btn { background: rgba(0,0,0,0.40); border: 1px solid rgba(255,255,255,0.20); color: #fff; padding: 6px 10px; border-radius: 999px; font-family: var(--cr-mono); font-size: 10px; cursor: pointer; transition: background 0.18s ease; letter-spacing: 0.4px; text-transform: uppercase; }
  .cr__kit-preview-btn:hover { background: rgba(255,255,255,0.18); }

  /* About page */
  .cr__about { padding: 36px 32px; max-width: 720px; }
  .cr__about h1 { font-family: var(--cr-display); font-weight: 800; font-size: 42px; letter-spacing: -0.02em; margin: 0 0 18px 0; }
  .cr__about p { font-family: var(--cr-body); font-size: 14.5px; line-height: 1.65; color: var(--cr-text-mute); margin: 0 0 14px 0; }
  .cr__about p strong { color: var(--cr-text); font-weight: 600; }
  .cr__about p code { font-family: var(--cr-mono); font-size: 12.5px; background: var(--cr-velvet); padding: 1px 6px; border-radius: 3px; color: var(--cr-flame); }
  .cr__about h2 { font-family: var(--cr-display); font-weight: 700; font-size: 22px; margin: 28px 0 10px 0; color: var(--cr-text); letter-spacing: -0.01em; }

  /* NOW PLAYING BAR */
  .cr__bar { position: fixed; bottom: 0; left: 0; right: 0; height: 92px; background: linear-gradient(180deg, rgba(12,6,8,0.96), rgba(4,1,5,0.99)); border-top: 1px solid var(--cr-line); display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: center; padding: 0 18px; gap: 16px; z-index: 90; backdrop-filter: blur(20px); }
  .cr__bar-l { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .cr__bar-art-frame { width: 60px; height: 60px; flex-shrink: 0; border-radius: 6px; overflow: hidden; background: linear-gradient(135deg, var(--art-c1, var(--cr-walnut)), var(--cr-velvet)); display: grid; place-items: center; box-shadow: var(--cr-shadow-md); }
  .cr__bar-art-frame img { width: 78%; image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4)); }
  .cr__bar-meta { min-width: 0; flex: 1; }
  .cr__bar-name { font-family: var(--cr-body); font-weight: 600; font-size: 13.5px; color: var(--cr-text); margin: 0 0 3px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cr__bar-artist { font-family: var(--cr-body); font-size: 11.5px; color: var(--cr-text-mute); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cr__bar-c { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .cr__bar-controls { display: flex; align-items: center; gap: 16px; }
  .cr__bar-btn { background: transparent; border: 0; color: var(--cr-text-mute); cursor: pointer; font-size: 18px; transition: color 0.15s ease, transform 0.15s ease; padding: 4px; }
  .cr__bar-btn:hover { color: var(--cr-text); transform: scale(1.10); }
  .cr__bar-play { width: 36px; height: 36px; border-radius: 50%; background: var(--cr-text); color: var(--cr-velvet); border: 0; cursor: pointer; display: grid; place-items: center; transition: transform 0.18s ease, background 0.18s ease; }
  .cr__bar-play:hover { transform: scale(1.10); background: #fff; }
  .cr__bar-prog { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 540px; }
  .cr__bar-time { font-family: var(--cr-mono); font-size: 10.5px; color: var(--cr-text-quiet); width: 36px; text-align: center; }
