      chords: [
        { root: 'C3', type: 'maj7', bars: 1 }, { root: 'G3', type: 'maj',  bars: 1 },
        { root: 'A3', type: 'min7', bars: 1 }, { root: 'F3', type: 'maj7', bars: 1 },
        { root: 'C3', type: 'maj7', bars: 1 }, { root: 'G3', type: 'maj',  bars: 1 },
        { root: 'A3', type: 'min7', bars: 1 }, { root: 'F3', type: 'maj7', bars: 1 },
      ], drumPattern: 'driving', leadStyle: 'phrase', bassStyle: 'root',
      lyric: ['five o nine the train is here','five o nine the sun is here','el segundo on the platform','release train release train release train','briefcase under the bench','coffee in the open hand','release train release train','always on time always on time'] },
