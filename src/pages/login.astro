---
/**
 * /login — the front desk. One page, three keys.
 *
 * Sign in with Kukai (Tezos), MetaMask (Ethereum), or Google. All three
 * converge on the same PointCast user + pc_session HttpOnly cookie via
 * functions/api/auth/* — sign in with more than one and the identities
 * link onto one account.
 *
 * Wallet flows run client-side through src/lib/auth/client.ts; Google is
 * a server redirect (/api/auth/google → consent → /api/auth/google/callback
 * → back here). Query params from the Google flow drive the status line:
 *   ?google=unconfigured  oauth client id/secret not set yet
 *   ?google=cancelled     user backed out of the consent screen
 *   ?google=error&reason= exchange/verify failed
 *
 * DOM contract matches WalletConnect.astro: no element IDs, document-level
 * delegated listeners, [data-login-*] attributes — survives ClientRouter
 * view transitions.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Login · PointCast';
const description =
  'Sign in to PointCast with Kukai (Tezos), MetaMask (Ethereum), or Google. One account, every key you carry.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://pointcast.xyz/login',
  name: 'PointCast Login',
  description,
  url: 'https://pointcast.xyz/login',
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
};

const PROVIDERS = [
  {
    key: 'kukai',
    chip: 'tz',
    name: 'Kukai',
    detail: 'tezos · signs a login message in your wallet',
  },
  {
    key: 'metamask',
    chip: 'eth',
    name: 'MetaMask',
    detail: 'ethereum · base · signs a login message in your wallet',
  },
  {
    key: 'google',
    chip: 'id',
    name: 'Google',
    detail: 'oauth · redirects to google and back',
  },
] as const;
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="login">
    <header class="login__masthead">
      <p class="login__kicker">front desk</p>
      <h1>Login</h1>
      <p class="login__dek">
        one account, every key you carry. sign in with a wallet or with
        google — sign in with more than one and they link onto the same
        PointCast account.
      </p>
    </header>

    <section class="login__session hidden" data-login-session aria-live="polite">
      <p class="login__session-kicker">signed in as</p>
      <p class="login__session-name" data-login-name>—</p>
      <ul class="login__identities" data-login-identities></ul>
      <button type="button" class="login__logout" data-login-logout>log out</button>
    </section>

    <section class="login__providers" data-login-providers>
      {PROVIDERS.map((provider) => (
        <button type="button" class="login__provider" data-login-provider={provider.key}>
          <span class="login__chip">{provider.chip}</span>
          <span class="login__provider-body">
            <span class="login__provider-name">{provider.name}</span>
            <span class="login__provider-detail">{provider.detail}</span>
          </span>
        </button>
      ))}
    </section>

    <p class="login__status" data-login-status aria-live="polite">
      pick a key. wallets sign a message — no transaction, no gas.
    </p>
  </main>
</BlockLayout>

<style>
  .login {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 28px 96px;
  }
  .login__kicker {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #5a5450;
  }
  .login h1 {
    font-family: var(--pc-font-mono);
    font-size: clamp(64px, 14vw, 120px);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .login__dek {
    font-size: 18px;
    max-width: 52ch;
    margin: 0 0 36px;
  }
  .login__session {
    border: 2px solid #111;
    padding: 16px 18px;
    margin: 0 0 24px;
  }
  .login__session.hidden { display: none; }
  .login__session-kicker {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5a5450;
    margin: 0;
  }
  .login__session-name {
    font-family: var(--pc-font-mono);
    font-size: 20px;
    font-weight: 700;
    margin: 6px 0 10px;
    word-break: break-all;
  }
  .login__identities {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 4px;
  }
  .login__identities li {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a5450;
  }
  .login__logout {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: #111;
    color: #fff;
    border: 2px solid #111;
    padding: 8px 16px;
    cursor: pointer;
  }
  .login__logout:hover { background: #fff; color: #111; }
  .login__providers {
    display: grid;
    gap: 12px;
    margin: 0 0 20px;
  }
  .login__provider {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
    background: #fff;
    border: 2px solid #111;
    padding: 16px 18px;
    cursor: pointer;
  }
  .login__provider:hover { background: #111; }
  .login__provider:hover .login__provider-name,
  .login__provider:hover .login__provider-detail,
  .login__provider:hover .login__chip { color: #fff; }
  .login__chip {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #111;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
    margin-top: 2px;
  }
  .login__provider-body { display: grid; gap: 4px; }
  .login__provider-name {
    font-family: var(--pc-font-mono);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #111;
  }
  .login__provider-detail {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5a5450;
  }
  .login__status {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5a5450;
    min-height: 1.2em;
    margin: 0;
  }
</style>

<script>
  import type { PointCastUser } from '../lib/auth/types';

  // Everything binds to document once and re-queries the live DOM —
  // same contract as WalletConnect.astro, for the same two reasons
  // (ClientRouter view transitions + module caching).
  function statusEl(): HTMLElement | null {
    return document.querySelector('[data-login-status]');
  }

  function setStatus(message: string): void {
    const el = statusEl();
    if (el) el.textContent = message;
  }

  function renderSession(user: PointCastUser | null): void {
    const panel = document.querySelector<HTMLElement>('[data-login-session]');
    const providers = document.querySelector<HTMLElement>('[data-login-providers]');
    if (!panel) return;
    if (user) {
      panel.classList.remove('hidden');
      const name = panel.querySelector('[data-login-name]');
      if (name) name.textContent = user.preferredName || user.userId;
      const list = panel.querySelector('[data-login-identities]');
      if (list) {
        list.textContent = '';
        for (const identity of user.identities) {
          const li = document.createElement('li');
          li.textContent = `${identity.provider} · ${identity.name}`;
          list.appendChild(li);
        }
      }
    } else {
      panel.classList.add('hidden');
    }
    // Providers stay visible when signed in — that's how you link keys.
    providers?.classList.remove('hidden');
  }

  async function refreshSession(): Promise<void> {
    if (!document.querySelector('[data-login-session]')) return;
    try {
      const { getSession } = await import('../lib/auth/client');
      renderSession(await getSession());
    } catch {
      renderSession(null);
    }
  }

  function statusFromQuery(): void {
    const params = new URLSearchParams(window.location.search);
    const google = params.get('google');
    if (!google) return;
    if (google === 'unconfigured') {
      setStatus('google oauth is not configured yet — wallet sign-in works today.');
    } else if (google === 'cancelled') {
      setStatus('google sign-in cancelled.');
    } else if (google === 'error') {
      setStatus(`google sign-in failed (${params.get('reason') ?? 'unknown'}). try again.`);
    }
  }

  async function signIn(provider: string): Promise<void> {
    const { loginWithKukai, loginWithMetaMask, loginWithGoogle } = await import('../lib/auth/client');
    if (provider === 'google') {
      setStatus('redirecting to google…');
      await loginWithGoogle();
      return;
    }
    const action = provider === 'kukai' ? loginWithKukai : loginWithMetaMask;
    setStatus(`${provider}: check your wallet…`);
    try {
      const user = await action();
      if (user) {
        renderSession(user);
        setStatus(`signed in with ${provider}.`);
      }
    } catch (err: any) {
      const code = err?.code ?? err?.cause?.code;
      const reason: string = err?.message ?? '';
      if (reason === 'metamask-not-available') {
        setStatus('metamask not detected — opening the install page.');
        return;
      }
      if (
        code === 4001 ||
        code === -32002 ||
        reason.includes('rejected') ||
        reason.includes('already pending') ||
        reason.includes('aborted')
      ) {
        setStatus('sign-in cancelled.');
        return;
      }
      console.warn(`${provider} sign-in failed:`, err);
      setStatus(`${provider} sign-in failed. tap to retry.`);
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const providerBtn = target.closest<HTMLElement>('[data-login-provider]');
    if (providerBtn) {
      const provider = providerBtn.dataset.loginProvider;
      if (provider) void signIn(provider);
      return;
    }
    if (target.closest('[data-login-logout]')) {
      void (async () => {
        try {
          const { logout } = await import('../lib/auth/client');
          await logout();
          renderSession(null);
          setStatus('logged out.');
        } catch {
          setStatus('logout failed. try again.');
        }
      })();
    }
  });

  document.addEventListener('astro:page-load', () => {
    statusFromQuery();
    void refreshSession();
  });

  statusFromQuery();
  void refreshSession();
</script>
