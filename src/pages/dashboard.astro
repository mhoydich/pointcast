---
import BlockLayout from '../layouts/BlockLayout.astro';
import AuthMenu from '../components/AuthMenu.astro';
import frontDoorStreetImage from '../assets/bell-fall-v2/bg-05-yellow-car.jpg';
import frontDoorFlowerImage from '../assets/bell-fall-v2/bg-13-blue-flower.jpg';
import { POINTCAST_APPS } from '../lib/pointcast-apps';
import { ARCADE_ASSETS, RETRO_ARCADE_GAMES } from '../lib/retro-arcade';

const dashboardDescription = 'Your PointCast apps, games, saved places, activity, agents, wallet, and connected surfaces.';

const featured = [
  {
    path: '/win95-games',
    eyebrow: 'PLAY · LIVE',
    title: 'Retro Arcade',
    description: 'Solitaire, Memory, Pyramid, and Mines with local scores and short rounds.',
    image: ARCADE_ASSETS.desktop,
    alt: 'Pixel-art Windows desktop used by the PointCast Retro Arcade',
    color: '#145aa4',
  },
  {
    path: '/app',
    eyebrow: 'APP · START HERE',
    title: 'PointCast Shell',
    description: 'Now, rooms, profile, collect, and agents in a mobile-first home.',
    image: frontDoorStreetImage.src,
    alt: 'Bright watercolor street with a yellow car',
    color: '#2f8f5f',
  },
  {
    path: '/collection',
    eyebrow: 'LIBRARY · YOURS',
    title: 'Collection',
    description: 'Saved objects, local receipts, wallet pieces, and the places you keep.',
    image: frontDoorFlowerImage.src,
    alt: 'Bright blue and orange flower study',
    color: '#b12d3b',
  },
];

const roomItems = [
  { name: 'Rooms', kicker: 'TOWN MAP', description: 'Places, active surfaces, and ways into the PointCast world.', path: '/rooms', kind: 'room' },
  { name: 'The Live Bar', kicker: 'SHARED ROOM', description: 'Messages, spells, and small visits in one browser room.', path: '/bar-v6', kind: 'room' },
  { name: 'Kettle', kicker: 'COZY MULTIPLAYER', description: 'A small shared room for making a little noise together.', path: '/kettle', kind: 'room' },
  { name: 'Now', kicker: 'LIVE INDEX', description: 'What is moving and worth opening today.', path: '/now', kind: 'room' },
];

const catalog = [
  ...RETRO_ARCADE_GAMES.map((game) => ({
    name: game.name,
    kicker: game.kicker,
    description: game.description,
    path: game.path,
    kind: 'game',
  })),
  ...POINTCAST_APPS
    .filter((app) => !RETRO_ARCADE_GAMES.some((game) => game.path === app.path))
    .map((app) => ({
      name: app.name,
      kicker: app.kicker,
      description: app.description,
      path: app.path,
      kind: app.kind === 'satellite' ? 'site' : 'app',
    })),
  ...roomItems,
].filter((item, index, items) => items.findIndex((candidate) => candidate.path === item.path) === index);

const todayLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/Los_Angeles',
}).format(new Date());
---

<BlockLayout title="Dashboard" description={dashboardDescription}>
  <main class="dashboard" data-dashboard>
    <header class="dashboard-topbar">
      <a class="dashboard-brand" href="/">
        <span class="dashboard-brand__mark" aria-hidden="true">PC</span>
        <span>
          <strong>PointCast</strong>
          <small>Dashboard</small>
        </span>
      </a>
      <nav class="dashboard-nav" aria-label="Dashboard sections">
        <a href="#today">Today</a>
        <a href="#explore">Explore</a>
        <a href="#library">Library</a>
        <a href="#activity">Activity</a>
        <a href="#connections">Connections</a>
      </nav>
      <AuthMenu />
    </header>

    <section class="dashboard-heading" id="today" aria-labelledby="dashboard-title">
      <div>
        <p class="dashboard-kicker">{todayLabel.toUpperCase()} · EL SEGUNDO</p>
        <h1 id="dashboard-title">Your PointCast.</h1>
      </div>
      <div class="dashboard-status" aria-label="Dashboard status">
        <span><i class="status-dot status-dot--live"></i> Dock live</span>
        <span><i class="status-dot status-dot--local"></i> Local memory</span>
        <a href="/status">System status →</a>
      </div>
    </section>

    <div class="dashboard-overview">
      <section class="dashboard-band dashboard-continue" aria-labelledby="continue-title">
        <div class="dashboard-section-head">
          <div>
            <p class="dashboard-kicker">CONTINUE</p>
            <h2 id="continue-title">Recently opened</h2>
          </div>
          <a href="#activity">View trail</a>
        </div>
        <ol class="continue-list" data-dashboard-recents aria-live="polite">
          <li class="dashboard-empty">Recent places will appear here.</li>
        </ol>
      </section>

      <section class="dashboard-band dashboard-activity" id="activity" aria-labelledby="activity-title">
        <div class="dashboard-section-head">
          <div>
            <p class="dashboard-kicker">ACTIVITY</p>
            <h2 id="activity-title">On this device</h2>
          </div>
          <button type="button" data-dashboard-clear-activity>Clear</button>
        </div>
        <ol class="activity-list" data-dashboard-activity aria-live="polite">
          <li class="dashboard-empty">No local activity yet.</li>
        </ol>
      </section>
    </div>

    <section class="dashboard-band dashboard-featured" aria-labelledby="featured-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">OPEN NOW</p>
          <h2 id="featured-title">A few good ways in</h2>
        </div>
        <a href="/apps">All apps →</a>
      </div>
      <div class="featured-grid">
        {featured.map((item) => (
          <article class="featured-card" style={`--feature-color: ${item.color}`}>
            <a href={item.path} data-dashboard-track data-dashboard-title={item.title}>
              <img src={item.image} alt={item.alt} width="640" height="360" loading="eager" />
              <span class="featured-card__copy">
                <small>{item.eyebrow}</small>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="dashboard-band dashboard-library" id="library" aria-labelledby="library-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">LIBRARY</p>
          <h2 id="library-title">Saved to your dock</h2>
        </div>
        <span class="dashboard-section-meta" data-library-count>0 saved</span>
      </div>
      <div class="library-list" data-dashboard-library>
        <p class="dashboard-empty">No saved apps yet.</p>
      </div>
    </section>

    <section class="dashboard-band dashboard-explore" id="explore" aria-labelledby="explore-title">
      <div class="dashboard-section-head dashboard-section-head--explore">
        <div>
          <p class="dashboard-kicker">EXPLORE</p>
          <h2 id="explore-title">Games, apps, rooms, and connected sites</h2>
        </div>
        <label class="dashboard-search">
          <span class="sr-only">Search PointCast apps</span>
          <input type="search" placeholder="Search apps…" data-dashboard-search />
        </label>
      </div>

      <div class="dashboard-filters" role="group" aria-label="Filter apps">
        <button type="button" aria-pressed="true" data-dashboard-filter="all">All</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="game">Games</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="app">Apps</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="room">Rooms</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="site">Sites</button>
        <span data-dashboard-result-count>{catalog.length} results</span>
      </div>

      <div class="app-grid" data-dashboard-app-grid>
        {catalog.map((app, index) => (
          <article
            class="app-card"
            data-dashboard-app
            data-path={app.path}
            data-title={app.name}
            data-kind={app.kind}
            data-search={`${app.name} ${app.kicker} ${app.description} ${app.kind}`.toLowerCase()}
            style={`--app-index: ${index % 5}`}
          >
            <button
              type="button"
              class="app-card__save"
              aria-label={`Save ${app.name}`}
              aria-pressed="false"
              title={`Save ${app.name}`}
              data-dashboard-save
            >☆</button>
            <a href={app.path} data-dashboard-track data-dashboard-title={app.name}>
              <span class="app-card__kind">{app.kind}</span>
              <strong>{app.name}</strong>
              <small>{app.kicker}</small>
              <p>{app.description}</p>
              <span class="app-card__route">{app.path} <i aria-hidden="true">→</i></span>
            </a>
          </article>
        ))}
      </div>
      <p class="dashboard-empty dashboard-empty--results" data-dashboard-no-results hidden>No matching apps.</p>
    </section>

    <section class="dashboard-band dashboard-connections" id="connections" aria-labelledby="connections-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">CONNECTIONS</p>
          <h2 id="connections-title">Identity, agents, wallet, and sites</h2>
        </div>
      </div>
      <div class="connection-grid">
        <article>
          <span class="connection-grid__mark connection-grid__mark--account" aria-hidden="true">ID</span>
          <div><strong>PointCast account</strong><small data-dashboard-account-state>Visitor mode</small></div>
          <button type="button" data-dashboard-open-account>Manage</button>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--agents" aria-hidden="true">AI</span>
          <div><strong>Resident agents</strong><small>Ask, delegate, review</small></div>
          <a href="/for-agents">Open →</a>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--wallet" aria-hidden="true">TZ</span>
          <div><strong>Wallet + collection</strong><small>Tezos identity and objects</small></div>
          <a href="/wallet">Open →</a>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--sites" aria-hidden="true">WEB</span>
          <div><strong>Connected sites</strong><small>pointcast.xyz · first party</small></div>
          <a href="/federation/preview">Network →</a>
        </article>
      </div>
    </section>
  </main>

  <script>
    import {
      clearDockActivity,
      formatDockAge,
      readDockActivity,
      readDockRecents,
      readDockSaved,
      recordDockOpen,
      toggleDockSaved,
    } from '../lib/dock-state';

    function initDashboard() {
      const root = document.querySelector<HTMLElement>('[data-dashboard]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const appCards = Array.from(root.querySelectorAll<HTMLElement>('[data-dashboard-app]'));
      const appByPath = new Map(appCards.map((card) => [card.dataset.path || '', card]));
      let activeFilter = 'all';

      function makeLinkRow(path: string, title: string, age: string): HTMLLIElement {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const route = document.createElement('small');
        const name = document.createElement('strong');
        const time = document.createElement('time');
        link.href = path;
        link.dataset.dashboardTrack = '';
        link.dataset.dashboardTitle = title;
        name.textContent = title;
        route.textContent = path;
        time.textContent = age;
        link.append(name, route, time);
        li.append(link);
        return li;
      }

      function renderRecents() {
        const list = root.querySelector<HTMLOListElement>('[data-dashboard-recents]');
        if (!list) return;
        const recents = readDockRecents().filter((item) => item.path !== '/dashboard').slice(0, 6);
        list.replaceChildren();
        if (!recents.length) {
          [
            { path: '/win95-games', title: 'Retro Arcade' },
            { path: '/app', title: 'PointCast Shell' },
            { path: '/rooms', title: 'Rooms' },
          ].forEach((item) => list.append(makeLinkRow(item.path, item.title, 'start')));
          return;
        }
        recents.forEach((item) => list.append(makeLinkRow(item.path, item.title, formatDockAge(item.visitedAt))));
      }

      function renderActivity() {
        const list = root.querySelector<HTMLOListElement>('[data-dashboard-activity]');
        if (!list) return;
        const activity = readDockActivity().slice(0, 8);
        list.replaceChildren();
        if (!activity.length) {
          const empty = document.createElement('li');
          empty.className = 'dashboard-empty';
          empty.textContent = 'No local activity yet.';
          list.append(empty);
          return;
        }
        activity.forEach((item) => {
          const li = document.createElement('li');
          const marker = document.createElement('i');
          const body = document.createElement(item.path ? 'a' : 'span');
          const time = document.createElement('time');
          marker.dataset.type = item.type;
          body.textContent = item.label;
          if (item.path && body instanceof HTMLAnchorElement) body.href = item.path;
          time.textContent = formatDockAge(item.at);
          li.append(marker, body, time);
          list.append(li);
        });
      }

      function renderLibrary() {
        const library = root.querySelector<HTMLElement>('[data-dashboard-library]');
        const count = root.querySelector<HTMLElement>('[data-library-count]');
        const saved = readDockSaved();
        if (count) count.textContent = `${saved.length} saved`;
        appCards.forEach((card) => {
          const button = card.querySelector<HTMLButtonElement>('[data-dashboard-save]');
          const active = saved.includes(card.dataset.path || '');
          if (button) {
            button.setAttribute('aria-pressed', String(active));
            button.textContent = active ? '★' : '☆';
            button.title = `${active ? 'Remove' : 'Save'} ${card.dataset.title || 'app'}`;
          }
        });
        if (!library) return;
        library.replaceChildren();
        if (!saved.length) {
          const empty = document.createElement('p');
          empty.className = 'dashboard-empty';
          empty.textContent = 'No saved apps yet.';
          library.append(empty);
          return;
        }
        saved.forEach((path) => {
          const source = appByPath.get(path);
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const route = document.createElement('small');
          link.href = path;
          link.dataset.dashboardTrack = '';
          link.dataset.dashboardTitle = source?.dataset.title || path;
          title.textContent = source?.dataset.title || path;
          route.textContent = path;
          link.append(title, route);
          library.append(link);
        });
      }

      function applyFilters() {
        const query = root.querySelector<HTMLInputElement>('[data-dashboard-search]')?.value.trim().toLowerCase() || '';
        let visible = 0;
        appCards.forEach((card) => {
          const kindMatch = activeFilter === 'all' || card.dataset.kind === activeFilter;
          const queryMatch = !query || (card.dataset.search || '').includes(query);
          const show = kindMatch && queryMatch;
          card.hidden = !show;
          if (show) visible += 1;
        });
        const count = root.querySelector<HTMLElement>('[data-dashboard-result-count]');
        const empty = root.querySelector<HTMLElement>('[data-dashboard-no-results]');
        if (count) count.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
        if (empty) empty.hidden = visible > 0;
      }

      root.querySelector<HTMLInputElement>('[data-dashboard-search]')?.addEventListener('input', applyFilters);
      root.querySelectorAll<HTMLButtonElement>('[data-dashboard-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.dashboardFilter || 'all';
          root.querySelectorAll<HTMLButtonElement>('[data-dashboard-filter]').forEach((item) => {
            item.setAttribute('aria-pressed', String(item === button));
          });
          applyFilters();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-dashboard-save]').forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest<HTMLElement>('[data-dashboard-app]');
          if (!card) return;
          toggleDockSaved(card.dataset.path || '/', card.dataset.title || 'PointCast app');
          renderLibrary();
          renderActivity();
        });
      });

      root.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-dashboard-track]');
        if (!link) return;
        recordDockOpen(link.getAttribute('href') || '/', link.dataset.dashboardTitle || link.textContent || 'PointCast');
      });

      root.querySelector<HTMLButtonElement>('[data-dashboard-clear-activity]')?.addEventListener('click', () => {
        clearDockActivity();
        renderActivity();
      });
      root.querySelector<HTMLButtonElement>('[data-dashboard-open-account]')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('pc:open-auth-menu'));
      });
      window.addEventListener('pc:auth-change', (event) => {
        const user = (event as CustomEvent<{ user?: { preferredName?: string } | null }>).detail?.user;
        const state = root.querySelector<HTMLElement>('[data-dashboard-account-state]');
        if (state) state.textContent = user?.preferredName || 'Visitor mode';
      });
      window.addEventListener('pc:dock-state-change', () => {
        renderRecents();
        renderActivity();
        renderLibrary();
      });

      renderRecents();
      renderActivity();
      renderLibrary();
      applyFilters();
    }

    initDashboard();
    document.addEventListener('astro:page-load', initDashboard);
  </script>
</BlockLayout>

<style is:global>
  body { background: #f4f5f6; }
  .dashboard {
    width: min(1420px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0 88px;
    color: #181a1d;
    font-family: var(--pc-font-sans, Inter, system-ui, sans-serif);
  }
  .dashboard-topbar {
    min-height: 54px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    border-block: 1px solid #cdd2d7;
    background: #f4f5f6;
  }
  .dashboard-brand { display: inline-flex; align-items: center; gap: 9px; color: #181a1d; text-decoration: none; }
  .dashboard-brand__mark { width: 30px; height: 30px; display: grid; place-items: center; background: #181a1d; color: #fff; border-radius: 4px; font: 800 9px/1 var(--pc-font-mono, ui-monospace, monospace); }
  .dashboard-brand > span:last-child { display: grid; gap: 1px; }
  .dashboard-brand strong { font-size: 13px; line-height: 1; }
  .dashboard-brand small { color: #707983; font: 8px/1 var(--pc-font-mono, ui-monospace, monospace); text-transform: uppercase; }
  .dashboard-nav { display: flex; align-items: center; gap: 18px; }
  .dashboard-nav a { color: #5f6872; font: 700 9px/1 var(--pc-font-mono, ui-monospace, monospace); text-decoration: none; text-transform: uppercase; }
  .dashboard-nav a:hover { color: #145aa4; }

  .dashboard-heading { min-height: 148px; display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; padding: 28px 0 22px; }
  .dashboard-kicker,
  .dashboard-section-meta,
  .dashboard-status,
  .app-card__kind,
  .app-card small,
  .app-card__route,
  .featured-card small,
  .continue-list small,
  .continue-list time,
  .activity-list time,
  .connection-grid small {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .dashboard-kicker { margin: 0 0 6px; color: #b12d3b; font-size: 9px; font-weight: 800; }
  .dashboard h1 { margin: 0; font-size: 38px; line-height: 1; letter-spacing: 0; }
  .dashboard-status { display: flex; align-items: center; gap: 16px; color: #67717b; font-size: 8px; }
  .dashboard-status span { display: inline-flex; align-items: center; gap: 6px; }
  .dashboard-status a { color: #145aa4; text-decoration: none; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #828c96; }
  .status-dot--live { background: #2f8f5f; }
  .status-dot--local { background: #d19a20; }

  .dashboard-overview { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.8fr); border-top: 2px solid #181a1d; }
  .dashboard-band { padding: 22px 0 28px; border-top: 1px solid #cdd2d7; }
  .dashboard-overview .dashboard-band { border-top: 0; }
  .dashboard-continue { padding-right: 28px; }
  .dashboard-activity { padding-left: 28px; border-left: 1px solid #cdd2d7; }
  .dashboard-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .dashboard-section-head h2 { margin: 0; font-size: 18px; line-height: 1.15; letter-spacing: 0; }
  .dashboard-section-head a,
  .dashboard-section-head button { border: 0; padding: 0; background: none; color: #145aa4; font: 700 9px/1 var(--pc-font-mono, ui-monospace, monospace); text-decoration: none; text-transform: uppercase; cursor: pointer; }
  .dashboard-section-head a:hover,
  .dashboard-section-head button:hover { text-decoration: underline; }
  .dashboard-section-meta { color: #737d87; font-size: 8px; }

  .continue-list,
  .activity-list { list-style: none; margin: 0; padding: 0; }
  .continue-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid #cdd2d7; border-radius: 6px; overflow: hidden; background: #fff; }
  .continue-list li { min-width: 0; border-bottom: 1px solid #e0e4e7; }
  .continue-list li:nth-child(odd) { border-right: 1px solid #e0e4e7; }
  .continue-list li:nth-last-child(-n + 2) { border-bottom: 0; }
  .continue-list a { min-height: 62px; display: grid; grid-template-columns: 1fr auto; align-content: center; gap: 3px 12px; padding: 11px 13px; color: #181a1d; text-decoration: none; }
  .continue-list a:hover { background: #f7fafc; }
  .continue-list strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
  .continue-list small { overflow: hidden; color: #75808a; font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
  .continue-list time { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #b12d3b; font-size: 8px; }
  .activity-list { border-top: 1px solid #cdd2d7; }
  .activity-list li { min-height: 38px; display: grid; grid-template-columns: 7px 1fr auto; align-items: center; gap: 9px; border-bottom: 1px solid #dde1e5; font-size: 10px; }
  .activity-list i { width: 6px; height: 6px; border-radius: 50%; background: #818b95; }
  .activity-list i[data-type='save'] { background: #d19a20; }
  .activity-list i[data-type='agent'] { background: #b12d3b; }
  .activity-list a { color: #2b3035; text-decoration: none; }
  .activity-list a:hover { color: #145aa4; }
  .activity-list time { color: #7b858f; font-size: 8px; }

  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .featured-card { overflow: hidden; border: 1px solid #bdc4ca; border-radius: 6px; background: #fff; }
  .featured-card a { display: grid; grid-template-columns: minmax(140px, 0.9fr) 1.1fr; min-height: 178px; color: #181a1d; text-decoration: none; }
  .featured-card img { width: 100%; height: 100%; min-height: 178px; object-fit: cover; }
  .featured-card__copy { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 16px; border-left: 4px solid var(--feature-color); }
  .featured-card small { color: var(--feature-color); font-size: 8px; font-weight: 800; }
  .featured-card strong { margin-top: 6px; font-size: 17px; line-height: 1.05; }
