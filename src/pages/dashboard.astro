---
import BlockLayout from '../layouts/BlockLayout.astro';
import AuthMenu from '../components/AuthMenu.astro';
import frontDoorStreetImage from '../assets/bell-fall-v2/bg-05-yellow-car.jpg';
import frontDoorFlowerImage from '../assets/bell-fall-v2/bg-13-blue-flower.jpg';
import { POINTCAST_APPS } from '../lib/pointcast-apps';
import { ARCADE_ASSETS, RETRO_ARCADE_GAMES } from '../lib/retro-arcade';

const dashboardDescription = 'Your PointCast apps, games, saved places, activity, agents, wallet, and connected surfaces.';

const featured = [
  {
    path: '/win95-games',
    eyebrow: 'PLAY · LIVE',
    title: 'Retro Arcade',
    description: 'Solitaire, Memory, Pyramid, and Mines with local scores and short rounds.',
    image: ARCADE_ASSETS.desktop,
    alt: 'Pixel-art Windows desktop used by the PointCast Retro Arcade',
    color: '#145aa4',
  },
  {
    path: '/app',
    eyebrow: 'APP · START HERE',
    title: 'PointCast Shell',
    description: 'Now, rooms, profile, collect, and agents in a mobile-first home.',
    image: frontDoorStreetImage.src,
    alt: 'Bright watercolor street with a yellow car',
    color: '#2f8f5f',
  },
  {
    path: '/collection',
    eyebrow: 'LIBRARY · YOURS',
    title: 'Collection',
    description: 'Saved objects, local receipts, wallet pieces, and the places you keep.',
    image: frontDoorFlowerImage.src,
    alt: 'Bright blue and orange flower study',
    color: '#b12d3b',
  },
];

const roomItems = [
  { name: 'Rooms', kicker: 'TOWN MAP', description: 'Places, active surfaces, and ways into the PointCast world.', path: '/rooms', kind: 'room' },
  { name: 'The Live Bar', kicker: 'SHARED ROOM', description: 'Messages, spells, and small visits in one browser room.', path: '/bar-v6', kind: 'room' },
  { name: 'Kettle', kicker: 'COZY MULTIPLAYER', description: 'A small shared room for making a little noise together.', path: '/kettle', kind: 'room' },
  { name: 'Now', kicker: 'LIVE INDEX', description: 'What is moving and worth opening today.', path: '/now', kind: 'room' },
];

const catalog = [
  ...RETRO_ARCADE_GAMES.map((game) => ({
    name: game.name,
    kicker: game.kicker,
    description: game.description,
    path: game.path,
    kind: 'game',
  })),
  ...POINTCAST_APPS
    .filter((app) => !RETRO_ARCADE_GAMES.some((game) => game.path === app.path))
    .map((app) => ({
      name: app.name,
      kicker: app.kicker,
      description: app.description,
      path: app.path,
      kind: app.kind === 'satellite' ? 'site' : 'app',
    })),
  ...roomItems,
].filter((item, index, items) => items.findIndex((candidate) => candidate.path === item.path) === index);

const todayLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/Los_Angeles',
}).format(new Date());
---

<BlockLayout title="Dashboard" description={dashboardDescription}>
  <main class="dashboard" data-dashboard>
    <header class="dashboard-topbar">
      <a class="dashboard-brand" href="/">
        <span class="dashboard-brand__mark" aria-hidden="true">PC</span>
        <span>
          <strong>PointCast</strong>
          <small>Dashboard</small>
        </span>
      </a>
      <nav class="dashboard-nav" aria-label="Dashboard sections">
        <a href="#today">Today</a>
        <a href="#pets">Pets</a>
        <a href="#explore">Explore</a>
        <a href="#library">Library</a>
        <a href="#activity">Activity</a>
        <a href="#connections">Connections</a>
      </nav>
      <AuthMenu />
    </header>

    <section class="dashboard-heading" id="today" aria-labelledby="dashboard-title">
      <div>
        <p class="dashboard-kicker">{todayLabel.toUpperCase()} · EL SEGUNDO</p>
        <h1 id="dashboard-title">Your PointCast.</h1>
      </div>
      <div class="dashboard-status" aria-label="Dashboard status">
        <span><i class="status-dot status-dot--live"></i> Dock live</span>
        <span><i class="status-dot status-dot--local"></i> Local memory</span>
        <a href="/status">System status →</a>
      </div>
    </section>

    <div class="dashboard-overview">
      <section class="dashboard-band dashboard-continue" aria-labelledby="continue-title">
        <div class="dashboard-section-head">
          <div>
            <p class="dashboard-kicker">CONTINUE</p>
            <h2 id="continue-title">Recently opened</h2>
          </div>
          <a href="#activity">View trail</a>
        </div>
        <ol class="continue-list" data-dashboard-recents aria-live="polite">
          <li class="dashboard-empty">Recent places will appear here.</li>
        </ol>
      </section>

      <section class="dashboard-band dashboard-activity" id="activity" aria-labelledby="activity-title">
        <div class="dashboard-section-head">
          <div>
            <p class="dashboard-kicker">ACTIVITY</p>
            <h2 id="activity-title">On this device</h2>
          </div>
          <button type="button" data-dashboard-clear-activity>Clear</button>
        </div>
        <ol class="activity-list" data-dashboard-activity aria-live="polite">
          <li class="dashboard-empty">No local activity yet.</li>
        </ol>
      </section>
    </div>

    <section class="dashboard-band dashboard-pet" id="pets" aria-labelledby="dashboard-pet-title" data-dashboard-pet style="--dashboard-pet-accent: #2f8f5f">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">YOUR COMPANION · LOCAL</p>
          <h2 id="dashboard-pet-title">Site Pet</h2>
        </div>
        <a href="/pets" data-dashboard-track data-dashboard-title="Pets">View roster →</a>
      </div>
      <div class="dashboard-pet-row">
        <a class="dashboard-pet__identity" href="/pet" data-dashboard-track data-dashboard-title="PointCast Pet">
          <img src="https://noun.pics/404.svg" alt="" width="58" height="58" loading="eager" data-dashboard-pet-image />
          <span>
            <small>ACTIVE COMPANION</small>
            <strong data-dashboard-pet-name>Signal Pup</strong>
            <em data-dashboard-pet-kind>route runner</em>
          </span>
        </a>
        <dl class="dashboard-pet__stats">
          <div><dt>Mood</dt><dd data-dashboard-pet-state>sleepy signal</dd></div>
          <div><dt>Care</dt><dd data-dashboard-pet-care>0 receipts</dd></div>
          <div><dt>Last</dt><dd data-dashboard-pet-last>not yet</dd></div>
        </dl>
        <nav class="dashboard-pet__actions" aria-label="Pet shortcuts">
          <a href="/pet" data-dashboard-track data-dashboard-title="PointCast Pet">Care</a>
          <a href="/zen-cats" data-dashboard-track data-dashboard-title="Zen Cats">Zen Cats</a>
        </nav>
      </div>
    </section>

    <section class="dashboard-band dashboard-featured" aria-labelledby="featured-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">OPEN NOW</p>
          <h2 id="featured-title">A few good ways in</h2>
        </div>
        <a href="/apps">All apps →</a>
      </div>
      <div class="featured-grid">
        {featured.map((item) => (
          <article class="featured-card" style={`--feature-color: ${item.color}`}>
            <a href={item.path} data-dashboard-track data-dashboard-title={item.title}>
              <img src={item.image} alt={item.alt} width="640" height="360" loading="eager" />
              <span class="featured-card__copy">
                <small>{item.eyebrow}</small>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="dashboard-band dashboard-library" id="library" aria-labelledby="library-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">LIBRARY</p>
          <h2 id="library-title">Saved to your dock</h2>
        </div>
        <span class="dashboard-section-meta" data-library-count>0 saved</span>
      </div>
      <div class="library-list" data-dashboard-library>
        <p class="dashboard-empty">No saved apps yet.</p>
      </div>
    </section>

    <section class="dashboard-band dashboard-explore" id="explore" aria-labelledby="explore-title">
      <div class="dashboard-section-head dashboard-section-head--explore">
        <div>
          <p class="dashboard-kicker">EXPLORE</p>
          <h2 id="explore-title">Games, apps, rooms, and connected sites</h2>
        </div>
        <label class="dashboard-search">
          <span class="sr-only">Search PointCast apps</span>
          <input type="search" placeholder="Search apps…" data-dashboard-search />
        </label>
      </div>

      <div class="dashboard-filters" role="group" aria-label="Filter apps">
        <button type="button" aria-pressed="true" data-dashboard-filter="all">All</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="game">Games</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="app">Apps</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="room">Rooms</button>
        <button type="button" aria-pressed="false" data-dashboard-filter="site">Sites</button>
        <span data-dashboard-result-count>{catalog.length} results</span>
      </div>

      <div class="app-grid" data-dashboard-app-grid>
        {catalog.map((app, index) => (
          <article
            class="app-card"
            data-dashboard-app
            data-path={app.path}
            data-title={app.name}
            data-kind={app.kind}
            data-search={`${app.name} ${app.kicker} ${app.description} ${app.kind}`.toLowerCase()}
            style={`--app-index: ${index % 5}`}
          >
            <button
              type="button"
              class="app-card__save"
              aria-label={`Save ${app.name}`}
              aria-pressed="false"
              title={`Save ${app.name}`}
              data-dashboard-save
            >☆</button>
            <a href={app.path} data-dashboard-track data-dashboard-title={app.name}>
              <span class="app-card__kind">{app.kind}</span>
              <strong>{app.name}</strong>
              <small>{app.kicker}</small>
              <p>{app.description}</p>
              <span class="app-card__route">{app.path} <i aria-hidden="true">→</i></span>
            </a>
          </article>
        ))}
      </div>
      <p class="dashboard-empty dashboard-empty--results" data-dashboard-no-results hidden>No matching apps.</p>
    </section>

    <section class="dashboard-band dashboard-connections" id="connections" aria-labelledby="connections-title">
      <div class="dashboard-section-head">
        <div>
          <p class="dashboard-kicker">ACCOUNT</p>
          <h2 id="connections-title">Account and connections</h2>
        </div>
        <a href="/auth">Manage your account →</a>
      </div>
      <a class="super-auth-callout" href="/auth">
        <span>POINTCAST ACCOUNT</span>
        <strong>Sign in, review linked identities, link a wallet, or sign out.</strong>
        <em>Open account →</em>
      </a>
      <div class="connection-grid">
        <article>
          <span class="connection-grid__mark connection-grid__mark--account" aria-hidden="true">ID</span>
          <div><strong>PointCast account</strong><small data-dashboard-account-state>Visitor mode</small></div>
          <button type="button" data-dashboard-open-account>Manage</button>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--agents" aria-hidden="true">AI</span>
          <div><strong>Resident agents</strong><small>Ask, delegate, review</small></div>
          <a href="/for-agents">Open →</a>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--wallet" aria-hidden="true">TZ</span>
          <div><strong>Wallet + collection</strong><small>Tezos identity and objects</small></div>
          <a href="/wallet">Open →</a>
        </article>
        <article>
          <span class="connection-grid__mark connection-grid__mark--sites" aria-hidden="true">WEB</span>
          <div><strong>Connected sites</strong><small>pointcast.xyz · first party</small></div>
          <a href="/federation/preview">Network →</a>
        </article>
      </div>

      <div class="broadcaster-desk" id="broadcast">
        <div class="dashboard-section-head broadcaster-desk__head">
          <div>
            <p class="dashboard-kicker">PRIVATE</p>
            <h2>Broadcaster panel</h2>
          </div>
        </div>
        <p class="broadcaster-desk__state" data-dashboard-broadcaster-state aria-live="polite">
          Checking access…
        </p>
        <div class="connection-grid broadcaster-desk__panel" data-dashboard-broadcaster-panel hidden>
          <article data-dashboard-spotify>
            <span class="connection-grid__mark connection-grid__mark--spotify" aria-hidden="true">SP</span>
            <div>
              <strong>Spotify now playing</strong>
              <small data-dashboard-spotify-state>Checking the live feed…</small>
            </div>
            <span class="connection-grid__actions">
              <a href="/api/spotify/auth?returnTo=/dashboard%23broadcast" data-dashboard-spotify-action>Connect →</a>
              <button type="button" data-dashboard-spotify-disconnect hidden>Disconnect</button>
            </span>
          </article>
          <article data-dashboard-shopify>
            <span class="connection-grid__mark connection-grid__mark--shopify" aria-hidden="true">SH</span>
            <div>
              <strong>Shopify catalog</strong>
              <small data-dashboard-shopify-state>Checking the shelf…</small>
            </div>
            <span class="connection-grid__actions">
              <form data-dashboard-shopify-form>
                <label>
                  <span class="sr-only">Shop domain</span>
                  <input name="shop" inputmode="url" autocomplete="url" placeholder="store.myshopify.com" required />
                </label>
                <button type="submit" data-dashboard-shopify-action>Connect →</button>
              </form>
              <button type="button" data-dashboard-shopify-disconnect hidden>Disconnect</button>
            </span>
          </article>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { getSession } from '../lib/auth/client';
    import {
      clearDockActivity,
      formatDockAge,
      readDockActivity,
      readDockRecents,
      readDockSaved,
      recordDockOpen,
      toggleDockSaved,
    } from '../lib/dock-state';
    import {
      PET_CARE_KEY,
      PET_SELECTED_KEY,
      PET_STAMPS_KEY,
      readPetSnapshot,
      syncPetCareActivity,
    } from '../lib/pet-state';

    function initDashboard() {
      const root = document.querySelector<HTMLElement>('[data-dashboard]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const appCards = Array.from(root.querySelectorAll<HTMLElement>('[data-dashboard-app]'));
      const appByPath = new Map(appCards.map((card) => [card.dataset.path || '', card]));
      let activeFilter = 'all';

      function makeLinkRow(path: string, title: string, age: string): HTMLLIElement {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const route = document.createElement('small');
        const name = document.createElement('strong');
        const time = document.createElement('time');
        link.href = path;
        link.dataset.dashboardTrack = '';
        link.dataset.dashboardTitle = title;
        name.textContent = title;
        route.textContent = path;
        time.textContent = age;
        link.append(name, route, time);
        li.append(link);
        return li;
      }

      function renderRecents() {
        const list = root.querySelector<HTMLOListElement>('[data-dashboard-recents]');
        if (!list) return;
        const recents = readDockRecents().filter((item) => item.path !== '/dashboard').slice(0, 6);
        list.replaceChildren();
        if (!recents.length) {
          [
            { path: '/win95-games', title: 'Retro Arcade' },
            { path: '/app', title: 'PointCast Shell' },
            { path: '/rooms', title: 'Rooms' },
          ].forEach((item) => list.append(makeLinkRow(item.path, item.title, 'start')));
          return;
        }
        recents.forEach((item) => list.append(makeLinkRow(item.path, item.title, formatDockAge(item.visitedAt))));
      }

      function renderActivity() {
        const list = root.querySelector<HTMLOListElement>('[data-dashboard-activity]');
        if (!list) return;
        const activity = readDockActivity().slice(0, 8);
        list.replaceChildren();
        if (!activity.length) {
          const empty = document.createElement('li');
          empty.className = 'dashboard-empty';
          empty.textContent = 'No local activity yet.';
          list.append(empty);
          return;
        }
        activity.forEach((item) => {
          const li = document.createElement('li');
          const marker = document.createElement('i');
          const body = document.createElement(item.path ? 'a' : 'span');
          const time = document.createElement('time');
          marker.dataset.type = item.type;
          body.textContent = item.label;
          if (item.path && body instanceof HTMLAnchorElement) body.href = item.path;
          time.textContent = formatDockAge(item.at);
          li.append(marker, body, time);
          list.append(li);
        });
      }

      function renderPet() {
        const section = root.querySelector<HTMLElement>('[data-dashboard-pet]');
        if (!section) return;
        const pet = readPetSnapshot();
        const image = section.querySelector<HTMLImageElement>('[data-dashboard-pet-image]');
        const name = section.querySelector<HTMLElement>('[data-dashboard-pet-name]');
        const kind = section.querySelector<HTMLElement>('[data-dashboard-pet-kind]');
        const state = section.querySelector<HTMLElement>('[data-dashboard-pet-state]');
        const care = section.querySelector<HTMLElement>('[data-dashboard-pet-care]');
        const last = section.querySelector<HTMLElement>('[data-dashboard-pet-last]');
        section.style.setProperty('--dashboard-pet-accent', pet.accent);
        if (image) image.src = `https://noun.pics/${pet.nounId}.svg`;
        if (name) name.textContent = pet.name;
        if (kind) kind.textContent = pet.kind;
        if (state) state.textContent = pet.state;
        if (care) care.textContent = `${pet.careCount} receipt${pet.careCount === 1 ? '' : 's'}`;
        if (last) last.textContent = pet.lastCareAt && pet.lastAction
          ? `${pet.lastAction} · ${formatDockAge(pet.lastCareAt)}`
          : 'not yet';
      }

      function renderLibrary() {
        const library = root.querySelector<HTMLElement>('[data-dashboard-library]');
        const count = root.querySelector<HTMLElement>('[data-library-count]');
        const saved = readDockSaved();
        if (count) count.textContent = `${saved.length} saved`;
        appCards.forEach((card) => {
          const button = card.querySelector<HTMLButtonElement>('[data-dashboard-save]');
          const active = saved.includes(card.dataset.path || '');
          if (button) {
            button.setAttribute('aria-pressed', String(active));
            button.textContent = active ? '★' : '☆';
            button.title = `${active ? 'Remove' : 'Save'} ${card.dataset.title || 'app'}`;
          }
        });
        if (!library) return;
        library.replaceChildren();
        if (!saved.length) {
          const empty = document.createElement('p');
          empty.className = 'dashboard-empty';
          empty.textContent = 'No saved apps yet.';
          library.append(empty);
          return;
        }
        saved.forEach((path) => {
          const source = appByPath.get(path);
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const route = document.createElement('small');
          link.href = path;
          link.dataset.dashboardTrack = '';
          link.dataset.dashboardTitle = source?.dataset.title || path;
          title.textContent = source?.dataset.title || path;
          route.textContent = path;
          link.append(title, route);
          library.append(link);
        });
      }

      function applyFilters() {
        const query = root.querySelector<HTMLInputElement>('[data-dashboard-search]')?.value.trim().toLowerCase() || '';
        let visible = 0;
        appCards.forEach((card) => {
          const kindMatch = activeFilter === 'all' || card.dataset.kind === activeFilter;
          const queryMatch = !query || (card.dataset.search || '').includes(query);
          const show = kindMatch && queryMatch;
          card.hidden = !show;
          if (show) visible += 1;
        });
        const count = root.querySelector<HTMLElement>('[data-dashboard-result-count]');
        const empty = root.querySelector<HTMLElement>('[data-dashboard-no-results]');
        if (count) count.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
        if (empty) empty.hidden = visible > 0;
      }

      root.querySelector<HTMLInputElement>('[data-dashboard-search]')?.addEventListener('input', applyFilters);
      root.querySelectorAll<HTMLButtonElement>('[data-dashboard-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.dashboardFilter || 'all';
          root.querySelectorAll<HTMLButtonElement>('[data-dashboard-filter]').forEach((item) => {
            item.setAttribute('aria-pressed', String(item === button));
          });
          applyFilters();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-dashboard-save]').forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest<HTMLElement>('[data-dashboard-app]');
          if (!card) return;
          toggleDockSaved(card.dataset.path || '/', card.dataset.title || 'PointCast app');
          renderLibrary();
          renderActivity();
        });
      });

      root.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-dashboard-track]');
        if (!link) return;
        recordDockOpen(link.getAttribute('href') || '/', link.dataset.dashboardTitle || link.textContent || 'PointCast');
      });

      root.querySelector<HTMLButtonElement>('[data-dashboard-clear-activity]')?.addEventListener('click', () => {
        clearDockActivity();
        renderActivity();
      });
      root.querySelector<HTMLButtonElement>('[data-dashboard-open-account]')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('pc:open-auth-menu'));
      });
      window.addEventListener('pc:dock-state-change', () => {
        renderRecents();
        renderActivity();
        renderLibrary();
      });
      window.addEventListener('pc:pet-state-change', () => {
        syncPetCareActivity();
        renderPet();
        renderActivity();
      });
      window.addEventListener('storage', (event) => {
        if (![PET_CARE_KEY, PET_SELECTED_KEY, PET_STAMPS_KEY].includes(event.key || '')) return;
        syncPetCareActivity();
        renderPet();
        renderActivity();
      });

      const spotifyCard = root.querySelector<HTMLElement>('[data-dashboard-spotify]');
      const spotifyState = spotifyCard?.querySelector<HTMLElement>('[data-dashboard-spotify-state]');
      const spotifyAction = spotifyCard?.querySelector<HTMLAnchorElement>('[data-dashboard-spotify-action]');
      const spotifyDisconnect = spotifyCard?.querySelector<HTMLButtonElement>('[data-dashboard-spotify-disconnect]');

      async function refreshSpotify(): Promise<void> {
        try {
          const response = await fetch('/api/spotify/broadcast', {
            credentials: 'include',
            cache: 'no-store',
          });
          if (!response.ok) throw new Error('spotify-status-unavailable');
          const spotify = await response.json() as {
            configured?: boolean;
            connected?: boolean;
            canManage?: boolean;
            nowPlaying?: { title?: string; artist?: string; live?: boolean };
          };
          const title = spotify.nowPlaying?.title;
          const artist = spotify.nowPlaying?.artist;
          if (spotifyState) {
            spotifyState.textContent = spotify.connected
              ? `${spotify.nowPlaying?.live ? 'Live' : 'Ready'} · ${title ?? 'waiting'}${artist ? ` · ${artist}` : ''}`
              : spotify.configured
                ? 'Ready for authorization'
                : 'Provider setup required';
          }
          if (spotifyAction) {
            spotifyAction.href = '/api/spotify/auth?returnTo=/dashboard%23broadcast';
            spotifyAction.textContent = spotify.connected ? 'Reauthorize →' : 'Connect →';
          }
          if (spotifyDisconnect) {
            spotifyDisconnect.hidden = !(spotify.connected && spotify.canManage);
            spotifyDisconnect.disabled = false;
          }
        } catch {
          if (spotifyState) spotifyState.textContent = 'Spotify status unavailable';
        }
      }

      spotifyDisconnect?.addEventListener('click', async () => {
        const confirmed = window.confirm(
          'Disconnect Spotify from PointCast? This immediately removes the stored Spotify credentials and cached now-playing item.',
        );
        if (!confirmed) return;
        spotifyDisconnect.disabled = true;
        try {
          const response = await fetch('/api/spotify/broadcast', {
            method: 'DELETE',
            credentials: 'include',
            cache: 'no-store',
          });
          if (!response.ok) throw new Error('spotify-disconnect-failed');
          await refreshSpotify();
        } catch {
          spotifyDisconnect.disabled = false;
          if (spotifyState) spotifyState.textContent = 'Could not disconnect · try again';
        }
      });

      const shopifyCard = root.querySelector<HTMLElement>('[data-dashboard-shopify]');
      const shopifyState = shopifyCard?.querySelector<HTMLElement>('[data-dashboard-shopify-state]');
      const shopifyAction = shopifyCard?.querySelector<HTMLButtonElement>('[data-dashboard-shopify-action]');
      const shopifyForm = shopifyCard?.querySelector<HTMLFormElement>('[data-dashboard-shopify-form]');
      const shopifyInput = shopifyForm?.elements.namedItem('shop');
      const shopifyDisconnect = shopifyCard?.querySelector<HTMLButtonElement>('[data-dashboard-shopify-disconnect]');

      async function refreshShopify(): Promise<void> {
        try {
          const response = await fetch('/api/shopify/connection', {
            credentials: 'include',
            cache: 'no-store',
          });
          if (!response.ok) throw new Error('shopify-status-unavailable');
          const shopify = await response.json() as {
            configured?: boolean;
            connected?: boolean;
            canManage?: boolean;
            connection?: { shop?: string };
          };
          if (shopifyState) {
            shopifyState.textContent = shopify.connected
              ? shopify.connection?.shop
                ? `Connected · ${shopify.connection.shop}`
                : 'Catalog connected'
              : shopify.configured
                ? 'Ready for catalog authorization'
                : 'Provider setup required';
          }
          if (shopifyAction) {
            shopifyAction.textContent = shopify.connected ? 'Reauthorize →' : 'Connect →';
            shopifyAction.disabled = !shopify.configured;
          }
          if (shopifyInput instanceof HTMLInputElement && shopify.connection?.shop) {
            shopifyInput.value = shopify.connection.shop;
          }
          if (shopifyDisconnect) {
            shopifyDisconnect.hidden = !(shopify.connected && shopify.canManage);
            shopifyDisconnect.disabled = false;
          }
        } catch {
          if (shopifyState) shopifyState.textContent = 'Catalog status unavailable';
        }
      }

      shopifyForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const shop = shopifyInput instanceof HTMLInputElement ? shopifyInput.value.trim() : '';
        if (!shop) {
          if (shopifyState) shopifyState.textContent = 'Enter a store name or myshopify.com domain.';
          return;
        }
        const destination = new URL('/api/shopify/auth', window.location.origin);
        destination.searchParams.set('shop', shop);
        destination.searchParams.set('returnTo', '/dashboard#broadcast');
        window.location.assign(destination.toString());
      });

      shopifyDisconnect?.addEventListener('click', async () => {
        const confirmed = window.confirm(
          'Disconnect Shopify from PointCast? This immediately removes the encrypted catalog credential.',
        );
        if (!confirmed) return;
        shopifyDisconnect.disabled = true;
        try {
          const response = await fetch('/api/shopify/connection', {
            method: 'DELETE',
            credentials: 'include',
            cache: 'no-store',
          });
          if (!response.ok) throw new Error('shopify-disconnect-failed');
          await refreshShopify();
        } catch {
          shopifyDisconnect.disabled = false;
          if (shopifyState) shopifyState.textContent = 'Could not disconnect · try again';
        }
      });

      const broadcasterState = root.querySelector<HTMLElement>('[data-dashboard-broadcaster-state]');
      const broadcasterPanel = root.querySelector<HTMLElement>('[data-dashboard-broadcaster-panel]');

      function renderSessionAccess(user: { preferredName?: string; roles?: string[] } | null): void {
        const accountState = root.querySelector<HTMLElement>('[data-dashboard-account-state]');
        if (accountState) accountState.textContent = user?.preferredName || 'Visitor mode';
        const canBroadcast = Boolean(user?.roles?.includes('broadcaster'));
        if (broadcasterPanel) broadcasterPanel.hidden = !canBroadcast;
        if (broadcasterState) {
          broadcasterState.hidden = canBroadcast;
          broadcasterState.textContent = 'This desk belongs to the broadcaster.';
        }
        if (canBroadcast) void Promise.all([refreshSpotify(), refreshShopify()]);
      }

      window.addEventListener('pc:auth-change', (event) => {
        const user = (event as CustomEvent<{
          user?: { preferredName?: string; roles?: string[] } | null;
        }>).detail?.user ?? null;
        renderSessionAccess(user);
      });

      void getSession()
        .then((user) => renderSessionAccess(user))
        .catch(() => renderSessionAccess(null));

      syncPetCareActivity();
      renderRecents();
      renderActivity();
      renderLibrary();
      renderPet();
      applyFilters();
    }

    initDashboard();
    document.addEventListener('astro:page-load', initDashboard);
  </script>
</BlockLayout>

