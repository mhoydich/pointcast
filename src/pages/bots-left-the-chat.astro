---
import BlockLayout from '../layouts/BlockLayout.astro';
import { Content, getHeadings } from '../content/guides/bots-left-the-chat.md';
import { botsArticle as article, botsSources } from '../lib/bots-left-the-chat';
const headings = getHeadings().filter((heading) => heading.depth === 2);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.published,
  dateModified: article.published,
  author: { '@type': 'Organization', name: article.author },
  contributor: { '@type': 'Person', name: article.director, roleName: 'Editorial direction' },
  publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
  mainEntityOfPage: article.url,
  url: article.url,
  image: { '@type': 'ImageObject', url: `https://pointcast.xyz${article.image}`, width: 1200, height: 630, caption: 'AI-generated editorial art' },
  citation: botsSources.map((source) => source.url),
  inLanguage: 'en',
  isAccessibleForFree: true,
};
---
<BlockLayout title={article.title} description={article.description} author="Codex · Directed by Mike Hoydich" creator="Codex" image={article.image} imageAlt={article.imageAlt} themeColor="#185fa5" jsonLd={jsonLd} hideAds showNetworkStrip={false} alternates={[
  { type: 'application/json', href: '/bots-left-the-chat.json', title: 'Article, sources and artwork as JSON' },
  { type: 'text/markdown', href: '/bots-left-the-chat.md', title: 'Full article as Markdown' },
]}>
  <div class="bots-story" id="top">
    <nav class="story-masthead" aria-label="Publication"><a href="/">PointCast <span aria-hidden="true">↗</span></a><a href="/c/front-door">Front Door / Explorations</a></nav>
    <header class="story-title">
      <p class="eyebrow">CH.FD · № {article.block} <span>27 OCT 2026</span></p>
      <div class="title-row"><h1>The bots have<br /><span>left the chat.</span></h1>
      <p class="dek">{article.subtitle}</p></div>
      <div class="story-byline"><p>Directed by Mike Hoydich<br /><span>Written and researched with Codex</span></p><p>DOCUMENTATION REVIEW<br /><span>7 minute read · Illustrated exploration</span></p></div>
    </header>
    <figure class="hero-art">
      <img src="/images/bots-left-the-chat/atelier-hero.webp" srcset="/images/bots-left-the-chat/atelier-hero-836.webp 836w, /images/bots-left-the-chat/atelier-hero.webp 1672w" sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1248px) calc(100vw - 64px), 1184px" alt={article.imageAlt} width="1672" height="941" fetchpriority="high" decoding="async" />
      <figcaption><span>01 / After the conversation</span> AI-generated editorial art</figcaption>
    </figure>
    <nav class="story-contents" aria-label="Article contents"><span class="eyebrow">IN THIS EXPLORATION</span><ol>{headings.map((heading, index) => <li><a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a></li>)}</ol></nav>
    <article class="story-copy" aria-label={article.title}><Content /></article>
    <section class="story-sources" aria-labelledby="sources">
      <header><p class="eyebrow">THE READING TABLE</p><h2 id="sources">Sources, with the date left on.</h2><p>Public primary sources checked October 27, 2026. Vendor descriptions establish what is announced or documented; access and reliability can differ in practice.</p></header>
      <ol>{botsSources.map((source) => <li><a href={source.url}>{source.name} <span aria-hidden="true">↗</span></a><p>{source.note}</p></li>)}</ol>
    </section>
    <footer class="story-end"><p class="eyebrow">KEEP EXPLORING</p><a class="next-story" href="/agent-field-guide">Put an agent to useful work <span aria-hidden="true">↗</span></a><div><a href="/b/0770">Publication record № 0770</a><a href="/bots-left-the-chat.md">Read as Markdown</a><a href="/bots-left-the-chat.json">Read as JSON</a><a href="#top">Back to top ↑</a></div></footer>
  </div>
</BlockLayout>
<style>
  .bots-story{--story-ink:#18272e;--story-blue:#185fa5;--story-line:#b9c9d3;max-width:1248px;margin:0 auto;padding:28px 32px 120px;color:var(--story-ink)}
  .story-masthead{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:7px solid var(--story-blue);border-bottom:1px solid var(--story-line);padding:15px 0}.story-masthead a{color:var(--story-ink);text-decoration:none;font-size:12px}.story-masthead a:first-child{font-size:24px;letter-spacing:-.06em;font-weight:500}.story-masthead a:first-child span{color:var(--story-blue);margin-left:8px}
  .title-row{display:grid;grid-template-columns:1.7fr 1fr;gap:40px;align-items:end;margin-bottom:28px}.title-row h1,.title-row .dek{margin:0}
  .story-title{padding:38px 0 24px}.eyebrow,.story-byline,figcaption,.story-contents,.story-end>div{font-family:var(--font-mono,'JetBrains Mono Variable',monospace)}.eyebrow{font-size:11px;line-height:1.6;letter-spacing:.09em;color:var(--story-blue);font-weight:500}.story-title>.eyebrow{display:flex;justify-content:space-between;margin:0 0 24px}h1{font-size:clamp(52px,7.4vw,92px);line-height:.98;letter-spacing:-.068em;font-weight:500;margin:0 0 26px}h1 span{color:var(--story-blue)}.dek{max-width:740px;font-size:clamp(21px,2.7vw,29px);line-height:1.4;letter-spacing:-.025em;margin:0 0 32px}.story-byline{border-top:1px solid var(--story-line);padding-top:18px;display:flex;justify-content:space-between;gap:22px;font-size:11px;line-height:1.8}.story-byline p{margin:0}.story-byline span{color:#4c606c}.story-byline p:last-child{text-align:right}
  figure{margin:0}figure img{display:block;width:100%;height:auto;background:#e8eff5}figcaption{display:flex;justify-content:space-between;gap:12px;font-size:10px;line-height:1.6;color:#465c6a;padding:12px 0;border-bottom:1px solid var(--story-line)}figcaption span{text-transform:uppercase;letter-spacing:.06em}.story-contents{margin:34px 0 52px;padding:20px 0;border-top:2px solid var(--story-ink);border-bottom:1px solid var(--story-line)}.story-contents>.eyebrow{display:block;margin-bottom:12px}.story-contents ol{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;list-style:none;padding:0;margin:0}.story-contents a{display:flex;align-items:center;gap:10px;min-height:44px;font-size:11px;color:var(--story-ink);text-decoration:none}.story-contents a span{color:var(--story-blue)}
  .story-copy{font-size:18px;line-height:1.85;letter-spacing:-.012em}.story-copy :global(p){max-width:710px;margin:0 auto 24px}.story-copy :global(>p:first-child){font-size:clamp(25px,3.3vw,35px);line-height:1.4;letter-spacing:-.035em;margin-bottom:28px;font-weight:500}.story-copy :global(h2){max-width:710px;margin:62px auto 26px;padding-top:20px;border-top:3px solid var(--story-blue);font-weight:500;font-size:clamp(31px,4vw,44px);line-height:1.12;letter-spacing:-.045em;scroll-margin-top:32px}.story-copy :global(h3){max-width:710px;margin:40px auto 18px;font-size:25px;font-weight:500;line-height:1.25;letter-spacing:-.035em}.story-copy :global(a){color:#12558e;text-underline-offset:4px;text-decoration-thickness:1px}.story-copy :global(strong){font-weight:500;color:#124e80}.story-copy :global(.article-art){max-width:1080px;margin:44px auto 52px}.story-copy :global(.article-art img){display:block;width:100%;height:auto;background:#e8eff5}.story-copy :global(figcaption){display:flex;justify-content:space-between;gap:12px;font-family:var(--font-mono,'JetBrains Mono Variable',monospace);font-size:10px;line-height:1.6;letter-spacing:0;color:#465c6a;padding:12px 0;border-bottom:1px solid var(--story-line)}.story-copy :global(figcaption span){text-transform:uppercase;letter-spacing:.06em}
  .story-sources{margin:68px 0 0;padding:28px 0;border-top:3px solid var(--story-ink)}.story-sources header{max-width:710px}.story-sources h2{font-size:clamp(29px,4vw,42px);line-height:1.15;letter-spacing:-.04em;font-weight:500;margin:12px 0 16px;scroll-margin-top:24px}.story-sources header>p:last-child{font-size:14px;line-height:1.7;color:#465c6a}.story-sources ol{display:grid;grid-template-columns:1fr 1fr;column-gap:40px;list-style:decimal-leading-zero;padding-left:27px;margin:24px 0 0}.story-sources li{padding:16px 0 12px 8px;border-top:1px solid var(--story-line);font-size:12px;color:var(--story-blue)}.story-sources li a{font-size:15px;color:var(--story-ink);text-underline-offset:4px}.story-sources li p{font-size:12px;line-height:1.6;color:#465c6a;margin:9px 0}.story-end{margin-top:32px;border-top:7px solid var(--story-blue);padding-top:22px}.next-story{display:flex;justify-content:space-between;gap:16px;color:var(--story-ink);font-size:clamp(27px,4vw,44px);line-height:1.2;letter-spacing:-.04em;text-decoration:none;margin:20px 0 32px}.story-end>div{display:flex;flex-wrap:wrap;gap:0 24px;border-top:1px solid var(--story-line);padding-top:12px}.story-end>div a{display:inline-flex;align-items:center;min-height:44px;font-size:11px;color:var(--story-blue)}.bots-story a:focus-visible,.story-copy :global(a:focus-visible){outline:3px solid #bd4427;outline-offset:5px}.story-contents a:hover,.next-story:hover{text-decoration:underline;text-underline-offset:4px}
  @media(max-width:760px){.title-row{display:block;margin-bottom:26px}.title-row h1{margin-bottom:22px}.bots-story{padding:18px 18px 100px}.story-title{padding-top:28px}h1{margin-bottom:22px}.story-byline{font-size:10px;flex-direction:column;gap:12px}.story-byline p:last-child{text-align:left}.story-contents{margin:26px 0 36px}.story-contents ol{grid-template-columns:1fr}.story-copy{font-size:17px;line-height:1.8}.story-copy :global(h2){margin-top:42px}.story-copy :global(h3){font-size:23px}.story-copy :global(.article-art){margin:32px 0 40px}.story-sources{margin-top:42px}.story-sources ol{grid-template-columns:1fr}.story-masthead a:last-child{font-size:10px}figcaption,.story-copy :global(figcaption){flex-wrap:wrap;font-size:9px}.story-title>.eyebrow{font-size:10px}.story-end>div{gap:0 16px}}
  @media(prefers-reduced-motion:reduce){.bots-story{scroll-behavior:auto}}
</style>
