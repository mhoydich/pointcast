---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ACUPRESSURE_PROTOCOLS, BREATH_PRACTICES, COHORT_OFFERINGS_EXTENDED, DAILY_PRACTICE_ATLAS, EIGHT_WEEK_BEGINNER_LADDER, FOUNDATIONAL_PRINCIPLES, MOVEMENT_PRACTICES, PAPER_META, PAPER_NOTES, REFERENCES, STILLNESS_PRACTICES, TEACHER_REFERENCES } from '../lib/practicePaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/practice', name: PAPER_META.title, description, url: 'https://pointcast.xyz/practice', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
const modeColor: Record<string, string> = { movement: '#b85a3a', stillness: '#3d6a8a', breath: '#a06478', acupressure: '#2d6a3d' };
const diffColor: Record<string, string> = { beginner: '#2d6a3d', intermediate: '#d4a534', experienced: '#b85a3a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/practice.json', title: 'Practice (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/living-body">living-body</a><span aria-hidden="true">/</span><span>practice</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · DEPARTMENT OF LOCAL INQUIRY · V2 OF LIVING BODY</p>
      <h1>PRACTICE.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="prin"><p class="kicker">FOUNDATIONAL PRINCIPLES · 7</p><h2>How the corridor holds practice.</h2>
      <ol class="prin-list">{FOUNDATIONAL_PRINCIPLES.map((p, i) => (
        <li>
          <div class="prin__head"><span class="prin__num">{String(i+1).padStart(2,'0')}</span><h3>{p.principle}</h3></div>
          <p>{p.detail}</p>
        </li>
      ))}</ol>
    </section>

    <section class="atlas"><p class="kicker">DAILY PRACTICE ATLAS · MORNING → EVENING + WEEKLY</p><h2>{DAILY_PRACTICE_ATLAS.description}</h2>
      <h3 class="sh">Morning</h3>
      <ol class="atlas-list">{DAILY_PRACTICE_ATLAS.morning.map((d) => (
        <li><span class="atlas__when">{d.time}</span><div><span class="atlas__trad">{d.tradition}</span><p>{d.practice}</p></div></li>
      ))}</ol>
      <h3 class="sh">Midday</h3>
      <ol class="atlas-list">{DAILY_PRACTICE_ATLAS.midday.map((d) => (
        <li><span class="atlas__when">{d.time}</span><div><span class="atlas__trad">{d.tradition}</span><p>{d.practice}</p></div></li>
      ))}</ol>
      <h3 class="sh">Afternoon</h3>
      <ol class="atlas-list">{DAILY_PRACTICE_ATLAS.afternoon.map((d) => (
        <li><span class="atlas__when">{d.time}</span><div><span class="atlas__trad">{d.tradition}</span><p>{d.practice}</p></div></li>
      ))}</ol>
      <h3 class="sh">Evening</h3>
      <ol class="atlas-list">{DAILY_PRACTICE_ATLAS.evening.map((d) => (
        <li><span class="atlas__when">{d.time}</span><div><span class="atlas__trad">{d.tradition}</span><p>{d.practice}</p></div></li>
      ))}</ol>
      <h3 class="sh">Weekly</h3>
      <ol class="atlas-list">{DAILY_PRACTICE_ATLAS.weekly.map((d) => (
        <li><span class="atlas__when">{d.event}</span><div><span class="atlas__trad">{d.tradition}</span><p>{d.practice}</p></div></li>
      ))}</ol>
    </section>

    <section class="movement"><p class="kicker">MOVEMENT PRACTICES · {MOVEMENT_PRACTICES.length}</p><h2>What to do with the body.</h2>
      <ol class="pr-list">{MOVEMENT_PRACTICES.map((p) => (
        <li style={`--mode-color: ${modeColor[p.mode]};`}>
          <div class="pr__head">
            <h3>{p.name}</h3>
            <span class="pr__meta">{p.duration} · <span class="pr__diff" style={`background: ${diffColor[p.difficulty]};`}>{p.difficulty}</span></span>
          </div>
          <p class="pr__row"><strong>What you do:</strong> {p.whatYouDo}</p>
          <p class="pr__row pr__effect"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pr__row pr__cau"><strong>Cautions:</strong> {p.cautions}</p>
          <p class="pr__trad"><strong>Tradition:</strong> {p.tradition}</p>
        </li>
      ))}</ol>
    </section>

    <section class="stillness"><p class="kicker">STILLNESS PRACTICES · {STILLNESS_PRACTICES.length}</p><h2>What to do without moving.</h2>
      <ol class="pr-list">{STILLNESS_PRACTICES.map((p) => (
        <li style={`--mode-color: ${modeColor[p.mode]};`}>
          <div class="pr__head">
            <h3>{p.name}</h3>
            <span class="pr__meta">{p.duration} · <span class="pr__diff" style={`background: ${diffColor[p.difficulty]};`}>{p.difficulty}</span></span>
          </div>
          <p class="pr__row"><strong>What you do:</strong> {p.whatYouDo}</p>
          <p class="pr__row pr__effect"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pr__row pr__cau"><strong>Cautions:</strong> {p.cautions}</p>
          <p class="pr__trad"><strong>Tradition:</strong> {p.tradition}</p>
        </li>
      ))}</ol>
    </section>

    <section class="breath"><p class="kicker">BREATH PRACTICES · {BREATH_PRACTICES.length}</p><h2>What to do with breath.</h2>
      <ol class="pr-list">{BREATH_PRACTICES.map((p) => (
        <li style={`--mode-color: ${modeColor[p.mode]};`}>
          <div class="pr__head">
            <h3>{p.name}</h3>
            <span class="pr__meta">{p.duration} · <span class="pr__diff" style={`background: ${diffColor[p.difficulty]};`}>{p.difficulty}</span></span>
          </div>
          <p class="pr__row"><strong>What you do:</strong> {p.whatYouDo}</p>
          <p class="pr__row pr__effect"><strong>What it does:</strong> {p.whatItDoes}</p>
          <p class="pr__row pr__cau"><strong>Cautions:</strong> {p.cautions}</p>
          <p class="pr__trad"><strong>Tradition:</strong> {p.tradition}</p>
        </li>
      ))}</ol>
    </section>

    <section class="acupressure"><p class="kicker">SELF-ACUPRESSURE PROTOCOLS · 10 POINTS</p><h2>Where to press, when, and how.</h2>
      <ol class="ap-list">{ACUPRESSURE_PROTOCOLS.map((a) => (
        <li>
          <div class="ap__head"><span class="ap__code">{a.code}</span></div>
          <p class="ap__row"><strong>When:</strong> {a.when}</p>
          <p class="ap__row"><strong>How:</strong> {a.how}</p>
          <p class="ap__row pr__trad"><strong>Tradition:</strong> {a.tradition}</p>
        </li>
      ))}</ol>
    </section>

    <section class="ladder"><p class="kicker">EIGHT-WEEK BEGINNER LADDER</p><h2>How to begin from zero.</h2>
      <ol class="lad-list">{EIGHT_WEEK_BEGINNER_LADDER.map((w) => (
        <li>
          <div class="lad__head"><span class="lad__week">WEEK {w.week}</span><h3>{w.theme}</h3></div>
          <p>{w.practice}</p>
        </li>
      ))}</ol>
    </section>

    <section class="cohort"><p class="kicker">COHORT OFFERINGS · {COHORT_OFFERINGS_EXTENDED.length}</p><h2>How to practice with others.</h2>
      <ol class="co-list">{COHORT_OFFERINGS_EXTENDED.map((c) => (
        <li>
          <h3>{c.offering}</h3>
          <p class="co__row"><strong>Format:</strong> {c.format}</p>
          <p class="co__row"><strong>Who leads:</strong> {c.whoLeads}</p>
        </li>
      ))}</ol>
    </section>

    <section class="teach"><p class="kicker">TEACHER REFERENCES</p><h2>How to find a real one.</h2>
      <p class="lede">{TEACHER_REFERENCES.description}</p>
      <h3 class="sh">Vetting criteria · {TEACHER_REFERENCES.vettingCriteria.length}</h3>
      <ul class="dt-list">{TEACHER_REFERENCES.vettingCriteria.map((v) => (<li>{v}</li>))}</ul>
      <h3 class="sh">How to find one · {TEACHER_REFERENCES.howToFindOne.length}</h3>
      <ul class="dt-list">{TEACHER_REFERENCES.howToFindOne.map((h) => (<li>{h}</li>))}</ul>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · COHORT MEMBERS · TEACHERS · PRACTITIONERS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
      <p class="closer"><em>{PAPER_NOTES.closingNote}</em></p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/living-body">Living Body · UES-WP-2026-18 (parent)</a>
      <a href="/marine-layer">Marine Layer · breath + sit cohort</a>
      <a href="/bath-house">Bath House · water + heat practice</a>
      <a href="/time">Time · time-fluency</a>
      <a href="/sabbatical">Sabbatical infrastructure</a>
      <a href="/civic-federation">The Civic Federation · institutional form</a>
      <a href="/practice.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --pr-ink:#1a1a1a; --pr-paper:#fdf9ee; --pr-mustard:#d4a534; --pr-rust:#b85a3a; --pr-sage:#2d6a3d; --pr-tide:#3d6a8a; --pr-mauve:#a06478; --pr-fog:#d8d2c4; --pr-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--pr-paper); color: var(--pr-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--pr-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--pr-mauve); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--pr-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--pr-mauve); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 130px; line-height: .9; font-weight: 700; letter-spacing: -.035em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--pr-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--pr-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--pr-mauve); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--pr-mauve); }

  .lede { font-size: 15px; line-height: 1.65; margin: 0 0 14px; max-width: 72ch; font-family: Georgia, serif; }

  /* Principles */
  .prin-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .prin-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 6px solid var(--pr-mauve); }
  .prin__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--pr-mauve); }
  .prin__num { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--pr-mauve); }
  .prin__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .prin-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Atlas */
  .atlas-list { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 6px; }
  .atlas-list li { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 5px solid var(--pr-mauve); align-items: baseline; }
  .atlas__when { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--pr-rust); letter-spacing: .08em; }
  .atlas__trad { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--pr-mauve); display: block; margin-bottom: 4px; }
  .atlas-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  /* Practice cards (movement / stillness / breath) */
  .pr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .pr-list li { padding: 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 8px solid var(--mode-color); }
  .pr__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; padding-bottom: 6px; border-bottom: 2px solid var(--mode-color); }
  .pr__head h3 { font-family: var(--pc-font-mono); font-size: 15px; margin: 0; flex: 1; }
  .pr__meta { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .1em; color: var(--pr-slate); display: flex; align-items: center; gap: 8px; }
  .pr__diff { font-size: 9.5px; padding: 2px 6px; color: #fff; letter-spacing: .12em; }
  .pr__row { padding: 7px 10px; background: var(--pr-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; border-left: 3px solid var(--pr-fog); }
  .pr__effect { border-left-color: var(--pr-sage); }
  .pr__cau { border-left-color: var(--pr-rust); }
  .pr__trad { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .12em; color: var(--pr-slate); padding: 4px 0; margin-top: 8px !important; background: none; border-left: none; }
  .pr-list strong, .ap-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--mode-color, var(--pr-mauve)); margin-right: 4px; }
  .pr__trad strong { color: var(--pr-slate); }

  /* Acupressure */
  .ap-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ap-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 6px solid var(--pr-sage); }
  .ap__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 2px solid var(--pr-sage); }
  .ap__code { font-family: var(--pc-font-mono); font-size: 16px; font-weight: 700; color: var(--pr-sage); padding: 2px 8px; background: var(--pr-paper); }
  .ap__row { padding: 6px 10px; background: var(--pr-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--pr-fog); }
  .ap-list strong { color: var(--pr-sage); }

  /* Ladder */
  .lad-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .lad-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 6px solid var(--pr-mustard); }
  .lad__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--pr-mustard); }
  .lad__week { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--pr-rust); padding: 2px 8px; background: var(--pr-paper); letter-spacing: .12em; }
  .lad__head h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0; flex: 1; }
  .lad-list p { margin: 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  /* Cohort offerings */
  .co-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .co-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--pr-ink); border-left: 6px solid var(--pr-mauve); }
  .co-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--pr-mauve); }
  .co__row { padding: 6px 10px; background: var(--pr-paper); margin: 4px 0 !important; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; border-left: 3px solid var(--pr-mustard); }
  .co__row strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--pr-mauve); margin-right: 4px; }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }

  .invitation { background: var(--pr-mauve); color: var(--pr-paper); border-top-color: var(--pr-mauve); }
  .invitation .kicker { background: var(--pr-mustard); color: var(--pr-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--pr-mustard); color: var(--pr-ink); border-left: 4px solid var(--pr-paper); font-weight: 500; }
  .closer { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; opacity: .9; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 4px solid var(--pr-mustard); line-height: 1.5; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--pr-mauve); color: var(--pr-paper); text-decoration: none; }
  .links a:hover { background: var(--pr-rust); }

  @media (max-width: 800px) { h1 { font-size: 90px; } .atlas-list li { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 60px; } }
</style>
