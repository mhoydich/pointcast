---
/**
 * /reads — the reading room.
 *
 * Sprint 3 (Mike 2026-05-09 PT: "start the sprint"). A small library of
 * 300-500 word cc-voice editorial cards that sit alongside the playable
 * rooms. Each card is one idea, slow on purpose, paired with a room
 * where one exists.
 *
 * Launch trio: McLuhan (Understanding Media), Sumo (the sport, paired
 * with /sumo). More cards land through the sprint.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const reads = [
  {
    slug: 'mcluhan',
    kicker: 'media',
    title: 'Understanding Media',
    dek: 'Marshall McLuhan, 1964. The medium is the message. Why a small Astro room in El Segundo is doing the same job as a printing press, only quieter.',
    minutes: '4 min',
  },
  {
    slug: 'sumo',
    kicker: 'sport',
    title: 'Sumo, the slow ritual',
    dek: 'A 2,000-year-old sport built around salt, rope, sand, and one short collision. Companion note to /sumo.',
    minutes: '3 min',
    pairsWith: '/sumo',
  },
];
---

<BaseLayout
  title="Reads"
  description="A small reading room on PointCast. cc-voice editorial cards on books, sport, music, and the things that hold the broadcast up."
>
  <div class="max-w-[40rem] mx-auto px-4 py-12 md:py-16">
    <a
      href="/"
      class="inline-flex items-center gap-2 mb-8 font-mono text-[0.6rem] tracking-[0.18em] uppercase text-ink-soft hover:text-warm transition-colors"
    >
      &larr; PointCast
    </a>

    <header class="mb-10">
      <div class="kicker">Reads</div>
      <h1 class="font-serif text-[1.65rem] text-ink font-medium italic mb-3 leading-[1.15]">
        The reading room
      </h1>
      <p class="text-[0.95rem] text-ink/70 leading-relaxed">
        Short cc-voice notes on the things that hold the broadcast up — books,
        sport, music, places. Slow on purpose. Each card sits next to its room
        when one exists.
      </p>
    </header>

    <ul class="space-y-6 list-none p-0 m-0">
      {reads.map((r) => (
        <li class="border-t border-ink/10 pt-6">
          <a
            href={`/reads/${r.slug}`}
            class="block group"
          >
            <div class="flex items-baseline justify-between gap-4 mb-2">
              <span class="font-mono text-[0.6rem] tracking-[0.18em] uppercase text-ink-soft">
                {r.kicker}
              </span>
              <span class="font-mono text-[0.6rem] tracking-[0.12em] uppercase text-ink-soft">
                {r.minutes}
              </span>
            </div>
            <h2 class="font-serif text-[1.25rem] text-ink font-medium italic mb-2 leading-[1.2] group-hover:text-warm transition-colors">
              {r.title}
            </h2>
            <p class="text-[0.9rem] text-ink/70 leading-relaxed">
              {r.dek}
            </p>
            {r.pairsWith && (
              <p class="mt-2 font-mono text-[0.62rem] tracking-[0.12em] uppercase text-ink-soft">
                pairs with <span class="text-warm">{r.pairsWith}</span>
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-12 font-mono text-[0.6rem] tracking-[0.12em] uppercase text-ink-soft">
      more landing through sprint 3 — coffee, good charts, treasure island, socal 2026, palace
    </p>
  </div>
</BaseLayout>
