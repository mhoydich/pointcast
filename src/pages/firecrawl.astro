---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FIRECRAWL_SETUP } from '../lib/pointcast-agent-kit';
import {
  BOUNDARIES,
  CRAWL_COMPACT,
  CRAWL_STAGES,
  FIRECRAWL_FIELD_GUIDE,
  FIRECRAWL_INTEREST,
  HISTORY,
  LENSES,
  SOURCE_LEDGER,
} from '../lib/firecrawl-field-guide';

const sourceById = new Map(SOURCE_LEDGER.map((source) => [source.id, source]));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${FIRECRAWL_FIELD_GUIDE.canonical}#article`,
  headline: FIRECRAWL_FIELD_GUIDE.title,
  alternativeHeadline: FIRECRAWL_FIELD_GUIDE.subtitle,
  description: FIRECRAWL_FIELD_GUIDE.shortThesis,
  url: FIRECRAWL_FIELD_GUIDE.canonical,
  datePublished: FIRECRAWL_FIELD_GUIDE.publishedAt,
  dateModified: FIRECRAWL_FIELD_GUIDE.publishedAt,
  author: [
    { '@type': 'Person', name: 'Michael Hoydich', url: 'https://pointcast.xyz/about' },
    { '@type': 'SoftwareApplication', name: 'Codex', applicationCategory: 'AI collaborator' },
  ],
  publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz' },
  mainEntityOfPage: FIRECRAWL_FIELD_GUIDE.canonical,
  isPartOf: { '@type': 'CreativeWork', name: 'PointCast', url: 'https://pointcast.xyz' },
  citation: SOURCE_LEDGER.map((source) => source.href),
};
---

<BlockLayout
  title={FIRECRAWL_FIELD_GUIDE.title}
  description={FIRECRAWL_FIELD_GUIDE.subtitle}
  image="https://pointcast.xyz/images/firecrawl/field-guide-og.png"
  themeColor="#1715ff"
  immersive={true}
  showNetworkStrip={false}
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/firecrawl.json', title: 'Firecrawl field guide — machine edition' }]}
  frame={{
    image: 'https://pointcast.xyz/images/firecrawl/field-guide-og.png',
    aspectRatio: '1.91:1',
    buttons: [
      { label: 'Read the field guide', action: 'link', target: FIRECRAWL_FIELD_GUIDE.canonical },
      { label: 'Open the JSON twin', action: 'link', target: FIRECRAWL_FIELD_GUIDE.machine },
    ],
  }}
>
  <article class="crawl-page">
    <nav class="crawl-nav" aria-label="Firecrawl field guide navigation">
      <a class="crawl-brand" href="/">PointCast</a>
      <div class="crawl-nav__links">
        <a href="#machine">The machine</a>
        <a href="#history">History</a>
        <a href="#lenses">Eight lenses</a>
        <a href="#compact">Crawl compact</a>
        <a href="/firecrawl.json">JSON</a>
      </div>
      <span class="crawl-nav__block">Block 0552</span>
    </nav>

    <header class="crawl-hero">
      <div class="crawl-hero__flag">
        <span>Field guide 001</span>
        <span>El Segundo · August 2, 2026</span>
        <span>Human page + machine twin</span>
      </div>

      <div class="crawl-hero__grid">
        <div class="crawl-hero__copy">
          <p class="crawl-kicker">Firecrawl · web spiders · indexing · permission</p>
          <h1>Who gets to<br /><em>read the web?</em></h1>
          <p class="crawl-hero__dek">{FIRECRAWL_FIELD_GUIDE.subtitle}</p>
          <div class="crawl-hero__actions">
            <a class="crawl-button crawl-button--ink" href="#machine">Release the spider ↓</a>
            <a class="crawl-button" href="/connectors#firecrawl">Get Firecrawl going ↗</a>
          </div>
        </div>

        <div class="crawl-hero__map" aria-label="An illustrated network of pages connected by a crawler path">
          <span class="map-label map-label--top">PUBLIC WEB / NOT PUBLIC DOMAIN</span>
          <svg viewBox="0 0 700 540" role="img" aria-label="A blue spider follows links between pages and an index">
            <defs>
              <marker id="crawl-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
              </marker>
            </defs>
            <g class="map-links">
              <path d="M98 110 C210 70 230 145 325 150"></path>
              <path d="M325 150 C410 158 440 90 565 105"></path>
              <path d="M325 150 C275 250 210 265 145 338"></path>
              <path d="M325 150 C390 245 458 225 544 300"></path>
              <path d="M145 338 C265 420 398 410 544 300"></path>
              <path d="M544 300 C560 370 500 435 418 462"></path>
            </g>
            <g class="map-node map-node--page" transform="translate(52 73)">
              <rect width="92" height="74" rx="2"></rect><path d="M0 18H92"></path><circle cx="12" cy="9" r="3"></circle><circle cx="23" cy="9" r="3"></circle><text x="12" y="45">PAGE A</text>
            </g>
            <g class="map-node map-node--page" transform="translate(279 114)">
              <rect width="92" height="74" rx="2"></rect><path d="M0 18H92"></path><circle cx="12" cy="9" r="3"></circle><circle cx="23" cy="9" r="3"></circle><text x="12" y="45">PAGE B</text>
            </g>
            <g class="map-node map-node--rules" transform="translate(519 69)">
              <rect width="92" height="74" rx="46"></rect><text x="46" y="34">ROBOTS</text><text x="46" y="51">.TXT</text>
            </g>
            <g class="map-node map-node--page" transform="translate(99 302)">
              <rect width="92" height="74" rx="2"></rect><path d="M0 18H92"></path><circle cx="12" cy="9" r="3"></circle><circle cx="23" cy="9" r="3"></circle><text x="12" y="45">PAGE C</text>
            </g>
            <g class="map-node map-node--spider" transform="translate(500 256)">
              <circle cx="44" cy="44" r="31"></circle>
              <circle cx="44" cy="44" r="13"></circle>
              <path d="M28 30L13 16M24 42L7 39M28 56L13 70M60 30L75 16M64 42L81 39M60 56L75 70"></path>
              <text x="44" y="97">CRAWLER</text>
            </g>
            <g class="map-node map-node--index" transform="translate(355 422)">
              <path d="M0 10L63 0L126 10V72L63 82L0 72Z"></path><path d="M0 30L63 40L126 30M0 51L63 61L126 51"></path><text x="63" y="103">INDEX</text>
            </g>
          </svg>
          <span class="map-label map-label--bottom">LINK → FETCH → RECORD → RETURN</span>
        </div>
      </div>

      <p class="crawl-thesis">“{FIRECRAWL_FIELD_GUIDE.thesis}”</p>
    </header>

    <section class="crawl-opening" aria-labelledby="opening-title">
      <div>
        <p class="section-number">00 / THE ARGUMENT</p>
        <h2 id="opening-title">A spider is a reader<br />with consequences.</h2>
      </div>
      <div class="crawl-opening__copy">
        <p class="dropcap">A web crawler begins with an ordinary gesture: follow the link. Then it repeats the gesture faster than a person can, remembers what it finds, and makes the result available to somebody else.</p>
        <p>That repetition built search engines. It also built archives, price trackers, research corpora, accessibility tools, spam indexes, competitive intelligence, model datasets, and dozens of businesses whose central claim is that the public web can be made portable.</p>
        <p>The moral argument does not sit outside the machinery. It is inside the crawl depth, the user agent, the rate limit, the fields retained, the time a copy persists, the people made searchable, the source kept or lost, and the person who can ask for removal.</p>
        <aside><strong>Publicly reachable</strong> describes a technical condition. It does not, by itself, answer every question about permission, privacy, reuse, attribution, cost, or harm.</aside>
      </div>
    </section>

    <section class="crawl-machine" id="machine" aria-labelledby="machine-title">
      <header class="section-head section-head--light">
        <p>01 / THE MACHINE</p>
        <h2 id="machine-title">Watch one URL<br />become an answer.</h2>
        <p>Run the bounded trace. Nothing is fetched; this is a browser-local model of the seven decisions inside a modern crawl.</p>
      </header>

      <div class="crawl-console" data-crawl-console>
        <div class="crawl-console__bar">
          <span>POINTCAST CRAWL SCOPE</span>
          <span data-crawl-status>READY / NO NETWORK REQUEST</span>
        </div>
        <div class="crawl-console__url"><span>seed</span><strong>https://pointcast.xyz/firecrawl</strong><i data-crawl-progress>0 / 7</i></div>
        <ol class="crawl-steps">
          {CRAWL_STAGES.map((stage, index) => (
            <li class="crawl-step" data-crawl-step data-index={index}>
              <button type="button" data-crawl-select={index} aria-label={`Inspect stage ${stage.number}: ${stage.verb}`}>
                <span>{stage.number}</span>
                <strong>{stage.verb}</strong>
                <small>{stage.trace}</small>
              </button>
              <div>
                <h3>{stage.question}</h3>
                <p>{stage.description}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="crawl-console__controls">
          <button class="crawl-button crawl-button--signal" type="button" data-crawl-run>Release the spider</button>
          <button class="crawl-button crawl-button--ghost" type="button" data-crawl-reset>Reset trace</button>
          <span>Browser-local · no storage · no telemetry · no fetch</span>
        </div>
      </div>
    </section>

    <section class="firecrawl-now" aria-labelledby="firecrawl-title">
      <div class="firecrawl-now__intro">
        <p class="section-number">02 / FIRECRAWL</p>
        <h2 id="firecrawl-title">The crawler<br />after JavaScript.</h2>
        <p>Firecrawl is an open-source web data API. Give it a page or site and ask for model-ready Markdown, links, screenshots, or structured JSON. It can search, map, crawl, render, and interact with pages that do not arrive as clean static HTML.</p>
        <p>Its origin story is telling: the team says it emerged from repeatedly needing dependable web extraction for Mendable. The new product is not the spider itself so much as a maintained agreement among browser automation, parsing, retries, anti-bot friction, and AI-shaped output.</p>
        <div class="firecrawl-now__facts" aria-label="Firecrawl facts">
          <span><b>2024</b><small>founded</small></span>
          <span><b>AGPL</b><small>main repository</small></span>
          <span><b>1 API</b><small>many crawl stages</small></span>
        </div>
      </div>
      <div class="firecrawl-now__cards">
        {FIRECRAWL_INTEREST.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')} · {item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="crawl-install" aria-labelledby="install-title">
      <div>
        <p class="section-number">03 / TRY THE TOOL</p>
        <h2 id="install-title">Bring a<br />web reader.</h2>
        <p>Firecrawl can sit beside ChatGPT, Codex, Claude, or another MCP-aware client. For PointCast itself, native JSON, feeds, and MCP come first; use a browser crawler when a page actually needs rendering or the work crosses into outside sites.</p>
      </div>
      <div class="crawl-install__terminal">
        <div class="terminal-head"><span>FIRECRAWL / QUICK START</span><a href={FIRECRAWL_SETUP.repository} target="_blank" rel="noopener">open source ↗</a></div>
        <div class="terminal-line"><span>01</span><code>{FIRECRAWL_SETUP.install}</code><button type="button" data-copy={FIRECRAWL_SETUP.install}>Copy</button></div>
        <div class="terminal-line"><span>02</span><code>{FIRECRAWL_SETUP.smoke}</code><button type="button" data-copy={FIRECRAWL_SETUP.smoke}>Copy</button></div>
        <div class="terminal-line"><span>03</span><code>{FIRECRAWL_SETUP.crawl}</code><button type="button" data-copy={FIRECRAWL_SETUP.crawl}>Copy</button></div>
        <p>{FIRECRAWL_SETUP.rule}</p>
        <div class="terminal-links">
          <a href="/connectors#firecrawl">Full PointCast setup ↗</a>
          <a href={FIRECRAWL_SETUP.docs} target="_blank" rel="noopener">Firecrawl docs ↗</a>
          <a href={FIRECRAWL_SETUP.repository} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>

    <section class="crawl-history" id="history" aria-labelledby="history-title">
      <header class="section-head">
        <p>04 / A SHORT HISTORY OF THE SPIDER</p>
        <h2 id="history-title">Before the answer,<br />there was a list.</h2>
        <p>The history of crawling is a history of the web trying to know its own size—and then deciding what should appear first.</p>
      </header>
      <ol class="history-line">
        {HISTORY.map((entry, index) => (
          <li>
            <span class="history-line__number">{String(index + 1).padStart(2, '0')}</span>
            <time>{entry.year}</time>
            <div>
              <h3>{entry.title}</h3>
              <p>{entry.body}</p>
              <p class="history-line__sources">
                {entry.sourceIds.map((id) => {
                  const source = sourceById.get(id);
                  return source ? <a href={source.href} target="_blank" rel="noopener">{source.publisher} ↗</a> : null;
                })}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="index-essay" aria-labelledby="index-title">
      <div class="index-essay__poster" aria-hidden="true">
        <span>INDEX</span>
        <span>IS A</span>
        <span>POINT</span>
        <span>OF VIEW</span>
      </div>
      <div class="index-essay__copy">
        <p class="section-number">05 / THE INDEX</p>
        <h2 id="index-title">A map that<br />answers back.</h2>
        <p>A crawl is a collection procedure. An index is the structure that makes the collection retrievable. It breaks documents into terms and fields, resolves duplicates, records relationships, and prepares an answer to a future query.</p>
        <p>Then ranking begins. Google’s 1998 paper made the web’s link structure useful as a signal: a link could behave something like a citation, and citations could help order results. That was a technical breakthrough and a governance system. To rank is to allocate visibility.</p>
        <p>Search documentation still keeps three verbs usefully separate: crawling discovers and fetches; indexing interprets and stores; serving retrieves and orders. The distinction matters. A publisher may want a crawler to see a <code>noindex</code> instruction precisely so the page will not be indexed.</p>
        <blockquote>Every index has a collection policy, a forgetting policy, and an argument about relevance—even when those policies are hidden behind one search box.</blockquote>
      </div>
    </section>

    <section class="crawl-lenses" id="lenses" aria-labelledby="lenses-title">
      <header class="section-head section-head--light">
        <p>06 / WHO GETS TO DO IT?</p>
        <h2 id="lenses-title">Turn the question.<br />Keep the conflict.</h2>
        <p>No single lens closes the case. Choose a position to see what it protects, what it risks, and what it owes.</p>
      </header>

      <div class="lens-board" data-lens-board>
        <div class="lens-tabs" role="tablist" aria-label="Perspectives on web crawling">
          {LENSES.map((lens, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-lens-tab={lens.id}
            >
              <span>{lens.number}</span>{lens.name}
            </button>
          ))}
        </div>
        <div class="lens-panels">
          {LENSES.map((lens, index) => (
            <article role="tabpanel" data-lens-panel={lens.id} hidden={index !== 0}>
              <span class="lens-panels__number">{lens.number}</span>
              <p class="lens-panels__name">From the desk of the {lens.name.toLowerCase()}</p>
              <h3>{lens.question}</h3>
              <p>{lens.argument}</p>
              <div><span>THE OBLIGATION</span><p>{lens.obligation}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="crawl-robots" aria-labelledby="robots-title">
      <div class="crawl-robots__file">
        <div><span>robots.txt</span><span>host: example.org</span></div>
        <code>User-agent: FieldGuideBot</code>
        <code>Disallow: /private-draft/</code>
        <code>Crawl-delay: be kind</code>
        <code>Sitemap: /sitemap.xml</code>
        <span class="crawl-robots__stamp">REQUEST<br />NOT LOCK</span>
      </div>
      <div class="crawl-robots__copy">
        <p class="section-number">07 / ROBOTS.TXT</p>
        <h2 id="robots-title">Etiquette is<br />not security.</h2>
        <p>The Robots Exclusion Protocol is a small marvel: a public file where a host asks automated visitors not to enter certain paths. It turns social coordination into text a machine can read.</p>
        <p>Its limit is equally important. RFC 9309 says the rules are not access authorization. A robots file cannot make sensitive material private; in fact, naming a private-looking path can reveal it. Protect secrets with authentication and access control.</p>
        <p>Robots rules also do not express every possible downstream use. Indexing for search, archiving for history, extracting facts, training a model, quoting criticism, and reproducing a work are different relationships even when the same HTTP request begins them.</p>
      </div>
    </section>

    <section class="crawl-compact" id="compact" aria-labelledby="compact-title">
      <header class="section-head">
        <p>08 / A CRAWL COMPACT</p>
        <h2 id="compact-title">Eight rules for<br />a courteous machine.</h2>
        <p>Not a substitute for law, site policy, or judgment. A practical floor for people building readers.</p>
      </header>
      <ol>
        {CRAWL_COMPACT.map((rule) => (
          <li>
            <span>{rule.number}</span>
            <h3>{rule.title}</h3>
            <p>{rule.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="crawl-boundaries" aria-labelledby="boundaries-title">
      <div>
        <p class="section-number">09 / BOUNDARIES</p>
        <h2 id="boundaries-title">What this page<br />does not settle.</h2>
      </div>
      <div class="crawl-boundaries__grid">
        <article><span>LEGAL</span><p>{BOUNDARIES.legal}</p></article>
        <article><span>ROBOTS</span><p>{BOUNDARIES.robots}</p></article>
        <article><span>PRODUCT</span><p>{BOUNDARIES.product}</p></article>
        <article><span>PRIVACY</span><p>{BOUNDARIES.privacy}</p></article>
      </div>
    </section>

    <section class="crawl-sources" id="sources" aria-labelledby="sources-title">
      <header class="section-head">
        <p>10 / SOURCE LEDGER</p>
        <h2 id="sources-title">The links behind<br />the links.</h2>
        <p>Primary and official sources wherever possible. Product and policy details were checked for this edition on August 2, 2026.</p>
      </header>
      <ol>
        {SOURCE_LEDGER.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><strong>{source.publisher}</strong><small>{source.kind}</small></div>
            <a href={source.href} target="_blank" rel="noopener">{source.title} ↗</a>
            <p>{source.supports}</p>
          </li>
        ))}
      </ol>
    </section>

    <footer class="crawl-footer">
      <div>
        <span>PointCast Field Guide 001 · Block 0552</span>
        <h2>The web stays open<br />through negotiated attention.</h2>
      </div>
      <div>
        <p>{FIRECRAWL_FIELD_GUIDE.scope}</p>
        <nav aria-label="Feature companions">
          <a href="/firecrawl.json">Machine edition ↗</a>
          <a href="/connectors#firecrawl">Firecrawl setup ↗</a>
          <a href="/agent-kit.md">Agent kit ↗</a>
          <a href="/b/0552">Permanent Block ↗</a>
          <a href="/">PointCast home ↗</a>
        </nav>
      </div>
    </footer>
  </article>

  <script>
    const consoleRoot = document.querySelector<HTMLElement>('[data-crawl-console]');
    if (consoleRoot) {
      const steps = Array.from(consoleRoot.querySelectorAll<HTMLElement>('[data-crawl-step]'));
      const status = consoleRoot.querySelector<HTMLElement>('[data-crawl-status]');
      const progress = consoleRoot.querySelector<HTMLElement>('[data-crawl-progress]');
      const runButton = consoleRoot.querySelector<HTMLButtonElement>('[data-crawl-run]');
      const resetButton = consoleRoot.querySelector<HTMLButtonElement>('[data-crawl-reset]');
      let timer = 0;
      let active = -1;

      const showStep = (index: number) => {
        active = index;
        steps.forEach((step, stepIndex) => {
          step.toggleAttribute('data-active', stepIndex === index);
          step.toggleAttribute('data-complete', stepIndex < index);
        });
        const selected = steps[index];
        if (status && selected) {
          const verb = selected.querySelector('strong')?.textContent?.toUpperCase() ?? 'TRACE';
          status.textContent = `${verb} / SIMULATED`;
        }
        if (progress) progress.textContent = `${Math.max(0, index + 1)} / ${steps.length}`;
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = 0;
        if (runButton) runButton.textContent = active >= steps.length - 1 ? 'Run it again' : 'Release the spider';
      };

      const run = () => {
        stop();
        if (active >= steps.length - 1) active = -1;
        showStep(active + 1);
        if (runButton) runButton.textContent = 'Tracing…';
        timer = window.setInterval(() => {
          if (active >= steps.length - 1) {
            stop();
            if (status) status.textContent = 'ANSWER READY / SOURCES ATTACHED';
            return;
          }
          showStep(active + 1);
        }, 760);
      };

      runButton?.addEventListener('click', run);
      resetButton?.addEventListener('click', () => {
        stop();
        active = -1;
        steps.forEach((step) => {
          step.removeAttribute('data-active');
          step.removeAttribute('data-complete');
        });
        if (status) status.textContent = 'READY / NO NETWORK REQUEST';
        if (progress) progress.textContent = `0 / ${steps.length}`;
      });
      consoleRoot.querySelectorAll<HTMLButtonElement>('[data-crawl-select]').forEach((button) => {
        button.addEventListener('click', () => {
          stop();
          showStep(Number(button.dataset.crawlSelect ?? 0));
        });
      });
    }

    const lensBoard = document.querySelector<HTMLElement>('[data-lens-board]');
    if (lensBoard) {
      const tabs = Array.from(lensBoard.querySelectorAll<HTMLButtonElement>('[data-lens-tab]'));
      const panels = Array.from(lensBoard.querySelectorAll<HTMLElement>('[data-lens-panel]'));
      const selectLens = (id: string) => {
        tabs.forEach((tab) => {
          const selected = tab.dataset.lensTab === id;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.dataset.lensPanel !== id; });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectLens(tab.dataset.lensTab ?? 'publisher'));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(index + direction + tabs.length) % tabs.length];
          selectLens(next.dataset.lensTab ?? 'publisher');
          next.focus();
        });
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
          button.textContent = 'Copied';
        } catch {
          const input = document.createElement('textarea');
          input.value = value;
          input.style.position = 'fixed';
          input.style.opacity = '0';
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          input.remove();
          button.textContent = 'Copied';
        }
        window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
      });
    });
  </script>
</BlockLayout>

<style is:global>
  :root {
    --crawl-paper: #f4f0e7;
    --crawl-ink: #11100d;
    --crawl-blue: #1715ff;
    --crawl-lime: #d9ff45;
    --crawl-pink: #ffb8d6;
    --crawl-line: rgba(17, 16, 13, 0.25);
    --crawl-mono: 'JetBrains Mono Variable', 'SFMono-Regular', Consolas, monospace;
    --crawl-sans: 'Inter Variable', Arial, sans-serif;
  }

  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--crawl-paper); color: var(--crawl-ink); font-family: var(--crawl-sans); }
  .crawl-page { overflow: hidden; }
  .crawl-page * { box-sizing: border-box; }
  .crawl-page a { color: inherit; }
  .crawl-nav {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem;
    min-height: 58px; padding: 0 2.5rem; border-bottom: 1px solid var(--crawl-ink);
    background: var(--crawl-paper); font-family: var(--crawl-mono); font-size: 0.72rem; text-transform: uppercase;
  }
  .crawl-brand { font: 800 1.05rem/1 var(--crawl-sans); letter-spacing: -0.04em; text-decoration: none; text-transform: none; }
  .crawl-nav__links { display: flex; align-items: center; gap: 1.4rem; }
