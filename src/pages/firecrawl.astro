  }
  .crawl-hero__grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(450px, 1.08fr); min-height: 690px; }
  .crawl-hero__copy { padding: clamp(4rem, 8vw, 8rem) clamp(2rem, 5vw, 6rem); display: flex; flex-direction: column; justify-content: center; }
  .crawl-kicker, .section-number, .section-head > p:first-child {
    margin: 0 0 1.4rem; font: 700 0.69rem/1.3 var(--crawl-mono); letter-spacing: 0.04em; text-transform: uppercase;
  }
  .crawl-hero h1 { margin: 0; max-width: 780px; font-size: clamp(4rem, 7.5vw, 8.4rem); line-height: 0.82; letter-spacing: -0.085em; }
  .crawl-hero h1 em { color: var(--crawl-blue); font-style: normal; }
  .crawl-hero__dek { max-width: 620px; margin: 2rem 0 0; font-size: clamp(1.1rem, 1.5vw, 1.45rem); line-height: 1.35; letter-spacing: -0.025em; }
  .crawl-hero__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.25rem; }
  .crawl-button {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0.8rem 1.1rem;
    border: 1px solid var(--crawl-ink); border-radius: 0; background: transparent; color: var(--crawl-ink);
    font: 700 0.75rem/1 var(--crawl-mono); text-decoration: none; text-transform: uppercase; cursor: pointer;
  }
  .crawl-button:hover, .crawl-button:focus-visible { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--crawl-ink); }
  .crawl-page .crawl-button--ink { background: var(--crawl-ink); color: white; }
  .crawl-hero__map { position: relative; display: grid; place-items: center; min-height: 620px; border-left: 1px solid var(--crawl-ink); background: var(--crawl-pink); }
  .crawl-hero__map svg { width: min(95%, 760px); height: auto; color: var(--crawl-blue); }
  .map-links path { fill: none; stroke: currentColor; stroke-width: 3; stroke-dasharray: 6 8; marker-end: url(#crawl-arrow); }
  .map-node rect, .map-node circle, .map-node path { fill: var(--crawl-paper); stroke: currentColor; stroke-width: 3; }
  .map-node text { fill: currentColor; stroke: none; font: 700 14px var(--crawl-mono); }
  .map-node--rules text, .map-node--spider text, .map-node--index text { text-anchor: middle; }
  .map-node--spider { transform-origin: 544px 300px; animation: crawl-bob 2.2s ease-in-out infinite; }
  .map-label { position: absolute; left: 1rem; font: 700 0.67rem/1 var(--crawl-mono); }
  .map-label--top { top: 1rem; }
  .map-label--bottom { bottom: 1rem; }
  .crawl-thesis { margin: 0; padding: 1.1rem 2.5rem; border-top: 1px solid var(--crawl-ink); font: 700 clamp(0.82rem, 1.25vw, 1.05rem)/1.35 var(--crawl-mono); text-align: center; }

  .crawl-opening, .crawl-install, .crawl-boundaries {
    display: grid; grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr); gap: clamp(3rem, 8vw, 9rem);
    padding: clamp(5rem, 9vw, 10rem) max(2rem, calc((100vw - 1420px) / 2)); border-bottom: 1px solid var(--crawl-ink);
  }
  .crawl-opening h2, .crawl-install h2, .crawl-boundaries h2, .firecrawl-now h2, .section-head h2, .index-essay h2, .crawl-robots h2 {
    margin: 0; font-size: clamp(3rem, 6vw, 7rem); line-height: 0.89; letter-spacing: -0.075em;
  }
  .crawl-opening__copy { max-width: 800px; }
  .crawl-opening__copy > p { margin: 0 0 1.5rem; font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.5; letter-spacing: -0.025em; }
  .crawl-opening__copy .dropcap::first-letter { float: left; margin: 0.08em 0.1em 0 0; color: var(--crawl-blue); font-size: 5.4em; font-weight: 800; line-height: 0.72; }
  .crawl-opening aside { margin-top: 3rem; padding: 1.4rem; border: 1px solid var(--crawl-ink); background: white; font: 0.9rem/1.55 var(--crawl-mono); }

  .crawl-machine, .crawl-lenses { padding: clamp(5rem, 9vw, 10rem) max(2rem, calc((100vw - 1420px) / 2)); background: var(--crawl-blue); color: white; border-bottom: 1px solid var(--crawl-ink); }
  .section-head { display: grid; grid-template-columns: 0.55fr 1.2fr 0.75fr; align-items: end; gap: 2rem; margin-bottom: clamp(3rem, 6vw, 6rem); }
  .section-head > p { margin: 0; }
  .section-head > p:last-child { max-width: 420px; font-size: 1.05rem; line-height: 1.5; }
  .section-head--light { color: white; }
  .crawl-console { border: 1px solid white; background: #0d0c82; font-family: var(--crawl-mono); }
  .crawl-console__bar, .crawl-console__url { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 1rem; border-bottom: 1px solid rgba(255,255,255,.45); font-size: 0.7rem; text-transform: uppercase; }
  .crawl-console__url { align-items: center; background: white; color: var(--crawl-ink); }
  .crawl-console__url strong { flex: 1; font-size: clamp(0.72rem, 1.5vw, 1rem); overflow-wrap: anywhere; }
  .crawl-console__url i { font-style: normal; }
  .crawl-steps { display: grid; grid-template-columns: repeat(7, 1fr); margin: 0; padding: 0; list-style: none; }
  .crawl-step { min-width: 0; border-right: 1px solid rgba(255,255,255,.45); }
  .crawl-step:last-child { border-right: 0; }
  .crawl-step > button { width: 100%; min-height: 180px; padding: 1rem; border: 0; background: transparent; color: white; text-align: left; cursor: pointer; font-family: var(--crawl-mono); }
  .crawl-step > button span, .crawl-step > button small { display: block; color: rgba(255,255,255,.65); font-size: 0.62rem; text-transform: uppercase; }
  .crawl-step > button strong { display: block; margin: 2.8rem 0 0.4rem; font-size: clamp(0.75rem, 1.2vw, 1rem); text-transform: uppercase; overflow-wrap: anywhere; }
  .crawl-step > div { display: none; min-height: 240px; padding: 1.2rem; border-top: 1px solid rgba(255,255,255,.45); background: var(--crawl-lime); color: var(--crawl-ink); }
  .crawl-step > div h3 { margin: 0 0 1rem; font: 700 0.9rem/1.25 var(--crawl-mono); }
  .crawl-step > div p { margin: 0; font: 0.78rem/1.6 var(--crawl-mono); }
  .crawl-step[data-active] > button { background: var(--crawl-pink); color: var(--crawl-ink); }
  .crawl-step[data-active] > button span, .crawl-step[data-active] > button small { color: rgba(17,16,13,.6); }
  .crawl-step[data-active] > div { display: block; }
  .crawl-step[data-complete] > button { background: rgba(217,255,69,.16); }
  .crawl-console__controls { display: flex; align-items: center; gap: 0.8rem; padding: 1rem; border-top: 1px solid white; }
  .crawl-console__controls > span { margin-left: auto; color: rgba(255,255,255,.65); font-size: 0.62rem; text-transform: uppercase; }
  .crawl-button--signal { background: var(--crawl-lime); }
  .crawl-button--ghost { border-color: white; color: white; }

  .firecrawl-now { display: grid; grid-template-columns: 0.9fr 1.1fr; border-bottom: 1px solid var(--crawl-ink); }
  .firecrawl-now__intro { padding: clamp(5rem, 9vw, 10rem) clamp(2rem, 6vw, 7rem); background: var(--crawl-pink); }
  .firecrawl-now__intro > p:not(.section-number) { max-width: 650px; font-size: 1.1rem; line-height: 1.55; }
  .firecrawl-now__facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 3rem; border: 1px solid var(--crawl-ink); background: var(--crawl-ink); }
  .firecrawl-now__facts span { padding: 1rem; background: var(--crawl-paper); }
  .firecrawl-now__facts b, .firecrawl-now__facts small { display: block; }
  .firecrawl-now__facts b { font-size: clamp(1.3rem, 2.5vw, 2.4rem); letter-spacing: -0.06em; }
  .firecrawl-now__facts small { margin-top: 0.3rem; font: 0.62rem/1.3 var(--crawl-mono); text-transform: uppercase; }
  .firecrawl-now__cards { display: grid; grid-template-columns: 1fr 1fr; }
  .firecrawl-now__cards article { min-height: 330px; padding: clamp(2rem, 4vw, 4rem); border-left: 1px solid var(--crawl-ink); border-bottom: 1px solid var(--crawl-ink); }
  .firecrawl-now__cards article:nth-last-child(-n+2) { border-bottom: 0; }
  .firecrawl-now__cards span { font: 700 0.63rem/1.3 var(--crawl-mono); text-transform: uppercase; }
  .firecrawl-now__cards h3 { margin: 3rem 0 1rem; font-size: clamp(1.5rem, 2.3vw, 2.6rem); line-height: 1; letter-spacing: -0.05em; }
  .firecrawl-now__cards p { margin: 0; line-height: 1.55; }

  .crawl-install { background: var(--crawl-lime); }
  .crawl-install > div:first-child > p:last-child { max-width: 570px; font-size: 1.1rem; line-height: 1.55; }
  .crawl-install__terminal { align-self: start; border: 1px solid var(--crawl-ink); background: var(--crawl-ink); color: white; font-family: var(--crawl-mono); box-shadow: 9px 9px 0 var(--crawl-blue); }
  .terminal-head, .terminal-line { display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1rem; border-bottom: 1px solid rgba(255,255,255,.3); }
  .terminal-head { justify-content: space-between; font-size: 0.68rem; text-transform: uppercase; }
  .terminal-line span { color: var(--crawl-lime); font-size: 0.65rem; }
  .terminal-line code { flex: 1; overflow-wrap: anywhere; font: 0.78rem/1.45 var(--crawl-mono); }
  .terminal-line button { border: 1px solid rgba(255,255,255,.6); background: transparent; color: white; padding: 0.45rem 0.6rem; font: 0.6rem var(--crawl-mono); text-transform: uppercase; cursor: pointer; }
  .crawl-install__terminal > p { margin: 0; padding: 1.2rem; color: rgba(255,255,255,.72); font-size: 0.75rem; line-height: 1.6; }
  .terminal-links { display: flex; flex-wrap: wrap; gap: 0.7rem 1.2rem; padding: 0 1.2rem 1.2rem; font-size: 0.68rem; text-transform: uppercase; }

  .crawl-history, .crawl-compact, .crawl-sources { padding: clamp(5rem, 9vw, 10rem) max(2rem, calc((100vw - 1420px) / 2)); border-bottom: 1px solid var(--crawl-ink); }
  .history-line { margin: 0; padding: 0; border-top: 1px solid var(--crawl-ink); list-style: none; }
  .history-line li { display: grid; grid-template-columns: 60px 150px minmax(0, 1fr); gap: 1.2rem; padding: 2rem 0; border-bottom: 1px solid var(--crawl-line); }
  .history-line__number, .history-line time { font: 700 0.7rem/1.4 var(--crawl-mono); }
  .history-line h3 { margin: 0 0 0.7rem; font-size: clamp(1.5rem, 2.7vw, 3rem); line-height: 1; letter-spacing: -0.055em; }
  .history-line li > div > p:not(.history-line__sources) { max-width: 800px; margin: 0; font-size: 1rem; line-height: 1.55; }
  .history-line__sources { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1rem 0 0; }
  .history-line__sources a { padding: 0.3rem 0.45rem; border: 1px solid var(--crawl-ink); font: 0.6rem/1 var(--crawl-mono); text-decoration: none; text-transform: uppercase; }

  .index-essay { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--crawl-ink); }
  .index-essay__poster { display: flex; flex-direction: column; justify-content: center; min-height: 850px; padding: 4rem; background: var(--crawl-blue); color: var(--crawl-lime); border-right: 1px solid var(--crawl-ink); }
  .index-essay__poster span { font-size: clamp(4rem, 8vw, 9rem); font-weight: 850; line-height: 0.77; letter-spacing: -0.09em; }
  .index-essay__poster span:nth-child(2), .index-essay__poster span:nth-child(4) { color: var(--crawl-pink); }
  .index-essay__copy { padding: clamp(5rem, 9vw, 10rem) clamp(2rem, 6vw, 8rem); }
  .index-essay__copy > p:not(.section-number) { font-size: 1.1rem; line-height: 1.6; }
  .index-essay blockquote { margin: 3rem 0 0; padding: 2rem 0 0; border-top: 6px solid var(--crawl-ink); font-size: clamp(1.5rem, 2.8vw, 3rem); font-weight: 750; line-height: 1.05; letter-spacing: -0.05em; }

  .lens-board { display: grid; grid-template-columns: 280px minmax(0, 1fr); border: 1px solid white; }
  .lens-tabs { display: flex; flex-direction: column; border-right: 1px solid white; }
  .lens-tabs button { flex: 1; display: flex; gap: 0.8rem; align-items: center; min-height: 58px; padding: 0.8rem 1rem; border: 0; border-bottom: 1px solid rgba(255,255,255,.35); background: transparent; color: white; font: 700 0.74rem/1 var(--crawl-mono); text-align: left; text-transform: uppercase; cursor: pointer; }
  .lens-tabs button:last-child { border-bottom: 0; }
  .lens-tabs button span { color: rgba(255,255,255,.55); }
  .lens-tabs button[aria-selected='true'] { background: var(--crawl-lime); color: var(--crawl-ink); }
  .lens-tabs button[aria-selected='true'] span { color: var(--crawl-blue); }
  .lens-panels article { position: relative; min-height: 620px; padding: clamp(2rem, 6vw, 7rem); background: var(--crawl-paper); color: var(--crawl-ink); }
  .lens-panels__number { position: absolute; right: 2rem; top: 1rem; color: var(--crawl-pink); font-size: clamp(6rem, 17vw, 18rem); font-weight: 850; line-height: 1; letter-spacing: -0.1em; opacity: 0.9; }
  .lens-panels__name { position: relative; margin: 0 0 6rem; font: 700 0.7rem/1 var(--crawl-mono); text-transform: uppercase; }
  .lens-panels h3 { position: relative; max-width: 950px; margin: 0 0 2rem; font-size: clamp(2.6rem, 5vw, 6rem); line-height: 0.94; letter-spacing: -0.07em; }
  .lens-panels article > p:not(.lens-panels__name) { position: relative; max-width: 780px; font-size: 1.15rem; line-height: 1.55; }
  .lens-panels article > div { position: relative; max-width: 780px; margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--crawl-ink); background: var(--crawl-lime); }
  .lens-panels article > div span { font: 700 0.65rem/1 var(--crawl-mono); }
  .lens-panels article > div p { margin: 0.7rem 0 0; line-height: 1.5; }

  .crawl-robots { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: stretch; border-bottom: 1px solid var(--crawl-ink); }
  .crawl-robots__file { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: 700px; padding: clamp(2rem, 6vw, 7rem); border-right: 1px solid var(--crawl-ink); background: var(--crawl-lime); font-family: var(--crawl-mono); }
  .crawl-robots__file > div { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 4rem; padding-bottom: 1rem; border-bottom: 1px solid var(--crawl-ink); font-size: 0.68rem; text-transform: uppercase; }
  .crawl-robots__file code { padding: 0.8rem 0; font: clamp(0.8rem, 1.4vw, 1.15rem)/1.4 var(--crawl-mono); }
  .crawl-robots__stamp { position: absolute; right: 2rem; bottom: 2rem; padding: 1rem; border: 3px solid var(--crawl-blue); color: var(--crawl-blue); font-weight: 800; transform: rotate(-7deg); }
  .crawl-robots__copy { padding: clamp(5rem, 9vw, 10rem) clamp(2rem, 7vw, 9rem); }
  .crawl-robots__copy > p:not(.section-number) { max-width: 760px; font-size: 1.1rem; line-height: 1.6; }

  .crawl-compact ol { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; border-top: 1px solid var(--crawl-ink); border-left: 1px solid var(--crawl-ink); list-style: none; }
  .crawl-compact li { min-height: 290px; padding: 1.5rem; border-right: 1px solid var(--crawl-ink); border-bottom: 1px solid var(--crawl-ink); }
  .crawl-compact li span { font: 700 0.68rem/1 var(--crawl-mono); }
  .crawl-compact h3 { margin: 5rem 0 0.8rem; font-size: 1.45rem; line-height: 1; letter-spacing: -0.04em; }
  .crawl-compact li p { margin: 0; font-size: 0.9rem; line-height: 1.5; }
  .crawl-compact li:nth-child(2), .crawl-compact li:nth-child(7) { background: var(--crawl-pink); }
  .crawl-compact li:nth-child(4), .crawl-compact li:nth-child(5) { background: var(--crawl-lime); }

  .crawl-boundaries { background: var(--crawl-ink); color: white; }
  .crawl-boundaries__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; border: 1px solid rgba(255,255,255,.5); background: rgba(255,255,255,.5); }
  .crawl-boundaries__grid article { padding: 1.5rem; background: var(--crawl-ink); }
  .crawl-boundaries__grid span { color: var(--crawl-lime); font: 700 0.65rem/1 var(--crawl-mono); }
  .crawl-boundaries__grid p { margin: 1rem 0 0; color: rgba(255,255,255,.78); font-size: 0.88rem; line-height: 1.55; }

  .crawl-sources ol { margin: 0; padding: 0; border-top: 1px solid var(--crawl-ink); list-style: none; }
  .crawl-sources li { display: grid; grid-template-columns: 50px 180px minmax(220px, 1fr) minmax(260px, 1fr); gap: 1.2rem; align-items: start; padding: 1.2rem 0; border-bottom: 1px solid var(--crawl-line); font-size: 0.78rem; }
  .crawl-sources li > span { font-family: var(--crawl-mono); }
  .crawl-sources li strong, .crawl-sources li small { display: block; }
  .crawl-sources li small { margin-top: 0.3rem; color: rgba(17,16,13,.6); font: 0.6rem/1.3 var(--crawl-mono); text-transform: uppercase; }
  .crawl-sources li a { font-weight: 700; }
  .crawl-sources li p { margin: 0; line-height: 1.45; }

  .crawl-footer { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 5rem; padding: clamp(4rem, 8vw, 8rem) max(2rem, calc((100vw - 1420px) / 2)); background: var(--crawl-blue); color: white; }
  .crawl-footer span { color: var(--crawl-lime); font: 700 0.68rem/1 var(--crawl-mono); text-transform: uppercase; }
  .crawl-footer h2 { margin: 2rem 0 0; font-size: clamp(3rem, 6vw, 7rem); line-height: 0.88; letter-spacing: -0.075em; }
  .crawl-footer p { color: rgba(255,255,255,.72); line-height: 1.55; }
  .crawl-footer nav { display: flex; flex-direction: column; margin-top: 2rem; border-top: 1px solid rgba(255,255,255,.5); }
  .crawl-footer nav a { padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,.5); font: 0.7rem/1 var(--crawl-mono); text-decoration: none; text-transform: uppercase; }

  [hidden] { display: none !important; }
  @keyframes crawl-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  @media (max-width: 980px) {
    .crawl-nav { grid-template-columns: 1fr auto; padding: 0 1.2rem; }
    .crawl-nav__links { display: none; }
    .crawl-hero__flag span:last-child { display: none; }
    .crawl-hero__grid, .crawl-opening, .crawl-install, .crawl-boundaries, .firecrawl-now, .index-essay, .crawl-robots, .crawl-footer { grid-template-columns: 1fr; }
    .crawl-hero__map, .index-essay__poster, .crawl-robots__file { border-left: 0; border-right: 0; border-top: 1px solid var(--crawl-ink); }
    .section-head { grid-template-columns: 1fr; align-items: start; }
    .crawl-steps { grid-template-columns: repeat(4, 1fr); }
    .crawl-step { border-bottom: 1px solid rgba(255,255,255,.45); }
    .crawl-step > div { min-height: 220px; }
    .crawl-step:nth-child(4) { border-right: 0; }
    .lens-board { grid-template-columns: 210px minmax(0, 1fr); }
    .crawl-compact ol { grid-template-columns: 1fr 1fr; }
    .crawl-sources li { grid-template-columns: 40px 150px 1fr; }
    .crawl-sources li p { grid-column: 3; }
  }

  @media (max-width: 680px) {
    .crawl-nav { min-height: 50px; }
    .crawl-hero__flag { padding: 0.65rem 1rem; }
    .crawl-hero__flag span:nth-child(2) { text-align: right; }
    .crawl-hero__grid { min-height: 0; }
    .crawl-hero__copy { padding: 4.5rem 1.2rem 3.5rem; }
    .crawl-hero h1 { font-size: clamp(3.8rem, 18vw, 6rem); }
    .crawl-hero__dek { font-size: 1rem; }
    .crawl-hero__map { min-height: 430px; }
    .crawl-thesis { padding: 1rem; text-align: left; }
    .crawl-opening, .crawl-install, .crawl-boundaries, .crawl-machine, .crawl-lenses, .crawl-history, .crawl-compact, .crawl-sources { padding: 4.5rem 1.2rem; gap: 2.5rem; }
    .crawl-opening h2, .crawl-install h2, .crawl-boundaries h2, .firecrawl-now h2, .section-head h2, .index-essay h2, .crawl-robots h2 { font-size: clamp(3.2rem, 15vw, 5rem); }
    .crawl-console__bar span:first-child { display: none; }
    .crawl-console__url { align-items: flex-start; flex-wrap: wrap; }
    .crawl-console__url strong { flex-basis: 100%; order: 3; }
    .crawl-steps { grid-template-columns: 1fr; }
