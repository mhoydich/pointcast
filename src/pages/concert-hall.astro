---
import BlockLayout from '../layouts/BlockLayout.astro';
import { ACOUSTIC_DESIGN, ANTI_DISNEY_HALL, CONCERT_MASTER_ROLE, CURATORIAL_COUNCIL, FUNDING_CALENDAR, FUNDING_TIMELINE, MECHANICAL_SYSTEMS, PAPER_META, PAPER_NOTES, PHILOSOPHICAL_NOTES, PROGRAM, REFERENCES, STRUCTURE_AND_MATERIAL, TCAC_PARTNERSHIP_MOU, THREE_FIFTY_FOUNDING_AUDIENCE } from '../lib/concertHallPaper';
const title = `${PAPER_META.title} — ${PAPER_META.subtitle}`;
const description = PAPER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': 'https://pointcast.xyz/concert-hall', name: PAPER_META.title, description, url: 'https://pointcast.xyz/concert-hall', datePublished: PAPER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' }, keywords: PAPER_META.keywords };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/concert-hall.json', title: 'The Concert Hall (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/giant-works-art">giant-works-art</a><span aria-hidden="true">/</span><span>concert-hall</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{PAPER_META.paperNumber} · WORKING PAPER · TIER D · AUDIO · $26M TOTAL · 2029 Q2 OPEN</p>
      <h1>THE / CONCERT / HALL.</h1>
      <p class="subtitle">{PAPER_META.subtitle}</p>
      <p class="thesis">{PAPER_META.thesis}</p>
      <p class="byline">By {PAPER_META.authors.map((a) => a.name).join(', ')} · {PAPER_META.date}</p>
    </header>

    <section class="anti"><p class="kicker">THE ANTI-DISNEY-HALL POSITION · 5 CONTRASTS</p><h2>{ANTI_DISNEY_HALL.title}</h2>
      <p class="lede">{ANTI_DISNEY_HALL.description}</p>
      <ol class="anti-list">{ANTI_DISNEY_HALL.fivePoints.map((p) => (
        <li>
          <h3>{p.contrast}</h3>
          <div class="anti-grid">
            <div class="anti-cell anti-cell--disney"><span class="anti-tag">DISNEY HALL</span><p>{p.disneyHall}</p></div>
            <div class="anti-cell anti-cell--ours"><span class="anti-tag">CONCERT HALL</span><p>{p.concertHall}</p></div>
          </div>
          <p class="anti-why"><strong>Why:</strong> {p.why}</p>
        </li>
      ))}</ol>
      <p class="block"><strong>What this is not:</strong> {ANTI_DISNEY_HALL.whatThisIsNot}</p>
    </section>

    <section class="program"><p class="kicker">PROGRAM · {PROGRAM.totalArea}</p><h2>What gets built.</h2>
      <dl class="meta-dl">
        <div><dt>Total area</dt><dd>{PROGRAM.totalArea}</dd></div>
        <div><dt>Occupancy max</dt><dd>{PROGRAM.occupancyMax}</dd></div>
        <div><dt>Operating hours</dt><dd>{PROGRAM.operatingHours}</dd></div>
        <div><dt>Programmed area</dt><dd>{PROGRAM.totalProgrammedArea}</dd></div>
      </dl>
      <h3 class="sh">Spaces · {PROGRAM.spaces.length}</h3>
      <ol class="sp-list">{PROGRAM.spaces.map((s) => (
        <li>
          <h4>{s.name} <span class="sp__meta">{s.area} · {s.capacity}</span></h4>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="struct"><p class="kicker">STRUCTURE + MATERIAL</p><h2>How it is built to last 100 years.</h2>
      <dl class="dl">
        <div><dt>Primary structure</dt><dd>{STRUCTURE_AND_MATERIAL.primaryStructure}</dd></div>
        <div><dt>Primary stone</dt><dd>{STRUCTURE_AND_MATERIAL.primaryStone}</dd></div>
        <div><dt>Secondary stone</dt><dd>{STRUCTURE_AND_MATERIAL.secondaryStone}</dd></div>
        <div><dt>Woods</dt><dd>{STRUCTURE_AND_MATERIAL.woods}</dd></div>
        <div><dt>Metals</dt><dd>{STRUCTURE_AND_MATERIAL.metals}</dd></div>
        <div><dt>Glazing</dt><dd>{STRUCTURE_AND_MATERIAL.glazing}</dd></div>
        <div><dt>Acoustic treatment</dt><dd>{STRUCTURE_AND_MATERIAL.acousticTreatment}</dd></div>
      </dl>
    </section>

    <section class="mech"><p class="kicker">MECHANICAL SYSTEMS</p><h2>How it runs.</h2>
      <dl class="dl">
        <div><dt>HVAC</dt><dd>{MECHANICAL_SYSTEMS.hvac}</dd></div>
        <div><dt>Electrical</dt><dd>{MECHANICAL_SYSTEMS.electrical}</dd></div>
        <div><dt>Plumbing</dt><dd>{MECHANICAL_SYSTEMS.plumbing}</dd></div>
        <div><dt>Lighting</dt><dd>{MECHANICAL_SYSTEMS.lighting}</dd></div>
        <div><dt>Fire protection</dt><dd>{MECHANICAL_SYSTEMS.fireProtection}</dd></div>
        <div><dt>Variable absorption</dt><dd>{MECHANICAL_SYSTEMS.acousticAbsorptionSwitching}</dd></div>
      </dl>
    </section>

    <section class="acoustic"><p class="kicker">ACOUSTIC DESIGN · NC-15 · RT60 1.4-2.0s VARIABLE</p><h2>How it sounds.</h2>
      <p class="block"><strong>Philosophy:</strong> {ACOUSTIC_DESIGN.philosophy}</p>
      <p class="block"><strong>RT60 targets:</strong> {ACOUSTIC_DESIGN.rt60Targets}</p>
      <p class="block"><strong>Treatment:</strong> {ACOUSTIC_DESIGN.treatment}</p>
      <p class="block"><strong>Isolation:</strong> {ACOUSTIC_DESIGN.isolation}</p>
      <p class="block"><strong>Recording:</strong> {ACOUSTIC_DESIGN.recording}</p>
    </section>

    <section class="fund"><p class="kicker">FUNDING CALENDAR · {FUNDING_CALENDAR.total}</p><h2>How it is paid for.</h2>
      <p class="block warn"><strong>NOT LA28:</strong> {FUNDING_CALENDAR.notLa28}</p>
      <ol class="src-list">{FUNDING_CALENDAR.sourceMix.map((s) => (
        <li>
          <h4>{s.source} <span class="src__amt">{s.amount}</span></h4>
          <p class="src__when"><strong>Timing:</strong> {s.timing}</p>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
      <h3 class="sh">Stretch targets</h3>
      <ol class="src-list src-list--stretch">{FUNDING_CALENDAR.stretchTargets.map((s) => (
        <li>
          <h4>{s.item} <span class="src__amt">{s.amount}</span></h4>
          <p>{s.notes}</p>
        </li>
      ))}</ol>
    </section>

    <section class="tl"><p class="kicker">TIMELINE · 2027 Q1 → 2029 Q3+</p><h2>The path to opening.</h2>
      <ol class="tl-list">{FUNDING_TIMELINE.map((t) => (
        <li>
          <span class="tl__q">{t.quarter}</span>
          <p>{t.milestone}</p>
        </li>
      ))}</ol>
    </section>

    <section class="mou"><p class="kicker">TCAC PARTNERSHIP MOU · 75-YEAR GROUND LEASE</p><h2>How the federation and Torrance share the land.</h2>
      <p class="block"><strong>Tenor:</strong> {TCAC_PARTNERSHIP_MOU.tenor}</p>
      <h3 class="sh">Key terms · {TCAC_PARTNERSHIP_MOU.keyTerms.length}</h3>
      <ol class="terms-list">{TCAC_PARTNERSHIP_MOU.keyTerms.map((t) => (<li>{t}</li>))}</ol>
    </section>

    <section class="role"><p class="kicker">CONCERT MASTER · ROLE SPEC</p><h2>Who runs the building day-to-day.</h2>
      <dl class="dl">
        <div><dt>Type</dt><dd>{CONCERT_MASTER_ROLE.type}</dd></div>
        <div><dt>Reports to</dt><dd>{CONCERT_MASTER_ROLE.reportsTo}</dd></div>
        <div><dt>Compensation</dt><dd>Base: {CONCERT_MASTER_ROLE.compensation.base}. Sabbatical: {CONCERT_MASTER_ROLE.compensation.sabbatical}. Pension: {CONCERT_MASTER_ROLE.compensation.pension}.</dd></div>
        <div><dt>Termination</dt><dd>{CONCERT_MASTER_ROLE.termination}</dd></div>
      </dl>
      <h3 class="sh">Primary duties · {CONCERT_MASTER_ROLE.primaryDuties.length}</h3>
      <ul class="dt-list">{CONCERT_MASTER_ROLE.primaryDuties.map((d) => (<li>{d}</li>))}</ul>
      <h3 class="sh">Qualifications · {CONCERT_MASTER_ROLE.qualifications.length}</h3>
      <ul class="dt-list">{CONCERT_MASTER_ROLE.qualifications.map((q) => (<li>{q}</li>))}</ul>
    </section>

    <section class="cc"><p class="kicker">CURATORIAL COUNCIL · 5 PRACTITIONERS</p><h2>Who programs the season.</h2>
      <p class="block"><strong>Composition:</strong> {CURATORIAL_COUNCIL.composition}</p>
      <p class="block"><strong>Selection:</strong> {CURATORIAL_COUNCIL.selection}</p>
      <p class="block"><strong>Term length:</strong> {CURATORIAL_COUNCIL.termLength}</p>
      <p class="block"><strong>Decision rule:</strong> {CURATORIAL_COUNCIL.decisionRule}</p>
      <h3 class="sh">Duties · {CURATORIAL_COUNCIL.duties.length}</h3>
      <ul class="dt-list">{CURATORIAL_COUNCIL.duties.map((d) => (<li>{d}</li>))}</ul>
    </section>

    <section class="founders"><p class="kicker">350 FOUNDING AUDIENCE · CAMPAIGN</p><h2>The structural-financial community.</h2>
      <p class="block"><strong>Thesis:</strong> {THREE_FIFTY_FOUNDING_AUDIENCE.thesis}</p>
      <p class="block"><strong>Who they are:</strong> {THREE_FIFTY_FOUNDING_AUDIENCE.whoTheyAre}</p>
      <p class="block"><strong>Campaign:</strong> {THREE_FIFTY_FOUNDING_AUDIENCE.campaign}</p>
      <h3 class="sh">Rights · {THREE_FIFTY_FOUNDING_AUDIENCE.rights.length}</h3>
      <ul class="dt-list">{THREE_FIFTY_FOUNDING_AUDIENCE.rights.map((r) => (<li>{r}</li>))}</ul>
      <h3 class="sh">Obligations · {THREE_FIFTY_FOUNDING_AUDIENCE.obligations.length}</h3>
      <ul class="dt-list">{THREE_FIFTY_FOUNDING_AUDIENCE.obligations.map((o) => (<li>{o}</li>))}</ul>
    </section>

    <section class="phil"><p class="kicker">PHILOSOPHICAL NOTES</p><h2>Why this, why here, why this way.</h2>
      <p class="block"><strong>Why concert hall not concert venue:</strong> {PHILOSOPHICAL_NOTES.whyConcertHallNotConcertVenue}</p>
      <p class="block"><strong>Why chamber music and not orchestra:</strong> {PHILOSOPHICAL_NOTES.whyChamberMusicAndNotOrchestra}</p>
      <p class="block"><strong>Why every concert recorded:</strong> {PHILOSOPHICAL_NOTES.whyEveryConcertRecorded}</p>
      <p class="block"><strong>Why Tuesday-Sunday not Friday-Sunday:</strong> {PHILOSOPHICAL_NOTES.whyTuesdayThroughSundayNotFridayThroughSunday}</p>
      <p class="block"><strong>Why no LA28:</strong> {PHILOSOPHICAL_NOTES.whyNoLA28}</p>
      <p class="block"><strong>Why Torrance and not MB:</strong> {PHILOSOPHICAL_NOTES.whyTorranceAndNotMB}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · ARCHITECTS · FOUNDATIONS · CONCERT MASTER · COUNCIL · FOUNDERS</p>
      <p>{PAPER_NOTES.uesNote}</p>
      <p class="invite-cta">{PAPER_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/giant-works-art">Giant Works · Art</a>
      <a href="/bath-house">Bath House · UES-WP-2026-14</a>
      <a href="/federation-council">Federation Council Charter</a>
      <a href="/la28-ready">LA28 Forcing Function</a>
      <a href="/torrance">Torrance (host site)</a>
      <a href="/concert-hall.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --ch-ink:#1a1a1a; --ch-paper:#fdf9ee; --ch-mustard:#d4a534; --ch-rust:#b85a3a; --ch-sage:#2d6a3d; --ch-audio:#b85a3a; --ch-fog:#d8d2c4; --ch-slate:#5a5450; }
  .paper { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--ch-paper); color: var(--ch-ink); font-family: Georgia, 'Times New Roman', serif; }
  .paper > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--ch-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--ch-audio); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ch-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--ch-audio); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 84px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 21px; font-weight: 500; margin: 0 0 14px; max-width: 64ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0 0 12px; }
  .byline { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-slate); margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--ch-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3.sh { font-family: var(--pc-font-mono); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-audio); margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--ch-audio); }
  h4 { font-family: var(--pc-font-mono); font-size: 13.5px; margin: 0 0 6px; font-weight: 700; }

  .lede { font-size: 15.5px; line-height: 1.65; margin: 0 0 16px; max-width: 72ch; font-family: Georgia, serif; }
  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 10px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--ch-audio); max-width: 72ch; font-family: Georgia, serif; }
  .block.warn { border-left-color: var(--ch-rust); border-left-width: 6px; background: linear-gradient(90deg, #fff5f0, #fff); font-weight: 500; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-audio); margin-right: 6px; }

  .anti-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .anti-list li { padding: 14px; background: #fff; border: 2px solid var(--ch-ink); border-left: 8px solid var(--ch-audio); }
  .anti-list h3 { font-family: var(--pc-font-mono); font-size: 16px; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--ch-audio); }
  .anti-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }
  .anti-cell { padding: 10px 12px; background: var(--ch-paper); }
  .anti-cell--disney { border-left: 4px solid var(--ch-fog); }
  .anti-cell--ours { border-left: 4px solid var(--ch-sage); }
  .anti-tag { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; color: var(--ch-slate); display: block; margin-bottom: 4px; }
  .anti-cell--ours .anti-tag { color: var(--ch-sage); }
  .anti-cell p { margin: 0; font-size: 13px; line-height: 1.55; font-family: Georgia, serif; }
  .anti-why { padding: 8px 12px; background: var(--ch-paper); border-left: 4px solid var(--ch-audio); font-size: 13px; line-height: 1.55; font-family: Georgia, serif; margin: 0; }
  .anti-why strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-audio); margin-right: 4px; }

  .meta-dl, .dl { margin: 0 0 12px; display: grid; gap: 6px; }
  .meta-dl > div, .dl > div { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--ch-ink); border-left: 5px solid var(--ch-audio); }
  .meta-dl dt, .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-audio); padding-top: 2px; }
  .meta-dl dd, .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .sp-list, .src-list, .tl-list, .terms-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .sp-list li, .src-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--ch-ink); border-left: 6px solid var(--ch-audio); }
  .sp__meta, .src__amt { font-family: var(--pc-font-mono); font-size: 10.5px; letter-spacing: .1em; color: var(--ch-rust); margin-left: 8px; font-weight: 500; }
  .sp-list p, .src-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .src__when { padding: 6px 10px; background: var(--ch-paper); border-left: 3px solid var(--ch-mustard); margin: 6px 0 !important; font-size: 12.5px !important; }
  .src__when strong, .src-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ch-audio); margin-right: 4px; }
  .src-list--stretch li { border-left-color: var(--ch-fog); }

  .tl-list li { display: grid; grid-template-columns: 110px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--ch-ink); border-left: 5px solid var(--ch-audio); align-items: baseline; }
  .tl__q { font-family: var(--pc-font-mono); font-size: 11.5px; font-weight: 700; color: var(--ch-audio); letter-spacing: .1em; }
  .tl-list p { margin: 0; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }

  .terms-list { list-style: decimal; padding-left: 22px; }
  .terms-list li { padding: 6px 0; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; border: none; background: none; }

  .dt-list { list-style: square; padding-left: 22px; margin: 0 0 12px; font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }
  .dt-list li { padding: 3px 0; }

  .invitation { background: var(--ch-audio); color: var(--ch-paper); border-top-color: var(--ch-audio); }
  .invitation .kicker { background: var(--ch-mustard); color: var(--ch-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--ch-mustard); color: var(--ch-ink); border-left: 4px solid var(--ch-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--ch-audio); color: var(--ch-paper); text-decoration: none; }
  .links a:hover { background: var(--ch-rust); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .meta-dl > div, .dl > div { grid-template-columns: 1fr; } .anti-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .tl-list li { grid-template-columns: 1fr; } }
</style>
