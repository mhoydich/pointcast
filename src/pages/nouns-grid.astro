---
/**
 * /nouns-grid — 144 Nouns in a 12×12 grid.
 *
 * Mike: "go 5 more." Fourth of five.
 *
 * A 12×12 grid (144 cells) of random Nouns on dark velvet. Click any
 * cell to "spotlight" it: scale up briefly, soft chime, the Noun's
 * id appears in a chip. REFRESH re-rolls all 144 cells. Hypnotic
 * gallery feel.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Grid · 144 Nouns · PointCast';
const description =
  '144 Nouns in a 12×12 grid. Click any to spotlight. REFRESH to re-roll.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Grid',
  url: 'https://pointcast.xyz/nouns-grid',
  description,
  applicationCategory: 'VisualArts',
};

const CELLS = 144; // 12x12
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="ng" id="ng-main">
    <DrumNav current="grid" />

    <header class="ng__header">
      <div class="ng__chrome">
        <span>GRID</span>
        <span class="ng__chrome-sep">·</span>
        <span>144 NOUNS · 12 × 12</span>
        <span class="ng__chrome-sep">·</span>
        <span id="ng-spotlight">— —</span>
      </div>
      <h1 class="ng__title">GRID</h1>
      <p class="ng__tagline">click any noun to spotlight · refresh to re-roll</p>
    </header>

    <section class="ng__grid" id="ng-grid">
      {Array.from({ length: CELLS }, (_, i) => i).map((i) => (
        <button class="ng__cell" type="button" data-idx={i} aria-label={`Cell ${i + 1}`}>
          <img class="ng__cell-noun" alt="" data-cell-noun loading="lazy" />
        </button>
      ))}
    </section>

    <footer class="ng__controls">
      <button class="ng__btn ng__btn--primary" id="ng-refresh" type="button">REFRESH 144</button>
      <div class="ng__counter">
        <span class="ng__counter-label">SPOTLIGHTS</span>
        <span class="ng__counter-value" id="ng-count">0</span>
      </div>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  body:has(#ng-main) { background: #0c0410; }
  .ng {
    --ng-velvet: #1a0820;
    --ng-velvet-deep: #0c0410;
    --ng-brass: #d4a437;
    --ng-brass-deep: #6b4d12;
    --ng-flame: #f6c15e;
    --ng-ink-light: #f4e7c8;
    --ng-ink-mid: #c9b78c;
    --ng-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--ng-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.08), transparent 55%),
      linear-gradient(180deg, var(--ng-velvet) 0%, var(--ng-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .ng .drum-nav { opacity: 0.40; transform: scale(0.9); transform-origin: top left; margin-bottom: clamp(6px, 0.8vh, 14px); }

  .ng__header { text-align: center; padding: clamp(8px, 1vh, 18px) 0 clamp(20px, 3vh, 32px); }
  .ng__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--ng-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ng-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .ng__chrome-sep { color: var(--ng-brass-deep); }
  #ng-spotlight { color: var(--ng-flame); font-weight: 700; }

  .ng__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(34px, 5.5vw, 76px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--ng-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--ng-velvet-deep);
  }
  .ng__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--ng-ink-mid);
  }

  .ng__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    max-width: 1080px;
    margin: 0 auto;
    background: rgba(212, 164, 55, 0.15);
    padding: 2px;
    border: 1.5px solid var(--ng-brass-deep);
  }
  @media (max-width: 720px) {
    .ng__grid { grid-template-columns: repeat(8, 1fr); }
  }

  .ng__cell {
    appearance: none;
    border: 0;
    cursor: pointer;
    aspect-ratio: 1;
    background: var(--ng-velvet-deep);
    padding: 0;
    overflow: hidden;
    transition: transform 200ms, box-shadow 200ms;
  }
  .ng__cell:hover {
    transform: scale(1.08);
    box-shadow: 0 0 16px rgba(212, 164, 55, 0.40);
    z-index: 2;
    position: relative;
  }
  .ng__cell.ng__cell--lit {
    transform: scale(1.4);
    box-shadow: 0 0 32px rgba(246, 193, 94, 0.65), 0 6px 16px rgba(0, 0, 0, 0.6);
    z-index: 3;
    position: relative;
  }
  .ng__cell-noun {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    display: block;
  }

  .ng__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2vw, 24px);
    flex-wrap: wrap;
    padding: clamp(20px, 3vh, 32px) 0 0;
  }
  .ng__btn {
    appearance: none; border: 0; cursor: pointer;
    padding: 12px 28px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 13px; font-weight: 800; letter-spacing: 0.22em;
    color: var(--ng-velvet-deep);
    background: linear-gradient(180deg, var(--ng-brass) 0%, oklch(0.62 0.18 60) 100%);
    box-shadow: 0 0 0 2px var(--ng-velvet-deep), 0 4px 0 0 var(--ng-brass-deep), 0 4px 16px rgba(212, 164, 55, 0.30);
    transition: transform 80ms, box-shadow 80ms, background 120ms;
  }
  .ng__btn:hover { background: linear-gradient(180deg, #efbb46 0%, var(--ng-brass) 100%); }
  .ng__btn:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 2px var(--ng-velvet-deep), 0 1px 0 0 var(--ng-brass-deep), 0 0 18px rgba(246, 193, 94, 0.55);
  }
  .ng__counter {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 16px;
    border: 1px solid var(--ng-brass-deep);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.3);
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  }
  .ng__counter-label { color: var(--ng-ink-dim); }
  .ng__counter-value { color: var(--ng-flame); font-weight: 700; }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  // Pick a soft pentatonic chime per cell — pitch derived from index
  const NOTES = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50, 1174.66, 1318.51];
  function playSpot(idx) {
    const a = ctx(); const t = a.currentTime;
    const f = NOTES[idx % NOTES.length];
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = f;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 2.76;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.20, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.07, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
    o.connect(g).connect(a.destination); o2.connect(g2).connect(a.destination);
    o.start(t); o.stop(t + 1.5); o2.start(t); o2.stop(t + 1.0);
  }

  const cellEls = Array.from(document.querySelectorAll('.ng__cell'));
  const refreshBtn = document.getElementById('ng-refresh');
  const spotlightEl = document.getElementById('ng-spotlight');
  const countEl = document.getElementById('ng-count');
  let spotlightCount = 0;
  const cellNouns = new Array(cellEls.length).fill(0);

  function refresh() {
    cellEls.forEach((el, i) => {
      const n = Math.floor(Math.random() * 1200);
      cellNouns[i] = n;
      const img = el.querySelector('[data-cell-noun]');
      if (img) img.src = `https://noun.pics/${n}.svg`;
      el.classList.remove('ng__cell--lit');
    });
    if (spotlightEl) spotlightEl.textContent = '— —';
  }

  function pad4(n) { return String(n).padStart(4, '0'); }

  cellEls.forEach((el, i) => {
    el.addEventListener('click', () => {
      cellEls.forEach((e) => e.classList.remove('ng__cell--lit'));
      el.classList.add('ng__cell--lit');
      try { playSpot(i); } catch {}
      const n = cellNouns[i];
      if (spotlightEl) spotlightEl.textContent = `NOUN ${pad4(n)}`;
      spotlightCount += 1;
      if (countEl) countEl.textContent = String(spotlightCount);
      // Auto-dim the spotlight after 2s
      setTimeout(() => el.classList.remove('ng__cell--lit'), 2000);
    });
  });

  refreshBtn?.addEventListener('click', refresh);
  refresh();
</script>
