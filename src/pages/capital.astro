---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Capital';
const description =
  'A small living diagram of the human, code, attention, place, ritual, time, and CC0 capital already compounding inside PointCast.';
---

<BaseLayout title={title} description={description}>
  <main class="capital-room" data-capital-room>
    <section class="room-shell" aria-labelledby="capital-title">
      <div class="room-top">
        <p class="kicker">POINTCAST ROOM / CAPITAL</p>
        <h1 id="capital-title">the broadcast is learning to compound</h1>
        <p class="lede">
          Not a balance sheet. A small map of the resources already moving through
          the porch, the codebase, the wire, and the daily rituals.
        </p>
      </div>

      <div class="diagram-wrap">
        <svg
          class="capital-diagram"
          viewBox="0 0 1000 720"
          role="img"
          aria-labelledby="diagram-title diagram-desc"
          data-capital-svg
        >
          <title id="diagram-title">PointCast capital diagram</title>
          <desc id="diagram-desc">
            Seven kinds of non-financial capital arranged as a living mesh:
            human, code, attention, IP and CC0, place, ritual, and time.
          </desc>

          <defs>
            <filter id="soft-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow
                dx="0"
                dy="10"
                stdDeviation="12"
                flood-color="#2f2418"
                flood-opacity="0.16"
              />
            </filter>

            <filter id="paper-noise" x="0" y="0" width="100%" height="100%">
              <feTurbulence
                type="fractalNoise"
                baseFrequency="0.8"
                numOctaves="3"
                stitchTiles="stitch"
              />
              <feColorMatrix type="saturate" values="0" />
              <feComponentTransfer>
                <feFuncA type="table" tableValues="0 0.08" />
              </feComponentTransfer>
            </filter>

            <marker
              id="edge-arrow"
              markerWidth="10"
              markerHeight="10"
              refX="8"
              refY="5"
              orient="auto"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#9c4f2d" />
            </marker>

            <linearGradient id="center-warmth" x1="0%" x2="100%" y1="0%" y2="100%">
              <stop offset="0%" stop-color="#fff4d8" />
              <stop offset="58%" stop-color="#f2c977" />
              <stop offset="100%" stop-color="#d66d3f" />
            </linearGradient>
          </defs>

          <rect width="1000" height="720" rx="34" class="paper" />
          <rect width="1000" height="720" rx="34" class="paper-grain" />

          <g class="horizon" aria-hidden="true">
            <path
              d="M82 584 C220 555 316 610 454 575 C590 540 715 552 918 520"
              class="coastline"
            />
            <path
              d="M88 620 C224 596 356 632 498 602 C640 573 748 594 918 558"
              class="coastline coastline-soft"
            />
            <rect x="64" y="118" width="92" height="206" rx="10" class="refinery-stack" />
            <rect x="176" y="174" width="62" height="150" rx="8" class="refinery-stack thin" />
            <path d="M48 324 H280" class="refinery-line" />
            <path d="M90 124 C105 94 138 92 150 58" class="steam" />
            <path d="M194 174 C214 142 244 146 252 112" class="steam soft" />
          </g>

          <g class="edges" data-edge-layer>
            <path
              class="edge"
              data-from="code"
              data-to="attention"
              d="M500 360 C590 240 672 168 774 138"
            />
            <path
              class="edge"
              data-from="attention"
              data-to="ritual"
              d="M808 190 C855 306 837 414 768 522"
            />
            <path
              class="edge"
              data-from="ritual"
              data-to="time"
              d="M708 568 C596 642 466 648 326 594"
            />
            <path
              class="edge"
              data-from="time"
              data-to="place"
              d="M238 544 C146 438 142 300 220 184"
            />
            <path
              class="edge"
              data-from="place"
              data-to="human"
              d="M286 138 C392 72 528 68 652 132"
            />
            <path
              class="edge"
              data-from="human"
              data-to="code"
              d="M682 194 C638 252 584 306 500 360"
            />
            <path
              class="edge secondary"
              data-from="ip"
              data-to="attention"
              d="M366 474 C520 430 670 320 776 184"
            />
            <path
              class="edge secondary"
              data-from="code"
              data-to="ip"
              d="M472 392 C430 422 392 446 342 474"
            />
            <path
              class="edge secondary"
              data-from="place"
              data-to="ritual"
              d="M284 174 C456 214 630 340 728 514"
            />
            <path
              class="edge secondary"
              data-from="time"
              data-to="code"
              d="M286 548 C340 472 402 412 500 360"
            />
          </g>

          <g class="center-machine" filter="url(#soft-shadow)">
            <circle cx="500" cy="360" r="92" class="center-orbit outer" />
            <circle cx="500" cy="360" r="70" class="center-orbit middle" />
            <circle cx="500" cy="360" r="48" class="center-fill" />
            <text x="500" y="344" text-anchor="middle" class="center-label">
              slow
            </text>
            <text x="500" y="370" text-anchor="middle" class="center-label">
              compounding
            </text>
            <text x="500" y="395" text-anchor="middle" class="center-label small">
              machine
            </text>
          </g>

          <g
            class="node"
            data-node="human"
            data-title="Human"
            data-detail="Mike and the active AI residents keep turning the porch lights on, with two chairs still open for the next useful helpers."
            tabindex="0"
            role="button"
            aria-label="Human capital"
            transform="translate(684 164)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Human</text>
            <text y="18" text-anchor="middle" class="node-count">1 + 4 + 2</text>
            <text y="39" text-anchor="middle" class="node-note">residents</text>
          </g>

          <g
            class="node"
            data-node="code"
            data-title="Code"
            data-detail="The codebase is the loom: many routes, many commits, and a habit of turning stray ideas into rooms."
            tabindex="0"
            role="button"
            aria-label="Code capital"
            transform="translate(500 360)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Code</text>
            <text y="18" text-anchor="middle" class="node-count">routes</text>
            <text y="39" text-anchor="middle" class="node-note">keep arriving</text>
          </g>

          <g
            class="node"
            data-node="attention"
            data-title="Attention"
            data-detail="Attention shows up as return visits, the wire ticker, and people noticing that the site keeps breathing."
            tabindex="0"
            role="button"
            aria-label="Attention capital"
            transform="translate(802 164)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Attention</text>
            <text y="18" text-anchor="middle" class="node-count">wire</text>
            <text y="39" text-anchor="middle" class="node-note">repeat glances</text>
          </g>

          <g
            class="node"
            data-node="ip"
            data-title="IP / CC0"
            data-detail="Visit Nouns, pending mugs, Prize Cast, and queued tokens make a small public seed bank instead of a locked cabinet."
            tabindex="0"
            role="button"
            aria-label="IP and CC0 capital"
            transform="translate(320 494)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">IP / CC0</text>
            <text y="18" text-anchor="middle" class="node-count">0-1199</text>
            <text y="39" text-anchor="middle" class="node-note">open seeds</text>
          </g>

          <g
            class="node"
            data-node="place"
            data-title="Place"
            data-detail="El Segundo, the porch, the weather window, and the local mesh give the broadcast a real address."
            tabindex="0"
            role="button"
            aria-label="Place capital"
            transform="translate(246 164)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Place</text>
            <text y="18" text-anchor="middle" class="node-count">El Segundo</text>
            <text y="39" text-anchor="middle" class="node-note">porch signal</text>
          </g>

          <g
            class="node"
            data-node="ritual"
            data-title="Ritual"
            data-detail="The daily race, coffee count, weather check, and wire make a rhythm people can find again tomorrow."
            tabindex="0"
            role="button"
            aria-label="Ritual capital"
            transform="translate(742 556)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Ritual</text>
            <text y="18" text-anchor="middle" class="node-count">daily</text>
            <text y="39" text-anchor="middle" class="node-note">race + coffee</text>
          </g>

          <g
            class="node"
            data-node="time"
            data-title="Time"
            data-detail="Time is slow on purpose here: garden cadence, unhurried rooms, and the kettle still on."
            tabindex="0"
            role="button"
            aria-label="Time capital"
            transform="translate(248 556)"
          >
            <circle r="66" class="node-ring" />
            <circle r="52" class="node-fill" />
            <text y="-10" text-anchor="middle" class="node-title">Time</text>
            <text y="18" text-anchor="middle" class="node-count">slow</text>
            <text y="39" text-anchor="middle" class="node-note">kettle on</text>
          </g>

          <g class="porch-witness" aria-hidden="true" transform="translate(812 470)">
            <path d="M-42 116 H118" class="rail" />
            <path d="M-18 116 V58" class="post" />
            <path d="M82 116 V48" class="post" />
            <foreignObject x="-6" y="-4" width="96" height="96">
              <img
                xmlns="http://www.w3.org/1999/xhtml"
                class="noun-guide"
                src="https://noun.pics/415"
                alt=""
                loading="lazy"
              />
            </foreignObject>
            <path
              d="M18 96 C38 82 62 82 82 96"
              class="witness-shadow"
            />
          </g>

          <g class="legend" aria-hidden="true">
            <text x="76" y="662" class="legend-text">hover or tap a node</text>
            <circle cx="252" cy="656" r="5" class="legend-dot warm" />
            <text x="266" y="662" class="legend-text">reinforces</text>
            <circle cx="372" cy="656" r="5" class="legend-dot ocean" />
            <text x="386" y="662" class="legend-text">returns tomorrow</text>
          </g>
        </svg>

        <aside class="capital-card" data-tooltip aria-live="polite">
          <p class="tooltip-kicker">capital type</p>
          <h2 data-tooltip-title>Code</h2>
          <p data-tooltip-detail>
            The codebase is the loom: many routes, many commits, and a habit of
            turning stray ideas into rooms.
          </p>
        </aside>
      </div>

      <section class="room-notes" aria-label="Capital notes">
        <div>
          <p class="note-label">reading</p>
          <p>
            The arrows do not measure extraction. They mark where one practice
            feeds another and comes back warmer.
          </p>
        </div>
        <div>
          <p class="note-label">pace</p>
          <p>
            Slow is a resource here: enough time for rooms, drops, visits, and
            local observations to become recognizable.
          </p>
        </div>
        <div>
          <p class="note-label">mood</p>
          <p>
            A porch witness, a refinery line, a little ocean air, and no quarterly
            chart pretending to know the future.
          </p>
        </div>
      </section>
    </section>
  </main>

  <script>
    const room = document.querySelector('[data-capital-room]');
    const svg = document.querySelector('[data-capital-svg]');
    const tooltip = document.querySelector('[data-tooltip]');
    const tooltipTitle = document.querySelector('[data-tooltip-title]');
    const tooltipDetail = document.querySelector('[data-tooltip-detail]');
    const nodes = Array.from(document.querySelectorAll('[data-node]'));
    const edges = Array.from(document.querySelectorAll('[data-from][data-to]'));

    const desktopPositions = {
      human: { x: 684, y: 164 },
      code: { x: 500, y: 360 },
      attention: { x: 802, y: 164 },
      ip: { x: 320, y: 494 },
      place: { x: 246, y: 164 },
      ritual: { x: 742, y: 556 },
      time: { x: 248, y: 556 }
    };

    const mobilePositions = {
      human: { x: 500, y: 116 },
      code: { x: 500, y: 328 },
      attention: { x: 742, y: 244 },
      ip: { x: 258, y: 414 },
      place: { x: 258, y: 244 },
      ritual: { x: 742, y: 414 },
      time: { x: 500, y: 580 }
    };

    function curvePath(from, to, index, compact) {
      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const mx = from.x + dx * 0.5;
      const my = from.y + dy * 0.5;
      const bend = compact ? 0.16 : 0.22;
      const sign = index % 2 === 0 ? 1 : -1;
      const cx = mx - dy * bend * sign;
      const cy = my + dx * bend * sign;

      return `M${from.x} ${from.y} Q${cx} ${cy} ${to.x} ${to.y}`;
    }

    function applyLayout() {
      const compact = window.matchMedia('(max-width: 720px)').matches;
      const positions = compact ? mobilePositions : desktopPositions;

      nodes.forEach((node) => {
        const key = node.dataset.node;
        const position = positions[key];

        if (position) {
          node.setAttribute('transform', `translate(${position.x} ${position.y})`);
        }
      });

      edges.forEach((edge, index) => {
        const from = positions[edge.dataset.from];
        const to = positions[edge.dataset.to];

        if (from && to) {
          edge.setAttribute('d', curvePath(from, to, index, compact));
        }
      });

      if (svg) {
        svg.setAttribute('viewBox', compact ? '0 0 1000 780' : '0 0 1000 720');
      }
    }

    function setActive(node) {
      const key = node.dataset.node;
      const title = node.dataset.title;
      const detail = node.dataset.detail;

      nodes.forEach((item) => {
        item.classList.toggle('is-active', item === node);
      });

      edges.forEach((edge) => {
        const connected = edge.dataset.from === key || edge.dataset.to === key;
        edge.classList.toggle('is-active', connected);
        edge.classList.toggle('is-muted', !connected);
      });

      if (tooltipTitle && title) {
        tooltipTitle.textContent = title;
      }

      if (tooltipDetail && detail) {
        tooltipDetail.textContent = detail;
      }

      if (tooltip) {
        tooltip.dataset.active = key;
      }
    }

    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => setActive(node));
      node.addEventListener('focus', () => setActive(node));
      node.addEventListener('click', () => setActive(node));
      node.addEventListener('touchstart', () => setActive(node), { passive: true });
    });

    room?.addEventListener('mouseleave', () => {
      edges.forEach((edge) => {
        edge.classList.remove('is-active');
        edge.classList.remove('is-muted');
      });
    });

    applyLayout();
    window.addEventListener('resize', applyLayout);

    const firstNode = nodes.find((node) => node.dataset.node === 'code');
    if (firstNode) {
      setActive(firstNode);
    }
  </script>

  <style>
    :global(html) {
      background: #f3dfb8;
    }

    :global(body) {
      margin: 0;
      color: #251d16;
      background:
        radial-gradient(circle at 16% 12%, rgba(255, 247, 220, 0.9), transparent 30rem),
        radial-gradient(circle at 86% 18%, rgba(77, 129, 145, 0.18), transparent 26rem),
        linear-gradient(180deg, #f7e8c8 0%, #efd09d 54%, #d8a46f 100%);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    .capital-room {
      min-height: 100vh;
      padding: clamp(18px, 4vw, 48px);
      overflow: hidden;
    }

    .room-shell {
      width: min(1180px, 100%);
      margin: 0 auto;
    }

    .room-top {
      display: grid;
      gap: 12px;
      max-width: 760px;
      margin-bottom: clamp(22px, 4vw, 38px);
    }

    .kicker,
    .tooltip-kicker,
    .note-label {
      margin: 0;
      font-family:
        "Departure Mono",
        "IBM Plex Mono",
        ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #855235;
    }

    h1 {
      max-width: 760px;
      margin: 0;
      font-family:
        "Departure Mono",
        "IBM Plex Mono",
        ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
      font-size: clamp(36px, 7vw, 82px);
      line-height: 0.95;
      letter-spacing: 0;
      color: #201711;
      text-wrap: balance;
    }

    .lede {
      max-width: 620px;
      margin: 0;
      color: #46372b;
      font-size: clamp(17px, 2vw, 22px);
      line-height: 1.45;
    }

    .diagram-wrap {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 18px;
      align-items: stretch;
    }

    .capital-diagram {
      width: 100%;
      min-height: 560px;
      border: 1px solid rgba(62, 43, 28, 0.18);
      border-radius: 34px;
      box-shadow:
        0 28px 70px rgba(67, 43, 24, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
      background: #f5dfb4;
    }

    .paper {
      fill: #f4dfb8;
    }

    .paper-grain {
      fill: #3f2c1d;
      filter: url("#paper-noise");
      opacity: 0.6;
      pointer-events: none;
    }

    .horizon {
      opacity: 0.8;
    }

    .coastline {
      fill: none;
      stroke: #4f8590;
      stroke-width: 5;
      stroke-linecap: round;
      opacity: 0.42;
    }

    .coastline-soft {
      stroke: #d77748;
      stroke-width: 3;
      opacity: 0.28;
    }

    .refinery-stack {
      fill: rgba(156, 79, 45, 0.13);
      stroke: rgba(86, 54, 35, 0.24);
      stroke-width: 2;
    }

    .refinery-stack.thin {
      fill: rgba(79, 133, 144, 0.12);
    }

    .refinery-line {
      fill: none;
      stroke: rgba(86, 54, 35, 0.26);
      stroke-width: 3;
      stroke-linecap: round;
    }

    .steam {
      fill: none;
      stroke: rgba(79, 133, 144, 0.42);
      stroke-width: 4;
      stroke-linecap: round;
    }

    .steam.soft {
      stroke: rgba(156, 79, 45, 0.26);
    }

    .edge {
      fill: none;
      stroke: #9c4f2d;
      stroke-width: 4;
      stroke-linecap: round;
      opacity: 0.56;
      marker-end: url("#edge-arrow");
      transition:
        opacity 180ms ease,
        stroke-width 180ms ease,
        stroke 180ms ease;
    }

    .edge.secondary {
      stroke: #4f8590;
      stroke-width: 3;
      opacity: 0.38;
    }

    .edge.is-active {
      opacity: 0.95;
      stroke-width: 6;
    }

    .edge.secondary.is-active {
      stroke-width: 5;
    }

    .edge.is-muted {
      opacity: 0.12;
    }

    .center-machine {
      pointer-events: none;
    }

    .center-orbit {
      fill: none;
      stroke-linecap: round;
      transform-origin: 500px 360px;
    }

    .center-orbit.outer {
      stroke: rgba(79, 133, 144, 0.34);
      stroke-width: 4;
      stroke-dasharray: 10 13;
      animation: orbit 18s linear infinite;
    }

    .center-orbit.middle {
      stroke: rgba(156, 79, 45, 0.38);
      stroke-width: 5;
      stroke-dasharray: 4 12;
      animation: orbit 14s linear infinite reverse;
    }

    .center-fill {
      fill: url("#center-warmth");
      stroke: rgba(44, 31, 21, 0.35);
      stroke-width: 2;
    }

    .center-label {
      font-family:
        "Departure Mono",
        "IBM Plex Mono",
        ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
      font-size: 17px;
      fill: #241811;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .center-label.small {
      font-size: 12px;
      fill: rgba(36, 24, 17, 0.74);
    }

    .node {
      cursor: pointer;
      outline: none;
    }

    .node-ring {
      fill: rgba(255, 247, 220, 0.56);
      stroke: rgba(36, 25, 17, 0.22);
      stroke-width: 2;
      filter: url("#soft-shadow");
      transition:
        transform 180ms ease,
        fill 180ms ease,
        stroke 180ms ease;
    }

    .node-fill {
      fill: #fff0c9;
      stroke: rgba(156, 79, 45, 0.36);
      stroke-width: 2;
      transition:
        fill 180ms ease,
        stroke 180ms ease;
    }

    .node-title,
    .node-count,
    .node-note {
      pointer-events: none;
      font-family:
        "Departure Mono",
        "IBM Plex Mono",
        ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
      text-rendering: geometricPrecision;
      letter-spacing: 0;
    }

    .node-title {
      font-size: 17px;
      fill: #251911;
    }

    .node-count {
      font-size: 16px;
      fill: #855235;
    }

    .node-note {
      font-size: 11px;
      fill: rgba(37, 25, 17, 0.72);
    }

    .node:hover .node-ring,
    .node:focus-visible .node-ring,
    .node.is-active .node-ring {
      fill: rgba(255, 250, 232, 0.86);
      stroke: rgba(79, 133, 144, 0.68);
      transform: scale(1.05);
    }

    .node:hover .node-fill,
    .node:focus-visible .node-fill,
    .node.is-active .node-fill {
      fill: #fff7db;
      stroke: rgba(156, 79, 45, 0.72);
    }

    .porch-witness {
      opacity: 0.98;
    }

    .rail,
    .post {
      fill: none;
      stroke: rgba(57, 37, 24, 0.58);
      stroke-width: 8;
      stroke-linecap: round;
    }

    .post {
      stroke-width: 7;
    }

    .noun-guide {
      width: 96px;
      height: 96px;
      image-rendering: pixelated;
      filter: drop-shadow(0 12px 14px rgba(47, 36, 24, 0.24));
    }

    .witness-shadow {
      fill: none;
      stroke: rgba(47, 36, 24, 0.2);
      stroke-width: 10;
      stroke-linecap: round;
    }

    .legend-text {
      font-family:
        "Departure Mono",
        "IBM Plex Mono",
        ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
      font-size: 13px;
      fill: rgba(37, 25, 17, 0.62);
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .legend-dot.warm {
      fill: #9c4f2d;
    }

