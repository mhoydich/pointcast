---
/**
 * /nouns-nation-sports-reenactment/goal - interactive Mission Control for
 * packaging a typed sports result into a watchable Nouns reenactment product.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';

const goals = [
  {
    id: 'watch',
    label: 'Watch',
    title: 'Make one result understandable in 30 seconds.',
    copy: 'Turn a score into a field, show the shape, explain the setup, and let the Nouns battle carry the energy.',
    proof: 'Viewer can say the source result, field shape, and why this match feels like the game.',
    noun: 12,
  },
  {
    id: 'share',
    label: 'Share',
    title: 'Create one copyable alt-broadcast artifact.',
    copy: 'Package the result as a short receipt, invite, sponsor read, poster prompt, or group-chat recap.',
    proof: 'One person can paste the artifact without editing out official-data, betting, prediction, or payout claims.',
    noun: 33,
  },
  {
    id: 'agent',
    label: 'Agent',
    title: 'Give a visiting agent a useful job.',
    copy: 'Ask an agent to write headlines, proof notes, poster ideas, and watch copy from the generated kit.',
    proof: 'The agent output has source result, shape, guardrail, and one concrete next action.',
    noun: 48,
  },
  {
    id: 'sponsor',
    label: 'Sponsor',
    title: 'Frame a no-money-yet sponsor package.',
    copy: 'Route the reenactment into a reservation-only media package: field naming, read, clip, poster, or bounty.',
    proof: 'The package says reservation intent only and requires human acceptance before any credit routing.',
    noun: 56,
  },
];

const shapes = [
  { id: 'close', label: 'Close', field: 'Windy kingdom rush', modifier: 'small survivor gap and late-lane gust' },
  { id: 'comeback', label: 'Comeback', field: 'Garden comeback field', modifier: 'morale dip, then scheduled surge' },
  { id: 'blowout', label: 'Blowout', field: 'Lava lane rout', modifier: 'formation advantage and hot-lane pressure' },
  { id: 'upset', label: 'Upset', field: 'Auction floor upset', modifier: 'belief spike and faster special clock' },
  { id: 'overtime', label: 'Overtime', field: 'Rift overtime field', modifier: 'sudden-death pressure and high damage' },
];

const sampleResults = [
  { label: 'NBA close', league: 'NBA', winner: 'Celtics', loser: 'Knicks', score: '112-109', shape: 'close', goal: 'watch' },
  { label: 'WNBA comeback', league: 'WNBA', winner: 'Aces', loser: 'Liberty', score: '88-84', shape: 'comeback', goal: 'share' },
  { label: 'NFL overtime', league: 'NFL', winner: 'Chiefs', loser: 'Ravens', score: '27-24', shape: 'overtime', goal: 'watch' },
  { label: 'MLB blowout', league: 'MLB', winner: 'Dodgers', loser: 'Padres', score: '11-3', shape: 'blowout', goal: 'sponsor' },
  { label: 'EPL upset', league: 'EPL', winner: 'Brighton', loser: 'Arsenal', score: '2-1', shape: 'upset', goal: 'agent' },
  { label: 'NHL late swing', league: 'NHL', winner: 'Kings', loser: 'Oilers', score: '4-3', shape: 'comeback', goal: 'share' },
];

const agentLanes = [
  {
    label: 'Claude Code lane',
    task: 'Inspect route/link/build health and propose one fix before publish.',
    output: 'ROUTE REVIEW: checked URLs, one issue or none, one recommended fix.',
  },
  {
    label: 'Creative agent lane',
    task: 'Generate headline, poster concept, clip caption, and watch CTA.',
    output: 'CREATIVE DROP: headline, caption, visual prompt, CTA.',
  },
  {
    label: 'Sponsor agent lane',
    task: 'Generate a reservation-only sponsor read with proof and human approval language.',
    output: 'SPONSOR READ: surface, line, proof, guardrail.',
  },
  {
    label: 'QA agent lane',
    task: 'Check guardrails, URLs, no official/betting claims, and mobile clarity.',
    output: 'QA GUARDRAIL: pass/fail, exact text risk, top fix.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Nouns Sports Reenactment Mission Control',
  description:
    'A goal-oriented control room for turning a sports result into a Nouns Nation Battler reenactment, share artifact, and agent task pack.',
  url: 'https://pointcast.xyz/nouns-nation-sports-reenactment/goal/',
  step: [
    'Pick a goal.',
    'Choose a result shape.',
    'Confirm or type the source result.',
    'Copy the generated host, agent, share, and proof artifacts.',
    'Launch the Battle Desk reenactment and keep the guardrail visible.',
  ].map((name, index) => ({ '@type': 'HowToStep', position: index + 1, name })),
};
---

<BlockLayout
  title="Sports Reenactment Mission Control"
  description="A goal-first control room for turning one sports result into a watchable Nouns reenactment, copyable artifact, and parallel agent task pack."
  image="/images/og/nouns-battler-live.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-battler.json', title: 'Nouns Nation Battler manifest' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Mission Control', action: 'link', target: 'https://pointcast.xyz/nouns-nation-sports-reenactment/goal/' },
      { label: 'Reenactment', action: 'link', target: 'https://pointcast.xyz/nouns-nation-sports-reenactment/' },
      { label: 'Battle Desk', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler/' },
      { label: 'Mobile Cast', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-mobile/' },
    ],
  }}
>
  <main class="mission-room" data-mission-control>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation-sports-reenactment/">Sports Reenactment</a>
      <span aria-hidden="true">/</span>
      <span>Mission Control</span>
    </nav>

    <section class="hero" aria-labelledby="mission-title">
      <div class="hero__copy">
        <p class="kicker">CH.BTL / MISSION CONTROL</p>
        <h1 id="mission-title">Choose the job before the battle starts.</h1>
        <p>
          Pick a goal, pick a result shape, and leave with the host read, agent handoff,
          share receipt, proof checklist, and launch link. This stays local-first and
          informational: no official feed, no odds, no betting, no forced outcome. The launch now
          drives inspired-by reenactment choreography on the live Nouns field.
        </p>
        <div class="hero-actions">
          <a class="primary" data-mission-launch href="/nouns-nation-battler/#mode=desk&reenact=close">Launch Battle Desk</a>
          <a href="/nouns-nation-sports-reenactment/">Reenactment Site</a>
        </div>
      </div>
      <aside aria-label="Generated mission summary">
        <span data-mission-field="goalLabel">Watch</span>
        <strong data-mission-field="headline">Celtics 112, Knicks 109 becomes a Windy kingdom rush mission.</strong>
        <p data-mission-field="summary">Host a close-finish Nouns reenactment and help viewers understand the game shape in 30 seconds.</p>
      </aside>
    </section>

    <section class="control-panel" aria-labelledby="control-title">
      <div class="section-head">
        <p class="kicker">Control Panel</p>
        <h2 id="control-title">Tune the reenactment package.</h2>
      </div>
      <div class="controls">
        <fieldset>
          <legend>Goal</legend>
          <div class="button-grid">
            {goals.map((goal, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-goal-option={goal.id}
                data-label={goal.label}
                data-title={goal.title}
                data-copy={goal.copy}
                data-proof={goal.proof}
              >
                <span>{goal.label}</span>
                <strong>{goal.title}</strong>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="sample-slate">
          <legend>Sample Slate</legend>
          <div class="sample-grid">
            {sampleResults.map((sample, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-mission-sample={index}
                data-league={sample.league}
                data-winner={sample.winner}
                data-loser={sample.loser}
                data-score={sample.score}
                data-shape={sample.shape}
                data-goal={sample.goal}
              >
                <span>{sample.label}</span>
                <strong>{sample.winner} {sample.score}</strong>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>Shape</legend>
          <div class="button-grid button-grid--shape">
            {shapes.map((shape, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-shape-option={shape.id}
                data-label={shape.label}
                data-field={shape.field}
                data-modifier={shape.modifier}
              >
                <span>{shape.label}</span>
                <strong>{shape.field}</strong>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="result-fields">
          <legend>Source Result</legend>
          <label>League <input data-result-league value="NBA" /></label>
          <label>Winner <input data-result-winner value="Celtics" /></label>
          <label>Loser <input data-result-loser value="Knicks" /></label>
          <label>Score <input data-result-score value="112-109" /></label>
        </fieldset>
      </div>
    </section>

    <section class="artifacts" aria-labelledby="artifacts-title">
      <div class="section-head">
        <p class="kicker">Generated Package</p>
        <h2 id="artifacts-title">Copy the exact artifact for the next agent or human.</h2>
      </div>
      <div class="artifact-grid">
        <article>
          <span>Host Rundown</span>
          <textarea data-artifact="host" readonly></textarea>
          <button type="button" data-copy-artifact="host">Copy host</button>
        </article>
        <article>
          <span>Agent Task</span>
          <textarea data-artifact="agent" readonly></textarea>
          <button type="button" data-copy-artifact="agent">Copy agent</button>
        </article>
        <article>
          <span>Share Receipt</span>
          <textarea data-artifact="share" readonly></textarea>
          <button type="button" data-copy-artifact="share">Copy receipt</button>
        </article>
        <article>
          <span>Proof Checklist</span>
          <textarea data-artifact="proof" readonly></textarea>
          <button type="button" data-copy-artifact="proof">Copy proof</button>
        </article>
        <article class="artifact-grid__wide">
          <span>Live Run Sheet</span>
          <textarea data-artifact="runsheet" readonly></textarea>
          <button type="button" data-copy-artifact="runsheet">Copy run sheet</button>
        </article>
      </div>
    </section>

    <section class="parallel" aria-labelledby="parallel-title">
      <div class="section-head">
        <p class="kicker">Parallel Agent Initiative</p>
        <h2 id="parallel-title">Four lanes for Claude Code and visiting agents.</h2>
      </div>
      <div class="lane-grid">
        {agentLanes.map((lane) => (
          <article>
            <strong>{lane.label}</strong>
            <p>{lane.task}</p>
            <em>{lane.output}</em>
          </article>
        ))}
      </div>
    </section>

    <section class="guardrails" aria-labelledby="guardrails-title">
      <div>
        <p class="kicker">Guardrails</p>
        <h2 id="guardrails-title">Weird sports, clean claims.</h2>
      </div>
      <ul>
        <li>User-entered result only; no live sports API claim.</li>
        <li>Informational Nouns reenactment, not official replay; visual beats are inspired-by choreography.</li>
        <li>No odds, betting, investment, payout, prediction, or forced outcome language.</li>
        <li>Human approval is required before sponsor or participant-credit routing.</li>
      </ul>
    </section>
  </main>

  <script>
    const room = document.querySelector('[data-mission-control]');
    const guardrail = 'Guardrail: informational Nouns reenactment, not official replay, odds, betting, prediction, payout, or forced outcome.';
    const state = {
      goal: 'watch',
      goalLabel: 'Watch',
      goalTitle: 'Make one result understandable in 30 seconds.',
      goalCopy: 'Turn a score into a field, show the shape, explain the setup, and let the Nouns battle carry the energy.',
      goalProof: 'Viewer can say the source result, field shape, and why this match feels like the game.',
      shape: 'close',
      shapeLabel: 'Close',
      field: 'Windy kingdom rush',
      modifier: 'small survivor gap and late-lane gust',
    };

    function readResult() {
      return {
        league: room.querySelector('[data-result-league]')?.value.trim() || 'NBA',
        winner: room.querySelector('[data-result-winner]')?.value.trim() || 'Celtics',
        loser: room.querySelector('[data-result-loser]')?.value.trim() || 'Knicks',
        score: room.querySelector('[data-result-score]')?.value.trim() || '112-109',
      };
    }

    function renderMission() {
      const result = readResult();
      const resultLine = `${result.league}: ${result.winner} ${result.score} over ${result.loser}`;
      const launch = `/nouns-nation-battler/#mode=desk&reenact=${state.shape}`;
      const launchUrl = new URL(launch, window.location.origin).href;
      const visualBeat = {
        close: 'windy late gust and near-even lane squeeze',
        comeback: 'pinned opening pressure into a scheduled belief surge',
        blowout: 'hot rout arrows and winner lane pressure',
        upset: 'auction-floor belief spike with faster special clock',
        overtime: 'sudden-death rift spotlight and tighter replay cadence',
      }[state.shape] || 'inspired-by reenactment choreography';
      const host = `HOST RUNDOWN
Open: ${resultLine} becomes ${state.field}.
Goal: ${state.goalLabel} - ${state.goalTitle}
Field read: ${state.shapeLabel} shape with ${state.modifier}.
Visual beat: ${visualBeat}.
Callout 1: Explain how the result pressure maps into the Nouns field.
Callout 2: Watch for numbered Nouns, gang momentum, and banner context.
Signoff: This is an interpretive alt-broadcast setup, not an official replay.
${guardrail}
Launch: ${launchUrl}`;
      const agent = `AGENT TASK: ${state.goalLabel} Sports Reenactment
Source result: ${resultLine}
Shape: ${state.shape}
Field: ${state.field}
Objective: ${state.goalCopy}
Visual beat: ${visualBeat}.
Deliver: one headline, one short receipt, one poster or clip idea, three proof notes, and one next action.
Proof target: ${state.goalProof}
${guardrail}`;
      const share = `NOUNS ALT-CAST RECEIPT
${resultLine}
Mission: ${state.goalLabel}
Field: ${state.field}
Modifier: ${state.modifier}
Visual beat: ${visualBeat}
Watch: ${launchUrl}
${guardrail}`;
      const proof = `PROOF CHECKLIST
[ ] Source result is visible: ${resultLine}
[ ] Shape is visible: ${state.shape}
[ ] Field is visible: ${state.field}
[ ] Visual beat is visible: ${visualBeat}
[ ] Artifact says informational, not official replay.
[ ] Artifact avoids odds, betting, prediction, payout, and forced outcome language.
[ ] Human approval is required for sponsor or participant-credit routing.`;
      const runsheet = `LIVE RUN SHEET
00:00 Cold open - ${resultLine} as ${state.field}.
00:20 Guardrail - user-entered result, interpretive Nouns setup, no official replay.
00:40 Field read - ${state.shapeLabel}: ${state.modifier}.
00:55 Visual beat - ${visualBeat}.
01:10 Nouns focus - name two numbered players, one gang, and the first pressure swing.
02:00 Agent lane - ask for headline, poster concept, sponsor-safe read, or QA note.
03:00 Share beat - copy the receipt and send viewers to ${launchUrl}
04:00 Proof check - confirm source result, shape, field, guardrail, and human approval path.
Close - The battle is inspired by the result; the sim outcome is not forced.`;

      room.querySelector('[data-mission-field="goalLabel"]').textContent = state.goalLabel;
      room.querySelector('[data-mission-field="headline"]').textContent =
        `${result.winner} ${result.score} over ${result.loser} becomes a ${state.field} mission.`;
      room.querySelector('[data-mission-field="summary"]').textContent =
        `${state.goalCopy} Field modifier: ${state.modifier}.`;
      room.querySelector('[data-mission-launch]').href = launch;
      room.querySelector('[data-artifact="host"]').value = host;
      room.querySelector('[data-artifact="agent"]').value = agent;
      room.querySelector('[data-artifact="share"]').value = share;
      room.querySelector('[data-artifact="proof"]').value = proof;
      room.querySelector('[data-artifact="runsheet"]').value = runsheet;
    }

    function setGoal(goalId) {
      const button = room.querySelector(`[data-goal-option="${goalId}"]`);
      if (!button) return;
      room.querySelectorAll('[data-goal-option]').forEach((item) => item.classList.toggle('is-active', item === button));
      state.goal = button.dataset.goalOption || 'watch';
      state.goalLabel = button.dataset.label || 'Watch';
      state.goalTitle = button.dataset.title || state.goalTitle;
      state.goalCopy = button.dataset.copy || state.goalCopy;
      state.goalProof = button.dataset.proof || state.goalProof;
    }

    function setShape(shapeId) {
      const button = room.querySelector(`[data-shape-option="${shapeId}"]`);
      if (!button) return;
      room.querySelectorAll('[data-shape-option]').forEach((item) => item.classList.toggle('is-active', item === button));
      state.shape = button.dataset.shapeOption || 'close';
      state.shapeLabel = button.dataset.label || 'Close';
      state.field = button.dataset.field || state.field;
      state.modifier = button.dataset.modifier || state.modifier;
    }

    room.querySelectorAll('[data-goal-option]').forEach((button) => {
      button.addEventListener('click', () => {
        setGoal(button.dataset.goalOption || 'watch');
        renderMission();
      });
    });

    room.querySelectorAll('[data-shape-option]').forEach((button) => {
      button.addEventListener('click', () => {
        setShape(button.dataset.shapeOption || 'close');
        renderMission();
      });
    });

    room.querySelectorAll('[data-mission-sample]').forEach((button) => {
      button.addEventListener('click', () => {
        room.querySelectorAll('[data-mission-sample]').forEach((item) => item.classList.toggle('is-active', item === button));
        room.querySelector('[data-result-league]').value = button.dataset.league || 'NBA';
        room.querySelector('[data-result-winner]').value = button.dataset.winner || 'Celtics';
        room.querySelector('[data-result-loser]').value = button.dataset.loser || 'Knicks';
        room.querySelector('[data-result-score]').value = button.dataset.score || '112-109';
        setGoal(button.dataset.goal || 'watch');
        setShape(button.dataset.shape || 'close');
        renderMission();
      });
    });

    room.querySelectorAll('.result-fields input').forEach((input) => input.addEventListener('input', renderMission));
    room.querySelectorAll('[data-copy-artifact]').forEach((button) => {
      button.addEventListener('click', async () => {
        const target = room.querySelector(`[data-artifact="${button.dataset.copyArtifact}"]`);
        try {
          await navigator.clipboard.writeText(target.value);
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = original;
          }, 1400);
        } catch {
          target.focus();
          target.select();
        }
      });
    });
    renderMission();
  </script>
</BlockLayout>

<style>
  .mission-room {
    --ink: #141414;
    --paper: #fffdf5;
    --muted: #5f5e5a;
    --line: rgba(20, 20, 20, 0.16);
    display: grid;
    gap: 18px;
    color: var(--ink);
  }

  .crumb,
  .kicker,
  legend,
  .hero aside span,
  .button-grid span,
  .artifact-grid span,
  .lane-grid em {
    font-family: var(--pc-font-mono, ui-monospace, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.75rem;
  }

  .crumb a {
    color: inherit;
  }

  .hero,
  .control-panel,
  .artifacts,
  .parallel,
  .guardrails {
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 18px;
    padding: clamp(18px, 4vw, 42px);
    background:
      linear-gradient(135deg, rgba(215, 255, 63, 0.26), transparent 34%),
      linear-gradient(315deg, rgba(138, 36, 50, 0.14), transparent 44%),
      var(--paper);
  }

  .control-panel,
  .artifacts,
  .parallel,
  .guardrails {
    padding: clamp(16px, 3vw, 28px);
  }

  .kicker {
    margin: 0 0 8px;
    color: #8a2432;
    font-size: 0.72rem;
    font-weight: 900;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 840px;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.86;
    letter-spacing: 0;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .hero__copy,
  .hero aside,
  .section-head,
  .lane-grid article,
  .artifact-grid article {
    display: grid;
    gap: 10px;
  }

  .hero p,
  .lane-grid p,
  .guardrails li {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .hero-actions a,
  .artifact-grid button {
    border: 2px solid var(--ink);
    background: #fff;
    color: var(--ink);
    padding: 9px 12px;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
  }

  .hero-actions a.primary {
    background: #d7ff3f;
  }

  .hero aside {
    align-content: end;
    border: 3px solid var(--ink);
    background:
      url('/games/nouns-nation-battler/assets/noun-56.svg') center 24px / 170px 170px no-repeat,
      #15171d;
    min-height: 320px;
    color: #fffdf5;
    padding: 16px;
  }

  .hero aside span,
  .lane-grid em {
    color: #d7ff3f;
    font-size: 0.68rem;
    font-style: normal;
  }

  .hero aside strong {
    font-size: clamp(1.35rem, 3vw, 2.35rem);
    line-height: 0.95;
  }

  .controls,
  .artifact-grid,
  .lane-grid {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .controls {
    grid-template-columns: minmax(0, 1fr);
  }

  fieldset {
    min-width: 0;
    border: 1px solid var(--line);
    background: #fff;
    margin: 0;
    padding: 14px;
  }

  legend {
    color: #8a2432;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .button-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .button-grid--shape {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .button-grid button {
    min-width: 0;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    display: grid;
    gap: 6px;
    padding: 12px;
    text-align: left;
    font: inherit;
  }

  .button-grid button.is-active {
    background: #d7ff3f;
    box-shadow: inset 5px 0 0 #8a2432;
  }

  .button-grid span,
  .artifact-grid span {
    color: #8a2432;
    font-size: 0.66rem;
  }

  .button-grid strong,
  .lane-grid strong {
    font-size: 1rem;
    line-height: 1.05;
  }

  .result-fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .sample-slate {
    grid-row: span 2;
  }

  .sample-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .sample-grid button {
    min-width: 0;
    border: 1px solid var(--line);
    background: #fff;
