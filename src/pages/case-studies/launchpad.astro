---
/**
 * /case-studies/launchpad — a simulated bonding-curve coin launchpad (stage A
 * of docs/plans/2026-10-19-launchpad-case-study.md). Exhibits are computed at
 * build time from src/lib/launchpad; the live board runs the same code in the
 * browser. Play credits only: nothing leaves the page. The layout runs
 * isolated (no beacon, wallet bridge, cursor room or freshness widget) and
 * stays out of search until the case-06 entry ships.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { exhibits, curveFacts, curvePoints, rulesTable, strategyTable, POLICY_CHECKS, CASE_PATH, PLAN_DOC, SOURCES, AUTHOR } from '../../lib/launchpad/exhibits.mjs';
import { configHash, CREDIT_LINE, NOUNS_LINE } from '../../lib/launchpad/config.mjs';
import '../../styles/launchpad.css';
import '../../styles/launchpad/screener.css';
import '../../styles/launchpad/coin.css';
import '../../styles/launchpad/create.css';
import '../../styles/launchpad/portfolio.css';
import '../../styles/launchpad/console.css';
import '../../styles/launchpad/creator.css';

const facts = curveFacts();
const points = curvePoints();
const runs = exhibits();
const rules = rulesTable();
const strategies = strategyTable();
const n = (x: number, d = 2) => x.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const int = (x: number) => x.toLocaleString('en-US');

// Chart: price against credits raised, with market cap dashed on the same scale.
const CW = 560, CH = 270, PAD = { l: 68, r: 16, t: 14, b: 44 };
const chartBox = [0, 0, CW, CH].join(' ');
const maxRaised = points.at(-1)!.raised;
const maxPrice = points.at(-1)!.price;
const xOf = (raised: number) => PAD.l + (raised / maxRaised) * (CW - PAD.l - PAD.r);
const yOf = (price: number) => CH - PAD.b - (price / maxPrice) * (CH - PAD.t - PAD.b);
const pricePath = points.map((p, i) => `${i ? 'L' : 'M'}${xOf(p.raised).toFixed(1)} ${yOf(p.price).toFixed(1)}`).join('');
const xTicks = [0, 2000, 4000, 6000, 8000];
const chartTitle = `Price rises ${facts.priceRise} times as the curve takes in ${n(facts.raiseToGraduate)} credits, from a starting market cap of ${n(facts.startMarketCap)} to ${n(facts.endMarketCap)} at graduation.`;
const tablePoints = points.filter((_, i) => i % 6 === 0);

const runVerdict = (run: (typeof runs)[number]) => {
  const nk = run.naked.coins[0], fr = run.fair.coins[0];
  if (run.id === 'snipe-war') return `Snipers held ${nk.sniperShareFirstMinute}% of the coins bought in the first minute under naked rules, and ${fr.sniperShareFirstMinute}% under fair rules.`;
  if (run.id === 'dev-dump') return `Naked rules: ${nk.risk.flags.join(' and ') || 'no flags'}. Fair rules: ${fr.risk.flags.join(', ') || 'no flags'} — the creator lock refused the sale and the opening auction capped the bundle.`;
  if (run.id === 'graduation-run') return `${nk.symbol} graduated at tick ${nk.graduatedAtTick} into a pool with its liquidity tokens burned, then kept trading there.`;
  return `Nothing graduated: ${n(nk.creditsRaised)} credits came in and the risk score stayed ${nk.risk.badge}.`;
};

const title = 'Case study: a simulated coin launchpad';
const description = 'A deterministic, in-browser simulation of a bonding-curve coin launchpad run on play credits: the curve, four launch rules, sniper and bundle defenses, bots under policy limits, and four replayable runs. No value, may reset.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: `https://pointcast.xyz${CASE_PATH}`,
  datePublished: '2026-10-19',
  dateModified: '2026-10-19',
  author: { '@type': 'Organization', name: AUTHOR },
  publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz/' },
  isAccessibleForFree: true,
};
---
<BlockLayout title={title} description={description} jsonLd={jsonLd} hideAds isolated includeManifest={false} noindex author={AUTHOR} creator={AUTHOR} alternates={[{ type: 'application/json', href: '/case-studies/launchpad.json', title: 'Launchpad case study · machine edition' }]}>
  <article class="lp" data-launchpad-copy>
    <div class="lp-wrap">
      <nav class="lp-crumb" aria-label="Breadcrumb">
        <a href="/">PointCast</a><span aria-hidden="true">/</span>
        <span>case studies</span><span aria-hidden="true">/</span>
        <span>launchpad</span>
      </nav>

      <header class="lp-hero">
        <p class="lp-kicker">Case study · launchpad · simulation</p>
        <h1>A coin launchpad, simulated</h1>
        <p class="lp-dek">Bonding-curve launchpads let anyone start a coin in one step. A curve sets every price, and when the curve sells out the coin graduates into a pool whose liquidity can never be pulled. This case study rebuilds that design as a deterministic simulation run on play credits, then asks which launch rules hold up against sniper bots, bundled wallets and a creator who sells everything.</p>
        <p class="lp-standing">{CREDIT_LINE}</p>
        <div class="lp-stats">
          <div><strong>{runs.length}</strong><span>replayable runs</span></div>
          <div><strong>{rules.length}</strong><span>launch rules</span></div>
          <div><strong>{strategies.length}</strong><span>bot strategies</span></div>
          <div><strong>{POLICY_CHECKS.length}</strong><span>policy checks</span></div>
        </div>
        <div class="lp-coins">
          {runs.map((run) => (
            <figure>
              <img src={run.coins[0].image} width="360" height="420" alt={`${run.coins[0].name} (${run.coins[0].symbol}), the simulated coin from “${run.title}”, showing actual Noun #${run.coins[0].nounId}`} />
              <figcaption>{run.title}</figcaption>
            </figure>
          ))}
        </div>
      </header>

      <section class="lp-section" aria-labelledby="curve-title">
        <h2 id="curve-title">The curve</h2>
        <p>Each coin starts with virtual liquidity on both sides of a constant-product curve, so the product of the two sides never falls. Buying adds credits and takes coins out; selling does the reverse. The numbers copy the published curve constants of the best-known Solana launchpad (see Sources), with the credit side scaled up so it reads in whole play credits. Coin percentages are unchanged.</p>
        <div class="lp-two">
          <figure class="lp-card" style="margin:0">
            <svg class="lp-chart" viewBox={chartBox} role="img" aria-labelledby="curve-chart-title">
              <title id="curve-chart-title">{chartTitle}</title>
              <path class="axis" d={`M${PAD.l} ${PAD.t}V${CH - PAD.b}H${CW - PAD.r}`} fill="none" />
              {xTicks.map((t) => <g><path class="axis" d={`M${xOf(t)} ${CH - PAD.b}v5`} /><text x={xOf(t)} y={CH - PAD.b + 17} text-anchor="middle">{int(t)}</text></g>)}
              <text x={PAD.l - 8} y={yOf(maxPrice) + 4} text-anchor="end">{facts.priceRise}×</text>
              <text x={PAD.l - 8} y={yOf(points[0].price) + 4} text-anchor="end">1×</text>
              <path class="curve" d={pricePath} />
              <path class="axis" d={`M${xOf(facts.raiseToGraduate)} ${PAD.t}V${CH - PAD.b}`} stroke-dasharray="3 3" />
              <text x={xOf(facts.raiseToGraduate) - 6} y={CH - PAD.b - 8} text-anchor="end">graduation</text>
              <text x={(CW + PAD.l) / 2} y={CH - 4} text-anchor="middle">credits taken in by the curve</text>
            </svg>
            <figcaption class="lp-note">Price relative to the first coin, against credits raised.</figcaption>
            <details class="lp-data">
              <summary>Chart data</summary>
              <div class="lp-table-wrap" tabindex="0" role="region" aria-label="Chart data">
                <table>
                  <caption class="lp-sr">Points along the curve</caption>
                  <thead><tr><th scope="col" class="num">Coins sold</th><th scope="col" class="num">Credits in</th><th scope="col" class="num">Price, × first coin</th><th scope="col" class="num">Market cap</th></tr></thead>
                  <tbody>{tablePoints.map((p) => <tr><td class="num">{p.soldPct}%</td><td class="num">{n(p.raised)}</td><td class="num">{n(p.price / points[0].price, 1)}×</td><td class="num">{n(p.marketCap)}</td></tr>)}</tbody>
                </table>
              </div>
            </details>
          </figure>
          <dl class="lp-facts lp-card">
            <dt>Supply</dt><dd>{int(facts.supply)} coins</dd>
            <dt>Sold on the curve</dt><dd>{int(facts.soldOnCurve)} (79.31%)</dd>
            <dt>Held for the pool</dt><dd>{int(facts.heldForPool)}</dd>
            <dt>Starting market cap</dt><dd>{n(facts.startMarketCap)} cr</dd>
            <dt>Credits to graduate</dt><dd>{n(facts.raiseToGraduate)} cr</dd>
            <dt>Market cap at graduation</dt><dd>{n(facts.endMarketCap)} cr</dd>
            <dt>A first buy of {n(facts.firstBuy.quote, 0)} cr, after the fee</dt><dd>{int(facts.firstBuy.tokens)} coins</dd>
            <dt>Curve fee, inside the buy</dt><dd>{n(facts.curveFeeBps / 100)}% ({n(facts.creatorFeeBps / 100)}% creator, {n(facts.houseFeeBps / 100)}% house)</dd>
          </dl>
        </div>
        <p><strong>Two progress bars, not one.</strong> Counting coins sold makes a bar read half full when only {n(facts.creditsAtHalfTokens)} of {n(facts.raiseToGraduate)} credits are in, about a fifth of the way. The board below shows both.</p>
      </section>

      <section class="lp-section" aria-labelledby="rules-title">
        <h2 id="rules-title">Four launch rules</h2>
        <p>Every run below is replayed under the plain rules most launchpads use (naked) and under a fair-launch preset that turns every defense on. One tick is one simulated second. Within a tick, orders go by priority fee and then by a seeded shuffle, which stands in for the race to land first in a block.</p>
        <div class="lp-table-wrap" tabindex="0" role="region" aria-label="Launch rules compared">
          <table>
            <thead><tr><th scope="col">Rule</th><th scope="col">Opening auction</th><th scope="col">Sniper fee</th><th scope="col">Early cap per wallet</th><th scope="col">Creator lock</th></tr></thead>
            <tbody>
              {rules.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.openingAuctionTicks ? `${r.openingAuctionTicks} ticks, 30 cr per wallet with any priority fee inside, pro-rata fill at one price` : '—'}</td>
                  <td>{r.sniperFee ? `${r.sniperFee.startBps / 100}% at open, falling to 0 over ${r.sniperFee.ticks} ticks` : '—'}</td>
                  <td>{r.earlyCap ? `${r.earlyCap.bps / 100}% of supply for ${r.earlyCap.ticks} ticks` : '—'}</td>
                  <td>{r.devLock ? 'cannot sell before graduation' : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="lp-section" aria-labelledby="runs-title">
        <h2 id="runs-title">Four runs, naked and fair</h2>
        <div class="lp-exhibits">
          {runs.map((run) => (
            <section class="lp-exhibit lp-card" id={run.id} aria-labelledby={`${run.id}-title`}>
              <img src={run.coins[0].image} width="360" height="420" alt="" loading="lazy" />
              <div>
                <p class="lp-kicker">Seed {run.seed} · {int(run.ticks)} ticks</p>
                <h3 id={`${run.id}-title`}>{run.title}</h3>
                <p>{run.summary}</p>
                <p class="lp-verdict">{runVerdict(run)}</p>
                <div class="lp-table-wrap" tabindex="0" role="region" aria-label={`${run.title}, naked and fair`}>
                  <table>
                    <thead><tr><th scope="col">{run.coins.length > 1 ? 'Coin' : 'Measure'}</th><th scope="col">Naked</th><th scope="col">Fair</th></tr></thead>
                    <tbody>
                      {run.naked.coins.map((c, i) => {
                        const f = run.fair.coins[i];
                        return [
                          <tr><th scope="row">{c.symbol} status</th><td>{c.status === 'migrated' ? `graduated, tick ${c.graduatedAtTick}` : 'on the curve'}</td><td>{f.status === 'migrated' ? `graduated, tick ${f.graduatedAtTick}` : 'on the curve'}</td></tr>,
                          <tr><th scope="row">{c.symbol} credits in</th><td class="num">{n(c.creditsRaised)}</td><td class="num">{n(f.creditsRaised)}</td></tr>,
                          <tr><th scope="row">{c.symbol} holders</th><td class="num">{c.holders}</td><td class="num">{f.holders}</td></tr>,
                          <tr><th scope="row">{c.symbol} risk</th><td><span class={`lp-badge ${c.risk.badge}`}>{c.risk.badge} · {c.risk.score}</span>{c.risk.flags.map((fl) => <span class="lp-badge flag">{fl}</span>)}</td><td><span class={`lp-badge ${f.risk.badge}`}>{f.risk.badge} · {f.risk.score}</span>{f.risk.flags.map((fl) => <span class="lp-badge flag">{fl}</span>)}</td></tr>,
                          <tr><th scope="row">{c.symbol} first-minute coins held by snipers</th><td class="num">{c.sniperShareFirstMinute}%</td><td class="num">{f.sniperShareFirstMinute}%</td></tr>,
                        ];
                      })}
                      <tr><th scope="row">Sniper fees to the house</th><td class="num">{n(run.naked.sniperFees)}</td><td class="num">{n(run.fair.sniperFees)}</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </section>
          ))}
        </div>
        <p class="lp-note">Credits are conserved in every run: what wallets, the curve, the pools, held creator fees and the house sinks hold at the end equals what the wallets started with. Under fair rules the sniper fee also lands on ordinary buyers in the first minute; that cost shows in the last row.</p>
      </section>

      <section class="lp-section" aria-labelledby="board-title">
        <h2 id="board-title">Live board</h2>
        <p>Play any of the four runs here, or launch your own coin into one. The engine, bots and screener are the same code the exhibits used. You trade from a wallet that starts with 1,000 play credits; every action you take (a launch, a trade, an approval, a kill switch, a policy edit) is a record in the run's action log, applies at the next tick, and travels in the replay link. Nothing is sent anywhere.</p>
        <div id="lp-app" class="lp-app"></div>
        <noscript><p class="lp-note">The live board needs JavaScript. The runs above were computed when this page was built.</p></noscript>
      </section>

      <section class="lp-section" aria-labelledby="method-title">
        <h2 id="method-title">How the simulation works</h2>
        <ul class="lp-list">
          <li><strong>Whole numbers.</strong> Every amount is a whole number of micro-credits, and every division rounds toward the curve, so the curve can always buy back every coin outstanding. A test checks that across 10,000 random trades, along with quotes that equal fills.</li>
          <li><strong>One price, fees inside.</strong> A buy names one amount, and the curve fee, any sniper fee and any priority fee all come out of it. Fee rates are counted in millionths, so the half-basis-point pool tiers are exact, and the creator, house and pool lines always add up to the whole fee, with the house taking the rounding.</li>
          <li><strong>Graduation.</strong> The buy that sells out the curve fills what is left at curve prices; any remainder buys from the new pool at its opening price in the same step. The pool's liquidity tokens are burned, so nobody can pull the liquidity, and the price moves less than 0.1% across the switch.</li>
          <li><strong>Bots only propose.</strong> Each proposal passes a policy gate that checks, in order: {POLICY_CHECKS.map((c) => c.toLowerCase().replaceAll('_', ' ')).join(', ')}. The first failing check is the reason on record, and every refusal is part of the logged run. Trades above a bot's approval line (25 cr by default) wait for a person: on the board they go to the approval queue under Bots & approvals (or are refused, if you choose), and a queued trade is void after 30 ticks or as soon as the bot's policy or credits change. The Stop buttons are the gate's kill switch.</li>
          <li><strong>Risk.</strong> The score weighs the creator's holdings, same-tick buys from wallets the creator funded, other buys in the first five ticks, how much the top ten holders hold and how much the creator has sold. Hard flags: DEV_DUMP, BUNDLED, WHALE and WASH.</li>
          <li><strong>Trending.</strong> Breadth of buying (the square root of volume per wallet cluster), distinct makers, trade count, price change, holder growth and liquidity, each compared across coins, then scaled down for concentration, warm-up and age. Every input is kept, so any rank can be explained.</li>
          <li><strong>Same seed, same story.</strong> A run, its seed, its rules, its approvals mode and its action log always produce the same event log, which is what a replay link carries. Each run's log hash is pinned in the tests under every rule set and both approvals modes, and a run with no presses here ends on that same hash; configuration hash <code>{configHash()}</code>.</li>
        </ul>
        <div class="lp-table-wrap" style="margin-top:12px" tabindex="0" role="region" aria-label="Bot strategies">
          <table>
            <thead><tr><th scope="col">Bot strategy</th><th scope="col">What it does</th></tr></thead>
            <tbody>{strategies.map((s) => <tr><th scope="row">{s.label}</th><td>{s.description}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="lp-section" aria-labelledby="next-title">
        <h2 id="next-title">What a live version would need</h2>
        <p>This page is stage A of three in the plan (<a href={`https://github.com/mhoydich/pointcast/blob/main/${PLAN_DOC}`}><code>{PLAN_DOC}</code></a>). A shared version on the PointCast devnet (stage B) would need Mike's go-ahead, a house account that follows the chain, and a kill switch that really stops an agent: on the devnet that is a fresh mandate with no permitted kinds, because clearing a mandate lifts every limit. A production version (stage C) is described in the plan only as a comparison: an audited program, an indexer and wallet policies. None of that is planned or built, and nothing here would ever pay out.</p>
      </section>

      <section class="lp-section" aria-labelledby="sources-title" data-launchpad-sources>
        <h2 id="sources-title">Sources</h2>
        <ul class="lp-list">
          {SOURCES.map((s) => <li><a href={s.url}>{s.title}</a>: {s.note}</li>)}
        </ul>
      </section>

      <footer class="lp-foot">
        <p>{CREDIT_LINE}</p>
        <p>{NOUNS_LINE} Coins show actual Nouns drawn from their verified seeds (#0–99); they are simulated coins, not Nouns Money notes.</p>
        <p>Written by {AUTHOR}. Machine edition: <a href="/case-studies/launchpad.json">launchpad.json</a>. Code: <code>src/lib/launchpad/</code>.</p>
      </footer>
    </div>
  </article>

  <script>
    import { mountApp } from '../../scripts/launchpad/app.mjs';

    const root = document.getElementById('lp-app');
    if (root) mountApp(root);
  </script>
</BlockLayout>
