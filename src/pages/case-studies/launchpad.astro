---
/**
 * /case-studies/launchpad — a simulated bonding-curve coin launchpad (stage A
 * of docs/plans/2026-10-19-launchpad-case-study.md). Exhibits are computed at
 * build time from src/lib/launchpad; the live board runs the same code in the
 * browser. Play credits only: nothing leaves the page. The layout runs
 * isolated (no beacon, wallet bridge, cursor room or freshness widget) and
 * stays out of search until the case-06 entry ships.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import { exhibits, curveFacts, curvePoints, rulesTable, strategyTable, POLICY_CHECKS, CASE_PATH, PLAN_DOC, SOURCES, AUTHOR } from '../../lib/launchpad/exhibits.mjs';
import { configHash, CREDIT_LINE, NOUNS_LINE } from '../../lib/launchpad/config.mjs';
import '../../styles/launchpad.css';

const facts = curveFacts();
const points = curvePoints();
const runs = exhibits();
const rules = rulesTable();
const strategies = strategyTable();
const n = (x: number, d = 2) => x.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const int = (x: number) => x.toLocaleString('en-US');

// Chart: price against credits raised, with market cap dashed on the same scale.
const CW = 560, CH = 270, PAD = { l: 68, r: 16, t: 14, b: 44 };
const chartBox = [0, 0, CW, CH].join(' ');
const maxRaised = points.at(-1)!.raised;
const maxPrice = points.at(-1)!.price;
const xOf = (raised: number) => PAD.l + (raised / maxRaised) * (CW - PAD.l - PAD.r);
const yOf = (price: number) => CH - PAD.b - (price / maxPrice) * (CH - PAD.t - PAD.b);
const pricePath = points.map((p, i) => `${i ? 'L' : 'M'}${xOf(p.raised).toFixed(1)} ${yOf(p.price).toFixed(1)}`).join('');
const xTicks = [0, 2000, 4000, 6000, 8000];
const chartTitle = `Price rises ${facts.priceRise} times as the curve takes in ${n(facts.raiseToGraduate)} credits, from a starting market cap of ${n(facts.startMarketCap)} to ${n(facts.endMarketCap)} at graduation.`;
const tablePoints = points.filter((_, i) => i % 6 === 0);

const runVerdict = (run: (typeof runs)[number]) => {
  const nk = run.naked.coins[0], fr = run.fair.coins[0];
  if (run.id === 'snipe-war') return `Snipers held ${nk.sniperShareFirstMinute}% of the coins bought in the first minute under naked rules, and ${fr.sniperShareFirstMinute}% under fair rules.`;
  if (run.id === 'dev-dump') return `Naked rules: ${nk.risk.flags.join(' and ') || 'no flags'}. Fair rules: ${fr.risk.flags.join(', ') || 'no flags'} — the creator lock refused the sale and the opening auction capped the bundle.`;
  if (run.id === 'graduation-run') return `${nk.symbol} graduated at tick ${nk.graduatedAtTick} into a pool with its liquidity tokens burned, then kept trading there.`;
  return `Nothing graduated: ${n(nk.creditsRaised)} credits came in and the risk score stayed ${nk.risk.badge}.`;
};

const title = 'Case study: a simulated coin launchpad';
const description = 'A deterministic, in-browser simulation of a bonding-curve coin launchpad run on play credits: the curve, four launch rules, sniper and bundle defenses, bots under policy limits, and four replayable runs. No value, may reset.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: `https://pointcast.xyz${CASE_PATH}`,
  datePublished: '2026-10-19',
  dateModified: '2026-10-19',
  author: { '@type': 'Organization', name: AUTHOR },
  publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
  isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz/' },
  isAccessibleForFree: true,
};
---
<BlockLayout title={title} description={description} jsonLd={jsonLd} hideAds isolated includeManifest={false} noindex author={AUTHOR} creator={AUTHOR} alternates={[{ type: 'application/json', href: '/case-studies/launchpad.json', title: 'Launchpad case study · machine edition' }]}>
  <article class="lp" data-launchpad-copy>
    <div class="lp-wrap">
      <nav class="lp-crumb" aria-label="Breadcrumb">
        <a href="/">PointCast</a><span aria-hidden="true">/</span>
        <span>case studies</span><span aria-hidden="true">/</span>
        <span>launchpad</span>
      </nav>

      <header class="lp-hero">
        <p class="lp-kicker">Case study · launchpad · simulation</p>
        <h1>A coin launchpad, simulated</h1>
        <p class="lp-dek">Bonding-curve launchpads let anyone start a coin in one step. A curve sets every price, and when the curve sells out the coin graduates into a pool whose liquidity can never be pulled. This case study rebuilds that design as a deterministic simulation run on play credits, then asks which launch rules hold up against sniper bots, bundled wallets and a creator who sells everything.</p>
        <p class="lp-standing">{CREDIT_LINE}</p>
        <div class="lp-stats">
          <div><strong>{runs.length}</strong><span>replayable runs</span></div>
          <div><strong>{rules.length}</strong><span>launch rules</span></div>
          <div><strong>{strategies.length}</strong><span>bot strategies</span></div>
          <div><strong>{POLICY_CHECKS.length}</strong><span>policy checks</span></div>
        </div>
        <div class="lp-coins">
          {runs.map((run) => (
            <figure>
              <img src={run.coins[0].image} width="360" height="420" alt={`${run.coins[0].name} (${run.coins[0].symbol}), the simulated coin from “${run.title}”, showing actual Noun #${run.coins[0].nounId}`} />
              <figcaption>{run.title}</figcaption>
            </figure>
          ))}
        </div>
      </header>

      <section class="lp-section" aria-labelledby="curve-title">
        <h2 id="curve-title">The curve</h2>
        <p>Each coin starts with virtual liquidity on both sides of a constant-product curve, so the product of the two sides never falls. Buying adds credits and takes coins out; selling does the reverse. The numbers copy the published curve constants of the best-known Solana launchpad (see Sources), with the credit side scaled up so it reads in whole play credits. Coin percentages are unchanged.</p>
        <div class="lp-two">
          <figure class="lp-card" style="margin:0">
            <svg class="lp-chart" viewBox={chartBox} role="img" aria-labelledby="curve-chart-title">
              <title id="curve-chart-title">{chartTitle}</title>
              <path class="axis" d={`M${PAD.l} ${PAD.t}V${CH - PAD.b}H${CW - PAD.r}`} fill="none" />
              {xTicks.map((t) => <g><path class="axis" d={`M${xOf(t)} ${CH - PAD.b}v5`} /><text x={xOf(t)} y={CH - PAD.b + 17} text-anchor="middle">{int(t)}</text></g>)}
              <text x={PAD.l - 8} y={yOf(maxPrice) + 4} text-anchor="end">{facts.priceRise}×</text>
              <text x={PAD.l - 8} y={yOf(points[0].price) + 4} text-anchor="end">1×</text>
              <path class="curve" d={pricePath} />
              <path class="axis" d={`M${xOf(facts.raiseToGraduate)} ${PAD.t}V${CH - PAD.b}`} stroke-dasharray="3 3" />
              <text x={xOf(facts.raiseToGraduate) - 6} y={CH - PAD.b - 8} text-anchor="end">graduation</text>
              <text x={(CW + PAD.l) / 2} y={CH - 4} text-anchor="middle">credits taken in by the curve</text>
            </svg>
            <figcaption class="lp-note">Price relative to the first coin, against credits raised.</figcaption>
            <details class="lp-data">
              <summary>Chart data</summary>
              <div class="lp-table-wrap">
                <table>
                  <caption class="lp-sr">Points along the curve</caption>
                  <thead><tr><th scope="col" class="num">Coins sold</th><th scope="col" class="num">Credits in</th><th scope="col" class="num">Price, × first coin</th><th scope="col" class="num">Market cap</th></tr></thead>
                  <tbody>{tablePoints.map((p) => <tr><td class="num">{p.soldPct}%</td><td class="num">{n(p.raised)}</td><td class="num">{n(p.price / points[0].price, 1)}×</td><td class="num">{n(p.marketCap)}</td></tr>)}</tbody>
                </table>
              </div>
            </details>
          </figure>
          <dl class="lp-facts lp-card">
            <dt>Supply</dt><dd>{int(facts.supply)} coins</dd>
            <dt>Sold on the curve</dt><dd>{int(facts.soldOnCurve)} (79.31%)</dd>
            <dt>Held for the pool</dt><dd>{int(facts.heldForPool)}</dd>
            <dt>Starting market cap</dt><dd>{n(facts.startMarketCap)} cr</dd>
            <dt>Credits to graduate</dt><dd>{n(facts.raiseToGraduate)} cr</dd>
            <dt>Market cap at graduation</dt><dd>{n(facts.endMarketCap)} cr</dd>
            <dt>A first buy of {n(facts.firstBuy.quote, 0)} cr, after the fee</dt><dd>{int(facts.firstBuy.tokens)} coins</dd>
            <dt>Curve fee, inside the buy</dt><dd>{n(facts.curveFeeBps / 100)}% ({n(facts.creatorFeeBps / 100)}% creator, {n(facts.houseFeeBps / 100)}% house)</dd>
          </dl>
        </div>
        <p><strong>Two progress bars, not one.</strong> Counting coins sold makes a bar read half full when only {n(facts.creditsAtHalfTokens)} of {n(facts.raiseToGraduate)} credits are in, about a fifth of the way. The board below shows both.</p>
      </section>

      <section class="lp-section" aria-labelledby="rules-title">
        <h2 id="rules-title">Four launch rules</h2>
        <p>Every run below is replayed under the plain rules most launchpads use (naked) and under a fair-launch preset that turns every defense on. One tick is one simulated second. Within a tick, orders go by priority fee and then by a seeded shuffle, which stands in for the race to land first in a block.</p>
        <div class="lp-table-wrap">
          <table>
            <thead><tr><th scope="col">Rule</th><th scope="col">Opening auction</th><th scope="col">Sniper fee</th><th scope="col">Early cap per wallet</th><th scope="col">Creator lock</th></tr></thead>
            <tbody>
              {rules.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.openingAuctionTicks ? `${r.openingAuctionTicks} ticks, 30 cr per wallet with any priority fee inside, pro-rata fill at one price` : '—'}</td>
                  <td>{r.sniperFee ? `${r.sniperFee.startBps / 100}% at open, falling to 0 over ${r.sniperFee.ticks} ticks` : '—'}</td>
                  <td>{r.earlyCap ? `${r.earlyCap.bps / 100}% of supply for ${r.earlyCap.ticks} ticks` : '—'}</td>
                  <td>{r.devLock ? 'cannot sell before graduation' : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="lp-section" aria-labelledby="runs-title">
        <h2 id="runs-title">Four runs, naked and fair</h2>
        <div class="lp-exhibits">
          {runs.map((run) => (
            <section class="lp-exhibit lp-card" id={run.id} aria-labelledby={`${run.id}-title`}>
              <img src={run.coins[0].image} width="360" height="420" alt="" loading="lazy" />
              <div>
                <p class="lp-kicker">Seed {run.seed} · {int(run.ticks)} ticks</p>
                <h3 id={`${run.id}-title`}>{run.title}</h3>
                <p>{run.summary}</p>
                <p class="lp-verdict">{runVerdict(run)}</p>
                <div class="lp-table-wrap">
                  <table>
                    <thead><tr><th scope="col">{run.coins.length > 1 ? 'Coin' : 'Measure'}</th><th scope="col">Naked</th><th scope="col">Fair</th></tr></thead>
                    <tbody>
                      {run.naked.coins.map((c, i) => {
                        const f = run.fair.coins[i];
                        return [
                          <tr><th scope="row">{c.symbol} status</th><td>{c.status === 'migrated' ? `graduated, tick ${c.graduatedAtTick}` : 'on the curve'}</td><td>{f.status === 'migrated' ? `graduated, tick ${f.graduatedAtTick}` : 'on the curve'}</td></tr>,
                          <tr><th scope="row">{c.symbol} credits in</th><td class="num">{n(c.creditsRaised)}</td><td class="num">{n(f.creditsRaised)}</td></tr>,
                          <tr><th scope="row">{c.symbol} holders</th><td class="num">{c.holders}</td><td class="num">{f.holders}</td></tr>,
                          <tr><th scope="row">{c.symbol} risk</th><td><span class={`lp-badge ${c.risk.badge}`}>{c.risk.badge} · {c.risk.score}</span>{c.risk.flags.map((fl) => <span class="lp-badge flag">{fl}</span>)}</td><td><span class={`lp-badge ${f.risk.badge}`}>{f.risk.badge} · {f.risk.score}</span>{f.risk.flags.map((fl) => <span class="lp-badge flag">{fl}</span>)}</td></tr>,
                          <tr><th scope="row">{c.symbol} first-minute coins held by snipers</th><td class="num">{c.sniperShareFirstMinute}%</td><td class="num">{f.sniperShareFirstMinute}%</td></tr>,
                        ];
                      })}
                      <tr><th scope="row">Sniper fees to the house</th><td class="num">{n(run.naked.sniperFees)}</td><td class="num">{n(run.fair.sniperFees)}</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </section>
          ))}
        </div>
        <p class="lp-note">Credits are conserved in every run: what wallets, the curve, the pools, held creator fees and the house sinks hold at the end equals what the wallets started with. Under fair rules the sniper fee also lands on ordinary buyers in the first minute; that cost shows in the last row.</p>
      </section>

      <section class="lp-section" aria-labelledby="board-title">
        <h2 id="board-title">Live board</h2>
        <p>Replay any run here. The engine, bots and screener are the same code the exhibits used. Nothing is sent anywhere, and a reload starts over.</p>
        <div id="lp-board" data-ticks-default="900">
          <div class="lp-controls" role="group" aria-label="Simulation controls">
            <label>Run <select id="lp-run">{runs.map((run) => <option value={run.id}>{run.title}</option>)}</select></label>
            <label>Rules <select id="lp-rules">{rules.map((r) => <option value={r.id}>{r.label}</option>)}</select></label>
            <button id="lp-play" type="button" aria-pressed="false">Play</button>
            <button id="lp-step" type="button">Step</button>
            <label>Speed <select id="lp-speed"><option value="10">10 ticks/s</option><option value="100" selected>100 ticks/s</option><option value="1000">1,000 ticks/s</option></select></label>
            <button id="lp-reset" type="button">Reset</button>
            <button id="lp-killall" class="lp-kill" type="button" aria-pressed="false">Stop all bots</button>
            <span class="lp-clock" id="lp-clock">tick 0</span>
            <p class="lp-sr" id="lp-status" role="status" aria-live="polite"></p>
          </div>
          <div class="lp-board">
            <div class="lp-card">
              <h3>Screener</h3>
              <div class="lp-table-wrap">
                <table class="lp-screener">
                  <thead><tr><th scope="col">Coin</th><th scope="col">Status</th><th scope="col" class="num">Market cap</th><th scope="col" class="num">5m volume</th><th scope="col" class="num">Buys / sells</th><th scope="col" class="num">Holders</th><th scope="col">Risk</th></tr></thead>
                  <tbody id="lp-screener"></tbody>
                </table>
              </div>
              <h3 style="margin-top:18px">Bots</h3>
              <div class="lp-table-wrap">
                <table class="lp-bots">
                  <thead><tr><th scope="col">Bot</th><th scope="col">Strategy</th><th scope="col" class="num">Fills</th><th scope="col" class="num">Refused</th><th scope="col" class="num">Net credits</th><th scope="col"><span class="lp-sr">Kill switch</span></th></tr></thead>
                  <tbody id="lp-bots"></tbody>
                </table>
              </div>
            </div>
            <div class="lp-card" id="lp-detail" aria-live="off">
              <h3 id="lp-detail-title">Coin</h3>
              <p class="lp-note" id="lp-detail-sub"></p>
              <div class="lp-note">Coins sold <span id="lp-p-tokens"></span></div>
              <div class="lp-bar"><span id="lp-bar-tokens" style="width:0"></span></div>
              <div class="lp-note">Credits in <span id="lp-p-credits"></span></div>
              <div class="lp-bar"><span id="lp-bar-credits" style="width:0"></span></div>
              <svg class="lp-candles" viewBox="0 0 400 150" preserveAspectRatio="none" role="img" aria-labelledby="lp-candles-title"><title id="lp-candles-title">One-minute candles for the selected coin</title><g id="lp-candles"></g></svg>
              <details class="lp-data" id="lp-candle-data">
                <summary>Candle data</summary>
                <div class="lp-table-wrap">
                  <table>
                    <caption class="lp-sr">The last ten one-minute candles</caption>
                    <thead><tr><th scope="col" class="num">From tick</th><th scope="col" class="num">Open</th><th scope="col" class="num">High</th><th scope="col" class="num">Low</th><th scope="col" class="num">Close</th><th scope="col" class="num">Volume</th></tr></thead>
                    <tbody id="lp-candle-rows"></tbody>
                  </table>
                </div>
              </details>
              <h3 style="margin-top:12px">Tape</h3>
              <ul class="lp-tape" id="lp-tape"></ul>
            </div>
          </div>
          <noscript><p class="lp-note">The live board needs JavaScript. The runs above were computed when this page was built.</p></noscript>
        </div>
      </section>

      <section class="lp-section" aria-labelledby="method-title">
        <h2 id="method-title">How the simulation works</h2>
        <ul class="lp-list">
          <li><strong>Whole numbers.</strong> Every amount is a whole number of micro-credits, and every division rounds toward the curve, so the curve can always buy back every coin outstanding. A test checks that across 10,000 random trades, along with quotes that equal fills.</li>
          <li><strong>One price, fees inside.</strong> A buy names one amount, and the curve fee, any sniper fee and any priority fee all come out of it. Fee rates are counted in millionths, so the half-basis-point pool tiers are exact, and the creator, house and pool lines always add up to the whole fee, with the house taking the rounding.</li>
          <li><strong>Graduation.</strong> The buy that sells out the curve fills what is left at curve prices; any remainder buys from the new pool at its opening price in the same step. The pool's liquidity tokens are burned, so nobody can pull the liquidity, and the price moves less than 0.1% across the switch.</li>
          <li><strong>Bots only propose.</strong> Each proposal passes a policy gate that checks, in order: {POLICY_CHECKS.map((c) => c.toLowerCase().replaceAll('_', ' ')).join(', ')}. The first failing check is the reason on record, and every refusal is part of the logged run. Trades above a bot's approval line (25 cr by default) wait for a person; this board has no approval queue yet, so it refuses them. The Stop buttons are the gate's kill switch: each press is a record in the run's action log and takes effect in the next tick, so a replay reproduces it.</li>
          <li><strong>Risk.</strong> The score weighs the creator's holdings, same-tick buys from wallets the creator funded, other buys in the first five ticks, how much the top ten holders hold and how much the creator has sold. Hard flags: DEV_DUMP, BUNDLED, WHALE and WASH.</li>
          <li><strong>Trending.</strong> Breadth of buying (the square root of volume per wallet cluster), distinct makers, trade count, price change, holder growth and liquidity, each compared across coins, then scaled down for concentration, warm-up and age. Every input is kept, so any rank can be explained.</li>
          <li><strong>Same seed, same story.</strong> A run, its seed, its rules and its action log always produce the same event log. Each run's log hash is pinned in the tests under every rule set, and a run with no presses here ends on that same hash; configuration hash <code>{configHash()}</code>.</li>
        </ul>
        <div class="lp-table-wrap" style="margin-top:12px">
          <table>
            <thead><tr><th scope="col">Bot strategy</th><th scope="col">What it does</th></tr></thead>
            <tbody>{strategies.map((s) => <tr><th scope="row">{s.label}</th><td>{s.description}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="lp-section" aria-labelledby="next-title">
        <h2 id="next-title">What a live version would need</h2>
        <p>This page is stage A of three in the plan (<a href={`https://github.com/mhoydich/pointcast/blob/main/${PLAN_DOC}`}><code>{PLAN_DOC}</code></a>). A shared version on the PointCast devnet (stage B) would need Mike's go-ahead, a house account that follows the chain, and a kill switch that really stops an agent: on the devnet that is a fresh mandate with no permitted kinds, because clearing a mandate lifts every limit. A production version (stage C) is described in the plan only as a comparison: an audited program, an indexer and wallet policies. None of that is planned or built, and nothing here would ever pay out.</p>
      </section>

      <section class="lp-section" aria-labelledby="sources-title" data-launchpad-sources>
        <h2 id="sources-title">Sources</h2>
        <ul class="lp-list">
          {SOURCES.map((s) => <li><a href={s.url}>{s.title}</a>: {s.note}</li>)}
        </ul>
      </section>

      <footer class="lp-foot">
        <p>{CREDIT_LINE}</p>
        <p>{NOUNS_LINE} Coins show actual Nouns drawn from their verified seeds (#0–99); they are simulated coins, not Nouns Money notes.</p>
        <p>Written by {AUTHOR}. Machine edition: <a href="/case-studies/launchpad.json">launchpad.json</a>. Code: <code>src/lib/launchpad/</code>.</p>
      </footer>
    </div>
  </article>

  <script>
    import { createSim } from '../../lib/launchpad/sim.mjs';
    import { metrics, candles } from '../../lib/launchpad/screener.mjs';
    import { unrealized, eventsHash } from '../../lib/launchpad/engine.mjs';
    import { fmt } from '../../lib/launchpad/units.mjs';
    import quietLaunch from '../../data/launchpad/scenarios/quiet-launch.json' with { type: 'json' };
    import snipeWar from '../../data/launchpad/scenarios/snipe-war.json' with { type: 'json' };
    import devDump from '../../data/launchpad/scenarios/dev-dump.json' with { type: 'json' };
    import graduationRun from '../../data/launchpad/scenarios/graduation-run.json' with { type: 'json' };

    const SCENARIOS: Record<string, any> = { 'quiet-launch': quietLaunch, 'snipe-war': snipeWar, 'dev-dump': devDump, 'graduation-run': graduationRun };
    const $ = (id: string) => document.getElementById(id)!;
    const runSel = $('lp-run') as HTMLSelectElement;
    const rulesSel = $('lp-rules') as HTMLSelectElement;
    const speedSel = $('lp-speed') as HTMLSelectElement;
    const playBtn = $('lp-play');
    const killAllBtn = $('lp-killall');
    const screener = $('lp-screener');
    const botsBody = $('lp-bots');
    const SVG = 'http://www.w3.org/2000/svg';

    let sim: any = null;
    let selected: string | null = null;
    let playing = false;
    let timer = 0;
    let last = 0;
    let carry = 0;
    let lastPaint = 0;
    let graduated = new Set<string>();
    // Kill presses are records in the run's action log and apply in the next tick; until then the button shows the press.
    let wanted = new Map<string, boolean>();
    let wantedAll: boolean | null = null;
    const coinRows = new Map<string, Record<string, HTMLElement>>();
    const botRows = new Map<string, Record<string, HTMLElement>>();
    const credits = (micro: bigint) => fmt(micro, 2);

    function el(tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) {
      const node = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      for (const kid of kids) node.append(kid);
      return node;
    }
    function setText(node: HTMLElement, text: string) { if (node.textContent !== text) node.textContent = text; }
    function announce(text: string) { $('lp-status').textContent = text; }

    function reset() {
      stop(false);
      sim = createSim({ scenario: SCENARIOS[runSel.value], rules: rulesSel.value });
      selected = null;
      graduated = new Set();
      wanted = new Map();
      wantedAll = null;
      coinRows.clear();
      botRows.clear();
      screener.replaceChildren();
      botsBody.replaceChildren(...sim.bots.map((b: any) => {
        const label = el('span', {}, 'Stop');
        const btn = el('button', { type: 'button', class: 'lp-kill', 'data-id': b.id, 'aria-pressed': 'false' }, label, el('span', { class: 'lp-sr' }, ` ${b.id}`));
        const cells = { fills: el('td', { class: 'num' }), refused: el('td', { class: 'num' }), net: el('td', { class: 'num' }), btn, label };
        botRows.set(b.id, cells);
        return el('tr', {}, el('th', { scope: 'row' }, b.id), el('td', {}, b.label), cells.fills, cells.refused, cells.net, el('td', {}, btn));
      }));
      render(true);
      announce(`${runSel.selectedOptions[0].text}, ${rulesSel.selectedOptions[0].text} rules, ready.`);
    }

    function stop(say = true) {
      if (playing && say) announce(`Paused at tick ${sim.world.tick}.`);
      playing = false;
      playBtn.setAttribute('aria-pressed', 'false');
      playBtn.textContent = 'Play';
      cancelAnimationFrame(timer);
    }

    function frame(now: number) {
      if (!playing) return;
      const dt = last ? Math.min(250, now - last) : 16;
      last = now;
      carry += (Number(speedSel.value) * dt) / 1000;
      let steps = Math.floor(carry);
      carry -= steps;
      while (steps-- > 0 && sim.world.tick < sim.scenario.ticks) sim.step();
      const done = sim.world.tick >= sim.scenario.ticks;
      if (done || now - lastPaint > 150) { lastPaint = now; render(); }
      if (done) { stop(false); announce(`Run finished at tick ${sim.world.tick}. Log hash ${eventsHash(sim.world.events)}.`); return; }
      timer = requestAnimationFrame(frame);
    }

    function coinRow(m: any) {
      let row = coinRows.get(m.id);
      if (!row) {
        const pick = el('button', { type: 'button', class: 'lp-pick', 'data-id': m.id, 'aria-pressed': 'false' }, m.symbol);
        row = { pick, status: el('td'), mcap: el('td', { class: 'num' }), vol: el('td', { class: 'num' }), flow: el('td', { class: 'num' }), holders: el('td', { class: 'num' }), risk: el('td') };
        coinRows.set(m.id, row);
        screener.append(el('tr', {}, el('th', { scope: 'row' }, pick), row.status, row.mcap, row.vol, row.flow, row.holders, row.risk));
      }
      return row;
    }

    function render(force = false) {
      const { world, index } = sim;
      const done = world.tick >= sim.scenario.ticks;
      setText($('lp-clock'), `tick ${world.tick} of ${sim.scenario.ticks} · ${world.events.length} events${done ? ` · log ${eventsHash(world.events)}` : ''}`);
      const rows = [...world.coins.values()].map((coin: any) => metrics(index, world, coin, 300));
      if (!selected && rows.length) selected = rows[0].id;
      if (!rows.length && !screener.querySelector('.lp-empty')) screener.replaceChildren(el('tr', { class: 'lp-empty' }, el('td', { colspan: '7' }, 'No coins yet. Press Play or Step.')));
      if (rows.length) screener.querySelector('.lp-empty')?.remove();
      for (const m of rows) {
        const row = coinRow(m);
        row.pick.setAttribute('aria-pressed', String(m.id === selected));
        setText(row.status, m.status === 'migrated' ? 'pool' : m.status);
        setText(row.mcap, credits(m.mcap));
        setText(row.vol, credits(m.volume));
        setText(row.flow, `${m.buys} / ${m.sells}`);
        setText(row.holders, String(m.holders));
        const riskText = `${m.risk.badge} ${m.risk.score}|${m.risk.flags.join(',')}`;
        if (row.risk.dataset.v !== riskText) {
          row.risk.dataset.v = riskText;
          row.risk.replaceChildren(el('span', { class: `lp-badge ${m.risk.badge}` }, `${m.risk.badge} ${m.risk.score}`), ...m.risk.flags.map((f: string) => el('span', { class: 'lp-badge flag' }, f)));
        }
        if (m.status === 'migrated' && !graduated.has(m.id)) { graduated.add(m.id); if (!force) announce(`${m.symbol} graduated into a pool at tick ${world.tick}.`); }
      }
      if (wantedAll === sim.killedAll) wantedAll = null;
      for (const [id, on] of wanted) if (sim.bots.find((b: any) => b.id === id).killed === on) wanted.delete(id);
      const allStopped = wantedAll ?? sim.killedAll;
      killAllBtn.setAttribute('aria-pressed', String(allStopped));
      for (const b of sim.bots) {
        const cells = botRows.get(b.id)!;
        const w = world.wallets.get(b.id);
        const stopped = (wanted.get(b.id) ?? b.killed) || allStopped;
        setText(cells.fills, String(b.fills));
        setText(cells.refused, String(Object.values(b.rejects as Record<string, number>).reduce((s, x) => s + x, 0)));
        cells.refused.title = Object.entries(b.rejects as Record<string, number>).map(([k, v]) => `${k.toLowerCase().replaceAll('_', ' ')} ${v}`).join(', ') || 'none';
        setText(cells.net, credits(w.realized + unrealized(world, w)));
        cells.btn.setAttribute('aria-pressed', String(stopped));
        setText(cells.label, stopped ? 'Stopped' : 'Stop');
        (cells.btn as HTMLButtonElement).disabled = allStopped;
      }
      renderDetail(rows);
    }

    function renderDetail(rows: any[]) {
      const { world, index } = sim;
      const coin = selected ? world.coins.get(selected) : null;
      if (!coin) {
        setText($('lp-detail-title'), 'No coin yet');
        setText($('lp-detail-sub'), 'Press Play or Step; the first coin launches in its first few ticks.');
        for (const id of ['lp-p-tokens', 'lp-p-credits']) setText($(id), '');
        for (const id of ['lp-bar-tokens', 'lp-bar-credits']) ($(id) as HTMLElement).style.width = '0';
        $('lp-candles').replaceChildren();
        $('lp-candle-rows').replaceChildren();
        $('lp-tape').replaceChildren();
        return;
      }
      const m = rows.find((r: any) => r.id === selected);
      setText($('lp-detail-title'), `${coin.name} (${coin.symbol})`);
      setText($('lp-detail-sub'), `Noun #${coin.nounId} · ${coin.status === 'migrated' ? 'graduated: trading in a pool with burned liquidity tokens' : coin.status === 'auction' ? 'opening auction' : 'on the curve'} · ${coin.rules} rules`);
      setText($('lp-p-tokens'), `${(m.progress.tokensBps / 100).toFixed(1)}%`);
      setText($('lp-p-credits'), `${(m.progress.creditsBps / 100).toFixed(1)}%`);
      ($('lp-bar-tokens') as HTMLElement).style.width = `${Math.min(100, m.progress.tokensBps / 100)}%`;
      ($('lp-bar-credits') as HTMLElement).style.width = `${Math.min(100, m.progress.creditsBps / 100)}%`;
      const cs = candles(index, world, coin, 60).slice(-40);
      const hi = Math.max(...cs.map((c: any) => c.h)), lo = Math.min(...cs.map((c: any) => c.l));
      const span = hi - lo || hi || 1;
      const y = (p: number) => 140 - ((p - lo) / span) * 130;
      const w = 400 / Math.max(cs.length, 20);
      $('lp-candles').replaceChildren(...cs.flatMap((c: any, i: number) => {
        const cls = c.c >= c.o ? 'up' : 'down';
        const x = i * w + w / 2;
        const wick = document.createElementNS(SVG, 'line');
        for (const [k, v] of [['x1', x], ['x2', x], ['y1', y(c.h)], ['y2', y(c.l)]]) wick.setAttribute(k as string, String(v));
        wick.setAttribute('class', cls);
        const box = document.createElementNS(SVG, 'rect');
        for (const [k, v] of [['x', x - w * 0.35], ['width', w * 0.7], ['y', Math.min(y(c.o), y(c.c))], ['height', Math.max(1, Math.abs(y(c.o) - y(c.c)))]]) box.setAttribute(k as string, String(v));
        box.setAttribute('class', cls);
        return [wick, box];
      }));
      if (($('lp-candle-data') as HTMLDetailsElement).open) {
        $('lp-candle-rows').replaceChildren(...cs.slice(-10).reverse().map((c: any) => el('tr', {},
          el('td', { class: 'num' }, String(c.t)), ...[c.o, c.h, c.l, c.c].map((p: number) => el('td', { class: 'num' }, p.toPrecision(4))), el('td', { class: 'num' }, `${c.v.toFixed(2)} cr`))));
      }
      const trades = index.trades.get(coin.id).slice(-12).reverse();
      $('lp-tape').replaceChildren(...trades.map((t: any) => {
        const role = world.wallets.get(t.wallet)?.role ?? '';
        return el('li', {}, el('span', {}, `t${t.tick}`), el('span', { class: t.side }, t.side), el('span', {}, el('span', { class: `lp-role ${role}` }, role), ` ${t.wallet}`), el('span', {}, `${credits(t.quote)} cr`));
      }));
    }

    screener.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button.lp-pick') as HTMLElement | null;
      if (!btn) return;
      selected = btn.dataset.id!;
      render();
    });
    botsBody.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button.lp-kill') as HTMLElement | null;
      if (!btn || (wantedAll ?? sim.killedAll) || sim.world.tick >= sim.scenario.ticks) return;
      const bot = sim.bots.find((b: any) => b.id === btn.dataset.id);
      const on = !(wanted.get(bot.id) ?? bot.killed);
      sim.kill(bot.id, on);
      wanted.set(bot.id, on);
      announce(`${bot.id} ${on ? 'stops' : 'runs again'} from tick ${sim.world.tick}.`);
      render();
    });
    $('lp-candle-data').addEventListener('toggle', () => render());
    playBtn.addEventListener('click', () => {
      if (playing) { stop(); return; }
      if (sim.world.tick >= sim.scenario.ticks) reset();
      playing = true; last = 0; carry = 0;
      playBtn.setAttribute('aria-pressed', 'true');
      playBtn.textContent = 'Pause';
      announce('Playing.');
      timer = requestAnimationFrame(frame);
    });
    $('lp-step').addEventListener('click', () => { if (sim.world.tick < sim.scenario.ticks) { sim.step(); render(); } });
    $('lp-reset').addEventListener('click', reset);
    runSel.addEventListener('change', reset);
    rulesSel.addEventListener('change', reset);
    killAllBtn.addEventListener('click', () => {
      if (sim.world.tick >= sim.scenario.ticks) return;
      const on = !(wantedAll ?? sim.killedAll);
      sim.killAll(on);
      wantedAll = on;
      announce(on ? `All bots stop from tick ${sim.world.tick}; their open auction orders are withdrawn.` : `Bots run again from tick ${sim.world.tick}.`);
      render();
    });
    reset();
  </script>
</BlockLayout>
