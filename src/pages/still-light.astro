---
import BlockLayout from '../layouts/BlockLayout.astro';
import PrayerLedger from '../components/PrayerLedger.astro';
import '../styles/still-light.css';
import artwork from '../data/still-light-art.json';
const title = 'Still Light · Prayer cards';
const description = 'A small place for prayer, healing and hope. Light a candle, touch the water, and close with a gentle bell. Made for your phone.';
---
<BlockLayout title={title} description={description} author="Codex" creator="Codex" image="/images/still-light/garden.webp" imageAlt="A symbolic garden of water, sun and a small flame in warm print colors." imageWidth={1024} imageHeight={1536} immersive isolated hideAds includeManifest={false}>
  <div class="sl" id="still-light">
    <a class="sl-skip" href="#sl-cards">Skip to prayer cards</a>
    <header class="sl-header">
      <a class="sl-wordmark" href="/">PointCast <span> / Still Light</span></a>
      <a href="/remembering/">Remembering someone <span aria-hidden="true">↗</span></a>
    </header>
    <section class="sl-intro" aria-labelledby="sl-title">
      <div class="sl-intro-copy">
        <p class="sl-eyebrow">A little light, held together</p>
        <h1 id="sl-title">Come as<br />you are.</h1>
        <p class="sl-lead">For your healing. For someone you love.<br />For whatever words cannot quite hold.</p>
        <a class="sl-primary" href="#sl-cards">Make a quiet moment <span aria-hidden="true">↓</span></a>
        <p class="sl-small">Take one card, or take your time with all three.</p>
      </div>
      <figure class="sl-poster">
        <img id="sl-art" src="/images/still-light/garden.webp" srcset="/images/still-light/garden-480.webp 480w, /images/still-light/garden.webp 1024w" sizes="(max-width: 760px) calc(100vw - 36px), 550px" width="1024" height="1536" alt="A warm, colorful symbolic garden: a small light beside calm water." fetchpriority="high" />
        <figcaption><span>There is room here for you.</span><label for="sl-art-kind">Choose your view</label><select id="sl-art-kind">{artwork.map(art => <option value={art.id}>{art.title} · {art.style}</option>)}</select></figcaption>
      </figure>
    </section>
    <section class="sl-controls" aria-label="Your atmosphere">
      <p>Settle in, your way.</p>
      <div>
        <button id="sl-sound" aria-label="Prayer sound" type="button" aria-pressed="false" disabled>Sound off</button>
        <button id="sl-motion" aria-label="Pause animation" type="button" aria-pressed="false" disabled>Pause motion</button>
      </div>
      <p class="sl-small" id="sl-sound-note">The room begins in silence.</p>
    </section>
    <noscript><p class="sl-noscript">You can read the prayers in silence. Turn on JavaScript to light candles, touch the water and play bells.</p></noscript>
    <div class="sl-cards" id="sl-cards">
      <section class="sl-card sl-light-card" aria-labelledby="sl-light-title">
        <div class="sl-card-heading"><span class="sl-number">01</span><span>Offer a light</span></div>
        <h2 id="sl-light-title">Someone in<br />your heart.</h2>
        <p>Light a candle for yourself, someone you love, or everyone who needs care.</p>
        <div class="sl-candles" role="group" aria-label="Candles">
          <button type="button" class="sl-candle" data-candle="yourself" aria-label="Candle for yourself" aria-pressed="false" disabled><span class="sl-flame" aria-hidden="true"></span><span class="sl-wax" aria-hidden="true"></span><span class="sl-candle-label">For you</span></button>
          <button type="button" class="sl-candle sl-candle-tall" data-candle="someone you love" aria-label="Candle for someone you love" aria-pressed="false" disabled><span class="sl-flame" aria-hidden="true"></span><span class="sl-wax" aria-hidden="true"></span><span class="sl-candle-label">For love</span></button>
          <button type="button" class="sl-candle" data-candle="everyone who needs care" aria-label="Candle for everyone who needs care" aria-pressed="false" disabled><span class="sl-flame" aria-hidden="true"></span><span class="sl-wax" aria-hidden="true"></span><span class="sl-candle-label">For all</span></button>
        </div>
        <p class="sl-small sl-card-foot" id="sl-candle-note" role="status">Tap a candle to light it. Tap again to let it rest.</p>
      </section>
      <section class="sl-card sl-water-card" aria-labelledby="sl-water-title">
        <div class="sl-card-heading"><span class="sl-number">02</span><span>Find a little stillness</span></div>
        <h2 id="sl-water-title">Let the water<br />hold a moment.</h2>
        <p>Nothing to complete. Breathe as you comfortably can, and simply be here.</p>
        <button type="button" class="sl-water" id="sl-water" aria-label="Send a gentle ripple across the water" disabled>
          <span class="sl-sun" aria-hidden="true"></span>
          <span class="sl-wave sl-wave-one" aria-hidden="true"></span><span class="sl-wave sl-wave-two" aria-hidden="true"></span><span class="sl-wave sl-wave-three" aria-hidden="true"></span>
          <span class="sl-water-label">Touch the water</span>
        </button>
        <p class="sl-small sl-card-foot" id="sl-water-note" role="status">A quiet place, for as long as you need.</p>
      </section>
      <section class="sl-card sl-prayer-card" aria-labelledby="sl-prayer-title">
        <div class="sl-card-heading"><span class="sl-number">03</span><span>Find your words</span></div>
        <h2 id="sl-prayer-title">A prayer<br />for this moment.</h2>
        <label class="sl-label" for="sl-prayer-kind">Hold in prayer</label>
        <select id="sl-prayer-kind"><option value="self">My own healing</option><option value="others">Someone I love</option><option value="caregivers">Those who care for us</option></select>
        <label class="sl-label" for="sl-name">A name, if you wish</label>
        <input id="sl-name" type="text" maxlength="70" placeholder="Held here, just for this visit" autocomplete="off" />
        <p class="sl-dedication" id="sl-dedication" hidden></p>
        <blockquote class="sl-prayer" id="sl-prayer-text">God of compassion, meet me where I am. Bring comfort to my body, steadiness to my heart, and kindness to the care around me. Help me receive the support I need, one day at a time.</blockquote>
        <label class="sl-label" for="sl-tone">Closing sound</label>
        <select id="sl-tone"><option value="surprise">A gentle variation</option><option value="bell">Soft bell</option><option value="gong">Low gong</option><option value="bowl">Singing bowl</option><option value="chime">Wind chime</option></select>
        <button type="button" class="sl-amen" id="sl-amen" disabled>Amen <span aria-hidden="true">✦</span></button>
        <p class="sl-small">Sound plays only when you turn it on above.</p>
        <div class="sl-closing" id="sl-closing" hidden><span aria-hidden="true">✦</span><p role="status" id="sl-blessing"></p></div>
      </section>
    </div>
    <section class="sl-remembrance"><span class="sl-remembrance-mark" aria-hidden="true">✳</span><div><p class="sl-eyebrow">Love and remembrance</p><h2>Some days call for different words.</h2><p>A separate place to remember someone, light a candle, and make a card with care.</p><a href="/remembering/">Visit the remembrance cards <span aria-hidden="true">↗</span></a></div></section>
    <PrayerLedger station="still-light" label="Add one quiet prayer" />
    <footer class="sl-footer"><p>Peace be with you.<br /><span class="sl-small">Names are used only on this page. They aren’t saved or sent.</span></p><nav aria-label="More quiet places"><a href="/prayer-candles/">The candle room</a><a href="/prayer-bells/">The bell garden</a><a href="/">Back to PointCast</a></nav><p class="sl-credit">Michael × Terra 6.1<br /><span class="sl-small">Made with care for PointCast.</span></p></footer>
  </div>
  <script>
    import { initializeStillLight } from '../lib/still-light-client';
    initializeStillLight();
  </script>
</BlockLayout>
