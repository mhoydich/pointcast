      let left = Math.floor(G.boot.chars);
      let y = 12;
      for (const line of G.boot.lines) {
        if (left <= 0) break;
        const shown = line.slice(0, Math.min(line.length, left));
        text(shown, 10, y, 2, m.text);
        left -= line.length + 1;
        if (left <= 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10 + textWidth(shown, 2) + (shown ? 2 : 0), y, 6, 10); }
        y += 12;
      }
      if (G.boot.lines.length && left > 0 && Math.floor(G.t * 2.5) % 2 === 0) { ctx.fillStyle = m.text; ctx.fillRect(10, y, 6, 10); }
    }
    function drawTitle() {
      const m = M();
      drawPaddlesAndBalls(0.3);
      rainbowText('TIDELINE', W / 2, 96, 7, [m.bands.red, m.bands.orange, m.bands.yellow, m.bands.green]);
      text('PONG STOOD ON ITS END', W / 2, 150, 2, m.bright, 'center');
      text(`${m.label} MODE / ${m.chip}`, W / 2, 170, 2, m.text, 'center');
      text(`DIAL ${DIALS[mood.dial].label}`, W / 2, 186, 2, m.text, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY' : 'TAP OR PRESS SPACE', W / 2, 250, 2, m.paddle, 'center');
      if (bestRally > 0 || wins > 0) text(`BEST RALLY ${bestRally}  WINS ${wins}`, W / 2, 280, 2, m.bright, 'center');
      text('2026 HOYDICH / POINTCAST', W / 2, H - 26, 2, m.dim, 'center');
    }
    function drawOver() {
      const m = M();
      drawPaddlesAndBalls(0.35);
      const won = G.match.winner === 'you';
      text(won ? 'YOU WIN' : 'HOUSE WINS', W / 2, 118, 5, won ? m.bands.yellow : m.bright, 'center');
      text(`${scoreDigits(G.match.you)} - ${scoreDigits(G.match.house)}`, W / 2, 172, 4, m.bright, 'center');
      text(`LONGEST RALLY ${G.match.longest}`, W / 2, 212, 2, m.text, 'center');
      text(`BEST ${bestRally}  WINS ${wins}  PEAK ${mood.peak}`, W / 2, 228, 2, m.text, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY AGAIN' : 'TAP OR SPACE TO PLAY AGAIN', W / 2, 268, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawField();
      if (G.phase === 'title') { drawHud(); drawTitle(); return; }
      if (G.phase === 'over') { drawHud(); drawOver(); return; }
      drawHud(); drawNet(); drawPaddlesAndBalls(1);
      const m = M();
      const b = G.balls[0];
      if (G.phase === 'serve' && b && Math.floor(G.t * 2) % 2 === 0 && G.msgT <= 0) {
        if (b.stuck === 'you') text(COARSE ? 'TAP TO SERVE' : 'TAP OR SPACE TO SERVE', W / 2, YOU_Y - 40, 2, m.text, 'center');
        else text(twoUp ? (COARSE ? 'TOP: TAP TO SERVE' : 'TOP: CLICK TO SERVE') : 'HOUSE SERVES', W / 2, HOUSE_Y + 30, 2, m.text, 'center');
      }
      if (G.phase === 'paused') { text('PAUSED', W / 2, 200, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 232, 2, m.text, 'center'); }
      if (G.msgT > 0 && G.msg) text(G.msg, W / 2, Math.round((HOUSE_Y + YOU_Y) / 2) - 24, G.msgScale, m.bright, 'center');
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const b = G.balls[0];
        readout.mood.textContent = `${G.attract ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${G.attract ? 104 : response.tempo} BPM ${G.attract ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.rally.textContent = G.attract ? 'RALLY --' : `RALLY ${G.rally} HOUSE ${twoUp ? '2UP' : Math.round(houseSkill(response) * 100)}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.vec.textContent = b ? `V ${Math.round(b.vx)},${Math.round(b.vy)}` : 'V 0,0';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function pointerToField(e) {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left - offX) / scale, y: (e.clientY - r.top - offY) / scale };
    }
    const topHalf = (p) => twoUp && p.y < (HOUSE_Y + YOU_Y) / 2;
    function action(fromTop) {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return; }
      if (G.phase === 'serve') {
        const b = G.balls[0];
        if (!b || !b.stuck) return;
        if (b.stuck === 'you' && !fromTop) { launch(b); G.phase = 'play'; }
        else if (b.stuck === 'house' && twoUp && fromTop) { launch(b); G.phase = 'play'; }
        return;
      }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    function steer(e, p) {
      if (G.attract && G.phase === 'title') return;
      // A held touch or button keeps the paddle it started on; a hovering mouse just follows its half.
      const held = e.pointerType === 'touch' || e.buttons > 0;
      const side = held && G.pointers.has(e.pointerId) ? G.pointers.get(e.pointerId) : topHalf(p) ? 'top' : 'you';
      if (held) G.pointers.set(e.pointerId, side);
      if (side === 'top') { if (twoUp) G.house.x = p.x; return; }
      if (G.pointerX != null) G.pointerDir = p.x > G.pointerX ? 1 : p.x < G.pointerX ? -1 : G.pointerDir;
      G.pointerX = p.x;
      G.youX = p.x;
    }
    canvas.addEventListener('pointermove', (e) => { steer(e, pointerToField(e)); });
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      const p = pointerToField(e);
      const top = topHalf(p);
      steer(e, p);
      action(top);
    });
    const forget = (e) => { G.pointers.delete(e.pointerId); };
    canvas.addEventListener('pointerup', forget);
    canvas.addEventListener('pointercancel', forget);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      if (t && typeof t.closest === 'function' && t.closest('a, button, input, textarea, select, [contenteditable]')) return;
      const k = e.code;
      if (k === 'ArrowLeft' || k === 'ArrowRight' || k === 'KeyA' || k === 'KeyD') { G.keys[k] = true; e.preventDefault(); audio.unlock(); return; }
      if (twoUp && (k === 'KeyJ' || k === 'KeyL')) { G.keys[k] = true; audio.unlock(); return; }
      if (twoUp && k === 'KeyI') { action(true); return; }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); action(false); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); return; }
      if (k === 'Digit4') { toggleTwo(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function togglePause() {
      if (G.phase === 'play' || G.phase === 'serve') { G.resume = G.phase; G.phase = 'paused'; audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        G.keys = {}; G.pointers.clear();
        if (G.phase === 'play' || G.phase === 'serve') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', () => { G.keys = {}; G.pointers.clear(); });
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.two.setAttribute('aria-pressed', String(twoUp));
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      // The dial changes the match on the spot: CALM lifts the finish line, PLAY and RUSH put it back.
      G.match.unlimited = unlimited();
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${next === 'calm' ? 'No game ends.' : next === 'play' ? `Rally to ${G.match.toWin}.` : 'Starts hot.'}`);
      showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleTwo() {
      twoUp = !twoUp;
      G.pointers.clear();
      syncButtons();
      announce(twoUp ? 'Two players. The top half of the field steers the top paddle.' : 'One player. The house takes the top paddle.');
      showMsg(twoUp ? '2 UP' : '1 UP', 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    btn.machine.addEventListener('click', () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    btn.dial.addEventListener('click', () => { audio.unlock(); cycleDial(); });
    btn.two.addEventListener('click', () => { audio.unlock(); toggleTwo(); });
    btn.sound.addEventListener('click', toggleSound);
    btn.crt.addEventListener('click', toggleCrt);
    btn.full.addEventListener('click', toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
