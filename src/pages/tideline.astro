    const geom = () => ({ W, H, WALL, HUD, BALL, PADDLE_H, youX: G.youX, youW: G.youW, youY: YOU_Y, houseX: G.house.x, houseW: G.houseW, houseY: HOUSE_Y });
    const unlimited = () => DIALS[mood.dial].unlimitedBalls;

    function bootScript() {
      if (machineId === 'c64') return ['', '    **** POINTCAST 64 BASIC V2 ****', '', ' 64K RAM SYSTEM', ' 38911 BASIC BYTES FREE', '', 'READY.', 'LOAD"TIDELINE",8,1', '', 'SEARCHING FOR TIDELINE', 'LOADING', 'READY.', 'RUN'];
      return ['READY', 'RUN "D:TIDELINE"', '', 'LOADING', 'READY', 'RUN'];
    }
    function beginBoot() {
      G.phase = 'boot'; G.t = 0;
