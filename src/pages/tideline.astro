---
/**
 * /tideline — Pong stood on its end. Thread 1 of 5 after Breakwater.
 *
 * Brief by Michael Hoydich, 2026-10-22: 80s innocence, the joy of the compute
 * and flow, mood-state symbiosis, mobile and full screen, audio-visual
 * multimedia, Atari and Commodore inspired, rendered modern.
 *
 * Portrait Pong: the house paddle at the top under two big score digits, your
 * paddle at the bottom, the ball between. Everything in the playfield is drawn
 * from the shared 3x5 pixel font and plain rects on a canvas; every sound is
 * synthesized. Pure logic lives in src/lib/tideline (physics, rules) and the
 * mood model is imported unchanged from src/lib/breakwater/mood.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { WIN_SCORE } from '../lib/tideline/rules.mjs';

const description = 'Pong stood on its end: your paddle at the bottom, the house at the top, two big digits a side, rally to 11. Atari 800XL or Commodore 64 blue, synthesized sound, and a house whose skill follows the mood you and the game keep together. Phone or full screen.';
const canonical = 'https://pointcast.xyz/tideline';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Tideline',
      alternateName: 'Tideline: Pong stood on its end',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/tideline/og.png',
      gamePlatform: 'Web browser',
      genre: 'Pong',
      playMode: ['SinglePlayer', 'MultiPlayer'],
      numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 2 },
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Tideline', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dialNotes = { calm: 'no game ends, the digits roll on', play: `rally to ${WIN_SCORE}`, rush: 'starts hot, leans into the second ball' };
const dials = Object.values(DIALS);
---

<BlockLayout
  title="Tideline"
  description={description}
  image="/images/tideline/og.png"
  imageAlt="A blue portrait playfield with two big score digits, a dashed net, two paddles and a white ball beside the words Tideline, Pong stood on its end."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/tideline.json', title: 'Tideline rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/tideline/og.png',
    buttons: [
      { label: 'Play Tideline', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="td" data-td data-machine="xl" data-crt="on">
    <div class="td-stage" data-stage>
      <header class="td-bar">
        <a class="td-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="td-name" aria-hidden="true">TIDELINE</span>
        <div class="td-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-two-btn aria-pressed="false" title="Second player on the top paddle (4)">2UP</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="td-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Tideline playfield. Steer the bottom paddle, tap or press space to serve."></canvas>
        <div class="td-scan" aria-hidden="true"></div>
        <noscript><p class="td-noscript">Tideline needs JavaScript to move the ball and make its sounds. The rules and moods are readable at <a href="/tideline.json">/tideline.json</a>.</p></noscript>
      </div>
      <footer class="td-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-rally>RALLY 0</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-vec>V 0,0</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="td-notes">
      <p class="td-eyebrow">PointCast / Games / Tideline</p>
      <h1>Pong stood on its end.</h1>
      <p class="td-lede">Your paddle at the bottom, the house at the top, a ball between them and two big digits a side. Rally to eleven. The house gets sharper or softer with the mood you keep together.</p>

      <div class="td-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you, the same model as <a href="/breakwater">Breakwater</a>. Returns raise its <strong>energy</strong>. A lost point lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is, and the house paddle reads them.</p>
          <ul class="td-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major pulse, an easy house.</li>
            <li><b>FLOW</b> a long rally. Bright colors, the music opens up, a steadier house.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, a faster pulse, a sharp house, and once a game a second ball.</li>
            <li><b>DRIFT</b> after lost points. Your paddle widens, the ball slows, the notes thin out, the house arrives late.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({dialNotes[d.id]}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and after a game the mood is handed to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue text. Raw square waves with a noise bite, in the POKEY spirit. A blue READY and a RUN before the net.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>The paddle pok is the signature sound. Pong took its three tones from the cabinet's sync generator; Tideline approximates them with square waves, a short mid tone for the paddle, a lower blip for the wall, a longer tone for a point. No samples, no ROMs. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-tideline-notes.md">research note on Pong and Video Olympics</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>Rally to {WIN_SCORE}. Serve alternates every point; on your serve the ball waits on your paddle, on the house's serve it comes down after a beat. Eight segments across each paddle decide the angle, steep from the middle and flat from the edges, the 1972 cabinet's rule. Speed rises with every volley and resets on a point. No game ends on CALM; the digits roll on.</p>
          <h2>Controls</h2>
          <ul>
            <li>Move the mouse or drag anywhere on the field. Tap or click to serve.</li>
            <li>Keys: ← → or A D steer, Space serves, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial, 4 toggles 2UP; in 2UP the top player steers with J and L and serves with I.</li>
            <li>2UP hands the top paddle to a second person: touch or mouse in the top half of the field steers it, and the house brain steps aside.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="td-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026, as thread 1 of 5 after Breakwater. Original code, art and synthesized sound; no ROMs, no recordings. Pong and Video Olympics are Atari's; the names appear here as tributes.</p>
        <p><a href="/tideline.json">tideline.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .td { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .td[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .td-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .td-stage:fullscreen, .td-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .td-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .td-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .td-home:hover { color: #fff; }
  .td-name { color: #fff; font-weight: 700; margin-right: auto; }
  .td-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .td-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .td-controls button:hover { background: #1f2456; }
  .td-controls button[aria-pressed='false'] { color: #6b7199; text-decoration: line-through; }
  .td-controls button[data-two-btn][aria-pressed='false'] { text-decoration: none; }
  .td-controls button[data-two-btn][aria-pressed='true'] { color: #fff; border-color: var(--paddle); }
  .td-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .td-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .td-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .td-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .td[data-crt='off'] .td-scan { display: none; }
  .td-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .td-noscript a { color: var(--paddle); }
  .td-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .td-readout span { white-space: nowrap; }
  .td-readout a { margin-left: auto; color: var(--text); text-decoration: none; }
  .td-readout a:hover { color: #fff; }
  .td-stage:fullscreen .td-readout a, .td-stage:-webkit-full-screen .td-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .td-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .td-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .td-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .td-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .td-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .td-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .td-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .td-grid h2 + h2, .td-grid p + h2, .td-grid ul + h2 { margin-top: 22px; }
  .td-grid p { margin: 0 0 12px; }
  .td-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .td-grid li { margin-bottom: 6px; }
  .td-moods { list-style: none; padding: 0; }
  .td-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .td-notes a { color: #a9b9f5; }
  .td-notes a:hover { color: #fff; }
  .td-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .td-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .td-stage { min-height: 0; }
    .td-bar { gap: 8px; padding: 6px 10px; }
    .td-name { display: none; }
    .td-controls { gap: 4px; }
    .td-controls button { padding: 7px 6px; min-width: 38px; font-size: 9px; }
    .td-readout { gap: 10px; font-size: 9px; height: 26px; }
    .td-readout [data-r-vec], .td-readout [data-r-fps] { display: none; }
    .td-grid { grid-template-columns: 1fr; gap: 20px; }
    .td-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .td-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { FIELD, createBall, stepBall, predictX, normalize } from '../lib/tideline/physics.mjs';
  import { createMatch, rallySpeed, awardPoint, serverFor, houseSkill, createHouse, stepHouse, scoreDigits } from '../lib/tideline/rules.mjs';

  const root = document.querySelector('[data-td]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = FIELD.W, H_MIN = FIELD.H_MIN, H_MAX = FIELD.H_MAX, WALL = FIELD.WALL, HUD = FIELD.HUD, BALL = FIELD.BALL;
    const PADDLE_H = FIELD.PADDLE_H, PADDLE_W = FIELD.PADDLE_W, HOUSE_Y = FIELD.HOUSE_Y;
    let H = H_MIN;
    let YOU_Y = H - FIELD.YOU_INSET;
    const STORE = 'tideline:v1';
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      two: root.querySelector('[data-two-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      rally: root.querySelector('[data-r-rally]'),
      fps: root.querySelector('[data-r-fps]'),
      vec: root.querySelector('[data-r-vec]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let twoUp = false;
    let bestRally = Number.isFinite(settings.bestRally) ? settings.bestRally : 0;
    let wins = Number.isFinite(settings.wins) ? settings.wins : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ bestRally, wins, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 110, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // Pong's three tones came from the cabinet's sync generator. These are square-wave stand-ins, tuned by ear.
      const POK = 459, WALL_TONE = 226, POINT_TONE = 490;
      const PROG = {
        major: [[48, 55, 60, 64], [45, 52, 57, 60], [41, 48, 53, 57], [43, 50, 55, 59]],
        bright: [[48, 55, 59, 64], [50, 57, 62, 66], [53, 60, 65, 69], [55, 62, 67, 71]],
        minor: [[45, 52, 57, 60], [41, 48, 53, 57], [43, 50, 55, 59], [45, 52, 57, 60]],
        soft: [[48, 55, 64, 67], [41, 48, 60, 65], [45, 52, 64, 69], [43, 50, 62, 67]],
      };
      const PULSE = [0, 2, 1, 3, 0, 2, 3, 1];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.003, r = 0.04, detune = 0, filter = true }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.6, t + a + dur * 0.3, Math.max(0.01, dur * 0.25));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (filter && machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 4;
          f.frequency.setValueAtTime(Math.min(12000, freq * 7), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.3), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 2400; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        // A sparse pulse: bass on the downbeats, a lead note now and then, more as energy rises.
        if (idx % 4 === 0) voice({ freq: midi(chord[0] - 12), type: bass(), t, dur: 0.16, vol: 0.16, dest: music, r: 0.06 });
        const gate = scale === 'soft' ? 0.22 : 0.3 + density * 0.5;
        if (idx % 2 === 1 && Math.random() < gate) {
          const n = chord[PULSE[(idx >> 1) % PULSE.length]] + 12 + (scale === 'minor' && idx % 4 === 3 ? 12 : 0);
