    // ---------- game state ----------
    const G = {
      phase: 'boot', t: 0, boot: { lines: [], chars: 0, done: false, beeped: false, total: 0 },
      match: createMatch(), youX: W / 2, youW: PADDLE_W, youTarget: PADDLE_W, house: createHouse(W / 2), houseW: PADDLE_W,
      balls: [], particles: [], flash: 0, msg: '', msgT: 0, msgScale: 3, rally: 0,
      pointerX: null, pointerDir: 0, pointers: new Map(), keys: {}, attract: true, loading: 0, secondUsed: false, fps: 60, fpsAcc: 0, fpsN: 0,
