---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Stones — drop a stone, hear a ripple" description="Click anywhere on the pond. A stone drops, a ripple expands, a note plays — pitched by where you clicked. Echo mode plays the note again two seconds later. Auto mode drops stones for you while you sit there.">
  <main class="cs" id="cs" data-built={built}>
    <header class="cs__hero">
      <p class="cs__kicker">CAST · STONES · pond · ripples · scale-locked</p>
      <h1 class="cs__title">Stones.</h1>
      <p class="cs__sub">Click anywhere on the pond. A stone drops, a ripple expands, a note plays — pitched by where you clicked. Higher click = higher note. Snapped to the scale you pick, so any combination sounds intentional.</p>
    </header>

    <section class="cs__panel">
      <div class="cs__set">
        <p class="cs__set-label">KEY</p>
        <div class="cs__pills" id="cs-key-pills">
          <button class="cs__pill cs__pill--active" data-key="Cpent">C pent</button>
          <button class="cs__pill" data-key="C">C major</button>
          <button class="cs__pill" data-key="G">G major</button>
          <button class="cs__pill" data-key="Am">A minor</button>
          <button class="cs__pill" data-key="Dm">D minor</button>
          <button class="cs__pill" data-key="Em">E minor</button>
        </div>
      </div>
      <div class="cs__set">
        <p class="cs__set-label">VOICE</p>
        <div class="cs__pills" id="cs-voice-pills">
          <button class="cs__pill cs__pill--active" data-voice="bell">bell</button>
          <button class="cs__pill" data-voice="harp">harp</button>
          <button class="cs__pill" data-voice="koto">koto</button>
          <button class="cs__pill" data-voice="glass">glass</button>
        </div>
      </div>
      <div class="cs__set">
        <p class="cs__set-label">MODES</p>
        <div class="cs__pills">
          <button class="cs__pill" id="cs-echo-toggle" aria-pressed="false">echo</button>
          <button class="cs__pill" id="cs-auto-toggle" aria-pressed="false">auto-drop</button>
          <button class="cs__pill" id="cs-clear">clear</button>
        </div>
      </div>
    </section>

    <section class="cs__stage">
      <canvas class="cs__pond" id="cs-pond" width="1200" height="520"></canvas>
      <p class="cs__hint" id="cs-hint">Click or tap. Higher = higher pitch. Multiple ripples can overlap.</p>
    </section>

    <section class="cs__about">
      <h2 class="cs__about-h">What's happening</h2>
      <p>The pond is a canvas. Each click drops a "stone" — a brief growing circle that fades over ~2.5 seconds. The stone's Y position picks a scale degree across 2 octaves of the chosen scale; the note plays at the moment the stone hits. Multiple stones can be on the pond at once — their ripples overlap, their notes sum.</p>
      <p><strong>Echo</strong> repeats each stone's note 1.5 seconds later at half volume, like a second wash arriving after the first. <strong>Auto-drop</strong> seeds the pond with a random stone every 1.5–4 seconds while it's on, so the surface stays alive while you watch.</p>
      <p>Voices: <strong>bell</strong> is three sine partials with a fast attack and slow decay, <strong>harp</strong> is a quick-pluck sine + 2× harmonic with very fast decay, <strong>koto</strong> is a triangle with slight detune and a bright transient, <strong>glass</strong> is layered sines at 1× / 2× / 5× with a long shimmery tail.</p>
      <p>Pair with <a href="/cast-shape">/cast-shape</a> (draw a curve), <a href="/cast-bell">/cast-bell</a> (strike pitched bells), <a href="/cast-cradle">/cast-cradle</a> (sleep pad fade).</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cs-ink: #06121c;
      --cs-deep: #0e2436;
      --cs-flame: #f6c15e;
      --cs-flame-deep: #d68f2c;
      --cs-cream: #f4e7c8;
      --cs-cream-dim: #c8b48a;
      --cs-cream-dimmer: #8b7a5a;
      --cs-mauve: #b39ddb;
      --cs-mint: #9bd7b8;
      --cs-rose: #e6788c;
      --cs-water: #4a8fb3;
    }

    body:has(.cs) {
      background:
        radial-gradient(circle at 50% 0%, #1a3a52 0%, transparent 50%),
        var(--cs-ink);
      color: var(--cs-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cs { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }

    .cs__hero { text-align: center; margin-bottom: 32px; }
    .cs__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cs-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cs__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 144px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cs-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.5);
    }
    .cs__sub {
      max-width: 700px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cs-cream-dim);
    }

    /* PANEL */
    .cs__panel {
      display: grid;
      grid-template-columns: 1.5fr 1.2fr 1fr;
      gap: 12px;
      margin-bottom: 22px;
    }
    @media (max-width: 820px) { .cs__panel { grid-template-columns: 1fr; } }
    .cs__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .cs__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--cs-cream-dimmer);
      margin: 0 0 8px;
    }
    .cs__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .cs__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cs-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cs__pill:hover { background: rgba(246,193,94,0.10); }
    .cs__pill--active, .cs__pill[aria-pressed="true"] {
      background: var(--cs-flame);
      color: #2a1a08;
      border-color: var(--cs-flame);
    }

    /* STAGE */
    .cs__stage {
      background:
        radial-gradient(ellipse at 30% 20%, rgba(74,143,179,0.18) 0%, transparent 50%),
        radial-gradient(ellipse at 70% 80%, rgba(74,143,179,0.12) 0%, transparent 50%),
        var(--cs-deep);
      border: 1px solid rgba(74,143,179,0.32);
      border-radius: 22px;
      padding: 16px;
      margin-bottom: 28px;
      box-shadow: inset 0 0 60px rgba(0,0,0,0.4);
    }
    .cs__pond {
      width: 100%;
      height: 520px;
      max-height: 70vh;
      border-radius: 14px;
      display: block;
      touch-action: none;
      cursor: crosshair;
    }
    .cs__hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cs-cream-dimmer);
      margin: 10px 4px 0;
      text-align: center;
    }

    /* ABOUT */
    .cs__about {
      max-width: 760px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cs__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cs-cream);
      margin: 0 0 12px;
    }
    .cs__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--cs-cream-dim);
      margin: 0 0 12px;
    }
    .cs__about strong { color: var(--cs-cream); }
    .cs__about a { color: var(--cs-flame); text-decoration: none; }
    .cs__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- music data ----
    const MAJOR = [0, 2, 4, 5, 7, 9, 11];
    const MINOR = [0, 2, 3, 5, 7, 8, 10];
    const PENT  = [0, 2, 4, 7, 9];
    type KeyKey = 'Cpent' | 'C' | 'G' | 'Am' | 'Dm' | 'Em';
    const KEYS: Record<KeyKey, { rootMidi: number; scale: number[] }> = {
      'Cpent': { rootMidi: 60, scale: PENT },
      'C':     { rootMidi: 60, scale: MAJOR },
      'G':     { rootMidi: 67, scale: MAJOR },
      'Am':    { rootMidi: 57, scale: MINOR },
      'Dm':    { rootMidi: 62, scale: MINOR },
      'Em':    { rootMidi: 52, scale: MINOR },
    };

    type Voice = 'bell' | 'harp' | 'koto' | 'glass';
    let currentKey: KeyKey = 'Cpent';
    let voice: Voice = 'bell';
    let echoOn = false;
    let autoOn = false;
    let autoTimer: number | null = null;

    // ---- audio ----
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;

    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    function midiToHz(m: number) { return 440 * Math.pow(2, (m - 69) / 12); }

    function playNote(midi: number, atCtxTime: number, gainMul = 1) {
      if (!ctx || !scheduler || !masterGain) return;
      const hz = midiToHz(midi);
      // Per-voice stacks
      const stacks =
        voice === 'bell' ? [
          { freq: hz,     gain: 0.32, decay: 2.4 },
          { freq: hz * 2, gain: 0.18, decay: 1.6 },
          { freq: hz * 4, gain: 0.06, decay: 0.9 },
        ] :
        voice === 'harp' ? [
          { freq: hz,     gain: 0.32, decay: 0.9 },
          { freq: hz * 2, gain: 0.10, decay: 0.6 },
        ] :
        voice === 'koto' ? [
          { freq: hz,     gain: 0.30, decay: 1.4 },
          { freq: hz,     gain: 0.16, decay: 1.0, detune: 5 },
          { freq: hz * 3, gain: 0.05, decay: 0.3 },
        ] :
        // glass: 1×, 2×, 5× with long tails
        [
          { freq: hz,      gain: 0.24, decay: 3.0 },
          { freq: hz * 2,  gain: 0.16, decay: 2.4 },
          { freq: hz * 5,  gain: 0.05, decay: 1.6 },
        ];

      for (const v of stacks) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = voice === 'koto' ? 'triangle' : 'sine';
        osc.frequency.value = v.freq;
        if ((v as any).detune) osc.detune.value = (v as any).detune;
        const peak = v.gain * gainMul;
        const attack = voice === 'harp' ? 0.003 : voice === 'koto' ? 0.005 : 0.012;
        g.gain.setValueAtTime(0.0001, atCtxTime);
        g.gain.exponentialRampToValueAtTime(peak, atCtxTime + attack);
        g.gain.exponentialRampToValueAtTime(0.0001, atCtxTime + v.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(atCtxTime);
        osc.stop(atCtxTime + v.decay + 0.1);
      }
    }

    // ---- stones (ripples) ----
    type Stone = {
      x: number; y: number;       // canvas px
      bornMs: number;             // performance.now()
      lifeMs: number;              // 0..maxMs
      hue: number;
    };
    const STONES: Stone[] = [];
    const STONE_LIFE_MS = 2400;

    function yToMidi(yNorm: number): number {
      // yNorm 0..1 with 0=top
      const k = KEYS[currentKey];
      const totalDegrees = k.scale.length * 2;
      const idx = Math.round((1 - yNorm) * (totalDegrees - 1));
      const oct = Math.floor(idx / k.scale.length);
      const inOct = idx % k.scale.length;
      return k.rootMidi + oct * 12 + k.scale[inOct];
    }

    function dropStone(xPx: number, yPx: number, W: number, H: number) {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      const yNorm = yPx / H;
      const midi = yToMidi(yNorm);
      const hue = 180 + (yNorm * 80) - 20;  // 160..240 hue band (teal → blue)
      STONES.push({ x: xPx, y: yPx, bornMs: performance.now(), lifeMs: STONE_LIFE_MS, hue });
      playNote(midi, ctx.currentTime + 0.005);
      if (echoOn) playNote(midi, ctx.currentTime + 1.5, 0.45);
    }

    function drawPond() {
      const canvas = document.getElementById('cs-pond') as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      const W = canvas.width, H = canvas.height;
      // Subtle water gradient
      const grad = c2.createLinearGradient(0, 0, 0, H);
      grad.addColorStop(0, '#0e2436');
      grad.addColorStop(0.5, '#0a1f30');
      grad.addColorStop(1, '#08161f');
      c2.fillStyle = grad;
      c2.fillRect(0, 0, W, H);

      // Pitch lane reference (subtle dots on left side)
      const k = KEYS[currentKey];
      const totalDegrees = k.scale.length * 2;
      for (let i = 0; i < totalDegrees; i++) {
        const yN = 1 - (i / (totalDegrees - 1));
        const y = yN * H;
        const isRoot = (i % k.scale.length) === 0;
        c2.fillStyle = isRoot ? 'rgba(246,193,94,0.35)' : 'rgba(244,231,200,0.10)';
        c2.beginPath();
        c2.arc(10, y, isRoot ? 3 : 1.5, 0, Math.PI * 2);
        c2.fill();
      }

      // Ripples
      const now = performance.now();
      for (let i = STONES.length - 1; i >= 0; i--) {
        const s = STONES[i];
        const t = (now - s.bornMs) / s.lifeMs;
        if (t >= 1) { STONES.splice(i, 1); continue; }
        const maxR = Math.min(W, H) * 0.34;
        // draw 3 concentric rings at staggered phases for a richer ripple
        for (let r = 0; r < 3; r++) {
          const phase = t + r * 0.22;
          if (phase >= 1) continue;
          const radius = maxR * phase;
          const alpha = (1 - phase) * (1 - phase) * 0.75;
          c2.strokeStyle = `hsla(${s.hue}, 60%, 70%, ${alpha})`;
          c2.lineWidth = (1 - phase) * 2.5 + 0.5;
          c2.beginPath();
          c2.arc(s.x, s.y, radius, 0, Math.PI * 2);
          c2.stroke();
        }
        // center stone fades
        const centerAlpha = (1 - t) * 0.9;
        c2.fillStyle = `hsla(${s.hue}, 70%, 80%, ${centerAlpha})`;
        c2.beginPath();
        c2.arc(s.x, s.y, 4 + t * 2, 0, Math.PI * 2);
        c2.fill();
      }
      requestAnimationFrame(drawPond);
    }

    // ---- auto-drop ----
    function scheduleAuto() {
      if (!autoOn) return;
      const canvas = document.getElementById('cs-pond') as HTMLCanvasElement;
      const W = canvas.width, H = canvas.height;
      const x = 40 + Math.random() * (W - 80);
      const y = 40 + Math.random() * (H - 80);
      dropStone(x, y, W, H);
      const delay = 1500 + Math.random() * 2500;
      autoTimer = window.setTimeout(scheduleAuto, delay);
    }
    function startAuto() {
      ensureCtx();
      autoOn = true;
      document.getElementById('cs-auto-toggle')!.setAttribute('aria-pressed', 'true');
      scheduleAuto();
    }
    function stopAuto() {
      autoOn = false;
      document.getElementById('cs-auto-toggle')!.setAttribute('aria-pressed', 'false');
      if (autoTimer != null) { clearTimeout(autoTimer); autoTimer = null; }
    }

    function init() {
      const canvas = document.getElementById('cs-pond') as HTMLCanvasElement;
      canvas.addEventListener('pointerdown', e => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const xPx = ((e.clientX - rect.left) / rect.width) * canvas.width;
        const yPx = ((e.clientY - rect.top) / rect.height) * canvas.height;
        dropStone(xPx, yPx, canvas.width, canvas.height);
      });

      document.getElementById('cs-key-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-key]');
        if (!btn) return;
        currentKey = btn.getAttribute('data-key') as KeyKey;
        document.querySelectorAll('#cs-key-pills .cs__pill').forEach(el =>
          el.classList.toggle('cs__pill--active', el === btn));
      });
      document.getElementById('cs-voice-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-voice]');
        if (!btn) return;
        voice = btn.getAttribute('data-voice') as Voice;
        document.querySelectorAll('#cs-voice-pills .cs__pill').forEach(el =>
          el.classList.toggle('cs__pill--active', el === btn));
      });

      document.getElementById('cs-echo-toggle')!.addEventListener('click', e => {
        e.stopPropagation();
        echoOn = !echoOn;
        (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(echoOn));
      });
      document.getElementById('cs-auto-toggle')!.addEventListener('click', e => {
        e.stopPropagation();
        if (autoOn) stopAuto(); else startAuto();
      });
      document.getElementById('cs-clear')!.addEventListener('click', e => {
        e.stopPropagation();
        STONES.length = 0;
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopAuto();
          if (ctx) ctx.suspend().catch(() => {});
        } else {
          if (ctx) ctx.resume().catch(() => {});
        }
      });

      requestAnimationFrame(drawPond);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
