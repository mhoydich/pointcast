---
/**
 * /drum-table — five-seat conference instrument.
 *
 * Sprint 3, surface 4 of Guest Receivers. Designed for an in-person
 * group around a table or a screen: 5 large pads in a row, each with
 * a tone tuned for ambient layering. Tap any pad to play its tone.
 * No score-keeping, no game; this is just a soft collective instrument.
 *
 * Pure static + Web Audio.
 */

import BlockLayout from '../layouts/BlockLayout.astro';
import DrumNav from '../components/DrumNav.astro';

const title = 'Table · Five-Seat Conference Instrument · PointCast';
const description =
  'Five large pads tuned for ambient layering. For an in-person group around a table or screen.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Drum Table',
  url: 'https://pointcast.xyz/drum-table',
  description,
  applicationCategory: 'MultimediaApplication',
};

const PADS = [
  { note: 'C', freq: 130.81, label: 'C3', hue: 22 },
  { note: 'E', freq: 164.81, label: 'E3', hue: 60 },
  { note: 'G', freq: 196.00, label: 'G3', hue: 200 },
  { note: 'B', freq: 246.94, label: 'B3', hue: 280 },
  { note: 'D', freq: 293.66, label: 'D4', hue: 320 },
];
---

<BlockLayout title={title} description={description} image="/images/og-drum-altars.png" jsonLd={jsonLd}>
  <main class="dt" id="dt-main">
    <DrumNav current="table" />

    <header class="dt__header">
      <div class="dt__chrome">
        <span>TABLE</span>
        <span class="dt__chrome-sep">·</span>
        <span>FIVE SEATS · CMAJ7 PAD</span>
        <span class="dt__chrome-sep">·</span>
        <span><span id="dt-taps">0</span> TAPS</span>
      </div>
      <h1 class="dt__title">TABLE</h1>
      <p class="dt__tagline">five seats · five tones · play together quietly</p>
    </header>

    <section class="dt__pads">
      {PADS.map((p, i) => (
        <button class="dt__pad" type="button" data-idx={i} data-freq={p.freq} aria-label={`Pad ${p.label}`}>
          <span class="dt__pad-note">{p.note}</span>
          <span class="dt__pad-octave">{p.label}</span>
          <span class="dt__pad-glow" style={`background: radial-gradient(circle, oklch(0.65 0.20 ${p.hue}) 0%, transparent 70%);`}></span>
        </button>
      ))}
    </section>

    <p class="dt__note">
      Tones held softly with 1.6s decay. Tap multiple pads in succession or have a few people tap at once;
      Cmaj7 is forgiving. Built for in-person groups around a screen, with optional projection on a TV.
    </p>
  </main>
</BlockLayout>

<style is:global>
  body:has(#dt-main) { background: #0c0410; }
  .dt {
    --dt-velvet: #1a0820; --dt-velvet-deep: #0c0410;
    --dt-brass: #d4a437; --dt-brass-deep: #6b4d12;
    --dt-flame: #f6c15e;
    --dt-ink-light: #f4e7c8; --dt-ink-mid: #c9b78c; --dt-ink-dim: #8a7a55;

    position: relative; isolation: isolate; margin: 0 -32px;
    padding: 0 clamp(16px, 2vw, 56px) 36px;
    color: var(--dt-ink-light);
    font-family: var(--pc-font-sans, 'Inter Tight', ui-sans-serif, system-ui, sans-serif);
    background:
      radial-gradient(ellipse at 50% 8%, rgba(212, 164, 55, 0.10), transparent 55%),
      linear-gradient(180deg, var(--dt-velvet) 0%, var(--dt-velvet-deep) 100%);
    min-height: calc(100vh - 80px);
  }
  .dt .drum-nav { opacity: 0.40; transform: scale(0.85); transform-origin: top left; margin-bottom: clamp(6px, 0.6vh, 12px); }

  .dt__header { text-align: center; padding: clamp(8px, 1vh, 18px) 0 clamp(28px, 4vh, 44px); }
  .dt__chrome {
    display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 14px);
    padding: 4px 16px; border: 1.5px solid var(--dt-brass-deep); border-radius: 999px;
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: clamp(10px, 0.9vw, 13px); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--dt-ink-mid); background: rgba(0, 0, 0, 0.35);
  }
  .dt__chrome-sep { color: var(--dt-brass-deep); }
  #dt-taps { color: var(--dt-flame); font-weight: 700; }

  .dt__title {
    margin: clamp(8px, 1vh, 14px) 0 6px;
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px); font-weight: 400; letter-spacing: 0.06em;
    color: var(--dt-brass);
    text-shadow: 0 0 28px rgba(212, 164, 55, 0.40), 0 2px 0 var(--dt-velvet-deep);
  }
  .dt__tagline {
    margin: 0; font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 17px); color: var(--dt-ink-mid);
  }

  .dt__pads {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: clamp(10px, 1.5vw, 18px);
    max-width: 980px; margin: 0 auto clamp(24px, 4vh, 36px);
  }
  @media (max-width: 720px) { .dt__pads { grid-template-columns: repeat(2, 1fr); } }
  .dt__pad {
    position: relative;
    appearance: none; border: 1.5px solid var(--dt-brass-deep);
    cursor: pointer; aspect-ratio: 1;
    background: linear-gradient(180deg, rgba(44, 13, 54, 0.55) 0%, rgba(12, 4, 16, 0.78) 100%);
    color: var(--dt-ink-light);
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.20),
      inset 0 -2px 0 rgba(0, 0, 0, 0.4),
      0 4px 0 0 var(--dt-velvet-deep),
      0 4px 12px rgba(0, 0, 0, 0.4);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; overflow: hidden;
    transition: transform 80ms, box-shadow 100ms;
  }
  .dt__pad:hover { transform: translateY(-1px); }
  .dt__pad:active, .dt__pad.dt__pad--struck {
    transform: translateY(3px);
    box-shadow:
      inset 0 1px 0 rgba(212, 164, 55, 0.40),
      inset 0 -2px 0 rgba(0, 0, 0, 0.4),
      0 1px 0 0 var(--dt-velvet-deep),
      0 0 26px rgba(246, 193, 94, 0.55);
  }
  .dt__pad-note {
    font-family: 'Gloock', 'Lora', Georgia, serif;
    font-size: clamp(40px, 5vw, 64px); color: var(--dt-flame);
    line-height: 1; text-shadow: 0 0 18px rgba(246, 193, 94, 0.45);
  }
  .dt__pad-octave {
    font-family: var(--pc-font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px; letter-spacing: 0.18em; color: var(--dt-ink-dim);
  }
  .dt__pad-glow {
    position: absolute; inset: -50%;
    pointer-events: none; opacity: 0;
    filter: blur(18px); mix-blend-mode: screen;
    transition: opacity 380ms ease-out;
  }
  .dt__pad.dt__pad--struck .dt__pad-glow {
    opacity: 0.70; transition: opacity 80ms ease-out;
  }

  .dt__note {
    max-width: 540px; margin: 0 auto;
    font-family: 'Lora', Georgia, serif; font-style: italic;
    font-size: clamp(13px, 1.2vw, 16px); color: var(--dt-ink-dim);
    text-align: center; line-height: 1.55;
  }
</style>

<script>
  let actx = null;
  function ctx() {
    if (!actx) { const AC = window.AudioContext || window.webkitAudioContext; actx = new AC(); }
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function playPad(freq) {
    const a = ctx(); const t = a.currentTime;
    const o = a.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
    const o2 = a.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 2;
    const filt = a.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 1600;
    const g = a.createGain(); const g2 = a.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.30, t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
    g2.gain.setValueAtTime(0.0001, t); g2.gain.exponentialRampToValueAtTime(0.10, t + 0.01); g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.9);
    o.connect(filt); o2.connect(filt);
    filt.connect(g); g.connect(a.destination);
    g2.connect(a.destination); o2.connect(g2);
    o.start(t); o.stop(t + 1.7); o2.start(t); o2.stop(t + 1.0);
  }

  const padEls = Array.from(document.querySelectorAll('.dt__pad'));
  const tapsEl = document.getElementById('dt-taps');
  let taps = 0;
  padEls.forEach((el, i) => {
    el.addEventListener('click', () => {
      const f = parseFloat(el.dataset.freq || '130.81');
      try { playPad(f); } catch {}
      el.classList.remove('dt__pad--struck'); void el.offsetWidth;
      el.classList.add('dt__pad--struck');
      setTimeout(() => el.classList.remove('dt__pad--struck'), 240);
      taps += 1;
      if (tapsEl) tapsEl.textContent = String(taps);
    });
  });
  // 1-5 keyboard
  window.addEventListener('keydown', (e) => {
    if (e.key >= '1' && e.key <= '5') {
      const idx = parseInt(e.key, 10) - 1;
      padEls[idx]?.click();
    }
  });
</script>
