---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Shape — draw a curve, hear a melody" description="Draw a line across the canvas. The page reads it as a melody — Y is pitch, X is time — and snaps it to whatever key you pick. Browser only. Sharable via URL hash.">
  <main class="csh" id="csh" data-built={built}>
    <header class="csh__hero">
      <p class="csh__kicker">CAST · SHAPE · draw · snap-to-scale · hear</p>
      <h1 class="csh__title">Shape.</h1>
      <p class="csh__sub">Draw a curve across the canvas with your mouse or finger. The page reads it as a melody — vertical position is pitch, horizontal position is time — and snaps it to the scale you pick. Goes up = pitch goes up. Goes flat = note holds.</p>
    </header>

    <section class="csh__panel">
      <div class="csh__set">
        <p class="csh__set-label">KEY</p>
        <div class="csh__pills" id="csh-key-pills">
          <button class="csh__pill csh__pill--active" data-key="C">C major</button>
          <button class="csh__pill" data-key="G">G major</button>
          <button class="csh__pill" data-key="D">D major</button>
          <button class="csh__pill" data-key="Am">A minor</button>
          <button class="csh__pill" data-key="Em">E minor</button>
          <button class="csh__pill" data-key="Cpent">C pent</button>
        </div>
      </div>
      <div class="csh__set">
        <p class="csh__set-label">TEMPO · <span id="csh-tempo-val">96</span> BPM · 4 bars</p>
        <input type="range" class="csh__tempo" id="csh-tempo" min="60" max="160" value="96"/>
      </div>
      <div class="csh__set">
        <p class="csh__set-label">VOICE</p>
        <div class="csh__pills" id="csh-voice-pills">
          <button class="csh__pill csh__pill--active" data-voice="bell">bell</button>
          <button class="csh__pill" data-voice="vib">vib</button>
          <button class="csh__pill" data-voice="reed">reed</button>
        </div>
      </div>
    </section>

    <section class="csh__stage">
      <canvas class="csh__canvas" id="csh-canvas" width="1000" height="320"></canvas>
      <p class="csh__hint" id="csh-hint">Click and drag (or touch and slide). Top of the canvas is high, bottom is low. Draw left to right.</p>
    </section>

    <section class="csh__transport">
      <button class="csh__play" id="csh-play" type="button">
        <span class="csh__play-icon" id="csh-play-icon">▶</span>
        <span class="csh__play-label" id="csh-play-label">PLAY</span>
      </button>
      <button class="csh__clear" id="csh-clear" type="button">CLEAR</button>
      <button class="csh__share" id="csh-share" type="button">SHARE LINK</button>
      <span class="csh__share-status" id="csh-share-status"></span>
    </section>

    <section class="csh__about">
      <h2 class="csh__about-h">What's behind the snap</h2>
      <p>The canvas covers two octaves of the selected scale (about 14 scale degrees for diatonic keys, 10 for pentatonic). When you draw, the stroke is sampled to 32 evenly-spaced points across its X span. Each point's Y is mapped to the nearest scale degree, then notes are extracted by collapsing consecutive same-degree samples into single sustained notes.</p>
      <p>So a flat line plays one held note. A staircase plays a clean run. A wiggly line plays a busier melody. A vertical jump becomes a leap. Anything you draw stays in key because the snap quantizes every sample.</p>
      <p>The whole thing is four bars (16 beats) wide. Bars are marked. Voices are synthesized — <strong>bell</strong> is a sine plus 2× and 4× partials with quick decay, <strong>vib</strong> is three slightly-detuned sines (chorused), <strong>reed</strong> is a triangle plus a softer sawtooth for breath.</p>
      <p>Share button copies the canvas as a base-32 URL hash. Anyone who opens the link sees and hears the same shape.</p>
      <p>Pair with <a href="/cast-letter">/cast-letter</a> for words instead of shapes, <a href="/cast-jam">/cast-jam</a> for free-play, <a href="/cast-throw">/cast-throw</a> for melodic conversation.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --csh-ink: #0b0816;
      --csh-walnut: #4a2a1a;
      --csh-flame: #f6c15e;
      --csh-flame-deep: #d68f2c;
      --csh-cream: #f4e7c8;
      --csh-cream-dim: #c8b48a;
      --csh-cream-dimmer: #8b7a5a;
      --csh-mauve: #b39ddb;
      --csh-mint: #9bd7b8;
      --csh-rose: #e6788c;
    }

    body:has(.csh) {
      background: radial-gradient(circle at 70% 0%, #2a1830 0%, var(--csh-ink) 60%);
      color: var(--csh-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .csh { max-width: 1080px; margin: 0 auto; padding: 48px 24px 80px; }

    .csh__hero { text-align: center; margin-bottom: 32px; }
    .csh__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--csh-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .csh__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 138px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--csh-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .csh__sub {
      max-width: 720px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--csh-cream-dim);
    }

    /* PANEL */
    .csh__panel {
      display: grid;
      grid-template-columns: 2fr 1.4fr 1fr;
      gap: 12px;
      margin-bottom: 22px;
    }
    @media (max-width: 800px) { .csh__panel { grid-template-columns: 1fr; } }
    .csh__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .csh__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--csh-cream-dimmer);
      margin: 0 0 8px;
    }
    .csh__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .csh__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--csh-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .csh__pill:hover { background: rgba(246,193,94,0.10); }
    .csh__pill--active {
      background: var(--csh-flame);
      color: var(--csh-walnut);
      border-color: var(--csh-flame);
    }
    .csh__tempo { width: 100%; accent-color: var(--csh-flame); }

    /* STAGE */
    .csh__stage {
      background: rgba(0,0,0,0.34);
      border: 1px solid rgba(246,193,94,0.18);
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 18px;
    }
    .csh__canvas {
      width: 100%;
      height: 320px;
      background: rgba(0,0,0,0.32);
      border-radius: 12px;
      display: block;
      touch-action: none;
      cursor: crosshair;
    }
    .csh__hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--csh-cream-dimmer);
      margin: 10px 4px 0;
    }

    /* TRANSPORT */
    .csh__transport {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 32px;
    }
    .csh__play {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      border-radius: 12px;
      border: 0;
      background: var(--csh-flame);
      color: var(--csh-walnut);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      box-shadow: 0 4px 14px rgba(246,193,94,0.32);
    }
    .csh__play:hover { background: var(--csh-flame-deep); }
    .csh__clear, .csh__share {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--csh-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .csh__clear:hover, .csh__share:hover { background: rgba(246,193,94,0.12); }
    .csh__share-status {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--csh-mint);
    }

    /* ABOUT */
    .csh__about {
      max-width: 760px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .csh__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--csh-cream);
      margin: 0 0 12px;
    }
    .csh__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--csh-cream-dim);
      margin: 0 0 12px;
    }
    .csh__about strong { color: var(--csh-cream); }
    .csh__about a { color: var(--csh-flame); text-decoration: none; }
    .csh__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    type KeyKey = 'C' | 'G' | 'D' | 'Am' | 'Em' | 'Cpent';
    const KEYS: Record<KeyKey, { rootMidi: number; scale: number[]; name: string }> = {
      'C':     { rootMidi: 60, scale: [0,2,4,5,7,9,11], name: 'C major' },
      'G':     { rootMidi: 67, scale: [0,2,4,5,7,9,11], name: 'G major' },
      'D':     { rootMidi: 62, scale: [0,2,4,5,7,9,11], name: 'D major' },
      'Am':    { rootMidi: 57, scale: [0,2,3,5,7,8,10], name: 'A minor' },
      'Em':    { rootMidi: 52, scale: [0,2,3,5,7,8,10], name: 'E minor' },
      'Cpent': { rootMidi: 60, scale: [0,2,4,7,9],      name: 'C pentatonic' },
    };

    type Voice = 'bell' | 'vib' | 'reed';
    let currentKey: KeyKey = 'C';
    let voice: Voice = 'bell';
    let tempo = 96;

    // Canvas state
    let stroke: { xN: number; yN: number }[] = [];  // normalized 0..1 stroke
    let drawing = false;
    const SAMPLE_COUNT = 32;
    const TOTAL_BEATS = 16;

    // Audio
    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let playing = false;
    let playStartCtx = 0;
    let rafId: number | null = null;
    let endTimer: number | null = null;

    // ---- canvas helpers ----
    function canvasSize(): { W: number; H: number } {
      const canvas = document.getElementById('csh-canvas') as HTMLCanvasElement;
      return { W: canvas.width, H: canvas.height };
    }

    function clientToNormalized(e: PointerEvent): { xN: number; yN: number } {
      const canvas = document.getElementById('csh-canvas') as HTMLCanvasElement;
      const rect = canvas.getBoundingClientRect();
      const xN = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const yN = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
      return { xN, yN };
    }

    function midiAtY(yN: number): number {
      // Top of canvas (yN=0) = top of range, bottom (yN=1) = bottom.
      const k = KEYS[currentKey];
      const degCount = k.scale.length;
      const totalDegrees = degCount * 2; // 2 octaves
      const idx = Math.round((1 - yN) * (totalDegrees - 1));  // 0..totalDegrees-1
      const oct = Math.floor(idx / degCount);
      const degInOct = idx % degCount;
      return k.rootMidi + oct * 12 + k.scale[degInOct];
    }

    function sampleStrokeToNotes(): { midi: number; startBeat: number; durBeats: number }[] {
      if (stroke.length < 2) return [];
      // Sort by xN ascending
      const sorted = [...stroke].sort((a, b) => a.xN - b.xN);
      // Sample at 32 evenly-spaced X positions; pick nearest stroke point at each
      const samples: number[] = [];  // midi at each sample
      for (let i = 0; i < SAMPLE_COUNT; i++) {
        const targetX = i / (SAMPLE_COUNT - 1);
        // find nearest point in sorted by xN
        let lo = 0, hi = sorted.length - 1;
        while (lo < hi) {
          const mid = (lo + hi) >> 1;
          if (sorted[mid].xN < targetX) lo = mid + 1;
          else hi = mid;
        }
        // Interpolate between sorted[lo-1] and sorted[lo]
        let yN: number;
        if (lo === 0) yN = sorted[0].yN;
        else {
          const p0 = sorted[lo - 1], p1 = sorted[lo];
          const t = (p1.xN === p0.xN) ? 0 : (targetX - p0.xN) / (p1.xN - p0.xN);
          yN = p0.yN + (p1.yN - p0.yN) * t;
        }
        samples.push(midiAtY(yN));
      }
      // Collapse runs of same midi into sustained notes
      const beatPerSample = TOTAL_BEATS / SAMPLE_COUNT;
      const notes: { midi: number; startBeat: number; durBeats: number }[] = [];
      let curMidi = samples[0];
      let runStart = 0;
      let runLen = 1;
      for (let i = 1; i < samples.length; i++) {
        if (samples[i] === curMidi) {
          runLen++;
        } else {
          notes.push({ midi: curMidi, startBeat: runStart * beatPerSample, durBeats: runLen * beatPerSample });
          curMidi = samples[i];
          runStart = i;
          runLen = 1;
        }
      }
      notes.push({ midi: curMidi, startBeat: runStart * beatPerSample, durBeats: runLen * beatPerSample });
      return notes;
    }

    function drawCanvas() {
      const canvas = document.getElementById('csh-canvas') as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      const { W, H } = canvasSize();
      c2.clearRect(0, 0, W, H);

      // background grid for scale degrees
      const k = KEYS[currentKey];
      const degCount = k.scale.length;
      const totalDegrees = degCount * 2;
      // horizontal lines for each degree
      for (let i = 0; i < totalDegrees; i++) {
        const y = H - (i / (totalDegrees - 1)) * H;
        const isRoot = (i % degCount) === 0;
        c2.strokeStyle = isRoot ? 'rgba(246,193,94,0.22)' : 'rgba(244,231,200,0.06)';
        c2.lineWidth = 1;
        c2.beginPath(); c2.moveTo(0, y); c2.lineTo(W, y); c2.stroke();
      }
      // vertical bar lines (4 bars)
      for (let bar = 0; bar <= 4; bar++) {
        const x = (bar / 4) * W;
        c2.strokeStyle = bar === 0 || bar === 4 ? 'rgba(246,193,94,0.3)' : 'rgba(244,231,200,0.10)';
        c2.lineWidth = 1.2;
        c2.beginPath(); c2.moveTo(x, 0); c2.lineTo(x, H); c2.stroke();
        if (bar < 4) {
          c2.fillStyle = 'rgba(246,193,94,0.4)';
          c2.font = '10px JetBrains Mono, monospace';
          c2.fillText(`${bar + 1}`, x + 6, 14);
        }
      }

      // Quantized notes (drawn first, so stroke overlays)
      const notes = sampleStrokeToNotes();
      if (notes.length > 0) {
        const minMidi = KEYS[currentKey].rootMidi;
        const maxMidi = minMidi + 24; // 2 octaves
        for (const n of notes) {
          const x = (n.startBeat / TOTAL_BEATS) * W;
          const w = Math.max(2, (n.durBeats / TOTAL_BEATS) * W - 2);
          const y = H - ((n.midi - minMidi) / (maxMidi - minMidi)) * H - 5;
          c2.fillStyle = 'rgba(155,215,184,0.32)';
          c2.fillRect(x, y, w, 10);
          c2.strokeStyle = 'rgba(155,215,184,0.72)';
          c2.lineWidth = 1;
          c2.strokeRect(x, y, w, 10);
        }
      }

      // Stroke line
      if (stroke.length > 0) {
        c2.strokeStyle = '#f6c15e';
        c2.lineWidth = 3;
        c2.lineCap = 'round';
        c2.lineJoin = 'round';
        c2.beginPath();
        for (let i = 0; i < stroke.length; i++) {
          const x = stroke[i].xN * W;
          const y = stroke[i].yN * H;
          if (i === 0) c2.moveTo(x, y);
          else c2.lineTo(x, y);
        }
        c2.stroke();
      }

      // playhead
      if (playing && ctx) {
        const elapsed = ctx.currentTime - playStartCtx;
        const beatPos = elapsed / (60 / tempo);
        if (beatPos >= 0 && beatPos <= TOTAL_BEATS) {
          const x = (beatPos / TOTAL_BEATS) * W;
          c2.strokeStyle = 'rgba(246,193,94,0.9)';
          c2.lineWidth = 2;
          c2.beginPath(); c2.moveTo(x, 0); c2.lineTo(x, H); c2.stroke();
        }
      }
    }

    // ---- audio ----
    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }
    function midiToHz(m: number) { return 440 * Math.pow(2, (m - 69) / 12); }
    function beatSec() { return 60 / tempo; }

    function playNote(midi: number, atCtxTime: number, durSec: number) {
      if (!ctx || !scheduler || !masterGain) return;
      const hz = midiToHz(midi);
      const tail = Math.max(durSec, 0.18);
      const stacks =
        voice === 'bell' ? [
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.34, decay: tail + 0.6 },
          { type: 'sine' as OscillatorType, freq: hz * 2, gain: 0.16, decay: tail + 0.2 },
          { type: 'sine' as OscillatorType, freq: hz * 4, gain: 0.06, decay: tail * 0.5 + 0.1 },
        ] :
        voice === 'vib' ? [
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.28, decay: tail + 0.4 },
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.18, detune: 5, decay: tail + 0.4 },
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.18, detune: -6, decay: tail + 0.4 },
        ] :
        // reed
        [
          { type: 'triangle' as OscillatorType, freq: hz, gain: 0.30, decay: tail + 0.3 },
          { type: 'sawtooth' as OscillatorType, freq: hz, gain: 0.10, detune: 3, decay: tail + 0.3 },
        ];
      const attack = voice === 'reed' ? 0.04 : 0.012;
      for (const v of stacks) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = v.type;
        osc.frequency.value = v.freq;
        if ((v as any).detune) osc.detune.value = (v as any).detune;
        g.gain.setValueAtTime(0.0001, atCtxTime);
        g.gain.exponentialRampToValueAtTime(v.gain, atCtxTime + attack);
        g.gain.setValueAtTime(g.gain.value, atCtxTime + tail - 0.18);
        g.gain.exponentialRampToValueAtTime(0.0001, atCtxTime + v.decay);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(atCtxTime);
        osc.stop(atCtxTime + v.decay + 0.05);
      }
    }

    function startPlayback() {
      ensureCtx();
      if (!ctx || stroke.length < 2) return;
      if (ctx.state === 'suspended') ctx.resume();
      if (scheduler) scheduler.stopAll();
      playing = true;
      document.getElementById('csh-play-icon')!.textContent = '■';
      document.getElementById('csh-play-label')!.textContent = 'STOP';
      const notes = sampleStrokeToNotes();
      const bs = beatSec();
      playStartCtx = ctx.currentTime + 0.06;
      for (const n of notes) {
        playNote(n.midi, playStartCtx + n.startBeat * bs, n.durBeats * bs);
      }
      const totalSec = TOTAL_BEATS * bs;
      if (endTimer != null) clearTimeout(endTimer);
      endTimer = window.setTimeout(() => stopPlayback(), (totalSec + 0.8) * 1000);
      tickPlayhead();
    }
    function stopPlayback() {
      playing = false;
      if (scheduler) scheduler.stopAll();
      if (endTimer != null) { clearTimeout(endTimer); endTimer = null; }
      if (rafId != null) { cancelAnimationFrame(rafId); rafId = null; }
      document.getElementById('csh-play-icon')!.textContent = '▶';
      document.getElementById('csh-play-label')!.textContent = 'PLAY';
      drawCanvas();
    }
    function tickPlayhead() {
      drawCanvas();
      if (playing) rafId = requestAnimationFrame(tickPlayhead);
    }

    // ---- url state ----
    // encode 32 yN samples as 2-digit hex (0-255) → 64 hex chars, plus key/tempo/voice
    function encodeStroke(): string {
      // Resample stroke to 32 yN points (one per beat-slot)
      if (stroke.length < 2) return '';
      const sorted = [...stroke].sort((a, b) => a.xN - b.xN);
      const samples: number[] = [];
      for (let i = 0; i < SAMPLE_COUNT; i++) {
        const targetX = i / (SAMPLE_COUNT - 1);
        let lo = 0, hi = sorted.length - 1;
        while (lo < hi) {
          const mid = (lo + hi) >> 1;
          if (sorted[mid].xN < targetX) lo = mid + 1;
          else hi = mid;
        }
        let yN: number;
        if (lo === 0) yN = sorted[0].yN;
        else {
          const p0 = sorted[lo - 1], p1 = sorted[lo];
          const t = (p1.xN === p0.xN) ? 0 : (targetX - p0.xN) / (p1.xN - p0.xN);
          yN = p0.yN + (p1.yN - p0.yN) * t;
        }
        samples.push(Math.max(0, Math.min(255, Math.round(yN * 255))));
      }
      return samples.map(v => v.toString(16).padStart(2, '0')).join('');
    }
    function decodeStroke(s: string): { xN: number; yN: number }[] {
      if (s.length < 64 || s.length > 64) return [];
      const out: { xN: number; yN: number }[] = [];
      for (let i = 0; i < 32; i++) {
        const hex = s.slice(i * 2, i * 2 + 2);
        const v = parseInt(hex, 16);
        if (Number.isNaN(v)) return [];
        out.push({ xN: i / 31, yN: v / 255 });
      }
      return out;
    }

    function setHashState() {
      const params = new URLSearchParams();
      params.set('k', currentKey);
      params.set('t', String(tempo));
      params.set('v', voice);
      const stroke64 = encodeStroke();
      if (stroke64) params.set('s', stroke64);
      location.hash = params.toString();
    }
    function readHashState() {
      if (!location.hash) return;
      const params = new URLSearchParams(location.hash.slice(1));
      const k = params.get('k') as KeyKey | null;
      const t = parseInt(params.get('t') || '');
      const v = params.get('v') as Voice | null;
      const s = params.get('s');
      if (k && KEYS[k]) currentKey = k;
      if (!Number.isNaN(t) && t >= 60 && t <= 160) tempo = t;
      if (v === 'bell' || v === 'vib' || v === 'reed') voice = v;
      if (s) stroke = decodeStroke(s);
    }

    function syncChips() {
      document.querySelectorAll('#csh-key-pills .csh__pill').forEach(el =>
        el.classList.toggle('csh__pill--active', el.getAttribute('data-key') === currentKey));
      document.querySelectorAll('#csh-voice-pills .csh__pill').forEach(el =>
        el.classList.toggle('csh__pill--active', el.getAttribute('data-voice') === voice));
    }

    function init() {
      readHashState();
      syncChips();
      (document.getElementById('csh-tempo') as HTMLInputElement).value = String(tempo);
      document.getElementById('csh-tempo-val')!.textContent = String(tempo);
      drawCanvas();

      const canvas = document.getElementById('csh-canvas') as HTMLCanvasElement;
      canvas.addEventListener('pointerdown', e => {
        e.preventDefault();
        canvas.setPointerCapture(e.pointerId);
        stroke = [clientToNormalized(e)];
        drawing = true;
        drawCanvas();
      });
      canvas.addEventListener('pointermove', e => {
        if (!drawing) return;
        const p = clientToNormalized(e);
        // only push if X advanced (keep mostly monotonic)
        if (stroke.length === 0 || p.xN > stroke[stroke.length - 1].xN) {
          stroke.push(p);
          drawCanvas();
        } else if (p.xN < stroke[stroke.length - 1].xN) {
          // backwards motion → snap last point to current Y (refine)
          stroke[stroke.length - 1] = p;
          drawCanvas();
        }
      });
      const endStroke = () => {
        drawing = false;
        document.getElementById('csh-hint')!.textContent = `Stroke recorded · ${stroke.length} points → snapped to ${sampleStrokeToNotes().length} notes. Press PLAY.`;
      };
      canvas.addEventListener('pointerup', endStroke);
      canvas.addEventListener('pointercancel', endStroke);
      canvas.addEventListener('pointerleave', endStroke);

      document.getElementById('csh-key-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-key]');
        if (!btn) return;
        currentKey = btn.getAttribute('data-key') as KeyKey;
        syncChips();
        drawCanvas();
      });
      document.getElementById('csh-voice-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-voice]');
        if (!btn) return;
        voice = btn.getAttribute('data-voice') as Voice;
        syncChips();
      });
      const tempoSlider = document.getElementById('csh-tempo') as HTMLInputElement;
      tempoSlider.addEventListener('input', () => {
        tempo = parseInt(tempoSlider.value);
        document.getElementById('csh-tempo-val')!.textContent = String(tempo);
      });

      document.getElementById('csh-play')!.addEventListener('click', () => {
        if (playing) stopPlayback();
        else startPlayback();
      });
      document.getElementById('csh-clear')!.addEventListener('click', () => {
        stroke = [];
        document.getElementById('csh-hint')!.textContent = 'Click and drag to start drawing.';
        drawCanvas();
      });
      document.getElementById('csh-share')!.addEventListener('click', async () => {
        setHashState();
        try {
          await navigator.clipboard.writeText(location.href);
          const s = document.getElementById('csh-share-status')!;
          s.textContent = 'copied to clipboard';
          setTimeout(() => { s.textContent = ''; }, 2200);
        } catch {
          const s = document.getElementById('csh-share-status')!;
          s.textContent = 'URL updated — copy from address bar';
          setTimeout(() => { s.textContent = ''; }, 3500);
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) stopPlayback();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
