---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CORRIDOR_SOUTH_ANCHOR, FIRST_NINETY_DAYS_PLAN, INHERITED_FROM_ES, INSTANCE_META, INSTANCE_NOTES, RB_SIX_SHAPES, RB_SNAPSHOT, RB_SPECIFIC_TERRAIN, REFERENCES } from '../lib/redondoBeach';
const title = `${INSTANCE_META.title} — ${INSTANCE_META.subtitle}`;
const description = INSTANCE_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/redondo-beach', name: INSTANCE_META.title, description, url: 'https://pointcast.xyz/redondo-beach', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const statusColor: Record<string, string> = { shipping: '#2d6a3d', building: '#d4a534', forming: '#b85a3a', dormant: '#5a5450', speculative: '#a8a39a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/redondo-beach.json', title: 'Redondo Beach instance (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/strand-corridor">strand-corridor</a><span aria-hidden="true">/</span><span>redondo-beach</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{INSTANCE_META.paperNumber} · THIRD CONCRETE FORK · CORRIDOR SOUTH ANCHOR</p>
      <h1>REDONDO / BEACH.</h1>
      <p class="subtitle">{INSTANCE_META.subtitle}</p>
      <p class="thesis">{INSTANCE_META.thesis}</p>
    </header>

    <section class="snapshot"><p class="kicker">SNAPSHOT</p><h2>Redondo Beach at a glance.</h2>
      <dl class="snap-dl">
        <div><dt>Population</dt><dd>{RB_SNAPSHOT.population}</dd></div>
        <div><dt>Geography</dt><dd>{RB_SNAPSHOT.geography}</dd></div>
        <div><dt>Borders</dt><dd>{RB_SNAPSHOT.borders}</dd></div>
        <div><dt>Median income</dt><dd>{RB_SNAPSHOT.medianIncome}</dd></div>
        <div><dt>Tech density</dt><dd>{RB_SNAPSHOT.techDensity}</dd></div>
        <div><dt>Strand frontage</dt><dd>{RB_SNAPSHOT.beachCorridor}</dd></div>
        <div><dt>Parkland</dt><dd>{RB_SNAPSHOT.parksAcres}</dd></div>
        <div><dt>Existing civic</dt><dd>{RB_SNAPSHOT.existingCivic}</dd></div>
      </dl>
    </section>

    <section class="inherited"><p class="kicker">INHERITED FROM EL SEGUNDO · 8 ITEMS</p><h2>What RB starts with.</h2>
      <ol class="inh-list">{INHERITED_FROM_ES.map((i) => (
        <li><h3>{i.item}</h3><p>{i.detail}</p></li>
      ))}</ol>
    </section>

    <section class="terrain"><p class="kicker">RB-SPECIFIC TERRAIN · 7 FEATURES</p><h2>Where RB differs.</h2>
      <ol class="ter-list">{RB_SPECIFIC_TERRAIN.map((t) => (
        <li>
          <h3>{t.feature}</h3>
          <p class="ter__ues"><strong>ES analogue:</strong> {t.uesAnalogue}</p>
          <p class="ter__diff"><strong>RB difference:</strong> {t.rbDifference}</p>
        </li>
      ))}</ol>
    </section>

    <section class="shapes"><p class="kicker">SIX-SHAPE STATUS · RB</p><h2>What ships first.</h2>
      <ol class="shape-list">{RB_SIX_SHAPES.map((s) => (
        <li class={`sh sh--${s.rbStatus}`}>
          <div class="sh__head">
            <span class="sh__num">{String(s.number).padStart(2,'0')}</span>
            <h3>{s.name}</h3>
            <span class="sh__status" style={`background: ${statusColor[s.rbStatus]};`}>{s.rbStatus.toUpperCase()}</span>
          </div>
          <p><strong>Starting point:</strong> {s.startingPoint}</p>
          <p><strong>First 90 days:</strong> {s.firstNinetyDays}</p>
        </li>
      ))}</ol>
    </section>

    <section class="plan"><p class="kicker">13-WEEK PLAN · DAY 0 → DAY 90</p><h2>What the local Land would do.</h2>
      <ol class="plan-list">{FIRST_NINETY_DAYS_PLAN.map((p) => (
        <li>
          <span class="plan__week">WEEK {p.week}</span>
          <div>
            <h3>{p.milestone}</h3>
            <p>{p.detail}</p>
          </div>
        </li>
      ))}</ol>
    </section>

    <section class="strand"><p class="kicker">CORRIDOR · SOUTH ANCHOR POSITION</p><h2>Why Redondo is the corridor's south anchor.</h2>
      <p class="lede">{CORRIDOR_SOUTH_ANCHOR.thesis}</p>
      <h3 class="strand-h">Why the south anchor matters</h3>
      <ol class="strand-list">{CORRIDOR_SOUTH_ANCHOR.whyAnchorMatters.map((e) => (<li>{e}</li>))}</ol>
      <p class="strand__parallel"><strong>Parallel to the cases:</strong> {CORRIDOR_SOUTH_ANCHOR.parallelToCases}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · LOCAL LAND CALL</p>
      <p>{INSTANCE_NOTES.uesNote}</p>
      <p class="invite-cta">{INSTANCE_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/forkable-radius">The Forkable Radius · framework</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/manhattan-beach">Manhattan Beach (UES-Fork-MB-01)</a>
      <a href="/hermosa-beach">Hermosa Beach (UES-Fork-HB-02)</a>
      <a href="/forkable-template">Fork-this-repo guide</a>
      <a href="/redondo-beach.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --rb-ink:#1a1a1a; --rb-paper:#fdf9ee; --rb-mustard:#d4a534; --rb-rust:#b85a3a; --rb-sage:#2d6a3d; --rb-strand:#5b8aa8; --rb-harbor:#3d6a8a; --rb-fog:#d8d2c4; --rb-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--rb-paper); color: var(--rb-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--rb-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--rb-harbor); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--rb-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--rb-harbor); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 96px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--rb-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  .lede { font-size: 15px; line-height: 1.6; margin: 0 0 16px; max-width: 72ch; }

  .snapshot { background: linear-gradient(135deg, #fff, var(--rb-paper)); }
  .snap-dl { margin: 0; display: grid; gap: 6px; }
  .snap-dl > div { display: grid; grid-template-columns: 160px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--rb-ink); }
  .snap-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--rb-harbor); padding-top: 2px; }
  .snap-dl dd { margin: 0; font-size: 14px; line-height: 1.55; }

  .inh-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .inh-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--rb-ink); border-left: 6px solid var(--rb-sage); }
  .inh-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 6px; font-weight: 700; }
  .inh-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .ter-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ter-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--rb-ink); border-left: 8px solid var(--rb-harbor); }
  .ter-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }
  .ter-list p { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .ter__ues { padding: 6px 10px; background: var(--rb-paper); border-left: 3px solid var(--rb-fog); font-size: 12.5px !important; }
  .ter__diff { padding: 6px 10px; background: var(--rb-paper); border-left: 3px solid var(--rb-rust); font-size: 12.5px !important; }
  strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--rb-harbor); margin-right: 4px; }

  .shape-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sh { padding: 12px 14px; background: #fff; border: 2px solid var(--rb-ink); border-left: 8px solid var(--rb-fog); }
  .sh--shipping { border-left-color: var(--rb-sage); }
  .sh--building { border-left-color: var(--rb-mustard); }
  .sh--forming { border-left-color: var(--rb-rust); }
  .sh--dormant { border-left-color: var(--rb-slate); }
  .sh--speculative { border-left-color: var(--rb-fog); }
  .sh__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
  .sh__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--rb-harbor); }
  .sh h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0; font-weight: 700; flex: 1; }
  .sh__status { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; padding: 2px 6px; color: #fff; }
  .sh p { margin: 0 0 4px; font-size: 12.5px; line-height: 1.5; }

  .plan-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .plan-list li { display: grid; grid-template-columns: 80px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--rb-ink); border-left: 6px solid var(--rb-mustard); align-items: baseline; }
  .plan__week { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--rb-rust); padding: 2px 6px; background: var(--rb-paper); display: inline-block; }
  .plan-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 4px; font-weight: 700; }
  .plan-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .strand { background: linear-gradient(180deg, var(--rb-paper), #fff); border-top: 8px solid var(--rb-harbor); }
  .strand-h { font-family: var(--pc-font-mono); font-size: 13px; margin: 16px 0 8px; font-weight: 700; text-transform: uppercase; color: var(--rb-harbor); }
  .strand-list { list-style: decimal; padding-left: 22px; margin: 0 0 14px; font-size: 14px; line-height: 1.55; }
  .strand-list li { margin-bottom: 6px; }
  .strand__parallel { padding: 12px 14px; background: var(--rb-paper); border-left: 4px solid var(--rb-harbor); font-size: 13.5px; line-height: 1.55; }

  .invitation { background: var(--rb-harbor); color: var(--rb-paper); border-top-color: var(--rb-harbor); }
  .invitation .kicker { background: var(--rb-mustard); color: var(--rb-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--rb-mustard); color: var(--rb-ink); border-left: 4px solid var(--rb-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--rb-harbor); color: var(--rb-paper); text-decoration: none; }
  .links a:hover { background: var(--rb-rust); }

  @media (max-width: 800px) { h1 { font-size: 64px; } .inh-list { grid-template-columns: 1fr; } .snap-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } .plan-list li { grid-template-columns: 1fr; } }
</style>
