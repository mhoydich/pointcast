---
/**
 * /drum-kit — drum buttons anyone can add to their own site.
 *
 * Pick a look, name your surface, copy two lines. Every button is a real
 * drum: its beats land on the one PointCast counter and show up on
 * /drum-signal tagged with the app (and place) the button was given.
 *
 * Renderer: public/drum.js (<pointcast-drum> custom element, shadow DOM).
 * The previews on this page are tagged app="drum-kit" so they don't pose
 * as someone else's site on the signal board.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Drum Kit';
const description =
  'Drum buttons anyone can add to their site: a round drum, a pill, an 88×31 web badge, a Noun, or an inline mini. Every beat counts on the PointCast drum.';

const looks = [
  { id: 'round', name: 'Round', note: 'The drum from /drum, any size.' },
  { id: 'pill', name: 'Pill', note: 'A small button with the live count.' },
  { id: 'badge', name: '88×31 badge', note: 'Old-web button for a footer or links page.' },
  { id: 'noun', name: 'Noun', note: 'Any of the 1,200 Nouns as your drum.' },
  { id: 'mini', name: 'Mini', note: 'Sits inline in a sentence.' },
];
---

<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dk">
    <header class="dk__bar">
      <span>PointCast · Drum Kit</span>
      <a href="/drum-signal">Signal board →</a>
    </header>

    <section class="dk__intro">
      <h1>Put the drum on your site.</h1>
      <p>
        Pick a look, give it your site's name, and paste two lines. Every tap on your button is a real beat
        on the one PointCast drum, and it shows up on the <a href="/drum-signal">signal board</a> with your
        name on it. No account, no cookies, no tracking — just counts.
      </p>
    </section>

    <section class="dk__looks" aria-label="Button looks">
      {looks.map((look) => (
        <div class="dk__look" data-look={look.id} data-selected={look.id === 'round' ? 'true' : 'false'}>
          <span class="dk__stage">
            {look.id === 'mini'
              ? <span class="dk__sentence">the beat goes <pointcast-drum look="mini" app="drum-kit" /> on</span>
              : <pointcast-drum look={look.id} app="drum-kit" size="84" />}
          </span>
          <span class="dk__lname">{look.name}</span>
          <span class="dk__lnote">{look.note}</span>
          <button class="dk__pick" type="button" data-pick={look.id}>Use {look.name.toLowerCase()}</button>
        </div>
      ))}
    </section>

    <section class="dk__maker">
      <form class="dk__form" data-dk-form>
        <h2>Your button</h2>
        <label>Site or app name
          <input name="app" placeholder="my-site" maxlength="48" autocomplete="off" />
          <small>How your beats are labeled on the signal board. Left blank, your domain name is used.</small>
        </label>
        <label>Place <span>(optional)</span>
          <input name="place" placeholder="el-segundo" maxlength="32" autocomplete="off" />
          <small>A town, a court, a shop. Left blank, only a country code is recorded.</small>
        </label>
        <div class="dk__row">
          <label>Look
            <select name="look">
              {looks.map((look) => <option value={look.id}>{look.name}</option>)}
            </select>
          </label>
          <label data-for="size">Size (px)
            <input name="size" type="number" min="40" max="320" value="96" />
          </label>
          <label data-for="noun">Noun #
            <input name="noun" type="number" min="0" max="1199" value="253" />
          </label>
          <label data-for="label">Label
            <input name="label" placeholder="drum" maxlength="24" />
          </label>
        </div>
        <div class="dk__checks">
          <label><input type="checkbox" name="count" checked /> Show the live count</label>
          <label><input type="checkbox" name="sound" checked /> Play a thump</label>
        </div>
      </form>

      <div class="dk__out">
        <div class="dk__preview" data-dk-preview aria-live="polite"></div>
        <p class="dk__previewnote">Preview is live — taps here count as <code>drum-kit</code>.</p>
        <div class="dk__code">
          <div class="dk__codebar">
            <span>Paste this where the button should go</span>
            <button type="button" data-dk-copy>Copy</button>
          </div>
          <pre><code data-dk-snippet></code></pre>
        </div>
        <details class="dk__more">
          <summary>No custom elements? Plain HTML works too.</summary>
          <pre><code>{`<script src="https://pointcast.xyz/drum.js" data-app="my-site" async></script>
<button data-pointcast-drum>drum</button>
<span data-pointcast-drum-count></span> beats`}</code></pre>
          <p>Or float a round drum in the corner of every page with <code>data-button="true"</code> on the script tag.
            Building your own UI? Send beats with <code>PointCastDrum.beat()</code>, or POST to
            <code>/api/drum/signal</code> — see the <a href="/drum-signal">signal board</a>.</p>
        </details>
      </div>
    </section>
  </main>

  <script is:inline src="/drum.js" data-app="drum-kit"></script>

  <style is:global>
    body:has(.dk) { background: #fbf6ef; }
    .dk {
      --ink: #12110e; --muted: #6b6a66; --soft: #e6e0d6; --red: #e0452b; --paper: #fffdf9;
      max-width: 1080px; margin: 24px auto 64px; padding: 0 16px; color: var(--ink);
      font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
    }
    .dk code, .dk pre { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; }
    .dk__bar {
      display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: var(--ink); color: #fbf6ef;
      padding: 14px 20px; font: 600 12px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .18em; text-transform: uppercase;
    }
    .dk__bar a { color: #ff8a73; }
    .dk__intro { border: 4px solid var(--ink); border-top: 0; background: var(--paper); padding: 28px 28px 24px; }
    .dk__intro h1 { margin: 0 0 10px; font-size: clamp(30px, 5vw, 48px); line-height: 1.05; font-weight: 600; letter-spacing: -.02em; }
    .dk__intro p { margin: 0; max-width: 68ch; font-size: 16px; line-height: 1.6; color: var(--ink); }
    .dk a { color: #185fa5; }
    .dk__looks {
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 4px solid var(--ink); border-top: 0; background: var(--paper);
    }
    .dk__look {
      box-sizing: border-box; display: grid; grid-template-rows: 130px auto 1fr auto; gap: 4px; padding: 16px;
      border-right: 2px solid var(--soft); min-width: 0;
    }
    .dk__pick {
      justify-self: start; margin-top: 8px; font: 600 11px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .08em;
      text-transform: uppercase; padding: 7px 10px; border: 2px solid var(--ink); background: #fff; color: var(--ink); cursor: pointer;
    }
    .dk__look[data-selected="true"] .dk__pick { background: var(--ink); color: #fff; }
    .dk__stage { overflow: hidden; }
    .dk__look:last-child { border-right: 0; }
    .dk__look[data-selected="true"] { background: #fff1e8; box-shadow: inset 0 -5px 0 var(--red); }
    .dk__pick:focus-visible { outline: 3px solid #185fa5; outline-offset: 2px; }
    .dk__stage { display: grid; place-items: center; }
    .dk__sentence { font-size: 15px; }
    .dk__lname { font-weight: 600; font-size: 14px; }
    .dk__lnote { font-size: 12px; color: var(--muted); line-height: 1.4; }
    .dk__maker { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); border: 4px solid var(--ink); border-top: 0; background: var(--paper); }
    .dk__form { padding: 24px; border-right: 4px solid var(--ink); display: grid; gap: 16px; align-content: start; }
    .dk__form h2, .dk__codebar span {
      margin: 0; font: 600 12px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase;
    }
    .dk__form label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; }
    .dk__form label span { font-weight: 400; color: var(--muted); }
    .dk__form small { font-weight: 400; color: var(--muted); font-size: 12px; line-height: 1.4; }
    .dk__form input:not([type="checkbox"]), .dk__form select {
      font: 15px/1.2 'Inter', system-ui, sans-serif; padding: 9px 10px; border: 2px solid var(--ink); border-radius: 0; background: #fff; color: var(--ink); min-width: 0;
    }
    .dk__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .dk__row label[hidden] { display: none; }
    .dk__checks { display: flex; gap: 18px; flex-wrap: wrap; }
    .dk__checks label { display: flex; gap: 8px; align-items: center; font-weight: 500; }
    .dk__out { padding: 24px; display: grid; gap: 14px; align-content: start; min-width: 0; }
    .dk__preview {
      min-height: 180px; display: grid; place-items: center; border: 2px dashed var(--soft);
      background: repeating-linear-gradient(45deg, #fff, #fff 12px, #fbf8f3 12px, #fbf8f3 24px); padding: 16px; font-size: 16px;
    }
    .dk__previewnote { margin: -6px 0 0; font-size: 12px; color: var(--muted); }
    .dk__code { border: 2px solid var(--ink); min-width: 0; }
    .dk__codebar { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 2px solid var(--ink); }
    .dk__codebar button {
      font: 600 12px/1 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase;
      padding: 8px 12px; background: var(--red); color: #fff; border: 2px solid var(--ink); cursor: pointer;
    }
    .dk pre { margin: 0; padding: 14px; background: var(--ink); color: #fbf6ef; font-size: 12px; line-height: 1.6; overflow-x: auto; white-space: pre; }
    .dk__more { font-size: 14px; line-height: 1.6; }
    .dk__more summary { cursor: pointer; font-weight: 600; }
    .dk__more pre { margin-top: 10px; }
    .dk__more code:not(pre code) { background: var(--soft); padding: 1px 4px; font-size: 13px; }
    @media (max-width: 860px) {
      .dk__looks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .dk__look { border-bottom: 2px solid var(--soft); }
      .dk__maker { grid-template-columns: 1fr; }
      .dk__form { border-right: 0; border-bottom: 4px solid var(--ink); }
      .dk__intro, .dk__form, .dk__out { padding-left: 16px; padding-right: 16px; }
    }
    @media (max-width: 480px) {
      .dk__looks { grid-template-columns: 1fr; }
      .dk__look { border-right: 0; grid-template-rows: 120px auto auto auto; }
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('.dk');
      if (!root) return;
      const form = root.querySelector('[data-dk-form]');
      const preview = root.querySelector('[data-dk-preview]');
      const snippetEl = root.querySelector('[data-dk-snippet]');
      const copyBtn = root.querySelector('[data-dk-copy]');
      const lookCards = [...root.querySelectorAll('.dk__look')];

      const slug = (v, max) => String(v || '').toLowerCase().trim().replace(/[^a-z0-9._/:-]+/g, '-').replace(/^-+|-+$/g, '').slice(0, max);
      const esc = (v) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

      function state() {
        const f = new FormData(form);
        return {
          app: slug(f.get('app'), 48),
          place: slug(f.get('place'), 32),
          look: String(f.get('look') || 'round'),
          size: Math.max(40, Math.min(320, Number(f.get('size')) || 96)),
          noun: Math.max(0, Math.min(1199, Math.floor(Number(f.get('noun')) || 0))),
          label: String(f.get('label') || '').slice(0, 24),
          count: f.get('count') === 'on',
          sound: f.get('sound') === 'on',
        };
      }

      function attrs(s, forPreview) {
        const out = [['look', s.look]];
        if ((s.look === 'round' || s.look === 'noun') && s.size !== 96) out.push(['size', s.size]);
        if (s.look === 'noun') out.push(['noun', s.noun]);
        if ((s.look === 'pill' || s.look === 'mini') && s.label) out.push(['label', s.label]);
        if (forPreview) out.push(['app', 'drum-kit']);
        else if (s.place) out.push(['place', s.place]);
        if (!s.count) out.push(['count', 'false']);
        if (!s.sound) out.push(['sound', 'false']);
        return out;
      }

      function render() {
        const s = state();
        for (const name of ['size', 'noun', 'label']) {
          const field = form.querySelector(`[data-for="${name}"]`);
          field.hidden = name === 'size' ? !(s.look === 'round' || s.look === 'noun')
            : name === 'noun' ? s.look !== 'noun'
            : !(s.look === 'pill' || s.look === 'mini');
        }
        for (const card of lookCards) {
          const on = card.dataset.look === s.look;
          card.dataset.selected = String(on);
          card.querySelector('.dk__pick').setAttribute('aria-pressed', String(on));
        }

        const el = document.createElement('pointcast-drum');
        for (const [k, v] of attrs(s, true)) el.setAttribute(k, String(v));
        preview.replaceChildren();
        if (s.look === 'mini') {
          const p = document.createElement('span');
          p.append('the beat goes ', el, ' on');
          preview.append(p);
        } else preview.append(el);

        const scriptAttrs = [`src="https://pointcast.xyz/drum.js"`];
        if (s.app) scriptAttrs.push(`data-app="${esc(s.app)}"`);
        scriptAttrs.push('async');
        const tag = '<pointcast-drum ' + attrs(s, false).map(([k, v]) => `${k}="${esc(v)}"`).join(' ') + '></pointcast-drum>';
        snippetEl.textContent = `<script ${scriptAttrs.join(' ')}></` + `script>\n${tag}`;
      }

      form.addEventListener('input', render);
      form.addEventListener('change', render);
      form.addEventListener('submit', (e) => e.preventDefault());
      for (const card of lookCards) {
        card.querySelector('.dk__pick').addEventListener('click', () => {
          form.elements.look.value = card.dataset.look;
          render();
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(snippetEl.textContent);
          copyBtn.textContent = 'Copied';
        } catch {
          const range = document.createRange();
          range.selectNodeContents(snippetEl);
          getSelection().removeAllRanges();
          getSelection().addRange(range);
          copyBtn.textContent = 'Selected';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      render();
    })();
  </script>
</BlockLayout>
