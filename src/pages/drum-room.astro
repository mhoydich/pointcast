---
/**
 * /drum-room — mobile-first 3D multiplayer drum chamber.
 *
 * One URL room code maps to one hibernating Durable Object. The browser
 * renders locally synthesized audio and small Three.js gestures; the wire
 * only carries bounded hits, reactions, and anonymous Noun-style presence.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'The 3D Drum Room';
const description =
  'Enter a shared 3D PointCast drum circle. Up to 100 visitors can play a pleasant browser-native kit together over WebSockets.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'PointCast 3D Drum Room',
  url: 'https://pointcast.xyz/drum-room',
  description,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Collaborative music room',
  operatingSystem: 'Any modern web browser',
  isAccessibleForFree: true,
  browserRequirements: 'JavaScript, WebSocket, Web Audio; WebGL optional',
  featureList: [
    '100 visitor live room target',
    'Mobile-first 3D drum circle',
    'Six pleasant synthesized drum voices',
    'Anonymous Noun-style presence',
    'Native invite sharing and downloadable invite card',
    'Reduced-motion and quiet-entry modes',
  ],
};
---

<BlockLayout
  title={title}
  description={description}
  image="/images/og-drum.svg"
  themeColor="#080a12"
  immersive
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/drum-room.json', title: '3D Drum Room protocol and discovery JSON' }]}
>
  <main class="d3" id="d3-app" data-room="lobby">
    <canvas id="d3-canvas" class="d3__canvas" aria-hidden="true"></canvas>
    <div class="d3__fallback" id="d3-fallback" aria-hidden="true">
      <div class="d3__fallback-stage" id="d3-fallback-stage"></div>
      <div class="d3__fallback-ring"></div>
    </div>
    <div class="d3__wash" aria-hidden="true"></div>

    <header class="d3__topbar">
      <a class="d3__brand" href="/drum" aria-label="Back to the PointCast drum universe">
        <span>POINTCAST</span><b>DRUM ROOM</b>
      </a>
      <div class="d3__meter" aria-label="Live room attendance">
        <span class="d3__live-dot" id="d3-live-dot"></span>
        <strong id="d3-count">0</strong><span>/ 100 HERE</span>
        <i><span id="d3-progress"></span></i>
      </div>
      <div class="d3__top-actions">
        <button id="d3-audio" class="d3__chip" type="button" aria-pressed="false">SOUND OFF</button>
        <button id="d3-invite" class="d3__chip d3__chip--hot" type="button">INVITE</button>
      </div>
    </header>

    <div class="d3__room-label" aria-live="polite">
      <span>ROOM</span><strong id="d3-room-code">LOBBY</strong><em id="d3-status">CONNECTING</em>
    </div>

    <section class="d3__stage-copy" aria-label="Room orientation">
      <p>DRAG TO LOOK AROUND · TAP THE FLOOR DRUMS</p>
      <strong id="d3-last-hit">THE ROOM IS LISTENING</strong>
    </section>

    <aside class="d3__reactions" aria-label="Send a room reaction">
      <span>REACT</span>
      <button type="button" data-reaction="✦" aria-label="Send sparkle">✦</button>
      <button type="button" data-reaction="♥" aria-label="Send heart">♥</button>
      <button type="button" data-reaction="🔥" aria-label="Send fire">🔥</button>
      <button type="button" data-reaction="🪩" aria-label="Send disco ball">🪩</button>
    </aside>

    <section class="d3__pads" aria-label="Drum pads">
      <button class="d3__pad d3__pad--kick" type="button" data-pad="kick"><kbd>1</kbd><strong>KICK</strong><span>LOW / ROUND</span></button>
      <button class="d3__pad d3__pad--snare" type="button" data-pad="snare"><kbd>2</kbd><strong>SNARE</strong><span>DRY / SOFT</span></button>
      <button class="d3__pad d3__pad--hat" type="button" data-pad="hat"><kbd>3</kbd><strong>HAT</strong><span>AIR / TICK</span></button>
      <button class="d3__pad d3__pad--tom" type="button" data-pad="tom"><kbd>4</kbd><strong>TOM</strong><span>WARM / DEEP</span></button>
      <button class="d3__pad d3__pad--clap" type="button" data-pad="clap"><kbd>5</kbd><strong>CLAP</strong><span>WIDE / HUMAN</span></button>
      <button class="d3__pad d3__pad--bell" type="button" data-pad="bell"><kbd>6</kbd><strong>BELL</strong><span>GOLD / LONG</span></button>
    </section>

    <section class="d3__gate" id="d3-gate" aria-labelledby="d3-gate-title">
      <div class="d3__gate-card">
        <p class="d3__eyebrow">POINTCAST · LIVE WEB AUDIO · ROOM <span data-room-label>LOBBY</span></p>
        <div class="d3__gate-art" aria-hidden="true">
          <span class="d3__gate-orbit"></span>
          <span class="d3__glasses"><i></i><i></i></span>
          <b>100</b>
        </div>
        <h1 id="d3-gate-title">THE 3D<br />DRUM ROOM</h1>
        <p class="d3__gate-dek">A shared drum circle in your browser. Six friendly sounds, anonymous Noun visitors, and room for one hundred people at once.</p>
        <div class="d3__gate-actions">
          <button id="d3-enter-sound" type="button">ENTER WITH SOUND <span>↗</span></button>
          <button id="d3-enter-quiet" type="button">ENTER QUIETLY</button>
        </div>
        <p class="d3__gate-note">Headphones nice, never required. No account, wallet, microphone, or personal profile.</p>
      </div>
    </section>

    <dialog class="d3__invite" id="d3-invite-dialog" aria-labelledby="d3-invite-title">
      <form method="dialog"><button class="d3__close" aria-label="Close invite card">×</button></form>
      <div class="d3__invite-card" id="d3-invite-card">
        <div class="d3__invite-noise"></div>
        <p>POINTCAST INVITES YOU TO</p>
        <h2 id="d3-invite-title">THE 3D<br />DRUM ROOM</h2>
        <div class="d3__invite-art" aria-hidden="true">
          <span></span><span></span><span></span>
          <b>100<br /><small>CAN PLAY</small></b>
        </div>
        <div class="d3__invite-foot">
          <strong>ROOM <span data-room-label>LOBBY</span></strong>
          <em>pointcast.xyz/drum-room</em>
        </div>
      </div>
      <div class="d3__invite-actions">
        <button id="d3-share" type="button">SHARE INVITE</button>
        <button id="d3-copy" type="button">COPY LINK</button>
        <button id="d3-download" type="button">SAVE CARD</button>
      </div>
      <p class="d3__invite-status" id="d3-invite-status" aria-live="polite">Bring a phone. Bring a friend. Bring a beat.</p>
    </dialog>

    <div class="d3__toast-layer" id="d3-toast-layer" aria-live="polite"></div>
    <div class="d3__sr" id="d3-announcer" aria-live="polite"></div>
  </main>
</BlockLayout>

<style is:global>
  :root { color-scheme: dark; }
  html:has(#d3-app), body:has(#d3-app) { background: #080a12; overflow: hidden; overscroll-behavior: none; }
  body:has(#d3-app) { min-height: 100svh; }
  body:has(#d3-app) > .skip-link { z-index: 50; }
  #main-content:has(#d3-app) { min-height: 100svh; }

  .d3 {
    --cream: #fff7df;
    --muted: #b4b3c4;
    --line: rgba(255,255,255,.17);
    --blue: #5be7ff;
    --yellow: #ffd448;
    --coral: #ff6f61;
    --violet: #9a7dff;
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 540px;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(circle at 50% 42%, #212545 0%, #0e1020 42%, #070810 76%);
    color: var(--cream);
    font-family: var(--pc-font-sans, system-ui, sans-serif);
    touch-action: none;
  }
  .d3 button, .d3 a { -webkit-tap-highlight-color: transparent; }
  .d3__canvas, .d3__fallback, .d3__wash { position: absolute; inset: 0; width: 100%; height: 100%; }
  .d3__canvas { z-index: 0; display: block; touch-action: none; }
  .d3__fallback { display: none; z-index: 0; perspective: 700px; background: radial-gradient(circle at 50% 44%, #242849, #080a12 70%); }
  .d3[data-fallback="true"] .d3__canvas { display: none; }
  .d3[data-fallback="true"] .d3__fallback { display: block; }
  .d3__fallback-ring { position: absolute; width: min(68vw, 480px); aspect-ratio: 1; left: 50%; top: 48%; transform: translate(-50%,-50%) rotateX(66deg); border: 18px solid rgba(91,231,255,.12); border-radius: 50%; box-shadow: 0 0 80px rgba(154,125,255,.28), inset 0 0 90px rgba(255,212,72,.12); }
  .d3__fallback-person { position: absolute; left: 50%; top: 47%; width: 10px; height: 10px; border-radius: 50%; background: hsl(var(--hue) 90% 65%); box-shadow: 0 0 18px hsl(var(--hue) 90% 65%); transform: translate(calc(-50% + var(--x)),calc(-50% + var(--y))); }
  .d3__wash { z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(4,5,10,.76) 0, transparent 18%, transparent 58%, rgba(4,5,10,.94) 100%); }

  .d3__topbar { position: absolute; z-index: 8; top: 0; left: 0; right: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; padding: max(14px, env(safe-area-inset-top)) clamp(14px, 3vw, 42px) 12px; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, rgba(5,6,12,.78), rgba(5,6,12,.18)); backdrop-filter: blur(14px); }
  .d3__brand { color: var(--cream); display: inline-flex; flex-direction: column; gap: 2px; width: max-content; font-size: 11px; letter-spacing: .16em; line-height: 1; text-decoration: none !important; }
  .d3__brand span { font-weight: 500; }
  .d3__brand b { color: var(--blue); font-family: var(--pc-font-mono); font-size: 8px; letter-spacing: .22em; }
  .d3__meter { display: grid; grid-template-columns: auto auto auto; align-items: baseline; column-gap: 5px; min-width: 170px; text-align: center; font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .12em; color: var(--muted); }
  .d3__meter strong { color: var(--cream); font-size: 18px; letter-spacing: 0; }
  .d3__meter i { grid-column: 1 / -1; position: relative; height: 3px; margin-top: 5px; background: rgba(255,255,255,.12); overflow: hidden; }
  .d3__meter i span { display: block; width: 0%; height: 100%; background: linear-gradient(90deg,var(--blue),var(--yellow),var(--coral)); transition: width .5s ease; }
  .d3__live-dot { width: 7px; height: 7px; border-radius: 50%; background: #707381; box-shadow: 0 0 0 transparent; }
  .d3[data-network="live"] .d3__live-dot { background: #55f39a; box-shadow: 0 0 12px #55f39a; animation: d3-live 1.7s ease-in-out infinite; }
  @keyframes d3-live { 50% { opacity: .42; } }
  .d3__top-actions { justify-self: end; display: flex; gap: 8px; }
  .d3__chip { border: 1px solid var(--line); background: rgba(8,10,18,.58); color: var(--cream); min-height: 34px; padding: 0 12px; border-radius: 999px; font: 500 8px/1 var(--pc-font-mono); letter-spacing: .12em; cursor: pointer; }
  .d3__chip--hot { color: #080a12; background: var(--yellow); border-color: var(--yellow); }

  .d3__room-label { position: absolute; z-index: 5; top: 94px; left: clamp(14px, 3vw, 42px); display: flex; align-items: center; gap: 9px; font-family: var(--pc-font-mono); font-size: 8px; letter-spacing: .14em; color: var(--muted); }
  .d3__room-label strong { color: var(--yellow); font-size: 10px; }
  .d3__room-label em { padding-left: 9px; border-left: 1px solid var(--line); color: #777b89; font-style: normal; }
  .d3[data-network="live"] .d3__room-label em { color: #55f39a; }

  .d3__stage-copy { position: absolute; z-index: 3; left: 50%; top: 20%; transform: translateX(-50%); width: min(90vw, 620px); text-align: center; pointer-events: none; text-shadow: 0 2px 18px #060710; }
  .d3__stage-copy p { margin: 0 0 7px; font: 400 8px/1.4 var(--pc-font-mono); letter-spacing: .2em; color: rgba(255,255,255,.42); }
  .d3__stage-copy strong { display: block; font-size: clamp(12px, 1.5vw, 16px); font-weight: 500; letter-spacing: .08em; color: rgba(255,247,223,.9); transition: color .18s, transform .18s; }
  .d3__stage-copy strong[data-flash="true"] { color: var(--yellow); transform: scale(1.04); }

  .d3__reactions { position: absolute; z-index: 7; right: clamp(14px, 3vw, 42px); top: 96px; display: flex; align-items: center; gap: 5px; }
  .d3__reactions span { margin-right: 3px; font: 400 7px/1 var(--pc-font-mono); letter-spacing: .16em; color: rgba(255,255,255,.4); }
  .d3__reactions button { width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 50%; background: rgba(8,10,18,.52); color: var(--cream); cursor: pointer; font-size: 14px; backdrop-filter: blur(8px); }
  .d3__reactions button:active { transform: scale(.9); }

  .d3__pads { position: absolute; z-index: 7; left: 50%; bottom: max(18px, env(safe-area-inset-bottom)); transform: translateX(-50%); display: grid; grid-template-columns: repeat(6, minmax(74px, 108px)); gap: 7px; width: max-content; max-width: calc(100vw - 24px); }
  .d3__pad { --pad: var(--blue); position: relative; display: grid; grid-template-columns: 1fr auto; align-items: end; min-height: 72px; padding: 10px; border: 1px solid color-mix(in srgb, var(--pad) 52%, transparent); border-radius: 10px; overflow: hidden; background: linear-gradient(145deg,color-mix(in srgb,var(--pad) 18%,rgba(8,10,18,.94)),rgba(8,10,18,.9)); color: var(--cream); text-align: left; cursor: pointer; box-shadow: inset 0 0 28px rgba(255,255,255,.025), 0 8px 30px rgba(0,0,0,.24); backdrop-filter: blur(10px); touch-action: manipulation; }
  .d3__pad::before { content: ''; position: absolute; inset: 0; opacity: 0; background: radial-gradient(circle at 50% 80%,var(--pad),transparent 66%); transition: opacity .12s; }
  .d3__pad[data-hit="true"] { transform: translateY(2px) scale(.98); border-color: var(--cream); }
  .d3__pad[data-hit="true"]::before { opacity: .62; }
  .d3__pad kbd { align-self: start; font: 400 8px/1 var(--pc-font-mono); color: color-mix(in srgb,var(--pad) 80%,white); }
  .d3__pad strong { grid-column: 1 / -1; position: relative; font-size: 12px; letter-spacing: .07em; }
  .d3__pad span { grid-column: 1 / -1; position: relative; margin-top: 2px; font: 400 6px/1 var(--pc-font-mono); letter-spacing: .12em; color: var(--muted); }
  .d3__pad--kick { --pad: #5be7ff; } .d3__pad--snare { --pad: #ff6f61; } .d3__pad--hat { --pad: #fff7df; }
  .d3__pad--tom { --pad: #9a7dff; } .d3__pad--clap { --pad: #ff8fc5; } .d3__pad--bell { --pad: #ffd448; }

  .d3__gate { position: absolute; z-index: 20; inset: 0; display: grid; place-items: center; overflow-y: auto; padding: max(22px, env(safe-area-inset-top)) 16px max(22px, env(safe-area-inset-bottom)); background: radial-gradient(circle at 70% 25%,rgba(91,231,255,.17),transparent 34%), radial-gradient(circle at 15% 75%,rgba(255,111,97,.16),transparent 34%), rgba(5,6,12,.9); backdrop-filter: blur(18px); transition: opacity .45s ease, visibility .45s; touch-action: pan-y; }
  .d3__gate[data-open="false"] { opacity: 0; visibility: hidden; pointer-events: none; }
  .d3__gate-card { position: relative; width: min(100%, 720px); min-height: min(720px, calc(100svh - 44px)); padding: clamp(22px, 5vw, 56px); border: 1px solid rgba(255,255,255,.24); border-radius: 26px; overflow: hidden; background: linear-gradient(145deg,rgba(25,28,49,.97),rgba(8,10,18,.98)); box-shadow: 0 40px 120px rgba(0,0,0,.55); }
  .d3__eyebrow { margin: 0; font: 400 8px/1.4 var(--pc-font-mono); letter-spacing: .17em; color: var(--blue); }
  .d3__gate h1 { position: relative; z-index: 2; margin: clamp(70px, 14vh, 130px) 0 18px; font-size: clamp(50px, 10vw, 108px); font-weight: 500; line-height: .82; letter-spacing: -.07em; color: var(--cream); }
  .d3__gate-dek { position: relative; z-index: 2; max-width: 530px; margin: 0; color: #cbc9d4; font-size: clamp(14px, 2.1vw, 19px); line-height: 1.45; }
  .d3__gate-art { position: absolute; top: 46px; right: -30px; width: clamp(190px, 38vw, 360px); aspect-ratio: 1; border: 1px solid rgba(255,212,72,.42); border-radius: 50%; background: radial-gradient(circle,rgba(255,212,72,.16),transparent 64%); box-shadow: 0 0 80px rgba(255,212,72,.13); }
  .d3__gate-orbit { position: absolute; inset: 17%; border: 13px solid rgba(154,125,255,.26); border-radius: 50%; transform: rotateX(64deg) rotateZ(-20deg); }
  .d3__glasses { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: flex; gap: 8px; }
  .d3__glasses i { width: clamp(42px, 8vw, 72px); aspect-ratio: 1.18; border: 12px solid var(--cream); background: var(--blue); box-shadow: inset 0 -13px 0 #384bd9; }
  .d3__gate-art b { position: absolute; right: 20%; bottom: 8%; font: 500 clamp(38px,7vw,74px)/1 var(--pc-font-mono); color: var(--yellow); }
  .d3__gate-actions { position: relative; z-index: 2; display: flex; gap: 9px; margin-top: clamp(24px,5vh,48px); }
  .d3__gate-actions button { min-height: 52px; border-radius: 999px; border: 1px solid var(--line); padding: 0 20px; font: 500 10px/1 var(--pc-font-mono); letter-spacing: .1em; cursor: pointer; }
  #d3-enter-sound { flex: 1; border-color: var(--yellow); background: var(--yellow); color: #090a12; display: flex; align-items: center; justify-content: space-between; }
  #d3-enter-quiet { background: transparent; color: var(--cream); }
  .d3__gate-note { position: relative; z-index: 2; margin: 13px 0 0; font: 400 8px/1.4 var(--pc-font-mono); letter-spacing: .05em; color: #858695; }

  .d3__invite { width: min(92vw, 470px); max-width: none; padding: 12px; border: 1px solid rgba(255,255,255,.25); border-radius: 24px; color: var(--cream); background: rgba(8,10,18,.97); box-shadow: 0 36px 120px rgba(0,0,0,.7); }
  .d3__invite::backdrop { background: rgba(3,4,8,.78); backdrop-filter: blur(12px); }
  .d3__close { position: absolute; z-index: 3; top: 20px; right: 20px; width: 34px; height: 34px; border: 0; border-radius: 50%; background: rgba(0,0,0,.36); color: white; font-size: 22px; cursor: pointer; }
  .d3__invite-card { position: relative; aspect-ratio: 4 / 5; padding: 30px; overflow: hidden; border-radius: 15px; background: #ffd448; color: #090a12; }
  .d3__invite-noise { position: absolute; inset: 0; opacity: .16; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E"); mix-blend-mode: multiply; }
  .d3__invite-card > p { position: relative; z-index: 2; margin: 0; font: 500 8px/1 var(--pc-font-mono); letter-spacing: .18em; }
  .d3__invite-card h2 { position: relative; z-index: 2; margin: 20px 0 0; font-size: clamp(43px, 12vw, 68px); font-weight: 500; line-height: .83; letter-spacing: -.075em; }
  .d3__invite-art { position: absolute; width: 78%; aspect-ratio: 1; right: -19%; bottom: 10%; border-radius: 50%; border: 1px solid rgba(9,10,18,.35); }
  .d3__invite-art > span { position: absolute; inset: calc(var(--i, 1) * 12%); border: 12px solid rgba(9,10,18,.13); border-radius: 50%; }
  .d3__invite-art > span:nth-child(1) { --i: 1; border-color: #ff6f61; } .d3__invite-art > span:nth-child(2) { --i: 2; border-color: #5be7ff; } .d3__invite-art > span:nth-child(3) { --i: 3; border-color: #9a7dff; }
  .d3__invite-art b { position: absolute; left: 3%; bottom: 11%; font: 500 74px/.7 var(--pc-font-mono); }
  .d3__invite-art small { font-size: 9px; letter-spacing: .13em; }
  .d3__invite-foot { position: absolute; z-index: 2; left: 30px; right: 30px; bottom: 25px; display: flex; justify-content: space-between; gap: 10px; align-items: end; border-top: 1px solid rgba(9,10,18,.4); padding-top: 10px; }
  .d3__invite-foot strong { font: 500 10px/1 var(--pc-font-mono); letter-spacing: .1em; } .d3__invite-foot em { font: 400 8px/1 var(--pc-font-mono); font-style: normal; }
  .d3__invite-actions { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 6px; padding-top: 8px; }
  .d3__invite-actions button { min-height: 44px; border: 1px solid var(--line); border-radius: 10px; background: #171a29; color: var(--cream); font: 500 8px/1 var(--pc-font-mono); letter-spacing: .08em; cursor: pointer; }
  #d3-share { color: #090a12; background: var(--blue); border-color: var(--blue); }
  .d3__invite-status { margin: 9px 4px 3px; text-align: center; font: 400 8px/1.4 var(--pc-font-mono); color: var(--muted); }

  .d3__toast-layer { position: absolute; z-index: 9; inset: 0; pointer-events: none; overflow: hidden; }
  .d3__toast { position: absolute; left: var(--left); top: var(--top); font-size: clamp(24px,5vw,54px); animation: d3-toast 1.8s ease-out forwards; filter: drop-shadow(0 8px 18px #000); }
  @keyframes d3-toast { from { opacity: 0; transform: translateY(30px) scale(.6) rotate(-8deg); } 25% { opacity: 1; } to { opacity: 0; transform: translateY(-130px) scale(1.25) rotate(8deg); } }
  .d3__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 720px) {
    .d3 { min-height: 600px; }
    .d3__topbar { grid-template-columns: 1fr auto; gap: 8px; padding-inline: 12px; }
    .d3__meter { grid-column: 1 / -1; grid-row: 2; justify-self: stretch; grid-template-columns: auto auto 1fr; text-align: left; min-width: 0; }
    .d3__meter i { grid-column: 3; grid-row: 1; align-self: center; margin: 0 0 0 8px; }
    .d3__top-actions { grid-column: 2; grid-row: 1; }
    .d3__chip { min-height: 31px; padding-inline: 9px; font-size: 7px; }
    .d3__room-label { top: 104px; left: 12px; }
    .d3__reactions { top: 96px; right: 10px; gap: 3px; }
    .d3__reactions span { display: none; }
    .d3__reactions button { width: 28px; height: 28px; font-size: 12px; }
    .d3__stage-copy { top: 24%; }
    .d3__pads { bottom: max(10px, env(safe-area-inset-bottom)); grid-template-columns: repeat(3, minmax(0,1fr)); width: calc(100vw - 20px); gap: 5px; }
    .d3__pad { min-height: 56px; padding: 7px 9px; border-radius: 8px; }
    .d3__pad strong { font-size: 10px; } .d3__pad span { font-size: 5px; }
    .d3__gate-card { min-height: auto; padding: 22px; border-radius: 20px; }
    .d3__gate h1 { margin-top: min(20vh, 128px); font-size: clamp(48px, 17vw, 76px); }
    .d3__gate-art { top: 48px; width: 210px; }
    .d3__glasses i { border-width: 8px; }
    .d3__gate-actions { flex-direction: column; }
    .d3__gate-actions button { width: 100%; }
