  }
</style>

<script>
  import * as THREE from 'three';

  type Pad = 'kick' | 'snare' | 'hat' | 'tom' | 'clap' | 'bell';
  type Person = { id: string; avatar: number; hue: number; joinedAt: number };
  type RoomMessage = {
    v?: number; type?: string; room?: string; connected?: number; target?: number;
    you?: { clientId: string; avatar: number; hue: number };
    people?: Person[]; recentHits?: RoomHit[]; totalHits?: number;
    clientId?: string; avatar?: number; hue?: number; pad?: Pad; velocity?: number;
    seq?: number; serverAt?: number; emoji?: string;
  };
  type RoomHit = { type: 'hit'; id: string; clientId: string; avatar: number; hue: number; pad: Pad; velocity: number; seq: number; serverAt: number };

  const app = document.getElementById('d3-app') as HTMLElement | null;
  const canvas = document.getElementById('d3-canvas') as HTMLCanvasElement | null;
  const fallbackStage = document.getElementById('d3-fallback-stage') as HTMLElement | null;
  const countEl = document.getElementById('d3-count');
  const progressEl = document.getElementById('d3-progress') as HTMLElement | null;
  const statusEl = document.getElementById('d3-status');
  const roomCodeEl = document.getElementById('d3-room-code');
  const lastHitEl = document.getElementById('d3-last-hit') as HTMLElement | null;
  const audioButton = document.getElementById('d3-audio') as HTMLButtonElement | null;
  const gate = document.getElementById('d3-gate') as HTMLElement | null;
  const inviteDialog = document.getElementById('d3-invite-dialog') as HTMLDialogElement | null;
  const inviteStatus = document.getElementById('d3-invite-status');
  const toastLayer = document.getElementById('d3-toast-layer');
  const announcer = document.getElementById('d3-announcer');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function normalizedRoom(raw: string | null) {
    const room = (raw || 'lobby').trim().toLowerCase();
    return /^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$/.test(room) ? room : 'lobby';
  }
  function randomRoom() {
    const bytes = new Uint8Array(3);
    crypto.getRandomValues(bytes);
    return `jam-${Array.from(bytes, (value) => value.toString(36).padStart(2, '0')).join('').slice(0, 6)}`;
  }
  const params = new URLSearchParams(window.location.search);
  let room = normalizedRoom(params.get('room'));
  if (params.get('new') === '1') {
    room = randomRoom();
    params.delete('new');
    params.set('room', room);
    history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
  }
  app?.setAttribute('data-room', room);
  if (roomCodeEl) roomCodeEl.textContent = room.toUpperCase();
  document.querySelectorAll('[data-room-label]').forEach((element) => { element.textContent = room.toUpperCase(); });

  const SID_KEY = 'pc:drum-room:sid';
  function sessionId() {
    try {
      let value = localStorage.getItem(SID_KEY);
      if (!value) { value = crypto.randomUUID(); localStorage.setItem(SID_KEY, value); }
      return value;
    } catch { return crypto.randomUUID(); }
  }
  const sid = sessionId();

  // ── Pleasant, adaptive Web Audio kit ─────────────────────────────
  let audioContext: AudioContext | null = null;
  let voiceBus: GainNode | null = null;
  let masterGain: GainNode | null = null;
  let noiseBuffer: AudioBuffer | null = null;
  let ambientNodes: AudioNode[] = [];
  let soundOn = false;
  let connected = 0;

  function ensureAudio() {
    if (!audioContext) {
      const AudioCtor = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioCtor) return null;
      audioContext = new AudioCtor();
      voiceBus = audioContext.createGain();
      const compressor = audioContext.createDynamicsCompressor();
      compressor.threshold.value = -22; compressor.knee.value = 22; compressor.ratio.value = 5; compressor.attack.value = .006; compressor.release.value = .28;
      masterGain = audioContext.createGain(); masterGain.gain.value = .76;
      const delay = audioContext.createDelay(.5); delay.delayTime.value = .085;
      const feedback = audioContext.createGain(); feedback.gain.value = .13;
      const wet = audioContext.createGain(); wet.gain.value = .14;
      voiceBus.connect(compressor).connect(masterGain).connect(audioContext.destination);
      voiceBus.connect(delay).connect(feedback).connect(delay); delay.connect(wet).connect(masterGain);
      noiseBuffer = audioContext.createBuffer(1, audioContext.sampleRate * .5, audioContext.sampleRate);
      const data = noiseBuffer.getChannelData(0);
      for (let index = 0; index < data.length; index += 1) data[index] = Math.random() * 2 - 1;
    }
    if (audioContext.state === 'suspended') void audioContext.resume();
    return audioContext;
  }

  function envelope(node: GainNode, at: number, peak: number, decay: number, attack = .003) {
    node.gain.setValueAtTime(.0001, at);
    node.gain.exponentialRampToValueAtTime(Math.max(.0002, peak), at + attack);
    node.gain.exponentialRampToValueAtTime(.0001, at + decay);
  }

  function playPad(pad: Pad, velocity = .78, remote = false) {
    if (!soundOn) return;
    const context = ensureAudio();
    if (!context || !voiceBus || !noiseBuffer) return;
    const at = context.currentTime + .008;
    const crowdScale = remote ? Math.max(.16, .52 / Math.sqrt(Math.max(1, connected / 7))) : 1;
    const amount = Math.max(.04, Math.min(1, velocity)) * crowdScale;
    const tone = (frequency: number, end: number, type: OscillatorType, peak: number, decay: number) => {
      const oscillator = context.createOscillator(); const gain = context.createGain();
      oscillator.type = type; oscillator.frequency.setValueAtTime(frequency, at); oscillator.frequency.exponentialRampToValueAtTime(Math.max(24, end), at + decay * .72);
      envelope(gain, at, peak * amount, decay); oscillator.connect(gain).connect(voiceBus!); oscillator.start(at); oscillator.stop(at + decay + .04);
    };
    const noise = (filterType: BiquadFilterType, frequency: number, peak: number, decay: number, delay = 0) => {
      const source = context.createBufferSource(); source.buffer = noiseBuffer;
      const filter = context.createBiquadFilter(); filter.type = filterType; filter.frequency.value = frequency; filter.Q.value = .7;
      const gain = context.createGain(); envelope(gain, at + delay, peak * amount, decay, .002);
      source.connect(filter).connect(gain).connect(voiceBus!); source.start(at + delay); source.stop(at + delay + decay + .03);
    };
    if (pad === 'kick') { tone(118, 43, 'sine', .56, .34); tone(260, 65, 'triangle', .08, .08); }
    if (pad === 'snare') { noise('bandpass', 1900, .34, .18); tone(196, 168, 'triangle', .11, .14); }
    if (pad === 'hat') noise('highpass', 6200, .19, .075);
    if (pad === 'tom') { tone(178, 92, 'sine', .42, .38); tone(267, 138, 'triangle', .07, .22); }
    if (pad === 'clap') { noise('bandpass', 1400, .22, .12); noise('bandpass', 1700, .16, .10, .028); noise('bandpass', 1550, .12, .09, .055); }
    if (pad === 'bell') { tone(523.25, 522.7, 'sine', .23, 1.4); tone(1046.5, 1044, 'sine', .09, .86); tone(1445, 1438, 'sine', .055, .62); }
  }

  function startAmbient() {
    const context = ensureAudio();
    if (!context || !masterGain || ambientNodes.length) return;
    const filter = context.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 420;
    const gain = context.createGain(); gain.gain.value = .018;
    filter.connect(gain).connect(masterGain);
    [65.41, 98, 130.81].forEach((frequency, index) => {
      const oscillator = context.createOscillator(); oscillator.type = index === 0 ? 'sine' : 'triangle'; oscillator.frequency.value = frequency;
      oscillator.detune.value = index * 3 - 2; oscillator.connect(filter); oscillator.start(); ambientNodes.push(oscillator);
    });
    ambientNodes.push(filter, gain);
  }

  function setSound(next: boolean) {
    soundOn = next;
    if (next) { ensureAudio(); startAmbient(); }
    if (masterGain && audioContext) masterGain.gain.setTargetAtTime(next ? .76 : .0001, audioContext.currentTime, .025);
    if (audioButton) { audioButton.textContent = next ? 'SOUND ON' : 'SOUND OFF'; audioButton.setAttribute('aria-pressed', String(next)); }
  }

  // ── Small real 3D room; CSS presence fallback if WebGL is unavailable ──
  let renderer: THREE.WebGLRenderer | null = null;
  let scene: THREE.Scene | null = null;
  let camera: THREE.PerspectiveCamera | null = null;
  let raycaster: THREE.Raycaster | null = null;
  const pointer = new THREE.Vector2();
  const padMeshes = new Map<Pad, THREE.Mesh>();
  const avatarGroups = new Map<string, THREE.Group>();
  const pulseMeshes: { mesh: THREE.Mesh; born: number; hue: number }[] = [];
  let yaw = 0;
  let pitch = .52;
  let radius = 12.6;
  let pointerDown = false;
  let pointerMoved = false;
  let pointerX = 0;
  let pointerY = 0;
  const padColors: Record<Pad, number> = { kick: 0x5be7ff, snare: 0xff6f61, hat: 0xfff7df, tom: 0x9a7dff, clap: 0xff8fc5, bell: 0xffd448 };

  function makeNoun(person: Person) {
    const group = new THREE.Group();
    const bodyMat = new THREE.MeshStandardMaterial({ color: new THREE.Color(`hsl(${person.hue}, 58%, 42%)`), roughness: .75, metalness: .05 });
    const skinMat = new THREE.MeshStandardMaterial({ color: 0xf1c8a6, roughness: .8 });
    const dark = new THREE.MeshStandardMaterial({ color: 0x10121e, roughness: .5 });
    const lens = new THREE.MeshStandardMaterial({ color: padColors[(['kick','snare','hat','tom','clap','bell'] as Pad[])[person.avatar % 6] || 'kick'], emissiveIntensity: .2, emissive: 0x222222 });
    const body = new THREE.Mesh(new THREE.CapsuleGeometry(.22, .48, 4, 8), bodyMat); body.position.y = .46; group.add(body);
    const head = new THREE.Mesh(new THREE.BoxGeometry(.42,.38,.37), skinMat); head.position.y = 1.08; group.add(head);
    [-.13,.13].forEach((x) => { const glass = new THREE.Mesh(new THREE.BoxGeometry(.22,.17,.07), lens); glass.position.set(x,1.1,.215); group.add(glass); });
    const bridge = new THREE.Mesh(new THREE.BoxGeometry(.08,.05,.08), dark); bridge.position.set(0,1.1,.215); group.add(bridge);
    group.userData.clientId = person.id;
    return group;
  }

  function positionPeople(people: Person[]) {
    if (fallbackStage) {
      fallbackStage.replaceChildren();
      people.slice(0, 100).forEach((person, index) => {
        const dot = document.createElement('i'); dot.className = 'd3__fallback-person';
        const angle = (index / Math.max(1, people.length)) * Math.PI * 2; const ringIndex = index % 2; const spread = ringIndex ? 150 : 108;
        dot.style.setProperty('--hue', String(person.hue)); dot.style.setProperty('--x', `${Math.cos(angle) * spread}px`); dot.style.setProperty('--y', `${Math.sin(angle) * spread * .36}px`);
        fallbackStage.appendChild(dot);
      });
    }
    if (!scene) return;
    const ids = new Set(people.map((person) => person.id));
    for (const [id, group] of avatarGroups) { if (!ids.has(id)) { scene.remove(group); avatarGroups.delete(id); } }
    people.forEach((person, index) => {
      let group = avatarGroups.get(person.id);
      if (!group) { group = makeNoun(person); avatarGroups.set(person.id, group); scene!.add(group); }
      const ring = index < 44 ? 0 : 1;
      const ringCount = ring === 0 ? Math.min(44, people.length) : Math.max(1, people.length - 44);
      const ringIndex = ring === 0 ? index : index - 44;
      const angle = (ringIndex / ringCount) * Math.PI * 2 + ring * .08;
      const distance = ring === 0 ? 6.35 : 7.65;
      group.position.set(Math.cos(angle) * distance, 0, Math.sin(angle) * distance);
      group.rotation.y = -angle + Math.PI / 2;
      group.scale.setScalar(people.length > 70 ? .72 : people.length > 38 ? .82 : .94);
    });
  }

  function buildScene() {
    if (!app || !canvas) return;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.12;
      scene = new THREE.Scene(); scene.background = new THREE.Color(0x080a12); scene.fog = new THREE.FogExp2(0x080a12, .052);
      camera = new THREE.PerspectiveCamera(48, 1, .1, 80); raycaster = new THREE.Raycaster();
      scene.add(new THREE.HemisphereLight(0x6d78c8, 0x11121a, 1.2));
      const spot = new THREE.SpotLight(0xffe4a2, 34, 28, .62, .65, 1.2); spot.position.set(0,11,2); scene.add(spot);
      const floor = new THREE.Mesh(new THREE.CylinderGeometry(8.8, 9.2, .35, 96), new THREE.MeshStandardMaterial({ color: 0x14172a, roughness: .68, metalness: .25 })); floor.position.y = -.3; scene.add(floor);
      const floorRing = new THREE.Mesh(new THREE.RingGeometry(3.15,3.32,96), new THREE.MeshBasicMaterial({ color: 0x5be7ff, transparent: true, opacity: .26, side: THREE.DoubleSide })); floorRing.rotation.x = -Math.PI/2; floorRing.position.y = -.1; scene.add(floorRing);
      for (let ring = 1; ring <= 4; ring += 1) { const mesh = new THREE.Mesh(new THREE.RingGeometry(1.15 * ring,1.15*ring+.018,96),new THREE.MeshBasicMaterial({color:0x929ad3,transparent:true,opacity:.12,side:THREE.DoubleSide})); mesh.rotation.x=-Math.PI/2; mesh.position.y=-.085; scene.add(mesh); }
      const pads: Pad[] = ['kick','snare','hat','tom','clap','bell'];
      pads.forEach((pad,index) => {
        const angle = (index / pads.length) * Math.PI * 2 - Math.PI/2;
        const material = new THREE.MeshStandardMaterial({ color: padColors[pad], emissive: padColors[pad], emissiveIntensity: .11, roughness: .36, metalness: .35 });
        const mesh = new THREE.Mesh(new THREE.CylinderGeometry(.68,.78,.32,32),material); mesh.position.set(Math.cos(angle)*2.15,.08,Math.sin(angle)*2.15); mesh.userData.pad=pad; scene!.add(mesh); padMeshes.set(pad,mesh);
      });
      const core = new THREE.Mesh(new THREE.IcosahedronGeometry(.74,1), new THREE.MeshStandardMaterial({ color: 0x242a4c, emissive: 0x9a7dff, emissiveIntensity: .32, roughness: .2, metalness: .6 })); core.position.y=.72; core.userData.core=true; scene.add(core);
      const particlePositions = new Float32Array(330 * 3);
      for (let i=0;i<particlePositions.length;i+=3) { const angle=Math.random()*Math.PI*2; const distance=5+Math.random()*13; particlePositions[i]=Math.cos(angle)*distance; particlePositions[i+1]=1+Math.random()*10; particlePositions[i+2]=Math.sin(angle)*distance; }
      const stars = new THREE.BufferGeometry(); stars.setAttribute('position',new THREE.BufferAttribute(particlePositions,3)); scene.add(new THREE.Points(stars,new THREE.PointsMaterial({color:0xbec9ff,size:.045,transparent:true,opacity:.55})));
      resizeScene(); renderScene(0);
    } catch {
      app.dataset.fallback = 'true'; renderer = null; scene = null; camera = null;
    }
  }

  function resizeScene() {
    if (!renderer || !camera || !app) return;
    const width = app.clientWidth; const height = app.clientHeight;
    renderer.setSize(width,height,false); camera.aspect=width/Math.max(1,height); camera.updateProjectionMatrix();
  }
  function updateCamera() {
    if (!camera) return;
    camera.position.set(Math.sin(yaw)*Math.cos(pitch)*radius, Math.sin(pitch)*radius*.72+1.2, Math.cos(yaw)*Math.cos(pitch)*radius);
    camera.lookAt(0,.65,0);
  }
  function renderScene(time: number) {
    if (!renderer || !scene || !camera) return;
    updateCamera();
    if (!reducedMotion) {
      avatarGroups.forEach((group,index) => { group.position.y=Math.sin(time*.0014+index)*.045; });
      const core = scene.children.find((child) => child.userData.core); if (core) { core.rotation.y=time*.00035; core.rotation.x=.3+Math.sin(time*.0005)*.1; }
    }
    for (let index=pulseMeshes.length-1;index>=0;index-=1) { const pulse=pulseMeshes[index]; if (!pulse) continue; const life=(performance.now()-pulse.born)/900; if(life>=1){scene.remove(pulse.mesh);pulseMeshes.splice(index,1);}else{pulse.mesh.scale.setScalar(1+life*7); (pulse.mesh.material as THREE.MeshBasicMaterial).opacity=(1-life)*.6;} }
    renderer.render(scene,camera); requestAnimationFrame(renderScene);
  }
  function animatePad(pad: Pad, hue?: number) {
    const button = document.querySelector(`[data-pad="${pad}"]`) as HTMLElement | null;
    button?.setAttribute('data-hit','true'); setTimeout(() => button?.removeAttribute('data-hit'),120);
    const mesh = padMeshes.get(pad);
    if (mesh && scene) {
      const material = mesh.material as THREE.MeshStandardMaterial; material.emissiveIntensity=.85; mesh.scale.set(1.08,.72,1.08);
      setTimeout(()=>{material.emissiveIntensity=.11;mesh.scale.set(1,1,1);},150);
      const pulse = new THREE.Mesh(new THREE.RingGeometry(.23,.27,40),new THREE.MeshBasicMaterial({color:new THREE.Color(`hsl(${hue ?? 190},90%,65%)`),transparent:true,opacity:.6,side:THREE.DoubleSide})); pulse.rotation.x=-Math.PI/2; pulse.position.copy(mesh.position); pulse.position.y=-.03; scene.add(pulse); pulseMeshes.push({mesh:pulse,born:performance.now(),hue:hue??190});
    }
  }
  window.addEventListener('resize',resizeScene,{passive:true});
  canvas?.addEventListener('pointerdown',(event)=>{pointerDown=true;pointerMoved=false;pointerX=event.clientX;pointerY=event.clientY;canvas.setPointerCapture(event.pointerId);});
  canvas?.addEventListener('pointermove',(event)=>{if(!pointerDown)return;const dx=event.clientX-pointerX,dy=event.clientY-pointerY;if(Math.abs(dx)+Math.abs(dy)>3)pointerMoved=true;yaw-=dx*.006;pitch=Math.max(.16,Math.min(.9,pitch+dy*.004));pointerX=event.clientX;pointerY=event.clientY;});
  canvas?.addEventListener('pointerup',(event)=>{pointerDown=false;if(pointerMoved||!renderer||!camera||!raycaster||!canvas)return;const rect=canvas.getBoundingClientRect();pointer.x=((event.clientX-rect.left)/rect.width)*2-1;pointer.y=-((event.clientY-rect.top)/rect.height)*2+1;raycaster.setFromCamera(pointer,camera);const hit=raycaster.intersectObjects([...padMeshes.values()],false)[0];const pad=hit?.object.userData.pad as Pad | undefined;if(pad)triggerPad(pad,.82);});
  canvas?.addEventListener('wheel',(event)=>{radius=Math.max(8,Math.min(17,radius+event.deltaY*.008));},{passive:true});
  buildScene();

  // ── WebSocket room protocol ─────────────────────────────────────
  let socket: WebSocket | null = null;
  let myId = '';
  let seq = 0;
  let reconnectAttempt = 0;
  let reconnectTimer: number | null = null;

  function networkStatus(status: string, live: boolean) {
    if (statusEl) statusEl.textContent=status;
    if (app) app.dataset.network=live?'live':'offline';
  }
  function paintCount(value: number) {
    connected=Math.max(0,value); if(countEl)countEl.textContent=String(connected); if(progressEl)progressEl.style.width=`${Math.min(100,connected)}%`;
  }
  function flashLabel(text: string) {
    if(!lastHitEl)return;lastHitEl.textContent=text;lastHitEl.dataset.flash='true';setTimeout(()=>{if(lastHitEl)lastHitEl.dataset.flash='false';},220);
  }
  function websocketUrl() {
    const protocol=location.protocol==='https:'?'wss:':'ws:'; const url=new URL(`${protocol}//${location.host}/api/drum/room`);url.searchParams.set('room',room);url.searchParams.set('sid',sid);return url.href;
  }
  function connectRoom() {
    if(socket&&[WebSocket.OPEN,WebSocket.CONNECTING].includes(socket.readyState))return;
    networkStatus('CONNECTING',false);
    try { socket=new WebSocket(websocketUrl()); } catch { scheduleReconnect(); return; }
    socket.addEventListener('open',()=>{reconnectAttempt=0;networkStatus('LIVE',true);});
    socket.addEventListener('message',(event)=>{
      let message: RoomMessage; try{message=JSON.parse(String(event.data));}catch{return;}
      if(message.type==='welcome') { myId=message.you?.clientId||''; paintCount(message.connected||1); (message.recentHits||[]).slice(-8).forEach((hit)=>animatePad(hit.pad,hit.hue)); return; }
      if(message.type==='presence') { paintCount(message.connected||0); positionPeople(message.people||[]); if((message.connected||0)===100){flashLabel('ONE HUNDRED PEOPLE ARE IN THE ROOM');} return; }
      if(message.type==='hit'&&message.pad) { const mine=message.clientId===myId; animatePad(message.pad,message.hue); if(!mine)playPad(message.pad,message.velocity||.6,true); flashLabel(`${mine?'YOU':'NOUN '+String(message.avatar??'').padStart(4,'0')} PLAYED ${message.pad.toUpperCase()}`); return; }
      if(message.type==='reaction'&&message.emoji){showReaction(message.emoji,message.hue||180);return;}
      if(message.type==='rate-limit')flashLabel('EASY — LET THE ROOM BREATHE');
      if(message.type==='busy')flashLabel('THE ROOM IS FULL OF RHYTHM');
    });
    socket.addEventListener('close',()=>{socket=null;networkStatus('RECONNECTING',false);scheduleReconnect();});
    socket.addEventListener('error',()=>{try{socket?.close();}catch{}});
  }
  function scheduleReconnect(){if(reconnectTimer!==null)return;const delay=Math.min(10_000,700*Math.pow(1.7,reconnectAttempt++));reconnectTimer=window.setTimeout(()=>{reconnectTimer=null;connectRoom();},delay);}
  function send(payload: Record<string,unknown>){if(socket?.readyState!==WebSocket.OPEN)return;try{socket.send(JSON.stringify(payload));}catch{}}

  function triggerPad(pad: Pad, velocity=.78){if(!soundOn)setSound(true);seq+=1;playPad(pad,velocity,false);animatePad(pad);flashLabel(`YOU PLAYED ${pad.toUpperCase()}`);send({v:1,type:'hit',pad,velocity,seq,clientAt:Date.now()});if(announcer)announcer.textContent=`Played ${pad}`;}
  document.querySelectorAll<HTMLButtonElement>('[data-pad]').forEach((button)=>button.addEventListener('pointerdown',(event)=>{event.preventDefault();triggerPad(button.dataset.pad as Pad,.78);}));
  window.addEventListener('keydown',(event)=>{if(event.repeat)return;const map:Record<string,Pad>={"1":'kick',"2":'snare',"3":'hat',"4":'tom',"5":'clap',"6":'bell',a:'kick',s:'snare',d:'hat',f:'tom',g:'clap',h:'bell'};const pad=map[event.key.toLowerCase()];if(pad){event.preventDefault();triggerPad(pad,.8);}});

  function showReaction(emoji:string,hue=180){if(!toastLayer)return;const toast=document.createElement('span');toast.className='d3__toast';toast.textContent=emoji;toast.style.setProperty('--left',`${12+Math.random()*76}%`);toast.style.setProperty('--top',`${32+Math.random()*28}%`);toast.style.filter=`drop-shadow(0 0 18px hsl(${hue} 90% 60%))`;toastLayer.appendChild(toast);setTimeout(()=>toast.remove(),1900);}
  document.querySelectorAll<HTMLButtonElement>('[data-reaction]').forEach((button)=>button.addEventListener('click',()=>{const emoji=button.dataset.reaction||'✦';showReaction(emoji);send({v:1,type:'reaction',emoji});}));

  // ── Entry and invite card ───────────────────────────────────────
  function enter(withSound:boolean){setSound(withSound);gate?.setAttribute('data-open','false');}
  document.getElementById('d3-enter-sound')?.addEventListener('click',()=>enter(true));
  document.getElementById('d3-enter-quiet')?.addEventListener('click',()=>enter(false));
  audioButton?.addEventListener('click',()=>setSound(!soundOn));
  document.getElementById('d3-invite')?.addEventListener('click',()=>inviteDialog?.showModal());
  const inviteUrl=()=>`${location.origin}${location.pathname}?room=${encodeURIComponent(room)}`;
  async function copyInvite(){try{await navigator.clipboard.writeText(inviteUrl());if(inviteStatus)inviteStatus.textContent='Invite link copied.';}catch{if(inviteStatus)inviteStatus.textContent=inviteUrl();}}
  document.getElementById('d3-copy')?.addEventListener('click',copyInvite);
  document.getElementById('d3-share')?.addEventListener('click',async()=>{const share={title:'Join my PointCast Drum Room',text:`Meet me in room ${room.toUpperCase()}. Six sounds. Up to 100 people.`,url:inviteUrl()};if(navigator.share){try{await navigator.share(share);if(inviteStatus)inviteStatus.textContent='Invite shared.';return;}catch{}}await copyInvite();});
  document.getElementById('d3-download')?.addEventListener('click',()=>{
    const card=document.createElement('canvas');card.width=1080;card.height=1350;const context=card.getContext('2d');if(!context)return;
    context.fillStyle='#ffd448';context.fillRect(0,0,1080,1350);context.fillStyle='#090a12';context.font='500 28px monospace';context.fillText('POINTCAST INVITES YOU TO',74,92);
    context.font='500 126px Arial';context.fillText('THE 3D',70,270);context.fillText('DRUM ROOM',70,390);
    const colors=['#ff6f61','#5be7ff','#9a7dff'];colors.forEach((color,index)=>{context.strokeStyle=color;context.lineWidth=40;context.beginPath();context.arc(775,780,330-index*84,0,Math.PI*2);context.stroke();});
    context.fillStyle='#090a12';context.font='500 180px monospace';context.fillText('100',100,940);context.font='500 28px monospace';context.fillText('CAN PLAY AT ONCE',106,985);
    context.lineWidth=3;context.beginPath();context.moveTo(74,1180);context.lineTo(1006,1180);context.stroke();context.font='500 29px monospace';context.fillText(`ROOM ${room.toUpperCase()}`,74,1240);context.font='400 24px monospace';context.fillText('pointcast.xyz/drum-room',648,1240);
    const link=document.createElement('a');link.download=`pointcast-drum-room-${room}.png`;link.href=card.toDataURL('image/png');link.click();if(inviteStatus)inviteStatus.textContent='Invite card saved.';
  });

  connectRoom();
</script>
