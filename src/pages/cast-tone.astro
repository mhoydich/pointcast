---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Tone — chromatic reference drone" description="Pick a note. Hit play. Sustained sine + triangle blend holds the pitch forever. For tuning instruments by ear, vocal warmups, drone meditation, interval ear training.">
  <main class="ct" id="ct" data-built={built}>
    <header class="ct__hero">
      <p class="ct__kicker">CAST · TONE · reference drone</p>
      <h1 class="ct__title">Hold a note.</h1>
      <p class="ct__sub">Pick a pitch. It holds. Tune to it. Sing over it. Sit with it.</p>
    </header>

    <section class="ct__stage">
      <div class="ct__note-display" id="ct-note-display">
        <p class="ct__note-letter" id="ct-note-letter">A</p>
        <p class="ct__note-octave" id="ct-note-octave">4 · 440 Hz</p>
      </div>

      <button class="ct__play" id="ct-play" type="button" aria-label="Hold note">
        <span id="ct-play-icon">▶</span>
      </button>
    </section>

    <section class="ct__picker">
      <p class="ct__section-label">PICK A NOTE</p>
      <div class="ct__notes" id="ct-notes"></div>
      <div class="ct__octaves">
        <span class="ct__section-label-small">OCTAVE</span>
        <div class="ct__pill-row" id="ct-octave-row">
          <button class="ct__pill" data-oct="2">2</button>
          <button class="ct__pill" data-oct="3">3</button>
          <button class="ct__pill cm__pill--active" data-oct="4">4</button>
          <button class="ct__pill" data-oct="5">5</button>
        </div>
      </div>
    </section>

    <section class="ct__interval" id="ct-interval-section" hidden>
      <p class="ct__section-label">+ HOLD A SECOND NOTE</p>
      <div class="ct__notes" id="ct-notes-2"></div>
      <p class="ct__interval-readout" id="ct-interval-readout">—</p>
    </section>

    <section class="ct__controls">
      <button class="ct__btn ct__btn--ghost" id="ct-toggle-interval" type="button">+ add second note (interval mode)</button>
      <div class="ct__timbre">
        <span class="ct__section-label-small">TIMBRE</span>
        <div class="ct__pill-row">
          <button class="ct__pill ct__pill--active" data-timbre="warm" type="button">warm</button>
          <button class="ct__pill" data-timbre="pure" type="button">pure</button>
          <button class="ct__pill" data-timbre="rich" type="button">rich</button>
        </div>
      </div>
      <div class="ct__vol">
        <span class="ct__vol-icon">♪</span>
        <input type="range" class="ct__vol-slider" id="ct-vol" min="0" max="100" value="45" aria-label="Volume"/>
      </div>
    </section>

    <section class="ct__tips">
      <h2 class="ct__tips-title">What this is for</h2>
      <ul class="ct__tips-list">
        <li><strong>Tuning by ear</strong> — play A4 (440Hz) and tune your A string until the wobble disappears. The wobble is "beating" — when two slightly-different frequencies interfere.</li>
        <li><strong>Vocal warmups</strong> — sing a long held tone over the drone. Sirens, lip rolls, sustained vowels.</li>
        <li><strong>Drone meditation</strong> — sit with a sustained tone. Indian classical music calls this the "tanpura." A5 is bright, A3 is grounding.</li>
        <li><strong>Interval ear training</strong> — hit "+ add second note," set them to a third / fifth / octave apart, hold both. Learn the sound of each interval.</li>
      </ul>
      <p class="ct__tips-note">Hold <strong>spacebar</strong> to toggle play. Press a note's letter (A-G, or # for sharps) to change pitch.</p>
    </section>

    <footer class="ct__foot">
      <p>Built {built.slice(0,10)} · pure Web Audio · equal temperament · A4 = 440 Hz</p>
      <p>← <a href="/cast-wheel">/cast-wheel</a> · <a href="/cast-breathe">/cast-breathe</a> · <a href="/drum-academy">/drum-academy</a> · <a href="/town-music">/town-music</a> · <a href="/">PointCast home</a></p>
    </footer>
  </main>
</BlockLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --ct-bg: #0a0610;
    --ct-walnut: #5a3422;
    --ct-flame: #f6c15e;
    --ct-cream: #f4e7c8;
    --ct-velvet: #1a0820;
    --ct-line: rgba(244,231,200,0.10);
    --ct-text: #f4e7c8;
    --ct-text-mute: rgba(244,231,200,0.62);
    --ct-text-quiet: rgba(244,231,200,0.38);
    --ct-display: 'Inter Tight', system-ui, sans-serif;
    --ct-body: 'Inter', system-ui, sans-serif;
    --ct-mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  body { background: var(--ct-bg); color: var(--ct-text); font-family: var(--ct-body); }

  .ct { max-width: 720px; margin: 0 auto; padding: 36px 22px 60px 22px; display: flex; flex-direction: column; gap: 28px; }

  /* HERO */
  .ct__kicker { font-family: var(--ct-mono); font-size: 11px; letter-spacing: 0.7px; color: var(--ct-flame); text-transform: uppercase; margin: 0 0 12px 0; }
  .ct__title {
    font-family: var(--ct-display); font-weight: 900;
    font-size: clamp(48px, 8vw, 72px); line-height: 0.96; letter-spacing: -0.025em; margin: 0 0 12px 0;
    background: linear-gradient(180deg, var(--ct-cream), var(--ct-flame));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .ct__sub { font-family: var(--ct-body); font-size: 15px; line-height: 1.6; color: var(--ct-text-mute); max-width: 540px; margin: 0; }

  /* STAGE */
  .ct__stage {
    display: flex; flex-direction: column; align-items: center; gap: 28px;
    padding: 36px 28px;
    background: linear-gradient(180deg, rgba(244,231,200,0.05), rgba(244,231,200,0.02));
    border: 1px solid var(--ct-line); border-radius: 16px;
  }
  .ct__note-display {
    text-align: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .ct__stage[data-state="on"] .ct__note-display { opacity: 1; transform: scale(1.04); }
  .ct__note-letter { font-family: var(--ct-display); font-weight: 900; font-size: 96px; line-height: 1; letter-spacing: -0.04em; margin: 0; color: var(--ct-text); }
  .ct__stage[data-state="on"] .ct__note-letter { color: var(--ct-flame); }
  .ct__note-octave { font-family: var(--ct-mono); font-size: 14px; color: var(--ct-text-mute); margin: 8px 0 0 0; letter-spacing: 0.4px; }

  .ct__play {
    width: 76px; height: 76px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, var(--ct-flame) 0%, var(--ct-walnut) 70%, var(--ct-velvet) 100%);
    border: 2px solid rgba(244,231,200,0.18);
    color: var(--ct-velvet); font-size: 30px; font-weight: 800; padding-left: 4px;
    cursor: pointer; display: grid; place-items: center;
    transition: transform 0.15s ease;
    box-shadow: 0 6px 18px rgba(0,0,0,0.45);
  }
  .ct__play:hover { transform: scale(1.05); }
  .ct__play:focus-visible { outline: 3px solid var(--ct-flame); outline-offset: 4px; }
  .ct__play--on { padding-left: 0; animation: ct-breathe 2.6s ease-in-out infinite; }
  @keyframes ct-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }

  /* PICKER */
  .ct__picker {
    padding: 18px 20px;
    background: rgba(244,231,200,0.03);
    border: 1px solid var(--ct-line);
    border-radius: 12px;
  }
  .ct__section-label { font-family: var(--ct-mono); font-size: 10px; letter-spacing: 0.7px; color: var(--ct-text-quiet); text-transform: uppercase; margin: 0 0 14px 0; }
  .ct__section-label-small { font-family: var(--ct-mono); font-size: 10px; letter-spacing: 0.5px; color: var(--ct-text-quiet); text-transform: uppercase; }
  .ct__notes { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; margin-bottom: 18px; }
  @media (max-width: 560px) { .ct__notes { grid-template-columns: repeat(6, 1fr); } }
  .ct__note-btn {
    aspect-ratio: 0.8;
    padding: 8px 4px;
    background: rgba(244,231,200,0.04);
    border: 2px solid var(--ct-line);
    border-radius: 6px;
    color: var(--ct-text-mute);
    font-family: var(--ct-display); font-weight: 700; font-size: 14px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ct__note-btn:hover { background: rgba(244,231,200,0.12); color: var(--ct-text); }
  .ct__note-btn--sharp { color: var(--ct-text-quiet); background: rgba(244,231,200,0.02); font-size: 12px; }
  .ct__note-btn--sharp:hover { color: var(--ct-text-mute); }
  .ct__note-btn--active { background: var(--ct-flame); color: var(--ct-velvet); border-color: var(--ct-flame); }
  .ct__note-btn--active2 { background: rgba(168,255,58,0.30); color: var(--ct-text); border-color: var(--ct-good, #a8ff3a); }

  .ct__octaves { display: flex; align-items: center; gap: 12px; }
  .ct__pill-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .ct__pill {
    background: rgba(244,231,200,0.04); color: var(--ct-text-mute);
    border: 1px solid var(--ct-line); border-radius: 6px;
    padding: 4px 12px; font-family: var(--ct-mono); font-size: 11px; cursor: pointer;
    transition: all 0.15s ease;
  }
  .ct__pill:hover { background: rgba(244,231,200,0.10); color: var(--ct-text); }
  .ct__pill--active { background: rgba(246,193,94,0.16); color: var(--ct-flame); border-color: var(--ct-flame); }

  /* INTERVAL */
  .ct__interval {
    padding: 18px 20px;
    background: rgba(168,255,58,0.04);
    border: 1px solid rgba(168,255,58,0.18);
    border-radius: 12px;
  }
  .ct__interval-readout { font-family: var(--ct-mono); font-size: 13px; color: #a8ff3a; margin: 0; text-align: center; letter-spacing: 0.3px; }

  /* CONTROLS */
  .ct__controls {
    display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
    padding: 14px 18px; background: rgba(244,231,200,0.03); border: 1px solid var(--ct-line); border-radius: 12px;
  }
  .ct__btn {
    background: transparent; color: var(--ct-text-mute);
    border: 1px dashed var(--ct-line); border-radius: 999px;
    padding: 8px 16px; font-family: var(--ct-mono); font-size: 11px; cursor: pointer;
    transition: all 0.15s ease;
  }
  .ct__btn:hover { background: rgba(244,231,200,0.06); color: var(--ct-text); border-color: var(--ct-flame); }
  .ct__btn--ghost.ct__btn--on { background: rgba(168,255,58,0.16); color: #a8ff3a; border-color: #a8ff3a; border-style: solid; }

  .ct__timbre { display: flex; align-items: center; gap: 10px; }
  .ct__vol { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .ct__vol-icon { font-size: 14px; color: var(--ct-text-mute); }
  .ct__vol-slider { width: 100px; -webkit-appearance: none; appearance: none; height: 4px; background: rgba(244,231,200,0.16); border-radius: 2px; outline: 0; cursor: pointer; }
  .ct__vol-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--ct-flame); cursor: pointer; }

  /* TIPS */
  .ct__tips { padding: 22px; background: rgba(244,231,200,0.03); border: 1px solid var(--ct-line); border-radius: 12px; }
  .ct__tips-title { font-family: var(--ct-display); font-weight: 700; font-size: 18px; margin: 0 0 12px 0; letter-spacing: -0.01em; }
  .ct__tips-list { list-style: none; padding: 0; margin: 0 0 12px 0; display: flex; flex-direction: column; gap: 10px; }
  .ct__tips-list li { font-family: var(--ct-body); font-size: 13.5px; line-height: 1.55; color: var(--ct-text-mute); }
  .ct__tips-list strong { color: var(--ct-flame); font-weight: 600; }
  .ct__tips-note { font-family: var(--ct-body); font-size: 12.5px; color: var(--ct-text-quiet); margin: 0; font-style: italic; line-height: 1.5; }
  .ct__tips-note strong { color: var(--ct-text); font-weight: 600; font-style: normal; }

  /* FOOT */
  .ct__foot { padding-top: 24px; border-top: 1px solid var(--ct-line); font-family: var(--ct-mono); font-size: 11px; color: var(--ct-text-quiet); line-height: 1.7; text-align: center; }
  .ct__foot a { color: var(--ct-flame); text-decoration: none; }
  .ct__foot a:hover { text-decoration: underline; }
</style>

<script>
  import { createAudioScheduler, type AudioScheduler } from '../lib/audio-scheduler';

  // ============================================================
  //  CAST · TONE — sustained chromatic reference
  // ============================================================

  const NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
  // Hz for each chromatic note at octave 4. A4 = 440. C4 = 440 * 2^(-9/12) ≈ 261.63
  function noteFreq(noteIdx: number, octave: number): number {
    const semitonesFromA4 = (octave - 4) * 12 + (noteIdx - 9);
    return 440 * Math.pow(2, semitonesFromA4 / 12);
  }

  type Timbre = 'warm' | 'pure' | 'rich';

  // ---------- Audio ----------
  let ctx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let sched: AudioScheduler | null = null;
  let volume = 45;
  // Per-voice graph nodes so we can stop them independently
  interface VoiceNodes { oscs: OscillatorNode[]; gain: GainNode; filter: BiquadFilterNode; }
  let voice1: VoiceNodes | null = null;
  let voice2: VoiceNodes | null = null;

  function ac(): AudioContext {
    if (ctx) return ctx;
    ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
    masterGain = ctx.createGain(); masterGain.gain.value = volume / 100;
    masterGain.connect(ctx.destination);
    sched = createAudioScheduler(ctx);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ctx && ctx.state !== 'running' && playing) sched?.resume();
    });
    return ctx;
  }

  function buildVoice(freq: number): VoiceNodes {
    const c = ac();
    const gain = c.createGain();
    gain.gain.value = 0.001;
    const filter = c.createBiquadFilter();
    filter.type = 'lowpass';
    // Timbre selection
    filter.frequency.value = timbre === 'pure' ? 6000 : timbre === 'rich' ? 3200 : 1800;
    filter.Q.value = 0.7;
    const oscs: OscillatorNode[] = [];
    if (timbre === 'pure') {
      // single sine
      const o = c.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
      o.connect(filter); oscs.push(o);
    } else if (timbre === 'warm') {
      // sine + triangle pair, slight detune
      const o1 = c.createOscillator(); o1.type = 'sine'; o1.frequency.value = freq;
      const o2 = c.createOscillator(); o2.type = 'triangle'; o2.frequency.value = freq * 1.005;
      o1.connect(filter); o2.connect(filter); oscs.push(o1, o2);
    } else { // rich
      // sine + sine fifth + sine octave + triangle root for body
      const o1 = c.createOscillator(); o1.type = 'sine'; o1.frequency.value = freq;
      const o2 = c.createOscillator(); o2.type = 'sine'; o2.frequency.value = freq * 1.5;
      const o3 = c.createOscillator(); o3.type = 'sine'; o3.frequency.value = freq * 2.0;
      const o4 = c.createOscillator(); o4.type = 'triangle'; o4.frequency.value = freq;
      o1.connect(filter); o2.connect(filter); o3.connect(filter); o4.connect(filter);
      oscs.push(o1, o2, o3, o4);
    }
    filter.connect(gain); gain.connect(masterGain!);
    // Slow attack
    const t = c.currentTime;
    gain.gain.linearRampToValueAtTime(0.10, t + 0.6);
    oscs.forEach(o => { sched!.trackSource(o); o.start(); });
    return { oscs, gain, filter };
  }

  function stopVoice(v: VoiceNodes) {
    if (!ctx) return;
    const t = ctx.currentTime;
    try { v.gain.gain.cancelScheduledValues(t); } catch {}
    v.gain.gain.linearRampToValueAtTime(0.001, t + 0.3);
    setTimeout(() => {
      try { v.oscs.forEach(o => { try { o.stop(); } catch {} try { o.disconnect(); } catch {} }); } catch {}
      try { v.filter.disconnect(); } catch {}
      try { v.gain.disconnect(); } catch {}
    }, 400);
  }

  // ---------- State ----------
  let playing = false;
  let note1Idx = 9; // A
  let octave = 4;
  let timbre: Timbre = 'warm';
  let intervalMode = false;
  let note2Idx = 1; // C# (default to make a major third visible)

  function start() {
    if (!ctx) ac();
    playing = true;
    voice1 = buildVoice(noteFreq(note1Idx, octave));
    if (intervalMode) voice2 = buildVoice(noteFreq(note2Idx, octave));
    updatePlayBtn();
    document.getElementById('ct-stage')?.parentElement; // no-op
    const stage = document.querySelector('.ct__stage') as HTMLDivElement;
    stage.dataset.state = 'on';
  }
  function stop() {
    if (voice1) { stopVoice(voice1); voice1 = null; }
    if (voice2) { stopVoice(voice2); voice2 = null; }
    playing = false;
    updatePlayBtn();
    const stage = document.querySelector('.ct__stage') as HTMLDivElement;
    stage.dataset.state = 'off';
  }
  function toggle() { if (playing) stop(); else start(); }

  function setNote1(idx: number) {
    note1Idx = idx;
    renderNotes();
    renderDisplay();
    renderIntervalReadout();
    if (playing && voice1) {
      // Live retune: ramp existing oscillators to new freq
      const freq = noteFreq(idx, octave);
      const c = ac();
      voice1.oscs.forEach(o => {
        // figure out original ratio
        if (o.type === 'sine' || o.type === 'triangle') {
          const ratio = o.frequency.value / noteFreq(note1Idx, octave) * Math.pow(2, 0); // wrong: but we'll just simplify
        }
      });
      // Simpler: stop + rebuild voice1
      const oldVoice = voice1;
      voice1 = buildVoice(freq);
      stopVoice(oldVoice);
    }
  }
  function setNote2(idx: number) {
    note2Idx = idx;
    renderNotes();
    renderIntervalReadout();
    if (playing && intervalMode) {
      const freq = noteFreq(idx, octave);
      const oldVoice = voice2;
      voice2 = buildVoice(freq);
      if (oldVoice) stopVoice(oldVoice);
    }
  }

  function setOctave(o: number) {
    octave = o;
    renderOctave();
    renderDisplay();
    if (playing) {
      // Rebuild both voices at the new octave
      if (voice1) { stopVoice(voice1); voice1 = buildVoice(noteFreq(note1Idx, octave)); }
      if (voice2 && intervalMode) { stopVoice(voice2); voice2 = buildVoice(noteFreq(note2Idx, octave)); }
    }
  }

  function setTimbre(t: Timbre) {
    timbre = t;
    document.querySelectorAll<HTMLButtonElement>('[data-timbre]').forEach(b => b.classList.toggle('ct__pill--active', b.dataset.timbre === t));
    if (playing) {
      // Rebuild voices with the new timbre
      if (voice1) { stopVoice(voice1); voice1 = buildVoice(noteFreq(note1Idx, octave)); }
      if (voice2 && intervalMode) { stopVoice(voice2); voice2 = buildVoice(noteFreq(note2Idx, octave)); }
    }
  }

  function toggleIntervalMode() {
    intervalMode = !intervalMode;
    const sect = document.getElementById('ct-interval-section') as HTMLElement;
    sect.hidden = !intervalMode;
    const btn = document.getElementById('ct-toggle-interval')!;
    btn.classList.toggle('ct__btn--on', intervalMode);
    btn.textContent = intervalMode ? '✓ interval mode' : '+ add second note (interval mode)';
    renderIntervalReadout();
    if (playing) {
      if (intervalMode && !voice2) voice2 = buildVoice(noteFreq(note2Idx, octave));
      if (!intervalMode && voice2) { stopVoice(voice2); voice2 = null; }
    }
  }

  function updatePlayBtn() {
    const btn = document.getElementById('ct-play')!;
    const ic = document.getElementById('ct-play-icon')!;
    btn.classList.toggle('ct__play--on', playing);
    ic.textContent = playing ? '◼' : '▶';
  }

  function renderNotes() {
    const wrap = document.getElementById('ct-notes')!;
    wrap.innerHTML = NOTES.map((n, i) => {
      const isSharp = n.includes('#');
      return `<button class="ct__note-btn ${isSharp ? 'ct__note-btn--sharp' : ''} ${i === note1Idx ? 'ct__note-btn--active' : ''}" data-note="${i}" type="button" aria-label="${n}">${n}</button>`;
    }).join('');
    wrap.querySelectorAll<HTMLButtonElement>('[data-note]').forEach(b => {
      b.addEventListener('click', () => setNote1(Number(b.dataset.note)));
    });

    const wrap2 = document.getElementById('ct-notes-2');
    if (wrap2) {
      wrap2.innerHTML = NOTES.map((n, i) => {
        const isSharp = n.includes('#');
        return `<button class="ct__note-btn ${isSharp ? 'ct__note-btn--sharp' : ''} ${i === note2Idx ? 'ct__note-btn--active2' : ''}" data-note2="${i}" type="button" aria-label="${n}">${n}</button>`;
      }).join('');
      wrap2.querySelectorAll<HTMLButtonElement>('[data-note2]').forEach(b => {
        b.addEventListener('click', () => setNote2(Number(b.dataset.note2)));
      });
    }
  }

  function renderOctave() {
    document.querySelectorAll<HTMLButtonElement>('[data-oct]').forEach(b => {
      b.classList.toggle('ct__pill--active', Number(b.dataset.oct) === octave);
    });
  }

  function renderDisplay() {
    const f = noteFreq(note1Idx, octave);
    document.getElementById('ct-note-letter')!.textContent = NOTES[note1Idx];
    document.getElementById('ct-note-octave')!.textContent = `${octave} · ${f.toFixed(2)} Hz`;
  }

  const INTERVAL_NAMES = ['unison', 'minor 2nd', 'major 2nd', 'minor 3rd', 'major 3rd', 'perfect 4th', 'tritone', 'perfect 5th', 'minor 6th', 'major 6th', 'minor 7th', 'major 7th'];
  function renderIntervalReadout() {
    const el = document.getElementById('ct-interval-readout');
    if (!el) return;
    if (!intervalMode) { el.textContent = '—'; return; }
    const diff = ((note2Idx - note1Idx) + 12) % 12;
    const ivName = INTERVAL_NAMES[diff];
    el.textContent = `${NOTES[note1Idx]} → ${NOTES[note2Idx]} · ${ivName} · ${diff} semitones`;
  }

  // ---------- Init ----------
  document.addEventListener('DOMContentLoaded', () => {
    renderNotes();
    renderOctave();
    renderDisplay();
    renderIntervalReadout();

    document.getElementById('ct-play')?.addEventListener('click', toggle);
    document.getElementById('ct-toggle-interval')?.addEventListener('click', toggleIntervalMode);

    document.querySelectorAll<HTMLButtonElement>('[data-oct]').forEach(b => {
      b.addEventListener('click', () => setOctave(Number(b.dataset.oct)));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-timbre]').forEach(b => {
      b.addEventListener('click', () => setTimbre(b.dataset.timbre as Timbre));
    });

    document.getElementById('ct-vol')?.addEventListener('input', (e) => {
      volume = Number((e.target as HTMLInputElement).value);
      if (masterGain) masterGain.gain.setTargetAtTime(volume / 100, ac().currentTime, 0.05);
    });

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.code === 'Space') { e.preventDefault(); toggle(); return; }
      // Letter shortcuts: A-G pick that natural note. Shift adds sharp.
      const letter = e.key.toUpperCase();
      const letterToIdx: Record<string, number> = { 'C': 0, 'D': 2, 'E': 4, 'F': 5, 'G': 7, 'A': 9, 'B': 11 };
      if (letter in letterToIdx) {
        e.preventDefault();
        let idx = letterToIdx[letter];
        if (e.shiftKey && letter !== 'E' && letter !== 'B') idx = (idx + 1) % 12; // E# and B# aren't shortcut-friendly
        setNote1(idx);
      }
      if (e.key === 'ArrowUp') { e.preventDefault(); if (octave < 5) setOctave(octave + 1); }
      if (e.key === 'ArrowDown') { e.preventDefault(); if (octave > 2) setOctave(octave - 1); }
    });
  });
</script>
</BlockLayout>
