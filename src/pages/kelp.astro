      text(`BEST  ${String(best).padStart(6, '0')}`, W / 2, 188, 2, m.bands.yellow, 'center');
      text(`STAGE ${g.stage + 1}  LENGTH ${G.peakLen}`, W / 2, 204, 2, m.text, 'center');
      text(`PEAK ${mood.peak}`, W / 2, 220, 2, m.text, 'center');
      if (Math.floor(G.t * 2) % 2 === 0) text(COARSE ? 'TAP TO PLAY AGAIN' : 'TAP OR SPACE TO PLAY AGAIN', W / 2, 272, 2, m.paddle, 'center');
    }
    function render() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawBorder();
      let sx = offX, sy = offY;
      if (G.shake > 0) { sx += Math.round(rnd(-2, 2)); sy += Math.round(rnd(-2, 2)); }
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, sx * dpr, sy * dpr);
      if (G.phase === 'boot') { drawBoot(); return; }
      drawField();
      if (G.phase === 'title') { drawTitle(); return; }
      if (G.phase === 'over') { drawHud(); drawOver(); return; }
      const g = G.game;
      drawHud(); drawWall(1); drawRocks(g, 1); drawPlankton(g, 1); drawStrand(g, 1); drawParticles(1);
      const m = M();
      if (G.phase === 'ready' && Math.floor(G.t * 2) % 2 === 0 && G.msgT <= 0) text(COARSE ? 'SWIPE TO SWIM' : 'ARROWS OR SPACE TO SWIM', W / 2, 150, 2, m.paddle, 'center');
      if (G.phase === 'paused') { text('PAUSED', W / 2, 140, 4, m.bright, 'center'); text(COARSE ? 'TAP TO RESUME' : 'P TO RESUME', W / 2, 172, 2, m.paddle, 'center'); }
      if (G.msgT > 0 && G.msg) text(G.msg, W / 2, 136, G.msgScale, m.bright, 'center');
    }

    // ---------- loop ----------
    let last = performance.now(), readoutClock = 0;
    function frame(now) {
      const dt = Math.min(1 / 30, Math.max(0, (now - last) / 1000));
      last = now;
      G.fpsAcc += dt; G.fpsN += 1;
      if (G.fpsAcc >= 0.5) { G.fps = Math.round(G.fpsN / G.fpsAcc); G.fpsAcc = 0; G.fpsN = 0; }
      update(dt);
      render();
      readoutClock += dt;
      if (readoutClock > 0.25) {
        readoutClock = 0;
        const g = G.game;
        const title = G.phase === 'title' || G.phase === 'boot';
        readout.mood.textContent = `${title ? 'ATTRACT' : response.label} E${mood.energy.toFixed(2)} C${mood.calm.toFixed(2)}`;
        readout.tempo.textContent = `${title ? 104 : response.tempo} BPM ${title ? 'MAJOR' : response.scale.toUpperCase()}`;
        readout.fps.textContent = `${G.fps} FPS`;
        readout.len.textContent = g && !title ? `LEN ${g.strand.length + g.grow}/${g.target}` : 'LEN 4';
      }
      requestAnimationFrame(frame);
    }

    // ---------- input ----------
    function steer(dir, fromKey) {
      if (G.phase !== 'ready' && G.phase !== 'play') return;
      const g = G.game;
      if (setDirection(g, dir)) audio.turn();
      // A swipe or key in the ready phase starts the swim, and the first tick moves the new way.
      if (G.phase === 'ready') { startGame(g); G.phase = 'play'; G.t = 0; G.acc = 0; if (!fromKey) buzz(4); }
    }
    function action() {
      audio.unlock();
      if (G.phase === 'boot') { audio.jingle(); enterTitle(); return; }
      if (G.phase === 'title' || G.phase === 'over') { newGame(); return; }
      if (G.phase === 'ready') { startGame(G.game); G.phase = 'play'; G.t = 0; G.acc = 0; return; }
      if (G.phase === 'paused') { G.phase = G.resume || 'play'; G.t = 0; audio.setMusic(true); }
    }
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      G.swipe = { id: e.pointerId, x: e.clientX, y: e.clientY, moved: false };
      audio.unlock();
    });
    canvas.addEventListener('pointermove', (e) => {
      const s = G.swipe;
      if (!s || s.id !== e.pointerId) return;
      const dx = e.clientX - s.x, dy = e.clientY - s.y;
      if (Math.hypot(dx, dy) < SWIPE) return;
      const dir = Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'down' : 'up');
      s.moved = true; s.x = e.clientX; s.y = e.clientY;
      if (G.phase === 'ready' || G.phase === 'play') steer(dir, false);
    });
    const endSwipe = (e) => {
      const s = G.swipe;
      if (!s || s.id !== e.pointerId) return;
      G.swipe = null;
      if (!s.moved && e.type === 'pointerup') action();
    };
    canvas.addEventListener('pointerup', endSwipe);
    canvas.addEventListener('pointercancel', endSwipe);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    const KEY_DIRS = { ArrowUp: 'up', KeyW: 'up', ArrowDown: 'down', KeyS: 'down', ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right' };
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
      const t = e.target;
      const k = e.code;
      if (t && typeof t.closest === 'function') {
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        // Enter and Space belong to a focused link or button; arrows and letters still steer from there.
        if ((k === 'Space' || k === 'Enter') && t.closest('a, button')) return;
      }
      if (KEY_DIRS[k]) {
        e.preventDefault();
        if (e.repeat) return;
        audio.unlock();
        G.keys[k] = true;
        if (G.phase === 'title' || G.phase === 'over') { action(); return; }
        steer(KEY_DIRS[k], true);
        return;
      }
      if (k === 'Space' || k === 'Enter') { e.preventDefault(); action(); return; }
      if (k === 'KeyP') { togglePause(); return; }
      if (k === 'KeyF') { toggleFull(); return; }
      if (k === 'KeyM') { toggleSound(); return; }
      if (k === 'KeyC') { toggleCrt(); return; }
      if (k === 'Digit1') { setMachine('xl'); return; }
      if (k === 'Digit2') { setMachine('c64'); return; }
      if (k === 'Digit3') { cycleDial(); }
    });
    document.addEventListener('keyup', (e) => { G.keys[e.code] = false; });
    function togglePause() {
      if (G.phase === 'play' || G.phase === 'ready') { G.resume = G.phase; G.phase = 'paused'; audio.setMusic(false); }
      else if (G.phase === 'paused') { G.phase = G.resume || 'play'; G.t = 0; audio.setMusic(true); }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        G.keys = {}; G.swipe = null;
        if (G.phase === 'play' || G.phase === 'ready') { G.resume = G.phase; G.phase = 'paused'; }
        G.musicResume = audio.wantsMusic() && G.phase !== 'paused';
        audio.setMusic(false);
        save(); handMoodToTown();
      } else {
        last = performance.now();
        if (G.musicResume) { G.musicResume = false; audio.setMusic(true); }
      }
    });
    window.addEventListener('blur', () => { G.keys = {}; G.swipe = null; });
    window.addEventListener('pagehide', () => { save(); handMoodToTown(); });

    // ---------- settings UI ----------
    function syncButtons() {
      btn.machine.textContent = M().label;
      btn.dial.textContent = DIALS[mood.dial].label;
      btn.sound.setAttribute('aria-pressed', String(soundOn));
      btn.crt.setAttribute('aria-pressed', String(crtOn));
      root.dataset.machine = machineId;
      root.dataset.crt = crtOn ? 'on' : 'off';
      btn.full.textContent = fullscreenEl() ? 'EXIT' : 'FULL';
    }
    function setMachine(id) {
      if (!MACHINES[id] || id === machineId) return;
      machineId = id;
      if (G.game) { setGameMachine(G.game, machineId, response.density); syncStageReadout(); }
      if (G.attract) setGameMachine(G.attract, machineId, 1);
      G.loading = 0.5;
      syncButtons(); save();
      announce(`${M().name} mode.`);
    }
    function cycleDial() {
      const next = DIAL_IDS[(DIAL_IDS.indexOf(mood.dial) + 1) % DIAL_IDS.length];
      setDial(mood, next); response = moodResponse(mood);
      if (G.game) {
        G.game.unlimited = response.unlimitedBalls;
        if (!G.game.unlimited && G.game.lives <= 0) G.game.lives = 1;
      }
      syncButtons(); save();
      announce(`Dial ${DIALS[next].label}. ${next === 'calm' ? 'No lives; a collision trims the strand.' : next === 'play' ? 'Three lives.' : 'Starts hot.'}`);
      showMsg(DIALS[next].label, 3, 0.8);
    }
    function toggleSound() { soundOn = !soundOn; audio.unlock(); audio.mute(!soundOn); syncButtons(); save(); }
    function toggleCrt() { crtOn = !crtOn; syncButtons(); save(); }
    const fullscreenEl = () => document.fullscreenElement || document.webkitFullscreenElement || null;
    function toggleFull() {
      if (fullscreenEl()) { const exit = document.exitFullscreen || document.webkitExitFullscreen; if (exit) { try { const p = exit.call(document); if (p && p.catch) p.catch(() => {}); } catch {} } return; }
      const req = stage.requestFullscreen || stage.webkitRequestFullscreen;
      if (req) { try { const p = req.call(stage); if (p && p.catch) p.catch(() => {}); } catch {} }
    }
    // A mouse or touch click leaves focus on the button; hand it back so Space starts again. Keyboard activation keeps focus.
    const press = (el, fn) => el.addEventListener('click', (e) => { fn(); if (e.detail > 0) el.blur(); });
    press(btn.machine, () => { audio.unlock(); setMachine(machineId === 'xl' ? 'c64' : 'xl'); });
    press(btn.dial, () => { audio.unlock(); cycleDial(); });
    press(btn.sound, toggleSound);
    press(btn.crt, toggleCrt);
    press(btn.full, toggleFull);
    if (!document.fullscreenEnabled && !stage.webkitRequestFullscreen) btn.full.hidden = true;
    document.addEventListener('fullscreenchange', () => { syncButtons(); resize(); });
    document.addEventListener('webkitfullscreenchange', () => { syncButtons(); resize(); });

    // ---------- go ----------
    syncButtons();
    resize();
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(screen); else window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 120));
    beginBoot();
    requestAnimationFrame(frame);
  }
</script>
