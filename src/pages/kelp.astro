---
/**
 * /kelp — a snake for the 8-bit heart.
 *
 * Thread 2 of 5 on Michael Hoydich's 2026-10-22 games brief: 80s innocence,
 * the joy of the compute and flow, mood-state symbiosis, mobile and full
 * screen, audio-visual multimedia, Atari and Commodore inspired, rendered
 * modern. Snake the way Rock-Ola's Nibbler (1982) and the home-computer
 * type-in listings did it: a strand grows on a portrait grid by eating
 * plankton, the frame is the wall, and each stage stands a new rock pattern.
 *
 * The playfield is drawn from the Breakwater 3x5 pixel font and plain rects;
 * every sound is synthesized in the browser. Shared modules come from
 * src/lib/breakwater (font, palettes, mood); the grid, strand, growth,
 * collision and stage logic is src/lib/kelp, covered by tests/kelp.test.mjs.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { MACHINES } from '../lib/breakwater/waves.mjs';
import { DIALS } from '../lib/breakwater/mood.mjs';
import { COLS, ROWS, PATTERNS } from '../lib/kelp/grid.mjs';

const description = 'A snake game with 1980s innocence: a kelp strand grows across a 24 by 32 grid in Atari 800XL or Commodore 64 blue, rocks spelled from a pixel font, synthesized chip sound, and a mood the game and you keep together. Swipe on a phone, arrows on a desk, full screen if you want it.';
const canonical = 'https://pointcast.xyz/kelp';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: 'Kelp',
      alternateName: 'Kelp: a snake for the 8-bit heart',
      description,
      url: canonical,
      image: 'https://pointcast.xyz/images/kelp/og.png',
      gamePlatform: 'Web browser',
      genre: 'Snake',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Michael Hoydich' },
      contributor: { '@type': 'Organization', name: 'Claude Code' },
      publisher: { '@type': 'Organization', name: 'PointCast', url: 'https://pointcast.xyz/' },
      datePublished: '2026-10-22',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pointcast.xyz/' },
        { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://pointcast.xyz/games/' },
        { '@type': 'ListItem', position: 3, name: 'Kelp', item: canonical },
      ],
    },
  ],
};
const machines = Object.values(MACHINES);
const dials = Object.values(DIALS);
const patternWords = PATTERNS.join(', ');
---

<BlockLayout
  title="Kelp"
  description={description}
  image="/images/kelp/og.png"
  imageAlt="A blue portrait grid with a rainbow kelp strand winding between pixel-font rocks toward a white plankton, beside the words Kelp, a snake for the 8-bit heart."
  themeColor="#2545a8"
  immersive
  isolated
  jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/kelp.json', title: 'Kelp rules, moods and machines (JSON)' }]}
  frame={{
    image: 'https://pointcast.xyz/images/kelp/og.png',
    buttons: [
      { label: 'Play Kelp', action: 'link', target: canonical },
      { label: 'Game JSON', action: 'link', target: `${canonical}.json` },
    ],
  }}
>
  <div class="kp" data-kp data-machine="xl" data-crt="on">
    <div class="kp-stage" data-stage>
      <header class="kp-bar">
        <a class="kp-home" href="/" aria-label="PointCast home">POINTCAST</a>
        <span class="kp-name" aria-hidden="true">KELP</span>
        <div class="kp-controls" role="group" aria-label="Game settings">
          <button type="button" data-machine-btn title="Switch machine (1 / 2)">800XL</button>
          <button type="button" data-dial-btn title="Mood dial (3)">PLAY</button>
          <button type="button" data-sound-btn aria-pressed="true" title="Sound (M)">SND</button>
          <button type="button" data-crt-btn aria-pressed="true" title="CRT scanlines (C)">CRT</button>
          <button type="button" data-full-btn title="Full screen (F)">FULL</button>
        </div>
      </header>
      <div class="kp-screen" data-screen>
        <canvas data-canvas role="img" aria-label="Kelp playfield. Swipe or use the arrow keys to steer the strand; tap or press space to start."></canvas>
        <div class="kp-scan" aria-hidden="true"></div>
        <noscript><p class="kp-noscript">Kelp needs JavaScript to grow the strand and make its sounds. The rules and moods are readable at <a href="/kelp.json">/kelp.json</a>.</p></noscript>
      </div>
      <footer class="kp-readout" aria-label="Live readout">
        <span data-r-mood>DAWN</span>
        <span data-r-tempo>96 BPM</span>
        <span data-r-stage>STAGE 1</span>
        <span data-r-fps>-- FPS</span>
        <span data-r-len>LEN 4</span>
        <a href="#notes" data-notes-link>notes ↓</a>
      </footer>
      <p class="sr-only" data-live role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <section id="notes" class="kp-notes">
      <p class="kp-eyebrow">PointCast / Games / Kelp</p>
      <h1>A snake for the 8-bit heart.</h1>
      <p class="kp-lede">Twenty-four by thirty-two cells, a strand that grows with every plankton, rocks spelled from a pixel font, and a mood that the game and you keep together. Pick the blue you grew up with.</p>

      <div class="kp-grid">
        <article>
          <h2>Mood, both ways</h2>
          <p>The game keeps two numbers with you. Every plankton raises its <strong>energy</strong>, and an unbroken run raises it faster. A collision lowers its <strong>calm</strong>. Time brings both back toward the dial you set. Four words name where it is.</p>
          <ul class="kp-moods">
            <li><b>DAWN</b> warming up. Cool colors, a slow major arpeggio, the strand's bands hold still.</li>
            <li><b>FLOW</b> an unbroken run. Bright colors, the bands start to cycle, plankton worth half again as much.</li>
            <li><b>RUSH</b> hot colors, raster bars in the border, faster ticks, and a golden plankton worth triple that speeds you up when you eat it.</li>
            <li><b>DRIFT</b> after collisions. The ticks slow, the rocks thin on the next stage, and the next strand starts shorter.</li>
          </ul>
          <p>Your side is the dial: {dials.map((d, i) => <span><b>{d.label}</b> ({d.id === 'calm' ? 'no lives; a collision trims the strand back to its start length' : d.id === 'play' ? 'three lives, one more every third stage' : 'starts hot, leans into the golden plankton'}){i < dials.length - 1 ? '; ' : '.'}</span>)} The game relaxes toward it. The mood tape from your session stays in this browser, and when you leave after a game, the game hands its mood to the town.</p>
        </article>
        <article>
          <h2>Two machines</h2>
          {machines.map((m) => (
            <p><b style={`color:${m.bands.yellow}`}>{m.name}</b> ({m.year}, {m.chip}). {m.id === 'xl' ? 'The Graphics 0 blue with a black border and light-blue text. Raw square waves with a noise bite, in the POKEY spirit. A blue READY and a RUN before the water.' : 'The blue field inside a light-blue border. A resonant filter sweep on every voice, in the SID spirit. 38911 BASIC BYTES FREE, then LOAD, then RUN.'}</p>
          ))}
          <p>Nothing is emulated and nothing is copied. The pixel font, the palettes and the mood model are shared with <a href="/breakwater">Breakwater</a>, the first cabinet in this row; the grid, the rock patterns, the music and the sounds were written for this page. Read the <a href="https://github.com/mhoydich/pointcast/blob/main/docs/notes/2026-10-22-kelp-notes.md">note on Nibbler and the home-computer snake listings</a>.</p>
        </article>
        <article>
          <h2>The rules</h2>
          <p>The strand swims one cell per tick and turns at right angles. Each plankton adds one segment and ten points times the stage number. The frame is the wall; the wall, a rock or your own strand costs a life. A stage is cleared at a target length (twelve on the first, four more on each after), and the next stage stands a new rock pattern: {patternWords}. The nameplate spells your machine and the counter spells the stage. Three lives, one more every third stage, no lives at all on CALM.</p>
          <h2>Controls</h2>
          <ul>
            <li>Swipe anywhere on the field to turn; keep your finger down and swipe again to turn again. Tap to start.</li>
            <li>Keys: arrows or W A S D turn, Space starts, P pauses, F full screen, M sound, C scanlines, 1 and 2 switch machines, 3 turns the dial.</li>
            <li>FULL uses the Fullscreen API. iOS Safari has none for pages, so the stage fills the screen instead; add to Home Screen for the whole display.</li>
          </ul>
        </article>
      </div>

      <footer class="kp-credits">
        <p>Directed by Michael Hoydich. Designed and built by Claude Code on October 22, 2026, as thread 2 of 5 on the games brief. Original code, art and synthesized sound; no ROMs, no recordings. Machine names are tributes.</p>
        <p><a href="/kelp.json">kelp.json</a> · <a href="/breakwater">Breakwater</a> · <a href="/games/">All games</a> · <a href="/play">The play layer</a> · <a href="/">PointCast</a></p>
      </footer>
    </section>
  </div>
</BlockLayout>

<style is:global>
  html[data-pc-layout='block'] body.pc-block-shell { padding-bottom: 0; background: #0b0d1a; }
</style>

<style>
  .kp { --field: #2545a8; --border: #000000; --text: #a9b9f5; --paddle: #f4d27a; --bright: #ffffff; background: #0b0d1a; color: #dfe3f5; font-family: var(--pc-font-mono); min-height: 100vh; min-height: 100dvh; }
  .kp[data-machine='c64'] { --field: #3e31a2; --border: #7c70da; --text: #7c70da; --paddle: #75cec8; }
  .kp-stage { display: flex; flex-direction: column; height: 100vh; height: 100dvh; min-height: 320px; background: var(--border); }
  .kp-stage:fullscreen { height: 100%; min-height: 0; }
  .kp-stage:-webkit-full-screen { height: 100%; min-height: 0; }
  .kp-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; background: #0b0d1a; border-bottom: 1px solid #1d2140; font-size: 11px; letter-spacing: 0.12em; }
  .kp-home { color: var(--text); text-decoration: none; font-weight: 700; }
  .kp-home:hover { color: #fff; }
  .kp-name { color: #fff; font-weight: 700; margin-right: auto; }
  .kp-controls { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .kp-controls button { font: 700 10px/1 var(--pc-font-mono); letter-spacing: 0.1em; color: #dfe3f5; background: #15183a; border: 1px solid #2b3070; border-radius: 3px; padding: 7px 9px; cursor: pointer; min-width: 44px; min-height: 30px; touch-action: manipulation; }
  .kp-controls button:hover { background: #1f2456; }
  .kp-controls button[aria-pressed='false'] { color: #9aa1cc; text-decoration: line-through; }
  .kp-controls button:focus-visible { outline: 2px solid var(--paddle); outline-offset: 2px; }
  .kp-screen { position: relative; flex: 1; min-height: 0; background: var(--border); overflow: hidden; }
  .kp-screen canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .kp-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity: 0.55; }
  .kp[data-crt='off'] .kp-scan { display: none; }
  .kp-noscript { position: absolute; inset: 0; margin: 0; padding: 24px; color: #fff; background: var(--field); font-size: 14px; line-height: 1.5; }
  .kp-noscript a { color: var(--paddle); }
  .kp-readout { display: flex; gap: 14px; flex-wrap: nowrap; align-items: center; height: 28px; overflow: hidden; white-space: nowrap; padding: 0 12px; font-size: 10px; letter-spacing: 0.1em; color: #7f86b5; background: #0b0d1a; border-top: 1px solid #1d2140; }
  .kp-readout span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .kp-readout a { margin-left: auto; flex-shrink: 0; color: var(--text); text-decoration: none; }
  .kp-readout a:hover { color: #fff; }
  .kp-stage:fullscreen .kp-readout a { display: none; }
  .kp-stage:-webkit-full-screen .kp-readout a { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .kp-notes { max-width: 1080px; margin: 0 auto; padding: 56px 20px 72px; font-family: var(--pc-font-sans); color: #dfe3f5; }
  .kp-eyebrow { font: 700 11px/1.4 var(--pc-font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #7f86b5; margin: 0 0 14px; }
  .kp-notes h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; color: #fff; }
  .kp-lede { font-size: 18px; line-height: 1.5; max-width: 60ch; color: #c9cfee; margin: 0 0 36px; }
  .kp-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .kp-grid article { border-top: 2px solid #2b3070; padding-top: 18px; font-size: 14px; line-height: 1.55; }
  .kp-grid h2 { font: 700 12px/1.4 var(--pc-font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paddle); margin: 0 0 10px; }
  .kp-grid h2 + h2, .kp-grid p + h2, .kp-grid ul + h2 { margin-top: 22px; }
  .kp-grid p { margin: 0 0 12px; }
  .kp-grid ul { margin: 0 0 12px; padding-left: 18px; }
  .kp-grid li { margin-bottom: 6px; }
  .kp-moods { list-style: none; padding: 0; }
  .kp-moods b { display: inline-block; min-width: 54px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.1em; color: #fff; }
  .kp-notes a { color: #a9b9f5; }
  .kp-notes a:hover { color: #fff; }
  .kp-credits { margin-top: 44px; border-top: 1px solid #2b3070; padding-top: 18px; font-size: 13px; line-height: 1.6; color: #9aa1cc; }
  .kp-credits p { margin: 0 0 8px; }
  @media (max-width: 760px) {
    .kp-stage { min-height: 0; }
    .kp-bar { gap: 8px; padding: 6px 10px; }
    .kp-name { display: none; }
    .kp-controls { gap: 4px; }
    .kp-controls button { padding: 7px 7px; min-width: 40px; font-size: 9px; }
    .kp-readout { gap: 10px; font-size: 9px; height: 26px; }
    .kp-readout [data-r-fps], .kp-readout [data-r-tempo] { display: none; }
    .kp-grid { grid-template-columns: 1fr; gap: 20px; }
    .kp-notes { padding: 40px 16px 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .kp-scan { opacity: 0.35; } }
</style>

<script>
  import { MACHINES } from '../lib/breakwater/waves.mjs';
  import { DIALS, DIAL_IDS, createMood, moodEvent, moodStep, moodResponse, setDial, beginGame, serializeMood, restoreMood, dialFromSiteMood, siteMoodFromLabel } from '../lib/breakwater/mood.mjs';
  import { eachPixel, textWidth } from '../lib/breakwater/font.mjs';
  import { COLS, ROWS, DIRS, cellKey } from '../lib/kelp/grid.mjs';
  import { createGame, setDirection, tick, respawn, nextStage, setMachine as setGameMachine, start as startGame, autoDirection, startLengthFor, tickInterval, noteForLength } from '../lib/kelp/strand.mjs';

  const root = document.querySelector('[data-kp]');
  if (root) main(root);

  function main(root) {
    // ---------- geometry (logical pixels) ----------
    const W = 288, CELL = 11, WALL = 12, HUD = 32, GRID_X = WALL, GRID_Y = HUD + 4;
    const GRID_W = COLS * CELL, GRID_H = ROWS * CELL, H = GRID_Y + GRID_H + 8;
    const STORE = 'kelp:v1';
    const SWIPE = 18;
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = matchMedia('(pointer: coarse)').matches;

    const stage = root.querySelector('[data-stage]');
    const screen = root.querySelector('[data-screen]');
    const canvas = root.querySelector('[data-canvas]');
    const ctx = canvas.getContext('2d', { alpha: false });
    const live = root.querySelector('[data-live]');
    const btn = {
      machine: root.querySelector('[data-machine-btn]'),
      dial: root.querySelector('[data-dial-btn]'),
      sound: root.querySelector('[data-sound-btn]'),
      crt: root.querySelector('[data-crt-btn]'),
      full: root.querySelector('[data-full-btn]'),
    };
    const readout = {
      mood: root.querySelector('[data-r-mood]'),
      tempo: root.querySelector('[data-r-tempo]'),
      stage: root.querySelector('[data-r-stage]'),
      fps: root.querySelector('[data-r-fps]'),
      len: root.querySelector('[data-r-len]'),
    };

    // ---------- settings ----------
    const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || 'null') || {}; } catch { return {}; } };
    const readSiteMood = () => { try { return localStorage.getItem('pc:mood'); } catch { return null; } };
    const settings = load();
    let machineId = MACHINES[settings.machine] ? settings.machine : 'xl';
    let soundOn = settings.sound !== false;
    let crtOn = settings.crt !== false;
    let best = Number.isFinite(settings.best) ? settings.best : 0;
    let mood = restoreMood(settings.mood, DIALS[settings.dial] ? settings.dial : dialFromSiteMood(readSiteMood()));
    let response = moodResponse(mood);
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ best, machine: machineId, dial: mood.dial, sound: soundOn, crt: crtOn, mood: serializeMood(mood) })); } catch {}
    };
    // The town only inherits a mood from a game that was actually played, never from a glance at the title.
    const handMoodToTown = () => { if (!G.played) return; try { localStorage.setItem('pc:mood', siteMoodFromLabel(mood.label)); } catch {} };

    // ---------- helpers ----------
    const M = () => MACHINES[machineId];
    const rnd = (a, b) => a + Math.random() * (b - a);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
    const mix = (a, b, t) => { const A = hex(a), B = hex(b); return rgb([0, 1, 2].map((i) => Math.round(A[i] + (B[i] - A[i]) * t))); };
    const announce = (text) => { if (live) live.textContent = text; };
    const buzz = (ms) => { if (COARSE && navigator.vibrate) { try { navigator.vibrate(ms); } catch {} } };
    const cx = (c) => GRID_X + c * CELL;
    const cy = (r) => GRID_Y + r * CELL;

    // ---------- audio ----------
    const audio = (() => {
      let ac = null, master, sfx, music;
      let tempo = 100, scale = 'major', density = 0.5, musicOn = false, wantMusic = false;
      let nextNote = 0, step = 0, timer = 0;
      const midi = (n) => 440 * Math.pow(2, (n - 69) / 12);
      // A tide, not a riff: two bars per chord, eighth notes, the lead rising and falling like a swell.
      const PROG = {
        major: [[48, 55, 60, 64, 67], [45, 52, 57, 60, 64], [41, 48, 53, 57, 60], [43, 50, 55, 59, 62]],
        bright: [[48, 55, 62, 64, 67], [50, 57, 62, 66, 69], [53, 60, 64, 67, 71], [55, 62, 66, 69, 74]],
        minor: [[45, 52, 57, 60, 64], [41, 48, 53, 57, 60], [38, 45, 50, 53, 57], [40, 47, 52, 56, 59]],
        soft: [[48, 55, 60, 67, 71], [45, 52, 60, 64, 67], [41, 48, 57, 60, 64], [43, 50, 59, 62, 67]],
      };
      const SWELL = [1, 2, 3, 4, 3, 2, 1, 2];
      function ensure() {
        if (ac) { if (ac.state === 'suspended') ac.resume().catch(() => {}); return ac; }
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return null;
        ac = new AC();
        const comp = ac.createDynamicsCompressor();
        comp.threshold.value = -18; comp.ratio.value = 6;
        master = ac.createGain(); master.gain.value = soundOn ? 0.55 : 0;
        master.connect(comp); comp.connect(ac.destination);
        sfx = ac.createGain(); sfx.gain.value = 0.7; sfx.connect(master);
        music = ac.createGain(); music.gain.value = 0.3; music.connect(master);
        return ac;
      }
      function voice({ freq, type = 'square', t = ac.currentTime, dur = 0.12, vol = 0.3, slide = 0, dest = sfx, a = 0.004, r = 0.05, detune = 0 }) {
        if (!ac) return;
        const o = ac.createOscillator();
        o.type = type;
        o.frequency.setValueAtTime(freq, t);
        if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * slide), t + dur);
        o.detune.value = detune;
        const g = ac.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(vol, t + a);
        g.gain.setTargetAtTime(vol * 0.5, t + a + dur * 0.3, Math.max(0.01, dur * 0.3));
        g.gain.setTargetAtTime(0.0001, t + dur, r);
        o.connect(g);
        let out = g;
        if (machineId === 'c64') {
          const f = ac.createBiquadFilter();
          f.type = 'lowpass'; f.Q.value = 5;
          f.frequency.setValueAtTime(Math.min(12000, freq * 6), t);
          f.frequency.exponentialRampToValueAtTime(Math.max(120, freq * 1.2), t + dur + 0.05);
          g.connect(f); out = f;
        }
        out.connect(dest);
        o.start(t); o.stop(t + dur + r * 5 + 0.05);
      }
      function noise(t, dur = 0.05, vol = 0.12, freq = 2400) {
        if (!ac) return;
        const len = Math.max(1, Math.floor(ac.sampleRate * dur));
        const buf = ac.createBuffer(1, len, ac.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i += 1) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
        const s = ac.createBufferSource(); s.buffer = buf;
        const f = ac.createBiquadFilter(); f.type = freq < 600 ? 'lowpass' : 'bandpass'; f.frequency.value = freq; f.Q.value = 0.8;
        const g = ac.createGain(); g.gain.value = vol;
        s.connect(f); f.connect(g); g.connect(sfx); s.start(t);
      }
      const lead = () => 'square';
      const bass = () => (machineId === 'c64' ? 'triangle' : 'square');
      function playStep(s, t) {
        const chords = PROG[scale] || PROG.major;
        const chord = chords[Math.floor(s / 16) % chords.length];
        const idx = s % 16;
        if (idx === 0) voice({ freq: midi(chord[0] - 12), type: bass(), t, dur: 0.6, vol: 0.16, dest: music, a: 0.02, r: 0.2 });
        if (idx === 8 && scale !== 'soft') voice({ freq: midi(chord[1] - 12), type: bass(), t, dur: 0.3, vol: 0.12, dest: music, a: 0.02, r: 0.12 });
        const gate = scale === 'soft' ? 0.3 : 0.5 + density * 0.5;
        if (idx % 2 === 0 && Math.random() < gate) {
          const n = chord[SWELL[(idx / 2) % SWELL.length]] + (scale === 'bright' && idx === 6 ? 12 : 0);
          voice({ freq: midi(n), type: lead(), t, dur: scale === 'soft' ? 0.26 : 0.11, vol: scale === 'soft' ? 0.08 : 0.1, dest: music, r: 0.05, detune: machineId === 'xl' ? 5 : 0 });
        }
