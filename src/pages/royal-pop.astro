---
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Royal Pop';
const description =
  'PointCast’s pop-art pocket-clock wall — eight octagonal time signals, a love letter to the Audemars Piguet × Swatch Royal Pop drop (May 16, 2026).';

type Pocket = {
  slug: string;
  name: string;
  signal: string;
  caseColor: string;
  bezel: string;
  dial: string;
  ink: string;
  hand: string;
  accent: string;
  lanyard: string;
  cue: string;
  href: string;
  /** initial hour-fraction for the static (no-JS) render, 0..12 */
  hour: number;
  /** initial minute, 0..60 */
  minute: number;
};

const POCKETS: Pocket[] = [
  {
    slug: 'blue-hour',
    name: 'Blue Hour',
    signal: 'twilight at the strand',
    caseColor: '#0E2F66',
    bezel: '#2F69C0',
    dial: '#88B6F2',
    ink: '#0B1A36',
    hand: '#FFFFFF',
    accent: '#F7C325',
    lanyard: '#0B1A36',
    cue: 'El Segundo · 19:42 PT',
    href: '/sunset',
    hour: 7.7,
    minute: 42,
  },
  {
    slug: 'first-pour',
    name: 'First Pour',
    signal: 'coffee pot, live',
    caseColor: '#FFD1DC',
    bezel: '#E84D6A',
    dial: '#FBE9EE',
    ink: '#8A2432',
    hand: '#8A2432',
    accent: '#F7C325',
    lanyard: '#E84D6A',
    cue: 'pot 1 of 3 · ☕',
    href: '/coffee',
    hour: 7,
    minute: 5,
  },
  {
    slug: 'race-day',
    name: 'Race Day',
    signal: 'front-door countdown',
    caseColor: '#FFFFFF',
    bezel: '#FF2D9D',
    dial: '#FFFFFF',
    ink: '#0B1A36',
    hand: '#0B1A36',
    accent: '#2CC5A0',
    lanyard: '#F7C325',
    cue: 'next horn · 17:00 PT',
    href: '/race',
    hour: 4.5,
    minute: 27,
  },
  {
    slug: 'quiet-hours',
    name: 'Quiet Hours',
    signal: 'mesh on low',
    caseColor: '#FFFFFF',
    bezel: '#111111',
    dial: '#0B0B0B',
    ink: '#FFFFFF',
    hand: '#FFFFFF',
    accent: '#F7C325',
    lanyard: '#111111',
    cue: 'do-not-disturb · 22:00 → 07:00',
    href: '/quiet-hours',
    hour: 10.8,
    minute: 50,
  },
  {
    slug: 'sunrise',
    name: 'Sunrise',
    signal: 'morning ocean',
    caseColor: '#F7C325',
    bezel: '#2CC5A0',
    dial: '#A8F0DA',
    ink: '#0E4D3F',
    hand: '#0E4D3F',
    accent: '#FF8FB6',
    lanyard: '#FF8FB6',
    cue: 'tide · 06:14 PT',
    href: '/morning-ocean',
    hour: 6.25,
    minute: 14,
  },
  {
    slug: 'garden-yield',
    name: 'Garden Yield',
    signal: 'houseplants watered',
    caseColor: '#1B5E20',
    bezel: '#9CCC1B',
    dial: '#D4F26A',
    ink: '#0B2912',
    hand: '#0B2912',
    accent: '#FFFFFF',
    lanyard: '#9CCC1B',
    cue: 'next mist · 14:30 PT',
    href: '/houseplants',
    hour: 2.5,
    minute: 30,
  },
  {
    slug: 'sunset-strip',
    name: 'Sunset Strip',
    signal: 'mesh after dark',
    caseColor: '#6A2BB5',
    bezel: '#FF7A1A',
    dial: '#F4B45A',
    ink: '#2A1148',
    hand: '#2A1148',
    accent: '#FFFFFF',
    lanyard: '#FF7A1A',
    cue: 'dispatch drum · 21:00 PT',
    href: '/dispatch-drum',
    hour: 9,
    minute: 0,
  },
  {
    slug: 'now-pacific',
    name: 'Now Pacific',
    signal: 'the official PointCast minute',
    caseColor: '#F0EFE6',
    bezel: '#1B3A5B',
    dial: '#FFFFFF',
    ink: '#1B3A5B',
    hand: '#1B3A5B',
    accent: '#E84D6A',
    lanyard: '#1B3A5B',
    cue: 'PT · always',
    href: '/now',
    hour: 10.3,
    minute: 18,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/royal-pop',
  name: 'Royal Pop — PointCast pocket-clock wall',
  description,
  url: 'https://pointcast.xyz/royal-pop',
  isBasedOn: {
    '@type': 'Product',
    name: 'Audemars Piguet × Swatch — Royal Pop',
    url: 'https://www.swatch.com/en-us/royal-pop.html',
  },
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="rp-page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>royal-pop</span>
    </nav>

    <header class="hero">
      <div class="hero-kicker">
        <span class="dot dot-yellow"></span>
        <span class="dot dot-red"></span>
        <span class="dot dot-blue"></span>
        <span class="dot dot-green"></span>
        <span class="kicker-text">POINTCAST × POP ART · 2026-05-16</span>
      </div>
      <h1>ROYAL&nbsp;POP</h1>
      <p class="hero-deck">
        Eight pocket clocks for the broadcast town. Octagonal bezel, calfskin
        lanyard, one PointCast signal per dial. A tribute to the
        <a href="https://www.swatch.com/en-us/royal-pop.html" target="_blank" rel="noopener">Audemars
        Piguet × Swatch Royal Pop</a> collection that dropped this morning.
      </p>
      <p class="hero-meta">
        CC0 homage · Bioceramic in spirit, SVG in fact · Pacific minute, always
      </p>
    </header>

    <section class="wall" aria-label="Pocket clocks">
      {POCKETS.map((p) => (
        <a
          href={p.href}
          class="pocket"
          data-slug={p.slug}
          style={`--case:${p.caseColor};--bezel:${p.bezel};--dial:${p.dial};--ink:${p.ink};--hand:${p.hand};--accent:${p.accent};--lanyard:${p.lanyard};`}
        >
          <div class="lanyard" aria-hidden="true">
            <span class="loop"></span>
            <span class="rope"></span>
          </div>
          <div class="case">
            <svg class="octagon" viewBox="0 0 200 200" aria-hidden="true">
              <defs>
                <clipPath id={`clip-${p.slug}`}>
                  <polygon points="60,8 140,8 192,60 192,140 140,192 60,192 8,140 8,60" />
                </clipPath>
              </defs>
              <polygon
                points="60,8 140,8 192,60 192,140 140,192 60,192 8,140 8,60"
                fill="var(--bezel)"
                stroke="var(--ink)"
                stroke-width="2"
              />
              <g clip-path={`url(#clip-${p.slug})`}>
                <polygon
                  points="64,22 136,22 178,64 178,136 136,178 64,178 22,136 22,64"
                  fill="var(--dial)"
                />
              </g>
              {/* hex screws */}
              {[
                [44, 22], [156, 22], [178, 44], [178, 156],
                [156, 178], [44, 178], [22, 156], [22, 44],
              ].map(([cx, cy]) => (
                <circle cx={cx} cy={cy} r="3.2" fill="var(--ink)" opacity="0.55" />
              ))}
              {/* hour ticks */}
              {Array.from({ length: 12 }).map((_, i) => {
                const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
                const r1 = 70;
                const r2 = i % 3 === 0 ? 60 : 64;
                const x1 = 100 + Math.cos(a) * r1;
                const y1 = 100 + Math.sin(a) * r1;
                const x2 = 100 + Math.cos(a) * r2;
                const y2 = 100 + Math.sin(a) * r2;
                return (
                  <line
                    x1={x1}
                    y1={y1}
                    x2={x2}
                    y2={y2}
                    stroke="var(--ink)"
                    stroke-width={i % 3 === 0 ? 3 : 1.5}
                    stroke-linecap="round"
                    opacity="0.85"
                  />
                );
              })}
              {/* hands — initial static angle; JS will animate live */}
              <g
                class="hand-hour"
                style={`transform-origin:100px 100px;transform:rotate(${p.hour * 30}deg);`}
              >
                <rect x="97" y="50" width="6" height="55" rx="2" fill="var(--hand)" />
              </g>
              <g
                class="hand-minute"
                style={`transform-origin:100px 100px;transform:rotate(${p.minute * 6}deg);`}
              >
                <rect x="98.5" y="32" width="3" height="73" rx="1.5" fill="var(--hand)" />
              </g>
              <circle cx="100" cy="100" r="5.5" fill="var(--ink)" />
              <circle cx="100" cy="100" r="2" fill="var(--accent)" />
              {/* crown */}
              <rect x="96" y="0" width="8" height="6" fill="var(--ink)" />
            </svg>
          </div>
          <div class="plate">
            <div class="plate-row">
              <span class="model-no">N°&nbsp;{String(POCKETS.indexOf(p) + 1).padStart(2, '0')}</span>
              <span class="model-name">{p.name}</span>
            </div>
            <div class="signal">{p.signal}</div>
            <div class="cue">{p.cue}</div>
          </div>
        </a>
      ))}
    </section>

    <section class="colophon">
      <div class="col">
        <h2>About the wall</h2>
        <p>
          The Royal Pop collection (Audemars Piguet × Swatch, eight Bioceramic
          pocket watches in octagonal Royal Oak silhouettes) hit shelves this
          morning. This page is the PointCast version: eight pop-art pocket
          clocks, one per resident time signal — Blue Hour, First Pour, Race
          Day, Quiet Hours, Sunrise, Garden Yield, Sunset Strip, Now Pacific.
        </p>
        <p>
          No bezel was harmed; the octagon and lanyard are CC0 SVG. Tap any
          face to follow that signal into the rest of town.
        </p>
      </div>
      <div class="col">
        <h2>The eight</h2>
        <ol class="legend">
          {POCKETS.map((p, i) => (
            <li>
              <span class="swatch" style={`background:${p.bezel};border-color:${p.caseColor};`}></span>
              <a href={p.href}>{p.name}</a>
              <span class="legend-sub">— {p.signal}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      function tick() {
        var now = new Date();
        var h = now.getHours() % 12;
        var m = now.getMinutes();
        var s = now.getSeconds();
        var minuteAngle = (m + s / 60) * 6;
        var hourAngle = (h + m / 60) * 30;
        document.querySelectorAll('.pocket').forEach(function (el) {
          var hh = el.querySelector('.hand-hour');
          var mh = el.querySelector('.hand-minute');
          if (hh) hh.style.transform = 'rotate(' + hourAngle + 'deg)';
          if (mh) mh.style.transform = 'rotate(' + minuteAngle + 'deg)';
        });
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</BlockLayout>

<style>
  .rp-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px 16px 64px;
    font-family: var(--font-body);
    color: var(--color-ink);
  }

  .crumb {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }
  .crumb a { color: var(--color-ink); text-decoration: none; border-bottom: 1px dotted var(--color-rule); }

  /* ── Hero ── */
  .hero {
    border: 2px solid var(--color-ink);
    background: repeating-linear-gradient(
      45deg,
      #fff8e1 0 18px,
      #fff 18px 36px
    );
    padding: 24px 22px 28px;
    margin-bottom: 26px;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -2px -2px auto auto;
    width: 64px; height: 18px;
    background: var(--color-nouns-red);
    border: 2px solid var(--color-ink);
    border-bottom: none;
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .dot { width: 10px; height: 10px; border: 1.5px solid var(--color-ink); display: inline-block; }
  .dot-yellow { background: var(--color-nouns-yellow); }
  .dot-red { background: var(--color-nouns-red); }
  .dot-blue { background: var(--color-nouns-blue); }
  .dot-green { background: var(--color-nouns-green); }
  .kicker-text { margin-left: 4px; }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(56px, 12vw, 144px);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 8px 0 14px;
    color: var(--color-ink);
    text-shadow: 4px 4px 0 var(--color-nouns-yellow), 8px 8px 0 var(--color-nouns-red);
  }
  .hero-deck {
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 10px;
  }
  .hero-deck a { color: var(--color-ink); border-bottom: 2px solid var(--color-nouns-yellow); text-decoration: none; }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── Wall ── */
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 40px;
  }
  @media (max-width: 980px) { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .wall { grid-template-columns: 1fr; } }

  .pocket {
    background: var(--case);
    border: 2px solid var(--color-ink);
    padding: 14px 12px 12px;
    text-decoration: none;
    color: var(--ink);
    position: relative;
    box-shadow: 6px 6px 0 var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .pocket:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 var(--color-ink);
  }
  .pocket:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .lanyard {
    position: relative;
    height: 26px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .lanyard .loop {
    width: 36px;
    height: 18px;
    border: 2px solid var(--color-ink);
    border-bottom: none;
    border-radius: 18px 18px 0 0;
    background: var(--lanyard);
  }
  .lanyard .rope {
    position: absolute;
    top: 14px;
    width: 2px;
    height: 14px;
    background: var(--color-ink);
  }

  .case {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    background: var(--case);
  }
  .octagon { width: 92%; height: 92%; display: block; }
  .hand-hour, .hand-minute { transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1); }

  .plate {
    width: 100%;
    background: #fff;
    border: 1.5px solid var(--color-ink);
    padding: 8px 10px;
    display: grid;
    gap: 2px;
  }
  .plate-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .model-no {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
  }
  .model-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .signal {
    font-size: 13px;
    color: var(--color-ink);
  }
  .cue {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* ── Colophon ── */
  .colophon {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 28px;
    border-top: 2px solid var(--color-ink);
    padding-top: 24px;
  }
  @media (max-width: 760px) { .colophon { grid-template-columns: 1fr; } }
  .colophon h2 {
    font-family: var(--font-heading);
    font-size: 22px;
    margin: 0 0 10px;
  }
  .colophon p { margin: 0 0 10px; font-size: 15px; line-height: 1.6; }

  .legend { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .legend li { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .legend a { color: var(--color-ink); border-bottom: 1px dotted var(--color-rule); text-decoration: none; }
  .legend a:hover { border-bottom-color: var(--color-ink); }
  .legend-sub { color: var(--color-ink-soft); font-size: 13px; }
  .swatch {
    width: 14px; height: 14px;
    border: 2px solid var(--color-ink);
    display: inline-block;
  }

  @media (prefers-color-scheme: dark) {
    .rp-page { color: var(--color-ink); }
  }
</style>

