---
/**
 * /radio-network/kit — the Phase 0 launch kit for Radio El Segundo: six-week
 * pilot plan, The Town Desk rundown, gear, station IDs, underwriting rules,
 * a printable consent form, neighbor questions and the first volunteer shift.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/radio-network.css';
import {
  CONSENT,
  CREDIT_RULES,
  CREDIT_TEMPLATE,
  GEAR,
  NEIGHBOR_QUESTIONS,
  PILOT_WEEKS,
  RUNDOWN,
  STATION_IDS,
  VOLUNTEER_SHIFT,
} from '../../data/radio-kit';

const title = 'Radio El Segundo launch kit — PointCast Radio Network';
const description =
  'Everything a first host needs to make four pilot episodes of The Town Desk: a six-week plan, the show rundown, gear, station IDs, underwriting rules, a consent form and the first volunteer shift.';
---

<BlockLayout
  title={title}
  description={description}
  author="PointCast"
  alternates={[{ type: 'application/json', href: '/radio-network/kit.json', title: 'Radio El Segundo launch kit' }]}
>
  <div class="rn">
    <div class="rn-wrap">
      <header class="rn-mast">
        <a class="logo" href="/radio-network">PointCast <b>Radio Network</b></a>
        <nav>
          <a href="#weeks">Six weeks</a>
          <a href="#rundown">Rundown</a>
          <a href="#gear">Gear</a>
          <a href="#ids">Station IDs</a>
          <a href="#credits">Underwriting</a>
          <a href="#consent">Consent form</a>
          <a href="#volunteers">First shift</a>
          <a href="/radio-network/kit.json">JSON</a>
        </nav>
      </header>

      <p class="rn-kicker">Phase 0 · <a href="/radio-network/el-segundo">Radio El Segundo</a> · templates, nothing recorded yet</p>
      <h1>The launch kit: four episodes in six weeks.</h1>
      <p class="lede">
        Phase 0 is one weekly show, The Town Desk, and a stream test. This page is the working kit for whoever hosts it:
        the plan by week, the show rundown, what to buy, what to say at the top of the hour, and the form a neighbor signs
        before their voice goes out.
      </p>

      <section id="weeks">
        <h2>Six weeks</h2>
        <ol class="rn-phases">
          {PILOT_WEEKS.map((w) => (
            <li>
              <p class="rn-tag">Week {w.week}</p>
              <h3>{w.name}</h3>
              <ul class="rn-check">{w.tasks.map((t) => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>

      <section id="rundown">
        <h2>The Town Desk rundown</h2>
        <p class="lede">28 minutes, weekly. The same shape every week so listeners know where things are.</p>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>At</th><th>Length</th><th>Segment</th><th>Notes</th></tr></thead>
            <tbody>{RUNDOWN.map((r) => <tr><td class="mono">{r.at}</td><td class="mono">{r.len}</td><td><b>{r.item}</b></td><td>{r.note}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="gear">
        <h2>Starter gear</h2>
        <div class="rn-scroll">
          <table>
            <thead><tr><th>Item</th><th>Why</th></tr></thead>
            <tbody>{GEAR.map((g) => <tr><td><b>{g.item}</b></td><td>{g.why}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="rn-meta">No brands on purpose. Phase 0 budget on the plan: about $1,500–3,000, an estimate, not a quote.</p>
      </section>

      <section id="ids">
        <h2>Station IDs</h2>
        <p class="rn-meta">Neutral templates for the host to rework in their own words.</p>
        <div class="rn-grid two">
          {STATION_IDS.map((s) => (
            <article class="rn-card">
              <p class="rn-tag">{s.id}</p>
              <p>“{s.text}”</p>
            </article>
          ))}
        </div>
      </section>

      <section id="credits">
        <h2>Underwriting credits</h2>
        <ol class="rules">{CREDIT_RULES.map((r) => <li>{r}</li>)}</ol>
        <article class="rn-card"><p class="rn-tag">Template</p><p>{CREDIT_TEMPLATE}</p></article>
      </section>

      <section id="consent" class="rn-print">
        <h2>{CONSENT.title}</h2>
        <ul class="tight">{CONSENT.lines.map((l) => <li>{l}</li>)}</ul>
        <div class="rn-form">
          {CONSENT.fields.map((f) => <p><span>{f}</span><i></i></p>)}
        </div>
        <p class="rn-watch">{CONSENT.note}</p>
        <p class="rn-meta rn-noprint"><button type="button" data-print>Print the consent form</button></p>
      </section>

      <section id="questions">
        <h2>Neighbor voice: four questions</h2>
        <ol class="rules">{NEIGHBOR_QUESTIONS.map((q) => <li>{q}</li>)}</ol>
        <p class="rn-meta">Consent form first, recorder second. Five minutes on air from about fifteen recorded.</p>
      </section>

      <section id="volunteers">
        <h2>A volunteer's first shift</h2>
        <ul class="rn-check">{VOLUNTEER_SHIFT.map((v) => <li>{v}</li>)}</ul>
      </section>

      <footer class="rn-foot">
        Drafted by Claude Code at Mike Hoydich's request; not written in Mike's voice. The consent form is a template and
        needs counsel review before use. Back to <a href="/radio-network">the network plan</a>.
      </footer>
    </div>
  </div>
</BlockLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
