---
/**
 * /radio-network/print — a printable promo kit for Radio El Segundo's Phase 0
 * pilot. Eight concept sheets, one per printed letter page: a Main Street
 * poster, a two-up pocket schedule card, a neighbor-voice flyer with tear-off
 * tabs, an underwriting one-pager, a network map, a tuning guide, a bumper
 * sticker sheet and two door hangers.
 *
 * Concept art for a planned station. Nothing is on air: no frequency, phone
 * number, email or launch date appears anywhere, on purpose. Copy is pulled
 * from src/data/radio-network.ts and src/data/radio-kit.ts where it exists,
 * and is written in a neutral station voice, not Mike Hoydich's.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import '../../styles/radio-network.css';
import { CLOCK, PATHS, PHASES, RADIO_BASE, RULES, STATIONS, WEEK, stationBySlug, MONEY } from '../../data/radio-network';
import { CONSENT, CREDIT_RULES, CREDIT_TEMPLATE, NEIGHBOR_QUESTIONS, RUNDOWN, STATION_IDS } from '../../data/radio-kit';

const flagship = stationBySlug('el-segundo')!;
const hubUrl = RADIO_BASE.replace(/^https?:\/\//, '');
const kitUrl = `${hubUrl}/kit`;
const CONCEPT = 'Concept print campaign for a planned station. Not on air.';

// "This is Radio El Segundo. Local first, from 90245." -> "Local first, from 90245."
const tagline = STATION_IDS[0].text.replace(/^This is [^.]+\.\s*/, '');
// Last sentence of the closing ID: "Tell us what we missed."
const missed = STATION_IDS[1].text.split(/(?<=\.)\s+/).pop() ?? '';
const [showName, showWhat] = flagship.firstShow.split(' — ');
const neighborClock = CLOCK.find((c) => c.what.startsWith('Neighbor voice'))!;
const neighborLine = neighborClock.what.split(' — ')[1] ?? '';
const neighborRundown = RUNDOWN.find((r) => r.item === 'Neighbor voice');
const creditClock = CLOCK.find((c) => c.what.startsWith('Underwriting'))!;
const creditRundown = RUNDOWN.find((r) => r.item.startsWith('Underwriting'))!;
const creditRule = RULES.find((r) => r.startsWith('Underwriting'))!;
const firstSentence = (s: string) => s.split(/(?<=\.)\s+/)[0];
const pilot = PHASES[0];
// The blanks in the credit template: [business], [what it is ...], [street].
const draftFields = [...CREDIT_TEMPLATE.matchAll(/\[([^\]]+)\]/g)].map((m) => m[1].charAt(0).toUpperCase() + m[1].slice(1));

// Geographic order, north to south then inland, for the dial and the map.
const geo: Record<string, { x: number; y: number; dx: number; dy: number; anchor: 'start' | 'middle' }> = {
  'playa-del-rey': { x: 262, y: 150, dx: 24, dy: 0, anchor: 'start' },
  'el-segundo': { x: 268, y: 290, dx: 30, dy: 0, anchor: 'start' },
  'hawthorne-lawndale': { x: 460, y: 322, dx: 0, dy: 38, anchor: 'middle' },
  'manhattan-beach': { x: 284, y: 420, dx: 24, dy: 0, anchor: 'start' },
  'hermosa-beach': { x: 292, y: 505, dx: 24, dy: 0, anchor: 'start' },
  'redondo-beach': { x: 300, y: 590, dx: 24, dy: 0, anchor: 'start' },
  torrance: { x: 470, y: 660, dx: 0, dy: 38, anchor: 'middle' },
};
const dialOrder = ['playa-del-rey', 'el-segundo', 'hawthorne-lawndale', 'manhattan-beach', 'hermosa-beach', 'redondo-beach', 'torrance'];
const shortTown = (t: string) => t.split(' and ')[0].replace(' Beach', '');

// Poster dial: a half-circle scale with the seven towns, needle on El Segundo.
const DCX = 300, DCY = 320, DR = 215;
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(DCX + r * Math.cos(a)).toFixed(1), y: +(DCY + r * Math.sin(a)).toFixed(1) };
};
const ticks = Array.from({ length: 61 }, (_, i) => {
  const deg = 190 + i * (160 / 60);
  const long = i % 10 === 0;
  return { a: pt(deg, DR), b: pt(deg, DR - (long ? 26 : i % 5 === 0 ? 18 : 10)), long };
});
const dialMarks = dialOrder.map((slug, i) => {
  const deg = 206 + i * (128 / (dialOrder.length - 1));
  const s = stationBySlug(slug)!;
  return { slug, deg, label: shortTown(s.town), p: pt(deg, DR + 46), dot: pt(deg, DR + 14), flag: s.role === 'flagship' };
});
const needleDeg = dialMarks.find((m) => m.flag)!.deg;
const needleTip = pt(needleDeg, DR + 2);

// Hour clock wheel for the pocket card.
const toMin = (s: string) => parseInt(s.replace(/\D/g, ''), 10);
const arcPath = (cx: number, cy: number, r1: number, r2: number, m0: number, m1: number) => {
  const a0 = (m0 / 60) * 2 * Math.PI - Math.PI / 2;
  const a1 = (m1 / 60) * 2 * Math.PI - Math.PI / 2;
  const large = m1 - m0 > 30 ? 1 : 0;
  const p = (r: number, a: number) => `${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  return `M${p(r2, a0)} A${r2} ${r2} 0 ${large} 1 ${p(r2, a1)} L${p(r1, a1)} A${r1} ${r1} 0 ${large} 0 ${p(r1, a0)} Z`;
};
const clockSegs = CLOCK.map((c) => {
  const m0 = toMin(c.at);
  const m1 = m0 + toMin(c.len);
  const kind = c.who.startsWith('Local or') ? 'mix' : c.who.startsWith('Local') ? 'local' : 'net';
  const mid = ((m0 + m1) / 2 / 60) * 2 * Math.PI - Math.PI / 2;
  return { d: arcPath(100, 100, 52, 92, m0, m1), kind, at: c.at, lx: +(100 + 72 * Math.cos(mid)).toFixed(1), ly: +(100 + 72 * Math.sin(mid)).toFixed(1), short: m1 - m0 < 4 };
});

// Network map: stylized coast, ocean to the west.
const coast =
  'M-400 0 L205 0 C215 60 232 110 240 150 C248 200 250 240 252 290 C254 340 262 380 268 420 C274 460 278 500 284 590 C286 620 270 650 238 680 C205 712 182 742 188 780 L-400 780 Z';
const phaseColor = ['var(--pr-red)', 'var(--pr-amber)', 'var(--pr-teal)', 'var(--pr-ink)'];

const stickers = [
  { cls: 'st-red', big: tagline, small: flagship.name },
  { cls: 'st-ink', big: missed, small: `${flagship.name} · ${hubUrl}` },
  { cls: 'st-amber', big: firstSentence(RULES[1]), small: 'Agents draft. A named person approves anything broadcast.' },
  { cls: 'st-teal', big: firstSentence(RULES[2]), small: `${flagship.name} station rules` },
];

const sheets = [
  { id: 'poster', name: 'Main Street poster' },
  { id: 'card', name: 'Pocket schedule card, two-up' },
  { id: 'neighbor', name: 'Neighbor voice flyer with tear-off tabs' },
  { id: 'underwriting', name: 'Underwriting one-pager' },
  { id: 'map', name: 'Network map' },
  { id: 'tuning', name: 'Tuning guide' },
  { id: 'stickers', name: 'Bumper sticker sheet' },
  { id: 'hangers', name: 'Door hangers, two-up' },
];
const n = (id: string) => sheets.findIndex((s) => s.id === id) + 1;

const title = 'Radio El Segundo print kit — PointCast Radio Network';
const description =
  'Concept print campaign for Radio El Segundo’s Phase 0 pilot: a Main Street poster, pocket schedule card, neighbor-voice flyer, underwriting one-pager, network map, tuning guide, bumper stickers and door hangers. One sheet per page. Not on air.';
---

<BlockLayout title={title} description={description} author="PointCast">
  <div class="rn pr">
    <div class="rn-wrap">
      <header class="rn-mast pr-noprint">
        <a class="logo" href="/radio-network">PointCast <b>Radio Network</b></a>
        <nav>
          <a href="/radio-network">The plan</a>
          <a href="/radio-network/el-segundo">Radio El Segundo</a>
          <a href="/radio-network/kit">Launch kit</a>
          <a href="/radio-network/print" aria-current="page">Print kit</a>
        </nav>
      </header>

      <div class="pr-head pr-noprint">
        <p class="rn-kicker">Phase 0 · concept print campaign · nothing on air</p>
        <h1>Paper for a station that isn’t on yet.</h1>
        <p class="lede">
          {sheets.length} sheets for Main Street, the library board and the coffee shop corkboard, for when the Radio El
          Segundo pilot is ready to be talked about. Each prints on its own letter page. No frequency, phone number or
          launch date anywhere: the station does not have them yet.
        </p>
        <p class="pr-actions">
          <button type="button" data-print-all>Print all {sheets.length} sheets</button>
          <span class="rn-meta">Letter paper, portrait, “background graphics” on. Ask before you post anything.</span>
        </p>
        <ol class="pr-index">
          {sheets.map((s, i) => <li><a href={`#sheet-${s.id}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span> {s.name}</a></li>)}
        </ol>
      </div>

      <div class="pr-wall">

        <!-- 01 POSTER -->
        <figure class="pr-fig" id="sheet-poster">
          <section class="sheet s-poster" aria-label="Main Street poster">
            <p class="p-top"><span>PointCast Radio Network</span><span>Phase 0 · pilot in progress</span></p>
            <svg class="p-dial" viewBox="0 0 600 360" role="img" aria-label={`A radio dial tuned to ${flagship.town}`}>
              <path d={`M${pt(184, DR + 78).x} ${pt(184, DR + 78).y} A${DR + 78} ${DR + 78} 0 0 1 ${pt(356, DR + 78).x} ${pt(356, DR + 78).y}`} class="d-rim" />
              <path d={`M${pt(188, DR - 40).x} ${pt(188, DR - 40).y} A${DR - 40} ${DR - 40} 0 0 1 ${pt(352, DR - 40).x} ${pt(352, DR - 40).y}`} class="d-rim thin" />
              {ticks.map((t) => <line x1={t.a.x} y1={t.a.y} x2={t.b.x} y2={t.b.y} class={t.long ? 'd-tick long' : 'd-tick'} />)}
              {dialMarks.map((m) => (
                <g>
                  <circle cx={m.dot.x} cy={m.dot.y} r={m.flag ? 9 : 5} class={m.flag ? 'd-dot on' : 'd-dot'} />
                  <text x={m.p.x} y={m.p.y} class={m.flag ? 'd-lab on' : 'd-lab'} text-anchor="middle">{m.label}</text>
                </g>
              ))}
              <line x1={DCX} y1={DCY} x2={needleTip.x} y2={needleTip.y} class="d-needle" />
              <circle cx={DCX} cy={DCY} r="34" class="d-knob" />
              <circle cx={DCX} cy={DCY} r="12" class="d-cap" />
              <rect x="215" y="200" width="170" height="46" rx="6" class="d-win" />
              <text x={DCX} y="233" text-anchor="middle" class="d-read">{flagship.zip}</text>
            </svg>
            <h2 class="p-name">{flagship.name}</h2>
            <p class="p-tag">{tagline}</p>
            <div class="p-show">
              <p class="p-k">First show</p>
              <p class="p-show-name">{showName}</p>
              <p class="p-show-what">A weekly half hour. <b>Coming soon.</b></p>
            </div>
            <div class="p-ask">
              <p class="p-ask-h">{missed}</p>
              <p class="p-url">{hubUrl}</p>
            </div>
            <p class="foot"><span>{CONCEPT}</span><span>{n('poster')}/{sheets.length}</span></p>
          </section>
          <figcaption>01 · Main Street poster. The dial is marked with towns, not frequencies: the station holds none.</figcaption>
        </figure>

        <!-- 02 POCKET CARD -->
        <figure class="pr-fig" id="sheet-card">
          <section class="sheet s-card" aria-label="Pocket schedule card, two-up">
            {[0, 1].map(() => (
              <div class="card">
                <div class="c-main">
                  <p class="c-k">{flagship.name} · the week</p>
                  <table class="c-grid">
                    <tbody>{WEEK.map((w) => <tr><th>{w.block}</th><td>{w.show}</td></tr>)}</tbody>
                  </table>
                </div>
                <div class="c-side">
                  <svg viewBox="0 0 200 200" class="c-clock" role="img" aria-label="The hour clock">
                    {clockSegs.map((s) => <path d={s.d} class={`seg ${s.kind}`} />)}
                    {clockSegs.filter((s) => !s.short).map((s) => <text x={s.lx} y={s.ly + 3} text-anchor="middle" class="seg-t">{s.at}</text>)}
                    <text x="100" y="98" text-anchor="middle" class="c-hr">every</text>
                    <text x="100" y="114" text-anchor="middle" class="c-hr">hour</text>
                  </svg>
                  <ul class="c-key">
                    <li><i class="local"></i>Local</li>
                    <li><i class="mix"></i>Local or network</li>
                    <li><i class="net"></i>Network desk</li>
                  </ul>
                  <p class="c-note">A planned schedule. Not on air yet.</p>
                  <p class="c-url">{hubUrl}</p>
                </div>
              </div>
            ))}
            <p class="foot"><span>{CONCEPT} Cut on the dashed lines.</span><span>{n('card')}/{sheets.length}</span></p>
          </section>
          <figcaption>02 · Pocket schedule card, two to a sheet, from the weekly grid and the hour clock in the plan.</figcaption>
        </figure>

        <!-- 03 NEIGHBOR VOICE -->
        <figure class="pr-fig" id="sheet-neighbor">
          <section class="sheet s-neighbor" aria-label="Neighbor voice flyer">
            <p class="p-top"><span>{flagship.name}</span><span>Volunteers wanted</span></p>
            <div class="nv-hero">
              <svg viewBox="0 0 120 200" class="nv-mic" aria-hidden="true">
                <rect x="30" y="8" width="60" height="96" rx="30" class="mic-head" />
                {[26, 40, 54, 68, 82].map((y) => <line x1="34" y1={y} x2="86" y2={y} class="mic-grille" />)}
                <path d="M18 70 v12 a42 42 0 0 0 84 0 v-12" class="mic-yoke" />
                <line x1="60" y1="124" x2="60" y2="170" class="mic-yoke" />
                <rect x="30" y="170" width="60" height="12" rx="4" class="mic-base" />
              </svg>
              <div>
                <h2 class="nv-h">Neighbor<br />voice.</h2>
                <p class="nv-sub">{neighborLine.charAt(0).toUpperCase() + neighborLine.slice(1)}.</p>
              </div>
            </div>
            <p class="nv-body">
              Every hour of {flagship.name} keeps {neighborClock.len} for one neighbor and one story{neighborRundown && <>, and {showName} gives it {neighborRundown.len.replace(':00', '')} minutes</>}.
              Tell us yours, or tell us who to ask. We will ask things like:
            </p>
            <ol class="nv-q">{NEIGHBOR_QUESTIONS.map((q) => <li>{q}</li>)}</ol>
            <p class="nv-fine">{CONSENT.lines[2]}</p>
            <div class="tabs" aria-label="Tear-off tabs">
              {Array.from({ length: 8 }).map(() => (
                <div class="tab"><b>Neighbor voice</b><span>{kitUrl}</span></div>
              ))}
            </div>
            <p class="foot"><span>{CONCEPT}</span><span>{n('neighbor')}/{sheets.length}</span></p>
          </section>
          <figcaption>03 · Recruiting flyer. Questions and consent language come from the launch kit.</figcaption>
        </figure>

        <!-- 04 UNDERWRITING -->
        <figure class="pr-fig" id="sheet-underwriting">
          <section class="sheet s-under" aria-label="Underwriting one-pager">
            <p class="p-top"><span>{flagship.name} · for local businesses</span><span>No prices on this page</span></p>
            <h2 class="u-h">Underwrite<br />{showName}.</h2>
            <p class="u-sub">{MONEY[0]}</p>
            <div class="u-cols">
              <div>
                <p class="u-k">What a credit sounds like</p>
                <blockquote class="u-quote">“{CREDIT_TEMPLATE}”</blockquote>
                <p class="u-k">Where it runs</p>
                <ul class="u-where">
                  <li><b class="mono">{creditRundown.at}</b> in {showName}, {firstSentence(creditRundown.note).toLowerCase()}</li>
                  <li><b class="mono">{creditClock.at}</b> of the hour, once the station runs around the clock: {creditClock.what.toLowerCase()}.</li>
                </ul>
                <p class="u-k">The short version</p>
                <p class="u-short">{creditRule}</p>
              </div>
              <div>
                <p class="u-k">The rules</p>
                <ol class="u-rules">{CREDIT_RULES.map((r) => <li>{r}</li>)}</ol>
              </div>
            </div>
            <div class="u-draft">
              <p class="u-k">Draft yours</p>
              <div class="u-fill">
                {draftFields.map((f) => <p><i></i><span>{f}</span></p>)}
              </div>
              <p class="u-note">Same length every time, read as written. Nothing else gets added.</p>
            </div>
            <p class="u-cta">
              The pilot is in progress and terms are not set. If you would like your business on the list, start at
              <b>{hubUrl}</b>.
            </p>
            <p class="foot"><span>{CONCEPT}</span><span>{n('underwriting')}/{sheets.length}</span></p>
          </section>
          <figcaption>04 · Underwriting one-pager. Credit rules and template are the kit’s, word for word.</figcaption>
        </figure>

        <!-- 05 MAP -->
        <figure class="pr-fig" id="sheet-map">
          <section class="sheet s-map" aria-label="Network map">
            <p class="p-top"><span>PointCast Radio Network</span><span>Not to scale</span></p>
            <h2 class="m-h">Seven towns, one dial.</h2>
            <svg viewBox="0 0 600 780" class="m-svg" role="img" aria-label="Stylized map of the seven South Bay towns in the planned network, not to scale">
              <rect x="-400" width="1400" height="780" class="m-land" />
              <path d={coast} class="m-sea" />
              {[120, 260, 400, 540, 680].map((y) => (
                <path d={`M30 ${y} q15 -10 30 0 t30 0 t30 0`} class="m-wave" />
              ))}
              <text x="70" y="330" class="m-sea-t" transform="rotate(-80 70 330)">Santa Monica Bay</text>
              <g class="m-lax" transform="translate(320 205) rotate(-4)">
                <rect x="0" y="0" width="150" height="46" rx="4" />
                <line x1="12" y1="14" x2="138" y2="14" /><line x1="12" y1="32" x2="138" y2="32" />
                <text x="75" y="64" text-anchor="middle">LAX</text>
              </g>
              <g class="m-compass" transform="translate(540 60)">
                <path d="M0 -26 L9 6 L0 0 L-9 6 Z" /><text y="22" text-anchor="middle">N</text>
              </g>
              {STATIONS.map((s) => {
                const g = geo[s.slug];
                const flag = s.role === 'flagship';
                return (
                  <g transform={`translate(${g.x} ${g.y})`}>
                    {flag && [70, 50, 32].map((r) => <circle r={r} class="m-ring" />)}
                    <circle r={flag ? 18 : 13} class="m-knob" style={`fill:${phaseColor[s.phase]}`} />
                    <line x1="0" y1="0" x2="0" y2={flag ? -14 : -10} class="m-pointer" transform={`rotate(${30 + s.phase * 45})`} />
                    <text x={g.dx} y={g.dy - 4} text-anchor={g.anchor} class="m-name">{s.name}</text>
                    <text x={g.dx} y={g.dy + 16} text-anchor={g.anchor} class="m-zip">{s.zip} · phase {s.phase}</text>
                  </g>
                );
              })}
            </svg>
            <ul class="m-key">
              {[0, 1, 2, 3].map((p) => (
                <li><i style={`background:${phaseColor[p]}`}></i><b>Phase {p}</b> {PHASES[p].name.toLowerCase()} · {PHASES[p].span}</li>
              ))}
            </ul>
            <p class="foot"><span>{CONCEPT} Stylized; not to scale.</span><span>{n('map')}/{sheets.length}</span></p>
          </section>
          <figcaption>05 · Network map. Abstract coastline, towns as dial knobs colored by phase.</figcaption>
        </figure>

        <!-- 06 TUNING GUIDE -->
        <figure class="pr-fig" id="sheet-tuning">
          <section class="sheet s-tune" aria-label="Tuning guide">
            <p class="p-top"><span>{flagship.name}</span><span>Owner’s manual, page 1</span></p>
            <h2 class="t-h">How to tune in.</h2>
            <p class="t-sub">A tuning guide for a station that is still on the workbench. Turn the knobs in order.</p>
            <ol class="t-knobs">
              {PATHS.map((p, i) => (
                <li>
                  <svg viewBox="0 0 80 80" class="t-knob" aria-hidden="true">
                    <circle cx="40" cy="40" r="34" />
                    {Array.from({ length: 12 }).map((_, k) => {
                      const a = (k / 12) * 2 * Math.PI;
                      return <line x1={40 + 30 * Math.cos(a)} y1={40 + 30 * Math.sin(a)} x2={40 + 36 * Math.cos(a)} y2={40 + 36 * Math.sin(a)} />;
                    })}
                    <line x1="40" y1="40" x2="40" y2="12" class="t-ptr" transform={`rotate(${-60 + i * 50} 40 40)`} />
                  </svg>
                  <div>
                    <p class="t-n">Knob {i + 1} · {p.when}</p>
                    <h3>{p.name}</h3>
                    <p>{p.reach}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="t-trouble">
              <p class="u-k">Troubleshooting</p>
              <dl>
                <dt>I hear static.</dt><dd>Correct. Nothing is on air yet.</dd>
                <dt>My car can’t find it.</dt><dd>Neither can anyone’s. There is no frequency to find.</dd>
                <dt>What is happening now?</dt><dd>{pilot.goal}</dd>
              </dl>
            </div>
            <p class="foot"><span>{CONCEPT}</span><span>{n('tuning')}/{sheets.length}</span></p>
          </section>
          <figcaption>06 · Tuning guide. The four ways the signal could get out, in the plan’s order.</figcaption>
        </figure>

        <!-- 07 STICKERS -->
        <figure class="pr-fig" id="sheet-stickers">
          <section class="sheet s-stick" aria-label="Bumper sticker sheet">
            {stickers.map((s) => (
              <div class:list={['sticker', s.cls]}>
                <svg viewBox="0 0 60 60" class="st-ico" aria-hidden="true">
                  <circle cx="30" cy="30" r="26" /><circle cx="30" cy="30" r="16" /><circle cx="30" cy="30" r="5" class="fill" />
                </svg>
                <div><p class="st-big">{s.big}</p><p class="st-small">{s.small}</p></div>
              </div>
            ))}
            <p class="foot"><span>{CONCEPT} Cut on the dashed lines.</span><span>{n('stickers')}/{sheets.length}</span></p>
          </section>
          <figcaption>07 · Bumper stickers, from the station IDs and the station rules.</figcaption>
        </figure>

        <!-- 08 DOOR HANGERS -->
        <figure class="pr-fig" id="sheet-hangers">
          <section class="sheet s-hang" aria-label="Door hangers">
            <div class="hanger h-on">
              <span class="h-hole" aria-hidden="true"></span>
              <p class="h-lamp">On air</p>
              <p class="h-big">Recording a neighbor voice.</p>
              <p class="h-small">Please knock softly, or come back in fifteen minutes.</p>
              <svg viewBox="0 0 60 60" class="h-ico" aria-hidden="true"><circle cx="30" cy="30" r="26" /><circle cx="30" cy="30" r="16" /><circle cx="30" cy="30" r="5" class="fill" /></svg>
              <p class="h-foot">{flagship.name}<br />{tagline}</p>
            </div>
            <div class="hanger h-off">
              <span class="h-hole" aria-hidden="true"></span>
              <p class="h-lamp">Off air</p>
              <p class="h-big">Come in. {missed}</p>
              <p class="h-small">Or tell us online:</p>
              <p class="h-url">{hubUrl}</p>
