---
import BlockLayout from '../layouts/BlockLayout.astro';
import { FIRST_NINETY_DAYS_PLAN, INHERITED_FROM_ES, INLAND_DEPTH_POSITION, INSTANCE_META, INSTANCE_NOTES, REFERENCES, TR_SIX_SHAPES, TR_SNAPSHOT, TR_SPECIFIC_TERRAIN } from '../lib/torrance';
const title = `${INSTANCE_META.title} — ${INSTANCE_META.subtitle}`;
const description = INSTANCE_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://pointcast.xyz/torrance', name: INSTANCE_META.title, description, url: 'https://pointcast.xyz/torrance', isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
const statusColor: Record<string, string> = { shipping: '#2d6a3d', building: '#d4a534', forming: '#b85a3a', dormant: '#5a5450', speculative: '#a8a39a' };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/torrance.json', title: 'Torrance instance (JSON)' }]}>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/strand-corridor">strand-corridor</a><span aria-hidden="true">/</span><span>torrance</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{INSTANCE_META.paperNumber} · FIFTH CONCRETE FORK · CORRIDOR INLAND DEPTH</p>
      <h1>TORRANCE.</h1>
      <p class="subtitle">{INSTANCE_META.subtitle}</p>
      <p class="thesis">{INSTANCE_META.thesis}</p>
    </header>

    <section class="snapshot"><p class="kicker">SNAPSHOT</p><h2>Torrance at a glance.</h2>
      <dl class="snap-dl">
        <div><dt>Population</dt><dd>{TR_SNAPSHOT.population}</dd></div>
        <div><dt>Geography</dt><dd>{TR_SNAPSHOT.geography}</dd></div>
        <div><dt>Borders</dt><dd>{TR_SNAPSHOT.borders}</dd></div>
        <div><dt>Median income</dt><dd>{TR_SNAPSHOT.medianIncome}</dd></div>
        <div><dt>Tech / industry</dt><dd>{TR_SNAPSHOT.techDensity}</dd></div>
        <div><dt>Demographics</dt><dd>{TR_SNAPSHOT.demographics}</dd></div>
        <div><dt>School district</dt><dd>{TR_SNAPSHOT.schoolDistrict}</dd></div>
        <div><dt>Parkland</dt><dd>{TR_SNAPSHOT.parksAcres}</dd></div>
        <div><dt>Existing civic</dt><dd>{TR_SNAPSHOT.existingCivic}</dd></div>
      </dl>
    </section>

    <section class="inherited"><p class="kicker">INHERITED FROM EL SEGUNDO · 8 ITEMS</p><h2>What TR starts with.</h2>
      <ol class="inh-list">{INHERITED_FROM_ES.map((i) => (
        <li><h3>{i.item}</h3><p>{i.detail}</p></li>
      ))}</ol>
    </section>

    <section class="terrain"><p class="kicker">TR-SPECIFIC TERRAIN · 7 FEATURES</p><h2>Where Torrance differs.</h2>
      <ol class="ter-list">{TR_SPECIFIC_TERRAIN.map((t) => (
        <li>
          <h3>{t.feature}</h3>
          <p class="ter__ues"><strong>ES analogue:</strong> {t.uesAnalogue}</p>
          <p class="ter__diff"><strong>TR difference:</strong> {t.trDifference}</p>
        </li>
      ))}</ol>
    </section>

    <section class="shapes"><p class="kicker">SIX-SHAPE STATUS · TR</p><h2>What ships first.</h2>
      <ol class="shape-list">{TR_SIX_SHAPES.map((s) => (
        <li class={`sh sh--${s.trStatus}`}>
          <div class="sh__head">
            <span class="sh__num">{String(s.number).padStart(2,'0')}</span>
            <h3>{s.name}</h3>
            <span class="sh__status" style={`background: ${statusColor[s.trStatus]};`}>{s.trStatus.toUpperCase()}</span>
          </div>
          <p><strong>Starting point:</strong> {s.startingPoint}</p>
          <p><strong>First 90 days:</strong> {s.firstNinetyDays}</p>
        </li>
      ))}</ol>
    </section>

    <section class="plan"><p class="kicker">13-WEEK PLAN · DAY 0 → DAY 90</p><h2>What the local Land would do.</h2>
      <ol class="plan-list">{FIRST_NINETY_DAYS_PLAN.map((p) => (
        <li>
          <span class="plan__week">WEEK {p.week}</span>
          <div>
            <h3>{p.milestone}</h3>
            <p>{p.detail}</p>
          </div>
        </li>
      ))}</ol>
    </section>

    <section class="strand"><p class="kicker">CORRIDOR · INLAND DEPTH POSITION</p><h2>Why Torrance is the corridor's inland-depth instance.</h2>
      <p class="lede">{INLAND_DEPTH_POSITION.thesis}</p>
      <h3 class="strand-h">Why inland depth matters</h3>
      <ol class="strand-list">{INLAND_DEPTH_POSITION.whyInlandDepthMatters.map((e) => (<li>{e}</li>))}</ol>
      <p class="strand__parallel"><strong>Parallel to the cases:</strong> {INLAND_DEPTH_POSITION.parallelToCases}</p>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · LOCAL LAND CALL</p>
      <p>{INSTANCE_NOTES.uesNote}</p>
      <p class="invite-cta">{INSTANCE_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/corridor-strengths">Corridor Strengths</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/manhattan-beach">Manhattan Beach</a>
      <a href="/hermosa-beach">Hermosa Beach</a>
      <a href="/redondo-beach">Redondo Beach</a>
      <a href="/forkable-template">Fork-this-repo guide</a>
      <a href="/torrance.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --tr-ink:#1a1a1a; --tr-paper:#fdf9ee; --tr-mustard:#d4a534; --tr-rust:#b85a3a; --tr-sage:#2d6a3d; --tr-strand:#5b8aa8; --tr-inland:#8a6a3d; --tr-fog:#d8d2c4; --tr-slate:#5a5450; }
  .page { max-width: 1080px; margin: 0 auto; padding: 0 0 88px; background: var(--tr-paper); color: var(--tr-ink); font-family: Inter, system-ui, sans-serif; }
  .page > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--tr-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--tr-inland); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--tr-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--tr-inland); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 110px; line-height: .9; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; }
  .thesis { font-size: 15px; line-height: 1.6; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--tr-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 26px; line-height: 1; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  .lede { font-size: 15px; line-height: 1.6; margin: 0 0 16px; max-width: 72ch; }

  .snap-dl { margin: 0; display: grid; gap: 6px; }
  .snap-dl > div { display: grid; grid-template-columns: 160px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--tr-ink); }
  .snap-dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--tr-inland); padding-top: 2px; }
  .snap-dl dd { margin: 0; font-size: 14px; line-height: 1.55; }

  .inh-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .inh-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--tr-ink); border-left: 6px solid var(--tr-sage); }
  .inh-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 6px; font-weight: 700; }
  .inh-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .ter-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ter-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--tr-ink); border-left: 8px solid var(--tr-inland); }
  .ter-list h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 8px; font-weight: 700; }
  .ter-list p { margin: 0 0 4px; font-size: 13px; line-height: 1.5; }
  .ter__ues { padding: 6px 10px; background: var(--tr-paper); border-left: 3px solid var(--tr-fog); font-size: 12.5px !important; }
  .ter__diff { padding: 6px 10px; background: var(--tr-paper); border-left: 3px solid var(--tr-rust); font-size: 12.5px !important; }
  strong { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--tr-inland); margin-right: 4px; }

  .shape-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sh { padding: 12px 14px; background: #fff; border: 2px solid var(--tr-ink); border-left: 8px solid var(--tr-fog); }
  .sh--shipping { border-left-color: var(--tr-sage); }
  .sh--building { border-left-color: var(--tr-mustard); }
  .sh--forming { border-left-color: var(--tr-rust); }
  .sh--dormant { border-left-color: var(--tr-slate); }
  .sh--speculative { border-left-color: var(--tr-fog); }
  .sh__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
  .sh__num { font-family: var(--pc-font-mono); font-size: 18px; font-weight: 700; color: var(--tr-inland); }
  .sh h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0; font-weight: 700; flex: 1; }
  .sh__status { font-family: var(--pc-font-mono); font-size: 9px; letter-spacing: .14em; padding: 2px 6px; color: #fff; }
  .sh p { margin: 0 0 4px; font-size: 12.5px; line-height: 1.5; }

  .plan-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .plan-list li { display: grid; grid-template-columns: 80px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--tr-ink); border-left: 6px solid var(--tr-mustard); align-items: baseline; }
  .plan__week { font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700; color: var(--tr-rust); padding: 2px 6px; background: var(--tr-paper); display: inline-block; }
  .plan-list h3 { font-family: var(--pc-font-mono); font-size: 13px; margin: 0 0 4px; font-weight: 700; }
  .plan-list p { margin: 0; font-size: 13px; line-height: 1.5; }

  .strand { background: linear-gradient(180deg, var(--tr-paper), #fff); border-top: 8px solid var(--tr-inland); }
  .strand-h { font-family: var(--pc-font-mono); font-size: 13px; margin: 16px 0 8px; font-weight: 700; text-transform: uppercase; color: var(--tr-inland); }
  .strand-list { list-style: decimal; padding-left: 22px; margin: 0 0 14px; font-size: 14px; line-height: 1.55; }
  .strand-list li { margin-bottom: 6px; }
  .strand__parallel { padding: 12px 14px; background: var(--tr-paper); border-left: 4px solid var(--tr-inland); font-size: 13.5px; line-height: 1.55; }

  .invitation { background: var(--tr-inland); color: var(--tr-paper); border-top-color: var(--tr-inland); }
  .invitation .kicker { background: var(--tr-mustard); color: var(--tr-ink); }
  .invitation p { font-size: 14px; line-height: 1.55; margin: 0 0 12px; }
  .invite-cta { padding: 12px 14px; background: var(--tr-mustard); color: var(--tr-ink); border-left: 4px solid var(--tr-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--tr-inland); color: var(--tr-paper); text-decoration: none; }
  .links a:hover { background: var(--tr-rust); }

  @media (max-width: 800px) { h1 { font-size: 72px; } .inh-list { grid-template-columns: 1fr; } .snap-dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 50px; } .plan-list li { grid-template-columns: 1fr; } }
</style>
