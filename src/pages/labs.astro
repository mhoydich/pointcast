---
import BlockLayout from '../layouts/BlockLayout.astro';
import { SERIES, SERIES_META } from '../lib/labsSeries';

const title = `${SERIES_META.title} — UES Working Papers series`;
const description = SERIES_META.description;

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/labs',
  name: SERIES_META.title, description, url: 'https://pointcast.xyz/labs',
  isPartOf: { '@type': 'Periodical', name: SERIES_META.publication },
  numberOfItems: SERIES.length,
};
---

<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/labs.json', title: 'Labs series (JSON)' }]}>
  <div class="paper">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/university-of-el-segundo">university-of-el-segundo</a><span aria-hidden="true">/</span>
      <span>labs</span>
    </nav>

    <header class="masthead">
      <div class="masthead__rule"></div>
      <p class="masthead__pub">{SERIES_META.publication} · Series</p>
      <p class="masthead__no">UES-WP-2026-06 through 2026-10</p>
    </header>

    <article class="article">
      <p class="kicker">UES WORKING PAPERS · A 5-PAPER SERIES</p>
      <h1>{SERIES_META.title}.</h1>
      <p class="subtitle">{SERIES_META.subtitle}</p>

      <ol class="byline">{SERIES_META.authors.map((a) => (
        <li><strong>{a.name}</strong> · {a.dept} · {SERIES_META.affiliation} · <a href={`mailto:${a.email}`}>{a.email}</a></li>
      ))}</ol>

      <section class="thesis">
        <h2>Series thesis</h2>
        <p>{SERIES_META.thesis}</p>
      </section>

      <section class="overview">
        <h2>The five papers</h2>
        <ol class="papers">{SERIES.map((p) => (
          <li class={`p p--${p.status}`}>
            <div class="p__head">
              <span class="p__no">{p.paperNumber}</span>
              <span class={`p__status p__status--${p.status}`}>{p.status === 'shipped' ? '· SHIPPED ·' : '· FORTHCOMING ·'}</span>
            </div>
            <h3>{p.shortTitle}</h3>
            <p class="p__title">{p.title}</p>
            <p class="p__geo"><strong>Era:</strong> {p.era} · <strong>Geography:</strong> {p.geography} · <strong>Radius:</strong> {p.radiusInMiles} mi</p>
            <p class="p__abstract">{p.abstract}</p>
            <p class="p__thesis"><em>Thesis:</em> {p.thesis}</p>
            {p.status === 'shipped' ? (
              <a class="p__link" href={p.url}>Read {p.shortTitle} →</a>
            ) : (
              <span class="p__pending">Forthcoming at {p.url}</span>
            )}
          </li>
        ))}</ol>
      </section>

      <section class="preface">
        <h2>Companion papers</h2>
        <p>This series follows the prior diptych on pre-digital personal architecture:</p>
        <ul>
          <li><a href="/trapper-keeper">UES-WP-2026-04 · Velcro and Memory: A Material History of the Mead Trapper Keeper, 1978–2001</a></li>
          <li><a href="/walkman">UES-WP-2026-05 · Pocket Sound: A Material History of the Sony Walkman, 1979–2010</a></li>
        </ul>
        <p>The diptych studied pre-digital personal objects. This series studies the labs that preceded them.</p>
      </section>

      <section class="links">
        <a href="/university-of-el-segundo">UES tracks</a>
        <a href="/marine-layer">Marine Layer</a>
        <a href="/commons">Commons</a>
        <a href="/civic-layer">Civic Layer</a>
        <a href="/labs.json">JSON</a>
      </section>
    </article>
  </div>
</BlockLayout>

<style>
  .paper { max-width: 880px; margin: 0 auto; padding: 0 24px 88px; background: #fdf9ee; color: #1a1a1a; font-family: Georgia, "Times New Roman", serif; }
  .crumb { padding: 18px 0 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; }
  .masthead { padding: 14px 0 18px; }
  .masthead__rule { height: 6px; background: #1a1a1a; margin: 0 0 8px; }
  .masthead__pub { margin: 0; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }
  .masthead__no { margin: 4px 0 0; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #2a5a8a; margin: 16px 0 10px; }
  .article h1 { font-family: Georgia, serif; font-size: 52px; line-height: 1.05; font-weight: 700; margin: 0 0 8px; max-width: 18ch; }
  .subtitle { font-size: 20px; font-style: italic; margin: 0 0 18px; color: #2a2a2a; }
  .byline { list-style: none; padding: 0; margin: 0 0 24px; font-size: 14px; font-style: italic; }
  .byline li { margin-bottom: 4px; }
  .byline a { color: inherit; }

  .thesis { padding: 16px 20px; margin: 24px 0; background: #f4ecd9; border-left: 4px solid #1a1a1a; border-right: 4px solid #1a1a1a; }
  .thesis h2 { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin: 0 0 8px; }
  .thesis p { margin: 0; font-size: 16px; line-height: 1.6; font-style: italic; }

  .overview h2,.preface h2 { font-size: 22px; font-weight: 700; margin: 36px 0 14px; padding-top: 14px; border-top: 1px solid #1a1a1a; }
  .papers { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .p { background: #fff; border: 2px solid #1a1a1a; padding: 16px 18px; }
  .p--forthcoming { background: repeating-linear-gradient(45deg, #fff 0 12px, #faf5e8 12px 24px); border-style: dashed; }
  .p__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .p__no { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; color: #2a5a8a; font-weight: 700; }
  .p__status { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; }
  .p__status--shipped { color: #1a5a3a; }
  .p__status--forthcoming { color: #5a5450; font-style: italic; }
  .p h3 { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
  .p__title { margin: 0 0 8px; font-style: italic; font-size: 14px; color: #2a2a2a; }
  .p__geo { margin: 0 0 10px; font-size: 12px; color: #2a2a2a; padding: 6px 10px; background: #f4ecd9; border-left: 2px solid #5a5450; }
  .p__geo strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .p__abstract { margin: 0 0 8px; font-size: 13.5px; line-height: 1.55; }
  .p__thesis { margin: 0 0 10px; font-size: 13px; color: #2a2a2a; }
  .p__thesis em { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-style: normal; color: #2a5a8a; margin-right: 4px; }
  .p__link { display: inline-block; padding: 8px 12px; background: #1a1a1a; color: #fdf9ee; text-decoration: none; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .p__link:hover { background: #2a5a8a; }
  .p__pending { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; font-style: italic; }

  .preface ul { padding-left: 20px; font-size: 14px; line-height: 1.6; }
  .preface li { margin-bottom: 4px; }
  .preface a { color: #1a1a1a; }
  .preface p { font-size: 14px; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 18px; border-top: 1px solid #1a1a1a; margin-top: 32px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: #1a1a1a; color: #fdf9ee; text-decoration: none; }
  .links a:hover { background: #2a5a8a; }

  @media (max-width: 620px) {
    .article h1 { font-size: 36px; }
    .paper { padding-inline: 18px; }
  }
</style>
