---
const canonical = 'https://pointcast.xyz/qwen-weather';
const title = 'QWEN / WEATHER MEMORY — PointCast Model Study 001';
const description =
  'Qwen 3.8 wrote an impossible forecast, GLM-5.2 answered it, Wan 2.7 imagined the organism, and HappyHorse gave it motion and sound.';
const ogImage = 'https://pointcast.xyz/images/qwen-weather/qwen-weather-og.png';
const models = [
  {
    index: '01',
    name: 'Qwen 3.8 Max',
    role: 'Language',
    action: 'Wrote the six-line impossible weather score.',
  },
  {
    index: '02',
    name: 'GLM-5.2',
    role: 'Countervoice',
    action: 'Observed the same event from another model.',
  },
  {
    index: '03',
    name: 'Wan 2.7 Image Pro',
    role: 'Image',
    action: 'Turned the forecast into a weather organism.',
  },
  {
    index: '04',
    name: 'HappyHorse 1.1',
    role: 'Video + audio',
    action: 'Animated the still and generated its soundtrack.',
  },
];
const score = [
  'Rain from a vanished Tuesday',
  'Wind that remembers every door',
  'Snow falling upward into the past',
  'Grief arriving from the southwest',
  'Dew formed from the first morning',
  'Forecast: yesterday, all day',
];
const notes = [
  'Rain falls upward tonight.',
  'Silent lightning strikes green clouds.',
  'Sunlight weeps black ice.',
  'Warm snow glows blue.',
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: canonical,
  image: ogImage,
  datePublished: '2026-07-25T17:05:00.000Z',
  creator: {
    '@type': 'Organization',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
  about: models.map((model) => ({
    '@type': 'SoftwareApplication',
    name: model.name,
    applicationCategory: model.role,
  })),
  encoding: {
    '@type': 'VideoObject',
    name: 'The Weather Has a Memory',
    thumbnailUrl: ogImage,
    contentUrl: 'https://pointcast.xyz/images/qwen-weather/weather-memory.mp4',
    duration: 'PT8S',
    encodingFormat: 'video/mp4',
  },
  mainEntityOfPage: 'https://pointcast.xyz/qwen-weather.json',
  isPartOf: {
    '@type': 'WebSite',
    name: 'PointCast',
    url: 'https://pointcast.xyz',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/qwen-weather.json" title="Qwen Weather machine record" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PointCast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#05090c" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        color-scheme: dark;
        --ink: #05090c;
        --ink-soft: #0b1318;
        --paper: #e9e8df;
        --muted: #9ba4a4;
        --line: rgba(233, 232, 223, 0.2);
        --acid: #d3ff78;
        --blue: #8ebcff;
        --ember: #ff8b4e;
        --serif: Iowan Old Style, Baskerville, "Times New Roman", serif;
        --sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
        --mono: "SFMono-Regular", "IBM Plex Mono", Menlo, Consolas, monospace;
        --gutter: clamp(18px, 4vw, 64px);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--ink);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 72% 12%, rgba(87, 132, 173, 0.13), transparent 24%),
          var(--ink);
        color: var(--paper);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        color: inherit;
        font: inherit;
      }

      ::selection {
        background: var(--acid);
        color: var(--ink);
      }

      :focus-visible {
        outline: 3px solid var(--acid);
        outline-offset: 4px;
      }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 100;
        padding: 10px 14px;
        background: var(--acid);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        transform: translateY(-150%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .masthead {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 20;
        display: grid;
        width: 100%;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 18px var(--gutter);
        border-bottom: 1px solid rgba(233, 232, 223, 0.13);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .masthead a {
        text-decoration: none;
      }

      .masthead__brand {
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 800;
        letter-spacing: -0.02em;
        text-transform: none;
      }

      .masthead__issue {
        color: rgba(233, 232, 223, 0.55);
      }

      .masthead__machine {
        justify-self: end;
        color: var(--acid);
      }

      .hero {
        position: relative;
        display: grid;
        min-height: 100svh;
        grid-template-columns: minmax(0, 0.9fr) minmax(480px, 1.1fr);
        overflow: hidden;
        border-bottom: 1px solid var(--line);
      }

      .hero::after {
        position: absolute;
        inset: 0;
        z-index: 3;
        background:
          linear-gradient(90deg, rgba(5, 9, 12, 0.97) 0%, rgba(5, 9, 12, 0.72) 42%, transparent 68%),
          linear-gradient(180deg, rgba(5, 9, 12, 0.35), transparent 35%, rgba(5, 9, 12, 0.5));
        content: "";
        pointer-events: none;
      }

      .hero__copy {
        position: relative;
        z-index: 5;
        display: flex;
        min-height: 100svh;
        flex-direction: column;
        justify-content: center;
        padding: 118px var(--gutter) 62px;
      }

      .eyebrow {
        margin: 0 0 28px;
        color: var(--acid);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 850px;
        margin-bottom: 30px;
        font-family: var(--serif);
        font-size: clamp(61px, 8.5vw, 136px);
        font-weight: 400;
        letter-spacing: -0.075em;
        line-height: 0.76;
      }

      h1 em {
        color: transparent;
        font-weight: 400;
        -webkit-text-stroke: 1px rgba(233, 232, 223, 0.9);
      }

      .hero__dek {
        max-width: 530px;
        margin-bottom: 38px;
        color: rgba(233, 232, 223, 0.69);
        font-size: clamp(14px, 1.3vw, 18px);
        line-height: 1.55;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .sound-button,
      .text-button {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(233, 232, 223, 0.34);
        border-radius: 99px;
        background: rgba(5, 9, 12, 0.38);
        color: var(--paper);
        cursor: pointer;
        font-family: var(--mono);
        font-size: 9px;
        gap: 11px;
        letter-spacing: 0.1em;
        padding: 0 20px;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          border-color 180ms ease,
          background 180ms ease;
      }

      .sound-button:hover,
      .sound-button[aria-pressed="true"] {
        border-color: var(--acid);
        background: rgba(211, 255, 120, 0.11);
      }

      .sound-button__dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--paper);
      }

      .sound-button[aria-pressed="true"] .sound-button__dot {
        background: var(--acid);
        box-shadow: 0 0 16px var(--acid);
      }

      .hero__model-line {
        position: absolute;
        bottom: 32px;
        left: var(--gutter);
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
      }

      .hero__model-line span {
        border: 1px solid rgba(233, 232, 223, 0.24);
        border-radius: 99px;
        color: rgba(233, 232, 223, 0.58);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.09em;
        padding: 5px 8px;
        text-transform: uppercase;
      }

      .hero__media {
        position: absolute;
        inset: 0;
      }

      .hero__media video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 60% center;
        filter: saturate(0.86) contrast(1.08) brightness(0.77);
      }

      .hero__grain {
        position: absolute;
        inset: 0;
        z-index: 2;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.72'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
        opacity: 0.13;
        pointer-events: none;
      }

      .relay {
        padding: 128px var(--gutter) 150px;
      }

      .section-heading {
        display: grid;
        grid-template-columns: 0.36fr minmax(0, 1.3fr) minmax(220px, 0.5fr);
        gap: 36px;
        align-items: end;
        margin-bottom: 90px;
      }

      .section-heading__index {
        align-self: start;
        color: var(--acid);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .section-heading h2 {
        margin-bottom: 0;
        font-family: var(--serif);
        font-size: clamp(48px, 6vw, 92px);
        font-weight: 400;
        letter-spacing: -0.065em;
        line-height: 0.86;
      }

      .section-heading__note {
        margin-bottom: 0;
        color: rgba(233, 232, 223, 0.48);
        font-size: 12px;
        line-height: 1.6;
      }

      .relay__list {
        border-top: 1px solid var(--line);
      }

      .relay__item {
        display: grid;
        min-height: 126px;
        grid-template-columns: 64px minmax(220px, 0.9fr) minmax(110px, 0.36fr) minmax(280px, 1fr);
        gap: 24px;
        align-items: center;
        border-bottom: 1px solid var(--line);
        transition:
          background 180ms ease,
          padding 180ms ease;
      }

      .relay__item:hover {
        padding-inline: 12px;
        background: rgba(233, 232, 223, 0.035);
      }

      .relay__index,
      .relay__role {
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .relay__index {
        color: var(--acid);
      }

      .relay__item h3 {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(27px, 3vw, 45px);
        font-weight: 400;
        letter-spacing: -0.045em;
      }

      .relay__role {
        width: max-content;
        border: 1px solid rgba(233, 232, 223, 0.25);
        border-radius: 99px;
        padding: 6px 9px;
      }

      .relay__action {
        margin: 0;
        color: rgba(233, 232, 223, 0.55);
        font-size: 13px;
        line-height: 1.5;
      }

      .score {
        display: grid;
        grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
        border-block: 1px solid var(--line);
        background: var(--ink-soft);
      }

      .score__intro {
        display: flex;
        min-height: 620px;
        flex-direction: column;
        justify-content: space-between;
        padding: 56px var(--gutter);
        border-right: 1px solid var(--line);
      }

      .score__intro h2 {
        max-width: 500px;
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(52px, 6vw, 92px);
        font-weight: 400;
        letter-spacing: -0.07em;
        line-height: 0.82;
      }

      .score__intro h2 em {
        color: var(--blue);
        font-weight: 400;
      }

      .score__intro small {
        color: rgba(233, 232, 223, 0.45);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
        line-height: 1.6;
        text-transform: uppercase;
      }

      .score__lines {
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: 0;
        padding: 42px var(--gutter);
        list-style: none;
      }

      .score__lines li {
        display: grid;
        grid-template-columns: 36px 1fr;
        align-items: baseline;
        border-bottom: 1px solid var(--line);
        padding: 17px 0 20px;
        opacity: 0.48;
        transition:
          opacity 180ms ease,
          transform 180ms ease;
      }

      .score__lines li:hover {
        opacity: 1;
        transform: translateX(9px);
      }

      .score__lines span {
        color: var(--acid);
        font-family: var(--mono);
        font-size: 8px;
      }

      .score__lines p {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(25px, 3.5vw, 55px);
        letter-spacing: -0.04em;
        line-height: 0.95;
      }

      .organism {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(310px, 0.65fr);
        background: #dad8d0;
        color: var(--ink);
      }

      .organism__figure {
        position: relative;
        min-height: 820px;
        margin: 0;
      }

      .organism__figure img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 58% center;
        filter: saturate(0.86) contrast(1.05);
      }

      .organism__figure figcaption {
        position: absolute;
        right: 18px;
        bottom: 18px;
        left: 18px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: rgba(233, 232, 223, 0.8);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .organism__copy {
        align-self: center;
        padding: 70px clamp(28px, 5vw, 90px);
      }

      .organism__copy .eyebrow {
        color: #436215;
      }

      .organism__copy h2 {
        margin-bottom: 42px;
        font-family: var(--serif);
        font-size: clamp(49px, 6vw, 90px);
        font-weight: 400;
        letter-spacing: -0.07em;
        line-height: 0.84;
      }

      .organism__copy h2 em {
        color: #436215;
        font-weight: 400;
      }

      .organism__copy > p:last-of-type {
        color: rgba(5, 9, 12, 0.62);
        font-size: 13px;
        line-height: 1.68;
      }

      .specimen-facts {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        margin-top: 45px;
        background: rgba(5, 9, 12, 0.2);
        border: 1px solid rgba(5, 9, 12, 0.2);
      }

      .specimen-facts span {
        display: flex;
        min-height: 68px;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        padding: 12px;
        background: #dad8d0;
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .specimen-facts strong {
        font-family: var(--sans);
        font-size: 12px;
        letter-spacing: 0;
        text-transform: none;
      }

      .counterforecast {
        padding: 140px var(--gutter) 160px;
      }

      .counterforecast__cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
      }

      .counterforecast__card {
        display: flex;
        min-height: 260px;
        flex-direction: column;
        justify-content: space-between;
        padding: 22px;
        background: var(--ink);
        transition:
          background 180ms ease,
          color 180ms ease;
      }

      .counterforecast__card:hover {
        background: var(--paper);
        color: var(--ink);
      }

      .counterforecast__card span {
        color: var(--acid);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .counterforecast__card p {
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(27px, 3vw, 42px);
        letter-spacing: -0.04em;
        line-height: 0.95;
      }

      .answer {
        display: grid;
        grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.35fr);
        border-top: 1px solid var(--line);
        background: var(--acid);
        color: var(--ink);
      }

      .answer__label,
      .answer__copy {
        padding: clamp(44px, 6vw, 90px) var(--gutter);
      }

      .answer__label {
        border-right: 1px solid rgba(5, 9, 12, 0.35);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .answer__copy h2 {
        max-width: 980px;
        margin-bottom: 28px;
        font-family: var(--serif);
        font-size: clamp(49px, 6.5vw, 98px);
        font-weight: 400;
        letter-spacing: -0.07em;
        line-height: 0.86;
      }

      .answer__copy p {
        max-width: 680px;
        margin-bottom: 28px;
        font-size: 14px;
        line-height: 1.62;
      }

      .answer__copy a {
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      footer {
        display: grid;
        min-height: 270px;
        grid-template-columns: 1fr 1fr auto;
        gap: 40px;
        align-items: end;
        padding: 70px var(--gutter) 40px;
      }

      footer p {
        max-width: 470px;
        margin: 0;
        color: rgba(233, 232, 223, 0.48);
        font-size: 10px;
        line-height: 1.6;
      }

      .footer__brand {
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .footer__brand span:last-child {
        color: var(--acid);
      }

      footer > a {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 1px solid rgba(233, 232, 223, 0.3);
        border-radius: 50%;
        text-decoration: none;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .hero::after {
          background:
            linear-gradient(180deg, rgba(5, 9, 12, 0.32), rgba(5, 9, 12, 0.22) 38%, rgba(5, 9, 12, 0.94)),
            linear-gradient(90deg, rgba(5, 9, 12, 0.65), transparent);
        }

        .hero__copy {
          justify-content: flex-end;
          padding-bottom: 92px;
        }

        .section-heading {
          grid-template-columns: 1fr;
          align-items: start;
        }

        .relay__item {
          grid-template-columns: 46px 1fr auto;
          padding-block: 20px;
        }

        .relay__action {
          grid-column: 2 / 4;
        }

        .score,
        .organism {
          grid-template-columns: 1fr;
        }

        .score__intro {
          min-height: 430px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .organism__figure {
          min-height: 70vh;
        }

        .counterforecast__cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 620px) {
        .masthead {
          grid-template-columns: 1fr auto;
          padding-inline: 16px;
        }

        .masthead__issue {
          display: none;
        }

        .hero__copy {
          min-height: 100svh;
          padding-inline: 18px;
        }

        h1 {
          font-size: clamp(59px, 20vw, 84px);
        }

        .hero__dek {
          font-size: 13px;
        }

        .hero__model-line {
          left: 18px;
          right: 18px;
        }

        .relay,
        .counterforecast {
          padding-block: 92px;
        }

        .section-heading {
          gap: 20px;
          margin-bottom: 55px;
        }

        .section-heading h2 {
          font-size: 50px;
        }

        .relay__item {
          grid-template-columns: 29px 1fr;
          gap: 12px;
        }

        .relay__role {
          grid-column: 2;
          grid-row: 2;
        }

        .relay__action {
          grid-column: 2;
        }

        .score__intro {
          min-height: 360px;
          padding-inline: 18px;
        }

        .score__lines {
          padding-inline: 18px;
        }

        .score__lines p {
          font-size: 30px;
        }

        .organism__figure {
          min-height: 620px;
        }

        .organism__figure figcaption {
          flex-direction: column;
          gap: 4px;
        }

        .organism__copy {
          padding-inline: 18px;
        }

        .counterforecast__cards {
          grid-template-columns: 1fr;
        }

        .counterforecast__card {
          min-height: 190px;
        }

        .answer {
          grid-template-columns: 1fr;
        }

        .answer__label {
          border-right: 0;
          border-bottom: 1px solid rgba(5, 9, 12, 0.35);
        }

        footer {
          align-items: start;
          grid-template-columns: 1fr auto;
        }

        footer p {
          grid-column: 1 / 3;
          grid-row: 2;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }

        .hero__media video {
          display: none;
        }

        .hero__media {
          background: url("/images/qwen-weather/qwen-weather-og.png") 58% center / cover no-repeat;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the model study</a>

    <header class="masthead">
      <a class="masthead__brand" href="/">PointCast</a>
      <span class="masthead__issue">Model Study 001 · July 25, 2026</span>
      <a class="masthead__machine" href="/qwen-weather.json">JSON ↗</a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="study-title">
        <div class="hero__media" aria-hidden="true">
          <video
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            poster="/images/qwen-weather/qwen-weather-og.png"
            data-weather-video
          >
            <source src="/images/qwen-weather/weather-memory.mp4" type="video/mp4" />
          </video>
          <div class="hero__grain"></div>
        </div>

        <div class="hero__copy">
          <p class="eyebrow">QwenCloud model relay · PointCast 0493</p>
          <h1 id="study-title">Qwen /<br /><em>weather memory</em></h1>
          <p class="hero__dek">
            Four QwenCloud models pass one impossible forecast from language to
            image to moving sound. The artifact is the conversation between them.
          </p>
          <div class="hero__actions">
            <button class="sound-button" type="button" aria-pressed="false" data-sound-button>
              <span class="sound-button__dot" aria-hidden="true"></span>
              <span data-sound-label>Hear HappyHorse audio</span>
            </button>
            <a class="text-button" href="#relay">Follow the relay ↓</a>
          </div>
          <div class="hero__model-line" aria-label="Models used">
            {models.map((model) => <span>{model.name}</span>)}
          </div>
        </div>
      </section>

      <section class="relay" id="relay" aria-labelledby="relay-title">
        <div class="section-heading">
          <span class="section-heading__index">I · The relay</span>
          <h2 id="relay-title">One forecast.<br />Four model minds.</h2>
          <p class="section-heading__note">
            Each system altered the artifact before passing it forward. No
            model was asked to imitate a finished human style.
          </p>
        </div>

        <div class="relay__list">
          {models.map((model) => (
            <article class="relay__item">
              <span class="relay__index">{model.index}</span>
              <h3>{model.name}</h3>
              <span class="relay__role">{model.role}</span>
              <p class="relay__action">{model.action}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="score" aria-labelledby="score-title">
        <div class="score__intro">
          <p class="eyebrow">II · Qwen 3.8 Max</p>
          <h2 id="score-title">The first model<br /><em>predicts memory.</em></h2>
          <small>Six lines · generated in one pass<br />Read slowly · weather is occurring</small>
        </div>
        <ol class="score__lines">
          {score.map((line, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{line}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="organism" aria-labelledby="organism-title">
        <figure class="organism__figure">
          <img
            src="/images/qwen-weather/weather-organism.jpg"
            alt="A translucent silver flower-cloud with blue rain roots, a barometer, and a miniature sun floating above a reflective black salt flat."
            width="1920"
            height="1920"
            loading="lazy"
          />
          <figcaption>
            <span>Wan 2.7 Image Pro · source still</span>
            <span>Weather organism WHM—0725</span>
          </figcaption>
        </figure>
        <div class="organism__copy">
          <p class="eyebrow">III · Wan 2.7 Image Pro</p>
          <h2 id="organism-title">Pressure becomes<br /><em>an organism.</em></h2>
          <p>
            Wan translated the language score into a botanical instrument:
            cloud, jellyfish, flower, and barometer carrying its own private sun.
            HappyHorse then used this image as the sole visual reference for
            the eight-second moving passage above.
          </p>
          <div class="specimen-facts" aria-label="Artifact facts">
            <span><small>Source</small><strong>4096 × 4096</strong></span>
            <span><small>Motion</small><strong>8.04 seconds</strong></span>
            <span><small>Video</small><strong>1280 × 720</strong></span>
            <span><small>Audio</small><strong>Generated AAC</strong></span>
          </div>
        </div>
      </section>

      <section class="counterforecast" aria-labelledby="counter-title">
        <div class="section-heading">
          <span class="section-heading__index">IV · GLM-5.2</span>
          <h2 id="counter-title">Another model<br />looks outside.</h2>
          <p class="section-heading__note">
            The second language model was not given Qwen’s lines. It received
            the exhibition premise and returned four independent observations.
          </p>
        </div>
        <div class="counterforecast__cards">
          {notes.map((note, index) => (
            <article class="counterforecast__card">
              <span>Observation {String(index + 1).padStart(2, '0')}</span>
              <p>{note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="answer" aria-labelledby="answer-title">
        <div class="answer__label">V · What is unusual here?</div>
        <div class="answer__copy">
          <h2 id="answer-title">The video made its own weather—and its own sound.</h2>
          <p>
            QwenCloud’s Personal Token Plan supplied the language, image, and
            HappyHorse video-with-audio models used in this relay. Everything on
            this page is pre-rendered: no private token, live model request, or
            metered API call enters PointCast.
          </p>
          <a href="/qwen-weather.json">Inspect the machine-readable model record →</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer__brand">
        <span>PointCast · Model Study 001</span>
        <span>Qwen / Weather Memory</span>
      </div>
      <p>
        A public PointCast edition made from Qwen 3.8 Max, GLM-5.2, Wan 2.7
        Image Pro, and HappyHorse 1.1. The visitor provides the final reading.
      </p>
      <a href="#" aria-label="Return to top">↑</a>
    </footer>

    <script is:inline>
      (() => {
        const video = document.querySelector('[data-weather-video]');
        const button = document.querySelector('[data-sound-button]');
        const label = document.querySelector('[data-sound-label]');
        if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;

        button.addEventListener('click', async () => {
          const audible = button.getAttribute('aria-pressed') === 'true';
          video.muted = audible;
          if (!audible) {
            video.volume = 0.78;
            await video.play().catch(() => undefined);
          }
          button.setAttribute('aria-pressed', String(!audible));
          if (label) label.textContent = audible ? 'Hear HappyHorse audio' : 'HappyHorse audio on';
        });
      })();
    </script>
  </body>
</html>
