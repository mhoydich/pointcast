---
import BlockLayout from '../layouts/BlockLayout.astro';
import { getSnapshot } from '../lib/business-feels.mjs';
import '../styles/business-feels.css';
const packet = getSnapshot(new Date());
const radar = ['fed-target-upper', 'ecb-deposit', 'treasury-10y', 'us-cpi-yoy', 'us-unemployment', 'us-payroll-change'];
const description = 'A public-data desk for borrowing costs, currencies, prices, and jobs. Dated observations, source health, and small tools for thinking about business.';
const valueLabel = (s: any) => Number.isFinite(s.value) ? `${s.value.toLocaleString('en-US', { maximumFractionDigits: 2 })} ${s.unit}` : 'Awaiting a permitted feed';
---
<BlockLayout title="Business feels · The signal desk" description={description} isolated immersive showNetworkStrip={false} themeColor="#f4f1e8" alternates={[{type:'application/json',href:'/business-feels.json',title:'Business feels dated public data'},{type:'application/json',href:'/business-feels/openapi.json',title:'Business feels read-only API'}]} jsonLd={{'@context':'https://schema.org','@type':'WebApplication',name:'Business feels',url:'https://pointcast.xyz/business-feels',description,applicationCategory:'BusinessApplication',isAccessibleForFree:true}}>
<div class="bf" data-business-feels>
  <a class="bf-skip" href="#signals">Skip to the signals</a>
  <header class="bf-nav"><a class="bf-brand" href="/">POINTCAST <span>public signal desk</span></a><nav aria-label="Business feels"><a href="#signals">The board</a><a href="#tools">The tools</a><a href="#sources">Sources & dates</a></nav><span class="bf-edition">BUSINESS FEELS / V.01</span></header>
  <section class="bf-hero" aria-labelledby="bf-title"><div><p class="bf-kicker">A little context for the big picture</p><h1 id="bf-title">Business<br/><span>feels.</span><i aria-hidden="true">↗</i></h1><p class="bf-dek">The cost of money.<br/>The price of things.<br/>The world between them.</p><p class="bf-intro">A quiet desk for signals that reach an ordinary business: rates, currencies, prices, and jobs. See the number, check its date, then ask what it changes.</p></div><aside class="bf-compass"><p class="bf-kicker">How the signals travel</p><svg viewBox="0 0 420 360" role="img" aria-labelledby="bf-map-title bf-map-desc"><title id="bf-map-title">Four paths into a business</title><desc id="bf-map-desc">Rates connect to financing; currencies to cross-border costs; prices to margins; jobs to demand. This is a conceptual diagram, not market data.</desc><g fill="none" stroke="currentColor"><circle cx="210" cy="180" r="113" stroke-dasharray="2 8"/><path d="M210 43v91M347 180h-91M210 317v-91M73 180h91" stroke-width="2"/><circle cx="210" cy="180" r="46" stroke-width="2"/></g><g fill="currentColor" font-size="13" font-family="monospace" text-anchor="middle"><text x="210" y="27">RATES</text><text x="210" y="61">financing</text><text x="355" y="148">FX</text><text x="348" y="166">imports</text><text x="210" y="332">JOBS</text><text x="210" y="306">demand</text><text x="60" y="148">PRICES</text><text x="71" y="166">margins</text><text x="210" y="177">YOUR</text><text x="210" y="194">BUSINESS</text></g><g fill="#ea5938"><circle cx="210" cy="77" r="8"/><circle cx="313" cy="180" r="8"/><circle cx="210" cy="283" r="8"/><circle cx="107" cy="180" r="8"/></g></svg><p>Four useful lenses.<br/>No single number tells the whole story.</p><span class="bf-small">CONCEPTUAL MAP / POINTCAST</span></aside></section>
  <div class="bf-tape"><span><i aria-hidden="true"></i> DATED PUBLIC OBSERVATIONS</span><p data-packet-status>Bundled snapshot · each signal keeps its own date</p><button type="button" data-refresh>Check public feeds <span aria-hidden="true">↻</span></button></div>
  <p class="bf-notice">Reference data and educational scenarios. Published observations can lag; currencies are reference rates, not executable quotes. Policy decisions, market yields, and loan offers measure different things.</p>
  <section class="bf-section" id="signals" aria-labelledby="board-title"><header class="bf-section-head"><div><p class="bf-kicker">01 / What’s on your radar</p><h2 id="board-title">Watch the moving parts.</h2></div><details class="bf-watch-picker"><summary>Personalize your watchboard</summary><fieldset data-watch-options><legend>Keep signals on your radar · saved on this device</legend>{packet.series.map((s: any)=><label><input type="checkbox" value={s.id} checked={radar.includes(s.id)}/>{s.title}</label>)}</fieldset><button type="button" data-reset-watch>Reset selection</button></details></header>
  <div class="bf-filter" aria-label="Filter signals">{[['radar','On my radar'],['all','All signals'],['policy','Policy rates'],['yields','Yield curve'],['economy','Prices & jobs'],['deferred','More coverage']].map(([id,label])=><button type="button" data-filter={id} aria-pressed={id==='radar'}>{label}</button>)}<span data-board-count>{radar.length} signals</span></div>
  <div class="bf-board" data-signal-board>{packet.series.map((s: any)=><article class={`bf-card bf-card--${s.category}`} data-signal={s.id} hidden={!radar.includes(s.id)}><header><p class="bf-kicker">{s.category} / {s.frequency}</p><span class="bf-status" data-series-status>{s.status}</span></header><h3>{s.title}</h3><p class="bf-number" data-value>{valueLabel(s)}</p><p class="bf-date" data-observation>{s.observationDate ? `Observed ${s.observationDate}` : 'No numeric observation included'}</p><div class="bf-spark" data-spark></div><p class="bf-context" data-matters>{s.matters || s.context}</p><details class="bf-card-detail"><summary>What moves it · compare · data</summary><div data-series-detail><p>{s.drivers}</p><p><a href={s.sourceUrl}>Read the source ↗</a></p></div></details></article>)}</div><p class="bf-empty" data-empty hidden>Select a signal in “Personalize your watchboard” to put it on your radar.</p><noscript><p>JavaScript enables filters, plots, refresh, and calculators. <a href="/business-feels.json">Every signal and date is available in the JSON snapshot.</a></p><style>.bf-card[hidden]{display:block}.bf-filter,.bf-watch-picker,[data-refresh]{display:none}</style></noscript></section>
  <section class="bf-yield" aria-labelledby="curve-title"><div><p class="bf-kicker">02 / The shape of borrowing</p><h2 id="curve-title">Same day.<br/>Different horizons.</h2><p>Treasury yields show the return on US government debt at different maturities. They help frame financing costs; a business loan also includes credit risk, fees, and a lender’s margin.</p><p class="bf-small">An inverted curve means shorter yields exceed longer ones. It is a signal to investigate, not a promised recession.</p><a href="https://home.treasury.gov/resource-center-data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve">US Treasury’s daily table ↗</a></div><div class="bf-curve-panel"><p class="bf-kicker" data-curve-date>Daily Treasury par yields · date from source</p><div data-yield-chart></div><div class="bf-table-wrap" data-yield-table></div><p class="bf-small">One publication date across tenors; missing tenors stay missing.</p></div></section>
  <section class="bf-section" id="tools" aria-labelledby="tools-title"><header class="bf-section-head"><div><p class="bf-kicker">03 / Put a number in context</p><h2 id="tools-title">Small tools. Clear assumptions.</h2></div></header><div class="bf-tools"><article class="bf-fx"><p class="bf-kicker">A dated reference / ECB</p><h3>What does it translate to?</h3><p>Convert a planning amount with one dated table of EUR reference rates. No spread, fees, or transaction price is included.</p><form data-fx-form><div class="bf-form-row"><label>Amount<input name="amount" type="number" min="0" max="1000000000000" step="any" value="1000" inputmode="decimal" required/></label><label>From<select name="from" aria-label="From currency"></select></label><label>To<select name="to" aria-label="To currency"></select></label></div><label>Reference date<select name="reference" aria-label="Currency reference date"></select></label></form><output class="bf-tool-result" data-fx-result aria-live="polite">Reference table loading…</output><p class="bf-small" data-fx-note></p><a href="https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html">ECB reference methodology ↗</a></article><article class="bf-scenario"><p class="bf-kicker">An educational model / your assumptions</p><h3>What if the rate changes?</h3><p>Explore a fixed-rate, fully amortizing loan. These inputs are assumptions you control; they are not lending terms or a forecast.</p><form data-scenario-form><div class="bf-form-row"><label>Principal · USD<input name="principal" type="number" min="1" max="1000000000" step="any" value="100000" inputmode="decimal" required/></label><label>Years<input name="years" type="number" min="1" max="40" step="1" value="10" required/></label></div><div class="bf-form-row"><label>Base annual rate · %<input name="rate" type="number" min="0" max="50" step="0.1" value="6" required/></label><label>Change · percentage points<input name="change" type="number" min="-50" max="50" step="0.1" value="1" required/></label></div></form><output class="bf-tool-result" data-scenario-result aria-live="polite"></output><p class="bf-small">Monthly payments; no fees, taxes, insurance, balloon payment, or variable resets. Personal inputs remain in this page and are not sent to a server.</p></article></div></section>
  <section class="bf-section bf-read" aria-labelledby="read-title"><header><p class="bf-kicker">04 / Read across, not in isolation</p><h2 id="read-title">What’s the business question?</h2></header><div class="bf-reading-grid"><article><span>01</span><h3>Borrowing & cash</h3><p>Policy rates guide overnight money. Treasury yields price different horizons. Ask when your debt resets, how much cash earns, and whether fixed or floating costs matter.</p></article><article><span>02</span><h3>Buying across borders</h3><p>A stronger home currency can lower foreign-currency input costs, while making exports more expensive abroad. Check the currency on the invoice before drawing a conclusion.</p></article><article><span>03</span><h3>Pricing & demand</h3><p>CPI tracks a household basket, not your exact costs. Jobs offer a view of labor demand and income. Compare them with your own unit costs, customer mix, and hiring plans.</p></article></div></section>
  <section class="bf-section" id="sources" aria-labelledby="source-title"><header class="bf-section-head"><div><p class="bf-kicker">05 / Leave the dates attached</p><h2 id="source-title">A source for every signal.</h2></div><div class="bf-downloads"><button type="button" data-download="json">Download JSON</button><button type="button" data-download="csv">Download observations CSV</button></div></header><p>“Fresh” means a successful permitted read with an observation inside the stated age threshold. “Snapshot” is bundled evidence. “Stale” means the observation is older than that threshold. A successful fetch never makes an old observation current.</p><div class="bf-table-wrap"><table class="bf-health"><caption>Provider health and freshness · retrieval time is separate from observation date</caption><thead><tr><th scope="col">Source</th><th scope="col">Coverage</th><th scope="col">Status</th><th scope="col">Last successful read</th><th scope="col">Notes</th></tr></thead><tbody data-source-health></tbody></table></div><details class="bf-glossary"><summary>A short glossary</summary><dl><div><dt>Percentage point</dt><dd>The difference between two percentages. From 4% to 5% is a rise of 1 percentage point, or 100 basis points.</dd></div><div><dt>Reference FX rate</dt><dd>A published currency benchmark for context. Banks and payment providers quote their own executable prices.</dd></div><div><dt>Year over year</dt><dd>A comparison with the same period one year earlier. Revisions and seasonal methods can affect the result.</dd></div><div><dt>Policy rate</dt><dd>A central bank’s administered rate or target. The Fed’s target is a range; it is distinct from the realized effective rate.</dd></div><div><dt>Par yield</dt><dd>The coupon rate that would price a bond at face value, estimated by Treasury for constant maturities.</dd></div><div><dt>Monthly jobs change</dt><dd>The change in nonfarm payroll employment from the previous month, seasonally adjusted; estimates can be revised.</dd></div></dl></details><div class="bf-source-links"><a href="/business-feels.json">Bundled snapshot ↗</a><a href="/api/business-feels">Request-time feed ↗</a><a href="/business-feels/openapi.json">OpenAPI contract ↗</a><a href="https://github.com/mhoydich/pointcast/blob/main/docs/business-feels-data.md">Methodology & limits ↗</a></div></section>
  <footer class="bf-footer"><a href="/">Back to PointCast ↗</a><p>A desk for noticing.<br/>Keep the context with the number.</p><span>BUSINESS FEELS / PUBLIC DATA / V.01</span></footer>
  <p class="bf-sr" role="status" aria-live="polite" data-announcement></p>
</div>
<script>import { initBusinessFeels } from '../scripts/business-feels.mjs'; const setup=()=>initBusinessFeels(document.querySelector('[data-business-feels]')); setup(); document.addEventListener('astro:page-load',setup);</script>
</BlockLayout>
