---
/**
 * /drum-race — Nouns drum race game.
 *
 * Mike 2026-05-08: "fun lets make a nouns drum race game."
 *
 * 4 Nouns line up at the start. Visitor controls Lane 1 by tapping
 * (spacebar or click) on the beat. Three AI Nouns advance by their
 * own accuracy profiles. First Noun to the finish line wins.
 *
 * Tap timing vs metronome:
 *   ≤  80ms = PERFECT  +6 advance, streak++
 *   ≤ 200ms = GOOD     +3 advance, streak resets
 *   ≤ 400ms = OK       +1 advance, streak resets
 *   else    = MISS     0 advance, streak resets
 *
 * Streak ≥ 4 = 1.5x multiplier. Streak ≥ 8 = 2.0x.
 *
 * BPM is 100. Metronome click on each beat. Each Noun has its own
 * drum voice that fires on a successful advance. Win = cascading
 * bells + confetti.
 */

import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Noun Drum Race · tap on the beat · PointCast';
const description = '4 Nouns race. You control one; tap on the beat to advance. Three AI Nouns with their own accuracy profiles. First to the finish wins.';

const RACERS = [
  { id: 313,  name: 'Marine Layer',    color: '#9ed6f0', voice: 'kick',  accuracy: 0.0,  speed: 0.0  }, // Lane 1 = player
  { id: 523,  name: 'Block Runner',    color: '#a8ff3a', voice: 'snare', accuracy: 0.78, speed: 1.05 }, // aggressive
  { id: 1042, name: 'Release Train',   color: '#ffd400', voice: 'bell',  accuracy: 0.72, speed: 1.00 }, // steady
  { id: 287,  name: '—',               color: '#f6c15e', voice: 'lead',  accuracy: 0.65, speed: 1.10 }, // erratic
];
---

<BlockLayout title={title} description={description}>
  <main class="dr" id="dr-main" data-state="idle">
    <header class="dr__header">
      <h1 class="dr__title">NOUN DRUM RACE</h1>
      <p class="dr__tag">tap on the beat · 4 nouns · first to the finish wins · spacebar or click</p>
    </header>

    <section class="dr__hud">
      <span class="dr__hud-cell">METRONOME <span class="dr__metro" id="dr-metro">○○○○</span></span>
      <span class="dr__hud-cell">BPM <strong>100</strong></span>
      <span class="dr__hud-cell">STREAK <strong id="dr-streak">0</strong></span>
      <span class="dr__hud-cell">MULT <strong id="dr-mult">1.0×</strong></span>
      <span class="dr__hud-cell" id="dr-state">— ready —</span>
    </section>

    <section class="dr__track" id="dr-track">
      <div class="dr__finish" aria-hidden="true">
        <span class="dr__finish-flag">⚑</span>
        <span class="dr__finish-line"></span>
      </div>
      {RACERS.map((r, i) => (
        <div class={`dr__lane ${i === 0 ? 'dr__lane--player' : ''}`} data-i={i} style={`--lane-color: ${r.color};`}>
          <div class="dr__lane-meta">
            <span class="dr__lane-num">{i === 0 ? '🎯' : '🤖'}</span>
            <span class="dr__lane-name">#{r.id} · {r.name}</span>
          </div>
          <div class="dr__lane-track">
            <div class="dr__noun" id={`dr-noun-${i}`} data-i={i}>
              <img src={`https://noun.pics/${r.id}.svg`} alt={`Noun ${r.id}`} width="56" height="56" loading="lazy"/>
            </div>
            <div class="dr__progress" id={`dr-progress-${i}`}></div>
          </div>
        </div>
      ))}
    </section>

    <section class="dr__pad-area">
      <button class="dr__pad" id="dr-pad" type="button" aria-label="Tap on the beat">
        <span class="dr__pad-text" id="dr-pad-text">▶ START RACE</span>
        <span class="dr__pad-hint">spacebar or click</span>
      </button>
      <div class="dr__feedback" id="dr-feedback" aria-live="polite"></div>
    </section>

    <section class="dr__panel">
      <div class="dr__pick-row">
        <span class="dr__pick-label">YOUR NOUN:</span>
        {RACERS.map((r, i) => (
          <button class={`dr__pick ${i === 0 ? 'dr__pick--active' : ''}`} data-i={i} type="button" aria-label={`Pick Noun ${r.id}`}>
            <img src={`https://noun.pics/${r.id}.svg`} alt="" width="36" height="36" loading="lazy"/>
            <span>#{r.id}</span>
          </button>
        ))}
      </div>
      <button class="dr__btn" id="dr-reset" type="button">↻ NEW RACE</button>
    </section>

    <section class="dr__win" id="dr-win" hidden>
      <div class="dr__win-card">
        <h2 class="dr__win-title" id="dr-win-title">🏆 WINNER</h2>
        <img class="dr__win-noun" id="dr-win-noun" src="" alt="" width="96" height="96"/>
        <p class="dr__win-stats" id="dr-win-stats">— stats —</p>
        <button class="dr__btn dr__btn--big" id="dr-win-again" type="button">↻ RACE AGAIN</button>
      </div>
    </section>

    <section class="dr__rules">
      <p><strong>HOW TO RACE:</strong> click START. After 3-2-1, tap on each beat. Closer to the beat = bigger advance.</p>
      <p><strong>PERFECT</strong> ≤80ms = +6 · <strong>GOOD</strong> ≤200ms = +3 · <strong>OK</strong> ≤400ms = +1 · <strong>MISS</strong> = 0</p>
      <p><strong>STREAK:</strong> 4 perfects in a row = 1.5× · 8 = 2.0× · misses break the streak.</p>
    </section>

    <section class="dr__siblings">
      <a href="/drum-jukebox">/drum-jukebox</a>
      <a href="/drum-looper">/drum-looper</a>
      <a href="/drum-beat-battle">/drum-beat-battle</a>
      <a href="/drum-audiophile">/drum-audiophile</a>
      <a href="/drum-map">/drum-map</a>
    </section>
  </main>
</BlockLayout>

<style>
  .dr { max-width: 1100px; margin: 0 auto; padding: 18px 16px 60px; font-family: var(--pc-font-sans, system-ui, sans-serif); color: #f4e7c8; background: linear-gradient(180deg, #1a0a06 0%, #0c0408 100%); min-height: 100vh; }
  .dr__header { text-align: center; margin: 18px 0 14px; }
  .dr__title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(34px, 6.5vw, 64px); letter-spacing: 0.18em; margin: 0; color: #f6c15e; text-shadow: 0 0 24px rgba(246, 193, 94, 0.40); }
  .dr__tag { font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #d4a437; opacity: 0.85; margin: 6px 0 0; }

  .dr__hud { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding: 10px 14px; border: 2px solid #5a3422; background: rgba(0, 0, 0, 0.5); margin-bottom: 14px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #d4a437; }
  .dr__hud-cell strong { color: #f6c15e; padding-left: 4px; font-size: 14px; }
  .dr__metro { color: #f6c15e; padding-left: 6px; letter-spacing: 0.18em; font-size: 14px; }

  .dr__track { position: relative; padding: 14px 14px 14px 14px; border: 3px solid #5a3422; background: linear-gradient(180deg, #2a1810 0%, #3a2418 50%, #1a0a06 100%); box-shadow: 6px 6px 0 0 #050310, inset 0 0 60px rgba(0, 0, 0, 0.55); }

  .dr__finish { position: absolute; right: 14px; top: 14px; bottom: 14px; width: 28px; pointer-events: none; z-index: 2; }
  .dr__finish-flag { position: absolute; top: -2px; left: 6px; font-size: 22px; color: #f6c15e; text-shadow: 0 0 12px rgba(246, 193, 94, 0.65); }
  .dr__finish-line { position: absolute; top: 26px; bottom: 0; left: 0; width: 14px; background: repeating-linear-gradient(45deg, #f4e7c8 0 6px, #1a0a06 6px 12px); border-left: 2px solid #f6c15e; box-shadow: 0 0 16px rgba(246, 193, 94, 0.30); }

  .dr__lane { display: grid; grid-template-columns: 200px 1fr; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px dashed rgba(212, 164, 55, 0.20); }
  .dr__lane:last-of-type { border-bottom: none; }
  .dr__lane-meta { display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; letter-spacing: 0.10em; color: #d4a437; }
  .dr__lane-num { font-size: 16px; }
  .dr__lane-name { color: #f4e7c8; opacity: 0.85; }
  .dr__lane--player { background: rgba(212, 164, 55, 0.04); border-left: 3px solid #f6c15e; padding-left: 4px; }
  .dr__lane--player .dr__lane-name { color: #f6c15e; font-weight: 800; }

  .dr__lane-track { position: relative; height: 60px; background: linear-gradient(180deg, #050310 0%, #1a0a06 100%); border: 1px solid rgba(212, 164, 55, 0.25); border-radius: 4px; padding-right: 28px; overflow: hidden; }
  .dr__progress { position: absolute; top: 0; bottom: 0; left: 0; background: linear-gradient(90deg, var(--lane-color, #d4a437) 0%, transparent 100%); opacity: 0.20; transition: width 220ms cubic-bezier(.25,.46,.45,.94); width: 0%; }
  .dr__noun { position: absolute; top: 50%; left: 0; transform: translate(0, -50%); width: 56px; height: 56px; image-rendering: pixelated; transition: left 220ms cubic-bezier(.25,.46,.45,.94), filter 200ms; filter: drop-shadow(2px 4px 0 rgba(0, 0, 0, 0.45)); }
  .dr__noun img { width: 100%; height: 100%; image-rendering: pixelated; }
  .dr__noun.dr__noun--hit { filter: drop-shadow(0 0 8px var(--lane-color, #f6c15e)) drop-shadow(2px 4px 0 rgba(0, 0, 0, 0.45)); }

  .dr__pad-area { display: flex; flex-direction: column; align-items: center; gap: 12px; margin: 22px 0 14px; }
  .dr__pad { padding: 22px 38px; border: 3px solid #d4a437; border-radius: 12px; background: linear-gradient(180deg, #2a1408 0%, #1a0a06 100%); color: #f6c15e; font-family: 'JetBrains Mono Variable', monospace; font-weight: 800; cursor: pointer; transition: transform 60ms, box-shadow 60ms, border-color 200ms; box-shadow: 4px 4px 0 0 #050310; min-width: 280px; }
  .dr__pad:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 0 #050310; border-color: #f6c15e; }
  .dr__pad:active, .dr__pad.dr__pad--tapped { transform: translate(2px, 2px); box-shadow: 1px 1px 0 0 #050310; background: linear-gradient(180deg, #5a3422 0%, #3a2410 100%); }
  .dr__pad-text { display: block; font-size: 18px; letter-spacing: 0.20em; }
  .dr__pad-hint { display: block; font-size: 10px; letter-spacing: 0.18em; color: #d4a437; opacity: 0.65; margin-top: 4px; }

  .dr__feedback { font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; letter-spacing: 0.16em; text-transform: uppercase; color: #cfc6df; min-height: 24px; transition: color 120ms; }
  .dr__feedback[data-kind='perfect'] { color: #f6c15e; text-shadow: 0 0 10px rgba(246, 193, 94, 0.65); }
  .dr__feedback[data-kind='good']    { color: #a8ff3a; }
  .dr__feedback[data-kind='ok']      { color: #d4a437; }
  .dr__feedback[data-kind='miss']    { color: #b8431a; }

  .dr__panel { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 12px 14px; border: 2px solid #5a3422; background: rgba(26, 8, 6, 0.65); margin: 14px 0; }
  .dr__pick-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .dr__pick-label { font-family: 'JetBrains Mono Variable', monospace; font-size: 10px; letter-spacing: 0.20em; text-transform: uppercase; color: #d4a437; }
  .dr__pick { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 8px; border: 2px solid #5a3422; background: #1a0a06; cursor: pointer; transition: border-color 200ms, transform 100ms; font-family: 'JetBrains Mono Variable', monospace; font-size: 9px; letter-spacing: 0.10em; color: #d4a437; }
  .dr__pick:hover { border-color: #d4a437; transform: translateY(-1px); }
  .dr__pick--active { border-color: #f6c15e; box-shadow: 0 0 0 2px #f6c15e; }
  .dr__pick img { width: 36px; height: 36px; image-rendering: pixelated; }
  .dr__btn { padding: 9px 16px; border: 2px solid #d4a437; background: linear-gradient(180deg, #2a1408 0%, #1a0a06 100%); color: #f6c15e; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; cursor: pointer; box-shadow: 2px 2px 0 0 #050310; margin-left: auto; }
  .dr__btn:hover { transform: translate(-1px, -1px); border-color: #f6c15e; }
  .dr__btn--big { padding: 12px 22px; font-size: 13px; margin: 0; }

  .dr__win { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(10, 4, 6, 0.85); z-index: 100; padding: 20px; }
  .dr__win[hidden] { display: none; }
  .dr__win-card { padding: 28px 36px; border: 4px double #f6c15e; background: #1a0a06; text-align: center; box-shadow: 0 0 0 4px #050310, 0 0 40px rgba(246, 193, 94, 0.50); animation: dr-win-pop 0.6s cubic-bezier(.34,1.56,.64,1); }
  @keyframes dr-win-pop { 0% { transform: scale(0.5); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  .dr__win-title { font-family: 'JetBrains Mono Variable', monospace; font-size: clamp(28px, 4vw, 48px); letter-spacing: 0.20em; margin: 0 0 12px; color: #f6c15e; text-shadow: 0 0 20px rgba(246, 193, 94, 0.65); }
  .dr__win-noun { display: block; margin: 12px auto; image-rendering: pixelated; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.6)); }
  .dr__win-stats { font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: #cfc6df; margin: 16px 0; letter-spacing: 0.12em; }

  .dr__confetti { position: fixed; pointer-events: none; width: 8px; height: 8px; z-index: 99; animation: dr-confetti-fall 3s linear forwards; }
  @keyframes dr-confetti-fall { from { transform: translateY(0) rotate(0); opacity: 1; } to { transform: translateY(100vh) rotate(720deg); opacity: 0; } }

  .dr__rules { padding: 14px 18px; border: 2px dashed rgba(212, 164, 55, 0.45); background: rgba(0, 0, 0, 0.3); color: #cfc6df; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; line-height: 1.55; margin: 14px 0; }
  .dr__rules p { margin: 4px 0; }
  .dr__rules strong { color: #f6c15e; }

  .dr__siblings { display: flex; justify-content: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  .dr__siblings a { color: #d4a437; text-decoration: none; }
  .dr__siblings a:hover { color: #f6c15e; text-decoration: underline; }

  @media (max-width: 720px) { .dr__lane { grid-template-columns: 130px 1fr; } .dr__noun { width: 44px; height: 44px; } .dr__lane-track { height: 48px; } }
  @media (prefers-reduced-motion: reduce) { .dr__noun, .dr__progress, .dr__win-card { transition: none !important; animation: none !important; } }
</style>

<script>
  type Voice = 'kick' | 'snare' | 'bell' | 'lead';
  interface Racer { id: number; name: string; color: string; voice: Voice; accuracy: number; speed: number; }

  const RACERS: Racer[] = [
    { id: 313,  name: 'Marine Layer',    color: '#9ed6f0', voice: 'kick',  accuracy: 0.0,  speed: 0.0  },
    { id: 523,  name: 'Block Runner',    color: '#a8ff3a', voice: 'snare', accuracy: 0.78, speed: 1.05 },
    { id: 1042, name: 'Release Train',   color: '#ffd400', voice: 'bell',  accuracy: 0.72, speed: 1.00 },
    { id: 287,  name: '—',               color: '#f6c15e', voice: 'lead',  accuracy: 0.65, speed: 1.10 },
  ];
  const NOUN_POOL = [313, 523, 742, 1042, 1189, 287, 612, 1084, 928, 1, 42, 99, 156, 244, 612, 833];

  const BPM = 100;
  const STEP_MS = 60000 / BPM; // 600ms per beat
  const FINISH = 100; // percent
  let playerIdx = 0;

  // ─── Audio ──────────────────────────────────────────────────
  let actx: AudioContext | null = null;
  function ctx() { if (!actx) { const AC = (window as any).AudioContext || (window as any).webkitAudioContext; actx = new AC(); } if (actx && actx.state === 'suspended') actx.resume(); return actx!; }
  function pK(t:number){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(120,t);o.frequency.exponentialRampToValueAtTime(40,t+0.18);g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.25);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.3);}
  function pSn(t:number){const a=ctx(),buf=a.createBuffer(1,a.sampleRate*0.10,a.sampleRate),d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;const n=a.createBufferSource();n.buffer=buf;const bp=a.createBiquadFilter();bp.type='bandpass';bp.frequency.value=2200;bp.Q.value=1.4;const g=a.createGain();g.gain.setValueAtTime(0.20,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.12);n.connect(bp).connect(g).connect(a.destination);n.start(t);n.stop(t+0.14);}
  function pB(t:number, base = 1320){const a=ctx();[base, base*2, base*3].forEach((f,i)=>{const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime([0.16,0.09,0.05][i],t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.6);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.7);});}
  function pL(t:number){const a=ctx();const D=[0,4,7,12,14],deg=D[Math.floor(Math.random()*D.length)],f=264*Math.pow(2,deg/12);const o=a.createOscillator(),g=a.createGain(),lp=a.createBiquadFilter();o.type='sawtooth';o.frequency.setValueAtTime(f,t);lp.type='lowpass';lp.frequency.setValueAtTime(2200,t);lp.frequency.exponentialRampToValueAtTime(800,t+0.4);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.13,t+0.005);g.gain.exponentialRampToValueAtTime(0.0001,t+0.4);o.connect(lp).connect(g).connect(a.destination);o.start(t);o.stop(t+0.45);}
  function pTick(t:number){const a=ctx();const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(880,t);g.gain.setValueAtTime(0.10,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.04);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.05);}
  function pTickAccent(t:number){const a=ctx();const o=a.createOscillator(),g=a.createGain();o.type='sine';o.frequency.setValueAtTime(1320,t);g.gain.setValueAtTime(0.14,t);g.gain.exponentialRampToValueAtTime(0.0001,t+0.06);o.connect(g).connect(a.destination);o.start(t);o.stop(t+0.07);}
  const PLAY: Record<Voice, (t: number) => void> = { kick: pK, snare: pSn, bell: (t) => pB(t, 1320), lead: pL };
  function sndWin() { const a = ctx(); [1320, 1760, 2200, 2640].forEach((f, i) => { try { pB(a.currentTime + i * 0.18, f); } catch {} }); }

  // ─── State ──────────────────────────────────────────────────
  type Phase = 'idle' | 'countdown' | 'racing' | 'won';
  let phase: Phase = 'idle';
  let progress = [0, 0, 0, 0]; // 0-100%
  let streak = 0;
  let raceTimer: number | null = null;
  let lastBeatT = 0;
  let beatCount = 0;
  let countdownTimer: number | null = null;
  let perfects = 0, goods = 0, oks = 0, misses = 0;

  const trackEl = document.getElementById('dr-track');
  const padEl = document.getElementById('dr-pad') as HTMLButtonElement;
  const padText = document.getElementById('dr-pad-text');
  const stateEl = document.getElementById('dr-state');
  const streakEl = document.getElementById('dr-streak');
  const multEl = document.getElementById('dr-mult');
  const metroEl = document.getElementById('dr-metro');
  const feedbackEl = document.getElementById('dr-feedback');
  const winEl = document.getElementById('dr-win');
  const winTitleEl = document.getElementById('dr-win-title');
  const winNounEl = document.getElementById('dr-win-noun') as HTMLImageElement | null;
  const winStatsEl = document.getElementById('dr-win-stats');
  const resetBtn = document.getElementById('dr-reset');
  const winAgainBtn = document.getElementById('dr-win-again');
  const pickBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.dr__pick'));

  function paintRacer(i: number) {
    const p = progress[i];
    const noun = document.getElementById(`dr-noun-${i}`);
    const prog = document.getElementById(`dr-progress-${i}`);
    if (noun) {
      const trackW = (noun.parentElement as HTMLElement).clientWidth - 56 - 28;
      const x = (p / 100) * trackW;
      (noun as HTMLElement).style.left = `${x}px`;
    }
    if (prog) (prog as HTMLElement).style.width = `${p}%`;
  }
  function bumpRacer(i: number) {
    const noun = document.getElementById(`dr-noun-${i}`);
    if (noun) { noun.classList.add('dr__noun--hit'); setTimeout(() => noun.classList.remove('dr__noun--hit'), 110); }
  }

  function setMultiplier(): number {
    if (streak >= 8) return 2.0;
    if (streak >= 4) return 1.5;
    return 1.0;
  }
  function updateHud() {
    if (streakEl) streakEl.textContent = String(streak);
    if (multEl) multEl.textContent = `${setMultiplier().toFixed(1)}×`;
  }

  function feedback(kind: 'perfect' | 'good' | 'ok' | 'miss', dx: number) {
    if (!feedbackEl) return;
    feedbackEl.textContent = (
      kind === 'perfect' ? `★ PERFECT  +${dx.toFixed(1)}` :
      kind === 'good'    ? `✓ GOOD     +${dx.toFixed(1)}` :
      kind === 'ok'      ? `· OK       +${dx.toFixed(1)}` :
      `✗ MISS`
    );
    feedbackEl.dataset.kind = kind;
  }

  function tick() {
    if (phase !== 'racing') return;
    const a = ctx();
    const t = a.currentTime + 0.02;
    // Metronome click — accent on beat 1 of every 4
    try { (beatCount % 4 === 0) ? pTickAccent(t) : pTick(t); } catch {}
    if (metroEl) metroEl.textContent = ['●○○○', '○●○○', '○○●○', '○○○●'][beatCount % 4];
    lastBeatT = performance.now();
    // AI Nouns try to advance
    for (let i = 1; i < RACERS.length; i++) {
      const r = RACERS[i];
      if (Math.random() < r.accuracy) {
        const dx = (3 + Math.random() * 3) * r.speed;
        progress[i] = Math.min(100, progress[i] + dx);
        bumpRacer(i);
        try { PLAY[r.voice](a.currentTime + 0.04 + Math.random() * 0.10); } catch {}
        paintRacer(i);
        if (progress[i] >= FINISH && phase === 'racing') return win(i);
      }
    }
    beatCount++;
  }

  function win(idx: number) {
    if (phase === 'won') return;
    phase = 'won';
    if (raceTimer) { clearInterval(raceTimer); raceTimer = null; }
    const r = RACERS[idx];
    const total = perfects + goods + oks + misses;
    const accuracy = total > 0 ? Math.round(((perfects + goods) / total) * 100) : 0;
    if (winTitleEl) winTitleEl.textContent = idx === playerIdx ? `🏆 YOU WIN` : `🤖 ${r.name.toUpperCase()} WINS`;
    if (winNounEl) winNounEl.src = `https://noun.pics/${r.id}.svg`;
    if (winStatsEl) winStatsEl.textContent = `Noun #${r.id} · streak high ${streakHigh} · your accuracy ${accuracy}% (P${perfects}/G${goods}/O${oks}/M${misses})`;
    if (winEl) winEl.hidden = false;
    sndWin();
    celebrate();
  }

  let streakHigh = 0;

  function attemptTap() {
    if (phase !== 'racing') return;
    const now = performance.now();
    const offset = Math.abs(now - lastBeatT);
    let kind: 'perfect' | 'good' | 'ok' | 'miss' = 'miss';
    let baseDx = 0;
    if (offset <= 80) { kind = 'perfect'; baseDx = 6; streak++; perfects++; }
    else if (offset <= 200) { kind = 'good'; baseDx = 3; streak = 0; goods++; }
    else if (offset <= 400) { kind = 'ok'; baseDx = 1; streak = 0; oks++; }
    else { kind = 'miss'; baseDx = 0; streak = 0; misses++; }
    streakHigh = Math.max(streakHigh, streak);
    const mult = setMultiplier();
    const dx = baseDx * mult;
    progress[playerIdx] = Math.min(100, progress[playerIdx] + dx);
    bumpRacer(playerIdx);
    if (kind !== 'miss') { try { PLAY[RACERS[playerIdx].voice](ctx().currentTime + 0.02); } catch {} }
    feedback(kind, dx);
    updateHud();
    paintRacer(playerIdx);
    if (padEl) { padEl.classList.add('dr__pad--tapped'); setTimeout(() => padEl.classList.remove('dr__pad--tapped'), 80); }
    if (progress[playerIdx] >= FINISH) win(playerIdx);
  }

  function startCountdown() {
    if (phase !== 'idle' && phase !== 'won') return;
    phase = 'countdown';
    progress = [0, 0, 0, 0];
    streak = 0; streakHigh = 0; beatCount = 0; perfects = 0; goods = 0; oks = 0; misses = 0;
    paintRacer(0); paintRacer(1); paintRacer(2); paintRacer(3);
    updateHud();
    if (winEl) winEl.hidden = true;
    let n = 3;
    if (padText) padText.textContent = `${n}…`;
    if (stateEl) stateEl.textContent = '— get ready —';
    if (countdownTimer) clearInterval(countdownTimer);
    ctx();
    try { pTickAccent(ctx().currentTime + 0.02); } catch {}
    countdownTimer = window.setInterval(() => {
      n--;
      if (n > 0) {
        if (padText) padText.textContent = `${n}…`;
        try { pTickAccent(ctx().currentTime + 0.02); } catch {}
      } else {
        if (countdownTimer) clearInterval(countdownTimer);
        startRace();
      }
    }, 800);
  }

  function startRace() {
    phase = 'racing';
    if (padText) padText.textContent = '🥁 TAP ON THE BEAT';
    if (stateEl) stateEl.textContent = '— racing —';
    if (feedbackEl) { feedbackEl.textContent = ''; delete feedbackEl.dataset.kind; }
    lastBeatT = performance.now();
    if (raceTimer) clearInterval(raceTimer);
    tick(); // first beat immediately
    raceTimer = window.setInterval(tick, STEP_MS);
  }

  function reset() {
    phase = 'idle';
    if (raceTimer) { clearInterval(raceTimer); raceTimer = null; }
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
    progress = [0, 0, 0, 0]; streak = 0; streakHigh = 0; beatCount = 0;
    paintRacer(0); paintRacer(1); paintRacer(2); paintRacer(3);
    updateHud();
    if (padText) padText.textContent = '▶ START RACE';
    if (stateEl) stateEl.textContent = '— ready —';
    if (feedbackEl) { feedbackEl.textContent = ''; delete feedbackEl.dataset.kind; }
    if (metroEl) metroEl.textContent = '○○○○';
    if (winEl) winEl.hidden = true;
  }

  // Events
  if (padEl) padEl.addEventListener('click', () => {
    if (phase === 'idle' || phase === 'won') startCountdown();
    else if (phase === 'racing') attemptTap();
  });
  document.addEventListener('keydown', (e) => {
    if (e.code === 'Space') {
      e.preventDefault();
      if (phase === 'idle' || phase === 'won') startCountdown();
      else if (phase === 'racing') attemptTap();
    }
    if (e.key === 'r' || e.key === 'R') reset();
  });
  if (resetBtn) resetBtn.addEventListener('click', reset);
  if (winAgainBtn) winAgainBtn.addEventListener('click', () => { reset(); startCountdown(); });

  // Pick player Noun
  pickBtns.forEach(btn => btn.addEventListener('click', () => {
    if (phase === 'racing' || phase === 'countdown') return;
    pickBtns.forEach(b => b.classList.remove('dr__pick--active'));
    btn.classList.add('dr__pick--active');
    playerIdx = Number(btn.dataset.i);
    // Move the player marker indicator (visual stays via lane order)
  }));

  function celebrate() {
    const colors = ['#f6c15e', '#ff8a4a', '#ff5f7a', '#a8ff3a', '#5fbafd', '#b09bf0'];
    for (let i = 0; i < 60; i++) {
      const c = document.createElement('div');
      c.className = 'dr__confetti';
      c.style.background = colors[i % colors.length];
      c.style.left = `${Math.random() * 100}vw`;
      c.style.top = `${-20 - Math.random() * 100}px`;
      c.style.animationDelay = `${Math.random() * 0.6}s`;
      c.style.animationDuration = `${2.4 + Math.random() * 1.6}s`;
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 4000);
    }
  }

  // Init
  setTimeout(() => { paintRacer(0); paintRacer(1); paintRacer(2); paintRacer(3); }, 50);
</script>
