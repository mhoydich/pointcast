---
/**
 * /spells — the magic words library.
 *
 * Browse every spell in the catalog, cast from the page, copy the +id
 * token to type in the omnibox. URL is /spells because /cast is taken
 * by PrizeCast (the no-loss savings lottery). The dock slot is still
 * named CAST — these are the spells it casts.
 *
 * v2 wrap-up (catalog ≥20): added compact table view. Toggle between
 * the card grid (browsing) and a flat "every spell + Cast button per
 * row" table (reference). View preference is persisted in localStorage.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { SPELLS } from '../data/spells';

const byKind = {
  burst:     SPELLS.filter(s => s.kind === 'burst'),
  companion: SPELLS.filter(s => s.kind === 'companion'),
  ambient:   SPELLS.filter(s => s.kind === 'ambient'),
};

const kindLabel: Record<string, string> = {
  burst:     'BURSTS',
  companion: 'COMPANIONS',
  ambient:   'AMBIENT',
};

const kindBlurb: Record<string, string> = {
  burst:     'One-shot — spawns, delights, self-cleans.',
  companion: 'Small creatures that cross the screen, then wander off.',
  ambient:   'Persistent — stays until you clear it.',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'CollectionPage',
  '@id':      'https://pointcast.xyz/spells',
  name:       'PointCast Spells — Magic Words',
  description:'Every magic word in the PointCast dock. Type +spell in the omnibox or click Cast.',
  url:        'https://pointcast.xyz/spells',
  hasPart: SPELLS.map(s => ({
    '@type': 'Thing',
    name:  s.label,
    description: s.blurb,
    identifier: s.id,
  })),
};
---

<BlockLayout
  title="Spells — Magic Words"
  description="Every magic word in the PointCast dock. Type +spell in the omnibox or click a chip in slot 06 CAST."
  jsonLd={jsonLd}
>
  <div class="pg" data-view="grid" id="js-pg">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <span>spells</span>
    </nav>

    <header class="head">
      <p class="kicker">06 CAST · MAGIC WORDS · v2</p>
      <h1 class="display">Spells.</h1>
      <p class="dek">
        Type <code>+spell</code> in the omnibox, or click a chip in slot&nbsp;06&nbsp;CAST.
        {SPELLS.length} magic words, three kinds.
      </p>
      <div class="head-actions">
        <button class="btn btn--clear" id="js-clear-all" type="button">🌪 clear all</button>
        <button class="btn btn--cast-all" id="js-cast-all" type="button">✨ cast everything</button>
        <div class="view-toggle" role="group" aria-label="View mode">
          <button class="btn btn--view is-active" id="js-view-grid" type="button" data-view-mode="grid" aria-pressed="true">grid</button>
          <button class="btn btn--view" id="js-view-table" type="button" data-view-mode="table" aria-pressed="false">list</button>
        </div>
      </div>
    </header>

    {/* ── GRID VIEW ──────────────────────────────────────────────────── */}
    <div class="grid-view" aria-label="Spell grid">
      {(['burst', 'companion', 'ambient'] as const).map(kind => (
        <section class="section" aria-label={kindLabel[kind]}>
          <div class="section-head">
            <p class="section-kicker">{kindLabel[kind]}</p>
            <p class="section-note">{kindBlurb[kind]}</p>
          </div>
          <div class="grid" role="list">
            {byKind[kind].map(spell => (
              <article
                class="card"
                id={spell.id}
                role="listitem"
                style={`--accent: ${spell.accent}`}
                data-spell-id={spell.id}
              >
                <div class="card-top">
                  <span class="glyph" aria-hidden="true">{spell.glyph}</span>
                  <div class="card-meta">
                    <p class="spell-id mono">+{spell.id}</p>
                    <span class={`pill pill--${kind}`}>{kind}{spell.durationMs ? ` · ${(spell.durationMs / 1000).toFixed(0)}s` : ''}</span>
                  </div>
                </div>
                <p class="blurb">{spell.blurb}</p>
                <div class="card-actions">
                  <button
                    class="btn btn--cast"
                    type="button"
                    data-cast={spell.id}
                    aria-label={`Cast ${spell.label}`}
                  >cast</button>
                  <button
                    class="btn btn--copy"
                    type="button"
                    data-copy={spell.id}
                    aria-label={`Copy +${spell.id} to clipboard`}
                  >copy</button>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    {/* ── TABLE VIEW ─────────────────────────────────────────────────── */}
    <div class="table-view" aria-label="Spell table" hidden>
      <table class="tbl">
        <thead>
          <tr>
            <th class="th th--glyph" scope="col" aria-label="Glyph"></th>
            <th class="th th--id"   scope="col">spell</th>
            <th class="th th--kind" scope="col">kind</th>
            <th class="th th--blurb th--wide" scope="col">feel</th>
            <th class="th th--actions" scope="col" aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody>
          {SPELLS.map(spell => (
            <tr class="trow" id={`t-${spell.id}`} style={`--accent: ${spell.accent}`}>
              <td class="td td--glyph" aria-hidden="true">{spell.glyph}</td>
              <td class="td td--id">
                <span class="mono tbl-id">+{spell.id}</span>
              </td>
              <td class="td td--kind">
                <span class={`pill pill--${spell.kind}`}>
                  {spell.kind}{spell.durationMs ? ` · ${(spell.durationMs / 1000).toFixed(0)}s` : ''}
                </span>
              </td>
              <td class="td td--blurb">{spell.blurb}</td>
              <td class="td td--actions">
                <button
                  class="btn btn--cast"
                  type="button"
                  data-cast={spell.id}
                  aria-label={`Cast ${spell.label}`}
                >cast</button>
                <button
                  class="btn btn--copy"
                  type="button"
                  data-copy={spell.id}
                  aria-label={`Copy +${spell.id} to clipboard`}
                >copy</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <footer class="pg-footer">
      <p class="pg-footer__note">
        Type <code>+spellname</code> in the omnibox anywhere on PointCast.
        Spells stack — cast as many as you like. Clear with the tray&rsquo;s
        ✕ or <code>pc:spell:clear</code>.
      </p>
      <p class="pg-footer__note">
        Studied in <a href="/ues/track-05#week-2">UES Track 05 · Week 2 — Spells, not Buttons</a>.
      </p>
      <p class="pg-footer__note">
        <a href="/cast">Prize Cast →</a>
        &nbsp;·&nbsp;
        <a href="/">Home →</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      'use strict';

      var LS_KEY = 'pc-spells-view';

      function dispatch(id) {
        window.dispatchEvent(new CustomEvent('pc:spell:cast', { detail: { id: id } }));
      }

      function setView(mode) {
        var pg        = document.getElementById('js-pg');
        var gridView  = pg && pg.querySelector('.grid-view');
        var tableView = pg && pg.querySelector('.table-view');
        var btnGrid   = document.getElementById('js-view-grid');
        var btnTable  = document.getElementById('js-view-table');
        if (!pg || !gridView || !tableView) return;

        pg.dataset.view = mode;
        if (mode === 'table') {
          gridView.hidden  = true;
          tableView.hidden = false;
          if (btnGrid)  { btnGrid.classList.remove('is-active');  btnGrid.setAttribute('aria-pressed', 'false'); }
          if (btnTable) { btnTable.classList.add('is-active');    btnTable.setAttribute('aria-pressed', 'true'); }
        } else {
          gridView.hidden  = false;
          tableView.hidden = true;
          if (btnGrid)  { btnGrid.classList.add('is-active');     btnGrid.setAttribute('aria-pressed', 'true'); }
          if (btnTable) { btnTable.classList.remove('is-active'); btnTable.setAttribute('aria-pressed', 'false'); }
        }
        try { localStorage.setItem(LS_KEY, mode); } catch (_) {}
      }

      // restore saved view
      (function () {
        try {
          var saved = localStorage.getItem(LS_KEY);
          if (saved === 'table') setView('table');
        } catch (_) {}
      })();

      document.addEventListener('click', function (e) {
        var t = e.target;

        // view toggle
        var viewBtn = t.closest('[data-view-mode]');
        if (viewBtn) { setView(viewBtn.dataset.viewMode); return; }

        // cast button
        var castEl = t.closest('[data-cast]');
        if (castEl) { dispatch(castEl.dataset.cast); return; }

        // copy button
        var copyEl = t.closest('[data-copy]');
        if (copyEl) {
          var id   = copyEl.dataset.copy;
          var text = '+' + id;
          try {
            navigator.clipboard.writeText(text).then(function () {
              copyEl.textContent = '✓ copied';
              setTimeout(function () { copyEl.textContent = 'copy'; }, 1800);
            });
          } catch (_) {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity  = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            copyEl.textContent = '✓ copied';
            setTimeout(function () { copyEl.textContent = 'copy'; }, 1800);
          }
          return;
        }

        // clear all
        if (t.closest('#js-clear-all')) {
          window.dispatchEvent(new CustomEvent('pc:spell:clear'));
          return;
        }

        // cast everything — stagger 250ms apart
        if (t.closest('#js-cast-all')) {
          var ids = Array.from(document.querySelectorAll('[data-cast]'))
            .map(function (el) { return el.dataset.cast; })
            .filter(function (id, i, arr) { return arr.indexOf(id) === i; });
          ids.forEach(function (id, i) {
            setTimeout(function () { dispatch(id); }, i * 250);
          });
          return;
        }
      });
    })();
  </script>
</BlockLayout>

<style>
  .pg {
    max-width: 1100px;
    margin: 0 auto;
    padding: 18px 16px 80px;
  }

  /* ─── crumb ─── */
  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    margin-bottom: 20px;
  }
  .crumb a { color: var(--pc-ink-soft); }

  /* ─── head ─── */
  .kicker {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    margin: 0 0 8px;
  }

  .display {
    font-family: var(--pc-font-sans);
    font-size: clamp(2.6rem, 10vw, 5.4rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.024em;
    margin: 0 0 12px;
    color: var(--pc-ink);
  }

  .dek {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
    max-width: 48ch;
  }

  .dek code {
    font-family: var(--pc-font-mono);
    font-size: 13px;
    background: #f3f0eb;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .head-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    padding-bottom: 28px;
    border-bottom: 1.5px solid var(--pc-ink);
    margin-bottom: 32px;
  }

  /* ─── view toggle ─── */
  .view-toggle {
    display: flex;
    gap: 0;
    margin-left: auto;
  }

  .btn--view {
    border-radius: 0;
    border-color: var(--pc-rule, #d8d4cc);
    color: var(--pc-ink-muted);
  }

  .btn--view:first-child { border-radius: 2px 0 0 2px; }
  .btn--view:last-child  { border-radius: 0 2px 2px 0; border-left: none; }

  .btn--view.is-active {
    background: var(--pc-ink);
    color: #fff;
    border-color: var(--pc-ink);
  }

  /* ─── section ─── */
  .section {
    margin-bottom: 40px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 16px;
  }

  .section-kicker {
    font-family: var(--pc-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-ink);
    margin: 0;
    white-space: nowrap;
  }

  .section-note {
    margin: 0;
    font-size: 13px;
    color: var(--pc-ink-muted);
    line-height: 1.4;
  }

  /* ─── grid ─── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }

  /* ─── card ─── */
  .card {
    border: 1.5px solid var(--pc-rule, #d8d4cc);
    border-radius: 3px;
    background: #fff;
    padding: 14px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scroll-margin-top: 72px;
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .glyph {
    font-size: 28px;
    line-height: 1;
    flex-shrink: 0;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .mono {
    font-family: var(--pc-font-mono);
  }

  .spell-id {
    font-size: 13px;
    font-weight: 500;
    color: var(--pc-ink);
    margin: 0;
    letter-spacing: 0.04em;
  }

  .pill {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 2px;
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pill--burst    { background: #fef2e2; color: #8a4a0a; }
  .pill--companion{ background: #e8f4ff; color: #0a4a7a; }
  .pill--ambient  { background: #edf7f0; color: #0a5a2a; }

  .blurb {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
    flex: 1;
  }

  .card-actions {
    display: flex;
    gap: 7px;
  }

  /* ─── table view ─── */
  .table-view {
    overflow-x: auto;
    margin-bottom: 40px;
  }

  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .th {
    font-family: var(--pc-font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    text-align: left;
    padding: 0 10px 8px;
    border-bottom: 1.5px solid var(--pc-ink);
    white-space: nowrap;
  }

  .th--glyph   { width: 36px; padding-left: 0; }
  .th--id      { width: 120px; }
  .th--kind    { width: 130px; }
  .th--wide    { }
  .th--actions { width: 120px; text-align: right; }

  .trow {
    border-bottom: 1px solid var(--pc-rule, #d8d4cc);
    transition: background 0.1s;
  }

  .trow:hover { background: #faf8f4; }

  .td {
    padding: 9px 10px;
    vertical-align: middle;
    color: var(--pc-ink-soft);
    line-height: 1.4;
  }

  .td--glyph   { font-size: 20px; padding-left: 0; line-height: 1; }
  .td--id      { }
  .td--kind    { }
  .td--blurb   { color: var(--pc-ink-soft); }
  .td--actions { text-align: right; white-space: nowrap; }

  .tbl-id {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--pc-ink);
  }

  /* ─── buttons ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 2px;
    border: 1.5px solid;
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    background: transparent;
    transition: background 0.12s, color 0.12s;
  }

  .btn--cast {
    border-color: var(--accent, var(--pc-ink));
    color: var(--accent, var(--pc-ink));
  }

  .btn--cast:hover {
    background: var(--accent, var(--pc-ink));
    color: #fff;
  }

  .btn--copy {
    border-color: var(--pc-rule, #d8d4cc);
    color: var(--pc-ink-muted);
  }

  .btn--copy:hover {
    border-color: var(--pc-ink-muted);
    color: var(--pc-ink);
  }

  .btn--clear {
    border-color: #8a2432;
    color: #8a2432;
  }

  .btn--clear:hover {
    background: #8a2432;
    color: #fff;
  }

  .btn--cast-all {
    border-color: var(--pc-ink);
    color: var(--pc-ink);
  }

  .btn--cast-all:hover {
    background: var(--pc-ink);
    color: #fff;
  }

  /* ─── footer ─── */
  .pg-footer {
    border-top: 1px solid var(--pc-rule, #d8d4cc);
    padding-top: 24px;
    margin-top: 8px;
  }

  .pg-footer__note {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--pc-ink-muted);
    line-height: 1.5;
  }

  .pg-footer__note code {
    font-family: var(--pc-font-mono);
    font-size: 11px;
    background: #f3f0eb;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .pg-footer__note a {
    color: var(--pc-ink-soft);
  }

  /* ─── responsive ─── */
  @media (min-width: 600px) {
    .pg { padding-left: 24px; padding-right: 24px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }

  @media (max-width: 400px) {
    .grid { grid-template-columns: 1fr; }
    .section-head { flex-direction: column; gap: 4px; }
    .view-toggle { margin-left: 0; }
    .th--blurb { display: none; }
    .td--blurb { display: none; }
  }
</style>
