---
/**
 * /spells — the full spell catalog.
 *
 * 36 magic words, one Cast button each. Click any button and SpellLayer
 * renders the effect into the fixed overlay above the page — no navigation,
 * no reload. Works because BlockLayout already mounts SpellLayer once near
 * </body>, so the pc:spell:cast CustomEvent reaches it regardless of which
 * page fired it.
 *
 * Note: /cast is occupied by the Prize Cast Tezos product. This page lives
 * at /spells. A /cast → /spells redirect is a decision for Mike.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import { SPELLS } from '../data/spells';

const kindOrder: Record<string, number> = { burst: 0, companion: 1, ambient: 2 };
const sorted = [...SPELLS].sort((a, b) => {
  const kd = (kindOrder[a.kind] ?? 9) - (kindOrder[b.kind] ?? 9);
  return kd !== 0 ? kd : a.label.localeCompare(b.label);
});

const counts = SPELLS.reduce(
  (acc, s) => { acc[s.kind] = (acc[s.kind] ?? 0) + 1; return acc; },
  {} as Record<string, number>,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://pointcast.xyz/spells',
  name: 'PointCast Spell Catalog',
  description: `${SPELLS.length} magic words you can cast from the dock. Type +spell or tap a chip.`,
  url: 'https://pointcast.xyz/spells',
};
---

<BlockLayout
  title="Spell Catalog"
  description={`${SPELLS.length} magic words. Type +spell in the omnibox or tap a chip in slot 06 CAST.`}
  jsonLd={jsonLd}
>
  <div class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <span>spells</span>
    </nav>

    <header class="head">
      <p class="kicker">06 CAST · SPELL CATALOG · {SPELLS.length} SPELLS</p>
      <h1 class="display">Magic words.</h1>
      <p class="dek">
        Type <code>+spell</code> in the dock omnibox or tap any Cast button below.
        Effects render into a fixed overlay — no navigation, no reload.
      </p>
      <div class="kind-row" role="presentation">
        <span class="pill pill--burst">BURST · {counts.burst ?? 0}</span>
        <span class="pill pill--companion">COMPANION · {counts.companion ?? 0}</span>
        <span class="pill pill--ambient">AMBIENT · {counts.ambient ?? 0}</span>
      </div>
    </header>

    <section class="catalog" aria-label="Spell catalog">
      {sorted.map((spell) => (
        <article class={`card card--${spell.kind}`} data-spell-id={spell.id}>
          <div class="card__top">
            <span class="card__glyph" aria-hidden="true">{spell.glyph}</span>
            <div class="card__meta">
              <span class={`kind-chip kind-chip--${spell.kind}`}>{spell.kind}</span>
              {spell.durationMs && (
                <span class="dur">{Math.round(spell.durationMs / 1000)}s</span>
              )}
            </div>
          </div>
          <h2 class="card__name">{spell.label}</h2>
          <p class="card__blurb">{spell.blurb}</p>
          <button
            class="cast-btn"
            type="button"
            data-spell={spell.id}
            aria-label={`Cast ${spell.label}`}
            style={`--spell-accent:${spell.accent}`}
          >
            + cast
          </button>
        </article>
      ))}
    </section>

    <footer class="foot">
      <p class="foot__note">
        Spells are pure DOM / CSS — no dependencies, no external CDNs.
        All animations respect <code>prefers-reduced-motion</code>.
        New spells land via hourly sprint PRs into
        <code>src/data/spells.ts</code> +
        <code>src/components/SpellLayer.astro</code>.
      </p>
      <p class="foot__omnibox">
        <strong>Omnibox shorthand:</strong>
        type <code>+confetti</code>, <code>+rain</code>, <code>+cat</code> … in the
        dock bar at the bottom of any PointCast page.
      </p>
    </footer>
  </div>
</BlockLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cast-btn[data-spell]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.spell;
      if (!id) return;
      document.dispatchEvent(new CustomEvent('pc:spell:cast', { detail: { id } }));
      // brief visual feedback on the button
      btn.textContent = '✨ cast!';
      setTimeout(() => { btn.textContent = '+ cast'; }, 1400);
    });
  });
</script>

<style>
  .page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 18px 16px 80px;
  }

  /* ── crumb ── */
  .crumb {
    font-family: var(--pc-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    margin-bottom: 18px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .crumb a { color: var(--pc-ink-muted); text-decoration: none; }
  .crumb a:hover { color: var(--pc-ink); }

  /* ── head ── */
  .head {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1.5px solid var(--pc-ink);
  }

  .kicker {
    font-family: var(--pc-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-ink-muted);
    margin: 0 0 8px;
  }

  .display {
    font-family: var(--pc-font-sans);
    font-size: clamp(2.4rem, 10vw, 5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.022em;
    margin: 0 0 14px;
    color: var(--pc-ink);
  }

  .dek {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--pc-ink-soft);
    max-width: 54ch;
  }

  .dek code {
    font-family: var(--pc-font-mono);
    font-size: 13px;
    background: var(--pc-rule-soft, #f0eee6);
    padding: 1px 5px;
    border-radius: 2px;
  }

  /* kind summary pills in header */
  .kind-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    font-family: var(--pc-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
    border: 1.25px solid;
  }

  .pill--burst    { color: #8a2432; border-color: #8a2432; background: #fdf0f1; }
  .pill--companion { color: #7a5800; border-color: #c4952e; background: #fdf7ea; }
  .pill--ambient  { color: #1b4a8a; border-color: #4A9EFF; background: #edf4ff; }

  /* ── catalog grid ── */
  .catalog {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
    margin-bottom: 32px;
  }

  /* ── spell card ── */
  .card {
    display: flex;
    flex-direction: column;
    border: 1.25px solid var(--pc-rule, #e2e0d8);
    border-radius: 3px;
    background: #fff;
    padding: 14px 14px 12px;
    position: relative;
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--pc-ink, #1a1814);
  }

  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .card__glyph {
    font-size: 26px;
    line-height: 1;
    display: block;
  }

  .card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .kind-chip {
    font-family: var(--pc-font-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 5px;
    border-radius: 2px;
  }

  .kind-chip--burst    { background: #fdf0f1; color: #8a2432; }
  .kind-chip--companion { background: #fdf7ea; color: #7a5800; }
  .kind-chip--ambient  { background: #edf4ff; color: #1b4a8a; }

  .dur {
    font-family: var(--pc-font-mono);
    font-size: 8px;
    letter-spacing: 0.10em;
    color: var(--pc-ink-muted, #999);
  }

  .card__name {
    font-family: var(--pc-font-sans);
    font-size: 17px;
    font-weight: 500;
    color: var(--pc-ink);
    margin: 0 0 5px;
    line-height: 1.1;
  }

  .card__blurb {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--pc-ink-soft, #666);
    margin: 0 0 auto;
    flex: 1;
    padding-bottom: 12px;
  }

  /* ── cast button ── */
  .cast-btn {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 7px 0;
    background: var(--spell-accent, #d4a437);
    color: #fff;
    border: none;
    border-radius: 2px;
    font-family: var(--pc-font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.12s, transform 0.1s;
    -webkit-font-smoothing: antialiased;
  }

  .cast-btn:hover  { opacity: 0.85; }
  .cast-btn:active { transform: scale(0.97); }
  .cast-btn:focus-visible {
    outline: 2px solid var(--spell-accent, #d4a437);
    outline-offset: 2px;
  }

  /* ── footer note ── */
  .foot {
    border-top: 1px solid var(--pc-rule, #e2e0d8);
    padding-top: 16px;
  }

  .foot__note,
  .foot__omnibox {
    font-size: 13px;
    line-height: 1.55;
    color: var(--pc-ink-muted, #999);
    margin: 0 0 8px;
  }

  .foot__omnibox code,
  .foot__note code {
    font-family: var(--pc-font-mono);
    font-size: 11.5px;
    background: var(--pc-rule-soft, #f0eee6);
    padding: 1px 5px;
    border-radius: 2px;
    color: var(--pc-ink, #1a1814);
  }

  .foot__omnibox strong { color: var(--pc-ink, #1a1814); }

  /* ── responsive ── */
  @media (min-width: 600px) {
    .page { padding-left: 24px; padding-right: 24px; }
    .catalog { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }

  @media (min-width: 900px) {
    .catalog { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  }

  /* reduced-motion: keep layout, remove cast-btn transitions */
  @media (prefers-reduced-motion: reduce) {
    .cast-btn { transition: none; }
    .card { transition: none; }
  }
</style>
