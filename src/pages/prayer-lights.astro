---
import BlockLayout from '../layouts/BlockLayout.astro';
const colors = ['honey', 'rose', 'sage', 'sky', 'lilac', 'ivory'];
const description = 'A quiet place for your prayers. Light a candle, keep an intention, and let your personal wall of lights keep growing.';
---

<BlockLayout title="Prayer Lights · PointCast" description={description} immersive hideAds showNetworkStrip={false} includeManifest={false} themeColor="#f5f1e9">
  <main class="prayer-lights" data-prayer-lights data-color="honey">
    <header class="pl-topbar">
      <a class="pl-wordmark" href="/" aria-label="PointCast home"><span aria-hidden="true">✳</span> POINTCAST</a>
      <a href="#your-lights">Your lights <span aria-hidden="true">↗</span></a>
    </header>

    <section class="pl-welcome" aria-labelledby="lights-title">
      <div class="pl-intro">
        <p class="pl-eyebrow"><span></span> A LITTLE SPACE FOR PEACE</p>
        <h1 id="lights-title">One prayer.<br />One more <em>light.</em></h1>
        <p class="pl-dek">For someone you love. For something you hope for.<br class="pl-desktop-break" /> Or simply for this moment.</p>
        <div class="pl-intro-bottom"><span class="pl-tiny-sun" aria-hidden="true">✷</span><p>Keep lighting. Keep growing.<br /><span>Every light has a place here.</span></p></div>
      </div>

      <section class="pl-dashboard" aria-label="Your personal prayer dashboard">
        <div class="pl-dashboard-heading"><p>YOUR PRAYER PRACTICE</p><span class="pl-live-dot" aria-hidden="true"></span></div>
        <div class="pl-total-row"><strong data-total>0</strong><span>lights in your<br />collection</span><span class="pl-dashboard-spark" aria-hidden="true">✳</span></div>
        <div class="pl-small-stats"><div><strong data-today>0</strong><span>lit today</span></div><div><strong data-session>0</strong><span>this visit</span></div></div>
        <div class="pl-week-heading"><span>THE LAST SEVEN DAYS</span><span data-week-count>0 this week</span></div>
        <div class="pl-week" data-week role="group" aria-label="Lights per day"></div>
        <p class="pl-device-note">Personal counts · saved in this browser</p>
      </section>
    </section>

    <section class="pl-lighting" aria-labelledby="light-heading">
      <div class="pl-preview" aria-hidden="true"><div class="pl-preview-orbit"></div><div class="pl-light-art"><span class="pl-halo"></span><span class="pl-flame"></span><span class="pl-wick"></span><span class="pl-vessel"></span><span class="pl-base"></span></div><span class="pl-preview-caption">A MOMENT, MADE VISIBLE</span></div>
      <form>
        <div class="pl-form-heading"><span class="pl-step">01 /</span><h2 id="light-heading">Light a prayer</h2></div>
        <fieldset><legend>Choose your glow</legend><div class="pl-swatches">{colors.map((color, index) => <label data-color={color}><input type="radio" name="color" value={color} checked={index === 0} /><span class="pl-swatch" aria-hidden="true"></span><span class="pl-color-name">{color}</span></label>)}</div></fieldset>
        <label class="pl-intention-label" for="prayer-intention">Hold an intention <span>optional · just for you</span></label>
        <textarea id="prayer-intention" name="intention" maxlength="280" rows="2" placeholder="Who or what is in your heart?" aria-describedby="intention-note"></textarea>
        <p class="pl-intention-note" id="intention-note">Your words stay in this browser and in any backup you download.</p>
        <button class="pl-light-button" data-light type="submit" disabled><span aria-hidden="true">✦</span> Light a prayer <span aria-hidden="true">↗</span></button>
      </form>
    </section>
    <p class="pl-status" data-status role="status" aria-live="polite">Opening your collection…</p>
    <noscript><p class="pl-no-script">Turn on JavaScript to light and save prayers in this browser.</p></noscript>

    <section class="pl-collection" id="your-lights" aria-labelledby="collection-heading">
      <div class="pl-collection-heading"><div><p class="pl-eyebrow">A GROWING WALL OF GOOD INTENTIONS</p><h2 id="collection-heading">Your lights, <em>together.</em></h2></div><span class="pl-collection-count" data-visible>0 of 0 lights</span></div>
      <div class="pl-empty" data-empty><span aria-hidden="true">✧</span><h3>A little light begins here.</h3><p>Your first prayer will appear in this space.<br />Add another whenever you feel called.</p></div>
      <ol class="pl-light-wall" data-wall aria-label="Your saved prayer lights, newest first"></ol>
      <div class="pl-load-row"><button class="pl-older-button" data-older type="button" hidden>Unfold older lights <span aria-hidden="true">↓</span></button></div>
      <div class="pl-continue-note"><span aria-hidden="true">✦</span><p>There is always room for another.</p><a href="#light-heading">Light one more <span aria-hidden="true">↑</span></a></div>
    </section>

    <footer class="pl-page-footer">
      <div><p class="pl-footer-title">Keep your light close.</p><p>This is your personal collection. Lights stay until you clear this browser’s site data.<br />There is no set number of lights; available device storage is the limit. Save a backup to carry them with you.</p></div>
      <div class="pl-backup-actions"><button data-export type="button" disabled>Download backup <span aria-hidden="true">↓</span></button><label class="pl-restore">Restore a backup <span aria-hidden="true">↗</span><input type="file" accept="application/json,.json" data-import aria-label="Restore a Prayer Lights JSON backup" disabled /></label></div>
      <nav aria-label="More quiet spaces"><a href="/prayer-altars">Morning prayers ↗</a><a href="/prayer-candles">Shared candle wall ↗</a><a href="/">Back to PointCast ↗</a></nav>
      <p class="pl-signoff">PEACE BE WITH YOU. <span>POINTCAST · PRAYER LIGHTS</span></p>
    </footer>
  </main>
</BlockLayout>

<script>
  import { mountPrayerLights } from '../lib/prayer-lights-controller.mjs';
  function init() {
    const root = document.querySelector('[data-prayer-lights]');
    if (root && !root.hasAttribute('data-mounted')) {
      root.setAttribute('data-mounted', '');
      mountPrayerLights(root);
    }
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  body:has(.prayer-lights) { background: #f5f1e9; color: #322d29; }
  .prayer-lights { --ink: #322d29; --muted: #79746b; --line: #dcd6ca; --glow: #e8ae4b; --glow-rgb: 232,174,75; max-width: 1200px; margin: auto; padding: 0 44px; font-family: 'Inter Variable', sans-serif; }
  .prayer-lights * { box-sizing: border-box; }
  .prayer-lights [hidden] { display: none !important; }
  .prayer-lights a { color: inherit; text-decoration: none; }
  .prayer-lights button, .prayer-lights input, .prayer-lights textarea { font: inherit; }
  .prayer-lights button, .prayer-lights label { -webkit-tap-highlight-color: transparent; }
  .prayer-lights button { cursor: pointer; }
  .prayer-lights button:disabled, .pl-restore:has(input:disabled) { cursor: wait; opacity: .55; }
  .prayer-lights :focus-visible { outline: 3px solid #9d632c; outline-offset: 5px; }
  .prayer-lights h1, .prayer-lights h2, .prayer-lights p { margin: 0; }
  .prayer-lights h1, .prayer-lights h2, .pl-footer-title { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
  .prayer-lights em { font-weight: inherit; }
  .pl-topbar { display: flex; justify-content: space-between; align-items: center; height: 90px; border-bottom: 1px solid var(--line); font-size: 12px; }
  .pl-wordmark { font-weight: 750; letter-spacing: .17em; display: flex; gap: 10px; align-items: center; }
  .pl-wordmark > span { font-size: 31px; line-height: 1; color: #a75f39; }
  .pl-topbar > a:last-child { display: flex; align-items: center; gap: 20px; }
  .pl-welcome { display: grid; grid-template-columns: 1.3fr 1fr; gap: 85px; padding: 64px 0 56px; align-items: center; }
  .pl-eyebrow { font-size: 9px; letter-spacing: .16em; font-weight: 650; }
  .pl-intro .pl-eyebrow { display: flex; align-items: center; gap: 8px; color: #79705f; }
  .pl-intro .pl-eyebrow > span { width: 5px; height: 5px; border-radius: 50%; background: #a68550; }
  .pl-intro h1 { font-size: clamp(48px, 5.8vw, 76px); line-height: 1.04; letter-spacing: -.055em; margin: 24px 0 22px; }
  .pl-intro h1 em { color: #a6653f; }
  .pl-dek { color: #726c61; font-size: 13px; line-height: 1.85; }
  .pl-intro-bottom { display: flex; align-items: center; gap: 14px; margin-top: 32px; font-size: 10px; line-height: 1.8; }
  .pl-intro-bottom p > span { color: var(--muted); }
  .pl-tiny-sun { font-size: 37px; color: #a77d48; }
  .pl-dashboard { background: #39352f; border-radius: 5px; padding: 26px 28px 20px; color: #f6efdf; box-shadow: 0 15px 30px -23px #34241570; }
  .pl-dashboard-heading { display: flex; justify-content: space-between; align-items: center; font-size: 9px; letter-spacing: .14em; color: #c9c1b1; }
  .pl-live-dot { width: 6px; height: 6px; background: #c7d7a5; border-radius: 50%; box-shadow: 0 0 0 4px #c7d7a50b; }
  .pl-total-row { display: flex; gap: 16px; align-items: center; margin: 24px 0 22px; }
  .pl-total-row > strong { font-family: Georgia, serif; font-size: clamp(40px, 5vw, 68px); font-weight: 400; line-height: 1; letter-spacing: -.05em; overflow-wrap: anywhere; min-width: 0; }
  .pl-total-row > span { font-size: 11px; color: #c4baaa; line-height: 1.65; flex-shrink: 0; }
  .pl-total-row .pl-dashboard-spark { font-size: 42px; color: #ddbc80; margin-left: auto; }
  .pl-small-stats { border-top: 1px solid #ffffff1c; border-bottom: 1px solid #ffffff1c; display: grid; grid-template-columns: 1fr 1fr; padding: 17px 0; }
  .pl-small-stats > div { display: flex; gap: 9px; align-items: baseline; }
  .pl-small-stats > div + div { padding-left: 24px; border-left: 1px solid #ffffff1c; }
  .pl-small-stats strong { font-size: 22px; font-weight: 400; overflow-wrap: anywhere; }
  .pl-small-stats span { font-size: 10px; color: #c4baaa; }
  .pl-week-heading { display: flex; justify-content: space-between; margin-top: 23px; font-size: 8px; letter-spacing: .1em; color: #c4baaa; }
  .pl-week-heading > span + span { letter-spacing: 0; }
  .pl-week { height: 77px; display: grid; grid-template-columns: repeat(7, 1fr); gap: 12px; margin-top: 13px; }
  .pl-week > div { height: 100%; display: flex; flex-direction: column; justify-content: end; align-items: center; gap: 8px; font-size: 8px; color: #b4aa98; }
  .pl-week-bar { width: 100%; max-width: 24px; height: calc(var(--height) * .72); min-height: 3px; background: #d5b37b; border-radius: 2px 2px 0 0; }
  .pl-week-bar[data-empty=true] { background: #736957; }
  .pl-device-note { text-align: center; margin-top: 17px !important; font-size: 8px; letter-spacing: .03em; color: #c4baaa; }
  .pl-lighting { background: #ede7dc; border: 1px solid #e5ddce; display: grid; grid-template-columns: .85fr 1.15fr; border-radius: 5px; min-height: 390px; }
  .pl-preview { position: relative; display: flex; align-items: center; justify-content: center; border-right: 1px solid #ded5c5; overflow: hidden; }
  .pl-preview-orbit { position: absolute; width: 245px; height: 245px; border: 1px solid #c7b58d42; border-radius: 50%; }
  .pl-preview-orbit::after { content: '✦'; position: absolute; top: 35px; right: 18px; color: #b19c72; font-size: 16px; background: #ede7dc; padding: 2px; }
  .pl-preview-caption { position: absolute; bottom: 28px; font-size: 8px; color: #8b7c63; letter-spacing: .2em; }
  .pl-lighting form { padding: 30px 36px; min-width: 0; }
  .pl-form-heading { display: flex; gap: 10px; align-items: center; margin-bottom: 24px; }
  .pl-step { font-size: 9px; color: #9a8970; }
  .pl-form-heading h2 { font-size: 28px; letter-spacing: -.04em; }
  .pl-lighting fieldset { border: 0; margin: 0 0 22px; padding: 0; }
  .pl-lighting legend, .pl-intention-label { font-size: 10px; font-weight: 600; }
  .pl-swatches { display: flex; gap: 18px; margin-top: 13px; }
  .pl-swatches label { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; min-height: 46px; }
  .pl-swatches input { position: absolute; opacity: 0; width: 32px; height: 32px; margin: 0; }
  .pl-swatch { background: var(--glow); width: 27px; height: 27px; border-radius: 50%; border: 1px solid #0000000e; box-shadow: inset 0 0 9px #ffffff50; }
  .pl-swatches input:checked + .pl-swatch { outline: 1px solid #72624a; outline-offset: 4px; }
  .pl-swatches input:focus-visible + .pl-swatch { outline: 3px solid #9d632c; outline-offset: 4px; }
  .pl-color-name { font-size: 8px; text-transform: capitalize; color: #746956; }
  .pl-intention-label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .pl-intention-label > span { color: #837762; font-weight: 400; font-size: 9px; }
  .pl-lighting textarea { display: block; width: 100%; border: 1px solid #d6ccbb; background: #f8f4ed; border-radius: 3px; padding: 12px; color: var(--ink); resize: vertical; min-height: 72px; max-height: 280px; font-size: 12px; line-height: 1.6; }
  .pl-lighting textarea::placeholder { color: #908674; }
  .pl-intention-note { font-size: 8px; color: #7c705d; line-height: 1.5; margin-top: 8px !important; }
  .pl-light-button { display: flex; width: 100%; align-items: center; justify-content: center; gap: 9px; background: #9d603b; color: #fff8ec; border: 1px solid #9d603b; border-radius: 3px; min-height: 47px; margin-top: 20px; font-size: 11px !important; transition: background .2s; }
  .pl-light-button > span:last-child { margin-left: auto; }
  .pl-light-button > span:first-child { margin-right: auto; }
  .pl-light-button:hover:not(:disabled) { background: #824c2c; }
  .pl-status { font-size: 10px; color: #77684f; text-align: center; min-height: 45px; padding: 14px 0 0; line-height: 1.7; }
  .pl-no-script { padding: 20px; background: #fff1d4; }
  .pl-collection { scroll-margin-top: 30px; padding-top: 42px; }
  .pl-collection-heading { display: flex; justify-content: space-between; align-items: end; gap: 18px; margin-bottom: 30px; }
  .pl-collection-heading .pl-eyebrow { color: #8b7f68; font-size: 8px; }
  .pl-collection-heading h2 { font-size: 38px; letter-spacing: -.05em; margin-top: 12px; }
  .pl-collection-heading h2 em { color: #a6653f; }
  .pl-collection-count { font-size: 9px; color: #847861; white-space: nowrap; padding-bottom: 5px; }
  .pl-light-wall { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 13px; padding: 0; list-style: none; margin: 0; align-items: start; }
  .pl-light-card { min-width: 0; text-align: center; background: #eee8dc; border: 1px solid #e2d9c8; border-radius: 4px; min-height: 222px; padding: 0 14px 15px; content-visibility: auto; contain-intrinsic-size: auto 235px; }
  .pl-light-number { font-size: 8px; color: #8b7658; margin-bottom: 10px !important; letter-spacing: .035em; }
  .pl-light-intention { font-family: Georgia, serif; font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; white-space: pre-wrap; }
  .pl-light-card time { display: block; font-size: 8px; color: #867b68; margin-top: 14px; }
  .pl-light-art { position: relative; width: 130px; height: 145px; margin: 0 auto; }
  .pl-light-art .pl-halo { position: absolute; top: 16px; left: 12px; width: 106px; height: 106px; border-radius: 50%; background: radial-gradient(circle, rgba(var(--glow-rgb), .4), rgba(var(--glow-rgb), .08) 50%, transparent 73%); }
  .pl-light-art .pl-flame { position: absolute; width: 12px; height: 26px; left: 59px; top: 37px; background: radial-gradient(ellipse at 50% 80%, #fffef3 15%, #ffdf88 45%, #e7a849 80%); border-radius: 75% 30% 65% 45%; box-shadow: 0 0 15px #efc66b70; transform-origin: 50% 100%; animation: pl-light-breathe 3.8s ease-in-out infinite; animation-delay: var(--delay, -1s); }
  .pl-light-art .pl-wick { position: absolute; left: 64px; top: 60px; width: 2px; height: 8px; background: #796147; }
  .pl-light-art .pl-vessel { position: absolute; left: 42px; top: 67px; width: 46px; height: 54px; border-radius: 3px 3px 8px 8px; background: linear-gradient(90deg, #ffffff38, transparent 45%, #00000010), linear-gradient(180deg, #ffffff40, transparent 50%), rgba(var(--glow-rgb), .55); border: 1px solid rgba(var(--glow-rgb), .8); box-shadow: inset 3px 0 7px #fff8; }
  .pl-light-art .pl-vessel::before { content: ''; position: absolute; left: 1px; top: -3px; right: 1px; height: 6px; border: 1px solid #ffffff60; border-radius: 50%; background: #f7eccf90; }
  .pl-light-art .pl-base { position: absolute; width: 64px; height: 5px; left: 33px; top: 122px; border-radius: 50%; background: #a1916e36; filter: blur(2px); }
  .pl-light-card[data-shape="1"] .pl-vessel { border-radius: 5px 5px 20px 20px; width: 56px; left: 37px; height: 44px; top: 76px; }
  .pl-light-card[data-shape="1"] .pl-wick { top: 69px; }
  .pl-light-card[data-shape="1"] .pl-flame { top: 46px; }
  .pl-light-card[data-shape="2"] .pl-vessel { width: 35px; left: 48px; height: 65px; top: 56px; border-radius: 3px 3px 5px 5px; }
  .pl-light-card[data-shape="2"] .pl-wick { top: 49px; }
  .pl-light-card[data-shape="2"] .pl-flame { top: 26px; }
  .pl-preview .pl-light-art { transform: scale(1.65); margin-top: -8px; }
  [data-color="honey"] { --glow: #e8ae4b; --glow-rgb: 232,174,75; }
  [data-color="rose"] { --glow: #d99c99; --glow-rgb: 217,156,153; }
  [data-color="sage"] { --glow: #a9b49b; --glow-rgb: 169,180,155; }
  [data-color="sky"] { --glow: #a3bac8; --glow-rgb: 163,186,200; }
  [data-color="lilac"] { --glow: #b9a4c7; --glow-rgb: 185,164,199; }
  [data-color="ivory"] { --glow: #e4d9b8; --glow-rgb: 228,217,184; }
  .pl-empty { padding: 44px 20px; border: 1px dashed #d8ceba; text-align: center; border-radius: 5px; }
  .pl-empty > span { color: #b68a45; font-size: 34px; }
  .pl-empty h3 { font-family: Georgia, serif; font-size: 22px; font-weight: 400; margin: 14px 0 10px; }
  .pl-empty p { font-size: 11px; line-height: 1.8; color: #85765d; }
  .pl-load-row { display: flex; justify-content: center; margin-top: 26px; }
  .pl-older-button { background: transparent; border: 1px solid #cfc3ae; color: #77634a; border-radius: 3px; padding: 14px 22px; font-size: 11px !important; min-height: 44px; }
  .pl-older-button > span { margin-left: 25px; }
  .pl-continue-note { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 38px 0 48px; font-size: 10px; color: #8e7c60; flex-wrap: wrap; }
  .pl-continue-note > span { color: #b28e4e; font-size: 18px; }
  .pl-continue-note a { margin-left: 12px; text-decoration: underline; text-underline-offset: 4px; padding: 12px 0; }
  .pl-page-footer { border-top: 1px solid var(--line); padding: 30px 0 22px; display: grid; grid-template-columns: 1fr auto; gap: 24px; }
  .pl-footer-title { font-size: 22px; margin-bottom: 9px !important; }
  .pl-page-footer > div > p + p { font-size: 9px; line-height: 1.9; color: #887a64; max-width: 580px; }
  .pl-backup-actions { display: flex; gap: 12px; align-items: start; }
  .pl-backup-actions button, .pl-restore { border: 1px solid #cfc5b3; border-radius: 3px; font-size: 9px !important; color: #79694f; background: transparent; padding: 13px; min-height: 44px; white-space: nowrap; }
  .pl-restore { position: relative; overflow: hidden; cursor: pointer; }
  .pl-restore input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .pl-restore:focus-within { outline: 3px solid #9d632c; outline-offset: 5px; }
  .pl-page-footer nav { grid-column: 1 / -1; display: flex; gap: 25px; font-size: 9px; color: #79694f; flex-wrap: wrap; }
  .pl-page-footer nav a { padding: 12px 0; }
  .pl-signoff { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 20px; display: flex; justify-content: space-between; gap: 15px; font-size: 7px; letter-spacing: .12em; color: #8f826d; }
  @keyframes pl-light-breathe { 0%, 100% { transform: rotate(-3deg) scaleY(1); opacity: .9; } 50% { transform: rotate(4deg) scaleY(1.08); opacity: 1; } }
  @media (min-width: 1000px) { .pl-light-wall { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media (max-width: 800px) {
    .prayer-lights { padding: 0 26px; }
    .pl-welcome { gap: 30px; padding: 44px 0; grid-template-columns: 1.1fr 1fr; }
    .pl-dashboard { padding: 22px; }
    .pl-total-row .pl-dashboard-spark { display: none; }
    .pl-total-row { gap: 10px; }
    .pl-total-row > span { font-size: 10px; }
    .pl-lighting { grid-template-columns: .7fr 1fr; }
    .pl-lighting form { padding: 27px; }
    .pl-swatches { gap: 14px; }
    .pl-light-wall { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pl-page-footer { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .prayer-lights { padding: 0 20px; }
    .pl-topbar { height: 70px; font-size: 10px; }
    .pl-wordmark { font-size: 11px; }
    .pl-wordmark > span { font-size: 27px; }
    .pl-welcome { grid-template-columns: 1fr; padding: 37px 0 28px; gap: 30px; }
    .pl-intro h1 { font-size: 61px; margin: 22px 0 20px; }
    .pl-intro-bottom { margin-top: 22px; }
    .pl-dek { font-size: 12px; }
    .pl-dashboard { padding: 24px; }
    .pl-total-row > strong { font-size: 58px; }
    .pl-total-row .pl-dashboard-spark { display: block; }
    .pl-small-stats { padding: 14px 0; }
    .pl-week { height: 65px; }
    .pl-lighting { grid-template-columns: 1fr; }
    .pl-preview { height: 200px; border-right: 0; border-bottom: 1px solid #ded5c5; }
    .pl-preview .pl-light-art { transform: scale(1.1); margin-top: -10px; }
    .pl-preview-orbit { width: 165px; height: 165px; }
    .pl-preview-orbit::after { top: 15px; right: 11px; }
    .pl-preview-caption { bottom: 14px; font-size: 7px; }
    .pl-lighting form { padding: 24px; }
    .pl-form-heading { margin-bottom: 22px; }
    .pl-swatches { justify-content: space-between; gap: 8px; }
    .pl-swatches label { min-width: 30px; }
