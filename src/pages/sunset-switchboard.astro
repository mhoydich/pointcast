---
const canonicalUrl = 'https://pointcast.xyz/sunset-switchboard';
const title = 'Sunset Switchboard — Route One Good Signal';
const description =
  'A public signal instrument for the hour when El Segundo changes color. Tune the sky, band, and reach, then route a small broadcast.';
const shareImage = 'https://pointcast.xyz/images/sunset-switchboard/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a16" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" href="/sunset-switchboard.json" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      '@id': canonicalUrl,
      name: title,
      description,
      url: canonicalUrl,
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: 'Web',
      isAccessibleForFree: true,
      isPartOf: { '@type': 'WebSite', name: 'PointCast', url: 'https://pointcast.xyz' },
    })}></script>
  </head>
  <body>
    <main class="switchboard" data-switchboard>
      <div class="noise" aria-hidden="true"></div>
      <header class="masthead">
        <a class="wordmark" href="/">POINTCAST</a>
        <a class="project-mark" href="#top">SUNSET SWITCHBOARD</a>
        <div class="status" aria-live="polite">
          <span class="status-light"></span>
          <span data-notice>CHANNEL READY</span>
        </div>
      </header>

      <section class="hero" id="top">
        <div class="intro">
          <p class="eyebrow">PUBLIC SIGNAL INSTRUMENT № 01 · EL SEGUNDO</p>
          <h1>Route one<br />good signal<br /><em>before dark.</em></h1>
          <p class="lede">
            Tune the weather, choose a band, set the distance. The tower turns
            your settings into a small broadcast for the city.
          </p>
        </div>

        <div class="signal-stage" aria-label="Animated signal tower">
          <div class="sun-disc"></div>
          <div class="signal-rings" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="tower" aria-hidden="true">
            <span class="beacon"></span>
            <span class="crossbar crossbar-one"></span>
            <span class="crossbar crossbar-two"></span>
            <span class="leg leg-left"></span>
            <span class="leg leg-right"></span>
            <span class="leg leg-mid"></span>
          </div>
          <div class="ground-grid" aria-hidden="true"></div>
          <div class="station-tag">
            <span>ACTIVE NODE</span>
            <strong data-station-code>ES-DRM-347</strong>
          </div>
        </div>
      </section>

      <section class="console" aria-label="Signal controls">
        <div class="control">
          <div class="control-heading">
            <label for="weather">01 / SKY</label>
            <output for="weather" data-weather-output>GOLDEN HOUR</output>
          </div>
          <input id="weather" data-weather type="range" min="0" max="3" value="1" />
          <div class="ticks" aria-hidden="true"><span>0</span><span>1</span><span>2</span><span>3</span></div>
        </div>
        <div class="control">
          <div class="control-heading">
            <label for="band">02 / BAND</label>
            <output for="band" data-band-output>DREAM</output>
          </div>
          <input id="band" data-band type="range" min="0" max="3" value="1" />
          <div class="ticks" aria-hidden="true"><span>0</span><span>1</span><span>2</span><span>3</span></div>
        </div>
        <div class="control">
          <div class="control-heading">
            <label for="reach">03 / REACH</label>
            <output for="reach" data-reach-output>COAST</output>
          </div>
          <input id="reach" data-reach type="range" min="0" max="3" value="2" />
          <div class="ticks" aria-hidden="true"><span>0</span><span>1</span><span>2</span><span>3</span></div>
        </div>
        <button class="transmit" type="button" data-transmit>
          <span>TRANSMIT</span><small>SPACE ↗</small>
        </button>
      </section>

      <section class="broadcast" aria-live="polite">
        <div class="broadcast-meta"><span>OUTGOING MESSAGE</span><span data-message-code>ES-DRM-347</span></div>
        <p data-message>THE COAST IS LISTENING. PASS IT WEST UNTIL THE OCEAN ANSWERS.</p>
        <div class="broadcast-actions">
          <button type="button" data-share>SHARE SIGNAL ↗</button>
          <button type="button" data-download>SAVE CARD ↓</button>
          <a href="/sunset-switchboard.json">READ JSON +</a>
        </div>
      </section>

      <section class="logbook">
        <div class="section-title">
          <p>RECENT TRANSMISSIONS</p>
          <span>STORED ONLY ON THIS DEVICE</span>
        </div>
        <ol data-log></ol>
        <p class="empty-log" data-empty-log>Nothing archived yet. Route your first signal.</p>
      </section>

      <footer>
        <p>MADE FOR THE HOUR WHEN THE CITY CHANGES COLOR.</p>
        <p>NO ACCOUNT. NO FEED. JUST A FREQUENCY.</p>
        <a href="/">BACK TO POINTCAST ↗</a>
      </footer>
    </main>

    <script define:vars={{ canonicalUrl }}>
      const bands = ['NEIGHBORHOOD', 'DREAM', 'CIVIC', 'EMERGENCY'];
      const bandShort = ['NBR', 'DRM', 'CVC', 'EMR'];
      const reaches = ['RIGHT HERE', 'BOULEVARD', 'COAST', 'ORBIT'];
      const skies = ['MARINE LAYER', 'GOLDEN HOUR', 'AFTERGLOW', 'NIGHT SHIFT'];
      const palettes = [
        ['#b9c7cc', '#40566d', '#101923'],
        ['#ffd43b', '#ff6b35', '#271954'],
        ['#ff8d5b', '#ef476f', '#3b185f'],
        ['#68e0cf', '#146c8f', '#080a16'],
      ];
      const openings = [
        'THE COAST IS LISTENING',
        'SOMEONE LEFT THE PORCH LIGHT ON',
        'A NEW ROUTE JUST APPEARED',
        'THE OLD ANTENNA STILL WORKS',
        'WE FOUND A QUIET FREQUENCY',
        'THE LAST PLANE CLEARED THE HORIZON',
      ];
      const endings = [
        'MEET US WHERE THE ASPHALT TURNS PINK.',
        'BRING ONE SMALL IDEA AND NO PERMISSION SLIP.',
        'PASS IT WEST UNTIL THE OCEAN ANSWERS.',
        'KEEP THIS CHANNEL OPEN FOR STRANGERS.',
        'THE NEXT GOOD THING STARTS TWO BLOCKS AWAY.',
        'DO NOT MISTAKE STATIC FOR SILENCE.',
      ];
      const root = document.querySelector('[data-switchboard]');
      const weather = document.querySelector('[data-weather]');
      const band = document.querySelector('[data-band]');
      const reach = document.querySelector('[data-reach]');
      const logRoot = document.querySelector('[data-log]');
      const storageKey = 'pc:sunset-switchboard:transmissions';
      let current = {
        id: 'initial',
        message: 'THE COAST IS LISTENING. PASS IT WEST UNTIL THE OCEAN ANSWERS.',
        band: 1,
        reach: 2,
        weather: 1,
        code: 'ES-DRM-347',
      };
      let log = [];

      function integer(input) {
        return Math.max(0, Math.min(3, Number.parseInt(input?.value || '0', 10) || 0));
      }

      function notify(message) {
        const target = document.querySelector('[data-notice]');
        if (target) target.textContent = message;
        window.setTimeout(() => { if (target) target.textContent = 'CHANNEL READY'; }, 1600);
      }

      function tune() {
        const w = integer(weather);
        const b = integer(band);
        const r = integer(reach);
        const palette = palettes[w];
        root?.style.setProperty('--sky', palette[0]);
        root?.style.setProperty('--haze', palette[1]);
        root?.style.setProperty('--deep', palette[2]);
        root?.style.setProperty('--reach', String(r));
        document.querySelector('[data-weather-output]').textContent = skies[w];
        document.querySelector('[data-band-output]').textContent = bands[b];
        document.querySelector('[data-reach-output]').textContent = reaches[r];
      }

      function makeTransmission(seed) {
        const b = integer(band);
        const r = integer(reach);
        const w = integer(weather);
        const code = `ES-${bandShort[b]}-${String((seed % 899) + 100).padStart(3, '0')}`;
        return {
          id: `${seed}-${b}-${r}-${w}`,
          message: `${openings[(b * 2 + w + seed) % openings.length]}. ${endings[(r * 3 + b + Math.floor(seed / 7)) % endings.length]}`,
          band: b,
          reach: r,
          weather: w,
          code,
        };
      }

      function persist() {
        try { localStorage.setItem(storageKey, JSON.stringify(log)); } catch {}
      }

      function renderTransmission(item) {
        current = item;
        document.querySelector('[data-message]').textContent = item.message;
        document.querySelector('[data-message-code]').textContent = item.code;
        document.querySelector('[data-station-code]').textContent = item.code;
      }

      function renderLog() {
        if (!logRoot) return;
        logRoot.replaceChildren();
        document.querySelector('[data-empty-log]')?.toggleAttribute('hidden', log.length > 0);
        log.forEach((item) => {
          const li = document.createElement('li');
          const code = document.createElement('span');
          const message = document.createElement('p');
          const recall = document.createElement('button');
          code.textContent = item.code;
          message.textContent = item.message;
          recall.type = 'button';
          recall.textContent = 'RECALL';
          recall.addEventListener('click', () => {
            weather.value = String(item.weather);
            band.value = String(item.band);
            reach.value = String(item.reach);
            tune();
            renderTransmission(item);
            notify('SIGNAL RECALLED');
          });
          li.append(code, message, recall);
          logRoot.append(li);
        });
      }

      function transmit() {
        const next = makeTransmission(Date.now());
        renderTransmission(next);
        log = [next, ...log.filter((item) => item.id !== next.id)].slice(0, 6);
        persist();
        renderLog();
        notify('SIGNAL ROUTED');
      }

      function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
        let line = '';
        let row = 0;
        text.split(' ').forEach((word) => {
          const test = `${line}${word} `;
          if (ctx.measureText(test).width > maxWidth && line) {
            ctx.fillText(line, x, y + row * lineHeight);
            line = `${word} `;
            row += 1;
          } else {
            line = test;
          }
        });
        ctx.fillText(line, x, y + row * lineHeight);
      }

      function downloadCard() {
        const w = integer(weather);
        const palette = palettes[w];
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 630;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const gradient = ctx.createLinearGradient(0, 0, 1200, 630);
        gradient.addColorStop(0, palette[2]);
        gradient.addColorStop(0.58, palette[1]);
        gradient.addColorStop(1, palette[0]);
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 1200, 630);
        ctx.strokeStyle = 'rgba(255,255,255,.24)';
        ctx.lineWidth = 2;
        for (let x = -200; x < 1400; x += 72) {
          ctx.beginPath();
          ctx.moveTo(600, 190);
          ctx.lineTo(x, 630);
          ctx.stroke();
        }
        ctx.fillStyle = '#f4efe3';
        ctx.font = '700 24px monospace';
        ctx.fillText('SUNSET SWITCHBOARD / POINTCAST', 70, 70);
        ctx.font = '700 58px Arial';
        wrapText(ctx, current.message, 70, 190, 770, 70);
        ctx.strokeStyle = '#f4efe3';
        ctx.lineWidth = 12;
        ctx.beginPath();
        ctx.moveTo(970, 470); ctx.lineTo(970, 150);
        ctx.moveTo(870, 470); ctx.lineTo(970, 150);
        ctx.moveTo(1070, 470); ctx.lineTo(970, 150);
        ctx.stroke();
        ctx.fillStyle = '#dfff00';
        ctx.beginPath();
        ctx.arc(970, 135, 28, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#f4efe3';
        ctx.font = '700 24px monospace';
        ctx.fillText(`${current.code} / ${bands[integer(band)]} / ${reaches[integer(reach)]}`, 70, 560);
        const link = document.createElement('a');
        link.download = `${current.code.toLowerCase()}-signal.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
        notify('CARD SAVED');
      }

      async function shareSignal() {
        const text = `${current.message} — ${current.code}`;
        if (typeof navigator.share === 'function') {
          try {
            await navigator.share({ title: 'Sunset Switchboard', text, url: canonicalUrl });
            notify('SIGNAL SHARED');
            return;
          } catch { return; }
        }
        await navigator.clipboard.writeText(`${text}\n${canonicalUrl}`);
        notify('SIGNAL COPIED');
      }

      [weather, band, reach].forEach((input) => input?.addEventListener('input', tune));
      document.querySelector('[data-transmit]')?.addEventListener('click', transmit);
      document.querySelector('[data-download]')?.addEventListener('click', downloadCard);
      document.querySelector('[data-share]')?.addEventListener('click', shareSignal);
      document.addEventListener('keydown', (event) => {
        if (event.code === 'Space' && !['INPUT', 'BUTTON', 'A'].includes(event.target?.tagName || '')) {
          event.preventDefault();
          transmit();
        }
      });
      try {
        const stored = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (Array.isArray(stored)) log = stored.slice(0, 6);
      } catch {}
      tune();
      renderLog();
    </script>
  </body>
</html>

<style is:global>
  :root { --paper: #f3eee1; --ink: #0a0a0b; --signal: #dfff00; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: #080a16; }
  body { margin: 0; background: #080a16; color: var(--paper); font-family: Inter, Arial, sans-serif; }
  button, input { font: inherit; }
  button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }
  .switchboard {
    --sky: #ffd43b; --haze: #ff6b35; --deep: #271954; --reach: 2;
    min-height: 100vh; overflow: hidden; position: relative;
    background: radial-gradient(circle at 80% 16%, color-mix(in srgb, var(--sky) 22%, transparent), transparent 26rem), var(--deep);
  }
  .noise { position: fixed; inset: 0; z-index: 10; opacity: .055; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; }
  .masthead { height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 0 clamp(18px, 4vw, 60px); border-bottom: 1px solid rgba(243,238,225,.3); font: 700 10px/1 ui-monospace, monospace; letter-spacing: .09em; position: relative; z-index: 4; }
  .masthead a { color: inherit; text-decoration: none; }
  .project-mark { justify-self: center; }
  .status { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .status-light { width: 9px; height: 9px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 15px var(--signal); animation: blink 2.1s ease-in-out infinite; }
  .hero { min-height: calc(100svh - 76px); display: grid; grid-template-columns: .88fr 1.12fr; border-bottom: 1px solid rgba(243,238,225,.3); }
  .intro { padding: clamp(70px, 11vh, 140px) clamp(24px, 5vw, 80px); border-right: 1px solid rgba(243,238,225,.3); position: relative; z-index: 3; }
  .eyebrow { margin: 0 0 28px; font: 700 10px/1 ui-monospace, monospace; letter-spacing: .1em; }
  h1 { margin: 0; font-size: clamp(56px, 7vw, 118px); line-height: .8; letter-spacing: -.085em; font-weight: 720; }
  h1 em { color: var(--signal); font-family: Georgia, serif; font-weight: 400; letter-spacing: -.06em; }
  .lede { max-width: 470px; margin: 48px 0 0; font-size: clamp(16px, 1.4vw, 21px); line-height: 1.4; color: rgba(243,238,225,.74); }
  .signal-stage { min-height: 620px; position: relative; overflow: hidden; perspective: 900px; background: linear-gradient(165deg, var(--sky), var(--haze) 47%, var(--deep) 86%); transition: background 600ms ease; }
  .sun-disc { width: clamp(220px, 30vw, 480px); aspect-ratio: 1; border-radius: 50%; position: absolute; left: 50%; top: 4%; transform: translateX(-50%); background: color-mix(in srgb, var(--paper) 72%, var(--sky)); box-shadow: 0 0 120px color-mix(in srgb, var(--sky) 65%, transparent); }
  .signal-rings { position: absolute; left: 50%; top: 26%; }
  .signal-rings span { position: absolute; width: 100px; height: 100px; border: 2px solid rgba(243,238,225,.62); border-radius: 50%; animation: radiate calc(3.4s - var(--reach) * .35s) linear infinite; }
  .signal-rings span:nth-child(2) { animation-delay: -1.1s; } .signal-rings span:nth-child(3) { animation-delay: -2.2s; }
  .tower { position: absolute; left: 50%; bottom: 10%; width: 250px; height: 430px; transform: translateX(-50%) rotateX(-3deg); filter: drop-shadow(18px 28px 24px rgba(8,10,22,.35)); }
  .tower span:not(.beacon) { position: absolute; display: block; background: var(--deep); border: 1px solid rgba(243,238,225,.35); }
  .leg { width: 13px; height: 370px; bottom: 0; transform-origin: bottom; }
  .leg-left { left: 31px; transform: rotate(11deg); } .leg-right { right: 31px; transform: rotate(-11deg); } .leg-mid { left: 119px; transform: scaleY(1.08); }
  .crossbar { left: 30px; width: 190px; height: 12px; } .crossbar-one { top: 130px; transform: rotate(13deg); } .crossbar-two { top: 260px; transform: rotate(-13deg); }
  .beacon { position: absolute; left: 50%; top: -6px; width: 34px; height: 34px; border-radius: 50%; transform: translateX(-50%); background: var(--signal); box-shadow: 0 0 20px var(--signal), 0 0 60px var(--signal); z-index: 2; }
  .ground-grid { position: absolute; inset: 62% -30% -20%; transform: rotateX(67deg); transform-origin: top; background-image: linear-gradient(rgba(243,238,225,.32) 1px, transparent 1px), linear-gradient(90deg, rgba(243,238,225,.32) 1px, transparent 1px); background-size: 62px 62px; mask-image: linear-gradient(to bottom, transparent, black 25%); }
  .station-tag { position: absolute; right: 24px; bottom: 24px; padding: 12px 14px; color: var(--deep); background: var(--signal); border: 1px solid var(--deep); box-shadow: 6px 6px 0 var(--deep); font-family: ui-monospace, monospace; transform: rotate(-2deg); }
  .station-tag span, .station-tag strong { display: block; } .station-tag span { margin-bottom: 5px; font-size: 9px; } .station-tag strong { font-size: 16px; }
  .console { display: grid; grid-template-columns: repeat(3, 1fr) minmax(180px, .7fr); background: #111217; border-bottom: 1px solid rgba(243,238,225,.3); }
  .control { min-width: 0; padding: 26px clamp(20px, 3vw, 40px); border-right: 1px solid rgba(243,238,225,.3); }
  .control-heading { min-height: 43px; display: flex; justify-content: space-between; gap: 16px; font: 700 10px/1.2 ui-monospace, monospace; letter-spacing: .08em; }
  .control-heading output { color: var(--signal); text-align: right; }
  input[type='range'] { appearance: none; width: 100%; height: 24px; margin: 12px 0 5px; background: transparent; cursor: grab; }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--paper); }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 21px; height: 21px; margin-top: -10px; border-radius: 50%; border: 3px solid #111217; background: var(--signal); box-shadow: 0 0 0 1px var(--signal); }
  .ticks { display: flex; justify-content: space-between; color: rgba(243,238,225,.42); font: 9px/1 ui-monospace, monospace; }
  .transmit { min-height: 140px; border: 0; padding: 27px; color: var(--ink); background: var(--signal); display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; cursor: pointer; }
  .transmit:hover { background: #efff77; } .transmit span { font-size: clamp(21px, 2.2vw, 36px); font-weight: 800; letter-spacing: -.06em; } .transmit small { font: 700 10px/1 ui-monospace, monospace; }
  .broadcast { padding: clamp(56px, 8vw, 120px) clamp(24px, 8vw, 130px); color: var(--ink); background: var(--paper); }
  .broadcast-meta, .section-title { display: flex; justify-content: space-between; gap: 18px; font: 700 10px/1 ui-monospace, monospace; letter-spacing: .1em; }
  .broadcast > p { max-width: 1280px; margin: 54px 0 62px; font-size: clamp(42px, 7.4vw, 126px); line-height: .9; letter-spacing: -.075em; font-weight: 700; }
  .broadcast-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .broadcast-actions button, .broadcast-actions a, .logbook li button { min-height: 48px; display: inline-flex; align-items: center; border: 1px solid var(--ink); background: transparent; color: var(--ink); padding: 0 18px; cursor: pointer; text-decoration: none; font: 700 10px/1 ui-monospace, monospace; letter-spacing: .08em; }
  .broadcast-actions button:hover, .broadcast-actions a:hover { color: var(--paper); background: var(--ink); }
  .logbook { padding: clamp(52px, 7vw, 100px) clamp(24px, 6vw, 96px); background: #111217; }
  .section-title { padding-bottom: 26px; border-bottom: 1px solid rgba(243,238,225,.3); } .section-title p { margin: 0; } .section-title span { color: rgba(243,238,225,.45); }
  .logbook ol { list-style: none; margin: 0; padding: 0; }
  .logbook li { display: grid; grid-template-columns: minmax(130px,.45fr) 2fr auto; align-items: center; gap: 32px; padding: 24px 0; border-bottom: 1px solid rgba(243,238,225,.3); }
  .logbook li > span { color: var(--signal); font: 700 11px/1 ui-monospace, monospace; }
  .logbook li p { margin: 0; font-size: clamp(17px,1.8vw,26px); line-height: 1.15; }
  .logbook li button { color: var(--paper); border-color: rgba(243,238,225,.3); } .empty-log { color: rgba(243,238,225,.55); }
  footer { min-height: 180px; padding: 42px clamp(24px,6vw,96px); color: var(--ink); background: var(--signal); display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; font: 700 11px/1.3 ui-monospace, monospace; }
  footer p { margin: 0; max-width: 310px; } footer a { color: inherit; }
  @keyframes blink { 50% { opacity: .35; } }
  @keyframes radiate { from { transform: translate(-50%,-50%) scale(.2); opacity: .9; } to { transform: translate(-50%,-50%) scale(calc(5 + var(--reach))); opacity: 0; } }
  @media (max-width: 920px) {
    .hero { grid-template-columns: 1fr; } .intro { border-right: 0; border-bottom: 1px solid rgba(243,238,225,.3); } .signal-stage { min-height: 74svh; }
    .console { grid-template-columns: 1fr 1fr; } .control:nth-child(2) { border-right: 0; } .control:nth-child(3), .transmit { border-top: 1px solid rgba(243,238,225,.3); }
  }
