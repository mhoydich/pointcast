---
/**
 * /drum-fill — Fill the Bar. An eight-step, one-bar groove loops on its own:
 * kick on 1 & 5, snare on 3 & 7, closed hats on the even steps, a playhead
 * sweeping the strip. Each round ONE step goes silent — a hollow, glowing
 * gap. Tap SPACE (or the pad) the moment the playhead crosses it and a tom
 * fills the hole. Land it clean and the next round mutes one more step (up to
 * four at once) and nudges the tempo up six BPM. A missed or early fill is a
 * strike; three strikes ends it. Score is bars cleared, best in localStorage.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Drum Fill · complete the groove · PointCast';
const description = 'An eight-step groove loops with one hit missing. Tap the moment the playhead crosses the empty cell to fill it with a tom. Every clean bar mutes one more step and pushes the tempo up.';
---
<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dfl" id="dfl">
    <header class="dfl__hud">
      <div class="dfl__conductor">
        <img class="dfl__noun" id="dfl-noun" src="https://noun.pics/385.svg" alt="The conducting Noun" width="56" height="56" />
        <div class="dfl__meta">
          <span class="dfl__score" id="dfl-score">0</span>
          <span class="dfl__score-label">bars locked</span>
        </div>
      </div>
      <div class="dfl__hud-right">
        <div class="dfl__strikes" id="dfl-strikes" aria-label="strikes remaining">
          <span class="dfl__pip"></span><span class="dfl__pip"></span><span class="dfl__pip"></span>
        </div>
        <span class="dfl__bpm" id="dfl-bpm">84 BPM</span>
      </div>
    </header>

    <section class="dfl__stage" id="dfl-stage">
      <canvas class="dfl__canvas" id="dfl-canvas"></canvas>
      <div class="dfl__overlay" id="dfl-overlay">
        <h1 class="dfl__title">FILL THE BAR</h1>
        <p class="dfl__sub">an 8-step groove loops with one hit missing.<br />tap the instant the playhead crosses the empty cell.</p>
        <p class="dfl__best" id="dfl-best-line">best — bars</p>
        <button class="dfl__go" id="dfl-go" type="button">▶ START THE LOOP</button>
      </div>
    </section>

    <div class="dfl__speech" id="dfl-speech">space or tap fills the gap</div>

    <div class="dfl__controls">
      <button class="dfl__tap" id="dfl-tap" type="button">◉ TAP <span>space</span></button>
    </div>

    <nav class="dfl__siblings">
      <a href="/drum-hero">/drum-hero</a>
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-lockstep">/drum-lockstep</a>
      <a href="/drum">/drum</a>
    </nav>
  </main>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dfl) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dfl {
      max-width: 620px;
      margin: 0 auto;
      padding: 18px 14px 44px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-height: 94vh;
    }

    /* HUD */
    .dfl__hud {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }
    .dfl__conductor { display: flex; align-items: center; gap: 12px; }
    .dfl__noun {
      width: 56px; height: 56px;
      image-rendering: pixelated;
      border-radius: 10px;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }
    .dfl__noun--bob { animation: dflBob 0.34s ease-in-out; }
    @keyframes dflBob {
      0%, 100% { transform: translateY(0) scale(1); }
      45% { transform: translateY(-7px) scale(1.05); }
    }
    .dfl__meta { display: flex; flex-direction: column; line-height: 1; }
    .dfl__score {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 38px;
      color: #f6c15e;
      font-variant-numeric: tabular-nums;
    }
    .dfl__score-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin-top: 3px;
    }
    .dfl__hud-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .dfl__strikes { display: flex; gap: 7px; }
    .dfl__pip {
      width: 13px; height: 13px;
      border-radius: 50%;
      background: #8aeac0;
      box-shadow: 0 0 8px rgba(138,234,192,0.55);
      transition: background 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }
    .dfl__pip--out {
      background: transparent;
      border: 1.5px solid rgba(255,107,138,0.55);
      box-shadow: none;
      transform: scale(0.85);
    }
    .dfl__bpm {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.14em;
      color: #7ac8ed;
      font-variant-numeric: tabular-nums;
    }

    /* STAGE */
    .dfl__stage {
      position: relative;
      flex: 1;
      min-height: 300px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 78%, #1c0e2e 100%);
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      cursor: pointer;
    }
    .dfl__stage--shake { animation: dflShake 0.22s ease; }
    @keyframes dflShake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }
    .dfl__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    .dfl__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: rgba(7,5,15,0.84);
      backdrop-filter: blur(3px);
      z-index: 3;
      text-align: center;
      padding: 22px;
    }
    .dfl__overlay--hidden { display: none; }
    .dfl__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(28px, 8vw, 48px);
      letter-spacing: 0.18em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dfl__sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      line-height: 1.7;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
      max-width: 340px;
    }
    .dfl__best {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #d4a437;
      margin: 0;
    }
    .dfl__go {
      margin-top: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dfl__go:hover { transform: translateY(-1px); background: #ffd98a; }

    /* SPEECH */
    .dfl__speech {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.06em;
      color: #f4e7c8;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(244,231,200,0.14);
      border-radius: 4px 14px 14px 14px;
      padding: 10px 14px;
      align-self: center;
      text-align: center;
      min-height: 20px;
    }

    /* CONTROLS */
    .dfl__controls { display: flex; justify-content: center; }
    .dfl__tap {
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.16em;
      color: #07050f;
      background: #8aeac0;
      border: 0;
      border-radius: 16px;
      padding: 18px 54px;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition: transform 80ms ease, filter 140ms ease;
      box-shadow: 0 6px 20px rgba(138,234,192,0.22);
    }
    .dfl__tap span {
      display: inline-block;
      margin-left: 8px;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(7,5,15,0.55);
    }
    .dfl__tap:hover { filter: brightness(1.08); }
    .dfl__tap:active { transform: scale(0.95); }

    .dfl__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dfl__siblings a { color: #d4a437; text-decoration: none; }
    .dfl__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .dfl__stage { min-height: 240px; }
      .dfl__score { font-size: 32px; }
      .dfl__tap { padding: 16px 40px; font-size: 16px; }
    }
  </style>

  <script>
    type Voice = 'kick' | 'snare' | 'hat';
    type Cell = 'base' | 'gap' | 'filled' | 'missed';
    type Phase = 'idle' | 'playing' | 'over';

    // Base groove: kick on 1 & 5, snare on 3 & 7, hats on the even steps.
    const BASE: Voice[] = ['kick', 'hat', 'snare', 'hat', 'kick', 'hat', 'snare', 'hat'];
    const VCOLOR: Record<Voice, string> = { kick: '#ff6b8a', snare: '#7ac8ed', hat: '#7a7a8f' };
    // Tom pitches, one per step, so fills read as a little melody.
    const TOM_FREQS = [146.83, 164.81, 196.0, 220.0, 246.94, 293.66, 329.63, 392.0];
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];

    const START_BPM = 84;
    const BPM_STEP = 6;
    const MAX_GAPS = 4;
    const MAX_STRIKES = 3;

    const WIN_LINES = ['locked. +1.', 'clean fill.', 'the hole is gone.', 'groove holds.', 'you heard it.'];
    const FAIL_LINES = ['a hit slipped through.', 'the gap won that bar.', 'mind the empty cell.', 'listen for the hole.'];

    let SESSION_ID = '';
    let phase: Phase = 'idle';
    let score = 0;
    let strikes = 0;
    let bpm = START_BPM;
    let stepMs = 0, barMs = 0, WINDOW = 0;
    let barStart = 0;
    let firedStep = -1;
    let leadIn = true;
    let best = 0;
    let rafId = 0;

    let cells: Cell[] = Array.from({ length: 8 }, () => 'base' as Cell);
    let gapList: number[] = [];
    const flashAt: number[] = Array.from({ length: 8 }, () => -1);
    const flashColor: string[] = Array.from({ length: 8 }, () => '#f6c15e');

    const pick = (a: string[]): string => a[Math.floor(Math.random() * a.length)];

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(120, t);
      o.frequency.exponentialRampToValueAtTime(44, t + 0.15);
      g.gain.setValueAtTime(0.42, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.25);
    }
    function pSnare(t: number) {
      const a = ctx();
      const dur = 0.2;
      const buf = a.createBuffer(1, Math.max(1, a.sampleRate * dur), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1800;
      const ng = a.createGain();
      ng.gain.setValueAtTime(0.22, t);
      ng.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      n.connect(hp).connect(ng).connect(a.destination); n.start(t);
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'triangle'; o.frequency.setValueAtTime(190, t);
      g.gain.setValueAtTime(0.16, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.16);
    }
    function pHat(t: number, open = false) {
      const a = ctx();
      const dur = open ? 0.14 : 0.045;
      const buf = a.createBuffer(1, Math.max(1, a.sampleRate * dur), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7500;
      const g = a.createGain(); g.gain.value = open ? 0.09 : 0.06;
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    function pTom(step: number) {
      const a = ctx(); const t = a.currentTime + 0.002;
      const f = TOM_FREQS[step];
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      o.frequency.exponentialRampToValueAtTime(f * 0.68, t + 0.18);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.34, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.32);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.36);
      const buf = a.createBuffer(1, Math.max(1, a.sampleRate * 0.02), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const ng = a.createGain(); ng.gain.value = 0.1;
      n.connect(ng).connect(a.destination); n.start(t);
    }
    function pBuzz() {
      const a = ctx(); const t = a.currentTime + 0.004;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(140, t);
      o.frequency.exponentialRampToValueAtTime(60, t + 0.28);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.2, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.34);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.36);
    }
    function pThud() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine'; o.frequency.setValueAtTime(88, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.09, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.16);
    }

    // ---- dom ----
    const canvas = document.getElementById('dfl-canvas') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    const stage = document.getElementById('dfl-stage')!;
    const overlay = document.getElementById('dfl-overlay')!;
    const goBtn = document.getElementById('dfl-go') as HTMLButtonElement;
    const tapBtn = document.getElementById('dfl-tap') as HTMLButtonElement;
    const scoreEl = document.getElementById('dfl-score')!;
    const bpmEl = document.getElementById('dfl-bpm')!;
    const bestLine = document.getElementById('dfl-best-line')!;
    const speech = document.getElementById('dfl-speech')!;
    const nounImg = document.getElementById('dfl-noun') as HTMLImageElement;
    const strikeEls = Array.from(document.querySelectorAll('.dfl__pip')) as HTMLElement[];
    const titleEl = overlay.querySelector('.dfl__title') as HTMLElement;
    const subEl = overlay.querySelector('.dfl__sub') as HTMLElement;

    const say = (line: string) => { speech.textContent = line; };
    const showOverlay = () => overlay.classList.remove('dfl__overlay--hidden');
    const hideOverlay = () => overlay.classList.add('dfl__overlay--hidden');
    function bob() {
      nounImg.classList.remove('dfl__noun--bob');
      void nounImg.offsetWidth;
      nounImg.classList.add('dfl__noun--bob');
    }
    function flashCell(s: number, color: string) { flashAt[s] = performance.now(); flashColor[s] = color; }
    function flashAllCells(color: string) {
      const t = performance.now();
      for (let s = 0; s < 8; s++) { flashAt[s] = t; flashColor[s] = color; }
    }

    function recomputeTiming() {
      stepMs = (60000 / bpm) / 2;      // eighth-note step
      barMs = stepMs * 8;
      WINDOW = Math.max(70, stepMs * 0.42);
    }
    function updateHud() {
      scoreEl.textContent = String(score);
      bpmEl.textContent = `${bpm} BPM`;
      for (let i = 0; i < strikeEls.length; i++) strikeEls[i].classList.toggle('dfl__pip--out', i < strikes);
    }

    // ---- canvas ----
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    function rrect(x: number, y: number, w: number, h: number, r: number) {
      cx.beginPath();
      cx.moveTo(x + r, y);
      cx.arcTo(x + w, y, x + w, y + h, r);
      cx.arcTo(x + w, y + h, x, y + h, r);
      cx.arcTo(x, y + h, x, y, r);
      cx.arcTo(x, y, x + w, y, r);
      cx.closePath();
    }

    function drawGlyph(s: number, gx: number, gy: number, w: number, now: number) {
      const st = cells[s];
      const R = Math.min(w * 0.22, 16);
      if (st === 'gap') {
        const pulse = 0.5 + 0.5 * Math.sin(now / 180);
        cx.strokeStyle = `rgba(246,193,94,${0.6 + 0.3 * pulse})`;
        cx.lineWidth = 2; cx.setLineDash([4, 4]);
        cx.beginPath(); cx.arc(gx, gy, R, 0, Math.PI * 2); cx.stroke();
        cx.setLineDash([]);
        return;
      }
      if (st === 'filled') {
        cx.fillStyle = '#f6c15e';
        cx.beginPath();
        cx.moveTo(gx, gy - R); cx.lineTo(gx + R, gy); cx.lineTo(gx, gy + R); cx.lineTo(gx - R, gy);
        cx.closePath(); cx.fill();
        return;
      }
      if (st === 'missed') {
        cx.strokeStyle = '#ff6b8a'; cx.lineWidth = 2.5;
        cx.beginPath();
        cx.moveTo(gx - R * 0.7, gy - R * 0.7); cx.lineTo(gx + R * 0.7, gy + R * 0.7);
        cx.moveTo(gx + R * 0.7, gy - R * 0.7); cx.lineTo(gx - R * 0.7, gy + R * 0.7);
        cx.stroke();
        return;
      }
      const v = BASE[s];
      cx.globalAlpha = 0.5;
      if (v === 'kick') {
        cx.fillStyle = VCOLOR.kick;
        cx.beginPath(); cx.arc(gx, gy, R * 0.8, 0, Math.PI * 2); cx.fill();
      } else if (v === 'snare') {
        cx.strokeStyle = VCOLOR.snare; cx.lineWidth = 3;
        cx.beginPath(); cx.moveTo(gx - R * 0.85, gy); cx.lineTo(gx + R * 0.85, gy); cx.stroke();
      } else {
        cx.strokeStyle = VCOLOR.hat; cx.lineWidth = 2.5;
        cx.beginPath();
        cx.moveTo(gx - R * 0.6, gy - R * 0.6); cx.lineTo(gx + R * 0.6, gy + R * 0.6);
        cx.moveTo(gx + R * 0.6, gy - R * 0.6); cx.lineTo(gx - R * 0.6, gy + R * 0.6);
        cx.stroke();
      }
      cx.globalAlpha = 1;
    }

    function drawCell(x: number, y: number, w: number, h: number, s: number, cs: number, now: number) {
      const st = cells[s];
      const r = 10;
      rrect(x, y, w, h, r);
      if (st === 'gap') {
        const pulse = 0.5 + 0.5 * Math.sin(now / 180);
        cx.fillStyle = `rgba(246,193,94,${0.05 + 0.05 * pulse})`; cx.fill();
        cx.lineWidth = 2; cx.setLineDash([6, 5]);
        cx.strokeStyle = `rgba(246,193,94,${0.55 + 0.35 * pulse})`; cx.stroke();
        cx.setLineDash([]);
      } else if (st === 'filled') {
        cx.fillStyle = 'rgba(246,193,94,0.22)'; cx.fill();
        cx.lineWidth = 2; cx.strokeStyle = 'rgba(246,193,94,0.9)'; cx.stroke();
      } else if (st === 'missed') {
        cx.fillStyle = 'rgba(255,107,138,0.14)'; cx.fill();
        cx.lineWidth = 2; cx.strokeStyle = 'rgba(255,107,138,0.75)'; cx.stroke();
      } else {
        cx.fillStyle = 'rgba(244,231,200,0.045)'; cx.fill();
        cx.lineWidth = 1; cx.strokeStyle = 'rgba(244,231,200,0.10)'; cx.stroke();
      }

      if (s === cs && phase === 'playing') {
        rrect(x, y, w, h, r);
        cx.fillStyle = 'rgba(244,231,200,0.07)'; cx.fill();
      }

      const fa = flashAt[s];
      if (fa >= 0) {
        const age = (now - fa) / 320;
        if (age < 1) {
          rrect(x, y, w, h, r);
          cx.globalAlpha = (1 - age) * 0.5;
          cx.fillStyle = flashColor[s]; cx.fill();
          cx.globalAlpha = 1;
        }
      }

      drawGlyph(s, x + w / 2, y + h / 2 - 5, w, now);

      cx.fillStyle = 'rgba(244,231,200,0.3)';
      cx.font = '10px "JetBrains Mono", monospace';
      cx.textAlign = 'center';
      cx.fillText(String(s + 1), x + w / 2, y + h - 8);
    }

    function drawStrip(elapsed: number, cs: number, now: number, showHead: boolean) {
      if (W === 0) return;
      cx.clearRect(0, 0, W, H);
      const padX = Math.max(14, W * 0.04);
      const stripX = padX;
      const stripW = W - padX * 2;
      const cellGap = 6;
      const cellW = (stripW - cellGap * 7) / 8;
      const cellH = Math.min(cellW * 1.2, H * 0.52);
      const stripTop = (H - cellH) / 2;

      for (let s = 0; s < 8; s++) {
        const x = stripX + s * (cellW + cellGap);
        drawCell(x, stripTop, cellW, cellH, s, cs, now);
      }

      if (showHead) {
        const phx = stripX + Math.min(1, elapsed / barMs) * stripW;
        cx.save();
        cx.strokeStyle = 'rgba(246,193,94,0.9)';
        cx.lineWidth = 2;
        cx.shadowColor = 'rgba(246,193,94,0.85)';
        cx.shadowBlur = 12;
        cx.beginPath();
        cx.moveTo(phx, stripTop - 10); cx.lineTo(phx, stripTop + cellH + 10);
        cx.stroke();
        cx.shadowBlur = 0;
        cx.fillStyle = '#f6c15e';
        cx.beginPath();
        cx.moveTo(phx - 6, stripTop - 15); cx.lineTo(phx + 6, stripTop - 15); cx.lineTo(phx, stripTop - 6);
        cx.closePath(); cx.fill();
        cx.restore();
      }
    }
    const drawIdle = () => drawStrip(0, -1, performance.now(), false);

    // ---- round flow ----
    function pickGaps(n: number): number[] {
      const pool = [0, 1, 2, 3, 4, 5, 6, 7];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      return pool.slice(0, n).sort((a, b) => a - b);
    }
    function startRound() {
      cells = Array.from({ length: 8 }, () => 'base' as Cell);
      const n = Math.min(score + 1, MAX_GAPS);
      gapList = pickGaps(n);
      for (const s of gapList) cells[s] = 'gap';
      say(n === 1 ? 'one hit is missing — fill it' : `${n} gaps this bar — fill them all`);
    }

    function fireStep(s: number) {
      if (s === 0 || s === 4) bob();
      if (cells[s] !== 'base') return;      // gaps stay silent; already-filled/missed don't re-trigger
      const a = ctx(); const t = a.currentTime + 0.002;
      const v = BASE[s];
      if (v === 'kick') pKick(t);
      else if (v === 'snare') pSnare(t);
      else pHat(t, false);
      flashCell(s, VCOLOR[v]);
    }

    function strike() {
      strikes = Math.min(strikes + 1, MAX_STRIKES);
      updateHud();
      pBuzz();
      stage.classList.remove('dfl__stage--shake');
      void stage.offsetWidth;
      stage.classList.add('dfl__stage--shake');
      if (strikes >= MAX_STRIKES) endGame();
    }

    function hit() {
      if (phase !== 'playing') return;
      const now = performance.now();
      const elapsed = (((now - barStart) % barMs) + barMs) % barMs;
      let target = -1;
      let bestAbs = Infinity;
      for (const s of gapList) {
        if (cells[s] !== 'gap') continue;
        const center = (s + 0.5) * stepMs;
        let d = Math.abs(elapsed - center);
        d = Math.min(d, barMs - d);         // wrap distance across the loop seam
        if (d < bestAbs) { bestAbs = d; target = s; }
      }
      if (target === -1) { pThud(); return; }
      if (bestAbs <= WINDOW) {
        cells[target] = 'filled';
        pTom(target);
        flashCell(target, '#8aeac0');
        broadcast(target);
      } else if (bestAbs <= WINDOW * 2.2) {
        cells[target] = 'missed';
        flashCell(target, '#ff6b8a');
        strike();
      } else {
        pThud();
      }
    }

    function onBarEnd() {
      if (leadIn) { leadIn = false; startRound(); return; }
      const filled = gapList.filter((s) => cells[s] === 'filled').length;
      const cleared = gapList.length > 0 && filled === gapList.length;
      if (cleared) {
        score++;
        bpm = START_BPM + score * BPM_STEP;
        recomputeTiming();
        updateHud();
        flashAllCells('#8aeac0');
        say(pick(WIN_LINES));
      } else {
        say(pick(FAIL_LINES));
      }
      if (phase !== 'playing') return;
      startRound();
    }

    function frame() {
      if (phase !== 'playing') return;
      const now = performance.now();
      let elapsed = now - barStart;
      while (elapsed >= barMs) {
        const endedBar = barMs;
        onBarEnd();
        if (phase !== 'playing') return;
        const over = elapsed - endedBar;
        barStart = now - over;
        firedStep = -1;
        elapsed = over;
      }

      const cs = Math.min(7, Math.floor(elapsed / stepMs));
      const center = (cs + 0.5) * stepMs;
      if (elapsed >= center && firedStep !== cs) {
        firedStep = cs;
        fireStep(cs);
      }

      for (const s of gapList) {
        if (cells[s] !== 'gap') continue;
        if (elapsed > (s + 0.5) * stepMs + WINDOW) {
          cells[s] = 'missed';
          flashCell(s, '#ff6b8a');
          strike();
          if (phase !== 'playing') return;
        }
      }

      drawStrip(elapsed, cs, now, true);
      rafId = requestAnimationFrame(frame);
    }

    function startGame() {
      ctx();
      resize();
      score = 0; strikes = 0; bpm = START_BPM;
      recomputeTiming();
      leadIn = true;
      cells = Array.from({ length: 8 }, () => 'base' as Cell);
      gapList = [];
      firedStep = -1;
      for (let s = 0; s < 8; s++) flashAt[s] = -1;
      updateHud();
      hideOverlay();
      nounImg.src = `https://noun.pics/${NOUN_POOL[Math.floor(Math.random() * NOUN_POOL.length)]}.svg`;
      say('listen one bar — then fill the gaps');
      phase = 'playing';
      barStart = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    function endGame() {
      phase = 'over';
      cancelAnimationFrame(rafId);
      try {
        const prev = Number(localStorage.getItem('pc-drum-fill-best') || 0);
        if (score > prev) localStorage.setItem('pc-drum-fill-best', String(score));
        best = Math.max(score, prev);
      } catch { best = Math.max(score, best); }
      bestLine.textContent = `best ${best} bars`;
      titleEl.textContent = score > 0 ? `${score} BARS LOCKED` : 'BAR DROPPED';
      subEl.innerHTML = `${score} cleared · reached ${bpm} bpm.<br />the loop is waiting — run it back.`;
      goBtn.textContent = '▶ RUN IT BACK';
      say(score > 0 ? `three strikes. ${score} bars stand.` : 'three strikes. the groove got away.');
      showOverlay();
    }

    // ---- input ----
    goBtn.addEventListener('click', (e) => { e.preventDefault(); startGame(); });
    tapBtn.addEventListener('pointerdown', (e) => { e.preventDefault(); hit(); });
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.dfl__go')) return;
      if (phase === 'playing') { e.preventDefault(); hit(); }
    });
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      if (e.code === 'Space' || e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        if (e.repeat) return;
        if (phase === 'playing') hit();
        else startGame();
      }
    });
    window.addEventListener('resize', () => { resize(); if (phase !== 'playing') drawIdle(); });

    // ---- shared bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(seed: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return;
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // init
    SESSION_ID = getOrCreateSession();
    recomputeTiming();
    resize();
    drawIdle();
    try {
      best = Number(localStorage.getItem('pc-drum-fill-best') || 0) || 0;
      if (best > 0) bestLine.textContent = `best ${best} bars`;
    } catch {}
  </script>
</BlockLayout>
