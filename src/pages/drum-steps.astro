---
/**
 * /drum-steps — Tempo Steps. A center orb pulses on the beat over a
 * synth kick/hat groove. Tap SPACE (or the orb) on every pulse. Land
 * eight consecutive clean on-beat taps to climb a RUNG — the tempo
 * steps up 10 BPM, from 100 to a 220 cap. A missed beat or an off-beat
 * tap costs a life; three lives and you fall off. Score is the highest
 * BPM you reach; best lives in localStorage.
 *
 * Precision-endurance sibling to /drum-hero and /drum-lockstep. Clean
 * hits broadcast on the /api/sounds bus so the cast surfaces flash.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
const title = 'Tempo Steps · climb the metronome · PointCast';
const description = 'An orb pulses on the beat. Tap SPACE on every pulse. Eight clean hits climb a rung and the tempo steps up — 100 BPM to 220, three lives, no drift allowed.';
---
<BlockLayout title={title} description={description} image="/images/og-drum.png">
  <main class="dst" id="dst">
    <header class="dst__hud">
      <div class="dst__hud-left">
        <span class="dst__bpm" id="dst-bpm">100</span>
        <span class="dst__bpm-label">bpm</span>
      </div>
      <div class="dst__hud-mid">
        <span class="dst__judge" id="dst-judge"></span>
      </div>
      <div class="dst__hud-right">
        <span class="dst__rung" id="dst-rung">1</span>
        <span class="dst__rung-label">rung</span>
      </div>
    </header>

    <div class="dst__meta">
      <div class="dst__lives" id="dst-lives" aria-label="lives remaining">
        <i class="dst__life"></i><i class="dst__life"></i><i class="dst__life"></i>
      </div>
      <div class="dst__toward">
        <span class="dst__toward-label">rung in</span>
        <div class="dst__pips" id="dst-pips" aria-label="clean streak toward next rung">
          <i class="dst__pip"></i><i class="dst__pip"></i><i class="dst__pip"></i><i class="dst__pip"></i>
          <i class="dst__pip"></i><i class="dst__pip"></i><i class="dst__pip"></i><i class="dst__pip"></i>
        </div>
      </div>
    </div>

    <section class="dst__stage" id="dst-stage">
      <canvas class="dst__canvas" id="dst-canvas"></canvas>
      <div class="dst__overlay" id="dst-overlay">
        <h1 class="dst__title" id="dst-title">TEMPO STEPS</h1>
        <p class="dst__sub" id="dst-sub">climb the metronome · tap on every pulse</p>
        <p class="dst__best" id="dst-best-line">best — bpm · rung —</p>
        <button class="dst__go" id="dst-go" type="button">▶ CLIMB</button>
        <p class="dst__keys">SPACE or tap the orb · 3 lives · 8 clean = +10 bpm</p>
      </div>
    </section>

    <p class="dst__status" id="dst-status">tap CLIMB — then hit the beat, every beat.</p>

    <nav class="dst__siblings">
      <a href="/drum-hero">/drum-hero</a>
      <a href="/drum-says">/drum-says</a>
      <a href="/drum-lockstep">/drum-lockstep</a>
      <a href="/drum">/drum</a>
    </nav>
  </main>

  <style is:global>
    html, body { background: #07050f; margin: 0; }
    body:has(.dst) {
      color: #f4e7c8;
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
    .dst {
      max-width: 560px;
      margin: 0 auto;
      padding: 14px 12px 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 94vh;
    }

    /* HUD */
    .dst__hud {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'JetBrains Mono', monospace;
      padding: 2px 6px;
      min-height: 44px;
    }
    .dst__hud-left { display: flex; align-items: baseline; gap: 8px; }
    .dst__bpm {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 34px;
      color: #f6c15e;
      font-variant-numeric: tabular-nums;
      min-width: 62px;
      transition: color 160ms ease, text-shadow 160ms ease;
    }
    .dst__bpm--climb { color: #8aeac0; text-shadow: 0 0 16px rgba(138,234,192,0.6); }
    .dst__bpm-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; }
    .dst__hud-mid { flex: 1; text-align: center; }
    .dst__judge {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .dst__judge--perfect { color: #8aeac0; text-shadow: 0 0 12px rgba(138,234,192,0.7); }
    .dst__judge--good { color: #7ac8ed; }
    .dst__judge--miss { color: #ff6b8a; text-shadow: 0 0 12px rgba(255,107,138,0.5); }
    .dst__hud-right { display: flex; flex-direction: column; align-items: flex-end; }
    .dst__rung {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 800;
      font-size: 22px;
      font-variant-numeric: tabular-nums;
    }
    .dst__rung-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8a8a9a; }

    /* META — lives + streak pips */
    .dst__meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 6px;
    }
    .dst__lives { display: flex; gap: 7px; }
    .dst__life {
      width: 13px; height: 13px;
      transform: rotate(45deg);
      background: #ff6b8a;
      box-shadow: 0 0 10px rgba(255,107,138,0.5);
      border-radius: 2px;
      transition: background 200ms ease, box-shadow 200ms ease, opacity 200ms ease;
    }
    .dst__life--lost { background: transparent; box-shadow: none; opacity: 0.28; outline: 1px solid rgba(255,107,138,0.35); }
    .dst__toward { display: flex; align-items: center; gap: 9px; }
    .dst__toward-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: #8a8a9a;
    }
    .dst__pips { display: flex; gap: 4px; }
    .dst__pip {
      width: 12px; height: 5px;
      border-radius: 2px;
      background: rgba(244,231,200,0.14);
      transition: background 120ms ease, box-shadow 120ms ease;
    }
    .dst__pip--on { background: #f6c15e; box-shadow: 0 0 8px rgba(246,193,94,0.55); }

    /* STAGE */
    .dst__stage {
      position: relative;
      flex: 1;
      min-height: 400px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(244,231,200,0.10);
      background: linear-gradient(180deg, #0b0818 0%, #140a24 78%, #1c0e2e 100%);
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .dst__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    @keyframes dstShake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-6px); }
      40% { transform: translateX(5px); }
      60% { transform: translateX(-4px); }
      80% { transform: translateX(3px); }
    }
    .dst__stage--shake { animation: dstShake 0.32s ease; }
    @keyframes dstFlash {
      0% { box-shadow: inset 0 0 0 0 rgba(138,234,192,0); }
      30% { box-shadow: inset 0 0 70px 2px rgba(138,234,192,0.38); }
      100% { box-shadow: inset 0 0 0 0 rgba(138,234,192,0); }
    }
    .dst__stage--flash { animation: dstFlash 0.55s ease; }

    .dst__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(7,5,15,0.82);
      backdrop-filter: blur(3px);
      z-index: 3;
      text-align: center;
      padding: 20px;
    }
    .dst__overlay--hidden { display: none; }
    .dst__title {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(28px, 7.5vw, 48px);
      letter-spacing: 0.2em;
      margin: 0;
      color: #f6c15e;
      text-shadow: 0 0 20px rgba(246,193,94,0.5);
    }
    .dst__sub, .dst__best, .dst__keys {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #8a8a9a;
      margin: 0;
      max-width: 340px;
      line-height: 1.6;
    }
    .dst__best { color: #d4a437; }
    .dst__go {
      margin-top: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.2em;
      color: #07050f;
      background: #f6c15e;
      border: 0;
      border-radius: 14px;
      padding: 14px 30px;
      cursor: pointer;
      transition: transform 100ms ease, background 160ms ease;
    }
    .dst__go:hover { transform: translateY(-1px); background: #ffd98a; }

    .dst__status {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: #8aeac0;
      text-align: center;
      min-height: 16px;
      margin: 0;
      padding: 0 6px;
    }

    .dst__siblings {
      display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
    }
    .dst__siblings a { color: #d4a437; text-decoration: none; }
    .dst__siblings a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      .dst__stage { min-height: 340px; }
    }
  </style>

  <script>
    // ---- tuning ----
    const START_BPM = 100;
    const BPM_CAP = 220;
    const BPM_STEP = 10;
    const RUNG_STEP = 8;          // clean on-beat taps to climb a rung
    const MAX_LIVES = 3;
    const HIT_WINDOW = 115;       // ms either side of the beat counts as clean
    const PERFECT_WINDOW = 42;    // ms for a PERFECT flourish
    const COUNT_IN = 2;           // count-in pulses before judging begins
    const LEAD_S = 0.6;           // lead-in before the first count-in pulse
    const SCHEDULE_AHEAD = 0.12;  // seconds of audio scheduled ahead
    const LOOKAHEAD_MS = 25;      // scheduler tick
    const NOUN_POOL = [385, 92, 523, 742, 1042, 287, 612, 928, 1189, 64];

    type Kind = 'kick' | 'hat';
    type Beat = { idx: number; at: number; kind: Kind; judged: boolean; hit: boolean; count: boolean };
    type Burst = { born: number; color: string };
    type Judge = 'perfect' | 'good' | 'miss';

    let beats: Beat[] = [];
    let bursts: Burst[] = [];
    let running = false;
    let bpm = START_BPM;
    let rung = 1;
    let lives = MAX_LIVES;
    let cleanStreak = 0;
    let score = START_BPM;        // highest BPM reached
    let currentNoun = 0;
    let SESSION_ID = '';

    // clocks: map audio time <-> performance.now via a fixed anchor per run
    let anchorAudio = 0;
    let anchorPerf = 0;
    let nextBeatAudio = 0;
    let beatCounter = 0;
    let graceUntil = 0;           // taps before this are free (count-in)
    let lastTapAt = 0;
    let schedTimer = 0;
    let rafId = 0;
    let judgeTimer = 0;

    // ---- audio ----
    let actx: AudioContext | null = null;
    function ctx(): AudioContext {
      if (!actx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        actx = new AC();
      }
      if (actx!.state === 'suspended') actx!.resume();
      return actx!;
    }
    function pKick(t: number) {
      const a = ctx(); const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(120, t);
      o.frequency.exponentialRampToValueAtTime(44, t + 0.16);
      g.gain.setValueAtTime(0.42, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.25);
    }
    function pHat(t: number) {
      const a = ctx();
      const buf = a.createBuffer(1, Math.floor(a.sampleRate * 0.05), a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
      const n = a.createBufferSource(); n.buffer = buf;
      const hp = a.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 7200;
      const g = a.createGain(); g.gain.value = 0.075;
      n.connect(hp).connect(g).connect(a.destination); n.start(t);
    }
    function pClick() {
      const a = ctx(); const t = a.currentTime + 0.002;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'square';
      o.frequency.setValueAtTime(1850, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.06, t + 0.003);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.06);
    }
    function pThud() {
      const a = ctx(); const t = a.currentTime + 0.003;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(72, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.13, t + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.2);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.22);
    }
    function pRungUp() {
      const a = ctx(); const base = a.currentTime + 0.01;
      [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
        const t = base + i * 0.075;
        const o = a.createOscillator(); const g = a.createGain();
        o.type = 'triangle'; o.frequency.setValueAtTime(f, t);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime(0.22, t + 0.008);
        g.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
        o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.2);
      });
    }
    function pFall() {
      const a = ctx(); const t = a.currentTime + 0.01;
      const o = a.createOscillator(); const g = a.createGain();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(330, t);
      o.frequency.exponentialRampToValueAtTime(66, t + 0.55);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.24, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.62);
      o.connect(g).connect(a.destination); o.start(t); o.stop(t + 0.66);
    }

    // ---- beat scheduler (lookahead over the audio clock) ----
    function scheduler() {
      if (!running) return;
      const a = ctx();
      while (nextBeatAudio < a.currentTime + SCHEDULE_AHEAD) {
        const kind: Kind = beatCounter % 2 === 0 ? 'kick' : 'hat';
        if (kind === 'kick') pKick(nextBeatAudio); else pHat(nextBeatAudio);
        const at = anchorPerf + (nextBeatAudio - anchorAudio) * 1000;
        beats.push({ idx: beatCounter, at, kind, judged: false, hit: false, count: beatCounter < COUNT_IN });
        beatCounter++;
        nextBeatAudio += 60 / bpm;
      }
      schedTimer = window.setTimeout(scheduler, LOOKAHEAD_MS);
    }

    // ---- canvas ----
    const canvas = document.getElementById('dst-canvas') as HTMLCanvasElement;
    const cx = canvas.getContext('2d')!;
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.max(1, Math.floor(W * DPR));
      canvas.height = Math.max(1, Math.floor(H * DPR));
      cx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    window.addEventListener('resize', () => { resize(); if (!running) draw(performance.now()); });

    // ---- Nouns inside the orb ----
    const nounImgs: HTMLImageElement[] = NOUN_POOL.map((id) => {
      const im = new Image();
      im.src = `https://noun.pics/${id}.svg`;
      im.onload = () => { if (!running) draw(performance.now()); };
      return im;
    });

    function draw(now: number) {
      cx.clearRect(0, 0, W, H);
      const px = W / 2, py = H / 2;
      const baseR = Math.max(34, Math.min(W, H) * 0.16);
      const hitR = baseR * 1.62;
      const bMs = 60000 / bpm;

      // nearest beat (for the pulse) + next upcoming beat (for the ring)
      let nearest: Beat | null = null, nearestDist = Infinity;
      let nb: Beat | null = null;
      for (const b of beats) {
        const d = Math.abs(b.at - now);
        if (d < nearestDist) { nearestDist = d; nearest = b; }
        if (!b.judged && !b.count && b.at >= now - HIT_WINDOW) {
          if (!nb || b.at < nb.at) nb = b;
        }
      }
      const pulse = nearest ? Math.max(0, 1 - nearestDist / 140) : 0;
      const kind: Kind = nearest ? nearest.kind : 'kick';
      const tint = kind === 'kick' ? '246,193,94' : '122,200,237';

      // faint concentric guide
      cx.strokeStyle = 'rgba(244,231,200,0.05)';
      cx.lineWidth = 1;
      cx.beginPath(); cx.arc(px, py, baseR * 2.4, 0, Math.PI * 2); cx.stroke();

      // static target rim — where the ring should land
      cx.setLineDash([4, 6]);
      cx.strokeStyle = 'rgba(244,231,200,0.18)';
      cx.lineWidth = 1.5;
      cx.beginPath(); cx.arc(px, py, hitR, 0, Math.PI * 2); cx.stroke();
      cx.setLineDash([]);

      // approach ring — closes onto the target rim exactly on the beat
      if (nb) {
        const prog = Math.min(1, Math.max(0, (nb.at - now) / bMs));
        const ringR = hitR + baseR * 1.7 * prog;
        const rc = nb.kind === 'kick' ? '#f6c15e' : '#7ac8ed';
        cx.strokeStyle = rc;
        cx.globalAlpha = 0.32 + 0.55 * (1 - prog);
        cx.lineWidth = 2 + 3.5 * (1 - prog);
        cx.beginPath(); cx.arc(px, py, ringR, 0, Math.PI * 2); cx.stroke();
        cx.globalAlpha = 1;
      }

      // orb glow
      const R = baseR * (1 + pulse * 0.14);
      const grd = cx.createRadialGradient(px, py, R * 0.2, px, py, R * 1.6);
      grd.addColorStop(0, `rgba(${tint},${0.22 + pulse * 0.4})`);
      grd.addColorStop(1, 'rgba(0,0,0,0)');
      cx.fillStyle = grd;
      cx.beginPath(); cx.arc(px, py, R * 1.6, 0, Math.PI * 2); cx.fill();

      // orb body
      cx.fillStyle = '#0d0a1e';
      cx.beginPath(); cx.arc(px, py, R, 0, Math.PI * 2); cx.fill();

      // Noun, clipped to the orb
      const img = nounImgs[currentNoun];
      if (img && img.complete && img.naturalWidth > 0) {
        cx.save();
        cx.beginPath(); cx.arc(px, py, R * 0.9, 0, Math.PI * 2); cx.clip();
        cx.imageSmoothingEnabled = false;
        cx.drawImage(img, px - R * 0.9, py - R * 0.9, R * 1.8, R * 1.8);
        cx.restore();
      }

      // orb rim
      cx.strokeStyle = `rgba(${tint},${0.5 + pulse * 0.45})`;
      cx.lineWidth = 2 + pulse * 2.5;
      cx.beginPath(); cx.arc(px, py, R, 0, Math.PI * 2); cx.stroke();

      // hit bursts
      const t = performance.now();
      bursts = bursts.filter((b) => t - b.born < 440);
      for (const b of bursts) {
        const age = (t - b.born) / 440;
        cx.strokeStyle = b.color;
        cx.globalAlpha = (1 - age) * 0.9;
        cx.lineWidth = 3 * (1 - age) + 1;
        cx.beginPath(); cx.arc(px, py, hitR + age * baseR * 1.4, 0, Math.PI * 2); cx.stroke();
        cx.globalAlpha = 1;
      }
    }

    // ---- dom ----
    const stage = document.getElementById('dst-stage')!;
    const overlay = document.getElementById('dst-overlay')!;
    const goBtn = document.getElementById('dst-go') as HTMLButtonElement;
    const bestLine = document.getElementById('dst-best-line')!;
    const titleEl = document.getElementById('dst-title')!;
    const subEl = document.getElementById('dst-sub')!;
    const bpmEl = document.getElementById('dst-bpm')!;
    const rungEl = document.getElementById('dst-rung')!;
    const judgeEl = document.getElementById('dst-judge')!;
    const statusEl = document.getElementById('dst-status')!;
    const lifeEls = Array.from(document.querySelectorAll('#dst-lives .dst__life')) as HTMLElement[];
    const pipEls = Array.from(document.querySelectorAll('#dst-pips .dst__pip')) as HTMLElement[];

    function say(line: string) { statusEl.textContent = line; }
    function showJudge(kind: Judge) {
      judgeEl.textContent = kind === 'perfect' ? 'PERFECT' : kind === 'good' ? 'ON BEAT' : 'OFF';
      judgeEl.className = `dst__judge dst__judge--${kind}`;
      clearTimeout(judgeTimer);
      judgeTimer = window.setTimeout(() => { judgeEl.textContent = ''; judgeEl.className = 'dst__judge'; }, 400);
    }
    function updateHud() {
      bpmEl.textContent = String(bpm);
      rungEl.textContent = String(rung);
      lifeEls.forEach((el, i) => el.classList.toggle('dst__life--lost', i >= lives));
      pipEls.forEach((el, i) => el.classList.toggle('dst__pip--on', i < cleanStreak));
    }
    function flashStage(cls: string) {
      stage.classList.remove(cls);
      void stage.offsetWidth; // restart the animation
      stage.classList.add(cls);
    }

    // ---- judging ----
    function tap() {
      if (!running) return;
      const now = performance.now();
      if (now - lastTapAt < 55) return;      // swallow finger bounce
      lastTapAt = now;
      if (now < graceUntil) { pClick(); return; } // count-in — free taps

      let best: Beat | null = null;
      let bestAbs = Infinity;
      for (const b of beats) {
        if (b.judged || b.count) continue;
        const off = Math.abs(b.at - now);
        if (off < bestAbs) { bestAbs = off; best = b; }
      }
      pClick();
      if (best && bestAbs <= HIT_WINDOW) {
        best.judged = true; best.hit = true;
        onCleanHit(best, bestAbs);
      } else {
        onOffBeat();
      }
    }

    function onCleanHit(b: Beat, off: number) {
      const perfect = off <= PERFECT_WINDOW;
      showJudge(perfect ? 'perfect' : 'good');
      bursts.push({ born: performance.now(), color: perfect ? '#8aeac0' : '#7ac8ed' });
      broadcast(b.kind === 'kick' ? 0 : 1);
      cleanStreak++;
      if (cleanStreak >= RUNG_STEP) climbRung();
      updateHud();
    }

    function climbRung() {
      cleanStreak = 0;
      rung++;
      if (bpm < BPM_CAP) {
        bpm = Math.min(BPM_CAP, bpm + BPM_STEP);
        score = Math.max(score, bpm);
        say(`rung ${rung} — ${bpm} bpm. climb.`);
      } else {
        say(`rung ${rung} — ${bpm} bpm, capped. hold it.`);
      }
      pRungUp();
      flashStage('dst__stage--flash');
      bpmEl.classList.add('dst__bpm--climb');
      window.setTimeout(() => bpmEl.classList.remove('dst__bpm--climb'), 500);
      currentNoun = (currentNoun + 1) % NOUN_POOL.length;
      updateHud();
    }

    function onOffBeat() {
      showJudge('miss');
      bursts.push({ born: performance.now(), color: '#ff6b8a' });
      pThud();
      say('off-beat — tap ON the pulse.');
      loseLife();
    }

    function loseLife() {
      cleanStreak = 0;
      lives--;
      flashStage('dst__stage--shake');
      updateHud();
      if (lives <= 0) { endRun(); return; }
      if (lives === 1) say('last life — steady now.');
    }

    function sweepMisses(now: number) {
      for (const b of beats) {
        if (b.judged || b.count) continue;
        if (now - b.at > HIT_WINDOW) {
          b.judged = true;
          showJudge('miss');
          bursts.push({ born: performance.now(), color: '#ff6b8a' });
          say('missed the beat.');
          loseLife();
          if (!running) return;
        }
      }
    }

    // ---- run loop ----
    function frame() {
      if (!running) return;
      const now = performance.now();
      if (beats.length > 40) beats = beats.filter((b) => b.at > now - 1500);
      sweepMisses(now);
      if (!running) return;
      draw(now);
      rafId = requestAnimationFrame(frame);
    }

    function endRun() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
      clearTimeout(schedTimer);
      pFall();
      const reached = score;
      const capped = reached >= BPM_CAP;
      titleEl.textContent = capped ? 'TOPPED OUT' : 'FELL OFF';
      subEl.textContent = `${reached} bpm · rung ${rung} · ${capped ? 'you pinned the ceiling' : 'the pulse got away'}`;
      goBtn.textContent = '▶ RUN IT BACK';
      try {
        const prev = Number(localStorage.getItem('pc-drum-steps-best') || 0);
        if (reached > prev) {
          localStorage.setItem('pc-drum-steps-best', String(reached));
          localStorage.setItem('pc-drum-steps-rung', String(rung));
        }
        const b = Math.max(reached, prev);
        const br = reached > prev ? rung : Number(localStorage.getItem('pc-drum-steps-rung') || rung);
        bestLine.textContent = `best ${b} bpm · rung ${br}`;
      } catch {
        bestLine.textContent = `best ${reached} bpm · rung ${rung}`;
      }
      say(capped ? 'ceiling reached. run it back for a cleaner climb.' : 'run it back.');
      overlay.classList.remove('dst__overlay--hidden');
    }

    function startRun() {
      ctx();
      resize();
      beats = [];
      bursts = [];
      bpm = START_BPM;
      rung = 1;
      lives = MAX_LIVES;
      cleanStreak = 0;
      score = START_BPM;
      beatCounter = 0;
      lastTapAt = 0;
      currentNoun = Math.floor(Math.random() * NOUN_POOL.length);
      const a = ctx();
      anchorAudio = a.currentTime;
      anchorPerf = performance.now();
      nextBeatAudio = anchorAudio + LEAD_S;
      // first judgeable beat lands after the count-in; ignore taps until just before it
      const firstReal = anchorPerf + (LEAD_S + COUNT_IN * (60 / START_BPM)) * 1000;
      graceUntil = firstReal - HIT_WINDOW;
      updateHud();
      judgeEl.textContent = ''; judgeEl.className = 'dst__judge';
      say('listen for the count — then tap on every pulse.');
      overlay.classList.add('dst__overlay--hidden');
      running = true;
      scheduler();
      rafId = requestAnimationFrame(frame);
    }

    // ---- input ----
    stage.addEventListener('pointerdown', (e) => {
      if (!running) return;
      e.preventDefault();
      tap();
    });
    window.addEventListener('keydown', (e) => {
      if (e.repeat) return;
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      if (e.code === 'Space' || e.key === ' ') { e.preventDefault(); tap(); }
    });
    goBtn.addEventListener('click', () => { startRun(); });

    // ---- shared bus (best effort, throttled) ----
    let lastBroadcast = 0;
    function getOrCreateSession() {
      try {
        let sid = localStorage.getItem('pc-drum-live-session');
        if (!sid) {
          sid = `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
          localStorage.setItem('pc-drum-live-session', sid);
        }
        return sid;
      } catch {
        return `dl-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
      }
    }
    function broadcast(seed: number) {
      const now = Date.now();
      if (now - lastBroadcast < 900) return; // don't flood the bus at high tempo
      lastBroadcast = now;
      try {
        fetch('/api/sounds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'drum', seed, sessionId: SESSION_ID }),
        }).catch(() => {});
      } catch { /* best effort */ }
    }

    // ---- init ----
    SESSION_ID = getOrCreateSession();
    resize();
    draw(performance.now());
    try {
      const b = Number(localStorage.getItem('pc-drum-steps-best') || 0);
      const r = localStorage.getItem('pc-drum-steps-rung');
      if (b > 0) bestLine.textContent = `best ${b} bpm · rung ${r || '—'}`;
    } catch {}
  </script>
</BlockLayout>
