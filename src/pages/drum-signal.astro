---
/**
 * /drum-signal — one drum, every source.
 *
 * The universal drum channel's dashboard. Every beat on the PointCast drum —
 * from a /drum* room, a page on another site running /drum.js, a Claude
 * artifact, a script, or an agent over MCP — lands on the same global counter
 * and is tallied here by kind, app, and place.
 *
 * Data: GET /api/drum/signal (DrumCounter DO, polled while visible).
 * Send:  POST /api/drum/signal · <script src="/drum.js"> · MCP drum_tap.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'The Drum Signal';
const description =
  'One drum, every source. Beats from PointCast rooms, embeds on other sites, Claude artifacts, scripts and agents all land on one counter, tallied by where they came from.';

const kinds = [
  { id: 'pointcast', label: 'PointCast rooms', note: 'the /drum* pages, tagged by path' },
  { id: 'embed', label: 'Embeds', note: 'other sites running /drum.js' },
  { id: 'artifact', label: 'Artifacts', note: 'Claude artifacts and sandboxed frames' },
  { id: 'agent', label: 'Agents', note: 'MCP drum_tap and declared agents' },
  { id: 'standalone', label: 'Standalone', note: 'scripts, servers, curl' },
  { id: 'other', label: 'Other', note: 'anything that named its own kind' },
];

const scriptSnippet = `<script src="https://pointcast.xyz/drum.js" data-app="my-site" async></script>
<button data-pointcast-drum>drum</button>
<span data-pointcast-drum-count></span>`;
const fetchSnippet = `fetch('https://pointcast.xyz/api/drum/signal', {
  method: 'POST',
  body: JSON.stringify({ beats: 1, app: 'my-app', place: 'el-segundo' }),
});`;
const curlSnippet = `curl -X POST https://pointcast.xyz/api/drum/signal \\
  -d '{"beats":4,"app":"my-script","kind":"standalone"}'`;
---

<BlockLayout title={title} description={description} image="/images/og-drum.png" hideAds>
  <main class="ds" data-kinds={JSON.stringify(kinds.map((k) => k.id))}>
    <header class="ds__bar">
      <span>PointCast · Drum Signal</span>
      <span class="ds__live" data-ds-live>● connecting</span>
    </header>

    <section class="ds__hero">
      <div class="ds__drumcol">
        <button class="ds__drum" type="button" data-ds-drum aria-label="Beat the drum">
          <span aria-hidden="true">♪</span>
        </button>
        <p class="ds__hint">Tap · counts as <code>pointcast / drum-signal</code></p>
      </div>
      <div class="ds__totals">
        <p class="ds__label">Global count · every source</p>
        <p class="ds__big" data-ds-global>—</p>
        <div class="ds__split">
          <div>
            <p class="ds__label">Heard with a source</p>
            <p class="ds__mid" data-ds-attributed>—</p>
          </div>
          <div>
            <p class="ds__label">Before the signal</p>
            <p class="ds__mid ds__mid--muted" data-ds-unattributed>—</p>
          </div>
        </div>
        <p class="ds__note">
          Beats counted before September 26, 2026 carried no source. Everything since says where it came from.
          <span data-ds-recovered></span>
        </p>
        <p class="ds__note"><b data-ds-live-count>—</b> drumming in the last two minutes.</p>
      </div>
    </section>

    <section class="ds__panel">
      <h2 class="ds__h">By kind</h2>
      <ul class="ds__kinds">
        {kinds.map((k) => (
          <li class="ds__kind" data-kind={k.id}>
            <span class="ds__swatch" />
            <span class="ds__kname">{k.label}<small>{k.note}</small></span>
            <span class="ds__meter"><span data-ds-meter={k.id} /></span>
            <span class="ds__knum" data-ds-kind={k.id}>0</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="ds__grid">
      <section class="ds__panel">
        <h2 class="ds__h">Sources</h2>
        <table class="ds__table">
          <thead><tr><th>Kind</th><th>App</th><th class="num">Beats</th><th class="num">Last heard</th></tr></thead>
          <tbody data-ds-sources><tr><td colspan="4" class="ds__empty">Listening…</td></tr></tbody>
        </table>
      </section>

      <section class="ds__panel">
        <h2 class="ds__h">Places</h2>
        <ol class="ds__places" data-ds-places><li class="ds__empty">No places yet.</li></ol>
        <h2 class="ds__h ds__h--gap">Last 30 days</h2>
        <div class="ds__days" data-ds-days aria-label="Beats per day by kind"></div>
      </section>
    </div>

    <section class="ds__panel">
      <h2 class="ds__h">Just heard</h2>
      <ol class="ds__recent" data-ds-recent><li class="ds__empty">Nothing yet — be the first beat.</li></ol>
    </section>

    <section class="ds__panel ds__wire">
      <h2 class="ds__h">Wire the drum into anything</h2>
      <p class="ds__copy">
        Want a ready-made button? <a href="/drum-kit">Build one in the Drum Kit</a>. One channel, open to everyone. Send beats and they count on the same drum as <a href="/drum">/drum</a>.
        Tag them with an <code>app</code> name, and optionally a <code>place</code> and a <code>kind</code>
        (<code>embed</code>, <code>standalone</code>, <code>artifact</code>, <code>agent</code>, <code>other</code>).
        Only totals are stored: no cookies and no IPs. A place you don't name falls back to a country code.
      </p>
      <div class="ds__snips">
        <figure><figcaption>Drop-in (any web page)</figcaption><pre><code>{scriptSnippet}</code></pre></figure>
        <figure><figcaption>fetch (apps, artifacts)</figcaption><pre><code>{fetchSnippet}</code></pre></figure>
        <figure><figcaption>curl (scripts, servers)</figcaption><pre><code>{curlSnippet}</code></pre></figure>
        <figure>
          <figcaption>Agents</figcaption>
          <pre><code>Add the PointCast MCP connector, then call drum_tap.
Taps arrive as kind "agent", app "mcp".</code></pre>
        </figure>
      </div>
    </section>
  </main>

  <style is:global>
    body:has(.ds) { background: #fbf6ef; }
    .ds {
      --ds-ink: #12110e;
      --ds-muted: #6b6a66;
      --ds-rule: #12110e;
      --ds-soft: #e6e0d6;
      --ds-red: #e0452b;
      --k-pointcast: #e0452b;
      --k-embed: #185fa5;
      --k-artifact: #7b4fd6;
      --k-agent: #1f8a5b;
      --k-standalone: #12110e;
      --k-other: #9a9890;
      max-width: 1080px;
      margin: 24px auto 64px;
      padding: 0 16px;
      color: var(--ds-ink);
      font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
    }
    .ds code, .ds pre { font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; }
    .ds__bar {
      display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
      background: var(--ds-ink); color: #fbf6ef; padding: 14px 20px;
      font: 600 12px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .18em; text-transform: uppercase;
    }
    .ds__live { color: #9a9890; }
    .ds__live.is-on { color: #ff8a73; }
    .ds__hero {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      border: 4px solid var(--ds-rule); border-top: 0; background: #fffdf9;
    }
    .ds__drumcol { display: grid; place-items: center; padding: 32px 16px; border-right: 4px solid var(--ds-rule); }
    .ds__drum {
      width: min(240px, 60vw); aspect-ratio: 1; border-radius: 50%;
      border: 5px solid var(--ds-ink); background: radial-gradient(circle at 40% 35%, #f06a4f, var(--ds-red) 60%, #b8321c);
      box-shadow: 0 8px 0 var(--ds-ink); color: #fff; font-size: 64px; cursor: pointer;
      touch-action: manipulation; transition: transform .06s, box-shadow .06s;
    }
    .ds__drum:active, .ds__drum.is-hit { transform: translateY(5px); box-shadow: 0 3px 0 var(--ds-ink); }
    .ds__hint { margin: 16px 0 0; font-size: 12px; color: var(--ds-muted); }
    .ds__totals { padding: 28px 28px 24px; }
    .ds__label {
      margin: 0 0 6px; font: 600 11px/1.2 'JetBrains Mono', ui-monospace, monospace;
      letter-spacing: .16em; text-transform: uppercase; color: var(--ds-muted);
    }
    .ds__big { margin: 0 0 20px; font-size: clamp(48px, 9vw, 88px); font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
    .ds__split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; border-top: 2px solid var(--ds-rule); padding-top: 16px; }
    .ds__mid { margin: 0; font-size: 28px; font-variant-numeric: tabular-nums; }
    .ds__mid--muted { color: var(--ds-muted); }
    .ds__note { margin: 16px 0 0; font-size: 13px; color: var(--ds-muted); line-height: 1.5; }
    .ds__panel { border: 4px solid var(--ds-rule); border-top: 0; background: #fffdf9; padding: 20px 24px 24px; }
    .ds__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
    .ds__grid > .ds__panel + .ds__panel { border-left: 0; }
    .ds__h {
      margin: 0 0 14px; font: 600 12px/1.2 'JetBrains Mono', ui-monospace, monospace;
      letter-spacing: .18em; text-transform: uppercase;
    }
    .ds__h--gap { margin-top: 24px; }
    .ds__kinds { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ds__kind { display: grid; grid-template-columns: 14px minmax(140px, 220px) 1fr 90px; gap: 12px; align-items: center; }
    .ds__swatch { width: 14px; height: 14px; background: var(--k); }
    .ds__kname { font-weight: 600; font-size: 14px; }
    .ds__kname small { display: block; font-weight: 400; font-size: 12px; color: var(--ds-muted); }
    .ds__meter { height: 14px; background: var(--ds-soft); }
    .ds__meter > span { display: block; height: 100%; width: 0; background: var(--k); transition: width .4s; }
    .ds__knum { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
    .ds [data-kind="pointcast"] { --k: var(--k-pointcast); }
    .ds [data-kind="embed"] { --k: var(--k-embed); }
    .ds [data-kind="artifact"] { --k: var(--k-artifact); }
    .ds [data-kind="agent"] { --k: var(--k-agent); }
    .ds [data-kind="standalone"] { --k: var(--k-standalone); }
    .ds [data-kind="other"] { --k: var(--k-other); }
    .ds__table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .ds__table th {
      text-align: left; font: 600 11px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .12em;
      text-transform: uppercase; color: var(--ds-muted); padding: 0 8px 8px 0; border-bottom: 2px solid var(--ds-rule);
    }
    .ds__table td { padding: 8px 8px 8px 0; border-bottom: 1px solid var(--ds-soft); vertical-align: top; }
    .ds__table td.app { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; word-break: break-all; }
    .ds__table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ds__chip {
      display: inline-block; padding: 2px 6px; font: 600 10px/1.4 'JetBrains Mono', ui-monospace, monospace;
      letter-spacing: .08em; text-transform: uppercase; color: #fff; background: var(--k);
    }
    .ds__empty { color: var(--ds-muted); font-size: 14px; }
    .ds__places, .ds__recent { list-style: none; margin: 0; padding: 0; }
    .ds__places li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--ds-soft); font-size: 14px; }
    .ds__places li span:first-child { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; }
    .ds__days { display: flex; align-items: flex-end; gap: 3px; height: 120px; border-bottom: 2px solid var(--ds-rule); }
    .ds__day { flex: 1; display: flex; flex-direction: column-reverse; min-width: 0; height: 100%; }
    .ds__day > i { display: block; background: var(--k); }
    .ds__recent { display: grid; gap: 4px; max-height: 280px; overflow: auto; }
    .ds__recent li {
      display: grid; grid-template-columns: 76px 96px minmax(0, 1fr) auto; gap: 10px; align-items: baseline;
      font-size: 13px; padding: 4px 0; border-bottom: 1px solid var(--ds-soft);
    }
    .ds__recent time, .ds__recent .where { color: var(--ds-muted); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; }
    .ds__recent .app { font-family: 'JetBrains Mono', ui-monospace, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ds__copy { max-width: 72ch; line-height: 1.6; font-size: 15px; margin: 0 0 16px; }
    .ds__copy code { background: var(--ds-soft); padding: 1px 4px; font-size: 13px; }
    .ds__snips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .ds__snips figure { margin: 0; }
    .ds__snips figcaption {
      font: 600 11px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .12em;
      text-transform: uppercase; color: var(--ds-muted); margin-bottom: 6px;
    }
    .ds__snips pre {
      margin: 0; background: var(--ds-ink); color: #fbf6ef; padding: 14px; font-size: 12px; line-height: 1.55;
      overflow-x: auto; white-space: pre;
    }
    @media (max-width: 760px) {
      .ds__hero, .ds__grid, .ds__snips { grid-template-columns: 1fr; }
      .ds__drumcol { border-right: 0; border-bottom: 4px solid var(--ds-rule); }
      .ds__grid > .ds__panel + .ds__panel { border-left: 4px solid var(--ds-rule); }
      .ds__kind { grid-template-columns: 14px 1fr 70px; }
      .ds__meter { grid-column: 2 / 4; grid-row: 2; }
      .ds__panel, .ds__totals { padding-left: 16px; padding-right: 16px; }
      .ds__recent li { grid-template-columns: 64px minmax(0, 1fr) auto; }
      .ds__recent .where { display: none; }
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('.ds');
      if (!root) return;
      const API = '/api/drum/signal';
      const KINDS = JSON.parse(root.dataset.kinds || '[]');
      const $ = (sel) => root.querySelector(sel);
      const fmt = (n) => Number(n || 0).toLocaleString('en-US');
      let state = null;
      let pending = 0;
      let flushTimer = null;
      let audio = null;

      function ago(ms) {
        const s = Math.max(0, Math.round((Date.now() - ms) / 1000));
        if (s < 60) return s + 's ago';
        if (s < 3600) return Math.round(s / 60) + 'm ago';
        if (s < 86400) return Math.round(s / 3600) + 'h ago';
        return Math.round(s / 86400) + 'd ago';
      }

      function el(tag, attrs, text) {
        const node = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs || {})) node.setAttribute(k, v);
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function chip(kind) {
        return el('span', { class: 'ds__chip', 'data-kind': kind }, kind);
      }

      function render(data) {
        state = data;
        $('[data-ds-global]').textContent = fmt(data.globalTotal);
        $('[data-ds-attributed]').textContent = fmt(data.attributed);
        $('[data-ds-unattributed]').textContent = fmt(data.unattributed);
        $('[data-ds-recovered]').textContent = data.recovered
          ? `That includes ${fmt(data.recovered)} taps the old counter dropped when requests raced, restored on September 26 from each drummer's own total.`
          : '';

        const byKind = Object.fromEntries((data.kinds || []).map((k) => [k.kind, k.total]));
        const maxKind = Math.max(1, ...Object.values(byKind));
        for (const kind of KINDS) {
          const total = byKind[kind] || 0;
          $(`[data-ds-kind="${kind}"]`).textContent = fmt(total);
          $(`[data-ds-meter="${kind}"]`).style.width = (total / maxKind) * 100 + '%';
        }

        const tbody = $('[data-ds-sources]');
        tbody.replaceChildren();
        const sources = data.sources || [];
        if (!sources.length) {
          const tr = el('tr');
          tr.append(el('td', { colspan: '4', class: 'ds__empty' }, 'No tagged beats yet. Tap the drum.'));
          tbody.append(tr);
        }
        for (const row of sources) {
          const tr = el('tr');
          const kindCell = el('td');
          kindCell.append(chip(row.kind));
          tr.append(kindCell, el('td', { class: 'app' }, row.app), el('td', { class: 'num' }, fmt(row.total)), el('td', { class: 'num' }, ago(row.lastAt)));
          tbody.append(tr);
        }

        const places = $('[data-ds-places]');
        places.replaceChildren();
        if (!(data.places || []).length) places.append(el('li', { class: 'ds__empty' }, 'No places yet.'));
        for (const p of data.places || []) {
          const li = el('li');
          li.append(el('span', {}, p.place), el('span', {}, fmt(p.total)));
          places.append(li);
        }

        const days = $('[data-ds-days]');
        days.replaceChildren();
        const byDay = new Map();
        for (const d of data.days || []) {
          if (!byDay.has(d.day)) byDay.set(d.day, {});
          byDay.get(d.day)[d.kind] = d.total;
        }
        const keys = [];
        for (let i = 29; i >= 0; i--) keys.push(new Date(Date.now() - i * 86400000).toISOString().slice(0, 10));
        const dayMax = Math.max(1, ...keys.map((k) => Object.values(byDay.get(k) || {}).reduce((a, b) => a + b, 0)));
        for (const key of keys) {
          const col = el('div', { class: 'ds__day', title: key });
          const row = byDay.get(key) || {};
          for (const kind of KINDS) {
            if (!row[kind]) continue;
            const seg = el('i', { 'data-kind': kind, title: `${key} · ${kind} · ${fmt(row[kind])}` });
            seg.style.height = (row[kind] / dayMax) * 100 + '%';
            col.append(seg);
          }
          days.append(col);
        }

        const recent = $('[data-ds-recent]');
        recent.replaceChildren();
        if (!(data.recent || []).length) recent.append(el('li', { class: 'ds__empty' }, 'Nothing yet — be the first beat.'));
        for (const r of data.recent || []) {
          const li = el('li');
          const kindCell = el('span');
          kindCell.append(chip(r.kind));
          li.append(el('time', {}, ago(r.at)), kindCell, el('span', { class: 'app' }, r.app), el('span', { class: 'where' }, `${r.place || '—'} · ×${r.beats}`));
          recent.append(li);
        }
      }

      async function loadLive() {
        try {
          const live = await (await fetch('/api/drum/live', { cache: 'no-store' })).json();
          if (typeof live.count === 'number') {
            const anon = (live.sources || []).filter((s) => s.kind !== 'pointcast' && s.kind !== 'agent').length;
            const n = live.count + anon;
            $('[data-ds-live-count]').textContent = n === 1 ? '1 drummer' : `${n} drummers`;
          }
        } catch {}
      }

      async function load() {
        loadLive();
        const live = $('[data-ds-live]');
        try {
          const res = await fetch(API, { cache: 'no-store' });
          const data = await res.json();
          if (typeof data.globalTotal !== 'number') throw new Error('no counter');
          render(data);
          live.textContent = '● live · listening';
          live.classList.add('is-on');
        } catch {
          live.textContent = '● signal unavailable';
          live.classList.remove('is-on');
        }
      }

      function thump() {
        try {
          audio = audio || new (window.AudioContext || window.webkitAudioContext)();
          if (audio.state === 'suspended') audio.resume();
          const t = audio.currentTime;
          const osc = audio.createOscillator();
          const gain = audio.createGain();
          osc.frequency.setValueAtTime(150, t);
          osc.frequency.exponentialRampToValueAtTime(48, t + 0.18);
          gain.gain.setValueAtTime(0.9, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
          osc.connect(gain).connect(audio.destination);
          osc.start(t);
          osc.stop(t + 0.32);
        } catch {}
      }

      async function flush() {
        clearTimeout(flushTimer);
        flushTimer = null;
        if (!pending) return;
        const beats = Math.min(100, pending);
        pending -= beats;
        try {
          await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ beats, app: 'drum-signal' }) });
        } catch {}
        load();
      }

      const drum = $('[data-ds-drum]');
      drum.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        thump();
        pending += 1;
        drum.classList.add('is-hit');
        setTimeout(() => drum.classList.remove('is-hit'), 80);
        if (state) {
          state.globalTotal += 1;
          $('[data-ds-global]').textContent = fmt(state.globalTotal);
        }
        if (pending >= 20) flush();
        else if (!flushTimer) flushTimer = setTimeout(flush, 1200);
      });
      drum.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          drum.dispatchEvent(new PointerEvent('pointerdown'));
        }
      });
      addEventListener('pagehide', () => {
        if (pending && navigator.sendBeacon) {
          navigator.sendBeacon(API, new Blob([JSON.stringify({ beats: Math.min(100, pending), app: 'drum-signal' })], { type: 'text/plain' }));
          pending = 0;
        }
      });

      load();
      setInterval(() => { if (document.visibilityState === 'visible') load(); }, 5000);
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') load(); });
      setInterval(() => { if (state && document.visibilityState === 'visible') render(state); }, 30000);
    })();
  </script>
</BlockLayout>
