---
/**
 * /nouns-nation-union - 50-state Nouns Nation Battler expansion atlas.
 */
import BlockLayout from '../layouts/BlockLayout.astro';
import {
  NOUNS_STATE_LEAGUE_FORMAT,
  NOUNS_STATE_LEAGUE_PARTICIPATION,
  NOUNS_STATE_LEAGUE_REGIONS,
  NOUNS_STATE_LEAGUE_TEAMS,
} from '../lib/nouns-state-league';

const regionRows = NOUNS_STATE_LEAGUE_REGIONS.map((region) => ({
  region,
  teams: NOUNS_STATE_LEAGUE_TEAMS.filter((team) => team.region === region),
}));

const featured = [
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'CA'),
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'NY'),
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'TX'),
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'LA'),
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'AK'),
  NOUNS_STATE_LEAGUE_TEAMS.find((team) => team.code === 'WV'),
].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: NOUNS_STATE_LEAGUE_FORMAT.name,
  url: 'https://pointcast.xyz/nouns-nation-union/',
  sport: 'Nouns auto-battler',
  description:
    'A 50-state Nouns Nation Battler expansion atlas with state-rooted teams, Nouns identities, watch modes, contribution lanes, and a Union Cup format.',
  member: NOUNS_STATE_LEAGUE_TEAMS.map((team) => ({
    '@type': 'SportsTeam',
    name: team.team,
    address: { '@type': 'PostalAddress', addressRegion: team.code, addressCountry: 'US' },
  })),
};
---

<BlockLayout
  title="Nouns Nation Union League"
  description="A 50-state Nouns Nation Battler expansion: every US state gets a unique Nouns team, field, motif, ritual, contribution lane, and regional path into the Union Cup."
  image="/images/og/nouns-battler-live.png"
  jsonLd={jsonLd}
  alternates={[
    { type: 'application/json', href: '/nouns-nation-union.json', title: 'Nouns Nation Union League JSON' },
    { type: 'application/json', href: '/nouns-nation-battler.json', title: 'Nouns Nation Battler manifest' },
  ]}
  frame={{
    image: 'https://pointcast.xyz/images/og/nouns-battler-live.png',
    buttons: [
      { label: 'Union League', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union/' },
      { label: 'Battle Desk', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler/' },
      { label: 'TV Cast', action: 'link', target: 'https://pointcast.xyz/nouns-nation-battler-tv/' },
      { label: 'Union JSON', action: 'link', target: 'https://pointcast.xyz/nouns-nation-union.json' },
    ],
  }}
>
  <main class="union">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/nouns-nation/">Nouns Nation</a>
      <span aria-hidden="true">/</span>
      <span>Union League</span>
    </nav>

    <section class="hero" aria-labelledby="union-title">
      <div class="hero__copy">
        <p class="kicker">CH.BTL / UNITED STATES UNION LEAGUE</p>
        <h1 id="union-title">Fifty state teams. One Nouns Union Cup.</h1>
        <p>
          Every state in the union gets a weird, local, Noun-heavy team: colors, field, motif,
          signature move, fan ritual, and a contribution lane. This is the expansion atlas for
          people who want to watch, root, host, create, sponsor, or send agents into the league.
        </p>
        <div class="hero-actions">
          <a class="primary" href="/nouns-nation-battler/">Open Battle Desk</a>
          <a href="/nouns-nation-battler-tv/">Watch TV Cast</a>
          <a href="/nouns-nation-union/state-night/">State Night</a>
          <a href="/nouns-nation-union/artifacts/">Artifact Studio</a>
          <a href="/goal?preset=nouns-union-manus-50#setup">Set /goal</a>
          <a href="/nouns-nation-union.json">Union JSON</a>
        </div>
      </div>
      <aside class="scorecard" aria-label="Union League format">
        <span>{NOUNS_STATE_LEAGUE_FORMAT.teams} teams</span>
        <strong>{NOUNS_STATE_LEAGUE_FORMAT.name}</strong>
        <p>{NOUNS_STATE_LEAGUE_FORMAT.format}</p>
        <em>{NOUNS_STATE_LEAGUE_FORMAT.seasonBeats.join(' / ')}</em>
      </aside>
    </section>

    <section class="featured" aria-labelledby="featured-title">
      <div class="section-head">
        <p class="kicker">Featured State Kits</p>
        <h2 id="featured-title">A few teams that show the range.</h2>
      </div>
      <div class="featured-grid">
        {featured.map((team) => (
          <article style={`--team-a:${team.colors[0]};--team-b:${team.colors[1]};`}>
            <img src={`/games/nouns-nation-battler/assets/noun-${team.nounSeed % 60}.svg`} alt="" loading="lazy" />
            <div>
              <span>{team.state} / {team.short}</span>
              <strong>{team.team}</strong>
              <p>{team.motif}</p>
              <em>{team.field} · {team.signatureMove}</em>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="participate" aria-labelledby="participate-title">
      <div class="section-head">
        <p class="kicker">Participation Loop</p>
        <h2 id="participate-title">People and agents can actually do things here.</h2>
      </div>
      <div class="participation-grid">
        {NOUNS_STATE_LEAGUE_PARTICIPATION.map((item) => (
          <article>
            <span>{item.lane}</span>
            <p>{item.ask}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="goal-runway" aria-labelledby="goal-runway-title">
      <div>
        <p class="kicker">/goal Runway</p>
        <h2 id="goal-runway-title">Turn the Union idea into one daily machine.</h2>
        <p>
          Pick one operational goal, load the preset, and run it locally until the proof exists.
          The first suggested goal is Manus 50: one reviewed model-ready artifact for every state team.
        </p>
      </div>
      <div class="goal-runway__cards">
        <a href="/goal?preset=nouns-union-manus-50#setup">
          <span>01 / Manus 50</span>
          <strong>Ship every state artifact brief.</strong>
          <em>30-day publication goal</em>
        </a>
        <a href="/goal?preset=nouns-union-state-night#setup">
          <span>02 / State Night</span>
          <strong>Run one watchable Union slate.</strong>
          <em>30-day ritual goal</em>
        </a>
      </div>
    </section>

    <section class="regions" aria-labelledby="regions-title">
      <div class="section-head">
        <p class="kicker">Regional Slate Map</p>
        <h2 id="regions-title">Eight regions give the 50-state league a watchable rhythm.</h2>
        <p>
          Run regional nights first, then cross-region road trips, then the Union Cup. Each team card
          is deliberately local enough for fans to claim, remix, improve, or sponsor.
        </p>
      </div>
      <div class="region-grid">
        {regionRows.map((row) => (
          <article class="region-card">
            <div class="region-card__head">
              <span>{row.region}</span>
              <strong>{row.teams.length} teams</strong>
            </div>
            <div class="state-list">
              {row.teams.map((team) => (
                <a href={`#${team.code}`} style={`--team-a:${team.colors[0]};--team-b:${team.colors[1]};`}>
                  <b>{team.short}</b>
                  <span>{team.state}</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="teams" aria-labelledby="teams-title">
      <div class="section-head">
        <p class="kicker">All 50 Teams</p>
        <h2 id="teams-title">State-rooted Nouns gangs ready for the Union Cup.</h2>
      </div>
      <div class="team-grid">
        {NOUNS_STATE_LEAGUE_TEAMS.map((team) => (
          <article id={team.code} class="team-card" style={`--team-a:${team.colors[0]};--team-b:${team.colors[1]};`}>
            <div class="team-card__top">
              <img src={`/games/nouns-nation-battler/assets/noun-${team.nounSeed % 60}.svg`} alt="" loading="lazy" />
              <div>
                <span>{team.state} · {team.region}</span>
                <strong>{team.team}</strong>
                <em>{team.short}</em>
              </div>
            </div>
            <dl>
              <div><dt>Motif</dt><dd>{team.motif}</dd></div>
              <div><dt>Home Field</dt><dd>{team.field}</dd></div>
              <div><dt>Move</dt><dd>{team.signatureMove}</dd></div>
              <div><dt>Fan Ritual</dt><dd>{team.fanRitual}</dd></div>
              <div><dt>Contribute</dt><dd>{team.contribution}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </section>

    <section class="next" aria-labelledby="next-title">
      <div>
        <p class="kicker">Next Build</p>
        <h2 id="next-title">Make it playable as state-vs-state slates.</h2>
        <p>
          The atlas is the creative contract. Next sprint can wire these state kits into the game as
          selectable teams, schedule regional nights, and generate state-specific posters, mobile invites,
          agent tasks, and sponsor inventory.
        </p>
      </div>
      <div class="next-actions">
        <a href="/nouns-nation-battler/">Battle Desk</a>
        <a href="/nouns-nation-union/state-night/">State Night</a>
        <a href="/nouns-nation-union/artifacts/">Artifact Studio</a>
        <a href="/goal?preset=nouns-union-manus-50#setup">Set /goal</a>
        <a href="/nouns-nation-battler-agents/">Agent Bench</a>
        <a href="/nouns-nation-battler-sponsors/">Sponsor Desk</a>
        <a href="/nouns-nation-union.json">JSON</a>
      </div>
    </section>
  </main>

  <style>
    .union {
      display: grid;
      gap: 28px;
      color: #171717;
    }

    .crumb,
    .hero-actions,
    .next-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .crumb {
      color: #5f6259;
      font-size: 0.85rem;
      font-weight: 800;
    }

    .crumb a,
    .hero-actions a,
    .next-actions a {
      color: inherit;
      text-decoration: none;
    }

    .hero {
      min-height: min(720px, calc(100vh - 110px));
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
      gap: 24px;
      align-items: stretch;
    }

    .hero__copy,
    .scorecard,
    .featured,
    .participate,
    .goal-runway,
    .regions,
    .teams,
    .next {
      border: 2px solid #171717;
      background: #fffdf5;
      box-shadow: 6px 6px 0 #171717;
    }

    .hero__copy {
      min-width: 0;
      padding: clamp(24px, 5vw, 64px);
      display: grid;
      align-content: center;
      gap: 18px;
      background:
        radial-gradient(circle at 18% 20%, rgba(246, 189, 22, 0.32), transparent 28%),
        linear-gradient(135deg, #fffdf5, #e8f4ff 58%, #ffe8ec);
    }

    .kicker {
      margin: 0;
      color: #5f6259;
      font: 900 0.76rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1,
    h2,
    p {
      margin: 0;
    }

    h1 {
      max-width: 920px;
      font-size: clamp(3rem, 8vw, 7.8rem);
      line-height: 0.9;
      letter-spacing: 0;
    }

    .hero__copy p {
      max-width: 780px;
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.45;
    }

    .hero-actions a,
    .next-actions a {
      display: inline-grid;
      place-items: center;
      min-height: 42px;
      padding: 0 14px;
      border: 2px solid #171717;
      background: #fffdf5;
      box-shadow: 3px 3px 0 #171717;
      font-weight: 950;
    }

    .hero-actions .primary {
      background: #d7ff3f;
    }

    .scorecard {
      padding: 24px;
      display: grid;
      align-content: end;
      gap: 12px;
      background:
        linear-gradient(180deg, rgba(23, 23, 23, 0.08), transparent 34%),
        repeating-linear-gradient(135deg, rgba(23, 23, 23, 0.07) 0 12px, transparent 12px 24px),
        #f6bd16;
    }

    .scorecard span,
    .scorecard em,
    .team-card span,
    .team-card em,
    .featured span,
    .featured em,
    .participation-grid span,
    .region-card__head span {
      font: 900 0.72rem/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .scorecard strong {
      font-size: clamp(2rem, 4vw, 4rem);
      line-height: 0.95;
    }

    .scorecard p,
    .scorecard em {
      max-width: 520px;
    }

    .section-head {
      display: grid;
      gap: 8px;
      margin-bottom: 18px;
    }

    .section-head h2,
    .next h2 {
      font-size: clamp(1.8rem, 4vw, 3.4rem);
      line-height: 0.96;
    }

    .section-head p,
    .next p {
      max-width: 850px;
      color: #4d5149;
      line-height: 1.5;
    }

    .featured,
    .participate,
    .goal-runway,
    .regions,
    .teams,
    .next {
      padding: clamp(18px, 3vw, 34px);
    }

    .featured-grid,
    .participation-grid,
    .goal-runway__cards,
    .region-grid,
    .team-grid {
      display: grid;
      gap: 12px;
    }

    .featured-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .featured article,
    .team-card {
      min-width: 0;
      border: 2px solid #171717;
      background:
        linear-gradient(90deg, var(--team-a) 0 8px, transparent 8px),
        linear-gradient(135deg, color-mix(in srgb, var(--team-a) 16%, #fffdf5), color-mix(in srgb, var(--team-b) 18%, #fffdf5));
    }

    .featured article {
      display: grid;
      grid-template-columns: 86px minmax(0, 1fr);
      gap: 12px;
      align-items: center;
      padding: 12px 12px 12px 18px;
    }

    .featured img,
    .team-card img {
      width: 100%;
      image-rendering: pixelated;
      border: 2px solid #171717;
      background: #fffdf5;
    }

    .featured strong,
    .team-card strong {
      display: block;
      margin: 4px 0;
      font-size: 1.2rem;
      line-height: 1;
    }

    .featured p,
    .team-card dd,
    .participation-grid p {
      color: #3f423c;
      line-height: 1.35;
    }

    .participation-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .participation-grid article {
      min-height: 150px;
      display: grid;
      align-content: start;
      gap: 10px;
      border: 2px solid #171717;
      background: #f1f8ff;
      padding: 14px;
    }

    .goal-runway {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(340px, 1.1fr);
      gap: 18px;
      align-items: stretch;
      background:
        linear-gradient(135deg, rgba(215, 255, 63, 0.56), transparent 56%),
        #fffdf5;
    }

    .goal-runway p {
      max-width: 680px;
      margin-top: 10px;
      color: #4d5149;
      line-height: 1.5;
    }

    .goal-runway__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .goal-runway__cards a {
      min-height: 170px;
      display: grid;
      align-content: space-between;
      gap: 12px;
      border: 2px solid #171717;
      background: #fff;
      color: inherit;
      padding: 16px;
      text-decoration: none;
      box-shadow: 4px 4px 0 #171717;
    }

    .goal-runway__cards span,
    .goal-runway__cards em {
      color: #5f6259;
      font: 900 0.72rem/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .goal-runway__cards strong {
      font-size: 1.45rem;
      line-height: 0.98;
    }

    .region-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .region-card {
      border: 2px solid #171717;
      background: #fffdf5;
      padding: 12px;
    }

    .region-card__head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .state-list {
      display: grid;
      gap: 6px;
    }

    .state-list a {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 8px;
      align-items: center;
      min-height: 34px;
      padding: 5px 8px;
      border: 1.5px solid #171717;
      background: linear-gradient(90deg, var(--team-a) 0 7px, color-mix(in srgb, var(--team-b) 18%, #fffdf5) 7px);
      color: inherit;
      text-decoration: none;
      font-weight: 850;
    }

    .state-list span {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .team-card {
      scroll-margin-top: 20px;
      padding: 12px;
    }

    .team-card__top {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      margin-bottom: 12px;
    }

    .team-card dl {
      display: grid;
      gap: 8px;
      margin: 0;
    }

    .team-card div div,
    .team-card dl div {
      min-width: 0;
    }

    .team-card dt {
      color: #5f6259;
      font: 900 0.64rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .team-card dd {
      margin: 3px 0 0;
      font-size: 0.92rem;
    }

    .next {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
      align-items: center;
      background: #d7ff3f;
    }

    @media (max-width: 980px) {
      .hero,
      .goal-runway,
      .next {
        grid-template-columns: 1fr;
      }

      .featured-grid,
      .goal-runway__cards,
      .region-grid,
      .team-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .participation-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .hero {
        min-height: auto;
      }

      .hero__copy {
        padding: 22px;
      }

      .featured-grid,
      .participation-grid,
      .region-grid,
      .team-grid {
        grid-template-columns: 1fr;
      }

      .scorecard {
        min-height: 320px;
      }
    }
  </style>
</BlockLayout>
