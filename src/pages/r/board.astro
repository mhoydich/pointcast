---
/**
 * /r/board — 'board' is reserved in src/data/air-spots.json (never a spot
 * id) and redirects to /pickleball, build spec §1. Static hosting has no
 * server 302 here, so this is the same meta-refresh + location.replace
 * pattern as /random: noindex, and a real link for anyone whose browser
 * doesn't run the refresh or the script.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';

const targetUrl = '/pickleball';
---

<BlockLayout title="The Pickleball Board" description="Redirects to /pickleball." noindex jsonLd={null}>
  <meta slot="head" http-equiv="refresh" content={`0; url=${targetUrl}`} />
  <link slot="head" rel="canonical" href={`https://pointcast.xyz${targetUrl}`} />

  <div class="rb">
    <p class="rb__line air-mono">FIELD REPORTS · REDIRECTING TO</p>
    <p class="rb__dest"><a href={targetUrl}>{targetUrl}</a></p>
  </div>

  <script is:inline define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</BlockLayout>

<style>
  .rb { max-width: 480px; margin: 0 auto; padding: 80px 24px; text-align: center; }
  .rb__line { margin: 0 0 12px; font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--pc-ink-muted); }
  .rb__dest { margin: 0; font: 600 22px/1.3 var(--pc-font-sans); }
  .rb__dest a { color: var(--pc-ink); }
</style>
