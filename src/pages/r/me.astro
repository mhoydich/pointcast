---
/**
 * /r/me — your Field Reports card.
 *
 * Stamps (place, crew, badges) with the trait line each one recorded, the
 * weekly streak, points today and total, and the last reports. Everything
 * comes from GET /api/air/me with the phone's X-PC-Device header and the
 * session cookie; nothing here is in the page source, so the page is noindex.
 * Signed in, the client moves this phone's last-24-hour rows to the town
 * card through POST /api/air/claim, once per tab.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import AirInk from '../../components/air/AirInk.astro';

const title = 'Your card · Field Reports';
const description = 'Your Field Reports stamps, your week, your points. Kept on this phone until you sign in with PointCast.';
---

<BlockLayout title={title} description={description} noindex hideAds jsonLd={null}>
  <AirInk />
  <div class="rm" data-air-card data-air-me="device">
    <header class="rm__head">
      <p class="rm__kicker air-mono"><a href="/r">Field Reports</a> <span aria-hidden="true">·</span> your card</p>
      <h1 class="rm__byline" data-air-me-byline>Your card</h1>
      <p class="rm__owner air-mono" data-air-me-owner>—</p>
    </header>

    <noscript><p class="rm__note">Your card needs JavaScript: it is read from this phone and your sign-in, never from the page.</p></noscript>

    <!-- Placeholders until the card loads: never made-up zeros. -->
    <dl class="rm__stats">
      <div><dt class="air-mono">Today</dt><dd data-air-me-today>—</dd></div>
      <div><dt class="air-mono">Points</dt><dd data-air-me-total>—</dd><dd class="rm__assigned air-mono" data-air-me-assigned hidden></dd></div>
      <div class="rm__streak"><dt class="air-mono">Your week</dt><dd data-air-me-streak>—</dd></div>
    </dl>

    <p class="rm__note" data-air-me-note role="status" hidden></p>

    <section class="rm__empty" data-air-me-empty hidden>
      <p>No stamps yet. Every on-site report earns one with the spot and the date, like a passport cancellation.</p>
      <a class="rm__go" href="/r">Pick a spot</a>
    </section>

    <section class="rm__section">
      <h2 class="rm__h2 air-mono">Stamps</h2>
      <ul class="rm__stamps" data-air-me-stamps></ul>
    </section>

    <section class="rm__section">
      <h2 class="rm__h2 air-mono">Badges</h2>
      <ul class="rm__badges" data-air-me-badges></ul>
      <p class="rm__rules">First light: first on-site report of the day at a spot. Morning crew: three phones on site within thirty minutes. Still true: ten on-site confirmations.</p>
    </section>

    <section class="rm__section" data-air-me-assign-section hidden>
      <h2 class="rm__h2 air-mono">Assignments</h2>
      <ul class="rm__assigns" data-air-me-assigns></ul>
    </section>

    <section class="rm__section">
      <h2 class="rm__h2 air-mono">Reports</h2>
      <ul class="rm__reports" data-air-me-reports></ul>
    </section>

    <section class="rm__keep" data-air-me-signin hidden>
      <p>Stamps on this phone stay on this phone. Sign in within a day of reporting and they move to your town card and @handle.</p>
      <a class="rm__go" href="/auth?returnTo=/r/me">Sign in with PointCast to keep your stamps</a>
    </section>
    <p class="rm__claim"><button type="button" class="rm__link" data-air-me-claim hidden>Move this phone’s stamps to my card</button></p>

    <footer class="rm__foot">
      <p>Points are a score, not a currency. No leaderboard. Reporters earn points, never cash, and never for what a report says.</p>
      <p class="air-mono"><a href="/r">All spots</a> <span aria-hidden="true">·</span> <a href="/passport">passport</a></p>
    </footer>
  </div>
</BlockLayout>

<script>
  import { mountAir } from '../../scripts/air-client';
  mountAir();
</script>

<style>
  .rm { max-width: 560px; margin: 0 auto; padding: 14px 16px 40px; }
  .rm [hidden] { display: none !important; }
  .rm__head { margin-bottom: 16px; }
  .rm__kicker { margin: 0 0 8px; color: var(--pc-ink-muted); }
  .rm__byline { margin: 0; font: 600 40px/44px var(--pc-font-sans); letter-spacing: -.02em; overflow-wrap: anywhere; }
  .rm__owner { margin: 4px 0 0; color: var(--pc-ink-muted); }
  .rm[data-air-me='user'] .rm__owner { color: var(--pc-accent); }

  .rm__stats { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 8px; margin: 0 0 16px; }
  .rm__stats div { padding: 10px 12px; border: 1.5px solid var(--pc-ink); }
  .rm__stats dt { margin: 0 0 4px; color: var(--pc-ink-muted); }
  .rm__stats dd { margin: 0; font: 600 28px/1 var(--pc-font-sans); letter-spacing: -.02em; }
  .rm__streak dd { font-size: 18px; line-height: 1.2; }
  .rm__assigned { margin: 4px 0 0 !important; font-size: 11px !important; font-weight: 400 !important; color: var(--air-live); }

  .rm__note { margin: 0 0 14px; padding: 10px 12px; border-left: 4px solid var(--pc-ink); font-size: 15px; line-height: 1.4; }
  .rm__empty { margin: 0 0 16px; padding: 14px; background: var(--air-receipt); border: 1px solid var(--pc-rule-soft); }
  .rm__empty p { margin: 0 0 10px; font-size: 16px; line-height: 24px; }
  .rm__go { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 16px; background: var(--pc-ink); color: var(--pc-bg); font-size: 16px; }
  .rm__go:hover { text-decoration: none; background: var(--pc-ink-soft); }

  .rm__section { margin: 0 0 18px; padding-top: 10px; border-top: 2px solid var(--pc-ink); }
  .rm__h2 { margin: 0 0 10px; font-weight: 600; color: var(--pc-ink-muted); }
  /* Stamp, badge and report rows are created by the client, so they are :global(). */
  .rm__stamps { list-style: none; margin: 0; padding: 4px 0 0; display: grid; gap: 18px 12px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .rm__stamps :global(li) { padding: 10px 6px 0; animation: rm-in 240ms ease-out both; animation-delay: calc(var(--i, 0) * 60ms); }
  .rm__stamps :global(.air-stamp) { white-space: normal; }
  @keyframes rm-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .rm__badges { list-style: none; margin: 0 0 10px; padding: 4px 0 0; display: flex; flex-wrap: wrap; gap: 12px 16px; }
  .rm__badges :global(li) { display: grid; gap: 6px; justify-items: start; }
  .rm__badges :global(.air-badge-art) { width: 96px; height: 96px; display: block; }
  .rm__rules { margin: 0; font-size: 13px; line-height: 1.45; color: var(--pc-ink-muted); }
  .rm__assigns { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--pc-rule-soft); }
  .rm__assigns :global(li) { display: grid; grid-template-columns: auto 1fr auto; gap: 6px 10px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--pc-rule-soft); font-size: 15px; }
  .rm__assigns :global(li b) { font-weight: 600; }
  .rm__assigns :global(li small) { grid-column: 3; grid-row: 1; font-size: 11px; color: var(--air-live); font-family: var(--pc-font-mono); letter-spacing: .04em; text-transform: uppercase; }
  /* As the reports list: spot and reward sit under the label, so the label keeps the width. */
  .rm__assigns :global(li > span:not(.air-mono)) { grid-column: 2; color: var(--pc-ink-soft); }
  .rm__reports { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--pc-rule-soft); }
  .rm__reports :global(li) { display: grid; grid-template-columns: auto 1fr auto; gap: 6px 10px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--pc-rule-soft); font-size: 15px; }
  .rm__reports :global(li b) { font-weight: 600; }
  .rm__reports :global(li small) { font-size: 11px; color: var(--pc-ink-muted); }
  .rm__reports :global(li[data-remote]) { color: var(--air-static); }
  .rm__reports :global(li > span:not(.air-mono)) { grid-column: 2; }

  .rm__keep { margin: 0 0 14px; padding: 14px; border: 1.5px solid var(--pc-accent); }
  .rm__keep p { margin: 0 0 10px; font-size: 15px; line-height: 1.45; }
  .rm__claim { margin: 0 0 16px; }
  .rm__link { padding: 0; border: 0; background: none; color: var(--pc-accent); font: inherit; cursor: pointer; }
  .rm__link:hover { text-decoration: underline; }

  .rm__foot { padding-top: 12px; border-top: 1px solid var(--pc-rule); color: var(--pc-ink-muted); }
  .rm__foot p { margin: 0 0 8px; font-size: 13px; line-height: 1.45; }

  @media (max-width: 380px) { .rm__byline { font-size: 34px; line-height: 38px; } .rm__stats { grid-template-columns: 1fr 1fr; } .rm__streak { grid-column: 1 / -1; } }
  @media (prefers-reduced-motion: reduce) { .rm__stamps :global(li) { animation: none; } }
</style>
