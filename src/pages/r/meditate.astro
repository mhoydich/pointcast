---
/**
 * /r/meditate — RoomRenderer rendering /meditate.json.
 *
 * The /r/* namespace renders any room directly off its contract.
 * This page is the reference proof that the same JSON Mike's Claude
 * artifact reads is what produces this surface — no per-page UI.
 *
 * /meditate (the rich legacy page) stays at its current URL. /r/meditate
 * is the contract-driven render.
 */
import BlockLayout from '../../layouts/BlockLayout.astro';
import RoomRenderer from '../../components/RoomRenderer.astro';
import { validateRoomSpec, ROOM_CONTRACT_SCHEMA } from '../../lib/room-contract';
import { buildMeditateRoom } from '../../data/rooms/meditate';

// Single source of truth shared with /meditate.json.ts.
const room = validateRoomSpec(buildMeditateRoom());

const title = `${room.title} — rendered from ${room.id}.json`;
const description = `${room.description} Live room contract v1.`;
---

<BlockLayout title={title} description={description}>
  <main class="r-page">
    <header class="r-page__head">
      <p class="kicker mono">RENDERED FROM <a href={`/${room.id}.json`}>/{room.id}.json</a> · CONTRACT <a href={ROOM_CONTRACT_SCHEMA}>v1</a></p>
    </header>
    <RoomRenderer room={room} />
    <footer class="r-page__foot mono">
      <a href="/meditate">↩ open the rich /meditate page</a>
      <span aria-hidden="true">·</span>
      <a href={`/${room.id}.json`}>view the JSON</a>
      <span aria-hidden="true">·</span>
      <a href="/r/">/r/ index (coming sprint 10)</a>
    </footer>
  </main>
</BlockLayout>

<style>
  .r-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 22px 56px;
    background: #f7f5ef;
    min-height: calc(100vh - 88px);
  }
  .r-page__head {
    margin: 0 0 22px;
    text-align: center;
  }
  .r-page__head .kicker {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: #6a6154;
    text-transform: uppercase;
    margin: 0;
  }
  .r-page__head .kicker a {
    color: #1f1b15;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .r-page__foot {
    margin: 38px 0 0;
    padding-top: 16px;
    border-top: 1px solid #ddd9cc;
    text-align: center;
    font-size: 11px;
    color: #6a6154;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .r-page__foot a {
    color: #1f1b15;
    text-decoration: none;
    border-bottom: 1px solid #ddd9cc;
  }
  .r-page__foot a:hover { border-bottom-color: #1f1b15; }
</style>
