---
import BlockLayout from '../layouts/BlockLayout.astro';
const built = new Date().toISOString();
---
<BlockLayout title="Cast Letter — type a sentence, hear a melody" description="Type anything. The page reads each letter as a scale degree (A-Z mod 7), each vowel held longer, each punctuation mark a rest, and plays the result back as a melody in your chosen key. Shareable via URL hash.">
  <main class="cle" id="cle" data-built={built}>
    <header class="cle__hero">
      <p class="cle__kicker">CAST · LETTER · type · hear · share</p>
      <h1 class="cle__title">Letter.</h1>
      <p class="cle__sub">Type something. The page reads each letter as a scale degree and plays it back as a melody in your chosen key. Vowels hold longer. Commas pause. Sentences end on a full beat of rest. Share what you wrote by copying the URL.</p>
    </header>

    <section class="cle__panel">
      <div class="cle__set">
        <p class="cle__set-label">KEY</p>
        <div class="cle__pills" id="cle-key-pills">
          <button class="cle__pill cle__pill--active" data-key="C">C major</button>
          <button class="cle__pill" data-key="D">D major</button>
          <button class="cle__pill" data-key="Eb">E♭ major</button>
          <button class="cle__pill" data-key="F">F major</button>
          <button class="cle__pill" data-key="G">G major</button>
          <button class="cle__pill" data-key="A">A minor</button>
          <button class="cle__pill" data-key="Dm">D minor</button>
        </div>
      </div>
      <div class="cle__set">
        <p class="cle__set-label">TEMPO · <span id="cle-tempo-val">110</span> BPM</p>
        <input type="range" class="cle__tempo" id="cle-tempo" min="60" max="180" value="110"/>
      </div>
      <div class="cle__set">
        <p class="cle__set-label">VOICE</p>
        <div class="cle__pills" id="cle-voice-pills">
          <button class="cle__pill cle__pill--active" data-voice="celesta">celesta</button>
          <button class="cle__pill" data-voice="vib">vibraphone</button>
          <button class="cle__pill" data-voice="rhodes">rhodes</button>
        </div>
      </div>
    </section>

    <section class="cle__editor">
      <label class="cle__editor-label" for="cle-text">YOUR SENTENCE</label>
      <textarea class="cle__textarea" id="cle-text" rows="3" placeholder="Type something. The melody updates as you go.">a long way home from el segundo, the marine layer in pieces over palos verdes</textarea>
      <p class="cle__editor-hint">A-G are themselves. H-Z wrap (H=A, I=B, ...). Vowels are long, consonants are short. Punctuation rests. Up to 200 letters.</p>
    </section>

    <section class="cle__stage">
      <canvas class="cle__roll" id="cle-roll" width="1000" height="160"></canvas>
      <div class="cle__transport">
        <button class="cle__play" id="cle-play" type="button">
          <span class="cle__play-icon" id="cle-play-icon">▶</span>
          <span class="cle__play-label" id="cle-play-label">PLAY</span>
        </button>
        <button class="cle__share" id="cle-share" type="button">SHARE LINK</button>
        <span class="cle__share-status" id="cle-share-status"></span>
      </div>
    </section>

    <section class="cle__about">
      <h2 class="cle__about-h">Why letters?</h2>
      <p>Music has had alphabetic notes for a thousand years. Bach famously hid his name in the last fugue of <em>Die Kunst der Fuge</em> — B♭, A, C, B♮ (in German notation). Shostakovich signed his quartets with D♭, E♭, C, B (DSCH in German). This page is the same idea, less prestigious, more public.</p>
      <p>The mapping: each letter's position in the alphabet mod 7 picks a scale degree (A→1, B→2, ... G→7, H→1, I→2, ...). Vowels are quarter notes; consonants are eighth notes. Commas and semicolons add a beat of rest. Periods add two. So the rhythm of a sentence shapes the melody even when the pitches are deterministic.</p>
      <p>The result isn't usually pretty in the traditional sense — but it always fits the key, because everything is a scale degree. Long words become melodic runs; punctuation marks become breath. Try typing a poem.</p>
      <p>Other surfaces: <a href="/cast-jam">/cast-jam</a> for free play in a key, <a href="/cast-wheel">/cast-wheel</a> for the geometry of keys, <a href="/cast-throw">/cast-throw</a> for melodic conversation.</p>
    </section>
  </main>

  <style is:global>
    :root {
      --cle-ink: #0c0810;
      --cle-walnut: #4a2a1a;
      --cle-flame: #f6c15e;
      --cle-flame-deep: #d68f2c;
      --cle-cream: #f4e7c8;
      --cle-cream-dim: #c8b48a;
      --cle-cream-dimmer: #8b7a5a;
      --cle-mint: #9bd7b8;
      --cle-mauve: #b39ddb;
      --cle-rose: #e6788c;
    }

    body:has(.cle) {
      background: radial-gradient(circle at 30% 0%, #2a1430 0%, var(--cle-ink) 60%);
      color: var(--cle-cream);
      font-family: 'Inter', -apple-system, system-ui, sans-serif;
      min-height: 100vh;
    }

    .cle { max-width: 1020px; margin: 0 auto; padding: 48px 24px 80px; }

    .cle__hero { text-align: center; margin-bottom: 32px; }
    .cle__kicker {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.18em;
      color: var(--cle-flame-deep);
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .cle__title {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 12vw, 138px);
      letter-spacing: -0.04em;
      line-height: 0.9;
      margin: 0 0 16px;
      color: var(--cle-flame);
      text-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    .cle__sub {
      max-width: 680px; margin: 0 auto;
      font-size: 17px; line-height: 1.5;
      color: var(--cle-cream-dim);
    }

    /* PANEL */
    .cle__panel {
      display: grid;
      grid-template-columns: 2fr 1fr 1.2fr;
      gap: 12px;
      margin-bottom: 22px;
    }
    @media (max-width: 800px) { .cle__panel { grid-template-columns: 1fr; } }
    .cle__set {
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(246,193,94,0.14);
      border-radius: 14px;
      padding: 12px 14px;
    }
    .cle__set-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--cle-cream-dimmer);
      margin: 0 0 8px;
    }
    .cle__pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .cle__pill {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(246,193,94,0.28);
      background: transparent;
      color: var(--cle-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cle__pill:hover { background: rgba(246,193,94,0.10); }
    .cle__pill--active {
      background: var(--cle-flame);
      color: var(--cle-walnut);
      border-color: var(--cle-flame);
    }
    .cle__tempo { width: 100%; accent-color: var(--cle-flame); }

    /* EDITOR */
    .cle__editor {
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 18px;
      padding: 18px 20px;
      margin-bottom: 22px;
    }
    .cle__editor-label {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--cle-cream-dimmer);
      margin-bottom: 10px;
    }
    .cle__textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.18);
      background: rgba(244,231,200,0.05);
      color: var(--cle-cream);
      font-family: 'Inter Tight', sans-serif;
      font-weight: 500;
      font-size: 18px;
      line-height: 1.5;
      letter-spacing: 0.005em;
      resize: vertical;
      min-height: 70px;
    }
    .cle__textarea:focus {
      outline: 2px solid var(--cle-flame);
      outline-offset: 1px;
    }
    .cle__editor-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cle-cream-dimmer);
      margin: 8px 0 0;
    }

    /* STAGE */
    .cle__stage {
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(246,193,94,0.16);
      border-radius: 18px;
      padding: 18px 20px 20px;
      margin-bottom: 28px;
    }
    .cle__roll {
      width: 100%;
      height: 160px;
      background: rgba(0,0,0,0.3);
      border-radius: 10px;
      display: block;
      margin-bottom: 14px;
    }
    .cle__transport {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }
    .cle__play {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      border-radius: 12px;
      border: 0;
      background: var(--cle-flame);
      color: var(--cle-walnut);
      cursor: pointer;
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      box-shadow: 0 4px 14px rgba(246,193,94,0.32);
    }
    .cle__play:hover { background: var(--cle-flame-deep); }
    .cle__share {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid rgba(246,193,94,0.32);
      background: transparent;
      color: var(--cle-cream);
      cursor: pointer;
      transition: background 100ms ease;
    }
    .cle__share:hover { background: rgba(246,193,94,0.12); }
    .cle__share-status {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--cle-mint);
      margin-left: 4px;
    }

    /* ABOUT */
    .cle__about {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 0 0;
      border-top: 1px solid rgba(246,193,94,0.14);
    }
    .cle__about-h {
      font-family: 'Inter Tight', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--cle-cream);
      margin: 0 0 12px;
    }
    .cle__about p {
      font-size: 15px; line-height: 1.6;
      color: var(--cle-cream-dim);
      margin: 0 0 12px;
    }
    .cle__about em { color: var(--cle-flame); font-style: italic; }
    .cle__about a { color: var(--cle-flame); text-decoration: none; }
    .cle__about a:hover { text-decoration: underline; }
  </style>

  <script>
    import { createAudioScheduler } from '../lib/audio-scheduler';

    // ---- music data ----
    const VOWELS = new Set(['A','E','I','O','U','Y']);

    // Key roots and scale (major + 2 minors). MIDI of C4 = 60. Each scale is 7 degrees in semitones from root.
    const MAJOR  = [0, 2, 4, 5, 7, 9, 11];        // 1 2 3 4 5 6 7
    const MINOR  = [0, 2, 3, 5, 7, 8, 10];        // natural minor

    type KeyKey = 'C' | 'D' | 'Eb' | 'F' | 'G' | 'A' | 'Dm';
    const KEYS: Record<KeyKey, { rootMidi: number; scale: number[]; name: string }> = {
      'C':  { rootMidi: 60, scale: MAJOR, name: 'C major' },
      'D':  { rootMidi: 62, scale: MAJOR, name: 'D major' },
      'Eb': { rootMidi: 63, scale: MAJOR, name: 'Eb major' },
      'F':  { rootMidi: 65, scale: MAJOR, name: 'F major' },
      'G':  { rootMidi: 67, scale: MAJOR, name: 'G major' },
      'A':  { rootMidi: 69, scale: MINOR, name: 'A minor' },
      'Dm': { rootMidi: 62, scale: MINOR, name: 'D minor' },
    };

    type Voice = 'celesta' | 'vib' | 'rhodes';
    let currentKey: KeyKey = 'C';
    let tempo = 110;
    let voice: Voice = 'celesta';
    let text = '';

    type Event =
      | { kind: 'note'; midi: number; durBeats: number; isVowel: boolean; charIdx: number }
      | { kind: 'rest'; durBeats: number; charIdx: number };

    let events: Event[] = [];
    let totalBeats = 0;

    let ctx: AudioContext | null = null;
    let scheduler: ReturnType<typeof createAudioScheduler> | null = null;
    let masterGain: GainNode | null = null;
    let playing = false;
    let playStartCtx = 0;
    let rafId: number | null = null;
    let endTimer: number | null = null;

    // ---- mapping ----
    function letterToDegree(c: string): number | null {
      const u = c.toUpperCase();
      const code = u.charCodeAt(0);
      if (code >= 65 && code <= 90) {  // A-Z
        return (code - 65) % 7;  // 0..6
      }
      return null;
    }

    function rebuildEvents() {
      events = [];
      totalBeats = 0;
      const k = KEYS[currentKey];
      // Use rootMidi as scale degree 1 in octave 4. Step up octave every word for variety? No — keep deterministic.
      // Cap text length to keep things sane.
      const t = text.slice(0, 200);
      let lastDegree = -1;
      for (let i = 0; i < t.length; i++) {
        const c = t[i];
        const deg = letterToDegree(c);
        if (deg != null) {
          // pick octave: stay in C4-C6 range. Use base octave + (running count / 7) jumps.
          const baseMidi = k.rootMidi + k.scale[deg];
          // small heuristic to avoid huge intervals: if next degree is < lastDegree (modular wrap), step up octave only if descent is < -4 letters
          let oct = 0;
          if (lastDegree >= 0) {
            const diff = deg - lastDegree;
            // if previous letter was high (deg 5/6) and current is low (0/1), bump up octave for upward motion 30% of time
            if (lastDegree >= 4 && deg <= 2 && Math.random() < 0.3) oct = 1;
            // if previous was low and current is very high, step down 20% of time
            if (lastDegree <= 1 && deg >= 5 && Math.random() < 0.2) oct = -1;
          }
          const midi = baseMidi + 12 * oct;
          const isVowel = VOWELS.has(c.toUpperCase());
          const durBeats = isVowel ? 1.0 : 0.5;
          events.push({ kind: 'note', midi, durBeats, isVowel, charIdx: i });
          totalBeats += durBeats;
          lastDegree = deg;
        } else if (c === ' ') {
          // soft pause
          events.push({ kind: 'rest', durBeats: 0.25, charIdx: i });
          totalBeats += 0.25;
        } else if (c === ',' || c === ';' || c === ':') {
          events.push({ kind: 'rest', durBeats: 1.0, charIdx: i });
          totalBeats += 1.0;
        } else if (c === '.' || c === '!' || c === '?') {
          events.push({ kind: 'rest', durBeats: 2.0, charIdx: i });
          totalBeats += 2.0;
        } else if (c === '\n') {
          events.push({ kind: 'rest', durBeats: 1.5, charIdx: i });
          totalBeats += 1.5;
        }
        // other punctuation/digits silently ignored
      }
      drawRoll();
    }

    // ---- audio ----
    function ensureCtx() {
      if (ctx) return;
      ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      scheduler = createAudioScheduler(ctx);
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.5;
      masterGain.connect(ctx.destination);
    }

    function midiToHz(m: number) { return 440 * Math.pow(2, (m - 69) / 12); }
    function beatSec() { return 60 / tempo; }

    function playNote(midi: number, atCtxTime: number, durSec: number, accent = false) {
      if (!ctx || !scheduler || !masterGain) return;
      const hz = midiToHz(midi);
      const stacks =
        voice === 'celesta' ? [
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.30 },
          { type: 'sine' as OscillatorType, freq: hz * 2, gain: 0.16 },
          { type: 'sine' as OscillatorType, freq: hz * 4, gain: 0.06 },
        ] :
        voice === 'vib' ? [
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.28 },
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.18, detune: 6 },
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.18, detune: -6 },
        ] :
        [   // rhodes
          { type: 'sine' as OscillatorType, freq: hz, gain: 0.34 },
          { type: 'sine' as OscillatorType, freq: hz * 2, gain: 0.10 },
        ];

      const peakMul = accent ? 1.18 : 1.0;
      const tail = Math.max(durSec, 0.16);
      const attack = voice === 'rhodes' ? 0.005 : 0.012;
      const releaseSec = voice === 'celesta' ? 0.4 : voice === 'rhodes' ? 0.22 : 0.3;
      for (const v of stacks) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = v.type;
        osc.frequency.value = v.freq;
        if ((v as any).detune) osc.detune.value = (v as any).detune;
        g.gain.setValueAtTime(0.0001, atCtxTime);
        g.gain.exponentialRampToValueAtTime(v.gain * peakMul, atCtxTime + attack);
        g.gain.exponentialRampToValueAtTime(0.0001, atCtxTime + tail + releaseSec);
        osc.connect(g).connect(masterGain);
        scheduler.trackSource(osc);
        osc.start(atCtxTime);
        osc.stop(atCtxTime + tail + releaseSec + 0.05);
      }
    }

    function startPlayback() {
      ensureCtx();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume();
      if (scheduler) scheduler.stopAll();
      playing = true;
      document.getElementById('cle-play-icon')!.textContent = '■';
      document.getElementById('cle-play-label')!.textContent = 'STOP';

      const bs = beatSec();
      playStartCtx = ctx.currentTime + 0.05;
      let cum = 0;
      for (const ev of events) {
        if (ev.kind === 'note') {
          playNote(ev.midi, playStartCtx + cum * bs, ev.durBeats * bs, false);
        }
        cum += ev.durBeats;
      }
      const totalSec = totalBeats * bs;
      if (endTimer != null) clearTimeout(endTimer);
      endTimer = window.setTimeout(() => stopPlayback(), (totalSec + 0.6) * 1000);
      tickPlayhead();
    }

    function stopPlayback() {
      playing = false;
      if (scheduler) scheduler.stopAll();
      if (endTimer != null) { clearTimeout(endTimer); endTimer = null; }
      if (rafId != null) { cancelAnimationFrame(rafId); rafId = null; }
      document.getElementById('cle-play-icon')!.textContent = '▶';
      document.getElementById('cle-play-label')!.textContent = 'PLAY';
      drawRoll();
    }

    function tickPlayhead() {
      drawRoll();
      if (playing) rafId = requestAnimationFrame(tickPlayhead);
    }

    // ---- rendering ----
    function drawRoll() {
      const canvas = document.getElementById('cle-roll') as HTMLCanvasElement;
      const c2 = canvas.getContext('2d')!;
      const W = canvas.width, H = canvas.height;
      c2.clearRect(0, 0, W, H);
      if (events.length === 0) {
        c2.fillStyle = 'rgba(244,231,200,0.4)';
        c2.font = '12px JetBrains Mono, monospace';
        c2.fillText('Type something above to see the melody…', 12, 22);
        return;
      }
      // Compute pitch range
      const noteEvents = events.filter(e => e.kind === 'note') as Extract<Event, { kind: 'note' }>[];
      const midis = noteEvents.map(n => n.midi);
      const minMidi = Math.max(40, Math.min(...midis) - 2);
      const maxMidi = Math.min(96, Math.max(...midis) + 2);
      const range = Math.max(8, maxMidi - minMidi);

      // grid lines for octaves
      c2.strokeStyle = 'rgba(244,231,200,0.06)';
      for (let m = Math.ceil(minMidi / 12) * 12; m <= maxMidi; m += 12) {
        const y = H - ((m - minMidi) / range) * H;
        c2.beginPath(); c2.moveTo(0, y); c2.lineTo(W, y); c2.stroke();
        c2.fillStyle = 'rgba(246,193,94,0.32)';
        c2.font = '9px JetBrains Mono, monospace';
        c2.fillText(`C${Math.floor(m / 12) - 1}`, 4, y - 2);
      }

      // notes
      let cum = 0;
      for (const ev of events) {
        if (ev.kind === 'note') {
          const x = (cum / totalBeats) * W;
          const w = Math.max(2, (ev.durBeats / totalBeats) * W - 1);
          const y = H - ((ev.midi - minMidi) / range) * H - 4;
          c2.fillStyle = ev.isVowel ? '#f6c15e' : '#b39ddb';
          c2.fillRect(x, y, w, 6);
        }
        cum += ev.durBeats;
      }

      // playhead
      if (playing && ctx) {
        const elapsed = ctx.currentTime - playStartCtx;
        const playedBeats = elapsed / beatSec();
        if (playedBeats >= 0 && playedBeats <= totalBeats) {
          const x = (playedBeats / totalBeats) * W;
          c2.strokeStyle = 'rgba(246,193,94,0.85)';
          c2.lineWidth = 2;
          c2.beginPath(); c2.moveTo(x, 0); c2.lineTo(x, H); c2.stroke();
        }
      }
    }

    // ---- url state ----
    function setHashState() {
      const params = new URLSearchParams();
      params.set('k', currentKey);
      params.set('t', String(tempo));
      params.set('v', voice);
      params.set('s', encodeURIComponent(text));
      location.hash = params.toString();
    }
    function readHashState() {
      if (!location.hash) return;
      const params = new URLSearchParams(location.hash.slice(1));
      const k = params.get('k') as KeyKey | null;
      const t = parseInt(params.get('t') || '');
      const v = params.get('v') as Voice | null;
      const s = params.get('s');
      if (k && KEYS[k]) currentKey = k;
      if (!Number.isNaN(t) && t >= 60 && t <= 180) tempo = t;
      if (v === 'celesta' || v === 'vib' || v === 'rhodes') voice = v;
      if (s) text = decodeURIComponent(s);
    }

    function syncChips() {
      document.querySelectorAll('#cle-key-pills .cle__pill').forEach(el =>
        el.classList.toggle('cle__pill--active', el.getAttribute('data-key') === currentKey));
      document.querySelectorAll('#cle-voice-pills .cle__pill').forEach(el =>
        el.classList.toggle('cle__pill--active', el.getAttribute('data-voice') === voice));
    }

    function init() {
      readHashState();
      syncChips();
      (document.getElementById('cle-tempo') as HTMLInputElement).value = String(tempo);
      document.getElementById('cle-tempo-val')!.textContent = String(tempo);
      const ta = document.getElementById('cle-text') as HTMLTextAreaElement;
      if (text) ta.value = text;
      else text = ta.value;
      rebuildEvents();

      ta.addEventListener('input', () => {
        text = ta.value;
        rebuildEvents();
      });

      document.getElementById('cle-key-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-key]');
        if (!btn) return;
        currentKey = btn.getAttribute('data-key') as KeyKey;
        syncChips();
        rebuildEvents();
      });
      document.getElementById('cle-voice-pills')!.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest('[data-voice]');
        if (!btn) return;
        voice = btn.getAttribute('data-voice') as Voice;
        syncChips();
      });
      const tempoSlider = document.getElementById('cle-tempo') as HTMLInputElement;
      tempoSlider.addEventListener('input', () => {
        tempo = parseInt(tempoSlider.value);
        document.getElementById('cle-tempo-val')!.textContent = String(tempo);
      });

      document.getElementById('cle-play')!.addEventListener('click', () => {
        if (playing) stopPlayback();
        else startPlayback();
      });

      document.getElementById('cle-share')!.addEventListener('click', async () => {
        setHashState();
        try {
          await navigator.clipboard.writeText(location.href);
          const s = document.getElementById('cle-share-status')!;
          s.textContent = 'copied to clipboard';
          setTimeout(() => { s.textContent = ''; }, 2200);
        } catch {
          const s = document.getElementById('cle-share-status')!;
          s.textContent = 'URL updated — copy from address bar';
          setTimeout(() => { s.textContent = ''; }, 3500);
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) stopPlayback();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BlockLayout>
