---
/**
 * /bar-mood-board — visual exploration for the walking bar's future.
 *
 * Mike 2026-05-12: "explore a bunch of image generation, future
 * states, mood boards, backgrounds, neat features" — then later
 * "the morning experience isn't interesting enough, articles are eh,
 * surfacing isn't capturing the depth, take a look at the whole
 * project for planning next sprint."
 *
 * This page is the surface for the visual direction-finding work.
 * 6 raster images generated via Codex's built-in image_gen tool,
 * each exploring a different aesthetic or time-of-day for the bar.
 *
 * Pick one (or merge two) and we apply it back to the live bar as a
 * deep-background layer behind the SVG skyline. Or generate more
 * (Codex MCP is wired up; ~10s/image, ~2-3MB PNG each).
 */
import BlockLayout from '../layouts/BlockLayout.astro';

interface Mood {
  num: string;
  src: string;
  title: string;
  style: string;
  blurb: string;
  notes: string;
}

const MOODS: Mood[] = [
  {
    num: '01',
    src: '/bar/explorations/01-golden-hour-pixel-art.png',
    title: 'Golden hour',
    style: '16-bit pixel art',
    blurb: 'El Segundo at sunset. The first image, the brief that worked. Refinery on the left, residential cluster in the middle with palms, mid-rise offices, beach + Pacific on the right. Warm gold and coral sky.',
    notes: 'This is the canonical aesthetic — what the live bar is descended from. Use as the baseline.',
  },
  {
    num: '02',
    src: '/bar/explorations/02-night-stars.png',
    title: 'Night with stars',
    style: '16-bit pixel art',
    blurb: 'Same scene at deep night. Crescent moon, scattered stars, refinery flare-lights orange against indigo, every house window glowing warm yellow. Silver moonlight on the wave crests. The street lamps actually warm the sidewalk.',
    notes: 'This is what the bar wants to BECOME at night. Apply --nightness to the live bar so it lerps toward this image as midnight approaches.',
  },
  {
    num: '03',
    src: '/bar/explorations/03-overcast-fog-morning.png',
    title: 'Overcast fog morning',
    style: '16-bit pixel art',
    blurb: 'The signature El Segundo morning. Marine layer rolling in from the Pacific, refinery smokestacks fading into haze, soft grey-blue palette, a few warm lights still glowing. Pure moodscape.',
    notes: 'This SHOULD be the homepage hero on overcast mornings (which is most of them in May). Right now we get a generic AI article instead.',
  },
  {
    num: '04',
    src: '/bar/explorations/04-storm-pacific.png',
    title: 'Storm rolling in',
    style: '16-bit pixel art',
    blurb: 'Dark heavy clouds over the Pacific, lightning illuminating offshore swells, rain sheets across the right third. Refinery flare-lights catching the storm light. Cinematic — looks like a still from a film.',
    notes: 'On thunder days /api/weather returns a thunder treatment. Today this image would be the right hero. Tomorrow probably image 03 (overcast).',
  },
  {
    num: '05',
    src: '/bar/explorations/05-ghibli-watercolor.png',
    title: 'Ghibli watercolor',
    style: 'hand-painted watercolor · Studio Ghibli',
    blurb: 'Same scene, different visual language. Soft brush strokes, warm afternoon light, painterly clouds. Less video-game, more storybook. The kind of image that makes you want to slow down.',
    notes: 'The wildcard. If we wanted to fork the bar aesthetic toward something softer and more cinematic, this is the direction. Could coexist with pixel-art if styled as a "background painting" layer.',
  },
  {
    num: '06',
    src: '/bar/explorations/06-moebius-line.png',
    title: 'Moebius line art',
    style: 'ink line art · Jean Giraud',
    blurb: 'Confident black outlines, flat color fills, French-comics composition. A different IP entirely — confident, graphic, editorial. The bar as Heavy Metal cover.',
    notes: 'Probably wrong for PointCast (too cool, too distant) but useful as a foil. Helps clarify what we want by showing what we don\'t.',
  },
  {
    num: '07',
    src: '/bar/explorations/07-kettle-hero.png',
    title: 'KETTLE — coffee shop hero',
    style: '16-bit pixel art · close-up',
    blurb: 'Cozy corner coffee shop at angle. Wood facade with vines climbing the wall, striped amber awning, hanging brass coffee cup sign, pendant lights and espresso machine glowing through the window, sandwich board on the sidewalk, twilight palm tree. This is the level of building detail the bar wants.',
    notes: 'Could literally replace the SVG sprite — render at ~50px and it would feel painted. The character per building is the missing piece. Apply this approach to all 5 kit buildings.',
  },
  {
    num: '08',
    src: '/bar/explorations/08-studio-hero.png',
    title: 'STUDIO — creative space hero',
    style: '16-bit pixel art · close-up',
    blurb: 'Modernist navy building, big slanted skylight catching purple twilight, floor-to-ceiling window strip with an easel and half-finished painting visible inside. Pencil-shaped golden sign over the door. Warm orange light pooling on the dark sidewalk. Like seeing a real studio at dusk.',
    notes: 'Same direction as 07. Hand-painted building characters > generic SVG geometry. The painting on the easel reads as someone working RIGHT NOW.',
  },
  {
    num: '09',
    src: '/bar/explorations/09-drum-hero.png',
    title: 'DRUM — music venue hero',
    style: '16-bit pixel art · close-up',
    blurb: 'Side-angle of a brick venue at night. "DRUM" on a glowing vintage marquee with theater letter-bulbs, pink neon trim along the cornice, three small pixel-art figures silhouetted near the entrance, band poster panels along the side. Wet sidewalk reflecting the marquee. Music notes drifting upward.',
    notes: 'The "real" character of DRUM. The bar\'s DRUM sprite should aspire to this energy — vintage theater marquee, neon, a hint of music in the air.',
  },
  {
    num: '10',
    src: '/bar/explorations/10-window-hero.png',
    title: 'WINDOW — observation hero',
    style: '16-bit pixel art · close-up',
    blurb: 'Almost-all-glass observation building at golden hour, teal frame, antenna stubs, a noun-style figure silhouette inside looking out, Pacific Ocean horizon visible behind. Wide low awning, deck lights along the parapet.',
    notes: 'WINDOW is the most metaphor-heavy building. This render gets it right — it\'s literally a window onto El Segundo, with someone always inside looking out.',
  },
  {
    num: '11',
    src: '/bar/explorations/11-desk-hero.png',
    title: 'DESK — cozy home hero',
    style: '16-bit pixel art · close-up',
    blurb: 'Two-story craftsman home with peaked roof, soft purple-blue siding, two upstairs curtained windows glowing warm yellow, downstairs awning, porch light, mailbox, planters with flowers, twilight sky pink-to-violet. A real El Segundo home you\'d want to live in.',
    notes: 'This is "YOUR DESK" — the player\'s home node, where /me lives. The warmth + lit windows + porch light is the right read.',
  },
];

const title = 'Bar mood board · visual direction';
const description = '6 raster images exploring future visual directions for the walking bar. Codex-generated. Pick one — or merge two — to apply back to the live /bar-v6.';
---

<BlockLayout title={title} description={description}>
  <main class="moodboard">

    <header class="moodboard__hero">
      <p class="moodboard__crumb">
        <a href="/">home</a> <span aria-hidden="true">›</span>
        <a href="/bar-v6">bar v6</a> <span aria-hidden="true">›</span>
        <span>mood board</span>
      </p>
      <p class="moodboard__kicker mono">VISUAL DIRECTION · {MOODS.length} EXPLORATIONS</p>
      <h1 class="moodboard__title">Where the bar could go next.</h1>
      <p class="moodboard__dek">
        The live walking bar at <a href="/bar-v6">/bar-v6</a> is 100% SVG —
        scales, tints with time-of-day, no HTTP overhead. These raster images
        explore where the bar could go next as a deep-background painted
        layer behind the SVG. Each is real El Segundo: the Chevron refinery,
        the residential strip, the aerospace offices, the beach sloping to
        Pacific. Generated via Codex's built-in image_gen tool.
      </p>
      <p class="moodboard__dek">
        <strong>What we're trying to pick</strong>: a base aesthetic that
        feels like the morning is worth checking. Mike 2026-05-12: <em>
        "the morning experience isn't interesting enough."</em>
      </p>
    </header>

    <section class="moodboard__grid" aria-label="Generated explorations">
      {MOODS.map((m) => (
        <article class="mood">
          <a class="mood__link" href={m.src} target="_blank" rel="noopener">
            <img class="mood__img" src={m.src} alt={`${m.title} — ${m.style}`} loading="lazy" />
          </a>
          <div class="mood__body">
            <header class="mood__head">
              <span class="mood__num mono">{m.num}</span>
              <h2 class="mood__title">{m.title}</h2>
              <span class="mood__style mono">{m.style}</span>
            </header>
            <p class="mood__blurb">{m.blurb}</p>
            <p class="mood__notes mono"><strong>NOTE:</strong> {m.notes}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="moodboard__queued">
      <p class="moodboard__eyebrow mono">QUEUED · NOT YET GENERATED</p>
      <p class="moodboard__queued-dek">
        Codex MCP connection drops on large batches, so these are next when
        I do another small-batch round:
      </p>
      <ul class="moodboard__queued-list">
        <li><strong>12 Tall bar</strong> — same town in a taller frame (200px equivalent), more vertical depth + foreground sidewalk</li>
        <li><strong>13 KETTLE interior</strong> — what does the inside of the coffee shop look like? A future "enter the building" flow</li>
        <li><strong>14 Aerial map</strong> — top-down pixel-art map of El Segundo</li>
        <li><strong>15 Misty dawn</strong> — same panorama at 5am, pink alpenglow on refinery, ocean still dark</li>
        <li><strong>16 Friday-night DRUM</strong> — wider street scene, multiple buildings lit, a crowd outside</li>
      </ul>
    </section>

    <section class="moodboard__plan">
      <p class="moodboard__eyebrow mono">NEXT SPRINT · MAKE THE MORNING THE POINT</p>
      <p class="moodboard__plan-dek">
        Tonight's diagnosis: the project has real depth (animated El Segundo bar,
        painted Codex backdrops, walking nouns, cross-visitor, pet adoption,
        weather, inventory, drums, tribute posters). The homepage surfaces
        it as <strong>lists of refs</strong>. It reads like a changelog when
        it should read like a magazine.
      </p>
      <ol class="moodboard__sprint">
        <li>
          <strong>PR 1 — Morning Hero band.</strong> Replace the auto-block
          hero with a daily morning hero band — big image, two-sentence
          human-voice editorial, one specific thing to try.
        </li>
        <li>
          <strong>PR 2 — Ships as Stories.</strong> Reformat RECENT SHIPS from
          ref-list to paragraphs-with-images. <code>#590 v6.3 ambient emotes</code>
          → <em>"Last night the bar started waving at random walkers every
          7-16s. Small, ambient, changes how it feels."</em>
        </li>
        <li>
          <strong>PR 3 — Daily painting pipeline.</strong> Cloudflare scheduled
          function calls Codex image_gen at ~6am PT with today's real weather.
          Saves to <code>public/bar/daily/YYYY-MM-DD.png</code>. The bar
          repaints overnight.
        </li>
        <li>
          <strong>PR 4 — Mood board page.</strong> This. ✓
        </li>
        <li>
          <strong>PR 5 — Article quality gate.</strong> Stop publishing
          generic AI content as the LEAD. Require <code>featured: true</code>
          frontmatter or a real ship to claim hero.
        </li>
      </ol>
    </section>

    <footer class="moodboard__foot mono">
      <p>
        all images generated via Codex's built-in image_gen tool ·
        ~2-3MB each PNG · 1659×948 native size ·
        saved in <code>public/bar/explorations/</code>
      </p>
    </footer>

  </main>
</BlockLayout>

<style>
  .moodboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 20px 80px;
    font-family: var(--font-body);
  }

  /* HERO */
  .moodboard__hero {
    margin: 0 0 36px;
    padding-bottom: 22px;
    border-bottom: 1.5px solid var(--color-rule);
  }
  .moodboard__crumb {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.16em;
    color: var(--color-ink-soft); text-transform: uppercase;
    margin: 0 0 14px;
  }
  .moodboard__crumb a { color: var(--color-ink-soft); text-decoration: none; }
  .moodboard__crumb a:hover { color: var(--color-ink); }
  .moodboard__crumb span { margin: 0 6px; }
  .moodboard__kicker {
    font-size: 11px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase;
    margin: 0 0 14px;
  }
  .moodboard__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05; font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: var(--color-ink);
  }
  .moodboard__dek {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.3vw, 18px); line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 760px;
    margin: 0 0 12px;
  }
  .moodboard__dek a { color: var(--color-warm); }
  .moodboard__dek em { color: var(--color-ink); }

  /* GRID */
  .moodboard__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    margin: 0 0 48px;
  }
  @media (min-width: 900px) {
    .moodboard__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 28px;
    }
  }

  .mood {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1.5px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .mood:hover {
    border-color: var(--color-warm);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(31, 27, 21, 0.08);
  }
  .mood__link {
    display: block;
    line-height: 0;
    background: #1f1b15;
  }
  .mood__img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  /* Ghibli + Moebius variants aren't pixel-art — don't pixelate them */
  .mood:nth-child(5) .mood__img,
  .mood:nth-child(6) .mood__img {
    image-rendering: auto;
  }
  .mood__body { padding: 18px 20px 20px; }
  .mood__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: baseline;
    margin: 0 0 10px;
  }
  .mood__num {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-warm);
  }
  .mood__title {
    font-family: var(--font-heading);
    font-size: 22px; font-weight: 600;
    color: var(--color-ink);
    margin: 0; line-height: 1.2;
  }
  .mood__style {
    font-size: 10px; letter-spacing: 0.12em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    text-align: right;
  }
  .mood__blurb {
    font-family: var(--font-serif);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0 0 12px;
  }
  .mood__notes {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0;
    padding: 10px 12px;
    background: var(--color-card);
    border-left: 3px solid var(--color-warm);
    border-radius: 2px;
  }
  .mood__notes strong {
    color: var(--color-warm);
    letter-spacing: 0.12em;
  }

  /* QUEUED + PLAN SECTIONS */
  .moodboard__queued,
  .moodboard__plan {
    margin: 0 0 32px;
    padding: 20px 22px;
    background: var(--color-card);
    border: 1px dashed var(--color-rule);
    border-radius: 3px;
  }
  .moodboard__eyebrow {
    font-size: 10px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase;
    margin: 0 0 12px;
  }
  .moodboard__queued-dek,
  .moodboard__plan-dek {
    font-family: var(--font-serif);
    font-size: 14.5px; line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0 0 14px;
    max-width: 760px;
  }
  .moodboard__queued-list,
  .moodboard__sprint {
    margin: 0;
    padding-left: 22px;
    line-height: 1.6;
    font-size: 14px;
    color: var(--color-ink);
  }
  .moodboard__queued-list li,
  .moodboard__sprint li { margin: 0 0 8px; }
  .moodboard__sprint strong { color: var(--color-ink); }
  .moodboard__sprint em { color: var(--color-ink-soft); font-style: italic; }
  .moodboard__sprint code,
  .moodboard__queued-list code {
    background: rgba(0,0,0,0.06);
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 12px;
  }
  .moodboard__plan-dek strong { color: var(--color-ink); }

  /* FOOT */
  .moodboard__foot {
    padding-top: 16px;
    border-top: 1px solid var(--color-rule);
    font-size: 11px;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }
  .moodboard__foot code {
    background: var(--color-card);
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 11px;
  }
</style>
