---
/**
 * /inventory — fuller standalone view of pc:inventory:v1.
 *
 * Sibling of the /me INVENTORY band but with more breathing room and
 * extra editorial framing. Reads the SAME localStorage key
 * (pc:inventory:v1) so changes here show up on /me and vice versa.
 *
 * Shipped 2026-05-08 as the second half of "wire inventory in" — the
 * /paddle-exchange page already imports paddles into its form. This
 * gives Mike (and any visitor with gear) a dedicated home.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Inventory · your local kit';
const description = 'Stuff you actually own — paddles, drums, wheels, plants, tech, books. Stored locally only, never sent to a server. Wired into /paddle-exchange + /honey-league (paddles) and /houseplants (plants). Sibling of the /me INVENTORY band.';
---

<BlockLayout title={title} description={description}>
  <main class="inv-page">

    <header class="inv-page__hero">
      <p class="inv-page__crumb">
        <a href="/">home</a> <span aria-hidden="true">›</span>
        <a href="/me">me</a> <span aria-hidden="true">›</span>
        <span>inventory</span>
      </p>
      <p class="inv-page__kicker mono">YOUR KIT · LOCAL TO THIS BROWSER</p>
      <h1 class="inv-page__title">What's in the bag.</h1>
      <p class="inv-page__dek">
        Paddles · drums · wheels · plants · tech · books · whatever else.
        Stored only in this browser as <code>pc:inventory:v1</code> — never
        sent to a server. Same data as the INVENTORY band on
        <a href="/me">/me</a>; this page is just a roomier view.
      </p>
      <p class="inv-page__where mono">
        wired into:
        <a href="/paddle-exchange">/paddle-exchange</a> ·
        <a href="/honey-league">/honey-league</a> ·
        <a href="/houseplants">/houseplants</a>
      </p>
    </header>

    {/* Stats strip — populated client-side. */}
    <section class="inv-page__stats" aria-label="Inventory stats">
      <dl class="inv-stats">
        <div class="inv-stats__cell"><dt id="inv-stat-total">0</dt><dd>items</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-cats">0</dt><dd>categories</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-paddles">0</dt><dd>paddles</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-since">—</dt><dd>oldest entry</dd></div>
      </dl>
    </section>

    {/* Quickstarts — visible only when inventory is empty. */}
    <section class="inv-page__quickstarts" id="inv-quickstarts" hidden>
      <p class="inv-page__eyebrow mono">QUICK START</p>
      <div class="inv-quickstart-grid">
        <button type="button" class="inv-quickstart-btn" data-quickstart="paddles">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> Pickleball paddles</span>
          <span class="inv-quickstart-btn__sub">11six24 Vapor 2 · Honolulu JNFK · Gearbox G2 Power · Vatic Prism 14mm</span>
        </button>
        <button type="button" class="inv-quickstart-btn" data-quickstart="houseplants">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> A few houseplants</span>
          <span class="inv-quickstart-btn__sub">Monstera deliciosa · Pothos · Snake plant</span>
        </button>
        <button type="button" class="inv-quickstart-btn" data-quickstart="drums">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> Drum kit basics</span>
          <span class="inv-quickstart-btn__sub">snare · kick · hi-hat · ride</span>
        </button>
      </div>
    </section>

    {/* Add-item form. */}
    <section class="inv-page__add" aria-label="Add an item">
      <p class="inv-page__eyebrow mono">ADD ITEM</p>
      <form class="inv-add" id="inv-add-form" autocomplete="off">
        <div class="inv-add__row">
          <label class="inv-field">
            <span class="inv-field__label mono">CATEGORY</span>
            <select class="inv-input" id="inv-add-category" required>
              <option value="paddles">paddles</option>
              <option value="drums">drums</option>
              <option value="wheels">wheels</option>
              <option value="plants">plants</option>
              <option value="tech">tech</option>
              <option value="books">books</option>
              <option value="other">other</option>
            </select>
          </label>
          <label class="inv-field">
            <span class="inv-field__label mono">BRAND</span>
            <input type="text" class="inv-input" id="inv-add-brand" placeholder="e.g. 11six24" maxlength="40" />
          </label>
          <label class="inv-field">
            <span class="inv-field__label mono">MODEL <em>(required)</em></span>
            <input type="text" class="inv-input" id="inv-add-model" placeholder="e.g. Vapor 2" maxlength="60" required />
          </label>
        </div>
        <div class="inv-add__row inv-add__row--bottom">
          <label class="inv-field inv-field--wide">
            <span class="inv-field__label mono">NOTES (OPTIONAL)</span>
            <input type="text" class="inv-input" id="inv-add-notes" placeholder="e.g. 14mm core, lead tape on neck, bought 2024" maxlength="200" />
          </label>
          <button type="submit" class="inv-add__submit mono">+ ADD</button>
        </div>
      </form>
    </section>

    {/* Items grouped by category. */}
    <section class="inv-page__items" aria-label="Items">
      <p class="inv-page__eyebrow mono">YOUR KIT</p>
      <div class="inv-groups" id="inv-groups">
        <p class="inv-empty">No items yet — add one above, or pick a quick-start.</p>
      </div>
    </section>

    {/* Foot. */}
    <footer class="inv-page__foot mono">
      <p>
        Stored only in this browser · localStorage key <code>pc:inventory:v1</code> ·
        <button type="button" class="inv-page__reset" id="inv-reset-btn">reset everything</button>
      </p>
      <p class="inv-page__foot-note">
        Items aren't shared anywhere unless you explicitly post them
        (e.g. into the <a href="/paddle-exchange">/paddle-exchange</a> form).
        Schema is forward-compatible so future server-sync stays opt-in.
      </p>
    </footer>

  </main>
</BlockLayout>

<script is:inline>
(() => {
  const KEY = 'pc:inventory:v1';
  const VERSION = 1;
  const CATEGORIES = ['paddles', 'drums', 'wheels', 'plants', 'tech', 'books', 'other'];
  const QUICKSTARTS = {
    paddles: [
      { brand: '11six24',  model: 'Vapor 2',     notes: '' },
      { brand: 'Honolulu', model: 'JNFK',        notes: '' },
      { brand: 'Gearbox',  model: 'G2 Power',    notes: '' },
      { brand: 'Vatic',    model: 'Prism 14mm',  notes: '' },
    ],
    houseplants: [
      { category: 'plants', brand: '', model: 'Monstera deliciosa', notes: '' },
      { category: 'plants', brand: '', model: 'Pothos',             notes: '' },
      { category: 'plants', brand: '', model: 'Snake plant',        notes: '' },
    ],
    drums: [
      { category: 'drums', brand: '', model: 'Snare',   notes: '' },
      { category: 'drums', brand: '', model: 'Kick',    notes: '' },
      { category: 'drums', brand: '', model: 'Hi-hat',  notes: '' },
      { category: 'drums', brand: '', model: 'Ride',    notes: '' },
    ],
  };

  function defaults() { return { $v: VERSION, items: [] }; }
  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object' || parsed.$v !== VERSION) return defaults();
      return Object.assign(defaults(), parsed, { $v: VERSION });
    } catch (e) { return defaults(); }
  }
  function save(inv) {
    try { localStorage.setItem(KEY, JSON.stringify(inv)); } catch (e) {}
  }
  function makeId() {
    return 'i-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6);
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }

  let inv = load();

  function add(item) {
    const norm = {
      id: makeId(),
      category: (item.category || 'other').toLowerCase(),
      brand: (item.brand || '').trim(),
      model: (item.model || '').trim(),
      notes: (item.notes || '').trim(),
      addedAt: new Date().toISOString(),
    };
    if (!norm.model) return false;
    inv.items.push(norm);
    save(inv);
    render();
    return true;
  }

  function remove(id) {
    inv.items = inv.items.filter(i => i.id !== id);
    save(inv);
    render();
  }

  function quickstart(kind) {
    const seeds = QUICKSTARTS[kind];
    if (!seeds || !seeds.length) return;
    const defaultCategory = kind === 'paddles' ? 'paddles' : (kind === 'drums' ? 'drums' : 'plants');
    for (const s of seeds) {
      add({
        category: s.category || defaultCategory,
        brand: s.brand,
        model: s.model,
        notes: s.notes,
      });
    }
  }

  function fmtRelativeAt(iso) {
    if (!iso) return '—';
    const t = new Date(iso);
    const days = Math.floor((Date.now() - t.getTime()) / 86400000);
    if (days <= 0) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 30) return days + 'd ago';
    return t.toISOString().slice(0, 10);
  }

  function renderStats() {
    const total = inv.items.length;
    const totalEl = document.getElementById('inv-stat-total');
    if (totalEl) totalEl.textContent = String(total);

    const catSet = new Set(inv.items.map(i => i.category));
    const catEl = document.getElementById('inv-stat-cats');
    if (catEl) catEl.textContent = String(catSet.size);

    const paddleEl = document.getElementById('inv-stat-paddles');
    if (paddleEl) paddleEl.textContent = String(inv.items.filter(i => i.category === 'paddles').length);

    const sinceEl = document.getElementById('inv-stat-since');
    if (sinceEl) {
      if (!inv.items.length) {
        sinceEl.textContent = '—';
      } else {
        const oldest = inv.items.reduce((min, i) => {
          if (!i.addedAt) return min;
          return !min || i.addedAt < min ? i.addedAt : min;
        }, '');
        sinceEl.textContent = fmtRelativeAt(oldest);
      }
    }
  }

  function renderGroups() {
    const root = document.getElementById('inv-groups');
    if (!root) return;
    if (!inv.items.length) {
      root.innerHTML = '<p class="inv-empty">No items yet — add one above, or pick a quick-start.</p>';
      return;
    }
    const byCat = {};
    for (const item of inv.items) {
      const c = item.category || 'other';
      if (!byCat[c]) byCat[c] = [];
      byCat[c].push(item);
    }
    const ordered = CATEGORIES.filter(c => byCat[c]);
    const others = Object.keys(byCat).filter(c => !CATEGORIES.includes(c)).sort();
    const cats = ordered.concat(others);

    let html = '';
    for (const cat of cats) {
      const items = byCat[cat];
      html += '<section class="inv-group">';
      html += '<header class="inv-group__head"><h2 class="inv-group__h mono">' + escapeHtml(cat) + '</h2>';
      html += '<span class="inv-group__count mono">' + items.length + '</span></header>';
      html += '<ul class="inv-group__list">';
      for (const item of items) {
        const display = item.brand
          ? '<span class="inv-row__brand">' + escapeHtml(item.brand) + '</span> <span class="inv-row__model">' + escapeHtml(item.model) + '</span>'
          : '<span class="inv-row__model">' + escapeHtml(item.model) + '</span>';
        html += '<li class="inv-row">';
        html += '<div class="inv-row__main">' + display;
        if (item.notes) html += '<p class="inv-row__notes">' + escapeHtml(item.notes) + '</p>';
        html += '<p class="inv-row__at mono">added ' + fmtRelativeAt(item.addedAt) + '</p>';
        html += '</div>';
        html += '<button type="button" class="inv-row__remove" data-remove="' + escapeHtml(item.id) + '" aria-label="Remove ' + escapeHtml(item.brand + ' ' + item.model) + '">×</button>';
        html += '</li>';
      }
      html += '</ul>';
      html += '</section>';
    }
    root.innerHTML = html;

    root.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => remove(btn.getAttribute('data-remove')));
    });
  }

  function render() {
    const quickstartsEl = document.getElementById('inv-quickstarts');
    if (quickstartsEl) quickstartsEl.hidden = inv.items.length > 0;
    renderStats();
    renderGroups();
  }

  // Form wiring.
  document.getElementById('inv-add-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const catEl = document.getElementById('inv-add-category');
    const brandEl = document.getElementById('inv-add-brand');
    const modelEl = document.getElementById('inv-add-model');
    const notesEl = document.getElementById('inv-add-notes');
    if (!modelEl?.value.trim()) {
      modelEl?.focus();
      return;
    }
    const ok = add({
      category: catEl?.value || 'other',
      brand: brandEl?.value || '',
      model: modelEl?.value || '',
      notes: notesEl?.value || '',
    });
    if (ok) {
      if (brandEl) brandEl.value = '';
      if (modelEl) modelEl.value = '';
      if (notesEl) notesEl.value = '';
      modelEl?.focus();
    }
  });

  document.querySelectorAll('[data-quickstart]').forEach(btn => {
    btn.addEventListener('click', () => {
      const kind = btn.getAttribute('data-quickstart');
      if (kind) quickstart(kind);
    });
  });

  document.getElementById('inv-reset-btn')?.addEventListener('click', () => {
    if (!confirm('Reset all inventory? This wipes pc:inventory:v1 — your /me state and pet are NOT touched.')) return;
    try { localStorage.removeItem(KEY); } catch (e) {}
    inv = load();
    save(inv);
    render();
  });

  render();
})();
</script>

<style>
  .inv-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 24px 20px 80px;
    font-family: var(--font-body);
  }

  /* HERO */
  .inv-page__hero { margin: 0 0 30px; padding-bottom: 22px; border-bottom: 1.5px solid var(--color-rule); }
  .inv-page__crumb {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.16em;
    color: var(--color-ink-soft); text-transform: uppercase;
    margin: 0 0 12px;
  }
  .inv-page__crumb a { color: var(--color-ink-soft); text-decoration: none; }
  .inv-page__crumb a:hover { color: var(--color-ink); }
  .inv-page__crumb span { margin: 0 6px; }
  .inv-page__kicker {
    font-size: 11px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase;
    margin: 0 0 12px;
  }
  .inv-page__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05; font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: var(--color-ink);
  }
  .inv-page__dek {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.3vw, 18px); line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 720px;
    margin: 0 0 14px;
  }
  .inv-page__dek code {
    background: var(--color-card);
    padding: 1px 6px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .inv-page__dek a { color: var(--color-warm); }
  .inv-page__where {
    font-size: 11px; letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .inv-page__where a {
    color: var(--color-warm);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    margin: 0 4px;
  }

  /* STATS */
  .inv-page__stats { margin: 0 0 30px; }
  .inv-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border: 1.5px solid var(--color-rule);
    border-radius: 3px;
    background: var(--color-card);
  }
  .inv-stats__cell {
    padding: 14px 16px;
    border-right: 1.5px solid var(--color-rule);
  }
  .inv-stats__cell:last-child { border-right: 0; }
  .inv-stats__cell dt {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .inv-stats__cell dd {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }

  /* SECTION HEADERS */
  .inv-page__eyebrow {
    font-size: 10px; letter-spacing: 0.18em;
    color: var(--color-warm); text-transform: uppercase;
    margin: 0 0 10px;
  }

  /* QUICKSTARTS */
  .inv-page__quickstarts {
    margin: 0 0 30px;
    padding: 18px 20px;
    background: #fbf7ee;
    border: 1px dashed var(--color-rule);
    border-radius: 3px;
  }
  .inv-quickstart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px;
  }
  .inv-quickstart-btn {
    text-align: left;
    padding: 12px 14px;
    background: #fff;
    border: 1.5px solid var(--color-rule);
    border-left: 3px solid var(--color-warm);
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
    color: var(--color-ink);
    transition: border-color 0.12s, transform 0.12s;
  }
  .inv-quickstart-btn:hover { border-color: var(--color-warm); transform: translateY(-1px); }
  .inv-quickstart-btn__h {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .inv-quickstart-btn__h .mono {
    color: var(--color-warm);
    margin-right: 4px;
  }
  .inv-quickstart-btn__sub {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
    line-height: 1.4;
  }

  /* ADD FORM */
  .inv-page__add { margin: 0 0 30px; }
  .inv-add__row {
    display: grid;
    grid-template-columns: 140px 1fr 1.5fr;
    gap: 12px;
    margin: 0 0 12px;
  }
  .inv-add__row--bottom { grid-template-columns: 1fr 110px; }
  .inv-field { display: flex; flex-direction: column; min-width: 0; }
  .inv-field__label {
    font-size: 9px; letter-spacing: 0.18em;
    color: var(--color-ink-soft); text-transform: uppercase;
    margin: 0 0 4px;
  }
  .inv-field__label em { font-style: normal; color: var(--color-warm); }
  .inv-input {
    width: 100%;
    padding: 9px 12px;
    background: #fff;
    border: 1.5px solid var(--color-rule); border-radius: 2px;
    font-family: inherit;
    font-size: 14px;
    color: var(--color-ink);
  }
  .inv-input:focus {
    outline: none;
    border-color: var(--color-warm);
  }
  .inv-add__submit {
    align-self: flex-end;
    padding: 10px 14px;
    background: var(--color-ink);
    color: #fff;
    border: 1.5px solid var(--color-ink);
    border-radius: 2px;
    font-size: 11px; letter-spacing: 0.16em;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.12s;
  }
  .inv-add__submit:hover {
    background: var(--color-warm);
    border-color: var(--color-warm);
  }

  /* GROUPS */
  .inv-page__items { margin: 0 0 36px; }
  .inv-empty {
    padding: 16px;
    background: var(--color-card);
    border: 1px dashed var(--color-rule);
    border-radius: 2px;
    color: var(--color-ink-soft);
    font-size: 14px;
    text-align: center;
    margin: 0;
  }

  .inv-group { margin: 0 0 22px; }
  .inv-group:last-child { margin-bottom: 0; }
  .inv-group__head {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 6px 0 8px;
    margin: 0 0 10px;
    border-bottom: 1.5px solid var(--color-ink);
  }
  .inv-group__h {
    font-size: 12px; letter-spacing: 0.2em; font-weight: 700;
    color: var(--color-ink); text-transform: uppercase;
    margin: 0;
  }
  .inv-group__count {
    font-size: 11px;
    color: var(--color-ink-soft);
    letter-spacing: 0.1em;
  }
  .inv-group__list { list-style: none; padding: 0; margin: 0; }

  .inv-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-warm);
    border-radius: 2px;
    margin: 0 0 6px;
  }
  .inv-row__main { min-width: 0; }
  .inv-row__brand {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.06em;
    color: var(--color-warm); font-weight: 700;
    text-transform: uppercase;
  }
  .inv-row__model {
    font-size: 15px;
    color: var(--color-ink);
    font-weight: 600;
    margin-left: 4px;
  }
  .inv-row__notes {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-ink-soft);
    margin: 4px 0 0;
  }
  .inv-row__at {
    font-size: 10px; letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    margin: 4px 0 0;
    text-transform: uppercase;
  }
  .inv-row__remove {
    align-self: center;
    width: 28px; height: 28px;
    background: transparent;
    border: 1px solid var(--color-rule); border-radius: 2px;
    color: var(--color-ink-soft);
    cursor: pointer;
    font-size: 16px; line-height: 1;
    transition: color 0.12s, border-color 0.12s;
  }
  .inv-row__remove:hover {
    color: #c0392b;
    border-color: #c0392b;
  }

  /* FOOT */
  .inv-page__foot {
    margin-top: 36px;
    padding-top: 16px;
    border-top: 1px solid var(--color-rule);
    font-size: 11px;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .inv-page__foot p { margin: 0 0 8px; }
  .inv-page__foot p:last-child { margin: 0; }
  .inv-page__foot code {
    background: var(--color-card);
    padding: 1px 4px;
    border-radius: 2px;
    font-size: 11px;
  }
  .inv-page__foot a {
    color: var(--color-warm);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .inv-page__reset {
    background: transparent;
    border: 0;
    border-bottom: 1px dashed currentColor;
    padding: 0;
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
