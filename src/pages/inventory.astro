---
/**
 * /inventory — real-life adventure inventory, backed by pc:inventory:v1.
 *
 * This is the fuller sibling of the /me INVENTORY band. It keeps the
 * existing localStorage key so older paddle/plant/drum entries continue
 * to appear, then layers in practical adventuring fields: where an item
 * lives, whether it is ready, and whether it is critical for a packout.
 */
import BlockLayout from '../layouts/BlockLayout.astro';

const title = 'Adventure Inventory · your local kit';
const description = 'A local-first real-life inventory for adventuring: gear, location, condition, critical items, and readiness. Stored only in this browser as pc:inventory:v1.';
---

<BlockLayout title={title} description={description}>
  <main class="inv-page">

    <header class="inv-page__hero">
      <p class="inv-page__crumb">
        <a href="/">home</a> <span aria-hidden="true">›</span>
        <a href="/me">me</a> <span aria-hidden="true">›</span>
        <span>inventory</span>
      </p>
      <p class="inv-page__kicker mono">REAL-LIFE INVENTORY · LOCAL TO THIS BROWSER</p>
      <h1 class="inv-page__title">Pack for the next outing.</h1>
      <p class="inv-page__dek">
        A practical kit log for the things you actually carry: water,
        layers, tools, lights, med supplies, food, books, paddles, wheels,
        plants, and odd little talismans. Same data as the INVENTORY band
        on <a href="/me">/me</a>, stored only as <code>pc:inventory:v1</code>.
      </p>
      <p class="inv-page__where mono">
        wired into:
        <a href="/paddle-exchange">/paddle-exchange</a> ·
        <a href="/honey-league">/honey-league</a> ·
        <a href="/houseplants">/houseplants</a>
      </p>
    </header>

    <section class="inv-page__stats" aria-label="Inventory stats">
      <dl class="inv-stats">
        <div class="inv-stats__cell"><dt id="inv-stat-total">0</dt><dd>items</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-score">0%</dt><dd>pack score</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-ready">0</dt><dd>ready</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-check">0</dt><dd>needs check</dd></div>
        <div class="inv-stats__cell"><dt id="inv-stat-critical">0</dt><dd>critical</dd></div>
      </dl>
    </section>

    <section class="inv-page__readiness" aria-label="Adventure readiness">
      <div class="inv-section-head">
        <p class="inv-page__eyebrow mono">ADVENTURE READINESS</p>
        <span class="inv-section-head__meta mono" id="inv-readiness-meta">0 / 6 essentials</span>
      </div>
      <div class="inv-readiness-grid" id="inv-readiness-grid">
        <p class="inv-empty">Add gear below to build a packout.</p>
      </div>
    </section>

    <section class="inv-page__quickstarts" id="inv-quickstarts" hidden>
      <p class="inv-page__eyebrow mono">QUICK START</p>
      <div class="inv-quickstart-grid">
        <button type="button" class="inv-quickstart-btn" data-quickstart="daypack">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> Day adventure kit</span>
          <span class="inv-quickstart-btn__sub">daypack · bottle · shell · headlamp · mini med · snack</span>
        </button>
        <button type="button" class="inv-quickstart-btn" data-quickstart="coastal">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> Coastal overnight</span>
          <span class="inv-quickstart-btn__sub">sleep layer · bivy · water filter · stove · dry bag</span>
        </button>
        <button type="button" class="inv-quickstart-btn" data-quickstart="repair">
          <span class="inv-quickstart-btn__h"><span class="mono">+</span> Repair pouch</span>
          <span class="inv-quickstart-btn__sub">multi-tool · tape · cord · lighter · battery bank</span>
        </button>
      </div>
    </section>

    <section class="inv-page__tools" aria-label="Local trip desk">
      <div class="inv-section-head">
        <p class="inv-page__eyebrow mono">LOCAL TRIP DESK</p>
        <span class="inv-section-head__meta mono" id="inv-trip-note">choose a mode</span>
      </div>
      <div class="inv-tool-grid">
        <label class="inv-field">
          <span class="inv-field__label mono">TRIP MODE</span>
          <select class="inv-input" id="inv-trip-mode">
            <option value="city">city wander</option>
            <option value="coast">coastal loop</option>
            <option value="trail">trail scout</option>
            <option value="overnight">overnight</option>
            <option value="pickleball">pickleball run</option>
            <option value="repair">repair errand</option>
          </select>
        </label>
        <label class="inv-field">
          <span class="inv-field__label mono">FIND</span>
          <input type="search" class="inv-input" id="inv-search" placeholder="filter gear, notes, places" />
        </label>
        <label class="inv-field">
          <span class="inv-field__label mono">SHOW</span>
          <select class="inv-input" id="inv-filter-status">
            <option value="all">all items</option>
            <option value="ready">ready / packed</option>
            <option value="check">needs check</option>
            <option value="critical">critical</option>
          </select>
        </label>
        <button type="button" class="inv-roll-btn mono" id="inv-roll-btn">ROLL OUTING</button>
      </div>
      <div class="inv-grab">
        <div class="inv-grab__copy">
          <p class="inv-grab__title" id="inv-grab-title">Grab list</p>
          <p class="inv-grab__text" id="inv-grab-list">Pick a mode or add gear to see what to grab.</p>
        </div>
        <div class="inv-grab__actions">
          <button type="button" class="inv-mini-btn mono" id="inv-pack-trip">PACK MODE</button>
          <button type="button" class="inv-mini-btn mono" id="inv-pack-critical">PACK CRITICAL</button>
          <button type="button" class="inv-mini-btn mono" id="inv-unpack-all">UNPACK</button>
          <button type="button" class="inv-mini-btn mono" id="inv-copy-list">COPY LIST</button>
          <button type="button" class="inv-mini-btn mono" id="inv-copy-missing">COPY MISSING</button>
        </div>
      </div>
      <p class="inv-tool-notice mono" id="inv-tool-notice" hidden role="status" aria-live="polite"></p>
    </section>

    <section class="inv-page__local" aria-label="Home base utility">
      <div class="inv-section-head">
        <p class="inv-page__eyebrow mono">HOME BASE</p>
        <span class="inv-section-head__meta mono" id="inv-local-meta">local utility</span>
      </div>
      <div class="inv-local-grid">
        <article class="inv-local-card">
          <p class="inv-local-card__k mono">AT HOME</p>
          <p class="inv-local-card__n" id="inv-local-home">0</p>
          <p class="inv-local-card__d">ready but not packed</p>
        </article>
        <article class="inv-local-card">
          <p class="inv-local-card__k mono">PACKED</p>
          <p class="inv-local-card__n" id="inv-local-packed">0</p>
          <p class="inv-local-card__d">currently marked out</p>
        </article>
        <article class="inv-local-card">
          <p class="inv-local-card__k mono">ACTION</p>
          <p class="inv-local-card__n" id="inv-local-action">0</p>
          <p class="inv-local-card__d">check, repair, or lent</p>
        </article>
        <article class="inv-local-map">
          <p class="inv-local-map__h mono">WHERE TO LOOK FIRST</p>
          <div class="inv-local-map__list" id="inv-location-list">
            <p class="inv-empty">Add item locations to build a local map.</p>
          </div>
        </article>
      </div>
      <label class="inv-field inv-field--note">
        <span class="inv-field__label mono">LOCAL NOTE</span>
        <textarea class="inv-input inv-note" id="inv-local-note" rows="3" maxlength="260" placeholder="door code, trailhead, errand route, or the one thing you will forget"></textarea>
      </label>
    </section>

    <section class="inv-page__add" aria-label="Add an item">
      <p class="inv-page__eyebrow mono">ADD ITEM</p>
      <form class="inv-add" id="inv-add-form" autocomplete="off">
        <div class="inv-add__row">
          <label class="inv-field">
            <span class="inv-field__label mono">CATEGORY</span>
            <select class="inv-input" id="inv-add-category" required>
              <option value="carry">carry</option>
              <option value="water">water</option>
              <option value="food">food</option>
              <option value="layers">layers</option>
              <option value="shelter">shelter</option>
              <option value="navigation">navigation</option>
              <option value="med">med</option>
              <option value="light">light</option>
              <option value="tools">tools</option>
              <option value="power">power</option>
              <option value="wheels">wheels</option>
              <option value="paddles">paddles</option>
              <option value="plants">plants</option>
              <option value="books">books</option>
              <option value="drums">drums</option>
              <option value="other">other</option>
            </select>
          </label>
          <label class="inv-field">
            <span class="inv-field__label mono">MAKER / BRAND</span>
            <input type="text" class="inv-input" id="inv-add-brand" placeholder="e.g. Patagonia" maxlength="40" />
          </label>
          <label class="inv-field">
            <span class="inv-field__label mono">ITEM <em>(required)</em></span>
            <input type="text" class="inv-input" id="inv-add-model" placeholder="e.g. Houdini shell" maxlength="70" required />
          </label>
        </div>
        <div class="inv-add__row inv-add__row--gear">
          <label class="inv-field">
            <span class="inv-field__label mono">WHERE</span>
            <input type="text" class="inv-input" id="inv-add-where" placeholder="e.g. hall closet" maxlength="60" />
          </label>
          <label class="inv-field">
            <span class="inv-field__label mono">STATUS</span>
            <select class="inv-input" id="inv-add-status">
              <option value="ready">ready</option>
              <option value="packed">packed</option>
              <option value="check">needs check</option>
              <option value="repair">repair</option>
              <option value="lent">lent out</option>
            </select>
          </label>
          <label class="inv-critical">
            <input type="checkbox" id="inv-add-critical" />
            <span>
              <strong>Critical</strong>
              <small>belongs in the real pack</small>
            </span>
          </label>
        </div>
        <div class="inv-add__row inv-add__row--bottom">
          <label class="inv-field inv-field--wide">
            <span class="inv-field__label mono">NOTES</span>
            <input type="text" class="inv-input" id="inv-add-notes" placeholder="e.g. recharge before leaving, 1L, in dry bag" maxlength="220" />
          </label>
          <button type="submit" class="inv-add__submit mono">+ ADD</button>
        </div>
      </form>
    </section>

    <section class="inv-page__items" aria-label="Items">
      <div class="inv-section-head">
        <p class="inv-page__eyebrow mono">YOUR KIT</p>
        <span class="inv-section-head__meta mono" id="inv-kit-meta">empty</span>
      </div>
      <div class="inv-groups" id="inv-groups">
        <p class="inv-empty">No items yet - add one above, or pick a quick-start.</p>
      </div>
    </section>

    <footer class="inv-page__foot mono">
      <p>
        Stored only in this browser · localStorage key <code>pc:inventory:v1</code> ·
        <button type="button" class="inv-page__reset" id="inv-reset-btn">reset everything</button>
      </p>
      <p class="inv-page__foot-note">
        Extra adventure fields are optional. Older paddle, plant, and drum
        items still load cleanly; future sync can stay opt-in.
      </p>
    </footer>

  </main>
</BlockLayout>

<script is:inline>
(() => {
  const KEY = 'pc:inventory:v1';
  const PREF_KEY = 'pc:inventory:prefs:v1';
  const VERSION = 1;
  const CATEGORIES = [
    'carry', 'water', 'food', 'layers', 'shelter', 'navigation', 'med',
    'light', 'tools', 'power', 'tech', 'wheels', 'paddles', 'plants',
    'books', 'drums', 'other',
  ];
  const CATEGORY_LABELS = {
    carry: 'carry',
    water: 'water',
    food: 'food',
    layers: 'layers',
    shelter: 'shelter',
    navigation: 'navigation',
    med: 'med',
    light: 'light',
    tools: 'tools',
    power: 'power',
    tech: 'tech',
    wheels: 'wheels',
    paddles: 'paddles',
    plants: 'plants',
    books: 'books',
    drums: 'drums',
    other: 'other',
  };
  const STATUS_LABELS = {
    ready: 'ready',
    packed: 'packed',
    check: 'needs check',
    repair: 'repair',
    lent: 'lent out',
  };
  const ESSENTIALS = [
    { key: 'water', label: 'water', cats: ['water'], terms: ['bottle', 'filter', 'hydration', 'water'] },
    { key: 'layers', label: 'layer', cats: ['layers'], terms: ['shell', 'jacket', 'fleece', 'layer', 'beanie'] },
    { key: 'light', label: 'light', cats: ['light'], terms: ['headlamp', 'lamp', 'flashlight', 'lantern'] },
    { key: 'med', label: 'med', cats: ['med'], terms: ['med', 'first aid', 'bandage', 'blister'] },
    { key: 'navigation', label: 'nav', cats: ['navigation'], terms: ['map', 'compass', 'gps', 'route'] },
    { key: 'food', label: 'food', cats: ['food'], terms: ['snack', 'food', 'bar', 'meal'] },
  ];
  const QUICKSTARTS = {
    daypack: [
      { category: 'carry', model: 'Daypack', where: 'front closet', status: 'ready', critical: true, notes: '18-25L, room for layers' },
      { category: 'water', model: 'Water bottle', where: 'kitchen shelf', status: 'ready', critical: true, notes: '1L minimum' },
      { category: 'layers', model: 'Wind shell', where: 'hall closet', status: 'ready', critical: true, notes: 'packs down small' },
      { category: 'light', model: 'Headlamp', where: 'top drawer', status: 'check', critical: true, notes: 'check batteries' },
      { category: 'med', model: 'Mini med pouch', where: 'daypack', status: 'ready', critical: true, notes: 'blister care, tape, ibuprofen' },
      { category: 'food', model: 'Pocket snack', where: 'pantry', status: 'ready', critical: false, notes: 'bar, nuts, or dried fruit' },
    ],
    coastal: [
      { category: 'shelter', model: 'Bivy / sleep cover', where: 'gear bin', status: 'check', critical: true, notes: 'air out before packing' },
      { category: 'water', model: 'Water filter', where: 'camp box', status: 'ready', critical: true, notes: 'backflush after use' },
      { category: 'food', model: 'Stove + fuel', where: 'camp box', status: 'check', critical: true, notes: 'weigh canister' },
      { category: 'layers', model: 'Warm layer', where: 'hall closet', status: 'ready', critical: true, notes: 'marine layer insurance' },
      { category: 'carry', model: 'Dry bag', where: 'gear bin', status: 'ready', critical: false, notes: 'electronics and socks' },
    ],
    repair: [
      { category: 'tools', model: 'Multi-tool', where: 'repair pouch', status: 'ready', critical: true, notes: 'knife, pliers, driver' },
      { category: 'tools', model: 'Tape wrap', where: 'repair pouch', status: 'ready', critical: true, notes: 'duct or tenacious tape' },
      { category: 'tools', model: 'Paracord', where: 'repair pouch', status: 'ready', critical: false, notes: '10-20 ft' },
      { category: 'light', model: 'Lighter', where: 'repair pouch', status: 'check', critical: false, notes: 'test spark' },
      { category: 'power', model: 'Battery bank', where: 'desk drawer', status: 'check', critical: false, notes: 'charge to full' },
    ],
  };
  const TRIPS = {
    city: {
      label: 'city wander',
      prompt: 'walkable errands, one good bench, one curious detour',
      wants: ['water', 'layers', 'power', 'books'],
    },
    coast: {
      label: 'coastal loop',
      prompt: 'wind, salt, snack, sunset buffer',
      wants: ['water', 'layers', 'food', 'light'],
    },
    trail: {
      label: 'trail scout',
      prompt: 'small route, bigger sky, no heroic nonsense',
      wants: ['water', 'navigation', 'med', 'layers', 'food', 'light'],
    },
    overnight: {
      label: 'overnight',
      prompt: 'warmth, shelter, food, light, backup plans',
      wants: ['shelter', 'water', 'food', 'layers', 'light', 'med'],
    },
    pickleball: {
      label: 'pickleball run',
      prompt: 'paddle, water, towel, weird confidence',
      wants: ['paddles', 'water', 'food', 'layers'],
    },
    repair: {
      label: 'repair errand',
      prompt: 'fix one thing, leave the place better',
      wants: ['tools', 'power', 'light'],
    },
  };

  function defaults() { return { $v: VERSION, items: [] }; }
  function prefDefaults() { return { $v: 1, tripMode: 'city', search: '', filterStatus: 'all', note: '' }; }
  function loadPrefs() {
    try {
      const raw = localStorage.getItem(PREF_KEY);
      if (!raw) return prefDefaults();
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return prefDefaults();
      return Object.assign(prefDefaults(), parsed, { $v: 1 });
    } catch (e) { return prefDefaults(); }
  }
  function savePrefs() {
    try { localStorage.setItem(PREF_KEY, JSON.stringify(prefs)); } catch (e) {}
  }
  function normalizeStatus(status) {
    return STATUS_LABELS[status] ? status : 'ready';
  }
  function normalizeItem(item) {
    const category = String(item?.category || 'other').toLowerCase();
    return {
      id: item?.id || makeId(),
      category,
      brand: String(item?.brand || '').trim(),
      model: String(item?.model || '').trim(),
      notes: String(item?.notes || '').trim(),
      where: String(item?.where || item?.location || '').trim(),
      status: normalizeStatus(item?.status),
      critical: Boolean(item?.critical),
      addedAt: item?.addedAt || new Date().toISOString(),
    };
  }
  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return defaults();
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object' || parsed.$v !== VERSION) return defaults();
      const items = Array.isArray(parsed.items) ? parsed.items.map(normalizeItem).filter(i => i.model) : [];
      return Object.assign(defaults(), parsed, { $v: VERSION, items });
    } catch (e) { return defaults(); }
  }
  function save(next) {
    try { localStorage.setItem(KEY, JSON.stringify(next)); } catch (e) {}
  }
  function makeId() {
    return 'i-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6);
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c]));
  }
  function labelCategory(cat) {
    return CATEGORY_LABELS[cat] || cat || 'other';
  }
  function isReady(item) {
    return item.status === 'ready' || item.status === 'packed';
  }
  function statusLabel(item) {
    return STATUS_LABELS[item.status] || item.status || 'ready';
  }
  function itemName(item) {
    return (item.brand ? item.brand + ' ' : '') + item.model;
  }

  let inv = load();
  let prefs = loadPrefs();

  function add(item) {
    const norm = normalizeItem(Object.assign({}, item, { id: makeId(), addedAt: new Date().toISOString() }));
    if (!norm.model) return false;
    inv.items.push(norm);
    save(inv);
    render();
    return true;
  }
  function remove(id) {
    inv.items = inv.items.filter(i => i.id !== id);
    save(inv);
    render();
  }
  function quickstart(kind) {
    const seeds = QUICKSTARTS[kind];
    if (!seeds || !seeds.length) return;
    for (const s of seeds) add(s);
  }
  function setStatus(id, status) {
    const nextStatus = normalizeStatus(status);
    const item = inv.items.find(i => i.id === id);
    if (!item) return;
    item.status = nextStatus;
    save(inv);
    render();
  }
  function packCritical() {
    let changed = 0;
    for (const item of inv.items) {
      if (!item.critical || item.status === 'packed' || item.status === 'repair' || item.status === 'lent') continue;
      item.status = 'packed';
      changed++;
    }
    if (changed) {
      save(inv);
      render();
    }
    showNotice(changed ? 'Packed ' + changed + ' critical item' + (changed === 1 ? '' : 's') + '.' : 'No unpacked critical items ready to pack.');
  }
  function unpackAll() {
    let changed = 0;
    for (const item of inv.items) {
      if (item.status !== 'packed') continue;
      item.status = 'ready';
      changed++;
    }
    if (changed) {
      save(inv);
      render();
    }
    showNotice(changed ? 'Unpacked ' + changed + ' item' + (changed === 1 ? '' : 's') + '.' : 'Nothing is marked packed.');
  }
  function fmtRelativeAt(iso) {
    if (!iso) return 'unknown';
    const t = new Date(iso);
    const days = Math.floor((Date.now() - t.getTime()) / 86400000);
    if (Number.isNaN(days)) return 'unknown';
    if (days <= 0) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 30) return days + 'd ago';
    return t.toISOString().slice(0, 10);
  }
  function matchesEssential(item, essential) {
    if (essential.cats.includes(item.category)) return true;
    const hay = (item.model + ' ' + item.brand + ' ' + item.notes).toLowerCase();
    return essential.terms.some(term => hay.includes(term));
  }
  function essentialMatches(essential) {
    return inv.items.filter(item => matchesEssential(item, essential));
  }
  function readinessScore() {
    const covered = ESSENTIALS.filter(e => essentialMatches(e).some(isReady)).length;
    return { covered, total: ESSENTIALS.length, pct: Math.round((covered / ESSENTIALS.length) * 100) };
  }
  function itemText(item) {
    return [
      item.category, item.brand, item.model, item.notes, item.where, statusLabel(item),
      item.critical ? 'critical' : '',
    ].join(' ').toLowerCase();
  }
  function visibleItems() {
    const q = String(prefs.search || '').trim().toLowerCase();
    return inv.items.filter(item => {
      if (q && !itemText(item).includes(q)) return false;
      if (prefs.filterStatus === 'ready' && !isReady(item)) return false;
      if (prefs.filterStatus === 'check' && isReady(item)) return false;
      if (prefs.filterStatus === 'critical' && !item.critical) return false;
      return true;
    });
  }
  function bestForCategory(category) {
    const matches = inv.items.filter(item => item.category === category);
    return matches.find(isReady) || matches[0] || null;
  }
  function itemsForTrip() {
    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    const used = new Set();
    const items = [];
    for (const category of trip.wants) {
      const item = bestForCategory(category);
      if (!item || used.has(item.id)) continue;
      used.add(item.id);
      items.push(item);
    }
    return items;
  }
  function missingForTrip() {
    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    return trip.wants.filter(category => !bestForCategory(category)).map(labelCategory);
  }
  function packTrip() {
    let changed = 0;
    for (const item of itemsForTrip()) {
      if (item.status === 'packed' || item.status === 'repair' || item.status === 'lent') continue;
      item.status = 'packed';
      changed++;
    }
    if (changed) {
      save(inv);
      render();
    }
    showNotice(changed ? 'Packed ' + changed + ' item' + (changed === 1 ? '' : 's') + ' for this mode.' : 'Nothing new to pack for this mode.');
  }
  function missingListText() {
    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    const missing = missingForTrip();
    return [
      'PointCast missing list: ' + trip.label,
      missing.length ? missing.map(item => '- ' + item).join('\n') : 'Nothing missing for this mode.',
    ].join('\n');
  }
  function locationKey(item) {
    if (item.status === 'packed') return 'packed / with you';
    if (item.status === 'lent') return 'lent out';
    return item.where || 'unsorted';
  }
  function locationSummary() {
    const byPlace = {};
    for (const item of inv.items) {
      const key = locationKey(item);
      if (!byPlace[key]) byPlace[key] = { place: key, count: 0, critical: 0, check: 0 };
      byPlace[key].count++;
      if (item.critical) byPlace[key].critical++;
      if (!isReady(item)) byPlace[key].check++;
    }
    return Object.values(byPlace).sort((a, b) => {
      if (b.critical !== a.critical) return b.critical - a.critical;
      return b.count - a.count;
    }).slice(0, 6);
  }
  function buildGrabList() {
    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    const lines = [];
    for (const category of trip.wants) {
      const item = bestForCategory(category);
      if (!item) {
        lines.push('missing: ' + labelCategory(category));
        continue;
      }
      const prefix = isReady(item) ? 'grab' : 'check';
      const place = item.where ? ' @ ' + item.where : '';
      lines.push(prefix + ': ' + itemName(item) + place);
    }
    const unreadyCritical = inv.items.filter(item => item.critical && !isReady(item));
    for (const item of unreadyCritical) {
      lines.push('critical check: ' + itemName(item));
    }
    return lines;
  }
  function grabListText() {
    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    return [
      'PointCast packout: ' + trip.label,
      trip.prompt,
      '',
      ...buildGrabList(),
    ].join('\n');
  }
  function showNotice(text) {
    const el = document.getElementById('inv-tool-notice');
    if (!el) return;
    el.hidden = false;
    el.textContent = text;
    clearTimeout(showNotice._t);
    showNotice._t = setTimeout(() => { el.hidden = true; }, 2400);
  }

  function renderStats() {
    const total = inv.items.length;
    const ready = inv.items.filter(isReady).length;
    const check = inv.items.filter(i => !isReady(i)).length;
    const critical = inv.items.filter(i => i.critical).length;
    const score = readinessScore();
    const visible = visibleItems().length;

    const statMap = {
      'inv-stat-total': String(total),
      'inv-stat-score': score.pct + '%',
      'inv-stat-ready': String(ready),
      'inv-stat-check': String(check),
      'inv-stat-critical': String(critical),
      'inv-readiness-meta': score.covered + ' / ' + score.total + ' essentials',
      'inv-kit-meta': total ? visible + ' shown / ' + total + ' total' : 'empty',
    };
    Object.entries(statMap).forEach(([id, value]) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    });
  }

  function renderReadiness() {
    const root = document.getElementById('inv-readiness-grid');
    if (!root) return;
    let html = '';
    for (const essential of ESSENTIALS) {
      const matches = essentialMatches(essential);
      const ready = matches.filter(isReady);
      const best = ready[0] || matches[0];
      const state = ready.length ? 'ready' : (matches.length ? 'check' : 'missing');
      const label = state === 'ready' ? 'ready' : (state === 'check' ? 'check' : 'missing');
      const detail = best ? ((best.brand ? best.brand + ' ' : '') + best.model) : 'not packed yet';
      html += '<article class="inv-ready inv-ready--' + state + '">';
      html += '<span class="inv-ready__dot" aria-hidden="true"></span>';
      html += '<div><h2 class="inv-ready__h mono">' + escapeHtml(essential.label) + '</h2>';
      html += '<p class="inv-ready__detail">' + escapeHtml(detail) + '</p></div>';
      html += '<span class="inv-ready__state mono">' + escapeHtml(label) + '</span>';
      html += '</article>';
    }
    root.innerHTML = html;
  }
  function renderTripDesk() {
    const modeEl = document.getElementById('inv-trip-mode');
    const searchEl = document.getElementById('inv-search');
    const filterEl = document.getElementById('inv-filter-status');
    if (modeEl && modeEl.value !== prefs.tripMode) modeEl.value = prefs.tripMode;
    if (searchEl && searchEl.value !== prefs.search) searchEl.value = prefs.search;
    if (filterEl && filterEl.value !== prefs.filterStatus) filterEl.value = prefs.filterStatus;

    const trip = TRIPS[prefs.tripMode] || TRIPS.city;
    const noteEl = document.getElementById('inv-trip-note');
    if (noteEl) noteEl.textContent = trip.prompt;
    const titleEl = document.getElementById('inv-grab-title');
    if (titleEl) titleEl.textContent = 'Grab list: ' + trip.label;
    const listEl = document.getElementById('inv-grab-list');
    if (listEl) {
      const lines = buildGrabList();
      listEl.innerHTML = lines.length
        ? lines.map(line => '<span>' + escapeHtml(line) + '</span>').join('')
        : 'Add gear below to make a grab list.';
    }
  }
  function renderHomeBase() {
    const home = inv.items.filter(item => isReady(item) && item.status !== 'packed');
    const packed = inv.items.filter(item => item.status === 'packed');
    const action = inv.items.filter(item => !isReady(item));
    const statMap = {
      'inv-local-home': String(home.length),
      'inv-local-packed': String(packed.length),
      'inv-local-action': String(action.length),
      'inv-local-meta': inv.items.length ? locationSummary().length + ' places tracked' : 'local utility',
    };
    Object.entries(statMap).forEach(([id, value]) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    });

    const noteEl = document.getElementById('inv-local-note');
    if (noteEl && noteEl.value !== prefs.note) noteEl.value = prefs.note || '';

    const listEl = document.getElementById('inv-location-list');
    if (!listEl) return;
    const places = locationSummary();
    if (!places.length) {
      listEl.innerHTML = '<p class="inv-empty">Add item locations to build a local map.</p>';
      return;
    }
    listEl.innerHTML = places.map(place => {
      const flags = [];
      if (place.critical) flags.push(place.critical + ' critical');
      if (place.check) flags.push(place.check + ' check');
      return '<div class="inv-local-place">'
        + '<span class="inv-local-place__name">' + escapeHtml(place.place) + '</span>'
        + '<span class="inv-local-place__count mono">' + place.count + '</span>'
        + (flags.length ? '<span class="inv-local-place__flags mono">' + escapeHtml(flags.join(' · ')) + '</span>' : '')
        + '</div>';
    }).join('');
  }

  function renderGroups() {
    const root = document.getElementById('inv-groups');
    if (!root) return;
    const itemsForView = visibleItems();
    if (!inv.items.length) {
      root.innerHTML = '<p class="inv-empty">No items yet - add one above, or pick a quick-start.</p>';
      return;
    }
    if (!itemsForView.length) {
      root.innerHTML = '<p class="inv-empty">No matches. Clear the search or change the filter.</p>';
      return;
    }
    const byCat = {};
    for (const item of itemsForView) {
      const c = item.category || 'other';
      if (!byCat[c]) byCat[c] = [];
      byCat[c].push(item);
    }
    const ordered = CATEGORIES.filter(c => byCat[c]);
    const others = Object.keys(byCat).filter(c => !CATEGORIES.includes(c)).sort();
    const cats = ordered.concat(others);

    let html = '';
    for (const cat of cats) {
      const items = byCat[cat];
      html += '<section class="inv-group">';
      html += '<header class="inv-group__head"><h2 class="inv-group__h mono">' + escapeHtml(labelCategory(cat)) + '</h2>';
      html += '<span class="inv-group__count mono">' + items.length + '</span></header>';
      html += '<ul class="inv-group__list">';
      for (const item of items) {
        const display = item.brand
          ? '<span class="inv-row__brand">' + escapeHtml(item.brand) + '</span> <span class="inv-row__model">' + escapeHtml(item.model) + '</span>'
          : '<span class="inv-row__model">' + escapeHtml(item.model) + '</span>';
        html += '<li class="inv-row inv-row--' + escapeHtml(item.status) + '">';
        html += '<div class="inv-row__main">' + display;
        html += '<div class="inv-row__meta">';
        html += '<span class="inv-row__pill mono">' + escapeHtml(statusLabel(item)) + '</span>';
        if (item.where) html += '<span class="inv-row__pill inv-row__pill--where mono">' + escapeHtml(item.where) + '</span>';
        if (item.critical) html += '<span class="inv-row__pill inv-row__pill--critical mono">critical</span>';
        html += '</div>';
        if (item.notes) html += '<p class="inv-row__notes">' + escapeHtml(item.notes) + '</p>';
        html += '<p class="inv-row__at mono">added ' + fmtRelativeAt(item.addedAt) + '</p>';
        html += '</div>';
        html += '<div class="inv-row__actions">';
        html += '<button type="button" class="inv-row__status mono" data-status="' + escapeHtml(item.status === 'packed' ? 'ready' : 'packed') + '" data-id="' + escapeHtml(item.id) + '">' + (item.status === 'packed' ? 'READY' : 'PACK') + '</button>';
        html += '<button type="button" class="inv-row__status mono" data-status="check" data-id="' + escapeHtml(item.id) + '">CHECK</button>';
        html += '<button type="button" class="inv-row__remove" data-remove="' + escapeHtml(item.id) + '" aria-label="Remove ' + escapeHtml((item.brand + ' ' + item.model).trim()) + '">×</button>';
        html += '</div>';
        html += '</li>';
      }
      html += '</ul>';
      html += '</section>';
    }
    root.innerHTML = html;

    root.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => remove(btn.getAttribute('data-remove')));
    });
    root.querySelectorAll('[data-status]').forEach(btn => {
      btn.addEventListener('click', () => setStatus(btn.getAttribute('data-id'), btn.getAttribute('data-status')));
    });
  }

  function render() {
    const quickstartsEl = document.getElementById('inv-quickstarts');
    if (quickstartsEl) quickstartsEl.hidden = inv.items.length > 0;
    renderStats();
    renderReadiness();
    renderTripDesk();
    renderHomeBase();
    renderGroups();
  }

  document.getElementById('inv-add-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const catEl = document.getElementById('inv-add-category');
    const brandEl = document.getElementById('inv-add-brand');
    const modelEl = document.getElementById('inv-add-model');
    const whereEl = document.getElementById('inv-add-where');
    const statusEl = document.getElementById('inv-add-status');
    const criticalEl = document.getElementById('inv-add-critical');
    const notesEl = document.getElementById('inv-add-notes');
    if (!modelEl?.value.trim()) {
      modelEl?.focus();
      return;
    }
    const ok = add({
      category: catEl?.value || 'other',
      brand: brandEl?.value || '',
      model: modelEl?.value || '',
      where: whereEl?.value || '',
      status: statusEl?.value || 'ready',
      critical: Boolean(criticalEl?.checked),
      notes: notesEl?.value || '',
    });
    if (ok) {
      if (brandEl) brandEl.value = '';
      if (modelEl) modelEl.value = '';
      if (whereEl) whereEl.value = '';
      if (statusEl) statusEl.value = 'ready';
      if (criticalEl) criticalEl.checked = false;
      if (notesEl) notesEl.value = '';
      modelEl?.focus();
    }
  });

  document.querySelectorAll('[data-quickstart]').forEach(btn => {
    btn.addEventListener('click', () => {
      const kind = btn.getAttribute('data-quickstart');
      if (kind) quickstart(kind);
    });
  });

  document.getElementById('inv-trip-mode')?.addEventListener('change', (e) => {
    prefs.tripMode = e.target.value in TRIPS ? e.target.value : 'city';
    savePrefs();
    render();
  });

  document.getElementById('inv-search')?.addEventListener('input', (e) => {
    prefs.search = e.target.value || '';
    savePrefs();
    render();
  });

  document.getElementById('inv-filter-status')?.addEventListener('change', (e) => {
    prefs.filterStatus = e.target.value || 'all';
    savePrefs();
    render();
  });

  document.getElementById('inv-roll-btn')?.addEventListener('click', () => {
    const keys = Object.keys(TRIPS);
    prefs.tripMode = keys[Math.floor(Math.random() * keys.length)] || 'city';
    prefs.search = '';
    prefs.filterStatus = 'all';
    savePrefs();
    render();
    showNotice('Rolled: ' + (TRIPS[prefs.tripMode]?.label || 'city wander') + '.');
  });

  document.getElementById('inv-pack-trip')?.addEventListener('click', packTrip);
  document.getElementById('inv-pack-critical')?.addEventListener('click', packCritical);
  document.getElementById('inv-unpack-all')?.addEventListener('click', unpackAll);
  document.getElementById('inv-copy-list')?.addEventListener('click', async () => {
    const text = grabListText();
    try {
      await navigator.clipboard.writeText(text);
      showNotice('Grab list copied.');
    } catch (e) {
      showNotice('Copy blocked by browser. The grab list is still visible above.');
    }
  });
  document.getElementById('inv-copy-missing')?.addEventListener('click', async () => {
    const text = missingListText();
    try {
      await navigator.clipboard.writeText(text);
      showNotice('Missing list copied.');
    } catch (e) {
      showNotice('Copy blocked by browser. Missing items are still visible in the grab list.');
    }
  });
  document.getElementById('inv-local-note')?.addEventListener('input', (e) => {
    prefs.note = e.target.value || '';
    savePrefs();
  });

  document.getElementById('inv-reset-btn')?.addEventListener('click', () => {
    if (!confirm('Reset all inventory? This wipes pc:inventory:v1 - your /me state and pet are not touched.')) return;
    try { localStorage.removeItem(KEY); } catch (e) {}
    try { localStorage.removeItem(PREF_KEY); } catch (e) {}
    inv = load();
    prefs = loadPrefs();
    save(inv);
    render();
  });

  render();
})();
</script>

