---
import BlockLayout from '../layouts/BlockLayout.astro';
import { CADENCE, CHARTER_META, CHARTER_NOTES, COMPOSITION, CONFLICT_RESOLUTION, DECISION_PROTOCOL, DISSOLUTION, PUBLIC_RECORD, PURPOSE, RATIFICATION, REFERENCES, SCOPE_OUT } from '../lib/federationCouncil';
const title = `${CHARTER_META.title} — ${CHARTER_META.subtitle}`;
const description = CHARTER_META.thesis;
const jsonLd = { '@context': 'https://schema.org', '@type': 'TechArticle', '@id': 'https://pointcast.xyz/federation-council', name: CHARTER_META.title, description, url: 'https://pointcast.xyz/federation-council', datePublished: CHARTER_META.date, isPartOf: { '@type': 'EducationalOrganization', name: 'University of El Segundo' } };
---
<BlockLayout title={title} description={description} jsonLd={jsonLd}
  alternates={[{ type: 'application/json', href: '/federation-council.json', title: 'Federation Council Charter (JSON)' }]}>
  <div class="charter">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/coordinate">coordinate</a><span aria-hidden="true">/</span><a href="/strand-corridor">strand-corridor</a><span aria-hidden="true">/</span><span>federation-council</span></nav>

    <header class="hero">
      <div class="hero__bar"></div>
      <p class="kicker">{CHARTER_META.paperNumber} · CHARTER · {CHARTER_META.status}</p>
      <h1>FEDERATION / COUNCIL.</h1>
      <p class="subtitle">{CHARTER_META.subtitle}</p>
      <p class="thesis">{CHARTER_META.thesis}</p>
    </header>

    <section class="purpose"><p class="kicker">PURPOSE</p><h2>Why a council, why a small one.</h2>
      <p class="block"><strong>Why:</strong> {PURPOSE.why}</p>
      <p class="block"><strong>Why not more:</strong> {PURPOSE.whyNotMore}</p>
      <p class="block"><strong>What it does:</strong> {PURPOSE.whatItDoes}</p>
    </section>

    <section class="comp"><p class="kicker">COMPOSITION</p><h2>Who sits at the table.</h2>
      <dl class="dl">
        <div><dt>Voting delegates</dt><dd>{COMPOSITION.delegates}</dd></div>
        <div><dt>Selection</dt><dd>{COMPOSITION.selection}</dd></div>
        <div><dt>Term length</dt><dd>{COMPOSITION.termLength}</dd></div>
        <div><dt>Topic-coded specialists</dt><dd>{COMPOSITION.topicCodedSpecialists}</dd></div>
        <div><dt>Observer seats</dt><dd>{COMPOSITION.observerSeats}</dd></div>
        <div><dt>Chair</dt><dd>{COMPOSITION.chair}</dd></div>
      </dl>
    </section>

    <section class="cad"><p class="kicker">CADENCE</p><h2>When it meets.</h2>
      <dl class="dl">
        <div><dt>Primary</dt><dd>{CADENCE.primary}</dd></div>
        <div><dt>Secondary</dt><dd>{CADENCE.secondary}</dd></div>
        <div><dt>Emergency</dt><dd>{CADENCE.emergency}</dd></div>
        <div><dt>Meeting duration</dt><dd>{CADENCE.meetingDuration}</dd></div>
      </dl>
    </section>

    <section class="dec"><p class="kicker">DECISION PROTOCOL · 8 BANDS</p><h2>Thresholds and examples.</h2>
      <ol class="dec-list">{DECISION_PROTOCOL.map((d) => (
        <li>
          <h3>{d.decision}</h3>
          <p class="thr"><strong>Threshold:</strong> {d.threshold}</p>
          <p class="ex"><strong>Examples:</strong> {d.examples}</p>
        </li>
      ))}</ol>
    </section>

    <section class="out"><p class="kicker">SCOPE OUT · 7</p><h2>What the council does NOT decide.</h2>
      <ul class="out-list">{SCOPE_OUT.map((s) => (<li>{s}</li>))}</ul>
    </section>

    <section class="conf"><p class="kicker">CONFLICT RESOLUTION</p><h2>When delegates disagree.</h2>
      <dl class="dl">
        <div><dt>Between instances</dt><dd>{CONFLICT_RESOLUTION.betweenInstances}</dd></div>
        <div><dt>Between instance and council</dt><dd>{CONFLICT_RESOLUTION.betweenInstanceAndCouncil}</dd></div>
        <div><dt>With external party</dt><dd>{CONFLICT_RESOLUTION.withExternalParty}</dd></div>
        <div><dt>Emergency agenda</dt><dd>{CONFLICT_RESOLUTION.emergencyAgenda}</dd></div>
      </dl>
    </section>

    <section class="rec"><p class="kicker">PUBLIC RECORD</p><h2>The council operates in the open.</h2>
      <dl class="dl">
        <div><dt>Minutes</dt><dd>{PUBLIC_RECORD.minutes}</dd></div>
        <div><dt>Votes</dt><dd>{PUBLIC_RECORD.votes}</dd></div>
        <div><dt>Observer notes</dt><dd>{PUBLIC_RECORD.observerNotes}</dd></div>
        <div><dt>Public access</dt><dd>{PUBLIC_RECORD.publicAccess}</dd></div>
      </dl>
    </section>

    <section class="rat"><p class="kicker">RATIFICATION</p><h2>How the council convenes for the first time.</h2>
      <dl class="dl">
        <div><dt>Threshold</dt><dd>{RATIFICATION.threshold}</dd></div>
        <div><dt>First council triggered</dt><dd>{RATIFICATION.firstCouncilTriggered}</dd></div>
        <div><dt>Draft amendment window</dt><dd>{RATIFICATION.draftAmendmentWindow}</dd></div>
      </dl>
    </section>

    <section class="dis"><p class="kicker">DISSOLUTION</p><h2>How the council retires.</h2>
      <dl class="dl">
        <div><dt>Why</dt><dd>{DISSOLUTION.why}</dd></div>
        <div><dt>Threshold</dt><dd>{DISSOLUTION.threshold}</dd></div>
        <div><dt>What happens after</dt><dd>{DISSOLUTION.whatHappensAfter}</dd></div>
        <div><dt>Recovery clause</dt><dd>{DISSOLUTION.recoveryClause}</dd></div>
      </dl>
    </section>

    <section class="invitation"><p class="kicker">INVITATION · PROSPECTIVE LANDS · RATIFY</p>
      <p>{CHARTER_NOTES.uesNote}</p>
      <p class="invite-cta">{CHARTER_NOTES.invitation}</p>
    </section>

    <section><p class="kicker">REFERENCES</p>
      <ol class="refs">{REFERENCES.map((r) => (<li id={`ref-${r.id}`} set:html={r.cite} />))}</ol>
    </section>

    <section class="links">
      <a href="/forkable-radius">The Forkable Radius</a>
      <a href="/strand-corridor">The Strand Corridor</a>
      <a href="/giant-works">Giant Works · Tier D</a>
      <a href="/giant-works-art">Giant Works · Art</a>
      <a href="/la28-ready">LA28 Forcing Function</a>
      <a href="/coordinate">Coordinate · deployment grid</a>
      <a href="/federation-council.json">JSON</a>
    </section>
  </div>
</BlockLayout>

<style>
  :root { --fc-ink:#1a1a1a; --fc-paper:#fdf9ee; --fc-mustard:#d4a534; --fc-rust:#b85a3a; --fc-sage:#2d6a3d; --fc-strand:#5b8aa8; --fc-fog:#d8d2c4; --fc-slate:#5a5450; }
  .charter { max-width: 940px; margin: 0 auto; padding: 0 0 88px; background: var(--fc-paper); color: var(--fc-ink); font-family: Georgia, 'Times New Roman', serif; }
  .charter > * { padding-inline: 28px; }
  .crumb { padding: 18px 28px 12px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #5a5450; }
  .crumb a { color: var(--fc-ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { padding: 18px 28px 36px; }
  .hero__bar { height: 14px; background: var(--fc-sage); margin: 0 -28px 28px; }
  .kicker { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--fc-paper); margin: 0 0 10px; padding: 4px 8px; background: var(--fc-sage); display: inline-block; }
  h1 { font-family: var(--pc-font-mono); font-size: 86px; line-height: .92; font-weight: 700; letter-spacing: -.02em; margin: 8px 0 14px; text-transform: uppercase; }
  .subtitle { font-size: 22px; font-weight: 500; margin: 0 0 14px; max-width: 60ch; font-style: italic; }
  .thesis { font-size: 16px; line-height: 1.65; max-width: 72ch; margin: 0; }

  section { padding: 28px; border-top: 4px solid var(--fc-ink); }
  h2 { font-family: var(--pc-font-mono); font-size: 24px; line-height: 1.05; font-weight: 700; margin: 0 0 16px; text-transform: uppercase; }
  h3 { font-family: var(--pc-font-mono); font-size: 14px; margin: 0 0 6px; font-weight: 700; }

  .block { font-size: 14.5px; line-height: 1.65; margin: 0 0 12px; padding: 10px 12px; background: #fff; border-left: 4px solid var(--fc-sage); max-width: 72ch; }
  .block strong { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fc-sage); margin-right: 6px; }

  .dl { margin: 0; display: grid; gap: 6px; }
  .dl > div { display: grid; grid-template-columns: 200px 1fr; gap: 14px; padding: 10px 14px; background: #fff; border: 2px solid var(--fc-ink); border-left: 5px solid var(--fc-sage); }
  .dl dt { font-family: var(--pc-font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fc-sage); padding-top: 2px; }
  .dl dd { margin: 0; font-size: 14px; line-height: 1.6; font-family: Georgia, serif; }

  .dec-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; counter-reset: dec; }
  .dec-list li { padding: 12px 14px; background: #fff; border: 2px solid var(--fc-ink); border-left: 8px solid var(--fc-sage); counter-increment: dec; position: relative; }
  .dec-list li::before { content: counter(dec, decimal-leading-zero); font-family: var(--pc-font-mono); font-size: 12px; color: var(--fc-sage); font-weight: 700; position: absolute; top: 12px; right: 14px; letter-spacing: .1em; }
  .dec-list h3 { padding-right: 36px; }
  .dec-list p { margin: 0 0 4px; font-size: 13.5px; line-height: 1.55; font-family: Georgia, serif; }
  .dec-list strong { font-family: var(--pc-font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--fc-sage); margin-right: 4px; }
  .thr { padding: 6px 10px; background: var(--fc-paper); border-left: 3px solid var(--fc-mustard); }
  .ex { padding: 6px 10px; background: var(--fc-paper); border-left: 3px solid var(--fc-fog); }

  .out-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .out-list li { padding: 10px 12px; background: #fff; border: 2px solid var(--fc-ink); border-left: 5px solid var(--fc-rust); font-size: 13.5px; line-height: 1.6; font-family: Georgia, serif; }

  .invitation { background: var(--fc-sage); color: var(--fc-paper); border-top-color: var(--fc-sage); }
  .invitation .kicker { background: var(--fc-mustard); color: var(--fc-ink); }
  .invitation p { font-size: 14px; line-height: 1.6; margin: 0 0 12px; font-family: Georgia, serif; }
  .invite-cta { padding: 12px 14px; background: var(--fc-mustard); color: var(--fc-ink); border-left: 4px solid var(--fc-paper); font-weight: 500; }

  .refs { padding-left: 22px; font-size: 13px; line-height: 1.6; font-family: Georgia, serif; }
  .refs li { margin-bottom: 6px; }
  .refs em { font-style: italic; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 12px; background: var(--fc-sage); color: var(--fc-paper); text-decoration: none; }
  .links a:hover { background: var(--fc-rust); }

  @media (max-width: 800px) { h1 { font-size: 60px; } .dl > div { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { h1 { font-size: 44px; } }
</style>
