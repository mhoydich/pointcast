---
import BlockLayout from '../../layouts/BlockLayout.astro';
import { HAPTIC_DREAMS, HAPTIC_DREAMS_PLAYS, HAPTIC_DREAMS_SOURCES, HAPTIC_PATTERNS } from '../../lib/pointcast-haptic-dreams';
import { SIGNAL_RUN_DURATION_SECONDS, signalChallengeFor } from '../../lib/pointcast-haptic-dreams-signal-run';

const run = HAPTIC_DREAMS_PLAYS.map((play) => ({
  ...play,
  challenge: signalChallengeFor(play),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Saturday Kingdom: Signal Run',
  description: 'A three-minute archival gesture game made from a selected, sourced 2024 Michigan–Ohio State play sequence. Player fidelity never changes the historical result.',
  url: 'https://pointcast.xyz/haptic-dreams/play',
  image: HAPTIC_DREAMS.socialImage,
  gamePlatform: 'Web browser',
  applicationCategory: 'BrowserGame',
  playMode: 'SinglePlayer',
  isAccessibleForFree: true,
};
---

<BlockLayout
  title="Saturday Kingdom: Signal Run"
  description="An approximately three-minute archival gesture game. Keep the signal clear; the historical game remains exactly as played."
  image={HAPTIC_DREAMS.socialImage}
  themeColor="#101522"
  jsonLd={jsonLd}
  immersive={true}
  showNetworkStrip={false}
>
  <main class="signal-run">
    <header class="mast">
      <a href="/haptic-dreams">← HAPTIC DREAMS</a>
      <span>SATURDAY KINGDOM / SIGNAL RUN</span>
      <a href="/haptic-dreams.json">ARCHIVE JSON ↗</a>
    </header>

    <section class="intro" id="intro">
      <img src="/images/pointcast-haptic-dreams/jon-snow-train.webp" alt="" width="2200" height="619" />
      <img src="/images/pointcast-haptic-dreams/jon-snow-lion.webp" alt="" width="960" height="1139" />
      <div>
        <p>ARCHIVAL GESTURE GAME / 18 SELECTED EVENTS</p>
        <h1>SIGNAL<br /><em>RUN</em></h1>
        <p class="intro__dek">Feel your way through one frozen game in about three minutes. Your fidelity changes the signal—not history.</p>
        <dl>
          <div><dt>ARCHIVE</dt><dd>MICHIGAN 13 · OHIO STATE 10</dd></div>
          <div><dt>YOUR TASK</dt><dd>RECOGNIZE THE EVENT GRAMMAR</dd></div>
        </dl>
        <button id="start-run">ENTER THE FIELD →</button>
        <p class="fine">Touch, mouse, and keyboard all work. Sound and vibration start only if you choose them.</p>
      </div>
    </section>

    <section class="game" id="game" hidden aria-labelledby="game-title">
      <header class="game__header">
        <div><span>ARCHIVAL SCORE</span><strong id="scoreboard">MICH 0 · OSU 0</strong></div>
        <div class="clock"><span>SIGNAL RUN</span><strong id="run-clock">03:00</strong></div>
        <div><span>YOUR FIDELITY</span><strong id="fidelity">0000</strong></div>
      </header>

      <div class="world" id="world" data-sky="dawn" data-team="MICH">
        <div class="world__grid" aria-hidden="true"></div>
        <div class="world__city world__city--mich"><span>MAIZE KEEP</span><i id="mich-level">I</i></div>
        <img class="world__lion" src="/images/pointcast-haptic-dreams/jon-snow-lion.webp" alt="KansasDAO Art Deco Lion by Jon Snow" width="960" height="1139" />
        <img class="world__train" id="train" src="/images/pointcast-haptic-dreams/jon-snow-train.webp" alt="Train carrying recorded possession through the Saturday Kingdom" width="2200" height="619" />
        <div class="world__city world__city--osu"><i id="osu-level">I</i><span>SCARLET HOLD</span></div>
        <p class="world__myth" id="myth" aria-live="polite">The gates open. Two old kingdoms enter the field.</p>
      </div>

      <section class="console" aria-label="Signal Run game console">
        <div class="console__facts">
          <p id="event-count">EVENT 01 / 18</p>
          <p id="event-time">Q1 · 15:00 · MICH POSSESSION</p>
          <h2 id="game-title">THE RIVALRY WAKES</h2>
          <p id="source-detail">Michigan receives the opening kick in Columbus.</p>
        </div>
        <div class="console__prompt">
          <p>YOUR SIGNAL</p>
          <strong id="prompt-label">OPEN THE FIELD</strong>
          <span id="prompt-copy">Swipe toward the receiving kingdom.</span>
          <small id="prompt-key">SWIPE / R</small>
        </div>
        <div class="console__controls">
          <button data-action="advance">ADVANCE<br /><kbd>R</kbd></button>
          <button data-action="arc">ARC<br /><kbd>P</kbd></button>
          <button data-action="reverse">REVERSE<br /><kbd>X</kbd></button>
          <button data-action="chorus">CHORUS<br /><kbd>T</kbd></button>
          <button data-action="settle">SETTLE<br /><kbd>M</kbd></button>
        </div>
        <div class="gesture-pad" id="gesture-pad" tabindex="0" role="application" aria-label="Gesture pad. Swipe, hold and release, or use the labeled keyboard controls.">
          <span>GESTURE PAD</span><strong id="pad-status">WAITING FOR YOUR SIGNAL</strong>
          <small>Swipe / hold / double tap</small>
        </div>
      </section>

      <footer class="game__footer">
        <div class="switches">
          <button id="sound-toggle" aria-pressed="false">SOUND OFF</button>
          <button id="haptic-toggle" aria-pressed="false">VIBRATION OFF</button>
        </div>
        <p id="record-note">The historical record is locked. Your score is local-only Signal Fidelity.</p>
        <button id="source-toggle" aria-expanded="false" aria-controls="source-room">SHOW ARCHIVE</button>
      </footer>
      <aside class="source-room" id="source-room" hidden>
        <p><strong>RECORDED EVENT</strong> <span id="recorded-event">Q1 · 15:00 · Michigan receives the opening kick in Columbus.</span></p>
        <p><strong>BOUNDARY</strong> This is an unofficial editorial replay. It is not a live score feed and your gestures cannot alter the recorded game.</p>
        <nav>{HAPTIC_DREAMS_SOURCES.map((source) => <a href={source.url} rel="noreferrer">{source.label} ↗</a>)}</nav>
      </aside>
    </section>

    <section class="result" id="result" hidden aria-live="polite">
      <p>THE ARCHIVE SETTLES</p>
      <h2 id="result-grade">RECOVERED</h2>
      <strong id="result-score">0000 SIGNAL FIDELITY</strong>
      <p id="result-copy">All 18 events reached their recorded ending.</p>
      <dl><div><dt>FINAL RECORD</dt><dd>MICHIGAN 13 · OHIO STATE 10</dd></div><div><dt>YOUR BEST</dt><dd id="best-score">0000</dd></div></dl>
      <div><button id="run-again">RUN IT AGAIN</button><a href="/haptic-dreams">OPEN THE EXHIBITION →</a></div>
      <p class="fine">Player performance is kept in this browser only. The sourced event record remains unchanged.</p>
    </section>
  </main>

  <script id="signal-run-data" type="application/json" set:html={JSON.stringify({ run, patterns: HAPTIC_PATTERNS, duration: SIGNAL_RUN_DURATION_SECONDS })}></script>
</BlockLayout>

<script>
  import { evaluateSignal, signalActionLabel, signalGrade, SIGNAL_RUN_STORAGE_KEY } from '../../lib/pointcast-haptic-dreams-signal-run';

  const payload = JSON.parse(document.querySelector('#signal-run-data')?.textContent || '{"run":[],"patterns":[],"duration":180}');
  const run = payload.run;
  const patterns = Object.fromEntries(payload.patterns.map((pattern) => [pattern.id, pattern]));
  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => [...document.querySelectorAll(selector)];
  let index = 0;
  let fidelity = 0;
  let answered = false;
  let startedAt = 0;
  let eventTimer = null;
  let missTimer = null;
  let clockTimer = null;
  let soundOn = false;
  let vibrationOn = false;
  let audioContext = null;
  let pointer = null;
  let tapAt = 0;

  function safelyReadBest() {
    try { return Number(localStorage.getItem(SIGNAL_RUN_STORAGE_KEY) || 0); } catch { return 0; }
  }
  function safelySaveBest(value) {
    try { localStorage.setItem(SIGNAL_RUN_STORAGE_KEY, String(value)); } catch { /* local-only progress is optional */ }
  }
  function roman(value) { return ['0', 'I', 'II', 'III', 'IV', 'V'][value] || 'V'; }
  function formatClock(seconds) { return `${String(Math.max(0, Math.floor(seconds / 60))).padStart(2, '0')}:${String(Math.max(0, seconds % 60)).padStart(2, '0')}`; }
  function activePlay() { return run[index]; }

  function playSound(correct) {
    if (!soundOn) return;
    audioContext ??= new AudioContext();
    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();
    oscillator.frequency.value = correct ? 392 : 146;
    gain.gain.setValueAtTime(0.045, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.22);
    oscillator.connect(gain).connect(audioContext.destination);
    oscillator.start(); oscillator.stop(audioContext.currentTime + 0.24);
  }

  function feel(play) {
    if (!vibrationOn || !('vibrate' in navigator)) return;
    navigator.vibrate(patterns[play.haptic]?.vibration || 35);
  }

  function render() {
    pointer = null;
    tapAt = 0;
    const play = activePlay();
    if (!play) return finish();
    const challenge = play.challenge;
    const position = ((play.world.possession + 1) / 2) * 100;
    const world = $('#world');
    world.dataset.sky = play.world.sky;
    world.dataset.team = play.team;
    world.style.setProperty('--possession', `${position}%`);
    $('#scoreboard').textContent = `MICH ${play.michigan} · OSU ${play.ohioState}`;
    $('#fidelity').textContent = String(fidelity).padStart(4, '0');
    $('#mich-level').textContent = roman(play.world.michiganLevel);
    $('#osu-level').textContent = roman(play.world.ohioStateLevel);
    $('#myth').textContent = play.myth;
    $('#event-count').textContent = `EVENT ${String(index + 1).padStart(2, '0')} / ${String(run.length).padStart(2, '0')}`;
    $('#event-time').textContent = `${play.type === 'final' ? 'FINAL' : `Q${play.quarter} · ${play.clock}`} · ${play.team} POSSESSION`;
    $('#game-title').textContent = play.title.toUpperCase();
    $('#source-detail').textContent = play.detail;
    $('#prompt-label').textContent = challenge.label;
    $('#prompt-copy').textContent = challenge.instruction;
    $('#prompt-key').textContent = signalActionLabel[challenge.action];
    $('#recorded-event').textContent = `${play.type === 'final' ? 'FINAL' : `Q${play.quarter} · ${play.clock}`} · ${play.detail}`;
    $('#pad-status').textContent = 'WAITING FOR YOUR SIGNAL';
    $$('.console__controls button').forEach((button) => button.classList.remove('is-correct', 'is-wrong'));
    answered = false;
    window.clearTimeout(eventTimer); window.clearTimeout(missTimer);
    // A slot always occupies its full beat. Fast hands improve fidelity but
    // cannot speed-run or rewrite the pacing of the archival sequence.
    missTimer = window.setTimeout(() => resolve(null), challenge.windowMs - 1000);
    eventTimer = window.setTimeout(() => { index += 1; render(); }, challenge.windowMs);
  }

  function resolve(action) {
    if (answered || !activePlay()) return;
    answered = true;
    const play = activePlay();
    const result = evaluateSignal(play, action);
    const correct = result.correct;
    const control = $(`[data-action="${action}"]`);
    if (correct) fidelity += 100;
    $('#fidelity').textContent = String(fidelity).padStart(4, '0');
    $('#pad-status').textContent = correct ? 'CLEAR SIGNAL +100' : action ? 'STATIC — THE ARCHIVE CONTINUES' : 'STATIC — SIGNAL MISSED';
    control?.classList.add(correct ? 'is-correct' : 'is-wrong');
    $('#world').classList.remove('pulse'); void $('#world').offsetWidth; $('#world').classList.add('pulse');
    playSound(correct); feel(play);
  }

  function updateClock() {
    const remaining = payload.duration - Math.floor((Date.now() - startedAt) / 1000);
    $('#run-clock').textContent = formatClock(remaining);
  }

  function start() {
    index = 0; fidelity = 0; startedAt = Date.now(); pointer = null; tapAt = 0;
    $('#intro').hidden = true; $('#result').hidden = true; $('#game').hidden = false;
    window.clearInterval(clockTimer); clockTimer = window.setInterval(updateClock, 250); updateClock(); render();
  }

  function finish() {
    window.clearTimeout(eventTimer); window.clearTimeout(missTimer); window.clearInterval(clockTimer);
    pointer = null; tapAt = 0;
    $('#game').hidden = true; $('#result').hidden = false;
    const best = Math.max(safelyReadBest(), fidelity); safelySaveBest(best);
    const percent = Math.round((fidelity / (run.length * 100)) * 100);
    const grade = signalGrade(fidelity, run.length);
    $('#result-grade').textContent = grade;
    $('#result-score').textContent = `${String(fidelity).padStart(4, '0')} SIGNAL FIDELITY`;
    $('#result-copy').textContent = `${run.length} recorded events reached their recorded ending. You recognized ${percent}% of the signal.`;
    $('#best-score').textContent = String(best).padStart(4, '0');
  }

  function pointerAction(event) {
    if (!pointer) return;
    const play = activePlay();
    if (!play) { pointer = null; tapAt = 0; return; }
    const elapsed = Date.now() - pointer.at;
    const dx = event.clientX - pointer.x;
    const dy = event.clientY - pointer.y;
    let action = null;
    if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy)) {
      const forward = play.team === 'MICH' ? dx > 0 : dx < 0;
      action = forward ? 'advance' : 'reverse';
    } else if (elapsed > 260) {
      action = Math.abs(dy) > 26 ? 'arc' : 'settle';
    } else if (Date.now() - tapAt < 380) {
      action = 'chorus'; tapAt = 0;
    } else {
      tapAt = Date.now();
    }
    pointer = null;
    if (action) resolve(action);
  }

  $('#start-run')?.addEventListener('click', start);
  $('#run-again')?.addEventListener('click', start);
  $$('.console__controls button').forEach((button) => button.addEventListener('click', () => resolve(button.dataset.action)));
  $('#gesture-pad')?.addEventListener('pointerdown', (event) => {
    pointer = { x: event.clientX, y: event.clientY, at: Date.now() };
    event.currentTarget.setPointerCapture?.(event.pointerId);
  });
  $('#gesture-pad')?.addEventListener('pointerup', pointerAction);
  $('#gesture-pad')?.addEventListener('pointercancel', () => { pointer = null; });
  window.addEventListener('keydown', (event) => {
    if ($('#game').hidden || event.target instanceof HTMLInputElement) return;
    const actions = { r: 'advance', p: 'arc', x: 'reverse', t: 'chorus', m: 'settle', f: 'settle' };
    const action = actions[event.key.toLowerCase()];
    if (action) { event.preventDefault(); resolve(action); }
  });
  $('#sound-toggle')?.addEventListener('click', (event) => {
    soundOn = !soundOn; event.currentTarget.textContent = soundOn ? 'SOUND ON' : 'SOUND OFF'; event.currentTarget.setAttribute('aria-pressed', String(soundOn));
  });
  $('#haptic-toggle')?.addEventListener('click', (event) => {
    vibrationOn = !vibrationOn; event.currentTarget.textContent = vibrationOn ? 'VIBRATION ON' : 'VIBRATION OFF'; event.currentTarget.setAttribute('aria-pressed', String(vibrationOn));
  });
  $('#source-toggle')?.addEventListener('click', (event) => {
    const room = $('#source-room'); room.hidden = !room.hidden;
    event.currentTarget.setAttribute('aria-expanded', String(!room.hidden));
    event.currentTarget.textContent = room.hidden ? 'SHOW ARCHIVE' : 'HIDE ARCHIVE';
  });
</script>

<style>
  :global(body) { margin:0; background:#101522; color:#eee5ce; font-family:Arial,Helvetica,sans-serif; }
  :global(button), :global(a) { font:inherit; }
  .signal-run { --ink:#101522; --paper:#eee5ce; --gold:#d0ac65; --maize:#ffcb05; --scarlet:#ba0c2f; min-height:100vh; background:var(--ink); overflow:hidden; }
  .mast { min-height:58px; padding:0 4vw; display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:center; border-bottom:1px solid #3a4254; color:#c9c0ad; font:800 10px/1 Arial,sans-serif; letter-spacing:.14em; }
  .mast a { color:inherit; text-decoration:none; }.mast a:last-child { justify-self:end; color:var(--gold); }
  .intro { min-height:calc(100svh - 58px); position:relative; display:grid; place-items:center; overflow:hidden; background:radial-gradient(circle at 50% 30%,#3f4960,transparent 36%),linear-gradient(145deg,#090d15,#202a3b); }
  .intro>img:first-child { position:absolute; width:min(1300px,120vw); left:-17vw; bottom:5%; opacity:.3; filter:sepia(.6) saturate(.7); }.intro>img:nth-child(2) { position:absolute; width:min(430px,45vw); right:8vw; top:8%; opacity:.17; mix-blend-mode:screen; }
  .intro>div { position:relative; z-index:1; width:min(780px,84vw); padding:13vh 0; }.intro p:first-child,.result>p:first-child,.game__header span { color:var(--gold); font:800 10px/1 Arial,sans-serif; letter-spacing:.17em; }
  h1 { margin:18px 0 22px; font:900 clamp(88px,18vw,210px)/.68 Impact,"Arial Narrow",sans-serif; letter-spacing:-.07em; } h1 em { color:var(--gold); font:400 .82em Georgia,serif; }
  .intro__dek { max-width:570px; font:400 clamp(20px,2.6vw,31px)/1.25 Georgia,serif; }.intro dl,.result dl { display:flex; flex-wrap:wrap; gap:20px 45px; margin:35px 0; }.intro dt,.result dt { color:#9aa4b5; font:800 8px/1 Arial,sans-serif; letter-spacing:.15em; }.intro dd,.result dd { margin:8px 0 0; font:800 11px/1.35 Arial,sans-serif; letter-spacing:.08em; }
  button { cursor:pointer; }.intro button,.result button { padding:16px 20px; border:1px solid var(--gold); background:var(--gold); color:var(--ink); font:800 10px/1 Arial,sans-serif; letter-spacing:.14em; }.fine { margin-top:15px; max-width:510px; color:#a4adbb; font:12px/1.45 Georgia,serif; }
  .game { min-height:calc(100svh - 58px); }.game__header { display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:center; padding:17px 4vw; background:#090e17; border-bottom:1px solid #3a4254; }.game__header div:last-child { text-align:right; }.game__header span { display:block; margin-bottom:6px; font-size:8px; }.game__header strong { color:var(--paper); font:400 clamp(17px,2.4vw,29px)/1 Georgia,serif; letter-spacing:.04em; }.clock { text-align:center; }.clock strong { color:var(--gold); }
  .world { --possession:42%; min-height:clamp(270px,45vh,520px); position:relative; overflow:hidden; isolation:isolate; background:linear-gradient(#9aa6b4 0 45%,#5c6e65 45% 57%,#302f28 57%); transition:background .8s ease; }.world[data-sky="cold"] { background:linear-gradient(#718297 0 42%,#87909a 42% 55%,#34332e 55%); }.world[data-sky="ember"] { background:linear-gradient(#6f3d3f 0,#d58b58 44%,#524c3d 56%,#292821 56%); }.world[data-sky="midnight"],.world[data-sky="still"] { background:linear-gradient(#10192a 0,#28334a 44%,#353d38 56%,#171b19 56%); }.world__grid { position:absolute; inset:0; opacity:.13; background:repeating-linear-gradient(90deg,transparent 0 10vw,#fff 10vw calc(10vw + 1px)); }.world__city { position:absolute; z-index:2; bottom:13%; display:flex; gap:10px; align-items:end; color:var(--maize); font:800 9px/1 Arial,sans-serif; letter-spacing:.14em; }.world__city i { font:400 32px/1 Georgia,serif; }.world__city--mich { left:5%; }.world__city--osu { right:5%; color:#e1415e; text-align:right; }.world__lion { position:absolute; z-index:1; left:50%; top:9%; width:min(150px,20vw); height:68%; object-fit:cover; object-position:top; transform:translateX(-50%); opacity:.15; mix-blend-mode:screen; }.world__train { position:absolute; z-index:4; width:min(430px,50vw); bottom:17%; left:var(--possession); transform:translateX(-50%) scaleX(-1); filter:sepia(.7) saturate(.9) brightness(1.2) drop-shadow(0 12px 12px #0008); transition:left 1s cubic-bezier(.2,.8,.2,1),transform .5s ease; }.world[data-team="OSU"] .world__train { transform:translateX(-50%) scaleX(1); filter:sepia(.35) hue-rotate(300deg) saturate(1.35) brightness(.95) drop-shadow(0 12px 12px #0008); }.world__myth { position:absolute; z-index:5; left:10%; right:10%; bottom:4%; margin:0; text-align:center; color:#eee5ce; text-shadow:0 2px 14px #000; font:italic clamp(15px,2vw,22px)/1.35 Georgia,serif; }.world.pulse .world__train { animation:train-pulse .7s ease; } @keyframes train-pulse { 50% { filter:brightness(1.9) drop-shadow(0 0 20px var(--gold)); } }
  .console { display:grid; grid-template-columns:1.15fr .85fr; border-bottom:1px solid #3a4254; }.console__facts,.console__prompt { padding:32px 4vw; }.console__facts { border-right:1px solid #3a4254; }.console p { margin:0; color:var(--gold); font:800 9px/1 Arial,sans-serif; letter-spacing:.15em; }.console__facts p:nth-child(2) { margin-top:10px; color:#aab2bd; }.console h2 { margin:19px 0 12px; font:900 clamp(32px,4vw,62px)/.86 Impact,"Arial Narrow",sans-serif; letter-spacing:-.045em; }.console__facts>p:last-child { color:#d6d0c3; font:16px/1.4 Georgia,serif; letter-spacing:0; }.console__prompt { background:#d7c7a8; color:var(--ink); }.console__prompt p { color:#695329; }.console__prompt strong { display:block; margin:23px 0 9px; font:900 clamp(28px,3.6vw,51px)/.9 Impact,"Arial Narrow",sans-serif; letter-spacing:-.04em; }.console__prompt span { display:block; font:18px/1.35 Georgia,serif; }.console__prompt small { display:block; margin-top:17px; font:800 9px/1 Arial,sans-serif; letter-spacing:.14em; }
  .console__controls { display:grid; grid-column:1/-1; grid-template-columns:repeat(5,1fr); border-top:1px solid #3a4254; }.console__controls button { min-height:75px; border:0; border-right:1px solid #3a4254; background:#141b29; color:#ddd6c8; font:800 10px/1.2 Arial,sans-serif; letter-spacing:.12em; }.console__controls kbd { display:inline-block; margin-top:8px; color:var(--gold); font:400 12px/1 Georgia,serif; }.console__controls button.is-correct { background:#6b8253; color:#fff; }.console__controls button.is-wrong { background:#6d3944; color:#fff; }
  .gesture-pad { grid-column:1/-1; min-height:145px; display:grid; place-content:center; justify-items:center; gap:12px; background:repeating-linear-gradient(90deg,#111827 0 10%,#161f2f 10% 20%); border-top:1px solid #3a4254; outline-offset:-5px; user-select:none; touch-action:none; }.gesture-pad span,.gesture-pad small { color:#b9b1a2; font:800 8px/1 Arial,sans-serif; letter-spacing:.17em; }.gesture-pad strong { color:var(--gold); font:400 clamp(22px,3vw,38px)/1 Georgia,serif; text-align:center; }.gesture-pad:focus-visible { outline:2px solid var(--gold); }
  .game__footer { display:grid; grid-template-columns:auto 1fr auto; gap:20px; align-items:center; padding:18px 4vw; background:#090e17; }.switches { display:flex; gap:8px; }.game__footer button { padding:10px 12px; border:1px solid #4b5668; background:transparent; color:#d8d2c5; font:800 8px/1 Arial,sans-serif; letter-spacing:.11em; }.game__footer button[aria-pressed="true"] { border-color:var(--gold); color:var(--gold); }.game__footer p { margin:0; color:#aab2bd; text-align:center; font:12px/1.3 Georgia,serif; }.source-room { padding:25px 4vw; background:#e5dece; color:var(--ink); }.source-room p { max-width:880px; margin:0 0 12px; font:15px/1.45 Georgia,serif; }.source-room strong { font:800 9px/1 Arial,sans-serif; letter-spacing:.12em; }.source-room nav { display:flex; flex-wrap:wrap; gap:16px; }.source-room a { color:inherit; font:800 9px/1 Arial,sans-serif; letter-spacing:.1em; }
