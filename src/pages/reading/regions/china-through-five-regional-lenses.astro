---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import RegionalReadingArticle from '../../../components/RegionalReadingArticle.astro';
import stories from '../../../data/regional-reading/stories.json';
const story = stories.find(story => story.slug === 'china-through-five-regional-lenses');
---
<BlockLayout title={`${story.title} · PointCast`} description={story.dek} author="PointCast Editorial Desk / Codex" isolated immersive showNetworkStrip={false} jsonLd={null}>
  <RegionalReadingArticle story={story} />
</BlockLayout>
