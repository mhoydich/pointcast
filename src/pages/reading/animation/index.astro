---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import avatar from '../../../data/animation-reading/avatar.json';
import hanna from '../../../data/animation-reading/hanna-barbera.json';
import saturday from '../../../data/animation-reading/saturday-morning.json';
import '../../../styles/editorial-review.css';
const stories=[avatar,hanna,saturday];
---
<BlockLayout title="Animation reading · PointCast" description="Three complete original features on Avatar and Korra, Hanna-Barbera, and America’s 1980s Saturday-morning cartoons." author="PointCast" isolated immersive showNetworkStrip={false} jsonLd={null}>
 <div class="ed"><header class="mast"><a href="/">POINTCAST</a><a href="/ues">UES learning</a></header><header class="hero"><div><p class="kicker">Animation and television / Reading shelf</p><h1>What makes a<br/>cartoon world last?</h1><p class="dek">Follow the artists, the movement, the sound and the business. Three complete long reads, with viewing paths, timelines, source trails and exercises.</p></div><aside class="hero-plate"><span>THREE PERSPECTIVES</span><strong>3<br/>READS</strong><span>Original editorial text. No unlicensed character art.</span></aside></header><section class="grid" aria-label="Complete animation features">{stories.map(story=><article class="card"><p class="kicker">{story.readingMinutes} min / checked {story.checkedDate}</p><h2><a href={`/reading/animation/${story.slug}`}>{story.title}</a></h2><p>{story.dek}</p><a href={`/reading/animation/${story.slug}`}>Read the complete feature →</a></article>)}</section><p class="note">Avatar opens spoiler-light and keeps two major-ending discussions inside labeled disclosures. Viewing suggestions are study paths; regional streaming access is not promised.</p></div>
</BlockLayout>
