---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import AnimationReadingArticle from '../../../components/AnimationReadingArticle.astro';
import story from '../../../data/animation-reading/saturday-morning.json';
const related=[{"href": "/reading/animation/avatar-the-last-airbender", "label": "Avatar and the Art of Learning to Change"}, {"href": "/reading/animation/hanna-barbera", "label": "Hanna-Barbera: The Art of Knowing What Can Stay Still"}];
const canonical='https://pointcast.xyz/reading/animation/saturday-morning-1980s';
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:story.title,description:story.dek,url:canonical,dateModified:story.checkedDate,author:{'@type':'Organization',name:'PointCast'}};
---
<BlockLayout title={`${story.title} · PointCast`} description={story.dek} author="PointCast" isolated immersive showNetworkStrip={false} jsonLd={articleSchema}>
  <AnimationReadingArticle story={story} related={related} />
</BlockLayout>
