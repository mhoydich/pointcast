---
import BlockLayout from '../../../layouts/BlockLayout.astro';
import AnimationReadingArticle from '../../../components/AnimationReadingArticle.astro';
import story from '../../../data/animation-reading/hanna-barbera.json';
import media from '../../../data/animation-reading/hanna-barbera-media.json';
const related=[{"href": "/reading/animation/avatar-the-last-airbender", "label": "Avatar and the Art of Learning to Change"}, {"href": "/reading/animation/saturday-morning-1980s", "label": "The Morning Was the Medium"}];
const canonical='https://pointcast.xyz/reading/animation/hanna-barbera';
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:story.title,description:story.dek,url:canonical,dateModified:story.checkedDate,author:{'@type':'Organization',name:'PointCast'}};
---
<BlockLayout title={`${story.title} · PointCast`} description={story.dek} author="PointCast" isolated immersive showNetworkStrip={false} jsonLd={articleSchema}>
  <AnimationReadingArticle story={story} related={related} media={media} />
</BlockLayout>
